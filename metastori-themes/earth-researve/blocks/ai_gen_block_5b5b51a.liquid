{% doc %}
  @prompt
    add a roll kind of thing to showcase collection wise products, where customer can slide and pick the collection they want, 16 collecttion
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-collection-carousel-{{ ai_gen_id }} {
    padding: {{ block.settings.section_padding_top }}px 0 {{ block.settings.section_padding_bottom }}px;
    background-color: {{ block.settings.background_color }};
  }

  .ai-collection-carousel__container-{{ ai_gen_id }} {
    max-width: 1400px;
    margin: 0 auto;
    padding: 0 20px;
  }

  .ai-collection-carousel__header-{{ ai_gen_id }} {
    text-align: {{ block.settings.heading_alignment }};
    margin-bottom: 32px;
  }

  .ai-collection-carousel__heading-{{ ai_gen_id }} {
    color: {{ block.settings.heading_color }};
    font-size: {{ block.settings.heading_size }}px;
    margin: 0 0 12px;
  }

  .ai-collection-carousel__subheading-{{ ai_gen_id }} {
    color: {{ block.settings.text_color }};
    font-size: {{ block.settings.subheading_size }}px;
    margin: 0;
  }

  .ai-collection-carousel__tabs-{{ ai_gen_id }} {
    display: flex;
    gap: 12px;
    margin-bottom: 32px;
    overflow-x: auto;
    scrollbar-width: none;
    -ms-overflow-style: none;
    padding-bottom: 8px;
  }

  .ai-collection-carousel__tabs-{{ ai_gen_id }}::-webkit-scrollbar {
    display: none;
  }

  .ai-collection-carousel__tab-{{ ai_gen_id }} {
    padding: 12px 24px;
    background-color: {{ block.settings.tab_background }};
    color: {{ block.settings.tab_text_color }};
    border: 1px solid {{ block.settings.tab_border_color }};
    border-radius: {{ block.settings.tab_border_radius }}px;
    cursor: pointer;
    white-space: nowrap;
    transition: all 0.3s ease;
    font-size: 14px;
    font-weight: 500;
  }

  .ai-collection-carousel__tab-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.tab_hover_background }};
    color: {{ block.settings.tab_hover_text_color }};
  }

  .ai-collection-carousel__tab-{{ ai_gen_id }}.active {
    background-color: {{ block.settings.tab_active_background }};
    color: {{ block.settings.tab_active_text_color }};
    border-color: {{ block.settings.tab_active_border_color }};
  }

  .ai-collection-carousel__content-{{ ai_gen_id }} {
    position: relative;
  }

  .ai-collection-carousel__panel-{{ ai_gen_id }} {
    display: none;
  }

  .ai-collection-carousel__panel-{{ ai_gen_id }}.active {
    display: block;
  }

  .ai-collection-carousel__scroll-wrapper-{{ ai_gen_id }} {
    position: relative;
  }

  .ai-collection-carousel__products-{{ ai_gen_id }} {
    display: flex;
    gap: 20px;
    overflow-x: auto;
    scroll-behavior: smooth;
    scrollbar-width: none;
    -ms-overflow-style: none;
    padding: 8px 0 20px;
  }

  .ai-collection-carousel__products-{{ ai_gen_id }}::-webkit-scrollbar {
    display: none;
  }

  .ai-collection-carousel__product-card-{{ ai_gen_id }} {
    flex: 0 0 {{ block.settings.card_width }}px;
    background-color: {{ block.settings.card_background }};
    border: 1px solid {{ block.settings.card_border_color }};
    border-radius: {{ block.settings.card_border_radius }}px;
    overflow: hidden;
    transition: transform 0.3s ease, box-shadow 0.3s ease;
  }

  .ai-collection-carousel__product-card-{{ ai_gen_id }}:hover {
    transform: translateY(-4px);
    box-shadow: 0 8px 16px rgba(0, 0, 0, 0.1);
  }

  .ai-collection-carousel__product-image-{{ ai_gen_id }} {
    width: 100%;
    aspect-ratio: 1;
    overflow: hidden;
    background-color: #f5f5f5;
  }

  .ai-collection-carousel__product-image-{{ ai_gen_id }} img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ai-collection-carousel__product-info-{{ ai_gen_id }} {
    padding: 16px;
  }

  .ai-collection-carousel__product-title-{{ ai_gen_id }} {
    font-size: 16px;
    font-weight: 500;
    margin: 0 0 8px;
    color: {{ block.settings.card_title_color }};
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .ai-collection-carousel__product-price-{{ ai_gen_id }} {
    font-size: 14px;
    color: {{ block.settings.card_price_color }};
    font-weight: 600;
  }

  .ai-collection-carousel__nav-button-{{ ai_gen_id }} {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    width: 40px;
    height: 40px;
    background-color: {{ block.settings.nav_button_background }};
    color: {{ block.settings.nav_button_color }};
    border: none;
    border-radius: 50%;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 2;
    transition: all 0.3s ease;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.15);
  }

  .ai-collection-carousel__nav-button-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.nav_button_hover_background }};
    transform: translateY(-50%) scale(1.1);
  }

  .ai-collection-carousel__nav-button-{{ ai_gen_id }}--prev {
    left: -20px;
  }

  .ai-collection-carousel__nav-button-{{ ai_gen_id }}--next {
    right: -20px;
  }

  .ai-collection-carousel__empty-{{ ai_gen_id }} {
    text-align: center;
    padding: 60px 20px;
    color: #999;
  }

  .ai-collection-carousel__empty-icon-{{ ai_gen_id }} {
    width: 80px;
    height: 80px;
    margin: 0 auto 16px;
    opacity: 0.3;
  }

  .ai-collection-carousel__view-all-{{ ai_gen_id }} {
    text-align: center;
    margin-top: 24px;
  }

  .ai-collection-carousel__view-all-link-{{ ai_gen_id }} {
    display: inline-block;
    padding: 12px 32px;
    background-color: {{ block.settings.button_background }};
    color: {{ block.settings.button_text_color }};
    text-decoration: none;
    border-radius: {{ block.settings.button_border_radius }}px;
    font-weight: 500;
    transition: all 0.3s ease;
  }

  .ai-collection-carousel__view-all-link-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.button_hover_background }};
    color: {{ block.settings.button_hover_text_color }};
  }

  @media screen and (max-width: 768px) {
    .ai-collection-carousel__product-card-{{ ai_gen_id }} {
      flex: 0 0 {{ block.settings.card_width_mobile }}px;
    }

    .ai-collection-carousel__nav-button-{{ ai_gen_id }} {
      display: none;
    }

    .ai-collection-carousel__heading-{{ ai_gen_id }} {
      font-size: {{ block.settings.heading_size | times: 0.7 }}px;
    }
  }
{% endstyle %}

<collection-carousel-{{ ai_gen_id }}
  class="ai-collection-carousel-{{ ai_gen_id }}"
  {{ block.shopify_attributes }}
>
  <div class="ai-collection-carousel__container-{{ ai_gen_id }}">
    {% if block.settings.heading != blank or block.settings.subheading != blank %}
      <div class="ai-collection-carousel__header-{{ ai_gen_id }}">
        {% if block.settings.heading != blank %}
          <h2 class="ai-collection-carousel__heading-{{ ai_gen_id }}">{{ block.settings.heading }}</h2>
        {% endif %}
        {% if block.settings.subheading != blank %}
          <p class="ai-collection-carousel__subheading-{{ ai_gen_id }}">{{ block.settings.subheading }}</p>
        {% endif %}
      </div>
    {% endif %}

    {% liquid
      assign collection_1 = block.settings.collection_1
      assign collection_2 = block.settings.collection_2
      assign collection_3 = block.settings.collection_3
      assign collection_4 = block.settings.collection_4
      assign collection_5 = block.settings.collection_5
      assign collection_6 = block.settings.collection_6
      assign collection_7 = block.settings.collection_7
      assign collection_8 = block.settings.collection_8
      assign collection_9 = block.settings.collection_9
      assign collection_10 = block.settings.collection_10
      assign collection_11 = block.settings.collection_11
      assign collection_12 = block.settings.collection_12
      assign collection_13 = block.settings.collection_13
      assign collection_14 = block.settings.collection_14
      assign collection_15 = block.settings.collection_15
      assign collection_16 = block.settings.collection_16

      assign collections_array = ''
      if collection_1 != blank
        assign collections_array = collections_array | append: '1,'
      endif
      if collection_2 != blank
        assign collections_array = collections_array | append: '2,'
      endif
      if collection_3 != blank
        assign collections_array = collections_array | append: '3,'
      endif
      if collection_4 != blank
        assign collections_array = collections_array | append: '4,'
      endif
      if collection_5 != blank
        assign collections_array = collections_array | append: '5,'
      endif
      if collection_6 != blank
        assign collections_array = collections_array | append: '6,'
      endif
      if collection_7 != blank
        assign collections_array = collections_array | append: '7,'
      endif
      if collection_8 != blank
        assign collections_array = collections_array | append: '8,'
      endif
      if collection_9 != blank
        assign collections_array = collections_array | append: '9,'
      endif
      if collection_10 != blank
        assign collections_array = collections_array | append: '10,'
      endif
      if collection_11 != blank
        assign collections_array = collections_array | append: '11,'
      endif
      if collection_12 != blank
        assign collections_array = collections_array | append: '12,'
      endif
      if collection_13 != blank
        assign collections_array = collections_array | append: '13,'
      endif
      if collection_14 != blank
        assign collections_array = collections_array | append: '14,'
      endif
      if collection_15 != blank
        assign collections_array = collections_array | append: '15,'
      endif
      if collection_16 != blank
        assign collections_array = collections_array | append: '16,'
      endif

      assign has_collections = false
      if collections_array != blank
        assign has_collections = true
      endif
    %}

    {% if has_collections %}
      <div class="ai-collection-carousel__tabs-{{ ai_gen_id }}">
        {% if collection_1 != blank %}
          <button class="ai-collection-carousel__tab-{{ ai_gen_id }} active" data-collection="1">
            {{ collection_1.title }}
          </button>
        {% endif %}
        {% if collection_2 != blank %}
          <button class="ai-collection-carousel__tab-{{ ai_gen_id }}" data-collection="2">
            {{ collection_2.title }}
          </button>
        {% endif %}
        {% if collection_3 != blank %}
          <button class="ai-collection-carousel__tab-{{ ai_gen_id }}" data-collection="3">
            {{ collection_3.title }}
          </button>
        {% endif %}
        {% if collection_4 != blank %}
          <button class="ai-collection-carousel__tab-{{ ai_gen_id }}" data-collection="4">
            {{ collection_4.title }}
          </button>
        {% endif %}
        {% if collection_5 != blank %}
          <button class="ai-collection-carousel__tab-{{ ai_gen_id }}" data-collection="5">
            {{ collection_5.title }}
          </button>
        {% endif %}
        {% if collection_6 != blank %}
          <button class="ai-collection-carousel__tab-{{ ai_gen_id }}" data-collection="6">
            {{ collection_6.title }}
          </button>
        {% endif %}
        {% if collection_7 != blank %}
          <button class="ai-collection-carousel__tab-{{ ai_gen_id }}" data-collection="7">
            {{ collection_7.title }}
          </button>
        {% endif %}
        {% if collection_8 != blank %}
          <button class="ai-collection-carousel__tab-{{ ai_gen_id }}" data-collection="8">
            {{ collection_8.title }}
          </button>
        {% endif %}
        {% if collection_9 != blank %}
          <button class="ai-collection-carousel__tab-{{ ai_gen_id }}" data-collection="9">
            {{ collection_9.title }}
          </button>
        {% endif %}
        {% if collection_10 != blank %}
          <button class="ai-collection-carousel__tab-{{ ai_gen_id }}" data-collection="10">
            {{ collection_10.title }}
          </button>
        {% endif %}
        {% if collection_11 != blank %}
          <button class="ai-collection-carousel__tab-{{ ai_gen_id }}" data-collection="11">
            {{ collection_11.title }}
          </button>
        {% endif %}
        {% if collection_12 != blank %}
          <button class="ai-collection-carousel__tab-{{ ai_gen_id }}" data-collection="12">
            {{ collection_12.title }}
          </button>
        {% endif %}
        {% if collection_13 != blank %}
          <button class="ai-collection-carousel__tab-{{ ai_gen_id }}" data-collection="13">
            {{ collection_13.title }}
          </button>
        {% endif %}
        {% if collection_14 != blank %}
          <button class="ai-collection-carousel__tab-{{ ai_gen_id }}" data-collection="14">
            {{ collection_14.title }}
          </button>
        {% endif %}
        {% if collection_15 != blank %}
          <button class="ai-collection-carousel__tab-{{ ai_gen_id }}" data-collection="15">
            {{ collection_15.title }}
          </button>
        {% endif %}
        {% if collection_16 != blank %}
          <button class="ai-collection-carousel__tab-{{ ai_gen_id }}" data-collection="16">
            {{ collection_16.title }}
          </button>
        {% endif %}
      </div>

      <div class="ai-collection-carousel__content-{{ ai_gen_id }}">
        {% for i in (1..16) %}
          {% liquid
            case i
              when 1
                assign current_collection = collection_1
              when 2
                assign current_collection = collection_2
              when 3
                assign current_collection = collection_3
              when 4
                assign current_collection = collection_4
              when 5
                assign current_collection = collection_5
              when 6
                assign current_collection = collection_6
              when 7
                assign current_collection = collection_7
              when 8
                assign current_collection = collection_8
              when 9
                assign current_collection = collection_9
              when 10
                assign current_collection = collection_10
              when 11
                assign current_collection = collection_11
              when 12
                assign current_collection = collection_12
              when 13
                assign current_collection = collection_13
              when 14
                assign current_collection = collection_14
              when 15
                assign current_collection = collection_15
              when 16
                assign current_collection = collection_16
            endcase
          %}

          {% if current_collection != blank %}
            <div
              class="ai-collection-carousel__panel-{{ ai_gen_id }} {% if i == 1 %}active{% endif %}"
              data-panel="{{ i }}"
            >
              <div class="ai-collection-carousel__scroll-wrapper-{{ ai_gen_id }}">
                <button
                  class="ai-collection-carousel__nav-button-{{ ai_gen_id }} ai-collection-carousel__nav-button-{{ ai_gen_id }}--prev"
                  aria-label="Previous products"
                  data-direction="prev"
                  data-panel="{{ i }}"
                >
                  <svg width="20" height="20" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M12 4L6 10L12 16" stroke-linecap="round" stroke-linejoin="round"/>
                  </svg>
                </button>

                <div class="ai-collection-carousel__products-{{ ai_gen_id }}" data-scroll-container="{{ i }}">
                  {% for product in current_collection.products limit: block.settings.products_to_show %}
                    <a
                      href="{{ product.url }}"
                      class="ai-collection-carousel__product-card-{{ ai_gen_id }}"
                    >
                      <div class="ai-collection-carousel__product-image-{{ ai_gen_id }}">
                        {% if product.featured_image %}
                          <img
                            src="{{ product.featured_image | image_url: width: 400 }}"
                            alt="{{ product.featured_image.alt | escape }}"
                            loading="lazy"
                            width="400"
                            height="400"
                          >
                        {% else %}
                          {{ 'product-1' | placeholder_svg_tag }}
                        {% endif %}
                      </div>
                      <div class="ai-collection-carousel__product-info-{{ ai_gen_id }}">
                        <h3 class="ai-collection-carousel__product-title-{{ ai_gen_id }}">{{ product.title }}</h3>
                        <div class="ai-collection-carousel__product-price-{{ ai_gen_id }}">
                          {{ product.price | money }}
                        </div>
                      </div>
                    </a>
                  {% endfor %}
                </div>

                <button
                  class="ai-collection-carousel__nav-button-{{ ai_gen_id }} ai-collection-carousel__nav-button-{{ ai_gen_id }}--next"
                  aria-label="Next products"
                  data-direction="next"
                  data-panel="{{ i }}"
                >
                  <svg width="20" height="20" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M8 4L14 10L8 16" stroke-linecap="round" stroke-linejoin="round"/>
                  </svg>
                </button>
              </div>

              {% if block.settings.show_view_all %}
                <div class="ai-collection-carousel__view-all-{{ ai_gen_id }}">
                  <a
                    href="{{ current_collection.url }}"
                    class="ai-collection-carousel__view-all-link-{{ ai_gen_id }}"
                  >
                    {{ block.settings.view_all_text }}
                  </a>
                </div>
              {% endif %}
            </div>
          {% endif %}
        {% endfor %}
      </div>
    {% else %}
      <div class="ai-collection-carousel__empty-{{ ai_gen_id }}">
        <div class="ai-collection-carousel__empty-icon-{{ ai_gen_id }}">
          {{ 'collection-1' | placeholder_svg_tag }}
        </div>
        <p>Select collections to showcase your products</p>
      </div>
    {% endif %}
  </div>
</collection-carousel-{{ ai_gen_id }}>

<script>
  (function() {
    class CollectionCarousel{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
        this.tabs = this.querySelectorAll('.ai-collection-carousel__tab-{{ ai_gen_id }}');
        this.panels = this.querySelectorAll('.ai-collection-carousel__panel-{{ ai_gen_id }}');
        this.navButtons = this.querySelectorAll('.ai-collection-carousel__nav-button-{{ ai_gen_id }}');

        this.setupTabs();
        this.setupNavigation();
      }

      setupTabs() {
        this.tabs.forEach((tab) => {
          tab.addEventListener('click', () => {
            const collectionId = tab.getAttribute('data-collection');

            this.tabs.forEach((t) => t.classList.remove('active'));
            tab.classList.add('active');

            this.panels.forEach((panel) => {
              if (panel.getAttribute('data-panel') === collectionId) {
                panel.classList.add('active');
              } else {
                panel.classList.remove('active');
              }
            });
          });
        });
      }

      setupNavigation() {
        this.navButtons.forEach((button) => {
          button.addEventListener('click', () => {
            const direction = button.getAttribute('data-direction');
            const panelId = button.getAttribute('data-panel');
            const scrollContainer = this.querySelector(
              `.ai-collection-carousel__products-{{ ai_gen_id }}[data-scroll-container="${panelId}"]`
            );

            if (scrollContainer) {
              const scrollAmount = scrollContainer.offsetWidth * 0.8;
              const currentScroll = scrollContainer.scrollLeft;

              if (direction === 'next') {
                scrollContainer.scrollTo({
                  left: currentScroll + scrollAmount,
                  behavior: 'smooth'
                });
              } else {
                scrollContainer.scrollTo({
                  left: currentScroll - scrollAmount,
                  behavior: 'smooth'
                });
              }
            }
          });
        });
      }
    }

    customElements.define('collection-carousel-{{ ai_gen_id }}', CollectionCarousel{{ ai_gen_id }});
  })();
</script>

