{% doc %}
  @prompt
    CONTACT US FORM OF FIRST NAME , LAST NAME. PHONE NUMBER, EMAIL ID & REQUIREMENTS & ALSO THANK YOU MESSAGE AFTER SUBMITTING THE FORM, CREATE IN A ANIMATION WAY
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-contact-form-{{ ai_gen_id }} {
    max-width: 800px;
    margin: 0 auto;
    padding: 40px 20px;
  }

  .ai-contact-form__container-{{ ai_gen_id }} {
    background-color: {{ block.settings.background_color }};
    padding: 40px;
    border-radius: {{ block.settings.border_radius }}px;
  }

  .ai-contact-form__heading-{{ ai_gen_id }} {
    color: {{ block.settings.heading_color }};
    font-size: {{ block.settings.heading_size }}px;
    margin: 0 0 10px;
    text-align: center;
  }

  .ai-contact-form__subheading-{{ ai_gen_id }} {
    color: {{ block.settings.text_color }};
    font-size: {{ block.settings.text_size }}px;
    margin: 0 0 30px;
    text-align: center;
  }

  .ai-contact-form__fields-{{ ai_gen_id }} {
    display: grid;
    gap: 20px;
  }

  .ai-contact-form__row-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 20px;
  }

  @media screen and (max-width: 749px) {
    .ai-contact-form__row-{{ ai_gen_id }} {
      grid-template-columns: 1fr;
    }
  }

  .ai-contact-form__field-{{ ai_gen_id }} {
    opacity: 0;
    transform: translateY(20px);
  }

  .ai-contact-form__field-{{ ai_gen_id }}.ai-contact-form__field--visible-{{ ai_gen_id }} {
    opacity: 1;
    transform: translateY(0);
    transition: opacity 0.5s ease, transform 0.5s ease;
  }

  .ai-contact-form__label-{{ ai_gen_id }} {
    display: block;
    color: {{ block.settings.label_color }};
    font-size: 14px;
    margin-bottom: 8px;
    font-weight: 500;
  }

  .ai-contact-form__input-{{ ai_gen_id }},
  .ai-contact-form__textarea-{{ ai_gen_id }} {
    width: 100%;
    padding: 12px 16px;
    border: 1px solid {{ block.settings.input_border_color }};
    border-radius: {{ block.settings.input_border_radius }}px;
    background-color: {{ block.settings.input_background }};
    color: {{ block.settings.input_text_color }};
    font-size: 14px;
    transition: border-color 0.3s ease, box-shadow 0.3s ease;
  }

  .ai-contact-form__input-{{ ai_gen_id }}:focus,
  .ai-contact-form__textarea-{{ ai_gen_id }}:focus {
    outline: none;
    border-color: {{ block.settings.input_focus_border }};
    box-shadow: 0 0 0 3px {{ block.settings.input_focus_border }}33;
  }

  .ai-contact-form__textarea-{{ ai_gen_id }} {
    min-height: 120px;
    resize: vertical;
  }

  .ai-contact-form__button-{{ ai_gen_id }} {
    width: 100%;
    padding: 14px 24px;
    background-color: {{ block.settings.button_color }};
    color: {{ block.settings.button_text_color }};
    border: none;
    border-radius: {{ block.settings.button_border_radius }}px;
    font-size: 16px;
    font-weight: 600;
    cursor: pointer;
    transition: background-color 0.3s ease, transform 0.2s ease;
  }

  .ai-contact-form__button-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.button_hover_color }};
    transform: translateY(-2px);
  }

  .ai-contact-form__button-{{ ai_gen_id }}:active {
    transform: translateY(0);
  }

  .ai-contact-form__error-{{ ai_gen_id }} {
    color: {{ block.settings.error_color }};
    font-size: 13px;
    margin-top: 8px;
  }

  .ai-contact-form__thank-you-{{ ai_gen_id }} {
    display: none;
    text-align: center;
    padding: 60px 40px;
  }

  .ai-contact-form__thank-you-{{ ai_gen_id }}.ai-contact-form__thank-you--visible-{{ ai_gen_id }} {
    display: block;
  }

  .ai-contact-form__thank-you-icon-{{ ai_gen_id }} {
    width: 80px;
    height: 80px;
    margin: 0 auto 20px;
    background-color: {{ block.settings.success_color }};
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 0;
    transform: scale(0);
  }

  .ai-contact-form__thank-you-icon-{{ ai_gen_id }}.ai-contact-form__thank-you-icon--visible-{{ ai_gen_id }} {
    opacity: 1;
    transform: scale(1);
    transition: opacity 0.5s ease 0.2s, transform 0.5s cubic-bezier(0.68, -0.55, 0.265, 1.55) 0.2s;
  }

  .ai-contact-form__thank-you-icon-{{ ai_gen_id }} svg {
    width: 40px;
    height: 40px;
    stroke: #ffffff;
    stroke-width: 3;
    stroke-linecap: round;
    stroke-linejoin: round;
    fill: none;
  }

  .ai-contact-form__thank-you-title-{{ ai_gen_id }} {
    color: {{ block.settings.heading_color }};
    font-size: {{ block.settings.heading_size }}px;
    margin: 0 0 10px;
    opacity: 0;
    transform: translateY(20px);
  }

  .ai-contact-form__thank-you-title-{{ ai_gen_id }}.ai-contact-form__thank-you-title--visible-{{ ai_gen_id }} {
    opacity: 1;
    transform: translateY(0);
    transition: opacity 0.5s ease 0.4s, transform 0.5s ease 0.4s;
  }

  .ai-contact-form__thank-you-message-{{ ai_gen_id }} {
    color: {{ block.settings.text_color }};
    font-size: {{ block.settings.text_size }}px;
    margin: 0;
    opacity: 0;
    transform: translateY(20px);
  }

  .ai-contact-form__thank-you-message-{{ ai_gen_id }}.ai-contact-form__thank-you-message--visible-{{ ai_gen_id }} {
    opacity: 1;
    transform: translateY(0);
    transition: opacity 0.5s ease 0.6s, transform 0.5s ease 0.6s;
  }

  @media screen and (max-width: 749px) {
    .ai-contact-form__container-{{ ai_gen_id }} {
      padding: 30px 20px;
    }

    .ai-contact-form__heading-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.heading_size }}px * 0.8);
    }
  }
{% endstyle %}

<contact-form-{{ ai_gen_id }} class="ai-contact-form-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-contact-form__container-{{ ai_gen_id }}">
    <div class="ai-contact-form__form-wrapper-{{ ai_gen_id }}">
      {% if block.settings.heading != blank %}
        <h2 class="ai-contact-form__heading-{{ ai_gen_id }}">{{ block.settings.heading }}</h2>
      {% endif %}

      {% if block.settings.subheading != blank %}
        <p class="ai-contact-form__subheading-{{ ai_gen_id }}">{{ block.settings.subheading }}</p>
      {% endif %}

      {% form 'contact' %}
        <div class="ai-contact-form__fields-{{ ai_gen_id }}">
          <div class="ai-contact-form__row-{{ ai_gen_id }}">
            <div class="ai-contact-form__field-{{ ai_gen_id }}" data-delay="0">
              <label class="ai-contact-form__label-{{ ai_gen_id }}" for="contact-first-name-{{ ai_gen_id }}">
                {{ block.settings.first_name_label }}
              </label>
              <input
                type="text"
                id="contact-first-name-{{ ai_gen_id }}"
                name="contact[first_name]"
                class="ai-contact-form__input-{{ ai_gen_id }}"
                placeholder="{{ block.settings.first_name_placeholder }}"
                required
              >
            </div>

            <div class="ai-contact-form__field-{{ ai_gen_id }}" data-delay="100">
              <label class="ai-contact-form__label-{{ ai_gen_id }}" for="contact-last-name-{{ ai_gen_id }}">
                {{ block.settings.last_name_label }}
              </label>
              <input
                type="text"
                id="contact-last-name-{{ ai_gen_id }}"
                name="contact[last_name]"
                class="ai-contact-form__input-{{ ai_gen_id }}"
                placeholder="{{ block.settings.last_name_placeholder }}"
                required
              >
            </div>
          </div>

          <div class="ai-contact-form__field-{{ ai_gen_id }}" data-delay="200">
            <label class="ai-contact-form__label-{{ ai_gen_id }}" for="contact-phone-{{ ai_gen_id }}">
              {{ block.settings.phone_label }}
            </label>
            <input
              type="tel"
              id="contact-phone-{{ ai_gen_id }}"
              name="contact[phone]"
              class="ai-contact-form__input-{{ ai_gen_id }}"
              placeholder="{{ block.settings.phone_placeholder }}"
              required
            >
          </div>

          <div class="ai-contact-form__field-{{ ai_gen_id }}" data-delay="300">
            <label class="ai-contact-form__label-{{ ai_gen_id }}" for="contact-email-{{ ai_gen_id }}">
              {{ block.settings.email_label }}
            </label>
            <input
              type="email"
              id="contact-email-{{ ai_gen_id }}"
              name="contact[email]"
              class="ai-contact-form__input-{{ ai_gen_id }}"
              placeholder="{{ block.settings.email_placeholder }}"
              autocomplete="email"
              {% if form.errors %}
                aria-invalid="true"
                aria-describedby="contact-form-error-{{ ai_gen_id }}"
              {% endif %}
              required
            >
          </div>

          <div class="ai-contact-form__field-{{ ai_gen_id }}" data-delay="400">
            <label class="ai-contact-form__label-{{ ai_gen_id }}" for="contact-requirements-{{ ai_gen_id }}">
              {{ block.settings.requirements_label }}
            </label>
            <textarea
              id="contact-requirements-{{ ai_gen_id }}"
              name="contact[body]"
              class="ai-contact-form__textarea-{{ ai_gen_id }}"
              placeholder="{{ block.settings.requirements_placeholder }}"
              required
            ></textarea>
          </div>

          {% if form.errors %}
            <div id="contact-form-error-{{ ai_gen_id }}" class="ai-contact-form__error-{{ ai_gen_id }}">
              {{ form.errors.messages.email }}
            </div>
          {% endif %}

          <div class="ai-contact-form__field-{{ ai_gen_id }}" data-delay="500">
            <button type="submit" class="ai-contact-form__button-{{ ai_gen_id }}">
              {{ block.settings.button_text }}
            </button>
          </div>
        </div>
      {% endform %}
    </div>

    <div class="ai-contact-form__thank-you-{{ ai_gen_id }}">
      <div class="ai-contact-form__thank-you-icon-{{ ai_gen_id }}">
        <svg viewBox="0 0 52 52">
          <polyline points="14 27 22 35 38 19"/>
        </svg>
      </div>
      <h2 class="ai-contact-form__thank-you-title-{{ ai_gen_id }}">{{ block.settings.thank_you_title }}</h2>
      <p class="ai-contact-form__thank-you-message-{{ ai_gen_id }}">{{ block.settings.thank_you_message }}</p>
    </div>
  </div>
</contact-form-{{ ai_gen_id }}>

<script>
  (function() {
    class ContactForm{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
        this.formWrapper = this.querySelector('.ai-contact-form__form-wrapper-{{ ai_gen_id }}');
        this.thankYouWrapper = this.querySelector('.ai-contact-form__thank-you-{{ ai_gen_id }}');
        this.form = this.querySelector('form');
        this.fields = this.querySelectorAll('.ai-contact-form__field-{{ ai_gen_id }}');
      }

      connectedCallback() {
        this.animateFieldsOnLoad();
        this.checkFormSubmission();
        this.form.addEventListener('submit', this.handleSubmit.bind(this));
      }

      animateFieldsOnLoad() {
        this.fields.forEach((field) => {
          const delay = field.getAttribute('data-delay') || 0;
          setTimeout(() => {
            field.classList.add('ai-contact-form__field--visible-{{ ai_gen_id }}');
          }, parseInt(delay));
        });
      }

      checkFormSubmission() {
        const urlParams = new URLSearchParams(window.location.search);
        const formSubmitted = urlParams.get('contact_posted');
        
        if (formSubmitted === 'true') {
          this.showThankYou();
        }
      }

      handleSubmit(event) {
        const formData = new FormData(this.form);
        const hasErrors = !this.form.checkValidity();
        
        if (!hasErrors) {
          setTimeout(() => {
            this.showThankYou();
          }, 100);
        }
      }

      showThankYou() {
        this.formWrapper.style.display = 'none';
        this.thankYouWrapper.classList.add('ai-contact-form__thank-you--visible-{{ ai_gen_id }}');
        
        setTimeout(() => {
          const icon = this.querySelector('.ai-contact-form__thank-you-icon-{{ ai_gen_id }}');
          const title = this.querySelector('.ai-contact-form__thank-you-title-{{ ai_gen_id }}');
          const message = this.querySelector('.ai-contact-form__thank-you-message-{{ ai_gen_id }}');
          
          if (icon) icon.classList.add('ai-contact-form__thank-you-icon--visible-{{ ai_gen_id }}');
          if (title) title.classList.add('ai-contact-form__thank-you-title--visible-{{ ai_gen_id }}');
          if (message) message.classList.add('ai-contact-form__thank-you-message--visible-{{ ai_gen_id }}');
        }, 100);
      }
    }

    customElements.define('contact-form-{{ ai_gen_id }}', ContactForm{{ ai_gen_id }});
  })();
</script>

