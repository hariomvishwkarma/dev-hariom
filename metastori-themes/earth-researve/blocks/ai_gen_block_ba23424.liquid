{% doc %}
  @prompt
    collection card for 7 collections with a nice transition & animation for the fonts, collection cards in row, in 2 rows. also fit to the screen, collection card size option
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-collection-grid-{{ ai_gen_id }} {
    width: 100%;
    padding: 40px 20px;
    background-color: {{ block.settings.background_color }};
  }

  .ai-collection-grid__container-{{ ai_gen_id }} {
    max-width: 1400px;
    margin: 0 auto;
  }

  .ai-collection-grid__heading-{{ ai_gen_id }} {
    text-align: center;
    margin-bottom: 40px;
    color: {{ block.settings.heading_color }};
    font-size: {{ block.settings.heading_size }}px;
  }

  .ai-collection-grid__grid-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: {{ block.settings.card_gap }}px;
  }

  .ai-collection-card-{{ ai_gen_id }} {
    position: relative;
    overflow: hidden;
    border-radius: {{ block.settings.card_border_radius }}px;
    background-color: {{ block.settings.card_background }};
    text-decoration: none;
    display: block;
    {% if block.settings.card_size == 'small' %}
      aspect-ratio: {{ block.settings.card_aspect_ratio }};
      max-height: 250px;
    {% elsif block.settings.card_size == 'medium' %}
      aspect-ratio: {{ block.settings.card_aspect_ratio }};
      max-height: 350px;
    {% elsif block.settings.card_size == 'large' %}
      aspect-ratio: {{ block.settings.card_aspect_ratio }};
      max-height: 450px;
    {% else %}
      aspect-ratio: {{ block.settings.card_aspect_ratio }};
    {% endif %}
  }

  .ai-collection-card__image-wrapper-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    height: 100%;
    overflow: hidden;
  }

  .ai-collection-card__image-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.6s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .ai-collection-card-{{ ai_gen_id }}:hover .ai-collection-card__image-{{ ai_gen_id }} {
    transform: scale(1.05);
  }

  .ai-collection-card__overlay-{{ ai_gen_id }} {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    padding: 30px 20px;
    background: linear-gradient(to top, rgba(0, 0, 0, {{ block.settings.overlay_opacity }}), transparent);
    transition: background 0.4s ease;
  }

  .ai-collection-card-{{ ai_gen_id }}:hover .ai-collection-card__overlay-{{ ai_gen_id }} {
    background: linear-gradient(to top, rgba(0, 0, 0, {{ block.settings.overlay_opacity | plus: 0.2 }}), transparent);
  }

  .ai-collection-card__title-{{ ai_gen_id }} {
    color: {{ block.settings.card_text_color }};
    font-size: {{ block.settings.card_title_size }}px;
    margin: 0;
    opacity: 0;
    transform: translateY(20px);
    animation: ai-fade-in-up-{{ ai_gen_id }} 0.6s ease forwards;
  }

  .ai-collection-card-{{ ai_gen_id }}:hover .ai-collection-card__title-{{ ai_gen_id }} {
    animation: ai-title-bounce-{{ ai_gen_id }} 0.5s ease;
  }

  .ai-collection-card__count-{{ ai_gen_id }} {
    color: {{ block.settings.card_text_color }};
    font-size: {{ block.settings.card_count_size }}px;
    margin: 5px 0 0;
    opacity: 0;
    transform: translateY(20px);
    animation: ai-fade-in-up-{{ ai_gen_id }} 0.6s ease 0.1s forwards;
  }

  .ai-collection-card__placeholder-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    background-color: #f4f4f4;
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
  }

  .ai-collection-card__placeholder-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
    max-width: 200px;
    max-height: 200px;
    opacity: 0.3;
  }

  .ai-collection-card__empty-state-{{ ai_gen_id }} {
    position: absolute;
    bottom: 20px;
    left: 50%;
    transform: translateX(-50%);
    padding: 8px 16px;
    font-size: 12px;
    color: #666;
    text-align: center;
    pointer-events: none;
  }

  @keyframes ai-fade-in-up-{{ ai_gen_id }} {
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @keyframes ai-title-bounce-{{ ai_gen_id }} {
    0%, 100% {
      transform: translateY(0);
    }
    50% {
      transform: translateY(-5px);
    }
  }

  @media screen and (max-width: 989px) {
    .ai-collection-grid__grid-{{ ai_gen_id }} {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  @media screen and (max-width: 749px) {
    .ai-collection-grid__grid-{{ ai_gen_id }} {
      grid-template-columns: repeat(2, 1fr);
      gap: {{ block.settings.card_gap | times: 0.7 }}px;
    }

    .ai-collection-grid__heading-{{ ai_gen_id }} {
      font-size: {{ block.settings.heading_size | times: 0.7 }}px;
      margin-bottom: 30px;
    }

    .ai-collection-card__title-{{ ai_gen_id }} {
      font-size: {{ block.settings.card_title_size | times: 0.8 }}px;
    }

    .ai-collection-card__count-{{ ai_gen_id }} {
      font-size: {{ block.settings.card_count_size | times: 0.8 }}px;
    }

    .ai-collection-card__overlay-{{ ai_gen_id }} {
      padding: 20px 15px;
    }

    .ai-collection-card-{{ ai_gen_id }} {
      {% if block.settings.card_size == 'small' %}
        max-height: 200px;
      {% elsif block.settings.card_size == 'medium' %}
        max-height: 280px;
      {% elsif block.settings.card_size == 'large' %}
        max-height: 360px;
      {% endif %}
    }
  }
{% endstyle %}

<div class="ai-collection-grid-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-collection-grid__container-{{ ai_gen_id }}">
    {% if block.settings.heading != blank %}
      <h2 class="ai-collection-grid__heading-{{ ai_gen_id }}">{{ block.settings.heading }}</h2>
    {% endif %}

    <div class="ai-collection-grid__grid-{{ ai_gen_id }}">
      {% for i in (1..7) %}
        {% liquid
          assign collection_key = 'collection_' | append: i
          assign collection = block.settings[collection_key]
        %}

        {% if collection != blank %}
          <a href="{{ collection.url }}" class="ai-collection-card-{{ ai_gen_id }}">
            <div class="ai-collection-card__image-wrapper-{{ ai_gen_id }}">
              {% if collection.featured_image %}
                <img
                  src="{{ collection.featured_image | image_url: width: 800 }}"
                  alt="{{ collection.featured_image.alt | escape }}"
                  width="800"
                  height="800"
                  loading="lazy"
                  class="ai-collection-card__image-{{ ai_gen_id }}"
                >
              {% else %}
                <div class="ai-collection-card__placeholder-{{ ai_gen_id }}">
                  {{ 'collection-1' | placeholder_svg_tag }}
                </div>
              {% endif %}
              <div class="ai-collection-card__overlay-{{ ai_gen_id }}">
                <h3 class="ai-collection-card__title-{{ ai_gen_id }}">{{ collection.title }}</h3>
                {% if block.settings.show_product_count %}
                  <p class="ai-collection-card__count-{{ ai_gen_id }}">{{ collection.products_count }} products</p>
                {% endif %}
              </div>
            </div>
          </a>
        {% else %}
          <div class="ai-collection-card-{{ ai_gen_id }}">
            <div class="ai-collection-card__image-wrapper-{{ ai_gen_id }}">
              <div class="ai-collection-card__placeholder-{{ ai_gen_id }}">
                {{ 'collection-1' | placeholder_svg_tag }}
                <div class="ai-collection-card__empty-state-{{ ai_gen_id }}">
                  Select collection {{ i }}
                </div>
              </div>
            </div>
          </div>
        {% endif %}
      {% endfor %}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Collection grid",
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Heading",
      "default": "Shop by collection"
    },
    {
      "type": "checkbox",
      "id": "show_product_count",
      "label": "Show product count",
      "default": true
    },
    {
      "type": "header",
      "content": "Collections"
    },
    {
      "type": "collection",
      "id": "collection_1",
      "label": "Collection 1"
    },
    {
      "type": "collection",
      "id": "collection_2",
      "label": "Collection 2"
    },
    {
      "type": "collection",
      "id": "collection_3",
      "label": "Collection 3"
    },
    {
      "type": "collection",
      "id": "collection_4",
      "label": "Collection 4"
    },
    {
      "type": "collection",
      "id": "collection_5",
      "label": "Collection 5"
    },
    {
      "type": "collection",
      "id": "collection_6",
      "label": "Collection 6"
    },
    {
      "type": "collection",
      "id": "collection_7",
      "label": "Collection 7"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "card_size",
      "label": "Card size",
      "options": [
        {
          "value": "small",
          "label": "Small"
        },
        {
          "value": "medium",
          "label": "Medium"
        },
        {
          "value": "large",
          "label": "Large"
        },
        {
          "value": "auto",
          "label": "Auto"
        }
      ],
      "default": "medium"
    },
    {
      "type": "select",
      "id": "card_aspect_ratio",
      "label": "Card aspect ratio",
      "options": [
        {
          "value": "1/1",
          "label": "Square"
        },
        {
          "value": "4/5",
          "label": "Portrait"
        },
        {
          "value": "3/4",
          "label": "Tall portrait"
        },
        {
          "value": "16/9",
          "label": "Landscape"
        }
      ],
      "default": "4/5"
    },
    {
      "type": "range",
      "id": "card_gap",
      "min": 10,
      "max": 40,
      "step": 5,
      "unit": "px",
      "label": "Gap between cards",
      "default": 20
    },
    {
      "type": "range",
      "id": "card_border_radius",
      "min": 0,
      "max": 30,
      "step": 2,
      "unit": "px",
      "label": "Card border radius",
      "default": 8
    },
    {
      "type": "header",
      "content": "Style"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading color",
      "default": "#000000"
    },
    {
      "type": "range",
      "id": "heading_size",
      "min": 20,
      "max": 60,
      "step": 2,
      "unit": "px",
      "label": "Heading size",
      "default": 32
    },
    {
      "type": "color",
      "id": "card_background",
      "label": "Card background",
      "default": "#f4f4f4"
    },
    {
      "type": "color",
      "id": "card_text_color",
      "label": "Card text color",
      "default": "#ffffff"
    },
    {
      "type": "range",
      "id": "card_title_size",
      "min": 14,
      "max": 40,
      "step": 2,
      "unit": "px",
      "label": "Card title size",
      "default": 20
    },
    {
      "type": "range",
      "id": "card_count_size",
      "min": 10,
      "max": 24,
      "step": 1,
      "unit": "px",
      "label": "Product count size",
      "default": 14
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "min": 0,
      "max": 1,
      "step": 0.1,
      "label": "Overlay opacity",
      "default": 0.5
    }
  ],
  "presets": [
    {
      "name": "Collection grid"
    }
  ]
}
{% endschema %}
