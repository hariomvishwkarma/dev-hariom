<li
    class="product-grid__item product-grid__spotlight"
    {{ block.shopify_attributes }}
    style="order: {{ block.settings.block_position }};"
    position="{{ block.settings.block_position }}"
>
    <div class="collection-image-block">
        <div class="collection-image-block__media media">
            {% if block.settings.media_type == 'video' %}
                {{
                    block.settings.video
                    | video_tag:
                    autoplay: true,
                    loop: true,
                    muted: true,
                    controls: false,
                    playsinline: true
                }}
            {% elsif block.settings.media_type == 'image' %}
                {%- assign widths = '165, 360, 535, 750, 1070, 1500' -%}
                {%- capture sizes -%}
                    (min-width: {{ settings.page_width }}px) {{ settings.page_width | minus: 100 | divided_by: 2 }}px,
                    (min-width: 750px) calc((100vw - 130px) / 2),
                    calc((100vw - 50px) / 2)
                {%- endcapture -%}

                {{
                    block.settings.image
                    | image_url: width: 1500
                    | image_tag:
                    sizes: sizes,
                    widths: widths,
                    fetchpriority: fetch_priority
                }}
            {% else %}
                {{ 'detailed-apparel-1' | placeholder_svg_tag: 'placeholder-svg' }}
            {% endif %}

            {% if block.settings.button_link != blank and block.settings.button_label == blank %}
                <a href="{{ block.settings.button_link }}"
                class="collection-image-block__overlay-link"
                aria-label="collection-image-block-link"
                {{ block.shopify_attributes }}
                >
                <span class="hidden">{{ block.settings.button_label | escape }}</span>
                </a>
            {% endif %}
        </div>
        {%- if block.settings.subheading != blank or block.settings.heading != blank or block.settings.button_label != blank -%}
            <div class="collection-image-block__content overflow-scrollbar horizontal-position__{{ block.settings.horizontal_alignment }} vertical-button-content-{{ block.settings.vertical_alignment }}-{{ block.settings.vertical_button_alignment }}">
                <div class="image-block-content__inner sp-small color-{{ block.settings.color_scheme }} vertical-position__{{ block.settings.vertical_alignment }}">
                    {%- if block.settings.subheading != blank -%}
                        <div class="subheading__text rte">
                            <p>{{ block.settings.subheading }}</p>
                        </div>
                    {%- endif -%}
                    <h3
                        class="image-with-text__heading inline-richtext">
                        {{ block.settings.heading }}
                    </h3>
                </div>
                <div class="image-block-content__inner sp-small color-{{ block.settings.color_scheme }} vertical-button-position__{{ block.settings.vertical_button_alignment }}">
                    {%- if block.settings.button_label != blank -%}
                        <div class="image-block__buttons">
                            <a
                            {% if block.settings.button_link == blank %}
                                role="link" aria-disabled="true"
                            {% else %}
                                href="{{ block.settings.button_link }}"
                            {% endif %}
                            class="button button--primary"
                            {{ block.shopify_attributes }}
                            >
                            {{ block.settings.button_label | escape }}
                            </a>
                        </div>
                    {%- endif -%}
                </div>
            </div>
        {% endif %}
    </div>
</li>
{% schema %}
{
  "name": "Collection grid content",
  "tag": null,
  "settings": [
    {
        "type": "color_scheme",
        "id": "color_scheme",
        "label": "Color scheme",
        "default": "scheme-1"
    },
    {
        "type": "range",
        "id": "block_position",
        "min": 1,
        "max": 24,
        "step": 1,
        "default": 5,
        "label": "Image placement",    },
    {
        "type": "select",
        "id": "media_type",
        "label": "Media type",
        "default": "image",
        "options": [
            {
                "label": "Image",
                "value": "image"
            },
            {
                "value": "video",
                "label": "Video"
            }
        ]
    },
    {
        "type": "image_picker",
        "id": "image",
        "label": "Image",
        "visible_if": "{{ block.settings.media_type == 'image' }}"
    },
    {
        "type": "video",
        "id": "video",
        "label": "Video",
        "visible_if": "{{ block.settings.media_type == 'video' }}"
    },
    {
        "type": "inline_richtext",
        "id": "subheading",
        "label": "Subheading",
        "default": "Subheading"
    },
    {
        "type": "inline_richtext",
        "id": "heading",
        "label": "Heading",
        "default": "Heading"
    },
    {
        "type": "text",
        "id": "button_label",
        "label": "Button label",
        "default": "Button label"
    },
    {
        "type": "url",
        "id": "button_link",
        "label": "Button link"
    },
    {
        "type": "select",
        "id": "vertical_alignment",
        "label": "Arrange content position",
        "default": "bottom",
        "options": [
            {
                "label": "Top",
                "value": "top"
            },
            {
                "value": "middle",
                "label": "Middle"
            },
            {
                "label": "Bottom",
                "value": "bottom"
            }
        ]
    },
    {
        "type": "select",
        "id": "vertical_button_alignment",
        "label": "Arrange button position",
        "default": "bottom",
        "options": [
            {
                "value": "middle",
                "label": "Middle"
            },
            {
                "label": "Bottom",
                "value": "bottom"
            }
        ]
    },
    {
        "type": "select",
        "id": "horizontal_alignment",
        "label": "Arrange alignment",
        "default": "left",
        "options": [
        {
            "label": "Left",
            "value": "left"
        },
        {
            "label": "Center",
            "value": "center"
        },
        {
            "label": "Right",
            "value": "right"
        }
        ]
    }
  ],
  "presets": [
    {
      "name": "Collection grid content",
      "category": "t:categories.basic"
    }
  ]
}
{% endschema %}
