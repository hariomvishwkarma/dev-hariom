          <path d="M7.704 19.0582C8.323 19.7029 8.323 20.7477 7.704 21.3915C7.085 22.0363 6.082 22.0363 5.464 21.3915C4.846 20.7467 4.845 19.7019 5.464 19.0582C6.083 18.4144 7.085 18.4134 7.704 19.0582" stroke="#aa634b" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path>
          <path d="M10 4.1665H14C14.552 4.1665 15 4.63317 15 5.20817V15.6248H2" stroke="#aa634b" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path>
          <path d="M5 20.2248H3C2.448 20.2248 2 19.7582 2 19.1832V13.5415" stroke="#aa634b" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path>
          <path d="M15 7.2915H19.323C19.732 7.2915 20.1 7.55088 20.251 7.94671L21.857 12.128C21.951 12.3738 22 12.6363 22 12.9009V19.0967C22 19.6717 21.552 20.1384 21 20.1384H19.169" stroke="#aa634b" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path>
          <path d="M16 20.2291H8.17001" stroke="#aa634b" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path>
          <path d="M22 14.5832H18V10.4165H21.2" stroke="#aa634b" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path>
          <path d="M2 4.16659H7" stroke="#aa634b" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path>
          <path d="M2 7.29159H5" stroke="#aa634b" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path>
          <path d="M3 10.4166H2" stroke="#aa634b" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path>
        </svg>
    </span>
    <progress-bar
      class="progress-bar"
      role="progressbar"
    ></progress-bar>
    <p class="shipping-bar__message">
        {% if progress >= 100 %}
          {% if settings.success_message != blank %}
            {{ settings.success_message }}
          {% endif %}
      {% else %}
        {% if settings.required_message != blank %}
          {{ settings.required_message | replace: "||remaining||", remaining_free }} 
        {% endif %}
      {% endif %}
    </p>
  </free-shipping-bar>
</div>
