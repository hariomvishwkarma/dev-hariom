{%- doc -%}
  Renders a menu filter.

  @param {linklist} menu - The navigation menu
  @param {string} filter_style - horizontal or vertical
{%- enddoc -%}

<accordion-custom
  class="facets__item custom-menu-facets__item"
  {% if filter_style == 'horizontal' %}
    data-disable-animation-on-desktop="true"
    data-close-with-escape="true"
  {% endif %}
  open-by-default-on-mobile
  {% if filter_style == 'vertical' %}
    open
    open-by-default-on-desktop
  {% endif %}
>
  <details
    class="facets__panel"
    {% if filter_style == 'horizontal' %}
      data-auto-close-details="desktop"
    {% endif %}
  >
    <summary class="facets__summary">
      <span class="facets__label">{{ heading }}</span>

      <span class="svg-wrapper icon-caret icon-animated">
        {{ 'icon-caret.svg' | inline_asset_content }}
      </span>
    </summary>

    <floating-panel-component
      {% unless filter_style == 'vertical' %}
        data-close-on-resize
      {% endunless %}
      class="facets__panel-content details-content{% if filter_style == 'horizontal' %} color-{{ settings.popover_color_scheme }}{% endif %}"
    >
      <div class="facets__inputs-wrapper">
        <ul class="facets__inputs-list">

          {% for link in menu.links %}
            <li class="facets__item">
              <a href="{{ link.url }}" class="facets__label">
                {{ link.title }}
              </a>
            </li>
          {% endfor %}

        </ul>
      </div>
    </floating-panel-component>

  </details>
</accordion-custom>