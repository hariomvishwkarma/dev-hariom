<style>
.{{ block.id }}.trustpilet-cus{
  position:absolute;
  top: {{ block.settings.top_desktop }}%;
  left: {{ block.settings.left_desktop }}%;
  width: 100%;
}
.trustpilet-cus img, .trustpilet-cus p {
    margin: 0;
}
.trustpilet-cus p {
    display: flex;
    gap: 7px;
    align-items: center;
    color: white;
}
.trustpilet-cus p span {
    display: flex !important;
    align-items: center;
    color: white;
}
@media(max-width:768px){
  .{{ block.id }}.trustpilet-cus{
    top: {{ block.settings.top_mobile }}%;
    left: {{ block.settings.left_mobile }}%;
  }
  .cus-trust-badges {
    width: 80px;
  }
}
</style>

<div class="trustpilet-cus {{ block.id }}">
  <p style="text-align:center;">
    <span>
      <img
        src="https://emailsignature.trustpilot.com/newsletter/nl-NL/1/617ff6896bc505ee409c533a/stars@2x.png"
        alt="Trustpilot Stars"
        height="20"
        style="max-height:20px;"
        border="0">
    </span>

    <span style="display:inline-block;">
      <img
        src="https://emailsignature.trustpilot.com/newsletter/nl-NL/1/617ff6896bc505ee409c533a/text2_dark@2x.png"
        alt="number of reviews"
        height="18"
        style="max-height:18px;"
        border="0">
    </span>
  </p>
</div>

{% schema %}
{
  "name": "Trustpilet",
  "settings": [

    {
      "type": "range",
      "id": "top_desktop",
      "label": "Top Desktop (%)",
      "min": 0,
      "max": 100,
      "step": 1,
      "default": 0
    },
    {
      "type": "range",
      "id": "left_desktop",
      "label": "Left Desktop (%)",
      "min": 0,
      "max": 100,
      "step": 1,
      "default": 1
    },

    {
      "type": "range",
      "id": "top_mobile",
      "label": "Top Mobile (%)",
      "min": 0,
      "max": 100,
      "step": 1,
      "default": 0
    },
    {
      "type": "range",
      "id": "left_mobile",
      "label": "Left Mobile (%)",
      "min": 0,
      "max": 100,
      "step": 1,
      "default": 1
    },

  ],
  "presets": [
    {
      "name": "Trustpilet"
    }
  ]
}
{% endschema %}