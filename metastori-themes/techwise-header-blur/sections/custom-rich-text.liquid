<style>
.custom-rich-text p,
.custom-rich-text ol,
.custom-rich-text h6,
.custom-rich-text ul {
  text-align: left !important;
  text-wrap: auto;
  color: #000;
}
.custom-rich-text h6 {
  line-height: 1.35em;
  font-size: 1.5em;
  margin-top: 28px;
  margin-bottom: 28px;
}
.custom-rich-text ol {
  margin-block-start: 0.75rem;
  margin-block-end: 2rem;
}
.custom-rich-text li {
  /* Increment the counter for every LI */
  counter-increment: step-counter;
  font-weight: 400; /* Regular */
  line-height: 1.35em;
  margin-bottom: 14px;
}
.custom-rich-text .section-spacing {
  padding-block-start: 24px;
  padding-block-end: 48px;
}
.custom-rich-text-video{
  margin-bottom: 24px;
}

.custom-rich-text-video video,
.custom-rich-text-video iframe{
  width:100%;
}
</style>

<div class="color-scheme color-scheme--{{ section.settings.color_scheme.id }}">
    <div class="container section-spacing">
        <div class="custom-rich-text rich-text justify-items-{{ section.settings.text_alignment | replace: 'left', 'start' | replace: 'right', 'end' }}">
            <div class="custom-rich-text-container prose  max-w-{{ section.settings.content_width }}">
                {%- render 'heading', 
                    content: section.settings.title,
                    style: section.settings.title_heading_tag,
                    balance_text: true
                -%}
                {% if section.settings.video != blank %}
                <div class="custom-rich-text-video">
                    {{ section.settings.video | video_tag: controls: true, autoplay: false, loop: false }}
                </div>
                {% elsif section.settings.video_embed != blank %}
                <div class="custom-rich-text-video">
                    {{ section.settings.video_embed }}
                </div>
                {% endif %}
                {%- render 'heading', 
                    content: section.settings.text,
                    style: section.settings.heading_tag,
                    indent: section.settings.indent,
                    balance_text: true
                -%}
                {%- if section.settings.richtext-text != blank -%}
                    <div>
                    {{- section.settings.richtext-text -}}
                    </div>
                {%- endif -%}
            </div>
        </div>
    </div>
</div>

{% schema %}
{
  "name": "Custom richtext",
  "class": "shopify-section--rich-text",
  "tag": "section",
  "disabled_on": {
    "groups": ["header", "custom.overlay"]
  },
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:global.colors.scheme",
      "default": "scheme-1"
    },
    {
      "type": "select",
      "id": "content_width",
      "label": "t:global.sizes.content_width",
      "options": [
        {
          "value": "sm",
          "label": "t:global.sizes.small"
        },
        {
          "value": "md",
          "label": "t:global.sizes.medium"
        },
        {
          "value": "lg",
          "label": "t:global.sizes.large"
        },
        {
          "value": "full",
          "label": "t:global.sizes.full_width"
        }
      ],
      "default": "md"
    },
    {
      "type": "text_alignment",
      "id": "text_alignment",
      "label": "t:global.position.content_position",
      "default": "center"
    },
    {
        "type": "header",
        "content": "Title"
    },
    {
        "type": "inline_richtext",
        "id": "title",
        "label": "Title",
        "default": "Heading"
    },
    {
        "type": "select",
        "id": "title_heading_tag",
        "label": "t:global.text.size",
        "options": [
        {
            "value": "display-xl",
            "label": "Display XL"
        },
        {
            "value": "display-l",
            "label": "Display L"
        },
        {
            "value": "display-m",
            "label": "Display M"
        },
        {
            "value": "h1",
            "label": "XX-Large"
        },
        {
            "value": "h2",
            "label": "X-Large"
        },
        {
            "value": "h3",
            "label": "Large"
        },
        {
            "value": "h4",
            "label": "Medium"
        },
        {
            "value": "h5",
            "label": "Small"
        },
        {
            "value": "h6",
            "label": "X-Small"
        },
        {
            "value": "h7",
            "label": "XX-Small"
        }
        ],
        "default": "h2"
    },
    {
        "type": "header",
        "content": "Video"
    },
    {
        "type": "video",
        "id": "video",
        "label": "Shopify hosted video"
    },
    {
        "type": "liquid",
        "id": "video_embed",
        "label": "Embed video (YouTube/Vimeo iframe)"
    },
    {
        "type": "header",
        "content": "Content"
    },
    {
        "type": "inline_richtext",
        "id": "text",
        "label": "Title",
        "default": "Heading"
    },
    {
        "type": "select",
        "id": "heading_tag",
        "label": "t:global.text.size",
        "options": [
        {
            "value": "display-xl",
            "label": "Display XL"
        },
        {
            "value": "display-l",
            "label": "Display L"
        },
        {
            "value": "display-m",
            "label": "Display M"
        },
        {
            "value": "h1",
            "label": "XX-Large"
        },
        {
            "value": "h2",
            "label": "X-Large"
        },
        {
            "value": "h3",
            "label": "Large"
        },
        {
            "value": "h4",
            "label": "Medium"
        },
        {
            "value": "h5",
            "label": "Small"
        },
        {
            "value": "h6",
            "label": "X-Small"
        },
        {
            "value": "h7",
            "label": "XX-Small"
        }
        ],
        "default": "h2"
    },
    {
        "type": "richtext",
        "id": "richtext-text",
        "label": "t:global.text.content",
        "default": "<p>Use this text to share information about your brand with your customers. Describe a product, share announcements, or welcome customers to your store.</p>"
    }
  ],
  "presets": [
    {
      "name": "Custom richtext",
      "category": "t:global.categories.content"
    }
  ]
}
{% endschema %}