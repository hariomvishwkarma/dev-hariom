                            </div>
                        </a>
                    </div>
                    <div class="jobs-detail-content__share-header">
                        <div class="jobs-detail-content__share-line"></div>
                        <div class="jobs-detail-content__share-text">{{'page.vacancy.social_share' | t }}</div>
