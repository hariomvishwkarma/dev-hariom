<style>
    .vacancy-filter-section {
        max-width: 700px;
        margin: 0 auto;
        padding-top: {{ section.settings.padding_top }}px; 
        padding-bottom: {{ section.settings.padding_bottom }}px;    
    }
    .vacancy-business {
        text-align: center;
        padding: 20px;
    }
    h1.vacancy-heading {
        text-align: center;
    }
    .vacancy-apply {
        text-align: center;
        margin: 15px 0;
    }
    .vacancy-apply button.button {
        background: black;
        color: white;
    }

    .vacancy-filter-content__detail-link {
        padding: 16px 12px;
        display: flex;
        justify-content: space-between;
        gap: 33px;
        font-size: 18px;
        transition: .3s;
        border: 1px solid #e4e4e4;
    }
    .vacancy-filter-content__detail-link-name {
        display: flex;
        align-items: center;
        gap: 5px;
    }
    .vacancy-filter-content__detail-link:hover .vacancy-filter-content__detail-link-title {
        color: #143447;
        transition: .5s;
    }
    .vacancy-filter-content__detail-link:hover .vacancy-filter-content__detail-link-name {
        color: #143447;
        transition: .5s;
    }
    .vacancy-description {
        padding-bottom: 24px;
    }
    .jobs-detail-content__share-header {
        display: flex;
        align-items: center;
        gap: 20px;
        padding-bottom: 24px;
        padding-top: 40px;
    }
    .jobs-detail-content__share-text {
        color: #000;
        text-align: center;
        font-size: 16px;
        font-style: normal;
        font-weight: 400;
        line-height: 20px;
        letter-spacing: -.32px;
        flex-shrink: 0;
    }
    .jobs-detail-content__share-line {
        width: 50%;
        height: 1px;
        background: #e4e4e4;
    }
    .xo-share {
        display: flex;
        justify-content: space-between;
        max-width: 250px;
        margin: 0 auto;
    }
    .vacancy-apply {
        text-align: center;
        margin: 15px 0;
        padding-top: 45px;
    }
    .metafield-rich_text_field p {
        padding-bottom: 5px;
    }
    {% comment %} .metafield-rich_text_field li, .metafield-rich_text_field h1, .metafield-rich_text_field h2, .metafield-rich_text_field h3, .metafield-rich_text_field h4, .metafield-rich_text_field h5, .metafield-rich_text_field h6 {
        padding-top: 4px;
        padding-bottom: 4px;
    } {% endcomment %}
    .vacancy-header {
        position: relative;
        max-width: 700px;
        margin: 0 auto;
    }
    .vacancy-back {
        position: absolute;
        top: 20px;
    }
    @media (min-width: 768px) {
        .vacancy-filter-content__detail-link {
            flex-direction: row;
            gap: 20px;
            padding: 16px;
            align-items: center;
        }
    }
    @media only screen and (max-width: 749px) {
        .vacancy-filter-section {
            padding-top: {{ section.settings.padding_top | divided_by: 2 }}px; 
            padding-bottom: {{ section.settings.padding_bottom | divided_by: 2 }}px;
        }
    }
</style>
<div class="container">
    <div class="vacancy-single">
        <div class="vacancy-header">
            <div class="vacancy-back">
            <button type="button" onclick="history.back()" class="back-btn">
                ← Back
            </button>
        </div>
        <p class="vacancy-business">
            {{ metaobject.bussiness_unit }}
        </p>
        <h1 class="vacancy-heading">
            {{ metaobject.heading }}
        </h1>
        </div>
        <div class="vacancy-filter-section">
            <div class="vacancy-description">
                <div class="vacancy-description">
                    {{ metaobject.description | metafield_tag 
                    | replace: '&lt;br&gt;', '<br>' }}
                </div>
            </div>
            {% if section.settings.hide_share == false %}
