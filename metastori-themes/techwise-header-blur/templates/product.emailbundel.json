    "text_with_media_NAPwj9": {
      "type": "text-with-media",
      "blocks": {
        "richtext_rqBzXb": {
          "type": "richtext",
          "settings": {
            "text": "<p>De Techweise TS1 Stoomreiniger is met zijn 24 accessoires ideaal geschikt voor het reinigen van de badkamervoegen, het toilet, het matras en de vloer. Met 1500W en 3,6 bar is geen uitdaging te groot.</p>",
            "position": "middle_left"
          }
        },
        "heading_NLCLi7": {
          "type": "heading",
          "settings": {
            "text": "De meest <em>complete</em> stoomreiniger die álles kan",
            "heading_tag": "h4",
            "position": "top_left",
            "highlight_effect": "underline_pencil",
            "highlight_accent_color": "#dbe1a9",
            "highlight_text_color": ""
          }
        }
      },
      "block_order": [
        "richtext_rqBzXb",
        "heading_NLCLi7"
      ],
      "name": "t:sections.text_with_media.name",
      "settings": {
        "color_scheme": "",
        "content_position": "start",
        "content_percentage_width": 50,
        "overlay_color": "#000000",
        "overlay_opacity": 20,
        "add_media_spacing": false,
        "autoplay_video": true,
        "primary_image": "shopify://shop_images/techweise-ts1-stoomreiniger_033c5b6d-a508-4b41-b0e8-030db7a591a4.jpg",
        "secondary_media_width": 60,
        "secondary_media_mobile_width": 60,
        "show_secondary_media_on_mobile": true,
        "secondary_media_alignment": "place-self-center",
        "secondary_media_shape": "none"
      }
    },
    "text_with_media_yBCaDp": {
      "type": "text-with-media",
      "blocks": {
        "richtext_g9m7Wx": {
          "type": "richtext",
          "settings": {
            "text": "<p>Eindelijk een steelstofzuiger die wél lang mee gaat. 90 minuten om precies te zijn. En met de 3 zuigstanden is geen vuil te veel. Denk aan hondenharen, stof, zand en meer.</p>",
            "position": "middle_left"
          }
        },
        "heading_rFTUCz": {
          "type": "heading",
          "settings": {
            "text": "<em>90 minutenlang </em>stofzuigen, zonder onderbrekingen",
            "heading_tag": "h4",
            "position": "top_left",
            "highlight_effect": "marker",
            "highlight_accent_color": "#dbe1a9",
            "highlight_text_color": "#030101"
          }
        }
