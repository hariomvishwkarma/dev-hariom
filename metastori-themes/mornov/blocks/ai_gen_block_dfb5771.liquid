{% doc %}
  @prompt
    Add a custom CSS block that removes all gaps between product cards in the collection grid. Set gap, column-gap, padding, and margin to 0 on the product grid container and all product card elements so images touch each other and the screen edges.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-custom-css-{{ ai_gen_id }} {
    display: block;
    width: 100%;
  }

  {% if block.settings.enable_custom_css %}
    .product-grid,
    .product-grid-container,
    .collection-grid,
    .grid,
    [class*="product-grid"],
    [class*="collection-grid"] {
      gap: 0 !important;
      column-gap: 0 !important;
      row-gap: 0 !important;
      grid-gap: 0 !important;
      grid-column-gap: 0 !important;
      grid-row-gap: 0 !important;
      padding: 0 !important;
      margin: 0 !important;
    }

    .product-card,
    .card,
    .product-item,
    [class*="product-card"],
    [class*="card-wrapper"],
    .card-wrapper {
      gap: 0 !important;
      padding: 0 !important;
      margin: 0 !important;
    }

    .product-card__inner,
    .card__inner,
    .card__content,
    .product-card__content {
      padding: 0 !important;
      margin: 0 !important;
    }

    .product-card__media,
    .card__media,
    .media {
      margin: 0 !important;
      padding: 0 !important;
    }

    .product-card img,
    .card img,
    .product-item img {
      display: block;
      margin: 0 !important;
      padding: 0 !important;
    }

    {% if block.settings.remove_page_padding %}
      .page-width,
      .container,
      [class*="page-width"],
      main {
        padding-left: 0 !important;
        padding-right: 0 !important;
      }
    {% endif %}

    {% if block.settings.remove_section_padding %}
      section,
      .section,
      [class*="section"] {
        padding: 0 !important;
        margin: 0 !important;
      }
    {% endif %}
  {% endif %}
{% endstyle %}

<div class="ai-custom-css-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  {% if block.settings.show_message %}
    <div style="
      padding: 12px 16px;
      background-color: {{ block.settings.message_bg_color }};
      color: {{ block.settings.message_text_color }};
      text-align: center;
      font-size: 12px;
      border-radius: {{ block.settings.message_border_radius }}px;
      margin: 8px;
    ">
      {{ block.settings.message_text }}
    </div>
  {% endif %}
</div>

{% schema %}
{
  "name": "Custom CSS - No gaps",
  "tag": null,
  "settings": [
    {
      "type": "header",
      "content": "Grid spacing"
    },
    {
      "type": "checkbox",
      "id": "enable_custom_css",
      "label": "Enable custom CSS",
      "default": true,
      "info": "Removes all gaps between product cards"
    },
    {
      "type": "checkbox",
      "id": "remove_page_padding",
      "label": "Remove page padding",
      "default": true,
      "info": "Images will touch screen edges"
    },
    {
      "type": "checkbox",
      "id": "remove_section_padding",
      "label": "Remove section padding",
      "default": true,
      "info": "Removes padding from sections"
    },
    {
      "type": "header",
      "content": "Optional message"
    },
    {
      "type": "checkbox",
      "id": "show_message",
      "label": "Show message",
      "default": false,
      "info": "Display a custom message"
    },
    {
      "type": "text",
      "id": "message_text",
      "label": "Message text",
      "default": "Custom CSS active: No gaps between products"
    },
    {
      "type": "color",
      "id": "message_bg_color",
      "label": "Message background",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "message_text_color",
      "label": "Message text color",
      "default": "#ffffff"
    },
    {
      "type": "range",
      "id": "message_border_radius",
      "label": "Message border radius",
      "min": 0,
      "max": 20,
      "step": 2,
      "unit": "px",
      "default": 0
    }
  ],
  "presets": [
    {
      "name": "Custom CSS - No gaps"
    }
  ]
}
{% endschema %}
