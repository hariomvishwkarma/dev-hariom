#theme--custom #sidebar-menu {
  width: 100%;
  width: 100vw;
  max-width: 700px;
  height: 100vh;
  overflow: hidden;
  display: grid;
  grid-template-rows: auto 1fr;
  
  &::before {
    content: none;
  }
  
  // Header
  .Drawer__Header {
    max-height: unset;
    height: unset;
    padding-top: 72px;
    padding-bottom: 10px;
    position: static;
    right: 0;
    transform: none !important;

    padding-top: 33px;
    padding-right: 20px;

    .Drawer__Close {
      top: 26px;
      right: 20px;
      left: auto;
    }

    .Search {
      visibility: visible;
      opacity: 1;
      pointer-events: all;
      position: static;
      border: none;
      transform: none;
      
      .Search__Inner {
        padding: 0 20px;
      }

      .Search__SearchBar {
        height: 38px;
        background: #FFFFFF;
        border: 1px solid rgba(170, 148, 139, 0.4);
        padding: 0 20px;
        
        .Search__InputIconWrapper {
          margin-right: 20px;
          color: var(--text-color-light);
        }
        
        input {
          text-transform: none;
          font-size: 14px;
          letter-spacing: normal;
          @include placeholderColour(#BDBDBD);
        }
      }

      &:before {
        content: none;
      }
    }
  }

  // Collection
  .Drawer__Collections {
    padding-top: 23px;
      width: 100%;
    ul {
      list-style: none;
