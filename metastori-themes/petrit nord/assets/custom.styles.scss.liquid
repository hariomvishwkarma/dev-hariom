        .button {
          font-weight: 500;
          font-size: 0.667em;
          line-height: 1;
          
          color: #69554D;
          display: block;
          background: #fff;
          padding: 0.65em 1em 0.6em 1em;
          width: 100%;
          max-width: 11.578em;
        }
      }
      
      &:before {
        content: "";
        display: block;
        padding-bottom: 70.23%;
      }
