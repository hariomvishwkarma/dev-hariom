            margin-left: 0.35em;
            content: "";
            display: inline-block;
            width: 0;
            height: 0;
            border-style: solid;
            border-width: 0.35em 0 0.35em 0.65em;
            border-color: transparent transparent transparent #00000052;
          }
        }
      }

      &:before {
        content: "";
        position: absolute;
        height: 1px;
        width: 100%;
        top: 2.5rem;
        left: 0;
        border-top: 2px dashed var(--section-content-accent, var(--colour-accent));
      }

      &.one {
        text-align: center;

        .heading--wrapper {
          h2 {
            font-weight: 600;
            letter-spacing: -0.02em;
            font-size: clamp(1rem, 10vw, 55px);
            margin-bottom: 0.35em;
            line-height: 1.2;
          }
        }

        .text--wrapper {
          max-width: 75%;
          margin: auto;
        }
      }
    }

    .image--wrapper {
      background: var(--section-content-background2);

      img {
        //max-height: 385px;
        width: 100%;
        position: relative;
      }
    }

    @media only screen and (max-width: $break--tiny) {
      .section--content {
        max-width: 600px;
      }

      .content--group {
        padding: 3rem;
        max-width: calc(100% - 6rem);

        //margin-top: -30%;
        .heading--wrapper {
          h2 {
            font-size: clamp(1rem, 6vw, 40px);
            margin-bottom: 0.35em;

            p {
              margin: 0;
            }
          }
        }

        .text--wrapper {
          p {
            font-size: 1.85rem;
          }
        }

        &:before {
          top: 1.5rem;
        }

        &.one {
          .heading--wrapper {
            h2 {
              font-size: clamp(1rem, 9vw, 55px);
              margin-bottom: 0.35em;
              line-height: 1;
            }
          }

          .text--wrapper {
            max-width: 90%;
            margin: auto;
          }
        }
      }
    }
  }

  .section--inner>.svg--wrapper {
    position: relative;
    overflow: visible !important;

    &:before {
      content: "";
      background: var(--section-content-background);
      position: absolute;
      top: 0;
      left: 0;
      width: 100%;
      height: 4px;
      z-index: 9;
      transform: translateY(-2px);
    }

    &:empty {
      display: none !important;

      &:before {
        content: none;
      }
    }
  }
}

