/* -------------------------------------------------------------------------------------------------------------------------------------------[Variables]---*/

// Breakpoints -->
$break--nano: 340px;
$break--tiny: 480px;
$break--small: 720px;
$break--medium: 1008px;
$break--large: 1240px;

// Colours -->
$colour--primary: var(--colour-primary);
$colour--primary-alt: var(--colour-primary-alt);
$colour--primary-30: var(--colour-primary-30);
$colour--primary-15: var(--colour-primary-15);
$colour--secondary: var(--colour-secondary);
$colour--tertiary: var(--colour-tertiary);
$colour--tertiary-alt: var(--colour-tertiary-alt);
$colour--tertiary-30: var(--colour-tertiary-30);
$colour--tertiary-15: var(--colour-tertiary-15);
$colour--accent: var(--colour-accent);
$colour--border: var(--colour-border);
$colour--background: var(--colour-background);
$header--accent: var(--colour-accent);

// Button
$button--background: var(--button-background-colour);
$button--background-hover: var(--button-bg-hover);
$button--text: var(--button-text);
$button--text-hover: var(--button-text-hover);
// Container -->
$container--width: 1300px;
$container--padding: 3rem;
$container--padding-small: 1.5rem;
$default-spacing-desktop: 43px;
$default-spacing-mobile: 20px;
// Fonts -->
$font--primary: var(--font-type-primary);
$font--secondary: var(--font-type-secondary);
// Base Size -->
$size--desktop: var(--font-size-large);
$size--mobile: var(--font-size-medium);
$size--small: var(--font-size-small);
$header--height: 104px;

/*__________________________________________________________________________________________________________________________________________________________*/
/* --------------------------------------------------------------------------------------------------------------------------------------------[Defaults]---*/
:root {
  font-size: 62.5%;
  font-size: calc(#{$size--desktop} * 62.5% / 16);

  @media screen and (max-width: $break--tiny) {
    //font-size: calc(#{$size--desktop} * 62.5% / 17);
  }

  @media screen and (max-width: $break--nano) {
    font-size: calc(#{$size--desktop} * 62.5% / 17);
  }
}

/* Functions */
@function calculateRem($size) {
  $remSize: $size / 16px;
  @return #{$remSize}rem;
}

@function vw($rem-vw, $base-px, $base-vw: 1292px) {
  $temp: $base-px * 0.625 * $rem-vw * 1px;
  @return calc(($temp * 100vw) / $base-vw);
}

/* Mixins */
@mixin fontSize($size, $line_height) {
  font-size: $size; //Fallback in px
  font-size: calculateRem($size);
  line-height: $line_height;
}

@mixin placeholderColour($colour) {
  &::-webkit-input-placeholder {
    color: $colour;
    opacity: 1;
  }

  &:-ms-input-placeholder {
    color: $colour;
    opacity: 1;
  }

  &::placeholder {
    color: $colour;
    opacity: 1;
  }
}

@mixin style--selection() {
  -webkit-touch-callout: none;
  -webkit-user-select: none;
  -khtml-user-select: none;
  -moz-user-select: none;
  -ms-user-select: none;
  user-select: none;
}

@mixin style--button($type,
  $button_bg,
  $button_tx,
  $button_bg_hover,
  $button_tx_hover) {
  -webkit-touch-callout: none;
  -webkit-user-select: none;
  -khtml-user-select: none;
  -moz-user-select: none;
  -ms-user-select: none;
  user-select: none;
  font-size: 1.4rem;
  line-height: 1;
  -webkit-appearance: none;
  -moz-appearance: none;
  appearance: none;
  cursor: pointer;
  transition: all 0.5s ease;
  width: auto;
  display: inline-block;
  font-style: normal;
  font-weight: 500;
  white-space: normal;
  text-decoration: none;
  text-align: center;
  vertical-align: middle;

  @if $type =="button" {
    border: 1px solid transparent;
    border-radius: 2px;
    padding: 1.53em 4em;
    font-family: $font--secondary, sans-serif;
    text-transform: uppercase;

    span {
      display: block;
      line-height: 1;
      color: inherit;
    }

    background-color: $button_bg;
    color: $button_tx;

    &.height--auto {
      padding: 0 2em;
    }

    &:hover {
      background-color: $button_bg_hover;
      color: $button_tx_hover;
    }

    @media screen and (max-width: $break--small) {
      padding: 1em 4em;
    }
  }

  @if $type =="reset" {
    background: none;
    border: none;
  }

  &:focus,
  &:active {
    outline: none;
  }
}

@mixin style--shadow($depth) {
  @if $depth==1 {
    -webkit-box-shadow: 0 2px 2px 0 rgba(0, 0, 0, 0.14),
      0 3px 1px -2px rgba(0, 0, 0, 0.12), 0 1px 5px 0 rgba(0, 0, 0, 0.2);
    box-shadow: 0 2px 2px 0 rgba(0, 0, 0, 0.14),
      0 3px 1px -2px rgba(0, 0, 0, 0.12), 0 1px 5px 0 rgba(0, 0, 0, 0.2);
  }

  @if $depth==2 {
    -webkit-box-shadow: 0 4px 5px 0 rgba(0, 0, 0, 0.14),
      0 1px 10px 0 rgba(0, 0, 0, 0.12), 0 2px 4px -1px rgba(0, 0, 0, 0.3);
    box-shadow: 0 4px 5px 0 rgba(0, 0, 0, 0.14),
      0 1px 10px 0 rgba(0, 0, 0, 0.12), 0 2px 4px -1px rgba(0, 0, 0, 0.3);
  }

  @if $depth==3 {
    -webkit-box-shadow: 0 8px 17px 2px rgba(0, 0, 0, 0.14),
      0 3px 14px 2px rgba(0, 0, 0, 0.12), 0 5px 5px -3px rgba(0, 0, 0, 0.2);
    box-shadow: 0 8px 17px 2px rgba(0, 0, 0, 0.14),
      0 3px 14px 2px rgba(0, 0, 0, 0.12), 0 5px 5px -3px rgba(0, 0, 0, 0.2);
  }
}

@mixin grid--flex($padding) {
  overflow: hidden;

  >.grid--wrapper {
    display: flex;
    flex-wrap: wrap;
    margin: -$padding;

    >.grid--item {
      flex: 1;
      padding: $padding;
    }
  }

  @media screen and (max-width: $break--large) {}

  @media screen and (max-width: $break--small) {}

  @media screen and (max-width: $break--small) {
    >.grid--wrapper {
      >.grid--item {
        flex: 100%;
      }
    }
  }

  @media screen and (max-width: $break--tiny) {
    >.grid--wrapper {
      margin: -0.5rem;

      >.grid--item {
        padding: 0.5rem;
      }
    }
  }
}

@mixin container($max-width, $padding) {
  width: unset;
  margin: auto;
  max-width: calc(#{$max-width} + 2 * #{$padding});
  padding: 0 $padding;

  @media screen and (max-width: $break--large) {}

  @media screen and (max-width: $break--small) {}

  @media screen and (max-width: $break--tiny) {
    padding: 0 $default-spacing-mobile;
  }
}

@keyframes fillHeight {
    0% {
        height: auto;
    }
    100% {
        height: 100%;
    }
}

#theme--custom {

  // Grid layout -->
  .grid--outer {
    @include grid--flex(1.5rem);
  }

  // Container layout -->
  .container,
  .container--default {
    @include container($container--width, $container--padding);
  }

  .container--custom_page {
    @include container(800px, $container--padding);
  }

  .container--wide {
    @include container(1340px, $container--padding);
  }

  .container--full_width {
    @include container(100%, $container--padding);
  }

  .container--slider {
    @include container(1495px, $container--padding);
  }

  .container--product {
    @include container($container--width, $container--padding);
  }

  .shopify-policy__container {
    @include container(1200px, $container--padding);
  }

  .loox-reviews-default {
    @include container($container--width, 2.4rem);
  }

  .container--custom {
    @include container(1200px, $container--padding);
  }

  // Disable selection -->
  .selection--none {
    @include style--selection();
  }

  // Button [default] -->
  .button--default {
    @include style--button("button",
      $button--background,
      $button--text,
      $button--background-hover,
      $button--text-hover );
  }

  .button--reset {
    @include style--button("reset",
      $button--background,
      $button--text,
      $button--background-hover,
      $button--text-hover );
  }

  // Text align -->
  .text--left {
    text-align: left !important;
  }

  .text--right {
    text-align: right !important;
  }

  .text--center {
    text-align: center !important;
  }
}

