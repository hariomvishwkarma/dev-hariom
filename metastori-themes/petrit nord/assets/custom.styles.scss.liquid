    @media only screen and (max-width: $break--small) {
      padding: calc(var(--section-padding) / 2) 0;
      margin-bottom: calc(var(--section-margin) / 2);

      .container--custom_page {
        padding: 0px 54px;
      }

      .section--inner {
        padding: calc(var(--content-padding) / 2);
