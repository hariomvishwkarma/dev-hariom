#theme--custom .CollectionInner__Products {
  .timer--wrapper, .featured_review--wrapper {
    margin: 0;

    > section {
      margin: 0;
    }
  }
  
  @media screen and (max-width: 720px) {
    .timer--wrapper {
      margin-bottom: 2.5rem;
    }
    .featured_review--wrapper {
      margin-bottom: 2.5rem;
      grid-row: 11!important;
    }
    
  }
}

// HEADER
#theme--custom .PageHeader {
  &.PageHeader--image {
    .SectionHeader__Image {
      .image--wrapper {
        position: relative;
      }
  
      img {
        width: 100%;
      }
  
      span {
        color: #d99940;
        position: absolute;
        width: 100%;
        z-index: 2;
        display: flex;
        justify-content: center;
        align-items: center;
        top: 60%;
        left: 0;
        font-weight: 600;
        font-size: 3.105vw;
        text-shadow: 0 0 5px #000000a6;
  
        @media screen and (min-width: $break--large) {
          font-size: 4.4rem;
        }
  
        @media screen and (max-width: $break--small) {
          font-size: 5.347vw;
        }
      }
  
      #collection-image {
        position: relative;
  
        img {
          position: absolute;
          top: 0;
          width: 100%;
          height: 100%;
          left: 0;
          object-fit: cover;
        }
  
        &:before {
          content: "";
          display: block;
          padding-bottom: 100%;
