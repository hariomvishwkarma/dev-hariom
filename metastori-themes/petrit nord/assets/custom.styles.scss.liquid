    }
  }

  footer {
    padding: 0 !important;
  }

  .section--wrapper {
    background-color: var(--section-background, transparent);
    padding: var(--section-padding, 0rem) 0;
    margin-bottom: var(--section-margin, 0rem);

    .section--content {
      background-color: var(--section-content-background, transparent);
      padding: var(--section-content-padding, 0rem);
      color: var(--section-content-colour, $colour--primary);
    }

