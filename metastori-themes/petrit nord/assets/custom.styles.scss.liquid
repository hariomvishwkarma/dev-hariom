// MODULES [Popup template]
#theme--custom .modal--container {
  &.module--popup {
    .modal--wrapper {
      width: 100%;
    }

    .modal--inner {
      padding: 36px;
      max-height: 90vh;
      max-width: 1200px;
      min-width: 200px;
      max-width: 460px;
      width: 100%;
      min-height: 200px;
      overflow: auto;
      position: relative;
      background: #f5f5f5;
      text-align: center;
      margin: auto;

      @media screen and (max-width: 640px) {
        padding: 36px 15px !important;
        max-width: 95% !important;
      }
    }

    h5 {
      font-size: 1.6rem;
    }

    .countries-list {
      max-width: 300px;
      margin-left: auto;
      margin-right: auto;
      margin-bottom: 30px;

      .countries-list__item {
        display: -webkit-flex;
        display: -ms-flexbox;
        display: flex;
        width: 100%;
        -ms-flex-align: center;
        -webkit-align-items: center;
        -moz-align-items: center;
        -ms-align-items: center;
        -o-align-items: center;
        align-items: center;
        -webkit-justify-content: center;
        -ms-justify-content: center;
        justify-content: center;
        transition: 250ms all ease-in-out;
        padding: 15px 20px;

        .countries-list__flag {
          width: 28px;
          height: 28px;
          border-radius: 0;
          overflow: hidden;
          flex-shrink: 0;
          position: relative;

          .image--wrapper {
            height: 100%;

            img {
              height: 100%;
              object-fit: cover;
            }
          }
        }

        .countries-list__cta {
          flex: 2;
          text-align: left;
          padding-left: 10px;
          margin-bottom: 0;
          white-space: nowrap;
        }

        &:not(:last-child) {
          border-bottom: $colour--border solid 1px;
        }
      }
    }

    .popup-content {
      text-align: left;
    }

    .modal--inner {
      padding: 36px;
      min-width: 300px;
      max-width: 600px;
      min-height: unset;

      ul {
        li {
          list-style: disc;
        }
      }

      .shop-switch.shop-switch__stores {
        width: 100%;
      }
    }
  }

  .Link--underline {
    margin-top: 1rem;
  }

  .modal-close {
    position: absolute;
    padding: 8px;
    color: #4a4a4a;
    top: 11px;
    right: 19px;
    width: 40px;
    height: 40px;

    @media screen and (max-width: 640px) {
      top: 0px;
      right: 0;
    }
  }

  &.modal--fixed {
    display: none;
    bottom: 0;
    left: 0;
    opacity: 1;
    overflow: hidden;
    position: fixed;
    right: 0;
    top: 0;
    z-index: 25;
    -webkit-box-align: center;
    -ms-flex-align: center;
    align-items: center;
    -webkit-box-pack: center;
    -ms-flex-pack: center;
    justify-content: center;

    &.is-active {
      display: -webkit-box !important;
      display: -ms-flexbox !important;
      display: flex !important;
      overflow: hidden;
    }

    &:before {
      content: "";
      position: fixed;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      background-color: rgba(54, 54, 54, 0.5);
      -webkit-animation: overlay-on 0.5s forwards;
      animation: overlay-on 0.5s forwards;
      cursor: pointer;
    }
  }
}

