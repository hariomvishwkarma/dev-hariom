[data-section="slideshow"] {
  img {
    object-fit: cover;
    transition: opacity 500ms ease-in-out;
    transform: none !important;
    opacity: 1 !important;
  }

  .SectionHeader, .SectionHeader__ButtonWrapper {
    visibility: visible !important;
    opacity: 1 !important;
    transform: none !important;
  }
}

#theme--custom .url--overlay {
  background: none !important;
  position: absolute; 
  top: 0; 
  left: 0; 
  width: 100%; 
  height: 100%;
}

// HIDE CHAT AND CART BUTTON
#theme--custom[data-template^="page.hp_"],
#theme--custom[data-template^="cart"],
#theme--custom[data-template="collection"],
#theme--custom[data-template^="page.custom_page_"],
#theme--custom[data-template^="page.custom_pages_2_"] {

  .chat.widget, [title="chat widget"], .widget-visible,
  #shopify-section-custom--popups {
    display: none !important;
    opacity: 0 !important;
    pointer-events: none !important;
  }
}

// FOOTER LOCATOR
.shop-locator--wrapper {
  a {
    pointer-events: none;
  }
  
  .shop-locator {
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    color: inherit;
    
    .label {
      letter-spacing: .15em;
      margin: 0 5px;
    }
  }
}

// SEARCH MOBILE VIEW
#theme--custom .snize-ac-results:not(.snize-ac-results-mobile) {
  @media only screen and (max-width: 1139px) {
    left: 20px!important;
    right: 20px !important;
    width: calc(100% - 40px) !important;
    width: var(--mobile_search, calc(100% - 40px)) !important;    

    right: unset !important;

    max-width: 100%!important;
    border: 1px solid rgba(170,148,139,.4);
    margin-top: 8px;
    
    .snize-ac-results-content {
      background: #fff;
    }
    
    .snize-label {
      border-color:  rgba(170,148,139, 0.4);
    }
    
    ul li.snize-ac-over-nodrop:not(.snize-view-all-link) {
      background-color: transparent;
    }
  }
}

#theme--custom {
  @media only screen and (min-width: 1139px) {
    .snize-ac-results:not(.snize-ac-results-mobile) {
      top: calc(var(--header-height) + var(--announcement-bar-height) - 8px ) !important;
      width: 100% !important;
      border-bottom: 1px solid rgba(0, 0, 0, 0.2);
      border-top: 1px solid rgba(0, 0, 0, 0.2);
      box-shadow: none;
      left: 0 !important;
      max-width: 100%;
  
      .snize-label {
        border-color:  rgba(170,148,139, 0.4);
      }
      
      .snize-ac-results-content {
        width: 100% !important;
        box-shadow: none;
        max-width: 100%;
        padding-left: 43px;
        padding-right: 43px;
        padding: 60px 43px;

        .snize-ac-results-multicolumn-list {
          max-width: 100%;
        }
      }
    }

    &.scroll--active .snize-ac-results:not(.snize-ac-results-mobile) {
      top: calc(var(--header-height) - 8px ) !important;
      position: fixed !important;
    }
  }
}

.snize-instant-widget-is-open:not(.scroll--active) #section-header .Header__Wrapper {
  background: var(--header-background);
  color: var(--header-heading-color);

  .Header__LogoImage--transparent {
    display: none !important; 
  }

  .Header__LogoImage--primary:not(.hide) {
    display: block !important; 
    opacity: 1;
  }
}



@media (hover: none) and (pointer: coarse) {
  #theme--custom.snize-instant-widget-is-open #sidebar-menu {
    visibility: hidden !important;
  }
}

#shopify-section-collection-template {
  overflow: hidden;
}

.shopify-section--footer #section-footer .footer-block[data-type=newsletter] {
  max-width: 100%;
  overflow: hidden;
}


nav.Header__SecondaryNav ul {
  display: flex;
  align-items: center;
}

#SearchDesktop {
  transform: none;
  background: none;
  
  .Search__Inner {
    padding: 0;
  }
  
  .Search__SearchBar {
    height: 38px;
    width: clamp(100px, 20vw, 258px);
    background: #FFFFFF;
    border: 1px solid rgba(170, 148, 139, 0.4);
    padding: 0 20px;
    
    @media screen and (min-width: 1140px) {
      width: clamp(100px, 18.37vw, 258px);
    }
    
    
    @media screen and (min-width: 1400px) {
      width: clamp(100px, 20vw, 258px);
    }
      
    .Search__InputIconWrapper {
      margin-right: 20px;
      color: var(--text-color-light);
      
      .Icon--search-desktop {
        width: 18px;
        height: auto;
      }
      
      svg {
        color: #BDBDBD;
      }
    }
    
    input {
      text-transform: none;
      font-size: 14px;
      letter-spacing: normal;
      @include placeholderColour(#BDBDBD);
    }
  }
}

.Header--transparent #SearchDesktop .Search__SearchBar {
  background: none;
  border-color: currentColor;
}

.Header--transparent:hover,
.snize-instant-widget-is-open:not(.scroll--active) #section-header .Header__Wrapper {
  #SearchDesktop .Search__SearchBar {
    background: #FFFFFF;
    border: 1px solid rgba(170, 148, 139, 0.4);
  }
}

#theme--custom[data-template^="page.custom_pages_1_"] .newsletter--wrapper,
#theme--custom[data-template^="page.custom_pages_2_"] .newsletter--wrapper,
#theme--custom[data-template^="page.custom_pages_3_"] .newsletter--wrapper {
    display: none!important;
}

#theme--custom .ProductForm__Label[data-title="Size"],
#theme--custom .ProductForm__Label[data-title="Størrelse"] {
  display: flex;
  justify-content: space-between;
}

.text--underline span {
  background: linear-gradient(to bottom,transparent 62%,#DFA35F 48%);
  display: inline;
  text-decoration: none !important;
  line-height: 1;
}

#section-header {
  .DropdownMenu, .MegaMenu {
    pointer-events: none;
  }
  
  .DropdownMenu[aria-hidden=false], .MegaMenu[aria-hidden=false] {
    pointer-events: all;
  }
}

.timer--wrapper {
  strong {
    font-weight: bold !important;
    background: linear-gradient(to bottom,transparent 62%,#DFA35F 48%)!important;
    display: inline;
    text-decoration: none !important;
    line-height: 1!important;
    font-size: 16px;
    span {
      font-size: 14px;
    }
  }

  @media screen and (max-width: 720px) {
    > section {
      padding: 3.5rem 0 !important;
    }
  }
}

#theme--custom .Product__Upsell .upsell-item button {
  padding: 5px 3px;
  letter-spacing: -0.04em;
  border-width: 1px;
  line-height: 1.35;
  min-height: 26px;
}

#theme--custom div.snize div.snize-pagination a.snize-pagination-load-more {
  background: var(--colour-tertiary);
  border-color: var(--colour-tertiary);
  color: #fff;
}

#theme--custom {
  .pn-collection-faceted {
    position: relative;

    &.is-loading {
      pointer-events: none;

      &:after {
        content: "";
        position: absolute;
        top: 0;
        right: 0;
        bottom: 0;
        left: 0;
        background: rgba(239, 237, 227, 0.45);
        z-index: 4;
      }
    }
  }

  .product-grid {
    .timer--wrapper,
    .featured_review--wrapper {
      grid-column-start: 1;
      grid-column-end: -1;
      width: 100%;
      list-style: none;
    }
  }
}

@media screen and (max-width: $break--small) {
  #theme--custom [data-section-type="collection"] .product-grid {
    grid-template-columns: 1fr;
  }
}