    .colour--accent {
      color: var(--section-content-accent, $colour--accent) !important;
    }

    .button--custom {
      background: var(--section-button-background);
      color: var(--section-button-text);
      border: none;

      &:hover {
        opacity: 0.9;
      }
    }

    h1,
    h2,
    h3,
    h4,
    h5,
    .h0,
    .h1,
    .h2,
    .h3,
    .h4,
    .h5 {
      color: inherit;
    }

    ul {
      list-style: none;
      padding: 0;
      margin: 0;
    }

    p {
      color: inherit;
    }

