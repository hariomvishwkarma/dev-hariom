        grid-gap: 30px 10px;
        padding-left: clamp(10px, 2.214vw ,45px);
      }
      
      @media screen and (min-width: 1400px) {
        grid-gap: clamp(30px, 4.5%, 100px);
        padding-left: 45px;
      }

