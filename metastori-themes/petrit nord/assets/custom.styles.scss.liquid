  &.design--old {
    .grid--wrapper {
      flex-direction: column;
      max-width: 50%;
      max-width: 600px;
      margin: auto;

      > div {
        width: 100%;
      }
    }

    .SectionHeader__Description {
      text-align: center;
    }
  }
  
  &.design--bottom {
    .grid--wrapper {
      flex-direction: column;
      max-width: 50%;
      max-width: 600px;
      margin: auto;

      > div {
        width: 100%;
      }
    }
  }
