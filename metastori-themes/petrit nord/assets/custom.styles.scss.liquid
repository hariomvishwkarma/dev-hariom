    }

    .u-h2 {
      font-size: 48px;
      font-weight: 400;
    }

    .u-h3 {
      font-size: 32px;
    }

    .u-h4 {
      font-size: 16px;
      line-height: 1.75;
    }

    .u-h6 {
      font-size: 10px;
      line-height: 1.125;
    }

    @media only screen and (max-width: $break--small) {
      .u-h1 {
        font-size: 36px;
      }

      .u-h2 {
        font-size: 33px;
      }

      .u-h3 {
        font-size: 27px;
      }

      .u-h4 {
        font-size: 14px;
        line-height: 1.75;
      }

      .u-h6 {
        font-size: 1rem;
        line-height: 1.125;
      }
