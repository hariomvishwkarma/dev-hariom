      &:after {
        content: none;
      }
    }
    
    .Drawer__Container .SidebarMenu__Nav {
      
      .Collapsible__Inner {
        .Collapsible__Content {
          padding: 5px 0 10px 0;
        }
        
        .Collapsible  {

          & + .Collapsible {
            margin-top: 15px;
          }
        }
      }
      
      .Link {
        margin-bottom: 0px !important;
      }
      
      > .Collapsible:first-child>.Collapsible__Button {
        padding-top: 12px;
      }
    }
    
    .SidebarMenu__Nav--primary {
      > .Collapsible > .Collapsible__Button  {
        padding: 12px 0;
