      .Collapsible__Inner .Collapsible__Content {
        .Collapsible__Button  {
          font-size: 14px;
          line-height: 1.2;
          letter-spacing: normal;
        }
      }
    }
  }
  
  .Drawer__Content {
    height: 100%;
    overflow: auto;
    .SidebarMenu__Nav {
      >.Collapsible {
        margin: 0;

        &[data-state="extended-1"] {
          .Linklist__Item:not(:last-child) {
            margin-bottom: 5px;
          }

          .Collapsible__Inner {
            overflow: visible !important;
            height: auto !important;
            visibility: visible !important;

            .Collapsible {
              margin: 0;

              &:not(:last-child) .Collapsible__Button.Link {
                margin-bottom: 10px;
              }
            }
          }

          .Collapsible__Plus {
            display: none !important;
          }

          >.Collapsible__Button {
            padding: 10px 0;
            font-size: 12px;

            .label {
              background: linear-gradient(to bottom,
                  transparent 52%,
                  var(--colour-accent) 52%,
                  var(--colour-accent) 98%,
                  transparent 98%) center center/0 75% no-repeat;
              transition: background-size 0.2s ease;
              display: inline;
              padding: 0;
              background-size: 100% 100%;
            }
          }
        }

        &[data-state="extended-2"] {
          margin-bottom: 10px;

          .Linklist__Item:not(:last-child) {
            margin-bottom: 5px;
          }

          .Collapsible__Inner {
            overflow: visible !important;
            height: auto !important;
            visibility: visible !important;

            .Collapsible {
              margin: 0;

              &:not(:last-child) .Collapsible__Button.Link {
                margin-bottom: 10px;
              }
            }
          }

          .Collapsible__Plus {
            display: none !important;
          }

          >.Collapsible__Button {
            display: none;
          }

          >.Collapsible__Inner>.Collapsible__Content {
            padding: 0;

            >.Collapsible {
              margin: 0;

              >.Collapsible__Button {
                padding: 20px 0;
                font-size: 12px;

                .label {
                  background: linear-gradient(to bottom,
                      transparent 52%,
                      var(--colour-accent) 52%,
                      var(--colour-accent) 98%,
                      transparent 98%) center center/0 75% no-repeat;
                  transition: background-size 0.2s ease;
                  display: inline;
                  padding: 0;
                  background-size: 100% 100%;
                }
              }
            }
          }
        }

        // First button
        &:first-child>.Collapsible__Button {
          padding-top: 10px;
          padding-top: 20px;
        }

        &:not(:last-child) .Collapsible__Button.Link {
          margin-bottom: 5px;
        }
      }
    }

    .Collapsible__Content {
      padding-bottom: 5px;
    }

    .Collapsible__Inner .Collapsible__Button.Link {
      padding: 0;
      margin-bottom: 0;
      text-transform: none;
      font-size: 1.6rem;
      letter-spacing: 0.04em;
    }

    .Linklist--bordered {
      border: none;
      margin: 0;
      padding-left: 0;
    }

    &::before {
      content: none;
    }
  }

  .Collapsible__Button {
    .Collapsible__Icon {
      position: absolute;
      right: 0;
      top: 50%;
      transform: translateY(-50%);
    }

    &[aria-expanded="true"] .Collapsible__Icon svg {
      transform: rotate(180deg);
    }
