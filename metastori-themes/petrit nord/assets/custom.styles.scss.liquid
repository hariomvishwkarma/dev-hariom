// LAYOUT -->
.shopify-section--footer {
  #section-footer {
    background: none;
    padding: 6.4rem 0 0 0;

    >div {
      padding: 0 0 6.4rem 0;
      padding: 0;
      background: var(--footer-background);
    }

    .footer-block {

      // TEXT
      &[data-type="text"] {
        .Footer__Social {
          list-style: none;
          margin: 0;
          padding: 0;
          display: -ms-flexbox;
          display: flex;
          -ms-flex-flow: row wrap;
          flex-flow: row wrap;
          -ms-flex-pack: center;
          justify-content: center;

          .HorizontalList__Item {
            margin: 0;
            padding: 0.7em 1.1em;

            .Icon {
              font-size: 2.2rem;
              fill: currentColor;
            }
          }
        }
      }

      &[data-type="menu"] {
        padding: 6rem 0;

        .Linklist {
          display: flex;
          justify-content: center;
          flex-wrap: wrap;
          margin: 0;

          >li {
            -ms-flex-preferred-size: 33.333%;
            flex-basis: 33.333%;
            max-width: 20em;
            margin: 0;
            padding: 0.5em 1.6em;
            text-align: center;

            >a {
              text-transform: uppercase;
              letter-spacing: 0;
              font-size: 1.5rem;
              font-weight: 400;
              border-bottom: 1px solid currentColor;
              padding-bottom: 0.35em;
              display: inline-block;
              width: auto;
            }

            ul {
              margin: 2.5rem 0 0 0;

              li {
                list-style: none;
                font-size: 1.6rem;
                padding: 0.5em 1.6em;

                a {
                  text-decoration: none;
                  text-transform: none;
                  letter-spacing: 0.15em;
                  //color: #eac2ab;
                  background: linear-gradient(to bottom,
                      transparent 52%,
                      var(--footer-menu-hover) 52%,
                      var(--footer-menu-hover) 98%,
                      transparent 98%) center center/0 75% no-repeat;
                  transition: background-size 0.2s ease;
                  display: inline;
                  padding: 0;

                  &:hover {
                    background-size: 100% 100%;
                  }
                }
              }

              &+li {
                margin-top: 1em;
              }
            }
          }
        }

        @media screen and (max-width: $break--small) {
          .Linklist {
            >li {
              -ms-flex-preferred-size: 100%;
              flex-basis: 100%;
            }
          }
        }
      }

      &[data-type="meta"] {
        padding: 5rem 0;

        .copyright {
          text-align: center;
          font-size: 1.2rem;
          text-transform: uppercase;
          letter-spacing: 0.16em;

          p {
            color: inherit;
          }
        }

        @media screen and (max-width: $break--small) {
          padding: 2rem 0;
        }
      }

      &[data-type="newsletter"] {
        padding: 6.4rem 0;

        .newsletter--wrapper {
          .newsletter--inner {
            margin: auto;

            form>div>div {

              // Heading
              &:nth-child(1) {
                margin: 0;

                p {
                  color: var(--footer-newsletter-accent);
                  font-size: 2.2rem;
                  line-height: 1.3;
                  letter-spacing: 0.2px;
                  text-transform: uppercase;
                  font-weight: bold;
                  margin: 0.5em 0 0;
                  margin-left: auto;
                  margin-right: auto;
                  text-align: center;

                  span,
                  strong,
                  u {
                    color: inherit !important;
                    font-size: inherit !important;
                  }
                }

                ul {
                  margin: auto;
                  max-width: 600px;

                  li {
                    color: var(--footer-newsletter-accent);
                    font-size: 1.6rem;
                    line-height: 1.3;
                    letter-spacing: 0.2px;

                    span,
                    strong,
                    u {
                      color: inherit !important;
                      font-size: inherit !important;
                    }
                  }
                }

                @media screen and (max-width: $break--small) {
                  p {
                    font-size: 1.8rem;
                  }
                }
              }

              // Email
              &:nth-child(2) {
                .fZHgtb.fZHgtb {
                  margin: auto;
                  //max-width: 365px;
                  width: 100%;
                }

                input[type="email"] {
                  border: none !important;
                  border-bottom: 1px solid var(--footer-newsletter-accent) !important;
                  background: #fff !important;
                  width: 100%;
                  //color: var(--footer-newsletter-text) !important;
                  outline: 0;
                  padding: 0px 0px 0px 16px;
                  height: 38px;
                  //@include placeholderColour(var(--footer-newsletter-input));
                }
              }

              // Phone
              &:nth-child(3) {
                .hAUGVa.hAUGVa.hAUGVa.hAUGVa.hAUGVa.hAUGVa {
                  margin: auto;
                  //max-width: 365px;
                  width: 100%;
                }

                .NkKOc.NkKOc.NkKOc.NkKOc.NkKOc.NkKOc {
                  background: none;
                  border: none;
                  height: unset;
                  outline: 0;
                  border: none !important;

                  input {
                    border-bottom: 1px solid var(--footer-newsletter-accent) !important;
                    background: 0 0 !important;
                    color: var(--footer-newsletter-text) !important;
                    padding: 0px 0px 0px 16px;
                    height: 38px;
                    @include placeholderColour(var(--footer-newsletter-input));
                    margin: auto;
                    max-width: 430px;
                  }
                }

                .gfbxZo.gfbxZo,
                .hJaRdk.hJaRdk,
                .kwUXkE.kwUXkE {
                  background: #f7f6f2;
                  border: none;
                }

                .gfbxZo.gfbxZo {
                  border-bottom: 1px solid #eabc85;
                  border-top: 1px solid #eabc85;
                }
              }

              // Text
              &:nth-child(4) {
                span {
                  font-size: 1.6rem !important;
                  font-size: 9px !important;
                  font-style: italic;
                  text-align: left !important;
                  line-height: 1.4;
                  color: var(--footer-newsletter-text) !important;
                }
              }

              &:nth-child(5) {
                div {
                  font-size: 1.6rem;
                  line-height: 1.4;
                  color: var(--footer-newsletter-text);
                }
              }

              // Button
              &:nth-child(6) {
                button {
                  color: var(--footer-newsletter-input-text);
                  background: var(--footer-newsletter-input-bg);
                  font-size: 1.6rem;
                  font-weight: 700;
                  letter-spacing: 0px;
                  height: 44px;
                  text-transform: uppercase;
                  font-weight: 400;
                  letter-spacing: 0.2em;
                  font-size: calc(var(--base-text-font-size) - (var(--default-text-font-size) - 12px));
                  //max-width: 238px;
                  margin: auto;
                  border-radius: 0;
                }
              }

              &:nth-child(7) {
                div {
                  background-color: transparent;

                  em {
                    font-size: 1.6rem !important;
                    font-size: 9px !important;
                    line-height: 1.4;
                    color: var(--footer-newsletter-text) !important;
                  }
                }
              }
            }
          }
        }

        @media screen and (max-width: $break--small) {
          padding: 3.2rem 0;
        }
      }

      &[data-type="divider"] {
        .divider--wrapper {
          position: relative;

          .footer-logo {
            display: block;
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            margin: auto;
            transform: translateY(-60%);
            width: 100%;
            object-fit: contain;
          }

          .svg--wrapper {
            display: flex;
            justify-content: center;

            svg {
              max-height: inherit;

              path {
                fill: currentColor !important;
              }
            }
          }
        }

        svg {
          margin-bottom: -1px;
        }

        @media screen and (max-width: $break--small) {
          .footer-logo {
            position: static !important;
            transform: translateY(-45%) !important;
          }
        }
      }
    }
  }
}

