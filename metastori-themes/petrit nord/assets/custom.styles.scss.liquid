        li {
          min-width: 100%;
        }
      }
    }
  }

  // Boxes
  [data-section="boxes"] {
    .grid--outer {
      overflow: visible;
    }

    .grid--wrapper {
      margin: 0;
      display: grid;
      grid-gap: 10em;
      grid-auto-flow: column;
      grid-auto-columns: 1fr;

      .grid--item {
        padding: 0;
        display: flex;

        &:nth-child(2) {
          margin-top: 20%;
        }

        .content--group {
          display: block;
          width: 100%;
          padding: 0 1.7em 1.7em 0;
        }
      }
    }

    ul {
      li {
        &::marker {
          content: none;
        }

        .image--wrapper {
          position: relative;
          margin: auto;

          img {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            object-fit: cover;
          }

          .image--overlay {
            position: absolute;
            width: 100%;
            height: 100%;
            z-index: 2;
            display: flex;
            justify-content: center;
            align-items: center;
            top: 0;
            left: 0;
            font-size: 6.6em;

            h3 {
              font-size: inherit;
            }
          }

          .image--decoration {
            position: absolute;
            width: 100%;
            height: 100%;
            background: currentColor;
            z-index: -1;
            display: block;
            top: 0;
            left: 0;
            transform: translate(1.7rem, 1.7rem);
          }

          .image--text {
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            text-align: center;
            font-weight: bold;
            text-transform: uppercase;
            line-height: 1;
            display: block;
            transform: translateY(-50%);

            .text {
              font-size: 4.4em;
              display: block;
              text-shadow: 0px 0px 9px #737373;
            }

            &.vertical {
              bottom: 0;
              transform: translateX(-50%);
              right: unset;

              .text {
                width: 1em;
                word-wrap: break-word;
                font-family: monospace;
                line-height: 0.9;
                margin-bottom: 0.2em;
              }
            }
          }

          &:before {
            content: "";
            padding-bottom: 100%;
            display: block;
          }

          &.default-size {
            img {
              position: static;
            }

            &:before {
              content: none;
            }
          }
        }
      }
    }

    @media only screen and (max-width: $break--large) {
      .grid--wrapper {
        grid-template-columns: 1fr 1fr;
        grid-auto-flow: unset;
        grid-gap: 0.5em;
      }

      .grid--wrapper .grid--item {
        .content--group {
          padding: 0 0.05em 0.05em 0;
        }
      }

      ul li .image--wrapper {
        .image--overlay {
          font-size: 0.2em;
        }

        .image--decoration {
          transform: translate(0.05em, 0.05em);
        }

        .image--text .text {
          font-size: 0.13em;
        }
      }
    }

    @media only screen and (max-width: $break--small) {
      .grid--wrapper {
        grid-template-columns: 1fr;

        .grid--item {
          margin: 0 !important;

          .content--group {
            padding: 0 0.1em 0.1em 0;
          }
        }
      }

      ul li .image--wrapper {
        .image--overlay {
          font-size: 0.52em;
        }

        .image--decoration {
          transform: translate(0.1em, 0.1em);
        }

        .image--text .text {
          font-size: 0.4em;
        }
      }
    }
  }

  // Images
  [data-section="images-2"] {
    .section-content {
      overflow: hidden;
    }

    ul {
      li {
        &::marker {
          content: none;
        }

        .image--wrapper {
          position: relative;

          img {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            object-fit: cover;
          }

          &:before {
            content: "";
            padding-bottom: 100%;
            display: block;
          }

          &.default-size {
            img {
              position: static;
            }

            &:before {
              content: none;
            }
          }
        }
      }

      @media only screen and (max-width: $break--large) {
        li {}
      }

      @media only screen and (max-width: $break--tiny) {
        li {}
      }
    }
  }


  // MEASURMENTS TABLE
  // Trigger
  .measurements_trigger {
    font-size: 14px;
    margin-top: 14px;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
  
    >* {
      pointer-events: none;
    }

    > span {
      background: linear-gradient(to bottom,transparent 62%,#d99940 48%);
      line-height: 1.1;
      font-weight: 500;
      padding: 0 2px;
    }
  
    svg {
      width: 2em;
      height: auto;
      fill: currentColor;
      display: inline-block;
      margin-right: 9px;
    }
  }
  
  // Module
  .measurements_popup {
    .label {
      margin-left: 0.25em;
      font-size: 80%;
      text-transform: none;
    }
  }
  
  // Video
  [data-section="size"] {
    .size--wrapper {
      position: relative;

      .module__title {
        font-size: 2.4rem;

        @media screen and (max-width: $break--large) {
          font-size: 2.2rem;
        }
      }

      .fit--wrapper {
        width: 100%;
        margin-bottom: 3.5rem;

        header {
          margin: 20px auto 15px;
        }

        .ruler__labels {
          position: relative;
          margin: 0 auto 0;
          display: grid;
          grid-template-columns: auto auto;
          justify-content: space-between;

          span:nth-child(2) {
            position: absolute;
            left: 0;
            right: 0;
            top: 0;
            text-align: center;
          }
        }

        .module__ruler {
          position: relative;
          display: flex;
          justify-content: space-between;
          width: 100%;
          height: 10px;
          margin: 0.5rem auto 0;
          border: 2px solid var(--size-color);

          .current {
            position: absolute;
            width: 18px;
            height: 18px;
            background: white;
            border: 2px solid var(--size-color);
            border-radius: 10px;
            left: var(--dot);
            transform: translate(-50%, -6px);
            z-index: 4;
          }

          .ruler__meter {
            position: absolute;
            min-width: 100%;
            top: 0;
            left: -2px;
            right: -2px;
            height: 100%;
            background-color: var(--size-background);
            left: var(--left, -2px);
            background-image: linear-gradient(90deg,
                var(--size-accent) var(--position),
                transparent 0);
            z-index: 3;
          }

          .ruler__ticks {
            position: absolute;
            top: calc(100%);
            min-width: 100%;
            display: flex;
            left: -2px;
            right: -2px;
            height: 6px;
            top: 0;
            height: calc(100% + 8px);

            span {
              position: absolute;
              left: 0;
              width: 2px;
              height: 100%;
              background-color: var(--size-color);

              &.tick--1 {
                top: 0;
                z-index: 3;
              }

              &.tick--2 {
                left: 25%;
              }

              &.tick--3 {
                left: 50%;
              }

              &.tick--4 {
                left: 75%;
              }

              &.tick--5 {
                left: unset;
                right: 0;
                top: 0;
                z-index: 3;
              }
            }
          }
        }
      }

      .size_helper--wrapper {
        border: 2px solid var(--size-color);
        padding: 3rem 2rem 2rem 2rem;
        font-size: 1.8rem;

        .recommendation__title {
          font-size: 2.4rem;
        }

        .recommendation--results {
          margin-top: 1rem;
        }

        .controls--wrapper {
          display: flex;
          flex-wrap: wrap;
          margin-top: 1rem;

          .label-main {
            width: 100%;
            margin-bottom: 0.5rem;
            line-height: 1.33;
            font-weight: 600;
          }

          .error {
            display: flex;
            align-items: center;
            margin-top: 1rem;
            font-size: 1.6rem;

            svg {
              margin-right: 0.5rem;
              fill: currentColor;
              height: 1.3em;
              width: 1.3em;
            }
          }

          .input--wrapper {
            display: flex;
            width: 100%;
          }

          .input-main {
            width: 120px;
            height: 45px;
            margin: 0 0 0.5rem 0;
            padding: 0.25rem;
            font-weight: bold;
            background-color: #fff;
            border: 1px solid var(--size-color);
            text-align: center;
            -moz-appearance: textfield;
            -webkit-appearance: none;
          }

          .input-main::-webkit-outer-spin-button,
          .input-main::-webkit-inner-spin-button {
            -webkit-appearance: none;
            margin: 0;
          }

          .input-main[type="number"] {
            -moz-appearance: textfield;
          }

          .switch-main {
            display: grid;
            grid-template-rows: 1fr 1fr;
            margin: 0 2rem 0.5rem 0.5rem;

            label {
              display: flex;
              align-content: stretch;
              font-size: 1.6rem;

              span {
                display: block;
                padding: 0 3px;
                opacity: 0.5;
                font-weight: bold;
                cursor: pointer;
              }

              input:checked+span {
                opacity: 1;
              }
            }

            input {
              display: none;
            }
          }

          button {
            background-color: var(--size-accent);
            font-weight: bold;
            color: #fff;
            box-shadow: 0 0 0 0 rgba(0, 0, 0, 0.5);
            height: 45px;
            flex: 0 1 120px;
            padding: 0 1rem;
            margin-bottom: 0.5rem;
          }
        }
      }
    }


    .section-content>header {
      text-align: left;
      margin: 0;
      //position: relative;
      
      h2 {
        font-size: 24px;
        line-height: 1.3;
        letter-spacing: 1.6px;
        margin: 0;
        color: $colour--primary;
        text-align: center;
        letter-spacing: normal;
        text-transform: uppercase;
        
        small {
          display: block;
