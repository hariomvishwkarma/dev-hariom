    text-align: center;

    .heading {
      font-weight: bold;
      margin: 0;
    }

    p {
      margin: 10px 0 0 0;
    }
  }

  // Icons
  .Drawer__Icons {
    margin: 20px 0;
    //margin-bottom: 80px;
    padding: 0 29px;
    > div {
/*       padding: 10px 0; */
    }
    
    ul {
      display: flex;
      justify-content: center;
      list-style: none;
      padding: 0;
      margin: 0;
      li {
        flex: 0 1 auto !important;
        max-width: 25%;
        > div {
          padding: 0 10px;
          text-align: center;
          max-width: 90px;
          font-size: 12px;
          line-height: 1.2;
          font-weight: 500;
          margin: auto;
          text-transform: uppercase;

          img {
            max-width: 50px;
            margin: auto;
            margin-bottom: 5px;
          }
        }
      }
    }
  }

  .Drawer__FooterEmpty {
    padding: 0 29px 35px 29px;
    a {
      font-weight: 500;
      font-size: 14px;
      text-transform: uppercase;
      padding: 8px 28px;
      background: var(--colour-tertiary);
      border-color: var(--colour-tertiary);
      color: #fff;
      display: block;
      text-align: center;
      min-height: 45px;
      display: flex;
      justify-content: center;
      align-items: center;
    }
  }

  .Drawer__TopEmpty {
    margin-top: 40px;
    //flex: 1;
    display: flex;
    flex-direction: column;
    justify-content: center;
  }

  .Drawer__BottomEmpty {
    flex: 1;
    display: flex;
    flex-direction: column;
    justify-content: center;
  }
  
  // Buttons
  .Drawer__Buttons {
    padding: 0 29px;
    ul {
      li {
        a {
          background: #fff;
          font-weight: 500;
          font-size: 14px;
          padding: 8px 0;
          min-height: 45px;
          text-transform: uppercase;
          border: 1px solid var(--colour-primary);
          //border-color: var(--colour-tertiary);
          display: block;
          text-align: center;
          display: flex;
          justify-content: center;
          align-items: center;
        }
      }
    }
  }
  
  // Reviews
  #sidebar-cart .Drawer__Reviews {
    flex: 1 1 auto;
    flex: 0;
    //margin-top: auto;
    padding: 0 29px 0 29px;

    h3 {
      margin-bottom: 20px;
    }
    
    .reviews {
      border: 1px solid var(--colour-primary);
      //border-color: var(--colour-tertiary);

      .item--inner {
        display: grid;
        grid-template-columns: 1fr 1fr;

        .image--wrapper {
          height: 100%;
          img {
            height: 100%;
            width: 100%;
            object-fit: cover;    
            display: flex;
            flex-wrap: wrap;
            grid-gap: 5px;
          }
        }
        
        .content {
          padding: 20px;
          display: flex;
          flex-direction: column;
          justify-content: center;

          .heading {
            font-weight: 500;
            font-size: 16px;
            margin-bottom: 10px;
            letter-spacing: normal;
            line-height: 1.33;
          }

          .text {
            
            font-weight: 400;
            font-size: 14px;
            margin-bottom: 10px;
            letter-spacing: normal;
            line-height: 1.33;
          }

          .rating {
            
            font-weight: 400;
            font-size: 12px;
            letter-spacing: normal;
            line-height: 1.33;

            display: grid;
            grid-template-columns: auto auto;
            justify-content: space-between;

            display: flex;
            flex-wrap: wrap;
            grid-gap: 5px;
            
            .stars {
              display: flex;
              //background: rgba(105,85,77,.2);
              padding: 4px 3px;
              border-radius: 0px;
              align-self: center;
              .star {
                display: block;
                flex: 20%;
                
                svg {
                  fill: var(--colour-accent);
                  max-width: 20px;
                  width: 100%;
                  display: block;
                }

                & + .star {
                  margin-left: -2px;
                }
              }
            }
            p {
              margin: 0;
            }
          }
        }
      }
    }
  }
  
  /* CART INFORMATION */
  #sidebar-cart {
    .Drawer__Header {
      border: none;
      box-shadow: none;
    }
    
    .Cart__Information {
      padding: 16px 0;
      border-top: 1px solid currentColor;
      border-bottom: 1px solid currentColor;
      
      .shipping-information {
        margin: 0 0 16px 0;
        
        .block-title {
          text-align: center;
          display: block;
          font-weight: 400;
          margin: 0 0 16px 0;
        }
        
        .shipping-data {
          position: relative;
          min-height: 15px;
          background: #00000012;
  
          .svg--wrapper { 
            position: absolute;
            right: 0;
            transform: translate(30%, -10%);
            
            svg {
              height: 120%;
              width: auto;
              display: block;
            }

            &.element--active {
              background: #efede3;
              border: 1px solid currentColor;
              padding: 5px;
              border-radius: 100%;
              transform: translate(30%,-24%);
              
              svg {
                height: 16px;
              }
            }
          }
          
          &:before {
            content: "";
            position: absolute;
            left: 0;
            top: 0;
            height: 100%;
            width: clamp(0%, var(--element_width), 100%);
            background: var(--colour-tertiary);
            transition: width 250ms ease-in-out;
          }
        }
      }
  
      .reservation-information {
        p {
          display: flex;
          justify-content: center;
          align-items: center;
          gap: 5px;
          line-height: 1;
  
          @media only screen and (max-width: $break--tiny) {
            letter-spacing: -0.015em;
            gap: 2px;
          }
        }
      }
    }
  }
  
  // INFO
  .CartItem__Info {

    // TITLE
    .CartItem__Title {
      font-size: 1.2rem;
      line-height: 1.3;
      letter-spacing: 0.2px;
      color: $colour--primary;
      text-transform: uppercase;
      font-weight: bold;
      margin: 0;
    }

    // VARIANT
    .CartItem__Variant {
      text-decoration: none;
      font-size: inherit;
      font-weight: bold;
      color: $colour--primary;
      letter-spacing: 0.1em;
      display: block;
      margin: 1.2em 0 0 0;
      font-size: 0.9rem;
    }

    // PRICE
    .CartItem__PriceList {
      display: block;
      margin-top: 1.2em;
      font-size: 0.9rem;

      span {
        text-decoration: none;
        font-size: inherit;
        font-weight: bold;
        color: $colour--primary;
        letter-spacing: 0.1em;
      }
    }
  }

  // UPSELL
  .Drawer__Upsell {
    padding-left: 26px;
    padding-right: 26px;
    padding-top: 16px;
    padding-bottom: 16px;
    box-shadow: 0 -1px var(--border-color);

    .flickity-viewport {
      overflow: visible;
    }

    // UPSELL ITEM
    .flickity-page-dots {
      display: none !important;
    }

    .flickity-prev-next-button {
      top: 0;
      bottom: 0;
      margin: auto;
      width: 25px;
      height: 25px;

      svg {
        height: 50%;
      }

      &.previous {
        left: 10px;
      }

      &.next {
        right: 10px;
      }
    }

    .carousel-cell {
      width: 100%;
    }

    .cell--inner {
      display: grid;
      grid-template-columns: 1fr 1.8fr;
      grid-template-rows: auto auto;
      gap: 1rem;
      grid-template-areas:
        "image meta"
        "image actions";
      //border: 1px solid #fcfcf9;
      border-radius: 0;
      -webkit-box-shadow: 0 0 4px rgba(0, 0, 0, 0.25);
      box-shadow: 0 0 4px rgba(0, 0, 0, 0.25);
      padding: 20px;
      margin: 4px;

      .upsell-image {
        grid-area: image;

        img {
          max-width: 120px;
          max-height: 120px;
          margin: auto;
          object-fit: contain;
        }
      }

      .upsell-meta {
        grid-area: meta;

        .upsell-title {
          font-size: 1.2rem;
          line-height: 1.3;
          letter-spacing: 0.2px;
          color: $colour--primary;
          text-transform: uppercase;
          font-weight: bold;
          margin: 0;
        }

        .upsell-price {
          display: block;
          margin-top: 1.2em;
          font-size: 0.9rem;

          span {
            text-decoration: none;
            font-size: inherit;
            font-weight: bold;
            color: $colour--primary;
            letter-spacing: 0.1em;
          }
        }
      }

      .upsell-actions {
        grid-area: actions;
        display: flex;

        button {
          padding: 8px;
          margin: 0;
          font-size: 14px;
          background-color: inherit;
          color: $colour--accent;
          width: 100%;
          margin: auto auto 0 auto;
          border: 1.5px solid currentColor;
          border-radius: 0;
          display: block;

          span {
            pointer-events: none;
          }
        }
      }
    }
  }
  
  #sidebar-cart .Drawer__Upsell.slider {
    box-shadow: none;
    max-width: 100%;
    touch-action: pan-y!important;
    
    padding: 0;

    > div {
      overflow: hidden;
      padding-left: 29px;
      padding-right: 29px;
      padding-bottom: 3px;
      @media (max-width: 1000px) {
        padding-left: 27px;
        padding-right: 27px;
      }
    }
    
    h3 {
      text-align: center;
      font-size: 18px;
      font-weight: 400;
      color: #69554d;
      margin-bottom: 8px;

      @media screen and (max-width: $break--tiny) {
        font-size: 16px;
        letter-spacing: -0.03em;
      }
   }
    
    .main-carousel, .swiper {
      padding-right: 30%;
      padding: 0 10% 0 10%;

      .swiper-slide {
        height: auto;
        > div {
          height: 100%;
        }
      }
    }
    
    .flickity-viewport {
      touch-action: pan-y !important;
    }
    
    .carousel-cell{
      width: 92%;
 
      -webkit-animation: fillHeight 3.0s forwards;
      animation: fillHeight 3.0s forwards;
    }
    
    .cell--inner {
      grid-template-columns: 90px 1.8fr;
      grid-template-rows: auto;
      grid-template-areas: "image meta";
      gap: 10px 16px;
      padding: 10px;
      padding: 16px;
      box-shadow: none;
      background: #d1d2be;
      border: 1px solid #745D55;
      height: 100%;
    }
    
    .upsell-title {
      font-size: 14px;
    }
    
    .upsell-price {
      margin-top: 6px;
      span {
        font-size: 7.875px !important;
        font-size: 12px !important;
      }
    }
    
    .upsell-variant {
      font-size: 12px;
      
      .upsell-variant-trigger {
        border-radius: 0px !important;
        background: #faf6ed;
      }

      .select button {
        background: var(--colour-tertiary);
        color: #fff;
      }
    }

    .upsell-actions .upsell__add_to_cart {
      background: var(--colour-tertiary);
      color: #fff;
      border: none;
      min-height: 30px;
      padding-top: 0;
      padding-bottom: 0;
      width: 100%;
    }
    
    .upsell-image {
      position: relative;
      border: none;
      width: 90px;
      min-width: 90px;
      height: auto;
      padding: 0;
      align-self: center;

      &:before {
        content: "";
        display: block;
        padding-bottom: 120%;
      }
      
      img {
        width: 100%;
        height: 100%;
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
      }
    }

    .upsell-meta {
      border-left: 1px solid #745D55;
      padding-left: 16px;
      align-self: stretch;
      display: flex;
      flex-direction: column;
      justify-content: center;
    }
    
    .upsell__add_to_cart {
      width: auto;
      margin-left: 0;
      padding: 5px 15px;
    }
  }

  // REVIEW
  .Drawer__Review {
    
    .review--wrapper {
      position: relative;
      padding: 24px 29px;
      margin: 0 0 0 0;
      text-align: center;
      border-top: 1px solid currentColor;
      border-bottom: none;
  
      &:before {
        content: open-quote;
        font-weight: bolder;
        position: absolute;
        top: 32px;
        font-size: 150px;
        left: 0;
        right: 0;
        bottom: 0;
        opacity: 0.25;
        z-index: -1;
        display: flex;
        justify-content: center;
        align-items: center;
        line-height: 1;
      }
    }
  }

  .Drawer__Footer {
    box-shadow: none;
    border-top: 1px solid #745D55;
    padding: 16px 30px 35px !important;
    
    .Cart__Checkout  {
      margin: 0;
      min-height: 40px;
      padding: 8px 28px;
      border-color: $colour--tertiary;
  
      &:before {
        background: $colour--tertiary;
      }
    }
  }
}

