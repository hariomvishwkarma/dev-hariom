        width: 0;
        height: 0;
        border: 8px solid transparent;
        border-top: 0;
        border-bottom-color: var(--header-background);
        border-right-width: 9px;
        border-left-width: 9px;
        content: "";
        display: block;
        bottom: calc(var(--header-height) - 114px);
        left: 50%;
        position: absolute;
        transform: translate(-50%);
        filter: drop-shadow(0px 0px 1px #7b7b7b);
        bottom: calc(var(--header-height) - 115px);
        filter: drop-shadow(0px -1px 0px var(--colour-primary));
        z-index: 99;

        content: none;
      }

      @media screen and (min-width: 1140px) {
          margin-right: clamp(10px, 1.14vw , 24px);
          margin-left: clamp(10px, 1.14vw , 24px);
      }
      
      
