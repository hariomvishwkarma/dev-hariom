/* ----------------------------------------------------------------------------------------------------------------------------------------[Product page]---*/
// PRODUCT FORM -->
#theme--custom {
  .Product {
    max-width: 100%;
    margin-bottom: 5rem;
  }

  .HorizontalList-color {
    display: flex;
    flex-wrap: wrap;
  }

  .Product__InfoWrapper {
    max-height: 100% !important;

    .Product__Info {
      width: 100% !important;
      max-width: 100% !important;
      margin: 0;
      padding-left: 5rem;
      top: calc(var(--header-height) + 5rem) !important;

      .ProductForm button {
        border-color: $colour--tertiary;
        background: $colour--tertiary;

        border-color: #DFA35F;
        background: #DFA35F;
        color: #69554D;
        letter-spacing: normal;
        font-weight: 500;
        font-size: 13px;
        min-height: 45px;

        span {
          background: none;
        }
        
        &:before {
          content: none;
          background: $colour--tertiary;
        }
      }

      @media screen and (max-width: $break--medium) {
        padding-left: 0;
      }
    }
  }

  // VARIANTS
  .HorizontalList__Item {
    .SizeSwatch {
      color: $colour--primary;
      min-width: 36px;
      min-height: 36px;
      display: flex;
      justify-content: center;
      align-items: center;
      font-weight: bold;
    }

    &.unavailable .SizeSwatch {
      font-weight: 400;
      text-decoration: line-through;
    }
  }

  .SizeSwatchList.HorizontalList {
    margin: -5px;

    .HorizontalList__Item {
      margin: 5px;

      .SizeSwatch {
        width: 100%;
        position: relative;
        height: auto;
        border-width: 1px;
        font-weight: 400;
      }

      input:checked+label {
        background: $colour--accent;
      }

      &.unavailable  {
        opacity: 0.25;
      }
    }
  }

  // UPSELL
  .Product__Upsell {
    margin-top: 20px;
    position: relative;

    .upsell-item--wrapper {
      padding: 1px 0;
    }
    
    .slider--wrapper {
      position: relative;
    }
    
    .upsell-item button {
      background: none !important;
      border-radius: 0;
      text-transform: uppercase;
      display: block;
      text-align: center;
      width: 100%;
      padding: 5px;
      color: var(--button-background);
      border: 2px solid black;
      border-color: var(--button-background) !important;
      letter-spacing: 0;
      font-size: 1rem;
      display: flex;
      //justify-content: space-between;
      align-items: center;
      -webkit-appearance: none;
      -moz-appearance: none;
      display: grid;
      
      .upsell-title {
        position: absolute;
        max-width: 85%;
        line-height: 1;
        text-align: left;
        display: block;
        width: 100%;
        justify-self: flex-start;
      }
      
      span:not(.upsell-title) {
        font-size: 1.2em;
        font-weight: bold;
        justify-self: flex-end;
      }

      &.load {
        background: var(--button-background) !important;
        color: white;
        pointer-events: none;
      }
    }

    .upsell-item .Select {
      text-align: center;
      
      svg {
        right: 7px;
        top: 50%;
        transform: translateY(-50%);
        height: 0.7em;
        width: 0.7em;
      }

      select {
        position: relative;
        background: none;
        border-radius: 0;
        //text-transform: uppercase;
        display: block;
        text-align: center;
        text-align: -webkit-center;

        text-align: -webkit-center;
        text-align: -moz-center;
        text-align-last:center;
        width: 100%;
        padding: 5px 0 5px 5px;
        color: var(--button-background);
        color: #efede3;
        border: 1px solid;
        border-color: var(--button-background);
        letter-spacing: 0;
        font-size: 1rem;
        -webkit-appearance: none;
        -moz-appearance: none;
        
        font-size: 10px;
        font-weight: 800;
        letter-spacing: normal;
        padding: 0.62em 0;
        
        option {
          font-weight: 600;
        }
  
        option:disabled {
          color: #909090;
          font-weight: 400;
          opacity: 0.6;
        }
        
        &:focus {
          & + svg  {
            //transform: translateY(-50%) rotate(180deg);
          }
        }
  
        @media screen and (max-width: $break--large) {
          letter-spacing: 0;
        }
      }

      

      &:after {
        content: "Select Size";
        position: absolute;
        top: 0;
        width: 100%;
        left: 0;
        height: 100%;
        font-size: 10px;
        font-weight: 500;
        letter-spacing: normal;
        display: flex;
        justify-content: center;
        align-items: center;
        pointer-events: none;
      }
    }

    .upsell-item {
      position: relative;
      padding: 0 1px;

      .image--wrapper:after {
        content: attr(data-title);
        position: absolute;
        bottom: 2px;
        left: 2px;
        right: 2px;
        text-align: center;
        font-size: 1.2rem;
        border-top: 1px solid;
        min-height: 3em;
        padding: 0.05em 0.5em;
        display: flex;
        justify-content: center;
        align-items: center;
        pointer-events: none;
        background: var(--background);
        opacity: 0;
        line-height: 1.2;

        bottom: 0px;
        left: 0px;
        right: 0px;
        background: #efede3b5;
        line-height: 1.2;
        height: 100%;
        border: none;
        letter-spacing: normal;
        font-weight: 500;
        font-size: 10px;
      }

      &:hover {
        .image--wrapper:after {
          opacity: 1;
        }
      }
    }

    .upsell-item.active {
      &+.product-options {
        display: block;
      }

      &.left {
        .product-options {
          right: 105%;
          left: unset;

          &:before {
            left: 100%;
            border-width: 15px 0 15px 20px;
            border-color: transparent transparent transparent var(--colour-primary);
          }

          &:after {
            left: 100%;
          }
        }
      }
    }

    .upsell-item.active {
      .product-options {
        display: block;
      }

      &.left {
        .product-options {
          right: 105%;
          left: unset;

          &:before {
            left: 100%;
            border-width: 15px 0 15px 20px;
            border-color: transparent transparent transparent var(--colour-primary);
          }

          &:after {
            left: 100%;
          }
        }
      }

      &.right {}
    }

    .product-options {
      position: absolute;
      bottom: 10px;
      left: 95%;
      background-color: $colour--background;
      display: none;
      align-items: center;
      justify-content: center;
      text-align: center;
      width: 160px;
      z-index: 9;
      padding: 1rem;
      border: 2px solid $colour--primary;
      left: 0 !important;
      top: 0 !important;
      bottom: 0 !important;
      width: 100%;
      min-width: auto;
      padding: 2px;

      .product-sizes {
        .title {
          margin-bottom: 1em;
          color: $colour--primary;
          font-weight: bold;
          text-transform: uppercase;
          font-size: 0.9rem;
          display: block;
        }

        ul {
          display: flex;
          flex-wrap: wrap;
          margin: 0;
          display: grid;
          grid-template-columns: repeat(5, 1fr);
          display: flex;
          flex-wrap: wrap;

          li {
            list-style: none;
            padding: 5px;
            flex: 1;
            //max-width: 25%;
            //max-width: 50%;
            width: 100%;
            min-width: 100%;
            padding: 2px;

            div {}

            &.unavailable {
              span {
                font-weight: 400;
                text-decoration: line-through;
              }
            }
          }

          span {
            background-color: transparent;
            color: $colour--primary;
            font-size: 12px;
            font-size: 1.2rem;
            font-weight: bold;
            letter-spacing: 0.6px;
            text-transform: uppercase;
            margin: 0;
            padding: 5px;
            border: 1px solid $colour--border;
            display: block;
            font-size: 1rem;
            letter-spacing: 0px;
            padding: 2px;

            &.unavailable {
              color: #fff;
              text-decoration: line-through;
            }
          }
        }
      }
    }

    .image--wrapper {
      border: 1px solid black;
      border-width: 0 1px 1px 1px;
      border-color: var(--button-background);
      position: relative;
      width: 100%;
      overflow: hidden;
      
      img {
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        object-fit: cover;
        
        height: 110%;
        object-fit: contain;
        top: -5%;
      }

      &:before {
        content: "";
        display: block;
        padding-bottom: 75%;
      }
    }

    .SizeSwatch {
      position: relative;
      width: 100%;
      height: auto;
      display: block;

      &:before {
        content: "";
        padding-bottom: 130%;
      }

      img {
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
      }
    }

    .swiper-button {
      border-color: var(--colour-tertiary);
      background: var(--colour-tertiary);
      border-radius: 50%;
      color: var(--button-background2);
      cursor: pointer;
      z-index: 1;
      box-shadow: 0 2px 10px rgba(54,54,54,.15);
      margin: 0;
      width: 20px;
      height: 20px;

      svg {
        width: auto;
        height: 10px;
        stroke-width: 1.5px;
        stroke: currentColor;
        fill: currentColor;
      }
      
      &:after {
        content: none;
      }

      &.swiper-button-prev {
        transform: translate(-100%, -50%);
        left: 0;
      }
      
      &.swiper-button-next {
        transform: translate(100%, -50%);
        right: 0;
      }
    }
  }

  // GALLERY
  .Product__Wrapper {
    display: flex;
    margin-top: 5rem;
    max-width: 100%;
    display: grid;
    grid-template-columns: 100%;
    grid-gap: 10px;

    .Product__Gallery {
      //flex: 50%;
      margin: 0;

      @media screen and (max-width: $break--medium) {
        max-width: 500px;
        margin: 0 auto;
        width: 100%;
      }
    }

    .Product__ActionList {
      right: calc(6rem + 25px);

      @media screen and (max-width: $break--small) {
        right: calc(2rem + 25px);
        top: 5rem;
      }
    }

    .Product__SlideshowNavImage {
      position: relative;
      display: block;
      border: 2px solid transparent;
      transition: all 0.2s ease-in-out;
      cursor: pointer;
      margin: 0 0 10px 0;
      height: 100%;
      margin: 0;

      img {
        object-fit: cover;
        position: absolute;
        top: 0;
        width: 100%;
        height: 100%;
      }

      &.is-selected img {
        box-shadow: 0 0 1px 1px var(--heading-color);
      }
    }

    .Product__SlideshowNavScroller {
      display: grid;
      grid-template-rows: 1fr 1fr 1fr 1fr;
      grid-gap: 10px;
      position: absolute;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;

      .Product__SlideshowNavImage {
        height: 100%;
        width: 100%;
        overflow: hidden;
      }
    }

    .Product__InfoWrapper {
      flex: auto;
      position: static;
      height: auto;
    }

    @media screen and (min-width: 1008px) {
      grid-template-columns: 50% calc(45% - 10px);
      justify-content: space-between;
    }

    @media screen and (max-width: $break--small) {
      flex-direction: column;
      margin-top: 0;
    }
  }

  .Product__Gallery {
    .Product__Slideshow--wrapper {
      display: grid;
      grid-template-columns: 15.6% 1fr;
      grid-gap: 10px;
      position: sticky;
      top: 91px;

      .Product__SlideshowNav {
        display: block;
        position: relative;

        .swiper-container {
          position: absolute;
          top: 0;
          left: 0;
          width: 100%;
          height: 100%;
        }
      }

      .flickity-page-dots {
        display: none;
        
        justify-content: center;
        
        position: absolute;
        bottom: 14px;
        left: 0;
        right: 0;

        .dot {
          height: 7px;
          width: 35px;
          border-radius: 0;
          margin: 0 3px;
          border: none;
          background: #E3E3E3;
          
          &.is-selected {
            background: #AA948B;
          }
        }
      }

      .Product__Slideshow {
        display: block;
        width: 100%;
        padding: 0 6rem;

        .flickity-prev-next-button {
          &.previous {
            left: 0;
          }

          &.next {
            right: 0;
          }
        }
      }

      @media screen and (max-width: 1008px) {
        grid-template-columns: 100%;

        .Product__SlideshowNav {
          padding-bottom: 25%;
          order: 1;
        }
      }

      @media screen and (max-width: 1008px) {
        grid-template-columns: 100%;

        .swiper-container {
          padding: 0 2rem;
        }

        .Product__SlideshowNav {
          padding-bottom: 33.33%;
          order: 1;
        }
      }
    }

    .flickity-prev-next-button {
      position: absolute;
      top: 50%;
      margin: 0.35rem;
      margin: 0;
      transform: translateY(-50%);

      &.next {
        right: 0;
      }
    }

    @media screen and (max-width: $break--small) {
      
      .Product__Slideshow--wrapper .flickity-page-dots {
        display: flex ;
      }
      
      .Product__Slideshow--wrapper .Product__Slideshow {
        padding: 0;

        .flickity-prev-next-button {
          width: 32px;
          height: 32px;

          &.previous {
            left: 9px;
          }

          &.next {
            right: 9px;
          }
        }
      }

      padding: 2.4rem 0 0 0;
    }

    &.Product__Gallery--stack {
      .Product__SlideshowNav--dots {
         display: none !important;
      }

      
      @media screen and (min-width: $break--medium) {
        .Product__Slideshow--wrapper {
          display: grid;
          grid-template-columns: 1fr;
  
          .Product__Slideshow {
            display: grid;
            grid-template-columns: 50% 50%;
            grid-template-columns: calc(50% - 4px) calc(50% - 4px);
            grid-gap: 8px;
            padding: 0;

            blockquote {
              min-width: unset !important;
            }
          
            .Product__SlideItem {
              margin-bottom: 0;

              .AspectRatio {
                min-height: 100%;

                img {
                  object-fit: cover;
                }
              }
  
              &:first-child {
                grid-column: -1/1;
              }
            }
          }
        }
      }
    }
  }

  .ProductMeta {
    text-align: left;

    // REVIEW
    .ProductMeta__Rating {
      display: flex;
      align-items: center;
      font-size: 12px;
      .loox-rating {
        display: flex;
        
        .loox-rating-content {
          gap: 0px;
          line-height: 1;
       }
  
        .loox-rating-label {
          display: none;
        }
        
        svg {
          width: 1.33em;
          height: auto;
        }
      }

      .custom-label {
        position: relative;
        top: 1px;
        left: 3px;
        //background: linear-gradient(to bottom,transparent 55%,#d99940 48%);
        line-height: 1;
        letter-spacing: normal;
        padding: 0 0.1em;
      }

      & + .ProductMeta__Title {
        margin-top: 20px;
      }
    }
    
    // TITLE
    .ProductMeta__Title {
      font-size: 16px;
      line-height: 1.3;
      letter-spacing: normal;
      color: $colour--primary;
      text-transform: uppercase;
      font-weight: 500;
      margin: 0;
      margin-left: auto;
      margin-right: auto;
      display: flex;
      justify-content: space-between;
      align-items: flex-start;
    }

    .ProductMeta__Colour {
      margin-top: 10px;
      font-size: 16px;
      font-weight: 500;
      letter-spacing: normal;
    }

    .ProductMeta__Badges {
      display: flex;
      justify-content: flex-start;
    
      &:not(:empty) {
        //margin-top: 15px;
      }
    
      .badge {
        background-color: $colour--accent;
        font-size: 10px;
        font-weight: 500;
        text-transform: uppercase;
        color: #fff;
        padding: 0.376em 1.26em;
        height: auto;
        border-radius: 0;
        letter-spacing: 1px;
        z-index: 1;
        display: block;
        pointer-events: none;
        text-align: center;
      }
    }

    // PRICE
    .ProductMeta__PriceList {
      display: block;
      margin-top: 15px;

      span {
        text-decoration: none;
        font-size: 14px;
        font-weight: 500;
        color: $colour--primary;
        letter-spacing: normal;
      }
    }
  }

  .ProductForm {
    margin-top: 30px;
  
    // COLOURS
    .ProductForm__Colours {
      margin-bottom: 30px;
      
      ul {
        list-style: none;
        padding: 0;
        margin: 0;
        display: grid;
        grid-template-columns: 1fr 1fr;
        grid-template-columns: repeat(auto-fit, minmax(98px, 1fr));
        grid-gap: 13px;

        @media screen and (max-width: $break--tiny) {
          grid-template-columns: 1fr 1fr 1fr;
          &.grid--xs-4 {
            grid-template-columns: 1fr 1fr;
          }
        }
        
        @media screen and (min-width: $break--tiny) {
          grid-template-columns: 1fr 1fr 1fr;
        }
        
        @media screen and (min-width: $break--medium) {
          grid-template-columns: 1fr 1fr 1fr;
        }
        
        @media screen and (min-width: 1280px) {
          grid-template-columns: 1fr 1fr 1fr;
        }
      }
  
      .product-card {
        display: block;
        border: 1px solid #69554D;
        height: 100%;
        display: flex;
        flex-direction: column;
  
        > span {
          border-bottom: 1px solid #69554D;
          display: flex;
          flex: 1;
          justify-content: center;
          align-items: center;
          text-align: center;
          line-height: 1;
          font-size: 10px;
          font-weight: 500;
          letter-spacing: normal;
          padding: 0.62em 0;
          white-space: nowrap;
        }

        &.product-current {
          background: #DBD9CE;
          border-width: 3px;
          > span {
            border-width: 3px;
          }
        }
      }
      
      .image--wrapper {
        margin-top: auto;
        position: relative;
        width: 100%;
  
        img {
          position: absolute;
          top: 0;
          left: 0;
          width: 100%;
          height: 100%;
          object-fit: contain;
        }
  
        &:before {
          content: "";
          display: block;
          padding-bottom: 75%;
        }
      }
    }

    .ProductForm__Option--labelled {
      margin-bottom: 25px;
    }
    
    .ProductForm__Variants .ProductForm__Inventory {
      display: block;
      padding: 0;
      line-height: 1.33;
      font-weight: 400;
      color: #a15f26!important;
      margin-bottom: -5px;
    }
    
    .ProductForm__Helper {
      color: #69554d;
      margin-top: 25px;
      a {
        background: linear-gradient(to bottom, transparent 62%, #d99940 48%);
        display: inline;
        text-decoration: none;
        line-height: 1;
      }
    }
  }

  .sizes-link {
    font-weight: 500;
    cursor: pointer;
  
    span {
      pointer-events: none;
    }
    
    >span {
      background: linear-gradient(to bottom,transparent 62%,#d99940 48%);
      line-height: 1.1;
      font-weight: 500;
      padding: 0 1px;
    }
    
    svg {
      display: inline-block;
      margin-right: 7px;
      width: 2em;
      height: auto;
      position: relative;
      top: 0.2em;
    }
  }
  
  // ICONS
  .Product__Icons {
    border-top: 1px solid rgba(0, 0, 0, 0.2);
    padding-top: 32px;
    margin-top: 32px;

    .grid--wrapper {
      //flex-wrap: nowrap;
    }

    ul {
      justify-content: center;
      justify-content: flex-start;
      list-style: none;

      .grid--item {
        //flex: 0 1 1 !important;
        //max-width: 25%;
        flex: 0 1 33.3333% !important;

        > div {
          max-width: 75px;
          max-width: clamp(75px, 20vw, 100px);
          margin: auto;
          display: flex;
          flex-direction: column;
          align-items: center;
          
          img {
            width: 100%;
            max-width: 64%;
          }
        }
        
        span {
          display: block;
          text-align: center;
          margin-top: 5px;
          font-weight: 500;
          font-size: 12px;
          line-height: 1.1;
        }
      }
    }
  }

  // FEATURED REVIEW
  .Product__FeaturedReview {
    margin: 32px 0 0 0;

    background: #D6C3B1;
    border-top: 1px solid currentColor;
    border-bottom: 1px solid currentColor;
    border-color: rgba(0, 0, 0, 0.2);
    
    @media screen and (max-width: $break--small) {
      margin: 32px -3rem 0 -3rem;
    }
    
    @media screen and (max-width: $break--tiny) {
      margin: 32px -20px 0 -20px;
    }
    
    .review--wrapper {
      background: #D6C3B1;
      position: relative;
      padding: 20px 29px;
      margin-top: 32px;
      text-align: center;
      
      font-weight: 500;
      font-size: 16px;
      line-height: 1.333;
      color: #69554D;

      max-width: 335px;
      margin: auto;
      
      em {
        font-size: 12px;
      }
      
      &:before {
        content: open-quote;
        font-weight: bolder;
        position: absolute;
        top: 25%;
        font-size: 150px;
        left: 0;
        right: 0;
        bottom: 0;
        opacity: .1;
        z-index: 1;
        display: flex;
        justify-content: center;
        align-items: center;
        line-height: 1;
        pointer-events: none;
      }
    }
  }
  
  // TABS
  .Product__Tabs {
    margin: 32px 0;

    .Collapsible {
      padding: 0;
      border-color: rgba(105, 85, 77, 0.2);
    }
  
    .Collapsible__Button {
      font-size: 12px;
      font-weight: 500;
      padding: 18px 8px;
      letter-spacing: 0.06em;

      .Collapsible__Plus {
        right: 8px;
        top: calc(50% - (14px / 2));
        width: 14px;
        height: 14px;
      }
    }
  }

  // ASIDE
  .Product__Aside {
    padding: 0;
    max-width: 100%;
  }

  // ADD TO CART
  .ProductForm__AddToCart {
    display: none;

    span {
      background: linear-gradient(to bottom,
          transparent 52%,
          $colour--accent 52%,
          $colour--accent 98%,
          transparent 98%) center center/0 75% no-repeat;
      transition: background-size 0.2s ease;
      display: inline;
    }

    &:hover span {
      background-size: 100% 100%;
    }
  }

  .ProductForm__AddToCart--variant.hide+.ProductForm__AddToCart {
    display: block;
  }

  .Product__InfoWrapper .Product__Info .ProductForm button.soldOut {
    background: #e0e0e0 !important;
    color: #b1b1b1 !important;
    pointer-events: none;
  
    span {
      display: none;
    }
  }

  [data-section="size"] {
    position: fixed;
    bottom: 0;
    left: 0;
    width: 100%;
    transform: translateY(100%);
    z-index: 9999999999999;
    transition: all .25s ease-in-out;
    box-shadow: 0 -37vh 0 100vh transparent;
    padding: 32px 20px 32px 20px;
    padding: 10px 5px 10px 0px !important;
    
    & + .measurements_popup {
      z-index: 99999999999999 !important;
    }
    
    .container--custom {
      
      position: relative;
      padding-top: 20px;
      padding-bottom: 20px;
      min-height: 200px;
      min-height: 80vh;
      min-height: 65vh;
      max-height: 80vh;
      overflow: auto;
      max-width: 1000px;
      overflow-x: hidden;
      
      @media screen and (max-width: $break--tiny) {
        min-height: 95vh;
        max-height: 95vh;

        min-height: unset;
        max-height: unset;
        height: calc(var(--window-height) - 70px);
      }
      
      &::-webkit-scrollbar {
        width: 7px;
      }
  
      /* Track */
      &::-webkit-scrollbar-track {
        background: #d7d7d7;
        border-radius: 3px;
        margin-right: 2px;
      }
  
      /* Handle */
      &::-webkit-scrollbar-thumb {
        background: $colour--primary;
        border-radius: 3px;
      }
  
      /* Handle on hover */
      &::-webkit-scrollbar-thumb:hover {
        background: $colour--primary;
      }
    }
    
    [data-popup_trigger] {
      position: sticky;
      top: 50%;
      top: 15px;
      transform: translateY(-50%);
      right: 0;
      height: 18px;
      width: 18px;
      padding: 0;
      background: #959676;
      border-radius: 100%;
      display: flex;
      -webkit-box-pack: center;
      justify-content: center;
      -webkit-box-align: center;
      align-items: center;
      border: none;
      z-index: 9999999999;
      color: #fff;
      font-size: 14px;
      cursor: pointer;
      margin-left: auto;

      margin-top: -18px;
    top: 15px;
      svg {
        width: 8px;
        pointer-events: none;
      }
    }
    
    &[data-popup="true"] {
      transform: translateY(0);
      box-shadow: 0 -37vh 0 100vh #00000085;
      
      & + [data-popup_trigger]:before {
        content: "";
        position: fixed;
        width: 100%;
        height: 100vh;
        left: 0;
        bottom: 100%;
        top: 0;
        z-index: 3;
      }
    }
  }
}

/*__________________________________________________________________________________________________________________________________________________________*/
/* -----------------------------------------------------------------------------------------------------------------------------------------------[Pages]---*/
// DEFAULT
#section--page-default {
  padding: 5rem 0;

  .PageHeader {
    margin-top: 0;
  }

  @media screen and (max-width: $break--small) {
    padding: 3.5rem 0;
  }
}

#theme--custom {
  .shopify-page_header {
    h1 {
      font-size: 4.2rem;
      line-height: 1;
      letter-spacing: 1.6px;
      text-transform: uppercase;
      color: $colour--accent;
      margin: 0 0 1em 0;
      font-weight: bold;
      text-align: center;
    }
  }

  @media screen and (max-width: $break--small) {
    .shopify-page_header {
      h1 {
        font-size: 2.4rem;
      }
    }
  }
}

// POLICY
.shopify-policy__container {
  .shopify-policy__title {
    h1 {
      font-size: 3.3rem;
      line-height: 1;
      letter-spacing: 1.6px;
      text-transform: uppercase;
      color: $colour--accent;
      margin: 0 0 1em 0;
      font-weight: bold;
      text-align: center;
    }
  }

  .shopify-policy__body {
    font-size: 1.8rem;

    p+* {
      margin-top: 1.65em;
    }

    table {
      text-align: left;
    }

    table+* {
      margin-top: 1.65em;
    }

    a {
      background: linear-gradient(to bottom,
          transparent 52%,
          $colour--accent 52%,
          $colour--accent 98%,
          transparent 98%) center center/0 75% no-repeat;
      display: inline-block;
      padding-left: 2px;
      padding-right: 2px;
      transition: background-size 0.2s ease;
      background-size: 100% 100%;
      text-decoration: none !important;
      -moz-transition: all 0.25s cubic-bezier(0.25, 0.46, 0.45, 0.94);
      -o-transition: all 0.25s cubic-bezier(0.25, 0.46, 0.45, 0.94);
      -webkit-transition: all 0.25s cubic-bezier(0.25, 0.46, 0.45, 0.94);
      transition: all 0.25s cubic-bezier(0.25, 0.46, 0.45, 0.94);

      &:hover {
        background-size: 0 100%;
      }
    }
  }

  @media screen and (max-width: $break--small) {
    .shopify-policy__title {
      h1 {
        font-size: 2.2rem;
      }
    }

    .shopify-policy__body {
      font-size: 1.6rem;
    }
  }
}

/*__________________________________________________________________________________________________________________________________________________________*/
/* ---------------------------------------------------------------------------------------------------------------------------------------------[Modules]---*/
// CAROUSEL
#theme--custom {
  .custom--carousel {
    padding-left: 6rem;
    padding-right: 6rem;
    position: relative;

    .flickity-prev-next-button {
      position: absolute;
      top: 50%;
      transform: translateY(-50%);

      &.previous {
        left: 0;
      }

      &.next {
        right: 0;
      }
    }
  }
}

// CAROUCEL PRODUCTS
#theme--custom {
  .ProductList--carousel .Carousel__Cell {
    .product-options.left {
      right: 95% !important;
      left: unset !important;

      &:before {
        left: 100% !important;
        border-width: 15px 0 15px 20px !important;
        border-color: transparent transparent transparent var(--colour-primary) !important;
      }
    }

    .product-options.right {
      left: 95% !important;
      right: unset !important;

      &:before {}
    }
  }
}

// PRODUCT GRID
#theme--custom {
  .product-grid {
    display: grid;
    grid-template-columns: 1fr 1fr 1fr;
    grid-gap: 2rem 2rem;
    padding: 0;
    margin: 0 0 6rem 0;

    .grid-item {
      padding: 0;
      margin: 0;
      width: 100%;
    }
  }

  @media screen and (max-width: $break--small) {
    .product-grid {
      grid-template-columns: 1fr 1fr;
    }
  }

  @media screen and (max-width: $break--tiny) {
    .product-grid {
      grid-template-columns: 1fr;
    }
  }
}

// PRODUCT GRID ITEM -->
#theme--custom {
  .product-item {
    .product-item--inner {
      position: relative;
    }

    .image--wrapper {
      position: relative;
      max-width: 100% !important;
      padding-bottom: 130% !important;

      img {
        width: 100%;
        height: 100%;
        object-fit: contain;

        &.image--hover {
          position: absolute;
          object-fit: cover;
        }
      }

      >a {
        position: relative;
        position: absolute;
        display: block;
        width: 100%;
      }
    }

    .product-badges {
      display: flex;
      align-items: flex-start;
      justify-content: flex-end;
      flex-wrap: wrap;
      position: absolute;
      gap: 1rem;
      top: 1rem;
      right: 1rem;

      .badge {
        background-color: $colour--accent;
        font-size: 1.25rem;
        font-weight: 400;
        text-transform: uppercase;
        color: #fff;
        padding: 0.5em 1.25em;
        height: auto;
        border-radius: 0;
        letter-spacing: 1px;
        z-index: 1;
        display: block;
        pointer-events: none;
      }
    }

    .product-title {
      font-size: 13px;
      line-height: 1.3;
      letter-spacing: 0.2px;
      color: $colour--primary;
      text-transform: capitalize;
      font-weight: 400;
      text-align: center;
      margin: 1em 0 0;
      margin-left: auto;
      margin-right: auto;
    }

    .product-price {
      display: block;
      text-align: center;
      text-decoration: none;
      margin-top: 6px;
      font-size: 14px;
      font-weight: bold;
      color: $colour--primary;
      letter-spacing: 0.1em;
    }

    .product-options {
      position: absolute;
      bottom: 10px;
      left: 95%;
      background-color: $colour--background;
      display: none;
      align-items: center;
      justify-content: center;
      text-align: center;
      width: 250px;
      z-index: 9;
      padding: 1rem;
      border: 1px solid $colour--primary;

      &:before {
        content: "";
        border: 1px solid black;
        height: 0;
        width: 0;
        position: absolute;
        top: 10px;
        right: 100%;
        border-width: 15px 20px 15px 0;
        border-color: transparent $colour--primary transparent transparent;
      }

      .product-sizes {
        .title {
          margin-bottom: 1em;
          color: $colour--primary;
          font-weight: bold;
          text-transform: uppercase;
          font-size: 0.9rem;
          display: block;
        }

        ul {
          display: flex;
          flex-wrap: wrap;
          margin: 0;
          display: grid;
          grid-template-columns: repeat(5, 1fr);

          li {
            list-style: none;
            padding: 5px;

            &.unavailable {
              a {
                font-weight: 400;
                text-decoration: line-through !important;
              }
            }
          }

          a {
            background-color: transparent;
            color: $colour--primary;
            font-size: 12px;
            font-size: 1.15rem;
            font-weight: bold;
            letter-spacing: 0;
            text-transform: uppercase;
            margin: 0;
            padding: 5px;
