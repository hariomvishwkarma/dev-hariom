      }
    }

    
    .mesfile {
      display: block;
      margin-top: 34px;

      a {
        display: flex;
        align-items: center;
        justify-content: center;
        border-color: #69554D;
        background: #69554D;
        color: #fff;
        letter-spacing: normal;
        font-weight: 800;
        font-size: 13px;
        min-height: 45px;
        grid-gap: 0.3em;
      }
