.h1,
h2,
.h2,
h3,
.h3,
h4,
.h4,
h5,
.h5,
h6,
.h6 {
  font-style: normal;
  font-weight: bold;
  overflow-wrap: break-word;
  word-wrap: break-word;
  text-transform: none;
  letter-spacing: 0;
  margin-bottom: 1rem;

  a,
  span {
    color: inherit;
    text-decoration: none;
    font-weight: inherit;
  }
}

