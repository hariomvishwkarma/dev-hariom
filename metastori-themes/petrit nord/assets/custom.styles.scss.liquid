      grid-template-columns: 1fr 1fr;
      grid-gap: 5px;
      margin: 0;
      width: 100%;
    }

    .image--wrapper {
      position: relative;
      display: block;
      img {
        object-fit: cover;
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
      }

      .overlay--wrapper {
        pointer-events: none;
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        display: flex;
        justify-content: center;
        align-items: center;
        flex-direction: column;
        grid-gap: 8px;
        background: rgba(0, 0, 0, 0.3);
        padding: 10px;
