  // Instagram
  [data-section="instagram"] {
    .section-content {
      position: relative;
    }

    .accent--text {
      position: absolute;
      top: 0;
      left: 0;
      right: 0;
      text-align: center;
      font-weight: bold;
      text-transform: uppercase;
      line-height: 1;
      display: block;
      transform: translateY(-50%);
      z-index: 2;

      .text {
        font-size: 4.4rem;
        display: block;
        text-shadow: 0px 0px 9px #737373;
      }
    }

    .cell--inner {
      display: block;

      &.full {
        .top {
          margin: 0;

          &:before {
            padding-bottom: 160%;
          }
        }

        .bottom {
          &:before {
            padding-bottom: 0%;
          }
        }
      }

      &.small-big {
        .top {
          &:before {
            padding-bottom: calc(100% - 1rem);
          }

          &.expand {
            margin: 0;

            &:before {
              padding-bottom: 160%;
            }
          }
        }

        .bottom {
          &:before {
            padding-bottom: calc(60% - 1rem);
          }
        }
      }

      &.big-small {
        .top {
          &:before {
            padding-bottom: calc(60% - 1rem);
          }

          &.expand {
            margin: 0;

            &:before {
              padding-bottom: 160%;
            }
          }
        }

        .bottom {
          &:before {
            padding-bottom: calc(100% - 1rem);
          }
        }
      }

      &.small-small {
        .top {
          &:before {
            padding-bottom: calc(80% - 1rem);
          }

          &.expand {
            margin: 0;

            &:before {
              padding-bottom: 160%;
            }
          }
        }

        .bottom {
          &:before {
            padding-bottom: calc(80% - 1rem);
          }
        }
      }
    }

    .image--wrapper {
      position: relative;
      margin: auto;
      overflow: hidden;

      img {
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        object-fit: cover;
      }

      &:before {
        content: "";
        padding-bottom: 100%;
        display: block;
      }

      &.top {
        margin-bottom: 2rem;
      }
    }

    .instagram-dot {
      position: absolute;
      display: block;
      width: 12px;
      height: 12px;
      margin: -4px 0 0 -4px;
      background: #fff;
      border-radius: 100%;
      box-shadow: 0 1px 10px #00000040;
      cursor: pointer;
      z-index: 1;
      transform: scale(1);
      transition: transform 0.25s ease-in-out;

      &:before {
        position: absolute;
        content: attr(data-tooltip);
        bottom: 70%;
        left: 70%;
        padding: 4px 11px 3px 11px;
        white-space: nowrap;
        background: #202122;
        color: #fff;
        font-size: 10px;
        pointer-events: none;
        visibility: hidden;
        opacity: 0;
        transition: visibility 0.2s ease-in-out, opacity 0.2s ease-in-out;
        z-index: 1;
        text-transform: uppercase;
        letter-spacing: 0.1em;
      }

      &:after {
        position: absolute;
        content: "";
        width: 30px;
        height: 30px;
        left: -9px;
        top: -9px;
        border-radius: 100%;
        background: rgba(255, 255, 255, 0.4);
        -webkit-animation: 1.4s dot ease-in-out infinite;
        animation: 1.4s dot ease-in-out infinite;
      }

      &:hover::before {
        opacity: 1;
        visibility: visible;
      }
    }

    .custom--carousel {
      padding-bottom: 0;
      overflow: hidden;

      .flickity-viewport {
        overflow: visible;
      }

      .carousel-cell {
        width: 25%;

        .cell--inner {
          padding: 0 1rem;
          display: block;
        }
      }
    }

    @media screen and (max-width: 1352px) {
      .dec-carousel {
        padding: 0 20px;
      }
    }
    
    @media screen and (min-width: $break--small) {
      .dec-carousel {
        display: flex;
        justify-content: center;
        align-items: center;
        padding-bottom: 0;
        overflow: hidden;

        .flickity-viewport {
          overflow: visible;
          height: auto !important;
          width: 100%;
          cursor: initial;

          .flickity-slider {
            position: static;
            display: flex;
            transform: none !important;
            justify-content: center;
          }
        }

        .carousel-cell {
          width: 25%;
          position: static !important;

          .cell--inner {
            padding: 0 1rem;
            display: block;
          }
        }
      }
    }

    @media screen and (max-width: $break--small) {
      .accent--text {
        .text {
          font-size: 3.3rem;
        }
      }

      .custom--carousel {
        .carousel-cell {
          width: 50%;
        }
      }
    }

    @media screen and (max-width: $break--tiny) {
      .custom--carousel {
        .carousel-cell {
          width: 75%;
        }
      }
    }
  }

