          }
        }
        
        .content {
          padding: 20px;
          display: flex;
          flex-direction: column;
          justify-content: center;

          .heading {
            font-weight: 500;
            font-size: 16px;
            margin-bottom: 10px;
            letter-spacing: normal;
            line-height: 1.33;
          }

