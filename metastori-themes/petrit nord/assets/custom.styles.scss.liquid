        }
        
        svg {
          width: 1em;
          height: auto;
          display: inline-block;
          margin-left: 5px;
        }
      }
    }
  }

  .Header__MainNav {
    .HorizontalList__Item {
      >.u-h6 {
        position: relative;
        display: flex;
        font-weight: 400;
        letter-spacing: normal;
        
        svg {
          margin-left: 7px;
          width: 1em;
          height: 1.5em;
        }
      }
  
      &:hover >.u-h6 > svg {
        //transform: rotate(180deg);
      }
    }
  }

  // DROPDOWN
  .DropdownMenu {
    padding: 3rem;
    border: 1px solid var(--colour-primary);

    .Linklist__Item:first-child {
      margin-top: 0;
    }
  }

  .DropdownMenu::before {
    content: none;
  }

  #section-header:not(.scroll--active) .Header__Wrapper {
    transition: .3s ease-in-out;
    &:hover {
      background: var(--header-background);
      color: var(--header-heading-color);

      .Header__LogoImage--transparent {
        display: none !important; 
      }

      .Header__LogoImage--primary:not(.hide) {
        display: block !important; 
        opacity: 1;
      }
    }
  }
  
  // MEGAMENU
  .MegaMenu {
    color: var(--header-heading-color);
    width: auto;
    max-width: 100%;
    left: 50%;
    transform: translateX(-50%);
    padding: 60px 0;
    //filter: drop-shadow(0 1px 8px rgba(0, 0, 0, 0.06));
    border: none;
    border: 1px solid var(--colour-primary);
    min-width: 900px;

    border: none;
    border-bottom: 1px solid rgba(0, 0, 0, 0.2);
    border-top: 1px solid rgba(0, 0, 0, 0.2);
    width: 100%;
    
    .MegaMenu__Inner {
      padding: 0 45px;
      max-width: 100%;

      .MegaMenu__Text {
        padding-right: 2rem;
      }

      .MegaMenu__Item {
        margin: 0;

        .MegaMenu__Title {
          margin-bottom: 0;
          border-bottom: 1px solid currentColor;
          padding-bottom: 0.35em;
          display: inline-block;

          font-weight: 500;
          font-size: 16px;
          letter-spacing: normal;
          padding-bottom: 7px;
          margin-bottom: 10px;
          border-bottom: 1px solid rgba(105, 85, 77, 0.1);
          display: block;
        }
      }

      .MegaMenu__PushImageWrapper {
        img {
          object-fit: cover;
        }

        .overlay {
          position: absolute;
          top: 0;
          left: 0;
          width: 100%;
          height: 100%;
          display: flex;
          justify-content: center;
          align-items: center;
          font-weight: bold;
          color: #fff;
          font-size: 2.5rem;
          text-shadow: 0 0 4px #0000009e;
        }

        &:before {
          //padding-bottom: 100%;
        }
      }
    }
  }

  // ACTIONS
  .cart--icon,
  .search--icon {
    font-size: 1.4em;
    position: relative;
    top: 0.15em;

    @media only screen and (max-width: $break--large) {
      left: 5px;
      top: 0;
    }
  }

  .search--icon {
    font-size: 1.4em;
    top: 0.15em;
    left: 0;

    @media only screen and (max-width: $break--large) {
      left: 5px;
      top: 0;
    }
  }

  .HorizontalList .HorizontalList__Item [data-action="open-drawer"] {
    display: flex;
    align-items: center;
    font-size: 14px;
    letter-spacing: 0.475em;
    svg {
      position: relative;
      top: -1px;
      left: -8px;
    }
  }
}

.section-sidebar-menu {

  // MOBILE
  .Collapsible .Collapsible .Collapsible__Button span {
    background: linear-gradient(to bottom,
        transparent 52%,
