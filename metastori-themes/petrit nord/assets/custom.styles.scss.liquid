// LAYOUT -->
// TOPBAR -->
.shopify-section--announcement {
  .AnnouncementBar__Wrapper {
    padding: 13px 0 13px 0;
    font-size: 14px;
    line-height: 1;
    text-transform: uppercase;
    max-width: 100%;
    overflow: hidden;
    span {
      background: linear-gradient(to bottom,transparent 62%,#DFA35F 48%);
      display: inline;
      text-decoration: none !important;
      line-height: 1;
      font-weight: 700;
    }
  }

  .swiper-slide {
    height: auto !important;
    display: flex;
    justify-content: center;
    align-items: center;
  }

  .swiper.view--default .swiper-wrapper {
    justify-content: center;
    grid-gap: 30px;
    .swiper-slide {
      flex: 0 1 auto;
      width: auto;
    }
  }

  @media screen and (max-width: $break--large) {
    .AnnouncementBar__Wrapper {
      padding: 9px 0 8px 0;
      font-size: 12px;
    }
  }
}

// MAIN -->
.shopify-section--header {
  @media screen and (min-width: 1140px) {
    .Header__FlexItem--logo {
      margin: 0;
    }
  
    .Header:not(.Header--sidebar) .Header__Wrapper {
      padding: 27px 50px;
      padding: 24px 50px 31px 50px;
      display: grid;
      grid-template-columns: 1fr auto 1.15fr;
    }
  }
  
  #section-header {
    .Header__Wrapper {
      padding-left: $default-spacing-desktop;
      padding-right: $default-spacing-desktop;

      @media screen and (max-width: $break--tiny) {
        padding-left: $default-spacing-mobile;
        padding-right: $default-spacing-mobile;
      }
    }

    .static {
      display: inline;
    }

    .transparent {
      display: none;
    }

    &.scroll--active {
      .static {
        display: none;
      }

      .transparent {
        display: inline;
      }
    }
  }

  .Header__MainNav {
    margin-right: 45px;
    margin: auto;
  }

  // LOGO
  .Header__LogoImage {
    object-fit: contain;
  }

  // SHOP LOCATOR
  .shop-locator {
    display: flex;
    align-items: center;
  }

  // MENU
  .Rte h6,
  .u-h6 {
    font-size: 12px;
    font-size: 1.3rem;
    font-size: 1.5rem;
    font-size: 14px;
  }

  .HorizontalList {
    .u-h6 {
      background: linear-gradient(to bottom,
          transparent 52%,
          $header--accent 52%,
          $header--accent 98%,
          transparent 98%) center center/0 75% no-repeat;
      transition: background-size 0.2s ease;
      display: inline;
    }

    .Linklist__Item>.Link {
