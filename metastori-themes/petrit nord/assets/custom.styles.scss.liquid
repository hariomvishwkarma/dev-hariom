      .item--inner {
        display: grid;
        grid-template-columns: 1fr 1fr;
        height: 100%;

        .image--wrapper {
          position: relative;
          min-height: 100%;
          img {
            position: absolute;
            top: 0;
            left: 0;
            height: 100%;
            width: 100%;
            object-fit: cover;    
            display: flex;
            flex-wrap: wrap;
            grid-gap: 5px;

            @media only screen and (max-width: $break--small) {
              max-height: 270px;
              object-position: top;
            }
          }

          &:before {
            content: "";
            display: block;
            padding-bottom: 120%;
          }
        }
        
        .content {
          padding: 20px;
          display: flex;
          flex-direction: column;
          justify-content: center;

          .heading {
            font-weight: 500;
            font-size: 16px;
            margin-bottom: 10px;
            letter-spacing: normal;
            line-height: 1.33;
          }

          .text {
            font-weight: 400;
            font-size: 14px;
            margin-bottom: 10px;
            letter-spacing: normal;
            line-height: 1.33;
          }

          .rating {
            font-weight: 400;
            font-size: 12px;
            letter-spacing: normal;
            line-height: 1.33;

            display: grid;
            grid-template-columns: auto auto;
            justify-content: space-between;

            display: flex;
            flex-wrap: wrap;
            grid-gap: 5px;
            
            .stars {
              display: flex;
              //background: rgba(105,85,77,.2);
              padding: 4px 3px;
              border-radius: 0px;
              align-self: center;
              .star {
                display: block;
                flex: 20%;
                
                svg {
                  fill: var(--colour-accent);
                  max-width: 20px;
                  width: 100%;
                  display: block;
                }

                & + .star {
                  margin-left: -2px;
                }
              }
            }
            p {
              margin: 0;
            }
          }
        }
      }
    }
  }
  
  [data-section="homepage_featured_collection"] {
  
    &.section--wrapper {
      background-color: var(--section-background, transparent);
      padding: var(--section-padding, 0rem) 0;
      margin-bottom: var(--section-margin, 0rem);
  
      .section--content {
        background-color: var(--section-content-background, transparent);
        padding: var(--section-content-padding, 0rem);
        color: var(--section-content-colour, $colour--primary);
      }
  
      @media only screen and (max-width: $break--small) {
        padding: calc(var(--section-padding, 0rem) / var(--section-mobile-modifier, 1.2)) 0;
        margin-bottom: calc(var(--section-margin, 0rem) / var(--section-mobile-modifier, 1.2));
  
        .section--content {
          padding: calc(var(--section-content-padding, 0rem) / var(--section-mobile-modifier, 1.2));
        }
      }
    }

    .product--wrapper {
      display: flex;
      display: -moz-box;
      display: -ms-flexbox;
      display: -webkit-flex;
      display: flex;
      flex-wrap: wrap;
      gap: 10px;
      .product-item {
        position: relative;
        flex: 0 1 calc(25% - 9px);
        
        a {
          display: block;
        }
      }

      .product-title {
        text-align: center;
        font-weight: 600;
        font-size: 13px;
        font-weight: 400;
        line-height: 18px;
      }

      .product-price {
        text-align: center;
        margin-top: 5px;
        font-weight: 700;
        font-size: 14px;
      }
      
      // REVIEW
      .product-review {
        display: flex;
        align-items: center;
        font-size: 12px;
        .loox-rating {
          display: flex;
          
          .loox-rating-content {
            gap: 0px;
            line-height: 1;
         }
    
          .loox-rating-label {
            display: none;
          }
          
          svg {
            width: 1.33em;
            height: auto;
          }
        }
  
        .custom-label {
          position: relative;
          top: 1px;
          left: 3px;
          line-height: 1;
          letter-spacing: normal;
          padding: 0 0.1em;
        }
      }
      
      .image--wrapper {

        img {
          position: absolute;
          top: 0;
          left: 0;
        }

        &:hover {
          img {
            opacity: 0;
          }
          .image--hover {
            display: block !important;
            opacity: 1;
          }
        }
      }
    }

    .button--wrapper {
      margin-top: calc(var(--section-padding));
      a {
        display: block;
        max-width: 400px;
        margin: auto;
        color: #fff;
        background: var(--colour-accent);
        font-weight: 600;
        border-radius: 0;
      }
    }

    @media only screen and (max-width: $break--small) {
      .button--wrapper {
        margin-top: calc(var(--section-padding, 0rem) / var(--section-mobile-modifier, 1.2));
      }
      
      .product--wrapper .product-review {
        font-size: 10px;
      }
        
      .product--wrapper {
        .product-item {
          flex: 0 1 calc(50% - 5px);
        }
      }
    }
  }
}

#theme--custom[data-template^="page.custom_pages_1_"] {

  /* Description extension */
  .text-extension {
    display: block;
    max-height: 0;
    margin: 0;
    padding-top: 0;
    position: relative;
    overflow: hidden;
    opacity: 0;
    -webkit-transition: all 0.4s ease-in-out;
    -moz-transition: all 0.4s ease-in-out;
    -o-transition: all 0.4s ease-in-out;
    transition: all 0.4s ease-in-out;
  }

  /* Description extension [active] */
  .text-extension[data-active="true"] {
    margin-top: 1em;
    max-height: 3100px;
    min-height: auto;
    opacity: 1;
  }

  .page-section {
    padding: var(--section-padding, 0rem) 0;
    margin-bottom: var(--section-margin, 0rem);

    .section-content {
      padding: var(--section-content-padding, 0rem);
    }

    @media only screen and (max-width: $break--small) {
      padding: calc(var(--section-padding, 0rem) / var(--section-mobile-modifier, 2)) 0;
      margin-bottom: calc(var(--section-margin, 0rem) / var(--section-mobile-modifier, 2));

      .section-content {
        padding: calc(var(--section-content-padding, 0rem) / var(--section-mobile-modifier, 2));
      }

      .container--custom_page {
        padding: 0 9vw !important;
      }
    }
