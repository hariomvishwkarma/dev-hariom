        .Link {
          
          display: inline-block;
          max-width: 200px;
          width: auto;
        }
      }
    }

    .MegaMenu__Item {
      >.Link {
        background: linear-gradient(to bottom,
            transparent 52%,
            $header--accent 52%,
            $header--accent 98%,
            transparent 98%) center center/0 75% no-repeat;
        transition: background-size 0.2s ease;
        display: inline;
        padding: 0;

