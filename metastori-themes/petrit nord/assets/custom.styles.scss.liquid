        }
      }
    }

    .article--wrapper {
      display: grid;
      grid-template-columns: 1.23fr 1fr;

      grid-gap: 3rem;
      
      .mesfile {
        margin-top: 10px;
      }
      
      .text-item {
        width: 100%;
      }

      .content--wrapper {
        padding: 0;
        display: flex;
        flex: 1;
        font-size: 2.2rem;
      }

      &.reverse {
        direction: rtl;

        .content--wrapper {
          text-align: left;
          direction: ltr;
        }
      }
    }

    .grid-item {
      max-width: 50%;
    }

    .scrollmagic-pin-spacer {
      box-sizing: content-box !important;
    }

    .items-container {
      position: relative;
      margin: 30px auto 0 auto;

      .feature-item {
        padding-bottom: 30px;
        opacity: 0.4;
        padding-left: 25px;
        position: relative;
        max-width: 500px;
        text-align: left;
      }

      .text--wrapper {
        font-size: 14px;
        line-height: 1.143;
      }

      li {
        display: grid;
        grid-template-columns: 34px 1fr;
        grid-gap: 12px;

        &  + li {
          margin-top: 20px;
        }
        
        &:before {
          content: attr(data-index);
          background: #69554D;
          display: flex;
          height: 34px;
