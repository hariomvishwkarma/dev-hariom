  /*
   * 4.1 CART DRAWER -->
   * ----------------------------------------------------------------------------------------------------------------------------------
   * Cart upsell module. Add/remove upsell products
   * ----------------------------------------------------------------------------------------------------------------------------------
   */
  cartUpsell: function(event) {
    let $this = $(event.currentTarget);
    let id = $this.attr("data-product");

    fetch('/cart.js', { method: 'GET', headers: {'Content-Type': 'application/json;'}})
      .then(function(response) {
        return response.json();
      })
      .then(
        function(state) {
          let items = [{ 
            "id": id, 
            "quantity": 1
          }];

          let item = state.items.filter(function(el){
            if(el.id == id) {return el;}
          });

          if(item.length == 0) {
            fetch('/cart/add.js', {
              method: 'POST',
              headers: {
                'Content-Type': 'application/json'
              },
              body: JSON.stringify({ 'items': items })
            }).then(response => {
              
              this.updateCartDrawer();
              $this.addClass("check");
              
            }).catch((error) => { });
          } else {
            fetch('/cart/change.js', {
              method: 'POST',
              headers: {
                'Content-Type': 'application/json'
              },
              body: JSON.stringify({ 'id': id, 'quantity': 0 })
            }).then(response => {
              
              this.updateCartDrawer();
              $this.removeClass("check");

              return response.json();
            }).catch((error) => { });
          }

        }.bind(this)
      ).catch(function() { }.bind(this));
  },
    
