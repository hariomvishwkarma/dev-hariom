  /*
   * 3.1 PRODUCT ITEM -->
   * ----------------------------------------------------------------------------------------------------------------------------------
   * Sizes selection popup. Show availbale variants.
   * ----------------------------------------------------------------------------------------------------------------------------------
   */
  collectionPopup: function(event) {
    let $this = $(event.currentTarget);
    let title = $this.attr("data-product");

    if($this.closest(".Carousel__Cell").length > 0) {
      let carouselContainer = $this.closest(".Carousel__Cell").parent().parent();
      let carouselContainerWidth = carouselContainer.width();
      var elem = $this.closest(".Carousel__Cell");
      var cellPosition = elem.offset().left - elem.parent().parent().offset().left;
      let position = "right";
      let calcWidth = carouselContainerWidth / 2;
      
      if(cellPosition >= calcWidth) {
        position = "left";
      }
      
      $this.find(".product-options").removeClass("left right");
      $this.find(".product-options").addClass(position);
    } else {
      
      let wrapper = $this.closest(".product-item");
      let container = $this.closest(".ProductList");
      let carouselContainerWidth2 = container.width() / 2;
      var cellPosition2 = wrapper.position().left;
      
      if(cellPosition2 >= carouselContainerWidth2) {
        wrapper.addClass("left");
      } else {
        wrapper.removeClass("left");
      }
    }

    if($this.find(".product-variants").children().length == 0) {
      fetch(window.routes.rootUrlWithoutSlash+'/search?view=variants&q=title:"'+ title +'"', {
        method: 'POST',
        credentials: 'same-origin',
        headers: {
          'Accept': 'application/json',
          'Content-Type': 'application/json'
        }
      })
      .then((res) => res.text())
      .then((res) => {
      	$this.find(".product-variants").html(JSON.parse(res));
      });
    }
  },
    
    
  searchPopup: function(event) {
    let $this = $(event.currentTarget);
    let wrapper = $this.closest("li");
    let container = $this.closest("ul");
    let title = $this.find(".snize-title").text();
    title = title.replaceAll(" ", "+");
    
    let carouselContainerWidth = container.width();
    let carouselContainerWidth2 = container.width() / 2;
    var cellPosition = wrapper.offset().left;
    var cellPosition2 = wrapper.position().left;
    
    
    if(cellPosition2 >= carouselContainerWidth2) {
      wrapper.addClass("left");
    } else {
      wrapper.removeClass("left");
    }
    
    if($this.find(".product-variants").length == 0) {
      $this.find(".snize-thumbnail-wrapper").append(`<div class="product-options"> <div><div class="product-sizes"> <span class="title">Available Sizes</span> <ul class="product-variants"> </ul> </div></div> </div>`);
    }
    
    if($this.find(".product-variants").children().length == 0) {
      fetch(window.routes.rootUrlWithoutSlash+'/search?view=variants&q=title:"'+ title +'"', {
        method: 'POST',
        credentials: 'same-origin',
        headers: {
          'Accept': 'application/json',
          'Content-Type': 'application/json'
        }
      })
      .then((res) => res.text())
      .then((res) => {
        $this.find(".product-variants").html(JSON.parse(res));
      });
    }
  },
    
