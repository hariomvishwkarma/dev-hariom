  },
    
  /*
   * UTILITIES -->
   * ----------------------------------------------------------------------------------------------------------------------------------
   * Append html message and remove it.
   * ----------------------------------------------------------------------------------------------------------------------------------
   * 1. $container : element to append html
   * 2. element    : html to append
   * 3. time       : time to remove element
   */
  showMessage: function($container, element, time) {
    $container.append($(element).hide().fadeIn());
    setTimeout(function(){
      $container.find(".element--remove").fadeOut(800, function() {
        $(this).remove();
      });
    }, time);
  },
    
