    document.querySelector("body").delegateListener("click", "[data-trigger]", function(event) {
      let target = event.target.closest(".collection-description").querySelector("[data-active]");
      let triggerValue = event.target.getAttribute("data-trigger");
      target.setAttribute('data-active', `${!(target.getAttribute('data-active') === 'true')}`);
      if(triggerValue) {
        event.target.textContent = triggerValue.split("/")[+(target.getAttribute('data-active') === 'true')];
