  /*
   * 1.1 PAGE -->
   * ----------------------------------------------------------------------------------------------------------------------------------
   * Page slider module setup. Split page description
   * ----------------------------------------------------------------------------------------------------------------------------------
   */
  setupPageSliders: function(event) {
    let pageContent = document.querySelector("#page-content").children;
    let newContent = document.querySelector("#result");
    let newColumn;
    let newList;
    let newListItem;

    Array.from(pageContent).forEach((child) => {
      if(child.textContent !== "" && child.textContent.length > 1) {
        if(child.querySelectorAll("h4").length > 1 || child.tagName === "H4") {
          newColumn = createColumn(newContent, child, "column--wrapper");
        }
        else if(child.querySelectorAll("h5").length > 1 || child.tagName === "H5") {
          newList = createList(newColumn, child, "list--wrapper");
        }
        else if(child.querySelectorAll("h6").length > 1 || child.tagName === "H6") {
          newListItem = createListItem(newList, child, "list--item", "p");
        }
        else {
          createListItem(newListItem, child, "list--item", "p");
        }
      }
    });

    function createColumn(parent, children, className) {
      let newContainer = document.createElement('div');
      let newTitle = document.createElement('h3');

      newContainer.classList.add(className);
      newTitle.textContent = children.textContent;

      newContainer.append(newTitle);
      parent.append(newContainer);

      return newContainer;
    }

    function createList(parent, children, className) {
      let newContainer = document.createElement('div');
      let newTitle = document.createElement('button');
      let newList = document.createElement('ul');

      newContainer.classList.add(className);
      newList.classList.add("hide");
      newTitle.textContent = children.textContent;

      newContainer.append(newTitle);
      newContainer.append(newList);
      parent.append(newContainer);

      return newList;
    }

    function createListItem(parent, children, className, TagName) {
      let newContainer;
      let newItem = document.createElement(TagName);

      newItem.textContent = children.textContent;

      if(parent.tagName !== "LI") {
        newContainer = document.createElement('li');
        newContainer.classList.add(className);
        newContainer.append(newItem);
        parent.append(newContainer);
        return newContainer;
      } else {
        parent.append(newItem);
        return;
      }
    }
    
    $("body").on("click", ".columns--wrapper button", function(event) { this.pageSliderButtons(event); }.bind(this));
  },
    
