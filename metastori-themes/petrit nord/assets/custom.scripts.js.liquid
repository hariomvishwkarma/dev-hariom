// Collection badges
(function () {
  const badgeSettings = window.collectionBadges[0];
  const collectionBadges = window.collectionBadges;
  
  const observerBody = new MutationObserver(function(mutationsList, observer) {
    let update = false;
    let updateSearch = false;
  
    for (let i = 0; i < mutationsList.length; i++) {
      let mutatonTarget = mutationsList[i].target;

      if( typeof(mutatonTarget.className) === 'object') {
        return;
      }
      
      if(mutatonTarget.className.indexOf("snize-search-results-content") > -1 || 
         mutatonTarget.className.indexOf("container") > -1 || 
         mutatonTarget.className.indexOf("snize-new-design") > -1|| 
         (mutatonTarget.classList.length == 0 && mutatonTarget.id == "")) {
        update = true;
        if(mutatonTarget.closest(".snize-ac-results")) {
          updateSearch = true;
        }
        break;
      }
    }
    
    if(update) {
      
      // HIDE DUPLICATES ON SEARCH
      if(updateSearch) {
        $(".snize-ac-results .snize-product:not(.skeleton)").each(function(index, element) {
          let _this = $(element);
          
          let href = _this.children("a").attr('href').split("/");
          let handle = href[href.length - 1];
          let selector = ".snize-ac-results .snize-product-tag-size" + handle.split("?")[0];
          if(handle.indexOf("-a-") > -1) {
            $(selector).addClass("hide");
          }
        });

      // HIDE DUPLICATES AND ADD BADGES ON COLLECTION PAGE
      } else {

        var gridTarget = document.querySelector(".product-grid") || document.querySelector(".snize-search-results-content");

        if(document.querySelector(".collection-elements > .timer--wrapper") && gridTarget && !gridTarget.querySelector(".timer--wrapper")) {
          $('.collection-elements > .timer--wrapper').clone().appendTo(gridTarget);
        }
        
        if(document.querySelector(".collection-elements > .featured_review--wrapper") && gridTarget && !gridTarget.querySelector(".featured_review--wrapper")) {
          $('.collection-elements > .featured_review--wrapper').clone().appendTo(gridTarget);
        }

        var stickyBar = document.querySelector(".discovery-filters__bar") || document.querySelector(".snize-horizontal-wrapper");
        if(stickyBar) {
          var leftPos  = 0 - stickyBar.getBoundingClientRect().left   + $(window)['scrollLeft']();
          $("html").css("--collectionToolbar", leftPos + "px");
        }
        
        $(".snize-search-results-content .snize-product:not(.skeleton)").each(function(index, element) {
          let _this = $(element);
          let child =  _this.children("a");
          let badgeContainer = $(element).find(".product-badges");
          
          if(!child.attr('href')) { return; }

          let href = child.attr('href').split("/");
          let badgeData;
          let handleA = href[href.length - 1];
          let handleB = handleA.replaceAll("-a-", "-b-");
          let handle = handleA;
          let collectionHandle = window.location.pathname.replace("/collections/", "").replaceAll(" ", "").replaceAll("/", "");
          let selector = ".snize-search-results-content .snize-product-tag-size" + handle.split("?")[0];
          let appendBadges = false;
          
          if(badgeContainer.length == 0) {
            appendBadges = true;
            $(element).find(".snize-thumbnail-wrapper").append(`<div class="product-badges"></div>`);
          }

          collectionBadges.forEach(function(el) {
            let handles = el.product_handles;
            let collection_handles = el.filter_handles;
            
            if(el.type == "collection") {
              if((handles.indexOf(handleA) > -1 || handles.indexOf(handleB) > -1)) {
                if(collection_handles.indexOf(collectionHandle) > -1) {
                  badgeData = el;
                  if(appendBadges) {
                    if(badgeData) {
                      $(element).find(".product-badges").append(`<span class="badge style-${ badgeData.style }" style="color: ${ badgeData.colour }; background: ${ badgeData.background };">${ badgeData.badge }</span>`);
                    }
                  }
                } else {
                  badgeData = null;
                }
              }
            } else {
              if(handles.indexOf(handleA) > -1 || handles.indexOf(handleB) > -1) {
                badgeData = el;
                if(appendBadges) {
                  if(badgeData) {
                    $(element).find(".product-badges").append(`<span class="badge style-${ badgeData.style }" style="color: ${ badgeData.colour }; background: ${ badgeData.background };">${ badgeData.badge }</span>`);
                  }
                }
              }
            }
          });
    
          if( _this.hasClass(`snize-product-tag-${ window.themeOptions.preorder_tag }`)) {
             if(appendBadges) {
              $(element).find(".product-badges").append(`<span class="badge preorder">${ window.themeOptions.preorder_badge }</span>`);
            }
          } else if( _this.hasClass(`snize-product-tag-${ window.themeOptions.sale_tag }`)) {
            if(appendBadges) {
              $(element).find(".product-badges").append(`<span class="badge preorder">${ window.themeOptions.sale_badge }</span>`);
            }
          }

          // Hide B variant
          if(handle.indexOf("-a-") > -1) { $(selector).addClass("hide"); }
        });
      }
    }
  });
  
  observerBody.observe(document.getElementById('theme--custom'), {childList: true, subtree: true });

  // PRODUCT PAGE
  if($("body").data("template").indexOf("product") > -1) {
    let badgeData;
    let lastPage = document.referrer.indexOf("/collections/") > -1 ? document.referrer.split("/collections/")[1].split("?")[0] : document.referrer;
    let handleA = document.location.pathname.split("/products/")[1].split("?")[0].replace("/products/", "");
    let handleB = handleA.indexOf("-a-") > -1 ? handleA.replace("-a-", "-b-") : handleA.replace("-b-", "-a-");
    let handle = handleA;

    collectionBadges.forEach(function(el) {
      let handles = el.product_handles;
      let collection_handles = el.filter_handles;
      if(el.type == "collection") {
        if((handles.indexOf(handleA) > -1 || handles.indexOf(handleB) > -1)) {
          if(collection_handles.indexOf(lastPage) > -1) {
            badgeData = el;
          } else {
            badgeData = null;
          }
        }
      } else {
        if(handles.indexOf(handleA) > -1 || handles.indexOf(handleB) > -1) {
          badgeData = el;
        }
      }
    });

    if(badgeData) {
      let containerClass = badgeData.style == "round" ? ".Product__Slideshow .gallery-badges" : ".ProductMeta .product-badges";
      let container = document.querySelector(containerClass);
      if(container) {
        container.insertAdjacentHTML('beforeend', `<span class="badge style-${ badgeData.style }" style="color: ${ badgeData.color }; background: ${ badgeData.background };">${ badgeData.badge }</span>`);
      }
    }
  }
})();

