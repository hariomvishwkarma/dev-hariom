  /*
   * 2.3 PRODUCT PAGE -->
   * ----------------------------------------------------------------------------------------------------------------------------------
   * Size module event.
   * ----------------------------------------------------------------------------------------------------------------------------------
   */
  sizeModule: function(event) {

    function getData(string, unit) {
      let array = [];
      
      let size = string.split(":");
      let sizeBase;
      let sizeRange;
      if (unit == "mm") {
        sizeBase = parseInt(size[0]);
        sizeRange = size[2].split("-").map(function (x) {   return parseInt(x, 10); });
      } else {
        sizeBase = parseFloat(size[1]);
        sizeRange = size[3].split("-").map(function (x) {   return parseFloat(x, 10); });
      }
      
      let sizeNumber = parseInt(size[size.length - 1]);
      
      array.push(sizeBase, sizeRange, sizeNumber)
      
      return array;
    }
    
    function getValue(value, unit) {
      if (unit == "mm") {
        return parseInt(value);
      } else {
        return parseFloat(value).toFixed(2);
      }
    }
    
    let bestIndex;
    let error;
    let other = "";
    let unit = $('input[name="unit"]:checked').val();
    let $this = $(event.currentTarget);
    let sizeData = $("#size-data").text().replaceAll('[', '').replaceAll(']', '').replaceAll(' ', '').split("+");
    let title = $("#size-title").text();
    let value = getValue($("#sizeValue").val().replaceAll(',', '.'), unit);
    let text = customTheme.strings; // custom--variables.liquid
    
    let recommendedData = {
      "best": {
        "size": "",
        "wiggle": ""
      },
      "lower": {
        "size": "",
        "wiggle": ""
      },
      "higher": {
        "size": "",
        "wiggle": ""
      },
      "smallest": {
        "size": "",
        "fit": ""
      },
      "largest": {
        "size": "",
        "fit": ""
      }
    };
    
    sizeData.forEach(function(element, index) {
      let size = getData(element, unit);
      let wiggleValue;
      
      if( value >= size[1][0] && value <= size[1][1] ) {
        recommendedData.best.size = size[2];
        wiggleValue = size[0] - value;
        recommendedData.best.wiggle = getValue(wiggleValue, unit) + unit;
        bestIndex = index;
        
        if(index > 0 ) {
          let sizeLower = getData(sizeData[index - 1], unit);
          recommendedData.lower.size = sizeLower[2];
          wiggleValue = sizeLower[0] - value;
          recommendedData.lower.wiggle = getValue(wiggleValue, unit) + unit;
        }

        if(index < sizeData.length - 1 ) {
          let sizeHigher = getData(sizeData[index + 1], unit);
          recommendedData.higher.size = sizeHigher[2];
          wiggleValue = sizeHigher[0] - value;
          recommendedData.higher.wiggle = getValue(wiggleValue, unit) + unit;
        }
      }
      
      if( index == 0 ) {
        recommendedData.smallest.size = size[2];
        recommendedData.smallest.fit = size[1][0];
      }
      
      if(index == sizeData.length - 1) {
        recommendedData.largest.size = size[2];
        recommendedData.largest.fit = size[1][1];
      }
    });
    
    if(unit == "in") {
      value = value.replace(/\.([^0]+)0+$/,".$1")
    }
    
    // If size found
    if(recommendedData.best.size != "") {
      if(recommendedData.lower.size != "") {
        other += text.helperNew.replaceAll("{ size }", `${ recommendedData.lower.size }`);
        
        other += text.helperSuccessSmall.replaceAll("{ size }", `${ recommendedData.lower.size }`).replace("{ wiggle }", `${ recommendedData.lower.wiggle }`);
      }

      if(recommendedData.higher.size != "") {
        other += text.helperSuccessLarge.replaceAll("{ size }", `${ recommendedData.higher.size }`).replace("{ wiggle }", `${ recommendedData.higher.wiggle }`);
      }
      
      $("#sizeResult").html(
        text.helperSuccess
        .replaceAll("{ size }", `${ recommendedData.best.size }`)
        .replace("{ input }", `${value}${ unit }`)
        .replace("{ wiggle }", `${ recommendedData.best.wiggle }`) + other
      );
    } else {
      error = recommendedData.smallest.fit > value ? 
        text.helperFailureSmall.replaceAll("{ size }", recommendedData.smallest.fit + unit) : 
        text.helperFailureLarge.replaceAll("{ size }", recommendedData.largest.fit + unit);
      
      $("#sizeResult").html(text.helperFailure.replace("{ title }", `${ title }`) + error);
    }
  },
    
