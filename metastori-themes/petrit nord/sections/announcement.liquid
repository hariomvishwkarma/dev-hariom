{% assign ss = section.settings %}
{% assign show_topbar = true %}
{% assign content = "" %}

{% assign show_default_content = false %}
{% if ss.content != blank or ss.content_2 != blank or ss.content_3 != blank %}
  {% assign show_default_content = true %}
{% endif %}

{% assign show_selected_content = false %}
{% for block in section.blocks %}
  {% assign bs = block.settings %}
  {% if page.handle == bs.page %}
    {% assign content = bs.content %}
    {% capture content %}
      {% assign content_size = 0 %}
      {% if bs.content != blank %}
        {% assign content_size = content_size | plus: 1 %}
        <div class="swiper-slide">{{ bs.content | replace: "<a", "<a data-utm" }}</div>
      {% endif %}
      {% if bs.content_2 != blank %}
        {% assign content_size = content_size | plus: 1 %}
        <div class="swiper-slide">{{ bs.content_2 | replace: "<a", "<a data-utm" }}</div>
      {% endif %}
      {% if bs.content_3 != blank %}
        {% assign content_size = content_size | plus: 1 %}
        <div class="swiper-slide">{{ bs.content_3 | replace: "<a", "<a data-utm" }}</div>
      {% endif %}
    {% endcapture %}
    {% assign show_selected_content = true %}
  {% endif %}
{% endfor %}

{%- if section.settings.selected_page_only == false -%}
  {% capture content %}
    {% assign content_size = 0 %}
    {% if ss.content != blank %}
      {% assign content_size = content_size | plus: 1 %}
      <div class="swiper-slide">{{ ss.content | replace: "<a", "<a data-utm" }}</div>
    {% endif %}
    {% if ss.content_2 != blank %}
      {% assign content_size = content_size | plus: 1 %}
      <div class="swiper-slide">{{ ss.content_2 | replace: "<a", "<a data-utm" }}</div>
    {% endif %}
    {% if ss.content_3 != blank %}
      {% assign content_size = content_size | plus: 1 %}
      <div class="swiper-slide">{{ ss.content_3 | replace: "<a", "<a data-utm" }}</div>
    {% endif %}
  {% endcapture %}
{% endif %}

{% if show_selected_content == false and show_default_content %}
  {% capture content %}
    {% assign content_size = 0 %}

    {% if ss.content != blank %}
      {% assign content_size = content_size | plus: 1 %}
      <div class="swiper-slide">{{ ss.content | replace: "<a", "<a data-utm" }}</div>
    {% endif %}
    {% if ss.content_2 != blank %}
      {% assign content_size = content_size | plus: 1 %}
      <div class="swiper-slide">{{ ss.content_2 | replace: "<a", "<a data-utm" }}</div>
    {% endif %}
    {% if ss.content_3 != blank %}
      {% assign content_size = content_size | plus: 1 %}
      <div class="swiper-slide">{{ ss.content_3 | replace: "<a", "<a data-utm" }}</div>
    {% endif %}
  {% endcapture %}
{% endif %}

{%- if section.settings.enable_bar == false -%}
  {% assign show_topbar = false %}
{% endif %}

{%- if section.settings.home_page_only and template != 'index' -%}
  {% assign show_topbar = false %}
{% endif %}

{%- if section.settings.selected_page_only and show_selected_content != true -%}
  {% assign show_topbar = false %}
{% endif %}

{% if show_selected_content == false and show_default_content %}
  {% assign show_topbar = true %}
{% endif %}

{%- if show_topbar -%}
  <section id="section-{{ section.id }}" data-section-id="{{ section.id }}" data-section-type="announcement-bar">
    <div class="AnnouncementBar">
      <div class="AnnouncementBar__Wrapper">
        <div class="AnnouncementBar__Content">
          <div class="announcement-text page-announcement">
            <div class="swiper {% if content_size < 2 %}swiper--disabled{% endif %}">
              <div class="swiper-wrapper">
                {{ content }}
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>
{%- endif -%}

{% unless show_topbar %}
  <script>
    document.documentElement.style.setProperty('--announcement-bar-height', '0px');
  </script>
{% else %}
  <script>
    document.documentElement.style.setProperty('--announcement-bar-height', document.querySelector('.shopify-section--announcement').offsetHeight + 'px');
  </script>
  <style>
    #section-{{ section.id }} {
      background: {{ section.settings.background }};
      color: {{ section.settings.text_color }};
    }
    
    #section-{{ section.id }} .announcement-text p {
      color: {{ section.settings.text_color }};
    }
  </style>
{% endunless %}

{% schema %}
{
  "name": "Announcement bar",
  "class": "shopify-section--announcement",
  "enabled_on": {
    "groups": ["header"]
  },
  "settings": [
    {
      "type": "richtext",
      "id": "content",
      "label": "Text 1"
    },
    {
      "type": "richtext",
      "id": "content_2",
      "label": "Text 2"
    },
    {
      "type": "richtext",
      "id": "content_3",
      "label": "Text 3"
    },
    {
      "type": "header",
      "content": "Section settings"
    },
    {
      "type": "checkbox",
      "id": "enable_bar",
      "label": "Enable bar",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "home_page_only",
      "label": "Home page only",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "selected_page_only",
      "label": "Selected pages only",
      "default": false
    },
    {
      "type": "color",
      "id": "background",
      "label": "Background",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text",
      "default": "#ffffff"
    }
  ],
  "blocks": [
    {
      "type": "page_bar",
      "name": "Page topbar",
      "settings": [
        {
          "label": "Page",
          "id": "page",
          "type": "page"
        },  
        {
          "type": "richtext",
          "id": "content",
          "label": "Text 1"
        },
        {
          "type": "richtext",
          "id": "content_2",
          "label": "Text 2"
        },
        {
          "type": "richtext",
          "id": "content_3",
          "label": "Text 3"
        }
      ]
    }
  ]
}
{% endschema %}