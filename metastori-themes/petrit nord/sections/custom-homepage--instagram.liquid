{% assign ss = section.settings %}

{%- capture container_class -%}
  {%- case ss.width -%}
    {%- when 'default' -%}
	container
    {%- when 'full' -%}
	container--full
    {%- when 'wide' -%}
	container--wide
  {%- endcase -%}
{%- endcapture -%}

{%- capture flickity_options -%}
{
  "prevNextButtons": false,
  "adaptiveHeight": false,
  "wrapAround": true,
  "dragThreshold": 15,
  "autoPlay": true,
"freeScroll": true,
  "contain": true, 
  "cellAlign": "center",
  "pageDots": false
}
{%- endcapture -%}

<section id="section--{{ section.id }}" data-section="instagram" style="background-color: {{ ss.section_background }};" class="index-section section--wrapper margin-bottom--{{ ss.section_margin | remove: "." }} padding--{{ ss.section_padding | remove: "." }}">
  <div class="{{ container_class }}">
    <div style="background-color: {{ ss.content_background }}; color: {{ ss.content_text }};" class="section--inner padding--{{ ss.content_padding | remove: "." }}">
      <div class="section-content">
        
        {% if ss.heading %}
          <span style="color: {{ section.settings.content_accent }};" class="accent--text">
            <div><span class="text">{{ ss.heading }}</span></div>
          </span>
        {% endif %}
        
        <div class="main-carousel custom--carousel padding--{{ ss.slider_padding | remove: "." }}"  data-flickity='{{ flickity_options }}'>
          
          {% for block in section.blocks %}
            <div class="carousel-cell">
              <a href="{{ ss.url }}" class="cell--inner {{ block.settings.style }}">
                <div class="image--wrapper top">
                  <img class="Image--lazyLoad" {% include "img_attr", image: block.settings.image_1 , size: 600 %}>
                </div>
                <div class="image--wrapper bottom">
                  <img class="Image--lazyLoad" {% include "img_attr", image: block.settings.image_2, size: 600  %}>
                </div>
              </a>
          </div>
          {% endfor %}
        </div>
      </div>
    </div>
  </div>
</section>

{% schema %}
  {
    "name": "Instagram",
    "settings": [

      {
        "type": "header",
        "content": "Content"
      },

      {
        "label": "URL",
        "id": "url",
        "type": "url"
      },


      {
        "label": "Heading",
        "id": "heading",
        "type": "text"
      },

      {
        "type": "header",
        "content": "Colours"
      },
      {
        "type": "color",
        "id": "section_background",
        "label": "Section Background"
      },
      {
        "type": "color",
        "id": "content_background",
        "label": "Content Background"
      },
      {
        "type": "color",
        "id": "content_text",
        "label": "Content Text"
      },
      {
        "type": "color",
        "id": "content_accent",
        "label": "Accent"
      },
      {
        "type": "header",
        "content": "Spacing"
      },
      {
         "type":      "radio",
         "id":        "width",
         "label":     "Width:",
         "options": [
           { "value": "default", "label": "Default" },
           { "value": "wide", "label": "Wide" },
           { "value": "full", "label": "Full" },
           { "value": "full_with", "label": "Full with padding" }
         ],
        "default":   "default"
      },
      {
        "type": "range",
        "id": "section_margin",
        "label": "Section Margin: Bottom",
        "min": 0,
        "max": 5,
        "step": 0.5,
        "default": 0
      },
      {
        "type": "range",
        "id": "section_padding",
        "label": "Section Padding: Top/Bottom",
        "min": 0,
        "max": 5,
        "step": 0.5,
        "default": 0
      },
      {
        "type": "range",
        "id": "content_padding",
        "label": "Content Padding: All",
        "min": 0,
        "max": 5,
        "step": 0.5,
        "default": 0
      }
	],
    "blocks": [
      {
        "type": "slide",
        "name": "Slide",
        "settings": [
          {
             "type":      "radio",
             "id":        "style",
             "label":     "Style:",
             "options": [
               { "value": "full", "label": "1/0" },
               { "value": "big-small", "label": "2/1" },
               { "value": "small-big", "label": "1/2" },
               { "value": "small-small", "label": "1/1" }
             ],
            "default":   "full"
          },

          {
            "label": "Image 1",
            "id": "image_1",
            "type": "image_picker"
          },
          {
            "label": "Image 2",
            "id": "image_2",
            "type": "image_picker"
          }
        ]
      }
    ],
    "presets": [
      {
        "name": "Instagram",
        "category": "Custom Sections"
      }
    ]
  }
{% endschema %}