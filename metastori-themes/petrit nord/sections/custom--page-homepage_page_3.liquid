<div class="homepage-sections"> 
  {% include "homepage-sections2", blocks: section.blocks, ss: section.settings %}
</div>

<script>
  const elementHeight = (event) => {
    document.querySelectorAll("[data-height], [data-height2]").forEach((el) => { 

      let attr = el.getAttribute("data-height") != null ? "data-height" : "data-height2";
      let title = attr == "data-height" ? "--element_height" : "--element_height2";
      let divider = parseFloat(el.getAttribute(attr));
  
      if(divider) {
        el.closest(".section--wrapper").style.setProperty(title, (el.clientHeight * divider) + 'px');
        el.closest(".section--wrapper").classList.add("responsive--svg");
      } else {
        el.closest(".section--wrapper").style.setProperty(title, (el.clientHeight) + 'px');
      }

      el.closest(".section--wrapper").classList.add("height--set");
    });
  }
  elementHeight();
  window.addEventListener("resize", elementHeight);
  window.addEventListener("load", elementHeight);
</script>

{% if section.settings.background %}
  <style>
    #theme--custom {
      background: {{ section.settings.background }};
    }
    .color3 {
      fill: {{ section.settings.background }} !important;
    }
  </style>
{% endif %}

