{% style %}
  {% for block in section.blocks %}
    {% assign ss = block.settings %}
    #section--{{ block.id }} {
      {%- if ss.section_background != blank -%}--section-background: {{ ss.section_background }};{%- endif -%}
      {%- if ss.section_background2 != blank -%}--section-background2: {{ ss.section_background2 }};{%- endif -%}
      {%- if ss.section_padding != blank -%}--section-padding: {{ ss.section_padding }}rem;{%- endif -%}
      {%- if ss.section_margin != blank -%}--section-margin: {{ ss.section_margin }}rem;{%- endif %} 
      {%- if ss.content_background != blank -%}--section-content-background: {{ ss.content_background }};{%- endif -%}
      {%- if ss.content_background2 != blank -%}--section-content-background2: {{ ss.content_background2 }};{%- endif -%}
      {%- if ss.content_padding != blank -%}--section-content-padding: {{ ss.content_padding }}rem;{%- endif -%}  
      {%- if ss.content_text != blank -%}--section-content-colour: {{ ss.content_text }};{%- endif %}
      {%- if ss.content_text2 != blank -%}--section-content-colour2: {{ ss.content_text2 }};{%- endif %}
      {%- if ss.content_text3 != blank -%}--section-content-colour3: {{ ss.content_text3 }};{%- endif %}
      {%- if ss.content_accent != blank -%}--section-content-accent: {{ ss.content_accent }};{%- endif -%}
      {%- if ss.mobile_mod != blank -%}--section-mobile-modifier: {{ ss.mobile_mod }};{%- endif -%}
      {%- if ss.button_text != blank -%}--section-button-text: {{ ss.button_text }};{%- endif %}
      {%- if ss.button_background != blank -%}--section-button-background: {{ ss.button_background }};{%- endif %}
      {%- if ss.side != default -%}--section-side: url(#{{ ss.side }});{%- endif %}
      {%- if ss.background != default -%}--section-background-image: url({{ ss.background | img_url: "master" }});{%- endif %}
    }
  {% endfor %}
{% endstyle %}