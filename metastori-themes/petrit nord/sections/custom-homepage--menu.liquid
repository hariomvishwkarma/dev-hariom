{% assign ss = section.settings %}

{% capture section_classes %}
  {% if ss.desktop %}hide--tablet-up{% endif %}
  {% if ss.mobile %}hide--tablet-down{% endif %}
  {% if ss.mirror %}style--mirror{% endif %}
{% endcapture %}

{%- capture section_style -%}
  {% if ss.section_background_image != blank %}background-image: linear-gradient(rgba(34, 44, 38, 0.55), rgba(34, 44, 38, 0.55)), url({{ ss.section_background_image | img_url: "1500x" }});{% endif %}
  {% if ss.section_background != blank %}background-color: {{ ss.section_background }};{% endif %}
  {% if ss.section_padding != blank %}--section-padding: {{ ss.section_padding }}rem;{% endif %}
  {% if ss.section_margin != blank %}--section-margin: {{ ss.section_margin }}rem;{% endif %} 
  {% if ss.section_background != blank %}--section-background: {{ ss.section_background }};{% endif %}  
  {% if ss.content_padding != blank %}--content-padding: {{ ss.content_padding }}rem;{% endif %} 
  {% if ss.content_margin != blank %}--content-margin: {{ ss.content_margin }}rem;{% endif %} 
  {% if ss.content_background != blank %}--content-background: {{ ss.content_background }};{% endif %}
  {% if ss.content_text != blank %}--content-colour: {{ ss.content_text }};{% endif %}
  {% if ss.content_accent != blank %}--content-accent: {{ ss.content_accent }};{% endif %}
{%- endcapture -%}

{% if ss.header_background != blank %}
<style>
  body:not(.scroll--active) .shopify-section--header #section-header .Header__Wrapper {
    background-color: {{ ss.header_background }};
    color: {{ ss.content_text }};
  }

  body:not(.scroll--active) .shopify-section--header #section-header .HorizontalList__Item >  .Heading {
    color: {{ ss.content_text }};
  }

  body:not(.scroll--active) .shopify-section--header #section-header .Header__Icon svg {
    color: {{ ss.content_text }};
  }
</style>
{% endif %}

<style>
  .shopify-section--header #section-header:not(.scroll--active) .Header__Wrapper:hover .Header__LogoImage--primary:not(.hide) {
    display: block!important;
    opacity: 1;
  }
  
  .shopify-section--header #section-header:not(.scroll--active) .Header__Wrapper:hover .Header__LogoImage--transparent {
    display: none!important;
  }

  .CollectionToolbar__LayoutType.is-active, .supports-sticky .Search[aria-hidden=true]+.Header--transparent .Header__LogoImage--transparent {
    opacity: 0;
  }
  
  .supports-sticky .Search[aria-hidden=true]+.Header--transparent .Header__LogoImage--primary:not(:only-child) {
    opacity: 1;
  }
  
  #theme--custom .shopify-section--header {
    margin: 0;
  }

  
</style>

<section id="section--{{ section.id }}" data-section="homepage_submenu" style="{{ section_style | remove: " " | strip_newlines }}" class="index-section page-section section--wrapper {{ section_classes }}">
  <div class="container--full_width">
    <div style="background-color: {{ ss.content_background }}; color: {{ ss.content_text }};" class="section--inner">
      <div class="section-content">
        <div class="content--wrapper">
  
          {% if ss.subheading != blank %}
          <div>
            <h3><span>{{ ss.subheading }}</span></h3>
          </div>
          {% endif %}
          
          {% if ss.slider %}
          <div class="swiper">
            <div class="swiper-wrapper">
              {% for block in section.blocks %}
                {% assign bs = block.settings %}
                    <div class="swiper-slide">
                      <a href="{{ bs.collection.url }}">
                        <div class="image--wrapper">
                            <img class="Image--lazyLoad" data-src="{{ bs.image | img_url: "250x" }}">
                        </div>

                        <div class="text--wrapper">
                          {% if bs.title != blank %}
                          <span>{{ bs.title }}</span>
                          {% else %}
                          <span>{{ bs.collection.title }}</span>
                          {% endif %}
                        </div>
                      </a>
                    </div>
              {% endfor %}
            </div>
            <div class="swiper-scrollbar"></div>
          </div>
          
          <style>
            #section--{{ section.id }} .swiper {
              width: auto;
            }
            
            #section--{{ section.id }} .swiper-slide {
              width: auto;
            }
            
    		@media only screen and (min-width: {{ ss.slider_width | plus: 115 }}px) {
              #section--{{ section.id }} .swiper-wrapper {            
                max-width: {{ ss.slider_width }}px;
                overflow: hidden;
                transform: none !important;
              }
            }

            @media only screen and (max-width: {{ ss.slider_width | times: 1 | plus: 86 }}px ) {
              #section--{{ section.id }} .swiper-wrapper { 
/*                 max-width: {{ ss.slider_width | times: 1 | minus: 86 }}px; */
              }
            }
            
            
            @media only screen and (max-width: 480px ) {
              #section--{{ section.id }} .swiper-wrapper { 
                max-width: calc(100vw - 40px);
              }
            }
            
          </style>
          
          <script>
            
            if (window.top!=window.self) {
              document.querySelector("body").classList.add("within-iframe");
            }
            
            new Swiper('#section--{{ section.id }} .swiper', {
              loop: false,
              slidesPerView: "auto",
              spaceBetween: 0,
              freeMode: true,
              scrollbar: {
                el: '.swiper-scrollbar',
              }
            });
          </script>
          {% else %}
          <div class="list--wrapper">
            <ul>
              {% for block in section.blocks %}
                {% assign bs = block.settings %}
                    <li>
                      <a href="{{ bs.collection.url }}">
                        <div class="image--wrapper">
                            <img class="Image--lazyLoad" data-src="{{ bs.image | img_url: "250x" }}">
                        </div>

                        <div class="text--wrapper">
                          {% if bs.title != blank %}
                          <span>{{ bs.title }}</span>
                          {% else %}
                          <span>{{ bs.collection.title }}</span>
                          {% endif %}
                        </div>
                      </a>
                    </li>
              {% endfor %}
            </ul>
          </div>
          {% endif %}


          
        </div>
      </div>
    </div>
  </div>
</section>

{% schema %}
  {
    "name": "Custom: Homepage submenu",
    "settings": [
          {
            "type": "checkbox",
            "id": "desktop",
            "default": false,
            "label": "Hide on desktop"
          },
          {
            "type": "checkbox",
            "id": "mobile",
            "default": false,
            "label": "Hide on mobile"
          },
          {
            "type": "checkbox",
            "id": "slider",
            "default": false,
            "label": "Slider"
          },
          {
            "label": "Subheading",
            "id": "subheading",
            "type": "text"
          },
          {
            "type": "number",
            "id": "slider_width",
            "label": "Slider Width",
            "default": 0
          },
          {
            "type": "header",
            "content": "Colours"
          },
          {
            "type": "color",
            "id": "section_background",
            "label": "Section Background"
          },
          {
            "type": "color",
            "id": "header_background",
            "label": "Header Background"
          },
          {
            "type": "color",
            "id": "content_background",
            "label": "Content Background"
          },
          {
            "type": "color",
            "id": "content_text",
            "label": "Content Text"
          },
          {
            "type": "color",
            "id": "content_accent",
            "label": "Accent"
          },
          {
            "type": "header",
            "content": "Spacing"
          },
          {
            "type": "range",
            "id": "custom_width",
            "label": "Custom section width",
            "min": 800,
            "max": 1600,
            "step": 10,
            "default": 800
          },
          {
            "type": "range",
            "id": "section_margin",
            "label": "Section Margin: Bottom",
            "min": -10,
            "max": 10,
            "step": 0.5,
            "default": 0
          },
          {
            "type": "range",
            "id": "section_padding",
            "label": "Section Padding: Top/Bottom",
            "min": 0,
            "max": 5,
            "step": 0.5,
            "default": 0
          },
          {
            "type": "range",
            "id": "content_padding",
            "label": "Content Padding: All",
            "min": 0,
            "max": 5,
            "step": 0.5,
            "default": 0
          }
	],
    "blocks": [
      {
        "type": "link",
        "name": "Link",
        "settings": [
          {
            "label": "Icon",
            "id": "image",
            "type": "image_picker"
          },
          {
            "label": "Title",
            "id": "title",
            "type": "text"
          },
          {
            "label": "Collection",
            "id": "collection",
            "type": "collection"
          }
        ]
      }
    ],
    "presets": [
      {
        "name": "Custom: Homepage submenu",
        "category": "Custom Sections"
      }
    ]
  }
{% endschema %}
