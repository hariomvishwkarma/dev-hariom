{% assign handles = section.settings.handles | split: "," %}
{% assign show_section = true %}
{% for handle in handles %}
{% if request.path contains handle  %}
  {% assign show_section = false %}
{% endif %}
{% endfor %}

{% if template contains "landing_page"  %}
  {% assign show_section = false %}
{% endif %}

{% if section.settings.show_section  %}
  {% else %}
  {% assign show_section = false %}
{% endif %}

{% if show_section %}
<style>
  @media screen and (min-width: 720px) {
    #popup-{{ section.id }} {
      font-size: {{ section.settings.section_scale_desktop }}px !important;
    }
  }
  
  @media screen and (max-width: 720px) {
    #popup-{{ section.id }} {
      font-size: {{ section.settings.section_scale_mobile }}px !important;
    }
  
    #popup-{{ section.id }} .image {
      min-height: {{ section.settings.image_height_tablet }}px !important;
    }
  }
  
  @media screen and (max-width: 480px) {
  
    #popup-{{ section.id }} .image {
      min-height: {{ section.settings.image_height_mobile }}px !important;
    }
  }
</style>
  
<div id="popup-{{ section.id }}" class="modal--container modal--fixed" data-modal="landing_popup">

  <div class="modal--wrapper" style=" position: relative; ">
    <div style="background: {{ section.settings.content_background }}; color: {{ section.settings.content_text }};" class="modal--inner">
      <div>
  <div class="logo--wrapper">
    <img src="https://petitnord.com/cdn/shop/files/PETITNORD_S__524038-kopi_140x.png?v=1629265191" />
  </div>
      <div class="text">
  
        {% if settings.compaign %}
          
          <h3>{{ section.settings.text2 }}</h3>
          <h4>{{ section.settings.text22 }}</h4>
          <div class="text--wrapper">{{ section.settings.text23 }}</div>
          <div class="html--wrapper">
            {{ section.settings.text24 }}
          </div>
  
          <div class="button--wrapper">
            <a class="landingpage--button button--default" href="{{ section.settings.url2 }}" data-utm>{{ section.settings.button2 }}</a>
          </div>
      
        {% else %}  
          <h3>{{ section.settings.text1 }}</h3>
          <h4>{{ section.settings.text12 }}</h4>
          <div class="text--wrapper">{{ section.settings.text13 }}</div>
          <div class="html--wrapper">
            {{ section.settings.text14 }}
          </div>
  
          <div class="button--wrapper">
            <a class="landingpage--button button--default" href="{{ section.settings.url1 }}" data-utm>{{ section.settings.button1 }}</a>
          </div>
        {% endif %}
      </div>
        </div>
      
        {% if settings.compaign %}
      <div class="image" style="background-image: url({{ section.settings.image2 | img_url: "500x" }});"> </div>
      
        {% else %}  
      <div class="image" style="background-image: url({{ section.settings.image1 | img_url: "500x" }});"> </div>
        {% endif %}

    </div>
          
      <button type="button" class="modal-close js-modal-close">
        <svg role="img" width="35" height="35" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg" aria-describedby="close-form" class="needsclick  kl-private-reset-css-Xuajs1"><title id="close-form">Close form</title><circle cx="10" cy="10" r="9.5" fill="#959676" stroke="rgba(255,255,255,0)" style="cursor: pointer;"></circle><path d="M6 6L14 14M6 14L14 6L6 14Z" stroke="#ffffff" stroke-width="1" stroke-linecap="round" stroke-linejoin="round" style="cursor: pointer;"></path></svg>
      </button>
  </div>
</div>

<script>
  let popupCookie = Cookies.get("landing_popup");
  if(!popupCookie) {
    setTimeout(function() {
      $("#popup-{{ section.id }}").addClass("is-active");
    }, 15000);
  }

  document.querySelector("[data-modal='landing_popup'] .js-modal-close").addEventListener("click", function() {
    document.querySelector("[data-modal='landing_popup']").classList.remove("is-active");
    Cookies.set("landing_popup", location.href, { expires: 10 });
  });
</script>
  
{% endif %}

