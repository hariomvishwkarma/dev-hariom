{% assign ss = section.settings %}

{%- capture section_style -%}
  {% if ss.section_background_image != blank %}background-image: linear-gradient(rgba(34, 44, 38, 0.55), rgba(34, 44, 38, 0.55)), url({{ ss.section_background_image | img_url: "1500x" }});{% endif %}
  {% if ss.section_background != blank %}background-color: {{ ss.section_background }};{% endif %}
  {% if ss.section_padding != blank %}--section-padding: {{ ss.section_padding }}rem;{% endif %}
  {% if ss.section_margin != blank %}--section-margin: {{ ss.section_margin }}rem;{% endif %} 
  {% if ss.section_background != blank %}--section-background: {{ ss.section_background }};{% endif %}  
  {% if ss.content_padding != blank %}--content-padding: {{ ss.content_padding }}rem;{% endif %} 
  {% if ss.content_margin != blank %}--content-margin: {{ ss.content_margin }}rem;{% endif %} 
  {% if ss.content_background != blank %}--content-background: {{ ss.content_background }};{% endif %}
  {% if ss.content_text != blank %}--content-colour: {{ ss.content_text }};{% endif %}
  {% if ss.content_accent != blank %}--content-accent: {{ ss.content_accent }};{% endif %}
  {%- if ss.mobile_mod != blank -%}--section-mobile-modifier: {{ ss.mobile_mod }};{%- endif -%}
  {%- if ss.button_text != blank -%}--section-button-text: {{ ss.button_text }};{%- endif %}
  {%- if ss.button_background != blank -%}--section-button-background: {{ ss.button_background }};{%- endif %}
{%- endcapture -%}

<section id="section--{{ section.id }}" data-section="homepage_featured_reviews" style="{{ section_style | remove: " " | strip_newlines }}" class="index-section section--wrapper section--updated">
  <div class="container--{{ ss.width }}">
    <div style="background-color: {{ ss.content_background }}; color: {{ ss.content_text }};" class="section--inner">
      <div class="section-content">
        <div class="content--wrapper">
          {% if ss.subheading != blank or ss.heading != blank %}
            <div {% if ss.text_width != 0 %}style="max-width: {{ ss.text_width }}px; margin-left: auto; margin-right: auto;"{% endif %} class="section-header text--center">
              <h2><span>{{ ss.heading }}</span></h2>
              <h3><span>{{ ss.subheading }}</span></h3>
            </div>
          {% endif %}
          
          <div class="swiper">
            <div class="swiper-wrapper">
              {%- for block in section.blocks -%}
                  <div class="swiper-slide">
                    <{% if block.settings.product != blank %}a href="{{ block.settings.product }}"{% else %}div{% endif %} class="review">
                      <div class="item--inner">
                        <div>
                          <div class="image--wrapper"><img src="{{ block.settings.image | img_url: "300x" }}"/></div>
                        </div>
                        <div class="content">
                          <div class="heading">{{ block.settings.heading }}</div>
                          <div class="text">{{ block.settings.text }}</div>
                          <div class="rating">
                            <div class="stars">
                              {% for i in (1..5) %}
                              <span class="star"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24"> <path fill="none" d="M0 0h24v24H0z"/> <path fill="none" d="M0 0h24v24H0z"/> <path d="m12 17.3 6.2 3.7-1.7-7L22 9.2l-7.2-.6L12 2 9.2 8.6 2 9.2 7.5 14l-1.7 7z"/> </svg></span>
                              {% endfor %}  
                            </div>
                            <div class="name">{{ block.settings.label }}</div>
                          </div>
                        </div>
                      </div>
                    </{% if block.settings.product != blank %}a{% else %}div{% endif %}>
                  </div>
              {% endfor %}
            </div>
          </div>
                                
          <div class="swiper-pagination"></div>
          
        </div>
      </div>
    </div>
  </div>
</section>

{% schema %}
  {
    "name": "Custom: featured reviews",
    "settings": [
          {
            "label": "Heading",
            "id": "heading",
            "type": "text"
          },
          {
            "label": "Subheading",
            "id": "subheading",
            "type": "text"
          },
          {
            "type": "header",
            "content": "Colours"
          },
          {
            "type": "color",
            "id": "section_background",
            "label": "Section Background"
          },
          {
            "type": "color",
            "id": "content_background",
            "label": "Content Background"
          },
          {
            "type": "color",
            "id": "content_text",
            "label": "Content Text"
          },
          {
            "type": "color",
            "id": "content_accent",
            "label": "Accent"
          },
          {
            "type": "color",
            "id": "button_text",
            "label": "Button: Text"
          },
          {
            "type": "color",
            "id": "button_background",
            "label": "Button: Background"
          }, 
          {
            "type": "header",
            "content": "Spacing"
          },
          {
             "type":      "select",
             "id":        "width",
             "label":     "Width: Section",
             "options": [
               { "value": "default", "label": "Default" },
               { "value": "wide", "label": "Wide" },
               { "value": "padding", "label": "Padding" },
               { "value": "full", "label": "Full" }
             ],
            "default":   "default"
          },
          {
            "type": "range",
            "id": "text_width",
            "label": "Text: Max width",
            "min": 0,
            "max": 1000,
            "step": 25,
            "default": 0
          },
          {
            "type": "range",
            "id": "section_margin",
            "label": "Section Margin: Bottom",
            "min": -10,
            "max": 10,
            "step": 0.5,
            "default": 0
          },
          {
            "type": "range",
            "id": "section_padding",
            "label": "Section Padding: Top/Bottom",
            "min": 0,
            "max": 10,
            "step": 0.5,
            "default": 0
          },
          {
            "type": "range",
            "id": "content_padding",
            "label": "Content Padding: All",
            "min": 0,
            "max": 10,
            "step": 0.5,
            "default": 0
          },
          {
            "type": "range",
            "id": "mobile_mod",
            "label": "Mobile Modifier",
            "min": 1,
            "max": 5,
            "step": 0.1,
            "default": 2
          }
	],
    "blocks": [
      {
        "type": "review",
        "name": "Review",
        "settings": [
          {
            "type": "product",
            "id": "product",
            "label": "Product"
          },
          {
            "type": "image_picker",
            "id": "image",
            "label": "Image"
          },
          {
            "type": "richtext",
            "id": "heading",
            "label": "Heading"
          },
          {
            "type": "richtext",
            "id": "text",
            "label": "Text"
          },
          {
            "type": "richtext",
            "id": "label",
            "label": "Label"
          }
        ]
      }
    ],
    "presets": [
      {
        "name": "Custom: featured reviews",
        "category": "Custom Sections"
      }
    ]
  }
{% endschema %}
