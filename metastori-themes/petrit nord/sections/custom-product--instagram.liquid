        or block.settings.product_titles contains "Mini Bootie Lace" 
        or block.settings.product_titles contains "Everyday shoe Lace" 
        or block.settings.product_titles contains "Everyday shoe Velcro" 
        or block.settings.product_titles contains "Charleston T-Bar" 
        or block.settings.product_titles contains "Winter Bootie" 
        or block.settings.product_titles contains "Toasty Bootie" 
        or block.settings.product_titles contains "Sneaker Bootie" 
        or block.settings.product_titles contains "Scallop Velcro Boot" 
      %}
                {% assign bs = block.settings %}
      

                {% for i in (1..10) %}
                  {% assign image = "image_" | append: i %}
                  
                  <img src="{{ block.settings[image] | img_url: "master" }}">

                  
                {% endfor %}
              <hr>
        {% endif %}
        {% endif %}
            {% endfor %}



  
  {% else %}
{% assign ss = section.settings %}

{%- capture container_class -%}
  {%- case ss.width -%}
    {%- when 'default' -%}
	container--product
    {%- when 'full' -%}
	container--full
    {%- when 'wide' -%}
	container--wide
  {%- endcase -%}
{%- endcapture -%}

{%- capture flickity_options -%}
{
  "prevNextButtons": false,
  "adaptiveHeight": false,
  "wrapAround": true,
  "dragThreshold": 15,
  "autoPlay": true,
  "freeScroll": true,
  "contain": true, 
  "cellAlign": "center",
  "pageDots": false
}
{%- endcapture -%}

{% if product == blank %}
  {% assign handle = page.content | strip_html | strip | handleize | strip_newlines -%}
  {% assign product = all_products[handle] %}
{% endif %}

{% assign gallery = product.metafields.lifestyle %}

{% assign break = false %}
{% assign customize_gallery = false %}
{% assign customize_gallery_images = false %}
{% assign customize_gallery_size = 0 %}
{% assign customize_gallery_index = 0 %}
{% assign collection_gallery_size = 0 %}

{% for block in section.blocks %}
  {% if block.type == "gallery" %}
	{% comment %}Check if gallery filter contains product collection{% endcomment %}

	{% assign temp_handle = product.title | prepend: "[" | append: "]" %}
	{% if block.settings.product_titles contains temp_handle %}
		{% assign customize_gallery = true %}
		{% assign customize_gallery_index = forloop.index %}
		{% assign customize_gallery_images = block.settings %}
		{% for i in (1..10) %}
		  {% assign field = "image_" | append: forloop.index %}
          {% if block.settings[field] != blank %}
			{% assign customize_gallery_size = customize_gallery_size | plus: 1 %}
          {% endif %}
		{% endfor %}
	{% endif %}

	{% if collection_exist != true %}
      {% assign collection_exist = false %}
      {% for collection in product.collections %}

          {% assign temp_handle = collection.title | prepend: "[" | append: "]" %}
          {% if block.settings.collection_titles contains temp_handle %}
              {% assign collection_exist = true %}
              {% assign featured_collection = collection %}

              {% assign collection_gallery_images = block.settings %}
              {% for i in (1..10) %}
                {% assign field = "image_" | append: forloop.index %}
                {% if block.settings[field] != blank %}
                  {% assign collection_gallery_size = collection_gallery_size | plus: 1 %}
                {% endif %}
              {% endfor %}
          {% endif %}
      {% endfor %}
	{% endif %}
  {% endif %}
{% endfor %}

{% if customize_gallery_images != blank %}
	{% assign collection_gallery_images = false %}
{% endif %}

{% if gallery != blank %}
	{% assign customize_gallery_images = false %}
	{% assign collection_gallery_images = false %}
{% endif %}

{% assign min_size = 0 %}
{% for block in section.blocks %}
{% assign bs = block.settings %}
  {% if block.type == "layout" %}
	{% assign custom_index = 1 %}
    {% if block.settings.number == product.metafields.my_fields.lifestyle_style %}
		{% for i in (1..4) %}
			{% assign field = "collumn_" | append: custom_index %}

			{% if bs[field] == "full" %}
				{% assign min_size = min_size | plus: 1 %}
			{% else %}
				{% assign min_size = min_size | plus: 2 %}
			{% endif %}

			{% assign custom_index = custom_index | plus: 1 %}
		{% endfor %}
    {% endif %}
    {% if block.settings.number == customize_gallery_images.number %}
		{% for i in (1..4) %}
			{% assign field = "collumn_" | append: custom_index %}

			{% if bs[field] == "full" %}
				{% assign min_size = min_size | plus: 1 %}
			{% else %}
				{% assign min_size = min_size | plus: 2 %}
			{% endif %}

			{% assign custom_index = custom_index | plus: 1 %}
		{% endfor %}
    {% endif %}
    {% if block.settings.number == collection_gallery_images.number %}
		{% for i in (1..4) %}
			{% assign field = "collumn_" | append: custom_index %}

			{% if bs[field] == "full" %}
				{% assign min_size = min_size | plus: 1 %}
			{% else %}
				{% assign min_size = min_size | plus: 2 %}
			{% endif %}

			{% assign custom_index = custom_index | plus: 1 %}
		{% endfor %}
    {% endif %}
  {% endif %}
{% endfor %}

{% assign min_size = min_size | plus: 1 %}

<section id="section--{{ section.id }}" data-section="instagram" style="background-color: {{ ss.section_background }};" class="index-section section--wrapper margin-bottom--{{ ss.section_margin | remove: "." }} padding--{{ ss.section_padding | remove: "." }}">
  <div class="{{ container_class }}">
    <div style="background-color: {{ ss.content_background }}; color: {{ ss.content_text }};" class="section--inner padding--{{ ss.content_padding | remove: "." }}">
      <div class="section-content">
        {% if ss.heading %}
          <span style="color: {{ section.settings.content_accent }};" class="accent--text">
            <div><span class="text">{{ ss.heading }}</span></div>
          </span>
        {% endif %}
        
        {% if product.metafields.my_fields.lifestyle_style != blank %}
        <div class="metafields main-carousel custom--carousel padding--{{ ss.slider_padding | remove: "." }} {% if gallery.size < min_size %}dec-carousel{% endif %}" {% if gallery.size > min_size %}data-flickity='{{ flickity_options }}'{% endif %}>
          {% for block in section.blocks %}
            {% if block.settings.number == product.metafields.my_fields.lifestyle_style and block.type == "layout" %}
              {% assign bs = block.settings %}
              {% assign custom_index = 1 %}

              {% for i in (1..10) %}
                {% assign field = "collumn_" | append: forloop.index %}
                {% assign show_cell = true %}

                {% capture cell_content %}
                  {% if bs[field] == "full" %}
                    {% assign index = "image_" | append: custom_index %}
                    <div class="image--wrapper top">
                      <img class="Image--lazyLoad" data-src="{{ gallery[index] | img_url: "600x" }}">
                    </div>
                    {% assign custom_index = custom_index | plus: 1 %}

                    {% if gallery[index] == blank %}
                      {% assign show_cell = false %}
                    {% endif %}
                  {% endif %}

                  {% if bs[field] != "full" %}
                    {% assign index = "image_" | append: custom_index %}
                    {% assign index_first = index %}

                    {% assign temp_index = custom_index | plus: 1 %}
                    {% assign index_second = "image_" | append: temp_index %}
          
                    <div class="image--wrapper top {% if gallery[index_first] != blank and gallery[index_second] == blank %}expand{% endif %}">
                      <img class="Image--lazyLoad" data-src="{{ gallery[index] | img_url: "600x" }}">
                    </div>
                    {% assign custom_index = custom_index | plus: 1 %}

                    {% assign index = "image_" | append: custom_index %}

                    {% if gallery[index] != blank %}
                      <div class="image--wrapper bottom">
                        <img class="Image--lazyLoad" data-src="{{ gallery[index] | img_url: "600x" }}">
                      </div>
                    {% endif %}

                    {% assign custom_index = custom_index | plus: 1 %}

                    {% if gallery[index] == blank and gallery[index_first] == blank %}
                      {% assign show_cell = false %}
                    {% endif %}
                  {% endif %}
                {% endcapture %}

                {% if show_cell %}
                  <div class="carousel-cell">
                    <div class="cell--inner {{ bs[field] }}">
                      {{ cell_content }}
                    </div>
                  </div>
                {% endif %}
              {% endfor %}
            {% endif %}
          {% endfor %}
        </div>
        {% endif %}
        
        {% if customize_gallery == true and product.metafields.my_fields.lifestyle_style == blank %}
          <div class="customize main-carousel custom--carousel padding--{{ ss.slider_padding | remove: "." }} {% if customize_gallery_size < min_size %}dec-carousel{% endif %}" data-flickity='{{ flickity_options }}'>
            {% for block in section.blocks %}
              {% if block.settings.number == customize_gallery_images.number and block.type == "layout" %}
                {% assign bs = block.settings %}
                {% assign custom_index = 1 %}

                {% for i in (1..10) %}
                  {% assign field = "collumn_" | append: forloop.index %}
                  {% assign show_cell = true %}

                  {% capture cell_content %}
                    {% if bs[field] == "full" %}
                      {% assign index = "image_" | append: custom_index %}
                      <div class="image--wrapper top">
                        <img class="Image--lazyLoad" data-src="{{ customize_gallery_images[index] | img_url: "600x" }}">
                      </div>
                      {% assign custom_index = custom_index | plus: 1 %}

                      {% if customize_gallery_images[index] == blank %}
                        {% assign show_cell = false %}
                      {% endif %}
                    {% endif %}

                    {% if bs[field] != "full" %}
                      {% assign index = "image_" | append: custom_index %}
                      {% assign index_first = index %}

                      {% assign temp_index = custom_index | plus: 1 %}
                      {% assign index_second = "image_" | append: temp_index %}

                      <div class="image--wrapper top {% if customize_gallery_images[index_first] != blank and customize_gallery_images[index_second] == blank %}expand{% endif %}">
                        <img class="Image--lazyLoad" data-src="{{ customize_gallery_images[index] | img_url: "600x" }}">
                      </div>
                      {% assign custom_index = custom_index | plus: 1 %}

                      {% assign index = "image_" | append: custom_index %}

                      {% if customize_gallery_images[index] != blank %}
                        <div class="image--wrapper bottom">
                          <img class="Image--lazyLoad" data-src="{{ customize_gallery_images[index] | img_url: "600x" }}">
                        </div>
                      {% endif %}

                      {% assign custom_index = custom_index | plus: 1 %}

                      {% if customize_gallery_images[index] == blank and customize_gallery_images[index_first] == blank %}
                        {% assign show_cell = false %}
                      {% endif %}
                    {% endif %}
                  {% endcapture %}

                  {% if show_cell %}
                    <div class="carousel-cell">
                      <div class="cell--inner {{ bs[field] }}">
                        {{ cell_content }}
                      </div>
                    </div>
                  {% endif %}
                {% endfor %}
              {% endif %}
            {% endfor %}
          </div>
        {% endif %}
        
        {% if customize_gallery == false and product.metafields.my_fields.lifestyle_style == blank %}
          <div class="collection main-carousel custom--carousel padding--{{ ss.slider_padding | remove: "." }} {% if collection_gallery_size < min_size %}dec-carousel{% endif %}" data-flickity='{{ flickity_options }}'>
            {% for block in section.blocks %}
              {% if block.settings.number == collection_gallery_images.number and block.type == "layout" %}
                {% assign bs = block.settings %}
                {% assign custom_index = 1 %}

                {% for i in (1..10) %}
                  {% assign field = "collumn_" | append: forloop.index %}
                  {% assign show_cell = true %}

                  {% capture cell_content %}
                    {% if bs[field] == "full" %}
                      {% assign index = "image_" | append: custom_index %}
                      <div class="image--wrapper top">
                        <img class="Image--lazyLoad" data-src="{{ collection_gallery_images[index] | img_url: "600x" }}">
                      </div>
                      {% assign custom_index = custom_index | plus: 1 %}

                      {% if collection_gallery_images[index] == blank %}
                        {% assign show_cell = false %}
                      {% endif %}
                    {% endif %}

                    {% if bs[field] != "full" %}
                      {% assign index = "image_" | append: custom_index %}
                      {% assign index_first = index %}

                      {% assign temp_index = custom_index | plus: 1 %}
                      {% assign index_second = "image_" | append: temp_index %}

                      <div class="image--wrapper top {% if collection_gallery_images[index_first] != blank and collection_gallery_images[index_second] == blank %}expand{% endif %}">
                        <img class="Image--lazyLoad" data-src="{{ collection_gallery_images[index] | img_url: "600x" }}">
                      </div>
                      {% assign custom_index = custom_index | plus: 1 %}

                      {% assign index = "image_" | append: custom_index %}

                      {% if collection_gallery_images[index] != blank %}
                        <div class="image--wrapper bottom">
                          <img class="Image--lazyLoad" data-src="{{ collection_gallery_images[index] | img_url: "600x" }}">
                        </div>
                      {% endif %}

                      {% assign custom_index = custom_index | plus: 1 %}

                      {% if collection_gallery_images[index] == blank and collection_gallery_images[index_first] == blank %}
                        {% assign show_cell = false %}
                      {% endif %}
                    {% endif %}
                  {% endcapture %}

                  {% if show_cell %}
                    <div class="carousel-cell">
                      <div class="cell--inner {{ bs[field] }}">
                        {{ cell_content }}
                      </div>
                    </div>
                  {% endif %}
                {% endfor %}
              {% endif %}
            {% endfor %}
          </div>
        {% endif %}
      </div>
    </div>
  </div>
</section>

{% endif %}
