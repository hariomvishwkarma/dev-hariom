

{%- capture flickity_options -%}
{
  "prevNextButtons": true,
  "pageDots": false,
  "wrapAround": false,
  "contain": true,
  "cellAlign": "center",
  "watchCSS": true,
  "dragThreshold": 8,
  "groupCells": true,
  "wrapAround": true
}
{%- endcapture -%}

{%- capture section_settings -%}
{
  "productId": {% if template.name == 'product' %}{{ product.id }}{% else %}null{% endif %}
}
{%- endcapture -%}

{%- if section.settings.show_section -%}
  <section class="Section Section--spacingNormal {% if search.results_count < 4 %}hide{% endif %}" data-section-id="{{ section.id }}" data-section-type="recently-viewed-products" data-section-settings='{{ section_settings }}'>
    {%- if section.settings.title != blank -%}
      <header class="SectionHeader SectionHeader--center">
        <div class="Container">
          <h3 class="SectionHeader__Heading Heading u-h3 oopp">{{ section.settings.title | escape }}</h3>
        </div>
      </header>
    {%- endif -%}

    {%- if template.name == 'search' -%}
      <div class="ProductListWrapper">
        <div class="container">
        <div class="ProductList Carousel recently--carousel" data-flickity='{ "cellAlign": "left", "contain": true, "pageDots": false, "wrapAround": true }'  data-flickity-config='{ "cellAlign": "left", "contain": true, "pageDots": false, "wrapAround": true }'>
          {%- for product in search.results -%}
          
          {% unless product.tags contains "hide" or product.tags contains "only-early-access" or product.handle contains "gift-card" %}
            <div class="Carousel__Cell">
              {% include 'custom--product-item' , product: product, slider: true %}
              {% comment %}
              {% render 'product-item', product: product, show_product_info: section.settings.show_product_info, show_vendor: section.settings.show_vendor, show_color_swatch: section.settings.show_color_swatch, show_labels: true %}
              {% endcomment %}
            </div>
          {% endunless %}
          {%- endfor -%}
        </div>
        </div>
      </div>
    {%- endif -%}
  </section>
{%- endif -%}

{% schema %}
{
  "name": "Recently viewed products",
  "class": "shopify-section--hidden",
  "settings": [
    {
      "type": "checkbox",
      "id": "show_section",
      "label": "Show section",
      "default": true
    },
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "Recently viewed"
    },
    {
      "type": "checkbox",
      "id": "show_product_info",
      "label": "Show product info",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_vendor",
      "label": "Show vendor",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "show_color_swatch",
      "label": "Show color swatch",
      "info": "Some colors appear white? [Learn more](http://support.maestrooo.com/article/80-product-uploading-custom-color-for-color-swatch).",
      "default": false
    }
  ]
}
{% endschema %}