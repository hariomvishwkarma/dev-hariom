{% assign ss = section.settings %}

{%- capture container_class -%}
  {%- case ss.width -%}
    {%- when 'default' -%}
	container
    {%- when 'full' -%}
	container--full
    {%- when 'wide' -%}
	container--wide
  {%- endcase -%}
{%- endcapture -%}

{%- capture flickity_options -%}
{
  "prevNextButtons": true,
  "pageDots": false,
  "dragThreshold": 8,
"freeScroll": true,

  "cellAlign": "left", 
  "contain": true, 
  "wrapAround": true,
"groupCells": true
}
{%- endcapture -%}

<style>
  @media only screen and (min-width: 720px) {
    #section--{{ section.id }} .section--inner {
      background-image: url({{ ss.background_full | img_url: "master" }});
    }

    #section--{{ section.id }} .section-background.top {
      padding-bottom: {{ ss.bg_size }}%;
    }

    #section--{{ section.id }} .section-background.bottom {
      padding-bottom: {{ ss.bg_size_bottom }}%;
    }
  }
  
  @media only screen and (max-width: 720px) {
    #section--{{ section.id }} {
      background-image: url({{ ss.background_full_m | img_url: "master" }});
      background-position: center;
    }
    
    #section--{{ section.id }} .section-background.top {
      padding-bottom: {{ ss.m_bg_size }}%;
    }
    
    #section--{{ section.id }} .section-background.bottom {
      padding-bottom: {{ ss.m_bg_size }}%;
    }
  }
</style>

<section id="section--{{ section.id }}" data-section="categories" style="background-color: {{ ss.section_background }};" class="index-section section--wrapper margin-bottom--{{ ss.section_margin | remove: "." }} padding--{{ ss.section_padding | remove: "." }}">
  <div class="{{ container_class }}">
    <div style="background-color: {{ ss.content_background }}; color: {{ ss.content_text }};" class="section--inner padding--{{ ss.content_padding | remove: "." }}">
      <div class="section-content grid--outer">
         
        <div class="section-background top"></div> 
        <div class="svg--wrapper">
          <div {% if ss.text_size != 0 %}style="max-width: {{ ss.text_size }}px; margin: auto;"{% endif %}>
          {% if section.settings.heading %}
              <h2 class="text--center">{{ section.settings.heading }} </h2>
          {% endif %}    

          {% if section.settings.text %}
              <div class="text--wrapper text--center">{{ section.settings.text }}</div>
          {% endif %}
          </div>
        </div>
        <div class="section-background top"></div> 
        
        <div class="main-carousel custom--carousel padding--{{ ss.slider_padding | remove: "." }}"  data-flickity='{{ flickity_options }}'>
          {% if ss.image_size != 0 %}
          <style>
            #section--{{ section.id }} .image--wrapper:before {
              padding-bottom: {{ ss.image_size }}% !important;
            }
          </style>
          {% endif %}
          
          {% for block in section.blocks %}
            <div class="carousel-cell">
              <div class="cell--inner">
                <div class="image--wrapper {% if ss.image_size == 0 %}default-size{% endif %}">
                  <img class="Image--lazyLoad" {% include "img_attr", image: block.settings.image, size: 300 %}>
                  {% if block.settings.heading %}<div class="overlay" style="color: {{ ss.content_text3 }}; ">{{ block.settings.heading }}</div>{% endif %}
                </div>
                
                {% if block.settings.title %}
                <h3 style="color: {{ ss.content_text2 }}; background: {{ ss.content_background2 }};">{{ block.settings.title | replace: "|", "<span class='seperator'>|</span>" }}</h3>
                {% endif %}
                
                <div class="link--group">
                {% if block.settings.title1 != blank %}
                  <a class="link" href="{{ block.settings.url1 }}" style="color: {{ ss.content_text2 }}; background: {{ ss.content_background2 }};"><span>{{ block.settings.title1 }}</span></a>
                {% endif %}
                {% if block.settings.title2 != blank %}
                  <a class="link" href="{{ block.settings.url2 }}" style="color: {{ ss.content_text2 }}; background: {{ ss.content_background2 }};"><span>{{ block.settings.title2 }}</span></a>
                {% endif %}
                </div>
              </div>
          </div>
          {% endfor %}
        </div>
        
        <div class="section-background bottom"></div>
      </div>
    </div>
  </div>
</section>

{% schema %}
  {
    "name": "Categories",
    "settings": [
      {
        "type": "header",
        "content": "Desktop Backgrounds"
      },
      {
        "label": "Background",
        "id": "background_full",
        "type": "image_picker"
      },
      {
        "type": "range",
        "id": "bg_size",
        "label": "Content spacing (top)",
        "min": 0,
        "max": 100,
        "step": 1,
        "default": 50
      },
      {
        "type": "range",
        "id": "bg_size_bottom",
        "label": "Content spacing (bottom)",
        "min": 0,
        "max": 100,
        "step": 1,
        "default": 50
      },
      {
        "type": "header",
        "content": "Mobile Backgrounds"
      },

      {
        "label": "Background",
        "id": "background_full_m",
        "type": "image_picker"
      },
      {
        "type": "range",
        "id": "m_bg_size",
        "label": "Content spacing",
        "min": 0,
        "max": 100,
        "step": 1,
        "default": 50
      },
      {
        "type": "header",
        "content": "Content"
      },

      {
        "label": "Heading",
        "id": "heading",
        "type": "text"
      },
      {
        "type": "range",
        "id": "image_size",
        "label": "Custom Image height",
        "min": 0,
        "max": 300,
        "step": 5,
        "default": 0,
        "info": "0 -> Default size"
      },
      {
        "label": "Text",
        "id": "text",
        "type": "richtext"
      },
      {
        "type": "range",
        "id": "text_size",
        "label": "Custom Text width",
        "min": 0,
        "max": 1500,
        "step": 50,
        "default": 0,
        "info": "0 -> Default size"
      },
      {
        "type": "header",
        "content": "Colours"
      },
      {
        "type": "color",
        "id": "section_background",
        "label": "Section Background"
      },
      {
        "type": "color",
        "id": "content_background",
        "label": "Content Background"
      },
      {
        "type": "color",
        "id": "content_text",
        "label": "Content Text"
      },
      {
        "type": "color",
        "id": "content_background2",
        "label": "Content Background 2"
      },
      {
        "type": "color",
        "id": "content_text2",
        "label": "Content Text 2"
      },
      {
        "type": "color",
        "id": "content_text3",
        "label": "Heading"
      },
      {
        "type": "header",
        "content": "Spacing"
      },
      {
         "type":      "radio",
         "id":        "width",
         "label":     "Width:",
         "options": [
           { "value": "default", "label": "Default" },
           { "value": "wide", "label": "Wide" },
           { "value": "full", "label": "Full" },
           { "value": "full_with", "label": "Full with padding" }
         ],
        "default":   "default"
      },
      {
        "type": "range",
        "id": "section_margin",
        "label": "Section Margin: Bottom",
        "min": 0,
        "max": 5,
        "step": 0.5,
        "default": 0
      },
      {
        "type": "range",
        "id": "section_padding",
        "label": "Section Padding: Top/Bottom",
        "min": 0,
        "max": 5,
        "step": 0.5,
        "default": 0
      },
      {
        "type": "range",
        "id": "slider_padding",
        "label": "Slider Padding: Top",
        "min": 0,
        "max": 5,
        "step": 0.5,
        "default": 2
      },
      {
        "type": "range",
        "id": "content_padding",
        "label": "Content Padding: All",
        "min": 0,
        "max": 5,
        "step": 0.5,
        "default": 0
      }
	],
    "blocks": [
      {
        "type": "category",
        "name": "Category",
        "settings": [

          {
            "label": "Image",
            "id": "image",
            "type": "image_picker"
          },
          {
            "label": "Heading",
            "id": "heading",
            "type": "text"
          },
          {
            "label": "Title 1",
            "id": "title1",
            "type": "text"
          },
          {
            "label": "URL 1",
            "id": "url1",
            "type": "url"
          },
          {
            "label": "Title 2",
            "id": "title2",
            "type": "text"
          },
          {
            "label": "URL 2",
            "id": "url2",
            "type": "url"
          }
        ]
      }
    ],
    "presets": [
      {
        "name": "Categories",
        "category": "Custom Sections"
      }
    ]
  }
{% endschema %}