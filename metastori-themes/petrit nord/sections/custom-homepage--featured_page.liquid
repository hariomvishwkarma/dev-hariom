{% assign ss = section.settings %}

{%- capture section_style -%}
  {% if ss.section_background_image != blank %}background-image: linear-gradient(rgba(34, 44, 38, 0.55), rgba(34, 44, 38, 0.55)), url({{ ss.section_background_image | img_url: "1500x" }});{% endif %}
  {% if ss.section_background != blank %}background-color: {{ ss.section_background }};{% endif %}
  {% if ss.section_padding != blank %}--section-padding: {{ ss.section_padding }}rem;{% endif %}
  {% if ss.section_margin != blank %}--section-margin: {{ ss.section_margin }}rem;{% endif %} 
  {% if ss.section_background != blank %}--section-background: {{ ss.section_background }};{% endif %}  
  {% if ss.content_padding != blank %}--content-padding: {{ ss.content_padding }}rem;{% endif %} 
  {% if ss.content_margin != blank %}--content-margin: {{ ss.content_margin }}rem;{% endif %} 
  {% if ss.content_background != blank %}--content-background: {{ ss.content_background }};{% endif %}
  {% if ss.content_text != blank %}--content-colour: {{ ss.content_text }};{% endif %}
  {% if ss.content_accent != blank %}--content-accent: {{ ss.content_accent }};{% endif %}
  {%- if ss.mobile_mod != blank -%}--section-mobile-modifier: {{ ss.mobile_mod }};{%- endif -%}
  {%- if ss.button_text != blank -%}--section-button-text: {{ ss.button_text }};{%- endif %}
  {%- if ss.button_background != blank -%}--section-button-background: {{ ss.button_background }};{%- endif %}
{%- endcapture -%}

<section id="section--{{ section.id }}" data-section="homepage_featured_page" style="{{ section_style | remove: " " | strip_newlines }}" class="index-section section--wrapper section--updated">
  <div class="container--{{ ss.width }}">
    <div style="background-color: {{ ss.content_background }}; color: {{ ss.content_text }};" class="section--inner">
      <div class="section-content">
        <div class="content--wrapper">
          {% if ss.image != blank %}
            <div class="">
              <div class="image--wrapper">
                <img class="Image--lazyLoad hide--tablet-down" {% include "img_attr", image: ss.image, size: 6000 %}>
                <img class="Image--lazyLoad show--tablet-down" {% include "img_attr", image: ss.image-mobile, size: 782 %}>
              </div>
            </div>
          {% endif %}

          <div class="content">
            {% if ss.subheading != blank or ss.heading != blank %}
            <div class="section-header">
              <h2><span>{{ ss.heading }}</span></h2>
              <h3><span>{{ ss.subheading }}</span></h3>
            </div>
            {% endif %}
  
            {% if ss.text != blank %}
              <div class="text--wrapper">
                {{ ss.text | replace: "<a ", "<a class='button--default'" }}
              </div>
            {% endif %}
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

{% schema %}
  {
    "name": "Custom: Featured page",
    "settings": [
          {
            "label": "Image",
            "id": "image",
            "type": "image_picker"
          },
          {
            "label": "Image (mobile)",
            "id": "image-mobile",
            "type": "image_picker"
          },
          {
            "label": "Heading",
            "id": "heading",
            "type": "text"
          },
          {
            "label": "Text",
            "id": "text",
            "type": "richtext"
          },
          {
            "type": "header",
            "content": "Colours"
          },
          {
            "type": "color",
            "id": "section_background",
            "label": "Section Background"
          },
          {
            "type": "color",
            "id": "content_background",
            "label": "Content Background"
          },
          {
            "type": "color",
            "id": "content_text",
            "label": "Content Text"
          },
          {
            "type": "color",
            "id": "content_accent",
            "label": "Accent"
          },
          {
            "type": "color",
            "id": "button_text",
            "label": "Button: Text"
          },
          {
            "type": "color",
            "id": "button_background",
            "label": "Button: Background"
          }, 
          {
            "type": "header",
            "content": "Spacing"
          },
          {
             "type":      "select",
             "id":        "width",
             "label":     "Width: Section",
             "options": [
               { "value": "default", "label": "Default" },
               { "value": "wide", "label": "Wide" },
               { "value": "padding", "label": "Padding" },
               { "value": "full", "label": "Full" }
             ],
            "default":   "default"
          },
          {
            "type": "range",
            "id": "section_margin",
            "label": "Section Margin: Bottom",
            "min": -10,
            "max": 10,
            "step": 0.5,
            "default": 0
          },
          {
            "type": "range",
            "id": "section_padding",
            "label": "Section Padding: Top/Bottom",
            "min": 0,
            "max": 10,
            "step": 0.5,
            "default": 0
          },
          {
            "type": "range",
            "id": "content_padding",
            "label": "Content Padding: All",
            "min": 0,
            "max": 10,
            "step": 0.5,
            "default": 0
          },
          {
            "type": "range",
            "id": "mobile_mod",
            "label": "Mobile Modifier",
            "min": 1,
            "max": 5,
            "step": 0.1,
            "default": 2
          }
	],
    "presets": [
      {
        "name": "Custom: Featured page",
        "category": "Custom Sections"
      }
    ]
  }
{% endschema %}
