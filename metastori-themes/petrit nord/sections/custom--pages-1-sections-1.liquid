<style>
  .page-background {
    position: fixed;
    height: 100vh;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: -1;
    background-color: rgb(44,56,49);
    background-size: cover;
    background-position: center center;
    background-size: cover;
    background-position: center center;
    background-repeat: no-repeat;
    background-image: linear-gradient(rgba(255,255,255,0), rgba(255,255,255,0)),url(https://lh3.googleusercontent.com/NCLk5Fh99zA2k4Zi1IhRfYa-IpV0v0i_hLg746f1zdNu4ICeUpB9GKRdmiihxH0Fr--I5WEBfSzXlvw4FexJcv7Nhv4GM5jsgeQ=s16);
    -webkit-transform: translateZ(0);
    -ms-transform: translateZ(0);
    transform: translateZ(0);
}
  
  @import url('https://fonts.googleapis.com/css2?family=Tenor+Sans&display=swap');
  
  
  body {
    font-family: 'Montserrat', sans-serif;
  }
  
  h1, h2, h3, h4, h1.display {
    font-family: 'Tenor Sans', sans-serif;
    font-weight: 400;
  }
</style>

<div class="page-background has-background-image" data-background="https://lh3.googleusercontent.com/NCLk5Fh99zA2k4Zi1IhRfYa-IpV0v0i_hLg746f1zdNu4ICeUpB9GKRdmiihxH0Fr--I5WEBfSzXlvw4FexJcv7Nhv4GM5jsgeQ" 
  style="background-image: linear-gradient(rgba(255, 255, 255, 0), rgba(255, 255, 255, 0)), url(&quot;{% if section.settings.bg != blank %}{{ section.settings.bg | img_url: "master" }}{% else %}https://lh3.googleusercontent.com/oTMl2-FbgW1gsjfLNuyVFE4Aq8QqkvVI7RyKAEQ6xl6KziPvzQ_kuJOu40-P1iXBYbDOswGIbvIk0-lRdpsZ2WNJYCFUq2RciQ=w1905{% endif %}&quot;);"></div>

{% for block in section.blocks %}
  {% include "custom-page_blocks" block: block  %}
{% endfor %}

<script>

  document.querySelectorAll("[data-trigger]").forEach(function(el) {
    el.addEventListener("click", function(event) {
      let target = event.target.closest("div").querySelector("[data-active]");
      let icon = event.target.closest("div").querySelector(".icon");
      let triggerValue = event.target.getAttribute("data-trigger");
      icon.textContent = !(target.getAttribute('data-active') === 'true') ? "-" : "+";
      target.setAttribute('data-active', `${!(target.getAttribute('data-active') === 'true')}`);
      if(triggerValue) {
        event.target.textContent = triggerValue.split("/")[+(target.getAttribute('data-active') === 'true')];
      }
    });
  });
</script>


