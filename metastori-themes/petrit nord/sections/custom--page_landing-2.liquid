{% assign ss = section.settings %}

{%- capture section_container -%}
  {%- case ss.container -%}
    {%- when 'default' -%}
    container
    {%- when 'wide' -%}
    container--wide
    {%- when 'full' -%}
    container--full_width
  {%- endcase -%}
{%- endcapture -%}

{%- capture section_container_style -%}
  {% if ss.custom_width != 0 and ss.custom_width %}style="max-width: {{ ss.custom_width }}px;"{% endif %}
{%- endcapture -%}

{%- capture section_style -%}
  {% if ss.section_padding != blank %}--section-padding: {{ ss.section_padding }}rem;{% endif %}
  {% if ss.section_margin != blank %}--section-margin: {{ ss.section_margin }}rem;{% endif %} 
  {% if ss.section_background != blank %}--section-background: {{ ss.section_background }};{% endif %}  
  {% if ss.content_padding != blank %}--content-padding: {{ ss.content_padding }}rem;{% endif %} 
  {% if ss.content_margin != blank %}--content-margin: {{ ss.content_margin }}rem;{% endif %} 
  {% if ss.content_background != blank %}--content-background: {{ ss.content_background }};{% endif %}
  {% if ss.content_text != blank %}--content-colour: {{ ss.content_text }};{% endif %}
  {% if ss.content_accent != blank %}--content-accent: {{ ss.content_accent }};{% endif %}
{%- endcapture -%}



{%- if settings.compaign -%}
<section
  data-section="popup_landing_2"
  id="section--{{ section.id }}" 
  style="{{ section_style | remove: " " | strip_newlines }}"
  class="section--wrapper">
    
  <div class="{{ section_container }}">
    <div class="popup--inner">
      {% for block in section.blocks %}
        {%- case block.type -%}
          {%- when 'images-default' -%}
            <style>
              #a-{{ block.id }} {
                animation-duration: {{ block.settings.animation_speed }}s !important;
              }
              
              @media only screen and (max-width: 720px) {
                #a-{{ block.id }} {
                  animation-duration: {{ block.settings.animation_speed_mobile }}s !important;
                }
              }
            </style>
            <div class="animation--wrapper">
              <div id="a-{{ block.id }}" class="photobanner">
                <div class="main-slide">
                  {% for i in (1..5) %}
                      {% assign image = "image_" | append: i %}
                      {% if block.settings[image] != blank %}
                          <img src="{{ block.settings[image] | img_url: "400x" }}" alt="" />
                      {% endif %}
                  {% endfor %}
                  <div class="dup-slide">
                    {% for i in (1..5) %}
                        {% assign image = "image_" | append: i %}
                        {% if block.settings[image] != blank %}
                            <img src="{{ block.settings[image] | img_url: "400x" }}" alt="" />
                        {% endif %}
                    {% endfor %}
                  </div>
                </div>
              </div>
            </div>
          {%- when 'images-reverse' -%}
            <style>
              #a-{{ block.id }} {
                animation-duration: {{ block.settings.animation_speed }}s !important;
              }
              
              @media only screen and (max-width: 720px) {
                #a-{{ block.id }} {
                  animation-duration: {{ block.settings.animation_speed_mobile }}s !important;
                }
              }
            </style>
            <div class="animation--wrapper reverse">
              <div id="a-{{ block.id }}" class="photobanner">
                <div class="main-slide">
                  {% for i in (1..5) %}
                      {% assign image = "image_" | append: i %}
                      {% if block.settings[image] != blank %}
                          <img src="{{ block.settings[image] | img_url: "400x" }}" alt="" />
                      {% endif %}
                  {% endfor %}
                  <div class="dup-slide">
                    {% for i in (1..5) %}
                        {% assign image = "image_" | append: i %}
                        {% if block.settings[image] != blank %}
                            <img src="{{ block.settings[image] | img_url: "400x" }}" alt="" />
                        {% endif %}
                    {% endfor %}
                  </div>
                </div>
              </div>
            </div>
          {%- when 'main' -%}
      		<div class="popup-main">
              <div>
                {% if block.settings.heading_1 != blank %}<h2>{{ block.settings.heading_1 }}</h2>{% endif %}
                {% if block.settings.heading_2 != blank %}<p>{{ block.settings.heading_2 }}</p>{% endif %}
                {% if block.settings.form != blank %}{{ block.settings.form }}{% endif %}
              </div>
      		</div>
        {%- endcase -%}
      {% endfor %}
    </div>
  </div>
</section>
{% render 'landing-page-cookie-tracker' %}
{%- endif -%}


{% schema %}
