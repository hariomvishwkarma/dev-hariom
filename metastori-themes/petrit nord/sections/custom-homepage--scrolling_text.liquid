{% assign ss = section.settings %}

{%- capture container_class -%}
  {%- case ss.width -%}
    {%- when 'default' -%}
	container
    {%- when 'full' -%}
	container--full
    {%- when 'wide' -%}
	container--wide
  {%- endcase -%}
{%- endcapture -%}

{%- capture flickity_options -%}
{
  "prevNextButtons": false,
  "adaptiveHeight": false,
  "wrapAround": true,
  "dragThreshold": 15,
  "autoPlay": true,
"freeScroll": true,
  "contain": true, 
  "cellAlign": "center",
  "pageDots": false
}
{%- endcapture -%}

<style>
  #section--{{ section.id }} {
    --tw: {{ section.blocks.size | times: 2 | plus: 1 | times: 100 }}vw;
  }
  
  #section--{{ section.id }} .scroller {
    animation-duration: {{ section.settings.duration_desktop }}s !important;
  }
  
  @media only screen and (max-width: 1240px) {
    #section--{{ section.id }} {
      --tw: {{ section.blocks.size | times: 2 | plus: 1 | times: 100 }}vw;
    }
  }

  @media only screen and (max-width: 720px) {
    #section--{{ section.id }} {
      --tw: {{ section.blocks.size | times: 2 | plus: 1 | times: 100 }}vw;
    }

    #section--{{ section.id }} .scroller {
      animation-duration: {{ section.settings.duration_mobile }}s !important;
    }
  }

  @media only screen and (max-width: 480px) {
    #section--{{ section.id }} {
      --tw: {{ section.blocks.size | times: 2 | plus: 1 | times: 100 }}vw;
    }
    
    #section--{{ section.id }} .scroller {
      animation-duration: {{ section.settings.duration_mobile | times: 0.75 }}s !important;
    }
  }
</style>

{% capture review_text %}
<div class="review_text">
  <div class="stars">
    {% for i in (1..5) %}
      <span class="star"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24"> <path fill="none" d="M0 0h24v24H0z"/> <path fill="none" d="M0 0h24v24H0z"/> <path d="m12 17.3 6.2 3.7-1.7-7L22 9.2l-7.2-.6L12 2 9.2 8.6 2 9.2 7.5 14l-1.7 7z"/> </svg></span>
    {% endfor %}  
  </div>
  <span>{{ ss.review }}</span>
</div>
{% endcapture %}

<section id="section--{{ section.id }}" data-section="scrolling-text" style="background-color: {{ ss.section_background }};" class="index-section section--wrapper margin-bottom--{{ ss.section_margin | remove: "." }} padding--{{ ss.section_padding | remove: "." }}">
  <div class="{{ container_class }}">
    <div style="background-color: {{ ss.content_background }}; color: {{ ss.content_text }};" class="section--inner padding--{{ ss.content_padding | remove: "." }}">
      <div class="section-content grid--outer">
        <div class="scroller" style="width: {{ section.blocks.size | times: 2 | plus: 1 | times: 100 }}vw;">

          {% for block in section.blocks %}
            {% if block.settings.text != blank %}
              <div class="scrolling_text"><p>{{ block.settings.text }}</p></div>
              {% if ss.review != blank %}{{ review_text }}{% endif %}
            {% endif %}
          {% endfor %}


          <div class="scrolling_text"><p>{{ section.blocks[0].settings.text }}</p></div>
        </div>
      </div>
    </div>
  </div>
</section>

{% schema %}
  {
    "name": "Scrolling text",
    "settings": [

      {
        "type": "header",
        "content": "Content"
      },

      {
        "label": "Review Text",
        "id": "review",
        "type": "text"
      },
      {
        "label": "Text",
        "id": "text",
        "type": "richtext"
      },

      {
        "type": "range",
        "id": "duration_desktop",
        "label": "Duration desktop",
        "min": 0,
        "max": 100,
        "step": 1,
        "default": 52
      },
      {
        "type": "range",
        "id": "duration_mobile",
        "label": "Duration mobile",
        "min": 0,
        "max": 100,
        "step": 1,
        "default": 52
      },
      {
        "type": "header",
        "content": "Colours"
      },
      {
        "type": "color",
        "id": "section_background",
        "label": "Section Background"
      },
      {
        "type": "color",
        "id": "content_background",
        "label": "Content Background"
      },
      {
        "type": "color",
        "id": "content_text",
        "label": "Content Text"
      },
      {
        "type": "header",
        "content": "Spacing"
      },
      {
         "type":      "radio",
         "id":        "width",
         "label":     "Width:",
         "options": [
           { "value": "default", "label": "Default" },
           { "value": "wide", "label": "Wide" },
           { "value": "full", "label": "Full" },
           { "value": "full_with", "label": "Full with padding" }
         ],
        "default":   "default"
      },
      {
        "type": "range",
        "id": "section_margin",
        "label": "Section Margin: Bottom",
        "min": 0,
        "max": 5,
        "step": 0.5,
        "default": 0
      },
      {
        "type": "range",
        "id": "section_padding",
        "label": "Section Padding: Top/Bottom",
        "min": 0,
        "max": 5,
        "step": 0.5,
        "default": 0
      },
      {
        "type": "range",
        "id": "content_padding",
        "label": "Content Padding: All",
        "min": 0,
        "max": 5,
        "step": 0.5,
        "default": 0
      }
	],
    "blocks": [
      {
        "type": "text",
        "name": "Text",
        "settings": [
          
          {
            "label": "Text",
            "id": "text",
            "type": "inline_richtext"
          }
        ]
      }
    ],
    "presets": [
      {
        "name": "Scrolling text",
        "category": "Custom Sections"
      }
    ]
  }
{% endschema %}