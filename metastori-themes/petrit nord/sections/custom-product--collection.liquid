{% assign ss = section.settings %}

{%- capture container_class -%}
  {%- case ss.width -%}
    {%- when 'default' -%}
	container--product
    {%- when 'full' -%}
	container--full_width
    {%- when 'full_with' -%}
	container--product-full_with
    {%- when 'wide' -%}
	container--wide
  {%- endcase -%}
{%- endcapture -%}

{% assign show_section = false %}
{% if ss.show_section %}
{% assign show_section = true %}
{% endif %}

{%- assign handle = product.metafields.my_fields.featured_collection | split: "/collections/" | last -%}
{%- assign collection = collections[handle] -%}

{% for collection in product.collections %}
  {% if collection.metafields.custom.featured_on_product_page == true %}
  	{%- assign collection = collection -%}
  	{%- assign handle = "show" -%}
  {% endif %}
{% endfor %}

{% if show_section == true and handle != blank %}
<section id="section--{{ section.id }}" data-section="product_collection" style="background-color: {{ ss.section_background }};" class="index-section section--wrapper margin-bottom--{{ ss.section_margin | remove: "." }} padding--{{ ss.section_padding | remove: "." }}">
  
  <div class="{{ container_class }}">
    <div style="background-color: {{ ss.content_background }}; color: {{ ss.content_text }};" class="section--inner padding--{{ ss.content_padding | remove: "." }}">
      <div class="section-content">
 
        <div class="content--wrapper">
          <div class="collection-title"><span>{{ "general.custom.collection_banner" | t }} <span class="title">{{ collection.title }}</span></span></div>
          <div class="grid--wrapper outside">
            <div class="grid--item">
              <a href="{{ collection.url }}" class="image--wrapper">
                <div>
                <img src="{{ collection.featured_image | img_url: "1000x" }}" />
                  <div class="overlay"><span>{{ "general.custom.collection_banner" | t }} <span class="title">{{ collection.title }}</span></span></div>
                </div>
              </a>
            </div>
            <div class="grid--item">
            	<div class="grid--wrapper inside">
                  {% assign count = 6 %}
                  {% for product in collection.products %}
                    {% if product.tags contains "hide" %}{% continue %}{% endif %}
                    {% if count == 0 %}{% break %}{% endif %}
                    <div class="grid--item">
                      <a href="{{ product.url }}">
                        <div class="image--wrapper"><img src="{{ product.featured_media | img_url: "1000x" }}" /></div>
                      </a>
                    </div>
                    {% assign count = count | minus: 1 %}
                  {% endfor %}
                </div>
            </div>
          </div>
          <div class="collection-button">
            <a href="{{ collection.url }}" class="button--default">Go to collection</a>
          </div>
     
        </div>
      </div>
    </div>
  </div>
</section>
{% endif %}

{% schema %}
  {
    "name": "Collection section",
    "settings": [
      {
        "type": "checkbox",
        "id": "show_section",
        "label": "Show section",
        "default": true
      },
      {
        "type": "header",
        "content": "Colours"
      },
      {
        "type": "color",
        "id": "section_background",
        "label": "Section Background"
      },
      {
        "type": "color",
        "id": "content_background",
        "label": "Content Background"
      },
      {
        "type": "color",
        "id": "content_text",
        "label": "Content Text"
      },
      {
        "type": "color",
        "id": "content_accent",
        "label": "Accent"
      },
      {
        "type": "header",
        "content": "Spacing"
      },

      {
         "type":      "radio",
         "id":        "width",
         "label":     "Width:",
         "options": [
           { "value": "default", "label": "Default" },
           { "value": "wide", "label": "Wide" },
           { "value": "full", "label": "Full" },
           { "value": "full_with", "label": "Full with padding" }
         ],
        "default":   "default"
      },
      {
        "type": "range",
        "id": "custom_width",
        "label": "Custom section width",
        "min": 800,
        "max": 1600,
        "step": 10,
        "default": 800
      },
      {
        "type": "range",
        "id": "section_margin",
        "label": "Section Margin: Bottom",
        "min": 0,
        "max": 5,
        "step": 0.5,
        "default": 0
      },
      {
        "type": "range",
        "id": "section_padding",
        "label": "Section Padding: Top/Bottom",
        "min": 0,
        "max": 5,
        "step": 0.5,
        "default": 0
      },
      {
        "type": "range",
        "id": "content_padding",
        "label": "Content Padding: All",
        "min": 0,
        "max": 5,
        "step": 0.5,
        "default": 0
      }
	]
  }
{% endschema %}

{% stylesheet %}
{% endstylesheet %}

{% javascript %}
{% endjavascript %}