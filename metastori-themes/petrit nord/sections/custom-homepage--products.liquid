{% assign ss = section.settings %}

{%- capture container_class -%}
  {%- case ss.width -%}
    {%- when 'default' -%}
	container
    {%- when 'full' -%}
	container--full
    {%- when 'wide' -%}
	container--wide
        {%- when 'full_with' -%}
        container--full_width
  {%- endcase -%}
{%- endcapture -%}

{%- capture flickity_options -%}
{
  "prevNextButtons": true,
  "pageDots": false,
  "dragThreshold": 8,

"freeScroll": true,
  "cellAlign": "left", 
  "contain": true, 
  "wrapAround": true,
"groupCells": true
}
{%- endcapture -%}

{%- assign add_collection = collections[ss.collection] -%}

<section id="section--{{ section.id }}" data-section="products-carousel" style="background-color: {{ ss.section_background }};" class="index-section section--wrapper margin-bottom--{{ ss.section_margin | remove: "." }} padding--{{ ss.section_padding | remove: "." }}">
  <div class="{{ container_class }}">
    <div style="background-color: {{ ss.content_background }}; color: {{ ss.content_text }};" class="section--inner padding--{{ ss.content_padding | remove: "." }}">
      <div class="section-content">
                
        {% if section.settings.heading %}
        	<h2 class="text--center">{{ section.settings.heading }} </h2>
        {% endif %}
            
        {% if section.settings.text %}
        	<div style="{% if ss.text_size != 0 %}max-width: {{ ss.text_size }}px;{% endif %}{% if ss.text_bottom %}padding-bottom: 0;{% endif %}" class="text--wrapper text--center padding--{{ ss.slider_padding | remove: "." }}">{{ section.settings.text }}</div>
        {% endif %}
        
        <div class="main-carousel custom--carousel"  data-flickity='{{ flickity_options }}'>
          {% if ss.image_size != 0 %}
          <style>
            #section--{{ section.id }} .image--wrapper:before {
              padding-bottom: {{ ss.image_size }}% !important;
            }
          </style>
          {% endif %}
          
          {%- for add_product in add_collection.products -%}
          
          {% if add_product.tags contains "hide" %}
          {% else %}
            <div class="carousel-cell">
              <a href="{{ add_product.url }}" class="cell--inner">
                <div class="image--wrapper {% if ss.image_size == 0 %}default-size{% endif %}">
                  <img class="Image--lazyLoad" {% include "img_attr", image: add_product.featured_image, size: 600 %}>
                </div>
              </a>
          </div>
          {% endif %}
          {%- endfor -%}
        </div>
      </div>
    </div>
  </div>
</section>

{% schema %}
  {
    "name": "Products",
    "settings": [
      {
        "label": "Collection",
        "id": "collection",
        "type": "collection"
      },
      {
        "label": "Heading",
        "id": "heading",
        "type": "text"
      },
      {
        "type": "range",
        "id": "image_size",
        "label": "Custom Image height",
        "min": 0,
        "max": 300,
        "step": 5,
        "default": 0,
        "info": "0 -> Default size"
      },
      {
        "label": "Text",
        "id": "text",
        "type": "richtext"
      },
      {
        "type": "range",
        "id": "text_size",
        "label": "Custom Text width",
        "min": 0,
        "max": 1500,
        "step": 50,
        "default": 0,
        "info": "0 -> Default size"
      },
      {
        "type": "header",
        "content": "Colours"
      },
      {
        "type": "color",
        "id": "section_background",
        "label": "Section Background"
      },
      {
        "type": "color",
        "id": "content_background",
        "label": "Content Background"
      },
      {
        "type": "header",
        "content": "Spacing"
      },
      {
         "type":      "radio",
         "id":        "width",
         "label":     "Width:",
         "options": [
           { "value": "default", "label": "Default" },
           { "value": "wide", "label": "Wide" },
           { "value": "full", "label": "Full" },
           { "value": "full_with", "label": "Full with padding" }
         ],
        "default":   "default"
      },
      {
        "type": "range",
        "id": "section_margin",
        "label": "Section Margin: Bottom",
        "min": 0,
        "max": 5,
        "step": 0.5,
        "default": 0
      },
      {
        "type": "range",
        "id": "slider_padding",
        "label": "Text Padding: Top/Bottom",
        "min": 0,
        "max": 5,
        "step": 0.5,
        "default": 2
      },
      {
        "type": "checkbox",
        "id": "text_bottom",
        "label": "Bottom padding: 0",
        "default": true
      },
      {
        "type": "range",
        "id": "section_padding",
        "label": "Section Padding: Top/Bottom",
        "min": 0,
        "max": 5,
        "step": 0.5,
        "default": 0
      },
      {
        "type": "range",
        "id": "content_padding",
        "label": "Content Padding: All",
        "min": 0,
        "max": 5,
        "step": 0.5,
        "default": 0
      }
	],
    "presets": [
      {
        "name": "Products",
        "category": "Custom Sections"
      }
    ]
  }
{% endschema %}
