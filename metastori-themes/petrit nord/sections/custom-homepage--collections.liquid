{% assign ss = section.settings %}

{%- capture container_class -%}
  {%- case ss.width -%}
    {%- when 'default' -%}
	container
    {%- when 'full' -%}
	container--full
    {%- when 'wide' -%}
	container--wide
  {%- endcase -%}
{%- endcapture -%}

<section id="section--{{ section.id }}" data-section="collections" style="background-color: {{ ss.section_background }};" class="index-section section--wrapper margin-bottom--{{ ss.section_margin | remove: "." }} padding--{{ ss.section_padding | remove: "." }}">
  <div class="{{ container_class }}">
    <div style="background-color: {{ ss.content_background }}; color: {{ ss.content_text }};" class="section--inner padding--{{ ss.content_padding | remove: "." }}">
      <div class="section-content grid--outer">
        <div class="grid--wrapper">
          
          {% for block in section.blocks %}
            <div class="grid--item">
              <img class="magic-image feature--image Image--lazyLoad" {% include "img_attr", image: block.settings.image_1 , size: 500 %}>
            </div>
          {% endfor %}
        </div>
      </div>
    </div>
  </div>
</section>

{% schema %}
  {
    "name": "Collections",
    "settings": [

      {
        "type": "header",
        "content": "Content"
      },
      {
        "label": "Image",
        "id": "image",
        "type": "image_picker"
      },

      {
        "label": "Heading",
        "id": "heading",
        "type": "text"
      },
      {
        "label": "Subheading",
        "id": "subheading",
        "type": "text"
      },

      {
        "type": "header",
        "content": "Colours"
      },
      {
        "type": "color",
        "id": "section_background",
        "label": "Section Background"
      },
      {
        "type": "color",
        "id": "content_background",
        "label": "Content Background"
      },
      {
        "type": "color",
        "id": "content_text",
        "label": "Content Text"
      },
      {
        "type": "header",
        "content": "Spacing"
      },
      {
         "type":      "radio",
         "id":        "width",
         "label":     "Width:",
         "options": [
           { "value": "default", "label": "Default" },
           { "value": "wide", "label": "Wide" },
           { "value": "full", "label": "Full" },
           { "value": "full_with", "label": "Full with padding" }
         ],
        "default":   "default"
      },
      {
        "type": "range",
        "id": "section_margin",
        "label": "Section Margin: Bottom",
        "min": 0,
        "max": 5,
        "step": 0.5,
        "default": 0
      },
      {
        "type": "range",
        "id": "section_padding",
        "label": "Section Padding: Top/Bottom",
        "min": 0,
        "max": 5,
        "step": 0.5,
        "default": 0
      },
      {
        "type": "range",
        "id": "content_padding",
        "label": "Content Padding: All",
        "min": 0,
        "max": 5,
        "step": 0.5,
        "default": 0
      }
	],
    "blocks": [
      {
        "type": "image",
        "name": "Image",
        "settings": [
          {
            "label": "Heading",
            "id": "heading",
            "type": "text"
          },
          {
            "label": "Text",
            "id": "text",
            "type": "richtext"
          }
        ]
      }
    ],
    "presets": [
      {
        "name": "Collections",
        "category": "Custom Sections"
      }
    ]
  }
{% endschema %}