{% assign ss = section.settings %}

{%- capture container_class -%}
  {%- case ss.width -%}
    {%- when 'default' -%}
	container
    {%- when 'full' -%}
	container--full
    {%- when 'wide' -%}
	container--wide
        {%- when 'full_with' -%}
        container--full_width
  {%- endcase -%}
{%- endcapture -%}

<section id="section--{{ section.id }}" data-section="images-2" style="background-color: {{ ss.section_background }};" class="index-section section--wrapper margin-bottom--{{ ss.section_margin | remove: "." }} padding--{{ ss.section_padding | remove: "." }}">
  <div class="{{ container_class }}">
    <div style="background-color: {{ ss.content_background }}; color: {{ ss.content_text }};" class="section--inner padding--{{ ss.content_padding | remove: "." }}">
      <div class="section-content grid--outer">
        <ul class="grid--wrapper">
          {% if ss.image_size != 0 %}
          <style>
            #section--{{ section.id }} .image--wrapper:before {
              padding-bottom: {{ ss.image_size }}% !important;
            }
          </style>
          {% endif %}
          {% for block in section.blocks %}
            <li class="grid--item">
              <a {% if block.settings.url != blank %}href="{{ block.settings.url }}"{% endif %} class="content--group">
                <div class="image--wrapper {% if ss.image_size == 0 %}default-size{% endif %}">
                  <img class="Image--lazyLoad" {% include "img_attr", image: block.settings.image %}>
                </div>
              </a>
            </li>
          {% endfor %}
        </ul>
      </div>
    </div>
  </div>
</section>

{% schema %}
  {
    "name": "Images",
	"max_blocks": 3,
    "settings": [
      {
        "type": "range",
        "id": "image_size",
        "label": "Custom Image height",
        "min": 0,
        "max": 300,
        "step": 5,
        "default": 0,
        "info": "0 -> Default size"
      },
      {
        "type": "header",
        "content": "Colours"
      },
      {
        "type": "color",
        "id": "section_background",
        "label": "Section Background"
      },
      {
        "type": "color",
        "id": "content_background",
        "label": "Content Background"
      },
      {
        "type": "header",
        "content": "Spacing"
      },
      {
         "type":      "radio",
         "id":        "width",
         "label":     "Width:",
         "options": [
           { "value": "default", "label": "Default" },
           { "value": "wide", "label": "Wide" },
           { "value": "full", "label": "Full" },
           { "value": "full_with", "label": "Full with padding" }
         ],
        "default":   "default"
      },
      {
        "type": "range",
        "id": "section_margin",
        "label": "Section Margin: Bottom",
        "min": 0,
        "max": 5,
        "step": 0.5,
        "default": 0
      },
      {
        "type": "range",
        "id": "section_padding",
        "label": "Section Padding: Top/Bottom",
        "min": 0,
        "max": 5,
        "step": 0.5,
        "default": 0
      },
      {
        "type": "range",
        "id": "content_padding",
        "label": "Content Padding: All",
        "min": 0,
        "max": 5,
        "step": 0.5,
        "default": 0
      }
	],
    "blocks": [
      {
        "type": "image",
        "name": "Image",
        "settings": [
          {
            "label": "Image",
            "id": "image",
            "type": "image_picker"
          },
          {
            "label": "URL",
            "id": "url",
            "type": "url"
          }
        ]
      }
    ],
    "presets": [
      {
        "name": "Images",
        "category": "Custom Sections"
      }
    ]
  }
{% endschema %}