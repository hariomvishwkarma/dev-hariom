{% assign ss = section.settings %}
{% assign show = false %}
{% if template contains "collection" %}
  {% assign handle = collection.handle %}
	{% if ss.coll_true %}
  		{% assign show = true %}
	{% endif %}
{% endif %}

{% if template contains "product" %}
{% assign handle = product.handle %}
{% endif %}

{% if template contains "page" %}
{% assign handle = page.handle %}
{% endif %}

{% if template contains "index" and ss.index_true == true %}
  {% assign show = true %}
{% endif %}

{% if ss.all_true %}
{% if template contains "page.hpp_" or template contains "page.landing_page-" %}
  {% assign show = false %}
{% else %}
  {% assign show = true %}
{% endif %}
{% endif %}

{% assign handles = ss.handles | strip_newlines | split: "," %}

{% if handles contains handle or show == true %}
  {% if settings.stock_btn_1 != blank or settings.stock_btn_2 != blank %}
  <style>
    #theme--custom #signup--popup {
      color: {{ ss.content_text }};
      background: {{ ss.button_background }};
    }

    #theme--custom #signup--popup .close {
      color: {{ ss.button_background }};
      background: {{ ss.content_text }};
    }


    #theme--custom #signup--popup:hover {
      color: {{ ss.content_text-hover }};
      background: {{ ss.button_background-hover }};
    }

    #theme--custom #signup--popup:hover .close {
      color: {{ ss.button_background-hover }};
      background: {{ ss.content_text-hover }};
    }
  </style>

    {% if settings.compaign %}
    <a href="{{ settings.stock_btn_url_2 }}" id="signup--popup" class="button--popup" data-utm>
      {{ settings.stock_btn_2 }}
      <span class="close">✕</span>
    </a>
    {% else %}
    <a href="{{ settings.stock_btn_url_1 }}" id="signup--popup" class="button--popup" data-utm>
      {{ settings.stock_btn_1 }}
      <span class="close">✕</span>
    </a>
    {% endif %}

  {% endif %}
{% endif %}

{% schema %}
  {
    "name": "Cart button visibility",
    "settings": [
      {
        "label": "Handles",
        "id": "handles",
        "type": "textarea"
      },		
      {
        "type": "checkbox",
        "id": "all_true",
        "label": "Display on every page",
        "default": true
      },	
      {
        "type": "checkbox",
        "id": "coll_true",
        "label": "Display on all collection pages",
        "default": false
      },
      {
        "type": "checkbox",
        "id": "index_true",
        "label": "Display on homepage",
        "default": false
      },
      {
        "type": "paragraph",
        "content": "Colours:"
      },
      {
        "type": "color",
        "id": "button_background",
        "label": "Button Background"
      },
      {
        "type": "color",
        "id": "button_background-hover",
        "label": "Button Background (hover)"
      },
      {
        "type": "color",
        "id": "content_text",
        "label": "Content Text"
      },
      {
        "type": "color",
        "id": "content_text-hover",
        "label": "Content Text (hover)"
      }
	]
  }
{% endschema %}