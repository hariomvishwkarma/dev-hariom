{% comment %}SAFE TO COPY/PASTE{% endcomment %}
{% assign ss = section.settings %}

<footer id="section-footer" data-section-id="{{ section.id }}" data-section-type="footer" class="Footer {% if section.blocks.size <= 2 %}Footer--center{% endif %}" role="contentinfo">
  <div>
    {%- for block in section.blocks -%}
    <div id="block--{{ block.id }}" style="background: {{ block.settings.section_background }};" class="footer-block" data-type="{{ block.type }}">
      {%- case block.type -%}
      {%- when 'text' -%}
        {%- if block.settings.title != blank -%}
          <h2 class="Footer__Title Heading u-h6">{{ block.settings.title | escape }}</h2>
        {%- endif -%}
  
        {%- if block.settings.content != blank -%}
          <div class="Footer__Content Rte">
            {{ block.settings.content }}
          </div>
        {%- endif -%}
  
        {%- if block.settings.show_social_media -%}
      <div style="color: {{ block.settings.section_accent }};">{% render 'social-media', class: 'Footer__Social', spacing: 'loose' %}</div>
        {%- endif -%}
      
        {%- when "menu" -%}
          <style>
            footer {
              --footer-menu-hover: {{ block.settings.section_accent }};
            }
          </style>
         {%- assign linklist = linklists[block.settings.menu] -%}
  
          {%- if linklist != empty -%}
            <ul class="Linklist">

              <li class="Linklist__Item shop-locator--wrapper">
                <a href="#" class="Link Link--primary">{{ section.settings.location_heading }}</a>
                <ul>
                  <li>
                    {% capture location_elements %}
                      {% if localization.country.iso_code == "US" %}
                        <span class="flag--icon static"><img class="Image--lazyLoad Image--fadeIn" width="30" src="{{ section.settings.flag }}"></span>
                        <span class="label">{{ section.settings.label }}</span>
                      {% elsif localization.country.iso_code == "GB" %}
                        <span class="flag--icon"><img class="Image--lazyLoad Image--fadeIn" width="30" height="30" data-src="{{ section.settings.flagGB | img_url: "110x" }}" data-sizes="auto" data-max-width="{{ section.settings.flagGB.width }}" data-max-height="{{ section.settings.flagGB.height }}" data-original-src="{{ section.settings.flagGB | img_url: "master" }}">                        </span>
                        <span class="label">{{ section.settings.labelGB }}</span>
                      {% elsif localization.country.iso_code == "CA" %}
                        <span class="flag--icon"><img class="Image--lazyLoad Image--fadeIn" width="30" height="30" data-src="{{ section.settings.flagCA | img_url: "110x" }}" data-sizes="auto" data-max-width="{{ section.settings.flagCA.width }}" data-max-height="{{ section.settings.flagCA.height }}" data-original-src="{{ section.settings.flagCA | img_url: "master" }}">                        </span>
                        <span class="label">{{ section.settings.labelCA }}</span>
                      {% else %}
                        <span class="flag--icon static"><img class="Image--lazyLoad Image--fadeIn" width="30" src="{{ section.settings.flag }}"></span>
                        <span class="label">{{ section.settings.label }}</span>
                      {% endif %}
                    {% endcapture %}
            
                    <p class="Text--subdued u-h6 shop-locator">
                      {{ location_elements }}
                      <svg class="Icon Icon--select-arrow" width="12px" height="12px" viewBox="0 0 12 12" version="1.1" xmlns="http://www.w3.org/2000/svg" xmlns:xlink="http://www.w3.org/1999/xlink"> <g id="Icon/Select" stroke="none" stroke-width="1" fill="none" fill-rule="evenodd"> <path d="M7.31424863,7.83249801 C7.49308327,7.65292036 7.78030533,7.64211612 7.97212559,7.8077511 L7.97212559,7.8077511 L7.98768609,7.82186832 C8.15891557,7.98504957 8.16543996,8.25614304 8.0022587,8.42737252 L8.0022587,8.42737252 L6.35669839,10.1540932 L6.35669839,10.1540932 L6.34494162,10.1660232 C6.14784525,10.3594337 5.83127686,10.3564458 5.63786633,10.1593494 L5.63786633,10.1593494 L3.93980407,8.42892705 C3.93192315,8.42089594 3.92436563,8.41255375 3.91714952,8.40392036 C3.7672432,8.22457149 3.79111109,7.95765742 3.97045996,7.8077511 C4.1702034,7.64079824 4.4639049,7.65215736 4.65015692,7.83403886 L4.65015692,7.83403886 L6,9.15220702 Z M6.34494162,1.87612595 L6.35669839,1.88805593 L6.35669839,1.88805593 L8.0022587,3.61477664 C8.16543996,3.78600613 8.15891557,4.05709959 7.98768609,4.22028084 L7.97212559,4.23439806 L7.97212559,4.23439806 C7.78030533,4.40003304 7.49308327,4.3892288 7.31424863,4.20965115 L6,2.88994214 L4.65015692,4.2081103 C4.4639049,4.3899918 4.1702034,4.40135092 3.97045996,4.23439806 C3.79111109,4.08449174 3.7672432,3.81757767 3.91714952,3.6382288 C3.92436563,3.62959541 3.93192315,3.62125322 3.93980407,3.61322211 L5.63786633,1.88279975 C5.83127686,1.68570339 6.14784525,1.68271542 6.34494162,1.87612595 Z" id="Combined-Shape" fill="currentColor"></path> </g> </svg>
                    </p>
                  </li>
                </ul>
              </li>
              {%- for link in linklist.links -%}
                <li style="color: {{ block.settings.section_text }};" class="Linklist__Item">
                  <a href="{{ link.url }}" class="Link Link--primary">{{ link.title | escape }}</a>
                  <ul style="color: {{ block.settings.section_text_2 }};">
                    {%- for sub_link in link.links -%}
                    <li><a href="{{ sub_link.url }}" class="Link Link--primary">{{ sub_link.title | escape }}</a></li>
                    {%- endfor -%}
                  </ul>
                </li>
                {% if forloop.last %}
                  <style>
                    footer .shop-locator--wrapper {
                      color: {{ block.settings.section_text }};
                    }
                  </style>
                {% endif %}
              {%- endfor -%}
            </ul>
          {%- endif -%}
      
        {%- when "meta" -%}
        
      
      	<style>
            #block--{{ block.id }} a {
                color: {{ block.settings.section_accent }} !important;
              }
      	</style>
          <div  style="color: {{ block.settings.section_text }};" class="copyright">
            <p>&copy; {{ 'now' | date: "%Y" }}, {{ "Petit Nord ApS" | link_to: routes.root_url }} <br> CVR number: 38506374</p>
          </div>
  
        {%- when "newsletter" -%}
            <style>
              footer {
                --footer-newsletter-text: {{ block.settings.section_text }};
                --footer-newsletter-accent: {{ block.settings.section_accent }};
                --footer-newsletter-input-text: {{ block.settings.section_button_text }};
                --footer-newsletter-input-bg: {{ block.settings.section_button_bg }};
              }
            </style>
            {% if template contains "landing_page" or template contains "hp_" or template contains "hpp_" or template contains "custom_page_11" or template contains "custom_page_10" or template contains "custom_page_9" %}
              <style>
                #block--{{ block.id }} { padding-top: 0 !important; }
              </style>
            {% else %}
              {% if template != "page.hidden" %}
                <div class="newsletter--wrapper">
                  <div {% if block.settings.max_width != 0 %}style="max-width: {{ block.settings.max_width  }}px;"{% endif %} class="newsletter--inner">
                    <div class="footer-formblock">
                      {% if settings.compaign %}
                        <h2>{{ section.settings.text2 }}</h2>
                        <div>{{ section.settings.text22 }}</div>
                        <a href="{{ section.settings.url1 }}" class=" access--button button--default landing--btn  " data-utm>{{ "general.custom.footer_button" | t }}</a>
                      {% else %}  
                        <h2>{{ section.settings.text1 }}</h2>
                        <div>{{ section.settings.text21 }}</div>
                        <a href="{{ section.settings.url2 }}" class=" access--button button--default landing--btn " data-utm>{{ "general.custom.footer_button" | t }}</a>
                      {% endif %}
                    </div>
                  </div>
                </div>
              {% endif %}
            {% endif %}
         
      
        {%- when "html" -%}
      	<div {% if block.settings.max_width != 0 %}style="max-width: {{ block.settings.max_width  }}px; margin: auto;"{% endif %}>{{ block.settings.html }}</div>
      
        {%- when "divider" -%}
          {% if block.settings.max_width != 0 %}<div style="padding-top: {{ block.settings.max_width | divided_by: 2 }}px;"></div>{% endif %}
          <div class="divider--wrapper">
            {% if block.settings.logo != blank %}
            <img {% if block.settings.max_width != 0 %}style="max-height: {{ block.settings.max_width }}px;"{% endif %} class="Image--lazyLoad footer-logo" {% include "img_attr", image: block.settings.logo %}>
            {% endif %}
            
            {% if block.settings.logo_svg != blank %}
            <div style="max-height: {{ block.settings.max_width }}px; color: {{ block.settings.section_text }};" class="svg--wrapper footer-logo">{{  block.settings.logo_svg }}</div>
            {% endif %}
            
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="5 0 1980 100">
              <defs/>
              <path fill="{{ block.settings.section_background_divider }}" stroke-width="0" d="M1 23l98-1 163 1 335-12 134-4 120-2h63l209 4 357 13h216l40 1 126 7 129 10v60H-9z"/>
            </svg>
          </div>
      {%- endcase -%}
    </div>
    {%- endfor -%}
  </div>
</footer>

{% schema %}
{
  "name": "Footer",
  "class": "shopify-section--footer",
  "enabled_on": {
    "groups": ["footer"]
  },
  "settings": [
    
    {
      "type": "header",
      "content": "Location"
    },
    {
      "type": "text",
      "id": "location_heading",
      "label": "Heading",
      "default": "Are you in the right place?"
    },
    {
      "type": "url",
      "id": "flag",
      "label": "Flag Image"
    },
    {
      "type": "text",
      "id": "label",
      "label": "label",
      "default": "Global"
    },
    {
      "type": "image_picker",
      "id": "flagGB",
      "label": "Flag Image (UK)"
    },
    {
      "type": "text",
      "id": "labelGB",
      "label": "label",
      "default": "United Kingdom"
    },
    {
      "type": "image_picker",
      "id": "flagCA",
      "label": "Flag Image (CA)"
    },
    {
      "type": "text",
      "id": "labelCA",
      "label": "label",
      "default": "Canada"
    },
    {
      "type": "header",
      "content": "Regular"
    },
    {
      "label": "Text",
      "id": "text1",
      "type": "text"
    },
    {
      "label": "Text (html)",
      "id": "text21",
      "type": "richtext"
    },
	{
      "type": "url",
      "id": "url2",
      "label": "URL (Regular)"
    },
    {
      "type": "header",
      "content": "Compaign"
    },
    {
      "label": "Text",
      "id": "text2",
      "type": "text"
    },
    {
      "label": "Text (html)",
      "id": "text22",
      "type": "richtext"
    },
	{
      "type": "url",
      "id": "url1",
      "label": "URL (Compaign)"
    },
    {
      "type": "checkbox",
      "id": "show_payment_methods",
      "label": "Show payment methods",
      "info": "Payment method icons are automatically displayed based on your Shopify payment methods.",
      "default": true
    },
    {
      "type": "header",
      "content": "Currency selector",
      "info": "To add a currency, go to your [payment settings.](/admin/settings/payments)"
    },
    {
      "type": "checkbox",
      "id": "show_currency_selector",
      "label": "Show currency selector",
      "default": true
    },
    {
      "type": "header",
      "content": "Language selector",
      "info": "To add a language, go to your [language settings.](/admin/settings/languages)"
    },
    {
      "type": "checkbox",
      "id": "show_locale_selector",
      "label": "Show language selector",
      "default": true
    }
  ],
  "blocks": [
    {
      "type": "text",
      "name": "Text / social media",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Heading",
          "default": "About the shop"
        },
        {
          "type": "richtext",
          "id": "content",
          "label": "Text",
          "default": "<p>Use this text area to tell your customers about your brand and vision. You can change it in the theme settings.</p>"
        },
        {
          "type": "checkbox",
          "id": "show_social_media",
          "label": "Show social media",
          "info": "Make sure to have properly configured your social media in the theme settings.",
          "default": true
        },
        {
          "type": "color",
          "id": "section_background",
          "label": "Section Background"
        },
        {
          "type": "color",
          "id": "section_text",
          "label": "Section Text"
        },
        {
          "type": "color",
          "id": "section_accent",
          "label": "Section Accent"
        }
      ]
    },
    {
      "type": "menu",
      "name": "Menu",
      "settings": [
        {
          "type": "link_list",
          "id": "menu",
          "label": "Menu",
          "info": "This menu won't show dropdown items."
        },
        {
          "type": "color",
          "id": "section_background",
          "label": "Section Background"
        },
        {
          "type": "color",
          "id": "section_text",
          "label": "Section Text"
        },
        {
          "type": "color",
          "id": "section_text_2",
          "label": "Section Text 2"
        },
        {
          "type": "color",
          "id": "section_accent",
          "label": "Section Accent"
        }
      ]
    },
    {
      "type": "newsletter",
      "name": "Newsletter",
      "limit": 1,
      "settings": [
        {
          "type": "range",
          "id": "max_width",
          "label": "Max width",
          "min": 0,
          "max": 2000,
          "step": 50,
          "default": 0,
          "info": "0 -> Default size"
        },
        {
          "type": "color",
          "id": "section_background",
          "label": "Section Background"
        },
        {
          "type": "color",
          "id": "section_text",
          "label": "Section Text"
        },
        {
          "type": "color",
          "id": "section_accent",
          "label": "Section Accent"
        },
        {
          "type": "color",
          "id": "section_button_text",
          "label": "Button text"
        },
        {
          "type": "color",
          "id": "section_button_bg",
          "label": "Button background"
        }
      ]
    },
    {
      "type": "html",
      "name": "Html",
      "settings": [
        {
          "type": "html",
          "id": "html",
          "label": "Html"
        },
        {
          "type": "range",
          "id": "max_width",
          "label": "Max width",
          "min": 0,
          "max": 2000,
          "step": 50,
          "default": 0,
          "info": "0 -> Default size"
        },
        {
          "type": "color",
          "id": "section_background",
          "label": "Section Background"
        },
        {
          "type": "color",
          "id": "section_text",
          "label": "Section Text"
        },
        {
          "type": "color",
          "id": "section_accent",
          "label": "Section Accent"
        },
        {
          "type": "color",
          "id": "section_button_text",
          "label": "Button text"
        },
        {
          "type": "color",
          "id": "section_button_bg",
          "label": "Button background"
        }
      ]
    },
    {
      "type": "divider",
      "name": "Divider",
      "limit": 1,
      "settings": [
        {
          "label": "Logo",
          "id": "logo",
          "type": "image_picker"
        },
        {
          "label": "SVG logo",
          "id": "logo_svg",
          "type": "html"
        },
        {
          "type": "range",
          "id": "max_width",
          "label": "Max logo height",
          "min": 0,
          "max": 150,
          "step": 5,
          "default": 0,
          "info": "0 -> Default size"
        },
        {
          "type": "color",
          "id": "section_background",
          "label": "Section Background"
        },
        {
          "type": "color",
          "id": "section_background_divider",
          "label": "Section Background"
        },
        {
          "type": "color",
          "id": "section_text",
          "label": "Section icons"
        }
      ]
    },
    {
      "type": "meta",
      "name": "Meta",
      "limit": 1,
      "settings": [
        {
          "type": "color",
          "id": "section_background",
          "label": "Section Background"
        },
        {
          "type": "color",
          "id": "section_text",
          "label": "Section Text"
        },
        {
          "type": "color",
          "id": "section_accent",
          "label": "Section Accent"
        }
      ]
    }
  ],
  "default": {
    "blocks": [
      {
        "type": "text",
        "settings": {}
      },
      {
        "type": "newsletter",
        "settings": {}
      }
    ]
  }
}
{% endschema %}