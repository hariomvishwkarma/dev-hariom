{% assign ss = section.settings %}

{%- capture section_container -%}
  {%- case ss.container -%}
    {%- when 'default' -%}
    container
    {%- when 'wide' -%}
    container--wide
    {%- when 'full' -%}
    container--full_width
  {%- endcase -%}
{%- endcapture -%}

{%- capture section_container_style -%}
  {% if ss.custom_width != 0 and ss.custom_width %}style="max-width: {{ ss.custom_width }}px;"{% endif %}
{%- endcapture -%}

{%- capture section_style -%}
  {% if ss.section_padding != blank %}--section-padding: {{ ss.section_padding }}rem;{% endif %}
  {% if ss.section_margin != blank %}--section-margin: {{ ss.section_margin }}rem;{% endif %} 
  {% if ss.section_background != blank %}--section-background: {{ ss.section_background }};{% endif %}  
  {% if ss.content_padding != blank %}--content-padding: {{ ss.content_padding }}rem;{% endif %} 
  {% if ss.content_margin != blank %}--content-margin: {{ ss.content_margin }}rem;{% endif %} 
  {% if ss.content_background != blank %}--content-background: {{ ss.content_background }};{% endif %}
  {% if ss.content_text != blank %}--content-colour: {{ ss.content_text }};{% endif %}
  {% if ss.content_accent != blank %}--content-accent: {{ ss.content_accent }};{% endif %}
{%- endcapture -%}

{%- unless settings.compaign -%}
<section
  data-section="popup_landing"
  id="section--{{ section.id }}" 
  style="{{ section_style | remove: " " | strip_newlines }}"
  class="section--wrapper">
    
  <div class="{{ section_container }}">
    <div class="popup--inner">
      {% for block in section.blocks %}
        {%- case block.type -%}
          {%- when 'main' -%}
      		<div class="popup-main">
              <div>
                {% if block.settings.heading_1 != blank %}<h2>{{ block.settings.heading_1 }}</h2>{% endif %}
                {% if block.settings.heading_2 != blank %}<p>{{ block.settings.heading_2 }}</p>{% endif %}
                {% if block.settings.form != blank %}{{ block.settings.form }}{% endif %}
              </div>
      		</div>
        {%- endcase -%}
      {% endfor %}
    </div>
  </div>

  <div class="slider">
    <div class="{{ section_container }}">
      <h2>JOIN THE MOVEMENT FOR A GREENER FUTURE</h2>
      <div class="swiper">
        <div class="swiper-wrapper">
          {% for block in section.blocks %}
            {%- case block.type -%}
              {%- when 'imagest' -%}
                {% assign bs = block.settings %}
                <div class="swiper-slide">
                  <div>
                    <div class="image--wrapper">
                        <img class="Image--lazyLoad" data-src="{{ bs.image | img_url: "250x" }}">
                        <span>{{ bs.label }}</span>
                    </div>

                    <div class="text--wrapper">
                      {{ bs.text }}
                    </div>
                  </div>
                </div>
            {%- endcase -%}
          {% endfor %}
          
        </div>
      </div>

      <script>
        new Swiper('#section--{{ section.id }} .swiper', {
          loop: true,
          slidesPerView: "auto",
          spaceBetween: 16,
        
          freeMode: true,

        });
      </script>
    </div>
  </div>
</section>
{% render 'landing-page-cookie-tracker' %}
{%- endunless -%}

{% schema %}
  {
    "name": "Landing page",
    "settings": [
      {
        "type": "paragraph",
        "content": "Colours:"
      },
      {
        "type": "color",
        "id": "section_background",
        "label": "Section Background"
      },
      {
        "type": "color",
        "id": "content_background",
        "label": "Content Background"
      },
      {
        "type": "color",
        "id": "content_text",
        "label": "Content Text"
      },
      {
        "type": "color",
        "id": "content_accent",
        "label": "Content Accent"
      },
      {
        "type": "paragraph",
        "content": "Spacing:"
      },
      {
         "type":      "radio",
         "id":        "container",
         "label":     "Section width:",
         "options": [
           { "value": "default", "label": "Default" },
           { "value": "wide", "label": "Wide" },
           { "value": "full", "label": "Full" }
         ],
        "default":   "default"
      },
      {
        "type": "range",
        "id": "custom_width",
        "label": "Custom width",
        "min": 0,
        "max": 2500,
        "step": 50,
        "default": 0,
        "info": "0 - disabled"
      },
      {
        "type": "range",
        "id": "section_margin",
        "label": "Section Margin: Bottom",
        "min": -10,
        "max": 10,
        "step": 0.5,
        "default": 0
      },
      {
        "type": "range",
        "id": "section_padding",
        "label": "Section Padding: Top/Bottom",
        "min": 0,
        "max": 10,
        "step": 0.5,
        "default": 0
      },
      {
        "type": "range",
        "id": "content_margin",
        "label": "Content Margin",
        "min": 0,
        "max": 10,
        "step": 0.5,
        "default": 0
      },
      {
        "type": "range",
        "id": "content_padding",
        "label": "Content Padding: All",
        "min": 0,
        "max": 10,
        "step": 0.5,
        "default": 0
      }
	],
    "blocks": [
      {
        "type": "imagest",
        "name": "Image",
        "settings": [
          {
            "label": "Image",
            "id": "image",
            "type": "image_picker"
          },
          {
            "label": "Text 2",
            "id": "text",
            "type": "richtext"
          },	
          {
            "label": "Label",
            "id": "label",
            "type": "text"
          }
        ]
      },
      {
        "type": "main",
        "name": "Main",
        "settings": [
          {
            "label": "Heading 1",
            "id": "heading_1",
            "type": "text"
          },	
          {
            "label": "Heading 2",
            "id": "heading_2",
            "type": "text"
          },	
          {
            "label": "Form",
            "id": "form",
            "type": "html"
          }
        ]
      }
    ]
  }
{% endschema %}

{% stylesheet %}
{% endstylesheet %}

{% javascript %}
{% endjavascript %}
