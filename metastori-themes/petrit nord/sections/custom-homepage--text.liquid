{% assign ss = section.settings %}

{%- capture container_class -%}
  {%- case ss.width -%}
    {%- when 'default' -%}
	container
    {%- when 'full' -%}
	container--full
    {%- when 'wide' -%}
	container--wide
        {%- when 'full_with' -%}
        container--full_width
  {%- endcase -%}
{%- endcapture -%}

<style>
  @media only screen and (min-width: 720px) {
    #section--{{ section.id }} .section--inner {
      background-image: url({{ ss.background_full | img_url: "master" }});
    }

    #section--{{ section.id }} .section-background {
      padding-bottom: {{ ss.bg_size_bottom }}%;
    }
  }
  
  @media only screen and (max-width: 720px) {
    #section--{{ section.id }} {
      background-image: url({{ ss.background_full_m | img_url: "master" }});
      background-position: center;
    }
    
    #section--{{ section.id }} .section-background {
      padding-bottom: {{ ss.m_bg_size }}%;
    }
  }
</style>

<section id="section--{{ section.id }}" data-section="text-homepage" style="background-color: {{ ss.section_background }};" class="index-section section--wrapper margin-bottom--{{ ss.section_margin | remove: "." }} padding--{{ ss.section_padding | remove: "." }}">
  <div class="{{ container_class }}">
    <div style="background-color: {{ ss.content_background }}; color: {{ ss.content_text }};" class="section--inner padding--{{ ss.content_padding | remove: "." }}">
      <div class="section-content">
        
        <div class="section-background"></div>
        
        <div class="background--wrapper">
        	<div {% if ss.text-width != 0 %}style="max-width: {{ ss.text-width }}px; margin: auto;"{% endif %} class="text--wrapper {% if ss.center %}text--center{% endif %}">{{ section.settings.text }}</div>
        </div>
        
        <div class="section-background"></div>
      </div>
    </div>
  </div>
</section>

{% schema %}
  {
    "name": "Text",
    "settings": [
      {
        "type": "header",
        "content": "Desktop Backgrounds"
      },

      {
        "label": "Background",
        "id": "background_full",
        "type": "image_picker"
      },
      {
        "type": "range",
        "id": "bg_size_bottom",
        "label": "Content spacing",
        "min": 0,
        "max": 100,
        "step": 1,
        "default": 50
      },
      {
        "type": "header",
        "content": "Mobile Backgrounds"
      },


      {
        "label": "Background",
        "id": "background_full_m",
        "type": "image_picker"
      },

      {
        "type": "range",
        "id": "m_bg_size",
        "label": "Background size",
        "min": 0,
        "max": 100,
        "step": 1,
        "default": 50
      },
      {
        "label": "Text",
        "id": "text",
        "type": "richtext"
      },
      {
        "type": "range",
        "id": "text-width",
        "label": "Text width",
        "min": 0,
        "max": 2000,
        "step": 50,
        "default": 0
      },
      {
        "type": "checkbox",
        "id": "center",
        "label": "Center",
        "default": false
      },
      {
        "type": "header",
        "content": "Colours"
      },
      {
        "type": "color",
        "id": "section_background",
        "label": "Section Background"
      },
      {
        "type": "color",
        "id": "content_background",
        "label": "Content Background"
      },
      {
        "type": "color",
        "id": "content_text",
        "label": "Content Text"
      },
      {
        "type": "header",
        "content": "Spacing"
      },
      {
         "type":      "radio",
         "id":        "width",
         "label":     "Width:",
         "options": [
           { "value": "default", "label": "Default" },
           { "value": "wide", "label": "Wide" },
           { "value": "full", "label": "Full" },
           { "value": "full_with", "label": "Full with padding" }
         ],
        "default":   "default"
      },
      {
        "type": "range",
        "id": "section_margin",
        "label": "Section Margin: Bottom",
        "min": 0,
        "max": 5,
        "step": 0.5,
        "default": 0
      },
      {
        "type": "range",
        "id": "section_padding",
        "label": "Section Padding: Top/Bottom",
        "min": 0,
        "max": 5,
        "step": 0.5,
        "default": 0
      },
      {
        "type": "range",
        "id": "content_padding",
        "label": "Content Padding: All",
        "min": 0,
        "max": 5,
        "step": 0.5,
        "default": 0
      }
	],
    "presets": [
      {
        "name": "Text",
        "category": "Custom Sections"
      }
    ]
  }
{% endschema %}