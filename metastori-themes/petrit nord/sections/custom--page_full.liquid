{% assign ss = section.settings %}

<style>
  #section-{{ section.id }}.landing--background {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-size: cover;
    background-position: center center;
    background-repeat: no-repeat;
    min-height: 100vh;
    display: flex;
    justify-content: center;
    align-items: center;
  }
  
  #section-{{ section.id }}.landing--background li {
    text-align: center;
    list-style: none;
    padding: 1vw;
    padding: 0 0;
  }
  
  @media (max-width: 767px) {
    #section-{{ section.id }}.landing--background li {
      padding: 8px;
    }
  }
    
  #section-{{ section.id }}.landing--background h2 {
    color: rgba(255, 255, 255, 1);
    font-size: 1.4rem;
    margin-bottom: 2rem;
  }
  
  #section-{{ section.id }}.landing--background h1 {
    color: rgba(255, 255, 255, 1);
    font-weight: bold;
    font-size: 1.6rem;
  }
  
  #section-{{ section.id }}.landing--background a {
    
  }
  
  #section-{{ section.id }}.landing--background a:hover {
    
  }
  
  
  #section-{{ section.id }}.landing--background .countries-list__item {
    display: -webkit-flex;
    display: -ms-flexbox;
    display: flex;
    width: 100%;
    -ms-flex-align: center;
    -webkit-align-items: center;
    -moz-align-items: center;
    -ms-align-items: center;
    -o-align-items: center;
    align-items: center;
    -webkit-justify-content: center;
    -ms-justify-content: center;
    justify-content: center;
    transition: 250ms all ease-in-out;
    padding: 15px 20px;
  }
  
  #section-{{ section.id }}.landing--background .countries-list__flag {
    width: 28px;
    height: 28px;
    border-radius: 0;
    overflow: hidden;
    flex-shrink: 0;
    position: relative;
  }
  
  #section-{{ section.id }}.landing--background .countries-list__flag .image--wrapper {
    height: 100%;
  }
  
  #section-{{ section.id }}.landing--background .countries-list__flag .image--wrapper img {
    height: 100%;
    object-fit: cover;
  }
  
  #section-{{ section.id }}.landing--background .countries-list__cta {
    flex: 2;
    text-align: left;
    padding-left: 10px;
    margin-bottom: 0;
    white-space: nowrap;
    color: #fff;
  }
  
  #section-{{ section.id }}.landing--background .countries-list__item:not(:last-child) {
    border-bottom: #fff solid 1px;
  }
  
  [data-template="page.full_screen"] .PageContainer {
    position: relative;
    z-index: 999999999999;
  }
  
  .doubly-float, #chat-widget-container, [title="chat widget"], .CozyContainerClassCR {
    display: none !important;
    opacity: 0 !important;
    pointer-events: none;
  }
</style>
  
<div id="section-{{ section.id }}" class="landing--background" style="background-image: linear-gradient(rgba(5, 5, 5, 0.4), rgba(5, 5, 5, 0.4)), url({{ ss.bg | img_url: "master" }});">
  <div style="width: 100%;max-width: 300px;">
    <ul>
      {% if ss.logo != blank %}<li><img style="max-width: 200px; margin: 0 auto 3rem auto;" src="{{ ss.logo | img_url: "1000x" }}" /></li>{% endif %}
      <li>
        <h1>{{ ss.heading_1 }}</h1>
        <h2>{{ ss.heading_2 }}</h2>
      </li>
      
      <li>
        <div class="countries-list">
          {% for block in section.blocks %}
            <a class="countries-list__item" href="{{ block.settings.url }}?SkipCozyRedirect=yes" target="_self">
              <div class="countries-list__flag">
                <div class="image--wrapper">
                  <img class="Image--lazyLoad" {% include "img_attr", image: block.settings.image %}>
                </div>
              </div>
              <div class="countries-list__cta Heading u-h7 Text--subdued">
                {{ block.settings.text }}
              </div>
            </a>
          {% endfor %}
        </div>
      </li>
      

    </ul>
  </div>
</div>

{% schema %}
  {
    "name": "Main",
    "settings": [

      {
        "label": "Background",
        "id": "bg",
        "type": "image_picker"
      },
      {
        "type": "text",
        "id": "heading_1",
        "label": "Heading 1"
      },
      {
        "type": "text",
        "id": "heading_2",
        "label": "Heading 2"
      },
      {
        "label": "Logo",
        "id": "logo",
        "type": "image_picker"
      }
	],
    "blocks": [
      {
        "type": "location",
        "name": "Location",
        "settings": [
          {
            "label": "Icon",
            "id": "image",
            "type": "image_picker"
          },
          {
            "label": "Title",
            "id": "text",
            "type": "text"
          },
          {
            "label": "URL",
            "id": "url",
            "type": "url"
          }
        ]
      }
    ]
  }
{% endschema %}

{% stylesheet %}
{% endstylesheet %}

{% javascript %}
{% endjavascript %}
