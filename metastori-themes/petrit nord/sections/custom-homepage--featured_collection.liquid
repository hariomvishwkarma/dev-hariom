{% assign ss = section.settings %}

{%- capture section_style -%}
  {% if ss.section_background_image != blank %}background-image: linear-gradient(rgba(34, 44, 38, 0.55), rgba(34, 44, 38, 0.55)), url({{ ss.section_background_image | img_url: "1500x" }});{% endif %}
  {% if ss.section_background != blank %}background-color: {{ ss.section_background }};{% endif %}
  {% if ss.section_padding != blank %}--section-padding: {{ ss.section_padding }}rem;{% endif %}
  {% if ss.section_margin != blank %}--section-margin: {{ ss.section_margin }}rem;{% endif %} 
  {% if ss.section_background != blank %}--section-background: {{ ss.section_background }};{% endif %}  
  {% if ss.content_padding != blank %}--content-padding: {{ ss.content_padding }}rem;{% endif %} 
  {% if ss.content_margin != blank %}--content-margin: {{ ss.content_margin }}rem;{% endif %} 
  {% if ss.content_background != blank %}--content-background: {{ ss.content_background }};{% endif %}
  {% if ss.content_text != blank %}--content-colour: {{ ss.content_text }};{% endif %}
  {% if ss.content_accent != blank %}--content-accent: {{ ss.content_accent }};{% endif %}
  {%- if ss.mobile_mod != blank -%}--section-mobile-modifier: {{ ss.mobile_mod }};{%- endif -%}
  {%- if ss.button_text != blank -%}--section-button-text: {{ ss.button_text }};{%- endif %}
  {%- if ss.button_background != blank -%}--section-button-background: {{ ss.button_background }};{%- endif %}
{%- endcapture -%}

{%- assign featured_collection = collections[ss.collection] -%}
{%- assign product_count = 4 -%}

<section id="section--{{ section.id }}" data-section="homepage_featured_collection" style="{{ section_style | remove: " " | strip_newlines }}" class="index-section section--wrapper section--updated">
  <div class="container--{{ ss.width }}">
    <div style="background-color: {{ ss.content_background }}; color: {{ ss.content_text }};" class="section--inner">
      <div class="section-content">
        <div class="content--wrapper">
  
          {% if ss.subheading != blank or ss.heading != blank %}
          <div class="section-header text--center">
            <h2><span>{{ ss.heading }}</span></h2>
            <h3><span>{{ ss.subheading }}</span></h3>
          </div>
          {% endif %}

          <div class="ProductList product--wrapper">
            {%- for product in featured_collection.products -%}
              {% if product_count == 0 %}{% break %}{% endif %}
              {% unless product.tags contains "hide" %}
                {%- assign product_count = product_count | minus: 1 -%}
                <div class="product-item" data-product="{{ product.title | replace: " ", "+" }}">
                  <a href="{{ product.url }}" class="product--inner">
                    <div class="image--wrapper {% if ss.image_size == 0 %}default-size{% endif %}">
                      <img class="Image--lazyLoad" {% include "img_attr", image: product.featured_image, size: 600 %}>
                      {% if product.media[1] != blank %}
                        <img class="Image--lazyLoad hide image--hover" {% include "img_attr", image: product.media[1], size: 600 %}>
                      {% endif %}
                    </div>
                    
                    <div class="product-review hide">
                      <div class="loox-rating" data-id="{{ product.id }}" data-rating="{{ product.metafields.loox.avg_rating }}" data-raters="{{ product.metafields.loox.num_reviews }}"></div>
                      <div class="custom-label">({{ product.metafields.loox.num_reviews }} Reviews)</div>
                    </div>
                    
                    <div class="product-title">{{ product.title }}</div>
  
                    <div class="product-price">
                      {%- if product.price_varies == false %} 
                        
                        {% if product.compare_at_price != blank %}
                          <span class="money">{{ product.price | money }}</span> <span style="text-decoration: line-through; margin-left: 0px;color: #9d9d9d;font-size: 11px;font-weight: 400;">{{ product.compare_at_price | money }}</span>
                        {% else %}
                        	{{ product.price | money }}
                        {% endif %}
                      {% else %}
                        {{- 'general.custom.product_item_varies' | t -}} {{ product.price_min | money }}
                      {% endif -%}
                    </div>
                  </a>
                  
                  <div class="product-options">
                    <div>
                      <div class="product-sizes">
                        <span class="title">{{- 'general.custom.product_item_options' | t -}}</span>
                        <ul class="product-variants">
                        </ul>
                      </div>
                    </div>
                  </div>
              </div>
              {% endunless %}
            {%- endfor -%}
          </div>
          
          {% if ss.button != blank %}
          <div class="button--wrapper">
            {{ ss.button | replace: "<a ", "<a class='button--default'" }}
          </div>
          {% endif %}
        </div>
      </div>
    </div>
  </div>
</section>

{% schema %}
  {
    "name": "Custom: Featured coll.",
    "settings": [
          {
            "label": "Collection",
            "id": "collection",
            "type": "collection"
          },
          {
            "label": "Heading",
            "id": "heading",
            "type": "text"
          },
          {
            "label": "Subheading",
            "id": "subheading",
            "type": "text"
          },
          {
            "label": "Button",
            "id": "button",
            "type": "richtext"
          },
          {
            "type": "header",
            "content": "Colours"
          },
          {
            "type": "color",
            "id": "section_background",
            "label": "Section Background"
          },
          {
            "type": "color",
            "id": "content_background",
            "label": "Content Background"
          },
          {
            "type": "color",
            "id": "content_text",
            "label": "Content Text"
          },
          {
            "type": "color",
            "id": "content_accent",
            "label": "Accent"
          },
          {
            "type": "color",
            "id": "button_text",
            "label": "Button: Text"
          },
          {
            "type": "color",
            "id": "button_background",
            "label": "Button: Background"
          }, 
          {
            "type": "header",
            "content": "Spacing"
          },
          {
             "type":      "select",
             "id":        "width",
             "label":     "Width: Section",
             "options": [
               { "value": "default", "label": "Default" },
               { "value": "wide", "label": "Wide" },
               { "value": "padding", "label": "Padding" },
               { "value": "full", "label": "Full" }
             ],
            "default":   "default"
          },
          {
            "type": "range",
            "id": "section_margin",
            "label": "Section Margin: Bottom",
            "min": -10,
            "max": 10,
            "step": 0.5,
            "default": 0
          },
          {
            "type": "range",
            "id": "section_padding",
            "label": "Section Padding: Top/Bottom",
            "min": 0,
            "max": 10,
            "step": 0.5,
            "default": 0
          },
          {
            "type": "range",
            "id": "content_padding",
            "label": "Content Padding: All",
            "min": 0,
            "max": 10,
            "step": 0.5,
            "default": 0
          },
          {
            "type": "range",
            "id": "mobile_mod",
            "label": "Mobile Modifier",
            "min": 1,
            "max": 5,
            "step": 0.1,
            "default": 2
          }
	],
    "presets": [
      {
        "name": "Custom: Featured coll.",
        "category": "Custom Sections"
      }
    ]
  }
{% endschema %}
