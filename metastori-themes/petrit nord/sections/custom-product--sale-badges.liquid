{% assign show_badges = false %}
{% if settings.coll_badge_1 != blank and settings.coll_handles_1 != blank %}
  {% assign splitList = settings.coll_handles_1 | split: "," %}
  {%- for collectionProduct in product.collections -%}
    {% if splitList contains collectionProduct.handle %}
    {% assign show_badges = true %}
    {% endif %}
  {%- endfor -%}
{% endif %}

{% if settings.coll_badge_2 != blank and settings.coll_handles_2 != blank %}
  {% assign splitList = settings.coll_handles_2 | split: "," %}
  {%- for collectionProduct in product.collections -%}
    {% if splitList contains collectionProduct.handle %}
    {% assign show_badges = true %}
    {% endif %}
  {%- endfor -%}
{% endif %}

{% if settings.coll_badge_3 != blank and settings.coll_handles_3 != blank %}
  {% assign splitList = settings.coll_handles_3 | split: "," %}
  {%- for collectionProduct in product.collections -%}
    {% if splitList contains collectionProduct.handle %}
    {% assign show_badges = true %}
    {% endif %}
  {%- endfor -%}
{% endif %}

<span id="saleColls" hidden>{%- for collection in product.collections -%}{{ collection.handle }}{% unless forloop.last %},{% endunless %}{%- endfor -%}</span>
<span id="saleTest" hidden>[{{ show_badges }}]</span>

{% schema %}
{
  "name": "Product Sale Badges",
  "settings": []
}
{% endschema %}
