{% assign ss = section.settings %}

{%- capture container_class -%}
  {%- case ss.width -%}
    {%- when 'default' -%}
	container
    {%- when 'full' -%}
	container--full
    {%- when 'wide' -%}
	container--wide
        {%- when 'full_with' -%}
        container--full_width
  {%- endcase -%}
{%- endcapture -%}

{% assign font-width = 100 %}
{%- case ss.width -%}
  {%- when 'default' -%}
	{% assign font-width = 50 %}
  {%- when 'wide' -%}
	{% assign font-width = 70 %}
{%- endcase -%}
<style>
 @media only screen and (min-width: 1240px) {  
    #section--{{ section.id }} .grid--wrapper {
      font-size: {{ settings.base_text_font_size | times: 0.625 | times: 2 | divided_by: section.blocks.size }}px !important;
    }
 }
 @media only screen and (max-width: 1240px) {  
    #section--{{ section.id }} .grid--wrapper {
      font-size: 21vw !important;
    }
 }
 @media only screen and (max-width: 720px) {  
    #section--{{ section.id }} .grid--wrapper {
      font-size: 18vw !important;
    }
 }
</style>

<style>
  @media only screen and (min-width: 720px) {
    #section--{{ section.id }} .section--inner {
      background-image: url({{ ss.background_full | img_url: "master" }});
    }
  }
  
  @media only screen and (max-width: 720px) {
    #section--{{ section.id }} {
      background-image: url({{ ss.background_full_m | img_url: "master" }});
      background-position: center;
    }
  }
</style>

<section id="section--{{ section.id }}" data-section="boxes" style="background-color: {{ ss.section_background }};" class="index-section section--wrapper margin-bottom--{{ ss.section_margin | remove: "." }} padding--{{ ss.section_padding | remove: "." }}">
  <div class="{{ container_class }}">
    <div style="background-color: {{ ss.content_background }}; color: {{ ss.content_text }};" class="section--inner padding--{{ ss.content_padding | remove: "." }}">
      <div class="section-content grid--outer">
          {% if ss.image_size != 0 %}
          <style>
            #section--{{ section.id }} .image--wrapper:before {
              padding-bottom: {{ ss.image_size }}% !important;
            }
          </style>
          {% endif %}
        <ul style="font-size: {{ font-width | divided_by: section.blocks.size }}vw;" class="grid--wrapper">
          {% for block in section.blocks %}
            <li class="grid--item">
              <div class="content--group">
                <div style="color: {{ section.settings.content_accent }};" class="image--wrapper {% if ss.image_size == 0 %}default-size{% endif %}">
                  <img class="Image--lazyLoad" {% include "img_attr", image: block.settings.image, size: 600 %}>
                  <a style="color: {{ section.settings.content_text }};" {% if block.settings.url != blank %}href="{{ block.settings.url }}"{% endif %} class="image--overlay">
                    <h3>{{ block.settings.title }}</h3>
                  </a>
                  <span class="image--decoration"></span>
                  {% if block.settings.border_text %}
                  <span class="image--text {% if block.settings.vertical %}vertical{% endif %}">
                    {% if block.settings.vertical %}
                    {% assign split_words = block.settings.border_text | split: " " %}
                    	<div>{% for word in split_words %}<span class="text">{{ word }}</span>{% endfor %}</div>
                    {% else %}
                    	<div><span class="text">{{ block.settings.border_text }}</span></div>
                    {% endif %}
                  </span>
                  {% endif %}
                </div>
              </div>
            </li>
          {% endfor %}
        </ul>
      </div>
    </div>
  </div>
</section>

{% schema %}
  {
    "name": "Boxes",
    "settings": [
      {
        "type": "header",
        "content": "Desktop Backgrounds"
      },

      {
        "label": "Background",
        "id": "background_full",
        "type": "image_picker"
      },
      {
        "type": "header",
        "content": "Mobile Backgrounds"
      },
      {
        "label": "Background",
        "id": "background_full_m",
        "type": "image_picker"
      },

      {
        "label": "Heading",
        "id": "heading",
        "type": "text"
      },
      {
        "type": "range",
        "id": "image_size",
        "label": "Custom Image height",
        "min": 0,
        "max": 300,
        "step": 5,
        "default": 0,
        "info": "0 -> Default size"
      },
      {
        "type": "header",
        "content": "Colours"
      },
      {
        "type": "color",
        "id": "section_background",
        "label": "Section Background"
      },
      {
        "type": "color",
        "id": "content_background",
        "label": "Content Background"
      },
      {
        "type": "color",
        "id": "content_text",
        "label": "Content Text"
      },
      {
        "type": "color",
        "id": "content_accent",
        "label": "Accent"
      },
      {
        "type": "header",
        "content": "Spacing"
      },
      {
         "type":      "radio",
         "id":        "width",
         "label":     "Width:",
         "options": [
           { "value": "default", "label": "Default" }

         ],
        "default":   "default"
      },
      {
        "type": "range",
        "id": "section_margin",
        "label": "Section Margin: Bottom",
        "min": 0,
        "max": 5,
        "step": 0.5,
        "default": 0
      },
      {
        "type": "range",
        "id": "section_padding",
        "label": "Section Padding: Top/Bottom",
        "min": 0,
        "max": 5,
        "step": 0.5,
        "default": 0
      },
      {
        "type": "range",
        "id": "content_padding",
        "label": "Content Padding: All",
        "min": 0,
        "max": 5,
        "step": 0.5,
        "default": 0
      }
	],
    "blocks": [
      {
        "type": "image",
        "name": "Image",
        "limit": 2,
        "settings": [
          {
            "label": "Image",
            "id": "image",
            "type": "image_picker"
          },
          {
            "label": "Title",
            "id": "title",
            "type": "text"
          },
          {
            "label": "Border text",
            "id": "border_text",
            "type": "text"
          },
          {
            "type": "checkbox",
            "id": "vertical",
            "label": "Border text vertical",
            "default": false
          },
          {
            "label": "URL",
            "id": "url",
            "type": "url"
          }
        ]
      }
    ],
    "presets": [
      {
        "name": "Boxes",
        "category": "Custom Sections"
      }
    ]
  }
{% endschema %}
