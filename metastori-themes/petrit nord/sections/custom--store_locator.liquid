<div id="locationModal" class="modal--container modal--fixed" data-modal="store_locator">
  <div class="overlay"></div>

  <div class="modal--wrapper">
    <div style="background: {{ section.settings.content_background }}; color: {{ section.settings.content_text }};" class="modal--inner">
      <div class="shop-switch shop-switch__stores">
        <div class="modal-text">
          <h5 class="modal-heading"> {{ section.settings.heading }}</h5>
          <p class="modal-subheading"> {{ section.settings.subheading }}</p>

          <div class="countries-list">
            {% for block in section.blocks %}

              {% if block.settings.link_type == 'currency' %}

                {%- form 'currency', class: 'countries-list__currency-form' -%}
                  <input type="hidden" name="currency_code" value="{{ block.settings.currency_code }}">
                  <button type="submit" class="countries-list__item countries-list__item--button js-currency-switch" {{ block.shopify_attributes }}>
                    <div class="countries-list__flag">
                      <div class="image--wrapper">
                        <img class="Image--lazyLoad" {% include "img_attr", image: block.settings.image %}>
                      </div>
                    </div>
                    <div class="countries-list__cta Heading u-h7 Text--subdued">
                      {{ block.settings.text }}
                    </div>
                  </button>
                {%- endform -%}

              {% else %}

                {% assign url = block.settings.url | append: request.path %}
                <a class="countries-list__item" href="{{ url | replace: "://", "|" | replace: "//", "/" | replace: "|", "://" }}?SkipCozyRedirect=yes" target="_self" data-utm {{ block.shopify_attributes }}>
                  <div class="countries-list__flag">
                    <div class="image--wrapper">
                      <img class="Image--lazyLoad" {% include "img_attr", image: block.settings.image %}>
                    </div>
                  </div>
                  <div class="countries-list__cta Heading u-h7 Text--subdued">
                    {{ block.settings.text }}
                  </div>
                </a>

              {% endif %}

            {% endfor %}
          </div>
        </div>

        <div class="">
          <button type="button" class="Link Link--underline js-modal-close">{{- 'general.custom.locator_close' | t -}}</button>
        </div>
      </div>

      <button type="button" class="modal-close js-modal-close">
        <svg class="Icon Icon--close" width="12px" height="12px" viewBox="0 0 12 12" version="1.1" xmlns="http://www.w3.org/2000/svg" xmlns:xlink="http://www.w3.org/1999/xlink">
          <g id="Icon/Close" stroke="none" stroke-width="1" fill="none" fill-rule="evenodd">
            <g id="Group-3" transform="translate(2.000000, 2.000000)" fill="currentColor" fill-rule="nonzero">
              <path d="M0.646446609,0.646446609 C0.841708755,0.451184464 1.15829124,0.451184464 1.35355339,0.646446609 L1.35355339,0.646446609 L4,3.293 L6.64644661,0.646446609 C6.84170876,0.451184464 7.15829124,0.451184464 7.35355339,0.646446609 C7.52711974,0.820012961 7.54640489,1.08943736 7.41140884,1.2843055 L7.35355339,1.35355339 L4.707,4 L7.35355339,6.64644661 L7.41140884,6.7156945 C7.54640489,6.91056264 7.52711974,7.17998704 7.35355339,7.35355339 C7.15829124,7.54881554 6.84170876,7.54881554 6.64644661,7.35355339 L6.64644661,7.35355339 L4,4.707 L1.35355339,7.35355339 C1.15829124,7.54881554 0.841708755,7.54881554 0.646446609,7.35355339 C0.472880258,7.17998704 0.453595107,6.91056264 0.588591159,6.7156945 L0.646446609,6.64644661 L3.293,4 L0.646446609,1.35355339 L0.588591159,1.2843055 C0.453595107,1.08943736 0.472880258,0.820012961 0.646446609,0.646446609 Z" id="Close"></path>
            </g>
          </g>
        </svg>
      </button>
    </div>
  </div>
</div>

<script>

    if(location.search.indexOf("SkipCozyRedirect") > -1) {
      Cookies.set("redirect_popup", "true", { expires: 11 })
    }
    let popupCookie0 = Cookies.get("redirect_popup");

    if(popupCookie0) {

    } else {
      $('#locationModal').addClass("is-active");
    }

    $('body').on("click", "#local--back" ,function(e) {
      Cookies.set("redirect_popup", "true", { expires: 11 })
    });

    $('body').on("click", "#locationModal .js-modal-close" ,function(e) {
      Cookies.set("redirect_popup", "true", { expires: 11 })

    });

    $('body').on("click", "#locationModal .js-currency-switch" ,function(e) {
      Cookies.set("redirect_popup", "true", { expires: 11 })
      // form submits natively — no preventDefault needed
    });
</script>

{% schema %}
  {
    "name": "Store selector",
    "settings": [
      {
        "type": "header",
        "content": "Content"
      },
      {
        "label": "Heading",
        "id": "heading",
        "type": "text"
      },
      {
        "label": "Subheading",
        "id": "subheading",
        "type": "text"
      },
      {
        "type": "header",
        "content": "Colours"
      },
      {
        "type": "color",
        "id": "content_background",
        "label": "Content Background"
      },
      {
        "type": "color",
        "id": "content_text",
        "label": "Content Text"
      },
      {
        "type": "color",
        "id": "content_accent",
        "label": "Accent"
      }
	],
    "blocks": [
      {
        "type": "location",
        "name": "Location",
        "settings": [
          {
            "label": "Icon",
            "id": "image",
            "type": "image_picker"
          },
          {
            "label": "Title",
            "id": "text",
            "type": "text"
          },
          {
            "type": "select",
            "id": "link_type",
            "label": "Switch behavior",
            "options": [
              { "value": "domain", "label": "Redirect to domain" },
              { "value": "currency", "label": "Switch currency only" }
            ],
            "default": "domain",
            "info": "Domain: for DK / FR / EU. Currency: for USA / UK / Canada (stays on this domain)."
          },
          {
            "label": "URL (domain redirect only)",
            "id": "url",
            "type": "url"
          },
          {
            "label": "Currency code (currency type only — e.g. USD, GBP, CAD)",
            "id": "currency_code",
            "type": "text",
            "info": "Only used when Switch behavior = 'Switch currency only'. Must match a currency enabled in Settings > Markets > International > Preferences."
          }
        ]
      }
    ],
    "presets": [
      {
        "name":"Store selector"
      }
    ]
  }
{% endschema %}
