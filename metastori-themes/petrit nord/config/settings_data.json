            }
          },
          "7642836c-5557-42dc-99ce-d74882a92bd0": {
            "type": "images",
            "settings": {
              "image_1": "shopify://shop_images/Section5_Image_crop1.jpg",
              "folded": false,
              "button": "More",
              "section_background": "#faf6ed",
              "content_background": "",
              "content_text": "",
              "content_accent": "",
              "width": "custom",
              "custom_width": 700,
