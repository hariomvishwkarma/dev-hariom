          "c128e711-56db-45bd-813f-aaa1b3f42ea6": {
            "type": "video_2",
            "settings": {
              "button": "<p><a href=\"#\" title=\"#\">Click to see Leonoras favorite tips</a></p>",
              "image": "shopify://shop_images/unnamed_1.jpg",
              "url": "https://cdn.shopify.com/videos/c/o/v/f9aaec83c1da444a81b901fd317109a9.mp4",
              "section_background": "#ba9165",
