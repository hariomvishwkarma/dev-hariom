          "bb0e78e6-594d-48e0-af70-f0d85520518c": {
            "type": "block",
            "settings": {
              "heading": "",
              "text": "<p><strong>1.</strong> Our shoes are handmade in Portugal in small family workshops</p>"
            }
          },
          "0c216a7d-2b66-48b2-83c3-620205a1b600": {
            "type": "block",
            "settings": {
              "heading": "",
              "text": "<p><strong>2.</strong> We design beautiful, practical and sustainable shoes for little feet</p>"
            }
          },
          "c65f7307-158f-437a-b3fe-7ca415eed51c": {
            "type": "block",
            "settings": {
              "heading": "",
              "text": "<p><strong>3.</strong> We craft our shoes, using high quality ecological materials and methods minimizing harmful chemicals.</p>"
            }
          },
          "fc27a674-1a6c-4b46-9f99-dce5bc94d5f9": {
            "type": "block",
            "settings": {
              "heading": "",
              "text": "<p><strong>4.</strong> Our shoes are made to keep up with the magical life of little explorers</p>"
            }
          },
          "22d3e77d-d113-4307-8c4e-f997116b4b9f": {
            "type": "block",
            "settings": {
              "heading": "",
              "text": "<p><strong>5.</strong> We make sure our ethical production includes reusing and upcycling materials.</p>"
            }
          }
        },
