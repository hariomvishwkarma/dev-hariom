          "339b9151-0a9a-4e36-bb9a-3abd338a79d4": {
            "type": "heading",
            "settings": {
              "heading": "",
              "subheading": "",
              "text": "<p><strong>3 TOP TIPS FROM THE PHOTOGRAPHER <br/></strong></p>",
              "width_text": 0,
              "text_size": "3",
              "align": "center",
              "section_background": "#ba9165",
