              "content_padding": 6.5
            }
          },
          "6cfbc2c2-7302-4cde-b11e-d897c03a0111": {
            "type": "seperator",
            "settings": {
              "width_line": 0,
              "section_background": "#faf6ed",
              "content_background": "",
