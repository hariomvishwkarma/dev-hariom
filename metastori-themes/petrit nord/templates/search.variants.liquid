{% layout none %}
{% assign term = search.terms | remove: "title:" | remove: '"' | remove: '"' | handle | remove: 'quot-' | remove: '-quot' %}
{% capture html %}

  {%- for result in search.results  -%}

{% assign temp = result.title | append: '"' | prepend: '"' | handle  %}

{% if temp == term %}
	{% assign option_index = 1 %}
	{% assign option_array = "" %}

	{% for option in result.options_with_values %}
      {% if option.name == settings.size %}
		{% assign option_index = option.position %}
      {% endif %}
	{% endfor %}

	{% for variant in result.variants %}
      {% if option_index == 1 %}
        {% unless option_array contains variant.option1 %}
		{% assign option_array = option_array | append: variant.option1 | append: "," %}
          <li class="{% if variant.available == false %}unavailable{% else %}available{% endif %} {% if variant.inventory_quantity < 5 and variant.inventory_quantity > 0 %}variant-stock{% endif %}" data-test="{{ option_index }}" data-variant="{{ variant.option1 }}">
            <a href="{{ variant.url }}">{{ variant.option1 }}</a>
          </li>
		{% endunless %}
      {% endif %}
      {% if option_index == 2 %}
        {% unless option_array contains variant.option2 %}
		{% assign option_array = option_array | append: variant.option2 | append: "," %}
          <li class="{% if variant.available == false %}unavailable{% else %}available{% endif %} {% if variant.inventory_quantity < 5 and variant.inventory_quantity > 0 %}variant-stock{% endif %}" data-variant="{{ variant.option2 }}">
            <a href="{{ variant.url }}">{{ variant.option2 }}</a>
          </li>
		{% endunless %}
      {% endif %}
      {% if option_index == 3 %}
        {% unless option_array contains variant.option3 %}
		{% assign option_array = option_array | append: variant.option3 | append: "," %}
          <li class="{% if variant.available == false %}unavailable{% else %}available{% endif %} {% if variant.inventory_quantity < 5 and variant.inventory_quantity > 0 %}variant-stock{% endif %}" data-variant="{{ variant.option0 }}">
            <a href="{{ variant.url }}">{{ variant.option3 }}</a>
          </li>
		{% endunless %}
      {% endif %}
    {%- endfor -%}
{% endif %}
  {%- endfor -%}
{% endcapture %}
  
{{ html | json }}