{% layout none %}
<div>

<input type="text" id="input">

<ul id="list">
{%- paginate collection.products by 1000 -%}
  {%- for product in collection.products -%}
  	
  {% if product.handle contains "-a-" %}
  	{% assign altHandle = product.handle | replace: "-a-", "-b-" %}
  {% else %}
  	{% assign altHandle = product.handle | replace: "-b-", "-a-" %}
  {% endif %}
  
  	{% assign sizeTag = "" %}
	{% for tag in product.tags %}
  		{% if tag contains "size:" %}
  			{% assign sizeTag = tag %}
  		{% endif %}
  	{% endfor %}
  
    <li> 
      <b>{{ product.handle }}</b> <br> 
      <span class="title">{{ product.title }}</span> <br> 
      <span>{{ product.handle | split: "-" | first }}</span> <br> 
      <span {% if sizeTag contains altHandle %}{% else %}style="color:red;"{% endif %} class="tags">
		{{ sizeTag }}
      </span>
    </li>
  {%- endfor -%}
{%- endpaginate -%}
</ul>

<style>
  .hide {
    display: none;
  }
</style>

<script>
  document.querySelector("#input").addEventListener("input", function(e) {
    let value = e.target.value.toLowerCase();
    
    document.querySelectorAll("#list li .title").forEach(function(el) {
      let title = el.textContent.toLowerCase();
      let wrapper = el.closest("li");
      
      console.log(title, value);
      
      if(title.indexOf(value) > -1) {
        wrapper.className = "";
      } else {
        wrapper.className = "hide";
      }
    });
  });
</script>