        "text_QMwjdm": {
          "type": "text",
          "settings": {
            "product_list": [
              "p09-11440-burgundy-patent"
            ],
            "text1": "<p><strong>Runs slightly small. </strong>If you’re between sizes, we recommend sizing up</p><p><strong>See the photo for size measurements</strong></p>"
          }
        },
        "e35a81ce-6115-4d21-972c-2a187d6ff5ae": {
          "type": "block",
          "settings": {
            "heading": "",
            "text": "<p>Place a piece of paper on the floor up against a wall. Then place your child’s foot on the paper, so the heel touches the wall. Your child must be standing upright.</p>"
          }
        },
        "0e7af106-5e65-4a90-a33b-6ba1a7757dcb": {
          "type": "block",
          "settings": {
            "heading": "",
            "text": "<p>Mark with a pencil at the tip of the toe. Repeat with the other foot. Measure the length on your paper and use measurement according to the longest foot.</p>"
          }
        },
        "b383715d-7417-4af6-a205-429748cea641": {
          "type": "block",
          "settings": {
            "heading": "",
            "text": "<p>Insert your size in mm or inches with 3 digits into the size helper. Select the recommended and optimal size.</p>"
          }
        },
