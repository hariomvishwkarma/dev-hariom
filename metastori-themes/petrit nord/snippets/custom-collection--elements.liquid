<ul class="collection-elements">
{% if collection.metafields.custom.timer != blank %}
<li class="timer--wrapper" style=" grid-column: 1/-1; grid-row: 5; width: 100%;">
  <section style="background-color: #93776c;  color: #ffffff;" class="padding--35 text--center timer">
    <p><strong>{{ 'general.custom.timer_text_html' | t }}</strong></p>
  </section>
</li>

<style>
  #theme--custom #snize-search-results-grid-mode ul,
  #theme--custom .product-grid {
    display: grid;
  }
</style>

<script>
  const countDownDate = new Date("{{ collection.metafields.custom.timer }}").getTime();
  const countdown = setInterval(function() {
    let now = new Date().getTime();
    let distance = countDownDate - now;
  
    let days = Math.floor(distance / (1000 * 60 * 60 * 24)) + "{{ 'general.custom.timer_days' | t }} ";
    let hours = Math.floor((distance % (1000 * 60 * 60 * 24)) / (1000 * 60 * 60)) + "{{ 'general.custom.timer_hours' | t }} ";
    let minutes = Math.floor((distance % (1000 * 60 * 60)) / (1000 * 60)) + "{{ 'general.custom.timer_minutes' | t }} ";
    let seconds = Math.floor((distance % (1000 * 60)) / 1000) + "{{ 'general.custom.timer_seconds' | t }} ";

    document.querySelectorAll(".timer").forEach(function(el) {
      if(el.querySelector("span")) {
        el.querySelector("span").innerHTML = days + hours + minutes + seconds;
        if (distance < 0) {
          clearInterval(countdown);
          el.style.display = "none";
          el.querySelector("strong").innerHTML = "{{ 'general.custom.timer_expired' | t }}";
        }
      }
    });
  }, 1000);

  </script>
{% endif %}

{% if collection.metafields.custom.featured_review != blank %}
  <li class="featured_review--wrapper" style=" grid-column: 1/-1; grid-row: 8; width: 100%;">
    <section class="padding--35 text--center Product__FeaturedReview">
      <div class="review--wrapper">
        <div class="text--wrapper">
          {{ collection.metafields.custom.featured_review | metafield_tag }}
        </div>
      </div>
    </section>
  </li>
  
<style>
  #theme--custom #snize-search-results-grid-mode ul,
  #theme--custom .product-grid {
    display: grid;
  }
</style>
{% endif %}
</ul>

<style>
  .collection-elements {
    display: none !important;
  }
</style>