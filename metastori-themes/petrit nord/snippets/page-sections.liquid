{% comment %}
/*
 * Page section content
 * ------------------------------------>
 * ss - section.settings
 * blocks - section.blocks
 */
{% endcomment %}

{% for block in blocks %}
	{% assign bs = block.settings %}
    {%- capture container_class -%}
      {%- case bs.width -%}
        {%- when 'default' -%}
        container
        {%- when 'full' -%}
        container--full
        {%- when 'full_with' -%}
        container--full_width
        {%- when 'wide' -%}
        container--wide
      {%- endcase -%}
    {%- endcapture -%}

    {% if bs.section_background != blank %}
        {% assign section_bg = bs.section_background %}
    {% else %}
        {% assign section_bg = "transparent" %}
    {% endif %}

    {% if bs.section_background != blank %}
        {% assign content_bg = bs.content_background %}
    {% else %}
        {% assign content_bg = "transparent" %}
    {% endif %}

    {% if bs.content_text != blank %}
        {% assign content_tx = bs.content_text %}
    {% else %}
        {% assign content_tx = "inherit" %}
    {% endif %}

    <section id="section--{{ block.id }}" class="section--wrapper margin-bottom--{{ bs.margin | remove: "." }} padding--{{ bs.section_padding | remove: "." }}" style="background-color: {{ section_bg }};" data-section="{{ block.type }}">
      <div class="{{ container_class }}" {% if bs.width_mx != 0 and bs.width_mx %}style="max-width: {{ bs.width_mx }}px;"{% endif %}>
        <div style="background-color: {{ content_bg }}; color: {{ content_tx }};" class="section--inner padding--{{ bs.padding | remove: "." }}">
          <div class="section-content">
            {%- case block.type -%}
            
              {%- when 'video_section' -%}
                <div class="grid--wrapper">
                  <div class="grid--item">
                      <div class="hide--tablet-down">{{ bs.heading  }}</div>
                      <div class="show--tablet-down">{{ bs.heading-mobile }}</div>
                  </div>
                  <div class="grid--item video">
                    {% if bs.mobile-text != blank %}
                      <div class="show--tablet-down">{{ bs.mobile-text }}</div>
                    {% endif %}
              
                    {% if bs.mobile-heading-1 != blank %}
                      <h3 class="show--tablet-down">{{ bs.mobile-heading-1 }}</h3>
                    {% endif %}
                    <div class="image--wrapper">
                      <img class="Image--lazyLoad" {% include "img_attr", image: bs["image_1"] %}>
                      <div class="video-overlay">
                        <div>
                          {% if bs.title_1 != blank %}<h3>{{ bs.title_1 }}</h3>{% endif %}
                          {% render "icon" icon: "play" %}
                        </div>
                      </div>
                      
                      <div class="video-popup">
                        <div>
                          <span class="close">✕</span>
                          <div class="video--wrapper">
                            <video controls loop inline>
                              <source src="{{ bs.url_1 }}" type="video/mp4">
                            </video>
                          </div>
                          
                        </div>
                      </div>
                    </div>
              
                    {% if bs.mobile-text-2 != blank %}
                      <div class="text--wrapper show--tablet-down">{{ bs.mobile-text-2 }}</div>
                    {% endif %}
              
                    {% if bs.mobile-heading-2 != blank %}
                      <h3 class="show--tablet-down">{{ bs.mobile-heading-2 }}</h3>
                    {% endif %}
              
                    {% if bs.url_2 != blank %}
                    <div class="image--wrapper">
                      <img class="Image--lazyLoad" {% include "img_attr", image: bs["image_2"] %}>
                      <div class="video-overlay">
                        <div>
                          {% if bs.title_2 != blank %}<h3>{{ bs.title_2 }}</h3>{% endif %}
                          {% render "icon" icon: "play" %}
                        </div>
                      </div>
                      
                      <div class="video-popup">
                        <div>
                          <span class="close">✕</span>
                          <div class="video--wrapper">
                            <video controls loop playsinline>
                              <source src="{{ bs.url_2 }}" type="video/mp4">
                            </video>
                          </div>
                          
                        </div>
                      </div>
                      {% endif %}
              
                    </div>
              
                  </div>
                </div>
              
              {%- when 'text' -%}
                {% if bs.content_accent != blank %}
                <style>
                    #section--{{ block.id }} {
                      --colour-accent: {{ bs.content_accent }};
                    }
                </style>
                {% endif %}

                <div class="content--group {% if bs.center %}text--center{% endif %}" style="font-size: {{ bs.font_size }}rem;">
                  {% unless bs.title == blank %}<h2 class="h2 section-title">{{ bs.title }}</h2>{% endunless %}
                  {% unless bs.subtitle == blank %}
                  <div class="section-subtitle">
                    {{ bs.subtitle }}
                  </div>
                  {% endunless %}
                  {% unless bs.text == blank %}
                  <div class="section-text">
                    {{ bs.text }}
                  </div>
                  {% endunless %}
                </div>
            
              {%- when 'page_boxes' -%}
                  <div class="description--wrapper" {% if bs.custom_width != 0 %}style="max-width: {{  bs.custom_width }}px; margin: auto;"{% endif %}>
 
                    {% assign list = "" %}
                    <div class="section-main">
                      <ul>
                        {% for i in (1..5) %}
                        	{% assign title = "title_" | append: i %}
                        	{% assign image = "image_" | append: i %}
                        	{% assign text = "text_" | append: i %}   
                        	{% assign mirror = "mirror_" | append: i %}    
                        
                            {% if bs[image] != blank %}
                              <li style="margin-bottom: {{ bs.block_margin }}rem;" id="box_{{ block.id }}-box_{{ i }}" {% if bs[mirror] %}class="block--mirror"{% endif %}>
                                <div class="block-side">
                                  <div class="image--wrapper">
                                    <img class="Image--lazyLoad" {% include "img_attr", image: bs[image] %}>
                                  </div>
                                </div>
                                
                                <div class="block-side">
                                  <div class="group--wrapper">
                                    {% if bs[title] != blank %}<h2>{{ bs[title] }}</h2>{% endif %}
                                    <div class="text--wrapper">
                                      {{ bs[text] }}
                                      
                                      {% assign temp = bs[text] | split: "</strong>" %}
                                      {% for txt in temp %}
                                        {% if txt contains "<strong>" %}
                                          {% assign value = txt | split: "<strong>" | last | strip_html | strip %}
                                      	  {% assign link = '<li><a href="#box_' | append: block.id | append: "-box_" | append: i | append: '">' | append: value | append: '</a></li>' %}
                                      
                                          {% assign list = list | append: link %}
                                        {% endif %}
                                      {% endfor %}
                                    </div>
                                  </div>
                                </div>
                              </li>
                            {% endif %}
                        {% endfor %}
                      </ul>
                    </div>
                           
                    {%- case bs.style -%}
                      {%- when 'default' -%}
                        <div class="section-aside">  
                          <ul>  
                            {% for i in (1..5) %}
                                {% assign title = "title_" | append: i %}
                                {% assign image = "image_" | append: i %}
                                {% assign text = "text_" | append: i %} 
                                {% assign link = "link_" | append: i %}  

                                {% if bs[image] != blank and bs[link] != blank %}
                                    <li><a href="#box_{{ block.id }}-box_{{ i }}">{{ bs[link] | replace: "VS", "<br>VS<br>" }}</a></li>
                                {% endif %}
                            {% endfor %}
                          </ul>
                        </div>
                      {%- when 'bold' -%}
                        <div class="section-aside">  
                          <ul>  
                            {{ list | replace: "VS", "<br>VS<br>" }}
                          </ul>
                        </div>
                    {%- endcase -%}   
                    
                  </div>
            
              {%- when 'heading' -%}
                <div class="section--title text--center">
                  <h1>{{ bs.title | replace: "[title]" , page.title }}</h1>
                </div>
            
              {%- when 'heading_2' -%}
                <div class="section--title text--center">
                  <h2>{{ bs.title }}</h2>
                </div>
            
              {%- when 'image' -%}
                <div>
                  {% unless bs.image_1 == blank %}
                    <div class="image--wrapper default-size hide--tablet-down"><img class="lazyload" alt="{{ bs.image_1.alt }}" src="{{ bs.image_1 | img_url: "master" }}"></div>
                  {% endunless %}
              
                  {% unless bs.image_2 == blank %}
                    <div class="image--wrapper default-size show--tablet-down"><img class="lazyload" alt="{{ bs.image_2.alt }}" src="{{ bs.image_2 | img_url: "900x" }}"></div>
                  {% endunless %}
                </div>
              
              {%- when 'images' -%}
            	{% if bs.image_size != 100 or bs.image_size != 0 %}
                <style>
                  #section--{{ block.id }} .image--wrapper:before {
                    padding-bottom: {{ bs.image_size }}% !important;
                  }
                </style>
                {% endif %}
            	<ul  {% if bs.expand %}class="expand"{% endif %}>
                  {% unless bs.image_1 == blank %}
                  <li>
                    <div class="content--group">
                      <div class="image--wrapper {% if bs.image_size == 0 %}default-size{% endif %}">
                        <img class="lazyload" alt="{{ bs.image_1.alt }}" src="{{ bs.image_1 | img_url: "900x" }}">
                        {% if bs.url_1 != blank %}<a class="url--overlay" href="{{ bs.url_1 }}"></a>{% endif %}
                      </div>
                    </div>
                  </li>
                  {% endunless %}
                  {% unless bs.image_2 == blank %}
                  <li>
                    <div class="content--group">
                      <div class="image--wrapper {% if bs.image_size == 0 %}default-size{% endif %}">
                        <img class="lazyload" alt="{{ bs.image_2.alt }}" src="{{ bs.image_2 | img_url: "900x" }}">
                        {% if bs.url_2 != blank %}<a class="url--overlay" href="{{ bs.url_2 }}"></a>{% endif %}
                      </div>
                    </div>
                  </li>
                  {% endunless %}
                  {% unless bs.image_3 == blank %}
                  <li>
                    <div class="content--group">
                      <div class="image--wrapper {% if bs.image_size == 0 %}default-size{% endif %}">
                        <img class="lazyload" alt="{{ bs.image_3.alt }}" src="{{ bs.image_3 | img_url: "900x" }}">
                        {% if bs.url_3 != blank %}<a class="url--overlay" href="{{ bs.url_3 }}"></a>{% endif %}
                      </div>
                    </div>
                  </li>
                  {% endunless %}
                  {% unless bs.image_4 == blank %}
                  <li>
                    <div class="content--group">
                      <div class="image--wrapper {% if bs.image_size == 0 %}default-size{% endif %}">
                        <img class="lazyload" alt="{{ bs.image_4.alt }}" src="{{ bs.image_4 | img_url: "900x" }}">
                        {% if bs.url_4 != blank %}<a class="url--overlay" href="{{ bs.url_4 }}"></a>{% endif %}
                      </div>
                    </div>
                  </li>
                  {% endunless %}
            	</ul>
              {%- when 'divider' -%}
                <style>
                  @media only screen and (min-width: 960px) {  
                    #section--{{ block.id }} .divider {
                      height: {{ bs.height_desktop }}px;
                    }
                  }
                  
                  @media only screen and (min-width: 480px) and (max-width: 960px) {  
                    #section--{{ block.id }} .divider {
                      height: {{ bs.height_tablet }}px;
                    }
                  }
                  
                  @media only screen and (max-width: 480px) {  
                    #section--{{ block.id }} .divider {
                      height: {{ bs.height_mobile }}px;
                    }
                  }
                </style>
            	<div class="divider"></div>
            
              {%- when 'article' -%}
            	<div class="article--wrapper {% if bs.mirror %}reverse{% endif %}">
                  {% if bs.image_size != 100 or bs.image_size != 0 %}
                  <style>
                    #section--{{ block.id }} .image--wrapper:before {
                      padding-bottom: {{ bs.image_size }}% !important;
                    }
                  </style>
                  {% endif %}
                  <div class="image--wrapper {% if bs.image_size == 0 %}default-size{% endif %}"><img class="Image--lazyLoad" alt="{{ bs.image.alt }}" {% include "img_attr", image: bs.image %}></div>
                  <div class="content--wrapper" style="font-size: {{ bs.font_size }}rem;">
                  	<div class="content--group">
                      {% if bs.title != blank %}<h2>{{ bs.title }} {% if bs.subtitle != blank %}<small>{{ bs.subtitle }}</small>{% endif %}</h2>{% endif %}
                      {% if bs.text != blank %}<div class="text--wrapper">{{ bs.text }}</div>{% endif %}
                    </div>
                  </div>
            	</div>
            
              {%- when 'boxes' -%}
                {% assign font-width = 100 %}
                {%- case ss.width -%}
                  {%- when 'default' -%}
                    {% assign font-width = 50 %}
                  {%- when 'wide' -%}
                    {% assign font-width = 70 %}
                {%- endcase -%}
            
            
                    {% assign division = 0 %}
                  <div class="grid--outer">
                    <ul style="font-size: {{ font-width | divided_by: section.blocks.size }}vw;" class="grid--wrapper">
                      {% if ss.image_size != 0 %}
                      <style>
                        #section--{{ section.id }} .image--wrapper:before {
                          padding-bottom: {{ ss.image_size }}% !important;
                        }
                      </style>
                      {% endif %}
                      
                      
                      {% if block.settings.image_1 != blank %}
                    	{% assign division = division | plus: 1 %}
                        <li class="grid--item">
                          <div class="content--group">
                            <div style="color: {{ block.settings.content_accent }}; {% if block.settings.width_1 != "0" %}max-width: {{ block.settings.width_1 }}px;{% endif %}" class="image--wrapper {% if block.settings.image_size == 0 %}default-size{% endif %}">
                              <img class="Image--lazyLoad" {% include "img_attr", image: block.settings.image_1 %}>
                              <a style="color: {{ block.settings.content_text_1 }};" {% if block.settings.url_1 != blank %}href="{{ block.settings.url_1 }}"{% endif %} class="image--overlay">
                                <h3>{{ block.settings.title_1 }}</h3>
                              </a>
                              <span class="image--decoration"></span>
                              {% if block.settings.border_text_1%}
                              <span class="image--text {% if block.settings.vertical_1 %}vertical{% endif %}">
                                {% if block.settings.vertical_1 %}
                                {% assign split_words = block.settings.border_text_1 | split: " " %}
                                    <div>{% for word in split_words %}<span class="text">{{ word }}</span>{% endfor %}</div>
                                {% else %}
                                    <div><span class="text">{{ block.settings.border_text_1 }}</span></div>
                                {% endif %}
                              </span>
                              {% endif %}
                            </div>
                          </div>
                        </li>
                      {% endif %}
                      
                      {% if block.settings.image_2 != blank %}
                    	{% assign division = division | plus: 1 %}
                        <li class="grid--item">
                          <div class="content--group">
                            <div style="color: {{ block.settings.content_accent }}; {% if block.settings.width_2 != "0" %}max-width: {{ block.settings.width_2 }}px;{% endif %}" class="image--wrapper {% if block.settings.image_size == 0 %}default-size{% endif %}">
                              <img class="Image--lazyLoad" {% include "img_attr", image: block.settings.image_2 %}>
                              <a style="color: {{ block.settings.content_text_2 }};" {% if block.settings.url_2 != blank %}href="{{ block.settings.url_2 }}"{% endif %} class="image--overlay">
                                <h3>{{ block.settings.title_2 }}</h3>
                              </a>
                              <span class="image--decoration"></span>
                              {% if block.settings.border_text_2%}
                              <span class="image--text {% if block.settings.vertical_2 %}vertical{% endif %}">
                                {% if block.settings.vertical_2 %}
                                {% assign split_words = block.settings.border_text_2 | split: " " %}
                                    <div>{% for word in split_words %}<span class="text">{{ word }}</span>{% endfor %}</div>
                                {% else %}
                                    <div><span class="text">{{ block.settings.border_text_2 }}</span></div>
                                {% endif %}
                              </span>
                              {% endif %}
                            </div>
                          </div>
                        </li>
                      {% endif %}
                      
                      <style>
                       @media only screen and (min-width: 1240px) {  
                          #section--{{ block.id }} .grid--wrapper {
                            font-size: {{ settings.base_text_font_size | times: 0.625 | times: 2 | divided_by: division }}px !important;
                          }
                       }
                       @media only screen and (max-width: 1240px) {  
                          #section--{{ block.id }} .grid--wrapper {
                            font-size: 21vw !important;
                          }
                       }
                       @media only screen and (max-width: 720px) {  
                          #section--{{ block.id }} .grid--wrapper {
                            font-size: 18vw !important;
                          }
                       }
                      </style>
                    </ul>
                  </div>
     
              {%- when 'article_2' -%}
            	<div class="article--wrapper {% if bs.mirror %}reverse{% endif %} {% if bs.reverse %}mobile--reverse{% endif %}" {% if bs.text2 == blank and bs.text == blank %}style="display: flex;"{% endif %}>
                  {% if bs.image_size != "100" or bs.image_size != "0" %}
                  <style>
                    #section--{{ block.id }} .image--wrapper:before {
                      padding-bottom: {{ bs.image_size }}% !important;
                    }
                    
                    {% if bs.image_size == "0" %}
                      #section--{{ block.id }} .grid--item {
                        align-items: center;
                      }
                    {% endif %}
                    
                    {% if bs.content_accent != blank %}
                    #section--{{ block.id }} {
                      --colour-accent: {{ bs.content_accent }};
                    }
                    {% endif %}
                  </style>
                  {% endif %}
                  <div class="grid--item {% if block.settings.border_text  != blank %}padding{% endif %}">
              
                    {% if bs.url_1 != blank %}
                    <div style="max-width: {{ bs.content_width_image }}px;" class="vel image--wrapper {% if bs.image_size == 0 %}default-size{% endif %}">
                      <img class="Image--lazyLoad" {% include "img_attr", image: bs["image_1"] %}>
                      <div class="video-overlay">
                        <div>
                          {% render "icon" icon: "play" %}
                        </div>
                      </div>
                      
                      <div class="video-popup">
                        <div>
                          <span class="close">✕</span>
                          <div class="video--wrapper">
                            <video controls loop playsinline>
                              <source src="{{ bs.url_1 }}" type="video/mp4">
                            </video>
                          </div>
                        </div>
                      </div>
                    </div>
                      {% else %}
                        <div style="max-width: {{ bs.content_width_image }}px;" class="image--wrapper {% if bs.image_size == 0 %}default-size{% endif %}">
                          {% if bs.url != blank %}<a style=" position: absolute; top: 0; left: 0; width: 100%; height: 100%;" href="{{ bs.url }}"></a>{% endif %}
                          {% if block.settings.border_text %}
                          <span style="color: {{ bs.content_accent }}" class="image--text {% if block.settings.vertical %}vertical{% endif %}">
                            {% if block.settings.vertical %}
                            {% assign split_words = block.settings.border_text | split: " " %}
                                <div>{% for word in split_words %}<span class="text">{{ word }}</span>{% endfor %}</div>
                            {% else %}
                                <div><span class="text">{{ block.settings.border_text }}</span></div>
                            {% endif %}
                          </span>
                          {% endif %}
                          
                          <img style="{% if bs.fill_height %}height: 100%;{% endif %}" alt="{{ bs.image.alt }}" class="Image--lazyLoad" {% include "img_attr", image: bs.image %}>
                        </div>
                      {% endif %}
              
                  </div>

                  {% if bs.text != blank or bs.text2 != blank %}
                  <div class="grid--item">
                  <div class="content--wrapper">
                  	<div class="content--group {% if bs.center %}text--center{% endif %}" style="max-width: {{ bs.content_width }}px;">
                      {% if bs.title != blank %}<h2>{{ bs.title }} {% if bs.subtitle != blank %}<small>{{ bs.subtitle }}</small>{% endif %}</h2>{% endif %}
                      {% if bs.text != blank or bs.text2 != blank %}
                        <div class="text--wrapper">
                          {{ bs.text }}
                        
                           {% if bs.text2 != blank %}
                              <div class="html--wrapper">
                                {{ bs.text2 }}
                              </div>
                            {% endif %}
                        </div>
                      {% endif %}
                    </div>
                  </div>
                  </div>
                    {% endif %}
              
            	</div>
            
              {%- when 'banner' -%}
            	<div class="banner--wrapper">
                  {% if bs.image != blank %}
                    <div class="image--wrapper default-size">
                      <img alt="{{ bs.image.alt }}" style="{% if bs.image_size_max != 0 %}max-height: {{ bs.image_size_max }}px;{% endif %} {% if bs.image_size_min != 0 %}min-height: {{ bs.image_size_min }}px;{% endif %}" class="Image--lazyLoad" {% include "img_attr", image: bs.image %}>
                    </div>
                  {% endif %}
                  
                  <div class="content--overlay {% if bs.content_center %}center{% endif %}">
                  	<div class="content--group" style="max-width: {{ bs.content_width_title }}px;">
                      {% if bs.title != blank %}<h2>{{ bs.title }} {% if bs.subtitle != blank %}<small>{{ bs.subtitle }}</small>{% endif %}</h2>{% endif %}
                      {% if bs.text != blank %}<div class="text--wrapper">{{ bs.text }}</div>{% endif %}
                    </div>
                  </div>
            	</div>
            
              {%- when 'products' -%}
            	<div class="products--wrapper">
                  {% unless bs.image_11 == blank %}
					{% include "custom--product-item", class: "product1", title: bs.title_1, url: bs.url_1, price: bs.price_1, sale: bs.price_11, image_1: bs.image_11, image_2: bs.image_12, customBadge: bs.badge_1 %}
                  {% endunless %}
                  {% unless bs.image_21 == blank %}
                  
					{% include "custom--product-item", class: "product2", title: bs.title_2, url: bs.url_2, price: bs.price_2, sale: bs.price_22, image_1: bs.image_21, image_2: bs.image_22, customBadge: bs.badge_2 %}
                  {% endunless %}
                  {% unless bs.image_31 == blank %}
                  
					{% include "custom--product-item", class: "product3", title: bs.title_3, url: bs.url_3, price: bs.price_3, sale: bs.price_33, image_1: bs.image_31, image_2: bs.image_32, customBadge: bs.badge_3 %}
                  {% endunless %}
                  {% unless bs.image_41 == blank %}
                  
					{% include "custom--product-item", class: "product4", title: bs.title_4, url: bs.url_4, price: bs.price_4, sale: bs.price_44, image_1: bs.image_41, image_2: bs.image_42, customBadge: bs.badge_4 %}
                  {% endunless %}
                  
                  {% unless bs.image == blank %}
                    <div class="main-image">
                      <div class="image--wrapper">
                        <img class="Image--lazyLoad" alt="{{ bs.image.alt }}" {% include "img_attr", image: bs.image %}>
                      </div>
                    </div>
                  {% endunless %}
            	</div>
            
              {%- when 'description' -%}
            
            	{% if bs.content_accent != blank %}
                  <style>
                      #section--{{ block.id }} {
                        --colour-accent: {{ bs.content_accent }};
                      }
                  </style>
                {% endif %}
            
                {% if bs.type == "default" %}
                  <div class="description--wrapper" {% if bs.custom_width != 0 %}style="max-width: {{  bs.custom_width }}px; margin: auto;"{% endif %}>
                    <div class="section-main">
                      <div class="text--wrapper {% if bs.center %}text--center{% endif %}">
                        
                        {% if page.content contains "[--tables--]" %}
                          {% assign pc = page.content %}
                          {% assign splitContent = page.content | split: "[--tables--]" %}


                          <div class="hide" id="page-content">{{ page.content }}</div>

                          {{ splitContent | first }}
                          <div id="result"></div>
                          {{ splitContent | last }}

                          <script>
                            document.addEventListener("DOMContentLoaded", function() {
                              window.main.setupShippingContent();
                            });
                          </script>
                        {% else %}
                            {{ page.content }}
                        {% endif %}
                      </div>
                    </div>
                  </div>
            	{% endif %}   
            
                {% if bs.type == "sliders" %}
            
                  <style>
                      #section--{{ block.id }} .column--wrapper {
                        background: {{ bs.slider_background }} !important;
                      }
                  </style>
            
            	  <div class="hide" id="page-content">{{ page.content }}</div>
            
                  <div class="description--wrapper sliders" {% if bs.custom_width != 0 %}style="max-width: {{  bs.custom_width }}px; margin: auto;"{% endif %}>
                    <div class="section-main">
                      <div class="text--wrapper {% if bs.center %}text--center{% endif %}">
                        <div class="grid--outer">
                        	<div class="columns--wrapper" id="result"></div>
                        </div>
                      </div>
                    </div>
                  </div>
            
                  <script>
                    document.addEventListener("DOMContentLoaded", function() {
                      window.main.setupPageSliders();
                    });
                  </script>
            	{% endif %}
            
                {% if bs.type == "navigation" %}
                  <div class="description--wrapper" {% if bs.custom_width != 0 %}style="max-width: {{  bs.custom_width }}px; margin: auto;"{% endif %}>
                
                    <div class="section-aside">
                      <ul>
