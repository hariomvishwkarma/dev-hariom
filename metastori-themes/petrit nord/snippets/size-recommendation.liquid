<div class="hide" id="size-data">{{ content }}</div>
<div class="hide" id="size-title">{{ product.title }}</div>

{% assign fit_1 = settings.fit1 | downcase  | remove: " " %}
{% assign fit_2 = settings.fit2 | downcase  | remove: " " %}
{% assign fit_3 = settings.fit3 | downcase  | remove: " " %}
{% assign fit_4 = settings.fit4 | downcase  | remove: " " %}
{% assign fit_5 = settings.fit5 | downcase  | remove: " " %}


{% assign descr_test = product.description | downcase  | remove: " " %}

<style>
  .module__ruler {
    {% if descr_test contains fit_1 %}
    	--position: 0%;
    	--dot: 0%;
    {% endif %}
    {% if descr_test contains fit_2 %}
    	--position: 25%;
    	--dot: 25%;
    {% endif %}
    {% if descr_test contains fit_3 %}
        --left: calc(25% + 1px);
    	--position: 50%;
    	--dot: 50%;
    {% endif %}
    {% if descr_test contains fit_4 %}
    	--position: 50%;
    	--dot: 75%;
        --left: calc(50% + 2px);
    {% endif %}
    {% if descr_test contains fit_5 %}
    	--position: 100%;
    	--dot: 100%;
    {% endif %}
  }
</style>

<div>
  <div class="fit--wrapper" >
    <header>
      <h3 class="module__title">{{- 'general.custom.fit_heading' | t -}}</h3>
    </header>
    
    <div class="ruler__labels">
        <span>{{- 'general.custom.fit_1' | t -}}</span>
        <span>{{- 'general.custom.fit_2' | t -}}</span>
        <span>{{- 'general.custom.fit_3' | t -}}</span>
    </div>
    <div class="module__ruler"> 
        <span class="current"></span>
      <div class="ruler__meter">
      </div>
      <div class="ruler__ticks">
          <span class="tick--1"></span>
          <span class="tick--2"></span>
          <span class="tick--3"></span>
          <span class="tick--4"></span>
          <span class="tick--5"></span>
      </div>
    </div>
  </div>

  {% if text_1 != "" %}
    <header>
      <h3 class="module__title">{{- 'general.custom.size_subtitle' | t -}}</h3>
    </header>
    <div style="margin: 1.5rem 0 2rem 0; font-size: 1.716rem;" class="text--wrapper">{{ text_1 }}</div>
  {% endif %}

  <div class="table--wrapper">
    <ul class="list--table" id="measurementsResultsAlt">
    </ul>
  </div>

  <div class="size_helper--wrapper" id="size-module">
    <header>
      <h3 class="recommendation__title">{{- 'general.custom.size_helper_heading' | t -}}</h3>
    </header>
    <div class="recommendation--controls">
      <div class="controls--wrapper">
        <label class="label-main" for="sizeValue">{{- 'general.custom.size_helper_label' | t -}}</label>
        
        <div class="input--wrapper">
          <input id="sizeValue" class="input-main" pattern="[0-9]{3}"  type="text" step="0.01">

          <div class="switch-main">
            <label class="">
              <input class="" type="radio" name="unit" value="mm" checked="">
              <span class="">{{- 'general.custom.size_helper_mm' | t -}}</span>
            </label>
            <label class="">
              <input class="" type="radio" name="unit" value="in">
              <span class="">{{- 'general.custom.size_helper_in' | t -}}</span>
            </label>
          </div>
          <button id="sizeButton" class="" type="submit">{{- 'general.custom.size_helper_button' | t -}}</button>
        </div>
        
        <div class="error">
          <svg xmlns="http://www.w3.org/2000/svg" height="24px" viewBox="0 0 24 24" width="24px" fill="#000000"><path d="M0 0h24v24H0z" fill="none"/><path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm1 15h-2v-2h2v2zm0-4h-2V7h2v6z"/></svg>
          <span>{{ 'general.custom.size_helper_error_mm_html' | t }}</span>
        </div>
      </div>
    </div>
    <div class="recommendation--results">

    <div id="sizeResult"></div>
    </div>
  </div>
</div>