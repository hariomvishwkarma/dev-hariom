<style>
  :root {
    --colour-secondary: {{ settings.text_secondary }};
    --colour-accent: {{ settings.text_accent }};
    --colour-border: {{ settings.border_colour }};
    --border-color    : {{ settings.border_colour }};
    --colour-background: {{ settings.homepage_bg }};
    
    --colour-primary: {{ settings.text_primary }};
    --colour-primary-30: {{ settings.text_primary | color_modify: 'alpha', 0.30 }};
    --colour-primary-15: {{ settings.text_primary | color_modify: 'alpha', 0.15 }};
          
    {%- assign primary_alt_color = "" -%}
    {%- assign primary_text_color = settings.text_primary -%}
    {%- assign primary_text_color_brightness = settings.text_primary | color_brightness -%}
    {%- if primary_text_color_brightness < 60 -%}
      {%- assign primary_alt_color = primary_text_color | color_lighten: 70 -%}
    {%- else -%}
      {%- assign primary_alt_color = primary_text_color | color_darken: 70 -%}
    {%- endif -%}
      
    --colour-primary-alt: {{ primary_alt_color }};
    
    --colour-tertiary: {{ settings.text_tertiary }};
    --colour-tertiary-30: {{ settings.text_tertiary | color_modify: 'alpha', 0.30 }};
    --colour-tertiary-15: {{ settings.text_tertiary | color_modify: 'alpha', 0.15 }};
      
    {%- assign tertiary_alt_color = "" -%}
    {%- assign tertiary_text_color = settings.text_tertiary -%}
    {%- assign tertiary_text_color_brightness = settings.text_tertiary | color_brightness -%}
    {%- if tertiary_text_color_brightness < 130 -%}
      {%- assign tertiary_alt_color = tertiary_text_color | color_lighten: 70 -%}
    {%- else -%}
      {%- assign tertiary_alt_color = tertiary_text_color | color_darken: 70 -%}
    {%- endif -%}
      
    --colour-tertiary-alt: {{ tertiary_alt_color }};
    --tw: 80vw;

    --button-background-colour: {{ settings.button_bg }};
    --button-bg-hover: {{ settings.button_bg_hover }};
    --button-text: {{ settings.button_tx }};
    --button-text-hover: {{ settings.button_tx_hover }};

    --container-width: {{ settings.container_width | append: "px" }};
    --container-padding: {{ settings.container_padding | append: "rem" }};

    --font-type-primary: {{ settings.type_base_font.family }};
    --font-type-secondary: {{ settings.type_header_font.family }};

    --font-size-large: {{settings.base_text_font_size }};
    --font-size-medium: {{ settings.base_text_font_size | minus: 2 }};
    --font-size-small: {{ settings.base_text_font_size | minus: 4 }};
  }
</style>
  
<script>
  var customTheme = {
      breakpoints: {
        small: 480,
        medium: 720,
        large: 1008,
        widescreen: 1240
      },
      strings: {
        addToCart: {{ 'products.product.add_to_cart' | t | json }},
        helperSuccess: {{ 'general.custom.size_helper_results_success_html' | t | json }},
        helperSuccessLarge: {{ 'general.custom.size_helper_results_success_larger_html' | t | json }},
        helperSuccessSmall: {{ 'general.custom.size_helper_results_success_smaller_html' | t | json }},
        helperFailure: {{ 'general.custom.size_helper_results_failure_html' | t | json }},
        helperFailureLarge: {{ 'general.custom.size_helper_results_failure_largest_html' | t | json }},
        helperFailureSmall: {{ 'general.custom.size_helper_results_failure_smallest_html' | t | json }},
        helperErrorMm: {{ 'general.custom.size_helper_error_mm_html' | t | json }},
        helperErrorIn: {{ 'general.custom.size_helper_error_in_html' | t | json }},
        
        {% assign type = "" %}
        {% if template contains "product" %}
          {% assign fit_1 = settings.fit1 | downcase  | remove: " " %}
          {% assign fit_2 = settings.fit2 | downcase  | remove: " " %}
          {% assign fit_3 = settings.fit3 | downcase  | remove: " " %}
          {% assign fit_4 = settings.fit4 | downcase  | remove: " " %}
          {% assign fit_5 = settings.fit5 | downcase  | remove: " " %}
          {% assign descriptionValue = product.description | downcase  | remove: " " %}
    
          {% if descriptionValue contains fit_4 %}
            {% assign type = "normal_wide" %}
          {% endif %}

          {% if descriptionValue contains fit_3 %}
            {% assign type = "normal" %}
          {% endif %}
          
          {% for collection in product.collections %}
            {% if collection.handle contains "new-walker-winter-boots" or collection.handle contains "kids-winter-boots" %}
              {% assign type = "winter_boots" %}
            {% endif %}
            {% if collection.handle contains "women" %}
              {% assign type = "women" %}
            {% endif %}
          {% endfor %}
    
       {% endif %}
       
        {%- case type -%}
          {%- when 'winter_boots' -%}
          helperNew: {{ 'general.custom.size_helper_results_winter_html' | t | json }}
          {%- when 'normal' -%}
          helperNew: {{ 'general.custom.size_helper_results_normal_html' | t | json }}
          {%- when 'normal_wide' -%}
          helperNew: {{ 'general.custom.size_helper_results_normalwide_html' | t | json }}
          {%- when 'women' -%}
          helperNew: {{ 'general.custom.size_helper_results_women_html' | t | json }}
          {% else %}
          helperNew: {{ 'general.custom.size_helper_results_new_html' | t | json }}
        {%- endcase -%}
      }
    }
</script>