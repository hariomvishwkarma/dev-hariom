{% assign bs = block.settings %}

{%- capture container_class -%}
  {%- case bs.width -%}
    {%- when 'default' -%}
	container--custom_page
    {%- when 'custom' -%}
	container--custom_page
    {%- when 'full' -%}
	container--full_width
    {%- when 'full_with' -%}
	container--full_with
    {%- when 'wide' -%}
	container--wide
  {%- endcase -%}
{%- endcapture -%}

{%- capture section_style -%}
  {% if bs.section_background_image != blank %}background-image: linear-gradient(rgba(34, 44, 38, 0.55), rgba(34, 44, 38, 0.55)), url({{ bs.section_background_image | img_url: "1500x" }});{% endif %}
  {% if bs.section_background != blank %}background-color: {{ bs.section_background }};{% endif %}
  {% if bs.section_padding != blank %}--section-padding: {{ bs.section_padding }}rem;{% endif %}
  {% if bs.section_margin != blank %}--section-margin: {{ bs.section_margin }}rem;{% endif %} 
  {% if bs.section_background != blank %}--section-background: {{ bs.section_background }};{% endif %}  
  {% if bs.content_padding != blank %}--section-content-padding: {{ bs.content_padding }}rem;{% endif %} 
  {% if bs.content_margin != blank %}--content-margin: {{ bs.content_margin }}rem;{% endif %} 
  {% if bs.content_background != blank %}--content-background: {{ bs.content_background }};{% endif %}
  {% if bs.content_text != blank %}--content-colour: {{ bs.content_text }};{% endif %}
  {% if bs.content_accent != blank %}--content-accent: {{ bs.content_accent }};{% endif %}
{%- endcapture -%}

<section id="section--{{ block.id }}" data-section="page_{{ block.type }}" style="{{ section_style | remove: " " | strip_newlines }}" class="index-section page-section section--wrapper">
  
  <div class="{{ container_class }}" {% if  bs.width == "custom" %}style="max-width: {{ block.settings.custom_width }}px;"{% endif %}>
    <div style="background-color: {{ bs.content_background }}; color: {{ bs.content_text }};" class="section--inner">
      <div class="section-content">
        <div class="content--wrapper">

          {%- case block.type -%}
              {%- when 'header' -%}
          		{%- assign width = bs.width_image -%}
          		{%- capture image_size -%}master{%- endcapture -%}
          
                <div class="image--wrapper" {% if width != 0 %}style="max-width: {{ bs.width_image }}px;"{% endif %}>
                  <img class="image--el"
                       src="{{ bs.image | img_url: image_size }}"
                       srcset="{{ bs.image | img_url: image_size }} 1x, {{ bs.image | img_url: image_size, scale: 2 }} 2x"
                       width="{{ width }}"
                       alt="{{ bs.image.alt | default: shop.name | escape }}">
                </div>
          
              {%- when 'footer' -%}
          		{%- assign width = bs.width_text -%}
          		<div class="text--wrapper" {% if width != 0 %}style="max-width: {{ bs.width_image }}px;"{% endif %}>
                  {{ bs.text }}

            {% if bs.button %}
              <div class="button--wrapper">{{ bs.button  }}</div>
              {% endif %}
          		</div>
          
          		<span>
                  &copy; {{ 'now' | date: "%Y" }}, {{ "Petit Nord ApS" | link_to: routes.root_url }}. All rights reserved.  
                  <a href="https://petitnord.com/policies/privacy-policy" target="_blank" rel="noopener noreferrer" data-link-type="external">Privacy Policy</a>
          		</span>
          
              {%- when 'banner' -%}
          		{%- assign width = bs.width_text -%}
          		<div class="text--wrapper" {% if width != 0 %}style="max-width: {{ bs.width_text }}px;"{% endif %}>
                  {% assign text = bs.text | replace: "</p><p>", "<br>" | remove: "</p>" | remove: "<p>" %}

            
                  {%- case bs.text_size -%}
                      {%- when '1' -%}
                  		<h3 class="u-h1">{{ text }}</h3>
                      {%- when '2' -%}
                  		<h3 class="u-h2">{{ text }}</h3>
                      {%- when '3' -%}
                  		<h3 class="u-h3">{{ text }}</h3>
                      {%- when '4' -%}
                  		<h3 class="u-h4">{{ text }}</h3>
                  {%- endcase -%}

            
                  {% if bs.text2 != blank %}
                    <div class="el--wrapper">{{ bs.text2 | remove: "</p>" | remove: "<p>" }}</div>
                  {% endif %}
            
                  {% if bs.button != blank %}
                    <div class="button--wrapper">{{ bs.button | remove: "</p>" | remove: "<p>" }}</div>
                  {% endif %}
          		</div>
          
              {%- when 'text' -%}
          		{%- assign width = bs.width_text -%}
          		<div class="text--wrapper" {% if width != 0 %}style="max-width: {{ bs.width_text }}px;"{% endif %}>
                  {% assign text = bs.text | replace: "</p><p>", "<br>" | remove: "</p>" | remove: "<p>" %}

                  {{ bs.text }}
          		</div>
          
              {%- when 'images' -%}
                {% assign show1 = false %}
                {% assign show2 = false %}
                {% for i in (1..3) %}
                  {% assign img = "image_" | append: i %}
                  {% if bs[img] != blank %}{% assign show1 = true %}{% endif %}
                {% endfor %}
                {% for i in (3..6) %}
                  {% assign img = "image_" | append: i %}
                  {% if bs[img]!= blank %}{% assign show2 = true %}{% endif %}
                {% endfor %}

              {% if show1 %}
          		<div class="grid--wrapper">
                  {% for i in (1..3) %}
                  {% assign img = "image_" | append: i %}
                    {% if bs[img] != blank %}
                      <div class="grid--item">
                        <div class="image--wrapper"><img src="{{ bs[img] | img_url: "master" }}" /></div>
                      </div>
                    {% endif %}
                  {% endfor %}
          		</div>
              {% endif %}
            
              {% if show2 %}
                {% if bs.folded %}
                    <h4 data-trigger>{{ bs.button }} <span class="icon">+</span></h4>
                    <div class="text-extension" data-active>
              		<div class="grid--wrapper">
                      {% for i in (3..6) %}
                      {% assign img = "image_" | append: i %}
                        {% if bs[img] != blank %}
                          <div class="grid--item">
                            <div class="image--wrapper"><img src="{{ bs[img] | img_url: "master" }}" /></div>
                          </div>
                        {% endif %}
                      {% endfor %}
              		</div>
                    </div>
                  {% else %}
            		<div class="grid--wrapper">
                    {% for i in (3..6) %}
                    {% assign img = "image_" | append: i %}
                      {% if bs[img] != blank %}
                        <div class="grid--item">
                          <div class="image--wrapper"><img src="{{ bs[img] | img_url: "master" }}" /></div>
                        </div>
                      {% endif %}
                    {% endfor %}
            		</div>
                {% endif %}
              {% endif %}
          
              {%- when 'columns' -%}
          		<div class="grid--wrapper">
                  {% for i in (1..3) %}
                  {% assign heading = "heading_" | append: i %}
                  {% assign text = "text_" | append: i %}
                    {% if bs[heading] != blank %}
                      <div class="grid--item" {% if bs.expand %}style="align-self: flex-start;"{% endif %}>
                        <div class="text--wrapper ">
                          <h4 {% if bs.expand %}data-trigger{% endif %}>{{ bs[heading] }} {% if bs.expand %}<span class="icon">+</span>{% endif %}</h4>
                          <div {% if bs.expand %}class="text-extension" data-active{% endif %}>{{ bs[text] }}</div>
                        </div>
                      </div>
                    {% endif %}
                  {% endfor %}
          		</div>
          
          
              {%- when 'about' -%}
          		<div class="grid--wrapper style-{{ bs.style }}">
            {% if bs.style == "default" %}
                  {% if bs.image %}
                    <div class="grid--item">
        
                      {%- assign width = bs.width_image -%}
                      {%- capture image_size -%}master{%- endcapture -%}
        
                      <div class="image--wrapper" {% if width != 0 %}style="max-width: {{ bs.width_image }}px;"{% endif %}>
                        <img class="image--el"
                             src="{{ bs.image | img_url: image_size }}"
                             srcset="{{ bs.image | img_url: image_size }} 1x, {{ bs.image | img_url: image_size, scale: 2 }} 2x"
                             width="{{ width }}"
                             alt="{{ bs.image.alt | default: shop.name | escape }}">
                      </div>
                    </div>
                  {% endif %}
                  
                  <div class="grid--item">
                    <div class="text--wrapper">
                      <div class="text1">{{ bs["text_1"] }}</div>
                      <div><h1 class="u-h2">{{ bs["heading"] }}</h1></div>
                      <div class="text2">{{ bs["text_2"] }}</div>
                      <div class="button--wrapper">{{ bs["button"] }}</div>
                    </div>
                  </div>
              {% else %}

                  {% if bs.image %}
                    <div class="grid--item">
                      <div class="text--wrapper">
                        <div><h1 class="u-h2">{{ bs["heading"] }}</h1></div>
                        <div class="text1">{{ bs["text_1"] }}</div>
                      </div>
                    </div>
                    
                    <div class="grid--item">
        
                      {%- assign width = bs.width_image -%}
                      {%- capture image_size -%}master{%- endcapture -%}
        
                      <div class="image--wrapper" {% if width != 0 %}style="max-width: {{ bs.width_image }}px;"{% endif %}>
                        <img class="image--el"
                    style="border-radius: 20px; max-width: 300px;"
                             src="{{ bs.image | img_url: image_size }}"
                             srcset="{{ bs.image | img_url: image_size }} 1x, {{ bs.image | img_url: image_size, scale: 2 }} 2x"
                             width="{{ width }}"
                             alt="{{ bs.image.alt | default: shop.name | escape }}">
                      </div>
                    </div>
                  {% endif %}
                  
                  <div class="grid--item">
                    <div class="text--wrapper">
                      <div class="text2">{{ bs["text_2"] }}</div>
                      <div class="button--wrapper">{{ bs["button"] }}</div>
                    </div>
                  </div>
              {% endif %}
            
          		</div>
            
              {%- when 'article' -%}
          		<div class="grid--wrapper {% if bs.same %}same{% endif %}">

                  <div class="grid--item">

                    {%- assign width = bs.width_image -%}
                    {%- capture image_size -%}master{%- endcapture -%}

                    <div class="image--wrapper" {% if width != 0 %}style="max-width: {{ bs.width_image }}px;"{% endif %}>
                      <img class="image--el"
                           src="{{ bs.image | img_url: image_size }}"
                           srcset="{{ bs.image | img_url: image_size }} 1x, {{ bs.image | img_url: image_size, scale: 2 }} 2x"
                           width="{{ width }}"
                           alt="{{ bs.image.alt | default: shop.name | escape }}">
                    </div>
                  </div>
                  
                  <div class="grid--item">
                    <div class="text--wrapper">
                      <div {% if bs.left %}style="text-align:left; margin-left: 0;" {% endif %}>{{ bs["text"] }}</div>
                    </div>
                  </div>
          		</div>
            
              {%- when 'step' -%}
          		<div class="grid--wrapper {% if bs.same %}same{% endif %}">

                  <div class="grid--item">
                    <div class="text--wrapper">
                      <div {% if bs.left %}style="text-align:left; margin-left: 0;" {% endif %} class="heading">{{ bs["heading"] }}</div>
                      <div {% if bs.left %}style="text-align:left; margin-left: 0;" {% endif %}>{{ bs["text"] }}</div>
                    </div>
                  </div>
            
                  <div class="grid--item">

                    {%- assign width = bs.width_image -%}
                    {%- capture image_size -%}master{%- endcapture -%}

                    <div class="image--wrapper" {% if width != 0 %}style="max-width: {{ bs.width_image }}px;"{% endif %}>
                      <img class="image--el"
                           src="{{ bs.image | img_url: image_size }}"
                           srcset="{{ bs.image | img_url: image_size }} 1x, {{ bs.image | img_url: image_size, scale: 2 }} 2x"
                           width="{{ width }}"
                           alt="{{ bs.image.alt | default: shop.name | escape }}">
                    </div>
                  </div>
                  
          		</div>
              {%- when 'video_2' -%}
                <div class="video">
                  <div class="image--wrapper">
                    <img class="Image--lazyLoad" {% include "img_attr", image: bs["image"] %}>
                    <div class="video-overlay">
                      <div class="video-play">
                        {% render "icon" icon: "play" %}
                      </div>

                      {% if bs.button != blank %}
                      <div class="button--wrapper">{{ bs.button }}</div>
                      {% endif %}
                    </div>
                    
                    <div class="video-popup">
                      <div>
                        <span class="close">✕</span>
                        <div class="video--wrapper">
                          <video controls loop>
                            <source src="{{ bs.url }}" type="video/mp4">
                          </video>
                        </div>
                      </div>
                    </div>
                  </div>


            
              {%- when 'video' -%}
            {% if bs.size %}
<style>
#body #section--{{ block.id }} .video--wrapper:before {

    padding-bottom: {{ bs.size }}%;
 
}
              </style>
              
              {% endif %}
          		  <div class="video--wrapper">{{ bs.html }}</div>
          
              {%- when 'heading' -%}
          		{%- assign width = bs.width_text -%}
          		<div class="text--wrapper align-{{ bs.align }}" {% if width != 0 %}style="max-width: {{ bs.width_text }}px;"{% endif %}>
                  {% assign text = bs.text | replace: "</p><p>", "<br>" | remove: "</p>" | remove: "<p>" %}

                  {%- case bs.text_size -%}
                      {%- when '1' -%}
                  		<h3 class="u-h1">{{ text }}</h3>
                      {%- when '2' -%}
                  		<h3 class="u-h2">{{ text }}</h3>
                      {%- when '3' -%}
                  		<h3 class="u-h3">{{ text }}</h3>
                      {%- when '4' -%}
                  		<h3 class="u-h4">{{ text }}</h3>
                      {%- when '6' -%}
                  		<h3 class="u-h6">{{ text }}</h3>
                  {%- endcase -%}
          		</div>
          
              {%- when 'seperator' -%}
          		{%- assign width = bs.width_line -%}
          		<hr {% if width != 0 %}style="max-width: {{ bs.width_image }}px;"{% endif %} />
          {%- endcase -%}
  
        </div>
      </div>
    </div>
  </div>
</section>