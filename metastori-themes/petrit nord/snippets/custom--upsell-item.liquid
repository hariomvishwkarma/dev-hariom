{% if grid == true %}
    <div class="upsell-item">
      <div class="cell--inner {% if settings.hide_form == true %}no-form{% endif %}">
        <div class="upsell-image">
          <img class="Image--lazyLoad Image--fadeIn" data-src="{{ product.featured_image | img_url: "300x" }}" data-sizes="auto" data-max-width="{{ product.featured_image.width }}" data-max-height="{{ product.featured_image.height }}" data-original-src="{{ product.featured_image | img_url: "master" }}">  
        </div>
       <div class="upsell-meta">
          <p class="upsell-title"><a href="{{ product.url }}">{{ product.title | remove: "- None" }}</a></p>
          <p class="upsell-price"><span>{{ product.price | money }}</span></p>

          {% if settings.hide_form == false %}
            {% if product.variants.size > 1 %}
            <p class="upsell-variant">
              <span class="input--wrapper">
              <select class="upsell-variant-trigger">
                {% for variant in product.variants %}
                  {% if variant.available %}
                    <option value='{"id":"{{ variant.id }}","price":"{{ variant.price }}"}'>{{ variant.title }}</option>
                  {% endif %}
                {% endfor %}
              </select>
          	  </span>
            </p>
            {% endif %}
          {% endif %}
        </div>

        {% if settings.hide_form == false %}
          <div class="upsell-actions"><button type="button" class="upsell__add_to_cart" data-product="{{ product.selected_or_first_available_variant.id }}"><span>{{- 'general.custom.cart_upsell' | t -}}</span></button></div>
       {% endif %}  
      </div>
    </div>
{% elsif swiper == true %}
  <div class="swiper-slide">
    <div class="cell--inner {% if settings.hide_form == true %}no-form{% endif %}">
      <div class="upsell-image">
        <img class="Image--lazyLoad Image--fadeIn" data-src="{{ product.featured_image | img_url: "300x" }}" data-sizes="auto" data-max-width="{{ product.featured_image.width }}" data-max-height="{{ product.featured_image.height }}" data-original-src="{{ product.featured_image | img_url: "master" }}">
      </div>
      <div class="upsell-meta">
        <p class="upsell-title"><a href="{{ product.url }}">{{ product.title | remove: "- None" }}</a></p>
        <p class="upsell-price"><span>{{ product.price | money }}</span></p>
  
        {% if settings.hide_form == false %}
          {% if product.variants.size > 1 %}
          <p class="upsell-variant">
            <span class="input--wrapper">
            <select class="upsell-variant-trigger add">
              <option value='' disabled selected>Select</option>
              {% for variant in product.variants %}
                {% if variant.available %}
                  <option value='{"id":"{{ variant.id }}","price":"{{ variant.price }}"}'>{{ variant.title }}</option>
                {% endif %}
              {% endfor %}
            </select>
            </span>
          </p>
          {% else %}
            <div class="upsell-actions"><button type="button" class="upsell__add_to_cart" data-product="{{ product.selected_or_first_available_variant.id }}"><span>{{- 'general.custom.cart_upsell' | t -}}</span></button></div>
          {% endif %}
        {% endif %}
       </div>
    </div>
  </div>
{% else %}
  {% if settings.hide_form == true %}
    <div class="carousel-cell">
      <a href="{{ product.url }}" class="cell--inner no-form">
        <div class="upsell-image">
          <img class="Image--lazyLoad Image--fadeIn" data-src="{{ product.featured_image | img_url: "300x" }}" data-sizes="auto" data-max-width="{{ product.featured_image.width }}" data-max-height="{{ product.featured_image.height }}" data-original-src="{{ product.featured_image | img_url: "master" }}">
        </div>
       <div class="upsell-meta">
          <p class="upsell-title">{{ product.title | remove: "- None" }}</p>
          <p class="upsell-price"><span>{{ product.price | money }}</span></p>
        </div>
        <div class="upsell-actions"><span class="button">{{- 'general.custom.cart_upsell_button' | t -}}</span></div>
      </a>
    </div>
  {% else %}
    <div class="carousel-cell">
      <div class="cell--inner {% if settings.hide_form == true %}no-form{% endif %}">
        <div class="upsell-image">
          
          <img class="Image--lazyLoad Image--fadeIn" data-src="{{ product.featured_image | img_url: "300x" }}" data-sizes="auto" data-max-width="{{ product.featured_image.width }}" data-max-height="{{ product.featured_image.height }}" data-original-src="{{ product.featured_image | img_url: "master" }}">
        </div>
        <div class="upsell-meta">
          <p class="upsell-title"><a href="{{ product.url }}">{{ product.title | remove: "- None" }}</a></p>
          <p class="upsell-price"><span>{{ product.price | money }}</span></p>

          {% if settings.hide_form == false %}
            {% if product.variants.size > 1 %}
            <p class="upsell-variant">
              <span class="input--wrapper">
              <select class="upsell-variant-trigger add">
                <option value='' disabled selected>Select</option>
                {% for variant in product.variants %}
                  {% if variant.available %}
                    <option value='{"id":"{{ variant.id }}","price":"{{ variant.price }}"}'>{{ variant.title }}</option>
                  {% endif %}
                {% endfor %}
              </select>
              </span>
            </p>
            {% else %}
              <div class="upsell-actions"><button type="button" class="upsell__add_to_cart" data-product="{{ product.selected_or_first_available_variant.id }}"><span>{{- 'general.custom.cart_upsell' | t -}}</span></button></div>
            {% endif %}
          {% endif %}
         </div>
      </div>
    </div>
  {% endif %}
{% endif %}