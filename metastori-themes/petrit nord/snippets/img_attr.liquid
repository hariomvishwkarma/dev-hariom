{% if size %}
  {% assign size_5 = size | append: "x" %}
  {% assign size_4 = size | times: 0.7 | plus: 100 | round | append: "x" %}
  {% assign size_3 = size | times: 0.6 | plus: 100 | round | append: "x" %}
  {% assign size_2 = size | times: 0.5 | plus: 100 | round | append: "x" %}
  {% assign size_1 = size | times: 0.3 | plus: 100 | round | append: "x" %}
{% else %}
  {% assign size_5 = 2020 | append: "x" %}
  {% assign size_4 = 1240 | plus: 100 | append: "x" %}
  {% assign size_3 = 960 | plus: 100 | append: "x" %}
  {% assign size_2 = 720 | plus: 100 | append: "x" %}
  {% assign size_1 = 480 | plus: 100 | append: "x" %}
{% endif %}

data-src="{{ image | img_url: "480x" }}"
data-srcset="
  {{ image | img_url: size_1 }} {{ 480 }}w, 
  {{ image | img_url: size_2 }} {{ 720 }}w, 
  {{ image | img_url: size_3 }} {{ 960 }}w, 
  {{ image | img_url: size_4 }} {{ 1240 }}w,
  {{ image | img_url: size_5 }} 1920w"