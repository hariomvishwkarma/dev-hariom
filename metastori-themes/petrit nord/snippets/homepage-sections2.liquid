{% for block in blocks %}
	{% assign bs = block.settings %}
    {% if bs.show_section %}
    {% if bs.desktop_column %}<div class="hide--tablet-down" style=" flex: 33.3333%; max-width: 33.3333%; "></div>{% endif %}
      
    {% assign type = block.type %}
    {% if template contains "custom_pages_3_" %}
      {% unless template contains "custom_pages_3_0" %}
        {%- case block.type -%}
          {%- when 'hpp_section_cta' -%}
            {% assign type = block.type | append: "_alt" %}
          {%- when 'hpp_section_1' -%}
            {% assign type = block.type | append: "_alt" %}
          {%- when 'hpp_section_post' -%}
            {% assign type = block.type | append: "_alt" %}
          {% endcase %}
      {% endunless %}
    {% endif %}
            
    {%- case block.type -%}
      {%- when 'hpp_section_cta' -%}
        {% assign type = block.type | append: "_alt" %}
        {%- when 'hpp_section_post' -%}
          {% assign type = block.type | append: "_alt" %}
      {% endcase %}
      
    <{% if bs.desktop_full %}div{% else %}section{% endif %} style="z-index: {{ blocks.size | minus: forloop.index }}; {% if block.settings.customcss != blank %}{{ block.settings.customcss }}{% endif %}" id="section--{{ block.id }}" class="section--wrapper  {% if bs.desktop_full %}desktop--full{% endif %} {% if bs.desktop_half %}desktop--half{% endif %} {% if block.type == "hpp_section_bar" %}scroll--element{% endif %}" data-section="{{ type }}">
      <div class="container--{{ bs.width }}">
        <div class="section--inner">
      
          {% if bs.icon != blank %}
            <style>
              {% if bs.icon-custom != blank %}
                @media only screen and (min-width: 720px) {
                  #theme--custom #section--{{ block.id }} .icon--wrapper {
                    {{ bs.icon-custom }}
                  }
                }
              {% endif %}

            
              {% if bs.icon-customm != blank %}
                @media only screen and (max-width: 720px) {
                  #theme--custom #section--{{ block.id }} .icon--wrapper {
                    {{ bs.icon-customm }}
                  }
                }
              {% endif %}
            </style>
            <div class="icon--wrapper"  ><img src="{{ bs.icon | img_url: "180x" }}" /></div>
          {% endif %}
      
          {% if bs.side == "onet" %}
            <div class="svg--wrapper">{{ bs.border }}</div>
          {% endif %}
  
          <div class="section--content border-{{ bs.side }}">
            {% if bs.side == "twot" %}
              <div class="svg--wrapper">{{ bs.border }}</div>
            {% endif %}
      
            {% if bs.side == "threet" %}
              <div class="svg--wrapper style--top" data-height="">{{ bs.border }}</div>
            {% endif %}
      
            {% if bs.border2 != blank %}
              {{ bs.border2 }}
            {% endif %}

            {%- case block.type -%}
              {%- when 'hpp_section_1' -%}
                <div class="image--wrapper {% if bs.shadow %}style--shadowt{% endif %} {% if bs.shadowb %}style--shadowb{% endif %}">
                  {% if bs.imaged != blank %}
                    <img {% if bs.img-stl %}style="{{ bs.img-stl }}"{% endif %} class="show--tablet-down" src="{{ bs.image | img_url: "800x" }}" />
                    <img {% if bs.img-stl %}style="{{ bs.img-stl }}"{% endif %} class="hide--tablet-down" src="{{ bs.imaged | img_url: "1800x" }}" />
                  {% else %}
                    <img {% if bs.img-stl %}style="{{ bs.img-stl }}"{% endif %} src="{{ bs.image | img_url: "800x" }}" />
                  {% endif %}

                  {% if bs.center_heading %}   
                    <div class="content--group {{ bs.style }} hide--tablet-down">
                      <div class="heading--wrapper colour--accent">
                        <h2>
                          {{ bs.title }}
                          {% if bs.subtitle != blank %}
                            <div style="font-size: 0.4em; letter-spacing: normal; margin-top: 0.25em;">{{ bs.subtitle }}</div>
                          {% endif %}
                        </h2>
                    
                     </div>
                    </div>
                  {% endif %}
                </div>
              
                <div class="content--group {{ bs.style }} border-{{ bs.side }}">
              
                  {% if bs.center_heading %}  
                     
                      <div class="heading--wrapper colour--accent show--tablet-down">
                        <h2>{{ bs.title }}</h2>
                      </div>
                  
                  {% else %}
                    <div class="heading--wrapper colour--accent">
                      <h2>{{ bs.title }}</h2>
                    </div>
                  {% endif %}
                  <div class="text--wrapper">
                    {{ bs.text }}
                  </div>
                </div>
            
              {%- when 'hpp_section_carousel' -%}
                              
                {% if block.settings.heading %}
                	<h2 class="text--center">{{ block.settings.heading }} </h2>
                {% endif %}
                    
                {% if block.settings.text %}
                	<div style="{% if block.settins.text_size != 0 %}max-width: {{ block.settings.text_size }}px;{% endif %}{% if block.settings.text_bottom %}padding-bottom: 0;{% endif %}" class="text--wrapper text--center">{{ block.settings.text }}</div>
                {% endif %}
              
                {%- capture flickity_options -%}
                {
                  "prevNextButtons": true,
                  "pageDots": false,
                  "dragThreshold": 8,
                
                "freeScroll": true,
                  "cellAlign": "left", 
                  "contain": true, 
                  "wrapAround": true,
                "groupCells": true
                }
                {%- endcapture -%}
              
                <div class="main-carousel custom--carousel"  data-flickity='{{ flickity_options }}'>
                  {% if block.settings.image_size != 0 %}
                  <style>
                    #section--{{ block.id }} .image--wrapper:before {
                      padding-bottom: {{ block.settings.image_size }}% !important;
                    }
                  </style>
                  {% endif %}
                  
                  {%- assign add_collection = collections[block.settings.collection] -%}
                  {%- for add_product in add_collection.products -%}
                  
                  {% if add_product.tags contains "hide" %}
                  {% else %}
                    <div class="carousel-cell">
                      <a href="{{ add_product.url }}" class="cell--inner">
                        <div class="image--wrapper {% if ss.image_size == 0 %}default-size{% endif %}">
                          <img class="Image--lazyLoad" {% include "img_attr", image: add_product.featured_image, size: 500 %}>
                        </div>
                      </a>
                  </div>
                  {% endif %}
                  {%- endfor -%}
                </div>

              
                {% if block.settings.text2 %}
                	<div style="{% if block.settins.text_size != 0 %}max-width: {{ block.settings.text_size }}px;{% endif %}" class="text--wrapper text--center link--wrapper">{{ block.settings.text2 }}</div>
                {% endif %}
              
              {%- when 'hpp_section_style' -%}

                {%- capture flickity_options -%}
                {
                  "prevNextButtons": false,
                  "adaptiveHeight": false,
                  "wrapAround": true,
                  "dragThreshold": 15,
                  "autoPlay": true,
                "freeScroll": true,
                  "contain": true, 
                  "cellAlign": "center",
                  "pageDots": false
                }
                {%- endcapture -%}
              

                {% if block.settings.heading %}
                	<h2 class="text--center">{{ block.settings.heading }} </h2>
                {% endif %}
                <div class="main-carousel custom--carousel"  data-flickity='{{ flickity_options }}'>
                  {% for i in (1..10) %}
                    {% assign style = "style_" | append: forloop.index %}
                    {% assign image1 = "image_" | append: forloop.index | append: "1" %}
                    {% assign image2 = "image_" | append: forloop.index | append: "2" %}

                    {% if  block.settings[image1] != blank or  block.settings[image2] != blank %}
                    <div class="carousel-cell">
                      <a href="{{ block.settings.url }}" class="cell--inner {{ block.settings[style] }}">
                        <div class="image--wrapper top">
                          <img class="Image--lazyLoad" {% include "img_attr", image: block.settings[image1] , size: 500 %}>
                        </div>
                        <div class="image--wrapper bottom">
                          <img class="Image--lazyLoad" {% include "img_attr", image: block.settings[image2], size: 500  %}>
                        </div>
                        </a>
                      </div>
                      {% endif %}
                  {% endfor %}
                </div>
              
              
              {%- when 'hpp_section_collection' -%}

              {% if bs.url != blank %}
                <a href="{{ bs.url }}">
              {% endif %}
              <div class="layout--wrapper {% if bs.mirror %}layout--reverse{% endif %}">
                {% if bs.mirror %}

                <div class="image--wrapper">
                  <img src="{{ bs.image | img_url: "800x" }}" />
                </div>
                  
                <div>
                  {% if bs.text1 != blank %}
                      <div class="text--wrapper">
                       {{ bs.text1 }}
                      </div>
                  {% endif %}
              
                  <div class="heading--wrapper">
                    <h2>{{ bs.title  | replace: "//", "<br>" }}</h2>
                  </div>
                </div>
              
                {% else %}
                    <div>
                      {% if bs.text1 != blank %}
                          <div class="text--wrapper">
                           {{ bs.text1 }}
                          </div>
                      {% endif %}
                  
                      <div class="heading--wrapper">
                        <h2>{{ bs.title  | replace: "//", "<br>" }}</h2>
                      </div>
                    </div>
                  
                    <div class="image--wrapper">
                      <img src="{{ bs.image | img_url: "800x" }}" />
                    </div>
                {% endif %}
              </div>
              
              {% if bs.url != blank %}
                </a>
              {% endif %}
              {%- when 'hpp_section_heading' -%}

  
                <div class="content--group {{ bs.style }} border-{{ bs.side }}">
                  <div class="heading--wrapper">
                    <h2>{{ bs.title  | replace: "//", "<br>" }}</h2>
                  </div>
                </div>
              {%- when 'hpp_section_bar' -%}
              
                <div class="content scroll--element">
              <div class="content--group">
              
                {% if bs.text != blank %}
                  <div class="text--wrapper"><p>{{ bs.text | remove: "<p>" | remove: "</p>"  }}</p></div>
                {% endif %}
              
                {% if bs.button != blank %}
                  <div class="button--wrapper">{{ bs.button | remove: "<p>" | remove: "</p>"  }}</div>
                {% endif %}
              </div>
                </div>
              
              {%- when 'hpp_section_post' -%}
                {% assign urlWrapper = false %}
                {% if bs.url != blank %}
                  {% unless bs.text1 contains "</a>" or bs.text2 contains "</a>" %}
                    {% assign urlWrapper = true %}
                  {% endunless %}
                {% endif %}
                
                {% if urlWrapper %}
                    <a href="{{ bs.url }}" style="display: block;" class="image--wrapper as {% if bs.shadow %}style--shadowt{% endif %} {% if bs.shadowb %}style--shadowb{% endif %}">
                      {% if bs.imaged != blank and bs.image != blank %}
                        <img {% if bs.img-stl %}style="{{ bs.img-stl }}"{% endif %} class="show--tablet-down" src="{{ bs.image | img_url: "800x" }}" />
                        <img {% if bs.img-stl %}style="{{ bs.img-stl }}"{% endif %} class="hide--tablet-down" src="{{ bs.imaged | img_url: "1800x" }}" />
                      
                      {% else %}
                        {% if bs.image != blank %}
                          <img {% if bs.img-stl %}style="{{ bs.img-stl }}"{% endif %} src="{{ bs.image | img_url: "800x" }}" />
                        {% endif %}
                        
                        {% if bs.imaged != blank %}
                          <img {% if bs.img-stl %}style="{{ bs.img-stl }}"{% endif %} src="{{ bs.imaged | img_url: "800x" }}" />
                        {% endif %}
                      {% endif %}
                    </a>
                    <a href="{{ bs.url }}" style="display: block;" class="content--group {{ bs.style }} border-{{ bs.side }}">
                      <div class="heading--wrapper" data-height2>
                        <h2>{{ bs.title  | replace: "//", "<br>" }}</h2>
                      </div>
                      <div class="text--wrapper">
                        {{ bs.text1 }}
                      </div>
                      <div class="text--wrapper alt">
                        {{ bs.text2 }}
                      </div>
                    </a>
                  {% else %}
                 
                    <div class="image--wrapper as {% if bs.shadow %}style--shadowt{% endif %} {% if bs.shadowb %}style--shadowb{% endif %}">
                      {% if bs.imaged != blank and bs.image != blank %}
                        <img {% if bs.img-stl %}style="{{ bs.img-stl }}"{% endif %} class="show--tablet-down" src="{{ bs.image | img_url: "800x" }}" />
                        <img {% if bs.img-stl %}style="{{ bs.img-stl }}"{% endif %} class="hide--tablet-down" src="{{ bs.imaged | img_url: "1800x" }}" />
                      
                      {% else %}
                        {% if bs.image != blank %}
                          <img {% if bs.img-stl %}style="{{ bs.img-stl }}"{% endif %} src="{{ bs.image | img_url: "800x" }}" />
                        {% endif %}
                        
                        {% if bs.imaged != blank %}
                          <img {% if bs.img-stl %}style="{{ bs.img-stl }}"{% endif %} src="{{ bs.imaged | img_url: "800x" }}" />
                        {% endif %}
                      {% endif %}
                    </div>
                    <div class="content--group {{ bs.style }} border-{{ bs.side }}">
                      <div class="heading--wrapper" data-height2>
                        <h2>{{ bs.title  | replace: "//", "<br>" }}</h2>
                      </div>
                      <div class="text--wrapper">
                        {{ bs.text1 }}
                      </div>
                      {% if bs.text2 != blank %}
                        <div class="text--wrapper alt">
                          {{ bs.text2 }}
                        </div>
                      {% endif %}
                    </div>
                {% endif %}
              
             
              {%- when 'hpp_section_cta' -%}
                {% assign cta_text = bs.textcta | strip %}
                <div class="content--group {{ bs.style }} border-{{ bs.side }} {% if bs.image2 %}columns-two{% endif %}">
                  {% if bs.image2 %}
                    <div class="column-left">
                      <div class="image--wrapper">
                        <svg  class="Icon Icon--play" role="presentation" viewBox="0 0 24 24">
                          <path d="M12 0C5.383 0 0 5.383 0 12s5.383 12 12 12 12-5.383 12-12S18.617 0 12 0zm-2 15.5V9l4.5 3.25L10 15.5z" fill="currentColor"></path>
                        </svg>
                        <img src="{{ bs.image2 | img_url: "500x" }}" />
                      </div>
                   </div>
                  {% endif %}
                  <div class="column-right">
              
                      <div class="text--wrapper">
                        {{ bs.text }}
                      </div>
              
                      <div class="heading--wrapper">
                        <h2>{{ bs.title }}</h2>
                      </div>
                      
                      
                      {% if cta_text != blank %}
                      <div class="text--wrapper cta_text">
                        {{ cta_text }}
                      </div>
                      {% endif %}
                  
                      {% if bs.html != blank %}
                      <div class="html--wrapper">
                        {{ bs.html }}
                      </div>
                      {% endif %}
                  </div>
                </div>
            {% if bs.imaged != blank or bs.image != blank %}
                <div class="image--wrapper {% if bs.shadow %}style--shadowt{% endif %} {% if bs.shadowb %}style--shadowb{% endif %}">
                  {% if bs.imaged != blank %}
                    <img {% if bs.img-stl %}style="{{ bs.img-stl }}"{% endif %} class="show--tablet-down" src="{{ bs.image | img_url: "800x" }}" />
                    <img {% if bs.img-stl %}style="{{ bs.img-stl }}"{% endif %} class="hide--tablet-down" src="{{ bs.imaged | img_url: "1800x" }}" />
                  {% else %}
                    <img {% if bs.img-stl %}style="{{ bs.img-stl }}"{% endif %} src="{{ bs.image | img_url: "800x" }}" />
                  {% endif %}
                </div>
              {% endif %}
            
              {%- when 'hp_section_1' -%}
                <div class="image--wrapper {% if bs.shadow %}style--shadowt{% endif %} {% if bs.shadowb %}style--shadowb{% endif %}">
                  {% if bs.imaged != blank %}
                    <img {% if bs.img-stl %}style="{{ bs.img-stl }}"{% endif %} class="show--tablet-down" src="{{ bs.image | img_url: "800x" }}" />
                    <img {% if bs.img-stl %}style="{{ bs.img-stl }}"{% endif %} class="hide--tablet-down" src="{{ bs.imaged | img_url: "1800x" }}" />
                  {% else %}
                    <img {% if bs.img-stl %}style="{{ bs.img-stl }}"{% endif %} src="{{ bs.image | img_url: "800x" }}" />
                  {% endif %}
                </div>
                <div class="content--group {{ bs.style }} border-{{ bs.side }}">
                  <div class="heading--wrapper colour--accent">
                    <h2>{{ bs.title }}</h2>
                  </div>
                  <div class="text--wrapper">
                    {{ bs.text }}
                  </div>
                </div>
            
              {%- when 'hp_section_2' -%}
                <div class="image--wrapper">
                  <img class="show--tablet-down" src="{{ bs.image | img_url: "800x" }}" />
                  <img class="hide--tablet-down" src="{{ bs.image_desktop | img_url: "master" }}" />
                </div>
                <div class="content--group {{ bs.style }}">
                  <div class="heading--wrapper colour--accent">
                    <h2>{{ bs.title }}</h2>
                  </div>
                  <div class="text--wrapper">
                    {{ bs.text }}
                  </div>
                </div>
            {%- endcase -%}
      
            {% if bs.side == "two" %}
              <div class="svg--wrapper" data-height="">{{ bs.border }}</div>
            {% endif %}
      
            {% if bs.side2 == "two" %}
              <div class="svg--wrapper">{{ bs.border22 }}</div>
            {% endif %}
          </div>
          {% if bs.side == "one" %}
            <div class="svg--wrapper" data-height="0.20">{{ bs.border }}</div>
          {% endif %}

          {% if bs.side2 == "one" %}
            <div class="svg--wrapper">{{ bs.border22 }}</div>
          {% endif %}
        </div>
      </div>
    </{% if bs.desktop_full %}div{% else %}section{% endif %}>
    {% endif %}
      {% if bs.desktop_column %}<div class="hide--tablet-down" style=" flex: 33.3333%; max-width: 33.3333%; "></div>{% endif %}
{% endfor %}

<script>
  if(document.querySelector("[data-section='hpp_section_bar'] .button--wrapper a")) {
    document.querySelector("[data-section='hpp_section_bar'] .button--wrapper a").addEventListener("click", function(e) {
      e.preventDefault();
      if(document.querySelector("[data-section='hpp_section_cta'] button")) {
        document.querySelector("[data-section='hpp_section_cta'] button").dispatchEvent(new Event('click'));
      }
      
      if(document.querySelector("[data-section='hpp_section_cta_alt'] button")) {
        document.querySelector("[data-section='hpp_section_cta_alt'] button").dispatchEvent(new Event('click'));
      }
    });
  }

   document.querySelectorAll("a[href='#ctabutton'], [data-section='hpp_section_cta_alt'] .image--wrapper").forEach(function(el) {
     if(el.closest(".AnnouncementBar")) {
       return;
     }
     el.addEventListener("click", function(e) {
        e.preventDefault();
        if(document.querySelector("[data-section='hpp_section_cta'] button")) {
          document.querySelector("[data-section='hpp_section_cta'] button").dispatchEvent(new Event('click'));
        }
        
        if(document.querySelector("[data-section='hpp_section_cta_alt'] button")) {
          document.querySelector("[data-section='hpp_section_cta_alt'] button").dispatchEvent(new Event('click'));
        }
      });
   });
</script>