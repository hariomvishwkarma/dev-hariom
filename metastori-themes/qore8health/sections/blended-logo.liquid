{% comment %} {% style %}
.blended-logo {
  position: relative;
  background: {{ section.settings.bg_color }};
  padding: {{ section.settings.padding }}px 0;
  overflow: hidden;
}

.blended-logo-inner {
  position: relative;
  z-index: 2;
}

.blended-logo-bg {
  position: absolute;
  left: 50%;
  bottom: {{ section.settings.vertical_offset }}px;
  transform: translateX(-50%);
  opacity: {{ section.settings.opacity | divided_by: 100.0 }};
  width: {{ section.settings.width }}%;
  pointer-events: none;
  z-index: 1;
}

.blended-logo-bg img {
  width: 100%;
  height: auto;
  display: block;
}

.blended-logo-text {
  font-size: {{ section.settings.text_size }}vw;
  color: {{ section.settings.text_color }};
  text-align: center;
  white-space: nowrap;
}

@media screen and (max-width: 768px) {
  .blended-logo-bg {
    width: {{ section.settings.width_mobile }}%;
  }

  .blended-logo-text {
    font-size: {{ section.settings.text_size_mobile }}vw;
  }
}
{% endstyle %}

<div class="blended-logo">

  <!-- BACKGROUND LOGO -->
  <div class="blended-logo-bg">

    {% if section.settings.logo_image != blank %}

      {{ section.settings.logo_image 
        | image_url: width: 2000 
        | image_tag: loading: 'lazy' 
      }}

    {% else %}

      <div class="blended-logo-text">
        {{ section.settings.logo_text }}
      </div>

    {% endif %}

  </div>

  <!-- OPTIONAL CONTENT -->
  {% if section.settings.show_content %}
    <div class="blended-logo-inner">
      {{ section.settings.content }}
    </div>
  {% endif %}

</div>

{% schema %}
{
  "name": "Blended Logo",
  "settings": [
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background",
      "default": "#000000"
    },
    {
      "type": "range",
      "id": "padding",
      "min": 0,
      "max": 200,
      "step": 10,
      "default": 100,
      "label": "Section padding"
    },
    {
      "type": "image_picker",
      "id": "logo_image",
      "label": "Logo image"
    },
    {
      "type": "text",
      "id": "logo_text",
      "label": "Logo text (fallback)",
      "default": "wellness"
    },
    {
      "type": "range",
      "id": "opacity",
      "min": 5,
      "max": 100,
      "step": 5,
      "default": 15,
      "label": "Logo opacity"
    },
    {
      "type": "range",
      "id": "width",
      "min": 50,
      "max": 200,
      "step": 5,
      "default": 130,
      "label": "Logo width (%)"
    },
    {
      "type": "range",
      "id": "width_mobile",
      "min": 50,
      "max": 150,
      "step": 5,
      "default": 100,
      "label": "Mobile width (%)"
    },
    {
      "type": "range",
      "id": "vertical_offset",
      "min": -200,
      "max": 200,
      "step": 10,
      "default": -50,
      "label": "Vertical offset"
    },
    {
      "type": "range",
      "id": "text_size",
      "min": 5,
      "max": 25,
      "step": 1,
      "default": 12,
      "label": "Text size (desktop)"
    },
    {
      "type": "range",
      "id": "text_size_mobile",
      "min": 5,
      "max": 20,
      "step": 1,
      "default": 10,
      "label": "Text size (mobile)"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#ffffff"
    },
    {
      "type": "checkbox",
      "id": "show_content",
      "label": "Show content above logo",
      "default": false
    },
    {
      "type": "richtext",
      "id": "content",
      "label": "Content"
    }
  ],
  "presets": [
    {
      "name": "Blended Logo"
    }
  ]
}
{% endschema %} {% endcomment %}