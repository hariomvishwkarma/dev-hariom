{% style %}
  {%- liquid
    assign cc_heading_lh = section.settings.heading_line_height | default: 97
    assign cc_text_lh = section.settings.text_line_height | default: 100
    assign cc_label_lh = section.settings.feature_title_line_height | default: 100

    if cc_heading_lh < 80
      assign cc_heading_lh = 97
    endif
    if cc_text_lh < 100
      assign cc_text_lh = 100
    endif
    if cc_label_lh < 100
      assign cc_label_lh = 100
    endif
  -%}

  #shopify-section-{{ section.id }} .cellular-core {
    --cc-section-bg: {{ section.settings.section_background }};
    --cc-content-bg: {{ section.settings.content_background }};
    --cc-media-bg: {{ section.settings.media_background }};
    --cc-eyebrow-color: {{ section.settings.eyebrow_color }};
    --cc-heading-color: {{ section.settings.heading_color }};
    --cc-text-color: {{ section.settings.text_color }};
    --cc-label-color: {{ section.settings.feature_title_color }};
    --cc-icon-border-color: {{ section.settings.icon_border_color }};
    --cc-icon-color: {{ section.settings.icon_color }};
    --cc-overlay-color: {{ section.settings.image_overlay_color }};
    --cc-overlay-opacity: {{ section.settings.image_overlay_opacity | divided_by: 100.0 }};
    --cc-border-radius: {{ section.settings.container_radius }}px;
    --cc-media-width: {{ section.settings.media_column_width }}%;
    --cc-eyebrow-size: {{ section.settings.eyebrow_size }}px;
    --cc-eyebrow-size-mobile: {{ section.settings.eyebrow_size_mobile }}px;
    --cc-heading-size: {{ section.settings.heading_size }}px;
    --cc-heading-size-mobile: {{ section.settings.heading_size_mobile }}px;
    --cc-text-size: {{ section.settings.text_size }}px;
    --cc-text-size-mobile: {{ section.settings.text_size_mobile }}px;
    --cc-label-size: {{ section.settings.feature_title_size }}px;
    --cc-label-size-mobile: {{ section.settings.feature_title_size_mobile }}px;
    --cc-icon-size: {{ section.settings.icon_size }}px;
    --cc-image-zoom: {{ section.settings.image_hover_scale | divided_by: 100.0 }};
    --cc-content-padding-x: {{ section.settings.content_padding_horizontal }}px;
    --cc-content-padding-y: {{ section.settings.content_padding_vertical }}px;
    --cc-content-padding-x-mobile: {{ section.settings.content_padding_horizontal_mobile }}px;
    --cc-content-padding-y-mobile: {{ section.settings.content_padding_vertical_mobile }}px;
    --cc-badges-gap: {{ section.settings.features_gap }}px;
    --cc-badges-gap-mobile: {{ section.settings.features_gap_mobile }}px;
    --cc-badges-top-spacing: {{ section.settings.features_top_spacing }}px;
    --cc-max-height-desktop: {{ section.settings.section_max_height_desktop }}px;
    --cc-media-height-mobile: {{ section.settings.media_height_mobile }}px;
    --cc-heading-max-width: {{ section.settings.heading_max_width }}px;
    --cc-description-max-width: {{ section.settings.description_max_width }}px;
    --cc-heading-tracking: {{ section.settings.heading_letter_spacing | divided_by: 100.0 }}em;
    --cc-eyebrow-tracking: {{ section.settings.eyebrow_letter_spacing | divided_by: 100.0 }}em;
    background-color: var(--cc-section-bg);
  }

  #shopify-section-{{ section.id }} .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top_mobile }}px !important;
    padding-bottom: {{ section.settings.padding_bottom_mobile }}px !important;
  }

  @media screen and (min-width: 990px) {
    #shopify-section-{{ section.id }} .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top_desktop }}px !important;
      padding-bottom: {{ section.settings.padding_bottom_desktop }}px !important;
    }
  }

  #shopify-section-{{ section.id }} .cellular-core__shell {
    max-width: 100%;
    margin: 0 auto;
    overflow: hidden;
    border-radius: var(--cc-border-radius);
  }

  #shopify-section-{{ section.id }} .cellular-core__grid {
    display: grid;
    grid-template-columns: 1fr;
  }

  #shopify-section-{{ section.id }} .cellular-core__media {
    background-color: var(--cc-media-bg);
    height: var(--cc-media-height-mobile);
    min-height: var(--cc-media-height-mobile);
    position: relative;
    overflow: hidden;
  }

  #shopify-section-{{ section.id }} .cellular-core__media-inner {
    position: relative;
    width: 100%;
    height: 100%;
    min-height: inherit;
  }

  #shopify-section-{{ section.id }} .cellular-core__media-inner--contain {
    display: flex;
    align-items: center;
    justify-content: center;
  }

  #shopify-section-{{ section.id }} .cellular-core__media-inner--cover {
    min-height: inherit;
  }

  #shopify-section-{{ section.id }} .cellular-core__image-wrap {
    position: relative;
    overflow: hidden;
    width: 100%;
    height: 100%;
    flex: 1;
  }

  #shopify-section-{{ section.id }} .cellular-core__media-inner--contain .cellular-core__image-wrap {
    display: flex;
    align-items: center;
    justify-content: center;
  }

  #shopify-section-{{ section.id }} .cellular-core__media-inner--cover .cellular-core__image-wrap {
    position: absolute;
    inset: 0;
  }

  #shopify-section-{{ section.id }} .cellular-core__image-wrap--placeholder {
    display: flex;
    align-items: center;
    justify-content: center;
    background-color: rgba(0, 0, 0, 0.04);
    min-height: var(--cc-media-height-mobile);
  }

  #shopify-section-{{ section.id }} .cellular-core__placeholder {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  #shopify-section-{{ section.id }} .cellular-core__image,
  #shopify-section-{{ section.id }} .cellular-core__video {
    width: 100%;
    height: 100%;
    display: block;
    transition: transform 0.7s ease;
  }

  #shopify-section-{{ section.id }} .cellular-core__media-inner--contain .cellular-core__image {
    width: 100%;
    height: 100%;
    object-fit: contain;
    object-position: center;
  }

  #shopify-section-{{ section.id }} .cellular-core__media-inner--cover .cellular-core__image,
  #shopify-section-{{ section.id }} .cellular-core__media-inner--cover .cellular-core__video {
    object-fit: cover;
    object-position: center;
  }

  #shopify-section-{{ section.id }} .cellular-core__image-wrap:hover .cellular-core__image {
    transform: scale(var(--cc-image-zoom));
  }

  #shopify-section-{{ section.id }} .cellular-core__image-overlay {
    position: absolute;
    inset: 0;
    background-color: var(--cc-overlay-color);
    opacity: var(--cc-overlay-opacity);
    pointer-events: none;
  }

  #shopify-section-{{ section.id }} .cellular-core__content {
    background-color: var(--cc-content-bg);
    padding: var(--cc-content-padding-y-mobile) var(--cc-content-padding-x-mobile);
  }

  #shopify-section-{{ section.id }} .cellular-core__eyebrow {
    margin: 0 0 19px !important;
    padding: 0 !important;
    color: var(--cc-eyebrow-color) !important;
    font-family: 'Libre Franklin', var(--font-body), sans-serif !important;
    font-size: var(--cc-eyebrow-size-mobile) !important;
    font-weight: 600 !important;
    letter-spacing: var(--cc-eyebrow-tracking) !important;
    line-height: 1.2 !important;
    text-transform: uppercase !important;
  }

  #shopify-section-{{ section.id }} .cellular-core__heading,
  #shopify-section-{{ section.id }} h2.cellular-core__heading {
    margin: 0 !important;
    padding: 0 !important;
    max-width: var(--cc-heading-max-width) !important;
    color: var(--cc-heading-color) !important;
    font-family: 'DM Sans', var(--font-headline), sans-serif !important;
    font-size: var(--cc-heading-size-mobile) !important;
    font-weight: 500 !important;
    letter-spacing: var(--cc-heading-tracking) !important;
    line-height: {{ cc_heading_lh }}% !important;
    text-transform: none !important;
  }

  #shopify-section-{{ section.id }} .cellular-core__description,
  #shopify-section-{{ section.id }} .cellular-core__description.rte {
    margin: 23px 0 0 !important;
    max-width: var(--cc-description-max-width) !important;
    color: var(--cc-text-color) !important;
    font-family: 'Libre Franklin', var(--font-body), sans-serif !important;
    font-size: var(--cc-text-size-mobile) !important;
    font-weight: 400 !important;
    line-height: {{ cc_text_lh }}% !important;
  }

  #shopify-section-{{ section.id }} .cellular-core__description p,
  #shopify-section-{{ section.id }} .cellular-core__description.rte p {
    margin: 0 !important;
    padding: 0 !important;
    color: var(--cc-text-color) !important;
    font-family: 'Libre Franklin', var(--font-body), sans-serif !important;
    font-size: var(--cc-text-size-mobile) !important;
    font-weight: 400 !important;
    line-height: {{ cc_text_lh }}% !important;
  }

  #shopify-section-{{ section.id }} .cellular-core__badges {
    margin-top: var(--cc-badges-top-spacing);
  }

  #shopify-section-{{ section.id }} .cellular-core__badges-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--cc-badges-gap-mobile);
  }

  #shopify-section-{{ section.id }} .cellular-core__badge {
    min-width: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  #shopify-section-{{ section.id }} .cellular-core__badge-icon {
    width: var(--cc-icon-size);
    height: var(--cc-icon-size);
    border: 1px solid var(--cc-icon-border-color);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--cc-icon-color);
    flex-shrink: 0;
  }

  #shopify-section-{{ section.id }} .cellular-core__badge-icon-img {
    width: 55%;
    height: 55%;
    object-fit: contain;
    display: block;
  }

  #shopify-section-{{ section.id }} .cellular-core__badge-icon-svg {
    width: 50%;
    height: 50%;
    display: block;
  }

  #shopify-section-{{ section.id }} .cellular-core__badge-label {
    margin: 12px 0 0 !important;
    padding: 0 !important;
    color: var(--cc-label-color) !important;
    font-family: 'Libre Franklin', var(--font-body), sans-serif !important;
    font-size: var(--cc-label-size-mobile) !important;
    font-weight: 400 !important;
    line-height: {{ cc_label_lh }}% !important;
    text-transform: none !important;
  }

  @media screen and (min-width: 750px) {
    #shopify-section-{{ section.id }} .cellular-core__badges-grid {
      grid-template-columns: repeat(6, minmax(0, 1fr));
      gap: var(--cc-badges-gap);
    }
  }

  @media screen and (min-width: 990px) {
    #shopify-section-{{ section.id }} .cellular-core__shell {
      max-height: var(--cc-max-height-desktop);
    }

    #shopify-section-{{ section.id }} .cellular-core__grid {
      grid-template-columns: var(--cc-media-width) calc(100% - var(--cc-media-width));
      height: var(--cc-max-height-desktop);
      max-height: var(--cc-max-height-desktop);
      min-height: 0;
    }

    #shopify-section-{{ section.id }} .cellular-core__content {
      display: flex;
      flex-direction: column;
      justify-content: center;
      overflow: hidden;
      padding: var(--cc-content-padding-y) var(--cc-content-padding-x);
    }

    #shopify-section-{{ section.id }} .cellular-core__media {
      min-height: 0;
      height: 100%;
    }

    #shopify-section-{{ section.id }} .cellular-core__media-inner {
      min-height: 0;
      height: 100%;
    }

    #shopify-section-{{ section.id }} .cellular-core__image-wrap--placeholder {
      min-height: 0;
    }

    #shopify-section-{{ section.id }} .cellular-core__eyebrow {
      margin: 0 0 24px !important;
      font-size: var(--cc-eyebrow-size) !important;
    }

    #shopify-section-{{ section.id }} .cellular-core__heading,
    #shopify-section-{{ section.id }} h2.cellular-core__heading {
      font-size: var(--cc-heading-size) !important;
    }

    #shopify-section-{{ section.id }} .cellular-core__description,
    #shopify-section-{{ section.id }} .cellular-core__description.rte {
      margin: 28px 0 0 !important;
      font-size: var(--cc-text-size) !important;
    }

    #shopify-section-{{ section.id }} .cellular-core__description p,
    #shopify-section-{{ section.id }} .cellular-core__description.rte p {
      font-size: var(--cc-text-size) !important;
    }

    #shopify-section-{{ section.id }} .cellular-core__badge-label {
      font-size: var(--cc-label-size) !important;
    }
  }
{% endstyle %}

<link
  rel="stylesheet"
  href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@500&family=Libre+Franklin:wght@400;600&display=swap"
  media="print"
  onload="this.media='all'"
>

<div class="cellular-core section-{{ section.id }}-padding">
  <div class="cellular-core__shell">
    <div class="cellular-core__grid">
      <div class="cellular-core__media">
        <div class="cellular-core__media-inner cellular-core__media-inner--{{ section.settings.image_layout }}">
          {% if section.settings.media_type == 'video' and section.settings.video != blank %}
            <div class="cellular-core__image-wrap">
              {{
                section.settings.video
                | video_tag:
                  image_size: '1100x',
                  autoplay: section.settings.video_autoplay,
                  loop: section.settings.video_loop,
                  muted: section.settings.video_muted,
                  controls: section.settings.video_controls,
                  playsinline: true,
                  class: 'cellular-core__video'
              }}
              <span class="cellular-core__image-overlay" aria-hidden="true"></span>
            </div>
          {% elsif section.settings.image != blank %}
            {%- assign media_width = 1600 -%}
            {%- assign media_height = section.settings.image.height
              | times: 1600
              | divided_by: section.settings.image.width
              | round
            -%}
            <div class="cellular-core__image-wrap">
              {{
                section.settings.image
                | image_url: width: 1600
                | image_tag:
                  loading: 'lazy',
                  width: media_width,
                  height: media_height,
                  class: 'cellular-core__image',
                  sizes: '(min-width: 990px) 48vw, 100vw',
                  widths: '375, 550, 750, 1100, 1500, 1600',
                  alt: section.settings.image_alt
              }}
              <span class="cellular-core__image-overlay" aria-hidden="true"></span>
            </div>
          {% else %}
            <div class="cellular-core__image-wrap cellular-core__image-wrap--placeholder">
              {{ 'product-1' | placeholder_svg_tag: 'cellular-core__placeholder' }}
            </div>
          {% endif %}
        </div>
      </div>

      <div class="cellular-core__content">
        {% if section.settings.eyebrow != blank %}
          <p class="cellular-core__eyebrow">{{ section.settings.eyebrow }}</p>
        {% endif %}

        {% if section.settings.heading != blank %}
          <h2 class="cellular-core__heading">{{ section.settings.heading }}</h2>
        {% endif %}

        {% if section.settings.description != blank %}
          <div class="cellular-core__description rte">{{ section.settings.description }}</div>
        {% endif %}

        {% if section.blocks.size > 0 %}
          <div class="cellular-core__badges">
            <div class="cellular-core__badges-grid">
              {% for block in section.blocks %}
                <div class="cellular-core__badge" {{ block.shopify_attributes }}>
                  <div class="cellular-core__badge-icon">
                    {% if block.settings.icon != blank %}
                      {%- assign icon_width = block.settings.icon.width | default: 64 -%}
                      {%- assign icon_height = block.settings.icon.height | default: 64 -%}
                      {{
                        block.settings.icon
                        | image_url: width: 64
                        | image_tag:
                          loading: 'lazy',
                          width: icon_width,
                          height: icon_height,
                          class: 'cellular-core__badge-icon-img',
                          alt: block.settings.title
                      }}
                    {% else %}
                      {% case block.settings.icon_style %}
                        {% when 'non_gmo' %}
                          <svg class="cellular-core__badge-icon-svg" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                            <path d="M8 4v16M16 4v16M4 8h16M4 16h16" fill="none" stroke="currentColor" stroke-width="1.2" stroke-linecap="round"></path>
                          </svg>
                        {% when 'preservative' %}
                          <svg class="cellular-core__badge-icon-svg" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                            <path d="M10 3h4v3l5 12H5L10 6V3z" fill="none" stroke="currentColor" stroke-width="1.2" stroke-linejoin="round"></path>
                            <path d="M8 21h8" fill="none" stroke="currentColor" stroke-width="1.2" stroke-linecap="round"></path>
                          </svg>
                        {% when 'tested' %}
                          <svg class="cellular-core__badge-icon-svg" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                            <rect x="7" y="3" width="10" height="18" rx="2" fill="none" stroke="currentColor" stroke-width="1.2"></rect>
                            <path d="M9 14l2 2 4-4" fill="none" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round"></path>
                          </svg>
                        {% when 'capsule' %}
                          <svg class="cellular-core__badge-icon-svg" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                            <rect x="9" y="4" width="6" height="16" rx="3" fill="none" stroke="currentColor" stroke-width="1.2"></rect>
                            <path d="M9 12h6" fill="none" stroke="currentColor" stroke-width="1.2"></path>
                          </svg>
                        {% when 'australia' %}
                          <svg class="cellular-core__badge-icon-svg" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                            <path d="M6 18c2-6 4-10 6-12 2 2 4 6 6 12H6z" fill="none" stroke="currentColor" stroke-width="1.2" stroke-linejoin="round"></path>
                          </svg>
                        {% else %}
                          <svg class="cellular-core__badge-icon-svg" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                            <path d="M12 3l2 6h6l-5 4 2 6-5-4-5 4 2-6-5-4h6l2-6z" fill="none" stroke="currentColor" stroke-width="1.2" stroke-linejoin="round"></path>
                            <path d="M4 20l16-12" fill="none" stroke="currentColor" stroke-width="1.2" stroke-linecap="round"></path>
                          </svg>
                      {% endcase %}
                    {% endif %}
                  </div>

                  {% if block.settings.title != blank %}
                    <p class="cellular-core__badge-label">{{ block.settings.title }}</p>
                  {% endif %}
                </div>
              {% endfor %}
            </div>
          </div>
        {% endif %}
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Cellular Core",
  "tag": "section",
  "class": "section-cellular-core",
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Our signature formula"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Built on a cellular core."
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "Description",
      "default": "<p>Cellular Core brings together the nutrients your body relies on most — helping support energy, recovery, and everyday performance from the inside out.</p>"
    },
    {
      "type": "header",
      "content": "Media"
    },
    {
      "type": "select",
      "id": "media_type",
      "label": "Media type",
      "options": [
        {
          "value": "image",
          "label": "Image"
        },
        {
          "value": "video",
          "label": "Shopify video"
        }
      ],
      "default": "image"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "video",
      "id": "video",
      "label": "Video"
    },
    {
      "type": "checkbox",
      "id": "video_autoplay",
      "label": "Video autoplay",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "video_loop",
      "label": "Video loop",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "video_muted",
      "label": "Video muted",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "video_controls",
      "label": "Show video controls",
      "default": false
    },
    {
      "type": "text",
      "id": "image_alt",
      "label": "Image alt text",
      "default": "Cellular Core product"
    },
    {
      "type": "select",
      "id": "image_layout",
      "label": "Media layout",
      "options": [
        {
          "value": "contain",
          "label": "Natural fit"
        },
        {
          "value": "cover",
          "label": "Full cover"
        }
      ],
      "default": "contain"
    },
    {
      "type": "color",
      "id": "image_overlay_color",
      "label": "Media overlay color",
      "default": "#000000"
    },
    {
      "type": "range",
      "id": "image_overlay_opacity",
      "label": "Media overlay opacity",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "%",
      "default": 0
    },
    {
      "type": "range",
      "id": "image_hover_scale",
      "label": "Image hover zoom",
      "min": 100,
      "max": 700,
      "step": 10,
      "unit": "%",
      "default": 110
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "section_background",
      "label": "Section background",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "content_background",
      "label": "Content column background",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "media_background",
      "label": "Media column background",
      "default": "#f3f3f1"
    },
    {
      "type": "color",
      "id": "eyebrow_color",
      "label": "Eyebrow color",
      "default": "#8a9a94"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading color",
      "default": "#0e5a4f"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Description color",
      "default": "#6b7c76"
    },
    {
      "type": "color",
      "id": "feature_title_color",
      "label": "Badge label color",
      "default": "#6b7c76"
    },
    {
      "type": "color",
      "id": "icon_border_color",
      "label": "Icon border color",
      "default": "#c4883a"
    },
    {
      "type": "color",
      "id": "icon_color",
      "label": "Icon color",
      "default": "#c4883a"
    },
    {
      "type": "header",
      "content": "Typography"
    },
    {
      "type": "range",
      "id": "eyebrow_size",
      "label": "Eyebrow size desktop",
      "min": 9,
      "max": 15,
      "step": 1,
      "unit": "px",
      "default": 11
    },
    {
      "type": "range",
      "id": "eyebrow_size_mobile",
      "label": "Eyebrow size mobile",
      "min": 8,
      "max": 13,
