<section id="LongevityCore-{{ sid }}" class="lc-section">
  <div class="lc-wrap wt-section__wrapper">
    {%- if s.heading != blank -%}
      <h2 class="lc-heading">{{ s.heading }}</h2>
    {%- endif -%}

    <div class="lc-panel">
      <div class="lc-grid">
        {%- for block in section.blocks -%}
          {%- liquid
            case block.settings.icon
              when 'wheat'
                assign svg = icon_wheat
              when 'capsule'
                assign svg = icon_capsule
              when 'tube'
                assign svg = icon_tube
              when 'dna'
                assign svg = icon_dna
              when 'flask'
                assign svg = icon_flask
              when 'australia'
                assign svg = icon_australia
              when 'leaf'
                assign svg = icon_leaf
              when 'shield'
                assign svg = icon_shield
              when 'drop'
                assign svg = icon_drop
              else
                assign svg = icon_leaf
            endcase
          -%}
          <div class="lc-badge" {{ block.shopify_attributes }}>
            <span class="lc-ring">
              {%- if block.settings.icon_source == 'image' and block.settings.icon_image != blank -%}
                <img
                  class="lc-img{% if block.settings.image_fill %} is-fill{% endif %}"
                  src="{{ block.settings.icon_image | image_url: width: 320 }}"
                  alt="{{ block.settings.label | escape }}"
                  loading="lazy"
                  width="{{ block.settings.icon_image.width }}"
                  height="{{ block.settings.icon_image.height }}">
              {%- elsif block.settings.icon_source == 'custom_svg' and block.settings.custom_svg != blank -%}
                {{ block.settings.custom_svg }}
              {%- else -%}
                {{ svg }}
              {%- endif -%}
            </span>
            {%- if block.settings.label != blank -%}
              <p class="lc-label">{{ block.settings.label }}</p>
            {%- endif -%}
          </div>
        {%- endfor -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Longevity Core Badges",
  "tag": "section",
  "class": "section-longevity-core",
  "settings": [
    {
      "type": "header",
      "content": "Background"
    },
