{%- comment -%}
  Section: Longevity Core Badges
  Recreates the "Longevity Starts at the Core." trust-badge band.
  - Desktop: single row of badges
  - Mobile: configurable grid (default 3 columns)
  - Background image + tint, teal panel, cream line-icons in thin rings
  Each badge is a block: pick an icon + write a label.
{%- endcomment -%}

{%- liquid
  assign s = section.settings
  assign sid = section.id

  assign overlay_alpha = s.overlay_opacity | divided_by: 100.0
-%}

{%- style -%}
  #LongevityCore-{{ sid }} {
    position: relative;
    isolation: isolate;
    background-color: {{ s.fallback_bg }};
    background-size: cover;
    background-position: {{ s.bg_focal | default: 'center center' }};
    background-repeat: no-repeat;
    padding-top: {{ s.padding_top }}px;
    padding-bottom: {{ s.padding_bottom }}px;
    {% if s.bg_image != blank %}
      background-image: url('{{ s.bg_image | image_url: width: 2200 }}');
    {% endif %}
  }

  #LongevityCore-{{ sid }}::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background-color: {{ s.overlay_color }};
    opacity: {{ overlay_alpha }};
    pointer-events: none;
  }

  #LongevityCore-{{ sid }} .lc-wrap {
    padding-inline: {{ s.side_padding }}px;
  }

  #LongevityCore-{{ sid }} .lc-heading {
    margin: 0 0 {{ s.heading_gap }}px;
    color: {{ s.heading_color }};
    font-size: {{ s.heading_size }}px;
    line-height: 1.05;
    letter-spacing: -0.01em;
    text-align: {{ s.heading_align }};
  }

  #LongevityCore-{{ sid }} .lc-panel {
    background-color: {{ s.panel_color }};
    border-radius: {{ s.panel_radius }}px;
    padding: {{ s.panel_pad_y }}px {{ s.panel_pad_x }}px;
  }

  #LongevityCore-{{ sid }} .lc-grid {
    display: grid;
    grid-template-columns: repeat({{ s.desktop_columns }}, minmax(0, 1fr));
    gap: {{ s.row_gap }}px {{ s.col_gap }}px;
    align-items: start;
  }

  #LongevityCore-{{ sid }} .lc-badge {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  #LongevityCore-{{ sid }} .lc-ring {
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: {{ s.label_gap }}px;
  }

  #LongevityCore-{{ sid }} .lc-ring svg {
    width: {{ s.icon_size }}px;
    height: {{ s.icon_size }}px;
    color: {{ s.icon_color }};
    display: block;
  }

  #LongevityCore-{{ sid }} .lc-ring .lc-img {
    width: {{ s.icon_siz }}px;
    height: {{ s.icon_size }}px;
    object-fit: contain;
    display: block;
  }

  #LongevityCore-{{ sid }} .lc-ring .lc-img.is-fill {
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: 50%;
  }

  #LongevityCore-{{ sid }} .lc-label {
    margin: 0;
    color: {{ s.label_color }};
    font-size: {{ s.label_size }}px;
    line-height: 1.25;
    font-weight: {{ s.label_weight }};
    max-width: 14ch;
  }

  @media screen and (max-width: 749px) {
    #LongevityCore-{{ sid }} {
      padding-top: {{ s.padding_top_mobile }}px;
      padding-bottom: {{ s.padding_bottom_mobile }}px;
    }
    #LongevityCore-{{ sid }} .lc-heading {
      font-size: {{ s.heading_size_mobile }}px;
      text-align: {{ s.heading_align_mobile }};
    }
    #LongevityCore-{{ sid }} .lc-panel {
      padding: {{ s.panel_pad_y_mobile }}px {{ s.panel_pad_x_mobile }}px;
    }
    #LongevityCore-{{ sid }} .lc-grid {
      grid-template-columns: repeat({{ s.mobile_columns }}, minmax(0, 1fr));
      gap: {{ s.row_gap_mobile }}px {{ s.col_gap_mobile }}px;
    }
    #LongevityCore-{{ sid }} .lc-ring {
      width: {{ s.icon_size_mobile }}px;
      height: {{ s.icon_size_mobile }}px;
    }
    #LongevityCore-{{ sid }} .lc-ring svg {
      width: {{ s.icon_size_mobile }}px;
      height: {{ s.icon_size_mobile }}px;
    }
    #LongevityCore-{{ sid }} .lc-ring .lc-img {
      width: {{ s.icon_size_mobile }}px;
      height: {{ s.icon_size_mobile }}px;
    }
    #LongevityCore-{{ sid }} .lc-ring .lc-img.is-fill {
      width: 100%;
      height: 100%;
    }
    #LongevityCore-{{ sid }} .lc-label {
      font-size: {{ s.label_size_mobile }}px;
      overflow-wrap: normal;
    }
  }
{%- endstyle -%}

