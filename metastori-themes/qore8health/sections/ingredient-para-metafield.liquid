{%- liquid
  assign items_list = product.metafields.custom.ingredient_para.value
  assign text_rgb = section.settings.color_text | color_to_rgb
  assign bg_rgb = section.settings.background_color | color_to_rgb
-%}

<style>
  .page-width.wt-ingredient-para__inner {
    max-width: 1400px;
    margin: 0 auto;
    padding: 0 40px;
  }
  .wt-ingredient-para__heading.headline--rich h2 {
    padding: 0;
  }
  .wt-ingredient-para__image svg {
    width: 100%;
    height: 100%;
  }
  #shopify-section-{{ section.id }} {
    {% if bg_rgb != 'rgba(0, 0, 0, 0.0)' %}
      --section-bg-color: {{ section.settings.background_color }};
    {% endif %}

    {% if text_rgb != 'rgba(0, 0, 0, 0.0)' %}
      --section-text-color: {{ section.settings.color_text }};
    {% endif %}

    --row-gap-desktop: {{ section.settings.row_gap_desktop }}px;
    --row-gap-mobile: {{ section.settings.row_gap_mobile }}px;
    --col-gap-desktop: {{ section.settings.col_gap_desktop }}px;
    --col-gap-mobile: {{ section.settings.col_gap_mobile }}px;
    --section-padding-top: {{ section.settings.padding_top }}px;
    --section-padding-bottom: {{ section.settings.padding_bottom }}px;
    --image-ratio: {% if section.settings.image_ratio == 'square' %}1 / 1{% elsif section.settings.image_ratio == 'landscape' %}4 / 3{% elsif section.settings.image_ratio == 'portrait' %}3 / 4{% else %}auto{% endif %};
    --heading-scale-desk: {{ section.settings.size_heading | divided_by: 100.0 }};
    --heading-scale-mob: {{ section.settings.size_heading_mobile | divided_by: 100.0 }};
  }

  .wt-ingredient-para {
    {% if bg_rgb != 'rgba(0, 0, 0, 0.0)' %}background-color: var(--section-bg-color);{% endif %}
    {% if text_rgb != 'rgba(0, 0, 0, 0.0)' %}color: var(--section-text-color);{% endif %}
    padding-top: var(--section-padding-top) !important;
    padding-bottom: var(--section-padding-bottom) !important;
  }

  .wt-ingredient-para__inner {
    display: flex;
    flex-direction: column;
    gap: var(--row-gap-mobile);
  }

  .wt-ingredient-para__row {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--col-gap-mobile);
    align-items: center;
  }

  .wt-ingredient-para__image {
    aspect-ratio: var(--image-ratio);
    overflow: hidden;
    border-radius: 8px;
  }

  .wt-ingredient-para__image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .wt-ingredient-para__content {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .wt-ingredient-para__heading {
    --font-headline-scale: var(--heading-scale-mob);
    margin: 0;
  }

  .wt-ingredient-para__description {
    line-height: 1.6;
  }

  @media (min-width: 750px) {
    .wt-ingredient-para__inner {
      gap: var(--row-gap-desktop);
    }

    .wt-ingredient-para__row {
      grid-template-columns: 1fr 1fr;
      gap: var(--col-gap-desktop);
    }

    /* First row: Text left, Image right */
    .wt-ingredient-para__row .wt-ingredient-para__content { order: 1; }
    .wt-ingredient-para__row .wt-ingredient-para__image { order: 2; }

    /* Alternate: even rows reversed (Image left, Text right) */
    .wt-ingredient-para__row--reverse .wt-ingredient-para__content { order: 2; }
    .wt-ingredient-para__row--reverse .wt-ingredient-para__image { order: 1; }

    .wt-ingredient-para__heading {
      --font-headline-scale-desk: var(--heading-scale-desk);
    }
  }
  @media (max-width: 750px) {
    .page-width.wt-ingredient-para__inner {
      padding: 0 20px;
    }
  }
</style>

{%- if items_list != blank and items_list.size > 0 -%}
  <section class="wt-ingredient-para" data-section-id="{{ section.id }}">
    <div class="page-width wt-ingredient-para__inner">
      {%- if section.settings.heading != blank or section.settings.subheading != blank -%}
        <div class="wt-ingredient-para__section-header">
          {%- if section.settings.subheading != blank -%}
            <p class="wt-ingredient-para__subheading">{{ section.settings.subheading }}</p>
          {%- endif -%}
          {%- if section.settings.heading != blank -%}
            <h2 class="wt-ingredient-para__section-heading headline headline--rich">{{ section.settings.heading }}</h2>
          {%- endif -%}
        </div>
      {%- endif -%}

      {%- for item in items_list -%}
        {%- assign is_reverse = false -%}
        {%- assign mod = forloop.index0 | modulo: 2 -%}
        {%- if mod == 1 -%}
          {%- assign is_reverse = true -%}
        {%- endif -%}

        <div class="wt-ingredient-para__row {% if is_reverse %}wt-ingredient-para__row--reverse{% endif %}">
          <div class="wt-ingredient-para__image">
            {%- if item.image != blank -%}
              {{
                item.image
                | image_url: width: 1200
                | image_tag:
                  loading: 'lazy',
                  sizes: '(min-width: 750px) 50vw, 100vw',
                  widths: '375, 550, 750, 1100, 1500',
                  alt: item.title
              }}
            {%- else -%}
              {{ 'product-apparel-1' | placeholder_svg_tag: 'placeholder-svg' }}
            {%- endif -%}
          </div>

          <div class="wt-ingredient-para__content">
            {%- if item.title != blank -%}
              <div class="wt-ingredient-para__heading headline--rich">
                <h2>{{ item.title }}</h2>
              </div>
            {%- endif -%}

            {%- if item.para != blank -%}
              <div class="wt-ingredient-para__description rte">
                {{ item.para | metafield_tag }}
              </div>
            {%- endif -%}
          </div>
        </div>
      {%- endfor -%}
    </div>
  </section>
{%- endif -%}

{% schema %}
{
  "name": "Ingredient Para",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "paragraph",
      "content": "Rows are auto-generated from product metafield: custom.ingredient_para (List of metaobjects). First row starts with Text left, Image right; subsequent rows alternate."
    },
    {
      "type": "header",
      "content": "Section Header (optional)"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Heading"
    },
    {
      "type": "header",
      "content": "Image"
    },
    {
      "type": "select",
      "id": "image_ratio",
      "options": [
        { "value": "adapt", "label": "Adapt to image" },
        { "value": "square", "label": "Square (1:1)" },
        { "value": "landscape", "label": "Landscape (4:3)" },
        { "value": "portrait", "label": "Portrait (3:4)" }
      ],
      "default": "landscape",
      "label": "Image ratio"
    },
    {
      "type": "header",
      "content": "Typography"
    },
    {
      "type": "range",
      "id": "size_heading",
      "min": 50,
      "max": 500,
      "step": 10,
      "default": 100,
      "unit": "%",
      "label": "Heading size (desktop)"
    },
    {
      "type": "range",
      "id": "size_heading_mobile",
      "min": 80,
      "max": 300,
      "step": 10,
      "default": 100,
      "unit": "%",
      "label": "Heading size (mobile)"
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "background_color",
      "default": "transparent",
      "label": "Background color"
    },
    {
      "type": "color",
      "id": "color_text",
      "default": "transparent",
      "label": "Text color"
    },
    {
      "type": "header",
      "content": "Spacing — Desktop"
    },
    {
      "type": "range",
      "id": "row_gap_desktop",
      "min": 0,
      "max": 200,
      "step": 4,
      "default": 80,
      "unit": "px",
      "label": "Gap between rows"
    },
    {
      "type": "range",
      "id": "col_gap_desktop",
      "min": 0,
      "max": 120,
      "step": 4,
      "default": 60,
      "unit": "px",
      "label": "Gap between image and text"
    },
    {
      "type": "header",
      "content": "Spacing — Mobile"
    },
    {
      "type": "range",
      "id": "row_gap_mobile",
      "min": 0,
      "max": 100,
      "step": 4,
      "default": 40,
      "unit": "px",
      "label": "Gap between rows"
    },
    {
      "type": "range",
      "id": "col_gap_mobile",
      "min": 0,
      "max": 60,
      "step": 4,
      "default": 20,
      "unit": "px",
      "label": "Gap between image and text"
    },
    {
      "type": "header",
      "content": "Section Padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 200,
      "step": 4,
      "default": 60,
      "unit": "px",
      "label": "Top padding"
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 200,
      "step": 4,
      "default": 60,
      "unit": "px",
      "label": "Bottom padding"
    }
  ],
  "presets": [
    {
      "name": "Ingredient Para (Metafield)"
    }
  ],
  "enabled_on": {
    "templates": ["product"]
  }
}
{% endschema %}
