{{ 'component-image-with-text.css' | asset_url | stylesheet_tag }}
{{ 'section-video.css' | asset_url | stylesheet_tag }}

{% assign background_section_rgb = section.settings['section-color-overlay'] | color_to_rgb %}
{% assign heading_rgb = section.settings['section-color-body-text'] | color_to_rgb %}

{% assign background_rgb = section.settings['color-overlay'] | color_to_rgb %}
{% assign text_rgb = section.settings['color-body-text'] | color_to_rgb %}

<style>
    section[id="shopify-section-{{ section.id }}"].iwtg-section {
        {% if background_section_rgb != 'rgba(0, 0, 0, 0.0)' %}
            --color-overlay-rgb: {{ section.settings.section-color-overlay | color_to_rgb | remove: 'rgb(' | remove: ')' }};
            --color-overlay-opacity: {{ section.settings.section-color-overlay-opacity | divided_by: 100.0 }};
        {% endif %}

        --iwtg-guarantee-bg: {{ section.settings.guarantee_background | default: '#ffffff' }};
        --iwtg-guarantee-border: {{ section.settings.guarantee_border_color | default: '#f5a623' }};
        --iwtg-guarantee-accent: {{ section.settings.guarantee_accent_color | default: '#f5a623' }};
        --iwtg-guarantee-heading: {{ section.settings.guarantee_heading_color | default: '#0a2e36' }};
        --iwtg-guarantee-text: {{ section.settings.guarantee_text_color | default: '#0a2e36' }};
        --iwtg-guarantee-divider: {{ section.settings.guarantee_divider_color | default: '#e8e8e8' }};
        --iwtg-guarantee-radius-mobile: {{ section.settings.guarantee_radius_mobile | default: 12 }}px;
        --iwtg-guarantee-radius-desktop: {{ section.settings.guarantee_radius_desktop | default: 16 }}px;
        --iwtg-guarantee-overlap-space-mobile: {{ section.settings.guarantee_overlap_space_mobile }}px;
        --iwtg-guarantee-overlap-space: {{ section.settings.guarantee_overlap_space | default: 56 }}px;
        --iwtg-guarantee-icon-bg: {{ section.settings.guarantee_icon_background | default: '#f4f4f4' }};
        --iwtg-guarantee-icon-color: {{ section.settings.guarantee_icon_color | default: '#0a2e36' }};
        --iwtg-guarantee-icon-size-mobile: {{ section.settings.guarantee_icon_width_mobile | default: 32 }}px;
        --iwtg-guarantee-icon-size-desktop: {{ section.settings.guarantee_icon_width_desktop | default: 36 }}px;
        --iwtg-guarantee-icon-box-mobile: {{ section.settings.guarantee_icon_box_size_mobile | default: 48 }}px;
        --iwtg-guarantee-icon-box-desktop: {{ section.settings.guarantee_icon_box_size_desktop | default: 52 }}px;
        --iwtg-content-padding-bottom-mobile: {{ section.settings.content_bottom_padding_mobile | default: 0 }}px;
        --iwtg-content-padding-bottom-desktop: {{ section.settings.content_bottom_padding_desktop | default: 0 }}px;
        --iwtg-guarantee-heading-large-size: {{ section.settings.guarantee_heading_large_size | default: 48 }}px;
        --iwtg-guarantee-heading-large-size-mobile: {{ section.settings.guarantee_heading_large_size_mobile | default: 36 }}px;
        --iwtg-guarantee-heading-small-size: {{ section.settings.guarantee_heading_small_size | default: 22 }}px;
        --iwtg-guarantee-heading-small-size-mobile: {{ section.settings.guarantee_heading_small_size_mobile | default: 18 }}px;
    }

    section[id="shopify-section-{{ section.id }}"] .headline__title{
      {% if heading_rgb != 'rgba(0, 0, 0, 0.0)' %}
        --color-custom-text: {{ section.settings.section-color-body-text }};
      {% endif %}
    }
  [data-section-id="{{ section.id }}"]
  {
      {% if background_rgb != 'rgba(0, 0, 0, 0.0)' %}
        --color-overlay-rgb: {{ section.settings.color-overlay | color_to_rgb | remove: 'rgb(' | remove: ')' }};
        --color-overlay-opacity: {{ section.settings.color-overlay-opacity | divided_by: 100.0 }};
      {% else %}
        .hero__pic-container,
        .wt-video__movie {
          border-radius: var(--border-radius);
          overflow: hidden;
        }
      {% endif %}

      {% if section.settings.full-width-enabled %}
        --border-radius: 0;
      {% endif %}

      {% if section.settings.margin-top %}
        --section-gap-top: {{ section.settings.margin-top }}px;
      {% endif %}

      {% if section.settings.margin-bottom %}
        --section-gap-bottom: {{ section.settings.margin-bottom }}px;
      {% endif %}

      --desktop-percentage-image-width: {{ section.settings.desktop-percentage-image-width }}%;

    {% if section.settings.slide_height == 'fixed_height' %}
    --section-height: {{ section.settings.mobile_fixed_height }}px;
    --section-height-desk: {{ section.settings.desktop_fixed_height }}px;
    {% endif %}

    {% if section.settings.slide_height == 'adapt_to_first_image' %}
        --first-slide-ratio: {{ section.blocks.first.settings.mobile_image.aspect_ratio | default: 1 }};
        --first-slide-ratio-desk: {{ section.blocks.first.settings.desktop_image.aspect_ratio | default: 2.5 }};
    {% endif %}

  }

  [data-section-id="{{ section.id }}"] .hero
    {
        {% if text_rgb != 'rgba(0, 0, 0, 0.0)' %}
          --color-custom-text: {{ section.settings.color-body-text }};
        {% endif %}
    }

  {%- for block in section.blocks -%}
  [data-block-id="{{ block.id }}"]
  {

        --font-headline-scale-desk: {{ block.settings.size_heading | divided_by: 100.0 }};
        --font-headline-scale: {{ block.settings.size_heading_mobile | divided_by: 100.0 }};

        {% if block.type == 'countdown_timer' %}
        --font-timer-scale-desk: {{ block.settings.scale_timer | divided_by: 100.0 }};
        --font-timer-scale: {{ block.settings.scale_timer_mobile | divided_by: 100.0 }};
        --font-timer: {% if block.settings.timer_style == 'headline' %}var(--font-headline){% endif %}
        {% endif %}

        {% if block.type == 'text' and block.settings.text_style == 'subtitle' %}
            --font-base: var(--font-headline);
        {% endif %}

        {% if block.type == 'icon_with_text' %}
          --icon-height-desktop: {{ block.settings.icon_height_desktop }}px;
          --icon-height: {{ block.settings.icon_height }}px;
          --icon-margin-desktop: {{ block.settings.icon_margin_desktop }}px;
          --icon-margin: {{ block.settings.icon_margin }}px;
          --size-heading-desktop: {{ block.settings.size_heading | divided_by: 100.0 }};
          --size-heading: {{ block.settings.size_heading_mobile | divided_by: 100.0 }};
          --gap: {{ block.settings.gap }}px;
          --margin-top: {{ block.settings.margin_top }}px;
          --margin-bottom: {{ block.settings.margin_bottom }}px;
          --margin-left: {{ block.settings.margin_left }}px;
          --margin-left-desktop: {{ block.settings.margin_left_desktop }}px;
        {% endif %}

        {% if block.type == 'table' %}
          --color-background-odd: {{ block.settings.color-background-odd }};
          --color-text-odd: {{ block.settings.color-text-odd | color_to_rgb | remove: 'rgb(' | remove: ')' }};
          --left-column-opacity: {{ block.settings.color-text-left-opacity | divided_by: 100.0 }};

          --mobile-layout: {{ block.settings.mobile_layout }};
          --table-border-radius: {{ settings.radius }}px;
        {% endif %}

        {% if block.type == 'subheading' %}
          --iwtg-subheading-color: {{ block.settings.subheading_color | default: '#f5a623' }};
          --iwtg-subheading-size: {{ block.settings.subheading_size | default: 12 }}px;
          --iwtg-subheading-size-mobile: {{ block.settings.subheading_size_mobile | default: 11 }}px;
        {% endif %}

        {% if block.type == 'button' %}
          --iwtg-btn-bg: {{ block.settings.button_background | default: '#f5a623' }};
          --iwtg-btn-text: {{ block.settings.button_text_color | default: '#000000' }};
          --iwtg-btn-border: {{ block.settings.button_border_color | default: 'transparent' }};
        {% endif %}
  }
  {%- endfor -%}

  /* Image with text + guarantee bar — self-contained styles */
  section[id="shopify-section-{{ section.id }}"].iwtg-section .iwtg__main {
    padding-bottom: var(--iwtg-content-padding-bottom-mobile);
  }

  section[id="shopify-section-{{ section.id }}"].iwtg-section .iwtg__main .hero__overlay__content {
    display: flex;
    flex-direction: column;
    position: relative;
    z-index: 1;
    width: 100%;
  }

  section[id="shopify-section-{{ section.id }}"].iwtg-section .iwtg__main .hero__overlay__content > * {
    display: block;
    visibility: visible;
    opacity: 1;
  }

  section[id="shopify-section-{{ section.id }}"].iwtg-section .iwtg__main .hero__title,
  section[id="shopify-section-{{ section.id }}"].iwtg-section .iwtg__main .hero__text,
  section[id="shopify-section-{{ section.id }}"].iwtg-section .iwtg__main .hero__subheading {
    visibility: visible;
    opacity: 1;
  }

  section[id="shopify-section-{{ section.id }}"].iwtg-section .iwtg__main .iwtg__heading,
  section[id="shopify-section-{{ section.id }}"].iwtg-section .iwtg__main .iwtg__text {
    color: var(--color-custom-text, inherit);
  }

  section[id="shopify-section-{{ section.id }}"].iwtg-section .iwtg__main [data-block-id].iwtg__subheading {
    color: var(--iwtg-subheading-color, var(--color-custom-text, inherit));
    font-size: var(--iwtg-subheading-size-mobile);
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  section[id="shopify-section-{{ section.id }}"].iwtg-section .iwtg__main [data-block-id].iwtg__subheading p,
  section[id="shopify-section-{{ section.id }}"].iwtg-section .iwtg__main [data-block-id].iwtg__subheading a {
    color: inherit;
    font-size: inherit;
  }

  section[id="shopify-section-{{ section.id }}"].iwtg-section .iwtg__main [data-block-id].iwtg__button {
    background-color: var(--iwtg-btn-bg, var(--color-button-primary-background, #f5a623));
    color: var(--iwtg-btn-text, var(--color-button-primary-text, #000));
    border-color: var(--iwtg-btn-border, transparent);
  }

  section[id="shopify-section-{{ section.id }}"].iwtg-section .iwtg__main [data-block-id].iwtg__button.hero__button--link {
    background-color: transparent;
    border-color: transparent;
    color: var(--iwtg-btn-text, var(--color-custom-text, inherit));
  }

  @media (hover: hover) {
    section[id="shopify-section-{{ section.id }}"].iwtg-section .iwtg__main [data-block-id].iwtg__button:hover {
      background-color: var(--iwtg-btn-bg, var(--color-button-primary-background-hover, #f5a623));
      color: var(--iwtg-btn-text, var(--color-button-primary-text-hover, #000));
      border-color: var(--iwtg-btn-border, transparent);
    }

    section[id="shopify-section-{{ section.id }}"].iwtg-section .iwtg__main [data-block-id].iwtg__button.hero__button--link:hover {
      background-color: transparent;
      border-color: transparent;
      color: var(--iwtg-btn-text, var(--color-custom-text, inherit));
    }
  }

  section[id="shopify-section-{{ section.id }}"].iwtg-section .iwtg__main [data-block-id].iwtg__button--bold,
  section[id="shopify-section-{{ section.id }}"].iwtg-section .iwtg__main [data-block-id].iwtg__button--bold span {
    font-weight: 700;
  }

  section[id="shopify-section-{{ section.id }}"].iwtg-section .iwtg--has-guarantee {
    position: relative;
    margin-bottom: var(--iwtg-guarantee-overlap-space);
  }

  section[id="shopify-section-{{ section.id }}"].iwtg-section .iwtg__guarantee {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    transform: translateY(50%);
    width: 100%;
    max-width: var(--site-max-width-big, var(--site-max-width));
    margin: 0 auto;
    padding: 0 calc(var(--gap, 8px) * 2);
    box-sizing: border-box;
    z-index: 2;
  }

  section[id="shopify-section-{{ section.id }}"].iwtg-section .iwtg__guarantee-inner {
    display: flex;
    flex-direction: column;
    background: var(--iwtg-guarantee-bg);
    border: 1px solid var(--iwtg-guarantee-border);
    border-radius: var(--iwtg-guarantee-radius-mobile);
    overflow: hidden;
  }

  section[id="shopify-section-{{ section.id }}"].iwtg-section .iwtg__guarantee-head {
    position: relative;
    padding: calc(var(--gap, 8px) * 3);
    border-bottom: 1px solid var(--iwtg-guarantee-divider);
  }

  section[id="shopify-section-{{ section.id }}"].iwtg-section .iwtg__guarantee-kicker {
    margin: 0 0 calc(var(--gap, 8px) * 1);
    font-style: var(--font-base-style);
    font-weight: var(--font-base-weight);
    font-size: calc(var(--font-base-size) * 0.75);
    line-height: 1.2;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--iwtg-guarantee-accent);
  }

  section[id="shopify-section-{{ section.id }}"].iwtg-section .iwtg__guarantee-kicker p {
    margin: 0;
  }

  section[id="shopify-section-{{ section.id }}"].iwtg-section .iwtg__guarantee-title-large {
    margin: 0;
    font-style: var(--font-headline-style);
    font-weight: var(--font-headline-weight);
    font-size: var(--iwtg-guarantee-heading-large-size-mobile);
    line-height: 0.95;
    letter-spacing: var(--font-headline-letter-spacing, normal);
    text-transform: var(--font-headline-transform, none);
    color: var(--iwtg-guarantee-heading);
  }

  section[id="shopify-section-{{ section.id }}"].iwtg-section .iwtg__guarantee-title-small {
    margin: 0;
    font-style: var(--font-headline-style);
    font-weight: var(--font-headline-weight);
    font-size: var(--iwtg-guarantee-heading-small-size-mobile);
    line-height: 1.1;
    letter-spacing: var(--font-headline-letter-spacing, normal);
    text-transform: var(--font-headline-transform, none);
    color: var(--iwtg-guarantee-heading);
  }

  section[id="shopify-section-{{ section.id }}"].iwtg-section .iwtg__guarantee-items {
    display: flex;
    flex-direction: column;
  }

  section[id="shopify-section-{{ section.id }}"].iwtg-section .iwtg__guarantee-item {
    display: flex;
    align-items: center;
    gap: calc(var(--gap, 8px) * 2);
    padding: calc(var(--gap, 8px) * 2.5) calc(var(--gap, 8px) * 3);
    border-bottom: 1px solid var(--iwtg-guarantee-divider);
  }

  section[id="shopify-section-{{ section.id }}"].iwtg-section .iwtg__guarantee-item:last-child {
    border-bottom: none;
  }

  section[id="shopify-section-{{ section.id }}"].iwtg-section .iwtg__guarantee-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    width: var(--iwtg-guarantee-icon-box-mobile);
    height: var(--iwtg-guarantee-icon-box-mobile);
    border-radius: 50%;
    background: var(--iwtg-item-icon-bg, var(--iwtg-guarantee-icon-bg));
    color: var(--iwtg-item-icon-color, var(--iwtg-guarantee-icon-color));
  }

  section[id="shopify-section-{{ section.id }}"].iwtg-section .iwtg__guarantee-icon img,
  section[id="shopify-section-{{ section.id }}"].iwtg-section .iwtg__guarantee-icon svg {
    width: var(--iwtg-item-icon-size, var(--iwtg-guarantee-icon-size-mobile));
    height: var(--iwtg-item-icon-size, var(--iwtg-guarantee-icon-size-mobile));
    object-fit: contain;
    display: block;
  }

  section[id="shopify-section-{{ section.id }}"].iwtg-section .iwtg__guarantee-text {
    margin: 0;
    font-style: var(--font-base-style);
    font-weight: var(--font-base-weight);
    font-size: var(--font-base-size);
    color: var(--iwtg-guarantee-text);
  }
  p.iwtg__guarantee-title-large {
    font-weight: bold !important;
  }

  @media (min-width: 900px) {
    section[id="shopify-section-{{ section.id }}"].iwtg-section .iwtg__main {
      padding-bottom: var(--iwtg-content-padding-bottom-desktop);
    }

    section[id="shopify-section-{{ section.id }}"].iwtg-section .iwtg__main [data-block-id].iwtg__subheading {
      font-size: var(--iwtg-subheading-size);
    }

    section[id="shopify-section-{{ section.id }}"].iwtg-section .iwtg__guarantee {
      padding: 0 calc(calc(var(--gap, 8px) * 2) + calc(var(--gap, 8px) * 2));
    }

    section[id="shopify-section-{{ section.id }}"].iwtg-section .iwtg__guarantee-inner {
      flex-direction: row;
      align-items: stretch;
      border-radius: var(--iwtg-guarantee-radius-desktop);
      padding: 0 50px;
      box-shadow: 0 0px 7px 1px rgb(0 0 0 / 39%);
    }

    section[id="shopify-section-{{ section.id }}"].iwtg-section .iwtg__guarantee-head {
      flex: 0 0 28%;
      max-width: 28%;
      display: flex;
      flex-direction: column;
      justify-content: center;
      border-bottom: none;
      padding: calc(var(--gap, 8px) * 4);
    }

    section[id="shopify-section-{{ section.id }}"].iwtg-section .iwtg__guarantee-head::after {
      content: "";
      position: absolute;
      top: 50%;
      right: 0;
      transform: translateY(-50%);
      width: 1px;
      height: 55%;
      background: var(--iwtg-guarantee-divider);
    }

    section[id="shopify-section-{{ section.id }}"].iwtg-section .iwtg__guarantee-title-large {
      font-size: var(--iwtg-guarantee-heading-large-size);
    }

    section[id="shopify-section-{{ section.id }}"].iwtg-section .iwtg__guarantee-title-small {
      font-size: var(--iwtg-guarantee-heading-small-size);
    }

    section[id="shopify-section-{{ section.id }}"].iwtg-section .iwtg__guarantee-items {
      flex: 1;
      flex-direction: row;
      align-items: stretch;
    }

    section[id="shopify-section-{{ section.id }}"].iwtg-section .iwtg__guarantee-item {
      flex: 1;
      border-bottom: none;
      padding: calc(var(--gap, 8px) * 3);
    }

    section[id="shopify-section-{{ section.id }}"].iwtg-section .iwtg__guarantee-icon {
      width: var(--iwtg-guarantee-icon-box-desktop);
      height: var(--iwtg-guarantee-icon-box-desktop);
    }

    section[id="shopify-section-{{ section.id }}"].iwtg-section .iwtg__guarantee-icon img,
    section[id="shopify-section-{{ section.id }}"].iwtg-section .iwtg__guarantee-icon svg {
      width: var(--iwtg-item-icon-size, var(--iwtg-guarantee-icon-size-desktop));
      height: var(--iwtg-item-icon-size, var(--iwtg-guarantee-icon-size-desktop));
    }
  }
  @media (max-width: 749px) {
    section[id="shopify-section-{{ section.id }}"].iwtg-section .iwtg__guarantee-inner {
      padding: 20px 30px;
    }
    section[id="shopify-section-{{ section.id }}"].iwtg-section .iwtg__guarantee-head {
      padding-left: 0;
      padding-right: 0;
      padding-top: 0;
    }
    section[id="shopify-section-{{ section.id }}"].iwtg-section .iwtg__guarantee-item {
      padding-left: 0;
      padding-right: 0;
      padding-top: 10px;
      padding-bottom: 10px;
      border: 0;
    }
    section[id="shopify-section-{{ section.id }}"].iwtg-section .iwtg__guarantee-text {
      font-size: 14px;
    }
    section[id="shopify-section-{{ section.id }}"].iwtg-section .iwtg--has-guarantee {
      margin-bottom: var(--iwtg-guarantee-overlap-space-mobile);
    }
  }
</style>

{% if section.settings.layout == 'text_first' %}
  {% assign customclass = 'hero--grid hero--grid--rev' %}
{% else %}
  {% assign customclass = 'hero--grid' %}
{% endif %}

{% if section.settings['full-width-enabled'] %}
  {% assign customwrapperclass = 'hero__wrapper--full' %}
{% else %}
  {% assign customwrapperclass = 'hero__wrapper' %}
{% endif %}

<div
  data-section-id="{{ section.id }}"
  data-height="{{ section.settings.slide_height }}"
  class="iwtg {% if section.settings.show_guarantee_bar %}iwtg--has-guarantee{% endif %} {{ customwrapperclass }}  {% if settings.animations %} scroll-trigger animate--slide-in {% endif %} {% if settings.disabled_animations_on_mobile %} disabled-on-mobile {% endif %}"
>
  {% if section.settings.advanced_heading %}
    {% if section.settings.heading_richtext != blank %}
        <div class="headline headline--rich {% if settings.animations %} scroll-trigger animate--slide-in {% endif %} {% if settings.disabled_animations_on_mobile %} disabled-on-mobile {% endif %}">
            {{ section.settings.heading_richtext }}
        </div>
    {% endif %}
  {% else %}
    {% if section.settings.title != blank %}
        {% render 'headline', title: section.settings.title %}
    {% endif %}
  {% endif %}
  <div class="iwtg__main {% if settings.animations %} scroll-trigger animate--slide-in {% endif %} {% if settings.disabled_animations_on_mobile %} disabled-on-mobile {% endif %}">
    {% render 'hero',
      type: 'blocks',
      classname: customclass,
      desktop_text_horizontal_position: section.settings.desktop_text_horizontal_position,
      desktop_text_vertical_position: section.settings.desktop_text_vertical_position,
      mobile_text_horizontal_position: section.settings.mobile_text_horizontal_position,
      mobile_text_vertical_position: section.settings.mobile_text_vertical_position,
      desktop_image: section.settings.desktop_image,
      mobile_image: section.settings.mobile_image,
      placeholder: 'detailed-apparel-1',
      blocks: section.blocks,
      use_iwtg_blocks: true,
      link_only_on_button: true,
      video: section.settings.video_hosted,
      mobile_video: section.settings.video_hosted_mobile,
    %}
  </div>

  {%- if section.settings.show_guarantee_bar -%}
    <div class="iwtg__guarantee">
      <div class="iwtg__guarantee-inner">
        <div class="iwtg__guarantee-head">
          {%- if section.settings.guarantee_kicker != blank -%}
            <div class="iwtg__guarantee-kicker rte">{{ section.settings.guarantee_kicker }}</div>
          {%- endif -%}
          {%- if section.settings.guarantee_heading_large != blank -%}
            <p class="iwtg__guarantee-title-large">{{ section.settings.guarantee_heading_large }}</p>
          {%- endif -%}
          {%- if section.settings.guarantee_heading_small != blank -%}
            <p class="iwtg__guarantee-title-small">{{ section.settings.guarantee_heading_small }}</p>
          {%- endif -%}
        </div>

        <div class="iwtg__guarantee-items">
          {%- for i in (1..3) -%}
            {%- liquid
              case i
                when 1
                  assign item_icon_type = section.settings.guarantee_item_1_icon_type
                  assign item_icon = section.settings.guarantee_item_1_icon
                  assign item_svg = section.settings.guarantee_item_1_svg
                  assign item_text = section.settings.guarantee_item_1_text
                  assign item_icon_bg = section.settings.guarantee_item_1_icon_bg
                  assign item_icon_color = section.settings.guarantee_item_1_icon_color
                  assign item_icon_width = section.settings.guarantee_item_1_icon_width
                when 2
                  assign item_icon_type = section.settings.guarantee_item_2_icon_type
                  assign item_icon = section.settings.guarantee_item_2_icon
                  assign item_svg = section.settings.guarantee_item_2_svg
                  assign item_text = section.settings.guarantee_item_2_text
                  assign item_icon_bg = section.settings.guarantee_item_2_icon_bg
                  assign item_icon_color = section.settings.guarantee_item_2_icon_color
                  assign item_icon_width = section.settings.guarantee_item_2_icon_width
                when 3
                  assign item_icon_type = section.settings.guarantee_item_3_icon_type
                  assign item_icon = section.settings.guarantee_item_3_icon
                  assign item_svg = section.settings.guarantee_item_3_svg
                  assign item_text = section.settings.guarantee_item_3_text
                  assign item_icon_bg = section.settings.guarantee_item_3_icon_bg
                  assign item_icon_color = section.settings.guarantee_item_3_icon_color
                  assign item_icon_width = section.settings.guarantee_item_3_icon_width
              endcase

              assign item_style = ''
              if item_icon_bg != blank and item_icon_bg != 'rgba(0,0,0,0)'
                assign item_style = item_style | append: '--iwtg-item-icon-bg:' | append: item_icon_bg | append: ';'
              endif
              if item_icon_color != blank and item_icon_color != 'rgba(0,0,0,0)'
                assign item_style = item_style | append: '--iwtg-item-icon-color:' | append: item_icon_color | append: ';'
              endif
              if item_icon_width != blank and item_icon_width > 0
                assign item_style = item_style | append: '--iwtg-item-icon-size:' | append: item_icon_width | append: 'px;'
              endif
            -%}
            {%- if item_text != blank -%}
              <div class="iwtg__guarantee-item"{% if item_style != blank %} style="{{ item_style }}"{% endif %}>
                <span class="iwtg__guarantee-icon" aria-hidden="true">
                  {%- if item_icon != blank -%}
                    {{
                      item_icon
                      | image_url: width: 128
                      | image_tag: loading: 'lazy', widths: '32, 64, 128', alt: ''
                    }}
                  {%- elsif item_icon_type == 'svg' and item_svg != blank -%}
                    {{ item_svg }}
                  {%- elsif item_icon_type == 'calendar' -%}
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><rect x="3" y="4" width="18" height="18" rx="2"/><path d="M16 2v4M8 2v4M3 10h18"/></svg>
                  {%- elsif item_icon_type == 'refresh' -%}
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M21 12a9 9 0 1 1-2.64-6.36"/><path d="M21 3v6h-6"/></svg>
                  {%- elsif item_icon_type == 'shield' -%}
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><path d="m9 12 2 2 4-4"/></svg>
                  {%- endif -%}
                </span>
                <p class="iwtg__guarantee-text">{{ item_text }}</p>
              </div>
            {%- endif -%}
          {%- endfor -%}
        </div>
      </div>
    </div>
  {%- endif -%}
</div>

