{% style %}
  {%- liquid
    assign sw_heading_lh = section.settings.heading_line_height | default: 97
    assign sw_text_lh = section.settings.text_line_height | default: 100
    assign sw_ftitle_lh = section.settings.feature_title_line_height | default: 100
    assign sw_ftext_lh = section.settings.feature_line_height | default: 100

    if sw_heading_lh < 80
      assign sw_heading_lh = 97
    endif
    if sw_text_lh < 100
      assign sw_text_lh = 100
    endif
    if sw_ftitle_lh < 100
      assign sw_ftitle_lh = 100
    endif
    if sw_ftext_lh < 100
      assign sw_ftext_lh = 100
    endif
  -%}

  #shopify-section-{{ section.id }} .science-within {
    --sw-section-bg: {{ section.settings.section_background }};
    --sw-content-bg: {{ section.settings.content_background }};
    --sw-media-bg: {{ section.settings.media_background }};
    --sw-eyebrow-color: {{ section.settings.eyebrow_color }};
    --sw-heading-color: {{ section.settings.heading_color }};
    --sw-text-color: {{ section.settings.text_color }};
    --sw-feature-title-color: {{ section.settings.feature_title_color }};
    --sw-feature-text-color: {{ section.settings.feature_text_color }};
    --sw-divider-color: {{ section.settings.divider_color }};
    --sw-icon-border-color: {{ section.settings.icon_border_color }};
    --sw-caption-color: {{ section.settings.caption_color }};
    --sw-overlay-color: {{ section.settings.image_overlay_color }};
    --sw-overlay-opacity: {{ section.settings.image_overlay_opacity | divided_by: 100.0 }};
    --sw-border-radius: {{ section.settings.container_radius }}px;
    --sw-content-width: {{ section.settings.content_column_width }}%;
    --sw-eyebrow-size: {{ section.settings.eyebrow_size }}px;
    --sw-eyebrow-size-mobile: {{ section.settings.eyebrow_size_mobile }}px;
    --sw-heading-size: {{ section.settings.heading_size }}px;
    --sw-heading-size-mobile: {{ section.settings.heading_size_mobile }}px;
    --sw-text-size: {{ section.settings.text_size }}px;
    --sw-text-size-mobile: {{ section.settings.text_size_mobile }}px;
    --sw-feature-title-size: {{ section.settings.feature_title_size }}px;
    --sw-feature-title-size-mobile: {{ section.settings.feature_title_size_mobile }}px;
    --sw-feature-text-size: {{ section.settings.feature_text_size }}px;
    --sw-feature-text-size-mobile: {{ section.settings.feature_text_size_mobile }}px;
    --sw-caption-size: {{ section.settings.caption_size }}px;
    --sw-icon-size: {{ section.settings.icon_size }}px;
    --sw-image-zoom: {{ section.settings.image_hover_scale | divided_by: 100.0 }};
    --sw-content-padding-x: {{ section.settings.content_padding_horizontal }}px;
    --sw-content-padding-y: {{ section.settings.content_padding_vertical }}px;
    --sw-content-padding-x-mobile: {{ section.settings.content_padding_horizontal_mobile }}px;
    --sw-content-padding-y-mobile: {{ section.settings.content_padding_vertical_mobile }}px;
    --sw-features-gap: {{ section.settings.features_gap }}px;
    --sw-features-gap-mobile: {{ section.settings.features_gap_mobile }}px;
    --sw-features-top-spacing: {{ section.settings.features_top_spacing }}px;
    --sw-features-grid-padding-top: {{ section.settings.features_grid_padding_top }}px;
    --sw-max-height-desktop: {{ section.settings.section_max_height_desktop }}px;
    --sw-media-height-mobile: {{ section.settings.media_height_mobile }}px;
    --sw-heading-max-width: {{ section.settings.heading_max_width }}px;
    --sw-description-max-width: {{ section.settings.description_max_width }}px;
    --sw-heading-tracking: {{ section.settings.heading_letter_spacing | divided_by: 100.0 }}em;
    --sw-eyebrow-tracking: {{ section.settings.eyebrow_letter_spacing | divided_by: 100.0 }}em;
    --sw-caption-tracking: {{ section.settings.caption_letter_spacing | divided_by: 100.0 }}em;
    background-color: var(--sw-section-bg);
  }

  #shopify-section-{{ section.id }} .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top_mobile }}px !important;
    padding-bottom: {{ section.settings.padding_bottom_mobile }}px !important;
  }

  @media screen and (min-width: 990px) {
    #shopify-section-{{ section.id }} .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top_desktop }}px !important;
      padding-bottom: {{ section.settings.padding_bottom_desktop }}px !important;
    }
  }

  #shopify-section-{{ section.id }} .science-within__shell {
    max-width: 100%;
    margin: 0 auto;
    overflow: hidden;
    border-radius: var(--sw-border-radius);
  }

  #shopify-section-{{ section.id }} .science-within__grid {
    display: grid;
    grid-template-columns: 1fr;
  }

  #shopify-section-{{ section.id }} .science-within__content {
    background-color: var(--sw-content-bg);
    padding: var(--sw-content-padding-y-mobile) var(--sw-content-padding-x-mobile);
  }

  #shopify-section-{{ section.id }} .science-within__eyebrow {
    margin: 0 0 19px !important;
    padding: 0 !important;
    color: var(--sw-eyebrow-color) !important;
    font-family: 'Libre Franklin', var(--font-body), sans-serif !important;
    font-size: var(--sw-eyebrow-size-mobile) !important;
    font-weight: 600 !important;
    letter-spacing: var(--sw-eyebrow-tracking) !important;
    line-height: 1.2 !important;
    text-transform: uppercase !important;
  }

  #shopify-section-{{ section.id }} .science-within__heading,
  #shopify-section-{{ section.id }} h2.science-within__heading {
    margin: 0 !important;
    padding: 0 !important;
    max-width: var(--sw-heading-max-width) !important;
    color: var(--sw-heading-color) !important;
    font-family: 'DM Sans', var(--font-headline), sans-serif !important;
    font-size: var(--sw-heading-size-mobile) !important;
    font-weight: 500 !important;
    letter-spacing: var(--sw-heading-tracking) !important;
    line-height: {{ sw_heading_lh }}% !important;
    text-transform: none !important;
  }

  #shopify-section-{{ section.id }} .science-within__description,
  #shopify-section-{{ section.id }} .science-within__description.rte {
    margin: 23px 0 0 !important;
    max-width: var(--sw-description-max-width) !important;
    color: var(--sw-text-color) !important;
    font-family: 'Libre Franklin', var(--font-body), sans-serif !important;
    font-size: var(--sw-text-size-mobile) !important;
    font-weight: 400 !important;
    line-height: {{ sw_text_lh }}% !important;
  }

  #shopify-section-{{ section.id }} .science-within__description p,
  #shopify-section-{{ section.id }} .science-within__description.rte p {
    margin: 0 !important;
    padding: 0 !important;
    color: var(--sw-text-color) !important;
    font-family: 'Libre Franklin', var(--font-body), sans-serif !important;
    font-size: var(--sw-text-size-mobile) !important;
    font-weight: 400 !important;
    line-height: {{ sw_text_lh }}% !important;
  }

  #shopify-section-{{ section.id }} .science-within__features {
    margin-top: var(--sw-features-top-spacing);
    border-top: 1px solid var(--sw-divider-color);
  }

  #shopify-section-{{ section.id }} .science-within__features-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: var(--sw-features-gap-mobile);
    padding-top: var(--sw-features-grid-padding-top);
  }

  #shopify-section-{{ section.id }} .science-within__feature {
    min-width: 0;
    justify-items: center;
    text-align: center;
  }

  #shopify-section-{{ section.id }} .science-within__feature-icon {
    width: var(--sw-icon-size);
    height: var(--sw-icon-size);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--sw-heading-color);
  }

  #shopify-section-{{ section.id }} .science-within__feature-icon-img {
    width: var(--sw-icon-size);
    height: var(--sw-icon-size);
    object-fit: contain;
    display: block;
    /* filter: brightness(0) saturate(100%) invert(100%) sepia(100%) saturate(22%) hue-rotate(205deg) brightness(104%) contrast(101%); */
  }

  #shopify-section-{{ section.id }} .science-within__feature-icon-svg {
    width: 50%;
    height: 50%;
    display: block;
  }

  #shopify-section-{{ section.id }} .science-within__feature-title,
  #shopify-section-{{ section.id }} h3.science-within__feature-title {
    margin: 16px 0 0 !important;
    padding: 0 !important;
    color: var(--sw-feature-title-color) !important;
    font-family: 'Libre Franklin', var(--font-body), sans-serif !important;
    font-size: var(--sw-feature-title-size-mobile) !important;
    font-weight: 600 !important;
    line-height: {{ sw_ftitle_lh }}% !important;
    text-transform: none !important;
  }

  #shopify-section-{{ section.id }} .science-within__feature-text,
  #shopify-section-{{ section.id }} .science-within__feature-text.rte {
    margin: 10px 0 0 !important;
    color: var(--sw-feature-text-color) !important;
    font-family: 'Libre Franklin', var(--font-body), sans-serif !important;
    font-size: var(--sw-feature-text-size-mobile) !important;
    font-weight: 400 !important;
    line-height: {{ sw_ftext_lh }}% !important;
  }

  #shopify-section-{{ section.id }} .science-within__feature-text p,
  #shopify-section-{{ section.id }} .science-within__feature-text.rte p {
    margin: 0 !important;
    padding: 0 !important;
    color: var(--sw-feature-text-color) !important;
    font-family: 'Libre Franklin', var(--font-body), sans-serif !important;
    font-size: var(--sw-feature-text-size-mobile) !important;
    font-weight: 400 !important;
    line-height: {{ sw_ftext_lh }}% !important;
  }

  #shopify-section-{{ section.id }} .science-within__media {
    background-color: var(--sw-media-bg);
    height: var(--sw-media-height-mobile);
    min-height: var(--sw-media-height-mobile);
    position: relative;
    overflow: hidden;
  }

  #shopify-section-{{ section.id }} .science-within__media-inner {
    position: relative;
    width: 100%;
    height: 100%;
    min-height: inherit;
  }

  #shopify-section-{{ section.id }} .science-within__media-inner--contain {
    display: flex;
    align-items: center;
    justify-content: center;
  }

  #shopify-section-{{ section.id }} .science-within__media-inner--cover {
    min-height: inherit;
  }

  #shopify-section-{{ section.id }} .science-within__image-wrap {
    position: relative;
    overflow: hidden;
    width: 100%;
    height: 100%;
    flex: 1;
  }

  #shopify-section-{{ section.id }} .science-within__media-inner--contain .science-within__image-wrap {
    display: flex;
    align-items: center;
    justify-content: center;
  }

  #shopify-section-{{ section.id }} .science-within__media-inner--cover .science-within__image-wrap {
    position: absolute;
    inset: 0;
  }

  #shopify-section-{{ section.id }} .science-within__image-wrap--placeholder {
    display: flex;
    align-items: center;
    justify-content: center;
    background-color: rgba(255, 255, 255, 0.06);
    min-height: var(--sw-media-height-mobile);
  }

  #shopify-section-{{ section.id }} .science-within__placeholder {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  #shopify-section-{{ section.id }} .science-within__image {
    width: 100%;
    height: 100%;
    display: block;
    transition: transform 0.7s ease;
  }

  #shopify-section-{{ section.id }} .science-within__media-inner--contain .science-within__image {
    width: 100%;
    height: 100%;
    object-fit: contain;
    object-position: center;
  }

  #shopify-section-{{ section.id }} .science-within__media-inner--cover .science-within__image {
    object-fit: cover;
  }

  #shopify-section-{{ section.id }} .science-within__image-wrap:hover .science-within__image {
    transform: scale(var(--sw-image-zoom));
  }

  #shopify-section-{{ section.id }} .science-within__image-overlay {
    position: absolute;
    inset: 0;
    background-color: var(--sw-overlay-color);
    opacity: var(--sw-overlay-opacity);
    pointer-events: none;
  }

  #shopify-section-{{ section.id }} .science-within__caption {
    position: absolute;
    left: 28px;
    bottom: 28px;
    margin: 0 !important;
    padding: 0 !important;
    color: var(--sw-caption-color) !important;
    font-family: 'Libre Franklin', var(--font-body), sans-serif !important;
    font-size: var(--sw-caption-size) !important;
    font-weight: 400 !important;
    letter-spacing: var(--sw-caption-tracking) !important;
    line-height: 1.2 !important;
    text-transform: uppercase !important;
    z-index: 1;
  }

  @media screen and (max-width: 420px) {
    #shopify-section-{{ section.id }} .science-within__features-grid {
      /* grid-template-columns: 1fr !important; */
    }

    #shopify-section-{{ section.id }} .science-within__feature {
      /* display: grid;
      grid-template-columns: auto 1fr;
      grid-template-rows: auto auto;
      column-gap: 14px;
      align-items: start; */
    }

    #shopify-section-{{ section.id }} .science-within__feature-icon {
      grid-row: 1 / 3;
      align-self: start;
      margin-top: 2px;
    }

    #shopify-section-{{ section.id }} .science-within__feature-title,
    #shopify-section-{{ section.id }} h3.science-within__feature-title {
      grid-column: 2;
      grid-row: 1;
      margin-top: 10px !important;
      font-size: 10px !important;
      overflow-wrap: break-word;
    }

    #shopify-section-{{ section.id }} .science-within__feature-text,
    #shopify-section-{{ section.id }} .science-within__feature-text.rte {
      grid-column: 2;
      grid-row: 2;
      margin: 4px 0 0 !important;
    }

    #shopify-section-{{ section.id }} .science-within__feature-text p,
    #shopify-section-{{ section.id }} .science-within__feature-text.rte p {
      margin: 0 !important;
    }
  }

  @media screen and (min-width: 990px) {
    #shopify-section-{{ section.id }} .science-within__shell {
      max-height: var(--sw-max-height-desktop);
    }

    #shopify-section-{{ section.id }} .science-within__grid {
      grid-template-columns: var(--sw-content-width) calc(100% - var(--sw-content-width));
      height: var(--sw-max-height-desktop);
      max-height: var(--sw-max-height-desktop);
      min-height: 0;
    }

    #shopify-section-{{ section.id }} .science-within__content {
      display: flex;
      flex-direction: column;
      justify-content: center;
      overflow: hidden;
    }

    #shopify-section-{{ section.id }} .science-within__eyebrow {
      margin: 0 0 24px !important;
      font-size: var(--sw-eyebrow-size) !important;
    }

    #shopify-section-{{ section.id }} .science-within__heading,
    #shopify-section-{{ section.id }} h2.science-within__heading {
      font-size: var(--sw-heading-size) !important;
    }

    #shopify-section-{{ section.id }} .science-within__description,
    #shopify-section-{{ section.id }} .science-within__description.rte {
      margin: 28px 0 0 !important;
      font-size: var(--sw-text-size) !important;
    }

    #shopify-section-{{ section.id }} .science-within__description p,
    #shopify-section-{{ section.id }} .science-within__description.rte p {
      font-size: var(--sw-text-size) !important;
    }

    #shopify-section-{{ section.id }} .science-within__features-grid {
      gap: var(--sw-features-gap);
    }

    #shopify-section-{{ section.id }} .science-within__feature-title,
    #shopify-section-{{ section.id }} h3.science-within__feature-title {
      margin: 20px 0 0 !important;
      font-size: var(--sw-feature-title-size) !important;
    }

    #shopify-section-{{ section.id }} .science-within__feature-text,
    #shopify-section-{{ section.id }} .science-within__feature-text.rte {
      margin: 12px 0 0 !important;
      font-size: var(--sw-feature-text-size) !important;
    }

    #shopify-section-{{ section.id }} .science-within__feature-text p,
    #shopify-section-{{ section.id }} .science-within__feature-text.rte p {
      margin: 0 !important;
      font-size: var(--sw-feature-text-size) !important;
    }

    #shopify-section-{{ section.id }} .science-within__media {
      min-height: 0;
      height: 100%;
    }

    #shopify-section-{{ section.id }} .science-within__media-inner {
      min-height: 0;
      height: 100%;
    }

    #shopify-section-{{ section.id }} .science-within__image-wrap--placeholder {
      min-height: 0;
    }
  }
  @media screen and (min-width: 1439px) {
    #shopify-section-{{ section.id }} .science-within__content {
      padding: var(--sw-content-padding-y) var(--sw-content-padding-x);
    }
  }
  @media screen and (max-width: 749px) {
    #shopify-section-{{ section.id }} .science-within__features {
      margin-top: 30px;
    }
  }

{% endstyle %}

<link
  rel="stylesheet"
  href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@500&family=Libre+Franklin:wght@400;600&display=swap"
  media="print"
  onload="this.media='all'"
>

<div class="science-within section-{{ section.id }}-padding">
  <div class="science-within__shell">
    <div class="science-within__grid">
      <div class="science-within__content">
        {% if section.settings.eyebrow != blank %}
          <p class="science-within__eyebrow">{{ section.settings.eyebrow }}</p>
        {% endif %}

        {% if section.settings.heading != blank %}
          <h2 class="science-within__heading">{{ section.settings.heading }}</h2>
        {% endif %}

        {% if section.settings.description != blank %}
          <div class="science-within__description rte">{{ section.settings.description }}</div>
        {% endif %}

        {% if section.blocks.size > 0 %}
          <div class="science-within__features">
            <div class="science-within__features-grid">
              {% for block in section.blocks %}
                <div class="science-within__feature" {{ block.shopify_attributes }}>
                  <div class="science-within__feature-icon">
                    {% if block.settings.icon != blank %}
                      {%- assign icon_width = block.settings.icon.width | default: 64 -%}
                      {%- assign icon_height = block.settings.icon.height | default: 64 -%}
                      {{
                        block.settings.icon
                        | image_url: width: 64
                        | image_tag:
                          loading: 'lazy',
                          width: icon_width,
                          height: icon_height,
                          class: 'science-within__feature-icon-img',
                          alt: block.settings.title
                      }}
                    {% else %}
                      {% case block.settings.icon_style %}
                        {% when 'focus' %}
                          <svg
                            class="science-within__feature-icon-svg"
                            viewBox="0 0 24 24"
                            aria-hidden="true"
                            focusable="false"
                          >
                            <circle cx="12" cy="12" r="9" fill="none" stroke="currentColor" stroke-width="1.5"></circle>
                            <path d="M12 7v10" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"></path>
                          </svg>
                        {% when 'shield' %}
                          <svg
                            class="science-within__feature-icon-svg"
                            viewBox="0 0 24 24"
                            aria-hidden="true"
                            focusable="false"
                          >
                            <path d="M12 3l8 3v6c0 5-3.5 8.5-8 9-4.5-.5-8-4-8-9V6l8-3z" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"></path>
                          </svg>
                        {% else %}
                          <svg
                            class="science-within__feature-icon-svg"
                            viewBox="0 0 24 24"
                            aria-hidden="true"
                            focusable="false"
                          >
                            <path d="M13 3L5 14h6l-1 7 8-11h-6l1-7z" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round" stroke-linecap="round"></path>
                          </svg>
                      {% endcase %}
                    {% endif %}
                  </div>

                  {% if block.settings.title != blank %}
                    <h3 class="science-within__feature-title">{{ block.settings.title }}</h3>
                  {% endif %}

                  {% if block.settings.description != blank %}
                    <div class="science-within__feature-text rte">{{ block.settings.description }}</div>
                  {% endif %}
                </div>
              {% endfor %}
            </div>
          </div>
        {% endif %}
      </div>

      <div class="science-within__media">
        <div class="science-within__media-inner science-within__media-inner--{{ section.settings.image_layout }}">
          {% if section.settings.image != blank %}
            {%- assign media_width = 1600 -%}
            {%- assign media_height = section.settings.image.height
              | times: 1600
              | divided_by: section.settings.image.width
              | round
            -%}
            <div class="science-within__image-wrap">
              {{
                section.settings.image
                | image_url: width: 1600
                | image_tag:
                  loading: 'lazy',
                  width: media_width,
                  height: media_height,
                  class: 'science-within__image',
                  sizes: '(min-width: 990px) 52vw, 100vw',
                  widths: '375, 550, 750, 1100, 1500, 1600',
                  alt: section.settings.image_alt
              }}
              <span class="science-within__image-overlay" aria-hidden="true"></span>
            </div>
          {% else %}
            <div class="science-within__image-wrap science-within__image-wrap--placeholder">
              {{ 'detailed-apparel-1' | placeholder_svg_tag: 'science-within__placeholder' }}
            </div>
          {% endif %}

          {% if section.settings.caption != blank %}
            <p class="science-within__caption">{{ section.settings.caption }}</p>
          {% endif %}
        </div>
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Science Within",
  "tag": "section",
  "class": "section-science-within",
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "The science within"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "A better future starts at the cellular level."
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "Description",
      "default": "<p>Our formulas are built around the systems that shape how you feel every day: energy production, mental clarity, and long-term resilience.</p>"
    },
    {
      "type": "header",
      "content": "Image"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "text",
      "id": "image_alt",
      "label": "Image alt text",
      "default": "Microscopic view of plant cells"
    },
    {
      "type": "select",
      "id": "image_layout",
      "label": "Image layout",
      "options": [
        {
          "value": "contain",
          "label": "Natural image"
        },
        {
          "value": "cover",
          "label": "Full cover"
        }
      ],
      "default": "contain"
    },
    {
      "type": "text",
      "id": "caption",
      "label": "Image caption",
      "default": "Science / systems / cellular support"
    },
    {
      "type": "color",
      "id": "image_overlay_color",
      "label": "Image overlay color",
      "default": "#062b27"
    },
    {
      "type": "range",
      "id": "image_overlay_opacity",
      "label": "Image overlay opacity",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "%",
      "default": 20
    },
