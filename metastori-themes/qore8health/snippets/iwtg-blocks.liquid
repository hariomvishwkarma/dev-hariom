{% comment %}
  Custom blocks for image-with-text-guarantee section only.
{% endcomment %}

{%- for block in blocks -%}
  {%- case block.type -%}
    {%- when 'subheading' -%}
      {%- if block.settings.subheading != blank -%}
        <div
          data-block-id="{{ block.id }}"
          class="hero__subheading iwtg__subheading {% if block.settings.subheading_disable_on_mobile %}hero__subheading--mobile{% endif %}"
          {{ block.shopify_attributes }}
        >
          {{ block.settings.subheading }}
        </div>
      {%- endif -%}

    {%- when 'heading' -%}
      {%- if block.settings.heading != blank -%}
        <h2
          data-block-id="{{ block.id }}"
          class="hero__title iwtg__heading {% if block.settings.disable_on_mobile %}hero__title--mobile{% endif %}"
          {{ block.shopify_attributes }}
        >
          {{ block.settings.heading }}
        </h2>
      {%- endif -%}

    {%- when 'text' -%}
      {%- if block.settings.text != blank -%}
        <div
          data-block-id="{{ block.id }}"
          class="hero__text hero__richtext iwtg__text rte {% if block.settings.disable_on_mobile %}hero__text--mobile{% endif %}"
          {{ block.shopify_attributes }}
        >
          {{ block.settings.text }}
        </div>
      {%- endif -%}

    {%- when 'button' -%}
      <div class="hero__button--gap">
        {%- if block.settings.button_link and block.settings.button_label != blank -%}
          <a
            href="{{ block.settings.button_link }}"
            tabindex="0"
            aria-label="{{ block.settings.button_label }}"
            data-block-id="{{ block.id }}"
            class="hero__button iwtg__button {% if block.settings.button_select == 'secondary' %}hero__button--secondary{% elsif block.settings.button_select == 'link' %}hero__button--link{% else %}hero__button--primary{% endif %}{% if block.settings.button_bold %} iwtg__button--bold{% endif %}{% if block.settings.disable_on_mobile %} hero__button--mobile{% endif %}"
            {{ block.shopify_attributes }}
          >
            <span>{{ block.settings.button_label }}</span>
          </a>
        {%- endif -%}
      </div>

    {%- when 'countdown_timer' -%}
      {% render 'countdown-timer', block: block %}

    {%- when 'icon_with_text' -%}
      <div data-block-id="{{ block.id }}" class="hero__icon-with-text">
        <div class="hero__icon-container">
          {%- if block.settings.icon == blank -%}
            {% render 'icons', id: block.settings.select_icon, url: block.settings.image.url, icon_class: 'hero__icon' %}
          {%- else -%}
            {{
              block.settings.icon
              | image_url: width: 750
              | image_tag: loading: 'lazy', sizes: '(min-width: 750px) 750px, 100vw', widths: '750, 1500', class: 'hero__icon'
            }}
          {%- endif -%}
        </div>
        <div class="hero__icon-text">{{ block.settings.text }}</div>
      </div>

    {%- when 'table' -%}
      <div class="hero__table {% if block.settings.full-width-enabled %}hero__table--full-width{% endif %}" data-block-id="{{ block.id }}">
        <div class="hero__table-container">
          {%- if block.settings.metafield != empty -%}
            {%- assign metafield = block.settings.metafield | strip | split: '.' -%}
            {%- assign specification = product.metafields[metafield.first][metafield.last] | newline_to_br -%}
          {%- else -%}
            {%- assign specification = block.settings.table_content | newline_to_br -%}
          {%- endif -%}
          {%- assign table_rows = specification | strip_newlines | split: '<br /><br />' -%}
          {%- for row in table_rows -%}
            <div class="hero__table__row hero__table__row--mobile--{{ block.settings.mobile_layout }}">
              {%- assign row_cells = row | split: '<br />' -%}
              {%- for cell in row_cells limit: 1 -%}
                <div class="hero__table__cell--title hero__table__cell hero__table__cell--{{ block.settings.desktop_text_horizontal_position }} hero__table__cell--mobile--{{ block.settings.mobile_text_horizontal_position }}">
                  <p>{{ cell }}</p>
                </div>
              {%- endfor -%}
              <div class="hero__table__cell--content hero__table__cell hero__table__cell--{{ block.settings.desktop_text_horizontal_position }} hero__table__cell--mobile--{{ block.settings.mobile_text_horizontal_position }}">
                {%- for cell in row_cells offset: 1 -%}
                  <p>{{ cell }}</p>
                {%- endfor -%}
              </div>
            </div>
          {%- endfor -%}
        </div>
      </div>

    {%- when 'ui_spacer' -%}
      {% render 'ui-spacer',
        block_id: block.id,
        spacer_mobile_height: block.settings.spacer_mobile_height,
        spacer_desktop_height: block.settings.spacer_desktop_height
      %}
  {%- endcase -%}
{%- endfor -%}
