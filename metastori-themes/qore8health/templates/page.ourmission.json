    "image_with_scrolling_text_rwB7c8": {
      "type": "image-with-scrolling-text",
      "blocks": {
        "image_J8hMHq": {
          "type": "image",
          "settings": {
            "desktop_image": "shopify://shop_images/PRODUCT_FEATURE_OPTION_2.png",
            "mobile_image": "shopify://shop_images/PRODUCT_FEATURE_OPTION_2.png",
            "heading": "Supplements for a Thriving You",
            "size_heading": 140,
            "size_heading_mobile": 90,
            "text": "At qore8, we create science-informed solutions designed to support immunity, joint health, sleep, anti-aging, and everyday vitality. We believe wellness should feel elevated, accessible, and grounded in evidence.Every formula we make is built around one belief — that what matters is not only what you take, but how well your body can use it. That's why we invest in advanced delivery technologies that enhance absorption and bioavailability, so your body gets the full benefit of every ingredient.Clean. Pharmaceutical-grade. Made in Australia.",
            "button_select": "primary",
            "button_label": "kNOW MORE",
            "button_link": "/",
            "disable_on_mobile": false
          }
        },
        "image_7P7C67": {
          "type": "image",
          "settings": {
            "desktop_image": "shopify://shop_images/susan-wilkinson-ReiMJUT19uI-unsplash.jpg",
            "mobile_image": "shopify://shop_images/susan-wilkinson-ReiMJUT19uI-unsplash.jpg",
            "heading": "Every Capsule. Engineered to Perform.",
            "size_heading": 140,
            "size_heading_mobile": 90,
            "text": "Inside every qore8 capsule is a formula built with intention. From sourcing up to 99% pharmaceutical-grade NMN to combining Nicotinamide Riboside with Resveratrol for synergistic cellular support — nothing in our range happens by accident.We go further than the ingredient. Our advanced delivery technologies — including VeriSperse®, PlexoZome®, AquaCelle®, and HydroCurc® — are specifically chosen to maximise absorption and bioavailability, so what's on the label is what your body actually receives.Formulated with precision. Tested to the highest standard. Made in Australia.This is qore8. Advanced science made accessible.",
            "button_select": "primary",
            "button_label": "Know More",
            "button_link": "/",
            "disable_on_mobile": false
          }
        },
        "image_zRYkLC": {
          "type": "image",
          "settings": {
            "desktop_image": "shopify://shop_images/Email_Capture_Background.jpg",
            "mobile_image": "shopify://shop_images/Email_Capture_Background.jpg",
            "heading": "Rooted in Nature. Refined by Science.",
            "size_heading": 140,
            "size_heading_mobile": 90,
            "text": "The most powerful wellness solutions have always begun with nature. At qore8, we start there too — drawing on plant-derived, nature-inspired ingredients and elevating them through advanced formulation science to deliver supplements your body can truly absorb and use.Every ingredient we choose is non-GMO, vegan, and free from pesticides and preservatives. Nothing artificial. Nothing unnecessary. Just clean, plant-rooted formulations crafted with clinical precision — so you can feel the difference nature intended, backed by the science that makes it real.",
            "button_select": "primary",
            "button_label": "Know More",
            "button_link": "/",
            "disable_on_mobile": false
          }
        }
      },
