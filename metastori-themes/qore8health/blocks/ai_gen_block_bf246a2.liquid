{% doc %}
  @prompt
    I need a rich text section in which bullets are properly written and when i center the text it align itself without leaving any extra white space.
    2-3 line complete then next line without wating space 
    
    we can have text columns for each point upto 8 columns 
    i need a control to handle alignment color text size and padding between text 
    and columns needs to be rich text type, i need pointers too when i add text to a column like 1. 2. 3.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-richtext-columns-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    padding: {{ block.settings.section_padding_top }}px {{ block.settings.section_padding_horizontal }}px {{ block.settings.section_padding_bottom }}px {{ block.settings.section_padding_horizontal }}px;
    background-color: {{ block.settings.background_color }};
  }

  .ai-richtext-columns-container-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: repeat({{ block.settings.columns_desktop }}, 1fr);
    gap: {{ block.settings.column_gap }}px;
    text-align: {{ block.settings.text_alignment }};
  }

  .ai-richtext-column-{{ ai_gen_id }} {
    color: {{ block.settings.text_color }};
    font-size: {{ block.settings.text_size }}px;
    line-height: {{ block.settings.line_height }};
  }

  .ai-richtext-column-{{ ai_gen_id }} p {
    margin: 0 0 {{ block.settings.paragraph_spacing }}px 0;
    color: {{ block.settings.text_color }};
  }

  .ai-richtext-column-{{ ai_gen_id }} p:last-child {
    margin-bottom: 0;
  }

  .ai-richtext-column-{{ ai_gen_id }} ul,
  .ai-richtext-column-{{ ai_gen_id }} ol {
    margin: 0 0 {{ block.settings.paragraph_spacing }}px 0;
    padding-left: 0;
    list-style-position: inside;
  }

  {% if block.settings.text_alignment == 'center' %}
    .ai-richtext-column-{{ ai_gen_id }} ul,
    .ai-richtext-column-{{ ai_gen_id }} ol {
      list-style-position: inside;
      text-align: {{ block.settings.text_alignment }};
    }
  {% elsif block.settings.text_alignment == 'right' %}
    .ai-richtext-column-{{ ai_gen_id }} ul,
    .ai-richtext-column-{{ ai_gen_id }} ol {
      list-style-position: inside;
      text-align: {{ block.settings.text_alignment }};
    }
  {% else %}
    .ai-richtext-column-{{ ai_gen_id }} ul,
    .ai-richtext-column-{{ ai_gen_id }} ol {
      list-style-position: outside;
      padding-left: 20px;
    }
  {% endif %}

  .ai-richtext-column-{{ ai_gen_id }} ul:last-child,
  .ai-richtext-column-{{ ai_gen_id }} ol:last-child {
    margin-bottom: 0;
  }

  .ai-richtext-column-{{ ai_gen_id }} li {
    margin-bottom: {{ block.settings.list_item_spacing }}px;
    color: {{ block.settings.text_color }};
  }

  .ai-richtext-column-{{ ai_gen_id }} li:last-child {
    margin-bottom: 0;
  }

  .ai-richtext-column-{{ ai_gen_id }} h1,
  .ai-richtext-column-{{ ai_gen_id }} h2,
  .ai-richtext-column-{{ ai_gen_id }} h3,
  .ai-richtext-column-{{ ai_gen_id }} h4,
  .ai-richtext-column-{{ ai_gen_id }} h5,
  .ai-richtext-column-{{ ai_gen_id }} h6 {
    margin: 0 0 {{ block.settings.paragraph_spacing }}px 0;
    color: {{ block.settings.heading_color }};
  }

  .ai-richtext-column-{{ ai_gen_id }} strong {
    color: {{ block.settings.text_color }};
  }

  .ai-richtext-column-{{ ai_gen_id }} a {
    color: {{ block.settings.link_color }};
    text-decoration: underline;
  }

  .ai-richtext-column-{{ ai_gen_id }} a:hover {
    color: {{ block.settings.link_hover_color }};
  }

  @media screen and (max-width: 749px) {
    .ai-richtext-columns-{{ ai_gen_id }} {
      padding: {{ block.settings.section_padding_top_mobile }}px {{ block.settings.section_padding_horizontal_mobile }}px {{ block.settings.section_padding_bottom_mobile }}px {{ block.settings.section_padding_horizontal_mobile }}px;
    }

    .ai-richtext-columns-container-{{ ai_gen_id }} {
      grid-template-columns: repeat({{ block.settings.columns_mobile }}, 1fr);
      gap: {{ block.settings.column_gap_mobile }}px;
    }

    .ai-richtext-column-{{ ai_gen_id }} {
      font-size: {{ block.settings.text_size_mobile }}px;
    }
  }
{% endstyle %}

<div class="ai-richtext-columns-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-richtext-columns-container-{{ ai_gen_id }}">
    {% if block.settings.column_1 != blank %}
      <div class="ai-richtext-column-{{ ai_gen_id }}">
        {{ block.settings.column_1 }}
      </div>
    {% endif %}

    {% if block.settings.column_2 != blank %}
      <div class="ai-richtext-column-{{ ai_gen_id }}">
        {{ block.settings.column_2 }}
      </div>
    {% endif %}

    {% if block.settings.column_3 != blank %}
      <div class="ai-richtext-column-{{ ai_gen_id }}">
        {{ block.settings.column_3 }}
      </div>
    {% endif %}

    {% if block.settings.column_4 != blank %}
      <div class="ai-richtext-column-{{ ai_gen_id }}">
        {{ block.settings.column_4 }}
      </div>
    {% endif %}

    {% if block.settings.column_5 != blank %}
      <div class="ai-richtext-column-{{ ai_gen_id }}">
        {{ block.settings.column_5 }}
      </div>
    {% endif %}

    {% if block.settings.column_6 != blank %}
      <div class="ai-richtext-column-{{ ai_gen_id }}">
        {{ block.settings.column_6 }}
      </div>
    {% endif %}

    {% if block.settings.column_7 != blank %}
      <div class="ai-richtext-column-{{ ai_gen_id }}">
        {{ block.settings.column_7 }}
      </div>
    {% endif %}

    {% if block.settings.column_8 != blank %}
      <div class="ai-richtext-column-{{ ai_gen_id }}">
        {{ block.settings.column_8 }}
      </div>
    {% endif %}
  </div>
</div>

