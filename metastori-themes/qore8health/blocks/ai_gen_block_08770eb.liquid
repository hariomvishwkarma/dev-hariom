{% doc %}
  @prompt
    i need a section like trust badges or icon with text where i can add trust texts of my brands but i don't need to add any icons or logo just simple text and i need a functionality to change its background color and witdth and height , i need a seeting to set fixed width and full width for the page
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-trust-badges-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    background-color: {{ block.settings.background_color }};
    padding: {{ block.settings.padding_vertical }}px {{ block.settings.padding_horizontal }}px;
  }

  .ai-trust-badges-container-{{ ai_gen_id }} {
    {% if block.settings.container_width == 'full' %}
      max-width: 100%;
    {% else %}
      max-width: {{ block.settings.max_width }}px;
    {% endif %}
    margin: 0 auto;
    width: 100%;
  }

  .ai-trust-badges-grid-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: repeat({{ block.settings.columns_desktop }}, 1fr);
    gap: {{ block.settings.gap }}px;
    align-items: center;
  }

  .ai-trust-badge-item-{{ ai_gen_id }} {
    text-align: {{ block.settings.text_alignment }};
    padding: {{ block.settings.item_padding }}px;
    background-color: {{ block.settings.item_background_color }};
    border-radius: {{ block.settings.item_border_radius }}px;
    border: {{ block.settings.item_border_width }}px solid {{ block.settings.item_border_color }};
  }

  .ai-trust-badge-text-{{ ai_gen_id }} {
    color: {{ block.settings.text_color }};
    font-size: {{ block.settings.font_size }}px;
    line-height: {{ block.settings.line_height }};
    margin: 0;
  }

  @media screen and (max-width: 749px) {
    .ai-trust-badges-grid-{{ ai_gen_id }} {
      grid-template-columns: repeat({{ block.settings.columns_mobile }}, 1fr);
    }

    .ai-trust-badge-text-{{ ai_gen_id }} {
      font-size: {{ block.settings.font_size_mobile }}px;
    }
  }
{% endstyle %}

<trust-badges-{{ ai_gen_id }} class="ai-trust-badges-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-trust-badges-container-{{ ai_gen_id }}">
    <div class="ai-trust-badges-grid-{{ ai_gen_id }}">
      {% if block.settings.badge_text_1 != blank %}
        <div class="ai-trust-badge-item-{{ ai_gen_id }}">
          <p class="ai-trust-badge-text-{{ ai_gen_id }}">{{ block.settings.badge_text_1 }}</p>
        </div>
      {% endif %}

      {% if block.settings.badge_text_2 != blank %}
        <div class="ai-trust-badge-item-{{ ai_gen_id }}">
          <p class="ai-trust-badge-text-{{ ai_gen_id }}">{{ block.settings.badge_text_2 }}</p>
        </div>
      {% endif %}

      {% if block.settings.badge_text_3 != blank %}
        <div class="ai-trust-badge-item-{{ ai_gen_id }}">
          <p class="ai-trust-badge-text-{{ ai_gen_id }}">{{ block.settings.badge_text_3 }}</p>
        </div>
      {% endif %}

      {% if block.settings.badge_text_4 != blank %}
        <div class="ai-trust-badge-item-{{ ai_gen_id }}">
          <p class="ai-trust-badge-text-{{ ai_gen_id }}">{{ block.settings.badge_text_4 }}</p>
        </div>
      {% endif %}

      {% if block.settings.badge_text_5 != blank %}
        <div class="ai-trust-badge-item-{{ ai_gen_id }}">
          <p class="ai-trust-badge-text-{{ ai_gen_id }}">{{ block.settings.badge_text_5 }}</p>
        </div>
      {% endif %}

      {% if block.settings.badge_text_6 != blank %}
        <div class="ai-trust-badge-item-{{ ai_gen_id }}">
          <p class="ai-trust-badge-text-{{ ai_gen_id }}">{{ block.settings.badge_text_6 }}</p>
        </div>
      {% endif %}
    </div>
  </div>
</trust-badges-{{ ai_gen_id }}>

<script>
  (function() {
    class TrustBadges{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
      }
    }

    customElements.define('trust-badges-{{ ai_gen_id }}', TrustBadges{{ ai_gen_id }});
  })();
</script>

