{% doc %}
  @prompt
    Create a fully customizable brand feature highlight section with 3 equal columns 
    in a bordered grid layout. Each column contains a short bold uppercase heading 
    (e.g. "BUILT AT THE CELLULAR LEVEL") and an optional subtext or description 
    below it. The section should include:
    
    LAYOUT & STRUCTURE:
    - Full-width section spanning the entire browser width
    - 3 equal-width columns separated by vertical dividers/borders
    - A thin top and bottom border framing the entire section
    - Optional: a small label or tagline centered above the 3 columns (e.g. brand name)
    - Columns should be center-aligned both horizontally and vertically
    
    CONTENT PER COLUMN (schema settings for each):
    - Heading text (short, bold, uppercase) — editable per column
    - Subheading or description text — editable per column
    - Optional icon or image above the heading — toggle show/hide
    
    CUSTOMIZATION CONTROLS (all exposed in theme editor):
    - Section background color picker
    - Border color picker
    - Text color picker for headings
    - Text color picker for descriptions
    - Font size control for headings (small / medium / large)
    - Font size control for descriptions
    - Section top and bottom padding (0px to 120px slider)
    - Section max-width toggle: full-width vs. contained (boxed)
    - Column count: 2, 3, or 4 columns (dropdown)
    - Divider between columns: show/hide toggle
    - Divider color picker
    - Heading font weight: bold / extra-bold toggle
    - Letter spacing control for headings (normal / wide / wider)
    - Mobile stacking: columns stack vertically on mobile
    
    ADDITIONAL SETTINGS:
    - Add/remove columns dynamically using blocks
    - Background image option with overlay color + opacity slider
    - Section visibility toggle (show/hide without deleting)
    
    Style inspiration: clean, clinical, premium wellness brand aesthetic — 
    similar to high-end supplement or skincare brands. 
    Minimal design, strong typography, no fluff., i also need one more setting as i need this section to be placed in center not on left corner 
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-brand-features-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    background-color: {{ block.settings.section_bg_color }};
    {% if block.settings.section_bg_image %}
      background-image: url('{{ block.settings.section_bg_image | image_url: width: 2000 }}');
      background-size: cover;
      background-position: center;
      position: relative;
    {% endif %}
    {% if block.settings.show_section %}
      display: flex;
      justify-content: {{ block.settings.content_alignment }};
    {% else %}
      display: none;
    {% endif %}
  }

  {% if block.settings.section_bg_image %}
    .ai-brand-features-{{ ai_gen_id }}::before {
      content: '';
      position: absolute;
      top: 0;
      left: 0;
      right: 0;
      bottom: 0;
      background-color: {{ block.settings.overlay_color }};
      opacity: {{ block.settings.overlay_opacity | divided_by: 100.0 }};
      pointer-events: none;
    }
  {% endif %}

  .ai-brand-features__wrapper-{{ ai_gen_id }} {
    position: relative;
    z-index: 1;
    width: {{ block.settings.desktop_width_percent }}%;
    {% if block.settings.max_width_toggle == 'contained' %}
      max-width: 1400px;
    {% endif %}
    border-top: 1px solid {{ block.settings.border_color }};
    border-bottom: 1px solid {{ block.settings.border_color }};
    padding-top: {{ block.settings.section_padding_top }}px;
    padding-bottom: {{ block.settings.section_padding_bottom }}px;
  }

  .ai-brand-features__tagline-{{ ai_gen_id }} {
    text-align: center;
    font-size: 12px;
    letter-spacing: 2px;
    text-transform: uppercase;
    color: {{ block.settings.text_color_heading }};
    margin-bottom: 30px;
    font-weight: 600;
  }

  .ai-brand-features__grid-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: repeat({{ block.settings.column_count }}, 1fr);
    gap: 0;
  }

  .ai-brand-features__column-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding: 40px 20px;
    {% if block.settings.show_dividers %}
      border-right: 1px solid {{ block.settings.divider_color }};
    {% endif %}
  }

  .ai-brand-features__column-{{ ai_gen_id }}:last-child {
    border-right: none;
  }

  .ai-brand-features__icon-{{ ai_gen_id }} {
    margin-bottom: 20px;
    width: 60px;
    height: 60px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .ai-brand-features__icon-{{ ai_gen_id }} img {
    max-width: 100%;
    max-height: 100%;
    object-fit: contain;
  }

  .ai-brand-features__heading-{{ ai_gen_id }} {
    font-size: {% if block.settings.heading_size == 'small' %}14px{% elsif block.settings.heading_size == 'medium' %}16px{% else %}18px{% endif %};
    font-weight: {% if block.settings.heading_weight == 'bold' %}700{% else %}800{% endif %};
    text-transform: uppercase;
    letter-spacing: {% if block.settings.heading_letter_spacing == 'normal' %}1px{% elsif block.settings.heading_letter_spacing == 'wide' %}2px{% else %}3px{% endif %};
    color: {{ block.settings.text_color_heading }};
    margin: 0 0 12px 0;
    line-height: 1.3;
  }

  .ai-brand-features__description-{{ ai_gen_id }} {
    font-size: {% if block.settings.description_size == 'small' %}12px{% elsif block.settings.description_size == 'medium' %}14px{% else %}16px{% endif %};
    color: {{ block.settings.text_color_description }};
    margin: 0;
    line-height: 1.5;
    max-width: 280px;
  }

  @media screen and (max-width: 768px) {
    .ai-brand-features__grid-{{ ai_gen_id }} {
      grid-template-columns: 1fr;
    }

    .ai-brand-features__column-{{ ai_gen_id }} {
      border-right: none;
      {% if block.settings.show_dividers %}
        border-bottom: 1px solid {{ block.settings.divider_color }};
      {% endif %}
      padding: 30px 20px;
    }

    .ai-brand-features__column-{{ ai_gen_id }}:last-child {
      border-bottom: none;
    }

    .ai-brand-features__heading-{{ ai_gen_id }} {
      font-size: {% if block.settings.heading_size == 'small' %}12px{% elsif block.settings.heading_size == 'medium' %}14px{% else %}16px{% endif %};
    }

    .ai-brand-features__description-{{ ai_gen_id }} {
      font-size: {% if block.settings.description_size == 'small' %}11px{% elsif block.settings.description_size == 'medium' %}13px{% else %}15px{% endif %};
    }

    .ai-brand-features__wrapper-{{ ai_gen_id }} {
      width: 100%;
    }
  }
{% endstyle %}

<div class="ai-brand-features-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-brand-features__wrapper-{{ ai_gen_id }}">
    {% if block.settings.tagline != blank %}
      <div class="ai-brand-features__tagline-{{ ai_gen_id }}">
        {{ block.settings.tagline }}
      </div>
    {% endif %}

    <div class="ai-brand-features__grid-{{ ai_gen_id }}">
      <div class="ai-brand-features__column-{{ ai_gen_id }}">
        {% if block.settings.show_icon_1 and block.settings.icon_1 != blank %}
          <div class="ai-brand-features__icon-{{ ai_gen_id }}">
            <img
              src="{{ block.settings.icon_1 | image_url: width: 120 }}"
              alt="{{ block.settings.heading_1 | escape }}"
              loading="lazy"
              width="60"
              height="60"
            >
          </div>
        {% endif %}

        {% if block.settings.heading_1 != blank %}
          <h3 class="ai-brand-features__heading-{{ ai_gen_id }}">
            {{ block.settings.heading_1 }}
          </h3>
        {% endif %}

        {% if block.settings.description_1 != blank %}
          <p class="ai-brand-features__description-{{ ai_gen_id }}">
            {{ block.settings.description_1 }}
          </p>
        {% endif %}
      </div>

      <div class="ai-brand-features__column-{{ ai_gen_id }}">
        {% if block.settings.show_icon_2 and block.settings.icon_2 != blank %}
          <div class="ai-brand-features__icon-{{ ai_gen_id }}">
            <img
              src="{{ block.settings.icon_2 | image_url: width: 120 }}"
              alt="{{ block.settings.heading_2 | escape }}"
              loading="lazy"
              width="60"
              height="60"
            >
          </div>
        {% endif %}

        {% if block.settings.heading_2 != blank %}
          <h3 class="ai-brand-features__heading-{{ ai_gen_id }}">
            {{ block.settings.heading_2 }}
          </h3>
        {% endif %}

        {% if block.settings.description_2 != blank %}
          <p class="ai-brand-features__description-{{ ai_gen_id }}">
            {{ block.settings.description_2 }}
          </p>
        {% endif %}
      </div>

      <div class="ai-brand-features__column-{{ ai_gen_id }}">
        {% if block.settings.show_icon_3 and block.settings.icon_3 != blank %}
          <div class="ai-brand-features__icon-{{ ai_gen_id }}">
            <img
              src="{{ block.settings.icon_3 | image_url: width: 120 }}"
              alt="{{ block.settings.heading_3 | escape }}"
              loading="lazy"
              width="60"
              height="60"
            >
          </div>
        {% endif %}

        {% if block.settings.heading_3 != blank %}
          <h3 class="ai-brand-features__heading-{{ ai_gen_id }}">
            {{ block.settings.heading_3 }}
          </h3>
        {% endif %}

        {% if block.settings.description_3 != blank %}
          <p class="ai-brand-features__description-{{ ai_gen_id }}">
            {{ block.settings.description_3 }}
          </p>
        {% endif %}
      </div>

      {% if block.settings.column_count == '4' %}
        <div class="ai-brand-features__column-{{ ai_gen_id }}">
          {% if block.settings.show_icon_4 and block.settings.icon_4 != blank %}
            <div class="ai-brand-features__icon-{{ ai_gen_id }}">
              <img
                src="{{ block.settings.icon_4 | image_url: width: 120 }}"
                alt="{{ block.settings.heading_4 | escape }}"
                loading="lazy"
                width="60"
                height="60"
              >
            </div>
          {% endif %}

          {% if block.settings.heading_4 != blank %}
            <h3 class="ai-brand-features__heading-{{ ai_gen_id }}">
              {{ block.settings.heading_4 }}
            </h3>
          {% endif %}

          {% if block.settings.description_4 != blank %}
            <p class="ai-brand-features__description-{{ ai_gen_id }}">
              {{ block.settings.description_4 }}
            </p>
          {% endif %}
        </div>
      {% endif %}
    </div>
  </div>
</div>

