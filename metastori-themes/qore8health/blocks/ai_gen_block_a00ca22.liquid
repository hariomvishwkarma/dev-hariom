{% doc %}
  @prompt
    generate me a section where i could put a logo image full width and i can add some overlay or blur effect at the bottom of the section to blend it with the other section bakcground color, i need control to adjust height of this section
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-logo-banner-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    overflow: hidden;
    display: block;
  }

  .ai-logo-banner-container-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    height: {{ block.settings.section_height_desktop }}px;
  }

  .ai-logo-banner-image-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    display: block;
    object-fit: {{ block.settings.image_fit }};
    object-position: center;
  }

  .ai-logo-banner-placeholder-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    background-color: #f4f4f4;
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
  }

  .ai-logo-banner-placeholder-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
    max-width: 500px;
    max-height: 500px;
  }

  .ai-logo-banner-empty-state-{{ ai_gen_id }} {
    position: absolute;
    bottom: 20px;
    left: 50%;
    transform: translateX(-50%);
    padding: 12px 20px;
    font-size: 14px;
    color: #666;
    text-align: center;
    pointer-events: none;
  }

  .ai-logo-banner-overlay-{{ ai_gen_id }} {
    position: absolute;
    bottom: 0;
    left: 0;
    width: 100%;
    height: {{ block.settings.overlay_height }}%;
    pointer-events: none;
    z-index: 1;
  }

  {% if block.settings.effect_type == 'gradient' %}
    .ai-logo-banner-overlay-{{ ai_gen_id }} {
      background: linear-gradient(
        to top,
        {{ block.settings.blend_color }} 0%,
        rgba({{ block.settings.blend_color | color_extract: 'red' }}, {{ block.settings.blend_color | color_extract: 'green' }}, {{ block.settings.blend_color | color_extract: 'blue' }}, 0) 100%
      );
      opacity: {{ block.settings.overlay_opacity | divided_by: 100.0 }};
    }
  {% elsif block.settings.effect_type == 'blur' %}
    .ai-logo-banner-overlay-{{ ai_gen_id }} {
      backdrop-filter: blur({{ block.settings.blur_amount }}px);
      -webkit-backdrop-filter: blur({{ block.settings.blur_amount }}px);
      background: linear-gradient(
        to top,
        rgba({{ block.settings.blend_color | color_extract: 'red' }}, {{ block.settings.blend_color | color_extract: 'green' }}, {{ block.settings.blend_color | color_extract: 'blue' }}, {{ block.settings.overlay_opacity | divided_by: 100.0 }}) 0%,
        rgba({{ block.settings.blend_color | color_extract: 'red' }}, {{ block.settings.blend_color | color_extract: 'green' }}, {{ block.settings.blend_color | color_extract: 'blue' }}, 0) 100%
      );
    }
  {% elsif block.settings.effect_type == 'both' %}
    .ai-logo-banner-overlay-{{ ai_gen_id }} {
      backdrop-filter: blur({{ block.settings.blur_amount }}px);
      -webkit-backdrop-filter: blur({{ block.settings.blur_amount }}px);
      background: linear-gradient(
        to top,
        rgba({{ block.settings.blend_color | color_extract: 'red' }}, {{ block.settings.blend_color | color_extract: 'green' }}, {{ block.settings.blend_color | color_extract: 'blue' }}, {{ block.settings.overlay_opacity | divided_by: 100.0 }}) 0%,
        rgba({{ block.settings.blend_color | color_extract: 'red' }}, {{ block.settings.blend_color | color_extract: 'green' }}, {{ block.settings.blend_color | color_extract: 'blue' }}, 0) 100%
      );
    }
  {% endif %}

  @media screen and (max-width: 749px) {
    .ai-logo-banner-container-{{ ai_gen_id }} {
      height: {{ block.settings.section_height_mobile }}px;
    }
  }
{% endstyle %}

<div class="ai-logo-banner-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-logo-banner-container-{{ ai_gen_id }}">
    {% if block.settings.logo_image %}
      <img
        src="{{ block.settings.logo_image | image_url: width: 2000 }}"
        alt="{{ block.settings.logo_image.alt | escape }}"
        loading="lazy"
        width="{{ block.settings.logo_image.width }}"
        height="{{ block.settings.logo_image.height }}"
        class="ai-logo-banner-image-{{ ai_gen_id }}"
      >
    {% else %}
      <div class="ai-logo-banner-placeholder-{{ ai_gen_id }}">
        {{ 'image' | placeholder_svg_tag }}
        <div class="ai-logo-banner-empty-state-{{ ai_gen_id }}">
          Add your logo image
        </div>
      </div>
    {% endif %}

    {% if block.settings.enable_overlay %}
      <div class="ai-logo-banner-overlay-{{ ai_gen_id }}"></div>
    {% endif %}
  </div>
</div>

{% schema %}
{
  "name": "Logo banner with blend",
  "tag": null,
  "settings": [
    {
      "type": "header",
      "content": "Logo image"
    },
    {
      "type": "image_picker",
      "id": "logo_image",
      "label": "Logo image"
    },
    {
      "type": "header",
      "content": "Section height"
    },
    {
      "type": "range",
      "id": "section_height_desktop",
      "label": "Desktop height",
      "min": 200,
      "max": 800,
      "step": 50,
      "unit": "px",
      "default": 400
    },
    {
      "type": "range",
      "id": "section_height_mobile",
      "label": "Mobile height",
      "min": 150,
      "max": 600,
      "step": 50,
      "unit": "px",
      "default": 300
    },
    {
      "type": "select",
      "id": "image_fit",
      "label": "Image fit",
      "options": [
        {
          "value": "cover",
          "label": "Cover"
        },
        {
          "value": "contain",
          "label": "Contain"
        },
        {
          "value": "fill",
          "label": "Fill"
        }
      ],
      "default": "cover"
    },
    {
      "type": "header",
      "content": "Overlay effect"
    },
    {
      "type": "checkbox",
      "id": "enable_overlay",
      "label": "Enable overlay effect",
      "default": true
    },
    {
      "type": "select",
      "id": "effect_type",
      "label": "Effect type",
      "options": [
        {
          "value": "gradient",
          "label": "Gradient only"
        },
        {
          "value": "blur",
          "label": "Blur only"
        },
        {
          "value": "both",
          "label": "Gradient and blur"
        }
      ],
      "default": "both"
    },
    {
      "type": "color",
      "id": "blend_color",
      "label": "Blend color",
      "default": "#f3f4f0"
    },
    {
      "type": "range",
      "id": "overlay_height",
      "label": "Overlay height",
      "min": 10,
      "max": 50,
      "step": 5,
      "unit": "%",
      "default": 30
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "label": "Overlay opacity",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 80
    },
    {
      "type": "range",
      "id": "blur_amount",
      "label": "Blur amount",
      "min": 0,
      "max": 20,
      "step": 2,
      "unit": "px",
      "default": 8
    }
  ],
  "presets": [
    {
      "name": "Logo banner with blend"
    }
  ]
}
{% endschema %}
