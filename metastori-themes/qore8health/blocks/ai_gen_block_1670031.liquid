{% doc %}
  @prompt
    i need to put a logo image in this section and also i need to able adjust width and height and it will be in center like original wonder theme have big logo at the end of the page in black and white outline so image would be great 
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-logo-block-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    padding: 40px 20px;
    background-color: {{ block.settings.background_color }};
  }

  .ai-logo-container-{{ ai_gen_id }} {
    display: flex;
    justify-content: center;
    align-items: center;
    width: 100%;
  }

  .ai-logo-wrapper-{{ ai_gen_id }} {
    position: relative;
    width: {{ block.settings.logo_width_mobile }}px;
    height: {{ block.settings.logo_height_mobile }}px;
    display: flex;
    justify-content: center;
    align-items: center;
  }

  .ai-logo-wrapper-{{ ai_gen_id }} img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    {% if block.settings.enable_grayscale %}
      filter: grayscale(100%);
    {% endif %}
  }

  .ai-logo-placeholder-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    background-color: #f4f4f4;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 8px;
    position: relative;
  }

  .ai-logo-placeholder-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
    max-width: 300px;
    max-height: 300px;
  }

  .ai-logo-empty-state-{{ ai_gen_id }} {
    position: absolute;
    bottom: 20px;
    left: 50%;
    transform: translateX(-50%);
    padding: 12px 20px;
    font-size: 14px;
    color: #666;
    text-align: center;
    pointer-events: none;
  }

  @media screen and (min-width: 750px) {
    .ai-logo-wrapper-{{ ai_gen_id }} {
      width: {{ block.settings.logo_width_desktop }}px;
      height: {{ block.settings.logo_height_desktop }}px;
    }
  }
{% endstyle %}

<div class="ai-logo-block-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-logo-container-{{ ai_gen_id }}">
    <div class="ai-logo-wrapper-{{ ai_gen_id }}">
      {% if block.settings.logo %}
        <img
          src="{{ block.settings.logo | image_url: width: 1000 }}"
          alt="{{ block.settings.logo.alt | escape }}"
          loading="lazy"
          width="{{ block.settings.logo.width }}"
          height="{{ block.settings.logo.height }}"
        >
      {% else %}
        <div class="ai-logo-placeholder-{{ ai_gen_id }}">
          {{ 'image' | placeholder_svg_tag }}
          <div class="ai-logo-empty-state-{{ ai_gen_id }}">
            Next, add your logo image
          </div>
        </div>
      {% endif %}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Logo image",
  "settings": [
    {
      "type": "header",
      "content": "Logo"
    },
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Logo image"
    },
    {
      "type": "checkbox",
      "id": "enable_grayscale",
      "label": "Black and white",
      "default": true
    },
    {
      "type": "header",
      "content": "Mobile size"
    },
    {
      "type": "range",
      "id": "logo_width_mobile",
      "label": "Width",
      "min": 50,
      "max": 400,
      "step": 10,
      "unit": "px",
      "default": 200
    },
    {
      "type": "range",
      "id": "logo_height_mobile",
      "label": "Height",
      "min": 50,
      "max": 400,
      "step": 10,
      "unit": "px",
      "default": 100
    },
    {
      "type": "header",
      "content": "Desktop size"
    },
    {
      "type": "range",
      "id": "logo_width_desktop",
      "label": "Width",
      "min": 100,
      "max": 800,
      "step": 10,
      "unit": "px",
      "default": 400
    },
    {
      "type": "range",
      "id": "logo_height_desktop",
      "label": "Height",
      "min": 100,
      "max": 800,
      "step": 10,
      "unit": "px",
      "default": 200
    },
    {
      "type": "header",
      "content": "Style"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "default": "#f3f4f0"
    }
  ],
  "presets": [
    {
      "name": "Logo image"
    }
  ]
}
{% endschema %}
