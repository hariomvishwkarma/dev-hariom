{% doc %}
  @prompt
    A logo marquee section with separate mobile + desktop controls for
    headline size, logo size (mobile scale), line length, gaps and spacing.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-logo-marquee-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    background-color: {{ block.settings.background_color }};
    padding: {{ block.settings.section_padding_top }}px 0 {{ block.settings.section_padding_bottom }}px;
  }

  .ai-logo-marquee-container-{{ ai_gen_id }} {
    max-width: 1400px;
    margin: 0 auto;
    padding: 0 20px;
  }

  .ai-logo-marquee-header-{{ ai_gen_id }} {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: {{ block.settings.line_gap }}px;
    margin-bottom: {{ block.settings.headline_logo_spacing }}px;
  }


  .ai-logo-marquee-headline-{{ ai_gen_id }} {
    font-size: {{ block.settings.headline_size }}px;
    color: {{ block.settings.headline_color }};
    margin: 0;
    text-align: center;
    white-space: nowrap;
  }

  .ai-logo-marquee-track-wrapper-{{ ai_gen_id }} {
    overflow: hidden;
    position: relative;
  }

  .ai-logo-marquee-track-{{ ai_gen_id }} {
    display: flex;
    gap: {{ block.settings.logo_spacing }}px;
  }

  {% if block.settings.enable_animation %}
    .ai-logo-marquee-track-{{ ai_gen_id }} {
      animation: ai-logo-marquee-scroll-{{ ai_gen_id }} {{ block.settings.animation_speed }}s linear infinite;
    }

    .ai-logo-marquee-track-{{ ai_gen_id }}:hover {
      animation-play-state: paused;
    }
  {% else %}
    .ai-logo-marquee-track-{{ ai_gen_id }} {
      justify-content: center;
      flex-wrap: wrap;
    }
  {% endif %}

  .ai-logo-marquee-logo-{{ ai_gen_id }} {
    flex-shrink: 0;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .ai-logo-marquee-logo-{{ ai_gen_id }}-1 {
    width: {{ block.settings.logo_1_width }}px;
    height: {{ block.settings.logo_1_height }}px;
  }

  .ai-logo-marquee-logo-{{ ai_gen_id }}-2 {
    width: {{ block.settings.logo_2_width }}px;
    height: {{ block.settings.logo_2_height }}px;
  }

  .ai-logo-marquee-logo-{{ ai_gen_id }}-3 {
    width: {{ block.settings.logo_3_width }}px;
    height: {{ block.settings.logo_3_height }}px;
  }

  .ai-logo-marquee-logo-{{ ai_gen_id }}-4 {
    width: {{ block.settings.logo_4_width }}px;
    height: {{ block.settings.logo_4_height }}px;
  }

  .ai-logo-marquee-logo-{{ ai_gen_id }}-5 {
    width: {{ block.settings.logo_5_width }}px;
    height: {{ block.settings.logo_5_height }}px;
  }

  .ai-logo-marquee-logo-{{ ai_gen_id }}-6 {
    width: {{ block.settings.logo_6_width }}px;
    height: {{ block.settings.logo_6_height }}px;
  }

  .ai-logo-marquee-logo-{{ ai_gen_id }}-7 {
    width: {{ block.settings.logo_7_width }}px;
    height: {{ block.settings.logo_7_height }}px;
  }

  .ai-logo-marquee-logo-{{ ai_gen_id }}-8 {
    width: {{ block.settings.logo_8_width }}px;
    height: {{ block.settings.logo_8_height }}px;
  }

  .ai-logo-marquee-logo-{{ ai_gen_id }}-9 {
    width: {{ block.settings.logo_9_width }}px;
    height: {{ block.settings.logo_9_height }}px;
  }

  .ai-logo-marquee-logo-{{ ai_gen_id }}-10 {
    width: {{ block.settings.logo_10_width }}px;
    height: {{ block.settings.logo_10_height }}px;
  }

  .ai-logo-marquee-logo-{{ ai_gen_id }}-11 {
    width: {{ block.settings.logo_11_width }}px;
    height: {{ block.settings.logo_11_height }}px;
  }

  .ai-logo-marquee-logo-{{ ai_gen_id }}-12 {
    width: {{ block.settings.logo_12_width }}px;
    height: {{ block.settings.logo_12_height }}px;
  }

  .ai-logo-marquee-logo-{{ ai_gen_id }} img {
    max-width: 100%;
    max-height: 100%;
    object-fit: contain;
    filter: grayscale({{ block.settings.logo_grayscale }}%);
    opacity: {{ block.settings.logo_opacity }};
    transition: filter 0.3s ease, opacity 0.3s ease;
  }

  .ai-logo-marquee-logo-{{ ai_gen_id }}:hover img {
    filter: grayscale(0%);
    opacity: 1;
  }

  .ai-logo-marquee-placeholder-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    background-color: #f4f4f4;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 4px;
  }

  .ai-logo-marquee-placeholder-{{ ai_gen_id }} svg {
    width: 60%;
    height: 60%;
    opacity: 0.3;
  }

  @keyframes ai-logo-marquee-scroll-{{ ai_gen_id }} {
    0% {
      transform: translateX(0);
    }
    100% {
      transform: translateX(-50%);
    }
  }

