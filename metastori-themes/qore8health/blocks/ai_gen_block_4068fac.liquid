<logo-marquee-{{ ai_gen_id }} class="ai-logo-marquee-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-logo-marquee-container-{{ ai_gen_id }}">
    {% if block.settings.headline != blank %}
      <div class="ai-logo-marquee-header-{{ ai_gen_id }}">
        <h2 class="ai-logo-marquee-headline-{{ ai_gen_id }}">{{ block.settings.headline }}</h2>
      </div>
    {% endif %}

    <div class="ai-logo-marquee-track-wrapper-{{ ai_gen_id }}">
      <div class="ai-logo-marquee-track-{{ ai_gen_id }}" data-enable-animation="{{ block.settings.enable_animation }}">
        {% liquid
          assign logos_array = ''
          for i in (1..12)
            assign logo_key = 'logo_' | append: i
            assign logo = block.settings[logo_key]
            if logo != blank
              assign logos_array = logos_array | append: i | append: ','
            endif
          endfor
          assign logos_array = logos_array | split: ','
        %}

        {% if logos_array.size > 0 %}
          {% if block.settings.enable_animation %}
            {% for j in (1..2) %}
              {% for logo_index in logos_array %}
                {% if logo_index != blank %}
                  {% assign logo_key = 'logo_' | append: logo_index %}
                  {% assign width_key = 'logo_' | append: logo_index | append: '_width' %}
                  {% assign height_key = 'logo_' | append: logo_index | append: '_height' %}
                  {% assign logo = block.settings[logo_key] %}
                  {% assign logo_width = block.settings[width_key] %}
                  {% assign logo_height = block.settings[height_key] %}
                  <div class="ai-logo-marquee-logo-{{ ai_gen_id }} ai-logo-marquee-logo-{{ ai_gen_id }}-{{ logo_index }}">
                    <img
                      src="{{ logo | image_url: width: 800 }}"
                      alt="{{ logo.alt | escape }}"
                      loading="lazy"
                      width="{{ logo_width }}"
                      height="{{ logo_height }}"
                    >
                  </div>
                {% endif %}
              {% endfor %}
            {% endfor %}
          {% else %}
            {% for logo_index in logos_array %}
              {% if logo_index != blank %}
                {% assign logo_key = 'logo_' | append: logo_index %}
                {% assign width_key = 'logo_' | append: logo_index | append: '_width' %}
                {% assign height_key = 'logo_' | append: logo_index | append: '_height' %}
                {% assign logo = block.settings[logo_key] %}
                {% assign logo_width = block.settings[width_key] %}
                {% assign logo_height = block.settings[height_key] %}
                <div class="ai-logo-marquee-logo-{{ ai_gen_id }} ai-logo-marquee-logo-{{ ai_gen_id }}-{{ logo_index }}">
                  <img
                    src="{{ logo | image_url: width: 800 }}"
                    alt="{{ logo.alt | escape }}"
                    loading="lazy"
                    width="{{ logo_width }}"
                    height="{{ logo_height }}"
                  >
                </div>
              {% endif %}
            {% endfor %}
          {% endif %}
        {% else %}
          {% for i in (1..8) %}
            <div class="ai-logo-marquee-logo-{{ ai_gen_id }} ai-logo-marquee-logo-{{ ai_gen_id }}-{{ i }}">
              <div class="ai-logo-marquee-placeholder-{{ ai_gen_id }}">
                {{ 'image' | placeholder_svg_tag }}
              </div>
            </div>
          {% endfor %}
        {% endif %}
      </div>
    </div>
  </div>
</logo-marquee-{{ ai_gen_id }}>

<script>
  (function() {
    class LogoMarquee{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
        const enableAnimation = this.querySelector('.ai-logo-marquee-track-{{ ai_gen_id }}').dataset.enableAnimation === 'true';
        if (enableAnimation) {
          this.adjustAnimationSpeed();
        }
      }

      adjustAnimationSpeed() {
        const track = this.querySelector('.ai-logo-marquee-track-{{ ai_gen_id }}');
        if (!track) return;

        const trackWidth = track.scrollWidth / 2;
        const speed = {{ block.settings.animation_speed }};
        const duration = (trackWidth / 100) * speed;

        track.style.animationDuration = duration + 's';
      }
    }

    customElements.define('logo-marquee-{{ ai_gen_id }}', LogoMarquee{{ ai_gen_id }});
  })();
</script>

