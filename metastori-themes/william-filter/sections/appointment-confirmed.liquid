{% comment %} Appointment Confirmation Section {% endcomment %}

<style>
  * { box-sizing: border-box; margin: 0; padding: 0; }
  body { font-family: var(--font-sans); }
  .page { background: #f5f4f0; min-height: 100vh; padding: 0; }
  .topbar { background: #fff; border-bottom: 0.5px solid var(--color-border-tertiary); padding: 14px 32px; display: flex; justify-content: space-between; align-items: center; }
  .topbar-brand { font-size: 15px; font-weight: 500; letter-spacing: 0.08em; color: var(--color-text-primary); }
  .topbar-links { display: flex; gap: 20px; }
  .topbar-links a { font-size: 12px; color: var(--color-text-secondary); text-decoration: none; letter-spacing: 0.05em; }
  .main { max-width: 600px; margin: 0 auto; padding: 48px 24px 64px; }
  .check-wrap { display: flex; justify-content: center; margin-bottom: 24px; }
  .check-circle { width: 52px; height: 52px; border-radius: 50%; border: 1.5px solid #1a1a1a; display: flex; align-items: center; justify-content: center; }
  .check-circle svg { width: 22px; height: 22px; }
  .headline { text-align: center; font-size: 22px; font-weight: 500; color: var(--color-text-primary); margin-bottom: 8px; letter-spacing: 0.01em; }
  .subline { text-align: center; font-size: 14px; color: var(--color-text-secondary); margin-bottom: 36px; line-height: 1.6; }
  .card { background: #fff; border: 0.5px solid var(--color-border-tertiary); border-radius: 12px; padding: 28px 32px; margin-bottom: 16px; }
  .card-label { font-size: 11px; letter-spacing: 0.08em; color: var(--color-text-tertiary); text-transform: uppercase; margin-bottom: 12px; }
  .appt-title { font-size: 15px; font-weight: 500; color: var(--color-text-primary); margin-bottom: 6px; }
  .appt-meta { font-size: 14px; color: var(--color-text-secondary); line-height: 1.7; }
  .divider { border: none; border-top: 0.5px solid var(--color-border-tertiary); margin: 20px 0; }
  .address-row { display: flex; align-items: flex-start; gap: 10px; }
  .pin { width: 16px; height: 16px; margin-top: 2px; flex-shrink: 0; }
  .address-text { font-size: 14px; color: var(--color-text-secondary); line-height: 1.6; }
  .note-card { background: #f9f8f5; border: 0.5px solid var(--color-border-tertiary); border-radius: 12px; padding: 20px 24px; margin-bottom: 16px; }
  .note-text { font-size: 13px; color: var(--color-text-secondary); line-height: 1.7; }
  .note-text a { color: var(--color-text-primary); }
  .footer-note { text-align: center; font-size: 12px; color: var(--color-text-tertiary); margin-top: 32px; line-height: 1.6; }
  .tag { display: inline-block; background: #f0ede6; color: #5a5750; font-size: 11px; letter-spacing: 0.05em; padding: 3px 10px; border-radius: 20px; margin-bottom: 20px; }
  .center { text-align: center; }
</style>

<div class="page">
  <div class="main">
    <div class="check-wrap">
      <div class="check-circle">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
          <polyline points="20 6 9 17 4 12"></polyline>
        </svg>
      </div>
    </div>

    <div class="center" style="margin-bottom: 6px;">
      <span class="tag">{{ section.settings.tag_text | default: 'Appointment confirmed' }}</span>
    </div>

    <h1 class="headline">{{ section.settings.headline | default: 'Thank you for booking your consultation.' }}</h1>
    
    <p class="subline">
      {{ section.settings.subline | default: 'We look forward to meeting you and helping design your ring.<br>A confirmation email has been sent with your booking details.' }}
    </p>

    <div class="card">
      <div class="card-label">{{ section.settings.card_label | default: 'Your appointment' }}</div>
      
      <div class="appt-title">
        {{ section.settings.appointment_title | default: 'Wedding, Engagement or Bespoke Consultation with William Édouard' }}
      </div>
      
      {% comment %} <div class="appt-meta" style="margin-top: 10px;">
        {{ section.settings.appointment_date | default: 'Wednesday, April 15th, 2026' }}<br>
        {{ section.settings.appointment_time | default: '2:00 PM – 2:45 PM GMT+10' }}
      </div> {% endcomment %}

      <hr class="divider">

      <div class="address-row">
        📍
        <div class="address-text">
          {{ section.settings.address_line1 | default: '9 King St, Prahran VIC 3181' }}<br>
          <span style="font-size: 12px; color: var(--color-text-tertiary);">
            {{ section.settings.address_line2 | default: 'Studio entrance on King St — street parking available nearby.' }}
          </span>
        </div>
      </div>
    </div>

    <div class="note-card">
      <div class="note-text">
        {{ section.settings.note_text | default: 'Your confirmation email includes full booking details, along with options to <strong style="font-weight: 500; color: var(--color-text-primary);">reschedule or edit</strong> your appointment if needed. If you have any questions before your consultation, feel free to reply to that email or reach out at <a href="mailto:info@williamaedouard.com">info@williamaedouard.com</a>.' }}
      </div>
    </div>

    <p class="footer-note">
      {{ section.settings.footer_text | default: "We'll be in touch if anything changes on our end.<br>We can't wait to meet you." }}
    </p>
  </div>
</div>

