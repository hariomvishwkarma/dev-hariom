<section id="shop-by-shape" class="shop-by-shape-section">
  <div class="container" {%- render 'animation-attrs', attrs: 'data-cc-animate' -%}>
    <div class="shop-by-shape-container">
      <div class="shop-by-shape-left">
        {% if section.settings.default_image != blank %}
          <img
            id="shape-preview"
            src="{{ section.settings.default_image | image_url }}"
            alt="Shape preview"
            width=""
            height=""
          >
        {% endif %}
      </div>

      <div class="shop-by-shape-right">
        <h3>{{ section.settings.heading }}</h3>
        <ul class="shape-list">
          {% for block in section.blocks %}
            <li
              class="shape-item"
              data-image="{{ block.settings.shape_image | image_url }}"
            >
              <a href="{{ block.settings.shape_link }}">{{ block.settings.shape_name }}</a>
            </li>
          {% endfor %}
        </ul>
      </div>
    </div>

    <!-- Mobile Slick Slider -->
    <div class="shop-by-shape-slider-mobile">
      <h3>{{ section.settings.heading }}</h3>
      <div class="shop-by-shape-slider">
        {% for block in section.blocks %}
          <div class="shape-slide">
            <a href="{{ block.settings.shape_link }}">
              <h4>{{ block.settings.shape_name }}</h4>
              <div class="shape-slide-image">
                <img
                  src="{{ block.settings.shape_image| image_url}}"
                  alt="{{ block.settings.shape_name }}"
                  width=""
                  height=""
                >
              </div>
            </a>
          </div>
        {% endfor %}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Lp Shop by Shape",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "SHOP BY SHAPE"
    },
    {
      "type": "image_picker",
      "id": "default_image",
      "label": "Default Image"
    }
  ],
  "blocks": [
    {
      "type": "shape",
      "name": "Shape",
      "settings": [
        {
          "type": "text",
          "id": "shape_name",
          "label": "Shape Name",
          "default": "Round"
        },
        {
          "type": "url",
          "id": "shape_link",
          "label": "Shape Link"
        },
        {
          "type": "image_picker",
          "id": "shape_image",
          "label": "Shape Image"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Lp Shop by Shape"
    }
  ]
}
{% endschema %}

<script>
  document.addEventListener('DOMContentLoaded', function () {
    const shapeItems = document.querySelectorAll('.shape-item');
    const imageEl = document.getElementById('shape-preview');
    const defaultImage = imageEl ? imageEl.src : '';

    shapeItems.forEach((item) => {
      const hoverImage = item.getAttribute('data-image');

      item.addEventListener('mouseenter', () => {
        if (imageEl && hoverImage) {
          imageEl.src = hoverImage;
        }
      });

      item.addEventListener('mouseleave', () => {
        if (imageEl && defaultImage) {
          imageEl.src = defaultImage;
        }
      });
    });
  });

  // Initialize Slick for Mobile
  if (window.innerWidth < 768) {
    $('.shop-by-shape-slider').slick({
      dots: false,
      arrows: false,
      infinite: true,
      slidesToShow: 1,
      slidesToScroll: 1,
      centerMode: true,
      centerPadding: '60px',
      adaptiveHeight: true,
    });
  } else {
    console.warn('⚠️ Slick slider not loaded. Include slick.min.js and slick.css in your theme.liquid');
  }
</script>
