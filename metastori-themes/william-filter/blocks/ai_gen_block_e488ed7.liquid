{% doc %}
  @prompt
    Create a custom image with text section for the Shopify theme editor with a clean, minimal, premium layout. On desktop, place the text content on the left and the image on the right, with all text left aligned. On mobile, stack the image above the text and centre align all text. The text area needs to include an editable heading, rich body text, and a button. The button must be fixed at 150px wide by 50px high, with a 1.5px black border, black text, and a transparent background by default. On hover, the button should become fully black and the text should turn white. I need separate controls for desktop and mobile for heading size, body text size, button text size, text padding, and section top and bottom padding. I also need adjustable image padding controls. All of these spacing and sizing controls should use sliders in the theme editor. On desktop, the image should sit on the right in a 4:5 vertical ratio, with its left edge aligned exactly to the centre line of the screen. On mobile, the image must change from portrait to a perfect square, using a true 1:1 aspect ratio rather than just resizing proportionally, and it must appear above the text. Include settings for image upload, rich text editing, button label, and button link.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-image-text-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    padding-top: {{ block.settings.desktop_padding_top }}px;
    padding-bottom: {{ block.settings.desktop_padding_bottom }}px;
  }

  .ai-image-text-container-{{ ai_gen_id }} {
    display: flex;
    align-items: stretch;
    width: 100%;
    max-width: 100%;
  }

  .ai-image-text-content-{{ ai_gen_id }} {
    flex: 0 0 50%;
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: {{ block.settings.desktop_text_padding }}px;
    text-align: left;
  }

  .ai-image-text-heading-{{ ai_gen_id }} {
    margin: 0 0 20px;
    font-size: {{ block.settings.desktop_heading_size }}px;
    color: #000000;
  }

  .ai-image-text-body-{{ ai_gen_id }} {
    margin: 0 0 30px;
    font-size: {{ block.settings.desktop_body_size }}px;
    color: #000000;
  }

  .ai-image-text-body-{{ ai_gen_id }} p {
    margin: 0 0 1em;
  }

  .ai-image-text-body-{{ ai_gen_id }} p:last-child {
    margin-bottom: 0;
  }

  .ai-image-text-button-{{ ai_gen_id }} {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 150px;
    height: 50px;
    background-color: transparent;
    color: #000000;
    border: 1.5px solid #000000;
    text-decoration: none;
    font-size: {{ block.settings.desktop_button_size }}px;
    transition: background-color 0.3s ease, color 0.3s ease;
    cursor: pointer;
  }

  .ai-image-text-button-{{ ai_gen_id }}:hover {
    background-color: #000000;
    color: #ffffff;
  }

  .ai-image-text-image-wrapper-{{ ai_gen_id }} {
    flex: 0 0 50%;
    position: relative;
    padding: {{ block.settings.desktop_image_padding }}px;
  }

  .ai-image-text-image-container-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    padding-bottom: 125%;
    overflow: hidden;
  }

  .ai-image-text-image-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ai-image-text-placeholder-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-color: #f4f4f4;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .ai-image-text-placeholder-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
    max-width: 300px;
    max-height: 300px;
  }

  @media screen and (max-width: 749px) {
    .ai-image-text-{{ ai_gen_id }} {
      padding-top: {{ block.settings.mobile_padding_top }}px;
      padding-bottom: {{ block.settings.mobile_padding_bottom }}px;
    }

    .ai-image-text-container-{{ ai_gen_id }} {
      flex-direction: column;
    }

    .ai-image-text-content-{{ ai_gen_id }} {
      flex: 1;
      order: 2;
      text-align: center;
      padding: {{ block.settings.mobile_text_padding }}px;
    }

    .ai-image-text-heading-{{ ai_gen_id }} {
      font-size: {{ block.settings.mobile_heading_size }}px;
    }

    .ai-image-text-body-{{ ai_gen_id }} {
      font-size: {{ block.settings.mobile_body_size }}px;
    }

    .ai-image-text-button-{{ ai_gen_id }} {
      font-size: {{ block.settings.mobile_button_size }}px;
      margin-left: auto;
      margin-right: auto;
    }

    .ai-image-text-image-wrapper-{{ ai_gen_id }} {
      flex: 1;
      order: 1;
      padding: {{ block.settings.mobile_image_padding }}px;
    }

    .ai-image-text-image-container-{{ ai_gen_id }} {
      padding-bottom: 100%;
    }
  }
{% endstyle %}

<div class="ai-image-text-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-image-text-container-{{ ai_gen_id }}">
    <div class="ai-image-text-content-{{ ai_gen_id }}">
      {% if block.settings.heading != blank %}
        <h2 class="ai-image-text-heading-{{ ai_gen_id }}">{{ block.settings.heading }}</h2>
      {% endif %}

      {% if block.settings.body_text != blank %}
        <div class="ai-image-text-body-{{ ai_gen_id }}">
          {{ block.settings.body_text }}
        </div>
      {% endif %}

      {% if block.settings.button_label != blank %}
        <a
          href="{{ block.settings.button_link }}"
          class="ai-image-text-button-{{ ai_gen_id }}"
        >
          {{ block.settings.button_label }}
        </a>
      {% endif %}
    </div>

    <div class="ai-image-text-image-wrapper-{{ ai_gen_id }}">
      <div class="ai-image-text-image-container-{{ ai_gen_id }}">
        {% if block.settings.image %}
          <img
            src="{{ block.settings.image | image_url: width: 1200 }}"
            alt="{{ block.settings.image.alt | escape }}"
            class="ai-image-text-image-{{ ai_gen_id }}"
            loading="lazy"
            width="{{ block.settings.image.width }}"
            height="{{ block.settings.image.height }}"
          >
        {% else %}
          <div class="ai-image-text-placeholder-{{ ai_gen_id }}">
            {{ 'image' | placeholder_svg_tag }}
          </div>
        {% endif %}
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Image with text",
  "tag": null,
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Heading",
      "default": "Image with text"
    },
    {
      "type": "richtext",
      "id": "body_text",
      "label": "Body text",
      "default": "<p>Use this section to highlight key features or tell your brand story.</p>"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "SHOP NOW"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    },
    {
      "type": "header",
      "content": "Desktop settings"
    },
    {
      "type": "range",
      "id": "desktop_heading_size",
      "label": "Heading size",
      "min": 16,
      "max": 80,
      "step": 2,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "desktop_body_size",
      "label": "Body text size",
      "min": 12,
      "max": 32,
      "step": 1,
      "unit": "px",
      "default": 16
    },
    {
      "type": "range",
      "id": "desktop_button_size",
      "label": "Button text size",
      "min": 10,
      "max": 24,
      "step": 1,
      "unit": "px",
      "default": 14
    },
    {
      "type": "range",
      "id": "desktop_text_padding",
      "label": "Text padding",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "desktop_image_padding",
      "label": "Image padding",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "desktop_padding_top",
      "label": "Section top padding",
      "min": 0,
      "max": 150,
      "step": 5,
      "unit": "px",
      "default": 60
    },
    {
      "type": "range",
      "id": "desktop_padding_bottom",
      "label": "Section bottom padding",
      "min": 0,
      "max": 150,
      "step": 5,
      "unit": "px",
      "default": 60
    },
    {
      "type": "header",
      "content": "Mobile settings"
    },
    {
      "type": "range",
      "id": "mobile_heading_size",
      "label": "Heading size",
      "min": 16,
      "max": 60,
      "step": 2,
      "unit": "px",
      "default": 28
    },
    {
      "type": "range",
      "id": "mobile_body_size",
      "label": "Body text size",
      "min": 12,
      "max": 24,
      "step": 1,
      "unit": "px",
      "default": 14
    },
    {
      "type": "range",
      "id": "mobile_button_size",
      "label": "Button text size",
      "min": 10,
      "max": 20,
      "step": 1,
      "unit": "px",
      "default": 12
    },
    {
      "type": "range",
      "id": "mobile_text_padding",
      "label": "Text padding",
      "min": 0,
      "max": 80,
      "step": 5,
      "unit": "px",
      "default": 20
    },
    {
      "type": "range",
      "id": "mobile_image_padding",
      "label": "Image padding",
      "min": 0,
      "max": 80,
      "step": 5,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "mobile_padding_top",
      "label": "Section top padding",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "mobile_padding_bottom",
      "label": "Section bottom padding",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "default": 40
    }
  ],
  "presets": [
    {
      "name": "Image with text"
    }
  ]
}
{% endschema %}
