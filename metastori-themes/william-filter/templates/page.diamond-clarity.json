        "ai_gen_block_0029bb1_wdwEpf": {
          "type": "ai_gen_block_0029bb1",
          "settings": {
            "heading": "A Guide to Diamond Clarity",
            "text": "<p>A diamond begins as carbon formed deep beneath the earth’s surface, where extreme heat and pressure gradually create its crystalline structure. As diamonds form, natural internal features known as inclusions, and external surface features known as blemishes, can develop.</p><p>These characteristics may affect how light travels through the stone, influencing its brilliance and overall appearance. Clarity refers to the number, size, position, colour and visibility of these inclusions and blemishes, and forms one of the 4Cs of diamond quality: cut, colour, clarity and carat weight.</p>",
            "heading_size_desktop": 36,
            "text_size_desktop": 18,
            "padding_left_desktop": 380,
            "padding_right_desktop": 380,
            "spacing_desktop": 40,
            "heading_size_mobile": 24,
            "text_size_mobile": 14,
            "padding_left_mobile": 40,
            "padding_right_mobile": 40,
            "spacing_mobile": 35,
            "text_alignment": "center",
            "heading_color": "#000000",
            "text_color": "#000000"
          },
          "blocks": {}
        },
