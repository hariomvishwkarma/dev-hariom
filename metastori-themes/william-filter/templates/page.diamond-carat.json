        "ai_gen_block_0029bb1_wdwEpf": {
          "type": "ai_gen_block_0029bb1",
          "settings": {
            "heading": "A Guide to Diamond Carat Weight",
            "text": "<p>Diamond carat weight refers to how much a diamond weighs, rather than its physical dimensions alone. As one of the 4Cs, alongside cut, colour and clarity, carat weight plays an important role in how a diamond is assessed, valued and selected. </p><p>This guide explores diamond carat weight in detail, including what it means, why it matters when choosing a diamond, and how the carat scale is used to compare stones.</p>",
            "heading_size_desktop": 36,
            "text_size_desktop": 18,
            "padding_left_desktop": 380,
            "padding_right_desktop": 380,
            "spacing_desktop": 40,
            "heading_size_mobile": 24,
