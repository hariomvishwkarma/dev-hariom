transform: uppercase; cursor: pointer; transition: border-color 0.2s, color 0.2s; margin-top: 10px; font-family: inherit; }\n  .tw-quiz .btn-restart:hover { border-color: var(--tw-navy); color: var(--tw-navy); }\n  .tw-quiz .btn-back { width: 100%; background: transparent; color: var(--tw-muted); border: 1px solid var(--tw-border); border-radius: 10px; padding: 13px; font-size: 0.8rem; letter-spacing: 0.1em; text-transform: uppercase; cursor: pointer; transition: border-color 0.2s, color 0.2s; margin-top: 10px; font-family: inherit; }\n  .tw-quiz .btn-back:hover { border-color: var(--tw-navy); color: var(--tw-navy); }\n  .tw-quiz .btn-back:disabled { opacity: 0; pointer-events: none; }\n\n  @keyframes tw-fadeDown { from { opacity:0; transform: translateY(-14px); } to { opacity:1; transform:translateY(0); } }\n  @keyframes tw-fadeUp   { from { opacity:0; transform: translateY(14px); }  to { opacity:1; transform:translateY(0); } }\n  @keyframes tw-slideIn  { from { opacity:0; transform: translateX(18px); } to { opacity:1; transform:translateX(0); } }\n  @keyframes tw-fadeIn   { from { opacity:0; transform: scale(0.98); }       to { opacity:1; transform:scale(1); } }\n\n  @media (max-width: 500px) {\n    .tw-quiz .q-card, .tw-quiz .product-top, .tw-quiz .chips, .tw-quiz .buy-area { padding-left: 20px; padding-right: 20px; }\n    .tw-quiz .product-top { flex-direction: column; }\n    .tw-quiz .specs-grid { grid-template-columns: repeat(2,1fr); }\n    .tw-quiz .price-col { text-align: left; }\n    .tw-quiz .product-img-wrap { padding: 24px 20px; min-height: 200px; }\n    .tw-quiz .product-img-wrap img { max-height: 170px; }\n  }\n</style>\n\n<div class=\"tw-quiz\">\n  <div class=\"page\">\n    <div class=\"header\" id=\"tw-main-header\">\n      <div class=\"eyebrow\">Product Advisor</div>\n      <h1>Which steam cleaner<br>fits <em>you?</em></h1>\n      <p>Answer 6 short questions and discover the model that best matches your needs.</p>\n    </div>\n    <div id=\"tw-quiz-