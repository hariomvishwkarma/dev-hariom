,\"26 accessories\",\"40 min steam time\",\"6 m cable\"],\n      specs: [\n        {l:\"Power\",v:\"1500 W\",hi:true},{l:\"Pressure\",v:\"3.6 bar\",hi:true},\n        {l:\"Heat-up time\",v:\"2–8 min\"},{l:\"Steam time\",v:\"40 min\"},\n        {l:\"Temperature\",v:\"100°C\"},{l:\"Tank capacity\",v:\"1500 ml\",hi:true},\n        {l:\"Weight\",v:\"4.3 kg\"},{l:\"Accessories\",v:\"26 pcs\",hi:true}\n      ]\n    },\n    ts2: {\n      url: \"https://techweise.com/s/cs-keuzenhulp-ts2\",\n      name: \"TS2 Performance\", stripColor: \"#ce7a56\", chipColor: \"#ce7a56\",\n      desc: \"Award-winning model with the most powerful combination of performance (1800W at 4 bar), LED indicator, 26 accessories and modern design.\",\n      price: \"€199\", award: true,\n      highlights: [\"4 bar pressure\",\"1600 ml tank\",\"26 accessories\",\"LED indicator\",\"1800 W power\",\"Stylish design\"],\n      specs: [\n        {l:\"Power\",v:\"1800 W\",hi:true},{l:\"Pressure\",v:\"4 bar\",hi:true},\n        {l:\"Heat-up time\",v:\"2–8 min\"},{l:\"Steam time\",v:\"50 min\",hi:true},\n        {l:\"Temperature\",v:\"100°C\"},{l:\"Tank capacity\",v:\"1600 ml\",hi:true},\n        {l:\"Weight\",v:\"4.2 kg\"},{l:\"Accessories\",v:\"26 pcs\",hi:true}\n      ]\n    },\n    ts3: {\n      url: \"https://techweise.com/s/cs-keuzenhulp-ts3\",\n      name: \"TS3 Edge\", stripColor: \"#1b1a1a\", chipColor: \"#143447\",\n      desc: \"The most powerful model in the Techweise lineup. 2600W at 4.2 bar for maximum deep cleaning, ready in just ±1 minute and refillable during use for uninterrupted steaming. Equipped with a digital temperature display, wet & dry function, and 26 original accessories — for those who refuse to compromise.\",\n      price: \"€249.95\", award: false,\n      highlights: [\"2600 W power\",\"4.2 bar pressure\",\"Ready in ±1 minute\",\"Refill while in use\",\"Digital display\",\"Wet & dry steam\"],\n      specs: [\n        {l:\"Power\",v:\"2600 W\",hi:true},{l:\"Pressure\",v:\"4.2 bar\",hi:true},\n        {l:\"Heat-up time\",v:\"±1 min\",hi:true},{l:\"Steam time\",v:\"Unlimited\",hi:true},\n        {l:\"Tank capacity\",v:\"2500 ml\",hi:true},\n        {l:\"Weight\",v:\"3.2 kg\",hi:true},{l:\"Accessories\",v:\"26 pcs\",hi:true}\n      ]\n    }\n  };\n\n  let cur=0, sel=null, scores={compact:0,ts1:0,ts2:0,ts3:0}, answers=new Array(6).fill(null);\n\n  function $(id){ return document.getElementById(id); }\n  function escapeHtml(s){ return String(s).replace(/[&<>\"']/g, function(c){ return ({\"&\":\"&amp;\",\"<\":\"&lt;\",\">\":\"&gt;\",\"\\\"\":\"&quot;\",\"'\":\"&#39;\"})[c]; }); }\n\n  function renderQ(){\n    const q=questions[cur], total=questions.length;\n    $(\"tw-q-label\").textContent=\"Question \"+(cur+1)+\" of \"+total;\n    for(let i=0;i<total;i++){\n      const s=$(\"tw-step-\"+i);\n      if(!s) continue;\n      s.classList.remove(\"done\",\"active\");\n      if(i<cur) s.classList.add(\"done\");\n      else if(i===cur) s.classList.add(\"active\");\n    }\n    $(\"tw-q-num\").textContent=\"Question \"+String(cur+1).padStart(2,\"0\");\n    $(\"tw-q-text\").textContent=q.text;\n    sel=null;\n    const btn=$(\"tw-btn-next\");\n    btn.disabled=true;\n    const last=cur===total-1;\n    var arrowSVG = '<svg width=\"15\" height=\"15\" viewBox=\"0 0 15 15\" fill=\"none\"><path d=\"M2 7.5h11M9 3.5l4 4-4 4\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></svg>';\n    btn.innerHTML = last\n      ? 'See my recommendation ' + arrowSVG\n      : 'Next question ' + arrowSVG;\n    const card=$(\"tw-q-card\");\n    card.style.animation=\"none\"; void card.offsetWidth; card.style.animation=\"tw-slideIn 0.35s cubic-bezier(0.4,0,0.2,1) both\";\n    const el=$(\"tw-options\"); el.innerHTML=\"\";\n    const backBtn=$(\"tw-btn-back\");\n    if(backBtn) backBtn.disabled=(cur===0);\n    q.opts.forEach(function(o,i){\n      const d=document.createElement(\"div\");\n      d.className=\"option\";\n      d.setAttribute(\"data-pick\", i);\n      d.innerHTML = '<div class=\"radio\"></div><span>' + escapeHtml(o.label) + '</span>';\n      el.appendChild(d);\n    });\n  }\n\n  function pick(i){\n    sel=i;\n    const opts = $(\"tw-options\").querySelectorAll(\".option\");\n    opts.forEach(function(e,j){ e.classList.toggle(\"selected\", j===i); });\n    $(\"tw-btn-next\").disabled=false;\n  }\n\n  function back(){\n    if(cur===0) return;\n    cur--;\n    if(answers[cur]!==null){\n      const s=questions[cur].opts[answers[cur]].sc;\n      for(const k in s) scores[k]-=s[k];\n    }\n    renderQ();\n    if(answers[cur]!==null){\n      const opts=$(\"tw-options\").querySelectorAll(\".option\");\n      opts[answers[cur]].classList.add(\"selected\");\n      sel=answers[cur];\n      $(\"tw-btn-next\").disabled=false;\n    }\n  }\n\n  function next(){\n    if(sel===null) return;\n    const s=questions[cur].opts[sel].sc;\n    for(const k in s) scores[k]+=s[k];\n    answers[cur]=sel;\n    if(cur<questions.length-1){ cur++; renderQ(); } else { showResult(); }\n  }\n\n  function showResult(){\n    const winner=Object.entries(scores).reduce(function(a,b){ return a[1]>b[1]?a:b; })[0];\n    $(\"tw-quiz-screen\").style.display=\"none\";\n    $(\"tw-main-header\").style.display=\"none\";\n    const p=products[winner];\n    const rs=$(\"tw-result-screen\");\n    rs.style.display=\"block\";\n    var awardHTML = p.award ? '<img class=\"award-img\" src=\"' + IMGS.award + '\" alt=\"Product of the Year 2026\">' : \"\";\n    var specsHTML = p.specs.map(function(s){\n      return '<div class=\"spec\"><div class=\"spec-lbl\">' + escapeHtml(s.l) + '</div><div class=\"spec-val' + (s.hi ? ' hi' : '') + '\">' + escapeHtml(s.v) + '</div></div>';\n    }).join(\"\");\n    var chipsHTML = p.highlights.map(function(h){\n      return '<div class=\"chip\"><span class=\"chip-dot\" style=\"background:' + p.chipColor + '\"></span>' + escapeHtml(h) + '</div>';\n    }).join(\"\");\n    rs.innerHTML =\n      '<div class=\"result-eyebrow\">Your recommendation</div>' +\n      '<div class=\"result-headline\" style=\"margin-bottom:32px\">This is your ideal<br><em>' + escapeHtml(p.name) + '</em></div>' +\n      '<div class=\"product-card\">' +\n        '<div class=\"card-strip\" style=\"background:' + p.stripColor + '\"></div>' +\n        '<div class=\"product-img-wrap\">' +\n          '<img src=\"' + IMGS[winner] + '\" alt=\"' + escapeHtml(p.name) + '\">' +\n          awardHTML +\n        '</div>' +\n        '<div class=\"buy-area\">' +\n          '<a class=\"btn-buy\" href=\"' + p.url + '\" target=\"_blank\" rel=\"noopener\">' +\n            'Order the ' + escapeHtml(p.name) + ' now for ' + escapeHtml(p.price) +\n            '<svg width=\"15\" height=\"15\" viewBox=\"0 0 15 15\" fill=\"none\"><path d=\"M2 7.5h11M9 3.5l4 4-4 4\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></svg>' +\n          '</a>' +\n        '</div>' +\n        '<div class=\"product-top\">' +\n          '<div>' +\n            '<div class=\"product-name\">' + escapeHtml(p.name) + '</div>' +\n            '<div class=\"product-desc\">' + escapeHtml(p.desc) + '</div>' +\n          '</div>' +\n          '<div class=\"price-col\">' +\n            '<div class=\"price-lbl\">Suggested price</div>' +\n            '<div class=\"price-val\">' + escapeHtml(p.price) + '</div>' +\n          '</div>' +\n        '</div>' +\n        '<div class=\"specs-grid\">' + specsHTML + '</div>' +\n        '<div class=\"chips\">' + chipsHTML + '</div>' +\n      '</div>' +\n      '<button class=\"btn-restart\" type=\"button\" data-action=\"restart\">&#8617; Start over</button>';\n  }\n\n  function restart(){\n    cur=0; sel=null;\n    scores={compact:0,ts1:0,ts2:0,ts3:0};\n    answers=new Array(6).fill(null);\n    $(\"tw-result-screen\").style.display=\"none\";\n    $(\"tw-main-header\").style.display=\"block\";\n    $(\"tw-quiz-screen\").style.display=\"block\";\n    for(let i=0;i<6;i++){\n      const s=$(\"tw-step-\"+i);\n      if(s){ s.classList.remove(\"done\",\"active\"); if(i===0) s.classList.add(\"active\"); }\n    }\n    renderQ();\n  }\n\n  function bind(root){\n    root.addEventListener(\"click\", function(e){\n      const opt = e.target.closest(\".option\");\n      if (opt && root.contains(opt) && opt.dataset.pick !== undefined){\n        pick(parseInt(opt.dataset.pick, 10));\n        return;\n      }\n      const target = e.target.closest(\"[data-action]\");\n      if (!target || !root.contains(target)) return;\n      const action = target.dataset.action;\n      if (action === \"next\") next();\n      else if (action === \"back\") back();\n      else if (action === \"restart\") restart();\n    });\n  }\n\n  function init(){\n    const root = document.querySelector(\".tw-quiz\");\n    if (!root) return false;\n    bind(root);\n    renderQ();\n    return true;\n  }\n\n  (function tryInit(){\n    if(!init()) setTimeout(tryInit, 50);\n  })();\n})();\n</script>\n{% endraw %}",
        "content_nl": "<link rel=\"stylesheet\" href=\"https://fonts.googleapis.com/css2?family=Arapey:ital@0;1&display=swap\">\n\n{% raw %}\n<style>\n  .tw-quiz {\n    --tw-navy:   #143447;\n    --tw-green:  #dbe1a9;\n    --tw-terra:  #ce7a56;\n    --tw-offwht: #f0ece6;\n    --tw-black:  #1b1a1a;\n    --tw-muted:  #7a8a8f;\n    --tw-border: #d6cfc6;\n    background: #ffffff;\n    color: var(--tw-black);\n    font-family: \"Helvetica Neue\", Helvetica, Arial, sans-serif;\n  }\n  .tw-quiz, .tw-quiz * { box-sizing: border-box; }\n  .tw-quiz .page { max-width: 680px; margin: 0 auto; padding: 40px 24px 80px; }\n  .tw-quiz .header { margin-bottom: 40px; animation: tw-fadeDown 0.55s ease both; }\n  .tw-quiz .eyebrow { font-size: 11px; font-weight: 500; letter-spacing: 0.22em; text-transform: uppercase; color: var(--tw-terra); margin-bottom: 14px; }\n  .tw-quiz .header h1 { font-size: clamp(2rem,5vw,3rem); font-weight: 500; letter-spacing: -0.02em; line-height: 1.1; color: var(--tw-navy); margin: 0 0 16px; }\n  .tw-quiz .header h1 em { font-family: \"Arapey\", serif; font-style: italic; font-weight: 400; }\n  .tw-quiz .header p { font-size: 0.95rem; color: var(--tw-muted); line-height: 1.65; max-width: 420px; margin: 0; }\n  .tw-quiz .progress-wrap { margin-bottom: 36px; animation: tw-fadeDown 0.55s 0.08s ease both; }\n  .tw-quiz .progress-meta { display: flex; justify-content: space-between; align-items: center; margin-bottom: 12px; }\n  .tw-quiz .progress-label { font-size: 11px; letter-spacing: 0.14em; text-transform: uppercase; color: var(--tw-muted); font-weight: 500; }\n  .tw-quiz .progress-steps { display: flex; gap: 5px; }\n  .tw-quiz .progress-step { width: 28px; height: 4px; border-radius: 99px; background: var(--tw-border); transition: background 0.4s cubic-bezier(0.4,0,0.2,1), transform 0.3s ease; }\n  .tw-quiz .progress-step.done { background: var(--tw-navy); }\n  .tw-quiz .progress-step.active { background: var(--tw-green); transform: scaleY(1.5); }\n  .tw-quiz .q-card { display: block; background: #fff; border: 1px solid var(--tw-border); border-radius: 16px; padding: 36px; margin-bottom: 16px; animation: tw-slideIn 0.38s cubic-bezier(0.4,0,0.2,1) both; }\n  .tw-quiz .q-num-lbl { font-size: 10px; letter-spacing: 0.22em; text-transform: uppercase; color: var(--tw-terra); font-weight: 500; margin-bottom: 10px; }\n  .tw-quiz .q-text { font-size: 1.15rem; font-weight: 500; line-height: 1.45; color: var(--tw-navy); margin-bottom: 28px; letter-spacing: -0.01em; display: block; }\n  .tw-quiz .options { display: flex; flex-direction: column; gap: 9px; }\n  .tw-quiz .option { display: flex; align-items: flex-start; gap: 14px; padding: 15px 18px; border: 1.5px solid var(--tw-border); border-radius: 10px; cursor: pointer; transition: border-color 0.18s, background 0.18s; background: var(--tw-offwht); font-size: 0.9rem; color: var(--tw-black); line-height: 1.45; }\n  .tw-quiz .option:hover { border-color: var(--tw-navy); background: #fff; }\n  .tw-quiz .option.selected { border-color: var(--tw-navy); background: #fff; }\n  .tw-quiz .radio { width: 18px; height: 18px; min-width: 18px; border-radius: 50%; border: 1.5px solid var(--tw-border); display: flex; align-items: center; justify-content: center; margin-top: 1px; transition: border-color 0.18s, background 0.18s; flex-shrink: 0; }\n  .tw-quiz .option.selected .radio { border-color: var(--tw-navy); background: var(--tw-navy); }\n  .tw-quiz .option.selected .radio::after { content: \"\"; width: 6px; height: 6px; background: #fff; border-radius: 50%; }\n  .tw-quiz .btn-next { width: 100%; background: var(--tw-navy); color: #fff; border: none; border-radius: 10px; padding: 16px 28px; font-size: 0.88rem; font-weight: 500; letter-spacing: 0.1em; text-transform: uppercase; cursor: pointer; display: flex; align-items: center; justify-content: center; gap: 8px; transition: background 0.2s, transform 0.2s; animation: tw-fadeUp 0.38s 0.12s ease both; font-family: inherit; }\n  .tw-quiz .btn-next:hover:not(:disabled) { background: #1b4a66; transform: translateY(-1px); }\n  .tw-quiz .btn-next:disabled { opacity: 0.3; cursor: not-allowed; }\n  .tw-quiz .btn-next svg { transition: transform 0.2s; }\n  .tw-quiz .btn-next:hover:not(:disabled) svg { transform: translateX(3px); }\n\n  .tw-quiz .result-screen { display: none; animation: tw-fadeIn 0.5s ease both; }\n  .tw-quiz .result-eyebrow { font-size: 11px; letter-spacing: 0.22em; text-transform: uppercase; color: var(--tw-terra); font-weight: 500; margin-bottom: 10px; }\n  .tw-quiz .result-headline { font-size: clamp(1.6rem,4vw,2.4rem); font-weight: 500; letter-spacing: -0.02em; color: var(--tw-navy); line-height: 1.1; margin-bottom: 8px; }\n  .tw-quiz .result-headline em { font-family: \"Arapey\", serif; font-style: italic; font-weight: 400; }\n  .tw-quiz .result-sub { font-size: 0.9rem; color: var(--tw-muted); line-height: 1.6; margin: 0 0 32px; }\n  .tw-quiz .product-card { background: #fff; border: 1px solid var(--tw-border); border-radius: 16px; overflow: hidden; margin-bottom: 16px; }\n  .tw-quiz .card-strip { height: 4px; }\n  .tw-quiz .product-img-wrap { background: #f0ece6; display: flex; align-items: center; justify-content: center; padding: 32px 40px; border-bottom: 1px solid var(--tw-border); position: relative; min-height: 260px; }\n  .tw-quiz .product-img-wrap img { max-height: 220px; max-width: 100%; object-fit: contain; display: block; mix-blend-mode: multiply; }\n  .tw-quiz .award-img { position: absolute; bottom: 16px; right: 16px; width: 72px; height: auto; }\n  .tw-quiz .product-top { padding: 28px 36px 24px; display: flex; justify-content: space-between; align-items: flex-start; gap: 20px; border-bottom: 1px solid var(--tw-border); }\n  .tw-quiz .product-name { font-size: 1.7rem; font-weight: 500; letter-spacing: -0.02em; color: var(--tw-navy); margin-bottom: 6px; }\n  .tw-quiz .product-desc { font-size: 0.88rem; color: var(--tw-muted); line-height: 1.55; max-width: 320px; margin: 0; }\n  .tw-quiz .price-col { text-align: right; flex-shrink: 0; }\n  .tw-quiz .price-lbl { font-size: 10px; text-transform: uppercase; letter-spacing: 0.15em; color: var(--tw-muted); margin-bottom: 4px; }\n  .tw-quiz .price-val { font-size: 1.6rem; font-weight: 500; color: var(--tw-navy); }\n  .tw-quiz .specs-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(148px,1fr)); gap: 1px; background: var(--tw-border); border-bottom: 1px solid var(--tw-border); }\n  .tw-quiz .spec { background: #fff; padding: 18px 20px; }\n  .tw-quiz .spec-lbl { font-size: 9px; text-transform: uppercase; letter-spacing: 0.18em; color: var(--tw-muted); margin-bottom: 6px; }\n  .tw-quiz .spec-val { font-size: 1rem; font-weight: 500; color: var(--tw-navy); }\n  .tw-quiz .spec-val.hi { color: var(--tw-terra); }\n  .tw-quiz .chips { padding: 22px 36px; display: flex; flex-wrap: wrap; gap: 7px; border-bottom: 1px solid var(--tw-border); }\n  .tw-quiz .chip { display: flex; align-items: center; gap: 7px; padding: 6px 13px; border: 1px solid var(--tw-border); border-radius: 99px; font-size: 0.78rem; color: var(--tw-black); background: var(--tw-offwht); }\n  .tw-quiz .chip-dot { width: 5px; height: 5px; border-radius: 50%; flex-shrink: 0; }\n  .tw-quiz .buy-area { padding: 24px 36px 32px; }\n  .tw-quiz .btn-buy { text-decoration: none; width: 100%; background: var(--tw-navy); color: #fff; border: none; border-radius: 10px; padding: 17px 28px; font-size: 0.88rem; font-weight: 500; letter-spacing: 0.1em; text-transform: uppercase; cursor: pointer; display: flex; align-items: center; justify-content: center; gap: 10px; transition: filter 0.2s, transform 0.2s; font-family: inherit; }\n  .tw-quiz .btn-buy:hover { filter: brightness(0.88); transform: translateY(-2px); color: #fff; }\n  .tw-quiz .btn-restart { width: 100%; background: transparent; color: var(--tw-muted); border: 1px solid var(--tw-border); border-radius: 10px; padding: 13px; font-size: 0.8rem; letter-spacing: 0.1em; text-transform: uppercase; cursor: pointer; transition: border-color 0.2s, color 0.2s; margin-top: 10px; font-family: inherit; }\n  .tw-quiz .btn-restart:hover { border-color: var(--tw-navy); color: var(--tw-navy); }\n  .tw-quiz .btn-back { width: 100%; background: transparent; color: var(--tw-muted); border: 1px solid var(--tw-border); border-radius: 10px; padding: 13px; font-size: 0.8rem; letter-spacing: 0.1em; text-transform: uppercase; cursor: pointer; transition: border-color 0.2s, color 0.2s; margin-top: 10px; font-family: inherit; }\n  .tw-quiz .btn-back:hover { border-color: var(--tw-navy); color: var(--tw-navy); }\n  .tw-quiz .btn-back:disabled { opacity: 0; pointer-events: none; }\n\n  @keyframes tw-fadeDown { from { opacity:0; transform: translateY(-14px); } to { opacity:1; transform:translateY(0); } }\n  @keyframes tw-fadeUp   { from { opacity:0; transform: translateY(14px); }  to { opacity:1; transform:translateY(0); } }\n  @keyframes tw-slideIn  { from { opacity:0; transform: translateX(18px); } to { opacity:1; transform:translateX(0); } }\n  @keyframes tw-fadeIn   { from { opacity:0; transform: scale(0.98); }       to { opacity:1; transform:scale(1); } }\n\n  @media (max-width: 500px) {\n    .tw-quiz .q-card, .tw-quiz .product-top, .tw-quiz .chips, .tw-quiz .buy-area { padding-left: 20px; padding-right: 20px; }\n    .tw-quiz .product-top { flex-direction: column; }\n    .tw-quiz .specs-grid { grid-template-columns: repeat(2,1fr); }\n    .tw-quiz .price-col { text-align: left; }\n    .tw-quiz .product-img-wrap { padding: 24px 20px; min-height: 200px; }\n    .tw-quiz .product-img-wrap img { max-height: 170px; }\n  }\n</style>\n\n<div class=\"tw-quiz\">\n  <div class=\"page\">\n    <div class=\"header\" id=\"tw-main-header\">\n      <div class=\"eyebrow\">Product Advisor</div>\n      <h1>Welke stoomreiniger<br>past bij <em>jou?</em></h1>\n      <p>Beantwoord 6 korte vragen en ontdek het model dat het beste aansluit bij je wensen.</p>\n    </div>\n    <div id=\"tw-quiz-screen\">\n      <div class=\"progress-wrap\">\n        <div class=\"progress-meta\">\n          <span class=\"progress-label\" id=\"tw-q-label\">Vraag 1 van 6</span>\n          <div class=\"progress-steps\" id=\"tw-progress-steps\">\n            <div class=\"progress-step active\" id=\"tw-step-0\"></div>\n            <div class=\"progress-step\" id=\"tw-step-1\"></div>\n            <div class=\"progress-step\" id=\"tw-step-2\"></div>\n            <div class=\"progress-step\" id=\"tw-step-3\"></div>\n            <div class=\"progress-step\" id=\"tw-step-4\"></div>\n            <div class=\"progress-step\" id=\"tw-step-5\"></div>\n          </div>\n        </div>\n      </div>\n      <div class=\"q-card\" id=\"tw-q-card\">\n        <div class=\"q-num-lbl\" id=\"tw-q-num\">Vraag 01</div>\n        <div class=\"q-text\" id=\"tw-q-text\"></div>\n        <div class=\"options\" id=\"tw-options\"></div>\n      </div>\n      <button class=\"btn-next\" id=\"tw-btn-next\" type=\"button\" data-action=\"next\" disabled>\n        Volgende vraag\n        <svg width=\"15\" height=\"15\" viewBox=\"0 0 15 15\" fill=\"none\"><path d=\"M2 7.5h11M9 3.5l4 4-4 4\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></svg>\n      </button>\n      <button class=\"btn-back\" id=\"tw-btn-back\" type=\"button\" data-action=\"back\">&#8592; Ga terug</button>\n    </div>\n    <div id=\"tw-result-screen\" class=\"result-screen\"></div>\n  </div>\n</div>\n\n<script>\n(function(){\n  const IMGS = {\n    compact: \"https://techweise.com/cdn/shop/files/Techweise-TS-Compact-Handstoomreiniger-hoofd.jpg?v=1768279934&width=1800\",\n    ts1: \"https://techweise.com/cdn/shop/files/techweise-ts1-stoomreiniger_c7289d3e-2094-48e6-977c-8dfd796b0662.png?v=1760016225&width=1400\",\n    ts2: \"https://techweise.com/cdn/shop/files/techweise-ts2-performance-stoomreiniger.png?v=1760016248&width=1600\",\n  ts3: \"https://techweise.com/cdn/shop/files/techweise-ts3-edge-stoomreiniger.png\",\n    award: \"https://cdn.shopify.com/s/files/1/0650/2114/9437/files/product_van_het_jaar.jpg?v=1778083137\"\n  };\n  const questions = [\n    { text: \"Wat is je budget voor je nieuwe stoomreiniger?\",\n      opts: [\n        { label: \"Maximaal €100\", sc: { compact:4, ts1:1, ts2:0, ts3:0 } },\n        { label: \"Maximaal €150\", sc: { compact:1, ts1:4, ts2:1, ts3:0 } },\n        { label: \"Maximaal €200\", sc: { compact:0, ts1:1, ts2:4, ts3:1 } },\n      { label: \"Maximaal €250\", sc: { compact:0, ts1:0, ts2:1, ts3:4 } }\n      ]\n    },\n    { text: \"Hoe intensief ga je reinigen?\",\n      opts: [\n        { label: \"Oppervlakkig vet & vuil verwijderen en bacteriën doden is voldoende\", sc: { compact:3, ts1:2, ts2:1, ts3:0 } },\n        { label: \"Grondig vet, vuil en aanslag verwijderen op diverse oppervlakken\", sc: { compact:0, ts1:3, ts2:2, ts3:2 } },\n        { label: \"Maximale dieptereiniging ik wil de meeste kracht\", sc: { compact:0, ts1:0, ts2:2, ts3:4 } }\n      ]\n    },\n    { text: \"Hoe snel wil je kunnen beginnen met stomen?\",\n      opts: [\n        { label: \"Klaar in 10 seconden — direct opruimen wanneer nodig\", sc: { compact:4, ts1:0, ts2:0, ts3:1 } },\n      { label: \"Klaar in 1 minuut — premium kracht, snelle start\", sc: { compact:2, ts1:0, ts2:0, ts3:4 } },\n          { label: \"Klaar binnen 10 minuten — perfect voor geplande schoonmaakroutines\", sc: { compact:0, ts1:3, ts2:3, ts3:2 } }\n      ]\n    },\n    { text: \"Hoe lang wil je achter elkaar kunnen stomen?\",\n      opts: [\n        { label: \"Onbeperkt ik wil altijd kunnen bijvullen en doorgaan\", sc: { compact:3, ts1:0, ts2:0, ts3:4 } },\n        { label: \"40–50 minuten is meer dan genoeg voor mij\", sc: { compact:0, ts1:3, ts2:4, ts3:2 } }\n      ]\n    },\n    { text: \"Is de nat- én droogstoomfunctie belangrijk voor je?\",\n      opts: [\n        { label: \"Ja, ik wil flexibel kunnen wisselen tussen nat en droog\", sc: { compact:3, ts1:0, ts2:0, ts3:4 } },\n        { label: \"Nee, standaard stoom is prima voor mijn gebruik\", sc: { compact:1, ts1:3, ts2:3, ts3:1 } }\n      ]\n    },\n    { text: \"Wat vind je het belangrijkst in design en formaat?\",\n      opts: [\n        { label: \"Compact & handheld weinig ruimte, modern design\", sc: { compact:4, ts1:0, ts2:1, ts3:0 } },\n        { label: \"Gewoon functioneel design maakt me niet zoveel uit\", sc: { compact:0, ts1:4, ts2:1, ts3:1 } },\n        { label: \"Stijlvol met LED-indicator en een mooi uiterlijk\", sc: { compact:1, ts1:0, ts2:3, ts3:3 } },\n      { label: \"Premium design met digitaal display\", sc: { compact:0, ts1:0, ts2:1, ts3:4 } }\n      ]\n    }\n  ];\n  const products = {\n    compact: {\n      url: \"https://techweise.com/s/cs-keuzenhulp-tsc\",\n      name: \"TS Compact\", stripColor: \"#dbe1a9\", chipColor: \"#4a6a3a\",\n      desc: \"Handig, direct klaar en modern van formaat. Licht en compact, binnen 10 seconden klaar voor gebruik, continue navulbaar en voorzien van nat en droog functie. De ideale keuze als je snel en efficiënt wilt stomen met een compact apparaat.\",\n      price: \"€99\", award: false,\n      highlights: [\"Onbeperkt stomen\",\"Nat & droog stoom\",\"Bijvullen tijdens gebruik\",\"Klaar in ±10 seconden\",\"Compact handheld\",\"15 accessoires\"],\n      specs: [\n        {l:\"Vermogen\",v:\"1200 W\"},{l:\"Druk\",v:\"2,5 bar\"},\n        {l:\"Opwarmtijd\",v:\"±10 sec\",hi:true},{l:\"Stoomtijd\",v:\"Onbeperkt\",hi:true},\n        {l:\"Temperature\",v:\"125°C\",hi:true},{l:\"Waterinhoud\",v:\"900 ml\"},\n        {l:\"Gewicht\",v:\"1,3 kg\",hi:true},{l:\"Accessoires\",v:\"15 stuks\"}\n      ]\n    },\n    ts1: {\n      url: \"https://techweise.com/s/cs-keuzenhulp-ts1\",\n      name: \"TS1\", stripColor: \"#143447\", chipColor: \"#143447\",\n      desc: \"Krachtig en betrouwbaar voor grondig dagelijks reinigen. Groot waterreservoir en het maximale aantal accessoires.\",\n      price: \"€149\", award: false,\n      highlights: [\"3,6 bar druk\",\"1500 ml reservoir\",\"26 accessoires\",\"40 min stoomtijd\",\"6 m snoer\"],\n      specs: [\n        {l:\"Vermogen\",v:\"1500 W\",hi:true},{l:\"Druk\",v:\"3,6 bar\",hi:true},\n        {l:\"Opwarmtijd\",v:\"2–8 min\"},{l:\"Stoomtijd\",v:\"40 min\"},\n        {l:\"Temperature\",v:\"100°C\"},{l:\"Waterinhoud\",v:\"1500 ml\",hi:true},\n        {l:\"Gewicht\",v:\"4,3 kg\"},{l:\"Accessoires\",v:\"26 stuks\",hi:true}\n      ]\n    },\n    ts2: {\n      url: \"https://techweise.com/s/cs-keuzenhulp-ts2\",\n      name: \"TS2 Performance\", stripColor: \"#ce7a56\", chipColor: \"#ce7a56\",\n      desc: \"Bekroond model met de krachtigste combinatie van prestatie, (1800W bij 4 Bar), LED-indicatielampje, 26 accessoires en modern design.\",\n      price: \"€199\", award: true,\n      highlights: [\"4 bar druk\",\"1600 ml reservoir\",\"26 accessoires\",\"LED-indicator\",\"1800 W vermogen\",\"Stijlvol design\"],\n      specs: [\n        {l:\"Vermogen\",v:\"1800 W\",hi:true},{l:\"Druk\",v:\"4 bar\",hi:true},\n        {l:\"Opwarmtijd\",v:\"2–8 min\"},{l:\"Stoomtijd\",v:\"50 min\",hi:true},\n        {l:\"Temperature\",v:\"100°C\"},{l:\"Waterinhoud\",v:\"1600 ml\",hi:true},\n        {l:\"Gewicht\",v:\"4,2 kg\"},{l:\"Accessoires\",v:\"26 stuks\",hi:true}\n      ]\n    },\n    ts3: {\n      url: \"https://techweise.com/s/cs-keuzenhulp-ts3\",\n      name: \"TS3 Edge\", stripColor: \"#1b1a1a\", chipColor: \"#143447\",\n      desc: \"Het krachtigste model uit de Techweise lijn. 2600W bij 4,2 bar voor maximale dieptereiniging, klaar in slechts ±1 minuut én navulbaar tijdens gebruik voor onafgebroken stomen. Voorzien van digitaal temperatuurdisplay, nat- & droogfunctie en 26 originele accessoires — voor wie geen compromissen wil sluiten.\",\n      price: \"€249,95\", award: false,\n      highlights: [\"2600 W vermogen\",\"4,2 bar druk\",\"Klaar in ±1 minuut\",\"Bijvullen tijdens gebruik\",\"Digitaal display\",\"Nat & droog stoom\"],\n      specs: [\n        {l:\"Vermogen\",v:\"2600 W\",hi:true},{l:\"Druk\",v:\"4,2 bar\",hi:true},\n        {l:\"Opwarmtijd\",v:\"±1 min\",hi:true},{l:\"Stoomtijd\",v:\"Onbeperkt\",hi:true},\n        {l:\"Waterinhoud\",v:\"2500 ml\",hi:true},\n        {l:\"Gewicht\",v:\"3,2 kg\",hi:true},{l:\"Accessoires\",v:\"26 stuks\",hi:true}\n      ]\n    }\n  };\n\n  let cur=0, sel=null, scores={compact:0,ts1:0,ts2:0,ts3:0}, answers=new Array(6).fill(null);\n\n  function $(id){ return document.getElementById(id); }\n  function escapeHtml(s){ return String(s).replace(/[&<>\"']/g, function(c){ return ({\"&\":\"&amp;\",\"<\":\"&lt;\",\">\":\"&gt;\",\"\\\"\":\"&quot;\",\"'\":\"&#39;\"})[c]; }); }\n\n  function renderQ(){\n    const q=questions[cur], total=questions.length;\n    $(\"tw-q-label\").textContent=\"Vraag \"+(cur+1)+\" van \"+total;\n    for(let i=0;i<total;i++){\n      const s=$(\"tw-step-\"+i);\n      if(!s) continue;\n      s.classList.remove(\"done\",\"active\");\n      if(i<cur) s.classList.add(\"done\");\n      else if(i===cur) s.classList.add(\"active\");\n    }\n    $(\"tw-q-num\").textContent=\"Vraag \"+String(cur+1).padStart(2,\"0\");\n    $(\"tw-q-text\").textContent=q.text;\n    sel=null;\n    const btn=$(\"tw-btn-next\");\n    btn.disabled=true;\n    const last=cur===total-1;\n    var arrowSVG = '<svg width=\"15\" height=\"15\" viewBox=\"0 0 15 15\" fill=\"none\"><path d=\"M2 7.5h11M9 3.5l4 4-4 4\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></svg>';\n    btn.innerHTML = last\n      ? 'Bekijk mijn aanbeveling ' + arrowSVG\n      : 'Volgende vraag ' + arrowSVG;\n    const card=$(\"tw-q-card\");\n    card.style.animation=\"none\"; void card.offsetWidth; card.style.animation=\"tw-slideIn 0.35s cubic-bezier(0.4,0,0.2,1) both\";\n    const el=$(\"tw-options\"); el.innerHTML=\"\";\n    const backBtn=$(\"tw-btn-back\");\n    if(backBtn) backBtn.disabled=(cur===0);\n    q.opts.forEach(function(o,i){\n      const d=document.createElement(\"div\");\n      d.className=\"option\";\n      d.setAttribute(\"data-pick\", i);\n      d.innerHTML = '<div class=\"radio\"></div><span>' + escapeHtml(o.label) + '</span>';\n      el.appendChild(d);\n    });\n  }\n\n  function pick(i){\n    sel=i;\n    const opts = $(\"tw-options\").querySelectorAll(\".option\");\n    opts.forEach(function(e,j){ e.classList.toggle(\"selected\", j===i); });\n    $(\"tw-btn-next\").disabled=false;\n  }\n\n  function back(){\n    if(cur===0) return;\n    cur--;\n    if(answers[cur]!==null){\n      const s=questions[cur].opts[answers[cur]].sc;\n      for(const k in s) scores[k]-=s[k];\n    }\n    renderQ();\n    if(answers[cur]!==null){\n      const opts=$(\"tw-options\").querySelectorAll(\".option\");\n      opts[answers[cur]].classList.add(\"selected\");\n      sel=answers[cur];\n      $(\"tw-btn-next\").disabled=false;\n    }\n  }\n\n  function next(){\n    if(sel===null) return;\n    const s=questions[cur].opts[sel].sc;\n    for(const k in s) scores[k]+=s[k];\n    answers[cur]=sel;\n    if(cur<questions.length-1){ cur++; renderQ(); } else { showResult(); }\n  }\n\n  function showResult(){\n    const winner=Object.entries(scores).reduce(function(a,b){ return a[1]>b[1]?a:b; })[0];\n    $(\"tw-quiz-screen\").style.display=\"none\";\n    $(\"tw-main-header\").style.display=\"none\";\n    const p=products[winner];\n    const rs=$(\"tw-result-screen\");\n    rs.style.display=\"block\";\n    var awardHTML = p.award ? '<img class=\"award-img\" src=\"' + IMGS.award + '\" alt=\"Product van het Jaar 2026\">' : \"\";\n    var specsHTML = p.specs.map(function(s){\n      return '<div class=\"spec\"><div class=\"spec-lbl\">' + escapeHtml(s.l) + '</div><div class=\"spec-val' + (s.hi ? ' hi' : '') + '\">' + escapeHtml(s.v) + '</div></div>';\n    }).join(\"\");\n    var chipsHTML = p.highlights.map(function(h){\n      return '<div class=\"chip\"><span class=\"chip-dot\" style=\"background:' + p.chipColor + '\"></span>' + escapeHtml(h) + '</div>';\n    }).join(\"\");\n    rs.innerHTML =\n      '<div class=\"result-eyebrow\">Jouw aanbeveling</div>' +\n      '<div class=\"result-headline\" style=\"margin-bottom:32px\">Dit is je ideale<br><em>' + escapeHtml(p.name) + '</em></div>' +\n      '<div class=\"product-card\">' +\n        '<div class=\"card-strip\" style=\"background:' + p.stripColor + '\"></div>' +\n        '<div class=\"product-img-wrap\">' +\n          '<img src=\"' + IMGS[winner] + '\" alt=\"' + escapeHtml(p.name) + '\">' +\n          awardHTML +\n        '</div>' +\n        '<div class=\"buy-area\">' +\n          '<a class=\"btn-buy\" href=\"' + p.url + '\" target=\"_blank\" rel=\"noopener\">' +\n            'Bestel nu de ' + escapeHtml(p.name) + ' voor ' + escapeHtml(p.price) +\n            '<svg width=\"15\" height=\"15\" viewBox=\"0 0 15 15\" fill=\"none\"><path d=\"M2 7.5h11M9 3.5l4 4-4 4\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></svg>' +\n          '</a>' +\n        '</div>' +\n        '<div class=\"product-top\">' +\n          '<div>' +\n            '<div class=\"product-name\">' + escapeHtml(p.name) + '</div>' +\n            '<div class=\"product-desc\">' + escapeHtml(p.desc) + '</div>' +\n          '</div>' +\n          '<div class=\"price-col\">' +\n            '<div class=\"price-lbl\">Adviesprijs</div>' +\n            '<div class=\"price-val\">' + escapeHtml(p.price) + '</div>' +\n          '</div>' +\n        '</div>' +\n        '<div class=\"specs-grid\">' + specsHTML + '</div>' +\n        '<div class=\"chips\">' + chipsHTML + '</div>' +\n      '</div>' +\n      '<button class=\"btn-restart\" type=\"button\" data-action=\"restart\">&#8617; Opnieuw beginnen</button>';\n  }\n\n  function restart(){\n    cur=0; sel=null;\n    scores={compact:0,ts1:0,ts2:0,ts3:0};\n    answers=new Array(6).fill(null);\n    $(\"tw-result-screen\").style.display=\"none\";\n    $(\"tw-main-header\").style.display=\"block\";\n    $(\"tw-quiz-screen\").style.display=\"block\";\n    for(let i=0;i<6;i++){\n      const s=$(\"tw-step-\"+i);\n      if(s){ s.classList.remove(\"done\",\"active\"); if(i===0) s.classList.add(\"active\"); }\n    }\n    renderQ();\n  }\n\n  function bind(root){\n    root.addEventListener(\"click\", function(e){\n      const opt = e.target.closest(\".option\");\n      if (opt && root.contains(opt) && opt.dataset.pick !== undefined){\n        pick(parseInt(opt.dataset.pick, 10));\n        return;\n      }\n      const target = e.target.closest(\"[data-action]\");\n      if (!target || !root.contains(target)) return;\n      const action = target.dataset.action;\n      if (action === \"next\") next();\n      else if (action === \"back\") back();\n      else if (action === \"restart\") restart();\n    });\n  }\n\n  function init(){\n    const root = document.querySelector(\".tw-quiz\");\n    if (!root) return false;\n    bind(root);\n    renderQ();\n    return true;\n  }\n\n  (function tryInit(){\n    if(!init()) setTimeout(tryInit, 50);\n  })();\n})();\n</script>\n{% endraw %}"
      }
    },
    "custom_liquid_fJFMmL": {
      "type": "custom-liquid",
      "disabled": true,
      "name": "t:sections.custom_liquid.name",
      "settings": {
        "color_scheme": "",
        "liquid": "{% raw %}\n<style>\n  .tw-quiz {\n    --tw-navy:   #143447;\n    --tw-green:  #dbe1a9;\n    --tw-terra:  #ce7a56;\n    --tw-offwht: #f0ece6;\n    --tw-black:  #1b1a1a;\n    --tw-muted:  #7a8a8f;\n    --tw-border: #d6cfc6;\n    background: #ffffff;\n    color: var(--tw-black);\n    font-family: \"Helvetica Neue\", Helvetica, Arial, sans-serif;\n  }\n  .tw-quiz, .tw-quiz * { box-sizing: border-box; }\n  .tw-quiz .page { max-width: 680px; margin: 0 auto; padding: 40px 24px 80px; }\n  .tw-quiz .header { margin-bottom: 40px; animation: tw-fadeDown 0.55s ease both; }\n  .tw-quiz .eyebrow { font-size: 11px; font-weight: 500; letter-spacing: 0.22em; text-transform: uppercase; color: var(--tw-terra); margin-bottom: 14px; }\n  .tw-quiz .header h1 { font-size: clamp(2rem,5vw,3rem); font-weight: 500; letter-spacing: -0.02em; line-height: 1.1; color: var(--tw-navy); margin: 0 0 16px; }\n  .tw-quiz .header h1 em { font-family: \"Arapey\", serif; font-style: italic; font-weight: 400; }\n  .tw-quiz .header p { font-size: 0.95rem; color: var(--tw-muted); line-height: 1.65; max-width: 420px; margin: 0; }\n  .tw-quiz .progress-wrap { margin-bottom: 36px; animation: tw-fadeDown 0.55s 0.08s ease both; }\n  .tw-quiz .progress-meta { display: flex; justify-content: space-between; align-items: center; margin-bottom: 12px; }\n  .tw-quiz .progress-label { font-size: 11px; letter-spacing: 0.14em; text-transform: uppercase; color: var(--tw-muted); font-weight: 500; }\n  .tw-quiz .progress-steps { display: flex; gap: 5px; }\n  .tw-quiz .progress-step { width: 28px; height: 4px; border-radius: 99px; background: var(--tw-border); transition: background 0.4s cubic-bezier(0.4,0,0.2,1), transform 0.3s ease; }\n  .tw-quiz .progress-step.done { background: var(--tw-navy); }\n  .tw-quiz .progress-step.active { background: var(--tw-green); transform: scaleY(1.5); }\n  .tw-quiz .q-card { display: block; background: #fff; border: 1px solid var(--tw-border); border-radius: 16px; padding: 36px; margin-bottom: 16px; animation: tw-slideIn 0.38s cubic-bezier(0.4,0,0.2,1) both; }\n  .tw-quiz .q-num-lbl { font-size: 10px; letter-spacing: 0.22em; text-transform: uppercase; color: var(--tw-terra); font-weight: 500; margin-bottom: 10px; }\n  .tw-quiz .q-text { font-size: 1.15rem; font-weight: 500; line-height: 1.45; color: var(--tw-navy); margin-bottom: 28px; letter-spacing: -0.01em; display: block; }\n  .tw-quiz .options { display: flex; flex-direction: column; gap: 9px; }\n  .tw-quiz .option { display: flex; align-items: flex-start; gap: 14px; padding: 15px 18px; border: 1.5px solid var(--tw-border); border-radius: 10px; cursor: pointer; transition: border-color 0.18s, background 0.18s; background: var(--tw-offwht); font-size: 0.9rem; color: var(--tw-black); line-height: 1.45; }\n  .tw-quiz .option:hover { border-color: var(--tw-navy); background: #fff; }\n  .tw-quiz .option.selected { border-color: var(--tw-navy); background: #fff; }\n  .tw-quiz .radio { width: 18px; height: 18px; min-width: 18px; border-radius: 50%; border: 1.5px solid var(--tw-border); display: flex; align-items: center; justify-content: center; margin-top: 1px; transition: border-color 0.18s, background 0.18s; flex-shrink: 0; }\n  .tw-quiz .option.selected .radio { border-color: var(--tw-navy); background: var(--tw-navy); }\n  .tw-quiz .option.selected .radio::after { content: \"\"; width: 6px; height: 6px; background: #fff; border-radius: 50%; }\n  .tw-quiz .btn-next { width: 100%; background: var(--tw-navy); color: #fff; border: none; border-radius: 10px; padding: 16px 28px; font-size: 0.88rem; font-weight: 500; letter-spacing: 0.1em; text-transform: uppercase; cursor: pointer; display: flex; align-items: center; justify-content: center; gap: 8px; transition: background 0.2s, transform 0.2s; animation: tw-fadeUp 0.38s 0.12s ease both; font-family: inherit; }\n  .tw-quiz .btn-next:hover:not(:disabled) { background: #1b4a66; transform: translateY(-1px); }\n  .tw-quiz .btn-next:disabled { opacity: 0.3; cursor: not-allowed; }\n  .tw-quiz .btn-next svg { transition: transform 0.2s; }\n  .tw-quiz .btn-next:hover:not(:disabled) svg { transform: translateX(3px); }\n\n  .tw-quiz .result-screen { display: none; animation: tw-fadeIn 0.5s ease both; }\n  .tw-quiz .result-eyebrow { font-size: 11px; letter-spacing: 0.22em; text-transform: uppercase; color: var(--tw-terra); font-weight: 500; margin-bottom: 10px; }\n  .tw-quiz .result-headline { font-size: clamp(1.6rem,4vw,2.4rem); font-weight: 500; letter-spacing: -0.02em; color: var(--tw-navy); line-height: 1.1; margin-bottom: 8px; }\n  .tw-quiz .result-headline em { font-family: \"Arapey\", serif; font-style: italic; font-weight: 400; }\n  .tw-quiz .result-sub { font-size: 0.9rem; color: var(--tw-muted); line-height: 1.6; margin: 0 0 32px; }\n  .tw-quiz .product-card { background: #fff; border: 1px solid var(--tw-border); border-radius: 16px; overflow: hidden; margin-bottom: 16px; }\n  .tw-quiz .card-strip { height: 4px; }\n  .tw-quiz .product-img-wrap { background: #f0ece6; display: flex; align-items: center; justify-content: center; padding: 32px 40px; border-bottom: 1px solid var(--tw-border); position: relative; min-height: 260px; }\n  .tw-quiz .product-img-wrap img { max-height: 220px; max-width: 100%; object-fit: contain; display: block; mix-blend-mode: multiply; }\n  .tw-quiz .award-img { position: absolute; bottom: 16px; right: 16px; width: 72px; height: auto; }\n  .tw-quiz .product-top { padding: 28px 36px 24px; display: flex; justify-content: space-between; align-items: flex-start; gap: 20px; border-bottom: 1px solid var(--tw-border); }\n  .tw-quiz .product-name { font-size: 1.7rem; font-weight: 500; letter-spacing: -0.02em; color: var(--tw-navy); margin-bottom: 6px; }\n  .tw-quiz .product-desc { font-size: 0.88rem; color: var(--tw-muted); line-height: 1.55; max-width: 320px; margin: 0; }\n  .tw-quiz .price-col { text-align: right; flex-shrink: 0; }\n  .tw-quiz .price-lbl { font-size: 10px; text-transform: uppercase; letter-spacing: 0.15em; color: var(--tw-muted); margin-bottom: 4px; }\n  .tw-quiz .price-val { font-size: 1.6rem; font-weight: 500; color: var(--tw-navy); }\n  .tw-quiz .specs-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(148px,1fr)); gap: 1px; background: var(--tw-border); border-bottom: 1px solid var(--tw-border); }\n  .tw-quiz .spec { background: #fff; padding: 18px 20px; }\n  .tw-quiz .spec-lbl { font-size: 9px; text-transform: uppercase; letter-spacing: 0.18em; color: var(--tw-muted); margin-bottom: 6px; }\n  .tw-quiz .spec-val { font-size: 1rem; font-weight: 500; color: var(--tw-navy); }\n  .tw-quiz .spec-val.hi { color: var(--tw-terra); }\n  .tw-quiz .chips { padding: 22px 36px; display: flex; flex-wrap: wrap; gap: 7px; border-bottom: 1px solid var(--tw-border); }\n  .tw-quiz .chip { display: flex; align-items: center; gap: 7px; padding: 6px 13px; border: 1px solid var(--tw-border); border-radius: 99px; font-size: 0.78rem; color: var(--tw-black); background: var(--tw-offwht); }\n  .tw-quiz .chip-dot { width: 5px; height: 5px; border-radius: 50%; flex-shrink: 0; }\n  .tw-quiz .buy-area { padding: 24px 36px 32px; }\n  .tw-quiz .btn-buy { text-decoration: none; width: 100%; background: var(--tw-navy); color: #fff; border: none; border-radius: 10px; padding: 17px 28px; font-size: 0.88rem; font-weight: 500; letter-spacing: 0.1em; text-transform: uppercase; cursor: pointer; display: flex; align-items: center; justify-content: center; gap: 10px; transition: filter 0.2s, transform 0.2s; font-family: inherit; }\n  .tw-quiz .btn-buy:hover { filter: brightness(0.88); transform: translateY(-2px); color: #fff; }\n  .tw-quiz .btn-restart { width: 100%; background: transparent; color: var(--tw-muted); border: 1px solid var(--tw-border); border-radius: 10px; padding: 13px; font-size: 0.8rem; letter-spacing: 0.1em; text-transform: uppercase; cursor: pointer; transition: border-color 0.2s, color 0.2s; margin-top: 10px; font-family: inherit; }\n  .tw-quiz .btn-restart:hover { border-color: var(--tw-navy); color: var(--tw-navy); }\n  .tw-quiz .btn-back { width: 100%; background: transparent; color: var(--tw-muted); border: 1px solid var(--tw-border); border-radius: 10px; padding: 13px; font-size: 0.8rem; letter-spacing: 0.1em; text-transform: uppercase; cursor: pointer; transition: border-color 0.2s, color 0.2s; margin-top: 10px; font-family: inherit; }\n  .tw-quiz .btn-back:hover { border-color: var(--tw-navy); color: var(--tw-navy); }\n  .tw-quiz .btn-back:disabled { opacity: 0; pointer-events: none; }\n\n  @keyframes tw-fadeDown { from { opacity:0; transform: translateY(-14px); } to { opacity:1; transform:translateY(0); } }\n  @keyframes tw-fadeUp   { from { opacity:0; transform: translateY(14px); }  to { opacity:1; transform:translateY(0); } }\n  @keyframes tw-slideIn  { from { opacity:0; transform: translateX(18px); } to { opacity:1; transform:translateX(0); } }\n  @keyframes tw-fadeIn   { from { opacity:0; transform: scale(0.98); }       to { opacity:1; transform:scale(1); } }\n\n  @media (max-width: 500px) {\n    .tw-quiz .q-card, .tw-quiz .product-top, .tw-quiz .chips, .tw-quiz .buy-area { padding-left: 20px; padding-right: 20px; }\n    .tw-quiz .product-top { flex-direction: column; }\n    .tw-quiz .specs-grid { grid-template-columns: repeat(2,1fr); }\n    .tw-quiz .price-col { text-align: left; }\n    .tw-quiz .product-img-wrap { padding: 24px 20px; min-height: 200px; }\n    .tw-quiz .product-img-wrap img { max-height: 170px; }\n  }\n</style>\n\n<div class=\"tw-quiz\">\n  <div class=\"page\">\n    <div class=\"header\" id=\"tw-main-header\">\n      <div class=\"eyebrow\">Product Advisor</div>\n      <h1>Welke stoomreiniger<br>past bij <em>jou?</em></h1>\n      <p>Beantwoord 6 korte vragen en ontdek het model dat het beste aansluit bij je wensen.</p>\n    </div>\n    <div id=\"tw-quiz-screen\">\n      <div class=\"progress-wrap\">\n        <div class=\"progress-meta\">\n          <span class=\"progress-label\" id=\"tw-q-label\">Vraag 1 van 6</span>\n          <div class=\"progress-steps\" id=\"tw-progress-steps\">\n            <div class=\"progress-step active\" id=\"tw-step-0\"></div>\n            <div class=\"progress-step\" id=\"tw-step-1\"></div>\n            <div class=\"progress-step\" id=\"tw-step-2\"></div>\n            <div class=\"progress-step\" id=\"tw-step-3\"></div>\n            <div class=\"progress-step\" id=\"tw-step-4\"></div>\n            <div class=\"progress-step\" id=\"tw-step-5\"></div>\n          </div>\n        </div>\n      </div>\n      <div class=\"q-card\" id=\"tw-q-card\">\n        <div class=\"q-num-lbl\" id=\"tw-q-num\">Vraag 01</div>\n        <div class=\"q-text\" id=\"tw-q-text\"></div>\n        <div class=\"options\" id=\"tw-options\"></div>\n      </div>\n      <button class=\"btn-next\" id=\"tw-btn-next\" type=\"button\" data-action=\"next\" disabled>\n        Volgende vraag\n        <svg width=\"15\" height=\"15\" viewBox=\"0 0 15 15\" fill=\"none\"><path d=\"M2 7.5h11M9 3.5l4 4-4 4\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></svg>\n      </button>\n      <button class=\"btn-back\" id=\"tw-btn-back\" type=\"button\" data-action=\"back\">&#8592; Ga terug</button>\n    </div>\n    <div id=\"tw-result-screen\" class=\"result-screen\"></div>\n  </div>\n</div>\n\n<script>\n(function(){\n  const IMGS = {\n    compact: \"https://techweise.com/cdn/shop/files/Techweise-TS-Compact-Handstoomreiniger-hoofd.jpg?v=1768279934&width=1800\",\n    ts1: \"https://techweise.com/cdn/shop/files/techweise-ts1-stoomreiniger_c7289d3e-2094-48e6-977c-8dfd796b0662.png?v=1760016225&width=1400\",\n    ts2: \"https://techweise.com/cdn/shop/files/techweise-ts2-performance-stoomreiniger.png?v=1760016248&width=1600\",\n    award: \"https://cdn.shopify.com/s/files/1/0650/2114/9437/files/product_van_het_jaar.jpg?v=1778083137\"\n  };\n  const questions = [\n    { text: \"Wat is je budget voor je nieuwe stoomreiniger?\",\n      opts: [\n        { label: \"Maximaal €100\", sc: { compact:4, ts1:1, ts2:0 } },\n        { label: \"Maximaal €150\", sc: { compact:1, ts1:4, ts2:1 } },\n        { label: \"Maximaal €200\", sc: { compact:0, ts1:1, ts2:4 } }\n      ]\n    },\n    { text: \"Hoe intensief ga je reinigen?\",\n      opts: [\n        { label: \"Oppervlakkig vet & vuil verwijderen en bacteriën doden is voldoende\", sc: { compact:3, ts1:2, ts2:1 } },\n        { label: \"Grondig vet, vuil en aanslag verwijderen op diverse oppervlakken\", sc: { compact:0, ts1:3, ts2:2 } },\n        { label: \"Maximale dieptereiniging ik wil de meeste kracht\", sc: { compact:0, ts1:0, ts2:2 } }\n      ]\n    },\n    { text: \"Hoe snel wil je kunnen beginnen met stomen?\",\n      opts: [\n        { label: \"Direct: binnen 10 seconden klaar voor gebruik\", sc: { compact:4, ts1:0, ts2:0 } },\n        { label: \"Snel: binnen ongeveer een minuut\", sc: { compact:2, ts1:0, ts2:0 } },\n        { label: \"Ik wacht rustig 2–8 minuten\", sc: { compact:0, ts1:3, ts2:3 } }\n      ]\n    },\n    { text: \"Hoe lang wil je achter elkaar kunnen stomen?\",\n      opts: [\n        { label: \"Onbeperkt ik wil altijd kunnen bijvullen en doorgaan\", sc: { compact:3, ts1:0, ts2:0 } },\n        { label: \"40–50 minuten is meer dan genoeg voor mij\", sc: { compact:0, ts1:3, ts2:4 } }\n      ]\n    },\n    { text: \"Is de nat- én droogstoomfunctie belangrijk voor je?\",\n      opts: [\n        { label: \"Ja, ik wil flexibel kunnen wisselen tussen nat en droog\", sc: { compact:3, ts1:0, ts2:0 } },\n        { label: \"Nee, standaard stoom is prima voor mijn gebruik\", sc: { compact:1, ts1:3, ts2:3 } }\n      ]\n    },\n    { text: \"Wat vind je het belangrijkst in design en formaat?\",\n      opts: [\n        { label: \"Compact & handheld weinig ruimte, modern design\", sc: { compact:4, ts1:0, ts2:1 } },\n        { label: \"Gewoon functioneel design maakt me niet zoveel uit\", sc: { compact:0, ts1:4, ts2:1 } },\n        { label: \"Stijlvol met LED-indicator en een mooi uiterlijk\", sc: { compact:1, ts1:0, ts2:3 } }\n      ]\n    }\n  ];\n  const products = {\n    compact: {\n      url: \"https://techweise.com/s/cs-keuzenhulp-tsc\",\n      name: \"TS Compact\", stripColor: \"#dbe1a9\", chipColor: \"#4a6a3a\",\n      desc: \"Handig, direct klaar en modern van formaat. Licht en compact, binnen 10 seconden klaar voor gebruik, continue navulbaar en voorzien van nat en droog functie. De ideale keuze als je snel en efficiënt wilt stomen met een compact apparaat.\",\n      price: \"€99\", award: false,\n      highlights: [\"Onbeperkt stomen\",\"Nat & droog stoom\",\"Bijvullen tijdens gebruik\",\"Klaar in ±10 seconden\",\"Compact handheld\",\"15 accessoires\"],\n      specs: [\n        {l:\"Vermogen\",v:\"1200 W\"},{l:\"Druk\",v:\"2,5 bar\"},\n        {l:\"Opwarmtijd\",v:\"±10 sec\",hi:true},{l:\"Stoomtijd\",v:\"Onbeperkt\",hi:true},\n        {l:\"Temperature\",v:\"125°C\",hi:true},{l:\"Waterinhoud\",v:\"900 ml\"},\n        {l:\"Gewicht\",v:\"1,3 kg\",hi:true},{l:\"Accessoires\",v:\"15 stuks\"}\n      ]\n    },\n    ts1: {\n      url: \"https://techweise.com/s/cs-keuzenhulp-ts1\",\n      name: \"TS1\", stripColor: \"#143447\", chipColor: \"#143447\",\n      desc: \"Krachtig en betrouwbaar voor grondig dagelijks reinigen. Groot waterreservoir en het maximale aantal accessoires.\",\n      price: \"€149\", award: false,\n      highlights: [\"3,6 bar druk\",\"1500 ml reservoir\",\"26 accessoires\",\"40 min stoomtijd\",\"6 m snoer\"],\n      specs: [\n        {l:\"Vermogen\",v:\"1500 W\",hi:true},{l:\"Druk\",v:\"3,6 bar\",hi:true},\n        {l:\"Opwarmtijd\",v:\"2–8 min\"},{l:\"Stoomtijd\",v:\"40 min\"},\n        {l:\"Temperature\",v:\"100°C\"},{l:\"Waterinhoud\",v:\"1500 ml\",hi:true},\n        {l:\"Gewicht\",v:\"4,3 kg\"},{l:\"Accessoires\",v:\"26 stuks\",hi:true}\n      ]\n    },\n    ts2: {\n      url: \"https://techweise.com/s/cs-keuzenhulp-ts2\",\n      name: \"TS2 Performance\", stripColor: \"#ce7a56\", chipColor: \"#ce7a56\",\n      desc: \"Bekroond model met de krachtigste combinatie van prestatie, (1800W bij 4 Bar), LED-indicatielampje, 26 accessoires en modern design.\",\n      price: \"€199\", award: true,\n      highlights: [\"4 bar druk\",\"1600 ml reservoir\",\"26 accessoires\",\"LED-indicator\",\"1800 W vermogen\",\"Stijlvol design\"],\n      specs: [\n        {l:\"Vermogen\",v:\"1800 W\",hi:true},{l:\"Druk\",v:\"4 bar\",hi:true},\n        {l:\"Opwarmtijd\",v:\"2–8 min\"},{l:\"Stoomtijd\",v:\"50 min\",hi:true},\n        {l:\"Temperature\",v:\"100°C\"},{l:\"Waterinhoud\",v:\"1600 ml\",hi:true},\n        {l:\"Gewicht\",v:\"4,2 kg\"},{l:\"Accessoires\",v:\"26 stuks\",hi:true}\n      ]\n    }\n  };\n\n  let cur=0, sel=null, scores={compact:0,ts1:0,ts2:0}, answers=new Array(6).fill(null);\n\n  function $(id){ return document.getElementById(id); }\n  function escapeHtml(s){ return String(s).replace(/[&<>\"']/g, function(c){ return ({\"&\":\"&amp;\",\"<\":\"&lt;\",\">\":\"&gt;\",\"\\\"\":\"&quot;\",\"'\":\"&#39;\"})[c]; }); }\n\n  function renderQ(){\n    const q=questions[cur], total=questions.length;\n    $(\"tw-q-label\").textContent=\"Vraag \"+(cur+1)+\" van \"+total;\n    for(let i=0;i<total;i++){\n      const s=$(\"tw-step-\"+i);\n      if(!s) continue;\n      s.classList.remove(\"done\",\"active\");\n      if(i<cur) s.classList.add(\"done\");\n      else if(i===cur) s.classList.add(\"active\");\n    }\n    $(\"tw-q-num\").textContent=\"Vraag \"+String(cur+1).padStart(2,\"0\");\n    $(\"tw-q-text\").textContent=q.text;\n    sel=null;\n    const btn=$(\"tw-btn-next\");\n    btn.disabled=true;\n    const last=cur===total-1;\n    var arrowSVG = '<svg width=\"15\" height=\"15\" viewBox=\"0 0 15 15\" fill=\"none\"><path d=\"M2 7.5h11M9 3.5l4 4-4 4\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></svg>';\n    btn.innerHTML = last\n      ? 'Bekijk mijn aanbeveling ' + arrowSVG\n      : 'Volgende vraag ' + arrowSVG;\n    const card=$(\"tw-q-card\");\n    card.style.animation=\"none\"; void card.offsetWidth; card.style.animation=\"tw-slideIn 0.35s cubic-bezier(0.4,0,0.2,1) both\";\n    const el=$(\"tw-options\"); el.innerHTML=\"\";\n    const backBtn=$(\"tw-btn-back\");\n    if(backBtn) backBtn.disabled=(cur===0);\n    q.opts.forEach(function(o,i){\n      const d=document.createElement(\"div\");\n      d.className=\"option\";\n      d.setAttribute(\"data-pick\", i);\n      d.innerHTML = '<div class=\"radio\"></div><span>' + escapeHtml(o.label) + '</span>';\n      el.appendChild(d);\n    });\n  }\n\n  function pick(i){\n    sel=i;\n    const opts = $(\"tw-options\").querySelectorAll(\".option\");\n    opts.forEach(function(e,j){ e.classList.toggle(\"selected\", j===i); });\n    $(\"tw-btn-next\").disabled=false;\n  }\n\n  function back(){\n    if(cur===0) return;\n    cur--;\n    if(answers[cur]!==null){\n      const s=questions[cur].opts[answers[cur]].sc;\n      for(const k in s) scores[k]-=s[k];\n    }\n    renderQ();\n    if(answers[cur]!==null){\n      const opts=$(\"tw-options\").querySelectorAll(\".option\");\n      opts[answers[cur]].classList.add(\"selected\");\n      sel=answers[cur];\n      $(\"tw-btn-next\").disabled=false;\n    }\n  }\n\n  function next(){\n    if(sel===null) return;\n    const s=questions[cur].opts[sel].sc;\n    for(const k in s) scores[k]+=s[k];\n    answers[cur]=sel;\n    if(cur<questions.length-1){ cur++; renderQ(); } else { showResult(); }\n  }\n\n  function showResult(){\n    const winner=Object.entries(scores).reduce(function(a,b){ return a[1]>b[1]?a:b; })[0];\n    $(\"tw-quiz-screen\").style.display=\"none\";\n    $(\"tw-main-header\").style.display=\"none\";\n    const p=products[winner];\n    const rs=$(\"tw-result-screen\");\n    rs.style.display=\"block\";\n    var awardHTML = p.award ? '<img class=\"award-img\" src=\"' + IMGS.award + '\" alt=\"Product van het Jaar 2026\">' : \"\";\n    var specsHTML = p.specs.map(function(s){\n      return '<div class=\"spec\"><div class=\"spec-lbl\">' + escapeHtml(s.l) + '</div><div class=\"spec-val' + (s.hi ? ' hi' : '') + '\">' + escapeHtml(s.v) + '</div></div>';\n    }).join(\"\");\n    var chipsHTML = p.highlights.map(function(h){\n      return '<div class=\"chip\"><span class=\"chip-dot\" style=\"background:' + p.chipColor + '\"></span>' + escapeHtml(h) + '</div>';\n    }).join(\"\");\n    rs.innerHTML =\n      '<div class=\"result-eyebrow\">Jouw aanbeveling</div>' +\n      '<div class=\"result-headline\" style=\"margin-bottom:32px\">Dit is je ideale<br><em>' + escapeHtml(p.name) + '</em></div>' +\n      '<div class=\"product-card\">' +\n        '<div class=\"card-strip\" style=\"background:' + p.stripColor + '\"></div>' +\n        '<div class=\"product-img-wrap\">' +\n          '<img src=\"' + IMGS[winner] + '\" alt=\"' + escapeHtml(p.name) + '\">' +\n          awardHTML +\n        '</div>' +\n        '<div class=\"buy-area\">' +\n          '<a class=\"btn-buy\" href=\"' + p.url + '\" target=\"_blank\" rel=\"noopener\">' +\n            'Bestel nu de ' + escapeHtml(p.name) + ' voor ' + escapeHtml(p.price) +\n            '<svg width=\"15\" height=\"15\" viewBox=\"0 0 15 15\" fill=\"none\"><path d=\"M2 7.5h11M9 3.5l4 4-4 4\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></svg>' +\n          '</a>' +\n        '</div>' +\n        '<div class=\"product-top\">' +\n          '<div>' +\n            '<div class=\"product-name\">' + escapeHtml(p.name) + '</div>' +\n            '<div class=\"product-desc\">' + escapeHtml(p.desc) + '</div>' +\n          '</div>' +\n          '<div class=\"price-col\">' +\n            '<div class=\"price-lbl\">Adviesprijs</div>' +\n            '<div class=\"price-val\">' + escapeHtml(p.price) + '</div>' +\n          '</div>' +\n        '</div>' +\n        '<div class=\"specs-grid\">' + specsHTML + '</div>' +\n        '<div class=\"chips\">' + chipsHTML + '</div>' +\n      '</div>' +\n      '<button class=\"btn-restart\" type=\"button\" data-action=\"restart\">&#8617; Opnieuw beginnen</button>';\n  }\n\n  function restart(){\n    cur=0; sel=null;\n    scores={compact:0,ts1:0,ts2:0};\n    answers=new Array(6).fill(null);\n    $(\"tw-result-screen\").style.display=\"none\";\n    $(\"tw-main-header\").style.display=\"block\";\n    $(\"tw-quiz-screen\").style.display=\"block\";\n    for(let i=0;i<6;i++){\n      const s=$(\"tw-step-\"+i);\n      if(s){ s.classList.remove(\"done\",\"active\"); if(i===0) s.classList.add(\"active\"); }\n    }\n    renderQ();\n  }\n\n  function bind(root){\n    root.addEventListener(\"click\", function(e){\n      const opt = e.target.closest(\".option\");\n      if (opt && root.contains(opt) && opt.dataset.pick !== undefined){\n        pick(parseInt(opt.dataset.pick, 10));\n        return;\n      }\n      const target = e.target.closest(\"[data-action]\");\n      if (!target || !root.contains(target)) return;\n      const action = target.dataset.action;\n      if (action === \"next\") next();\n      else if (action === \"back\") back();\n      else if (action === \"restart\") restart();\n    });\n  }\n\n  function init(){\n    const root = document.querySelector(\".tw-quiz\");\n    if (!root) return false;\n    bind(root);\n    renderQ();\n    return true;\n  }\n\n  (function tryInit(){\n    if(!init()) setTimeout(tryInit, 50);\n  })();\n})();\n</script>\n{% endraw %}",
