{%- comment -%}
  Global overlay image shown on collection product cards (theme settings).
{%- endcomment -%}

{%- if settings.collection_card_overlay_enable and settings.collection_card_overlay_image != blank -%}
  {%- liquid
    assign overlay_image = settings.collection_card_overlay_image
    assign overlay_mobile_image = settings.collection_card_overlay_mobile_image
    if overlay_mobile_image == blank
      assign overlay_mobile_image = overlay_image
    endif

    assign overlay_position = settings.collection_card_overlay_position | default: 'top_right'

    case overlay_position
      when 'place-self-start'
        assign overlay_position = 'top_left'
      when 'place-self-start-center'
        assign overlay_position = 'top_center'
      when 'place-self-start-end'
        assign overlay_position = 'top_right'
      when 'place-self-end-start'
        assign overlay_position = 'bottom_left'
      when 'place-self-end-center'
        assign overlay_position = 'bottom_center'
      when 'place-self-end'
        assign overlay_position = 'bottom_right'
    endcase

    assign overlay_tag = 'div'
    if settings.collection_card_overlay_link != blank
      assign overlay_tag = 'a'
    endif
  -%}

  <{{ overlay_tag }}
    class="product-card__collection-overlay product-card__collection-overlay--{{ overlay_position }}"
    {% if overlay_tag == 'a' %}
      href="{{ settings.collection_card_overlay_link }}"
    {% endif %}
    style="--product-card-overlay-image: .5rem;"
  >
    {%- render 'media' with overlay_image, mobile_media: overlay_mobile_image, preload: false -%}
  </{{ overlay_tag }}>
{%- endif -%}
