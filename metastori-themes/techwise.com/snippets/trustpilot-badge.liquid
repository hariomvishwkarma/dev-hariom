{% comment %}
  Trustpilot badge snippet
  Section ke block loop me use karo:
    {% render 'trustpilot-badge', block: block %}

  Ya direct values pass karke:
    {% render 'trustpilot-badge',
        uid: 'tp1',
        top_desktop: 0, left_desktop: 1,
        top_mobile: 0, left_mobile: 1 %}
{% endcomment %}

{%- liquid
  assign uid          = uid          | default: block.id | default: 'tp'
  assign top_desktop  = top_desktop  | default: block.settings.top_desktop  | default: 0
  assign left_desktop = left_desktop | default: block.settings.left_desktop | default: 1
  assign top_mobile   = top_mobile   | default: block.settings.top_mobile   | default: 0
  assign left_mobile  = left_mobile  | default: block.settings.left_mobile  | default: 1

  assign lang = request.locale.iso_code | default: localization.language.iso_code | downcase | split: '-' | first
-%}

<style>
  .tp-{{ uid }}.trustpilet-cus{
    position:relative;
    top: {{ top_desktop }}%;
    left: {{ left_desktop }}%;
    width: 100%;
  }
  .trustpilet-cus img, .trustpilet-cus p { margin: 0; }
  .trustpilet-cus p {
    display: flex;
    gap: 7px;
    align-items: center;
    color: white;
  }
  .trustpilet-cus p span {
    display: flex !important;
    align-items: center;
    color: white;
  }
  @media(max-width:768px){
    .tp-{{ uid }}.trustpilet-cus{
      top: {{ top_mobile }}%;
      left: {{ left_mobile }}%;
      padding-top: 19px;
    }
    .cus-trust-badges { width: 80px; }
  }
</style>

{%- case lang -%}
  {%- when 'fr' -%}
    {%- assign stars_img = 'https://emailsignature.trustpilot.com/newsletter/fr-FR/1/617ff6896bc505ee409c533a/stars@2x.png' -%}
    {%- assign text_img  = 'https://emailsignature.trustpilot.com/newsletter/fr-FR/1/617ff6896bc505ee409c533a/text2_dark@2x.png' -%}
  {%- else -%}
    {%- assign stars_img = 'https://emailsignature.trustpilot.com/newsletter/nl-NL/1/617ff6896bc505ee409c533a/stars@2x.png' -%}
    {%- assign text_img  = 'https://emailsignature.trustpilot.com/newsletter/nl-NL/1/617ff6896bc505ee409c533a/text2_dark@2x.png' -%}
{%- endcase -%}

<div class="trustpilet-cus tp-{{ uid }}">
  <p style="text-align:center;">
    <span>
      <img src="{{ stars_img }}" alt="Trustpilot Stars" height="20" style="max-height:20px;" border="0">
    </span>
    <span style="display:inline-block; filter: brightness(0);">
      <img src="{{ text_img }}" alt="number of reviews" height="18" style="max-height:18px;" border="0">
    </span>
  </p>
</div>