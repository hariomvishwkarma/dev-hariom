{%- comment -%}
  Renders an announcement countdown block (same features as announcement-countdown section).

  Accepts:
  - block: {Object} block object
  - section_id: {String} parent section id
  - wrapper_class: {String} optional extra class on wrapper
  - is_selected: {Boolean} whether this slide is selected in carousel mode
  - marquee: {Boolean} compact inline layout for marquee mode
{%- endcomment -%}

{%- liquid
  assign countdown_id = 'announcement-countdown-' | append: section_id | append: '-' | append: block.id
  assign font_size = block.settings.font_size | default: 14
  assign countdown_wrapper_class = 'announcement-bar__countdown-block'

  if marquee
    assign countdown_wrapper_class = countdown_wrapper_class | append: ' announcement-bar__countdown-block--marquee'
  endif

  if wrapper_class != blank
    assign countdown_wrapper_class = countdown_wrapper_class | append: ' ' | append: wrapper_class
  endif

  if is_selected
    assign countdown_wrapper_class = countdown_wrapper_class | append: ' is-selected'
  endif
-%}

<div
  class="{{ countdown_wrapper_class }}"
  {% unless marquee %}id="{{ countdown_id }}"{% endunless %}
  data-announcement-countdown
  data-block-id="{{ block.id }}"
  data-show-days="{% if block.settings.show_days %}true{% else %}false{% endif %}"
  data-rolling-days="{{ block.settings.rolling_days | default: 3 }}"
  data-copied-text="{{ block.settings.copied_text | default: 'Copied!' | escape }}"
  data-redirect-url="{{ block.settings.redirect_url }}"
  data-redirect-new-tab="{% if block.settings.redirect_new_tab %}true{% else %}false{% endif %}"
  style="
    {%- unless marquee -%}
      background-color: {{ block.settings.bg_color }};
      color: {{ block.settings.text_color }};
    {%- else -%}
      color: {{ block.settings.text_color }};
    {%- endunless -%}
    font-size: {{ font_size }}px;
    {% if block.settings.redirect_url != blank %}cursor: pointer;{% endif %}
  "
  {% unless marquee %}{{ block.shopify_attributes }}{% endunless %}
>
  <div class="announcement-bar__countdown-inner">
    {%- if block.settings.announcement_text != blank or block.settings.button_label != blank -%}
      <span class="announcement-bar__countdown-text-group">
        {%- if block.settings.announcement_text != blank -%}
          <span class="announcement-bar__countdown-text">{{ block.settings.announcement_text }}</span>
        {%- endif -%}

        {%- if block.settings.button_label != blank -%}
          <a
            href="{{ block.settings.button_link | default: '#' }}"
            class="announcement-bar__countdown-cta-btn"
            style="background-color: {{ block.settings.button_bg_color }}; color: {{ block.settings.button_text_color }};"
            {% if block.settings.button_link contains 'http' %}target="_blank" rel="noopener"{% endif %}
            onclick="event.stopPropagation();"
          >
            {{- block.settings.button_label -}}
          </a>
        {%- endif -%}
      </span>
    {%- endif -%}

    {%- if block.settings.badge_text != blank -%}
      <span
        class="announcement-bar__countdown-badge"
        style="background-color: {{ block.settings.badge_bg_color }}; color: {{ block.settings.badge_text_color }};"
        title="Click to copy"
      >
        <span class="announcement-bar__countdown-badge-label">{{ block.settings.badge_text }}</span>
        <svg class="announcement-bar__countdown-badge-copy" width="11" height="11" viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
          <rect x="5" y="5" width="9" height="9" rx="1.5" stroke="currentColor" stroke-width="1.5"/>
          <path d="M3 11V3a1 1 0 0 1 1-1h8" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
        </svg>
        <svg class="announcement-bar__countdown-badge-check" width="11" height="11" viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" hidden>
          <polyline points="2,9 6,13 14,4" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </span>
    {%- endif -%}

    {%- if block.settings.show_timer -%}
      <div class="announcement-bar__countdown-timer" data-timer>
        <span class="announcement-bar__countdown-timer-block announcement-bar__countdown-days-block" data-days-block hidden>
          <span class="announcement-bar__countdown-timer-digits" data-days>00</span>
          <span class="announcement-bar__countdown-timer-label">{{ block.settings.label_days | default: 'D' }}</span>
        </span>
        <span class="announcement-bar__countdown-timer-sep announcement-bar__countdown-days-sep" data-days-sep hidden>:</span>

        <span class="announcement-bar__countdown-timer-block">
          <span class="announcement-bar__countdown-timer-digits" data-hours>00</span>
          <span class="announcement-bar__countdown-timer-label">{{ block.settings.label_hours | default: 'H' }}</span>
        </span>
        <span class="announcement-bar__countdown-timer-sep">:</span>
        <span class="announcement-bar__countdown-timer-block">
          <span class="announcement-bar__countdown-timer-digits" data-minutes>00</span>
          <span class="announcement-bar__countdown-timer-label">{{ block.settings.label_minutes | default: 'M' }}</span>
        </span>
        <span class="announcement-bar__countdown-timer-sep">:</span>
        <span class="announcement-bar__countdown-timer-block">
          <span class="announcement-bar__countdown-timer-digits" data-seconds>00</span>
          <span class="announcement-bar__countdown-timer-label">{{ block.settings.label_seconds | default: 'S' }}</span>
        </span>
      </div>
    {%- endif -%}
  </div>
</div>
