{% comment %}
  <script>
    document.addEventListener("bogos:bundle-render", async (e) => {
      setTimeout(() => {
      document.querySelector("#bogos-bundle-view .bogos-bundles-total-title").textContent = FGSECOMAPP.fgAppearance.bundle.content.total_price_text;
      document.querySelector("#bogos-bundle-view .bogos-bundles-button-add").textContent = FGSECOMAPP.fgAppearance.bundle.content.button_text;
      document.querySelector("#bogos-bundle-view .bogos-bundles-widget[data-bundle-id='13175'] .bogos-bundles-button-add").textContent = 'Pre-order met bundelkorting'
    }, 100)
  })
  </script>
{% endcomment %}

{% comment %}
  {% assign product_handle = "extra-set-of-7-brushes-ts2,microfiber-cloth-for-techweise-nv286-steam-cleaner,descaler-steam-cleaner,tv1-wireless-stem-vacuum-cleaner,tv1-draadloze-steelstofzuiger" | split: "," %}
  {% if product_handle contains product.handle %}
    <style>
      div#bogos-bundle-view {
        display: none !important;
      }
    </style>
  {% endif %}
{% endcomment %}

{% unless request.path contains 'ts1-steam-cleaner-with-21-accessories'
  or request.path contains 'ts1-stoomreiniger-met-21-accessoires'
%}
  <style>
    div.bogos-bundles-widget[data-bundle-id="14224"] {
      display: none !important;
    }
  </style>
{% endunless %}

{% unless request.path contains 'ts2-performance-stoomreiniger'
  or request.path contains 'ts2-performance-steam-cleaner'
%}
  <style>
    div.bogos-bundles-widget[data-bundle-id="13175"] {
      display: none !important;
    }
  </style>
{% endunless %}

<style>
  div.bogos-fbt-header-title {
    font-size: 20px;
    font-family: Delight-SemiBold, sans-serif;
    text-rendering: optimizeLegibility;
    -webkit-font-smoothing: antialiased;
    -moz-osx-font-smoothing: grayscale;
    font-synthesis: none;
    font-kerning: normal;
    font-feature-settings: "kern", "liga", "clig", "calt";
    -webkit-text-stroke: .15px transparent;
    transform: translateZ(0);
    backface-visibility: hidden;
    will-change: transform;
  }

  button.bogos-fbt-footer-button-add {
    border-radius: var(--button-border-radius);
    font: var(--button-font);
    margin-top: 10px;
  }
</style>
<script>
(function() {
  function customizeBogosBundle() {
    const bundleView = document.getElementById('bogos-bundle-view');
    if (!bundleView) return;
    const items = bundleView.querySelectorAll('.bogos-bundle-item');
    items.forEach(item => {
      const titleEl = item.querySelector('.bogos-bundle-item-title');
      if (titleEl && (titleEl.textContent.includes('Badkamer deepclean') || titleEl.textContent.includes('(Gratis)'))) {
        const discountPriceEl = item.querySelector('.bogos-bundle-item-discount-price');
        const originalPriceEl = item.querySelector('.bogos-bundle-item-original-price');
        
        if (discountPriceEl && discountPriceEl.textContent.trim() !== 'Gratis') {
          discountPriceEl.textContent = 'Gratis';
        }
        if (originalPriceEl && originalPriceEl.style.display !== 'none') {
          originalPriceEl.style.display = 'none';
        }
      }
    });
  }

  // Run on custom event
  document.addEventListener("bogos:bundle-render", () => {
    setTimeout(customizeBogosBundle, 150);
  });

  // Also run MutationObserver to handle late loading/dynamic updates
  const observer = new MutationObserver((mutations) => {
    customizeBogosBundle();
  });

  // Start observing the document body for changes
  observer.observe(document.body, { childList: true, subtree: true });
})();
</script>