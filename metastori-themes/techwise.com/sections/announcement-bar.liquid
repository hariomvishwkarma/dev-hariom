{%- if section.blocks.size > 0 -%}
  <style>
    :root {
      --announcement-bar-is-sticky: {% if section.settings.enable_sticky %}1{% else %}0{% endif %};
    }

    {%- if section.settings.enable_sticky -%}
      #shopify-section-{{ section.id }} {
        position: sticky;
        top: 0;
        z-index: 100;
      }

      .shopify-section--header ~ #shopify-section-{{ section.id }} {
        top: calc(var(--header-is-sticky, 0) * var(--header-is-visible, 0) * var(--header-height, 0px));
      }
    {%- endif -%}

    /* === Typography controls (applies to both slide + marquee) === */
    #shopify-section-{{ section.id }} .announcement-bar .announcement-bar__message-list p,
    #shopify-section-{{ section.id }} .announcement-bar .announcement-bar__marquee-item p {
      font-size: {{ section.settings.font_size_desktop }}px;
      font-weight: {{ section.settings.font_weight }};
      letter-spacing: {{ section.settings.letter_spacing_desktop }}px;
      line-height: 1.3;
      margin: 0;
    }

    @media (max-width: 749px) {
      #shopify-section-{{ section.id }} .announcement-bar .announcement-bar__message-list p,
      #shopify-section-{{ section.id }} .announcement-bar .announcement-bar__marquee-item p {
        font-size: {{ section.settings.font_size_mobile }}px;
        letter-spacing: {{ section.settings.letter_spacing_mobile }}px;
      }
    }

    /* === Announcement bar inner layout (slide mode) === */
    #shopify-section-{{ section.id }} .announcement-bar__message-list > * {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 14px;
      flex-wrap: wrap;
      padding: 4px 12px;
    }

    /* === CTA Button === */
    .announcement-bar__cta-btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      padding: 5px 16px;
      border-radius: 999px;
      font-size: 13px;
      font-weight: 600;
      line-height: 1.4;
      letter-spacing: 0.02em;
      white-space: nowrap;
      text-decoration: none;
      border: none;
      cursor: pointer;
      transition: opacity 0.18s ease, transform 0.18s ease;
      flex-shrink: 0;
    }

    .announcement-bar__cta-btn:hover {
      opacity: 0.85;
      transform: scale(1.03);
    }

    .announcement-bar__cta-btn:active {
      transform: scale(0.97);
    }

    /* Mobile: inline text flow for slide mode — text + button on same line */
    @media (max-width: 749px) {
      #shopify-section-{{ section.id }} .announcement-bar__message-list > * {
        display: block;
        text-align: center;
        padding: 6px 12px;
      }
      #shopify-section-{{ section.id }} .announcement-bar__message-list p {
        display: inline;
      }
      #shopify-section-{{ section.id }} .announcement-bar__message-list .announcement-bar__cta-btn {
        display: inline-flex;
        vertical-align: middle;
        margin-left: 8px;
        font-size: 12px;
        padding: 4px 13px;
      }
    }

    /* ============================================================ */
    /* === MARQUEE MODE === */
    /* ============================================================ */
    .announcement-bar--marquee {
      display: block;
      width: 100%;
      overflow: hidden;
    }

    .announcement-bar__marquee-track {
      display: flex;
      width: max-content;
      will-change: transform;
      animation-name: announcement-bar-marquee;
      animation-timing-function: linear;
      animation-iteration-count: infinite;
    }

    .announcement-bar__marquee-unit,
    .announcement-bar__marquee-group {
      display: flex;
      align-items: center;
      flex-shrink: 0;
    }

    .announcement-bar__marquee-item {
      display: flex;
      align-items: center;
      gap: 14px;
      padding: 4px 28px;
      white-space: nowrap;
      flex-shrink: 0;
    }

    .announcement-bar__marquee-item p {
      white-space: nowrap;
      display: inline-block;
    }

    @media (max-width: 749px) {
      .announcement-bar__marquee-item {
        padding: 6px 20px;
      }
      .announcement-bar--marquee .announcement-bar__cta-btn {
        font-size: 12px;
        padding: 4px 13px;
      }
    }

    @keyframes announcement-bar-marquee {
      from { transform: translateX(0); }
      to   { transform: translateX(calc(var(--marquee-distance, 0px) * -1)); }
    }

    /* Respect users who prefer reduced motion */
    @media (prefers-reduced-motion: reduce) {
      .announcement-bar__marquee-track {
        animation: none !important;
        transform: none !important;
      }
    }

    /* === COUNTDOWN BLOCK === */
    #shopify-section-{{ section.id }} .announcement-bar__countdown-block {
      width: 100%;
      padding: 10px 16px;
      font-weight: 600;
      letter-spacing: 0.03em;
      box-sizing: border-box;
    }

    #shopify-section-{{ section.id }} .announcement-bar__countdown-inner {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 12px;
      flex-wrap: wrap;
      text-align: center;
    }

    #shopify-section-{{ section.id }} .announcement-bar__countdown-text {
      font: var(--subheading-font-style) var(--subheading-font-weight) var(--subheading-font-size) / normal var(--subheading-font-family) !important;
    }

    #shopify-section-{{ section.id }} .announcement-bar__countdown-badge {
      display: inline-flex;
      align-items: center;
      padding: 2px 10px;
      border-radius: 40px;
      font-weight: 600;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      min-width: 95px;
      justify-content: center;
      cursor: pointer;
      user-select: none;
      gap: 4px;
    }

    #shopify-section-{{ section.id }} .announcement-bar__countdown-badge-copy {
      opacity: 0.5;
      vertical-align: middle;
    }

    #shopify-section-{{ section.id }} .announcement-bar__countdown-badge-check {
      vertical-align: middle;
    }

    #shopify-section-{{ section.id }} .announcement-bar__countdown-timer {
      display: flex;
      align-items: center;
      gap: 4px;
    }

    #shopify-section-{{ section.id }} .announcement-bar__countdown-timer-block {
      display: flex;
      align-items: center;
      gap: 2px;
    }

    #shopify-section-{{ section.id }} .announcement-bar__countdown-timer-digits {
      font-variant-numeric: tabular-nums;
      font-weight: 600;
      font: var(--subheading-font-style) var(--subheading-font-weight) var(--subheading-font-size) / normal var(--subheading-font-family) !important;
      min-width: 22px;
      text-align: center;
    }

    #shopify-section-{{ section.id }} .announcement-bar__countdown-timer-label {
      font-weight: 600;
      font: var(--subheading-font-style) var(--subheading-font-weight) var(--subheading-font-size) / normal var(--subheading-font-family) !important;
      text-transform: uppercase;
      letter-spacing: 0.05em;
    }

    #shopify-section-{{ section.id }} .announcement-bar__countdown-timer-sep {
      font-weight: 600;
      margin: 0 1px;
      line-height: 1;
    }

    #shopify-section-{{ section.id }} .announcement-bar__countdown-text-group {
      display: inline;
      text-align: center;
    }

    #shopify-section-{{ section.id }} .announcement-bar__countdown-cta-btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      vertical-align: middle;
      padding: 5px 16px;
      border-radius: 999px;
      font-size: 13px;
      font-weight: 600;
      line-height: 1.4;
      letter-spacing: 0.02em;
      white-space: nowrap;
      text-decoration: none;
      border: none;
      cursor: pointer;
      flex-shrink: 0;
      margin-left: 8px;
      transition: opacity 0.18s ease, transform 0.18s ease;
    }

    #shopify-section-{{ section.id }} .announcement-bar__countdown-cta-btn:hover {
      opacity: 0.85;
      transform: scale(1.03);
    }

    #shopify-section-{{ section.id }} .announcement-bar__countdown-cta-btn:active {
      transform: scale(0.97);
    }

    #shopify-section-{{ section.id }} .announcement-bar__countdown-block--marquee {
      width: auto;
      padding: 0;
      font-weight: inherit;
      letter-spacing: inherit;
      background: transparent;
    }

    #shopify-section-{{ section.id }} .announcement-bar__countdown-block--marquee .announcement-bar__countdown-inner {
      flex-wrap: nowrap;
      white-space: nowrap;
      gap: 14px;
    }

    #shopify-section-{{ section.id }} .announcement-bar__marquee-item--countdown {
      padding: 4px 28px;
    }

    #shopify-section-{{ section.id }} .announcement-bar__message-list > .announcement-bar__countdown-block {
      display: flex;
      align-items: center;
      justify-content: center;
      flex-wrap: wrap;
      gap: 14px;
      padding: 4px 12px;
      grid-area: 1 / -1;
    }

    @media (max-width: 749px) {
      #shopify-section-{{ section.id }} .announcement-bar__countdown-cta-btn {
        font-size: 12px;
        padding: 4px 13px;
        margin-left: 6px;
      }

      #shopify-section-{{ section.id }} .announcement-bar__countdown-inner {
        gap: 8px;
      }

      #shopify-section-{{ section.id }} .announcement-bar__message-list > .announcement-bar__countdown-block {
        display: block;
        text-align: center;
        padding: 6px 12px;
      }

      #shopify-section-{{ section.id }} .announcement-bar__marquee-item--countdown {
        padding: 6px 20px;
      }

      #shopify-section-{{ section.id }} .announcement-bar__countdown-block--marquee .announcement-bar__countdown-inner {
        gap: 10px;
      }
    }
  </style>

  {%- liquid
    assign visible_block_count = 0
    assign has_countdown_blocks = false

    for block in section.blocks
      if block.type == 'message' and block.settings.text != blank
        assign visible_block_count = visible_block_count | plus: 1
      elsif block.type == 'countdown'
        assign visible_block_count = visible_block_count | plus: 1
        assign has_countdown_blocks = true
      endif
    endfor
  -%}

  <div class="color-scheme color-scheme--{{ section.settings.color_scheme.id }}">
    <height-observer variable="announcement-bar">
      {%- if section.settings.display_mode == 'marquee' -%}
        {%- if visible_block_count > 0 -%}
        {%- comment -%} ===================== MARQUEE MODE ===================== {%- endcomment -%}
        {%- assign marquee_id = 'marquee-' | append: section.id -%}

        <announcement-marquee
          id="{{ marquee_id }}"
          class="announcement-bar announcement-bar--marquee"
          data-speed="{{ section.settings.marquee_speed }}"
          data-direction="{{ section.settings.marquee_direction }}"
          data-section-id="{{ section.id }}"
          {% if section.settings.marquee_pause_on_hover %}data-pause-hover="true"{% endif %}
        >
          <div class="announcement-bar__marquee-track">
            <div class="announcement-bar__marquee-group">
              {%- for block in section.blocks -%}
                {%- if block.type == 'message' and block.settings.text != blank -%}
                  <div class="announcement-bar__marquee-item" {{ block.shopify_attributes }}>
                    <p class="subheading subheading-xs">{{ block.settings.text }}</p>

                    {%- if block.settings.button_label != blank -%}
                      <a
                        href="{{ block.settings.button_link | default: '#' }}"
                        class="announcement-bar__cta-btn"
                        style="background-color: {{ block.settings.button_bg_color }}; color: {{ block.settings.button_text_color }};"
                        {% if block.settings.button_link contains 'http' %}target="_blank" rel="noopener"{% endif %}
                      >
                        {{- block.settings.button_label -}}
                      </a>
                    {%- endif -%}
                  </div>
                {%- elsif block.type == 'countdown' -%}
                  <div class="announcement-bar__marquee-item announcement-bar__marquee-item--countdown" {{ block.shopify_attributes }}>
                    {%- render 'announcement-countdown-block', block: block, section_id: section.id, marquee: true -%}
                  </div>
                {%- endif -%}
              {%- endfor -%}
            </div>
          </div>
        </announcement-marquee>
        {%- endif -%}

      {%- else -%}
        {%- comment -%} ===================== SLIDE / ROTATE MODE (original) ===================== {%- endcomment -%}
        {%- assign carousel_id = 'carousel-' | append: section.id -%}
        {%- assign first_visible_selected = false -%}

        <announcement-bar id="{{ carousel_id }}" allow-swipe cell-selector=".announcement-bar__message-list > *" {% if section.settings.autoplay %}autoplay="{{ section.settings.cycle_speed }}"{% endif %} class="announcement-bar">
          {%- if visible_block_count > 1 -%}
            <carousel-prev-button aria-controls="{{ carousel_id }}">
              <button type="button" class="tap-area">
                <span class="sr-only">{{ 'general.accessibility.previous' | t }}</span>
                {%- render 'icon' with 'arrow-left', direction_aware: true -%}
              </button>
            </carousel-prev-button>
          {%- endif -%}

          <div class="announcement-bar__message-list">
            {%- for block in section.blocks -%}
              {%- if block.type == 'message' and block.settings.text != blank -%}
                {%- liquid
                  assign is_selected = false
                  unless first_visible_selected
                    assign is_selected = true
                    assign first_visible_selected = true
                  endunless
                -%}
                <div class="{% if is_selected %}is-selected{% endif %} prose prose-justify-center" {{ block.shopify_attributes }}>
                  <p class="subheading subheading-xs">{{ block.settings.text }}</p>

                  {%- if block.settings.button_label != blank -%}
                    <a
                      href="{{ block.settings.button_link | default: '#' }}"
                      class="announcement-bar__cta-btn"
                      style="background-color: {{ block.settings.button_bg_color }}; color: {{ block.settings.button_text_color }};"
                      {% if block.settings.button_link contains 'http' %}target="_blank" rel="noopener"{% endif %}
                    >
                      {{- block.settings.button_label -}}
                    </a>
                  {%- endif -%}
                </div>
              {%- elsif block.type == 'countdown' -%}
                {%- liquid
                  assign is_selected = false
                  unless first_visible_selected
                    assign is_selected = true
                    assign first_visible_selected = true
                  endunless
                -%}
                {%- render 'announcement-countdown-block',
                  block: block,
                  section_id: section.id,
                  is_selected: is_selected
                -%}
              {%- endif -%}
            {%- endfor -%}
          </div>

          {%- if visible_block_count > 1 -%}
            <carousel-next-button aria-controls="{{ carousel_id }}">
              <button type="button" class="tap-area">
                <span class="sr-only">{{ 'general.accessibility.next' | t }}</span>
                {%- render 'icon' with 'arrow-right', direction_aware: true -%}
              </button>
            </carousel-next-button>
          {%- endif -%}
        </announcement-bar>
      {%- endif -%}
    </height-observer>
  </div>

  {%- if section.settings.display_mode == 'marquee' -%}
    <script>
      (function () {
        if (customElements.get('announcement-marquee')) return;

        customElements.define('announcement-marquee', class extends HTMLElement {
          connectedCallback() {
            this.track = this.querySelector('.announcement-bar__marquee-track');
            if (!this.track) return;

            this.originalGroup = this.track.querySelector('.announcement-bar__marquee-group');
            this._originalHTML = this.originalGroup ? this.originalGroup.innerHTML : '';
            this.speed = parseFloat(this.dataset.speed) || 50; // pixels per second
            this.direction = this.dataset.direction === 'right' ? 'right' : 'left';
            this._build = this._build.bind(this);

            // Build once layout is ready, and again after web fonts load
            requestAnimationFrame(this._build);
            if (document.fonts && document.fonts.ready) {
              document.fonts.ready.then(this._build);
            }

            // Rebuild on resize so it always fills the screen with no gaps
            if ('ResizeObserver' in window) {
              this._ro = new ResizeObserver(() => this._debouncedBuild());
              this._ro.observe(this);
            } else {
              window.addEventListener('resize', () => this._debouncedBuild());
            }

            // Optional pause on hover
            if (this.dataset.pauseHover === 'true') {
              this.addEventListener('mouseenter', () => { this.track.style.animationPlayState = 'paused'; });
              this.addEventListener('mouseleave', () => { this.track.style.animationPlayState = 'running'; });
            }
          }

          disconnectedCallback() {
            if (this._ro) this._ro.disconnect();
          }

          _debouncedBuild() {
            clearTimeout(this._t);
            this._t = setTimeout(this._build, 150);
          }

          _makeGroup() {
            const g = document.createElement('div');
            g.className = 'announcement-bar__marquee-group';
            g.innerHTML = this._originalHTML;
            return g;
          }

          _build() {
            if (!this.track || !this._originalHTML) return;

            // Reset the track
            this.track.style.animation = 'none';
            this.track.innerHTML = '';

            const containerWidth = this.offsetWidth || window.innerWidth || 0;

            // Build one "unit": repeat the message group until it's at least
            // as wide as the bar, so the loop never shows an empty gap.
            const unit = document.createElement('div');
            unit.className = 'announcement-bar__marquee-unit';
            this.track.appendChild(unit);

            let guard = 0;
            do {
              unit.appendChild(this._makeGroup());
              guard++;
            } while (unit.offsetWidth < containerWidth && guard < 60);

            const unitWidth = unit.offsetWidth;
            if (unitWidth === 0) return; // hidden — ResizeObserver will retry

            // Duplicate the unit once so translateX(-unitWidth) loops seamlessly
            const clone = unit.cloneNode(true);
            clone.setAttribute('aria-hidden', 'true');
            this.track.appendChild(clone);

            // Constant speed regardless of how much text there is
            const duration = unitWidth / this.speed;

            this.track.style.setProperty('--marquee-distance', unitWidth + 'px');
            // Re-trigger the animation cleanly
            this.track.style.animation = '';
            this.track.style.animationName = 'announcement-bar-marquee';
            this.track.style.animationTimingFunction = 'linear';
            this.track.style.animationIterationCount = 'infinite';
            this.track.style.animationDuration = duration + 's';
            this.track.style.animationDirection = this.direction === 'right' ? 'reverse' : 'normal';

            const heightObserver = this.closest('height-observer');
            if (heightObserver) {
              requestAnimationFrame(() => {
                const height = heightObserver.getBoundingClientRect().height;
                document.documentElement.style.setProperty('--announcement-bar-height', `${height.toFixed(2)}px`);
              });
            }

            const sectionId = this.dataset.sectionId;
            if (sectionId) {
              document.getElementById(`shopify-section-${sectionId}`)?.dispatchEvent(new CustomEvent('announcement-bar:marquee-built', { bubbles: true }));
            }
          }
        });
      })();
    </script>
  {%- endif -%}

  {%- if has_countdown_blocks -%}
    <script>
      (function () {
        const sectionRoot = document.getElementById('shopify-section-{{ section.id }}');
        if (!sectionRoot) return;

        function pad(value) {
          return value < 10 ? '0' + value : String(value);
        }

        function getNextCycleEndTime(rollingDays) {
          const periodMs = rollingDays * 24 * 60 * 60 * 1000;
          const referenceTime = new Date('2025-01-01T00:00:00').getTime();
          const elapsed = Date.now() - referenceTime;
          const cycles = Math.floor(elapsed / periodMs);
          return referenceTime + (cycles + 1) * periodMs;
        }

        const initializedBlockIds = new Set();
        const countdownIntervals = new Map();

        function getBlockElements(blockId) {
          return sectionRoot.querySelectorAll(`[data-announcement-countdown][data-block-id="${blockId}"]`);
        }

        function initCountdownBlock(blockEl) {
          if (blockEl.closest('[aria-hidden="true"]')) return;

          const blockId = blockEl.dataset.blockId;
          if (!blockId || initializedBlockIds.has(blockId)) return;
          initializedBlockIds.add(blockId);

          const blockElements = getBlockElements(blockId);

          blockElements.forEach(function (element) {
            const redirectUrl = element.dataset.redirectUrl;
            if (!redirectUrl) return;

            element.addEventListener('click', function (event) {
              if (event.target.closest('.announcement-bar__countdown-badge')) return;
              const openInNewTab = element.dataset.redirectNewTab === 'true';
              openInNewTab ? window.open(redirectUrl, '_blank') : (window.location.href = redirectUrl);
            });
          });

          blockElements.forEach(function (element) {
            const badgeEl = element.querySelector('.announcement-bar__countdown-badge');
            if (!badgeEl) return;

            badgeEl.addEventListener('click', function (event) {
              event.stopPropagation();
              const labelEl = badgeEl.querySelector('.announcement-bar__countdown-badge-label');
              const originalText = labelEl.textContent.trim();
              const copiedText = element.dataset.copiedText || 'Copied!';

              if (badgeEl.dataset.copying === '1') return;
              badgeEl.dataset.copying = '1';

              const copyIcon = badgeEl.querySelector('.announcement-bar__countdown-badge-copy');
              const checkIcon = badgeEl.querySelector('.announcement-bar__countdown-badge-check');

              function onSuccess() {
                if (copyIcon) copyIcon.hidden = true;
                if (checkIcon) checkIcon.hidden = false;
                labelEl.textContent = copiedText;
                setTimeout(function () {
                  if (copyIcon) copyIcon.hidden = false;
                  if (checkIcon) checkIcon.hidden = true;
                  labelEl.textContent = originalText;
                  badgeEl.dataset.copying = '0';
                }, 1800);
              }

              if (navigator.clipboard && window.isSecureContext) {
                navigator.clipboard.writeText(originalText).then(onSuccess).catch(fallbackCopy);
              } else {
                fallbackCopy();
              }

              function fallbackCopy() {
                const textarea = document.createElement('textarea');
                textarea.value = originalText;
                textarea.style.cssText = 'position:fixed;top:0;left:0;opacity:0;pointer-events:none;';
                document.body.appendChild(textarea);
                textarea.focus();
                textarea.select();
                try { document.execCommand('copy'); } catch (error) {}
                document.body.removeChild(textarea);
                onSuccess();
              }
            });
          });

          const timerEl = blockEl.querySelector('[data-timer]');
          if (!timerEl) return;

          const showDays = blockEl.dataset.showDays === 'true';
          const rollingDays = parseInt(blockEl.dataset.rollingDays, 10) || 3;
          let endTime = getNextCycleEndTime(rollingDays);

          function tick() {
            let remaining = endTime - Date.now();
            if (remaining <= 0) {
              endTime = getNextCycleEndTime(rollingDays);
              remaining = endTime - Date.now();
            }

            const totalSeconds = Math.floor(remaining / 1000);
            const days = Math.floor(totalSeconds / 86400);
            const hours = Math.floor((totalSeconds % 86400) / 3600);
            const minutes = Math.floor((totalSeconds % 3600) / 60);
            const seconds = totalSeconds % 60;

            blockElements.forEach(function (element) {
              const timer = element.querySelector('[data-timer]');
              if (!timer) return;

              const daysBlock = timer.querySelector('[data-days-block]');
              const daysSep = timer.querySelector('[data-days-sep]');
              const daysEl = timer.querySelector('[data-days]');
              const hoursEl = timer.querySelector('[data-hours]');
              const minutesEl = timer.querySelector('[data-minutes]');
              const secondsEl = timer.querySelector('[data-seconds]');

              if (showDays && days > 0) {
                if (daysEl) daysEl.textContent = pad(days);
                if (daysBlock) daysBlock.hidden = false;
                if (daysSep) daysSep.hidden = false;
                if (hoursEl) hoursEl.textContent = pad(hours);
              } else {
                if (daysBlock) daysBlock.hidden = true;
                if (daysSep) daysSep.hidden = true;
                if (hoursEl) hoursEl.textContent = pad(days * 24 + hours);
              }

              if (minutesEl) minutesEl.textContent = pad(minutes);
              if (secondsEl) secondsEl.textContent = pad(seconds);
            });
          }

          tick();
          countdownIntervals.set(blockId, setInterval(tick, 1000));
        }

        function initAllCountdownBlocks() {
          countdownIntervals.forEach(function (intervalId) {
            clearInterval(intervalId);
          });
          countdownIntervals.clear();
          initializedBlockIds.clear();
          sectionRoot.querySelectorAll('[data-announcement-countdown]').forEach(initCountdownBlock);
        }

        initAllCountdownBlocks();
        sectionRoot.addEventListener('announcement-bar:marquee-built', initAllCountdownBlocks);
        document.addEventListener('shopify:section:load', function (event) {
          if (event.target === sectionRoot) initAllCountdownBlocks();
        });
      })();
    </script>
  {%- endif -%}
{%- endif -%}

