{%- if section.settings.secondary_media_shape contains 'blob' -%}
  {{- 'clip-blob.css' | asset_url | stylesheet_tag -}}
{%- endif -%}

{%- liquid
  case section.settings.primary_media_aspect_ratio
    when 'square'
      assign primary_media_aspect_ratio_value = '1 / 1'
    when 'portrait'
      assign primary_media_aspect_ratio_value = '3 / 4'
    when 'landscape'
      assign primary_media_aspect_ratio_value = '16 / 11'
  endcase
-%}

<style>
  #shopify-section-{{ section.id }} {
    {%- if section.settings.content_position == 'start' -%}
      --section-split-grid-template-columns: minmax(0, {{ 100 | minus: section.settings.content_percentage_width | divided_by: 100.0 }}fr) minmax(0, {{ section.settings.content_percentage_width | divided_by: 100.0 }}fr);
    {%- else -%}
      --section-split-grid-template-columns: minmax(0, {{ section.settings.content_percentage_width | divided_by: 100.0 }}fr) minmax(0, {{ 100 | minus: section.settings.content_percentage_width | divided_by: 100.0 }}fr);
    {%- endif -%}
  }

  #shopify-section-{{ section.id }} + .shopify-section {
    --section-enable-padding-collapsing: 0; /* We turn off the padding collapsing on next section */
  }

  #shopify-section-{{ section.id }} .section-split__column--image .content-box__background-media {
    border-radius: {{ section.settings.primary_media_radius }}px;
    overflow: hidden;
  }

  {%- if primary_media_aspect_ratio_value -%}
    #shopify-section-{{ section.id }} .section-split__column--image .content-box {
      aspect-ratio: {{ primary_media_aspect_ratio_value }};
    }
  {%- endif -%}

  #shopify-section-{{ section.id }} .text-media-badge-list {
    display: flex;
    flex-wrap: wrap;
    gap: .75rem;
  }

  #shopify-section-{{ section.id }} .text-media-badge {
    display: inline-flex;
    align-items: center;
    gap: .5rem;
    padding: .5rem 1rem;
    border: 1px solid rgb(var(--border-color));
    border-radius: 999px;
    font-size: .875rem;
    line-height: 1;
    background: white;
  }

  #shopify-section-{{ section.id }} .text-media-badge .icon {
    flex-shrink: 0;
    margin: 0;
  }
  .text-media-badge-list {
    {% comment %} margin-top: 20px; {% endcomment %}
  }
  {% comment %} .shopify-section--text-with-media .section-split__column {
    padding-left: 20px !important;
    padding-right: 20px !important;
    padding-top: 20px !important;
  } {% endcomment %}
  .shopify-section--text-with-media .content-box.min-h-full {
    max-width: 38rem;
    margin: 0 auto;
  }

  #shopify-section-{{ section.id }} .content-richtext-wrapper.is-clamped {
    overflow: hidden;
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: var(--show-more-lines, 1);
  }

  #shopify-section-{{ section.id }} .content-toggle {
    cursor: pointer;
    font-weight: 600;
    display: none;
    width: fit-content;
    margin-top: 5px;
    background: rgb(219, 225, 169, 1);
    padding: 6px 7px;
    font-size: 14px;
    line-height: 1;
  }

  #shopify-section-{{ section.id }} .content-toggle.is-visible {
    display: block;
  }

  @media (max-width: 767px) {
    #shopify-section-{{ section.id }} .content-richtext-wrapper[data-show-more-device="desktop"].is-clamped {
      -webkit-line-clamp: unset;
      display: block;
      overflow: visible;
    }

    #shopify-section-{{ section.id }} .content-toggle[data-show-more-device="desktop"] {
      display: none !important;
    }
  }

  @media (min-width: 768px) {
    #shopify-section-{{ section.id }} .content-richtext-wrapper[data-show-more-device="mobile"].is-clamped {
      -webkit-line-clamp: unset;
      display: block;
      overflow: visible;
    }

    #shopify-section-{{ section.id }} .content-toggle[data-show-more-device="mobile"] {
      display: none !important;
    }
  }
</style>

<div class="color-scheme color-scheme--{{ section.settings.color_scheme.id }}">
  <div class="section-split {% if section.settings.content_position == 'end' %}section-split--reverse{% endif %}">
    {%- comment -%}
    IMAGE PART
    {%- endcomment -%}

    <div class="section-split__column section-split__column--image {% unless section.settings.add_media_spacing %}section-split__column--flushed{% endunless %}">
      <div class="content-box {% if primary_media_aspect_ratio_value == blank %}h-full{% endif %}">
        <div class="content-box__background-media">
          {%- liquid
            if section.settings.primary_video != blank
              assign show_controls = true

              if section.settings.autoplay_video
                assign show_controls = false
              endif

              render 'media', media: section.settings.primary_video, autoplay: section.settings.autoplay_video, loop: section.settings.autoplay_video, controls: show_controls
            elsif section.settings.primary_image != blank
              echo section.settings.primary_image | image_url: width: section.settings.primary_image.width | image_tag: sizes: '(max-width: 699px) 100vw, 50vw', widths: '200,300,400,500,600,800,1000,1200,1400,1600,1800,2000'
            elsif section.settings.secondary_image == blank and section.settings.secondary_video == blank
              echo 'blog-apparel-2' | placeholder_svg_tag: 'size-full'
            endif
          -%}
        </div>

        {%- if section.settings.secondary_image != blank or section.settings.secondary_video != blank -%}
          {%- capture media_style -%}--image-mobile-max-width: {{ section.settings.secondary_media_mobile_width }}%; --image-max-width: {{ section.settings.secondary_media_width }}%{%- endcapture -%}
          {%- capture media_class -%}{{ section.settings.secondary_media_alignment }} constrained-image clip-{{ section.settings.secondary_media_shape }} {% if section.settings.secondary_media_shape == 'circle' %}aspect-square{% endif %} {% unless section.settings.show_secondary_media_on_mobile %}sm-max:hidden{% endunless %}{%- endcapture -%}

          {%- if section.settings.secondary_video != blank -%}
            {%- render 'media', media: section.settings.secondary_video, autoplay: true, loop: true, class: media_class, style: media_style -%}
          {%- else -%}
            {{- section.settings.secondary_image | image_url: width: section.settings.secondary_image.width | image_tag: sizes: '(max-width: 699px) 275px, 400px', widths: '200,300,400,500,600,800,1000,1200', class: media_class, style: media_style -}}
          {%- endif -%}
        {%- endif -%}
      </div>
    </div>
    
    {%- comment -%}
    CONTENT PART
    {%- endcomment -%}

    {%- liquid
      assign top_left_content = ''
      assign top_center_content = ''
      assign top_right_content = ''
      assign middle_left_content = ''
      assign middle_center_content = ''
      assign middle_right_content = ''
      assign bottom_left_content = ''
      assign bottom_center_content = ''
      assign bottom_right_content = ''
      assign all_content = ''
      assign toggle_add = false
    -%}

    {%- if section.blocks.size > 0 -%}
      {%- for block in section.blocks -%}
        {%- capture block_content -%}
          {%- case block.type -%}
            {%- when 'subheading' -%}
              {%- render 'subheading', content: block.settings.text, block: block -%}

            {%- when 'heading' -%}
              {%- render 'heading', 
                content: block.settings.text, 
                highlight_effect: block.settings.highlight_effect, 
                highlight_accent_color: block.settings.highlight_accent_color, 
                highlight_text_color: block.settings.highlight_text_color, 
                style: block.settings.heading_tag,
                block: block 
              -%}

            {%- when 'button' -%}
              {%- render 'button', 
                content: block.settings.text,
                href: block.settings.url,
                style: block.settings.style,
                background: block.settings.background,
                text_color: block.settings.text_color,
                block: block
              -%}
            {%- when 'trustpilot' -%}
              
              {% render 'trustpilot-badge', block: block %}

            {%- when 'icon' -%}
              {%- if block.settings.image != blank -%}
                {%- render 'icon', image: block.settings.image, width: block.settings.icon_width, mobile_width: block.settings.mobile_icon_width, block: block -%}
              {%- else -%}
                {%- render 'icon' with block.settings.icon, width: block.settings.icon_width, mobile_width: block.settings.mobile_icon_width, stroke_width: block.settings.icon_stroke_width, block: block -%}
              {%- endif -%}

            {%- when 'richtext' -%}
              {%- if block.settings.text != blank -%}
                {%- if block.settings.enable_show_more -%}
                  {%- liquid
                    assign toggle_add = true
                    assign show_more_label = block.settings.show_more_text | default: 'Show more'
                    assign show_less_label = block.settings.show_less_text | default: 'Show less'
                  -%}
                  <div
                    class="max-w-sm content-richtext-wrapper"
                    data-id="text-media-{{ block.id }}"
                    data-show-more-device="{{ block.settings.show_more_device }}"
                    data-show-more-lines="{{ block.settings.show_more_lines }}"
                    data-show-more-text="{{ show_more_label | escape }}"
                    data-show-less-text="{{ show_less_label | escape }}"
                    style="--show-more-lines: {{ block.settings.show_more_lines }};"
                    {{ block.shopify_attributes }}
                  >
                    {{- block.settings.text -}}
                  </div>
                  <span
                    class="content-toggle"
                    data-id="text-media-{{ block.id }}"
                    data-show-more-device="{{ block.settings.show_more_device }}"
                    data-show-more-text="{{ show_more_label | escape }}"
                    data-show-less-text="{{ show_less_label | escape }}"
                    hidden
                  >
                    {{- show_more_label -}}
                  </span>
                {%- else -%}
                  <div class="max-w-sm" {{ block.shopify_attributes }}>
                    {{- block.settings.text -}}
                  </div>
                {%- endif -%}
              {%- endif -%}

            {%- when 'badge_list' -%}
              <div class="text-media-badge-list" {{ block.shopify_attributes }}>
                {%- for i in (1..6) -%}
                  {%- assign badge_text_key = 'text_' | append: i -%}
                  {%- assign badge_text = block.settings[badge_text_key] -%}

                  {%- if badge_text != blank -%}
                    <span class="text-media-badge">
                      {%- render 'icon' with block.settings.icon, width: 14, mobile_width: 14 -%}
                      <span>{{ badge_text }}</span>
                    </span>
                  {%- endif -%}
                {%- endfor -%}
              </div>
          {%- endcase -%}
        {%- endcapture -%}

        {%- case block.settings.position -%}
          {%- when 'top_left' -%}
            {% assign top_left_content = top_left_content | append: block_content %}
          {%- when 'top_center' -%}
            {% assign top_center_content = top_center_content | append: block_content %}
          {%- when 'top_right' -%}
            {% assign top_right_content = top_right_content | append: block_content %}
          {%- when 'middle_left' -%}
            {% assign middle_left_content = middle_left_content | append: block_content %}
          {%- when 'middle_center' -%}
            {% assign middle_center_content = middle_center_content | append: block_content %}
          {%- when 'middle_right' -%}
            {% assign middle_right_content = middle_right_content | append: block_content %}
          {%- when 'bottom_left' -%}
            {% assign bottom_left_content = bottom_left_content | append: block_content %}
          {%- when 'bottom_center' -%}
            {% assign bottom_center_content = bottom_center_content | append: block_content %}
          {%- when 'bottom_right' -%}
            {% assign bottom_right_content = bottom_right_content | append: block_content %}
        {%- endcase -%}

        {%- assign all_content = all_content | append: block_content -%}
      {%- endfor -%}

      <div class="section-split__column {%- if section.settings.content_image_background != blank -%}section-split__column--flushed{% endif %} align-self-stretch">
        <div class="content-box min-h-full">
          {%- if section.settings.content_image_background != blank -%}
            <div class="content-box__background-media with-overlay" style="--overlay: {{ section.settings.overlay_color.rgb }} / {{ section.settings.overlay_opacity | divided_by: 100.0 }}">
              {{- section.settings.content_image_background | image_url: width: section.settings.content_image_background.width | image_tag: sizes: '(max-width: 699px) 100vw, 50vw', widths: '200,300,400,500,600,800,1000,1200,1400,1600,1800,2000' -}}
            </div>
          {%- endif -%}

          <div class="placement-grid {% unless section.settings.content_image_background %}span-full{% endunless %}">
            {% if top_left_content != blank %}
              <div class="place-self-start prose prose-justify-start">
                {{- top_left_content -}}
              </div>
            {%- endif -%}
      
            {% if top_center_content != blank %}
              <div class="place-self-start-center prose prose-justify-center">
                {{- top_center_content -}}
              </div>
            {%- endif -%}
      
            {% if top_right_content != blank %}
              <div class="place-self-start-end prose prose-justify-end">
                {{- top_right_content -}}
              </div>
            {%- endif -%}
      
            {% if middle_left_content != blank %}
              <div class="place-self-center-start prose prose-justify-start">
                {{- middle_left_content -}}
              </div>
            {%- endif -%}
      
            {% if middle_center_content != blank %}
              <div class="place-self-center prose prose-justify-center">
                {{- middle_center_content -}}
              </div>
            {%- endif -%}
      
            {% if middle_right_content != blank %}
              <div class="place-self-center-end prose prose-justify-end">
                {{- middle_right_content -}}
              </div>
            {%- endif -%}
      
            {% if bottom_left_content != blank %}
              <div class="place-self-end-start prose prose-justify-start">
                {{- bottom_left_content -}}
              </div>
            {%- endif -%}
      
            {% if bottom_center_content != blank %}
              <div class="place-self-end-center prose prose-justify-center">
                {{- bottom_center_content -}}
              </div>
            {%- endif -%}
      
            {% if bottom_right_content != blank %}
              <div class="place-self-end prose prose-justify-end">
                {{- bottom_right_content -}}
              </div>
            {%- endif -%}
          </div>
        </div>
      </div>
    {%- endif -%}
  </div>
</div>

{% if toggle_add %}
<script>
document.addEventListener('DOMContentLoaded', () => {
  const section = document.getElementById('shopify-section-{{ section.id }}');
  if (!section) return;

  const isMobile = () => window.innerWidth < 768;

  const isDeviceActive = (device) => {
    if (device === 'mobile') return isMobile();
    if (device === 'desktop') return !isMobile();
    return true;
  };

  const setupToggle = (wrapper) => {
    const dataId = wrapper.getAttribute('data-id');
    const button = section.querySelector(`.content-toggle[data-id="${dataId}"]`);
    if (!button) return;

    const device = wrapper.getAttribute('data-show-more-device') || 'both';
    const lines = parseInt(wrapper.getAttribute('data-show-more-lines') || '1', 10);
    const showMoreText = wrapper.getAttribute('data-show-more-text') || button.getAttribute('data-show-more-text') || 'Show more';
    const showLessText = wrapper.getAttribute('data-show-less-text') || button.getAttribute('data-show-less-text') || 'Show less';

    const reset = () => {
      wrapper.classList.remove('is-clamped');
      button.classList.remove('is-visible');
      button.hidden = true;
      button.textContent = showMoreText;
    };

    const apply = () => {
      reset();

      if (!isDeviceActive(device)) return;

      const lineHeight = parseFloat(getComputedStyle(wrapper).lineHeight);
      const actualLineHeight = isNaN(lineHeight)
        ? parseFloat(getComputedStyle(wrapper).fontSize) * 1.2
        : lineHeight;
      const maxHeight = actualLineHeight * lines;

      if (wrapper.scrollHeight > maxHeight + 2) {
        wrapper.classList.add('is-clamped');
        button.hidden = false;
        button.classList.add('is-visible');
      }
    };

    if (!button.dataset.bound) {
      button.dataset.bound = 'true';
      button.addEventListener('click', () => {
        const expanded = wrapper.classList.toggle('is-clamped');
        button.textContent = expanded ? showMoreText : showLessText;
      });
    }

    apply();
    return apply;
  };

  const applyFns = [];
  section.querySelectorAll('.content-richtext-wrapper[data-id]').forEach((wrapper) => {
    applyFns.push(setupToggle(wrapper));
  });

  let resizeTimer;
  window.addEventListener('resize', () => {
    clearTimeout(resizeTimer);
    resizeTimer = setTimeout(() => {
      applyFns.forEach((fn) => fn && fn());
    }, 150);
  });
});
</script>
{% endif %}

{% schema %}
{
  "name": "t:sections.text_with_media.name",
  "class": "shopify-section--text-with-media",
  "max_blocks": 5,
  "disabled_on": {
    "groups": ["header", "custom.overlay"]
  },
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:global.colors.scheme",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "t:sections.text_with_media.content_category"
    },
    {
      "type": "select",
      "id": "content_position",
      "label": "t:global.position.position",
      "options": [
        {
          "value": "start",
          "label": "t:global.position.left"
        },
        {
          "value": "end",
          "label": "t:global.position.right"
        }
      ],
      "default": "start"
    },
    {
      "type": "range",
      "min": 40,
      "max": 60,
      "step": 5,
      "unit": "%",
      "id": "content_percentage_width",
      "label": "t:sections.text_with_media.content_percentage_width",
      "default": 50
    },
    {
      "type": "image_picker",
      "id": "content_image_background",
      "label": "t:global.image.background_image",
      "info": "t:sections.text_with_media.content_background_image_size_recommendations"
    },
    {
      "type": "color",
      "id": "overlay_color",
      "label": "t:global.colors.image_overlay_color",
      "default": "#000000"
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "label": "t:global.colors.image_overlay_opacity",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 20
    },
    {
      "type": "header",
      "content": "t:sections.text_with_media.media_category",
      "info": "t:sections.text_with_media.media_category_info"
    },
    {
      "type": "checkbox",
      "id": "add_media_spacing",
      "label": "t:sections.text_with_media.add_media_spacing",
      "default": false
    },
    {
      "type": "select",
      "id": "primary_media_aspect_ratio",
      "label": "Primary media aspect ratio",
      "options": [
        {
          "value": "auto",
          "label": "Auto"
        },
        {
          "value": "landscape",
          "label": "Landscape"
        },
        {
          "value": "portrait",
          "label": "Portrait"
        },
        {
          "value": "square",
          "label": "Square"
        }
      ],
      "default": "auto"
    },
    {
      "type": "range",
      "id": "primary_media_radius",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "label": "Primary media corner radius",
      "default": 0
    },
    {
      "type": "checkbox",
      "id": "autoplay_video",
      "label": "t:global.video.autoplay",
      "info": "t:global.video.autoplay_info",
      "default": true
    },
    {
      "type": "image_picker",
      "id": "primary_image",
      "label": "t:sections.text_with_media.primary_image",
      "info": "t:sections.text_with_media.primary_image_size_recommendations"
    },
    {
      "type": "video",
      "id": "primary_video",
      "label": "t:sections.text_with_media.primary_video"
    },
    {
      "type": "image_picker",
      "id": "secondary_image",
      "label": "t:sections.text_with_media.secondary_image",
      "info": "t:sections.text_with_media.secondary_image_size_recommendations"
    },
    {
      "type": "video",
      "id": "secondary_video",
      "label": "t:sections.text_with_media.secondary_video"
    },
    {
      "type": "range",
      "min": 20,
      "max": 80,
      "step": 5,
      "unit": "%",
      "id": "secondary_media_width",
      "label": "t:sections.text_with_media.secondary_media_width",
      "default": 60
    },
    {
      "type": "range",
      "min": 20,
      "max": 80,
      "step": 5,
      "unit": "%",
      "id": "secondary_media_mobile_width",
      "label": "t:sections.text_with_media.secondary_media_mobile_width",
      "default": 60
    },
    {
      "type": "checkbox",
      "id": "show_secondary_media_on_mobile",
      "label": "t:sections.text_with_media.show_secondary_media_on_mobile",
      "default": true
    },
    {
      "type": "select",
      "id": "secondary_media_alignment",
      "label": "t:sections.text_with_media.secondary_media_alignment",
      "options": [
        {
          "value": "place-self-start",
          "label": "t:global.position.top_left"
        },
        {
          "value": "place-self-start-center",
          "label": "t:global.position.top_center"
        },
        {
          "value": "place-self-start-end",
          "label": "t:global.position.top_right"
        },
        {
          "value": "place-self-center-start",
          "label": "t:global.position.middle_left"
        },
        {
          "value": "place-self-center",
          "label": "t:global.position.middle_center"
        },
        {
          "value": "place-self-center-end",
          "label": "t:global.position.middle_right"
        },
        {
          "value": "place-self-end-start",
          "label": "t:global.position.bottom_left"
        },
        {
          "value": "place-self-end-center",
          "label": "t:global.position.bottom_center"
        },
        {
          "value": "place-self-end",
          "label": "t:global.position.bottom_right"
        }
      ],
      "default": "place-self-center"
    },
    {
      "type": "select",
      "id": "secondary_media_shape",
      "label": "t:sections.text_with_media.secondary_media_shape",
      "options": [
        {
          "value": "none",
          "label": "t:sections.text_with_media.secondary_media_shape_options.none"
        },
        {
          "value": "circle",
          "label": "t:sections.text_with_media.secondary_media_shape_options.circle"
        },
        {
          "value": "blob-1",
          "label": "t:sections.text_with_media.secondary_media_shape_options.blob_1"
        },
        {
          "value": "blob-2",
          "label": "t:sections.text_with_media.secondary_media_shape_options.blob_2"
        },
        {
          "value": "blob-3",
          "label": "t:sections.text_with_media.secondary_media_shape_options.blob_3"
        },
        {
          "value": "blob-4",
          "label": "t:sections.text_with_media.secondary_media_shape_options.blob_4"
        },
        {
          "value": "blob-5",
          "label": "t:sections.text_with_media.secondary_media_shape_options.blob_5"
        }
      ],
      "default": "none"
    }
  ],
  "blocks": [
    {
      "type": "subheading",
      "name": "t:sections.text_with_media.blocks.subheading.name",
      "settings": [
        {
          "type": "inline_richtext",
          "id": "text",
          "label": "t:global.text.text",
          "default": "Subheading"
        },
        {
          "type": "select",
          "id": "position",
          "label": "t:global.position.alignment",
          "options": [
