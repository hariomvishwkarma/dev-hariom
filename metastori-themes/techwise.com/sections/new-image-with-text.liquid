<style>
    .new-image-with-text-section {
        width: 100%;
        transform: scale(0.9);
        transition: transform 0.6s ease;
        {% comment %} will-change: transform; {% endcomment %}
    }

    .new-image-with-text-section.is-visible {
        transform: scale(1);
    }

    .image-with-text-container {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 4rem;
        align-items: center;
    }

    .image-with-text-container--reverse {
        direction: rtl;
    }

    .image-with-text-container--reverse > * {
        direction: ltr;
    }

    .image-with-text__content {
        padding: 100px;
    }

    .image-with-text__heading {
        margin: 0 0 1rem 0;
        font-weight: 400;
        line-height: 1.2;
    }

    .image-with-text__subheading {
        margin: 0 0 1rem 0;
        line-height: 1.6;
    }

    .image-with-text__button {
        margin-top: 2rem;
    }

    .image-with-text__button .button {
        display: inline-block;
        padding: 12px 24px;
        text-decoration: none;
        border-radius: 4px;
        transition: all 0.3s ease;
    }

    .image-with-text__image {
        width: 100%;
        height: 100%;
    }

    .image-with-text__image img {
        width: 100%;
        height: 100%;
        display: block;
        object-fit: cover;
    }

    .placeholder-svg {
        width: 100%;
        height: auto;
        background-color: #f0f0f0;
    }

    .new-image-with-text-section .color-scheme {
        overflow: hidden;
        border-radius: 20px;
    }
    .iwt-drawer-button {
        display: flex;
        align-items: center;
        gap: 5px;
    }
    .iwt-drawer-button {
        display: flex;
        align-items: center;
        gap: 5px;
        transition: .5s;
    }
    .iwt-drawer-button span:first-child {
        width: 24px;
        height: 24px;
        background: white;
        border-radius: 23px;
        display: flex;
        justify-content: center;
        align-items: center;
        transition: .5s;
    }
    .iwt-drawer-button:hover span:first-child {
        background: black;
        color: white;
    }
    .iwt-drawer-button span:nth-child(2) {
        transition: .5s;
        font-weight: 600;
    }
    .iwt-drawer-button:hover span:nth-child(2) {
        margin-left:3px;
    }
    @media screen and (max-width: 768px) {
        .image-with-text-container {
            grid-template-columns: 1fr;
            gap: 0;
            text-align: center;
        }
        .image-with-text-container--reverse {
            direction: ltr;
        }
        .image-with-text__content {
            padding: 50px;
            padding-top: 20px;
            width: 100%;
            order: 1;
        }
        .image-with-text__image {
            order:2;
        }
        .image-with-text__button {
            justify-self: anchor-center;
        }
    }
    
    /* Drawer details  */
    .iwt-drawer-detail-overlay {
        position: absolute;
        top: 0;
        right: 0;
        bottom: 0;
        left: 0;
        background: #000000b3;
    }
    .iwt-drawer-detail {
        position: fixed;
        top: 0;
        right: 0;
        bottom: 0;
        left: 0;
        z-index: 9999;
        visibility: hidden;
        opacity: 0;
        transition: opacity .3s ease;
        display: flex;
        justify-content: flex-end;
        transition: opacity .3s ease,visibility 0s linear .4s;
        overflow: hidden;
    }
    .iwt-drawer-detail-content {
        width: 40%;
        min-width: 530px;
        height: 100%;
        background: #fff;
        transform: translateX(100%);
        transition: transform .4s ease;
        padding: 44px;
        overflow-y: scroll;
    }
    button.iwt-drawer-detail-close {
        position: absolute;
        top: 20px;
        right: 20px;
        font-size: 28px;
        width: 36px;
        height: 36px;
        border: none;
        background: #666;
        cursor: pointer;
        border-radius: 50%;
        color: #fff;
        display: flex;
        justify-content: center;
        align-items: center;
        z-index: 2;
    }
    button.iwt-drawer-detail-close svg {
        width: 15px;
    }
    .iwt-drawer_details-arrow svg {
        width: 9px;
    }
    .iwt-drawer-detail.active {
        opacity: 1;
        visibility: visible;
        transition: opacity .3s ease;
    }
    .iwt-drawer-detail.active .iwt-drawer-detail-content {
        transform: translateX(0);
    }
    .iwt-drawer-detail-open safe-sticky.product-info.text-start {
        position: unset;
    }
    .iwt-drawer_details-wrapper-item {
        display: flex;
        justify-content: space-between;
        align-items: center;
        cursor: pointer;
    }
    .drawer_detail-box {
        display: flex;
        gap: 18px;
    }
    .drawer_detail-box-content {
        display: flex;
        flex-direction: column;
        gap: 5px;
    }
    .drawer_detail-box-content span {
        font-size: 16px;
        font-weight: 700;
    }
    .drawer-detail-content h2 {
        font-size: 24px;
    }
    .drawer_detail-container {
        margin-top: 30px;
        display: flex;
        flex-direction: column;
        gap: 20px;
    }
    .drawer_detail-box img {
        width: 191px;
        height: 191px;
        object-fit: cover;
    }
    @media only screen and (max-width: 767px){
        .iwt-drawer-detail-content {
            width: 100%;
            min-width: 100%;
            padding: 54px 16px;
        }
        .drawer_detail-box img {
            width: 130px;
            height: 130px;
            object-fit: cover;
        }
        .drawer_detail-box-content span {
            font-size: 14px;
        }
        .drawer-detail-content h2 {
            font-size: 20px;
        }
    }
</style>

<div class="new-image-with-text-section section-{{ section.id }}" style="padding: {{ section.settings.padding_top }}px 0 {{ section.settings.padding_bottom }}px 0;">
    <div class="container">
        <div class="w-full max-w-2xl mx-auto color-scheme color-scheme--{{ section.settings.color_scheme.id }}">
            <div class="image-with-text-container {% if section.settings.layout == 'text_first' %}image-with-text-container--reverse{% endif %}">
                <div class="image-with-text__content">
                    {%- if section.settings.heading != blank -%}
                    <h2 class="image-with-text__heading h3">
                        {{ section.settings.heading }}
                    </h2>
                    {%- endif -%}

                    {%- if section.settings.subheading != blank -%}
                    <div class="image-with-text__subheading">
                        {{ section.settings.subheading }}
                    </div>
                    {%- endif -%}

                    {%- if section.settings.button_label != blank -%}
                    <div class="image-with-text__button">
                        <button class="iwt-drawer-button iwt-drawer_details-wrapper-item" data-block-id="{{ section.id }}">
                            <span>
                                <svg class="" aria-hidden="true" focusable="false" data-prefix="fak" data-icon="u0wmwjjv" role="img" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 512 512" data-fa-i2svg="" style="width: 1em;">
                                    <path fill="currentColor" d="M277.3 106.7l-42.7 0 0 128-128 0 0 42.7 128 0 0 128 42.7 0 0-128 128 0 0-42.7-128 0 0-128z"></path>
                                </svg>
                            </span>
                            <span>{{ section.settings.button_label }}</span>
                        </button>
                    </div>
                    {%- endif -%}
                </div>
                <div class="image-with-text__image">
                    {%- if section.settings.image != blank -%}
                    <img
                        src="{{ section.settings.image | image_url: width: 1000 }}"
                        alt="{{ section.settings.image.alt | escape }}"
                        loading="lazy"
                        width="{{ section.settings.image.width }}"
                        height="{{ section.settings.image.height }}"
                    >
                    {%- else -%}
                    {{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}
                    {%- endif -%}
                </div>
            </div>
        </div>
    </div>
</div>
<div class="iwt-drawer-detail" id="drawerDetails-{{ section.id }}" data-popup-id="{{ section.id }}">
    <div class="iwt-drawer-detail-overlay"></div>
    <div class="iwt-drawer-detail-content">
        <button class="iwt-drawer-detail-close">{%- render 'icon' with 'close', width: 10 -%}</button>
        <h2>{{ section.settings.drawer-heading }}</h2>
        {% if product.metafields.custom.product_content_blocks != blank %}
            <div class="drawer_detail-container"> 
                {% comment %} {% for block in section.blocks %}
                    <div class="drawer_detail-box">
                        {% if block.settings.drawer_image != blank %}
                            <img 
                            src="{{ block.settings.drawer_image | image_url: width: 500 }}" 
                            alt="{{ block.settings.drawer_content_heading | escape }}">
                        {% endif %}
                        <div class="drawer_detail-box-content">
                            {% if block.settings.drawer_content_heading != blank %}
                                <span>{{ block.settings.drawer_content_heading }}</span>
                            {% endif %}
                            {% if block.settings.drawer_content_description != blank %}
                                <div class="content-text">
                                    {{ block.settings.drawer_content_description }}
                                </div>
                            {% endif %}
                        </div>
                    </div>
                {% endfor %}     {% endcomment %}
                {% for block in product.metafields.custom.product_content_blocks.value %}
                    <div class="drawer_detail-box">
                    {% if block.image %}
                        <img 
                        src="{{ block.image | image_url: width: 191 }}" 
                        alt="{{ block.heading_text | escape }}">
                    {% endif %}
                    <div class="drawer_detail-box-content">
                        {% if block.heading_text != blank %}
                        <span>{{ block.heading_text }}</span>
                        {% endif %}

                        {% if block.description != blank %}
                        <div class="content-text">
                            {{ block.description }}
                        </div>
                        {% endif %}
                    </div>
                    </div>
                {% endfor %}               
            </div>
        {% endif %}
    </div>
</div>
<script>
  (function () {
    document.querySelectorAll('.iwt-drawer_details-wrapper-item').forEach(item => {
      item.addEventListener('click', () => {
        const blockId = item.dataset.blockId;
        const popup = document.getElementById(`drawerDetails-${blockId}`);
        if (!popup) return;

        popup.classList.add('active');
        document.body.classList.add('iwt-drawer-detail-open');
        document.body.style.overflow = 'hidden';
      });
    });

    // CLOSE LOGIC
    document.querySelectorAll('.iwt-drawer-detail').forEach(popup => {
      const closeBtn = popup.querySelector('.iwt-drawer-detail-close');
      const overlay = popup.querySelector('.iwt-drawer-detail-overlay');

      function closePopup() {
        popup.classList.remove('active');
        setTimeout(() => {
          document.body.classList.remove('iwt-drawer-detail-open');
        }, 400);
        document.body.style.overflow = '';
      }

      closeBtn.addEventListener('click', closePopup);
      overlay.addEventListener('click', closePopup);
    });

    document.addEventListener('keydown', e => {
      if (e.key === 'Escape') {
        const popup = document.querySelector('.iwt-drawer-detail.active');
        if (popup) {
          popup.querySelector('.iwt-drawer-detail-close').click();
        }
      }
    });

  })();
</script>
<script>
    document.addEventListener("scroll", () => {
    const section = document.querySelector(".new-image-with-text-section");
    if (!section) return;

    const rect = section.getBoundingClientRect();
    const windowHeight = window.innerHeight;

    /*
        Jab section viewport me enter kare:
        progress = 0 → scale 0.9
        progress = 1 → scale 1
    */

    const start = windowHeight;           // section niche se aate waqt
    const end = windowHeight * 0.2;       // thoda upar aane par full scale

    let progress = (start - rect.top) / (start - end);
    progress = Math.min(Math.max(progress, 0), 1); // clamp 0–1

    const scale = 0.9 + (0.1 * progress);
    section.style.transform = `scale(${scale})`;
    });
</script>


{% schema %}
{
  "name": "New image with Text",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:global.colors.scheme",
      "default": "scheme-1"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "A tool for every task."
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading",
      "default": "Specialized steam cleaner attachments for deep cleaning floors, bathrooms, kitchens, furniture and upholstery, grout lines, windows, and more."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button Label",
      "default": "Take a look"
    },
    {
      "type": "select",
      "id": "layout",
      "label": "Layout",
      "options": [
        {
          "value": "image_first",
          "label": "Text first"
        },
        {
          "value": "text_first",
          "label": "Image first"
        }
      ],
      "default": "image_first"
    },
    {
        "type": "header",
        "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding Top",
      "default": 60
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding Bottom",
      "default": 60
    }
  ],
  "presets": [
    {
      "name": "New image with Text"
    }
  ]
}
{% endschema %}
