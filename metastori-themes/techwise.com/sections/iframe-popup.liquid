{% style %}
.iframe-popup {
  position: fixed;
  inset: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  opacity: 0;
  visibility: hidden;
  transition: opacity .3s ease, visibility .3s ease;
  z-index: 99999;
}

.iframe-popup.active {
  opacity: 1;
  visibility: visible;
}

.iframe-popup__overlay {
  position: absolute;
  inset: 0;
  background: rgba(0,0,0,.7);
}

.iframe-popup__content {
  position: relative;
  width: min({{ section.settings.popup_width }}vw, 1200px);
  height: {{ section.settings.popup_height }}px;
  max-height: 90vh;
  background: #fff;
  border-radius: 20px;
  overflow: hidden;
  z-index: 2;
}

.iframe-popup iframe {
       width: 60%;
    height: 100%;
    border: 0;
    display: flex;
    justify-content: center;
    align-items: center;
    margin: 0 auto;
}

.iframe-popup__close {
  position: absolute;
  top: 12px;
  right: 12px;
  width: 42px;
  height: 42px;
  border: 0;
  border-radius: 50%;
  background: #fff;
  color: #000;
  font-size: 26px;
  cursor: pointer;
  z-index: 3;
}
button.iframe-popup-btn.button {
        margin: 0px auto 60px;
    display: flex;
    background: #000000;
    color: #fff;
}

@media (max-width: 989px) {
  .iframe-popup__content {
    width: 100% !important;
    height: 100vh;
    max-height: 100vh;
    border-radius: 0;
  }
  .iframe-popup iframe{
    width:95%;
    padding-inline:0%;
  }
}
  ._SignupForm_xbw8h_188 {
        width: 100% !important;
        padding: 2.8% 6.2%;
    }

  body.iframe-popup-open {
    overflow: hidden;
    touch-action: none;
}
{% endstyle %}
{% render 'button',
  content: section.settings.button_text,
  type: 'button',
  class: 'iframe-popup-btn'
%}
<div class="iframe-popup">
  <div class="iframe-popup__overlay"></div>

  <div
    class="iframe-popup__content"
    style="width:{{ section.settings.popup_width }}%; max-width:1000px;"
  >
    <button class="iframe-popup__close">×</button>

    <iframe
      src="{{ section.settings.iframe_url }}"
      width="100%"
      height="{{ section.settings.popup_height }}"
      frameborder="0"
      allowfullscreen>
    </iframe>

  </div>
  
</div>

{% schema %}
{
  "name": "Iframe Popup",
  "settings": [
    {
      "type": "text",
      "id": "button_text",
      "label": "Button Text",
      "default": "Open Popup"
    },
    {
      "type": "url",
      "id": "iframe_url",
      "label": "Iframe URL"
    },
    {
      "type": "range",
      "id": "popup_width",
      "label": "Popup Width",
      "min": 50,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 80
    },
    {
      "type": "range",
      "id": "popup_height",
      "label": "Popup Height",
      "min": 300,
      "max": 900,
      "step": 50,
      "unit": "px",
      "default": 600
    }
  ],
  "presets": [
    {
      "name": "Iframe Popup"
    }
  ]
}
{% endschema %}
<script>
   document.addEventListener("click", function (e) {

  const btn = e.target.closest(".iframe-popup-btn");

  if (btn) {
    const popup = btn.closest(".shopify-section").querySelector(".iframe-popup");

    popup.classList.add("active");
    document.body.classList.add("iframe-popup-open");
  }

  if (
    e.target.closest(".iframe-popup__close") ||
    e.target.classList.contains("iframe-popup__overlay")
  ) {
    const popup = e.target.closest(".iframe-popup");

    popup.classList.remove("active");
    document.body.classList.remove("iframe-popup-open");
  }
});

document.addEventListener("keydown", function (e) {
  if (e.key === "Escape") {
    document.querySelectorAll(".iframe-popup.active").forEach((popup) => {
      popup.classList.remove("active");
    });

    document.body.classList.remove("iframe-popup-open");
  }
});
</script>