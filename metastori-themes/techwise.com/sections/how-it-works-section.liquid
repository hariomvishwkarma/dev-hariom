{%- comment -%}
  ============================================================================
  HOE WERKT HET — Cashback Event Section
  Fully configurable Shopify section with separate mobile + desktop controls.
  Steps are added as blocks (add / remove / reorder in the theme editor).
  ============================================================================
{%- endcomment -%}

{%- liquid
  assign s = section.settings
  if s.bg_image != blank
    assign hiw_bg_image_url = s.bg_image | image_url: width: 2400
  endif
-%}

<style>
  #shopify-section-{{ section.id }} .tw-hiw {
    --hiw-bg: {{ s.bg_color }};
    --hiw-text: {{ s.text_color }};
    --hiw-text-muted: {{ s.muted_text_color }};
    --hiw-accent: {{ s.accent_color }};
    --hiw-card-bg: {{ s.card_bg_color }};
    --hiw-card-bg-hover: {{ s.card_bg_hover_color }};
    --hiw-card-border: {{ s.card_border_color }};
    --hiw-number-bg: {{ s.number_bg_color }};
    --hiw-number-border: {{ s.number_border_color }};
    --hiw-connector: {{ s.connector_color }};
    --hiw-button-bg: {{ s.button_bg_color }};
    --hiw-button-text: {{ s.button_text_color }};

    --hiw-max-width: {{ s.max_width }}px;
    --hiw-card-radius: {{ s.card_radius }}px;
    --hiw-button-radius: {{ s.button_radius }}px;

    /* Mobile defaults */
    --hiw-pad-y: {{ s.padding_top_mobile }}px;
    --hiw-pad-y-bottom: {{ s.padding_bottom_mobile }}px;
    --hiw-pad-x: {{ s.padding_x_mobile }}px;
    --hiw-title-size: {{ s.title_size_mobile }}px;
    --hiw-subheading-size: {{ s.subheading_size_mobile }}px;
    --hiw-step-title-size: {{ s.step_title_size_mobile }}px;
    --hiw-step-text-size: {{ s.step_text_size_mobile }}px;

    background-color: var(--hiw-bg);
    {%- if s.bg_image != blank -%}
    position: relative;
    background-image: url('{{ hiw_bg_image_url }}');
    background-size: {{ s.bg_image_size }};
    background-position: {{ s.bg_image_position }};
    background-repeat: no-repeat;
    {%- endif -%}
    color: var(--hiw-text);
    padding: var(--hiw-pad-y) var(--hiw-pad-x) var(--hiw-pad-y-bottom);
  }

  {%- if s.bg_image != blank and s.bg_overlay_opacity > 0 -%}
  #shopify-section-{{ section.id }} .tw-hiw::before {
    content: '';
    position: absolute;
    inset: 0;
    background-color: var(--hiw-bg);
    opacity: {{ s.bg_overlay_opacity | divided_by: 100.0 }};
    pointer-events: none;
  }
  {%- endif -%}

  #shopify-section-{{ section.id }} .tw-hiw__container {
    max-width: var(--hiw-max-width);
    margin: 0 auto;
    {%- if s.bg_image != blank and s.bg_overlay_opacity > 0 -%}
    position: relative;
    z-index: 1;
    {%- endif -%}
  }

  #shopify-section-{{ section.id }} .tw-hiw__header {
    text-align: {{ s.header_alignment }};
    margin-bottom: {{ s.header_spacing_mobile }}px;
  }

  #shopify-section-{{ section.id }} .tw-hiw__subheading {
    display: inline-block;
    font-weight: 600;
    font-size: var(--hiw-subheading-size);
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--hiw-accent);
    margin-bottom: 0.75rem;
  }

  #shopify-section-{{ section.id }} .tw-hiw__title {
    font-weight: {{ s.title_weight }};
    font-size: var(--hiw-title-size);
    line-height: 1.1;
    letter-spacing: 0;
    margin: 0;
    color: var(--hiw-text);
  }

  #shopify-section-{{ section.id }} .tw-hiw__steps {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: {{ s.step_gap_mobile }}px;
  }

  #shopify-section-{{ section.id }} .tw-hiw__step {
    display: flex;
    align-items: flex-start;
    gap: 1.25rem;
    width: 100%;
    max-width: 480px;
    padding: {{ s.card_padding_mobile }}px;
    background: var(--hiw-card-bg);
    border: 1px solid var(--hiw-card-border);
    border-radius: var(--hiw-card-radius);
    transition: background-color 0.2s ease;
  }

  #shopify-section-{{ section.id }} .tw-hiw__step:hover {
    background: var(--hiw-card-bg-hover);
  }

  #shopify-section-{{ section.id }} .tw-hiw__step-number {
    flex-shrink: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 2.75rem;
    height: 2.75rem;
    border-radius: 50%;
    background: var(--hiw-number-bg);
    border: 1.5px solid var(--hiw-number-border);
    font-weight: 600;
    font-size: 1.125rem;
    color: var(--hiw-accent);
    line-height: 1;
  }

  #shopify-section-{{ section.id }} .tw-hiw__step-content {
    flex: 1;
    min-width: 0;
  }

  #shopify-section-{{ section.id }} .tw-hiw__step-title {
    font-weight: 600;
    font-size: var(--hiw-step-title-size);
    line-height: 1.3;
    margin: 0 0 0.35rem 0;
    color: var(--hiw-text);
  }

  #shopify-section-{{ section.id }} .tw-hiw__step-text {
    font-weight: 400;
    font-size: var(--hiw-step-text-size);
    line-height: 1.4;
    margin: 0;
    color: var(--hiw-text-muted);
  }

  #shopify-section-{{ section.id }} .tw-hiw__connector {
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--hiw-connector);
    transform: rotate(90deg);
    height: 1.5rem;
  }

  #shopify-section-{{ section.id }} .tw-hiw__connector svg {
    width: 1.25rem;
    height: 1.25rem;
  }

  #shopify-section-{{ section.id }} .tw-hiw__cta {
    text-align: {{ s.header_alignment }};
    margin-top: {{ s.cta_spacing_mobile }}px;
  }

  #shopify-section-{{ section.id }} .tw-hiw__button {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-weight: 600;
    font-size: {{ s.button_text_size }}px;
    line-height: normal;
    padding: 0.85rem 2rem;
    background-color: var(--hiw-button-bg);
    color: var(--hiw-button-text);
    border: none;
    border-radius: var(--hiw-button-radius);
    text-decoration: none;
    cursor: pointer;
    transition: opacity 0.2s ease;
  }

  #shopify-section-{{ section.id }} .tw-hiw__button:hover {
    opacity: 0.85;
  }

  #shopify-section-{{ section.id }} .tw-hiw__button svg {
    width: 1rem;
    height: 1rem;
    transition: transform 0.2s ease;
  }

  #shopify-section-{{ section.id }} .tw-hiw__button:hover svg {
    transform: translate(2px, -2px);
  }

  /* ======================================================================
     TABLET + DESKTOP ({{ s.desktop_breakpoint }}px and up)
     ====================================================================== */
  @media screen and (min-width: {{ s.desktop_breakpoint }}px) {
    #shopify-section-{{ section.id }} .tw-hiw {
      --hiw-pad-y: {{ s.padding_top_desktop }}px;
      --hiw-pad-y-bottom: {{ s.padding_bottom_desktop }}px;
      --hiw-pad-x: {{ s.padding_x_desktop }}px;
      --hiw-title-size: {{ s.title_size_desktop }}px;
      --hiw-subheading-size: {{ s.subheading_size_desktop }}px;
      --hiw-step-title-size: {{ s.step_title_size_desktop }}px;
      --hiw-step-text-size: {{ s.step_text_size_desktop }}px;
    }

    #shopify-section-{{ section.id }} .tw-hiw__header {
      margin-bottom: {{ s.header_spacing_desktop }}px;
    }

    #shopify-section-{{ section.id }} .tw-hiw__steps {
      flex-direction: {% if s.stack_steps_desktop %}column{% else %}row{% endif %};
      align-items: stretch;
      gap: {% if s.stack_steps_desktop %}{{ s.step_gap_desktop }}px{% else %}0{% endif %};
      max-width: {% if s.stack_steps_desktop %}600px{% else %}none{% endif %};
      margin-left: auto;
      margin-right: auto;
    }

    #shopify-section-{{ section.id }} .tw-hiw__step {
      flex: 1;
      {% unless s.stack_steps_desktop %}
        flex-direction: column;
        align-items: center;
        text-align: center;
      {% endunless %}
      max-width: none;
      padding: {{ s.card_padding_desktop }}px;
    }

    #shopify-section-{{ section.id }} .tw-hiw__step-number {
      {% unless s.stack_steps_desktop %}margin-bottom: 0.25rem;{% endunless %}
    }

    #shopify-section-{{ section.id }} .tw-hiw__step-content {
      {% unless s.stack_steps_desktop %}text-align: center;{% endunless %}
    }

    #shopify-section-{{ section.id }} .tw-hiw__connector {
      transform: {% if s.stack_steps_desktop %}rotate(90deg){% else %}rotate(0deg){% endif %};
      flex-shrink: 0;
      width: 2.5rem;
      height: auto;
      align-self: center;
    }

    #shopify-section-{{ section.id }} .tw-hiw__cta {
      margin-top: {{ s.cta_spacing_desktop }}px;
    }
  }
</style>

<section
  class="tw-hiw"
  aria-label="{{ s.heading | escape }}"
  {{ section.shopify_attributes }}
>
  <div class="tw-hiw__container">

    {%- if s.subheading != blank or s.heading != blank -%}
      <div class="tw-hiw__header">
        {%- if s.subheading != blank -%}
          <span class="tw-hiw__subheading">{{ s.subheading | escape }}</span>
        {%- endif -%}
        {%- if s.heading != blank -%}
          <h2 class="tw-hiw__title">{{ s.heading | escape }}</h2>
        {%- endif -%}
      </div>
    {%- endif -%}

    <div class="tw-hiw__steps">
      {%- for block in section.blocks -%}
        <div class="tw-hiw__step" {{ block.shopify_attributes }}>
          <div class="tw-hiw__step-number">
            {{- block.settings.number | default: forloop.index -}}
          </div>
          <div class="tw-hiw__step-content">
            {%- if block.settings.title != blank -%}
              <h3 class="tw-hiw__step-title">{{ block.settings.title | escape }}</h3>
            {%- endif -%}
            {%- if block.settings.text != blank -%}
              <p class="tw-hiw__step-text">{{ block.settings.text }}</p>
            {%- endif -%}
          </div>
        </div>

        {%- unless forloop.last -%}
          {%- if s.show_connectors -%}
            <div class="tw-hiw__connector" aria-hidden="true">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none">
                <path d="M5 12h14M13 6l6 6-6 6" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </div>
          {%- endif -%}
        {%- endunless -%}
      {%- endfor -%}
    </div>

    {%- if s.show_button and s.button_label != blank -%}
      <div class="tw-hiw__cta">
        <a href="{{ s.button_link | default: '#' }}" class="tw-hiw__button">
          {{ s.button_label | escape }}
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <path d="M6 18L18 6M18 6H10M18 6v8" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </a>
      </div>
    {%- endif -%}

  </div>
</section>

{% schema %}
{
  "name": "Cashback — Hoe werkt het",
  "tag": "section",
  "class": "section-cashback-hiw",
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Summer Sale Cashback Event"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Hoe werkt het?"
    },
    {
      "type": "checkbox",
      "id": "show_connectors",
      "label": "Show arrows between steps",
      "default": true
    },
    {
      "type": "select",
      "id": "header_alignment",
      "label": "Header & button alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ],
      "default": "center"
    },

    {
      "type": "header",
      "content": "Call to action button"
    },
    {
      "type": "checkbox",
      "id": "show_button",
      "label": "Show button",
      "default": true
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Bekijk de deals"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    },

    {
      "type": "header",
      "content": "Typography"
    },
    {
      "type": "select",
      "id": "title_weight",
      "label": "Heading weight",
      "options": [
        { "value": "400", "label": "Regular" },
        { "value": "500", "label": "Medium" },
        { "value": "600", "label": "Semibold" },
        { "value": "700", "label": "Bold" }
