{%- liquid
  assign content_width_classes = 'max-w-' | append: section.settings.content_width
  if section.settings.desktop_content_width != 'inherit'
    assign content_width_classes = content_width_classes | append: ' sm:max-w-' | append: section.settings.desktop_content_width
  endif

  assign mobile_image_size = section.settings.mobile_image_size
  if mobile_image_size == 'inherit'
    assign mobile_image_size = section.settings.image_size
  endif
-%}

{%- if section.settings.enable_gradient -%}
  {%- style -%}
    #shopify-section-{{ section.id }} .content-box__edge-gradient {
      position: absolute;
      inset: 0;
      pointer-events: none;
      z-index: 1;
      background: linear-gradient(
        to bottom,
        rgb({{ section.settings.gradient_color.rgb }} / {{ section.settings.gradient_opacity | divided_by: 100.0 }}) 0%,
        rgb({{ section.settings.gradient_color.rgb }} / 0) {{ section.settings.gradient_spread }}%
      );
    }

    @media screen and (min-width: 750px) {
      #shopify-section-{{ section.id }} .content-box__edge-gradient {
        background: linear-gradient(
          to right,
          rgb({{ section.settings.gradient_color.rgb }} / {{ section.settings.gradient_opacity | divided_by: 100.0 }}) 0%,
          rgb({{ section.settings.gradient_color.rgb }} / 0) {{ section.settings.gradient_spread }}%
        );
      }
    }
  {%- endstyle -%}
{%- endif -%}

<div {% if section.settings.allow_transparent_header %}allow-transparent-header{% endif %} class="color-scheme color-scheme--{{ section.settings.color_scheme.id }}">
  <div class="content-box min-h-{{ mobile_image_size }} sm:min-h-{{ section.settings.image_size }}">
    <div class="content-box__background-media with-overlay" style="--overlay: {{ section.settings.overlay_color.rgb }} / {{ section.settings.overlay_opacity | divided_by: 100.0 }}">
      {%- liquid
        if section.settings.image != blank
          render 'media' with section.settings.image, mobile_media: section.settings.mobile_image, preload: true
        else
          echo 'hero-apparel-1' | placeholder_svg_tag: 'size-full'
        endif
      -%}

      {%- if section.settings.enable_gradient -%}
        <div class="content-box__edge-gradient"></div>
      {%- endif -%}
    </div>

    {%- capture blocks -%}{% content_for 'blocks' %}{%- endcapture -%}

    {%- if section.blocks.size > 0 -%}
      {%- assign mobile_text_alignment = section.settings.mobile_text_position | split: '-' | last -%}
      {%- assign desktop_text_alignment = section.settings.desktop_text_position | split: '-' | last -%}

      {%- if section.settings.enable_sticky_content -%}
        <div class="justify-self-{{ mobile_text_alignment }} sm:justify-self-{{ desktop_text_alignment }}">
          <div class="sticky">
            <div class="{{ content_width_classes }} prose prose-justify-{{ mobile_text_alignment }} sm:prose-justify-{{ desktop_text_alignment }}">
              {{- blocks -}}
            </div>
          </div>
        </div>
      {%- else -%}
        <div class="{{ section.settings.mobile_text_position }} {{ section.settings.desktop_text_position }}">
          <div class="{{ content_width_classes }} prose prose-justify-{{ mobile_text_alignment }} sm:prose-justify-{{ desktop_text_alignment }}">
            {{- blocks -}}
          </div>
        </div>
      {% endif %}
    {%- endif -%}
  </div>
</div>

