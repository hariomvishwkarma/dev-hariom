{%- liquid
  if section.settings.image == blank and section.settings.layout == 'stacked'
    assign text_alignment = 'center'
  else
    assign text_alignment = 'start'
  endif
-%}

<div class="color-scheme color-scheme--{{ section.settings.color_scheme.id }}">
  {%- capture section_header -%}
    <div class="v-stack justify-items-{{ text_alignment }} gap-6 sm:gap-8">
      {%- if section.settings.subheading != blank or section.settings.title != blank or section.settings.content != blank -%}
        
        <div class="prose prose-justify-{{ text_alignment }}">
          {%- render 'subheading', content: section.settings.subheading -%}
          {%- render 'heading', content: section.settings.title, balance_text: true, style: section.settings.heading_size, html_tag: 'h2' -%}

          <div class="max-w-sm">
            {{- section.settings.content -}}
          </div>
        </div>
      {%- endif -%}

      {%- if section.settings.show_social_media -%}
        {%- render 'social-media' -%}
      {%- endif -%}
    </div>
  {%- endcapture -%}

  {%- liquid
    if localization.language.iso_code == 'en'
      assign active_form_content = section.settings.content_en
    else
      assign active_form_content = section.settings.content_nl
    endif

    assign show_formstack_success = false
    if active_form_content contains 'formstack.com'
      assign show_formstack_success = true
    endif
  -%}

  {%- capture section_main_content -%}
  <div class="contact-form-language__embed" data-contact-form-embed>
    {{- active_form_content -}}
  </div>
  {%- if show_formstack_success -%}
    {%- render 'formstack-success' -%}
  {%- endif -%}
  {%- endcapture -%}

  {%- if section.settings.image != blank -%}
    <div class="section-split">
      <div class="section-split__column section-split__column--image {% unless section.settings.add_image_spacing %}section-split__column--flushed{% endunless %}">
        {{- section.settings.image | image_url: width: section.settings.image.width | image_tag: sizes: '(max-width: 699px) 100vw, 50vw', widths: '300,400,500,600,800,1000,1200,1400,1600,1800,2000', class: 'size-full' -}}
      </div>

      <div class="section-split__column">
        <div class="section-stack">
          {{- section_header -}}
          {{- section_main_content -}}
        </div>
      </div>
    </div>
  {%- else -%}
    {%- if section.settings.layout == 'split' -%}
      <div class="section-split">
        <div class="section-split__column">
          {{- section_header -}}
        </div>

        <div class="section-split__column">
          {{- section_main_content -}}
        </div>
      </div>
    {%- else -%}
      <div class="container section-spacing">
        <div class="section-stack max-w-md mx-auto text-center">
          {{- section_header -}}
          {{- section_main_content -}}
        </div>
      </div>
    {%- endif -%}
  {%- endif -%}
</div>

{% schema %}
{
  "name": "Multilingual Contact form",
  "class": "shopify-section--contact",
  "tag": "section",
  "disabled_on": {
    "groups": ["header", "custom.overlay"]
  },
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:global.colors.scheme",
      "default": "scheme-1"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "t:global.image.image",
      "info": "t:sections.contact.image_size_recommendation"
    },
    {
      "type": "select",
      "id": "layout",
      "label": "t:global.layout.layout",
      "options": [
        {
          "value": "split",
          "label": "t:global.layout.layout_options.split"
        },
        {
          "value": "stacked",
          "label": "t:global.layout.layout_options.stacked"
        }
      ],
      "default": "stacked",
      "visible_if": "{{ section.settings.image == blank }}"
    },
    {
      "type": "checkbox",
      "id": "add_image_spacing",
      "label": "t:sections.contact.add_image_spacing",
      "default": false,
      "visible_if": "{{ section.settings.image != blank or section.settings.layout == 'split' }}"
    },
    {
      "type": "inline_richtext",
      "id": "subheading",
      "label": "t:global.text.subheading",
      "default": "Contact Us"
    },
    {
      "type": "inline_richtext",
      "id": "title",
      "label": "t:global.text.heading",
      "default": "We'd love to hear from you"
    },
    {
      "type": "select",
      "id": "heading_size",
      "label": "t:global.text.heading_size",
      "options": [
        {
          "value": "display-xl",
          "label": "Display XL"
        },
        {
          "value": "display-l",
          "label": "Display L"
        },
        {
          "value": "display-m",
          "label": "Display M"
        },
        {
          "value": "h1",
          "label": "XX-Large"
        },
        {
          "value": "h2",
          "label": "X-Large"
        },
        {
          "value": "h3",
          "label": "Large"
        },
        {
          "value": "h4",
          "label": "Medium"
        },
        {
          "value": "h5",
          "label": "Small"
        },
        {
          "value": "h6",
          "label": "X-Small"
        },
        {
          "value": "h7",
          "label": "XX-Small"
        }
      ],
      "default": "h2"
    },
    {
      "type": "richtext",
      "id": "content",
      "label": "t:global.text.content",
      "default": "<p>If you have any questions, please fill in this contact form, and our team will reach you back as soon as possible.</p>"
    },
    {
      "type": "checkbox",
      "id": "show_social_media",
      "label": "t:sections.contact.show_social_media",
      "info": "t:sections.contact.show_social_media_info",
      "default": true
    },
    {
      "type": "header",
      "content": "🇬🇧 English Content"
    },
    {
      "type": "liquid",
      "id": "content_en",
      "label": "Content (English)",
      "info": "Write or paste your full HTML/Liquid code for English",
      "default": "<p>Write or copy/paste Liquid code</p>"
    },
    {
      "type": "header",
      "content": "🇳🇱 Dutch Content"
    },
    {
      "type": "liquid",
      "id": "content_nl",
      "label": "Content (Nederlands)",
      "info": "Schrijf of plak hier je volledige HTML/Liquid code",
      "default": "<p>Schrijf of plak Liquid code</p>"
    }
  ],
  "presets": [
    {
      "name": "Multilingual Contact form",
      "category": "t:global.categories.call_to_action",
      "settings": {}
    }
  ]
}
{% endschema %}