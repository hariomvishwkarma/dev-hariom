<style>
.rb-{{ section.id }} {
  height: 440px;
  background: url({{ section.settings.bg_image | image_url }}) center/cover;
  padding-left: 10%;
  color: #fff;
  display: flex;
  flex-direction: column;
  justify-content: center;
  gap: 36px;
}

.rb-{{ section.id }} img {
  height: 64px;
}

.rb-{{ section.id }} h1 {
  font-size: 2rem;
  line-height: 2rem;
  margin: 0;
}

.rb-{{ section.id }} p {
  font-size: 1.8rem;
  line-height: 1.8rem;
  margin: 0;
  color: #90c9eb;
  padding-bottom: 12px;
}

.rb-{{ section.id }} a {
  background: #fff;
  color: #171a1b;
  padding: 15px 44px;
  border-radius: 50px;
  font-weight: 700;
  display: inline-block;
  text-decoration: none;
}
.cus-banner-text-icon_image {
    width: 100%;
}
.cus-banner-text-icon_image img{
    object-fit: contain;
}

@media only screen and (max-width: 749px) {
    .rb-{{ section.id }} {
        padding: 0 20px;
    }
}
</style>

<section class="rb-{{ section.id }}">
  
  {% if section.settings.icon_image %}
  <div class="cus-banner-text-icon_image">
    <img src="{{ section.settings.icon_image | image_url }}" alt="">
  </div>
  {% endif %}

  <div>
    <p>{{ section.settings.small_text }}</p>
    <h1>{{ section.settings.heading }}</h1>
  </div>

  {% if section.settings.button_link %}
  <div>
    <a href="{{ section.settings.button_link }}">
      {{ section.settings.button_text }}
    </a>
  </div>
  {% endif %}

</section>
{% schema %}
{
  "name": "Retention Banner",
  "settings": [
    {
      "type": "image_picker",
      "id": "bg_image",
      "label": "Background Image"
    },
    {
      "type": "image_picker",
      "id": "icon_image",
      "label": "Top Icon Image"
    },
    {
      "type": "text",
      "id": "small_text",
      "label": "Small Text",
      "default": "Geef je stoomreiniger nog één kans en ontvang een"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "gratis voegenborstelset"
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button Text",
      "default": "Ontvang jouw voegenborstels"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button Link"
    }
  ],
  "presets": [
    {
      "name": "Retention Banner"
    }
  ]
}
{% endschema %}