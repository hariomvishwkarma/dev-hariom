{%- if block.settings.image != blank or block.settings.mobile_image != blank -%}
  {%- if block.settings.enable_custom_position -%}
    {%- style -%}
      #shopify-block-{{ block.id }}.slideshow-positioned-image {
        position: absolute;
        z-index: 2;
        width: min({{ block.settings.positioned_mobile_max_width }}px, 100%);
        max-width: min({{ block.settings.positioned_mobile_max_width }}px, 100%);
        {%- if block.settings.mobile_position_top > 0 -%}
          top: {{ block.settings.mobile_position_top }}px;
        {%- else -%}
          top: auto;
        {%- endif -%}
        {%- if block.settings.mobile_position_bottom > 0 -%}
          bottom: {{ block.settings.mobile_position_bottom }}px;
        {%- else -%}
          bottom: auto;
        {%- endif -%}
        {%- if block.settings.mobile_position_left > 0 -%}
          left: {{ block.settings.mobile_position_left }}px;
        {%- else -%}
          left: auto;
        {%- endif -%}
        {%- if block.settings.mobile_position_right > 0 -%}
          right: {{ block.settings.mobile_position_right }}px;
        {%- else -%}
          right: auto;
        {%- endif -%}
        z-index: -1;
      }

      #shopify-block-{{ block.id }}.slideshow-positioned-image :is(picture, img, .constrained-image) {
        width: 100%;
        max-width: 100%;
        height: auto;
        display: block;
      }

      @media screen and (min-width: 700px) {
        #shopify-block-{{ block.id }}.slideshow-positioned-image {
          width: min({{ block.settings.positioned_desktop_max_width }}px, 100%);
          max-width: min({{ block.settings.positioned_desktop_max_width }}px, 100%);
          {%- if block.settings.desktop_position_top > 0 -%}
            top: {{ block.settings.desktop_position_top }}px;
          {%- else -%}
            top: auto;
          {%- endif -%}
          {%- if block.settings.desktop_position_bottom > 0 -%}
            bottom: {{ block.settings.desktop_position_bottom }}px;
          {%- else -%}
            bottom: auto;
          {%- endif -%}
          {%- if block.settings.desktop_position_left > 0 -%}
            left: {{ block.settings.desktop_position_left }}px;
          {%- else -%}
            left: auto;
          {%- endif -%}
          {%- if block.settings.desktop_position_right > 0 -%}
            right: {{ block.settings.desktop_position_right }}px;
          {%- else -%}
            right: auto;
          {%- endif -%}
        }
      }
    {%- endstyle -%}

    <div id="shopify-block-{{ block.id }}" class="slideshow-positioned-image" {{ block.shopify_attributes }}>
      {%- render 'media' with block.settings.image, mobile_media: block.settings.mobile_image, class_name: block.settings.class_name, preload: false -%}
    </div>
  {%- else -%}
    {%- render 'media' with block.settings.image, mobile_media: block.settings.mobile_image, class_name: block.settings.class_name, max_width: block.settings.max_width, mobile_max_width: block.settings.mobile_max_width, preload: false, block: block -%}
  {%- endif -%}
{%- endif -%}

{% schema %}
{
  "name": "t:blocks.image.name",
  "tag": null,
  "settings": [
    {
      "type": "text",
      "id": "class_name",
      "label": "Class name"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "t:global.image.image"
    },
    {
      "type": "image_picker",
      "id": "mobile_image",
      "label": "t:global.image.mobile_image"
    },
    {
      "type": "range",
      "id": "max_width",
      "min": 20,
      "max": 100,
      "unit": "%",
      "label": "t:global.image.maximum_width",
      "default": 100,
      "visible_if": "{{ block.settings.enable_custom_position == false }}"
    },
    {
      "type": "range",
      "id": "mobile_max_width",
      "min": 20,
      "max": 100,
      "unit": "%",
      "label": "t:global.image.mobile_maximum_width",
      "default": 100,
      "visible_if": "{{ block.settings.enable_custom_position == false }}"
    },
    {
      "type": "header",
      "content": "Slideshow position"
    },
    {
      "type": "checkbox",
      "id": "enable_custom_position",
      "label": "Enable custom position",
      "info": "Place the image anywhere on the slide. Off keeps the default inline layout.",
      "default": false
    },
    {
      "type": "header",
      "content": "Mobile position",
      "visible_if": "{{ block.settings.enable_custom_position }}"
    },
    {
      "type": "range",
      "id": "mobile_position_top",
      "label": "Top",
      "info": "0 = auto",
      "min": 0,
      "max": 400,
      "step": 5,
      "unit": "px",
      "default": 0,
      "visible_if": "{{ block.settings.enable_custom_position }}"
    },
    {
      "type": "range",
      "id": "mobile_position_right",
      "label": "Right",
      "info": "0 = auto",
      "min": 0,
      "max": 400,
      "step": 5,
      "unit": "px",
      "default": 0,
      "visible_if": "{{ block.settings.enable_custom_position }}"
    },
    {
      "type": "range",
      "id": "mobile_position_bottom",
      "label": "Bottom",
      "info": "0 = auto",
      "min": 0,
      "max": 400,
      "step": 5,
      "unit": "px",
      "default": 0,
      "visible_if": "{{ block.settings.enable_custom_position }}"
    },
    {
      "type": "range",
      "id": "mobile_position_left",
      "label": "Left",
      "info": "0 = auto",
      "min": 0,
      "max": 400,
      "step": 5,
      "unit": "px",
      "default": 0,
      "visible_if": "{{ block.settings.enable_custom_position }}"
    },
    {
      "type": "range",
      "id": "positioned_mobile_max_width",
      "label": "t:global.image.mobile_maximum_width",
      "min": 20,
      "max": 500,
      "step": 5,
      "unit": "px",
      "default": 120,
      "visible_if": "{{ block.settings.enable_custom_position }}"
    },
    {
      "type": "header",
      "content": "Desktop position",
      "visible_if": "{{ block.settings.enable_custom_position }}"
    },
    {
      "type": "range",
      "id": "desktop_position_top",
      "label": "Top",
      "info": "0 = auto",
      "min": 0,
      "max": 400,
      "step": 5,
      "unit": "px",
      "default": 0,
      "visible_if": "{{ block.settings.enable_custom_position }}"
    },
    {
      "type": "range",
      "id": "desktop_position_right",
      "label": "Right",
      "info": "0 = auto",
      "min": 0,
      "max": 400,
      "step": 5,
      "unit": "px",
      "default": 0,
      "visible_if": "{{ block.settings.enable_custom_position }}"
    },
    {
      "type": "range",
      "id": "desktop_position_bottom",
      "label": "Bottom",
      "info": "0 = auto",
      "min": 0,
      "max": 400,
      "step": 5,
      "unit": "px",
      "default": 0,
      "visible_if": "{{ block.settings.enable_custom_position }}"
    },
    {
      "type": "range",
      "id": "desktop_position_left",
      "label": "Left",
      "info": "0 = auto",
      "min": 0,
      "max": 400,
      "step": 5,
      "unit": "px",
      "default": 0,
      "visible_if": "{{ block.settings.enable_custom_position }}"
    },
    {
      "type": "range",
      "id": "positioned_desktop_max_width",
      "label": "t:global.image.maximum_width",
      "min": 20,
      "max": 500,
      "step": 5,
      "unit": "px",
      "default": 120,
      "visible_if": "{{ block.settings.enable_custom_position }}"
    }
  ],
  "presets": [
    {
      "name": "t:blocks.image.name"
    }
  ]
}
{% endschema %}
