{%- capture slide -%}
  {%- liquid
    assign is_first = false

    for section_block in section.blocks
      if block.id == section_block.id and forloop.first
        assign is_first = true
      endif
    endfor
  -%}

  <div class="content-box min-h-{{ section.settings.image_size }}">
    <div class="content-box__background-media with-overlay" style="--overlay: {{ block.settings.overlay_color.rgb }} / {{ block.settings.overlay_opacity | divided_by: 100.0 }}">
      {%- liquid
        if block.settings.video != blank
          if section.settings.autoplay and section.blocks.size > 1
            assign loop_video = false
          else
            assign loop_video = true
          endif

          render 'media', media: block.settings.video, mobile_media: block.settings.mobile_video, playsinline: true, autoplay: true, loop: loop_video, muted: true, controls: false, preload: true, show_play_button: false
        else
          echo 'hero-apparel-1' | placeholder_svg_tag: 'size-full'
        endif
      -%}
    </div>

    <div class="{{ block.settings.mobile_content_position }} {{ block.settings.desktop_content_position }}" style="max-width: {{ block.settings.content_max_width }}px">
      <div class="prose prose-justify-{{ block.settings.mobile_content_position | split: '-' | last }} sm:prose-justify-{{ block.settings.desktop_content_position | split: '-' | last }}">
        {%- content_for 'blocks' -%}
      </div>
    </div>
  </div>

  <script>
    (function() {
      var slide = document.currentScript && document.currentScript.closest('.slideshow__slide');
      if (!slide) return;
      var video = slide.querySelector('video-media[autoplay] video, video-media video');
      if (!video) return;
      var autoplayAttempts = 0;
      var autoplayTimer = null;

      function tryPlay() {
        video.muted = true;
        video.defaultMuted = true;
        video.playsInline = true;
        video.setAttribute('muted', '');
        video.setAttribute('playsinline', '');
        video.setAttribute('webkit-playsinline', '');
        video.setAttribute('autoplay', '');

        if (!video.paused) return;
        var p = video.play();
        if (p && p.catch) p.catch(function() {});
      }

      function stopAutoplayAttempts() {
        if (!autoplayTimer) return;
        clearInterval(autoplayTimer);
        autoplayTimer = null;
      }

      function startAutoplayAttempts() {
        stopAutoplayAttempts();
        autoplayAttempts = 0;
        autoplayTimer = setInterval(function() {
          autoplayAttempts += 1;
          tryPlay();

          if (!video.paused || autoplayAttempts >= 25 || !slide.classList.contains('is-selected')) {
            stopAutoplayAttempts();
          }
        }, 120);
      }

      function onActivated() {
        tryPlay();
        // iOS needs these — play() before data is buffered is a no-op on mobile Safari
        video.addEventListener('loadedmetadata', tryPlay, { once: true });
        video.addEventListener('canplay', tryPlay, { once: true });
        setTimeout(tryPlay, 120);
        setTimeout(tryPlay, 350);
        startAutoplayAttempts();
      }

      // Fire when this slide gains is-selected (user swipes to it)
      new MutationObserver(function() {
        if (slide.classList.contains('is-selected')) {
          onActivated();
        } else {
          stopAutoplayAttempts();
        }
      }).observe(slide, { attributes: true, attributeFilter: ['class'] });

      // First slide: already selected on load
      if (slide.classList.contains('is-selected')) {
        onActivated();
        // iOS back/forward cache restore
        window.addEventListener('pageshow', tryPlay);
        document.addEventListener('visibilitychange', function() {
          if (!document.hidden && slide.classList.contains('is-selected')) tryPlay();
        });
        window.addEventListener('load', function() {
          if (slide.classList.contains('is-selected')) onActivated();
        }, { once: true });
        // iOS last-resort: first touch anywhere unlocks autoplay
        document.addEventListener('touchstart', function handler() {
          tryPlay();
          document.removeEventListener('touchstart', handler);
        }, { passive: true });
      }

      video.addEventListener('play', stopAutoplayAttempts);
      video.addEventListener('ended', stopAutoplayAttempts);
    })();
  </script>
{%- endcapture -%}

{%- if block.settings.slide_link != blank -%}
  <a href="{{ block.settings.slide_link }}" class="slideshow__slide {% if is_first %}is-selected{% endif %} color-scheme color-scheme--{{ block.settings.color_scheme.id }}" data-slide-type="video" role="group" {{ block.shopify_attributes }}>
    {{- slide -}}
  </a>
{%- else -%}
  <div class="slideshow__slide {% if is_first %}is-selected{% endif %} color-scheme color-scheme--{{ block.settings.color_scheme.id }}" data-slide-type="video" role="group" {{ block.shopify_attributes }}>
    {{- slide -}}
  </div>
{%- endif -%}

