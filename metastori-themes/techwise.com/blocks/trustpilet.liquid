<style>
  .{{ block.id }}.trustpilet-cus{
    position:absolute;
    top: {{ block.settings.top_desktop }}%;
    left: {{ block.settings.left_desktop }}{{ block.settings.left_desktop_unit }};
    width: auto;
  }
  .trustpilet-cus img, .trustpilet-cus p { margin: 0; }
  .trustpilet-cus p {
      display: flex;
      gap: 7px;
      align-items: center;
      color: white;
  }
  .trustpilet-cus p span {
      display: flex !important;
      align-items: center;
      color: white;
  }
  @media(max-width:768px){
    .{{ block.id }}.trustpilet-cus{
      top: {{ block.settings.top_mobile }}%;
      left: {{ block.settings.left_mobile }}{{ block.settings.left_mobile_unit }};
    }
    .cus-trust-badges { width: 80px; }
  }
  @media(min-width:1400px){
    .shopify-section--image-with-text-overlay .{{ block.id }}.trustpilet-cus,
    .shopify-section--slideshow .{{ block.id }}.trustpilet-cus {
      left: 47px;
    }
    .collection-cashback-offer .shopify-section--image-with-text-overlay .{{ block.id }}.trustpilet-cus {
        top: 82%;
    }
  }
</style>

{%- assign lang = request.locale.iso_code | default: localization.language.iso_code | downcase | split: '-' | first -%}

{%- case lang -%}
  {%- when 'fr' -%}
    {%- assign stars_img = 'https://emailsignature.trustpilot.com/newsletter/fr-FR/1/617ff6896bc505ee409c533a/stars@2x.png' -%}
    {%- assign text_img  = 'https://emailsignature.trustpilot.com/newsletter/fr-FR/1/617ff6896bc505ee409c533a/text2_dark@2x.png' -%}
  {%- else -%}
    {%- assign stars_img = 'https://emailsignature.trustpilot.com/newsletter/nl-NL/1/617ff6896bc505ee409c533a/stars@2x.png' -%}
    {%- assign text_img  = 'https://emailsignature.trustpilot.com/newsletter/nl-NL/1/617ff6896bc505ee409c533a/text2_dark@2x.png' -%}
{%- endcase -%}

<div class="trustpilet-cus {{ block.id }}">
  <p style="text-align:center;">
    <span>
      <img src="{{ stars_img }}" alt="Trustpilot Stars" height="20" style="max-height:20px;" border="0">
    </span>
    <span style="display:inline-block;">
      <img src="{{ text_img }}" alt="number of reviews" height="18" style="max-height:18px;" border="0">
    </span>
  </p>
</div>

{% schema %}
{
  "name": "Trustpilet",
  "settings": [
    { "type": "range", "id": "top_desktop", "label": "Top Desktop (%)", "min": 0, "max": 100, "step": 1, "default": 0 },
    {
      "type": "select",
      "id": "left_desktop_unit",
      "label": "Left Desktop unit",
      "options": [
        { "value": "%", "label": "Percent (%)" },
        { "value": "px", "label": "Pixel (px)" }
      ],
      "default": "%"
    },
    { "type": "number", "id": "left_desktop", "label": "Left Desktop", "default": 1 },
    { "type": "range", "id": "top_mobile", "label": "Top Mobile (%)", "min": 0, "max": 100, "step": 1, "default": 0 },
    {
      "type": "select",
      "id": "left_mobile_unit",
      "label": "Left Mobile unit",
      "options": [
        { "value": "%", "label": "Percent (%)" },
        { "value": "px", "label": "Pixel (px)" }
      ],
      "default": "%"
    },
    { "type": "number", "id": "left_mobile", "label": "Left Mobile", "default": 1 }
  ],
  "presets": [
    { "name": "Trustpilet" }
  ]
}
{% endschema %}
