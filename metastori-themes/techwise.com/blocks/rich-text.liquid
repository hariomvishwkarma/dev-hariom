{%- if block.settings.text != blank -%}
  {%- liquid
    assign classes = ''
    if block.settings.content_width != 'full'
      assign classes = 'max-w-' | append: block.settings.content_width
    endif

    assign m_size = block.settings.mobile_font_size
    assign d_size = block.settings.desktop_font_size

    assign needs_style = false
    if m_size > 0 or d_size > 0 or block.settings.show_on_desktop == false or block.settings.show_on_mobile == false
      assign needs_style = true
    endif

    if needs_style
      assign classes = classes | append: ' rt-' | append: block.id
    endif
    assign classes = classes | strip
  -%}

  {%- if needs_style -%}
    {%- style -%}
      {%- if m_size > 0 -%}
        @media screen and (max-width: 749px) {
          .rt-{{ block.id }}, .rt-{{ block.id }} p, .rt-{{ block.id }} li { font-size: {{ m_size }}px; }
        }
      {%- endif -%}
      {%- if d_size > 0 -%}
        @media screen and (min-width: 750px) {
          .rt-{{ block.id }}, .rt-{{ block.id }} p, .rt-{{ block.id }} li { font-size: {{ d_size }}px; }
        }
      {%- endif -%}
      {%- unless block.settings.show_on_mobile -%}
        @media screen and (max-width: 749px) { .rt-{{ block.id }} { display: none !important; } }
      {%- endunless -%}
      {%- unless block.settings.show_on_desktop -%}
        @media screen and (min-width: 750px) { .rt-{{ block.id }} { display: none !important; } }
      {%- endunless -%}
    {%- endstyle -%}
  {%- endif -%}

  <div class="{{ classes }}" {{ block.shopify_attributes }}>
    {{- block.settings.text -}}
  </div>
{%- endif -%}

{% schema %}
{
  "name": "t:blocks.rich_text.name",
  "tag": null,
  "settings": [
    {
      "type": "richtext",
      "id": "text",
      "label": "t:global.text.content",
      "default": "<p>Write some text about your products or your brand.</p>"
    },
    {
      "type": "select",
      "id": "content_width",
      "label": "t:global.sizes.content_width",
      "options": [
        {
          "value": "xs",
          "label": "t:global.sizes.x_small"
        },
        {
          "value": "sm",
          "label": "t:global.sizes.small"
        },
        {
          "value": "md",
          "label": "t:global.sizes.medium"
        },
        {
          "value": "lg",
          "label": "t:global.sizes.large"
        },
        {
          "value": "full",
          "label": "t:global.sizes.full_width"
        }
      ],
      "default": "sm"
    },
    {
      "type": "header",
      "content": "Custom font size"
    },
    {
      "type": "range",
      "id": "mobile_font_size",
      "label": "Mobile font size",
      "info": "0 = keep the theme default (no override).",
      "min": 0,
      "max": 80,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "desktop_font_size",
      "label": "Desktop font size",
      "info": "0 = keep the theme default (no override).",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "header",
      "content": "Visibility"
    },
    {
      "type": "checkbox",
      "id": "show_on_desktop",
      "label": "Show on desktop",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_on_mobile",
      "label": "Show on mobile",
      "default": true
    }
  ],
  "presets": [
    {
      "name": "t:blocks.rich_text.name"
    }
  ]
}
{% endschema %}
