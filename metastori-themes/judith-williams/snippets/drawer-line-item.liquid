<div class="cart__item line_cart_item" data-key="{{ product.key }}">
  <div class="cart__image drawer_cart__image">
    <a href="{{ product.url }}" class="image-wrap">
      {%- render 'image-element',
        img: product,
        sizes: sizes,
        sizeVariable: sizeVariable,
        fallback: fallback,
        alt: product.product.title,
        widths: '180, 360, 540',
      -%}
    </a>
  </div>
  <div class="cart__item-details">
    <div class="cart__item-title">
      <a href="{{ product.url }}" class="cart__item-name cart_line_item-title">
        {{ product.product.title }}
      </a>
      <style>
        .cart__item-title .jdgm-widget-cart.jdgm-widget{
           display: none !important;
          margin-bottom: 5px;
          margin-top: -5px;
        }
      </style>
      <div style='{{ jm_style }}' class='jdgm-widget-cart jdgm-widget jdgm-preview-badge' data-id='{{ product.product.id }}' data-auto-install='false'>
        {{ product.product.metafields.judgeme.badge }}
      </div>
      {%- unless product.product.has_only_default_variant -%}
        <div class="cart__item--variants">
          {%- for option in product.options_with_values -%}
            <div><span>{{ option.name }}:</span> {{ option.value }}</div>
          {%- endfor -%}
        </div>
      {%- endunless -%}

    </div>
    <div class="line_item_prices">
      {% if product.total_discount > 0 %}
          {% if product.original_line_price > product.line_price %}
            <small class="cart__price cart_compare_price" >
              {%- render 'price' with product.original_line_price -%}
            </small>
          {% endif %}
          <span class="cart__price cart_final_price">
            {%- render 'price' with product.line_price -%}
          </span>
          {% if product.original_line_price > product.line_price %}
            <span class="lineitem_saving_label" >DU SPARST {{ product.original_line_price | minus:product.line_price | money }}</span>
          {% endif %}
        {% else %}
          {% if product.product.compare_at_price > product.original_price %}
            <small class="cart__price cart_compare_price" >
              {%- render 'price' with product.product.compare_at_price -%}
            </small>
          {% endif %}
          {% if product.original_price != product.final_price %}
            <span class="visually-hidden">{{ 'products.general.regular_price' | t }}</span>
            <small class="cart__price cart__price--strikethrough">
              {%- render 'price' with product.original_price -%}
            </small>
            <span class="visually-hidden">{{ 'products.general.sale_price' | t }}</span>
            <span class="cart__price cart__discount cart_final_price">
              {%- render 'price' with product.final_price -%}
            </span>
          {% else %}
            <span class="cart__price cart_final_price">
              {%- render 'price' with product.original_price -%}
            </span>
          {% endif %}
          {% if product.product.compare_at_price > product.original_price %}
            <span class="lineitem_saving_label" >DU SPARST {{ product.product.compare_at_price | minus:product.original_price | money }}</span>
          {% endif %}
        {% endif %}
      

      {%- assign property_size = product.properties | size -%}
      {% if property_size > 0 %}
        {% for p in product.properties %}
          {%- assign first_character_in_key = p.first | truncate: 1, '' -%}
          {% unless p.last == blank or first_character_in_key == '_' %}
            <div class="product__cart-properties">
              {{ p.first }}:
              {% if p.last contains '/uploads/' %}
                <a href="{{ p.last }}">{{ p.last | split: '/' | last }}</a>
              {% else %}
                {{ p.last }}
              {% endif %}
            </div>
          {% endunless %}
        {% endfor %}
      {% endif %}

      {%- if product.unit_price_measurement != blank -%}
        {%- capture unit_price_base_unit -%}
          <span class="product__unit-base--{{ section_id }}">
            {%- if product.unit_price_measurement -%}
              {%- if product.unit_price_measurement.reference_value != 1 -%}
                {{ product.unit_price_measurement.reference_value }}
              {%- endif -%}
              {{ product.unit_price_measurement.reference_unit }}
            {%- endif -%}
          </span>
        {%- endcapture -%}
        <span class="product__unit-price">{{ product.unit_price | money }}/{{ unit_price_base_unit }}</span>
      {%- endif -%}
      
    </div>
    
    <div class="cart__item-sub {% if product.product.id == settings.free_product.id %} free_item_qty{% endif %}">
      <div class="cart__item-quantity-col">
        <div class="js-qty__wrapper">
          <label for="cart_updates_{{ product.key }}" class="hidden-label">{{ 'cart.label.quantity' | t }}</label>
          <input type="text"
            id="cart_updates_{{ product.key }}"
            name="updates[]"
            class="js-qty__num cart_drawer_qty"
            value="{{ product.quantity }}"
            min="0"
            pattern="[0-9]*"
            data-id="{{ product.key }}">
          <button type="button"
            class="js-qty__adjust drawer-qty__adjust--minus"
            aria-label="{{ 'cart.general.reduce_quantity' | t }}">
              <svg xmlns="http://www.w3.org/2000/svg" width="12" height="2" viewBox="0 0 12 2" fill="none">
                <path d="M1 1.2041H10.8615" stroke="black" stroke-linecap="round"/>
              </svg>
              <span class="icon__fallback-text" aria-hidden="true">&minus;</span>
          </button>
          <button type="button"
            class="js-qty__adjust drawer-qty__adjust--plus"
            aria-label="{{ 'cart.general.increase_quantity' | t }}">
              <svg xmlns="http://www.w3.org/2000/svg" width="13" height="12" viewBox="0 0 13 12" fill="none">
                <path d="M1 6.20435H12.0942" stroke="black" stroke-linecap="round"/>
                <path d="M6.46252 0.989014L6.46252 11.2614" stroke="black" stroke-linecap="round"/>
              </svg>
              <span class="icon__fallback-text" aria-hidden="true">+</span>
          </button>
        </div>

        <a href="{{ routes.cart_change_url }}?id={{ product.key }}&amp;quantity=0" class="cart__remove text-link">
          {{ 'cart.general.remove' | t }}
        </a>
      </div>

      <div class="cart__item-price-col text-right" style="display:none!important;">
        {% if product.original_line_price != product.final_line_price %}
          <span class="visually-hidden">{{ 'products.general.regular_price' | t }}</span>
          <small class="cart__price cart__price--strikethrough">
            {%- render 'price' with product.original_line_price -%}
          </small>
          <span class="visually-hidden">{{ 'products.general.sale_price' | t }}</span>
          <span class="cart__price cart__discount">
            {%- render 'price' with product.final_line_price -%}
          </span>
        {% else %}
          <span class="cart__price">
            {%- render 'price' with product.original_line_price -%}
          </span>
        {% endif %}

        {%- if product.line_level_discount_allocations != blank -%}
          {%- for discount_allocation in product.line_level_discount_allocations -%}
            <small class="cart__discount">{{ discount_allocation.discount_application.title }} (-{{ discount_allocation.amount | money }})</small>
          {%- endfor -%}
        {%- endif -%}
      </div>
    </div>
  </div>
</div>
