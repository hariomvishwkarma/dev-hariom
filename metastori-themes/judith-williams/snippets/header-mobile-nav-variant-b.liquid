  {%- assign menu_objects = shop.metaobjects.menu_content.values -%}
  <div class="tab-menu">
    {%- for link in main_menu.links -%}
      {%- assign link_title_handle = link.title | handle -%}

      {% assign has_decoration = false %}
      {%- for metaobject in menu_objects -%}
        {% assign metaobject_menuname_handle = metaobject.menu_name.value | handle %}
        {% if link_title_handle == metaobject_menuname_handle %}
          {% assign has_decoration = metaobject.decorate_menu_title.value %}
        {% endif %}
      {% endfor %}

      {%- if link.links == blank -%}
        <a class="tab-label direct-link decoration_{{ has_decoration }}" href="{{ link.url }}">
          <span class="star-copy top-left-star">{% render 'top-left-star' %}</span>
          <span class="star-copy top-right-star">{% render 'top-right-star' %}</span>
          <span class="star-copy bottom-left-star">{% render 'top-right-star' %}</span>
          <span class="star-copy bottom-right-star">{% render 'bottom-right-star' %}</span>
          {{ link.title }}
        </a>
      {%- else -%}
        <button class="tab-label decoration_{{ has_decoration }}" data-tab="tab-{{ link.handle }}">
          <span class="star-copy top-left-star">{% render 'top-left-star' %}</span>
          <span class="star-copy top-right-star">{% render 'top-right-star' %}</span>
          <span class="star-copy bottom-left-star">{% render 'top-right-star' %}</span>
          <span class="star-copy bottom-right-star">{% render 'bottom-right-star' %}</span>
          {{ link.title }}
        </button>
      {%- endif -%}
    {%- endfor -%}
  </div>

  <div class="tab-contents">
    {%- for link in main_menu.links -%}
      {%- if link.links != blank -%}
        <div class="nav-tab-content{% if forloop.first %} active{% endif %}" id="tab-{{ link.handle }}">
          {%- for child_link in link.links -%}
            {%- assign child_title_handle = child_link.title | handle -%}
            {% assign decoration_true = '' %}
            {%- for metaobject in menu_objects -%}
              {%- for decorate_submenu in metaobject.decorate_submenu.value -%}
                {%- assign decorate_submenu_handle = decorate_submenu | handle -%}
                {% if decorate_submenu_handle == child_title_handle %}
                  {% assign decoration_true = 'decoration_true' %}
                {%- endif -%}
              {%- endfor -%}
            {%- endfor -%}
            <div class="submenu-level-2 {{ decoration_true }}">
              {%- if child_link.links == blank -%}
                <a class="submenu-link" href="{{ child_link.url }}">
                  {%- for metaobject in menu_objects -%}
                    {%- for submenu_image in metaobject.submenu_images.value -%}
                      {%- assign submenu_image_alt_handle = submenu_image.alt | handle -%}
                      {% if submenu_image_alt_handle == child_title_handle %}
                        {%- if submenu_image != blank -%}
                          <img
                            src="{{ submenu_image | image_url: width: 100 }}"
                            height="50"
                            width="50"
                            alt="{{ child_link.title }}"
                          >
                        {%- endif -%}
                      {%- endif -%}
                    {%- endfor -%}
                  {%- endfor -%}
                  <span>{{ child_link.title }}</span>
                </a>
              {%- else -%}
                <input type="checkbox" id="submenu-{{ child_link.handle }}-{{ forloop.index }}" class="submenu-toggle">
                <label for="submenu-{{ child_link.handle }}-{{ forloop.index }}">
                  <div class="submenu_image_title">
                    {%- assign child_title_handle = child_link.title | handle -%}
                    {%- for metaobject in menu_objects -%}
                      {%- for submenu_image in metaobject.submenu_images.value -%}
                        {%- assign submenu_image_alt_handle = submenu_image.alt | handle -%}
                        {% if submenu_image_alt_handle == child_title_handle %}
                          {%- if submenu_image != blank -%}
                            <img
                              src="{{ submenu_image | image_url: width: 100 }}"
                              height="50"
                              width="50"
                              alt="{{ child_link.title }}"
                            >
                          {%- endif -%}
                        {%- endif -%}
                      {%- endfor -%}
                    {%- endfor -%}
                    <span>{{ child_link.title }}</span>
                  </div>
                  <span class="swatch_icons">
                    <span class="plus_icon">
                      <svg width="12" height="12" viewBox="0 0 12 12" fill="none" xmlns="http://www.w3.org/2000/svg">
                        <path d="M12 6C12 6.13261 11.9473 6.25979 11.8536 6.35355C11.7598 6.44732 11.6326 6.5 11.5 6.5H6.5V11.5C6.5 11.6326 6.44732 11.7598 6.35355 11.8536C6.25979 11.9473 6.13261 12 6 12C5.86739 12 5.74021 11.9473 5.64645 11.8536C5.55268 11.7598 5.5 11.6326 5.5 11.5V6.5H0.5C0.367392 6.5 0.240215 6.44732 0.146447 6.35355C0.0526785 6.25979 0 6.13261 0 6C0 5.86739 0.0526785 5.74021 0.146447 5.64645C0.240215 5.55268 0.367392 5.5 0.5 5.5H5.5V0.5C5.5 0.367392 5.55268 0.240215 5.64645 0.146447C5.74021 0.0526785 5.86739 0 6 0C6.13261 0 6.25979 0.0526785 6.35355 0.146447C6.44732 0.240215 6.5 0.367392 6.5 0.5V5.5H11.5C11.6326 5.5 11.7598 5.55268 11.8536 5.64645C11.9473 5.74021 12 5.86739 12 6Z" fill="black"/>
                      </svg>
                    </span>
                    <span class="minus_icon">
                      <svg width="16" height="16" viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg">
                        <path d="M14 8C14 8.13261 13.9473 8.25979 13.8536 8.35355C13.7598 8.44732 13.6326 8.5 13.5 8.5H2.5C2.36739 8.5 2.24021 8.44732 2.14645 8.35355C2.05268 8.25979 2 8.13261 2 8C2 7.86739 2.05268 7.74021 2.14645 7.64645C2.24021 7.55268 2.36739 7.5 2.5 7.5H13.5C13.6326 7.5 13.7598 7.55268 13.8536 7.64645C13.9473 7.74021 14 7.86739 14 8Z" fill="black"/>
                      </svg>
                    </span>
                  </span>
                </label>
                <div class="submenu-content">
                  {%- for grandchild_link in child_link.links -%}
                    <div class="menu-level-3">
                      <a href="{{ grandchild_link.url }}">{{ grandchild_link.title }}</a>
                    </div>
                  {%- endfor -%}
                </div>
              {%- endif -%}
            </div>
          {%- endfor -%}

          {%- for metaobject in menu_objects -%}
            {% assign metaobject_linktitle_handle = link.title | handle %}
            {% assign metaobject_menuname_handle = metaobject.menu_name.value | handle %}
            {%- if metaobject_linktitle_handle == metaobject_menuname_handle
              and metaobject.promotional_images.value != blank
            -%}
              {% assign promotional_images_content = metaobject.promotional_images_content.value %}
              {% assign promotional_images_link = metaobject.promotional_images_link.value %}
              <div class="promotional-banner-wrapper">
                {%- for image in metaobject.promotional_images.value -%}
                  <a href="{{ promotional_images_link[forloop.index0] }}" class="promotional-item">
                    <img src="{{ image | image_url: width: 150 }}" height="auto" width="150" alt="Promo Image">
                    <div class="promotional-caption">
                      {{ promotional_images_content[forloop.index0] }}
                    </div>
                  </a>
                {%- endfor -%}
              </div>
            {%- endif -%}
          {%- endfor -%}
        </div>
      {%- endif -%}
    {%- endfor -%}
  </div>

<style>
