{% if settings.discount_enable %}
  <div class="discount_container active">
    <div class="discount_title">
      <svg class="close_icon_dis_acc" xmlns="http://www.w3.org/2000/svg" width="16" height="16">
        <path fill="currentColor" d="M8 1.5C6.714 1.5 5.458 1.881 4.389 2.595 3.32 3.31 2.487 4.325 1.995 5.513 1.503 6.7 1.374 8.007 1.625 9.268c.25 1.261.87 2.419 1.778 3.328 0 0 0 0 0 0 0 0 .001.001.002.001C5.471 14.124 6.732 14.375 7.993 14.626c1.261.25 2.568.122 3.756-.37 1.188-.492 2.203-1.325 2.918-2.394.715-1.069 1.096-2.325 1.098-3.61C15.498 6.277 14.813 4.625 13.594 3.406S9.723 1.502 8 1.5Zm2.5 7h-2v2c0 .133-.053.26-.147.354a.5.5 0 0 1-.707 0A.5.5 0 0 1 7.5 10.5v-2h-2a.5.5 0 0 1-.354-.147.5.5 0 0 1 0-.707A.5.5 0 0 1 5.5 7.5h2v-2a.5.5 0 0 1 .853-.354.5.5 0 0 1 .147.354v2h2a.5.5 0 0 1 .354.853.5.5 0 0 1-.354.147Z"/>
      </svg>
      <span class="add_voucher">{{ settings.add_voucher }}</span>
      <span class="add_voucher_close">{{ settings.add_voucher_close }}</span>
    </div>

    <div class="discount_code_field_wrap">
      <div class="discount_code_field">
        <input id="discount-code" class="discount_coupen" placeholder="{{ settings.input_title }}">
        <button id="apply-discount" type="button" class="discount_apply_btn">{{ settings.apply_label }}</button>
      </div>
    </div>
    <div class="mgss">
      <div id="applied-discount"></div>
      <div id="discount-message"></div>
    </div>
  </div>
{% endif %}
