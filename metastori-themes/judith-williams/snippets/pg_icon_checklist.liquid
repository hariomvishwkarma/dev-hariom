{%- assign icon = block.settings.icon -%}

<div class="pg-icon-checklist product-block" {{ block.shopify_attributes }}>
  <ul class="pg-icon-checklist__list" role="list">
    {%- assign t1 = block.settings.item_1 | strip_html | strip -%}
    {%- if t1 != blank -%}
      <li class="pg-icon-checklist__item">
        {%- if icon != blank -%}
          <img
            class="pg-icon-checklist__icon"
            src="{{ icon | image_url: width: 32 }}"
            width="16"
            height="16"
            loading="lazy"
            alt="{{ icon.alt | escape }}"
          >
        {%- endif -%}
        <div class="pg-icon-checklist__text">{{ block.settings.item_1 }}</div>
      </li>
    {%- endif -%}

