<div class="page-width glossary-item" itemscope itemprop="mainEntity" itemtype="https://schema.org/Question">
  <button
    type="button"
    id="{{ block.settings.label | url_escape }}"
    class="collapsible-trigger collapsible-trigger-btn collapsible--auto-height text-left"
    aria-controls="FAQ-content-{{ block.id }}">
      <span itemprop="name">{{ block.settings.label }}</span>
      {%- render 'collapsible-icons' -%}
  </button>

  <div
    data-id="FAQ-content-{{ block.id }}"
    class="collapsible-content collapsible-content--all collapsible--auto-height"
    itemscope
    itemprop="acceptedAnswer"
    itemtype="https://schema.org/Answer">
    <div
      class="collapsible-content__inner rte collapsible-content__inner_{{ count }}"
      itemprop="text"
      {% if block.settings.media != 'none' %}
        style="display: flex;"
      {% endif %}
    >
      {% if block.settings.media == 'video' %}
        <div class="video_popup_div" style="background-image: url('{{ block.settings.image | img_url: '4000x' }}');">
          <style>
            .banner_popupvideo .trailer_{{ count }} {
                position: fixed;
                top: 0;
                left: 50%;
                transform: translate(-50%,0);
                z-index: 999999;
                background: rgb(0,0,0);
                width: 100vw;
                height: 100vh;
                display: flex;
                justify-content: center;
                align-items: center;
                visibility: hidden;
                opacity: 0;
            }

            .banner_popupvideo .trailer_{{ count }} video {
                position: relative;
                max-width: 900px;
                outline: none;
            }

            .banner_popupvideo .trailer_{{ count }}.active {
                visibility: visible;
                opacity: 1;
            }

            .banner_popupvideo .trailer_{{ count }}.active .shopify-section {
                width: 100%;
            }

            .banner_popupvideo .video_popup_link-content {
              background-color: {{ section.settings.bg_color }};
            }

            @media only screen and (max-width: 991px) {
                .banner_popupvideo .trailer_{{ count }} video {
                    max-width: 90%;
                }
            }
          </style>

          <div class="video_popup">
            <div class="banner_popupvideo">
              <div class="content">
                <a href="#" class="video_popup_link" onclick="toggle_trailer({{ count }});">
                  <div class="video_popup_link-content">
                    <svg
                      version="1.1"
                      id="Capa_1"
                      xmlns="http://www.w3.org/2000/svg"
                      xmlns:xlink="http://www.w3.org/1999/xlink"
                      x="0px"
                      y="0px"
                      viewBox="0 0 17.804 17.804"
                      xml:space="preserve"
                      fill="currentColor"
                    >
                      <path d="M2.067,0.043C2.21-0.028,2.372-0.008,2.493,0.085l13.312,8.503c0.094,0.078,0.154,0.191,0.154,0.313 c0,0.12-0.061,0.237-0.154,0.314L2.492,17.717c-0.07,0.057-0.162,0.087-0.25,0.087l-0.176-0.04 c-0.136-0.065-0.222-0.207-0.222-0.361V0.402C1.844,0.25,1.93,0.107,2.067,0.043z" />
                    </svg>
                  </div>
                </a>
                <div class="trailer_{{ count }}">
                  {% include 'featured-video-block-faq' %}
                  <svg
                    class="close"
                    onclick="toggle_trailer({{ count }})"
                    version="1.1"
                    xmlns="http://www.w3.org/2000/svg"
                    xmlns:xlink="http://www.w3.org/1999/xlink"
                    x="0px"
                    y="0px"
                    viewBox="0 0 94.926 94.926"
                    xml:space="preserve"
                  >
                    <g>
                        <path d="M55.931,47.463L94.306,9.09c0.826-0.827,0.826-2.167,0-2.994L88.833,0.62C88.436,0.224,87.896,0,87.335,0
                            c-0.562,0-1.101,0.224-1.498,0.62L47.463,38.994L9.089,0.62c-0.795-0.795-2.202-0.794-2.995,0L0.622,6.096
                            c-0.827,0.827-0.827,2.167,0,2.994l38.374,38.373L0.622,85.836c-0.827,0.827-0.827,2.167,0,2.994l5.473,5.476
                            c0.397,0.396,0.936,0.62,1.498,0.62s1.1-0.224,1.497-0.62l38.374-38.374l38.374,38.374c0.397,0.396,0.937,0.62,1.498,0.62
                            s1.101-0.224,1.498-0.62l5.473-5.476c0.826-0.827,0.826-2.167,0-2.994L55.931,47.463z"/>
                        </g>
                  </svg>
                </div>
              </div>
            </div>
          </div>
        </div>

        <script type="text/javascript">
          function toggle_trailer (count) {
            console.log("test");
            const trailer = document.querySelector(`.trailer_${count}`);
            if(trailer) {
                trailer.classList.toggle("active");
            }
        }
        </script>

      {% elsif block.settings.media == 'image' %}
        <div class="faq_block_image">
          <a
            href="{{ block.settings.single_image_url }}"
            {% if block.settings.single_image_url == blank %}
              style="pointer-events: none;"
            {% endif %}
          >
            {{ block.settings.single_image | image_url: width: 1024 | image_tag: loading: 'lazy', alt: block.settings.single_image.alt, widths: '200, 500, 700, 1024, 1500' }}
          </a>
        </div>
      {% endif %}

      <style>
        {% if block.settings.media != 'none' %}
          .faq_div .is-open .collapsible-content__inner_{{ count }} p {
            margin-left: {{ settings.grid_spacing | default: "28" }}px;
            width: calc(100% - 332px - {{ settings.grid_spacing | default: "28" }}px);
          }
        {% endif %}
      </style>

      {{ block.settings.text }}
    </div>
  </div>
</div>
