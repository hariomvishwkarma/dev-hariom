<style>
    .icon-label-group {
      display: flex !important; 
      gap: 22px;
      align-items: center;
      justify-content: flex-start;
      flex-wrap: wrap;
      margin-bottom: 30px;
      display:none;
    }

    .icon-label {
      display: flex;
      align-items: center;
      font-size: 13px;
      color: #000;
      gap: 2px;
      background: #E8E8E1;
      padding: 10px 15px;
    }

    .icon {
      width: 24px;
      height: 24px;
      display: flex;
      align-items: center;
      justify-content: center;
    }
    @media only screen and (max-width: 600px) {
     .icon-label-group {
        margin-bottom: 22px;
        padding-top: 7px;
        gap: 12px;
    }
  }
</style>
{% if product.metafields.global.hautbeduerfnis %}
  <div class="icon-label-group">
    {% for item in product.metafields.global.hautbeduerfnis.value %}
      <div class="icon-label">
        <span>{{ item }}</span>
      </div>
    {% endfor %}
  </div>
{% endif %}
