<style>
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.50 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.50 | round: 0 }}px;
  }
  .schedule_widget_main {
    max-width: 940px;
    margin: 0 auto;
  }

  .single_widget {
      gap: 25px;
      display: flex;
      flex-direction: row;
      padding: 20px;
      margin: 10px 0;
      overflow: hidden;
      align-items: center;
      min-height: 40px;
      background-color: rgb(242, 242, 242);
      border-radius: 12px;
  }

  #appointments-list {
      display: flex;
      flex-direction: column;
  }

  .event_date {
      display: flex;
      flex-direction: column;
      padding-left: 14px;
  }

  .event_date .day {
      font-size: 26px;
      font-weight: bold;
      line-height: 24px;
      text-align: center;
  }

  .event_date .month {
      font-size: 13px;
      line-height: 14px;
      text-align: center;
      text-transform: uppercase;
  }

  .event_banner img {
      border-radius: 8px;
  }

  .event_detail {
      display: flex;
      flex-direction: column;
  }

  .event_detail .event_name {
      color: rgb(29, 33, 41);
      font-size: 18px;
      font-weight: bold;
  }

  span.event_description {
      color: rgba(29, 33, 41, 0.7);
      font-size: 15px;
  }

  .event_time_location {
      margin: 4px -4px 0;
      display: flex;
  }

  .event_time_main {
      margin: 4px 4px 0;
      overflow: hidden;
      text-overflow: ellipsis;
      white-space: nowrap;
      display: inline-flex;
      background: rgba(29, 33, 41, 0.06);
      border-radius: 13px;
      background-color: rgba(17, 17, 17, 0.06);
      padding: 4px 16px 4px 7px;
      display: flex;
      flex-direction: row;
      align-items: center;
      max-width: 100%;
  }

  span.event_time {
      color: rgb(29, 33, 41);
      font-size: 13px;
      line-height: 1.2;
      margin-left: 10px;
  }
  .pagination_appointment {
    display: flex;
    gap: 10px;
    margin-top: 20px;
    align-items: center;
    flex-wrap: wrap;
    justify-content: center;
  }

  .pagination_appointment button {
    background: none;
    border: none;
    color: #e77b8d; /* Pinkish tone like in image */
    font-size: 16px;
    cursor: pointer;
    padding: 6px 10px;
  }

  .pagination_appointment .active {
    color: #aaa; /* Light gray for current page */
    cursor: default;
    pointer-events: none;
  }

  .pagination_appointment .ellipsis {
    cursor: default;
    color: #000;
  }

  .pagination_appointment .next-btn {
    background: #e77b8d;
    color: white;
    border-radius: 50%;
    width: 44px;
    height: 44px;
    font-size: 20px;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .pagination_appointment .next-btn .icon.icon-chevron-right {
    width: 13px;
    height: 13px;
  }
  @media screen and (min-width: 990px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
  @media screen and (max-width: 599px) {
    .event_date {
        padding: 0;
    }

    .event_detail {
        width: 68%;
    }

    .event_time_location {
        flex-wrap: wrap;
    }

    .single_widget {
        gap: 12px;
    }

    .event_banner {
        flex-shrink: 0;
    }

    .event_detail .event_name {
        font-size: 17px;
        line-height: 1.3;
    }
  }
</style>

<div
  class="schedule_widget_wr section-{{ section.id }}-padding"
  id="schedule_widget_wr"
  role="region"
  aria-label="Appointments"
>
  <div class="page-width">
    <div class="schedule_widget_main">
      {% if section.settings.schedule_widget_head != blank %}
        <h2 id="appointments-heading" class="Heading">{{ section.settings.schedule_widget_head }}</h2>
      {% endif %}
      <div class="schedule_widgets" id="appointments-list">
        <div class="widget-list" role="list">
          {% assign appointments = page.metafields.custom.appointments_schedule.value %}
          {% assign now = 'now' | date: '%s' %}
          {% paginate appointments by 1000 %}
            {% for appointment in appointments %}
              {% assign event_start_date_time = appointment.start_date | date: '%s' %}
              {% assign event_end_date_time = appointment.end_date | date: '%s' %}
              {% assign event_date = appointment.event_date | date: '%s' %}
              {% if event_start_date_time <= now and event_end_date_time >= now %}
                {% assign month_en = appointment.event_date | date: '%B' %}
                {% assign day = appointment.event_date | date: '%-d' %}
                {% case month_en %}
                  {% when 'January' -%}
                    {%- assign month = 'Januar' %}
                  {% when 'February' -%}
                    {%- assign month = 'Februar' %}
                  {% when 'March' -%}
                    {%- assign month = 'März' %}
                  {% when 'April' -%}
                    {%- assign month = 'April' %}
                  {% when 'May' -%}
                    {%- assign month = 'Mai' %}
                  {% when 'June' -%}
                    {%- assign month = 'Juni' %}
                  {% when 'July' -%}
                    {%- assign month = 'Juli' %}
                  {% when 'August' -%}
                    {%- assign month = 'August' %}
                  {% when 'September' -%}
                    {%- assign month = 'September' %}
                  {% when 'October' -%}
                    {%- assign month = 'Oktober' %}
                  {% when 'November' -%}
                    {%- assign month = 'November' %}
                  {% when 'December' -%}
                    {%- assign month = 'Dezember' %}
                {% endcase %}
                <div
                  class="single_widget"
                  role="listitem"
                  aria-label="{{ appointment.event_name }} on {{ appointment.event_date | date: '%B %d, %Y' }}"
                  data-start="{{ event_date }}"
                  data-time="{{ appointment.event_time }}"
                >
                  <div class="event_date">
                    <span class="month">{{ month }}</span> <span class="day">{{ day }}</span>
                  </div>
                  <div class="event_banner">
                    <img
                      src="{{ appointment.event_banner | image_url: width: 200}}"
                      width="64"
                      height="64"
                      alt="{{ appointment.event_banner.alt }}"
                    >
                  </div>
                  <div class="event_detail">
                    <span class="event_name">{{ appointment.event_name }}</span>
                    <span class="event_description">{{ appointment.event_description }}</span>
                    <div class="event_time_location">
                      <div class="event_time_main">
                        {% render 'icon-clock' %}
                        <span class="event_time">{{ appointment.event_time }}</span>
                      </div>
                      <div class="event_time_main">
                        {% render 'icon-location' %}
                        <span class="event_time">{{ appointment.event_location }}</span>
                      </div>
                    </div>
                  </div>
                </div>
              {% endif %}
            {% endfor %}
          {% endpaginate %}
        </div>
        <div id="pagination" class="pagination_appointment" role="navigation" aria-label="Appointment Pagination"></div>
      </div>
    </div>
  </div>
</div>

<script>
  const perPage = {{ section.settings.event_per_page }};
  let currentPage = 1;
  const pagination = document.getElementById('pagination');

  // function sortWidgets() {
  //   const container = document.querySelector("#appointments-list .widget-list");
  //   const widgets = Array.from(container.querySelectorAll(".single_widget"));
  //   widgets.sort((a, b) => parseInt(a.getAttribute("data-start")) - parseInt(b.getAttribute("data-start")));
  //   widgets.forEach(widget => container.appendChild(widget));
  //   return widgets;
  // }
  function sortWidgets() {
  const container = document.querySelector("#appointments-list .widget-list");
  const widgets = Array.from(container.querySelectorAll(".single_widget"));
  
  widgets.sort((a, b) => {
    const dateA = parseInt(a.getAttribute("data-start"));
    const dateB = parseInt(b.getAttribute("data-start"));
    
    if (dateA !== dateB) {
      return dateA - dateB;
    }
    

    const timeA = a.getAttribute("data-time").split('-')[0].trim(); 
    const timeB = b.getAttribute("data-time").split('-')[0].trim();
    
    const minutesA = parseInt(timeA.split(':')[0]) * 60 + parseInt(timeA.split(':')[1]);
    const minutesB = parseInt(timeB.split(':')[0]) * 60 + parseInt(timeB.split(':')[1]);
    
    return minutesA - minutesB;
  });
  
  widgets.forEach(widget => container.appendChild(widget));
  return widgets;
} 

  function showPage(page, widgets) {
    widgets.forEach((item, index) => {
      item.style.display = (index >= (page - 1) * perPage && index < page * perPage) ? 'flex' : 'none';
    });
    renderPagination(page, widgets);
  }

  function renderPagination(current, widgets) {
    const totalPages = Math.ceil(widgets.length / perPage);
    pagination.innerHTML = '';
    function scrollToSection() {
      document.getElementById('schedule_widget_wr')?.scrollIntoView({ behavior: 'smooth', block: 'start' });
    }
    function createButton(text, page, isActive = false, isEllipsis = false) {
      const btn = document.createElement('button');
      btn.innerText = text;
      if (isEllipsis) {
        btn.classList.add('ellipsis');
        btn.setAttribute('aria-hidden', 'true');
        btn.setAttribute('tabindex', '-1');
      } else {
        btn.setAttribute('aria-label', `Go to page ${text}`);
        if (isActive) btn.classList.add('active'), btn.setAttribute('aria-current', 'page');
        btn.addEventListener('click', () => {
          currentPage = page;
          showPage(currentPage, widgets);
          scrollToSection();
        });
      }
      pagination.appendChild(btn);
    }
    const maxVisible = 3;
    createButton(1, 1, current === 1);
    if (current > maxVisible) createButton('...', null, false, true);
    for (let i = current - 1; i <= current + 1; i++) {
      if (i > 1 && i < totalPages) createButton(i, i, i === current);
    }
    if (current < totalPages - maxVisible) createButton('...', null, false, true);
    if (totalPages > 1) createButton(totalPages, totalPages, current === totalPages);
    if (current < totalPages) {
      const nextBtn = document.createElement('button');
      nextBtn.innerHTML = '<svg aria-hidden="true" class="icon icon-chevron-right" viewBox="0 0 284.49 498.98"><path d="M35 498.98a35 35 0 0 1-24.75-59.75l189.74-189.74L10.25 59.75a35.002 35.002 0 0 1 49.5-49.5l214.49 214.49a35 35 0 0 1 0 49.5L59.75 488.73A34.89 34.89 0 0 1 35 498.98z"></path></svg>';
      nextBtn.classList.add('next-btn');
      nextBtn.setAttribute('aria-label', 'Next page');
      nextBtn.addEventListener('click', () => {
        currentPage++;
        showPage(currentPage, widgets);
        scrollToSection();
      });
      pagination.appendChild(nextBtn);
    }
  }

  document.addEventListener("DOMContentLoaded", function () {
    const sortedWidgets = sortWidgets();
    showPage(currentPage, sortedWidgets);
  });
</script>

{% schema %}
{
  "name": "Appointment Widget",
  "settings": [
    {
      "id": "event_per_page",
      "type": "number",
      "label": "Event per page",
      "default": 5
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "label": "Top Padding",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "label": "Bottom Padding",
      "default": 40
    }
  ],
  "presets": [
    {
      "name": "Appointment Widget"
    }
  ]
}
{% endschema %}
