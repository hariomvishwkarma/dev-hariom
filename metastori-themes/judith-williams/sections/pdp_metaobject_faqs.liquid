<style>
  .product-faq__wrapper {
    margin: 0 auto;
    display: flex;
    align-items: flex-start;
  }
  .product-faq__left { flex: 1; padding-right: 20px; }
  .product-faq__intro { font-size: 14px; color: #666; margin-bottom: 20px; }
  .product-faq__contact { margin-top: 20px; }
  .product-faq__contact a { text-decoration: none; padding: 10px 20px; font-size: 14px; display: inline-block; }
  .product-faq__accordion { flex: 2; display: flex; flex-direction: column; gap: 16px; }
  .product-faq__item { background: #fff; border: 1px solid #ddd; border-radius: 4px; overflow: hidden; }
  .product-faq__toggle { width: 100%; padding: 16px; font-size: 16px; font-weight: 500; background: none; border: none; text-align: left; display: flex; justify-content: space-between; align-items: center; cursor: pointer; }
  .product-faq__toggle[aria-expanded="true"] .product-faq__icon { transform: rotate(180deg); }
  .product-faq__toggle .product-faq__question { text-align: left; display: block; width: 100%; font-weight: 700; font-size: calc(var(--typeBaseSize) + 3px); }
  .product-faq__icon { position: relative; width: var(--collapsibleIconWidth); height: var(--collapsibleIconWidth); }
  .product-faq__content-inner { max-height: 0; overflow: hidden; transition: max-height 0.3s ease, padding 0.3s ease; padding: 0 16px; }
  .product-faq__item.active .product-faq__content-inner { padding-bottom: 16px; }
  .product-faq__answer { font-size: 15px; color: #444; }
  .section-{{ section.id }}-padding { padding-top: {{ section.settings.padding_top | times: 0.5 | round: 0 }}px; padding-bottom: {{ section.settings.padding_bottom | times: 0.5 | round: 0 }}px; }
  @media screen and (min-width: 990px) {
    .section-{{ section.id }}-padding { padding-top: {{ section.settings.padding_top }}px; padding-bottom: {{ section.settings.padding_bottom }}px; }
  }
  @media screen and (max-width: 767px) {
    .product-faq__wrapper { flex-direction: column-reverse; gap: 20px; }
    .product-faq__left { padding-right: 0; }
    span.product-faq__question { font-size: 15px; line-height: 1.4; }
    .product-faq__toggle { padding: 13px; }
    .product-faq__left h2.h3.section-header__titles { display: none; }
    .product-faq__accordion h2.h3.section-header__titles{ display: block !important; }
  }
</style>

{%- comment -%}
  Detect if at least one FAQ pair exists at the metafield level
{%- endcomment -%}
{% assign has_faq = false %}
{% for i in (1..20) %}
  {% assign q_key = 'faq_question_' | append: i %}
  {% assign a_key = 'faq_answer_'   | append: i %}
  {% assign question = product.metafields.global[q_key] %}
  {% assign answer   = product.metafields.global[a_key] %}
  {% if question != blank and answer != blank %}
    {% assign has_faq = true %}
    {% break %}
  {% endif %}
{% endfor %}

{% if has_faq %}
<section style="background-color: {{ section.settings.bg_color }};" class="product-faq section-{{ section.id }}-padding" itemscope itemtype="https://schema.org/FAQPage">
  <div class="page-width">
    <div class="product-faq__wrapper">
      <div class="product-faq__left">
        <h2 class="h3 section-header__titles">{{ section.settings.heading }}</h2>
        <div class="product-faq__intro">{{ section.settings.intro_text }}</div>
        <div class="product-faq__contact">
          <a class="btn" href="{{ section.settings.contact_url }}">{{ section.settings.button_text }}</a>
        </div>
      </div>

      <div class="product-faq__accordion">
        <h2 class="h3 section-header__titles" style="display:none">{{ section.settings.heading }}</h2>

        {%- for i in (1..20) -%}
          {% assign q_key = 'faq_question_' | append: i %}
          {% assign a_key = 'faq_answer_'   | append: i %}
          {% assign question = product.metafields.global[q_key] %}
          {% assign answer   = product.metafields.global[a_key] %}

          {% if question != blank and answer != blank %}
            <div class="product-faq__item" itemprop="mainEntity" itemscope itemtype="https://schema.org/Question">
              <button class="product-faq__toggle" type="button" aria-expanded="false" itemprop="name">
                <span class="product-faq__question">{{ question }}</span>
                <span class="product-faq__icon">{% render 'collapsible-icons' %}</span>
              </button>
              <div class="product-faq__content-inner" itemprop="acceptedAnswer" itemscope itemtype="https://schema.org/Answer">
                <div class="product-faq__answer" itemprop="text">{{ answer }}</div>
              </div>
            </div>
          {% endif %}
        {%- endfor -%}
      </div>
    </div>
  </div>
</section>

<script>
  function initFaqToggle(scope = document) {
    const faqItems = scope.querySelectorAll(".product-faq__item");
    faqItems.forEach(item => {
      const toggle = item.querySelector(".product-faq__toggle");
      const content = item.querySelector(".product-faq__content-inner");
      toggle.addEventListener("click", function () {
        const isExpanded = this.getAttribute("aria-expanded") === "true";
        faqItems.forEach(el => {
          el.classList.remove("active");
          el.querySelector(".product-faq__toggle").setAttribute("aria-expanded", "false");
          const inner = el.querySelector(".product-faq__content-inner");
          inner.style.maxHeight = null;
        });
        if (!isExpanded) {
          item.classList.add("active");
          this.setAttribute("aria-expanded", "true");
          content.style.maxHeight = content.scrollHeight + 16 + "px";
        }
      });
    });
  }
  document.addEventListener("DOMContentLoaded", () => { initFaqToggle(); });
  document.addEventListener("shopify:section:load", e => { initFaqToggle(e.target); });
</script>
{% endif %}

{% schema %}
{
  "name": "Product FAQ (Metafields)",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "FREQUENT QUESTIONS" },
    { "type": "color", "id": "bg_color", "label": "Background color", "default": "#f9f9f9" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 100, "step": 2, "unit": "px", "label": "Top Padding", "default": 40 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 100, "step": 2, "unit": "px", "label": "Bottom Padding", "default": 40 },
    { "type": "url", "id": "contact_url", "label": "Contact URL" },
    { "type": "richtext", "id": "intro_text", "label": "Intro Text", "default": "<p>Oh, scheint als hätte ich keine Antwort zu den häufigsten Fragen! Ist deine Frage noch unbeantwortet geblieben, kontaktiere gern unseren Customer Support.</p>" },
    { "type": "text", "id": "button_text", "label": "Button Text", "default": "KONTAKT" }
  ],
  "presets": [{ "name": "Product FAQ" }]
}
{% endschema %}
