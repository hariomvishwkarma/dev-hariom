  "class" : "text-columns-with-images",
  "settings": [
    {
      "type": "select",
      "id": "heading_tag",
      "label": "t:common.heading_tag.label",
      "options": [
        {
          "value": "h1",
          "label": "t:common.heading_tag.options.h1.label"
        },
        {
          "value": "h2",
          "label": "t:common.heading_tag.options.h2.label"
        },
        {
          "value": "h3",
          "label": "t:common.heading_tag.options.h3.label"
        }
      ],
      "default": "h2"
    },
    {
      "type": "text",
      "id": "title",
      "label": "t:sections.text-columns.settings.title.label"
