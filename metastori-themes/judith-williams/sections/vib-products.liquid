<div class="index-section text-center" id="section-{{ section.id }}">
  <div class="page-width{% if section.settings.narrow_column %} page-width--narrow{% endif %}">
    <h2>{{ section.settings.heading }}</h2>
    <p>{{ section.settings.subheading }}</p>

    {%- capture btn_icon -%}
      {%- if section.settings.button_icon -%}
        {{ section.settings.button_icon | image_url: height: 20 | image_tag: loading: 'lazy', alt: section.settings.button_icon.alt, heights: '20', class: "image" }}
      {%- endif -%}
    {%- endcapture -%}

    <div class="vib-products">
      {%- for block in section.blocks -%}
        {%- if block.settings.product -%}
          <div class="vib-product">
            <a href="{{ block.settings.product.url }}">
            {{ block.settings.product.featured_media.preview_image | image_url: width: 200 | image_tag: loading: 'lazy', alt: block.settings.product.featured_media.preview_image.alt, widths: '200, 300, 400, 500, 600, 700', class: "image" }}
            
            <div class="vib-points">{{ block.settings.points }}{{ btn_icon }}</div>
            
            <a class="vib-product__info text--small" href="{{ block.settings.product.url }}">
              <div class="vib-product__title">{{ block.settings.product.title }}</div>
              {%- if block.settings.product.type != blank -%}
                <div class="vib-product__vendor">{{ block.settings.product.type }}</div>
              {%- endif -%}
            </a>
  
            <a href="{{ section.settings.redeem_link }}" class="btn btn--primary">{{ 'sections.vib_products.redeem_text' | t }}</a>
          </div>
        {%- endif -%}
      {%- endfor -%}
    </div>
  </div>
</div>

<style>
  @media screen and (min-width:769px){
    #section-{{ section.id }} .vib-products {
      grid-template-columns: repeat({{ section.settings.products_per_row }}, 1fr);
    }
  }
</style>

{% schema %}
{
  "name": "t:sections.vib_products.name",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "t:sections.vib_products.settings.heading.label"
    },
    {
      "type": "richtext",
      "id": "subheading",
      "label": "t:sections.vib_products.settings.subheading.label"
    },
    {
      "type": "url",
      "id": "redeem_link",
      "label": "t:sections.vib_products.settings.redeem_link.label"
    },
    {
      "type": "checkbox",
      "id": "narrow_column",
      "label": "t:sections.vib_products.settings.narrow_column.label",
      "default": true
    },
    {
      "type": "range",
      "id": "products_per_row",
      "label": "t:sections.vib_products.blocks.product.settings.products_per_row.label",
      "default": 3,
      "min": 3,
      "max": 6,
      "step": 1
    },
    {
      "type": "image_picker",
      "id": "button_icon",
      "label": "t:sections.vib_products.settings.button_icon.label"
    }
  ],
  "blocks": [
    {
      "type": "product",
      "name": "t:sections.vib_products.blocks.product.name",
      "settings": [
        {
          "type": "product",
          "id": "product",
          "label": "t:sections.vib_products.blocks.product.settings.product.label"
        },
        {
          "type": "range",
          "id": "points",
          "label": "t:sections.vib_products.blocks.product.settings.points.label",
          "default": 1000,
          "min": 500,
          "max": 5000,
          "step": 500
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:sections.vib_products.presets.name"
    }
  ]
}
{% endschema %}
