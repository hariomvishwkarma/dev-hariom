<div class="page-width page-content text-center">
  <header class="section-header section-header--404">
    <{{ section.settings.heading_tag }} class="section-header__title">{{ 'general.404.title' | t }}</{{ section.settings.heading_tag }}>
    <div class="rte text-spacing">
      {{ 'general.404.subtext_html' | t: url: routes.root_url }}
    </div>
  </header>
</div>

{% schema %}
{
  "name": "t:sections.main-404.name",
  "settings": [
    {
      "type": "select",
      "id": "heading_tag",
      "label": "t:common.heading_tag.label",
      "default": "none",
      "options": [
        {
          "value": "h1",
          "label": "t:common.heading_tag.options.h1.label"
        },
        {
          "value": "h2",
          "label": "t:common.heading_tag.options.h2.label"
        },
        {
          "value": "h3",
          "label": "t:common.heading_tag.options.h3.label"
        }
      ],
      "default": "h1"
    }
  ]
}
{% endschema %}
