<div class="newsletter-container" id="section-newsletter-{{ section.id }}">

  {% render 'newsletter-form-meta-vitaminc', section_id: section.id, snippet_context: 'section' %}
</div>

{% style %}
  #section-newsletter-{{ section.id }} .newsletter_icon_new{
    background-color: {{ section.settings.icon_bg_color }};
    background: {{ section.settings.icon_bg_color }} ;
  }

  #section-newsletter-{{ section.id }} .newsletter_icon_new div .newsletter-icon-heading-new{
    font-size: {{ section.settings.heading_size }}px;
  }

  #section-newsletter-{{ section.id }} .newsletter_icon_new div .newsletter-icon-caption-new{
    font-size: {{ section.settings.caption_size }}px;
  }

  @media only screen and (max-width: 768px){
    #section-newsletter-{{ section.id }} .newsletter_icon_new div .newsletter-icon-heading-new{
      font-size: {{ section.settings.heading_mobile_size }}px;
    }
    #section-newsletter-{{ section.id }} .newsletter_icon_new div .newsletter-icon-caption-new{
      font-size: {{ section.settings.caption_mobile_size }}px;
    }
  }
{% endstyle %}

{% schema %}
{
  "name": "Newsletter-Meta-VitaminC",
  "settings": [
    {
      "type": "header",
      "content": "t:sections.newsletter.settings.icon.header"
    },
    {
      "type": "text",
      "id": "icon_title",
      "label": "t:sections.newsletter.settings.icon.icon_title.label",
      "default": "-20%"
    },
    {
      "type": "range",
      "id": "heading_size",
      "min": 1,
      "max": 30,
      "step": 1,
      "unit": "px",
      "label": "t:sections.newsletter.settings.icon.heading_size.label",
      "default": 30
    },
    {
      "type": "range",
      "id": "heading_mobile_size",
      "min": 1,
      "max": 20,
      "step": 1,
      "unit": "px",
      "label": "t:sections.newsletter.settings.icon.heading_mobile_size.label",
      "default": 17
    },
    {
      "type": "text",
      "id": "icon_caption",
      "label": "t:sections.newsletter.settings.icon.icon_caption.label",
      "default": "FÜR DICH"
    },
    {
      "type": "range",
      "id": "caption_size",
      "min": 1,
      "max": 20,
      "step": 1,
      "unit": "px",
      "label": "t:sections.newsletter.settings.icon.caption_size.label",
      "default": 14
    },
    {
      "type": "range",
      "id": "caption_mobile_size",
      "min": 1,
      "max": 20,
      "step": 1,
      "unit": "px",
      "label": "t:sections.newsletter.settings.icon.caption_mobile_size.label",
      "default": 10
    },
    {
      "type": "color",
      "id": "icon_bg_color",
      "label": "t:sections.newsletter.settings.icon.icon_bg_color.label",
      "default": "#e5748c"
    }
  ],
  "presets": [
    {
      "name": "Newsletter-Meta-VitaminC",
      "category": "Promotional"
    }
  ]
}
{% endschema %}
