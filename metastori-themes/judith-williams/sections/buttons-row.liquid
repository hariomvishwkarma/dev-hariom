<div id="section-{{ section.id }}" class="index-section{% unless section.settings.padding_top %} no-padding-top{% endunless %}">
  {% style %}
    {%- if section.settings.fixed_button_width -%}
      #section-{{ section.id }} .btn {
        width: {{ section.settings.width }}px;
      }
    {%- endif -%}

    @media only screen and (max-width:768px){
      #section-{{ section.id }} .button-gap {
        gap: {{ section.settings.button_gap }}px;
      }
    }
  {% endstyle %}
  <div class="buttons-row page-width{% if section.settings.narrow_column %} page-width--narrow{% endif %} button-gap">
    {%- for block in section.blocks -%}
      <div id="block-{{ block.id }}" class="theme-block" {{ block.shopify_attributes }}>
        {% style %}
          #block-{{ block.id }} .btn {
            color: {{ block.settings.text_color }};
            background-color: {{ block.settings.bg_color }};
            border-color: {{ block.settings.border_color }};
          }
        {% endstyle %}
        <div class="rte">
          <a href="{{ block.settings.link }}" class="btn">
            {{ block.settings.link_text }}
          </a>
        </div>
      </div>
    {%- endfor -%}
  </div>
</div>

{% schema %}
{
  "name": "t:sections.buttons-row.name",
  "settings": [
    {
      "type": "range",
      "id": "button_gap",
      "label": "Set Mobile Button Gap",
      "default": 10,
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px"
    },
    {
      "type": "checkbox",
      "id": "narrow_column",
      "label": "t:sections.buttons-row.settings.narrow_column.label",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "padding_top",
      "label": "t:sections.buttons-row.settings.padding_top.label",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "fixed_button_width",
      "label": "t:sections.buttons-row.settings.fixed_button_width.label",
      "default": false
    },
    {
      "type": "range",
      "id": "width",
      "label": "t:sections.buttons-row.settings.width.label",
      "default": 200,
      "min": 100,
      "max": 600,
      "step": 20,
      "unit": "px"
    }
  ],
  "blocks": [
    {
      "type": "button",
      "name": "t:sections.buttons-row.blocks.button.name",
      "settings": [
        {
          "type": "url",
          "id": "link",
          "label": "t:sections.buttons-row.blocks.button.settings.link.label"
        },
        {
          "type": "text",
          "id": "link_text",
          "label": "t:sections.buttons-row.blocks.button.settings.link_text.label",
          "default": "Button"
        },
        {
          "type": "color",
          "id": "text_color",
          "label": "t:sections.buttons-row.blocks.button.settings.text_color.label",
          "default": "#fff"
        },
        {
          "type": "color",
          "id": "bg_color",
          "label": "t:sections.buttons-row.blocks.button.settings.bg_color.label",
          "default": "#e77b8d"
        },
        {
          "type": "color",
          "id": "border_color",
          "label": "t:sections.buttons-row.blocks.button.settings.border_color.label",
          "default": "#e77b8d"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:sections.buttons-row.presets.buttons_row.name",
      "blocks": [
        {
          "type": "button"
        },
        {
          "type": "button"
        }
      ]
    }
  ]
}
{% endschema %}
