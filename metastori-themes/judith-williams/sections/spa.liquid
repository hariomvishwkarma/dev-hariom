<div id="spa_menu" class="page-content{% if section.blocks.size > 0 %} page-content--with-blocks{% endif %}">
  <div class="spa_header text-center">
    <div class="page-width{% if section.settings.narrow_column %} page-width--narrow{% endif %}">
      <header class="section-header">
        <h2 class="section-header__title">{{ section.settings.title }}</h2>
      </header>
    
      <div class="rte text-spacing">
        {{ section.settings.caption }}
        <a href="{{ section.settings.download_link }}" download target="_blank">{{ section.settings.download_label }}</a>
      </div>
    </div>
  </div>
</div>

{% style %}
  #shopify-section-{{ section.id }} header {
    margin-bottom: 16px;
  }
  
  #shopify-section-{{ section.id }} .rte {
    margin-bottom: 41px;
  }
  
  #shopify-section-{{ section.id }} .rte p {
    margin-bottom: 0;
  }
  
  #shopify-section-{{ section.id }} .rte a {
    color: #e5748c;
    text-decoration: none;
    border-bottom: 0;
    font-family: var(--typeHeaderPrimary);
  }

  #shopify-section-{{ section.id }} .modal__inner {
    background-color: {{ section.settings.modal_bg }};
  }
{% endstyle %}

<div class="page-width" 
  data-section-id="{{ section.id }}"
  data-section-type="spa">
  <div class="spa_wrapper">
    {% for block in section.blocks %}
      {% if block.settings.action == 'popup' %}
        <button type="button" class="spa_item js-modal-open-popup-{{ forloop.index }}" data-index="{{ forloop.index }}">
      {% elsif block.settings.action == 'link' %}
        <a class="spa_item" href="{{ block.settings.link }}">
      {% endif %}
          
        <div class="spa_item_img">
          {{ block.settings.img | image_url: width: 600 | image_tag: loading: 'lazy', alt: block.settings.img.alt, widths: '100, 200, 400, 600', class: "image" }}
        </div>
        <div class="spa_item_heading-item">
          <h3>{{ block.settings.heading }}</h3>
        </div>

      {% if block.settings.action == 'popup' %}
        </button>
      {% elsif block.settings.action == 'link' %}
        </a>
      {% endif %}

      <div id="spa-popup-{{ forloop.index }}" class="modal">
        <div class="modal__inner">
          <h3 class="text-center">{{ block.settings.title }}</h3>
          <div class="spa_modal">
            {% if block.settings.img2 != blank %}
              <div class="spa_modal-img">
                {{ block.settings.img2 | image_url: width: 600 | image_tag: loading: 'lazy', alt: block.settings.img2.alt, widths: '100, 200, 400, 600', class: "image" }}
              </div>
            {% endif %}
            <div class="spa_modal-text">
              {{ block.settings.text1 }}
              {% if block.settings.small_title != blank %}
                <hr class="divider_spa">
                <h4>{{ block.settings.small_title }}</h4>
              {% endif %}
              {{ block.settings.text2 }}
            </div>
          </div>

          {% if block.settings.label_title != blank %}
            <div class="btn spa-btn">
              <p>{{ block.settings.label_title }}</p>
              {{ block.settings.label_caption }}
            </div>
          {% endif %}

          <button type="button" class="btn btn--circle btn--icon modal__close js-modal-close closes close{{ forloop.index }}">
            <svg aria-hidden="true" focusable="false" role="presentation" class="icon icon-close" viewBox="0 0 64 64"><defs><style>.cls-1{fill:none;stroke:#000;stroke-miterlimit:10;stroke-width:2px}</style></defs><path class="cls-1" d="M19 17.61l27.12 27.13m0-27.13L19 44.74"/></svg>
            <span class="icon__fallback-text">{{ 'general.accessibility.close_modal' | t | json }}</span>
          </button>
        </div>
      </div>
    {% endfor %}
  </div>
</div>


{% schema %}
  {
    "name": "Spa section",
    "settings": [
      {
        "type": "textarea",
        "id": "title",
        "label": "Title",
        "default": "SPA MENÜ"
      },
      {
        "type": "richtext",
        "id": "caption",
        "label": "Caption",
        "default": "<p>Zeit für dein Verwöhn-Ritual! Entdecke unser exklusives Behandlungsangebot für den ganz persönlichen Wohlfühlmoment. Hier geht’s zum Download.</p>"
      },
      {
        "type": "text",
        "id": "download_label",
        "label": "Download label",
        "default": "Hier geht’s zum Download."
      },
      {
        "type": "url",
        "id": "download_link",
        "label": "Download link",
        "info": "Add the file to Admin > Settings > Files and use the generated URL."
      },
      {
        "type": "checkbox",
        "id": "narrow_column",
        "label": "Narrow column"
      },
      {
        "type": "color",
        "id": "modal_bg",
        "label": "Modal background color",
        "default": "#fcedf0"
      }
    ],
    "blocks": [
      {
        "type": "tile",
        "name": "Tile",
        "settings": [
          {
            "type": "header",
            "content": "Tiles content"
          },
          {
            "type": "image_picker",
            "id": "img",
            "label": "Image"
          },
          {
            "type": "text",
            "id": "heading",
            "label": "Heading"
          },
          {
            "type": "select",
            "id": "action",
            "label": "What should happen on click?",
            "default": "popup",
            "options": [
              {
                "label": "Popup",
                "value": "popup"
              },
              {
                "label": "Link to page",
                "value": "link"
              }
            ]
          },
          {
            "type": "header",
            "content": "Link"
          },
          {
            "type": "url",
            "id": "link",
            "label": "Link to page"
          },
          {
            "type": "header",
            "content": "Popup modal content"
          },
          {
            "type": "image_picker",
            "id": "img2",
            "label": "Image"
          },
          {
            "type": "textarea",
            "id": "title",
            "label": "Title"
          },
          {
            "type": "richtext",
            "id": "text1",
            "label": "Caption"
          },
          {
            "type": "textarea",
            "id": "small_title",
            "label": "Title"
          },
          {
            "type": "richtext",
            "id": "text2",
            "label": "Caption"
          },
          {
            "type": "textarea",
            "id": "label_title",
            "label": "Button label title"
          },
          {
            "type": "richtext",
            "id": "label_caption",
            "label": "Button label caption"
          }
        ]
      }
    ]
  }
{% endschema %}