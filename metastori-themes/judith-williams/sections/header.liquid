{%- liquid
  assign main_menu = linklists[section.settings.main_menu_link_list]

  assign logo_alignment = 'left'
  assign nav_position = 'below'

  if section.settings.main_menu_alignment == 'left' or section.settings.main_menu_alignment == 'left-center'
    assign nav_position = 'beside'
  endif

  if section.settings.main_menu_alignment == 'center'
    assign logo_alignment = 'center'
  endif

  assign template_name = template | replace: '.', ' ' | truncatewords: 2, '' | handle

  assign overlay_header = false
  if template_name == 'index' and section.settings.sticky_index
    assign overlay_header = true
  endif
  if template_name contains 'collection' and collection.image and section.settings.sticky_collection
    assign overlay_header = true
  endif
-%}

<style>
  .site-nav__link {
    font-size: {{ settings.type_navigation_size }}px;
  }
  {% if settings.type_navigation_capitalize %}
    .site-nav__link {
      text-transform: uppercase;
      letter-spacing: 0.2em;
    }
  {% endif %}

  {% if mainmenu.length > 6 %}
    .site-nav__link {
      padding-left: 10px;
      padding-right: 10px;
    }
  {% endif %}

  {%- if settings.color_header == settings.color_body_bg or settings.color_body_bg contains settings.color_header -%}
    .site-header,
    .site-header__element--sub {
      box-shadow: 0 0 25px rgb(0 0 0 / 10%);
    }

    .is-light .site-header,
    .is-light .site-header__element--sub {
      box-shadow: none;
    }
  {%- endif -%}

  {%- if settings.color_header == settings.color_header_search -%}
    .site-header__search-form {
      border: 1px solid {{ settings.color_borders }}
    }
  {%- endif -%}

 .langshop-selector {
  margin-right: 3rem;
  }

 @media screen and (max-width: 768px) {
  .langshop-selector {
    margin-right: 0;
    margin-left: 10px;
  }
  }
</style>

<div data-section-id="{{ section.id }}" data-section-type="header">
  <div id="HeaderWrapper" class="header-wrapper{% if overlay_header %} header-wrapper--overlay is-light{% endif %}">
    <header
      id="SiteHeader"
      class="site-header{% if settings.type_navigation_style == 'heading' %} site-header--heading-style{% endif %}"
      data-sticky="{{ section.settings.header_sticky }}"
      data-overlay="{{ overlay_header }}"
    >
      <div class="site-header__element site-header__element--top">
        <div class="page-width">
          <div
            class="header-layout"
            data-layout="{{ section.settings.main_menu_alignment }}"
            data-nav="{{ nav_position }}"
            data-logo-align="{{ logo_alignment }}"
          >
            {%- if nav_position == 'below' and logo_alignment == 'left' -%}
              <div class="header-item header-item--compress-nav small--hide">
                <button type="button" class="site-nav__link site-nav__link--icon site-nav__compress-menu">
                  <svg
                    aria-hidden="true"
                    focusable="false"
                    role="presentation"
                    class="icon icon-hamburger"
                    viewBox="0 0 64 64"
                  >
                    <path class="cls-1" d="M7 15h51">.</path><path class="cls-1" d="M7 32h43">.</path><path class="cls-1" d="M7 49h51">.</path>
                  </svg>
                  <span class="icon__fallback-text">{{ 'general.drawers.navigation' | t }}</span>
                </button>
              </div>
            {%- endif -%}

            <div class="header-item header-item--left-icons">
              <button
                type="button"
                aria-controls="MobileNav"
                class="site-nav__link site-nav__link--icon medium-up--hide mobile-nav-trigger"
              >
                <svg
                  aria-hidden="true"
                  focusable="false"
                  role="presentation"
                  class="icon icon-hamburger"
                  viewBox="0 0 64 64"
                >
                  <path class="cls-1" d="M7 15h51">.</path><path class="cls-1" d="M7 32h43">.</path><path class="cls-1" d="M7 49h51">.</path>
                </svg>
                <span class="icon__fallback-text">{{ 'general.drawers.navigation' | t }}</span>
              </button>

              {%- if section.settings.loyalty_program != blank -%}
                <a href="{{ section.settings.loyalty_program }}" class="site-nav__link site-nav__link--icon">
                  <svg
                    xmlns="http://www.w3.org/2000/svg"
                    viewBox="0 0 24 24"
                    style="width: 28px; height: 28px; border-radius: 100%;"
                  >
                    <defs></defs><title>{{ "general.header.loyalty_program" | t }}</title> <g stroke="currentColor" stroke-width="0.5"><path d="M12.24,6.25c0,0.04,0.04,0.08,0.08,0.08c0.04,0,0.08-0.03,0.08-0.08c0,0,0,0,0,0v0v0c0-1.7,1.43-1.72,1.49-1.72c0.04,0,0.08-0.04,0.08-0.08c0-0.04-0.03-0.08-0.08-0.08c0,0,0,0,0,0h0h0c0,0,0,0,0,0c-1.47,0-1.49-1.6-1.49-1.66c0-0.04-0.04-0.08-0.08-0.08c-0.04,0-0.08,0.04-0.08,0.08v0v0c0,0.52-0.15,0.93-0.43,1.22c-0.43,0.43-1.05,0.44-1.06,0.44c-0.04,0-0.08,0.04-0.08,0.08c0,0.04,0.04,0.08,0.08,0.08C12.22,4.53,12.24,6.18,12.24,6.25z"></path><path d="M7.47,17.36c-0.7,0-1.2-0.31-1.48-0.93c-0.21-0.47-0.22-0.95-0.22-0.96c0-0.04-0.04-0.08-0.08-0.08c-0.04,0-0.08,0.03-0.08,0.08v0c0,0,0,0,0,0v0c0,0.6-0.17,1.06-0.49,1.39c-0.49,0.49-1.19,0.5-1.2,0.5c-0.05,0-0.08,0.04-0.08,0.08c0,0.04,0.03,0.08,0.08,0.08h0c0.7,0,1.2,0.33,1.48,0.97c0.21,0.49,0.22,0.99,0.22,0.99c0,0.04,0.04,0.08,0.08,0.08c0.04,0,0.08-0.03,0.08-0.08v0c0,0,0,0,0,0v0c0,0,0,0,0,0v0c0-1.93,1.63-1.96,1.7-1.96c0.04,0,0.08-0.04,0.08-0.08S7.52,17.36,7.47,17.36L7.47,17.36z"></path><path d="M19.5,15.77L19.5,15.77C19.5,15.77,19.5,15.77,19.5,15.77c-1.18,0-1.19-1.28-1.19-1.33c0-0.05-0.04-0.08-0.08-0.08s-0.08,0.04-0.08,0.08v0v0c0,0.55-0.2,0.94-0.59,1.16c-0.29,0.16-0.6,0.17-0.6,0.17c-0.04,0-0.08,0.04-0.08,0.08c0,0.05,0.04,0.08,0.08,0.08h0c1.18,0.01,1.19,1.33,1.19,1.38c0,0.05,0.04,0.08,0.08,0.08c0.04,0,0.08-0.04,0.08-0.08h0v0v0v0v0c0-1.36,1.14-1.38,1.19-1.38h0c0.04,0,0.08-0.04,0.08-0.08S19.55,15.78,19.5,15.77L19.5,15.77z"></path><path d="M19.62,10.84l-2.46-3.38c-0.03-0.03-0.06-0.06-0.09-0.08c0,0,0-0.01-0.01-0.01c0,0,0,0,0,0c-0.04-0.02-0.09-0.04-0.14-0.04H7.09c-0.05,0-0.1,0.01-0.14,0.04c0,0,0,0,0,0c0,0,0,0.01-0.01,0.01C6.9,7.4,6.86,7.42,6.84,7.46l-2.46,3.38c-0.03,0.05-0.04,0.1-0.05,0.15c0,0.01-0.01,0.02-0.01,0.03c0,0,0,0,0,0c0,0.07,0.02,0.14,0.07,0.19l7.37,8.91c0.01,0.01,0.03,0.02,0.04,0.03c0.01,0.01,0.02,0.02,0.04,0.03c0.05,0.03,0.1,0.05,0.16,0.05s0.11-0.02,0.16-0.05c0.01-0.01,0.02-0.02,0.04-0.03c0.01-0.01,0.03-0.02,0.04-0.03l7.37-8.91c0.05-0.06,0.07-0.12,0.07-0.19c0,0,0,0,0,0c0-0.01-0.01-0.02-0.01-0.03C19.66,10.94,19.65,10.88,19.62,10.84z M16.4,7.94l-1.39,2.55l-2.31-2.55H16.4z M14.38,10.71H9.62L12,8.09L14.38,10.71z M11.31,7.94l-2.31,2.55L7.6,7.94H11.31z M7.05,8.21l1.36,2.5H5.23L7.05,8.21z M5.28,11.32h3.43l2.45,7.1L5.28,11.32z M12,18.98l-2.64-7.66h5.28L12,18.98z M12.84,18.43l2.45-7.1h3.43L12.84,18.43z M15.59,10.71l1.36-2.5l1.82,2.5H15.59z"></path><path d="M12,0C5.38,0,0,5.38,0,12s5.38,12,12,12s12-5.38,12-12S18.62,0,12,0z M12,23.51C5.65,23.51,0.49,18.35,0.49,12C0.49,5.65,5.65,0.49,12,0.49S23.51,5.65,23.51,12C23.51,18.35,18.35,23.51,12,23.51z"></path></g>
                  </svg>
                  <span class="site-nav__icon-label{% unless section.settings.icon_labels %} icon__fallback-text{% endunless %}">
                    {{- 'general.header.loyalty_program' | t -}}
                  </span>
                </a>
              {%- endif -%}
            </div>

            {%- if logo_alignment == 'left' -%}
              <div class="header-item header-item--logo">
                {%- render 'header-logo-block', section: section -%}
              </div>
            {%- endif -%}

            {%- if nav_position == 'below' -%}
              <div class="header-item header-item--search small--hide">
                {%- if logo_alignment == 'center' -%}
                  <button type="button" class="site-nav__link site-nav__link--icon site-nav__compress-menu">
                    <svg
                      aria-hidden="true"
                      focusable="false"
                      role="presentation"
                      class="icon icon-hamburger"
                      viewBox="0 0 64 64"
                    >
                      <path class="cls-1" d="M7 15h51">.</path><path class="cls-1" d="M7 32h43">.</path><path class="cls-1" d="M7 49h51">.</path>
                    </svg>
                    <span class="icon__fallback-text">{{ 'general.drawers.navigation' | t }}</span>
                  </button>
                {%- endif -%}

                {%- render 'header-search', search-icon: 'search-icon', search-close: 'search-close' -%}
              </div>
            {%- endif -%}

            {%- if nav_position == 'beside' -%}
              <div class="header-item header-item--navigation{% if section.settings.main_menu_alignment == 'left-center' %} text-center{% endif %}">
                {%- render 'header-desktop-nav',
                  main_menu: main_menu,
                  nav_position: nav_position,
                  show_mega_products: section.settings.mega_products
                -%}
              </div>
            {%- endif -%}

            {%- if logo_alignment == 'center' -%}
              <div class="header-item header-item--logo">
                {%- render 'header-logo-block', section: section -%}
              </div>
            {%- endif -%}

            <div class="header-item header-item--icons">
                <div class="langshop-selector"> <selector data-type="lsn-switchers" ></selector>  </div>
              {%- render 'header-icons', section: section, nav_position: nav_position -%}
            </div>
          </div>
        </div>

        <div class="site-header__search-container">
          <div class="page-width">
            <div class="site-header__search">
              {%- render 'header-search', search-icon: 'search-icon-1', search-close:'search-close-1' -%}
              <button type="button" class="text-link site-header__search-btn site-header__search-btn--cancel">
                <span class="medium-up--hide">
                  <svg
                    aria-hidden="true"
                    focusable="false"
                    role="presentation"
                    class="icon icon-close"
                    viewBox="0 0 64 64"
                  >
                    <defs><style>.cls-1{fill:none;stroke:#000;stroke-miterlimit:10;stroke-width:2px}</style></defs><path class="cls-1" d="M19 17.61l27.12 27.13m0-27.13L19 44.74"/>
                  </svg>
                </span>
                <span class="small--hide">{{ 'general.search.cancel' | t }}</span>
              </button>
            </div>
          </div>
        </div>
      </div>

      {%- if nav_position == 'below' -%}
        <div class="site-header__element site-header__element--sub" data-type="nav">
          <div class="page-width{% if logo_alignment == 'center' %} text-center{% endif %}">
            {%- render 'header-desktop-nav',
              main_menu: main_menu,
              nav_position: nav_position,
              show_mega_products: section.settings.mega_products
            -%}
          </div>
        </div>

        <div class="site-header__element site-header__element--sub" data-type="search">
          <div class="page-width medium-up--hide">
            {%- render 'header-search', search-icon: 'search-icon-2', search-close:'search-close-2' -%}
          </div>
        </div>
      {%- endif -%}
      {% capture positive_affirm %}
        {% unless cart.empty and settings.top_affirm_text == blank or settings.bottom_affirm_text == blank  %}
          <div class="positive_affirm_main">
            <div class="positive_affirm">
              <div class="top_affirm">
                <img src="{{ settings.affirm_icon | image_url }}" alt="{{ settings.affirm_icon.alt }}" height="20" width="20">
                <span>{{ settings.top_affirm_text }}</span>
              </div>
              <div class="bottom_affirm">
                {{ settings.bottom_affirm_text }}
              </div>
            </div>
          </div>
        {% endunless %}
      {% endcapture %}
      <div class="page-width site-header__drawers">
        <div class="site-header__drawers-container">
          <div class="site-header__drawer site-header__cart cart_notification_popup" id="HeaderCart">
            <div class="site-header__drawer-animate">
              {{ positive_affirm }}
              {%- render 'header-cart-drawer' -%}
            </div>
          </div>

          <div class="site-header__drawer site-header__mobile-nav medium-up--hide variant_b_main" id="MobileNav">
            <div class="site-header__drawer-animate variant_a_menu">
              {%- render 'header-mobile-nav', main_menu: main_menu -%}
              {%- if section.settings.header_footer_menu -%}
                <div id="MobileNavFooter"></div>
              {%- endif -%}
            </div>
            <div class="site-header__drawer-animate variant_b_menu">
              {%- render 'header-mobile-nav-variant-b', main_menu: section.settings.main_menu_link_list_mobile -%}
            </div>
          </div>
        </div>
      </div>

      {%- if settings.predictive_search_enabled or settings.search_top_collection != blank -%}
        <div id="SearchResultsWrapper" class="site-header__search-results hide">
          <div class="search-results-wrapper page-width">
            {% comment %}
            <div id="suggestions-wrapper">
              <div class="suggestions-title">Vorschläge</div>
              <div id="suggestions"></div>
            </div>
        {% endcomment %}

            {%- if settings.search_top_collection != blank -%}
              {%- assign search_collection = collections[settings.search_top_collection] -%}
              <div id="TopSearched" class="site-header__search-results-wrapper">
                <div class="page-width">
                  <div class="h4 site-header__search-title">{{ 'general.search.search_title' | t }}</div>
                </div>
                <div class="page-width page-width--flush-small">
                  <div class="new-grid product-grid scrollable-grid--small" data-view="scrollable">
                    {%- for product in search_collection.products limit: 6 -%}
                      {%- render 'product-grid-item',
                        product: product,
                        no_actions: true,
                        sizeVariable: 6,
                        fallback: '45vw', show_atc: true
                      -%}
                    {%- endfor -%}
                  </div>
                </div>
              </div>
            {%- endif -%}

            {%- if settings.predictive_search_enabled -%}
              <div
                id="PredictiveWrapper"
                class="hide"
                data-image-size="{{ settings.predictive_image_size }}"
                data-predictive-image-fill="{{ settings.predictive_image_fill }}"
              >
                <div class="page-width">
                  <div id="PredictiveResults" class="predictive-result__layout"></div>
                  <div class="text-center predictive-results__footer">
                    <button type="button" class="btn btn--small" data-predictive-search-button>
                      <small>
                        {{ 'general.search.view_more' | t }}
                      </small>
                    </button>
                  </div>
                </div>
              </div>
            {%- endif -%}
          </div>
        </div>
      {%- endif -%}
    </header>
  </div>
</div>

{% schema %}
{
  "name": "t:sections.header.name",
  "class": "header-section",
  "settings": [
    {
      "type": "link_list",
      "id": "main_menu_link_list",
      "label": "t:sections.header.settings.main_menu_link_list.label",
      "default": "main-menu"
    },
    {
      "type": "link_list",
      "id": "main_menu_link_list_mobile",
      "label": "Mobile Navigation(Variant B)"
    },
    {
      "type": "select",
      "id": "main_menu_alignment",
      "label": "t:sections.header.settings.main_menu_alignment.label",
      "default": "below",
      "options": [
        {
          "value": "below",
          "label": "t:sections.header.settings.main_menu_alignment.options.below.label"
        },
        {
          "value": "left",
          "label": "t:sections.header.settings.main_menu_alignment.options.left.label"
        },
        {
          "value": "left-center",
          "label": "t:sections.header.settings.main_menu_alignment.options.left-center.label"
        },
        {
          "value": "center",
          "label": "t:sections.header.settings.main_menu_alignment.options.center.label"
        }
      ]
    },
    {
      "type": "checkbox",
      "id": "icon_labels",
      "label": "t:sections.header.settings.icon_labels.label"
    },
    {
      "type": "checkbox",
      "id": "mega_products",
      "label": "t:sections.header.settings.mega_products.label",
      "info": "t:sections.header.settings.mega_products.info",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "header_sticky",
      "label": "t:sections.header.settings.header_sticky.label",
      "default": true,
      "info": "t:sections.header.settings.header_sticky.info"
    },
    {
      "type": "checkbox",
      "id": "header_footer_menu",
      "label": "t:sections.header.settings.header_footer_menu.label",
      "default": true,
      "info": "t:sections.header.settings.header_footer_menu.info"
    },
    {
      "type": "checkbox",
      "id": "sticky_index",
      "label": "t:sections.header.settings.sticky_index.label",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "sticky_collection",
      "label": "t:sections.header.settings.sticky_collection.label",
      "info": "t:sections.header.settings.sticky_collection.info",
      "default": false
    },
    {
      "type": "url",
      "id": "loyalty_program",
      "label": "t:sections.header.settings.loyalty_program.label"
    },
    {
      "type": "image_picker",
      "id": "custom_icon",
      "label": "t:sections.header.settings.custom_icon.label"
    },
    {
      "type": "url",
      "id": "custom_icon_link",
      "label": "t:sections.header.settings.custom_icon_link.label"
    },
    {
      "type" : "header",
      "content" : "Top searches"
    },
    {
      "type" : "textarea",
      "id" : "top_searches",
      "label" : "Top searches",
      "info" : "Separate each using ',' "
    }
  ],
  "blocks": [
    {
      "type": "logo",
      "name": "t:sections.header.blocks.logo.name",
      "limit": 1,
      "settings": [
        {
          "type": "image_picker",
          "id": "logo",
          "label": "t:sections.header.blocks.logo.settings.logo.label"
        },
        {
          "type": "image_picker",
          "id": "logo-inverted",
          "label": "t:sections.header.blocks.logo.settings.logo-inverted.label",
          "info": "t:sections.header.blocks.logo.settings.logo-inverted.info"
        },
        {
          "type": "range",
          "id": "desktop_logo_width",
          "label": "t:sections.header.blocks.logo.settings.desktop_logo_width.label",
          "default": 200,
          "min": 100,
          "max": 400,
          "step": 10,
          "unit": "px"
        },
        {
          "type": "range",
          "id": "mobile_logo_width",
          "label": "t:sections.header.blocks.logo.settings.mobile_logo_width.label",
          "default": 140,
          "min": 60,
          "max": 200,
          "step": 10,
          "unit": "px",
          "info": "t:sections.header.blocks.logo.settings.mobile_logo_width.info"
        }
      ]
    }
  ],
  "default": {
    "settings": {}
  },
  "disabled_on": {
    "groups": ["footer", "custom.popups"]
  }
}
{% endschema %}
<!-- Search suggestions -->
                      {% comment %}
<script>
  const searchInputs = document.querySelectorAll(
    ".shopify-section-group-header-group .site-header__search-form .site-header__search-input"
  );
  const suggestionsBox = document.getElementById("suggestions");
  const suggestionsTitle = document.querySelector(".suggestions-title");

  const topsuggestion = {{ section.settings.top_searches | split: "," | json }};

  const suggestionsData = [];
  {% for suggestion in shop.metaobjects.search_suggestions.values %}
    suggestionsData.push("{{ suggestion.suggestion }}");
  {% endfor %}

  function renderSuggestions(suggestions, searchInput) {
    suggestionsBox.innerHTML = "";

    suggestions.forEach((suggestion) => {
      const div = document.createElement("div");
      div.textContent = suggestion;
      div.addEventListener("click", () => {

        searchInputs.forEach((searchInput) => {
        searchInput.value = suggestion;
        const keyupEvent = new KeyboardEvent("keyup", {
          key: "Enter",
          keyCode: 13,
        });
        searchInput.dispatchEvent(keyupEvent);
        })
      });
      suggestionsBox.appendChild(div);
    });
  }

  function showSuggestions(query, searchInput) {
    if (query.trim() === "") {
      renderSuggestions(topsuggestion, searchInput);
      suggestionsTitle.style.display = "block";
    } else {
      const filteredSuggestions = suggestionsData.filter((item) =>
        item.toLowerCase().includes(query.toLowerCase().trim())
      );
      renderSuggestions(filteredSuggestions, searchInput);

      if (filteredSuggestions.length > 0) {
        suggestionsTitle.style.display = "block";
      } else {
        suggestionsTitle.style.display = "none";
      }
    }
  }

  searchInputs.forEach((searchInput) => {
    searchInput.addEventListener("input", function () {
      const query = this.value;
      showSuggestions(query, searchInput);
    });

    showSuggestions("", searchInput);
  });
</script>
<!-- Search suggestion -->
