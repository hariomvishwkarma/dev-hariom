<div
  data-section-id="{{ section.id }}"
  data-section-type="quotes-section"
  id="section-{{ section.id }}"
>
  {%- style -%}
    #section-{{ section.id }} .quotes-wrapper{
      display: grid;
      gap: {{ section.settings.gutter_size }}px;
    }
    #section-{{ section.id }} .color-schema-none{
      background-color: #fff;
    }
    #section-{{ section.id }} .color-schema-none .quote-item-body-text{
      color: #000;
    }
    #section-{{ section.id }} .color-schema-none .quote-item-author,
    #section-{{ section.id }} .color-schema-none a {
      color: #E77B8D;
    }


    #section-{{ section.id }} .color-schema-1{
      background-color: #E77B8D;
    }
    #section-{{ section.id }} .color-schema-1 .quote-item-body-text{
      color: #fff;
    }
    #section-{{ section.id }} .color-schema-1 .quote-item-author,
    #section-{{ section.id }} .color-schema-1 a{
      color: #fff;
    }

    #section-{{ section.id }} .color-schema-2{
      background-color: #E8E8E1;
    }
    #section-{{ section.id }} .color-schema-2 .quote-item-body-text{
      color: #000;
    }
    #section-{{ section.id }} .color-schema-2 .quote-item-author,
     #section-{{ section.id }} .color-schema-2 a{
      color: #000;
    }

    #section-{{ section.id }} p{
      margin: 0; 
      padding: 0; 
    }

    #section-{{ section.id }} .color-schema-3{
      background-color: #83888D;
    }
    #section-{{ section.id }} .color-schema-3 .quote-item-body-text{
      color: #fff;
    }
    #section-{{ section.id }} .color-schema-3 .quote-item-author,
    #section-{{ section.id }} .color-schema-3 a {
      color: #fff;
    }

    #section-{{ section.id }} .quote-item-body-text{
      font-size: 14px;
    }
    #section-{{ section.id }} .quote-item-author{
      font-size: 15px;
    }

    .quotes-section .quote-item{
      display: flex;
      align-items: center;
      gap: 20px;
      padding: 10px 20px;
    }
    .quotes-section .quote-item img{
      display: block;
      object-fit: cover;
      width: 100px;
      height: 100px;
      min-width: 100px;
      min-height: 100px;
      border-radius: 50%;

    }

    .quotes-section .quote-item a {
      font-weight: 600;
      text-decoration: underline;
    }
    @media (min-width: 769px){
    #section-{{ section.id }} .image-position-right .quote-item-text{
      order: -1;
    }
    .quote-item-author-wrapper .quote-item-image{
      display: none !important;
    }
    .quote-item-author-wrapper{
         margin-top: 10px;
       }
    .quote-item-author p {
      display: inline;
     }

    }
    @media (max-width: 768px){
      .quote-item-body-text{
        text-align: center;
      }
       .quotes-section .quote-item img{
          width: 65px;
          height: 65px;
          min-width: 65px;
          min-height: 65px;
       }
      .quote-item > .quote-item-image{
        display: none !important;
      }
      .quote-item-author-wrapper{
        display: flex;
        gap: 10px;
        align-items: center;
        margin-top: 20px;
      }
       .quotes-section .quote-item{
         padding: 20px 10px;
       }
    }
  {%- endstyle -%}

  {%- unless section.settings.full_width -%}
    <div class="page-width">
  {%- endunless -%}

  <div class="quotes-section image-position-{{ section.settings.image_position_desktop }} {% if section.settings.space_above %} promo-grid--space-top{% endif %}{% if section.settings.space_below %} promo-grid--space-bottom{% endif %}">
    <div class="quotes-wrapper">
      {% for block in section.blocks %}
        <div class="quote-item color-schema-{{ block.settings.color_scheme }}">
          <div class="quote-item-image">
            {% if block.settings.image %}
              {%- render 'image-element',
                img: block.settings.image,
                loading: section.settings.lazyload_images,
                widths: '360, 540, 720, 900, 1080, 1600',
                sizeVariable: '500px',
                fallback: '50vw'
              -%}
            {% endif %}
          </div>
          <div class="quote-item-text">
            <div class="quote-item-body-text">
              {{ block.settings.text }}
            </div>
            <div class="quote-item-author-wrapper">
              <div class="quote-item-image">
                {% if block.settings.image %}
                  {%- render 'image-element',
                    img: block.settings.image,
                    loading: section.settings.lazyload_images,
                    widths: '360, 540, 720, 900, 1080, 1600',
                    sizeVariable: '500px',
                    fallback: '50vw'
                  -%}
                {% endif %}
              </div>
              <div class="quote-item-author">
                {{ block.settings.author }}
              </div>
            </div>
          </div>
        </div>
      {% endfor %}
    </div>
  </div>

  {%- unless section.settings.full_width -%}
    </div>
  {%- endunless -%}
</div>
{% schema %}
{
  "name": "Quotes",
  "settings": [
  {
    "type": "checkbox",
    "id": "full_width",
    "label": "t:sections.promo-grid.settings.full_width.label",
    "default": false
  },
  {
    "type": "range",
    "id": "gutter_size",
    "label": "t:sections.promo-grid.settings.gutter_size.label",
    "default": 20,
    "min": 0,
    "max": 40,
    "step": 1,
    "unit": "px"
  },
  {
    "type": "checkbox",
    "id": "space_above",
    "label": "t:sections.promo-grid.settings.space_above.label",
    "default": true
  },
  {
    "type": "checkbox",
    "id": "space_below",
    "label": "t:sections.promo-grid.settings.space_below.label",
    "default": true
  },
  {
    "type": "checkbox",
    "id": "lazyload_images",
    "label": "t:common.lazyload_images.label",
    "info": "t:common.lazyload_images.info",
    "default": true
  },
  {
    "type": "select",
    "id": "image_position_desktop",
    "label": "Image position desktop",
    "default": "left",
       "options": [
            {
              "value": "left",
              "label": "left"
            },
            {
              "value": "right",
              "label": "right"
            }
          ]
  }
  ],
  "blocks" : [
     {
       "type" : "quote",
       "name" : "Quote",
       "settings" : [
         {
           "type" : "richtext",
           "label" : "Body text",
           "id" : "text"
         },
         {
           "type" : "richtext",
           "label" : "Name of the person",
           "id" : "author"
         },
         {
           "type" : "image_picker",
           "label" : "Profile image",
           "id" : "image"
         },
          {
          "type": "select",
          "id": "color_scheme",
          "label": "t:sections.promo-grid.blocks.product.settings.color_scheme.label",
          "default": "none",
          "options": [
            {
              "value": "none",
              "label": "t:sections.promo-grid.blocks.product.settings.color_scheme.options.none.label"
            },
            {
              "value": "1",
              "label": "1"
            },
            {
              "value": "2",
              "label": "2"
            },
            {
              "value": "3",
              "label": "3"
            }
          ]
        }
       ]
     }
  ],
  "presets" : [
    {
      "name" : "Quotes"
    }
  ]
}
{% endschema %}
