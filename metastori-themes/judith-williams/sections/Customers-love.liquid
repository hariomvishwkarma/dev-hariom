{% if product.metafields.custom.block1_value != blank or product.metafields.custom.block2_value != blank or product.metafields.custom.block3_value != blank or product.metafields.custom.block4_value != blank %}
<section class="pdp_rating_blocks">
  <div class="page-width">
     <{{ section.settings.heading_tag }} class="{{ section.settings.heading_size }}">{{ section.settings.title | escape }}</{{ section.settings.heading_tag }}>

      {% assign blocks = "block1,block2,block3,block4" | split: "," %}
{% assign scale_1 = product.metafields.custom.rating_scale_text_1 | split: "," %}
{% assign scale_2 = product.metafields.custom.rating_scale_text_2 | split: "," %}
{% assign scale_3 = product.metafields.custom.rating_scale_text_3 | split: "," %}
{% assign scale_4 = product.metafields.custom.rating_scale_text_4 | split: "," %}

<div class="rating_cards">
  {% for block in blocks %}
    {% assign title_key = block | append: '_title' %}
    {% assign value_key = block | append: '_value' %}
    
    {% assign title = product.metafields.custom[title_key] | default: '' %}
    {% assign value = product.metafields.custom[value_key] | default: 0 %}
  
    {% if value != blank %}
      <div class="card">
        <div class="card-title">{{ title }}</div>
        <div class="progress-bar">
          <div class="progress-indicator" style="left: {{ value }}%;"></div>
        </div>
        <div class="labels">
      {% case block %}
  {% when 'block1' %}
    {% for label in scale_1 %}
      {% if label != blank %}
        <span>{{ label | strip }}</span>
      {% endif %}
    {% endfor %}
  {% when 'block2' %}
    {% for label in scale_2 %}
      {% if label != blank %}
        <span>{{ label | strip }}</span>
      {% endif %}
    {% endfor %}
  {% when 'block3' %}
    {% for label in scale_3 %}
      {% if label != blank %}
        <span>{{ label | strip }}</span>
      {% endif %}
    {% endfor %}
  {% when 'block4' %}
    {% for label in scale_4 %}
      {% if label != blank %}
        <span>{{ label | strip }}</span>
      {% endif %}
    {% endfor %}
{% endcase %}

        </div>
      </div>
    {% endif %}
  {% endfor %}
</div>

   
  </div>
</section>
{% endif %}
  
{% schema %}
{
  "name": "Customer Love",
  "settings": [
     {
          "type": "select",
          "id": "heading_tag",
          "label": "t:common.heading_tag.label",
          "options": [
            {
              "value": "h1",
              "label": "t:common.heading_tag.options.h1.label"
            },
            {
              "value": "h2",
              "label": "t:common.heading_tag.options.h2.label"
            },
            {
              "value": "h3",
              "label": "t:common.heading_tag.options.h3.label"
            }
          ],
          "default": "h2"
        },
        {
          "type": "text",
          "id": "title",
          "label": "t:sections.rich-text.blocks.heading.settings.title.label",
          "default": "Rich text"
        },
        {
          "type": "select",
          "id": "heading_size",
          "label": "t:common.heading_size.label",
          "default": "h2",
          "options": [
            {
              "value": "h3",
              "label": "t:common.heading_size.options.small.label"
            },
            {
              "value": "h2",
              "label": "t:common.heading_size.options.medium.label"
            },
            {
              "value": "h1",
              "label": "t:common.heading_size.options.large.label"
            },
            {
              "value": "h0",
              "label": "t:common.heading_size.options.extra_large.label"
            }
          ]
        }
  ],
  "presets": [
    {
      "name": "Customer Love"
    }
  ]
}
{% endschema %}
       
<style>
  .pdp_rating_blocks {
    display:none;
    background-color: #E8E8E1;
    padding-top: 50px;
    padding-bottom: 50px;
    margin-top: 80px;
}
.pdp_rating_blocks .h2 {
    margin-bottom: 32px;
}
      .rating_cards {
      display: flex;
      gap: 20px;
      justify-content: space-between;
    }
    .rating_cards .card {
      background: white;
      padding: 10px 24px;
      width: 100%;
      max-width: 289px;
    }
    .rating_cards .card-title {
      font-size: 16px;
      color: #000;
      margin-bottom: 10px;
      text-align: left;
    }
    .rating_cards .progress-bar {
      position: relative;
      height: 4px;
      background: #E8E8E1;
      border-radius: 0;
      margin: 10px 0;
    }
    .rating_cards .progress-indicator {
      position: absolute;
      top: -4px;
      width: 4px;
      height: 12px;
      background: #E17888;
      border-radius: 0;
      transform: translateX(-50%);
    }
    .rating_cards .labels {
  display: flex;
  justify-content: space-between;
      font-size: 12px;
      margin-top: 8px;
      gap:5px;
      text-align:center;
      flex-wrap:wrap;
    }
  .rating_cards .labels span{
    flex:1;
        letter-spacing: -0.2px;
  }
.rating_cards .labels span:first-child {
    text-align: left;
}
.rating_cards .labels span:last-child {
    text-align: right;
}

@media only screen and (max-width:991px){
  .rating_cards {
    display: grid;
    grid-template-columns: 1fr 1fr;
}
.rating_cards .card {
    max-width: unset;
}
}
  @media only screen and (max-width:767px){
  .rating_cards {
    grid-template-columns: 1fr;
}
 .rating_cards .card {
    padding: 10px 15px;
}   
    .pdp_rating_blocks {
    padding-top: 30px;
    padding-bottom: 30px;
    margin-top: 40px;
    margin-bottom: 20px;
}
}
  
</style>
