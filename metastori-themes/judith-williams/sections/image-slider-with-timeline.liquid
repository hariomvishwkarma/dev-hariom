<div class="image-slider-with-timeline image-slider-with-timeline page-width" 
  data-section-id="{{ section.id }}"
  data-section-type="slideshow-timeline-section">
  <div class="carousel carousel_spec">
    {% for block in section.blocks %}
      <div class="carousel-cell carousel-cell--{{ block.id }}" data-index={{ forloop.index }} {{ block.shopify_attributes }}>
        <div>
          <h3>{{ block.settings.title }}</h3>
          <p style="font-style: oblique">{{ block.settings.caption }}</p>
        </div>
        {%- render 'image-element',
          img: block.settings.image,
          loading: 'lazy',
          img_width: 2400
        -%}
      </div>
    {% endfor %}
  </div>

  {%- assign font_size_tl_but = 28 | times: 100 | divided_by: section.settings.font_size  -%}
  {%- assign font_size_tl_but_sel = 38 | times: 100 | divided_by: section.settings.font_size  -%}
  {%- assign font_size_tl_but_dot = 20 | times: 100 | divided_by: section.settings.font_size  -%}
  
  {% style %}
    @media only screen and (min-width:769px){
      #shopify-section-{{ section.id }} .timeline-button {
        font-size: {{font_size_tl_but}}px;
      }

      #shopify-section-{{ section.id }} .timeline-button.is-selected {
        font-size: {{font_size_tl_but_sel}}px;
      }

      #shopify-section-{{ section.id }} .timeline-button span {
        font-size: {{font_size_tl_but_span}}px;
      }
    }
  {% endstyle %}

  <div class="timeline-nav">
    <button class="timeline--previous">&lsaquo;</button>
    <div class="timeline-buttons">
      {% for block in section.blocks %}
        <button class="timeline-button font-gotcha {% if forloop.first %}is-selected{% endif %}" data-index={{ forloop.index }}>
          {% unless forloop.first %}<span>&bull;</span>{% endunless %}
          {{ block.settings.year }}
        </button>
      {% endfor %}
    </div>
    <button class="timeline--next">&rsaquo;</button>
  </div>
</div>

{% schema %}
{
  "name": "Image slider timeline",
  "settings": [
    {
      "type": "range",
      "id": "font_size",
      "label": "Decrease Font Size of Navigation Buttons",
      "default": 100,
      "min": 90,
      "max": 200,
      "step": 2,
      "unit": "%"
    }
  ],
  "blocks": [
    {
      "type": "image",
      "name": "Image",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title"
        },
        {
          "type": "textarea",
          "id": "caption",
          "label": "Caption"
        },
        {
          "type": "text",
          "id": "year",
          "label": "Year"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "image slider timeline"
    }
  ]
}
{% endschema %}
