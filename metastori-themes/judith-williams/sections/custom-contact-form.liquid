<script>
 function timestamp() { var response = document.getElementById("g-recaptcha-response"); if (response == null || response.value.trim() == "") {var elems = JSON.parse(document.getElementsByName("captcha_settings")[0].value);elems["ts"] = JSON.stringify(new Date().getTime());document.getElementsByName("captcha_settings")[0].value = JSON.stringify(elems); } } setInterval(timestamp, 500); 
</script>

<script>
  function timestamp() { 
    var response = document.getElementById("g-recaptcha-response"); 
    if (response == null || response.value.trim() == "") {
      var elems = JSON.parse(document.getElementsByName("captcha_settings")[0].value);
      elems["ts"] = JSON.stringify(new Date().getTime());
      document.getElementsByName("captcha_settings")[0].value = JSON.stringify(elems);
    } 
  } 
  setInterval(timestamp, 500); 

  // Funktion zum Setzen der Priorität basierend auf dem Kontaktgrund
  function setPriority() {
    var contactReason = document.getElementById("00N9N000000Ox27").value;
    var priorityField = document.getElementById("priority");

    if (contactReason === "Meine Bestellung / Stornierung") {
      priorityField.value = "High";
    } else {
      priorityField.value = "Medium";
    }
  }

  // Funktion zum Anpassen der Formularfelder basierend auf dem Kontaktgrund
  function adjustFormFields() {
    var contactReason = document.getElementById("00N9N000000Ox27").value;
    
    var subjectField = document.getElementById("subject-field");
    var descriptionField = document.getElementById("description-field");
    var privacyField = document.getElementById("privacy-field");
    var recaptchaField = document.getElementById("recaptcha-field");
    var submitButton = document.getElementById("submit-button");
    var infoMessage = document.getElementById("info-message");

    if (contactReason === "Autogramm") {
      subjectField.style.display = "none";
      descriptionField.style.display = "none";
      privacyField.style.display = "none";
      recaptchaField.style.display = "none";
      submitButton.style.display = "none";
      infoMessage.style.display = "block";
    } else {
      subjectField.style.display = "block";
      descriptionField.style.display = "block";
      privacyField.style.display = "block";
      recaptchaField.style.display = "block";
      submitButton.style.display = "block";
      infoMessage.style.display = "none";
    }
  }

  // Event Listener hinzufügen, um die Priorität und Sichtbarkeit der Felder bei Änderung des Kontaktgrunds zu setzen
  document.addEventListener('DOMContentLoaded', function() {
    var contactReasonField = document.getElementById("00N9N000000Ox27");
    contactReasonField.addEventListener('change', function() {
      setPriority();
      adjustFormFields();
    });
    setPriority(); // Setzt die Priorität bei Seitenladung
    adjustFormFields(); // Setzt die Sichtbarkeit der Felder bei Seitenladung
  });
</script>

