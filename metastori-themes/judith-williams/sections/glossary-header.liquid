<div class="page-content{% if section.blocks.size > 0 %} page-content--with-blocks{% endif %}">
  <div class="grid faq_header">
    <div class="grid__item">
      <div class="page-width">
        {%- render 'breadcrumbs' -%}
      </div>

      {%- if section.settings.image -%}
        <div id="faq_header_image">
          {{ section.settings.image | image_url: width: 2000 | image_tag: loading: 'lazy', alt: section.settings.image.alt, widths: '500, 700, 1200, 1500, 1700, 2000' }}
        </div>
      {%- endif -%}

      <header class="page-width section-header">
        <{{ section.settings.heading_tag }} class="section-header__title text-center">{{ page.title }}</{{ section.settings.heading_tag }}>
      </header>

      <div class="page-width rte text-spacing">
        <p class="text-center">{{ section.settings.caption }}</p>
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Glossary header",
  "settings": [
    {
      "type": "select",
      "id": "heading_tag",
      "label": "t:common.heading_tag.label",
      "default": "none",
      "options": [
        {
          "value": "h1",
          "label": "t:common.heading_tag.options.h1.label"
        },
        {
          "value": "h2",
          "label": "t:common.heading_tag.options.h2.label"
        },
        {
          "value": "h3",
          "label": "t:common.heading_tag.options.h3.label"
        }
      ],
      "default": "h1"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Header image"
    },
    {
      "type": "textarea",
      "id": "caption",
      "label": "Caption",
      "default": "Lorem ipsum dolor sit amet, consetetur sadipscing elitr, sed diam nonumy eirmod tempor invidunt ut labore et dolore magna aliquyam erat, sed diam voluptua. At vero eos et accusam et justo duo."
    },
    {
      "type": "header",
      "content": "Breadcrumbs"
    },
    {
      "type": "text",
      "id": "breadcrumb",
      "label": "Breadcrumb label",
      "default": "Service"
    },
    {
      "type": "url",
      "id": "breadcrumb_link",
      "label": "Breadcrumb url"
    }
  ]
}
{% endschema %}
