{{ 'cart-drawer.css' | asset_url | stylesheet_tag }}

<div class="cart-drawer-main">
  <cart-drawer class="drawer cart-drawer-new" id="drawer">
    <div id="CartDrawer" class="cart-drawer">
      <div id="CartDrawer-Overlay" class="cart-drawer__overlay"></div>

      {%- if cart.empty? -%}
        <div class="drawer__inner-empty">
          <div class="cart-drawer__warnings center">
            <div class="cart-drawer__empty-content">
              <h2 class="cart__empty-text">{{ 'cart.cart-drawer.drawer-empty' | t }}</h2>
              <button class="drawer__close" type="button" aria-label="Close">
                <span class="close_svg">
                  <svg xmlns="http://www.w3.org/2000/svg" width="17" height="17" viewBox="0 0 17 17" fill="none">
                    <path d="M9.48631 8.1067L16.0006 1.5924C16.1675 1.41326 16.2584 1.17632 16.2541 0.931493C16.2498 0.68667 16.1506 0.453081 15.9774 0.279938C15.8043 0.106795 15.5707 0.00761636 15.3259 0.00329675C15.0811 -0.00102287 14.8441 0.089854 14.665 0.256781L8.15069 6.77108L1.6364 0.253631C1.45725 0.0867038 1.22031 -0.00417239 0.975489 0.00014723C0.730666 0.00446685 0.497077 0.103645 0.323934 0.276788C0.150791 0.449931 0.0516121 0.68352 0.0472925 0.928343C0.0429729 1.17317 0.13385 1.41011 0.300777 1.58925L6.81507 8.1067L0.300777 14.621C0.20793 14.7075 0.13346 14.8118 0.0818098 14.9278C0.0301592 15.0437 0.00238585 15.1688 0.000147069 15.2957C-0.00209171 15.4226 0.02125 15.5486 0.0687791 15.6663C0.116308 15.784 0.187052 15.8909 0.276789 15.9806C0.366525 16.0703 0.473418 16.1411 0.591088 16.1886C0.708759 16.2361 0.834798 16.2595 0.961685 16.2572C1.08857 16.255 1.21371 16.2272 1.32963 16.1756C1.44555 16.1239 1.54988 16.0495 1.6364 15.9566L8.15069 9.44232L14.665 15.9566C14.8441 16.1235 15.0811 16.2144 15.3259 16.2101C15.5707 16.2058 15.8043 16.1066 15.9774 15.9335C16.1506 15.7603 16.2498 15.5267 16.2541 15.2819C16.2584 15.0371 16.1675 14.8001 16.0006 14.621L9.48631 8.1067Z" fill="black"/>
                  </svg>
                </span>
              </button>
              <a href="/collections/alle-kategorien" class="btn button">{{ 'cart.cart-drawer.continue-shopping' | t }}</a>
            </div>
          </div>
        </div>

      {%- else -%}
        <div class="drawer__inner">
          <div class="drawer-stikcy-header">
            {% if settings.show_gute_wahl == true %}
              {% if settings.gute_wahl_heading != blank or settings.gute_wahl_subheading != blank %}
                <div class="gute-wahl-wrapper drawer-container">
                  <span class="gute-wahl-icon">
                    <svg xmlns="http://www.w3.org/2000/svg" width="25" height="25" viewBox="0 0 25 25" fill="none">
                      <circle cx="12.5" cy="12.5" r="12.5" fill="white"/>
                      <path d="M19.0476 8.33325L10.0447 17.8571L5.95239 13.5281" stroke="black" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                    </svg>
                  </span>
                  <div class="gute_wahl_content">
                    <span class="gute_wahl_heading">{{ settings.gute_wahl_heading }}</span>
                    <span class="gute_wahl_subheading">{{ settings.gute_wahl_subheading }}</span>
                  </div>
                </div>
              {% endif %}
            {% endif %}

            <div class="drawer__header_main drawer-container">
              <div class="drawer__header">
                <h2 class="drawer__heading">{{ 'cart.cart-drawer.title' | t }}</h2>
                <button class="drawer__close" type="button" aria-label="Close">
                  <span class="close_svg">
                    <svg xmlns="http://www.w3.org/2000/svg" width="17" height="17" viewBox="0 0 17 17" fill="none">
                      <path d="M9.48631 8.1067L16.0006 1.5924C16.1675 1.41326 16.2584 1.17632 16.2541 0.931493C16.2498 0.68667 16.1506 0.453081 15.9774 0.279938C15.8043 0.106795 15.5707 0.00761636 15.3259 0.00329675C15.0811 -0.00102287 14.8441 0.089854 14.665 0.256781L8.15069 6.77108L1.6364 0.253631C1.45725 0.0867038 1.22031 -0.00417239 0.975489 0.00014723C0.730666 0.00446685 0.497077 0.103645 0.323934 0.276788C0.150791 0.449931 0.0516121 0.68352 0.0472925 0.928343C0.0429729 1.17317 0.13385 1.41011 0.300777 1.58925L6.81507 8.1067L0.300777 14.621C0.20793 14.7075 0.13346 14.8118 0.0818098 14.9278C0.0301592 15.0437 0.00238585 15.1688 0.000147069 15.2957C-0.00209171 15.4226 0.02125 15.5486 0.0687791 15.6663C0.116308 15.784 0.187052 15.8909 0.276789 15.9806C0.366525 16.0703 0.473418 16.1411 0.591088 16.1886C0.708759 16.2361 0.834798 16.2595 0.961685 16.2572C1.08857 16.255 1.21371 16.2272 1.32963 16.1756C1.44555 16.1239 1.54988 16.0495 1.6364 15.9566L8.15069 9.44232L14.665 15.9566C14.8441 16.1235 15.0811 16.2144 15.3259 16.2101C15.5707 16.2058 15.8043 16.1066 15.9774 15.9335C16.1506 15.7603 16.2498 15.5267 16.2541 15.2819C16.2584 15.0371 16.1675 14.8001 16.0006 14.621L9.48631 8.1067Z" fill="black"/>
                    </svg>
                  </span>
                </button>
              </div>

              {% render 'drawer-progress-bar' %}
            </div>
          </div>

          <form
            action="{{ routes.cart_url }}"
            method="post"
            novalidate
            data-location="header"
            class="cart__drawer-form drawer-container"
          >
            <cart-drawer-items>
              <div class="cart-drawer-items-container">
                {% for item in cart.items %}
                  {%- render 'drawer-line-item', product: item, sizes: '89px' -%}
                {% endfor %}
              </div>
            </cart-drawer-items>

            <div class="drawer__footer">
              {% render 'cart-upsell' %}

              {% if settings.review_text != blank %}
                <div class="footer_review_text">
                  <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 16 16" fill="none">
                    <path d="M7.88297 0.502256C7.82639 0.53874 6.55028 3.08656 5.7645 4.72836C5.5822 5.11145 5.47533 5.26954 5.38104 5.28779C5.3056 5.29995 5.05415 5.34251 4.80899 5.379C3.55802 5.55534 0.10058 6.11477 0.0565763 6.14517C0.025145 6.16341 0 6.19382 0 6.21814C0 6.25462 2.66537 8.74164 3.67117 9.64159L3.97291 9.91522L3.58945 12.2502C3.38201 13.5393 3.19342 14.7494 3.16827 14.9501C3.12427 15.3027 3.12427 15.3027 3.27514 15.2602C3.35686 15.2359 4.03578 14.8953 4.77755 14.5001C5.51933 14.1109 6.56914 13.5637 7.10347 13.2839L8.07784 12.7732L10.5358 13.9832C11.8873 14.646 13.0188 15.169 13.0566 15.1507C13.0943 15.1264 13.0817 14.9075 13.0063 14.5183C12.9434 14.19 12.7611 13.211 12.6039 12.3414C12.4468 11.4719 12.2771 10.5537 12.2205 10.3044L12.1325 9.85441L14.0938 7.95115C15.351 6.72892 16.0362 6.02964 15.9985 5.99315C15.9419 5.93843 13.3017 5.56142 11.441 5.34251C10.9758 5.28779 10.5609 5.21482 10.5232 5.17225C10.4855 5.13577 9.926 4.08988 9.27851 2.8555C8.63103 1.61503 8.07155 0.575225 8.02755 0.53266C7.98355 0.490094 7.92068 0.477933 7.88297 0.502256Z" fill="#D87682"/>
                  </svg>
                  {{ settings.review_text }}
                </div>
              {% endif %}
        
              

              <div class="drawer__footer_totals">
                {% comment %}
                  <div class="cart__item-sub cart_drawer__item-row cart_drawer__item--discount">
                    <div class="cart_drawer__item--discount-btn">
                      {{ 'cart.cart-drawer.discounts' | t }}
                      <svg xmlns="http://www.w3.org/2000/svg" width="10" height="6" viewBox="0 0 10 6" fill="none">
                        <path d="M1 1L5 5L9 1" stroke="black" stroke-linecap="round" stroke-linejoin="round"/>
                      </svg>
                    </div>
                    <div class="cart_drawer__item--discount-field">
                      <input type="text" name="cart-drawer-discount" class="drawer-discount-field" placeholder="Enter Discount Code...">
                      <button class="btn discount-appy_btn">{{ 'cart.cart-drawer.discounts-button' | t }}</button>
                    </div>
                  </div>
                {% endcomment %}
                
                <div class="cart__item-sub cart_drawer__item-row cart_drawer__item--subtotal">
                  <div>{{ 'cart.cart-drawer.subtotal' | t }}</div>
                  <div>{{ cart.total_price | money }}</div>
                </div>
                <div class="cart__item-sub cart_drawer__item-row cart_drawer__item--shipping">
                  <div>{{ 'cart.cart-drawer.shipping_cost' | t }}</div>
                  {% assign shipping_cost = 0 %}
                  {% assign threshold_price_de = 0 %}
                  {% if localization.country.iso_code == 'DE' or localization.country.iso_code == 'AT' %}
                    {% assign threshold_price_de = settings.de_au_shipping_threshold | times: 100 %}
                    {% if cart.total_price > threshold_price_de %}
                    {% else %}
                      {% assign shipping_cost = shipping_cost | plus: settings.de_au_shipping_rate | times: 100 %}
                    {% endif %}
                  {% else %}
                    {% assign threshold_price_de = settings.other_shipping_threshold | times: 100 %}
                    {% if cart.total_price > threshold_price_de %}
                    {% else %}
                      {% assign shipping_cost = settings.other_shipping_rate | times: 100 %}
                    {% endif %}
                  {% endif %}
                  <div
                    data-shippingcost="{{ shipping_cost }}"
                    threshold_price="{{ threshold_price_de }}"
                    {% if shipping_cost == 0 %}
                      free_shipping_enable
                    {% endif %}
                  >
                    {% if shipping_cost == 0 %}Kostenlos{% else %}{{ shipping_cost | money }}{% endif %}
                  </div>
                </div>
                {% if cart.total_discount > 0 %}
                <div class="cart__item-sub cart_drawer__item-row cart_drawer__item-total--discount">
                  <div>{{ settings.discount_title }}</div>
                  <div>-{{ cart.total_discount| money }}</div>
                </div>
                {% endif %}
                <div class="cart__item-sub cart_drawer__item-row cart_drawer__item--total">
                  <div>{{ 'cart.cart-drawer.total' | t }}</div>
                  <div>{{ cart.total_price | plus: shipping_cost | money }}</div>
                </div>

        {% render 'discount-field' %}
              </div>

              {% if settings.discount_note != blank %}
                <div class="cart_drawer_discount_note">{{ settings.discount_note }}</div>
              {% endif %}

              <div class="cart__item-row cart__checkout-wrapper payment-buttons">
                <button
                  type="submit"
                  name="checkout"
                  data-terms-required="{{ settings.cart_terms_conditions_enable }}"
                  class="btn cart__checkout"
                >
                  <svg
                    aria-hidden="true"
                    focusable="false"
                    role="presentation"
                    class="icon icon-lock"
                    viewBox="0 0 64 64"
                  >
                    <defs><style>.a{fill:none;stroke:#000;stroke-width:2px}</style></defs><path class="a" d="M19.45 23.6v-3.2c0-7 5.89-11.75 12.55-11.75 7.21 0 12.55 5.49 12.55 11.75v3.2M10 23.6h44v31.75H10zM32 37.47v7.47"><circle class="a" cx="32" cy="35.87" r="1.6"></circle></path>
                  </svg>
                  {{ 'cart.cart-drawer.checkout' | t }}
                </button>

                {% if additional_checkout_buttons and settings.cart_additional_buttons %}
                  <div class="additional-checkout-buttons">{{ content_for_additional_checkout_buttons }}</div>
                {% endif %}
              </div>

              {%- if settings.drawer_cart_payment -%}
                <div class="cart_drawer_payment_icons">
                  <ul class="inline-list payment-icons">
                    {%- for type in shop.enabled_payment_types -%}
                      <li class="icon--payment">
                        {{ type | payment_type_svg_tag }}
                      </li>
                    {%- endfor -%}
                  </ul>
                </div>
              {%- endif -%}
            </div>
          </form>
        </div>
      {% endif %}
    </div>
  </cart-drawer>
</div>

{% schema %}
{
  "name": "Cart Drawer",
  "settings": [],
  "presets": [
    {
      "name": "Cart Drawer"
    }
  ]
}
{% endschema %}
