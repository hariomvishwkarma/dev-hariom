{%- liquid
  assign product_limit = section.settings.count | plus: 1
  if section.settings.mobile_scrollable
    assign product_limit = section.settings.count
  endif
-%}

{%- if section.settings.divider -%}<div class="section--divider">{%- endif -%}

{% style %}
  {% if section.settings.heading_position == 'right' %}
    #CollectionSection-{{ section.id }} .section-header__link {
      padding-left: 20px;
    }

    @media only screen and (max-width: 768px) {
      #CollectionSection-{{ section.id }} .section-header__link {
        padding-left: 10px;
      }
    }
  {% elsif section.settings.heading_position == 'center' %}
    #CollectionSection-{{ section.id }} .section-header {
      position: relative;
    }

    #CollectionSection-{{ section.id }} .section-header__link {
      position: absolute;
      top: 0;
      right: 0;
    }

    @media only screen and (max-width: 768px) {
      #CollectionSection-{{ section.id }} .section-header__link {
        position: relative;
      }
    }
  {% endif %}

  {%- if section.settings.view_all -%}
    @media only screen and (max-width: 768px) {
      #shopify-section-{{ section.id }} .section-header__title {
        text-align: left !important;
      }
    }
  {% endif %}

  /* Tab */
  ul#tabs-nav {
    position: relative;
    display: flex;
    list-style: none;
    margin: 0 0 28px 0;
    gap: 16px;
    flex-wrap: nowrap;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    overflow-y: hidden;
  }
  
  ul#tabs-nav li {
    margin-bottom: -1px;
    padding: 8px 8px 12px;
    position: relative;
    scroll-snap-align: none;
    scroll-snap-stop: normal;
    flex-shrink: 0;
    cursor: pointer;
  }
  
  ul#tabs-nav li a {
    color: #000;
    font-size: 18px;
    text-transform: uppercase;
    letter-spacing: 1.7px;
  }
  
  ul#tabs-nav li.active:before {
    position: absolute;
    height: 2px;
    width: 100%;
    bottom: 1px;
    background: #e17888;
    content: "";
    left: 0;
    z-index: 3;
  }
  
  ul#tabs-nav li.active a {
    font-weight: 700;
    color: #e17888;
  }
  
.tabs_heading_main {
    position: relative;
}

.tabs_heading_main:before {
    position: absolute;
    content: "";
    background: rgba(0,0,0,.2);
    width: calc(100% - 20px);
    height: 1px;
    bottom: 0;
    left: 0;
}
  ul#tabs-nav::-webkit-scrollbar{
    -webkit-appearance: none;
    width: 7px;
    height: 0px;
  }
  .featured_variant_b{
    display: none;
  }
  .featured_collection_tab .grid-product__actions {
    display: none;
  }
  @media screen and (max-width: 767px){
    ul#tabs-nav li a {
      font-size: 14px;
      letter-spacing: 1.7px;
    }
    ul#tabs-nav {
      margin-left: 20px;
    }
    #tabs-content div.tab-content {padding-left: 0;margin-left: 13px;padding-bottom: 20px;}

    /* div.tab-content .grid-item.grid-product:first-child {
        padding-left: 0;
    } */
    .tabs_heading_main:before {
      left: 20px;
    }
    .scrollable-grid--small .grid-item {
      flex: 0 0 70%;
    }
    div.tab-content::-webkit-scrollbar {
      -webkit-appearance: none;
      width: 7px;
      height: 3px;
    }
    div.tab-content::-webkit-scrollbar-thumb {
      background-color: #e17888;
    }
    div.tab-content::-webkit-scrollbar-track {
      background-color: rgba(0,0,0,.2);
    }
  }
{% endstyle %}

<div
  id="CollectionSection-{{ section.id }}"
  data-section-id="{{ section.id }}"
  data-section-type="collection-template"
>
  {%- if section.settings.title != blank -%}
    <div class="page-width text-{{ section.settings.heading_position }}">
      <div class="section-header{% if section.settings.view_all %} section-header--with-link{% endif %}">
        <{{ section.settings.heading_tag }} class="section-header__title {{ section.settings.heading_size }}">
          {{ section.settings.title }}
        </{{ section.settings.heading_tag }}>
        {%- if section.settings.view_all -%}
          <a href="{{ section.settings.view_all_link }}" class="section-header__link">
            {{- 'collections.general.all_of_collection' | t -}}
          </a>
        {%- endif -%}
      </div>
    </div>
  {%- endif -%}

  {%- liquid
    capture gridView
      render 'products_per_row', products_per_row: section.settings.products_per_row
    endcapture
  -%}

  {%- liquid
    if section.settings.mobile_scrollable
      assign fallback = '45vw'
    else
      assign fallback = 'variable'
    endif
  -%}

  <div class="page-width{% if section.settings.mobile_scrollable %} page-width--flush-small{% endif %}">
    <div class="tabs_heading_main">
    <ul id="tabs-nav">
      {% for block in section.blocks %}
        <li>
          <a href="#tab{{ forloop.index }}">
            {% if block.settings.collection_heading != blank %}
              {{ block.settings.collection_heading | escape }}
            {% else %}
              {{ block.settings.home_featured_products.title }}
            {% endif %}
          </a>
        </li>
      {% endfor %}
    </ul>
    </div>
    <div class="featured_collection_tab" id="tabs-content">
      {% for block in section.blocks %}
        {% assign featured_collection = collections[block.settings.home_featured_products] %}
        <div
          id="tab{{ forloop.index }}"
          class="new-grid tab-content product-grid{% if section.settings.mobile_scrollable %} scrollable-grid--small{% endif %}"
          data-view="{{ gridView }}"
        >
          {%- if block.settings.home_featured_products == blank
            or featured_collection.empty?
            or featured_collection.products_count == 0
          -%}
            {%- liquid
              for i in (1..product_limit)
                unless section.settings.mobile_scrollable
                  assign item_classes = ''
                  if forloop.index > section.settings.count
                    assign item_classes = 'hide'
                    assign mod = forloop.index | modulo: 2
                    if mod == 0
                      assign item_classes = 'medium-up--hide'
                    endif
                  endif
                endunless
                render 'onboarding-product-grid-item', i: i, classes: item_classes
              endfor
            -%}

          {%- else -%}
            {%- liquid
              for product in featured_collection.products limit: product_limit
                assign item_classes = ''
                unless section.settings.mobile_scrollable
                  if forloop.index > section.settings.count
                    assign item_classes = 'hide'
                    assign mod = forloop.index | modulo: 2
                    if mod == 0
                      assign item_classes = 'medium-up--hide'
                    endif
                  endif
                endunless

                render 'product-grid-item', no_actions: false, show_atc: true, product: product, collection: collection, classes: item_classes, sizeVariable: section.settings.products_per_row, fallback: fallback

                if settings.quick_shop_enable
                  render 'quick-shop-modal', product: product
                endif
              endfor
            -%}
          {%- endif -%}
        </div>
      {% endfor %}
    </div>
  </div>
</div>

{%- if section.settings.divider -%}</div>{%- endif -%}

<script>
  // Show the first tab and hide the rest
  $('#tabs-nav li:first-child').addClass('active');
  $('.tab-content').hide();
  $('.tab-content:first').show();

  // Click function
  $('#tabs-nav li').click(function () {
    $('#tabs-nav li').removeClass('active');
    $(this).addClass('active');
    $('.tab-content').hide();

    var activeTab = $(this).find('a').attr('href');
    $(activeTab).fadeIn();
    return false;
  });
</script>
          
{% schema %}
{
  "name": "Featured collection tab 1",
  "class": "index-section featured_variant_tab_top",
  "settings": [
    {
      "type": "select",
      "id": "heading_tag",
      "label": "t:common.heading_tag.label",
      "default": "none",
      "options": [
        {
          "value": "h1",
          "label": "t:common.heading_tag.options.h1.label"
        },
        {
          "value": "h2",
          "label": "t:common.heading_tag.options.h2.label"
        },
        {
          "value": "h3",
          "label": "t:common.heading_tag.options.h3.label"
        }
      ],
      "default": "h2"
    },
    {
      "type": "text",
      "id": "title",
      "label": "t:sections.featured-collection.settings.title.label",
      "default": "Featured collection"
    },
    {
      "type": "select",
      "id": "heading_size",
      "label": "t:common.heading_size.label",
      "default": "h2",
      "options": [
        {
          "value": "h3",
          "label": "t:common.heading_size.options.small.label"
        },
        {
          "value": "h2",
          "label": "t:common.heading_size.options.medium.label"
        },
        {
          "value": "h1",
          "label": "t:common.heading_size.options.large.label"
        },
        {
          "value": "h0",
          "label": "t:common.heading_size.options.extra_large.label"
        }
      ]
    },
    {
      "type": "select",
      "id": "heading_position",
      "label": "t:common.heading_position.label",
      "default": "left",
      "options": [
        {
          "value": "left",
          "label": "t:common.heading_position.options.left.label"
        },
        {
          "value": "center",
          "label": "t:common.heading_position.options.center.label"
        },
        {
          "value": "right",
          "label": "t:common.heading_position.options.right.label"
        }
      ]
    },
    {
      "type": "range",
      "id": "count",
      "label": "t:sections.featured-collection.settings.count.label",
      "default": 6,
      "min": 5,
      "max": 15,
      "step": 1
    },
    {
      "type": "range",
      "id": "products_per_row",
      "label": "t:sections.featured-collection.settings.products_per_row.label",
      "default": 3,
      "min": 2,
      "max": 5,
      "step": 1
    },
    {
      "type": "checkbox",
      "id": "mobile_scrollable",
      "label": "t:sections.featured-collection.settings.mobile_scrollable.label",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "view_all",
      "label": "t:sections.featured-collection.settings.view_all.label",
      "default": true
    },
    {
      "type": "url",
      "id": "view_all_link",
      "label": "View all link"
    },
    {
      "type": "checkbox",
      "id": "divider",
      "label": "t:sections.featured-collection.settings.divider.label",
      "default": false
    }
  ],
  "blocks":[
    {
      "type": "collection",
      "name": "Collection",
      "settings": [
        {
          "type": "text",
          "id": "collection_heading",
          "label": "Custom tab heading",
          "info": "Default is collection title"
        },
        {
          "type": "collection",
          "id": "home_featured_products",
          "label": "t:sections.featured-collection.settings.home_featured_products.label"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Featured collection tab"
    }
  ],
  "disabled_on": {
    "groups": ["footer", "header", "custom.popups"]
  }
}
{% endschema %}
