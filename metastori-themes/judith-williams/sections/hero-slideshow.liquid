{% schema %}
{
  "name": "Custom Slideshow",
  "settings": [
    {
  "type": "select",
  "id": "banner_height",
  "label": "Banner Height Desktop",
  "options": [
    {
      "value": "auto",
      "label": "Natural"
    },
     {
      "value": "500px",
      "label": "500px"
    },
    {
      "value": "1075px",
      "label": "1075px"
    }
  ],
  "default": "auto"
},
        {
  "type": "select",
  "id": "banner_height2",
  "label": "Banner Height Mobile",
  "options": [
    {
      "value": "auto",
      "label": "Natural"
    },
    {
      "value": "500px",
      "label": "500px"
    },
    {
      "value": "1075px",
      "label": "1075px"
    }
  ],
  "default": "auto"
},
  ],
  "blocks": [
    {
      "type": "slide",
      "name": "Slide",
      "settings": [
        { "type": "image_picker", "id": "desktop_image", "label": "Desktop Image" },

        { "type": "image_picker", "id": "mobile_image", "label": "Mobile Image" },
        { "type": "text", "id": "heading", "label": "Heading" },
        { "type": "textarea", "id": "description", "label": "Description" },
        { "type": "url", "id": "button_link", "label": "Button Link" },
        { "type": "text", "id": "button_text", "label": "Button Text" },
         {
"type": "color",
"id": "slideshow_hedi",
"label": "Text Heading Color",
"default": "#ffffff"
},
         {
"type": "color",
"id": "slideshow_hedi2",
"label": "Sub Text Heading Color",
"default": "#ffffff"
},
        {
"type": "color",
"id": "slideshow_background",
"label": "Button Background Color",
"default": "#ffffff"
},
        {
"type": "color",
"id": "slideshow_background2",
"label": "Button text Color",
"default": "#ffffff"
},
        { "type": "select", "id": "content_position", "label": "Content Position", "options": [
          { "value": "top-left", "label": "Top Left" },
          { "value": "top-center", "label": "Top Center" },
          { "value": "top-right", "label": "Top Right" },
          { "value": "bottom-left", "label": "Bottom Left" },
          { "value": "bottom-center", "label": "Bottom Center" },
          { "value": "bottom-right", "label": "Bottom Right" }
        ]}
      ]
    },
    {
      "type": "grid_item",
      "name": "Grid Item",
      "settings": [
        { "type": "image_picker", "id": "grid_image", "label": "Grid Image" },
        { "type": "text", "id": "grid_heading", "label": "Heading" },
        { "type": "textarea", "id": "grid_description", "label": "Description" },
        { "type": "url", "id": "grid_button_link", "label": "Button Link" },
        { "type": "text", "id": "grid_button_text", "label": "Button Text" }
      ]
    }
  ],
  "presets": [{ "name": "Custom Slideshow", "blocks": [{ "type": "slide" }, { "type": "grid_item" }, { "type": "grid_item" }, { "type": "grid_item" }] }]
}
{% endschema %}

<style>
  .custom-slideshow { position: relative; }
  .slide-content { position: absolute; color: white; padding: 20px; }
  .top-left { top: 10px; left: 34px; }
  .top-center { top: 10px; left: 50%; transform: translateX(-50%); }
  .top-right { top: 10px; right: 34px; }
  .bottom-left { bottom: 20px; left: 34px; }
  .bottom-center { bottom: 10px; left: 50%; transform: translateX(-50%); }
  .bottom-right { bottom: 10px; right: 34px; }

  .custom-slideshow-heroslider {
    display: none;
  }



  .grid-container {
      margin: 24px 0px 28px;
      display: flex;
      justify-content: space-between;
      gap: 24px;
  }
    .grid-item-cts-slideshow {
      align-items: stretch;
      display: flex !important;
      margin-bottom: 10px;
      width: 32.4%;
  }
   .grid-item-cts-slideshow-content-ct {
      width: 78%;
      background: #E8E8E1;
         display: flex;
      flex-direction: column;
      justify-content: center;
      align-items: center;
      padding:50px  20px 35px;
  }
    .grid-item-cts-slideshow-img-ct {
      width: 22%;
      min-width: 130px;
  }
  .grid-item-cts-slideshow-content-ct h3{
      font-size: var(--Paragraph);
      font-weight: 700;
      line-height: 20.85px;
      letter-spacing: 0.02em;
      text-align: center;
      text-underline-position: from-font;
      text-decoration-skip-ink: none;
    margin-bottom:0px;
        text-transform: capitalize;
  }
    .grid-item-cts-slideshow-img-ct img{
          width: 100%;
      height: 100%;
      object-fit: cover;
    }
  .slider-cts-slideshow li button{
    display:none;
  }
    .slider-cts-slideshow .slick-active::marker {
      color: #e77b8d;
  }
  .grid-item-cts-slideshow-content-ct a  {
         padding: 10px 17px;
      font-size: 16px;
      font-weight: 600;
      line-height: 22.72px;
      letter-spacing: 0.3499999940395355px;
      text-align: center;
      text-underline-position: from-font;
      text-decoration-skip-ink: none;
      margin-top: 20px;
    }
    .slider-cts-slideshow ul li {
      margin: 0px 7px;
    }

  .slider-cts-slideshow ul {
      display: flex;
      justify-content: center;
      position: absolute;
      left: 0;
      right: 0;
      bottom: 0pc;
  }
    .slider-cts-slideshow li::marker{
      color: #cacaca;
    }
    .slide-content h2{
  font-size: 60px;
  font-weight: 700;
  line-height: 72px;
  text-align: left;
  text-underline-position: from-font;
  text-decoration-skip-ink: none;
      letter-spacing: 0px;
     margin-bottom:0px !important;
      text-transform: capitalize;
    }
    .slide-content p{
      text-transform: uppercase;
  font-size: 18px;
  font-weight: 400;
  line-height: 25.02px;
  letter-spacing: 0.1em;
  text-align: left;
  text-underline-position: from-font;
  text-decoration-skip-ink: none;
    margin-bottom:30px;
    }
    .slide-content .btn {
         padding: 10px 17px;
      text-transform: uppercase;
      font-family: inherit;
      font-size: 16px;
      font-weight: 600;
      line-height: 22.72px;
      letter-spacing: 0.3499999940395355px;
      text-align: center;
      text-underline-position: from-font;
      text-decoration-skip-ink: none;

  }
   .grid-container  ul {
      position: absolute;
      bottom: -35px;
      display: flex;
      align-items: center;
      justify-content: center;
      left: 0;
      right:0px;
    }
      .grid-container ul li {
      margin: 0px 4.5px;
    }
    .grid-container li button{
     height: 2px;
      width: 30px;
      background-color: #999;
      /* margin-right: 10px; */
      font-size: 0;
    }
    .grid-container .slick-active button{
       background-color: #000;
    }
      .grid-container .slick-active::marker {
      color: #e77b8d;
  }
    .grid-container li::marker{
      color:#CACACA;
        font-size: 0;
    }
    .grid-item-cts-slideshow-content-ct p{
      text-align:center;
    }
    .slider-cts-slideshow .slick-slide {
      position: relative;
    }


    .mobile-image {
      display: none !important;
    }
  @media screen and (max-width: 768px) {
    .grid-container ul{
      margin-left:0px;
    }
    .grid-item-cts-slideshow-content-ct p{
      margin-bottom: 0;
    }
     .slide-content p {
      text-transform: uppercase;
      font-size: 16px;
      font-weight: 400;
      line-height: 25.02px;
    }
    .grid-item-cts-slideshow-content-ct {
      width: 78%;
      background: #E8E8E1;
      display: flex;
      flex-direction: column;
      justify-content: center;
      align-items: center;
      padding: 25px 20px 0px;
  }
    .grid-item-cts-slideshow-img-ct {
      min-width: 115px;
    }
    .grid-item-cts-slideshow-content-ct a {

      margin-top: 10px;
  }
    .desktop-image {
      display: none !important;
    }
    .grid-container {
      margin: 20px 3px 45px;
    }

    .mobile-image {
      display: block !important;
    }
    .bottom-left {
      bottom: 10px;
      left: 0;
      padding-left: 18px;
      padding-bottom: 16px;
    }
    .slide-content h2 {
      font-size: 32px;
      line-height: 38px;
      margin-bottom: 5px;
    }
    .slide-content p {
      line-height: 1;
      margin-bottom: 28px;
    }
  }

  /* Desktop specific styles */
  /* @media screen and (max-width: 769px) {

  } */

         .slider-cts-slideshow .desktop-image{
          height: {{ section.settings.banner_height }};
      width:100%;
               object-fit: cover;
    }
      .slider-cts-slideshow .mobile-image{
        width:100%;
            object-fit: cover;
          height: {{ section.settings.banner_height2 }};
    }
  @media screen and (max-width: 960px){
    .grid_main .grid-container{
      display: block !important;
    }
  }
</style>

<div class="custom-slideshow-heroslider">
  <div class="custom-slideshow">
    <div class="slider-cts-slideshow">
      {% for block in section.blocks %}
        {% if block.type == 'slide' %}
          <div>
            <img src="{{ block.settings.desktop_image | img_url: 'master' }}" class="desktop-image" alt="Slide Image">
            <img src="{{ block.settings.mobile_image | img_url: 'master' }}" class="mobile-image" alt="Slide Image">
            <div class="slide-content {{ block.settings.content_position }}">
              <h2 style=" color: {{ block.settings.slideshow_hedi }}; ">{{ block.settings.heading }}</h2>
              <p style=" color: {{ block.settings.slideshow_hedi2 }}; ">{{ block.settings.description }}</p>
              <a
                style="background-color: {{ block.settings.slideshow_background }}; color: {{ block.settings.slideshow_background2 }}; "
                href="{{ block.settings.button_link }}"
                class="btn"
              >
                {{- block.settings.button_text -}}
              </a>
            </div>
          </div>
        {% endif %}
      {% endfor %}
    </div>
  </div>
  <div class="page-width grid_main">
    <div class="grid-container">
      {% for block in section.blocks %}
        {% if block.type == 'grid_item' %}
          <div class="grid-item-cts-slideshow">
            <div class="grid-item-cts-slideshow-content-ct">
              <h3>{{ block.settings.grid_heading }}</h3>
              <p>{{ block.settings.grid_description }}</p>
              <a href="{{ block.settings.grid_button_link }}" class="btn">{{ block.settings.grid_button_text }}</a>
            </div>
            <div class="grid-item-cts-slideshow-img-ct">
              <img src="{{ block.settings.grid_image | image_url: width: 300 }}" alt="Grid Image">
            </div>
          </div>
        {% endif %}
      {% endfor %}
    </div>
  </div>
</div>

<script src="https://cdn.jsdelivr.net/jquery.slick/1.8.1/slick.min.js"></script>

<script>
     $(document).ready(function(){
     $('.slider-cts-slideshow').slick({
       slidesToShow: 1,
       slidesToScroll: 1,
       autoplay: false,
       autoplaySpeed: 3000,
       arrows: false,
       dots: true
     });
   }).on('setPosition', function (event, slick) {
  setTimeout(function () {
    // Add aria-label to slick-track
    $('.custom-slideshow .slick-track').attr('aria-label', 'Aktionsbanner Startseite');
  }, 100);
  });



  $(document).ready(function(){
      if ($(window).width() < 960) {
     $('.grid-container').slick({
       slidesToShow: 1,
       slidesToScroll: 1,
       autoplay: false,
       autoplaySpeed: 3000,
       arrows: false,
       dots: true
     });
         }
   });
</script>
