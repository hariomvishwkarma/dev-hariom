{%- if section.settings.divider -%}<div class="section--divider">{%- endif -%}
  {% style %}
    .logo-bar__item {
    {% unless section.settings.logo_background_transparent %}
        background-color:{{ section.settings.logo_background }} !important;
      {% else %}
        background-color:transparent !important;
    {% endunless %}
    }

    {% if section.settings.enable_grayscale %}
      .logo-bar__item img{
        opacity: 75%;
        filter: grayscale(1);
      }
    {% endif %}

    @media only screen and (max-width: 768px) {
      .carousel-cell {
        width: {{ section.settings.mobile_logo_size }}%;
        height: {{ section.settings.slider_height }}px;
        margin-right: 10px;
      }
    }

    @media only screen and (min-width: 768px) {
      .carousel-cell {
        width: {{ section.settings.desktop_logo_size }}%;
        height: {{ section.settings.slider_height }}px;
        margin-right: 10px;
      }
    }
  {% endstyle %}
<div class="page-width">
  {%- if section.settings.title != blank -%}
    <div class="section-header text-{{ section.settings.heading_position }}">
      <{{ section.settings.heading_tag }} class="section-header__title {{ section.settings.heading_size }}">{{ section.settings.title | escape }}</{{ section.settings.heading_tag }}>
    </div>
  {%- endif -%}

  {% if section.settings.enable_slider == false or section.settings.enable_slider_mobile == false %}
    {%- if section.blocks.size > 0 -%}
      <div class="logo-bar logo-bar--{{ section.id }}{% if section.settings.enable_slider %} desktop-hidden{% elsif section.settings.enable_slider_mobile %} mobile-hidden{% endif %}">
        <div class="new-grid product-grid" data-view="6-2">
          {%- for block in section.blocks -%}
            <div class="grid-item  {% unless section.settings.logo_background_transparent %} grid-product {% endunless %}" {{ block.shopify_attributes }}>
              <div class="logo-bar__item{% if block.settings.image == blank %} logo-bar__item-svg{% endif %}">
              {%- if block.settings.link != blank -%}
                <a href="{{ block.settings.link }}" class="logo-bar__link" aria-label="{{ block.settings.image.alt }}">
                  {%- endif -%}
                  {%- if block.settings.image != blank -%}
                    {%- render 'image-element',
                            img: block.settings.image,
                            sizeVariable: '6',
                            fallback: '50vw',
                            widths: '360, 540, 720, 1020',
                            classes: 'logo-bar__image',
                    -%}
                  {%- else -%}
                    {{ 'logo' | placeholder_svg_tag: 'placeholder-svg placeholder-svg--no-padding' }}
                  {%- endif -%}
                  {%- if block.settings.link != blank -%}
                </a>
                {%- endif -%}
              </div>
            </div>
          {%- endfor -%}
        </div>
      </div>
    {%- endif -%}
  {%- endif -%}
  {% if section.settings.enable_slider or section.settings.enable_slider_mobile %}
    <div class="carousel{% if section.settings.enable_slider == false %} desktop-hidden{% elsif section.settings.enable_slider_mobile == false %} mobile-hidden{% endif %}"
      data-flickity='{ {% if section.settings.enable_autoplay %}"autoPlay": {{ section.settings.autoplay_speed | times: 1000 }},{% endif %}"pageDots": {{ section.settings.enable_dots }}, "prevNextButtons": {{ section.settings.enable_arrows }}, "groupCells": true, "contain": true }' >

      {%- for block in section.blocks -%}

          <div class="carousel-cell grid-item {% unless section.settings.logo_background_transparent %} grid-product {% endunless %}" {{ block.shopify_attributes }}>
            <div class="logo-bar__item{% if block.settings.image == blank %} logo-bar__item-svg{% endif %}">
            {%- if block.settings.link != blank -%}
              <a href="{{ block.settings.link }}" class="logo-bar__link" aria-label="{{ block.settings.image.alt }}">
                {%- endif -%}
                {%- if block.settings.image != blank -%}
                  {%- render 'image-element',
                          img: block.settings.image,
                          sizeVariable: '6',
                          fallback: '50vw',
                          widths: '360, 540, 720, 1020',
                          classes: 'logo-bar__image'
                  -%}
                {%- else -%}
                  {{ 'logo' | placeholder_svg_tag: 'placeholder-svg placeholder-svg--no-padding' }}
                {%- endif -%}
                {%- if block.settings.link != blank -%}
              </a>
              {%- endif -%}
            </div>
          </div>

      {%- endfor -%}
    </div>
  {% endif %}
</div>


{%- if section.settings.divider -%}</div>{%- endif -%}

{% schema %}
{
  "name": "t:sections.logo-list.name",
  "class": "index-section",
  "max_blocks": 12,
  "settings": [
    {
      "type": "select",
      "id": "heading_tag",
      "label": "t:common.heading_tag.label",
      "options": [
        {
          "value": "h1",
          "label": "t:common.heading_tag.options.h1.label"
        },
        {
          "value": "h2",
          "label": "t:common.heading_tag.options.h2.label"
        },
        {
          "value": "h3",
          "label": "t:common.heading_tag.options.h3.label"
        }
      ],
      "default": "h2"
    },
    {
      "type": "text",
      "id": "title",
      "label": "t:sections.logo-list.settings.title.label",
      "default": "Our brands"
    },
    {
      "type": "select",
      "id": "heading_size",
      "label": "t:common.heading_size.label",
      "default": "h2",
      "options": [
        {
          "value": "h3",
          "label": "t:common.heading_size.options.small.label"
        },
        {
          "value": "h2",
          "label": "t:common.heading_size.options.medium.label"
        },
        {
          "value": "h1",
          "label": "t:common.heading_size.options.large.label"
        },
        {
          "value": "h0",
          "label": "t:common.heading_size.options.extra_large.label"
        }
      ]
    },
    {
      "type": "select",
      "id": "heading_position",
      "label": "t:common.heading_position.label",
      "default": "left",
      "options": [
        {
          "value": "left",
          "label": "t:common.heading_position.options.left.label"
        },
        {
          "value": "center",
          "label": "t:common.heading_position.options.center.label"
        },
        {
          "value": "right",
          "label": "t:common.heading_position.options.right.label"
        }
      ]
    },
    {
      "type": "checkbox",
      "id": "divider",
      "label": "t:sections.logo-list.settings.divider.label",
      "default": false
    },
    {
      "type": "color",
      "id": "logo_background",
      "label": "Logo background"
    },
    {
      "type": "checkbox",
      "id": "logo_background_transparent",
      "label": "Transparent Logo background",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "enable_grayscale",
      "label": "Gray Logo",
      "default": false
    },
    {
      "type": "header",
      "content": "Slider"
    },
    {
      "type": "checkbox",
      "id": "enable_slider",
      "label": "Enable Slider desktop",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "enable_slider_mobile",
      "label": "Enable Slider mobile",
      "default": false
    },
    {
      "type": "range",
      "id": "desktop_logo_size",
      "label": "Desktop logo size",
      "default": 15,
      "min": 10,
      "max": 100,
      "unit":"%"
    },
    {
      "type": "range",
      "id": "mobile_logo_size",
      "label": "Mobile logo size",
      "default": 75,
      "min": 10,
      "max": 100,
      "unit":"%"
    },
    {
      "type": "range",
      "id": "slider_height",
      "label": "Slider height",
      "default": 100,
      "min": 50,
      "max": 200,
      "step":50,
      "unit":"px"
    },
    {
      "type": "checkbox",
      "id": "enable_arrows",
      "label": "Show arrows",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "enable_dots",
      "label": "Show dots",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "enable_autoplay",
      "label": "Auto play",
      "default": false
    },
    {
      "type": "range",
      "id": "autoplay_speed",
      "label": "Auto play speed",
      "default": 2,
      "min": 1,
      "max": 15,
      "unit":"sec"
    }
  ],
  "blocks": [
    {
      "type": "logo_image",
      "name": "t:sections.logo-list.blocks.logo.name",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "t:sections.logo-list.blocks.logo.settings.image.label",
          "info": "t:sections.logo-list.blocks.logo.settings.image.info"
        },
        {
          "type": "url",
          "id": "link",
          "label": "t:sections.logo-list.blocks.logo.settings.link.label",
          "info": "t:sections.logo-list.blocks.logo.settings.link.info"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:sections.logo-list.presets.logo_list.name",
      "blocks": [
        {
          "type": "logo_image"
        },
        {
          "type": "logo_image"
        },
        {
          "type": "logo_image"
        },
        {
          "type": "logo_image"
        },
        {
          "type": "logo_image"
        },
        {
          "type": "logo_image"
        }
      ]
    }
  ],
  "disabled_on": {
    "groups": ["footer", "header", "custom.popups"]
  }
}
{% endschema %}
