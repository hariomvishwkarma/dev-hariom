{% comment %}
  Shopify Announcement Bar Section
  - Supports Bar A and Bar B
  - Scheduling (start/end dates) via text inputs (format: YYYY-MM-DD HH:MM)
  - Page targeting
  - Countdown timer
  - Animations (fade, marquee)
  - Discount code copy
  - Two-line layout
{% endcomment %}

 {% assign now = 'now' | date: "%s" %}
  {% assign b_ok = false %}

  {%- comment -%} === BAR B (only if A not active) === {%- endcomment -%}
 
    {% assign b_date_ok = true %}
    {% if section.settings.b_start != blank %}
      {% assign b_start = section.settings.b_start | date: "%s" %}
      {% if now < b_start %}{% assign b_date_ok = false %}{% endif %}
    {% endif %}
    {% if section.settings.b_end != blank %}
      {% assign b_end = section.settings.b_end | date: "%s" %}
      {% if now > b_end %}{% assign b_date_ok = false %}{% endif %}
    {% endif %}

    {% if b_date_ok %}
      {% assign b_page_ok = false %}
      {% case section.settings.b_page_scope %}
        {% when 'all' %}{% assign b_page_ok = true %}
        {% when 'home' %}{% if template.name == 'index' %}{% assign b_page_ok = true %}{% endif %}
        {% when 'product' %}{% if template.name contains 'product' %}{% assign b_page_ok = true %}{% endif %}
        {% when 'collection' %}{% if template.name contains 'collection' %}{% assign b_page_ok = true %}{% endif %}
        {% when 'blog' %}{% if template.name contains 'blog' %}{% assign b_page_ok = true %}{% endif %}
        {% when 'article' %}{% if template.name contains 'article' %}{% assign b_page_ok = true %}{% endif %}
        {% when 'cart' %}{% if template.name contains 'cart' %}{% assign b_page_ok = true %}{% endif %}
        {% when 'search' %}{% if template.name contains 'search' %}{% assign b_page_ok = true %}{% endif %}
        {% when 'custom' %}
          {% if section.settings.b_custom_match != blank %}
            {% assign needles = section.settings.b_custom_match | split: ',' %}
            {% for n in needles %}
              {% assign nstrip = n | strip %}
              {% if request.path contains nstrip %}{% assign b_page_ok = true %}{% endif %}
            {% endfor %}
          {% endif %}
      {% endcase %}
      {% if b_page_ok %}{% assign b_ok = true %}{% endif %}
    {% endif %}

  {%- comment -%} === OUTPUT BAR === {%- endcomment -%}
  {% if b_ok %}
    <section id="announcement-bar-new" class="announcement-wrapper  bar_priority_{{ section.settings.b_page_priority }}">
        {% if section.settings.b_enable != false %}
      <div class="announcement-bar-icons color-scheme-{{ section.settings.color_scheme-icon }}">
          {%- if section.settings.color_scheme-icon != 'none' -%}
        {%- render 'color-scheme-texture', color_scheme: section.settings.color_scheme-icon -%}
      {%- endif -%}

        <div class="page-width ">
        <div class="announcement-item_wrap {% if section.settings.b_animation == 'marquee'%}marquee{% elsif section.settings.b_animation == 'fade'%}fade{% endif %}">
                {% if section.settings.text_1 != blank or section.settings.liquid_1  != blank %}
                  <div class="announcement-item">
                      <div class="icon_wrap">
                        {% if section.settings.icon_1 != blank %}
                  <img src="{{ section.settings.icon_1 | img_url: 'master' }}" alt="icon_1">
                        {% endif %}
                  <span>
                    {% if section.settings.show_liquid_1 == false %}
                      {{ section.settings.text_1 }}
                    {% else %}
                      {{ section.settings.liquid_1 }}
                    {% endif %}
                  </span>
                  </div>
                </div>
              {% endif %}

              {% if section.settings.text_2 != blank or section.settings.liquid_2 != blank %}
                <div class="announcement-item">
                  <div class="icon_wrap">
                    {% if section.settings.icon_2 != blank %}
                  <img src="{{ section.settings.icon_2 | img_url: 'master' }}" alt="icon_2">
                    {% endif %}
                  <span>
                    {% if section.settings.show_liquid_2 == false %}
                      {{ section.settings.text_2 }}
                    {% else %}
                      {{ section.settings.liquid_2 }}
                    {% endif %}
                  </span>
                  </div>
                </div>
              {% endif %}

              {% if section.settings.text_3 != blank or section.settings.liquid_3  != blank %}
                <div class="announcement-item">
                  <div class="icon_wrap">
                    {% if section.settings.icon_3 != blank %}
                  <img src="{{ section.settings.icon_3 | img_url: 'master' }}" alt="icon_3">
                    {% endif %}
                  <span>
                    {% if section.settings.show_liquid_3 == false %}
                      {{ section.settings.text_3 }}
                    {% else %}
                      {{ section.settings.liquid_3 }}
                    {% endif %}
                  </span>
                  </div>
                </div>
              {% endif %}

                  {% if section.settings.b_animation == 'marquee'%}
                  <div class="announcement-item">
                        <div class="icon_wrap">
                          <img src="{{ section.settings.icon_1 | img_url: 'master' }}" alt="icon_1">
                          <span>
                            {% if section.settings.show_liquid_1 == false %}
                              {{ section.settings.text_1 }}
                            {% else %}
                              {{ section.settings.liquid_1 }}
                            {% endif %}
                          </span>
                        </div>
                  </div>

                  <div class="announcement-item">
                    <div class="icon_wrap">
                    <img src="{{ section.settings.icon_2 | img_url: 'master' }}" alt="icon_2">
                    <span>
                      {% if section.settings.show_liquid_2 == false %}
                        {{ section.settings.text_2 }}
                      {% else %}
                        {{ section.settings.liquid_2 }}
                      {% endif %}
                    </span>
                    </div>
                  </div>

                  <div class="announcement-item">
                    <div class="icon_wrap">
                    <img src="{{ section.settings.icon_3 | img_url: 'master' }}" alt="icon_3">
                    <span>
                      {% if section.settings.show_liquid_3 == false %}
                        {{ section.settings.text_3 }}
                      {% else %}
                        {{ section.settings.liquid_3 }}
                      {% endif %}
                    </span>
                    </div>
                  </div>
                  {% endif %}

          </div>
            </div>
      </div>
      {%  endif %}

      {%  if section.settings.a_enable != false %}
        <div class="announcement-bar-new color-scheme-{{ section.settings.color_scheme_timer }}"
            data-countdown="{{ section.settings.a_countdown_end }}">
              {%- if section.settings.color_scheme_timer != 'none' -%}
        {%- render 'color-scheme-texture', color_scheme: section.settings.color_scheme_timer -%}
      {%- endif -%}
          <div class="announcement-inner {% if section.settings.column_reverse %}column_reverse {% endif %}{% if section.settings.a_two_line == false %} single_ln {% endif %}{% if section.settings.a_button_text == blank and section.settings.a_discount_code == blank %}center_mode{% endif %}">
                          <div class="{%if section.settings.a_two_line == true %}announcement-text-wrap{% else %}announcement-text-wrap_single{% endif %}">
                              <span class="message">{{ section.settings.a_message }}</span>
                              {% if section.settings.a_sub_message != blank %}
                              <span class="sub">{{ section.settings.a_sub_message }}</span>
                              {% endif %}
                          </div>
                        {% if section.settings.a_countdown_enable 
                            and section.settings.a_countdown_start != blank 
                            and section.settings.a_countdown_end != blank %}

                            <div class="countdown_wrap" data-hide="true" style="display:none;">
                              <p class="timer_text">{{ section.settings.a_countdown_text }}</p>
                              <div class="countdown" 
                                  data-start="{{ section.settings.a_countdown_start }}" 
                                  data-end="{{ section.settings.a_countdown_end }}">
                              </div>
                            </div>
                          {% endif %}
                        {% if section.settings.a_button_text != blank or section.settings.a_discount_code != blank %}
                            <a href="{{ section.settings.a_link | default: '#' }}" class="btn btn-announcement {% if section.settings.a_discount_code != blank %}discount_code{% endif %}"
                                {% if section.settings.a_discount_code != blank %} data-code="{{ section.settings.a_discount_code }}" onclick="copyCode(this)"{% endif %} title="Copie!">
                                {% if section.settings.a_discount_code != blank %}{{section.settings.a_discount_code}} {% render 'copy-icon' %}{% else %}{{ section.settings.a_button_text }}{% endif %}
                            </a>
                            {% endif %}
          </div>
        </div>
      {%  endif %}
    </section>
  {% endif %}
<style>
.btn-announcement {padding:4px 20px;
    font-size: 15px;
    font-weight: 600;}
.countdown {font-weight:bold;}
</style>

<script>
document.querySelectorAll(".discount_code").forEach(el => {
  el.addEventListener("click", function(event) {
    event.preventDefault(); // stop the link from opening

    const code = this.getAttribute("data-code");

    navigator.clipboard.writeText(code).then(() => {
      // create tooltip
      const tooltip = document.createElement("span");
      tooltip.innerText = "Kopiert!";
      tooltip.style.position = "absolute";
      tooltip.style.background = "#333";
      tooltip.style.color = "#fff";
      tooltip.style.padding = "2px 6px";
      tooltip.style.borderRadius = "2px";
      tooltip.style.fontSize = "10px";
      tooltip.style.zIndex = "9999"; 
      // position near element
      const rect = this.getBoundingClientRect();
      tooltip.style.top = (window.scrollY + rect.top - 20) + "px";
      tooltip.style.left = (window.scrollX + rect.left) + "px";

      document.body.appendChild(tooltip);

      // remove tooltip after 1 second
      setTimeout(() => {
        tooltip.remove();
      }, 1000);
    });
  });
});
document.addEventListener("DOMContentLoaded", function(){
  document.querySelectorAll(".announcement-bar-new .countdown").forEach(function(cd){
    var start = new Date(cd.dataset.start).getTime();
    var end = new Date(cd.dataset.end).getTime();
    var wrap = cd.closest(".countdown_wrap"); 

    function tick(){
      var now = new Date().getTime();

      // Before countdown start → keep hidden
      if(now < start){
        wrap.style.display = "none";
        setTimeout(tick, 1000);
        return;
      }

      // After countdown end
      if(now >= end){
        cd.innerHTML = "Expired";
        if(wrap?.dataset.hide === "true"){ 
          wrap.style.display = "none"; 
        }
        return;
      }

      // Active countdown
      wrap.style.display = "flex"; 
      var diff = end - now;

      var d = Math.floor(diff/86400000);
      var h = Math.floor((diff%86400000)/3600000);
      var m = Math.floor((diff%3600000)/60000);
      var s = Math.floor((diff%60000)/1000);

      cd.innerHTML = `
        <div class="time-box"><span class="num">${d}</span><span class="label">TAGE</span></div>
        <span class="colon">:</span>
        <div class="time-box"><span class="num">${h.toString().padStart(2,'0')}</span><span class="label">STD</span></div>
        <span class="colon">:</span>
        <div class="time-box"><span class="num">${m.toString().padStart(2,'0')}</span><span class="label">MIN</span></div>
        <span class="colon">:</span>
        <div class="time-box"><span class="num">${s.toString().padStart(2,'0')}</span><span class="label">SEK</span></div>
      `;

      setTimeout(tick,1000);
    }

    tick();
  });
});
</script>

{% schema %}
{
  "name": "Announcement Bar",
  "settings": [

    { "type": "header", "content": "Configuration" },
    {
      "id": "b_page_priority",
      "type": "select",
      "label": "Visibility Priority",
      "options": [
        { "value": "high", "label": "High" },
        { "value": "low", "label": "Low" }
      ],
      "default": "low"
    },
    { "id": "b_start", "type": "text", "label": "Start Date (YYYY-MM-DD HH:MM)", "info": "Enter the start date and time in the format YYYY-MM-DD HH:MM. Time should be based on Austria local time (CET/CEST). Example: 2025-09-01 09:30."  },
    { "id": "b_end", "type": "text", "label": "End Date (YYYY-MM-DD HH:MM)", "info": "Enter the end date and time in the format YYYY-MM-DD HH:MM. Time should be based on Austria local time (CET/CEST). Example: 2025-09-10 18:00."  },
    { "id": "b_page_scope", "type": "select", "label": "Page Visibility", "options": [
      {"value":"all","label":"All Pages"},
      {"value":"home","label":"Homepage"},
      {"value":"product","label":"Product Pages"},
      {"value":"collection","label":"Collection Pages"},
      {"value":"blog","label":"Blog Pages"},
      {"value":"article","label":"Article Pages"},
      {"value":"cart","label":"Cart Page"},
      {"value":"search","label":"Search Page"},
      {"value":"custom","label":"Custom Handle Match"}
    ], "default":"all" },
    { "id": "b_custom_match", "type": "text", "label": "Custom Handle(s) (comma separated)", "info": "Select 'Custom Handle Match' in Page Visibility dropdown. Enter only the last part of the URL (handle). Example: For '/pages/about-us', enter 'about-us'. Multiple handles can be added, separated by commas."  },
 

    { "type": "header", "content": "Icon Bar" },
    { "id": "b_enable", "type": "checkbox", "label": "Enable Icon Bar", "default": false },
    { "id": "b_animation", "type": "select", "label": "Animation", "options": [
      {"value":"none","label":"None"},
      {"value":"fade","label":"Fade In"},
      {"value":"marquee","label":"Marquee"}
    ], "default":"none" },
    {
      "type": "image_picker",
      "id": "icon_1",
      "label": "Icon 1"
    },
    {
      "type": "checkbox",
      "id": "show_liquid_1",
      "label": "Use Liquid for Item 1",
      "default": false
    },
    {
      "type": "text",
      "id": "text_1",
      "label": "Text 1",
      "default": "Default text for item 1",
      "visible_if": "{{ section.settings.show_liquid_1 == false }}"
    },
    {
      "type": "liquid",
      "id": "liquid_1",
      "label": "Liquid 1",
      "default": "{{ shop.name }}",
      "visible_if": "{{ section.settings.show_liquid_1 == true }}"
    },

    {
      "type": "image_picker",
      "id": "icon_2",
      "label": "Icon 2"
    },
    {
      "type": "checkbox",
      "id": "show_liquid_2",
      "label": "Use Liquid for Item 2",
      "default": false
    },
    {
      "type": "text",
      "id": "text_2",
      "label": "Text 2",
      "default": "Default text for item 2",
      "visible_if": "{{ section.settings.show_liquid_2 == false }}"
    },
    {
      "type": "liquid",
      "id": "liquid_2",
      "label": "Liquid 2",
      "default": "{{ cart.item_count }} items",
      "visible_if": "{{ section.settings.show_liquid_2 == true }}"
    },

    {
      "type": "image_picker",
      "id": "icon_3",
      "label": "Icon 3"
    },
    {
      "type": "checkbox",
      "id": "show_liquid_3",
      "label": "Use Liquid for Item 3",
      "default": false
    },
    {
      "type": "text",
      "id": "text_3",
      "label": "Text 3",
      "default": "Default text for item 3",
      "visible_if": "{{ section.settings.show_liquid_3 == false }}"
    },
    {
      "type": "liquid",
      "id": "liquid_3",
      "label": "Liquid 3",
      "default": "{{ shop.currency }}",
      "visible_if": "{{ section.settings.show_liquid_3 == true }}"
    },
{
      "type": "select",
      "id": "color_scheme-icon",
      "label": "t:sections.rich-text.settings.color_scheme.label",
      "default": "1",
      "options": [
        {
          "value": "none",
          "label": "t:sections.rich-text.settings.color_scheme.options.none.label"
        },
        {
          "value": "1",
          "label": "1"
        },
        {
          "value": "2",
          "label": "2"
        },
        {
          "value": "3",
          "label": "3"
        }
      ]
    },

    { "type": "header", "content": "Timer/Discount Bar" },
    { "id": "a_enable", "type": "checkbox", "label": "Enable Timer/Discount bar", "default": true },
    { "id": "a_message", "type": "text", "label": "Message" },
    { "id": "a_sub_message", "type": "text", "label": "Sub Message" },
    { "id": "a_button_text", "type": "text", "label": "Button Text" },
    { "id": "a_link", "type": "url", "label": "Link" },
    { "id": "a_discount_code", "type": "text", "label": "Discount Code", "info": "If a discount code is added here, the button will not be shown. Leave empty if you want to display a button instead." },
    { "id": "a_two_line", "type": "checkbox", "label": "Two-line Layout", "default": false,   "info": "Enable this option if you want the message to be displayed in two lines instead of a single line." },
   { "id": "a_countdown_enable", "type": "checkbox", "label": "Enable Countdown" },
   { "id": "column_reverse", "type": "checkbox", "label": "Column reverse in mobile" },
     { "id": "a_countdown_mob", "type": "checkbox", "label": "Hide Countdown for mobile", "default": true},
    { "id": "a_countdown_text", "type": "text", "label": "Countdown timer text" },
    { "id": "a_countdown_start", "type": "text", "label": "Countdown Start (YYYY-MM-DD HH:MM)" },
{ "id": "a_countdown_end", "type": "text", "label": "Countdown End (YYYY-MM-DD HH:MM)" },
{
      "type": "select",
      "id": "color_scheme_timer",
      "label": "t:sections.rich-text.settings.color_scheme.label",
      "default": "1",
      "options": [
        {
          "value": "none",
          "label": "t:sections.rich-text.settings.color_scheme.options.none.label"
        },
        {
          "value": "1",
          "label": "1"
        },
        {
          "value": "2",
          "label": "2"
        },
        {
          "value": "3",
          "label": "3"
        }
      ]
    }
  ],
  "presets": [
    { "name": "AB Announcement Bar" }
  ]
}
{% endschema %}


<style>
    /* === Countdown Styling === */
.announcement-bar-new {
  padding:5px 15px;
  text-align: center;
}

.countdown {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 4px;
}

.countdown .time-box {
  background: #e793a0;
  padding: 5px;
  border-radius: 4px;
  text-align: center;
  min-width: 40px;
}
.btn-announcement.discount_code {
    border: 1px solid;
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 4px 20px;
}
.countdown .num {
  display: block;
  font-size: 15px;
  font-weight: bold;
  line-height:1.2;
}

.countdown .label {
    display: block;
    font-size: 10px;
    text-transform: uppercase;
    letter-spacing: 1px;
    font-weight: 500;
    line-height: 1.3;
}

.countdown .colon {
  font-size: 22px;
  font-weight: bold;
}
.announcement-inner {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 5%;
}

.announcement-inner .message {
  font-size: 18px;
  font-weight: normal;
}
.countdown_wrap {
    display: flex;
    align-items: center;
    gap: 15px;
}
.countdown_wrap .timer_text {
    margin: 0;
    line-height: 1.3;
    font-size: 14px;
}
.announcement-text-wrap {
    flex-direction: column;
    display: flex;
}
.announcement-text-wrap .message {
    line-height: 1.3;
    text-transform: uppercase;
    font-weight: 600;
    font-size: 16px;
}
.announcement-text-wrap .sub {
    font-size: 14px;
    line-height: 1.3;
}
.announcement-text-wrap_single {
    font-size: 15px;
}

{% comment %} .announcement-bar-icons {
    background: #E8E8E1;
} {% endcomment %}

.announcement-bar-icons .announcement-item_wrap {
    display: flex;
    flex-wrap:wrap;
    align-items: center;
    justify-content: center;
}
.announcement-item .icon_wrap {
    display: flex;
    align-items: center;
    gap: 6px;
}
.announcement-item .icon_wrap span {
    display: flex;
    gap: 4px;
}
.announcement-item .icon_wrap img {
    max-width: 17px;
    height: auto;
}
.announcement-bar-icons .announcement-item_wrap {
    column-gap: 45px;
    row-gap:10px;
}
.announcement-bar-icons {
    padding-top: 8px;
    padding-bottom: 8px;
}
{% if section.settings.b_animation == 'fade'%}
/* fade_slide */
.fade .announcement-item {
  height: 25px;          /* same as slider */
       /* vertical centering */
  text-align: center;
  opacity: 0;
  position: absolute;
  animation: fadeSlide 18s infinite;
}
.fade .announcement-item:nth-child(1) { animation-delay: 0s; }
.fade .announcement-item:nth-child(2) { animation-delay: 6s; }
.fade .announcement-item:nth-child(3) { animation-delay: 12s; }

@keyframes fadeSlide {
  0%   { opacity: 0; transform: translateY(100%); }
  5%   { opacity: 1; transform: translateY(0); }
  30%  { opacity: 1; transform: translateY(0); }
  35%  { opacity: 0; transform: translateY(-100%); }
  100% { opacity: 0; transform: translateY(-100%); }
}
.announcement-item_wrap.fade{
    height: 25px;
}
.announcement-item_wrap.fade{
    display: flex;
    align-items: center;
}
/* end fade slide */
{% endif %}

