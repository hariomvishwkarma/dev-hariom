<div class="index-section text-center">
  <div class="page-width{% if section.settings.narrow_column %} page-width--narrow{% endif %}">
    <h2>{{ section.settings.heading }}</h2>
    <p>{{ section.settings.subheading }}</p>
    
    {%- assign show_header_images = false -%}
    {%- capture header_images -%}{%- endcapture -%}
    {%- capture header_row -%}{%- endcapture -%}

    {%- for i in (1..4) -%}
      {%- assign image_key = "th_image_" | append: i -%}
      {%- assign text_key = "th_text_" | append: i -%}

      {%- capture header_images -%}
        {{ header_images }}
        {%- if section.settings[text_key] != blank -%}
          {% if section.settings.first_row_as_th == true %}
            <th>
              {%- if section.settings[image_key] -%}
                {%- assign show_header_images = true -%}
                {{ section.settings[image_key] | image_url: width: 200 | image_tag: loading: 'lazy', alt: section.settings[image_key].alt, widths: '100, 200, 300, 400', class: "image" }}
              {%- endif -%}
            </th>
          {% else %}
            <td>
              {%- if section.settings[image_key] -%}
                {%- assign show_header_images = true -%}
                {{ section.settings[image_key] | image_url: width: 200 | image_tag: loading: 'lazy', alt: section.settings[image_key].alt, widths: '100, 200, 300, 400', class: "image" }}
              {%- endif -%}
            </td>
          {% endif %}
        {%- endif -%}
      {%- endcapture -%}

      {%- capture header_row -%}
        {{ header_row }}
        {%- if section.settings[text_key] != blank -%}
          <th {% if i == 1 and section.settings.first_col_as_th %}class="th"{% endif %}>
            {{ section.settings[text_key] }}
          </th>
        {%- endif -%}
      {%- endcapture -%}
    {%- endfor -%}

    <table class="table-section {% if page.handle == 'treueprogramm' %}mobile_table_layout{% endif %}">
      {%- if show_header_images -%}
        <tr class="th-images">{{ header_images }}</tr>
      {%- endif -%}
      {{ header_row }}

      {%- for block in section.blocks -%}
        <tr>
          {%- for i in (1..4) -%}
            {%- assign text_key = "text_" | append: i -%}
            {%- assign image_key = "image_" | append: i -%}
            {%- assign span_key = "colspan_" | append: i -%}
      
            {%- if block.settings[text_key] != blank or block.settings[image_key] -%}
              <td colspan="{{ block.settings[span_key] }}" {% if i == 1 and section.settings.first_col_as_th %}class="th"{% endif %}>
                {%- if block.settings[text_key] != blank -%}
                  {{ block.settings[text_key] }}
                {%- endif -%}
                {%- if block.settings[image_key] -%}
                  {{ block.settings[image_key] | image_url: height: 25 | image_tag: loading: 'lazy', alt: block.settings[image_key].alt, heights: '25', class: "td-image" }}
                {%- endif -%}
              </td>
            {%- endif -%}
          {%- endfor -%}
        </tr>
      {%- endfor -%}
    </table>

  </div>
</div>

{% schema %}
