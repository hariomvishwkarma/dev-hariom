<div {% unless section.settings.full_width %}class="index-section"{% endunless %} data-section-id="{{ section.id }}" data-section-type="countdown">
  <div
    class="
      countdown-wrapper {% unless section.settings.full_width %}page-width{% endunless %}
      countdown-layout--{{ section.settings.layout }}
      countdown-blocks--{{ section.blocks.size }}
      countdown__image--blur-{{ section.settings.blur_image }}
      {% if section.settings.background_image != blank %}
        countdown__background-image--true
      {% else %}
        countdown__background-image--false
      {% endif %}
      {% if section.settings.mobile_image != blank %}
        countdown__mobile-image--true
      {% else %}
        countdown__mobile-image--false
      {% endif %}
    "
  >
    <div
      class="color-scheme-{{ section.settings.color_scheme }}">
      {% if section.settings.background_image != blank %}
        <div
          class="
            countdown__background-image-wrapper {% if section.settings.mobile_image != blank %}small--hide{% endif %}
          "
        >
          {% comment %} Full width image so don't need to adjust sizes attribute, fallback is 100vw {% endcomment %}
          {%- render 'image-element',
            img: section.settings.background_image,
            img_width: 2400,
            loading: section.settings.lazyload_images,
            classes: 'countdown__background-image',
          -%}
          {% style %}
            #shopify-section-{{ section.id }} .countdown__background-image {
              {% if section.settings.blur_image %}
                filter: blur(4px);
                {% if section.settings.layout == 'banner' %}
                  transform: scale(1.1);
                {% else %}
                  transform: scale(1.03);
                {% endif %}
              {% endif %}
            }
          {% endstyle %}
          {% if section.settings.overlay_opacity > 0 %}
            {% assign overlay_alpha = section.settings.overlay_opacity | divided_by: 100.0 %}
              <div
                class="
                  countdown__overlay
                  {% if section.settings.mobile_image != blank %}small--hide{% endif %}
                "
                style="
                  --countdown-overlay-rgba: {{ section.settings.overlay_color  | color_modify: 'alpha', overlay_alpha }}
                "
              ></div>
          {% endif %}
        </div>
      {% endif %}
      {% if section.settings.mobile_image != blank %}
          <div
            class="countdown__mobile-image-wrapper"
          >
            {% comment %} Full width image so don't need to adjust sizes attribute, fallback is 100vw {% endcomment %}
            {%- render 'image-element',
              img: section.settings.mobile_image,
              loading: section.settings.lazyload_images,
              classes: 'countdown__mobile-image medium-up--hide',
            -%}
            {% if section.settings.overlay_opacity > 0 %}
              {% assign overlay_alpha = section.settings.overlay_opacity | divided_by: 100.0 %}
                <div
                  class="countdown__overlay medium-up--hide"
                  style="
                    --countdown-overlay-rgba: {{ section.settings.overlay_color  | color_modify: 'alpha', overlay_alpha }}
                  "
                ></div>
            {% endif %}
          </div>
      {% endif %}

      {% capture block_contents %}
        {% for block in section.blocks %}
          <div class="countdown__content {% if section.blocks.size > 1 %}slideshow__slide{% endif %}" data-index="{{ forloop.index }}">
            <div class="countdown__block countdown__block--content" {{ block.shopify_attributes }}>
              <div class="countdown__text-wrapper countdown__text-wrapper--content-alignment-{{ block.settings.content_alignment }}">
                <div class="countdown__heading">
                  <{{ section.settings.heading_tag }} class="{{ block.settings.heading_size }}">{{ block.settings.heading }}</{{ section.settings.heading_tag }}>
                </div>
                <div class="countdown__richtext">
                  {{ block.settings.text }}
                </div>
                {% if section.blocks.size > 2 and section.blocks[0].type == 'content' and section.blocks[1].type == 'button' %}
                  <div class="countdown__block countdown__block--button">
                    <a
                      class="countdown__button btn btn--{{ section.blocks[1].settings.button_style }}"
                      href="{{ section.blocks[1].settings.button_link }}"
                    >
                      {{ section.blocks[1].settings.button }}
                    </a>
                  </div>
                {% endif %}
              </div>
            </div>
    
            {% if block.settings.show_timer %}
              <div class="countdown__block countdown__block--timer" {{ block.shopify_attributes }}>
                <countdown-timer
                  data-year="{{ block.settings.year }}"
                  data-month="{{ block.settings.month }}"
                  data-day="{{ block.settings.day }}"
                  data-hour="{{ block.settings.hour }}"
                  data-minute="{{ block.settings.minute }}"
                  data-hide-timer="{{ block.settings.hide_timer }}"
                  data-complete-message="{{ block.settings.expired_text }}"
                >
                  <div class="countdown__display countdown__display--visible" data-time-display>
                    <div class="countdown__display-block">
                      <{{ block.settings.countdown_tag }} class="{% if section.blocks.size == 1 %}h1{% elsif section.blocks.size == 3 %}h3{% endif %}" date-days-placeholder>12</{{ block.settings.countdown_tag }}>
                      <span>DAYS</span>
                    </div>
                    <div class="countdown__display-block">
                      <{{ block.settings.countdown_tag }} class="{% if section.blocks.size == 1 %}h1{% elsif section.blocks.size == 3 %}h3{% endif %}" date-hours-placeholder>12</{{ block.settings.countdown_tag }}>
                      <span>HOURS</span>
                    </div>
                    <div class="countdown__display-block">
                      <{{ block.settings.countdown_tag }} class="{% if section.blocks.size == 1 %}h1{% elsif section.blocks.size == 3 %}h3{% endif %}" date-minutes-placeholder>12</{{ block.settings.countdown_tag }}>
                    <span>MINUTES</span>
                    </div>
                    <div class="countdown__display-block">
                      <{{ block.settings.countdown_tag }} class="{% if section.blocks.size == 1 %}h1{% elsif section.blocks.size == 3 %}h3{% endif %}" date-seconds-placeholder>12</{{ block.settings.countdown_tag }}>
                      <span>SECONDS</span>
                    </div>
                  </div>
                  {% if block.settings.text != blank %}
                    <div class="countdown__timer-message" data-message-placeholder>{{ block.settings.text }}</div>
                  {% endif %}
                </countdown-timer>
              </div>  
            {% endif %}
    
            {% if block.settings.button != blank and block.settings.button_link != blank %}
              <div class="countdown__block countdown__block--button button-block-active" {{ block.shopify_attributes }}>
                <a
                  class="countdown__button btn btn--{{ block.settings.button_style }}"
                  href="{{ block.settings.button_link }}"
                >
                  {{ block.settings.button }}
                </a>
              </div>
            {% endif %}
          </div>
        {% endfor %}
      {% endcapture %}

      {% if section.blocks.size > 1 %}
        <div class="slideshow-wrapper countdown-slider-wrapper" data-flickity-autoplay={{ section.settings.flickity_autoplay }}>
          <button type="button" class="visually-hidden slideshow__pause" data-id="{{ section.id }}" aria-live="polite">
            <span class="slideshow__pause-stop">
              <svg aria-hidden="true" focusable="false" role="presentation" class="icon icon-pause" viewBox="0 0 10 13"><g fill="#000" fill-rule="evenodd"><path d="M0 0h3v13H0zM7 0h3v13H7z"/></g></svg>
              <span class="icon__fallback-text">{{ 'sections.slideshow.pause_slideshow' | t }}</span>
            </span>
            <span class="slideshow__pause-play">
              <svg aria-hidden="true" focusable="false" role="presentation" class="icon icon-play" viewBox="18.24 17.35 24.52 28.3"><path fill="#323232" d="M22.1 19.151v25.5l20.4-13.489-20.4-12.011z"/></svg>
              <span class="icon__fallback-text">{{ 'sections.slideshow.play_slideshow' | t }}</span>
            </span>
          </button>

          <div class="countdown-slider slider" data-block-count="{{ section.blocks.size }}">
            {{ block_contents }}
          </div>
        </div>
      {% else %}
        {{ block_contents }}
      {% endif %}
    </div>
  </div>
</div>

