{% style %}
  @media only screen and (max-width:768px) {
    #shopify-section-{{ section.id }} .grid-item {
      {% comment %}
      max-width: {{ 100 | divided_by: section.settings.products_per_slide }}%;
      flex: 0 0 {{ 100 | divided_by: section.settings.products_per_slide }}%;
      {% endcomment %}
      max-width: 70%; 
      flex: 0 0 70%;
    }
  }
  @media only screen and (min-width:769px) {
    #shopify-section-{{ section.id }} .grid-item {
      max-width: {{ 100 | divided_by: section.settings.products_per_row }}%;
      flex: 0 0 {{ 100 | divided_by: section.settings.products_per_row }}%;
    }
  }
{% endstyle %}

<div
  data-subsection
  data-section-id="{{ section.id }}"
  data-section-type="recently-viewed"
  data-max-products="{{ section.settings.max_products }}"
  data-max-products-mobile="{{ section.settings.max_products_mobile }}"
  data-product-id="{{ product.id }}">
  <div class="index-section index-section--sub-product">
    <div class="page-width">
      <header class="section-header">
        <div class="h3 section-header__title">{{ 'products.general.recent_products' | t }}</div>
      </header>
    </div>

    <div class="page-width page-width--flush-small">
      <div id="RecentlyViewed-{{ section.id }}"></div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "t:sections.recently-viewed.name",
  "class": "recently-viewed__section",
  "settings": [
    {
      "type": "paragraph",
      "content": "t:sections.recently-viewed.settings.content"
    },
    {
      "type": "range",
      "id": "max_products",
      "min": 1,
      "max": 30,
      "step": 1,
      "label": "Max. products (desktop)",
      "default": 10
    },
    {
      "type": "range",
      "id": "max_products_mobile",
      "min": 1,
      "max": 30,
      "step": 1,
      "label": "Max. products (mobile)",
      "default": 10
    },
    {
      "type": "range",
      "id": "products_per_row",
      "min": 1,
      "max": 5,
      "step": 1,
      "label": "Products per row (desktop)",
      "default": 3
    },
    {
      "type": "range",
      "id": "products_per_slide",
      "min": 1,
      "max": 3,
      "step": 1,
      "label": "Products per slide (mobile)",
      "default": 3
    }
  ],
  "disabled_on": {
    "groups": ["footer", "header", "custom.popups"]
  }
}
{% endschema %}
