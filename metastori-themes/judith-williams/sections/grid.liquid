<div class="index-section text-center">
  <div class="page-width{% if section.settings.narrow_column %} page-width--narrow{% endif %}">
    <h2>{{ section.settings.heading }}</h2>
    <p>{{ section.settings.subheading }}</p>

    <div class="grid-section">
      {%- for block in section.blocks -%}
        {%- capture block_content -%}
          <div class="grid-section_item">
            {%- if block.settings.image -%}
              {{ block.settings.image | image_url: width: 200 | image_tag: loading: 'lazy', alt: block.settings.image.alt, widths: '100, 200, 300, 400', class: "image" }}
            {%- endif -%}
            {%- if  block.settings.text != blank -%}
              <p class="text--small">{{ block.settings.text }}</p>
            {%- endif -%}
            {%- if  block.settings.text_small != blank -%}
              <p class="text--very-small">{{ block.settings.text_small }}</p>
            {%- endif -%}
          </div>
        {%- endcapture -%}

        {%- if block.settings.link -%}
          <a href="{{ block.settings.link }}">
            {{ block_content }}
          </a>
        {%- else -%}
          {{ block_content }}
        {%- endif -%}
      {%- endfor -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "t:sections.grid.name",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "t:sections.grid.settings.heading.label"
    },
    {
      "type": "richtext",
      "id": "subheading",
      "label": "t:sections.grid.settings.subheading.label"
    },
    {
      "type": "checkbox",
      "id": "narrow_column",
      "label": "t:sections.grid.settings.narrow_column.label",
      "default": true
    }
  ],
  "blocks": [
    {
      "type": "grid_item",
      "name": "t:sections.grid.blocks.grid_item.name",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "t:sections.grid.blocks.grid_item.settings.image.label"
        },
        {
          "type": "text",
          "id": "text",
          "label": "t:sections.grid.blocks.grid_item.settings.text.label"
        },
        {
          "type": "text",
          "id": "text_small",
          "label": "t:sections.grid.blocks.grid_item.settings.text_small.label"
        },
        {
          "type": "url",
          "id": "link",
          "label": "t:sections.grid.blocks.grid_item.settings.link.label"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:sections.grid.presets.name"
    }
  ]
}
{% endschema %}
