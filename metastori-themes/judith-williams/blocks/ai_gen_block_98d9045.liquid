{% doc %}
  @prompt
    Create a minimal, theme-compatible section for a skincare product page.
    
    Header area:
    • Optional heading with tag options h1/h2/h3 — must inherit the theme’s default font sizes (no fixed px).
    • Custom text field (default: “Das steckt hinter der Magie”).
    • Alignment options: Left / Centered / Right.
    • Toggle to show or hide a divider line.
    • Color scheme selector (None, 1, 2, 3 – use theme values).
    • Optional intro paragraph below the heading.
    
    Cards (dynamic blocks):
    • Cards should be repeatable sub-blocks (merchant can add more than 3).
    • Each card includes:
    
    Category label (e.g. “HYDRATION”)
    
    Headline (ingredient name)
    
    Short text (2–3 lines)
    
    “Read more +” link
    
    Image field (auto-scaled, with alt text)
    
    Image behaviour:
    • Image fills the entire bottom area of the card (not just right corner).
    • Use object-fit: cover and dynamic height (~30–45 % of card).
    • Optional soft gradient at top edge to improve text contrast.
    
    Layout:
    • Straight corners, soft shadows, white/neutral background.
    • On desktop: cards in a responsive grid (auto-fit).
    • On mobile: horizontal swipe carousel (scroll-snap) — each card ~ 85–90 % viewport width, partial next card visible.
    • Maintain generous padding, clear spacing, and readable font sizes.
    
    General:
    • Inherit all typography and colors from current theme.
    • Use semantic headings, lazy-load images, and accessible alt text.
    • Look and feel: clean, premium, trustworthy — modern skincare for women 50+., Card shadow (MUST):
    Add a subtle elevation to each card using the theme’s default shadow token. If the theme has no token, fall back to:
    box-shadow: 0 2px 12px rgba(0,0,0,0.06); and a hairline border 1px solid rgba(0,0,0,0.06).
    No heavy shadows. On desktop only, increase slightly on hover; keep mobile static.
    
    Carousel dots (MUST):
    Add centered pagination dots below the swipe carousel. Dots are tappable, keyboard-focusable, and announce the current slide (aria-live polite).
    Sizing: 8–10px; spacing: 6–8px.
    Inactive: 30–40% opacity. Active: 100% opacity and 10–12px size (or a ring).
    Include a section setting: Show dots (on/off) and Show arrows (on/off). Arrows hidden on mobile, visible on tablet/desktop., Remove the border line, and use a soft shadow effect for each card. Use only the pagination dots, inherited from the theme.
    The card slide should maintain the distance from the margin as for the other sections on the theme, Add the possibility to add some space before and after this section. , Include a toggle named “Add spacing above and below”.
    • When enabled, apply additional top and bottom padding according to the theme’s spacing scale (use the same values as other sections that have this setting).
    • When disabled, keep only the default internal spacing of the section., The "spacing" toggle should allow to increase the margin not the padding. So that the section has more distance from the other ones., Create a section setting:
    
    type: "checkbox", id: "spacing_extra", label: "Add spacing above and below", default: false.
    
    Behavior:
    
    When spacing_extra = true, increase the section wrapper’s vertical padding using theme tokens (no fixed px):
    
    use the theme’s large section padding variables (e.g. var(--section-padding-block-large) or equivalent).
    
    If the theme has no tokens, fallback to padding-block: 56px on mobile and 72px on desktop.
    
    When false, keep the theme’s default section padding.
    
    Apply padding only to the outer section container, not the inner cards., Include a checkbox setting named “Add spacing above and below”.
    
    When enabled, apply extra top and bottom padding using the theme’s spacing scale (e.g. var(--section-padding-block-large) or equivalent).
    
    Default state: off.
    
    Padding applies only to the outer section wrapper.
    
    Cards must support horizontal swipe on mobile and tablet:
    
    Implement a scroll-snap carousel with smooth touch scrolling.
    
    Each card takes 85–90% of the viewport width.
    
    Next card should be partially visible to indicate swipe capability.
    
    Carousel should include pagination dots (centered below cards) for navigation.
    
    Use native touch gestures — no arrows on mobile.
    
    Ensure accessibility (aria-labels, focusable dots).
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-skincare-section-{{ ai_gen_id }} {
    {% if block.settings.spacing_extra %}
      padding-top: 56px;
      padding-bottom: 56px;
    {% endif %}
  }

  @media (min-width: 750px) {
    .ai-skincare-section-{{ ai_gen_id }} {
      {% if block.settings.spacing_extra %}
        padding-top: 72px;
        padding-bottom: 72px;
      {% endif %}
    }
  }

  {% if block.settings.color_scheme == 'scheme_1' %}
    .ai-skincare-section-{{ ai_gen_id }} {
      background-color: #e77b8d;
      color: #ffffff;
    }
  {% elsif block.settings.color_scheme == 'scheme_2' %}
    .ai-skincare-section-{{ ai_gen_id }} {
      background-color: #e8e8e1;
      color: #000000;
    }
  {% elsif block.settings.color_scheme == 'scheme_3' %}
    .ai-skincare-section-{{ ai_gen_id }} {
      background-color: #83888d;
      color: #ffffff;
    }
  {% else %}
    .ai-skincare-section-{{ ai_gen_id }} {
      background-color: #ffffff;
      color: #000000;
    }
  {% endif %}

  .ai-skincare-container-{{ ai_gen_id }} {
    max-width: 1440px;
    margin: 0 auto;
    padding: 40px 20px;
  }

  @media (min-width: 750px) {
    .ai-skincare-container-{{ ai_gen_id }} {
      padding: 40px 40px;
    }
  }

  .ai-skincare-header-{{ ai_gen_id }} {
    margin: 0 auto 50px;
    text-align: {{ block.settings.text_alignment }};
  }

  .ai-skincare-heading-{{ ai_gen_id }} {
    margin: 0 0 12px;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .ai-skincare-intro-{{ ai_gen_id }} {
    margin: 16px 0 0;
    line-height: 1.6;
    max-width: 700px;
    {% if block.settings.text_alignment == 'center' %}
      margin-left: auto;
      margin-right: auto;
    {% elsif block.settings.text_alignment == 'right' %}
      margin-left: auto;
    {% endif %}
  }

  .ai-skincare-divider-{{ ai_gen_id }} {
    height: 1px;
    background-color: currentColor;
    opacity: 0.2;
    margin: 24px 0 0;
    max-width: 100px;
    {% if block.settings.text_alignment == 'center' %}
      margin-left: auto;
      margin-right: auto;
    {% elsif block.settings.text_alignment == 'right' %}
      margin-left: auto;
    {% endif %}
  }

  .ai-skincare-cards-wrapper-{{ ai_gen_id }} {
    position: relative;
  }

  @media (min-width: 990px) {
    .ai-skincare-cards-grid-{{ ai_gen_id }} {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
      gap: 24px;
    }
  }

  @media (max-width: 989px) {
    .ai-skincare-cards-grid-{{ ai_gen_id }} {
      display: flex;
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      gap: 16px;
      padding-bottom: 16px;
      -webkit-overflow-scrolling: touch;
      scrollbar-width: none;
      margin: 0 -20px;
      padding-left: 20px;
      padding-right: 20px;
    }

    .ai-skincare-cards-grid-{{ ai_gen_id }}::-webkit-scrollbar {
      display: none;
    }
  }

  .ai-skincare-card-{{ ai_gen_id }} {
    background: #ffffff;
    box-shadow: 0 2px 12px rgba(0, 0, 0, 0.06);
    display: flex;
    flex-direction: column;
    overflow: hidden;
    position: relative;
    transition: box-shadow 0.3s ease, transform 0.3s ease;
  }

  @media (min-width: 990px) {
    .ai-skincare-card-{{ ai_gen_id }}:hover {
      box-shadow: 0 4px 20px rgba(0, 0, 0, 0.1);
      transform: translateY(-2px);
    }
  }

  @media (max-width: 989px) {
    .ai-skincare-card-{{ ai_gen_id }} {
      min-width: 87vw;
      scroll-snap-align: center;
    }
  }

  .ai-skincare-card-content-{{ ai_gen_id }} {
    padding: 24px;
    flex-grow: 1;
    display: flex;
    flex-direction: column;
  }

  .ai-skincare-card-category-{{ ai_gen_id }} {
    font-size: 11px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: #e77b8d;
    margin: 0 0 8px;
    font-weight: 600;
  }

  .ai-skincare-card-headline-{{ ai_gen_id }} {
    font-size: 20px;
    margin: 0 0 12px;
    color: #000000;
    font-weight: 600;
    line-height: 1.3;
  }

  .ai-skincare-card-text-{{ ai_gen_id }} {
    font-size: 14px;
    line-height: 1.6;
    color: #333333;
    margin: 0 0 16px;
    flex-grow: 1;
  }

  .ai-skincare-card-link-{{ ai_gen_id }} {
    font-size: 14px;
    color: #e77b8d;
    text-decoration: none;
    font-weight: 600;
    display: inline-flex;
    align-items: center;
    gap: 4px;
    transition: opacity 0.2s ease;
  }

  .ai-skincare-card-link-{{ ai_gen_id }}:hover {
    opacity: 0.7;
  }

  .ai-skincare-card-image-wrapper-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    height: 0;
    padding-bottom: 40%;
    overflow: hidden;
  }

  .ai-skincare-card-image-wrapper-{{ ai_gen_id }}::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 60px;
    background: linear-gradient(to bottom, rgba(255, 255, 255, 0.4), transparent);
    z-index: 1;
    pointer-events: none;
  }

  .ai-skincare-card-image-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ai-skincare-card-image-placeholder-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-color: #f4f4f4;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .ai-skincare-card-image-placeholder-{{ ai_gen_id }} svg {
    width: 60%;
    height: 60%;
    opacity: 0.3;
  }

  .ai-skincare-carousel-controls-{{ ai_gen_id }} {
    display: flex;
    align-items: center;
    justify-content: center;
    margin-top: 32px;
  }

  @media (min-width: 990px) {
    .ai-skincare-carousel-controls-{{ ai_gen_id }} {
      display: none;
    }
  }

  .ai-skincare-dots-{{ ai_gen_id }} {
    display: flex;
    gap: 7px;
    align-items: center;
    justify-content: center;
  }

  .ai-skincare-dot-{{ ai_gen_id }} {
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background-color: currentColor;
    opacity: 0.35;
    border: none;
    padding: 0;
    cursor: pointer;
    transition: all 0.3s ease;
  }

  .ai-skincare-dot-{{ ai_gen_id }}:hover {
    opacity: 0.6;
  }

  .ai-skincare-dot-{{ ai_gen_id }}:focus {
    outline: 2px solid currentColor;
    outline-offset: 2px;
  }

  .ai-skincare-dot-{{ ai_gen_id }}.active {
    width: 11px;
    height: 11px;
    opacity: 1;
  }

  .ai-skincare-sr-only-{{ ai_gen_id }} {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border-width: 0;
  }
{% endstyle %}

<skincare-carousel-{{ ai_gen_id }} class="ai-skincare-section-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-skincare-container-{{ ai_gen_id }}">
    {% if block.settings.heading != blank or block.settings.intro_text != blank %}
      <div class="ai-skincare-header-{{ ai_gen_id }}">
        {% if block.settings.heading != blank %}
          {% if block.settings.heading_tag == 'h1' %}
            <h1 class="ai-skincare-heading-{{ ai_gen_id }}">{{ block.settings.heading }}</h1>
          {% elsif block.settings.heading_tag == 'h2' %}
            <h2 class="ai-skincare-heading-{{ ai_gen_id }}">{{ block.settings.heading }}</h2>
          {% else %}
            <h3 class="ai-skincare-heading-{{ ai_gen_id }}">{{ block.settings.heading }}</h3>
          {% endif %}
        {% endif %}

        {% if block.settings.show_divider %}
          <div class="ai-skincare-divider-{{ ai_gen_id }}"></div>
        {% endif %}

        {% if block.settings.intro_text != blank %}
          <div class="ai-skincare-intro-{{ ai_gen_id }}">
            {{ block.settings.intro_text }}
          </div>
        {% endif %}
      </div>
    {% endif %}

    <div class="ai-skincare-cards-wrapper-{{ ai_gen_id }}">
      <div class="ai-skincare-cards-grid-{{ ai_gen_id }}" role="region" aria-label="Ingredient cards">
        {% assign card_count = 0 %}
        {% for i in (1..6) %}
          {% assign headline_key = 'card_' | append: i | append: '_headline' %}
          {% assign headline = block.settings[headline_key] %}
          {% if headline != blank %}
            {% assign card_count = card_count | plus: 1 %}
          {% endif %}
        {% endfor %}

        {% for i in (1..6) %}
          {% assign category_key = 'card_' | append: i | append: '_category' %}
          {% assign headline_key = 'card_' | append: i | append: '_headline' %}
          {% assign text_key = 'card_' | append: i | append: '_text' %}
          {% assign link_text_key = 'card_' | append: i | append: '_link_text' %}
          {% assign link_url_key = 'card_' | append: i | append: '_link_url' %}
          {% assign image_key = 'card_' | append: i | append: '_image' %}

          {% assign category = block.settings[category_key] %}
          {% assign headline = block.settings[headline_key] %}
          {% assign text = block.settings[text_key] %}
          {% assign link_text = block.settings[link_text_key] %}
          {% assign link_url = block.settings[link_url_key] %}
          {% assign image = block.settings[image_key] %}

          {% if headline != blank or text != blank or image %}
            <div class="ai-skincare-card-{{ ai_gen_id }}" data-card-index="{{ forloop.index0 }}">
              <div class="ai-skincare-card-content-{{ ai_gen_id }}">
                {% if category != blank %}
                  <div class="ai-skincare-card-category-{{ ai_gen_id }}">{{ category }}</div>
                {% endif %}

                {% if headline != blank %}
                  <h3 class="ai-skincare-card-headline-{{ ai_gen_id }}">{{ headline }}</h3>
                {% endif %}

                {% if text != blank %}
                  <div class="ai-skincare-card-text-{{ ai_gen_id }}">{{ text }}</div>
                {% endif %}

                {% if link_url != blank and link_text != blank %}
                  <a href="{{ link_url }}" class="ai-skincare-card-link-{{ ai_gen_id }}">
                    {{ link_text }}
                    <span>+</span>
                  </a>
                {% endif %}
              </div>

              <div class="ai-skincare-card-image-wrapper-{{ ai_gen_id }}">
                {% if image %}
                  <img
                    src="{{ image | image_url: width: 800 }}"
                    alt="{{ image.alt | escape }}"
                    loading="lazy"
                    width="{{ image.width }}"
                    height="{{ image.height }}"
                    class="ai-skincare-card-image-{{ ai_gen_id }}"
                  >
                {% else %}
                  <div class="ai-skincare-card-image-placeholder-{{ ai_gen_id }}">
                    {{ 'image' | placeholder_svg_tag }}
                  </div>
                {% endif %}
              </div>
            </div>
          {% endif %}
        {% endfor %}
      </div>

      {% if block.settings.show_dots %}
        <div class="ai-skincare-carousel-controls-{{ ai_gen_id }}">
          <div class="ai-skincare-dots-{{ ai_gen_id }}" role="tablist" aria-label="Carousel pagination">
            {% for i in (1..card_count) %}
              <button
                type="button"
                class="ai-skincare-dot-{{ ai_gen_id }} {% if forloop.first %}active{% endif %}"
                role="tab"
                aria-label="Go to slide {{ forloop.index }}"
                aria-selected="{% if forloop.first %}true{% else %}false{% endif %}"
                data-dot-index="{{ forloop.index0 }}"
              ></button>
            {% endfor %}
          </div>
          <div class="ai-skincare-sr-only-{{ ai_gen_id }}" aria-live="polite" aria-atomic="true"></div>
        </div>
      {% endif %}
    </div>
  </div>
</skincare-carousel-{{ ai_gen_id }}>

<script>
(function() {
  class SkincareCarousel{{ ai_gen_id }} extends HTMLElement {
    constructor() {
      super();
      this.currentSlide = 0;
      this.totalSlides = 0;
    }

    connectedCallback() {
      this.carousel = this.querySelector('.ai-skincare-cards-grid-{{ ai_gen_id }}');
      this.cards = Array.from(this.querySelectorAll('.ai-skincare-card-{{ ai_gen_id }}'));
      this.dots = Array.from(this.querySelectorAll('.ai-skincare-dot-{{ ai_gen_id }}'));
      this.liveRegion = this.querySelector('.ai-skincare-sr-only-{{ ai_gen_id }}');
      this.totalSlides = this.cards.length;

      if (this.totalSlides === 0) return;

      this.setupEventListeners();
    }

    setupEventListeners() {
      if (this.carousel) {
        this.carousel.addEventListener('scroll', this.handleScroll.bind(this));
      }

      this.dots.forEach((dot, index) => {
        dot.addEventListener('click', () => this.goToSlide(index));
      });
    }

    handleScroll() {
      if (!this.carousel || this.totalSlides === 0) return;

      const scrollLeft = this.carousel.scrollLeft;
      const cardWidth = this.cards[0].offsetWidth;
      const gap = 16;
      const slideIndex = Math.round(scrollLeft / (cardWidth + gap));

      if (slideIndex !== this.currentSlide) {
        this.currentSlide = slideIndex;
        this.updateDots();
        this.announceSlide();
      }
    }

    goToSlide(index) {
      if (!this.carousel || index < 0 || index >= this.totalSlides) return;

      const card = this.cards[index];
      if (card) {
        card.scrollIntoView({ behavior: 'smooth', block: 'nearest', inline: 'center' });
      }
    }

    updateDots() {
      this.dots.forEach((dot, index) => {
        const isActive = index === this.currentSlide;
        dot.classList.toggle('active', isActive);
        dot.setAttribute('aria-selected', isActive ? 'true' : 'false');
      });
    }

    announceSlide() {
      if (this.liveRegion) {
        this.liveRegion.textContent = 'Slide ' + (this.currentSlide + 1) + ' of ' + this.totalSlides;
      }
    }
  }

  customElements.define('skincare-carousel-{{ ai_gen_id }}', SkincareCarousel{{ ai_gen_id }});
})();
</script>

