{% doc %}
  @prompt
    Create a clean, minimalistic section with three rectangular information cards (no rounded corners), inspired by premium skincare websites.
    
    Each card should include:
    • A small category label at the top (e.g. “HYDRATION”)
    • A clear headline for the ingredient name
    • A short paragraph (2–3 lines) describing the benefit
    • A “Read more +” link at the bottom
    • A small, elegant ingredient-related image or texture (e.g. cream swirl, water drop, pigment) positioned in the lower or right area of the card
    
    Design requirements:
    • Use the existing typography and color scheme from the current theme — including heading styles, text colors, and link color.
    • White or neutral background with soft shadows or light dividers between cards.
    • Straight edges (no border radius).
    • Three cards displayed side-by-side on desktop and stacked vertically on mobile.
    • Maintain generous padding and balanced spacing.
    
    Overall feel: Clean, premium, and trustworthy — reflecting the look of a modern skincare brand for mature, beauty-conscious customers., Mobile layout:
    • Cards should appear in a horizontal swipe carousel (side-scroll) rather than stacked vertically.
    • Each card takes ~85–90% of the viewport width, with gentle snap-to-center scrolling.
    • Include a small visual cue (like partial next card or subtle dots) to indicate swipe interaction.
    • Maintain consistent padding and spacing within each card for readability.
    • Ensure all text remains legible with slightly larger font sizes and generous line spacing for mature audiences.
    • “Read more +” link must stay clearly visible and easy to tap.
    • Ingredient images should scale responsively and never overlap text., Add the following:
    Optional headline at the top (e.g. “The Science Behind the Magic Wonder Balm”)
    • Optional intro paragraph below the headline (1–2 short sentences explaining that each ingredient contributes to a natural, healthy glow), The heading block should be customisable:
    A configurable heading block with:
    
    Heading tag options (h1, h2, or h3)
    
    Custom text field (default: “Das steckt hinter der Magie”)
    
    Alignment options (Left, Centered, Right)
    
    Toggle option to show or hide a section divider line below the heading
    
    Color scheme selector (options: None, 1, 2, 3 — inherited from theme)
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-ingredient-cards-{{ ai_gen_id }} {
    padding: 60px 20px;
    background-color: {{ block.settings.section_bg_color }};
  }

  .ai-ingredient-cards-container-{{ ai_gen_id }} {
    max-width: 1200px;
    margin: 0 auto;
  }

  .ai-ingredient-cards-header-{{ ai_gen_id }} {
    margin-bottom: 50px;
    {% if block.settings.heading_alignment == 'left' %}
      text-align: left;
    {% elsif block.settings.heading_alignment == 'center' %}
      text-align: center;
    {% elsif block.settings.heading_alignment == 'right' %}
      text-align: right;
    {% endif %}
  }

  .ai-ingredient-cards-heading-{{ ai_gen_id }} {
    font-size: 38px;
    line-height: 1;
    color: {{ block.settings.heading_color }};
    margin: 0 0 20px 0;
    text-transform: uppercase;
    letter-spacing: 0.5px;
  }

  .ai-ingredient-cards-divider-{{ ai_gen_id }} {
    width: 60px;
    height: 2px;
    background-color: {{ block.settings.heading_color }};
    margin-top: 20px;
    {% if block.settings.heading_alignment == 'left' %}
      margin-left: 0;
      margin-right: auto;
    {% elsif block.settings.heading_alignment == 'center' %}
      margin-left: auto;
      margin-right: auto;
    {% elsif block.settings.heading_alignment == 'right' %}
      margin-left: auto;
      margin-right: 0;
    {% endif %}
  }

  .ai-ingredient-cards-intro-{{ ai_gen_id }} {
    font-size: 16px;
    line-height: 1.6;
    color: {{ block.settings.text_color }};
    max-width: 700px;
    margin: 0;
    {% if block.settings.heading_alignment == 'left' %}
      margin-left: 0;
      margin-right: auto;
    {% elsif block.settings.heading_alignment == 'center' %}
      margin-left: auto;
      margin-right: auto;
    {% elsif block.settings.heading_alignment == 'right' %}
      margin-left: auto;
      margin-right: 0;
    {% endif %}
  }

  .ai-ingredient-cards-grid-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 30px;
  }

  .ai-ingredient-card-{{ ai_gen_id }} {
    background-color: {{ block.settings.card_bg_color }};
    padding: 40px 30px;
    box-shadow: {{ block.settings.card_shadow }};
    position: relative;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    min-height: 400px;
  }

  .ai-ingredient-card-content-{{ ai_gen_id }} {
    flex-grow: 1;
    display: flex;
    flex-direction: column;
  }

  .ai-ingredient-card-category-{{ ai_gen_id }} {
    font-size: 11px;
    letter-spacing: 2px;
    text-transform: uppercase;
    color: {{ block.settings.category_color }};
    margin-bottom: 16px;
    font-weight: 600;
  }

  .ai-ingredient-card-title-{{ ai_gen_id }} {
    font-size: 24px;
    line-height: 1.2;
    color: {{ block.settings.title_color }};
    margin: 0 0 20px 0;
    text-transform: uppercase;
    letter-spacing: 0.5px;
  }

  .ai-ingredient-card-description-{{ ai_gen_id }} {
    font-size: 15px;
    line-height: 1.6;
    color: {{ block.settings.text_color }};
    margin-bottom: 24px;
    flex-grow: 1;
  }

  .ai-ingredient-card-link-{{ ai_gen_id }} {
    font-size: 13px;
    color: {{ block.settings.link_color }};
    text-decoration: none;
    text-transform: uppercase;
    letter-spacing: 1px;
    font-weight: 600;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 8px 0;
  }

  .ai-ingredient-card-link-{{ ai_gen_id }}:hover {
    opacity: 0.7;
  }

  .ai-ingredient-card-image-{{ ai_gen_id }} {
    position: absolute;
    bottom: 20px;
    right: 20px;
    width: 80px;
    height: 80px;
    opacity: 0.15;
  }

  .ai-ingredient-card-image-{{ ai_gen_id }} img {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .ai-ingredient-card-image-placeholder-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .ai-ingredient-card-image-placeholder-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
    opacity: 0.3;
  }

  .ai-ingredient-carousel-dots-{{ ai_gen_id }} {
    display: none;
  }

  {% if block.settings.color_scheme == 'scheme_1' %}
    .ai-ingredient-cards-{{ ai_gen_id }} {
      background-color: {{ settings.color_scheme_1_bg }};
    }
    .ai-ingredient-cards-heading-{{ ai_gen_id }},
    .ai-ingredient-cards-divider-{{ ai_gen_id }} {
      color: {{ settings.color_scheme_1_text }};
      background-color: {{ settings.color_scheme_1_text }};
    }
    .ai-ingredient-cards-intro-{{ ai_gen_id }} {
      color: {{ settings.color_scheme_1_text }};
    }
  {% elsif block.settings.color_scheme == 'scheme_2' %}
    .ai-ingredient-cards-{{ ai_gen_id }} {
      background-color: {{ settings.color_scheme_2_bg }};
    }
    .ai-ingredient-cards-heading-{{ ai_gen_id }},
    .ai-ingredient-cards-divider-{{ ai_gen_id }} {
      color: {{ settings.color_scheme_2_text }};
      background-color: {{ settings.color_scheme_2_text }};
    }
    .ai-ingredient-cards-intro-{{ ai_gen_id }} {
      color: {{ settings.color_scheme_2_text }};
    }
  {% elsif block.settings.color_scheme == 'scheme_3' %}
    .ai-ingredient-cards-{{ ai_gen_id }} {
      background-color: {{ settings.color_scheme_3_bg }};
    }
    .ai-ingredient-cards-heading-{{ ai_gen_id }},
    .ai-ingredient-cards-divider-{{ ai_gen_id }} {
      color: {{ settings.color_scheme_3_text }};
      background-color: {{ settings.color_scheme_3_text }};
    }
    .ai-ingredient-cards-intro-{{ ai_gen_id }} {
      color: {{ settings.color_scheme_3_text }};
    }
  {% endif %}

  @media screen and (max-width: 989px) {
    .ai-ingredient-cards-heading-{{ ai_gen_id }} {
      font-size: 32px;
    }

    .ai-ingredient-cards-intro-{{ ai_gen_id }} {
      font-size: 15px;
    }

    .ai-ingredient-cards-grid-{{ ai_gen_id }} {
      grid-template-columns: repeat(2, 1fr);
      gap: 20px;
    }

    .ai-ingredient-card-{{ ai_gen_id }} {
      padding: 30px 25px;
      min-height: 350px;
    }
  }

  @media screen and (max-width: 749px) {
    .ai-ingredient-cards-{{ ai_gen_id }} {
      padding: 40px 0;
    }

    .ai-ingredient-cards-container-{{ ai_gen_id }} {
      max-width: 100%;
      margin: 0;
    }

    .ai-ingredient-cards-header-{{ ai_gen_id }} {
      padding: 0 20px;
      margin-bottom: 35px;
    }

    .ai-ingredient-cards-heading-{{ ai_gen_id }} {
      font-size: 28px;
      line-height: 1.2;
      margin-bottom: 16px;
    }

    .ai-ingredient-cards-intro-{{ ai_gen_id }} {
      font-size: 16px;
      line-height: 1.7;
    }

    .ai-ingredient-cards-grid-{{ ai_gen_id }} {
      display: flex;
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      scroll-behavior: smooth;
      gap: 16px;
      padding: 0 20px;
      -webkit-overflow-scrolling: touch;
      scrollbar-width: none;
    }

    .ai-ingredient-cards-grid-{{ ai_gen_id }}::-webkit-scrollbar {
      display: none;
    }

    .ai-ingredient-card-{{ ai_gen_id }} {
      flex: 0 0 87%;
      scroll-snap-align: center;
      padding: 35px 28px;
      min-height: 380px;
    }

    .ai-ingredient-card-category-{{ ai_gen_id }} {
      font-size: 12px;
      letter-spacing: 2.5px;
      margin-bottom: 18px;
    }

    .ai-ingredient-card-title-{{ ai_gen_id }} {
      font-size: 22px;
      line-height: 1.3;
      margin-bottom: 22px;
    }

    .ai-ingredient-card-description-{{ ai_gen_id }} {
      font-size: 16px;
      line-height: 1.7;
      margin-bottom: 28px;
    }

    .ai-ingredient-card-link-{{ ai_gen_id }} {
      font-size: 14px;
      padding: 12px 0;
      min-height: 44px;
    }

    .ai-ingredient-card-image-{{ ai_gen_id }} {
      width: 75px;
      height: 75px;
      bottom: 25px;
      right: 25px;
      opacity: 0.12;
    }

    .ai-ingredient-carousel-dots-{{ ai_gen_id }} {
      display: flex;
      justify-content: center;
      gap: 8px;
      margin-top: 24px;
      padding: 0 20px;
    }

    .ai-ingredient-carousel-dot-{{ ai_gen_id }} {
      width: 8px;
      height: 8px;
      border-radius: 50%;
      background-color: {{ block.settings.text_color }};
      opacity: 0.25;
      transition: opacity 0.3s ease, transform 0.3s ease;
    }

    .ai-ingredient-carousel-dot-{{ ai_gen_id }}.active {
      opacity: 1;
      transform: scale(1.2);
    }
  }
{% endstyle %}

<ingredient-carousel-{{ ai_gen_id }} class="ai-ingredient-cards-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-ingredient-cards-container-{{ ai_gen_id }}">
    {% if block.settings.heading != blank or block.settings.intro != blank %}
      <div class="ai-ingredient-cards-header-{{ ai_gen_id }}">
        {% if block.settings.heading != blank %}
          {% if block.settings.heading_tag == 'h1' %}
            <h1 class="ai-ingredient-cards-heading-{{ ai_gen_id }}">
              {{ block.settings.heading }}
            </h1>
          {% elsif block.settings.heading_tag == 'h2' %}
            <h2 class="ai-ingredient-cards-heading-{{ ai_gen_id }}">
              {{ block.settings.heading }}
            </h2>
          {% elsif block.settings.heading_tag == 'h3' %}
            <h3 class="ai-ingredient-cards-heading-{{ ai_gen_id }}">
              {{ block.settings.heading }}
            </h3>
          {% endif %}

          {% if block.settings.show_divider %}
            <div class="ai-ingredient-cards-divider-{{ ai_gen_id }}"></div>
          {% endif %}
        {% endif %}

        {% if block.settings.intro != blank %}
          <div class="ai-ingredient-cards-intro-{{ ai_gen_id }}">
            {{ block.settings.intro }}
          </div>
        {% endif %}
      </div>
    {% endif %}

    <div class="ai-ingredient-cards-grid-{{ ai_gen_id }}" data-carousel>
      {% for i in (1..3) %}
        {% liquid
          assign category_key = 'card_' | append: i | append: '_category'
          assign title_key = 'card_' | append: i | append: '_title'
          assign description_key = 'card_' | append: i | append: '_description'
          assign link_key = 'card_' | append: i | append: '_link'
          assign link_text_key = 'card_' | append: i | append: '_link_text'
          assign image_key = 'card_' | append: i | append: '_image'

          assign category = block.settings[category_key]
          assign title = block.settings[title_key]
          assign description = block.settings[description_key]
          assign link = block.settings[link_key]
          assign link_text = block.settings[link_text_key]
          assign image = block.settings[image_key]
        %}

        <div class="ai-ingredient-card-{{ ai_gen_id }}" data-card-index="{{ forloop.index0 }}">
          <div class="ai-ingredient-card-content-{{ ai_gen_id }}">
            {% if category != blank %}
              <div class="ai-ingredient-card-category-{{ ai_gen_id }}">
                {{ category }}
              </div>
            {% endif %}

            {% if title != blank %}
              <h3 class="ai-ingredient-card-title-{{ ai_gen_id }}">
                {{ title }}
              </h3>
            {% endif %}

            {% if description != blank %}
              <div class="ai-ingredient-card-description-{{ ai_gen_id }}">
                {{ description }}
              </div>
            {% endif %}

            {% if link != blank and link_text != blank %}
              <a href="{{ link }}" class="ai-ingredient-card-link-{{ ai_gen_id }}">
                {{ link_text }}
                <span>+</span>
              </a>
            {% endif %}
          </div>

          <div class="ai-ingredient-card-image-{{ ai_gen_id }}">
            {% if image %}
              <img
                src="{{ image | image_url: width: 160 }}"
                alt="{{ image.alt | escape }}"
                loading="lazy"
                width="80"
                height="80"
              >
            {% else %}
              <div class="ai-ingredient-card-image-placeholder-{{ ai_gen_id }}">
                {{ 'product-1' | placeholder_svg_tag }}
              </div>
            {% endif %}
          </div>
        </div>
      {% endfor %}
    </div>

    <div class="ai-ingredient-carousel-dots-{{ ai_gen_id }}" data-dots>
      {% for i in (1..3) %}
        <div class="ai-ingredient-carousel-dot-{{ ai_gen_id }} {% if forloop.first %}active{% endif %}" data-dot-index="{{ forloop.index0 }}"></div>
      {% endfor %}
    </div>
  </div>
</ingredient-carousel-{{ ai_gen_id }}>

<script>
  (function() {
    class IngredientCarousel{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
        this.carousel = null;
        this.dots = [];
        this.currentIndex = 0;
      }

      connectedCallback() {
        this.carousel = this.querySelector('[data-carousel]');
        this.dots = Array.from(this.querySelectorAll('[data-dot-index]'));

        if (window.innerWidth <= 749 && this.carousel) {
          this.setupCarousel();
        }

        window.addEventListener('resize', () => {
          if (window.innerWidth <= 749 && this.carousel) {
            this.setupCarousel();
          }
        });
      }

      setupCarousel() {
        if (!this.carousel) return;

        this.carousel.addEventListener('scroll', () => {
          this.updateActiveDot();
        });

        this.updateActiveDot();
      }

      updateActiveDot() {
        if (!this.carousel || this.dots.length === 0) return;

        const scrollLeft = this.carousel.scrollLeft;
        const cardWidth = this.carousel.querySelector('[data-card-index]').offsetWidth;
        const gap = 16;
        const newIndex = Math.round(scrollLeft / (cardWidth + gap));

        if (newIndex !== this.currentIndex) {
          this.currentIndex = newIndex;

          this.dots.forEach((dot, index) => {
            if (index === this.currentIndex) {
              dot.classList.add('active');
            } else {
              dot.classList.remove('active');
            }
          });
        }
      }
    }

    customElements.define('ingredient-carousel-{{ ai_gen_id }}', IngredientCarousel{{ ai_gen_id }});
  })();
</script>

