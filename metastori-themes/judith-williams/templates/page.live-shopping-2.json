        "narrow_column": true,
        "color_scheme": "none",
        "divider": false
      }
    },
    "3a7e9184-9273-418a-ab47-41d413cb952e": {
      "type": "rich-text",
      "disabled": true,
      "blocks": {
        "template--18492886057294__3a7e9184-9273-418a-ab47-41d413cb952e-1680699205ebc800a1-0": {
          "type": "heading",
          "settings": {
            "heading_tag": "h2",
            "title": "LIEBE KUNDINNEN UND KUNDEN",
            "heading_size": "h2"
          }
        },
        "template--18492886057294__3a7e9184-9273-418a-ab47-41d413cb952e-1680699205ebc800a1-1": {
          "type": "text",
          "settings": {
            "enlarge_text": true,
            "text": "<p>Am <strong>12. und 13. Januar 2023</strong> bleibt die Judith Williams Beauty World aufgrund von Dreharbeiten ganztägig geschlossen.</p>"
          }
        }
      },
