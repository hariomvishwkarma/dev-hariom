    "faq_ffPtyV": {
      "type": "faq",
      "blocks": {
        "question_jgK69i": {
          "type": "question",
          "settings": {
            "title": "Was ist der Adventskalender von Judith Williams Cosmetics?",
            "text": "<p>Bei den Judith Williams Cosmetics Adventskalendern  handelt es sich um 24 zauberhaften Kosmetik-Überraschungen aus dem Judith Williams Cosmetics<strong> </strong><a href=\"/collections/gesicht\" target=\"_blank\" title=\"Gesicht\"><strong>Pflege</strong></a>- und<strong> </strong><a href=\"/collections/make-up\" target=\"_blank\" title=\"Make-up\"><strong>Make-up</strong></a><strong> </strong>Sortiment, die die Vorweihnachtszeit besonders schön machen. Enthalten sind unter anderem ausgewählte Lieblinge der beliebten Linien sowie die neuesten Produkte – natürlich alles in <strong>Originalgröße</strong>. Es gibt den Kalender in zwei Varianten: <a href=\"/products/judith-williams-cosmetics-adventskalender-classic-2025\" title=\"Adventskalender 2025 Classic\"><strong>Classic</strong></a><strong> </strong>und <a href=\"/products/judith-williams-cosmetics-adventskalender-premium-2025\" title=\"Adventskalender 2025 Premium\"><strong>Premium</strong></a>. Du kannst dich jeweils zwischen zwei Versionen entscheiden: <strong>mit oder ohne Geschenksäckchen</strong>.</p>"
          }
        },
        "question_wekGBA": {
          "type": "question",
          "settings": {
            "title": "Eignet sich der Adventskalender als Geschenk?",
            "text": "<p>Mit einer liebevoll zusammengestellten Auswahl <strong>hochwertiger Produkte in Originalgröße</strong> ist der Judith Williams Cosmetics Adventskalender das perfekte Geschenk für besondere Menschen.</p>"
          }
        },
        "question_TRMrt6": {
          "type": "question",
          "settings": {
            "title": "Kann der Adventskalender retourniert werden?",
            "text": "<p>Im Gegensatz zu normalen Bestellungen im Judith Williams Onlineshop sind die Adventskalender von der Rücksendung <strong>ausgenommen</strong>. Weitere Informationen zu Versand, Kosten und Retouren findest du unter <a href=\"https://www.judithwilliams.com/policies/shipping-policy\" target=\"_blank\"><span style=\"text-decoration:underline\"><strong>Versand & Lieferung</strong></span></a> und unseren <a href=\"/pages/haufige-fragen\" target=\"_blank\" title=\"Häufige Fragen\"><span style=\"text-decoration:underline\"><strong>FAQs</strong></span></a>.</p>"
          }
        }
      },
