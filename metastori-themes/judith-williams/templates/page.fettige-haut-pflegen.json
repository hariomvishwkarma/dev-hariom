    "rich_text_4cKbdk": {
      "type": "rich-text",
      "blocks": {
        "heading_WYJXzM": {
          "type": "heading",
          "settings": {
            "heading_tag": "h2",
            "title": "Ursachen für fettige Haut",
            "heading_size": "h2"
          }
        },
        "text_XNPimw": {
          "type": "text",
          "settings": {
            "enlarge_text": false,
            "text": "<p><strong>Fettige Haut</strong> ist das Ergebnis einer <strong>übermäßigen Talgproduktion</strong>. Talg erfüllt als Schutzschild unserer Haut eine wichtige Aufgabe: Er schützt die Epidermis, hält sie elastisch und gut durchfeuchtet. Doch ein Übermaß an Talg kann nicht nur zu unangenehmen Glanz führen. Auch die Ansammlung von Schmutz und Bakterien auf der Haut werden begünstigen, die<strong> Poren verstopfen </strong>– und die Wahrscheinlichkeit von <strong>Pickeln </strong>oder <strong>Unreinheiten </strong>steigt.</p>"
          }
        }
      },
      "block_order": [
        "heading_WYJXzM",
        "text_XNPimw"
      ],
