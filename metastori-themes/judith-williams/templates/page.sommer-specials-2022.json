        "template--18869101232462__85feddc3-aae1-4a56-b586-97d36c256113-1682680590b010c15b-1": {
          "type": "text",
          "settings": {
            "enlarge_text": false,
            "text": "<p><a href=\"https://www.judithwilliams.com/collections/nahrungserganzungsmittel\"><span style=\"text-decoration:underline\"><strong>Nahrungsergänzungsmittel</strong></span></a> sind der ideale Zusatz zu einem Sonnenschutz, da sie unsere Haut auf die Sonne vorbereiten und zu einer intensiveren Bräune beitragen.</p>"
