        "template--18869101232462__dfa7f28f-4a36-4caa-9cb5-d41c4bb6789b-1682678798467a7e31-1": {
          "type": "text",
          "settings": {
            "enlarge_text": false,
            "text": "<p>Zwischen 01. Juli und 31. August 2022 erwarten dich verschiedene Summer Sales und Beauty-Specials für die Sonnensaison, die jeweils auf JUDITHWILLIAMS.COM und nur für einen begrenzten Zeitraum gültig sind. Jetzt einfach unseren <a href=\"https://www.judithwilliams.com/pages/newsletter?email=\"><span style=\"text-decoration:underline\"><strong>Newsletter abonnieren</strong></span></a> und auf dem Laufenden bleiben.</p>"
          }
        }
      },
      "block_order": [
