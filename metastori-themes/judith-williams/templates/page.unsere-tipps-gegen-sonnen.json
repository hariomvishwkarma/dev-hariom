    "text_columns_qtVFXA": {
      "type": "text-columns",
      "blocks": {
        "text_block_aKKpgX": {
          "type": "text_block",
          "settings": {
            "enable_image": false,
            "image_mask": "none",
            "image_width": 650,
            "title": "1. Reinigung",
            "text": "<p>Ein sanfter <a href=\"/collections/gesichtsreinigung\" title=\"Gesichtsreinigung\"><strong>Cleanser </strong></a>und ein milder <a href=\"/collections/gesichtswasser\" title=\"Gesichtswasser\"><strong>Toner</strong></a> entfernen Talg und Rückstände, ohne die Hautbarriere zu schwächen – die ideale Basis für aufhellende Wirkstoffe.</p>",
            "button_label": "",
            "button_link": ""
          }
        },
        "text_block_nHdMan": {
          "type": "text_block",
          "settings": {
            "enable_image": false,
            "image_mask": "none",
            "image_width": 650,
            "title": "2. Spezialpflege",
            "text": "<p>Ein <a href=\"https://www.judithwilliams.com/collections/pigmentflecken-mindern?filter.p.m.global.routine_step=Wirkstoffpflege\" title=\"Serum oder Konzentrat um Pigmentflecken zu mindern\"><strong>Serum oder Konzentrat</strong></a> mit einem Hero-Wirkstoff wie Vitamin C oder Retinol  unterstützt einen ebenmäßigeren Teint und hilft Pigmentflecken zu mindern. </p>",
            "button_label": "",
            "button_link": ""
          }
        },
        "text_block_YmYjew": {
          "type": "text_block",
          "settings": {
            "enable_image": false,
            "image_mask": "none",
            "image_width": 650,
            "title": "3. Augenpflege",
            "text": "<p>Eine <a href=\"/collections/augenpflege\" title=\"Augenpflege\"><strong>Augenpflege </strong></a>spendet Feuchtigkeit und schützt die empfindliche Augenpartie – auch hier kann es durch UV-Strahlung zu Verfärbungen kommen.</p>",
            "button_label": "",
            "button_link": ""
          }
        },
        "text_block_j9Nxnm": {
          "type": "text_block",
          "settings": {
            "enable_image": false,
            "image_mask": "none",
            "image_width": 650,
            "title": "4. Gesichtscreme",
            "text": "<p>Eine <a href=\"https://www.judithwilliams.com/collections/hautbild-ausgleichen?filter.p.m.global.routine_step=Gesichtscreme\" title=\"Gesichtscremen um das Hautbild auszugleichen\"><strong>feuchtigkeitsspendende Gesichtscreme</strong></a> unterstützt die Regeneration, wichtig, um lichtbedingte Hautschäden besser auszugleichen.</p>",
            "button_label": "",
            "button_link": ""
          }
        },
        "text_block_9MxBF6": {
          "type": "text_block",
          "settings": {
            "enable_image": false,
            "image_mask": "none",
            "image_width": 650,
            "title": "5. Sonnenschutz",
            "text": "<p><a href=\"https://www.judithwilliams.com/collections/lsf?filter.p.m.global.lsf=SPF+30&filter.p.m.global.lsf=SPF+50\" title=\"Produkte mit LSF 30 und 50\"><strong>Mindestens LSF 30, im Sommer LSF 50</strong></a><br/>⚠️<strong>Der wichtigste Schritt:</strong> Schützt vor neuen UV-Schäden und verhindert, dass Pigmentflecken dunkler werden. Großzügig auf Gesicht, Hals und Dekolleté auftragen.</p>",
            "button_label": "",
            "button_link": ""
          }
        }
      },
