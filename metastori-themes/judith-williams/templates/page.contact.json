        "liquid_CP34G7": {
          "type": "liquid",
          "settings": {
            "code": "<script>\n(function(){\n  function onMessagingReady(cb, tries = 60) { // wartet max. 15 Sekunden\n    if (window.embeddedservice_bootstrap &&\n        embeddedservice_bootstrap.utilAPI &&\n        typeof embeddedservice_bootstrap.utilAPI.launchChat === 'function') {\n      cb();\n    } else if (tries > 0) {\n      setTimeout(function(){ onMessagingReady(cb, tries - 1); }, 250);\n    } else {\n      console.warn('Salesforce Messaging API nicht verfügbar (Timeout).');\n    }\n  }\n\n  // Klick-Event-Listener für Buttons mit Label \"Chat öffnen\"\n  document.addEventListener('click', function(e){\n    const el = e.target.closest('button, a');\n    if (!el) return;\n\n    // Text prüfen (inkl. trim, damit keine Leerzeichen stören)\n    if (el.textContent.trim().toLowerCase() === 'chat öffnen') {\n      e.preventDefault();\n      onMessagingReady(function(){\n        embeddedservice_bootstrap.utilAPI.launchChat()\n          .then(() => console.log('Chat geöffnet'))\n          .catch(err => console.error('Chat konnte nicht geöffnet werden', err));\n      });\n    }\n  });\n})();\n</script>",
            "width": "50%",
            "alignment": "center"
          }
        }
      },
