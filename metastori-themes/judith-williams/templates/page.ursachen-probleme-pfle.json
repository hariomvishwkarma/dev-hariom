        "template--18492886057294__b311ef25-8273-43e3-b1bf-3f28d4388dbf-1680699205ebc800a1-1": {
          "type": "text",
          "settings": {
            "enlarge_text": false,
            "text": "<p><strong>Sensible Haut</strong> betrifft viele Menschen – unabhängig vom eigentlichen Hauttyp. Ob fettig, trocken oder reif: Eine empfindliche Haut reagiert oft übermäßig auf äußere Einflüsse und zeigt sich mit Rötungen, Irritationen oder Spannungsgefühlen. Erfahre hier, wie du die Anzeichen erkennst und mit der richtigen Pflege deine Hautbarriere stärkst.</p>"
          }
        }
      },
