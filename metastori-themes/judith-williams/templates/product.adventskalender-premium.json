    "faq_TA8VGe": {
      "type": "faq",
      "blocks": {
        "question_a9ptct": {
          "type": "question",
          "settings": {
            "title": "Was ist der Adventskalender von Judith Williams Cosmetics?",
            "text": "<p>Bei den Judith Williams Cosmetics Adventskalendern  handelt es sich um 24 zauberhaften Kosmetik-Überraschungen aus dem Judith Williams Cosmetics <a href=\"/collections/gesicht\" target=\"_blank\" title=\"Gesicht\">Pflege</a>- und <a href=\"/collections/make-up\" target=\"_blank\" title=\"Make-up\">Make-up</a> Sortiment, die die Vorweihnachtszeit besonders schön machen. Enthalten sind unter anderem ausgewählte Lieblinge der beliebten Linien sowie die neuesten Produkten – natürlich alles in Originalgröße. Es gibt den Kalender in zwei Varianten: <a href=\"/products/judith-williams-cosmetics-adventskalender-classic-2025\" title=\"Adventskalender 2025 Classic\">Classic</a> und <a href=\"/products/judith-williams-cosmetics-adventskalender-premium-2025\" title=\"Adventskalender 2025 Premium\">Premium</a>. Du kannst dich jeweils zwischen zwei Versionen entscheiden: mit oder ohne Geschenksäckchen.<br/></p>"
          }
        },
        "question_JwtxKW": {
          "type": "question",
          "settings": {
            "title": "Ist die Produktauswahl vom letzten Jahr gleich geblieben?",
            "text": "<p>Nein, alle Judith Williams Cosmetics Adventskalender wurden für die <strong>2025 Edition </strong>neu zusammengestellt. Dabei kannst du dich auf <strong>Bestseller </strong>sowie die letzten <strong>Beauty-Neuheiten</strong> freuen! ✨</p>"
          }
        },
        "question_LGp8B6": {
          "type": "question",
          "settings": {
            "title": "Eignet sich der Adventskalender als Geschenk?",
            "text": "<p>Bei den Judith Williams Cosmetics Adventskalender sind eine sorgfältig zusammengestellte Auswahl an <strong>hochwertiger Produkte in Originalgröße</strong> und eignen sich hervorragend als Geschenk 🎁</p>"
          }
        },
        "question_VW8GHx": {
          "type": "question",
          "settings": {
            "title": "Wie lässt sich der Adventskalender stilvoll in Szene setzen?",
