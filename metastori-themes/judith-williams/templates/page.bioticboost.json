    "fa54a0e3-bb09-4886-8ef9-d737692bd427": {
      "type": "text-and-image",
      "settings": {
        "image": "shopify://shop_images/Bioticboost_13.webp",
        "image_mask": "none",
        "image2_mask": "none",
        "subtitle": "",
        "title": "WAS IST FERMENTATION?",
        "heading_size": "h2",
        "text": "<p><strong>Fermentation </strong>ist ein kraftvolles biotechnologisches Verfahren und steht für die Umwandlung eines Rohstoffs in einen Aktivstoff durch die Zugabe von unterstützenden Bakterienkulturen. Durch die Umwandlung in den Aktivstoff (Fermented Power Biotics) werden wertvolle Nährstoffe und die biotische Kraft des Rohstoffs freigesetzt. Das Ergebnis dieses natürlichen Boosters: Bessere, stärker konzentrierte und aktivere Wirkstoffe! Nicht ohne Grund sind <strong>fermentierte Pflegeprodukte </strong>deshalb DER ultimative <strong>Beauty Trend aus Korea.</strong></p>",
        "small_text": "",
        "button_label": "",
        "button_link": "",
