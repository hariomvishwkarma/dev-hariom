        "b7f721cc-1500-407a-ad6e-ba017e77508c": {
          "type": "testimonial",
          "settings": {
            "icon": "5-stars",
            "testimonial": "<p><strong>Tolle Größe für die Reise. </strong>Zieht super schnell ein und meine Haut liebt das Serum. In Verbindung mit der Creme wunderbar. Werde ich auch erneut kaufen.</p>",
            "image": "shopify://shop_images/Cosmetics_Rose_Serum_rendering_0b66a76a-b014-436a-9bed-8416a38ff4ab.png",
            "author": "Ute B.",
            "author_info": "Serum Konzentrat Rose"
