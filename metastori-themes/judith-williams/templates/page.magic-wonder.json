    "cf35985b-a080-4f24-8ae3-50fcfec77b23": {
      "type": "testimonials",
      "blocks": {
        "testimonial_yny7hB": {
          "type": "testimonial",
          "settings": {
            "icon": "5-stars",
            "testimonial": "<p><strong>Als Primer super!<br/></strong>Hätte nicht gedacht, dass man so schnell einen Unterschied sieht. Die Haut wirkt echt glatter und irgendwie frischer – und als Primer: super.</p>",
            "image": "shopify://shop_images/fdee17f3ac7942f485ac50134f2db750_885a13fb-e70d-4810-9c7f-8daac863c661.png",
