        "text_P4FKWn": {
          "type": "text",
          "settings": {
            "enlarge_text": false,
            "text": "<ul><li><strong>Genetik</strong>: Bestimmter Hauttyp, der von Natur aus weniger Talg produziert</li><li><strong>Alter</strong>: Talgproduktion nimmt mit den Jahren ab</li><li><strong>Hormonelle Veränderungen: </strong>Hormonelle Schwankungen, z.B. Menopause </li><li><strong>Ernährung</strong>: Unzureichende Aufnahme von Fetten und Nährstoffen</li><li><strong>Medikamente</strong>: Bestimmte Medikamente können Talgproduktion einschränken</li></ul>"
          }
