    "text_columns_XHz93r": {
      "type": "text-columns",
      "blocks": {
        "text_block_knrfYK": {
          "type": "text_block",
          "settings": {
            "enable_image": false,
            "image_mask": "none",
            "image_width": 650,
            "title": "trockene haut",
            "text": "<ul><li><strong>Trockene Haut = </strong>Hauttyp</li><li><strong>Dauer: </strong>Dauerhaft</li><li><strong>Grund:</strong> Trockene Haut produziert zu wenig Talg (Öl) in den tieferen Hautschichten.</li><li><strong>Ergebnis</strong>: Haut fühlt sich rau, schuppig und spannungsvoll an.</li><li><strong>Gut zu wissen</strong>: Trockene Haut kann trotz geringer Talgproduktion einen normalen Feuchtigkeitsgehalt haben. Sie ist <em>trocken</em>, aber nicht dehydriert.</li></ul>",
            "button_label": "",
            "button_link": ""
          }
        },
        "text_block_ePAFRK": {
          "type": "text_block",
          "settings": {
            "enable_image": false,
            "image_mask": "none",
            "image_width": 650,
            "title": "Dehydrierte Haut",
            "text": "<ul><li><strong>Dehydrierte Haut = </strong>Hautzustand</li><li><strong>Dauer</strong>: Vorübergehend</li><li><strong>Grund: </strong>Haut hat einen Mangel an Wasser durch äußere Faktoren wie z.B. Hitze, Kälte oder Schlafmangel.</li><li><strong>Ergebnis</strong>: Haut fühlt sich trocken, gespannt und manchmal empfindlich an.</li><li><strong>Gut zu wissen</strong>: Jeder Hauttyp kann dehydriert sein, sogar fettige Haut, die zu viel Talg produziert, um den Feuchtigkeitsmangel auszugleichen.</li></ul><p></p>",
            "button_label": "",
            "button_link": ""
          }
        }
      },
