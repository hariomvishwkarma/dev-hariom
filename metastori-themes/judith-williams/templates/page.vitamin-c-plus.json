      "blocks": {
        "template--19197950198094__8f1057a9-aa2a-40fb-be6d-24f18e43db8c-168817453511930cd7-0": {
          "type": "text_block",
          "settings": {
            "enable_image": false,
            "image_mask": "none",
            "image_width": 650,
            "title": "VITAMIN C & RETINOL",
            "text": "<p><strong>Vitamin C </strong>und <a href=\"/collections/retinol-science\" title=\"Retinol Science\"><span style=\"text-decoration:underline\"><strong>Retinol</strong></span></a> sind beide besonders effektiv bei:<br/><br/><strong>✓ </strong>Sonnenschäden, feinen Linien und Pickelmalen<br/><strong>✓ </strong>einem unregelmäßigen Hautton<br/><strong>✓ </strong>Hyperpigmentierung<br/><strong>Pflege-Tipp:</strong> Retinol immer mit Sonnenschutz kombinieren.</p>",
            "button_label": "PRODUKTE MIT RETINOL",
            "button_link": "shopify://collections/retinol"
          }
        },
        "template--19197950198094__8f1057a9-aa2a-40fb-be6d-24f18e43db8c-168817453511930cd7-1": {
          "type": "text_block",
          "settings": {
            "enable_image": false,
            "image_mask": "none",
            "image_width": 650,
            "title": "VITAMIN C & NIACINAMID",
            "text": "<p>Gemeinsam können <strong>Vitamin C </strong>und <a href=\"/collections/niacinamid\" title=\"Niacinamid\"><span style=\"text-decoration:underline\"><strong>Niacinamid </strong></span></a>helfen:<br/><br/><strong>✓ </strong>die Haut vor Schäden zu schützen<br/><strong>✓ </strong>feine Linien und Falten zu reduzieren<br/><strong>✓ </strong>den Teint auszugleichen</p>",
            "button_label": "PRODUKTE MIT NIACINAMID",
            "button_link": "shopify://collections/niacinamid"
          }
        },
        "template--19197950198094__8f1057a9-aa2a-40fb-be6d-24f18e43db8c-168817453511930cd7-2": {
          "type": "text_block",
          "settings": {
            "enable_image": false,
            "image_mask": "none",
            "image_width": 650,
            "title": "VITAMIN C & PEPTIDE",
            "text": "<p>Die Wirkstoff-Kombination aus <strong>Vitamin C </strong>und <a href=\"/collections/peptide-science\" title=\"Peptide Science\"><span style=\"text-decoration:underline\"><strong>Peptiden</strong></span></a>:<br/><br/><strong>✓ </strong>hat eine zellschützende Wirkung<br/><strong>✓ </strong>kann vorhandene Hautschäden reparieren<br/><strong>✓ </strong>kann Elastizität und Straffheit verbessern</p>",
            "button_label": "PRODUKTE MIT PEPTIDEN",
            "button_link": "shopify://collections/peptide"
          }
        },
        "text_block_NBk4Hw": {
          "type": "text_block",
          "settings": {
            "enable_image": false,
            "image_mask": "none",
            "image_width": 650,
            "title": "vitamin c & Hyaluron",
            "text": "<p><strong>Vitamin C </strong>und <a href=\"/collections/hyaluron-aktiv\" title=\"Hyaluron Aktiv\"><strong>Hyaluron</strong></a> sind das Dream-Team für:<br/><br/><strong>✓ </strong>einen frischen, strahlenden Glow<br/><strong>✓ </strong>intensive Feuchtigkeit und antioxidativen Schutz<br/><strong>✓ </strong>ein glattes und ebenmäßiges Hautbild</p>",
