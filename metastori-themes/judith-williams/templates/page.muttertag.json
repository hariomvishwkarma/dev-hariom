        },
        "239a579e-b1f1-4d69-8b46-f3744c579124": {
          "type": "text",
          "settings": {
            "enlarge_text": false,
            "text": "<p>Auf <a href=\"/collections/alle-kategorien\" title=\"Alle Kategorien\"><span style=\"text-decoration:underline\"><strong>JUDITHWILLIAMS.COM</strong></span></a> findet ihr zahlreiche Inspirationen für <strong>Muttertagsgeschenke</strong>. Also zeigt euren Heldinnen in diesem Jahr eure Liebe und Dankbarkeit mit einer Aufmerksamkeit aus unserer Muttertags-Welt.  Ihr seid auf der Suche nach einem Last-Minute-<strong>Muttertagsgeschenk?</strong> Dann ist ein <a href=\"/collections/gutscheine\" title=\"Gutscheine\"><span style=\"text-decoration:underline\"><strong>Gutschein</strong></span></a> die perfekte Lösung. Denn mit dem Wertgutschein für den Judith Williams Onlineshop verschenkt ihr Freude pur und euer Herzensmensch kann sich aussuchen, was sein Beauty-Herz begehrt. Bestellt eure Favoriten jetzt bei <a href=\"/collections\" title=\"Alle Kollektionen\"><span style=\"text-decoration:underline\"><strong>Judith Williams Cosmetics</strong></span></a> und sagt von Herzen: Danke Mama!💖</p>"
          }
        }
      },
