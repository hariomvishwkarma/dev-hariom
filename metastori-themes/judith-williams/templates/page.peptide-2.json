        },
        "text_block_bwtCPA": {
          "type": "text_block",
          "settings": {
            "enable_image": false,
            "image_mask": "none",
            "image_width": 650,
            "title": "2.  Glättung & Faltenreduktion",
            "text": "<p>Die Linie wirkt gezielt gegen <strong>alle Arten von Ausdrucks- und Mimikfalten</strong>. Bestehende Fältchen werden optisch gemildert, während die Entstehung neuer Linien reduziert wird.</p><p></p>",
            "button_label": "",
            "button_link": ""
          }
        },
        "text_block_kJDY6J": {
          "type": "text_block",
          "settings": {
            "enable_image": false,
            "image_mask": "none",
            "image_width": 650,
            "title": "3. Straffung & Regeneration",
            "text": "<p>Durch die <strong>Stimulierung der körpereigenen Kollagen- und Elastinproduktion</strong> wird die Hautstruktur langfristig gestärkt. Das Ergebnis ist eine festere, glattere und regenerierte Haut.</p>",
            "button_label": "",
            "button_link": ""
          }
        },
        "text_block_EDEgpf": {
          "type": "text_block",
          "settings": {
            "enable_image": false,
