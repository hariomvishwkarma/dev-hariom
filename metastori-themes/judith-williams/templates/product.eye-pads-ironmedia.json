          "settings": {
            "code": "<style>\n/* >>> Nur für diese Section <<< */\n.jw-video-section {\n  margin: 0;\n  padding: 0;\n  background: #fff;\n}\n\n/* Allgemeines Layout */\n.jw-video-section .tile {\n  position: relative;\n  background: #fff;\n  padding: 10px; /* Weißer Rand um jedes Video */\n  box-sizing: border-box;\n}\n\n/* Lautsprecher-Button */\n.jw-video-section .sound-toggle {\n  position: absolute;\n  z-index: 10;\n  bottom: 30px;\n  right: 30px;\n  background: rgba(0,0,0,0.6);\n  color: #fff;\n  border: none;\n  width: 42px;\n  height: 42px;\n  border-radius: 50%;\n  font-size: 18px;\n  cursor: pointer;\n  display: flex;\n  justify-content: center;\n  align-items: center;\n  transition: background .3s ease;\n}\n.jw-video-section .sound-toggle:hover {\n  background: rgba(0,0,0,0.8);\n}\n\n/* Video selbst */\n.jw-video-section video {\n  width: 100%;\n  height: 100%;\n  object-fit: cover;\n  display: block;\n  border-radius: 4px;\n}\n\n/* ---------- Mobil ---------- */\n@media (max-width: 767px) {\n  .jw-video-section .mobile-only { display: block; }\n  .jw-video-section .desktop-only { display: none; }\n\n  .jw-video-section .ratio-box {\n    position: relative;\n    width: 100%;\n    aspect-ratio: 1 / 1;\n    overflow: hidden;\n  }\n\n  .jw-video-section .ratio-box > video {\n    position: absolute;\n    inset: 0;\n    width: 100%;\n    height: 100%;\n    object-fit: cover;\n  }\n}\n\n/* ---------- Desktop ---------- */\n@media (min-width: 768px) {\n  .jw-video-section .mobile-only { display: none; }\n  .jw-video-section .desktop-only { display: grid; }\n\n  .jw-video-section .grid {\n    display: grid;\n    grid-template-columns: 1fr 1fr;\n    gap: 0;\n    justify-content: center;\n    width: 100%;\n    max-width: 1600px; /* Optional: begrenzt Gesamtbreite */\n    margin: 0 auto;\n    background: #fff;\n  }\n\n  .jw-video-section .tile {\n    width: 100%;\n    height: 35vw; /* <---- Video-Höhe: kleiner machen (z. B. 30–40 vw) */\n    overflow: hidden;\n  }\n\n  .jw-video-section .sound-toggle { display: flex; }\n}\n</style>\n\n<div class=\"jw-video-section\">\n  <!-- MOBIL -->\n  <div class=\"mobile-only\">\n    <div class=\"tile\">\n      <div class=\"ratio-box\">\n        <video id=\"vid-mobile\" autoplay muted loop playsinline>\n          <source src=\"https://cdn.shopify.com/videos/c/o/v/faec772423f240848b3c123b585f3913.mp4\" type=\"video/mp4\">\n        </video>\n      </div>\n      <button class=\"sound-toggle\" id=\"btn-mobile\">🔇</button>\n    </div>\n  </div>\n\n  <!-- DESKTOP -->\n  <div class=\"desktop-only\">\n    <div class=\"grid\">\n      <div class=\"tile\">\n        <video id=\"vid1\" autoplay muted loop playsinline>\n          <source src=\"https://cdn.shopify.com/videos/c/o/v/faec772423f240848b3c123b585f3913.mp4\" type=\"video/mp4\">\n        </video>\n        <button class=\"sound-toggle\" id=\"btn1\">🔇</button>\n      </div>\n\n      <div class=\"tile\">\n        <video id=\"vid2\" autoplay muted loop playsinline>\n          <source src=\"https://cdn.shopify.com/videos/c/o/v/fbad845dca9d46908f1aed58133c19b1.mp4\" type=\"video/mp4\">\n        </video>\n        <button class=\"sound-toggle\" id=\"btn2\">🔇</button>\n      </div>\n    </div>\n  </div>\n</div>\n\n<script>\nfunction attachSoundToggle(btnId, videoId){\n  const btn=document.getElementById(btnId);\n  const vid=document.getElementById(videoId);\n  if(!btn||!vid) return;\n  btn.addEventListener('click',()=>{\n    vid.muted=!vid.muted;\n    btn.textContent=vid.muted?'🔇':'🔊';\n    vid.play().catch(()=>{});\n  });\n}\n\nattachSoundToggle('btn-mobile','vid-mobile');\n\nconst mql=window.matchMedia('(min-width:768px)');\nfunction setupDesktopPlayback(e){\n  const isDesktop=e.matches;\n  const v1=document.getElementById('vid1');\n  const v2=document.getElementById('vid2');\n  if(isDesktop&&v1&&v2){\n    try{v1.play();}catch(e){}\n    try{v2.play();}catch(e){}\n    attachSoundToggle('btn1','vid1');\n    attachSoundToggle('btn2','vid2');\n  }\n}\nsetupDesktopPlayback(mql);\nmql.addEventListener ? mql.addEventListener('change',setupDesktopPlayback)\n                     : mql.addListener(setupDesktopPlayback);\n</script>",
