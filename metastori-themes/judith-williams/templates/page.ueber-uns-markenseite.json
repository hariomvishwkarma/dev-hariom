        "text_block_tj8h8P": {
          "type": "text_block",
          "settings": {
            "enable_image": true,
            "image": "shopify://shop_images/Gesicht_erdbeersorbet.png",
            "image_mask": "none",
            "image_width": 60,
            "title": "Professionelle Behandlung",
            "text": "<p>In unserer Beauty World in Innsbruck kannst du professionelle Behandlungen buchen und die Welt von Judith Williams Cosmetics hautnah erleben. Entdecke ein ganz neues Level der Hautpflege und lass dich verwöhnen.<br/></p>",
