        "bb5e8911-dbd3-48b8-bcd7-baba5d9166f0": {
          "type": "question",
          "settings": {
            "title": "Wo finde ich die Kontaktdaten, die Öffnungszeiten und die Adresse der Beauty World Innsbruck?",
            "text": "<p>Die aktuellen Öffnungszeiten, die Adresse und alle wichtigen Informationen findest du auf <a href=\"https://www.judithwilliams.com/pages/beauty-world\" title=\"https://www.judithwilliams.com/pages/beauty-world\">Beauty World Innsbruck</a>.</p>"
          }
        },
        "65ce544c-d9db-4ef4-9fda-3f39d963867e": {
          "type": "question",
          "settings": {
            "title": "Ich wohne nicht in der Nähe von Innsbruck und möchte mich dennoch von den Beauty Expertinnen beraten lassen.",
            "text": "<p>Auch wenn du nicht in der Nähe von Innsbruck wohnst hast du die Möglichkeit dich von unseren Beauty Expertinnen bei einer <a href=\"https://www.judithwilliams.com/pages/online-kosmetikberatung\" title=\"https://www.judithwilliams.com/pages/online-kosmetikberatung\">Online Kosmetikberatung</a> passend zu deinen Hautbedürfnissen beraten zu lassen.</p>"
          }
        },
