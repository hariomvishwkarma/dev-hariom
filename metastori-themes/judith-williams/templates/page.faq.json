        "ecd43f36-3817-4511-acd0-04baead01657": {
          "type": "question",
          "settings": {
            "title": "An wen kann ich mich bei Presse und Event Anfragen melden?",
            "text": "<p>Bitte sende Presseanfragen an <a href=\"mailto:presse@judithwilliams.com\">presse@judithwilliams.com</a></p>"
          }
        },
        "f3ac93c4-5c6a-4129-afb7-9588f73bbf2c": {
          "type": "question",
          "settings": {
            "title": "An wen kann ich Autogramm und Fanpost Anfragen senden?",
            "text": "<p>Bitte sende Fanpost und Autogramm Anfragen inklusive eines leeren frankierten Rücksendeumschlages an <a href=\"mailto:office@judithwilliams.com\">office@judithwilliams.com</a> oder </p><p>Design Offices München Campus Königsplatz, </p><p>c/o Judith Stecher-Williams </p><p>Brienner Str. 45a-d 80333 München</p>"
          }
        },
        "61ba4f23-5cd9-46f5-9e76-3f8956d96682": {
          "type": "question",
          "settings": {
            "title": "Wie kann ich eine Key Note Speech anfragen?",
            "text": "<p>Bitte habe Verständnis, dass Judith Williams nur sehr begrenzte Zeit für ausgewählte Keynotes hat. Alle Keynotes sind gebührenpflichtig. Bitte sende deine Anfrage an <a href=\"mailto:office@judithwilliams.com\">office@judithwilliams.com</a></p>"
          }
        },
        "30bed094-1e0e-4534-946f-2061d295be0b": {
          "type": "question",
          "settings": {
            "title": "Wie kann ich mich für ein Investment bewerben?",
            "text": "<p>Wenn du deine Idee, dein Produkt oder dein Startup vorstellen möchtest, melde dich bei <a href=\"mailto:office@startnow-constulting.de\" title=\"mailto:office@startnow-constulting.de\">office@startnow-consulting.de</a></p>"
          }
        },
        "bea47b57-e26c-4bd9-b8e5-fd9516b90ac6": {
          "type": "question",
          "settings": {
            "title": "Wann ist Judith Williams wieder bei HSE24 auf Sendung?",
            "text": "<p>Alle Details über bevorstehende Shows, Termine und Events mit Judith Williams sind <a href=\"/pages/termine\" title=\"Termine\">hier</a> aktuell zusammengestellt.</p>"
          }
        },
