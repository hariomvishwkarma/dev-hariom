    "text_columns_JbLDng": {
      "type": "text-columns",
      "blocks": {
        "text_block_Uqq4t3": {
          "type": "text_block",
          "settings": {
            "enable_image": false,
            "image_mask": "none",
            "image_width": 650,
            "title": "Non-Stop-Feuchtigkeit",
            "text": "<p><strong>Konzentrierte Hyaluronsäure</strong> wirkt als <strong>Power-Durstlöscher</strong> und versorgt die Haut intensiv mit Feuchtigkeit. Sie sorgt dafür, dass deine Haut rund um die Uhr mit Feuchtigkeit versorgt bleibt, um Trockenheit und Spannungsgefühle zu vermeiden.</p>",
            "button_label": "",
            "button_link": ""
          }
        },
        "text_block_tFFYKG": {
          "type": "text_block",
          "settings": {
            "enable_image": false,
            "image_mask": "none",
            "image_width": 650,
            "title": "Aufpolsternde Wirkung",
            "text": "<p>Die Haut wird von innen heraus <strong>aufgepolstert</strong>, feine Linien und erste Fältchen werden sichtbar geglättet. Feuchtigkeitsdepots werden wieder aufgefüllt, sodass deine Haut sichtbar <strong>praller </strong>und <strong>glatter </strong>aussieht.</p>",
            "button_label": "",
            "button_link": ""
          }
        },
        "text_block_qCXfeh": {
          "type": "text_block",
          "settings": {
            "enable_image": false,
            "image_mask": "none",
            "image_width": 650,
            "title": "Erfrischende Texturen",
            "text": "<p>Die<strong> leichte, schnell einziehende Formel </strong>sorgt für ein erfrischendes Hautgefühl, das sofort einzieht und <strong>nicht fettet</strong> oder klebt. Dank der leichten Textur bleibt deine Haut den ganzen Tag über erfrischt, ohne die Haut zu beschweren.</p>",
            "button_label": "",
            "button_link": ""
          }
        },
        "text_block_mppipg": {
          "type": "text_block",
          "settings": {
            "enable_image": false,
            "image_mask": "none",
            "image_width": 650,
            "title": "Perfekte Pflege für jeden Tag",
            "text": "<p> Diese Feuchtigkeitspflege ist ideal für<strong> alle Hauttypen</strong> und lässt sich problemlos in deine<strong> tägliche Pflegeroutine</strong> integrieren. Besonders geeignet, wenn deine Haut trocken ist und nach intensiver Feuchtigkeit verlangt.</p>",
            "button_label": "",
            "button_link": ""
          }
        }
      },
