      "type": "quotes",
      "blocks": {
        "quote_RTgHyh": {
          "type": "quote",
          "settings": {
            "text": "<p>\"Fermentation ist ein natürlicher Booster, der Inhaltsstoffe verbessert und leistungsfähiger macht und gleichzeitig unser Hautmikrobiom in Balance hält. So werden fermentierte Produkte zum Geheimnis für einen natürlich schönen Glow.\"</p>",
            "author": "<p><strong>Judith Williams<br/></strong>Founder & Beauty-Expert</p>",
            "image": "shopify://shop_images/Judith_Williams_0403fd9d-830c-44db-8fe4-589338aed48e.jpg",
