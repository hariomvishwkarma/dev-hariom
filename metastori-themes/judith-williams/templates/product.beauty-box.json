    "faq_CezTnk": {
      "type": "faq",
      "blocks": {
        "question_RQHkTa": {
          "type": "question",
          "settings": {
            "title": "Was ist die Beauty Box von Judith Williams Cosmetics?",
            "text": "<p>Bei der <strong>Beauty Box</strong> handelt es sich um ein limitiertes Sonderangebot, das exklusiv auf <a href=\"https://www.judithwilliams.com/\" title=\"Onlineshop\"><strong>JUDITHWILLIAMS.COM </strong></a>erhältlich ist. In dieser Box findest du 7 Beauty-Bestseller aus den Kategorien Skincare und Make-up in Originalgröße sowie eine zusätzliche Überraschung, die deine Pflegeroutine wunderbar ergänzt.</p>"
          }
        },
        "question_8wP9qK": {
          "type": "question",
          "settings": {
            "title": "Kann ich die Produkte einzeln kaufen?",
            "text": "<p>Deine Beauty-Favoriten aus der Beauty Box kannst du hier in unserem <a href=\"https://www.judithwilliams.com/collections/gesicht\" title=\"https://www.judithwilliams.com/collections/gesicht\"><strong>Onlineshop</strong></a> easy nachshoppen.</p>"
          }
        },
        "question_NMir96": {
          "type": "question",
          "settings": {
            "title": "Wird meine Box als Geschenk verpackt?",
            "text": "<p>Bei der Beauty Box handelt es sich um eine besonders liebevoll gestaltete und hochwertige Geschenkbox, die sich hervorragend zum Verschenken oder zur Aufbewahrung von kleinen Lieblingsstücken handelt.</p>"
          }
        },
        "question_6Dxein": {
          "type": "question",
          "settings": {
            "title": "Wann wird die Beauty Box geliefert?",
            "text": "<p> <br/>Die <strong>Lieferung</strong> erfolgt im Normalfall zwischen <strong>3 und 5 Werktagen</strong>. Weitere Informationen zu den Themen Versand, Kosten und Retouren findest du unter <a href=\"https://www.judithwilliams.com/policies/shipping-policy\"><span style=\"text-decoration:underline\"><strong>Versand & Lieferung</strong></span></a> und unseren <a href=\"https://www.judithwilliams.com/pages/haufige-fragen\"><span style=\"text-decoration:underline\"><strong>FAQs</strong></span></a>.</p>"
          }
        },
        "question_C76hTi": {
          "type": "question",
          "settings": {
            "title": "In welcher Reihenfolge trage ich die Produkte der \"All time Favorites\" Beauty Box auf?",
            "text": "<p>Du kannst jedes Produkt in deine aktuelle Pflegeroutine integireren. Falls du die Produkte der Box als Routine verwenden möchtest, empfehlen wir dir folgende Schritte:</p><p><strong>1. Hydrogel Eye Pads oder Hyaluron Aktiv Tuchmaske</strong> – erfrischen & spenden wertvolle Feuchtigkeit<br/><strong>2. Eye Lid Lift</strong> – sorgt für einen offenen Blick & glättet Fältchen<br/><strong>3. 24h Aufbaucreme</strong> – verwöhnt mit wertvollen Nährstoffen<br/><strong>5. Soft Coverage Cream</strong> – zart deckende Creme mit LSF 15 verschmilzt mit der Haut<br/><strong>6. One for All Stick</strong> – zaubert einen sommerlichen Hauch Schimmer auf Augen, Lippen & Wangen<br/><strong>7. Judith's Boost Lipstick </strong>– im frischen Koralle-Ton & edlem Satin-Finish</p>"
          }
        }
      },
