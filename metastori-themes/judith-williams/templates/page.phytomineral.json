      "blocks": {
        "e0a02300-83dd-4160-a7a1-ab374a22d1d9": {
          "type": "question",
          "settings": {
            "title": "Für wen ist Phytomineral geeignet?",
            "text": "<p><a href=\"/collections/phytomineral\" title=\"Phytomineral\"><strong>Phytomineral</strong></a> ist eine Linie ab 25+ für die ganze Familie, für jeden Hauttyp in jedem Alter, selbstverständlich auch für Männer und alle, die auf der Suche nach einem liebevollen Tausendsassa in ihrer Pflegeroutine sind. So fühlt sich nachhause kommen an!</p>"
          }
        },
        "9a02b622-c7dc-4e8d-a887-661b46ba2567": {
          "type": "question",
          "settings": {
            "title": "Wo kann ich die Produkte von Phytomineral kaufen?",
            "text": "<p>Du findest die Lieblinge der Phytomineral-Hautpflegelinie aktuell:</p><ul><li>Im Judith Williams Cosmetics <a href=\"/collections/phytomineral\" title=\"Phytomineral\"><strong>Onlineshop</strong></a></li><li>Im <a href=\"https://www.hse.de/dpl/m/brand/judith-williams/kosmetik?line=Judith+Williams+Phytomineral\" target=\"_blank\" title=\"Phytomineral Linie bei HSE online kaufen.\"><strong>HSE</strong></a> Onlineshop</li></ul>"
          }
        },
        "template--19263606784334__a85f472e-5dc6-4b89-8a3e-37d6d1e186fa-question-1": {
          "type": "question",
          "settings": {
            "title": "Was ist das Besondere an dieser Pflegelinie?",
            "text": "<p>Sie ist der Pflegeallrounder und die ideale Einsteigerlinie in die Welt von Judith Williams Cosmetics: Mit 7 Pflanzen und 7 Mineralien schenkt <a href=\"/collections/phytomineral\" title=\"Phytomineral\"><strong>Phytomineral</strong></a> der Haut mehr Leuchtkraft und Strahlkraft in jedem Alter und versorgt sie mit essenziellen Nährstoffen, Mineralstoffen und Spurenelementen.</p>"
          }
        },
        "template--19263606784334__a85f472e-5dc6-4b89-8a3e-37d6d1e186fa-question-2": {
          "type": "question",
          "settings": {
            "title": "Was sind die Hauptwirkstoffe & wie wirken sie?",
            "text": "<p><strong>7 Pflanzen<br/><br/></strong>Für ein strafferes und strahlendes Hautbild.<br/><strong><br/>Ginseng: </strong>regt die Mikrozirkulation der Haut an & fördert ein frisches Hautbild<br/><strong>Hopfen: </strong>stimuliert die Kollagenproduktion & unterstützt ein straffes, gefestigtes Hautbild<br/><strong>Kakao: </strong>versorgt die Haut mit intensiver Feuchtigkeit & verleiht ein zartes Hautgefühl<br/><strong>Lotus: </strong>wirkt beruhigend & sorgt für ein verfeinertes Hautbild<br/><strong>Guarana: </strong>versorgt Zellen mit neuer Energie & wirkt vitalisierend<strong><br/>Rosenwurz: </strong>besitzt antioxidative Eigenschaften & schützt die Haut vor schädlichen Umwelteinflüssen<br/><strong>Maca: </strong>wirkt Hautunreinheiten entgegen & sorgt für ein verbessertes Erscheinungsbild der Haut<strong><br/><br/>7 Mineralien<br/><br/></strong>Für eine gestärkte und tiefenregenerierte Haut.<br/><strong><br/>Kupfer:</strong> regt die Kollagenproduktion an & sorgt für ein gestrafftes Hautbild<br/><strong>Eisen:</strong> fördert ein gepflegtes Hautbild & unterstützt einen natürlich strahlenden Teint <br/><strong>Magnesium: </strong>wirkt beruhigend & mindert feine Linien sowie Fältchen<br/><strong>Silizium:</strong> hilft Bindegewebe zu restrukturieren & stimuliert Stoffwechsel und Zellteilung<br/><strong>Zink:</strong> steigert die natürlichen Abwehrkräfte der Haut & wirkt schützend <br/><strong>Malachit: </strong>unterstützt die Hautregeneration & verstärkt die Widerstandskraft der Haut<br/><strong>Smithsonit: </strong>schützt die Haut vor oxidativem Stress & schädlicher Hautzellschädigung</p>"
          }
        }
      },
