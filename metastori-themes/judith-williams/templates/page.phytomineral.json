        "testimonial_bDMdP3": {
          "type": "testimonial",
          "settings": {
            "icon": "5-stars",
            "testimonial": "<p><strong>Energieaufladung über Nacht<br/></strong>Meine Haut sieht morgens erholter und entspannter aus. Man sieht das, das Serum die Haut über Nacht mit Wirkstoffen versorgt.</p>",
