        },
        "text_mj3inm": {
          "type": "text",
          "settings": {
            "enlarge_text": false,
            "text": "<ul><li><strong>Umweltfaktoren: </strong>zu viel Sonne, Wind oder extreme Temperaturen</li><li><strong>Luftfeuchtigkeit:</strong> Trockene Luft, Heizungsluft, Klimaanlage</li><li><strong>Unzureichende Wasseraufnahme</strong>: Zu wenig Flüssigkeit </li><li><strong>Aggressive Hautpflegeprodukte</strong>: Produkte, die die Haut austrocknen</li><li><strong>Ungesunder Lebensstil</strong>: Z.B. zu viel Koffein oder wenig Schlaf</li></ul>"
          }
