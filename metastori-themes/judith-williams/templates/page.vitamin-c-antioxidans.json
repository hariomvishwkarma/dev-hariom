    "b311ef25-8273-43e3-b1bf-3f28d4388dbf": {
      "type": "rich-text",
      "blocks": {
        "template--18492886057294__b311ef25-8273-43e3-b1bf-3f28d4388dbf-1680699205ebc800a1-0": {
          "type": "heading",
          "settings": {
            "heading_tag": "h1",
            "title": "Vitamin C: Wunder gegen freie Radikale",
            "heading_size": "h2"
          }
        },
        "template--18492886057294__b311ef25-8273-43e3-b1bf-3f28d4388dbf-1680699205ebc800a1-1": {
          "type": "text",
          "settings": {
            "enlarge_text": false,
            "text": "<p>Vitamin C ist eines der stärksten <a href=\"https://www.judithwilliams.com/pages/glossar#Antioxidantien\" title=\"Erklärung was Antioxidantien sind\"><strong>Antioxidantien</strong> </a>in der Hautpflege und ein echter Powerwirkstoff gegen <a href=\"https://www.judithwilliams.com/pages/glossar#Freie%20Radikale\" title=\"Erklärung was freie Radikale sind\"><strong>freie Radikale</strong></a>. Es schützt die Haut vor schädlichen Umwelteinflüssen, unterstützt die natürliche Regeneration und fördert die Kollagenproduktion. Entdecke mit uns die Vorteile von Vitamin C und warum dieser kraftvolle Wirkstoff in keiner Hautpflege-Routine fehlen sollte!</p>"
          }
        }
      },
      "block_order": [
        "template--18492886057294__b311ef25-8273-43e3-b1bf-3f28d4388dbf-1680699205ebc800a1-0",
        "template--18492886057294__b311ef25-8273-43e3-b1bf-3f28d4388dbf-1680699205ebc800a1-1"
      ],
      "settings": {
        "section_id": "",
