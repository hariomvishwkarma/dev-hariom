    "cf35985b-a080-4f24-8ae3-50fcfec77b23": {
      "type": "testimonials",
      "blocks": {
        "f482ad86-12f9-43e1-814c-e96b821d6e28": {
          "type": "testimonial",
          "settings": {
            "icon": "5-stars",
            "testimonial": "<p><strong>Spitzenmäßig. </strong></p><p>Benutze diesen Toner bereits seit Jahren regelmäßig morgens und abends und bin absolut überzeugt.  Er reinigt und erfrischt mild meine empfindliche Haut.</p>",
            "image": "shopify://shop_images/BeautyInstitute_phBalancingToner_Rendering_48adb5df-861b-4fde-b90d-5cb09fb78c66.png",
            "author": "Susann N.",
            "author_info": "Beauty Institute pH Balancing Toner"
          }
        },
        "template--19263606784334__cf35985b-a080-4f24-8ae3-50fcfec77b23-testimonial-1": {
          "type": "testimonial",
          "settings": {
            "icon": "5-stars",
            "testimonial": "<p><strong>Beste Reinigung ever</strong> </p><p>Mein absoluter Favorit. Gerade Augen Make Up ist in Sekunden gelöst. Ich liebe ihn. Ich habe trockene Haut und komme damit wunderbar zurecht.</p>",
            "image": "shopify://shop_images/BeautyInstitute_GoldenNectarCleansingBalm_Rendering.png",
            "author": "Nicole",
            "author_info": "Beauty Institute Golden Nectar Cleansing Balm"
          }
        },
        "b3055879-99ca-4842-8526-473372797232": {
          "type": "testimonial",
          "settings": {
            "icon": "5-stars",
            "testimonial": "<p><strong>Tolles Serum. <br/></strong>Das Serum verwende ich schon seit einigen Jahren und bin total zufrieden! Es ist in meiner Beauty Routine fest verankert, denn: Die  Haut fühlt sich gut genährt, aufgepolstert und gestrafft an. Im Sommer <br/>reicht bei sehr warmen Temperaturen sogar das Serum ohne ergänzende Gesichtscreme. Von mir gibt's dazu eine ganz klare Kaufempfehlung!</p>",
            "image": "shopify://shop_images/BeautyInstitute_ProfessiionalLiftingSkinSerum_rendering_932bacd9-bbdc-4977-ac73-af74db728deb.png",
            "author": "Veronika O.",
            "author_info": "Beauty Institute Professional Lifting Skin Serum"
          }
        },
        "080b7385-aed5-479b-9daa-957790ecdf80": {
          "type": "testimonial",
          "settings": {
            "icon": "5-stars",
            "testimonial": "<p><strong>Bester Reiniger! </strong>Das ist mit Abstand der beste Reiniger, den ich je hatte. Das Gesicht fühlt sich super sauber, frisch und gepflegt an.</p>",
            "image": "shopify://shop_images/BeautyInstitute_HighPerformanceCleansingGel_Rendering2025.png",
            "author": "Heike",
            "author_info": "Beauty Institute High Performance Gel Cleanser"
          }
        },
        "e369cf8e-9daf-42f6-970a-87c616def613": {
          "type": "testimonial",
          "settings": {
            "icon": "5-stars",
            "testimonial": "<p><strong>Toller Sonnenschutz<br/></strong>Ein tolles Produkt, so kann jede Creme zum Sonnenschutz werden. Ich kaufe diese Sun Drops immer wieder nach!</p>",
            "image": "shopify://shop_images/BeautyInstitute__20UltraProtectingSunDrops_Rendering.png",
            "author": "JS",
            "author_info": "Beauty Institute Ultra Protecting Sun Drops SPF 50"
          }
        },
        "b6d9f1e0-fdc5-4a9a-9bde-64a74c485981": {
          "type": "testimonial",
          "settings": {
            "icon": "5-stars",
            "testimonial": "<p><strong>Perfekt 5 von 5 Sternen <br/></strong>Wow für mich die beste Creme die es gibt. Meine trockene schuppige Winterhaut ist innerhalb von 2 Wochen verschwunden. Die Creme hat eine hervorragende Konsistenz und hält was sie verspricht.</p>",
            "image": "shopify://shop_images/BeautyInstitute_Golden_Nectar_FaceCream_Rendering.png",
            "author": "Rabea",
            "author_info": "Beauty Institute Golden Nectar Face Cream"
          }
        }
      },
