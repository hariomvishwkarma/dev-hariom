      "type": "rich-text",
      "blocks": {
        "template--18492886057294__3a7e9184-9273-418a-ab47-41d413cb952e-1680699205ebc800a1-1": {
          "type": "text",
          "settings": {
            "enlarge_text": true,
            "text": "<p><em>„</em>Ein Parfum hat unglaublich viel mit Emotionalität zu tun: Sobald wir es wahrnehmen, weckt es Gefühle wie Freude und Liebe in uns – und das ist, finde ich, eine Kunst!“<em><br/><br/></em></p><p><em>- Judith Williams</em></p>"
          }
        }
      },
