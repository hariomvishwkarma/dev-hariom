        "narrow_column": false,
        "color_scheme": "2",
        "divider": false
      }
    },
    "rich_text_aAycTL": {
      "type": "rich-text",
      "blocks": {
        "text_DxgzVt": {
          "type": "text",
          "disabled": true,
          "settings": {
            "enlarge_text": false,
            "text": "<p>Wir von Judith Williams Cosmetics haben das Privileg mit einigen der renommiertesten und weltbekanntesten Parfumeuren der Branche zusammenzuarbeiten. Diese Gelegenheit haben wir natürlich genutzt, um sie für dich auszuhorchen. Hier sind 7 simple Tricks, mit denen du deinen Lieblingsduft ab jetzt viiiel länger genießen kannst.</p>"
          }
        }
      },
      "block_order": [
        "text_DxgzVt"
      ],
      "disabled": true,
      "settings": {
        "section_id": "",
        "align_text": "center",
