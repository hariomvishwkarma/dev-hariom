        },
        "template--18492886057294__b311ef25-8273-43e3-b1bf-3f28d4388dbf-1680699205ebc800a1-1": {
          "type": "text",
          "settings": {
            "enlarge_text": false,
            "text": "<p>VON JUDITH WILLIAMS<strong><br/><br/></strong>Falls ihr noch ohne Valentinstag-Date seid, dann habt ihr euch getäuscht. Denn ihr habt eines mit dem wichtigsten Menschen, den ihr kennt. Ja, genau: Mit euch selber! Hier kommen 3 Ideen, wie ihr den jour d’amour – den Tag der Liebe – dazu nutzten könnt, euch ein kleines bisschen mehr Selbstliebe zu schenken. </p>"
          }
        }
