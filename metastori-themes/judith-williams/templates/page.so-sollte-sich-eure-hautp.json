    "7b55526e-2e50-4731-bc85-cc928254f25b": {
      "type": "rich-text",
      "blocks": {
        "template--18847317492046__7b55526e-2e50-4731-bc85-cc928254f25b-1682321984144ee6e0-1": {
          "type": "text",
          "settings": {
            "enlarge_text": false,
            "text": "<h2>KLEINES BEAUTY 1X1</h2><p><strong>Kollagen</strong> und <strong>Hyaluron</strong> sind Schlüsselsubstanzen für unsere Haut, die sie durchfeuchten und prall halten. Das Gemeine: Es bleibt nicht ewig so! Mit 50 Jahren haben wir nur noch die Hälfte unserer Hyaluronsäure-Reserven und auch unser Kollagen beginnt ab dem 25. / 30. Lebensjahr langsam schneller zu zerfallen, als es sich neu bildet. Hallo Fältchen! Unser Tipp: Jetzt auf die richtigen Inhaltsstoffe in der Pflege achten und auf Vorsorge setzen!</p>"
          }
        }
      },
      "block_order": [
        "template--18847317492046__7b55526e-2e50-4731-bc85-cc928254f25b-1682321984144ee6e0-1"
      ],
