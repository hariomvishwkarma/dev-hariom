    "text_and_image_kXDc4T": {
      "type": "text-and-image",
      "settings": {
        "image": "shopify://shop_images/Ed-Armamento.jpg",
        "image_mask": "none",
        "image2_mask": "none",
        "subtitle": "",
        "title": "„Der BTX-Hero erzeugt so etwas wie einen Aufspritzt-Effekt, nur ohne die Nebenwirkungen – sichtbar und effektiv!“",
        "heading_size": "h3",
        "text": "<p>– Ed Armamento</p>",
        "small_text": "",
        "button_label": "",
        "button_link": "",
        "button_style": "primary",
        "align_text": "left",
        "image_width": "50",
        "layout": "left",
