    "3a7e9184-9273-418a-ab47-41d413cb952e": {
      "type": "rich-text",
      "blocks": {
        "86e5d59e-5a00-44fb-a7af-45ce4cf36464": {
          "type": "heading",
          "settings": {
            "heading_tag": "h2",
            "title": "DIE WICHTIGSTEN ELEKTROLYTE",
            "heading_size": "h2"
          }
        },
        "template--18492886057294__3a7e9184-9273-418a-ab47-41d413cb952e-1680699205ebc800a1-1": {
          "type": "text",
          "settings": {
            "enlarge_text": false,
            "text": "<p><strong>Kalium </strong>– verantwortlich für den Flüssigkeitsgehalt<br/><strong>Magnesium </strong>– wichtig für Energieversorgung der Zellen<br/><strong>Natrium</strong> – regelt den Wasserhaushalt des Körpers<br/><strong>Chlorid</strong> – verantwortlich für Wasserverteilung in den Körperräumen<br/><strong>Calcium</strong> – leitet Nervenimpulse in Muskeltätigkeit um und hat entzündungshemmende Effekte<br/><strong>Phosphat</strong> – ist hauptsächlich in Knochen und Zähnen gebunden</p>"
          }
        }
      },
