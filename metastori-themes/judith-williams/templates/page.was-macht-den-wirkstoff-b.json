        "template--18492886057294__b311ef25-8273-43e3-b1bf-3f28d4388dbf-1680699205ebc800a1-0": {
          "type": "heading",
          "settings": {
            "heading_tag": "h1",
            "title": "WAS MACHT DEN WIRKSTOFF BTX-HERO AUS LOS ANGELES ZUM STRAFFUNGS-WUNDER?",
            "heading_size": "h2"
          }
        },
        "text_rEaxJy": {
          "type": "text",
          "settings": {
            "enlarge_text": true,
            "text": "<p>LET'S TALK SCIENCE MIT ED ARMAMENTO</p>"
          }
        },
        "template--18492886057294__b311ef25-8273-43e3-b1bf-3f28d4388dbf-1680699205ebc800a1-1": {
          "type": "text",
          "settings": {
            "enlarge_text": false,
            "text": "<p><strong>Teamwork makes the dream work! Wir sind stolz auf unser internationales Team aus Wissenschaftlern und Experten – denn es ist dieser Spirit, der Judith Williams Cosmetics zu etwas ganz Besonderem macht. Zeit für einen Blick hinter die Kulissen! Für ein Exklusiv-Interview mit Judith hat der Innovationsforscher für Kosmetikwirkstoffe Ed Armamento sein Labor in Los Angeles geöffnet – und klärt die Frage, warum der Wirkstoff BTX-Hero aus der SkinPerfect Linie eines der führenden Straffungs-Wunder in der Hautpflege ist.</strong></p>"
          }
        }
      },
      "block_order": [
        "template--18492886057294__b311ef25-8273-43e3-b1bf-3f28d4388dbf-1680699205ebc800a1-0",
