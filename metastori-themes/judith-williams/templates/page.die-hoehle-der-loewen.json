    "39ea6a22-f9ab-4645-9244-a1478dc92243": {
      "type": "text-and-image",
      "disabled": true,
      "settings": {
        "image": "shopify://shop_images/die_hoehle_der_loewen_32.webp",
        "image_mask": "none",
