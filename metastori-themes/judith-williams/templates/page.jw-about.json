    "7b990f61-2bb3-4e90-8f19-90761fb6c4af": {
      "type": "text-columns",
      "blocks": {
        "template--18520722768206__7b990f61-2bb3-4e90-8f19-90761fb6c4af-1680678696f6d2b734-0": {
          "type": "text_block",
          "settings": {
            "enable_image": true,
            "image": "shopify://shop_images/Instagram_46d84ff1-d5a5-4d35-9b4f-663be2eabcd4.png",
            "image_mask": "none",
            "image_width": 650,
            "title": "INSTAGRAM",
            "text": "<p>@judithwilliamsofficial: Ob Hinter den Kulissen von \"Die Höhle der Löwen\" oder einer anderen TV Show, auf dem Weg zum nächsten Termin oder Schnappschüsse aus dem Urlaub, Judith teilt gern ihr Leben mit ihren Fans. Wer ihr folgt weiß auch, dass sie immer für ein lustiges Video zu haben ist.</p>",
            "button_label": "Follow us on Instagram",
            "button_link": "https://www.instagram.com/judithwilliams_official/"
          }
        },
        "template--18520722768206__7b990f61-2bb3-4e90-8f19-90761fb6c4af-1680678696f6d2b734-1": {
          "type": "text_block",
          "settings": {
            "enable_image": true,
            "image": "shopify://shop_images/Tik_Tok.png",
            "image_mask": "none",
            "image_width": 650,
            "title": "TIKTOK",
            "text": "<p>@judithwilliamsofficial: Seit Mitte 2022 ist Judith auch auf TikTok zu finden. Mit ihrem Format \"PepToks\", das sich vor allem an die Generation Z richtet, spricht sie über konkrete Alltagsprobleme,  wie man konstruktives Feedback gibt oder zu einem Rolemodel für andere wird. Und natürlich dürfen diverse funny Videos nicht fehlen ;)</p>",
            "button_label": "FOLLOW US ON TikTok",
            "button_link": "https://www.tiktok.com/@judithwilliamsofficial"
          }
        }
      },
