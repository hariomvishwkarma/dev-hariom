    "rich_text_KGMh9L": {
      "type": "rich-text",
      "blocks": {
        "text_hE7kYG": {
          "type": "text",
          "settings": {
            "enlarge_text": false,
            "text": "<h4><strong>TONER</strong></h4><p><strong>Toner </strong>werden nach der Gesichtsreinigung benutzt und stellen die gründliche Tiefenreinigung sicher. Sie entfernen aber nicht nur Make-up Rückstände: Ein <a href=\"/collections/gesichtswasser\" title=\"Gesichtswasser\"><strong>Gesichtswasser</strong> </a>reguliert auch den pH-Wert der Haut und schafft damit den perfekten Übergang zwischen <a href=\"/collections/gesichtsreinigung\" title=\"Gesichtsreinigung\"><span style=\"text-decoration:underline\"><strong>Reinigung</strong></span></a> und Pflege. Zusätzlich spendet er der Haut Feuchtigkeit und punktet mit hocheffizienten Inhaltsstoffen. </p>"
          }
        },
        "text_4gxAKd": {
          "type": "text",
          "settings": {
            "enlarge_text": false,
            "text": "<p><strong>Unser Beauty-Liebling: </strong><a href=\"/products/beauty-institute-ph-balancing-toner\" title=\"Beauty Institute pH Balancing Toner\"><span style=\"text-decoration:underline\"><strong>Beauty Institute pH Balancing Toner</strong></span></a><strong><br/></strong>Unser multifunktionaler Beauty-Liebling <strong>pH Balancing Toner </strong>kann mehr als das. Dank seiner milden Formulierung eignet er sich nicht nur zur Gesichtsreinigung, sondern auch hervorragend zum Entfernen von Augen Make-up. Ein besonders schöner Zusatzeffekt: Die Verwendung als Erfrischung an heißen Tagen. Einfach in eine Sprühflasche füllen und bei Bedarf das Gesicht leicht damit benetzten. Erfrischung und Pflege in Einem!</p>"
          }
        }
      },
      "block_order": [
        "text_hE7kYG",
        "text_4gxAKd"
      ],
