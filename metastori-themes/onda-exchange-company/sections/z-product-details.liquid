{%- if product.metafields.spec.roast
  or product.metafield.spec.notes
  or product.metafields.spec.varietal
  or product.metafield.spec.elevation
  or product.metafield.spec.process
  or product.metafield.spec.origin
  or product.metafield.spec.farm
-%}
  <div class="o page-width">
    <div class="grid gap-8 lg:gap-16 {% if product.metafields.image.illustration %}lg:grid-cols-2{% else %}max-w-2xl mx-auto{% endif %}">
      {%- if product.metafields.image.illustration -%}
        <div class="">
          {{
            product.metafields.image.illustration
            | image_url: width: 700
            | image_tag: class: 'block relative -top-4 -mb-8'
          }}
        </div>
      {%- endif -%}
      <div class="lg:py-12 pb-12">
        {%- if section.settings.title -%}
            <h2 class="text-h2">{{ section.settings.title }}</h2>
          {%- endif -%}
        {%- if product.description and section.settings.show_description -%}
          <div class="text-body-1">{{ product.description }}</div>
        {%- endif -%}
        {%- if product.metafields.spec.roast -%}
          <div class="border-b border-border space-y-1 py-4">
            <p class="text-tiny">Roast Level</p>
            <p>{{ product.metafields.spec.roast }}</p>
          </div>
        {%- endif -%}
        {%- if product.metafields.spec.origin -%}
          <div class="border-b border-border space-y-1 py-4">
            <p class="text-tiny">Origin</p>
            <p>{{ product.metafields.spec.origin }}</p>
          </div>
        {%- endif -%}
        {%- if product.metafields.spec.elevation -%}
          <div class="border-b border-border space-y-1 py-4">
            <p class="text-tiny">Elevation</p>
            <p>{{ product.metafields.spec.elevation }}</p>
          </div>
        {%- endif -%}
        {%- if product.metafields.spec.varietal -%}
          <div class="border-b border-border space-y-1 py-4">
            <p class="text-tiny">Variety</p>
            <p>{{ product.metafields.spec.varietal }}</p>
          </div>
        {%- endif -%}
        {%- if product.metafields.spec.process -%}
          <div class="border-b border-border space-y-1 py-4">
            <p class="text-tiny">Process</p>
            <p>{{ product.metafields.spec.process }}</p>
          </div>
        {%- endif -%}
        {%- if product.metafields.spec.notes -%}
          <div class="space-y-1 py-4">
            <p class="text-tiny">Tasting Notes</p>
            <p>
              {{ product.metafields.spec.notes | metafield_text }}
            </p>
          </div>
        {%- endif -%}
      </div>
    </div>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "Product details",
  "tag": "section",
  "class": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "id": "show_description",
      "type": "checkbox",
      "label": "Show description",
      "default": false
    },
    {
      "id": "title",
      "type": "text",
      "label": "Title"
    }
  ],
  "presets": [
    {
      "name": "Product details"
    }
  ]
}
{% endschema %}
