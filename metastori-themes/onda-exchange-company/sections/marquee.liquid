{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

{%- if section.blocks -%}
  <div
    class="group antialiased section-{{ section.id }}-padding gradient color-{{ section.settings.section_color_scheme }} overflow-hidden"
  >
    <div
      id="{{ section.id }}"
      class="w-full space-x-24 lg:space-x-32 inline-flex flex-nowrap overflow-hidden"
    >
      <div class="group-hover:paused group-item flex items-center justify-center md:justify-start [&_li]:mx-8 [&_img]:max-w-none animate-infinite-scroll whitespace-nowrap text-center py-2 gap-24">
        {%- if section.blocks -%}
          {%- for i in (1..8) -%}
            {%- for block in section.blocks -%}
              <p
                class="{% if section.settings.title_size == 'tiny' %}font-medium text-body-2{% endif %} {% if section.settings.title_size == 'small' %}text-h4{% endif %} {% if section.settings.title_size == 'medium' %}text-h3{% endif %}"
              >
                {{ block.settings.title }}
              </p>
            {%- endfor -%}
          {%- endfor -%}
        {%- endif -%}
      </div>

      <div
        class="group-hover:paused group-item flex items-center justify-center md:justify-start [&_li]:mx-8 [&_img]:max-w-none animate-infinite-scroll whitespace-nowrap text-center gap-24"
        aria-hidden="true"
      >
        {%- if section.blocks -%}
          {%- for i in (1..8) -%}
            {%- for block in section.blocks -%}
              <p
                class="{% if section.settings.title_size == 'tiny' %}font-medium text-body-2{% endif %} {% if section.settings.title_size == 'small' %}text-h4{% endif %} {% if section.settings.title_size == 'medium' %}text-h3{% endif %}"
              >
                {{ block.settings.title }}
              </p>
            {%- endfor -%}
          {%- endfor -%}
        {%- endif -%}
      </div>
    </div>
  </div>

  <script>
    document.addEventListener('DOMContentLoaded', function () {
      AOS.init();
    });
  </script>
{%- endif -%}

{% schema %}
{
  "name": "Marquee",
  "class": "o",
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "color_scheme",
      "id": "section_color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-1"
    },
    {
      "type": "select",
      "id": "title_size",
      "label": "Title size",
      "options": [
        {
          "value": "medium",
          "label": "Medium"
        },
        {
          "value": "small",
          "label": "Small"
        },
        {
          "value": "tiny",
          "label": "Tiny"
        }
      ],
      "default": "medium"
    },
    {
      "type": "header",
      "content": "t:sections.all.padding.section_padding_heading"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 32
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 32
    }
  ],
  "blocks": [
    {
      "type": "section",
      "name": "Text",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Title"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Marquee"
    }
  ]
}
{% endschema %}

{% stylesheet %}
{% endstylesheet %}

{% javascript %}
{% endjavascript %}
