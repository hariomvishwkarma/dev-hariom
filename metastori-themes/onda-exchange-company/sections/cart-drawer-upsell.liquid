{%- comment -%}
  Rendered via Product Recommendations API for cart drawer related upsells.
  Manual + auto-generated related products are merged by Shopify (Search & Discovery).
{%- endcomment -%}

<div data-cart-drawer-upsell-content>
  {%- if recommendations.performed and recommendations.products_count > 0 -%}
    {%- render 'cart-drawer-upsell-products',
      products: recommendations.products,
      layout: settings.cart_upsell_layout,
      section_id: 'cart-drawer-upsell'
    -%}
  {%- endif -%}
</div>

{% schema %}
{
  "name": "Cart drawer upsell",
  "settings": []
}
{% endschema %}
