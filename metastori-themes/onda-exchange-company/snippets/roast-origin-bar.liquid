<div class="flex md:flex-row flex-col gap-2 md:gap-4 mt-auto {% if large_size %}py-3{% else  %}py-2{% endif %} border-t border-b border-border text-left">
  <div class="flex flex-col {% if large_size %}gap-1 md:gap-3{% else  %}gap-1 md:gap-2{% endif %}">
    <span class="{% if large_size %}text-body-5 uppercase{% else %}text-tiny{% endif %} leading-snug">Roast</span>
    <div class="flex gap-1.5">
      {% assign class_full = 'bg-accent-1' %}
      {% assign class_empty = 'border border-accent-1' %}
      {%- if card_product.metafields.spec.roast == 'Extra Light' -%}
        <span class="h-3 w-3 rounded-full {{ class_full }}">&nbsp;</span>
        <span class="h-3 w-3 rounded-full {{ class_empty }}">&nbsp;</span>
        <span class="h-3 w-3 rounded-full {{ class_empty }}">&nbsp;</span>
        <span class="h-3 w-3 rounded-full {{ class_empty }}">&nbsp;</span>
        <span class="h-3 w-3 rounded-full {{ class_empty }}">&nbsp;</span>
      {%- elsif card_product.metafields.spec.roast == 'Light' -%}
        <span class="h-3 w-3 rounded-full {{ class_full }}">&nbsp;</span>
        <span class="h-3 w-3 rounded-full {{ class_full }}">&nbsp;</span>
        <span class="h-3 w-3 rounded-full {{ class_empty }}">&nbsp;</span>
        <span class="h-3 w-3 rounded-full {{ class_empty }}">&nbsp;</span>
        <span class="h-3 w-3 rounded-full {{ class_empty }}">&nbsp;</span>
      {%- elsif card_product.metafields.spec.roast == 'Medium' -%}
        <span class="h-3 w-3 rounded-full {{ class_full }}">&nbsp;</span>
        <span class="h-3 w-3 rounded-full {{ class_full }}">&nbsp;</span>
        <span class="h-3 w-3 rounded-full {{ class_full }}">&nbsp;</span>
        <span class="h-3 w-3 rounded-full {{ class_empty }}">&nbsp;</span>
        <span class="h-3 w-3 rounded-full {{ class_empty }}">&nbsp;</span>
      {%- elsif card_product.metafields.spec.roast == 'Dark' -%}
        <span class="h-3 w-3 rounded-full {{ class_full }}">&nbsp;</span>
        <span class="h-3 w-3 rounded-full {{ class_full }}">&nbsp;</span>
        <span class="h-3 w-3 rounded-full {{ class_full }}">&nbsp;</span>
        <span class="h-3 w-3 rounded-full {{ class_full }}">&nbsp;</span>
        <span class="h-3 w-3 rounded-full {{ class_empty }}">&nbsp;</span>
      {%- elsif card_product.metafields.spec.roast == 'Extra Dark' -%}
        <span class="h-3 w-3 rounded-full {{ class_full }}">&nbsp;</span>
        <span class="h-3 w-3 rounded-full {{ class_full }}">&nbsp;</span>
        <span class="h-3 w-3 rounded-full {{ class_full }}">&nbsp;</span>
        <span class="h-3 w-3 rounded-full {{ class_full }}">&nbsp;</span>
        <span class="h-3 w-3 rounded-full {{ class_full }}">&nbsp;</span>
      {%- endif -%}
    </div>
  </div>
  <div class="md:!block hidden border-border border-l">&nbsp;</div>
  <div class="flex flex-col gap-1 md:gap-1">
    {%- if large_size -%}
      <span class="flex-none {% if large_size %}text-body-5 uppercase{% else %}text-tiny{% endif %} leading-snug"
        >Origin</span
      >
      <p class="{% if large_size %}text-body-1{% else  %}text-body-3{% endif  %}">
        {%- if card_product.metafields.spec.origin == 'Varies' or card_product.metafields.spec.country == 'Varies' -%}
          Varies
        {%- else -%}
          {{ card_product.metafields.spec.origin }},
          {{ card_product.metafields.spec.country }}
        {%- endif -%}
      </p>
    {%- else -%}
      {%- if card_product.metafields.spec.notes -%}
        <span class="flex-none {% if large_size %}text-body-5 uppercase{% else %}text-tiny{% endif %} leading-snug"
          >Tasting Notes</span
        >
        <p class="{% if large_size %}text-body-1{% else  %}text-body-3{% endif  %}">
          {{ card_product.metafields.spec.notes | metafield_text }}
        </p>
      {%- else -%}
        <span class="flex-none {% if large_size %}text-body-5 uppercase{% else %}text-tiny{% endif %} leading-snug"
          >Origin</span
        >
        <p class="{% if large_size %}text-body-1{% else  %}text-body-3{% endif  %}">
          {%- if card_product.metafields.spec.origin == 'Varies' or card_product.metafields.spec.country == 'Varies' -%}
            Varies
          {%- else -%}
            {{ card_product.metafields.spec.origin }},
            {{ card_product.metafields.spec.country }}
          {%- endif -%}
        </p>
      {%- endif -%}
    {%- endif -%}
  </div>
</div>
