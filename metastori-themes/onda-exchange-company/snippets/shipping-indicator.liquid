{%- assign shipping_threshold = settings.free_shipping_threshold | times: 100 -%}
{%- assign cart_price = cart.total_price -%}
{%- assign compare_total = cart_price -%}

{%- assign threshold = shipping_threshold | times: 1.00 -%}
{%- assign difference = threshold | minus: compare_total -%}
{%- assign percentage = difference | divided_by: threshold | times: 100 -%}
{%- assign negative_percentage = 100 | minus: percentage -%}
<div
  class="p-4 {% if difference > 0 and cart.requires_shipping %}{% else %}{% endif %} text-center text-body-2"
>
  {%- if difference > 0 and cart.requires_shipping or percentage == 100 -%}
    <span class="text-body-3 mb-2 block">
      You are
      <strong class="font-medium">{{ difference | money_without_trailing_zeros }}</strong>
      away from free shipping.
    </span>
    <div class="border border-accent-2">
      <span class="block h-2 bg-accent-2" style="width: {{ negative_percentage }}%;"></span>
    </div>
  {%- else -%}
    <span class="text-body-3 mb-2 block"
      >You qualify for free shipping!
      {%- if settings.show_additional_shipping_message %}
        <span>{{ settings.show_additional_shipping_message }}</span>
      {%- endif -%}
    </span>

    <div class="border border-accent-2">
      <span class="block h-2 w-full bg-accent-2"></span>
    </div>
  {%- endif -%}
</div>
