{%- style -%}
  {%- if card_product.metafields.color.color_contrast.value.primary and card_product.metafields.color.color_contrast.value.contrast -%}
    #card-{{ section.id }}-{{ card_product.id }} {
      --color-foreground: {{ card_product.metafields.color.color_contrast.value.contrast.value.red }}, {{ card_product.metafields.color.color_contrast.value.contrast.value.green }}, {{ card_product.metafields.color.color_contrast.value.contrast.value.blue }};
      --color-background: {{ card_product.metafields.color.color_contrast.value.primary.value.red }}, {{ card_product.metafields.color.color_contrast.value.primary.value.green }}, {{ card_product.metafields.color.color_contrast.value.primary.value.blue }};
      --gradient-background: {{ card_product.metafields.color.color_contrast.value.primary }};
    }

    #card-{{ section.id }}-{{ card_product.id }}:hover {
      --color-foreground: {{ card_product.metafields.color.color_primary.value.contrast.value.red }}, {{ card_product.metafields.color.color_primary.value.contrast.value.green }}, {{ card_product.metafields.color.color_primary.value.contrast.value.blue }};
      --color-background:  {{ card_product.metafields.color.color_primary.value.primary.value.red }}, {{ card_product.metafields.color.color_primary.value.primary.value.green }}, {{ card_product.metafields.color.color_primary.value.primary.value.blue }};
      --gradient-background: {{ card_product.metafields.color.color_primary.value.primary }};
    }
  {%- endif -%}
{%- endstyle -%}

<a
  id="card-{{ section.id }}-{{ card_product.id }}"
  href="{{ card_product.url }}"
  class="rounded-md block text-center h-full color-scheme-1 gradient"
>
  {%- if card_product.metafields.image.pack -%}
    {{ card_product.metafields.image.pack | image_url: width: '900' | image_tag: class: 'block w-full' }}
  {%- endif -%}

  <div class="px-4 pb-8 space-y-2">
    <h3 class="text-h4">
      {{ card_product.title }}
    </h3>
    {%- if card_product.metafields.spec.notes -%}
      <div class="text-body-4">
        {%- for note in card_product.metafields.spec.notes.value -%}
          {{ note -}}
          {%- unless forloop.last %}, {% endunless %}
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>
</a>
