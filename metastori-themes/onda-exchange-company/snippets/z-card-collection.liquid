<div class="o">
  <div class="group h-full bg-white flex flex-col">
    <div class="flex-none">
      <a href="{{ card_collection.url }}" class="block group aspect-[4/5]">
        {{ card_collection.featured_image | image_url: width: '900' | image_tag: class: 'h-full w-full object-cover' }}
      </a>
    </div>
    <div class="p-4 space-y-4 flex flex-col flex-grow">
      <div class="text-left space-y-4 flex-grow">
        <h3 class="group-hover:underline underline-offset-4 decoration-1 text-h3 flex justify-between items-center">
          <a href="{{ card_collection.url }}">{{ card_collection.title }}</a>
          <svg
            width="12"
            height="21"
            viewBox="0 0 12 21"
            fill="none"
            xmlns="http://www.w3.org/2000/svg">
            <path d="M8.96466 10.3979L0.107329 1.54062L1.25 0.397949L11.25 10.3979L1.25 20.3979L0.107329 19.2553L8.96466 10.3979Z" fill="currentColor" />
          </svg>
        </h3>
      </div>
    </div>
  </div>
</div>