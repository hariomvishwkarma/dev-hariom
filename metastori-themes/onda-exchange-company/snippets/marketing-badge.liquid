{%- if product.metafields.marketing.badge -%}
<div class="o">
  <div class="absolute z-[1] top-2 right-2 lg:top-4 lg:right-4">
    {%- for badge in product.metafields.marketing.badge.value -%}
      {%- assign color = badge.color.value -%}
      <span
        style="background-color: {{ color.primary }}"
        class="{% if style_small %}h-16 w-16 lg:w-20 lg:h-20 text-body-4 {% else %}h-20 w-20 lg:w-24 lg:h-24 text-body-2 {% endif %} rounded-full flex items-center justify-center "
      >
        {{ badge.label }}
      </span>
    {%- endfor -%}
  </div>
</div>
{%- endif -%}


