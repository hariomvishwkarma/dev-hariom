@font-face {
    font-family: 'G2-Erika';
    font-weight: 700;
    font-style: normal;
    src: url("{{ 'G2-Erika-Medium.woff2' | asset_url }}") format('woff2'), url("{{ 'G2-Erika-Medium.woff' | asset_url }}") format('woff'), url("{{ 'G2-Erika-Medium.otf' | asset_url }}") format('otf'), url("{{ 'G2-Erika-Medium.ttf' | asset_url }}") format('ttf');
}

@font-face {
    font-family: 'G2-Erika';
    font-weight: 400;
    font-style: normal;
    src: url("{{ 'G2-Erika-Regular.woff2' | asset_url }}") format('woff2'), url("{{ 'G2-Erika-Regular.woff' | asset_url }}") format('woff'), url("{{ 'G2-Erika-Regular.otf' | asset_url }}") format('otf'), url("{{ 'G2-Erika-Regular.ttf' | asset_url }}") format('ttf');
}