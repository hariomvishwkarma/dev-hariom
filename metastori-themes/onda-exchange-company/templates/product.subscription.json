    "multicolumn_REwhfX": {
      "type": "multicolumn",
      "blocks": {
        "column_EFkzdq": {
          "type": "column",
          "settings": {
            "image": "shopify://shop_images/Friska_and_James_and_Family.jpg",
            "title": "<strong>Your membership has a real impact on our partners.</strong>",
            "text": "<p>We work closely with growers and importers to share revenue from every bag sold. We call it Revenue Share—and Coffee Club members play a direct role in making it possible. </p>",
            "link_label": "",
            "link": ""
          }
        },
        "column_Wzzkyy": {
          "type": "column",
          "settings": {
            "image": "shopify://shop_images/group-2.jpg",
            "title": "<strong>Know who grew your coffee—and why it matters.</strong>",
            "text": "<p>Each month, Coffee Club members get a behind-the-scenes email spotlighting the coffee in your box, the people who produced it, and more. It’s an invitation to learn, stay curious, and engage more thoughtfully with your coffee routine.</p>",
            "link_label": "",
            "link": ""
          }
        },
        "column_xLkzRD": {
          "type": "column",
          "settings": {
            "image": "shopify://shop_images/Circular_Dots.png",
            "title": "<strong>Origin-focused extras.</strong>",
            "text": "<p>From postcards and printed stories to occasional surprises inspired by origin, we love finding small, tangible ways to honor our partners and share their work with you. Consider it a little love note from the supply chain—just for members.</p>",
            "link_label": "",
            "link": ""
          }
        }
      },
      "block_order": [
        "column_EFkzdq",
        "column_Wzzkyy",
        "column_xLkzRD"
      ],
