    "collapsible_content_dat4aK": {
      "type": "collapsible-content",
      "blocks": {
        "collapsible_row_MygQcR": {
          "type": "collapsible_row",
          "settings": {
            "heading": "I can't find my subscription information",
            "icon": "none",
            "row_content": "<p>1. Navigate to the top right of the Onda Origins website and locate the icon that looks like a person inside of a circle<br/><br/>2. Login using your Onda account (the same login as your subscription account)<br/><br/>3. Once you are logged in, click the button at the top of the page that says <em>Manage Subscriptions</em><br/><br/>4. That will bring you to your subscription portal, where you can make all necessary updates</p>",
            "page": ""
          }
        },
        "collapsible_row_jFrEKP": {
          "type": "collapsible_row",
          "settings": {
            "heading": "I want to pause my subscription",
            "icon": "none",
            "row_content": "<p>1. Log in to your member portal via the account login on the Onda website<br/><br/>2. Navigate to the second section of the page where it says \"Next order: Date\"<br/><br/>3. Select \"Delay\" and choose the time frame that works best for you</p>",
            "page": ""
          }
        },
        "collapsible_row_aRzRed": {
          "type": "collapsible_row",
          "settings": {
            "heading": "I want to change the frequency of my orders",
            "icon": "none",
            "row_content": "<p>1. Log in to your member portal via the account login on the Onda website<br/><br/>2. Scroll to the bottom portion of the page where it says \"Subscription Details\"<br/><br/>3. In the \"Subscription Plan\" box click \"Edit\" and update the frequency of your delivery</p>",
            "page": ""
          }
        },
        "collapsible_row_JWrNLy": {
          "type": "collapsible_row",
          "settings": {
            "heading": "I want to add something else to my subscription",
            "icon": "none",
            "row_content": "<p>1. Log in to your member portal via the account login on the Onda website</p><p>2. Scroll to the black box that says \"Goes well with your next order...\"</p><p>3. Select from recommended product or click \"see more products,\" where you can browse our entire online catalog<br/><br/>4. Select the product, choose applicable options like grind size and bag size<br/><br/>5. Click \"add one time,\" or add it as a recurring product to get a discount</p>",
            "page": ""
          }
        },
        "collapsible_row_JBinwV": {
          "type": "collapsible_row",
          "settings": {
            "heading": "I want to switch to Subscribe & Save or Coffee Club",
            "icon": "none",
            "row_content": "<p>1. Log in to your member portal via the account login on the Onda website<br/><br/>2. Scroll down the page to the Subscription Details section</p><p>3. In the first box where your current subscription product is listed, select \"edit\"</p><p>4. In the pop-out that appears, select \"swap\"</p><p>5a. If you would like to switch to <strong>Subscribe & Save</strong>, select the coffee you want to receive, the grind, size, & quantity and click \"confirm swap\"</p><p>5b. To switch to <strong>Coffee Club</strong>, type \"Roaster's Choice\" in the search bar and select the grind size and frequency for your new Coffee Club subscription. (Learn more about that model <a href=\"/products/onda-coffee-club\" title=\"Roaster's Choice\"><strong>here</strong></a>.) <br/><br/>6. Click \"confirm swap\"</p>",
            "page": ""
          }
        },
        "collapsible_row_6AcTtR": {
          "type": "collapsible_row",
          "settings": {
            "heading": "I want to cancel my subscription",
            "icon": "none",
            "row_content": "<p>1. Log in to your member portal via the account login on the Onda website</p><p>2. Scroll to the bottom of the page and click \"cancel subscription\"</p><p>3. Answer all applicable questions and confirm cancellation</p><p><strong>Note: </strong>You can re-start your subscription without losing your data any time you'd like by logging back into your member portal and reactivating!</p>",
            "page": ""
          }
        }
      },
