        "text_FDBhir": {
          "type": "text",
          "settings": {
            "text": "<p>When we created Onda Origins, we wanted to build a new way of doing business: one that centers the people most often sidelined in an industry that depends on them.</p>",
            "text_style": "body"
          }
        }
      },
