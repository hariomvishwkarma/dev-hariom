            "custom_liquid": "<div style=\"background: none;\">\n  <h3 style=\"font-size: 11px; font-weight: semi-bold; margin-bottom: 1.2rem;\">\n    What’s Inside Your Shieldeck Protection Kit\n  </h3>\n\n  <div style=\"height: 1px; background: #00B5DF; margin-bottom: 2rem;\"></div>\n\n  <div style=\"display: flex; flex-wrap: wrap; gap: 20px;\">\n\n    <!-- Main Device -->\n    <div style=\"flex: 1 1 100%; max-width: 100%; display: flex; align-items: flex-start; gap: 12px;\">\n      <img src=\"https://cdn.shopify.com/s/files/1/0735/4672/7723/files/Group_335788_f3992fe4-4026-446e-a2ab-4e659853597a.png?v=1750512657\" alt=\"Bullet Icon\" style=\"width: 20px; height: 20px; margin-top: 4px;\">\n      <div>\n        <strong style=\"display: block; font-size: 11px; font-weight: 600;\">1x Shieldeck BuzzTrap UV Trap</strong>\n        <span style=\"font-size: 11px; font-weight: 500;\">BuzzTrap Device with UV light trap for 24/7 protection</span>\n      </div>\n    </div>\n\n    <!-- Sticky Pads -->\n    <div style=\"flex: 1 1 100%; max-width: 100%; display: flex; align-items: flex-start; gap: 12px;\">\n      <img src=\"https://cdn.shopify.com/s/files/1/0735/4672/7723/files/Group_335788_f3992fe4-4026-446e-a2ab-4e659853597a.png?v=1750512657\" alt=\"Bullet Icon\" style=\"width: 20px; height: 20px; margin-top: 4px;\">\n      <div>\n        <strong style=\"display: block; font-size: 11px; font-weight: 600;\">5x Glue Pads</strong>\n        <span style=\"font-size: 11px; font-weight: 500;\">Captures bugs quietly—no zaps, no mess</span>\n      </div>\n    </div>\n\n    \n    <!-- Quick Start Guide -->\n    <div style=\"flex: 1 1 100%; max-width: 100%; display: flex; align-items: flex-start; gap: 12px;\">\n      <img src=\"https://cdn.shopify.com/s/files/1/0735/4672/7723/files/Group_335788_f3992fe4-4026-446e-a2ab-4e659853597a.png?v=1750512657\" alt=\"Bullet Icon\" style=\"width: 20px; height: 20px; margin-top: 4px;\">\n      <div>\n        <strong style=\"display: block; font-size: 11px; font-weight: 600;\">1x Quick Start Guide</strong>\n        <span style=\"font-size: 11px; font-weight: 500;\">Simple setup in under 2 minutes—just plug in</span>\n      </div>\n    </div>\n\n    <!-- Travel-Friendly Box -->\n    <div style=\"flex: 1 1 100%; max-width: 100%; display: flex; align-items: flex-start; gap: 12px;\">\n      <img src=\"https://cdn.shopify.com/s/files/1/0735/4672/7723/files/Group_335788_f3992fe4-4026-446e-a2ab-4e659853597a.png?v=1750512657\" alt=\"Bullet Icon\" style=\"width: 20px; height: 20px; margin-top: 4px;\">\n      <div>\n        <strong style=\"display: block; font-size: 11px; font-weight: 600;\">1x Sleek Gift Box</strong>\n        <span style=\"font-size: 11px; font-weight: 500;\">Keeps your trap + pads tidy when not in use</span>\n      </div>\n    </div>\n\n  </div>\n</div>",
