        "code": "<!-- Flickity -->\n<link rel=\"stylesheet\" href=\"https://cdn.jsdelivr.net/npm/flickity@2/dist/flickity.min.css\">\n<script src=\"https://cdn.jsdelivr.net/npm/flickity@2/dist/flickity.pkgd.min.js\"></script>\n\n<style>\n  .review-testimonials {\n    background: #F8F6F5;\n    padding: 60px 20px;\n    font-family: inherit;\n    text-align: center;\n  }\n\n  .review-testimonials h2 {\n    font-size: 38px;\n    font-weight: 500;\n    margin-bottom: 30px;\n  }\n\n  .review-carousel {\n    max-width: 950px;\n    margin: 0 auto;\n  }\n\n  .review-cell {\n    width: 300px;\n    margin-right: 20px;\n    background: #fff;\n    border: 1px solid #d5e4f2;\n    border-radius: 16px;\n    padding: 18px;\n    box-shadow: 0 4px 10px rgba(0, 0, 0, 0.06);\n    text-align: left;\n    margin-bottom: 15px;\n  }\n\n  .review-cell img.review-image {\n    width: 100%;\n    border-radius: 12px;\n    margin-top: 16px;\n  }\n\n  .review-stars {\n    font-size: 12px;\n    color: #FFD000;\n    margin-bottom: 7px;\n  }\n\n  .review-title {\n    font-size: 10px;\n    font-weight: 700;\n    margin-bottom: 5px;\n  }\n\n  .review-text {\n    font-size: 10px;\n    font-weight: 500;\n    margin-bottom: 12px;\n    letter-spacing: -0.01em;\n  }\n\n  .review-author {\n    font-size: 9px;\n    margin-bottom: 4px;\n    display: flex;\n    align-items: center;\n    flex-wrap: wrap;\n    gap: 6px;\nfont-weight: 500;\n    justify-content: space-between;\n  }\n\n  .review-verified {\n    font-size: 9px;\n    display: flex;\n    align-items: center;\n    gap: 4px;\n    color: #191919;\n  }\n\n  .review-verified svg {\n    width: 10px;\n    height: 10px;\n  }\n\n  .flickity-prev-next-button {\n    background: transparent;\n    top: 35%;\n  }\n\n  .flickity-prev-next-button.previous {\n    left: -60px;\n  }\n\n  .flickity-prev-next-button.next {\n    right: -60px;\n  }\n\n  .flickity-prev-next-button .flickity-button-icon {\n    fill: #00B5DF;\n    width: 18px;\n    height: 18px;\n  }\n\n  @media (max-width: 768px) {\n    .review-cell {\n      width: 65%;\n      margin-right: 12px;\n      padding: 20px;\n    }\n\n    .review-carousel {\n      margin-right: -20px;\n    }\n\n    .flickity-prev-next-button {\n      display: none !important;\n    }\n  }\n</style>\n\n<section class=\"review-testimonials\">\n  <h2>Loved by Over <i class=\"custom-heading-underline\">1 Million Homes</i></h2>\n\n  <div class=\"review-carousel\" data-flickity='{\n    \"cellAlign\": \"left\",\n    \"contain\": true,\n    \"pageDots\": true,\n    \"prevNextButtons\": true,\n    \"wrapAround\": true,\n    \"groupCells\": 1\n  }'>\n\n    <!-- Card 1 -->\n    <div class=\"review-cell\">\n      <div class=\"review-stars\">★ ★ ★ ★ ★</div>\n      <div class=\"review-title\">Wonderful Product!</div>\n      <div class=\"review-text\">Eliminate flying pests with eco‑friendly UV tech, safe for your family & pets.</div>\n      <div class=\"review-author\">\n        Kelsi C.        <span class=\"review-verified\">\n          <svg xmlns=\"http://www.w3.org/2000/svg\" width=\"22\" height=\"23\" viewBox=\"0 0 22 23\" fill=\"none\">\n<path d=\"M10.6641 0.75C16.1174 0.75 20.579 5.32036 20.5791 11.0088C20.5791 16.6973 16.1174 21.2676 10.6641 21.2676C5.21093 21.2673 0.75 16.6971 0.75 11.0088C0.750056 5.32051 5.21096 0.750239 10.6641 0.75Z\" stroke=\"#E1588E\" stroke-width=\"1.5\"/>\n<path d=\"M5.99866 12.5394L8.2588 15.2044C8.4585 15.4398 8.82176 15.4398 9.02146 15.2044L15.4967 7.56934\" stroke=\"#E1588E\" stroke-width=\"1.5\" stroke-linecap=\"round\"/>\n</svg>\n          Verified Purchase\n        </span>\n      </div>\n      <img class=\"review-image\" src=\"https://cdn.shopify.com/s/files/1/0721/1758/3906/files/review_1.png?v=1780404729&width=250\" alt=\"Rachel L review image\">\n    </div>\n\n    <!-- Card 2 -->\n    <div class=\"review-cell\">\n      <div class=\"review-stars\">★ ★ ★ ★ ★</div>\n      <div class=\"review-title\">Great Heating Pad!</div>\n      <div class=\"review-text\">No chemicals, no noise, no hassle. I wake up with zero mosquito bites now.</div>\n      <div class=\"review-author\">\n        Kilbania G.        <span class=\"review-verified\">\n          <svg xmlns=\"http://www.w3.org/2000/svg\" width=\"22\" height=\"23\" viewBox=\"0 0 22 23\" fill=\"none\">\n<path d=\"M10.6641 0.75C16.1174 0.75 20.579 5.32036 20.5791 11.0088C20.5791 16.6973 16.1174 21.2676 10.6641 21.2676C5.21093 21.2673 0.75 16.6971 0.75 11.0088C0.750056 5.32051 5.21096 0.750239 10.6641 0.75Z\" stroke=\"#E1588E\" stroke-width=\"1.5\"/>\n<path d=\"M5.99866 12.5394L8.2588 15.2044C8.4585 15.4398 8.82176 15.4398 9.02146 15.2044L15.4967 7.56934\" stroke=\"#E1588E\" stroke-width=\"1.5\" stroke-linecap=\"round\"/>\n</svg>\n          Verified Purchase\n        </span>\n      </div>\n      <img class=\"review-image\" src=\"https://cdn.shopify.com/s/files/1/0721/1758/3906/files/review_4.png?v=1780404780&width=250\" alt=\"Luis M review image\" loading=\"lazy\">\n    </div>\n\n    <!-- Card 3 -->\n    <div class=\"review-cell\">\n      <div class=\"review-stars\">★ ★ ★ ★ ★</div>\n      <div class=\"review-title\">Comfortable and Effective!</div>\n      <div class=\"review-text\">I hated spraying stuff around the house. This is totally non-toxic-and effective.</div>\n      <div class=\"review-author\">\n        Janirette C.        <span class=\"review-verified\">\n          <svg xmlns=\"http://www.w3.org/2000/svg\" width=\"22\" height=\"23\" viewBox=\"0 0 22 23\" fill=\"none\">\n<path d=\"M10.6641 0.75C16.1174 0.75 20.579 5.32036 20.5791 11.0088C20.5791 16.6973 16.1174 21.2676 10.6641 21.2676C5.21093 21.2673 0.75 16.6971 0.75 11.0088C0.750056 5.32051 5.21096 0.750239 10.6641 0.75Z\" stroke=\"#E1588E\" stroke-width=\"1.5\"/>\n<path d=\"M5.99866 12.5394L8.2588 15.2044C8.4585 15.4398 8.82176 15.4398 9.02146 15.2044L15.4967 7.56934\" stroke=\"#E1588E\" stroke-width=\"1.5\" stroke-linecap=\"round\"/>\n</svg>\n          Verified Purchase\n        </span>\n      </div>\n      <img class=\"review-image\" src=\"https://cdn.shopify.com/s/files/1/0721/1758/3906/files/review_3.png?v=1780404763&width=250\" alt=\"Dana K review image\" loading=\"lazy\">\n    </div>\n\n    <!-- Card 4 -->\n    <div class=\"review-cell\">\n      <div class=\"review-stars\">★ ★ ★ ★ ★</div>\n      <div class=\"review-title\">How much I love this product!!!</div>\n      <div class=\"review-text\">Each pad gets full in a few days. It’s gross, but also really satisfying.</div>\n      <div class=\"review-author\">\n        Kerri E.        <span class=\"review-verified\">\n          <svg xmlns=\"http://www.w3.org/2000/svg\" width=\"22\" height=\"23\" viewBox=\"0 0 22 23\" fill=\"none\">\n<path d=\"M10.6641 0.75C16.1174 0.75 20.579 5.32036 20.5791 11.0088C20.5791 16.6973 16.1174 21.2676 10.6641 21.2676C5.21093 21.2673 0.75 16.6971 0.75 11.0088C0.750056 5.32051 5.21096 0.750239 10.6641 0.75Z\" stroke=\"#E1588E\" stroke-width=\"1.5\"/>\n<path d=\"M5.99866 12.5394L8.2588 15.2044C8.4585 15.4398 8.82176 15.4398 9.02146 15.2044L15.4967 7.56934\" stroke=\"#E1588E\" stroke-width=\"1.5\" stroke-linecap=\"round\"/>\n</svg>\n          Verified Purchase\n        </span>\n      </div>\n      <img class=\"review-image\" src=\"https://cdn.shopify.com/s/files/1/0721/1758/3906/files/review_2.png?v=1780404747&width=250\" alt=\"Justin F review image\" loading=\"lazy\">\n    </div>\n</section>"
