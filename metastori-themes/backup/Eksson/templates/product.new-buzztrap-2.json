        "full_width": true,
        "show_space": true,
        "code": "<style>\n  .flasher-wrapper {\n    background: #F8F6F5;\n    padding: 40px 20px;\n    display: flex;\n    justify-content: center;\n  }\n\n  .flasher-section {\n    display: flex;\n    flex-wrap: wrap;\n    align-items: stretch;\n    border-radius: 20px;\n    overflow: hidden;\n    background: #F4FCFF;\n    max-width: 835px;\n    width: 100%;\n  }\n\n  .flasher-left {\n    flex: 1 1 50%;\n    min-height: 400px;\n    position: relative;\n  }\n\n  .flasher-left img {\n    width: 100%;\n    height: 100%;\n    object-fit: cover;\n    display: block;\n  }\n\n  .flasher-title-overlay {\n    display: none;\n  }\n\n  .flasher-right {\n    flex: 1 1 50%;\n    padding: 60px 40px;\n    display: flex;\n    flex-direction: column;\n    justify-content: center;\n    background-color: #fff;\n  }\n\n  .flasher-right h2 {\n    font-size: 32px;\n    font-weight: 500;\n    line-height: 1.2;\n    margin-bottom: 10px;\n    color: #191919;\n  }\n\n  .flasher-right p {\n    font-size: 12px;\n    line-height: 1.6;\n    color: #191919;\n    font-weight: 500;\n    margin-bottom: 15px;\n  }\n\n  .flasher-pricing {\n    display: flex;\n    flex-direction: column;\n    gap: 14px;\n    margin-bottom: 20px;\n    letter-spacing: -0.2px;\n  }\n\n  .flasher-price-row {\n    display: flex;\n    align-items: center;\n    font-size: 15px;\n    font-weight: 500;\n  }\n\n  .flasher-label {\n    display: inline-block;\n    padding: 12px 18px;\n    border-radius: 6px;\n    margin-right: 10px;\n    font-size: 12px;\n  }\n\n  .flasher.flasher-label {\n    background: #191919;\n    color: #fff;\n  }\n\n  .other.flasher-label {\n    background: #191919;\n    color: #fff;\n    font-weight: 500;\n    text-align: left;\n  }\n\n  .price-text {\n    font-weight: 500;\n    color: #1a1a1a;\n    white-space: nowrap;\n    font-size: 12px;\n  }\n\n  .flasher-note {\n    font-size: 12px;\n    color: #191919;\n    font-size: 11px;\n  }\n\n  @media (max-width: 768px) {\n    .flasher-section {\n      displa