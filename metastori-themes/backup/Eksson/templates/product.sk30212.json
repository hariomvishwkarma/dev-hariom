n      margin-right: 16px;\n    }\n  }\n\n  @media (min-width: 769px) {\n    .benefits-carousel {\n      display: none;\n    }\n  }\n</style>\n\n<section class=\"bug-benefits-section\">\n  <h2>One Month In</h2>\n  <h1>Here’s What Changes</h1>\n\n  <!-- Desktop Version -->\n  <div class=\"benefits-grid\">\n    <div class=\"benefit-card\">\n      <img src=\"https://cdn.shopify.com/s/files/1/0515/2459/9996/files/Frame_169_1.jpg?v=1752922694\" alt=\"Chemical-Free Results\" />\n      <div class=\"benefit-content\">\n        <div class=\"benefit-title\">Fewer Bites. Better Sleep.</div>\n        <div class=\"benefit-text\">\n          Sleep peacefully again. No buzzing, no bites, no harsh repellents required.\n        </div>\n      </div>\n    </div>\n\n    <div class=\"benefit-card\">\n      <img src=\"https://cdn.shopify.com/s/files/1/0515/2459/9996/files/Frame_168_1.jpg?v=1752922693\" alt=\"Cleaner Indoor Air\" />\n      <div class=\"benefit-content\">\n        <div class=\"benefit-title\">No Chemicals. No Odors.</div>\n        <div class=\"benefit-text\">\n          Say goodbye to sprays and zappers. Your home stays fresh, clean, and safe.\n        </div>\n      </div>\n    </div>\n\n    <div class=\"benefit-card\">\n      <img src=\"https://cdn.shopify.com/s/files/1/0515/2459/9996/files/Frame_170_1.jpg?v=1752922694\" alt=\"Visible Results\" />\n      <div class=\"benefit-content\">\n        <div class=\"benefit-title\">Traps Fill. Bugs Disappear.</div>\n        <div class=\"benefit-text\">\n          In just weeks, you’ll see fewer flies, gnats, and fruit pests—guaranteed.\n        </div>\n      </div>\n    </div>\n  </div>\n\n  <!-- Mobile Carousel Version -->\n  <div class=\"benefits-carousel\" data-flickity='{\n    \"cellAlign\": \"center\",\n    \"contain\": true,\n    \"pageDots\": false,\n    \"prevNextButtons\": false\n  }'>\n    <!-- Slide 1 -->\n    <div class=\"carousel-cell\">\n      <div class=\"benefit-card\">\n        <img src=\"https://cdn.shopify.com/s