        "question_nj7wRH": {
          "type": "question",
          "settings": {
            "title": "Is it better than sticky traps?",
            "answer": "<p>Way better. Shieldeck attracts and zaps pests silently — no goo, no cleanup</p>"
          }
        },
        "question_XVUrAP": {
          "type": "question",
          "settings": {
            "title": "Will it work in my home?",
            "answer": "<p>Absolutely. Apartments, houses, RVs — Shieldeck’s safe and effective anywhere.</p>"
          }
        },
        "question_DEY63a": {
          "type": "question",
          "settings": {
            "title": "What makes Shieldeck better than others?",
            "answer": "<p>It uses smart UV tech, no harsh chemicals, and looks sleek in any space. Bug-free living, minus the buzz.</p>"
          }
        },
        "question_WgEBXn": {
          "type": "question",
          "settings": {
            "title": "What type of UV light does it use?",
            "answer": "<p>BuzzTrap uses a <strong>365 nm UV light</strong> with a LED bulb. It’s super effective at luring flying pests, and totally safe for people and pets.</p>"
          }
        },
        "question_rNbKNF": {
          "type": "question",
          "settings": {
            "title": "How long does the bulb last?",
            "answer": "<p>A long time, <strong>about 20,000 hours</strong>. That’s roughly 4<strong> years</strong> if you run it 14 hours a day!</p>"
          }
        },
        "question_zBqHBj": {
          "type": "question",
          "settings": {
            "title": "What flying insects does it trap?",
            "answer": "<p>BuzzTrap goes after <strong>flies, fruit flies, gnats, moths, mosquitoes, wasps</strong>, and even some bees, perfect for keeping your home bug‑free.</p>"
          }
        },
        "question_VkdCB8": {
          "type": "question",
          "settings": {
            "title": "How does the subscription work?",
            "answer": "<p>Our subscription makes it <strong>effortless to keep your BuzzTrap running at full power</strong>.</p><ul><li><strong>Month 1:</strong> Get your BuzzTrap with a <strong>33% discount</strong>—starter glue pads included.</li><li><strong>After 30 days:</strong> We’ll <strong>automatically send you fresh refill packs</strong> for each trap you purchased, at just <strong>$15 per pack</strong>.</li><li><strong>You’re in control:</strong> <strong>Pause, delay, or cancel anytime</strong>—no fees, no hassle.</li></ul><p>It’s the easiest way to make sure your BuzzTrap stays effective, month after month.</p>"
          }
        },
