            "custom_liquid": "<style>\n  .review-wrapper {\n    margin-top: -10px;\n  }\n\n  .review-summary {\n    display: flex;\n    align-items: center;\n    gap: 8px;\n    font-weight: 600;\n    color: #212020;\n    font-size: 15px;\n    margin-bottom: -10px;\n    justify-content: flex-start;\n    text-align: left;\n    cursor: pointer;\n    text-decoration: none;\n  }\n\n  .review-stars {\n    color: #ffd000 !important;\n    font-size: 18px;\n    display: flex;\n    position: relative;\n    top: 2px;\n  }\n\n  .review-count {\n    font-size: 15px;\n    font-weight: 600;\n    color: #212020;\n  }\n\n  .review-link {\n    text-decoration: none;\n    display: inline-flex;\n    align-items: center;\n    gap: 8px;\n  }\n\n  .review-link:hover {\n    text-decoration: underline;\n  }\n</style>\n\n<div class=\"review-wrapper\">\n  <a href=\"#looxReviews\" class=\"review-link\">\n    <div class=\"review-summary\">\n      <div class=\"review-stars\">★★★★★</div>\n      <span>4.84</span>\n      <span class=\"review-count\">(121,357+ Buzz-Free Homes)</span>\n    </div>\n  </a>\n</div>",
