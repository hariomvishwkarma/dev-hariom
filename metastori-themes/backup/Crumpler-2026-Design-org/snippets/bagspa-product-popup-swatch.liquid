{% if variant.featured_image %}
    <span class="bpp-swatch-item {% if forloop_index == 1 %}active_swatch{% endif %}" media-id="{{ variant.featured_media.id }}" data-id="{{ variant.id }}">
        <img src="{{ variant.featured_image | image_url: width: 165 }}" height="auto" width="auto" alt="{{ variant.title }}">
    </span>
{% else %}
    <span class="bpp-swatch-item {% if forloop_index == 1 %}active_swatch{% endif %}" media-id="{{ product__image.id }}" data-id="{{ variant.id }}">
        <img src="{{ product__image | image_url: width: 165 }}" height="auto" width="auto" alt="{{ variant.title }}">
    </span>
{% endif %}