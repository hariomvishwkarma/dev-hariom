{% if variant.featured_image %}
    <div class="swiper-slide bpp-product-image" media-id="{{ variant.featured_media.id }}">
        <img src="{{ variant.featured_media | image_url }}" width="auto" height="auto" alt="{{ product.title }}">
    </div>  
{% else %}
    <div class="swiper-slide bpp-product-image" media-id="{{ product__image.id }}">
        <img src="{{ product__image | image_url }}" width="auto" height="auto" alt="{{ product.title }}">
    </div>
{% endif %}