<div class="cst-filters-row-overlay"></div>
<div class="cst-filters-row cst-filters-drawer">
    <div class="filter-drawer-main">
        <div class="filter-drawer-top">
            <div class="filter-drawer-header">
                <div class="mobile-filter-menu">
                    <div class="filter-drawer-1">
                        <div class="filter-drawer-count">
                            <span class="fillter--icon">{% render 'filter-icon' %}</span>
                            {% if total_active_filters > 0 %}
                            <span class="filter--count">({{ total_active_filters }})</span>
                            {% endif %}
                        </div>
                        <span class="fillter--productcount">{{ collection.products_count }} products</span>
                    </div>
                    <span class="fillter--close">CLOSE X</span>
                </div>
                {% comment %}
                <div class="mobile-filter-breadcrumb">
                {%assign menu = linklists['shop-menu'].links %}
                {%assign menu_second = linklists['main-menu'].links %}
                {% for link in menu %}
                    {% if link.active or link.child_active %}
                        <span class="mobile-breadcrumb-startpoint">SHOP</span>
                        <img src="https://cdn.shopify.com/s/files/1/0565/5114/5551/files/Screenshot_102.png?v=1762611259" alt="icon" width="auto" height="16px">
                        {{ link.title }}
                        {% if link.links != blank %}
                            {% for child_link in link.links %}
                                {% if child_link.active or child_link.child_active %}
                                    <img src="https://cdn.shopify.com/s/files/1/0565/5114/5551/files/Screenshot_102.png?v=1762611259" alt="icon" width="auto" height="16px">
                                    <span class="bd-child">{{ child_link.title }}</span>
                                    {% break %}
                                {% endif %}
                            {% endfor %}
                        {%endif %}
                    {% endif %}
                {% endfor %}
                {% for link in menu_second %}
                    {% if link.active or link.child_active %}
                        <span class="mobile-breadcrumb-startpoint">INFO</span>
                        <img src="https://cdn.shopify.com/s/files/1/0565/5114/5551/files/Screenshot_102.png?v=1762611259" alt="icon" width="auto" height="16px">
                        {{ link.title }}
                        {% if link.links != blank %}
                            {% for child_link in link.links %}
                                {% if child_link.active or child_link.child_active %}
                                    <img src="https://cdn.shopify.com/s/files/1/0565/5114/5551/files/Screenshot_102.png?v=1762611259" alt="icon" width="auto" height="16px">
                                    <span class="bd-child">{{ child_link.title }}</span>
                                    {% break %}
                                {% endif %}
                            {% endfor %}
                        {%endif %}
                    {% endif %}
                {% endfor %}
                </div>
                {% endcomment %}
            </div>
            {%- for filter in collection.filters -%}
                {% comment %} {% style %}
                button.cst-filter-label[data-filter-name="{{ filter.param_name }}"][aria-expanded="false"] ~ label[data-filter-name="{{ filter.param_name }}"]{
                    display:none;

                }
                button.cst-filter-label[data-filter-name="{{ filter.param_name }}"][aria-expanded="true"] ~ label[data-filter-name="{{ filter.param_name }}"]{
                    /* display:inline-block; */
                    display: inline-flex;
                    align-items: center;
                }
                {% endstyle %} {% endcomment %}
                <div class="cst-filter-btn cst-filter-{{ filter.label | downcase }}" role="filter-list" active_values="{{ filter.active_values | map: 'label' | join: ',' | downcase }}">
                
                <button
                type="button"
                class="cst-filter-label"
                data-filter-name="{{ filter.param_name }}"
                aria-expanded="{% if filter.label == 'Price' %}true{% else %}true{% endif %}"
                aria-controls="panel-{{ forloop.index }}"
                filter_name="{{ filter.label | handleize }}"
                {% if filter.label == 'Price' %}filter_toggle_disabled{% endif %}
                >
                <span style="color:#000;">
                    {{ filter.label }}
                </span>
                {% comment %} {% if filter.active_values.size > 0 %}
                    <div style="display:none;">
                    <span class="filter-seperator">:</span>
                    <div class="cst-values datavalue-{{ filter.label | downcase }}" active_values="{{ filter.active_values | map: 'label' | join: ',' | downcase }}">
                    {% for v in filter.active_values -%}
                        <span class="filter-lable" style="color:{{- v.label | downcase }};">
                        {{- v.label -}}
                        </span>
                        <span> </span>
                        {%- unless forloop.last %}, {% endunless -%}
                    {%- endfor %}
                    </div>
                    </div>
                {% endif %} 
                <span class="price_colun">:</span>
                {% endcomment %}
                {% comment %} {% if filter.label == 'Price' %}
                    <span class="price_colun">:</span>
                {% else %}
                    <span class="icon"> &gt;</span>
                {% endif %} {% endcomment %}
                </button>

                {% case filter.type %}
                {% when 'list' %}
                    {% for val in filter.values %}
                    <label data-filter-name="{{ filter.param_name }}" class="cst-checkbox {% if val.active %}checked{% endif %}">
                        <input type="checkbox" name="{{ val.param_name }}" value="{{ val.value }}"
                        {% if val.active %} checked {% endif %} data-count="{{ val.count }}"
                        >
                        {% comment %} {% assign val_color = val.label | strip | downcase %}
                        {% for color_item in all_colors %}
                        {% assign parts = color_item | split: ':' %}
                        {% assign color_name = parts.first | strip | downcase %}
                        {% assign color_hex = parts.last | strip %}
                        {% if color_name == val_color %}
                            {% assign val_color = color_hex %}
                        {% endif %}
                        {% endfor %} {% endcomment %}
                        <span class="cst-checkbox-label" {% comment %}style="color:{{ val_color }};"{% endcomment %}>
                        {{- val.label -}}
                        </span>
                        {% comment %} {%- unless forloop.last -%},{% endunless %}&nbsp;
                        {% if forloop.last %}
                        <span class="filter-seperation"></span>
                        {% endif %} {% endcomment %}
                    </label>
                    {% endfor %}

                {% when 'price_range' %}
                    <div class="cst-price-range-row" data-filter-name="{{ filter.param_name }}">
                    <div class="cst-price-range-label">
                        {{ filter.label }}
                        <span class="cst-price-range-value" currency="{{ cart.currency.symbol }}">
                            {% if filter.max_value.value %}
                                ({{ filter.max_value.value | money_without_trailing_zeros }})
                            {% else %}
                                ({{ filter.range_max | money_without_trailing_zeros }})
                            {% endif %}
                        </span>
                    </div>
                    <input type="range"
                        id="price_range_process"
                        min="{{- filter.min_value.value | divided_by: 100 -}}" 
                        max="{{- filter.range_max | divided_by: 100 -}}" 
                        value="{%- if filter.max_value.value -%}{{- filter.max_value.value | divided_by: 100 -}}
                            {%- else -%}{{- filter.range_max | divided_by: 100 -}}{%- endif -%}"
                        class="price_range_filter"
                        name="{{filter.max_value.param_name}}"
                    >
                    <div style="display:none;">
                        <label>
                            <input
                            type="number"
                            name="{{ filter.min_value.param_name }}"
                            placeholder="FROM"
                            value="{% if filter.min_value.value %}{{ filter.min_value.value | divided_by: 100 }}{% endif %}"
                            min="0"
                            max="{{ filter.range_max | divided_by: 100 }}"
                            class="price_range_filter"
                            >
                        </label>
                        <label>
                            <input
                            type="number"
                            name="{{filter.max_value.param_name}}"
                            placeholder="TO"
                            value="{% if filter.max_value.value %}{{ filter.max_value.value | divided_by: 100 }}{% endif %}"
                            min="0"
                            max="{{ filter.range_max | divided_by: 100 }}"
                            class="price_range_filter"
                            >
                        </label>
                        <button class="price_range_submit">
                            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="11" viewBox="0 0 14 11" fill="none">
                            <path d="M8.59167 0.351562L8.025 0.905729L12.0708 4.95573H0.25V5.7474H12.0708L8.025 9.80156L8.59167 10.3516L13.5833 5.35156L8.59167 0.351562Z" fill="white" stroke="white" stroke-width="0.5"/>
                            </svg>
                        </button>
                        </div>
                    </div>

                {% else %}

                {% endcase %}
                </div>
            {%- endfor -%}
        </div>
    

        <div class="cst-drawer-bottom">
            <button type="button" class="cst-apply-btn mobile">Apply Filters</button>
            <button type="button" class="cst-clear-btn mobile">Clear Filters</button>
        </div>
    </div>
</div>