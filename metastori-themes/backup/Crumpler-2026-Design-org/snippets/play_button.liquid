<a class="header-play-button" 
    href="{{ block.settings.link }}" 
    style="width:{{ block.settings.width }}%;"
    target="_blank" 
    onclick="openSmallWindow(event)"
>
    <span class="play_svg">
        <svg width="11" height="11" viewBox="0 0 11 11" fill="none" xmlns="http://www.w3.org/2000/svg">
            <path d="M10.5605 5.50052L0.934879 10.5948L0.934879 0.40625L10.5605 5.50052Z" fill="black"/>
        </svg>
    </span>
    {{ block.settings.text }}
</a>