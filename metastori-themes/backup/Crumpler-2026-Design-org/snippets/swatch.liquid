{% comment %}
  Renders a swatch component.
  Accepts:
  - swatch: {Object} a swatch object
  - option_value: {String} the option value for alt swatch matching
  - product: {Object} the product object for accessing metafields
  - alt_swatches: {Boolean} whether to check for alt swatches
  - shape: {String} swatch shape. Accepts 'square', defaults to circle.

  Usage:
  {% render 'swatch',
    swatch: value.swatch,
    option_value: value,
    product: product,
    alt_swatches: true,
    shape: 'square'
  %}
{% endcomment %}

{% assign swatch_value = null %}
{% if swatch.image %}
  {% assign image_url = swatch.image | image_url: width: 50 %}
  {% assign swatch_value = 'url(' | append: image_url | append: ')' %}
{% elsif swatch.color %}
  {% assign swatch_value = 'rgb(' | append: swatch.color.rgb | append: ')' %}
{% elsif alt_swatches %}
  {% for alt_swatch in product.metafields.alt.swatches.value %}
    {% assign option_value_down = option_value | downcase %}
    {% for name in alt_swatch.name.value %}
      {% assign name_down = name | downcase %}
      {% if option_value_down == name_down %}
        {% if alt_swatch.image %}
          {% assign image_url = alt_swatch.image | image_url: width: 50 %}
          {% assign swatch_value = 'url(' | append: image_url | append: ')' %}
        {% elsif alt_swatch.color %}
          {% assign swatch_value = alt_swatch.color %}
        {% endif %}
        {% break %}
      {% endif %}
    {% endfor %}
    {% comment %}
    {% assign names = alt_swatch.name | downcase %}
    {% if names contains option_value_down %}
      {% if alt_swatch.image %}
        {% assign image_url = alt_swatch.image | image_url: width: 50 %}
        {% assign swatch_value = 'url(' | append: image_url | append: ')' %}
      {% elsif alt_swatch.color %}
        {% assign swatch_value = alt_swatch.color %}
      {% endif %}
      {% break %}
    {% endif %}
     {% endcomment %}
  {% endfor %}
{% endif %}

<span
  data-color="{{ option_value }}"
  class="color-option {% if forloop.first %}active{% endif %} {% if active_swatch == option_value %}active{% endif %}"
  variant_colors="{{ variant_colors }}" meta_color="{{ variant_colors }}"
  style="
    {%- if swatch_value -%}
      {%- if swatch_value contains 'url' -%}
        background-image: {{- swatch_value -}};
      {%- else -%}
       background: {{- swatch_value -}};
      {%- endif -%}
    {%- else -%}
      background: {{- option_value -}};
    {%- endif -%}"
></span>
