{% if block.settings.menu != blank %}
    {%assign menu = block.settings.menu.links %}
    <div class="nav-menu-list-item">
        <span class="nav-menu-item-text">
            <span class="nav-menu-item-btn">
                <span class="nav-_menu_flex">{{ block.settings.text }}
                    {% if block.settings.icon != blank %}
                       <img src="{{ block.settings.icon | image_url }}" alt="icon" width="12px" height="14px"> 
                    {% endif %}
                </span>
                {%unless template.name == 'index' %}
                    {% for link in menu %}
                        {% if link.active or link.child_active %} 
                            <img class="menu-arrow-bd" width="auto" alt="icon" src="https://cdn.shopify.com/s/files/1/0565/5114/5551/files/arrow-right.png?v=1767432170" height="12px">
                            <span class="bd-child">{{ link.title }}</span>
                            {% if link.links != blank %}
                                {% for child_link in link.links %}
                                    {% if child_link.active or child_link.child_active %}
                                        <img class="menu-arrow-bd" width="auto" alt="icon" src="https://cdn.shopify.com/s/files/1/0565/5114/5551/files/arrow-right.png?v=1767432170" height="12px">
                                        <span class="bd-child">{{ child_link.title }}</span>
                                    {% endif %}
                                {% endfor %}
                            {%endif %}
                        {% endif %}
                    {% endfor %}
                {% endunless %}
                {% if template.name == 'product' and forloop_index == 1 %}
                    {% capture full_url %}{{ content_for_header }}{% endcapture %}
                    {% assign page_url = full_url | split:'"pageurl":"' | last | split:'"' | first | replace:'\/','/' | replace:'%20',' ' | replace:'\u0026','&' %}
                    {% if page_url contains 'collection=' %}
                        {% assign collection_handle = page_url | split: 'collection=' | last %}
                    {% endif %}
                    {% assign product_collection = product.collections[0] %}
                    {% if collection_handle %}
                        {% assign product_collection = collections[collection_handle] %}
                        {% if product_collection %}
                            <img class="menu-arrow-bd" width="auto" alt="icon" src="https://cdn.shopify.com/s/files/1/0565/5114/5551/files/arrow-right.png?v=1767432170" height="12px">
                            <a href="{{ product_collection.url }}" class="bd-child">{{ product_collection.title }}</a>    
                        {% endif %}
                    {% elsif product_collection %}
                        <img class="menu-arrow-bd" width="auto" alt="icon" src="https://cdn.shopify.com/s/files/1/0565/5114/5551/files/arrow-right.png?v=1767432170" height="12px">
                        <a href="{{ product_collection.url }}" class="bd-child">{{ product_collection.title }}</a>
                    {% endif %}
                {% endif %}
            </span>
            <ul class="nav-menu-wrapper">
                {% for link in menu %}
                    {% if link.links != blank %}
                        <li class="nav-second-child">
                            <span class="nav-menu-item-btn child-nav-item-btn">{{ link.title }}</span>
                            <ul class="nav-child-menu-wrapper">
                                {% for child_link in link.links %}
                                    <li class="nav-third-child">
                                        <a href="{{ child_link.url }}" class="nav-child-item-text">{{ child_link.title }}</a>
                                    </li>
                                {% endfor %}
                            </ul>
                        </li>
                    {% else %}
                        <li class="nav-second-child">
                            <a href="{{ link.url }}" class="nav-child-item-text">{{ link.title }}</a>
                        </li>
                    {% endif %}
                {% endfor %}
                {% if block.settings.image != blank %}
                    <img class='mega-menu-image' src="{{ block.settings.image | image_url }}" alt="mega-image" width="auto" height="auto">
                {% else %}
                    {{ block.settings.video | video_tag: controls: false, autoplay: true, loop: true, muted: true, class:'mega-menu-video' }}
                {%endif %}
            </ul>
        </span>
    </div>
{% else %}
    <div class="nav-menu-item">
        <a href="{{ block.settings.url }}" class="nav-menu-item-link">
            <span class="nav-_menu_flex">{{ block.settings.text }}
                {% if block.settings.icon != blank %}
                    <img src="{{ block.settings.icon | image_url }}" alt="icon" width="12px" height="14px"> 
                {% endif %}
            </span>
        </a>
    </div>
{% endif %}