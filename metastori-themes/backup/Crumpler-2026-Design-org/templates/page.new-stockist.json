            "new_store_block_XXAmpF": {
              "type": "_new-store-block",
              "name": "New Store",
              "settings": {
                "name": "Lo-Fi",
                "desc": "<p>Lo-Fi is a Perth-based label and retailer, first opened on Howard Street in 2014. Five years later, they expanded by opening a dedicated skate store across the street, creating two neighbouring spaces that bring together a considered mix of street and skate.<br/><br/>Lo-Fi has built a destination for people who care as much about culture and community as they do about the product.<br/><br/>Crumpler goods are now available exclusively at the Lo-Fi (East) store in Perth.<br/><br/>18 Howard Street, Perth WA 6000<br/><a href=\"https://www.instagram.com/lofi_store/\" target=\"_blank\" title=\"https://www.instagram.com/lofi_store/\">@lofi_store</a><br/><a href=\"https://lofistore.com.au/\" target=\"_blank\" title=\"https://lofistore.com.au/\">www.lofistore.com.au</a></p>"
