<div class="cst-country-block">
    <option class="cst-country-name">{{ block.settings.name }}</option>
    <ol class="cst-country-stores">
        {% content_for 'blocks' %}
    </ol>
</div>

{% schema %}
{
    "name": "New Country",
    "tag": null,
    "class": "cst-country-block",
    "settings": [
        {
            "type": "text",
            "id": "name",
            "label": "Country Name"
        }
    ],
    "blocks": [
        {
            "type": "_new-store-block"
        },
        {
            "type": "_new-stores-location"
        }
    ],
    "presets": [
        {
            "name": "New Country"
        }
    ]
}
{% endschema %}