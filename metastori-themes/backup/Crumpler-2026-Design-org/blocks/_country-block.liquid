<div
  class="store-page__country"
  data-block-id="{{ block.id }}"
  no-arrow
>
  <h2
    class="store-page__store-name c-link c-h3 {% if block.settings.details == blank %}store-page__store-name--disabled{% endif %}"
    slot="header"
  >
    {{ block.settings.name }}
  </h2>
</div>
{% content_for 'blocks' %}

{% schema %}
  {
    "name": "Country",
    "settings": [
      {
        "type": "text",
        "id": "name",
        "label": "Country Name"
      }
    ],
    "blocks": [
      {
        "type": "_stockist-block"
      },
      {
        "type": "_store-block"
      }
    ],
    "presets": [
      {
        "name": "Country"
      }
    ]
  }
{% endschema %}