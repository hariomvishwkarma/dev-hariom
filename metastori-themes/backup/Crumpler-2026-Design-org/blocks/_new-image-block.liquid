<div class="swiper-slide">
    <div class="cst-image-block">
        {% if block.settings.link != blank %}
            <a href="{{ block.settings.link }}" class="overlay-link"></a>
          {% endif %}
        <img class="cst-image" src="{{ block.settings.img | img_url:'original' }}" width="100%" height="auto" />
    </div>
</div>

{% schema %}
{
    "name": "New Store",
    "tag":null,
    "class": "cst-image-block",
    "settings": [
        {
            "type":"image_picker",
            "id": "img",
            "label": "Image"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Media link"
        },
    ],
    "presets": [
        {
            "name": "New Image"
        }
    ]
}
{% endschema %}