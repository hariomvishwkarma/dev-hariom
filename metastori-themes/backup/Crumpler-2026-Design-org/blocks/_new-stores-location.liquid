<li class="cst-store-block cst-accordion">
    <div class="cst-store-name cst-accordion-title">{{ block.settings.name }}</div>
    <div class="cst-accordion-content">
        <ol class="cst-country-stores">
            {% content_for 'blocks' %}
        </ol>
    </div>
</li>

{% schema %}
{
    "name": "Store",
    "tag": null,
    "class": "cst-store-block",
    "settings": [
        {
            "type": "text",
            "id": "name",
            "label": "Location Name"
        },
    ],
    "blocks": [
        {
            "type": "_new-store"
        }
    ],
    "presets": [
        {
            "name": "Stores Location"
        }
    ]
}
{% endschema %}