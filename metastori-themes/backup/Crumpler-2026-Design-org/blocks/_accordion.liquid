<div class="cst-accordion">
    {% if block.settings.title != blank %}
        <div class="cst-accordion-title">
            {{ block.settings.title }}
            <span class="cst-accordion-toggle">+</span>
        </div>
        <div class="cst-accordion-content">
            <div class="cst-content-box">
                {% if block.settings.description != blank %}
                    <div class="cst-content">{{ block.settings.description }}</div>
                {% endif %}
                {% if block.settings.video != blank or block.settings.image != blank  %}
                    {% if block.settings.media_type == 'video' %}
                        <div class="cst-media">
                            <video autoplay loop playsinline muted crossorigin="anonymous" preload="metadata" poster="{{ block.settings.video.preview_image.src }}">
                                {% for source in block.settings.video.sources %}
                                    <source src="{{ source.url }}" type="{{ source.mime_type }}">
                                {% endfor %}
                            </video>
                        </div>
                    {% else %}
                        <div class="cst-media">
                            <img src="{{ block.settings.image | img_url:'400x500x' }}" width="100%" height="100%">
                        </div>
                    {% endif %}
                {% endif %}
            </div>
        </div>
    {% endif %}
</div>

{% schema %}
{
    "name": "Accordion",
    "tag":null,
    "class": "cst-accordion",
    "settings": [
        {
            "type": "text",
            "id": "title",
            "label": "Title"
        },
        {
            "type":"richtext",
            "label": "description",
            "id": "description"
        },
        {
            "type":"checkbox",
            "label": "show image/video",
            "id": "show_media",
            "default":true
        },
        {
            "type": "select",
            "id": "media_type",
            "label": "media type",
            "options": [
                {
                    "label": "Video",
                    "value": "video"
                },
                {
                    "label": "Image",
                    "value": "image"
                },
            ],
            "default":"video"
        },
        {
            "type": "video",
            "id": "video",
            "label": "Video",
            "visible_if": "{{ block.settings.media_type == 'video' }}"
        },
        {
            "type": "image_picker",
            "id": "image",
            "label": "Image",
            "visible_if": "{{ block.settings.media_type == 'image' }}"
        } 
    ],
    "presets": [
        {
            "name": "Accordion"
        }
    ]
}
{% endschema %}