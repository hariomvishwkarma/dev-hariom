<style>
  .absolute_image_layout_main , .absolute_image_layout_relative{
    position:relative;
    width:100%;
    overflow: hidden;
  }
  .absolute_image_item img{
    max-width:100%;
  }
  .absolute_image_item{
    position: absolute;
    transform: translate(-50%, -50%);
  }
  @media (min-width:1026px){
    .absolute_image_layout_{{ section.id }}{
      min-height:{{section.settings.height_desktop}}px;
    }
    {% for block in section.blocks %}
      .absolute_image_item_{{ block.id }}{
        left:{{block.settings.left}}%;
        top:{{block.settings.top}}%;
        width:{{block.settings.width}}px;
        z-index: {% if block.settings.overlay_on_text == true %}1{% else %}0{% endif %};
      }
    {% endfor %}
  }
  @media (max-width:1024px){
    .absolute_image_layout_{{ section.id }}{
      min-height:{{section.settings.height_mobile}}px;
    }
    {% for block in section.blocks %}
      .absolute_image_item_{{ block.id }}{
        left:{{block.settings.left}}%;
        top:{{block.settings.top}}%;
        width:{{block.settings.width_mobile}}px;
        z-index: {% if block.settings.overlay_on_text == true %}1{% else %}0{% endif %};
      }
    {% endfor %}
  }
</style>

<div class="absolute_image_layout_main">

  <div class="absolute_image_layout_relative absolute_image_layout_{{ section.id }}">
    {% for block in section.blocks %}
      <div class="absolute_image_item absolute_image_item_{{ block.id }}">
        {% if block.settings.link != blank %}<a href="{{ block.settings.link }}">{% endif %}
          <img class="absolute_image_img" src="{{ block.settings.image | image_url }}" width="auto" height="auto">
        {% if block.settings.link != blank %}</a>{% endif %}
      </div>
    {% endfor %}
  </div>
  
</div>

{% schema %}
  {
    "name": "Absolute Image Layout",
    "settings": [
      {
        "type": "number",
        "id": "height_desktop",
        "label": "Section Height",
        "info": "Height set in px.",
        "default":500
      },
      {
        "type": "number",
        "id": "height_mobile",
        "label": "Section Height - Mobile",
        "info": "Height set in px.",
        "default":500
      }
    ],
    "blocks": [
      {
        "type": "image",
        "name":"Image",
        "settings": [
          {
            "type": "image_picker",
            "id": "image",
            "label": "Image"
          },
          {
            "type": "number",
            "id":"width",
            "label": "Image Width",
            "info": "Width set in px."
          },
          {
            "type": "number",
            "id":"width_mobile",
            "label": "Image Width - Mobile",
            "info": "Width set in px."
          },
          {
            "type":"url",
            "id":"link",
            "label":"URL"
          },
          {
            "type":"checkbox",
            "id":"overlay_on_text",
            "label":"Overlay On Content?",
            "default":true
          },
          {
            "type": "header",
            "content": "Image Position"
          },
          {
            "type": "range",
            "id":"left",
            "min": 1,
            "max": 100,
            "step": 1,
            "unit": "%",
            "default":50,
            "label": "Horizontal"
          },
          {
            "type": "range",
            "id":"top",
            "min": 1,
            "max": 100,
            "step": 1,
            "unit": "%",
            "default":50,
            "label": "Vertical"
          }
        ]
      }
    ],
    "presets": [
      {
        "name": "Absolute Image Layout"
      }
    ]
  }
{% endschema %}