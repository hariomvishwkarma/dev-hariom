        </div>
      </div>
      <div class="popup_items popup_content">
        {% for block in section.blocks %}
            {% if block.settings.position == 'shipping_return' %}
                <div class="child_icon_main absolute_item child_icon_main_{{ block.id }}">
                  <div class="child_icon_item" query_handle="{{ block.settings.query_handle | handleize }}" popup_id="{{ block.id }}">
                    {% if block.settings.icon_link != blank %}<a class="child_icon_img" href="{{ block.settings.icon_link }}">{% else %}<div class="child_icon_img">{% endif %}
                      <img src="{{ block.settings.icon | image_url }}" width="auto" height="auto">
                    {% if block.settings.icon_link != blank %}</a>{% else %}</div>{%endif %}
                    <span class="child_icon_text">{{ block.settings.text }}</span>
