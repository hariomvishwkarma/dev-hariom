<script src="https://code.jquery.com/jquery-3.7.1.min.js" integrity="sha256-/JqT3SQfawRcv/BIHPThkBvs0OEvtFFmqPF/lYI/Cxo=" crossorigin="anonymous"></script>
<script src="https://code.jquery.com/ui/1.12.1/jquery-ui.min.js"></script>
{{ 'windows-theme-layout.css' | asset_url | stylesheet_tag }}
{{ 'windows-theme-layout.js' | asset_url | script_tag }}
{% for block in section.blocks %}
  {% capture desktop_css %}{{ desktop_css }}
    .child_icon_main_{{ block.id }}{
      left:{{ block.settings.horizontal_position }}%;
      top:{{ block.settings.vertical_position }}%;
    }
  {% endcapture %}
  {% capture mobile_css %}{{ mobile_css }}
    .child_icon_main_{{ block.id }}{
      left:{{ block.settings.horizontal_position_m }}%;
      top:{{ block.settings.vertical_position_m }}%;
    }
  {% endcapture %}
  {% if block.settings.position == 'shipping_return' %}{% assign shipping_box = true %}{% endif %}
  {% if block.settings.position == 'faq' %}{% assign faq_box = true %}{% endif %}
{% endfor %}
{% style %}
  @media (min-width:768px){
    {{desktop_css}}
    .faq_folder_main{
      left:{{section.settings.faq_horizontal}}%;
      top:{{section.settings.faq_vertical}}%;
    }
    .shipping_folder_main{
      left:{{section.settings.sr_horizontal}}%;
      top:{{section.settings.sr_vertical}}%;
    }
    .solitaire_win_main{
      left:{{section.settings.solitaire_horizontal}}%;
      top:{{section.settings.solitaire_vertical}}%;
    }
    .paint_win_main{
      left:{{section.settings.paint_horizontal}}%;
      top:{{section.settings.paint_vertical}}%;
    }
    .flip_main_container{
      left:{{section.settings.flip_horizontal}}%;
      top:{{section.settings.flip_vertical}}%;
    }
  }
  @media (max-width:767px){
    {{mobile_css}}
    .faq_folder_main{
      left:{{section.settings.faq_horizontal_m}}%;
      top:{{section.settings.faq_vertical_m}}%;
    }
    .shipping_folder_main{
      left:{{section.settings.sr_horizontal_m}}%;
      top:{{section.settings.sr_vertical_m}}%;
    }
    .solitaire_win_main{
      left:{{section.settings.solitaire_horizontal_m}}%;
      top:{{section.settings.solitaire_vertical_m}}%;
    }
    .paint_win_main{
      left:{{section.settings.paint_horizontal_m}}%;
      top:{{section.settings.paint_vertical_m}}%;
    }
    .flip_main_container{
      left:{{section.settings.flip_horizontal_m}}%;
      top:{{section.settings.flip_vertical_m}}%;
    }
  }
{% endstyle %}

<div class="windows_layout_main" style="background:{{ section.settings.bg_color }};">

  <div class="windows_layout_main_relative">
    
      <div class="faq_folder_main absolute_item {% if section.settings.enable_drag %}main_item_draggable {% endif %}">
          <div class="faq_icon popup_btn item_box" query_handle="faq" popup_id='faq_popup'>
            <div class="faq_main_img">
              <img src="https://cdn.shopify.com/s/files/1/0565/5114/5551/files/directory_closed-3.png?v=1738223296" width="auto" height="auto">
            </div>
            <span class="popup_btn_text">FAQ</span>
          </div>
      </div>
      {% if faq_box == true %}
      <div class="popup_main info_popup" popup__id='faq_popup'>
        <div class="popup_header">
          <div class="popup_header_title">
            <img src="https://cdn.shopify.com/s/files/1/0565/5114/5551/files/directory_closed-3.png?v=1738223296" width="22px" height="22px"/>
            <span class=popup_header_title_text>FAQ</span>
          </div>
          <div class="popup__close main_close" query_handle="faq">
