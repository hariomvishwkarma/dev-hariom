                    </div>
                    {% endcapture %}
                </div>
            {% endif %}
        {% endfor %}
      </div>
    </div>
    {% endif %}
    

    {% if section.settings.solitaire_enable == true %}
      <div class="solitaire_win_main absolute_item {% if section.settings.enable_drag %}main_item_draggable {% endif %}">
        <div class="item_box solitaire_win_btn">
          <div class="faq_main_img">
            <img src="https://cdn.shopify.com/s/files/1/0565/5114/5551/files/image_27.png?v=1738225938" width="auto" height="auto">
          </div>
        </div>
        {{ 'solitaire_win_animation.js' | asset_url | script_tag }}
      </div>
      <div class="solitary_popup" style="background:{{ section.settings.bg_color }};">
        <canvas id="laggyCanvas" width="800" height="600"></canvas>
        <div class="error_popup">
          <div class="error_heading">Error</div>
          <div class="error_content">
            <svg xmlns="http://www.w3.org/2000/svg" xmlns:xlink="http://www.w3.org/1999/xlink" width="51" height="51" viewBox="0 0 51 51" fill="none"> <rect x="0.714355" y="0.285645" width="50.2857" height="50.2857" fill="url(#pattern0_2509_4679)"/> <defs> <pattern id="pattern0_2509_4679" patternContentUnits="objectBoundingBox" width="1" height="1"> <use xlink:href="#image0_2509_4679" transform="scale(0.0078125)"/> </pattern> <image id="image0_2509_4679" width="128" height="128" xlink:href="data:image/png;base64,"/> </defs> </svg>
            <span>Please refresh the page</span>
          </div>
        </div>
      </div>
    {% endif %}

    {% if section.settings.paint_enable == true %}
      <div class="paint_win_main absolute_item {% if section.settings.enable_drag %}main_item_draggable {% endif %}">
        <div class="item_box paint_win_btn">
          <div class="faq_main_img">
            <img src="https://cdn.shopify.com/s/files/1/0565/5114/5551/files/Paint-1.png?v=1738229376" width="auto" height="auto">
          </div>
        </div>
      </div>
      <div class="paint_popup info_popup">
        <div class="popup_header">
          <div class="popup_header_title">
            <img src="https://cdn.shopify.com/s/files/1/0565/5114/5551/files/Paint-1.png?v=1738229376" width="22px" height="22px"/>
            <span class=popup_header_title_text>PAINT</span>
