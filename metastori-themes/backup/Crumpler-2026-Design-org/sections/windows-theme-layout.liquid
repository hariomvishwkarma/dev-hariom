                              </div>
                            </div>
                            <div class="child_icon_popup_content popup_content">
                              {{ block.settings.content }}
                            </div>
                          </div>
                        {% endcapture %}
                  </div>
              {% endif %}
          {% endfor %}
        </div>
      </div>
      {% endif %}

    <div class="shipping_folder_main absolute_item {% if section.settings.enable_drag %}main_item_draggable {% endif %}">
          <div class="faq_icon popup_btn item_box" query_handle="shipping_returns" popup_id='shipping_popup'>
            <div class="faq_main_img">
              <img src="https://cdn.shopify.com/s/files/1/0565/5114/5551/files/directory_closed-3.png?v=1738223296" width="auto" height="auto">
            </div>
            <span class="popup_btn_text">SHIPPING & RETURNS</span>
