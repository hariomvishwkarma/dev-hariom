<style>
@media (min-width:768px){
    .vbo-heading{
        font-size:{{ section.settings.heading_size }};
    }
    .image-block-overlay-main {
        height: {{ section.settings.desktop_height }}vh;
    }
}
@media (max-width:767px){
    .vbo-heading{
        font-size:{{ section.settings.heading_size_m }};
    }
    .image-block-overlay-main {
        height: {{ section.settings.mobile_height }}vh;
    }
}

.vbo-wrapper img {
    max-width: 100%;
    width: 100%;
}
.vbo-wrapper {
    position: relative;
    width: 100%;
    height: 100%;
    overflow: hidden;
}
.vbo-overlay-content {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
}
.vbo-overlay-video video{
    width: 374px;
}
.vbo-overlay-video img {
    width: 320px;
    height: 320px;
    object-fit: cover;
}
.vbo-heading {
    position: absolute;
    top: 60%;
    left: 50%;
    transform: translate(-50%, -50%);
    text-align: center;
    width: max-content;
    font-weight: 500;
}
.vbo-bg-image{
    display:flex;
}
/* Floating image container */
.flier img {
    position: absolute;
    overflow: hidden;
    top: 0;
    left: 0;
    width: 200px;
    height: auto;
    pointer-events: none;
    z-index: 99999;
    animation: fly 50s linear infinite;
    }

/* Flying animation path */
@keyframes fly {
    0%, 98.001% {
        transform: translateX(-200%) translateY(100vh) rotateZ(0deg);
    }

    15% {
        transform: translateX(100vw) translateY(-120%) rotateZ(180deg);
    }

    15.001%, 18% {
         transform: translateX(100vw) translateY(-30%) rotateZ(0deg);
    }

    40% {
        transform: translateX(-200%) translateY(3vh) rotateZ(-180deg);
    }

    40.001%, 43% {
        transform: translateX(-200%) translateY(-120%) rotateZ(-180deg);
    }

    65% {
        transform: translateX(100vw) translateY(50vh) rotateZ(0deg);
    }

    65.001%, 68% {
        transform: translateX(20vw) translateY(-200%) rotateZ(180deg);
    }

    95% {
        transform: translateX(10vw) translateY(100vh) rotateZ(0deg);
    }
}
</style>
<div class="image-block-overlay-main">
    <div class="vbo-wrapper">
        {% if section.settings.bg_image != blank %}
            <div class="vbo-bg-image flier">
                <img src="{{ section.settings.bg_image | image_url }}" alt="image" width="auto" height="auto">
            </div>
        {% endif %}
        <div class="vbo-overlay-content">
            <div class="vbo-overlay-video">
                {% if section.settings.overlay_media_type == 'video' %}
                    {{ section.settings.overlay_video | video_tag:autoplay:true, loop:true, controls:false }}
                {% else %}  
                    <img src="{{ section.settings.overlay_image | image_url }}" width="auto" height="auto" alt="">
                {% endif %}
            </div>
            {% if section.settings.heading != blank %}
                <div class="vbo-heading">{{ section.settings.heading }}</div>
            {% endif %}
        </div>
    </div>
</div>

{% schema %}
{
  "name": "BagSpa - Double Video",
  "tag": "section",
  "class": "section",
  "settings": [
    {
        "type": "image_picker",
        "id": "bg_image",
        "label": "Floating image"
    },
    {
        "type": "header",
        "content": "Overlay content"
    },
    {
        "type": "select",
        "id": "overlay_media_type",
        "label": "Media type",
        "options": [
            {
                "label": "Video",
                "value": "video"
            },
            {
                "label": "Image",
                "value": "image"
            },
        ],
        "default":"video"
    },
    {
        "type": "video",
        "id": "overlay_video",
        "label": "Video",
        "visible_if": "{{ section.settings.overlay_media_type == 'video' }}"
    },
    {
        "type": "image_picker",
        "id": "overlay_image",
        "label": "Image",
        "visible_if": "{{ section.settings.overlay_media_type == 'image' }}"
    },
    {
        "type": "textarea",
        "id": "heading",
        "label": "Heading"
    },
    {
        "type": "select",
        "id": "heading_size",
        "label": "Font Size",
        "options": [
            {
                "label": "S",
                "value": "13px"
            },
            {
                "label": "M",
                "value": "26px"
            },
            {
                "label": "L",
                "value": "36px"
            },
            {
                "label": "XL",
                "value": "50px"
            },
            {
                "label": "XXL",
                "value": "134px"
            }
        ],
        "default":"26px"
    },
    {
        "type": "select",
        "id": "heading_size_m",
        "label": "Font Size (Mobile)",
        "options": [
            {
                "label": "S",
                "value": "13px"
            },
            {
                "label": "M",
                "value": "26px"
            },
            {
                "label": "L",
                "value": "36px"
            },
            {
                "label": "XL",
                "value": "50px"
            },
            {
                "label": "XXL",
                "value": "134px"
            }
        ],
        "default":"26px"
    },
    {
        "type": "header",
        "content": "Section height"
    },
    {
        "type": "range",
        "id":"desktop_height",
        "min": 20,
        "max": 100,
        "step": 5,
        "unit": "%",
        "default":90,
        "label": "Desktop height"
    },
    {
        "type": "range",
        "id":"mobile_height",
        "min": 20,
        "max": 100,
        "step": 5,
        "unit": "%",
        "default":90,
        "label": "Mobile height"
    },
  ],
  "presets": [
    {
      "name": "BagSpa - Double Video"
    }
  ]
}
{% endschema %}
