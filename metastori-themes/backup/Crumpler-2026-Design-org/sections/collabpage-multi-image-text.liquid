            {
                "label": "S",
                "value": "13px"
            },
            {
                "label": "M",
                "value": "26px"
            },
            {
                "label": "L",
                "value": "36px"
            },
            {
                "label": "XL",
                "value": "50px"
            },
            {
                "label": "XXL",
                "value": "134px"
            }
        ],
        "default":"26px"
    },
    {
        "type": "header",
        "content": "Content"
    },
    {
        "type": "textarea",
        "id": "content",
        "label": "Content",
        "default":"Ontion of Yyur informatio please be aware that no security measures are perfect or impenetrable, and we cannot guarantee “perfect sec. Ontion of Yyur informatio please be aware that no security measures are perfect."
    },
    {
        "type": "select",
        "id": "content_size",
        "label": "Font Size",
        "options": [
            {
                "label": "S",
                "value": "13px"
            },
            {
                "label": "M",
                "value": "26px"
            },
            {
                "label": "L",
                "value": "36px"
            },
            {
                "label": "XL",
                "value": "50px"
            },
            {
                "label": "XXL",
                "value": "134px"
            }
        ],
        "default":"13px"
    },
    {
        "type": "select",
        "id": "content_size_m",
        "label": "Font Size (Mobile)",
        "options": [
            {
                "label": "S",
                "value": "13px"
            },
            {
                "label": "M",
                "value": "26px"
            },
            {
                "label": "L",
                "value": "36px"
            },
            {
                "label": "XL",
                "value": "50px"
            },
            {
                "label": "XXL",
                "value": "134px"
            }
        ],
        "default":"13px"
    }
  ],
  "blocks": [
    {
        "type": "media",
        "name":"Media",
        "settings":[
            {
                "type": "image_picker",
                "id":"image",
                "label": "Image"
            },
            {
                "type": "header",
                "content": "OR"
            },
            {
                "type": "video",
                "id":"video",
                "label": "Video"
            }
        ]
    }
  ],
  "presets": [
    {
      "name": "Collabpage Multi-Image-Text"
    }
  ]
