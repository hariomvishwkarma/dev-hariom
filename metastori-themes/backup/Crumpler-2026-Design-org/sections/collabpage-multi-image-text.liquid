<style>
.{{ section.id }} .cmit-heading{
    margin:0;
    line-height:normal;
    color:{{ section.settings.text_color }};
    margin-bottom: 5px;
    font-weight: 700;
} 
.{{ section.id }} .cmit-info{
    margin:0;
    line-height:normal;
    color:{{ section.settings.text_color }};
}
.cmit-images img, .cmit-images video {
    max-width: 100%;
    width: 100%;
    height: 100%;
}
.cmit-images, .cmit-media-item {
    display: flex;
}
.cmit-wrapper {
    display: flex;
    flex-wrap: wrap;
    padding-bottom: 51px;
}
.cmit-info {
    padding: 21px 16px 0 19px;
}
@media (min-width:768px){
    {{ desktop_css }}
    .{{ section.id }} .cmit-heading{
        font-size:{{ section.settings.heading_size }};
    }
    .{{ section.id }} .cmit-content{
        font-size:{{ section.settings.content_size }};
    }
    .cmit-images {
        width: 73.5%;
    }
    .cmit-info {
        width: 26.5%;
    }
}
@media (max-width:767px){
    {{ mobile_css }}
    .{{ section.id }} .cmit-heading{
        font-size:{{ section.settings.heading_size_m }};
    }
    .{{ section.id }} .cmit-content{
        font-size:{{ section.settings.content_size_m }};
    }
}
</style>

<div class="collabpage-multi-image-text {{ section.id }}" style="background:{{ section.settings.bg_color }};">    
    <div class="cmit-wrapper">
        <div class="cmit-images">
            {% for block in section.blocks %}
                <div class="cmit-media-item cmit-media-item-{{ block.id }}">
                    {% if block.settings.image != blank %}
                        <img class="cmit-desktop-img" src="{{ block.settings.image | image_url }}" width="auto" height="auto" alt="image-{{ block.settings.image.alt }}">
                    {% elsif block.settings.video != blank %}
                        {{ block.settings.video | video_tag:autoplay:true, loop:true, controls: false, muted:true,class:'cmit-desktop-video' }}
                    {% else %}
                        {{ 'detailed-apparel-1' | placeholder_svg_tag: 'placeholder-svg' }}
                    {% endif %}
                </div>
            {% endfor %}
        </div>
        <div class="cmit-info">
            {% if section.settings.heading != blank %}
                <h2 class="cmit-heading">{{ section.settings.heading }}</h2>
            {% endif %}
            {% if section.settings.content != blank %}
                <div class="cmit-content">{{ section.settings.content }}</div>
            {% endif %}
        </div>
    </div>
</div>

{% schema %}
{
