<script>
  // Collection Page JavaScript
  document.addEventListener('DOMContentLoaded', function () {
    initializeCollectionPage();
  });

  function initializeCollectionPage() {
    VariantSliderInit();
    initFilterSystem();
    initMobileFilterToggle();
    setupPanelOpenClose();
  }

  // Variant Slider Functionality
  function VariantSliderInit() {
    document.querySelectorAll('#cst-grid.cst-product-card').forEach(function (card) {
      const mainSliderEle = card.querySelector('.cst-main-slider');
      const swatchSliderEle = card.querySelector('.cst-swatch-slider');
      const swatchPrice = card.querySelector('.cst-product-price');

      if (!mainSliderEle || !swatchSliderEle) return;

      const mainSwiper = new Swiper(mainSliderEle, {
        slidesPerView: 1,
        spaceBetween: 0,
        allowTouchMove: true,
        simulateTouch: true, // allows mouse drag as swipe on desktop
        cssMode: false,
        mousewheel: {
          invert: false,
          forceToAxis: true,
        },
        on: {
          slideChange: function () {
            setSwatchActive(mainSwiper.activeIndex);
          },
        },
      });

      const swatchSwiper = new Swiper(swatchSliderEle, {
        slidesPerView: 'auto',
        //slidesPerView: 7,
        breakpoints: {
          0: {
            slidesPerView: 4,
            spaceBetween: 2,
          },
          425: {
            slidesPerView: 5,
            spaceBetween: 4.4,
          },
          768: {
            slidesPerView: 6,
            spaceBetween: 4.4,
          },
          1200: {
            slidesPerView: 10,
            spaceBetween: 4.4,
          },
        },
        navigation: {
          nextEl: card.querySelector('.cst-swatch-next'),
          prevEl: card.querySelector('.cst-swatch-prev'),
        },
      });

      swatchSwiper.slides.forEach((slideEl, idx) => {
        slideEl.addEventListener('mouseenter', () => {
          mainSwiper.slideTo(idx, 500);
          setSwatchActive(idx);
        });
      });

      function setSwatchActive(activeIndex) {
        swatchSwiper.slides.forEach((slide, index) => {
          slide.classList.toggle('cst-active', index === activeIndex);
          if(index === activeIndex){
            const swatch_price = slide.getAttribute('price');
            swatchPrice.textContent = swatch_price;
          }
        });
      }

      setSwatchActive(0);
    });
  }

  // Filter System
  function initFilterSystem() {
    const filterSection = document.getElementById('main-collection-filters');
    if (!filterSection) return;

    const form = document.getElementById('CSTFacetForm');
    const sectionId = filterSection.dataset.sectionId || '{{ section.id }}';
    const productGridContainer = document.getElementById('ProductGridContainer');

    // Create search params from form
    function createSearchParamsFromForm(formEl) {
      const formData = new FormData(formEl);
      return new URLSearchParams(formData).toString();
    }

    function mergeSearchParams(newParams = '') {
      const url = new URL(window.location.href);
      const currentParams = new URLSearchParams(url.search);
      const incomingParams = new URLSearchParams(newParams);

      incomingParams.forEach((value, key) => {
        currentParams.set(key, value);
      });

      return currentParams.toString();
    }


    // Fetch and update section
    async function fetchAndUpdateSection(searchParams = '') {
      try {
        const loadingOverlay = document.querySelectorAll('#ProductCount');
        loadingOverlay.forEach(k=>k.textContent = 'Loading...');

        const mergedParams = mergeSearchParams(searchParams);

        const url = `/search?${mergedParams}`;
        const response = await fetch(url);
        const text = await response.text();
        const parser = new DOMParser();
        const doc = parser.parseFromString(text, 'text/html');

        // Update product grid
        const newGrid = doc.getElementById('ProductGridContainer');
        if (newGrid && productGridContainer) {
          productGridContainer.innerHTML = newGrid.innerHTML;
        }

        if (!newGrid) gravityFilters();

        // Update filters section
        const newFilters = doc.getElementById('main-collection-filters');
        if (newFilters) {
          filterSection.innerHTML = newFilters.innerHTML;
          // Reinitialize filter functionality
          initFilterSystem();
          setupPanelOpenClose();
          initMobileFilterToggle();
        }
        const productGrid = doc.querySelector('#product-grid');
        const hasProducts = productGrid && productGrid.querySelectorAll('li').length > 0;
        // Trigger gravity effect if no products

        if (!hasProducts) {
          setTimeout(() => {
            gravityFilters();
          }, 100);
        }
        // Update URL
        history.pushState(
          { searchParams: mergedParams },
          '',
          `${window.location.pathname}?${mergedParams}`
        );

        // Reinitialize sliders
        VariantSliderInit();
      } catch (error) {
        console.error('Error updating collection:', error);
      }
    }

    // Debounce function
    function debounce(func, wait) {
      let timeout;
      return function executedFunction(...args) {
        const later = () => {
          clearTimeout(timeout);
          func(...args);
        };
        clearTimeout(timeout);
        timeout = setTimeout(later, wait);
      };
    }

    // Handle form changes
    const handleFormChange = debounce(function (event) {
      const searchParams = createSearchParamsFromForm(form);
      fetchAndUpdateSection(searchParams);
    }, 300);

    // Add event listeners to form inputs
    form.querySelectorAll('input, select').forEach((input) => {
      input.addEventListener('change', handleFormChange);
    });

    // Clear filters
    const clearButtons = document.querySelectorAll('#CSTClearFilters');
    if (clearButtons) {
      clearButtons.forEach((clearButton) => {
        clearButton.addEventListener('click', function (e) {
          e.preventDefault();
          form.reset();
          const url = new URL(window.location.href);
          const params = new URLSearchParams(url.search);

          [...params.keys()].forEach((key) => {
            if (
              key.startsWith('filter.') ||
              key.startsWith('filter[')
            ) {
              params.delete(key);
            }
          });

          url.search = params.toString();
          history.pushState({}, '', url.toString());

          fetchAndUpdateSection(params.toString());
        });
      });
    }


    // Handle browser back/forward
    window.addEventListener('popstate', function (event) {
      const searchParams = window.location.search.replace(/^\?/, '');
      if (searchParams) {
        // Update form to match URL parameters
        const urlParams = new URLSearchParams(searchParams);
        updateFormFromParams(urlParams);
        fetchAndUpdateSection(searchParams);
      } else {
        form.reset();
        fetchAndUpdateSection('');
      }
    });

    function updateFormFromParams(urlParams) {
      // Reset all inputs first
      form.querySelectorAll('input[type="checkbox"]').forEach((cb) => (cb.checked = false));
      form.querySelectorAll('input[type="number"]').forEach((input) => (input.value = ''));
      form.querySelectorAll('input[type="radio"]').forEach((radio) => (radio.checked = false));

      // Set values from URL params
      urlParams.forEach((value, key) => {
        const inputs = form.querySelectorAll(`[name="${key}"]`);
        inputs.forEach((input) => {
          if (input.type === 'checkbox' || input.type === 'radio') {
            input.checked = input.value === value;
          } else {
            input.value = value;
          }
        });
      });
    }
  }

  // Mobile Filter Toggle
  function initMobileFilterToggle() {
    const filterToggle = document.querySelector('.cst-filters-container b');
    const closeBtn = document.querySelector(' #main-collection-filters .cst-filters-row .fillter--close');
    const filtersRow = document.querySelector('.cst-filters-row');
    if (!filterToggle || !filtersRow) return;

    {% comment %} function toggleMobileFilters() {
      if (window.innerWidth <= 1024) {
        const isVisible = filtersRow.style.display === 'flex' || filtersRow.style.display === 'inline-block';
        filtersRow.style.display = isVisible ? 'none' : 'inline-block';
        setTimeout(() => {
          isVisible ? filtersRow.classList.remove('open') : filtersRow.classList.add('open');
        }, 500);
        // Toggle mobile icons
        const mobileIcon = filterToggle.querySelector('.mobile-icon');
        const mobileIconOpen = filterToggle.querySelector('.mobile-icon-open');

        if (mobileIcon && mobileIconOpen) {
          if (isVisible) {
            mobileIcon.style.display = 'inline';
            mobileIconOpen.style.display = 'none';
          } else {
            mobileIcon.style.display = 'none';
            mobileIconOpen.style.display = 'inline';
          }
        }
      }
    } {% endcomment %}

    function doCloseEnd() {
      filtersRow.style.visibility = 'hidden';
      filtersRow.classList.remove('open', 'closing');
      updateMobileIcons(false);
      requestAnimationFrame(function() {
        filtersRow.style.visibility = '';
      });
    }
    function toggleMobileFilters() {
      if (window.innerWidth <= 1024) {
        const isOpen = filtersRow.classList.contains('open');
        const isClosing = filtersRow.classList.contains('closing');
        if (isOpen && !isClosing) {
          filtersRow.classList.add('closing');
          var closeDone = false;
          function finishClose() {
            if (closeDone) return;
            closeDone = true;
            filtersRow.removeEventListener('transitionend', onCloseEnd);
            clearTimeout(closeFallback);
            doCloseEnd();
          }
          function onCloseEnd(e) {
            if (e.target === filtersRow && e.propertyName === 'transform') finishClose();
          }
          var closeFallback = setTimeout(finishClose, 250);
          filtersRow.addEventListener('transitionend', onCloseEnd);
        } else if (!isOpen) {
          filtersRow.style.visibility = '';
          filtersRow.classList.remove('closing');
          filtersRow.classList.add('open');
          updateMobileIcons(true);
        }
      }
    }

    function handleResize() {
      if (window.innerWidth > 1024) {
        filtersRow.style.display = 'flex';
        // Reset mobile icons
        const mobileIcon = filterToggle.querySelector('.mobile-icon');
        const mobileIconOpen = filterToggle.querySelector('.mobile-icon-open');
        if (mobileIcon && mobileIconOpen) {
          mobileIcon.style.display = 'none';
          mobileIconOpen.style.display = 'none';
        }
      } else {
        //filtersRow.style.display = 'none';
        const mobileIcon = filterToggle.querySelector('.mobile-icon');
        if (mobileIcon) {
          mobileIcon.style.display = 'inline';
        }
      }
    }

    filterToggle.addEventListener('click', toggleMobileFilters);
    closeBtn.addEventListener('click', toggleMobileFilters);

    // Initialize on load
    handleResize();

    // Handle resize
    window.addEventListener('resize', handleResize);
  }

  // Panel Open/Close Functionality
  function setupPanelOpenClose() {
    const filters = document.querySelectorAll('.cst-filter-label');

    filters.forEach((button) => {

      const icon = button.querySelector('.icon');

      {% comment %} if (!button || !panel) return; {% endcomment %}
      if (!button) return;

      button.addEventListener('click', (e) => {
        e.preventDefault();
        const isOpen = button.getAttribute('aria-expanded') === 'true';

        // Close all other panels
        filters.forEach((otherButton) => {
          if (otherButton !== button) {
           
            const otherIcon = otherButton.querySelector('.icon');

            otherButton.setAttribute('aria-expanded', 'false');
            {% comment %} otherPanel.style.display = 'none'; {% endcomment %}
            if (otherIcon) {
              otherIcon.style.transform = 'rotate(0deg)';
            }
          }
        });

        // Toggle current panel
        if (isOpen) {
          button.setAttribute('aria-expanded', 'false');
          {% comment %} panel?.style.display = 'none'; {% endcomment %}
          if (icon) {
            icon.style.transform = 'rotate(0deg)';
          }
        } else {
          button.setAttribute('aria-expanded', 'true');
          {% comment %} panel.style.display = 'block'; {% endcomment %}
          if (icon) {
            icon.style.transform = 'rotate(180deg)';
          }
        }
      });
    });

    // Close panels when clicking outside
    document.addEventListener('click', (e) => {
      if (!e.target.closest('.cst-filter')) {
        filters.forEach((filter) => {
          const button = filter.querySelector('.cst-filter-label');
          {% comment %} const panel = filter.querySelector('.cst-filter-panel'); {% endcomment %}
          const icon = button.querySelector('.icon');

          button.setAttribute('aria-expanded', 'false');
          {% comment %} panel.style.display = 'none'; {% endcomment %}
          if (icon) {
            icon.style.transform = 'rotate(0deg)';
          }
        });
      }
    });
  }



   {%- if collection.products.size == 0 -%}
    gravityFilters();
   {% endif %}
  // Gravity effect when no products are found — robust version using clones (position:fixed)
  function gravityFilters() {
    const sourceElements = document.querySelectorAll(
      
    '.cst-filters-container .cst-filters-row > div, ' +
    '.cst-checkbox, ' +
    '.cst-price-range-row, ' +
    '.cst-filter-label, ' +
    '.cst-sort-radio-item, ' +
    '.cst-clear-btn, ' +
    '.cst-sort-filter, ' +
    '.cst-filters-container b, ' +
    '.cst-product-count, ' + 
    '.filter-top-text'
    );
    if (!sourceElements || sourceElements.length === 0) return;

    // Physics params (tweak to taste)
    const params = {
      gravity: 1800, // px/s²
      bounce: 0.35,
      wallBounce: 0.5,
      airDrag: 0.03,
      groundFriction: 3.0,
      bottomInset: 10, // distance from bottom viewport
      sideInset: 6,
      randomKickX: [-300, 300],
    };

    // Prevent layout shift while measuring & animating
    const originalVisibilities = new Map();
    sourceElements.forEach((el) => {
      originalVisibilities.set(el, el.style.visibility || '');
    });

    // Optionally lock scrolling to keep viewport stable
    const prevOverflow = document.documentElement.style.overflow;
    document.documentElement.style.overflow = 'hidden';
    document.body.style.overflow = 'hidden';

    // Create clones positioned fixed at the element's viewport coordinates
    const clones = [];
    sourceElements.forEach((el, idx) => {
      const rect = el.getBoundingClientRect();
      if (rect.width === 0 || rect.height === 0) return;

      // Clone
      const clone = el.cloneNode(true);
      clone.style.position = 'fixed';
      clone.style.left = rect.left + 'px';
      clone.style.top = rect.top + 'px';
      clone.style.width = rect.width + 'px';
      clone.style.height = rect.height + 'px';
      clone.style.margin = '0';
      clone.style.transform = 'translate(0, 0)';
      clone.style.transition = 'none';
      clone.style.pointerEvents = 'none';
      clone.style.zIndex = 99999;
      clone.style.willChange = 'transform';
      // Optional: give an identifiable class for debugging
      clone.classList.add('gravity-clone');

      // Hide original but keep its space (visibility) so layout doesn't reflow
      el.style.visibility = 'hidden';

      document.body.appendChild(clone);
      clones.push({ el: clone, original: el, rect });
    });

    if (clones.length === 0) {
      // restore and bail
      sourceElements.forEach((el) => (el.style.visibility = originalVisibilities.get(el) || ''));
      document.documentElement.style.overflow = prevOverflow;
      document.body.style.overflow = prevOverflow;
      return;
    }

    // Create physics items using viewport coords
    const physics = clones.map((item) => {
      return {
        el: item.el,
        originalEl: item.original,
        x: parseFloat(item.el.style.left),
        y: parseFloat(item.el.style.top),
        w: parseFloat(item.el.style.width),
        h: parseFloat(item.el.style.height),
        vx: Math.random() * (params.randomKickX[1] - params.randomKickX[0]) + params.randomKickX[0],
        vy: 0,
        baseLeft: parseFloat(item.el.style.left),
        baseTop: parseFloat(item.el.style.top),
      };
    });

    let rafId = null;
    let last = performance.now();

    function run() {
      const now = performance.now();
      const dt = Math.min((now - last) / 1000, 0.033);
      last = now;

      const stageH = window.innerHeight;
      const stageW = window.innerWidth;
      const floorY = stageH - params.bottomInset;
      let allSettled = true;

      physics.forEach((item) => {
        const groundY = floorY - item.h;
        const leftLimit = params.sideInset;
        const rightLimit = stageW - params.sideInset - item.w;

        // Gravity
        item.vy += params.gravity * dt;

        // Air drag
        item.vx *= 1 - params.airDrag * dt;

        // Integrate positions
        item.x += item.vx * dt;
        item.y += item.vy * dt;

        // Floor collision
        if (item.y > groundY) {
          item.y = groundY;
          item.vy = -item.vy * params.bounce;
          // friction reduces horizontal speed on bounce
          item.vx *= Math.max(0, 1 - params.groundFriction * dt);
        }

        // Side collisions
        if (item.x < leftLimit) {
          item.x = leftLimit;
          item.vx = -item.vx * params.wallBounce;
        } else if (item.x > rightLimit) {
          item.x = rightLimit;
          item.vx = -item.vx * params.wallBounce;
        }

        // Settled detection
        const nearGround = Math.abs(groundY - item.y) < 1;
        const slowVelocity = Math.abs(item.vx) < 2 && Math.abs(item.vy) < 5;
        if (nearGround && slowVelocity) {
          item.y = groundY;
          item.vx = 0;
          item.vy = 0;
        } else {
          allSettled = false;
        }

        // Apply transform (translate from starting position)
        const dx = item.x - item.baseLeft;
        const dy = item.y - item.baseTop;
        item.el.style.transform = `translate(${dx}px, ${dy}px)`;
      });

      if (!allSettled) {
        rafId = requestAnimationFrame(run);
      } else {

      }
    }



    // Start animation
    last = performance.now();
    rafId = requestAnimationFrame(run);

    function cleanup() {
      if (rafId) {
        cancelAnimationFrame(rafId);
        rafId = null;
      }

      // Smoothly return clones to their original positions (translate to 0) then remove
      physics.forEach((item) => {
        item.el.style.transition = 'transform 0.6s cubic-bezier(0.34, 1.56, 0.64, 1), opacity 0.3s';
        item.el.style.transform = 'translate(0, 0)';
        item.el.style.opacity = '0.95';
      });

      // After transition remove clones and restore original visibility
      setTimeout(() => {
        physics.forEach((item) => {
          // Remove clone
          if (item.el && item.el.parentNode) item.el.parentNode.removeChild(item.el);
          // Restore original's visibility
          if (item.originalEl) item.originalEl.style.visibility = originalVisibilities.get(item.originalEl) || '';
        });

        // Restore scrolling
        document.documentElement.style.overflow = prevOverflow;
        document.body.style.overflow = prevOverflow;

      }, 700);
    }
  }

  // Add CSS for the gravity effect (no rotation animations)
  const gravityStyles = document.createElement('style');
  gravityStyles.textContent = `
  @keyframes gravityFadeIn {
    0% { opacity: 0; transform: translateY(-20px); }
    100% { opacity: 1; transform: translateY(0); }
  }
  
  .gravity-falling {
    will-change: transform;
    backface-visibility: hidden;
  }
  
  /* Prevent text selection during animation */
  .cst-filters-container * {
    user-select: none;
  }
`;
  document.head.appendChild(gravityStyles);
</script>

