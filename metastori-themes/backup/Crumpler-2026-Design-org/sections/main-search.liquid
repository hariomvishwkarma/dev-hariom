{{ 'template-collection.css' | asset_url | stylesheet_tag }}
{{ 'component-card.css' | asset_url | stylesheet_tag }}
{{ 'component-price.css' | asset_url | stylesheet_tag }}
{{ 'component-search.css' | asset_url | stylesheet_tag }}

{%- if section.settings.enable_filtering or section.settings.enable_sorting -%}
  {{ 'component-facets.css' | asset_url | stylesheet_tag }}
  <script src="{{ 'facets.js' | asset_url }}" defer="defer"></script>
{%- endif -%}

{% if section.settings.image_shape == 'blob' %}
  {{ 'mask-blobs.css' | asset_url | stylesheet_tag }}
{%- endif -%}

<script src="{{ 'main-search.js' | asset_url }}" defer="defer"></script>

<style>
  .template-search__header {
    margin-bottom: 0;
    margin-top: 5rem;
  }

  .template-search__search {
    margin: 0 auto 3.5rem;
    max-width: 74.1rem;
  }

  .template-search__search .search {
    margin-top: 3rem;
  }

  .template-search--empty {
    padding-bottom: 18rem;
  }

  @media screen and (min-width: 750px) {
    .template-search__header {
      margin-bottom: 10rem;
    }
  }

  .search__button .icon {
    height: 1.8rem;
  }
  .cst-swatches .cst-swatch-image-wrapper span{
    display: inline-block;
    cursor: pointer;
    background-position: center;
    background: #58a7f4;
    background-size: contain;
  }
</style>

{%- liquid
  assign sort_by = search.sort_by | default: search.default_sort_by
  assign terms = search.terms | escape
  assign search_url = '?q=' | append: terms | append: '&options%5Bprefix%5D=last&sort_by=' | append: sort_by
-%}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

{% style %}

  .cst-product-card {
    text-align: left;
    position: relative;
    overflow: hidden;
    transition: opacity 0.3s ease;
  }

  .cst-main-slider .cst-slide-inner {
    width: 100%;
    aspect-ratio: 17/20;
  }

  .cst-image-link {
    position: relative;
  }

  .cst-product-image-wrapper {
    aspect-ratio: 17/20;
    position: relative;
    background-color: #eee;
    overflow: hidden;
  }

  .cst-product-image-wrapper video{
    max-width: 100%;
    object-fit: cover;
    height: 100%;
    width: 100%;
  }

  .cst-product-image {
    display: block;
    height: 100%;
    max-width:100%;
  }
  .cst-product-image.skeleton,
  .cst-swatch-image.skeleton {
    opacity: 0;
  }

  .cst-swatch-image-wrapper {
    /* aspect-ratio: 1/1; */
    position: relative;
    background-color: #eee;
    overflow: hidden;
    display: flex;
    width: fit-content;
    height: fit-content;
  }

  .cst-swatch-wrapper .swiper-slide {
      width: fit-content!important;
  }

  .cst-swatch-image {
    display: block;
    cursor:pointer;
    height: 100%;
  }

  .cst-disabled::after {
    content: '';
    position: absolute;
    inset: 0;
    background-color: {{section.settings.overlay_color}};
    opacity: {{section.settings.overlay_opacity}};
    /* pointer-events: none; */
    /* cursor: auto; */
    display: block;
  }

  .cst-product-title {
    margin-top: 4px;
    font-size: 13px;
    font-weight: 600;
    text-transform: uppercase;
    color:#000000;
    text-decoration:none;
    display: flex;
    padding: 0 10px;
    gap: 5px;
  }

  .cst-swatches {
    display: flex;
    align-items: center;
    margin-top: 0.5rem;
    gap: 8px;
    position: relative;
    padding: 0 10px;
  }

  .cst-swatches .cst-slide-inner {
    border: 0.8px solid transparent;
    transition: all 0.3s;
    width: fit-content;
    padding: .78px .94px .79px .96px;
  }

  .cst-swatches .swiper-slide.cst-active .cst-slide-inner {
    border-color: #333;
  }

  .cst-hidden {
    display: none !important;
  }

  .cst-pagination {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 8px;
    margin: 30px 0;
  }

  .cst-page-button {
    padding: 2px 5px;
    text-decoration: none;
    font-size: 16px;
    color: #333;
    border-bottom: 1px solid transparent;
    transition: all 0.2s ease;
  }

  .cst-page-button:hover {
    border-color: #333;
  }

  .cst-page-button.active {
    border-color: #333;
  }

  .cst-main-slider,
  .cst-swatch-slider {
    display: block;
    width: 100%;
    overflow: hidden;
  }

  .swiper-button-prev,
  .swiper-button-next {
    position: relative;
    left: auto;
    right: auto;
    top: auto;
    bottom: auto;
    width: 18px;
    height: 100%;
    display: flex;
    justify-content: center;
    align-items: center;
    margin: 0;
    display: flex !important;
    justify-content: center;
    align-items: center;
    background-color: #fff;
  }

  .swiper-button-prev {
    position: absolute;
    left: 0;
    justify-content: start;
  }

  .swiper-button-next {
    position: absolute;
    right: 0;
    justify-content: end;
  }

  .swiper-button-prev::after,
  .swiper-button-next::after {
    font-size: 14px;
    color: #333;
  }

  .swiper-button-prev.swiper-button-disabled,
  .swiper-button-next.swiper-button-disabled {
    display: none !important;
  }

.cst-swatches .cst-swatch-image-wrapper span {
  display: inline-block;
  width: 26.2px;
  height: 10px;
  cursor: pointer;
  background-position: center;
  background: #58a7f4;
  background-size: contain;
}

  @media(max-width: 425px) {
    .swiper-button-prev,
    .swiper-button-next {
      width: 14px;
    }

    .swiper-button-prev::after,
    .swiper-button-next::after {
      font-size: 10px;
      color: #333;
    }
  }

  .cst-tags-box {
    position: absolute;
    top: 0;
    left: 0;
    width: clamp(70px, 100vw, 200px);
    display: flex;
    flex-direction: column;
    gap: 5px;
    padding: 5px;
    border: 1px solid red;
  }

  .cst-img-box {
    display: flex;
    width: 70px;
    z-index: 1;
  }
  .cst-img-box img {
    display: flex;
  }

  .main_search__content{
    font-size:{{ section.settings.search_content_size_m }};
    text-align:center;
  }
  .nosearch_image img{
    max-width: 100%;
    object-fit: contain;
  }
  .search_no_result{
    display: flex;
    flex-direction: column;
    gap: 25px;
    align-items: center;
    padding: 5rem 0;
  }
  .main_search__content p {
    margin: 0;
  }
  .main_search__content a{
    background: #000;
    color: #fff;
    text-transform: uppercase;
    padding: 0 4px;
  }
  .search-result-page {
    font-size: 13px;
    font-weight: 600;
    text-transform: uppercase;
    line-height: 1.4;
    color: #000000;
    display: flex;
    padding: 0;
    position: absolute;
    bottom: 13px;
}

@media (min-width:768px){
  .grid {
    row-gap: 32px;
  }
  .main_search__content{
    font-size:{{ section.settings.search_content_size }};
  }
  #ProductGridContainer {
    margin-top: 70px;
    margin-bottom: 130px;
  }
}

@media (max-width:1024px){
  .grid.product-grid {
    row-gap: 39px;
    column-gap: 12px;
  }
}

@media (min-width:1025px){
  .mobile-filter-header{
    display:none;
  }
}
{% endstyle %}

{% paginate search.results by 24 %}
  <div class="template-search{% unless search.performed and search.results_count > 0 %} template-search--empty{% endunless %} section-{{ section.id }}-padding">
    {% render 'search-page-filter', search:search, section:section %}
    <div class="template-search__header page-width{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--fade-in{% endif %}">
      <h1 class="h2 center">
        {%- if search.performed -%}
          {{- 'templates.search.title' | t -}}
        {%- else -%}
          {{- 'general.search.search' | t -}}
        {%- endif -%}
      </h1>
      <div class="template-search__search">
        {%- if settings.predictive_search_enabled -%}
          <predictive-search data-loading-text="{{ 'accessibility.loading' | t }}">
        {%- endif -%}
        <main-search>
          <form action="{{ routes.search_url }}" method="get" role="search" class="search">
            <div class="field">
              <input
                class="search__input field__input"
                id="Search-In-Template"
                type="search"
                name="q"
                value="{{ search.terms | escape }}"
                placeholder="{{ 'general.search.search' | t }}"
                {%- if settings.predictive_search_enabled -%}
                  role="combobox"
                  aria-expanded="false"
                  aria-owns="predictive-search-results"
                  aria-controls="predictive-search-results"
                  aria-haspopup="listbox"
                  aria-autocomplete="list"
                  autocorrect="off"
                  autocomplete="off"
                  autocapitalize="off"
                  spellcheck="false"
                {%- endif -%}
              >
              <label class="field__label" for="Search-In-Template">{{ 'general.search.search' | t }}</label>
              <input name="options[prefix]" type="hidden" value="last">

              {%- if settings.predictive_search_enabled -%}
                <div class="predictive-search predictive-search--search-template" tabindex="-1" data-predictive-search>
                  {%- render 'loading-spinner', class: 'predictive-search__loading-state' -%}
                </div>

                <span class="predictive-search-status visually-hidden" role="status" aria-hidden="true"></span>
              {%- endif -%}

              <button
                type="reset"
                class="reset__button field__button{% if search.terms == blank %} hidden{% endif %}"
                aria-label="{{ 'general.search.reset' | t }}"
              >
                <span class="svg-wrapper">
                  {{- 'icon-reset.svg' | inline_asset_content -}}
                </span>
              </button>
              <button type="submit" class="search__button field__button" aria-label="{{ 'general.search.search' | t }}">
                <span class="svg-wrapper">
                  {{- 'icon-search.svg' | inline_asset_content -}}
                </span>
              </button>
            </div>
          </form>
        </main-search>
        {%- if settings.predictive_search_enabled -%}
          </predictive-search>
        {%- endif -%}
      </div>
      {%- if search.performed -%}
        {%- unless section.settings.enable_filtering or section.settings.enable_sorting -%}
          {%- if search.results_count > 0 -%}
            <p role="status">
              {{ 'templates.search.results_with_count_and_term' | t: terms: search.terms, count: search.results_count }}
            </p>
          {%- endif -%}
        {%- endunless -%}
        {%- if search.results_count == 0 and search.filters == empty -%}
          {% comment %} <p role="status">{{ 'templates.search.no_results' | t: terms: search.terms }}</p>{% endcomment %}
           <div class="search_no_result">
            {% if section.settings.search_no_image != blank %}
              <div class="nosearch_image">
                <img src="{{ section.settings.search_no_image | image_url }}" width="auto" height="auto" alt="search">
              </div>
            {% endif %}
            {% if section.settings.search_content != blank %}
              <div class="search_nosearch_content">
                <div class="main_search__content">{{section.settings.search_content }}</div>
              </div>
            {% endif %}
           </div>
        {%- endif -%}
      {%- endif -%}
    </div>
    {%- if search.performed -%}
      {%- if section.settings.enable_sorting
        and section.settings.filter_type == 'vertical'
        and search.filters != empty
      -%}
        <facet-filters-form class="facets facets-vertical-sort page-width small-hide">
          <form class="facets-vertical-form" id="FacetSortForm">
            <div class="facet-filters sorting caption">
              <div class="facet-filters__field">
                <h2 class="facet-filters__label caption-large text-body">
                  <label for="SortBy">{{ 'products.facets.sort_by_label' | t }}</label>
                </h2>
                <div class="select">
                  {%- assign sort_by = search.sort_by | default: search.default_sort_by -%}
                  <select
                    name="sort_by"
                    class="facet-filters__sort select__select caption-large"
                    id="SortBy"
                    aria-describedby="a11y-refresh-page-message"
                  >
                    {%- for option in search.sort_options -%}
                      <option
                        value="{{ option.value | escape }}"
                        {% if option.value == sort_by %}
                          selected="selected"
                        {% endif %}
                      >
                        {{ option.name | escape }}
                      </option>
                    {%- endfor -%}
                  </select>
                  <span class="svg-wrapper">
                    {{- 'icon-caret.svg' | inline_asset_content -}}
                  </span>
                </div>
              </div>
            </div>

            <div class="product-count-vertical light" role="status">
              <h2 class="product-count__text text-body">
                <span id="ProductCountDesktop">
                  {%- if search.results_count -%}
                    {{ 'templates.search.results_with_count' | t: terms: search.terms, count: search.results_count }}
                  {%- elsif search.products_count == search.all_products_count -%}
                    {{ 'products.facets.product_count_simple' | t: count: search.products_count }}
                  {%- else -%}
                    {{
                      'products.facets.product_count'
                      | t: product_count: search.products_count, count: search.all_products_count
                    }}
                  {%- endif -%}
                </span>
              </h2>
              {%- render 'loading-spinner' -%}
            </div>
          </form>
        </facet-filters-form>
      {%- endif -%}
      <div
        {% if section.settings.filter_type == 'vertical' %}
          class="facets-vertical page-width"
        {% endif %}
      >
        <div class="product-grid-container" id="ProductGridContainer">
          {%- if search.results.size == 0 and search.filters != empty -%}
            <div
              class="template-search__results collection collection--empty{% if section.settings.filter_type != 'vertical' %} page-width{% endif %}"
              id="product-grid"
              data-id="{{ section.id }}"
            >
              <div class="loading-overlay gradient"></div>
              <div class="title-wrapper center">
                <h2 class="title title--primary">
                  {{ 'sections.collection_template.empty' | t -}}
                  <br>
                  {{
                    'sections.collection_template.use_fewer_filters_html'
                    | t: link: search_url, class: 'underlined-link link'
                  }}
                </h2>
              </div>
            </div>
          {%- else -%}
            <div
              class="template-search__results collection{% if section.settings.filter_type != 'vertical' %} {% endif %}"
              id="product-grid"
              data-id="{{ section.id }}"
            >
              <div class="loading-overlay gradient"></div>
              <ul
                class="grid product-grid  grid--{{ section.settings.columns_mobile }}-col-tablet-down grid--{{ section.settings.columns_desktop }}-col-desktop"
                role="list"
              >
                {%- assign skip_card_product_styles = false -%}
                {%- for item in search.results -%}
                  {% assign lazy_load = false %}
                  {%- if forloop.index > 2 -%}
                    {%- assign lazy_load = true -%}
                  {%- endif -%}

                  {% comment %} {% if item.object_type == 'page' or item.object_type == 'article' %}
                    {% continue %}
                  {% endif %} {% endcomment %}

                  <li
                    class="grid__item{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}"
                    {% if settings.animations_reveal_on_scroll %}
                      data-cascade
                    {% endif %}
                  >
                    {%- case item.object_type -%}
                      {%- when 'product' -%}
                   
                          {% assign product = item %}
                          {% assign is_available = product.available %}

                          <div
                            id="cst-grid"
                            class="cst-product-card {% unless is_available %} disabled{% endunless %}"
                            data-product-id="{{ product.id }}"
                          >
                            <div class="crumpler-capsules__wrapper">
                              {% # Metafield Capsules %}
                              {% assign capsules = product.metafields.crumpler.tag.value %}
                              {% for capsule in capsules %}
                                <span class="capsule capsule--no-border crumpler-capsules__product_capsule">{{ capsule }}</span>
                              {% endfor %}
                            </div>
                            <div class="cst-main-slider">
                              <div class="cst-wrapper swiper-wrapper">

                                    {% assign color_option_names = 'color,colour' | split: ',' %}

                                    {% for option in product.options_with_values %}
                                      {% assign option_name_down = option.name | downcase %}

                                      {% if color_option_names contains option_name_down %}
                                      {% assign option_index = option.position | minus: 1 %}

                                        {% for color in option.values %}  
                                          {% for variant in product.variants %}
                                            
                                            {% if variant.options[option_index] == color and variant.metafields.custom.hide_variant_from_collection_page == true %}
                                              {% continue %}
                                            {% endif %}
                                          
                                            {% if variant.options[option_index] == color %}

                                              {% assign variant_video = blank %}
                                              {% if variant.metafields.custom.collection_display_image != blank %}
                                                {% assign variant_video = variant.metafields.custom.collection_display_image | file_url %}
                                                {% assign variant_img = variant.metafields.custom.collection_display_image %}
                                              {% elsif variant.featured_image %}
                                                {% assign variant_img = variant.featured_image | image_url %}
                                              {% else %}
                                                {% assign variant_img = product.featured_image | image_url %}
                                              {% endif %}
                                              {% if variant_video contains 'videos' %}
                                                  <div class="swiper-slide">
                                                    <div class="cst-slide-inner">
                                                      <a
                                                        href="{{ variant.url }}"
                                                        class="cst-image-link {% unless variant.available %} cst-disabled {% endunless %}"
                                                      >
                                                        <div class="cst-product-image-wrapper">
                                                          <video class="cst-product-video" autoplay loop muted playsinline>
                                                            <source src="{{ variant_video }}" type="video/mp4">
                                                          </video>
                                                        </div>
                                                      </a>
                                                    </div>
                                                  </div>
                                              {% else %}
                                                {% if variant_img %}
                                                  <div class="swiper-slide">
                                                    <div class="cst-slide-inner">
                                                      {% comment %} <a
                                                        href="{{ variant.url }}"
                                                        class="cst-image-link {% unless variant.metafields.pickup.shipping_qty > 0 %} cst-disabled {% endunless %}"
                                                      > {% endcomment %}
                                                      <a
                                                        href="{{ variant.url }}"
                                                        class="cst-image-link {% unless variant.available %} cst-disabled {% endunless %}"
                                                      >
                                                        <div class="cst-product-image-wrapper">
                                                          <img
                                                            srcset="
                                                              {%- if variant_img.width >= 165 -%}{{ variant_img | image_url: width: 165 }} 165w,{%- endif -%}
                                                              {%- if variant_img.width >= 360 -%}{{ variant_img | image_url: width: 360 }} 360w,{%- endif -%}
                                                              {%- if variant_img.width >= 533 -%}{{ variant_img | image_url: width: 533 }} 533w,{%- endif -%}
                                                              {%- if variant_img.width >= 720 -%}{{ variant_img | image_url: width: 720 }} 720w,{%- endif -%}
                                                              {%- if variant_img.width >= 940 -%}{{ variant_img | image_url: width: 940 }} 940w,{%- endif -%}
                                                              {%- if variant_img.width >= 1066 -%}{{ variant_img | image_url: width: 1066 }} 1066w,{%- endif -%}
                                                              {%- if variant_img.width >= 1550 -%}{{ variant_img | image_url: width: 1550 }} 1550w,{%- endif -%}
                                                              {%- if variant_img.width >= 2000 -%}{{ variant_img | image_url: width: 2000 }} 2000w,{%- endif -%}
                                                              {%- if variant_img.width >= 2500 -%}{{ variant_img | image_url: width: 2500 }} 2500w,{%- endif -%}
                                                              {{ variant_img | image_url }} {{ variant_img.width }}w
                                                            "
                                                            src="{{ variant_img | image_url: width: 533 }}"
                                                            sizes="(min-width: {{ settings.page_width }}px) {{ settings.page_width | minus: 130 | divided_by: 4 }}px, (min-width: 990px) calc((100vw - 130px) / 4), (min-width: 750px) calc((100vw - 120px) / 3), calc((100vw - 35px) / 2)"
                                                            alt="{{ product.title | escape }}"
                                                            class="motion-reduce cst-product-image skeleton"
                                                            loading="lazy"
                                                            width="{{ variant_img.width }}"
                                                            height="{{ variant_img.height }}"
                                                            onload="this.classList.remove('skeleton')"
                                                          >
                                                        </div>
                                                      </a>
                                                    </div>
                                                  </div>
                                                {% endif %}
                                              {% endif %}

                                              {% break %}
                                            {% endif %}
                                          {% endfor %}
                                        {% endfor %}
                                      {% endif %}
                                {% endfor %}
                              </div>
                            </div>

                            <a class="cst-product-title" href="{{ product.url }}">
                              {{- product.title }} 
                              <span class="cst-product-price">
                                {{ product.selected_or_first_available_variant.price | money_without_trailing_zeros -}}
                              </span>
                            </a>                          

                            <div class="cst-swatches">
                              {% comment %} <div class="swiper-button-prev cst-swatch-prev"></div> {% endcomment %}

                              <div class="cst-swatch-slider">
                                <div class="cst-swatch-wrapper swiper-wrapper">

                                  {% assign color_option_names = 'color,colour' | split: ',' %}

                                  {% for option in product.options_with_values %}
                                      {% assign option_name_down = option.name | downcase %}

                                      {% if color_option_names contains option_name_down %}
                                        {% assign swatches = product.metafields.alt.swatches.value %}
                                        {% assign option_index = option.position | minus: 1 %}

                                        {% for color in option.values %}

                                          {% for variant in product.variants %}

                                              {% if variant.options[option_index] == color and variant.metafields.custom.hide_variant_from_collection_page == true %}
                                                {% continue %}
                                              {% endif %}
                                          
                                              {% if variant.options[option_index] == color %}
                                                  {% assign this_swatch = blank %}

                                                  {%- comment -%}
                                                    Priority:
                                                    1. Variant swatch (image or color)
                                                    2. Metafield swatch fallback
                                                  {%- endcomment -%}

                                                  {% if color.swatch.image %}
                                                    {% assign this_swatch = color.swatch %}
                                                  {% elsif color.swatch.color %}
                                                    {% assign this_swatch = color.swatch %}
                                                  {% else %}
                                                    {% for swatch in swatches %}
                                                      {% assign swatch_color_down = swatch.colour | downcase %}
                                                      {% assign color_down = color | downcase %}
                                                      {% assign swatch_name_down = swatch.name | downcase %}

                                                      {% if color_down contains swatch_name_down %}
                                                        {% if swatch.image or swatch.color %}
                                                          {% assign this_swatch = swatch %}
                                                        {% endif %}
                                                      {% endif %}
                                                    {% endfor %}
                                                  {% endif %}

                                                  <div class="swiper-slide" price="{{ variant.price | money_without_trailing_zeros }}">
                                                    <div class="cst-slide-inner">
                                                      <div class="cst-swatch-image-wrapper">
                                                        {% render 'swatch',
                                                          swatch: this_swatch,
                                                          option_value: color,
                                                          product: product,
                                                          alt_swatches: true,
                                                          swatch_size: 16,
                                                          shape: 'square'
                                                        %}
                                                      </div>
                                                    </div>
                                                  </div>
                                                {% comment %} {% endif %} {% endcomment %}
