<!-- Section: Image with Popup -->
<div class="image-popup-section">
  <!-- Main image with clickable text -->
  <div class="image-container">
    <span class="top_content_button_css">{{ section.settings.top_content_button }}</span>
    <div class="clickable-text" id="open-popup">
      {{ section.settings.clickable_text }}
    </div>
    <div>
      <button class="clickable-text-audio">{{ section.settings.clickable_text_audio }}</button>
    </div>
    <div class="mim-toggle">
      <a href="/collections/made-in-melbourne?view=old-made-in-melbourne" class="mim-toggle-text">collection View</a>
      <label class="toggle">
        <input class="mim-inp-toggle" type="checkbox">
        <span class="mim-toggle-slider"></span>
      </label>
    </div>
  </div>

  <!-- Full-screen popup -->
  <div class="popup-overlay" id="popup-overlay">
    <div class="popup-content">
      <div class="popup-body">
        <h2>{{ section.settings.popup_title }}</h2>
        <div class="popup-text">
          {{ section.settings.popup_content }}
          {% if section.settings.video != blank and section.settings.video_image_toggle == 'video' %}
            <div class="video_wr">
            {{ section.settings.video | video_tag: class: 'main-image', controls: false, playsinline: true ,loop:true }}
            </div>
          {% elsif section.settings.image != blank and section.settings.video_image_toggle == 'image' %}
            <img
              src="{{ section.settings.image | img_url: '1200x' }}"
              alt="{{ section.settings.image.alt }}"
              class="main-image"
            >
          {% endif %}
        </div>

        {% if section.settings.show_products %}
          <div class="product-links">
            {% for block in section.blocks %}
              <a href="{{ block.settings.product_url }}" class="product-link">
                {{ block.settings.product_name }}
              </a>
            {% endfor %}
          </div>
        {% endif %}
        <button class="close-popup" id="close-popup">CLOSE X</button>
      </div>
    </div>
  </div>
</div>

<style>
      .top_content_button_css {
        margin-block: 10px;
        margin-top: 0;
        font-size: {{ section.settings.top_content_button_font_size }};
        color: #000;
        max-width: 475px;
        display: block;
        font-weight: 500;
        letter-spacing: normal !important;
      }
    .image-popup-section {
      position: relative;
      width: 100%;
      z-index:2;
    }
    .mim-popup-section {
      position: relative;
      z-index: 2;
    }

    .image-container {
      position: relative;
      display: inline-block;
      width: 100%;
      padding-inline: 18px;
    }

    .main-image {
      width: 100%;
      height: auto;
      display: block;
      margin-top: 60px;
    }

    .clickable-text {
      min-height: 26px;
      background: #000;
      display: inline-flex;
      color: #fff;
      padding: 0px 8px 0px;
      cursor: pointer;
      font-weight: 700;
      opacity: 1;
      transition: all 0.3s;
      font-family: W95FA;
      font-size: 20px;
      align-items: center;
      justify-content: center;
      line-height: 1;
    }
    .clickable-text-audio {
      background: #2200FF;
      display: inline-flex;
      color: #fff;
      padding: 0px 8px 0px;
      cursor: pointer;
      font-weight: 700;
      opacity: 1;
      transition: all 0.3s;
      margin: 2px 0px;
      border: none;
      font-family: W95FA;
      font-size: 20px;
      align-items: center;
      justify-content: center;
      min-height: 26px;
      line-height: 1;
    }
    .clickable-text-audio:hover,
    .clickable-text:hover {
      text-decoration: underline;
    }
    .clickable-text:hover {
      opacity: .9;
    }
    .video_wr {
      position: relative;
      {% comment %} padding-top: 100%; {% endcomment %}
      margin-top: 60px;
    }

    video.main-image {
      {% comment %} position: absolute; {% endcomment %}
      top: 0;
      height: 100%;
      width: 100%;
      left: 0;
      margin-top: 0;
      border-radius: 10px;
    }
    /* Popup Styles */
    .popup-overlay {
      display: none;
      position: fixed;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      z-index: 9999;
      overflow-y: auto;
    }

   .popup-content {
    background: #000;
    max-height: 90%;
    overflow-y: auto;
    width: 90%;
    max-width: 462px;
    color: #FFF;
    padding: 7px 11px 11px;
    position: absolute;
    border-radius: 0;
    top: 0;
    left: auto;
    right: 0;
  }
  .popup-text p {
    font-family: 'PP NeueBit';
    font-size: 24px;
    font-weight: 700;
    margin-top: 0;
  }

    .close-popup {
      background: none;
      border: none;
      cursor: pointer;
      font-weight: bold;
      color: #FFF;
      font-family: 'PP NeueBit';
      font-size: 24px;
    }

    .popup-body h2 {
      margin-bottom: 20px;
      font-size: 24px;
      color: #fff;
    }

    .popup-text {
      margin-bottom: 10px;
      color: #fff;
    }

    .product-links {
      display: flex;
      flex-direction: column;
      gap: 10px;
    }

    .product-link {
      display: inline-block;
      padding: 10px 15px;
      background: #f5f5f5;
      border-radius: 4px;
      text-decoration: none;
      color: #fff;
      transition: background 0.3s ease;
    }

    .product-link:hover {
      background: #e0e0e0;
    }
    .clickable-text+div {
      display: flex;
    }
    .mim-toggle-text {
      min-width: 109px;
      padding: 4px 8px 5px;
      display: flex;
      align-items: center;
      justify-content: center;
      background: #11FF00;
      font-family: W95FA;
      transition: all 0.3s;
      font-weight: 700;
      font-size: 20px;
      text-transform: capitalize;
      line-height: 1;
      color: #000;
    }
    .mim-toggle-text:hover {
     text-decoration: underline;
    }
    .mim-toggle-active .mim-toggle-text {
      background: transparent;
    }
    .mim-toggle {
      display: flex;
      align-items: center;
      gap: 9px;
    }
    .toggle {
      position: relative;
      display: inline-block;
      width: 35px;
      height: 16px;
    }

    .toggle .mim-inp-toggle {
      opacity: 0;
      width: 0;
      height: 0;
      display:none;
    }

.mim-toggle-slider {
  position: absolute;
  cursor: pointer;
  inset: 0;
  background: #BEBEBE;
  border-radius: 50px;
  transition: 0.3s;
  display: none;
}

.mim-toggle-slider::before {
    content: "";
    position: absolute;
    height: 13.7px;
    width: 13.7px;
    left: 1.6px;
    top: 50%;
    transform: translateY(-50%);
    background: white;
    border-radius: 50%;
    transition: 0.3s;
}

.toggle .mim-inp-toggle:checked + .mim-toggle-slider {
  background: #000;
}

.toggle .mim-inp-toggle:checked + .mim-toggle-slider::before {
    transform: translateX(18px) translateY(-50%);
}


    @media (min-width:1025px){
      .image-container {
        position: absolute;
        top: 0;
        left: 0;
        z-index: 1;
      }
    }

    @media (max-width: 1025px) {
      .popup-content {
        width: 100%;
        padding: 7px 15px 11px 10px;
        margin: 0 auto;
        top: 0;
      }

      .clickable-text {
        font-size: 26px;
        min-height: 33px;
        padding: 1px 8px 5px;
      }
      .clickable-text-audio {
        font-size: 26px;
        min-height: 33px;
        padding: 1px 8px 5px;
      }
      .image-container {
        padding-inline: 12px;
      }
      .top_content_button_css {
        font-size: {{ section.settings.top_content_button_font_size_m }};
        margin-bottom: 17px;
      }
      .main-image {
        margin-top: 35px;
      }
      .popup-overlay {
        background: rgba(255, 255, 255, 0.5);
        backdrop-filter: blur(10.4px);
      }
    }
</style>

<script>
  document.addEventListener('DOMContentLoaded', function () {
    /* ---------------- Existing Popup Code ---------------- */
    const openPopupBtn = document.getElementById('open-popup');
    const closePopupBtn = document.getElementById('close-popup');
    const popupOverlay = document.getElementById('popup-overlay');
    const popupparent = document.querySelector('.mim-popup-section');

    if (openPopupBtn && popupOverlay) {
      openPopupBtn.addEventListener('click', function () {
        popupparent.style.zIndex = 3;
        popupOverlay.style.display = 'block';
        document.body.style.overflow = 'hidden';
        const popupVideo = popupOverlay.querySelector('video.main-image');
        if (popupVideo) {
          popupVideo.play().catch(() => {});
        }
      });
    }

    if (closePopupBtn && popupOverlay) {
      closePopupBtn.addEventListener('click', function () {
        popupOverlay.style.display = 'none';
        popupparent.style.zIndex = 2;
        document.body.style.overflow = '';
        const popupVideo = popupOverlay.querySelector('video.main-image');
        if (popupVideo) popupVideo.pause();
      });
    }

    if (popupOverlay) {
      popupOverlay.addEventListener('click', function (e) {
        if (e.target === popupOverlay) {
          popupOverlay.style.display = 'none';
          popupparent.style.zIndex = 2;
          document.body.style.overflow = '';
          const popupVideo = popupOverlay.querySelector('video.main-image');
          if (popupVideo) popupVideo.pause();
        }
      });
    }

    /* ---------------- AUDIO TOGGLE CODE ---------------- */
    const audioBtn = document.querySelector('.clickable-text-audio');
    const audioUrl = '{{ section.settings.audio  }}'; // Audio URL from settings
    const audioOffText = '{{ section.settings.clickable_text_audio }}'; // Example: "Sound Off"
    const audioOnText = '{{ section.settings.clickable_text_audio_on }}'; // Example: "Sound On"

    let audio = null;
    let isPlaying = false;

    if (audioUrl && audioBtn) {
      audio = new Audio(audioUrl);
      audio.preload = 'auto'; // Preload audio
      audioBtn.textContent = audioOffText; // Default OFF

      audioBtn.addEventListener('click', () => {
        if (!isPlaying) {
          audio.play();
          isPlaying = true;
          audioBtn.textContent = audioOnText;
        } else {
          audio.pause();
          isPlaying = false;
          audioBtn.textContent = audioOffText;
        }
      });

      // When audio ends, reset to OFF
      audio.addEventListener('ended', () => {
        isPlaying = false;
        audioBtn.textContent = audioOffText;
      });
    }

    const mim_toggle = document.querySelector(".mim-inp-toggle");

    if (mim_toggle) {
      mim_toggle.checked = false;
      mim_toggle.addEventListener("change", () => {
        const wrapper = mim_toggle.closest('.mim-toggle');
        const url = new URL(window.location.href);

        if (mim_toggle.checked) {
          mim_toggle.disabled = true; 
          wrapper.classList.add('mim-toggle-active');
          url.searchParams.set("view", "old-made-in-melbourne");
        }
        window.location.href = url.toString();
      });
    }

  });

  window.addEventListener("pageshow", function (event) {
    if (event.persisted) {
      const mim_toggle = document.querySelector(".mim-inp-toggle");
      if (!mim_toggle) return;
      mim_toggle.checked = false;
      mim_toggle.disabled = false;
    }
  });
</script>

