<style>
@media (min-width:1026px){
    .bpp-heading, .bpp-product-title{
        font-size:{{ section.settings.heading_size }};
        text-transform: uppercase;
        padding: 2px 4px;
        display: flex;
    }
    .bpp-product-title span, .bpp-product-title span {
        width: 62px;
        display: flex;
    }
}
@media (max-width:1025px){
    .bpp-heading, .bpp-product-title{
        text-transform: uppercase;
        padding: 2px 4px;
    }
    .bpp-product-description {
      margin-bottom: 5px !important;
    }
}

.bagspa-product-popup-main {
    margin-top: 80px;
}
.bpp-product-quickview{
    cursor:pointer;
}
.bpp-product-quickview:hover{
    text-decoration:underline;
}

.cst-product-card {
    text-align: left;
    position: relative;
    overflow: hidden;
    transition: opacity 0.3s ease;
  }

  .cst-main-slider .cst-slide-inner {
    width: 100%;
  }

  .cst-image-link {
    position: relative;
  }

  .cst-product-image-wrapper {
    aspect-ratio: 1;
    position: relative;
    background-color: #eee;
    overflow: hidden;
  }
  
  .cst-product-image {
    display: block;
    height: 100%;
  }
  .cst-product-image.skeleton,
  .cst-swatch-image.skeleton {
    opacity: 0;
  }

  .cst-swatch-image-wrapper {
    {% comment %} aspect-ratio: 1/1; {% endcomment %}
    position: relative;
    background-color: #eee;
    overflow: hidden;
  }
  
  .cst-swatch-image {
    display: block;
    cursor:pointer;
    height: 100%;
  }

  .bpp-quickview-product-item .cst-swatch-slider .swiper-slide {
    width: fit-content !important;
  }
  .bpp-quickview-product-item .cst-swatch-image-wrapper img {
    width: 26px !important;
    height: 10px;
    object-fit: cover;
  }

  .cst-disabled::after {
    content: '';
    position: absolute;
    inset: 0;
    background-color: {{section.settings.overlay_color}};
    opacity: {{section.settings.overlay_opacity}};
    /* pointer-events: none; */
    /* cursor: auto; */
    display: block;
  }

  .cst-product-title {
    margin-top: 8px;
    font-size: 13px;
    font-weight: 600;
    text-transform: uppercase;
    color:#000000;
    text-decoration:none;
  }

  .cst-swatches {
    display: flex;
    align-items: center;
    margin-top: 0.5rem;
    gap: 8px;
    position: relative;
  }

  .cst-swatches .cst-slide-inner {
    border: 1.7px solid transparent;
    transition: all 0.3s;
  }

  .cst-swatches .swiper-slide.cst-active .cst-slide-inner {
    border-color: #333;
  }

  .cst-hidden {
    display: none !important;
  }
  
  .cst-pagination {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 8px;
    margin: 30px 0;
  }

  .cst-page-button {
    padding: 2px 5px;
    text-decoration: none;
    font-size: 16px;
    color: #333;
    border-bottom: 1px solid transparent;
    transition: all 0.2s ease;
  }

  .cst-page-button:hover {
    border-color: #333;
  }

  .cst-page-button.active {
    border-color: #333;
  }

  .cst-main-slider,
  .cst-swatch-slider {
    display: block;
    width: 100%;
    overflow: hidden;
  }

  .swiper-button-prev,
  .swiper-button-next {
    position: relative;
    left: auto;
    right: auto;
    top: auto;
    bottom: auto;
    width: 18px;
    height: 100%;
    display: flex;
    justify-content: center;
    align-items: center;
    margin: 0;
    display: flex !important;
    justify-content: center;
    align-items: center;
    background-color: #fff;
  }

  .swiper-button-prev {
    position: absolute;
    left: 0;
    justify-content: start;
  }

  .swiper-button-next {
    position: absolute;
    right: 0;
    justify-content: end;
  }

  .swiper-button-prev::after,
  .swiper-button-next::after {
    font-size: 14px;
    color: #333;
  }

  .swiper-button-prev.swiper-button-disabled,
  .swiper-button-next.swiper-button-disabled {
    display: none !important;
  }
  .bpp-quickview_close span {
    font-size: 12px;
    FONT-WEIGHT: 500;
  }
  .cst-product-title h3 {
    FONT-WEIGHT: 700;
  }
  .bpp-quickview-product-item {
    width: 500px;
  }
  .cst-product-title h3:hover {
    text-decoration: underline;
  }
  @media(max-width: 1024px) {
    .cst-product-title h3 {
      text-decoration: underline;
    }
  }
  @media(max-width: 425px) {
    .swiper-button-prev,
    .swiper-button-next {
      width: 14px;
    }

    .swiper-button-prev::after,
    .swiper-button-next::after {
      font-size: 10px;
      color: #333;
    }
  }

  .cst-tags-box {
    position: absolute;
    top: 0;
    left: 0;
    width: clamp(70px, 100vw, 200px);
    display: flex;
    flex-direction: column;
    gap: 5px;
    padding: 5px;
    border: 1px solid red;
  }

  .cst-img-box {
    display: flex;
    width: 70px;
    z-index: 1;
  }
  .cst-img-box img {
    display: flex;
  }
  .bpp-quickview-product-item .cst-swatch-next, .bpp-quickview-product-item .cst-swatch-prev{
    display:none!important;
  }
  
  .cst-swatch-image-wrapper {
    /* aspect-ratio: 1/1; */
    position: relative;
    background-color: #eee;
    overflow: hidden;
    display: flex;
    width: fit-content;
    height: fit-content;
  }
  .cst-swatch-image-wrapper span {
    display: inline-block;
    width: 27.5px;
    height: 12.5px;
    cursor: pointer;
    background-position: center;
    background: #58a7f4;
    background-size: contain;
  }
  .cst-swatch-image-wrapper {
    /* aspect-ratio: 1/1; */
    position: relative;
    background-color: #eee;
    overflow: hidden;
    display: flex;
    width: fit-content;
    height: fit-content;
  }
  .cst-swatches .cst-slide-inner {
    border: 0.8px solid transparent;
    transition: all 0.3s;
    width: fit-content;
    padding: .78px .94px .79px .96px;
  }

</style>

{% assign product_count = 0 %}
<div class="bagspa-product-popup-main">
    <div class="bpp-wrapper">
        {% for block in section.blocks %}
            {% case block.type %}
                {% when 'heading' %}
                    <div class="bpp-heading" style="background:{{ block.settings.bg_color }};color:{{ block.settings.text_color }};">
                        {{ block.settings.heading }}
                    </div>

                {% when 'product' %}
                    {% assign product_count = product_count | plus:1 %}
                    {% assign product = block.settings.product %}
                    <div class="bpp-product-item">
                        {% if block.settings.product != blank %}
                            {% if block.settings.product_title != blank %}
                                <div class="bpp-product-title bpp-product-quickview" data-id="{{ product.id }}">
                                    <span>{%if product_count < 10%}0{%endif%}{{product_count}}.</span> {{ block.settings.product_title }}
                                </div>
                            {% else %}
                                <div class="bpp-product-title bpp-product-quickview" data-id="{{ product.id }}">
                                    <span>{%if product_count < 10%}0{%endif%}{{product_count}}.</span> {{ product.title }}
                                </div>
                            {% endif %}
                            {%capture quickview_items %}{{ quickview_items }}

                            <div class="bpp-quickview-product-item" data-id="{{ product.id }}">
                                {% assign is_available = product.available %}

                                    <div class="cst-product-card {% unless is_available %} disabled{% endunless %}" data-product-id="{{ product.id }}">
                                        <div class="cst-main-slider">
                                            <div class="cst-wrapper swiper-wrapper">
                                            {% comment %} {% if is_available %} {% endcomment %}
                                                {% for variant in product.variants %}
                                                {% assign variant_img = variant.featured_image | image_url %}
                                                {% unless variant_img contains '.gif' %}
                                                    {% if variant_img %}
                                                    <div class="swiper-slide" data-variant-id="{{ variant.id }}">
                                                        <div class="cst-slide-inner">
                                                        <div class="cst-image-link {% unless variant.metafields.pickup.shipping_qty > 0 %} cst-disabled {% endunless %}">
                                                            <div class="cst-product-image-wrapper">
                                                                <link rel="preload" as="image" href="{{ variant_img }}">
                                                                <img
                                                                class="cst-product-image skeleton"
                                                                src="{{ variant_img }}"
                                                                alt="{{ product.title }}"
                                                                width="100%"
                                                                height="auto"
                                                                loading="lazy"
                                                                onload="this.classList.remove('skeleton')"
                                                                />
                                                            </div>
                                                          </div>
                                                        </div>
                                                    </div>
                                                    {% endif %}
                                                {% endunless %}
                                                {% endfor %}
                                            </div>
                                        </div>
                                        <div class="bpp-product-content">
                                        <a class="cst-product-title" href="{{ product.url }}"><h3>{{ product.title }}</h3></a>

                                        {% if product.description != blank %}
                                            <div class="bpp-product-description">{{ product.description }}</div>
                                        {% endif %}

                                        <div class="cst-swatches">
                                          <div class="swiper-button-prev cst-swatch-prev"></div>
                                          <div class="cst-swatch-slider">
                                            <div class="cst-swatch-wrapper swiper-wrapper">
                                              {% assign color_option_names = 'color,colour' | split: ',' %}

                                              {% for option in product.options_with_values %}
                                                  {% assign option_name_down = option.name | downcase %}
                                                  {% assign option_index = option.position | minus: 1 %}

                                                  {% if color_option_names contains option_name_down %}

                                                    {% for color in option.values %}

                                                      {% for variant in product.variants %}
                                                          {% if variant.options[option_index] == color and variant.metafields.custom.hide_variant_from_collection_page == true %}
                                                            {% continue %}
                                                          {% endif %}
                                                      
                                                          {% if variant.options[option_index] == color %}

                                                              {%- comment -%}
                                                                Priority:
                                                                1. Variant swatch (image or color)
                                                                2. Metafield swatch fallback
                                                              {%- endcomment -%}

                                                              {% comment %}
                                                              {% assign swatches = product.metafields.alt.swatches.value %}
                                                              {% assign this_swatch = blank %} 
                                                              {% if color.swatch.image %}
                                                                {% assign this_swatch = color.swatch %}
                                                              {% elsif color.swatch.color %}
                                                                {% assign this_swatch = color.swatch %}
                                                              {% else %}
                                                                {% for swatch in swatches %}
                                                                  {% assign swatch_color_down = swatch.colour | downcase %}
                                                                  {% assign color_down = color | downcase %}
                                                                  {% assign swatch_name_down = swatch.name | downcase %}

                                                                  {% if color_down contains swatch_name_down %}
                                                                    {% if swatch.image or swatch.color %}
                                                                      {% assign this_swatch = swatch %}
                                                                    {% endif %}
                                                                  {% endif %}
                                                                {% endfor %}
                                                              {% endif %} {% endcomment %}

                                                              {% assign variant_img = variant.featured_image | img_url: '100x' %}
                                                              {% unless variant_img contains '.gif' %}
                                                                  {% if variant_img %}
                                                                  <div class="swiper-slide" data-variant-id="{{ variant.id }}">
                                                                      <div class="cst-slide-inner">
                                                                      {% comment %} <a href="{{ variant.url }}" class="cst-image-link {% unless variant.metafields.pickup.shipping_qty > 0 %} cst-disabled {% endunless %}"> {% endcomment %}
                                                                          <div class="cst-swatch-image-wrapper">
                                                                              <img
                                                                              class="cst-swatch-image skeleton"
                                                                              src="{{ variant_img }}"
                                                                              alt="{{ product.title }}"
                                                                              width="100%"
                                                                              height="auto"
                                                                              loading="lazy"
                                                                              onload="this.classList.remove('skeleton')"
                                                                              />
                                                                          </div>
                                                                      {% comment %} </a> {% endcomment %}
                                                                      </div>
                                                                  </div>
                                                                  {% endif %}
                                                              {% endunless %}
                                                            {% break %}
                                                          {% endif %}
                                                      {% endfor %}
                                                    {% endfor %}
                                                  {% endif %}
                                              {% endfor %}
                                            </div>
                                          </div>
                                          <div class="swiper-button-next cst-swatch-next"></div>
                                        </div>
                                        <div class="bpp-popups-btns">
                                          <button class="bpp-quick-add" data-id="{{ product.selected_or_first_available_variant.id }}">quick add</button>
                                          <button class="bpp-quickview_close">
                                              <span>{{ 'accessibility.close' | t }}</span>
                                              {% comment %} <svg width="7" height="7" viewBox="0 0 7 7" fill="none" xmlns="http://www.w3.org/2000/svg">
                                                  <path d="M6.31614 5.88857L3.69688 3.26931L6.3205 0.645696L5.89269 0.217885L3.26907 2.8415L0.64982 0.22225L0.222009 0.650061L2.84126 3.26931L0.217644 5.89293L0.645455 6.32074L3.26907 3.69712L5.88832 6.31638L6.31614 5.88857Z" fill="black" stroke="black" stroke-width="0.308682"/>
                                              </svg> {% endcomment %}
                                          </button>
                                        </div>
                                        </div>
                                        </div>
                                    </div>
                            {% endcapture %}
                        {% else %}
                            {% if block.settings.product_title != blank %}
                                <div class="bpp-product-title">
                                    <span>{%if product_count < 10%}0{%endif%}{{product_count}}.</span> {{ block.settings.product_title }}
                                </div>
                            {% endif %}
                        {% endif %}
                    </div>

                {% when 'content' %}
                    <div class="bpp-content">
                        {{ block.settings.content }}
                    </div>
                
            {% endcase %}
        {% endfor %}
    </div>
</div>

{% if quickview_items != blank %}
<div class="bpp-quickview-product">
    <div class="bpp-product-overlay"></div>
    {{ quickview_items }}
</div>
{% endif %}

<script>
document.addEventListener("DOMContentLoaded", function () {
  document.querySelectorAll(".bpp-quickview-product-item").forEach(function (cd) {
    const card = cd.querySelector(".cst-product-card");
    if (!card) return;

    const mainSliderEle   = card.querySelector(".cst-main-slider");
    const swatchSliderEle = card.querySelector(".cst-swatch-slider");
    const quickAddBtn     = cd.querySelector(".bpp-quick-add");

    if (!mainSliderEle || !swatchSliderEle || !quickAddBtn) return;

    const mainSlides   = mainSliderEle.querySelectorAll(".swiper-slide");
    const swatchSlides = swatchSliderEle.querySelectorAll(".swiper-slide");

    const swatchSwiper = new Swiper(swatchSliderEle, {
      slidesPerView: 10,
      spaceBetween: 4,
      breakpoints: {
        0:   { slidesPerView: 4, spaceBetween: 2 },
        425: { slidesPerView: 5, spaceBetween: 4 },
        768: { slidesPerView: 9, spaceBetween: 4 },
        1200:{ slidesPerView: 9, spaceBetween: 4 }
      },
      navigation: {
        nextEl: card.querySelector(".cst-swatch-next"),
        prevEl: card.querySelector(".cst-swatch-prev"),
      }
    });

    const mainSwiper = new Swiper(mainSliderEle, {
      slidesPerView: 1,
      spaceBetween: 8,
      allowTouchMove: true,
      simulateTouch: true,
      cssMode: false,
      mousewheel: {
        invert: false,
        forceToAxis: true,
      },
      on: {
        slideChange: function () {
          const idx = mainSwiper.activeIndex;

          setSwatchActive(idx);

          swatchSwiper.slideTo(idx, 300);

          const activeMainSlide = mainSlides[idx];
          if (!activeMainSlide) return;

          const variantId = activeMainSlide.getAttribute("data-variant-id");
          if (variantId) {
            quickAddBtn.setAttribute("data-id", variantId);
          }
        }
      }
    });

    function setSwatchActive(activeIndex) {
      swatchSlides.forEach((slide, index) => {
        slide.classList.toggle("cst-active", index === activeIndex);
      });
    }

    swatchSlides.forEach((slideEl, idx) => {
      slideEl.addEventListener("click", function () {
        const variantId = slideEl.getAttribute("data-variant-id");

        mainSwiper.slideTo(idx, 300);

        setSwatchActive(idx);

        if (variantId) {
          quickAddBtn.setAttribute("data-id", variantId);
        }
      });
    });

    (function initState() {
      setSwatchActive(0);

      const firstMainSlide = mainSlides[0];
      if (!firstMainSlide) return;

      const firstVariantId = firstMainSlide.getAttribute("data-variant-id");
      if (firstVariantId) {
        quickAddBtn.setAttribute("data-id", firstVariantId);
      }
    })();
  });
});
</script>

{% schema %}
{
  "name": "BagSpa - Product Popup",
  "tag": "section",
  "class": "section",
  "settings": [
    {
        "type": "select",
        "id": "heading_size",
        "label": "Font Size",
        "options": [
            {
                "label": "S",
                "value": "13px"
            },
            {
                "label": "M",
                "value": "26px"
            },
            {
                "label": "L",
                "value": "36px"
            },
            {
                "label": "XL",
                "value": "50px"
            },
            {
                "label": "XXL",
                "value": "134px"
            }
        ],
        "default":"26px"
    },
    {
        "type": "select",
        "id": "heading_size_m",
        "label": "Font Size (Mobile)",
        "options": [
            {
                "label": "S",
                "value": "13px"
            },
            {
                "label": "M",
                "value": "26px"
            },
            {
                "label": "L",
                "value": "36px"
            },
            {
                "label": "XL",
                "value": "50px"
            },
            {
                "label": "XXL",
                "value": "134px"
            }
        ],
        "default":"26px"
    }
  ], 
  "blocks": [
    {
        "type": "product",
        "name":"Product",
        "settings": [
            {
                "type": "text",
                "id": "product_title",
                "label": "Product Title",
                "info": "This will replace original product title."
            },
            {
                "type": "product",
                "id": "product",
                "label": "Product"
            }
        ]
    },
    {
        "type": "heading",
        "name":"Heading",
        "settings": [
            {
                "type": "textarea",
                "id": "heading",
                "label": "Heading"
            },
            {
                "type": "color",
                "id": "bg_color",
                "label": "Background",
                "default":"#F5E565"
            },
            {
                "type": "color",
                "id": "text_color",
                "label": "Text",
                "default":"#000"
            }
        ]
    },
    {
        "type": "content",
        "name":"Content",
        "settings": [
            {
                "type": "richtext",
                "id": "content",
                "label": "Content"
            }
        ]
    }
  ],
  "presets": [
    {
      "name": "BagSpa - Product Popup",
    }
  ]
}
{% endschema %}