{% style %}
  .template-page-pong .shopify-section.section-header, .template-page-pong .shopify-section.shopify-section-group-footer-group{
    display:none;
  }
  .pong-game-section {
    margin: 0;
    padding: 0;
    width: 100%;
    height: {{ section.settings.section_height | default: '100vh' }};
    overflow: hidden;
    position: relative;
  }

  .pong-game-iframe {
    width: 100%;
    height: 100%;
    border: none;
    display: block;
    margin: 0;
    padding: 0;
  }
  .pong-close-btn {
    position: absolute;
    top: 6px;
    right: 10px;
    background: transparent;
    font-size: 16px;
    line-height: 1;
    cursor: pointer;
    border: 0;
    color: white;
    text-transform: uppercase;
    font-size: 1.3rem;
    font-family: inherit;
    text-transform: uppercase;
  }

  .pong-close-btn:hover {
    opacity: 0.8;
  }

{% endstyle %}

<div class="pong-game-section">
  <button class="pong-close-btn" aria-label="Close Pong">Close</button>
  <iframe 
    class="pong-game-iframe"
    src="{{ section.settings.game_url | default: 'https://pong22.netlify.app/' }}"
    title="Pong Game"
    allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
    allowfullscreen>
  </iframe>
</div>
{% assign templete_name = template | handleize %}
{% if templete_name == 'page-pong' %}
  <script>
    document.addEventListener('click', function (e) {
      if (e.target.closest('.pong-close-btn')) {
        if (window.history.length > 1) {
          window.history.back();
        } else {
          window.location.href = '/';
        }
      }
    });
  </script>
{% endif %}
{% schema %}
{
  "name": "Pong Game",
  "class": "pong-game-section",
  "settings": [
    {
      "type": "text",
      "id": "game_url",
      "label": "Pong Game URL",
      "default": "https://pong22.netlify.app/",
      "info": "Enter the URL of your Pong game"
    },
    {
      "type": "select",
      "id": "section_height",
      "label": "Section Height",
      "options": [
        {
          "value": "100vh",
          "label": "Full Screen (100vh)"
        },
        {
          "value": "90vh",
          "label": "90% Screen Height"
        },
        {
          "value": "80vh",
          "label": "80% Screen Height"
        },
        {
          "value": "70vh",
          "label": "70% Screen Height"
        },
        {
          "value": "600px",
          "label": "Fixed 600px"
        },
        {
          "value": "500px",
          "label": "Fixed 500px"
        },
        {
          "value": "400px",
          "label": "Fixed 400px"
        }
      ],
      "default": "100vh",
      "info": "Choose the height of the game section"
    }
  ],
  "presets": [
    {
      "name": "Pong Game",
      "category": "Custom",
      "settings": {
        "game_url": "https://pong22.netlify.app/",
        "section_height": "100vh"
      }
    }
  ]
}
{% endschema %}