<style>
{% for block in section.blocks %}
    
    {% capture desktop_css %}{{ desktop_css }}
        .ito-content-{{ block.id }}{
            font-size:{{ block.settings.font_size }};
        }
    {% endcapture %}

    {% capture mobile_css %}{{ mobile_css }}
        .ito-content-{{ block.id }}{
            font-size:{{ block.settings.font_size_m }};
            {% if block.settings.hide_mobile %}display:none;{% endif %}
        }
    {% endcapture %}
    .ito-content-{{ block.id }} a{
        color:{{ block.settings.color }};
        text-decoration:underline;
    }
{% endfor %}
.image-text-overlay-wrapper{
    position:relative;
}
.ito-media, .ito-media img, .ito-media video{
    width:100%;
    height:100%;
    object-fit:contain;
    display: flex;
}
.ito-content {
    position: absolute;
    left: 0;
    padding: 25px 45px;
    text-align: left;
}
.ito-content.top{
    top:0;
}
.ito-content.center{
    top:50%;
    transform: translateY(-50%);
}
.ito-content.bottom{
    bottom:0;
}
.ito-content p{
    margin:0;
}
@media (max-width:1024px){
    {{ mobile_css }}
    .ito-content{
        padding: 22px 12px;
    }
}
@media (min-width:1025px){
    {{ desktop_css }}
}
</style>

<div class="image-text-overlay-main {{ section.id }}">
    <div class="image-text-overlay-wrapper">
        <div class="ito-media">
            {% if section.settings.link != blank %}
                <a href="{{ section.settings.link }}" class="overlay-link"></a>
            {% endif %}
            {% if section.settings.image != blank %}
                {% comment %} <img src="{{ section.settings.image | image_url }}" width="auto" height="auto" alt="image-{{ section.settings.image.alt }}"> {% endcomment %}
                <img
                    srcset="
                    {%- if section.settings.image.width >= 165 -%}{{ section.settings.image | image_url: width: 1066 }} 165w,{%- endif -%}
                    {%- if section.settings.image.width >= 360 -%}{{ section.settings.image | image_url: width: 1066 }} 360w,{%- endif -%}
                    {%- if section.settings.image.width >= 533 -%}{{ section.settings.image | image_url: width: 2000 }} 533w,{%- endif -%}
                    {%- if section.settings.image.width >= 720 -%}{{ section.settings.image | image_url: width: 2000 }} 720w,{%- endif -%}
                    {%- if section.settings.image.width >= 940 -%}{{ section.settings.image | image_url: width: 2000 }} 940w,{%- endif -%}
                    {%- if section.settings.image.width >= 1066 -%}{{ section.settings.image | image_url: width: 2000 }} 1066w,{%- endif -%}
                    {%- if section.settings.image.width >= 1550 -%}{{ section.settings.image | image_url: width: 1550 }} 1550w,{%- endif -%}
                    {%- if section.settings.image.width >= 2000 -%}{{ section.settings.image | image_url: width: 2000 }} 2000w,{%- endif -%}
                    {%- if section.settings.image.width >= 2500 -%}{{ section.settings.image | image_url: width: 2500 }} 2500w,{%- endif -%}
                    {{ section.settings.image | image_url }} {{ section.settings.image.width }}w
                    "
                    src="{{ section.settings.image | image_url: width: 1300 }}"
                    class="motion-reduce"
                    sizes="(min-width: 990px) calc((100vw - 130px) / 4), (min-width: 750px) calc((100vw - 120px) / 3), calc((100vw - 35px) / 2)"
                    alt="{{ section.settings.image.alt | escape }}"
                    loading="lazy"
                    width="{{ section.settings.image.width }}"
                    height="{{ section.settings.image.height }}"
                >
            {% elsif section.settings.video != blank %}
                {{ section.settings.video | video_tag:autoplay:true, loop:true, muted:true, controls: false }}
            {% else %}
                {{ 'detailed-apparel-1' | placeholder_svg_tag: 'placeholder-svg' }}
            {% endif %}
        </div>
        {% for block in section.blocks %}
            <div class="ito-content ito-content-{{ block.id }} {{ block.settings.position }}" 
                style="color:{{ block.settings.color }};text-transform:{{ block.settings.font_style }};"
            >
                {{ block.settings.text }}
            </div>
        {% endfor %}
    </div>
</div>

{% schema %}
{
  "name": "Image-Text Overlay",
  "tag": "section",
  "class": "section",
  "settings": [
    {
        "type": "image_picker",
        "id": "image",
        "label": "Image"
    },
    {
        "type": "video",
        "id": "video",
        "label": "Video"
    },
    {
        "type": "url",
        "id": "link",
        "label": "Media link"
    },
  ], 
  "blocks": [
    {
        "type": "text",
        "name":"Text",
        "settings": [
            {
                "type": "richtext",
                "id": "text",
                "label": "Text",
                "default":"<p>laoreet dolore magna lorem ipsum</p>"
            },
            {
                "type": "select",
                "id": "font_size",
                "label": "Font Size",
                "options": [
                    {
                        "label": "S",
                        "value": "13px"
                    },
                    {
                        "label": "M",
                        "value": "26px"
                    },
                    {
                        "label": "L",
                        "value": "36px"
                    },
                    {
                        "label": "XL",
                        "value": "50px"
                    },
                    {
                        "label": "XXL",
                        "value": "134px"
                    }
                ],
                "default":"36px"
            },
            {
                "type": "select",
                "id": "font_size_m",
                "label": "Font Size (Mobile)",
                "options": [
                    {
                        "label": "S",
                        "value": "13px"
                    },
                    {
                        "label": "M",
                        "value": "26px"
                    },
                    {
                        "label": "L",
                        "value": "36px"
                    },
                    {
                        "label": "XL",
                        "value": "50px"
                    },
                    {
                        "label": "XXL",
                        "value": "134px"
                    }
                ],
                "default":"26px"
            },
            {
                "type": "color",
                "id": "color",
                "label": "Text Color",
                "default":"#fff"
            },
            {
                "type": "select",
                "id":"font_style",
                "label": "Font Style",
                "options": [
                    {
                        "value": "uppercase",
                        "label": "Uppercase"
                    },
                    {
                        "value": "capitalize",
                        "label": "Capitalize"
                    },
                    {
                        "value": "lowercase",
                        "label": "Lowercase"
                    },
                    {
                        "value": "unset",
                        "label": "Normal"
                    },
                ],
                "default":"uppercase"
            },
            {
                "type": "checkbox",
                "id": "hide_mobile",
                "label": "Hide in Mobile ?"
            },
            {
                "type": "header",
                "content": "Position"
            },
            {
                "type": "select",
                "id":"position",
                "label": "Position",
                "options": [
                    {
                        "value": "top",
                        "label": "Top"
                    },
                    {
                        "value": "center",
                        "label": "Center"
                    },
                    {
                        "value": "bottom",
                        "label": "Bottom"
                    }
                ],
                "default":"top"
            }
        ]
    }
  ],
  "presets": [
    {
      "name": "Image-Text Overlay",
      "blocks": [
        {
            "type": "text",
            "settings": {
                "position":"top"
            }
        },
        {
            "type": "text",
            "settings": {
                "position":"center"
            }
        },
        {
            "type": "text",
            "settings": {
                "position":"bottom"
            }
        }
      ]
    }
  ]
}
{% endschema %}
