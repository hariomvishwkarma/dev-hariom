        },
        {
            "type": "select",
            "id": "content_size_m",
            "label": "Content - Font Size (Mobile)",
            "options": [
                {
                    "label": "S",
                    "value": "13px"
                },
                {
                    "label": "M",
                    "value": "26px"
                },
                {
                    "label": "L",
                    "value": "36px"
                },
                {
                    "label": "XL",
