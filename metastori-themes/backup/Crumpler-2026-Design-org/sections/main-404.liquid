<style type="text/css">
  .template-404 .title + * {
    margin-top: 1rem;
  }
  .content-404-p{
    font-size:{{ section.settings.content_size_m }};
  }
  .page-title{
    font-size:{{ section.settings.heading_size_m }};
  }

  @media screen and (min-width: 750px) {
    .template-404 .title + * {
      margin-top: 2rem;
    }
    .content-404-p{
      font-size:{{ section.settings.content_size }};
    }
    .page-title{
      font-size:{{ section.settings.heading_size }};
    }
  }
  .media-404-item {
    display: flex;
    justify-content: center;
  }
  .media-404-item img, .media-404-item video {
    max-width: 100%;
    object-fit: contain;
  }
  .page-404-wrapper{
    display: flex;
    flex-direction: column;
    gap: 25px;
    align-items: center;
    padding: 5rem 0;
  }
  .page-404-wrapper h1, .content-404-p p {
    margin: 0;
  }
  .content-404-p a{
    background: #000;
    color: #fff;
    text-transform: uppercase;
    padding: 0 4px;
  }
</style>

<div class="template-404 page-width center">
  {% comment %}
  <p>
    {{ 'templates.404.title' | t }}
  </p>
  <a href="{{ routes.all_products_collection_url }}" class="button">
    {{ 'general.continue_shopping' | t }}
  </a>  
  {% endcomment %}
   <div class="page-404-wrapper">
      <h1 class="page-title title">
        {{ section.settings.heading }}
        {% comment %} {{ 'templates.404.subtext' | t }} {% endcomment %}
      </h1>
      {% if section.settings.image != blank %}
        <div class="media-404-item">
          {% assign image_height = section.settings.image.width | divided_by: section.settings.image.aspect_ratio | round %}
          {{ section.settings.image
          | image_url: width: 3840
          | image_tag:
              width: section.settings.image.width,
              height: image_height,
              class: 'desktop_img',
              sizes: '100vw',
              widths: '750, 1100, 1500, 1780, 2000, 3000, 3840'
          }}

          {% if section.settings.image_m != blank %}
              {% assign mobile_height = section.settings.image_m.width | divided_by: section.settings.image_m.aspect_ratio | round %}
              {{ section.settings.image_m
                  | image_url: width: 750
                  | image_tag:
                  width: section.settings.image_m.width,
                  height: mobile_height,
                  class: 'mobile_img',
                  sizes: '100vw',
                  widths: '320, 375, 414, 550, 750'
              }}
          {% else %}
              {% assign mobile_height = section.settings.image.width | divided_by: section.settings.image.aspect_ratio | round %}
              {{
                  section.settings.image
                  | image_url: width: 750
                  | image_tag:
                  width: section.settings.image.width,
                  height: mobile_height,
                  class: 'mobile_img',
                  sizes: '100vw',
                  widths: '320, 375, 414, 550, 750'
              }}
          {% endif %}
      </div>
      {% elsif section.settings.video != blank %}
        <div class="media-404-item">
            {{ section.settings.video | video_tag:autoplay:true, loop:true, muted:true, class:'desktop_video' }}
            {% if section.settings.video_m != blank %}
                {{ section.settings.video_m | video_tag:autoplay:true, loop:true, muted:true, class:'mobile_video' }}
            {% else %}
                {{ section.settings.video | video_tag:autoplay:true, loop:true, muted:true, class:'mobile_video' }}
            {% endif %}
        </div>
      {% endif %}
      {% if section.settings.content != blank %}
        <div class="content-404-p">
          {{ section.settings.content }}
        </div>
      {% endif %}
  </div>
</div>

{% schema %}
