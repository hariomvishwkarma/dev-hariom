      "settings": {
        "custom_liquid": "<style>\n  .idle-pop {\n    position: fixed;\n    pointer-events: none;\n    z-index: 999999;\n    opacity: 0;\n    transform: scale(0.8);\n    transition: opacity 120ms ease, transform 120ms ease;\n  }\n  .idle-pop.show { opacity: 1; transform: scale(1); }\n  .idle-pop img { display:block; width:140px; height:auto; }\n</style>\n\n<script>\n(() => {\n  const IDLE_MS = 6000;\n  const REPEAT_MS = 900;\n  const MARGIN = 12;\n\n  const MAX_POPS = 25;\n  const RECYCLE_OLDEST = true;\n\n  const POP_SRC = \"https://cdn.shopify.com/s/files/1/0565/5114/5551/files/inflated.png?v=1771287710\";\n\n  let idleTimer = null;\n  let repeatTimer = null;\n  let idle = false;\n\n  const pops = [];\n\n  const rand = (min, max) => Math.floor(Math.random() * (max - min + 1)) + min;\n\n  function clearPops() {\n    // Remove all existing popups from DOM\n    for (const el of pops) el.remove();\n    pops.length = 0; // clear array in-place\n  }\n\n  function spawnImage() {\n    if (pops.length >= MAX_POPS) {\n      if (!RECYCLE_OLDEST) return;\n      const oldest = pops.shift();\n      oldest?.remove();\n    }\n\n    const wrapper = document.createElement(\"div\");\n    wrapper.className = \"idle-pop\";\n\n    const img = document.createElement(\"img\");\n    img.loading = \"lazy\";\n    img.decoding = \"async\";\n    img.src = POP_SRC;\n\n    wrapper.appendChild(img);\n    document.body.appendChild(wrapper);\n    pops.push(wrapper);\n\n    requestAnimationFrame(() => {\n      const rect = wrapper.getBoundingClientRect();\n      const w = rect.width || 140;\n      const h = rect.height || 140;\n\n      const maxX = Math.max(MARGIN, window.innerWidth - w - MARGIN);\n      const maxY = Math.max(MARGIN, window.innerHeight - h - MARGIN);\n\n      wrapper.style.left = rand(MARGIN, maxX) + \"px\";\n      wrapper.style.top  = rand(MARGIN, maxY) + \"px\";\n      wrapper.classList.add(\"show\");\n    });\n  }\n\n  function enterIdle() {\n    if (idle) return;\n    idle = true;\n    spawnImage();\n    repeatTimer = setInterval(spawnImage, REPEAT_MS);\n  }\n\n  function exitIdle() {\n    idle = false;\n    clearInterval(repeatTimer);\n    repeatTimer = null;\n  }\n\n  function resetIdleTimer() {\n    exitIdle();\n    clearPops();\n\n    clearTimeout(idleTimer);\n    idleTimer = setTimeout(enterIdle, IDLE_MS);\n  }\n\n  [\"mousemove\",\"mousedown\",\"keydown\",\"scroll\",\"touchstart\",\"pointerdown\"]\n    .forEach(evt => window.addEventListener(evt, resetIdleTimer, { passive: true }));\n\n  resetIdleTimer();\n})();\n</script>",
