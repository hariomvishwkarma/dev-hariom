            },
            {
                "type": "image_picker",
                "id": "image",
                "label": "Image",
                "info":"If filled, replace original product image."
            },
            {
                "type": "video",
                "id": "video",
                "label": "Video"
            },
            {
                "type": "text",
                "id": "text",
                "label": "Text",
                "info":"Custom text instead of Product title. Followed by dynamic pricing."
            },
            {
                "type": "checkbox",
