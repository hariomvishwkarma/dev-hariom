    {
        "type":"product",
        "name":"Product",
        "settings": [
            {
                "type": "select",
                "id": "column",
                "label": "Column",
                "options": [
                    {
                        "value":"one",
                        "label": "1"
                    },
                    {
                        "value":"two",
                        "label": "2"
                    },
                    {
                        "value":"three",
                        "label": "3"
                    },
                    {
                        "value":"four",
                        "label": "4"
                    },
                    {
                        "value":"five",
                        "label": "5"
                    },
                    {
                        "value":"six",
                        "label": "6"
                    },
                    {
                        "value":"seven",
                        "label": "7"
                    },
                    {
                        "value":"eight",
                        "label": "8"
                    },
                ],
                "default":"one"
            },
            {
                "type": "product",
                "id":"product",
                "label": "Product"
            },
            {
                "type": "text",
                "id": "variant_id",
