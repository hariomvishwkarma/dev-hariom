    const country = "{{ localization.country.iso_code }}";
    if (country === "SG") {
      document.querySelectorAll('.delivery_tab_btn[country_name="Singapore"]').forEach(b => b.click());
    }
    if (country === "JP") {
      document.querySelectorAll('.delivery_tab_btn[country_name="Japan"]').forEach(b => b.click());
    }

  });

</script>

