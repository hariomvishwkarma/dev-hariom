    .sticky-add-cart, .mobile-sts-atc {
      max-width: 230px;
      width: 100%;
      display: inline-flex;
      align-items: center;
      height: 42.85px;
      border: 1.43px solid #000000;
      background: #EEEEEE;
      border-radius: 10px;
      text-align: center;
