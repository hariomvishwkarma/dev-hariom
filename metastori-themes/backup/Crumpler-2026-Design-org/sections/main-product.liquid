<style>
    .shopify-section.product-section{
      z-index: 2;
      position: relative;
    }
      #{{ section.id }} * {
        box-sizing: border-box;
        margin: 0;
        
      }
      .pdp_paypal_main{
        font-size:13px;
      }
      #{{ section.id }} .container {
        display: grid;
        grid-template-columns: 1fr 2fr;
        align-items: flex-start;
        padding-left:18px;
        margin: auto;
        background: #fff;
        gap: 0px;
      }
  
      #{{ section.id }} .left {
        width: 100%;
        height:100%;
        {% comment %} line-height: 100%; {% endcomment %}
      }
      .show_shiping_info-false {
        margin-top: 6px !important;
      }
      @media (min-width:1025px){
        #{{ section.id }} .left {
          position: sticky;
          top: 23px;
          height: fit-content;
          padding-right: 16px;
        }
      }
  
      #{{ section.id }} .product-title {
        font-weight: 700;
        font-size: 13px;
      }
  
      #{{ section.id }} .price {
        font-size: 13px;
        font-weight: 500;
        opacity:1;
      }
  
      #{{ section.id }} .size,
      #{{ section.id }} .color {
        font-size: 13px;
        font-weight: 500;
        {% comment %} line-height: 110%; {% endcomment %}
      }
      #{{ section.id }} .size{
        display: flex;
        gap: 5px;
      }
  
      #{{ section.id }} .sizes .size-option {
        margin-right: 8px;
        cursor: pointer;
        color:#C4C4C4;
        text-decoration: none;
      }
  
      #{{ section.id }} .sizes .size-option.active {
        color:#000;
      }
  
      .color-boxes span{
        display: inline-block;
        width: 27.7px;
        height: 12.5px;
        cursor: pointer;
      }
  
      #{{ section.id }} .color-boxes span {   
        background-position: center;
        background: transparent;
        background-size: cover;
        position: relative;
        outline: 0.8px solid transparent;
        border: 0.8px solid transparent;
      }
      #{{ section.id }} .color-boxes span.color-option.active {
        outline: 0.8px solid #000;
        border: 0.8px solid #fff;
      }
  
      #{{ section.id }} .desc {
        font-size: 13px;
        font-weight: 500;
        margin-top: 14px;
      }
      #{{ section.id }} .desc.mobile {
        display:none;
        text-align:left;
        margin-top:70px;
        text-transform: uppercase;
      }
      #{{ section.id }}.gift-product-section .desc.mobile {
        text-transform: none;
        margin-top: 30px;
      }
      .custom-3d-video-right iframe {
        pointer-events: none;
      }
      #{{ section.id }} .check-avalablity {
        color: #000;
        font-size: 13px;
        text-decoration: underline;
        display: inline-block;
        margin-bottom: 20px;
        font-weight: 450;
      }
  
      #{{ section.id }} .add-cart {
        display: inline-block;
        border: 1px solid #000;
        border-radius: 7px;
        padding: 6px 40px;
        background: #eee;
        cursor: pointer;
        font-size: 13px;
        min-width: 161px;
        transition: all .5s;
        font-weight: 500;
        margin-top: 28px;
        min-height: 30px;
        font-family: var(--font-body-family);
      }
      #{{ section.id }}.gift-product-section .add-cart{
        margin-top: 10px;
      }
      #{{ section.id }} .add-cart:hover {
        background: #ddd;
      }
  
      #{{ section.id }} .small-text {
        font-size: 13px;
        font-weight: 500;
        margin-top:6px;
      }
  
      #{{ section.id }} .tabs {
        display: flex;
        margin-top: 16px;
        flex-wrap:wrap;
      }
  
      #{{ section.id }} .tabs span {
        font-size: 13px;
        margin-right: 12px;
        font-weight: 600;
        text-transform: capitalize;
        color: #C4C4C4;
        cursor: pointer;
      }
  
      #{{ section.id }} .tabs span.active {
        color: #000;
        font-weight: bold;
        text-decoration: underline;
      }
  
      #{{ section.id }} .tab-content {
        font-size: 13px;
        display: none;
        margin-top:10px;
        font-weight: 600;
        line-height:120%;
      }
  
      #{{ section.id }} .tab-content.active {
        display: block;
      }
  
      #{{ section.id }} .tab-content ul {
        list-style: decimal-leading-zero;
        padding-left: 20px;
      }

      .image-magnify-full-size {
          cursor: zoom-out;
          z-index: 1;
          margin: 0;
          border-radius: calc(var(--media-radius) - var(--media-border-width));
          display: block !important;
          max-width: 100%;
          position: absolute;
          top: 0;
          left: 0;
          height: 100%;
          width: 100%;
        }
        .img-magnify-hover {
          cursor: zoom-in;
        }
  
      /* Swiper Styles */
      #{{ section.id }} .swiper-container {
        width: 100%;
        position: relative;
        {% comment %} border-radius: 4px; {% endcomment %}
        overflow: hidden;
      }
  
      #{{ section.id }} .swiper {
        width: 100%;
        height: 100%;
      }
  
      #{{ section.id }} .swiper-slide {
        text-align: center;
        font-size: 18px;
        background: #f2f2f2;
        display: flex;
        justify-content: center;
        align-items: center;
      }
  
      #{{ section.id }} .swiper-slide img {
        display: block;
        width: 100%;
        height: 100%;
        object-fit: cover;
      }
  
      #{{ section.id }} .swiper-button-next,
      #{{ section.id }} .swiper-button-prev {
        color: #000;
        background: rgba(255, 255, 255, 0.7);
        width: 40px;
        height: 40px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
      }
  
      #{{ section.id }} .swiper-button-next:after,
      #{{ section.id }} .swiper-button-prev:after {
        font-size: 18px;
        font-weight: bold;
      }
  
      #{{ section.id }} .swiper-pagination-bullet {
        width: 10px;
        height: 10px;
        background: #fff;
        opacity: 0.5;
      }
  
      #{{ section.id }} .swiper-pagination-bullet-active {
        opacity: 1;
        background: #000;
      }
  
      #{{ section.id }} .swiper-thumbs {
        margin-top: 10px;
        display: flex;
        gap: 2px;
        overflow-x: auto;
        padding: 10px 10px 15px;
        scrollbar-width: none;
        position: absolute;
        bottom: 0;
        left: 50%;
        transform: translateX(-50%);
        z-index: 1;
        width: fit-content;
        justify-content: center;
      }
  
      /* For WebKit browsers (Chrome, Safari, Edge) */
      #{{ section.id }} .swiper-thumbs::-webkit-scrollbar {
        display: none;
      }
  
      #{{ section.id }} .swiper-thumb {
        width: 29px;
        height: 39px;
        cursor: pointer;
        border: 1.16px solid white;
        /*outline: 2px solid white;
        outline-offset: 2px;*/
        flex-shrink: 0;
        opacity: 1;
        transition: opacity 0.3s, border-color 0.3s;
      }
  
      #{{ section.id }} .swiper-thumb.active {
        opacity: 1;
        outline-color: #000;
        border-color:#000;
      }
  
      #{{ section.id }} .swiper-thumb img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        overflow:hidden;
      }
      #{{ section.id }} .tabs-wrapper.mobile{
        display:none;
      }
  
      #{{ section.id }} .image-wrapper img {
      overflow: hidden;
      width: 100%;
      height: 100%;
      background-color: #f2f2f2;
      object-fit: cover;
    }
    #{{ section.id }} .feature-tab__title,
    #{{ section.id }} .material-tab__title {
      border: none;
      background: none;
      font-size: 13px;
      font-weight: 600;
      margin-bottom: 3px;
      color: #000000;
      text-transform: uppercase;
    }
    #{{ section.id }} .metafield-rich_text_field
    {
      margin-bottom:0px !important;
    }
    #{{ section.id }} .right{
      width:100%;
      display:grid;
       grid-template-columns: 1fr 1fr;
         gap: 3px;
    }
    #{{ section.id }} .right-container{
      width:100%;
      display:grid;
  
    }
    .custom-liquid-block * {
      font-weight:600 !important;
    }
  
