<script>  
  function update_pdp_info(wrapper){
    const content = wrapper.querySelector('.metafield-rich_text_field');
    const btn = wrapper.querySelector('.read-more-btn');
  
    if (!content || !btn) return;
  
      const lineHeight = parseFloat(getComputedStyle(content).lineHeight);
      const maxLines = 10;
      const maxHeight = lineHeight * maxLines;
  
      content.style.display = '-webkit-box';
      const fullHeight = content.scrollHeight;
  
      if (fullHeight > maxHeight + 2) {
        btn.style.display = 'inline';
      }
  }
  
  document.addEventListener('DOMContentLoaded', function () {
    initProductSection('{{ section.id }}');
  
    document.querySelectorAll('.popup-box').forEach((el) => {
      const btn = el.querySelector('.popup-btn');
      const valueBox = el.querySelector('.value');
  
      if (btn && valueBox) {
        btn.addEventListener('click', () => {
          valueBox.classList.toggle('open');
          btn.textContent = valueBox.classList.contains('open') ? '!' : '?';
        });
      }
    });
  
    document.querySelectorAll('.read-more-btn').forEach((btn)=>{
      btn.addEventListener('click', () => {
        const wrapper = btn.closest('.pdp_product_content');
        wrapper.classList.toggle('pc_expand');
        btn.textContent = wrapper.classList.contains('pc_expand')
          ? 'Read Less'
          : 'Read More';
      });
    });
  
    const ft_popup_wrapper = document.querySelector('.featured_tab_popup_wrapper');
    const ft_overlay = document.querySelector('.featured_tab_overlay');
    const product_section = document.querySelector('.shopify-section.product-section');
    const ft_tab_closebtn = document.querySelector('.ft_tab_closebtn');
  
    document.querySelectorAll('.featured_tab_btn').forEach((btn) => {
      btn.addEventListener('click', () => {
        if (!ft_popup_wrapper) return;
  
        const popup_id = btn.getAttribute('popup');
        document.querySelectorAll('.featured_tab_btn').forEach((bt) => {
          bt.classList.remove('active_bt');
        });
        document.querySelectorAll(`.featured_tab_btn[popup="${popup_id}"]`).forEach((bt) => {
          bt.classList.add('active_bt');
        });
  
        ft_popup_wrapper.classList.add('active_ft');
        product_section.classList.add('pactive_ft');
  
        document.querySelectorAll('.featured_tab_popup_data').forEach((el) => {
          el.style.display = 'none';
        });
  
        const activePopup = ft_popup_wrapper.querySelector(
          `.featured_tab_popup_data[popup="${popup_id}"]`
        );
  
        if (activePopup) {
          activePopup.style.display = 'flex';
        }
      });
    });
  
    if (ft_overlay) {
      ft_overlay.addEventListener('click', () => {
        if (ft_popup_wrapper) {
          ft_popup_wrapper.classList.remove('active_ft');
          document.querySelectorAll('.featured_tab_btn').forEach((bt) => {
            bt.classList.remove('active_bt');
            product_section.classList.remove('pactive_ft');
          });
        }
      });
    }
  
    if(ft_tab_closebtn){
      ft_tab_closebtn.addEventListener('click', () => {
        if (ft_popup_wrapper) {
          ft_popup_wrapper.classList.remove('active_ft');
          document.querySelectorAll('.featured_tab_btn').forEach((bt) => {
            bt.classList.remove('active_bt');
            product_section.classList.remove('pactive_ft');
          });
        }
      });
    }
  
    {% comment %} const closeCursor = document.querySelector('.close-cursor');
    if (ft_overlay && closeCursor) {
      ft_overlay.addEventListener('mouseenter', () => {
        closeCursor.style.display = 'block';
      });
  
      ft_overlay.addEventListener('mouseleave', () => {
        closeCursor.style.display = 'none';
      });
  
      ft_overlay.addEventListener('mousemove', (e) => {
        closeCursor.style.left = e.clientX + 'px';
        closeCursor.style.top = e.clientY + 'px';
      });
    } {% endcomment %}
  
    {% comment %} document.querySelectorAll('.pdp_product_info .pdp_product_content').forEach(wrapper => {
      update_pdp_info(wrapper);
    }); {% endcomment %}
  
    const delivery_btn = document.querySelectorAll('.pc_delivery_btn');
    delivery_btn.forEach((btn)=>{
      btn.addEventListener('click', () => {
          btn.closest('.pc_delivery_main').classList.toggle('delivery_expand');
          btn.textContent = btn.closest('.pc_delivery_main').classList.contains('delivery_expand')
            ? 'Delivery Info -'
            : 'Delivery Info +';
      });
    });
  
    const triggerEl = document.querySelector('.mobile-sts-atc');
    const stickyATC = document.querySelector('.button-slide-block');
    const swiperEl = document.querySelector('.right .swiper-container');
  
    let triggerOut = false;
    let swiperVisible = false;
  
    function updateSticky() {
      if (triggerOut && !swiperVisible) {
        stickyATC.classList.add('open');
      } else {
        stickyATC.classList.remove('open');
      }
    }
    if (triggerEl && stickyATC) {
      const triggerObserver = new IntersectionObserver(
        ([entry]) => {
          triggerOut = !entry.isIntersecting;
          updateSticky();
        },
        { threshold: 0 }
      );
      triggerObserver.observe(triggerEl);
    }
  
    if (swiperEl && stickyATC) {
      const swiperObserver = new IntersectionObserver(
        ([entry]) => {
          swiperVisible = entry.isIntersecting;
          updateSticky();
        },
        { threshold: 0.1 }
      );
      swiperObserver.observe(swiperEl);
    }
  
    document.querySelectorAll('.m-sticky-atc').forEach((btn) => {
      btn.addEventListener('click', (e) => {
        e.preventDefault();
        const desktopATC = document.querySelector('.desktop_atc_form .add-cart');
        if (desktopATC) {
          desktopATC.click();
        }
      });
    });
  
    //-------------Stop ATC Button Sticky -------------------
    const stickyMobileATC = document.querySelector(".button-slide-block");
    const stopPoint = document.querySelector(".featured_tabs_mobile");
    if (!stickyMobileATC || !stopPoint) return;
  
    const stikcyObserver = new IntersectionObserver(
      (entries) => {
        entries.forEach(entry => {
          if (entry.isIntersecting) {
            stickyMobileATC.classList.add("open");
            //stickyMobileATC.classList.add("stop-sticky");
          } else {
            stickyMobileATC.classList.remove("open");
            //stickyMobileATC.classList.remove("stop-sticky");
          }
        });
      },
      {
        root: null,
        threshold: 0,
      }
    );
    stikcyObserver.observe(stopPoint);
    {% comment %} const stickyMobileATC = document.querySelector(".button-slide-block");
    const stopDeliveryPoint = document.querySelector(".delivery_drop_mobile .delivery_country_list_dropdown");
  
    if (stickyMobileATC && stopDeliveryPoint) {
      function handleStickyStop() {
        const stopRect = stopDeliveryPoint.getBoundingClientRect();
        const viewportHeight = window.innerHeight;
  
        if (stopRect.top <= viewportHeight) {
          stickyMobileATC.classList.add("stop-sticky");
        } else {
          stickyMobileATC.classList.remove("stop-sticky");
        }
      }
  
      window.addEventListener("scroll", handleStickyStop);
      window.addEventListener("resize", handleStickyStop);
      handleStickyStop();
    } {% endcomment %}
  
  });
  
  document.addEventListener('click', function (e) {
    const mobile_pick_up = e.target.closest('.mobile_pick_up_availabilities');
    if (!mobile_pick_up) return;
  
    const ShowPickupAvailability = document.querySelector('#ShowPickupAvailabilityDrawer');
    if (ShowPickupAvailability) ShowPickupAvailability.click();
  });
  
  function initProductSection(sectionId) {
    let mainSwiper;
    let filteredSlides = [];
    let filteredThumbs = [];
    let hasAutoScrolled = false; // Track if auto-scroll has been performed
  
    // Initialize Swiper after filtering
    function initializeSwiper() {
      if (mainSwiper) {
        mainSwiper.destroy(true, true);
      }
  
      mainSwiper = new Swiper(`#main-swiper-${sectionId}`, {
        loop: false,
        spaceBetween: 0,
        navigation: {
          nextEl: `.swiper-button-next`,
          prevEl: `.swiper-button-prev`,
        },
  
        pagination: {
          el: `.swiper-pagination`,
          clickable: true,
        },
        scrollbar: {
          el: '.swiper-scrollbar',
          hide: true,
        },
        on: {
          init: function () {
            if(filteredThumbs[1]){
              filteredThumbs[1].classList.add('active');
            }
            // Auto-scroll to second slide only once after initialization
            {% comment %} if (window.innerWidth > 768) {
              if (this.slides.length > 1) {
                setTimeout(() => {
                  this.slideTo(1, 0, false); // Desktop → Go to slide 2
                }, 0);
              }
            } {% endcomment %}
          },
        },
      });
  
      // Update active thumb when main swiper slides
      mainSwiper.on('slideChange', function () {
        let activeIndex;
        if (window.innerWidth > 768) {
          activeIndex = mainSwiper.activeIndex + 1;
        }
        else{
          activeIndex = mainSwiper.activeIndex;
        }
        document.querySelectorAll(`#${sectionId} .swiper-thumb`).forEach((t) => t.classList.remove('active'));
        if (filteredThumbs[activeIndex]) {
          filteredThumbs[activeIndex].classList.add('active');
        }
      });
    }
  
    // Update the main image with the current slide image
    function updateMainImage(slideIndex) {
      const mainImage = document.getElementById(`main-image-${sectionId}`);
      const activeSlide = mainSwiper.slides[slideIndex];
  
      if (activeSlide && mainImage) {
        const slideImg = activeSlide.querySelector('img');
        if (slideImg) {
          mainImage.src = slideImg.src;
          if (slideImg.srcset) {
            mainImage.srcset = slideImg.srcset;
          } else {
            mainImage.removeAttribute('srcset');
          }
          if (slideImg.sizes) {
            mainImage.sizes = slideImg.sizes;
          }
          mainImage.alt = slideImg.alt || '';
        }
      }
    }
  
    // Thumbnail click functionality
    function initThumbnailClicks() {
      document.querySelectorAll(`#${sectionId} .swiper-thumb`).forEach((thumb, index) => {
        thumb.addEventListener('click', function () {
          if (this.style.display !== 'none') {
            document.querySelectorAll(`#${sectionId} .swiper-thumb`).forEach((t) => t.classList.remove('active'));
            this.classList.add('active');
  
            // Find the index in filtered slides
            const thumbIndex = Array.from(this.parentNode.children).indexOf(this);
            const slideIndex = Array.from(mainSwiper.slides).indexOf(
              document.querySelectorAll(`#${sectionId} .swiper-slide`)[thumbIndex]
            );
  
            if (slideIndex !== -1) {
              if (window.innerWidth > 768) {
                mainSwiper.slideTo(slideIndex - 1);
              }else{
                mainSwiper.slideTo(slideIndex);
              }
            }
          }
        });
      });
    }
  
    document.querySelectorAll(`#${sectionId} .tabs span`).forEach((tab) => {
      tab.addEventListener('click', function () {
        const tabId = this.getAttribute('data-tab');
        const content = document.getElementById(tabId);
  
        const isActive = this.classList.contains('active');
  
        // RESET everything first
        document.querySelectorAll(`#${sectionId} .tabs span`).forEach((t) => {
          t.classList.remove('active');
          const p = t.querySelector('p');
          if (p) p.style.transform = 'rotate(0deg)';
        });
  
        document.querySelectorAll(`#${sectionId} .tab-content`).forEach((c) => c.classList.remove('active'));
  
        // If the clicked tab was active → close it (toggle off)
        if (isActive) return;
  
        // If not active → open it
        this.classList.add('active');
  
        const p = this.querySelector('p');
        if (p) p.style.transform = 'rotate(180deg)';
  
        content.classList.add('active');
      });
    });
  
    // Color variant change functionality
    function initColorVariantChanges() {
      const colorOptions = document.querySelectorAll(`#${sectionId} .color-option`);
      const mainSwiperSlides = document.querySelectorAll(`#${sectionId} .swiper-slide`);
      const thumbnails = document.querySelectorAll(`#${sectionId} .swiper-thumb`);
      const selectedColorSpan = document.querySelector(`#${sectionId} #selected-color`);
      const variantSelect = document.querySelector(`#${sectionId} #product-select-${sectionId}`);
      const swiperWrapper = document.querySelector(`#${sectionId} .swiper-wrapper`);
      const gift_variants = document.querySelectorAll('.gift_variant_radio');
  
      // Extract color from alt text
      function extractColorFromAlt(altText) {
        const colorMatch = altText.match(/\|\s*Colou?r:\s*([^,|]+)/i);
        return colorMatch ? colorMatch[1].trim() : null;
      }
  
      // Remove all slides from swiper
      function removeAllSlides() {
        if (swiperWrapper) {
          swiperWrapper.innerHTML = '';
        }
        filteredSlides = [];
        filteredThumbs = [];
      }
  
      // Add slides to swiper
      function addSlidesToSwiper(slides) {
        if (!swiperWrapper) return;
  
        slides.forEach((slide) => {
          swiperWrapper.appendChild(slide);
        });
      }
  
      // Filter images by color
      function filterImagesByColor(color) {
        // Destroy existing swiper before modifying DOM
        if (mainSwiper) {
          mainSwiper.destroy(true, true);
          mainSwiper = null;
        }

        // First, remove all slides from swiper
        removeAllSlides();
  
        // Filter slides that match the color
        const matchingSlides = [];
        const matchingThumbs = [];
  
        mainSwiperSlides.forEach((slide, index) => {
          const img = slide.querySelector('img');
          if (img) {
            const imageColor = extractColorFromAlt(img.alt);
            if (imageColor && imageColor.toLowerCase() === color.toLowerCase()) {
              matchingSlides.push(slide.cloneNode(true));
              if (thumbnails[index]) {
                matchingThumbs.push(thumbnails[index].cloneNode(true));
              }
            }
          }
        });
  
        // If no images found for the color, show all images
        if (matchingSlides.length === 0) {
          mainSwiperSlides.forEach((slide, index) => {
            matchingSlides.push(slide.cloneNode(true));
            if (thumbnails[index]) {
              matchingThumbs.push(thumbnails[index].cloneNode(true));
            }
          });
        }
  
        // Add filtered slides to swiper
        addSlidesToSwiper(matchingSlides);
        filteredSlides = matchingSlides;
        filteredThumbs = matchingThumbs;
  
        // Update thumbnails container
        const thumbContainer = document.querySelector(`#${sectionId} .swiper-thumbs`);
        if (thumbContainer) {
          thumbContainer.innerHTML = '';
          matchingThumbs.forEach((thumb, index) => {
            thumb.setAttribute('data-index', index);
            thumb.classList.remove('active');
            if (index === 0) {
              thumb.classList.add('active');
            }
            thumbContainer.appendChild(thumb);
          });
        }
  
        // Reinitialize swiper with filtered content immediately
        initializeSwiper();
        initThumbnailClicks();
  
        // Reset auto-scroll flag when variant changes
        hasAutoScrolled = false;
  
        // Update main image with first slide after variant change
        if (matchingSlides.length > 0) {
          updateMainImage(0);
        }
      }
  
      // Find variant by color
      function findVariantByColor(color) {
        if (!variantSelect) return null;
        const color_down = color.toLowerCase();
  
        const options = variantSelect.options;
        for (let i = 0; i < options.length; i++) {
          const option = options[i];          
          const option1 = option.getAttribute('option1') || "";
          const option2 = option.getAttribute('option2') || "";
          const option3 = option.getAttribute('option3') || "";
          // Check if option text contains the color
          if (option1 == color_down || option2 == color_down || option3 == color_down) {
            return option.value;
          }
          {% comment %} if (option.text.toLowerCase().includes(color.toLowerCase())) {
            return option.value;
          } {% endcomment %}
        }
        return null;
      }
  
      // checkVariantAvailability 
      async function checkVariantAvailability(variantId){
        //const data = await fetch(`/variants/${variantId}.js`).then(r => r.json());
        //const variantAvailable = data.available;
  
        const product_atcButton = document.querySelector('.add-cart');
        const selectedOption = variantSelect.querySelector(`option[value="${variantId}"]`);
        if (selectedOption) {
  
          const inventory = parseInt(selectedOption.getAttribute('inventory'), 10);
          const rightBlock = document.querySelector('.right-container .right');
          if (!isNaN(inventory) && inventory <= 0) {
              product_atcButton.setAttribute('disabled', true);
              product_atcButton.textContent = 'Sold Out';
              document.querySelectorAll('.m-sticky-atc').forEach((btn) => {
                btn.classList.add('sticky-disable');
                btn.textContent = 'Sold Out';
              });
              rightBlock?.classList.add('sold-out-wrapper');
          } else {
              product_atcButton.removeAttribute('disabled');
              product_atcButton.textContent = 'Add To Cart';
              document.querySelectorAll('.m-sticky-atc').forEach((btn) => {
                btn.classList.remove('sticky-disable');
                btn.textContent = 'Add To Cart';
              });
              rightBlock?.classList.remove('sold-out-wrapper');
          }
  
        }
  
        document.querySelectorAll('.ft_popup_item').forEach((el)=>{
          el.classList.remove('show_ft_popup');
        });
        document.querySelectorAll('.featured_tab_item').forEach((el)=>{
          el.classList.remove('show_ft_item');
        });
        const variant_tabs = document.querySelectorAll(`.featured_tab_item[ft-variant="${variantId}"]`);
        if (variant_tabs.length > 0) {
          variant_tabs.forEach((el)=>{
            el.classList.add('show_ft_item');
          });
        }else{
          const product_tabs = document.querySelectorAll(`.featured_tab_item[data-product-ft]`);
          product_tabs.forEach((el)=>{
            el.classList.add('show_ft_item');
          });
        }
        const variant_pops = document.querySelectorAll(`.ft_popup_item[popid="${variantId}"]`);
        if (variant_pops.length > 0) {
          variant_pops.forEach((el)=>{
            el.classList.add('show_ft_popup');
          });
        }else{
          const product_pops = document.querySelectorAll(`.ft_popup_item[ft_popup_product]`);
          product_pops.forEach((el)=>{
            el.classList.add('show_ft_popup');
          });
        }
  
  
        document.querySelectorAll('.pdp_pc_item').forEach((el)=>{
          el.classList.remove('pdp_pc_show');
        });
        const pdp_data =  document.querySelectorAll(`.pdp_pc_item[data-variant-info="${variantId}"]`);
        if (pdp_data.length > 0) {
          pdp_data.forEach((el)=>{
            el.classList.add('pdp_pc_show');
            {% comment %} const wrapper = el.closest('.pdp_product_info').querySelector('.pdp_product_content');
            if(wrapper) {update_pdp_info(wrapper);} {% endcomment %}
          });
        }else{
          const pdp_info =  document.querySelectorAll(`.pdp_pc_item[data-product-info]`);
          pdp_info.forEach((el)=>{
            el.classList.add('pdp_pc_show');
            {% comment %} const wrapper = el.closest('.pdp_product_info').querySelector('.pdp_product_content');
            if(wrapper) {update_pdp_info(wrapper);} {% endcomment %}
          });
        }
  
      }
  
      // Update URL with variant
      function updateURLWithVariant(variantId) {
        const url = new URL(window.location.href);
        url.searchParams.set('variant', variantId);
        window.history.replaceState(null, '', url.pathname + '?' + url.searchParams.toString());
      }
  
      // Update price for variant
      function updatePriceForVariant(variantId) {
        const priceElement = document.querySelector(`#${sectionId} .price-value`);
        if (!priceElement || !variantSelect) return;
  
        const selectedOption = variantSelect.querySelector(`option[value="${variantId}"]`);
        if (selectedOption) {
          const priceMatch = selectedOption.getAttribute('price');
          const compareMatch = selectedOption.getAttribute('compare_price');
          const currentPriceEl = priceElement.querySelector('.price-value-current');
          const comparePriceEl = priceElement.querySelector('.price-value-compare');

          if (currentPriceEl) {
            currentPriceEl.textContent = priceMatch || '';
          }

          if (comparePriceEl) {
            if (compareMatch) {
              comparePriceEl.textContent = compareMatch;
              priceElement.classList.add('price-value--sale');
            } else {
              comparePriceEl.textContent = '';
              priceElement.classList.remove('price-value--sale');
            }
          } else if (priceMatch) {
            priceElement.textContent = priceMatch;
          }
        }
      }
  
      // Color option click handler
      colorOptions.forEach((option) => {
        option.addEventListener('click', function (e) {
          e.preventDefault();
  
          // Remove active class from all color options
          colorOptions.forEach((opt) => opt.classList.remove('active'));
  
          // Add active class to clicked option
          this.classList.add('active');
  
          const selectedColor = this.getAttribute('data-color');
  
          // Update selected color text
          if (selectedColorSpan) {
            selectedColorSpan.textContent = selectedColor;
          }
  
          // Filter images by color (this will remove all slides and add only matching ones)
          filterImagesByColor(selectedColor);
  
          // Find and select corresponding variant
          const variantId = findVariantByColor(selectedColor);
          if (variantId && variantSelect) {
            variantSelect.value = variantId;
  
            // Update price if available
            updatePriceForVariant(variantId);
  
            // Update URL
            updateURLWithVariant(variantId);
  
            // Update ATC
            checkVariantAvailability(variantId);
            
          }
        });
      });

      gift_variants.forEach((radio)=>{
        radio.addEventListener('change',()=>{
          const variantId = radio.getAttribute('data-id');
            variantSelect.value = variantId;
            updatePriceForVariant(variantId);
            updateURLWithVariant(variantId);
            checkVariantAvailability(variantId);
        });
      });
  
      // Initialize with first color
      // if (colorOptions.length > 0) {
      //   const firstColor = colorOptions[0].getAttribute('data-color');
      //   if (firstColor) {
      //     filterImagesByColor(firstColor);
      //   }
      // }
  
      // Initialize with first color
      if (selectedColorSpan) {
        const firstColor = selectedColorSpan.getAttribute('data-color');
        if (firstColor) {
          filterImagesByColor(firstColor);
        }
      }
  
      // Handle URL parameters on load
      function handleURLParameters() {
        const urlParams = new URLSearchParams(window.location.search);
        const variantParam = urlParams.get('variant');
  
        if (variantParam && variantSelect) {
          const selectedOption = variantSelect.querySelector(`option[value="${variantParam}"]`);
          if (selectedOption) {
            variantSelect.value = variantParam;
  
            // Extract color from option text and activate corresponding color option
            const optionText = selectedOption.text.toLowerCase();
            let colorFound = false;
  
            colorOptions.forEach((option) => {
              const color = option.getAttribute('data-color').toLowerCase();
              if (optionText.includes(color)) {
                //option.click();
                colorFound = true;
              }
            });
  
            // If no color option found, update price anyway
            if (!colorFound) {
              updatePriceForVariant(variantParam);
            }
          }
        }
      }
  
      // Call URL parameter handler
      handleURLParameters();
    }
  
    // Initialize everything
    function initializeAll() {
      initializeSwiper();
      initThumbnailClicks();
      initColorVariantChanges();
    }
  
    // Initialize all functionality
    initializeAll();
  
    // Form submission for adding to cart
    const form = document.getElementById(`product-form-${sectionId}`);
    const gift_card = document.getElementById(`gift-content-toggle`);
    const giftmain = document.querySelector(`.gift-content-main`);
    if (form) {
      form.addEventListener('submit', function (e) {
        e.preventDefault();
        form.querySelector('.add-cart').innerHTML = 'Adding';
        document.querySelectorAll('.m-sticky-atc').forEach((btn) => { 
          btn.innerHTML = 'Adding'; 
        });

        if (gift_card && gift_card.checked && giftmain) {
          let gift_error = false;

          // pehle purane cloned gift inputs hatao (duplicate avoid)
          form.querySelectorAll('.gift-clone').forEach(el => el.remove());

          giftmain.querySelectorAll('input, textarea').forEach((inp) => {
            const fieldWrap = inp.closest('.gift__field');

            // sirf required fields validate karo
            if (inp.required) {
              if (inp.value.trim() === '') {
                if (fieldWrap) fieldWrap.classList.add('error_show');
                gift_error = true;
              } else {
                if (fieldWrap) fieldWrap.classList.remove('error_show');

                const clone = inp.cloneNode(true);
                clone.classList.add('gift-clone'); // marker
                form.appendChild(clone);
              }
            } 
            // non-required input → sirf clone karo agar value hai
            else if (inp.value.trim() !== '') {
              const clone = inp.cloneNode(true);
              clone.classList.add('gift-clone');
              form.appendChild(clone);
            }
          });

          if (gift_error) {
            form.querySelector('.add-cart').innerHTML = 'Add To Cart';
            document.querySelectorAll('.m-sticky-atc').forEach((btn) => { 
              btn.innerHTML = 'Add To Cart';
            });
            return;
          }
        }


        const formData = new FormData(this);
        fetch('/cart/add.js', {
          method: 'POST',
          body: formData,
        })
          .then((response) => response.json())
          .then((data) => {
            const this_cartDrawer = document.querySelector('cart-drawer');
            const refreshResult = this_cartDrawer.refresh(true);
  
            if (refreshResult && typeof refreshResult.then === 'function') {
              refreshResult.then(() => {
                setTimeout(() => {
                  form.querySelector('.add-cart').innerHTML = 'Add To Cart';
                  document.querySelectorAll('.m-sticky-atc').forEach((btn) => { 
                    btn.innerHTML = 'Add To Cart';
                  });
                }, 200);
              });
            } else {
              setTimeout(() => {
                form.querySelector('.add-cart').innerHTML = 'Add To Cart';
                document.querySelectorAll('.m-sticky-atc').forEach((btn) => { 
                  btn.innerHTML = 'Add To Cart';
                });
              }, 300);
            }
          })
          .catch((error) => {
            console.error('Error:', error);
            alert('There was an error adding the product to cart. Please try again.');
          });
      });
    }
  }
  </script>
  
  <script>
  document.addEventListener('DOMContentLoaded', function () {
    // Feature tabs functionality
    function initFeatureTabs() {
      const featureTabs = document.querySelectorAll('.feature-tab');
  
      featureTabs.forEach((tab) => {
        const title = tab.querySelector('.feature-tab__title');
        const content = tab.querySelector('.feature-tab__content');
        const icon = tab.querySelector('.icon');
  
        if (title && content) {
          title.addEventListener('click', function () {
            const isExpanded = this.getAttribute('aria-expanded') === 'true';
            // Close all other tabs
            featureTabs.forEach((otherTab) => {
              if (otherTab !== tab) {
                const otherTitle = otherTab.querySelector('.feature-tab__title');
                const otherContent = otherTab.querySelector('.feature-tab__content');
                const otherIcon = otherTab.querySelector('.icon');
  
                otherTitle.setAttribute('aria-expanded', 'false');
                otherContent.setAttribute('hidden', '');
                if (otherIcon) {
                  otherIcon.textContent = '+';
                }
              }
            });
  
            // Toggle current tab
            if (isExpanded) {
              // Close current tab
              this.setAttribute('aria-expanded', 'false');
              content.setAttribute('hidden', '');
              if (icon) {
                icon.textContent = '+';
              }
            } else {
              // Open current tab
              this.setAttribute('aria-expanded', 'true');
              content.removeAttribute('hidden');
              if (icon) {
                icon.textContent = '-';
              }
            }
          });
        }
      });
    }
  
    // Feature tabs functionality
    function initMaterialTabs() {
      const materialTabs = document.querySelectorAll('.material-tab');
  
      materialTabs.forEach((tab) => {
        const title = tab.querySelector('.material-tab__title');
        const content = tab.querySelector('.material-tab__content');
        const icon = tab.querySelector('.icon');
  
        if (title && content) {
          title.addEventListener('click', function () {
            const isExpanded = this.getAttribute('aria-expanded') === 'true';
  
            // Close all other tabs
            materialTabs.forEach((otherTab) => {
              if (otherTab !== tab) {
                const otherTitle = otherTab.querySelector('.material-tab__title');
                const otherContent = otherTab.querySelector('.material-tab__content');
                const otherIcon = otherTab.querySelector('.icon');
  
                otherTitle.setAttribute('aria-expanded', 'false');
                otherContent.setAttribute('hidden', '');
                if (otherIcon) {
                  otherIcon.textContent = '+';
                }
              }
            });
  
            // Toggle current tab
            if (isExpanded) {
              // Close current tab
              this.setAttribute('aria-expanded', 'false');
              content.setAttribute('hidden', '');
              if (icon) {
                icon.textContent = '+';
              }
            } else {
              // Open current tab
              this.setAttribute('aria-expanded', 'true');
              content.removeAttribute('hidden');
              if (icon) {
                icon.textContent = '-';
              }
            }
          });
        }
      });
    }
  
    // Initialize feature tabs
    initFeatureTabs();
    // Initialize material tabs
    initMaterialTabs();
  });

  document.addEventListener('DOMContentLoaded', () => {
