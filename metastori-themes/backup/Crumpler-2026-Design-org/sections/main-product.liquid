                top 0.4s cubic-bezier(0.25, 0.46, 0.45, 0.94);
    will-change: transform;
  }
  .button-slide-block:after, .button-slide-block:before {
    border: 0.5px solid #000000;
    content: "";
    position: absolute;
    top: 0;
    width: calc(50% - 10px);
  }
  .button-slide-block:after{
    right:5px;
  }
  .button-slide-block:before{
    left:5px;
  }
