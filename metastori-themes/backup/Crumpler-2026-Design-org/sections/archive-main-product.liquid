<script>
  document.addEventListener('DOMContentLoaded', function () {
    $('.archive_color_value').click(function(){
      const color_name = $(this).attr('color_name');
      const inventory = $(this).attr('inventory');
      $('input.swatch-input__input[value="'+color_name+'"]').click();
      $('.archive-info-quantity').text(inventory);
      const $target = $(this).closest('.product_title_header-mobile');
      if($target.length > 0){
        if ($target.attr('open')) {
          $target.removeAttr('open');
        } else {
          $target.attr('open', true);
        }
      }
    });
    $('.colors_mobile').click(function() {
        const $target = $(this).closest('.product_title_header-mobile');
        if ($target.attr('open')) {
          $target.removeAttr('open');
        } else {
          $target.attr('open', true);
        }
      });

  });
  async function addToCart(variantId, button) {
    button.classList.add('loading');
    button.disabled = true;
    try {
      const addResponse = await fetch('/cart/add.js', {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
        },
        body: JSON.stringify({
          id: variantId,
          quantity: 1,
        }),
      });
      if (!addResponse.ok) {
        throw new Error(`Failed to add item to cart: ${addResponse.status} ${addResponse.statusText}`);
      }
      const addData = await addResponse.json();
      const cartResponse = await fetch('/cart.js');
      if (!cartResponse.ok) {
        throw new Error(`Failed to fetch cart data: ${cartResponse.status} ${cartResponse.statusText}`);
      }
      const cartData = await cartResponse.json();
      const sections = {};
      for (const sectionId of ['cart-drawer', 'cart-icon-bubble']) {
        try {
          const sectionResponse = await fetch(`/?section_id=${sectionId}`);
          if (!sectionResponse.ok) {
            throw new Error(`Failed to fetch section ${sectionId}: ${sectionResponse.status} ${sectionResponse.statusText}`);
          }
          sections[sectionId] = await sectionResponse.text();
        } catch (sectionError) {
          console.error(sectionError);
        }
      }
      const cartDrawer = document.querySelector('cart-drawer');
      if (cartDrawer && Object.keys(sections).length > 0) {
        const drawerInner = cartDrawer.querySelector('.drawer__inner');
        if (drawerInner && drawerInner.classList.contains('is-empty')) {
          drawerInner.classList.remove('is-empty');
        }
        if (cartDrawer.classList.contains('is-empty')) {
          cartDrawer.classList.remove('is-empty');
        }
        cartDrawer.renderContents({
          id: variantId,
          sections: sections,
          item_count: cartData.item_count,
        });
      } else {
        if (cartDrawer && cartDrawer.classList.contains('is-empty')) {
          cartDrawer.classList.remove('is-empty');
        }
        document.dispatchEvent(new CustomEvent('cart:open', {
          detail: { cartDrawer: cartDrawer }
        }));
      }
    } catch (error) {
      alert('Error adding item to cart. Please try again.');
    } finally {
      button.classList.remove('loading');
       button.disabled = false;
    }
  }
</script>

