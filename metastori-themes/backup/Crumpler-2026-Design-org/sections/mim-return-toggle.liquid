<style>
.mim-return-toggle {
    padding: 12px 18px 0;
}
.mim-toggle-text {
    padding: 0px 0 2px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: PP NeueBit;
    transition: all 0.3s;
    font-weight: 700;
    font-size: 20px;
    text-transform: uppercase;
    line-height: 1;
}
.mim-toggle {
    display: flex;
    align-items: center;
    gap: 8px;
}
.toggle {
    position: relative;
    display: inline-block;
    width: 35px;
    height: 16px;
}

.toggle .mim-inp-toggle {
    display:none;
}

.mim-toggle-slider {
  position: absolute;
  cursor: pointer;
  inset: 0;
  background: #BEBEBE;
  border-radius: 50px;
  transition: 0.3s;
}

.mim-toggle-slider::before {
    content: "";
    position: absolute;
    height: 13.7px;
    width: 13.7px;
    left: 1.6px;
    top: 50%;
    transform: translateY(-50%);
    background: white;
    border-radius: 50%;
    transition: 0.3s;
}

.toggle .mim-inp-toggle:checked + .mim-toggle-slider {
  background: #000;
}

.toggle .mim-inp-toggle:checked + .mim-toggle-slider::before {
    transform: translateX(18px) translateY(-50%);
}
.mim-toggle-text{
  padding-top: 0 !important;
  cursor: pointer;
}
@media (max-width:767px){
    .mim-return-toggle {
        padding: 12px 12px 0;
    }
    .mim-toggle-text{
        padding: 2px 0 0px;
        height: 20px;
    }
}
</style>

<div class="mim-return-toggle">
    <label class="mim-toggle">
      <span class="mim-toggle-text">workshop view</span>
      <div class="toggle">
        <input class="mim-inp-toggle" type="checkbox">
        <span class="mim-toggle-slider"></span>
      </div>
    </label>
</div>

<script>
document.addEventListener('DOMContentLoaded', function () {
    const mim_toggle = document.querySelector(".mim-inp-toggle");

    if (mim_toggle) {
      mim_toggle.addEventListener("change", () => {
        const wrapper = mim_toggle.closest('.mim-toggle');
        const url = new URL(window.location.href);

        if (mim_toggle.checked) {
            mim_toggle.disabled = true; 
            url.searchParams.delete("view");
        }
        window.location.href = url.toString();
      });
    }
});
window.addEventListener("pageshow", function (event) {
    if (event.persisted) {
      const mim_toggle = document.querySelector(".mim-inp-toggle");
      if (!mim_toggle) return;
      mim_toggle.checked = false;
      mim_toggle.disabled = false;
    }
  });
</script>

{% schema %}
{
  "name": "MIM Return Toggle",
  "tag": "section",
  "class": "section",
  "presets": [
    {
      "name": "MIM Return Toggle"
    }
  ]
}
{% endschema %}
