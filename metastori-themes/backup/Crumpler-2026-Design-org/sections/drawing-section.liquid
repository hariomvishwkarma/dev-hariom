<style>
#drawingCanvas{
    width: 100%;
}
.drawingActive {
    cursor: url('https://cdn.shopify.com/s/files/1/0565/5114/5551/files/Vector_7_c212032e-6374-42d5-bde5-fc36ad0e955e.svg?v=1760352269') 2 23, auto;
}
.dsw-drawing{
    position:relative;
    width:100%;
}
.dsw-content {
    padding: 17px 16px 0px 18px;
}
.dsw-content p{
    margin:0;
}
.dsw-content a {
    color: #5198F9;
}
.dsw-buttons {
    position: absolute;
    right: 14%;
    top: 20%;
    cursor: pointer;
    display: flex;
    gap: 4px;
}
.dsw-cursor, .dsw-drawer{
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
}
.dsw-cursor{
    display:none;
}
.drawingActive .dsw-cursor{
    display:block;
}
.drawingActive .dsw-drawer{
    display:none;
}
.dsw-drawing #drawingCanvas{
    pointer-events: none;
}
.dsw-drawing.drawingActive #drawingCanvas{
    pointer-events: unset;
}
.dr-icons {
    width: 26.82px;
    height: 26.82px;
    background: #C3C3C3;
    display: flex;
    align-items: center;
    justify-content: center;
}
.drawing_cursor_pointer svg {
    margin-left: 4px;
}
.dr-active{
    box-shadow: 2.24px 2.24px 0px 0px #7E7E7E inset, -1.12px -1.12px 0px 0px #F0F0F0 inset, 1.12px 1.12px 0px 0px #262626 inset;
}
.dr-icons:not(.dr-active){
    box-shadow: -2.24px -2.24px 0px 0px #7E7E7E inset, 1.12px  1.12px 0px 0px #F0F0F0 inset, -1.12px -1.12px 0px 0px #262626 inset;
}
.drawing-section-main {
    max-width: 100%;
    overflow: hidden;
}
@media (max-width:1024px){
    .{{ section.id }} .dsw-content{
        font-size:{{ section.settings.font_size_m }};
    }
    .dsw-buttons{
        top: 5%;
    }
    .dsw-drawing {
        padding-bottom: 40px;
    }
    #drawingCanvas {
        height: 380px;
        touch-action: none;
    }
}
@media (min-width:1025px){
   .{{ section.id }} .dsw-content{
        font-size:{{ section.settings.font_size }};
    }
}
</style>

