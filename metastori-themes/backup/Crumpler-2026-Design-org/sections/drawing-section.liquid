<script>
document.addEventListener("DOMContentLoaded", function () {
  const drawing_main = document.querySelector(".dsw-drawing");
  const canvas = document.getElementById("drawingCanvas");
  const ctx = canvas.getContext("2d");

    function setupCanvas() {
        const ratio = window.devicePixelRatio || 1;

        const width = canvas.offsetWidth;
        const height = window.innerWidth < 767 ? 450 : 700;

        canvas.style.width = width + "px";
        canvas.style.height = height + "px";

        canvas.width = width * ratio;
        canvas.height = height * ratio;

        ctx.setTransform(ratio, 0, 0, ratio, 0, 0);

        ctx.lineWidth = 2;
        ctx.lineCap = "round";
        ctx.strokeStyle = "black";
    }


  setupCanvas();
  //window.addEventListener("resize", setupCanvas);

  let drawing = false;

  // Get coordinates
    function getPosition(e) {
        const rect = canvas.getBoundingClientRect();
        const touch = e.touches ? e.touches[0] : e;

        return {
            x: touch.clientX - rect.left,
            y: touch.clientY - rect.top,
        };
    }


  // Drawing functions
  function startDrawing(e) {
    e.preventDefault();
    drawing = true;
    const pos = getPosition(e);
    ctx.beginPath();
    ctx.moveTo(pos.x, pos.y);
  }

  function draw(e) {
    if (!drawing) return;
    e.preventDefault();
    const pos = getPosition(e);
    ctx.lineTo(pos.x, pos.y);
    ctx.stroke();
  }

  function stopDrawing() {
    drawing = false;
    ctx.closePath();
  }

  // Canvas Events
  canvas.addEventListener("mousedown", startDrawing);
  canvas.addEventListener("mousemove", draw);
  canvas.addEventListener("mouseup", stopDrawing);
  canvas.addEventListener("mouseleave", stopDrawing);
  canvas.addEventListener("touchstart", startDrawing);
  canvas.addEventListener("touchmove", draw);
  canvas.addEventListener("touchend", stopDrawing);
  canvas.addEventListener("touchcancel", stopDrawing);

    const pointerBtn = document.querySelector(".drawing_cursor_pointer");
    const penBtn = document.querySelector(".drawing_cursor_pen");
    const buttons = document.querySelectorAll(".dr-icons");

    pointerBtn.addEventListener("click", function () {
        drawing_main.classList.remove("drawingActive");

        buttons.forEach(btn => btn.classList.remove("dr-active"));
        this.classList.add("dr-active");
    });

    penBtn.addEventListener("click", function () {
        drawing_main.classList.add("drawingActive");

        buttons.forEach(btn => btn.classList.remove("dr-active"));
        this.classList.add("dr-active");

        // reset drawing styles
        ctx.beginPath();
        ctx.lineWidth = 2;
        ctx.lineCap = "round";
        ctx.strokeStyle = "black";
    });

    if(window.innerWidth < 767){
        pointerBtn.click();
    }

});

</script>

