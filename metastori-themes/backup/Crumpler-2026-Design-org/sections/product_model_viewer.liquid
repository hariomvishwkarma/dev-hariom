{% schema %}
{
  "name": "Product 3D viewer",
  "settings": [
    {
      "type": "range",
      "id": "section_height",
      "min": 50,
      "max": 150,
      "step": 5,
      "unit": "vh",
      "default": 100,
      "label": "Section height"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background Color",
      "default": "#ffffff"
    }
  ],
  "blocks": [
    {
      "type": "video_block",
      "name": "Video Block",
      "settings": [
        {
          "type": "url",
          "id": "video_url",
          "label": "Video URL (MP4 link)"
        },
        {
          "type": "text",
          "id": "popup_metafield",
          "label": "Popup Text Metafield (namespace.key)"
        }
      ]
    },
    {
      "type": "model_block",
      "name": "3D Model Block",
      "settings": [
        {
          "type": "url",
          "id": "model_src",
          "label": "3D Model URL (.glb)"
        },
        {
          "type": "text",
          "id": "popup_metafield",
          "label": "Popup Text Metafield (namespace.key)"
        }
      ]
    }
  ],
  "max_blocks": 1,
  "presets": [
    {
      "name": "Product 3D viewer",
      "category": "Media"
    }
  ]
}
{% endschema %}

<section class="custom-3d-video-right" style="background: {{ section.settings.background_color }}; height: {{ section.settings.section_height }}vh;">
  <div class="content-left">
  </div>

  <div class="media-right">
    {% for block in section.blocks %}
      {% case block.type %}
        {% when 'video_block' %}
          {% assign video_url = block.settings.video_url %}
          {% assign metafield_key = block.settings.popup_metafield %}
          {% if metafield_key != blank %}
            {% assign namespace = metafield_key | split: '.' | first %}
            {% assign key = metafield_key | split: '.' | last %}
            {% assign popup_text = collection.metafields[namespace][key].value %}
          {% endif %}
          {% if video_url != blank %}
            <video autoplay muted loop playsinline>
              <source src="{{ video_url }}" type="video/mp4">
            </video>
          {% else %}
            <div class="placeholder">Add video URL</div>
          {% endif %}
          {% if popup_text != blank %}
            <button class="popup-btn" data-popup="{{ popup_text | escape }}">i</button>
          {% endif %}

        {% when 'model_block' %}
          {% assign model_src = block.settings.model_src %}
          {% assign metafield_key = block.settings.popup_metafield %}
          {% if metafield_key != blank %}
            {% assign namespace = metafield_key | split: '.' | first %}
            {% assign key = metafield_key | split: '.' | last %}
            {% assign popup_text = collection.metafields[namespace][key].value %}
          {% endif %}
          {% if model_src != blank %}
            <model-viewer
              src="{{ model_src }}"
              alt="3D Model"
              camera-controls
              shadow-intensity="1"
              exposure="1"
              ar>
            </model-viewer>
          {% else %}
            <div class="placeholder">Add 3D Model</div>
          {% endif %}
          {% if popup_text != blank %}
            <button class="popup-btn" data-popup="{{ popup_text | escape }}">i</button>
          {% endif %}
      {% endcase %}
    {% endfor %}
  </div>
</section>

<style>
.custom-3d-video-right {
  display: flex;
  width: 100%;
  position: relative;
  overflow: hidden;
}

.content-left {
  width: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 40px;
}

.placeholder-text {
  text-align: left;
}

.media-right {
  width: 50%;
  position: relative;
  height: 100%;
  overflow: hidden;
}

.media-right video,
.media-right model-viewer {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
  background: #f4f4f4;
  color: #999;
  height: 100%;
}

.popup-btn {
  position: absolute;
  bottom: 15px;
  right: 15px;
  background: rgba(0, 0, 0, 0.7);
  color: #fff;
  border: none;
  border-radius: 50%;
  width: 36px;
  height: 36px;
  cursor: pointer;
  font-weight: bold;
  font-size: 18px;
  display: flex;
  align-items: center;
  justify-content: center;
}

/* Popup box */
.popup {
  position: fixed;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  background: white;
  padding: 20px;
  box-shadow: 0 4px 20px rgba(0,0,0,0.3);
  border-radius: 8px;
  max-width: 280px;
  z-index: 1000;
  text-align: center;
}

.popup button {
  background: #000;
  color: #fff;
  border: none;
  padding: 6px 10px;
  border-radius: 5px;
  margin-top: 10px;
  cursor: pointer;
}

/* Mobile responsive */
@media (max-width: 768px) {
  .custom-3d-video-right {
    flex-direction: column;
  }
  .content-left,
  .media-right {
    width: 100%;
    height: 50vh;
  }
}
</style>

<script type="module" src="https://unpkg.com/@google/model-viewer/dist/model-viewer.min.js"></script>
<script>
document.addEventListener('DOMContentLoaded', () => {
  document.querySelectorAll('.popup-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      const text = btn.getAttribute('data-popup');
      const popup = document.createElement('div');
      popup.className = 'popup';
      popup.innerHTML = `
        <p>${text}</p>
        <button onclick="this.parentNode.remove()">Close</button>
      `;
      document.body.appendChild(popup);
    });
  });
});
</script>
