{% for block in section.blocks %}
    {% capture desktop_css %}{{ desktop_css }}
        .sbs-media-item-{{ block.id }}{
            width:{{  block.settings.width }}%;
        }
    {% endcapture %}
    {% capture mobile_css %}{{ mobile_css }}
         .sbs-media-item-{{ block.id }}{
            width:{{  block.settings.width_m }}%;
        }     
    {% endcapture %}
{% endfor %}
<style>
    .sbs-media-item{
        display:flex;
        justify-content: space-between;
        height:100%;
        position: relative;
    }
    .sbs-media-item img, .sbs-media-item video{
        max-width:100%;
        width:100%;
        object-fit:cover;
        height:auto;
    }
    .{{ section.id }} .sbs-heading{
        margin:0;
        line-height:normal;
        color:{{ section.settings.text_color }};
        margin-bottom: 5px;
        font-family: "Neue Haas Grotesk Text Pro";
        font-weight: 700;
    } 
    .{{ section.id }} .sbs-content{
        margin:0;
        color:{{ section.settings.text_color }};
    }
    .{{ section.id }} .sbs-wrapper {
        padding: 22px 0px 0px;
        {% comment %} padding: 22px 18px 93px; {% endcomment %}
    }
    .{{ section.id }} .sbs-header{
        padding: 0px 18px;
    }
    .{{ section.id }} .sbs-media {
        display: flex;
        flex-wrap: wrap;
        align-items: stretch;
        justify-content: center;
        padding-top: 15px;
    }

    @media (min-width:768px){
        {{ desktop_css }}
        .{{ section.id }} .sbs-heading{
            font-size:{{ section.settings.heading_size }};
        }
        .{{ section.id }} .sbs-content{
            font-size:{{ section.settings.content_size }};
        }
        .sbs-mobile-video, .sbs-mobile-img{
            display:none;
        }
        .{{ section.id }} .sbs-wrapper {
            {% comment %} padding: 22px 18px 93px; {% endcomment %}
            padding: 22px 0px 0px;
        }
        .{{ section.id }} .sbs-header{
            padding: 0px 18px;
        }
    }
    @media (max-width:767px){
        {{ mobile_css }}
        .{{ section.id }} .sbs-heading{
            font-size:{{ section.settings.heading_size_m }};
        }
        .{{ section.id }} .sbs-content{
            font-size:{{ section.settings.content_size_m }};
        }
        .sbs-desktop-video, .sbs-desktop-img{
            display:none;
        }
        .{{ section.id }} .sbs-wrapper {
            {% comment %} padding: 24px 12px 53px; {% endcomment %}
            padding: 24px 0px 0px;
        }
        .{{ section.id }} .sbs-header{
            padding: 0px 12px;
        }
        .{{ section.id }} .sbs-media {
            padding-top: 10px;
        }
    }
</style>

<div class="split--block-main {{ section.id }}" style="background:{{ section.settings.bg_color }};">
    <div class="sbs-wrapper">
        <div class="sbs-header">
            {% if section.settings.heading != blank %}
                <h2 class="sbs-heading">{{ section.settings.heading }}</h2>
            {% endif %}
            {% if section.settings.content != blank %}
                <div class="sbs-content">{{ section.settings.content }}</div>
            {% endif %}
        </div>
        <div class="sbs-media">
            {% for block in section.blocks %}
                <div class="sbs-media-item sbs-media-item-{{ block.id }}">
                    {% if block.settings.link != blank %}
                        <a href="{{ block.settings.link }}" class="overlay-link"></a>
                    {% endif %}
                    {% if block.settings.image != blank %}
                        {% assign image_height = block.settings.image.width | divided_by: block.settings.image.aspect_ratio | round %}
                        {{ block.settings.image
                        | image_url: width: 3840
                        | image_tag:
                            width: block.settings.image.width,
                            height: image_height,
                            class: 'desktop_img',
                            sizes: '100vw',
                            widths: '170, 320, 375, 414, 550, 750, 1100, 1500, 1780, 2000, 3000, 3840',
                            alt: block.settings.image.alt
                        }}

                        {% if block.settings.image_m != blank %}
                            {% assign mobile_height = block.settings.image_m.width | divided_by: block.settings.image_m.aspect_ratio | round %}
                            {{ block.settings.image_m
                                | image_url: width: 750
                                | image_tag:
                                width: block.settings.image_m.width,
                                height: mobile_height,
                                class: 'mobile_img',
                                sizes: '100vw',
                                widths: '320, 375, 414, 550, 750',
                                alt: block.settings.image_m.alt
                            }}
                        {% else %}
                            {% assign mobile_height = block.settings.image.width | divided_by: block.settings.image.aspect_ratio | round %}
                            {{
                                block.settings.image
                                | image_url: width: 750
                                | image_tag:
                                width: block.settings.image.width,
                                height: mobile_height,
                                class: 'mobile_img',
                                sizes: '100vw',
                                widths: '320, 375, 414, 550, 750',
                                alt: block.settings.image.alt
                            }}
                        {% endif %}
                    {% elsif block.settings.video != blank %}
                        {{ block.settings.video | video_tag:autoplay:true, loop:true, controls: false, muted:true,class:'desktop_video' }}
                        {% if block.settings.video_m != blank %}
                            {{ block.settings.video_m | video_tag:autoplay:true, loop:true, controls: false, muted:true,class:'mobile_video' }}
                        {% else %}
                            {{ block.settings.video | video_tag:autoplay:true, loop:true, controls: false, muted:true,class:'mobile_video' }}
                        {% endif %}
                    {% else %}
                        {{ 'detailed-apparel-1' | placeholder_svg_tag: 'placeholder-svg' }}
                    {% endif %}
                </div>
            {% endfor %}
        </div>
    </div>
</div>

