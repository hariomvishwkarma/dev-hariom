{{ 'template-collection.css' | asset_url | stylesheet_tag }}
{{ 'component-card.css' | asset_url | stylesheet_tag }}
{{ 'component-price.css' | asset_url | stylesheet_tag }}

{% if section.settings.image_shape == 'blob' %}
  {{ 'mask-blobs.css' | asset_url | stylesheet_tag }}
{%- endif -%}

{%- unless section.settings.quick_add == 'none' -%}
  {{ 'quick-add.css' | asset_url | stylesheet_tag }}
{%- endunless -%}

{%- if section.settings.quick_add == 'standard' -%}
  <script src="{{ 'quick-add.js' | asset_url }}" defer="defer"></script>
  <script src="{{ 'product-form.js' | asset_url }}" defer="defer"></script>
{%- endif -%}

{%- if section.settings.quick_add == 'bulk' -%}
  <script src="{{ 'quick-add-bulk.js' | asset_url }}" defer="defer"></script>
  <script src="{{ 'quantity-popover.js' | asset_url }}" defer="defer"></script>
  <script src="{{ 'price-per-item.js' | asset_url }}" defer="defer"></script>
  <script src="{{ 'quick-order-list.js' | asset_url }}" defer="defer"></script>
{%- endif -%}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
  @media (min-width:1025px){
    .mobile-filter-header{
      display:none;
    }
  }
{%- endstyle -%}

{% style %}

    .cst-product-card {
      text-align: left;
      position: relative;
      overflow: hidden;
      transition: opacity 0.3s ease;
      max-width: 539.2px;
      width: 100%;
      margin: 0 auto;
    }

    .cst-main-slider .cst-slide-inner {
      width: 100%;
      aspect-ratio: 17/20;
    }

    .cst-image-link {
      position: relative;
      display: inline-block;
      width: 100%;
    }

    .cst-product-image-wrapper {
      aspect-ratio: 17/20;
      position: relative;
      /* background-color: #eee; */
      overflow: hidden;
    }
    .cst-product-image-wrapper video{
      max-width: 100%;
      object-fit: cover;
      height: 100%;
      width: 100%;
    }

    .cst-product-image {
      display: block;
      height: 100%;
      max-width:100%;
      width:100%;
    }
    .cst-product-image.skeleton,
    .cst-swatch-image.skeleton {
      opacity: 0;
    }

    .cst-swatch-image-wrapper {
      /* aspect-ratio: 1/1; */
      position: relative;
      background-color: #eee;
      overflow: hidden;
      display: flex;
      width: fit-content;
      height: fit-content;
    }

    .cst-swatch-wrapper .swiper-slide {
        width: fit-content!important;
    }

    .cst-swatch-image {
      display: block;
      cursor:pointer;
      height: 100%;
    }

    /* Disabled overlay – bg only (Safari iOS may not paint; use SVG version if needed) */
    .cst-disabled-overlay {
      position: absolute;
      top: 0;
      right: 0;
      bottom: 0;
      left: 0;
      z-index: 2;
      display: block;
      -webkit-backface-visibility: hidden;
      backface-visibility: hidden;
      min-width: 100%;
      min-height: 100%;
      box-sizing: border-box;
      background-color: {{ section.settings.overlay_color | default: '#FF9C9C' }};
      opacity: {{ section.settings.overlay_opacity | default: 0.4 }};
    }
    .cst-disabled::after {
      content: '';
      position: absolute;
      top: 0;
      right: 0;
      bottom: 0;
      left: 0;
      background-color: {{ section.settings.overlay_color | default: '#FF9C9C' }};
      opacity: {{ section.settings.overlay_opacity }};
      z-index: 1;
      display: block;
    }

    .cst-product-title {
      margin-top: 4px;
      font-weight: 600;
      text-transform: uppercase;
      color:#000000;
      text-decoration:none;
      display: flex;
      padding: 0 0 0 10px;
    }

    .product_card_image_badges {
      position: absolute;
      top: 6px;
      left: 10px;
      z-index: 5;
      display: flex;
      flex-wrap: wrap;
    }
    .product_card_image_badges img {
        max-height: 20px;
        object-fit: contain;
    }

    .cst-swatches {
      display: flex;
      align-items: center;
      margin-top: 0.4rem;
      gap: 8px;
      position: relative;
      padding: 0 10px;
    }

    .cst-swatches .cst-slide-inner {
      border: 0.8px solid transparent;
      transition: all 0.3s;
      width: fit-content;
      padding: .78px .94px .79px .96px;
    }

    .cst-swatches .swiper-slide.cst-active .cst-slide-inner {
      border-color: #333;
    }

    .cst-hidden {
      display: none !important;
    }

    .cst-pagination {
      display: flex;
      flex-wrap: wrap;
      justify-content: center;
      gap: 8px;
      margin: 30px 0;
    }

    .cst-page-button {
      padding: 2px 5px;
      text-decoration: none;
      font-size: 16px;
      color: #333;
      border-bottom: 1px solid transparent;
      transition: all 0.2s ease;
    }

    .cst-page-button:hover {
      border-color: #333;
    }

    .cst-page-button.active {
      border-color: #333;
    }

    .cst-main-slider,
    .cst-swatch-slider {
      display: block;
      width: 100%;
      overflow: hidden;
    }

    .swiper-button-prev,
    .swiper-button-next {
      position: relative;
      left: auto;
      right: auto;
      top: auto;
      bottom: auto;
      width: 18px;
      height: 100%;
      display: none;
      justify-content: center;
      align-items: center;
      margin: 0;
      justify-content: center;
      align-items: center;
      background-color: #fff;
    }

    .cst-swatches span.color-option {
        display: flex;
    }
    .cst-swatches .cst-swatch-image-wrapper span {
        display: inline-block;
        width: 27.5px;
        height: 12.5px;
        cursor: pointer;
        background-position: center;
        background: #58a7f4;
        background-size: contain;
      }

    .swiper-button-prev {
      position: absolute;
      left: 0;
      justify-content: start;
    }

    .swiper-button-next {
      position: absolute;
      right: 0;
      justify-content: end;
    }

    .swiper-button-prev::after,
    .swiper-button-next::after {
      font-size: 14px;
      color: #333;
    }

    .swiper-button-prev.swiper-button-disabled,
    .swiper-button-next.swiper-button-disabled {
      display: none !important;
    }

    @media(max-width: 425px) {
      .swiper-button-prev,
      .swiper-button-next {
        width: 14px;
      }

      .swiper-button-prev::after,
      .swiper-button-next::after {
        font-size: 10px;
        color: #333;
      }
    }

    .cst-tags-box {
      position: absolute;
      top: 0;
      left: 0;
      width: clamp(70px, 100vw, 200px);
      display: flex;
      flex-direction: column;
      gap: 5px;
      padding: 5px;
      border: 1px solid red;
    }

    .cst-img-box {
      display: flex;
      width: 70px;
      z-index: 1;
    }
    .cst-img-box img {
      display: flex;
    }
    .page-width-collection{ max-width:none; padding:0px 12px; margin:0; }

    .no-result-text {
      font-size: 26px;
      line-height: 120%;
      font-weight: 500;
    }
    .clear-filter-btn {
      background: #EEEEEE;
      color: #000000;
      text-transform: capitalize;
      min-height: 33px;
      border: 1.58px solid #000000;
      border-radius: 11.05px;
      min-width: 143.66px;
      display: inline-flex;
      justify-content: center;
      align-items: center;
      font-size: 20.52px;
    }

    @media screen and (min-width: 750px) {
      .grid {
        row-gap: 260px;
        flex-direction: column;
      }
      #ProductGridContainer:not(.productGridContainer-empty) #product-grid{
        margin-top: 0px;
      }
      #ProductGridContainer:not(.productGridContainer-empty){
        margin-bottom: 0px;
      }
      #product-grid{
        max-width: 100%;
      }
    }
    @media (max-width: 1024px) {
      #product-grid.grid {
        gap: 148px;
      }
      .cst-product-title{
        margin-top: 3px;
        line-height: 1.2;
      }
      .no-result-text {
        font-size: 20px;
      }
      .clear-filter-btn{
        margin-top: 10px;
      }
      #ProductGridContainer #product-grid:not(.collection--empty){
        margin-top: 0;
      }
      #ProductGridContainer{
        margin-bottom: 0px;
      }
      .cst-product-card{
        max-width: 257.64px;
      }
    }
{% endstyle %}

{% assign all_colors = settings.filter_colors | newline_to_br | split: '<br />' %}

<div class="section-{{ section.id }}-padding gra  dient color-{{ section.settings.color_scheme }}">
  {%- paginate collection.products by section.settings.products_per_page -%}
    <div class="{% if section.settings.filter_type == 'vertical' %} facets-vertical page-width-collection{% endif %}">
      {% comment %}
        {{ 'component-facets.css' | asset_url | stylesheet_tag }}

        <script src="{{ 'facets.js' | asset_url }}" defer="defer"></script>
      {% endcomment %}

      {%- if section.settings.enable_filtering or section.settings.enable_sorting -%}
        {% style %}
          #main-collection-filters *{
            font-size: 13px;
          }
          .filter-seperation {
              display: inline-flex;
              width: 12px;
          }
          .price_colun {
            margin-left: -3px;
          }
          .cst-filter-panel-Colour {
              line-height: 100%;
          }
            #main-collection-filters {
            padding: 0 18px;
            }
            .cst-filter.js-filter {
              display: flex;
              gap:3px 8px;
              margin-right:13px;
              flex-wrap:wrap;
            }
            .cst-filters-row {
              /* display: flex;
              flex-wrap:wrap;
              row-gap: 5px; */
              display: inline-block;
              /* line-height:36px; */
            }
            .cst-filter-btn {
              margin: 10px 0;
            }
            .filter-seperator {
              margin-left: -3px;
            }
            button.cst-filter-label span.cst-values, .filter_sort_selector{
              margin-right:5px;
              text-decoration:underline;
            }
            button.cst-filter-label span.cst-values, .cst-filter-label[filter_name="price"]{
              display:none;
            }
            .filter_sort_selector {
              border: none;
              appearance: none;
              -webkit-appearance: none;
              -moz-appearance: none;
              font-weight: 500;
              text-transform: capitalize;
              font-family: "Neue Haas Grotesk Text Pro";
              background-color: transparent;
            }
            @supports (-webkit-touch-callout: none) {
              .filter_sort_selector {
                background-color: transparent !important;
              }
            }
            button.cst-filter-label {
              background: white;
              border: none;
              font-family: "Neue Haas Grotesk Text Pro";
              font-weight: 500;
              line-height: calc(1 + 0.15 / var(--font-body-scale));
              text-transform: capitalize;
              display: inline-flex;
              padding:0;
              gap:4px;
              align-items: center;
              margin-right:13px;
            }
            button.cst-filter-label[aria-expanded="true"] {
              margin-right: 6px;
            }
            .cst-filter-label[filter_toggle_disabled] {
              pointer-events: none;
            }
            button.cst-filter-label.cst-sort-label{
              margin-right:0px;

            }
            button.cst-filter-label .icon{
              display: flex;
              line-height: 0;
            }
            ul.cst-filter-list {
              list-style: none;
              padding: 0;
              margin: 0;
              display: flex;
              gap: 0 7px;
              flex-wrap:wrap;
            }
            .cst-filters-row input:not(.price_range_filter) {
              display: none;
            }
            .cst-price-range-row {
                display: flex;
                align-items: center;
                gap: 3px;
            }

            .price_range_filter{
              min-width: 45.83px;
              border: 1px solid #606060;
              border-radius: 2px;
              background: #F1F1F1;
              text-align: center;
              font-family: "Neue Haas Grotesk Text Pro";
              text-transform: lowercase;
