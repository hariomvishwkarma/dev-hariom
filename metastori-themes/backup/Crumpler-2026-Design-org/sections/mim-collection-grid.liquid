                height: 18.2px;
                border-radius: 2.39px;
                background: #000;
                display: inline-flex;
                justify-content: center;
                align-items: center;
                padding: 0;
                cursor: pointer;
                border: 1px solid;
            }

            #main-collection-filters b {
              font-weight: 700;
              display:flex;
              letter-spacing: 0%;
              text-transform: capitalize;
              align-items: center;
              gap: 0px;
              cursor:pointer;
            }
            #main-collection-filters .cst-filters-container{
              display: flex;
              gap: 7px;
              align-items: baseline;
            }
            #main-collection-filters .cst-product-count  {
              color:#C4C4C4;
              font-weight: 600;
              letter-spacing: 0%;
              text-transform: capitalize;
              margin-top: 7px !important;
            }
            #main-collection-filters .cst-clear-btn, .cst-apply-btn, .cst-clear-desktop  {
              background: #EEEEEE;
              width: 91px;
              height: 21px;
              top: 93px;
              left: 18px;
              opacity: 1;
              border-radius: 7px;
              border-width: 1px;
              outline: none;
              margin-top: 20px;
              border: 1px solid;
              font-weight: 600;
              font-family: var(--font-body-family);
              cursor: pointer;
            }
            .cst-apply-btn{
              width: fit-content;
            }
            #main-collection-filters .cst-sort-radio-item input[type="radio"]  {
              display:none;
            }
            #main-collection-filters .cst-sort-radio-list {
              display: flex;
              flex-wrap: wrap;
              gap: 9px;
              margin-left:5px;
            }
            #main-collection-filters .cst-sort-radio-list .checked{
              text-decoration:underline;
            }
            #main-collection-filters  span.filter-lable {
              white-space:nowrap;
            }
            #main-collection-filters  .cst-sort-radio-item input[type="radio"]:checked + span {
              text-decoration: underline;

            }
            #main-collection-filters  label.cst-checkbox.checked span {
              text-decoration: underline;
            }
            .cst-checkbox-label:hover {
                text-decoration: underline;
            }
            #main-collection-filters  .mobile-icon{
              display:inline;
              padding-left: 5px;
            }
            #main-collection-filters .cst-filters-row .fillter--close{
              display:none;
            }



              #main-collection-filters .cst-filter.js-filter.cst-sort-filter, #main-collection-filters div#ProductCount{
                margin-top:2px;
              }


              button.cst-filter-label[aria-expanded="false"] ~ label{
                display:none;
              }

              button.cst-filter-label[aria-expanded="true"] ~ label {
                display:inline-block;
              }
              .cst-checkbox{
                cursor:pointer;
              }
              .filter-top-text {
                  font-weight: 600;
                  text-transform: capitalize;
                  margin-bottom: 2px;
              }
              #main-collection-filters .cst-filters-row{
                top: 0;
                left: 0;
                position: fixed;
                z-index: 100;
                background: white;
                transform: translateX(-100%);
                transition: transform 200ms ease;
                width: 380px;
                height: 100vh;
                padding: 9px 12px;
              }
              #main-collection-filters .cst-filters-row .fillter--close
              {
                display:inline-block;
                padding-right: 5px;
              }
              /* Open: left to right (slide in from left) */
              #main-collection-filters .cst-filters-row.open{
                transform: translateX(0px);
                overflow: auto;
              }
              /* Close: right to left (slide out to the left) */
              #main-collection-filters .cst-filters-row.open.closing{
                transform: translateX(-100%);
              }
              button.cst-filter-label[aria-expanded="false"] {
                width: 100%;
              }
              .cst-filters-row-overlay.open_overlay {
                position: fixed;
                top: 0;
                left: 0;
                width: 100vw;
                height: 100vh;
                display: block;
                background: #0000006e;
                z-index: 99;
              }
            @media screen and (max-width: 1024px) {
              #main-collection-filters *{
                font-size:26px;
                color:#000;
                /* background: #fff; */
              }
              #main-collection-filters .cst-filters-container,
              .cst-filters-row ,
              .cst-filter.js-filter.cst-sort-filter,
              #main-collection-filters .cst-sort-radio-list{
                flex-direction:column;
              }
              #main-collection-filters .cst-sort-radio-list{
              gap:0;
              }
              #main-collection-filters .cst-clear-btn, #main-collection-filters .cst-apply-btn {
                height: auto;
                width: auto;
                min-width: 143px;
                min-height: 33px;
                font-size: 20.52px;
                border: 1.58px solid #000000;
                color:#000;
              }
              #main-collection-filters  .mobile-icon{
                display:inline;
              }
              #main-collection-filters .cst-filters-container{
                gap:0;
              }
               
              #main-collection-filters .cst-product-count.mobile   {
                display:block;
              }
              #main-collection-filters .cst-clear-desktop{
                display:none;
              }
              .price_range_filter{
                height: 32.4px;
              }
              .price_range_submit {
                height: 32.4px;
                min-width: 45.83px;
              }
            }
            @media screen and (max-width: 750px) {
                #main-collection-filters .cst-filters-row{
                  width: 85%;
                }
                #main-collection-filters {
                  padding: 0 12px;
                }
                .filter_sort_selector{
                  width:55%;
                }
                .price_range_filter::placeholder{
                  font-size: 24px !important;
                }
            }
        {% endstyle %}

        <aside id="main-collection-filters" class="cst-facets-wrapper" data-section-id="{{ section.id }}">
          <form id="CSTFacetForm" class="cst-facet-form" action="{{ collection.url }}" method="get" novalidate>
            <!-- FILTERS (horizontal style) -->
            {% if section.settings.filter_text != blank %}
              <div class="filter-top-text">{{ section.settings.filter_text }}</div>
            {% endif %}
            <div class="cst-filters-container">
              <b>
                filter <span class="mobile-icon">+</span>
                <span class="mobile-icon-open" style="display:none;">-</span>
              </b>
              <div class="cst-filters-row-overlay"></div>
              <div class="cst-filters-row cst-filters-drawer">
                <div class="mobile-filter-header">
                  <div class="mobile-filter-menu">
                    <span class="fillter--menubtn">MENU</span>
                    <span class="fillter--close">CLOSE X</span>
                  </div>
                  <div class="mobile-filter-breadcrumb">
                    {%assign menu = linklists['shop-menu'].links %}
                    {%assign menu_second = linklists['main-menu'].links %}
                    {% for link in menu %}
                        {% if link.active or link.child_active %}
                            <span class="mobile-breadcrumb-startpoint">SHOP</span>
                            <img src="https://cdn.shopify.com/s/files/1/0565/5114/5551/files/Screenshot_102.png?v=1762611259" alt="icon" width="auto" height="16px">
                            {{ link.title }}
                            {% if link.links != blank %}
                                {% for child_link in link.links %}
                                    {% if child_link.active or child_link.child_active %}
                                        <img src="https://cdn.shopify.com/s/files/1/0565/5114/5551/files/Screenshot_102.png?v=1762611259" alt="icon" width="auto" height="16px">
                                        <span class="bd-child">{{ child_link.title }}</span>
                                        {% break %}
                                    {% endif %}
                                {% endfor %}
                            {%endif %}
                        {% endif %}
                    {% endfor %}
                    {% for link in menu_second %}
                        {% if link.active or link.child_active %}
                            <span class="mobile-breadcrumb-startpoint">INFO</span>
                            <img src="https://cdn.shopify.com/s/files/1/0565/5114/5551/files/Screenshot_102.png?v=1762611259" alt="icon" width="auto" height="16px">
                            {{ link.title }}
                            {% if link.links != blank %}
                                {% for child_link in link.links %}
                                    {% if child_link.active or child_link.child_active %}
                                        <img src="https://cdn.shopify.com/s/files/1/0565/5114/5551/files/Screenshot_102.png?v=1762611259" alt="icon" width="auto" height="16px">
                                        <span class="bd-child">{{ child_link.title }}</span>
                                        {% break %}
                                    {% endif %}
                                {% endfor %}
                            {%endif %}
                        {% endif %}
                    {% endfor %}
                  </div>
                </div>
                {%- for filter in collection.filters -%}
                  {% comment %}
                    <div
                      class="cst-filter js-filter"
                      data-filter-name="{{ filter.param_name }}"
                      data-filter-type="{{ filter.type }}"
                    >
                  {% endcomment %}
                  {% style %}
                    button.cst-filter-label[data-filter-name="{{ filter.param_name }}"][aria-expanded="false"] ~ label[data-filter-name="{{ filter.param_name }}"]{
                      display:none;

                    }
                    button.cst-filter-label[data-filter-name="{{ filter.param_name }}"][aria-expanded="true"] ~ label[data-filter-name="{{ filter.param_name }}"]{
                      /* display:inline-block; */
                      display: inline-flex;
                      align-items: center;
                    }
                  {% endstyle %}
                  <div class="cst-filter-btn" role="filter-list">
                  
                  <button
                    type="button"
                    class="cst-filter-label"
                    data-filter-name="{{ filter.param_name }}"
                    aria-expanded="{% if filter.label == 'Price' %}true{% else %}true{% endif %}"
                    aria-controls="panel-{{ forloop.index }}"
                    filter_name="{{ filter.label | handleize }}"
                    {% if filter.label == 'Price' %}filter_toggle_disabled{% endif %}
                  >
                    <span>
                      {{ filter.label }}
                    </span>
                    {% if filter.active_values.size > 0 %}
                      <div style="display:none;">
                      <span class="filter-seperator">:</span>
                      <div class="cst-values datavalue-{{ filter.label | downcase }}" active_values="{{ filter.active_values | map: 'label' | join: ',' | downcase }}">
                        {% for v in filter.active_values -%}
                          <span class="filter-lable" style="color:{{- v.label | downcase }};">
                            {{- v.label -}}
                          </span>
                          <span> </span>
                          {%- unless forloop.last %}, {% endunless -%}
                        {%- endfor %}
                      </div>
                      </div>
                    {% endif %}
                    <span class="price_colun">:</span>
                    {% comment %} {% if filter.label == 'Price' %}
                      <span class="price_colun">:</span>
                    {% else %}
                      <span class="icon"> &gt;</span>
                    {% endif %} {% endcomment %}
                  </button>

                  {% case filter.type %}
                    {% when 'list' %}
                      {% for val in filter.values %}
                        <label
                          data-filter-name="{{ filter.param_name }}"
                          class="
                            cst-checkbox {% if val.active %}
                              checked
                            {% endif %}
                          "
                        >
                          <input
                            type="checkbox"
                            name="{{ val.param_name }}"
                            value="{{ val.value }}"
                            {% if val.active %}
                              {% assign show_Cout_filter = true %}
                              checked
                            {% endif %}
                            data-count="{{ val.count }}"
                          >

                          {% assign val_color = val.label | strip | downcase %}
                          {% for color_item in all_colors %}
                            {% assign parts = color_item | split: ':' %}
                            {% assign color_name = parts.first | strip | downcase %}
                            {% assign color_hex = parts.last | strip %}
                            {% if color_name == val_color %}
                              {% assign val_color = color_hex %}
                            {% endif %}
                          {% endfor %}

                          <span class="cst-checkbox-label" style="color:{{ val_color }};">
                            {{- val.label -}}
                          </span>
                          {%- unless forloop.last -%},{% endunless %}&nbsp;
                          {% if forloop.last %}
                            <span class="filter-seperation"></span>
                          {% endif %}
                        </label>
                      {% endfor %}

                    {% when 'price_range' %}
                      {% assign currency_symbol = shop.money_format | replace: '{{amount}}', '' | strip %}

                      <div class="cst-price-range-row" data-filter-name="{{ filter.param_name }}">
                        <div class="cst-price-range-label">{{ filter.label }}:</div>
                        <label>
                          {% comment %} {{ currency_symbol }} {% endcomment %}
                          <input
                            type="number"
                            name="{{ filter.min_value.param_name }}"
                            placeholder="FROM"
                            value="{% if filter.min_value.value %}{{ filter.min_value.value | divided_by: 100 }}{% endif %}"
                            min="0"
                            max="{{ filter.range_max | divided_by: 100 }}"
                            class="price_range_filter"
                          >
                        </label>
                        {% comment %} <span class="cst-price-sep">—</span> {% endcomment %}
                        <label>
                          {% comment %} {{ currency_symbol }} {% endcomment %}
                          <input
                            type="number"
                            name="{{filter.max_value.param_name}}"
                            placeholder="TO"
                            value="{% if filter.max_value.value %}{{ filter.max_value.value | divided_by: 100 }}{% endif %}"
                            min="0"
                            max="{{ filter.range_max | divided_by: 100 }}"
                            class="price_range_filter"
                          >
                        </label>
                        <button class="price_range_submit">
                          <svg xmlns="http://www.w3.org/2000/svg" width="14" height="11" viewBox="0 0 14 11" fill="none">
                            <path d="M8.59167 0.351562L8.025 0.905729L12.0708 4.95573H0.25V5.7474H12.0708L8.025 9.80156L8.59167 10.3516L13.5833 5.35156L8.59167 0.351562Z" fill="white" stroke="white" stroke-width="0.5"/>
                          </svg>
                        </button>
                      </div>

                    {% else %}

                  {% endcase %}
                  </div>
                {%- endfor -%}

                {% comment %} {% if show_Cout_filter %} {% endcomment %}
                  <div id="ProductCount" class="cst-product-count mobile">{{ collection.products_count }} Products</div>
                {% comment %} {% endif %} {% endcomment %}

                <button type="button" class="cst-apply-btn mobile">Apply Filters</button>
                <button type="button" class="cst-clear-btn mobile">Clear Filters</button>
              </div>
            </div>

            <!-- SORT BY -->
            <div class="cst-filter js-filter cst-sort-filter" data-filter-name="sort_by">
              <button
                type="button"
                class="cst-filter-label cst-sort-label"
                aria-expanded="false"
                aria-controls="panel-sort"
              >
                <b>Sort By:</b>
                <span class="cst-values">
                  {{- collection.sort_by | default: collection.default_sort_by | capitalize -}}
                </span>
                <select class="filter_sort_selector" name="sort_by">
                  {% for option in collection.sort_options %}
                    <option data-value="{{ option.value  }}" value="{{ option.value }}"
                      {% if option.value == collection.sort_by %}
                        selected
                      {% endif %}
                    >{{ option.name }}</option>
                  {% endfor %}  
                </select>
              </button>

              {% comment %} {% for option in collection.sort_options %}
                <label class="cst-sort-radio-item">
                  <input
                    type="radio"
                    name="sort_by"
                    data-value="{{ option.value  }}"
                    value="{{ option.value }}"
                    {% if option.value == collection.sort_by %}
                      checked
                    {% endif %}
                  >
                  <span>{{ option.name }}</span>
                </label>
              {% endfor %} {% endcomment %}
            </div>

            <!-- BOTTOM: count + clear -->
            <div class="cst-bottom-row">
              
                <div id="ProductCount" class="cst-product-count decstop">{{ collection.products_count }} Products</div>
              

              <button type="button" class="cst-clear-desktop">Clear Filters</button>
            </div>
            <!-- .cst-filters-row -->
          </form>
        </aside>

        <!--
          =========================
          Styles (paste into section CSS or theme stylesheet)
          =========================
        -->
        <style></style>
      {%- endif -%}

      <div
        class="product-grid-container{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}
        {%- if collection.products.size == 0 -%} productGridContainer-empty{% endif %}"
        id="ProductGridContainer"
        {% if settings.animations_reveal_on_scroll %}
          data-cascade
        {% endif %}
      >
        {%- if collection.products.size == 0 -%}
          <div class="collection collection--empty page-width-collection" id="product-grid" data-id="{{ section.id }}">
            <div class="loading-overlay gradient"></div>
            <div class="title-wrapper center">
              {% comment %} <h2 class="title title--primary">
                {{ 'sections.collection_template.empty' | t -}}
                <br>
                {{
                  'sections.collection_template.use_fewer_filters_html'
                  | t: link: collection.url, class: 'underlined-link link'
                }}
              </h2> {% endcomment %}
              {% assign coll_link = '<a class="clear-filter-btn" href="' | append:collection.url | append:'">clear filters</a>' %}
              {% if section.settings.no_result_text != blank %}
                <div class="no-result-text">{{ section.settings.no_result_text | replace:'[clear filters]',coll_link }}</div>
              {% endif %}
            </div>
          </div>
        {%- else -%}
          <div
            class="collection{% if section.settings.filter_type != 'vertical' %} page-width-collection{% endif %}"
          >
            <div class="loading-overlay gradient"></div>
            <ul
              id="product-grid"
              data-id="{{ section.id }}"
              class="00 
                grid product-grid grid--{{ section.settings.columns_mobile }}-col-tablet-down
                grid--{{ section.settings.columns_desktop }}-col-desktop 
                {% if section.settings.quick_add == 'bulk' %} collection-quick-add-bulk{% endif %}
              "
            >
              {%- for product in collection.products -%}
                {%- assign hide_from_collection = product.metafields.custom.hide_form_collection -%}

                {% comment %} <script>
                  console.log('1', `{{product.metafields.custom_tabs.material.value }}`);
                </script> {% endcomment %}
                {%- if hide_from_collection == blank or hide_from_collection == false -%}

                  <li
                    class="grid__item{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}"
                    {% if settings.animations_reveal_on_scroll %}
                      data-cascade
                      style="--animation-order: {{ forloop.index }};"
                    {% endif %}
                    app="{{ hide_from_collection }}"
                  >
                    {% assign is_available = product.available %}

                    <div
                      id="cst-grid"
                      class="cst-product-card"
                      data-product-id="{{ product.id }}"
                    >
                      {% if product.metafields.custom.product_card_image_badges != blank %}
                        <div class="product_card_image_badges">
                          {% for img in product.metafields.custom.product_card_image_badges.value %}
                            <img src="{{ img | image_url }}" width="auto" height="auto" alt="image">
                          {% endfor %}
                        </div>
                      {% endif %}
                      <div class="crumpler-capsules__wrapper">
                        {% # Metafield Capsules %}
                        {% assign capsules = product.metafields.crumpler.tag.value %}
                        {% for capsule in capsules %}
                          <span class="capsule capsule--no-border crumpler-capsules__product_capsule">{{ capsule }}</span>
                        {% endfor %}
                      </div>
                      <div class="cst-main-slider">
                        <div class="cst-wrapper swiper-wrapper">
                          {% comment %} {% if is_available %} {% endcomment %}

                              {% assign color_option_names = 'color,colour' | split: ',' %}

                              {% for option in product.options_with_values %}
                                {% assign option_name_down = option.name | downcase %}


                                {% if color_option_names contains option_name_down %}
                                  {% assign option_index = option.position | minus: 1 %}

                                  {% for color in option.values %}  
                                    {% for variant in product.variants %}
                                      
                                      {% if variant.options[option_index] == color and variant.metafields.custom.hide_variant_from_collection_page == true %}
                                        {% continue %}
                                      {% endif %}
                                    
                                      {% if variant.options[option_index] == color %}

                                        {% assign variant_video = blank %}
                                        {% if variant.metafields.custom.collection_display_image != blank %}
                                          {% assign variant_video = variant.metafields.custom.collection_display_image | file_url %}
                                          {% assign variant_img = variant.metafields.custom.collection_display_image %}
                                        {% elsif variant.featured_image %}
                                          {% assign variant_img = variant.featured_image | image_url %}
                                        {% else %}
                                          {% assign variant_img = product.featured_image | image_url %}
                                        {% endif %}
                                        {% if variant_video contains 'videos' %}
                                            <div class="swiper-slide">
                                              <div class="cst-slide-inner">
                                                <a
                                                  href="{{ variant.url }}"
                                                  class="cst-image-link {% unless variant.available %} cst-disabled {% endunless %}"
                                                >
                                                  {% unless variant.available %}<div class="cst-disabled-overlay" aria-hidden="true"></div>{% endunless %}
                                                  <div class="cst-product-image-wrapper">
                                                    <video class="cst-product-video" autoplay loop muted playsinline>
                                                      <source src="{{ variant_video }}" type="video/mp4">
                                                    </video>
                                                  </div>
                                                </a>
                                              </div>
                                            </div>
                                        {% else %}
                                          {% if variant_img %}
                                            <div class="swiper-slide">
                                              <div class="cst-slide-inner">
                                                {% comment %} <a
                                                  href="{{ variant.url }}"
                                                  class="cst-image-link {% unless variant.metafields.pickup.shipping_qty > 0 %} cst-disabled {% endunless %}"
                                                > {% endcomment %}
                                                <a
                                                  href="{{ variant.url }}"
                                                  class="cst-image-link {% unless variant.available %} cst-disabled {% endunless %}"
                                                >
                                                  {% unless variant.available %}<div class="cst-disabled-overlay" aria-hidden="true"></div>{% endunless %}
                                                  <div class="cst-product-image-wrapper">
                                                    <img
                                                      srcset="
                                                        {%- if variant_img.width >= 165 -%}{{ variant_img | image_url: width: 165 }} 165w,{%- endif -%}
                                                        {%- if variant_img.width >= 360 -%}{{ variant_img | image_url: width: 360 }} 360w,{%- endif -%}
                                                        {%- if variant_img.width >= 533 -%}{{ variant_img | image_url: width: 533 }} 533w,{%- endif -%}
                                                        {%- if variant_img.width >= 720 -%}{{ variant_img | image_url: width: 720 }} 720w,{%- endif -%}
                                                        {%- if variant_img.width >= 940 -%}{{ variant_img | image_url: width: 940 }} 940w,{%- endif -%}
                                                        {%- if variant_img.width >= 1066 -%}{{ variant_img | image_url: width: 1066 }} 1066w,{%- endif -%}
                                                        {%- if variant_img.width >= 1550 -%}{{ variant_img | image_url: width: 1550 }} 1550w,{%- endif -%}
                                                        {%- if variant_img.width >= 2000 -%}{{ variant_img | image_url: width: 2000 }} 2000w,{%- endif -%}
                                                        {%- if variant_img.width >= 2500 -%}{{ variant_img | image_url: width: 2500 }} 2500w,{%- endif -%}
                                                        {{ variant_img | image_url }} {{ variant_img.width }}w
                                                      "
                                                      src="{{ variant_img | image_url: width: 533 }}"
                                                      sizes="(min-width: {{ settings.page_width }}px) {{ settings.page_width | minus: 130 | divided_by: 4 }}px, (min-width: 990px) calc((100vw - 130px) / 4), (min-width: 750px) calc((100vw - 120px) / 3), calc((100vw - 35px) / 2)"
                                                      alt="{{ product.title | escape }}"
                                                      class="motion-reduce cst-product-image skeleton"
                                                      loading="lazy"
                                                      width="{{ variant_img.width }}"
                                                      height="{{ variant_img.height }}"
                                                      onload="this.classList.remove('skeleton')"
                                                    >
                                                  </div>
                                                </a>
                                              </div>
                                            </div>
                                          {% endif %}
                                        {% endif %}

                                        {% break %}
                                      {% endif %}
                                    {% endfor %}
                                  {% endfor %}
                                {% endif %}
                          {% endfor %}
                        </div>
                      </div>

                      <a class="cst-product-title" href="{{ product.url }}">
                        {{- product.title }} {{ product.price | money_without_trailing_zeros -}}
                      </a>

                      <div class="cst-swatches">
                        {% comment %} <div class="swiper-button-prev cst-swatch-prev"></div> {% endcomment %}

                        <div class="cst-swatch-slider">
                          <div class="cst-swatch-wrapper swiper-wrapper">

                            {% assign color_option_names = 'color,colour' | split: ',' %}

                            {% for option in product.options_with_values %}
                                {% assign option_name_down = option.name | downcase %}
                                {% assign option_index = option.position | minus: 1 %}

                                {% if color_option_names contains option_name_down %}

                                  {% for color in option.values %}

                                    {% for variant in product.variants %}
                                        {% if variant.options[option_index] == color and variant.metafields.custom.hide_variant_from_collection_page == true %}
                                          {% continue %}
                                        {% endif %}
                                    
                                        {% if variant.options[option_index] == color %}

                                            {%- comment -%}
                                              Priority:
                                              1. Variant swatch (image or color)
                                              2. Metafield swatch fallback
                                            {%- endcomment -%}

                                            {% comment %}
                                            {% assign swatches = product.metafields.alt.swatches.value %}
                                            {% assign this_swatch = blank %} 
                                            {% if color.swatch.image %}
                                              {% assign this_swatch = color.swatch %}
                                            {% elsif color.swatch.color %}
                                              {% assign this_swatch = color.swatch %}
                                            {% else %}
                                              {% for swatch in swatches %}
                                                {% assign swatch_color_down = swatch.colour | downcase %}
                                                {% assign color_down = color | downcase %}
                                                {% assign swatch_name_down = swatch.name | downcase %}

                                                {% if color_down contains swatch_name_down %}
                                                  {% if swatch.image or swatch.color %}
                                                    {% assign this_swatch = swatch %}
                                                  {% endif %}
                                                {% endif %}
                                              {% endfor %}
                                            {% endif %} {% endcomment %}

                                            {% assign swatch_colors = variant.metafields.custom.colour_filter.value | map:'colour' | join: ',' | downcase %}
                                            <div class="swiper-slide" color="{{ color }}" meta_color="{{ swatch_colors }}">
                                              <div class="cst-slide-inner">
                                                <div class="cst-swatch-image-wrapper">
                                                  {% render 'swatch',
                                                    swatch: color.swatch,
                                                    option_value: color,
                                                    product: product,
                                                    alt_swatches: true,
                                                    swatch_size: 16,
                                                    shape: 'square',
                                                    variant_colors:swatch_colors
                                                  %}
                                                </div>
                                              </div>
                                            </div>
                                          {% break %}
                                        {% endif %}
                                    {% endfor %}
                                  {% endfor %}
                                {% endif %}
                            {% endfor %}
                          </div>
                        </div>

                        {% comment %} <div class="swiper-button-next cst-swatch-next"></div> {% endcomment %}
                      </div>

                      {% unless is_available %}
                        {% if section.settings.tag_soldout_img != blank %}
                          <div class="cst-tags-box">
                            <div class="cst-img-box">
                              <img
                                src="{{ section.settings.tag_soldout_img | img_url: '400x' }}"
                                width="100%"
                                height="auto"
                                alt="soldout"
                              >
                            </div>
                          </div>
                        {% endif %}
                        {% endunless %}
                    </div>
                  </li>
                {% endif %}
              {%- endfor -%}
            </ul>
            {%- if paginate.pages > 1 -%}
              {% render 'pagination', paginate: paginate, anchor: '' %}
            {%- endif -%}
          </div>
        {%- endif -%}
      </div>
    </div>
  {%- endpaginate -%}
  {% if section.settings.image_shape == 'arch' %}
    {{ 'mask-arch.svg' | inline_asset_content }}
  {%- endif -%}
</div>

<script>
  // Collection Page JavaScript
  document.addEventListener('DOMContentLoaded', function () {
    initializeCollectionPage();
  });

  function toggleMobileFilters() {
    const filtersRow = document.querySelector('.cst-filters-row');
    const filtersOverlay = document.querySelector('.cst-filters-row-overlay');
    filtersRow.classList.toggle('open');
    filtersOverlay.classList.toggle('open_overlay');
  }

  document.addEventListener('click', (e) => {
    
    const filterToggle = e.target.closest('.cst-filters-container b');
    const closeBtn = e.target.closest(' #main-collection-filters .cst-filters-row .fillter--close');
    const applyfilter = e.target.closest('.cst-apply-btn');
    const filtersOverlay = e.target.closest('.cst-filters-row-overlay');
    const cleardesktop = e.target.closest('.cst-clear-desktop');

    if(filterToggle){toggleMobileFilters()}
    if(closeBtn){toggleMobileFilters()}
    if(filtersOverlay){toggleMobileFilters()}
    if(applyfilter){toggleMobileFilters()}
    if(cleardesktop){
      document.querySelector('.cst-clear-btn').click();
    }
  });

  function initializeCollectionPage() {
    VariantSliderInit();
    initFilterSystem();
    initMobileFilterToggle();
    //setupPanelOpenClose();
  }

  // Variant Slider Functionality
  function VariantSliderInit() {
    const colorAttr = document.querySelector('.datavalue-colour')?.getAttribute('active_values');
    const filtered_colors = colorAttr ? colorAttr.split(',') : [];
    document.querySelectorAll('#cst-grid.cst-product-card').forEach(function (card) {
      const mainSliderEle = card.querySelector('.cst-main-slider');
      const swatchSliderEle = card.querySelector('.cst-swatch-slider');

      if (!mainSliderEle || !swatchSliderEle) return;

      let initial_Slide = 0;
      let match_found = false;
      let first_slide = true;
      if (colorAttr != "" && colorAttr) {
        const swatches = swatchSliderEle.querySelectorAll('.color-option');

        for (let index = 0; index < filtered_colors.length; index++) {
          for (let child = 0; child < swatches.length; child++) {
            const swatch = swatches[child];
            const color = swatch.getAttribute('meta_color')?.toLowerCase() || '';

            if (color == filtered_colors[index]) {
                if(first_slide){
                  first_slide = false;
                  initial_Slide = child;
                  match_found = true;
                }else{
                  const dublicate_product = card.closest('li').cloneNode(true);
                  dublicate_product.setAttribute('dublicate-color',filtered_colors[index]);
                  dublicate_product.setAttribute('active-color',child);
                  card.closest('li').after(dublicate_product);
                  match_found = true;
                }
            }
          }
        }
        if(match_found == false){
          card.closest('li').style.display = 'none';
        }
      }

      function moveSwatchIntoView(swatchesWrapper, activeIndex) {
          const swatchesSwiper = swatchesWrapper.swiper;
          if (swatchesSwiper) {
              swatchesSwiper.slideTo(activeIndex, 500);
          }
      }


      const mainSwiper = new Swiper(mainSliderEle, {
        slidesPerView: 1,
        spaceBetween: 0,
        allowTouchMove: true,
        simulateTouch: true,
        cssMode: false,
        mousewheel: {
          invert: false,
          forceToAxis: true,
        },
        on: {
          slideChange: function () {
            setSwatchActive(mainSwiper.activeIndex);
          },
        },
      });

      const swatchSwiper = new Swiper(swatchSliderEle, {
        slidesPerView: 'auto',
        breakpoints: {
          0: {
            spaceBetween: 2,
          },
          425: {
            spaceBetween: 4.4,
          },
          768: {
            spaceBetween: 4.4,
          },
          1200: {
            spaceBetween: 4.4,
          },
        },
        navigation: {
          nextEl: card.querySelector('.cst-swatch-next'),
          prevEl: card.querySelector('.cst-swatch-prev'),
        },
        mousewheel: {
          forceToAxis: true,
          sensitivity: 1,
          releaseOnEdges: true
        },
      });

      swatchSwiper.slides.forEach((slideEl, idx) => {
        slideEl.addEventListener('mouseenter', () => {
          mainSwiper.slideTo(idx, 500);
          setSwatchActive(idx);
        });
      });

      function setSwatchActive(activeIndex) {
        swatchSwiper.slides.forEach((slide, index) => {
          slide.classList.toggle('cst-active', index === activeIndex);
        });
        swatchSwiper.slideTo(activeIndex, 300, false);
        //swatchSwiper.slideTo(activeIndex);
      }

      mainSwiper.slideTo(initial_Slide);
      setSwatchActive(initial_Slide);
    });

    document.querySelectorAll('li[dublicate-color]').forEach(function (card) {
      const mainSliderEle = card.querySelector('.cst-main-slider');
      const swatchSliderEle = card.querySelector('.cst-swatch-slider');
      const selected_color = card.getAttribute('dublicate-color');
      const active_slide = parseInt(card.getAttribute('active-color'));

      if (!mainSliderEle || !swatchSliderEle) return;

      let initial_Slide = active_slide;
      {% comment %} if (colorAttr != "") {
        const swatches = swatchSliderEle.querySelectorAll('.color-option');
          for (let child = 0; child < swatches.length; child++) {
            const swatch = swatches[child];
            const color = swatch.getAttribute('variant_colors')?.toLowerCase() || '';

            if (color.includes(selected_color)) {
              initial_Slide = child;   
              break;   
            }
          }
      } {% endcomment %}

      const mainSwiper = new Swiper(mainSliderEle, {
        slidesPerView: 1,
        spaceBetween: 8,
        allowTouchMove: true,
        simulateTouch: true,
        cssMode: false,
        mousewheel: {
          invert: false,
          forceToAxis: true,
        },
        on: {
          slideChange: function () {
            setSwatchActive(mainSwiper.activeIndex);
          },
        },
      });

      const swatchSwiper = new Swiper(swatchSliderEle, {
        slidesPerView: 'auto',
        breakpoints: {
          0: {
            spaceBetween: 2,
          },
          425: {
            spaceBetween: 4.4,
          },
          768: {
            spaceBetween: 4.4,
          },
          1200: {
            spaceBetween: 4.4,
          },
        },
        navigation: {
          nextEl: card.querySelector('.cst-swatch-next'),
          prevEl: card.querySelector('.cst-swatch-prev'),
        },
        mousewheel: {
          forceToAxis: true,
          sensitivity: 1,
          releaseOnEdges: true
        },
      });

      swatchSwiper.slides.forEach((slideEl, idx) => {
        slideEl.addEventListener('mouseenter', () => {
          mainSwiper.slideTo(idx, 500);
          setSwatchActive(idx);
        });
      });

      function setSwatchActive(activeIndex) {
        swatchSwiper.slides.forEach((slide, index) => {
          slide.classList.toggle('cst-active', index === activeIndex);
        });
        swatchSwiper.slideTo(activeIndex, 300, false);
        //swatchSwiper.slideTo(activeIndex);
      }

      mainSwiper.slideTo(initial_Slide);
      setSwatchActive(initial_Slide);
    });
  }

  // Filter System
  function initFilterSystem() {
    const filterSection = document.getElementById('main-collection-filters');
    if (!filterSection) return;

    const form = document.getElementById('CSTFacetForm');
    const sectionId = filterSection.dataset.sectionId || '{{ section.id }}';
    const productGridContainer = document.getElementById('ProductGridContainer');

    // Create search params from form
    function createSearchParamsFromForm(formEl) {
      const formData = new FormData(formEl);
      return new URLSearchParams(formData).toString();
    }

    // Fetch and update section
    async function fetchAndUpdateSection(searchParams = '') {
      try {
        const loadingOverlay = document.querySelectorAll('#ProductCount');
        loadingOverlay.forEach(k=>k.textContent = 'Loading...');

        const url = `${window.location.pathname}?section_id=${sectionId}${searchParams ? '&' + searchParams : ''}`;
        const response = await fetch(url);
        const text = await response.text();
        const parser = new DOMParser();
        const doc = parser.parseFromString(text, 'text/html');

        // Update product grid
        const newGrid = doc.getElementById('ProductGridContainer');
        if (newGrid && productGridContainer) {
          productGridContainer.innerHTML = newGrid.innerHTML;
        }
        const productCount = doc.querySelector('.cst-product-count.decstop');
        loadingOverlay.forEach(k=>k.textContent = productCount.innerHTML);

        if (!newGrid) gravityFilters();

        // Update filters section
        const newFilters = doc.getElementById('main-collection-filters');
        if (newFilters) {
          const newDrawer = newFilters.querySelector('.cst-filters-drawer');
          filterSection.querySelector('.cst-filters-drawer').innerHTML = newDrawer.innerHTML;
          // Reinitialize filter functionality
          initFilterSystem();
          //setupPanelOpenClose();
          initMobileFilterToggle();
        }
        const productGrid = doc.querySelector('#product-grid');
        const hasProducts = productGrid && productGrid.querySelectorAll('li').length > 0;
        // Trigger gravity effect if no products

        if (!hasProducts) {
          setTimeout(() => {
            gravityFilters();
          }, 100);
        }
        // Update URL
        const newURL = `${window.location.pathname}${searchParams ? '?' + searchParams : ''}`;
        history.pushState({ searchParams }, '', newURL);

        // Reinitialize sliders
        VariantSliderInit();
      } catch (error) {
        console.error('Error updating collection:', error);
      }
    }

    // Debounce function
    function debounce(func, wait) {
      let timeout;
      return function executedFunction(...args) {
        const later = () => {
          clearTimeout(timeout);
          func(...args);
        };
        clearTimeout(timeout);
        timeout = setTimeout(later, wait);
      };
    }

    // Handle form changes
    const handleFormChange = debounce(function (event) {
      const searchParams = createSearchParamsFromForm(form);
      fetchAndUpdateSection(searchParams);
    }, 300);

    // Add event listeners to form inputs
    form.querySelectorAll('input:not(.price_range_filter), select').forEach((input) => {
      input.addEventListener('change', handleFormChange);
    });

    form.querySelectorAll('.price_range_submit').forEach((btn) => {
      btn.addEventListener('click', handleFormChange);
    });

    // Clear filters
    const clearButtons = document.querySelectorAll('.cst-clear-btn');
    if (clearButtons) {
      clearButtons.forEach((clearButton)=>{
        clearButton.addEventListener('click', function (e) {
          e.preventDefault();
          form.reset();
          history.pushState({}, '', window.location.pathname);
          fetchAndUpdateSection('');
        });
      });
    }

    // Handle browser back/forward
    window.addEventListener('popstate', function (event) {
      const searchParams = window.location.search.slice(1);
      if (searchParams) {
        // Update form to match URL parameters
        const urlParams = new URLSearchParams(searchParams);
        updateFormFromParams(urlParams);
        fetchAndUpdateSection(searchParams);
      } else {
        form.reset();
        fetchAndUpdateSection('');
      }
    });

    function updateFormFromParams(urlParams) {
      // Reset all inputs first
      form.querySelectorAll('input[type="checkbox"]').forEach((cb) => (cb.checked = false));
      form.querySelectorAll('input[type="number"]').forEach((input) => (input.value = ''));
      form.querySelectorAll('input[type="radio"]').forEach((radio) => (radio.checked = false));

      // Set values from URL params
      urlParams.forEach((value, key) => {
        const inputs = form.querySelectorAll(`[name="${key}"]`);
        inputs.forEach((input) => {
          if (input.type === 'checkbox' || input.type === 'radio') {
            input.checked = input.value === value;
          } else {
            input.value = value;
          }
        });
      });
    }
  }
  

