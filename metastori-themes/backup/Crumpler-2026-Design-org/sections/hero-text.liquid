<style>
{% for block in section.blocks %}
    {% capture desktop_css %}{{ desktop_css }}
        @media (min-width:768px){
            .{{ block.id }}{
                padding-top:{{ block.settings.padding_top }}px;
            }
        }
    {% endcapture %}
    {% capture mobile_css %}{{ mobile_css }}
        @media (max-width:767px){
            .{{ block.id }}{
                padding-top:{{ block.settings.padding_top_m }}px;
            }
        }   
    {% endcapture %}
{% endfor %}
.hero-image-item, .hero-video-item{
    display:flex;
    width:100%;
    justify-content:center;
}
.hero-image-item img, .hero-image-item video {
    max-width: 100%;
}
.hero-image-item image, .hero-video-item video{
    max-width:100%;
    width:100%;
}
.hero-text-item {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    text-transform: uppercase;
    color: #000;
    line-height: 100%;
    flex-wrap: wrap;
}
.hero-text-left, .hero-text-right{
    display:block!important;
}

.hero-heading-main{
    position:relative;
}

.hero-bottom-content {
    display: flex;
    justify-content: center;
    align-items: center;
    gap:7px;
    line-height:1;
    padding-bottom: 20px;
    {% if section.settings.overlay_content == true %}
    position:absolute;
    bottom:0;
    width:100%;
    {% endif %}
}
.hero-bottom-btn {
    background: {{ section.settings.btn_bg }};
    color: {{ section.settings.btn_color }};
    padding: 3px 3px 1px;
    line-height: 1;
    text-decoration: none;
    text-transform: uppercase;
}
.hero-bottom-text{
    line-height: 1;
}
.hero-bottom-btn:hover{
    background: {{ section.settings.btn_bg_hover }};
    color: {{ section.settings.btn_color_hover }};
}
@media (max-width:767px){
    .text-{{ section.id }}{
        font-size:{{ section.settings.font_size_m }};
    }
    .{{ section.id }} .hero-bottom-text{
        font-size:{{ section.settings.bottom_size_m }};
    }
    .hero-bottom-content{
        flex-direction: column;
    }
    {% comment %} .hero-image-item img, .hero-image-item video {
        padding:0 30px;
    } {% endcomment %}
    {{ mobile_css }}
}
@media (min-width:768px){
    .text-{{ section.id }}{
        font-size:{{ section.settings.font_size }};
    }
    .{{ section.id }} .hero-bottom-text{
        font-size:{{ section.settings.bottom_size }};
    }
    {{ desktop_css }}
}
</style>

<div class="hero-heading-main {{ section.id }}">
   <div class="hero-wrapper">
        {% for block in section.blocks %}
            <div class="hero-item">
                {% case block.type %}
                    {% when 'heading' %}
                        <div class="hero-text-item text-{{ section.id }}">
                            <div class="hero-text-left">{{ block.settings.text_left }}</div>
                            <div class="hero-text-right">{{ block.settings.text_right }}</div>
                        </div>
                    {% when 'image' %}
                        <div class="hero-image-item">
                            <img class="desktop_img" src="{{ block.settings.image | image_url }}" alt="image-{{ block.settings.image.alt }}" width="auto" height="auto">
                            {% if block.settings.image_m != blank %}
                                <img class="mobile_img" src="{{ block.settings.image_m | image_url }}" alt="image-{{ block.settings.image_m.alt }}" width="auto" height="auto">
                            {% else %}
                                <img class="mobile_img" src="{{ block.settings.image | image_url }}" alt="image-{{ block.settings.image.alt }}" width="auto" height="auto">
                            {% endif %}
                        </div>
                    {% when 'video' %}
                        <div class="hero-video-item">
                            {{ block.settings.video | video_tag:autoplay:true, loop:true, muted:true }}
                        </div>
                    {% when 'space' %}
                        <div class="{{ block.id }}" style="display:block;"></div>
                {% endcase %}
                {% if block.type == 'heading' %}
                {% endif %}
            </div>
        {% endfor %}
   </div>
   {% if section.settings.text != blank or section.settings.btn_name != blank %}
    <div class="hero-bottom-content">
        {% if section.settings.text != blank %}
            <span class="hero-bottom-text" style="color:{{ section.settings.text_color }};">{{ section.settings.text }}</span>
        {% endif %}
        {% if section.settings.btn_name != blank %}
            <a class="hero-bottom-text hero-bottom-btn" href="{{ section.settings.btn_link }}">{{ section.settings.btn_name }}</a>
        {% endif %}
    </div>
   {% endif %}
</div>

