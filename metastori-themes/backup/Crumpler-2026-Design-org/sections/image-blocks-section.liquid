{% schema %}
{
  "name": "Image blocks",
  "settings": [
    {
      "type": "range",
      "id": "section_height",
      "min": 50,
      "max": 150,
      "step": 5,
      "unit": "vh",
      "default": 100,
      "label": "Section height"
    },
    {
      "type": "range",
      "id": "side_crop",
      "min": 0,
      "max": 20,
      "step": 1,
      "unit": "%",
      "default": 10,
      "label": "Partial visibility amount (desktop)"
    }
  ],
  "blocks": [
    {
      "type": "image_block",
      "name": "Image Block",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link (optional)"
        }
      ]
    },
    {
      "type": "video_block",
      "name": "Video Block",
      "settings": [
        {
          "type": "url",
          "id": "video_url",
          "label": "Video URL (MP4 link)"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link (optional)"
        }
      ]
    }
  ],
  "max_blocks": 10,
  "presets": [
    {
      "name": "Image blocks",
      "category": "Image"
    }
  ]
}
{% endschema %}

<section class="custom-three-image-section" style="--section-height: {{ section.settings.section_height }}vh; --side-crop: {{ section.settings.side_crop }}%;">
  <div class="three-image-container">
    {% for block in section.blocks %}
      {% case block.type %}
        {% when 'image_block' %}
          {% assign image = block.settings.image %}
          {% assign link = block.settings.link %}
          <div class="image-block" {{ block.shopify_attributes }}>
            {% if link != blank %}<a href="{{ link }}">{% endif %}
              {% if image != blank %}
                <img src="{{ image | image_url: width: 1600 }}" alt="" loading="lazy">
              {% else %}
                <div class="placeholder">Add image</div>
              {% endif %}
            {% if link != blank %}</a>{% endif %}
          </div>

        {% when 'video_block' %}
          {% assign video_url = block.settings.video_url %}
          {% assign link = block.settings.link %}
          <div class="image-block" {{ block.shopify_attributes }}>
            {% if link != blank %}<a href="{{ link }}">{% endif %}
              {% if video_url != blank %}
                <video autoplay muted loop playsinline>
                  <source src="{{ video_url }}" type="video/mp4">
                </video>
              {% else %}
                <div class="placeholder">Add video URL</div>
              {% endif %}
            {% if link != blank %}</a>{% endif %}
          </div>
      {% endcase %}
    {% endfor %}
  </div>
</section>

<style>
.custom-three-image-section {
  position: relative;
  width: 100%;
  height: var(--section-height);
  overflow: hidden;
  margin-top:118px;
  z-index:-1;
}

.three-image-container {
  display: flex;
  align-items: center;
  margin-top:20px;
  height: 100%;
  width: calc(100% + var(--side-crop) * 2);
  margin-left: calc(var(--side-crop) * -1);
  overflow-x: hidden;
}

.image-block {
  flex: 1 0 33.33%;
  height: 100%;
  overflow: hidden;
  position: relative;
}

.image-block img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  object-position: center;
  display: block;
}

.image-block video {
  width: 100%;
  height: 100%;
  object-fit: cover;
  object-position: center;
  display: block;
}

/* Placeholder style */
.placeholder {
  background: #f3f3f3;
  color: #999;
  height: 100%;
  display: flex;
  justify-content: center;
  align-items: center;
}

/* When more than 3 blocks → horizontal scroll (desktop) */
@media (min-width: 769px) {
  .three-image-container {
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    -webkit-overflow-scrolling: touch;
  }
  .image-block {
    flex: 0 0 33.33%;
    scroll-snap-align: center;
  }
  .three-image-container::-webkit-scrollbar {
    display: none;
  }
}

/* Mobile slider */
@media (max-width: 768px) {
  .three-image-container {
    width: 100%;
    margin: 0;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    -webkit-overflow-scrolling: touch;
    padding-left: 5%;
  }

  .image-block {
    flex: 0 0 90%;
    scroll-snap-align: center;
  }

  .three-image-container::-webkit-scrollbar {
    display: none;
  }
  .custom-three-image-section {
    margin-top: 70px;
  }
}
</style>
