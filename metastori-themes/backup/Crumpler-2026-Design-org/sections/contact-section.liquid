{{ 'contact-section.css' | asset_url | stylesheet_tag }}
<style>
  @media (min-width:1026px){
    .{{ section.id }} .contact-us-wrapper{
          font-size:{{ section.settings.font_size }};
          gap: 8px;
      }
      .contact-us-content-text{
        font-size:{{ section.settings.content_font_size }};
      }
      .form_heading{
        font-size:{{ section.settings.form_heading_font_size }};
      }
      {% if section.settings.show_in_mobile %}
        .contact-us-content-img{display:none;}
      {% endif %}
  }
  @media (max-width:1025px){
      .{{ section.id }} .contact-us-wrapper{
          font-size:{{ section.settings.font_size_m }};
      }
      .contact-us-content-text{
        font-size:{{ section.settings.content_font_size_m }};
      }
      .form_heading{
        font-size:{{ section.settings.form_heading_font_size_m }};
      }
  }
</style>
<div class="contact-us-main {{ section.id }}">
  <div class="contact-us-wrapper">
    <div class="contact-us-content">
        <div class="contact-us-content-text">
          {{ section.settings.content }}
        </div>
        {% if section.settings.image != blank %}
          <div class="contact-us-content-img">
            <img class="" src="{{ section.settings.image | image_url }}" width="auto" height="auto" alt="image">
          </div>
        {% endif %}
    </div>
    <div class="contact_forms_wrapper">
        {% if section.settings.form_heading != blank %}
            <div class="form_heading">{{ section.settings.form_heading }}</div>
        {% endif %}
        <div class="form_dropdown">
            <div class="form_default">
                <span class="form_default_text">Topic</span>
                <svg width="11" height="8" viewBox="0 0 11 8" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <mask id="path-1-outside-1_1046_1319" maskUnits="userSpaceOnUse" x="0" y="0" width="11" height="8" fill="black">
                    <rect fill="white" width="11" height="8"/>
                    <path d="M10.36 1.599L5.68 6.526L1 1.599L1.416 1.274L5.68 5.694L9.944 1.274L10.36 1.599Z"/>
                    </mask>
                    <path d="M10.36 1.599L5.68 6.526L1 1.599L1.416 1.274L5.68 5.694L9.944 1.274L10.36 1.599Z" fill="black"/>
                    <path d="M10.36 1.599L10.65 1.87448L10.9535 1.55503L10.6063 1.28379L10.36 1.599ZM5.68 6.526L5.38998 6.80148L5.68 7.10681L5.97002 6.80148L5.68 6.526ZM1 1.599L0.753742 1.28379L0.40655 1.55503L0.709981 1.87448L1 1.599ZM1.416 1.274L1.70388 0.996283L1.4537 0.736951L1.16974 0.95879L1.416 1.274ZM5.68 5.694L5.39212 5.97172L5.68 6.27013L5.96788 5.97172L5.68 5.694ZM9.944 1.274L10.1903 0.95879L9.9063 0.73695L9.65612 0.996283L9.944 1.274ZM10.36 1.599L10.07 1.32352L5.38998 6.25052L5.68 6.526L5.97002 6.80148L10.65 1.87448L10.36 1.599ZM5.68 6.526L5.97002 6.25052L1.29002 1.32352L1 1.599L0.709981 1.87448L5.38998 6.80148L5.68 6.526ZM1 1.599L1.24626 1.91421L1.66226 1.58921L1.416 1.274L1.16974 0.95879L0.753742 1.28379L1 1.599ZM1.416 1.274L1.12812 1.55172L5.39212 5.97172L5.68 5.694L5.96788 5.41628L1.70388 0.996283L1.416 1.274ZM5.68 5.694L5.96788 5.97172L10.2319 1.55172L9.944 1.274L9.65612 0.996283L5.39212 5.41628L5.68 5.694ZM9.944 1.274L9.69774 1.58921L10.1137 1.91421L10.36 1.599L10.6063 1.28379L10.1903 0.95879L9.944 1.274Z" fill="black" mask="url(#path-1-outside-1_1046_1319)"/>
                </svg>
            </div>
            <div class="form_forms_btns">
                {% for block in section.blocks %}
                    {% if block.type == 'topics' %}
                        <button class="form_topic" data-topic="{{ block.settings.topic_name }}" data-form="{{ block.settings.form_id }}">
                            {{ block.settings.topic_name }}
                        </button>
                    {% endif %}
                {% endfor %}
            </div>
        </div>
        <div class="contact_forms">
            {% for block in section.blocks %}
                {% if block.type == '@app' %}
                    {% render block %}
                {%endif %}
            {% endfor %}
            {% if section.settings.video != blank %}
              <div class="form_submit_media">
                {{ section.settings.video | video_tag:autoplay:false, muted:true, class:'form_media' }}
              </div>
            {% endif %}
            <div class="form_success_media" id="contact-form-success-video" aria-hidden="true">
              <video class="form_success_video" playsinline>
                <source src="https://cdn.shopify.com/videos/c/o/v/5cf10a2fb6a64af1afed1ec9854f5713.mp4" type="video/mp4">
              </video>
            </div>
        </div>
    </div>
    {% if section.settings.floating_video != blank %}
      {{ section.settings.floating_video | video_tag:autoplay:true, loop:true, muted:true, controls:false,class:'contact_floating_video' }}
    {% endif %}
  </div>
</div>


<style id="form-embed-style">
  #app-embed input, #app-embed input + label, #app-embed textarea, #app-embed textarea + label {
      font-size: 13px;
      font-weight: 600;
      line-height: normal;
      padding: 5px 10px;
      height: auto;
      color: #000;
      border:none;
      box-shadow: none;
      min-height:unset;
      border: 1px solid #C4C4C4;
      border-radius: 6px;
  }
  #app-embed form input {
      padding-top: 0 !important;
      padding-bottom: 0 !important;
  }
  {% comment %} #app-embed input:focus-visible, #app-embed textarea:focus-visible{
    border: 1px solid #000000;
    text-decoration:underline;
  } {% endcomment %}
  #app-embed input:focus-visible + label, #app-embed textarea:focus-visible + label{
    text-decoration:underline;
    color:#000;
  }
  #app-embed input + label, #app-embed textarea + label{
    color: #C4C4C4;
    top: 50%;
    transform: translateY(-50%);
    left: 22px;
  }
  #app-embed ._textBody_2aowh_10{
    color: #C4C4C4;
    font-size: 13px;
    font-weight: 600;
    line-height: normal;
  }
  #app-embed input:placeholder-shown + label, #app-embed textarea:placeholder-shown + label {
    display: block;
    top: 50%!important;
    transform: translateY(-50%);
    left: 0;
    border:none;
  }
  input:not(:placeholder-shown) {
    text-decoration: none;
    border-bottom: none;
  }
  #app-embed input:not(:placeholder-shown) + label, #app-embed textarea:not(:placeholder-shown) + label {
    display: none;
  }
  #app-embed [data-sizing="form-wrapper"]{
    max-width: 100%;
    margin: 0;
  }
  #app-embed [data-sizing="form-wrapper"] form{
      gap: 8px!important;
  }
  #app-embed textarea{
      height:134px;
      position:relative;
  }
  #app-embed input::placeholder,
  #app-embed textarea::placeholder {
    color: #C4C4C4;
    opacity: 0;
  }
  #app-embed textarea::placeholder{
    position:absolute;
    top:0;
    left:0;
  }
  #app-embed ._formFieldContainer_ck6wz_5, #app-embed ._formFileInput_ehvsf_1 {
    position: relative;
    width: 100%;
    display: flex;
    transition: box-shadow var(--duration-short) ease;
    flex-direction: column;
    max-width: -webkit-fill-available;
  }

  #app-embed ._formSubmitButton_cit2d_96 {
    width: -webkit-fill-available;
    background: #000;
    color: #fff;
    font-size: 13px;
    font-weight: 600;
    line-height: normal;
    text-transform: capitalize;
    justify-content: center;
    transition: all .3s ease-in-out;
    border: 1.33px solid #000000;
    border-radius:6px;
    padding: 4px;
    align-items: center;
  }
  #app-embed ._formSubmitButton_cit2d_96:hover{
    border-radius:12px;
  }
  #app-embed form._formFieldset_cit2d_82 {
    gap: 0;
    padding: 0;
  }
  #app-embed textarea:placeholder-shown + label{
    overflow: hidden;
    display: -webkit-box;
    -webkit-line-clamp: 1;
    -webkit-box-orient: vertical;
    top: 5px !important;
    transform: unset;
  }
  ._formFieldContainer_1mxsl_5:has(textarea)::before{
    display:none;
  }
  p._textBody_2aowh_10{display:none;}
  #custom\#file-label:after {
    content: "(PDF, JPEG, PNG, WEBP, SVG, HEIC, max file size 20mb)";
    color: red;
    font-size: 11px;
    margin-top: -2px;
  }
  .file-attached:after{
    display:none;
  }
  #custom\#file-label{
    flex-direction: column;
    align-items: center;
  }
  .form_submit_media {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    z-index: 11;
    height: 100%;
    display:none;
  }
  .form_submit_media.active_media{
    display:block;
  }
  .form_submit_media video {
    width: 100%;
    object-fit: cover;
  }
  .form_success_media {
    display: none;
    margin-top: 1rem;
  }
  .form_success_media.active {
    display: block;
  }
  .form_success_media video {
    width: 100%;
    height: auto;
    display: block;
  }
  .contact_forms_wrapper.success-playing #app-embed,
  .contact_forms_wrapper.success-playing shopify-forms-embed {
    display: none !important;
  }
  @media (min-width:768px){
    #app-embed form input {
      height: 2.4rem !important;
    }
    #app-embed input, #app-embed ._formSubmitButton_cit2d_96{
      height: 2.6rem;
    }
    ._formFieldContainer_1mxsl_5 {
      overflow:hidden;
    }
  }
  @media (max-width:767px){
    ._container_3eyaa_70 {
        grid-template-columns: 1fr !important;
    }
    #app-embed input, #app-embed input + label, #app-embed textarea, #app-embed textarea + label, #app-embed ._textBody_2aowh_10,#app-embed ._formSubmitButton_cit2d_96{
      font-size: 26px;
    }
    #app-embed [data-sizing="form-wrapper"] form {
        gap: 16px!important;
    }
    .contact_forms {
        margin-top: 16px;
    }
    ._formFieldContainer_1mxsl_5 {
      border-radius: 12px;
    }
    #app-embed input, #app-embed ._formSubmitButton_cit2d_96{
      height: 5rem !important;
      border-radius: 12px;
    }
  }
</style>

<script>
  document.addEventListener("DOMContentLoaded", function () {

    const formDefault = document.querySelector(".form_default");

    if (formDefault) {
      formDefault.addEventListener("click", (e) => {
        const parent = e.target.closest(".form_dropdown");
        if (parent) parent.classList.toggle("active_dropdown");
      });
    }

    // Handle topic change
    document.querySelectorAll(".form_topic").forEach((item) => {
      item.addEventListener("click", () => {
        const formName = item.getAttribute("data-topic");
        const formId = item.getAttribute("data-form");

        const defaultText = document.querySelector(".form_default_text");
        if (defaultText) {
          defaultText.innerHTML = `<span class="choosen_topic">${formName}</span>`;
        }

        document.querySelectorAll(".contact_forms [data-forms-id]").forEach((el) => {
          el.style.display = "none";
        });

        const targetForm = document.querySelector(
          `.contact_forms [data-forms-id="forms-root-${formId}"]`
        );
        if (targetForm) targetForm.style.display = "block";

        const dropdown = document.querySelector(".form_dropdown");
        if (dropdown) dropdown.classList.remove("active_dropdown");
      });
    });

  });

  const checkForm = setInterval(() => {
    const existingStyle = document.querySelector("#form-embed-style");
    const shadowHosts = document.querySelectorAll("shopify-forms-embed");

    if (shadowHosts.length > 0 && existingStyle) {
      shadowHosts.forEach((formEmbed) => {
        const shadow = formEmbed.shadowRoot;
        if (shadow && !shadow.querySelector("#form-embed-style")) {
          const clonedStyle = existingStyle.cloneNode(true);
          shadow.appendChild(clonedStyle);

          shadow.querySelectorAll("input, textarea").forEach((field) => {
            const hasPlaceholder = field.hasAttribute("placeholder");
            const placeholder = field.getAttribute("placeholder");
            if (!hasPlaceholder || placeholder === "") {
              let labelText = "";
              const labelledBy = field.getAttribute("aria-labelledby");
              if (labelledBy) {
                const label = shadow.getElementById(labelledBy);
                if (label) labelText = label.textContent.trim();
              }
              if (!labelText) {
                const next = field.nextElementSibling;
                if (next && next.tagName === "LABEL") {
                  labelText = next.textContent.trim();
                }
              }
              if (labelText) {
                field.setAttribute("placeholder", labelText);
                field.classList.add("_placeholder-from-label");
              }
            }
          });

          shadow.querySelectorAll("textarea").forEach((textarea) => {
            textarea.setAttribute("rows", "1");
          });

          {% comment %} shadow.querySelectorAll('input[type="file"]').forEach((input) => {
            input.addEventListener('change', function () {
              if (input.files.length > 0) {
                input.closest('button').classList.add('file-attached');
              } else {
                input.closest('button').classList.remove('file-attached');
                input.dispatchEvent(new Event('change', { bubbles: true }));
              }
            });
          });

          
          shadow.addEventListener('click', (e) => {
            const clearBtn = e.target.closest('#custom\#file-clear');
            if (!clearBtn) return;
            shadow.querySelectorAll('input[type="file"]').forEach((input) => {
              const btn = input.closest('button');
              if (btn) btn.classList.remove('file-attached');
              input.value = '';
              input.click();
            });
          }); {% endcomment %}

          document.querySelectorAll(".topic_list_item").forEach((item) => {
            item.classList.remove("topic_item_disabled");
          });

          const successVideoWrap = document.getElementById("contact-form-success-video");
          const successVideo = successVideoWrap ? successVideoWrap.querySelector("video") : null;
          const formsContainer = formEmbed.closest(".contact_forms");
          const wrapper = formEmbed.closest(".contact_forms_wrapper");
          let successHandled = false;

          function hideEmbeds() {
            if (!formsContainer) return;
            formsContainer.querySelectorAll("shopify-forms-embed").forEach((el) => {
              el.style.display = "none";
              el.setAttribute("data-success-hidden", "true");
            });
          }

          function showEmbeds() {
            if (!formsContainer) return;
            formsContainer.querySelectorAll("shopify-forms-embed").forEach((el) => {
              if (el.getAttribute("data-success-hidden") === "true") {
                el.style.display = "";
                el.removeAttribute("data-success-hidden");
              }
            });
          }

          function showCustomSuccessMessage() {
            if (!wrapper || successHandled) return;
            successHandled = true;
            wrapper.classList.add("success-playing");
            wrapper.querySelector(".form_dropdown") && (wrapper.querySelector(".form_dropdown").style.display = "none");
            hideEmbeds();
            if (!successVideoWrap || !successVideo) {
              showEmbeds();
              wrapper.classList.remove("success-playing");
              return;
            }

            successVideoWrap.classList.add("active");
            successVideo.currentTime = 0;
            const onEnded = () => {
              successVideoWrap.classList.remove("active");
              showEmbeds();
              wrapper.classList.remove("success-playing");
            };
            successVideo.addEventListener("ended", onEnded, { once: true });
            const playPromise = successVideo.play();
            if (playPromise && typeof playPromise.catch === "function") {
              playPromise.catch(() => {
                successVideoWrap.classList.remove("active");
                showEmbeds();
                wrapper.classList.remove("success-playing");
              });
            }
          }

          const observer = new MutationObserver(() => {
            const form = shadow.querySelector("form");
            const text = (shadow.innerText || "").toLowerCase();
            const successInShadow = shadow.querySelector("[class*='success'], [class*='thank'], [data-success]");
            if ((!form && successInShadow) || (form && form.hidden) || /thank you|success|submitted/.test(text)) {
              showCustomSuccessMessage();
              observer.disconnect();
            }
          });
          observer.observe(shadow, { childList: true, subtree: true, characterData: true });

          const form = shadow.querySelector("form");
          if (form) {
            form.addEventListener("submit", () => {
              if (wrapper) wrapper.classList.add("success-playing");
              hideEmbeds();
              const checkSuccess = setInterval(() => {
                const formNow = shadow.querySelector("form");
                const text = (shadow.innerText || "").toLowerCase();
                if (!formNow || formNow.hidden || /thank you|success|submitted/.test(text)) {
                  clearInterval(checkSuccess);
                  showCustomSuccessMessage();
                }
              }, 500);
              setTimeout(() => clearInterval(checkSuccess), 15000);
            });
          }
        }
      });

      setTimeout(() => {
          const first_form = document.querySelector('.form_forms_btns button:first-child');
          if (first_form) {
            first_form.click();
          }
      }, 500);

      clearInterval(checkForm);
    }
  }, 200);
</script>

