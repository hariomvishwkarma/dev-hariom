{% schema %}
{
  "name": "Scrolling Marquee Text",
  "settings": [
    {
      "type": "text",
      "id": "marquee_text",
      "label": "Marquee text",
      "default": "LOREM IPSUM LOREM IPSUM LOREM IPSUM LOREM IPSUM"
    },
    {
      "type": "range",
      "id": "font_size",
      "min": 20,
      "max": 120,
      "step": 2,
      "unit": "px",
      "default": 50,
      "label": "Font size (desktop)"
    },
    {
      "type": "select",
      "id": "font_weight",
      "label": "Font weight",
      "default": "400",
      "options": [
        { "value": "400", "label": "Normal" },
        { "value": "500", "label": "Bold" },
        { "value": "600", "label": "Semi Bold" },
        { "value": "700", "label": "Extra Bold" }
      ]
    },
    {
      "type": "range",
      "id": "animation_speed",
      "min": 10,
      "max": 150,
      "step": 5,
      "unit": "s",
      "default": 10,
      "label": "Scroll speed"
    },
    {
      "type":"color",
      "id":"bg_color",
      "label":"Background",
      "default":"#fff"
    },
    {
      "type":"color",
      "id":"text_color",
      "label":"Text Color",
      "default":"#000"
    }
  ],
  "presets": [
    {
      "name": "Scrolling marquee text",
      "category": "Text"
    }
  ]
}
{% endschema %}

<section class="custom-marquee-text" style="--font-size: {{ section.settings.font_size }}px; --speed: {{ section.settings.animation_speed }}s; --weight: {{ section.settings.font_weight }};">
  <div class="marquee">
    <div class="marquee__inner">
      {% for i in (1..8) %}
        <span>{{ section.settings.marquee_text }}</span>
      {% endfor %}
    </div>
  </div>
</section>

<style>
.custom-marquee-text {
  overflow: hidden;
  width: 100%;
  background: {{ section.settings.bg_color }};
  white-space: nowrap;
  border: none;
}

.marquee {
  display: flex;
  align-items: center;
  width: 100%;
  overflow: hidden;
}

.marquee__inner {
  display: inline-flex;
  margin:12px auto 13px;
  animation: marquee var(--speed) linear infinite;
}

.marquee__inner span {
  font-size: var(--font-size);
  font-weight: var(--weight);
  text-transform: uppercase;
  letter-spacing: 1px;
  display: inline-block;
  padding-right: 1.2rem;
  white-space: nowrap;
  color: {{ section.settings.text_color }};
  {% comment %} line-height:100%; {% endcomment %}
}

/* Animation */
@keyframes marquee {
  0% {
    transform: translateX(0);
  }
  100% {
    transform: translateX(-50%);
  }
}

/* Mobile adjustments */
@media (max-width: 1024px) {
  .marquee__inner span {
    font-size: calc(var(--font-size) * 0.95);
  }
  .marquee__inner{
    margin:0;
  }
}
</style>
