        "collapsible_tab_EEKqy8": {
          "type": "collapsible_tab",
          "settings": {
            "heading": "Størrelsesguide",
            "content": "<p>Sokkene våre er veldig fleksible, og vi anbefaler å velge den størrelsen du vanligvis bruker i andre sokker.<br/>Skulle du oppleve at størrelsen ikke er helt riktig, er det bare å sende oss en melding – så fikser vi det.<br/><br/><a href=\"/pages/guide\" target=\"_blank\" title=\"Størrelsesguide\">Se vår størrelsesguide</a></p>",
            "metafield_variables": "",
            "page": "",
            "icon": "ruler"
          }
        },
        "separator_RKabg6": {
