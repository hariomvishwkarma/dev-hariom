        "d162f900-ee92-4311-b27d-d5f312fa73f2": {
          "type": "collapsible_tab",
          "settings": {
            "heading": "Vaskeanvisninger",
            "content": "<ul><li>Vaskes på 40°C (de tåler 60°C om det trengs)</li><li>Unngå tørketrommel hvis du vil bevare levetiden</li><li>Vask med lignende farger</li><li>Unngå skyllemiddel – bambusfiberen holder seg best uten</li></ul><p>Du kan fint vaske sokkene på 60°C og bruke tørketrommel ved behov – bare vær obs på at det kan redusere levetiden noe og gjøre at sokkene krymper en anelse.</p>",
            "metafield_variables": "",
            "page": "",
            "icon": "washing"
          }
        },
        "separator_nCEFyB": {
          "type": "separator",
          "settings": {
