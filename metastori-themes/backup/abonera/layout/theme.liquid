<style>
  /* Hide cart items until JS check completes */
  .wt-cart__items { visibility: hidden; }
</style>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    // Intercept add-to-cart on product pages and redirect to bundle
    document.body.addEventListener('submit', function(event) {
      const form = event.target.closest('.wt-product__add-to-cart_form');
      if (!form) return;
      event.preventDefault();

      const formData = new FormData(form);
      fetch('/cart/add.js', { method: 'POST', body: formData })
        .then(res => res.json())
        .then(() => {
          setTimeout(() => {
            window.location.href =
              'https://kmh1bz-1r.myshopify.com/a/loop_subscriptions/bundle/7dc5bea43e534d23b0a1811c603a2ec2';
          }, 500);
        })
        .catch(err => console.error('Error adding product:', err));
    });

    // Only run on cart page (excluding bundle URL)
    const path = window.location.pathname;
    if (!path.includes('/cart') || path.includes('/a/loop_subscriptions/bundle')) {
      document.querySelector('.wt-cart__items')?.style.setProperty('visibility', 'visible');
      return;
    }

    // Check cart and clear if no subscription items
    fetch('/cart.js')
      .then(res => res.json())
      .then(cart => {
        const hasItems = cart.items.length > 0;
        const hasSellingPlan = cart.items.some(item =>
          item.selling_plan_allocation && item.selling_plan_allocation.selling_plan
        );

        if (hasItems && !hasSellingPlan) {
          // Clear immediately before showing items
          fetch('/cart/clear.js', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' }
          })
          .then(() => window.location.reload())
          .catch(err => console.error('Error clearing cart:', err));
        } else {
          // Reveal cart items if valid
          document.querySelector('.wt-cart__items')?.style.setProperty('visibility', 'visible');
        }
      })
      .catch(err => {
        console.error('Error fetching cart:', err);
        document.querySelector('.wt-cart__items')?.style.setProperty('visibility', 'visible');
      });

    // Also listen for cart updates
    document.body.addEventListener('cart:updated', function() {
      // Repeat the same check on update
      fetch('/cart.js')
        .then(res => res.json())
        .then(cart => {
          const hasItems = cart.items.length > 0;
          const hasSellingPlan = cart.items.some(item =>
            item.selling_plan_allocation && item.selling_plan_allocation.selling_plan
          );
          if (hasItems && !hasSellingPlan) {
            fetch('/cart/clear.js', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' }
            })
            .then(() => window.location.reload())
            .catch(err => console.error('Error clearing cart:', err));
          } else {
            document.querySelector('.wt-cart__items')?.style.setProperty('visibility', 'visible');
          }
        })
        .catch(err => {
          console.error('Error fetching cart on update:', err);
          document.querySelector('.wt-cart__items')?.style.setProperty('visibility', 'visible');
        });
    });
  });
</script>
