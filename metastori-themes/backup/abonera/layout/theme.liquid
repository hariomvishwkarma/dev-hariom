<script>
  (function() {
  // Check interval (every 3 seconds)
  const CHECK_INTERVAL = 3000;
  const CART_URL = "https://abonerano.myshopify.com/cart.json";

  async function checkCart() {
    try {
      const response = await fetch(CART_URL, {
        method: "GET",
        headers: {
          "Content-Type": "application/json",
          "Accept": "application/json"
        },
        credentials: "same-origin"
      });

      if (!response.ok) {
        console.error("Failed to fetch cart:", response.status);
        return;
      }

      const cartData = await response.json();

      // Extract all bundle names from cart
      const bundleNames = cartData.items
        .map(item => item.properties && item.properties._bundleName)
        .filter(Boolean);

      const hasFamilieabonnement = bundleNames.includes("Familieabonnement");
      const hasVildu = bundleNames.includes("Vil du legge til produkter uten abonnement");

      // Logic enforcement
      if (hasVildu && !hasFamilieabonnement) {
        console.warn("Invalid bundle state detected. Clearing cart...");
        
        // Clear the cart
        await fetch("/cart/clear.js", {
          method: "POST",
          credentials: "same-origin"
        });

        // Refresh the page after clearing
        {% comment %} window.location.reload(); {% endcomment %}
      }
    } catch (error) {
      console.error("Error checking cart:", error);
    }
  }

  // Keep checking with interval
  setInterval(checkCart, CHECK_INTERVAL);
})();


</script>
