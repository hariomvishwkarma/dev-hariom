{%- liquid
  assign free_limit = limit
  assign custom_thresholds = custom_limits | newline_to_br | split: '<br />'

  capture iso_code
    assign iso = localization.country.iso_code
    case iso
      when 'IE'
        assign locale = 'eu'
      when 'GB'
        assign locale = 'uk'
      else
        assign locale = iso
    endcase
    echo locale | handleize
  endcapture

  assign iso_code = iso_code | upcase

  if custom_eu_limits and iso_code == 'EU'
    assign eu_custom_thresholds = custom_eu_limits | newline_to_br | split: '<br />'
  endif

  for threshold in custom_thresholds
    assign parts = threshold | split: ':'
    assign locale = parts[0] | strip
    assign value = parts[1] | strip | abs

    unless iso_code == locale
      continue
    endunless

    assign free_limit = value
  endfor

  echo free_limit
-%}
