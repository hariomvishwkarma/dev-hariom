{% doc %}
  @description Wishlist button

  @param {object} product
  @param {string} [classes]
  @param {string} [icon_classes]
  @param {boolean} [add_text]
  @param {boolean} [circle]

  @example
  {% render 'wishlist-button', product: product  %}
{% enddoc %}

{%- if product.handle != blank -%}
  <button
    type="button"
    aria-label="Add to wishlist"
    class="{{ classes }} flex {% if add_text %} flex-row gap-2 justify-end items-center {% endif %}{% if circle %} items-center justify-center h-9 w-9 rounded-full {% endif %}"
    button-wishlist
    data-product-handle="{{ product.handle }}"
    data-product-id="gid://shopify/Product/{{- product.id -}}"
  >
    {%- render 'c-icon', icon: 'heart', extra_classes: '!block', classes: icon_classes -%}
    {% if add_text == true -%}
      <span>{{ 'sections.cart.product_card.wishlist' | t }}</span>
    {%- endif %}
  </button>
{%- endif -%}
