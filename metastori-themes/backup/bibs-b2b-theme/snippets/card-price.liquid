{%- liquid
  assign list_price = product.metafields.custom.list_price
  assign msrp = product.metafields.custom.msrp
%}
{% comment %}customize BSS Commerce ltsp{% endcomment %}
{% capture check_ltsp %}
  {% assign bssltspp = product | default: item | default: prod %}{% capture bssltspop %}{% endcapture %}{% render 'bsscommerce-login-to-see-price', product: bssltspp, old_price: bssltspop %}
{% endcapture %}

<div class="price--card">
  {% if list_price != blank and list_price > product.price %}
    {% unless check_ltsp contains 'ltsp' %}
      <div class="price-row price-row--list-price light">
        <span class="label">
          {{- 'products.product.price.list_price' | t -}}
          :</span
        >
        <span class="price-value"
          ><s>{{ list_price | money }}</s></span
        >
      </div>
    {% else %}

    {% endunless %}
  {% endif %}
  {% unless check_ltsp contains 'ltsp' %}
    <div class="price-row price-row--your-price">
      <span class="label">
        {{- 'products.product.price.your_price' | t -}}
        :</span
      >
      <span class="price-value">{{ product.price | money }}</span>
    </div>
  {% else %}
    {{ check_ltsp }}
  {% endunless %}

  {% if show_msrp and msrp != blank and msrp > product.price %}
    <div class="price-row price-row--msrp">
      <span class="label">
        {{- 'products.product.price.msrp_price' | t -}}
        :</span
      >
      <span class="price-value">{{ msrp | money }}</span>
    </div>
  {% endif %}
</div>
