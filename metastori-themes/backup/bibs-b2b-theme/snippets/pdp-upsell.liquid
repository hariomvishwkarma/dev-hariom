<style>
  {%- if block.settings.position == "full_width" -%}
  .custom-meta-upsell-grid {
    display: grid;
    grid-template-columns: 1fr 1fr 1fr 1fr;
    gap: 15px;
  }
    {% else %}
  .custom-meta-upsell-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 15px;
    }
  {% endif %}
</style>
{% assign upsellproducts = product.metafields.custom.up_sell.value %}
{% if upsellproducts %}
  <h3 class="upsell-heading">
    {{ block.settings.upsellheading | default: upsellheading }}
  </h3>
  <div class="custom-meta-upsell-grid">
    {% for upsellproduct in upsellproducts %}
      <div class="custom-upsell-items">
        {% render 'card-product',
          card_product: upsellproduct,
          media_aspect_ratio: block.settings.image_ratio,
          image_shape: block.settings.image_shape,
          show_secondary_image: block.settings.show_secondary_image,
          show_vendor: block.settings.show_vendor,
          show_rating: block.settings.show_rating,
          lazy_load: lazy_load,
          skip_styles: skip_card_product_styles,
          quick_add: 'bulk',
          section_id: section.id
        %}
      </div>
    {% endfor %}
  </div>
{% endif %}
