<notify-sold-out
  class="notify-wrapper"
  id="notify-collection-variant"
  data-variant_id="{{ variant }}"
>
  <div data-auth-input class="relative flex">
    {% render 'c-input',
      input_type: 'email',
      id: 'notify-email',
      input_name: 'out-of-stock-email',
      input_autocomplete: 'email',
      label_content: 'E-mail',
      label_classes: 'form__label hidden',
      input_classes: 'items-center w-full hidden',
      input_required: true,
      extra_classes: 'flex-col-reverse',
      custom_attributes: 'disabled'
    %}
  </div>
  <div class="custom-checkbox-flex gap-2 pb-5 paragraph-3 hidden">
    <input type="checkbox" id="Subscribe-newsletter" name="newsletter" class="w-4 h-4 hidden" checked>
    <label for="Subscribe-newsletter" class="flex flex-row gap-4 items-center select-none cursor-pointer">
      <span class="custom-checkbox"></span>
      {{ 'newsletter.join' | t }}
    </label>
  </div>
  {% render 'c-button',
    type: 'button',
    translatable_content: 'notify.button_text',
    design: 'primary',
    classes: 'rounded-full bg-grey-300 text-foreground w-full button button-primary h-full notify-buttons',
    id: 'notify-button'
  %}
  <div class="hidden pt-3" id="notify__success">
    {% render 'c-text', translatable_content: 'notify.success' %}
  </div>
  <div class="hidden pt-3" id="notify__error">
    {% render 'c-text', translatable_content: 'notify.error' %}
  </div>
</notify-sold-out>
