{%- comment -%}
  Renders metaobject-based visual for a single facet value.
  Accepts: filter {Object}, value {Object}
{%- endcomment -%}

{%- liquid
  assign filter_value_value = value.value | replace: ' ', '-' | replace: '/', '-' | replace: '´', '-' | replace: '&#39;', '-' | replace: 'é', 'e' | downcase
-%}

{%- if filter.param_name contains 'color' or filter.param_name contains 'print_name' -%}
  <span
    class="filter-color-sample"
    style="background: var(--color_{{- filter_value_value -}}); background-size: 20px; border: 1px solid var(--border_{{- filter_value_value -}})"
  ></span>
{%- endif -%}

{%- if filter.param_name contains 'nipple type' -%}
  {%- for nipple in shop.metaobjects.nipple_type_icons.values -%}
    {%- assign lowercase_nipple_name = nipple.name | downcase -%}
    {%- assign lowercase_nipple_filter_value = value.value | downcase -%}
    {%- if lowercase_nipple_name == lowercase_nipple_filter_value -%}
      <span class="facet-meta-icon">{{ nipple.icon }}</span>
      {%- break -%}
    {%- endif -%}
  {%- endfor -%}
{%- endif -%}

{%- if filter.param_name contains 'flow type' -%}
  {%- for flow in shop.metaobjects.filter_flow_type_icons.values -%}
    {%- assign lowercase_flow_name = flow.name | downcase -%}
    {%- assign lowercase_flow_filter_value = value.value | downcase -%}
    {%- if lowercase_flow_name == lowercase_flow_filter_value -%}
      <span class="facet-meta-icon">{{ flow.icon }}</span>
      {%- break -%}
    {%- endif -%}
  {%- endfor -%}
{%- endif -%}