{%- comment -%}
  Renders a title component

  Accepts:
    - id { String }: The id of the title component to render
    - content { String }: The title to render
    - translatable_content { String }: If you need to pass in a string that refers to a translation
    - custom_tag { String }: custom tag of the title component to render (default: 'h1')
    - classes { String }: Additional classes to add to the component
    - type { String }: Type of the title component to render
      (Values: h1, h2, h3, h4, h5, h6, h6-bold, h6-regular, h7-bold, h7-medium, h8-bold, h8-medium)
      NOTE: if no type is provided, it will be the tag's design
    - count {Number}: count of products

  Usage:
    {% render 'c-title', custom_tag: 'h1', content: "Hello World" %}
{%- endcomment -%}

{%- liquid
  assign custom_tag = custom_tag | default: 'h1'
  if translatable_content
    assign content = translatable_content | t
  endif
-%}

{%- if content != blank -%}
  <{{ custom_tag }}
    {% if id %}
      id="{{ id }}"
    {% endif %}
    class="{% if classes %}{{ classes }} {% endif %}{% if type %}{{ type }}{% endif %}"
  >
    {{- content -}}
    {%- if count and count > 0 -%}
      <span class="text-sm md:text-base leading-none text-accent ml-1">{{- count -}}</span>
    {%- endif -%}
  </{{ custom_tag }}>
{%- endif -%}
