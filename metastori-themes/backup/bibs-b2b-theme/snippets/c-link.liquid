{% comment %}
  Renders a anchor link

  Accepts:
    - id {String}: The id of the link
    - href {String}: the url to link to
    - hreflang {String}: the language of the linked document
    - rel {String}: the relationship of the linked document
    - content {String}: the content to display in the link
    - translatable_content {String}: the translatable content
    - title {String}: the title of the link
    - target {String}: the target of the link (Values: _blank, _self, _parent, _top)
    - custom_attributes {String}: Any custom attributes to add to the button,
    - type {String}: the type of links (Values: link, link--hover)
    - classes {String}: classes for pagination elements
    - style {String}: style

  Usage:
    {% render 'c-link', href: url %}
{% endcomment %}

<a
  {% if id %}
    id="{{ id }}"
  {% endif %}
  class="{{ type }} {{ classes }}"
  {% if href %}
    href="{{href}}"
  {% endif %}
  {% if hreflang %}
    hreflang="{{hreflang}}"
  {% endif %}
  {% if rel %}
    rel="{{rel}}"
  {% endif %}
  {% if target %}
    target="{{target}}"
  {% endif %}
  {% if title %}
    title="{{title}}"
  {% endif %}
  {{ custom_attributes }}
  {% if style %}
    style="{{style}}"
  {% endif %}
>
  {%- if translatable_content -%}
    {{- translatable_content | t -}}
  {%- elsif content -%}
    {{- content -}}
  {%- endif -%}
</a>
