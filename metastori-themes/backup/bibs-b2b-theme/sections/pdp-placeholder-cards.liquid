{{ 'component-price.css' | asset_url | stylesheet_tag }}
{{ 'quick-add.css' | asset_url | stylesheet_tag }}
{{ 'quick-order-list.css' | asset_url | stylesheet_tag }}
<script src="{{ 'quick-add-bulk.js' | asset_url }}" defer="defer"></script>
<script src="{{ 'quantity-popover.js' | asset_url }}" defer="defer"></script>
<script src="{{ 'price-per-item.js' | asset_url }}" defer="defer"></script>
<script src="{{ 'quick-order-list.js' | asset_url }}" defer="defer"></script>

{%- liquid
  assign slot_products = section.settings.product_list
-%}

{%- style -%}
  .pdp-placeholder-cards {
    display: flex;
    gap: 1.2rem;
    margin-top: 1.6rem;
    width: 100%;
  }

  .pdp-placeholder-cards__slot {
    flex: 1 1 0;
    width: 50%;
    min-width: 0;
  }

  .pdp-placeholder-cards__image {
    display: block;
    width: 100%;
    height: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    border-radius: 8px;
  }

  .pdp-placeholder-card {
    display: flex;
    align-items: center;
    gap: 1rem;
    height: 100%;
    min-height: 16rem;
    padding: 1rem;
    border: 1px solid #a6a6a6;
    border-radius: 8px;
    background: #fff;
  }

  .pdp-placeholder-card__media {
    flex: 0 0 30%;
    width: 30%;
    display: block;
    align-self: stretch;
  }

  .pdp-placeholder-card__media img,
  .pdp-placeholder-card__media svg {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .pdp-placeholder-card__info {
    flex: 1 1 auto;
    min-width: 0;
    display: flex;
    flex-direction: column;
    justify-content: flex-start;
    gap: 0.6rem;
  }

  .pdp-placeholder-card__bottom {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.6rem;
    min-width: 0;
  }

  .pdp-placeholder-card__title {
    margin: 0;
    font-size: 1.2rem;
    font-weight: 500;
    line-height: 1.3;
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 3;
    overflow: hidden;
  }

  .pdp-placeholder-card__title a {
    color: #121212;
    text-decoration: none;
  }

  .pdp-placeholder-card__title a:hover {
    text-decoration: underline;
  }

  .pdp-placeholder-card__price {
    width: 100%;
    min-width: 0;
  }

  .pdp-placeholder-card__price .price__container--price-rows {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.15rem;
  }

  .pdp-placeholder-card__price .price-row {
    display: flex;
    flex-direction: row;
    align-items: baseline;
    gap: 0.35rem;
    font-size: 1.2rem;
    line-height: 1.3;
  }

  .pdp-placeholder-card__price .price-row .label,
  .pdp-placeholder-card__price .price-row .price-value {
    font-size: inherit;
  }

  .pdp-placeholder-card__price .price-row--list-price {
    color: #818181;
  }

  .pdp-placeholder-card__price .price-row--your-price .price-value {
    font-weight: 600;
    color: #121212;
  }

  .pdp-placeholder-card__price .price-row--msrp {
    color: #818181;
  }

  .pdp-placeholder-card__action {
    flex-shrink: 0;
    display: flex;
    align-items: center;
  }

  .pdp-placeholder-card__action .quantity {
    width: auto;
    min-height: 32px;
    height: 32px;
  }

  .pdp-placeholder-card__action .quantity__input {
    width: 3.6rem;
    font-size: 1.2rem;
  }

  .pdp-placeholder-card__action .quantity__button {
    width: 2.4rem;
  }

  .pdp-placeholder-card__choose.button {
    min-width: auto;
    min-height: 32px;
    height: auto;
    padding: 0.6rem 1.2rem;
    font-size: 1.2rem;
    line-height: 1.2;
    white-space: nowrap;
  }

  .pdp-placeholder-card__login {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 32px;
    height: 32px;
    padding: 0 1.2rem;
    font-size: 1.2rem;
    font-weight: 500;
    background-color: #121212;
    color: #ffffff;
    border-radius: var(--buttons-radius-outset);
    text-decoration: none;
    white-space: nowrap;
  }

  .pdp-placeholder-cards-section .quick-add-modal__content-info--bulk {
    width: 100%;
    max-width: 72rem;
    padding: 0;
  }

  .pdp-placeholder-card__sold-out {
    font-size: 1.2rem;
    color: #8b8b8b;
    white-space: nowrap;
  }

  @media screen and (max-width: 989px) {
    .pdp-placeholder-cards {
      gap: 0.8rem;
      flex-wrap: wrap;
    }

    .pdp-placeholder-cards__slot--product {
      flex: 0 0 100%;
      width: 100%;
    }

    .pdp-placeholder-card {
      min-height: auto;
    }
  }
{%- endstyle -%}

<div
  id="PdpPlaceholderCards-{{ section.id }}"
  class="pdp-placeholder-cards"
  data-pdp-placeholder-cards="{{ section.id }}"
>
  {%- assign slots_filled = 0 -%}

  {%- for slot_product in slot_products -%}
    {%- liquid
      assign slots_filled = slots_filled | plus: 1
      assign card_variant = slot_product.selected_or_first_available_variant
      assign card_image = card_variant.featured_image | default: slot_product.featured_image
    -%}
    {%- capture check_ltsp -%}
      {%- assign bssltspp = slot_product -%}
      {%- capture bssltspop -%}{%- endcapture -%}
      {%- render 'bsscommerce-login-to-see-price', product: bssltspp, old_price: bssltspop -%}
    {%- endcapture -%}
    <div class="pdp-placeholder-cards__slot pdp-placeholder-cards__slot--product">
      <article class="pdp-placeholder-card">
        <a href="{{ slot_product.url }}" class="pdp-placeholder-card__media">
          {%- if card_image -%}
            {{
              card_image
              | image_url: width: 300
              | image_tag: width: 300, height: 300, alt: card_image.alt, loading: 'lazy'
            }}
          {%- else -%}
            {{ 'product-apparel-1' | placeholder_svg_tag }}
          {%- endif -%}
        </a>
        <div class="pdp-placeholder-card__info">
          <h3 class="pdp-placeholder-card__title">
            <a href="{{ slot_product.url }}">{{ slot_product.title | escape }}</a>
          </h3>
          <div class="pdp-placeholder-card__bottom">
            <div class="pdp-placeholder-card__price">
              {% render 'price', product: slot_product, price_class: '', show_compare_at_price: true %}
            </div>
            <div class="pdp-placeholder-card__action">
              {%- if check_ltsp contains 'ltsp' -%}
                <a
                  href="{{ routes.account_login_url }}?return_url={{ request.path | url_encode }}"
                  class="pdp-placeholder-card__login"
                >
                  {{ 'products.product.price.login_for_price' | t | default: 'Login to add' }}
                </a>
              {%- elsif slot_product.variants.size == 1 -%}
                {%- if card_variant.available -%}
                  <quick-add-bulk
                    data-min="{{ card_variant.quantity_rule.min }}"
                    id="quick-add-bulk-{{ card_variant.id }}-{{ section.id }}"
                    class="quick-add-bulk"
                    data-index="{{ card_variant.id }}"
                  >
                    {% render 'quantity-input', variant: card_variant, min: 0, product: slot_product %}
                  </quick-add-bulk>
                {%- else -%}
                  <span class="pdp-placeholder-card__sold-out">{{ 'products.product.sold_out' | t }}</span>
                {%- endif -%}
              {%- else -%}
                <modal-opener
                  id="QuickBulk-{{ slot_product.id }}-{{ section.id }}"
                  data-modal="#QuickAddBulk-{{ slot_product.id }}-{{ section.id }}"
                >
                  <button
                    id="QuickAddOpener-{{ slot_product.id }}-{{ section.id }}"
                    type="button"
                    class="pdp-placeholder-card__choose button button-primary"
                    aria-haspopup="dialog"
                    aria-label="{{ 'products.product.choose_product_options' | t: product_name: slot_product.title | escape }}"
                  >
                    {{ 'products.product.choose_options' | t }}
                  </button>
                </modal-opener>
                <modal-dialog
                  id="QuickAddBulk-{{ slot_product.id }}-{{ section.id }}"
                  class="quick-add-modal color-{{ section.settings.color_scheme }}"
                >
                  <div
                    role="dialog"
                    aria-label="{{ 'products.product.choose_product_options' | t: product_name: slot_product.title | escape }}"
                    aria-modal="true"
                    class="quick-add-modal__content quick-add-modal__content--bulk global-settings-popup"
                    tabindex="-1"
                  >
                    <button
                      id="ModalClose-{{ slot_product.id }}-{{ section.id }}"
                      type="button"
                      class="quick-add-modal__toggle"
                      aria-label="{{ 'accessibility.close' | t }}"
                    >
                      {{- 'icon-close.svg' | inline_asset_content -}}
                    </button>
                    <div class="quick-add-modal__content-info quick-add-modal__content-info--bulk">
                      <bulk-modal
                        id="QuickBulkModal-{{ slot_product.id }}-{{ section.id }}"
                        data-url="{{ slot_product.url }}"
                        data-section-id="{{ section.id }}"
                        data-product-id="{{ slot_product.id }}"
                      ></bulk-modal>
                    </div>
                  </div>
                </modal-dialog>
              {%- endif -%}
            </div>
          </div>
        </div>
      </article>
    </div>
  {%- endfor -%}

  {%- if slots_filled < 2 and section.settings.image_1 != blank -%}
    {%- assign slots_filled = slots_filled | plus: 1 -%}
    <div class="pdp-placeholder-cards__slot">
      {{
        section.settings.image_1
        | image_url: width: 800
        | image_tag:
          widths: '400, 600, 800',
          alt: section.settings.image_1.alt,
          loading: 'lazy',
          class: 'pdp-placeholder-cards__image'
      }}
    </div>
  {%- endif -%}

  {%- if slots_filled < 2 and section.settings.image_2 != blank -%}
    <div class="pdp-placeholder-cards__slot">
      {{
        section.settings.image_2
        | image_url: width: 800
        | image_tag:
          widths: '400, 600, 800',
          alt: section.settings.image_2.alt,
          loading: 'lazy',
          class: 'pdp-placeholder-cards__image'
      }}
    </div>
  {%- endif -%}
</div>

<script>
  (() => {
    const el = document.getElementById('PdpPlaceholderCards-{{ section.id }}');
    if (!el) return;

    const move = () => {
      const target = document.querySelector('.product__info-container');
      if (!target) return;
      target.querySelectorAll('[data-pdp-placeholder-cards="{{ section.id }}"]').forEach((old) => {
        if (old !== el) old.remove();
      });
      if (!target.contains(el)) target.appendChild(el);
    };

    if (document.querySelector('.product__info-container')) {
      move();
    } else {
      document.addEventListener('DOMContentLoaded', move);
    }

    if (window.Shopify && window.Shopify.designMode) {
      document.addEventListener('shopify:section:load', () => setTimeout(move, 0));
    }
  })();
</script>

{% schema %}
{
  "name": "PDP placeholder cards",
  "tag": "section",
  "class": "pdp-placeholder-cards-section",
  "enabled_on": {
    "templates": ["product"]
  },
  "settings": [
    {
      "type": "paragraph",
      "content": "Connect each setting to the product metafield (PDP placeholder section data) using dynamic sources. Selected products fill the slots first; images fill any remaining slots."
    },
    {
      "type": "image_picker",
      "id": "image_1",
      "label": "Image 1"
    },
    {
      "type": "image_picker",
      "id": "image_2",
      "label": "Image 2"
    },
    {
      "type": "product_list",
      "id": "product_list",
      "label": "Product list",
      "limit": 2
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Popup color scheme",
      "default": "scheme-1"
    }
  ],
  "presets": [
    {
      "name": "PDP placeholder cards"
    }
  ]
}
{% endschema %}
