{
  "name": "svens-bibs-b2b-theme",
  "version": "1.0.0",
  "description": "New BIBS B2B Theme",
  "main": "index.js",
  "scripts": {
    "watch": "vite build --watch",
    "build": "vite build --minify",
    "dev": "shopify theme dev --store=bibs-b2b.myshopify.com",
    "dev:dk": "shopify theme dev --store=bibs-b2b-dk.myshopify.com",
    "dev:us": "shopify theme dev --store=bibs-b2b-us.myshopify.com",
    "dev:uk": "shopify theme dev --store=bibs-b2b-uk.myshopify.com",
    "dev:latest": "shopify theme pull --live --only=*/*.json --ignore=locales/*.json --store=bibs-b2b.myshopify.com && shopify theme metafields pull --store=bibs-b2b.myshopify.com && shopify theme dev --store=bibs-b2b.myshopify.com"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/svennif/svens-bibs-b2b-theme.git"
  },
  "author": "Sven Ingar Frantzen",
  "license": "ISC",
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.6",
    "sass-embedded": "^1.89.0",
    "tailwindcss": "^4.1.6",
    "vite": "^6.3.5"
  }
}
