    "rich_text_GXtBm4": {
      "type": "rich-text",
      "blocks": {
        "heading_xqGw3d": {
          "type": "heading",
          "settings": {
            "title": "THE ART OF MODERN ROMANCE",
            "use_h1": false
          }
        },
        "text_pCJEHa": {
          "type": "text",
          "settings": {
            "text": "<p>At WILLIAM ÉDOUARD, our focus is on considered design and enduring craftsmanship. <br/><br/>Our consultations offer an opportunity to sit down with Creative Director, William Drury, and explore ideas, ask questions, and shape a design that feels entirely your own, without expectation.<br/><br/>From modern silhouettes to reimagined classics, each WILLIAM ÉDOUARD ring is personally crafted by William, and carefully refined to reflect your story. The process is collaborative, thoughtful, and centred on creating something meaningful, shaped by care and artistry at every stage.</p>",
            "enlarge_text": false
          }
        }
      },
      "block_order": [
        "heading_xqGw3d",
        "text_pCJEHa"
      ],
      "name": "Rich text",
