    "image_with_text_8NPExB": {
      "type": "image-with-text",
      "blocks": {
        "heading_R7tyMC": {
          "type": "heading",
          "settings": {
            "title": "ENGAGEMENT RING COLLECTION",
            "use_h1": false
          }
        },
        "text_jxQVXN": {
          "type": "text",
          "settings": {
            "text": "<p>Discover our curated Engagement Ring Collection, thoughtfully crafted to showcase timeless design and enduring quality. <br/><br/>Our collection offers a range of settings, silhouettes, and stone shapes to choose from, all of which are available to view and try on in person to explore how different silhouettes and proportions feel on the hand.<br/><br/>Whether you’re seeking a classic solitaire, a modern interpretation of a timeless style, or something with a distinctive detail—our collection allows you to find the perfect ring with confidence, assured of the highest standards of craftsmanship.<br/><br/><br/><a href=\"https://williamedouard.com/collections/engagement-rings\" title=\"https://williamedouard.com/collections/engagement-rings\"><strong>SHOP ENGAGEMENT RINGS<br/></strong></a><strong><br/></strong><a href=\"https://williamedouard.com/collections/weddings-bands\" title=\"https://williamedouard.com/collections/weddings-bands\"><strong>SHOP WEDDING BANDS</strong></a></p>",
            "enlarge_text": false
          }
        }
      },
      "block_order": [
        "heading_R7tyMC",
        "text_jxQVXN"
      ],
      "name": "Image with text",
      "settings": {
        "image": "shopify://shop_images/AdobeStock_211241746_ffe06126-d01a-4c11-8262-c98320435989.jpg",
