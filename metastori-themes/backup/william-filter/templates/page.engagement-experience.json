    "image_with_text_qEEw6M": {
      "type": "image-with-text",
      "blocks": {
        "heading_dVhjhN": {
          "type": "heading",
          "settings": {
            "title": "OUR MELBOURNE BOUTIQUE",
            "use_h1": false
          }
        },
        "text_KK6NqF": {
          "type": "text",
          "settings": {
            "text": "<p>Begin your journey at our Melbourne boutique.<br/><br/>No two stories are the same, and your appointment is designed to reflect that. Whether you arrive with a clear idea or are simply beginning to explore, the consultation is a relaxed, no-pressure space to talk through possibilities. You can choose to meet in person at our Melbourne boutique or connect through a virtual appointment from anywhere.<br/><br/>During your appointment, you’ll work directly with Creative Director, William Drury. Together, you’ll explore different settings and band profiles, along with a selection of precious metals, ethically sourced diamonds, and coloured gemstones. <br/><br/>You’ll also gain insight into the making of your ring—from design development and crafting timelines to long-term care, complimentary resizing and our lifetime cleaning offering.<br/><br/><br/>Our Melbourne boutique is located at 9 King Street, Prahran VIC 3181<br/><br/><a href=\"https://williamedouard.com/pages/appointments\" title=\"https://williamedouard.com/pages/appointments\"><strong>BOOK AN APPOINTMENT</strong></a></p>",
            "enlarge_text": false
          }
        },
