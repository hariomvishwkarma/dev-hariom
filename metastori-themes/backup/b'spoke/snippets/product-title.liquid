{%- liquid
  assign fontsize_text = block.settings.fontsize_text
  assign fontsize_text_mb = block.settings.fontsize_text_mb
  assign color_title = block.settings.color_title
-%}

<!--
  <div  class="productss_taggs">
  {% if product.tags contains 'Indigestion' %}
  <span style="background: #EAF8F2;">Indigestion</span>
  {% endif %}
  {% if product.tags contains 'Bowel movement' %}
  <span style="background: #FBF8D8;">Bowel movement</span>
  {% endif %}
  </div>
-->
<div class="productss_taggs">
    {% assign tag_colors = settings.tag_color_1 | append: ',' | append: settings.tag_color_2 %}
    {% assign tag_colors = tag_colors | split: ',' %}

    {% for tag in product.metafields.custom.product_tags.value %}
        {% assign color_index = forloop.index0 | modulo: 2 %}
        <span class="product-tags" style="background: {{ tag_colors[color_index] }};">{{ tag }}</span>
    {% endfor %}
</div>



{%- if check_show_share == '3' -%}
  <div class="halo-share-3">
    <h1
      class="productView-title"
      style="--color-title: {{ color_title }};--fontsize-text: {{ fontsize_text | append: 'px' }};--fontsize-mb-text: {{ fontsize_text_mb | append: 'px' }};"
    >
      <span>{{ product.title | escape }}</span>
    </h1>
    {% render 'halo-share', product: product, share_layout: check_show_share %}
  </div>
{%- else -%}
  <h1
    class="productView-title"
    style="--color-title: {{ color_title }};--fontsize-text: {{ fontsize_text | append: 'px' }};--fontsize-mb-text: {{ fontsize_text_mb | append: 'px' }};"
  >
    {% if product.title contains '-' %}
      {% assign split_title = product.title | split: '-' %}
      <span>{{ split_title[0] }}</span>
      <span class="text_detail"> - {{ split_title[1] }}</span>
    {% else %}
      <span>{{ product.title | escape }}</span>
    {% endif %}
  </h1>
{%- endif -%}
