    {% render 'kwikpass' %}

                  <div id="sy-whatshelp">
        <a href="https://api.whatsapp.com/send?phone=918569990151&text=Hi" target="_blank" class="sywh-open-services " data-html="true" data-placement="left">
          <i class="fab fa-whatsapp"></i>
         </a>        
</div>

</body>
</html>
