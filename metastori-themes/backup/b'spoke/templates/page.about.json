    "rich_text_HanNCD": {
      "type": "rich-text",
      "blocks": {
        "heading_KDmVW6": {
          "type": "heading",
          "settings": {
            "heading": "Founded With a Mission",
            "heading_size": 30,
            "heading_size_mb": 30,
            "heading_line_height": 1,
            "heading_color": "#000000"
          }
        },
        "text_9ikepW": {
          "type": "text",
          "settings": {
            "text": "<p>\nB’spoke was created to solve India’s growing lifestyle health challenges through clean, effective, and science-backed nutrition.\n</p>\n\n<p><strong>Founders</strong></p>\n\n<p>\n<strong>Sid Das</strong><br>\nSid Das is one of India’s foremost deep-tech entrepreneurs, architecting scalable innovations across energy, AI, and health. He was associated with one of the Big 4 consulting firms, where he honed his expertise in strategy, scale, and technology-driven transformations. He later designed and led the development of India’s largest electric truck, earning him the title of the “Electric Man of India.” Sid also has deep expertise in conceptualizing and designing foundational models in Artificial Intelligence.\n</p>\n\n<p>\n<strong>Subodh Yadav</strong><br>\nSubodh Yadav is a deep-tech entrepreneur and co-promoter of eGenome.ai, IPLTech Electric, and Infraprime Logistics. An IIT Roorkee and IIM Lucknow alumnus, he blends engineering, strategy, and innovation—building large-scale systems ranging from electric heavy-duty trucks to advanced AI for precision health. A technocrat at heart, he creates solutions ahead of their time. Through eGenome.ai and B’spoke Wellness, Sid and Subodh are driving a bold vision where biomarkers and artificial intelligence come together to revolutionize preventive healthcare for millions.\n</p>\n\n<p><strong>Company Information</strong></p>\n\n<p>\n<strong>Founded:</strong> 2024<br>\n<strong>Headquarters:</strong> Gurgaon, India<br>\n<strong>Manufacturing:</strong> US FDA–registered, GMP-certified facility\n</p>",
            "text_size": 16,
            "text_line_height": 1,
            "margin_top_text": 20,
            "text_color": "#000000",
            "text_width": "800px"
          }
        }
      },
      "block_order": [
        "heading_KDmVW6",
        "text_9ikepW"
      ],
