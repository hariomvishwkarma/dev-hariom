    "rich_text_XPnraV": {
      "type": "rich-text",
      "blocks": {
        "heading_yNJKR4": {
          "type": "heading",
          "settings": {
            "heading": "What B'spoke Offers",
            "heading_size": 30,
            "heading_size_mb": 30,
            "heading_line_height": 1,
            "heading_color": "#000000"
          }
        },
        "text_xdyRPQ": {
          "type": "text",
          "settings": {
            "text": "<p style=\"text-align:justify\"><strong>Functional Foods</strong><br>\nDeveloped for real-life daily health needs — energy, digestion, glucose balance, gut support.</p>\n\n<br>\n\n<p style=\"text-align:justify\"><strong>Clean-Label Biscuits (No Spike Cookies)</strong><br>\nHigh-fiber, gluten-free, prebiotic cookies with no sugar additives, no palm oil, and no preservatives.<br>\n</p>\n\n<br>\n\n<p style=\"text-align:justify\"><strong>Prebiotic Fiber Products (FOS, Inulin)</strong><br>\nSupports digestion, gut microbiome health, and reduces glucose spikes after meals.</p>\n\n<br>\n\n<p style=\"text-align:justify\"><strong>Premium Nutraceutical Supplements</strong><br>\nClinically researched ingredients designed for bioavailability and efficacy:</p>\n\n<p style=\"text-align:justify\">\nOmega-3 (Vegan Algal EPA/DHA)<br>\nAnti-Aging (CoQ10 Ubiquinol + Resveratrol)<br>\nAnti-Pigmentation (Glutathione, L-Cysteine, Ginseng)<br>\nAnti-Spike Blood Sugar Control (Berberine)<br>\nLiver Detox Formulas<br>\nProbiotic + Prebiotic Blend\n</p>",
            "text_size": 16,
            "text_line_height": 1,
            "margin_top_text": 20,
            "text_color": "#000000",
            "text_width": "800px"
          }
        }
      },
