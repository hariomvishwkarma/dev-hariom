    "rich_text_MCkeyC": {
      "type": "rich-text",
      "blocks": {
        "heading_dETKJX": {
          "type": "heading",
          "settings": {
            "heading": "About B’spoke Foods & Supplements",
            "heading_size": 30,
            "heading_size_mb": 30,
            "heading_line_height": 1,
            "heading_color": "#000000"
          }
        },
        "text_fh8Lka": {
          "type": "text",
          "settings": {
            "text": "<p>B’spoke is an India-based wellness brand specializing in clean-label functional foods and clinically formulated nutraceutical supplements. Designed for modern Indian lifestyles, B'spoke products are built on precision science, high-quality ingredients, and clean manufacturing standards.\n</p>We blend nature + clinical research to create products that support metabolic health, gut health, skin health, and long-term wellness.",
            "text_size": 16,
            "text_line_height": 1,
            "margin_top_text": 20,
            "text_color": "#000000",
            "text_width": "800px"
          }
        }
      },
