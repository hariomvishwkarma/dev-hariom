        "text_mT8axR": {
          "type": "text",
          "settings": {
            "text": "<p style=\"text-align:justify\">B'spoke was born from a shared vision of a group of passionate health enthusiasts, scientists, engineers, and doctors: to cure the world. United by a commitment to revolutionize wellness, we set out on a mission to create high-quality, research-backed nutritional solutions that empower people to live their best lives.\n<br>\n<br>\nFrom the very beginning, we’ve been committed to upholding the highest standards of quality and efficacy. At B'spoke, we believe in the transformative synergy between science and nature. Our team meticulously researches and sources the finest natural ingredients, ensuring every product is safe, effective, and delivers tangible benefits.</p>\n<br>\n<p></p>",
            "text_size": 15,
            "text_line_height": 1,
            "margin_top_text": 20,
            "text_color": "#000000",
            "text_width": "680px"
          }
        }
