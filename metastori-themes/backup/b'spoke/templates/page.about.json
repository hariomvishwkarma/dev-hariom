    "rich_text_8NrqDD": {
      "type": "rich-text",
      "blocks": {
        "heading_QyyBtb": {
          "type": "heading",
          "settings": {
            "heading": "B’spoke’s Science & Quality Commitment",
            "heading_size": 30,
            "heading_size_mb": 30,
            "heading_line_height": 1,
            "heading_color": "#000000"
          }
        },
        "text_kNmqzB": {
          "type": "text",
          "settings": {
            "text": "<p>\nWe follow strict quality standards to ensure purity, potency, and safety:\n</p>\n\n<p>\nUS FDA–registered facility<br>\nGMP-certified manufacturing<br>\nHeavy metal, allergen & microbial testing<br>\nNo GMO, no sugar, no preservatives<br>\nClinically supported doses<br>\nClean-label philosophy<br>\nDesigned for Indian nutritional needs\n</p>",
            "text_size": 16,
            "text_line_height": 1,
            "margin_top_text": 20,
