{% comment %} sections/blog-grid-auto-with-title-search.liquid {% endcomment %}
<section class="section-{{ section.id }}-padding" id="blog-grid">
  <div class="container">
    <div class="heading_with_search">
      {% if section.settings.heading != blank %}
      <h2 class="blog-grid__heading">{{ section.settings.heading }}{% render 'breadcrumb' %}</h2>
      {% endif %}

      <div class="blog-grid__search">
        <input
          id="blog-search-{{ section.id }}"
          type="search"
          class="blog-grid__search-input"
          placeholder="{{ section.settings.search_placeholder }}"
          aria-label="{{ section.settings.search_placeholder }}"
        >
      </div>
    </div>

    {% if blog != blank %}
      {% paginate blog.articles by 500 %}
        <div class="blog-grid" id="blog-grid-list-{{ section.id }}">
          {% for article in blog.articles %}

            {%- assign excerpt_plain = article.excerpt_or_content | strip_html -%}
            <article
              class="blog-card"
              data-title="{{ article.title | downcase | escape }}"
              data-excerpt="{{ excerpt_plain | downcase | escape }}"
            >
              <a class="blog-card__image-link" href="{{ article.url }}">
                {% if article.image %}
                  <img
                    class="blog-card__image"
                    src="{{ article.image | image_url: width: 800 }}"
                    alt="{{ article.image.alt | default: article.title | escape }}"
                    loading="lazy"
                  >
                {% else %}
                  <img
                    class="pra-card__image"
                    src="https://cdn.shopify.com/s/files/1/0688/2403/9576/files/placeholder.avif?v=1758187107"
                    alt="placeholder"
                    loading="lazy"
                    height="auto"
                    width="auto"
                  >
                {% endif %}
              </a>

              <div class="blog-card__content">
                {% if section.settings.show_date or section.settings.show_author %}
                  <div class="blog-card__meta">
                    {% if section.settings.show_date %}
                      <span class="blog-card__date">{{ article.published_at | date: "%d %b %Y" }}</span>
                    {% endif %}
                    {% if section.settings.show_author and article.author %}
                      <span class="blog-card__dot">•</span>
                      <span class="blog-card__author">{{ article.author }}</span>
                    {% endif %}
                  </div>
                {% endif %}

                <h3 class="blog-card__title">
                  <a href="{{ article.url }}"
                     class="blog-card__title-link"
                     data-original-title="{{ article.title | escape }}">{{ article.title }}</a>
                </h3>

                {% if article.metafields.custom.read_tiime_in_min.value != blank %}
                  <div class="blog-card__readtime">Estimated reading time - {{ article.metafields.custom.read_tiime_in_min.value }}</div>
                {% endif %}

                {%- assign excerpt_shown = excerpt_plain | truncatewords: section.settings.excerpt_words -%}
                <p class="blog-card__excerpt"
                   data-original-excerpt="{{ excerpt_shown | escape }}">
                  {{ excerpt_shown }}
                </p>

                {% if section.settings.read_more_text != blank %}
                  <a class="blog-card__readmore" href="{{ article.url }}">{{ section.settings.read_more_text }}</a>
                {% endif %}
              </div>
            </article>
          {% endfor %}
        </div>

        {% if paginate.pages > 1 %}
          <nav class="blog-grid__pagination" role="navigation" aria-label="Pagination">
            {% if paginate.previous %}
              <a class="blog-grid__page-link blog-grid__page-link--prev" href="{{ paginate.previous.url }}">&larr; Previous</a>
            {% endif %}
            <span class="blog-grid__page-count">{{ paginate.current_page }} / {{ paginate.pages }}</span>
            {% if paginate.next %}
              <a class="blog-grid__page-link blog-grid__page-link--next" href="{{ paginate.next.url }}">Next &rarr;</a>
            {% endif %}
          </nav>
        {% endif %}
      {% endpaginate %}
    {% else %}
      <p class="blog-grid__empty">This section only shows posts on a blog template.</p>
    {% endif %}
  </div>
</section>

<style>
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.pad_top }}px;
    padding-bottom: {{ section.settings.pad_bottom }}px;
  }
  @media (max-width: 989px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.pad_top | divided_by: 2 }}px;
      padding-bottom: {{ section.settings.pad_bottom | divided_by: 2 }}px;
    }
  }

  #blog-grid .blog-grid__heading { margin: 0 0 24px; font-size: 32px; line-height: 1.2; }
  #blog-grid .blog-grid__search { margin-bottom: 0; min-width: 20%; }
  #blog-grid .blog-grid__search-input { width: 100%; max-width: 640px; height: 44px; padding: 0 14px; border: 1px solid rgba(0,0,0,.15); border-radius: 8px; }

  #blog-grid .blog-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 24px; }
  #blog-grid .blog-grid__heading .breadcrumb { padding-top: 10px; }

  .heading_with_search { display: flex; justify-content: space-between; flex-wrap: wrap; }

  @media (max-width: 989px) { #blog-grid .blog-grid { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 575px) { #blog-grid .blog-grid { grid-template-columns: 1fr; } }

  #blog-grid .blog-card { display: flex; flex-direction: column; background: #fff; border: 1px solid rgba(0,0,0,.06); border-radius: 12px; overflow: hidden; }
  #blog-grid .blog-card__image { width: 100%; aspect-ratio: 4/4; object-fit: cover; display: block; }
  #blog-grid .blog-card__content { padding: 16px; display: flex; flex-direction: column; gap: 8px; }
  #blog-grid .blog-card__meta { color: rgba(0,0,0,.6); font-size: 12px; display: flex; align-items: center; gap: 6px; }
  #blog-grid .blog-card__title { font-size: 18px; line-height: 1.3; margin: 0; }
  #blog-grid .blog-card__title-link mark { background: transparent; border-bottom: 2px solid currentColor; }
  #blog-grid .blog-card__readtime { font-size: 12px; color: rgba(0,0,0,.7); }
  #blog-grid .blog-card__excerpt { margin: 0; color: rgba(0,0,0,.8); }
  #blog-grid .blog-card__excerpt mark { background: transparent; border-bottom: 1px solid currentColor; }
  #blog-grid .blog-card__readmore { margin-top: 6px; text-decoration: underline; font-weight: 500; }
  #blog-grid .blog-grid__pagination { display: flex; align-items: center; gap: 12px; justify-content: center; margin-top: 28px; }
  #blog-grid .blog-grid__page-link { text-decoration: none; }
  #blog-grid .blog-grid__page-count { font-size: 14px; opacity: .75; }

  @media (max-width: 599px){
    .heading_with_search { margin-bottom: 30px; flex-direction: column; }
    #blog-grid .blog-grid__heading { margin: 0 0 6px; font-size: 30px; line-height: 1.2; }
  }
</style>

<script>
  (function(){
    var input = document.getElementById('blog-search-{{ section.id }}');
    var list  = document.getElementById('blog-grid-list-{{ section.id }}');
    if(!input || !list) return;

    function normalize(s){ return (s||'').toLowerCase().trim(); }

    function highlight(el, q, dataAttr){
      if(!el) return;
      var raw = el.getAttribute(dataAttr) || el.textContent;
      if(!q){
        el.innerHTML = raw;
        return;
      }
      try {
        var re = new RegExp('(' + q.replace(/[.*+?^${}()|[\\]\\\\]/g, '\\\\$&') + ')','ig');
        el.innerHTML = raw.replace(re, '<mark>$1</mark>');
      } catch(e){
        el.innerHTML = raw;
      }
    }

    input.addEventListener('input', function(){
      var q = normalize(this.value);
      var cards = list.querySelectorAll('.blog-card');

      cards.forEach(function(card){
        var title = card.getAttribute('data-title') || '';
        var excerpt = card.getAttribute('data-excerpt') || '';
        var link = card.querySelector('.blog-card__title-link');
        var para = card.querySelector('.blog-card__excerpt');

        var match = (q === '') || (title.indexOf(q) > -1) || (excerpt.indexOf(q) > -1);
        card.style.display = match ? '' : 'none';

        // highlight title + excerpt
        highlight(link, q, 'data-original-title');
        highlight(para, q, 'data-original-excerpt');
      });
    });
  })();
</script>

{% schema %}
{
  "name": "Blog grid with search",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading" },
    { "type": "range", "id": "excerpt_words", "label": "Excerpt words", "min": 8, "max": 60, "step": 1, "default": 26 },
    { "type": "checkbox", "id": "show_date", "label": "Show publish date", "default": true },
    { "type": "checkbox", "id": "show_author", "label": "Show author", "default": false },
    { "type": "checkbox", "id": "show_read_time", "label": "Show reading time", "default": true },
    { "type": "text", "id": "read_more_text", "label": "Read more text" },
    { "type": "text", "id": "search_placeholder", "label": "Search placeholder", "default": "Search by title or excerpt…" },
    { "type": "range", "id": "pad_top", "label": "Padding top", "min": 0, "max": 120, "step": 4, "default": 48 },
    { "type": "range", "id": "pad_bottom", "label": "Padding bottom", "min": 0, "max": 120, "step": 4, "default": 48 }
  ],
  "presets": [{ "name": "Blog grid with search" }]
}
{% endschema %}
