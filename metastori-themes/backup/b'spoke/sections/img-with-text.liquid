<section
  class="about-us-section img-with-text-section"
  style="{% if section.settings.background_color != blank %}background-color: {{ section.settings.background_color }};{% endif %}"
>
  <div class="img-with-text__container">
    <h2 class="img-with-text__section-title">
      {{- section.settings.section_heading | default: 'About Us' | escape -}}
    </h2>

    <div class="img-with-text__row">
      <div class="about-image img-with-text__image">
        {% if section.settings.about_image != blank %}
          <img
            src="{{ section.settings.about_image | image_url: width: 800 }}"
            srcset="
              {{ section.settings.about_image | image_url: width: 400 }} 400w,
              {{ section.settings.about_image | image_url: width: 800 }} 800w,
              {{ section.settings.about_image | image_url: width: 1200 }} 1200w
            "
            sizes="(max-width: 768px) 100vw, 50vw"
            alt="{{ section.settings.about_title | default: section.settings.section_heading | escape }}"
            loading="lazy"
            width="{{ section.settings.about_image.width }}"
            height="{{ section.settings.about_image.height }}"
          >
        {% endif %}
      </div>

      <div class="about-content img-with-text__content">
        {% if section.blocks.size > 0 %}
          <div class="icons">
            {% for block in section.blocks %}
              {% if block.settings.icon_image != blank %}
                <div class="icon-block" {{ block.shopify_attributes }}>
                  <img
                    src="{{ block.settings.icon_image | image_url: width: 200 }}"
                    alt="{{ block.settings.icon_text | escape }}"
                    loading="lazy"
                    width="50"
                    height="50"
                  >
                  {% if block.settings.icon_text != blank %}
                    <p>{{ block.settings.icon_text }}</p>
                  {% endif %}
                </div>
              {% endif %}
            {% endfor %}
          </div>
        {% endif %}

        {% if section.settings.about_title != blank %}
          <h3 class="img-with-text__title">{{ section.settings.about_title | escape }}</h3>
        {% endif %}

        {% if section.settings.about_description != blank %}
          <div class="img-with-text__description">{{ section.settings.about_description | newline_to_br }}</div>
        {% endif %}

        {% if section.settings.button_text != blank and section.settings.button_link != blank %}
          <a href="{{ section.settings.button_link }}" class="button img-with-text__button">{{ section.settings.button_text | escape }}</a>
        {% endif %}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Image with Text Section",
  "settings": [
    {
      "type": "text",
      "id": "section_heading",
      "label": "Section heading",
      "default": "About Us"
    },
    {
      "type": "text",
      "id": "about_title",
      "label": "Heading",
      "default": "Our story"
    },
    {
      "type": "textarea",
      "id": "about_description",
      "label": "Description",
      "default": "The journey began when a group of health enthusiasts, scientists, engineers, and doctors came together with a shared goal — to cure the world."
    },
    {
      "type": "image_picker",
      "id": "about_image",
      "label": "Image"
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button label",
      "default": "Know more"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button URL"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "default": "#fdf6cc"
    }
  ],
  "blocks": [
    {
      "type": "icon_block",
      "name": "Icon block",
      "settings": [
        {
          "type": "image_picker",
          "id": "icon_image",
          "label": "Icon image"
        },
        {
          "type": "text",
          "id": "icon_text",
          "label": "Icon text"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Img with Text Section"
    }
  ]
}
{% endschema %}

<style>
  .about-us-section.img-with-text-section {
    display: block;
    padding: 30px 10px 40px 40px;
  }

  .img-with-text-section .img-with-text__container {
    display: flex;
    flex-direction: column;
    align-items: stretch;
    max-width: 1337px;
    padding: 0 50px;
    margin: 0 auto;
    gap: 28px;
  }

  .img-with-text-section .img-with-text__section-title {
    margin: 0;
    text-align: center;
    font-size: 50px;
    line-height: 1.15;
    font-weight: bold;
    font-family: Optima, 'Optima Nova', 'Optima LT Pro', Candara, sans-serif;
    color: #000;
  }

  .img-with-text-section .img-with-text__row {
    display: flex;
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    gap: 40px;
  }

  .img-with-text-section .img-with-text__image {
    width: 50%;
    flex: 0 0 50%;
    order: 0;
  }

  .img-with-text-section .img-with-text__content {
    width: 50%;
    flex: 0 0 50%;
    order: 1;
    text-align: left;
  }

  .img-with-text-section .img-with-text__image img {
    display: block;
    width: 100%;
    max-width: 100%;
    height: auto;
    border-radius: 10px;
  }

  .img-with-text-section .icons {
    display: flex;
    gap: 20px;
    margin-bottom: 20px;
    flex-wrap: wrap;
  }

  .img-with-text-section .icon-block {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    max-width: 150px;
  }

  .img-with-text-section .icon-block p {
    font-size: 14px;
    margin-top: 12px;
    margin-bottom: 0;
    color: #000;
  }

  .img-with-text-section .img-with-text__title {
    font-size: 40px;
    line-height: 1.15;
    margin: 0 0 12px;
    font-weight: 700;
    color: #000;
    font-family: 'DM Sans';
  }

  .img-with-text-section .img-with-text__description {
    font-size: 20px;
    margin-bottom: 20px;
    line-height: 1.5;
    color: #000;
    font-family: 'DM Sans';
    -webkit-text-stroke: .3px;
  }

  .img-with-text-section .button.img-with-text__button {
    font-size: 20px;
    font-weight: bold;
    display: inline-block;
    background-color: #12723B;
    color: #fff;
    padding: 15px !important;
    text-decoration: none;
    border-radius: 10px;
    width: fit-content;
    text-transform: capitalize;
  }

  .img-with-text-section .icon-block img {
    width: 50px;
    max-width: 50px;
    height: 50px;
    object-fit: cover;
  }

  @media (max-width: 768px) {
    .img-with-text-section .img-with-text__container { 
      padding: 0;
    }
    .about-us-section.img-with-text-section {
      padding: 40px 16px;
    }

    .img-with-text-section .img-with-text__section-title {
      font-size: 28px;
      text-align: center;
    }

    .img-with-text-section .img-with-text__row {
      flex-direction: column;
      gap: 24px;
      align-items: stretch;
    }

    .img-with-text-section .img-with-text__image {
      order: -1;
      width: 100%;
      flex: 1 1 auto;
    }

    .img-with-text-section .img-with-text__content {
      width: 100%;
      flex: 1 1 auto;
    }

    .img-with-text-section .img-with-text__title {
      font-size: 25px;
    }

    .img-with-text-section .icons {
      justify-content: center;
    }

    .img-with-text-section .img-with-text__description {
      font-size: 15px;
    }
  }
</style>
