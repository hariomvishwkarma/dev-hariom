
<!-- HTML Markup -->
<div class="shop-by-concerns-section">
  <div class="container-1320 heading_with_arrows">
    <h2 class="section-heading">{{ section.settings.section_heading }}</h2>
    <div class="slider-controlsss">
    <div class="arrows_swiper">
      <span class="prev-arrow swiper-button-prev">{% render 'slick-left-icon' %}</span>
      <span class="next-arrow swiper-button-next">{% render 'slick-right-icon' %}</span>
    </div>
  </div>
  </div>
  <div class="concerns-slider swiper">
    <div class="swiper-wrapper">
      {% for concern in shop.metaobjects.concern_areas.values %}
        {% assign concern_gid = concern.gid | strip %}
        <a href="/collections/all?filter.p.m.custom.concern_areas=gid%3A%2F%2Fshopify%2FMetaobject%2F{{ concern_gid }}&filter.v.price.gte=&filter.v.price.lte=&filter.v.price.gte=&filter.v.price.lte=&sort_by=title-ascending" class="swiper-slide concern-item">
          <div class="concern_main">
            <span class="circle_box"></span>
            <div class="concern_title_subtitle">
              <div class="concern-title">{{ concern.concern_areas }}</div>
              <div class="concern-subtitle" style="display: block;">{{ concern.concern_health_goal_ }}</div>
            </div>
          </div>
        </a>
      {% endfor %}
      {% for concern in shop.metaobjects.concern_areas.values %}
        {% assign concern_gid = concern.gid | strip %}
        <a href="/collections/all?filter.p.m.custom.concern_areas=gid%3A%2F%2Fshopify%2FMetaobject%2F{{ concern_gid }}&filter.v.price.gte=&filter.v.price.lte=&filter.v.price.gte=&filter.v.price.lte=&sort_by=title-ascending" class="swiper-slide concern-item">
          <div class="concern_main">
            <span class="circle_box"></span>
            <div class="concern_title_subtitle">
              <div class="concern-title">{{ concern.concern_areas }}</div>
              <div class="concern-subtitle" style="display: block;">{{ concern.concern_health_goal_ }}</div>
            </div>
          </div>
        </a>
      {% endfor %}
      {% for concern in shop.metaobjects.concern_areas.values %}
        {% assign concern_gid = concern.gid | strip %}
        <a href="/collections/all?filter.p.m.custom.concern_areas=gid%3A%2F%2Fshopify%2FMetaobject%2F{{ concern_gid }}&filter.v.price.gte=&filter.v.price.lte=&filter.v.price.gte=&filter.v.price.lte=&sort_by=title-ascending" class="swiper-slide concern-item">
          <div class="concern_main">
            <span class="circle_box"></span>
            <div class="concern_title_subtitle">
              <div class="concern-title">{{ concern.concern_areas }}</div>
              <div class="concern-subtitle" style="display: block;">{{ concern.concern_health_goal_ }}</div>
            </div>
          </div>
        </a>
      {% endfor %}
      {% for concern in shop.metaobjects.concern_areas.values %}
        {% assign concern_gid = concern.gid | strip %}
        <a href="/collections/all?filter.p.m.custom.concern_areas=gid%3A%2F%2Fshopify%2FMetaobject%2F{{ concern_gid }}&filter.v.price.gte=&filter.v.price.lte=&filter.v.price.gte=&filter.v.price.lte=&sort_by=title-ascending" class="swiper-slide concern-item">
          <div class="concern_main">
            <span class="circle_box"></span>
            <div class="concern_title_subtitle">
              <div class="concern-title">{{ concern.concern_areas }}</div>
              <div class="concern-subtitle" style="display: block;">{{ concern.concern_health_goal_ }}</div>
            </div>
          </div>
        </a>
      {% endfor %}
    </div>
    
  </div>
  <div class="slider-controlsss container-1320 slider-control-mobile concern_control">
    <div class="swiper-pagination-1"> </div>
    <div class="arrows_swiper">
      <span class="prev-arrow swiper-button-prev">{% render 'slick-left-icon' %}</span>
      <span class="next-arrow swiper-button-next">{% render 'slick-right-icon' %}</span>
    </div>
  </div>
</div>
<script>
document.addEventListener("DOMContentLoaded", function() {
  var swiper = new Swiper(".concerns-slider", {
    spaceBetween: 30,
    // loop: true,
    // loopAdditionalSlides: 5,
    autoplay: true,
    navigation: {
      nextEl: ".swiper-button-next",
      prevEl: ".swiper-button-prev",
    },
    breakpoints: {
      1400: { slidesPerView: 7 },
      1199: { slidesPerView: 6 }, // Desktop: Normal layout (no rows)
      768: { 
        slidesPerView: 4, 
        // loop: true,
        spaceBetween: 20
      },  
      320: { 
        slidesPerView: 2, 
        grid: { rows: 3, fill: "row" }, 
        loop: false,
        spaceBetween: 20,
        pagination: {
          el: ".concern_control .swiper-pagination-1",
          type: "progressbar",
        },
        autoplay: false
      }   
    }
  });
});

</script>
<!-- CSS -->
<style>
.shop-by-concerns-section {
  text-align: left;
  padding: 0px;
margin: 30px auto;
  position: relative;
}
.section-heading {
  font-size: 30px;
  margin-bottom: 25px;
text-align: left;
}
.shop-by-concerns-section .swiper-wrapper {
    padding: 3px 0;
}
.concern-item {
    /* outline: 1px solid #ddd; */
    border-radius: 5px;
    text-align: center;
    min-height: 67px;
    /* min-width: 166px; */
    width: auto;
  display: flex;
    align-items: center;
    justify-content: center;
}
/* .concern-item:hover {
  transform: scale(1.05);
} */
.concern-title {
    font-weight: bold;
    display: block;
    width: 100%;
    font-size: 15px;
    position: relative;
}

.concern-subtitle {
    color: #000;
    font-size: 13px;
    margin-top: 2px;
}

.concern-item:nth-child(odd) {
  background-color: {{ section.settings.section_color_odd }};
}
.concern-item:nth-child(even) {
  background-color: {{ section.settings.section_color_even }};
}
            .slider-controlsss .arrows {
                gap: 10px;
                justify-content: center;
                border-block-end-width: 100%; display: flex;
                width: auto;
                align-items: center;
                position: absolute;
                margin-top: -55px;
                z-index: 999;
                right: 50px;
                left: auto !important;
            }

.slider-controlsss .slick-arrow {
    position: unset !important;
    transform: none !important;
    background: #353626;
    border-color: #353626 !important;
    color: #fff !important;
width: 30px !important; height: 30px !important;
}

    .slick-arrow svg{
        max-width: 100%;
        max-height: 100%;
       color: #fff !important;
        fill:  #fff !important;
        stroke: #fff !important;
stroke-width: 2px;
    }
    .slick-arrow svg path {  fill:  #fff !important; }
.concern_main {
    display: flex;
    gap: 10px;
    justify-content: center;
    text-align: left;
    padding: 10px;
    width: 100%;
}

.concern_main .circle_box {
    display: block;
    height: 15px;
    width: 15px;
    background: #FFFFFF;
    border-radius: 50%;
    flex: 0 0 auto;
    position: absolute;
    top: 13px;
    left: 20px;
}

.concern_title_subtitle .concern-title {
    display: flex;
    font-size: 15px;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    width: 120px;
    display: block;
    line-height: 1.3;
}
.concerns-slider .slick-slide {
  display: flex;
  justify-content: center;
  min-height: 83px;  
  padding:16px 9px;
}
.concern_title_subtitle {
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
}
 .shop-by-concerns-section .swiper-button-next:after,.shop-by-concerns-section .swiper-button-prev:after{
    display: none;
  }
  .arrows_swiper {
    display: flex;
    justify-content: center;
    gap: 12px;
}

.arrows_swiper span {
    position: relative;
    height: 35px !important;
    width: 35px !important;
    left: unset;
    transform: unset;
    right: unset;
    display: flex;
    top: unset;
    background: #52543C;
    align-items: center;
    margin: 0;
    border-radius: 50%;
}

.arrows_swiper span svg {
    height: 13px;
    fill: #fff;
}
.slider-controlsss {
    display: flex;
    justify-content: flex-end;
    align-items: center;
    gap: 15px;
    margin-top: 24px;
}
  .swiper-pagination-1.swiper-pagination-progressbar {
    position: relative;
    background: #f7f7f7;
    border-radius: 5px;
    height: 2px;
  }
  .swiper-pagination-1.swiper-pagination-progressbar .swiper-pagination-progressbar-fill {
    background: #000;
    border-radius: 5px;
  }
  .heading_with_arrows {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 28px;
  }
  
  .heading_with_arrows h2.section-heading {
      margin: 0;
  }
  .slider-controlsss.container-1320.slider-control-mobile {
    display: none;
  }
  .shop-by-concerns-section .swiper-button-next.swiper-button-disabled,
  .shop-by-concerns-section .swiper-button-prev.swiper-button-disabled {
    opacity: 1;
  }
@media (max-width: 768px){
  .concerns-slider.swiper {
    padding: 0 12px !important;
  }
  .heading_with_arrows .slider-controlsss {
    display: none;
  }
  .slider-controlsss.container-1320.slider-control-mobile {
    display: flex;
  }
  .heading_with_arrows h2.section-heading {
    font-size: 28px;
  }
  .arrows_swiper span {
    height: 28px !important;
    width: 28px !important;
  }
  .concern_main .circle_box {
    top: 13px;
    left: 15px;
  }
}
</style>


{% schema %}
{
  "name": "Shop By Concerns(Auto)",
  "settings": [
    {
      "type": "text",
      "id": "section_heading",
      "label": "Section Heading",
      "default": "Shop By Concerns"
    },
  {
      "type": "color",
      "id": "section_color_even",
      "label": "Color for Even Block"
    },
 {
      "type": "color",
      "id": "section_color_odd",
      "label": "Color for Odd Block"
    }
  ],
  "presets": [
    {
      "name": "Shop By Concerns(Auto)"
    }
  ]
}
{% endschema %}
