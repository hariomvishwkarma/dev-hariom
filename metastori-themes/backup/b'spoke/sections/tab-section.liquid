$(document).ready(function () {
  // Function to initialize the slider
  function initializeSlider(container) {
    if ($(container).hasClass('slick-initialized')) {
      $(container).slick('unslick'); // Destroy any existing slider
    }

    $(container).slick({
      slidesToShow: 4,
      slidesToScroll: 1,
      infinite: false,
      dots: true,
      arrows: true,
      prevArrow: '<button type="button" class="slick-prev-3"><i class="fas fa-chevron-left"></i></button>',
      nextArrow: '<button type="button" class="slick-next-3"><i class="fas fa-chevron-right"></i></button>',
      responsive: [
        {
          breakpoint: 768,
          settings: {
            slidesToShow: 2,
          },
        },
        {
          breakpoint: 480,
          settings: {
            slidesToShow: 1,
          },
        },
      ],
    });
  }

  // Initialize slider for the first active tab
  initializeSlider('.tab-content.active11 .collection-slider');

  // Tab switching functionality
  $('.tab--{{ section.id }}').on('click', function (evt) {
    evt.preventDefault();

    // Remove active class from all tabs and add to the clicked one
    $('.tab--{{ section.id }}').removeClass('active11');
    $(this).addClass('active11');

    // Show the corresponding tab content
    var sel = this.getAttribute('data-toggle-target');
    $('.tab-content-{{ section.id }}').removeClass('active11').filter(sel).addClass('active11');

    // Initialize the slider for the newly active tab
    setTimeout(function () {
      initializeSlider('.tab-content.active11 .collection-slider');
    }, 100); // Allow some time for the tab content to render
  });
});



</script>