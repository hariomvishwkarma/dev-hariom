

<div class="mobile-health-category-section">
  <div class="container">
    <div class="health-category-items">
      {% for block in section.blocks %}
      <div class="health-category-item">
        <a href="{{ block.settings.link }}" target="_blank">
          <div class="health-category-image">
           <img src="{{ block.settings.image | image_url: width: 200 }}">
          </div>
          <p>{{ block.settings.title }}</p>
        </a>
      </div>
      {% endfor %}
    </div>
  </div>
</div>

<style>
/* Mobile Health Category Section */
@media screen and (min-width: 769px) {
.mobile-health-category-section {
  display: none; /* Default hidden for desktop */
}
}

@media screen and (max-width: 768px) {
  .mobile-health-category-section {
    display: block; /* Visible only on mobile */
  }
}

.health-category-header h2 {
  text-align: center;
  font-size: 20px;
  color: #333;
  margin-bottom: 20px;
}

.health-category-items {
  display: flex;
  justify-content: space-around;
  flex-wrap: wrap;
  gap: 10px;
}

.health-category-item {
  text-align: center;
  flex: 0 0 45%;
}

.health-category-item a {
  text-decoration: none;
}

.health-category-image {
  width: 100px;
  height: 100px;
}

.health-category-image img {
  width: 100%;
  height: 100%;
object-fit: cover;
border-radius: 100%;
}

.health-category-item p {
  margin-top: 10px;
  font-size: 14px;
  color: #333;
  font-weight: bold;
}

.health-category-item {
    width: 25%;
    max-width: 25%;
}

.health-category-item a {
    display: block;
    width: 100%;
}

.health-category-items {
    overflow: auto;
    display: flex;
    justify-content: space-around;
    flex-wrap: nowrap;
    gap: 20px;
    margin: 10px 0px;
margin-top: 20px !important;
}

</style>



{% schema %}
 {
  "name": "Mobile Health Categories",
  "settings": [
  ],
  "blocks": [
    {
      "type": "category_block",
      "name": "Health Category",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Category Title",
          "default": "Immunity Booster"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Category Image"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Category Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Custom Category section"
    }
  ]
}
{% endschema %}