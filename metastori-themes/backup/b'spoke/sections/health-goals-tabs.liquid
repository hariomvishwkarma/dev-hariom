<style>
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top | times: 0.50 | round: 0 }}px;
      padding-bottom: {{ section.settings.padding_bottom | times: 0.50 | round: 0 }}px;
    }
    #tabs-nav .active a {
        color: #fff;
        background-color: #12723B;
        font-weight: 500;
        border-bottom: #00000026;
    }
    .tabs_wrapper .product-tab-block .list-product-tabs li {
      display: block;
      margin: 0 10px;
    }
    .product-card-layout-02 .tabs_wrapper .card {
      border: none !important;
      box-shadow: none !important;
    }
    /* .product-card-layout-02 .tabs_wrapper .card {
      border: none;
      border-radius: 5px;
    } */
    .tabs_wrapper .card__heading .card-title.link-underline.card-title-ellipsis {
        font-size: 20px;
        font-family: Optima;
        color: #12723B;
        font-weight: 700;
    }
    .product-tab-block .list-product-tabs li .tab_title {
        font-family: DM Sans;
        color: #000;
        font-size: 18px;
        font-weight: 500;
        line-height: 1;
        border-radius: 15px;
        border: 1px solid #00000026;
        padding: 17px 20px;
        display: block;
    }
    .tabs_wrapper .tab-content {
      background: transparent;
    }
    .tabs_heading {
        position: relative;
        display: flex;
        gap: 35px;
        margin-bottom: 40px;
        align-items: center;
        width: 100%;
        justify-content: space-between;
    }
    .tabs_heading .tab_heading {
        display: inline-block;
        margin: 0;
        font-size: 50px;
        line-height: 1.2;
        font-family: Optima;
        font-weight: 700;
        color: #000;
    }

    .tabs_heading .tab_heading span {
        font-family: Optima;
        font-weight: 700;
    }
    .tabs_wrapper .tab-content .button.button-ATC {
       margin-top: 0 !important;
        position: relative;
    }
    .tab-content {
      overflow: hidden;
      height: 0;
      padding: 0;
      margin: 0;
    }

    .active_tab_content {
      height: auto;
    }
  .custom-slick-arrows {
    display: flex;
    position: absolute;
    justify-content: flex-start;
    top: 0;
    right: 15px;
    gap: 10px;
  }

  .tabs.product-tab-block {
      position: relative;
  }

  .custom-slick-arrows .slick-arrow {
      position: relative;
      top: unset !important;
      transform: unset !important;
      background: #52543c;
  }
  .tabs_wrapper .tab-content .custom-slick-arrows {
    display: none;
  }

  .tabs_wrapper .tab-content.active_tab_content .custom-slick-arrows {
      display: flex;
  }
  .tabs_wrapper .tab-content.active_tab_content {
    position: relative;
    overflow: visible;
  }
  .tabs_wrapper .tab-content.active_tab_content .custom-slick-arrows {
    position: absolute;
    left: 0;
    right: 0;
    top: 40%;
    transform: translateY(-50%);
    pointer-events: none;
    z-index: 3;
  }
  .tabs_wrapper .tab-content.active_tab_content .custom-slick-arrows .slick-prev-custom,
  .tabs_wrapper .tab-content.active_tab_content .custom-slick-arrows .slick-next-custom {
    pointer-events: auto;
    position: absolute;
    top: 40%;
    transform: translateY(-50%);
    width: 50px;
    height: 50px;
    border-radius: 50%;
    border: 1px solid #0000001A;
    background: #ffffff;
    box-shadow: 0px 0px 11.9px 0px #12723B4D;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0;
    margin: 0;
    line-height: 1;
  }
  .tabs_wrapper .tab-content.active_tab_content .custom-slick-arrows .slick-prev-custom {
    left: 30px;
  }
  .tabs_wrapper .tab-content.active_tab_content .custom-slick-arrows .slick-next-custom {
    right: 30px;
  }
  .tabs_wrapper .tab-content.active_tab_content .custom-slick-arrows .slick-prev-custom svg,
  .tabs_wrapper .tab-content.active_tab_content .custom-slick-arrows .slick-next-custom svg {
    width: 14px;
    height: 14px;
  }
  .tabs_wrapper .tab-content.active_tab_content .custom-slick-arrows .slick-prev-custom.slick-disabled,
  .tabs_wrapper .tab-content.active_tab_content .custom-slick-arrows .slick-next-custom.slick-disabled {
    opacity: 0.5;
    cursor: not-allowed;
  }
  .tabs_wrapper .card-media>img {
      border-radius: 10px !important;
  }
  .tabs_wrapper .card-product:hover .card-media.media--hover-effect>img+img {
      opacity: 1;
      transform: scale(1);
  }
  .tabs_wrapper .halo-row.column-4 .halo-item {
    padding: 0 8px;
  }
  .tabs_wrapper .halo-row.column-4 .halo-item .card-information {
    padding: 15px 0 0;
  }
  .tabs_wrapper .card:hover {
    box-shadow: unset;
  }
  .tabs_wrapper .halo-row {
    margin-left: -8px;
    margin-right: -8px;
  }
  .tabs_wrapper .add_single_content.product__card_metaa {
    margin-bottom: 4px;
    font-size: 14px !important;
  }
  .tabs_wrapper .card-title:hover {
    text-decoration: none;
  }
  ul#tabs-nav {
    margin: 0;
  }
  .custom-slick-arrows .slick-arrow svg {
    height: 13px;
    width: 13px;
  }
  .custom-slick-scrollbar {
    display: none;
  }
  .price_action {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .price_action .card-action {
      width: auto;
  }

  .price_action a.mm.button.button-ATC {
    max-width: unset;
    min-width: fit-content;

    font-size: 18px !important;
    width: fit-content;
    font-weight: 400;
    margin-left: auto;
    margin-right: unset;
  }
  .price_action .button.button-ATC {
    width: auto !important;
    padding: 6px 16px;
    max-width: fit-content !important;
    display: inline-block;
    min-width: fit-content !important;
    min-height: auto !important;
    height: auto !important;
    line-height: unset !important;
    text-transform: capitalize !IMPORTANT;
    font-weight: 400;
    font-size: 18px;
  }
  .price_action .card-price {
    margin: 0;
  }

  .tabs_wrapper .tab-content .card-information__wrapper.text-left {min-height: auto;}
    @media screen and (min-width: 990px) {
      .section-{{ section.id }}-padding {
        padding-top: {{ section.settings.padding_top }}px;
        padding-bottom: {{ section.settings.padding_bottom }}px;
      }
    }
    @media screen and (max-width: 1199px) {
      .tabs_heading .tab_heading {
          position: relative;
          top: unset;
          transform: unset;
          display: block;
          text-align: center;
          margin-bottom: 0;
      }
    }
  @media screen and (max-width: 767px) {
    .tabs_wrapper .tab-content.active_tab_content {
      overflow: hidden;
    }
    .tabs_wrapper .tab-content.active_tab_content .custom-slick-arrows {
        top: 50%;
        margin-right: 12px;
        justify-content: right;
        margin-top: 14px;
    }
    .tabs_heading .tab_heading {
        margin: 0;
    }
    .tabs_heading {
      width: 100%;
      margin-bottom: 30px;
      display: block;
    }
    .tabs_heading .tab_heading span {
      font-size: 28px;
      letter-spacing: normal;
    }
    .tabs_wrapper .product-tab-block .list-product-tabs li {
      margin: 0;
    }
    .product-tab-block .list-product-tabs {
      padding-top: 16px;
    }
    .product-tab-block .list-product-tabs {
      padding-top: 20px;
    }
    .container-1170 {
      padding-left: 12px!important;
      padding-right: 12px!important;
    }
    .tabs_wrapper .halo-row.column-4 .halo-item {
      padding: 0 4px;
    }
    .tabs_wrapper .tab-content {
      background: transparent;
      margin-right: -15px;
    }
    .tabs_wrapper .halo-row .slick-list {
      padding-right: 15%;
    }
    .custom-slick-scrollbar {
      width: calc(100% - 80px);
      height: 2px;
      background: #f0f0f0;
      position: relative;
      margin-top: 0;
      border-radius: 5px;
      display: none;
    }
    .tabs_wrapper .tab-content.active_tab_content .custom-slick-arrows .slick-prev-custom {
        left: 7px;
    }
    .tabs_wrapper .tab-content.active_tab_content .custom-slick-arrows .slick-next-custom {
        right: 7px;
    }
    .custom-scrollbar-track {
      width: 100%;
      height: 100%;
      position: absolute;
      border-radius: 5px;
    }

    .custom-scrollbar-thumb {
      height: 100%;
      width: 30%; /* Adjust width based on visible slides */
      background: #232323;
      border-radius: 5px;
      position: absolute;
      left: 0;
      transition: left 0.3s ease;
      display: block !important;
    }

  }
    @media screen and (max-width: 500px) {
      .custom-slick-arrows {
          top: -2px;
      }
      .tabs_heading .tab_heading {
          text-align: center;
      }
      .custom-slick-arrows .slick-arrow {
        height: 30px;
        width: 30px;
      }

      .product-tab-block .list-product-tabs {
          flex-wrap: nowrap;
          overflow-x: auto;
          scroll-snap-type: x mandatory;
          justify-content: left;
          padding-bottom: 8px;
          gap: 15px;
      }
      .tabs_wrapper .product-tab-block .list-product-tabs li {
        scroll-snap-align: start;
        scroll-snap-stop: normal;
        flex-shrink: 0;
      }
    }
</style>

<div class="tabs_wrapper section-{{ section.id }}-padding">
  <div class="tabs product-tab-block container-1320">
    <div class="tabs_heading">
      <h3 class="tab_heading">
        <span>{{ section.settings.heading }}</span>
      </h3>
      <ul id="tabs-nav" class="list-product-tabs">
        {% for health_goal in shop.metaobjects.health_goals.values %}
          {% if forloop.first %}
            <li data-goal-title="All" class="active">
              <a href="#tab{{ forloop.index }}" class="tab_title">All</a>
            </li>
          {% endif %}
          <li data-goal-title="{{ health_goal.goal_name }}" class="">
            <a href="#tab{{ forloop.index | plus: 1 }}" class="tab_title">{{ health_goal.goal_name }}</a>
          </li>
        {% endfor %}
      </ul>

      <div></div>
    </div>
    <div id="tabs-content">
      {% assign health_goals = shop.metaobjects.health_goals.values %}

      {% for goal in health_goals %}
        {% if forloop.first %}
          <div id="tab{{ forloop.index }}" class="tab-content">
            <div class="tab-products-carousel halo-row column-4">
              {% for product in collections['best-sellers-1'].products limit: 30 %}
                <div class="product halo-item" data-goal="All">
                  {% render 'MS-product-card',
                    product_card_product: product,
                    media_size: 'square',
                    portrait_aspect_ratio: '282'
                  %}
                </div>
              {% endfor %}
            </div>
            <div class="custom-slick-arrows">
              <div class="custom-slick-scrollbar">
                <div class="custom-scrollbar-track">
                  <div class="custom-scrollbar-thumb"></div>
                </div>
              </div>
              <button class="slick-prev-custom">{% render 'slick-left-icon' %}</button>
              <button class="slick-next-custom">{% render 'slick-right-icon' %}</button>
            </div>
          </div>
        {% endif %}
        <div id="tab{{ forloop.index | plus: 1 }}" class="tab-content">
          <div class="tab-products-carousel halo-row column-4">
            {% for product in collections.all.products limit: 30 %}
              {% assign selected_goals = product.metafields.custom.choose_health_goals.value %}

              {% for selected_goal in selected_goals %}
                {% if selected_goal.goal_name contains goal.goal_name %}
                  <div class="product halo-item" data-goal="{{ goal.goal_name }}">
                    {% render 'MS-product-card',
                      product_card_product: product,
                      media_size: 'square',
                      portrait_aspect_ratio: '282'
                    %}
                  </div>
                {% endif %}
              {% endfor %}
            {% endfor %}
          </div>
          <div class="custom-slick-arrows">
            <div class="custom-slick-scrollbar">
              <div class="custom-scrollbar-track">
                <div class="custom-scrollbar-thumb"></div>
              </div>
            </div>
            <button class="slick-prev-custom">
              <svg width="11" height="19" viewBox="0 0 11 19" fill="none" xmlns="http://www.w3.org/2000/svg">
                <path fill-rule="evenodd" clip-rule="evenodd" d="M0.457422 10.4012L8.1918 18.1356C8.8019 18.7457 9.79107 18.7457 10.4012 18.1356C11.0113 17.5255 11.0113 16.5363 10.4012 15.9262L3.77148 9.29653L10.4012 2.66685C11.0113 2.05674 11.0113 1.06757 10.4012 0.457471C9.79107 -0.152631 8.8019 -0.152631 8.1918 0.457471L0.457422 8.19185C0.164499 8.48486 -5.62668e-05 8.88221 -5.62668e-05 9.29653C-5.62668e-05 9.71085 0.164499 10.1082 0.457422 10.4012Z" fill="black"/>
              </svg>
            </button>
            <button class="slick-next-custom">
              <svg width="11" height="19" viewBox="0 0 11 19" fill="none" xmlns="http://www.w3.org/2000/svg">
                <path fill-rule="evenodd" clip-rule="evenodd" d="M10.4015 10.4012L2.66709 18.1356C2.05699 18.7457 1.06782 18.7457 0.457715 18.1356C-0.152387 17.5255 -0.152387 16.5363 0.457714 15.9262L7.0874 9.29653L0.457715 2.66685C-0.152386 2.05674 -0.152387 1.06757 0.457715 0.457471C1.06782 -0.152631 2.05699 -0.152631 2.66709 0.457471L10.4015 8.19185C10.6944 8.48486 10.8589 8.88221 10.8589 9.29653C10.8589 9.71085 10.6944 10.1082 10.4015 10.4012Z" fill="black"/>
              </svg>
            </button>
          </div>
        </div>
      {% endfor %}
    </div>
    <!-- END tabs-content -->
  </div>
  <!-- END tabs -->
</div>
<script>
  $(document).ready(function () {
    $('.tab-content').each(function () {
      var $tabContent = $(this);
      var $slider = $tabContent.find('.tab-products-carousel');
      var $prevArrow = $tabContent.find('.slick-prev-custom');
      var $nextArrow = $tabContent.find('.slick-next-custom');
      var $scrollbar = $tabContent.find('.custom-scrollbar-thumb');
      var $scrollbarTrack = $tabContent.find('.custom-scrollbar-track');

      // Wait for layout rendering before setting the initial width
      setTimeout(function () {
        $scrollbar.css({ width: 30 + 'px', transition: 'width 0.3s ease' });
      }, 100); // Delay to ensure layout is calculated

      // Listen to Slick slider events for updating scrollbar width
      $slider.on('init reInit afterChange', function (event, slick, currentSlide) {
        if (!slick.$slides.length) return;

        var totalSlides = slick.$slides.length;
        var visibleSlides = slick.options.slidesToShow;
        var slideIndex = currentSlide || 0;

        var maxWidth = $scrollbarTrack.width(); // Full width of the track
        var newWidth = ((slideIndex + visibleSlides) / totalSlides) * maxWidth; // Increase width dynamically

        $scrollbar.css({ width: newWidth + 'px' });
      });

      $slider.slick({
        slidesToShow: 4,
        slidesToScroll: 4,
        infinite: true,
        autoplay: false,
        autoplaySpeed: 3000,
        dots: false,
        arrows: true,
        prevArrow: $prevArrow,
        nextArrow: $nextArrow,
        responsive: [
          {
            breakpoint: 1024,
            settings: {
              slidesToShow: 3,
              slidesToScroll: 3,
            },
          },
          {
            breakpoint: 768,
            settings: {
              slidesToShow: 2,
              slidesToScroll: 2,
            },
          },
          {
            breakpoint: 500,
            settings: {
              slidesToShow: 1,
              slidesToScroll: 1,
            },
          },
        ],
      });
    });

    let goalValues = new Set();

    // Collect all unique data-goal values from .product elements
    $('.tab-products-carousel .product').each(function () {
      goalValues.add($(this).attr('data-goal'));
    });

    // Iterate through .list-product-tabs li and hide those not in goalValues
    $('.list-product-tabs li').each(function () {
      let goalTitle = $(this).attr('data-goal-title');
      if (!goalValues.has(goalTitle)) {
        $(this).hide(); // Hide the <li> element
      }
    });
    let firstVisibleLink = $('.list-product-tabs li:visible').first().find('a');

    if (firstVisibleLink.length > 0) {
      setTimeout(() => {
        firstVisibleLink[0].click(); // Native click event
      }, 100); // Small delay to ensure visibility
    }

    // Show the first tab and hide the rest
    $('#tabs-nav li:first-child').addClass('active');
    $('.tab-content').removeClass('active_tab_content');
    $('.tab-content:first').addClass('active_tab_content');

    // Click function
    $('#tabs-nav li').click(function () {
      $('#tabs-nav li').removeClass('active');
      $(this).addClass('active');

      $('.tab-content').removeClass('active_tab_content');
      var activeTab = $(this).find('a').attr('href');
      $(activeTab).addClass('active_tab_content');

      return false;
    });
  });
</script>

{% schema %}
{
  "name": "Health goals tabs",
  "settings": [
    {
      "id": "heading",
      "type": "text",
      "label": "Main Heading"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "label": "Top Padding",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "label": "Bottom Padding",
      "default": 40
    }
  ],
  "presets": [
    {
      "name": "Health goals tabs"
    }
  ]
}
{% endschema %}
