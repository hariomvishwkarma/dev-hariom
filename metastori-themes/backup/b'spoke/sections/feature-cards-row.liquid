<section
  class="feature-cards-row section-{{ section.id }}-padding"
  style="background: {{ section.settings.section_background }};"
>
  <div class="container">
    {% if section.settings.heading != blank or section.settings.description != blank %}
      <div class="feature-cards-row__head">
        {% if section.settings.heading != blank %}
          <h2 class="feature-cards-row__title">{{ section.settings.heading }}</h2>
        {% endif %}
        {% if section.settings.description != blank %}
          <div class="feature-cards-row__description rte">{{ section.settings.description }}</div>
        {% endif %}
      </div>
    {% endif %}
    {% if section.blocks.size > 0 %}
      <div class="feature-cards-row__grid">
        {% for block in section.blocks %}
          <div class="feature-cards-row__item" {{ block.shopify_attributes }}>
            {% if block.settings.link != blank %}
              <a class="feature-cards-row__item-link" href="{{ block.settings.link }}">
            {% endif %}
            {% if block.settings.icon != blank %}
              <img
                src="{{ block.settings.icon | image_url: width: 96 }}"
                alt="{{ block.settings.icon.alt | escape }}"
                width="{{ block.settings.icon.width }}"
                height="{{ block.settings.icon.height }}"
                loading="lazy"
                class="feature-cards-row__icon"
              >
            {% endif %}
            <div class="feature-cards-row__content">
              {% if block.settings.title != blank %}
                <h3 class="feature-cards-row__item-title">{{ block.settings.title }}</h3>
              {% endif %}
              {% if block.settings.text != blank %}
                <div class="feature-cards-row__item-text rte">{{ block.settings.text }}</div>
              {% endif %}
            </div>
            {% if block.settings.link != blank %}
              </a>
            {% endif %}
          </div>
        {% endfor %}
      </div>
    {% endif %}
  </div>
</section>

{% style %}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top_mobile }}px;
    padding-bottom: {{ section.settings.padding_bottom_mobile }}px;
  }

  @media screen and (min-width: 990px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top_desktop }}px;
      padding-bottom: {{ section.settings.padding_bottom_desktop }}px;
    }
  }

  .feature-cards-row__head {
    text-align: center;
    margin-bottom: 28px;
  }

  .feature-cards-row__title {
    margin: 0 0 10px;
    color: {{ section.settings.heading_color }};
    font-size: 32px;
    line-height: 1.2;
  }

  .feature-cards-row__description {
    margin: 0;
    color: {{ section.settings.description_color }};
  }

  .feature-cards-row__description p {
    margin: 0;
  }

  .feature-cards-row__grid {
    display: grid;
    grid-template-columns: repeat(1, minmax(0, 1fr));
    gap: {{ section.settings.gap_mobile }}px;
  }

  .feature-cards-row__item {
    background: {{ section.settings.card_background }};
    border-radius: {{ section.settings.card_radius }}px;
    padding: {{ section.settings.card_padding_vertical }}px {{ section.settings.card_padding_horizontal }}px;
    display: flex;
    align-items: center;
    gap: 14px;
  }

  .feature-cards-row__item-link {
    display: flex;
    align-items: center;
    text-decoration: none;
    gap: 14px;
    width: 100%;
  }

  .feature-cards-row__icon {
    width: {{ section.settings.icon_size }}px;
    height: {{ section.settings.icon_size }}px;
    object-fit: contain;
    flex: 0 0 auto;
  }

  .feature-cards-row__content {
    min-width: 0;
  }

  .feature-cards-row__item-title {
    margin: 0;
    color: {{ section.settings.title_color }};
    font-size: 20px;
    line-height: 1.3;
    font-family: 'Alegreya Sans';
    font-weight: 500;
  }

  .feature-cards-row__item-text {
    margin-top: 6px;
    color: {{ section.settings.text_color }};
  }

  .feature-cards-row__item-text p {
    margin: 0;
  }

  @media screen and (min-width: 990px) {
    .feature-cards-row__grid {
      grid-template-columns: repeat({{ section.settings.columns_desktop }}, minmax(0, 1fr));
      gap: {{ section.settings.gap_desktop }}px;
    }
  }

  @media screen and (max-width: 989px) {
    .feature-cards-row__head {
      margin-bottom: 18px;
    }

    .feature-cards-row__title {
      font-size: 24px;
    }

    .feature-cards-row__item {
      gap: 10px;
      padding: 12px 14px;
    }

    .feature-cards-row__item-link {
      gap: 10px;
    }

    .feature-cards-row__item-title {
      font-size: 14px;
      line-height: 1.35;
    }

    .feature-cards-row__item-text {
      margin-top: 4px;
      font-size: 12px;
      line-height: 1.4;
    }
  }
  @media screen and (max-width: 749px) {
    .feature-cards-row__grid {
      display: flex;
      flex-wrap: nowrap;
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      gap: 18px;
      padding-bottom: 10px;
    }
    .feature-cards-row .container {
      padding: 0 25px;
    }
    .feature-cards-row__item {
        gap: 15px;
        padding: 20px 30px;
        display: flex;
        flex-direction: column;
        flex: 0 0 calc(50% - 9px);
        text-align: center;
        scroll-snap-align: start;
        scroll-snap-stop: normal;
    }
    .feature-cards-row__item-title {
      font-size: 15px;
    }
  }
{% endstyle %}

{% schema %}
{
  "name": "Feature Cards Row",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Why shoppers trust us"
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "Description",
      "default": "<p>Use this section to highlight core product benefits.</p>"
    },
    {
      "type": "color",
      "id": "section_background",
      "label": "Section background",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading color",
      "default": "#111111"
    },
    {
      "type": "color",
      "id": "description_color",
      "label": "Description color",
      "default": "#3b3b3b"
    },
    {
      "type": "color",
      "id": "card_background",
      "label": "Card background",
      "default": "#f3f1e8"
    },
    {
      "type": "color",
      "id": "title_color",
      "label": "Card title color",
      "default": "#121212"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Card text color",
      "default": "#4a4a4a"
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "label": "Desktop columns",
      "min": 2,
      "max": 4,
      "step": 1,
      "default": 3
    },
    {
      "type": "range",
      "id": "gap_desktop",
      "label": "Desktop gap",
      "min": 12,
      "max": 40,
      "step": 4,
      "unit": "px",
      "default": 20
    },
    {
      "type": "range",
      "id": "gap_mobile",
      "label": "Mobile gap",
      "min": 8,
      "max": 30,
      "step": 2,
      "unit": "px",
      "default": 14
    },
    {
      "type": "range",
      "id": "card_radius",
      "label": "Card corner radius",
      "min": 0,
      "max": 30,
      "step": 2,
      "unit": "px",
      "default": 12
    },
    {
      "type": "range",
      "id": "card_padding_horizontal",
      "label": "Card horizontal padding",
      "min": 12,
      "max": 48,
      "step": 4,
      "unit": "px",
      "default": 20
    },
    {
      "type": "range",
      "id": "card_padding_vertical",
      "label": "Card vertical padding",
      "min": 12,
      "max": 44,
      "step": 4,
      "unit": "px",
      "default": 20
    },
    {
      "type": "range",
      "id": "icon_size",
      "label": "Icon size",
      "min": 24,
      "max": 80,
      "step": 4,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_top_desktop",
      "label": "Desktop top padding",
      "min": 0,
      "max": 160,
      "step": 8,
      "unit": "px",
      "default": 64
    },
    {
      "type": "range",
      "id": "padding_bottom_desktop",
      "label": "Desktop bottom padding",
      "min": 0,
      "max": 160,
      "step": 8,
      "unit": "px",
      "default": 64
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "label": "Mobile top padding",
      "min": 0,
      "max": 120,
      "step": 6,
      "unit": "px",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "label": "Mobile bottom padding",
      "min": 0,
      "max": 120,
      "step": 6,
      "unit": "px",
      "default": 36
    }
  ],
  "blocks": [
    {
      "type": "feature_card",
      "name": "Feature card",
      "settings": [
        {
          "type": "image_picker",
          "id": "icon",
          "label": "Icon"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "100% Pure & Clean Ingredients"
        },
        {
          "type": "richtext",
          "id": "text",
          "label": "Paragraph",
          "default": "<p>Add a short supporting line for this feature.</p>"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Feature Cards Row",
      "blocks": [
        {
          "type": "feature_card"
        },
        {
          "type": "feature_card"
        },
        {
          "type": "feature_card"
        }
      ]
    }
  ]
}
{% endschema %}
