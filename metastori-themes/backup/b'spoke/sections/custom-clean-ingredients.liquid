<div class="main-ingredients">
  {% if section.settings.right_title != blank %}
    <h2 class="ingredients-section-title">{{ section.settings.right_title }}</h2>
  {% endif %}
  <div class="cild-ingredients">
    <div class="ingredients-img">
      <img src="{{ section.settings.ingredients_img  | img_url: '500x500' }}" alt="{{ }}" class="img_11 img_1 enable">
      <img src="{{ section.settings.ingredients_img2  | img_url: '500x500' }}" alt="{{ }}" class="img_11 img_2">
      <img src="{{ section.settings.ingredients_img3  | img_url: '500x500' }}" alt="{{ }}" class="img_11 img_3">
      <img src="{{ section.settings.ingredients_img4  | img_url: '500x500' }}" alt="{{ }}" class="img_11 img_4">
      <img src="{{ section.settings.ingredients_img5  | img_url: '500x500' }}" alt="{{ }}" class="img_11 img_5">
    </div>
    <div class="ingredients-right">
      <ul class="ingredients-list">
        {% for ingredient in section.blocks %}
          {% if ingredient.settings.ingredient_name != blank %}
            <li class="{{ forloop.index }}_link {% if forloop.index == 1 %}active{% endif %}" data-target="img_{{ forloop.index }}">
              <strong class="ingredients-list__heading">{{ ingredient.settings.ingredient_name }}</strong>
              <div class="ingredients-list__body">
                <p class="toggle_content">{{ ingredient.settings.ingredient_description }}</p>
                <span class="read_moree">Read more</span>
              </div>
            </li>
          {% endif %}
        {% endfor %}
      </ul>
    </div>
  </div>
</div>

{% schema %}
  {
    "name": "Clean Ingredients Section",
    "max_blocks": 5,
    "settings": [
      {
        "type": "image_picker",
        "id": "ingredients_img",
        "label": "Left image 1"
      },
 {
        "type": "image_picker",
        "id": "ingredients_img2",
        "label": "Left image 2"
      },
 {
        "type": "image_picker",
        "id": "ingredients_img3",
        "label": "Left image 3"
      },
 {
        "type": "image_picker",
        "id": "ingredients_img4",
        "label": "Left image 4"
      },
{
        "type": "image_picker",
        "id": "ingredients_img5",
        "label": "Left image 5"
      },

      {
        "type": "text",
        "id": "right_title",
        "label": "Main title"
      }
    ],
    "blocks": [
        {
      "type": "benefit",
      "name": "Benefit",
      "settings": [
        {
          "type": "text",
          "id": "benefit",
          "label": "Benefit",
          "default": "Promotes mucus production"
        }
      ]
    },
    {
      "type": "ingredient",
      "name": "Ingredient",
      "settings": [
        {
          "type": "text",
          "id": "ingredient_name",
          "label": "Ingredient Name",
          "default": "Slippery Elm"
        },
        {
          "type": "text",
          "id": "ingredient_description",
          "label": "Ingredient Description",
          "default": "Coats the esophagus and stomach lining to reduce irritation and soothe acid reflux symptoms."
        }
      ]
    }
      
    ],
    "presets": [
      {
        "name": "Clean Ingredients Section"
      }
    ]
  }
{% endschema %}
<style>
  .main-ingredients {
    width: 100%;
    max-width: 1337px;
    padding: 0 50px;
    margin: 0 auto;
    margin-bottom: 40px;
  }

  .ingredients-section-title {
    text-align: center;
    font-size: 50px;
    font-weight: bold;
    color: black;
    margin: 0 auto 40px;
    padding: 0 20px;
    max-width: 1200px;
    font-family: optima;
    line-height: 1.15;
  }

  .ingredients-img {
    width: 50%;
  }

  .ingredients-right {
    width: 50%;
  }

  .cild-ingredients {
    width: 100%;
    display: flex;
  }

  ul.ingredients-list {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  ul.ingredients-list li {
    font-size: 20px;
    font-weight: 400;
    display: block;
    list-style: none;
    margin-bottom: 24px;
    position: relative;
    cursor: pointer;
    padding-left: 20px;
    border-left: 4px solid transparent;
    transition: border-color 0.2s ease;
  }

  ul.ingredients-list li.active {
    border-left-color: #12723B;
  }

  ul.ingredients-list .ingredients-list__heading {
    font-family: 'DM Sans';
    font-size: 35px;
    font-weight: bold;
    display: block;
    margin-bottom: 8px;
    line-height: 1.2;
    color: #000;
    transition: color 0.2s ease;
  }

  ul.ingredients-list li.active .ingredients-list__heading {
    color: #12723B;
  }

  ul.ingredients-list p {
    font-size: 12px;
    font-weight: 500;
    line-height: 18px;
    margin: 0;
    font-family: 'DM Sans';
    color: #000;
  }

  .ingredients-list__body {
    margin-top: 4px;
  }

  .read_moree {
    display: none;
    margin-top: 8px;
    color: #12723B;
    cursor: pointer;
    font-size: 15px;
    font-weight: 500;
    font-family: 'suisse-intl-regular', sans-serif;
  }

  .read_moree.is-visible {
    display: inline-block;
  }

  .ingredients-img img {
    display: none;
  }

  .ingredients-img img.enable {
    display: block;
  }

  .toggle_content {
    overflow: hidden;
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 3;
    line-clamp: 3;
  }

  .toggle_content.expanded {
    display: block;
    -webkit-line-clamp: unset;
    line-clamp: unset;
    overflow: visible;
  }

  @media (max-width: 768px) {
    .cild-ingredients {
      flex-direction: column;
    }

    .ingredients-right {
      width: 100%;
    }

    .ingredients-img {
      width: 100%;
    }

    .ingredients-img img {
      padding: 6px;
      width: 100%;
    }

    ul.ingredients-list .ingredients-list__heading {
      font-size: 25px;
    }
    .main-ingredients {
        padding: 0 15px;
        padding-bottom: 30px;
    }
    h2.ingredients-section-title {
        font-size: 28px;
        margin: 0;
    }
  }
</style>

<script>
$(document).ready(function () {
    $('.ingredients-img img').not('.enable').hide();

    function setActiveLi($li) {
        $('.ingredients-list li').removeClass('active');
        $li.addClass('active');
        var targetImg = $li.data('target');
        $('.ingredients-img img').fadeOut(300, function () {
            $('.' + targetImg).fadeIn(300).addClass('enable');
        });
        $('.ingredients-img img').removeClass('enable');
        $('.' + targetImg).addClass('enable');
    }

    function updateReadMoreVisibility() {
        $('.ingredients-list li').each(function () {
            var $p = $(this).find('.toggle_content');
            var $btn = $(this).find('.read_moree');
            if ($p.hasClass('expanded')) {
                $btn.addClass('is-visible').text('Read less');
                return;
            }
            var el = $p[0];
            if (!el) return;
            var needsToggle = el.scrollHeight > el.clientHeight + 2;
            if (needsToggle) {
                $btn.addClass('is-visible').text('Read more');
            } else {
                $btn.removeClass('is-visible').text('Read more');
            }
        });
    }

    $('.ingredients-list li').on('click', function (e) {
        if ($(e.target).closest('.read_moree').length) return;
        var $li = $(this);
        var wasActive = $li.hasClass('active');
        setActiveLi($li);
        if (!wasActive) {
            $('.toggle_content').removeClass('expanded');
            $('.read_moree').text('Read more');
            updateReadMoreVisibility();
        }
    });

    $('.read_moree').on('click', function (e) {
        e.stopPropagation();
        var $btn = $(this);
        var $li = $btn.closest('li');
        var $content = $btn.siblings('.toggle_content');

        if (!$li.hasClass('active')) {
            setActiveLi($li);
        }

        if ($content.hasClass('expanded')) {
            $content.removeClass('expanded');
            $btn.text('Read more');
            updateReadMoreVisibility();
            return;
        }

        $('.toggle_content').not($content).removeClass('expanded');
        $('.read_moree').not($btn).text('Read more');

        $content.addClass('expanded');
        $btn.text('Read less').addClass('is-visible');
        updateReadMoreVisibility();
    });

    updateReadMoreVisibility();
    $(window).on('load', function () {
        setTimeout(updateReadMoreVisibility, 150);
    });
    var resizeTimer;
    $(window).on('resize', function () {
        clearTimeout(resizeTimer);
        resizeTimer = setTimeout(updateReadMoreVisibility, 100);
    });
});

</script>