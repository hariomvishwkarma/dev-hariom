    <section class="features-section1 container-1170 container">
    <div class="features-containerss">
    {% for block in section.blocks %}
    <div class="feature-item">
    <div class="high-cut-img">
    {% if block.settings.icon %}
    <img
    src="{{ block.settings.icon | img_url :'master' }}"
    alt="{{ block.settings.title }}"
    class="feature-icon"
    >
    {% endif %}
    </div>
    <div class="hifh-cu-cont">
    <h3 class="feature-titles">{{ block.settings.title }}</h3>
    <p class="feature-description">{{ block.settings.description }}</p>
    </div>
    </div>
    {% endfor %}
    </div>
    <style>
    .features-section1{
    padding-top:52px;
    padding-bottom:52px;
max-width: 1300px !important;
    }
    .features-containerss {
    width: 100%;
    display: flex;
    gap: 30px;
    align-items: center;
   justify-content: center;
    }
    
    .features-section1 .feature-item {
    display: flex;
    gap: 20px;
    align-items: center;
    width:25%;
    }
    
    .hifh-cu-cont h3 {
    font-size: 18px;
    font-weight: 700;
    line-height: 22px;
    color: #000000;
    margin: 0px;
    text-align: start;
margin-bottom: 5px !important;
    }
    
    .hifh-cu-cont p {
    font-size: 12px;
    font-weight: 400;
    color: #000000;
    line-height: 18px;
    margin: 0px;
    text-align: start;
    }
    
    .high-cut-img img {
                 width: 35px;
                min-width: 35px;
                height: auto;
                padding: 5px;
                object-fit: cover;
    }
    
    .high-cut-img {
    background-color: #F7F1B5;
    padding: 5px;
    border-radius: 100%;
    }
    
    /* Responsive  */
    @media(max-width:767px)
    {
    .features-containerss {
    flex-direction: column;
    }
    
    .feature-item {
    width: 100%;
    gap: 20px;
    }
    
    .hifh-cu-cont p {
    max-width: 100%;
    }
    }
    </style>
    </section>
    
    {% schema %}
    {
    "name": "Custom High Tech",
    "class": "custom__high__tech",
    "settings": [],
    "blocks": [
    {
    "type": "feature",
    "name": "Feature",
    "settings": [
    {
    "type": "image_picker",
    "id": "icon",
    "label": "Icon"
    },
    {
    "type": "text",
    "id": "title",
    "label": "Title",
    "default": "High Tech Formula"
    },
    {
    "type": "text",
    "id": "description",
    "label": "Description",
    "default": "Evidence-based ingredients that work to regulate stomach acid levels."
    }
    ]
    }
    ],
    
    "presets": [
    {
    "name": "Custom High Tech",
    }
    ]
    }
    {% endschema %}