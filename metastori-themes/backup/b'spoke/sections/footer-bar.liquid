{% if section.blocks.size > 0 %}
  <div
    id="footer-bar-{{ section.id }}"
    class="footer-bar footer_bar__sectionn"
    style="{% if section.settings.background_color != blank %}background-color: {{ section.settings.background_color }};{% endif %}--footer-bar-marquee-duration: {{ section.settings.marquee_speed | default: 45 }}s;"
  >
    <div class="footer-bar__marquee" role="region" aria-label="Store benefits and policies">
      <div class="footer-bar__marquee-track">
        <div class="footer-bar__marquee-group">
          {% for block in section.blocks %}
            <div class="footer-bar__item" {{ block.shopify_attributes }}>
              {% if block.settings.icon_image != blank %}
                <div class="footer-bar__icon">
                  {{
                    block.settings.icon_image
                    | image_url: width: 80
                    | image_tag:
                      loading: 'lazy',
                      class: 'footer-bar__icon-img',
                      widths: '40, 60, 80',
                      sizes: '32px',
                      alt: block.settings.text | default: '' | escape
                  }}
                </div>
              {% endif %}
              {% if block.settings.text != blank %}
                <span class="footer-bar__text">{{ block.settings.text | escape }}</span>
              {% endif %}
            </div>
          {% endfor %}
        </div>
        <div class="footer-bar__marquee-group" aria-hidden="true">
          {% for block in section.blocks %}
            <div class="footer-bar__item footer-bar__item--clone">
              {% if block.settings.icon_image != blank %}
                <div class="footer-bar__icon">
                  {{
                    block.settings.icon_image
                    | image_url: width: 80
                    | image_tag:
                      loading: 'lazy',
                      class: 'footer-bar__icon-img',
                      widths: '40, 60, 80',
                      sizes: '32px',
                      alt: ''
                  }}
                </div>
              {% endif %}
              {% if block.settings.text != blank %}
                <span class="footer-bar__text">{{ block.settings.text | escape }}</span>
              {% endif %}
            </div>
          {% endfor %}
        </div>
      </div>
    </div>
  </div>
{% endif %}

{% schema %}
{
  "name": "Footer Bar Section",
  "max_blocks": 12,
  "settings": [
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "default": "#C2DDB4"
    },
    {
      "type": "range",
      "id": "marquee_speed",
      "min": 20,
      "max": 90,
      "step": 5,
      "unit": "s",
      "label": "Marquee duration (one full cycle)",
      "info": "Higher values scroll more slowly.",
      "default": 45
    }
  ],
  "blocks": [
    {
      "type": "feature",
      "name": "Feature",
      "settings": [
        {
          "type": "image_picker",
          "id": "icon_image",
          "label": "Icon (image or SVG)"
        },
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "default": "7-day free return policy"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Footer Bar Section",
      "blocks": [
        {
          "type": "feature",
          "settings": {
            "text": "7-day free return policy"
          }
        },
        {
          "type": "feature",
          "settings": {
            "text": "Shipping worldwide"
          }
        },
        {
          "type": "feature",
          "settings": {
            "text": "FREE DELIVERY"
          }
        },
        {
          "type": "feature",
          "settings": {
            "text": "GMO Free"
          }
        },
        {
          "type": "feature",
          "settings": {
            "text": "Alergen Free"
          }
        },
        {
          "type": "feature",
          "settings": {
            "text": "Contaminates Free"
          }
        }
      ]
    }
  ]
}
{% endschema %}

<style>
  #footer-bar-{{ section.id }}.footer-bar {
    --footer-bar-marquee-duration: 45s;
    width: 100%;
    display: block;
    margin: 0 auto;
    padding: 0;
    overflow: hidden;
  }

  #footer-bar-{{ section.id }} .footer-bar__marquee {
    overflow: hidden;
    width: 100%;
    padding: 14px 0;
    box-sizing: border-box;
  }

  #footer-bar-{{ section.id }} .footer-bar__marquee-track {
    display: flex;
    width: max-content;
    align-items: center;
    will-change: transform;
    animation: footer-bar-marquee-scroll var(--footer-bar-marquee-duration, 45s) linear infinite;
  }

  #footer-bar-{{ section.id }} .footer-bar:hover .footer-bar__marquee-track {
    animation-play-state: paused;
  }

  @keyframes footer-bar-marquee-scroll {
    0% {
      transform: translateX(0);
    }
    100% {
      transform: translateX(-50%);
    }
  }

  #footer-bar-{{ section.id }} .footer-bar__marquee-group {
    display: flex;
    flex-direction: row;
    flex-wrap: nowrap;
    align-items: center;
    gap: 36px;
    padding: 0 18px;
    box-sizing: border-box;
  }

  #footer-bar-{{ section.id }} .footer-bar__item {
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: flex-start;
    gap: 10px;
    flex: 0 0 auto;
    min-width: 0;
  }

  #footer-bar-{{ section.id }} .footer-bar__icon {
    flex-shrink: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 32px;
    height: 32px;
  }

  #footer-bar-{{ section.id }} .footer-bar__icon-img {
    width: 32px;
    height: 32px;
    max-width: 32px;
    max-height: 32px;
    object-fit: contain;
    display: block;
  }

  #footer-bar-{{ section.id }} .footer-bar__text {
    font-family: 'Alegreya Sans', sans-serif;
    font-size: 20px;
    line-height: 1.35;
    font-weight: 500;
    color: #0d1f0d;
    text-align: left;
    white-space: nowrap;
  }

  @media (prefers-reduced-motion: reduce) {
    #footer-bar-{{ section.id }} .footer-bar__marquee-track {
      animation: none;
      flex-wrap: wrap;
      width: 100%;
      max-width: 1170px;
      margin: 0 auto;
      justify-content: center;
      row-gap: 16px;
    }

    #footer-bar-{{ section.id }} .footer-bar__marquee-group[aria-hidden='true'] {
      display: none;
    }

    #footer-bar-{{ section.id }} .footer-bar__marquee-group {
      flex-wrap: wrap;
      justify-content: center;
    }

    #footer-bar-{{ section.id }} .footer-bar__text {
      white-space: normal;
    }
  }
</style>
