    <!-- Include Slick CSS -->
    <link rel="stylesheet" type="text/css" href="https://cdnjs.cloudflare.com/ajax/libs/slick-carousel/1.8.1/slick.min.css">
    <link
    rel="stylesheet"
    type="text/css"
    href="https://cdnjs.cloudflare.com/ajax/libs/slick-carousel/1.8.1/slick-theme.min.css"
    >
    
    <!-- Include Slick JS -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.6.0/jquery.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/slick-carousel/1.8.1/slick.min.js"></script>
    
    <div class="main-custom-slide">
<h2 class="text-center">Over 20,000+ happy customers</h2>
    <div class="child-custom-slide">
    {% for block in section.blocks %}
    <div class="first-slide">
    <div class="first-slide-content">
    <div class="first-slide-head">
    <h3>{{ block.settings.first_text }}</h3>
    <h4>{{ block.settings.second_text }}</h4>
    </div>
    <div class="first-slide-review">
    {% if block.settings.first_review_img %}
    <img src="{{ block.settings.first_review_img | img_url: 'master' }}" alt="Review Image">
    <p>{{ block.settings.first_review_content }}</p>
    <h2>{{ block.settings.review_cus_name }}</h2>
    {% if block.settings.review_btn_text %}
    <a href="{{ block.settings.review_btn_link }}" class="review-btn">
    {{ block.settings.review_btn_text }}
    </a>
    {% endif %}
    {% endif %}
    </div>
    </div>
    <div
    class="first-slide-image"
    style="background-image: url('{{ block.settings.background_image | img_url: 'master' }}'); background-size: cover; border-radius:12px; background-position: center; width: 50%;"
    >
    <p>hello</p>
    <div class="mobile-view">
    <img src="{{ block.settings.mobile_eview_img | img_url: 'master' }}" alt="Review Image">
    </div>
    </div>
    </div>
    {% endfor %}
    </div>
    </div>
    
    {% schema %}
    {
    "name": "Customer Slide",
   "class": "custom-slide",
    "settings": [],
    "blocks": [
    {
    "type": "custom-slide",
    "name": "slides",
    "settings": [
    {
    "type": "text",
    "id": "first_text",
    "label": "First Text"
    },
    {
    "type": "text",
    "id": "second_text",
    "label": "Second Text"
    },
    {
    "type": "image_picker",
    "id": "first_review_img",
    "label": "First Slide Review Image"
    },
    {
    "type": "textarea",
    "id": "first_review_content",
    "label": "First Reviw Content"
    },
    {
    "type": "text",
    "id": "review_cus_name",
    "label": "Customer Name"
    },
    {
    "type": "url",
    "id": "review_btn_link",
    "label": "Review Button link"
    },
    {
    "type": "text",
    "id": "review_btn_text",
    "label": "Review Button Text"
    },
    {
    "type": "image_picker",
    "id": "background_image",
    "label": "Background Image"
    },
    {
    "type": "image_picker",
    "id": "mobile_eview_img",
    "label": "Mobile View Image"
    }
    
    ]
    }
    ],
    "presets": [
    {
    "name": "Customer Slide"
    }
    ]
    }
    {% endschema %}
    
    <style>
    .main-custom-slide {
    width: 100%;
margin: 40px auto;
    }
    
    .child-custom-slide {
    display: flex;
    width: 100%;
    gap: 15px;
    }
    
    .first-slide {
    width: 50%;
    display: flex;
    gap:16px;
    }
    
    .first-slide-content {
    border: 1px solid #000000;
    padding-left: 19px;
    padding-right: 19px;
    padding-top: 35px;
    padding-bottom: 35px;
    border-radius:12px;
    width:50%;
    }
    .first-slide-head {
    display: flex;
    gap: 20px;
    justify-content: center;
    align-items:center;
    }
    
    
    
    .first-slide-review {
    display: flex;
    flex-direction: column;
    align-items: center;
    /* justify-content: center; */
    }
    
    .first-slide-review p {
    max-width: 268px;
    text-align: center;
    }
    
    .first-slide-content h3 {
    font-size: 14px;
    font-weight: 400;
    line-height: 18px;
    color: #000000;
    background-color:#EAF8F2;
    padding-top:5px;
    padding-right:10px;
    padding-bottom:5px;
    padding-left:10px;
    }
    .first-slide-content h4 {
    font-size: 14px;
    font-weight: 400;
    line-height: 18px;
    color: #000000;
    background-color:#FBF8D8;
    padding-top:5px;
    padding-right:10px;
    padding-bottom:5px;
    padding-left:10px;
    }
    .first-slide-image p{
    display:none;
    }
    .mobile-view{
    display:none;
    }
    .first-slide-review a {
    font-size: 16px;
    font-weight: 400;
    line-height: 18px;
    color: #FFFFFF;
    background-color: #2CB67D;
    padding-top: 10px;
    padding-bottom: 10px;
    padding-left: 24px;
    padding-right: 24px;
    border-radius: 24px;
    text-decoration: none;
    cursor: pointer;
    }
    
    
    /* Reponsive */
    @media (max-width: 768px){
.main-custom-slide .slick-dots {
    text-align: center;
    margin-top: 10px;
    }
    
    .main-custom-slide .slick-dots li button:before {
    color: #000; /* Customize dot color */
    font-size: 12px;
    }
    
    .main-custom-slide .slick-track {
    display: flex;
    align-items: center;
    }
    
    .child-custom-slide {
    display: block !important; /* Override flex for Slick */
    }
    
    
    .mobile-view{
    display:block;
    }
    .first-slide-image{
    display;none;
    }
    .first-slide-image {
    background: none !important;
    }
    .first-slide {
    flex-direction: column-reverse;
    }
    
    .first-slide-content {
    width: 100%;
    }
    .first-slide {
    width: 310px !important;!i;
    }
    
    .mobile-view img {
    width: 310px;
    }
    .first-slide-content h4,h3 {
    font-size:12px;
    }
    .first-slide {
    width: 50%;
    display: flex !important;
    gap: 15px;
    flex-direction: column-reverse;
    }
    .main-custom-slide .slick-track {
    display: flex;
    align-items: center;
    gap: 39px;
    }
    .main-custom-slide .slick-next:before, .main-custom-slide .slick-prev:before {
    font-family: slick;
    font-size: 36px;
    line-height: 1;
    color: red;
    position: relative;
    top: 27px;
    right: -4px;
    }
    .main-custom-slide .slick-next:before, .main-custom-slide .slick-prev:before {
    font-family: slick;
    font-size: 36px;
    line-height: 1;
    color: red;
    position: relative;
    top: 351px;
    right: -165px;
    /* display: flex; */
    /* gap: 27px; */
    }
    
    .main-custom-slide .slick-next, .main-custom-slide .slick-prev {
    top: auto;
    bottom: -37px;
    }
    .main-custom-slide .slick-prev{
    right:auto;
    left:calc(50% - 32px);
    }
    .main-custom-slide .slick-next{
    left:auto;
    right:calc(50% - 32px);
    }
    .main-custom-slide .slick-next:before, .main-custom-slide .slick-prev:before{
    top:unset !important;
    right:unset !important;
    left:unset !important;
    
    }
    
    
    .main-custom-slide {
    padding-bottom: 40px;
    }
    .main-custom-slide .slick-next:before, .main-custom-slide .slick-prev:before {
    color: #52543C!important;
    }
    
    .main-custom-slide .slick-next, .main-custom-slide .slick-prev {
    padding-top: 28px !important;
    }                             }
    </style>
    
    <script>
    $(document).ready(function () {
    function initializeSlick() {
    if ($(window).width() <= 768) {
    if (!$('.child-custom-slide').hasClass('slick-initialized')) {
    $('.child-custom-slide').slick({
    dots: false,
    arrows: false,
    infinite: true,
    slidesToShow: 1,
    slidesToScroll: 1,
    mobileFirst: true,
    prevArrow: '<button type="button" class="slick-prev">‹</button>',
    nextArrow: '<button type="button" class="slick-next">›</button>',
    });
    }
    } else {
    if ($('.child-custom-slide').hasClass('slick-initialized')) {
    $('.child-custom-slide').slick('unslick');
    }
    }
    }
    
    initializeSlick();
    $(window).resize(function () {
    initializeSlick();
    });
    });
    </script>
