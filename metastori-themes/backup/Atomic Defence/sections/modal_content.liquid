<style>
  .map-heading {
  margin: 0;
    width: 75%;
}
.map-logo {
  max-height: 75px;
  width: auto;
}
@media only screen and (min-width: 500px) {
  .map-container {
    display: grid;
    grid-template-columns: 50% 50%;
    grid-template-rows: 50% 50%;
  }
  .map-item {
    display: flex;
    justify-content: center;
    align-items: center;
  }
  .about-header {
    max-wdith: 80vw;
    text-align:center;
  }
}
@media only screen and (max-width: 499px) {
  .map-container {
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    max-width: 80vw;
  }
  .map-item {
    display: flex;
    justify-content: center;
    align-items: center;
  }
}
</style>

<script defer>
  let btn;
  let modal;
  let span;
  var openModal = (modalId, btnId, closeNum) => {
    modal = document.getElementById(modalId);
    btn = document.getElementById(btnId);
    span = document.getElementsByClassName("close-about")[closeNum];

    modal.style.display = "block";
    console.log('fcn working')
    var mobileClose = document.getElementsByClassName("mobile-nav-panel")[0];
    console.log(mobileClose);
    var backgroundBlur = document.getElementById("site-mobile-nav");
    backgroundBlur.setAttribute("data-open", "false");
    var overlay = document.getElementsByClassName("mobile-nav-overlay")[0];
    // overlay.setAttribute("data-animation-state", "closed");
    
    //mobileClose.style.transform = "translateX(-100%)";
    // mobileClose.setAttribute("data-animation-state", "closed")
    span.onclick = function() {
  modal.style.display = "none";
      
}
    
    

// When the user clicks anywhere outside of the modal, close it
window.onclick = function(event) {
  if (event.target == modal) {
    modal.style.display = "none";
  }
}
  }
</script>
