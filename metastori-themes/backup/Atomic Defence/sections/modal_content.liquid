<style>
    .modal-about {
  display: none; /* Hidden by default */
  position: fixed; /* Stay in place */
  z-index: 1; /* Sit on top */
  left: 0;
  top: 20%;
  width: 100%; /* Full width */
  height: 100%; /* Full height */
  overflow: auto; /* Enable scroll if needed */
  background-color: rgb(0,0,0); /* Fallback color */
  background-color: rgba(0,0,0,0.4); /* Black w/ opacity */
}

/* Modal Content/Box */
.modal-content-about {
  background-color: #fefefe;
  margin: 15% auto; /* 15% from the top and centered */
  padding: 20px;
  border: 1px solid #888;
  width: 60%; /* Could be more or less, depending on screen size */
  border-radius: 15px;
}

/* The Close Button */
.close-about {
  color: #aaa;
  float: right;
  font-size: 28px;
  font-weight: bold;
}

.close-about:hover,
.close-about:focus {
  color: black;
  text-decoration: none;
  cursor: pointer;
}
  .about-container {
    /* text-align: center;
    max-width: 1200px;
    margin-right: auto;
    margin-left: auto;
    padding-left: 25px;
    padding-right: 25px; */
    max-width: 1200px;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    margin-right: auto;
    margin-left: auto;
  }
  .about-img {
    max-height: 400px;
    width: 1150px;
    object-fit: cover;
  }
  .about-btn {
    border-radius: 25px;
    background-color: #EEEEEE;
    border: 0;
    cursor: pointer;
    width: 100%;
  }
  .map-container {
    background-color: #EEEEEE;
    border-radius: 15px;
    width: 1150px;
  }
  .inner-container {
    display: flex;
    justify-content: center;
    align-items: center;
    width:100%;
    margin-left: 1rem;
  margin-right: 1rem;
  }
</style>
