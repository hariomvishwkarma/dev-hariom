{%- comment -%}
  FEATURED COLLECTIONS — met:
  - Toggle voor header (titel + "Alles bekijken"-knop)
  - Per-product labels via blokken (product-picker) i.p.v. positie-index
  - Zelfde kaart-UI als custom collection: 1:1 beeld, hover-swap, quick-add, ratings, highlights
  - Metavelden: custom.show_quick_add, custom.show_rating, custom.highlights, custom.highlights_title
  - Wijziging: oude prijs (compare-at) kleur #CE7A56
{%- endcomment -%}

{%- assign collection_blocks = section.blocks | where: 'type', 'collection' -%}
{%- assign product_label_blocks = section.blocks | where: 'type', 'product_label' -%}

{%- if collection_blocks.size > 0 -%}
  <style>
    #shopify-section-{{ section.id }}{
      /* Quick-add kleuren */
      --qa-bg: {{ section.settings.quick_add_bg | default: '#4F6B62' }};
      --qa-text: {{ section.settings.quick_add_text | default: '#ffffff' }};
      --qa-border: {{ section.settings.quick_add_border | default: 'rgba(0,0,0,.10)' }};
      --qa-hover-bg: {{ section.settings.quick_add_hover_bg | default: '#5A776D' }};
      --qa-success-bg: {{ section.settings.quick_add_success_bg | default: '#e8f8ee' }};
      /* kolommen: mobiel altijd 1 */
      --product-list-column-count: {{ section.settings.products_per_row_mobile | times: 1 }};
    }
    @media (max-width:699px){ #shopify-section-{{ section.id }}{ --product-list-column-count: {{ section.settings.products_per_row_mobile | times: 1 }} !important; } }
    @media (min-width:700px){ #shopify-section-{{ section.id }}{ --product-list-column-count: {{ section.settings.products_per_row_desktop | at_most: 3 }}; } }
    @media (min-width:1000px){ #shopify-section-{{ section.id }}{ --product-list-column-count: {{ section.settings.products_per_row_desktop }}; } }

    /* grid in container */
    #shopify-section-{{ section.id }} .tw-grid-wrap{ width:100%; }
    #shopify-section-{{ section.id }} .tw-collection__grid{
      list-style:none; margin:0; padding:0;
      display:grid; gap:28px;
      grid-template-columns: repeat(var(--product-list-column-count), minmax(0,1fr));
    }

    /* kaart + media (1:1) */
    #shopify-section-{{ section.id }} .tw-card{ display:flex; flex-direction:column; }
    #shopify-section-{{ section.id }} .tw-media{
      position:relative; overflow:hidden; border-radius:12px; background:#f7f7f7; aspect-ratio:1/1;
    }
    #shopify-section-{{ section.id }} .tw-img{
      position:absolute; inset:0; width:100%; height:100%; object-fit:cover; display:block;
      transition:opacity .3s ease, transform .35s ease;
    }
    #shopify-section-{{ section.id }} .tw-img--secondary{ opacity:0; }
    #shopify-section-{{ section.id }} .tw-card:hover .tw-img{ transform:scale(1.02); }
    #shopify-section-{{ section.id }} .tw-card:hover .tw-img--secondary{ opacity:1; }
    #shopify-section-{{ section.id }} .tw-img--ph{ background:#f2f2f2; }

    /* badges (meerdere per product, linksboven) */
    #shopify-section-{{ section.id }} .tw-badges{
      position:absolute; top:12px; left:12px; z-index:3;
      display:flex; flex-direction:column; gap:6px;
    }
    #shopify-section-{{ section.id }} .tw-badge{
      display:inline-block; padding:6px 12px; line-height:1; font-weight:700; letter-spacing:.01em;
      border-radius:12px;
    }

    /* rating (Loox) */
    #shopify-section-{{ section.id }} .tw-rating-row{ margin-top:.7rem; margin-bottom:.15rem; min-height:22px; }
    #shopify-section-{{ section.id }} .loox-rating{ display:inline-flex; align-items:center; gap:6px; }
    #shopify-section-{{ section.id }} .loox-rating svg,
    #shopify-section-{{ section.id }} .loox-icon,
    #shopify-section-{{ section.id }} .loox-icon-star,
    #shopify-section-{{ section.id }} .loox-icon-star-half,
    #shopify-section-{{ section.id }} .loox-icon-star-o{
      width:12px !important; height:12px !important; font-size:12px !important;
      color:#FDB32E !important; fill:#FDB32E !important;
    }

    /* prijsrijen */
    #shopify-section-{{ section.id }} .tw-top-row{
      display:flex; align-items:center; justify-content:space-between; gap:.75rem;
      margin-top:.7rem; margin-bottom:.15rem;
    }
    #shopify-section-{{ section.id }} .tw-info-row{
      display:flex; align-items:flex-end; justify-content:space-between; gap:12px; margin-top:.35rem;
    }
    #shopify-section-{{ section.id }} .tw-info-left{ min-width:0; flex:1 1 auto; }
    #shopify-section-{{ section.id }} .tw-card-title.subheading{
      display:block; margin:0 0 .25rem 0; line-height:1.3; font-size:16px; font-weight:600; text-decoration:none;
    }
    #shopify-section-{{ section.id }} .tw-price{
      display:inline-flex; gap:.5rem; align-items:baseline; white-space:nowrap; font-size:16px; line-height:1;
    }
    #shopify-section-{{ section.id }} .tw-price__current{ font-weight:700; }

    /* >>> Oude prijs (compare-at) in sale-kleur <<< */
    #shopify-section-{{ section.id }} .tw-price__compare{
      color:#CE7A56;
      text-decoration:line-through;
    }

    /* quick add */
    #shopify-section-{{ section.id }} .tw-info-right{ flex:0 0 auto; }
    #shopify-section-{{ section.id }} .tw-btn{
      display:inline-flex; align-items:center; gap:.55rem;
      padding:.55rem .9rem; border-radius:999px; border:1px solid var(--qa-border);
      background:var(--qa-bg); color:var(--qa-text); font-weight:600; line-height:1; cursor:pointer;
      transition:background .2s ease, border-color .2s ease, transform .05s ease; white-space:nowrap;
    }
    #shopify-section-{{ section.id }} .tw-btn:hover{ background:var(--qa-hover-bg); }
    #shopify-section-{{ section.id }} .tw-btn[disabled]{ opacity:.6; cursor:not-allowed; }
    #shopify-section-{{ section.id }} .tw-btn--success{ background:var(--qa-success-bg); }
    #shopify-section-{{ section.id }} .tw-btn svg{ width:18px; height:18px; display:block; }
    #shopify-section-{{ section.id }} .tw-plus{
      font-family: var(--font-body-family, inherit) !important;
      font-weight: var(--font-body-weight, 700);
      font-style: var(--font-body-style, normal);
      font-size: 18px; line-height: 1;
    }

    .sr-only{ position:absolute !important; width:1px; height:1px; padding:0; margin:-1px; overflow:hidden; clip:rect(0,0,0,0); white-space:nowrap; border:0; }

    /* dropdown (highlights) */
    #shopify-section-{{ section.id }} .tw-acc{ margin-top:.5rem; border-radius:10px; }
    #shopify-section-{{ section.id }} .tw-acc__summary{
      list-style:none; cursor:pointer; user-select:none;
      display:flex; align-items:center; justify-content:space-between; gap:.5rem;
      font-weight:600; font-size:14px; letter-spacing:.02em;
    }
    #shopify-section-{{ section.id }} .tw-acc__summary::-webkit-details-marker{ display:none; }
    #shopify-section-{{ section.id }} .tw-acc__icon{ width:20px; height:20px; position:relative; flex:0 0 20px; }
    #shopify-section-{{ section.id }} .tw-acc__icon::before,
    #shopify-section-{{ section.id }} .tw-acc__icon::after{ content:""; position:absolute; inset:0; margin:auto; background:currentColor; width:14px; height:2px; border-radius:2px; }
    #shopify-section-{{ section.id }} .tw-acc__icon::after{ transform:rotate(90deg); transition:transform .2s ease; }
    #shopify-section-{{ section.id }} details[open] .tw-acc__icon::after{ transform:rotate(0deg); }
    #shopify-section-{{ section.id }} .tw-acc__content{ margin-top:.35rem; font-size:14px; opacity:.92; }
    #shopify-section-{{ section.id }} .tw-acc__content p{ margin:.3rem 0; }
    @media (max-width: 749px){
      #shopify-section-{{ section.id }} ul.tw-collection__grid.fc-mobile_slider {
          display: flex !important;
          overflow-x: scroll;
          scrollbar-width: none;
          -ms-overflow-style: none;
      }
      #shopify-section-{{ section.id }} ul.tw-collection__grid.fc-mobile_slider::-webkit-scrollbar {
          display: none;
      }
      #shopify-section-{{ section.id }} ul.tw-collection__grid.fc-mobile_slider li.tw-card {
          min-width: 230px;
      }
    }
  </style>

  <div class="color-scheme color-scheme--{{ section.settings.color_scheme.id }}">
    <div class="container section-spacing">

      {%- liquid
        assign has_at_least_one_description = false
        for block in collection_blocks
          if block.settings.content != blank
            assign has_at_least_one_description = true
            break
          endif
        endfor
      -%}

      <div class="v-stack {% if has_at_least_one_description %}gap-4{% else %}gap-8 sm:gap-10{% endif %}">
        {%- if section.settings.show_header -%}
        <div class="featured-collections-header">
          <featured-collections-tabs role="tablist" class="featured-collections-header__tab-list {% if section.settings.tabs_alignment == 'center' %}justify-center{% endif %} scroll-area bleed">
            <template shadowrootmode="open">
              <slot part="tab-list" name="tab"></slot>
            </template>

            {%- for block in collection_blocks -%}
              {%- capture tab_title -%}
                {%- if section.settings.tabs_icon == 'arrow' -%}
                  {%- render 'icon' with 'big-arrow-right', stroke_width: 3, direction_aware: true -%}
                {%- endif -%}
                <span {% if collection_blocks.size == 1 and section.settings.tabs_alignment == 'center' %}class="text-center"{% endif %}>
                  {{- block.settings.title | default: block.settings.collection.title | default: 'Collection' -}}
                </span>
              {%- endcapture -%}

              {%- if collection_blocks.size > 1 -%}
                <button class="{% if section.settings.tabs_icon != 'none' %}text-indent text-indent--{{ section.settings.tabs_icon }}{% endif %} h4 sm:h3"
                        role="tab" slot="tab" aria-controls="collection-{{ block.id }}"
                        aria-selected="{% if forloop.first %}true{% else %}false{% endif %}"
                        {{ block.shopify_attributes }}>
                  {{- tab_title -}}
                </button>
              {%- else -%}
                <div class="{% if section.settings.tabs_icon != 'none' %}text-indent text-indent--{{ section.settings.tabs_icon }}{% endif %} h4 sm:h3"
                     role="tab" slot="tab" aria-selected="true" {{ block.shopify_attributes }}>
                  {{- tab_title -}}
                </div>
              {%- endif -%}
            {%- endfor -%}
          </featured-collections-tabs>

          {%- if section.settings.show_view_all_button and has_at_least_one_description == false and section.settings.tabs_alignment != 'center' -%}
            {%- assign view_all_button = 'sections.featured_collections.view_all' | t -%}
            {%- render 'button', content: view_all_button, href: collection_blocks.first.settings.link, style: 'outline', class: 'md-max:hidden' -%}
          {%- endif -%}
        </div>
        {%- endif -%}

        <div class="featured-collections-products">
          {%- for block in collection_blocks -%}
            <div id="collection-{{ block.id }}" data-url="{{ block.settings.link | escape }}"
                 class="v-stack {% if section.settings.tabs_alignment == 'center' %}justify-items-center{% endif %} gap-8 sm:gap-12"
                 {% unless forloop.first %}hidden{% endunless %}>

              {%- liquid
                assign show_content = false
                if section.settings.tabs_alignment == 'center' and block.settings.content != blank
                  assign show_content = true
                elsif section.settings.tabs_alignment == 'start' and has_at_least_one_description
                  assign show_content = true
                endif
              -%}

              {%- if show_content or section.settings.show_view_all_button -%}
                {%- assign view_all_button = 'sections.featured_collections.view_all' | t -%}
                {%- if section.settings.tabs_alignment == 'center' -%}
                  <div class="prose prose-justify-center max-w-md">
                    {{- block.settings.content -}}
                    {%- if section.settings.show_view_all_button -%}
                      {%- render 'button', content: view_all_button, href: block.settings.link, style: 'outline' -%}
                    {%- endif -%}
                  </div>
                {%- else -%}
                  <div class="h-stack wrap gap-6 justify-between">
                    {%- assign button_class = 'md:hidden' -%}
                    {%- if has_at_least_one_description -%}{% assign button_class = '' %}{%- endif -%}
                    {%- if block.settings.content != blank -%}
                      <div class="prose max-w-md">{{- block.settings.content -}}</div>
                    {%- endif -%}
                    {%- if section.settings.show_view_all_button -%}
                      {%- render 'button', content: view_all_button, href: block.settings.link, style: 'outline', class: button_class -%}
                    {%- endif -%}
                  </div>
                {%- endif -%}
              {%- endif -%}

              <div class="tw-grid-wrap w-full">
                <ul class="tw-collection__grid{% if section.settings.mobile_slider == true %} fc-mobile_slider{% endif %}" role="list">
                  {%- if block.settings.collection != blank -%}
                    {%- for product in block.settings.collection.products limit: block.settings.products_count -%}
                      {%- assign has_second = false -%}
                      {%- if product.images.size > 1 -%}{% assign has_second = true %}{% endif %}

                      {%- assign show_quick_add = product.metafields.custom.show_quick_add -%}
                      {%- assign show_rating    = product.metafields.custom.show_rating -%}
                      {%- assign hl_text  = product.metafields.custom.highlights -%}
                      {%- assign hl_title = product.metafields.custom.highlights_title -%}

                      {%- assign current_price = product.price | default: product.price_min -%}
                      {%- assign compare_max = product.compare_at_price_max -%}

                      <li class="tw-card" data-product-id="{{ product.id }}" {{ block.shopify_attributes }}>
                        <a href="{{ product.url | within: block.settings.collection }}" class="tw-media">
                          <div class="tw-badges">
                            {%- for lb in product_label_blocks -%}
                              {%- if lb.settings.product != blank and lb.settings.product.id == product.id -%}
                                <span class="tw-badge"
                                  style="
                                    background: {{ lb.settings.bg | default: '#E6F0D0' }};
                                    color: {{ lb.settings.color | default: '#1A1A1A' }};
                                    font-size: {{ lb.settings.size | default: 12 }}px;
                                    border-radius: {{ lb.settings.radius | default: 12 }}px;
                                  "
                                  {{ lb.shopify_attributes }}
                                >{{ lb.settings.text | escape }}</span>
                              {%- endif -%}
                            {%- endfor -%}
                          </div>

                          {%- if product.featured_media -%}
                            {%- assign img = product.featured_media -%}
                            {%- assign widths = "360,540,720,900,1200" | split: "," -%}
                            <img class="tw-img tw-img--primary"
                                 src="{{ img | image_url: width: 720 }}"
                                 srcset="{% for w in widths %}{{ img | image_url: width: w | strip }} {{ w }}w{% unless forloop.last %}, {% endunless %}{% endfor %}"
                                 sizes="(min-width: 1000px) 25vw, (min-width: 700px) 33vw, 100vw"
                                 alt="{{ img.alt | escape }}" loading="lazy">
                            {%- if has_second -%}
                              {%- assign second_image = product.images[1] -%}
                              <img class="tw-img tw-img--secondary"
                                   src="{{ second_image | image_url: width: 720 }}"
                                   srcset="{% for w in widths %}{{ second_image | image_url: width: w | strip }} {{ w }}w{% unless forloop.last %}, {% endunless %}{% endfor %}"
                                   sizes="(min-width: 1000px) 25vw, (min-width: 700px) 33vw, 100vw"
                                   alt="{{ second_image.alt | escape }}" loading="lazy">
                            {%- endif -%}
                          {%- else -%}
                            {{ 'product-1' | placeholder_svg_tag: 'tw-img tw-img--primary tw-img--ph' }}
                          {%- endif -%}
                        </a>

                        {%- if hl_text and hl_text != blank -%}
                          <div class="tw-top-row">
                            <div>
                              {%- if show_rating != false -%}
                                {%- assign loox_rating = product.metafields.loox.avg_rating
                                  | default: product.metafields.loox.rating
                                  | default: product.metafields.reviews.rating
                                  | default: product.metafields.reviews.rating.value -%}
                                {%- assign loox_count  = product.metafields.loox.num_reviews
                                  | default: product.metafields.loox.reviews_count
                                  | default: product.metafields.reviews.rating_count
                                  | default: product.metafields.reviews.rating_count.value -%}
                                <div class="loox-rating"
                                      data-id="{{ product.id }}"
                                      {% if loox_rating != blank %}data-rating="{{ loox_rating }}"{% endif %}
                                      {% if loox_count  != blank %}data-raters="{{ loox_count }}"{% endif %}>
                                </div>
                              {%- endif -%}
                            </div>
                            <div class="tw-price">
                              <span class="tw-price__current">{{ current_price | money }}</span>
                              {%- if compare_max > current_price -%}
                                <s class="tw-price__compare">{{ compare_max | money }}</s>
                              {%- endif -%}
                            </div>
                          </div>
                        {%- elsif show_rating != false -%}
                            {%- assign loox_rating = product.metafields.loox.avg_rating
                              | default: product.metafields.loox.rating
                              | default: product.metafields.reviews.rating
                              | default: product.metafields.reviews.rating.value -%}
                            {%- assign loox_count  = product.metafields.loox.num_reviews
                              | default: product.metafields.loox.reviews_count
                              | default: product.metafields.reviews.rating_count
                              | default: product.metafields.reviews.rating_count.value -%}
                            <div class="tw-rating-row">
                              <div class="loox-rating"
                                   data-id="{{ product.id }}"
                                   {% if loox_rating != blank %}data-rating="{{ loox_rating }}"{% endif %}
                                   {% if loox_count  != blank %}data-raters="{{ loox_count }}"{% endif %}>
                              </div>
                            </div>
                        {% else %}
                          <!-- TrustBox widget - Micro TrustScore -->
                          <div class="custom-cp-tp-wdgt">
                            <span>{{ settings.trustpilot_review }}</span>
                            <svg width="71" height="26" viewBox="0 0 71 26" fill="none" xmlns="http://www.w3.org/2000/svg">
