                        {%- endif -%}

                        <div class="tw-info-row">
                          <div class="tw-info-left">
                            <a class="tw-card-title subheading" href="{{ product.url | within: block.settings.collection }}">{{ product.title }}</a>

                            {%- unless hl_text and hl_text != blank -%}
                              <div class="tw-price">
                                <span class="tw-price__current">{{ current_price | money }}</span>
                                {%- if compare_max > current_price -%}
                                  <s class="tw-price__compare">{{ compare_max | money }}</s>
                                {%- endif -%}
                              </div>
                            {%- endunless -%}
                          </div>

                          <div class="tw-info-right">
                            {%- if show_quick_add == true and product.available -%}
                              <form class="tw-quick-add" method="post" action="/cart/add">
                                <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">
                                <input type="hidden" name="quantity" value="1">
                                <button type="submit" class="tw-btn" aria-label="{{ section.settings.quick_add_label | escape }} — {{ product.title | escape }}">
                                  <span class="sr-only">{{ section.settings.quick_add_label }}</span>
                                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                    <circle cx="9" cy="20" r="1"></circle>
                                    <circle cx="16" cy="20" r="1"></circle>
                                    <path d="M1 1h4l2.4 12.3a2 2 0 0 0 2 1.7h7.9a2 2 0 0 0 2-1.6l1.2-6.4H6.5"></path>
                                  </svg>
                                  <span class="tw-plus" aria-hidden="true">+</span>
                                </button>
                              </form>
                            {%- endif -%}
                          </div>
                        </div>

                        {%- if hl_text and hl_text != blank -%}
                          <details class="tw-acc" {% if section.settings.dropdown_open %}open{% endif %}>
                            <summary class="tw-acc__summary">
                              <span>{{ hl_title | default: section.settings.dropdown_title }}</span>
                              <span class="tw-acc__icon" aria-hidden="true"></span>
                            </summary>
                            <div class="tw-acc__content">
                              {{ hl_text | metafield_tag }}
                            </div>
                          </details>
                        {%- endif -%}
                      </li>
                    {%- endfor -%}
                  {%- else -%}
                    {%- for i in (1..4) -%}
                      <li class="tw-card"><div class="tw-media">{{ 'product-1' | placeholder_svg_tag: 'tw-img tw-img--primary tw-img--ph' }}</div></li>
                    {%- endfor -%}
                  {%- endif -%}
                </ul>
              </div>
            </div>
          {%- endfor -%}
        </div>
      </div>
    </div>
  </div>

  <script>
    (function(){
      const root = document.getElementById('shopify-section-{{ section.id }}');
      if(!root) return;

      function openCartDrawerAndHold(){
        try {
          document.dispatchEvent(new CustomEvent('cart:open', {bubbles:true}));
          const drawer = document.querySelector('cart-drawer');
          if (drawer) {
            if (typeof drawer.open === 'function') drawer.open();
            drawer.setAttribute('open','');
            drawer.classList.add('is-open','open','active','visible');
            drawer.setAttribute('data-force-open','true');
            const closeBtns = drawer.querySelectorAll('[data-action="close"],[aria-label*="close"],button.close,.cart-drawer__close');
            closeBtns.forEach(btn=>{
              btn.addEventListener('click', (e)=>{
                if(drawer.getAttribute('data-force-open') === 'true'){
                  e.preventDefault();
                  drawer.setAttribute('open','');
                  drawer.classList.add('is-open','open','active','visible');
                }
              });
            });
            return;
          }
          const notif = document.querySelector('cart-notification, cart-notification-drawer, mini-cart, cart-sidebar');
          if (notif) {
            if (typeof notif.open === 'function') notif.open();
            notif.classList.add('is-open','open','active','visible');
            notif.setAttribute('open','');
            return;
          }
          const toggler = document.querySelector('[data-action="open-cart"],[aria-controls*="cart"],a[href="#cart"],.header__cart-toggle,.js-cart-toggle');
          if (toggler) toggler.dispatchEvent(new Event('click', {bubbles:true}));
        } catch(e) {}
      }

      root.addEventListener('submit', async function(ev){
        const form = ev.target;
        if(!form.classList.contains('tw-quick-add')) return;
        ev.preventDefault();
        const btn = form.querySelector('button');
        btn.disabled = true; btn.classList.remove('tw-btn--success');
        try{
          const res = await fetch('/cart/add.js', { method: 'POST', body: new FormData(form), headers: { 'Accept': 'application/json' } });
          if(!res.ok) throw 0;
          btn.classList.add('tw-btn--success');
          document.dispatchEvent(new CustomEvent('cart:refresh', {bubbles:true}));
          openCartDrawerAndHold();
          setTimeout(()=>{ btn.disabled=false; }, 900);
        } catch(e){ btn.disabled=false; }
      }, {passive:false});
    })();
  </script>
{%- endif -%}

{% schema %}
{
  "name": "t:sections.featured_collections.name",
  "class": "shopify-section--featured-collections",
  "max_blocks": 80,
  "tag": "section",
  "disabled_on": {
    "templates": ["password"],
    "groups": ["header", "custom.overlay"]
  },
  "settings": [
    { "type": "color_scheme", "id": "color_scheme", "label": "t:global.colors.scheme", "default": "scheme-1" },

    { "type": "checkbox", "id": "show_header", "label": "Kop (titel + knop) tonen", "default": true },

    { "type": "range", "id": "products_per_row_mobile", "label": "t:global.product_list.products_per_row_mobile", "min": 1, "max": 3, "default": 1 },
    { "type": "range", "id": "products_per_row_desktop", "label": "t:global.product_list.products_per_row_desktop", "min": 1, "max": 5, "default": 4 },

    { "type": "select", "id": "tabs_alignment", "label": "t:sections.featured_collections.tabs_alignment", "options": [
      { "value": "start", "label": "t:global.position.left" },
      { "value": "center", "label": "t:global.position.center" }
    ], "default": "start" },
    { "type": "select", "id": "tabs_icon", "label": "t:sections.featured_collections.tabs_icon", "options": [
      { "value": "none", "label": "t:sections.featured_collections.tabs_icon_options.none" },
      { "value": "arrow", "label": "t:sections.featured_collections.tabs_icon_options.arrow" },
      { "value": "circle", "label": "t:sections.featured_collections.tabs_icon_options.circle" },
      { "value": "square", "label": "t:sections.featured_collections.tabs_icon_options.square" },
      { "value": "diamond", "label": "t:sections.featured_collections.tabs_icon_options.diamond" }
    ], "default": "arrow" },
    { "type": "checkbox", "id": "show_view_all_button", "label": "t:sections.featured_collections.show_view_all_button", "default": true },
    { "type": "checkbox", "id": "mobile_slider", "label": "Show mobile slider", "default": false },
    { "type": "header", "content": "Quick-add" },
    { "type": "text", "id": "quick_add_label", "label": "Verborgen label (screen readers)", "default": "Toevoegen aan winkelmand" },
    { "type": "color", "id": "quick_add_bg", "label": "Achtergrond", "default": "#4F6B62" },
    { "type": "color", "id": "quick_add_text", "label": "Icoon/plus kleur", "default": "#ffffff" },
    { "type": "color", "id": "quick_add_border", "label": "Randkleur", "default": "#0000001A" },
    { "type": "color", "id": "quick_add_hover_bg", "label": "Hover-achtergrond", "default": "#5A776D" },
    { "type": "color", "id": "quick_add_success_bg", "label": "Achtergrond na toevoegen", "default": "#e8f8ee" },

    { "type": "header", "content": "Dropdown (highlights)" },
    { "type": "text", "id": "dropdown_title", "label": "Standaard titel", "default": "VOORDELEN" },
    { "type": "checkbox", "id": "dropdown_open", "label": "Dropdown standaard geopend", "default": false }
  ],
  "blocks": [
    {
      "type": "collection",
      "name": "t:sections.featured_collections.blocks.collection.name",
      "settings": [
        { "type": "collection", "id": "collection", "label": "t:sections.featured_collections.blocks.collection.collection" },
        { "type": "range", "id": "products_count", "min": 2, "max": 50, "label": "t:global.product_list.products_to_show", "default": 8 },
        { "type": "text", "id": "title", "label": "t:global.text.title", "default": "{{ block.settings.collection.title }}" },
        { "type": "richtext", "id": "content", "label": "t:global.text.content", "default": "<p>{{ block.settings.collection.description }}</p>" },
        { "type": "url", "id": "link", "label": "t:global.text.link_url", "default": "{{ block.settings.collection.url }}" }
      ]
    },
    {
      "type": "product_label",
      "name": "Productlabel",
      "settings": [
        { "type": "product", "id": "product", "label": "Product" },
        { "type": "text", "id": "text", "label": "Tekst", "default": "SALE" },
        { "type": "color", "id": "color", "label": "Tekstkleur", "default": "#1A1A1A" },
        { "type": "color", "id": "bg", "label": "Achtergrondkleur", "default": "#E6F0D0" },
        { "type": "range", "id": "size", "label": "Tekstgrootte (px)", "min": 10, "max": 28, "step": 1, "default": 12 },
        { "type": "range", "id": "radius", "label": "Border radius (px)", "min": 0, "max": 28, "step": 1, "default": 12 }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:sections.featured_collections.name",
      "blocks": [
        { "type": "collection" }
      ]
    }
  ]
}
{% endschema %}
