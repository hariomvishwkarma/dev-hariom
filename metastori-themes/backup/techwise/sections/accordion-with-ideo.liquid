    },
    {
      "type": "richtext",
      "id": "description",
      "label": "Description"
    }
  ],
  "blocks": [
    {
      "type": "accordion_item",
      "name": "Accordion Item",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Kills 99.9% of bacteria & viruses*"
        },
        {
          "type": "inline_richtext",
          "id": "description",
          "label": "Description",
          "default": "Clean any surfaces without added chemicals."
        },
        {
          "type": "video",
          "id": "video",
          "label": "Video"
        },
        {
          "type": "range",
          "id": "progress_duration",
          "label": "Progress Duration (seconds)",
          "min": 3,
          "max": 10,
          "step": 1,
          "unit": "s",
          "default": 5
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Video Accordion",
      "blocks": [
        {
