            "progress_duration": 5
          }
        },
        {
          "type": "accordion_item",
          "settings": {
            "title": "Don't wait to refill",
            "description": "Easy refilling system.",
            "progress_duration": 5
          }
        },
        {
          "type": "accordion_item",
          "settings": {
