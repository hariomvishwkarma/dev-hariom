{% comment %}
  Hero Banner Section — Reusable full-width hero with:
  - Left: bg color, promo image, copy, Trustpilot widget, USPs
  - Right: large background image + optional badge overlay
{% endcomment %}
<style>
    #hero-banner-{{ section.id }} {
        --left-bg:    {{ section.settings.left_bg_color }};
        --left-text:  {{ section.settings.left_text_color }};
        padding-top: {{ section.settings.padding_top }}px;
        padding-bottom: {{ section.settings.padding_bottom }}px;
    }

    /* Wrapper */
    .hero-banner__inner {
        display: grid;
        grid-template-columns: 1fr 1fr;
        min-height: calc(100vh - 200px);
    }

    /* ── Desktop image position ── */
    #hero-banner-{{ section.id }} .hero-banner__left  { order: var(--content-order-desktop); }
    #hero-banner-{{ section.id }} .hero-banner__right { order: var(--image-order-desktop); }

    /* ── LEFT ── */
    .hero-banner__left {
        background: var(--left-bg);
        color: var(--left-text);
        padding: 48px 56px;
        display: flex;
        justify-content: center;
        align-items: center;
    }
    .hero-banner__left-container {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        gap: 10px;
        text-align: center;
        max-width: 420px;
    }

    .hero-banner__promo-image img {
        max-width: 247px;
        width: 100%;
        height: auto;
        display: block;
    }

    .hero-banner__copy {
        font-size: 15px;
        line-height: 1.6;
        max-width: 440px;
        color: var(--left-text);
        margin-bottom: 14px;
    }
    .hero-banner__copy strong { font-weight: 700; }

    /* ── BADGE ── */
    .hero-banner__badge {
        position: absolute;
        display: flex;
        align-items: center;
        justify-content: center;
        width: {{ section.settings.badge_width }}px;
        height: auto;
        overflow: hidden;
        top: {{ section.settings.badge_top }}%;
        right: {{ section.settings.badge_right }}%;
        background: {{ section.settings.badge_bg_color }};
        color: {{ section.settings.badge_text_color }};
    }
    .hero-banner__badge img {
        width: 100%;
        height: 100%;
        object-fit: cover;
    }
    .hero-banner__badge-inner {
        font-size: 13px;
        font-weight: 700;
        text-align: center;
        line-height: 1.3;
        padding: 8px;
    }

    /* CTA */
    .hero-banner__cta {
        display: inline-block;
        padding: 0;
        border-radius: 40px;
        font-size: 15px;
        font-weight: 600;
        text-decoration: none;
        transition: opacity .2s, transform .15s;
        cursor: pointer;
        margin-bottom: 30px;
    }
    a.hero-banner__cta.button .button__content {
        padding: 12px 24px;
    }
    @media only screen and (max-width: 749px) { 
        a.hero-banner__cta.button .button__content {
            padding: 12px 24px;
            min-width: 241px;
        }
    }

    /* Trustpilot fallback */
    .hero-banner__trustpilot { display: flex; justify-content: center; }
    .hero-banner__trustpilot-fallback {
        display: flex;
        align-items: center;
        gap: 10px;
        flex-wrap: wrap;
        justify-content: center;
    }
    .hero-banner__tp-stars { display: flex; gap: 2px; }
    .hero-banner__tp-text { font-size: 14px; }
    .hero-banner__tp-text em { font-style: italic; }

    /* USPs */
    .hero-banner__usps {
        display: flex;
        flex-wrap: wrap;
        justify-content: center;
        gap: 10px;
        width: 100%;
        padding-top: 32px;
    }
    .hero-banner__usp {
        display: flex;
        align-items: center;
        gap: 8px;
        border: 1.5px solid;
        border-radius: 40px;
        padding: 10px 25px;
        font-size: 13px;
        white-space: nowrap;
        background-color: {{ section.settings.usp_bg_color }}
    }
    .hero-banner__usp-icon img {
        width: 18px;
        height: 18px;
        object-fit: contain;
    }
    .hero-banner__usp-icon--svg svg {
        width: 18px;
        height: 18px;
        display: block;
        fill: currentColor;
    }

    /* ── RIGHT ── */
    .hero-banner__right {
        position: relative;
        overflow: hidden;
        min-height: 480px;
    }
    .hero-banner__hero-img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        display: block;
    }

    
    /* ── VIDEO ── */
    .hero-banner__video {
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
        object-fit: cover;
        display: block;
    }

    /* ── MARQUEE — hidden on desktop ── */
    .hero-banner__marquee-wrap {
        display: none;
    }

  /* ── RESPONSIVE ── */
  @media (max-width: 768px) {
    #hero-banner-{{ section.id }} {
      padding-top: {{ section.settings.padding_top_mobile }}px;
      padding-bottom: {{ section.settings.padding_bottom_mobile }}px;
    }
    .hero-banner__inner {
      grid-template-columns: 1fr;
      /* on mobile: image first, left content second */
      grid-template-rows: auto auto;
    }

    /* Mobile image position (top/bottom) */
    #hero-banner-{{ section.id }} .hero-banner__right { order: var(--image-order-mobile); }
    #hero-banner-{{ section.id }} .hero-banner__left  { order: var(--content-order-mobile); }

    .hero-banner__left {
      padding: 64px 20px;
    }

    /* Hide static USP badges on mobile */
    .hero-banner__usps {
      display: none;
    }

    .hero-banner__right {
      min-height: 320px;
      position: relative;
    }

    /* ── Marquee bar — absolute, top of image ── */
    .hero-banner__marquee-wrap {
      display: block;
      position: absolute;
      top: 0;
      left: 0;
      width: 100%;
      z-index: 3;
      overflow: hidden;
      background: rgb(161 161 161 / 35%);
      backdrop-filter: blur(8px);
      -webkit-backdrop-filter: blur(4px);
      padding: 8px 0;
    }

    .hero-banner__marquee-track {
      display: flex;
      align-items: center;
      gap: 0;
      width: max-content;
      animation: hero-marquee 18s linear infinite;
      white-space: nowrap;
    }

    .hero-banner__marquee-item {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      font-size: 12px;
      font-weight: 600;
      color: var(--marquee-text, #ffffff);
      padding: 0 16px;
      letter-spacing: 0.03em;
      text-transform: uppercase;
    }

    .hero-banner__marquee-icon img {
      width: 14px;
      height: 14px;
      object-fit: contain;
      filter: brightness(0) invert(1);
    }
    .hero-banner__marquee-icon--svg svg {
      width: 14px;
      height: 14px;
      display: block;
      fill: currentColor;
    }

    .hero-banner__marquee-sep {
      color: var(--marquee-text, #ffffff);
      opacity: 0.5;
      font-size: 10px;
    }

    @keyframes hero-marquee {
      0%   { transform: translateX(0); }
      100% { transform: translateX(-50%); }
    }
  }
</style>

<section
  id="hero-banner-{{ section.id }}"
  class="hero-banner"
  style="
    --left-bg: {{ section.settings.left_bg_color }};
    --left-text: {{ section.settings.left_text_color }};
    --marquee-text: {{ section.settings.marquee_text_color }};
    --content-order-desktop: {% if section.settings.image_position_desktop == 'left' %}2{% else %}1{% endif %};
    --image-order-desktop:   {% if section.settings.image_position_desktop == 'left' %}1{% else %}2{% endif %};
    --content-order-mobile:  {% if section.settings.image_position_mobile == 'top' %}2{% else %}1{% endif %};
    --image-order-mobile:    {% if section.settings.image_position_mobile == 'top' %}1{% else %}2{% endif %};
  "
>

  <div class="hero-banner__inner">
    <div class="hero-banner__left">
        <div class="hero-banner__left-container">
            {%- if section.settings.promo_image != blank -%}
                <div class="hero-banner__promo-image">
                {{
                    section.settings.promo_image
                    | image_url: width: 600
                    | image_tag: loading: 'eager', alt: section.settings.promo_image.alt
                }}
                </div>
            {%- endif -%}

            {%- if section.settings.copy_text != blank -%}
                <div class="hero-banner__copy">{{ section.settings.copy_text }}</div>
            {%- endif -%}

            {%- if section.settings.cta_label != blank -%}
                <a
                href="{{ section.settings.cta_url }}"
                class="hero-banner__cta button"
                style="background:{{ section.settings.cta_bg_color }};color:{{ section.settings.cta_text_color }};"
                >
                <button-content class="button__content notranslate" up-text="{{ section.settings.cta_label }}">
                {{ section.settings.cta_label }}
                </button-content>
                </a>
            {%- endif -%}

            {%- if section.settings.show_trustpilot -%}
                <div class="hero-banner__trustpilot">
                {%- if section.settings.trustpilot_widget_script != blank -%}
                    {{ section.settings.trustpilot_widget_script }}
                {%- else -%}
                    <div class="hero-banner__trustpilot-fallback">
                    <span class="hero-banner__tp-stars" aria-label="{{ section.settings.trustpilot_score }} out of 5 stars">
                        {%- assign full      = section.settings.trustpilot_score | floor -%}
                        {%- assign frac      = section.settings.trustpilot_score | modulo: 1 -%}
                        {%- assign full_next = full | plus: 1 -%}
                        {%- for i in (1..5) -%}
                        {%- if i <= full -%}
                            <svg class="tp-star tp-star--full" viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><polygon points="12,2 15.09,8.26 22,9.27 17,14.14 18.18,21.02 12,17.77 5.82,21.02 7,14.14 2,9.27 8.91,8.26" fill="#00b67a"/></svg>
                        {%- elsif frac >= 0.5 and i == full_next -%}
                            <svg class="tp-star tp-star--half" viewBox="0 0 24 24" width="20" height="20" aria-hidden="true">
                            <defs><linearGradient id="half-{{ section.id }}-{{ i }}"><stop offset="50%" stop-color="#00b67a"/><stop offset="50%" stop-color="#dcdce6"/></linearGradient></defs>
                            <polygon points="12,2 15.09,8.26 22,9.27 17,14.14 18.18,21.02 12,17.77 5.82,21.02 7,14.14 2,9.27 8.91,8.26" fill="url(#half-{{ section.id }}-{{ i }})"/>
                            </svg>
                        {%- else -%}
                            <svg class="tp-star tp-star--empty" viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><polygon points="12,2 15.09,8.26 22,9.27 17,14.14 18.18,21.02 12,17.77 5.82,21.02 7,14.14 2,9.27 8.91,8.26" fill="#dcdce6"/></svg>
                        {%- endif -%}
                        {%- endfor -%}
                    </span>
                    <span class="hero-banner__tp-text">
                        <strong>{{ section.settings.trustpilot_score }}/5</strong>
                        {{ section.settings.trustpilot_label | default: 'Based on' }}
                        <em>{{ section.settings.trustpilot_reviews }}</em>
                    </span>
                    </div>
                {%- endif -%}
                </div>
            {%- endif -%}

            {%- if section.blocks.size > 0 -%}
                <div class="hero-banner__usps">
                {%- for block in section.blocks -%}
                    {%- if block.type == 'usp' -%}
                    <div class="hero-banner__usp" {{ block.shopify_attributes }}
                        style="border-color:{{ section.settings.usp_border_color }};color:{{ section.settings.left_text_color }};">
                        {%- if block.settings.icon_svg != blank -%}
                        <span class="hero-banner__usp-icon hero-banner__usp-icon--svg">{{ block.settings.icon_svg }}</span>
                        {%- elsif block.settings.icon != blank -%}
                        <span class="hero-banner__usp-icon">
                            {{
                            block.settings.icon
                            | image_url: width: 40
                            | image_tag: loading: 'lazy', alt: ''
                            }}
                        </span>
                        {%- endif -%}
                        <span class="hero-banner__usp-label">{{ block.settings.label }}</span>
                    </div>
                    {%- endif -%}
                {%- endfor -%}
                </div>
            {%- endif -%}
        </div>
    </div>

    <div class="hero-banner__right">
      {%- if section.blocks.size > 0 -%}
        <div class="hero-banner__marquee-wrap">
          <div class="hero-banner__marquee-track">
            {%- comment -%} Duplicate for seamless loop {%- endcomment -%}
            {%- for n in (1..2) -%}
              {%- for block in section.blocks -%}
                {%- if block.type == 'usp' -%}
                  <span class="hero-banner__marquee-item">
                    {%- if block.settings.icon_svg != blank -%}
                      <span class="hero-banner__marquee-icon hero-banner__marquee-icon--svg">{{ block.settings.icon_svg }}</span>
                    {%- elsif block.settings.icon != blank -%}
                      <span class="hero-banner__marquee-icon">
                        {{
                          block.settings.icon
                          | image_url: width: 40
                          | image_tag: loading: 'lazy', alt: ''
                        }}
                      </span>
                    {%- endif -%}
                    {{ block.settings.label }}
                  </span>
                  <span class="hero-banner__marquee-sep" aria-hidden="true">✦</span>
                {%- endif -%}
              {%- endfor -%}
            {%- endfor -%}
          </div>
        </div>
      {%- endif -%}

      {%- if section.settings.hero_video != blank and section.settings.media_type == 'video' -%}
        {%- liquid
          if section.settings.hero_video != blank
            if section.settings.hero_video_autoplay
              assign show_controls = false
            else
              assign show_controls = true
            endif

            render 'media' with section.settings.hero_video, autoplay: section.settings.hero_video_autoplay, controls: show_controls, loop: section.settings.hero_video_autoplay, playsinline: section.settings.autoplay
          endif
        -%}
      {%- elsif section.settings.hero_image != blank -%}
        {%- comment -%} Fallback to image {%- endcomment -%}
        {{
          section.settings.hero_image
          | image_url: width: 1400
          | image_tag:
            loading: 'eager',
            class: 'hero-banner__hero-img',
            alt: section.settings.hero_image.alt
        }}
      {%- endif -%}
      {%- if section.settings.badge_image != blank or section.settings.badge_text != blank -%}
            <div class="hero-banner__badge">
            {%- if section.settings.badge_image != blank -%}
                {{
                section.settings.badge_image
                | image_url: width: 200
                | image_tag: loading: 'lazy', alt: section.settings.badge_alt
                }}
            {%- else -%}
                <span class="hero-banner__badge-inner">{{ section.settings.badge_text }}</span>
            {%- endif -%}
            </div>
        {%- endif -%}

    </div>
  </div>
</section>

{%- comment -%}──────────────── SCHEMA ────────────────{%- endcomment -%}
{% schema %}
{
  "name": "Hero Banner",
  "tag": "section",
  "class": "hero-banner-section",
  "settings": [
    {
      "type": "header",
      "content": "▶ Right Column"
    },
    {
      "type": "select",
      "id": "image_position_desktop",
      "label": "Media position — Desktop",
      "options": [
        { "value": "right", "label": "Right (content left)" },
        { "value": "left",  "label": "Left (content right)" }
      ],
      "default": "right"
    },
    {
      "type": "select",
      "id": "image_position_mobile",
      "label": "Media position — Mobile",
      "options": [
        { "value": "top",    "label": "Top (content below)" },
        { "value": "bottom", "label": "Bottom (content above)" }
      ],
      "default": "top"
    },
    {
      "type": "select",
      "id": "media_type",
      "label": "Hero media type",
      "options": [
        { "value": "image",    "label": "Image" },
        { "value": "video", "label": "Video" }
      ],
      "default": "image"
    },
    {
      "type": "image_picker",
      "id": "hero_image",
      "label": "Image",
      "visible_if": "{{ section.settings.media_type == 'image' }}"
    },
    {
      "type": "video",
      "id": "hero_video",
      "label": "Video",
      "visible_if": "{{ section.settings.media_type == 'video' }}"
    },
    {
      "type": "checkbox",
      "id": "hero_video_autoplay",
      "label": "Video autoplay",
      "default": true,
      "visible_if": "{{ section.settings.media_type == 'video' }}"
    },
    {
      "type": "header",
      "content": "🏅 Overlay Badge"
    },
    {
      "type": "image_picker",
      "id": "badge_image",
      "label": "Badge image",
      "info": "Upload a badge (e.g. award logo). Leave empty to use text badge."
    },
    {
      "type": "text",
      "id": "badge_alt",
      "label": "Badge image alt text"
    },
    {
      "type": "richtext",
      "id": "badge_text",
      "label": "Badge text (used when no image)",
      "default": "<p>Tot<br><strong>50%</strong><br>KORTING</p>"
    },
    {
      "type": "color",
      "id": "badge_bg_color",
      "label": "Badge background",
      "default": "#F5C842"
    },
    {
      "type": "color",
      "id": "badge_text_color",
      "label": "Badge text color",
      "default": "#1a1a1a"
    },
    {
      "type": "range",
      "id": "badge_width",
      "label": "Badge width (px)",
      "min": 50,
      "max": 200,
      "step": 5,
      "default": 100
    },
    {
      "type": "range",
      "id": "badge_top",
      "label": "Badge position — top (%)",
      "min": 2,
      "max": 80,
      "step": 1,
      "default": 10
    },
    {
      "type": "range",
      "id": "badge_right",
      "label": "Badge position — right (%)",
      "min": 2,
      "max": 60,
      "step": 1,
      "default": 8
    },
    {
      "type": "header",
      "content": "◀ Left Column"
    },
    {
      "type": "color",
      "id": "left_bg_color",
      "label": "Left background color",
      "default": "#F5F0EB"
    },
    {
      "type": "color",
      "id": "left_text_color",
      "label": "Left text color",
      "default": "#1a1a1a"
    },
    {
      "type": "image_picker",
      "id": "promo_image",
      "label": "Headline / promo image",
      "info": "Upload a stylised headline image (e.g. 'Verjaardags Sale'). Recommended width: 600px."
    },
    {
      "type": "richtext",
      "id": "copy_text",
      "label": "Body copy",
      "default": "<p>We bestaan 5 jaar en dat vieren we groots. Profiteer nu tijdelijk <strong>tot 50% korting</strong> op onze bestsellers en upgrade je nachtrust met exclusieve verjaardagsdeals.</p>"
    },
    {
      "type": "header",
      "content": "CTA Button"
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "Button label",
      "default": "Shop nu"
    },
    {
      "type": "url",
      "id": "cta_url",
      "label": "Button URL"
    },
    {
      "type": "color",
      "id": "cta_bg_color",
      "label": "Button background",
      "default": "#F07030"
    },
    {
      "type": "color",
      "id": "cta_text_color",
      "label": "Button text",
      "default": "#ffffff"
    },

    {
      "type": "header",
      "content": "⭐ Trustpilot"
    },
    {
      "type": "checkbox",
      "id": "show_trustpilot",
      "label": "Show Trustpilot widget",
      "default": true
    },
    {
      "type": "html",
      "id": "trustpilot_widget_script",
      "label": "Trustpilot embed HTML",
      "info": "Paste your Trustpilot widget embed code here. If left empty, the static fallback below is used."
    },
    {
      "type": "text",
      "id": "trustpilot_score",
      "label": "Score (fallback)",
      "default": "4.5",
      "info": "Shown when no embed code is provided"
    },
    {
      "type": "text",
      "id": "trustpilot_reviews",
      "label": "Review count text (fallback)",
      "default": "31.260 reviews"
    },
    {
      "type": "text",
      "id": "trustpilot_label",
      "label": "Label before count (fallback)",
      "default": "Gebaseerd op"
    },
    {
      "type": "header",
      "content": "USP Badges"
    },
    {
      "type": "color",
      "id": "usp_border_color",
      "label": "USP badge border color (desktop)",
      "default": "#cccccc"
    },
    {
        "type": "color",
        "id": "usp_bg_color",
        "label": "USP BG color",
        "default": "#ffffff"
    },
    {
      "type": "header",
      "content": "📱 Mobile Marquee"
    },
    {
      "type": "color",
      "id": "marquee_text_color",
      "label": "Marquee text",
      "default": "#ffffff"
    },
    {
      "type": "header",
      "content": "↕ Section Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding top — Desktop",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding bottom — Desktop",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "label": "Padding top — Mobile",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "label": "Padding bottom — Mobile",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "default": 0
    }
  ],

  "blocks": [
    {
      "type": "usp",
      "name": "USP Badge",
      "limit": 6,
      "settings": [
        {
          "type": "image_picker",
          "id": "icon",
          "label": "Icon image",
          "info": "Use either this OR the SVG field below — not both."
        },
        {
          "type": "html",
          "id": "icon_svg",
          "label": "Icon SVG code",
          "info": "Paste a raw <svg>...</svg> snippet. Takes priority over image if both are set."
        },
        {
          "type": "text",
          "id": "label",
          "label": "USP text",
          "default": "USP label"
        }
      ]
    }
  ],

  "presets": [
    {
      "name": "Hero Banner",
      "blocks": [
