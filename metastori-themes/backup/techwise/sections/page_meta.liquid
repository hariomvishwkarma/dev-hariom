

<div class="{% if section.settings.include_margins %}page-width{% endif %}{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}">
<div>
    {% assign bussiness_units = '' %}
    {% assign meta_main  = shop.metaobjects['vacancy_post'] %}
    {% for item in meta_main.values %}
      {% unless bussiness_units contains item.bussiness_unit %}
        {% assign bussiness_units = bussiness_units | append:item.bussiness_unit | append:'||' %}
      {% endunless %}
    {% endfor %}

    {% assign bussiness_units = bussiness_units | split:'||' %}
    
    {% for bussiness in bussiness_units %}
        {{ bussiness }}
        <br>
        <ul>
            {% for child in meta_main.values %}
                {%  if child.bussiness_unit == bussiness %}
                    <li>
                        {{ child.heading }}
                        {{ child.subheading }}
                        {{ child.contract_type }}
                    </li>
                {% endif %}
            {% endfor %}
        </ul>
      {% endfor %}
    
    </div>
</div>

{% schema %}
{
  "name": "Page Meta",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "checkbox",
      "id": "include_margins",
      "default": true,
      "label": "t:sections.apps.settings.include_margins.label"
    }
  ],
  "blocks": [
    {
      "type": "@app"
    }
  ],
  "presets": [
    {
      "name": "Page Meta"
    }
  ]
}
{% endschema %}
