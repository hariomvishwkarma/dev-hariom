            "liquid_jfry4h": {
              "type": "liquid",
              "name": "t:blocks.liquid.name",
              "settings": {
                "liquid": "<style>\n  /* --- Container met playknop --- */\n  .cf-video-wrapper {\n    position: relative;\n    width: 100%;\n    aspect-ratio: 16/9;\n    background: rgba(0, 0, 0, 0.0);\n    border-radius: 12px;\n    overflow: hidden;\n    cursor: pointer;\n  }\n\n  /* --- De ronde transparante playknop --- */\n  .cf-play-btn {\n    position: absolute;\n    top: 50%;\n    left: 50%;\n    transform: translate(-50%, -50%);\n    background: rgba(0, 0, 0, 0.6);\n    border: 2px solid rgba(255, 255, 255, 0.8);\n    border-radius: 50%;\n    width: 60px;\n    height: 60px;\n    color: #fff;\n    font-size: 22px;\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    transition: all 0.3s ease;\n    box-shadow: 0 0 0 0 rgba(255,255,255,0.5);\n    animation: pulse 2s infinite;\n    z-index: 2;\n  }\n\n  .cf-play-btn:hover {\n    background: rgba(255,255,255,0.25);\n    transform: translate(-50%, -50%) scale(1.1);\n  }\n\n  @keyframes pulse {\n    0% { box-shadow: 0 0 0 0 rgba(255,255,255,0.6); }\n    70% { box-shadow: 0 0 0 25px rgba(255,255,255,0); }\n    100% { box-shadow: 0 0 0 0 rgba(255,255,255,0); }\n  }\n\n  /* --- LIGHTBOX OVERLAY --- */\n  .cf-lightbox {\n    display: none;\n    position: fixed;\n    inset: 0;\n    background: rgba(0, 0, 0, 0.9);\n    z-index: 9999;\n    justify-content: center;\n    align-items: center;\n    animation: fadeIn 0.4s ease forwards;\n  }\n\n  @keyframes fadeIn {\n    from {opacity: 0;}\n    to {opacity: 1;}\n  }\n\n  /* Video player in lightbox */\n  .cf-lightbox iframe {\n    width: 90%;\n    max-width: 960px;\n    height: 54vw;\n    max-height: 540px;\n    border: none;\n    border-radius: 12px;\n    background: #000;\n    transition: all 0.4s ease;\n  }\n\n  /* --- Full width modus --- */\n  .cf-lightbox.fullscreen iframe {\n    width: 100vw !important;\n    height: 100vh !important;\n    max-width: none !important;\n    max-height: none !important;\n    border-radius: 0;\n  }\n\n  /* Sluitknop */\n  .cf-lightbox-close, .cf-lightbox-expand {\n    position: absolute;\n    top: 30px;\n    color: #fff;\n    font-size: 36px;\n    cursor: pointer;\n    transition: 0.3s;\n    background: rgba(0,0,0,0.4);\n    border-radius: 50%;\n    width: 55px;\n    height: 55px;\n    display: flex;\n    align-items: center;\n    justify-content: center;\n  }\n\n  .cf-lightbox-close { right: 40px; }\n  .cf-lightbox-expand { right: 110px; } /* zit links van het kruisje */\n\n  .cf-lightbox-close:hover, .cf-lightbox-expand:hover {\n    background: rgba(255,255,255,0.2);\n    transform: scale(1.1);\n  }\n\n  @media (max-width: 768px) {\n    .cf-lightbox iframe {\n      width: 95%;\n      height: 56vw;\n    }\n    .cf-lightbox-expand { right: 95px; }\n  }\n</style>\n\n<!-- PLAY BUTTON OP PAGINA -->\n<div class=\"cf-video-wrapper\">\n  <div class=\"cf-play-btn\" id=\"cf-video-play\" aria-label=\"Play video\">▶</div>\n</div>\n\n<!-- LIGHTBOX (verborgen tot klik) -->\n<div class=\"cf-lightbox\" id=\"cf-lightbox\">\n  <span class=\"cf-lightbox-expand\" id=\"cf-lightbox-expand\" title=\"Volledig scherm\">⤢</span>\n  <span class=\"cf-lightbox-close\" id=\"cf-lightbox-close\" title=\"Sluiten\">✕</span>\n  <iframe\n    src=\"\"\n    allow=\"autoplay; fullscreen; picture-in-picture\"\n    allowfullscreen\n    id=\"cf-lightbox-iframe\">\n  </iframe>\n</div>\n\n<script>\n  const playButton = document.getElementById('cf-video-play');\n  const lightbox = document.getElementById('cf-lightbox');\n  const closeBtn = document.getElementById('cf-lightbox-close');\n  const expandBtn = document.getElementById('cf-lightbox-expand');\n  const iframe = document.getElementById('cf-lightbox-iframe');\n\n  playButton.addEventListener('click', () => {\n    iframe.src = \"https://watch.cloudflarestream.com/c32ab628168bcceb6361fdf68a97e1b2?autoplay=true\";\n    lightbox.style.display = 'flex';\n    document.body.style.overflow = 'hidden';\n  });\n\n  function closeLightbox() {\n    lightbox.style.display = 'none';\n    iframe.src = \"\";\n    lightbox.classList.remove('fullscreen');\n    document.body.style.overflow = '';\n  }\n\n  function toggleFullscreen() {\n    lightbox.classList.toggle('fullscreen');\n  }\n\n  closeBtn.addEventListener('click', closeLightbox);\n  expandBtn.addEventListener('click', toggleFullscreen);\n\n  lightbox.addEventListener('click', (e) => {\n    if (e.target === lightbox) closeLightbox();\n  });\n</script>"
