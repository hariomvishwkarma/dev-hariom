        "liquid": "{% raw %}\n<!DOCTYPE html>\n<html lang=\"nl\">\n<head>\n<meta charset=\"UTF-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n<title>Techweise Stoomreiniger Advisor</title>\n<link href=\"https://fonts.googleapis.com/css2?family=Arapey:ital@0;1&display=swap\" rel=\"stylesheet\">\n<style>\n  :root {\n    --navy:   #143447;\n    --green:  #dbe1a9;\n    --terra:  #ce7a56;\n    --offwht: #f0ece6;\n    --black:  #1b1a1a;\n    --muted:  #7a8a8f;\n    --border: #d6cfc6;\n  }\n  * { margin: 0; padding: 0; box-sizing: border-box; }\n  body { background: var(--offwht); color: var(--black); font-family: \"Helvetica Neue\", Helvetica, Arial, sans-serif; min-height: 100vh; }\n\n  .topbar { display: none; }\n\n  .page { max-width: 680px; margin: 0 auto; padding: 40px 24px 80px; }\n\n  .header { margin-bottom: 40px; animation: fadeDown 0.55s ease both; }\n  .eyebrow { font-size: 11px; font-weight: 500; letter-spacing: 0.22em; text-transform: uppercase; color: var(--terra); margin-bottom: 14px; }\n  .header h1 { font-size: clamp(2rem,5vw,3rem); font-weight: 500; letter-spacing: -0.02em; line-height: 1.1; color: var(--navy); margin-bottom: 16px; }\n  .header h1 em { font-family: \"Arapey\", serif; font-style: italic; font-weight: 400; }\n  .header p { font-size: 0.95rem; color: var(--muted); line-height: 1.65; max-width: 420px; }\n\n  .progress-wrap { margin-bottom: 36px; animation: fadeDown 0.55s 0.08s ease both; }\n  .progress-meta { display: flex; justify-content: space-between; align-items: center; margin-bottom: 12px; }\n  .progress-label { font-size: 11px; letter-spacing: 0.14em; text-transform: uppercase; color: var(--muted); font-weight: 500; }\n  .progress-steps { display: flex; gap: 5px; }\n  .progress-step { width: 28px; height: 4px; border-radius: 99px; background: var(--border); transition: background 0.4s cubic-bezier(0.4,0,0.2,1), transform 0.3s ease; }\n  .progress-step.done { background: var(--navy); }\n  .progress-step.active { background: var(--green); transform: scaleY(1.5); }\n  .progress-track { display: none; }\n  .progress-fill { display: none; }\n\n  .q-card { display: block !important; visibility: visible !important; background: #fff; border: 1px solid var(--border); border-radius: 16px; padding: 36px; margin-bottom: 16px; animation: slideIn 0.38s cubic-bezier(0.4,0,0.2,1) both; }\n  .q-num-lbl { font-size: 10px; letter-spacing: 0.22em; text-transform: uppercase; color: var(--terra); font-weight: 500; margin-bottom: 10px; }\n  .q-text { font-size: 1.15rem !important; font-weight: 500 !important; line-height: 1.45 !important; color: var(--navy) !important; margin-bottom: 28px !important; letter-spacing: -0.01em !important; display: block !important; }\n\n  .options { display: flex !important; flex-direction: column !important; gap: 9px !important; }\n  .option { display: flex !important; visibility: visible !important; align-items: flex-start; gap: 14px; padding: 15px 18px; border: 1.5px solid var(--border); border-radius: 10px; cursor: pointer; transition: border-color 0.18s, background 0.18s; background: var(--offwht); font-size: 0.9rem; color: var(--black); line-height: 1.45; }\n  .option:hover { border-color: var(--navy); background: #fff; }\n  .option.selected { border-color: var(--navy); background: #fff; }\n  .radio { width: 18px; height: 18px; min-width: 18px; border-radius: 50%; border: 1.5px solid var(--border); display: flex; align-items: center; justify-content: center; margin-top: 1px; transition: border-color 0.18s, background 0.18s; flex-shrink: 0; }\n  .option.selected .radio { border-color: var(--navy); background: var(--navy); }\n  .option.selected .radio::after { content: \"\"; width: 6px; height: 6px; background: #fff; border-radius: 50%; }\n\n  .btn-next { width: 100%; background: var(--navy); color: #fff; border: none; border-radius: 10px; padding: 16px 28px; font-size: 0.88rem; font-weight: 500; letter-spacing: 0.1em; text-transform: uppercase; cursor: pointer; display: flex; align-items: center; justify-content: center; gap: 8px; transition: background 0.2s, transform 0.2s; animation: fadeUp 0.38s 0.12s ease both; }\n  .btn-next:hover:not(:disabled) { background: #1b4a66; transform: translateY(-1px); }\n  .btn-next:disabled { opacity: 0.3; cursor: not-allowed; }\n  .btn-next svg { transition: transform 0.2s; }\n  .btn-next:hover:not(:disabled) svg { transform: translateX(3px); }\n\n  /* RESULT */\n  .result-screen { display: none; animation: fadeIn 0.5s ease both; }\n  .result-eyebrow { font-size: 11px; letter-spacing: 0.22em; text-transform: uppercase; color: var(--terra); font-weight: 500; margin-bottom: 10px; }\n  .result-headline { font-size: clamp(1.6rem,4vw,2.4rem); font-weight: 500; letter-spacing: -0.02em; color: var(--navy); line-height: 1.1; margin-bottom: 8px; }\n  .result-headline em { font-family: \"Arapey\", serif; font-style: italic; font-weight: 400; }\n  .result-sub { font-size: 0.9rem; color: var(--muted); line-height: 1.6; margin-bottom: 32px; }\n\n  .product-card { background: #fff; border: 1px solid var(--border); border-radius: 16px; overflow: hidden; margin-bottom: 16px; }\n  .card-strip { height: 4px; }\n\n  /* Product image */\n  .product-img-wrap { background: #f0ece6; display: flex; align-items: center; justify-content: center; padding: 32px 40px; border-bottom: 1px solid var(--border); position: relative; min-height: 260px; }\n  .product-img-wrap img { max-height: 220px; max-width: 100%; object-fit: contain; display: block; mix-blend-mode: multiply; }\n  \n  /* Award badge overlay */\n  .award-img { position: absolute; bottom: 16px; right: 16px; width: 72px; height: auto; }\n\n  .product-top { padding: 28px 36px 24px; display: flex; justify-content: space-between; align-items: flex-start; gap: 20px; border-bottom: 1px solid var(--border); }\n  .product-name { font-size: 1.7rem; font-weight: 500; letter-spacing: -0.02em; color: var(--navy); margin-bottom: 6px; }\n  .product-desc { font-size: 0.88rem; color: var(--muted); line-height: 1.55; max-width: 320px; }\n  .price-col { text-align: right; flex-shrink: 0; }\n  .price-lbl { font-size: 10px; text-transform: uppercase; letter-spacing: 0.15em; color: var(--muted); margin-bottom: 4px; }\n  .price-val { font-size: 1.6rem; font-weight: 500; color: var(--navy); }\n\n  .specs-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(148px,1fr)); gap: 1px; background: var(--border); border-bottom: 1px solid var(--border); }\n  .spec { background: #fff; padding: 18px 20px; }\n  .spec-lbl { font-size: 9px; text-transform: uppercase; letter-spacing: 0.18em; color: var(--muted); margin-bottom: 6px; }\n  .spec-val { font-size: 1rem; font-weight: 500; color: var(--navy); }\n  .spec-val.hi { color: var(--terra); }\n\n  .chips { padding: 22px 36px; display: flex; flex-wrap: wrap; gap: 7px; border-bottom: 1px solid var(--border); }\n  .chip { display: flex; align-items: center; gap: 7px; padding: 6px 13px; border: 1px solid var(--border); border-radius: 99px; font-size: 0.78rem; color: var(--black); background: var(--offwht); }\n  .chip-dot { width: 5px; height: 5px; border-radius: 50%; flex-shrink: 0; }\n\n  .buy-area { padding: 24px 36px 32px; }\n  .btn-buy { text-decoration: none; width: 100%; background: var(--navy); color: #fff; border: none; border-radius: 10px; padding: 17px 28px; font-size: 0.88rem; font-weight: 500; letter-spacing: 0.1em; text-transform: uppercase; cursor: pointer; display: flex; align-items: center; justify-content: center; gap: 10px; transition: filter 0.2s, transform 0.2s; }\n  .btn-buy:hover { filter: brightness(0.88); transform: translateY(-2px); }\n\n  .btn-restart { width: 100%; background: transparent; color: var(--muted); border: 1px solid var(--border); border-radius: 10px; padding: 13px; font-size: 0.8rem; letter-spacing: 0.1em; text-transform: uppercase; cursor: pointer; transition: border-color 0.2s, color 0.2s; margin-top: 10px; }\n  .btn-restart:hover { border-color: var(--navy); color: var(--navy); }\n  .btn-back { width: 100%; background: transparent; color: var(--muted); border: 1px solid var(--border); border-radius: 10px; padding: 13px; font-size: 0.8rem; letter-spacing: 0.1em; text-transform: uppercase; cursor: pointer; transition: border-color 0.2s, color 0.2s; margin-top: 10px; }\n  .btn-back:hover { border-color: var(--navy); color: var(--navy); }\n  .btn-back:disabled { opacity: 0; pointer-events: none; }\n\n  @keyframes fadeDown { from { opacity:0; transform: translateY(-14px); } to { opacity:1; transform:translateY(0); } }\n  @keyframes fadeUp   { from { opacity:0; transform: translateY(14px); }  to { opacity:1; transform:translateY(0); } }\n  @keyframes slideIn  { from { opacity:0; transform: translateX(18px); } to { opacity:1; transform:translateX(0); } }\n  @keyframes fadeIn   { from { opacity:0; transform: scale(0.98); }       to { opacity:1; transform:scale(1); } }\n\n  @media (max-width: 500px) {\n    .topbar { padding: 16px 20px; }\n    .q-card, .product-top, .chips, .buy-area { padding-left: 20px; padding-right: 20px; }\n    .product-top { flex-direction: column; }\n    .specs-grid { grid-template-columns: repeat(2,1fr); }\n    .price-col { text-align: left; }\n    .product-img-wrap { padding: 24px 20px; min-height: 200px; }\n    .product-img-wrap img { max-height: 170px; }\n  }\n</style>\n</head>\n<body>\n\n<div class=\"topbar\">\n  <svg height=\"22\" viewBox=\"0 0 170 28\" fill=\"none\" xmlns=\"http://www.w3.org/2000/svg\">\n    <path d=\"M2 6 Q7 3 12 6 Q17 9 22 6\" stroke=\"white\" stroke-width=\"2.2\" stroke-linecap=\"round\" fill=\"none\"/>\n    <path d=\"M2 13 Q7 10 12 13 Q17 16 22 13\" stroke=\"white\" stroke-width=\"2.2\" stroke-linecap=\"round\" fill=\"none\"/>\n    <path d=\"M2 20 Q7 17 12 20 Q17 23 22 20\" stroke=\"white\" stroke-width=\"2.2\" stroke-linecap=\"round\" fill=\"none\"/>\n    <text x=\"31\" y=\"20\" font-family=\"Helvetica Neue,Helvetica,Arial,sans-serif\" font-size=\"13.5\" font-weight=\"700\" fill=\"white\" letter-spacing=\"2.5\">TECHWEISE</text>\n    <text x=\"153\" y=\"14\" font-family=\"serif\" font-size=\"7\" fill=\"white\" opacity=\"0.8\">®</text>\n  </svg>\n</div>\n\n<div class=\"page\">\n  <div class=\"header\" id=\"main-header\">\n    <div class=\"eyebrow\">Product Advisor</div>\n    <h1>Welke stoomreiniger<br>past bij <em>jou?</em></h1>\n    <p>Beantwoord 6 korte vragen en ontdek het model dat het beste aansluit bij je wensen.</p>\n  </div>\n\n  <div id=\"quiz-screen\">\n    <div class=\"progress-wrap\">\n      <div class=\"progress-meta\">\n        <span class=\"progress-label\" id=\"q-label\">Vraag 1 van 6</span>\n        <div class=\"progress-steps\" id=\"progress-steps\">\n          <div class=\"progress-step active\" id=\"step-0\"></div>\n          <div class=\"progress-step\" id=\"step-1\"></div>\n          <div class=\"progress-step\" id=\"step-2\"></div>\n          <div class=\"progress-step\" id=\"step-3\"></div>\n          <div class=\"progress-step\" id=\"step-4\"></div>\n          <div class=\"progress-step\" id=\"step-5\"></div>\n        </div>\n      </div>\n      <div class=\"progress-track\">\n        <div class=\"progress-fill\" id=\"progress-fill\" style=\"width:0%\"></div>\n      </div>\n    </div>\n    <div class=\"q-card\" id=\"q-card\">\n      <div class=\"q-num-lbl\" id=\"q-num\">Vraag 01</div>\n      <div class=\"q-text\" id=\"q-text\"></div>\n      <div class=\"options\" id=\"options\"></div>\n    </div>\n    <button class=\"btn-next\" id=\"btn-next\" disabled onclick=\"next()\">\n      Volgende vraag\n      <svg width=\"15\" height=\"15\" viewBox=\"0 0 15 15\" fill=\"none\"><path d=\"M2 7.5h11M9 3.5l4 4-4 4\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></svg>\n    </button>\n    <button class=\"btn-back\" id=\"btn-back\" onclick=\"back()\">&#8592; Ga terug</button>\n  </div>\n\n  <div id=\"result-screen\" class=\"result-screen\"></div>\n</div>\n\n<script>\nconst IMGS = {\n  compact: \"https://techweise.com/cdn/shop/files/Techweise-TS-Compact-Handstoomreiniger-hoofd.jpg?v=1768279934&width=1800\",\n  ts1: \"https://techweise.com/cdn/shop/files/techweise-ts1-stoomreiniger_c7289d3e-2094-48e6-977c-8dfd796b0662.png?v=1760016225&width=1400\",\n  ts2: \"https://techweise.com/cdn/shop/files/techweise-ts2-performance-stoomreiniger.png?v=1760016248&width=1600\",\n  award: \"data:image/jpeg;base64,\"\n};\n\nconst questions = [\n  { text: \"Wat is je budget voor je nieuwe stoomreiniger?\",\n    opts: [\n      { label: \"Maximaal \\u20ac100\", sc: { compact:4, ts1:1, ts2:0 } },\n      { label: \"Maximaal \\u20ac150\", sc: { compact:1, ts1:4, ts2:1 } },\n      { label: \"Maximaal \\u20ac200\", sc: { compact:0, ts1:1, ts2:4 } }\n    ]\n  },\n  { text: \"Hoe intensief ga je reinigen?\",\n    opts: [\n      { label: \"Oppervlakkig vet & vuil verwijderen en bacteriën doden is voldoende\", sc: { compact:3, ts1:2, ts2:1 } },\n      { label: \"Grondig vet, vuil en aanslag verwijderen op diverse oppervlakken\", sc: { compact:0, ts1:3, ts2:2 } },\n      { label: \"Maximale dieptereiniging ik wil de meeste kracht\", sc: { compact:0, ts1:0, ts2:2 } }\n    ]\n  },\n  { text: \"Hoe snel wil je kunnen beginnen met stomen?\",\n    opts: [\n      { label: \"Direct: binnen 10 seconden klaar voor gebruik\", sc: { compact:4, ts1:0, ts2:0 } },\n      { label: \"Ik wacht rustig 2\\u20138 minuten\", sc: { compact:0, ts1:3, ts2:3 } }\n    ]\n  },\n  { text: \"Hoe lang wil je achter elkaar kunnen stomen?\",\n    opts: [\n      { label: \"Onbeperkt ik wil altijd kunnen bijvullen en doorgaan\", sc: { compact:3, ts1:0, ts2:0 } },\n      { label: \"40\\u201350 minuten is meer dan genoeg voor mij\", sc: { compact:0, ts1:3, ts2:4 } }\n    ]\n  },\n  { text: \"Is de nat- én droogstoomfunctie belangrijk voor je?\",\n    opts: [\n      { label: \"Ja, ik wil flexibel kunnen wisselen tussen nat en droog\", sc: { compact:3, ts1:0, ts2:0 } },\n      { label: \"Nee, standaard stoom is prima voor mijn gebruik\", sc: { compact:1, ts1:3, ts2:3 } }\n    ]\n  },\n  { text: \"Wat vind je het belangrijkst in design en formaat?\",\n    opts: [\n      { label: \"Compact & handheld weinig ruimte, modern design\", sc: { compact:4, ts1:0, ts2:1 } },\n      { label: \"Gewoon functioneel design maakt me niet zoveel uit\", sc: { compact:0, ts1:4, ts2:1 } },\n      { label: \"Stijlvol met LED-indicator en een mooi uiterlijk\", sc: { compact:1, ts1:0, ts2:4 } },\n    ]\n  }\n];\n\nconst products = {\n  compact: {\n    url: \"https://techweise.com/products/ts-compact-handstoomreiniger?_pos=1&_psq=compact&_ss=e&_v=1.0\",\n    name: \"TS Compact\", stripColor: \"#dbe1a9\", chipColor: \"#4a6a3a\",\n    desc: \"Handig, direct klaar en modern van formaat. Licht en compact, binnen 10 seconden klaar voor gebruik, continue navulbaar en voorzien van nat en droog functie. De ideale keuze als je snel en efficiënt wilt stomen met een compact apparaat.\",\n    price: \"\\u20ac99\", award: false,\n    highlights: [\"Onbeperkt stomen\",\"Nat & droog stoom\",\"Bijvullen tijdens gebruik\",\"Klaar in \\u00b110 seconden\",\"Compact handheld\",\"15 accessoires\"],\n    specs: [\n      {l:\"Vermogen\",v:\"1200 W\"},{l:\"Druk\",v:\"2,5 bar\"},\n      {l:\"Opwarmtijd\",v:\"\\u00b110 sec\",hi:true},{l:\"Stoomtijd\",v:\"Onbeperkt\",hi:true},\n      {l:\"Temperatuur\",v:\"125\\u00b0C\",hi:true},{l:\"Waterinhoud\",v:\"900 ml\"},\n      {l:\"Gewicht\",v:\"1,3 kg\",hi:true},{l:\"Accessoires\",v:\"15 stuks\"}\n    ]\n  },\n  ts1: {\n    url: \"https://techweise.com/products/ts1-stoomreiniger-met-21-accessoires\",\n    name: \"TS1\", stripColor: \"#143447\", chipColor: \"#143447\",\n    desc: \"Krachtig en betrouwbaar voor grondig dagelijks reinigen. Groot waterreservoir en het maximale aantal accessoires.\",\n    price: \"\\u20ac149\", award: false,\n    highlights: [\"3,6 bar druk\",\"1500 ml reservoir\",\"26 accessoires\",\"40 min stoomtijd\",\"6 m snoer\"],\n    specs: [\n      {l:\"Vermogen\",v:\"1500 W\",hi:true},{l:\"Druk\",v:\"3,6 bar\",hi:true},\n      {l:\"Opwarmtijd\",v:\"2\\u20138 min\"},{l:\"Stoomtijd\",v:\"40 min\"},\n      {l:\"Temperatuur\",v:\"100\\u00b0C\"},{l:\"Waterinhoud\",v:\"1500 ml\",hi:true},\n      {l:\"Gewicht\",v:\"4,3 kg\"},{l:\"Accessoires\",v:\"26 stuks\",hi:true}\n    ]\n  },\n  ts2: {\n    url: \"https://techweise.com/products/ts2-performance-stoomreiniger\",\n    name: \"TS2 Performance\", stripColor: \"#ce7a56\", chipColor: \"#ce7a56\",\n    desc: \"Bekroond model met de krachtigste combinatie van prestatie, (1800W bij 4 Bar), LED-indicatielampje, 26 accessoires en modern design.\",\n    price: \"\\u20ac199\", award: true,\n    highlights: [\"4 bar druk\",\"1600 ml reservoir\",\"26 accessoires\",\"LED-indicator\",\"1800 W vermogen\",\"Stijlvol design\"],\n    specs: [\n      {l:\"Vermogen\",v:\"1800 W\",hi:true},{l:\"Druk\",v:\"4 bar\",hi:true},\n      {l:\"Opwarmtijd\",v:\"2\\u20138 min\"},{l:\"Stoomtijd\",v:\"50 min\",hi:true},\n      {l:\"Temperatuur\",v:\"100\\u00b0C\"},{l:\"Waterinhoud\",v:\"1600 ml\",hi:true},\n      {l:\"Gewicht\",v:\"4,2 kg\"},{l:\"Accessoires\",v:\"26 stuks\",hi:true}\n    ]\n  }\n};\n\nlet cur=0, sel=null, scores={compact:0,ts1:0,ts2:0}, answers=new Array(6).fill(null);\n\nfunction renderQ(){\n  const q=questions[cur], total=questions.length;\n  const pct=Math.round(cur/total*100);\n  document.getElementById(\"q-label\").textContent=\"Vraag \"+(cur+1)+\" van \"+total;\n  document.getElementById(\"progress-fill\").style.width=pct+\"%\";\n  for(let i=0;i<total;i++){\n    const s=document.getElementById(\"step-\"+i);\n    if(!s)continue;\n    s.classList.remove(\"done\",\"active\");\n    if(i<cur) s.classList.add(\"done\");\n    else if(i===cur) s.classList.add(\"active\");\n  }\n  document.getElementById(\"q-num\").textContent=\"Vraag \"+String(cur+1).padStart(2,\"0\");\n  document.getElementById(\"q-text\").textContent=q.text;\n  sel=null;\n  const btn=document.getElementById(\"btn-next\");\n  btn.disabled=true;\n  const last=cur===total-1;\n  var arrowSVG = '<svg width=\"15\" height=\"15\" viewBox=\"0 0 15 15\" fill=\"none\"><path d=\"M2 7.5h11M9 3.5l4 4-4 4\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></svg>';\n  btn.innerHTML = last\n    ? 'Bekijk mijn aanbeveling ' + arrowSVG\n    : 'Volgende vraag ' + arrowSVG;\n  const card=document.getElementById(\"q-card\");\n  card.style.animation=\"none\"; void card.offsetWidth; card.style.animation=\"slideIn 0.35s cubic-bezier(0.4,0,0.2,1) both\";\n  const el=document.getElementById(\"options\"); el.innerHTML=\"\";\n  const backBtn=document.getElementById(\"btn-back\");\n  if(backBtn) backBtn.disabled=(cur===0);\n  q.opts.forEach((o,i)=>{\n    const d=document.createElement(\"div\"); d.className=\"option\";\n    d.innerHTML = '<div class=\"radio\"></div><span>' + o.label + '</span>';\n    d.onclick=()=>pick(i); el.appendChild(d);\n  });\n}\n\nfunction pick(i){\n  sel=i;\n  document.querySelectorAll(\".option\").forEach((e,j)=>e.classList.toggle(\"selected\",j===i));\n  document.getElementById(\"btn-next\").disabled=false;\n}\n\nfunction back(){\n  if(cur===0) return;\n  cur--;\n  if(answers[cur]!==null){\n    const s=questions[cur].opts[answers[cur]].sc;\n    for(const k in s) scores[k]-=s[k];\n  }\n  renderQ();\n  if(answers[cur]!==null){\n    const opts=document.querySelectorAll(\".option\");\n    opts[answers[cur]].classList.add(\"selected\");\n    sel=answers[cur];\n    document.getElementById(\"btn-next\").disabled=false;\n  }\n}\n\nfunction next(){\n  if(sel===null)return;\n  const s=questions[cur].opts[sel].sc;\n  for(const k in s)scores[k]+=s[k];\n  answers[cur]=sel;\n  if(cur<questions.length-1){cur++;renderQ();}else showResult();\n}\n\nfunction showResult(){\n  const winner=Object.entries(scores).reduce((a,b)=>a[1]>b[1]?a:b)[0];\n  document.getElementById(\"quiz-screen\").style.display=\"none\";\n  document.getElementById(\"main-header\").style.display=\"none\";\n  const p=products[winner];\n  const rs=document.getElementById(\"result-screen\");\n  rs.style.display=\"block\";\n\n  var awardHTML = p.award ? '<img class=\"award-img\" src=\"' + IMGS.award + '\" alt=\"Product van het Jaar 2026\">' : \"\";\n\n  var specsHTML = p.specs.map(function(s){\n    return '<div class=\"spec\"><div class=\"spec-lbl\">' + s.l + '</div><div class=\"spec-val' + (s.hi ? ' hi' : '') + '\">' + s.v + '</div></div>';\n  }).join(\"\");\n\n  var chipsHTML = p.highlights.map(function(h){\n    return '<div class=\"chip\"><span class=\"chip-dot\" style=\"background:' + p.chipColor + '\"></span>' + h + '</div>';\n  }).join(\"\");\n\n  rs.innerHTML =\n    '<div class=\"result-eyebrow\">Jouw aanbeveling</div>' +\n    '<div class=\"result-headline\">Dit is je ideale<br><em>' + p.name + '</em></div>' +\n    '<p class=\"result-sub\">' + p.desc + '</p>' +\n    '<div class=\"product-card\">' +\n      '<div class=\"card-strip\" style=\"background:' + p.stripColor + '\"></div>' +\n      '<div class=\"product-img-wrap\">' +\n        '<img src=\"' + IMGS[winner] + '\" alt=\"' + p.name + '\">' +\n        awardHTML +\n      '</div>' +\n      '<div class=\"buy-area\">' +\n        '<a class=\"btn-buy\" href=\"' + p.url + '\" target=\"_blank\" rel=\"noopener\">' +\n          'Bestel nu de ' + p.name + ' voor ' + p.price +\n          '<svg width=\"15\" height=\"15\" viewBox=\"0 0 15 15\" fill=\"none\"><path d=\"M2 7.5h11M9 3.5l4 4-4 4\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></svg>' +\n        '</a>' +\n      '</div>' +\n      '<div class=\"product-top\">' +\n        '<div>' +\n          '<div class=\"product-name\">' + p.name + '</div>' +\n          '<div class=\"product-desc\">' + p.desc + '</div>' +\n        '</div>' +\n        '<div class=\"price-col\">' +\n          '<div class=\"price-lbl\">Adviesprijs</div>' +\n          '<div class=\"price-val\">' + p.price + '</div>' +\n        '</div>' +\n      '</div>' +\n      '<div class=\"specs-grid\">' + specsHTML + '</div>' +\n      '<div class=\"chips\">' + chipsHTML + '</div>' +\n    '</div>' +\n    '<button class=\"btn-restart\" onclick=\"restart()\">↩ Opnieuw beginnen</button>';\n}\n\nfunction restart(){\n  cur=0;sel=null;scores={compact:0,ts1:0,ts2:0};answers=new Array(6).fill(null);\n  document.getElementById(\"result-screen\").style.display=\"none\";\n  document.getElementById(\"main-header\").style.display=\"block\";\n  document.getElementById(\"quiz-screen\").style.display=\"block\";\n  document.getElementById(\"progress-fill\").style.width=\"0%\";\n  for(let i=0;i<6;i++){const s=document.getElementById(\"step-\"+i);if(s){s.classList.remove(\"done\",\"active\");if(i===0)s.classList.add(\"active\");}}\n  renderQ();\n}\n\n// Robust init: try immediately, then fallback via timeout\n(function tryInit(){\n  var el = document.getElementById(\"q-text\");\n  if(el){ renderQ(); }\n  else { setTimeout(tryInit, 50); }\n})();\n</script>\n</body>\n</html>\n{% endraw %}",
