<style>
  #shopify-section-{{ section.id }} {
    {%- if section.settings.background == 'rgba(0,0,0,0)' -%}
      {%- assign section_background = settings.background -%}
    {%- else -%}
      {%- assign section_background = section.settings.background -%}
    {%- endif -%}

    {%- if section.settings.text_color == 'rgba(0,0,0,0)' -%}
      {%- assign heading_color = settings.heading_color -%}
      {%- assign text_color = settings.text_color -%}
    {%- else -%}
      {%- assign heading_color = section.settings.text_color -%}
      {%- assign text_color = section.settings.text_color -%}
    {%- endif -%}

    {%- if section.settings.button_background == 'rgba(0,0,0,0)' -%}
      {%- assign button_background = settings.primary_button_background -%}
    {%- else -%}
      {%- assign button_background = section.settings.button_background -%}
    {%- endif -%}

    {%- if section.settings.button_text_color == 'rgba(0,0,0,0)' -%}
      {%- assign button_text_color = settings.primary_button_text_color -%}
    {%- else -%}
      {%- assign button_text_color = section.settings.button_text_color -%}
    {%- endif -%}

    --heading-color: {{ heading_color.red }}, {{ heading_color.green }}, {{ heading_color.blue }};
    --text-color: {{ text_color.red }}, {{ text_color.green }}, {{ text_color.blue }};
    --primary-button-background: {{ button_background.red }}, {{ button_background.green }}, {{ button_background.blue }};
    --primary-button-text-color: {{ button_text_color.red }}, {{ button_text_color.green }}, {{ button_text_color.blue }};
    --section-background: {{ section_background.red }}, {{ section_background.green }}, {{ section_background.blue }};
    --contact-form-max-width: {{ section.settings.contact_form_max_width -}}px;
  }
  #shopify-section-{{ section.id }} {
    background-color: rgb(var(--section-background));
  }

  @media (min-width: 1000px) {
    #shopify-section-{{ section.id }} {
        padding-top: {{ section.settings.space_top -}}px;
        padding-bottom: {{ section.settings.space_bottom -}}px;
    }
  }
  @media (max-width: 999px) {
    #shopify-section-{{ section.id }} {
      padding-top: {{ section.settings.space_top_mobile -}}px;
      padding-bottom: {{ section.settings.space_bottom_mobile -}}px;
    }
  }

  .ed_contact_wrapper {
    padding: 40px 50px;
    background-color: {{ section.settings.form_background }};
    border: 1px solid #F3F4F9;
    box-shadow: 0px 84px 34px rgba(156, 162, 176, 0.01),
    0px 47px 28px rgba(156, 162, 176, 0.05),
    0px 21px 21px rgba(156, 162, 176, 0.09),
    0px 5px 12px rgba(156, 162, 176, 0.1);
    border-radius: 8px;
    max-width: var(--contact-form-max-width);
    margin-inline: auto;
    display: block;
  }

  .ed_contact_wrapper header.section__header {
    margin-block-end: 40px;
  }

  .ed_contact_wrapper .input__field,
  .ed_contact_wrapper .select {
    border: 1px solid #DFDFDF;
  }

  .ed_contact_wrapper .input__label {
    background-color: {{ section.settings.form_background }};
  }

  .ed_contact_wrapper .ed_contact_form_content {
    margin-block-start: 40px;
    text-align: center;
    margin-block-end: 35px;
  }

  .ed_contact_form_content a {
  text-decoration: underline;
  }

  .ed_contact_wrapper button.form__submit.button {
    margin-inline: auto;
    margin-block: 0;
    --button-height: 46px;
  }

  .ed_contact_wrapper button.form__submit.button .loader-button__text {
    gap: 16px;
  }

  @media (max-width: 999px) {
    .ed_contact_wrapper {
      padding: 40px 24px !important;
    }

    .ed_contact_wrapper .ed_contact_form_content {
      font-size: 13px;
      font-weight: 300;
    }

  }
</style>

<section class="ed_contact_form_section">
  <div class="section__color-wrapper">
    <div class="container">
      <div class="ed_contact_wrapper">
        <div class="contact__main">
          {%- if section.settings.title != blank or section.settings.content != blank -%}
            <header class="section__header {% if section.settings.content != blank %}section__header--tight{% endif %} text-container">
              {%- if section.settings.title != blank -%}
                <h1 class="heading h2">{{ section.settings.title }}</h1>
              {%- endif -%}
            </header>
          {%- endif -%}

          {%- form 'contact', class: 'ed_contact__form form' -%}
            {%- if form.posted_successfully? -%}
              <div class="banner banner--success form__banner">
                <span class="banner__ribbon">{% render 'icon' with 'form-success' %}</span>
                <p class="banner__content">{{ 'contact.form.successfully_sent' | t }}</p>
              </div>
            {%- endif -%}

            {%- if form.errors -%}
              <div class="form__banner banner banner--error">
                <span class="banner__ribbon">{% render 'icon' with 'form-error' %}</span>

                <div class="banner__content">
                  {{- form.errors | default_errors -}}
                </div>
              </div>
            {%- endif -%}

            {%- for block in section.blocks -%}
              {%- assign field_title = block.settings.title -%}

              {%- if field_title == blank -%}
                {%- capture field_title -%}Custom field {% increment custom_field %}{%- endcapture -%}
              {%- endif -%}

              {%- if block.type == 'name' -%}
                <div class="input" {{ block.shopify_attributes }}>
                  <input
                    id="contact-form-name-{{ section.id }}"
                    type="text"
                    class="input__field {% if customer.name != blank %}is-filled{% endif %}"
                    name="contact[name]"
                    aria-label="{{ block.settings.placeholder | default: 'Dein Name' }}"
                    {% if block.settings.is_required %}
                      required
                    {% endif %}
                    {% if customer %}
                      value="{{ customer.name }}"
                    {% endif %}
                  >
                  <label for="contact-form-name-{{ section.id }}" class="input__label">
                    {{- block.settings.placeholder | default: 'Dein Name' -}}
                  </label>
                </div>
              {%- elsif block.type == 'email' -%}
                <div class="input" {{ block.shopify_attributes }}>
                  <input
                    id="contact-form-email-{{ section.id }}"
                    type="email"
                    class="input__field {% if customer.email != blank %}is-filled{% endif %}"
                    name="contact[email]"
                    aria-label="{{ block.settings.placeholder | default: 'Deine E-Mail' }}"
                    {% if block.settings.is_required %}
                      required
                    {% endif %}
                    {% if customer %}
                      value="{{ customer.email }}"
                    {% endif %}
                  >
                  <label for="contact-form-email-{{ section.id }}" class="input__label">
                    {{- block.settings.placeholder | default: 'Deine E-Mail' -}}
                  </label>
                </div>
              {%- elsif block.type == 'text' -%}
                <div class="input" {{ block.shopify_attributes }}>
                  <input
                    id="contact-form-{{ field_title | handle }}-{{ section.id }}"
                    type="text"
                    class="input__field"
                    name="contact[{{ field_title | escape }}]"
                    aria-label="{{ block.settings.placeholder | default: field_title | escape }}"
                    {% if block.settings.is_required %}
                      required
                    {% endif %}
                  >
                  <label for="contact-form-{{ field_title | handle }}-{{ section.id }}" class="input__label">
                    {{- block.settings.placeholder | default: field_title | escape -}}
                  </label>
                </div>
              {%- elsif block.type == 'textarea' -%}
                <div class="input" {{ block.shopify_attributes }}>
                  <textarea
                    id="contact-form-{{ field_title | handle }}-{{ section.id }}"
                    name="contact[{{ field_title | escape }}]"
                    rows="{{ block.settings.rows | default: 4 }}"
                    class="input__field input__field--textarea"
                    aria-label="{{ block.settings.placeholder | default: field_title | escape }}"
                    {% if block.settings.is_required %}
                      required
                    {% endif -%}
                  ></textarea>
                  <label for="contact-form-{{ field_title | handle }}-{{ section.id }}" class="input__label">
                    {{- block.settings.placeholder | default: field_title | escape -}}
                  </label>
                </div>
              {%- elsif block.type == 'dropdown' -%}
                {%- assign values = block.settings.values | split: ',' -%}

                {%- if values == empty -%}
                  {%- continue -%}
                {%- endif -%}

                <div class="input" {{ block.shopify_attributes }}>
                  <div class="select-wrapper">
                    <select
                      id="contact-form-{{ field_title | handle }}-{{ section.id }}"
                      class="select"
                      name="contact[{{ field_title | escape }}]"
                      title="{{ block.settings.placeholder | default: field_title | escape }}"
                      {% if block.settings.is_required %}
                        required
                      {% endif %}
                    >
                      <option value="" disabled selected></option>

                      {%- for value in values -%}
                        {%- assign trim_value = value | strip -%}

                        <option value="{{ trim_value | escape }}">{{ trim_value | escape }}</option>
                      {%- endfor -%}
                    </select>

                    {%- render 'icon' with 'chevron' -%}
                  </div>

                  <label for="contact-form-{{ field_title | handle }}-{{ section.id }}" class="input__label">
                    {{- block.settings.placeholder | default: field_title | escape -}}
                  </label>
                </div>
              {%- endif -%}
            {%- endfor -%}

            <div class="ed_contact_form_content">
              {%- if section.settings.content != blank -%}
                {{- section.settings.content -}}
              {%- endif -%}

              {%- if section.settings.privacy_text != blank -%}
                {{- section.settings.privacy_text -}}
              {%- endif -%}
            </div>

            <button is="loader-button" type="submit" class="form__submit button {{ section.settings.button_style }}">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                <path d="M21.3112 2.68876C21.1226 2.50025 20.8871 2.36544 20.629 2.29821C20.371 2.23098 20.0997 2.23376 19.843 2.30626H19.829L1.83461 7.76625C1.54248 7.85045 1.28283 8.02142 1.09007 8.25651C0.897302 8.49161 0.780525 8.77973 0.75521 9.08269C0.729895 9.38565 0.797238 9.68916 0.948314 9.95298C1.09939 10.2168 1.32707 10.4285 1.60117 10.56L9.56242 14.4375L13.4343 22.3941C13.5547 22.6511 13.7462 22.8682 13.9861 23.0199C14.226 23.1716 14.5042 23.2514 14.788 23.25C14.8312 23.25 14.8743 23.2481 14.9174 23.2444C15.2201 23.2199 15.5081 23.1034 15.7427 22.9105C15.9773 22.7176 16.1473 22.4576 16.2299 22.1653L21.6862 4.17094C21.6862 4.16626 21.6862 4.16157 21.6862 4.15688C21.7596 3.90091 21.7636 3.63 21.6977 3.37199C21.6318 3.11397 21.4984 2.87815 21.3112 2.68876ZM14.7965 21.7359L14.7918 21.7491V21.7425L11.0362 14.0269L15.5362 9.52688C15.6709 9.38508 15.7449 9.19627 15.7424 9.0007C15.7399 8.80513 15.6611 8.61827 15.5228 8.47997C15.3845 8.34167 15.1976 8.26287 15.002 8.26036C14.8065 8.25786 14.6177 8.33185 14.4759 8.46657L9.97586 12.9666L2.25742 9.21094H2.25086H2.26399L20.2499 3.75001L14.7965 21.7359Z" fill="white"/>
              </svg>
              {{ section.settings.button_label | default: 'Senden' }}
            </button>
          {%- endform -%}
        </div>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "STAW | Kontaktformular",
  "class": "shopify-section--ed-contact-form",
  "disabled_on": {
    "groups": ["header", "custom.overlay"]
  },
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Überschrift",
      "default": "Kontaktformular"
    },
    {
      "type": "richtext",
      "id": "content",
      "label": "Inhalt"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button Text",
      "default": "SENDEN"
    },
    {
      "type": "select",
      "id": "button_style",
      "label": "Button-Stil",
      "options": [
        { "value": "button--primary", "label": "Primär (gefüllt)" },
        { "value": "button--secondary", "label": "Sekundär" },
        { "value": "button--ternary", "label": "Tertiär" },
        { "value": "button--outline", "label": "Outline (Rahmen)" }
      ],
      "default": "button--primary"
    },
    {
      "type": "richtext",
      "id": "privacy_text",
      "label": "Datenschutz-Text",
      "default": "<p>Ich habe die Datenschutzbestimmungen zur Kenntnis genommen.</p>"
    },
    {
      "type": "range",
      "id": "contact_form_max_width",
      "min": 200,
      "max": 1000,
      "step": 10,
      "unit": "px",
      "label": "Formular Max-Breite",
      "default": 650
    },
    {
      "type": "header",
      "content": "Farben"
    },
    {
      "type": "color",
      "id": "form_background",
      "label": "Formular Hintergrund",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "background",
      "label": "Hintergrund",
      "default": "rgba(0,0,0,0)"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Textfarbe",
      "default": "rgba(0,0,0,0)"
    },
    {
      "type": "color",
      "id": "button_background",
      "label": "Button Hintergrund",
      "default": "rgba(0,0,0,0)"
    },
    {
      "type": "color",
      "id": "button_text_color",
      "label": "Button Text",
      "default": "rgba(0,0,0,0)"
    },
    {
      "type": "header",
      "content": "Abstände"
    },
    {
      "type": "range",
      "id": "space_top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Abstand oben",
      "default": 60
    },
    {
      "type": "range",
      "id": "space_bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Abstand unten",
      "default": 60
    },
    {
      "type": "range",
      "id": "space_top_mobile",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Abstand oben (Mobil)",
      "default": 40
    },
    {
      "type": "range",
      "id": "space_bottom_mobile",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Abstand unten (Mobil)",
      "default": 40
    }
  ],
  "blocks": [
    {
      "type": "name",
      "name": "Name",
      "limit": 1,
      "settings": [
        {
          "type": "text",
          "id": "placeholder",
          "label": "Platzhalter",
          "default": "Dein Name"
        },
        {
          "type": "checkbox",
          "id": "is_required",
          "label": "Pflichtfeld",
          "default": true
        }
      ]
    },
    {
      "type": "email",
      "name": "E-Mail",
      "limit": 1,
      "settings": [
        {
          "type": "text",
          "id": "placeholder",
          "label": "Platzhalter",
          "default": "Deine E-Mail"
        },
        {
          "type": "checkbox",
          "id": "is_required",
          "label": "Pflichtfeld",
          "default": true
        }
      ]
    },
    {
      "type": "text",
      "name": "Textfeld",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Feldname",
          "default": "Betreff"
        },
        {
          "type": "text",
          "id": "placeholder",
          "label": "Platzhalter",
          "default": "Betreff"
        },
        {
          "type": "checkbox",
          "id": "is_required",
          "label": "Pflichtfeld",
          "default": false
        }
      ]
    },
    {
      "type": "textarea",
      "name": "Textbereich",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Feldname",
          "default": "Nachricht"
        },
        {
          "type": "text",
          "id": "placeholder",
          "label": "Platzhalter",
          "default": "Deine Nachricht"
        },
        {
          "type": "range",
          "id": "rows",
          "min": 2,
          "max": 10,
          "step": 1,
          "label": "Zeilen",
          "default": 4
        },
        {
          "type": "checkbox",
          "id": "is_required",
          "label": "Pflichtfeld",
          "default": true
        }
      ]
    },
    {
      "type": "dropdown",
      "name": "Dropdown",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Feldname",
          "default": "Auswahl"
        },
        {
          "type": "text",
          "id": "placeholder",
          "label": "Platzhalter",
          "default": "Bitte wählen"
        },
        {
          "type": "text",
          "id": "values",
          "label": "Werte",
          "info": "Kommagetrennt eingeben.",
          "default": "Option 1, Option 2, Option 3"
        },
        {
          "type": "checkbox",
          "id": "is_required",
          "label": "Pflichtfeld",
          "default": false
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "STAW | Kontaktformular",
      "settings": {
        "background": "#F6F6F6"
      },
      "blocks": [
        {
          "type": "name"
        },
        {
          "type": "email"
        },
        {
          "type": "textarea",
          "settings": {
            "title": "Wer braucht Hilfe?",
            "placeholder": "Wer braucht Hilfe?"
          }
        },
        {
          "type": "textarea",
          "settings": {
            "title": "Warum wird Hilfe benötigt?",
            "placeholder": "Warum wird Hilfe benötigt?"
          }
        }
      ]
    }
  ]
}
{% endschema %}
