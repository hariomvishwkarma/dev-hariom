          "type": "url",
          "id": "item_1_btn_link",
          "label": "Button-Link",
          "visible_if": "{{ block.settings.item_1_type == 'button' }}"
        },
        {
          "type": "select",
          "id": "item_1_btn_style",
          "label": "Button-Stil",
          "options": [
            { "value": "button--primary", "label": "Primär" },
            { "value": "button--secondary", "label": "Sekundär" },
            { "value": "button--ternary", "label": "Tertiär" },
            { "value": "button--outline", "label": "Outline" }
          ],
          "default": "button--primary",
          "visible_if": "{{ block.settings.item_1_type == 'button' }}"
        },
        {
          "type": "checkbox",
          "id": "item_1_btn_new_tab",
          "label": "In neuem Tab öffnen",
          "default": false,
          "visible_if": "{{ block.settings.item_1_type == 'button' }}"
        },
        {
          "type": "image_picker",
          "id": "item_1_badge_icon",
          "label": "Badge Icon",
          "visible_if": "{{ block.settings.item_1_type == 'badge' }}"
        },
        {
          "type": "text",
          "id": "item_1_badge_label",
          "label": "Badge Label",
          "default": "100% kostenlos",
          "visible_if": "{{ block.settings.item_1_type == 'badge' }}"
        },
        {
          "type": "header",
          "content": "Element 2"
        },
        {
          "type": "select",
          "id": "item_2_type",
          "label": "Typ",
          "options": [
            { "value": "none", "label": "–" },
            { "value": "button", "label": "Button" },
            { "value": "badge", "label": "Badge" }
          ],
          "default": "none"
        },
        {
          "type": "text",
          "id": "item_2_btn_text",
          "label": "Button-Text",
          "default": "Mehr erfahren",
          "visible_if": "{{ block.settings.item_2_type == 'button' }}"
        },
        {
          "type": "url",
          "id": "item_2_btn_link",
          "label": "Button-Link",
          "visible_if": "{{ block.settings.item_2_type == 'button' }}"
        },
        {
          "type": "select",
          "id": "item_2_btn_style",
          "label": "Button-Stil",
          "options": [
            { "value": "button--primary", "label": "Primär" },
            { "value": "button--secondary", "label": "Sekundär" },
            { "value": "button--ternary", "label": "Tertiär" },
            { "value": "button--outline", "label": "Outline" }
          ],
          "default": "button--outline",
          "visible_if": "{{ block.settings.item_2_type == 'button' }}"
        },
        {
          "type": "checkbox",
          "id": "item_2_btn_new_tab",
          "label": "In neuem Tab öffnen",
          "default": false,
          "visible_if": "{{ block.settings.item_2_type == 'button' }}"
        },
        {
          "type": "image_picker",
          "id": "item_2_badge_icon",
          "label": "Badge Icon",
          "visible_if": "{{ block.settings.item_2_type == 'badge' }}"
        },
        {
          "type": "text",
          "id": "item_2_badge_label",
