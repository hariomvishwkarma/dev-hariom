<style>
  #shopify-section-{{ section.id }} {
    {%- if section.settings.background == 'rgba(0,0,0,0)' -%}
      {%- assign section_background = settings.background -%}
    {%- else -%}
      {%- assign section_background = section.settings.background -%}
    {%- endif -%}

    {%- if section.settings.text_color == 'rgba(0,0,0,0)' -%}
      {%- assign heading_color = settings.heading_color -%}
      {%- assign text_color = settings.text_color -%}
    {%- else -%}
      {%- assign heading_color = section.settings.text_color -%}
      {%- assign text_color = section.settings.text_color -%}
    {%- endif -%}

    --section-background: {{ section_background.red }}, {{ section_background.green }}, {{ section_background.blue }};
    --heading-color: {{ heading_color.red }}, {{ heading_color.green }}, {{ heading_color.blue }};
    --text-color: {{ text_color.red }}, {{ text_color.green }}, {{ text_color.blue }};

    background-color: rgb(var(--section-background));
  }

  @media (min-width: 1000px) {
    #shopify-section-{{ section.id }} {
      padding-top: {{ section.settings.space_top }}px;
      padding-bottom: {{ section.settings.space_bottom }}px;
    }
  }

  @media (max-width: 999px) {
    #shopify-section-{{ section.id }} {
      padding-top: {{ section.settings.space_top_mobile }}px;
      padding-bottom: {{ section.settings.space_bottom_mobile }}px;
    }
  }

  {%- if section.settings.content_max_width != 'none' -%}
  @media screen and (min-width: 741px) {
    #shopify-section-{{ section.id }} .container {
      max-width: {{ section.settings.content_max_width }};
    }
  }
  {%- endif -%}

  #shopify-section-{{ section.id }} .staw-rich-text__inner {
    display: flex;
    flex-wrap: wrap;
    row-gap: {{ section.settings.element_gap }}px;
    column-gap: 12px;
    justify-content: center;
  }

  #shopify-section-{{ section.id }} .staw-rich-text__inner > * {
    min-width: 0;
  }

  #shopify-section-{{ section.id }} .staw-rich-text--new-line {
    flex: 0 0 100%;
    margin-inline: auto;
  }

  #shopify-section-{{ section.id }} .staw-rich-text--own-row {
    flex: 0 0 100%;
    display: flex;
    justify-content: center;
  }

  #shopify-section-{{ section.id }} .staw-rich-text__image {
    display: flex;
  }

  #shopify-section-{{ section.id }} .staw-rich-text__img {
    width: 100%;
    height: auto;
  }

  #shopify-section-{{ section.id }} .text-uppercase {
    text-transform: uppercase;
  }

  #shopify-section-{{ section.id }} .staw-rich-text__group {
    gap: 12px;
    flex-wrap: wrap;
  }

  @media screen and (max-width: 740px) {
    #shopify-section-{{ section.id }} .staw-rich-text__group .button {
      flex: 0 0 calc(50% - 6px);
      text-align: center;
    }
  }

  @media screen and (max-width: 400px) {
    #shopify-section-{{ section.id }} .staw-rich-text__group {
      flex-direction: column;
      align-items: center;
    }
    #shopify-section-{{ section.id }} .staw-rich-text__group .button {
      flex: unset;
      width: 100%;
      max-width: 280px;
    }
  }
</style>

<section>
  <div class="container">
    <div class="staw-rich-text__inner">
      {%- for block in section.blocks -%}
        {%- case block.type -%}
          {%- when 'text' -%}
            <div
              class="staw-rich-text__text-block staw-rich-text--new-line content-box--text-{{ block.settings.text_alignment }} content-box--{{ block.settings.text_alignment }} text-container"
              {%- if block.settings.content_max_width != 'none' %}
                style="max-width: {{ block.settings.content_max_width }};"
              {% endif %}
              {{ block.shopify_attributes }}
            >
              {%- if block.settings.heading != blank -%}
                <h2 class="heading {{ block.settings.heading_class }}{% if block.settings.heading_uppercase %} text-uppercase{% endif %}">
                  {{ block.settings.heading | escape }}
                </h2>
              {%- endif -%}
              {%- if block.settings.subheading != blank -%}
                <h3
                  class="heading {{ block.settings.subheading_class }}{% if block.settings.subheading_uppercase %} text-uppercase{% endif %}"
                  {% if block.settings.subheading_uppercase %}
                    style="line-height: 1.15;"
                  {% endif %}
                >
                  {{ block.settings.subheading | escape }}
                </h3>
              {%- endif -%}
              {%- if block.settings.content != blank -%}
                <div
                  class="staw-rich-text__content rte"
                  style="font-size: var(--staw-font-size-{{ block.settings.content_font_size }})"
                >
                  {{ block.settings.content }}
                </div>
              {%- endif -%}
            </div>

          {%- when 'button' -%}
            <div
              class="staw-rich-text__button-wrap staw-rich-text--own-row"
              style="justify-content: {{ block.settings.alignment }};"
              {{ block.shopify_attributes }}
            >
              <a
                href="{{ block.settings.link | default: '#' }}"
                class="button {{ block.settings.style }}"
                {% if block.settings.open_in_new_tab %}
                  target="_blank" rel="noopener"
                {% endif %}
              >
                {{ block.settings.text | escape }}
              </a>
            </div>

          {%- when 'image' -%}
            {%- if block.settings.image != blank -%}
              <style>
                .staw-rich-text__img-wrap--{{ block.id }} {
                  max-width: {{ block.settings.max_width_mobile }}px;
                  width: 100%;
                }
                @media screen and (min-width: 741px) {
                  .staw-rich-text__img-wrap--{{ block.id }} {
                    max-width: {{ block.settings.max_width }}px;
                  }
                }
                {%- if block.settings.drop_shadow -%}
                .staw-rich-text__img-wrap--{{ block.id }} .staw-rich-text__img {
                  filter: drop-shadow(0 8px 12px rgba(0,0,0,0.1));
                }
                {%- endif -%}
              </style>
              <div
                class="staw-rich-text__image staw-rich-text--new-line"
                style="justify-content: {{ block.settings.alignment }};"
                {{ block.shopify_attributes }}
              >
                <div class="staw-rich-text__img-wrap--{{ block.id }}">
                  {{-
                    block.settings.image
                    | image_url: width: 1200
                    | image_tag: loading: 'lazy', class: 'staw-rich-text__img', alt: block.settings.image.alt
                    | default: ''
                  -}}
                </div>
              </div>
            {%- endif -%}

          {%- when 'iframe' -%}
            {%- if block.settings.iframe_url != blank -%}
              <div
                class="staw-rich-text__iframe staw-rich-text--new-line"
                {{ block.shopify_attributes }}
              >
                <iframe
                  src="{{ block.settings.iframe_url }}"
                  width="100%"
                  height="{{ block.settings.iframe_height }}"
                  frameborder="0"
                  loading="lazy"
                  allow="clipboard-write"
                  title="{{ block.settings.iframe_title | default: 'Eingebetteter Inhalt' }}"
                ></iframe>
              </div>
            {%- endif -%}

          {%- when 'group' -%}
            <div class="staw-rich-text--own-row staw-rich-text__group" {{ block.shopify_attributes }}>
              {%- for i in (1..4) -%}
                {%- liquid
                  assign type_key = 'item_' | append: i | append: '_type'
                  assign item_type = block.settings[type_key]
                -%}
                {%- if item_type == 'button' -%}
                  {%- liquid
                    assign txt_key = 'item_' | append: i | append: '_btn_text'
                    assign link_key = 'item_' | append: i | append: '_btn_link'
                    assign style_key = 'item_' | append: i | append: '_btn_style'
                    assign tab_key = 'item_' | append: i | append: '_btn_new_tab'
                  -%}
                  <a
                    href="{{ block.settings[link_key] | default: '#' }}"
                    class="button {{ block.settings[style_key] }}"
                    {% if block.settings[tab_key] %}
                      target="_blank" rel="noopener"
                    {% endif %}
                  >
                    {{- block.settings[txt_key] | escape -}}
                  </a>
                {%- elsif item_type == 'badge' -%}
                  {%- liquid
                    assign icon_key = 'item_' | append: i | append: '_badge_icon'
                    assign label_key = 'item_' | append: i | append: '_badge_label'
                  -%}
                  <span class="staw-team-badge">
                    {%- if block.settings[icon_key] != blank -%}
                      <span class="staw-team-badge__icon">
                        {{-
                          block.settings[icon_key]
                          | image_url: width: 44
                          | image_tag: loading: 'lazy', width: 22, height: 22, alt: block.settings[label_key]
                          | default: ''
                        -}}
                      </span>
                    {%- endif -%}
                    {{ block.settings[label_key] | escape }}
                  </span>
                {%- endif -%}
              {%- endfor -%}
            </div>

          {%- when 'heartdivider' -%}
            <style>
              .staw-hd-block--{{ block.id }} {
                padding-top: {{ block.settings.space_top_mobile }}px;
                padding-bottom: {{ block.settings.space_bottom_mobile }}px;
              }
              @media (min-width: 1000px) {
                .staw-hd-block--{{ block.id }} {
                  padding-top: {{ block.settings.space_top }}px;
                  padding-bottom: {{ block.settings.space_bottom }}px;
                }
              }
              .staw-hd-block--{{ block.id }} .staw-hd-wrap {
                max-width: {{ block.settings.max_width }}%;
                min-width: min(260px, 100%);
                margin-inline: auto;
              }
            </style>
            <div class="staw-rich-text--new-line staw-hd-block--{{ block.id }}" {{ block.shopify_attributes }}>
              <div class="staw-hd-wrap">
                {%- render 'ed-heart-divider', margin: '0' -%}
              </div>
            </div>

          {%- when 'badge' -%}
            <span class="staw-team-badge" {{ block.shopify_attributes }}>
              {%- if block.settings.icon != blank -%}
                <span class="staw-team-badge__icon">
                  {{-
                    block.settings.icon
                    | image_url: width: 44
                    | image_tag: loading: 'lazy', width: 22, height: 22, alt: block.settings.label
                    | default: ''
                  -}}
                </span>
              {%- endif -%}
              {{ block.settings.label | escape }}
            </span>
        {%- endcase -%}
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "STAW | Content Composer",
  "class": "shopify-section--staw-rich-text",
  "disabled_on": {
    "groups": ["header", "custom.overlay"]
  },
  "settings": [
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "content_max_width",
      "label": "Inhaltsbreite",
      "info": "Gilt ab 741px Bildschirmbreite – auf Mobilgeräten immer volle Breite",
      "options": [
        { "value": "640px", "label": "Schmal (640px)" },
        { "value": "900px", "label": "Mittel (900px)" },
        { "value": "1200px", "label": "Breit (1200px)" },
        { "value": "none", "label": "Volle Breite" }
      ],
      "default": "1200px"
    },
    {
      "type": "range",
      "id": "element_gap",
      "min": 4,
      "max": 60,
      "step": 2,
      "unit": "px",
      "label": "Abstand zwischen Elementen",
      "info": "Vertikaler Abstand zwischen den Blöcken",
      "default": 24
    },
    {
      "type": "header",
      "content": "Abstände"
    },
    {
      "type": "range",
      "id": "space_top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "label": "Abstand oben",
      "default": 90
    },
    {
      "type": "range",
      "id": "space_bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "label": "Abstand unten",
      "default": 90
    },
    {
      "type": "range",
      "id": "space_top_mobile",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "label": "Abstand oben (Mobil)",
      "default": 60
    },
    {
      "type": "range",
      "id": "space_bottom_mobile",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "label": "Abstand unten (Mobil)",
      "default": 60
    },
    {
      "type": "header",
      "content": "Farben"
    },
    {
      "type": "color",
      "id": "background",
      "label": "Hintergrund",
      "default": "rgba(0,0,0,0)"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Textfarbe",
      "default": "rgba(0,0,0,0)"
    }
  ],
  "blocks": [
    {
      "type": "text",
      "name": "Textblock",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Überschrift"
        },
        {
          "type": "select",
          "id": "heading_class",
          "label": "Überschrift – Größe",
          "options": [
            { "value": "h1", "label": "H1" },
            { "value": "h2", "label": "H2" },
            { "value": "h3", "label": "H3" },
            { "value": "h4", "label": "H4" },
            { "value": "h5", "label": "H5" },
            { "value": "h6", "label": "H6" }
          ],
          "default": "h2"
        },
        {
          "type": "checkbox",
          "id": "heading_uppercase",
          "label": "Überschrift – Großbuchstaben",
          "default": false
        },
        {
          "type": "text",
          "id": "subheading",
          "label": "Unterüberschrift"
        },
        {
          "type": "select",
          "id": "subheading_class",
          "label": "Unterüberschrift – Größe",
          "options": [
            { "value": "h1", "label": "H1" },
            { "value": "h2", "label": "H2" },
            { "value": "h3", "label": "H3" },
            { "value": "h4", "label": "H4" },
            { "value": "h5", "label": "H5" },
            { "value": "h6", "label": "H6" }
          ],
          "default": "h5"
        },
        {
          "type": "checkbox",
          "id": "subheading_uppercase",
          "label": "Unterüberschrift – Großbuchstaben",
          "default": false
        },
        {
          "type": "richtext",
          "id": "content",
          "label": "Text"
        },
        {
          "type": "select",
          "id": "content_font_size",
          "label": "Text – Schriftgröße",
          "options": [
            { "value": "small", "label": "Klein (14px)" },
            { "value": "base", "label": "Standard (16px)" },
            { "value": "medium", "label": "Mittel (18px)" },
            { "value": "large", "label": "Groß (20px)" },
            { "value": "xlarge", "label": "Sehr groß (22px)" }
          ],
          "default": "base"
        },
        {
          "type": "header",
          "content": "Layout"
        },
        {
          "type": "select",
          "id": "content_max_width",
          "label": "Inhaltsbreite",
          "info": "Maximale Breite dieses Textblocks",
          "options": [
            { "value": "640px", "label": "Schmal (640px)" },
            { "value": "900px", "label": "Mittel (900px)" },
            { "value": "1200px", "label": "Breit (1200px)" },
            { "value": "none", "label": "Volle Breite" }
          ],
          "default": "none"
        },
        {
          "type": "select",
          "id": "text_alignment",
          "label": "Textausrichtung",
          "options": [
            { "value": "left", "label": "Links" },
            { "value": "center", "label": "Zentriert" },
            { "value": "right", "label": "Rechts" }
          ],
          "default": "center"
        }
      ]
    },
    {
      "type": "button",
      "name": "Button",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Button-Text",
          "default": "Jetzt entdecken"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Button-Link"
        },
        {
          "type": "select",
          "id": "style",
          "label": "Button-Stil",
          "options": [
            { "value": "button--primary", "label": "Primär (gefüllt)" },
            { "value": "button--secondary", "label": "Sekundär" },
            { "value": "button--ternary", "label": "Tertiär" },
            { "value": "button--outline", "label": "Outline (Rahmen)" }
          ],
          "default": "button--primary"
        },
        {
          "type": "checkbox",
          "id": "open_in_new_tab",
          "label": "In neuem Tab öffnen",
          "default": false
        },
        {
          "type": "select",
          "id": "alignment",
          "label": "Ausrichtung",
          "options": [
            { "value": "flex-start", "label": "Links" },
            { "value": "center", "label": "Zentriert" },
            { "value": "flex-end", "label": "Rechts" }
          ],
          "default": "center"
        }
      ]
    },
    {
      "type": "image",
      "name": "Bild",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Bild"
        },
        {
          "type": "range",
          "id": "max_width",
          "min": 100,
          "max": 900,
          "step": 20,
          "unit": "px",
          "label": "Bild-Maximalbreite (Desktop)",
          "default": 400
        },
        {
          "type": "range",
          "id": "max_width_mobile",
          "min": 80,
          "max": 500,
          "step": 20,
          "unit": "px",
          "label": "Bild-Maximalbreite (Mobil)",
          "info": "Gilt für Bildschirme unter 741px",
          "default": 280
        },
        {
          "type": "checkbox",
          "id": "drop_shadow",
          "label": "Schatten anzeigen",
          "default": false
        },
        {
          "type": "select",
          "id": "alignment",
          "label": "Bild-Ausrichtung",
          "options": [
            { "value": "flex-start", "label": "Links" },
            { "value": "center", "label": "Mitte" },
            { "value": "flex-end", "label": "Rechts" }
          ],
          "default": "center"
        }
      ]
    },
    {
      "type": "iframe",
      "name": "URL / iFrame",
      "settings": [
        {
          "type": "text",
          "id": "iframe_url",
          "label": "iFrame URL",
          "info": "URL des einzubettenden Tools (z.B. Calendly, Cal.com)"
        },
        {
          "type": "range",
          "id": "iframe_height",
          "min": 200,
          "max": 2400,
          "step": 50,
          "unit": "px",
          "label": "iFrame Höhe",
          "default": 600
        },
        {
          "type": "text",
          "id": "iframe_title",
          "label": "iFrame Titel (für Barrierefreiheit)",
          "default": "Eingebetteter Inhalt"
        }
      ]
    },
    {
      "type": "group",
      "name": "Gruppe / Zeile",
      "settings": [
        {
          "type": "paragraph",
          "content": "Kombiniere bis zu 4 Buttons und Badges nebeneinander in einer Zeile."
        },
        {
          "type": "header",
          "content": "Element 1"
        },
        {
          "type": "select",
          "id": "item_1_type",
          "label": "Typ",
          "options": [
            { "value": "none", "label": "–" },
            { "value": "button", "label": "Button" },
