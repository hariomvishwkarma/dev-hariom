{%- if section.settings.background != settings.background and section.settings.background != 'rgba(0,0,0,0)' -%}
  {%- assign blends_with_background = false -%}
{%- else -%}
  {%- assign blends_with_background = true -%}
{%- endif -%}

<style>
  #shopify-section-{{ section.id }} {
    {%- if section.settings.background == 'rgba(0,0,0,0)' -%}
      {%- assign section_background = settings.background -%}
    {%- else -%}
      {%- assign section_background = section.settings.background -%}
    {%- endif -%}

    {%- if section.settings.text_color == 'rgba(0,0,0,0)' -%}
      {%- assign heading_color = settings.heading_color -%}
      {%- assign text_color = settings.text_color -%}
    {%- else -%}
      {%- assign heading_color = section.settings.text_color -%}
      {%- assign text_color = section.settings.text_color -%}
    {%- endif -%}

    --heading-color: {{ heading_color.red }}, {{ heading_color.green }}, {{ heading_color.blue }};
    --text-color: {{ text_color.red }}, {{ text_color.green }}, {{ text_color.blue }};
    --prev-next-button-background: {{ settings.background.red }}, {{ settings.background.green }}, {{ settings.background.blue }};
    --prev-next-button-color: {{ settings.text_color.red }}, {{ settings.text_color.green }}, {{ settings.text_color.blue }};

    --section-background: {{ section_background.red }}, {{ section_background.green }}, {{ section_background.blue }};
  }

  {%- if section.settings.title == blank and section.settings.subheading == blank and section.settings.content == blank -%}
    #shopify-section-{{ section.id }} {
      --vertical-breather: 40px; /* Only on multi-column section, due to its specific usage we reduce spacing when no content */
    }

    {%- if blends_with_background or section.settings.mobile_item_size == 'small' -%}
      /* Reduce the margin on small devices to create a slightly better layout */
      @media screen and (max-width: 999px) {
        #shopify-section-{{ section.id }} {
          --vertical-breather: var(--container-gutter);
        }
      }
    {%- endif -%}
  {%- endif -%}



  #shopify-section-{{ section.id }} {
      background-color: rgb(var(--section-background));
  }

  @media (min-width: 1000px) {
      #shopify-section-{{ section.id }} .multi-column--medium {
          --section-items-per-row: 4.5;
          --multi-column-row-gap: 24px;
          --multi-column-column-gap: 24px;
      }

      {%- if section.settings.background == 'rgba(0,0,0,0)' -%}
          #shopify-section-{{ section.id }} {
              margin-top: {{ section.settings.space_top -}}px;
          }
          #shopify-section-{{ section.id }} scrollable-content {
              padding-bottom: {{ section.settings.space_bottom -}}px;
          }
      {%- else -%}
          #shopify-section-{{ section.id }} {
              padding-top: {{ section.settings.space_top -}}px;
          }
          #shopify-section-{{ section.id }} scrollable-content {
              padding-bottom: {{ section.settings.space_bottom -}}px;
          }
      {%- endif -%}
  }
  @media (max-width: 999px) {
      {%- if section.settings.background == 'rgba(0,0,0,0)' -%}
          #shopify-section-{{ section.id }} {
              margin-top: {{ section.settings.space_top_mobile -}}px;
          }
          #shopify-section-{{ section.id }} scrollable-content {
              padding-bottom: {{ section.settings.space_bottom_mobile -}}px;
          }
      {%- else -%}
          #shopify-section-{{ section.id }} {
              padding-top: {{ section.settings.space_top_mobile -}}px;
          }
          #shopify-section-{{ section.id }} scrollable-content {
              padding-bottom: {{ section.settings.space_bottom_mobile -}}px;
          }
      {%- endif -%}
  }

  
  @media (min-width: 1000px) {
    .ed_klaviyo_newsletter_form_wrap .klaviyo-form.klaviyo-form.klaviyo-form {
        max-width: 100% !important;
        width: 100% !important;
        min-width: 100% !important;
    }
    header.section__header.k_newsletter_header.text-container {
        margin-bottom: 32px;
    }
  }
  @media (max-width: 999px) {
    .ed_klaviyo_newsletter_form_wrap_mobile .klaviyo-form.klaviyo-form.klaviyo-form {
        max-width: 100% !important;
        width: 100% !important;
        min-width: 100% !important;
    }
  }
</style>

<section
  class="ed_testimonial {% if section.settings.full_width_right %}scroller-right-full{% endif %}"
>
  <div class="section__color-wrapper">
    <div class="container">
      {%- if section.settings.subheading != blank or section.settings.title != blank -%}
        <header class="section__header k_newsletter_header text-container">
          {%- if section.settings.subheading != blank -%}
            <h2 class="heading heading--small">{{ section.settings.subheading | escape }}</h2>
          {%- endif -%}

          {%- if section.settings.title != blank -%}
            <h3 class="heading h2">{{ section.settings.title | escape }}</h3>
          {%- endif -%}

          {% if section.settings.show_heart_divider %}
            {% render 'ed-heart-divider', margin: '20px' %}
          {% endif %}
        </header>
      {%- endif -%}

      <div class="ed_klaviyo_newsletter_form_wrap hidden-pocket">
        {{ section.settings.desktop_klaviyo_form_code }}
      </div>
      <div class="ed_klaviyo_newsletter_form_wrap_mobile hidden-lap-and-up">
        {{ section.settings.mobile_klaviyo_form_code }}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Klaviyo Newsletter",
  "class": "shopify-section-cro-klaviyo-newsletter",
  "disabled_on": {
    "groups": ["header", "custom.overlay"]
  },
  "settings": [
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Your subheading"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "Your title"
    },
    {
      "type": "checkbox",
      "id": "show_heart_divider",
      "label": "Show heart divider",
      "default": true
    },
    {
      "type": "header",
      "content": "Desktop Klaviyo Form code"
    },
    {
      "type": "html",
      "id": "desktop_klaviyo_form_code",
      "label": "Desktop Klaviyo Form code",
      "info": "Add the Klaviyo form code for the desktop version."
    },
    {
      "type": "header",
      "content": "Mobile Klaviyo Form code"
    },
    {
      "type": "html",
      "id": "mobile_klaviyo_form_code",
      "label": "Mobile Klaviyo Form code",
      "info": "Add the Klaviyo form code for the mobile version."
    },
    {
      "type": "header",
      "content": "Section spacing"
    },
    {
      "type": "range",
      "id": "space_top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "label": "Top space",
      "default": 100
    },
    {
      "type": "range",
      "id": "space_bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "label": "Bottom space",
      "default": 100
    },
    {
      "type": "paragraph",
      "content": "Section spacing (Mobile)"
    },
    {
      "type": "range",
      "id": "space_top_mobile",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "label": "Top (mobile)",
      "default": 60
    },
    {
      "type": "range",
      "id": "space_bottom_mobile",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "label": "Bottom (mobile)",
      "default": 60
    },
    {
      "type": "header",
      "content": "Other settings"
    },
    {
      "type": "color",
      "id": "background",
      "label": "Background",
      "default": "rgba(0,0,0,0)"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "rgba(0,0,0,0)"
    }
  ],
  "presets": [
    {
      "name": "Klaviyo Newsletter"
    }
  ]
}
{% endschema %}
