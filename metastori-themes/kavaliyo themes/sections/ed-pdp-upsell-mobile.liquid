<style>
  #shopify-section-{{ section.id }} {
    --space-top: 100px;
    --space-bottom: 100px;
    --text-color: {{ settings.text_color.red }}, {{ settings.text_color.green }}, {{ settings.text_color.blue }};
    --section-background: {{ settings.background.red }}, {{ settings.background.green }}, {{ settings.background.blue }};
  }
  #shopify-section-{{ section.id }} {
    {%- if section.settings.text_color == 'rgba(0,0,0,0)' -%}
        {%- assign text_color = settings.text_color -%}
      {%- else -%}
        {%- assign text_color = section.settings.text_color -%}
    {%- endif -%}

    {%- if section.settings.background == 'rgba(0,0,0,0)' -%}
        {%- assign section_background = settings.background -%}
      {%- else -%}
        {%- assign section_background = section.settings.background -%}
    {%- endif %}

    --space-top: {{ section.settings.space_top_mobile -}}px;
    --space-bottom: {{ section.settings.space_bottom_mobile -}}px;

    --heading-color: {{ text_color.red }}, {{ text_color.green }}, {{ text_color.blue }};
    --text-color: {{ text_color.red }}, {{ text_color.green }}, {{ text_color.blue }};
    --section-background: {{ section_background.red }}, {{ section_background.green }}, {{ section_background.blue }};
    {%- if section.settings.enable_custom_max_width -%}
      --section-max-width: {{ section.settings.custom_max_width -}}px;
    {% endif %}
  }

  @media (min-width: 1000px) {
    #shopify-section-{{ section.id }} {
      --space-top: {{ section.settings.space_top -}}px;
      --space-bottom: {{ section.settings.space_bottom -}}px;
    }
  }

  .pdp_upsell_mobile_section {
    display: block;
    color: rgb(var(--text-color));
    background: rgb(var(--section-background));
  }

  {%- if section.settings.background == 'rgba(0,0,0,0)' -%}
      .pdp_upsell_mobile_section {
          margin-top: var(--space-top);
          margin-bottom: var(--space-bottom);
      }
  {%- else -%}
      .pdp_upsell_mobile_section {
          padding-top: var(--space-top);
          padding-bottom: var(--space-bottom);
      }
  {%- endif -%}
</style>
  
<div class="pdp_upsell_mobile_section hidden-lap-and-up">
  <div class="container">
      {% for block in section.blocks %}
          {% if block.type == 'cro_cross_selling' %}
            {% render 'cro-cross-selling', product: product, block: block, section: section, scroller: false %}
          {% endif %}
      {% endfor %}
  </div>
</div>
  
{% schema %}
  {
    "name": "PDP | Attributes-Reviews",
    "enabled_on": { "templates": ["product"] },
    "settings": [
      {
        "type": "color",
        "id": "text_color",
        "label": "Text color",
        "default": "rgba(0,0,0,0)"
      },
      {
        "type": "color",
        "id": "background",
        "label": "Background",
        "default": "#F6F6F6"
      },
      {
        "type": "header",
        "content": "Section spacing"
      },
      {
        "type": "range",
        "id": "space_top",
        "min": 0,
        "max": 100,
        "step": 2,
        "unit": "px",
        "label": "Top",
        "default": 0
      },
      {
        "type": "range",
        "id": "space_bottom",
        "min": 0,
        "max": 100,
        "step": 2,
        "unit": "px",
        "label": "Bottom",
        "default": 0
      },
      {
        "type": "header",
        "content": "Section spacing (Mobile)"
      },
      {
        "type": "range",
        "id": "space_top_mobile",
        "min": 0,
        "max": 100,
        "step": 2,
        "unit": "px",
        "label": "Top (mobile)",
        "default": 32
      },
      {
        "type": "range",
        "id": "space_bottom_mobile",
        "min": 0,
        "max": 100,
        "step": 2,
        "unit": "px",
        "label": "Bottom (mobile)",
        "default": 32
      }
    ],
    "blocks": [
      {
        "type": "cro_cross_selling",
        "name": "CRO | Cross selling",
        "limit": 1,
        "settings": [
          {
            "type": "header",
            "content": "Metafield (Required)",
            "info": "This section requires a standard.cro_up_cross_selling, the 'Product' field with a List of values."
          },
          {
            "type": "range",
            "id": "cross_selling_space_top",
            "min": 0,
            "max": 100,
            "step": 1,
            "unit": "px",
            "label": "Space top",
            "default": 0
          },
          {
            "type": "range",
            "id": "cross_selling_space_bottom",
            "min": 0,
            "max": 100,
            "step": 1,
            "unit": "px",
            "label": "Space bottom",
            "default": 0
          },
          {
            "type": "select",
            "id": "cro_up_cross_selling_layout",
            "label": "Layout",
            "options": [
              {
                "value": "normal",
                "label": "Normal"
              },
              {
                "value": "stack",
                "label": "Collapsible"
              },
              {
                "value": "slides",
                "label": "Slides"
              }
            ],
            "default": "normal"
          },
          {
            "type": "inline_richtext",
            "id": "cro_up_cross_title",
            "label": "Heading",
            "default": "Buy it with"
          },
          {
            "type": "inline_richtext",
            "id": "cro_up_cross_atc_title",
            "label": "ATC Text",
            "default": "+ Add"
          },
          {
            "type": "checkbox",
            "id": "cro_up_cross_open_stack",
            "label": "Open collapsible as default",
            "default": true
          },
          {
            "type": "header",
            "content": "Mobile settings"
          },
          {
            "type": "range",
            "id": "cross_selling_space_top_mobile",
            "min": 0,
            "max": 100,
            "step": 1,
            "unit": "px",
            "label": "Space top (mobile)",
            "default": 0
          },
          {
            "type": "range",
            "id": "cross_selling_space_bottom_mobile",
            "min": 0,
            "max": 100,
            "step": 1,
            "unit": "px",
            "label": "Space bottom (mobile)",
            "default": 0
          },
          {
            "type": "color",
            "id": "content_background",
            "label": "content Background",
            "default": "rgba(0,0,0,0)"
          }
        ]
      },
    ],
    "presets": [
      {
        "name": "PDP | upsell Mobile",
        "blocks": [
          {
            "type": "cro_cross_selling"
          }
        ]
      }
    ]
  }
{% endschema %}
  