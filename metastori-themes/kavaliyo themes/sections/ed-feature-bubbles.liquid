
<style>
    #shopify-section-{{ section.id }} {
        {%- if section.settings.text_color == 'rgba(0,0,0,0)' -%}
            {%- assign heading_color = settings.heading_color -%}
            {%- assign text_color = settings.text_color -%}
        {%- else -%}
            {%- assign heading_color = section.settings.text_color -%}
            {%- assign text_color = section.settings.text_color -%}
        {%- endif -%}

        {%- if section.settings.background == 'rgba(0,0,0,0)' -%}
          {%- assign section_background = settings.background -%}
        {%- else -%}
          {%- assign section_background = section.settings.background -%}
        {%- endif -%}
    

        {%- if section.settings.content_background == 'rgba(0,0,0,0)' -%}
          {%- assign content_background = settings.background -%}
        {%- else -%}
          {%- assign content_background = section.settings.content_background -%}
        {%- endif -%}

        {%- if section.settings.background_mobile == 'rgba(0,0,0,0)' -%}
          {%- assign background_mobile = settings.background -%}
        {%- else -%}
          {%- assign background_mobile = section.settings.background_mobile -%}
        {%- endif -%}

        {%- if section.settings.content_background_mobile == 'rgba(0,0,0,0)' -%}
          {%- assign content_background_mobile = settings.background -%}
        {%- else -%}
          {%- assign content_background_mobile = section.settings.content_background_mobile -%}
        {%- endif -%}
    
        --heading-color: {{ heading_color.red }}, {{ heading_color.green }}, {{ heading_color.blue }};
        --text-color: {{ text_color.red }}, {{ text_color.green }}, {{ text_color.blue }};
        --section-background: {{ section_background.red }}, {{ section_background.green }}, {{ section_background.blue }};
        --section-background-mobile: {{ background_mobile.red }}, {{ background_mobile.green }}, {{ background_mobile.blue }};
        --content-background: {{ content_background.red }}, {{ content_background.green }}, {{ content_background.blue }};
        --content-background-mobile: {{ content_background_mobile.red }}, {{ content_background_mobile.green }}, {{ content_background_mobile.blue }};
    }

  #shopify-section-{{ section.id }} {
    --boxed-padding-tb: {{ section.settings.boxed_padding_top_bottom -}}px;
    --boxed-padding-lr: {{ section.settings.boxed_padding_left_right -}}px;
    --boxed-max-width: {{ section.settings.maximum_box_width -}}px;
    --boxed-radius: {{ section.settings.boxed_corner_radius -}}px;
    --boxed-thumbnail-height: {{ section.settings.boxed_thumbnail_height -}}px;
    --boxed-thumbnail-avatar: {{ section.settings.boxed_thumbnail_avatar -}}px;

    --full-max-width: {{ section.settings.contents_max_width_full -}}px;
    --full-thumbnail-height: {{ section.settings.full_thumbnail_height -}}px;
    --full-thumbnail-avatar: {{ section.settings.full_thumbnail_avatar -}}px;

    --tabs-buttons-size: {{  section.settings.tabs_buttons_width -}}px;
    --tabs-buttons-size-offset: {{  section.settings.tabs_buttons_width | divided_by: 2 | times: -1 -}}px;
    --tabs-buttons-position: {{ section.settings.tabs_buttons_position }};
    --tabs-buttons-gap: {{ section.settings.tabs_buttons_gap -}}px;
    --tabs-buttons-font-size: {{ section.settings.tabs_buttons_font_size -}}px;
    --tabs-buttons-weight: {{ section.settings.tabs_buttons_font_weight }};
    --tabs-btn-text-color: {{ section.settings.button_text_color }};
    --tabs-btn-active-text-color: {{ section.settings.button_active_text_color }};
    --tabs-btn-border-color: {{ section.settings.border_color }};
    --tabs-btn-border-color-active: {{ section.settings.button_active_border_color }};
    {% if section.settings.tabs_buttons_uppercase %}
      --tabs-buttons-uppercase: uppercase;
    {% endif %}

    --tabs-content-position: {{ section.settings.tabs_content_position }};

    --mobile-thumbnail: {{  section.settings.mobile_thumbnail_height -}}px;
    --mobile-thumbnail-avatar: {{  section.settings.mobile_thumbnail_avatar_width -}}px;
    --mobile-buttons-size: {{  section.settings.mobile_buttons_width -}}px;
    --mobile-buttons-size-offset: {{  section.settings.mobile_buttons_width | divided_by: 2 | times: -1 -}}px;
    --mobile-buttons-font-size: {{  section.settings.mobile_buttons_font_size -}}px;
    --mobile-buttons-justify: {{  section.settings.mobile_tabs_buttons_position }};
    --mobile-buttons-gap: {{  section.settings.mobile_buttons_gaps -}}px;
    --mobile-content-position: {{ section.settings.mobile_content_position }};
  }


  @media (min-width: 1000px) {
    .ed_tabs_section {
        {% if section.settings.background == 'rgba(0,0,0,0)' %}
            margin-top: {{ section.settings.space_top -}}px;
          margin-bottom: {{ section.settings.space_bottom -}}px;
        {% else %}
            padding-top: {{ section.settings.space_top -}}px;
            padding-bottom: {{ section.settings.space_bottom -}}px;
        {% endif %}
    }
    .ed_tabs_section.ed_tabs-full {
        background: rgb(var(--section-background));
    }
  }

  @media (max-width: 999px) {
    .ed_tabs_section {
        {% if section.settings.background_mobile == 'rgba(0,0,0,0)' %}
            margin-top: {{ section.settings.space_top_mobile -}}px;
            margin-bottom: {{ section.settings.space_bottom_mobile -}}px;
        {% else %}
            padding-top: {{ section.settings.space_top_mobile -}}px;
            padding-bottom: {{ section.settings.space_bottom_mobile -}}px;
        {% endif %}
    }
    .ed_tabs_section.ed_tabs-full {
        background: rgb(var(--section-background-mobile));
    }
  }
</style>

<style>
  /* Tabs css */
  .ed_tabs_section.ed_tabs-boxed {
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    position: relative;
  }
  .ed_tabs_section.ed_tabs-full .ed_tabs_section_inner {
    border-radius: var(--boxed-radius);
    overflow: hidden;
  }
  .ed_tabs_menu {
      display: flex;
      flex-wrap: wrap;
      align-items: flex-start;
      z-index: 1;
      width: 100%;
  }

  .ed_tabs__button {
      border: none;
      background: transparent;
      text-decoration: none;
      cursor: pointer;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      gap: 0px;
  }
  .ed_tabs__button-avatar {
      object-fit: cover;
      padding: 14px;
      object-position: center center;
      background-color: #ffffff;
      {% if section.settings.show_border %}
        border-style: solid;
        border-width: {{ section.settings.border_size  -}}px;
        border-color: var(--tabs-btn-border-color);
      {% endif %}
  }
  button.ed_tabs__button.circle.active  .ed_tabs__button-avatar {
        border-color: var(--tabs-btn-border-color-active);
  }
  .ed_tabs__button.circle img.ed_tabs__button-avatar {
      border-radius: 500px;
  }
  button.ed_tabs__button.circle svg.ed_tabs__button-avatar {
      border-radius: 500px;
  }
  .ed_tabs__button.rounded img.ed_tabs__button-avatar {
      border-radius: 6px;
  }
  p.ed_tabs_button-text {
      color:rgb(var(--tabs-btn-text-color));
      text-transform: var(--tabs-buttons-uppercase);
      font-weight: var(--tabs-buttons-weight);
      margin: 0;
  }
  button.ed_tabs__button.active p.ed_tabs_button-text {
     {% if section.settings.active_underline_text %}
        text-decoration: underline;
        text-underline-position: under;
     {% endif %}
      color: var(--tabs-btn-active-text-color);
  }

  .ed_tabs__thumbnail {
      display: none;
  }

  .ed_tabs__thumbnail.active {
      display: block;
  }

  .ed_tab_content_wrapper {}

  .ed_tabs__content {
      display: none;
  }
  .ed_tabs__content.active {
      display: block;
  }
  .ed_tabs_content_inner {}

  .ed_tabs_content-media {
      width: 100%;
      background-repeat: no-repeat;
      background-position: center center;
      background-size: cover;
      overflow: hidden;
      text-align: right;
  }
  svg.ed_tabs_content-media-svg {
      width: 100%;
      height: 100%;
      background: #F0ECE0;
      opacity: 0.85;
  }

  .ed_tabs-boxed .ed_tabs_content-contents {
      padding: 32px 24px;
  }
  .ed_tabs-full .ed_tabs_content-contents {
      padding: 22px 30px;
  }

  .ed_tabs_content-contents-inner {
      color: rgb(var(--text-color));
      word-break: break-word;
  }
  .ed_tabs_content-contents-inner > ul {
      padding-left: 26px;
      margin-bottom: 16px;
      {% if section.settings.list_icon != blank %}
        list-style-image: url({{ section.settings.list_icon | image_url: width: 24 }});
      {% else %}
        list-style-image: url(/cdn/shop/files/star.svg);
      {% endif %}

  }

  .ed_tabs_content-contents-inner > ul li {
      margin: 0 0 0;
      padding-left: 6px;
  }


  /* Boxed */
  .ed_tabs-boxed {
      max-width: var(--boxed-max-width);
  }

  /* Full-width */
  .ed_tabs-full .ed_tabs_menu,
  .ed_tabs-full .ed_tabs_content_inner {
      max-width: var(--full-max-width);
      {%- if section.settings.content_position_full == 'left' -%}
          margin-right: auto;
      {%- elsif section.settings.content_position_full == 'right' -%}
          margin-left: auto;
      {%- else -%}
          margin-left: auto;
          margin-right: auto;
      {%- endif -%}
  }


  @media (min-width: 1000px) {
    .ed_tabs_section.ed_tabs-boxed,
    .ed_tabs_section.ed_tabs-full .ed_tabs_section_inner {
        background: rgb(var(--content-background));
      }
      .ed_tabs-boxed {
          padding-top: var(--boxed-padding-tb);
          padding-bottom: var(--boxed-padding-tb);
          padding-left: var(--boxed-padding-lr);
          padding-right: var(--boxed-padding-lr);
          border-radius: var(--boxed-radius);
      }

      .ed_tabs-boxed .ed_tabs_content-media {
          height: var(--boxed-thumbnail-height);
      }
      .ed_tabs-boxed .ed_tabs_content-media {
          border-radius: var(--boxed-radius);
      }
      .ed_tabs-full .ed_tabs_content-media {
          height: var(--full-thumbnail-height);
          background-color: rgb(var(--content-background));
          min-height: var(--full-thumbnail-height);
      }
      img.ed_tabs_content-media-avatar {
          height: auto;
      }

      .ed_tabs-boxed img.ed_tabs_content-media-avatar {
          width: var(--boxed-thumbnail-avatar);
          margin-top: 18px;
          margin-right: 18px;
      }
      .ed_tabs-full img.ed_tabs_content-media-avatar {
          width: var(--full-thumbnail-avatar);
          margin-top: 24px;
          margin-right: 24px;
      }

      .ed_tabs_menu {
          justify-content: var(--tabs-buttons-position);
          gap: var(--tabs-buttons-gap);
          margin-top: var(--tabs-buttons-size-offset);
      }
      .ed_tabs__button-avatar {
          width: var(--tabs-buttons-size);
          height: var(--tabs-buttons-size);
      }
      .ed_tabs_button-text {
          font-size: var(--tabs-buttons-font-size);
          letter-spacing: 0px;
          min-width: max-content;
      }
      .ed_tabs_content-contents-inner {
          text-align: var(--tabs-content-position);
      }

  }
  @media (max-width: 999px) {
    .ed_tabs_section.ed_tabs-boxed,
    .ed_tabs_section.ed_tabs-full .ed_tabs_section_inner {
        background: rgb(var(--content-background-mobile));
      }
      .ed_tabs_section.ed_tabs-boxed {
          padding: 0;
      }
      .ed_tabs_menu {
          gap: var(--mobile-buttons-gap);
          justify-content: var(--mobile-buttons-justify);
          padding-left: 0;
          padding-right: 0;
          margin-top: var(--mobile-buttons-size-offset);
      }
      .ed_tabs__button-avatar {
          width: var(--mobile-buttons-size);
          height: var(--mobile-buttons-size);
      }
      .ed_tabs_content-media {
          height: var(--mobile-thumbnail);
          background-color: rgb(var(--content-background-mobile));
          min-height: var(--mobile-thumbnail);
      }
      img.ed_tabs_content-media-avatar {
          width: var(--mobile-thumbnail-avatar);
          margin-top: 12px;
          margin-right: 12px;
      }
      p.ed_tabs_button-text {
          font-size: var(--mobile-buttons-font-size);
          letter-spacing: 0px;
          display: var(--mobile-buttons-hide-label);
      }
      {% if section.settings.hide_buttons_label_at_mobile %}
          p.ed_tabs_button-text {
              display: none;
          }
          button.ed_tabs__button.circle.active img.ed_tabs__button-avatar {
              border-color: var(--tabs-btn-border-color-active);
          }
      {% endif %}

      .ed_tabs_content-contents-inner {
          text-align: var(--mobile-content-position);
      }

    .ed_tabs__button {
        gap: 0;
    }
    .ed_tabs-full .ed_tabs_content-contents {
        padding: 22px 16px;
    }

  }
</style>

{%- capture tabs_thumbnails -%}
    {%- for block in section.blocks -%}
        {%- if block.type == 'item' -%}
            <div class="ed_tabs__thumbnail" {{ block.shopify_attributes }}>
                <div class="ed_tabs_content-media" {% if block.settings.thumbnail != blank %} style="background-image: url({{ block.settings.thumbnail | image_url: width: block.settings.thumbnail.width }})"{% endif %}>
                    {%- if block.settings.thumbnail_avatar != blank -%}
                        {{- block.settings.thumbnail_avatar | image_url: width: block.settings.thumbnail_avatar.width | image_tag: sizes: '100vw', widths: '150, 200, 300, 500, 800', alt: block.settings.thumbnail_avatar.alt, class: 'ed_tabs_content-media-avatar' -}}
                    {%- endif -%}
                
                    {%- if block.settings.thumbnail == blank -%}
                        {{ 'image' | placeholder_svg_tag:'ed_tabs_content-media-svg' }}
                    {%- endif -%}
                </div>
            </div>
        {%- endif -%}
    {%- endfor -%}
{%- endcapture -%}

{%- capture tabs_buttons -%}
    {%- for block in section.blocks -%}
        {%- if block.type == 'item' -%}
            <button type="button" class="ed_tabs__button {{ section.settings.buttons_style }}" {{ block.shopify_attributes }}
            style="
            {%- if block.settings.text_color != 'rgba(0,0,0,0)' -%}
                --tabs-btn-text-color: {{ block.settings.text_color }};
            {%- endif -%}
             {%- if block.settings.active_text_color != 'rgba(0,0,0,0)' -%}
                --tabs-btn-active-text-color: {{ block.settings.active_text_color }};
            {%- endif -%}
            {%- if block.settings.border_color != 'rgba(0,0,0,0)' -%}
                --tabs-btn-border-color: {{ block.settings.border_color }};
            {%- endif -%}
            {%- if block.settings.active_border_color != 'rgba(0,0,0,0)' -%}
                --tabs-btn-border-color-active: {{ block.settings.active_border_color }};
            {%- endif -%}
            "
            >
                {%- if block.settings.button_image != blank -%}
                    {{- block.settings.button_image | image_url: width: block.settings.button_image.width | image_tag: sizes: '100vw', widths: '100', alt: block.settings.button_image.alt, class: 'ed_tabs__button-avatar' -}}
                {%- else -%}
                    {{ 'image' | placeholder_svg_tag: 'ed_tabs__button-avatar' }}
                {%- endif -%}

                {%- if block.settings.button_label != blank -%}
                    <p class="ed_tabs_button-text heading">{{ block.settings.button_label }}</p>
                {%- endif -%}
            </button>
        {%- endif -%}
    {%- endfor -%}
{%- endcapture -%}

{%- capture tabs_contents -%}
    {%- for block in section.blocks -%}
        {%- if block.type == 'item' -%}
            <div class="ed_tabs__content" {{ block.shopify_attributes }}>
                <div class="ed_tabs_content_inner">
                    <div class="ed_tabs_content-contents">
                        <div class="ed_tabs_content-contents-inner">
                            {{  block.settings.content }}
                        </div>
                    </div>
                </div>
            </div>
        {%- endif -%}
    {%- endfor -%}
{%- endcapture -%}

<div class="ed_tabs_section ed_tabs-{{ section.settings.layout_style }}">
  {%- if section.settings.layout_style == 'full' -%}
    <div class="container">
    <div class="ed_tabs_section_inner">
  {%- endif -%}
    <div class="ed_tab_content_wrapper">
        {{ tabs_thumbnails }}
    </div>
    <div class="ed_tabs_menu">
        {{ tabs_buttons }}
    </div>

    <div class="ed_tab_content_wrapper">
        {{ tabs_contents }}
    </div>
  {%- if section.settings.layout_style == 'full' -%}
    </div></div>
  {%- endif -%}
</div>

<script>
  function initEdTabsSection() {
    const tabContainers = document.querySelectorAll('.ed_tabs_section');

    tabContainers.forEach((container) => {
      const tabButtons = container.querySelectorAll('.ed_tabs__button');
      const tabContents = container.querySelectorAll('.ed_tabs__content');
      const tabThumbnails = container.querySelectorAll('.ed_tabs__thumbnail');

      tabButtons.forEach((btn, index) => {
        btn.addEventListener('click', function () {
          // Remove active classes from all buttons and contents in this container
          tabButtons.forEach((t) => t.classList.remove('active'));
          tabContents.forEach((c) => c.classList.remove('active'));
          tabThumbnails.forEach((c) => c.classList.remove('active'));

          // Add active class to the clicked tab and corresponding content
          btn.classList.add('active');
          tabContents[index].classList.add('active');
          tabThumbnails[index].classList.add('active');
        });
      });

      // Optionally activate the first tab by default
      tabButtons[0].classList.add('active');
      tabContents[0].classList.add('active');
      tabThumbnails[0].classList.add('active');
    });
  }

  document.addEventListener('DOMContentLoaded', function () {
    initEdTabsSection();
  });

  if (typeof Shopify !== 'undefined' && Shopify.designMode) {
    document.addEventListener('shopify:section:load', function () {
      initEdTabsSection();
    });
  }
</script>

{% schema %}
{
  "name": "CRO | Feature Bubbles",
  "class": "cro-feature-bubbles",
  "settings": [
    {
        "type": "color",
        "id": "text_color",
        "label": "Text color",
        "default": "rgba(0,0,0,0)"
    },
    {
      "type": "color",
      "id": "background",
