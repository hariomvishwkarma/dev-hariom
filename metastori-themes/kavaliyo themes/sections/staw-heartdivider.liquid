<style>
  #shopify-section-{{ section.id }} {
    {%- if section.settings.background == 'rgba(0,0,0,0)' -%}
      {%- assign section_background = settings.background -%}
    {%- else -%}
      {%- assign section_background = section.settings.background -%}
    {%- endif -%}

    --section-background: {{ section_background.red }}, {{ section_background.green }}, {{ section_background.blue }};

    background-color: rgb(var(--section-background));
    padding-top: {{ section.settings.space_top }}px;
    padding-bottom: {{ section.settings.space_bottom }}px;
  }

  @media (max-width: 999px) {
    #shopify-section-{{ section.id }} {
      padding-top: {{ section.settings.space_top_mobile }}px;
      padding-bottom: {{ section.settings.space_bottom_mobile }}px;
    }
  }

  #shopify-section-{{ section.id }} .staw-hd-wrap {
    max-width: {{ section.settings.max_width }}%;
    min-width: min(260px, 100%);
    margin-inline: auto;
  }
</style>

<div class="staw-hd-wrap">
  {%- render 'ed-heart-divider', margin: '0' -%}
</div>

{% schema %}
{
  "name": "STAW | Heart Divider",
  "class": "shopify-section--staw-heartdivider",
  "disabled_on": {
    "groups": ["header", "custom.overlay"]
  },
  "settings": [
    {
      "type": "select",
      "id": "max_width",
      "label": "Breite",
      "options": [
        { "value": "100", "label": "Volle Breite (100%)" },
        { "value": "75", "label": "75%" },
        { "value": "50", "label": "50%" },
        { "value": "25", "label": "25%" }
      ],
      "default": "100"
    },
    {
      "type": "header",
      "content": "Abstände"
    },
    {
      "type": "range",
      "id": "space_top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "label": "Abstand oben",
      "default": 0
    },
    {
      "type": "range",
      "id": "space_bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "label": "Abstand unten",
      "default": 0
    },
    {
      "type": "range",
      "id": "space_top_mobile",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "label": "Abstand oben (Mobil)",
      "default": 0
    },
    {
      "type": "range",
      "id": "space_bottom_mobile",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "label": "Abstand unten (Mobil)",
      "default": 0
    },
    {
      "type": "header",
      "content": "Farben"
    },
    {
      "type": "color",
      "id": "background",
      "label": "Hintergrund",
      "default": "rgba(0,0,0,0)"
    }
  ],
  "presets": [
    {
      "name": "STAW | Heart Divider"
    }
  ]
}
{% endschema %}
