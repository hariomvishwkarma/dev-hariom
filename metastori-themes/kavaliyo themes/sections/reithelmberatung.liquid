{{ 'reithelmberatung.css' | asset_url | stylesheet_tag }}

<style>
  #shopify-section-{{ section.id }} {
    {%- if section.settings.background == 'rgba(0,0,0,0)' -%}
      {%- assign section_background = settings.background -%}
    {%- else -%}
      {%- assign section_background = section.settings.background -%}
    {%- endif -%}

    {%- if section.settings.text_color == 'rgba(0,0,0,0)' -%}
      {%- assign heading_color = settings.heading_color -%}
      {%- assign text_color = settings.text_color -%}
    {%- else -%}
      {%- assign heading_color = section.settings.text_color -%}
      {%- assign text_color = section.settings.text_color -%}
    {%- endif -%}

    --heading-color: {{ heading_color.red }}, {{ heading_color.green }}, {{ heading_color.blue }};
    --text-color: {{ text_color.red }}, {{ text_color.green }}, {{ text_color.blue }};
    --section-background: {{ section_background.red }}, {{ section_background.green }}, {{ section_background.blue }};
  }

  #shopify-section-{{ section.id }} {
    background-color: rgb(var(--section-background));
  }

  {%- if section.settings.section_type == 'brands' -%}
  #shopify-section-{{ section.id }} .rhb-brand-card--bg {
    height: {{ section.settings.card_height }}px;
  }
  {%- endif -%}

  @media (min-width: 1000px) {
    #shopify-section-{{ section.id }} {
      padding-top: {{ section.settings.space_top }}px;
      padding-bottom: {{ section.settings.space_bottom }}px;
    }
  }

  @media (max-width: 999px) {
    #shopify-section-{{ section.id }} {
      padding-top: {{ section.settings.space_top_mobile }}px;
      padding-bottom: {{ section.settings.space_bottom_mobile }}px;
    }
  }
</style>

{%- if section.settings.heart_divider_top -%}
  <div class="staw-hd-wrap" style="max-width: {{ section.settings.heart_divider_width }}%; margin-inline: auto;">
    {%- render 'ed-heart-divider', margin: '20px' -%}
  </div>
{%- endif -%}

{%- if section.settings.section_type == 'booking' -%}
  <section class="rhb-section rhb-booking" {% if section.settings.anchor_id != blank %}id="{{ section.settings.anchor_id }}"{% endif %}>
    <div class="container">
      <header class="section__header section__header--center text-container">
        {%- if section.settings.subheading != blank -%}
          <h2 class="heading heading--small">{{ section.settings.subheading | escape }}</h2>
        {%- endif -%}

        {%- if section.settings.heading != blank -%}
          <h3 class="heading h2">{{ section.settings.heading | escape }}</h3>
        {%- endif -%}

        {%- if section.settings.description != blank -%}
          <div class="rhb-description">{{ section.settings.description }}</div>
        {%- endif -%}
      </header>

      {%- if section.settings.team_image != blank -%}
        <div class="rhb-team-image">
          {{ section.settings.team_image | image_url: width: 800 | image_tag: loading: 'lazy', class: 'rhb-team-image__img', alt: section.settings.team_image.alt | default: 'Team' }}
        </div>
      {%- endif -%}

      {%- if section.settings.show_heart_divider -%}
        {% render 'ed-heart-divider', margin: '30px' %}
      {%- endif -%}

      {%- if section.settings.iframe_url != blank -%}
        <div class="rhb-iframe-wrapper">
          <iframe
            src="{{ section.settings.iframe_url }}"
            width="100%"
            height="{{ section.settings.iframe_height | default: '600' }}"
            frameborder="0"
            loading="lazy"
            allow="clipboard-write"
            title="Beratungstermin buchen"
          ></iframe>
        </div>
      {%- else -%}
        <div class="rhb-iframe-placeholder">
          <p>iframe-Platzhalter: Bitte iframe-URL in den Section-Einstellungen hinterlegen.</p>
        </div>
      {%- endif -%}
    </div>
  </section>

{%- elsif section.settings.section_type == 'brands' -%}
  <section class="rhb-section rhb-brands" {% if section.settings.anchor_id != blank %}id="{{ section.settings.anchor_id }}"{% endif %}>
    <div class="container">
      <header class="section__header section__header--center text-container">
        {%- if section.settings.subheading != blank -%}
          <h2 class="heading heading--small">{{ section.settings.subheading | escape }}</h2>
        {%- endif -%}

        {%- if section.settings.heading != blank -%}
          <h3 class="heading h2">{{ section.settings.heading | escape }}</h3>
        {%- endif -%}

        {%- if section.settings.description != blank -%}
          <div class="rhb-description">{{ section.settings.description }}</div>
        {%- endif -%}
      </header>

      {%- if section.blocks.size > 0 -%}
        <div class="rhb-brands-grid">
          {%- for block in section.blocks -%}
            <div
              class="rhb-brand-card{% if block.settings.card_image != blank %} rhb-brand-card--bg{% endif %}"
              {% if block.settings.card_image != blank %}
                style="background-image: url('{{ block.settings.card_image | image_url: width: 900 }}');"
              {% endif %}
              {{ block.shopify_attributes }}
            >
              {%- if block.settings.logo != blank -%}
                <div class="rhb-brand-card__logo">
                  {{ block.settings.logo | image_url: width: 300 | image_tag: loading: 'lazy', alt: block.settings.title | default: 'Brand Logo' }}
                </div>
              {%- elsif block.settings.title != blank -%}
                <div class="rhb-brand-card__logo rhb-brand-card__logo--text">
                  <p class="heading h5">{{ block.settings.title | escape }}</p>
                </div>
              {%- endif -%}

              {%- if block.settings.card_image == blank -%}
                <div class="rhb-brand-card__image rhb-brand-card__image--placeholder">
                  {{ 'product-1' | placeholder_svg_tag }}
                </div>
              {%- endif -%}

              {%- if block.settings.button_text != blank -%}
                <div class="rhb-brand-card__action">
                  <a
                    href="{{ block.settings.button_url | default: '#' }}"
                    class="button button--primary"
                    {% if block.settings.open_in_new_tab %}target="_blank" rel="noopener"{% endif %}
                  >
                    {{ block.settings.button_text | escape }}
                  </a>
                </div>
              {%- endif -%}
            </div>
          {%- endfor -%}
        </div>
      {%- endif -%}
    </div>
  </section>
{%- endif -%}

{%- if section.settings.heart_divider_bottom -%}
  <div class="staw-hd-wrap" style="max-width: {{ section.settings.heart_divider_width }}%; margin-inline: auto;">
    {%- render 'ed-heart-divider', margin: '20px' -%}
  </div>
{%- endif -%}

{% schema %}
{
  "name": "Reithelmberatung",
  "class": "shopify-section--reithelmberatung",
  "disabled_on": {
    "groups": ["header", "custom.overlay"]
  },
  "settings": [
    {
      "type": "select",
      "id": "section_type",
      "label": "Section-Typ",
      "options": [
        { "value": "booking", "label": "Beratung buchen (mit iframe)" },
        { "value": "brands", "label": "Marken-Konfiguratoren" }
      ],
      "default": "booking"
    },
    {
      "type": "text",
      "id": "anchor_id",
      "label": "Anchor-ID (ohne #)",
      "info": "Für Ankerlinks, z.B. 'beratung' für #beratung"
    },
    {
      "type": "header",
      "content": "Inhalte"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Überschrift"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Unterüberschrift"
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "Beschreibung"
    },
    {
      "type": "header",
      "content": "Marken: Einstellungen"
    },
    {
      "type": "range",
      "id": "card_height",
      "min": 150,
      "max": 475,
      "step": 5,
      "unit": "px",
      "label": "Kartenhöhe",
      "info": "Nur im Modus 'Marken-Konfiguratoren' wirksam",
      "default": 400
    },
    {
      "type": "header",
      "content": "Trennlinie (Heart Divider)"
    },
    {
      "type": "checkbox",
      "id": "heart_divider_top",
      "label": "Trennlinie oben",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "heart_divider_bottom",
      "label": "Trennlinie unten",
      "default": false
    },
    {
      "type": "select",
      "id": "heart_divider_width",
      "label": "Trennlinien-Breite",
      "options": [
        { "value": "100", "label": "Volle Breite" },
        { "value": "75", "label": "75%" },
        { "value": "50", "label": "50%" }
      ],
      "default": "100"
    },
    {
      "type": "header",
      "content": "Abstände"
    },
    {
      "type": "range",
      "id": "space_top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "label": "Abstand oben",
      "default": 60
    },
    {
      "type": "range",
      "id": "space_bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "label": "Abstand unten",
      "default": 60
    },
    {
      "type": "range",
      "id": "space_top_mobile",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "label": "Abstand oben (Mobile)",
      "default": 40
    },
    {
      "type": "range",
      "id": "space_bottom_mobile",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "label": "Abstand unten (Mobile)",
      "default": 40
    },
    {
      "type": "header",
      "content": "Farben"
    },
    {
      "type": "color",
      "id": "background",
      "label": "Hintergrund",
      "default": "rgba(0,0,0,0)"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Textfarbe",
      "default": "rgba(0,0,0,0)"
    }
  ],
  "blocks": [
    {
      "type": "brand_card",
      "name": "Marken-Karte",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Markenname"
        },
        {
          "type": "image_picker",
          "id": "logo",
          "label": "Logo"
        },
        {
          "type": "image_picker",
          "id": "card_image",
          "label": "Kartenbild"
        },
        {
          "type": "text",
          "id": "button_text",
          "label": "Button-Text",
          "default": "Jetzt konfigurieren"
        },
        {
          "type": "url",
          "id": "button_url",
          "label": "Button-Link"
        },
        {
          "type": "checkbox",
          "id": "open_in_new_tab",
          "label": "In neuem Tab öffnen",
          "default": false
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Reithelmberatung",
      "settings": {
        "section_type": "booking",
        "heading": "Deine persönliche Beratung buchen"
      }
    }
  ]
}
{% endschema %}
