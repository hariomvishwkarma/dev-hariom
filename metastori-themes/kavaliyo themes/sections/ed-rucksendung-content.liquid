<style>
    #shopify-section-{{ section.id }} {
        {%- if section.settings.background == 'rgba(0,0,0,0)' -%}
          {%- assign section_background = settings.background -%}
        {%- else -%}
          {%- assign section_background = section.settings.background -%}
        {%- endif -%}

        {%- if section.settings.text_color == 'rgba(0,0,0,0)' -%}
          {%- assign heading_color = settings.heading_color -%}
          {%- assign text_color = settings.text_color -%}
        {%- else -%}
          {%- assign heading_color = section.settings.text_color -%}
          {%- assign text_color = section.settings.text_color -%}
        {%- endif -%}

        --heading-color: {{ heading_color.red }}, {{ heading_color.green }}, {{ heading_color.blue }};
        --text-color: {{ text_color.red }}, {{ text_color.green }}, {{ text_color.blue }};
        --prev-next-button-background: {{ settings.background.red }}, {{ settings.background.green }}, {{ settings.background.blue }};
        --prev-next-button-color: {{ settings.text_color.red }}, {{ settings.text_color.green }}, {{ settings.text_color.blue }};

        --section-background: {{ section_background.red }}, {{ section_background.green }}, {{ section_background.blue }};
    }



  {%- for block in section.blocks -%}
    {%- if block.type == 'item'  -%}
        #block-{{ section.id }}-{{ block.id }} {
            {%- if block.settings.background == 'rgba(0,0,0,0)' -%}
                {%- assign section_background = settings.background -%}
              {%- else -%}
                {%- assign section_background = block.settings.background -%}
              {%- endif -%}

              {%- if block.settings.text_color == 'rgba(0,0,0,0)' -%}
                {%- assign block_text_color = settings.text_color -%}
              {%- else -%}
                {%- assign block_text_color = block.settings.text_color -%}
              {%- endif -%}

              --background: {{ section_background.red }}, {{ section_background.green }}, {{ section_background.blue }};
              --heading-color: {{ block_text_color.red }}, {{ block_text_color.green }}, {{ block_text_color.blue }};
              --text-color: {{ block_text_color.red }}, {{ block_text_color.green }}, {{ block_text_color.blue }};
        }
    {%- endif -%}

    {%- if block.type == 'support_team'  -%}
        #block-{{ section.id }}-{{ block.id }} {
            {%- if block.settings.background == 'rgba(0,0,0,0)' -%}
                {%- assign section_background = settings.background -%}
              {%- else -%}
                {%- assign section_background = block.settings.background -%}
              {%- endif -%}

              {%- if block.settings.text_color == 'rgba(0,0,0,0)' -%}
                {%- assign block_text_color = settings.text_color -%}
              {%- else -%}
                {%- assign block_text_color = block.settings.text_color -%}
              {%- endif -%}

              --background: {{ section_background.red }}, {{ section_background.green }}, {{ section_background.blue }};
              --heading-color: {{ block_text_color.red }}, {{ block_text_color.green }}, {{ block_text_color.blue }};
              --text-color: {{ block_text_color.red }}, {{ block_text_color.green }}, {{ block_text_color.blue }};
        }
    {%- endif -%}
  {%- endfor -%}

  #shopify-section-{{ section.id }}{
    background-color: {{ section.settings.background }};
  }
  @media (min-width: 1000px) {
    #shopify-section-{{ section.id }} {
      padding-top: {{ section.settings.space_top -}}px;
      padding-bottom: {{ section.settings.space_bottom -}}px;
    }
  }
  @media (max-width: 999px) {
    #shopify-section-{{ section.id }} {
      padding-top: {{ section.settings.space_top_mobile -}}px;
      padding-bottom: {{ section.settings.space_bottom_mobile -}}px;
    }

  }

  {% if section.settings.custom_content_size == true %}
    @media (min-width: 1000px) {
        #shopify-section-{{ section.id }} .section__rucksendung_heading__conent > * {
            font-size: {{ section.settings.content_size }}px;
            line-height: 1.5;
        }
    }
    @media (max-width: 999px) {
        #shopify-section-{{ section.id }} .section__rucksendung_heading__conent > * {
            font-size: {{ section.settings.content_size_mobile }}px;
            line-height: 1.5;
        }
    }
  {% endif %}

  {% if section.settings.custom_title_size == true %}
    @media (min-width: 1000px) {
        #shopify-section-{{ section.id }}  .multi-column__item .heading {
            font-size: {{ section.settings.item_title_size }}px !important;
            margin-bottom: 8px;
        }
    }
    @media (max-width: 999px) {
        #shopify-section-{{ section.id }}  .multi-column__item .heading {
            font-size: {{ section.settings.item_title_size_mobile }}px !important;
            margin-bottom: 8px;
        }
    }
  {% endif %}

  {% if section.settings.custom_item_content_size == true %}
    @media (min-width: 1000px) {
        #shopify-section-{{ section.id }}  .multi-column__item p {
            font-size: {{ section.settings.item_content_size }}px;
            margin: 0;
            line-height: 1.5;
        }
    }
    @media (max-width: 999px) {
        #shopify-section-{{ section.id }}  .multi-column__item p {
            font-size: {{ section.settings.item_content_size_mobile }}px;
            margin: 0;
            line-height: 1.5;
        }
    }
  {% endif %}


  @media screen and (min-width: 1200px) {
    #shopify-section-{{ section.id }} .multi-column--medium {
            --section-items-per-row: 4;
        }
    }
</style>

<style>
  .ed_rucksendung_content_wrapper {
    display: grid;
    gap: 26px;
    grid-template-columns: repeat(2, 1fr);
  }

  .ed_rucksendung_content__item {
    border-radius: 16px;
    background: rgb(var(--background));
    padding: 40px 32px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    align-items: flex-start;
  }

  .ed_rucksendung_content__item h4.heading {
    text-transform: uppercase;
  }

  .ed_rucksendung_content__item_heading {
    text-transform: uppercase;
    font-weight: 300;
    margin-bottom: 32px;
  }

  .ed_rucksendung_content__item_heading P {
    margin: 0;
    font-weight: 300;
  }

  .ed_rucksendung_content__item_heading strong {
    font-weight: 600;
  }



  .ed_rucksendung_content__item_content ul {
    margin: 0;
    padding: 0;
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .ed_rucksendung_content__item_content ul li {
    padding-left: 30px;
    position: relative;
  }
  .ed_rucksendung_content__item_content ul li:before {
    content: '';
    position: absolute;
    width: 24px;
    height: 30px;
    left: 0;
    top: 0;
    background: url('{{ "checkmark.svg" | asset_url }}');
    background-repeat: no-repeat;
    background-size: contain;
    background-position: center center;
  }

  .ed_rucksendung_content__item_content_buttons {
    display: flex;
    align-items: center;
    justify-content: flex-start;
    margin-top: 32px;
    gap: 10px;
  }

  .ed_rucksendung_content__item_content_buttons .button {
    border-radius: 500px;
    text-transform: uppercase !important;
    letter-spacing: 0;
  }

  .ed_rucksendung_content_blockquote {
    background: #f8f8f8;
    border-left: 2px solid #58c5b4;
    padding: 16px 16px;
    border-radius: 2px;
    margin-block: 20px;
  }

  .ed_rucksendung_support_wrapper {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 32px;
    padding: 40px;
    margin-top: 60px;
    border: 1px solid #cbcbcb;
    border-radius: 16px;
    background: #f5f5f5;
  }

  .ed_rucksendung_support__media {
    display: flex;
    max-width: 244px;
  }

  .ed_rucksendung_support__content_buttons {
    display: flex;
  }

  .ed_rucksendung_support__content_inner {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .ed_rucksendung_support__content_inner h4.heading {
    margin: 0;
    letter-spacing: 0%;
    text-transform: uppercase;
  }

  .ed_rucksendung_support__content_inner .ed_rucksendung_content__item_content_buttons {
    margin: 0;
  }
  .ed_rucksendung_support__content_buttons .button {
    border-radius: 500px;
  }

  .ed_rucksendung_support__media_image {
    border: 2px solid #f5f5f5;
    width: 106px;
    height: 106px;
    position: relative;
    border-radius: 500px;
    overflow: hidden;
  }

  .ed_rucksendung_support__media_image img {
    position: absolute;
    left: 0;
    top: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: flex;
  }

  .ed_rucksendung_support__media .ed_rucksendung_support__media_image:nth-child(2) {
    margin-left: -15%;
    z-index: 2;
  }

  .ed_rucksendung_support__media .ed_rucksendung_support__media_image:nth-child(3) {
    margin-left: -15%;
    z-index: 3;
  }

  @media (max-width: 767px) {
    .ed_rucksendung_content_wrapper {
      grid-template-columns: 1fr;
    }
    .ed_rucksendung_support_wrapper {
      grid-template-columns: 1fr;
      padding: 20px;
      margin-top: 20px;
    }
    .ed_rucksendung_content__item_content_buttons {
      flex-direction: column;
      align-items: flex-start;
      width: 100%;
    }
    
    .ed_rucksendung_content__item_content_buttons .button {
        width: 100%;
    }
    
    .ed_rucksendung_content_blockquote {
        margin-bottom: 0;
    }
    
    .ed_rucksendung_content__item {
        padding: 28px 20px;
    }
    .ed_rucksendung_support_wrapper {
      gap: 20px;
    }
    .ed_rucksendung_support__media_image {
      width: 80px;
      height: 80px;
    }
  
    .ed_rucksendung_support__media .ed_rucksendung_support__media_image:nth-child(2) {
      margin-left: -12%;
    }
  
    .ed_rucksendung_support__media .ed_rucksendung_support__media_image:nth-child(3) {
      margin-left: -12%;
    }
  
  }
</style>

{%- if section.blocks.size > 0 -%}
  <section class="ed_rucksendung_heading_section">
    <div class="section__color-wrapper">
      <div class="container">
        <div class="ed_rucksendung_content_wrapper">
          {% for block in section.blocks %}
            {% case block.type %}
              {% when 'item' %}
                <div id="block-{{ section.id }}-{{ block.id }}" class="ed_rucksendung_content__item">
                  <div class="ed_rucksendung_content__item_details">
                    {% if block.settings.heading != blank %}
                      <div
                        class="ed_rucksendung_content__item_heading heading {{ block.settings.heading_class }}"
                        {{ block.shopify_attributes }}
                      >
                        {{ block.settings.heading }}
                      </div>
                    {% endif %}

                    {% if block.settings.content != blank %}
                      <div class="ed_rucksendung_content__item_content" {{ block.shopify_attributes }}>
                        {{ block.settings.content }}
                      </div>
                    {% endif %}

                    {% if block.settings.blockquote != blank %}
                      <div class="ed_rucksendung_content_blockquote" {{ block.shopify_attributes }}>
                        {{ block.settings.blockquote }}
                      </div>
                    {% endif %}
                  </div>

                  {% if block.settings.button_text != blank or block.settings.button_text_2 != blank %}
                    <div class="ed_rucksendung_content__item_content_buttons" {{ block.shopify_attributes }}>
                      {% if block.settings.button_text != blank %}
                        <a
                          href="{{ block.settings.button_url }}"
                          class="button button--{{ block.settings.button_style }}"

                          style="
                            {% if block.settings.button_background != 'rgba(0,0,0,0)' %}
                            --button-background: {{ block.settings.button_background.red }}, {{ block.settings.button_background.green }}, {{ block.settings.button_background.blue }};{%  endif %}
                            {% if block.settings.button_text_color != 'rgba(0,0,0,0)' %}
                            --button-text-color: {{ block.settings.button_text_color.red }}, {{ block.settings.button_text_color.green }}, {{ block.settings.button_text_color.blue }};
                             --border-color: {{ block.settings.button_text_color.red }}, {{ block.settings.button_text_color.green }}, {{ block.settings.button_text_color.blue }};
                            {%  endif %}
                          "
                        >
                          {{ block.settings.button_text }}
                        </a>
                      {% endif %}

                      {% if block.settings.button_text_2 != blank %}
                        <a
                          href="{{ block.settings.button_url_2 }}"
                          class="button button--{{ block.settings.button_style_2 }}"

                          style="
                            {% if block.settings.button_background_2 != 'rgba(0,0,0,0)' %}
                            --button-background: {{ block.settings.button_background_2.red }}, {{ block.settings.button_background_2.green }}, {{ block.settings.button_background_2.blue }};{%  endif %}
                            {% if block.settings.button_text_color_2 != 'rgba(0,0,0,0)' %}
                            --button-text-color: {{ block.settings.button_text_color_2.red }}, {{ block.settings.button_text_color_2.green }}, {{ block.settings.button_text_color_2.blue }};
                             --border-color: {{ block.settings.button_text_color_2.red }}, {{ block.settings.button_text_color_2.green }}, {{ block.settings.button_text_color_2.blue }};{%  endif %}
                          "
                        >
                          {{- block.settings.button_text_2 -}}
                        </a>
                      {% endif %}
                    </div>
                  {% endif %}
                </div>
            {% endcase %}
          {% endfor %}
        </div>

        {% for block in section.blocks %}
          {% case block.type %}
            {% when 'support_team' %}
              <div id="block-{{ section.id }}-{{ block.id }}" class="ed_rucksendung_support_wrapper">
                <div class="ed_rucksendung_support__media" {{ block.shopify_attributes }}>
                  {%- if block.settings.image != blank -%}
                    <div class="ed_rucksendung_support__media_image">
                      {{-
                        block.settings.image
                        | image_url: width: block.settings.image.width
                        | image_tag: sizes: '100vw', widths: '150, 200', alt: block.settings.image.alt
                      -}}
                    </div>
                  {%- endif -%}

                  {%- if block.settings.image_2 != blank -%}
                    <div class="ed_rucksendung_support__media_image">
                      {{-
                        block.settings.image_2
                        | image_url: width: block.settings.image_2.width
                        | image_tag: sizes: '100vw', widths: '150, 200', alt: block.settings.image_2.alt
                      -}}
                    </div>
                  {%- endif -%}

                  {%- if block.settings.image_3 != blank -%}
                    <div class="ed_rucksendung_support__media_image">
                      {{-
                        block.settings.image_3
                        | image_url: width: block.settings.image_3.width
                        | image_tag: sizes: '100vw', widths: '150, 200', alt: block.settings.image_3.alt
                      -}}
                    </div>
                  {%- endif -%}
                </div>

                <div class="ed_rucksendung_support__content">
                  <div class="ed_rucksendung_support__content_inner">
                    {% if block.settings.heading != blank %}
                      <h4 class="heading {{ block.settings.heading_class }}" {{ block.shopify_attributes }}>
                        {{ block.settings.heading }}
                      </h4>
                    {% endif %}

                    {% if block.settings.content != blank %}
                      <div class="ed_rucksendung_support__content_text" {{ block.shopify_attributes }}>
                        {{ block.settings.content }}
                      </div>
                    {% endif %}

                    {% if block.settings.button_text != blank or block.settings.button_text_2 != blank %}
                      <div class="ed_rucksendung_content__item_content_buttons" {{ block.shopify_attributes }}>
                        {% if block.settings.button_text != blank %}
                          <a
                            href="{{ block.settings.button_url }}"
                            class="button button--{{ block.settings.button_style }}"

                            style="
                              {% if block.settings.button_background != 'rgba(0,0,0,0)' %}
                              --button-background: {{ block.settings.button_background.red }}, {{ block.settings.button_background.green }}, {{ block.settings.button_background.blue }};{%  endif %}
                              {% if block.settings.button_text_color != 'rgba(0,0,0,0)' %}
                              --button-text-color: {{ block.settings.button_text_color.red }}, {{ block.settings.button_text_color.green }}, {{ block.settings.button_text_color.blue }};
                              --border-color: {{ block.settings.button_text_color.red }}, {{ block.settings.button_text_color.green }}, {{ block.settings.button_text_color.blue }};
                              {%  endif %}
                              
                            "
                          >
                            {{ block.settings.button_text }}
                          </a>
                        {% endif %}

                        {% if block.settings.button_text_2 != blank %}
                          <a
                            href="{{ block.settings.button_url_2 }}"
                            class="button button--{{ block.settings.button_style_2 }}"

                            style="
                              {% if block.settings.button_background_2 != 'rgba(0,0,0,0)' %}
                              --button-background: {{ block.settings.button_background_2.red }}, {{ block.settings.button_background_2.green }}, {{ block.settings.button_background_2.blue }};{%  endif %}
                              {% if block.settings.button_text_color_2 != 'rgba(0,0,0,0)' %}
                              --button-text-color: {{ block.settings.button_text_color_2.red }}, {{ block.settings.button_text_color_2.green }}, {{ block.settings.button_text_color_2.blue }};
                              --border-color: {{ block.settings.button_text_color_2.red }}, {{ block.settings.button_text_color_2.green }}, {{ block.settings.button_text_color_2.blue }};{%  endif %}
                            "
                          >
                            {{- block.settings.button_text_2 -}}
                          </a>
                        {% endif %}
                      </div>
                    {% endif %}
                  </div>
                </div>
              </div>
          {% endcase %}
        {% endfor %}
      </div>
    </div>
  </section>
{%- endif -%}

{% schema %}
{
  "name": "Rucksendung content",
  "class": "shopify-section--rucksendung-content",
  "disabled_on": {
    "groups": ["header", "custom.overlay"]
  },
  "blocks": [
    {
      "name": "Column",
      "type": "item",
      "settings": [
        {
          "type": "color",
          "id": "text_color",
          "label": "Text color",
          "default": "rgba(0,0,0,0)"
        },
        {
          "type": "color",
          "id": "background",
          "label": "Background",
          "default": "#ffffff"
        },
        {
          "type": "richtext",
          "id": "heading",
          "label": "Heading",
          "default": "<p><strong>Rücksendung</strong></p> <p>beantragen</p>"
        },
        {
          "type": "select",
          "id": "heading_class",
          "label": "Heading size",
          "options": [
            { "value": "h1", "label": "H1" },
            { "value": "h2", "label": "H2" },
            { "value": "h3", "label": "H3" },
            { "value": "h4", "label": "H4" },
            { "value": "h5", "label": "H5" },
            { "value": "h6", "label": "H6" }
          ],
          "default": "h4"
        },
        {
          "type": "richtext",
          "id": "content",
          "label": "Content"
        },
        {
          "type": "richtext",
          "id": "blockquote",
          "label": "Blockquote"
        },
        {
          "type": "header",
          "content": "Button settings"
        },
        {
          "type": "text",
          "id": "button_text",
          "label": "Button text"
