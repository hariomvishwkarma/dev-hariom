{%- if section.settings.background_type == 'boxed' -%}
  {%- assign is_boxed = true -%}
{%- else -%}
  {%- assign is_boxed = false -%}
{%- endif -%}

{%- if section.settings.background != settings.background and section.settings.background != 'rgba(0,0,0,0)' -%}
  {%- assign blends_with_background = false -%}
{%- else -%}
  {%- assign blends_with_background = true -%}
{%- endif -%}

<style>
  #shopify-section-{{ section.id }} {
    {%- if section.settings.background == 'rgba(0,0,0,0)' -%}
      {%- assign section_background = settings.background -%}
    {%- else -%}
      {%- assign section_background = section.settings.background -%}
    {%- endif -%}

    {%- if section.settings.text_color == 'rgba(0,0,0,0)' -%}
      {%- assign heading_color = settings.heading_color -%}
      {%- assign text_color = settings.text_color -%}
    {%- else -%}
      {%- assign heading_color = section.settings.text_color -%}
      {%- assign text_color = section.settings.text_color -%}
    {%- endif -%}

    {%- if section.settings.button_background == 'rgba(0,0,0,0)' -%}
      {%- assign button_background = settings.primary_button_background -%}
    {%- else -%}
      {%- assign button_background = section.settings.button_background -%}
    {%- endif -%}

    {%- if section.settings.button_text_color == 'rgba(0,0,0,0)' -%}
      {%- assign button_text_color = settings.primary_button_text_color -%}
    {%- else -%}
      {%- assign button_text_color = section.settings.button_text_color -%}
    {%- endif -%}

    --heading-color: {{ heading_color.red }}, {{ heading_color.green }}, {{ heading_color.blue }};
    --text-color: {{ text_color.red }}, {{ text_color.green }}, {{ text_color.blue }};
    --primary-button-background: {{ button_background.red }}, {{ button_background.green }}, {{ button_background.blue }};
    --primary-button-text-color: {{ button_text_color.red }}, {{ button_text_color.green }}, {{ button_text_color.blue }};

    --section-background: {{ section_background.red }}, {{ section_background.green }}, {{ section_background.blue }};
  }

  #shopify-section-{{ section.id }} {
    background-color: rgb(var(--section-background));
  }

  @media (min-width: 1000px) {
    {%- if section.settings.background == 'rgba(0,0,0,0)' -%}
        #shopify-section-{{ section.id }} {
            margin-top: {{ section.settings.space_top -}}px;
            margin-bottom: {{ section.settings.space_bottom -}}px;
          }
    {%- else -%}
        #shopify-section-{{ section.id }} {
            padding-top: {{ section.settings.space_top -}}px;
            padding-bottom: {{ section.settings.space_bottom -}}px;
          }
    {%- endif -%}

    #shopify-section-{{ section.id }} .content-block {
      margin-bottom: {{ section.settings.gap_between_items }}px;
    }
  }
  @media (max-width: 999px) {
    {%- if section.settings.background == 'rgba(0,0,0,0)' -%}
        #shopify-section-{{ section.id }} {
            margin-top: {{ section.settings.space_top_mobile -}}px;
            margin-bottom: {{ section.settings.space_bottom_mobile -}}px;
          }
    {%- else -%}
        #shopify-section-{{ section.id }} {
            padding-top: {{ section.settings.space_top_mobile -}}px;
            padding-bottom: {{ section.settings.space_bottom_mobile -}}px;
          }
    {%- endif -%}
    }
    #shopify-section-{{ section.id }} .content-block {
      margin-bottom: {{ section.settings.gap_between_items_mobile }}px;
    }
  }

  {%- for block in section.blocks -%}
    #shopify-section-{{ section.id }} .block-{{ block.id }} .heading--{{ block.settings.subheading_class }} {
      margin-block-start: 0;
      margin-block-end: {{ block.settings.space_bottom }}px;
    }

    #shopify-section-{{ section.id }} .block-{{ block.id }} .heading:not(.heading--{{ block.settings.subheading_class }}) {
      margin-block-start: 0;
      margin-block-end: {{ block.settings.space_bottom_heading }}px;
    }

    #shopify-section-{{ section.id }} .block-{{ block.id }} .content-text {
      margin-block-start: 0;
      margin-block-end: {{ block.settings.space_bottom_content }}px;
      white-space: normal;
      overflow-wrap: break-word;
      word-break: normal;
    }

    #shopify-section-{{ section.id }} .block-{{ block.id }} .button-wrapper {
      margin-block-start: 0;
      margin-block-end: {{ block.settings.space_bottom_button }}px;
    }

    @media screen and (max-width: 740px) {
      #shopify-section-{{ section.id }} .block-{{ block.id }} .heading--{{ block.settings.subheading_class }} {
        margin-block-start: 0;
        margin-block-end: {{ block.settings.space_bottom_mobile }}px;
      }

      #shopify-section-{{ section.id }} .block-{{ block.id }} .heading:not(.heading--{{ block.settings.subheading_class }}) {
        margin-block-start: 0;
        margin-block-end: {{ block.settings.space_bottom_heading_mobile }}px;
      }

      #shopify-section-{{ section.id }} .block-{{ block.id }} .content-text {
        margin-block-start: 0;
        margin-block-end: {{ block.settings.space_bottom_content_mobile }}px;
        white-space: normal;
        overflow-wrap: break-word;
        word-break: normal;
      }

      #shopify-section-{{ section.id }} .block-{{ block.id }} .button-wrapper {
        margin-block-start: 0;
        margin-block-end: {{ block.settings.space_bottom_button_mobile }}px;
      }
    }
  {%- endfor -%}
</style>

<section class="ed-cro-rich-text">
  <div
    {% if is_boxed %}
      class="container"
    {% endif %}
  >
    <div class="section__color-wrapper {% if is_boxed %}section__color-wrapper--boxed{% endif %}">
      <div class="{% unless is_boxed %}container{% endunless %}">
        {% if section.settings.show_heart_divider and section.settings.show_heart_divider_at_top == true %}
          {% render 'ed-heart-divider', margin: '40px' %}
        {% endif %}
        
        {%- assign text_position = section.settings.text_position -%}
        {%- assign text_alignment = section.settings.text_alignment -%}

        <div class="content-box content-box--{{ section.settings.text_width }} content-box--text-{{ text_alignment }} content-box--{{ text_position }} text-container">
          {%- for block in section.blocks -%}
            <div class="content-block block-{{ block.id }}" {{ block.shopify_attributes }}>
              {%- if block.settings.subheading != blank -%}
                <h2 class="heading heading--{{ block.settings.subheading_class }}">
                  {{ block.settings.subheading | escape }}
                </h2>
              {%- endif -%}

              {%- if block.settings.heading != blank -%}
                <h3 class="heading {{ block.settings.heading_class }}">
                  {{ block.settings.heading | escape }}
                </h3>
              {%- endif -%}

              {%- if block.settings.content != blank -%}
                <div class="content-text">
                  {{- block.settings.content | replace: '&nbsp;', ' ' | replace: '&#160;', ' ' -}}
                </div>
              {%- endif -%}

              {%- if block.settings.button_text != blank -%}
                <div class="button-wrapper">
                  <a href="{{ block.settings.button_link }}" class="button button--primary">
                    {{- block.settings.button_text | escape -}}
                  </a>
                </div>
              {%- endif -%}
            </div>
          {%- endfor -%}
        </div>

        {% if section.settings.show_heart_divider and section.settings.show_heart_divider_at_top == false %}
          {% render 'ed-heart-divider', margin: '40px' %}
        {% endif %}
      </div>
    </div>
  </div>
</section>

