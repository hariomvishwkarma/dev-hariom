<style>
  #shopify-section-{{ section.id }} {
    {%- if section.settings.background == 'rgba(0,0,0,0)' -%}
      {%- assign section_background = settings.background -%}
    {%- else -%}
      {%- assign section_background = section.settings.background -%}
    {%- endif -%}

    {%- if section.settings.text_color == 'rgba(0,0,0,0)' -%}
      {%- assign heading_color = settings.heading_color -%}
      {%- assign text_color = settings.text_color -%}
    {%- else -%}
      {%- assign heading_color = section.settings.text_color -%}
      {%- assign text_color = section.settings.text_color -%}
    {%- endif -%}

    --section-background: {{ section_background.red }}, {{ section_background.green }}, {{ section_background.blue }};
    --heading-color: {{ heading_color.red }}, {{ heading_color.green }}, {{ heading_color.blue }};
    --text-color: {{ text_color.red }}, {{ text_color.green }}, {{ text_color.blue }};
    --section-overlay-color: {{ section.settings.overlay_color.red }}, {{ section.settings.overlay_color.green }}, {{ section.settings.overlay_color.blue }};
    --section-overlay-opacity: {{ section.settings.overlay_opacity | divided_by: 100.0 }};

    background-color: rgb(var(--section-background));
  }

  {%- assign content_align = section.settings.content_alignment -%}
  {%- assign inner_align = section.settings.inner_alignment -%}
  #shopify-section-{{ section.id }} .staw-hero__inner {
    max-width: {{ section.settings.content_max_width }}px;
    {%- if content_align == 'left' -%}
      margin-right: auto;
    {%- elsif content_align == 'right' -%}
      margin-left: auto;
    {%- else -%}
      margin-inline: auto;
    {%- endif -%}
    {%- if inner_align == 'left' -%}
      align-items: flex-start;
      text-align: left;
    {%- elsif inner_align == 'right' -%}
      align-items: flex-end;
      text-align: right;
    {%- else -%}
      align-items: center;
      text-align: center;
    {%- endif -%}
  }

  #shopify-section-{{ section.id }} .staw-hero__subtitle-img {
    width: {{ section.settings.subtitle_image_width }}px;
    height: {{ section.settings.subtitle_image_height }}px;
    object-fit: contain;
  }

</style>

<section class="staw-hero staw-hero--{{ section.settings.section_height }}">
  {%- if section.settings.image != blank -%}
    <div class="staw-hero__bg">
      {{- section.settings.image | image_url: width: 2000 | image_tag:
        loading: 'eager',
        fetchpriority: 'high',
        class: 'staw-hero__bg-img',
        alt: section.settings.image.alt | default: ''
      -}}
      <div class="staw-hero__overlay" style="background-color: rgba(var(--section-overlay-color), var(--section-overlay-opacity));"></div>
    </div>
  {%- endif -%}

  <div class="container staw-hero__content">

    <div class="staw-hero__inner">
      {%- if section.settings.subtitle_image != blank -%}
        <div class="staw-hero__subtitle-image" style="margin-bottom: {{ section.settings.subtitle_image_margin_bottom }};">
          {{- section.settings.subtitle_image | image_url: width: 800 | image_tag:
            loading: 'lazy',
            class: 'staw-hero__subtitle-img',
            alt: section.settings.subtitle_image.alt | default: ''
          -}}
        </div>
      {%- endif -%}

      {%- if section.settings.title != blank -%}
        <h1 class="heading {{ section.settings.title_class }} staw-hero__title">{{ section.settings.title | escape }}</h1>
      {%- endif -%}

      {%- if section.settings.button_text != blank -%}
        <div class="staw-hero__cta">
          <a href="{{ section.settings.button_link | default: '#' }}" class="button {{ section.settings.button_style }}">
            {{ section.settings.button_text | escape }}
          </a>
        </div>
      {%- endif -%}
    </div>
  </div>
</section>
{%- if section.settings.show_breadcrumb -%}
      <nav aria-label="{{ 'general.breadcrumb.title' | t }}" class="breadcrumb breadcrumb--floating text--xsmall hidden-phone">
        <ol class="breadcrumb__list" role="list">
          <li class="breadcrumb__item">
            <a class="breadcrumb__link" href="{{ routes.root_url }}">{{ 'general.breadcrumb.home' | t }}</a>
          </li>
          <li class="breadcrumb__item">
            <span class="breadcrumb__link" aria-current="page">{{ page.title }}</span>
          </li>
        </ol>
      </nav>
    {%- endif -%}
{% schema %}
{
  "name": "STAW | Hero",
  "class": "shopify-section--staw-hero",
  "disabled_on": {
    "groups": ["header", "custom.overlay"]
  },
  "settings": [
    {
      "type": "checkbox",
      "id": "show_breadcrumb",
      "label": "Breadcrumb anzeigen",
      "default": false
    },
    {
      "type": "header",
      "content": "Inhalt"
    },
    {
      "type": "image_picker",
      "id": "subtitle_image",
      "label": "Subtitle-Bild",
      "info": "Optionales Bild (z.B. Logo/Badge) das über dem Titel erscheint"
    },
    {
      "type": "range",
      "id": "subtitle_image_width",
      "min": 50,
      "max": 600,
      "step": 10,
      "unit": "px",
      "label": "Subtitle-Bild Breite",
      "default": 400
    },
    {
      "type": "range",
      "id": "subtitle_image_height",
      "min": 10,
      "max": 410,
      "step": 4,
      "label": "Subtitle-Bild Höhe",
      "unit": "px",
      "default": 186
    },
    {
      "type": "select",
      "id": "subtitle_image_margin_bottom",
      "label": "Subtitle-Bild Abstand unten",
      "options": [
        { "value": "1rem", "label": "xs" },
        { "value": "1.5rem", "label": "s" },
        { "value": "2rem", "label": "md" },
        { "value": "2.5rem", "label": "lg" },
        { "value": "3rem", "label": "xl" },
        { "value": "0", "label": "No Space" }
      ],
      "default": "0"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Überschrift"
    },
    {
      "type": "select",
      "id": "title_class",
      "label": "Überschrift – Größe",
      "options": [
        { "value": "h1", "label": "H1" },
        { "value": "h2", "label": "H2" },
        { "value": "h3", "label": "H3" },
        { "value": "h4", "label": "H4" },
        { "value": "h5", "label": "H5" },
        { "value": "h6", "label": "H6" }
      ],
      "default": "h1"
    },
    {
      "type": "select",
      "id": "inner_alignment",
      "label": "Inhalts-Ausrichtung",
      "options": [
        { "value": "left", "label": "Links" },
        { "value": "center", "label": "Mitte" },
        { "value": "right", "label": "Rechts" }
      ],
      "default": "center"
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button-Text"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button-Link"
    },
    {
      "type": "select",
      "id": "button_style",
      "label": "Button-Stil",
      "options": [
        { "value": "button--primary", "label": "Primär (gefüllt)" },
        { "value": "button--secondary", "label": "Sekundär" },
        { "value": "button--ternary", "label": "Tertiär" },
        { "value": "button--outline", "label": "Outline (Rahmen)" }
      ],
      "default": "button--primary"
    },
    {
      "type": "header",
      "content": "Content-Container"
    },
    {
      "type": "range",
      "id": "content_max_width",
      "min": 300,
      "max": 1400,
      "step": 20,
      "unit": "px",
      "label": "Bild-Maximalbreite (Container)",
      "default": 800
    },
    {
      "type": "select",
      "id": "content_alignment",
      "label": "Ausrichtung",
      "options": [
        { "value": "left", "label": "Links" },
        { "value": "center", "label": "Mitte" },
        { "value": "right", "label": "Rechts" }
      ],
      "default": "center"
    },
    {
      "type": "header",
      "content": "Hintergrund"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Hintergrundbild"
    },
    {
      "type": "select",
      "id": "section_height",
      "label": "Sektionshöhe",
      "options": [
        { "value": "small", "label": "Klein (min. 280px)" },
        { "value": "medium", "label": "Mittel (min. 480px)" },
        { "value": "large", "label": "Groß (min. 700px)" }
      ],
      "default": "medium"
    },
    {
      "type": "color",
      "id": "overlay_color",
      "label": "Overlay-Farbe",
      "default": "#000000"
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "%",
      "label": "Overlay-Deckkraft",
      "default": 30
    },
    {
      "type": "header",
      "content": "Farben"
    },
    {
      "type": "color",
      "id": "background",
      "label": "Hintergrundfarbe (Fallback ohne Bild)",
      "default": "rgba(0,0,0,0)"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Textfarbe",
      "default": "rgba(0,0,0,0)"
    }
  ],
  "presets": [
    {
      "name": "STAW | Hero",
      "settings": {
        "section_height": "medium"
      }
    }
  ]
}
{% endschema %}
