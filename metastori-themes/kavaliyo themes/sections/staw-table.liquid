{%- assign badge_blocks = section.blocks | where: 'type', 'badge' -%}
{%- assign row_blocks = section.blocks | where: 'type', 'row' -%}

<style>
  #shopify-section-{{ section.id }} {
    {%- if section.settings.background == 'rgba(0,0,0,0)' -%}
      {%- assign section_background = settings.background -%}
    {%- else -%}
      {%- assign section_background = section.settings.background -%}
    {%- endif -%}

    {%- if section.settings.text_color == 'rgba(0,0,0,0)' -%}
      {%- assign heading_color = settings.heading_color -%}
      {%- assign text_color = settings.text_color -%}
    {%- else -%}
      {%- assign heading_color = section.settings.text_color -%}
      {%- assign text_color = section.settings.text_color -%}
    {%- endif -%}

    --section-background: {{ section_background.red }}, {{ section_background.green }}, {{ section_background.blue }};
    --heading-color: {{ heading_color.red }}, {{ heading_color.green }}, {{ heading_color.blue }};
    --text-color: {{ text_color.red }}, {{ text_color.green }}, {{ text_color.blue }};

    background-color: rgb(var(--section-background));
  }

  @media (min-width: 1000px) {
    #shopify-section-{{ section.id }} {
      padding-top: {{ section.settings.space_top }}px;
      padding-bottom: {{ section.settings.space_bottom }}px;
    }
  }

  @media (max-width: 999px) {
    #shopify-section-{{ section.id }} {
      padding-top: {{ section.settings.space_top_mobile }}px;
      padding-bottom: {{ section.settings.space_bottom_mobile }}px;
    }
  }

  #shopify-section-{{ section.id }} .staw-table-section__inner {
    gap: {{ section.settings.element_gap }}px;
  }

  {%- if section.settings.content_max_width != 'none' -%}
  @media screen and (min-width: 741px) {
    #shopify-section-{{ section.id }} .container {
      max-width: {{ section.settings.content_max_width }};
    }
  }
  {%- endif -%}

  {%- assign hdr_bg = section.settings.header_background -%}
  {%- assign hdr_txt = section.settings.header_text_color -%}
  #shopify-section-{{ section.id }} .staw-table__header {
    background-color: {{ hdr_bg }};
    color: {{ hdr_txt }};
  }

  {%- if section.settings.striped_rows -%}
  #shopify-section-{{ section.id }} .staw-table__row:nth-child(even) {
    background-color: {{ section.settings.stripe_color }};
  }
  {%- endif -%}

  {%- assign cols = section.settings.columns | plus: 0 -%}
  #shopify-section-{{ section.id }} .staw-table__header,
  #shopify-section-{{ section.id }} .staw-table__row {
    grid-template-columns: repeat({{ cols }}, 1fr);
  }

  #shopify-section-{{ section.id }} .staw-table__cell-description {
    display: block;
    font-size: 14px;
    text-align: center;
    font-weight: normal;
    opacity: 1;
    margin-top: 8px;
    line-height: 1.1;
  }

  {%- for i in (1..cols) -%}
    {%- assign align_key = 'col' | append: i | append: '_alignment' -%}
    {%- assign col_align = section.settings[align_key] -%}
    {%- if col_align != blank and col_align != 'center' -%}
      #shopify-section-{{ section.id }} .staw-table__row .staw-table__cell:nth-child({{ i }}) {
        text-align: {{ col_align }};
        align-items: {% if col_align == 'left' %}flex-start{% elsif col_align == 'right' %}flex-end{% else %}center{% endif %};
      }
    {%- endif -%}
  {%- endfor -%}
</style>

{%- if section.settings.heart_divider_top -%}
  <div
    class="staw-hd-wrap"
    style="max-width: {{ section.settings.heart_divider_width }}%;{%- if section.settings.heart_divider_width == '25' %} min-width: 260px;{%- endif %} margin-inline: auto;"
  >
    {%- render 'ed-heart-divider', margin: '20px' -%}
  </div>
{%- endif -%}

<section>
  <div class="container">
    <div class="staw-table-section__inner" style="text-align: {{ section.settings.text_alignment }};">
      {%- if section.settings.heading != blank -%}
        <h2 class="heading {{ section.settings.heading_class }}{% if section.settings.heading_uppercase %} text-uppercase{% endif %}">
          {{ section.settings.heading | escape }}
        </h2>
      {%- endif -%}

      {%- if badge_blocks.size > 0 -%}
        <div class="staw-team-section__badges" style="justify-content: {{ section.settings.badge_alignment }};">
          {%- for block in badge_blocks -%}
            {%- assign badge_bg = block.settings.background -%}
            {%- assign badge_border = block.settings.border_color -%}
            <span
              class="staw-team-badge"
              style="
                {%- if badge_bg != blank and badge_bg != 'rgba(0,0,0,0)' -%}background: {{ badge_bg }}; padding: 6px 16px; border-radius: 20px;{%- endif -%}
                {%- if block.settings.border and badge_border != blank and badge_border != 'rgba(0,0,0,0)' -%}border: 1px solid {{ badge_border }}; padding: 6px 16px; border-radius: 20px;{%- endif -%}
              "
              {{ block.shopify_attributes }}
            >
              {%- if block.settings.icon != blank -%}
                <span class="staw-team-badge__icon">
                  {{-
                    block.settings.icon
                    | image_url: width: 44
                    | image_tag: loading: 'lazy', width: 22, height: 22, alt: block.settings.label
                    | default: ''
                  -}}
                </span>
              {%- endif -%}
              {{ block.settings.label | escape }}
            </span>
          {%- endfor -%}
        </div>
      {%- endif -%}

      {%- if section.settings.description != blank -%}
        <div class="rte" style="font-size: var(--staw-font-size-{{ section.settings.content_font_size }});">
          {{ section.settings.description }}
        </div>
      {%- endif -%}

      {%- comment -%} Tabelle {%- endcomment -%}
      <div class="staw-table-wrapper">
        <div class="staw-table" role="table">
          {%- comment -%} Header {%- endcomment -%}
          <div class="staw-table__header" role="row">
            {%- if section.settings.col1_header != blank -%}
              <div class="staw-table__cell" role="columnheader">
                {{ section.settings.col1_header | escape }}
                {%- if section.settings.col1_description != blank -%}
                  <span class="staw-table__cell-description">{{ section.settings.col1_description | escape }}</span>
                {%- endif -%}
              </div>
            {%- endif -%}
            {%- if cols >= 2 and section.settings.col2_header != blank -%}
              <div class="staw-table__cell" role="columnheader">
                {{ section.settings.col2_header | escape }}
                {%- if section.settings.col2_description != blank -%}
                  <span class="staw-table__cell-description">{{ section.settings.col2_description | escape }}</span>
                {%- endif -%}
              </div>
            {%- endif -%}
            {%- if cols >= 3 and section.settings.col3_header != blank -%}
              <div class="staw-table__cell" role="columnheader">
                {{ section.settings.col3_header | escape }}
                {%- if section.settings.col3_description != blank -%}
                  <span class="staw-table__cell-description">{{ section.settings.col3_description | escape }}</span>
                {%- endif -%}
              </div>
            {%- endif -%}
            {%- if cols >= 4 and section.settings.col4_header != blank -%}
              <div class="staw-table__cell" role="columnheader">
                {{ section.settings.col4_header | escape }}
                {%- if section.settings.col4_description != blank -%}
                  <span class="staw-table__cell-description">{{ section.settings.col4_description | escape }}</span>
                {%- endif -%}
              </div>
            {%- endif -%}
            {%- if cols >= 5 and section.settings.col5_header != blank -%}
              <div class="staw-table__cell" role="columnheader">
                {{ section.settings.col5_header | escape }}
                {%- if section.settings.col5_description != blank -%}
                  <span class="staw-table__cell-description">{{ section.settings.col5_description | escape }}</span>
                {%- endif -%}
              </div>
            {%- endif -%}
          </div>

          {%- comment -%} Zeilen {%- endcomment -%}
          {%- for block in row_blocks -%}
            <div class="staw-table__row" role="row" {{ block.shopify_attributes }}>
              {%- if block.settings.col1 != blank -%}
                <div class="staw-table__cell rte" role="cell">{{ block.settings.col1 }}</div>
              {%- endif -%}
              {%- if cols >= 2 and block.settings.col2 != blank -%}
                <div class="staw-table__cell rte" role="cell">{{ block.settings.col2 }}</div>
              {%- endif -%}
              {%- if cols >= 3 and block.settings.col3 != blank -%}
                <div class="staw-table__cell rte" role="cell">{{ block.settings.col3 }}</div>
              {%- endif -%}
              {%- if cols >= 4 and block.settings.col4 != blank -%}
                <div class="staw-table__cell rte" role="cell">{{ block.settings.col4 }}</div>
              {%- endif -%}
              {%- if cols >= 5 and block.settings.col5 != blank -%}
                <div class="staw-table__cell rte" role="cell">{{ block.settings.col5 }}</div>
              {%- endif -%}
            </div>
          {%- endfor -%}
        </div>
      </div>
      {%- if section.settings.footnote != blank -%}
        <div
          class="staw-table__footnote rte"
          style="font-size: var(--staw-font-size-{{ section.settings.footnote_font_size }});"
        >
          {{ section.settings.footnote }}
        </div>
      {%- endif -%}
    </div>
  </div>
</section>

{%- if section.settings.heart_divider_bottom -%}
  <div
    class="staw-hd-wrap"
    style="max-width: {{ section.settings.heart_divider_width }}%;{%- if section.settings.heart_divider_width == '25' %} min-width: 260px;{%- endif %} margin-inline: auto;"
  >
    {%- render 'ed-heart-divider', margin: '20px' -%}
  </div>
{%- endif -%}

{% schema %}
{
  "name": "STAW | Tabelle",
  "class": "shopify-section--staw-table",
  "disabled_on": {
    "groups": ["header", "custom.overlay"]
  },
  "settings": [
    {
      "type": "header",
      "content": "Inhalt"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Überschrift"
    },
    {
      "type": "select",
      "id": "heading_class",
      "label": "Überschrift – Größe",
      "options": [
        { "value": "h1", "label": "H1" },
        { "value": "h2", "label": "H2" },
        { "value": "h3", "label": "H3" },
        { "value": "h4", "label": "H4" },
        { "value": "h5", "label": "H5" },
        { "value": "h6", "label": "H6" }
      ],
      "default": "h3"
    },
    {
      "type": "checkbox",
      "id": "heading_uppercase",
      "label": "Überschrift – Großbuchstaben",
      "default": false
    },
    {
      "type": "select",
      "id": "badge_alignment",
      "label": "Badges – Ausrichtung",
      "options": [
        { "value": "flex-start", "label": "Links" },
        { "value": "center", "label": "Zentriert" },
        { "value": "flex-end", "label": "Rechts" }
      ],
      "default": "flex-start"
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "Beschreibung (optional)",
      "info": "Erscheint zwischen Badges und Tabelle"
    },
    {
      "type": "select",
      "id": "content_font_size",
      "label": "Beschreibung – Schriftgröße",
      "options": [
        { "value": "small", "label": "Klein (14px)" },
        { "value": "base", "label": "Standard (16px)" },
        { "value": "medium", "label": "Mittel (18px)" },
        { "value": "large", "label": "Groß (20px)" },
        { "value": "xlarge", "label": "Sehr groß (22px)" }
      ],
      "default": "base"
    },
    {
      "type": "richtext",
      "id": "footnote",
      "label": "Fußnote (optional)",
      "info": "Erscheint unterhalb der Tabelle"
    },
    {
      "type": "select",
      "id": "footnote_font_size",
      "label": "Fußnote – Schriftgröße",
      "options": [
        { "value": "small", "label": "Klein (14px)" },
        { "value": "base", "label": "Standard (16px)" },
        { "value": "medium", "label": "Mittel (18px)" },
        { "value": "large", "label": "Groß (20px)" },
        { "value": "xlarge", "label": "Sehr groß (22px)" }
      ],
      "default": "small"
    },
    {
      "type": "header",
      "content": "Tabellen-Spalten"
    },
    {
      "type": "select",
      "id": "columns",
      "label": "Anzahl Spalten",
      "options": [
        { "value": "2", "label": "2 Spalten" },
        { "value": "3", "label": "3 Spalten" },
        { "value": "4", "label": "4 Spalten" },
        { "value": "5", "label": "5 Spalten" }
      ],
      "default": "3"
    },
    {
      "type": "text",
      "id": "col1_header",
      "label": "Spalte 1 – Überschrift",
      "default": "Country"
    },
    {
      "type": "text",
      "id": "col1_description",
      "label": "Spalte 1 – Beschreibung"
    },
    {
      "type": "select",
      "id": "col1_alignment",
      "label": "Spalte 1 – Textausrichtung",
      "options": [
        { "value": "left", "label": "Links" },
        { "value": "center", "label": "Zentriert" },
        { "value": "right", "label": "Rechts" }
      ],
      "default": "center"
    },
    {
      "type": "text",
      "id": "col2_header",
      "label": "Spalte 2 – Überschrift",
      "default": "Weight"
    },
    {
      "type": "text",
      "id": "col2_description",
      "label": "Spalte 2 – Beschreibung"
    },
    {
      "type": "select",
      "id": "col2_alignment",
      "label": "Spalte 2 – Textausrichtung",
      "options": [
        { "value": "left", "label": "Links" },
        { "value": "center", "label": "Zentriert" },
        { "value": "right", "label": "Rechts" }
      ],
      "default": "center"
    },
    {
      "type": "text",
      "id": "col3_header",
      "label": "Spalte 3 – Überschrift",
      "default": "DHL Package"
    },
    {
      "type": "text",
      "id": "col3_description",
      "label": "Spalte 3 – Beschreibung"
    },
    {
      "type": "select",
      "id": "col3_alignment",
      "label": "Spalte 3 – Textausrichtung",
      "options": [
        { "value": "left", "label": "Links" },
        { "value": "center", "label": "Zentriert" },
        { "value": "right", "label": "Rechts" }
      ],
      "default": "center"
    },
    {
      "type": "text",
      "id": "col4_header",
      "label": "Spalte 4 – Überschrift"
    },
    {
      "type": "text",
      "id": "col4_description",
      "label": "Spalte 4 – Beschreibung"
    },
    {
      "type": "select",
      "id": "col4_alignment",
      "label": "Spalte 4 – Textausrichtung",
      "options": [
        { "value": "left", "label": "Links" },
        { "value": "center", "label": "Zentriert" },
        { "value": "right", "label": "Rechts" }
      ],
      "default": "center"
    },
    {
      "type": "text",
      "id": "col5_header",
      "label": "Spalte 5 – Überschrift"
    },
    {
      "type": "text",
      "id": "col5_description",
      "label": "Spalte 5 – Beschreibung"
    },
    {
      "type": "select",
      "id": "col5_alignment",
      "label": "Spalte 5 – Textausrichtung",
      "options": [
        { "value": "left", "label": "Links" },
        { "value": "center", "label": "Zentriert" },
        { "value": "right", "label": "Rechts" }
      ],
      "default": "center"
    },
    {
      "type": "header",
      "content": "Tabellen-Stil"
    },
    {
      "type": "color",
      "id": "header_background",
      "label": "Header – Hintergrundfarbe",
      "default": "#6ec6b8"
    },
    {
      "type": "color",
      "id": "header_text_color",
      "label": "Header – Textfarbe",
      "default": "#ffffff"
    },
    {
      "type": "checkbox",
      "id": "striped_rows",
      "label": "Zebrastreifen (abwechselnder Zeilenhintergrund)",
      "default": true
    },
    {
      "type": "color",
      "id": "stripe_color",
      "label": "Zebrastreifen – Farbe",
      "default": "#f7f8fd",
      "info": "Nur sichtbar wenn Zebrastreifen aktiviert"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "text_alignment",
      "label": "Textausrichtung",
      "options": [
        { "value": "left", "label": "Links" },
        { "value": "center", "label": "Zentriert" },
        { "value": "right", "label": "Rechts" }
      ],
      "default": "left"
    },
    {
      "type": "select",
      "id": "content_max_width",
      "label": "Inhaltsbreite",
      "info": "Gilt ab 741px Bildschirmbreite – auf Mobilgeräten immer volle Breite",
      "options": [
        { "value": "640px", "label": "Schmal (640px)" },
        { "value": "900px", "label": "Mittel (900px)" },
        { "value": "1200px", "label": "Breit (1200px)" },
        { "value": "none", "label": "Volle Breite" }
      ],
      "default": "1200px"
    },
    {
      "type": "range",
      "id": "element_gap",
      "min": 4,
      "max": 60,
      "step": 2,
      "unit": "px",
      "label": "Abstand zwischen Elementen",
      "info": "Vertikaler Abstand zwischen Überschrift, Badges, Tabelle",
      "default": 24
    },
    {
      "type": "header",
      "content": "Trennlinie (Heart Divider)"
    },
    {
      "type": "checkbox",
      "id": "heart_divider_top",
      "label": "Trennlinie oben",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "heart_divider_bottom",
      "label": "Trennlinie unten",
      "default": false
    },
    {
      "type": "select",
      "id": "heart_divider_width",
      "label": "Trennlinien-Breite",
      "options": [
        { "value": "100", "label": "Volle Breite" },
        { "value": "75", "label": "75%" },
        { "value": "50", "label": "50%" },
        { "value": "25", "label": "25%" }
      ],
      "default": "100"
    },
    {
      "type": "header",
      "content": "Abstände"
    },
    {
      "type": "range",
      "id": "space_top",
      "min": 0,
      "max": 148,
      "step": 4,
      "unit": "px",
      "label": "Abstand oben",
      "default": 60
    },
    {
      "type": "range",
      "id": "space_bottom",
      "min": 0,
      "max": 148,
      "step": 4,
      "unit": "px",
      "label": "Abstand unten",
      "default": 60
    },
    {
      "type": "range",
      "id": "space_top_mobile",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Abstand oben (Mobil)",
      "default": 40
    },
    {
      "type": "range",
      "id": "space_bottom_mobile",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Abstand unten (Mobil)",
      "default": 40
    },
    {
      "type": "header",
      "content": "Farben"
    },
    {
      "type": "color",
      "id": "background",
      "label": "Hintergrund",
      "default": "rgba(0,0,0,0)"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Textfarbe",
      "default": "rgba(0,0,0,0)"
    }
  ],
  "blocks": [
    {
      "type": "badge",
      "name": "Badge / Label",
      "settings": [
        {
          "type": "image_picker",
          "id": "icon",
          "label": "Icon (22×22 px empfohlen)"
        },
        {
          "type": "text",
          "id": "label",
          "label": "Label-Text",
          "default": "Badge"
        },
        {
          "type": "color",
          "id": "background",
          "label": "Hintergrundfarbe",
          "default": "rgba(0,0,0,0)"
        },
        {
          "type": "color",
          "id": "border_color",
          "label": "Rahmenfarbe",
          "default": "#e0e0e0"
        },
        {
          "type": "checkbox",
          "id": "border",
          "label": "Rahmen anzeigen",
          "default": true
        }
      ]
    },
    {
      "type": "row",
      "name": "Tabellenzeile",
      "settings": [
        {
          "type": "richtext",
          "id": "col1",
          "label": "Spalte 1"
        },
        {
          "type": "richtext",
          "id": "col2",
          "label": "Spalte 2"
        },
        {
          "type": "richtext",
          "id": "col3",
          "label": "Spalte 3"
        },
        {
          "type": "richtext",
          "id": "col4",
          "label": "Spalte 4"
        },
        {
          "type": "richtext",
          "id": "col5",
          "label": "Spalte 5"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "STAW | Tabelle",
      "settings": {
        "heading": "Germany Feed",
        "columns": "3",
        "col1_header": "Country",
        "col2_header": "Weight",
        "col3_header": "DHL Package"
      },
      "blocks": [
        { "type": "badge", "settings": { "label": "free DHL return", "border": true } },
        { "type": "badge", "settings": { "label": "Minimum order value: 9 €", "border": true } },
        {
          "type": "row",
          "settings": { "col1": "<p>Germany</p>", "col2": "<p>up to 15kg</p>", "col3": "<p>6.95 €</p>" }
        },
        {
          "type": "row",
          "settings": { "col1": "<p>Germany</p>", "col2": "<p>up to 30kg</p>", "col3": "<p>11.95 €</p>" }
        },
        {
          "type": "row",
          "settings": { "col1": "<p>Germany</p>", "col2": "<p>up to 45kg</p>", "col3": "<p>24.95 €</p>" }
        }
      ]
    }
  ]
}
{% endschema %}
