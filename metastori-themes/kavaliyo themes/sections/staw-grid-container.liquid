<style>
  #shopify-section-{{ section.id }} {
    {%- if section.settings.background == 'rgba(0,0,0,0)' -%}
      {%- assign section_background = settings.background -%}
    {%- else -%}
      {%- assign section_background = section.settings.background -%}
    {%- endif -%}

    {%- if section.settings.text_color == 'rgba(0,0,0,0)' -%}
      {%- assign heading_color = settings.heading_color -%}
      {%- assign text_color = settings.text_color -%}
    {%- else -%}
      {%- assign heading_color = section.settings.text_color -%}
      {%- assign text_color = section.settings.text_color -%}
    {%- endif -%}

    --section-background: {{ section_background.red }}, {{ section_background.green }}, {{ section_background.blue }};
    --heading-color: {{ heading_color.red }}, {{ heading_color.green }}, {{ heading_color.blue }};
    --text-color: {{ text_color.red }}, {{ text_color.green }}, {{ text_color.blue }};

    background-color: rgb(var(--section-background));
  }

  @media (min-width: 1000px) {
    #shopify-section-{{ section.id }} {
      padding-top: {{ section.settings.space_top }}px;
      padding-bottom: {{ section.settings.space_bottom }}px;
    }
  }

  @media (max-width: 999px) {
    #shopify-section-{{ section.id }} {
      padding-top: {{ section.settings.space_top_mobile }}px;
      padding-bottom: {{ section.settings.space_bottom_mobile }}px;
    }
  }

  #shopify-section-{{ section.id }} .staw-rich-text__content {
    font-size: var(--staw-font-size-{{ section.settings.description_font_size }});
  }

  #shopify-section-{{ section.id }} .text-uppercase {
    text-transform: uppercase;
  }

  {%- if section.settings.content_max_width != 'none' -%}
  @media screen and (min-width: 741px) {
    #shopify-section-{{ section.id }} .container {
      max-width: {{ section.settings.content_max_width }};
    }
  }
  {%- endif -%}

  #shopify-section-{{ section.id }} .staw-grid {
    grid-template-columns: repeat({{ section.settings.columns }}, 1fr);
    gap: {{ section.settings.card_gap }}px;
    margin-top: {{ section.settings.element_gap }}px;
  }

  @media (max-width: 999px) {
    #shopify-section-{{ section.id }} .staw-grid {
      grid-template-columns: repeat({{ section.settings.columns_mobile }}, 1fr);
    }
  }

  @media (max-width: 500px) {
    #shopify-section-{{ section.id }} .staw-grid {
      grid-template-columns: 1fr;
    }
  }

  {%- if section.settings.equal_height -%}
  #shopify-section-{{ section.id }} .staw-grid {
    align-items: stretch;
  }
  #shopify-section-{{ section.id }} .staw-card {
    height: 100%;
  }
  {%- endif -%}
</style>

<section>
  <div class="container">
    {%- if section.settings.subheading != blank or section.settings.heading != blank or section.settings.description != blank -%}
      <header class="section__header section__header--center text-container">
        {%- if section.settings.heading != blank -%}
          <h2 class="heading {{ section.settings.heading_class }}{% if section.settings.heading_uppercase %} text-uppercase{% endif %}">{{ section.settings.heading | escape }}</h2>
        {%- endif -%}

        {%- if section.settings.subheading != blank -%}
          <h3 class="heading heading--{{ section.settings.subheading_class }}{% if section.settings.subheading_uppercase %} text-uppercase{% endif %}"{% if section.settings.subheading_uppercase %} style="line-height: 1.15;"{% endif %}>{{ section.settings.subheading | escape }}</h3>
        {%- endif -%}

        {%- if section.settings.description != blank -%}
          <div class="staw-rich-text__content">{{ section.settings.description }}</div>
        {%- endif -%}
      </header>
    {%- endif -%}

    {%- if section.blocks.size > 0 -%}
      <div class="staw-grid">
        {%- assign is_card_open = false -%}
        {%- assign is_main_open = false -%}
        {%- assign is_badges_open = false -%}
        {%- assign is_cta_open = false -%}
        {%- assign current_card_tag = 'div' -%}
        {%- assign img_loading = 'lazy' -%}
        {%- if request.design_mode -%}{%- assign img_loading = 'eager' -%}{%- endif -%}

        {%- for block in section.blocks -%}
          {%- case block.type -%}

          {%- when 'card' -%}
            {%- if is_badges_open -%}</div>{%- assign is_badges_open = false -%}{%- endif -%}
            {%- if is_cta_open -%}</div>{%- assign is_cta_open = false -%}{%- endif -%}
            {%- if is_main_open -%}</div>{%- assign is_main_open = false -%}{%- endif -%}
            {%- if is_card_open -%}</div></{{ current_card_tag }}>{%- assign is_card_open = false -%}{%- endif -%}

            {%- liquid
              assign current_card_tag = 'div'
              if block.settings.card_link != blank
                assign current_card_tag = 'a'
              endif

              assign content_align = block.settings.content_alignment | default: 'left'

              assign valign = block.settings.content_valign | default: 'top'
              if valign == 'center'
                assign justify = 'center'
              elsif valign == 'bottom'
                assign justify = 'flex-end'
              else
                assign justify = 'flex-start'
              endif
            -%}

            {%- capture card_style -%}
              {%- if block.settings.card_background != 'rgba(0,0,0,0)' -%}
                background-color:{{ block.settings.card_background }};
              {%- elsif section.settings.card_background_global != 'rgba(0,0,0,0)' -%}
                background-color:{{ section.settings.card_background_global }};
              {%- endif -%}
              {%- if block.settings.card_border -%}
                border:1px solid {%- if block.settings.card_border_color != 'rgba(0,0,0,0)' -%}{{ block.settings.card_border_color }}{%- else -%}rgba(var(--border-color),1){%- endif -%};
              {%- endif -%}
            {%- endcapture -%}

            <{{ current_card_tag }}
              class="staw-card{% if block.settings.card_link != blank %} staw-card--linked{% endif %}{% if block.settings.icon_position == 'left' and block.settings.icon != blank %} staw-card--horizontal{% endif %}"
              {% if card_style != blank %}style="{{ card_style | strip }}"{% endif %}
              {% if block.settings.card_link != blank %}href="{{ block.settings.card_link }}"{% endif %}
              {{ block.shopify_attributes }}
            >
              {%- if block.settings.hero_image != blank -%}
                {%- liquid
                  assign hero_max_width = block.settings.hero_image_max_width | default: 'none'
                  assign hero_hero_style = ''
                  assign hero_img_style = ''
                  if hero_max_width != 'none'
                    assign hero_align_x = block.settings.hero_image_align_x | default: 'center'
                    assign hero_align_y = block.settings.hero_image_align_y | default: 'center'
                    case hero_align_x
                      when 'left'
                        assign hero_justify = 'flex-start'
                      when 'right'
                        assign hero_justify = 'flex-end'
                      else
                        assign hero_justify = 'center'
                    endcase
                    case hero_align_y
                      when 'top'
                        assign hero_align_items = 'flex-start'
                      when 'bottom'
                        assign hero_align_items = 'flex-end'
                      else
                        assign hero_align_items = 'center'
                    endcase
                    assign hero_hero_style = 'display:flex;justify-content:' | append: hero_justify | append: ';align-items:' | append: hero_align_items | append: ';'
                    assign hero_img_style = 'max-width:' | append: hero_max_width | append: ';width:100%;height:auto;position:relative;'
                  endif
                -%}
                <div class="staw-card__hero staw-card__hero--{{ block.settings.hero_image_ratio | default: '16-9' }}"
                  {%- if hero_hero_style != '' %} style="{{ hero_hero_style }}"{% endif %}>
                  {%- if hero_img_style != '' -%}
                    {{- block.settings.hero_image | image_url: width: 800 | image_tag:
                      loading: img_loading,
                      class: 'staw-card__hero-img',
                      style: hero_img_style,
                      alt: block.settings.hero_image.alt | default: block.settings.heading | default: ''
                    -}}
                  {%- else -%}
                    {{- block.settings.hero_image | image_url: width: 800 | image_tag:
                      loading: img_loading,
                      class: 'staw-card__hero-img',
                      alt: block.settings.hero_image.alt | default: block.settings.heading | default: ''
                    -}}
                  {%- endif -%}
                </div>
              {%- endif -%}

              <div class="staw-card__body" style="justify-content: {{ justify }};">
                <div class="staw-card__main">
                  {%- if block.settings.icon != blank -%}
                    <div class="staw-card__icon staw-card__icon--{{ block.settings.icon_size | default: 'medium' }}">
                      {{- block.settings.icon | image_url: width: 240 | image_tag:
                        loading: img_loading,
                        alt: block.settings.heading | default: ''
                      -}}
                    </div>
                  {%- endif -%}

                  <div class="staw-card__content" style="text-align: {{ content_align }};">
                    {%- if block.settings.heading != blank -%}
                      <h3
                        class="heading {{ block.settings.heading_class | default: 'h4' }} staw-card__heading{% if block.settings.heading_uppercase %} text-uppercase{% endif %}"
                      >{{ block.settings.heading | escape }}</h3>
                    {%- endif -%}

                    {%- if block.settings.content != blank -%}
                      <div
                        class="staw-card__text rte"
                        style="font-size: var(--staw-font-size-{{ block.settings.text_font_size | default: 'small' }});"
                      >{{ block.settings.content }}</div>
                    {%- endif -%}
                  </div>
                  {%- assign is_card_open = true -%}
                  {%- assign is_main_open = true -%}

          {%- when 'badge' -%}
            {%- capture badge_style -%}
              {%- if block.settings.border -%}
                border:1px solid {%- if block.settings.border_color != 'rgba(0,0,0,0)' -%}{{ block.settings.border_color }}{%- else -%}rgba(var(--border-color),1){%- endif -%};
              {%- endif -%}
              {%- if block.settings.background != 'rgba(0,0,0,0)' -%}
                background-color:{{ block.settings.background }};
              {%- endif -%}
            {%- endcapture -%}

            {%- if is_card_open -%}
              {%- if is_cta_open -%}</div>{%- assign is_cta_open = false -%}{%- endif -%}
              {%- if is_main_open -%}</div>{%- assign is_main_open = false -%}{%- endif -%}
              {%- unless is_badges_open -%}<div class="staw-card__badges" style="text-align: {{ block.settings.alignment | default: 'left' }};">{%- assign is_badges_open = true -%}{%- endunless -%}

              <div class="staw-badge"{% if badge_style != blank %} style="{{ badge_style | strip }}"{% endif %} {{ block.shopify_attributes }}>
                {%- if block.settings.icon != blank -%}
                  <div class="staw-badge__icon">
                    {{- block.settings.icon | image_url: width: 42 | image_tag:
                      loading: img_loading,
                      width: 21,
                      height: 21,
                      alt: ''
                    -}}
                  </div>
                {%- endif -%}
                <div class="staw-badge__text rte" style="font-size: var(--staw-font-size-{{ block.settings.font_size | default: 'small' }});">{{ block.settings.text }}</div>
              </div>
            {%- else -%}
              <div class="staw-badge staw-badge--standalone" style="text-align: {{ block.settings.alignment | default: 'left' }};{% if badge_style != blank %}{{ badge_style | strip }}{% endif %}" {{ block.shopify_attributes }}>
                {%- if block.settings.icon != blank -%}
                  <div class="staw-badge__icon">
                    {{- block.settings.icon | image_url: width: 42 | image_tag:
                      loading: img_loading,
                      width: 21,
                      height: 21,
                      alt: ''
                    -}}
                  </div>
                {%- endif -%}
                <div class="staw-badge__text rte" style="font-size: var(--staw-font-size-{{ block.settings.font_size | default: 'small' }});">{{ block.settings.text }}</div>
              </div>
            {%- endif -%}

          {%- when 'button' -%}
            {%- if is_card_open and is_main_open -%}
              {%- unless is_cta_open -%}<div class="staw-card__cta" style="text-align: {{ block.settings.alignment | default: 'left' }};">{%- assign is_cta_open = true -%}{%- endunless -%}

              {%- if current_card_tag == 'a' -%}
                <span class="button {{ block.settings.style }}" {{ block.shopify_attributes }}>{{ block.settings.text | escape }}</span>
              {%- else -%}
                <a
                  href="{{ block.settings.url | default: '#' }}"
                  class="button {{ block.settings.style }}"
                  {% if block.settings.new_tab %}target="_blank" rel="noopener"{% endif %}
                  {{ block.shopify_attributes }}
                >{{ block.settings.text | escape }}</a>
              {%- endif -%}
            {%- endif -%}

          {%- endcase -%}
        {%- endfor -%}

        {%- if is_badges_open -%}</div>{%- endif -%}
        {%- if is_cta_open -%}</div>{%- endif -%}
        {%- if is_main_open -%}</div>{%- endif -%}
        {%- if is_card_open -%}</div></{{ current_card_tag }}>{%- endif -%}
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "STAW | Grid",
  "class": "shopify-section--staw-grid",
  "disabled_on": {
    "groups": ["header", "custom.overlay"]
  },
  "settings": [
    {
      "type": "header",
      "content": "Inhalt"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Überschrift"
    },
    {
      "type": "select",
      "id": "heading_class",
      "label": "Überschrift – Größe",
      "options": [
        { "value": "h1", "label": "H1" },
        { "value": "h2", "label": "H2" },
        { "value": "h3", "label": "H3" },
        { "value": "h4", "label": "H4" },
        { "value": "h5", "label": "H5" },
        { "value": "h6", "label": "H6" }
      ],
      "default": "h2"
    },
    {
      "type": "checkbox",
      "id": "heading_uppercase",
      "label": "Überschrift – Großbuchstaben",
      "default": false
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Unterüberschrift"
    },
    {
      "type": "select",
      "id": "subheading_class",
      "label": "Unterüberschrift – Größe",
      "options": [
        { "value": "h1", "label": "H1" },
        { "value": "h2", "label": "H2" },
        { "value": "h3", "label": "H3" },
        { "value": "h4", "label": "H4" },
        { "value": "h5", "label": "H5" },
        { "value": "h6", "label": "H6" }
      ],
      "default": "h5"
    },
    {
      "type": "checkbox",
      "id": "subheading_uppercase",
      "label": "Unterüberschrift – Großbuchstaben",
      "default": false
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "Beschreibung"
    },
    {
      "type": "select",
      "id": "description_font_size",
      "label": "Textgröße",
      "options": [
        { "value": "small",  "label": "Klein (14px)" },
        { "value": "base",   "label": "Standard (16px)" },
        { "value": "medium", "label": "Mittel (18px)" },
        { "value": "large",  "label": "Groß (20px)" },
        { "value": "xlarge", "label": "Sehr groß (22px)" }
      ],
      "default": "base"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "columns",
      "label": "Spalten (Desktop)",
      "options": [
        { "value": "1", "label": "1 Spalte" },
        { "value": "2", "label": "2 Spalten" },
        { "value": "3", "label": "3 Spalten" },
        { "value": "4", "label": "4 Spalten" }
      ],
      "default": "4"
    },
    {
      "type": "select",
      "id": "columns_mobile",
      "label": "Spalten (Mobil)",
      "options": [
        { "value": "1", "label": "1 Spalte" },
        { "value": "2", "label": "2 Spalten" }
      ],
      "default": "2"
    },
    {
      "type": "checkbox",
      "id": "equal_height",
      "label": "Karten gleich hoch",
      "info": "Alle Karten einer Reihe erhalten dieselbe Höhe",
      "default": false
    },
    {
      "type": "select",
      "id": "content_max_width",
      "label": "Inhaltsbreite",
      "info": "Gilt ab 741px Bildschirmbreite – auf Mobilgeräten immer volle Breite",
      "options": [
        { "value": "640px",  "label": "Schmal (640px)" },
        { "value": "900px",  "label": "Mittel (900px)" },
        { "value": "1200px", "label": "Breit (1200px)" },
        { "value": "none",   "label": "Volle Breite" }
      ],
      "default": "1200px"
    },
    {
      "type": "range",
      "id": "card_gap",
      "min": 8,
      "max": 64,
      "step": 4,
      "unit": "px",
      "label": "Abstand zwischen Karten",
      "default": 24
    },
    {
      "type": "range",
      "id": "element_gap",
      "min": 4,
      "max": 60,
      "step": 2,
      "unit": "px",
      "label": "Abstand Überschrift → Grid",
      "default": 24
    },
    {
      "type": "header",
      "content": "Karten – Farben"
    },
    {
      "type": "color",
      "id": "card_background_global",
      "label": "Karten-Hintergrund (global)",
      "info": "Gilt für alle Karten – wird von individueller Karten-Farbe überschrieben",
      "default": "rgba(0,0,0,0)"
    },
    {
      "type": "header",
      "content": "Abstände"
    },
    {
      "type": "range",
      "id": "space_top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "label": "Abstand oben",
      "default": 90
    },
    {
      "type": "range",
      "id": "space_bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "label": "Abstand unten",
      "default": 90
    },
    {
      "type": "range",
      "id": "space_top_mobile",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "label": "Abstand oben (Mobil)",
      "default": 60
    },
    {
      "type": "range",
      "id": "space_bottom_mobile",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "label": "Abstand unten (Mobil)",
      "default": 60
    },
    {
      "type": "header",
      "content": "Farben"
    },
    {
      "type": "color",
      "id": "background",
      "label": "Hintergrund",
      "default": "rgba(0,0,0,0)"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Textfarbe",
      "default": "rgba(0,0,0,0)"
    }
  ],
  "blocks": [
    {
      "type": "card",
      "name": "Karte",
      "settings": [
        {
          "type": "header",
          "content": "Hero-Bild"
        },
        {
          "type": "image_picker",
          "id": "hero_image",
          "label": "Bild (oben, ganzseitig)"
        },
        {
          "type": "select",
          "id": "hero_image_ratio",
          "label": "Seitenverhältnis",
          "options": [
            { "value": "16-9", "label": "16:9 (breit)" },
            { "value": "3-2",  "label": "3:2" },
            { "value": "4-3",  "label": "4:3" },
            { "value": "1-1",  "label": "1:1 (quadratisch)" }
          ],
          "default": "16-9",
          "visible_if": "{{ block.settings.hero_image != blank }}"
        },
        {
          "type": "select",
          "id": "hero_image_max_width",
          "label": "Bild – Max-Breite",
          "info": "Begrenzt die Bildbreite innerhalb des Hero-Bereichs",
          "options": [
            { "value": "none", "label": "Volle Breite" },
            { "value": "25%",  "label": "25%" },
            { "value": "33%",  "label": "33%" },
            { "value": "50%",  "label": "50%" },
            { "value": "66%",  "label": "66%" },
            { "value": "75%",  "label": "75%" }
          ],
          "default": "none",
          "visible_if": "{{ block.settings.hero_image != blank }}"
        },
        {
          "type": "select",
          "id": "hero_image_align_x",
          "label": "Bild – Horizontale Ausrichtung",
          "options": [
            { "value": "left",   "label": "Links" },
            { "value": "center", "label": "Zentriert" },
            { "value": "right",  "label": "Rechts" }
          ],
          "default": "center",
          "visible_if": "{{ block.settings.hero_image_max_width != 'none' }}"
        },
        {
          "type": "select",
          "id": "hero_image_align_y",
          "label": "Bild – Vertikale Ausrichtung",
          "options": [
            { "value": "top",    "label": "Oben" },
            { "value": "center", "label": "Mitte" },
            { "value": "bottom", "label": "Unten" }
          ],
          "default": "center",
          "visible_if": "{{ block.settings.hero_image_max_width != 'none' }}"
        },
        {
          "type": "header",
          "content": "Icon"
        },
        {
          "type": "image_picker",
          "id": "icon",
          "label": "Icon"
        },
        {
          "type": "select",
          "id": "icon_size",
          "label": "Icon-Größe",
          "options": [
            { "value": "small",  "label": "Klein (40px)" },
            { "value": "medium", "label": "Mittel (76px)" },
            { "value": "large",  "label": "Groß (120px)" }
          ],
          "default": "medium",
          "visible_if": "{{ block.settings.icon != blank }}"
        },
        {
          "type": "select",
          "id": "icon_position",
          "label": "Icon-Position",
          "options": [
            { "value": "top",  "label": "Oben (Standard)" },
            { "value": "left", "label": "Links (horizontal)" }
          ],
          "default": "top",
          "visible_if": "{{ block.settings.icon != blank }}"
        },
        {
          "type": "header",
          "content": "Inhalt"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Überschrift"
        },
        {
          "type": "select",
          "id": "heading_class",
          "label": "Überschrift – Größe",
          "options": [
            { "value": "h1", "label": "H1" },
            { "value": "h2", "label": "H2" },
            { "value": "h3", "label": "H3" },
            { "value": "h4", "label": "H4" },
            { "value": "h5", "label": "H5" },
            { "value": "h6", "label": "H6" }
          ],
          "default": "h4"
        },
        {
          "type": "checkbox",
          "id": "heading_uppercase",
          "label": "Überschrift – Großbuchstaben",
          "default": false
        },
        {
          "type": "richtext",
          "id": "content",
          "label": "Text"
        },
        {
          "type": "select",
          "id": "text_font_size",
          "label": "Text – Schriftgröße",
          "options": [
