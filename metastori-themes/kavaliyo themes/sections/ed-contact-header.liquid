<style>
    #shopify-section-{{ section.id }} {
      {%- if section.settings.background == 'rgba(0,0,0,0)' -%}
        {%- assign section_background = settings.background -%}
      {%- else -%}
        {%- assign section_background = section.settings.background -%}
      {%- endif -%}
  
      {%- if section.settings.text_color == 'rgba(0,0,0,0)' -%}
        {%- assign heading_color = settings.heading_color -%}
        {%- assign text_color = settings.text_color -%}
      {%- else -%}
        {%- assign heading_color = section.settings.text_color -%}
        {%- assign text_color = section.settings.text_color -%}
      {%- endif -%}
  
      --heading-color: {{ heading_color.red }}, {{ heading_color.green }}, {{ heading_color.blue }};
      --text-color: {{ text_color.red }}, {{ text_color.green }}, {{ text_color.blue }};
      --prev-next-button-background: var(--text-color);
      --prev-next-button-color: var(--section-background);
      --progress-bar-width: 450px;
  
      --section-background: {{ section_background.red }}, {{ section_background.green }}, {{ section_background.blue }};
    }
  
    #shopify-section-{{ section.id }} {
      background-color: rgb(var(--section-background));
    }
  
    @media (min-width: 1000px) {
      #shopify-section-{{ section.id }} {
          padding-top: {{ section.settings.space_top -}}px;
          padding-bottom: {{ section.settings.space_bottom -}}px;
      }
    }
    @media (max-width: 999px) {
      #shopify-section-{{ section.id }} {
        padding-top: {{ section.settings.space_top_mobile -}}px;
        padding-bottom: {{ section.settings.space_bottom_mobile -}}px;
      }
    }
  
    .marken_uebersicht_heading_wrapper {
      text-align: center;
      margin-bottom: 32px;
    }
  
    .marken_uebersicht_heading_wrapper h3.heading {
        margin-bottom: 16px;
        line-height: 1;
    }
  
    .marken_uebersicht_heading_wrapper p {
        margin-top: 0;
    }
    .muhc_link_arrow_icon a {
        position: relative;
        padding-right: 24px;
    }
    
    .muhc_link_arrow_icon a:before {
        content: "";
        position: absolute;
        right: 0;
        width: 20px;
        height: 80%;
        display: block;
        top: 10%;
        background: url('{{ 'arrow-right.svg' | asset_url }}') no-repeat center;
        background-size: contain;
    }
</style>
  
<section class="ed-contact-header">
    <div class="section__color-wrapper">
      {%- if section.settings.subheading != blank or section.settings.title != blank -%}
        <header class="marken_uebersicht_heading_wrapper container text-container">
          {%- if section.settings.subheading != blank -%}
            <h2 class="heading heading--small">{{ section.settings.subheading | escape }}</h2>
          {%- endif -%}
  
          {%- if section.settings.title != blank -%}
            <h3 class="heading h2">{{ section.settings.title | escape }}</h3>
          {%- endif -%}
  
          {%- if section.settings.show_header_divider -%}
            {% render 'ed-heart-divider', margin: '20px' %}
          {%- endif -%}

          {%- if section.settings.content != blank -%}
            <div class="marken_uebersicht_heading_content {% if section.settings.show_link_arrow_icon %}muhc_link_arrow_icon{% endif %}">
                {{- section.settings.content -}}
            </div>
          {%- endif -%}
        </header>
      {%- endif -%}
    </div>
</section>
  
{% schema %}
  {
    "name": "Contact Header",
    "class": "shopify-section--contact-header",
    "disabled_on": {
      "groups": ["header", "custom.overlay"]
    },
    "settings": [
      {
        "type": "text",
        "id": "subheading",
        "label": "Subheading"
      },
      {
        "type": "text",
        "id": "title",
        "label": "Heading",
        "default": "Sprich mit uns"
      },
      {
        "type": "richtext",
        "id": "content",
        "label": "Content",
        "default": "<p>Entdecke die Top-Marken im Reitsport bei kavalio</p>"
      },
      {
        "type": "checkbox",
        "id": "show_link_arrow_icon",
        "label": "Show link arrow icon",
        "default": true
      },
      {
        "type": "checkbox",
        "id": "show_header_divider",
        "label": "Show header divider",
        "default": true
      },
      {
        "type": "header",
        "content": "Colors"
      },
      {
        "type": "color",
        "id": "background",
        "label": "Background",
        "default": "rgba(0,0,0,0)"
      },
      {
        "type": "color",
        "id": "text_color",
        "label": "Color",
        "default": "rgba(0,0,0,0)"
      },
      {
        "type": "header",
        "content": "Section spacing"
      },
      {
        "type": "range",
        "id": "space_top",
        "min": 1,
        "max": 100,
        "step": 1,
        "unit": "px",
        "label": "Top space",
        "default": 75
      },
      {
        "type": "range",
        "id": "space_bottom",
        "min": 1,
        "max": 100,
        "step": 1,
        "unit": "px",
        "label": "Bottom space",
        "default": 60
      },
      {
        "type": "paragraph",
        "content": "Section spacing (Mobile)"
      },
      {
        "type": "range",
        "id": "space_top_mobile",
        "min": 1,
        "max": 100,
        "step": 1,
        "unit": "px",
        "label": "Top (mobile)",
        "default": 60
      },
      {
        "type": "range",
        "id": "space_bottom_mobile",
        "min": 1,
        "max": 100,
        "step": 1,
        "unit": "px",
        "label": "Bottom (mobile)",
        "default": 30
      },
    ],
    "presets": [
      {
        "name": "Contact Header",
        "settings": {
          "background": "#F6F6F6"
        }
      } 
    ]
  }
{% endschema %}