        "liquid_3Vqhae": {
          "type": "liquid",
          "settings": {
            "liquid": "{%- comment -%}\n  ============================================================\n  Produktvideo – Button + Lightbox\n  ============================================================\n  Einfügen als Block \"Custom Liquid\" in der Produkt-Sektion\n  (Theme-Editor > Produktseite > Block hinzufügen > Custom Liquid).\n\n  Erscheint automatisch nur dann, wenn beim Produkt ein Video\n  hinterlegt ist. Bevorzugt ein in Shopify hochgeladenes Video,\n  fällt sonst auf YouTube/Vimeo zurück.\n  ============================================================\n{%- endcomment -%}\n\n{%- assign pv = product.media | where: 'media_type', 'video' | first -%}\n{%- unless pv -%}\n  {%- assign pv = product.media | where: 'media_type', 'external_video' | first -%}\n{%- endunless -%}\n\n{%- if pv -%}\n\n  {%- assign pv_uid = 'pv-' | append: product.id -%}\n  {%- assign pv_ratio = pv.aspect_ratio | default: 1.7778 -%}\n\n  {%- comment -%} Beschriftungen – hier anpassen {%- endcomment -%}\n  {%- assign pv_label = 'Video ansehen' -%}\n  {%- assign pv_sub = 'Produkt in Bewegung' -%}\n\n  {%- if pv.media_type == 'external_video' -%}\n    {%- if pv.host == 'vimeo' -%}\n      {%- assign pv_src = 'https://player.vimeo.com/video/' | append: pv.external_id | append: '?autoplay=1' -%}\n    {%- else -%}\n      {%- assign pv_src = 'https://www.youtube-nocookie.com/embed/' | append: pv.external_id | append: '?autoplay=1&amp;rel=0&amp;playsinline=1' -%}\n    {%- endif -%}\n  {%- endif -%}\n\n  <div\n    class=\"pv\"\n    id=\"{{ pv_uid }}\"\n    data-pv-type=\"{% if pv.media_type == 'video' %}hosted{% else %}embed{% endif %}\"\n    {% if pv_src %}data-pv-src=\"{{ pv_src }}\"{% endif %}\n  >\n    <button type=\"button\" class=\"pv__trigger\" data-pv-open aria-haspopup=\"dialog\">\n      {%- if pv.preview_image -%}\n        <span class=\"pv__thumb\">\n          <img\n            src=\"{{ pv.preview_image | image_url: width: 180 }}\"\n            alt=\"\"\n            width=\"60\"\n            height=\"60\"\n            loading=\"lazy\"\n          >\n          <svg class=\"pv__play\" viewBox=\"0 0 24 24\" aria-hidden=\"true\" focusable=\"false\">\n            <path d=\"M9 7.5v9l7.5-4.5z\" fill=\"currentColor\"></path>\n          </svg>\n        </span>\n      {%- endif -%}\n      <span class=\"pv__text\">\n        <span class=\"pv__label\">{{ pv_label }}</span>\n        {%- if pv_sub != blank -%}<span class=\"pv__sub\">{{ pv_sub }}</span>{%- endif -%}\n      </span>\n    </button>\n\n    <div class=\"pv__modal\" data-pv-modal role=\"dialog\" aria-modal=\"true\" aria-label=\"{{ pv_label }}\" hidden>\n      <div class=\"pv__backdrop\" data-pv-close></div>\n      <div class=\"pv__box\" style=\"--pv-ratio: {{ pv_ratio }};\">\n        <button type=\"button\" class=\"pv__close\" data-pv-close data-pv-focus aria-label=\"Schließen\">\n          <svg viewBox=\"0 0 24 24\" aria-hidden=\"true\" focusable=\"false\">\n            <path d=\"M6 6l12 12M18 6L6 18\" stroke=\"currentColor\" stroke-width=\"2\" fill=\"none\" stroke-linecap=\"round\"></path>\n          </svg>\n        </button>\n        <div class=\"pv__stage\" data-pv-stage></div>\n      </div>\n    </div>\n\n    {%- if pv.media_type == 'video' -%}\n      <template data-pv-template>\n        <video\n          controls\n          autoplay\n          playsinline\n          preload=\"none\"\n          poster=\"{{ pv.preview_image | image_url: width: 1400 }}\"\n        >\n          {%- for source in pv.sources -%}\n            {%- if source.format == 'mp4' -%}\n              <source src=\"{{ source.url }}\" type=\"{{ source.mime_type }}\">\n            {%- endif -%}\n          {%- endfor -%}\n        </video>\n      </template>\n    {%- endif -%}\n  </div>\n\n  <style>\n    #{{ pv_uid }} .pv__trigger {\n      display: inline-flex;\n      align-items: center;\n      gap: 0.75rem;\n      padding: 0.5rem 1rem 0.5rem 0.5rem;\n      margin: 0;\n      border: 1px solid currentColor;\n      border-radius: var(--buttons-radius, 4px);\n      background: transparent;\n      color: inherit;\n      font: inherit;\n      text-align: left;\n      cursor: pointer;\n      transition: opacity 0.15s ease;\n    }\n    #{{ pv_uid }} .pv__trigger:hover { opacity: 0.7; }\n    #{{ pv_uid }} .pv__trigger:focus-visible { outline: 2px solid currentColor; outline-offset: 2px; }\n\n    #{{ pv_uid }} .pv__thumb {\n      position: relative;\n      flex: 0 0 auto;\n      width: 3.25rem;\n      height: 3.25rem;\n      overflow: hidden;\n      border-radius: calc(var(--buttons-radius, 4px) / 1.5);\n      background: rgba(0, 0, 0, 0.06);\n    }\n    #{{ pv_uid }} .pv__thumb img {\n      width: 100%;\n      height: 100%;\n      object-fit: cover;\n      display: block;\n    }\n    #{{ pv_uid }} .pv__play {\n      position: absolute;\n      inset: 0;\n      margin: auto;\n      width: 1.75rem;\n      height: 1.75rem;\n      color: #fff;\n      filter: drop-shadow(0 1px 3px rgba(0, 0, 0, 0.6));\n    }\n\n    #{{ pv_uid }} .pv__text { display: flex; flex-direction: column; line-height: 1.25; }\n    #{{ pv_uid }} .pv__label { font-weight: 600; }\n    #{{ pv_uid }} .pv__sub { font-size: 0.8125em; opacity: 0.65; }\n\n    #{{ pv_uid }} .pv__modal[hidden] { display: none; }\n    #{{ pv_uid }} .pv__modal {\n      position: fixed;\n      inset: 0;\n      z-index: 100000;\n      display: flex;\n      align-items: center;\n      justify-content: center;\n      padding: 1rem;\n    }\n    #{{ pv_uid }} .pv__backdrop {\n      position: absolute;\n      inset: 0;\n      background: rgba(0, 0, 0, 0.82);\n      animation: pv-fade 0.18s ease-out;\n    }\n    #{{ pv_uid }} .pv__box {\n      position: relative;\n      width: min(100%, 62rem);\n      aspect-ratio: var(--pv-ratio, 1.7778);\n      max-height: calc(100vh - 6rem);\n      background: #000;\n      border-radius: var(--media-radius, 4px);\n      overflow: hidden;\n    }\n    #{{ pv_uid }} .pv__stage,\n    #{{ pv_uid }} .pv__stage > * {\n      width: 100%;\n      height: 100%;\n      display: block;\n      border: 0;\n    }\n    #{{ pv_uid }} .pv__close {\n      position: absolute;\n      top: 0.5rem;\n      right: 0.5rem;\n      z-index: 2;\n      width: 2.5rem;\n      height: 2.5rem;\n      display: grid;\n      place-items: center;\n      padding: 0;\n      border: 0;\n      border-radius: 50%;\n      background: rgba(0, 0, 0, 0.55);\n      color: #fff;\n      cursor: pointer;\n    }\n    #{{ pv_uid }} .pv__close svg { width: 1.25rem; height: 1.25rem; }\n    #{{ pv_uid }} .pv__close:focus-visible { outline: 2px solid #fff; outline-offset: 2px; }\n\n    @keyframes pv-fade { from { opacity: 0; } to { opacity: 1; } }\n    @media (prefers-reduced-motion: reduce) {\n      #{{ pv_uid }} .pv__backdrop { animation: none; }\n      #{{ pv_uid }} .pv__trigger { transition: none; }\n    }\n  </style>\n\n  <script>\n    (function () {\n      var root = document.getElementById('{{ pv_uid }}');\n      if (!root || root.dataset.pvReady) return;\n      root.dataset.pvReady = '1';\n\n      var modal = root.querySelector('[data-pv-modal]');\n      var stage = root.querySelector('[data-pv-stage]');\n      var trigger = root.querySelector('[data-pv-open]');\n      var lastFocus = null;\n\n      function onKey(e) {\n        if (e.key === 'Escape') closeVideo();\n      }\n\n      function openVideo() {\n        lastFocus = document.activeElement;\n\n        if (root.dataset.pvType === 'hosted') {\n          var tpl = root.querySelector('[data-pv-template]');\n          if (tpl) stage.appendChild(tpl.content.cloneNode(true));\n        } else {\n          var frame = document.createElement('iframe');\n          frame.setAttribute('src', root.dataset.pvSrc);\n          frame.setAttribute('title', 'Produktvideo');\n          frame.setAttribute('allow', 'autoplay; encrypted-media; picture-in-picture; fullscreen');\n          frame.setAttribute('allowfullscreen', '');\n          stage.appendChild(frame);\n        }\n\n        modal.hidden = false;\n        document.body.style.overflow = 'hidden';\n        root.querySelector('[data-pv-focus]').focus();\n        document.addEventListener('keydown', onKey);\n      }\n\n      function closeVideo() {\n        modal.hidden = true;\n        stage.replaceChildren();\n        document.body.style.overflow = '';\n        document.removeEventListener('keydown', onKey);\n        if (lastFocus && lastFocus.focus) lastFocus.focus();\n      }\n\n      trigger.addEventListener('click', openVideo);\n      root.querySelectorAll('[data-pv-close]').forEach(function (el) {\n        el.addEventListener('click', closeVideo);\n      });\n    })();\n  </script>\n\n{%- endif -%}"
          }
        },
