    "faq": {
      "type": "faq",
      "blocks": {
        "faq-1": {
          "type": "question",
          "settings": {
            "title": "Ist die Reithelmberatung wirklich kostenlos?",
            "answer": "<p>Ja, unsere Reithelmberatung ist zu 100% kostenlos und unverbindlich. Du gehst keinerlei Verpflichtungen ein und kannst dich ganz in Ruhe beraten lassen.</p>"
          }
        },
        "faq-2": {
          "type": "question",
          "settings": {
            "title": "Wie sieht der Ablauf der Beratung aus?",
            "answer": "<p>Du buchst einen Termin über unseren Online-Kalender. Zum vereinbarten Zeitpunkt rufen wir dich per Video an. Gemeinsam besprechen wir deine Wünsche, messen deine Kopfform aus und konfigurieren deinen perfekten Reithelm.</p>"
          }
        },
        "faq-3": {
          "type": "question",
          "settings": {
            "title": "Wie viel Zeit sollte ich für die Beratung einplanen?",
            "answer": "<p>Plane ca. 30 Minuten für deine persönliche Beratung ein. So haben wir genug Zeit, alle deine Fragen zu beantworten und den perfekten Helm für dich zu finden.</p>"
          }
        },
        "question_NmGqyk": {
          "type": "question",
          "settings": {
            "title": "Muss ich etwas für den Termin vorbereiten?",
            "answer": "<p>Alles, was du brauchst, ist ein Maßband. Damit messen wir gemeinsam deinen Kopfumfang, um die passende Helmgröße für dich zu finden.</p>"
          }
        },
        "faq-4": {
          "type": "question",
          "settings": {
            "title": "Kann ich den konfigurierten Helm direkt kaufen?",
            "answer": "<p>Ja, nach der Beratung kannst du deinen individuell konfigurierten Helm direkt bei uns bestellen. Wir kümmern uns um alles Weitere.</p>"
          }
        },
        "faq-5": {
          "type": "question",
          "settings": {
            "title": "Kann ich einen individuell angefertigten Helm zurückgeben?",
            "answer": "<p>Nein, individuell angefertigte Helme sind vom Widerrufsrecht ausgeschlossen, da sie speziell nach deinen persönlichen Wünschen konfiguriert werden.</p>"
          }
        },
        "faq-6": {
          "type": "question",
          "settings": {
            "title": "Kann ich meinen Termin verschieben oder absagen?",
            "answer": "<p>Ja, du kannst deinen Termin jederzeit über den Link in deiner E-Mail-Bestätigung verschieben oder absagen.</p>"
          }
        },
        "faq-7": {
          "type": "question",
          "settings": {
            "title": "Kann ich einen Folgetermin buchen?",
            "answer": "<p>Ja, selbstverständlich! Du kannst jederzeit einen Folgetermin buchen, um offene Fragen zu klären oder Änderungen an deiner Konfiguration vorzunehmen.</p>"
          }
        }
      },
