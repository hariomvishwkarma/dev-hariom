{% doc %}
  @prompt
    Ich brauche ein Modul, bei dem ich die Möglichkeit habe, Bilder in den Hintergrund, als auch Bilder alleine zu setzen, als auch Text alleine setzen zu können. Auch hier muss ich sowohl in der Desktop, als auch in der mobilen Version unterschiedliche Bilder wählen können, alle Größen und Abstände müssen zu jeder Seite sowohl Desktop, als auch mobil einstellbar sein, Ich kann den Text bisher nicht sehen, ich muss bei dem Text auswählen können, ob er linksbündig, zentriert, oder rechtsbündig sein soll, die Breite mobil muss noch einstellbar sein
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-flexible-content-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    max-width: 100%;
    margin: 0 auto;
  }

  .ai-flexible-content-wrapper-{{ ai_gen_id }} {
    position: relative;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    margin: 0 auto;
    padding-top: {{ block.settings.padding_top_desktop }}px;
    padding-bottom: {{ block.settings.padding_bottom_desktop }}px;
    padding-left: {{ block.settings.padding_left_desktop }}px;
    padding-right: {{ block.settings.padding_right_desktop }}px;
  }

  .ai-flexible-content-background-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    z-index: 0;
  }

  .ai-flexible-content-background-{{ ai_gen_id }} img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ai-flexible-content-inner-{{ ai_gen_id }} {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    gap: {{ block.settings.content_gap_desktop }}px;
  }

  .ai-flexible-content-image-{{ ai_gen_id }} {
    width: 100%;
  }

  .ai-flexible-content-image-{{ ai_gen_id }} img {
    width: 100%;
    height: auto;
    display: block;
  }

  .ai-flexible-content-text-{{ ai_gen_id }} {
    color: {{ block.settings.text_color }};
    font-size: {{ block.settings.text_size_desktop }}px;
    line-height: 1.5;
    text-align: {{ block.settings.text_align_desktop }};
  }

  .ai-flexible-content-text-{{ ai_gen_id }} h1,
  .ai-flexible-content-text-{{ ai_gen_id }} h2,
  .ai-flexible-content-text-{{ ai_gen_id }} h3,
  .ai-flexible-content-text-{{ ai_gen_id }} h4,
  .ai-flexible-content-text-{{ ai_gen_id }} h5,
  .ai-flexible-content-text-{{ ai_gen_id }} h6 {
    color: {{ block.settings.heading_color }};
    margin-top: 0;
    margin-bottom: 0.5em;
  }

  .ai-flexible-content-text-{{ ai_gen_id }} p {
    margin-top: 0;
    margin-bottom: 1em;
  }

  .ai-flexible-content-text-{{ ai_gen_id }} p:last-child {
    margin-bottom: 0;
  }

  @media screen and (max-width: 749px) {
    .ai-flexible-content-wrapper-{{ ai_gen_id }} {
      width: {{ block.settings.mobile_width_percent }}%;
      padding-top: {{ block.settings.padding_top_mobile }}px;
      padding-bottom: {{ block.settings.padding_bottom_mobile }}px;
      padding-left: {{ block.settings.padding_left_mobile }}px;
      padding-right: {{ block.settings.padding_right_mobile }}px;
    }

    .ai-flexible-content-inner-{{ ai_gen_id }} {
      gap: {{ block.settings.content_gap_mobile }}px;
    }

    .ai-flexible-content-text-{{ ai_gen_id }} {
      font-size: {{ block.settings.text_size_mobile }}px;
      text-align: {{ block.settings.text_align_mobile }};
    }

    .ai-flexible-content-background-{{ ai_gen_id }} {
      display: {% if block.settings.background_image_mobile %}block{% else %}none{% endif %};
    }

    .ai-flexible-content-background-desktop-{{ ai_gen_id }} {
      display: none;
    }
  }

  @media screen and (min-width: 750px) {
    .ai-flexible-content-background-mobile-{{ ai_gen_id }} {
      display: none;
    }
  }
{% endstyle %}

<div class="ai-flexible-content-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-flexible-content-wrapper-{{ ai_gen_id }}">
    {% if block.settings.show_background_image %}
      <div class="ai-flexible-content-background-{{ ai_gen_id }} ai-flexible-content-background-desktop-{{ ai_gen_id }}">
        {% if block.settings.background_image_desktop %}
          <img
            src="{{ block.settings.background_image_desktop | image_url: width: 2000 }}"
            alt="{{ block.settings.background_image_desktop.alt | escape }}"
            loading="lazy"
            width="{{ block.settings.background_image_desktop.width }}"
            height="{{ block.settings.background_image_desktop.height }}"
          >
        {% endif %}
      </div>

      <div class="ai-flexible-content-background-{{ ai_gen_id }} ai-flexible-content-background-mobile-{{ ai_gen_id }}">
        {% if block.settings.background_image_mobile %}
          <img
            src="{{ block.settings.background_image_mobile | image_url: width: 1000 }}"
            alt="{{ block.settings.background_image_mobile.alt | escape }}"
            loading="lazy"
            width="{{ block.settings.background_image_mobile.width }}"
            height="{{ block.settings.background_image_mobile.height }}"
          >
        {% endif %}
      </div>
    {% endif %}

    <div class="ai-flexible-content-inner-{{ ai_gen_id }}">
      {% if block.settings.show_content_image %}
        <div class="ai-flexible-content-image-{{ ai_gen_id }}">
          {% if block.settings.content_image_desktop %}
            <img
              src="{{ block.settings.content_image_desktop | image_url: width: 2000 }}"
              alt="{{ block.settings.content_image_desktop.alt | escape }}"
              loading="lazy"
              width="{{ block.settings.content_image_desktop.width }}"
              height="{{ block.settings.content_image_desktop.height }}"
              class="ai-flexible-content-image-desktop-{{ ai_gen_id }}"
              style="display: block;"
            >
          {% endif %}

          {% if block.settings.content_image_mobile %}
            <img
              src="{{ block.settings.content_image_mobile | image_url: width: 1000 }}"
              alt="{{ block.settings.content_image_mobile.alt | escape }}"
              loading="lazy"
              width="{{ block.settings.content_image_mobile.width }}"
              height="{{ block.settings.content_image_mobile.height }}"
              class="ai-flexible-content-image-mobile-{{ ai_gen_id }}"
              style="display: none;"
            >
          {% endif %}
        </div>

        <style>
          @media screen and (max-width: 749px) {
            .ai-flexible-content-image-desktop-{{ ai_gen_id }} {
              display: {% if block.settings.content_image_mobile %}none{% else %}block{% endif %} !important;
            }
            .ai-flexible-content-image-mobile-{{ ai_gen_id }} {
              display: {% if block.settings.content_image_mobile %}block{% else %}none{% endif %} !important;
            }
          }
        </style>
      {% endif %}

      {% if block.settings.show_text %}
        <div class="ai-flexible-content-text-{{ ai_gen_id }}">
          {{ block.settings.text_content }}
        </div>
      {% endif %}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Flexibles Content-Modul",
  "tag": null,
  "settings": [
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "desktop_width_percent",
      "label": "Desktop-Breite",
      "min": 50,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 100
    },
    {
      "type": "range",
      "id": "mobile_width_percent",
      "label": "Mobil-Breite",
      "min": 50,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 100
    },
    {
      "type": "header",
      "content": "Hintergrundbild"
    },
    {
      "type": "checkbox",
      "id": "show_background_image",
      "label": "Hintergrundbild anzeigen",
      "default": false
    },
    {
      "type": "image_picker",
      "id": "background_image_desktop",
      "label": "Hintergrundbild Desktop"
    },
    {
      "type": "image_picker",
      "id": "background_image_mobile",
      "label": "Hintergrundbild Mobil"
    },
    {
      "type": "header",
      "content": "Inhaltsbild"
    },
    {
      "type": "checkbox",
      "id": "show_content_image",
      "label": "Inhaltsbild anzeigen",
      "default": false
    },
    {
      "type": "image_picker",
      "id": "content_image_desktop",
      "label": "Inhaltsbild Desktop"
    },
    {
      "type": "image_picker",
      "id": "content_image_mobile",
      "label": "Inhaltsbild Mobil"
    },
    {
      "type": "header",
      "content": "Text"
    },
    {
      "type": "checkbox",
      "id": "show_text",
      "label": "Text anzeigen",
      "default": true
    },
    {
      "type": "richtext",
      "id": "text_content",
      "label": "Textinhalt",
      "default": "<p>Fügen Sie hier Ihren Text ein</p>"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Textfarbe",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Überschriftenfarbe",
      "default": "#000000"
    },
    {
      "type": "range",
      "id": "text_size_desktop",
      "label": "Textgröße Desktop",
      "min": 12,
      "max": 32,
      "step": 1,
      "unit": "px",
      "default": 16
    },
    {
      "type": "range",
      "id": "text_size_mobile",
      "label": "Textgröße Mobil",
      "min": 12,
      "max": 28,
      "step": 1,
      "unit": "px",
      "default": 14
    },
    {
      "type": "select",
      "id": "text_align_desktop",
      "label": "Textausrichtung Desktop",
      "options": [
        {
          "value": "left",
          "label": "Linksbündig"
        },
        {
          "value": "center",
          "label": "Zentriert"
        },
        {
          "value": "right",
          "label": "Rechtsbündig"
        }
      ],
      "default": "left"
    },
    {
      "type": "select",
      "id": "text_align_mobile",
      "label": "Textausrichtung Mobil",
      "options": [
        {
          "value": "left",
          "label": "Linksbündig"
        },
        {
          "value": "center",
          "label": "Zentriert"
        },
        {
          "value": "right",
          "label": "Rechtsbündig"
        }
      ],
      "default": "left"
    },
    {
      "type": "header",
      "content": "Abstände Desktop"
    },
    {
      "type": "range",
      "id": "padding_top_desktop",
      "label": "Abstand oben",
      "min": 0,
      "max": 200,
      "step": 5,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom_desktop",
      "label": "Abstand unten",
      "min": 0,
      "max": 200,
      "step": 5,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_left_desktop",
      "label": "Abstand links",
      "min": 0,
      "max": 200,
      "step": 5,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_right_desktop",
      "label": "Abstand rechts",
      "min": 0,
      "max": 200,
      "step": 5,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "content_gap_desktop",
      "label": "Abstand zwischen Elementen",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "default": 20
    },
    {
      "type": "header",
      "content": "Abstände Mobil"
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "label": "Abstand oben",
      "min": 0,
      "max": 150,
      "step": 5,
      "unit": "px",
      "default": 20
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "label": "Abstand unten",
      "min": 0,
      "max": 150,
      "step": 5,
      "unit": "px",
      "default": 20
    },
    {
      "type": "range",
      "id": "padding_left_mobile",
      "label": "Abstand links",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "default": 20
    },
    {
      "type": "range",
      "id": "padding_right_mobile",
      "label": "Abstand rechts",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "default": 20
    },
    {
      "type": "range",
      "id": "content_gap_mobile",
      "label": "Abstand zwischen Elementen",
      "min": 0,
      "max": 80,
      "step": 5,
      "unit": "px",
      "default": 15
    }
  ],
  "presets": [
    {
      "name": "Flexibles Content-Modul"
    }
  ]
}
{% endschema %}