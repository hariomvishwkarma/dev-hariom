{% doc %}
  @prompt
    Ich benötige ein Element für einen Simplen Textabschnitt. Es muss die Option einer Überschrift geben, eine mobile, eine Desktop Version. Der Text muss in unserem Stil sein, zentriert und die Größe für Desttop, als auch mobil einstellbar sein. Der Abstand des Textes muss sowohl nach links, rechts, oben und unten komplett einstellbar sein, Die Textgrößen und stile müssen wie bei dem block oben, der mit "Du liebst Reitport..." beginnt, sein
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-text-section-{{ ai_gen_id }} {
    width: 100%;
    display: block;
    padding-top: {{ block.settings.padding_top_mobile }}px;
    padding-bottom: {{ block.settings.padding_bottom_mobile }}px;
    padding-left: {{ block.settings.padding_left_mobile }}px;
    padding-right: {{ block.settings.padding_right_mobile }}px;
  }

  .ai-text-section-content-{{ ai_gen_id }} {
    text-align: center;
    max-width: 100%;
  }

  .ai-text-section-heading-{{ ai_gen_id }} {
    margin: 0 0 16px 0;
    color: {{ settings.heading_color }};
    font-size: {{ block.settings.heading_size_mobile }}px;
    {% if settings.header_custom_font %}
      font-family: {{ settings.header_custom_font_family }};
      font-weight: {{ settings.header_custom_font_weight }};
    {% else %}
      font-family: {{ settings.heading_font.family }}, {{ settings.heading_font.fallback_families }};
      font-weight: {{ settings.heading_font.weight }};
    {% endif %}
    text-transform: {{ settings.heading_text_transform }};
    letter-spacing: {{ settings.heading_word_spacing }}px;
  }

  .ai-text-section-text-{{ ai_gen_id }} {
    margin: 0;
    color: {{ settings.text_color }};
    font-size: {{ block.settings.text_size_mobile }}px;
    {% if settings.body_custom_font %}
      font-family: {{ settings.body_custom_font_family }};
      font-weight: {{ settings.body_custom_font_weight }};
    {% else %}
      font-family: {{ settings.text_font.family }}, {{ settings.text_font.fallback_families }};
      font-weight: {{ settings.text_font.weight }};
    {% endif %}
    letter-spacing: {{ settings.paragraph_word_spacing }}px;
    line-height: 1.6;
  }

  @media screen and (min-width: 750px) {
    .ai-text-section-{{ ai_gen_id }} {
      padding-top: {{ block.settings.padding_top_desktop }}px;
      padding-bottom: {{ block.settings.padding_bottom_desktop }}px;
      padding-left: {{ block.settings.padding_left_desktop }}px;
      padding-right: {{ block.settings.padding_right_desktop }}px;
      width: {{ block.settings.desktop_width_percent }}%;
    }

    .ai-text-section-heading-{{ ai_gen_id }} {
      font-size: {{ block.settings.heading_size_desktop }}px;
    }

    .ai-text-section-text-{{ ai_gen_id }} {
      font-size: {{ block.settings.text_size_desktop }}px;
    }
  }
{% endstyle %}

<div class="ai-text-section-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-text-section-content-{{ ai_gen_id }}">
    {% if block.settings.heading != blank %}
      <h2 class="ai-text-section-heading-{{ ai_gen_id }}">{{ block.settings.heading }}</h2>
    {% endif %}
    {% if block.settings.text != blank %}
      <div class="ai-text-section-text-{{ ai_gen_id }}">{{ block.settings.text }}</div>
    {% endif %}
  </div>
</div>

{% schema %}
{
  "name": "Textabschnitt",
  "settings": [
    {
      "type": "header",
      "content": "Inhalt"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Überschrift"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>Fügen Sie hier Ihren Text ein</p>"
    },
    {
      "type": "header",
      "content": "Desktop"
    },
    {
      "type": "range",
      "id": "desktop_width_percent",
      "label": "Breite",
      "min": 50,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 100
    },
    {
      "type": "range",
      "id": "heading_size_desktop",
      "label": "Überschriftgröße",
      "min": 16,
      "max": 80,
      "step": 2,
      "unit": "px",
      "default": 32
    },
    {
      "type": "range",
      "id": "text_size_desktop",
      "label": "Textgröße",
      "min": 12,
      "max": 32,
      "step": 1,
      "unit": "px",
      "default": 16
    },
    {
      "type": "range",
      "id": "padding_top_desktop",
      "label": "Abstand oben",
      "min": 0,
      "max": 200,
      "step": 5,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom_desktop",
      "label": "Abstand unten",
      "min": 0,
      "max": 200,
      "step": 5,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_left_desktop",
      "label": "Abstand links",
      "min": 0,
      "max": 200,
      "step": 5,
      "unit": "px",
      "default": 20
    },
    {
      "type": "range",
      "id": "padding_right_desktop",
      "label": "Abstand rechts",
      "min": 0,
      "max": 200,
      "step": 5,
      "unit": "px",
      "default": 20
    },
    {
      "type": "header",
      "content": "Mobil"
    },
    {
      "type": "range",
      "id": "heading_size_mobile",
      "label": "Überschriftgröße",
      "min": 14,
      "max": 60,
      "step": 2,
      "unit": "px",
      "default": 24
    },
    {
      "type": "range",
      "id": "text_size_mobile",
      "label": "Textgröße",
      "min": 12,
      "max": 24,
      "step": 1,
      "unit": "px",
      "default": 14
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "label": "Abstand oben",
      "min": 0,
      "max": 150,
      "step": 5,
      "unit": "px",
      "default": 30
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "label": "Abstand unten",
      "min": 0,
      "max": 150,
      "step": 5,
      "unit": "px",
      "default": 30
    },
    {
      "type": "range",
      "id": "padding_left_mobile",
      "label": "Abstand links",
      "min": 0,
      "max": 150,
      "step": 5,
      "unit": "px",
      "default": 15
    },
    {
      "type": "range",
      "id": "padding_right_mobile",
      "label": "Abstand rechts",
      "min": 0,
      "max": 150,
      "step": 5,
      "unit": "px",
      "default": 15
    }
  ],
  "presets": [
    {
      "name": "Textabschnitt"
    }
  ]
}
{% endschema %}