{% doc %}
  @prompt
    Ich brauche einen Produktslider, in dem ich Artikel aus unserem Shop mittels der Produktnnummer hinterlegen kann. Desktop 4 Produkte nebeneinander, Mobil 2 Produkte. Wenn mehr als 4 Produkte hinterlegt sind muss man durchsliden können, In dem Modul muss eingestellt werden können, wie groß die einzelnen Produkte inkl. Infos eingeblendet werden, ob alles zentriert, links oder rechtsbündig sein soll und der Abstand nach oben, unten, links und rechts, Die Überschrift muss auch zentriert wählbar sein. 
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}
{% style %}
  .ai-product-slider-{{ ai_gen_id }} { display:block; width:{{ block.settings.desktop_width_percent }}%; max-width:100%; padding:{{ block.settings.padding_top }}px {{ block.settings.padding_right }}px {{ block.settings.padding_bottom }}px {{ block.settings.padding_left }}px; color:{{ block.settings.text_color }}; box-sizing:border-box; }
  .ai-product-slider-{{ ai_gen_id }}__header { display:flex; align-items:center; justify-content:space-between; gap:16px; margin-bottom:20px; }
  .ai-product-slider-{{ ai_gen_id }}__title { margin:0; color:{{ block.settings.heading_color }}; font-size:24px; line-height:1.2; font-weight:600; text-align:{{ block.settings.heading_alignment }}; flex:1; }
  .ai-product-slider-{{ ai_gen_id }}__controls { display:flex; gap:8px; flex-shrink:0; }
  .ai-product-slider-{{ ai_gen_id }}__button { width:40px; height:40px; display:inline-flex; align-items:center; justify-content:center; color:{{ block.settings.button_text_color }}; background:{{ block.settings.button_color }}; border:1px solid {{ block.settings.button_color }}; border-radius:{{ block.settings.button_radius }}px; cursor:pointer; }
  .ai-product-slider-{{ ai_gen_id }}__button:hover { opacity:.82; }
  .ai-product-slider-{{ ai_gen_id }}__button:focus-visible { outline:2px solid {{ block.settings.heading_color }}; outline-offset:3px; }
  .ai-product-slider-{{ ai_gen_id }}__button[disabled] { opacity:.35; cursor:not-allowed; }
  .ai-product-slider-{{ ai_gen_id }}__track { display:grid; grid-auto-flow:column; grid-auto-columns:calc({{ block.settings.product_width_desktop }}% - 15px); gap:20px; overflow-x:auto; scroll-snap-type:x mandatory; scroll-behavior:smooth; scrollbar-width:none; padding:2px 2px 8px; }
  .ai-product-slider-{{ ai_gen_id }}__track::-webkit-scrollbar { display:none; }
  .ai-product-slider-{{ ai_gen_id }}__card { min-width:0; scroll-snap-align:start; color:{{ block.settings.text_color }}; text-decoration:none; text-align:{{ block.settings.text_alignment }}; }
  .ai-product-slider-{{ ai_gen_id }}__image { display:block; width:100%; aspect-ratio:1/1; object-fit:cover; background:{{ block.settings.image_background }}; border-radius:{{ block.settings.card_radius }}px; }
  .ai-product-slider-{{ ai_gen_id }}__image svg { display:block; width:100%; height:100%; }
  .ai-product-slider-{{ ai_gen_id }}__info { padding-top:{{ block.settings.info_spacing }}px; }
  .ai-product-slider-{{ ai_gen_id }}__product-title { margin:0 0 6px; color:{{ block.settings.heading_color }}; font-size:15px; line-height:1.35; }
  .ai-product-slider-{{ ai_gen_id }}__price { font-size:14px; line-height:1.3; }
  @media screen and (max-width:749px) { .ai-product-slider-{{ ai_gen_id }}__title { font-size:20px; } .ai-product-slider-{{ ai_gen_id }}__track { grid-auto-columns:calc({{ block.settings.product_width_mobile }}% - 6px); gap:12px; } }
{% endstyle %}
<product-slider-{{ ai_gen_id }} class="ai-product-slider-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-product-slider-{{ ai_gen_id }}__header">
    {% if block.settings.heading != blank %}<h2 class="ai-product-slider-{{ ai_gen_id }}__title">{{ block.settings.heading | escape }}</h2>{% endif %}
    <div class="ai-product-slider-{{ ai_gen_id }}__controls"><button class="ai-product-slider-{{ ai_gen_id }}__button" type="button" data-direction="prev" aria-label="Vorherige Produkte"><span aria-hidden="true">&#8592;</span></button><button class="ai-product-slider-{{ ai_gen_id }}__button" type="button" data-direction="next" aria-label="Nächste Produkte"><span aria-hidden="true">&#8594;</span></button></div>
  </div>
  <div class="ai-product-slider-{{ ai_gen_id }}__track" tabindex="0">
    {% for product in block.settings.products %}{% if product != blank %}<a class="ai-product-slider-{{ ai_gen_id }}__card" href="{{ product.url }}">{% if product.featured_image %}<img class="ai-product-slider-{{ ai_gen_id }}__image" src="{{ product.featured_image | image_url: width: 800 }}" alt="{{ product.featured_image.alt | default: product.title | escape }}" loading="lazy" width="800" height="800">{% else %}<div class="ai-product-slider-{{ ai_gen_id }}__image">{{ 'product-apparel-1' | placeholder_svg_tag }}</div>{% endif %}<div class="ai-product-slider-{{ ai_gen_id }}__info"><h3 class="ai-product-slider-{{ ai_gen_id }}__product-title">{{ product.title | escape }}</h3><div class="ai-product-slider-{{ ai_gen_id }}__price">{{ product.price | money }}</div></div></a>{% endif %}{% endfor %}
  </div>
</product-slider-{{ ai_gen_id }}>
<script>
(function(){class ProductSlider{{ ai_gen_id }} extends HTMLElement{connectedCallback(){this.track=this.querySelector('.ai-product-slider-{{ ai_gen_id }}__track');this.buttons=this.querySelectorAll('.ai-product-slider-{{ ai_gen_id }}__button');this.buttons.forEach((button)=>{button.addEventListener('click',()=>{const amount=this.track.clientWidth;this.track.scrollBy({left:button.dataset.direction==='next'?amount:-amount,behavior:'smooth'});});});this.updateButtons();this.track.addEventListener('scroll',()=>this.updateButtons(),{passive:true});}updateButtons(){const maxScroll=this.track.scrollWidth-this.track.clientWidth-2;this.buttons.forEach((button)=>{button.disabled=button.dataset.direction==='prev'?this.track.scrollLeft<=2:this.track.scrollLeft>=maxScroll;});}}if(!customElements.get('product-slider-{{ ai_gen_id }}'))customElements.define('product-slider-{{ ai_gen_id }}',ProductSlider{{ ai_gen_id }});})();
</script>
{% schema %}
{"name":"Produktslider","settings":[{"type":"text","id":"heading","label":"Überschrift","default":"Unsere Produkte"},{"type":"product_list","id":"products","label":"Produkte auswählen","limit":12},{"type":"header","content":"Layout"},{"type":"range","id":"desktop_width_percent","label":"Modulbreite Desktop","min":50,"max":100,"step":5,"unit":"%","default":100},{"type":"range","id":"product_width_desktop","label":"Produktbreite Desktop","min":15,"max":50,"step":5,"unit":"%","default":25},{"type":"range","id":"product_width_mobile","label":"Produktbreite Mobil","min":35,"max":80,"step":5,"unit":"%","default":50},{"type":"select","id":"heading_alignment","label":"Überschrift ausrichten","options":[{"value":"left","label":"Linksbündig"},{"value":"center","label":"Zentriert"},{"value":"right","label":"Rechtsbündig"}],"default":"left"},{"type":"select","id":"text_alignment","label":"Produkte ausrichten","options":[{"value":"left","label":"Linksbündig"},{"value":"center","label":"Zentriert"},{"value":"right","label":"Rechtsbündig"}],"default":"left"},{"type":"header","content":"Abstände"},{"type":"range","id":"padding_top","label":"Oben","min":0,"max":100,"step":5,"unit":"px","default":0},{"type":"range","id":"padding_bottom","label":"Unten","min":0,"max":100,"step":5,"unit":"px","default":0},{"type":"range","id":"padding_left","label":"Links","min":0,"max":100,"step":5,"unit":"px","default":0},{"type":"range","id":"padding_right","label":"Rechts","min":0,"max":100,"step":5,"unit":"px","default":0},{"type":"range","id":"info_spacing","label":"Abstand zum Produkttext","min":0,"max":40,"step":2,"unit":"px","default":12},{"type":"header","content":"Farben"},{"type":"color","id":"heading_color","label":"Überschrift","default":"#1c1b1b"},{"type":"color","id":"text_color","label":"Text","default":"#677279"},{"type":"color","id":"button_color","label":"Pfeilfläche","default":"#1e2d7d"},{"type":"color","id":"button_text_color","label":"Pfeile","default":"#ffffff"},{"type":"color","id":"image_background","label":"Bildhintergrund","default":"#f7f8fd"},{"type":"header","content":"Form"},{"type":"range","id":"card_radius","label":"Bildradius","min":0,"max":24,"step":2,"unit":"px","default":0},{"type":"range","id":"button_radius","label":"Pfeilradius","min":0,"max":24,"step":2,"unit":"px","default":0}],"presets":[{"name":"Produktslider"}],"tag":null,"class":"produkt-slider-block"}
{% endschema %}