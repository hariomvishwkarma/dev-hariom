{% doc %}
  @prompt
    Ich brauche einen passenden Abschnitt um eine Stellenanzeige niederzuschreiben. Hier in vermutlich Fehlerhafter Formatierung der Text, der die Stellenanzeige beschreibt:
    
    Customer Happiness Manager (m/w/d)
    🚀 Um unser Team weiter zu stärken, suchen wir einen motivierten Customer Happiness Manager (m/w/d), der/die uns im täglichen Kundenkontakt unterstützt und aktiv dazu beiträgt, ein herausragendes Serviceerlebnis im E-Commerce zu schaffen.
    
    
    💚 Das erwartet Dich:
    
    Unterstützung des Customer-Happiness-Teams im operativen Tagesgeschäft
    
    Bearbeitung von Kundenanfragen per Ticketsystem, Live-Chat und Telefon
    
    Abwicklung aller Anliegen rund um Bestellungen, Lieferstatus, Retouren und Reklamationen
    
    Mitarbeit bei der Optimierung von Serviceprozessen und internen Abläufen
    
    Unterstützung bei der Erstellung und Pflege von FAQs, Helpcenter-Artikeln und Textbausteinen
    
    Enge Zusammenarbeit mit angrenzenden Teams wie Logistik und Einkauf
    
    👤 Was solltest Du mitbringen?
    
    Abgeschlossene kaufmännische Ausbildung oder abgeschlossenes Studium idealerweise im Bereich BWL, E-Commerce, Kommunikation, Wirtschaft oder vergleichbar
    
    Erste Erfahrung im Kundenservice oder im Umgang mit Zendesk von Vorteil, aber kein Muss
    
    Ausgeprägte Service- und Kundenorientierung
    
    Sehr gute kommunikative Fähigkeiten in Wort und Schrift
    
    Strukturierte, zuverlässige und selbstständige Arbeitsweise
    
    Schnelle Auffassungsgabe und Bereitschaft, Neues zu lernen
    
    Sehr gute Deutschkenntnisse, Englischkenntnisse von Vorteil
    
    Teamfähigkeit und eine hands-on Mentalität
    
    Erfahrungen mit Shopify, Plenty ONE & Pixi von Vorteil, aber kein Muss
    
    🎯 Was bieten wir Dir?
    
    Ein innovatives, familiäres Arbeitsumfeld in einem wachsenden Unternehmen
    
    Moderne Büros & Ausstattung
    
    Flexible Arbeitszeiten
    
    Flache Hierarchien und Raum für kreative Ideen
    
    Attraktive Vergütung
    
    Kostenlose Getränke, Obst, Kaffee und vieles mehr
    
    Regelmäßige Teamevents
    
    Mitarbeiterrabatte & Corporate Benefits
    
    Job-Bike
    
    Es muss sowohl mobil als auch für die Desktop version editierbar sein. Also Schriften, Abstände usw alles anpassbar sein, Alles zentriert bitte, Das ist nicht alles zentriert! Auch die aufzählingspunkte müssen zentriert sein!, Ist es möglich, dass man unter dem Jobtitel und dem ersten Satz der Beschreibung alles weitere "aufklappen" muss um alles lesen zu können?, Und den Button jetzt in dem Türkus wie oben, Der Abstand des Textes muss nach Links, rechts, oben und unten, sowohl mobil, als auch Desktop getrennt einstellbar sein , Die Schriftgröße des Stellentitels muss auch anpassbar sein für desktop und mobil
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-job-posting-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    margin: 0 auto;
    padding-top: {{ block.settings.padding_top }}px;
    padding-right: {{ block.settings.padding_right }}px;
    padding-bottom: {{ block.settings.padding_bottom }}px;
    padding-left: {{ block.settings.padding_left }}px;
    background-color: {{ block.settings.background_color }};
    border-radius: {{ block.settings.border_radius }}px;
    text-align: center;
  }

  .ai-job-posting-header-{{ ai_gen_id }} {
    margin-bottom: {{ block.settings.spacing_between_sections }}px;
  }

  .ai-job-posting-title-{{ ai_gen_id }} {
    font-size: {{ block.settings.title_font_size }}px;
    color: {{ block.settings.title_color }};
    margin: 0 0 {{ block.settings.title_spacing }}px 0;
    font-weight: {{ block.settings.title_font_weight }};
    line-height: 1.2;
  }

  .ai-job-posting-intro-{{ ai_gen_id }} {
    font-size: {{ block.settings.intro_font_size }}px;
    color: {{ block.settings.text_color }};
    line-height: 1.6;
    margin: 0 0 {{ block.settings.title_spacing }}px 0;
  }

  .ai-job-posting-toggle-btn-{{ ai_gen_id }} {
    background-color: {{ block.settings.button_background }};
    color: {{ block.settings.button_text_color }};
    border: 1px solid {{ block.settings.button_border_color }};
    padding: 12px 24px;
    font-size: {{ block.settings.button_font_size }}px;
    font-weight: 500;
    border-radius: {{ block.settings.button_border_radius }}px;
    cursor: pointer;
    transition: all 0.3s ease;
    display: inline-flex;
    align-items: center;
    gap: 8px;
  }

  .ai-job-posting-toggle-btn-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.button_hover_background }};
    color: {{ block.settings.button_hover_text_color }};
  }

  .ai-job-posting-toggle-icon-{{ ai_gen_id }} {
    transition: transform 0.3s ease;
    display: inline-block;
    width: 16px;
    height: 16px;
  }

  .ai-job-posting-toggle-icon-{{ ai_gen_id }}.expanded {
    transform: rotate(180deg);
  }

  .ai-job-posting-collapsible-{{ ai_gen_id }} {
    max-height: 0;
    overflow: hidden;
    transition: max-height 0.5s ease;
  }

  .ai-job-posting-collapsible-{{ ai_gen_id }}.expanded {
    max-height: 5000px;
  }

  .ai-job-posting-collapsible-content-{{ ai_gen_id }} {
    padding-top: {{ block.settings.spacing_between_sections }}px;
  }

  .ai-job-posting-section-{{ ai_gen_id }} {
    margin-bottom: {{ block.settings.spacing_between_sections }}px;
  }

  .ai-job-posting-section-{{ ai_gen_id }}:last-child {
    margin-bottom: 0;
  }

  .ai-job-posting-section-title-{{ ai_gen_id }} {
    font-size: {{ block.settings.section_title_font_size }}px;
    color: {{ block.settings.section_title_color }};
    margin: 0 0 {{ block.settings.section_title_spacing }}px 0;
    font-weight: {{ block.settings.section_title_font_weight }};
    line-height: 1.3;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
  }

  .ai-job-posting-list-{{ ai_gen_id }} {
    list-style: none;
    padding: 0;
    margin: 0 auto;
    display: inline-block;
    text-align: center;
  }

  .ai-job-posting-list-item-{{ ai_gen_id }} {
    font-size: {{ block.settings.list_font_size }}px;
    color: {{ block.settings.text_color }};
    line-height: 1.6;
    margin-bottom: {{ block.settings.list_item_spacing }}px;
    padding: 0;
    position: relative;
    text-align: center;
  }

  .ai-job-posting-list-item-{{ ai_gen_id }}:last-child {
    margin-bottom: 0;
  }

  @media screen and (max-width: 749px) {
    .ai-job-posting-{{ ai_gen_id }} {
      width: 100%;
      padding-top: {{ block.settings.mobile_padding_top }}px;
      padding-right: {{ block.settings.mobile_padding_right }}px;
      padding-bottom: {{ block.settings.mobile_padding_bottom }}px;
      padding-left: {{ block.settings.mobile_padding_left }}px;
    }

    .ai-job-posting-title-{{ ai_gen_id }} {
      font-size: {{ block.settings.mobile_title_font_size }}px;
    }

    .ai-job-posting-intro-{{ ai_gen_id }} {
      font-size: {{ block.settings.mobile_intro_font_size }}px;
    }

    .ai-job-posting-section-title-{{ ai_gen_id }} {
      font-size: {{ block.settings.mobile_section_title_font_size }}px;
    }

    .ai-job-posting-list-item-{{ ai_gen_id }} {
      font-size: {{ block.settings.mobile_list_font_size }}px;
    }

    .ai-job-posting-toggle-btn-{{ ai_gen_id }} {
      font-size: {{ block.settings.mobile_button_font_size }}px;
    }
  }
{% endstyle %}

<job-posting-{{ ai_gen_id }} class="ai-job-posting-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  {% if block.settings.job_title != blank %}
    <div class="ai-job-posting-header-{{ ai_gen_id }}">
      <h2 class="ai-job-posting-title-{{ ai_gen_id }}">{{ block.settings.job_title }}</h2>
      {% if block.settings.job_intro != blank %}
        <div class="ai-job-posting-intro-{{ ai_gen_id }}">{{ block.settings.job_intro }}</div>
      {% endif %}
      
      <button 
        class="ai-job-posting-toggle-btn-{{ ai_gen_id }}"
        aria-expanded="false"
        aria-label="{{ block.settings.button_text_collapsed }}"
      >
        <span class="ai-job-posting-toggle-text-{{ ai_gen_id }}">{{ block.settings.button_text_collapsed }}</span>
        <span class="ai-job-posting-toggle-icon-{{ ai_gen_id }}">
          <svg width="16" height="16" viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg">
            <path d="M4 6L8 10L12 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </span>
      </button>
    </div>
  {% endif %}

  <div class="ai-job-posting-collapsible-{{ ai_gen_id }}">
    <div class="ai-job-posting-collapsible-content-{{ ai_gen_id }}">
      {% if block.settings.show_expectations and block.settings.expectations_title != blank %}
        <div class="ai-job-posting-section-{{ ai_gen_id }}">
          <h3 class="ai-job-posting-section-title-{{ ai_gen_id }}">
            {% if block.settings.expectations_icon != blank %}
              {{ block.settings.expectations_icon }}
            {% endif %}
            {{ block.settings.expectations_title }}
          </h3>
          {% if block.settings.expectations_content != blank %}
            <ul class="ai-job-posting-list-{{ ai_gen_id }}">
              {% assign expectations_items = block.settings.expectations_content | split: '
' %}
              {% for item in expectations_items %}
                {% assign trimmed_item = item | strip %}
                {% if trimmed_item != blank %}
                  <li class="ai-job-posting-list-item-{{ ai_gen_id }}">{{ trimmed_item }}</li>
                {% endif %}
              {% endfor %}
            </ul>
          {% endif %}
        </div>
      {% endif %}

      {% if block.settings.show_requirements and block.settings.requirements_title != blank %}
        <div class="ai-job-posting-section-{{ ai_gen_id }}">
          <h3 class="ai-job-posting-section-title-{{ ai_gen_id }}">
            {% if block.settings.requirements_icon != blank %}
              {{ block.settings.requirements_icon }}
            {% endif %}
            {{ block.settings.requirements_title }}
          </h3>
          {% if block.settings.requirements_content != blank %}
            <ul class="ai-job-posting-list-{{ ai_gen_id }}">
              {% assign requirements_items = block.settings.requirements_content | split: '
' %}
              {% for item in requirements_items %}
                {% assign trimmed_item = item | strip %}
                {% if trimmed_item != blank %}
                  <li class="ai-job-posting-list-item-{{ ai_gen_id }}">{{ trimmed_item }}</li>
                {% endif %}
              {% endfor %}
            </ul>
          {% endif %}
        </div>
      {% endif %}

      {% if block.settings.show_benefits and block.settings.benefits_title != blank %}
        <div class="ai-job-posting-section-{{ ai_gen_id }}">
          <h3 class="ai-job-posting-section-title-{{ ai_gen_id }}">
            {% if block.settings.benefits_icon != blank %}
              {{ block.settings.benefits_icon }}
            {% endif %}
            {{ block.settings.benefits_title }}
          </h3>
          {% if block.settings.benefits_content != blank %}
            <ul class="ai-job-posting-list-{{ ai_gen_id }}">
              {% assign benefits_items = block.settings.benefits_content | split: '
' %}
              {% for item in benefits_items %}
                {% assign trimmed_item = item | strip %}
                {% if trimmed_item != blank %}
                  <li class="ai-job-posting-list-item-{{ ai_gen_id }}">{{ trimmed_item }}</li>
                {% endif %}
              {% endfor %}
            </ul>
          {% endif %}
        </div>
      {% endif %}
    </div>
  </div>
</job-posting-{{ ai_gen_id }}>

<script>
  (function() {
    class JobPosting{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
        this.button = this.querySelector('.ai-job-posting-toggle-btn-{{ ai_gen_id }}');
        this.collapsible = this.querySelector('.ai-job-posting-collapsible-{{ ai_gen_id }}');
        this.icon = this.querySelector('.ai-job-posting-toggle-icon-{{ ai_gen_id }}');
        this.buttonText = this.querySelector('.ai-job-posting-toggle-text-{{ ai_gen_id }}');
        
        this.textCollapsed = '{{ block.settings.button_text_collapsed }}';
        this.textExpanded = '{{ block.settings.button_text_expanded }}';
        
        if (this.button && this.collapsible) {
          this.button.addEventListener('click', () => this.toggle());
        }
      }

      toggle() {
        const isExpanded = this.collapsible.classList.contains('expanded');
        
        if (isExpanded) {
          this.collapsible.classList.remove('expanded');
          this.icon.classList.remove('expanded');
          this.button.setAttribute('aria-expanded', 'false');
          this.button.setAttribute('aria-label', this.textCollapsed);
          this.buttonText.textContent = this.textCollapsed;
        } else {
          this.collapsible.classList.add('expanded');
          this.icon.classList.add('expanded');
          this.button.setAttribute('aria-expanded', 'true');
          this.button.setAttribute('aria-label', this.textExpanded);
          this.buttonText.textContent = this.textExpanded;
        }
      }
    }

    customElements.define('job-posting-{{ ai_gen_id }}', JobPosting{{ ai_gen_id }});
  })();
</script>

