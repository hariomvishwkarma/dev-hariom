{% doc %}
  @prompt
    Ich brauche ein Modul, dass für den Desktop links aus einem Bild in den Proportionen 1 zu 1 besteht und rechts danach ein Textfeld. Bei dem Textfeld muss eine Überschrift möglich sein, Schriftgrößen, sowie der Abstand nach links, rechts, oben und unten einstellbar sein. Zudem muss für das gesamte Modul (kombination aus Bild und Text) der Abstand in alle Richtungen einstellbar sein. Bei der mobilen Variante soll das Bild oben sein und der Text darunter. Die Bilder für Desktop und mobil sollen einzeln wählbar sein
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}
{% style %}
.ai-image-text-{{ ai_gen_id }}{display:block;width:{{ block.settings.desktop_width_percent }}%;max-width:100%;margin:{{ block.settings.module_margin_top }}px {{ block.settings.module_margin_right }}px {{ block.settings.module_margin_bottom }}px {{ block.settings.module_margin_left }}px}.ai-image-text-{{ ai_gen_id }}__layout{display:grid;grid-template-columns:1fr 1fr;width:100%;background:{{ block.settings.background_color }}}.ai-image-text-{{ ai_gen_id }}__media{position:relative;aspect-ratio:1/1;overflow:hidden;background:{{ block.settings.placeholder_color }}}.ai-image-text-{{ ai_gen_id }}__media img,.ai-image-text-{{ ai_gen_id }}__placeholder svg{display:block;width:100%;height:100%;object-fit:cover}.ai-image-text-{{ ai_gen_id }}__placeholder{width:100%;height:100%;display:flex;align-items:center;justify-content:center;color:{{ block.settings.muted_text_color }}}.ai-image-text-{{ ai_gen_id }}__placeholder svg{max-width:70%;max-height:70%}.ai-image-text-{{ ai_gen_id }}__content{display:flex;flex-direction:column;justify-content:{{ block.settings.content_alignment }};padding:{{ block.settings.text_padding_top }}px {{ block.settings.text_padding_right }}px {{ block.settings.text_padding_bottom }}px {{ block.settings.text_padding_left }}px;color:{{ block.settings.text_color }}}.ai-image-text-{{ ai_gen_id }}__heading{margin:0 0 {{ block.settings.heading_spacing }}px;color:{{ block.settings.heading_color }};font-size:{{ block.settings.heading_size }}px;line-height:1.2}.ai-image-text-{{ ai_gen_id }}__body{font-size:{{ block.settings.body_size }}px;line-height:1.55}.ai-image-text-{{ ai_gen_id }}__body p{margin:0 0 1em}.ai-image-text-{{ ai_gen_id }}__body p:last-child{margin-bottom:0}@media screen and (max-width:749px){.ai-image-text-{{ ai_gen_id }}{width:100%;margin:{{ block.settings.module_margin_top_mobile }}px {{ block.settings.module_margin_right_mobile }}px {{ block.settings.module_margin_bottom_mobile }}px {{ block.settings.module_margin_left_mobile }}px}.ai-image-text-{{ ai_gen_id }}__layout{display:flex;flex-direction:column}.ai-image-text-{{ ai_gen_id }}__content{padding:{{ block.settings.text_padding_top_mobile }}px {{ block.settings.text_padding_right_mobile }}px {{ block.settings.text_padding_bottom_mobile }}px {{ block.settings.text_padding_left_mobile }}px}}
{% endstyle %}
<image-text-block-{{ ai_gen_id }} class="ai-image-text-{{ ai_gen_id }}" {{ block.shopify_attributes }}><div class="ai-image-text-{{ ai_gen_id }}__layout"><div class="ai-image-text-{{ ai_gen_id }}__media">{% if block.settings.desktop_image or block.settings.mobile_image %}{% if block.settings.desktop_image %}<picture>{% if block.settings.mobile_image %}<source media="(max-width: 749px)" srcset="{{ block.settings.mobile_image | image_url: width: 1200 }}">{% endif %}<img src="{{ block.settings.desktop_image | image_url: width: 1600 }}" alt="{{ block.settings.desktop_image.alt | escape }}" loading="lazy" width="{{ block.settings.desktop_image.width }}" height="{{ block.settings.desktop_image.height }}"></picture>{% else %}<img src="{{ block.settings.mobile_image | image_url: width: 1200 }}" alt="{{ block.settings.mobile_image.alt | escape }}" loading="lazy" width="{{ block.settings.mobile_image.width }}" height="{{ block.settings.mobile_image.height }}">{% endif %}{% else %}<div class="ai-image-text-{{ ai_gen_id }}__placeholder">{{ 'image' | placeholder_svg_tag }}</div>{% endif %}</div><div class="ai-image-text-{{ ai_gen_id }}__content">{% if block.settings.heading != blank %}<h2 class="ai-image-text-{{ ai_gen_id }}__heading">{{ block.settings.heading | escape }}</h2>{% endif %}{% if block.settings.body != blank %}<div class="ai-image-text-{{ ai_gen_id }}__body">{{ block.settings.body }}</div>{% endif %}</div></div></image-text-block-{{ ai_gen_id }}>
<script>(function(){if(!customElements.get('image-text-block-{{ ai_gen_id }}')){class ImageTextBlock{{ ai_gen_id }} extends HTMLElement{connectedCallback(){this.setAttribute('role','region')}}customElements.define('image-text-block-{{ ai_gen_id }}',ImageTextBlock{{ ai_gen_id }})}})();</script>
{% schema %}{"name":"Image and text","tag":null,"class":"image-text-block","settings":[{"type":"header","content":"Images"},{"type":"image_picker","id":"desktop_image","label":"Desktop image"},{"type":"image_picker","id":"mobile_image","label":"Mobile image"},{"type":"header","content":"Text"},{"type":"text","id":"heading","label":"Heading","default":"Your heading"},{"type":"richtext","id":"body","label":"Text","default":"<p>Add your content here.</p>"},{"type":"range","id":"heading_size","label":"Heading size","min":16,"max":64,"step":2,"unit":"px","default":32},{"type":"range","id":"body_size","label":"Text size","min":12,"max":28,"step":1,"unit":"px","default":16},{"type":"range","id":"heading_spacing","label":"Heading spacing","min":0,"max":50,"step":5,"unit":"px","default":15},{"type":"select","id":"content_alignment","label":"Vertical alignment","options":[{"value":"flex-start","label":"Top"},{"value":"center","label":"Center"},{"value":"flex-end","label":"Bottom"}],"default":"center"},{"type":"header","content":"Text spacing"},{"type":"range","id":"text_padding_top","label":"Top","min":0,"max":100,"step":5,"unit":"px","default":40},{"type":"range","id":"text_padding_right","label":"Right","min":0,"max":100,"step":5,"unit":"px","default":40},{"type":"range","id":"text_padding_bottom","label":"Bottom","min":0,"max":100,"step":5,"unit":"px","default":40},{"type":"range","id":"text_padding_left","label":"Left","min":0,"max":100,"step":5,"unit":"px","default":40},{"type":"header","content":"Mobile text spacing"},{"type":"range","id":"text_padding_top_mobile","label":"Top","min":0,"max":80,"step":5,"unit":"px","default":30},{"type":"range","id":"text_padding_right_mobile","label":"Right","min":0,"max":80,"step":5,"unit":"px","default":25},{"type":"range","id":"text_padding_bottom_mobile","label":"Bottom","min":0,"max":80,"step":5,"unit":"px","default":30},{"type":"range","id":"text_padding_left_mobile","label":"Left","min":0,"max":80,"step":5,"unit":"px","default":25},{"type":"header","content":"Module spacing"},{"type":"range","id":"desktop_width_percent","label":"Desktop width","min":50,"max":100,"step":5,"unit":"%","default":100},{"type":"range","id":"module_margin_top","label":"Top","min":0,"max":100,"step":5,"unit":"px","default":0},{"type":"range","id":"module_margin_right","label":"Right","min":0,"max":100,"step":5,"unit":"px","default":0},{"type":"range","id":"module_margin_bottom","label":"Bottom","min":0,"max":100,"step":5,"unit":"px","default":0},{"type":"range","id":"module_margin_left","label":"Left","min":0,"max":100,"step":5,"unit":"px","default":0},{"type":"header","content":"Mobile module spacing"},{"type":"range","id":"module_margin_top_mobile","label":"Top","min":0,"max":80,"step":5,"unit":"px","default":0},{"type":"range","id":"module_margin_right_mobile","label":"Right","min":0,"max":80,"step":5,"unit":"px","default":0},{"type":"range","id":"module_margin_bottom_mobile","label":"Bottom","min":0,"max":80,"step":5,"unit":"px","default":0},{"type":"range","id":"module_margin_left_mobile","label":"Left","min":0,"max":80,"step":5,"unit":"px","default":0},{"type":"header","content":"Colors"},{"type":"color","id":"background_color","label":"Background","default":"#ffffff"},{"type":"color","id":"heading_color","label":"Heading","default":"#1c1b1b"},{"type":"color","id":"text_color","label":"Text","default":"#677279"},{"type":"color","id":"placeholder_color","label":"Placeholder","default":"#f7f8fd"},{"type":"color","id":"muted_text_color","label":"Muted text","default":"#677279"}],"presets":[{"name":"Image and text"}]}
{% endschema %}