{% doc %}
  @prompt
    Ich brauche einen Block, der Links ein Quadratisches Bild und rechts danaben einen kleinen Texblock platizeren kann. Es muss eine Desktop- und eine mobile Version geben. Bei der mobilen Version muss das Bild über dem Text platziert werden. Abstände nach oben, unten, sowie Links und rechts müssen anpassbar sein. Das Bild muss in der Größe für beide versionen anpassbar sein, Mobil muss es beides, also Bild und Text zentriert sein. In dem Textblock muss ich in dem Text einzelnen Wörtern Links hinterlegen können, Es fehlt die Möglichkeit einer Überschrift über dem Text. 
    
    Wichtig ist auch, dass die Bilder in der Originalgröße und nicht nur quadratisch angezeigt werden können. 
    
    Auch muss sowohl Desktop, als auch mobil alles einstellbar sein. Größe des Bildes, Abstand des Bildes nach oben, unten, links und rechts usw, Die Bildgröße muss ich genauer einstellen können, Die Bildbreite muss von 10 - 100% einstellbar sein, Auch bei der Desktop Version soll das Bild über dem Text und alles zentriert sein, Der Abstand der Überschrift nach oben und unten muss noch einstellbar sein
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-image-text-block-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    padding-top: {{ block.settings.desktop_padding_top }}px;
    padding-bottom: {{ block.settings.desktop_padding_bottom }}px;
    padding-left: {{ block.settings.desktop_padding_left }}px;
    padding-right: {{ block.settings.desktop_padding_right }}px;
  }

  .ai-image-text-container-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: {{ block.settings.desktop_gap }}px;
    width: 100%;
  }

  .ai-image-wrapper-{{ ai_gen_id }} {
    flex-shrink: 0;
    {% if block.settings.desktop_image_size_mode == 'percentage' %}
      width: {{ block.settings.desktop_image_width }}%;
    {% elsif block.settings.desktop_image_size_mode == 'pixels' %}
      width: {{ block.settings.desktop_image_width_px }}px;
    {% endif %}
    margin-top: {{ block.settings.desktop_image_margin_top }}px;
    margin-bottom: {{ block.settings.desktop_image_margin_bottom }}px;
    margin-left: {{ block.settings.desktop_image_margin_left }}px;
    margin-right: {{ block.settings.desktop_image_margin_right }}px;
  }

  .ai-image-wrapper-{{ ai_gen_id }} img {
    width: 100%;
    display: block;
    {% if block.settings.desktop_image_aspect_ratio == 'square' %}
      aspect-ratio: 1 / 1;
      object-fit: cover;
      height: auto;
    {% elsif block.settings.desktop_image_aspect_ratio == 'custom' %}
      height: {{ block.settings.desktop_image_height }}px;
      object-fit: cover;
    {% elsif block.settings.desktop_image_aspect_ratio == 'original' %}
      height: auto;
      object-fit: contain;
    {% endif %}
  }

  .ai-image-placeholder-{{ ai_gen_id }} {
    width: 100%;
    background-color: #f4f4f4;
    display: flex;
    align-items: center;
    justify-content: center;
    {% if block.settings.desktop_image_aspect_ratio == 'square' %}
      aspect-ratio: 1 / 1;
    {% elsif block.settings.desktop_image_aspect_ratio == 'custom' %}
      height: {{ block.settings.desktop_image_height }}px;
    {% elsif block.settings.desktop_image_aspect_ratio == 'original' %}
      min-height: 300px;
    {% endif %}
  }

  .ai-image-placeholder-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
    max-width: 200px;
    max-height: 200px;
  }

  .ai-text-wrapper-{{ ai_gen_id }} {
    text-align: center;
    margin-top: {{ block.settings.desktop_text_margin_top }}px;
    margin-bottom: {{ block.settings.desktop_text_margin_bottom }}px;
    margin-left: {{ block.settings.desktop_text_margin_left }}px;
    margin-right: {{ block.settings.desktop_text_margin_right }}px;
  }

  .ai-heading-{{ ai_gen_id }} {
    margin-top: {{ block.settings.desktop_heading_margin_top }}px;
    margin-bottom: {{ block.settings.desktop_heading_margin_bottom }}px;
    color: {{ block.settings.heading_color }};
    font-size: {{ block.settings.desktop_heading_size }}px;
  }

  .ai-text-content-{{ ai_gen_id }} {
    color: {{ block.settings.text_color }};
    font-size: {{ block.settings.desktop_text_size }}px;
    line-height: 1.6;
  }

  .ai-text-content-{{ ai_gen_id }} a {
    color: {{ block.settings.link_color }};
    text-decoration: underline;
  }

  .ai-text-content-{{ ai_gen_id }} a:hover {
    color: {{ block.settings.link_hover_color }};
  }

  @media screen and (max-width: 749px) {
    .ai-image-text-block-{{ ai_gen_id }} {
      padding-top: {{ block.settings.mobile_padding_top }}px;
      padding-bottom: {{ block.settings.mobile_padding_bottom }}px;
      padding-left: {{ block.settings.mobile_padding_left }}px;
      padding-right: {{ block.settings.mobile_padding_right }}px;
    }

    .ai-image-text-container-{{ ai_gen_id }} {
      gap: {{ block.settings.mobile_gap }}px;
    }

    .ai-image-wrapper-{{ ai_gen_id }} {
      {% if block.settings.mobile_image_size_mode == 'percentage' %}
        width: {{ block.settings.mobile_image_width }}%;
      {% elsif block.settings.mobile_image_size_mode == 'pixels' %}
        width: {{ block.settings.mobile_image_width_px }}px;
      {% endif %}
      margin-top: {{ block.settings.mobile_image_margin_top }}px;
      margin-bottom: {{ block.settings.mobile_image_margin_bottom }}px;
      margin-left: {{ block.settings.mobile_image_margin_left }}px;
      margin-right: {{ block.settings.mobile_image_margin_right }}px;
    }

    .ai-image-wrapper-{{ ai_gen_id }} img {
      {% if block.settings.mobile_image_aspect_ratio == 'square' %}
        aspect-ratio: 1 / 1;
        object-fit: cover;
        height: auto;
      {% elsif block.settings.mobile_image_aspect_ratio == 'custom' %}
        height: {{ block.settings.mobile_image_height }}px;
        object-fit: cover;
      {% elsif block.settings.mobile_image_aspect_ratio == 'original' %}
        height: auto;
        object-fit: contain;
      {% endif %}
    }

    .ai-image-placeholder-{{ ai_gen_id }} {
      {% if block.settings.mobile_image_aspect_ratio == 'square' %}
        aspect-ratio: 1 / 1;
      {% elsif block.settings.mobile_image_aspect_ratio == 'custom' %}
        height: {{ block.settings.mobile_image_height }}px;
      {% elsif block.settings.mobile_image_aspect_ratio == 'original' %}
        min-height: 200px;
      {% endif %}
    }

    .ai-text-wrapper-{{ ai_gen_id }} {
      margin-top: {{ block.settings.mobile_text_margin_top }}px;
      margin-bottom: {{ block.settings.mobile_text_margin_bottom }}px;
      margin-left: {{ block.settings.mobile_text_margin_left }}px;
      margin-right: {{ block.settings.mobile_text_margin_right }}px;
    }

    .ai-heading-{{ ai_gen_id }} {
      margin-top: {{ block.settings.mobile_heading_margin_top }}px;
      margin-bottom: {{ block.settings.mobile_heading_margin_bottom }}px;
      font-size: {{ block.settings.mobile_heading_size }}px;
    }

    .ai-text-content-{{ ai_gen_id }} {
      font-size: {{ block.settings.mobile_text_size }}px;
    }
  }
{% endstyle %}

<image-text-block-{{ ai_gen_id }}
  class="ai-image-text-block-{{ ai_gen_id }}"
  {{ block.shopify_attributes }}
>
  <div class="ai-image-text-container-{{ ai_gen_id }}">
    <div class="ai-image-wrapper-{{ ai_gen_id }}">
      {% if block.settings.image %}
        <img
          src="{{ block.settings.image | image_url: width: 2000 }}"
          alt="{{ block.settings.image.alt | escape }}"
          loading="lazy"
          width="{{ block.settings.image.width }}"
          height="{{ block.settings.image.height }}"
        >
      {% else %}
        <div class="ai-image-placeholder-{{ ai_gen_id }}">
          {{ 'image' | placeholder_svg_tag }}
        </div>
      {% endif %}
    </div>

    <div class="ai-text-wrapper-{{ ai_gen_id }}">
      {% if block.settings.heading != blank %}
        <h2 class="ai-heading-{{ ai_gen_id }}">{{ block.settings.heading }}</h2>
      {% endif %}

      {% if block.settings.text != blank %}
        <div class="ai-text-content-{{ ai_gen_id }}">
          {{ block.settings.text }}
        </div>
      {% endif %}
    </div>
  </div>
</image-text-block-{{ ai_gen_id }}>

