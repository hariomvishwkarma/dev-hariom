{% doc %}
  @prompt
    Ich möchte einfach eine Bilddatei, mit einer Desktop und einer Mobile Version, über die komplette Breite anzeigen lassen. Wichtig hierbei ist, dass das Bild Original angezeigt wird und nicht nur ein Ausschnitt., Ich möchte den Abstand / Padding nach oben und unten einstellen können und einen Link hitnerlegen können, der auf dem ganzen Bild klickbar ist. Das Bild soll so breit dargestellt werden wie die restlichen Elemente auf dieser Seite auch!, Es soll von der Breit so dargestellt werden wie das Element oben auf der Seite, dass folgenden Code hat:
    
    <style>
      #shopify-section-{{ section.id }} {
        --progress-bar-color: {{ section.blocks.first.settings.text_color.red }}, {{ section.blocks.first.settings.text_color.green }}, {{ section.blocks.first.settings.text_color.blue }};
        --section-autoplay-duration: {% if section.settings.autoplay %}{{ section.settings.cycle_speed }}s{% else %}0s{% endif %};
        --section-animation-play-state: paused;
      }
    
      {%- for block in section.blocks -%}
        {%- assign text_position = block.settings.text_position | split: '_' | first -%}
        {%- assign text_position_mobile = block.settings.text_position_mobile | split: '_' | first -%}
    
        {%- case text_position -%}
          {%- when 'top' -%}
            {%- assign section_items_alignment = 'flex-start' -%}
          {%- when 'middle' -%}
            {%- assign section_items_alignment = 'center' -%}
          {%- when 'bottom' -%}
            {%- assign section_items_alignment = 'flex-end' -%}
        {%- endcase -%}
    
        {%- case text_position_mobile -%}
          {%- when 'top' -%}
            {%- assign section_items_alignment_mobile = 'flex-start' -%}
          {%- when 'middle' -%}
            {%- assign section_items_alignment_mobile = 'center' -%}
          {%- when 'bottom' -%}
            {%- assign section_items_alignment_mobile = 'flex-end' -%}
        {%- endcase -%}
    
        #block-{{ section.id }}-{{ block.id }} {
          --heading-color: {{ block.settings.text_color.red }}, {{ block.settings.text_color.green }}, {{ block.settings.text_color.blue }};
          --text-color: {{ block.settings.text_color.red }}, {{ block.settings.text_color.green }}, {{ block.settings.text_color.blue }};
          --primary-button-background: {{ block.settings.button_background.red }}, {{ block.settings.button_background.green }}, {{ block.settings.button_background.blue }};
          --primary-button-text-color: {{ block.settings.button_text_color.red }}, {{ block.settings.button_text_color.green }}, {{ block.settings.button_text_color.blue }};
    
          --section-blocks-alignment: {{ section_items_alignment }};
          --section-blocks-overlay-color: {{ block.settings.overlay_color.red }}, {{ block.settings.overlay_color.green }}, {{ block.settings.overlay_color.blue }};
          --section-blocks-overlay-opacity: {{ block.settings.overlay_opacity | divided_by: 100.0 }};
        }
    
        @media (max-width: 999px) {
          #block-{{ section.id }}-{{ block.id }} {
            --section-blocks-alignment: {{ section_items_alignment_mobile }};
          }
        }
      {%- endfor -%}
    
      #shopify-section-{{ section.id }} slide-show  {
        background-color: {{ section.settings.background }};
        border-radius: {{ section.settings.border_radius -}}px;
        overflow: hidden;
      }
      @media (min-width: 1000px) {
    
        #shopify-section-{{ section.id }} .section {
          margin-top: {{ section.settings.space_top -}}px;
          margin-bottom: {{ section.settings.space_bottom -}}px;
        }
      }
      @media (max-width: 999px) {
        #shopify-section-{{ section.id }} .section {
          margin-top: {{ section.settings.space_top_mobile -}}px;
          margin-bottom: {{ section.settings.space_bottom_mobile -}}px;
        }
      }
    </style>
    
    <section class="section section--flush">
      <div class="{{ section.settings.layout }}">
        <slide-show
          {% if section.settings.show_initial_transition %}
            reveal-on-scroll
          {% endif %}
          {% if section.settings.autoplay %}
            auto-play
          {% endif %}
          transition-type="{{ section.settings.transition_type | escape }}"
          class="slideshow slideshow--{{ section.settings.section_height }}"
        >
          <div class="slideshow__slide-list">
            {%- for block in section.blocks -%}
              {%- comment -%}
                ------------------------------------------------------------------------------------------------------------------
                IMAGE PART
                ------------------------------------------------------------------------------------------------------------------
              {%- endcomment -%}
    
              {%- assign image = block.settings.image -%}
              {%- assign split_image = block.settings.split_image -%}
              {%- assign mobile_image = block.settings.mobile_image -%}
              {%- assign slide_accessible_name = block.settings.title | default: block.settings.title_mobile | default: block.settings.title_two | default: block.settings.heading | default: block.settings.button_1_text | default: image.alt | default: mobile_image.alt | default: 'Slideshow' | strip_html | strip -%}
              {%- assign primary_image_alt = image.alt | default: slide_accessible_name -%}
              {%- assign split_image_alt = split_image.alt | default: slide_accessible_name -%}
              {%- assign mobile_image_alt = mobile_image.alt | default: slide_accessible_name -%}
    
              {%- assign image_aspect_ratio = image.aspect_ratio | default: 2.63 -%}
    
              {%- comment -%}
                If the image is split and that we want to preserve the ratio, we, Und so abgerundete Ecken wie das eben beschriebene Element oben , Der Abstand nach Oben und unten soll Desktop und Mobil getrennt einstellbar sein können!
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-responsive-image-section-{{ ai_gen_id }} {
    width: 100%;
  }

  .ai-responsive-image-wrapper-{{ ai_gen_id }} {
    width: 100%;
    position: relative;
    display: block;
    border-radius: {{ block.settings.border_radius }}px;
    overflow: hidden;
  }

  .ai-responsive-image-link-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    text-decoration: none;
  }

  .ai-responsive-image-desktop-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    height: auto;
  }

  .ai-responsive-image-mobile-{{ ai_gen_id }} {
    display: none;
    width: 100%;
    height: auto;
  }

  .ai-responsive-image-placeholder-{{ ai_gen_id }} {
    background-color: #f4f4f4;
    width: 100%;
    min-height: 400px;
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
  }

  .ai-responsive-image-placeholder-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
    max-width: 500px;
    max-height: 500px;
  }

  .ai-responsive-empty-state-{{ ai_gen_id }} {
    position: absolute;
    bottom: 20px;
    left: 50%;
    transform: translateX(-50%);
    padding: 12px 20px;
    font-size: 14px;
    color: #666;
    text-align: center;
    pointer-events: none;
  }

  @media screen and (min-width: 1000px) {
    .ai-responsive-image-container-{{ ai_gen_id }} {
      padding-top: {{ block.settings.padding_top_desktop }}px;
      padding-bottom: {{ block.settings.padding_bottom_desktop }}px;
    }
  }

  @media screen and (max-width: 999px) {
    .ai-responsive-image-desktop-{{ ai_gen_id }} {
      display: none;
    }

    .ai-responsive-image-mobile-{{ ai_gen_id }} {
      display: block;
    }

    .ai-responsive-image-container-{{ ai_gen_id }} {
      padding-top: {{ block.settings.padding_top_mobile }}px;
      padding-bottom: {{ block.settings.padding_bottom_mobile }}px;
    }
  }
{% endstyle %}

<div
  class="ai-responsive-image-section-{{ ai_gen_id }}"
  {{ block.shopify_attributes }}
>
  <div class="{{ block.settings.layout }}">
    <div class="ai-responsive-image-container-{{ ai_gen_id }}">
      <div class="ai-responsive-image-wrapper-{{ ai_gen_id }}">
        {% if block.settings.desktop_image or block.settings.mobile_image %}
          {% if block.settings.image_link != blank %}
            <a href="{{ block.settings.image_link }}" class="ai-responsive-image-link-{{ ai_gen_id }}">
          {% endif %}

          {% if block.settings.desktop_image %}
            <img
              src="{{ block.settings.desktop_image | image_url: width: block.settings.desktop_image.width }}"
              alt="{{ block.settings.desktop_image.alt | escape }}"
              loading="lazy"
              width="{{ block.settings.desktop_image.width }}"
              height="{{ block.settings.desktop_image.height }}"
              class="ai-responsive-image-desktop-{{ ai_gen_id }}"
            >
          {% endif %}

          {% if block.settings.mobile_image %}
            <img
              src="{{ block.settings.mobile_image | image_url: width: block.settings.mobile_image.width }}"
              alt="{{ block.settings.mobile_image.alt | escape }}"
              loading="lazy"
              width="{{ block.settings.mobile_image.width }}"
              height="{{ block.settings.mobile_image.height }}"
              class="ai-responsive-image-mobile-{{ ai_gen_id }}"
            >
          {% elsif block.settings.desktop_image %}
            <img
              src="{{ block.settings.desktop_image | image_url: width: block.settings.desktop_image.width }}"
              alt="{{ block.settings.desktop_image.alt | escape }}"
              loading="lazy"
              width="{{ block.settings.desktop_image.width }}"
              height="{{ block.settings.desktop_image.height }}"
              class="ai-responsive-image-mobile-{{ ai_gen_id }}"
            >
          {% endif %}

          {% if block.settings.image_link != blank %}
            </a>
          {% endif %}
        {% else %}
          <div class="ai-responsive-image-placeholder-{{ ai_gen_id }}">
            {{ 'image' | placeholder_svg_tag }}
            <div class="ai-responsive-empty-state-{{ ai_gen_id }}">
              Fügen Sie Desktop- und Mobile-Bilder hinzu
            </div>
          </div>
        {% endif %}
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Responsive image",
  "settings": [
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "layout",
      "label": "Layout",
      "options": [
        {
          "value": "container",
          "label": "Container"
        },
        {
          "value": "container--large",
          "label": "Container (groß)"
        },
        {
          "value": "container--flush",
          "label": "Volle Breite"
        }
      ],
      "default": "container"
    },
    {
      "type": "header",
      "content": "Bilder"
    },
    {
      "type": "image_picker",
      "id": "desktop_image",
      "label": "Desktop-Bild"
    },
    {
      "type": "image_picker",
      "id": "mobile_image",
      "label": "Mobile-Bild"
    },
    {
      "type": "paragraph",
      "content": "Wenn kein Mobile-Bild ausgewählt ist, wird das Desktop-Bild auch auf mobilen Geräten angezeigt."
    },
    {
      "type": "header",
      "content": "Link"
    },
    {
      "type": "url",
      "id": "image_link",
      "label": "Bild-Link"
    },
    {
      "type": "header",
      "content": "Stil"
    },
    {
      "type": "range",
      "id": "border_radius",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "label": "Ecken-Radius",
      "default": 0
    },
    {
      "type": "header",
      "content": "Abstände Desktop"
    },
    {
      "type": "range",
      "id": "padding_top_desktop",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "label": "Abstand oben",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_bottom_desktop",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "label": "Abstand unten",
      "default": 0
    },
    {
      "type": "header",
      "content": "Abstände Mobile"
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "label": "Abstand oben",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "label": "Abstand unten",
      "default": 0
    }
  ],
  "presets": [
    {
      "name": "Responsive image"
    }
  ]
}
{% endschema %}
