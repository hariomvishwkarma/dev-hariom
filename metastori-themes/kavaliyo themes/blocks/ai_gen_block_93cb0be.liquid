{% doc %}
  @prompt
    Ich benötige ein Objekt in dem ich Bilder platzieren kann. Jeweils ein Bild für Desktop und Mobil. Hierbei muss Ausrichtung und Abstand nach links, rechts, oben und unten einstellbar sein. Das Bild muss immer in den Originalproportionen angezeigt werden, Die Größe des Bildes muss immer einstellbar sein, Das Bild muss, wenn es kleiner eingestellt wird trotzdem zentriert bleiben. Aktuell rutscht es dann nach links, Das Modul ist immer noch linksbündig platziert! , Es funktioniert immer noch nicht. Ich muss den Abstand des Bildes nach links und rechts richtig einstellen können. Wenn der Abstand auf beiden Seite größer wird, muss das Bild folglich kleiner angezeigt werden!
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}
{% style %}
.ai-responsive-image-{{ ai_gen_id }}{display:block!important;width:{{ block.settings.desktop_width_percent }}%;max-width:100%;box-sizing:border-box;padding:{{ block.settings.margin_top }}px {{ block.settings.margin_right }}px {{ block.settings.margin_bottom }}px {{ block.settings.margin_left }}px}
.ai-responsive-image__inner-{{ ai_gen_id }}{display:flex!important;width:100%;justify-content:{{ block.settings.horizontal_alignment }}!important;align-items:{{ block.settings.vertical_alignment }};box-sizing:border-box}
.ai-responsive-image__inner-{{ ai_gen_id }} picture{display:block;width:{{ block.settings.desktop_image_width }}%;max-width:100%;flex:0 1 {{ block.settings.desktop_image_width }}%;margin:0}
.ai-responsive-image__media-{{ ai_gen_id }}{display:block;width:100%;max-width:100%;height:auto}
.ai-responsive-image__placeholder-{{ ai_gen_id }}{display:flex;width:{{ block.settings.desktop_image_width }}%;max-width:100%;min-height:180px;align-items:center;justify-content:center;background:{{ settings.secondary_background }};color:{{ settings.text_color }};box-sizing:border-box}
.ai-responsive-image__placeholder-{{ ai_gen_id }} svg{width:min(100%,360px);height:180px}
@media screen and (max-width:749px){.ai-responsive-image-{{ ai_gen_id }}{width:100%;padding:{{ block.settings.mobile_margin_top }}px {{ block.settings.mobile_margin_right }}px {{ block.settings.mobile_margin_bottom }}px {{ block.settings.mobile_margin_left }}px}.ai-responsive-image__inner-{{ ai_gen_id }}{justify-content:{{ block.settings.mobile_horizontal_alignment }}!important;align-items:{{ block.settings.mobile_vertical_alignment }}}.ai-responsive-image__inner-{{ ai_gen_id }} picture{width:{{ block.settings.mobile_image_width }}%;flex-basis:{{ block.settings.mobile_image_width }}%}.ai-responsive-image__placeholder-{{ ai_gen_id }}{width:{{ block.settings.mobile_image_width }}%}}
{% endstyle %}
<responsive-image-{{ ai_gen_id }} class="ai-responsive-image-{{ ai_gen_id }}" {{ block.shopify_attributes }}><div class="ai-responsive-image__inner-{{ ai_gen_id }}">{% if block.settings.desktop_image or block.settings.mobile_image %}<picture>{% if block.settings.mobile_image %}<source media="(max-width:749px)" srcset="{{ block.settings.mobile_image | image_url: width:2000 }}">{% endif %}{% assign image = block.settings.desktop_image | default:block.settings.mobile_image %}<img class="ai-responsive-image__media-{{ ai_gen_id }}" src="{{ image | image_url: width:2400 }}" alt="{{ image.alt | escape }}" width="{{ image.width }}" height="{{ image.height }}" loading="lazy"></picture>{% else %}<div class="ai-responsive-image__placeholder-{{ ai_gen_id }}">{{ 'image' | placeholder_svg_tag }}</div>{% endif %}</div></responsive-image-{{ ai_gen_id }}>
{% schema %}{"name":"Responsive image","settings":[{"type":"image_picker","id":"desktop_image","label":"Desktop image"},{"type":"image_picker","id":"mobile_image","label":"Mobile image"},{"type":"range","id":"desktop_width_percent","label":"Desktop block width","min":50,"max":100,"step":5,"unit":"%","default":100},{"type":"range","id":"desktop_image_width","label":"Desktop image size","min":10,"max":100,"step":5,"unit":"%","default":100},{"type":"range","id":"mobile_image_width","label":"Mobile image size","min":10,"max":100,"step":5,"unit":"%","default":100},{"type":"select","id":"horizontal_alignment","label":"Horizontal","options":[{"value":"flex-start","label":"Left"},{"value":"center","label":"Center"},{"value":"flex-end","label":"Right"}],"default":"center"},{"type":"select","id":"vertical_alignment","label":"Vertical","options":[{"value":"flex-start","label":"Top"},{"value":"center","label":"Center"},{"value":"flex-end","label":"Bottom"}],"default":"center"},{"type":"range","id":"margin_top","label":"Desktop top spacing","min":0,"max":100,"step":5,"unit":"px","default":0},{"type":"range","id":"margin_right","label":"Desktop right spacing","min":0,"max":100,"step":5,"unit":"px","default":0},{"type":"range","id":"margin_bottom","label":"Desktop bottom spacing","min":0,"max":100,"step":5,"unit":"px","default":0},{"type":"range","id":"margin_left","label":"Desktop left spacing","min":0,"max":100,"step":5,"unit":"px","default":0},{"type":"select","id":"mobile_horizontal_alignment","label":"Mobile horizontal","options":[{"value":"flex-start","label":"Left"},{"value":"center","label":"Center"},{"value":"flex-end","label":"Right"}],"default":"center"},{"type":"select","id":"mobile_vertical_alignment","label":"Mobile vertical","options":[{"value":"flex-start","label":"Top"},{"value":"center","label":"Center"},{"value":"flex-end","label":"Bottom"}],"default":"center"},{"type":"range","id":"mobile_margin_top","label":"Mobile top spacing","min":0,"max":100,"step":5,"unit":"px","default":0},{"type":"range","id":"mobile_margin_right","label":"Mobile right spacing","min":0,"max":100,"step":5,"unit":"px","default":0},{"type":"range","id":"mobile_margin_bottom","label":"Mobile bottom spacing","min":0,"max":100,"step":5,"unit":"px","default":0},{"type":"range","id":"mobile_margin_left","label":"Mobile left spacing","min":0,"max":100,"step":5,"unit":"px","default":0}],"presets":[{"name":"Responsive image"}],"tag":null,"class":"responsive-image-block"}{% endschema %}