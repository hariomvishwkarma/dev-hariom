{% doc %}
  @prompt
    ich brauche ein Textfeld, in dem ich optional eine Überschrift eintragen kann. Das Textfeld muss in den Abstanden nach links, rechts, oben und unten anpassbar sein. Auch die Schriftgröße muss anpassbar sein , Auch muss man einstellen, ob der Text zentriert, links oder rechtsbündig sein soll, Es muss möglich sein in einzelnen Wörtern links zu hinterlegen, Die Abstände oben, unten, links und rechts müssen sowohl mobil, als auch für den Desktop einstellbar sein
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-text-field-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    box-sizing: border-box;
    padding: {{ block.settings.desktop_padding_top }}px {{ block.settings.desktop_padding_right }}px {{ block.settings.desktop_padding_bottom }}px {{ block.settings.desktop_padding_left }}px;
    color: {{ block.settings.text_color }};
    text-align: {{ block.settings.text_alignment }};
  }
  .ai-text-field__heading-{{ ai_gen_id }} { margin: 0 0 {{ block.settings.heading_spacing }}px; color: {{ block.settings.heading_color }}; font-size: {{ block.settings.heading_size }}px; line-height: 1.2; font-weight: 600; }
  .ai-text-field__content-{{ ai_gen_id }} { margin: 0; color: {{ block.settings.text_color }}; font-size: {{ block.settings.text_size }}px; line-height: 1.6; overflow-wrap: anywhere; }
  .ai-text-field__content-{{ ai_gen_id }} p { margin: 0 0 1em; }
  .ai-text-field__content-{{ ai_gen_id }} p:last-child { margin-bottom: 0; }
  .ai-text-field__content-{{ ai_gen_id }} a { color: {{ block.settings.link_color }}; text-decoration: underline; text-underline-offset: 2px; }
  .ai-text-field__content-{{ ai_gen_id }} a:focus-visible { outline: 2px solid currentColor; outline-offset: 3px; }
  @media screen and (max-width: 749px) {
    .ai-text-field-{{ ai_gen_id }} { width: 100%; padding: {{ block.settings.mobile_padding_top }}px {{ block.settings.mobile_padding_right }}px {{ block.settings.mobile_padding_bottom }}px {{ block.settings.mobile_padding_left }}px; }
  }
{% endstyle %}

<div class="ai-text-field-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  {% if block.settings.heading != blank %}<h2 class="ai-text-field__heading-{{ ai_gen_id }}">{{ block.settings.heading | escape }}</h2>{% endif %}
  {% if block.settings.text != blank %}<div class="ai-text-field__content-{{ ai_gen_id }}">{{ block.settings.text }}</div>{% endif %}
</div>

{% schema %}
{
  "name": "Textfeld",
  "settings": [
    { "type": "header", "content": "Inhalt" },
    { "type": "text", "id": "heading", "label": "Überschrift" },
    { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Hier kannst du deinen Text eintragen und einzelne Wörter verlinken.</p>" },
    { "type": "select", "id": "text_alignment", "label": "Ausrichtung", "options": [{ "value": "left", "label": "Linksbündig" }, { "value": "center", "label": "Zentriert" }, { "value": "right", "label": "Rechtsbündig" }], "default": "left" },
    { "type": "header", "content": "Schrift" },
    { "type": "range", "id": "heading_size", "label": "Überschriftgröße", "min": 14, "max": 48, "step": 1, "unit": "px", "default": 24 },
    { "type": "range", "id": "text_size", "label": "Textgröße", "min": 12, "max": 32, "step": 1, "unit": "px", "default": 16 },
    { "type": "range", "id": "heading_spacing", "label": "Abstand unter Überschrift", "min": 0, "max": 40, "step": 2, "unit": "px", "default": 12 },
    { "type": "color", "id": "heading_color", "label": "Überschrift", "default": "#1c1b1b" },
    { "type": "color", "id": "text_color", "label": "Text", "default": "#677279" },
    { "type": "color", "id": "link_color", "label": "Links", "default": "#1e316a" },
    { "type": "header", "content": "Desktop-Abstände" },
    { "type": "range", "id": "desktop_padding_top", "label": "Oben", "min": 0, "max": 100, "step": 5, "unit": "px", "default": 20 },
    { "type": "range", "id": "desktop_padding_right", "label": "Rechts", "min": 0, "max": 100, "step": 5, "unit": "px", "default": 20 },
    { "type": "range", "id": "desktop_padding_bottom", "label": "Unten", "min": 0, "max": 100, "step": 5, "unit": "px", "default": 20 },
    { "type": "range", "id": "desktop_padding_left", "label": "Links", "min": 0, "max": 100, "step": 5, "unit": "px", "default": 20 },
    { "type": "header", "content": "Mobile-Abstände" },
    { "type": "range", "id": "mobile_padding_top", "label": "Oben", "min": 0, "max": 100, "step": 5, "unit": "px", "default": 15 },
    { "type": "range", "id": "mobile_padding_right", "label": "Rechts", "min": 0, "max": 100, "step": 5, "unit": "px", "default": 15 },
    { "type": "range", "id": "mobile_padding_bottom", "label": "Unten", "min": 0, "max": 100, "step": 5, "unit": "px", "default": 15 },
    { "type": "range", "id": "mobile_padding_left", "label": "Links", "min": 0, "max": 100, "step": 5, "unit": "px", "default": 15 },
    { "type": "range", "id": "desktop_width_percent", "label": "Desktop-Breite", "min": 50, "max": 100, "step": 5, "unit": "%", "default": 100 }
  ],
  "presets": [{ "name": "Textfeld" }],
  "tag": null,
  "class": "textfeld-block"
}
{% endschema %}