{% doc %}
  @prompt
    ich brauche ein CTA für ein Kontaktformular von Klaviyo über dass sich die Kunden für zukünftige News per Mail von der Marke eintragen können, Es muss der Abstand des Moduls nach oben, unten, links und rechts einstellbar sein. Zudem muss die Ausrichtung ebenfalls wählbar sein. Die einzelnen Dinge wie Überschrift, Text und Butten müssen auch in der Größe einstellbar sein und untereinander aufgeführt werden. Den Abstand von Button zu Text muss ebenfalls einstellbar sein
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-klaviyo-cta-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    margin-top: {{ block.settings.margin_top }}px;
    margin-right: {{ block.settings.margin_right }}px;
    margin-bottom: {{ block.settings.margin_bottom }}px;
    margin-left: {{ block.settings.margin_left }}px;
  }

  .ai-klaviyo-cta-{{ ai_gen_id }}__inner {
    display: flex;
    flex-direction: column;
    align-items: {{ block.settings.alignment }};
    gap: {{ block.settings.button_spacing }}px;
    padding: {{ block.settings.padding }}px;
    background: {{ block.settings.background_color }};
    color: {{ block.settings.text_color }};
    border-radius: {{ block.settings.border_radius }}px;
    text-align: {{ block.settings.alignment }};
  }

  .ai-klaviyo-cta-{{ ai_gen_id }}__content {
    width: 100%;
  }

  .ai-klaviyo-cta-{{ ai_gen_id }}__heading {
    margin: 0 0 8px;
    color: {{ block.settings.heading_color }};
    font-size: {{ block.settings.heading_size }}px;
    line-height: 1.2;
  }

  .ai-klaviyo-cta-{{ ai_gen_id }}__text {
    margin: 0;
    color: {{ block.settings.text_color }};
    font-size: {{ block.settings.text_size }}px;
    line-height: 1.5;
  }

  .ai-klaviyo-cta-{{ ai_gen_id }}__button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 48px;
    padding: 12px 24px;
    background: {{ block.settings.button_color }};
    color: {{ block.settings.button_text_color }};
    border: 1px solid {{ block.settings.button_color }};
    border-radius: {{ block.settings.button_border_radius }}px;
    font-size: {{ block.settings.button_size }}px;
    font-weight: 600;
    line-height: 1.2;
    text-decoration: none;
    text-align: center;
  }

  .ai-klaviyo-cta-{{ ai_gen_id }}__button:hover {
    opacity: 0.85;
  }

  .ai-klaviyo-cta-{{ ai_gen_id }}__button:focus-visible {
    outline: 2px solid {{ block.settings.button_text_color }};
    outline-offset: 3px;
  }

  @media screen and (max-width: 749px) {
    .ai-klaviyo-cta-{{ ai_gen_id }} {
      margin-right: 0;
      margin-left: 0;
      width: 100%;
    }

    .ai-klaviyo-cta-{{ ai_gen_id }}__button {
      max-width: 100%;
    }
  }
{% endstyle %}

<div class="ai-klaviyo-cta-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-klaviyo-cta-{{ ai_gen_id }}__inner">
    <div class="ai-klaviyo-cta-{{ ai_gen_id }}__content">
      {% if block.settings.heading != blank %}
        <h2 class="ai-klaviyo-cta-{{ ai_gen_id }}__heading">{{ block.settings.heading | escape }}</h2>
      {% endif %}
      {% if block.settings.text != blank %}
        <p class="ai-klaviyo-cta-{{ ai_gen_id }}__text">{{ block.settings.text | escape }}</p>
      {% endif %}
    </div>
    {% if block.settings.button_link != blank %}
      <a class="ai-klaviyo-cta-{{ ai_gen_id }}__button" href="{{ block.settings.button_link }}">
        {{ block.settings.button_label | escape }}
      </a>
    {% endif %}
  </div>
</div>

{% schema %}
{
  "name": "Klaviyo Newsletter CTA",
  "settings": [
    {"type":"header","content":"Inhalt"},
    {"type":"text","id":"heading","label":"Überschrift","default":"Bleib über diese Marke informiert"},
    {"type":"textarea","id":"text","label":"Beschreibung","default":"Melde dich für den Newsletter an und erfahre zuerst von neuen Kollektionen und besonderen Neuigkeiten."},
    {"type":"text","id":"button_label","label":"Buttontext","default":"Jetzt anmelden"},
    {"type":"url","id":"button_link","label":"Klaviyo-Formular-Link"},
    {"type":"header","content":"Abstände und Ausrichtung"},
    {"type":"range","id":"desktop_width_percent","label":"Desktop-Breite","min":50,"max":100,"step":5,"unit":"%","default":100},
    {"type":"select","id":"alignment","label":"Ausrichtung","options":[{"value":"left","label":"Links"},{"value":"center","label":"Zentriert"},{"value":"right","label":"Rechts"}],"default":"center"},
    {"type":"range","id":"margin_top","label":"Abstand oben","min":0,"max":80,"step":4,"unit":"px","default":0},
    {"type":"range","id":"margin_right","label":"Abstand rechts","min":0,"max":80,"step":4,"unit":"px","default":0},
    {"type":"range","id":"margin_bottom","label":"Abstand unten","min":0,"max":80,"step":4,"unit":"px","default":0},
    {"type":"range","id":"margin_left","label":"Abstand links","min":0,"max":80,"step":4,"unit":"px","default":0},
    {"type":"range","id":"padding","label":"Innenabstand","min":16,"max":64,"step":4,"unit":"px","default":32},
    {"type":"range","id":"button_spacing","label":"Abstand zum Button","min":0,"max":60,"step":4,"unit":"px","default":20},
    {"type":"header","content":"Größen"},
    {"type":"range","id":"heading_size","label":"Überschriftgröße","min":18,"max":40,"step":2,"unit":"px","default":26},
    {"type":"range","id":"text_size","label":"Textgröße","min":12,"max":20,"step":1,"unit":"px","default":15},
    {"type":"range","id":"button_size","label":"Buttongröße","min":12,"max":24,"step":1,"unit":"px","default":15},
    {"type":"range","id":"border_radius","label":"Eckenradius","min":0,"max":30,"step":2,"unit":"px","default":0},
    {"type":"range","id":"button_border_radius","label":"Button-Eckenradius","min":0,"max":30,"step":2,"unit":"px","default":0},
    {"type":"header","content":"Farben"},
    {"type":"color","id":"background_color","label":"Hintergrund","default":"#f7f8fd"},
    {"type":"color","id":"heading_color","label":"Überschrift","default":"#1c1b1b"},
    {"type":"color","id":"text_color","label":"Text","default":"#677279"},
    {"type":"color","id":"button_color","label":"Button","default":"#1e2d7d"},
    {"type":"color","id":"button_text_color","label":"Buttontext","default":"#ffffff"}
  ],
  "presets":[{"name":"Klaviyo Newsletter CTA"}],
  "tag":null,
  "class":"klaviyo-newsletter-cta"
}
{% endschema %}