{% doc %}
  @prompt
    Ich brauche ein Modul, bei dem ich die Möglichkeit habe, Bilder in den Hintergrund, als auch Bilder alleine zu setzen, als auch Text alleine setzen zu können. Auch hier muss ich sowohl in der Desktop, als auch in der mobilen Version unterschiedliche Bilder wählen können, alle Größen und Abstände müssen zu jeder Seite sowohl Desktop, als auch mobil einstellbar sein, Ich kann den Text bisher nicht sehen, ich muss bei dem Text auswählen können, ob er linksbündig, zentriert, oder rechtsbündig sein soll, die Breite mobil muss noch einstellbar sein. Das Bild muss immer im Original dargestellt werden, Schriftgröße muss noch einstellbar sein und stil, Schriftstil muss in beiden Hurme Versionen möglich sein
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-flexible-content-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    position: relative;
  }

  .ai-flexible-content-wrapper-{{ ai_gen_id }} {
    width: {{ block.settings.desktop_width_percent }}%;
    margin: 0 auto;
    position: relative;
  }

  @media screen and (max-width: 749px) {
    .ai-flexible-content-wrapper-{{ ai_gen_id }} {
      width: {{ block.settings.mobile_width_percent }}%;
    }
  }

  .ai-flexible-content-inner-{{ ai_gen_id }} {
    position: relative;
    padding-top: {{ block.settings.padding_top_desktop }}px;
    padding-right: {{ block.settings.padding_right_desktop }}px;
    padding-bottom: {{ block.settings.padding_bottom_desktop }}px;
    padding-left: {{ block.settings.padding_left_desktop }}px;
  }

  @media screen and (max-width: 749px) {
    .ai-flexible-content-inner-{{ ai_gen_id }} {
      padding-top: {{ block.settings.padding_top_mobile }}px;
      padding-right: {{ block.settings.padding_right_mobile }}px;
      padding-bottom: {{ block.settings.padding_bottom_mobile }}px;
      padding-left: {{ block.settings.padding_left_mobile }}px;
    }
  }

  .ai-flexible-content-background-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    z-index: 1;
  }

  .ai-flexible-content-background-{{ ai_gen_id }} img {
    width: 100%;
    height: 100%;
    object-fit: {{ block.settings.background_image_fit }};
    display: block;
  }

  .ai-flexible-content-foreground-{{ ai_gen_id }} {
    position: relative;
    z-index: 2;
  }

  .ai-flexible-content-image-{{ ai_gen_id }} {
    width: 100%;
    height: auto;
    display: block;
  }

  .ai-flexible-content-image-{{ ai_gen_id }} img {
    width: 100%;
    height: auto;
    display: block;
  }

  .ai-flexible-content-text-{{ ai_gen_id }} {
    color: {{ block.settings.text_color }};
    text-align: {{ block.settings.text_align }};
    font-size: {{ block.settings.text_font_size_desktop }}px;
    font-weight: {{ block.settings.text_font_weight }};
    font-style: {{ block.settings.text_font_style }};
    {% if block.settings.use_custom_font %}
      font-family: {{ block.settings.text_font_family }};
    {% endif %}
  }

  @media screen and (max-width: 749px) {
    .ai-flexible-content-text-{{ ai_gen_id }} {
      font-size: {{ block.settings.text_font_size_mobile }}px;
    }
  }

  .ai-flexible-content-text-{{ ai_gen_id }} h1,
  .ai-flexible-content-text-{{ ai_gen_id }} h2,
  .ai-flexible-content-text-{{ ai_gen_id }} h3,
  .ai-flexible-content-text-{{ ai_gen_id }} h4,
  .ai-flexible-content-text-{{ ai_gen_id }} h5,
  .ai-flexible-content-text-{{ ai_gen_id }} h6 {
    color: {{ block.settings.text_color }};
  }

  .ai-flexible-content-text-{{ ai_gen_id }} p {
    color: {{ block.settings.text_color }};
  }

  .ai-flexible-content-background-placeholder-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    z-index: 1;
  }

  .ai-flexible-content-background-placeholder-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ai-flexible-content-image-placeholder-{{ ai_gen_id }} {
    width: 100%;
    background-color: #f4f4f4;
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
  }

  .ai-flexible-content-image-placeholder-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
    max-width: 500px;
    max-height: 500px;
  }

  .ai-flexible-content-empty-state-{{ ai_gen_id }} {
    position: absolute;
    bottom: 20px;
    left: 50%;
    transform: translateX(-50%);
    padding: 12px 20px;
    font-size: 14px;
    color: #666;
    text-align: center;
    pointer-events: none;
  }
{% endstyle %}

<ai-flexible-content-{{ ai_gen_id }}
  class="ai-flexible-content-{{ ai_gen_id }}"
  {{ block.shopify_attributes }}
>
  <div class="ai-flexible-content-wrapper-{{ ai_gen_id }}">
    <div class="ai-flexible-content-inner-{{ ai_gen_id }}">
      {% if block.settings.background_image_desktop != blank or block.settings.background_image_mobile != blank %}
        <div class="ai-flexible-content-background-{{ ai_gen_id }}">
          {% if block.settings.background_image_desktop != blank %}
            <img
              src="{{ block.settings.background_image_desktop | image_url }}"
              alt="{{ block.settings.background_image_desktop.alt | escape }}"
              loading="lazy"
              class="ai-flexible-content-background-desktop-{{ ai_gen_id }}"
              style="display: block;"
            >
          {% endif %}
          {% if block.settings.background_image_mobile != blank %}
            <img
              src="{{ block.settings.background_image_mobile | image_url }}"
              alt="{{ block.settings.background_image_mobile.alt | escape }}"
              loading="lazy"
              class="ai-flexible-content-background-mobile-{{ ai_gen_id }}"
              style="display: none;"
            >
          {% endif %}
        </div>
      {% endif %}

      <div class="ai-flexible-content-foreground-{{ ai_gen_id }}">
        {% if block.settings.show_foreground_image %}
          <div class="ai-flexible-content-image-{{ ai_gen_id }}">
            {% if block.settings.foreground_image_desktop != blank %}
              <img
                src="{{ block.settings.foreground_image_desktop | image_url }}"
                alt="{{ block.settings.foreground_image_desktop.alt | escape }}"
                loading="lazy"
                class="ai-flexible-content-foreground-desktop-{{ ai_gen_id }}"
                style="display: block;"
              >
            {% else %}
              <div class="ai-flexible-content-image-placeholder-{{ ai_gen_id }}">
                {{ 'image' | placeholder_svg_tag }}
                <div class="ai-flexible-content-empty-state-{{ ai_gen_id }}">
                  Bild für Desktop hinzufügen
                </div>
              </div>
            {% endif %}
            {% if block.settings.foreground_image_mobile != blank %}
              <img
                src="{{ block.settings.foreground_image_mobile | image_url }}"
                alt="{{ block.settings.foreground_image_mobile.alt | escape }}"
                loading="lazy"
                class="ai-flexible-content-foreground-mobile-{{ ai_gen_id }}"
                style="display: none;"
              >
            {% endif %}
          </div>
        {% endif %}

        {% if block.settings.show_text and block.settings.text_content != blank %}
          <div class="ai-flexible-content-text-{{ ai_gen_id }}">
            {{ block.settings.text_content }}
          </div>
        {% endif %}
      </div>
    </div>
  </div>
</ai-flexible-content-{{ ai_gen_id }}>

<style>
  @media screen and (max-width: 749px) {
    .ai-flexible-content-background-desktop-{{ ai_gen_id }},
    .ai-flexible-content-foreground-desktop-{{ ai_gen_id }} {
      display: none !important;
    }
    .ai-flexible-content-background-mobile-{{ ai_gen_id }},
    .ai-flexible-content-foreground-mobile-{{ ai_gen_id }} {
      display: block !important;
    }
  }

  @media screen and (min-width: 750px) {
    .ai-flexible-content-background-mobile-{{ ai_gen_id }},
    .ai-flexible-content-foreground-mobile-{{ ai_gen_id }} {
      display: none !important;
    }
    .ai-flexible-content-background-desktop-{{ ai_gen_id }},
    .ai-flexible-content-foreground-desktop-{{ ai_gen_id }} {
      display: block !important;
    }
  }
</style>

{% schema %}
{
  "name": "Flexibles Content Modul",
  "settings": [
    {
      "type": "header",
      "content": "Breite"
    },
    {
      "type": "range",
      "id": "desktop_width_percent",
      "label": "Desktop Breite",
      "min": 50,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 100
    },
    {
      "type": "range",
      "id": "mobile_width_percent",
      "label": "Mobile Breite",
      "min": 50,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 100
    },
    {
      "type": "header",
      "content": "Abstände Desktop"
    },
    {
      "type": "range",
      "id": "padding_top_desktop",
      "label": "Abstand oben",
      "min": 0,
      "max": 200,
      "step": 5,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_right_desktop",
      "label": "Abstand rechts",
      "min": 0,
      "max": 200,
      "step": 5,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_bottom_desktop",
      "label": "Abstand unten",
      "min": 0,
      "max": 200,
      "step": 5,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_left_desktop",
      "label": "Abstand links",
      "min": 0,
      "max": 200,
      "step": 5,
      "unit": "px",
      "default": 0
    },
    {
      "type": "header",
      "content": "Abstände Mobil"
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "label": "Abstand oben",
      "min": 0,
      "max": 200,
      "step": 5,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_right_mobile",
      "label": "Abstand rechts",
      "min": 0,
      "max": 200,
      "step": 5,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "label": "Abstand unten",
      "min": 0,
      "max": 200,
      "step": 5,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_left_mobile",
      "label": "Abstand links",
      "min": 0,
      "max": 200,
      "step": 5,
      "unit": "px",
      "default": 0
    },
    {
      "type": "header",
      "content": "Hintergrundbild"
    },
    {
      "type": "image_picker",
      "id": "background_image_desktop",
      "label": "Hintergrundbild Desktop"
    },
    {
      "type": "image_picker",
      "id": "background_image_mobile",
      "label": "Hintergrundbild Mobil"
    },
    {
      "type": "select",
      "id": "background_image_fit",
      "label": "Hintergrundbild Anpassung",
      "options": [
        {
          "value": "cover",
          "label": "Abdecken"
        },
        {
          "value": "contain",
          "label": "Einpassen"
        },
        {
          "value": "fill",
          "label": "Ausfüllen"
        },
        {
          "value": "none",
          "label": "Original"
        }
      ],
      "default": "none"
    },
    {
      "type": "header",
      "content": "Vordergrundbild"
    },
    {
      "type": "checkbox",
      "id": "show_foreground_image",
      "label": "Vordergrundbild anzeigen",
      "default": true
    },
    {
      "type": "image_picker",
      "id": "foreground_image_desktop",
      "label": "Vordergrundbild Desktop"
    },
    {
      "type": "image_picker",
      "id": "foreground_image_mobile",
      "label": "Vordergrundbild Mobil"
    },
    {
      "type": "header",
      "content": "Text"
    },
    {
      "type": "checkbox",
      "id": "show_text",
      "label": "Text anzeigen",
      "default": true
    },
    {
      "type": "richtext",
      "id": "text_content",
      "label": "Text Inhalt"
    },
    {
      "type": "select",
      "id": "text_align",
      "label": "Textausrichtung",
      "options": [
        {
          "value": "left",
          "label": "Linksbündig"
        },
        {
          "value": "center",
          "label": "Zentriert"
        },
        {
          "value": "right",
          "label": "Rechtsbündig"
        }
      ],
      "default": "left"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Textfarbe",
      "default": "#000000"
    },
    {
      "type": "range",
      "id": "text_font_size_desktop",
      "label": "Schriftgröße Desktop",
      "min": 12,
      "max": 100,
      "step": 2,
      "unit": "px",
      "default": 16
    },
    {
      "type": "range",
      "id": "text_font_size_mobile",
      "label": "Schriftgröße Mobil",
      "min": 12,
      "max": 100,
      "step": 2,
      "unit": "px",
      "default": 14
    },
    {
      "type": "header",
      "content": "Schriftstil"
    },
    {
      "type": "checkbox",
      "id": "use_custom_font",
      "label": "Hurme Geometric Sans verwenden",
      "default": false
    },
    {
      "type": "select",
      "id": "text_font_family",
      "label": "Schriftart",
      "options": [
        {
          "value": "Hurme Geometric Sans 1",
          "label": "Hurme Geometric Sans 1"
        },
        {
          "value": "Hurme Geometric Sans 2",
          "label": "Hurme Geometric Sans 2"
        }
      ],
      "default": "Hurme Geometric Sans 1"
    },
    {
      "type": "select",
      "id": "text_font_weight",
      "label": "Schriftstärke",
      "options": [
        {
          "value": "100",
          "label": "100 - Thin"
        },
        {
          "value": "200",
          "label": "200 - Extra Light"
        },
        {
          "value": "300",
          "label": "300 - Light"
        },
        {
          "value": "400",
          "label": "400 - Normal"
        },
        {
          "value": "500",
          "label": "500 - Medium"
        },
        {
          "value": "600",
          "label": "600 - Semi Bold"
        },
        {
          "value": "700",
          "label": "700 - Bold"
        },
        {
          "value": "800",
          "label": "800 - Extra Bold"
        },
        {
          "value": "900",
          "label": "900 - Black"
        }
      ],
      "default": "400"
    },
    {
      "type": "select",
      "id": "text_font_style",
      "label": "Schriftstil",
      "options": [
        {
          "value": "normal",
          "label": "Normal"
        },
        {
          "value": "italic",
          "label": "Kursiv"
        }
      ],
      "default": "normal"
    }
  ],
  "presets": [
    {
      "name": "Flexibles Content Modul"
    }
  ]
}
{% endschema %}
