{%- comment -%}
  ------------------------------------------------------------------------------------------------------------------------
  NOTE TO DEVELOPERS: welcome to Focal theme! We hope that you will enjoy editing this theme as much as we did for
    developing it. We have put a lot of work to make this theme as developer friendly as possible by offering you
    hooks to integrate into critical parts of the theme. You will find the complete technical documentation (including
    all events, dependencies...) in the "custom.js" file, located in the Assets folder.
  ------------------------------------------------------------------------------------------------------------------------
{%- endcomment -%}

<!doctype html>

{%- assign direction = 'ltr' -%}
{%- case request.locale.iso_code -%}
  {%- when 'ar', 'arc', 'dv', 'fa', 'ha', 'he', 'kwh', 'ks', 'ku', 'ps', 'ur', 'yi' -%}
    {%- assign direction = 'rtl' -%}
{%- endcase -%}

<html class="no-js" lang="{{ request.locale.iso_code }}" dir="{{ direction }}">
  <head>
    <!--  START | MEASRMENT SHOPIFY ECOMMERCE TRACKING -->
    {% render 'msr-tracking' %}
    <!--  END | MEASRMENT SHOPIFY ECOMMERCE TRACKING -->   
    <meta charset="utf-8">
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1.0, minimum-scale=1.0"
    >
    <meta name="theme-color" content="{{ settings.header_background }}">

    <title>
      {%- if request.page_type == 'product' and product.selected_or_first_available_variant.metafields.Meta_Titel.Meta_Titel != blank -%}
        {{- product.selected_or_first_available_variant.metafields.Meta_Titel.Meta_Titel -}}
      {%- elsif page_title == blank -%}
        {{- shop.name -}}
      {%- else -%}
        {{- page_title -}}
        {%- if current_page != 1 %} &ndash; {{ 'general.meta.page' | t: page: current_page }}{% endif -%}
      {%- endif %}
    </title>

    {%- if request.page_type == 'product' and product.selected_or_first_available_variant.metafields.Meta_Beschreibung.Meta_Beschreibung != blank -%}
      <meta name="description" content="{{ product.selected_or_first_available_variant.metafields.Meta_Beschreibung.Meta_Beschreibung | escape }}">
    {%- elsif page_description -%}
      <meta name="description" content="{{ page_description | escape }}">
    {%- endif -%}

    {%- if page.handle contains "parcellab" or page.handle contains "retoure-anmelden" -%}
      <meta name="robots" content="noindex" />
    {%- endif -%}

    <link rel="canonical" href="{{ canonical_url }}">

    <script src="https://cdn.ablyft.com/s/70805535.js" defer></script>

    <script src="{{ 'cart-redirect.js' | asset_url }}" defer></script>

    {%- if settings.favicon -%}
      <link rel="shortcut icon" href="{{ settings.favicon | image_url: width: 96 }}" type="image/png">
    {%- endif -%}

    {%- comment -%}Few prefech to increase performance on commonly used third-parties{%- endcomment -%}
    <link rel="preconnect" href="https://cdn.shopify.com">
    <link rel="dns-prefetch" href="https://productreviews.shopifycdn.com">
    <link rel="dns-prefetch" href="https://www.google-analytics.com">

    {% comment %}
      {%- unless settings.heading_font.system? and settings.text_font.system? -%}
        <link rel="preconnect" href="https://fonts.shopifycdn.com" crossorigin>
      {%- endunless -%}
    {% endcomment %}

    {% comment %} {%- unless settings.header_custom_font
      or settings.body_custom_font
      or settings.type_header_font.system?
      and settings.type_body_font.system?
    -%}
      <link rel="preconnect" href="https://fonts.shopifycdn.com" crossorigin>
    {%- endunless -%} {% endcomment %}

     <style>
      #PBarNextFrameWrapper, #PBarNextFrame {
          display: none !important;
      }
    </style>

    {% if settings.header_custom_font or settings.body_custom_font %}
      <style>
        @font-face {
            font-family: 'Hurme Geometric Sans 1';
            src: local('HurmeGeometricSans1 Light'),
            local('HurmeGeometricSans1-Light'),
            url("{{ 'HurmeGeometricSans1-Light.woff2' | asset_url }}") format('woff2'),
            url("{{ 'HurmeGeometricSans1-Light.woff' | asset_url }}") format('woff');
            font-weight: 300;
            font-style: normal;
            font-display: swap;
        }
        
        @font-face {
            font-family: 'Hurme Geometric Sans 1';
            src: local('HurmeGeometricSans1 Regular'),
            local('HurmeGeometricSans1-Regular'),
            url("{{ 'HurmeGeometricSans1-Regular.woff2' | asset_url }}") format('woff2'),
            url("{{ 'HurmeGeometricSans1-Regular.woff' | asset_url }}") format('woff');
            font-weight: normal;
            font-style: normal;
            font-display: swap;
        }
        
        @font-face {
            font-family: 'Hurme Geometric Sans 1';
            src: local('HurmeGeometricSans1 SemiBold'),
            local('HurmeGeometricSans1-SemiBold'),
            url("{{ 'HurmeGeometricSans1-SemiBold.woff2' | asset_url }}") format('woff2'),
            url("{{ 'HurmeGeometricSans1-SemiBold.woff' | asset_url }}") format('woff');
            font-weight: 600;
            font-style: normal;
            font-display: swap;
        }
      </style>
    {% endif %}

    {%- comment -%}Preload important resources{%- endcomment -%}
    <link rel="preload" as="style" href="{{ 'theme.css' | asset_url }}">
    <link rel="preload" as="style" href="{{ 'custom-settings.css' | asset_url }}">
    <link rel="preload" as="style" href="{{ 'custom.css' | asset_url }}">

    {%- comment -%}
      IMPLEMENTATION NOTE: for improving performance, Focal tries to preload images on known pages (such as blog page,
      product or collection pages). In order to keep a main JS file size minimal, the theme also lazyloads non-essential
      libraries (such as PhotoSwipe or Flickity) and only loads them on demand.
    {%- endcomment -%}
    {%- if request.page_type == 'product' -%}
      <link rel="preload" as="fetch" href="{{ product.url }}.js" crossorigin>

    {%- endif -%}

    {% render 'social-meta-tags' %}
    {% render 'microdata-schema' %}
    {% render 'css-variables', direction: direction %}
    {% render 'js-variables', direction: direction %}

    <link rel="stylesheet" href="{{ 'theme.css' | asset_url }}">
    <link rel="stylesheet" href="{{ 'custom-settings.css' | asset_url }}">

    <script src="{{ 'vendor.js' | asset_url }}" defer></script>
    {% render 'kavalio-care-config' %}
    <script src="{{ 'kavalio-care.js' | asset_url }}" defer></script>

    <script>
      var reservation_label_text_timer_time = parseInt({{settings.reservation_label_text_timer_time}});
      var enable_cart_upsell = {{ settings.enable_cart_upsell | json }};
      var cart_upsell_display = {{settings.cart_upsell_display | json}};

      const free_item_threshold = Number("{{ settings.cart_free_item_threshold | times: 100 }}");
      {% for gift_product in settings.free_products %}
         {% assign vid = gift_product.selected_or_first_available_variant.id | json %}
         {% assign product_products_vid = product_products_vid | append: vid | append: ',' %}
       {% endfor %}
       {% assign product_products_vid = product_products_vid | split: ',' %}
       const free_product_ids = {{ product_products_vid | json }};

      const free_item_threshold2 = Number("{{ settings.cart_free_item_threshold2 | times: 100 }}");
       {% for gift_product in settings.free_products2 %}
         {% assign vid2 = gift_product.selected_or_first_available_variant.id | json %}
         {% assign product_products_vid2 = product_products_vid2 | append: vid2 | append: ',' %}
       {% endfor %}
       {% assign product_products_vid2 = product_products_vid2 | split: ',' %}
       const free_product_ids2 = {{ product_products_vid2 | json }};

       const free_item_threshold3 = Number("{{ settings.cart_free_item_threshold3 | times: 100 }}");
       {% for gift_product in settings.free_products3 %}
         {% assign vid3 = gift_product.selected_or_first_available_variant.id | json %}
         {% assign product_products_vid3 = product_products_vid3 | append: vid3 | append: ',' %}
       {% endfor %}
       {% assign product_products_vid3 = product_products_vid3 | split: ',' %}
       const free_product_ids3 = {{ product_products_vid3 | json }};

       const free_item_threshold4 = Number("{{ settings.cart_free_item_threshold4 | times: 100 }}");
       {% for gift_product in settings.free_products4 %}
         {% assign vid4 = gift_product.selected_or_first_available_variant.id | json %}
         {% assign product_products_vid4 = product_products_vid4 | append: vid4 | append: ',' %}
       {% endfor %}
       {% assign product_products_vid4 = product_products_vid4 | split: ',' %}
       const free_product_ids4 = {{ product_products_vid4 | json }};

       const free_item_threshold5 = Number("{{ settings.cart_free_item_threshold5 | times: 100 }}");
       {% for gift_product in settings.free_products5 %}
         {% assign vid5 = gift_product.selected_or_first_available_variant.id | json %}
         {% assign product_products_vid5 = product_products_vid5 | append: vid5 | append: ',' %}
       {% endfor %}
       {% assign product_products_vid5 = product_products_vid5 | split: ',' %}
       const free_product_ids5 = {{ product_products_vid5 | json }};

        const enable_free_product = {{ settings.enable_free_item }};
        const free_gift_auto_add = {{ settings.free_gift_auto_add}};
        const enable_free_product2 = {{ settings.enable_free_item2 }};
        const free_gift_auto_add2 = {{ settings.free_gift_auto_add2}};
        const enable_free_product3 = {{ settings.enable_free_item3 }};
        const free_gift_auto_add3 = {{ settings.free_gift_auto_add3}};
        const enable_free_product4 = {{ settings.enable_free_item4 }};
        const free_gift_auto_add4 = {{ settings.free_gift_auto_add4}};
        const enable_free_product5 = {{ settings.enable_free_item5 }};
        const free_gift_auto_add5 = {{ settings.free_gift_auto_add5}};
    </script>

    <script src="{{ 'jquery-3.7.1.min.js' | asset_url }}" defer></script>
    <link rel="stylesheet" href="{{ 'slick.css' | asset_url }}" media="print" onload="this.media='all'">
    <noscript><link rel="stylesheet" href="{{ 'slick.css' | asset_url }}"></noscript>
    <script src="{{ 'slick.min.js' | asset_url }}" defer></script>
    <script src="{{ 'swiper-bundle.min.js' | asset_url }}" defer></script>
    <script src="{{ 'theme.js' | asset_url }}" defer></script>
    <link rel="stylesheet" href="{{ 'swiper-bundle.min.css' | asset_url }}" media="print" onload="this.media='all'">
    <noscript><link rel="stylesheet" href="{{ 'swiper-bundle.min.css' | asset_url }}"></noscript>
    <script>
      /* cart reservation timer */
      var reservation_label_text_timer_time = parseInt({{settings.reservation_label_text_timer_time}}); 
      /* cart reservation timer */
    </script>
    <script src="{{ 'custom.js' | asset_url }}" defer></script>
    <link rel="stylesheet" href="{{ 'custom.css' | asset_url }}" media="print" onload="this.media='all'">
    <noscript><link rel="stylesheet" href="{{ 'custom.css' | asset_url }}"></noscript>
    {%- assign load_staw_styles = false -%}
    {%- assign load_parcellab_styles = false -%}
    {%- assign load_paqato_styles = false -%}

    {%- if template.name == 'page' -%}
      {%- assign load_staw_styles = true -%}
    {%- endif -%}

    {%- if page.handle contains 'parcellab' or page.handle contains 'retoure-anmelden' -%}
      {%- assign load_parcellab_styles = true -%}
      {%- assign load_staw_styles = true -%}
    {%- endif -%}

    {%- if page.handle contains 'paqato' or page.handle contains 'sendung' or page.handle contains 'tracking' -%}
      {%- assign load_paqato_styles = true -%}
      {%- assign load_staw_styles = true -%}
    {%- endif -%}

    {%- if load_staw_styles -%}
      <link rel="stylesheet" href="{{ 'staw-variables.css' | asset_url }}" media="print" onload="this.media='all'">
      <noscript><link rel="stylesheet" href="{{ 'staw-variables.css' | asset_url }}"></noscript>
      <link rel="stylesheet" href="{{ 'staw.css' | asset_url }}" media="print" onload="this.media='all'">
      <noscript><link rel="stylesheet" href="{{ 'staw.css' | asset_url }}"></noscript>
    {%- endif -%}

    {%- if load_parcellab_styles -%}
      <link rel="stylesheet" href="{{ 'staw-parcellab.css' | asset_url }}" media="print" onload="this.media='all'">
      <noscript><link rel="stylesheet" href="{{ 'staw-parcellab.css' | asset_url }}"></noscript>
    {%- endif -%}

    {%- if load_paqato_styles -%}
      <link rel="stylesheet" href="{{ 'staw-paqato.css' | asset_url }}" media="print" onload="this.media='all'">
      <noscript><link rel="stylesheet" href="{{ 'staw-paqato.css' | asset_url }}"></noscript>
    {%- endif -%}

    {{ content_for_header }}
  </head>

  {%- assign feature_classes = '' -%}

  {%- if settings.show_image_zoom -%}
    {% assign feature_classes = feature_classes | append: ' features--image-zoom' %}
  {%- endif -%}

  <body class="no-focus-outline template-{{ template.name }} template-suffix-{{ template.suffix }} {{ feature_classes }}" data-instant-allow-query-string>
    {%- comment -%}Common SVG definitions that we are re-using in several places{%- endcomment -%}
    <svg class="visually-hidden">
      <linearGradient id="rating-star-gradient-half">
        <stop offset="50%" stop-color="rgb(var(--product-star-rating))" />
        <stop offset="50%" stop-color="rgb(var(--product-star-rating))" stop-opacity="0.4" />
      </linearGradient>
    </svg>

    <a href="#main" class="visually-hidden skip-to-content">{{ 'general.accessibility.skip_to_content' | t }}</a>
    <loading-bar class="loading-bar"></loading-bar>

    {%- if request.page_type != 'gift_card' and request.page_type != 'password' and template.suffix != "pferdekonfigurator" -%}
      {%- sections 'header-group' -%}
      {%- sections 'overlay-group' -%}

      {%- unless settings.cart_type == 'page' or request.page_type == 'cart' -%}
        {%- section 'mini-cart' -%}
      {%- endunless -%}
    {%- endif -%}

    {% if template.suffix == "pferdekonfigurator" %} 
      {% section 'header' %}
    {% endif %}

    <div id="main" role="main" class="anchor">
      {%- comment -%}
        IMPLEMENTATION NOTE: on collection and search page, the theme was designed to show on mobile the filter bar and/or sort
          by at the very top of the page. However, due to the fact that sections are isolated, I had to move the code
          here. Then, the collection section, based on the selected settings, will eventually hide those elements in CSS
      {%- endcomment -%}
      {%- if request.page_type == 'collection' or request.page_type == 'search' -%}
        {%- assign active_filters_count = 0 -%}

        {%- if request.page_type == 'collection' -%}
          {%- assign filters = collection.filters -%}
        {%- else -%}
          {%- assign filters = search.filters -%}
        {%- endif -%}

        {%- for filter in filters -%}
          {%- if filter.type == 'list' -%}
            {%- assign active_filters_count = active_filters_count | plus: filter.active_values.size -%}
          {%- elsif filter.type == 'price_range' and filter.min_value.value or filter.max_value.value -%}
            {%- assign active_filters_count = active_filters_count | plus: 1 -%}
          {%- endif -%}
        {%- endfor -%}

        {%- assign is_toolbar_collapsed = false -%}

        {%- if request.page_type == 'search'
          and search.results.first.object_type != 'product'
          and search.results_count > 0
        -%}
          {%- assign is_toolbar_collapsed = true -%}
        {%- endif -%}

        <div
          id="mobile-facet-toolbar"
          class="mobile-toolbar {% if is_toolbar_collapsed %}is-collapsed{% endif %} hidden-pocket hidden-lap-and-up"
        >
          <button
            is="toggle-button"
            class="mobile-toolbar__item mobile-toolbar__item--filters {% if active_filters_count > 0 %}has-filters{% endif %}"
            aria-expanded="false"
            aria-controls="facet-filters"
            style="display: none"
          >
            {%- render 'icon' with 'filters' -%}
            <span class="mobile-toolbar__item-label">{{- 'collection.general.filters' | t -}}</span>
          </button>

          <button
            is="toggle-button"
            class="mobile-toolbar__item mobile-toolbar__item--sort"
            aria-expanded="false"
            aria-controls="sort-by-popover"
            style="display: none"
          >
            <span class="mobile-toolbar__item-label">{{- 'collection.general.sort_by' | t -}}</span>
            {%- render 'icon' with 'chevron' -%}
          </button>
        </div>
      {%- endif -%}

      {{ content_for_layout }}
    </div>

    {%- if request.page_type != 'gift_card' and request.page_type != 'password' -%}
      {%- sections 'footer-group' -%}
    {%- endif -%}
    <div id="hazard-modal" class="modal">
      <div class="modal-content">
        <span id="close-modal" class="close">&times;</span>
        <h2>CLP-/REACH-Hinweise</h2>
        <div id="hazard-content" class="hazard-content">
          <div class="hazard-signal-words"></div>
          <div class="hazard-statements"></div>
        </div>
      </div>
    </div>
    <script>
      function closeModal() {
        const modal = document.getElementById('hazard-modal');
        modal.style.display = 'none';
        modal.style.visibility = 'hidden';
      }
      if(document.getElementById('close-modal')){
        document.getElementById('close-modal').addEventListener('click', closeModal);
      }
    </script>
  </body>
</html>
