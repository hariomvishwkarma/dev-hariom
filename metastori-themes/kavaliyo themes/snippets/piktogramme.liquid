{% if product.selected_or_first_available_variant.metafields.custom.gefahren-piktogramm != blank 
    or product.selected_or_first_available_variant.metafields.custom.signalwort != blank 
    or product.selected_or_first_available_variant.metafields.custom.gefahrenhinweise != blank %}
<div class="hazard-info">
    <div class="hazard-symbols">
        {% assign piktogramme = product.selected_or_first_available_variant.metafields.custom.gefahren-piktogramm | split: ',' %}
        {% for piktogramm in piktogramme %}
            {% if piktogramm contains 'GHS01' %}
                {% assign image_url = settings.ghs01_image | image_url: width: 40 %}
            {% elsif piktogramm contains 'GHS02' %}
                {% assign image_url = settings.ghs02_image | image_url: width: 40 %}
            {% elsif piktogramm contains 'GHS03' %}
                {% assign image_url = settings.ghs03_image | image_url: width: 40 %}
            {% elsif piktogramm contains 'GHS04' %}
                {% assign image_url = settings.ghs04_image | image_url: width: 40 %}
            {% elsif piktogramm contains 'GHS05' %}
                {% assign image_url = settings.ghs05_image | image_url: width: 40 %}
            {% elsif piktogramm contains 'GHS06' %}
                {% assign image_url = settings.ghs06_image | image_url: width: 40 %}
            {% elsif piktogramm contains 'GHS07' %}
                {% assign image_url = settings.ghs07_image | image_url: width: 40 %}
            {% elsif piktogramm contains 'GHS08' %}
                {% assign image_url = settings.ghs08_image | image_url: width: 40 %}
            {% elsif piktogramm contains 'GHS09' %}
                {% assign image_url = settings.ghs09_image | image_url: width: 40 %}
            {% endif %}
            <img src="{{ image_url }}" alt="Gefahrenpiktogramm" width="40" height="40" loading="lazy">
        {% endfor %}
    </div>
    {% if product.selected_or_first_available_variant.metafields.custom.signalwort != blank %}
        <div class="hazard-signal-words">
            <strong>Signalwort:</strong> {{ product.selected_or_first_available_variant.metafields.custom.signalwort }}
        </div>
    {% endif %}
    {% if product.selected_or_first_available_variant.metafields.custom.gefahrenhinweise != blank %}
        <div class="hazard-statements">
            <strong>Gefahrenhinweise:</strong>
            <div>{{ product.selected_or_first_available_variant.metafields.custom.gefahrenhinweise }}</div>
        </div>
    {% endif %}
    {% if product.selected_or_first_available_variant.metafields.custom.ergaenzende-gefahrenmerkmale != blank %}
        <div class="hazard-statements">
            <strong>Ergänzende Gefahrenhinweise:</strong>
            <div>{{ product.selected_or_first_available_variant.metafields.custom.ergaenzende-gefahrenmerkmale }}</div>
        </div>
    {% endif %}
</div>
{% endif %}