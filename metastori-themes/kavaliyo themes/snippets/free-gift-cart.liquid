{% assign free_item_threshold = settings.cart_free_item_threshold | times: 100 %}
{% assign free_item_threshold2 = settings.cart_free_item_threshold2 | times: 100 %}
{% assign free_item_threshold3 = settings.cart_free_item_threshold3 | times: 100 %}
{% assign free_item_threshold4 = settings.cart_free_item_threshold4 | times: 100 %}
{% assign free_item_threshold5 = settings.cart_free_item_threshold5 | times: 100 %}
{%- assign calculated_total_price = cart.total_price -%}

{% assign enable_free_product = settings.enable_free_item %}
{% assign enable_free_product2 = settings.enable_free_item2 %}
{% assign enable_free_product3 = settings.enable_free_item3 %}
{% assign enable_free_product4 = settings.enable_free_item4 %}
{% assign enable_free_product5 = settings.enable_free_item5 %}

{% assign gift_products = settings.free_products %}
{% assign gift_products2 = settings.free_products2 %}
{% assign gift_products3 = settings.free_products3 %}
{% assign gift_products4 = settings.free_products4 %}
{% assign gift_products5 = settings.free_products5 %}

{% assign product_products_vid = '' %}
{% for gift_product in gift_products %}
  {% assign vid = gift_product.selected_or_first_available_variant.id | append: '' %}
  {% assign product_products_vid = product_products_vid | append: vid | append: ',' %}
{% endfor %}
{% assign product_products_vid = product_products_vid | split: ',' %}

{% assign product_products_vid2 = '' %}
{% for gift_product in gift_products2 %}
  {% assign vid = gift_product.selected_or_first_available_variant.id | append: '' %}
  {% assign product_products_vid2 = product_products_vid2 | append: vid | append: ',' %}
{% endfor %}
{% assign product_products_vid2 = product_products_vid2 | split: ',' %}

{% assign product_products_vid3 = '' %}
{% for gift_product in gift_products3 %}
  {% assign vid = gift_product.selected_or_first_available_variant.id | append: '' %}
  {% assign product_products_vid3 = product_products_vid3 | append: vid | append: ',' %}
{% endfor %}
{% assign product_products_vid3 = product_products_vid3 | split: ',' %}

{% assign product_products_vid4 = '' %}
{% for gift_product in gift_products4 %}
  {% assign vid = gift_product.selected_or_first_available_variant.id | append: '' %}
  {% assign product_products_vid4 = product_products_vid4 | append: vid | append: ',' %}
{% endfor %}
{% assign product_products_vid4 = product_products_vid4 | split: ',' %}

{% assign product_products_vid5 = '' %}
{% for gift_product in gift_products5 %}
  {% assign vid = gift_product.selected_or_first_available_variant.id | append: '' %}
  {% assign product_products_vid5 = product_products_vid5 | append: vid | append: ',' %}
{% endfor %}
{% assign product_products_vid5 = product_products_vid5 | split: ',' %}

{% assign gift_in_cart = false %}
{% assign gift_in_cart2 = false %}
{% assign gift_in_cart3 = false %}
{% assign gift_in_cart4 = false %}
{% assign gift_in_cart5 = false %}

{% for item in cart.items %}
  {% assign item_vid = item.variant.id | append: '' %}
  {% if product_products_vid contains item_vid %}
    {% assign gift_in_cart = true %}
  {% endif %}
  {% if product_products_vid2 contains item_vid %}
    {% assign gift_in_cart2 = true %}
  {% endif %}
  {% if product_products_vid3 contains item_vid %}
    {% assign gift_in_cart3 = true %}
  {% endif %}
  {% if product_products_vid4 contains item_vid %}
    {% assign gift_in_cart4 = true %}
  {% endif %}
  {% if product_products_vid5 contains item_vid %}
    {% assign gift_in_cart5 = true %}
  {% endif %}
{% endfor %}

{% capture free_gift_headline_html %}
  <div class="free_headline">
    {% render 'icon' with 'icon-gift' %}
      <span>{{ settings.cart_free_gift_headline }}</span>
    </div>
{% endcapture %}

{% if enable_free_product and gift_in_cart == false %}
  <div
    class="cart-free-gift {% if calculated_total_price >= free_item_threshold %} active-gift{% endif %}"
    {% if settings.hide_gift_preview_at_cart %}
      style="display: none;"
    {% endif %}
  >
    {{ free_gift_headline_html }}
    <div class="free-gift-item-wrap cart-upsell-products-wrapper {% if calculated_total_price >= free_item_threshold %} active {% endif %}">
      {% for gift_product in gift_products %}
        {% render 'free-gift-cart-product-temp', product: gift_product %}
      {% endfor %}
    </div>
  </div>
{% endif %}

{% if enable_free_product2 and gift_in_cart == true and gift_in_cart2 == false %}
  <div class="cart-free-gift {% if calculated_total_price >= free_item_threshold2 %} active-gift{% endif %}">
    {{ free_gift_headline_html }}
    <div class="free-gift-item-wrap cart-upsell-products-wrapper {% if calculated_total_price >= free_item_threshold2 %} active {% endif %}">
      {% for gift_product in gift_products2 %}
        {% render 'free-gift-cart-product-temp', product: gift_product %}
      {% endfor %}
    </div>
  </div>
{% endif %}

{% if enable_free_product3 and gift_in_cart == true and gift_in_cart2 == true and gift_in_cart3 == false %}
  <div class="cart-free-gift {% if calculated_total_price >= free_item_threshold3 %} active-gift{% endif %}">
    {{ free_gift_headline_html }}
    <div class="free-gift-item-wrap cart-upsell-products-wrapper {% if calculated_total_price >= free_item_threshold3 %} active {% endif %}">
      {% for gift_product in gift_products3 %}
        {% render 'free-gift-cart-product-temp', product: gift_product %}
      {% endfor %}
    </div>
  </div>
{% endif %}

{% if enable_free_product4
  and gift_in_cart == true
  and gift_in_cart2 == true
  and gift_in_cart3 == true
  and gift_in_cart4 == false
%}
  <div class="cart-free-gift {% if calculated_total_price >= free_item_threshold4 %} active-gift{% endif %}">
    {{ free_gift_headline_html }}
    <div class="free-gift-item-wrap cart-upsell-products-wrapper {% if calculated_total_price >= free_item_threshold4 %} active {% endif %}">
      {% for gift_product in gift_products4 %}
        {% render 'free-gift-cart-product-temp', product: gift_product %}
      {% endfor %}
    </div>
  </div>
{% endif %}

{% if enable_free_product5
  and gift_in_cart == true
  and gift_in_cart2 == true
  and gift_in_cart3 == true
  and gift_in_cart4 == true
  and gift_in_cart5 == false
%}
  <div class="cart-free-gift {% if calculated_total_price >= free_item_threshold5 %} active-gift{% endif %}">
    {{ free_gift_headline_html }}
    <div class="free-gift-item-wrap cart-upsell-products-wrapper {% if calculated_total_price >= free_item_threshold5 %} active {% endif %}">
      {% for gift_product in gift_products5 %}
        {% render 'free-gift-cart-product-temp', product: gift_product %}
      {% endfor %}
    </div>
  </div>
{% endif %}

<style>
    .cart-free-gift {
      display: none;
    }
    .cart-free-gift .upsell-product-description {
        display: none;
    }

    .cart-free-gift.active-gift {
        display: block !important;
    }
    .free-gift-item-wrap .product-meta__price-list-container {
      margin-top: 6px;
    }
    .free-gift-action.button.button--primary {
        line-height: 1;
        padding: 4px 6px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 8px;
        width: 40px;
        min-width: 40px;
        height: 40px;
        cursor: pointer;
        bottom: 0px;
        margin: 0;
        margin-left: 12px;
    }
    .ed-gift-price-free {
        padding: 3px 7px 4px;
        background: #DEF4F0;
        color: #1B534B;
        border-radius: 4px;
        font-size: 12px;
        line-height: 1;
    }
    .cart-free-gift .free_headline,.cart-free-gift .price-wrap span,.cart-free-gift .gift-product-title{
      color: {{settings.cart_free_gift_color}} !important;
    }
    .cart-free-gift{
      margin-inline: -16px;
      padding-inline: 16px;
      padding-block: 0;
    }
    .cart-free-gift .upsell-product {
      background-color: {{settings.cart_free_gift_bg_color}} !important;
      padding: 8px;
      border-radius: 8px;
  }

  .cart-free-gift .cart-upsell-products-wrapper {
      background: transparent;
  }
  .cart-free-gift {
    margin-top: 0;
    position: relative;
    z-index: 1000;
  }
  .cart-free-gift .free_headline {
    font-size: 16px;
    font-weight: 600;
    line-height: 1;
    display: flex;
    align-items: center;
    justify-content: flex-start;
    gap: 6px;
  }
  .cart-free-gift .free_headline span {
    margin-top: 6px;
    font-weight: 600;
  }

  .cart-free-gift .free_headline svg {
    display: flex;
    width: 22px;
    height: auto;
  }
  .cart-free-gift  .slick-track {
    margin-left: -4px;
  }
  .cart-free-gift .slick-list {
    margin-left: -8px;
    margin-right: -8px;
  }
  @media (min-width: 768px) {
    .cart-free-gift .slick-slide {
      padding-inline: 8px;
    }
  }
  @media (max-width: 767px) {
    .cart-free-gift .slick-slide {
      padding-inline: 4px;
    }
  }
  .free-gift-item-wrap.cart-upsell-products-wrapper {
    margin-top: 0;
    padding-top: 0;
    padding-bottom: 0;
    margin-bottom: 0;
  }

  .cart-free-gift .free-gift-product-image {
    width: 67px;
  }
  .cart-free-gift .free-gift-product-image img {
    max-width: 100%;
  }
  .cart-free-gift .gift-product-title {
    font-size: 12px;
    font-style: normal;
    font-weight: 400;
    line-height: 15px;
    text-transform: uppercase;
    margin-bottom: 0;
  }
  .cart-free-gift .price-wrap span:first-child {
    text-decoration: line-through;
  }
  .cart-free-gift .price-wrap {
    dislay: flex;
    gap: 5px;
  }
  .cart-free-gift .price-wrap span {
    font-size: 12px;
    font-style: normal;
    font-weight: 400;
    line-height: 24px;
  }
  .cart-free-gift .free-gift-action {
    display: inline-block;
    padding: 5px 12px;
    background-color: #000;
    color: #fff;
    font-size: 10px;
    font-weight: 700;
    line-height: 1;
    margin-top: 5px;
    text-transform: uppercase;
    cursor: pointer;
  }
  .cart-free-gift .free-gift-product {
    display: flex !important;
    align-items: center;
    padding: 12px 0;
    border-radius: 3px;
  }
  .cart-free-gift .free-gift-product-info {
    padding: 0 11px;
  }

  .cart-free-gift .slick-dots {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    align-items: center;
    position: absolute;
    bottom: 0;
    left: 50%;
    transform: translateX(-50%);
  }
  .cart-free-gift .slick-dots button {
    display: none;
  }
  .cart-free-gift .slick-dots li {
    width: 6px;
    height: 6px;
    background-color: #d9d9d9;
    border-radius: 50%;
    cursor: pointer;
  }
  .cart-free-gift .slick-dots li:not(last-child) {
    margin-right: 6px;
  }
  .cart-free-gift .slick-dots li.slick-active {
    background-color: #000;
  }
  .cart-free-gift .slick-arrow {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    line-height: 1;
  }
  .cart-free-gift .slick-arrow.slick-prev {
    left: -15px;
  }
  .cart-free-gift .slick-arrow.slick-prev svg {
    transform: rotate(180deg);
  }
  .cart-free-gift .slick-arrow.slick-next {
    right: -15px;
  }
  .cart-free-gift .slick-arrow[aria-disabled="true"] {
    display: none !important;
  }
  .shipping-bar__progress_gift_icon svg{
    width: 18px;
    height: 18px;
  }
  body .shipping-bar__progress{
    margin-bottom: 18px;
    height: 4px;
    border-radius: 50px !important;
    margin-top: 0px !important;
    position: relative;
  }
  span.shipping-bar__progress {
    border: none;
    box-shadow: 0 1px rgb(var(--root-border-color)) inset;
  }
    .shipping-bar__progress:after {
        border-radius: 180px;
    }

  .free-gift-item-wrap{
    opacity: 0.5;
    pointer-events: none;

  }
  .free-gift-item-wrap.active{
    opacity: 1;
    pointer-events: auto;
  }
  .shipping-bar__progress_gift_icon.active{
    border-color: {{settings.shipping_bar_color}};
  }
  /* free gift */

  /* shipping bar */
  free-shipping-bar.ed-free-shipping-bar.shipping-bar {
    margin-block-start: 30px;
    padding-block-end: 8px;
    border-bottom: 1px solid #F3F4FA;
    margin-block-end: 0;
  }
  .shipping-bar__progress_gift_icon {
      background: #DEF4F0;
      color: #444655;
      padding: 4px;
      border-radius: 50px;
      height: 24px;
      width: 24px;
      position: absolute;
      top: -10px;
      display: flex;
      align-items: center;
      justify-content: center;
      z-index: 1;
      font-size: 12px;
  }
  span.ed_check {
      display: none;
  }
  span.ed_check > svg {
      fill: currentColor;
      width: 12px;
      height: auto;
  }

  .ed_free_product_inner_details {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 4px;
  }

  .ed_free_product_inner_details > svg {
      display: flex;
      width: 100%;
      height: auto;
  }

  .ed_free_product_inner_details > span {
      line-height: 1;
  }

  .shipping-bar__progress_gift_icon:before {
      content: "";
      width: 6px;
      height: 6px;
      background: #7AB427;
      position: absolute;
      bottom: -14px;
      border-radius: 50px;
      display: none;
  }

  .shipping-bar__progress_gift_icon:after {
      top: 100%;
      left: 50%;
      border: solid transparent;
      content: "";
      height: 0;
      width: 0;
      position: absolute;
      pointer-events: none;
      border-color: rgba(136, 183, 213, 0);
      border-top-color: #f8f4e8;
      border-width: 4px;
      margin-left: -4px;
      display: none;
  }
  .shipping-bar__progress_gift_icon.active  span.ed_check {
      display: flex;
  }
  .shipping-bar__progress_gift_icon.active {
      background: #58C5B4;
      color: #444655;
  }
  .shipping-bar__progress_gift_icon.active:after {
      border-top-color: #58C5B4;
  }
  .shipping-bar__progress_gift_icon.active:before  {
      background: #444655;
  }
  free-shipping-bar.ed-free-shipping-bar.shipping-bar > * {
    text-align: left;
  }
  /* shipping bar */
  .free-gift-item-wrap.cart-upsell-products-wrapper {
    margin-top: 6px;
    margin-right: -22px;
    position: static;
  }
  .cart-free-gift {
    background-color: #f6f6f6;
    z-index: 10;
    padding-top: 12px;
    margin-bottom: 8px;
    position: relative;
  }
  .free-gift-item-wrap.cart-upsell-products-wrapper button.slick-prev,
  .free-gift-item-wrap.cart-upsell-products-wrapper button.slick-next {
    position: absolute;
    top: 24px;
    z-index: 2;
    display: flex !important;
    align-items: center;
    justify-content: center;
    background-color: #E0E0E0;
  }

  .free-gift-item-wrap.cart-upsell-products-wrapper button.slick-prev {
      right: 48px;
      left: unset !important;
  }

  .free-gift-item-wrap.cart-upsell-products-wrapper button.slick-next {
      right: 16px;
  }

  .free-gift-item-wrap.cart-upsell-products-wrapper button.slick-disabled {opacity: 0.7;}


</style>
