{%- comment -%}
  Inline delivery properties for grid/quick ATC (single-variant forms).
  Params: product, form_id, variant (variant actually added to cart; defaults to first available)
  Uses hidden inputs only (no per-card JSON script — keeps search/collection pages light).
{%- endcomment -%}
{%- assign kav_atc_variant = variant | default: product.first_available_variant -%}
{% render 'kavalio-delivery-checkout-properties',
  product: product,
  variant: kav_atc_variant,
  product_form_id: form_id,
  text_in_stock: '1-2',
  render_hidden_inputs: true,
  render_delivery_script: false
%}
