    pushEvent(event, data = {}) {
        if (this.isShopifyAdmin()) return;
        window.dataLayer = window.dataLayer || [];
        const ecommerceEvents = [
            'view_item', 'view_item_list', 'view_cart',
            'add_to_cart', 'remove_from_cart', 'add_to_wishlist',
            'remove_from_wishlist', 'begin_checkout', 'select_item'
        ];
        if (ecommerceEvents.includes(event)) {
            window.dataLayer.push({ ecommerce: null });
        }
        const eventData = this.buildEventData();
        if (data._search_origin) {
            if (data._search_origin.page_path) eventData.page_path = data._search_origin.page_path;
            if (data._search_origin.page_type) eventData.page_type = data._search_origin.page_type;
            if (data._search_origin.page_location) eventData.page_location = U.sanitizeUrl(data._search_origin.page_location);
        }
        if (data.action_source) eventData.action_source = data.action_source;
        if (data.cart_type) eventData.cart_type = data.cart_type;
        if ((event === 'add_to_cart' || event === 'remove_from_cart') &&
            (eventData.action_source === 'cart_drawer' || eventData.action_source === 'cart_page' || eventData.action_source === 'cart_drawer_recommendation')) {
            eventData.page_type = 'cart';
        }
        if (event === 'view_item_list' && data.item_list_id === 'cart_drawer_recommendations') {
            eventData.page_type = 'cart';
        }
        if (data.cart_status) eventData.cart_status = data.cart_status;
        if (event === 'view_cart' || event === 'begin_checkout') {
            eventData.is_direct_cart_link = _urlParams.has('cart_link_id');
        }
        const payload = {
            event: 'msr_' + event,
            event_data: eventData
        };
        if (this._cachedAttribution) {
            payload.attribution = this._cachedAttribution;
        }
        const userData = this.buildUserData();
        if (userData && Object.keys(userData).length > 0) {
            payload.user_data = userData;
        }
        if (ecommerceEvents.includes(event)) {
            const items = data.items || [];
            const includeIndexEvents = ['view_cart', 'begin_checkout', 'view_item_list'];
            const builtItems = this.buildItems(items, includeIndexEvents.includes(event), event, data);
            if (event === 'view_item_list') {
                items.forEach((item, i) => {
                    const listId = item.item_list_id || data.item_list_id;
                    const listName = item.item_list_name || data.item_list_name;
                    const listLocation = item.item_list_location || data.item_list_location;
                    const position = item.index !== undefined ? item.index : i;
                    if (listId) {
                        if (item.product_id) ListAttribution.save(item.product_id, listId, listName, listLocation, position);
                        if (item.handle) ListAttribution.save(item.handle, listId, listName, listLocation, position);
                    }
                });
            }
            const value = Calc.valueGross(items);
            const qty = items.reduce((sum, item) => sum + (item.quantity || 1), 0);
            let freeShipping;
            let freeShippingThreshold;
            if (MSR_CFG.FREE_SHIPPING_THRESHOLD > 0) {
                freeShippingThreshold = MSR_CFG.FREE_SHIPPING_THRESHOLD;
                freeShipping = value >= freeShippingThreshold;
            }
            const isCartEvent = ['view_cart', 'begin_checkout'].includes(event);
            const cartNote = isCartEvent && data.note?.trim() ? data.note.trim() : undefined;
            const itemsCountEvents = ['view_cart', 'begin_checkout', 'add_to_cart', 'remove_from_cart'];
            const includeItemsCount = itemsCountEvents.includes(event);
            const cartUrlEvents = ['view_cart', 'begin_checkout'];
            const cartUrls = cartUrlEvents.includes(event) ? this.buildCartUrls(items, event) : {};
            const ecommerce = {
                currency: MSR_SHOP.currency,
                currency_symbol: MSR_SHOP.currencySymbol,
                value: value,
                quantity: qty || undefined,
                unique_items: includeItemsCount ? builtItems.length || undefined : undefined,
                free_shipping: isCartEvent ? freeShipping : undefined,
                free_shipping_threshold: isCartEvent && freeShippingThreshold ? freeShippingThreshold : undefined,
                cart_note: cartNote,
                cart_url: cartUrls.cart_url,
                checkout_url: cartUrls.checkout_url,
                checkout_prefill_url: cartUrls.checkout_prefill_url,
                items: builtItems,
                aw_feed_country: window.Shopify?.country || MSR_SHOP.marketCountry || MSR_SHOP.country,
                aw_feed_language: (() => {
                    const co = (window.Shopify?.country || MSR_SHOP.marketCountry || MSR_SHOP.country || '').toUpperCase();
                    if (MSR_FEED_LANGUAGE_MAP[co]) return MSR_FEED_LANGUAGE_MAP[co].toLowerCase();
                    return MSR_SHOP.locale?.split('-')[0].toLowerCase();
                })()
            };
            if (data.item_list_id) ecommerce.item_list_id = data.item_list_id;
            if (data.item_list_name) ecommerce.item_list_name = data.item_list_name;
            if (data.item_list_location) ecommerce.item_list_location = data.item_list_location;
            if (data.item_list_page_type) ecommerce.item_list_page_type = data.item_list_page_type;
            Object.keys(ecommerce).forEach(key => {
                if (ecommerce[key] === undefined) delete ecommerce[key];
            });
            payload.ecommerce = ecommerce;
        }
        if (event === 'search' || event === 'view_search_results') {
            if (data.search_term !== undefined) payload.search_term = data.search_term;
        }
        if (event === 'view_item_list') {
            const listContext = this.buildListContext(event, data);
            if (listContext) payload.list_context = listContext;
        }
        window.dataLayer.push(payload);
        this.log(event, payload);
    }
    log(event, data) {
        if (!MSR_CFG.DEBUG) return;
        _msrLog('msr_' + event, data);
    }
    async updateCart() {
        try {
            const response = await fetch((window.Shopify?.routes?.root || '/') + 'cart.js');
            this.cart = await response.json();
            const _ipRoot = U.getStorageJSON('msr_item_properties', {});
            const _tc = _ipRoot.item_urls || {};
            (this.cart?.items || []).forEach(i => {
                if (i.product_id && _tc[i.product_id]?.tags && !i.tags) i.tags = _tc[i.product_id].tags;
            });
        } catch {}
    }
    cacheSaleData(variantId, compareAtPrice) {
        if (!variantId || !compareAtPrice || compareAtPrice <= 0) return;
        const consent = U.getConsent();
        if (MSR_CFG.PRIVACY_MODE && !consent.analytics) return;
        try {
            const root = U.getStorageJSON('msr_item_properties', {});
            const cache = root.sale_cache || {};
            cache[variantId] = { compare_at_price: compareAtPrice, updated: Date.now() };
            root.sale_cache = cache;
            U.setSync('msr_item_properties', JSON.stringify(root));
        } catch (e) { _msrWarn('cacheSaleData', e); }
    }
    getCachedSaleData(variantId) {
        const consent = U.getConsent();
        if (MSR_CFG.PRIVACY_MODE && !consent.analytics) return null;
        try {
            const root = U.getStorageJSON('msr_item_properties', {});
            const cache = root.sale_cache || {};
            const cached = cache[variantId];
            if (!cached) return null;
            if (Date.now() - (cached.updated || 0) > 90 * 24 * 60 * 60 * 1000) return null;
            return cached;
        } catch (e) {
            _msrWarn('getCachedSaleData', e);
            return null;
        }
    }
    cleanSaleCache() {
        try {
            const root = U.getStorageJSON('msr_item_properties', {});
            const cache = root.sale_cache || {};
            const ninetyDaysAgo = Date.now() - (90 * 24 * 60 * 60 * 1000);
            let changed = false;
            Object.keys(cache).forEach(key => {
                if (cache[key].updated < ninetyDaysAgo) {
                    delete cache[key];
                    changed = true;
                }
            });
            if (changed) {
                root.sale_cache = cache;
                U.setSync('msr_item_properties', JSON.stringify(root));
            }
        } catch (e) { _msrWarn('cleanSaleCache', e); }
    }
    enrichItem(item) {
        if (!item) return item;
        const vid = item.variant_id || item.id;
        if (item.compare_at_price > 0) {
            this.cacheSaleData(vid, item.compare_at_price);
            return item;
        }
        const cached = this.getCachedSaleData(vid);
        if (cached && cached.compare_at_price) {
            item.compare_at_price = cached.compare_at_price;
        }
        return item;
    }
    determineActionSource(element) {
        if (element) {
            const instantSearch = element.closest('[class*="instant-search"], [class*="predictive-search"], [class*="predictive-ultra"]');
            if (instantSearch) {
                return {
                    action_source: 'instant_search',
                    item_list_id: 'instant_search',
                    item_list_name: 'Instant Search',
                    item_list_location: window.location.pathname,
                    item_list_page_type: this.getPageType()
                };
            }
            const drawerEl = element.closest(MSR_CFG.SELECTORS.CART_DRAWER.join(','));
            if (drawerEl) {
                const recContainer = element.closest(MSR_CFG.SELECTORS.CART_DRAWER_RECS.join(','));
                if (recContainer) {
                    return {
                        action_source: 'cart_drawer_recommendation',
                        item_list_id: 'cart_drawer_recommendations',
                        item_list_name: U.getCartRecHeading(recContainer),
                        item_list_location: this.getPageType() === 'cart' ? 'cart_page' : 'cart_drawer',
                        item_list_page_type: 'cart'
                    };
                }
                return { action_source: 'cart_drawer' };
            }
            const appCrossSellEl = element.closest(MSR_CFG.SELECTORS.CROSS_SELL_APPS.join(','));
            const genericCrossSellEl = element.closest(
                '[class*="upsell"], [class*="Upsell"], ' +
                '[class*="cross-sell"], [class*="cross_sell"], [class*="crossSell"]'
            );
            const modalWrap = element.closest('[id*="modal-container"], [class*="Modal"], [class*="modal"], [role="dialog"], dialog');
            if (appCrossSellEl || (genericCrossSellEl && modalWrap)) {
                let modalTitle = '';
                if (modalWrap) {
                    const heading = modalWrap.querySelector('h1, h2, .Title, [class*="Title"], [class*="title"]');
                    modalTitle = heading?.textContent?.trim().substring(0, 120) || '';
                }
                return {
                    action_source: 'cross_sell_modal',
                    item_list_id: 'cross_sell_modal',
                    item_list_name: modalTitle || 'Cross-sell Recommendation',
                    item_list_location: window.location.pathname,
                    item_list_page_type: this.getPageType()
                };
            }
            if (element.closest(MSR_CFG.SELECTORS.STICKY_BAR)) {
                return { action_source: 'pdp_sticky_bar' };
            }
            const shopifySection = element.closest('[id^="shopify-section-"]');
            if (shopifySection && U.hasMultipleProducts(shopifySection)) {
                const sectionId = U.normalizeSectionId(shopifySection.id.replace('shopify-section-', ''));
                if (sectionId !== 'main') {
                    const isMainProductSection = this.getPageType() === 'product' && (
                        sectionId === 'product' || sectionId === 'product-template' ||
                        (sectionId.includes('main') && sectionId.includes('product'))
                    );
                    if (!isMainProductSection) {
                        const sectionTitle = U.findContainerHeading(element) || U.getSectionTitle(shopifySection, sectionId);
                        return {
                            action_source: 'product_list',
                            item_list_id: sectionId,
                            item_list_name: sectionTitle,
                            item_list_location: window.location.pathname,
                            item_list_page_type: this.getPageType()
                        };
                    }
                }
            }
        }
        const isInsideDrawer = element && element.closest(MSR_CFG.SELECTORS.CART_DRAWER.join(',') + ',' + MSR_CFG.SELECTORS.CART_DRAWER_RECS.join(','));
        if (window.MSR_cartDrawer && (!element || isInsideDrawer)) {
            const recContainer = document.querySelector(MSR_CFG.SELECTORS.CART_DRAWER_RECS.join(','));
            if (recContainer) {
                return {
                    action_source: 'cart_drawer_recommendation',
                    item_list_id: 'cart_drawer_recommendations',
                    item_list_name: U.getCartRecHeading(recContainer),
                    item_list_location: this.getPageType() === 'cart' ? 'cart_page' : 'cart_drawer',
                    item_list_page_type: 'cart'
                };
            }
            return { action_source: 'cart_drawer' };
        }
        if (this.getPageType() === 'product') {
            return { action_source: 'pdp_main_buybox' };
        }
        if (this.getPageType() === 'category') {
            const collectionsPath = (MSR_SHOP.routes?.collections || '/collections').replace(/\/$/, '');
            const collectionHandle = window.location.pathname.match(new RegExp(collectionsPath.replace(/[.*+?^${}()|[\]\\]/g, '\\$&') + '/([^/?#]+)'))?.[1] || 'collection';
            const pageTitle = document.querySelector('h1')?.textContent?.trim() || collectionHandle;
            return {
                action_source: 'product_list',
                item_list_id: collectionHandle,
                item_list_name: pageTitle,
                item_list_location: window.location.pathname,
                item_list_page_type: 'category'
            };
        }
        return { action_source: 'other' };
    }
