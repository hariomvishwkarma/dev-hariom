                sessionStorage.removeItem(storageKey);
            }
        }
        const getCurrentPage = () => {
            return parseInt(new URLSearchParams(location.search).get('page') || '1', 10);
        };
        const getNextIndex = () => {
            const currentPage = getCurrentPage();
            if (currentPage === 1) return 0;
            if (canUseStorage()) {
                const stored = sessionStorage.getItem(storageKey);
                return stored ? parseInt(stored, 10) : 0;
            }
            return 0;
        };
        const saveNextIndex = (nextIndex) => {
            if (canUseStorage()) {
                sessionStorage.setItem(storageKey, nextIndex.toString());
            }
        };
        const totalProductsCount = {{ collection.all_products_count | default: 0 }};
        const filteredProductsCount = {{ collection.products_count | default: collection.all_products_count | default: 0 }};
        const defaultSortBy = {{ collection.sort_by | default: collection.default_sort_by | json }};
        const GRID_SELECTOR = 'product-list, .product-list, .product-list__inner, .product-facet__product-list, ' +
            '.collection-product-list, .product-grid, .collection__products, ' +
            '[class*="product-grid"], [class*="collection-products"], ' +
            '.collection__main, .main-collection, #product-grid, ' +
            '[data-collection-products], main .grid';
        const CARD_SELECTORS = [
            'product-card', 'product-item',
            '.product-card', '.product-item',
            '[data-product-id]'
        ];
        const countProductCards = () => {
            const gridContainer = document.querySelector(GRID_SELECTOR);
            const searchRoot = gridContainer || document;
            let cardElements = [];
            for (const sel of CARD_SELECTORS) {
                try {
                    const found = Array.from(searchRoot.querySelectorAll(sel));
                    cardElements = found.filter(el => el.querySelector(MSR_PRODUCT_LINK_SELECTOR));
                    if (cardElements.length > 0) break;
                } catch (e) {}
            }
            if (cardElements.length === 0 && gridContainer) {
                cardElements = Array.from(gridContainer.children).filter(child =>
                    child.querySelector(MSR_PRODUCT_LINK_SELECTOR)
                );
            }
            if (cardElements.length === 0) {
                const productLinks = searchRoot.querySelectorAll(MSR_PRODUCT_LINK_SELECTOR);
                const seenCards = new WeakSet();
                productLinks.forEach(link => {
                    let card = link.closest(
                        'product-card, product-item, .product-card, .product-item, ' +
                        '.card, .prod-card, .grid__item, li[class*="product"], li'
                    );
                    if (card && !seenCards.has(card)) {
                        seenCards.add(card);
                        cardElements.push(card);
                    }
                });
            }
            return cardElements.length || filteredProductsCount;
        };
        const getTotalResultsCount = () => {
            const cardsOnPage = countProductCards();
            const hasPagination = getCurrentPage() > 1 || document.querySelector('[rel="next"], a[href*="page="], .pagination__next, [class*="pagination"] a:last-child[href*="page="]');
            if (!hasPagination) return cardsOnPage;
            return filteredProductsCount || totalProductsCount || cardsOnPage;
        };
        if (!this._collectionState) {
            this._collectionState = {
                trackedHandles: new Set(),
                lastUrl: location.href,
                currentIndex: getNextIndex()
            };
        }
        const state = this._collectionState;
        const extractVariantFromCard = (link, card) => {
            try {
                const href = link.getAttribute('href');
                if (href) {
                    const url = new URL(href, location.origin);
                    const variantParam = url.searchParams.get('variant');
                    if (variantParam) return variantParam;
                }
            } catch (e) {}
            const linkVariant = link.getAttribute('data-variant-id') || link.getAttribute('data-variant') || link.dataset?.variantId;
            if (linkVariant) return linkVariant;
            if (card) {
                const cardVariant = card.getAttribute('data-variant-id') || card.getAttribute('data-variant') || card.dataset?.variantId || card.getAttribute('data-selected-variant');
                if (cardVariant) return cardVariant;
                const variantEl = card.querySelector('[data-variant-id], [data-variant], input[name="id"][type="hidden"], select[name="id"]');
                if (variantEl) {
                    const vid = variantEl.getAttribute('data-variant-id') || variantEl.getAttribute('data-variant') || variantEl.value;
                    if (vid && /^\d+$/.test(vid)) return vid;
                }
                const variantWC = card.querySelector('variant-radios input[type="radio"]:checked, variant-selects input[type="radio"]:checked, product-variant-radios input[type="radio"]:checked');
                if (variantWC?.value && /^\d+$/.test(variantWC.value)) return variantWC.value;
            }
            return null;
        };
        const extractProductData = (card, handle, variantId) => {
            let price = 0;
            let productTitle = handle;
            let extractedVariantId = variantId || null;
            const jsonLd = card.querySelector('script[type="application/ld+json"]');
            if (jsonLd) {
                try {
                    const data = JSON.parse(jsonLd.textContent);
                    if (data['@type'] === 'Product') {
                        productTitle = data.name || handle;
                        if (variantId && Array.isArray(data.offers)) {
                            const matchingOffer = data.offers.find(o => o.sku === variantId || o.url?.includes('variant=' + variantId));
                            if (matchingOffer) price = U.toCents(matchingOffer.price);
                        }
                        if (price === 0) {
                            const offer = Array.isArray(data.offers) ? data.offers[0] : data.offers;
                            price = U.toCents(offer?.price);
                        }
                    }
                } catch (e) {}
            }
            return {
                product_title: productTitle,
                handle: handle,
                variant_id: extractedVariantId || undefined,
                url: MSR_buildProductUrl(handle, extractedVariantId),
                price: price,
                final_price: price,
                item_list_id: collectionId,
                item_list_name: collectionTitle,
                item_list_location: window.location.pathname,
                item_list_page_type: self.getPageType(),
                quantity: 1,
                item_inventory_quantity: collectionInventory[handle] ?? undefined,
                _needs_enrichment: price === 0
            };
        };
        let pendingItems = [];
        let flushTimeout = null;
        const FLUSH_DELAY = 800;
        const flushPendingItems = async () => {
            if (pendingItems.length === 0) return;
            const stillVisible = [];
            for (const item of pendingItems) {
                if (item._cardEl && U.isInViewport(item._cardEl)) {
                    stillVisible.push(item);
                } else if (item._dedupKey) {
                    state.trackedHandles.delete(item._dedupKey);
                }
            }
            pendingItems = stillVisible;
            if (pendingItems.length === 0) return;
            await _enrichItemsFromApi(pendingItems);
            pendingItems.forEach(i => { delete i._needs_enrichment; delete i._cardEl; delete i._dedupKey; });
            pendingItems.sort((a, b) => a.index - b.index);
            const currentPage = getCurrentPage();
            const sortOption = new URLSearchParams(location.search).get('sort_by') || defaultSortBy;
            const eventData = {
                items: pendingItems,
                item_list_id: collectionId,
                item_list_name: collectionTitle,
                item_list_location: window.location.pathname,
                item_list_page_type: self.getPageType(),
                sort_option: sortOption,
                results_count: countProductCards(),
                results_page: currentPage,
                applied_filters_count: U.getAppliedFiltersCount()
            };
            const detectedTotal = U.detectTotalResultsCount();
            if (detectedTotal != null) {
                eventData.total_results_count = detectedTotal;
            } else if (currentPage === 1 && !document.querySelector('[rel="next"], a[href*="page="]:not([href*="page=1"])')) {
                eventData.total_results_count = countProductCards();
            }
            const dynamicFilters = U.parseFiltersFromUrl(location.search);
            if (dynamicFilters.length > 0) {
                eventData.applied_filters = dynamicFilters;
            }
            self.pushEvent('view_item_list', eventData);
            saveNextIndex(state.currentIndex);
            pendingItems = [];
        };
        const scheduleFlush = () => {
            if (flushTimeout) clearTimeout(flushTimeout);
            flushTimeout = setTimeout(() => {
                flushTimeout = null;
                flushPendingItems();
            }, FLUSH_DELAY);
        };
        const collectVisibleProducts = () => {
            const gridContainer = document.querySelector(GRID_SELECTOR);
            const searchRoot = gridContainer || document;
            let cardElements = [];
            for (const sel of CARD_SELECTORS) {
                try {
                    const found = Array.from(searchRoot.querySelectorAll(sel));
                    cardElements = found.filter(el => el.querySelector(MSR_PRODUCT_LINK_SELECTOR));
                    if (cardElements.length > 0) break;
                } catch (e) {}
            }
            if (cardElements.length === 0 && gridContainer) {
                cardElements = Array.from(gridContainer.children).filter(child =>
                    child.querySelector(MSR_PRODUCT_LINK_SELECTOR)
                );
            }
            if (cardElements.length === 0) {
                const productLinks = searchRoot.querySelectorAll(MSR_PRODUCT_LINK_SELECTOR);
                const seenCards = new WeakSet();
                productLinks.forEach(link => {
                    let card = link.closest(
                        'product-card, product-item, .product-card, .product-item, ' +
                        '.card, .prod-card, .grid__item, li[class*="product"], li'
                    );
                    if (card && !seenCards.has(card)) {
                        seenCards.add(card);
                        cardElements.push(card);
                    }
                });
            }
            const cardPositions = new Map();
            let domIndex = 0;
            cardElements.forEach(card => {
                const link = card.querySelector(MSR_PRODUCT_LINK_SELECTOR);
                if (!link) return;
                const href = link.getAttribute('href');
                const match = href?.match(MSR_CFG.REGEX.PRODUCT_URL);
                if (!match) return;
                const handle = match[1];
                const variantId = extractVariantFromCard(link, card);
                const dedupKey = variantId ? `${handle}:${variantId}` : handle;
                if (!cardPositions.has(dedupKey)) {
                    cardPositions.set(dedupKey, domIndex);
                    domIndex++;
                }
            });
            cardElements.forEach(card => {
                const link = card.querySelector(MSR_PRODUCT_LINK_SELECTOR);
                if (!link) return;
                const href = link.getAttribute('href');
                const match = href?.match(MSR_CFG.REGEX.PRODUCT_URL);
                if (!match) return;
                const handle = match[1];
                const variantId = extractVariantFromCard(link, card);
                const dedupKey = variantId ? `${handle}:${variantId}` : handle;
                if (state.trackedHandles.has(dedupKey)) return;
                const inViewport = U.isInViewport(card);
                if (!inViewport) return;
                const productData = extractProductData(card, handle, variantId);
                if (!productData) return;
                state.trackedHandles.add(dedupKey);
                const correctIndex = cardPositions.get(dedupKey);
                pendingItems.push(Object.assign({}, productData, { index: correctIndex, _cardEl: card, _dedupKey: dedupKey }));
            });
            if (pendingItems.length > 0) {
                scheduleFlush();
            }
        };
        let scrollTimeout = null;
        const handleScroll = () => {
            if (scrollTimeout) clearTimeout(scrollTimeout);
            scrollTimeout = setTimeout(() => {
                scrollTimeout = null;
                collectVisibleProducts();
                if (pendingItems.length > 0) scheduleFlush();
            }, 500);
        };
        document.addEventListener('visibilitychange', () => {
            if (document.visibilityState === 'hidden' && pendingItems.length > 0) {
                if (flushTimeout) { clearTimeout(flushTimeout); flushTimeout = null; }
                flushPendingItems();
            }
        });
        window.addEventListener('beforeunload', () => {
            if (pendingItems.length > 0) flushPendingItems();
        });
        const handleUrlChange = () => {
            const currentUrl = location.href;
            if (currentUrl !== state.lastUrl) {
                state.lastUrl = currentUrl;
                if (pendingItems.length > 0) flushPendingItems();
                state.trackedHandles.clear();
                state.currentIndex = 0;
                setTimeout(collectVisibleProducts, 500);
                setTimeout(collectVisibleProducts, 1000);
                setTimeout(collectVisibleProducts, 1500);
            }
        };
        const setupMutationObserver = () => {
            const productGrid = document.querySelector(
                '.collection-product-list, .product-grid, .collection__products, ' +
                '[class*="product-grid"], [class*="collection-products"], main'
            );
            if (!productGrid) return;
            const observer = new MutationObserver((mutations) => {
                let hasNewProducts = false;
                mutations.forEach(mutation => {
                    if (mutation.addedNodes.length > 0) {
                        mutation.addedNodes.forEach(node => {
                            if (node.nodeType === 1 && (
                                node.querySelector?.(MSR_PRODUCT_LINK_SELECTOR) ||
                                node.matches?.(MSR_PRODUCT_LINK_SELECTOR)
                            )) {
                                hasNewProducts = true;
                            }
                        });
                    }
                });
                if (hasNewProducts) {
                    if (location.href !== state.lastUrl) {
                        handleUrlChange();
                    } else {
                        setTimeout(collectVisibleProducts, 100);
                    }
                }
            });
            observer.observe(productGrid, { childList: true, subtree: true });
        };
        window.addEventListener('scroll', handleScroll, { passive: true });
        window.addEventListener('popstate', handleUrlChange);
        window.addEventListener('msr:urlchange', handleUrlChange);
        setupMutationObserver();
        setTimeout(collectVisibleProducts, 500);
        setTimeout(collectVisibleProducts, 800);
        setTimeout(collectVisibleProducts, 1500);
        {% endif %}
    }
