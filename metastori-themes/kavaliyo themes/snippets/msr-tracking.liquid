    findAllClippingAncestors(el) {
        const ancestors = [];
        let node = el.parentElement;
        while (node && node !== document.body && node !== document.documentElement) {
            const style = getComputedStyle(node);
            const overflowX = style.overflowX;
            const overflow = style.overflow;
            const isScrollable = overflowX === 'auto' || overflowX === 'scroll' || overflow === 'auto' || overflow === 'scroll';
            const isHiddenOverflow = overflowX === 'hidden' || overflow === 'hidden';
            const isWiderThanClient = (isScrollable || isHiddenOverflow) && node.scrollWidth > node.clientWidth;
            if (isScrollable && isWiderThanClient) {
                ancestors.push(node);
                node = node.parentElement;
                continue;
            }
            if (isHiddenOverflow && isWiderThanClient) {
                ancestors.push(node);
                node = node.parentElement;
                continue;
            }
            if (isHiddenOverflow) {
                const classList = node.classList;
                const isKnownSlider = MSR_CFG.SELECTORS.SLIDER_CLASSES.some(cls => classList.contains(cls)) ||
                    node.matches(MSR_CFG.SELECTORS.SLIDER_PATTERNS);
                if (isKnownSlider) {
                    ancestors.push(node);
                    node = node.parentElement;
                    continue;
                }
            }
            node = node.parentElement;
