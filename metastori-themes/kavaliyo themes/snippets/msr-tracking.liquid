            let activeSearchId = sessionStorage.getItem('msr_search_id') || searchId;
            if (newState !== sessionStorage.getItem('msr_search_state')) {
                activeSearchId = 'srch_' + Date.now().toString(36) + '_' + Math.random().toString(36).substring(2, 10);
                try { sessionStorage.setItem('msr_search_id', activeSearchId); } catch {}
                try { sessionStorage.setItem('msr_search_state', newState); } catch {}
            }
            const data = {
                items: items,
                search_term: newSearchTerm,
                search_id: activeSearchId,
                sort_option: newSort,
                results_count: items.length,
                results_page: newPage,
                applied_filters_count: U.getAppliedFiltersCount(),
                item_list_id: 'search_results',
                item_list_name: 'Search Results',
                item_list_location: window.location.pathname,
                item_list_page_type: 'search_results'
            };
            const detectedTotal = U.detectTotalResultsCount();
            if (detectedTotal != null) data.total_results_count = detectedTotal;
            if (newAppliedFilters.length > 0) data.applied_filters = newAppliedFilters;
            self.pushEvent('view_search_results', data);
            self.pushEvent('view_item_list', data);
        };
        let lastSearchHref = location.href;
        const handleSearchUrlChange = () => {
            if (location.href === lastSearchHref) return;
            lastSearchHref = location.href;
            if (!isOnSearchPage()) return;
            if (searchPendingItems.length > 0) {
                if (searchFlushTimeout) { clearTimeout(searchFlushTimeout); searchFlushTimeout = null; }
                searchPendingItems = [];
            }
            searchTrackedHandles.clear();
            setTimeout(collectSearchItems, 500);
            setTimeout(collectSearchItems, 1000);
            setTimeout(collectSearchItems, 1500);
        };
        window.addEventListener('popstate', handleSearchUrlChange);
        window.addEventListener('msr:urlchange', handleSearchUrlChange);
        let observerArmed = false;
        setTimeout(() => { observerArmed = true; }, 1500);
        const obs = new MutationObserver((mutations) => {
            if (!observerArmed || !isOnSearchPage()) return;
            let hasNewProducts = false;
            for (const m of mutations) {
                for (const node of m.addedNodes) {
                    if (node.nodeType === 1 && (
                        node.querySelector?.(MSR_PRODUCT_LINK_SELECTOR) ||
                        node.matches?.(MSR_PRODUCT_LINK_SELECTOR)
                    )) {
                        hasNewProducts = true;
                        break;
                    }
                }
                if (hasNewProducts) break;
            }
            if (hasNewProducts) {
                if (location.href !== lastSearchHref) {
                    handleSearchUrlChange();
                } else {
                    setTimeout(collectSearchItems, 200);
                }
            }
        });
        const initialSearchContainer = findSearchContainer();
        if (initialSearchContainer) obs.observe(initialSearchContainer, { childList: true, subtree: true });
        {% endif %}
    }
    cartPage() {
        {% if template contains 'cart' %}
        window.MSR_cartDrawer = false;
        try {
            if (sessionStorage.getItem('msr_cart_action_fired') === 'true') {
                sessionStorage.removeItem('msr_cart_action_fired');
                return;
            }
        } catch {}
        const cartStatus = this.cart?.items?.length > 0 ? 'filled' : 'empty';
        this.pushEvent('view_cart', {
            items: (this.cart?.items || []).map(i => this.enrichItem({...i})),
            cart_type: 'cart_page',
            cart_status: cartStatus,
            note: this.cart?.note
        });
        {% endif %}
    }
    initCartPageActions() {
        {% if template contains 'cart' %}
        const self = this;
        const findItemByKey = (key) => {
            return self.cart?.items?.find(item => item.key === key);
        };
        const findItemByVariantId = (variantId) => {
            return self.cart?.items?.find(item => String(item.variant_id) === String(variantId));
        };
        document.addEventListener('pointerdown', (e) => {
            const link = e.target.closest('a[href*="/cart/change"]');
            if (!link) return;
            const href = link.getAttribute('href');
            if (!href) return;
            try {
                const url = new URL(href, location.origin);
                const params = url.searchParams;
                const lineKey = params.get('id');
                const lineIndex = params.get('line');
                const newQty = parseInt(params.get('quantity'), 10);
                if (isNaN(newQty)) return;
                let item = null;
                if (lineKey) {
                    item = findItemByKey(lineKey) || findItemByVariantId(lineKey.split(':')[0]);
                } else if (lineIndex) {
                    const idx = parseInt(lineIndex, 10) - 1;
                    if (idx >= 0 && self.cart?.items?.[idx]) {
                        item = self.cart.items[idx];
                    }
                }
                if (!item) return;
                const oldQty = item.quantity;
                if (newQty === 0) {
                    self.pushEvent('remove_from_cart', {
                        items: [self.enrichItem({ ...item, quantity: oldQty })],
                        action_source: 'cart_page'
                    });
                    sessionStorage.setItem('msr_cart_action_fired', 'true');
                } else if (newQty !== oldQty) {
                    const diff = newQty - oldQty;
                    if (diff > 0) {
                        self.pushEvent('add_to_cart', {
                            items: [self.enrichItem({ ...item, quantity: diff })],
                            action_source: 'cart_page'
                        });
                    } else {
                        self.pushEvent('remove_from_cart', {
                            items: [self.enrichItem({ ...item, quantity: Math.abs(diff) })],
                            action_source: 'cart_page'
                        });
                    }
                    sessionStorage.setItem('msr_cart_action_fired', 'true');
                }
            } catch {}
        }, true);
        {% endif %}
    }
    initAjaxInterception() {
        const self = this;
        let cartSnapshot = JSON.stringify(this.cart?.items || []);
        let lastClickedElement = null;
        let lastClickTime = 0;
        let capturedIntent = null;
        const INTENT_TTL = 10000;
        const CROSS_SELL_PROBE = MSR_CFG.SELECTORS.CROSS_SELL_APPS.join(',');
        const captureClickIntent = (e) => {
            const btn = e.target.closest(
                'button, [type="submit"], [role="button"], ' +
                '.add-to-cart, [data-add-to-cart], .product-form__submit, ' +
                '[class*="qty-up" i], [class*="qty-down" i], ' +
                '[class*="quantity-up" i], [class*="quantity-down" i], ' +
                '[class*="quantity__button" i], [data-quantity-button], ' +
                '[aria-label*="increase" i], [aria-label*="decrease" i], ' +
                '[aria-label*="add to cart" i], [aria-label*="remove" i]'
            );
            if (!btn) return;
            lastClickedElement = btn;
            lastClickTime = Date.now();
            if (btn.closest(CROSS_SELL_PROBE)) {
                capturedIntent = { source: self.determineActionSource(btn), time: Date.now() };
            }
        };
        document.addEventListener('pointerdown', captureClickIntent, true);
        document.addEventListener('click', captureClickIntent, true);
        const getRemoveActionSource = () => {
            const fresh = (Date.now() - lastClickTime < 2000) ? lastClickedElement : null;
            if (fresh) {
                return self.determineActionSource(fresh).action_source;
            }
            const drawerEl = U.findLargestDrawer();
            const drawerOpen = drawerEl ? (() => {
                const style = getComputedStyle(drawerEl);
                return !drawerEl.hasAttribute('hidden') &&
                    drawerEl.getAttribute('aria-hidden') !== 'true' &&
                    style.display !== 'none' &&
                    style.visibility !== 'hidden';
            })() : false;
            if (window.MSR_cartDrawer || drawerOpen) return 'cart_drawer';
            const pageType = self.getPageType();
            if (pageType === 'cart') return 'cart_page';
            return 'other';
        };
        const checkCartChange = async () => {
            await self.updateCart();
            const newSnapshot = JSON.stringify(self.cart?.items || []);
            if (cartSnapshot !== newSnapshot) {
                const oldItems = JSON.parse(cartSnapshot);
                const newItems = self.cart?.items || [];
                newItems.forEach(newItem => {
                    const oldItem = oldItems.find(i => i.id === newItem.id);
                    if (oldItem && newItem.quantity > oldItem.quantity) {
                        const diffQty = newItem.quantity - oldItem.quantity;
                        let _as = getRemoveActionSource();
                        if (_as === 'cross_sell_modal' && isPdpMainProductItem(newItem)) _as = 'pdp_main_buybox';
                        self.pushEvent('add_to_cart', {
                            items: [self.enrichItem({ ...newItem, quantity: diffQty })],
                            action_source: _as
                        });
                    }
                });
                oldItems.forEach(oldItem => {
                    const newItem = newItems.find(i => i.id === oldItem.id);
                    if (!newItem || newItem.quantity < oldItem.quantity) {
                        const diffQty = oldItem.quantity - (newItem?.quantity || 0);
                        self.pushEvent('remove_from_cart', {
                            items: [self.enrichItem({ ...oldItem, quantity: diffQty })],
                            action_source: getRemoveActionSource()
                        });
                    }
                });
                cartSnapshot = newSnapshot;
            }
        };
        const parseAddBody = (body) => {
            const map = {};
            if (!body) return map;
            try {
                let bodyData;
                if (typeof body === 'string') {
                    if (body.startsWith('{')) {
                        bodyData = JSON.parse(body);
                    } else {
                        const params = new URLSearchParams(body);
                        bodyData = { id: params.get('id'), quantity: params.get('quantity') };
                    }
                } else if (body instanceof FormData) {
                    bodyData = { id: body.get('id'), quantity: body.get('quantity') };
                } else if (typeof URLSearchParams !== 'undefined' && body instanceof URLSearchParams) {
                    bodyData = { id: body.get('id'), quantity: body.get('quantity') };
                }
                if (bodyData) {
                    if (bodyData.id) {
                        map[bodyData.id] = parseInt(bodyData.quantity) || 1;
                    }
                    if (bodyData.items && Array.isArray(bodyData.items)) {
                        bodyData.items.forEach(item => {
                            if (item.id) map[item.id] = parseInt(item.quantity) || 1;
                        });
                    }
                }
            } catch (e) {}
            return map;
        };
        const reachableDocs = () => {
            const docs = [document];
            for (const f of document.querySelectorAll('iframe')) {
                try {
                    const d = f.contentDocument;
                    if (d && d.querySelector) docs.push(d);
                } catch (e) { /* cross-origin / sandboxed — skip */ }
            }
            return docs;
        };
        const snapshotCrossSell = () => {
            for (const doc of reachableDocs()) {
                for (const c of doc.querySelectorAll(CROSS_SELL_PROBE)) {
                    const m = c.closest('[id*="modal-container"], [class*="Modal"], [class*="modal"], [role="dialog"], dialog');
                    if (!m) continue;
                    const cs = (doc.defaultView || window).getComputedStyle(m);
                    if (cs.display === 'none' || cs.visibility === 'hidden') continue;
                    const h = m.querySelector('h1, h2, .Title, [class*="Title"], [class*="title"]');
                    return { name: h?.textContent?.trim().substring(0, 120) || 'Cross-sell Recommendation' };
                }
            }
            return null;
        };
        const pdpMainProductId = () => {
            if (self._pdpProductId != null) return String(self._pdpProductId);
            try {
                const m = (window.ShopifyAnalytics && window.ShopifyAnalytics.meta) || window.meta;
                if (m && m.product && m.product.id != null) return String(m.product.id);
            } catch (e) {}
            return null;
        };
        const isPdpMainProductItem = (item) => {
            if (!item || self.getPageType() !== 'product') return false;
            const id = pdpMainProductId();
            return !!id && String(item.product_id) === id;
        };
        const handleAddSuccess = (data, requestedQuantities, xsSnapshot) => {
            let itemsToTrack = [];
            if (data.items && Array.isArray(data.items)) {
                itemsToTrack = data.items;
            } else if (data.id || data.variant_id) {
                itemsToTrack = [data];
            }
            if (itemsToTrack.length === 0) return;
            let source;
            if (capturedIntent && (Date.now() - capturedIntent.time) < INTENT_TTL) {
                source = capturedIntent.source;
                capturedIntent = null;
            } else {
                const element = (Date.now() - lastClickTime < 2000) ? lastClickedElement : null;
                source = self.determineActionSource(element);
            }
            let _weakSrc = !source.item_list_id || ['pdp_main_buybox', 'pdp_sticky_bar', 'other'].includes(source.action_source);
            if (_weakSrc && xsSnapshot) {
                source = {
                    action_source: 'cross_sell_modal',
                    item_list_id: 'cross_sell_modal',
                    item_list_name: xsSnapshot.name,
                    item_list_location: window.location.pathname,
                    item_list_page_type: self.getPageType()
                };
                _weakSrc = false;
            }
            if (_weakSrc) {
                const xsParts = [];
                itemsToTrack.forEach(item => {
                    const pid = item.product_id || item.id;
                    const vid = item.variant_id || item.id;
                    if (vid) xsParts.push('[data-accepted-product-variant="' + vid + '"]', '[data-variant-id="' + vid + '"]');
                    if (pid) xsParts.push('[class*="Product-Id-' + pid + '" i]', '[data-product-id="' + pid + '"]');
                });
                let xsCtx = null, offerEl = null;
                if (xsParts.length) {
                    const xsAppSel = MSR_CFG.SELECTORS.CROSS_SELL_APPS.join(',');
                    for (const doc of reachableDocs()) {
                        if (xsCtx) break;
                        doc.querySelectorAll(xsParts.join(',')).forEach(el => {
                            if (xsCtx) return;
                            const ctx = el.closest(xsAppSel);
                            if (ctx) { offerEl = el; xsCtx = ctx; }
                        });
                    }
                }
                if (xsCtx) {
                    const modalWrap = offerEl.closest('[id*="modal-container"], [class*="Modal"], [class*="modal"], [role="dialog"], dialog') || xsCtx;
                    const heading = modalWrap.querySelector('h1, h2, .Title, [class*="Title"], [class*="title"]');
                    source = {
                        action_source: 'cross_sell_modal',
                        item_list_id: 'cross_sell_modal',
                        item_list_name: heading?.textContent?.trim().substring(0, 120) || 'Cross-sell Recommendation',
                        item_list_location: window.location.pathname,
                        item_list_page_type: self.getPageType()
                    };
                }
            }
            const _ipRoot = U.getStorageJSON('msr_item_properties', {});
            const _tc = _ipRoot.item_urls || {};
            itemsToTrack.forEach(item => {
                if (item.product_id && _tc[item.product_id]?.tags && !item.tags) item.tags = _tc[item.product_id].tags;
                const itemId = item.variant_id || item.id;
                const addedQty = requestedQuantities[itemId] || 1;
                const itemWithCorrectQty = { ...item, quantity: addedQty };
                let itemSource = source;
                if (itemSource.action_source === 'cross_sell_modal' && isPdpMainProductItem(item)) {
                    itemSource = { action_source: 'pdp_main_buybox' };
                }
                if (itemSource.item_list_id) {
                    itemWithCorrectQty.item_list_id = itemSource.item_list_id;
                    itemWithCorrectQty.item_list_name = itemSource.item_list_name;
                    itemWithCorrectQty.item_list_location = itemSource.item_list_location;
                    itemWithCorrectQty.item_list_page_type = itemSource.item_list_page_type;
                    if (item.product_id) ListAttribution.save(item.product_id, itemSource.item_list_id, itemSource.item_list_name, itemSource.item_list_location);
                    if (item.handle) ListAttribution.save(item.handle, itemSource.item_list_id, itemSource.item_list_name, itemSource.item_list_location);
                }
                self.pushEvent('add_to_cart', {
                    items: [self.enrichItem(itemWithCorrectQty)],
                    action_source: itemSource.action_source
                });
            });
            self.updateCart().then(() => {
                cartSnapshot = JSON.stringify(self.cart?.items || []);
            });
        };
        if (!window._msrFetchPatched) {
            window._msrFetchPatched = true;
            const origFetch = window.fetch;
            window.fetch = function(url, opts) {
                const urlStr = typeof url === 'string' ? url : url?.url || url?.href || '';
                const isAdd = urlStr.includes('/cart/add');
                const requestedQuantities = (isAdd && opts?.body) ? parseAddBody(opts.body) : {};
                const xsSnapshot = isAdd ? snapshotCrossSell() : null;
                return origFetch.apply(this, arguments).then(response => {
                    if (response.ok && isAdd) {
                        response.clone().json().then(data => {
                            handleAddSuccess(data, requestedQuantities, xsSnapshot);
                        }).catch(() => {});
                    }
                    if (response.ok && (urlStr.includes('/cart/change') || urlStr.includes('/cart/update'))) {
                        setTimeout(checkCartChange, 100);
                    }
                    if (/\/search\/?.*\?.*q=/.test(urlStr) && !urlStr.includes('&requestFrom=msr')) {
                        const term = new URLSearchParams(urlStr.split('?')[1]).get('q');
                        if (term && !SearchManager.isInitialPageLoad(term)) {
                            SearchManager.track(term, (trackedTerm) => {
                                self.pushEvent('search', { search_term: trackedTerm });
                            });
                        }
                    }
                    return response;
                });
            };
        }
        if (!window._msrXhrPatched) {
            window._msrXhrPatched = true;
            const origOpen = XMLHttpRequest.prototype.open;
            const origSend = XMLHttpRequest.prototype.send;
            XMLHttpRequest.prototype.open = function(method, url) {
                this._msrUrl = typeof url === 'string' ? url : String(url || '');
                return origOpen.apply(this, arguments);
            };
            XMLHttpRequest.prototype.send = function(body) {
                const xhrUrl = this._msrUrl || '';
                const isAdd = xhrUrl.includes('/cart/add');
                const requestedQuantities = (isAdd && body) ? parseAddBody(body) : {};
                const xsSnapshot = isAdd ? snapshotCrossSell() : null;
                this.addEventListener('load', function() {
                    if (this.status < 200 || this.status >= 300) return;
                    if (isAdd) {
                        try {
                            const data = JSON.parse(this.responseText);
                            handleAddSuccess(data, requestedQuantities, xsSnapshot);
                        } catch (e) {}
                    }
                    if (xhrUrl.includes('/cart/change') || xhrUrl.includes('/cart/update')) {
                        setTimeout(checkCartChange, 100);
                    }
                });
                return origSend.apply(this, arguments);
            };
        }
    }
    initCartDrawer() {
        const self = this;
        const findDrawer = () => {
            const drawer = U.findLargestDrawer();
            if (drawer) return drawer;
            const minicartBtn = document.querySelector(MSR_CFG.SELECTORS.MINICART.join(','));
            const ariaControls = minicartBtn?.getAttribute('aria-controls');
            if (ariaControls) {
                const target = document.getElementById(ariaControls);
                if (target) return target;
            }
            return null;
        };
        const isDrawerVisible = (el) => {
            if (!el) return false;
            const style = getComputedStyle(el);
            return (
                !el.hasAttribute('hidden') &&
                el.getAttribute('aria-hidden') !== 'true' &&
                ('open' in el ? el.open !== false : true) &&
                style.display !== 'none' &&
                style.visibility !== 'hidden'
            );
        };
        let viewCartFired = false;
        let lastViewCartTime = 0;
        const VIEW_CART_THROTTLE_MS = 1500;
        let cartDrawerTrackedHandles = new Set();
        let cartDrawerPendingItems = [];
        let cartDrawerFlushTimeout = null;
        let cartDrawerInitTimeout = null;
        let cartDrawerListName = 'Cart Recommendations';
        let cartDrawerScrollListenersAttached = false;
        const CART_DRAWER_FLUSH_DELAY = 800;
        const collectVisibleCartDrawerItems = () => {
            const drawerEl = findDrawer();
            if (drawerEl && !isDrawerVisible(drawerEl)) return;
            const recContainer = document.querySelector(MSR_CFG.SELECTORS.CART_DRAWER_RECS.join(','));
            if (!recContainer) return;
            cartDrawerListName = U.getCartRecHeading(recContainer);
            const productLinks = recContainer.querySelectorAll(MSR_PRODUCT_LINK_SELECTOR);
            const handlePositions = new Map();
            let domIndex = 0;
            productLinks.forEach(link => {
                const match = link.getAttribute('href')?.match(MSR_CFG.REGEX.PRODUCT_URL);
                if (!match) return;
                const handle = match[1];
                if (!handlePositions.has(handle)) {
                    handlePositions.set(handle, domIndex);
                    domIndex++;
                }
            });
            const seenHandles = new Set();
            productLinks.forEach(link => {
                const match = link.getAttribute('href')?.match(MSR_CFG.REGEX.PRODUCT_URL);
                if (!match) return;
                const handle = match[1];
                if (seenHandles.has(handle)) return;
                seenHandles.add(handle);
                if (cartDrawerTrackedHandles.has(handle)) return;
                const card = link.closest('[class*="cart-recommendation"]') || link.closest(MSR_CFG.SELECTORS.PRODUCT_CARD) || link;
                if (!U.isInViewport(card)) return;
                cartDrawerTrackedHandles.add(handle);
                const title = card.querySelector('[class*="title"]')?.textContent?.trim() || handle;
                const priceText = card.querySelector('[class*="price"]')?.textContent?.trim();
                const price = priceText ? U.parsePrice(priceText) : 0;
                const cartDrawerLocation = self.getPageType() === 'cart' ? 'cart_page' : 'cart_drawer';
                cartDrawerPendingItems.push({
                    product_title: title,
                    handle: handle,
                    url: MSR_buildProductUrl(handle),
                    price: price,
                    final_price: price,
                    item_list_id: 'cart_drawer_recommendations',
                    item_list_name: cartDrawerListName,
                    item_list_location: cartDrawerLocation,
                    item_list_page_type: 'cart',
                    index: handlePositions.get(handle),
                    quantity: 1,
                    _needs_enrichment: true
                });
            });
            if (cartDrawerPendingItems.length > 0) {
                scheduleCartDrawerFlush();
            }
        };
        const scheduleCartDrawerFlush = () => {
            if (cartDrawerFlushTimeout) clearTimeout(cartDrawerFlushTimeout);
            cartDrawerFlushTimeout = setTimeout(() => {
                cartDrawerFlushTimeout = null;
                flushCartDrawerItems();
            }, CART_DRAWER_FLUSH_DELAY);
        };
        const flushCartDrawerItems = async () => {
            const drawerEl = findDrawer();
            if (drawerEl && !isDrawerVisible(drawerEl)) {
                cartDrawerPendingItems = [];
                return;
            }
            const items = [...cartDrawerPendingItems];
            cartDrawerPendingItems = [];
            if (items.length === 0) return;
            const listName = items[0].item_list_name;
            await _enrichItemsFromApi(items, true);
            items.sort((a, b) => a.index - b.index);
            self.pushEvent('view_item_list', {
                items: items,
                item_list_id: 'cart_drawer_recommendations',
                item_list_name: listName,
                item_list_location: self.getPageType() === 'cart' ? 'cart_page' : 'cart_drawer',
                item_list_page_type: 'cart'
            });
        };
        const attachCartDrawerScrollListeners = () => {
            if (cartDrawerScrollListenersAttached) return;
            const recContainer = document.querySelector(MSR_CFG.SELECTORS.CART_DRAWER_RECS.join(','));
            if (!recContainer) return;
            cartDrawerScrollListenersAttached = true;
            const scrollables = recContainer.querySelectorAll('scroll-carousel, [class*="carousel"], [class*="slider"], [class*="scroll"]');
            scrollables.forEach(el => {
                el.addEventListener('scroll', () => {
                    setTimeout(collectVisibleCartDrawerItems, 350);
                }, { passive: true });
            });
            recContainer.addEventListener('scroll', () => {
                setTimeout(collectVisibleCartDrawerItems, 350);
            }, { passive: true });
            recContainer.querySelectorAll('button, [role="button"], a[class*="arrow"], a[class*="nav"]').forEach(btn => {
                btn.addEventListener('click', () => {
                    setTimeout(collectVisibleCartDrawerItems, 350);
                    setTimeout(collectVisibleCartDrawerItems, 700);
                }, { passive: true });
            });
        };
        const initCartDrawerRecommendationTracking = () => {
            cartDrawerTrackedHandles = new Set();
            cartDrawerPendingItems = [];
            cartDrawerScrollListenersAttached = false;
            if (cartDrawerFlushTimeout) {
                clearTimeout(cartDrawerFlushTimeout);
                cartDrawerFlushTimeout = null;
            }
            cartDrawerInitTimeout = setTimeout(() => {
                cartDrawerInitTimeout = null;
                const drawerEl = findDrawer();
                if (drawerEl && !isDrawerVisible(drawerEl)) return;
                collectVisibleCartDrawerItems();
                attachCartDrawerScrollListeners();
            }, 500);
        };
        const fireDrawerViewCart = async () => {
            if (viewCartFired) return;
            if (Date.now() - lastViewCartTime < VIEW_CART_THROTTLE_MS) return;
            viewCartFired = true;
            lastViewCartTime = Date.now();
            window.MSR_cartDrawer = true;
            await self.updateCart();
            self.pushEvent('view_cart', {
                items: (self.cart?.items || []).map(i => self.enrichItem({...i})),
                cart_type: 'cart_drawer',
                cart_status: self.cart?.items?.length > 0 ? 'filled' : 'empty'
            });
            initCartDrawerRecommendationTracking();
        };
        const drawer = findDrawer();
        if (drawer) {
            this._cartDrawerEl = drawer;
            window.MSR_cartDrawer = isDrawerVisible(drawer);
            const observer = new MutationObserver(() => {
                const wasVisible = window.MSR_cartDrawer;
                const visible = isDrawerVisible(drawer);
                window.MSR_cartDrawer = visible;
                if (!wasVisible && visible) {
                    fireDrawerViewCart();
                }
                if (wasVisible && !visible) {
                    if (cartDrawerInitTimeout) { clearTimeout(cartDrawerInitTimeout); cartDrawerInitTimeout = null; }
                    if (cartDrawerFlushTimeout) { clearTimeout(cartDrawerFlushTimeout); cartDrawerFlushTimeout = null; }
                    cartDrawerPendingItems = [];
                    viewCartFired = false;
                }
            });
            observer.observe(drawer, {
                attributes: true,
                attributeFilter: ['class', 'aria-hidden', 'open', 'style', 'hidden']
            });
        }
        let recCollectDebounce = null;
        let activeRecContainer = null;
        let activeRecCardIO = null;
        let activeRecObs = null;
        const recSel = MSR_CFG.SELECTORS.CART_DRAWER_RECS.join(',');
        const detachFromRec = () => {
            if (activeRecCardIO) { activeRecCardIO.disconnect(); activeRecCardIO = null; }
            if (activeRecObs) { activeRecObs.disconnect(); activeRecObs = null; }
            activeRecContainer = null;
        };
        const attachToRec = (container) => {
            if (!container || container === activeRecContainer) return;
            detachFromRec();
            activeRecContainer = container;
            initCartDrawerRecommendationTracking();
            const setupCardObserver = () => {
                if (activeRecCardIO) activeRecCardIO.disconnect();
                const links = container.querySelectorAll(MSR_PRODUCT_LINK_SELECTOR);
                if (links.length === 0) return;
                activeRecCardIO = new IntersectionObserver((entries) => {
                    if (entries.some(e => e.isIntersecting && e.intersectionRatio >= 0.5)) {
                        if (recCollectDebounce) clearTimeout(recCollectDebounce);
                        recCollectDebounce = setTimeout(collectVisibleCartDrawerItems, 200);
                    }
                }, { threshold: 0.5 });
                links.forEach(link => activeRecCardIO.observe(link));
            };
            setupCardObserver();
            activeRecObs = new MutationObserver(() => {
                if (recCollectDebounce) clearTimeout(recCollectDebounce);
                recCollectDebounce = setTimeout(() => {
                    collectVisibleCartDrawerItems();
                    setupCardObserver();
                }, 200);
            });
            activeRecObs.observe(container, { childList: true, subtree: true });
        };
        const initialRec = document.querySelector(recSel);
        if (initialRec) attachToRec(initialRec);
        const bodyRecWatcher = new MutationObserver(() => {
            const currentRec = document.querySelector(recSel);
            if (currentRec && currentRec !== activeRecContainer) {
                attachToRec(currentRec);
            } else if (!currentRec && activeRecContainer && !document.contains(activeRecContainer)) {
                detachFromRec();
            }
        });
        bodyRecWatcher.observe(document.body, { childList: true, subtree: true });
        window.addEventListener('click', (e) => {
            if (viewCartFired) return;
            const minicartBtn = e.target.closest(MSR_CFG.SELECTORS.MINICART.join(','));
            if (!minicartBtn) return;
            const btnHref = minicartBtn.getAttribute('href') || '';
            if (/\/cart\/(change|update|add)/.test(btnHref)) return;
            const isToggle = minicartBtn.hasAttribute('aria-controls') || minicartBtn.hasAttribute('aria-expanded');
            if (!isToggle) {
                const drawerEl = findDrawer();
                if (drawerEl && isDrawerVisible(drawerEl) && drawerEl.contains(minicartBtn)) return;
                try {
                    const url = new URL(btnHref, location.origin);
                    if (/\/cart\/?$/.test(url.pathname) && !findDrawer()) return;
                } catch {}
            }
            fireDrawerViewCart();
        }, true);
    }
    initInstantSearch() {
        const self = this;
        const CONTAINER_SELECTOR = '[class*="instant-search"], [class*="predictive-search"], [class*="predictive-ultra"]';
        const FLUSH_DELAY = 600;
        const trackedKeys = new Set();
        let flushTimeout = null;
        let currentEnrichController = null;
        const isVisible = (el) => {
            if (!el) return false;
            const style = getComputedStyle(el);
            return style.display !== 'none' && style.visibility !== 'hidden' && el.offsetParent !== null;
        };
        const extractItems = (container) => {
            const productLinks = container.querySelectorAll(MSR_PRODUCT_LINK_SELECTOR);
            const handlePositions = new Map();
            let domIndex = 0;
            productLinks.forEach(link => {
                const match = link.getAttribute('href')?.match(MSR_CFG.REGEX.PRODUCT_URL);
                if (!match) return;
                const handle = match[1];
                if (!handlePositions.has(handle)) {
                    handlePositions.set(handle, domIndex);
                    domIndex++;
                }
            });
            const items = [];
            const seenHandles = new Set();
            productLinks.forEach(link => {
                const match = link.getAttribute('href')?.match(MSR_CFG.REGEX.PRODUCT_URL);
                if (!match) return;
                const handle = match[1];
                if (seenHandles.has(handle)) return;
                seenHandles.add(handle);
                const card = link.closest(MSR_CFG.SELECTORS.PRODUCT_CARD) || link;
                const title = card.querySelector('[class*="title"]')?.textContent?.trim() || handle;
                const priceText = card.querySelector('[class*="price"]')?.textContent?.trim();
                const price = priceText ? U.parsePrice(priceText) : 0;
                items.push({
                    product_title: title,
                    handle: handle,
                    url: MSR_buildProductUrl(handle),
                    price: price,
                    final_price: price,
                    item_list_id: 'instant_search',
                    item_list_name: 'Instant Search',
                    item_list_location: window.location.pathname,
                    item_list_page_type: self.getPageType(),
                    index: handlePositions.get(handle),
                    quantity: 1,
                    _needs_enrichment: true
                });
            });
            return items;
        };
        const getCurrentSearchTerm = () => {
            const inputs = document.querySelectorAll('input[name="q"], input[type="search"]');
            for (const input of inputs) {
                if (input.value && input.value.trim() && input.offsetParent !== null) {
                    return input.value.trim().toLowerCase();
                }
            }
            return '';
        };
        const flushInstantSearch = async () => {
            flushTimeout = null;
            if (currentEnrichController) currentEnrichController.abort();
            currentEnrichController = (typeof AbortController !== 'undefined') ? new AbortController() : null;
            const signal = currentEnrichController?.signal || null;
            const allContainers = document.querySelectorAll(CONTAINER_SELECTOR);
            if (allContainers.length === 0) return;
            const containers = [];
            for (const c of allContainers) {
                if (!isVisible(c)) continue;
                let isNested = false;
                for (const other of allContainers) {
                    if (other !== c && other.contains(c)) { isNested = true; break; }
                }
                if (!isNested) containers.push(c);
            }
            if (containers.length === 0) return;
            const items = [];
            const seenHandles = new Set();
            for (const container of containers) {
                for (const item of extractItems(container)) {
                    if (seenHandles.has(item.handle)) continue;
                    seenHandles.add(item.handle);
                    items.push(item);
                }
            }
            if (items.length === 0) return;
            const searchTerm = getCurrentSearchTerm();
            const dedupKey = searchTerm + '|' + items.map(i => i.handle).sort().join(',');
            if (trackedKeys.has(dedupKey)) return;
            trackedKeys.add(dedupKey);
            items.sort((a, b) => a.index - b.index);
            await _enrichItemsFromApi(items, true, signal);
            if (signal?.aborted) return;
            self.pushEvent('view_item_list', {
                items: items,
                item_list_id: 'instant_search',
                item_list_name: 'Instant Search',
                item_list_location: window.location.pathname,
                item_list_page_type: self.getPageType()
            });
        };
        const scheduleFlush = () => {
            if (flushTimeout) clearTimeout(flushTimeout);
            flushTimeout = setTimeout(flushInstantSearch, FLUSH_DELAY);
        };
        document.addEventListener('input', (e) => {
            const t = e.target;
            if (!t || typeof t.matches !== 'function') return;
            if (!t.matches('input[name="q"], input[type="search"]')) return;
            scheduleFlush();
        }, true);
    }
    initCheckout() {
        document.addEventListener('pointerdown', (e) => {
            const btn = e.target.closest(MSR_CFG.SELECTORS.CHECKOUT.join(','));
            if (!btn || this.flags.beginCheckout) return;
            this.flags.beginCheckout = true;
            this.pushEvent('begin_checkout', {
                items: (this.cart?.items || []).map(i => this.enrichItem({...i})),
                note: this.cart?.note
            });
            setTimeout(() => { this.flags.beginCheckout = false; }, 3000);
        });
    }
    initWishlist() {
        const self = this;
        const wishlistDebounce = new Map();
        const readWishlistState = (btn) => btn.classList.contains('swym-added') ||
                                          btn.classList.contains('is-active') ||
                                          btn.classList.contains('added') ||
                                          btn.getAttribute('aria-pressed') === 'true';
        const waitForWishlistFlip = (btn, initialState, timeoutMs = 2000) => new Promise(resolve => {
            const obs = new MutationObserver(() => {
                const newState = readWishlistState(btn);
                if (newState !== initialState) {
                    obs.disconnect();
                    clearTimeout(timer);
                    resolve(newState);
                }
            });
            obs.observe(btn, { attributes: true, attributeFilter: ['class', 'aria-pressed'] });
            const timer = setTimeout(() => {
                obs.disconnect();
                resolve(null);
            }, timeoutMs);
        });
        window.addEventListener('pointerup', (e) => {
            if (e.button !== 0) return;
            const btn = e.target.closest(MSR_CFG.SELECTORS.WISHLIST.join(','));
            if (!btn) return;
            const initialWishlistState = readWishlistState(btn);
            let productUrl;
            const btnUrl = btn.getAttribute('data-product-url');
            if (btnUrl) productUrl = btnUrl.split('?')[0];
            if (!productUrl) {
                const btnPid = btn.getAttribute('data-product-id');
                if (btnPid && btnPid.includes(MSR_PRODUCT_PATH)) {
                    try {
                        productUrl = new URL(btnPid, location.origin).pathname.split('?')[0];
                    } catch {
                        productUrl = btnPid.split('?')[0];
                    }
                }
            }
            if (!productUrl) {
                const gridItem = btn.closest(MSR_CFG.SELECTORS.GRID_ITEM);
                if (location.pathname.includes(MSR_PRODUCT_PATH)) {
                    productUrl = location.href.split('?')[0];
                } else if (gridItem && gridItem !== btn) {
                    const link = gridItem.querySelector(MSR_PRODUCT_LINK_SELECTOR);
                    if (link) productUrl = link.getAttribute('href').split('?')[0];
                }
            }
            if (!productUrl) return;
            if (wishlistDebounce.has(productUrl)) return;
            wishlistDebounce.set(productUrl, true);
            setTimeout(() => wishlistDebounce.delete(productUrl), 1000);
            let currentVariantId = null;
            if (location.pathname.includes(MSR_PRODUCT_PATH)) {
                const urlParams = new URLSearchParams(location.search);
                currentVariantId = urlParams.get('variant');
            }
            if (!currentVariantId) {
                const vid = btn.getAttribute('data-variant-id') || btn.closest('[data-variant-id]')?.getAttribute('data-variant-id');
                if (vid) currentVariantId = vid;
            }
            let wishlistGridItem = btn.closest('product-card, .product-card, [class*="product-card"]:has(a[href*="/products/"]), [class*="product-item"]:has(a[href*="/products/"]), .grid__item:has(a[href*="/products/"])');
            if (!wishlistGridItem) wishlistGridItem = btn.closest(MSR_CFG.SELECTORS.GRID_ITEM);
            const source = self.determineActionSource(btn);
            const currentPath = window.location.pathname;
            const currentPageType = self.getPageType();
            Promise.all([
                waitForWishlistFlip(btn, initialWishlistState),
                fetch(productUrl + '.json').then(r => r.json()).catch(() => null)
            ]).then(([newState, result]) => {
                if (newState === null) return;  // No state flip detected (auth modal, app reject, etc.) — skip event
                if (!result) return;
                const p = result.product;
                if (!p) return;
                if (!currentVariantId && wishlistGridItem) {
                    currentVariantId = U.getSelectedVariantIdFromCard(wishlistGridItem, p);
                }
                const item = U.buildProductItemFromJson(p, {}, currentVariantId);
                if (!item) return;
                if (item.compare_at_price && item.compare_at_price > item.price) {
                    self.cacheSaleData(item.variant_id, item.compare_at_price);
                }
                if (source.item_list_id) {
                    item.item_list_id = source.item_list_id;
                    item.item_list_name = source.item_list_name;
                    item.item_list_location = source.item_list_location;
                    item.item_list_page_type = source.item_list_page_type;
                } else {
                    const stored = ListAttribution.get(p.id, p.handle);
                    if (stored) {
                        item.item_list_id = stored.item_list_id;
                        item.item_list_name = stored.item_list_name;
                        item.item_list_location = currentPath;
                        item.item_list_page_type = currentPageType;
                    }
                }
                if (newState) {
                    self.pushEvent('add_to_wishlist', { items: [item] });
                } else {
                    self.pushEvent('remove_from_wishlist', { items: [item] });
                }
            }).catch(() => {});
        });
    }
    initProductSections() {
        {% if template contains 'collection' or template == 'search' %}
        return;
        {% endif %}
        const self = this;
        const trackedHandlesPerSection = new Map();
        const extractSectionItems = (sectionWrapper, sectionId, sectionTitle) => {
            const productLinks = sectionWrapper.querySelectorAll(MSR_PRODUCT_LINK_SELECTOR);
            const items = [];
            if (!trackedHandlesPerSection.has(sectionId)) {
                trackedHandlesPerSection.set(sectionId, new Set());
            }
            const sectionTrackedHandles = trackedHandlesPerSection.get(sectionId);
            const handlePositions = new Map();
            let domIndex = 0;
            productLinks.forEach(link => {
                const href = link.getAttribute('href');
                const match = href?.match(MSR_CFG.REGEX.PRODUCT_URL);
                if (!match) return;
                const handle = match[1];
                if (!handlePositions.has(handle)) {
                    handlePositions.set(handle, domIndex);
                    domIndex++;
                }
            });
            const seenHandles = new Set();
            productLinks.forEach(link => {
                const href = link.getAttribute('href');
                const match = href?.match(MSR_CFG.REGEX.PRODUCT_URL);
                if (!match) return;
                const handle = match[1];
                if (seenHandles.has(handle)) return;
                if (sectionTrackedHandles.has(handle)) return;
                let card = link.closest(MSR_CFG.SELECTORS.PRODUCT_CARD);
                if (card === link) {
                    card = link.parentElement?.closest('product-item, ' + MSR_CFG.SELECTORS.PRODUCT_CARD) || null;
                }
                if (!card) card = link.closest('li');
                if (!card) return;
                if (card.closest('line-item, [class*="line-item" i], [class*="cart-line" i], [data-cart-item]')) return;
                if (card.closest('cart-item, [class*="cart-item" i]:not([class*="recommendation" i]):not([class*="cross-sell" i]):not([class*="related" i])')) return;
                if (card.closest(MSR_CFG.SELECTORS.CART_DRAWER.join(','))) return;
                if (!U.isInViewport(card)) return;
                seenHandles.add(handle);
                sectionTrackedHandles.add(handle);
                const itemIndex = handlePositions.get(handle);
                let price = 0;
                let productTitle = handle;
                const jsonLd = card.querySelector('script[type="application/ld+json"]');
                if (jsonLd) {
                    try {
                        const ldData = JSON.parse(jsonLd.textContent);
                        if (ldData['@type'] === 'Product') {
                            price = parseFloat(ldData.offers?.price || 0);
                            productTitle = ldData.name || handle;
                        }
                    } catch (e) {}
                }
                const cardListName = U.findContainerHeading(card) || sectionTitle;
                items.push({
                    product_title: productTitle,
                    handle: handle,
                    url: MSR_buildProductUrl(handle),
                    price: U.toCents(price),
                    final_price: U.toCents(price),
                    item_list_id: sectionId,
                    item_list_name: cardListName,
                    item_list_location: window.location.pathname,
                    item_list_page_type: self.getPageType(),
                    index: itemIndex,
                    quantity: 1,
                    _needs_enrichment: price === 0
                });
            });
            return items;
        };
        const sectionTitles = new Map();
        const pendingItemsPerSection = new Map();
        let flushTimeout = null;
        const FLUSH_DELAY = 800;
        const flushPendingItems = async () => {
            const sections = Array.from(pendingItemsPerSection.entries());
            pendingItemsPerSection.clear();
            for (const [sectionId, items] of sections) {
                if (items.length === 0) continue;
                const sectionFallback = sectionTitles.get(sectionId) || sectionId;
                await _enrichItemsFromApi(items);
                items.forEach(i => delete i._needs_enrichment);
                items.sort((a, b) => a.index - b.index);
                const groups = new Map();
                items.forEach(item => {
                    const listName = item.item_list_name || sectionFallback;
                    if (!groups.has(listName)) groups.set(listName, []);
                    groups.get(listName).push(item);
                });
                for (const [listName, groupItems] of groups) {
                    self.pushEvent('view_item_list', {
                        items: groupItems,
                        item_list_id: groupItems[0]?.item_list_id || sectionId,
                        item_list_name: listName,
                        item_list_location: window.location.pathname,
                        item_list_page_type: self.getPageType()
                    });
                }
            }
        };
        const scheduleFlush = () => {
            if (flushTimeout) clearTimeout(flushTimeout);
            flushTimeout = setTimeout(() => {
                flushTimeout = null;
                flushPendingItems();
            }, FLUSH_DELAY);
        };
        const isExcludedSection = (sectionId) => {
            const lower = sectionId.toLowerCase();
            return MSR_CFG.EXCLUDED_SECTIONS.some(pattern => lower.includes(pattern));
        };
        const TAB_PANEL_SELECTOR = 'product-list, .product-list, .product-grid, ' +
            '.collection-products, [data-collection-products], ' +
            '.tab-pane, [role="tabpanel"]';
        const TAB_PANEL_OVERLAP_THRESHOLD = 0.8;
        const isPanelVisible = (panel) => {
            if (panel.hasAttribute('hidden')) return false;
            if (panel.getAttribute('aria-hidden') === 'true') return false;
            const cs = getComputedStyle(panel);
            if (cs.display === 'none') return false;
            if (cs.visibility === 'hidden') return false;
            if (parseFloat(cs.opacity) === 0) return false;
            const rect = panel.getBoundingClientRect();
            return rect.width > 0 && rect.height > 0;
        };
        const getPanelHandles = (panel) => {
            const handles = new Set();
            panel.querySelectorAll(MSR_PRODUCT_LINK_SELECTOR).forEach(link => {
                const m = link.getAttribute('href')?.match(MSR_CFG.REGEX.PRODUCT_URL);
                if (m) handles.add(m[1]);
            });
            return handles;
        };
        const jaccardIndex = (a, b) => {
            if (a.size === 0 && b.size === 0) return 1;
            let inter = 0;
            for (const v of a) if (b.has(v)) inter++;
            const union = a.size + b.size - inter;
            return union === 0 ? 0 : inter / union;
        };
        const cssEsc = (s) => (typeof CSS !== 'undefined' && CSS.escape) ? CSS.escape(s) : s;
        const sanitizeListName = (s) => s ? s.replace(/\s+/g, ' ').trim().slice(0, 100) : '';
        const resolvePanelListId = (panel) => {
            const base = (MSR_SHOP.routes?.collections || '/collections').replace(/\/$/, '');
            const baseEsc = base.replace(/[.*+?^${}()|[\]\\]/g, '\\$&');
            const re = new RegExp(baseEsc + '/([^/?#]+)');
            const cardSel = 'product-card, product-item, .product-card, .product-item, [data-product-id]';
            const links = panel.querySelectorAll('a[href*="' + base + '/"]');
            for (const link of links) {
                if (link.closest(cardSel)) continue;
                const href = link.getAttribute('href');
                const m = href && href.match(re);
                if (m && m[1] && m[1] !== 'all') return m[1];
            }
            if (panel.id) return U.normalizeSectionId(panel.id);
            return null;
        };
        const resolvePanelListName = (panel, section) => {
            if (panel.id) {
                const idEsc = cssEsc(panel.id);
                const selectors = [
                    '[aria-controls="' + idEsc + '"]',
                    '[data-target="#' + idEsc + '"]',
                    '[data-tab="' + idEsc + '"]',
                    'a[href="#' + idEsc + '"]'
                ];
                for (const sel of selectors) {
                    try {
                        const tab = section.querySelector(sel);
                        if (tab && !panel.contains(tab)) {
                            const text = sanitizeListName(tab.textContent || tab.getAttribute('aria-label'));
                            if (text) return text;
                        }
                    } catch (e) {}
                }
            }
            const heading = panel.querySelector('h2, h3, h4, .heading, [class*="heading"]');
            if (heading) {
                const text = sanitizeListName(heading.textContent);
                if (text) return text;
            }
            return null;
        };
        const discoverPanels = (section) => {
            let cands = Array.from(section.querySelectorAll(TAB_PANEL_SELECTOR));
            cands = cands.filter(c => !cands.some(o => o !== c && o.contains(c)));
            cands = cands.filter(c => getPanelHandles(c).size >= 2);
            const skipSel = MSR_CFG.SELECTORS.CART_DRAWER.join(',') +
                ', [role="dialog"], [class*="modal" i], [class*="cross-sell" i]';
            cands = cands.filter(c => !c.closest(skipSel));
            if (cands.length < 2) return null;
            const handlesPerPanel = cands.map(getPanelHandles);
            let minJac = 1;
            for (let i = 0; i < handlesPerPanel.length; i++) {
                for (let j = i + 1; j < handlesPerPanel.length; j++) {
                    const j2 = jaccardIndex(handlesPerPanel[i], handlesPerPanel[j]);
                    if (j2 < minJac) minJac = j2;
                }
            }
            if (minJac >= TAB_PANEL_OVERLAP_THRESHOLD) return null;
            return cands.map((el, i) => ({
                element: el,
                index: i,
                visible: isPanelVisible(el),
                listId: resolvePanelListId(el),
                listName: resolvePanelListName(el, section),
                handleCount: handlesPerPanel[i].size
            }));
        };
        const tabbedSections = new WeakSet();
        const tabbedDebugState = new WeakMap();
        const inspectedNonTabbed = new WeakSet();
        const collectTabbedSection = (section) => {
            let panels = null;
            try { panels = discoverPanels(section); } catch (e) {
                if (window.MSR_DEBUG_TABS) console.warn('[MSR Tabs] discoverPanels threw', section.id, e);
                return false;
            }
            const sectionId = U.normalizeSectionId(section.id.replace('shopify-section-', ''));
            if (!panels) {
                if (window.MSR_DEBUG_TABS && !inspectedNonTabbed.has(section)) {
                    inspectedNonTabbed.add(section);
                    console.log('[MSR Tabs] not-tabbed:', sectionId);
                }
                return false;
            }
            const visibleList = panels.filter(p => p.visible);
            if (window.MSR_DEBUG_TABS) {
                const lastVisible = tabbedDebugState.get(section);
                const currentVisible = visibleList.length === 1 ? visibleList[0].index : -visibleList.length;
                if (lastVisible !== currentVisible) {
                    tabbedDebugState.set(section, currentVisible);
                    console.group('[MSR Tabs] ' + sectionId + ' — ' + panels.length + ' panels, ' + visibleList.length + ' visible');
                    console.table(panels.map(p => ({
                        idx: p.index, visible: p.visible,
                        item_list_id: p.listId, item_list_name: p.listName,
                        handles: p.handleCount, panel_id: p.element.id || '(no id)'
                    })));
                    if (visibleList.length === 0) console.warn('No visible panel — initial-state race');
                    if (visibleList.length > 1) console.warn('Multiple visible panels — fail-closed');
                    console.groupEnd();
                }
            }
            if (visibleList.length !== 1) return false;
            tabbedSections.add(section);
            const visible = visibleList[0];
            const panelKey = sectionId + '::panel-' + visible.index;
            const listId = visible.listId || panelKey;
            const listName = visible.listName || sectionTitles.get(sectionId) || sectionId;
            if (!sectionTitles.has(panelKey)) sectionTitles.set(panelKey, listName);
            const items = extractSectionItems(visible.element, panelKey, listName);
            if (items.length === 0) return true;
            items.forEach(i => {
                i.item_list_id = listId;
                i.item_list_name = listName;
            });
            if (!pendingItemsPerSection.has(panelKey)) pendingItemsPerSection.set(panelKey, []);
            pendingItemsPerSection.get(panelKey).push(...items);
            scheduleFlush();
            return true;
        };
        const collectSectionItems = (sectionWrapper) => {
            const sectionId = U.normalizeSectionId(sectionWrapper.id.replace('shopify-section-', ''));
            if (isExcludedSection(sectionId)) return;
            if (sectionId === 'main') return;
            const cartDrawerSel = MSR_CFG.SELECTORS.CART_DRAWER.join(',');
            if (sectionWrapper.matches(cartDrawerSel) ||
                sectionWrapper.closest(cartDrawerSel) ||
                sectionWrapper.querySelector(cartDrawerSel)) return;
            if (!U.hasMultipleProducts(sectionWrapper)) return;
            {% if template contains 'product' %}
            if (sectionId === 'product' || sectionId === 'product-template' ||
                (sectionId.includes('main') && sectionId.includes('product'))) return;
            {% endif %}
            if (collectTabbedSection(sectionWrapper)) return;
            if (!sectionTitles.has(sectionId)) {
                sectionTitles.set(sectionId, U.getSectionTitle(sectionWrapper, sectionId));
            }
            const sectionTitle = sectionTitles.get(sectionId);
            const items = extractSectionItems(sectionWrapper, sectionId, sectionTitle);
            if (items.length === 0) return;
            if (!pendingItemsPerSection.has(sectionId)) {
                pendingItemsPerSection.set(sectionId, []);
            }
            pendingItemsPerSection.get(sectionId).push(...items);
            scheduleFlush();
        };
        const findProductSections = () => {
            const allShopifySections = document.querySelectorAll('[id^="shopify-section-"]');
            return Array.from(allShopifySections).filter(section => {
                const secId = U.normalizeSectionId(section.id.replace('shopify-section-', ''));
                if (isExcludedSection(secId)) return false;
                return U.hasMultipleProducts(section);
            });
        };
        const checkAllSections = () => {
            const sections = findProductSections();
            sections.forEach(section => collectSectionItems(section));
        };
        let scrollTimeout = null;
        const handleScroll = () => {
            if (scrollTimeout) clearTimeout(scrollTimeout);
            scrollTimeout = setTimeout(() => {
                scrollTimeout = null;
                checkAllSections();
            }, 500);
        };
        document.addEventListener('visibilitychange', () => {
            if (document.visibilityState === 'hidden' && pendingItemsPerSection.size > 0) {
                if (flushTimeout) { clearTimeout(flushTimeout); flushTimeout = null; }
                flushPendingItems();
            }
        });
        window.addEventListener('beforeunload', () => {
            if (pendingItemsPerSection.size > 0) flushPendingItems();
        });
        window.addEventListener('scroll', handleScroll, { passive: true });
        const scrollableContainersWithListeners = new WeakSet();
        const sliderButtonsWithListeners = new WeakSet();
        const findScrollableContainersInSections = () => {
            const containers = [];
            const sections = document.querySelectorAll('[id^="shopify-section-"]');
            sections.forEach(section => {
                const candidates = section.querySelectorAll(
                    MSR_CFG.SELECTORS.SLIDER_PATTERNS + ', ' +
                    MSR_CFG.SELECTORS.SLIDER_CLASSES.map(cls => '.' + cls).join(', ')
                );
                candidates.forEach(el => {
                    if (el.scrollWidth > el.clientWidth) {
                        containers.push(el);
                    }
                });
                const overflowCandidates = section.querySelectorAll('[style*="overflow"], [class*="scroll"], [class*="swiper"], [class*="flickity"]');
                overflowCandidates.forEach(el => {
                    if (el.scrollWidth > el.clientWidth && !containers.includes(el)) {
                        containers.push(el);
                    }
                });
            });
            return containers;
        };
        const attachScrollerListeners = () => {
            const scrollableContainers = findScrollableContainersInSections();
            scrollableContainers.forEach(scroller => {
                if (scrollableContainersWithListeners.has(scroller)) return;
                scrollableContainersWithListeners.add(scroller);
                scroller.addEventListener('scroll', handleScroll, { passive: true });
            });
            document.querySelectorAll('button, [role="button"], a[class*="arrow"], a[class*="nav"], .prev-next-button').forEach(button => {
                if (sliderButtonsWithListeners.has(button)) return;
                const buttonClasses = button.className || '';
                const isLikelySliderButton =
                    button.closest('[class*="slider"]') ||
                    button.closest('[class*="carousel"]') ||
                    button.closest('[class*="scroller"]') ||
                    button.closest('[class*="swiper"]') ||
                    button.closest('[class*="flickity"]') ||
                    button.closest('.product-list') ||
                    button.closest('.featured-collections') ||
                    /prev|next|arrow|nav/i.test(buttonClasses) ||
                    button.classList.contains('prev-next-button') ||
                    button.classList.contains('product-list__arrow') ||
                    button.hasAttribute('data-action');
                if (isLikelySliderButton) {
                    sliderButtonsWithListeners.add(button);
                    button.addEventListener('click', () => {
                        setTimeout(handleScroll, 350);
                        setTimeout(handleScroll, 700);
                    }, { passive: true });
                }
            });
        };
        attachScrollerListeners();
        setTimeout(() => {
            attachScrollerListeners();
            checkAllSections();
        }, 500);
        setTimeout(() => {
            attachScrollerListeners();
            checkAllSections();
        }, 1500);
        const slidersWithMutationObservers = new WeakSet();
        const observeTransformSliders = () => {
            const transformSliders = findScrollableContainersInSections();
            transformSliders.forEach(slider => {
                if (slidersWithMutationObservers.has(slider)) return;
                slidersWithMutationObservers.add(slider);
                const sliderObserver = new MutationObserver((mutations) => {
                    let hasRelevantChange = false;
                    mutations.forEach(mutation => {
                        if (mutation.type === 'attributes' &&
                            (mutation.attributeName === 'style' || mutation.attributeName === 'transform')) {
                            hasRelevantChange = true;
                        }
                        if (mutation.type === 'attributes' && mutation.attributeName === 'class') {
                            hasRelevantChange = true;
                        }
                    });
                    if (hasRelevantChange) {
                        handleScroll();
                    }
                });
                sliderObserver.observe(slider, {
                    attributes: true,
                    attributeFilter: ['style', 'transform', 'class'],
                    subtree: true
                });
            });
        };
        observeTransformSliders();
        setTimeout(observeTransformSliders, 500);
        setTimeout(observeTransformSliders, 1500);
        this.observeDynamicSections(checkAllSections, attachScrollerListeners);
    }
    observeDynamicSections(checkAllSections, attachScrollerListeners) {
        const mutationObserver = new MutationObserver((mutations) => {
            let hasNewSections = false;
            mutations.forEach(mutation => {
                if (mutation.type !== 'childList' || mutation.addedNodes.length === 0) return;
                mutation.addedNodes.forEach(node => {
                    if (node.nodeType !== 1) return;
                    const section = node.closest?.('[id^="shopify-section-"]') ||
                                   (node.id?.startsWith('shopify-section-') ? node : null);
                    if (section) {
                        if (U.hasMultipleProducts(section)) hasNewSections = true;
                    }
                });
            });
            if (hasNewSections) {
                setTimeout(() => {
                    if (attachScrollerListeners) attachScrollerListeners();
                    handleScroll();
                }, 100);
            }
        });
        const dynamicSections = document.querySelectorAll(
            '.product-recommendations, [data-url*="/recommendations/"], ' +
            '[id^="shopify-section-"][id*="recommend"], [id^="shopify-section-"][id*="related"], ' +
            '[id^="shopify-section-"][id*="recently"]'
        );
        dynamicSections.forEach(section => {
            mutationObserver.observe(section, { childList: true, subtree: true });
        });
        const mainContent = document.querySelector('main, #MainContent, [role="main"]');
        if (mainContent) {
            mutationObserver.observe(mainContent, { childList: true, subtree: false });
        }
    }
    initQuickView() {
        const self = this;
        const findCard = (el) => {
            const ce = el.closest('product-item, product-card');
            if (ce) return ce;
            let node = el.parentElement;
            while (node && node !== document.body) {
                if (node.matches?.(MSR_CFG.SELECTORS.GRID_ITEM) && node.querySelector(MSR_PRODUCT_LINK_SELECTOR)) return node;
                node = node.parentElement;
            }
            return null;
        };
        const fireQuickViewItem = (gridItem) => {
            const link = gridItem.querySelector(MSR_PRODUCT_LINK_SELECTOR);
            if (!link) return;
            const productUrl = link.getAttribute('href').split('?')[0];
            fetch(productUrl + '.json')
                .then(r => r.json())
                .then(result => {
                    const p = result.product;
                    if (!p) return;
                    const cardVariantId = U.getSelectedVariantIdFromCard(gridItem, p);
                    let variant = p.variants?.[0];
                    if (cardVariantId && p.variants?.length > 1) {
                        const matched = p.variants.find(v => String(v.id) === cardVariantId);
                        if (matched) variant = matched;
                    }
                    const item = U.buildProductItemFromJson(p, {
                        compare_at_price: (variant?.compare_at_price && U.toCents(variant.compare_at_price) > U.toCents(variant?.price))
                            ? U.toCents(variant.compare_at_price)
                            : undefined,
                        variant_title: variant?.title !== 'Default Title' ? variant?.title : undefined,
                        sku: variant?.sku
                    }, cardVariantId);
                    if (!item) return;
                    self.quickViewData = { item, variants: p.variants };
                })
                .catch(() => {});
        };
        document.addEventListener('pointerdown', (e) => {
            const btn = e.target.closest(MSR_CFG.SELECTORS.QUICK_VIEW.join(','));
            if (!btn) return;
            const gridItem = findCard(btn);
            if (!gridItem) return;
            fireQuickViewItem(gridItem);
        });
        document.addEventListener('pointerdown', (e) => {
            if (e.target.closest(MSR_CFG.SELECTORS.QUICK_VIEW.join(','))) return;
            const trigger = e.target.closest('[aria-controls]');
            if (!trigger) return;
            const targetId = trigger.getAttribute('aria-controls');
            if (!targetId) return;
            const target = document.getElementById(targetId);
            if (!target) return;
            const isQuickView = target.matches(
                'quick-buy-drawer, quick-buy-popover, quick-view, ' +
                '[class*="quick-buy" i], [class*="quick-view" i], [class*="quickview" i]'
            );
            if (!isQuickView) return;
            const gridItem = findCard(trigger);
            if (!gridItem) return;
            fireQuickViewItem(gridItem);
        });
        document.addEventListener('pointerdown', (e) => {
            if (!self.quickViewData) return;
            const btn = e.target.closest(MSR_CFG.SELECTORS.DIRECT_CHECKOUT.join(','));
            if (!btn) return;
            const form = btn.closest('form[action*="/cart/add"]');
            if (!form) return;
            const vid = parseInt(form.querySelector('input[name="id"]')?.value);
            const qty = parseInt(form.querySelector('input[name="quantity"]')?.value || 1);
            const variant = self.quickViewData.variants.find(v => v.id === vid);
            if (!variant || !variant.available) return;
            const item = { ...self.quickViewData.item };
            item.variant_id = vid;
            item.variant_title = variant.title;
            item.price = U.toCents(variant.price);
            item.final_price = U.toCents(variant.price);
            item.quantity = qty;
            self.pushEvent('add_to_cart', {
                items: [item],
                action_source: 'quick_view_modal'
            });
            self.pushEvent('begin_checkout', { items: [item] });
        });
    }
    initSelectItem() {
        const self = this;
        let lastClick = { slug: null, time: 0 };
        const productCache = {};
        {% if template contains 'collection' %}
        const listId = {{ collection.id | json }};
        const listName = {{ collection.title | json }};
        {% elsif template == 'search' %}
        const listId = 'search_results';
        const listName = 'Search Results';
        {% else %}
        const listId = null;
        const listName = null;
        {% endif %}
        const fetchProductData = (slug, href, finalListId, finalListName, clickedIndex, listLocation, listPageType) => {
            const extra = { handle: slug, url: href, item_list_id: finalListId, item_list_name: finalListName, item_list_location: listLocation, item_list_page_type: listPageType };
            if (productCache[slug]) return Promise.resolve(productCache[slug]);
            return fetch((window.Shopify?.routes?.root || '/') + `products/${slug}.json`)
                .then(r => r.ok ? r.json() : Promise.reject())
                .then(data => {
                    const product = data?.product;
                    if (product?.id && finalListId) {
                        ListAttribution.save(product.id, finalListId, finalListName, listLocation, clickedIndex, listPageType);
                    }
                    const item = U.buildProductItemFromJson(product, extra) || { ...extra, quantity: 1 };
                    productCache[slug] = { item, product };
                    return { item, product };
                })
                .catch(() => ({ item: { ...extra, quantity: 1 }, product: null }));
        };
        document.addEventListener('click', (e) => {
            if (e.target.closest('.wishlist-button, [data-wishlist]')) return;
            const link = e.target.closest(MSR_PRODUCT_LINK_SELECTOR);
            if (!link) return;
            const href = link.getAttribute('href');
            const match = href?.match(MSR_CFG.REGEX.PRODUCT_URL);
            const slug = match?.[1];
            if (!slug) return;
            const now = Date.now();
            if (lastClick.slug === slug && now - lastClick.time < 500) return;
            lastClick = { slug, time: now };
            let sectionListId = listId;
            let sectionListName = listName;
            let listLocation = window.location.pathname;
            let listPageType = self.getPageType();
            let isCartRec = false;
            const cdRec = link.closest(MSR_CFG.SELECTORS.CART_DRAWER_RECS.join(','));
            if (cdRec && link.closest(MSR_CFG.SELECTORS.CART_DRAWER.join(','))) {
                sectionListId = 'cart_drawer_recommendations';
                sectionListName = U.getCartRecHeading(cdRec);
                listLocation = self.getPageType() === 'cart' ? 'cart_page' : 'cart_drawer';
                listPageType = 'cart';
                isCartRec = true;
            }
            const sectionContainer = !isCartRec && link.closest('[data-list-id], [data-collection-id], [data-section-id]');
            if (sectionContainer) {
                sectionListId = U.normalizeSectionId(sectionContainer.dataset.listId || sectionContainer.dataset.collectionId || sectionContainer.dataset.sectionId);
                sectionListName = sectionContainer.dataset.listName || sectionContainer.dataset.collectionTitle || sectionContainer.dataset.sectionName || U.getSectionTitle(sectionContainer, sectionListId);
            }
            if (!isCartRec && !sectionListId && !listId) {
                const shopifySection = link.closest('[id^="shopify-section-"]');
                if (shopifySection) {
                    if (!U.hasMultipleProducts(shopifySection)) return;
                    const candidateId = U.normalizeSectionId(shopifySection.id.replace('shopify-section-', ''));
                    if (candidateId === 'main') return;
                    const candidateLower = candidateId.toLowerCase();
                    if (MSR_CFG.EXCLUDED_SECTIONS.some(pattern => candidateLower.includes(pattern))) return;
                    sectionListId = candidateId;
                    sectionListName = U.findContainerHeading(link);
                    if (!sectionListName) {
                        let sectionHeading = null;
                        for (const selector of MSR_CFG.SELECTORS.SECTION_TITLE) {
                            const heading = shopifySection.querySelector(selector);
                            if (heading) {
                                const isInsideProductCard = heading.closest('.product-card, .product-item, .card-product, .product, [class*="product-card"], [class*="product-item"], .card, article, .grid__item ' + MSR_PRODUCT_LINK_SELECTOR);
                                if (!isInsideProductCard) {
                                    sectionHeading = heading;
                                    break;
                                }
                            }
                        }
                        sectionListName = sectionHeading?.textContent?.trim() || U.getSectionTitle(shopifySection, sectionListId);
                    }
                }
            }
            if (!sectionListId) return;
            const finalListId = sectionListId;
            const finalListName = sectionListName || '';
            const clickedGridItem = link.closest(MSR_CFG.SELECTORS.GRID_ITEM);
            let clickedIndex;
            try {
                const parent = clickedGridItem?.parentElement;
                if (parent) {
                    const pos = Array.prototype.indexOf.call(parent.children, clickedGridItem);
                    if (pos >= 0) clickedIndex = pos;
                }
            } catch (e) {}
            ListAttribution.save(slug, finalListId, finalListName, listLocation, clickedIndex, listPageType);
            fetchProductData(slug, href, finalListId, finalListName, clickedIndex, listLocation, listPageType).then(result => {
                const item = { ...result.item };
                if (clickedIndex !== undefined && item.index === undefined) item.index = clickedIndex;
                const productData = result.product;
                if (clickedGridItem && productData) {
                    const cardVid = U.getSelectedVariantIdFromCard(clickedGridItem, productData);
                    if (cardVid) {
                        const sv = productData.variants.find(v => String(v.id) === cardVid);
                        if (sv) {
                            item.variant_id = sv.id;
                            item.sku = sv.sku || undefined;
                            item.variant_title = sv.title !== 'Default Title' ? sv.title : undefined;
                            item.price = U.toCents(sv.price);
                            item.final_price = U.toCents(sv.price);
                            item.available = sv.available !== false;
                            let img = sv.featured_image?.src || '';
                            if (img) {
                                img = img.replace(/^https?:?\/\/[^\/]+|^\/\/[^\/]+/, '');
                                img = img.replace(/^\/s\/files\/\d+\/\d+\/\d+\/\d+\//, '/cdn/shop/');
                                item.image = img;
                            }
                        }
                    }
                }
                self.pushEvent('select_item', {
                    items: [item],
                    item_list_id: finalListId,
                    item_list_name: finalListName,
                    item_list_location: listLocation,
                    item_list_page_type: listPageType
                });
            });
        });
    }
    initForms() {
        const self = this;
        try {
            const pending = sessionStorage.getItem('msr_pending_form_event');
            if (pending) {
                sessionStorage.removeItem('msr_pending_form_event');
                const data = JSON.parse(pending);
                if (data.email) {
                    self.storeEmail(data.email);
                }
                self.pushEvent(data.event, data);
            }
        } catch (e) { _msrWarn('initForms.pending', e); }
        document.addEventListener('submit', (e) => {
            const form = e.target;
            if (form.action?.includes('/cart/add')) return;
            const formType = FormDetector.getType(form);
            if (formType === 'newsletter') {
                const email = form.querySelector('input[type="email"]')?.value?.trim();
                try {
                    const _pendingEvent = { event: 'sign_up', action_source: 'newsletter' };
                    if (!MSR_CFG.PRIVACY_MODE || U.getConsent().marketing) { _pendingEvent.email = email || null; }
                    sessionStorage.setItem('msr_pending_form_event', JSON.stringify(_pendingEvent));
                } catch (e) { _msrWarn('form.newsletter', e); }
                return;
            }
            if (formType === 'contact') {
                const email = form.querySelector('input[type="email"]')?.value?.trim();
                try {
                    const _pendingEvent = { event: 'generate_lead', action_source: 'contact_form' };
                    if (!MSR_CFG.PRIVACY_MODE || U.getConsent().marketing) { _pendingEvent.email = email || null; }
                    sessionStorage.setItem('msr_pending_form_event', JSON.stringify(_pendingEvent));
                } catch (e) { _msrWarn('form.contact', e); }
                return;
            }
            if (formType === 'register') {
                const email = form.querySelector('input[type="email"], input[name="customer[email]"]')?.value?.trim();
                try {
                    const _pendingEvent = { event: 'sign_up', action_source: 'registration' };
                    if (!MSR_CFG.PRIVACY_MODE || U.getConsent().marketing) { _pendingEvent.email = email || null; }
                    sessionStorage.setItem('msr_pending_form_event', JSON.stringify(_pendingEvent));
                } catch (e) { _msrWarn('form.register', e); }
            }
        });
    }
    initKlaviyo() {
        const self = this;
        window.addEventListener('klaviyoForms', (e) => {
            if (e.detail?.type !== 'submit') return;
            const meta = e.detail.metaData || {};
            const email = meta.$email || meta.email;
            if (email) {
                self.storeEmail(email);
            }
            self.pushEvent('sign_up', {
                action_source: 'newsletter'
            });
        });
    }
    storeEmail(email) {
        if (!email || !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) return;
        const normalized = email.trim().toLowerCase();
        try {
            if (!MSR_CFG.PRIVACY_MODE || U.getConsent().marketing) {
                const up = _msrReadStoredJSON('msr_user_properties') || {};
                up.email = normalized;
                U.setSync('msr_user_properties', JSON.stringify(up));
            }
        } catch (e) { _msrWarn('storeEmail', e); }
    }
    initLogin() {
        {% unless template.name == 'customers/login' %}
        if (!location.href.includes('/account/login') && !location.href.includes('/customer_accounts/')) return;
        {% endunless %}
        document.addEventListener('submit', (e) => {
            const form = e.target.closest('[action="/account/login"], [action="/account/login/"], [action*="/account/login"], [action*="/customer_accounts/"]');
            if (!form || this.flags.loginTracked) return;
            this.flags.loginTracked = true;
            const email = form.querySelector('input[type="email"], input[name="customer[email]"]')?.value?.trim();
            if (email) {
                this.storeEmail(email);
            }
            this.pushEvent('login');
        });
    }
    listenForConsent() {
        document.addEventListener('visitorConsentCollected', (event) => {
            if (!MSR_CFG.PRIVACY_MODE) return;
            U._consentCollected = true;
            const cp = window.Shopify?.customerPrivacy;
            const detail = event.detail || {};
            const readBool = (apiFn, key1, key2) => {
                if (cp && typeof cp[apiFn] === 'function') return cp[apiFn]() === true;
                if (detail[key1] !== undefined) return detail[key1] === true;
                if (key2 && detail[key2] !== undefined) return detail[key2] === true;
                return false;
            };
            let saleOfData = true;
            if (cp && typeof cp.saleOfDataAllowed === 'function') saleOfData = cp.saleOfDataAllowed() !== false;
            else if (detail.saleOfDataAllowed !== undefined) saleOfData = detail.saleOfDataAllowed !== false;
            const consent = {
                analytics:   readBool('analyticsProcessingAllowed',   'analyticsAllowed',   'analyticsProcessingAllowed'),
                marketing:   readBool('marketingAllowed',             'marketingAllowed',   null),
                preferences: readBool('preferencesProcessingAllowed', 'preferencesAllowed', 'preferencesProcessingAllowed'),
                saleOfData,
                _decided: true
            };
            _msrUpdateConsentState(consent, false);
            _msrCleanupStorage(consent);
            if (typeof window._msr_basic_pending_start === 'function' && (consent.analytics || consent.marketing)) {
                window._msr_basic_pending_start();
                delete window._msr_basic_pending_start;
            }
        });
        setTimeout(() => {
            if (!MSR_CFG.PRIVACY_MODE) return;
            if (!window.Shopify?.customerPrivacy &&
                !window._msr_consent_update_fired &&
                (_msrReadStoredJSON('msr_consent') || {}).collected === true) {
                U._consentCollected = true;
                const consent = U.getConsent();
                _msrUpdateConsentState(consent, false);
                if (typeof window._msr_basic_pending_start === 'function' && (consent.analytics || consent.marketing)) {
                    window._msr_basic_pending_start();
                    delete window._msr_basic_pending_start;
                }
            }
        }, 500);
    }
}
    const _initTracker = () => {
        if (document.readyState === 'loading') {
            document.addEventListener('DOMContentLoaded', () => new MSRTracker());
        } else {
            new MSRTracker();
        }
    };
    if (document.prerendering) {
        document.addEventListener('prerenderingchange', _initTracker, { once: true });
    } else {
        _initTracker();
    }
    window.getPageType = () => {
        const tracker = window.MSR?.tracker;
        return tracker ? tracker.getPageType() : 'other';
    };
    </script>
