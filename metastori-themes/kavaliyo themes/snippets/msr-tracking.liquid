        if (data.total_results_count !== undefined) ctx.total_results_count = data.total_results_count;
        if (data.results_page !== undefined) ctx.results_page = data.results_page;
        if (data.applied_filters_count !== undefined) ctx.applied_filters_count = data.applied_filters_count;
        if (data.applied_filters !== undefined) ctx.applied_filters = data.applied_filters;
        if (event === 'view_item_list' && data.item_list_id === 'search_results') {
            if (data.search_id !== undefined) ctx.search_id = data.search_id;
