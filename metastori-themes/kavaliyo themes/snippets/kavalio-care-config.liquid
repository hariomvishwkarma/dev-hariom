{%- liquid
  assign kavalio_care_enabled = settings.show_kavalio_care
  assign kavalio_care_auto_add = true
  if settings.auto_add_kavalio_care == false
    assign kavalio_care_auto_add = false
  endif

  assign kavalio_care_show_cart_box = true
  if settings.show_kavalio_care_cart_box == false
    assign kavalio_care_show_cart_box = false
  endif

  assign kavalio_care_product_id = null
  assign kavalio_care_variant_id = null
  if kavalio_care_enabled and settings.kavalio_care_product != blank
    assign kavalio_care_product_id = settings.kavalio_care_product.id
    assign kavalio_care_variant_id = settings.kavalio_care_product.selected_or_first_available_variant.id
  endif
-%}
<script>
  window.__KAVALIO_CARE_SETTINGS = {
    show: {{ kavalio_care_enabled | json }},
    autoAdd: {{ kavalio_care_auto_add | json }},
    showCartBox: {{ kavalio_care_show_cart_box | json }},
    productId: {{ kavalio_care_product_id | json }},
    variantId: {{ kavalio_care_variant_id | json }}
  };

  if (window.KavalioCare && typeof window.KavalioCare.applySettings === "function") {
    window.KavalioCare.applySettings(window.__KAVALIO_CARE_SETTINGS);
  }
</script>
