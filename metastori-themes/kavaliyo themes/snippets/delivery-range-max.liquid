{% if range1 == blank or range1 == nil %}
  {{ range2 }}
{% elsif range2 == blank or range2 == nil %}
  {{ range1 }}
{% else %}
  {% assign parts1 = range1 | split: '-' %}
  {% assign parts2 = range2 | split: '-' %}
  {% if parts1.size >= 2 and parts2.size >= 2 %}
    {% assign high1 = parts1 | last | times: 1 %}
    {% assign high2 = parts2 | last | times: 1 %}
    {% if high1 > high2 %}
      {{ range1 }}
    {% elsif high2 > high1 %}
      {{ range2 }}
    {% else %}
      {% assign low1 = parts1 | first | times: 1 %}
      {% assign low2 = parts2 | first | times: 1 %}
      {% if low1 >= low2 %}
        {{ range1 }}
      {% else %}
        {{ range2 }}
      {% endif %}
    {% endif %}
  {% else %}
    {{ range1 }}
  {% endif %}
{% endif %}
