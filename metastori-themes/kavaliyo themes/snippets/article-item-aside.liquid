<a href="{{ article.url }}" class="article-item-aside">
  {%- if article.image -%}
    <div class="article-item-aside__image-wrap">
      {{- article.image | image_url: width: 160 | image_tag: loading: 'lazy', widths: '80, 120, 160', sizes: '80px', class: 'article-item-aside__image' -}}
    </div>
  {%- endif -%}
  <div class="article-item-aside__content">
    <time class="article-item-aside__date text--small text--subdued" datetime="{{ article.published_at | date: '%Y-%m-%d' }}">
      {{- article.published_at | date: format: 'date' -}}
    </time>
    <h3 class="article-item-aside__title heading heading--xsmall">{{ article.title }}</h3>
  </div>
</a>
