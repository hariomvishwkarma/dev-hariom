{% assign product = settings.kavalio_care_product %}
{% assign kavalio_in_cart = false %}
{% if cart != blank and cart.item_count > 0 and product != blank %}
  {% for item in cart.items %}
    {% if item.product.id == product.id %}
      {% assign kavalio_in_cart = true %}
      {% break %}
    {% endif %}
  {% endfor %}
{% endif %}

{% if product != blank and kavalio_in_cart != true %}
<div class="kavalio_care_product_wrap">
  <div class="kavalio_care_product_heading">
    <div class="kavalio_care_heading_content">
      <div class="kavalio_care_heading_title">
        {%- if kavalio_care_logo != blank -%}
          {{- kavalio_care_logo | image_url: width: kavalio_care_logo.width | image_tag: sizes: '100vw', widths: '100,200', alt: kavalio_care_logo.alt, class: 'kavalio_care_logo' -}}
        {%- endif -%}
      </div>
    </div>

    <div class="kavalio_care_heading_right">
      <div class="kavalio_care_price_and_atc_btn_wrap">
        <div class="kavalio_care_heading_price">
          <span>{{- product.price | money_without_currency -}}{{ shop.currency | replace: 'EUR', '€' | replace: 'eur', '€' | replace: 'USD', '$' | replace: 'usd', '$' }}</span>
        </div>

        <div class="kavalio_care_product_atc_button">
          {%- capture form_id -%}product_form_kavalio_care_{% increment product_form_index %}{%- endcapture -%}
          {%- form 'product', product, is: 'product-form', id: form_id, class: 'ed-product-item__quick-form' -%}
            <input type="hidden" name="quantity" value="1">
            <input type="hidden" name="id" value="{{ product.first_available_variant.id }}">
            <button
              is="loader-button"
              type="submit"
              class="kavalio_care_product_content_button_add button button--primary button--text button--full"
            >
             {% render 'icon' with 'quick-atc-icon' %}
            </button>
          {%- endform -%}
        </div>
      </div>
      
      <span class="kavalio_care_chevron" aria-hidden="true">
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="kavalio_care_chevron__icon">
          <path stroke-linecap="round" stroke-linejoin="round" d="m19.5 8.25-7.5 7.5-7.5-7.5" />
        </svg>
      </span>
    </div>
  </div>

  <div class="kavalio_care_product_content">
    <div class="kavalio_care_product_content_text">
      <ul class="kavalio_care_bulletpoints">
        {%  assign bullet_points = product.metafields.standard.cro_pdp_bulletpoints.value %}
        {% if bullet_points != blank %}
            {% for item in bullet_points %}
                <li class="kavalio_care_bulletpoints_item">
                    {% render 'icon' with 'icon-cehckmark' %}
                    <p>{{  item }}</p>
                </li>
            {% endfor %}
        {%  endif %}
        {%- if show_kavalio_care_more_info and kavalio_care_more_info_label != blank -%}
          <li class="kavalio_care_bulletpoints_item kavalio_care_bulletpoints_item__more_info">
            {% render 'icon' with 'icon-more-info' %}
            <a href="{{ kavalio_care_more_info_url }}">{{ kavalio_care_more_info_label }}</a>
          </li>
        {%- endif -%}
      </ul>
    </div>
  </div>
</div>

<style>
    .kavalio_care_product_wrap {
        background: var(--kavalio-care-bg, #F6F6F6);
        padding: 4px 8px;
        border-radius: 8px;
    }
    
    .kavalio_care_product_heading {
        display: flex;
        justify-content: space-between;
        align-items: center;
        cursor: pointer;
    }
    
    .kavalio_care_heading_content {
        display: flex;
        align-items: center;
        justify-content: flex-start;
        gap: 3px;
    }

    
    
    .kavalio_care_heading_content > img {
        width: 22px;
        object-fit: contain;
        display: flex;
        margin-top: -2px;
        border-radius: 3px;
        margin-right: 2px;
    }
    
    .kavalio_care_heading_title {
        display: flex;
        align-items: center;
        justify-content: flex-start;
        gap: 4px;
        line-height: 1;
    }
    .kavalio_care_heading_title .kavalio_care_logo {
      width: 100%;
      max-width: {{ kavalio_care_logo_size }}px;
      height: auto;
    }
    
    span.kavalio_care_heading_content_title {
        font-weight: 600;
    }
    
    .kavalio_care_heading_title svg {
        display: inline-flex;
        width: 20px;
        margin-top: -5px;
        height: auto;
    }
    .kavalio_care_heading_right {
        display: flex;
        align-items: center;
        gap: 12px;
    }
    .kavalio_care_price_and_atc_btn_wrap {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 12px;
    }
    .kavalio_care_heading_price {
        font-weight: 600;
        font-size: 13px;
    }
    .kavalio_care_chevron {
        flex-shrink: 0;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        margin-top: -4px;
    }
    .kavalio_care_chevron__icon {
        width: 20px;
        height: 20px;
        transform: rotate(0deg);
        transition: transform 0.3s ease;
    }
    .kavalio_care_product_wrap.is-expanded .kavalio_care_chevron__icon {
        transform: rotate(180deg);
    }
    
    span.kavalio_care_heading_content_title.kchct_2 {
        font-weight: normal;
    }
    
    .kavalio_care_product_content {
      max-height: 0;
      overflow: hidden;
      opacity: 0;
      margin-top: 0;
      transition: max-height 0.35s ease, opacity 0.3s ease, margin-top 0.35s ease;
      display: flex;
      justify-content: space-between;
      align-items: flex-end;
    }
  
    .kavalio_care_product_wrap.is-expanded .kavalio_care_product_content {
      max-height: 500px;
      opacity: 1;
      margin-top: 8px;
    }

    ul.kavalio_care_bulletpoints {
        margin: 0;
        padding: 0;
        list-style: none;
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 6px 0px;
    }
    
    li.kavalio_care_bulletpoints_item {
        display: flex;
        align-items: center;
        justify-content: flex-start;
        gap: 4px;
    }
    
    li.kavalio_care_bulletpoints_item svg {
        width: 13px;
        height: 13px;
        display: flex;
    }
    
    li.kavalio_care_bulletpoints_item p {
        font-size: 13px;
        line-height: 1;
        margin: 0;
    }
    
    .kavalio_care_bulletpoints_item__more_info {
    }
    
    .kavalio_care_bulletpoints_item__more_info svg {
        display: flex;
    }
    
    .kavalio_care_bulletpoints_item__more_info a {
        font-size: 13px;
        line-height: normal;
        text-decoration: underline;
    }
    
    .kavalio_care_product_atc_button {
    }
    
    button.kavalio_care_product_content_button_add.button.button--primary.button--text.button--full {
      width: auto;
      height: auto;
      min-width: unset;
      max-width: unset;
      border-radius: 6px;
      padding: 6px;
    }
    button.kavalio_care_product_content_button_add.button.button--primary.button--text.button--full svg {
      width: 18px;
      height: auto;
    }
  
    
</style>
{% endif %}