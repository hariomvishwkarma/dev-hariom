<style>
  #shopify-section-{{ section.id }} #block--{{ block.id }} {
      --rating-color: rgba({{ block.settings.heading_color.red }}, {{ block.settings.heading_color.green }}, {{ block.settings.heading_color.blue }}, 1);
      --empty-rating-color: rgba({{ block.settings.heading_color.red }}, {{ block.settings.heading_color.green }}, {{ block.settings.heading_color.blue }}, 0.25);
      --section-bg: {{ block.settings.section_bg }};
      --heading-color: {{ block.settings.heading_color }};
      --heading-bg: {{ block.settings.heading_background }};
      --testimonial-color: {{ block.settings.testimonial_color }};
      --testimonial-bg: {{ block.settings.testimonial_background }};
      --testimonial-rating-color: rgba({{ block.settings.testimonial_color.red }}, {{ block.settings.testimonial_color.green }}, {{ block.settings.testimonial_color.blue }}, 1);
      --testimonial-empty-rating-color: rgba({{ block.settings.testimonial_color.red }}, {{ block.settings.testimonial_color.green }}, {{ block.settings.testimonial_color.blue }}, 0.25);
  }

  {% if block.settings.full_width_mobile %}
      @media (max-width: 999px) {
          #shopify-section-{{ section.id }} #block--{{ block.id }} {
              width: 100%;
              grid-column: span 2;
          }
      }
  {% endif %}

  {% if block.settings.show_desktop_only %}
      @media (max-width: 999px) {
          #shopify-section-{{ section.id }} #block--{{ block.id }} {
              display: none;
          }
      }
  {% endif %}

  {% if block.settings.show_mobile_only %}
      @media (min-width: 1000px) {
          #shopify-section-{{ section.id }} #block--{{ block.id }} {
              display: none;
          }
      }
  {% endif %}
</style>

<style>
  .hr_spotlight-reviews {
    background: var(--section-bg);
  }

  header.hr_review__header {
    background: var(--heading-bg);
    color: var(--heading-color);
    padding: 25px;
    text-align: center;
  }

  header.hr_review__header h3.heading {
    color: var(--heading-color);
    margin: 0;
    font-weight: 600;
    font-size: 24px;
  }

  .hr_review_ratings {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 16px;
    margin: 16px 0;
  }

  span.hr_review_ratings-list {
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .hr_review_testimonial-list__wrapper {
    background: var(--testimonial-bg);
    padding: 0 35px 35px;
    color: var(--testimonial-color);
  }

  span.hr_review_rating-label span.rating-number {
    font-size: 14px;
  }
  span.hr_review_ratings-list svg.rating-star-empty {
    color: var(--empty-rating-color);
  }

  .hr_review_bottomicons {
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .hr_review_autherwithicons {
    display: flex;
    align-items: center;
    gap: 8px;
    padding-top: 40px;
    padding-bottom: 16px;
  }

  p.hr_review_testimonial__author {
    margin: 0;
    font-weight: 600;
    font-size: 16px;
    line-height: 1;
  }

  span.hr_review_static-rating {
    display: flex;
    gap: 2px;
  }

  span.hr_review_static-rating svg {
    width: 16px;
    height: 16px;
  }
  span.hr_review_static-rating svg {
    color: var(--testimonial-rating-color);
  }
  span.hr_review_static-rating svg.rating-star-empty {
    color: var(--testimonial-empty-rating-color);
  }
  .hr_review_verify {
    display: flex;
    gap: 6px;
    align-items: center;
  }

  span.hr_review_verify-icon {
    display: flex;
  }

  span.hr_review_verify-text {
    font-size: 14px;
    line-height: 1;
    color: #a4a4a4;
  }

  blockquote.hr_review_testimonial__content {
    margin: 0;
    padding-top: 24px;
    padding-bottom: 40px;
    font-size: 16px;
    font-weight: 400;
  }

  .hr_review_days {
    display: flex;
    align-items: center;
    justify-content: right;
  }

  @media (min-width: 1000px) {
    .hr_spotlight-reviews {
      margin-bottom: 50px;
      padding: 50px 50px;
    }
  }

  @media (max-width: 999px) {
    .hr_spotlight-reviews {
      padding: 50px 50px;
    }

    header.hr_review__header h3.heading {
      font-size: 18px;
      font-weight: 400;
    }

    .hr_review_ratings {
      flex-direction: column;
      gap: 10px;
    }

    span.hr_review_rating-label span.rating-number {
      font-size: 16px;
    }

    .hr_review_testimonial-list__wrapper {
      padding: 20px 20px;
    }

    .hr_review_autherwithicons {
      padding-top: 0;
      padding-bottom: 8px;
    }

    blockquote.hr_review_testimonial__content {
      padding-top: 16px;
      padding-bottom: 24px;
    }

    p.hr_review_testimonial__author {
      font-size: 12px;
      font-weight: normal;
    }

    span.hr_review_static-rating svg {
      width: 12px;
      height: 12px;
    }

    span.hr_review_static-rating {
      gap: 1px;
    }

    span.hr_review_verify-text {
      font-size: 10px;
    }

    blockquote.hr_review_testimonial__content {
      font-size: 12px;
      line-height: 1.5;
    }

    .hr_review_days {
      font-size: 10px;
    }

    span.hr_review_ratings-list svg {
      width: 18px;
      height: auto;
    }


  }
</style>

<product-item
  id="block--{{ block.id }}"
  class="product-item hr_spotlight-reviews"
  {% if reveal %}
    reveal
  {% endif %}
  {{ block.shopify_attributes }}
>
  {%- if block.settings.liquid == blank -%}
    <div class="hr_spotlight_reviews_inner">
      <header class="hr_review__header">
        <h3 class="heading h4">{{ block.settings.heading_title }}</h3>
        <div class="hr_review_ratings">
          <span class="hr_review_ratings-list">
            {% assign heading_rating = block.settings.heading_rating %}
            {% assign ratings = heading_rating | floor %}
            {% assign has_half_star = heading_rating | modulo: 1 %}
            {% assign empty_stars = 5 | minus: ratings %}
            {%- for i in (1..ratings) -%}
              {% render 'icon' with 'rating-star', class: 'icon' %}
            {%- endfor -%}

            {%- if has_half_star > 0 -%}
              <svg class="visually-hidden">
                <linearGradient id="hr-rating-star-gradient-half">
                  <stop offset="50%" stop-color="var(--rating-color)" />
                  <stop offset="50%" stop-color="var(--rating-color)" stop-opacity="0.4" />
                </linearGradient>
              </svg>

              <svg fill="none" focusable="false" width="14" height="14" class="rating-star-half" viewBox="0 0 14 13">
                <path d="M7 0L8.6458 4.73475L13.6574 4.83688L9.66296 7.86525L11.1145 12.6631L7 9.8L2.8855 12.6631L4.33704 7.86525L0.342604 4.83688L5.3542 4.73475L7 0Z" fill="url(#hr-rating-star-gradient-half)"></path>
              </svg>
            {%- endif -%}

            {%- for i in (1..empty_stars) -%}
              {% render 'icon' with 'rating-star', class: 'icon rating-star-empty' %}
            {%- endfor -%}
          </span>
          <span class="hr_review_rating-label">
            <span class="rating-number">{{ block.settings.rating_content }}</span>
          </span>
        </div>

        <div class="hr_review_bottomicons">
          <img
            src="https://assets.reviews.io/img/all-global-assets/logo/reviewsio-icon.svg"
            style="height: 20px; margin-left: 4px;"
            alt=""
          >
          <img
            src="https://cdn.shopify.com/s/files/1/0694/6576/8200/files/reviews_llogo_1.png?v=1687864446"
            style="height: 20px; margin-left: 4px;"
            alt=""
          >
        </div>
      </header>

      <testimonial-list reveal-on-scroll="" class="hr_review_testimonial-list became-visible" style="opacity: 1;">
        <div class="hr_review_testimonial-list__wrapper">
          <testimonial-item class="hr_review_testimonial">
            <div class="hr_review_autherwithicons">
              <p reveal-visibility="" class="hr_review_testimonial__author" style="visibility: visible;">
                {{ block.settings.author }}
              </p>
              <span class="hr_review_static-rating">
                {% assign testionminal_ratings = block.settings.author_rating %}
                {% assign ratings = testionminal_ratings | floor %}
                {% assign has_half_star = testionminal_ratings | modulo: 1 %}
                {% assign empty_stars = 5 | minus: ratings %}
                {%- for i in (1..ratings) -%}
                  {% render 'icon' with 'rating-star', class: 'icon' %}
                {%- endfor -%}

                {%- if has_half_star > 0 -%}
                  <svg class="visually-hidden">
                    <linearGradient id="hr-rating-star-gradient-half">
                        <stop offset="50%" stop-color="var(--testimonial-rating-color)" />
                        <stop offset="50%" stop-color="var(--testimonial-rating-color)" stop-opacity="0.4" />
                    </linearGradient>
                  </svg>

                  <svg
                    fill="none"
                    focusable="false"
                    width="14"
                    height="14"
                    class="rating-star-half"
                    viewBox="0 0 14 13"
                  >
                    <path d="M7 0L8.6458 4.73475L13.6574 4.83688L9.66296 7.86525L11.1145 12.6631L7 9.8L2.8855 12.6631L4.33704 7.86525L0.342604 4.83688L5.3542 4.73475L7 0Z" fill="url(#hr-rating-star-gradient-half)"></path>
                  </svg>
                {%- endif -%}

                {%- for i in (1..empty_stars) -%}
                  {% render 'icon' with 'rating-star', class: 'icon rating-star-empty' %}
                {%- endfor -%}
              </span>
            </div>
            <div class="hr_review_verify">
              <span class="hr_review_verify-icon">
                <svg xmlns="http://www.w3.org/2000/svg" width="12" height="11" viewBox="0 0 12 11" fill="none">
                  <path id="Vector" d="M11.1109 4.6356L10.1909 3.93786C10.1172 3.88233 10.0599 3.80969 10.0249 3.72705C9.98981 3.64441 9.97811 3.55459 9.99094 3.46641L10.1159 2.36323C10.1333 2.21664 10.1155 2.06825 10.0639 1.929C10.0124 1.78975 9.92829 1.66319 9.81792 1.55867C9.70754 1.45415 9.57369 1.37432 9.42623 1.32509C9.27878 1.27585 9.12147 1.25845 8.96594 1.27418L7.79094 1.39205C7.69741 1.40413 7.60216 1.39311 7.51451 1.36005C7.42686 1.327 7.34982 1.27304 7.29094 1.20347L6.56594 0.35015C6.46456 0.240214 6.33934 0.152068 6.19874 0.0916629C6.05815 0.0312578 5.90544 0 5.75094 0C5.59643 0 5.44372 0.0312578 5.30313 0.0916629C5.16253 0.152068 5.03731 0.240214 4.93594 0.35015L4.19594 1.21761C4.13705 1.28718 4.06001 1.34114 3.97236 1.3742C3.88471 1.40725 3.78946 1.41828 3.69594 1.40619L2.53594 1.28833C2.3804 1.2726 2.2231 1.28999 2.07564 1.33923C1.92818 1.38847 1.79433 1.46829 1.68395 1.57281C1.57358 1.67734 1.4895 1.80389 1.43792 1.94314C1.38634 2.08239 1.36858 2.23078 1.38594 2.37737L1.51094 3.48055C1.52376 3.56874 1.51207 3.65855 1.47701 3.74119C1.44195 3.82384 1.38472 3.89648 1.31094 3.952L0.390936 4.6356C0.268922 4.72792 0.170452 4.84491 0.102789 4.97791C0.035127 5.11091 0 5.25654 0 5.40405C0 5.55157 0.035127 5.6972 0.102789 5.8302C0.170452 5.9632 0.268922 6.08018 0.390936 6.17251L1.31094 6.87025C1.38434 6.92607 1.44129 6.99876 1.47632 7.08132C1.51134 7.16388 1.52326 7.25354 1.51094 7.3417L1.38594 8.4496C1.36861 8.59587 1.38659 8.74394 1.43854 8.88274C1.49049 9.02153 1.57507 9.14744 1.68594 9.25105C1.79424 9.35765 1.92758 9.43878 2.07522 9.48791C2.22285 9.53704 2.38066 9.5528 2.53594 9.53392L3.71094 9.41606C3.80446 9.40397 3.89971 9.415 3.98736 9.44805C4.07501 9.48111 4.15205 9.53507 4.21094 9.60464L4.95094 10.4721C5.04886 10.5871 5.17292 10.68 5.31398 10.7438C5.45504 10.8076 5.60949 10.8407 5.76594 10.8407C5.92238 10.8407 6.07683 10.8076 6.21789 10.7438C6.35895 10.68 6.48302 10.5871 6.58094 10.4721L7.32094 9.60464C7.37982 9.53507 7.45686 9.48111 7.54451 9.44805C7.63216 9.415 7.72741 9.40397 7.82094 9.41606L8.99594 9.53392C9.15121 9.5528 9.30902 9.53704 9.45665 9.48791C9.60429 9.43878 9.73763 9.35765 9.84594 9.25105C9.9568 9.14744 10.0414 9.02153 10.0933 8.88274C10.1453 8.74394 10.1633 8.59587 10.1459 8.4496L10.0209 7.3417C10.0086 7.25354 10.0205 7.16388 10.0556 7.08132C10.0906 6.99876 10.1475 6.92607 10.2209 6.87025L11.1409 6.17251C11.2629 6.08018 11.3614 5.9632 11.4291 5.8302C11.4967 5.6972 11.5319 5.55157 11.5319 5.40405C11.5319 5.25654 11.4967 5.11091 11.4291 4.97791C11.3614 4.84491 11.2629 4.72792 11.1409 4.6356H11.1109ZM5.95094 6.85139C5.87389 6.94594 5.77647 7.02402 5.66509 7.08048C5.55371 7.13694 5.43091 7.17051 5.30478 7.17898C5.17864 7.18744 5.05204 7.17061 4.9333 7.12958C4.81457 7.08856 4.70641 7.02427 4.61594 6.94097L3.39594 5.79064C3.34932 5.74668 3.31234 5.6945 3.28711 5.63707C3.26188 5.57963 3.24889 5.51808 3.24889 5.45591C3.24889 5.39375 3.26188 5.33219 3.28711 5.27476C3.31234 5.21733 3.34932 5.16514 3.39594 5.12119C3.44256 5.07723 3.4979 5.04236 3.55881 5.01857C3.61972 4.99478 3.68501 4.98254 3.75094 4.98254C3.81687 4.98254 3.88215 4.99478 3.94306 5.01857C4.00397 5.04236 4.05932 5.07723 4.10594 5.12119L5.25094 6.18194L7.20594 3.7257C7.2855 3.62568 7.40395 3.55955 7.53522 3.54186C7.60023 3.53311 7.66642 3.53651 7.73003 3.55188C7.79363 3.56724 7.85341 3.59427 7.90594 3.63142C7.95846 3.66856 8.00272 3.7151 8.03617 3.76837C8.06963 3.82165 8.09162 3.88061 8.10091 3.9419C8.1102 4.00319 8.10659 4.0656 8.09029 4.12558C8.074 4.18555 8.04533 4.24191 8.00594 4.29144L5.95094 6.85139Z" fill="#4C8AE7"></path>
                </svg>
              </span>
              <span class="hr_review_verify-text">{{ block.settings.verified_badge }}</span>
            </div>
            <blockquote class="hr_review_testimonial__content">
              <split-lines reveal-visibility="" style="visibility: visible;">
                <span reveal-visibility="" style="display: block; visibility: visible;">
                  <font style="vertical-align: inherit;">
                    <font style="vertical-align: inherit;">
                      {{ block.settings.author_content }}
                    </font>
                  </font>
                </span>
              </split-lines>
            </blockquote>

            <div class="hr_review_days">
              <span class="hr_review_days-inner">
                <font style="vertical-align: inherit;">
                  <font style="vertical-align: inherit;">{{ block.settings.date }}</font>
                </font>
              </span>
            </div>
          </testimonial-item>
        </div>
      </testimonial-list>
    </div>
  {%- else -%}
    {{ block.settings.liquid }}
  {%- endif -%}
</product-item>
