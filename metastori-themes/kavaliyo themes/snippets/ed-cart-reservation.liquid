{% if settings.reservation_label_text != blank %}
    <div class="cart-reservation-label cart-reservation-label-original">
      <div class="label-container">
        {{ settings.reservation_icon }}
        <div class="reservation-text">
          {{ settings.reservation_label_text }}
        </div>
      </div>
    </div>
{% endif %}
  
{% if settings.reservation_label_text_timer != blank %}
    <div class="cart-reservation-label reservation-text-timer" style="display: none;">
        <div class="label-container">
        {{ settings.reservation_icon }}
        <span class="reservation-text">
            {{ settings.reservation_label_text_timer | replace: '(time)', '<span class="time" aria-live="polite"></span>' }}
        </span>
        </div>
    </div>
{% endif %}
  
  <style>
    .cart-reservation-label .reservation-text,  .cart-reservation-label .reservation-text *{
      color: {{settings.reservation_text_color}};
      font-size: {{settings.reservation_text_font_size}}px; 
      line-height: 1.3; 
    }
    .cart-reservation-label{
      background-color: {{settings.reservation_bg}};
      padding: 10px 0;
      margin: 10px 0; 
      {% if settings.reservation_border_radius == "rounded" %}
      border-radius: 10px; 
      {% endif %}
    }
    .cart-reservation-label  .label-container svg{
      width: 16px; 
      height: 16px; 
      margin-right: 4px; 
      min-width: 16px; 
      min-height: 16px; 
      margin-top: -3px;

    }
    .cart-reservation-label .label-container *{
      display: inline-block; 
    }
    .cart-reservation-label .label-container{
      display: flex; 
      align-items: center; 
      {% if settings.reservation_text_align == "center" %}
      justify-content: center; 
      {% endif %}
    }
  </style>