<div class="upsell-product">
    <div
      class="upsell-product-img"
      style="
        {% if product.metafields.standard.pdp_media_background_color != blank %}
          background-color: {{ product.metafields.standard.pdp_media_background_color }};{% endif %}
      "
    >
      {% if product.images.first %}
        {{ product.images.first | image_url: width: 300 | image_tag }}
      {% endif %}
    </div>
    <div class="upsell-product-info">
      <div>
        <a disabled>
          <div class="upsell-product-title">
            {% if product.metafields.standard.product_title_01 != blank %}
              <span>{{ product.metafields.standard.product_title_01.value }}</span>
              {% if product.metafields.standard.product_title_02 != blank %}
                <strong>{{ product.metafields.standard.product_title_02.value }}</strong>
              {% endif %}
            {% else %}
              {{ product.title }}
            {% endif %}
          </div>
        </a>
        
        <div class="upsell-product-description">
          {{ product.description }}
        </div>
  
        {% if settings.show_cart_upsell_rating %}
          <div class="upsell-product-rating">
            {%- render 'product-rating', product: product -%}
          </div>
        {% endif %}
        {% if settings.show_cart_upsell_price %}
          <div class="product-meta__price-list-container">
            {%- if product.selected_or_first_available_variant != null -%}
              <div class="price-list">
                {%- if product.selected_or_first_available_variant.compare_at_price
                    > product.selected_or_first_available_variant.price
                -%}
                  <span class="price price--compare">
                    <span class="visually-hidden">{{ 'product.general.regular_price' | t }}</span>
  
                    {%- if settings.currency_code_enabled -%}
                      {{- product.selected_or_first_available_variant.compare_at_price | money_with_currency -}}
                    {%- else -%}
                      {{- product.selected_or_first_available_variant.compare_at_price | money_without_currency -}}
                      {{
                        shop.currency
                        | replace: 'EUR', '€'
                        | replace: 'eur', '€'
                        | replace: 'USD', '$'
                        | replace: 'usd', '$'
                      }}
                    {%- endif -%}
                  </span>
  
                  <span class="price price--highlight ed-gift-price-free">
                    <span class="visually-hidden">{{ 'product.general.sale_price' | t }}</span>
                    <span class="free-gift-price-label">
                      {{- 'cart.general.free' | t -}}
                    </span>
                  </span>
                {%- else -%}
                  <span class="price price--normal ed-gift-price-free">
                    <span class="visually-hidden">{{ 'product.general.sale_price' | t }}</span>
                    <span class="free-gift-price-label">
                      {{- 'cart.general.free' | t -}}
                    </span>
                  </span>
                {%- endif -%}
              </div>
            {%- endif -%}
          </div>
        {% endif %}
      </div>
  
      <!-- prettier-ignore -->
      <div
          class="free-gift-action button button--primary"
          data-vid="{{ product.selected_or_first_available_variant.id }}"
          data-product-id='{{ product.id }}'
          data-action="add"
        >
          {% render 'icon' with 'icon-plus' %}
        </div>
    </div>
  </div>
  