{%- assign wishlist_variant = product.selected_or_first_available_variant -%}
{%- assign wishlist_image = wishlist_variant.featured_media.preview_image | default: product.featured_media.preview_image -%}
<div
  id="ed-pdp-wishlist"
  class="ed-pdp-wishlist"
  data-product-id="{{ product.id }}"
  data-product-url="{{ product.url }}"
  data-product-title="{{ product.title | escape }}"
  {% if wishlist_image %}
    data-product-image="{{ wishlist_image | image_url: width: 600 | prepend: 'https:' }}"
  {% endif %}
>
  <button
    id="ed-pdp-wishlist-btn"
    type="button"
    class="ed-pdp-wishlist-btn"
    aria-label="{{ 'header.general.wishlist' | t | default: 'Add to wishlist' | escape }}"
  >
    <svg
      id="ed-pdp-wishlist-icon"
      class="ed-pdp-wishlist-icon"
      width="24"
      height="24"
      viewBox="0 0 24 24"
      fill="none"
      xmlns="http://www.w3.org/2000/svg"
      aria-hidden="true"
    >
      <path d="M19.6706 5.4736C17.6806 3.8336 14.7206 4.1236 12.8906 5.9536L12.0006 6.8436L11.1106 5.9536C9.29063 4.1336 6.32064 3.8336 4.33064 5.4736C2.05064 7.3536 1.93063 10.7436 3.97063 12.7836L11.6406 20.4536C11.8406 20.6536 12.1506 20.6536 12.3506 20.4536L20.0206 12.7836C22.0706 10.7436 21.9506 7.3636 19.6706 5.4736Z" stroke="currentColor" stroke-width="1.75" fill="none" stroke-linecap="round" stroke-linejoin="round"></path>
    </svg>
  </button>
</div>
