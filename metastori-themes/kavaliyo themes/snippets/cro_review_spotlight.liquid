  (function initCroReviewsWidget() {
    var container = document.getElementById('CroReviewsWidget');
    if (!container) return;
    if (typeof window.ReviewsWidget !== 'undefined') {
      try { new window.ReviewsWidget('#CroReviewsWidget', window.CRO_REVIEWS_SPOTLIGHT_CONFIG); } catch (e) {}
      return;
    }
    var attempts = 0;
    function wait() {
      if (typeof window.ReviewsWidget !== 'undefined') {
        try { new window.ReviewsWidget('#CroReviewsWidget', window.CRO_REVIEWS_SPOTLIGHT_CONFIG); } catch (e) {}
        return;
      }
      if (++attempts < 50) setTimeout(wait, 100);
      else {
        var s = document.createElement('script');
        s.src = 'https://widget.reviews.io/polaris/build.js';
        s.onload = function() { try { new window.ReviewsWidget('#CroReviewsWidget', window.CRO_REVIEWS_SPOTLIGHT_CONFIG); } catch (e) {} };
        document.head.appendChild(s);
      }
    }
    setTimeout(wait, 200);
  })();
</script>
{% comment %} END Reviews.io {% endcomment %}

<script>
  (function () {
    var reviewsioHeader = {
      ratingValue: '',
      starsHtml: '',
      countText: '',
    };

    function escapeHtml(str) {
      if (!str) return '';
      var div = document.createElement('div');
      div.textContent = str;
      return div.innerHTML;
    }

    function readFromReviewsWidget() {
      var root = document.getElementById('CroReviewsWidget');
      if (!root) return false;
      var headerLeft = root.querySelector('.header__group.header__group--left');
      if (!headerLeft) return false;

      var ratingEl = headerLeft.querySelector('.R-TextHeading.R-TextHeading--md.R-TextHeading--inline');
      var starsEl = headerLeft.querySelector('.R-RatingStars');
      var countBodies = headerLeft.querySelectorAll('.R-TextBody.R-TextBody--xs.u-textLeft--all.u-marginBottom--xs');
      var countEl =
        countBodies.length > 0
          ? countBodies[countBodies.length - 1]
          : headerLeft.querySelector('.R-TextBody.R-TextBody--xs');

      if (ratingEl) reviewsioHeader.ratingValue = (ratingEl.textContent || '').trim();
      if (starsEl) reviewsioHeader.starsHtml = starsEl.outerHTML;
      if (countEl) reviewsioHeader.countText = (countEl.textContent || '').trim();

      return reviewsioHeader.ratingValue || reviewsioHeader.starsHtml || reviewsioHeader.countText;
    }

    function applyToOurHeader(skipStars) {
      var starsSlot = document.querySelector('.hr_cro_review_spotlight_section [data-reviewsio-stars]');
      var countSlot = document.querySelector('.hr_cro_review_spotlight_section [data-reviewsio-count]');
      if (!starsSlot && !countSlot) return;

      if (!skipStars && reviewsioHeader.starsHtml && starsSlot) starsSlot.innerHTML = reviewsioHeader.starsHtml;
      if (countSlot) {
        var rating = reviewsioHeader.ratingValue || '';
        var countText = reviewsioHeader.countText || '';
        countSlot.innerHTML =
          '<strong>' + escapeHtml(rating) + (rating ? '/5.0</strong> ' : '</strong> ') + escapeHtml(countText);
      }
    }

    var reviewsioReviewsList = [];

    function getReviewsListFromWidget() {
      var root = document.getElementById('CroReviewsWidget');
      if (!root) return [];
      var items = root.querySelectorAll('.R-ContentList__item');
      var list = [];
      items.forEach(function (item) {
        var nameEl =
          item.querySelector('.cssVar-authorName') ||
          item.querySelector('.c-meta__authorName span') ||
          item.querySelector('.c-meta__authorName');
        var bodyEl =
          item.querySelector('.item__review .R-TextBody.u-whiteSpace--prewrap') ||
          item.querySelector('.item__review .R-TextBody') ||
          item.querySelector('.item__review [class*="TextBody"]');
        var author = nameEl ? (nameEl.textContent || '').trim() : '';
        var content = bodyEl ? (bodyEl.textContent || '').trim() : '';
        if (content) list.push({ author: author || 'Customer', content: content });
      });
      return list;
    }

    var verifiedIconSvg =
      '<svg width="16" height="16" viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M14.1163 6.42625C13.8806 6.18 13.6369 5.92625 13.545 5.70312C13.46 5.49875 13.455 5.16 13.45 4.83187C13.4406 4.22187 13.4306 3.53062 12.95 3.05C12.4694 2.56937 11.7781 2.55937 11.1681 2.55C10.84 2.545 10.5013 2.54 10.2969 2.455C10.0744 2.36312 9.82 2.11937 9.57375 1.88375C9.1425 1.46937 8.6525 1 8 1C7.3475 1 6.85812 1.46937 6.42625 1.88375C6.18 2.11937 5.92625 2.36312 5.70312 2.455C5.5 2.54 5.16 2.545 4.83187 2.55C4.22187 2.55937 3.53062 2.56937 3.05 3.05C2.56937 3.53062 2.5625 4.22187 2.55 4.83187C2.545 5.16 2.54 5.49875 2.455 5.70312C2.36312 5.92562 2.11937 6.18 1.88375 6.42625C1.46937 6.8575 1 7.3475 1 8C1 8.6525 1.46937 9.14187 1.88375 9.57375C2.11937 9.82 2.36312 10.0737 2.455 10.2969C2.54 10.5013 2.545 10.84 2.55 11.1681C2.55937 11.7781 2.56937 12.4694 3.05 12.95C3.53062 13.4306 4.22187 13.4406 4.83187 13.45C5.16 13.455 5.49875 13.46 5.70312 13.545C5.92562 13.6369 6.18 13.8806 6.42625 14.1163C6.8575 14.5306 7.3475 15 8 15C8.6525 15 9.14187 14.5306 9.57375 14.1163C9.82 13.8806 10.0737 13.6369 10.2969 13.545C10.5013 13.46 10.84 13.455 11.1681 13.45C11.7781 13.4406 12.4694 13.4306 12.95 12.95C13.4306 12.4694 13.4406 11.7781 13.45 11.1681C13.455 10.84 13.46 10.5013 13.545 10.2969C13.6369 10.0744 13.8806 9.82 14.1163 9.57375C14.5306 9.1425 15 8.6525 15 8C15 7.3475 14.5306 6.85812 14.1163 6.42625ZM10.8538 6.85375L7.35375 10.3538C7.30731 10.4002 7.25217 10.4371 7.19147 10.4623C7.13077 10.4874 7.06571 10.5004 7 10.5004C6.93429 10.5004 6.86923 10.4874 6.80853 10.4623C6.74783 10.4371 6.69269 10.4002 6.64625 10.3538L5.14625 8.85375C5.05243 8.75993 4.99972 8.63268 4.99972 8.5C4.99972 8.36732 5.05243 8.24007 5.14625 8.14625C5.24007 8.05243 5.36732 7.99972 5.5 7.99972C5.63268 7.99972 5.75993 8.05243 5.85375 8.14625L7 9.29313L10.1462 6.14625C10.1927 6.09979 10.2479 6.06294 10.3086 6.0378C10.3692 6.01266 10.4343 5.99972 10.5 5.99972C10.5657 5.99972 10.6308 6.01266 10.6914 6.0378C10.7521 6.06294 10.8073 6.09979 10.8538 6.14625C10.9002 6.1927 10.9371 6.24786 10.9622 6.30855C10.9873 6.36925 11.0003 6.4343 11.0003 6.5C11.0003 6.5657 10.9873 6.63075 10.9622 6.69145C10.9371 6.75214 10.9002 6.8073 10.8538 6.85375Z" fill="#1D1D1D"></path></svg>';

    var carouselFilled = false;

    function initFlickityOnContainer(container) {
      if (container._croFlickityInit) return;
      var configRaw = container.getAttribute('data-flickity-config');
      if (!configRaw) return;
      var config = {};
      try {
        config = JSON.parse(configRaw);
      } catch (e) {
        return;
      }
      config.cellSelector = '.hr_review_spotlight-item';
      config.initialIndex = 0;
      if (window.themeVariables && window.themeVariables.settings) {
        config.rightToLeft = window.themeVariables.settings.direction === 'rtl';
      }
      config.on = config.on || {};
      config.on.ready = function () {
        container.dispatchEvent(new CustomEvent('flickity:ready'));
      };
      config.on.change = function () {
        container.dispatchEvent(new CustomEvent('flickity:slide-changed'));
      };
      config.on.settle = function () {
        container.dispatchEvent(new CustomEvent('flickity:slide-settled'));
      };
      if (typeof window.ThemeFlickity !== 'undefined') {
        var instance = new window.ThemeFlickity(container, config);
        container.flickity = Promise.resolve(instance);
        container.flickityInstance = container.flickity;
        container.next = function () {
          instance.next();
        };
        container.previous = function () {
          instance.previous();
        };
        container.select = function (sel) {
          instance.selectCell(sel);
        };

        setTimeout(function () {
          if (instance && typeof instance.resize === 'function') {
            instance.resize();
          }
          if (typeof instance.reposition === 'function') {
            instance.reposition();
          }
        }, 100);

        container._croFlickityInit = true;
      }
    }

    function loadFlickityAndInit(containers) {
      function run() {
        containers.forEach(initFlickityOnContainer);
      }
      if (typeof window.ThemeFlickity !== 'undefined') {
        run();
        return;
      }
      var src = window.themeVariables && window.themeVariables.libs && window.themeVariables.libs.flickity;
      if (!src) {
        run();
        return;
      }
      var s = document.createElement('script');
      s.src = src;
      s.onload = run;
      document.head.appendChild(s);
    }

    function fillCarouselFromReviewsList() {
      if (carouselFilled) return;
      var list = getReviewsListFromWidget();
      if (list.length === 0) return;
      carouselFilled = true;
      reviewsioReviewsList = list;
      var sections = document.querySelectorAll('.hr_cro_review_spotlight_section');
      var containersToInit = [];
      sections.forEach(function (section) {
        var container =
          section.querySelector('.hr_review_spotlight-list') || section.querySelector('[id^="flickity-"]');
        if (!container) return;
        while (container.firstChild) container.removeChild(container.firstChild);
        reviewsioReviewsList.forEach(function (r) {
          var slide = document.createElement('div');
          slide.className = 'hr_review_spotlight-item';
          slide.innerHTML =
            '<div class="hr_review_spotlight-item-content"><p>' +
            escapeHtml(r.content) +
            '</p></div><div class="hr_review_spotlight-item-title">' +
            verifiedIconSvg +
            '<p>' +
            escapeHtml(r.author) +
            '</p></div>';
          container.appendChild(slide);
        });
        containersToInit.push(container);
      });
      if (containersToInit.length > 0) {
        loadFlickityAndInit(containersToInit);
      }
    }

    var applied = false;
    function run() {
      var list = getReviewsListFromWidget();
      document.querySelectorAll('.hr_cro_review_spotlight_section').forEach(function (section) {
        section.classList.toggle('ed_no_reviews', list.length === 0);
        section.classList.toggle('ed_has_reviews', list.length > 0);
      });
      if (!readFromReviewsWidget()) return false;
      if (!applied) {
        applyToOurHeader(false);
        applied = true;
      } else {
        applyToOurHeader(true);
      }
      fillCarouselFromReviewsList();
      return true;
    }

    var root = document.getElementById('CroReviewsWidget');
    if (root && typeof MutationObserver !== 'undefined') {
      var obs = new MutationObserver(function () {
        run();
      });
      obs.observe(root, { childList: true, subtree: true });
    }

    var attempts = 0;
    var maxAttempts = 30;
    function poll() {
      if (run() || attempts >= maxAttempts) return;
      attempts++;
      setTimeout(poll, 500);
    }
    setTimeout(poll, 1000);
  })();
</script>

