<style>
    {%- assign text_position = block.settings.text_position | split: '_' | first -%}

    {%- case text_position -%}
      {%- when 'top' -%}
        {%- assign section_items_alignment = 'flex-start' -%}
      {%- when 'middle' -%}
        {%- assign section_items_alignment = 'center' -%}
      {%- when 'bottom' -%}
        {%- assign section_items_alignment = 'flex-end' -%}
    {%- endcase -%}

    #block--{{ block.id }} {
      {%- if block.settings.text_color == 'rgba(0,0,0,0)' -%}
        {%- assign heading_color = settings.heading_color -%}
        {%- assign text_color = settings.text_color -%}
      {%- else -%}
        {%- assign heading_color = block.settings.text_color -%}
        {%- assign text_color = block.settings.text_color -%}
      {%- endif -%}

      {%- if block.settings.button_background == 'rgba(0,0,0,0)' -%}
        {%- assign button_background = settings.primary_button_background -%}
      {%- else -%}
        {%- assign button_background = block.settings.button_background -%}
      {%- endif -%}

      {%- if block.settings.content_color == 'rgba(0,0,0,0)' -%}
        {%- assign content_color = settings.content_color -%}
      {%- else -%}
        {%- assign content_color = block.settings.content_color -%}
      {%- endif -%}

      {%- if block.settings.button_text_color == 'rgba(0,0,0,0)' -%}
        {%- assign button_text_color = settings.primary_button_text_color -%}
      {%- else -%}
        {%- assign button_text_color = block.settings.button_text_color -%}
      {%- endif -%}

      --heading-color: {{ heading_color.red }}, {{ heading_color.green }}, {{ heading_color.blue }};
      --text-color: {{ text_color.red }}, {{ text_color.green }}, {{ text_color.blue }};
      --content-color: {{ content_color.red }}, {{ content_color.green }}, {{ content_color.blue }};
      --primary-button-background: {{ button_background.red }}, {{ button_background.green }}, {{ button_background.blue }};
      --primary-button-text-color: {{ button_text_color.red }}, {{ button_text_color.green }}, {{ button_text_color.blue }};

      --section-items-alignment: {{ section_items_alignment }};
      --section-overlay-color: {{ block.settings.overlay_color.red }}, {{ block.settings.overlay_color.green }}, {{ block.settings.overlay_color.blue }};
      --section-overlay-opacity: {{ block.settings.overlay_opacity | divided_by: 100.0 }};
    }

    {% comment %} product-item.product-item.ed_spotlight__banner {
        grid-column: 1 / -1;
    } {% endcomment %}


    product-item.product-item.ed_spotlight__banner {
        padding: 0;
    }
    product-item.product-item.ed_spotlight__banner .image-overlay,
    product-item.product-item.ed_spotlight__banner .image-overlay__image-wrapper,
    product-item.product-item.ed_spotlight__banner .image-overlay__image {
        border-radius: var(--button-border-radius);
    }
    product-item.product-item.ed_spotlight__banner .image-overlay {
        background: transparent !important;
        height: 100%;
    }

    product-item.product-item.ed_spotlight__banner .image-overlay__text-container {
        color: var(--content-color);
        font-size: var(--base-font-size);
    }

  @media (min-width: 1000px) {
    #block--{{ block.id }} {
        margin-top: {{ block.settings.space_top -}}px;
        margin-bottom: {{ block.settings.space_bottom -}}px;
    }
  }

  @media (max-width: 999px) {
    #block--{{ block.id }} {
        margin-top: {{ block.settings.space_top_mobile -}}px;
        margin-bottom: {{ block.settings.space_bottom_mobile -}}px;
    }

    product-item.product-item.ed_spotlight__banner .image-overlay {
        {% comment %} height: 80vh; {% endcomment %}
    }

    .image-overlay__content-wrapper {
        align-items: flex-start;
    }

    .content-box.content-box--xsmall {
        margin-inline: auto;
    }
    product-item.product-item.ed_spotlight__banner .image-overlay__content.content-box {
        padding-top: 3rem;
    }

    product-item.product-item.ed_spotlight__banner .image-overlay__text-container {
        margin-block-start: 0;
    }

    product-item.product-item.ed_spotlight__banner .heading+.button-wrapper,
    product-item.product-item.ed_spotlight__banner .heading+.button-group,
    product-item.product-item.ed_spotlight__banner p+.button-wrapper,
    product-item.product-item.ed_spotlight__banner p+.button-group,
    product-item.product-item.ed_spotlight__banner .button-wrapper+p,
    product-item.product-item.ed_spotlight__banner .button-group+p {
        margin-block-start: 16px;
    }

    product-item.product-item.ed_spotlight__banner .image-overlay__content.content-box h3.heading.h3 {
        font-size: 32px;
        line-height: 1;
        margin-block-end: 8px;
    }
  }
</style>

<product-item
  id="block--{{ block.id }}"
  class="product-item ed_spotlight__banner"
  {% if reveal %}
    reveal
  {% endif %}
  {{ block.shopify_attributes }}
>
  {%- assign spotlight_banner_metaobject = collection.metafields.custom.spotlight_banner.value -%}

  {%- if spotlight_banner_metaobject != blank -%}
    {%- assign image = spotlight_banner_metaobject.desktop_image.value | default: spotlight_banner_metaobject.desktop_image -%}
    {%- assign mobile_image = spotlight_banner_metaobject.mobile_image.value | default: spotlight_banner_metaobject.mobile_image -%}
    {%- assign badge_text = spotlight_banner_metaobject.badge_text.value | default: spotlight_banner_metaobject.badge_text -%}
    {%- assign subheading = spotlight_banner_metaobject.subheading.value | default: spotlight_banner_metaobject.subheading -%}
    {%- assign title = spotlight_banner_metaobject.heading.value | default: spotlight_banner_metaobject.heading -%}
    {%- if spotlight_banner_metaobject.content != blank -%}
      {%- assign content = spotlight_banner_metaobject.content | metafield_tag -%}
    {%- else -%}
      {%- assign content = '' -%}
    {%- endif -%}
    
    {%- assign button_text = spotlight_banner_metaobject.button_text_and_url.value.text | default: spotlight_banner_metaobject.button_text_and_url.text -%}
    {%- assign button_link = spotlight_banner_metaobject.button_text_and_url.value.url | default: spotlight_banner_metaobject.button_text_and_url.url -%}
  {%- else -%}
    {%- assign image = block.settings.image -%}
    {%- assign mobile_image = block.settings.mobile_image -%}
    {%- assign badge_text = block.settings.badge_text -%}
    {%- assign subheading = block.settings.subheading -%}
    {%- assign title = block.settings.title -%}
    {%- assign content = block.settings.content -%}
    {%- assign button_text = block.settings.button_text -%}
    {%- assign button_link = block.settings.button_link -%}
  {%- endif -%}

  {%- if mobile_image == blank -%}
    {%- assign mobile_image = image -%}
  {%- endif -%}

  {%- assign image_aspect_ratio = image.aspect_ratio | default: 2.63 -%}

  <image-with-text-overlay
    {% if block.settings.reveal_on_scroll %}
      reveal-on-scroll
    {% endif %}
    class="image-overlay image-overlay--{{ block.settings.section_height }}"
    {% if block.settings.section_height == 'auto' %}
      style="--image-aspect-ratio: {{ image_aspect_ratio }}"
    {% endif %}
  >
    <div
      class="image-overlay__image-wrapper"
      {% if block.settings.section_height == 'auto' %}
        style="padding-bottom: {{ 100.0 | divided_by: image_aspect_ratio }}%"
      {% endif %}
    >
      <picture>
        <source
          media="(min-width: 1000px)"
          srcset="{{ image | image_url: width: 400 }} 400w, {{ image | image_url: width: 600 }} 600w, {{ image | image_url: width: 800 }} 800w, {{ image | image_url: width: 1000 }} 1000w"
          width="{{ image.width }}"
          height="{{ image.height }}"
        >
        <source
          media="(max-width: 999px)"
          srcset="{{ mobile_image | image_url: width: 400 }} 400w, {{ mobile_image | image_url: width: 600 }} 600w, {{ mobile_image | image_url: width: 800 }} 800w, {{ mobile_image | image_url: width: 1000 }} 1000w"
          width="{{ mobile_image.width }}"
          height="{{ mobile_image.height }}"
        >

        {{-
          mobile_image
          | image_url: width: mobile_image.width
          | image_tag:
            widths: '600,700,800,1000,1200,1400,1600,1800,2000,2200,2400,2600',
            class: 'image-overlay__image',
            reveal: true
        -}}
      </picture>
    </div>

    {%- capture section_content -%}
        {%- assign text_alignment = block.settings.text_position | split: '_' | last -%}

        <div class="image-overlay__content-wrapper">
          <div class="image-overlay__content content-box content-box--{{ block.settings.text_width }} content-box--text-center content-box--{{ text_alignment }} text-container">
            {%- if subheading != blank -%}
              <h2 class="heading heading--small">
                <split-lines {% if block.settings.reveal_on_scroll %}reveal{% endif %}>{{ subheading | escape }}</split-lines>
              </h2>
            {%- endif -%}

            {%- if title != blank -%}
              <h3 class="heading h3">
                <split-lines {% if block.settings.reveal_on_scroll %}reveal{% endif %}>{{ title | escape }}</split-lines>
              </h3>
            {%- endif -%}

            {%- if content != blank or button_text != blank -%}
              <div class="image-overlay__text-container" {% if block.settings.reveal_on_scroll %}reveal{% endif %}>
                {%- if content != blank-%}
                  {{- content -}}
                {%- endif -%}

                {%- if button_text != blank -%}
                  {%- if block.settings.link_style == 'link' -%}
                    <a href="{{ button_link }}" class="multi-column__link heading heading--small link">{{ button_text | escape }}</a>
                  {%- else -%}
                    <div class="button-wrapper">
                      <a href="{{ button_link }}" class="button button--primary">{{ button_text | escape }}</a>
                    </div>
                  {%- endif -%}
                {%- endif -%}
              </div>
            {%- endif -%}
          </div>

          {%- if badge_text != blank -%}
            <div class="image-overlay__content-badge" style="--image-overlay-badge-bg: #59C5B4; --image-overlay-badge-color:#1D1D1D;">
              <h5 class="heading h5">{{ badge_text }}</h5>
            </div>
          {%- endif -%}
        </div>
      {%- endcapture -%}

    <div
      {% if is_boxed %}
        style="width: 100%"
      {% else %}
        class="container"
      {% endif %}
    >
      {{- section_content -}}
    </div>
  </image-with-text-overlay>
</product-item>
