{%- comment -%}
  Extract a style from the color swatch config. You must passed two parameters to this snippet:

  - color_swatch_config: extracted from the theme settings
  - value: the actual color
  - swatch: a swatch object that can contains either an image or a color
{%- endcomment -%}

{%- liquid
  if swatch.image != blank
    assign color_swatch_image = swatch.image | image_url: width: 72
    assign color_swatch_style = 'background-image: url(' | append: color_swatch_image | append: ')'
  elsif swatch.color != blank
    assign color_swatch_style = 'background-color: ' | append: swatch.color
  else
    assign color_value_downcase = value | downcase
    assign color_swatch_style = 'background-color: ' | append: color_value_downcase

    comment
      Look up ColorName:#hexcode in config. Check passed color_swatch_config first,
      then settings.custom_color_swatch_config (Custom Color Swatch Configuration).
    endcomment
    for color_swatch_item in color_swatch_config
      assign color_swatch_parts = color_swatch_item | split: ':'
      assign color_swatch_name = color_swatch_parts.first | downcase | strip
      if color_value_downcase == color_swatch_name
        assign color_swatch_value = color_swatch_parts.last | strip
        if color_swatch_value != blank
          if color_swatch_value contains '#'
            assign color_swatch_style = 'background-color: ' | append: color_swatch_value
          elsif images[color_swatch_value] != blank
            assign color_swatch_image = images[color_swatch_value] | image_url: width: 72
            assign color_swatch_style = 'background-image: url(' | append: color_swatch_image | append: ')'
          endif
          break
        endif
      endif
    endfor

    assign fallback_style = 'background-color: ' | append: color_value_downcase
    if settings.custom_color_swatch_config != blank and color_swatch_style == fallback_style
      assign custom_color_swatch_config = settings.custom_color_swatch_config | newline_to_br | split: '<br />'
      for color_swatch_item in custom_color_swatch_config
        assign color_swatch_item_stripped = color_swatch_item | strip
        if color_swatch_item_stripped == blank
          continue
        endif
        assign color_swatch_parts = color_swatch_item_stripped | split: ':'
        assign color_swatch_name = color_swatch_parts.first | downcase | strip
        if color_value_downcase == color_swatch_name
          assign color_swatch_value = color_swatch_parts.last | strip
          if color_swatch_value != blank and color_swatch_value contains '#'
            assign color_swatch_style = 'background-color: ' | append: color_swatch_value
          endif
          break
        endif
      endfor
    endif
  endif

  echo color_swatch_style
-%}