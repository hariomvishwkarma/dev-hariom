{% if extra == blank or extra == nil %}
  {{ base }}
{% else %}
  {%- assign base_normalized = base | strip | replace: '–', '-' | replace: '—', '-' -%}
  {%- assign extra_normalized = extra | strip | replace: '–', '-' | replace: '—', '-' -%}
  {% assign base_parts = base_normalized | split: '-' %}
  {% assign extra_parts = extra_normalized | split: '-' %}
  {% if base_parts.size >= 2 and extra_parts.size >= 2 %}
    {%- assign base_low = base_parts | first | strip | split: ' ' | first | times: 1 -%}
    {%- assign base_high = base_parts | last | strip | split: ' ' | first | times: 1 -%}
    {%- assign extra_low = extra_parts | first | strip | split: ' ' | first | times: 1 -%}
    {%- assign extra_high = extra_parts | last | strip | split: ' ' | first | times: 1 -%}
    {% assign result_low = base_low | plus: extra_low %}
    {% assign result_high = base_high | plus: extra_high %}
    {{ result_low }}-{{ result_high }}
  {% else %}
    {{ base }}
  {% endif %}
{% endif %}
