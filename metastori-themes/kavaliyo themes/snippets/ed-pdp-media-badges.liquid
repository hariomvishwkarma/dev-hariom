{%- capture product_labels -%}
  {%- if product.metafields.custom.badges != blank -%}
    {%- for custom_badge in product.metafields.custom.badges.value -%}
      {%- assign custom_badge_downcase = custom_badge | downcase -%}
      {%- unless custom_badge_downcase == 'sale' -%}
        {% render 'cro-product-badge', badge: custom_badge %}
      {%- endunless -%}
    {%- endfor -%}
  {%- else -%}
    {%- for tag in product.tags -%}
      {%- assign tag_downcase = tag | downcase -%}
      {%- unless tag_downcase == 'sale' -%}
        {% render 'cro-product-badge', badge: tag %}
      {%- endunless -%}
    {%- endfor -%}
  {%- endif -%}

  {% render 'kavalio-sale-badge',
    product: product,
    variant: product.selected_or_first_available_variant,
    pdp_dynamic: true
  %}

  {% comment %} 
    {%- unless product.available -%}
      <span class="label label--subdued">{{ 'collection.product.sold_out' | t }}</span>
    {%- endunless -%} 
  {% endcomment %}
{%- endcapture -%}

<div class="product_badges_list">
  {{- product_labels -}}
</div>
