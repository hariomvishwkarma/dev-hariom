
.badge--bestseller {
    color: {{ settings.bestseller_text_color }};
    background: {{ settings.bestseller_background_color }};
}

.badge.badge--neu {
    color: {{ settings.neu_text_color }};
    background: {{ settings.neu_background_color }};
}

.badge.badge--sale {
    color: {{ settings.sale_text_color }};
    background: {{ settings.sale_background_color }};
}

.badge.badge--limited-edition {
    color: {{ settings.limited_edition_text_color }};
    background: {{ settings.limited_edition_background_color }};
}

{%- if settings.custom_color_swatch_config != blank -%}
{%- assign custom_color_swatch_config = settings.custom_color_swatch_config | newline_to_br | split: '<br />' -%}
{%- for color_swatch_item in custom_color_swatch_config -%}
    {%- assign color_swatch_parts = color_swatch_item | split: ':' -%}
    {%- assign color_swatch_name = color_swatch_parts.first | strip -%}
    {%- assign color_swatch_value = color_swatch_parts.last | strip -%}
    {%- if color_swatch_name != blank and color_swatch_value != blank -%}
    .color-{{ color_swatch_name | handleize }} {
        background-color: {{ color_swatch_value }};
    }
    {%- endif -%}
{%- endfor -%}
{%- endif -%}