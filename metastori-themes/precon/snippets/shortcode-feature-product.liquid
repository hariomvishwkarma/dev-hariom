{%- comment -%}
Render Feature Product
Usage:
  [feature-product product_handle="the-complete-snowboard"]
  pameters:
    product_handle: required, the product handle to render
  optional:
    - add metafield 'bso.featured_product_header' to show header
    - add metafield 'bso.featured_product_content' to show content
{%- endcomment -%}

{%- capture product_handle -%}{%- render 'shortcode-param', keys: keys, values: values, param: 'product_handle' -%}{%- endcapture -%}

<div class="shortcode shortcode--feature-product">
  {%- if product_handle != blank -%}
    {%- render 'bso-feature-product', product_handle: product_handle -%}
  {%- endif -%}
</div>