{% assign col_width = width | default: "12" %}
<div class="bso-column bso-column-{{ col_width }}">
  <div class="shortcode shortcode-cta cta-shakes cta-start-shakes {% if col_width == "12" %}cta-fullsize mg-top{% endif %}">
    <div class="cta--wrapper">

      <div class="cta-image-container">
        <div class="cta-image--wrapper">
          <img
            src="https://cdn.shopify.com/s/files/1/0904/4639/7774/files/cta-start-shake.png?v=1757080801"
            alt="{{ 'bso_shortcode.cta_start_shakes.header' | t }}"
          >
        </div>
      </div>

      <div class="cta-content">
        <div class="cta-content--wrapper">
          <div class="cta-header">{{ 'bso_shortcode.cta_start_shakes.header' | t }}</div>
          <div class="cta-description">{{ 'bso_shortcode.cta_start_shakes.description' | t }}</div>
          <div class="cta-button--wrapper">
            <a href="{{ settings.cta_start_shakes_link | default: '#' }}" class="button cta-button">{{ 'bso_shortcode.cta_start_shakes.button_text' | t }}</a>
          </div>
        </div>
      </div>

    </div>
  </div>
</div>