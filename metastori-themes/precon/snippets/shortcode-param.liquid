{%- comment -%}
Get the value for a specific key out of the key and value arrays.
Example call: {%- render 'shortcode-param', keys: keys, values: values, param: 'text' -%}
{%- endcomment -%}

{%- assign shortcodekeyfound = false -%}
{%- for key in keys -%}
  {%- if key == param -%}
    {%- if values[forloop.index0] != 'None' -%}
      {{- values[forloop.index0] -}}
    {%- endif -%}
    {%- assign shortcodekeyfound = true -%}
  {%- break -%}
  {%- endif -%}
{%- endfor -%}
{%- if shortcodekeyfound == false and settings.shortcode_errors == 'error' and notfound != 'empty' -%}
  Liquid Error: Shortcode key ({{ param }}) not found
{%- endif -%}