{% if linklist.links.size > 0 %}
  <link-bar class="link-bar">
    <div class="container">
      <div class="link-bar__wrapper">
        <div class="link-bar__scroller hide-scrollbar">
          <ul class="link-bar__linklist list--unstyled" role="list">
            {% if default_all_posts_blog != blank %}
              <li class="link-bar__link-item">
                <a href="{{ default_all_posts_blog.url }}" class="link-bar__link link--animated {% if blog.handle == default_all_posts_blog.handle %}link-bar__link-item--selected text--underlined{% endif %}">{{ 'blog.general.all_posts' | t }}</a>
              </li>
            {% endif %}
           
            {%- for link in linklist.links -%}
              <li class="link-bar__link-item">
                <a href="{{ link.url }}" class="link-bar__link link--animated {% if link.active %}link-bar__link-item--selected text--underlined{% endif %}" title="{{ link.title }}">{{ link.title }}</a>
              </li>
            {%- endfor -%}
          </ul>
        </div>
      </div>
    </div>
  </link-bar>
  {% endif %}