{%- assign blog_handle = blogs['rezepte'].handle -%}
{%- assign article_handle = blog_handle | append: '/' | append: recipe_handle -%}
{%- assign article_obj = articles[article_handle] -%}

{% if article_obj != blank %}
  {% assign recipe_obj = article_obj.metafields.custom.blog_content.value %}
  {% assign image_to_render = recipe_obj.bild | default: article_obj.image %}
  <div class="shortcode shortcode-cta cta-recipe cta-fullsize">
    <div class="cta--wrapper">
      <div class="cta-image-container">
        <div class="cta-image--wrapper">
          {% if image_to_render != blank %}
            {{- image_to_render| image_url: width: '1000px' | image_tag: loading: 'lazy', fetchpriority: 'low', sizes: '(max-width: 740px) 81vw, (max-width: 999px) 37vw, 425px', sizes: '600,700,800,1000', class: 'article-item__image' -}}
          {% endif %}
        </div>
      </div>

      <div class="cta-content">
        <div class="cta-content--wrapper">
          {% if name != blank %}
            <div class="badge">{{ 'bso_shortcode.cta_recipe.name' | t: name: name }}</div>
          {% endif %}
          <div class="title">{{ recipe_obj.title }}</div>
          <div class="description">{{ 'bso_shortcode.cta_recipe.description' | t }}</div>
          <div class="cta-button--wrapper">
            {% if article_obj.url != blank %}
              <a href="{{ article_obj.url }}" class="button cta-button">{{ 'bso_shortcode.cta_recipe.button_text' | t }}</a>
            {% else %}
              <a href="{{ settings.cta_recipe_link |  default: '#' }}" class="button cta-button">{{ 'bso_shortcode.cta_recipe.button_text' | t }}</a>
            {% endif %}
          </div>
        </div>
      </div>

    </div>
  </div>
{% endif %}