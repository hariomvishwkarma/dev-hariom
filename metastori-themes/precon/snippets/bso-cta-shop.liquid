{% assign col_width = width | default: "12" %}
<div class="bso-column bso-column-{{ col_width }}">
  <div class="shortcode shortcode-cta cta-shop {% if col_width == "12" %}cta-fullsize mg-top{% endif %}">
    <div class="cta--wrapper">

      <div class="cta-image-container">
        <div class="cta-image--wrapper">
          <img
            src="https://cdn.shopify.com/s/files/1/0904/4639/7774/files/cta-shop.png?v=1756460247"
            class="cta-image cta-shop--image"
            alt="{{ 'bso_shortcode.cta_shop.header' | t }}"
          >
        </div>
      </div>

      <div class="cta-shop-content">
        <div class="cta-content--wrapper">
          <div class="cta-header">{{ 'bso_shortcode.cta_shop.header' | t }}</div>
          <div class="cta-description">{{ 'bso_shortcode.cta_shop.description' | t }}</div>
          <div class="cta-button--wrapper">
            <a href="{{ settings.cta_shop_link |  default: '#' }}" class="button cta-button">{{ 'bso_shortcode.cta_shop.button_text' | t }}</a>
          </div>
        </div>
      </div>

    </div>
  </div>
</div>