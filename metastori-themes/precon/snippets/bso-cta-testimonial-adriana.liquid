{% assign col_width = width | default: "4" %}
<div class="bso-column bso-column-{{ col_width }}">
  <div class="shortcode shortcode-cta cta-widget cta-testimonial {% if col_width == "12" %}cta-fullsize mg-top{% endif %}">
    <div class="cta--wrapper portrait-mode">

      <div class="cta-image-container">
        <div class="cta-image--wrapper">
          <div class="aspect-ratio">
            <img
              src="https://cdn.shopify.com/s/files/1/0904/4639/7774/files/cta-adriana.jpg?v=1757078700"
              class="cta-image cta-testimonial--image"
              alt="Testimonial Image"
            >
          </div>
        </div>
         <div class="cta-button--wrapper">
          <a href="{{ settings.cta_testimonial_adriana_link | default: '#' }}" class="button cta-button">{{ 'bso_shortcode.cta_testimonial_adriana.button_text' | t }} →</a>
        </div>
      </div>

    </div>
  </div>
</div>