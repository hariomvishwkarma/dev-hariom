{%- comment -%}
  Knowledge Base article list — recreates HubSpot's `hs-kb-category-article-list`.

  Reusable across the category listing, each subcategory section, and (later)
  the KB home grid. Collapses to `limit` items with a pure-CSS "show more"
  toggle (checkbox hack — no JavaScript).

  Accepts:
    articles {array}   list of `knowledgebase_faq` metaobjects (pass the `.value`)
    id       {string}  unique id used to scope the toggle (e.g. the parent handle)
    limit    {number}  visible items before collapsing (default 5)
{%- endcomment -%}

{%- liquid
  assign visible = limit | default: 5
  assign total = articles.size
  assign toggle_id = 'kb-more-' | append: id
-%}

{%- if total > 0 -%}
  <div class="kb-article-list__wrap">
    {%- if total > visible -%}
      <input type="checkbox" class="kb-article-list__more-toggle" id="{{ toggle_id }}" aria-label="{{ 'bso.general.show_more' | t }}" hidden>
    {%- endif -%}

    <ul class="kb-article-list">
      {%- for faq in articles -%}
        <li class="kb-article-list__item{% if forloop.index > visible %} kb-article-list__item--extra{% endif %}">
          <a class="kb-article-list__link" href="{{ faq.system.url }}">{{ faq.question }}</a>
        </li>
      {%- endfor -%}
    </ul>

    {%- if total > visible -%}
      <label class="kb-article-list__toggle" for="{{ toggle_id }}">
        <span class="kb-article-list__toggle-text" data-collapsed="{{ 'bso.general.show_more' | t }}" data-expanded="{{ 'bso.general.show_less' | t }}"></span>
        <span class="kb-article-list__toggle-icon" aria-hidden="true"></span>
      </label>
    {%- endif -%}
  </div>
{%- endif -%}
