{% assign col_width = width | default: "12" %}
<div class="bso-column bso-column-{{ col_width }}">
  <div class="shortcode shortcode-cta cta-dietplan {% if col_width == "12" %}cta-fullsize mg-top{% elsif col_width > "6" %}cta-gtsix{% endif %}">
    <div class="cta--wrapper">

      <div class="cta-image-container">
        <div class="cta-image--wrapper">
          <div class="aspect-ratio">
            <img
              src="https://cdn.shopify.com/s/files/1/0904/4639/7774/files/cta-dietplan.png?v=1756465850"
              class="cta-image cta-dietplan--image"
              alt="{{ 'bso_shortcode.cta_diet_plan.header' | t }}"
            >
          </div>
        </div>
      </div>

      <div class="cta-content">
        <div class="cta-content--wrapper">
          <div class="cta-header">{{ 'bso_shortcode.cta_diet_plan.header' | t }}</div>
          <div class="cta-description">{{ 'bso_shortcode.cta_diet_plan.description' | t }}</div>
          <div class="cta-button--wrapper">
            <a href="{{ settings.cta_dietplan_link | default: "#" }}" class="button cta-button">{{ 'bso_shortcode.cta_diet_plan.button_text' | t }}</a>
          </div>
        </div>
      </div>

    </div>
  </div>
</div>