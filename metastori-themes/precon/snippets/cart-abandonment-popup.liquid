{% comment %}
  Cart Abandonment Reminder Popup
  - Rendered only when the cart has items (checked via Liquid)
  - Hidden by default; cart-abandonment-popup.js shows it after 5 s
    if sessionStorage flag 'precon_cart_session' is absent (= new session)
{% endcomment %}

{% if cart.item_count > 0 %}
  {%- assign first_item = cart.items | first -%}
  {%- assign second_item = cart.items[1] -%}
  {%- assign remaining_count = 0 -%}
  {%- for line_item in cart.items -%}
    {% unless line_item.properties._addon_item %}{%- assign remaining_count = remaining_count | plus:1 -%}{% endunless %}
  {%- endfor -%}
  {%- assign remaining_count = remaining_count | minus:1 -%}

  <style>
    /* ── Overlay ──────────────────────────────────────────────── */
    .precon-cart-popup-container {
      position: fixed;
      inset: 0;
      z-index: 999;
      background: transparent;
      display:none;
    }
    #precon-cart-popup-overlay {
      position: fixed;
      inset: 0;
      z-index: 1;
      background: transparent;
    }

    /* ── Popup Card ───────────────────────────────────────────── */
    #precon-cart-popup {
      position: absolute;
      top: 110px;
      right: 20px;
      z-index: 9999;
      width: 281px;
      background: #ffffff;
      border-radius: 8px;
      padding: 16px 16px 12px;
      opacity: 0;
      transform: translateY(-10px);
      transition: opacity 0.35s ease, transform 0.35s ease;
      box-shadow: 0px 0px 4px 0px #00000040;
    }

    .sticky-header-start #precon-cart-popup{
      top:70px;
    }

    #precon-cart-popup.is-visible {
      opacity: 1;
      transform: translateY(0);
    }

    /* ── Popup: Arrow / Caret pointing up-right ───────────────── */
    #precon-cart-popup::before {
      content: '';
      position: absolute;
      top: -10px;
      right: 28px;
      border-left: 10px solid transparent;
      border-right: 10px solid transparent;
      border-bottom: 10px solid #ffffff;
      filter: drop-shadow(0 -3px 4px rgba(0,0,0,0.08));
    }

    /* ── Header ───────────────────────────────────────────────── */
    .precon-popup__header {
      display: flex;
      align-items: center;
      justify-content: space-between;
    }

    .precon-popup__title-wrap {
      display: flex;
      align-items: center;
      gap: 4px;
    }

    .precon-popup__title-wrap svg {
      flex-shrink: 0;
      color: #290907;
    }

    .precon-popup__title {
      font-size: 14px;
      font-weight: 700;
      color: #290907;
      margin: 0;
      line-height: 150%;
      font-family: "Figtree-800";
    }

    .precon-popup__close {
      background: none;
      border: none;
      cursor: pointer;
      padding: 4px;
      line-height: 1;
      color: #888;
      transition: color 0.2s;
      display:none;
    }

    .precon-popup__close:hover {
      color: #290907;
    }
    .precon-cart-popup-content {
      display: flex;
      flex-direction: column;
      gap: 16px;
    }

    .precon-popup__subtitle {
      font-size: 11.6px;
      margin: 0;
      line-height: 150%;
      color: #290907CC;
    }

    /* ── Product Row ──────────────────────────────────────────── */
    .precon-popup__product {
      display: flex;
      align-items: center;
      gap: 8px;
    }

    .precon-popup__product-img {
      width: 80px;
      height: 80px;
      object-fit: cover;
      border-radius: 8px;
      flex-shrink: 0;
      background: #EFECE4;
    }

    .precon-popup__product-name {
      font-size: 14px;
      font-weight: 700;
      color: #290907;
      line-height: 150%;
      font-family: "Figtree-800";
    }

    /* ── More Products Line ───────────────────────────────────── */
    .precon-popup__more {
      text-align: center;
      font-size: 11.6px;
      color: #290907CC;
      padding: 4px 0;
      background: #FAF9F7;
      line-height: 150%;
      border-radius: 8px;
      margin-top: 8px;
    }

    /* ── CTA Button ───────────────────────────────────────────── */
    .precon-popup__cta {
      display: block;
      width: 100%;
      padding: 13px 0 12px;
      background: #3DADBB;
      color: #ffffff;
      font-size: 11.6px;
      font-weight: 700;
      letter-spacing: 10%;
      text-align: center;
      text-decoration: none;
      border-radius: 50px;
      border: none;
      cursor: pointer;
      transition: background 0.2s;
      line-height: 1;
      min-height: 38px;
    }

    /* ── Mobile responsive ────────────────────────────────────── */
    @media (max-width: 480px) {
      #precon-cart-popup {
        width: calc(100vw - 32px);
        right: 10px;
        top: 115px;
        max-width: 281px;
      }
      #precon-cart-popup::before{
        right: 16px;
      }
    }

    {% comment %} .active-versionB .cart-popup-versionC{
      display:none;
    }
    .active-versionC .cart-popup-versionB{
      display:none;
    }
    .cart-popup-versionC .precon-popup__title-wrap{
      justify-content: center;
      width: 100%;
    }
    .cart-popup-versionC .precon-popup__subtitle{
      text-align: center;
    } {% endcomment %}
    .pp-product-grid {
      display: flex;
      align-items: stretch;
      gap: 4px;
      justify-content: center;
    }
    .precon-popup__product-item {
      max-width: 80px;
      flex: 1;
      display: flex;
      align-items: center;
      justify-content: center;
      background: #EFECE4;
      border-radius: 8px;
      overflow: hidden;
      font-size: 14px;
      font-weight: 700;
      font-family: "Figtree-800";
    }
    .precon-popup__item-img {
      max-width: 80px;
      height: 80px;
    }
  </style>
  <div class="precon-cart-popup-container container">
    <div id="precon-cart-popup-overlay" aria-hidden="true"></div>

    <div
      id="precon-cart-popup"
      role="dialog"
      aria-modal="true"
      aria-label="Dein Warenkorb"
      data-item-count="{{ cart.item_count }}"
    >
      <div class="precon-cart-popup-content cart-popup-versionB">
          <div class="precon-popup__header">
            <div class="precon-popup__title-wrap">
              <svg width="16" height="16" viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg">
                <path d="M5.5 13.25C5.63807 13.25 5.75 13.3619 5.75 13.5C5.75 13.6381 5.63807 13.75 5.5 13.75C5.36193 13.75 5.25 13.6381 5.25 13.5C5.25 13.3619 5.36193 13.25 5.5 13.25Z" fill="#343330" stroke="#290907" stroke-width="1.5"/>
                <path d="M12 13.25C12.1381 13.25 12.25 13.3619 12.25 13.5C12.25 13.6381 12.1381 13.75 12 13.75C11.8619 13.75 11.75 13.6381 11.75 13.5C11.75 13.3619 11.8619 13.25 12 13.25Z" fill="#343330" stroke="#290907" stroke-width="1.5"/>
                <path d="M1 2H2.5L4.79688 10.2675C4.85533 10.4781 4.98114 10.6637 5.15507 10.796C5.32901 10.9282 5.54148 10.9999 5.76 11H11.9375C12.1561 11 12.3687 10.9284 12.5428 10.7961C12.7169 10.6638 12.8428 10.4782 12.9012 10.2675L14.5 4.5H3.19438" stroke="#343330" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
              <p class="precon-popup__title">Dein Warenkorb</p>
            </div>
            <button class="precon-popup__close" id="precon-popup-close" aria-label="Schließen">
              <svg width="14" height="14" viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                <path d="M15.28 14.22a.75.75 0 1 1-1.06 1.06L8 9.06l-6.22 6.22a.75.75 0 0 1-1.06-1.06L6.94 8 .72 1.78A.75.75 0 0 1 1.78.72L8 6.94 14.22.72a.75.75 0 0 1 1.06 1.06L9.06 8l6.22 6.22Z" fill="currentColor"/>
              </svg>
            </button>
          </div>

          <p class="precon-popup__subtitle">Es befinden sich noch Produkte<br>in Deinem Warenkorb.</p>

          <div class="pp-product-count">
            <div class="precon-popup__product">
              {%- if first_item.image != blank -%}
                {{-
                  first_item.image
                  | image_url: width: 160
                  | image_tag:
                    class: 'precon-popup__product-img',
                    loading: 'lazy',
                    alt: first_item.product.title | escape
                -}}
              {%- else -%}
                <div class="precon-popup__product-img"></div>
              {%- endif -%}
              <span class="precon-popup__product-name">{{ first_item.product.title }}</span>
            </div>

            {%- if remaining_count > 0 -%}
              <div class="precon-popup__more">+{{ remaining_count }} weitere Produkte</div>
            {%- endif -%}
          </div>

          <button class="precon-popup__cta">ZUM WARENKORB</button>

      </div>

      {% comment %} <div class="precon-cart-popup-content cart-popup-versionC">
          <div class="precon-popup__header">
            <div class="precon-popup__title-wrap">
              <p class="precon-popup__title">Verpass Deine Chance nicht!</p>
            </div>
            <button class="precon-popup__close" id="precon-popup-close" aria-label="Schließen">
              <svg width="14" height="14" viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                <path d="M15.28 14.22a.75.75 0 1 1-1.06 1.06L8 9.06l-6.22 6.22a.75.75 0 0 1-1.06-1.06L6.94 8 .72 1.78A.75.75 0 0 1 1.78.72L8 6.94 14.22.72a.75.75 0 0 1 1.06 1.06L9.06 8l6.22 6.22Z" fill="currentColor"/>
              </svg>
            </button>
          </div>

          <p class="precon-popup__subtitle">Es befinden sich noch <br> tolle Produkte im Warenkorb.</p>

          <div class="pp-product-grid">
            {%- assign remaining_count = remaining_count | plus:1 -%}
            {% if remaining_count > 3 %}
              <div class="precon-popup__product-item">
                {%- if first_item.image != blank -%}
                  {{- first_item.image | image_url: width: 160 | image_tag: class: 'precon-popup__item-img', loading: 'lazy', alt: first_item.product.title | escape -}}
                {%- endif -%}
              </div>
              <div class="precon-popup__product-item">
                {%- if second_item.image != blank -%}
                  {{- second_item.image | image_url: width: 160 | image_tag: class: 'precon-popup__item-img', loading: 'lazy', alt: second_item.product.title | escape -}}
                {%- endif -%}
              </div>
              <div class="precon-popup__product-item">
                <span>+{{ remaining_count | minus:2 }}</span>
              </div>
            {% else %}
              {%- for line_item in cart.items -%}
                {% unless line_item.properties._addon_item %}
                  <div class="precon-popup__product-item">
                    {%- if line_item.image != blank -%}
                      {{- line_item.image | image_url: width: 160 | image_tag: class: 'precon-popup__item-img', loading: 'lazy', alt: line_item.product.title | escape -}}
                    {%- endif -%}
                  </div>
                {% endunless %}
              {%- endfor -%}
            {% endif %}

          </div>

          <button class="precon-popup__cta">ZUM WARENKORB</button>

      </div> {% endcomment %}

    </div>
  </div>
  <script>
    document.addEventListener('DOMContentLoaded', function () {
      var popupContainer = document.querySelector('.precon-cart-popup-container');
      var popup = document.getElementById('precon-cart-popup');

      // 1. Cart is empty (Liquid did not render the popup) → nothing to do.
      if (!popupContainer) return;

      // 2. Already shown during this browser session → skip.
      if (sessionStorage.getItem('precon_cart_session')) return;

      // 3. Mark as shown for this session immediately (prevents race on fast reload).
      sessionStorage.setItem('precon_cart_session', 'true');

      // 4. Show popup after 5 seconds.
      setTimeout(function () {
        popupContainer.style.display = 'block';
        requestAnimationFrame(function () {
          requestAnimationFrame(function () {
            popup.classList.add('is-visible');
          });
        });
      }, 5000);

      window.addEventListener('scroll', () => {
        if (window.scrollY > 40) {
          document.body.classList.add('sticky-header-start');
        } else {
          document.body.classList.remove('sticky-header-start');
        }
      });

    });
  </script>
{% endif %}
