{% comment %}
  Renders Author block
  Accepts:
  - section: {Object} passes in the section information.
  - block: {Object} passes in the block information.
  - article: {Object} of the current blog/article

  Usage:
  {% render 'author-block',
    block: block,
    article: article
  %}
{% endcomment %}
{{ 'section-author.css' | asset_url | stylesheet_tag }}
{%- style -%}
  #shopify-section-{{ section.id }} .article-template__author-block.sidebar-enabled .author-block {
    margin-top: 20px;
  }

  #shopify-section-{{ section.id }} .author-block {
    padding-top: {{ block.settings.sec_padding_top }}px;
    padding-bottom: {{ block.settings.sec_padding_bottom }}px;
  }

  #shopify-section-{{ section.id }} blog-author .author-container {
    padding-top: {{ block.settings.a_padding_top }}px;
    padding-bottom: {{ block.settings.a_padding_bottom }}px;
  }

  #shopify-section-{{ section.id }} .coauthor-container {
    padding-top: {{ block.settings.ca_padding_top }}px;
    padding-bottom: {{ block.settings.ca_padding_bottom }}px;
  }

  {% if block.settings.author_img_bg %}
    #shopify-section-{{ section.id }} .author-img-wrapper {
      background: {{ block.settings.author_img_bg }};
    }
  {% endif %}

  {% if block.settings.header_text_color %}
    #shopify-section-{{ section.id }} .author-header {
      color: {{ block.settings.header_text_color }};
    }
  {% endif %}

  {% if block.settings.author_description_bg %}
    #shopify-section-{{ section.id }} .author-description {
      background: {{ block.settings.author_description_bg }};
    }
  {% endif %}

  {% if block.settings.author_description_font_color %}
    #shopify-section-{{ section.id }} .author-description-wrapper .metafield-rich_text_field {
      color: {{ block.settings.author_description_font_color }}
    }
  {% endif %}

  {% if block.settings.ad_side_padding %}
    #shopify-section-{{ section.id }} .author-description-wrapper {
      padding-left: {{ block.settings.ad_side_padding }}px;
      padding-right: {{ block.settings.ad_side_padding }}px;
    }
  {% endif %}

  {% if block.settings.author_img_font_color %}
    #shopify-section-{{ section.id }} .author-info,
    #shopify-section-{{ section.id }} .author-info a {
      color: {{ block.settings.author_img_font_color }};
    }
  {% endif %}

  {% if block.settings.author_social_links_color %}
    #shopify-section-{{ section.id }} .author-links .icon g,
    #shopify-section-{{ section.id }} .author-links .icon path {
      fill: {{ block.settings.author_social_links_color }};
    }
  {% endif %}

  {% if block.settings.coauthor_bg_color %}
    #shopify-section-{{ section.id }} .coauthor-card {
      background-color: {{ block.settings.coauthor_bg_color }};
    }
  {% endif %}

  {% if block.settings.coauthor_text_color %}
    #shopify-section-{{ section.id }} .coauthor-card {
      color: {{ block.settings.coauthor_text_color }};
    }
    #shopify-section-{{ section.id }} .coauthor-link-item .icon svg,
    #shopify-section-{{ section.id }} .coauthor-link-item .icon path,
    #shopify-section-{{ section.id }} .coauthor-link-item .icon g {
      fill: {{ block.settings.coauthor_text_color }};
    }
  {% endif %}

  {% if block.settings.show_author_link_button %}
    #shopify-section-{{ section.id }} .author-button {
      padding: {{ block.settings.ab_padding_top_bottom }}px 0;
    }

    #shopify-section-{{ section.id }} .author-button .button {
      color: {{ block.settings.author_button_text_color }};
      background-color: {{ block.settings.author_button_color }};
      line-height: 1.5rem;
      padding: 10px;
      font-size: 10px;
      font-weight: 600;
    }

    #shopify-section-{{ section.id }} .author-button .button::after {
      --color-button: {{ block.settings.author_button_color.red }}, {{ block.settings.author_button_color.green }}, {{ block.settings.author_button_color.blue }};
    }

    #shopify-section-{{ section.id }} .coauthor-container .align--left {
      text-align: left;
    }
    
    #shopify-section-{{ section.id }} .coauthor-container .align--center {
      text-align: center;
    }

    #shopify-section-{{ section.id }} .coauthor-container .align--right {
      text-align: right;
    }
  {% endif %}

  @media screen and (min-width: 750px) {
    #shopify-section-{{ section.id }}-padding {
      padding-top: {{ block.settings.padding_top }}px;
      padding-bottom: {{ block.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

{% assign count = 0 %}
{% for author in article.metafields.bso.author.value %}
  {% assign count = count | plus: 1 %}
{% endfor %}

<div class="author-block">
  {% for author in article.metafields.bso.author.value limit:1 %}
    <blog-author>
      <div class="author-container" id="author-{{ author.name.value | replace: ' ', '-' | downcase }}">
        <div class="row">
          <div class="author-img">
            <div class="author-img-wrapper">
              <a href="{{ author.system.url }}">
                <picture>
                  {% if author.image.value %}
                    {{- author.image.value | image_url: width: 800 | image_tag: loading: 'eager', sizes: '100vw', sizes: '400,500,600,700,800' -}}
                  {% else %}
                    {{ 'image' | placeholder_svg_tag: 'author-placeholder' }}
                  {% endif %}
                </picture>
              </a>
            </div>
          </div>

          <div class="author-description author-info">
            <div class="author-description-wrapper">
              {% if block.settings.header_text != blank %}
                <h3 class="author-header">{{ block.settings.header_text }}</h3>
              {% endif %}

              {% if author.name.value %}
                <div class="author-info-item name">
                  <span>{{ author.name.value }}</span>
                </div>
              {% endif %}

              {% if author.short_description != blank %}
                {{ author.short_description | metafield_tag }}
              {% endif %}

              <div class="author-links">
                {% assign author_data = author.linklist.value  %}
                {%- for info in author_data -%}
                  {% if info contains 'mailto' %}
                    <div class="author-link-item mailto">
                      <a href='{{ info }}'>
                        {%- render 'icon-global' , icon: 'mail' -%}
                      </a>
                    </div>
                  {% endif %}

                  {% if info contains 'tel' %}
                    <div class="author-link-item tel">
                      <a href="{{ info }}">
                        {%- render 'icon-global' , icon: 'phone-flip' -%}
                      </a>
                    </div>
                  {% endif %}

                  {% if info contains 'linkedin' %}
                    <div class="author-link-item linkedin">
                      <a href="{{ info }}">
                        {%- render 'icon-global' , icon: 'linkedin' -%}
                      </a>
                    </div>
                  {% endif %}
                  
                  {% if info contains 'instagram' %}
                    <div class="author-link-item instagram">
                      <a href="{{ info }}">
                        {%- render 'icon-global' , icon: 'instagram' -%}
                      </a>
                    </div>
                  {% endif %}

                  {% if info contains 'tiktok' %}
                    <div class="author-link-item tiktok">
                      <a href="{{ info }}">
                        {%- render 'icon-global' , icon: 'tiktok' -%}
                      </a>
                    </div>
                  {% endif %}

                  {% if info contains 'twitter' %}
                    <div class="author-link-item twitter">
                      <a href="{{ info }}">
                        {%- render 'icon-global' , icon: 'twitter' -%}
                      </a>
                    </div>
                  {% endif %}
                {%- endfor -%}
              </div>

              {% if block.settings.show_author_link_button %}
                <div class="author-button">
                  <a class="button" href="{{ author.system.url }}">
                    {%- assign btn_label = block.settings.author_button_text -%}
                    {% if btn_label != blank %} 
                      {{ btn_label }} 
                    {% else %} 
                      {{ 'bso.blog.to_author_page' | t }}
                    {% endif %}
                  </a>
                </div>
              {% endif %}

            </div>
          </div>

        </div>
      </div>
    </blog-author>
  {% endfor %}

  {% if count > 1 %}
    <div class="container">
      <div class="coauthor-container">
        <div class="coauthor-container-wrapper">
          {% if block.settings.co_author_header != blank %}
            <h3 class="align--{{ block.settings.co_author_header_alignment }}">{{ block.settings.co_author_header }}</h3>
          {% endif %}

          <div class="coauthor-list">
            {% for coauthor in article.metafields.bso.author.value offset:1 %}

            <div class="coauthor-card">
              <div class="coauthor-img">
                <div class="coauthor-img-wrapper">
                  <a href="{{ coauthor.system.url }}">
                    <picture>
                      {% if coauthor.image.value %}
                        {{- coauthor.image.value | image_url: width: 800 | image_tag: loading: 'eager', sizes: '100vw', sizes: '400,500,600,700,800' -}}
                      {% else %}
                        {{ 'image' | placeholder_svg_tag: 'author-placeholder' }}
                      {% endif %}
                    </picture>
                  </a>
                </div>
              </div>
              <div class="coauthor-info">
                {% if coauthor.name.value %}
                  <div class="name">
                    <span>{{ coauthor.name.value }}</span>
                  </div>
                {% endif %}

                <div class="coauthor-text">
                  <p> {{ coauthor.description | metafield_tag | strip_html | truncatewords: 10 }}</p>
                </div>
              </div>

              <div class="coauthor-links">
                {% assign author_data = coauthor.linklist.value  %}
                {%- for info in author_data -%}
                  {% if info contains 'mailto' %}
                    <div class="coauthor-link-item mailto">
                      <a href='{{ info }}'>
                        {%- render 'icon-global' , icon: 'mail' -%}
                      </a>
                    </div>
                  {% endif %}

                  {% if info contains 'tel' %}
                    <div class="coauthor-link-item tel">
                      <a href="{{ info }}">
                        {%- render 'icon-global' , icon: 'phone-flip' -%}
                      </a>
                    </div>
                  {% endif %}

                  {% if info contains 'linkedin' %}
                    <div class="coauthor-link-item linkedin">
                      <a href="{{ info }}">
                        {%- render 'icon-global' , icon: 'linkedin' -%}
                      </a>
                    </div>
                  {% endif %}
                  
                  {% if info contains 'instagram' %}
                    <div class="coauthor-link-item instagram">
                      <a href="{{ info }}">
                        {%- render 'icon-global' , icon: 'instagram' -%}
                      </a>
                    </div>
                  {% endif %}

                  {% if info contains 'tiktok' %}
                    <div class="coauthor-link-item tiktok">
                      <a href="{{ info }}">
                        {%- render 'icon-global' , icon: 'tiktok' -%}
                      </a>
                    </div>
                  {% endif %}

                  {% if info contains 'twitter' %}
                    <div class="coauthor-link-item twitter">
                      <a href="{{ info }}">
                        {%- render 'icon-global' , icon: 'twitter' -%}
                      </a>
                    </div>
                  {% endif %}
                {%- endfor -%}
              </div> 
            </div>

            {% endfor %}
          </div>
        </div>
      </div>
    </div>
  {% endif %}

</div>