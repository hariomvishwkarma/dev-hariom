{%- comment -%}
  Knowledge Base breadcrumb.

  Uses the theme's native breadcrumb component (Focal: `.breadcrumb` /
  `.breadcrumb__list` / `.breadcrumb__item` / `.breadcrumb__link`) so it inherits
  the theme's separators, spacing, colour and typography automatically — no
  custom CSS needed.

  Dumb renderer: it knows nothing about metaobject field keys. The calling
  section resolves the trail and passes plain labels/urls.

  Accepts (labels/urls come from the KB Breadcrumb section settings; safe
  defaults are applied here):
    show_home_crumb {boolean} prepend the site Home crumb (theme convention)
    home_label      {string}  site Home crumb label (default: theme translation)
    root_label      {string}  KB root crumb label (default: "Wissensdatenbank")
    root_url        {string}  KB root crumb url (default: /pages/knowledge)
    is_root         {boolean} true on the KB home page (root becomes current)
    current_label   {string}  label of the current page (last crumb)
    current_url     {string}  url of the current page (unused; last crumb is a span)
    parent_label    {string}  optional, e.g. the category on an article page
    parent_url      {string}  optional
{%- endcomment -%}

{%- liquid
  if root_label == blank
    assign root_label = 'Wissensdatenbank'
  endif
  if root_url == blank
    assign root_url = '/pages/knowledge'
  endif
  if home_label == blank
    assign home_label = 'general.breadcrumb.home' | t
  endif
-%}

<nav aria-label="{{ 'general.breadcrumb.title' | t }}" class="breadcrumb text--xsmall text--subdued">
  <ol class="breadcrumb__list" role="list">
    {%- if show_home_crumb -%}
      <li class="breadcrumb__item">
        <a class="breadcrumb__link" href="{{ routes.root_url }}">{{ home_label }}</a>
      </li>
    {%- endif -%}

    <li class="breadcrumb__item">
      {%- if is_root -%}
        <span class="breadcrumb__link" aria-current="page">{{ root_label }}</span>
      {%- else -%}
        <a class="breadcrumb__link" href="{{ root_url }}">{{ root_label }}</a>
      {%- endif -%}
    </li>

  {%- if parent_label != blank -%}
      <li class="breadcrumb__item">
        <a class="breadcrumb__link" href="{{ parent_url }}">{{ parent_label }}</a>
      </li>
    {%- endif -%}

    {%- if current_label != blank -%}
      <li class="breadcrumb__item">
        <span class="breadcrumb__link" aria-current="page">{{ current_label }}</span>
      </li>
    {%- endif -%}
  </ol>
</nav>
