{% assign heading_html_tag = heading_html_tag | default: 'h3' %}
<div {% if settings.stagger_blog_posts_apparition %}reveal{% endif %} class="article-item {% if use_featured_layout %}{% if is_first %}article-item--featured{% else %}article-item--horizontal{% endif %}{% endif %} image-zoom">
  {%- assign recipe_obj = article.metafields.custom.blog_content.value -%}
  {%- if article.image or recipe_obj.bild != blank -%}
    {%- assign loading = 'lazy' -%}
    {%- assign fetchpriority = 'low' -%}
    {% if index <= 3 %}
      {%- assign loading = 'eager' -%}
      {%- assign fetchpriority = 'high' -%}
    {% endif %}

    {%- assign image_to_show = recipe_obj.bild| default: article.image -%}

    {%- if enable_bso_card_styles -%}
      <a href="{{ article.url }}" class="article-item__image-container bso-article-card">
        <div class="aspect-ratio">
          {{- image_to_show | image_url: width: '800px' | image_tag: loading: loading, fetchpriority: fetchpriority, sizes: '(max-width: 740px) 81vw, (max-width: 999px) 37vw, 425px', sizes: '600,700,800', class: 'article-item__image' -}}
          {%- if use_featured_layout and is_first -%}
            <span class="article-item__arrow prev-next-button prev-next-button--next">{% render 'icon' with 'nav-arrow-right', direction_aware: true %}</span>
          {%- else -%}
            <span class="article-item__arrow prev-next-button prev-next-button--small prev-next-button--next">{% render 'icon' with 'nav-arrow-right', direction_aware: true, width: 15, height: 12 %}</span>
          {%- endif -%}
        </div>
      </a>
    {% else %}
      <a href="{{ article.url }}" class="article-item__image-container">
        {{- image_to_show | image_url: width: '800px' | image_tag: loading: loading, fetchpriority: fetchpriority, sizes: '(max-width: 740px) 81vw, (max-width: 999px) 37vw, 425px', sizes: '600,700,800', class: 'article-item__image' -}}
        {%- if use_featured_layout and is_first -%}
          <span class="article-item__arrow prev-next-button prev-next-button--next">{% render 'icon' with 'nav-arrow-right', direction_aware: true %}</span>
        {%- else -%}
          <span class="article-item__arrow prev-next-button prev-next-button--small prev-next-button--next">{% render 'icon' with 'nav-arrow-right', direction_aware: true, width: 15, height: 12 %}</span>
        {%- endif -%}
      </a>
    {%- endif -%}
  {%- else -%}
    {%- if enable_bso_card_styles -%}
      <a href="{{ article.url }}" class="article-item__image-container bso-article-card">
        <div class="aspect-ratio"></div>
      </a>
    {%- endif -%}
  {%- endif -%}

  <div class="article-item__content text-container">
    {%- assign cook_time = recipe_obj.kochzeit -%}
    {%- assign diat = recipe_obj.diat -%}
    {%- assign season = recipe_obj.saisone -%}
    {%- assign course = recipe_obj.gange -%}
    {%- if cook_time != blank or diat != blank or season != blank or course != blank -%}
      <div class="article-item__metainfo">
        <ul>
          {% if cook_time %}
            <div class="article-item__icon">
              <img src="https://cdn.shopify.com/s/files/1/0904/4639/7774/files/time-cook_1.svg?v=1756270214">
              <span>{{ cook_time }} Minuten</span>
            </div>
          {% endif %}
          {% if diat %}
            <div class="article-item__icon">
              <img src="https://cdn.shopify.com/s/files/1/0904/4639/7774/files/diat_1.svg?v=1756270213">
              <span>{{ diat }}</span>
            </div>
          {% endif %}
          {% if season %}
            <div class="article-item__icon">
              <img src="https://cdn.shopify.com/s/files/1/0904/4639/7774/files/Saison_1.svg?v=1756270213">
              <span>{{ season }}</span>
            </div>
          {% endif %}
          {% if course %}
            <div class="article-item__icon">
              <img src="https://cdn.shopify.com/s/files/1/0904/4639/7774/files/gange_1.svg?v=1756270213">
              <span>{{ course }}</span>
            </div>
          {% endif %}
        </ul>
      </div>
    {% endif %}
    
    {%- if section.settings.show_category and article.tags.size > 0 -%}
      {%- assign blog_url_parts = article.url | split: '/' -%}
      {%- assign blog_url = '' -%}

      {%- for blog_url_part in blog_url_parts -%}
        {%- unless forloop.last -%}
          {%- assign blog_url = blog_url | append: '/' | append: blog_url_part -%}
        {%- endunless -%}
      {%- endfor -%}

      <a href="{{ blog_url | remove_first: '/' }}/tagged/{{ article.tags.first | handle }}" class="article-item__category heading heading--xsmall">{{ article.tags.first }}</a>
    {%- endif -%}

    <{{ heading_html_tag }} class="article-item__title heading {{ heading_size }}">
      <a href="{{ article.url }}">{{ article.title }}</a>
    </{{- heading_html_tag -}}>

    {%- if section.settings.show_excerpt and article.excerpt_or_content != blank -%}
      <div class="article-item__excerpt text--small">
        {{- article.excerpt_or_content | strip_html | truncate: 200 -}}
      </div>
    {%- endif -%}
  </div>
</div>