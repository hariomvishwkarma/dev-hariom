{%- for property in line_item.properties -%}
    {% if property.first == '_group' %}
    {% assign group_id = property.last %}
    <div class="line_item_acc line_item_acc_b hide_acc_content">
        <div class="line_item_toggle">
            <span class="line_item_acc_text">Paketinhalt anzeigen</span>
            <svg width="12" height="12" viewBox="0 0 12 12" fill="none" xmlns="http://www.w3.org/2000/svg">
                <path d="M9.75 7.5L6 3.75L2.25 7.5" stroke="#290907" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
        </div>
        <div class="line_item_acc_contnet">
        {% for item in cart.items %}
            {% if item == line_item %}{%continue %}{% endif %}
            {%- for child_property in item.properties -%}
                {% if child_property.first == '_group' and child_property.last == group_id %}
                    <div class="bdl_item">
                        <img src="{{ item.image | image_url }}" width="20px" height="20px" alt="{{ item.title }}">
                        <span class="bdl_text">{{ item.quantity }} x 
                            {% if item.product.metafields.custom.bundle_product_title != blank %}
                                {{ item.product.metafields.custom.bundle_product_title }}
                            {% else %}
                                {{ item.title }}
                            {% endif %}
                        </span>
                    </div>
                {% endif %}
            {%- endfor -%}
        {% endfor %}
        </div>
    </div>

    <div class="line_item_acc line_item_acc_c">
        <div class="line_item_toggle">
            <span class="line_item_acc_text">Paketinhalt anzeigen</span>
            <svg width="12" height="12" viewBox="0 0 12 12" fill="none" xmlns="http://www.w3.org/2000/svg">
                <path d="M9.75 7.5L6 3.75L2.25 7.5" stroke="#290907" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
        </div>
        <div class="line_item_acc_contnet">
        {% for item in cart.items %}
            {% if item == line_item %}{%continue %}{% endif %}
            {%- for child_property in item.properties -%}
                {% if child_property.first == '_group' and child_property.last == group_id %}
                    <div class="bdl_item">
                        <img src="{{ item.image | image_url }}" width="20px" height="20px" alt="{{ item.title }}">
                        <span class="bdl_text">{{ item.quantity }} x 
                            {% if item.product.metafields.custom.bundle_product_title != blank %}
                                {{ item.product.metafields.custom.bundle_product_title }}
                            {% else %}
                                {{ item.title }}
                            {% endif %}
                        </span>
                    </div>
                {% endif %}
            {%- endfor -%}
        {% endfor %}
        </div>
    </div>
    {% endif %}
{%endfor %}