{%- comment -%}
Render content_grid
Usage:
  [[content_grid post_type="recipe"]]
  parameters:
    post_type: type of posts to display in the grid (e.g., recipe, article)
{%- endcomment -%}
{%- capture post_type -%}{%- render 'shortcode-param', keys: keys, values: values, param: 'post_type' -%}{%- endcapture -%}

{% if post_type != blank %}
  {% if post_type == 'recipe' %}
    {% render 'bso-recipe-grid', post_type: post_type %}
  {% endif %}
{% endif %}