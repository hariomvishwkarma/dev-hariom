
{%- comment -%}
Render instagram embeds
Usage:
  [instagram post_id="AsgFgHjKlMn" width="400" height="600"]
  pameters:
    post_id: required, the id of the instagram post
    width: optional, the width of the embed, default is 400
    height: optional, the height of the embed, default is 600
{%- endcomment -%}

{%- capture instagram_post_id -%}{%- render 'shortcode-param', keys: keys, values: values, param: 'post_id' -%}{%- endcapture -%}
{%- capture width -%}{%- render 'shortcode-param', keys: keys, values: values, param: 'width' -%}{%- endcapture -%}
{%- capture height -%}{%- render 'shortcode-param', keys: keys, values: values, param: 'height' -%}{%- endcapture -%}

{% if width == blank %}
  {% assign width = 400 %}
{% endif %}
{% if height == blank %}
  {% assign height = 600 %}
{% endif %}

{% if instagram_post_id != blank %}
  <div class="shortcode shortcode-instagram">
    <iframe class="instagram-iframe" src="https://www.instagram.com/p/{{ instagram_post_id }}/embed" width="{{ width }}" height="{{ height }}" frameborder="0" scrolling="no" allowtransparency="true"></iframe>
  </div>
{% endif %}