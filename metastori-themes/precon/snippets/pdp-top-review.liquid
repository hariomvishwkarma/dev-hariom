<div class="pdp-review-custom-top">
    {% if request.origin == 'https://www.precon.ch' %}
        <!-- Begin eTrusted widget tag -->
        <etrusted-widget data-etrusted-widget-id="wdg-43a32878-df2a-48af-8822-4f88408327fc" data-sku="{{ product.selected_or_first_available_variant.sku }}"></etrusted-widget>
        <!-- End eTrusted widget tag -->
        {% else %}
        <!-- Begin eTrusted widget tag -->
        <etrusted-widget data-etrusted-widget-id="wdg-ebb4bb75-48ce-456e-8cd2-f8f0b7e3432b" data-sku="{{ product.selected_or_first_available_variant.sku }}"></etrusted-widget>
        <!-- End eTrusted widget tag -->
    {% endif %}
</div>

<script>
document.addEventListener("click", function (e) {
  const trigger = e.target.closest(".pdp-review-custom-top");
  if (!trigger) return;

  const target = document.querySelector(".review-pdp-widget");
  if (!target) return;

  // get sticky elements
  const header = document.querySelector("store-header");
  const stickyForm = document.querySelector(".product-sticky-form");

  let offset = 0;

  if (header) offset += header.offsetHeight;
  if (stickyForm) offset += stickyForm.offsetHeight;

  function scrollToExact() {
    const top = target.getBoundingClientRect().top + window.pageYOffset - offset;

    window.scrollTo({
      top: top,
      behavior: "smooth"
    });
  }

  // double scroll for accuracy
  scrollToExact();
  setTimeout(scrollToExact, 300);
});
</script>

<style>
.pdp-review-custom-top etrusted-widget {
pointer-events:none;
}
.pdp-review-custom-top  {
cursor:pointer;
}
</style>