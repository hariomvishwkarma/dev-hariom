{%- assign blog_handle_list = 'essen-trinken, diaet-ernaehrung, erfahrungen, lebensstil, so-geht-abnehmen' -%}
{%- assign blog_handles = blog_handle_list | split: ',' -%}

{% for handle in blog_handles %}
  {%- assign handle_sanitize = handle | strip -%}
  {%- assign blog_handle = blogs[handle_sanitize].handle -%}
  {%- assign article_handle_text = blog_handle | append: '/' | append: article_handle -%}
  {%- assign article_object = articles[article_handle_text] -%}
  {%- if article_object.title != blank -%}
    {%- break -%}
  {%- endif -%}
{% endfor %}

{% if article_object != blank %}
  <div class="shortcode shortcode-cta cta-article cta-fullsize mg-top">
    <div class="cta--wrapper">
      <div class="cta-image-container">
        <div class="cta-image--wrapper">
          <div class="aspect-ratio">
            {{- article_object.image | image_url: width: '1000px' | image_tag: loading: 'lazy', fetchpriority: 'low', sizes: '(max-width: 740px) 81vw, (max-width: 999px) 37vw, 425px', sizes: '600,700,800,1000', class: 'article-item__image' -}}
          </div>
        </div>
      </div>
      <div class="cta-content">
        {% if name != blank %}
          <div class="badge">{{ 'bso_shortcode.cta_article.name' | t: name: name }}</div>
        {% endif %}
        <div class="title">{{ article_object.title }}</div>
        {% if article_object.metafields.bso.subtitle %}
          <div class="subtitle">{{ article_object.metafields.bso.subtitle }}</div>
        {% endif %}
        <div class="description">{{ 'bso_shortcode.cta_article.description' | t }}</div>
        <div class="cta-button--wrapper">
          <a href="{{ article_object.url }}" class="button cta-button">{{ 'bso_shortcode.cta_article.button_text' | t }}</a>
        </div>
      </div>
    </div>
  </div>
{% endif %}