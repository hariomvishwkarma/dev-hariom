{%- comment -%}
Render Product
Usage:
  [product product_handle="the-complete-snowboard"]
  pameters:
    product_handle: required, the product handle to render
{%- endcomment -%}

{%- capture product_handle -%}{%- render 'shortcode-param', keys: keys, values: values, param: 'product_handle' -%}{%- endcapture -%}

<div class="shortcode shortcode--product">
  {%- if product_handle != blank -%}
    {%- render 'product-feature', product_handle: product_handle, break_point: 'sm' -%}
  {%- endif -%}
</div>