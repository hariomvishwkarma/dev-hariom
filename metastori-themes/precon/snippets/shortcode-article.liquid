{%- comment -%}
Render Article
Usage:
  [article article_handle="the-power-of-minimalism-in-web-design"]
  pameters:
    article_handle: required, the article handle to render
{%- endcomment -%}

{%- capture article_handle -%}{%- render 'shortcode-param', keys: keys, values: values, param: 'article_handle' -%}{%- endcapture -%}
{%- assign blog_handle_list = 'news, scentnews' -%}
{%- assign blog_handles = blog_handle_list | split: ',' -%}

{% for handle in blog_handles %}
  {%- assign handle_sanitize = handle | strip -%}
  {%- assign article_handle_text = handle_sanitize | append: '/' | append: article_handle -%}
  {%- assign article_object = articles[article_handle_text] -%}
  {%- if article_object.title != blank -%}
    {%- break -%}
  {%- endif -%}
{% endfor %}

{% if article_object.title != blank %}
  <div class="shortcode shortcode-article">
    {%- render 'blog-post-card', article: article_object, show_excerpt: true, show_date: false, show_author: false, show_comments_count: false, show_category: true, heading_size: 'h5', sizes: sizes -%}

    {% comment %} {%- render 'article-item', article: article_object, heading_size: 'h5' -%} {% endcomment %}
  </div>
{% endif %}