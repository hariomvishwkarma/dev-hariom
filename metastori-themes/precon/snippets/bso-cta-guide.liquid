{% assign col_width = width | default: "6" %}
<div class="bso-column bso-column-{{ col_width }}">
  <div class="shortcode shortcode-cta cta-guide {% if col_width == "12" %}cta-fullsize mg-top{% endif %}">
    <div class="cta--wrapper">

      <div class="cta-image-container">
        <div class="cta-image--wrapper">
          <img
            src="https://cdn.shopify.com/s/files/1/0904/4639/7774/files/cta-guide.png?v=1757072469"
            class="cta-image cta-guide--image"
            alt="{{ 'bso_shortcode.cta_guide.header' | t }}"
          >
        </div>
      </div>

      <div class="cta-content">
        <div class="cta-content--wrapper">
          <div class="cta-header">{{ 'bso_shortcode.cta_guide.header' | t }}</div>
          <div class="cta-description">{{ 'bso_shortcode.cta_guide.description' | t }}</div>
          {% if col_width == "12" %}
            <div class="cta-button--wrapper">
              <a href="{{ settings.cta_guide_link |  default: '#' }}" class="button cta-button">{{ 'bso_shortcode.cta_guide.button_text' | t }}</a>
            </div>
          {% endif %}
        </div>
      </div>

      {% if col_width != "12" %}
        <div class="cta-button--wrapper">
          <a href="{{ settings.cta_guide_link |  default: '#' }}" class="button cta-button">{{ 'bso_shortcode.cta_guide.button_text' | t }}</a>
        </div>
      {% endif %}

    </div>
  </div>
</div>