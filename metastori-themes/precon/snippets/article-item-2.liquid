<div {% if settings.stagger_blog_posts_apparition %}reveal{% endif %} class="blog-article article-item {% if use_featured_layout %}{% if is_first %}article-item--featured{% else %}article-item--horizontal{% endif %}{% endif %} image-zoom" data-title="{{ article.title | escape }}"
         data-cooktime="{{ article.metafields.custom.cook_time }}"
         data-diet="{{ article.metafields.custom.diat }}"
         data-season="{{ article.metafields.custom.season }}"
         data-course="{{ article.metafields.custom.course }}">
  
  
  <div class="article-top-content">
    <h3 class="article-item__title heading {{ heading_size }}">
      <a href="{{ article.url }}">{{ article.title }}</a>
    </h3>
  </div>

  <div class="article-img-content">
    {%- if article.image -%}
    <a href="{{ article.url }}" class="article-item__image-container">
      {{- article.image | image_url: width: article.image.width | image_tag: loading: 'lazy', sizes: '(max-width: 740px) 81vw, (max-width: 999px) 37vw, 425px', sizes: '600,700,800,1000,1200,1400,1600,1800,2000', class: 'article-item__image' -}}

      {%- if use_featured_layout and is_first -%}
        <span class="article-item__arrow prev-next-button prev-next-button--next">{% render 'icon' with 'nav-arrow-right', direction_aware: true %}</span>
      {%- else -%}
        <span class="article-item__arrow prev-next-button prev-next-button--small prev-next-button--next">{% render 'icon' with 'nav-arrow-right', direction_aware: true, width: 15, height: 12 %}</span>
      {%- endif -%}
    </a>
  {%- endif -%}
    <div class="article-item__content text-container">
       <div class="article-item__content-inner">
          {%- assign cook_time = article.metafields.custom.cook_time -%}
          {%- assign diat = article.metafields.custom.diat -%}
          {%- assign season = article.metafields.custom.season -%}
          {%- assign course = article.metafields.custom.course -%}
          {% if cook_time %}
            <a class="article-item__metalink" href="#">
              <img src="https://cdn.shopify.com/s/files/1/0904/4639/7774/files/time-cook_1.svg?v=1756270214" alt="" width="" height="">
              {{ cook_time }}
            </a>
          {% endif %}
        {% if diat %}
          <a class="article-item__metalink" href="#">
            <img src="https://cdn.shopify.com/s/files/1/0904/4639/7774/files/diat_1.svg?v=1756270213" alt="" width="" height="">
            {{ diat }}
          </a>
        {% endif %}
        {% if season %}
          <a class="article-item__metalink" href="#">
            <img src="https://cdn.shopify.com/s/files/1/0904/4639/7774/files/Saison_1.svg?v=1756270213" alt="" width="" height="">
            {{ season }}
          </a>
        {% endif %}
        {% if course %}
          <a class="article-item__metalink" href="#">
            <img src="https://cdn.shopify.com/s/files/1/0904/4639/7774/files/gange_1.svg?v=1756270213" alt="" width="" height="">
            {{ course }}
          </a>
        {% endif %}
        <a href="{{ article.url }}" class="article-item__btn button button--primary">
          Weiterlesen {% render 'icon' with 'nav-arrow-right', direction_aware: true %}
        </a>
       </div>
        

    {%- if section.settings.show_category and article.tags.size > 0 -%}
      {%- assign blog_url_parts = article.url | split: '/' -%}
      {%- assign blog_url = '' -%}

      {%- for blog_url_part in blog_url_parts -%}
        {%- unless forloop.last -%}
          {%- assign blog_url = blog_url | append: '/' | append: blog_url_part -%}
        {%- endunless -%}
      {%- endfor -%}

      <a href="{{ blog_url | remove_first: '/' }}/tagged/{{ article.tags.first | handle }}" class="article-item__category heading heading--xsmall">{{ article.tags.first }}</a>
    {%- endif -%}


    {%- if section.settings.show_excerpt and article.excerpt_or_content != blank -%}
      <div class="article-item__excerpt text--small">
        {{- article.excerpt_or_content | strip_html | truncate: 200 -}}
      </div>
    {%- endif -%}
  </div>
  </div>



</div>