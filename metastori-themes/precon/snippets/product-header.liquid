{%- comment -%}
  Single source of truth for the product H1 + teaser.
  Rendered once as a direct child of .product so it can be
  positioned above the media on mobile (normal flow) and at
  the top of the info column on desktop (CSS grid).
{%- endcomment -%}
<div class="product__header">

 {%- liquid
  if template.name == 'product'
    assign heading_tag = 'h1'
  else
    assign heading_tag = 'h2'
  endif
-%}
<{{ heading_tag }} class="product__header-title heading h3">{{ product.title }}</{{ heading_tag }}>
  {% render 'pdp-top-review', product: product %}

  {% if product.metafields.custom.teaser_text_pdp != blank %}
    <div class="product__header-teaser">{{ product.metafields.custom.teaser_text_pdp }}</div>
  {% endif %}

  {% if section.settings.flavour_text != blank and product.metafields.custom.product_flavours != blank %}
    <a class="flavour_top_btn" href="{{ section.settings.flavour_link }}">
      <img class="flavour_icon" src="{{ section.settings.flavour_icon | image_url: width:240 }}" width="69px" height="59px">
      <div class="flavour_text">{{ section.settings.flavour_text }}</div>
      <svg class="flavour_down" width="12" height="12" viewBox="0 0 12 12" fill="none" xmlns="http://www.w3.org/2000/svg">
        <path d="M9.75 6.375L6 10.125L2.25 6.375" stroke="#56473A" stroke-linecap="round" stroke-linejoin="round"/>
        <path d="M9.75 2.625L6 6.375L2.25 2.625" stroke="#343330" stroke-linecap="round" stroke-linejoin="round"/>
      </svg>
    </a>
  {% endif %}
</div>