{% assign summary_background_color = settings.summary_background_color %}
{% assign summary_header_color = settings.summary_header_color %}
{% assign summary_text_color = settings.summary_text_color %}
{% assign summary_border_color = settings.summary_border_color %}

{% if summary_background_color != blank or summary_text_color != blank or summary_border_color != blank or summary_header_color != blank %}
<style>
  #shopify-section-{{ section.id }} .shortcode--summary {
    {% if summary_background_color != blank %}
    --summary-bg: rgba({{ summary_background_color.red }},{{ summary_background_color.green }},{{ summary_background_color.blue }},{{ summary_background_color.alpha }});
    {% endif %}

    {% if summary_header_color != blank %}
    --summary-header: rgba({{ summary_header_color.red }},{{ summary_header_color.green }},{{ summary_header_color.blue }},{{ summary_header_color.alpha }});
    {% endif %}
   
    {% if summary_text_color != blank %}
    --summary-text: rgba({{ summary_text_color.red }},{{ summary_text_color.green }},{{ summary_text_color.blue }},{{ summary_text_color.alpha }});
    {% endif %}

    {% if summary_border_color != blank %}
    --summary-border: rgba({{ summary_border_color.red }},{{ summary_border_color.green }},{{ summary_border_color.blue }},{{ summary_border_color.alpha }});
    border-radius: 5px;
    border: 1px solid var(--summary-border);
    {% endif %}
  }
</style>
{% endif %}

{% assign ps_background_color = settings.ps_background_color %}
{% assign ps_title_color = settings.ps_title_color %}

{% if ps_background_color != blank or ps_title_color != blank %}
<style>
  #shopify-section-{{ section.id }} .shortcode--product {
    {% if ps_background_color != blank %}
    --ps-bg: {{ ps_background_color }};
    {% endif %}

    {% if ps_title_color != blank %}
    --ps-text: {{ ps_title_color.red }},{{ ps_title_color.green }},{{ ps_title_color.blue }};
    {% endif %}
  }
</style>
{% endif %}

{% assign collection_bg = settings.collection_background_color %}
{% assign collection_title_color = settings.collection_title_color %}

{% if collection_bg != blank or collection_title_color != blank %}
  {% style %}
    #shopify-section-{{ section.id }} .shortcode--collection {
      {% if collection_bg != blank %}
      --collection-bg: {{ collection_bg }};
      {% endif %}
      {% if collection_title_color != blank %}
      --collection-text-color: {{ collection_title_color.red }},{{ collection_title_color.green }},{{ collection_title_color.blue }};
      {% endif %}
    }
  {% endstyle %}
{% endif %}

{% assign featured_bg_color = settings.featured_background_color %}
{% assign featured_text_color = settings.featured_text_color %}

{% if featured_bg_color != blank or featured_text_color != blank %}
<style>
  #shopify-section-{{ section.id }} .shortcode--feature-product {
    {% if featured_bg_color != blank %}
    --featured-product-bg: {{ featured_bg_color }};
    {% endif %}

    {% if featured_text_color != blank %}
    --featured-product-text: {{ featured_text_color.red }},{{ featured_text_color.green }},{{ featured_text_color.blue }};
    {% endif %}
  }
</style>
{% endif %}