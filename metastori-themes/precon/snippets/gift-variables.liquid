<script>
	{% if enable_cart_bar %}
		window.giftLevels = [
		  {% for gift_level in gifts_levels %}
		      {%- assign default_gift = gift_level.settings.gifts | first -%}
		      {
		         'threshold': {{ gift_level.settings.threshold | times: 100 | json }},
		           'giftIds': {{ gift_level.settings.gifts | map: "id" | json }},
		           'giftHandels': {{ gift_level.settings.gifts | map: "handle" | json }},
		           'autoAdd': {{ gift_level.settings.auto_add_gift | json }},
		           'defaultVariantId': {% if default_gift %}{{ default_gift.first_available_variant.id | json }}{% else %}null{% endif %},
		      },
		  {% endfor %}
		];
	{% endif %}
	window.hiddenGifts = {{ collections['hidden-gifts'].products | map: "handle" | json }};
</script>
