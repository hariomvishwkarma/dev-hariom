{% assign abtest_menu = linklists[section.settings.abtest_menu] %}

<ul class="mobile-nav list--unstyled mobile-nav-abtest" role="list" style="--cl-bg-color: {{ section.settings.collection_bg }}">

    {% if section.settings.top_product != blank or section.settings.top_banner != blank %}
        <div class="mobile-nav--top">
            {% if section.settings.top_product != blank %}
                {% assign top_product = section.settings.top_product %}
                <a class="mobile-nav--top-product" href="{{ top_product.url }}">
                    <div class="mvtp-image-wrapper">
                        <img src="{{ top_product.featured_image | image_url: width: 180 }}" alt="{{ top_product.title }}" width="130px" height="130px">
                    </div>
                    <div class="mvtp-content-wrapper">
                        <p class="mvtp-title">{{ top_product.title }}</p>
                        <div class="mvtp-pricelist">
                            {% if top_product.compare_at_price > top_product.price %}
                            <span class="mvtp-price-compare">{{ top_product.compare_at_price | money }}</span>
                            {% endif %}
                            <span class="mvtp-price-highlight">{{ top_product.price | money }}</span>
                        </div>
                    </div>
                </a>
            {% elsif section.settings.top_banner != blank %}
                {% if section.settings.top_banner_link != blank %}<a href="{{ section.settings.top_banner_link }}" class="mobile-nav--top-banner">{% else %}<div class="mobile-nav--top-banner">{% endif %}
                    <img src="{{ section.settings.top_banner | image_url }}" alt="{{ section.settings.top_banner.alt }}" width="auto" height="auto">
                {% if section.settings.top_banner_link != blank %}</a>{% else %}</div>{% endif %}
            {% endif %}
        </div>
    {% endif %}

    {%- for link in abtest_menu.links -%}
        {% if link.links.size > 0 %}
            <li class="mobile-menu-item mobile-menu-has-dropdown" data-level="1">
                <span href="{{ link.url }}" class="mobile-menu-title">{{ link.title }}</span>
                <div class="mmv-drop">
                    {% for child in link.links %}
                        {% assign link_handle = child.url | split: '/' | last %}
                        {% assign mv_collection = collections[link_handle] %}
                        {% assign mv_icon = mv_collection.metafields.custom.icon_mobile_navigation %}
                        <a href="{{ child.url }}" class="mobile-menu-link">
                            <div class="mv-link-media">
                                {% if mv_icon != blank %}
                                    <img src="{{ mv_icon | image_url: width: 80 }}" alt="{{ child.title }}" width="48px" height="48px">
                                {% endif %}
                                {{ child.title }}
                            </div>
                            <svg width="16" height="16" viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg">
                                <path d="M2.5 8H13.5" stroke="#290907" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                                <path d="M9 3.5L13.5 8L9 12.5" stroke="#343330" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                            </svg>   
                        </a>
                    {% endfor %}
                </div>
            </li>
        {% else %}
            <li class="mobile-menu-item" data-level="1">
                <a href="{{ link.url }}" class="mobile-m-link">
                    {{ link.title }}
                    <svg width="16" height="16" viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg">
                        <path d="M2.5 8H13.5" stroke="#290907" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                        <path d="M9 3.5L13.5 8L9 12.5" stroke="#343330" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                    </svg>    
                </a>
            </li>
        {% endif %}
    {%- endfor -%}
</ul>