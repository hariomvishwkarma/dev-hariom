{%- comment -%}
Render instagram embeds
Usage:
  [instagram_banner image="pic.jpg" headline="Sample heading" subline="subline of heading" url="https://sample-instagram-url.com"]
  pameters:
    image: required, the image of the instagram post
    headline: optional, the headline of the instagram post
    subline: optional, the subline of the instagram post
    url: optional, the url of the instagram post
{%- endcomment -%}

{%- capture banner_image -%}{%- render 'shortcode-param', keys: keys, values: values, param: 'image' -%}{%- endcapture -%}
{%- capture headline -%}{%- render 'shortcode-param', keys: keys, values: values, param: 'headline' -%}{%- endcapture -%}
{%- capture subline -%}{%- render 'shortcode-param', keys: keys, values: values, param: 'subline' -%}{%- endcapture -%}
{%- capture url -%}{%- render 'shortcode-param', keys: keys, values: values, param: 'url' -%}{%- endcapture -%}

{% if banner_image != blank and url!= blank %}
  <div class="shortcode shortcode-instagram-banner">
    <div class="instagram-banner__wrapper">
      <div class="instagram-banner__container">
        <a href="{{ url }}" class="instagram-image-link" target="_blank">
          <div class="instagram-image-wrapper">
            <img src="{{ banner_image }}"  alt="{{ headline }}" class="instagram-banner-image">
            <div class="instagram-overlay"></div>
          </div>
        </a>
        <div class="instagram-banner-content">
          <div class="instagram-banner-headline">
            <a href="{{ url }}" target="_blank" class="h4">{{ headline }}</a>
            {% if subline != blank %}
              <p class="instagram-banner-subline">{{ subline }}</p>
            {% endif %}
          </div>
          <a href="{{ url }}" target="_blank" class="button button-desktop instagram-banner-link">View on Instagram</a>
        </div>
      </div>
      <a href="{{ url }}" target="_blank" class="button button-mobile instagram-banner-link">View on Instagram</a>
    </div>
  </div>
{% endif %}