{%- comment -%}
Render Summary from Article Metafield
Usage:
  [summary]
{%- endcomment -%}

{%- if article.metafields.bso.summary -%}
  <div class="shortcode shortcode--summary">
    <div class="shortcode-rte">
      {{ article.metafields.bso.summary | metafield_tag }}
    </div>
  </div>
{%- endif -%}