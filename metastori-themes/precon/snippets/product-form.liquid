{%- assign color_white_label = 'general.label.white' | t | downcase -%}
{%- assign size_label_list = 'general.label.size' | t | replace: ', ', ',' | downcase | split: ',' -%}

<div class="product-form">
  {%- for block in section.blocks -%}
    {%- case block.type -%}


              {%- when 'Custom_atc' -%}
          
<div class="custom-button-featured-product">
  <a href="{{product.url }}">
    <button type="button"     class=" button button--primary button--full">{{ block.settings.button_text}}

    
                    {% render 'button_arrow' %}
    </button>
        </a>                
</div>
        {%- comment -%}
          ----------------------------------------------------------------------------------------------------------------
          APP BLOCK TYPE
          ----------------------------------------------------------------------------------------------------------------
        {%- endcomment -%}
      {%- when '@app' -%}
        {%- render block -%}

        {%- comment -%}
          ----------------------------------------------------------------------------------------------------------------
          VARIANT PICKER BLOCK TYPE
          ----------------------------------------------------------------------------------------------------------------
        {%- endcomment -%}

      {%- when 'rating_info' -%}
        {%- capture product_meta_reference -%}
      {% comment %} {%- if section.settings.show_product_rating -%}
        <span class="product-meta__reviews-badge hidden-lap-and-up">{%- render 'product-rating', product: product -%}</span>
        <span class="product-meta__reviews-badge hidden-pocket">{%- render 'product-rating', product: product -%}</span>
      {%- endif -%} {% endcomment %}
      {% comment %} <div class='jdgm-widget jdgm-preview-badge' data-id='{{ product.id }}'> 
                        {{ product.metafields.judgeme.badge }} 
      </div>  {% endcomment %}
      {%- if section.settings.show_sku and product.selected_or_first_available_variant.sku != blank -%}
        <span class="product-meta__sku text--subdued text--xxsmall">
          {{- 'product.general.sku' | t }}
          <span class="product-meta__sku-number">{{ product.selected_or_first_available_variant.sku }}</span>
        </span>
      {%- endif -%}
    {%- endcapture -%}

        <div class="product-meta__reference">
          {%- if product_meta_reference != blank -%}
            <div class="product_rating_info">
              {{- product_meta_reference -}}
            </div>
          {%- endif -%}

          {% comment %}
            {% if product.metafields.custom.product_weight_info != blank %}
            <div class="product_weight_info weight_desktop">
              <span> {{ product.metafields.custom.product_weight_info | metafield_tag }} </span>
            </div>
            {% endif %}
          {% endcomment %}
        </div>

      {%- when 'price_info' -%}

        
{%if product.metafields.custom.chf_discount_price != blank  and  cart.currency.iso_code == 'CHF'  %}


{% assign first_variant = product.selected_or_first_available_variant %}
{% assign original_price = first_variant.price %}

{% assign discount_raw = product.metafields.custom.chf_discount_price | default: "" %}
{% assign discount_number = discount_raw | replace: '%', '' | plus: 0 %}

{% if discount_raw contains '%' %}

  {%- comment -%} Percentage Discount Case {%- endcomment -%}
  {% assign discount_amount = original_price | times: discount_number | divided_by: 100 %}
  {% assign custom_main_price = original_price | minus: discount_amount %}
  {% assign custom_compare_price = original_price %}

{% else %}

  {%- comment -%} Normal Discount Case {%- endcomment -%}
  {% assign discount_amount = discount_number | times: 100 %}
  {% assign custom_main_price = original_price | minus: discount_amount %}
  {% assign custom_compare_price = original_price %}

{% endif %}

        <product-meta
          data-block-type="meta"
          data-block-id="{{ section.id }}"
          price-class="price--large"
          class="product-meta"
        >
          <div class="product-meta__price-list-container">
            <div class="prdt_price_info">
              {%- if product.selected_or_first_available_variant != null -%}
                <div class="price-list">
                  {%- if custom_compare_price > custom_main_price -%}
                    <span class="mainproduct-price">
                      <span class="price price--compare">
                        <span class="visually-hidden">{{ 'product.general.regular_price' | t }}</span>

                        {%- if settings.currency_code_enabled -%}
                          {{- custom_compare_price | money_with_currency -}}
                        {%- else -%}
                          {{- custom_compare_price | money -}}
                        {%- endif -%}
                      </span>
                      <span class="price price--highlight price--large">
                        <span class="visually-hidden">{{ 'product.general.sale_price' | t }}</span>

                        {%- if settings.currency_code_enabled -%}
                          {{- custom_main_price | money_with_currency -}}
                        {%- else -%}
                          {{- custom_main_price | money -}}
                        {%- endif -%}
                      </span>
                    </span>

                  {%- else -%}
                    <span class="price price--large">
                      <span class="visually-hidden">{{ 'product.general.sale_price' | t }}</span>
                      {%- if settings.currency_code_enabled -%}
                        {{- product.selected_or_first_available_variant.price | money_with_currency -}}
                      {%- else -%}
                        {{- product.selected_or_first_available_variant.price | money -}}
                      {%- endif -%}
                    </span>
                  {%- endif -%}

                  {%- if product.selected_or_first_available_variant.unit_price_measurement -%}
                    <div class="price text--subdued">
                      <div class="unit-price-measurement">
                        <span class="unit-price-measurement__price">
                          {{- product.selected_or_first_available_variant.unit_price | money -}}
                        </span>
                        <span class="unit-price-measurement__separator">/</span>

                        {%- if product.selected_or_first_available_variant.unit_price_measurement.reference_value != 1
                        -%}
                          <span class="unit-price-measurement__reference-value">
                            {{- product.selected_or_first_available_variant.unit_price_measurement.reference_value -}}
                          </span>
                        {%- endif -%}

                        <span class="unit-price-measurement__reference-unit">
                          {{- product.selected_or_first_available_variant.unit_price_measurement.reference_unit -}}
                        </span>
                      </div>
                    </div>
                  {%- endif -%}
                </div>
              {%- endif -%}

              {%- assign cheapest_variant = product.selected_or_first_available_variant -%}

              {%- if settings.show_discount
                and custom_main_price < custom_compare_price
              
              -%}
                {%- if settings.discount_mode == 'percentage' -%}
                  {%- assign savings = custom_compare_price
                    | minus: custom_main_price
                    | times: 100.0
                    | divided_by: custom_compare_price
                    | round
                    | append: '%'
                  -%}
                {%- else -%}
                  {%- capture savings -%}{{ custom_compare_price | minus: custom_main_price | money }}{%- endcapture -%}
                {%- endif -%}

                <span class="product_discnt">{{ 'collection.product.discount_html' | t: savings: savings }}</span>
              {%- endif -%}

              {% comment %}
                {% if product.compare_at_price > product.price %}
                  <div class="product_discnt">
                    Du sparst {{ product.compare_at_price | minus: product.price | money }}
                  </div>
                {% endif %}
              {% endcomment %}
            </div>

            <div class="prd_mobile_info">
              {% if product.metafields.custom.product_weight_info != blank %}
                <div class="product_weight_info weight_mobile">
                  <span> {{ product.metafields.custom.product_weight_info | metafield_tag }} </span>
                </div>
              {% endif %}

              {% comment %}
                {% if product.metafields.custom.product_fuel_info != blank %}
                   <div class="portion_info">
                    {% render 'fuel_icon' %} {{ product.metafields.custom.product_fuel_info | metafield_tag }}
                   </div>
                {% endif %}
              {% endcomment %}
            </div>

            {%- if product.selected_or_first_available_variant != null and section.settings.show_badges -%}
              <div class="product-meta__label-list label-list">
                {%- if product.metafields.custom.badges != blank -%}
                  {%- for custom_badge in product.metafields.custom.badges.value -%}
                    <span class="label {% if forloop.index == 1 %}label--custom{% else %}label--custom2{% endif %}">
                      {{- custom_badge -}}
                    </span>
                  {%- endfor -%}
                {%- else -%}
                  {%- for tag in product.tags -%}
                    {%- if tag contains '__label' -%}
                      <span class="label label--custom{% if tag contains '__label2' %}2{% endif %}">
                        {{- tag | split: ':' | last -}}
                      </span>
                    {%- endif -%}
                  {%- endfor -%}
                {%- endif -%}
                {%- unless product.selected_or_first_available_variant.available -%}
                  <span class="label label--subdued">{{ 'collection.product.sold_out' | t }}</span>
                {%- elsif product.selected_or_first_available_variant.compare_at_price
                    > product.selected_or_first_available_variant.price
                -%}
                  {%- if settings.discount_mode == 'percentage' -%}
                    {%- assign savings = product.selected_or_first_available_variant.compare_at_price
                      | minus: product.selected_or_first_available_variant.price
                      | times: 100.0
                      | divided_by: product.selected_or_first_available_variant.compare_at_price
                      | round
                      | append: '%'
                    -%}
                  {%- else -%}
                    {%- capture savings -%}{{ product.selected_or_first_available_variant.compare_at_price | minus: product.selected_or_first_available_variant.price | money }}{%- endcapture -%}
                  {%- endif -%}

                  <span class="label label--highlight">
                    {{- 'collection.product.discount_html' | t: savings: savings -}}
                  </span>
                {%- endunless -%}
              </div>
            {%- endif -%}
          </div>
          <div class="single-moreinfo">
            {% if product.metafields.custom.product_weight_info != blank %}
              <div class="product_weight_info weight_desktop">
                <span> {{ product.metafields.custom.product_weight_info | metafield_tag }} </span>
              </div>
            {% endif %}

            {% if product.metafields.custom.product_fuel_info != blank %}
              <div class="portion_info">
                {% render 'fuel_icon' %}
                {{ product.metafields.custom.product_fuel_info | metafield_tag }}
              </div>
            {% endif %}
          </div>
        </product-meta>
        
      
