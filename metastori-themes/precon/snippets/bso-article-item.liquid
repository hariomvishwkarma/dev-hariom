{% assign heading_html_tag = heading_html_tag | default: 'h2' %}
<div class="bso-article-item">
  {%- assign alternative_img = article.metafields.bso.alternative_image.value -%}
  {%- if article.image or alternative_img != blank -%}
    {%- assign loading = 'lazy' -%}
    {%- assign fetchpriority = 'low' -%}
    {% if index <= 3 %}
      {%- assign loading = 'eager' -%}
      {%- assign fetchpriority = 'high' -%}
    {% endif %}

    {%- assign image_to_show = alternative_img | default: article.image -%}
    
    <div class="image-container">
      <div class="bso-article-item__image-wrapper">
        <div class="aspect-ratio">
          {{- image_to_show | image_url: width: '800px' | image_tag: loading: loading, fetchpriority: fetchpriority, sizes: '(max-width: 740px) 81vw, (max-width: 999px) 37vw, 425px', sizes: '600,700,800', class: 'bso-article-item__image' -}}
        </div>
      </div>
    </div>
  {%- endif -%}

  <div class="content-container">
    <{{ heading_html_tag }} class="bso-article-item__title heading">
      <a href="{{ article.url }}">{{ article.title }}</a>
    </{{- heading_html_tag -}}>

    {%- assign article_content = article.excerpt_or_content | strip_html | truncate: 200 -%}
    {%- assign content = article.metafields.bso.alternative_introtext | metafield_tag -%}
    {%- assign content_to_show = content | default: article_content -%}

    {% if content_to_show != blank %}
      <div class="bso-article-item__excerpt text--small">
        {{- content_to_show -}}
      </div>
    {% endif %}

    <div class="bso-article-item__read-more">
      <a href="{{ article.url }}" class="bso-article-item__read-more-link button">
        {{ 'blog.general.read_more' | t }}
      </a>
    </div>
  </div>
</div>