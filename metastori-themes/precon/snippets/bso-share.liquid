{%- assign share_url = shop.url | append: article.url -%}
{%- assign twitter_text = article.title | url_param_escape -%}
{%- assign pinterest_description = article.excerpt_or_content | strip_html | truncatewords: 15 | url_param_escape -%}
{%- assign pinterest_image = article.image | img_url: '800x' | prepend: 'https:' -%}

{% style %}
  #shopify-section-{{ section.id }} .bso-share {
    background-color: {{ block.settings.share_bg_color }};
    color: {{ block.settings.share_text_color }};
    border-radius: var(--bso-border-radius);
  }
  
  #shopify-section-{{ section.id }} .article__share {
    padding: {{ block.settings.share_padding_top }}px 30px {{ block.settings.share_padding_bottom }}px;
    margin-top: {{ block.settings.share_margin_top }}px;
    margin-bottom: {{ block.settings.share_margin_bottom }}px;
    width: 100%;
    display: block;
  }

  #shopify-section-{{ section.id }} .article__share .heading {
    font-weight: 600;
  }

  #shopify-section-{{ section.id }} .article__share .heading,
  #shopify-section-{{ section.id }} .article__share-description {
    color: {{ block.settings.share_text_color }};
  }

  #shopify-section-{{ section.id }} .article__share-button-list {
    margin: 15px 0 0;
    gap: 0 15px;
    display: flex;
  }

  #shopify-section-{{ section.id }} .article__share-button-item .icon {
    display: flex;
  }

  #shopify-section-{{ section.id }} .article__share-button-item svg {
    width: 30px;
    height: 30px;
  }

  {% if block.settings.share_link_color %}
    #shopify-section-{{ section.id }} .article__share-button-item .icon g,
    #shopify-section-{{ section.id }} .article__share-button-item .icon path {
      fill: {{ block.settings.share_link_color }};
    }

    #shopify-section-{{ section.id }} .article__share-button-item.article__share-button-item--twitter .icon path:nth-child(2) {
      fill: {{ block.settings.share_bg_color }};
    }
  {% endif %}
  
  @media screen and (min-width: 990px) {
    #shopify-section-{{ section.id }} .page-content .sidebar-enabled.block--position--sidebar {
      display: none;
    }
  }
{% endstyle %}

<div class="bso-share {% if section.settings.show_sidebar %}sidebar-enabled{% endif %} block--position--{{ block.settings.block_position }} {% if block.settings.hide_on_mobile %}mobile-hide{% endif %}">

  <div class="article__share">
    {% if block.settings.share_title != blank %}
      <p class="article__share-title heading h5">{{ block.settings.share_title }}</p>
    {% endif %}

    {% if block.settings.share_content != blank %}
      <div class="article__share-description">{{ block.settings.share_content }}</div>
    {% endif %}

    <div class="article__share-button-list" role="list">
      <a class="article__share-button-item article__share-button-item--facebook tap-area" href="https://www.facebook.com/sharer.php?u={{ share_url }}" target="_blank" rel="noopener" role="listitem" aria-label="{{ 'bso.general.facebook_share' | t }}">
        {%- render 'icon-global', icon: 'facebook-circle' -%}
      </a>

      <a class="article__share-button-item article__share-button-item--pinterest tap-area" href="https://pinterest.com/pin/create/button/?url={{ share_url }}{% if pinterest_image != blank %}&media={{ pinterest_image }}{% endif %}&description={{ pinterest_description }}" target="_blank" rel="noopener" role="listitem" aria-label="{{ 'bso.general.pinterest_share' | t }}">
        {%- render 'icon-global', icon: 'pinterest-circle' -%}
      </a>

      <a class="article__share-button-item article__share-button-item--twitter tap-area" href="https://twitter.com/share?{% if twitter_text != blank %}text={{twitter_text}}&{% endif %}url={{ share_url }}" target="_blank" rel="noopener" role="listitem" aria-label="{{ 'bso.general.twitter_share' | t }}">
        {%- render 'icon-global' , icon: 'x-circle' -%}
      </a>

      <a class="article__share-button-item article__share-button-item--mail tap-area" href="mailto:?&subject={{ article.title | escape }}&body={{ share_url }}" role="listitem" aria-label="{{ 'bso.general.email_share' | t }}">
        {%- render 'icon-global' , icon: 'sent-mail-circle' -%}
      </a>
    </div>
  </div>
</div>