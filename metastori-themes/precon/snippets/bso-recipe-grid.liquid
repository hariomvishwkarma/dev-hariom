{%- assign recipes = blogs['rezepte'].articles -%}
<article-list {% if settings.stagger_blog_posts_apparition %}stagger-apparition{% endif %} class="article-list article-list--stacked">
  {% for article in recipes limit: 3 %}
    {%- render 'article-item', article: article, heading_html_tag: 'span', heading_size: 'h4', index: forloop.index, enable_bso_card_styles: true -%}
  {%- endfor -%}
</article-list>