{% assign col_width = width | default: "12" %}
<div class="bso-column bso-column-{{ col_width }}">
  <div class="shortcode shortcode-cta cta-content-recipes {% if col_width == "12" %}cta-fullsize mg-top{% endif %}">
    <div class="cta--wrapper">

      <div class="cta-image-container">
        <div class="cta-image--wrapper">
          <div class="aspect-ratio">
            <img
              src="https://cdn.shopify.com/s/files/1/0904/4639/7774/files/bso-cta-content-recipe.png?v=1757070384"
              class="cta-image cta-content-recipe--image"
              alt="Content Recipe"
            >
          </div>
        </div>
      </div>

      <div class="cta-content">
        <div class="cta-content--wrapper">
          <div class="cta-header">{{ 'bso_shortcode.cta_recipes.header' | t }}</div>
          <div class="cta-description">{{ 'bso_shortcode.cta_recipes.description' | t }}</div>
          <div class="cta-button--wrapper">
            <a href="{{ settings.cta_recipe_link |  default: '#' }}" class="button cta-button">{{ 'bso_shortcode.cta_recipes.button_text' | t }}</a>
          </div>
        </div>
      </div>

    </div>
  </div>
</div>