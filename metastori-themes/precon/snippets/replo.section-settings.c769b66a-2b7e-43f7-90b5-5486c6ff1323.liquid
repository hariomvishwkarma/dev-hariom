    {%- capture default_replo_text_52ed863e-3ada-4032-98d8-aee3fa095e3e -%}<p>What are the key benefits of this product?</p>{%- endcapture -%}
    {%- assign replo_text_52ed863e-3ada-4032-98d8-aee3fa095e3e = replo_text_52ed863e-3ada-4032-98d8-aee3fa095e3e | default: default_replo_text_52ed863e-3ada-4032-98d8-aee3fa095e3e -%}
