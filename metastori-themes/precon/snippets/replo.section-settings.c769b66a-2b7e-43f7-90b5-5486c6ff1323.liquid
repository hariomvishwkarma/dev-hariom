    {%- capture default_replo_text_e0bee2be-8a7e-40c8-b4ff-4e3f7fb4a678 -%}<p>This product is designed to be both functional and sustainable, offering high performance while reducing environmental impact. Whether it's gentle on the skin, durable for daily use, or made with eco-friendly materials, it’s crafted with care for you and the planet.</p>{%- endcapture -%}
    {%- assign replo_text_e0bee2be-8a7e-40c8-b4ff-4e3f7fb4a678 = replo_text_e0bee2be-8a7e-40c8-b4ff-4e3f7fb4a678 | default: default_replo_text_e0bee2be-8a7e-40c8-b4ff-4e3f7fb4a678 -%}
