    {%- capture default_replo_text_32911aa7-c363-497d-b99a-fd3e42682ec3 -%}<p>We work with trusted manufacturers worldwide, prioritizing ethical production and high-quality craftsmanship. Many of our products are made locally or sourced from responsible partners.</p>{%- endcapture -%}
    {%- assign replo_text_32911aa7-c363-497d-b99a-fd3e42682ec3 = replo_text_32911aa7-c363-497d-b99a-fd3e42682ec3 | default: default_replo_text_32911aa7-c363-497d-b99a-fd3e42682ec3 -%}
