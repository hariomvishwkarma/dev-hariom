    {%- capture default_replo_text_c4928cd4-b150-4595-8d6d-9d6a5c163a0a -%}<p>Wo werden die Precon Produkte hergestellt?</p>{%- endcapture -%}
    {%- assign replo_text_c4928cd4-b150-4595-8d6d-9d6a5c163a0a = replo_text_c4928cd4-b150-4595-8d6d-9d6a5c163a0a | default: default_replo_text_c4928cd4-b150-4595-8d6d-9d6a5c163a0a -%}
