    {%- assign replo_text_364f8512-9606-47ab-bfed-23ec95c6f294 = replo_text_364f8512-9606-47ab-bfed-23ec95c6f294 | default: default_replo_text_364f8512-9606-47ab-bfed-23ec95c6f294 -%}
