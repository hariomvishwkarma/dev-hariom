{%- capture collection_handle -%}{%- render 'shortcode-param', keys: keys, values: values, param: 'collection_handle' -%}{%- endcapture -%}
{% if collection_handle != blank %}
  {%- assign collection_obj = collections[collection_handle] -%}
  {% if collection_obj %}
    {%- assign collection_img = collection_obj.image -%}
    {% assign collection_img_metafield = collection_obj.metafields.bso.featured_collection_image %}
    <div class="shortcode shortcode--collection">
      <div class="shortcode-collection__wrapper">
        <div class="shortcode-collection__image">
          <a href="{{ collection_obj.url }}">
            <div class="aspect-ratio" style="--aspect-ratio: {{ collection_img.aspect_ratio }}">
              {% if collection_img_metafield != blank %}
                {{-
                  collection_img_metafield
                  | image_url: width: collection_img_metafield.width
                  | image_tag:
                  loading: 'eager',
                  sizes: '100vw',
                  widths: '30,40,60,80,120,200,400,600,700',
                  class: 'collection-feature__image'
                -}}
              {% elsif collection_img != blank %}
                {{-
                  collection_img
                  | image_url: width: collection_img.width
                  | image_tag:
                  loading: 'eager',
                  sizes: '100vw',
                  widths: '30,40,60,80,120,200,400,600,700',
                  class: 'collection-feature__image'
                -}}
              {% else %}
                {{ 'image' | placeholder_svg_tag: 'collection-placeholder' }}
              {% endif %}
            </div>
          </a>
        </div>
        <div class="shortcode-collection__content">
          <a class="collection-title" href="{{ collection_obj.url }}">
            {{ collection_obj.title }}
          </a>
          <div class="shortcode-collection__desciption">
            {% if collection_obj.description != blank %}
              {{ collection_obj.description | strip_html | slice: 0, 100 }}..
            {% endif %}
          </div>
        </div>
        <div class="shortcode-collection__button">
          <a class="button {{ settings.collection_button_style }} button--full" href="{{ collection_obj.url }}">
            {{ 'bso.general.learn_more' | t }}
          </a>
        </div>
      </div>
    </div>
  {% endif %}
{% endif %}
