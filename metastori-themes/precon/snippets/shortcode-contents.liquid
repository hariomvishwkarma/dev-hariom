{%- comment -%}
Creates a table of contents containing all <h2> headlines below the [contents] shortcode. This shortcode must not be called from the shortcode-rendering but explicitly.
Input:
  - contents: The table of contents from the article_preprocessor
{%- endcomment -%}

{%- assign contents_array = contents | split: '||' -%}

{%- unless class == 'collapsible' -%}
  <div class="tableofcontents {{ class }}">
    <ul class="toc--listing">
      {%- for entry in contents_array -%}
        {%- if entry contains '>>' -%}
          {%- assign sub_entries = entry | split: '>>' -%}
          {%- assign parent_text = sub_entries[0] -%}
          {% assign link_text = parent_text %}
          {% if entry contains '. ' %}
            {%- assign first_part = parent_text | split: '. ' | first -%}
            {%- assign second_part = parent_text | split: '. ' | last -%}
            {%- assign to_compare = first_part | times: 1 -%}
            {% if to_compare > 0 %}
              {%- assign link_text = second_part -%}
            {% endif %}
          {% endif %}
          <li class="toc--content-item">
            <a class="toc--content-link" href="#{{ parent_text | handle | prepend: 's-' }}">
              <span class="reversed-link">{{ link_text }}</span>
            </a>
            <ul class="toc--sublist">
              {%- for sub in sub_entries offset: 1 -%}
                {% assign sub_text = sub %}
                {% if sub contains '. ' %}
                  {%- assign first_part = sub | split: '. ' | first -%}
                  {%- assign second_part = sub | split: '. ' | last -%}
                  {%- assign to_compare = first_part | times: 1 -%}
                  {% if to_compare > 0 %}
                    {%- assign sub_text = second_part -%}
                  {% endif %}
                {% endif %}
                <li class="linklist__sub-item sub-item">
                  <a class="toc--content-link" href="#{{ sub | handle | prepend: 's-' }}">
                    <span class="reversed-link">{{ sub }}</span>
                  </a>
                </li>
              {%- endfor -%}
            </ul>
          </li>
        {%- else -%}
          {% assign link_text = entry %}
          {% if entry contains '. ' %}
            {%- assign first_part = entry | split: '. ' | first -%}
            {%- assign second_part = entry | split: '. ' | last -%}
            {%- assign to_compare = first_part | times: 1 -%}
            {% if to_compare > 0 %}
              {%- assign link_text = second_part -%}
            {% endif %}
          {% endif %}
          <li class="toc--content-item">
            <a class="toc--content-link" href="#{{ entry | handle | prepend: 's-' }}">
              <span class="reversed-link">{{ link_text }}</span>
            </a>
          </li>
        {%- endif -%}
      {%- endfor -%}
    </ul>
  </div>
{%- else -%}
  <toc-collapsible class="tableofcontents {{ class }} {% if position == 'below_article_banner' %}toc-below-banner{% endif %}">
    <div class="toc--content">
      <div class="toc-block--heading">
        <div class="heading {{ section.settings.block_heading_html_style }}">
          {{- 'bso.blog.table_of_contents' | t -}}
          <span class="toggle" aria-controls="toc-content-{{ section_id }}" aria-expanded="{{ desktop-expanded }}" aria-expanded-mobile="{{ mobile-expanded }}"><span class="toggle-label" toggle-label-open="{{ 'bso.general.display' | t }}" toggle-label-close="{{ 'bso.general.hide' | t }}">{{ 'bso.general.hide' | t }}</span></span>
        </div>
      </div>
      <ul class="toc--listing toggle-content" id="toc-content-{{ section_id }}" role="region" aria-label="{{ 'bso.blog.table_of_contents' | t }}">
        {%- for entry in contents_array -%}
          {%- if entry contains '>>' -%}
            {%- assign sub_entries = entry | split: '>>' -%}
            {%- assign parent_text = sub_entries[0] -%}
            {% assign link_text = parent_text %}
            {% if parent_text contains '. ' %}
              {%- assign first_part = parent_text | split: '. ' | first -%}
              {%- assign second_part = parent_text | split: '. ' | last -%}
              {%- assign to_compare = first_part | times: 1 -%}
              {% if to_compare > 0 %}
                {%- assign link_text = second_part -%}
              {% endif %}
            {% endif %}
            <li class="toc--content-item">
              <a class="toc--content-link group" href="#{{ parent_text | handle | prepend: 's-' }}">
                <span class="reversed-link">{{ link_text }}</span>
              </a>
              <ul class="toc--sublist">
                {%- for sub in sub_entries offset: 1 -%}
                  {% assign sub_text = sub %}
                  {% if sub contains '. ' %}
                    {%- assign first_part = sub | split: '. ' | first -%}
                    {%- assign second_part = sub | split: '. ' | last -%}
                    {%- assign to_compare = first_part | times: 1 -%}
                    {% if to_compare > 0 %}
                      {%- assign sub_text = second_part -%}
                    {% endif %}
                  {% endif %}
                  <li class="linklist__sub-item sub-item">
                    <a class="toc--content-link group" href="#{{ sub | handle | prepend: 's-' }}">
                      <span class="reversed-link">{{ sub_text }}</span>
                    </a>
                  </li>
                {%- endfor -%}
              </ul>
            </li>
          {%- else -%}
            {% assign link_text = entry %}
            {% if entry contains '. ' %}
              {%- assign first_part = entry | split: '. ' | first -%}
              {%- assign second_part = entry | split: '. ' | last -%}
              {%- assign to_compare = first_part | times: 1 -%}
              {% if to_compare > 0 %}
                {%- assign link_text = second_part -%}
              {% endif %}
            {% endif %}
            
            <li class="toc--content-item">
              <a class="toc--content-link group" href="#{{ entry | handle | prepend: 's-' }}">
                <span class="reversed-link">{{ link_text }}</span>
              </a>
            </li>
          {%- endif -%}
        {%- endfor -%}
      </ul>
    </div>
  </toc-collapsible>
{%- endunless -%}