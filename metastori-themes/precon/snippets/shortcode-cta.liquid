
{%- comment -%}
Render cta embeds
Usage:
  [[cta recipe="recipe_handle"]]
  [[cta content="testimonials" width="6"]]
  [[cta content="shop" width="6"]]
  [[cta content="trial"]]
  [[cta content="diet_plan"]]
  [[cta content="shakes"]]
  parameters:
    recipe: required, the handle of the recipe
    content: type of content to display
    width: width of the content area (only for certain content types)
{%- endcomment -%}

{%- capture recipe -%}{%- render 'shortcode-param', keys: keys, values: values, param: 'recipe' -%}{%- endcapture -%}
{%- capture content -%}{%- render 'shortcode-param', keys: keys, values: values, param: 'content' -%}{%- endcapture -%}
{%- capture width -%}{%- render 'shortcode-param', keys: keys, values: values, param: 'width' -%}{%- endcapture -%}
{%- capture article_handle -%}{%- render 'shortcode-param', keys: keys, values: values, param: 'article' -%}{%- endcapture -%}
{%- capture name -%}{%- render 'shortcode-param', keys: keys, values: values, param: 'name' -%}{%- endcapture -%}

{% if recipe != blank %}
  {% render 'bso-cta-recipes', recipe_handle: recipe, name: name %}
{% elsif article_handle != blank %}
  {%- render 'bso-cta-article', article_handle: article_handle, name: name -%}
{% elsif content != blank %}
  {% case content %}
    {% when 'testimonials' %}
      {% render 'bso-cta-testimonial', content: content, width: width %}
    {% when 'shop' %}
      {% render 'bso-cta-shop', content: content, width: width %}
    {% when 'trial' %}
      {% render 'bso-cta-trial', content: content, width: width %}
    {% when 'diet_plan' %}
      {% render 'bso-cta-dietplan', content: content, width: width %}
    {% when 'shakes' %}
      {% render 'bso-cta-shakes', content: content, width: width %}
    {% when 'start_shakes' %}
      {% render 'bso-cta-start-shakes', content: content, width: width %}
    {% when 'recipes' %}
      {% render 'bso-cta-content-recipes', content: content, width: width %}
    {% when 'guide' %}
      {% render 'bso-cta-guide', content: content, width: width %}
    {% when 'starter' %}
      {% render 'bso-cta-starter', content: content, width: width %}
    {% when 'testimonial-adriana' %}
      {% render 'bso-cta-testimonial-adriana', content: content, width: width %}
    {% when 'testimonial-ute' %}
      {% render 'bso-cta-testimonial-ute', content: content, width: width %}
  {% endcase %}
{% endif %}