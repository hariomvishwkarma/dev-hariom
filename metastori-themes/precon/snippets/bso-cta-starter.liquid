{% assign col_width = width | default: "12" %}
<div class="bso-column bso-column-{{ col_width }}">
  <div class="shortcode shortcode-cta cta-starter {% if col_width == "12" %}cta-fullsize mg-top{% endif %}">
    <div class="cta--wrapper">

      <div class="cta-image-container">
        <div class="cta-image--wrapper">
          <img
            src="https://cdn.shopify.com/s/files/1/0904/4639/7774/files/cta-trial.png?v=1756465679"
            class="cta-image cta-starter--image"
            alt="{{ 'bso_shortcode.cta_starter.header' | t }}"
          >
        </div>
      </div>

      <div class="cta-content">
        <div class="cta-content--wrapper">
          <div class="cta-header">{{ 'bso_shortcode.cta_starter.header' | t }}</div>
          <div class="cta-description">{{ 'bso_shortcode.cta_starter.description' | t }}</div>
          <div class="cta-button--wrapper">
            {% assign cta_link = '#' %}
            {% if localization.country.iso_code == 'CH' %}
              {% assign cta_link = settings.cta_starter_link_switzerland | default: '#' %}
            {% else %}
              {% assign cta_link = settings.cta_starter_link %}
            {% endif %}
            <a href="{{ cta_link }}" class="button cta-button">{{ 'bso_shortcode.cta_starter.button_text' | t }}</a>
          </div>
        </div>
      </div>

    </div>
  </div>
</div>