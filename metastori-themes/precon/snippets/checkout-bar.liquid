<checkout-bar hidden class='checkout-bar text--xsmall'>
	{%- if no_gifts_warning_text != blank -%}
		<p>{{- no_gifts_warning_text -}}</p>
	{%- endif -%}

	<div class='checkout-bar__actions'>
		<button class='button button--text button--ternary button--xsmall text--xxsmall text--xxxsmall-mobile' data-action='yes'>
			Ich will keine Geschenke
		</button>
		<button class='button button--text button--primary button--xsmall text--xxsmall text--xxxsmall-mobile' data-action='no'>
			Ich will noch Geschenke!
		</button>
	</div>
</checkout-bar>
