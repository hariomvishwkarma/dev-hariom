{% doc %}
  @prompt
    A section describing 4 benefits for our online shop.
    On the left hand Side there should be a title "Deine Vorteile" und Subtitle "Warum sich eine Precon Newsletter Anmeldung unbedingt lohnt". On the right hand side I want 4 rectangle blocks for those 4 benefits. Each should contain an Icon, title and text (both in the same size). These are the Icons I need: a battery, a cup of tea, a gift, a person
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-benefits-section-{{ ai_gen_id }} {
    padding: {{ block.settings.section_padding }}px 0;
    background-color: {{ block.settings.background_color }};
  }

  .ai-benefits-container-{{ ai_gen_id }} {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 20px;
    display: grid;
    grid-template-columns: 1fr 2fr;
    gap: 60px;
    align-items: start;
  }

  .ai-benefits-header-{{ ai_gen_id }} {
    position: sticky;
    top: 100px;
  }

  .ai-benefits-title-{{ ai_gen_id }} {
    font-size: {{ block.settings.title_size }}px;
    color: {{ block.settings.title_color }};
    margin: 0 0 16px 0;
    font-weight: 600;
  }

  .ai-benefits-subtitle-{{ ai_gen_id }} {
    font-size: {{ block.settings.subtitle_size }}px;
    color: {{ block.settings.subtitle_color }};
    line-height: 1.5;
    margin: 0;
  }

  .ai-benefits-grid-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 24px;
  }

  .ai-benefit-card-{{ ai_gen_id }} {
    background-color: {{ block.settings.card_background }};
    border: {{ block.settings.card_border_width }}px solid {{ block.settings.card_border_color }};
    border-radius: {{ block.settings.card_border_radius }}px;
    padding: {{ block.settings.card_padding }}px;
    display: flex;
    flex-direction: column;
    gap: 16px;
    transition: transform 0.3s ease, box-shadow 0.3s ease;
  }

  .ai-benefit-card-{{ ai_gen_id }}:hover {
    transform: translateY(-4px);
    box-shadow: 0 8px 16px rgba(0, 0, 0, 0.1);
  }

  .ai-benefit-icon-{{ ai_gen_id }} {
    width: {{ block.settings.icon_size }}px;
    height: {{ block.settings.icon_size }}px;
    color: {{ block.settings.icon_color }};
    flex-shrink: 0;
  }

  .ai-benefit-icon-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
    stroke-width: 2px;
  }

  .ai-benefit-title-{{ ai_gen_id }} {
    font-size: {{ block.settings.benefit_text_size }}px;
    color: {{ block.settings.benefit_title_color }};
    margin: 0;
    font-weight: 600;
  }

  .ai-benefit-text-{{ ai_gen_id }} {
    font-size: {{ block.settings.benefit_text_size }}px;
    color: {{ block.settings.benefit_text_color }};
    line-height: 1.6;
    margin: 0;
  }

  @media screen and (max-width: 989px) {
    .ai-benefits-container-{{ ai_gen_id }} {
      grid-template-columns: 1fr;
      gap: 40px;
    }

    .ai-benefits-header-{{ ai_gen_id }} {
      position: static;
    }

    .ai-benefits-grid-{{ ai_gen_id }} {
      grid-template-columns: 1fr;
    }
  }

  @media screen and (min-width: 750px) and (max-width: 989px) {
    .ai-benefits-grid-{{ ai_gen_id }} {
      grid-template-columns: repeat(2, 1fr);
    }
  }
{% endstyle %}

<div class="ai-benefits-section-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-benefits-container-{{ ai_gen_id }}">
    <div class="ai-benefits-header-{{ ai_gen_id }}">
      {% if block.settings.title != blank %}
        <h2 class="ai-benefits-title-{{ ai_gen_id }}">{{ block.settings.title }}</h2>
      {% endif %}
      {% if block.settings.subtitle != blank %}
        <p class="ai-benefits-subtitle-{{ ai_gen_id }}">{{ block.settings.subtitle }}</p>
      {% endif %}
    </div>

    <div class="ai-benefits-grid-{{ ai_gen_id }}">
      {% if block.settings.benefit_1_enabled %}
        <div class="ai-benefit-card-{{ ai_gen_id }}">
          <div class="ai-benefit-icon-{{ ai_gen_id }}">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round">
              <rect x="5" y="2" width="14" height="20" rx="2" ry="2"></rect>
              <line x1="12" y1="18" x2="12" y2="18"></line>
            </svg>
          </div>
          {% if block.settings.benefit_1_title != blank %}
            <h3 class="ai-benefit-title-{{ ai_gen_id }}">{{ block.settings.benefit_1_title }}</h3>
          {% endif %}
          {% if block.settings.benefit_1_text != blank %}
            <p class="ai-benefit-text-{{ ai_gen_id }}">{{ block.settings.benefit_1_text }}</p>
          {% endif %}
        </div>
      {% endif %}

      {% if block.settings.benefit_2_enabled %}
        <div class="ai-benefit-card-{{ ai_gen_id }}">
          <div class="ai-benefit-icon-{{ ai_gen_id }}">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round">
              <path d="M17 8h1a4 4 0 1 1 0 8h-1"></path>
              <path d="M3 8h14v9a4 4 0 0 1-4 4H7a4 4 0 0 1-4-4Z"></path>
              <line x1="6" y1="2" x2="6" y2="8"></line>
              <line x1="10" y1="2" x2="10" y2="8"></line>
              <line x1="14" y1="2" x2="14" y2="8"></line>
            </svg>
          </div>
          {% if block.settings.benefit_2_title != blank %}
            <h3 class="ai-benefit-title-{{ ai_gen_id }}">{{ block.settings.benefit_2_title }}</h3>
          {% endif %}
          {% if block.settings.benefit_2_text != blank %}
            <p class="ai-benefit-text-{{ ai_gen_id }}">{{ block.settings.benefit_2_text }}</p>
          {% endif %}
        </div>
      {% endif %}

      {% if block.settings.benefit_3_enabled %}
        <div class="ai-benefit-card-{{ ai_gen_id }}">
          <div class="ai-benefit-icon-{{ ai_gen_id }}">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round">
              <polyline points="20 12 20 22 4 22 4 12"></polyline>
              <rect x="2" y="7" width="20" height="5"></rect>
              <line x1="12" y1="22" x2="12" y2="7"></line>
              <path d="M12 7H7.5a2.5 2.5 0 0 1 0-5C11 2 12 7 12 7z"></path>
              <path d="M12 7h4.5a2.5 2.5 0 0 0 0-5C13 2 12 7 12 7z"></path>
            </svg>
          </div>
          {% if block.settings.benefit_3_title != blank %}
            <h3 class="ai-benefit-title-{{ ai_gen_id }}">{{ block.settings.benefit_3_title }}</h3>
          {% endif %}
          {% if block.settings.benefit_3_text != blank %}
            <p class="ai-benefit-text-{{ ai_gen_id }}">{{ block.settings.benefit_3_text }}</p>
          {% endif %}
        </div>
      {% endif %}

      {% if block.settings.benefit_4_enabled %}
        <div class="ai-benefit-card-{{ ai_gen_id }}">
          <div class="ai-benefit-icon-{{ ai_gen_id }}">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round">
              <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
              <circle cx="12" cy="7" r="4"></circle>
            </svg>
          </div>
          {% if block.settings.benefit_4_title != blank %}
            <h3 class="ai-benefit-title-{{ ai_gen_id }}">{{ block.settings.benefit_4_title }}</h3>
          {% endif %}
          {% if block.settings.benefit_4_text != blank %}
            <p class="ai-benefit-text-{{ ai_gen_id }}">{{ block.settings.benefit_4_text }}</p>
          {% endif %}
        </div>
      {% endif %}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Vorteile",
  "settings": [
    {
      "type": "header",
      "content": "Hauptüberschrift"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Titel",
      "default": "Deine Vorteile"
    },
    {
      "type": "textarea",
      "id": "subtitle",
      "label": "Untertitel",
      "default": "Warum sich eine Precon Newsletter Anmeldung unbedingt lohnt"
    },
    {
      "type": "range",
      "id": "title_size",
      "min": 20,
      "max": 60,
      "step": 2,
      "unit": "px",
      "label": "Titelgröße",
      "default": 36
    },
    {
      "type": "range",
      "id": "subtitle_size",
      "min": 14,
      "max": 28,
      "step": 2,
      "unit": "px",
      "label": "Untertitelgröße",
      "default": 18
    },
    {
      "type": "color",
      "id": "title_color",
      "label": "Titelfarbe",
      "default": "#56473a"
    },
    {
      "type": "color",
      "id": "subtitle_color",
      "label": "Untertitelfarbe",
      "default": "#56473A"
    },
    {
      "type": "header",
      "content": "Vorteil 1 - Batterie"
    },
    {
      "type": "checkbox",
      "id": "benefit_1_enabled",
      "label": "Vorteil 1 aktivieren",
      "default": true
    },
    {
      "type": "text",
      "id": "benefit_1_title",
      "label": "Titel",
      "default": "Energie & Vitalität"
    },
    {
      "type": "textarea",
      "id": "benefit_1_text",
      "label": "Text",
      "default": "Erhalte wertvolle Tipps für mehr Energie im Alltag"
    },
    {
      "type": "header",
      "content": "Vorteil 2 - Teetasse"
    },
    {
      "type": "checkbox",
      "id": "benefit_2_enabled",
      "label": "Vorteil 2 aktivieren",
      "default": true
    },
    {
      "type": "text",
      "id": "benefit_2_title",
      "label": "Titel",
      "default": "Rezepte & Inspiration"
    },
    {
      "type": "textarea",
      "id": "benefit_2_text",
      "label": "Text",
      "default": "Entdecke leckere und gesunde Rezeptideen"
    },
    {
      "type": "header",
      "content": "Vorteil 3 - Geschenk"
    },
    {
      "type": "checkbox",
      "id": "benefit_3_enabled",
      "label": "Vorteil 3 aktivieren",
      "default": true
    },
    {
      "type": "text",
      "id": "benefit_3_title",
      "label": "Titel",
      "default": "Exklusive Angebote"
    },
    {
      "type": "textarea",
      "id": "benefit_3_text",
      "label": "Text",
      "default": "Sichere dir besondere Rabatte und Aktionen"
    },
    {
      "type": "header",
      "content": "Vorteil 4 - Person"
    },
    {
      "type": "checkbox",
      "id": "benefit_4_enabled",
      "label": "Vorteil 4 aktivieren",
      "default": true
    },
    {
      "type": "text",
      "id": "benefit_4_title",
      "label": "Titel",
      "default": "Persönliche Beratung"
    },
    {
      "type": "textarea",
      "id": "benefit_4_text",
      "label": "Text",
      "default": "Profitiere von individuellen Ernährungstipps"
    },
    {
      "type": "header",
      "content": "Kartenstil"
    },
    {
      "type": "color",
      "id": "card_background",
      "label": "Kartenhintergrund",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "card_border_color",
      "label": "Kartenrahmenfarbe",
      "default": "#e5e5e5"
    },
    {
      "type": "range",
      "id": "card_border_width",
      "min": 0,
      "max": 4,
      "step": 1,
      "unit": "px",
      "label": "Kartenrahmenbreite",
      "default": 1
    },
    {
      "type": "range",
      "id": "card_border_radius",
      "min": 0,
      "max": 24,
      "step": 2,
      "unit": "px",
      "label": "Karteneckenradius",
      "default": 8
    },
    {
      "type": "range",
      "id": "card_padding",
      "min": 16,
      "max": 48,
      "step": 4,
      "unit": "px",
      "label": "Karteninnenabstand",
      "default": 24
    },
    {
      "type": "header",
      "content": "Icon & Text"
    },
    {
      "type": "range",
      "id": "icon_size",
      "min": 24,
      "max": 64,
      "step": 4,
      "unit": "px",
      "label": "Icongröße",
      "default": 40
    },
    {
      "type": "color",
      "id": "icon_color",
      "label": "Iconfarbe",
      "default": "#3dadbb"
    },
    {
      "type": "range",
      "id": "benefit_text_size",
      "min": 14,
      "max": 20,
      "step": 1,
      "unit": "px",
      "label": "Textgröße",
      "default": 16
    },
    {
      "type": "color",
      "id": "benefit_title_color",
      "label": "Vorteil Titelfarbe",
      "default": "#56473a"
    },
    {
      "type": "color",
      "id": "benefit_text_color",
      "label": "Vorteil Textfarbe",
      "default": "#56473A"
    },
    {
      "type": "header",
      "content": "Abschnitt"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Hintergrundfarbe",
      "default": "#ffffff"
    },
    {
      "type": "range",
      "id": "section_padding",
      "min": 20,
      "max": 100,
      "step": 10,
      "unit": "px",
      "label": "Abschnittsabstand",
      "default": 60
    }
  ],
  "presets": [
    {
      "name": "Vorteile"
    }
  ]
}
{% endschema %}