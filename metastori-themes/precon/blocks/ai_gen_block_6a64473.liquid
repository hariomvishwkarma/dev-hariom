{% doc %}
  @prompt
    Container with customizable height and background colour. Title in the container, text size, colour and width should be customizable., The height should go down to 70, and on mobile the text size should be customizable apart from desktop.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-custom-container-{{ ai_gen_id }} {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: {{ block.settings.container_height }}px;
    background-color: {{ block.settings.background_color }};
    padding: 20px;
  }

  .ai-custom-container__title-{{ ai_gen_id }} {
    color: {{ block.settings.title_color }};
    font-size: {{ block.settings.title_size }}px;
    max-width: {{ block.settings.title_width }}%;
    margin: 0;
    text-align: center;
    line-height: 1.3;
  }

  @media screen and (max-width: 749px) {
    .ai-custom-container__title-{{ ai_gen_id }} {
      font-size: {{ block.settings.title_size_mobile }}px;
    }
  }
{% endstyle %}

<div class="ai-custom-container-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  {% if block.settings.title != blank %}
    <h2 class="ai-custom-container__title-{{ ai_gen_id }}">
      {{ block.settings.title }}
    </h2>
  {% endif %}
</div>

{% schema %}
{
  "name": "Custom container",
  "settings": [
    {
      "type": "header",
      "content": "Container"
    },
    {
      "type": "range",
      "id": "container_height",
      "min": 70,
      "max": 800,
      "step": 10,
      "unit": "px",
      "label": "Height",
      "default": 300
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "default": "#f5f5f5"
    },
    {
      "type": "header",
      "content": "Title"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Title",
      "default": "Your custom title"
    },
    {
      "type": "range",
      "id": "title_size",
      "min": 16,
      "max": 80,
      "step": 2,
      "unit": "px",
      "label": "Text size (desktop)",
      "default": 32
    },
    {
      "type": "range",
      "id": "title_size_mobile",
      "min": 14,
      "max": 60,
      "step": 2,
      "unit": "px",
      "label": "Text size (mobile)",
      "default": 24
    },
    {
      "type": "color",
      "id": "title_color",
      "label": "Text color",
      "default": "#56473a"
    },
    {
      "type": "range",
      "id": "title_width",
      "min": 20,
      "max": 100,
      "step": 5,
      "unit": "%",
      "label": "Width",
      "default": 80
    }
  ],
  "presets": [
    {
      "name": "Custom container"
    }
  ]
}
{% endschema %}
