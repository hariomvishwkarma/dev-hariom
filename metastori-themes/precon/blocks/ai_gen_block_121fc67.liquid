{% doc %}
  @prompt
    A title with body text. Option the align left, center and right., I need an option to determine the width of the text box, or an option to have padding on both sides
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-title-body-{{ ai_gen_id }} {
    text-align: {{ block.settings.text_alignment }};
    padding: 40px {{ block.settings.horizontal_padding }}px;
  }

  .ai-title-body__container-{{ ai_gen_id }} {
    max-width: {{ block.settings.content_width }}px;
    margin: 0 auto;
  }

  .ai-title-body__heading-{{ ai_gen_id }} {
    color: {{ block.settings.heading_color }};
    font-size: {{ block.settings.heading_size }}px;
    margin: 0 0 16px 0;
    line-height: 1.2;
  }

  .ai-title-body__text-{{ ai_gen_id }} {
    color: {{ block.settings.text_color }};
    font-size: {{ block.settings.text_size }}px;
    line-height: 1.6;
    margin: 0;
  }

  @media screen and (max-width: 749px) {
    .ai-title-body-{{ ai_gen_id }} {
      padding: 40px {{ block.settings.horizontal_padding | times: 0.5 }}px;
    }

    .ai-title-body__heading-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.heading_size }}px * 0.8);
    }

    .ai-title-body__text-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.text_size }}px * 0.9);
    }
  }
{% endstyle %}

<div class="ai-title-body-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-title-body__container-{{ ai_gen_id }}">
    {% if block.settings.heading != blank %}
      <h2 class="ai-title-body__heading-{{ ai_gen_id }}">{{ block.settings.heading }}</h2>
    {% endif %}

    {% if block.settings.body_text != blank %}
      <div class="ai-title-body__text-{{ ai_gen_id }}">{{ block.settings.body_text }}</div>
    {% endif %}
  </div>
</div>

{% schema %}
{
  "name": "Title with body text",
  "settings": [
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Heading",
      "default": "Heading text"
    },
    {
      "type": "richtext",
      "id": "body_text",
      "label": "Body text",
      "default": "<p>Add your body text here. You can customize the alignment and colors to match your brand.</p>"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "text_alignment",
      "label": "Text alignment",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ],
      "default": "center"
    },
    {
      "type": "range",
      "id": "content_width",
      "min": 400,
      "max": 1200,
      "step": 50,
      "unit": "px",
      "label": "Content width",
      "default": 800
    },
    {
      "type": "range",
      "id": "horizontal_padding",
      "min": 0,
      "max": 100,
      "step": 10,
      "unit": "px",
      "label": "Horizontal padding",
      "default": 20
    },
    {
      "type": "header",
      "content": "Style"
    },
    {
      "type": "range",
      "id": "heading_size",
      "min": 20,
      "max": 60,
      "step": 2,
      "unit": "px",
      "label": "Heading size",
      "default": 32
    },
    {
      "type": "range",
      "id": "text_size",
      "min": 12,
      "max": 24,
      "step": 1,
      "unit": "px",
      "label": "Body text size",
      "default": 16
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading color",
      "default": "#56473a"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Body text color",
      "default": "#56473A"
    }
  ],
  "presets": [
    {
      "name": "Title with body text"
    }
  ]
}
{% endschema %}
