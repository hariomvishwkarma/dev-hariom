{% doc %}
  @prompt
    A title, a body text, a button and 4 announcement bar style benefits each with icon. I want to be able to change the background colour of the section, the title size and colour (rich text), the body text size and colour (rich text), and button radius, text colour, text size, background colour and button width. I want to be able to link the button to specific products or pages. I want to be able to select the text size and colour of the announcement bar texts, Can you put all announcement bar benefits next to each other. They should not have a separate background colour., I want to be able to select individual icons for each benefit
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-benefits-section-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    background-color: {{ block.settings.section_background_color }};
    padding: 40px 20px;
  }

  .ai-benefits-container-{{ ai_gen_id }} {
    max-width: 1200px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    gap: 32px;
  }

  .ai-benefits-content-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    gap: 16px;
    text-align: center;
  }

  .ai-benefits-title-{{ ai_gen_id }} {
    margin: 0;
    font-size: {{ block.settings.title_size }}px;
    color: {{ block.settings.title_color }};
    line-height: 1.2;
  }

  .ai-benefits-body-{{ ai_gen_id }} {
    margin: 0;
    font-size: {{ block.settings.body_size }}px;
    color: {{ block.settings.body_color }};
    line-height: 1.6;
  }

  .ai-benefits-button-wrapper-{{ ai_gen_id }} {
    display: flex;
    justify-content: center;
    margin-top: 8px;
  }

  .ai-benefits-button-{{ ai_gen_id }} {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 14px 32px;
    background-color: {{ block.settings.button_background_color }};
    color: {{ block.settings.button_text_color }};
    font-size: {{ block.settings.button_text_size }}px;
    border-radius: {{ block.settings.button_border_radius }}px;
    text-decoration: none;
    border: none;
    cursor: pointer;
    transition: opacity 0.3s ease;
    width: {{ block.settings.button_width }}%;
    max-width: 100%;
  }

  .ai-benefits-button-{{ ai_gen_id }}:hover {
    opacity: 0.85;
  }

  .ai-benefits-bars-{{ ai_gen_id }} {
    display: flex;
    flex-wrap: wrap;
    gap: 24px;
    justify-content: center;
  }

  .ai-benefits-bar-{{ ai_gen_id }} {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .ai-benefits-icon-{{ ai_gen_id }} {
    flex-shrink: 0;
    width: 20px;
    height: 20px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: {{ block.settings.bar_icon_color }};
  }

  .ai-benefits-icon-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
  }

  .ai-benefits-bar-text-{{ ai_gen_id }} {
    font-size: {{ block.settings.bar_text_size }}px;
    color: {{ block.settings.bar_text_color }};
    margin: 0;
    white-space: nowrap;
  }

  @media screen and (max-width: 749px) {
    .ai-benefits-section-{{ ai_gen_id }} {
      padding: 32px 16px;
    }

    .ai-benefits-container-{{ ai_gen_id }} {
      gap: 24px;
    }

    .ai-benefits-title-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.title_size }}px * 0.85);
    }

    .ai-benefits-body-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.body_size }}px * 0.95);
    }

    .ai-benefits-button-{{ ai_gen_id }} {
      width: 100%;
    }

    .ai-benefits-bars-{{ ai_gen_id }} {
      flex-direction: column;
      gap: 16px;
    }

    .ai-benefits-bar-text-{{ ai_gen_id }} {
      white-space: normal;
    }
  }
{% endstyle %}

