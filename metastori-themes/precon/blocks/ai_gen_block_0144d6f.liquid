{% doc %}
  @prompt
    A section with 3 horizontal blocks, each block with the option to add an icon, title and text, each below each other. Background colour should be customizable. On mobile, the 3 blocks should be below each other, Change all text and title fields to rich text. , The rich text is not working. I cannot make the text bold
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-feature-blocks-{{ ai_gen_id }} {
    background-color: {{ block.settings.background_color }};
    padding: 60px 20px;
  }

  .ai-feature-blocks-container-{{ ai_gen_id }} {
    max-width: 1200px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 40px;
  }

  .ai-feature-block-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 16px;
  }

  .ai-feature-block-icon-{{ ai_gen_id }} {
    width: {{ block.settings.icon_size }}px;
    height: {{ block.settings.icon_size }}px;
    flex-shrink: 0;
  }

  .ai-feature-block-icon-{{ ai_gen_id }} img {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .ai-feature-block-icon-placeholder-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    background-color: {{ block.settings.icon_placeholder_color }};
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .ai-feature-block-icon-placeholder-{{ ai_gen_id }} svg {
    width: 60%;
    height: 60%;
    opacity: 0.3;
  }

  .ai-feature-block-title-{{ ai_gen_id }} {
    font-size: {{ block.settings.title_size }}px;
    color: {{ block.settings.title_color }};
    font-weight: 600;
  }

  .ai-feature-block-title-{{ ai_gen_id }} p {
    margin: 0;
  }

  .ai-feature-block-title-{{ ai_gen_id }} strong,
  .ai-feature-block-title-{{ ai_gen_id }} b {
    font-weight: 700;
  }

  .ai-feature-block-title-{{ ai_gen_id }} em,
  .ai-feature-block-title-{{ ai_gen_id }} i {
    font-style: italic;
  }

  .ai-feature-block-text-{{ ai_gen_id }} {
    font-size: {{ block.settings.text_size }}px;
    color: {{ block.settings.text_color }};
    line-height: 1.6;
  }

  .ai-feature-block-text-{{ ai_gen_id }} p {
    margin: 0 0 8px 0;
  }

  .ai-feature-block-text-{{ ai_gen_id }} p:last-child {
    margin-bottom: 0;
  }

  .ai-feature-block-text-{{ ai_gen_id }} strong,
  .ai-feature-block-text-{{ ai_gen_id }} b {
    font-weight: 700;
  }

  .ai-feature-block-text-{{ ai_gen_id }} em,
  .ai-feature-block-text-{{ ai_gen_id }} i {
    font-style: italic;
  }

  .ai-feature-block-text-{{ ai_gen_id }} ul,
  .ai-feature-block-text-{{ ai_gen_id }} ol {
    margin: 8px 0;
    padding-left: 20px;
    text-align: left;
  }

  .ai-feature-block-text-{{ ai_gen_id }} li {
    margin-bottom: 4px;
  }

  @media screen and (max-width: 749px) {
    .ai-feature-blocks-{{ ai_gen_id }} {
      padding: 40px 20px;
    }

    .ai-feature-blocks-container-{{ ai_gen_id }} {
      grid-template-columns: 1fr;
      gap: 32px;
    }
  }
{% endstyle %}

<div class="ai-feature-blocks-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-feature-blocks-container-{{ ai_gen_id }}">
    {% for i in (1..3) %}
      {% liquid
        assign icon_key = 'block_' | append: i | append: '_icon'
        assign title_key = 'block_' | append: i | append: '_title'
        assign text_key = 'block_' | append: i | append: '_text'

        assign icon = block.settings[icon_key]
        assign title = block.settings[title_key]
        assign text = block.settings[text_key]
      %}

      <div class="ai-feature-block-{{ ai_gen_id }}">
        <div class="ai-feature-block-icon-{{ ai_gen_id }}">
          {% if icon != blank %}
            <img
              src="{{ icon | image_url: width: 200 }}"
              alt="{{ title | strip_html | escape }}"
              loading="lazy"
              width="200"
              height="200"
            >
          {% else %}
            <div class="ai-feature-block-icon-placeholder-{{ ai_gen_id }}">
              {{ 'image' | placeholder_svg_tag }}
            </div>
          {% endif %}
        </div>

        {% if title != blank %}
          <div class="ai-feature-block-title-{{ ai_gen_id }}">{{ title }}</div>
        {% endif %}

        {% if text != blank %}
          <div class="ai-feature-block-text-{{ ai_gen_id }}">{{ text }}</div>
        {% endif %}
      </div>
    {% endfor %}
  </div>
</div>

{% schema %}
{
  "name": "Feature blocks",
  "settings": [
    {
      "type": "header",
      "content": "Background"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "default": "#f5f5f5"
    },
    {
      "type": "header",
      "content": "Icon style"
    },
    {
      "type": "range",
      "id": "icon_size",
      "min": 40,
      "max": 120,
      "step": 10,
      "unit": "px",
      "label": "Icon size",
      "default": 80
    },
    {
      "type": "color",
      "id": "icon_placeholder_color",
      "label": "Placeholder color",
      "default": "#e0e0e0"
    },
    {
      "type": "header",
      "content": "Text style"
    },
    {
      "type": "range",
      "id": "title_size",
      "min": 14,
      "max": 32,
      "step": 2,
      "unit": "px",
      "label": "Title size",
      "default": 20
    },
    {
      "type": "color",
      "id": "title_color",
      "label": "Title color",
      "default": "#56473a"
    },
    {
      "type": "range",
      "id": "text_size",
      "min": 12,
      "max": 20,
      "step": 1,
      "unit": "px",
      "label": "Text size",
      "default": 16
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#56473a"
    },
    {
      "type": "header",
      "content": "Block 1"
    },
    {
      "type": "image_picker",
      "id": "block_1_icon",
      "label": "Icon"
    },
    {
      "type": "richtext",
      "id": "block_1_title",
      "label": "Title",
      "default": "<p>Feature one</p>"
    },
    {
      "type": "richtext",
      "id": "block_1_text",
      "label": "Text",
      "default": "<p>Share details about your product or service</p>"
    },
    {
      "type": "header",
      "content": "Block 2"
    },
    {
      "type": "image_picker",
      "id": "block_2_icon",
      "label": "Icon"
    },
    {
      "type": "richtext",
      "id": "block_2_title",
      "label": "Title",
      "default": "<p>Feature two</p>"
    },
    {
      "type": "richtext",
      "id": "block_2_text",
      "label": "Text",
      "default": "<p>Share details about your product or service</p>"
    },
    {
      "type": "header",
      "content": "Block 3"
    },
    {
      "type": "image_picker",
      "id": "block_3_icon",
      "label": "Icon"
    },
    {
      "type": "richtext",
      "id": "block_3_title",
      "label": "Title",
      "default": "<p>Feature three</p>"
    },
    {
      "type": "richtext",
      "id": "block_3_text",
      "label": "Text",
      "default": "<p>Share details about your product or service</p>"
    }
  ],
  "presets": [
    {
      "name": "Feature blocks"
    }
  ]
}
{% endschema %}