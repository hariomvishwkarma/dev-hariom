{% doc %}
  @prompt
    A section showing 5 benefits of shopping with precon, each with small titel and text, in separate blocks next to each other, Can you add a titel above?
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-benefits-section-{{ ai_gen_id }} {
    padding: {{ block.settings.padding }}px 0;
  }

  .ai-benefits-header-{{ ai_gen_id }} {
    text-align: {{ block.settings.header_alignment }};
    margin-bottom: {{ block.settings.header_spacing }}px;
  }

  .ai-benefits-title-{{ ai_gen_id }} {
    font-size: {{ block.settings.main_title_size }}px;
    font-weight: 600;
    color: {{ block.settings.main_title_color }};
    margin: 0;
  }

  .ai-benefits-container-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: {{ block.settings.gap }}px;
  }

  .ai-benefit-item-{{ ai_gen_id }} {
    text-align: {{ block.settings.text_alignment }};
    padding: {{ block.settings.item_padding }}px;
    background-color: {{ block.settings.item_background }};
    border-radius: {{ block.settings.item_border_radius }}px;
  }

  .ai-benefit-icon-{{ ai_gen_id }} {
    width: {{ block.settings.icon_size }}px;
    height: {{ block.settings.icon_size }}px;
    margin: 0 auto {{ block.settings.icon_spacing }}px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .ai-benefit-icon-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
    color: {{ block.settings.icon_color }};
  }

  .ai-benefit-title-{{ ai_gen_id }} {
    font-size: {{ block.settings.title_size }}px;
    font-weight: 600;
    color: {{ block.settings.title_color }};
    margin: 0 0 {{ block.settings.title_spacing }}px;
  }

  .ai-benefit-text-{{ ai_gen_id }} {
    font-size: {{ block.settings.text_size }}px;
    color: {{ block.settings.text_color }};
    margin: 0;
    line-height: 1.5;
  }

  @media screen and (max-width: 989px) {
    .ai-benefits-container-{{ ai_gen_id }} {
      grid-template-columns: repeat(3, 1fr);
    }

    .ai-benefits-title-{{ ai_gen_id }} {
      font-size: {{ block.settings.main_title_size | times: 0.85 }}px;
    }
  }

  @media screen and (max-width: 749px) {
    .ai-benefits-container-{{ ai_gen_id }} {
      grid-template-columns: repeat(2, 1fr);
      gap: {{ block.settings.gap | times: 0.75 }}px;
    }

    .ai-benefit-item-{{ ai_gen_id }} {
      padding: {{ block.settings.item_padding | times: 0.75 }}px;
    }

    .ai-benefit-icon-{{ ai_gen_id }} {
      width: {{ block.settings.icon_size | times: 0.8 }}px;
      height: {{ block.settings.icon_size | times: 0.8 }}px;
    }

    .ai-benefit-title-{{ ai_gen_id }} {
      font-size: {{ block.settings.title_size | times: 0.9 }}px;
    }

    .ai-benefit-text-{{ ai_gen_id }} {
      font-size: {{ block.settings.text_size | times: 0.9 }}px;
    }

    .ai-benefits-title-{{ ai_gen_id }} {
      font-size: {{ block.settings.main_title_size | times: 0.75 }}px;
    }

    .ai-benefits-header-{{ ai_gen_id }} {
      margin-bottom: {{ block.settings.header_spacing | times: 0.75 }}px;
    }
  }
{% endstyle %}

<div class="ai-benefits-section-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  {% if block.settings.main_title != blank %}
    <div class="ai-benefits-header-{{ ai_gen_id }}">
      <h2 class="ai-benefits-title-{{ ai_gen_id }}">{{ block.settings.main_title }}</h2>
    </div>
  {% endif %}

  <div class="ai-benefits-container-{{ ai_gen_id }}">
    <div class="ai-benefit-item-{{ ai_gen_id }}">
      <div class="ai-benefit-icon-{{ ai_gen_id }}">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M20 6L9 17l-5-5"/>
        </svg>
      </div>
      <h3 class="ai-benefit-title-{{ ai_gen_id }}">{{ block.settings.benefit_1_title }}</h3>
      <p class="ai-benefit-text-{{ ai_gen_id }}">{{ block.settings.benefit_1_text }}</p>
    </div>

    <div class="ai-benefit-item-{{ ai_gen_id }}">
      <div class="ai-benefit-icon-{{ ai_gen_id }}">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
        </svg>
      </div>
      <h3 class="ai-benefit-title-{{ ai_gen_id }}">{{ block.settings.benefit_2_title }}</h3>
      <p class="ai-benefit-text-{{ ai_gen_id }}">{{ block.settings.benefit_2_text }}</p>
    </div>

    <div class="ai-benefit-item-{{ ai_gen_id }}">
      <div class="ai-benefit-icon-{{ ai_gen_id }}">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/>
          <circle cx="12" cy="10" r="3"/>
        </svg>
      </div>
      <h3 class="ai-benefit-title-{{ ai_gen_id }}">{{ block.settings.benefit_3_title }}</h3>
      <p class="ai-benefit-text-{{ ai_gen_id }}">{{ block.settings.benefit_3_text }}</p>
    </div>

    <div class="ai-benefit-item-{{ ai_gen_id }}">
      <div class="ai-benefit-icon-{{ ai_gen_id }}">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="12" cy="12" r="10"/>
          <polyline points="12 6 12 12 16 14"/>
        </svg>
      </div>
      <h3 class="ai-benefit-title-{{ ai_gen_id }}">{{ block.settings.benefit_4_title }}</h3>
      <p class="ai-benefit-text-{{ ai_gen_id }}">{{ block.settings.benefit_4_text }}</p>
    </div>

    <div class="ai-benefit-item-{{ ai_gen_id }}">
      <div class="ai-benefit-icon-{{ ai_gen_id }}">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/>
          <polyline points="22 4 12 14.01 9 11.01"/>
        </svg>
      </div>
      <h3 class="ai-benefit-title-{{ ai_gen_id }}">{{ block.settings.benefit_5_title }}</h3>
      <p class="ai-benefit-text-{{ ai_gen_id }}">{{ block.settings.benefit_5_text }}</p>
    </div>
  </div>
</div>

{% schema %}
{
