      "label": "Title color",
      "default": "#56473a"
    },
    {
      "type": "select",
      "id": "header_alignment",
      "label": "Title alignment",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        }
