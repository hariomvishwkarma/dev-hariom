{% doc %}
  @prompt
    A button style title, a title and a body text. The button-style title should be editable: background colour, text colour, rich text, text thickness. The title and body text should be editable: text size and text colour. Both also rich text. I want to be able to adjust the padding between the 3 elements, I want to be able to adjust text size within the button, as well as spacing or width within the button. I want to have everything centered., I want to add more horizontal padding in the button. I also want more padding at the top and bottom of the whole section., Rather than horizontal padding I want to adjust the width of the button. , Text thickness for the button doesn't work. Can you please fix this?, The text in the button needs to be thicker, The Text thickness setting is not responsive. Please fix., For the title, we need to reduce the line spacing. On mobile, we need more padding on the left and right hand side,
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-text-block-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    padding-top: {{ block.settings.section_padding_top }}px;
    padding-bottom: {{ block.settings.section_padding_bottom }}px;
    background-color: #FFFFFF;
  }

  .ai-text-block__container-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  .ai-text-block__button-title-{{ ai_gen_id }} {
    display: inline-block;
    padding: {{ block.settings.button_title_padding_vertical }}px 0;
    background-color: {{ block.settings.button_title_bg_color }};
    color: {{ block.settings.button_title_text_color }};
    border-radius: {{ block.settings.button_title_border_radius }}px;
    font-size: {{ block.settings.button_title_font_size }}px;
    font-weight: {{ block.settings.button_title_font_weight }};
    margin-bottom: {{ block.settings.spacing_button_title }}px;
    width: {{ block.settings.button_title_width }}px;
    max-width: 100%;
  }

  .ai-text-block__button-title-{{ ai_gen_id }} * {
    font-weight: {{ block.settings.button_title_font_weight }} !important;
    margin: 0;
  }

  .ai-text-block__title-{{ ai_gen_id }} {
    color: {{ block.settings.title_text_color }};
    font-size: {{ block.settings.title_font_size }}px;
    margin: 0 0 {{ block.settings.spacing_title }}px 0;
    line-height: {{ block.settings.title_line_height }};
  }

  .ai-text-block__title-{{ ai_gen_id }} * {
    line-height: {{ block.settings.title_line_height }};
  }

  .ai-text-block__body-{{ ai_gen_id }} {
    color: {{ block.settings.body_text_color }};
    font-size: {{ block.settings.body_font_size }}px;
    margin: 0;
  }

  .ai-text-block__body-{{ ai_gen_id }} p {
    margin: 0 0 1em 0;
  }

  .ai-text-block__body-{{ ai_gen_id }} p:last-child {
    margin-bottom: 0;
  }

  @media screen and (max-width: 749px) {
    .ai-text-block__container-{{ ai_gen_id }} {
      padding-left: {{ block.settings.mobile_padding_horizontal }}px;
      padding-right: {{ block.settings.mobile_padding_horizontal }}px;
    }
  }
{% endstyle %}

<div class="ai-text-block-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-text-block__container-{{ ai_gen_id }}">
    {% if block.settings.button_title != blank %}
      <div class="ai-text-block__button-title-{{ ai_gen_id }}">
        {{ block.settings.button_title }}
      </div>
    {% endif %}

    {% if block.settings.title != blank %}
      <div class="ai-text-block__title-{{ ai_gen_id }}">
        {{ block.settings.title }}
      </div>
    {% endif %}

    {% if block.settings.body_text != blank %}
      <div class="ai-text-block__body-{{ ai_gen_id }}">
        {{ block.settings.body_text }}
      </div>
    {% endif %}
  </div>
</div>

{% schema %}
{
  "name": "Text with button label",
  "tag": null,
  "settings": [
    {
      "type": "header",
      "content": "Button-style title"
    },
    {
      "type": "richtext",
      "id": "button_title",
      "label": "Button title",
      "default": "<p>New arrival</p>"
    },
    {
      "type": "color",
      "id": "button_title_bg_color",
      "label": "Background color",
      "default": "#405de6"
    },
    {
      "type": "color",
      "id": "button_title_text_color",
      "label": "Text color",
      "default": "#ffffff"
    },
    {
      "type": "select",
      "id": "button_title_font_weight",
      "label": "Text thickness",
      "options": [
        {
          "value": "400",
          "label": "Normal"
        },
        {
          "value": "500",
          "label": "Medium"
        },
        {
          "value": "600",
          "label": "Semi-bold"
        },
        {
          "value": "700",
          "label": "Bold"
        },
        {
          "value": "800",
          "label": "Extra bold"
        }
      ],
      "default": "700"
    },
    {
      "type": "range",
      "id": "button_title_font_size",
      "label": "Text size",
      "min": 10,
      "max": 32,
      "step": 1,
      "unit": "px",
      "default": 14
    },
    {
      "type": "range",
      "id": "button_title_width",
      "label": "Button width",
      "min": 100,
      "max": 500,
      "step": 10,
      "unit": "px",
      "default": 200
    },
    {
      "type": "range",
      "id": "button_title_padding_vertical",
      "label": "Vertical padding",
      "min": 4,
      "max": 24,
      "step": 2,
      "unit": "px",
      "default": 8
    },
    {
      "type": "range",
      "id": "button_title_border_radius",
      "label": "Border radius",
      "min": 0,
      "max": 30,
      "step": 2,
      "unit": "px",
      "default": 4
    },
    {
      "type": "range",
      "id": "spacing_button_title",
      "label": "Spacing below",
      "min": 0,
      "max": 60,
      "step": 4,
      "unit": "px",
      "default": 16
    },
    {
      "type": "header",
      "content": "Title"
    },
    {
      "type": "richtext",
      "id": "title",
      "label": "Title",
      "default": "<p>Discover our latest collection</p>"
    },
    {
      "type": "color",
      "id": "title_text_color",
      "label": "Text color",
      "default": "#56473a"
    },
    {
      "type": "range",
      "id": "title_font_size",
      "label": "Text size",
      "min": 14,
      "max": 60,
      "step": 2,
      "unit": "px",
      "default": 32
    },
    {
      "type": "range",
      "id": "title_line_height",
      "label": "Line height",
      "min": 1,
      "max": 2,
      "step": 0.1,
      "default": 1.2
    },
    {
      "type": "range",
      "id": "spacing_title",
      "label": "Spacing below",
      "min": 0,
      "max": 60,
      "step": 4,
      "unit": "px",
      "default": 16
    },
    {
      "type": "header",
      "content": "Body text"
    },
    {
      "type": "richtext",
      "id": "body_text",
      "label": "Body text",
      "default": "<p>Explore our carefully curated selection of premium products designed to enhance your lifestyle.</p>"
    },
    {
      "type": "color",
      "id": "body_text_color",
      "label": "Text color",
      "default": "#56473A"
    },
    {
      "type": "range",
      "id": "body_font_size",
      "label": "Text size",
      "min": 12,
      "max": 32,
      "step": 1,
      "unit": "px",
      "default": 16
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "desktop_width_percent",
      "label": "Desktop width",
      "min": 50,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 100
    },
    {
      "type": "range",
      "id": "section_padding_top",
      "label": "Top padding",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "section_padding_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "mobile_padding_horizontal",
      "label": "Mobile horizontal padding",
      "min": 0,
      "max": 60,
      "step": 4,
      "unit": "px",
      "default": 20
    }
  ],
  "presets": [
    {
      "name": "Text with button label"
    }
  ]
}
{% endschema %}
