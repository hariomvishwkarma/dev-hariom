{% doc %}
  @prompt
    Title with customizable size and colour. Below that, 4 logos that can be added as trust elements, On mobile, they should all be next to eachother, just smaller in sizw
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-trust-badges-{{ ai_gen_id }} {
    padding: 40px 20px;
    text-align: center;
  }

  .ai-trust-badges__title-{{ ai_gen_id }} {
    margin: 0 0 30px;
    font-size: {{ block.settings.title_size }}px;
    color: {{ block.settings.title_color }};
    font-weight: 500;
  }

  .ai-trust-badges__logos-{{ ai_gen_id }} {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 40px;
    flex-wrap: nowrap;
    max-width: 1200px;
    margin: 0 auto;
  }

  .ai-trust-badges__logo-item-{{ ai_gen_id }} {
    flex: 0 1 auto;
    max-width: 200px;
  }

  .ai-trust-badges__logo-item-{{ ai_gen_id }} img {
    width: 100%;
    height: auto;
    max-height: {{ block.settings.logo_height }}px;
    object-fit: contain;
    opacity: {{ block.settings.logo_opacity }};
    transition: opacity 0.3s ease;
  }

  .ai-trust-badges__logo-item-{{ ai_gen_id }} img:hover {
    opacity: 1;
  }

  .ai-trust-badges__logo-placeholder-{{ ai_gen_id }} {
    width: 150px;
    height: {{ block.settings.logo_height }}px;
    background-color: #f4f4f4;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 4px;
  }

  .ai-trust-badges__logo-placeholder-{{ ai_gen_id }} svg {
    width: 60px;
    height: 60px;
    opacity: 0.3;
  }

  @media screen and (max-width: 749px) {
    .ai-trust-badges__title-{{ ai_gen_id }} {
      font-size: {{ block.settings.title_size | times: 0.8 }}px;
      margin-bottom: 20px;
    }

    .ai-trust-badges__logos-{{ ai_gen_id }} {
      gap: 15px;
      flex-wrap: nowrap;
    }

    .ai-trust-badges__logo-item-{{ ai_gen_id }} {
      flex: 1 1 0;
      min-width: 0;
      max-width: none;
    }

    .ai-trust-badges__logo-item-{{ ai_gen_id }} img {
      max-height: {{ block.settings.logo_height | times: 0.6 }}px;
    }

    .ai-trust-badges__logo-placeholder-{{ ai_gen_id }} {
      width: 100%;
      height: {{ block.settings.logo_height | times: 0.6 }}px;
    }

    .ai-trust-badges__logo-placeholder-{{ ai_gen_id }} svg {
      width: 40px;
      height: 40px;
    }
  }
{% endstyle %}

<div class="ai-trust-badges-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  {% if block.settings.title != blank %}
    <h2 class="ai-trust-badges__title-{{ ai_gen_id }}">{{ block.settings.title }}</h2>
  {% endif %}

  <div class="ai-trust-badges__logos-{{ ai_gen_id }}">
    {% for i in (1..4) %}
      {% liquid
        assign logo_key = 'logo_' | append: i
        assign logo = block.settings[logo_key]
      %}

      <div class="ai-trust-badges__logo-item-{{ ai_gen_id }}">
        {% if logo != blank %}
          <img
            src="{{ logo | image_url: width: 400 }}"
            alt="{{ logo.alt | escape }}"
            loading="lazy"
            width="{{ logo.width }}"
            height="{{ logo.height }}"
          >
        {% else %}
          <div class="ai-trust-badges__logo-placeholder-{{ ai_gen_id }}">
            {{ 'image' | placeholder_svg_tag }}
          </div>
        {% endif %}
      </div>
    {% endfor %}
  </div>
</div>

{% schema %}
{
  "name": "Trust badges",
  "settings": [
    {
      "type": "header",
      "content": "Title"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Title",
      "default": "Trusted by leading brands"
    },
    {
      "type": "range",
      "id": "title_size",
      "min": 16,
      "max": 48,
      "step": 2,
      "unit": "px",
      "label": "Title size",
      "default": 28
    },
    {
      "type": "color",
      "id": "title_color",
      "label": "Title color",
      "default": "#56473a"
    },
    {
      "type": "header",
      "content": "Logos"
    },
    {
      "type": "image_picker",
      "id": "logo_1",
      "label": "Logo 1"
    },
    {
      "type": "image_picker",
      "id": "logo_2",
      "label": "Logo 2"
    },
    {
      "type": "image_picker",
      "id": "logo_3",
      "label": "Logo 3"
    },
    {
      "type": "image_picker",
      "id": "logo_4",
      "label": "Logo 4"
    },
    {
      "type": "range",
      "id": "logo_height",
      "min": 30,
      "max": 120,
      "step": 10,
      "unit": "px",
      "label": "Logo height",
      "default": 60
    },
    {
      "type": "range",
      "id": "logo_opacity",
      "min": 0.3,
      "max": 1,
      "step": 0.1,
      "label": "Logo opacity",
      "default": 0.7
    }
  ],
  "presets": [
    {
      "name": "Trust badges"
    }
  ]
}
{% endschema %}
