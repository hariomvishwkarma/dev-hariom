{% doc %}
  @prompt
    A call-to-action-button which scrolls down to a specific section or anchor point. I should be able to change the button text, colour, and corner roundings. I also want to manage the vertical padding. , I want to change the sections background colour, the scroll offset function doesn't seem to work. Can you fix it?
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-scroll-button-wrapper-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    padding: {{ block.settings.vertical_padding }}px 0;
    background-color: {{ block.settings.section_background_color }};
  }

  .ai-scroll-button-{{ ai_gen_id }} {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 16px 32px;
    background-color: {{ block.settings.button_background_color }};
    color: {{ block.settings.button_text_color }};
    border: none;
    border-radius: {{ block.settings.border_radius }}px;
    font-size: 16px;
    font-weight: 500;
    text-decoration: none;
    cursor: pointer;
    transition: all 0.3s ease;
    text-align: center;
  }

  .ai-scroll-button-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.button_hover_color }};
    color: {{ block.settings.button_hover_text_color }};
  }

  .ai-scroll-button-container-{{ ai_gen_id }} {
    text-align: {{ block.settings.button_alignment }};
  }
{% endstyle %}

<scroll-button-{{ ai_gen_id }}
  class="ai-scroll-button-wrapper-{{ ai_gen_id }}"
  {{ block.shopify_attributes }}
>
  <div class="ai-scroll-button-container-{{ ai_gen_id }}">
    <button
      class="ai-scroll-button-{{ ai_gen_id }}"
      data-target="{{ block.settings.scroll_target }}"
      data-offset="{{ block.settings.scroll_offset }}"
      aria-label="{{ block.settings.button_text }}"
    >
      {{ block.settings.button_text }}
    </button>
  </div>
</scroll-button-{{ ai_gen_id }}>

<script>
  (function() {
    class ScrollButton{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
        this.button = this.querySelector('.ai-scroll-button-{{ ai_gen_id }}');
        this.setupEventListeners();
      }

      setupEventListeners() {
        this.button.addEventListener('click', () => {
          const targetId = this.button.getAttribute('data-target');
          const offset = parseInt(this.button.getAttribute('data-offset')) || 0;
          
          if (!targetId) {
            return;
          }

          const targetElement = document.querySelector(targetId);
          
          if (targetElement) {
            const elementPosition = targetElement.getBoundingClientRect().top;
            const offsetPosition = elementPosition + window.pageYOffset - offset;
            
            window.scrollTo({
              top: offsetPosition,
              behavior: 'smooth'
            });
          }
        });
      }
    }

    customElements.define('scroll-button-{{ ai_gen_id }}', ScrollButton{{ ai_gen_id }});
  })();
</script>

