        "ai_gen_block_62f6e18_dyADBA": {
          "type": "ai_gen_block_62f6e18",
          "settings": {
            "title": "<h1>7 Gründe, warum Abnehmen mit Precon so einfach ist</h1>",
            "body": "<p>Endlich erfolgreich abnehmen, ohne zu hungern oder auf Genuss zu verzichten? Mit dem Precon 4-Wochen-Paket gelingt der Einstieg in ein leichteres Leben. <br/><br/>Hier erklären wir warum:</p>",
            "content_width": 800,
            "text_alignment": "center",
            "background_color": "#efece4",
            "title_color": "#3dadbb",
            "body_color": "#56473a",
            "title_size": 24,
            "title_line_height": 1.2,
            "body_size": 18
          },
          "blocks": {}
        }
      },
      "block_order": [
        "ai_gen_block_62f6e18_dyADBA"
      ],
      "name": "Title and body",
      "settings": {}
