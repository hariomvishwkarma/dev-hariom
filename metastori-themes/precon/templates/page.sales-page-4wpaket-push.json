    "replo_precon_vs_rest_TMeEy6": {
      "type": "replo-precon-vs-rest",
      "name": "Precon vs Rest",
      "settings": {
        "replo_text_7e72aa87-891c-4eef-87c6-e93a7cf46dfc": "<p>NUR EIN SHAKE</p>",
        "replo_text_4540c7fc-ece3-4ef6-82dc-4a6771899511": "<p>Keine Anleitung – du bist auf Dich allein gestellt</p>",
        "replo_text_e2c83717-2ad4-46b6-a487-94c75935582c": "<p>Ein Geschmack – nach wenigen Tagen langweilig</p>",
        "replo_text_670fb36d-7bc7-4c2d-9c3d-fadb3f689ab5": "<p>Keine Phasen – kein strukturierter Ablauf</p>",
        "replo_text_63391858-fdc7-4038-8f08-698d05789cfe": "<p>Kein Übergang – was kommt danach?</p>",
        "replo_text_7614a154-8988-404a-adda-8239eda66704": "<p>Einzelprodukt – teurer als im Paket</p>",
        "replo_text_519a26a8-3231-499a-a5af-b32061bde975": "<p>VS.</p>",
        "replo_text_908a2348-a186-4f70-8538-f37c2a85a622": "<p>PRECON KONZEPT</p>",
        "replo_text_921b811f-f225-4d7d-98c2-ef32fcbd6272": "<p>Handbuch mit klarem 3-Phasen-Plan</p>",
        "replo_text_fc7df20a-daed-43f3-bcdf-12114e76d95a": "<p>8+ Geschmäcker – Shakes UND Riegel</p>",
        "replo_text_84f866dd-9949-47b2-89a9-820af21e2496": "<p>Strukturierte Phasen: Start → Hauptphase → Übergang</p>",
        "replo_text_0fe0f367-8ae7-416d-adf6-2d8a26da60d6": "<p>Haltephase für den sanften Übergang danach</p>",
        "replo_text_51c6c3b8-3ee5-455b-8655-a3e0c0eb3641": "<p>Über 40% günstiger als Einzelkauf</p>"
      }
    },
    "blocks_zzrMRJ": {
      "type": "_blocks",
      "blocks": {
        "ai_gen_block_4b142e7_AxxeTb": {
          "type": "ai_gen_block_4b142e7",
          "settings": {
            "button_title": "<h3>DAS SYSTEM</h3>",
            "button_title_bg_color": "#e1f3f4",
            "button_title_text_color": "#3dadbb",
            "button_title_font_weight": "700",
            "button_title_font_size": 20,
            "button_title_width": 500,
            "button_title_padding_vertical": 8,
            "button_title_border_radius": 30,
            "spacing_button_title": 32,
            "title": "<h3>3 Phasen - ein klarer Plan</h3>",
            "title_text_color": "#56473a",
            "title_font_size": 36,
            "title_line_height": 1.2,
            "spacing_title": 32,
            "body_text": "<p>Das Precon Konzept gibt Dir nicht nur Produkte, sondern einen klaren Fahrplan.<br/>Du weißt jeden Tag genau, was zu tun ist – ohne Rätselraten, ohne Überforderung.</p>",
            "body_text_color": "#56473a",
            "body_font_size": 18,
            "desktop_width_percent": 100,
            "section_padding_top": 40,
            "section_padding_bottom": 40,
            "mobile_padding_horizontal": 20
          },
          "blocks": {}
        }
      },
      "block_order": [
        "ai_gen_block_4b142e7_AxxeTb"
      ],
      "name": "Button with title",
      "settings": {}
    },
    "replo_precon_konzept_how_to_LqrFcj": {
      "type": "replo-precon-konzept-how-to",
      "name": "Precon Konzept How-To",
      "settings": {
        "replo_text_ffe5b169-f012-49d8-8e9c-0f6503f5790f": "<p>1</p>",
        "replo_text_95a21393-44d7-47a4-a635-6e9304d891ab": "<p>Starten – 2 Tage</p>",
        "replo_text_e761e536-926d-4ecd-8e3e-40e6b4314b46": "<p>Mit diesen speziell für den Abnehmstart konzipierten Shakes findest du nicht nur einfach in das Programm, er sorgt auch für einen effektiven Kickstart und kurbelt die Fettverbrennung an. Alle Mahlzeiten werden ersetzt, Du bist rundum versorgt und kannst Dich voll auf den Einstieg konzentrieren.</p>",
        "replo_text_11ebc07f-2f76-46fc-bdac-33746a96ea7b": "<p><strong>5x Start Shake pro Tag</strong></p>",
        "replo_text_c4c6df97-2434-46a9-818c-aabff540a5fc": "<p>2</p>",
        "replo_text_c99f53d1-2664-4aec-a072-e3bc3809966e": "<p>Hauptphase – Bis Zielgewicht</p>",
        "replo_text_4704697e-a583-4600-ae0e-2614f6cea6d3": "<p>Der Kern des Konzepts. Du ersetzt zwei Mahlzeiten durch Precon Shakes oder Riegel und geniesst eine selbst gekochte Mahlzeit. Alltagstauglich, abwechslungsreich und machbar. Wähle zwischen einer Vielzahl an Geschmacksrichtungen und mache das Konzept zu Deinem Konzept.</p>",
        "replo_text_d0bd73ae-ac3e-46c8-a551-b030317d3214": "<p><strong>2x Precon + 1x normal</strong></p>",
        "replo_text_ab10a69a-5daf-4bd4-888f-f83c5a627ffb": "<p>3</p>",
        "replo_text_c4a70e0a-17c3-4fa8-af8f-2267dd1523e5": "<p>Halten – 4-6 Wochen</p>",
        "replo_text_e1f2bae2-35bf-4b07-9d38-253c0183443b": "<p>Der sanfte Übergang zurück: Nur noch eine Precon Mahlzeit pro Tag, zwei normale Mahlzeiten. So gewöhnst Du Dich schrittweise an Deinen neuen Alltag, ohne harten Bruch.</p>",
        "replo_text_7abf97a0-0c8a-48d7-933f-131e3b7c6152": "<p><strong>1x Precon + 2x normal</strong></p>"
      }
    },
