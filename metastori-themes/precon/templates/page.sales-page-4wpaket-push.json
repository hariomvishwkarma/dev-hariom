      "settings": {}
    },
    "replo_drei_checks_rQkWDF": {
      "type": "replo-drei-checks",
      "name": "Drei Checks",
      "settings": {
        "replo_text_f70883a2-8944-400b-b3bf-3a58e50f84bc": "<p>Kennst Du das?</p>",
        "replo_text_c4e78089-85ad-47dc-8eb3-d6ef07fa972d": "<p>Du kaufst einen Shake, trinkst ihn ein paar Tage und dann?</p><p>Keine Struktur, keine Abwechslung, keine Ahnung wie es weitergehen soll. Der Shake landet im Schrank.</p>",
        "replo_text_3a289161-ba4a-4ec4-ba9b-a9664b15a5c7": "<p><strong>Kein klarer Plan</strong></p>",
        "replo_text_cc9d5d79-39fd-48e1-9134-1cedfa094c48": "<p><strong>Schnell langweilig</strong></p>",
        "replo_text_a866928e-c8e6-47c0-940c-0c7f32c17b8f": "<p><strong>Kein Danach</strong></p>"
      }
    },
    "177020005979b14024": {
      "type": "_blocks",
      "blocks": {
        "ai_gen_block_347f907_Ng3tdp": {
          "type": "ai_gen_block_347f907",
          "settings": {
            "button_title": "<h3>DER UNTERSCHIED</h3>",
            "button_title_bg_color": "#e1f3f4",
