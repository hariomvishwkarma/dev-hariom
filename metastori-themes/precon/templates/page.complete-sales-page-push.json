      "blocks": {
        "ai_gen_block_4b142e7_AxxeTb": {
          "type": "ai_gen_block_4b142e7",
          "settings": {
            "button_title": "<h3>DAS SYSTEM</h3>",
            "button_title_bg_color": "#e1f3f4",
            "button_title_text_color": "#3dadbb",
