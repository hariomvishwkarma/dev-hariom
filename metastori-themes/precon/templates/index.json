        "button2_link": "shopify://blogs/so-geht-abnehmen",
        "background_color_sec": "#ffffff",
        "text_color_sec": "#3dadbb"
      }
    },
    "tabs_slider_card_XPRN6N": {
      "type": "tabs-slider-card",
      "blocks": {
        "tab_7zReXK": {
          "type": "tab",
          "settings": {
            "tab": "Berufstätig"
          }
        },
        "card_AhkQEN": {
          "type": "card",
          "settings": {
            "tab": "Berufstätig",
            "image": "shopify://shop_images/Claudia.png",
            "heading": "Claudia, 56 Jahre",
            "tags": "Schichtarbeit,Heißhunger",
            "content": "<p>117 Kilo – das war Claudias Startgewicht. Mit Precon erreichte sie ihr Wunschgewicht und hält es seit Jahren – trotz stressigem Berufsalltag und Schichtarbeit. Sie änderte Ihre Ernährung dauerhaft und fühlt sich heute in Balance. </p>"
          }
        },
        "card_cL8Mkb": {
          "type": "card",
          "settings": {
            "tab": "Berufstätig",
            "image": "shopify://shop_images/Maik_6d25c6ac-5be6-483b-af71-66b576caadb6.png",
            "heading": "Maik, 37 Jahre",
            "tags": "Stressiger Berufsalltag, Sport & Bewegung",
            "content": "<p>Stressige Arbeitstage, Fast Food und wenig Bewegung bestimmten Maiks Alltag. Mit Precon änderte er seinen Lebensstil grundlegend – heute hält er sein Gewicht, treibt regelmäßig Sport und läuft sogar Halbmarathons.</p>"
          }
        },
        "card_DT3Ek6": {
          "type": "card",
          "settings": {
            "tab": "Berufstätig",
            "image": "shopify://shop_images/Sigrid_7cdcd85f-2ead-4239-aa6e-96b3b614df69.png",
            "heading": "Sigrid, 64 Jahre",
            "tags": "Wieder abnehmen,  Bewegung im Alltag",
            "content": "<p>80 Kilo – da wusste Sigrid: Jetzt muss sich wieder etwas ändern. Mit Precon schaffte sie es zum zweiten Mal, ihr Wunschgewicht zu erreichen. Heute ernährt sie sich bewusster, bleibt beim Golfen aktiv und weiss, wie sie kleine Gewichtsschwankungen rechtzeitig ausgleicht.</p>"
          }
        },
        "card_D6tADT": {
          "type": "card",
          "settings": {
            "tab": "Berufstätig",
            "image": "shopify://shop_images/Christiane.png",
            "heading": "Schichtarbeit, Heißhunger & Süßes",
            "tags": "Christiane, 47 Jahre",
            "content": "<p>143 Kilo – da zog Christiane die Reissleine. Nach vielen gescheiterten Abnehmversuchen startete sie mit Precon neu durch. Heute ist sie deutlich leichter, bewegt sich viel und hat gelernt, Versuchungen zu widerstehen – mit einem klaren Ziel vor Augen: mehr Gesundheit und Lebensqualität.</p>"
          }
        },
        "tab_nEp7pz": {
          "type": "tab",
          "settings": {
            "tab": "Lebensumstände"
          }
        },
        "card_nhxGUU": {
          "type": "card",
          "settings": {
            "tab": "Lebensumstände",
            "image": "shopify://shop_images/Angelika.png",
            "heading": "Angelika, 64 Jahre",
            "tags": "Ruhestand, Gewicht halten",
            "content": "<p>Mit über 60 und frisch im Ruhestand wollte Angelika noch einmal etwas verändern. Mit Precon fiel ihr das Abnehmen leichter als bei früheren Versuchen – sogar ohne die schlechte Laune, die sie von anderen Diäten kannte. Auch einen langen Urlaub meisterte sie problemlos und hält ihr Gewicht seitdem erfolgreich.</p>"
          }
        },
        "card_bQezaF": {
          "type": "card",
          "settings": {
            "tab": "Lebensumstände",
            "image": "shopify://shop_images/ut.png",
            "heading": "Ute, 50 Jahre",
            "tags": "Frustessen, Sport & Bewegung",
            "content": "<p>25 Kilo nahm Ute innerhalb von zwei Jahren zu – ausgelöst durch eine schwierige Lebensphase und Frustessen. Mit Precon fand sie zurück zu bewusster Ernährung und mehr Bewegung. Heute wiegt sie 69 Kilo, trägt wieder Grösse 38/40 und fühlt sich endlich wieder wohl in ihrem Körper.</p>"
          }
        },
        "card_dGfAQW": {
          "type": "card",
          "settings": {
            "tab": "Lebensumstände",
            "image": "shopify://shop_images/Tim.png",
            "heading": "Tim, 32 Jahre",
            "tags": "Heißhunger, Essen als Belohnung",
            "content": "<p>Jedes Jahr kamen bei Tim ein paar Kilo dazu – wenig Bewegung, viele Süssigkeiten und Essen als Belohnung wurden zum Teufelskreis. Mit einem klaren Ziel vor Augen startete er mit Precon und veränderte Schritt für Schritt seine Gewohnheiten. Heute fühlt er sich deutlich wohler, treibt wieder regelmässig Sport und weiss besser, wann er wirklich Hunger hat.</p>"
          }
        },
        "card_dfUfqE": {
          "type": "card",
          "settings": {
            "tab": "Lebensumstände",
            "image": "shopify://shop_images/Susan.png",
            "heading": "Susan, 30 Jahre",
            "tags": "Emotionales Essen, Trennung & Neuanfang",
