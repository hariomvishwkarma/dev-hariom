    "precon_steps_h6DhcW": {
      "type": "precon-steps",
      "blocks": {
        "step_X3Dxed": {
          "type": "step",
          "settings": {
            "title": "Starten",
            "text": "Dein Turbo-Start: 2 Tage nur mit dem Start Shake. Du bist rundum versorgt und bringst die Fettverbrennung in Schwung."
          }
        },
        "step_zC6cMQ": {
          "type": "step",
          "settings": {
            "title": "Abnehmen",
            "text": "Schritt für Schritt zum Wunschgewicht: 2x Precon Mahlzeit (Shake, Suppe, Riegel oder Müsli) + 1 selbst gekochte Mahlzeit. Einfach, lecker, wirksam."
          }
        },
        "step_ibYFMx": {
          "type": "step",
          "settings": {
            "title": "Halten",
            "text": "Sicher ans Ziel: 1x Precon + 2 Mahlzeiten nach Deinem Geschmack. Nach 4–6 Wochen genießt Du komplett normale Mahlzeiten – und bleibst in Balance."
          }
        }
      },
      "block_order": [
        "step_X3Dxed",
        "step_zC6cMQ",
        "step_ibYFMx"
      ],
      "name": "Precon Steps Section",
      "settings": {
        "heading": "So funktioniert abnehmen mit Precon",
        "subheading": "In 3 einfachen Schritten zum Wohlfühlgewicht",
        "image": "shopify://shop_images/HP_souop_v2.png",
        "button1_text": "Jetzt Produkte entdecken",
        "button1_link": "shopify://collections/all",
