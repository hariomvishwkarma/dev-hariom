<style>

/* ============================================================
   OVERRIDE BLOCK — Single H1 Restructure (SEO Fix)
   ============================================================ */

/* ---------- Kill old duplicate-block styles ---------- */
.product-top-content,
.product-teaser-desktop {
  display: none !important;
}

.product-meta .product-meta__title {
  display: block !important;
}

/* ---------- New header base ---------- */
.product__header-title {
  color: #56473a;
  margin-block: 0 8px;
}

.product__header .rating-title,
.product__header .jdgm-widget {
  margin-bottom: 8px;
}

.product__header-teaser {
  color: rgba(41, 9, 7, 0.8);
  font-size: 16px;
  line-height: 1.5;
  margin-bottom: 2px;   /* teaser → checklist gap, matches old */
}

/* ---------- Mobile: header above media (normal flow) ---------- */
@media screen and (max-width: 767px) {
  .product__header {
    margin-bottom: 32px;
  }
  .product__header-title {
    font-size: 29px;
    font-weight: 800;
    line-height: 1;
    letter-spacing: -0.87px;
    font-family: "Figtree-800";
    margin-bottom: 16px;
  }
  .product__header-teaser {
    color: rgba(41, 9, 7, 0.8);
    font-size: 14px;
    font-weight: 400;
    line-height: 150%;
    margin-bottom: 0;
  }
}

/* ---------- Desktop: grid matched to old 49% / 48% layout ---------- */
@media screen and (min-width: 1000px) {
  .product_main .product {
    display: grid !important;              /* overrides old display:flex */
    grid-template-columns: 49% 48%;        /* same as old media/info widths */
    grid-template-rows: auto 1fr;
    justify-content: space-between;
    align-items: start;
  }

  /* Header aligned with info card inner text edge */
  .product_main .product__header {
    grid-column: 2;
    grid-row: 1;
    margin-left: 0;
    padding: 0 20px;                       /* matches .product__info padding */
    margin-bottom: 0;                      /* no stacked gap with info below */
    padding-top:20px;
    margin-left:10px;
  }

  .product_sec .product__media {
    grid-column: 1;
    grid-row: 1 / span 2;
    width: 100% !important;                /* grid track controls width now */
    margin-right: 0;
    padding-inline-start: 0;
  }

  .product_main .product__info {
    grid-column: 2;
    grid-row: 2;
    width: auto !important;                /* overrides old width: 48% */
    margin-left: 10px;                        /* track handles position */
    padding-top: 0 !important;             /* continuous flow after header */
  }
}

/* ============================================================
   END OVERRIDE BLOCK
   ============================================================ */
</style>





