{%- comment -%}
  sections/precon-cta-banner.liquid
  Fonts : Figtree 300/400/600 + Playfair Display 500 italic
  Colors: fully customisable via schema settings
{%- endcomment -%}

{%- liquid
  assign c_bg      = section.settings.color_bg
  assign c_eyebrow = section.settings.color_eyebrow
  assign c_title   = section.settings.color_title
  assign c_sub     = section.settings.color_sub
  assign c_btn_bg  = section.settings.color_btn_bg
  assign c_btn_txt = section.settings.color_btn_text
-%}

<div id="ctab-{{ section.id }}" class="ctab">
  <div class="ctab__inner">

    {%- if section.settings.eyebrow != blank -%}
      <p class="ctab__eyebrow">{{ section.settings.eyebrow }}</p>
    {%- endif -%}

    {%- if section.settings.title != blank -%}
      <h2 class="ctab__title">{{ section.settings.title }}</h2>
    {%- endif -%}

    {%- if section.settings.subtitle != blank -%}
      <p class="ctab__sub">{{ section.settings.subtitle }}</p>
    {%- endif -%}

    {%- if section.settings.btn_text != blank -%}
      <a class="ctab__btn" href="{{ section.settings.btn_url | default: '#' }}">
        {{ section.settings.btn_text }}
      </a>
    {%- endif -%}

  </div>
</div>


<style>
  @import url('https://fonts.googleapis.com/css2?family=Figtree:wght@300;400;600&family=Playfair+Display:ital,wght@1,500&display=swap');

  #ctab-{{ section.id }} {
    --bg:       {{ c_bg }};
    --eyebrow:  {{ c_eyebrow }};
    --title:    {{ c_title }};
    --sub:      {{ c_sub }};
    --btn-bg:   {{ c_btn_bg }};
    --btn-txt:  {{ c_btn_txt }};
  }

  #ctab-{{ section.id }},
  #ctab-{{ section.id }} * { box-sizing: border-box; }

  #ctab-{{ section.id }} {
    position: relative;
    background-color: var(--bg);
    overflow: hidden;
    font-family: 'Figtree', sans-serif;
    -webkit-font-smoothing: antialiased;
  }

  #ctab-{{ section.id }} .ctab__inner {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    padding: 5rem 1.5rem;
    max-width: 760px;
    margin: 0 auto;
    gap: 0;
  }

  /* Eyebrow */
  #ctab-{{ section.id }} .ctab__eyebrow {
    font-weight: 600;
    font-size: .68rem;
    letter-spacing: .26em;
    text-transform: uppercase;
    color: var(--eyebrow);
    margin: 0 0 1.5rem;
  }

  /* Title */
  #ctab-{{ section.id }} .ctab__title {
    font-family: 'Playfair Display', serif;
    font-style: italic;
    font-weight: 500;
    font-size: clamp(2rem, 4.8vw, 3.75rem);
    line-height: 1.1;
    color: var(--title);
    margin: 0 0 1.4rem;
  }

  /* Subtitle */
  #ctab-{{ section.id }} .ctab__sub {
    font-weight: 300;
    font-size: clamp(.9rem, 2vw, 1.05rem);
    line-height: 1.75;
    color: var(--sub);
    max-width: 580px;
    margin: 0 0 2.5rem;
  }

  /* Button */
  #ctab-{{ section.id }} .ctab__btn {
    display: inline-block;
    background: var(--btn-bg);
    color: var(--btn-txt);
    font-family: 'Figtree', sans-serif;
    font-weight: 600;
    font-size: 1rem;
    text-decoration: none;
    padding: 1rem 3rem;
    border-radius: 999px;
    letter-spacing: .02em;
    transition: opacity .2s ease, transform .2s ease;
  }
  #ctab-{{ section.id }} .ctab__btn:hover {
    opacity: .88;
    transform: translateY(-1px);
  }
</style>


{% schema %}
{
  "name": "CTA Banner",
  "tag": "section",
  "class": "precon-cta-banner-section",
  "settings": [
    {
      "type": "header",
      "content": "Inhalt"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "WIEDER DU · JETZT STARTEN"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Headline (Playfair Italic)",
      "default": "Ich bin wieder ich."
    },
    {
      "type": "textarea",
      "id": "subtitle",
      "label": "Untertitel",
      "default": "Starte jetzt Deine Precon-Reise - begleitet, alltagstauglich und Schritt fuer Schritt."
    },
    {
      "type": "text",
      "id": "btn_text",
      "label": "Button Text",
      "default": "Jetzt starten"
    },
    {
      "type": "url",
      "id": "btn_url",
      "label": "Button Link"
    },
    {
      "type": "header",
      "content": "Farben"
    },
    {
      "type": "color",
      "id": "color_bg",
      "label": "Hintergrund",
      "default": "#56473A"
    },
    {
      "type": "color",
      "id": "color_eyebrow",
      "label": "Eyebrow",
      "default": "#3DADBB"
    },
    {
      "type": "color",
      "id": "color_title",
      "label": "Headline",
      "default": "#FAF9F5"
    },
    {
      "type": "color",
      "id": "color_sub",
      "label": "Untertitel",
      "default": "#D4C9C0"
    },
    {
      "type": "color",
      "id": "color_btn_bg",
      "label": "Button Hintergrund",
      "default": "#3DADBB"
    },
    {
      "type": "color",
      "id": "color_btn_text",
      "label": "Button Text",
      "default": "#FAF9F5"
    }
  ],
  "presets": [
    {
      "name": "CTA Banner"
    }
  ]
}
{% endschema %}