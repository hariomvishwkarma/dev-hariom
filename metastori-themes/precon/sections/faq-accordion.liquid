    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Subtext color",
      "default": "#7a7470"
    },
    {
      "type": "header",
      "content": "Card style"
    },
    {
      "type": "color",
      "id": "card_bg",
      "label": "Card background",
      "default": "#ffffff"
    },
    {
      "type": "range",
      "id": "card_radius",
      "min": 0,
      "max": 32,
      "step": 2,
      "default": 16,
      "unit": "px",
      "label": "Card corner radius"
    },
    {
      "type": "range",
      "id": "card_border_thickness",
      "min": 0,
      "max": 5,
      "step": 1,
      "default": 0,
      "unit": "px",
      "label": "Card border thickness"
    },
    {
      "type": "color",
      "id": "card_border_color",
      "label": "Card border color",
      "default": "#d5d0c8"
    },
    {
      "type": "color",
      "id": "divider_color",
      "label": "Row divider color",
      "default": "#ece8e2"
    },
    {
      "type": "header",
      "content": "Question style"
    },
    {
      "type": "range",
      "id": "question_size",
      "min": 14,
      "max": 22,
      "step": 1,
      "default": 16,
      "unit": "px",
      "label": "Question font size"
    },
    {
      "type": "range",
      "id": "question_weight",
      "min": 300,
      "max": 700,
      "step": 100,
      "default": 400,
      "label": "Question font weight"
    },
    {
      "type": "color",
      "id": "question_color",
      "label": "Question text color",
      "default": "#2c2c2c"
    },
    {
      "type": "color",
      "id": "icon_color",
      "label": "Plus icon color",
      "default": "#a09a92"
    },
    {
      "type": "header",
      "content": "Answer style"
    },
    {
      "type": "range",
      "id": "answer_size",
      "min": 13,
      "max": 18,
      "step": 1,
      "default": 15,
      "unit": "px",
      "label": "Answer font size"
    },
    {
      "type": "color",
      "id": "answer_color",
      "label": "Answer text color",
      "default": "#5a554e"
    }
  ],
  "blocks": [
    {
      "type": "faq_item",
      "name": "FAQ item",
      "settings": [
        {
          "type": "text",
          "id": "question",
          "label": "Question",
          "default": "Kann ich in Phase 2 auch Obst als Snack essen?"
        },
        {
          "type": "richtext",
          "id": "answer",
          "label": "Answer",
          "default": "<p>Nein, zwischen den Mahlzeiten solltest Du keine Snacks essen — auch kein Obst. Snacks halten den Insulinspiegel hoch und verhindern die Fettverbrennung.</p>"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "FAQ Accordion",
      "blocks": [
        {
          "type": "faq_item",
          "settings": {
            "question": "Kann ich in Phase 2 auch Obst als Snack essen?",
            "answer": "<p>Nein, zwischen den Mahlzeiten solltest Du keine Snacks essen — auch kein Obst. Snacks halten den Insulinspiegel hoch und verhindern die Fettverbrennung.</p>"
          }
        },
        {
          "type": "faq_item",
          "settings": {
