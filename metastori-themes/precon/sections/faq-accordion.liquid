<section class="faq-section" id="faq-{{ section.id }}">
  <div class="faq-section__inner page-width">
<!-- ── Intro ── -->
<div class="faq-section__intro">
{%- if section.settings.eyebrow != blank -%}
<p class="faq-section__eyebrow {% if section.settings.eyebrow_pill %}faq-section__eyebrow--pill{% endif %}" style="
  color: {{ section.settings.eyebrow_color }};
{% if section.settings.eyebrow_pill %}
    background-color: {{ section.settings.eyebrow_bg }};
    border: 1px solid {{ section.settings.eyebrow_border_color }};
{% endif %}
">
{{ section.settings.eyebrow }}
</p>
{%- endif -%}
{%- if section.settings.heading != blank -%}
<h2 class="faq-section__heading">{{ section.settings.heading }}</h2>
{%- endif -%}
{%- if section.settings.subtext != blank -%}
<p class="faq-section__subtext">{{ section.settings.subtext }}</p>
{%- endif -%}
</div>
<!-- ── Accordion card ── -->
{%- if section.blocks.size > 0 -%}
<div class="faq-section__card">
{%- for block in section.blocks -%}
<details class="faq-item" {{ block.shopify_attributes }}>
<summary class="faq-item__question">
<span class="faq-item__question-text">{{ block.settings.question }}</span>
<span class="faq-item__icon">
<svg width="18" height="18" viewBox="0 0 18 18" fill="none" xmlns="http://www.w3.org/2000/svg">
<line class="faq-item__icon-h" x1="3" y1="9" x2="15" y2="9" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
<line class="faq-item__icon-v" x1="9" y1="3" x2="9" y2="15" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
</svg>
</span>
</summary>
<div class="faq-item__answer">
<div class="faq-item__answer-inner">{{ block.settings.answer }}</div>
</div>
</details>
{%- endfor -%}
</div>
{%- endif -%}
</div>
</section>
<style>
.faq-section {
background-color: {{ section.settings.section_bg }};
padding: {{ section.settings.padding_top }}px 0 {{ section.settings.padding_bottom }}px;
  }
.faq-section__inner {
max-width: 1000px;
margin: 0 auto;
padding: 0 24px;
  }
.faq-section__intro {
text-align: center;
margin-bottom: 40px;
  }
.faq-section__eyebrow {
font-size: 12px;
font-weight: 700;
letter-spacing: 0.16em;
text-transform: uppercase;
margin: 0 0 16px;
  }
.faq-section__eyebrow--pill {
display: inline-block;
padding: 8px 20px;
border-radius: 20px;
font-size: 11px;
font-weight: 500;
  }
.faq-section__heading {
font-size: clamp(30px, 4vw, 46px);
font-weight: 300;
line-height: 1.15;
color: {{ section.settings.heading_color }};
margin: 0 0 14px;
  }
.faq-section__heading em,
.faq-section__heading strong,
.faq-section__heading em strong,
.faq-section__heading strong em {
  font-family: var(--accent-font-family);
  font-style: var(--accent-font-style);
  font-weight: 500;
  }
.faq-section__subtext {
font-size: clamp(15px, 1.15vw, 17px);
line-height: 1.6;
color: {{ section.settings.text_color }};
margin: 0;
  }
.faq-section__card {
background: {{ section.settings.card_bg }};
border-radius: {{ section.settings.card_radius }}px;
border: {{ section.settings.card_border_thickness }}px solid {{ section.settings.card_border_color }};
overflow: hidden;
box-shadow: 0 2px 16px rgba(0, 0, 0, 0.04);
  }
.faq-item {
border-bottom: 1px solid {{ section.settings.divider_color }};
  }
.faq-item:last-child {
border-bottom: none;
  }
.faq-item__question {
display: flex;
align-items: center;
justify-content: space-between;
gap: 20px;
padding: 22px 32px;
cursor: pointer;
list-style: none;
-webkit-appearance: none;
font-size: {{ section.settings.question_size }}px;
font-weight: {{ section.settings.question_weight }};
line-height: 1.4;
color: {{ section.settings.question_color }};
transition: background 0.2s ease;
  }
.faq-item__question::-webkit-details-marker {
display: none;
  }
.faq-item__question::marker {
content: '';
  }
.faq-item__question:hover {
background: rgba(0, 0, 0, 0.02);
  }
.faq-item__question-text {
flex: 1;
  }
.faq-item__icon {
flex-shrink: 0;
display: flex;
align-items: center;
justify-content: center;
width: 24px;
height: 24px;
color: {{ section.settings.icon_color }};
transition: transform 0.3s ease;
  }
.faq-item__icon-v {
transition: transform 0.3s ease, opacity 0.3s ease;
transform-origin: center;
  }
.faq-item[open] .faq-item__icon-v {
opacity: 0;
transform: rotate(90deg);
  }
.faq-item__answer {
overflow: hidden;
  }
.faq-item__answer-inner {
padding: 0 32px 24px;
font-size: {{ section.settings.answer_size }}px;
line-height: 1.7;
color: {{ section.settings.answer_color }};
  }
.faq-item__answer-inner p {
margin: 0 0 12px;
  }
.faq-item__answer-inner p:last-child {
margin-bottom: 0;
  }
@media (max-width: 600px) {
.faq-item__question {
padding: 18px 20px;
font-size: 15px;
    }
.faq-item__answer-inner {
padding: 0 20px 20px;
    }
  }
</style>
{% schema %}
{
  "name": "FAQ Accordion",
  "tag": "section",
  "class": "section-faq-accordion",
  "settings": [
    {
      "type": "header",
      "content": "Section layout"
    },
    {
      "type": "color",
      "id": "section_bg",
      "label": "Section background",
      "default": "#ece7df"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 120,
      "step": 4,
      "default": 72,
      "unit": "px",
      "label": "Top padding"
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "default": 72,
      "unit": "px",
      "label": "Bottom padding"
    },
    {
      "type": "header",
      "content": "Eyebrow"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "HÄUFIGE FRAGEN"
    },
    {
      "type": "color",
      "id": "eyebrow_color",
      "label": "Eyebrow color",
      "default": "#4FBFBE"
    },
    {
      "type": "checkbox",
      "id": "eyebrow_pill",
      "label": "Pill badge style",
      "default": false,
      "info": "Adds background, border and rounded corners"
    },
    {
      "type": "color",
      "id": "eyebrow_bg",
      "label": "Eyebrow background (pill only)",
      "default": "#ddeeed"
    },
    {
      "type": "color",
      "id": "eyebrow_border_color",
      "label": "Eyebrow border color (pill only)",
      "default": "#5a9e9e"
    },
    {
      "type": "header",
      "content": "Intro text"
    },
    {
      "type": "richtext",
      "id": "heading",
      "label": "Heading",
      "default": "<p>Was wird oft <em>falsch verstanden?</em></p>"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading color",
      "default": "#2c2c2c"
    },
    {
      "type": "text",
      "id": "subtext",
      "label": "Subtext",
