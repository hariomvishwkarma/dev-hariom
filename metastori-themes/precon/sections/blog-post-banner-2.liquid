<style>
  #shopify-section-{{ section.id }} {
    {%- if section.settings.blog_header_text_color == 'rgba(0,0,0,0)' -%}
      {%- assign header_text_color = settings.heading_color -%}
    {%- else -%}
      {%- assign header_text_color = section.settings.blog_header_text_color -%}
    {%- endif -%}

    {%- if section.settings.blog_header_text_color == 'rgba(0,0,0,0)' -%}
      {%- assign header_background = settings.secondary_background -%}
    {%- else -%}
      {%- assign header_background = section.settings.blog_header_background -%}
    {%- endif -%}

    --heading-color: {{ header_text_color.red }}, {{ header_text_color.green }}, {{ header_text_color.blue }};
    --text-color: {{ header_text_color.red }}, {{ header_text_color.green }}, {{ header_text_color.blue }};

    --section-header-background: {{ header_background.red }}, {{ header_background.green }}, {{ header_background.blue }};
  }
 .shopify-section--blog-post-banner-2 blog-post-header.article__header {
    display: grid;
    grid-template-columns: 30% 1fr 30%;
    height: 340px;
    margin-bottom: 30px;
}
.shopify-section--blog-post-banner-2 a.article-item__metalink {
    display: flex;
    align-items: center;
    gap: 10px;
    padding-bottom: 15px;
    font-weight: 500;
}
.shopify-section--blog-post-banner-2 a.article-item__metalink img {
    width: 20px;
    margin: 0;
}
.shopify-section--blog-post-banner-2 .article__header-content.text-container {
    background-color: #3DADBB;
    height: 100%;
    color: #fff;
    display: flex;
    align-items: center;
    flex-direction: column;
    justify-content: center;
    padding: 20px;
}
.shopify-section--blog-post-banner-2 h1.article__title.heading.h1 {
    font-size: 30px;
    line-height: 38px;
    color: #fff;
    margin-bottom: 0;
}
.shopify-section--blog-post-banner-2 .article__image-wrapper.article__image-wrapper--square {
    width: 100%;
}
.shopify-section--blog-post-banner-2 .article-item__content-inner {
    margin-bottom: auto;
    padding: 20px;
    background-color: #EFECE4;
    height: 100%;
}
.shopify-section--blog-post-banner-2 {
    margin-top: 20px;
}
.shopify-section--blog-post-banner-2  .article__image {
    object-fit: cover;
    object-position: center;
    width: 100%;
    height: 100%;
}
.shopify-section--blog-post-banner-2 h1.article__title.heading.h1:after {
    content: " ";
    height: 2px;
    width: 80px;
    bottom: 0;
    display: block;
    background: #fff;
    margin-top: 20px;
    margin-bottom: 20px;
}
.shopify-section--blog-post-banner-2 p.c-recipe-description {
    width: 100%;
    margin-top: 0;
    font-size: 18px;
}
@media only screen and (min-width: 768px) and (max-width: 992px)  {
 .shopify-section--blog-post-banner-2 blog-post-header.article__header {
    grid-template-columns: auto;
    height: 100%;
    margin-bottom: 30px;
    padding: 0;
}
}
@media only screen and (max-width: 767px) {
 .shopify-section--blog-post-banner-2 blog-post-header.article__header {
    grid-template-columns: auto;
    height: 100%;
    margin-bottom: 30px;
    padding: 0;
}
.shopify-section--blog-post-banner-2 h1.article__title.heading.h1 {
    font-size: 24px;
    line-height: 30px;
    color: #fff;
    margin-bottom: 0;
}
}
</style>
      {% comment %} <div class="container">
        <div class="page-header">
            <nav aria-label="{{ 'general.breadcrumb.title' | t }}" class="breadcrumb breadcrumb--floating text--xsmall text--subdued hidden-pocket">
                <ol class="breadcrumb__list" role="list">
                <li class="breadcrumb__item">
                    <a class="breadcrumb__link" href="{{ routes.root_url }}">{{ 'general.breadcrumb.home' | t }}</a>
                </li>

                <li class="breadcrumb__item">
                    <a class="breadcrumb__link" href="{{ blog.url }}">{{- blog.title -}}</a>
                </li>

                <li class="breadcrumb__item">
                    <span class="breadcrumb__link" aria-current="page">{{ article.title }}</span>
                </li>
                </ol>
            </nav>
        </div>
     </div> {% endcomment %}
<blog-post-header class="article__header container">

  <div class="article__header-content text-container">
    {%- if section.settings.show_category and article.tags.size > 0 -%}
      <a href="{{ blog.url }}/tagged/{{ article.tags.first | handle }}" class="article__category heading heading--small">{{ article.tags.first }}</a>
    {%- endif -%}

    <h1 class="article__title heading h1">{{ article.title }}</h1>
    {% if section.settings.rdes != blank %}
      <p class="c-recipe-description">{{ section.settings.rdes }}</p>
    {%- endif -%}
    {%- if article.excerpt != blank -%}
      <div class="article__excerpt text--large">
        {{- article.excerpt -}}
      </div>
    {%- endif -%}
  </div>

  {%- if article.image -%}
    {%- comment -%}Performance note: this image must not be lazyloaded as it contributes to the LCP{%- endcomment -%}
    <div class="article__image-wrapper {% if article.image.aspect_ratio >= 1 %}article__image-wrapper--square{% else %}article__image-wrapper--tall{% endif %}">
      {%- capture sizes -%}(max-width: 740px) 100vw, {% if article.image.aspect_ratio >= 1 %}50vw{% else %}37.5vw{% endif %}{%- endcapture -%}
      {{ article.image | image_url: width: 1500 | image_tag: sizes: sizes, widths: '200,300,400,500,600,700,800,900,1000,1100,1200,1300,1400,1500', class: 'article__image', reveal: true }}
    </div>
  {%- endif -%}


   <div class="article-item__content-inner">
          {%- assign cook_time = article.metafields.custom.cook_time -%}
          {%- assign diat = article.metafields.custom.diat -%}
          {%- assign season = article.metafields.custom.season -%}
          {%- assign course = article.metafields.custom.course -%}
          {% if cook_time %}
            <a class="article-item__metalink" href="#">
              <img src="https://cdn.shopify.com/s/files/1/0904/4639/7774/files/time-cook_1.svg?v=1756270214" alt="" width="" height="">
              {{ cook_time }}
            </a>
          {% endif %}
        {% if diat %}
          <a class="article-item__metalink" href="#">
            <img src="https://cdn.shopify.com/s/files/1/0904/4639/7774/files/diat_1.svg?v=1756270213" alt="" width="" height="">
            {{ diat }}
          </a>
        {% endif %}
        {% if season %}
          <a class="article-item__metalink" href="#">
            <img src="https://cdn.shopify.com/s/files/1/0904/4639/7774/files/Saison_1.svg?v=1756270213" alt="" width="" height="">
            {{ season }}
          </a>
        {% endif %}
        {% if course %}
          <a class="article-item__metalink" href="#">
            <img src="https://cdn.shopify.com/s/files/1/0904/4639/7774/files/gange_1.svg?v=1756270213" alt="" width="" height="">
            {{ course }}
          </a>
        {% endif %}
       </div>
</blog-post-header>

{%- schema %}
{
  "name": "Blog post header 2",
  "class": "shopify-section--blog-post-banner shopify-section--blog-post-banner-2",
  "settings": [
    {
      "type": "checkbox",
      "id": "show_category",
      "label": "Show category",
      "info": "The first article's tag will be shown as category.",
      "default": true
    },
    {
      "type": "color",
      "id": "blog_header_background",
      "label": "Background",
      "default": "#f5f5f5"
    },
    {
      "type": "color",
      "id": "blog_header_text_color",
      "label": "Text color",
      "default": "#282828"
    },
    {
      "type": "text",
      "id": "rdes",
      "label": "Short recipe description"
    }
  ]
}
{%- endschema -%}