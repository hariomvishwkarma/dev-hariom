{%- assign uid = section.id -%}

<style>
  .trust-banner-{{ uid }} { position: relative; }

  .trust-banner-{{ uid }} .trust-banner {
    background-color: {{ section.settings.bg_color }};
    display: flex;
    align-items: center;
    justify-content: center;
    flex-wrap: wrap;
    gap: 6px;
    padding: 16px 20px;
    font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
    color: {{ section.settings.text_color }};
    font-size: 15px;
    font-weight: 500;
    width: 100%;
  }
  .trust-banner-{{ uid }} .trust-banner__stars {
    color: {{ section.settings.star_color }};
    font-size: 18px;
    letter-spacing: 2px;
    margin-right: 4px;
  }
  .trust-banner-{{ uid }} .trust-banner__divider {
    margin: 0 12px;
    opacity: 0.4;
    font-weight: 300;
  }
  .trust-banner-{{ uid }} .trust-banner__item {
    white-space: nowrap;
  }

  /* Cart icon - fixed top-right, sticky on scroll */
  .trust-banner-{{ uid }} .hts-cart { position: fixed; top: 14px; right: max(var(--container-gutter, 20px), calc((100vw - var(--container-max-width, 1200px)) / 2 + var(--container-gutter, 20px))); z-index: 50; display: inline-flex; align-items: center; justify-content: center; }
  .trust-banner-{{ uid }} .hts-cart svg path { fill: {{ section.settings.cart_icon_color }}; }
  .trust-banner-{{ uid }} .hts-cart .header__cart-count { background: {{ section.settings.cart_bubble_bg }}; color: {{ section.settings.cart_bubble_text }}; }
  {% if section.settings.show_cart %}
  .trust-banner-{{ uid }} .trust-banner { padding-right: 56px; }
  {% endif %}

  @media (max-width: 600px) {
    .trust-banner-{{ uid }} .trust-banner {
      padding: 8px 12px;
      font-size: 12px;
      gap: 4px;
    }
    .trust-banner-{{ uid }} .trust-banner__stars {
      font-size: 14px;
      letter-spacing: 1px;
    }
    .trust-banner-{{ uid }} .trust-banner__hide-mobile {
      display: none;
    }
cart-count.header__cart-count.header__cart-count--floating.bubble-count {
 
    transform: scale(0.8) !important;
}
 .hts-cart {

    top: 8px !important;
 ;
}

  }
</style>

<div class="trust-banner-{{ uid }}">

  {% if section.settings.show_cart %}
    <a href="/cart" is="toggle-link" aria-controls="mini-cart" aria-expanded="false" class="hts-cart custom-header-icon header__icon-wrapper tap-area" aria-label="Warenkorb" data-no-instant="">
      <svg focusable="false" class="icon icon--header-shopping-cart" width="24" height="25" viewBox="0 0 24 25" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M9.75 20.75C9.75 21.0467 9.66203 21.3367 9.4972 21.5834C9.33238 21.83 9.09811 22.0223 8.82403 22.1358C8.54994 22.2494 8.24834 22.2791 7.95736 22.2212C7.66639 22.1633 7.39912 22.0204 7.18934 21.8107C6.97956 21.6009 6.8367 21.3336 6.77882 21.0426C6.72094 20.7517 6.75065 20.4501 6.86418 20.176C6.97771 19.9019 7.16997 19.6676 7.41665 19.5028C7.66332 19.338 7.95333 19.25 8.25 19.25C8.64782 19.25 9.02936 19.408 9.31066 19.6893C9.59196 19.9706 9.75 20.3522 9.75 20.75ZM18 19.25C17.7033 19.25 17.4133 19.338 17.1666 19.5028C16.92 19.6676 16.7277 19.9019 16.6142 20.176C16.5006 20.4501 16.4709 20.7517 16.5288 21.0426C16.5867 21.3336 16.7296 21.6009 16.9393 21.8107C17.1491 22.0204 17.4164 22.1633 17.7074 22.2212C17.9983 22.2791 18.2999 22.2494 18.574 22.1358C18.8481 22.0223 19.0824 21.83 19.2472 21.5834C19.412 21.3367 19.5 21.0467 19.5 20.75C19.5 20.3522 19.342 19.9706 19.0607 19.6893C18.7794 19.408 18.3978 19.25 18 19.25ZM22.4728 7.45062L20.0691 16.1019C19.9369 16.5745 19.6542 16.9911 19.2639 17.2885C18.8736 17.5859 18.397 17.7479 17.9062 17.75H8.64C8.14784 17.7498 7.66926 17.5886 7.27725 17.291C6.88523 16.9935 6.6013 16.5758 6.46875 16.1019L3.18 4.25H1.5C1.30109 4.25 1.11032 4.17098 0.96967 4.03033C0.829018 3.88968 0.75 3.69891 0.75 3.5C0.75 3.30109 0.829018 3.11032 0.96967 2.96967C1.11032 2.82902 1.30109 2.75 1.5 2.75H3.75C3.91397 2.74997 4.07343 2.80367 4.20398 2.90289C4.33452 3.00211 4.42895 3.14138 4.47281 3.29938L5.36156 6.5H21.75C21.8656 6.49998 21.9797 6.52669 22.0833 6.57805C22.1869 6.6294 22.2772 6.70401 22.3472 6.79605C22.4171 6.88809 22.4649 6.99506 22.4867 7.10861C22.5085 7.22216 22.5037 7.33922 22.4728 7.45062ZM20.7628 8H5.77875L7.91719 15.7006C7.96105 15.8586 8.05548 15.9979 8.18602 16.0971C8.31657 16.1963 8.47603 16.25 8.64 16.25H17.9062C18.0702 16.25 18.2297 16.1963 18.3602 16.0971C18.4908 15.9979 18.5852 15.8586 18.6291 15.7006L20.7628 8Z"></path></svg>
      <cart-count class="header__cart-count header__cart-count--floating bubble-count" aria-hidden="true">
          {% assign real_count = 0 %}

{% for item in cart.items %}
  {% unless item.properties._addon_item %}
    {% assign real_count = real_count | plus: item.quantity %}
  {% endunless %}
{% endfor %}

{{ real_count }}
      </cart-count>
    </a>
  {% endif %}

  <div class="trust-banner">
    <span class="trust-banner__stars">★★★★★</span>

    {% for block in section.blocks %}
      {% unless forloop.first %}
        <span class="trust-banner__divider{% unless block.settings.show_on_mobile %} trust-banner__hide-mobile{% endunless %}">|</span>
      {% endunless %}
      <span class="trust-banner__item{% unless block.settings.show_on_mobile %} trust-banner__hide-mobile{% endunless %}" {{ block.shopify_attributes }}>{{ block.settings.text }}</span>
    {% endfor %}
  </div>

</div>

{% schema %}
{
  "name": "Trust Banner",
  "settings": [
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#f0ece4"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#5a5347"
    },
    {
      "type": "color",
      "id": "star_color",
      "label": "Star Color",
      "default": "#d4a017"
    },
    {
      "type": "header",
      "content": "Cart Icon"
    },
    {
      "type": "checkbox",
      "id": "show_cart",
      "label": "Show cart icon (fixed top-right, sticky on scroll)",
      "default": false
    },
    {
      "type": "color",
      "id": "cart_icon_color",
      "label": "Cart icon color",
      "default": "#56473A"
    },
    {
      "type": "color",
      "id": "cart_bubble_bg",
      "label": "Cart bubble background",
      "default": "#6b2fa0"
    },
    {
      "type": "color",
      "id": "cart_bubble_text",
      "label": "Cart bubble text color",
      "default": "#ffffff"
    }
  ],
  "blocks": [
    {
      "type": "item",
      "name": "Trust Item",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "default": "Trust point"
        },
        {
          "type": "checkbox",
          "id": "show_on_mobile",
          "label": "Show on mobile",
          "default": false
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Trust Banner",
      "blocks": [
        { "type": "item", "settings": { "text": "Bekannt aus VOX · RTL · Pro7", "show_on_mobile": true } },
        { "type": "item", "settings": { "text": "39 Jahre Precon", "show_on_mobile": false } },
        { "type": "item", "settings": { "text": "Über 100.000 zufriedene Kundinnen", "show_on_mobile": false } }
      ]
    }
  ]
}
{% endschema %}
