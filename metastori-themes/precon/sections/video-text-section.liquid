{%- comment -%}
  sections/video-text-section.liquid
  2-Spalten: Video links + Text rechts (Eyebrow / Heading / Subtext / Feature-Items / Button)
  Video: YouTube, Vimeo oder natives Shopify-Video
  Fonts: Figtree 300/400/600 + Playfair Display 500 italic
{%- endcomment -%}

{%- liquid
  assign c_bg       = section.settings.color_bg
  assign c_ink      = section.settings.color_ink
  assign c_mid      = section.settings.color_mid
  assign c_accent   = section.settings.color_accent
  assign c_card_bg  = section.settings.color_card_bg
  assign c_btn_bg   = section.settings.color_btn_bg
  assign c_btn_ink  = section.settings.color_btn_ink
  assign pt         = section.settings.padding_top
  assign pb         = section.settings.padding_bottom
  assign video_url  = section.settings.video_url
  assign video_file = section.settings.video
  assign poster     = section.settings.poster_image
-%}

<div id="vt-{{ section.id }}" class="vt" style="padding-top: {{ pt }}px; padding-bottom: {{ pb }}px;">
  <div class="vt__inner">

    <!-- ── Linke Spalte: Video ── -->
    <div class="vt__media">
      <div class="vt__video-wrap">

        {%- if video_url != blank -%}

          {%- if video_url.type == 'youtube' -%}
            {%- assign embed_src = 'https://www.youtube.com/embed/' | append: video_url.id | append: '?rel=0&modestbranding=1' -%}
          {%- elsif video_url.type == 'vimeo' -%}
            {%- assign embed_src = 'https://player.vimeo.com/video/' | append: video_url.id | append: '?dnt=1' -%}
          {%- endif -%}

          {%- if poster != blank -%}
            <div class="vt__poster" id="vt-poster-{{ section.id }}">
              {{
                poster
                | image_url: width: 1200
                | image_tag: class: 'vt__poster-img', loading: 'lazy', alt: section.settings.heading
              }}
              <button class="vt__play-btn" aria-label="Video abspielen" onclick="document.getElementById('vt-poster-{{ section.id }}').style.display='none'; document.getElementById('vt-iframe-{{ section.id }}').src += '&autoplay=1';">
                <svg class="vt__play-icon" viewBox="0 0 64 64" fill="none" xmlns="http://www.w3.org/2000/svg">
                  <circle cx="32" cy="32" r="32" fill="white" fill-opacity="0.92"/>
                  <polygon points="26,20 50,32 26,44" fill="#56473A"/>
                </svg>
              </button>
            </div>
            <iframe
              id="vt-iframe-{{ section.id }}"
              class="vt__iframe"
              src="{{ embed_src }}"
              allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
              allowfullscreen
              loading="lazy"
              title="Video"
            ></iframe>
          {%- else -%}
            <iframe
              class="vt__iframe"
              src="{{ embed_src }}"
              allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
              allowfullscreen
              loading="lazy"
              title="Video"
            ></iframe>
          {%- endif -%}

        {%- elsif video_file != blank -%}
          {{
            video_file
            | video_tag:
              class: 'vt__video',
              autoplay: false,
              loop: false,
              muted: false,
              controls: true,
              preload: 'metadata'
          }}

        {%- else -%}
          <!-- Placeholder -->
          <div class="vt__placeholder">
            <svg viewBox="0 0 64 64" fill="none" xmlns="http://www.w3.org/2000/svg">
              <circle cx="32" cy="32" r="30" stroke="currentColor" stroke-width="1.5" fill="none"/>
              <polygon points="26,20 50,32 26,44" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round" fill="none"/>
            </svg>
            <p>Video hier einfügen</p>
          </div>
        {%- endif -%}

      </div>
    </div>

    <!-- ── Rechte Spalte: Text ── -->
    <div class="vt__content">

      {%- if section.settings.eyebrow != blank -%}
        <p class="vt__eyebrow">
          <span class="vt__eyebrow-rule"></span>
          {{ section.settings.eyebrow }}
          <span class="vt__eyebrow-rule"></span>
        </p>
      {%- endif -%}

      {%- if section.settings.heading != blank -%}
        <h2 class="vt__heading">{{ section.settings.heading }}</h2>
      {%- endif -%}

      {%- if section.settings.subtext != blank -%}
        <p class="vt__sub">{{ section.settings.subtext }}</p>
      {%- endif -%}

      {%- assign features = section.blocks | where: 'type', 'feature' -%}
      {%- if features.size > 0 -%}
        <ul class="vt__features">
          {%- for block in features -%}
            <li class="vt__feature" {{ block.shopify_attributes }}>
              <span class="vt__feature-icon">
                <svg viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg">
                  <circle cx="10" cy="10" r="10" fill="currentColor" opacity="0.12"/>
                  <polyline points="5,10 8.5,13.5 15,7" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              </span>
              <span class="vt__feature-text">{{ block.settings.text }}</span>
            </li>
          {%- endfor -%}
        </ul>
      {%- endif -%}

      {%- if section.settings.btn_label != blank -%}
        <a class="vt__btn" href="{{ section.settings.btn_url }}">
          {{ section.settings.btn_label }}
        </a>
      {%- endif -%}

    </div>
  </div>
</div>

<style>
@import url('https://fonts.googleapis.com/css2?family=Figtree:wght@300;400;600&family=Playfair+Display:ital,wght@1,500&display=swap');

#vt-{{ section.id }} {
  --bg:       {{ c_bg }};
  --ink:      {{ c_ink }};
  --mid:      {{ c_mid }};
  --accent:   {{ c_accent }};
  --card-bg:  {{ c_card_bg }};
  --btn-bg:   {{ c_btn_bg }};
  --btn-ink:  {{ c_btn_ink }};
}

#vt-{{ section.id }},
#vt-{{ section.id }} * { box-sizing: border-box; }

#vt-{{ section.id }} {
  background: var(--bg);
  font-family: 'Figtree', sans-serif;
  -webkit-font-smoothing: antialiased;
  padding-left: 1.5rem;
  padding-right: 1.5rem;
}

/* ── Layout ── */
#vt-{{ section.id }} .vt__inner {
  max-width: 1100px;
  margin: 0 auto;
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 4rem;
  align-items: center;
}

/* ── Video-Seite ── */
#vt-{{ section.id }} .vt__media {
  position: relative;
}

#vt-{{ section.id }} .vt__video-wrap {
  position: relative;
  width: 100%;
  aspect-ratio: 16 / 9;
  border-radius: 18px;
  overflow: hidden;
  background: #1a1a1a;
  box-shadow: 0 12px 48px rgba(0,0,0,0.12);
}

/* YouTube/Vimeo iframe */
#vt-{{ section.id }} .vt__iframe {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  border: none;
  display: block;
}

/* Native video */
#vt-{{ section.id }} .vt__video {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
}

/* Poster / Play-Button */
#vt-{{ section.id }} .vt__poster {
  position: absolute;
  inset: 0;
  z-index: 2;
  cursor: pointer;
}

#vt-{{ section.id }} .vt__poster-img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
}

#vt-{{ section.id }} .vt__play-btn {
  position: absolute;
  inset: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  background: none;
  border: none;
  cursor: pointer;
  padding: 0;
}

#vt-{{ section.id }} .vt__play-icon {
  width: 72px;
  height: 72px;
  filter: drop-shadow(0 4px 16px rgba(0,0,0,0.3));
  transition: transform 0.2s, opacity 0.2s;
}

#vt-{{ section.id }} .vt__play-btn:hover .vt__play-icon {
  transform: scale(1.08);
  opacity: 0.92;
}

/* Placeholder */
#vt-{{ section.id }} .vt__placeholder {
  position: absolute;
  inset: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 1rem;
  color: var(--mid);
  opacity: 0.4;
}

#vt-{{ section.id }} .vt__placeholder svg {
  width: 56px;
  height: 56px;
}

#vt-{{ section.id }} .vt__placeholder p {
  font-size: 13px;
  margin: 0;
}

/* ── Text-Seite ── */
#vt-{{ section.id }} .vt__content {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  gap: 1.1rem;
}

/* Eyebrow */
#vt-{{ section.id }} .vt__eyebrow {
  display: inline-flex;
  align-items: center;
  gap: 10px;
  font-size: 11px;
  font-weight: 600;
  letter-spacing: 0.24em;
  text-transform: uppercase;
  color: var(--accent);
  margin: 0;
}

#vt-{{ section.id }} .vt__eyebrow-rule {
  display: block;
  width: 22px;
  height: 1px;
  background: currentColor;
  opacity: 0.45;
  flex-shrink: 0;
}

/* Heading */
#vt-{{ section.id }} .vt__heading {
  font-size: clamp(26px, 2.8vw, 42px);
  font-weight: 300;
  color: var(--ink);
  line-height: 1.1;
  letter-spacing: -0.026em;
  text-wrap: balance;
  margin: 0;
}

#vt-{{ section.id }} .vt__heading em {
  font-family: 'Playfair Display', serif;
  font-style: italic;
  font-weight: 500;
  letter-spacing: -0.02em;
}

/* Subtext */
#vt-{{ section.id }} .vt__sub {
  font-size: clamp(15px, 1.1vw, 17px);
  font-weight: 400;
  color: var(--mid);
  line-height: 1.75;
  margin: 0;
}

/* Feature-Liste */
#vt-{{ section.id }} .vt__features {
  list-style: none;
  padding: 0;
  margin: 0.25rem 0 0;
  display: flex;
  flex-direction: column;
  gap: 0.7rem;
}

#vt-{{ section.id }} .vt__feature {
  display: flex;
  align-items: flex-start;
  gap: 10px;
}

#vt-{{ section.id }} .vt__feature-icon {
  width: 20px;
  height: 20px;
  color: var(--accent);
  flex-shrink: 0;
  margin-top: 1px;
}

#vt-{{ section.id }} .vt__feature-icon svg {
  width: 20px;
  height: 20px;
}

#vt-{{ section.id }} .vt__feature-text {
  font-size: 15px;
  font-weight: 400;
  color: var(--ink);
  line-height: 1.5;
}

/* Button */
#vt-{{ section.id }} .vt__btn {
  display: inline-flex;
  align-items: center;
  background: var(--btn-bg);
  color: var(--btn-ink);
  font-family: 'Figtree', sans-serif;
  font-size: 15px;
  font-weight: 600;
  letter-spacing: 0.01em;
  padding: 14px 32px;
  border-radius: 999px;
  text-decoration: none;
  transition: opacity 0.2s, transform 0.2s;
  margin-top: 0.5rem;
  white-space: nowrap;
}

#vt-{{ section.id }} .vt__btn:hover {
  opacity: 0.88;
  transform: translateY(-1px);
}

/* ── Responsive ── */
@media (max-width: 860px) {
  #vt-{{ section.id }} .vt__inner {
    grid-template-columns: 1fr;
    gap: 2.5rem;
  }

  #vt-{{ section.id }} {
    padding-left: 1rem;
    padding-right: 1rem;
  }
}
</style>

{% schema %}
{
  "name": "Video & Text",
  "tag": "section",
  "settings": [
    {
      "type": "header",
      "content": "Video"
    },
    {
      "type": "video_url",
      "id": "video_url",
      "label": "YouTube / Vimeo URL",
      "accept": ["youtube", "vimeo"],
      "info": "YouTube- oder Vimeo-Link einfuegen"
    },
    {
      "type": "video",
      "id": "video",
      "label": "Shopify-Video (alternativ)"
    },
    {
      "type": "image_picker",
      "id": "poster_image",
      "label": "Vorschaubild (Poster)",
      "info": "Wird vor dem Start des YouTube/Vimeo-Videos angezeigt"
    },
    {
      "type": "header",
      "content": "Text"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow (optional)",
      "default": "So funktioniert es"
    },
    {
      "type": "richtext",
      "id": "heading",
      "label": "Ueberschrift",
      "default": "<p>Dein Weg zu einem <em>gesunden Gewicht</em></p>"
    },
    {
      "type": "textarea",
      "id": "subtext",
      "label": "Subtext",
      "default": "Mit dem Precon-Konzept erreichst Du Dein Wunschgewicht – strukturiert, begleitet und mit ueber 40 Jahren Erfahrung."
    },
    {
      "type": "header",
      "content": "Button (optional)"
    },
    {
      "type": "text",
      "id": "btn_label",
      "label": "Button Text"
    },
    {
      "type": "url",
      "id": "btn_url",
      "label": "Button Link"
    },
    {
      "type": "header",
      "content": "Abstaende"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Abstand oben",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 72
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Abstand unten",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 72
    },
    {
      "type": "header",
      "content": "Farben"
    },
    {
      "type": "color",
      "id": "color_bg",
      "label": "Hintergrund",
      "default": "#FAF9F5"
    },
    {
      "type": "color",
      "id": "color_ink",
      "label": "Ueberschrift",
      "default": "#56473A"
    },
    {
      "type": "color",
      "id": "color_mid",
      "label": "Subtext",
      "default": "#8C7C70"
    },
    {
      "type": "color",
      "id": "color_accent",
      "label": "Eyebrow / Icons",
      "default": "#3DADBB"
    },
    {
      "type": "color",
      "id": "color_card_bg",
      "label": "Feature-Hintergrund",
      "default": "#FAF9F5"
    },
    {
      "type": "color",
      "id": "color_btn_bg",
      "label": "Button Hintergrund",
      "default": "#3DADBB"
    },
    {
      "type": "color",
      "id": "color_btn_ink",
      "label": "Button Text",
      "default": "#FFFFFF"
    }
  ],
  "blocks": [
    {
      "type": "feature",
      "name": "Feature-Punkt",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "default": "Klinisch getestetes Konzept"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Video & Text",
      "blocks": [
        {
          "type": "feature",
          "settings": { "text": "Klinisch getestetes Konzept" }
        },
        {
          "type": "feature",
          "settings": { "text": "Ueber 40 Jahre Erfahrung" }
        },
        {
          "type": "feature",
          "settings": { "text": "Persoenliche Begleitung inklusive" }
        }
      ]
    }
  ]
}
{% endschema %}