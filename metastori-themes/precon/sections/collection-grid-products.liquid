<div class="pro-related-div collection-grid-second">
  <div class="container">
    <div class="mainproduct-related collection-related" style="margin-left: 0; margin-right: 0;">
      {% assign custom_products = collection.metafields.custom.product_grid_second.value %}
      {% if custom_products != blank %}
        {% assign products_to_show = custom_products %}
      {% else %}
        {% assign products_to_show = collection.products %}
      {% endif %}

      {% for related_product in products_to_show limit: section.settings.recommendations_count %}
        {% render "product-item-new", related_product: related_product %}
      {% endfor %}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Collection Product Second",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Our Collection"
    },
    {
      "type": "range",
      "id": "recommendations_count",
      "label": "Products per page",
      "min": 2,
      "max": 99,
      "step": 1,
      "default": 12
    }
  ],
  "presets": [
    {
      "name": "Collection Product Second",
      "category": "Collection"
    }
  ]
}
{% endschema %}
