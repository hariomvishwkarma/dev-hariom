{{ 'section-hero-banner.css' | asset_url | stylesheet_tag }}

<section class="hero-banner" id="hero-{{ section.id }}">
{%- if section.settings.background_image != blank -%}
<div class="hero-banner__media hero-banner__media--desktop">
{{ section.settings.background_image | image_url: width: 2600 | image_tag:
class: 'hero-banner__img',
loading: 'eager',
fetchpriority: 'high',
sizes: '100vw',
widths: '375, 750, 1100, 1500, 2000, 2600'
}}
</div>
{%- endif -%}

{%- assign mobile_img = section.settings.mobile_image -%}
{%- if mobile_img != blank -%}
<div class="hero-banner__media hero-banner__media--mobile">
{{ mobile_img | image_url: width: 1100 | image_tag:
class: 'hero-banner__img',
loading: 'eager',
fetchpriority: 'high',
sizes: '100vw',
widths: '375, 750, 1100'
}}
</div>
{%- endif -%}

{%- assign overlay_rgb = section.settings.overlay_color | color_to_rgb | remove: 'rgb(' | remove: ')' -%}
<div
class="hero-banner__overlay"
style="
      --overlay-rgb: {{ overlay_rgb }};
      opacity: {{ section.settings.overlay_opacity | divided_by: 100.0 }};
    "
></div>

<div class="hero-banner__content page-width">
{%- if section.settings.show_badge and section.settings.badge_text != blank -%}
<span class="hero-banner__badge">
<svg class="hero-banner__badge-icon" width="10" height="10" viewBox="0 0 10 10" fill="none" xmlns="http://www.w3.org/2000/svg">
<path d="M5 0L6.12 3.88L10 5L6.12 6.12L5 10L3.88 6.12L0 5L3.88 3.88L5 0Z" fill="currentColor"/>
</svg>
{{ section.settings.badge_text }}
</span>
{%- endif -%}

<h1 class="hero-banner__heading">
{%- if section.settings.heading_line1 != blank -%}
<span class="hero-banner__heading-line1">{{ section.settings.heading_line1 }}</span>
{%- endif -%}
{%- if section.settings.heading_line2 != blank -%}
<em class="hero-banner__heading-line2">{{ section.settings.heading_line2 }}</em>
{%- endif -%}
</h1>

{%- if section.settings.subtext != blank -%}
<p class="hero-banner__subtext">{{ section.settings.subtext }}</p>
{%- endif -%}

{%- if section.settings.show_button_primary or section.settings.show_button_secondary -%}
<div class="hero-banner__buttons">
{%- if section.settings.show_button_primary and section.settings.button_primary_label != blank -%}
<a
href="{{ section.settings.button_primary_link }}"
class="hero-banner__btn hero-banner__btn--primary"
>
{{ section.settings.button_primary_label }}
</a>
{%- endif -%}
{%- if section.settings.show_button_secondary and section.settings.button_secondary_label != blank -%}
<a
href="{{ section.settings.button_secondary_link }}"
class="hero-banner__btn hero-banner__btn--secondary"
>
{{ section.settings.button_secondary_label }}
</a>
{%- endif -%}
</div>
{%- endif -%}
</div>
</section>

<style>
/* ── Hero Banner ── */
.hero-banner {
position: relative;
width: 100%;
min-height: 600px;
display: flex;
align-items: center;
overflow: hidden;
  }
.hero-banner__media {
position: absolute;
inset: 0;
z-index: 0;
  }
.hero-banner__media--mobile {
display: none;
  }
.hero-banner__img {
width: 100%;
height: 100%;
object-fit: cover;
object-position: center;
  }
.hero-banner__overlay {
position: absolute;
inset: 0;
z-index: 1;
background: linear-gradient(
      to right,
rgba(var(--overlay-rgb), 0.45) 0%,
rgba(var(--overlay-rgb), 0.15) 55%,
transparent 75%
    );
pointer-events: none;
  }

/* ── Content ── */
.hero-banner__content {
position: relative;
z-index: 2;
padding: 80px max(24px, 5rem);
max-width: 620px;
  }

/* ── Badge ── */
.hero-banner__badge {
display: inline-flex;
align-items: center;
gap: 8px;
background: {{ section.settings.badge_bg_color }};
backdrop-filter: blur(6px);
-webkit-backdrop-filter: blur(6px);
border: 1px solid {{ section.settings.badge_border_color }};
border-radius: 6px;
padding: 8px 16px;
font-size: 11px;
font-weight: 600;
letter-spacing: 0.12em;
text-transform: uppercase;
color: {{ section.settings.badge_text_color }};
margin-bottom: 28px;
  }
.hero-banner__badge-icon {
flex-shrink: 0;
  }

/* ── Heading ── */
.hero-banner__heading {
font-family: inherit;
font-size: clamp(42px, 5.5vw, 72px);
font-weight: 300;
line-height: 1.08;
color: #fff;
margin: 0 0 24px;
  }
.hero-banner__heading-line1 {
display: block;
  }
.hero-banner__heading-line2 {
display: block;
  font-family: var(--accent-font-family);
  font-style: var(--accent-font-style);
  font-weight: 500;
}

/* ── Subtext ── */
.hero-banner__subtext {
font-size: clamp(15px, 1.2vw, 18px);
line-height: 1.65;
color: rgba(255, 255, 255, 0.85);
margin: 0 0 36px;
max-width: 480px;
  }

/* ── Buttons ── */
.hero-banner__buttons {
display: flex;
flex-wrap: wrap;
gap: 14px;
align-items: center;
  }
.hero-banner__btn {
display: inline-flex;
align-items: center;
justify-content: center;
padding: 14px 32px;
font-size: 15px;
font-weight: 500;
border-radius: 50px;
text-decoration: none;
transition: all 0.25s ease;
cursor: pointer;
white-space: nowrap;
  }
.hero-banner__btn--primary {
background-color: {{ section.settings.button_primary_color }};
color: {{ section.settings.button_primary_text_color }};
border: 2px solid {{ section.settings.button_primary_color }};
  }
.hero-banner__btn--primary:hover {
background-color: transparent;
color: #fff;
border-color: #fff;
  }
.hero-banner__btn--secondary {
background-color: {{ section.settings.button_secondary_color }};
color: {{ section.settings.button_secondary_text_color }};
border: 2px solid {{ section.settings.button_secondary_color }};
  }
.hero-banner__btn--secondary:hover {
background-color: transparent;
color: #fff;
border-color: #fff;
  }

/* ── Responsive ── */
@media (max-width: 768px) {
.hero-banner {
min-height: 520px;
    }
.hero-banner__content {
padding: 60px 24px;
max-width: 100%;
    }
{%- if mobile_img != blank -%}
.hero-banner__media--desktop {
display: none;
    }
{%- endif -%}
.hero-banner__media--mobile {
display: block;
    }
.hero-banner__overlay {
background: linear-gradient(
        to bottom,
rgba(var(--overlay-rgb), 0.5) 0%,
rgba(var(--overlay-rgb), 0.2) 100%
      );
    }
.hero-banner__buttons {
flex-direction: column;
align-items: stretch;
    }
.hero-banner__btn {
text-align: center;
    }
  }
</style>

{% schema %}
{
  "name": "Hero Banner",
  "tag": "section",
  "class": "section-hero-banner",
  "settings": [
    {
      "type": "image_picker",
      "id": "background_image",
      "label": "Background image"
    },
    {
      "type": "image_picker",
      "id": "mobile_image",
      "label": "Mobile background image",
      "info": "Shown on screens 768px and below. Falls back to the desktop image if left empty."
    },
    {
      "type": "header",
      "content": "Overlay"
    },
    {
      "type": "color",
      "id": "overlay_color",
      "label": "Overlay color",
      "default": "#000000"
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "min": 0,
      "max": 100,
      "step": 5,
      "default": 100,
      "unit": "%",
      "label": "Overlay opacity"
    },
    {
      "type": "header",
      "content": "Badge"
    },
    {
      "type": "checkbox",
      "id": "show_badge",
      "label": "Badge anzeigen",
      "default": true
    },
    {
      "type": "text",
      "id": "badge_text",
      "label": "Badge text",
      "default": "39 JAHRE ABNEHMEXPERTISE"
    },
    {
      "type": "color",
      "id": "badge_text_color",
      "label": "Badge text color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "badge_bg_color",
      "label": "Badge background color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "badge_border_color",
      "label": "Badge border color",
      "default": "#ffffff"
    },
    {
      "type": "header",
      "content": "Text"
    },
    {
      "type": "text",
      "id": "heading_line1",
      "label": "Heading line 1",
      "default": "Abnehmen,"
    },
    {
      "type": "text",
      "id": "heading_line2",
      "label": "Heading line 2 (italic)",
      "default": "aber machbar."
    },
    {
      "type": "textarea",
      "id": "subtext",
      "label": "Subtext",
      "default": "Das Precon-Konzept: 3 klare Phasen, die Deine Abnehmreise alltagstauglich, abwechslungsreich und erfolgreich machen."
    },
    {
      "type": "header",
      "content": "Primary Button"
    },
    {
      "type": "checkbox",
      "id": "show_button_primary",
      "label": "Primary Button anzeigen",
      "default": true
    },
    {
      "type": "text",
      "id": "button_primary_label",
      "label": "Primary button label",
      "default": "Konzept entdecken"
    },
    {
      "type": "url",
      "id": "button_primary_link",
      "label": "Primary button link"
    },
    {
      "type": "color",
      "id": "button_primary_color",
      "label": "Primary button background color",
      "default": "#4FBFBE"
    },
    {
      "type": "color",
      "id": "button_primary_text_color",
      "label": "Primary button text color",
      "default": "#ffffff"
    },
    {
      "type": "header",
      "content": "Secondary Button"
    },
    {
      "type": "checkbox",
      "id": "show_button_secondary",
      "label": "Secondary Button anzeigen",
      "default": true
    },
    {
      "type": "text",
      "id": "button_secondary_label",
      "label": "Secondary button label",
      "default": "Goldene Regeln"
    },
    {
      "type": "url",
      "id": "button_secondary_link",
      "label": "Secondary button link"
    },
    {
      "type": "color",
      "id": "button_secondary_color",
      "label": "Secondary button background color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "button_secondary_text_color",
      "label": "Secondary button text color",
      "default": "#2c2c2c"
    }
  ],
  "presets": [
    {
      "name": "Hero Banner"
    }
  ]
}
{% endschema %}