<style>
  .pkg-list {
    padding: 48px 20px;
    font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
    background-color: {{ section.settings.bg_color }};
    color: {{ section.settings.text_color }};
  }
  .pkg-list__inner {
    max-width: 960px;
    margin: 0 auto;
  }
  .pkg-list__label {
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 2px;
    text-transform: uppercase;
    color: {{ section.settings.accent_color }};
    margin-bottom: 8px;
  }
  .pkg-list__heading {
    font-size: clamp(28px, 4.5vw, 42px);
    font-weight: 400;
    font-style: italic;
    font-family: Georgia, 'Times New Roman', serif;
    line-height: 1.15;
    margin: 0 0 36px;
    max-width: 550px;
  }

  /* ── Two columns ── */
  .pkg-list__columns {
    display: flex;
    gap: 40px;
    align-items: center;
  }
  .pkg-list__col-img {
    flex: 0 0 45%;
    min-width: 0;
  }
  .pkg-list__col-img img {
    width: 100%;
    height: auto;
    display: block;
    border-radius: 14px;
  }
  .pkg-list__col-items {
    flex: 1;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 0;
  }

  /* ── Item row ── */
  .pkg-list__item {
    display: flex;
    align-items: flex-start;
    gap: 16px;
    padding: 18px 0;
    border-bottom: 1px solid {{ section.settings.divider_color }};
  }
  .pkg-list__item:last-child {
    border-bottom: none;
  }
  .pkg-list__qty {
    flex-shrink: 0;
    width: 36px;
    height: 36px;
    border-radius: 10px;
    background: {{ section.settings.qty_bg }};
    color: {{ section.settings.accent_color }};
    font-size: 14px;
    font-weight: 700;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .pkg-list__item-content {
    flex: 1;
    min-width: 0;
  }
  .pkg-list__item-title {
    font-size: 15px;
    font-weight: 700;
    margin: 0 0 4px;
    line-height: 1.3;
  }
  .pkg-list__item-desc {
    font-size: 14px;
    line-height: 1.5;
    opacity: 0.65;
    margin: 0;
  }

  @media (max-width: 768px) {
    .pkg-list {
      padding: 24px 14px;
    }
    .pkg-list__heading {
      font-size: 26px;
      margin-bottom: 24px;
    }
    .pkg-list__columns {
      flex-direction: column;
      gap: 24px;
    }
    .pkg-list__col-img {
      flex: none;
      width: 100%;
    }
    .pkg-list__item {
      gap: 12px;
      padding: 14px 0;
    }
    .pkg-list__qty {
      width: 32px;
      height: 32px;
      font-size: 13px;
      border-radius: 8px;
    }
    .pkg-list__item-title {
      font-size: 14px;
    }
    .pkg-list__item-desc {
      font-size: 13px;
    }
  }
</style>

<div class="pkg-list">
  <div class="pkg-list__inner">
    {% if section.settings.top_label != blank %}
      <div class="pkg-list__label">{{ section.settings.top_label }}</div>
    {% endif %}

    <h2 class="pkg-list__heading">{{ section.settings.heading }}</h2>

    <div class="pkg-list__columns">
      <div class="pkg-list__col-img">
        {% if section.settings.image != blank %}
          <img
            src="{{ section.settings.image | image_url: width: 800 }}"
            alt="{{ section.settings.heading | strip_html }}"
            loading="lazy"
            width="800"
            height="800"
          >
        {% endif %}
      </div>

      <div class="pkg-list__col-items">
        {% for block in section.blocks %}
          <div class="pkg-list__item" {{ block.shopify_attributes }}>
            <div class="pkg-list__qty">{{ block.settings.qty }}</div>
            <div class="pkg-list__item-content">
              <h3 class="pkg-list__item-title">{{ block.settings.title }}</h3>
              {% if block.settings.desc != blank %}
                <p class="pkg-list__item-desc">{{ block.settings.desc }}</p>
              {% endif %}
            </div>
          </div>
        {% endfor %}
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Package List",
  "settings": [
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#faf8f4"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#3a3631"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent Color",
      "default": "#2fb5a0"
    },
    {
      "type": "color",
      "id": "divider_color",
      "label": "Divider Color",
      "default": "#e4dfd6"
    },
    {
      "type": "color",
      "id": "qty_bg",
      "label": "Quantity Badge Background",
      "default": "#e8f5f2"
    },
    {
      "type": "text",
      "id": "top_label",
      "label": "Top Label",
      "default": "Im Paket enthalten"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Alles für deine ersten 4 Wochen"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Product Image"
    }
  ],
  "blocks": [
    {
      "type": "item",
      "name": "Item",
      "settings": [
        {
          "type": "text",
          "id": "qty",
          "label": "Quantity / Symbol",
          "default": "1"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Produkt"
        },
        {
          "type": "textarea",
          "id": "desc",
          "label": "Description",
          "default": "Kurze Beschreibung."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Package List",
      "blocks": [
        { "type": "item", "settings": { "qty": "1", "title": "Start Shake", "desc": "Für die ersten 2 Tage der Stoffwechselumstellung" } },
        { "type": "item", "settings": { "qty": "2", "title": "Precon Shakes", "desc": "Je 24 Mahlzeiten. Cappuccino, Vanille oder Schoko" } },
        { "type": "item", "settings": { "qty": "2", "title": "Riegelpakete", "desc": "Je 3 Riegel. ChocoCrisp, ChocoBar oder CranberryCrisp" } },
        { "type": "item", "settings": { "qty": "1", "title": "Shake-Mix Probier-Set", "desc": "9 verschiedene Sorten in Einzelportionen" } },
        { "type": "item", "settings": { "qty": "1", "title": "Precon Shaker", "desc": "Für die einfache Zubereitung in 30 Sekunden" } },
        { "type": "item", "settings": { "qty": "+", "title": "Precon Handbuch & Rezept-E-Book", "desc": "Dein 4-Wochen-Begleiter mit allen Tipps" } }
      ]
    }
  ]
}
{% endschema %}