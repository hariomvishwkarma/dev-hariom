{% assign card_slides = product.metafields.custom.content_card_slider.value %}

{% if card_slides != blank %}
<style>
    .content-card-slider-main{
        display:none;
    }
  .card_mobile_slider{
    display:none;
  }
  .curved-slider-wrapper{
    width:100%;
  }
  .curved-slider {
    position: relative;
    padding: 64px 0;
    overflow: hidden;
  }

  .cs-section-title {
    text-align: center;
    color: #290907;
    font-size: 37.3px;
    font-weight: 400;
    line-height: 100%;
    letter-spacing: -1.119px;
    margin-bottom: 32px;
  }

  .swiper {
    overflow: visible;
    padding-bottom: 0px;
  }

  .curved-slider-wrapper .swiper-slide {
    transition: 0.4s ease;
    transform: translate(-20px, 34px) rotate(-6deg);
  }

  .curved-slider-wrapper .swiper-slide.swiper-slide-next {
    transform: translate(8px, 8px) rotate(3deg);
  }

  .curved-slider-wrapper .swiper-slide.swiper-slide-next + .swiper-slide {
    transform: translate(16px, 36px) rotate(6deg);
  }
  .curved-slider-wrapper .swiper-slide.swiper-slide-next + .swiper-slide + .swiper-slide {
    transform: translate(24px, 64px) rotate(9deg);
  }

  .curved-slider-wrapper .swiper-slide.swiper-slide-prev {
    transform: translate(-10px, 7px) rotate(-3deg);
  }

  .curved-slider-wrapper .swiper-slide.swiper-slide-active {
    transform: unset;
  }

  .cs-card {
    background: #EFECE4;
    border-radius: 16px;
    padding: 24px;
    text-align: center;
    position: relative;
    min-height: 430px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 32px;
  }

  .cs-badge {
    position: absolute;
    top: 24px;
    left: 24px;
    padding: 0px 10px;
    color: #FFF;
    font-size: 16px;
    font-weight: 500;
    line-height: 27.73px;
    border-radius: 16px;
    background: #3DADBB;
  }

  .cs-image-wrap {
    width: 100%;
    height: auto;
    margin: 0px auto;
    background: #FFFFFF66;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    max-width: 242px;
    aspect-ratio: 1;
    align-self: stretch;
    overflow:hidden;
}

  .cs-image-wrap img {
    width: 100%;
    object-fit: cover;
  }

  .cs-card-content{
    display:flex;
    flex-direction:column;
    align-items:center;
    gap:16px;
  }

  .cs-card-title {
    margin-bottom: 0;
    color: #290907;
    font-size: 21.6px;
    font-weight: 700;
    line-height: normal;
    letter-spacing: -0.648px;
  }

  .cs-card-desc {
    overflow: hidden;
    color: rgba(41, 9, 7, 0.80);
    text-overflow: ellipsis;
    font-weight: 400;
    line-height: 150%;
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 3;
    align-self: stretch;
    margin: 0;
  }

  .cs-slider-nav {
    display: flex;
    gap: 16px;
    justify-content: center;
    margin-top: 45px;
  }

  .cs-slider-btn {
    cursor: pointer;
    border-radius: 360px;
    border: 1px solid #3DADBB;
    background: #FFF;
    width: 40px;
    height: 40px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  @media(max-width: 768px) {
    .card_mobile_slider{
      display:block;
    }
    .card_desktop_slider{
      display:none;
    }
    .curved-slider {
      padding:24px 0;
    }
    .cs-section-title {
      font-size: 24.2px;
      padding: 0 24px;
    }

    .cs-card {
      min-height: 360px;
    }

    .cs-card-title {
      font-size: 20.2px;
    }

    .cs-card-desc {
      font-size: 14px;
    }
    {% if template.name == 'product' and product.url == '/products/4-wochen-paket' %}
      .content-card-slider-main{
        display:block;
      }
    {% endif %}
  }
</style>

{% capture card_list %}
  {% for card in card_slides %}
    <div class="swiper-slide">
      <div class="cs-card">
        {% if card.badge_text != blank %}
          <span class="cs-badge"></span>
        {% endif %}
        <div class="cs-image-wrap">
          {% if card.image != blank %}
            <img src="{{ card.image | image_url:width:460 }}" alt="image" width="auto" height="auto">
          {% endif %}
        </div>

        <div class="cs-card-content">
          {% if card.title != blank %}
            <h3 class="cs-card-title">{{ card.title }}</h3>
          {% endif %}
          {% if card.description != blank %}
          <p class="cs-card-desc">
            {{ card.description }}
          </p>
          {% endif %}
        </div>
      </div>
    </div>
  {% endfor %}
{% endcapture %}

<section class="curved-slider">
  <div class="curved-slider-wrapper">

    {% if section.settings.heading != blank %}
      <h2 class="cs-section-title">
        {{ section.settings.heading }}
      </h2>
    {% endif %}

    <div class="card_desktop_slider">
      <div class="swiper productSwiper">
        <div class="swiper-wrapper">
          {{ card_list }} {{ card_list }} {{ card_list }}
          {% comment %} {% if card_slides.size < 3 %}
            {{ card_list }}{{ card_list }}{{ card_list }}{{ card_list }}{{ card_list }}{{ card_list }}
          {% else %}
            {{ card_list }}{{ card_list }}{{ card_list }}{{ card_list }}
          {% endif %} {% endcomment %}
        </div>

        <!-- Navigation -->
        <div class="cs-slider-nav">
          <button class="cs-slider-btn cs-prev-btn">
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none">
              <path d="M20.25 12H3.75" stroke="#3DADBB" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
              <path d="M10.5 5.25L3.75 12L10.5 18.75" stroke="#3DADBB" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </button>
          <button class="cs-slider-btn cs-next-btn">
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none">
              <path d="M3.75 12H20.25" stroke="#3DADBB" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
              <path d="M13.5 5.25L20.25 12L13.5 18.75" stroke="#3DADBB" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </button>
        </div>
      </div>
    </div>
    <div class="card_mobile_slider">
      <div class="swiper productSwiper">
        <div class="swiper-wrapper">
          {{ card_list }}
          {% comment %} {% if card_slides.size < 3 %}
            {{ card_list }}{{ card_list }}{{ card_list }}{{ card_list }}{{ card_list }}{{ card_list }}
          {% else %}
            {{ card_list }}{{ card_list }}{{ card_list }}{{ card_list }}
          {% endif %} {% endcomment %}
        </div>

        <!-- Navigation -->
        <div class="cs-slider-nav">
          <button class="cs-slider-btn cs-prev-btn">
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none">
              <path d="M20.25 12H3.75" stroke="#3DADBB" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
              <path d="M10.5 5.25L3.75 12L10.5 18.75" stroke="#3DADBB" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </button>
          <button class="cs-slider-btn cs-next-btn">
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none">
              <path d="M3.75 12H20.25" stroke="#3DADBB" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
              <path d="M13.5 5.25L20.25 12L13.5 18.75" stroke="#3DADBB" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </button>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  const swiper = new Swiper(".card_desktop_slider .productSwiper", {
    loop: true,
    centeredSlides: true,
    slidesPerView: 1.4,
    spaceBetween: 8,
    speed: 400,
    allowTouchMove: false,
    navigation: {
      nextEl: ".card_desktop_slider .cs-next-btn",
      prevEl: ".card_desktop_slider .cs-prev-btn",
    },

    breakpoints: {
      768: {
        slidesPerView: 4.8,
        spaceBetween: 16,
      },
      1024: {
        slidesPerView: 4.8,
        spaceBetween: 16,
      },
    }
  });

  const mobileSwiper = new Swiper(".card_mobile_slider .productSwiper", {
    loop: false,
    centeredSlides: true,
    slidesPerView: 1.4,
    spaceBetween: 8,
    speed: 400,
    allowTouchMove: false,
    navigation: {
      nextEl: ".card_mobile_slider .cs-next-btn",
      prevEl: ".card_mobile_slider .cs-prev-btn",
    },

    breakpoints: {
      768: {
        slidesPerView: 4.8,
        spaceBetween: 16,
      },
      1024: {
        slidesPerView: 4.8,
        spaceBetween: 16,
      },
    }
  });
</script>

{% endif %}

{% schema %}
{
  "name": "Content Card Slider",
  "class": "content-card-slider-main",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Das beinhaltet unser (Name des Sets)-Set"
    }
  ],
  "presets": [
    {
      "name": "Content Card Slider"
    }
  ]
}
{% endschema %}
