<section class="golden-rules" id="golden-rules-{{ section.id }}">
  <div class="golden-rules__inner page-width">

{%- if section.settings.eyebrow != blank -%}
<p class="golden-rules__eyebrow" style="color: {{ section.settings.eyebrow_color }};">
{{ section.settings.eyebrow }}
</p>
{%- endif -%}

{%- if section.settings.heading != blank -%}
<h2 class="golden-rules__heading">{{ section.settings.heading }}</h2>
{%- endif -%}

{%- if section.settings.subtext != blank -%}
<p class="golden-rules__subtext">{{ section.settings.subtext }}</p>
{%- endif -%}

{%- if section.blocks.size > 0 -%}
<div class="golden-rules__grid">
{%- for block in section.blocks -%}
<div class="golden-rules__card" {{ block.shopify_attributes }}>
{%- if block.settings.icon != blank -%}
<span class="golden-rules__icon" style="background-color: {{ block.settings.icon_bg }};">
{{ block.settings.icon | image_url: width: 80 | image_tag: class: 'golden-rules__icon-img' }}
</span>
{%- endif -%}

{%- if block.settings.title != blank -%}
<h3 class="golden-rules__card-title">{{ block.settings.title }}</h3>
{%- endif -%}

{%- if block.settings.text != blank -%}
<p class="golden-rules__card-text">{{ block.settings.text }}</p>
{%- endif -%}
</div>
{%- endfor -%}
</div>
{%- endif -%}

</div>
</section>

<style>
/* ══════════════════════════════════
     Section
     ══════════════════════════════════ */
.golden-rules {
background-color: {{ section.settings.section_bg }};
padding: {{ section.settings.padding_top }}px 0 {{ section.settings.padding_bottom }}px;
  }

.golden-rules__inner {
max-width: 1200px;
margin: 0 auto;
padding: 0 24px;
text-align: center;
  }

/* ── Eyebrow ── */
.golden-rules__eyebrow {
font-size: 12px;
font-weight: 700;
letter-spacing: 0.16em;
text-transform: uppercase;
margin: 0 0 16px;
  }

/* ── Heading ── */
.golden-rules__heading {
font-size: clamp(30px, 4vw, 48px);
font-weight: 300;
line-height: 1.15;
color: {{ section.settings.heading_color }};
margin: 0 0 16px;
  }

.golden-rules__heading em,
.golden-rules__heading strong,
.golden-rules__heading em strong,
.golden-rules__heading strong em {
  font-family: var(--accent-font-family);
  font-style: var(--accent-font-style);
  font-weight: 500;
}

/* ── Subtext ── */
.golden-rules__subtext {
font-size: clamp(15px, 1.2vw, 17px);
line-height: 1.6;
color: {{ section.settings.text_color }};
max-width: 680px;
margin: 0 auto 48px;
  }

/* ══════════════════════════════════
     Card grid
     ══════════════════════════════════ */
.golden-rules__grid {
display: grid;
grid-template-columns: repeat({{ section.settings.columns }}, 1fr);
gap: {{ section.settings.card_gap }}px;
  }

/* ── Card ── */
.golden-rules__card {
background: {{ section.settings.card_bg }};
border: {{ section.settings.card_border_thickness }}px solid {{ section.settings.card_border_color }};
border-radius: {{ section.settings.card_radius }}px;
padding: 36px 28px 32px;
text-align: left;
  }

/* ── Icon ── */
.golden-rules__icon {
display: inline-flex;
align-items: center;
justify-content: center;
width: 52px;
height: 52px;
border-radius: 14px;
margin-bottom: 24px;
overflow: hidden;
  }

.golden-rules__icon-img {
width: 28px;
height: 28px;
object-fit: contain;
  }

/* ── Card title ── */
.golden-rules__card-title {
font-size: clamp(16px, 1.4vw, 19px);
font-weight: 600;
line-height: 1.3;
color: {{ section.settings.card_title_color }};
margin: 0 0 10px;
  }

/* ── Card text ── */
.golden-rules__card-text {
font-size: 14px;
line-height: 1.6;
color: {{ section.settings.card_text_color }};
margin: 0;
  }

/* ══════════════════════════════════
     Responsive
     ══════════════════════════════════ */
@media (max-width: 960px) {
.golden-rules__grid {
grid-template-columns: repeat(2, 1fr);
    }
  }

@media (max-width: 600px) {
.golden-rules__grid {
grid-template-columns: 1fr;
    }

.golden-rules__card {
padding: 28px 24px 24px;
    }
  }
</style>

{% schema %}
{
  "name": "Golden Rules",
  "tag": "section",
  "class": "section-golden-rules",
  "settings": [
    {
      "type": "header",
      "content": "Section layout"
    },
    {
      "type": "color",
      "id": "section_bg",
      "label": "Section background",
      "default": "#5c5046"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 120,
      "step": 4,
      "default": 72,
      "unit": "px",
      "label": "Top padding"
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "default": 72,
      "unit": "px",
      "label": "Bottom padding"
    },
    {
      "type": "header",
      "content": "Text"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow text",
      "default": "ERFOLGSFAKTOREN"
    },
    {
      "type": "color",
      "id": "eyebrow_color",
      "label": "Eyebrow color",
      "default": "#4FBFBE"
    },
    {
      "type": "richtext",
      "id": "heading",
      "label": "Heading (use bold+italic for emphasis)",
      "default": "<p>Die 4 <em><strong>goldenen Regeln</strong></em></p>"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading color",
      "default": "#ffffff"
    },
    {
      "type": "textarea",
      "id": "subtext",
      "label": "Subtext",
      "default": "Diese Regeln gelten in allen Phasen. Wer sie konsequent befolgt, hat die besten Chancen auf dauerhaften Erfolg."
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Subtext color",
      "default": "#c8c1b9"
    },
    {
      "type": "header",
      "content": "Card grid"
    },
    {
      "type": "range",
      "id": "columns",
      "min": 1,
      "max": 6,
      "step": 1,
      "default": 4,
      "label": "Columns per row"
    },
    {
      "type": "range",
      "id": "card_gap",
      "min": 0,
      "max": 40,
      "step": 4,
      "default": 20,
      "unit": "px",
      "label": "Gap between cards"
    },
    {
      "type": "header",
      "content": "Card style"
    },
    {
      "type": "color",
      "id": "card_bg",
      "label": "Card background",
      "default": "#685e54"
    },
    {
      "type": "range",
      "id": "card_radius",
      "min": 0,
      "max": 32,
      "step": 2,
      "default": 14,
      "unit": "px",
      "label": "Card corner radius"
    },
    {
      "type": "range",
      "id": "card_border_thickness",
      "min": 0,
      "max": 5,
      "step": 0.5,
      "default": 1,
      "unit": "px",
      "label": "Card border thickness"
    },
    {
      "type": "color",
      "id": "card_border_color",
      "label": "Card border color",
      "default": "#7a7068"
    },
    {
      "type": "color",
      "id": "card_title_color",
      "label": "Card title color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "card_text_color",
      "label": "Card body color",
      "default": "#b8b0a7"
    }
  ],
  "blocks": [
    {
      "type": "rule",
      "name": "Rule card",
      "settings": [
        {
          "type": "image_picker",
          "id": "icon",
          "label": "Icon image"
        },
        {
          "type": "color",
          "id": "icon_bg",
          "label": "Icon background",
          "default": "#4FBFBE"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "3 Mahlzeiten am Tag"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Description",
          "default": "Nicht mehr, nicht weniger. Das Drei-Mahlzeiten-Prinzip ist das Fundament des Konzepts."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Golden Rules",
      "blocks": [
        {
          "type": "rule",
          "settings": {
            "icon_bg": "#4FBFBE",
            "title": "3 Mahlzeiten am Tag",
            "text": "Nicht mehr, nicht weniger. Das Drei-Mahlzeiten-Prinzip ist das Fundament des Konzepts."
          }
        },
        {
          "type": "rule",
          "settings": {
            "icon_bg": "#4FBFBE",
            "title": "4–6 Stunden Pause",
            "text": "Zwischen den Mahlzeiten keine Snacks. Die Esspause hält den Insulinspiegel niedrig und ermöglicht Fettverbrennung."
          }
        },
        {
          "type": "rule",
          "settings": {
            "icon_bg": "#4FBFBE",
            "title": "2–3 Liter täglich",
            "text": "Wasser, ungesüsster Tee oder kalorienfreie Getränke. Ausreichend Flüssigkeit ist essenziell."
          }
        },
        {
          "type": "rule",
          "settings": {
            "icon_bg": "#4FBFBE",
            "title": "Normale Mahlzeit ca. 500 - 600 kcal",
            "text": "Ausgewogen und nährstoffreich. Nutze die Precon-Rezepte als Orientierung."
          }
        }
      ]
    }
  ]
}
{% endschema %}