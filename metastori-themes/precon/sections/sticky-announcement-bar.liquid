{% if section.settings.content != blank and template.name == 'index' %}
<style>
.sticky-announcement-content {
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 8px 0;
    font-size: 11.6px;
    line-height: normal;
}
.sticky-announcement-content a {
    text-decoration: underline!important;
}
.sticky-announcement-section-bar {
    top: 88px;
    z-index: 2;
    display:none;
    position: sticky;
}
{% comment %} .sticky_bar_active .sticky-announcement-section-bar{
    display:block;
} {% endcomment %}
.sticky-announcement-content a, .sticky-announcement-content a:hover {
    color: {{ section.settings.text_color }} !important;
}
@media (max-width:767px){
    .sticky-announcement-section-bar {
        top: 68px;
    }
}
</style>

    <div class="sticky-announcement-main" style="background:{{ section.settings.bg_color }};color:{{ section.settings.text_color }};">
        <div class="{% if section.settings.include_horizontal_margins %}container{% endif %}">
            <div class="sticky-announcement-content">{{ section.settings.content }}</div>
        </div>
    </div>

<script>
let lastScrollTop = window.pageYOffset || document.documentElement.scrollTop;
const threshold = 10;
const minScroll = 150;

window.addEventListener('scroll', () => {
  const currentScrollTop = window.pageYOffset || document.documentElement.scrollTop;

  if (Math.abs(currentScrollTop - lastScrollTop) < threshold) return;

  if (currentScrollTop > lastScrollTop && currentScrollTop > minScroll) {
    document.body.classList.add('sticky_bar_active');
  } else if (currentScrollTop < lastScrollTop) {
    document.body.classList.remove('sticky_bar_active');
  }

  lastScrollTop = currentScrollTop;
});
</script>
{% endif %}

{% schema %}
{
  "name": "Sticky Announcement-Bar ",
  "class": "sticky-announcement-section-bar",
  "settings": [
    {
        "type": "richtext",
        "id":"content",
        "label": "Content"
    },
    {
        "type": "color",
        "id":"bg_color",
        "label": "Background Color"
    },
    {
        "type": "color",
        "id":"text_color",
        "label": "Text Color"
    },
    {
      "type": "checkbox",
      "id": "include_horizontal_margins",
      "label": "Include horizontal margins",
      "default": true
    }
  ],
  "presets": [
    {
      "name": "Sticky Announcement-Bar"
    }
  ]
}
{% endschema %}
