{% comment %}
  Section: Relaunch Features
{% endcomment %}

<section class="relaunch-features" style="background-color: {{ section.settings.bg_color }};">
  <div class="relaunch-features__container">
    <div class="relaunch-features__content">
      <h2 class="relaunch-features__heading">
        {{ section.settings.heading }} <em>{{ section.settings.heading_italic }}</em>
      </h2>

      <p class="relaunch-features__intro">{{ section.settings.intro_text }}</p>

      <div class="relaunch-features__items">
        {% for block in section.blocks %}
          {% if block.type == 'feature' %}
            <div class="relaunch-features__item" {{ block.shopify_attributes }}>
              {% if block.settings.icon != blank %}
                <div class="relaunch-features__icon">
                  <img
                    src="{{ block.settings.icon | image_url: width: 80 }}"
                    alt=""
                    width="40"
                    height="40"
                    loading="lazy"
                  >
                </div>
              {% endif %}
              <div class="relaunch-features__item-content">
                <h3 class="relaunch-features__item-title">{{ block.settings.title }}</h3>
                <p class="relaunch-features__item-text">{{ block.settings.text }}</p>
              </div>
            </div>
          {% endif %}
        {% endfor %}
      </div>

      {% if section.settings.callout_text != blank %}
        <div class="relaunch-features__callout" style="background-color: {{ section.settings.callout_bg }}; border-left-color: {{ section.settings.accent_color }};">
          <p><strong>{{ section.settings.callout_bold }}</strong> {{ section.settings.callout_text }}</p>
        </div>
      {% endif %}
    </div>

    <div class="relaunch-features__image">
      {% if section.settings.image != blank %}
        <img
          src="{{ section.settings.image | image_url: width: 800 }}"
          alt="{{ section.settings.image_alt }}"
          loading="lazy"
          width="800"
        >
      {% endif %}
    </div>
  </div>
</section>

<style>
  .relaunch-features {
    padding: 60px 20px;
  }

  .relaunch-features__container {
    max-width: 1200px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 60px;
    align-items: center;
  }

  .relaunch-features__heading {
    font-size: 36px;
    font-weight: 400;
    color: {{ section.settings.heading_color }};
    margin: 0 0 16px;
    line-height: 1.2;
  }

  .relaunch-features__heading em {
    font-family: Georgia, 'Times New Roman', serif;
    font-style: italic;
    color: {{ section.settings.accent_color }};
  }

  .relaunch-features__intro {
    font-size: 14px;
    line-height: 1.7;
    color: {{ section.settings.intro_color }};
    margin: 0 0 24px;
  }

  .relaunch-features__items {
    display: flex;
    flex-direction: column;
    gap: 0;
    margin-bottom: 24px;
  }

  .relaunch-features__item {
    display: flex;
    align-items: flex-start;
    gap: 16px;
    padding: 16px 20px;
    background: {{ section.settings.item_bg }};
    border-left: 3px solid {{ section.settings.accent_color }};
    border-radius: 8px;
    margin-bottom: 8px;
  }

  .relaunch-features__icon {
    flex-shrink: 0;
    width: 40px;
    height: 40px;
  }

  .relaunch-features__icon img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    border-radius: 8px;
  }

  .relaunch-features__item-content {
    flex: 1;
  }

  .relaunch-features__item-title {
    font-size: 15px;
    font-weight: 700;
    color: {{ section.settings.item_title_color }};
    margin: 0 0 4px;
  }

  .relaunch-features__item-text {
    font-size: 14px;
    line-height: 1.6;
    color: {{ section.settings.item_text_color }};
    margin: 0;
  }

  .relaunch-features__callout {
    border-left: 4px solid;
    border-radius: 8px;
    padding: 16px 20px;
  }

  .relaunch-features__callout p {
    font-size: 14px;
    line-height: 1.6;
    color: {{ section.settings.callout_text_color }};
    margin: 0;
  }

  .relaunch-features__image img {
    width: 100%;
    height: auto;
    border-radius: 16px;
    display: block;
  }

  @media (max-width: 900px) {
    .relaunch-features__container {
      grid-template-columns: 1fr;
      gap: 30px;
    }

    .relaunch-features__image {
      order: -1;
    }
  }

  @media (max-width: 500px) {
    .relaunch-features__heading {
      font-size: 28px;
    }
  }
</style>

{% schema %}
{
  "name": "Relaunch Features",
  "settings": [
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent Color",
      "default": "#5a9e9e"
    },
    {
      "type": "color",
      "id": "item_bg",
      "label": "Feature Item Background",
      "default": "#f7f3ee"
    },
    {
      "type": "header",
      "content": "Text colors"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading Color",
      "default": "#56473A"
    },
    {
      "type": "color",
      "id": "intro_color",
      "label": "Intro Text Color",
      "default": "#56473A"
    },
    {
      "type": "color",
      "id": "item_title_color",
      "label": "Feature Title Color",
      "default": "#56473A"
    },
    {
      "type": "color",
      "id": "item_text_color",
      "label": "Feature Text Color",
      "default": "#56473A"
    },
    {
      "type": "color",
      "id": "callout_text_color",
      "label": "Callout Text Color",
      "default": "#56473A"
    },
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Noch mehr Abwechslung –"
    },
    {
      "type": "text",
      "id": "heading_italic",
      "label": "Heading (italic part)",
      "default": "auf Deinen Wunsch."
    },
    {
      "type": "textarea",
      "id": "intro_text",
      "label": "Intro Text",
      "default": "Du hast uns immer wieder geschrieben: „Ich habe so viele Dosen gleichzeitig offen.\" Wir haben zugehört."
    },
    {
      "type": "text",
      "id": "callout_bold",
      "label": "Callout Bold Text",
      "default": "Gleicher Geschmack, gleiche Qualität."
    },
    {
      "type": "text",
      "id": "callout_text",
      "label": "Callout Text",
      "default": "Die Rezeptur des Complete Shake bleibt unverändert – nur die Packungsgröße wird kleiner und die Auswahl größer."
    },
    {
      "type": "color",
      "id": "callout_bg",
      "label": "Callout Background",
      "default": "#eef6f6"
    },
    {
      "type": "header",
      "content": "Image"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "text",
      "id": "image_alt",
      "label": "Image Alt Text",
      "default": "Complete Shake Sorten"
    }
  ],
  "blocks": [
    {
      "type": "feature",
      "name": "Feature",
      "settings": [
        {
          "type": "image_picker",
          "id": "icon",
          "label": "Icon Image"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Kleinere Einheiten"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Text",
          "default": "Der Complete Shake kommt jetzt in 18 Portionen statt 24."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Relaunch Features",
      "blocks": [
        { "type": "feature", "settings": { "title": "Kleinere Einheiten", "text": "Der Complete Shake kommt jetzt in 18 Portionen statt 24. So hast Du weniger Dosen gleichzeitig offen und kannst öfter die Sorte wechseln." } },
        { "type": "feature", "settings": { "title": "Mehr Special Editions", "text": "Dank kleinerer Einheiten können wir häufiger neue Sorten und limitierte Special Editions anbieten – für mehr Abwechslung in Deinem Alltag." } },
        { "type": "feature", "settings": { "title": "Auf Deinen Wunsch", "text": "Diese Änderung kommt direkt aus unserer Community. Viele haben sich genau das gewünscht – und wir haben es umgesetzt." } }
      ]
    }
  ]
}
{% endschema %}