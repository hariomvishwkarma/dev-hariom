{%- comment -%}
  Knowledge Base category page — recreates HubSpot's `hs-kb-content-wrapper--sidebar`.

  Two-column shell:
    .kb-content  — category listing (h1 + intro + direct articles) followed by
                   one anchored section per subcategory (h2 + its articles)
    .kb-sidebar  — the full-tree accordion nav (kb-sidebar snippet)

  Runs on the `knowledgebase_categories` metaobject template, where the current
  entry is the global `metaobject`.
{%- endcomment -%}

{{ 'knowledgebase.css' | asset_url | stylesheet_tag }}
<script src="{{ 'knowledgebase.js' | asset_url }}" defer="defer"></script>

<div class="container kb-page">
  <div class="kb-layout">
    <div class="kb-content">
      <section class="kb-category" id="{{ metaobject.system.handle }}">
        <{{ section.settings.category_html_tag }} class="heading {{ section.settings.category_html_style }} kb-category__title">{{ metaobject.title }}</{{- section.settings.category_html_tag -}}>

        {%- if metaobject.intro_text != blank -%}
          <div class="rte kb-category__intro">{{ metaobject.intro_text }}</div>
        {%- endif -%}

        {%- assign direct_articles = metaobject.questions.value -%}
        {%- render 'kb-article-list',
          articles: direct_articles,
          id: metaobject.system.handle,
          limit: section.settings.articles_before_collapse
        -%}
      </section>

      {%- for sub in metaobject.subcategories.value -%}
        <section class="kb-subcategory" id="{{ sub.system.handle }}">
          <{{ section.settings.subcategory_html_tag }} class="heading {{ section.settings.subcategory_html_style }} kb-subcategory__title">{{ sub.title }}</{{- section.settings.subcategory_html_tag -}}>
          {%- render 'kb-article-list',
            articles: sub.faqs.value,
            id: sub.system.handle,
            limit: section.settings.articles_before_collapse
          -%}
        </section>
      {%- endfor -%}
    </div>

    <aside class="kb-sidebar">
      {%- render 'kb-sidebar', current_handle: metaobject.system.handle -%}
    </aside>
  </div>
</div>

{% schema %}
{
  "name": "KB Category",
  "tag": "section",
  "class": "shopify-section--kb-category",
  "settings": [
    {
      "type": "range",
      "id": "articles_before_collapse",
      "label": "Articles shown before \"Show more\"",
      "min": 3,
      "max": 15,
      "step": 1,
      "default": 5
    },
    {
      "type": "select",
      "id": "category_html_tag",
      "label": "Category headingHTML tag",
      "options": [
        { "value": "h1", "label": "H1" },
        { "value": "h2", "label": "H2" },
        { "value": "h3", "label": "H3" },
        { "value": "h4", "label": "H4" },
        { "value": "h5", "label": "H5" },
        { "value": "div", "label": "Div" },
        { "value": "p", "label": "Paragraph" },
        { "value": "span", "label": "Span" }
      ],
      "default": "div"
    },
    {
      "type": "select",
      "id": "category_html_style",
      "label": "Category heading HTML style",
      "options": [
        { "value": "h1", "label": "H1" },
        { "value": "h2", "label": "H2" },
        { "value": "h3", "label": "H3" },
        { "value": "h4", "label": "H4" },
        { "value": "h5", "label": "H5" }
      ],
      "default": "h2"
    },
    {
      "type": "select",
      "id": "subcategory_html_tag",
      "label": "Subcategory heading HTML tag",
      "options": [
        { "value": "h1", "label": "H1" },
        { "value": "h2", "label": "H2" },
        { "value": "h3", "label": "H3" },
        { "value": "h4", "label": "H4" },
        { "value": "h5", "label": "H5" },
        { "value": "div", "label": "Div" },
        { "value": "p", "label": "Paragraph" },
        { "value": "span", "label": "Span" }
      ],
      "default": "div"
    },
    {
      "type": "select",
      "id": "subcategory_html_style",
      "label": "Subcategory heading HTML style",
      "options": [
        { "value": "h1", "label": "H1" },
        { "value": "h2", "label": "H2" },
        { "value": "h3", "label": "H3" },
        { "value": "h4", "label": "H4" },
        { "value": "h5", "label": "H5" }
      ],
      "default": "h4"
    }
  ],
  "presets": [
    { "name": "KB Category" }
  ]
}
{% endschema %}
