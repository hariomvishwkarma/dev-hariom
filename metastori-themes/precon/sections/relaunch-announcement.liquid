{% comment %}
  Section: New Packaging Announcement
{% endcomment %}

<section class="packaging-announcement">
  <div class="packaging-announcement__container">
    <span class="packaging-announcement__badge" style="
      background-color: {{ section.settings.badge_bg_color }};
      color: {{ section.settings.badge_text_color }};
      border-color: {{ section.settings.badge_border_color }};
    ">{{ section.settings.badge_text }}</span>
    
    <h2 class="packaging-announcement__heading">
      {{ section.settings.heading }} <em>{{ section.settings.heading_italic }}</em>
    </h2>
    
    <p class="packaging-announcement__description">{{ section.settings.description }}</p>
    
    {% if section.settings.quote != blank %}
      <blockquote class="packaging-announcement__quote">
        <p>{{ section.settings.quote }}</p>
      </blockquote>
    {% endif %}

    <div class="packaging-announcement__cards">
      {% for block in section.blocks %}
        <div class="packaging-announcement__card" {{ block.shopify_attributes }}>
          <span class="packaging-announcement__card-number">{{ block.settings.number }}</span>
          <div class="packaging-announcement__card-divider"></div>
          <h3 class="packaging-announcement__card-title">{{ block.settings.title }}</h3>
          <p class="packaging-announcement__card-subtitle">{{ block.settings.subtitle }}</p>
          <p class="packaging-announcement__card-text">{{ block.settings.text }}</p>
        </div>
      {% endfor %}
    </div>
  </div>
</section>

<style>
  .packaging-announcement {
    background-color: {{ section.settings.bg_color }};
    padding: 60px 20px;
    text-align: center;
  }

  .packaging-announcement__container {
    max-width: 1200px;
    margin: 0 auto;
  }

  .packaging-announcement__badge {
    display: inline-block;
    font-size: 11px;
    letter-spacing: 2px;
    text-transform: uppercase;
    border: 1px solid;
    border-radius: 20px;
    padding: 8px 20px;
    margin-bottom: 24px;
    font-weight: 500;
  }

  .packaging-announcement__heading {
    font-size: 36px;
    font-weight: 400;
    color: {{ section.settings.heading_color }};
    margin: 0 0 16px;
  }

  .packaging-announcement__heading em {
    font-family: Georgia, 'Times New Roman', serif;
    font-style: italic;
    color: {{ section.settings.accent_color }};
  }

  .packaging-announcement__description {
    max-width: 700px;
    margin: 0 auto 30px;
    font-size: 15px;
    line-height: 1.6;
    color: {{ section.settings.description_color }};
  }

  .packaging-announcement__quote {
    max-width: 600px;
    margin: 0 auto 50px;
    padding-left: 20px;
    border-left: 3px solid {{ section.settings.accent_color }};
    text-align: left;
  }

  .packaging-announcement__quote p {
    font-size: 15px;
    font-weight: 600;
    line-height: 1.6;
    color: {{ section.settings.quote_color }};
    margin: 0;
  }

  .packaging-announcement__cards {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
    margin-top: 20px;
  }

  .packaging-announcement__card {
    background: #fff;
    border-radius: 12px;
    padding: 30px 24px;
    text-align: left;
    box-shadow: 0 1px 4px rgba(0, 0, 0, 0.04);
  }

  .packaging-announcement__card-number {
    font-size: 32px;
    font-weight: 300;
    color: {{ section.settings.card_number_color }};
    display: block;
    margin-bottom: 12px;
  }

  .packaging-announcement__card-divider {
    width: 30px;
    height: 3px;
    background-color: {{ section.settings.accent_color }};
    margin-bottom: 16px;
  }

  .packaging-announcement__card-title {
    font-size: 16px;
    font-weight: 700;
    color: {{ section.settings.card_title_color }};
    margin: 0 0 4px;
  }

  .packaging-announcement__card-subtitle {
    font-size: 14px;
    font-style: italic;
    color: {{ section.settings.accent_color }};
    margin: 0 0 12px;
  }

  .packaging-announcement__card-text {
    font-size: 14px;
    line-height: 1.6;
    color: {{ section.settings.card_text_color }};
    margin: 0;
  }

  @media (max-width: 900px) {
    .packaging-announcement__cards {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 500px) {
    .packaging-announcement__cards {
      grid-template-columns: 1fr;
    }
    .packaging-announcement__heading {
      font-size: 28px;
    }
  }
</style>

