<div
  class="pro-related-div collection-grid-second homeproduct"
  style="background:{{ section.settings.background_product }}"
>
  <div class="container">
    {%- comment -%}
      Tabs Navigation
    {%- endcomment -%}
    <h2 class="heading homeprodt-title">{{ section.settings.productbox }}</h2>
    <div class="mainproductbox">
      <ul class="collection-tabs">
        {% for block in section.blocks %}
          {% assign current_collection = collections[block.settings.collection] %}
          {% if current_collection != blank %}
            <li class="collection-tab{% if forloop.first %} active{% endif %}" data-tab="tab-{{ block.id }}">
              {{ current_collection.title }}
            </li>
          {% endif %}
        {% endfor %}
      </ul>
      <div class="allproducturl">
        <a href="{{ section.settings.Productliknk }}">{{ section.settings.Producttext }}</a>
      </div>
    </div>

    {%- comment -%}
      Tabs Content
    {%- endcomment -%}
    {% for block in section.blocks %}
      {% assign current_collection = collections[block.settings.collection] %}
      {% if current_collection != blank %}
        <div class="tab-content{% if forloop.first %} active{% endif %}" id="tab-{{ block.id }}">
          <div class="mainproduct-related collection-related" style="margin-left: 0; margin-right: 0;">
            {% assign custom_products = current_collection.metafields.custom.product_grid_second.value %}
            {% if custom_products != blank %}
              {% assign products_to_show = custom_products %}
            {% else %}
              {% assign products_to_show = current_collection.products %}
            {% endif %}

            {% for related_product in products_to_show limit: section.settings.recommendations_count %}
              {% unless related_product.metafields.custom.is_hidden == 1 %}
                {%- comment -%}
                  ===== Your Original Product Design =====
                {%- endcomment -%}
                {% render "product-item-new" , related_product: related_product%}
              {% endunless %}
            {% endfor %}
          </div>
        </div>
      {% endif %}
    {% endfor %}
  </div>
  <div class="allproducturl allproducturlmob " style="display:none;">
    <a href="{{ section.settings.Productliknk }}">{{ section.settings.Producttext }}</a>
  </div>
</div>
<style>
      ul.collection-tabs li {
      display: inline-block;
      font-size: 20px;
      font-style: italic;
      font-weight: 600;
      line-height: 24px;
      padding:4px 8px;
      margin-right:15px;
      cursor: pointer;
      color: #290907;
  }
  li.collection-tab.active {
      border-radius: 30px;
      border: 1px solid #290907;
  }
  .mainproductbox {
      padding: 32px 0;
      border-bottom: 2px solid #290907;
      margin-bottom: 32px;
      display: flex;
      justify-content: space-between;
      align-items: center;
      justify-items: stretch;
  }
  ul.collection-tabs {
      margin-bottom: 0;
      padding-left: 0;
  }
  .allproducturl {
      font-size: 16px;
      font-style: normal;
      font-weight: 500;
      line-height: 24px;
      color: #3DADBB;
      border: 1px solid #3DADBB;
      padding: 4px 12px;
      border-radius: 30px;
  }
  .pro-related-div.collection-grid-second.homeproduct {
      padding: 50px 0;
  }
  h2.homeprodt-title {
      font-size: 36px;
      font-style: normal;
      font-weight: 500;
      line-height: normal;
      margin-bottom: 0;
      color:#290907;
  }

  @media only screen and (max-width: 767px) {
  .allproducturl {
      display: none;
  }
      .allproducturlmob {
          display: table !important;
          margin: 32px auto 0 auto;
          text-align: center;
      }
      h2.homeprodt-title {
      font-size: 32px;
      }

  }
</style>
<script>
  document.addEventListener('DOMContentLoaded', function () {
    document.querySelectorAll('.collection-tab').forEach(function (tab) {
      tab.addEventListener('click', function () {
        // Remove active classes
        document.querySelectorAll('.collection-tab').forEach((t) => t.classList.remove('active'));
        document.querySelectorAll('.tab-content').forEach((c) => c.classList.remove('active'));

        // Add active to clicked tab and related content
        tab.classList.add('active');
        document.getElementById(tab.dataset.tab).classList.add('active');
      });
    });
  });
</script>
{% schema %}
{
  "name": "Collection Product Tabs",
  "settings": [
    {
      "type": "range",
      "id": "recommendations_count",
      "label": "Products per tab",
      "min": 2,
      "max": 99,
      "step": 1,
      "default": 12
    },
    {
      "type": "color",
      "id": "background_product",
      "label": "Background color",
      "default": "#ffffff"
    },
    {
      "type": "text",
      "id": "productbox",
      "label": "Title",
      "default": "Product Box"
    },
    {
      "type": "text",
      "id": "Producttext",
      "label": "all Product Text",
      "default": "Product Box"
    },
    {
      "type": "url",
      "id": "Productliknk",
      "label": "all Product link"
    }
  ],
  "blocks": [
    {
      "type": "collection_tab",
      "name": "Collection Tab",
      "settings": [
        {
          "type": "collection",
          "id": "collection",
          "label": "Select Collection"
        }
      ]
    }
  ],
  "max_blocks": 10,
  "presets": [
    {
      "name": "Collection Product Tabs",
      "category": "Collection",
      "blocks": [{ "type": "collection_tab" }, { "type": "collection_tab" }]
    }
  ]
}
{% endschema %}
