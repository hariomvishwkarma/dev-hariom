{% comment %}
  Section: Relaunch Pricing
{% endcomment %}
<section class="relaunch-pricing" style="background-color: {{ section.settings.bg_color }};">
<div class="relaunch-pricing__outer">
<div class="relaunch-pricing__container">
<div class="relaunch-pricing__left">
<span class="relaunch-pricing__badge" style="background-color: {{ section.settings.badge_bg_color }}; color: {{ section.settings.badge_text_color }}; border-color: {{ section.settings.badge_text_color }};">{{ section.settings.badge_text }}</span>
<h2 class="relaunch-pricing__heading">
<em>{{ section.settings.heading_italic }}</em>
{{ section.settings.heading }}
</h2>
{% if section.settings.tagline != blank %}
<blockquote class="relaunch-pricing__tagline">
<p>{{ section.settings.tagline }}</p>
</blockquote>
{% endif %}
<div class="relaunch-pricing__body">{{ section.settings.body_text }}</div>
<div class="relaunch-pricing__stats">
{% for block in section.blocks %}
{% if block.type == 'stat' %}
<div class="relaunch-pricing__stat" {{ block.shopify_attributes }}>
<span class="relaunch-pricing__stat-number" style="color: {{ section.settings.accent_color }};">{{ block.settings.number }}</span>
<span class="relaunch-pricing__stat-label">{{ block.settings.label }}</span>
</div>
{% endif %}
{% endfor %}
</div>
{% if section.settings.callout_text != blank %}
<div class="relaunch-pricing__callout" style="background-color: {{ section.settings.callout_bg }}; border-left-color: {{ section.settings.accent_color }};">
<p><strong style="color: {{ section.settings.accent_color }};">{{ section.settings.callout_bold }}</strong> {{ section.settings.callout_text }}</p>
</div>
{% endif %}
</div>
<div class="relaunch-pricing__right">
{% if section.settings.image != blank %}
<div class="relaunch-pricing__image">
<img
src="{{ section.settings.image | image_url: width: 600 }}"
alt="{{ section.settings.image_alt }}"
loading="lazy"
width="600"
>
</div>
{% endif %}
{% if section.settings.sidebar_title != blank %}
<div class="relaunch-pricing__sidebar">
<h4 class="relaunch-pricing__sidebar-title" style="color: {{ section.settings.accent_color }};">{{ section.settings.sidebar_title }}</h4>
<ul class="relaunch-pricing__sidebar-list">
{% for block in section.blocks %}
{% if block.type == 'reason' %}
<li {{ block.shopify_attributes }}>
{% if block.settings.icon != blank %}
<span class="relaunch-pricing__sidebar-icon">{{ block.settings.icon }}</span>
{% endif %}
{{ block.settings.text }}
</li>
{% endif %}
{% endfor %}
</ul>
</div>
{% endif %}
</div>
</div>
{% if section.settings.table_title != blank %}
<h3 class="relaunch-pricing__table-title">{{ section.settings.table_title }}</h3>
{% endif %}
{% if section.settings.table_subtitle != blank %}
<p class="relaunch-pricing__table-subtitle" style="color: {{ section.settings.disclaimer_color }};">{{ section.settings.table_subtitle }}</p>
{% endif %}
<div class="relaunch-pricing__scroll-hint">
<span class="relaunch-pricing__scroll-hint-text">Wischen zum Scrollen</span>
<span class="relaunch-pricing__scroll-hint-arrow">&rarr;</span>
</div>
<div class="relaunch-pricing__table-wrap">
<table class="relaunch-pricing__table">
<thead>
<tr style="background-color: {{ section.settings.table_header_bg }};">
<th style="color: {{ section.settings.table_header_text }};">{{ section.settings.th_1 }}</th>
<th style="color: {{ section.settings.table_header_text }};">{{ section.settings.th_2 }}</th>
<th style="color: {{ section.settings.table_header_text }};">{{ section.settings.th_3 }}</th>
<th style="color: {{ section.settings.table_header_text }};">{{ section.settings.th_4b }}</th>
<th style="color: {{ section.settings.table_header_text }};">{{ section.settings.th_4 }}</th>
<th style="color: {{ section.settings.table_header_text }};">{{ section.settings.th_5 }}</th>
</tr>
</thead>
<tbody>
{% for block in section.blocks %}
{% if block.type == 'price_row' %}
<tr {{ block.shopify_attributes }}>
<td><strong>{{ block.settings.category }}</strong></td>
<td><s>{{ block.settings.old_price }}</s></td>
<td><strong>{{ block.settings.new_price }}</strong></td>
<td><s>{{ block.settings.per_portion_old }}</s></td>
<td><span class="relaunch-pricing__highlight" style="color: {{ section.settings.accent_color }};">{{ block.settings.per_portion }}</span></td>
<td>{{ block.settings.date }}</td>
</tr>
{% endif %}
{% endfor %}
</tbody>
</table>
</div>
{% if section.settings.disclaimer_text != blank %}
<p class="relaunch-pricing__disclaimer" style="color: {{ section.settings.disclaimer_color }};">{{ section.settings.disclaimer_text }}</p>
{% endif %}
</div>
</section>
<style>
.relaunch-pricing {
padding: 60px 20px;
  }
.relaunch-pricing__outer {
max-width: 1200px;
margin: 0 auto;
  }
.relaunch-pricing__container {
display: grid;
grid-template-columns: 1.2fr 0.8fr;
gap: 50px;
align-items: start;
  }
.relaunch-pricing__left {
overflow-wrap: break-word;
word-wrap: break-word;
min-width: 0;
  }
.relaunch-pricing__right {
min-width: 0;
  }
.relaunch-pricing__badge {
display: inline-block;
font-size: 11px;
letter-spacing: 2px;
text-transform: uppercase;
border: 1px solid;
border-radius: 20px;
padding: 8px 20px;
margin-bottom: 20px;
font-weight: 500;
  }
.relaunch-pricing__heading {
font-size: 36px;
font-weight: 400;
color: {{ section.settings.heading_color }};
margin: 0 0 20px;
line-height: 1.2;
  }
.relaunch-pricing__heading em {
display: block;
font-family: Georgia, 'Times New Roman', serif;
font-style: italic;
color: {{ section.settings.accent_color }};
  }
.relaunch-pricing__tagline {
padding-left: 16px;
border-left: 3px solid {{ section.settings.accent_color }};
margin: 0 0 20px;
  }
.relaunch-pricing__tagline p {
font-size: 15px;
font-weight: 600;
color: {{ section.settings.tagline_color }};
margin: 0;
  }
.relaunch-pricing__body {
font-size: 14px;
line-height: 1.7;
color: {{ section.settings.body_text_color }};
margin-bottom: 24px;
  }
.relaunch-pricing__stats {
display: grid;
grid-template-columns: repeat(2, 1fr);
gap: 16px;
margin-bottom: 24px;
  }
.relaunch-pricing__stat {
background: #fff;
border-radius: 10px;
padding: 20px;
text-align: center;
box-shadow: 0 1px 4px rgba(0, 0, 0, 0.04);
  }
.relaunch-pricing__stat-number {
display: block;
font-size: 32px;
font-weight: 300;
font-family: Georgia, 'Times New Roman', serif;
font-style: italic;
margin-bottom: 4px;
  }
.relaunch-pricing__stat-label {
font-size: 13px;
color: {{ section.settings.stat_label_color }};
  }
.relaunch-pricing__callout {
border-left: 4px solid;
border-radius: 8px;
padding: 16px 20px;
margin-bottom: 0;
  }
.relaunch-pricing__callout p {
font-size: 14px;
line-height: 1.6;
color: {{ section.settings.callout_text_color }};
margin: 0;
  }
.relaunch-pricing__table-title {
font-size: 16px;
font-weight: 600;
color: {{ section.settings.heading_color }};
margin: 40px 0 6px;
  }
.relaunch-pricing__table-subtitle {
font-size: 13px;
line-height: 1.5;
margin: 0 0 12px;
  }
.relaunch-pricing__scroll-hint {
display: none;
  }
.relaunch-pricing__table-wrap {
overflow-x: auto;
-webkit-overflow-scrolling: touch;
  }
.relaunch-pricing__table {
width: 100%;
border-collapse: separate;
border-spacing: 0;
border-radius: 12px;
overflow: hidden;
box-shadow: 0 1px 4px rgba(0, 0, 0, 0.06);
  }
.relaunch-pricing__table thead th {
text-align: left;
font-size: 11px;
letter-spacing: 1px;
padding: 14px 12px;
font-weight: 600;
white-space: nowrap;
  }
.relaunch-pricing__table tbody tr {
background: {{ section.settings.table_row_odd }};
border-bottom: 1px solid #f0ece6;
  }
.relaunch-pricing__table tbody tr:nth-child(even) {
background: {{ section.settings.table_row_even }};
  }
.relaunch-pricing__table tbody td {
padding: 12px;
font-size: 14px;
color: {{ section.settings.table_text_color }};
text-align: left;
white-space: nowrap;
  }
.relaunch-pricing__table tbody td s {
color: {{ section.settings.table_strikethrough_color }};
text-decoration: line-through;
  }
.relaunch-pricing__highlight {
font-weight: 700;
  }
.relaunch-pricing__disclaimer {
font-size: 12px;
line-height: 1.5;
margin: 12px 0 0;
  }
.relaunch-pricing__image {
margin-bottom: 24px;
  }
.relaunch-pricing__image img {
width: 100%;
height: auto;
border-radius: 16px;
display: block;
  }
.relaunch-pricing__sidebar {
background: #fff;
border-radius: 12px;
padding: 24px;
box-shadow: 0 1px 4px rgba(0, 0, 0, 0.04);
  }
.relaunch-pricing__sidebar-title {
font-size: 11px;
letter-spacing: 2px;
text-transform: uppercase;
margin: 0 0 16px;
font-weight: 600;
  }
.relaunch-pricing__sidebar-list {
list-style: none;
padding: 0;
margin: 0;
  }
.relaunch-pricing__sidebar-list li {
font-size: 14px;
color: {{ section.settings.sidebar_text_color }};
padding: 10px 0;
border-top: 1px solid #f0ece6;
display: flex;
align-items: center;
gap: 10px;
  }
.relaunch-pricing__sidebar-list li:first-child {
border-top: none;
  }
.relaunch-pricing__sidebar-icon {
font-size: 18px;
flex-shrink: 0;
  }
@media (max-width: 900px) {
.relaunch-pricing__container {
grid-template-columns: 1fr;
gap: 30px;
    }
  }
@media (max-width: 500px) {
.relaunch-pricing {
padding: 40px 12px;
overflow-x: hidden;
    }
.relaunch-pricing__heading {
font-size: 24px;
    }
.relaunch-pricing__tagline p {
font-size: 13px;
    }
.relaunch-pricing__body {
font-size: 13px;
    }
.relaunch-pricing__stats {
grid-template-columns: 1fr;
    }
.relaunch-pricing__badge {
font-size: 10px;
padding: 6px 14px;
letter-spacing: 1px;
    }
.relaunch-pricing__callout {
padding: 12px 16px;
    }
.relaunch-pricing__callout p {
font-size: 13px;
    }
.relaunch-pricing__image {
display: none;
    }
.relaunch-pricing__sidebar {
padding: 16px;
    }
.relaunch-pricing__sidebar-list li {
font-size: 13px;
    }
.relaunch-pricing__table-title {
font-size: 14px;
    }
.relaunch-pricing__disclaimer {
font-size: 11px;
    }
.relaunch-pricing__scroll-hint {
display: flex;
align-items: center;
gap: 6px;
font-size: 12px;
color: {{ section.settings.accent_color }};
margin-bottom: 8px;
    }
.relaunch-pricing__scroll-hint-arrow {
display: inline-block;
animation: relaunch-pricing-nudge 1.5s ease-in-out infinite;
    }
@keyframes relaunch-pricing-nudge {
0%, 100% { transform: translateX(0); }
50% { transform: translateX(6px); }
    }
.relaunch-pricing__table thead th,
.relaunch-pricing__table tbody td {
padding: 8px 6px;
font-size: 11px;
    }
  }
</style>
{% schema %}
{
"name": "Relaunch Pricing",
"settings": [
    {"type": "color","id": "bg_color","label": "Background Color","default": "#f7f3ee"},
    {"type": "color","id": "accent_color","label": "Accent Color","default": "#5a9e9e"},
    {"type": "header","content": "Badge"},
    {"type": "text","id": "badge_text","label": "Badge Text","default": "ÄNDERUNG 3 VON 4"},
    {"type": "color","id": "badge_bg_color","label": "Badge Background","default": "#ddeeed"},
    {"type": "color","id": "badge_text_color","label": "Badge Text Color","default": "#5a9e9e"},
    {"type": "header","content": "Text colors"},
    {"type": "color","id": "heading_color","label": "Heading Color","default": "#56473A"},
    {"type": "color","id": "tagline_color","label": "Tagline Color","default": "#56473A"},
    {"type": "color","id": "body_text_color","label": "Body Text Color","default": "#56473A"},
    {"type": "color","id": "stat_label_color","label": "Stat Label Color","default": "#56473A"},
    {"type": "color","id": "callout_text_color","label": "Callout Text Color","default": "#56473A"},
    {"type": "color","id": "table_text_color","label": "Table Text Color","default": "#56473A"},
    {"type": "color","id": "table_strikethrough_color","label": "Table Strikethrough Color","default": "#999999"},
    {"type": "color","id": "sidebar_text_color","label": "Sidebar Text Color","default": "#56473A"},
    {"type": "header","content": "Content"},
    {"type": "text","id": "heading_italic","label": "Heading Italic Line","default": "Fair is Fair –"},
    {"type": "text","id": "heading","label": "Heading","default": "Unsere Preisanpassung."},
    {"type": "text","id": "tagline","label": "Tagline","default": "Über 10 Jahre keine Preiserhöhung. Jetzt müssen wir ehrlich sein."},
    {"type": "richtext","id": "body_text","label": "Body Text","default": "<p>Wir sind stolz darauf, dass wir unsere Preise über <strong>10 Jahre lang stabil</strong> gehalten haben.</p>"},
    {"type": "text","id": "callout_bold","label": "Callout Bold Text","default": "Unser Versprechen:"},
    {"type": "text","id": "callout_text","label": "Callout Text","default": "Die Preisanpassung ist notwendig – aber wir bleiben fair."},
    {"type": "color","id": "callout_bg","label": "Callout Background","default": "#eef6f6"},
    {"type": "header","content": "Table"},
    {"type": "text","id": "table_title","label": "Table Title","default": "Neue Preise im Überblick"},
    {"type": "textarea","id": "table_subtitle","label": "Table Subtitle (under title)","default": "Um die Preise richtig einzuordnen, empfehlen wir den Vergleich auf Basis der einzelnen Portion. So lässt sich am besten beurteilen, was eine Mahlzeit tatsächlich kostet."},
    {"type": "text","id": "th_1","label": "Table Header 1","default": "Kategorie"},
    {"type": "text","id": "th_2","label": "Table Header 2","default": "Alt"},
    {"type": "text","id": "th_3","label": "Table Header 3","default": "Neu"},
    {"type": "text","id": "th_4b","label": "Table Header 4b","default": "Preis/Portion alt"},
    {"type": "text","id": "th_4","label": "Table Header 4","default": "Preis/Portion"},
    {"type": "text","id": "th_5","label": "Table Header 5","default": "Ab"},
    {"type": "color","id": "table_header_bg","label": "Table Header Background","default": "#6b4c3b"},
    {"type": "color","id": "table_header_text","label": "Table Header Text Color","default": "#ffffff"},
    {"type": "color","id": "table_row_odd","label": "Table Row Odd Background","default": "#ffffff"},
    {"type": "color","id": "table_row_even","label": "Table Row Even Background","default": "#faf8f5"},
    {"type": "header","content": "Disclaimer"},
    {"type": "textarea","id": "disclaimer_text","label": "Disclaimer Text","default": "Alle Preise inkl. MwSt. Preisänderungen vorbehalten. Stand: Juli 2025."},
    {"type": "color","id": "disclaimer_color","label": "Disclaimer Text Color","default": "#999999"},
    {"type": "header","content": "Sidebar"},
    {"type": "image_picker","id": "image","label": "Image"},
    {"type": "text","id": "image_alt","label": "Image Alt Text","default": "Fair is Fair Illustration"},
    {"type": "text","id": "sidebar_title","label": "Sidebar Title","default": "WARUM JETZT?"}
  ],
"blocks": [
    {"type": "stat","name": "Stat Card","settings": [{"type": "text","id": "number","label": "Number","default": "10+"},{"type": "text","id": "label","label": "Label","default": "Jahre ohne Preiserhöhung"}]},
    {"type": "price_row","name": "Price Row","settings": [{"type": "text","id": "category","label": "Category","default": "Shake"},{"type": "text","id": "old_price","label": "Old Price","default": "46,60 €"},{"type": "text","id": "new_price","label": "New Price","default": "39,50 €"},{"type": "text","id": "per_portion_old","label": "Price per Portion Old","default": "2,59 €"},{"type": "text","id": "per_portion","label": "Price per Portion","default": "2,19 €"},{"type": "text","id": "date","label": "Date","default": "1. August"}]},
    {"type": "reason","name": "Reason","settings": [{"type": "text","id": "icon","label": "Emoji Icon","default": "🌾"},{"type": "text","id": "text","label": "Text","default": "Rohstoffpreise deutlich gestiegen"}]}
  ],
"presets": [{"name": "Relaunch Pricing"}]
}
{% endschema %}