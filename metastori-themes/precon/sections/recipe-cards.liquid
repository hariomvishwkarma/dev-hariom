<section class="idtabs" id="idtabs-{{ section.id }}">
  <div class="idtabs__inner page-width">

    <!-- ── Intro ── -->
    {%- if section.settings.eyebrow != blank or section.settings.heading != blank -%}
      <div class="idtabs__intro">
        {%- if section.settings.eyebrow != blank -%}
          <p class="idtabs__eyebrow" style="color: {{ section.settings.eyebrow_color }};">{{ section.settings.eyebrow }}</p>
        {%- endif -%}
        {%- if section.settings.heading != blank -%}
          <h2 class="idtabs__heading" style="color: {{ section.settings.heading_color }};">{{ section.settings.heading }}</h2>
        {%- endif -%}
      </div>
    {%- endif -%}

    <!-- ── Badge tabs ── -->
    {%- if section.blocks.size > 0 -%}
      <div class="idtabs__tabs" role="tablist">
        {%- for block in section.blocks -%}
          <button
            class="idtabs__tab{% if forloop.first %} is-active{% endif %}"
            role="tab"
            aria-controls="idtabs-panel-{{ section.id }}-{{ forloop.index }}"
            aria-selected="{% if forloop.first %}true{% else %}false{% endif %}"
            type="button"
            {{ block.shopify_attributes }}
          >{{ block.settings.tab_label }}</button>
        {%- endfor -%}
      </div>

      <!-- ── Panels ── -->
      <div class="idtabs__panels">
        {%- for block in section.blocks -%}
          <div
            class="idtabs__panel{% if forloop.first %} is-active{% endif %}"
            id="idtabs-panel-{{ section.id }}-{{ forloop.index }}"
            role="tabpanel"
          >
            <!-- Image -->
            <div class="idtabs__img-wrap">
              {%- if block.settings.image != blank -%}
                {{ block.settings.image | image_url: width: 1000 | image_tag:
                  class: 'idtabs__img',
                  loading: 'lazy',
                  sizes: '(max-width: 768px) 100vw, 48vw',
                  widths: '400, 700, 1000'
                }}
              {%- else -%}
                <div class="idtabs__img-placeholder">
                  <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <rect x="3" y="3" width="18" height="18" rx="2"/>
                    <circle cx="8.5" cy="8.5" r="1.5"/>
                    <polyline points="21 15 16 10 5 21"/>
                  </svg>
                  <span>Bild hinzufügen</span>
                </div>
              {%- endif -%}
            </div>

            <!-- Content -->
            <div class="idtabs__content">

              {%- if block.settings.icon_symbol != blank -%}
                <span
                  class="idtabs__icon"
                  style="background: {{ block.settings.icon_bg_color }}; color: {{ block.settings.icon_color }};"
                  aria-hidden="true"
                >{{ block.settings.icon_symbol }}</span>
              {%- endif -%}

              {%- if block.settings.title != blank -%}
                <h3 class="idtabs__title">{{ block.settings.title }}</h3>
              {%- endif -%}

              {%- if block.settings.body != blank -%}
                <div class="idtabs__body">{{ block.settings.body }}</div>
              {%- endif -%}

              {%- if block.settings.cta_label != blank and block.settings.cta_url != blank -%}
                <a
                  class="idtabs__cta"
                  href="{{ block.settings.cta_url }}"
                  style="background: {{ block.settings.cta_bg }}; color: {{ block.settings.cta_text }};"
                >{{ block.settings.cta_label }}</a>
              {%- endif -%}

            </div>
          </div>
        {%- endfor -%}
      </div>
    {%- endif -%}

  </div>
</section>

<style>
  /* ── Section ── */
  .idtabs {
    background: {{ section.settings.section_bg }};
    padding: {{ section.settings.padding_top }}px 0 {{ section.settings.padding_bottom }}px;
    font-family: 'Figtree', -apple-system, BlinkMacSystemFont, sans-serif;
  }

  .idtabs__inner {
    max-width: 1100px;
    margin: 0 auto;
    padding: 0 24px;
  }

  /* ── Intro ── */
  .idtabs__intro {
    text-align: center;
    margin-bottom: 40px;
  }

  .idtabs__eyebrow {
    font-family: 'Figtree', sans-serif;
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    margin: 0 0 14px;
  }

  .idtabs__heading {
    font-family: var(--accent-font-family);
    font-style: var(--accent-font-style);
    font-size: clamp(32px, 4vw, 54px);
    font-weight: 500;
    line-height: 1.12;
    margin: 0;
  }

  /* ── Badge tabs ── */
  .idtabs__tabs {
    display: flex;
    gap: 12px;
    justify-content: center;
    flex-wrap: wrap;
    margin-bottom: 52px;
  }

  .idtabs__tab {
    font-family: 'Figtree', sans-serif;
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.04em;
    padding: 11px 28px;
    border-radius: 50px;
    border: 1.5px solid {{ section.settings.tab_border_inactive }};
    background: transparent;
    color: {{ section.settings.tab_text_inactive }};
    cursor: pointer;
    transition: background 0.22s ease, color 0.22s ease, border-color 0.22s ease, box-shadow 0.22s ease;
  }

  .idtabs__tab:hover:not(.is-active) {
    border-color: {{ section.settings.tab_active_bg }};
    color: {{ section.settings.tab_active_bg }};
  }

  .idtabs__tab.is-active {
    background: {{ section.settings.tab_active_bg }};
    color: {{ section.settings.tab_active_text }};
    border-color: {{ section.settings.tab_active_bg }};
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.12);
  }

  /* ── Panels ── */
  .idtabs__panel {
    display: none;
    align-items: center;
    gap: 56px;
  }

  .idtabs__panel.is-active {
    display: flex;
    animation: idtabs-in 0.35s ease;
  }

  @keyframes idtabs-in {
    from { opacity: 0; transform: translateY(8px); }
    to   { opacity: 1; transform: translateY(0); }
  }

  /* ── Image ── */
  .idtabs__img-wrap {
    flex: 0 0 48%;
    border-radius: {{ section.settings.img_radius }}px;
    overflow: hidden;
    background: {{ section.settings.placeholder_bg }};
    aspect-ratio: 4 / 3;
  }

  .idtabs__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .idtabs__img-placeholder {
    width: 100%;
    height: 100%;
    min-height: 320px;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 10px;
    color: {{ section.settings.placeholder_icon_color }};
  }

  .idtabs__img-placeholder span {
    font-size: 12px;
    opacity: 0.6;
  }

  /* ── Content ── */
  .idtabs__content {
    flex: 1;
    display: flex;
    flex-direction: column;
  }

  /* Icon badge */
  .idtabs__icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    border-radius: 12px;
    font-size: 20px;
    line-height: 1;
    margin-bottom: 20px;
    flex-shrink: 0;
  }

  /* Title: Figtree Light → large */
  .idtabs__title {
    font-family: 'Figtree', sans-serif;
    font-size: clamp(22px, 2.5vw, 30px);
    font-weight: 300;
    color: {{ section.settings.text_color }};
    line-height: 1.25;
    margin: 0 0 16px;
  }

  /* Body: Figtree Normal */
  .idtabs__body {
    font-family: 'Figtree', sans-serif;
    font-size: clamp(14px, 1.1vw, 16px);
    font-weight: 400;
    line-height: 1.75;
    color: {{ section.settings.body_color }};
    margin-bottom: 0;
  }

  .idtabs__body p {
    margin: 0 0 10px;
  }

  .idtabs__body p:last-child {
    margin-bottom: 0;
  }

  /* ── CTA button ── */
  .idtabs__cta {
    display: inline-block;
    margin-top: 20px;
    font-family: 'Figtree', sans-serif;
    font-size: 14px;
    font-weight: 600;
    letter-spacing: 0.03em;
    padding: 14px 32px;
    border-radius: 50px;
    text-decoration: none;
    transition: opacity 0.2s ease, transform 0.2s ease;
    align-self: flex-start;
  }

  .idtabs__cta:hover {
    opacity: 0.85;
    transform: translateY(-1px);
  }

  /* ── Mobile ── */
  @media (max-width: 768px) {
    .idtabs__panel.is-active {
      flex-direction: column;
      gap: 28px;
    }

    .idtabs__img-wrap {
      flex: none;
      width: 100%;
      aspect-ratio: 4 / 3;
    }

    .idtabs__intro {
      margin-bottom: 28px;
    }

    .idtabs__tabs {
      margin-bottom: 36px;
    }
  }
</style>

<script>
  (function () {
    var section = document.getElementById('idtabs-{{ section.id }}');
    if (!section) return;

    var tabs   = Array.from(section.querySelectorAll('.idtabs__tab'));
    var panels = Array.from(section.querySelectorAll('.idtabs__panel'));

    tabs.forEach(function (tab, i) {
      tab.addEventListener('click', function () {
        tabs.forEach(function (t) {
          t.classList.remove('is-active');
          t.setAttribute('aria-selected', 'false');
        });
        panels.forEach(function (p) { p.classList.remove('is-active'); });

        tab.classList.add('is-active');
        tab.setAttribute('aria-selected', 'true');
        panels[i].classList.add('is-active');
      });
    });
  })();
</script>

{% schema %}
