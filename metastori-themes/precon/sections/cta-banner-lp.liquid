{%- comment -%}
  sections/cta-banner-lp.liquid
  Zentrierter CTA-Block auf Akzentfarbe: Heading / Subtext / Pill-Button / Trust-Badges
  Eyebrow-Stil passt zu allen anderen Precon-Sections
  Fonts: Figtree 300/400/600 + Playfair Display 500 italic
{%- endcomment -%}

{%- liquid
  assign c_bg      = section.settings.color_bg
  assign c_heading = section.settings.color_heading
  assign c_sub     = section.settings.color_sub
  assign c_btn_bg  = section.settings.color_btn_bg
  assign c_btn_ink = section.settings.color_btn_ink
  assign c_badge   = section.settings.color_badge
  assign pt        = section.settings.padding_top
  assign pb        = section.settings.padding_bottom
-%}

<div id="ctab-{{ section.id }}" class="ctab" style="padding-top: {{ pt }}px; padding-bottom: {{ pb }}px;">
  <div class="ctab__inner">

    {%- if section.settings.heading != blank -%}
      <h2 class="ctab__heading">{{ section.settings.heading }}</h2>
    {%- endif -%}

    {%- if section.settings.subtext != blank -%}
      <p class="ctab__sub">{{ section.settings.subtext }}</p>
    {%- endif -%}

    {%- if section.settings.btn_label != blank -%}
      <a class="ctab__btn" href="{{ section.settings.btn_url }}">
        {{ section.settings.btn_label }}
      </a>
    {%- endif -%}

    {%- assign badges = section.blocks | where: "type", "badge" -%}
    {%- if badges.size > 0 -%}
      <div class="ctab__badges">
        {%- for block in badges -%}
          <span class="ctab__badge" {{ block.shopify_attributes }}>
            <svg class="ctab__badge-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
              {%- case block.settings.icon -%}
                {%- when 'truck' -%}
                  <rect x="1" y="3" width="15" height="13" rx="1"/><path d="M16 8h4l3 3v5h-7V8z"/><circle cx="5.5" cy="18.5" r="2.5"/><circle cx="18.5" cy="18.5" r="2.5"/>
                {%- when 'star' -%}
                  <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/>
                {%- when 'award' -%}
                  <circle cx="12" cy="8" r="6"/><path d="M15.477 12.89L17 22l-5-3-5 3 1.523-9.11"/>
                {%- when 'heart' -%}
                  <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/>
                {%- when 'shield' -%}
                  <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
                {%- when 'clock' -%}
                  <circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/>
                {%- else -%}
                  <polyline points="20 6 9 17 4 12"/>
              {%- endcase -%}
            </svg>
            {{ block.settings.text }}
          </span>
        {%- endfor -%}
      </div>
    {%- endif -%}

  </div>
</div>

<style>
@import url('https://fonts.googleapis.com/css2?family=Figtree:wght@300;400;600&family=Playfair+Display:ital,wght@1,500&display=swap');

#ctab-{{ section.id }} {
  --bg:      {{ c_bg }};
  --heading: {{ c_heading }};
  --sub:     {{ c_sub }};
  --btn-bg:  {{ c_btn_bg }};
  --btn-ink: {{ c_btn_ink }};
  --badge:   {{ c_badge }};
}

#ctab-{{ section.id }},
#ctab-{{ section.id }} * { box-sizing: border-box; }

#ctab-{{ section.id }} {
  background: var(--bg);
  font-family: 'Figtree', sans-serif;
  -webkit-font-smoothing: antialiased;
  text-align: center;
  padding-left: 1.5rem;
  padding-right: 1.5rem;
}

#ctab-{{ section.id }} .ctab__inner {
  max-width: 700px;
  margin: 0 auto;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 1.25rem;
}

/* ── Heading ── */
#ctab-{{ section.id }} .ctab__heading {
  font-family: 'Figtree', sans-serif;
  font-size: clamp(28px, 4.5vw, 52px);
  font-weight: 300;
  color: var(--heading);
  line-height: 1.08;
  letter-spacing: -0.026em;
  text-wrap: balance;
  margin: 0;
}

#ctab-{{ section.id }} .ctab__heading em {
  font-family: 'Playfair Display', serif;
  font-style: italic;
  font-weight: 500;
  letter-spacing: -0.02em;
}

/* ── Subtext ── */
#ctab-{{ section.id }} .ctab__sub {
  font-size: clamp(15px, 1.15vw, 17px);
  font-weight: 400;
  color: var(--sub);
  line-height: 1.7;
  margin: 0;
  text-wrap: balance;
}

/* ── Button ── */
#ctab-{{ section.id }} .ctab__btn {
  display: inline-flex;
  align-items: center;
  background: var(--btn-bg);
  color: var(--btn-ink);
  font-family: 'Figtree', sans-serif;
  font-size: 15px;
  font-weight: 600;
  letter-spacing: 0.01em;
  padding: 15px 32px;
  border-radius: 999px;
  text-decoration: none;
  transition: opacity 0.2s, transform 0.2s;
  white-space: nowrap;
}

#ctab-{{ section.id }} .ctab__btn:hover {
  opacity: 0.9;
  transform: translateY(-1px);
}

/* ── Badges ── */
#ctab-{{ section.id }} .ctab__badges {
  display: flex;
  flex-wrap: wrap;
  justify-content: center;
  align-items: center;
  gap: 0.75rem 2rem;
}

#ctab-{{ section.id }} .ctab__badge {
  display: flex;
  align-items: center;
  gap: 7px;
  font-size: 13px;
  font-weight: 400;
  color: var(--badge);
  line-height: 1;
}

#ctab-{{ section.id }} .ctab__badge-icon {
  flex-shrink: 0;
  opacity: 0.85;
}

/* ── Responsive ── */
@media (max-width: 560px) {
  #ctab-{{ section.id }} .ctab__heading {
    font-size: 36px;
  }
  #ctab-{{ section.id }} .ctab__btn {
    font-size: 13.5px;
    padding: 13px 22px;
    white-space: normal;
    text-align: center;
    max-width: 280px;
  }
  #ctab-{{ section.id }} {
    padding-left: 1.25rem;
    padding-right: 1.25rem;
  }
  #ctab-{{ section.id }} .ctab__badges {
    gap: 0.75rem 1.25rem;
  }
}
</style>

{% schema %}
{
  "name": "CTA Banner LP",
  "tag": "section",
  "settings": [
    { "type": "header", "content": "Inhalt" },
    {
      "type": "richtext",
      "id": "heading",
      "label": "Überschrift",
      "default": "<p>Bereit für ein Konzept, <em>das funktioniert?</em></p>"
    },
    {
      "type": "text",
      "id": "subtext",
      "label": "Subtext",
      "default": "Nicht noch ein Shake. Ein System mit Plan, Struktur und 40 Jahren Erfahrung."
    },
    { "type": "header", "content": "Button" },
    {
      "type": "text",
      "id": "btn_label",
      "label": "Button Text",
      "default": "Jetzt 4-Wochen-Paket sichern für nur CHF 149 →"
    },
    {
      "type": "url",
      "id": "btn_url",
      "label": "Button Link"
    },
    { "type": "header", "content": "Abstände" },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Abstand oben",
      "min": 0, "max": 120, "step": 4, "unit": "px", "default": 72
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Abstand unten",
      "min": 0, "max": 120, "step": 4, "unit": "px", "default": 72
    },
    { "type": "header", "content": "Farben" },
    { "type": "color", "id": "color_bg",      "label": "Hintergrund",        "default": "#3DADBB" },
    { "type": "color", "id": "color_heading", "label": "Überschrift",        "default": "#FFFFFF" },
    { "type": "color", "id": "color_sub",     "label": "Subtext",            "default": "#FFFFFF" },
    { "type": "color", "id": "color_btn_bg",  "label": "Button Hintergrund", "default": "#FFFFFF" },
    { "type": "color", "id": "color_btn_ink", "label": "Button Text",        "default": "#3DADBB" },
    { "type": "color", "id": "color_badge",   "label": "Trust-Badge Farbe",  "default": "#FFFFFF" }
  ],
  "blocks": [
    {
      "type": "badge",
      "name": "Trust-Badge",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            { "value": "truck",  "label": "Lieferwagen" },
            { "value": "star",   "label": "Stern" },
            { "value": "award",  "label": "Auszeichnung" },
            { "value": "heart",  "label": "Herz" },
            { "value": "shield", "label": "Schild" },
            { "value": "check",  "label": "Häkchen" },
            { "value": "clock",  "label": "Uhr" }
          ],
          "default": "check"
        },
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "default": "Gratis Versand"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "CTA Banner LP",
      "blocks": [
        { "type": "badge", "settings": { "icon": "truck",  "text": "Gratis Versand" } },
        { "type": "badge", "settings": { "icon": "star",   "text": "4,79/5 Sterne" } },
        { "type": "badge", "settings": { "icon": "award",  "text": "40+ Jahre Expertise" } },
        { "type": "badge", "settings": { "icon": "heart",  "text": "Made in Germany" } }
      ]
    }
  ]
}
{% endschema %}