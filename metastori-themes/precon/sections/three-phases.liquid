<section class="three-phases" id="three-phases-{{ section.id }}">
  <div class="three-phases__intro page-width">

    {%- if section.settings.badge_text != blank -%}
      <span class="three-phases__badge" style="background:{{ section.settings.badge_bg_color }}; color:{{ section.settings.badge_text_color }}; border-color:{{ section.settings.badge_border_color }};">
        {%- if section.settings.badge_emoji != blank -%}{{ section.settings.badge_emoji }} {%- endif -%}
        {{ section.settings.badge_text }}
      </span>
    {%- endif -%}

    <h2 class="three-phases__heading" style="font-weight:{{ section.settings.heading_weight }};">
      {%- if section.settings.heading_line1 != blank -%}
        <span class="three-phases__heading-line1" style="color:{{ section.settings.heading_color }};">{{ section.settings.heading_line1 }}</span>
      {%- endif -%}
      {%- if section.settings.heading_line2 != blank -%}
        <em class="three-phases__heading-line2" style="color:{{ section.settings.heading_italic_color }}; font-weight:{{ section.settings.heading_weight }};">{{ section.settings.heading_line2 }}</em>
      {%- endif -%}
    </h2>

    {%- if section.settings.subtext != blank -%}
      <p class="three-phases__subtext">{{ section.settings.subtext }}</p>
    {%- endif -%}
  </div>

  {%- if section.blocks.size > 0 -%}
    <div class="three-phases__cards page-width">
      {%- for block in section.blocks -%}
        {%- if block.type == 'phase_card' -%}
          {%- assign has_link = false -%}
          {%- if block.settings.link_url != blank -%}{%- assign has_link = true -%}{%- endif -%}

          {%- if has_link -%}
            <a
              href="{{ block.settings.link_url }}"
              class="three-phases__card three-phases__card--linked"
              style="background:{{ block.settings.card_bg_color }}; border: 1.5px solid {{ block.settings.card_border_color }};"
              {{ block.shopify_attributes }}
            >
          {%- else -%}
            <div
              class="three-phases__card"
              style="background:{{ block.settings.card_bg_color }}; border: 1.5px solid {{ block.settings.card_border_color }};"
              {{ block.shopify_attributes }}
            >
          {%- endif -%}

            <div class="three-phases__card-top">
              <div class="three-phases__card-meta">
                {%- if block.settings.duration != blank -%}
                  <span class="three-phases__card-duration" style="background:{{ block.settings.accent_color }}; color:#fff;">{{ block.settings.duration }}</span>
                {%- endif -%}
              </div>
              {%- if block.settings.emoji != blank -%}
                <span class="three-phases__card-emoji">{{ block.settings.emoji }}</span>
              {%- endif -%}
            </div>

            <h3 class="three-phases__card-title" style="color:{{ block.settings.title_color }}; font-weight:{{ block.settings.title_weight }};">{{ block.settings.title }}</h3>
            {%- if block.settings.subtitle != blank -%}
              <p class="three-phases__card-subtitle" style="color:{{ block.settings.accent_color }};">{{ block.settings.subtitle }}</p>
            {%- endif -%}
            {%- if block.settings.description != blank -%}
              <p class="three-phases__card-desc">{{ block.settings.description }}</p>
            {%- endif -%}

            {%- if block.settings.link_url != blank -%}
              <span class="three-phases__card-arrow" style="color:{{ block.settings.accent_color }}; border-color:{{ block.settings.card_border_color }};">
                {%- if block.settings.link_label != blank -%}{{ block.settings.link_label }}{%- endif -%}
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
              </span>
            {%- endif -%}

          {%- if has_link -%}</a>{%- else -%}</div>{%- endif -%}
        {%- endif -%}
      {%- endfor -%}
    </div>
  {%- endif -%}

  {%- if section.settings.divider_text != blank -%}
    <div class="three-phases__divider page-width">
      <span class="three-phases__divider-text">{{ section.settings.divider_text }}</span>
    </div>
  {%- endif -%}

  {%- if section.settings.cta_heading != blank or section.settings.cta_label != blank -%}
    <div class="three-phases__cta page-width">
      <div class="three-phases__cta-inner" style="background:{{ section.settings.cta_bg_color }};">
        <div class="three-phases__cta-left">
          {%- if section.settings.cta_eyebrow != blank -%}
            <p class="three-phases__cta-eyebrow" style="color:{{ section.settings.cta_eyebrow_color }};">{{ section.settings.cta_eyebrow }}</p>
          {%- endif -%}
          {%- if section.settings.cta_heading != blank -%}
            <h2 class="three-phases__cta-heading" style="color:{{ section.settings.cta_heading_color }};">{{ section.settings.cta_heading }}</h2>
          {%- endif -%}
          {%- if section.settings.cta_subtext != blank -%}
            <p class="three-phases__cta-subtext" style="color:{{ section.settings.cta_subtext_color }};">{{ section.settings.cta_subtext }}</p>
          {%- endif -%}
        </div>
        <div class="three-phases__cta-right">
          {%- if section.settings.cta_btn1_label != blank -%}
            <a href="{{ section.settings.cta_btn1_link }}" class="three-phases__cta-btn three-phases__cta-btn--primary" style="background:{{ section.settings.cta_btn1_bg }}; color:{{ section.settings.cta_btn1_text }}; border-color:{{ section.settings.cta_btn1_bg }};">
              {{ section.settings.cta_btn1_label }} &rarr;
            </a>
          {%- endif -%}
          {%- if section.settings.cta_btn2_label != blank -%}
            <a href="{{ section.settings.cta_btn2_link }}" class="three-phases__cta-btn three-phases__cta-btn--secondary" style="color:{{ section.settings.cta_btn2_text }}; border-color:{{ section.settings.cta_btn2_text }};">
              {{ section.settings.cta_btn2_label }}
            </a>
          {%- endif -%}
        </div>
      </div>
    </div>
  {%- endif -%}
</section>

<style>
  /* ── Wrapper ── */
  .three-phases {
    padding: 72px 0;
    background: {{ section.settings.section_bg_color }};
  }
  .three-phases .page-width {
    padding-left: max(24px, 5rem);
    padding-right: max(24px, 5rem);
  }

  /* ── Intro ── */
  .three-phases__intro {
    max-width: 760px;
    margin-bottom: 48px;
  }

  /* ── Badge ── */
  .three-phases__badge {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    border: 1px solid;
    border-radius: 50px;
    padding: 6px 14px;
    font-size: 13px;
    font-weight: 500;
    margin-bottom: 20px;
  }

  /* ── Heading ── */
  .three-phases__heading {
    font-size: clamp(32px, 4vw, 52px);
    line-height: 1.15;
    margin: 0 0 18px;
  }
  .three-phases__heading-line1 {
    display: block;
  }
  .three-phases__heading-line2 {
    display: block;
    font-style: italic;
  }

  /* ── Subtext ── */
  .three-phases__subtext {
    font-size: 16px;
    line-height: 1.65;
    color: #555;
    margin: 0;
    max-width: 600px;
  }

  /* ── Cards ── */
  .three-phases__cards {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
    margin-bottom: 0;
  }
  .three-phases__card {
    border-radius: 16px;
    padding: 28px 24px 24px;
    display: flex;
    flex-direction: column;
  }
  .three-phases__card-top {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    margin-bottom: 20px;
  }
  .three-phases__card-meta {
    display: flex;
    align-items: center;
    gap: 8px;
  }
  .three-phases__card-duration {
    display: inline-flex;
    align-items: center;
    border-radius: 50px;
    padding: 4px 12px;
    font-size: 12px;
    font-weight: 600;
  }
  .three-phases__card-emoji {
    font-size: 28px;
    line-height: 1;
  }
  .three-phases__card-title {
    font-size: 20px;
    font-weight: 700;
    margin: 0 0 6px;
    line-height: 1.2;
  }
  .three-phases__card-subtitle {
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    margin: 0 0 14px;
  }
  .three-phases__card-desc {
    font-size: 14px;
    line-height: 1.65;
    color: #444;
    margin: 0 0 20px;
    flex: 1;
  }
  .three-phases__card--linked {
    text-decoration: none;
    display: flex;
    transition: box-shadow 0.2s ease, transform 0.2s ease;
  }
  .three-phases__card--linked:hover {
    box-shadow: 0 6px 20px rgba(0,0,0,0.08);
    transform: translateY(-2px);
  }
  .three-phases__card-arrow {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    margin-top: auto;
    padding-top: 16px;
    border-top: 1px solid;
    font-size: 14px;
    font-weight: 600;
    transition: gap 0.2s ease;
  }
  .three-phases__card--linked:hover .three-phases__card-arrow {
    gap: 12px;
  }

  /* ── Divider ── */
  .three-phases__divider {
    display: flex;
    align-items: center;
    gap: 20px;
    margin: 36px 0;
  }
  .three-phases__divider::before,
  .three-phases__divider::after {
    content: '';
    flex: 1;
    height: 1px;
    background: #d0d0d0;
  }
  .three-phases__divider-text {
    font-size: 13px;
    color: #888;
    white-space: nowrap;
    border: 1px solid #d0d0d0;
    border-radius: 50px;
    padding: 6px 16px;
  }

  /* ── CTA Banner ── */
  .three-phases__cta {
    margin-top: 0;
  }
  .three-phases__cta-inner {
    border-radius: 20px;
    padding: 48px 56px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 40px;
  }
  .three-phases__cta-left {
    flex: 1;
  }
  .three-phases__cta-eyebrow {
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    margin: 0 0 12px;
  }
  .three-phases__cta-heading {
    font-size: clamp(22px, 2.5vw, 32px);
    font-weight: 700;
    margin: 0 0 10px;
    line-height: 1.2;
  }
  .three-phases__cta-subtext {
    font-size: 14px;
    margin: 0;
    opacity: 0.7;
  }
  .three-phases__cta-right {
    display: flex;
    gap: 12px;
    align-items: center;
    flex-shrink: 0;
  }
  .three-phases__cta-btn {
    display: inline-flex;
    align-items: center;
    padding: 14px 28px;
    font-size: 15px;
    font-weight: 600;
    border-radius: 50px;
    border: 2px solid;
    text-decoration: none;
    transition: opacity 0.2s ease;
    white-space: nowrap;
  }
  .three-phases__cta-btn:hover {
    opacity: 0.85;
  }
  .three-phases__cta-btn--secondary {
    background: transparent;
  }

  /* ── Responsive ── */
  @media (max-width: 900px) {
    .three-phases__cards {
      grid-template-columns: 1fr;
    }
    .three-phases__cta-inner {
      flex-direction: column;
      padding: 36px 28px;
      text-align: center;
    }
    .three-phases__cta-right {
      flex-direction: column;
      width: 100%;
    }
    .three-phases__cta-btn {
      justify-content: center;
      width: 100%;
    }
  }
  @media (max-width: 768px) {
    .three-phases {
      padding: 36px 0;
    }
    .three-phases .page-width {
      padding-left: 16px;
      padding-right: 16px;
    }
    .three-phases__intro {
      margin-bottom: 24px;
    }
    .three-phases__badge {
      font-size: 12px;
      padding: 5px 12px;
      margin-bottom: 14px;
    }
    .three-phases__heading {
      font-size: clamp(24px, 7vw, 36px);
      margin-bottom: 12px;
    }
    .three-phases__subtext {
      font-size: 14px;
    }
    .three-phases__cards {
      gap: 12px;
    }
    .three-phases__card {
      padding: 20px 18px 18px;
      border-radius: 14px;
    }
    .three-phases__card-top {
      margin-bottom: 14px;
    }
    .three-phases__card-emoji {
      font-size: 22px;
    }
    .three-phases__card-title {
      font-size: 17px;
    }
    .three-phases__card-desc {
      font-size: 13px;
    }
    .three-phases__divider {
      margin: 24px 0;
    }
    .three-phases__cta-inner {
      padding: 28px 20px;
      border-radius: 16px;
      gap: 20px;
    }
    .three-phases__cta-heading {
      font-size: 20px;
    }
    .three-phases__cta-btn {
      padding: 13px 20px;
      font-size: 14px;
    }
  }
</style>

