{% style %}
  #shopify-section-{{ section.id }} h1.heading {
    line-height: 2.25rem;
  }

  #shopify-section-{{ section.id }} span.separator {
    display: none;
  }

  #shopify-section-{{ section.id }} span.subheadline {
    display: none;
    font-size: 1rem;
  }

  @media (max-width: 767px) {
    #shopify-section-{{ section.id }} .collection-list {
      padding-top: 0rem;
    }
  }

 

  #shopify-section-{{ section.id }} .collection-item {
    border-bottom: unset;
    padding-bottom: unset;
  }


{% endstyle %}
<div class="collection-list collection-name " style="background-color: {{ section.settings.collection_bg_color11 }}">

<div class="container">
  
        <div class="collection-item" >

          <h1 class="heading" style="color: {{ section.settings.title_color11 }}">
            <span>{% if section.settings.overwrite_h1 and collection.metafields.custom.category_title != blank %}
                {{ collection.metafields.custom.category_title }}
              {% else %}
                {{ collection.title }}
            {% endif %}</span>
            {% if section.settings.display_subheadline and collection.metafields.custom.category_sub_title != blank %}
              <span class="separator"> - </span>
              <span class="subheadline collection_subheadline" style="color: {{ section.settings.subtitle_color11 }};">{{ collection.metafields.custom.category_sub_title }}</span>
            {% endif %}
          </h1>

        </div>

        {% if collection.metafields.custom.kurzbeschreibung != blank %}
          <div class="collection_short_text"{% if section.settings.display_introtext %} style="line-height: 1.5rem; color: {{ section.settings.introtext_color }};"{% endif %}>{{ collection.metafields.custom.kurzbeschreibung }}</div>
        {% endif %}

    </div>

</div>


{% schema %}
{
  "name": "Collection Name",
  "settings": [
    
    {
      "type": "color",
      "id": "title_color11",
      "label": "Category title color",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "subtitle_color11",
      "label": "Category subtitle color",
      "default": "#666666"
    },
    {
      "type": "color",
      "id": "introtext_color",
      "label": "Introtext color",
      "default": "#290907"
    },
    {
      "type": "color",
      "id": "collection_bg_color11",
      "label": "Collection background color",
      "default": "#ffffff"
    },
    
    {
      "type" : "checkbox",
      "id" : "overwrite_h1",
      "label" : "Overwrite h1 from custom metafield (BSO) if not empty",
      "default" : false
    },
    {
      "type" : "checkbox",
      "id" : "display_subheadline",
      "label" : "Display subheadline below h1 from custom metafield (BSO) if not empty",
      "default" : false
    },
    {
      "type" : "checkbox",
      "id" : "display_introtext",
      "label" : "Display introtext?",
      "default" : false
    }
  ],
  "presets": [
    {
      "name": "Collection Name"
    }
  ]
}
{% endschema %}
