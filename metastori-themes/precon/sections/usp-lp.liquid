{%- comment -%}
  sections/usp-lp.liquid
  USP-Leiste: Eyebrow / Heading / Grid mit Icon, Titel, Beschreibung
  Eyebrow-Stil identisch zu allen anderen Precon-Sections
  Fonts: Figtree 300/400/600 + Playfair Display 500 italic
{%- endcomment -%}

{%- liquid
  assign c_bg     = section.settings.color_bg
  assign c_ink    = section.settings.color_ink
  assign c_mid    = section.settings.color_mid
  assign c_accent = section.settings.color_accent
  assign pt       = section.settings.padding_top
  assign pb       = section.settings.padding_bottom
-%}

<div id="usp-{{ section.id }}" class="usp" style="padding-top: {{ pt }}px; padding-bottom: {{ pb }}px;">
  <div class="usp__inner">

    {%- if section.settings.eyebrow != blank -%}
      <p class="usp__eyebrow">
        <span class="usp__eyebrow-rule"></span>
        {{ section.settings.eyebrow }}
        <span class="usp__eyebrow-rule"></span>
      </p>
    {%- endif -%}

    {%- if section.settings.heading != blank -%}
      <h2 class="usp__heading">{{ section.settings.heading }}</h2>
    {%- endif -%}

    {%- if section.blocks.size > 0 -%}
      <div class="usp__grid">
        {%- for block in section.blocks -%}
          {%- if block.type == 'usp_item' -%}
            <div class="usp__item" {{ block.shopify_attributes }}>
              <div class="usp__icon-wrap">
                <svg class="usp__icon" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                  {%- case block.settings.icon -%}
                    {%- when 'check' -%}
                      <polyline points="20 6 9 17 4 12"/>
                    {%- when 'check-circle' -%}
                      <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/>
                    {%- when 'shield' -%}
                      <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
                    {%- when 'truck' -%}
                      <rect x="1" y="3" width="15" height="13" rx="1"/><path d="M16 8h4l3 3v5h-7V8z"/><circle cx="5.5" cy="18.5" r="2.5"/><circle cx="18.5" cy="18.5" r="2.5"/>
                    {%- when 'clock' -%}
                      <circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/>
                    {%- when 'award' -%}
                      <circle cx="12" cy="8" r="6"/><path d="M15.477 12.89L17 22l-5-3-5 3 1.523-9.11"/>
                    {%- when 'heart' -%}
                      <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/>
                    {%- when 'star' -%}
                      <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/>
                    {%- when 'users' -%}
                      <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/>
                    {%- when 'leaf' -%}
                      <path d="M2 22l10-10"/><path d="M16 8c0 0-4 0-7 3s-3 7-3 7 4 0 7-3 3-7 3-7z"/><path d="M22 2s-7 1-12 6c-1.5 1.5-2.5 3-3 5"/>
                    {%- else -%}
                      <circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/>
                  {%- endcase -%}
                </svg>
              </div>
              {%- if block.settings.title != blank -%}
                <p class="usp__title">{{ block.settings.title }}</p>
              {%- endif -%}
              {%- if block.settings.text != blank -%}
                <p class="usp__text">{{ block.settings.text }}</p>
              {%- endif -%}
            </div>
          {%- endif -%}
        {%- endfor -%}
      </div>
    {%- endif -%}

  </div>
</div>

<style>
@import url('https://fonts.googleapis.com/css2?family=Figtree:wght@300;400;600&family=Playfair+Display:ital,wght@1,500&display=swap');

#usp-{{ section.id }} {
  --bg:     {{ c_bg }};
  --ink:    {{ c_ink }};
  --mid:    {{ c_mid }};
  --accent: {{ c_accent }};
}

#usp-{{ section.id }},
#usp-{{ section.id }} * { box-sizing: border-box; }

#usp-{{ section.id }} {
  background: var(--bg);
  font-family: 'Figtree', sans-serif;
  -webkit-font-smoothing: antialiased;
  padding-left: 1.5rem;
  padding-right: 1.5rem;
}

/* ── Inner ── */
#usp-{{ section.id }} .usp__inner {
  max-width: 1100px;
  margin: 0 auto;
  text-align: center;
}

/* ── Eyebrow ── */
#usp-{{ section.id }} .usp__eyebrow {
  display: inline-flex;
  align-items: center;
  gap: 10px;
  font-size: 11px;
  font-weight: 600;
  letter-spacing: 0.24em;
  text-transform: uppercase;
  color: var(--accent);
  margin-bottom: 1rem;
}

#usp-{{ section.id }} .usp__eyebrow-rule {
  display: block;
  width: 22px;
  height: 1px;
  background: currentColor;
  opacity: 0.45;
  flex-shrink: 0;
}

/* ── Heading ── */
#usp-{{ section.id }} .usp__heading {
  font-size: clamp(28px, 3.5vw, 48px);
  font-weight: 300;
  color: var(--ink);
  line-height: 1.06;
  letter-spacing: -0.026em;
  text-wrap: balance;
  margin-bottom: 3rem;
}

#usp-{{ section.id }} .usp__heading em {
  font-family: 'Playfair Display', serif;
  font-style: italic;
  font-weight: 500;
  letter-spacing: -0.02em;
}

/* ── Grid ── */
#usp-{{ section.id }} .usp__grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(160px, 1fr));
  gap: 2.5rem 1.5rem;
  text-align: center;
}

/* ── Item ── */
#usp-{{ section.id }} .usp__item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 0.75rem;
}

/* ── Icon ── */
#usp-{{ section.id }} .usp__icon-wrap {
  width: 52px;
  height: 52px;
  border-radius: 50%;
  background: color-mix(in srgb, var(--accent) 10%, transparent);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

#usp-{{ section.id }} .usp__icon {
  color: var(--accent);
}

/* ── Title ── */
#usp-{{ section.id }} .usp__title {
  font-size: 15px;
  font-weight: 600;
  color: var(--ink);
  line-height: 1.35;
  margin: 0;
}

/* ── Text ── */
#usp-{{ section.id }} .usp__text {
  font-size: 14px;
  font-weight: 400;
  color: var(--mid);
  line-height: 1.65;
  margin: 0;
}

/* ── Responsive ── */
@media (max-width: 700px) {
  #usp-{{ section.id }} .usp__grid {
    grid-template-columns: repeat(2, 1fr);
    gap: 2rem 1rem;
  }
  #usp-{{ section.id }} .usp__heading {
    margin-bottom: 2rem;
  }
}

@media (max-width: 380px) {
  #usp-{{ section.id }} .usp__grid {
    grid-template-columns: 1fr;
  }
}
</style>

{% schema %}
{
  "name": "USP LP",
  "tag": "section",
  "settings": [
    { "type": "header", "content": "Inhalt" },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow (optional)",
      "default": "Unsere Stärken"
    },
    {
      "type": "richtext",
      "id": "heading",
      "label": "Überschrift",
      "default": "<p>Warum <em>Precon?</em></p>"
    },
    { "type": "header", "content": "Abstände" },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Abstand oben",
      "min": 0, "max": 120, "step": 4, "unit": "px", "default": 72
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Abstand unten",
      "min": 0, "max": 120, "step": 4, "unit": "px", "default": 72
    },
    { "type": "header", "content": "Farben" },
    { "type": "color", "id": "color_bg",     "label": "Hintergrund",  "default": "#FAF9F5" },
    { "type": "color", "id": "color_ink",    "label": "Titel",        "default": "#56473A" },
    { "type": "color", "id": "color_mid",    "label": "Text",         "default": "#8C7C70" },
    { "type": "color", "id": "color_accent", "label": "Akzentfarbe",  "default": "#3DADBB" }
  ],
  "blocks": [
    {
      "type": "usp_item",
      "name": "USP-Punkt",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            { "value": "check",        "label": "Häkchen" },
            { "value": "check-circle", "label": "Häkchen im Kreis" },
            { "value": "shield",       "label": "Schild" },
            { "value": "truck",        "label": "Lieferwagen" },
            { "value": "clock",        "label": "Uhr / Schnelligkeit" },
            { "value": "award",        "label": "Auszeichnung" },
            { "value": "heart",        "label": "Herz" },
            { "value": "star",         "label": "Stern" },
            { "value": "users",        "label": "Personen / Team" },
            { "value": "leaf",         "label": "Blatt / Natur" }
          ],
          "default": "check"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Titel",
          "default": "Hochwertige Qualität"
        },
        {
          "type": "text",
          "id": "text",
          "label": "Beschreibung",
          "default": "Geprüfte Inhaltsstoffe für beste Ergebnisse"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "USP LP",
      "blocks": [
        {
          "type": "usp_item",
          "settings": {
            "icon": "check",
            "title": "Hochwertige Qualität",
            "text": "Geprüfte Inhaltsstoffe für beste Ergebnisse"
          }
        },
        {
          "type": "usp_item",
          "settings": {
            "icon": "shield",
            "title": "Sicher & Vertrauenswürdig",
            "text": "Zertifizierte Produkte mit Geld-zurück-Garantie"
          }
        },
        {
          "type": "usp_item",
          "settings": {
            "icon": "truck",
            "title": "Schnelle Lieferung",
            "text": "Versand innerhalb von 24 Stunden"
          }
        },
        {
          "type": "usp_item",
          "settings": {
            "icon": "users",
            "title": "Persönliche Beratung",
            "text": "Unser Team steht Ihnen jederzeit zur Verfügung"
          }
        },
        {
          "type": "usp_item",
          "settings": {
            "icon": "award",
            "title": "Bewährte Methode",
            "text": "Tausende zufriedene Kunden vertrauen uns"
          }
        }
      ]
    }
  ]
}
{% endschema %}