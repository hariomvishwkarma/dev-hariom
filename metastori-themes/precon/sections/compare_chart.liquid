<section class="chart_sec">
<div class="container">

<div class="compare-chart" style="background-color: {{ section.settings.background_color }}; color: {{ section.settings.text_color }};">
  <div class="scales">
      {% for block in section.blocks %}
        {% if block.settings.title != blank %}
          {% case block.type %}
            {% when 'scale1' %}
              {% assign metafield_value = product.metafields.compare.value_on_scale_1 | default: 50 %}
            {% when 'scale2' %}
              {% assign metafield_value = product.metafields.compare.value_on_scale_2 | default: 50 %}
            {% when 'scale3' %}
              {% assign metafield_value = product.metafields.compare.value_on_scale_3 | default: 50 %}
          {% endcase %}
          <div class="scale-block" style="margin-bottom: {{ section.settings.spacing }}px;">
            <div class="scale-title">{{ block.settings.title }}</div>
            <div class="scale-line">
              <span class="scale-label left">{{ block.settings.left_label }}</span>
              <span class="scale-label center">{{ block.settings.center_label }}</span>
              <span class="scale-label right">{{ block.settings.right_label }}</span>
              <span class="slider-dot" style="left: calc({{ metafield_value }}% - 5px);"></span>
            </div>
          </div>
        {% endif %}
      {% endfor %}
    </div>
  </div>
</div>
</section>

<style>
.compare-chart {
  margin: 0 auto;
border-radius: 16px;
padding: 21px 30px 12px 30px;
}
.scales {
  display: flex;
  flex-wrap: wrap;
  gap:{{section.settings.spacing}}px;
}
.scale-block {
  flex: 1 1 calc(33.33% - 40px);
  min-width: 0;
  position: relative;
}



.scale-line {
    position: relative;
    height: 4px;
    background: #fff;
    border-radius: 5px;
}

.scale-title {
    font-size: 16px;
    font-style: italic;
    font-weight: 500;
    margin-bottom:3px;
}

.scale-label {
    position: absolute;
    top: 10px;
    white-space: nowrap;
    color: #fff;
    font-size: 13px;
    font-style: normal;
    font-weight: 500;
    line-height: normal;
}

.left { left: 0; }
.center { left: 50%; transform: translateX(-50%); }
.right { right: 0; }
.slider-dot {
  position: absolute;
  width: 12px;
  height: 12px;
  background: #FFFFFF;
  border-radius: 50%;
  top:2px;
  transform: translateY(-50%);
}

@media only screen and (max-width: 479px){
 .scales { display: block;}
}
</style>

