<section class="cta-banner" id="cta-banner-{{ section.id }}">
  <div class="cta-banner__inner page-width">

{%- if section.settings.eyebrow != blank -%}
<p class="cta-banner__eyebrow" style="color: {{ section.settings.eyebrow_color }};">
{{ section.settings.eyebrow }}
</p>
{%- endif -%}

{%- if section.settings.heading != blank -%}
<h2 class="cta-banner__heading">{{ section.settings.heading }}</h2>
{%- endif -%}

{%- if section.settings.subtext != blank -%}
<p class="cta-banner__subtext">{{ section.settings.subtext }}</p>
{%- endif -%}

{%- if section.settings.show_primary or section.settings.show_secondary -%}
<div class="cta-banner__buttons">
{%- if section.settings.show_primary and section.settings.primary_label != blank -%}
<a
href="{{ section.settings.primary_link }}"
class="cta-banner__btn cta-banner__btn--primary"
style="background-color: {{ section.settings.primary_bg }}; color: {{ section.settings.primary_text_color }}; border-color: {{ section.settings.primary_bg }};"
>
{{ section.settings.primary_label }}
</a>
{%- endif -%}

{%- if section.settings.show_secondary and section.settings.secondary_label != blank -%}
<a
href="{{ section.settings.secondary_link }}"
class="cta-banner__btn cta-banner__btn--secondary"
style="background-color: {{ section.settings.secondary_bg }}; color: {{ section.settings.secondary_text_color }}; border-color: {{ section.settings.secondary_border_color }};"
>
{{ section.settings.secondary_label }}
</a>
{%- endif -%}
</div>
{%- endif -%}

</div>
</section>

<style>
.cta-banner {
background-color: {{ section.settings.section_bg }};
padding: {{ section.settings.padding_top }}px 0 {{ section.settings.padding_bottom }}px;
  }

.cta-banner__inner {
max-width: 760px;
margin: 0 auto;
padding: 0 24px;
text-align: center;
  }

.cta-banner__eyebrow {
font-size: 12px;
font-weight: 700;
letter-spacing: 0.16em;
text-transform: uppercase;
margin: 0 0 16px;
  }

.cta-banner__heading {
font-size: clamp(30px, 4vw, 46px);
font-weight: 300;
line-height: 1.15;
color: {{ section.settings.heading_color }};
margin: 0 0 18px;
  }

.cta-banner__heading em,
.cta-banner__heading strong,
.cta-banner__heading em strong,
.cta-banner__heading strong em {
  font-family: var(--accent-font-family);
  font-style: var(--accent-font-style);
  font-weight: 500;
  }

.cta-banner__subtext {
font-size: clamp(15px, 1.15vw, 17px);
line-height: 1.7;
color: {{ section.settings.text_color }};
margin: 0 0 36px;
  }

.cta-banner__buttons {
display: flex;
justify-content: center;
flex-wrap: wrap;
gap: 16px;
  }

.cta-banner__btn {
display: inline-flex;
align-items: center;
justify-content: center;
padding: 16px 36px;
font-size: 15px;
font-weight: 500;
border-radius: 50px;
border: 2px solid;
text-decoration: none;
transition: opacity 0.25s ease;
white-space: nowrap;
cursor: pointer;
  }

.cta-banner__btn:hover {
opacity: 0.8;
  }

@media (max-width: 600px) {
.cta-banner__buttons {
flex-direction: column;
align-items: stretch;
    }

.cta-banner__btn {
text-align: center;
    }
  }
</style>

{% schema %}
{
  "name": "CTA Banner",
  "tag": "section",
  "class": "section-cta-banner",
  "settings": [
    {
      "type": "header",
      "content": "Section layout"
    },
    {
      "type": "color",
      "id": "section_bg",
      "label": "Background color",
      "default": "#f7f3ee"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 120,
      "step": 4,
      "default": 72,
      "unit": "px",
      "label": "Top padding"
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "default": 72,
      "unit": "px",
      "label": "Bottom padding"
    },
    {
      "type": "header",
      "content": "Text"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "JETZT STARTEN"
    },
    {
      "type": "color",
      "id": "eyebrow_color",
      "label": "Eyebrow color",
      "default": "#4FBFBE"
    },
    {
      "type": "richtext",
      "id": "heading",
      "label": "Heading",
      "default": "<p>Bereit für Deine <em>Abnehmreise?</em></p>"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading color",
      "default": "#2c2c2c"
    },
    {
      "type": "textarea",
      "id": "subtext",
      "label": "Subtext",
      "default": "39 Jahre Abnehmexpertise, über 40.000 Bewertungen und ein wissenschaftlich fundiertes Konzept — das ist Precon. Starte heute mit dem kostenlosen Abnehmplan."
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Subtext color",
      "default": "#6b645c"
    },
    {
      "type": "header",
      "content": "Primary button"
    },
    {
      "type": "checkbox",
      "id": "show_primary",
      "label": "Show primary button",
      "default": true
    },
    {
      "type": "text",
      "id": "primary_label",
      "label": "Label",
      "default": "Zum 4-Wochen-Startpaket"
    },
    {
      "type": "url",
      "id": "primary_link",
      "label": "Link"
    },
    {
      "type": "color",
      "id": "primary_bg",
      "label": "Background color",
      "default": "#4FBFBE"
    },
    {
      "type": "color",
      "id": "primary_text_color",
      "label": "Text color",
      "default": "#ffffff"
    },
    {
      "type": "header",
      "content": "Secondary button"
    },
    {
      "type": "checkbox",
      "id": "show_secondary",
      "label": "Show secondary button",
      "default": true
    },
    {
      "type": "text",
      "id": "secondary_label",
      "label": "Label",
      "default": "Abnehmplan berechnen lassen"
    },
    {
      "type": "url",
      "id": "secondary_link",
      "label": "Link"
    },
    {
      "type": "color",
      "id": "secondary_bg",
      "label": "Background color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "secondary_text_color",
      "label": "Text color",
      "default": "#2c2c2c"
    },
    {
      "type": "color",
      "id": "secondary_border_color",
      "label": "Border color",
      "default": "#d5d0c8"
    }
  ],
  "presets": [
    {
      "name": "CTA Banner"
    }
  ]
}
{% endschema %}