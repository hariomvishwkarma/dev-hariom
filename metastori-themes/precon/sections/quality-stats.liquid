<style>
  .q-stats {
    padding: 48px 20px;
    font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
    background-color: {{ section.settings.bg_color }};
    color: {{ section.settings.text_color }};
  }
  .q-stats__inner {
    max-width: 960px;
    margin: 0 auto;
  }
  .q-stats__label {
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 2px;
    text-transform: uppercase;
    color: {{ section.settings.accent_color }};
    margin-bottom: 8px;
  }
  .q-stats__heading {
    font-size: clamp(28px, 4.5vw, 42px);
    font-weight: 400;
    font-family: Georgia, 'Times New Roman', serif;
    line-height: 1.15;
    margin: 0 0 32px;
  }
  .q-stats__grid {
    display: flex;
    gap: 16px;
  }
  .q-stats__card {
    flex: 1;
    background: {{ section.settings.card_bg }};
    border-radius: 16px;
    padding: 36px 28px;
    text-align: center;
  }
  .q-stats__number {
    font-family: Georgia, 'Times New Roman', serif;
    font-size: clamp(40px, 5vw, 56px);
    font-weight: 700;
    color: {{ section.settings.accent_color }};
    line-height: 1.1;
    margin-bottom: 8px;
  }
  .q-stats__title {
    font-size: 16px;
    font-weight: 700;
    margin: 0 0 8px;
    line-height: 1.3;
  }
  .q-stats__desc {
    font-size: 14px;
    line-height: 1.6;
    opacity: 0.65;
    margin: 0;
  }

  @media (max-width: 768px) {
    .q-stats {
      padding: 24px 14px;
    }
    .q-stats__heading {
      font-size: 26px;
      margin-bottom: 20px;
    }
    .q-stats__grid {
      flex-direction: column;
      gap: 10px;
    }
    .q-stats__card {
      padding: 24px 20px;
      border-radius: 12px;
      display: flex;
      align-items: center;
      gap: 16px;
      text-align: left;
    }
    .q-stats__number {
      font-size: 32px;
      margin-bottom: 0;
      white-space: nowrap;
      flex-shrink: 0;
    }
    .q-stats__card-text {
      flex: 1;
    }
    .q-stats__title {
      font-size: 14px;
      margin-bottom: 4px;
    }
    .q-stats__desc {
      font-size: 12px;
    }
  }
</style>

<div class="q-stats">
  <div class="q-stats__inner">
    {% if section.settings.top_label != blank %}
      <div class="q-stats__label">{{ section.settings.top_label }}</div>
    {% endif %}

    <h2 class="q-stats__heading">{{ section.settings.heading }}</h2>

    <div class="q-stats__grid">
      {% for block in section.blocks %}
        <div class="q-stats__card" {{ block.shopify_attributes }}>
          <div class="q-stats__number">{{ block.settings.number }}</div>
          <div class="q-stats__card-text">
            <h3 class="q-stats__title">{{ block.settings.title }}</h3>
            <p class="q-stats__desc">{{ block.settings.desc }}</p>
          </div>
        </div>
      {% endfor %}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Quality Stats",
  "settings": [
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#faf8f4"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#3a3631"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent / Number Color",
      "default": "#2fb5a0"
    },
    {
      "type": "color",
      "id": "card_bg",
      "label": "Card Background",
      "default": "#f0ece4"
    },
    {
      "type": "text",
      "id": "top_label",
      "label": "Top Label",
      "default": "Qualität die Du schmeckst"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Warum Precon anders ist"
    }
  ],
  "blocks": [
    {
      "type": "stat",
      "name": "Stat Card",
      "settings": [
        {
          "type": "text",
          "id": "number",
          "label": "Number / Value",
          "default": "35+"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Jahre Erfahrung"
        },
        {
          "type": "textarea",
          "id": "desc",
          "label": "Description",
          "default": "Seit 1981 ärztlich entwickelt und kontinuierlich verfeinert"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Quality Stats",
      "blocks": [
        { "type": "stat", "settings": { "number": "35+", "title": "Jahre Erfahrung", "desc": "Seit 1981 ärztlich entwickelt und kontinuierlich verfeinert" } },
        { "type": "stat", "settings": { "number": "<235", "title": "kcal pro Mahlzeit", "desc": "Kalorienarm, eiweißreich, sättigend und mit allen Vitaminen versorgt" } },
        { "type": "stat", "settings": { "number": "DE", "title": "Made in Germany", "desc": "Produktion nach höchsten Qualitätsstandards, vollständig in Deutschland" } }
      ]
    }
  ]
}
{% endschema %}