  font-weight: 600;
  text-decoration: none;
  margin-top: 10px;
  display: inline-block;
  transition: opacity 0.2s;
}
#art-body-{{ section.id }} .art-body__author-link-page:hover { opacity: 0.7; }

#art-body-{{ section.id }} .art-body__author-links {
  display: flex;
  gap: 10px;
  margin-top: 12px;
  flex-wrap: wrap;
}

#art-body-{{ section.id }} .art-body__author-link {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 34px;
  height: 34px;
