  flex-shrink: 0;
}

#art-body-{{ section.id }} .art-body__author-link:hover {
  border-color: currentColor;
  transform: translateY(-2px);
}

/* ────────────────────────────────────────
   SIDEBAR: SOCIAL SHARE
   ──────────────────────────────────────── */
#art-body-{{ section.id }} .art-body__social-card {
  border: 1px solid;
  border-radius: 16px;
  padding: 20px;
  background: var(--bg);
}

#art-body-{{ section.id }} .art-body__social-heading {
  font-size: clamp(15px, 1.4vw, 17px);
  font-weight: 700;
  line-height: 1.25;
  letter-spacing: -0.01em;
  margin: 0 0 10px;
}

#art-body-{{ section.id }} .art-body__social-sub {
  font-size: 13px;
  line-height: 1.6;
  margin: 0 0 16px;
}

#art-body-{{ section.id }} .art-body__social-btns {
  display: flex;
  gap: 10px;
  flex-wrap: wrap;
}

#art-body-{{ section.id }} .art-body__social-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 46px;
  height: 46px;
  border-radius: 50%;
  color: #ffffff;
  text-decoration: none;
  flex-shrink: 0;
  transition: opacity 0.2s ease, transform 0.2s ease;
}

#art-body-{{ section.id }} .art-body__social-btn:hover {
  opacity: 0.82;
  transform: translateY(-2px);
}

#art-body-{{ section.id }} .art-body__social-btn svg { flex-shrink: 0; }

/* ── Verwandte Artikel ── */
#art-body-{{ section.id }} .art-body__related {
  background: var(--related-bg);
  border-top: 1px solid var(--divider);
  padding: 4rem 0 4.5rem;
}
#art-body-{{ section.id }} .art-body__related-inner {
  max-width: 1160px;
  margin: 0 auto;
  padding: 0 max(24px, 4rem);
}
#art-body-{{ section.id }} .art-body__related-title {
  font-size: clamp(18px, 1.8vw, 22px);
  font-weight: 600;
  color: var(--ink);
  margin: 0 0 1.75rem;
}
#art-body-{{ section.id }} .art-body__related-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 20px;
}
#art-body-{{ section.id }} .art-body__rel-card {
  display: flex;
  flex-direction: column;
  border-radius: 16px;
  overflow: hidden;
  background: #ffffff;
  border: 1px solid var(--divider);
  text-decoration: none;
  transition: box-shadow 0.2s ease, transform 0.2s ease;
}
#art-body-{{ section.id }} .art-body__rel-card:hover {
  box-shadow: 0 6px 24px rgba(0,0,0,0.09);
  transform: translateY(-3px);
}
#art-body-{{ section.id }} .art-body__rel-img {
  aspect-ratio: 16/9;
  overflow: hidden;
  background: var(--tag-bg);
}
#art-body-{{ section.id }} .art-body__rel-img img {
  width: 100%; height: 100%;
  object-fit: cover; display: block;
  transition: transform 0.35s ease;
}
#art-body-{{ section.id }} .art-body__rel-card:hover .art-body__rel-img img { transform: scale(1.04); }
#art-body-{{ section.id }} .art-body__rel-text {
  display: flex; flex-direction: column; gap: 6px;
  padding: 18px 20px 22px; flex: 1;
}
#art-body-{{ section.id }} .art-body__rel-blog {
  font-size: 10px; font-weight: 700; letter-spacing: 0.12em;
  text-transform: uppercase; color: var(--accent);
}
#art-body-{{ section.id }} .art-body__rel-name {
  font-size: 15px; font-weight: 600; color: var(--ink); line-height: 1.35;
}
#art-body-{{ section.id }} .art-body__rel-date {
  font-size: 12px; color: var(--mid); margin-top: auto; padding-top: 8px;
}

/* ── Quick Nav Stats ── */
.quick-nav-stats { padding: 48px 0; }
.quick-nav-stats .page-width {
  padding-left: max(24px, 5rem);
  padding-right: max(24px, 5rem);
}
.quick-nav__eyebrow {
  font-size: 11px; font-weight: 700; letter-spacing: 0.12em;
  text-transform: uppercase; margin: 0 0 16px;
}
.quick-nav__grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 14px; }
.quick-nav__card {
  display: flex; align-items: center; justify-content: space-between;
  gap: 16px; padding: 22px 24px; border: 1px solid; border-radius: 16px;
  text-decoration: none; transition: box-shadow 0.2s ease, transform 0.2s ease;
}
.quick-nav__card:hover { box-shadow: 0 4px 16px rgba(0,0,0,0.07); transform: translateY(-2px); }
.quick-nav__card-text { display: flex; flex-direction: column; gap: 6px; flex: 1; min-width: 0; }
.quick-nav__card-title { font-size: 16px; font-weight: 700; line-height: 1.2; }
.quick-nav__card-subtitle { font-size: 13px; line-height: 1.45; }
.quick-nav__card-arrow { font-size: 18px; flex-shrink: 0; transition: transform 0.2s ease; }
.quick-nav__card:hover .quick-nav__card-arrow { transform: translateX(4px); }

/* ────────────────────────────────────────
   BSO SHORTCODE DESIGN-OVERRIDES
   Erzwingt Precon-Styling über BSO-Standard
   ──────────────────────────────────────── */

/* Font durchgängig auf Figtree */
#art-body-{{ section.id }} .shortcode-rte,
#art-body-{{ section.id }} .shortcode-rte * {
  font-family: 'Figtree', sans-serif;
}

/* Alle Shortcode-CTA-Buttons → Precon Akzentfarbe */
#art-body-{{ section.id }} .shortcode-rte .bso-btn,
#art-body-{{ section.id }} .shortcode-rte .bso-cta__btn,
#art-body-{{ section.id }} .shortcode-rte .shortcode-cta__btn,
#art-body-{{ section.id }} .shortcode-rte [class*="btn--primary"],
#art-body-{{ section.id }} .shortcode-rte .bso-button {
  background-color: var(--accent) !important;
  border-color:     var(--accent) !important;
  color:            #fff          !important;
  font-family:      'Figtree', sans-serif !important;
  border-radius:    8px !important;
}
#art-body-{{ section.id }} .shortcode-rte .bso-btn:hover,
#art-body-{{ section.id }} .shortcode-rte .bso-cta__btn:hover,
#art-body-{{ section.id }} .shortcode-rte .shortcode-cta__btn:hover,
#art-body-{{ section.id }} .shortcode-rte .bso-button:hover {
  opacity: 0.85 !important;
}

/* Links ohne Button-Klassen → Akzentfarbe */
#art-body-{{ section.id }} .shortcode-rte a:not([class*="btn"]):not([class*="button"]):not([class*="bso-btn"]) {
  color: var(--accent);
  text-decoration-color: var(--accent);
}

/* Shortcode-Boxen: Textfarbe + Hintergrund neutral */
#art-body-{{ section.id }} .shortcode-rte .bso-row {
  color: var(--ink);
}
#art-body-{{ section.id }} .shortcode-rte .bso-column {
  color: var(--ink);
}

/* Highlight / Info-Boxen: leicht getönt in Precon-Farben */
#art-body-{{ section.id }} .shortcode-rte [class*="shortcode-box"],
#art-body-{{ section.id }} .shortcode-rte [class*="bso-box"] {
  border-radius: 12px;
  border-color: var(--divider) !important;
}

/* Shortcode-Überschriften erben unsere H2-Styles */
#art-body-{{ section.id }} .shortcode-rte h2,
#art-body-{{ section.id }} .shortcode-rte h3,
#art-body-{{ section.id }} .shortcode-rte h4 {
  color: var(--ink);
  font-weight: 600;
  line-height: 1.25;
  margin: 2.4em 0 0.7em !important;
}
#art-body-{{ section.id }} .shortcode-rte h2 { font-size: clamp(20px, 2vw, 25px); }
#art-body-{{ section.id }} .shortcode-rte h3 { font-size: clamp(17px, 1.65vw, 21px); }
#art-body-{{ section.id }} .shortcode-rte h4 { font-size: clamp(15px, 1.4vw, 18px); }

/* ── Responsive ── */
@media (max-width: 960px) {
  #art-body-{{ section.id }} .art-body__layout {
    grid-template-columns: 1fr;
    gap: 0;
    padding: 2rem max(24px, 3rem) 3rem;
  }
  #art-body-{{ section.id }} .art-body__sidebar {
    position: static;
    flex-direction: row;
    flex-wrap: wrap;
    gap: 16px;
  }
  #art-body-{{ section.id }} .art-body__author-card,
  #art-body-{{ section.id }} .art-body__social-card {
    flex: 1;
    min-width: 260px;
  }
  #art-body-{{ section.id }} .art-body__author-card {
    flex-direction: row;
    text-align: left;
    align-items: flex-start;
  }
  #art-body-{{ section.id }} .art-body__author-meta {
    align-items: flex-start;
  }
  .quick-nav__grid { grid-template-columns: repeat(2, 1fr); }
}

@media (max-width: 768px) {
  #art-body-{{ section.id }} .art-body__layout { padding: 2rem 16px 2.5rem; }
  /* p + h2 Ausnahme entfernt – Leerzeilen-Unterdrückung übernimmt das */
  #art-body-{{ section.id }} .art-body__sidebar { flex-direction: column; }
  #art-body-{{ section.id }} .art-body__author-card {
    flex-direction: column;
    align-items: center;
    text-align: center;
  }
  #art-body-{{ section.id }} .art-body__author-meta { align-items: center; }
  #art-body-{{ section.id }} .art-body__related-inner { padding-left: 16px; padding-right: 16px; }
  #art-body-{{ section.id }} .art-body__related { padding: 2.5rem 0 3rem; }
  #art-body-{{ section.id }} .art-body__related-grid { grid-template-columns: repeat(2, 1fr); }
  .quick-nav-stats { padding: 28px 0; }
  .quick-nav-stats .page-width { padding-left: 16px; padding-right: 16px; }
  .quick-nav__grid { grid-template-columns: repeat(2, 1fr); gap: 10px; }
  .quick-nav__card { padding: 14px; border-radius: 12px; gap: 8px; }
  .quick-nav__card-title { font-size: 13px; }
  .quick-nav__card-subtitle { font-size: 11px; line-height: 1.35; }
  .quick-nav__card-arrow { font-size: 14px; }
}

@media (max-width: 480px) {
  #art-body-{{ section.id }} .art-body__related-grid { grid-template-columns: 1fr; }
  #art-body-{{ section.id }} .art-body__prose { font-size: 15px; }
}
