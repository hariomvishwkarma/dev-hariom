{%- comment -%}
  sections/journey-team-intro.liquid
  Fonts : Figtree 300/400/600 + Playfair Display 500 italic
  Colors: fully customisable via schema settings
{%- endcomment -%}

{%- liquid
  assign c_bg        = section.settings.color_bg
  assign c_eyebrow   = section.settings.color_eyebrow
  assign c_body      = section.settings.color_body
  assign c_name      = section.settings.color_name
  assign c_role      = section.settings.color_role
  assign c_splash_a  = section.settings.color_splash_a
  assign c_splash_b  = section.settings.color_splash_b
-%}

<div id="team-intro-{{ section.id }}" class="tmi">
  <div class="tmi__wrap">

    <!-- IMAGE COLUMN -->
    <div class="tmi__media">
      <div class="tmi__splash" aria-hidden="true"></div>
      <div class="tmi__figure">
        {%- if section.settings.image != blank -%}
          <img
            src="{{ section.settings.image | image_url: width: 900 }}"
            srcset="
              {{ section.settings.image | image_url: width: 600 }} 600w,
              {{ section.settings.image | image_url: width: 900 }} 900w
            "
            sizes="(min-width: 860px) 42vw, 92vw"
            alt="{{ section.settings.image.alt | default: section.settings.name | escape }}"
            width="{{ section.settings.image.width }}"
            height="{{ section.settings.image.height }}"
            loading="lazy"
          >
        {%- else -%}
          {{ 'person-1' | placeholder_svg_tag: 'tmi__ph' }}
        {%- endif -%}
      </div>
    </div>

    <!-- TEXT COLUMN -->
    <div class="tmi__text">

      {%- if section.settings.eyebrow != blank -%}
        <p class="tmi__eyebrow">{{ section.settings.eyebrow }}</p>
      {%- endif -%}

      {%- if section.settings.body != blank -%}
        <div class="tmi__body">{{ section.settings.body }}</div>
      {%- endif -%}

    </div>

    <!-- SIGNATURE (mobil: unter Bild) -->
    <div class="tmi__signature">
      {%- if section.settings.name != blank -%}
        <p class="tmi__name">{{ section.settings.name }}</p>
      {%- endif -%}
      {%- if section.settings.role != blank -%}
        <p class="tmi__role">{{ section.settings.role }}</p>
      {%- endif -%}
    </div>
  </div>
</div>


<style>
  @import url('https://fonts.googleapis.com/css2?family=Figtree:wght@300;400;600&family=Playfair+Display:ital,wght@1,500&display=swap');

  #team-intro-{{ section.id }} {
    --bg:        {{ c_bg }};
    --eyebrow:   {{ c_eyebrow }};
    --body:      {{ c_body }};
    --name:      {{ c_name }};
    --role:      {{ c_role }};
    --splash-a:  {{ c_splash_a | color_modify: 'alpha', 0.45 }};
    --splash-b:  {{ c_splash_b | color_modify: 'alpha', 0.32 }};
  }

  #team-intro-{{ section.id }},
  #team-intro-{{ section.id }} * { box-sizing: border-box; }

  #team-intro-{{ section.id }} {
    background: var(--bg);
    font-family: 'Figtree', sans-serif;
    -webkit-font-smoothing: antialiased;
    padding: 3rem 1.5rem;
  }

  #team-intro-{{ section.id }} .tmi__wrap {
    max-width: 1160px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    align-items: center;
  }

  /* ── MOBILE ORDER: text → signature → image ── */
  #team-intro-{{ section.id }} .tmi__text      { order: 1; }
  #team-intro-{{ section.id }} .tmi__signature { order: 2; width: 100%; }
  #team-intro-{{ section.id }} .tmi__media     { order: 3; }

  #team-intro-{{ section.id }} .tmi__media {
    position: relative;
    width: 100%;
    max-width: 200px;
    flex-shrink: 0;
  }

  /* Decorative colour splash behind image */
  #team-intro-{{ section.id }} .tmi__splash {
    position: absolute;
    bottom: -1.5rem;
    left: -1.5rem;
    width: 60%;
    height: 55%;
    border-radius: 50%;
    background: radial-gradient(ellipse at 30% 70%, var(--splash-a) 0%, transparent 70%),
                radial-gradient(ellipse at 70% 40%, var(--splash-b) 0%, transparent 65%);
    filter: blur(28px);
    z-index: 0;
  }

  #team-intro-{{ section.id }} .tmi__figure {
    position: relative;
    z-index: 1;
    border-radius: 20px;
    overflow: hidden;
    aspect-ratio: 3 / 4;
    background: {{ c_body | color_modify: 'alpha', 0.06 }};
  }

  #team-intro-{{ section.id }} .tmi__figure img,
  #team-intro-{{ section.id }} .tmi__figure .tmi__ph {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  /* ── TEXT ── */
  #team-intro-{{ section.id }} .tmi__text {
    display: flex;
    flex-direction: column;
    gap: 0;
  }

  #team-intro-{{ section.id }} .tmi__eyebrow {
    font-weight: 600;
    font-size: .68rem;
    letter-spacing: .26em;
    text-transform: uppercase;
    color: var(--eyebrow);
    margin: 0 0 0.75rem;
    text-align: center;
  }

  #team-intro-{{ section.id }} .tmi__body {
    font-weight: 400;
    font-size: clamp(1rem, 2.2vw, 1.1rem);
    line-height: 1.82;
    color: var(--body);
    margin: 0 0 1rem;
  }
  #team-intro-{{ section.id }} .tmi__body p { margin: 0 0 1.2rem; }
  #team-intro-{{ section.id }} .tmi__body p:last-child { margin-bottom: 0; }
  #team-intro-{{ section.id }} .tmi__body em {
    font-family: 'Playfair Display', serif;
    font-style: italic;
    font-weight: 500;
  }
  #team-intro-{{ section.id }} .tmi__body strong {
    font-weight: 600;
  }

  #team-intro-{{ section.id }} .tmi__name {
    font-family: 'Playfair Display', serif;
    font-style: italic;
    font-weight: 500;
    font-size: clamp(1.6rem, 3.5vw, 2rem);
    color: var(--name);
    margin: 0 0 .4rem;
    line-height: 1.1;
  }

  #team-intro-{{ section.id }} .tmi__role {
    font-weight: 300;
    font-size: .88rem;
    color: var(--role);
    margin: 0;
    letter-spacing: .01em;
  }

  /* ── DESKTOP ≥ 860px: Grid 2 Spalten ── */
  @media (min-width: 860px) {
    #team-intro-{{ section.id }} { padding: 5rem 1.5rem; }
    #team-intro-{{ section.id }} .tmi__eyebrow { margin: 0 0 1.5rem; }
    #team-intro-{{ section.id }} .tmi__body    { margin: 0 0 2rem; }
    #team-intro-{{ section.id }} .tmi__wrap {
      display: grid;
      grid-template-columns: 340px 1fr;
      grid-template-rows: auto auto;
      column-gap: 6rem;
      row-gap: .75rem;
      align-items: start;
    }
    #team-intro-{{ section.id }} .tmi__media {
      grid-column: 1;
      grid-row: 1 / span 2;
      align-self: center;
      order: unset;
      max-width: 340px;
      width: 100%;
    }
    #team-intro-{{ section.id }} .tmi__text {
      grid-column: 2;
      grid-row: 1;
      order: unset;
      width: auto;
    }
    #team-intro-{{ section.id }} .tmi__signature {
      grid-column: 2;
      grid-row: 2;
      order: unset;
      width: auto;
    }
  }
</style>


{% schema %}
{
  "name": "Journey Team Intro",
  "tag": "section",
  "class": "journey-team-intro-section",
  "settings": [
    {
      "type": "header",
      "content": "Inhalt"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Portrait-Bild"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "DAS TEAM"
    },
    {
      "type": "richtext",
      "id": "body",
      "label": "Text (kursiv = Playfair italic)"
    },
    {
      "type": "text",
      "id": "name",
      "label": "Name (Playfair Italic Signatur)",
      "default": "Petra"
    },
    {
      "type": "text",
      "id": "role",
      "label": "Rolle / Firma",
      "default": "Kundenserviceleitung · Precon"
    },
    {
      "type": "header",
      "content": "Farben"
    },
    {
      "type": "color",
      "id": "color_bg",
      "label": "Hintergrund",
      "default": "#FAF9F5"
    },
    {
      "type": "color",
      "id": "color_eyebrow",
      "label": "Eyebrow",
      "default": "#3DADBB"
    },
    {
      "type": "color",
      "id": "color_body",
      "label": "Text",
      "default": "#56473A"
    },
    {
      "type": "color",
      "id": "color_name",
      "label": "Name",
      "default": "#56473A"
    },
    {
      "type": "color",
      "id": "color_role",
      "label": "Rolle",
      "default": "#8C7C70"
    },
    {
      "type": "color",
      "id": "color_splash_a",
      "label": "Farb-Splash A",
      "default": "#3DADBB"
    },
    {
      "type": "color",
      "id": "color_splash_b",
      "label": "Farb-Splash B",
      "default": "#C9A8B2"
    }
  ],
  "presets": [
    {
      "name": "Journey Team Intro"
    }
  ]
}
{% endschema %}