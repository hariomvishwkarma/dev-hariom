<style>
  .phases {
    padding: 48px 20px;
    font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
    background-color: {{ section.settings.bg_color }};
    color: {{ section.settings.text_color }};
    text-align: center;
  }
  .phases__inner {
    max-width: 820px;
    margin: 0 auto;
  }
  .phases__label {
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 2px;
    text-transform: uppercase;
    color: {{ section.settings.accent_color }};
    margin-bottom: 10px;
  }
  .phases__heading {
    font-size: clamp(28px, 4.5vw, 42px);
    font-weight: 400;
    line-height: 1.2;
    margin: 0 0 36px;
  }
  .phases__heading em {
    font-style: italic;
    font-family: Georgia, 'Times New Roman', serif;
    color: {{ section.settings.accent_color }};
  }

  /* ── Phase card ── */
  .phases__list {
    display: flex;
    flex-direction: column;
    gap: 0;
    text-align: left;
  }
  .phases__item {
    display: flex;
    gap: 28px;
    padding: 28px 0;
    border-top: 1px solid {{ section.settings.divider_color }};
  }
  .phases__item:last-child {
    border-bottom: none;
  }

  /* ── Left: number + duration ── */
  .phases__left {
    flex-shrink: 0;
    width: 80px;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 8px;
  }
  .phases__num {
    width: 48px;
    height: 48px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 16px;
    font-weight: 700;
    color: #fff;
  }
  {% for block in section.blocks %}
  .phases__item:nth-child({{ forloop.index }}) .phases__num {
    background: {{ block.settings.icon_color }};
  }
  {% endfor %}
  .phases__duration {
    font-size: 13px;
    opacity: 0.6;
    text-align: center;
    line-height: 1.3;
  }

  /* ── Right: content ── */
  .phases__content {
    flex: 1;
    min-width: 0;
  }
  .phases__phase-label {
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 1.5px;
    text-transform: uppercase;
    color: {{ section.settings.accent_color }};
    margin-bottom: 4px;
  }
  .phases__title {
    font-size: 16px;
    font-weight: 700;
    margin: 0 0 8px;
    line-height: 1.3;
  }
  .phases__text {
    font-size: 14px;
    line-height: 1.7;
    opacity: 0.75;
    margin: 0;
  }

  @media (max-width: 600px) {
    .phases {
      padding: 24px 14px;
    }
    .phases__heading {
      font-size: 24px;
      margin-bottom: 24px;
    }
    .phases__item {
      gap: 16px;
      padding: 20px 0;
    }
    .phases__left {
      width: 60px;
    }
    .phases__num {
      width: 40px;
      height: 40px;
      font-size: 14px;
    }
    .phases__duration {
      font-size: 11px;
    }
    .phases__phase-label {
      font-size: 10px;
    }
    .phases__title {
      font-size: 14px;
    }
    .phases__text {
      font-size: 13px;
    }
  }
</style>

<div class="phases">
  <div class="phases__inner">
    {% if section.settings.top_label != blank %}
      <div class="phases__label">{{ section.settings.top_label }}</div>
    {% endif %}

    <h2 class="phases__heading">{{ section.settings.heading }}</h2>

    <div class="phases__list">
      {% for block in section.blocks %}
        <div class="phases__item" {{ block.shopify_attributes }}>
          <div class="phases__left">
            <div class="phases__num">{% if forloop.index < 10 %}0{% endif %}{{ forloop.index }}</div>
            {% if block.settings.duration != blank %}
              <div class="phases__duration">{{ block.settings.duration }}</div>
            {% endif %}
          </div>
          <div class="phases__content">
            {% if block.settings.phase_label != blank %}
              <div class="phases__phase-label">{{ block.settings.phase_label }}</div>
            {% endif %}
            <h3 class="phases__title">{{ block.settings.title }}</h3>
            <p class="phases__text">{{ block.settings.text }}</p>
          </div>
        </div>
      {% endfor %}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Phases Section",
  "settings": [
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#faf8f4"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#3a3631"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent Color",
      "default": "#2fb5a0"
    },
    {
      "type": "color",
      "id": "divider_color",
      "label": "Divider Color",
      "default": "#e4dfd6"
    },
    {
      "type": "text",
      "id": "top_label",
      "label": "Top Label",
      "default": "So funktioniert es"
    },
    {
      "type": "html",
      "id": "heading",
      "label": "Heading (use <em> for accent)",
      "default": "Dein Weg in <em>drei Phasen</em>"
    }
  ],
  "blocks": [
    {
      "type": "phase",
      "name": "Phase",
      "settings": [
        {
          "type": "color",
          "id": "icon_color",
          "label": "Icon Color",
          "default": "#2fb5a0"
        },
        {
          "type": "text",
          "id": "phase_label",
          "label": "Phase Label",
          "default": "Phase 1 · Starten"
        },
        {
          "type": "text",
          "id": "duration",
          "label": "Duration (under number)",
          "default": "2 Tage"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Stoffwechsel auf Fettverbrennung umstellen"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Description",
          "default": "Beschreibung dieser Phase."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Phases Section",
      "blocks": [
        { "type": "phase", "settings": { "icon_color": "#3a3631", "phase_label": "Phase 1 · Starten", "duration": "2 Tage", "title": "Stoffwechsel auf Fettverbrennung umstellen", "text": "Zwei Tage lang ersetzt Du alle Mahlzeiten durch den Precon Start Shake. Dein Stoffwechsel stellt um, die Fettverbrennung wird aktiviert. Du bist mit allen Nährstoffen versorgt und fühlst Dich satt." } },
        { "type": "phase", "settings": { "icon_color": "#2fb5a0", "phase_label": "Phase 2 · Abnehmen", "duration": "4 Wochen", "title": "Zwei Mahlzeiten ersetzen, eine selbst kochen", "text": "Zwei Mahlzeiten pro Tag werden durch Shake, Riegel oder Suppe ersetzt. Abends genießt Du eine ausgewogene Mahlzeit nach dem Precon-Prinzip. Erste sichtbare Ergebnisse zeigen sich meist nach 7 bis 10 Tagen." } },
        { "type": "phase", "settings": { "icon_color": "#2fb5a0", "phase_label": "Phase 3 · Halten", "duration": "ab Woche 5", "title": "Eine Mahlzeit täglich, dauerhaft im Gleichgewicht", "text": "Wenn Du Dein Zielgewicht erreichst, ersetzt Du nur noch eine Mahlzeit täglich. Nach 4 bis 6 Wochen kannst Du komplett zu normalen Mahlzeiten zurückkehren und bleibst stabil." } }
      ]
    }
  ]
}
{% endschema %}