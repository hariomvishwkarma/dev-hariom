      "default": "02 — Berechnung"
    },
    {
      "type":    "text",
      "id":      "step2_title",
      "label":   "Titel (kursiv)",
      "default": "Dein persönlicher Bedarf."
    },
    {
      "type":    "textarea",
      "id":      "step2_text",
      "label":   "Beschreibung",
      "default": "Wir berechnen Deinen individuellen Tagesbedarf mit der wissenschaftlich anerkannten Mifflin-St-Jeor-Formel."
    },

    { "type": "header", "content": "3️⃣ Schritt 3" },

    {
      "type":    "text",
      "id":      "step3_label",
      "label":   "Label",
      "default": "03 — Dein Plan"
    },
    {
      "type":    "text",
      "id":      "step3_title",
      "label":   "Titel (kursiv)",
      "default": "Abnehmen ohne Hunger."
    },
    {
      "type":    "textarea",
      "id":      "step3_text",
      "label":   "Beschreibung",
      "default": "Du erhältst einen Mahlzeitenplan, der gezielt unter Deinem Bedarf liegt — so nimmst Du ab, ohne zu verzichten."
    }

  ],
  "presets": [
    {
      "name": "Rechnung"
    }
