      "label":   "Label",
      "default": "01 — Deine Angaben"
    },
    {
      "type":    "text",
      "id":      "step1_title",
      "label":   "Titel (kursiv)",
      "default": "Wer bist Du?"
    },
    {
      "type":    "textarea",
      "id":      "step1_text",
      "label":   "Beschreibung",
      "default": "Geschlecht, Alter, Größe, Gewicht und Aktivität — alles, was Deinen Körper einzigartig macht."
    },

    { "type": "header", "content": "2️⃣ Schritt 2" },

    {
      "type":    "text",
      "id":      "step2_label",
