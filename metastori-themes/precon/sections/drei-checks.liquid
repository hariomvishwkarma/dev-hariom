{%- comment -%}
  sections/kennst-du-das.liquid
  "Kennst Du das?" – Pain-Point Section (Karten-Grid)
  Fonts: Figtree 300/400/600 + Playfair Display 500 italic
  Colors: fully customisable via schema settings
{%- endcomment -%}

{%- liquid
  assign c_bg       = section.settings.color_bg
  assign c_ink      = section.settings.color_ink
  assign c_mid      = section.settings.color_mid
  assign c_accent   = section.settings.color_accent
  assign c_icon_bg  = section.settings.color_icon_bg
  assign c_card_bg  = section.settings.color_card_bg
  assign c_signal   = section.settings.color_signal
-%}

<div id="kdd-{{ section.id }}" class="kdd">
  <div class="kdd__inner">

    <header class="kdd__header">
      {%- if section.settings.eyebrow != blank -%}
        <p class="kdd__eyebrow">
          <span class="kdd__eyebrow-rule"></span>
          {{ section.settings.eyebrow }}
          <span class="kdd__eyebrow-rule"></span>
        </p>
      {%- endif -%}

      <h2 class="kdd__heading">
        {%- if section.settings.heading_line1 != blank -%}
          {{ section.settings.heading_line1 }}<br>
        {%- endif -%}
        {%- if section.settings.heading_line2 != blank -%}
          <em>{{ section.settings.heading_line2 }}</em>
        {%- endif -%}
      </h2>

      {%- if section.settings.subtitle != blank -%}
        <p class="kdd__subtitle">{{ section.settings.subtitle }}</p>
      {%- endif -%}
    </header>

    {%- if section.blocks.size > 0 -%}
      <div class="kdd__sep" aria-hidden="true">
        <span class="kdd__sep-line"></span>
        <span class="kdd__sep-mark"></span>
        <span class="kdd__sep-line"></span>
      </div>

      <div class="kdd__grid">
        {%- for block in section.blocks -%}
          {%- if block.type == "point" -%}
            <div class="kdd__card" {{ block.shopify_attributes }}>
              <div class="kdd__icon-wrap">
                {%- case block.settings.icon -%}
                  {%- when "plan" -%}
                    <svg viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
                      <path d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2"/>
                      <rect x="9" y="3" width="6" height="4" rx="1.5"/>
                      <line x1="9" y1="12" x2="15" y2="12"/>
                      <line x1="9" y1="16" x2="13" y2="16"/>
                    </svg>
                  {%- when "person-x" -%}
                    <svg viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
                      <circle cx="10" cy="7" r="4"/>
                      <path d="M4 19v-1a5 5 0 015-5h2"/>
                      <line x1="17" y1="17" x2="21" y2="21"/>
                      <line x1="21" y1="17" x2="17" y2="21"/>
                    </svg>
                  {%- when "cycle" -%}
                    <svg viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
                      <path d="M23 4v6h-6"/>
                      <path d="M1 20v-6h6"/>
                      <path d="M3.51 9a9 9 0 0114.85-3.36L23 10M1 14l4.64 4.36A9 9 0 0020.49 15"/>
                    </svg>
                  {%- when "clock" -%}
                    <svg viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
                      <circle cx="12" cy="12" r="10"/>
                      <polyline points="12 6 12 12 16 14"/>
                    </svg>
                  {%- when "question" -%}
                    <svg viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
                      <circle cx="12" cy="12" r="10"/>
                      <path d="M9.09 9a3 3 0 015.83 1c0 2-3 3-3 3"/>
                      <line x1="12" y1="17" x2="12.01" y2="17"/>
                    </svg>
                {%- endcase -%}
              </div>
              {%- if block.settings.title != blank -%}
                <h3 class="kdd__card-title">{{ block.settings.title }}</h3>
              {%- endif -%}
              {%- if block.settings.text != blank -%}
                <p class="kdd__card-text">{{ block.settings.text }}</p>
              {%- endif -%}
            </div>
          {%- endif -%}
        {%- endfor -%}
      </div>
    {%- endif -%}

  </div>
</div>

<style>
@import url('https://fonts.googleapis.com/css2?family=Figtree:wght@300;400;600&family=Playfair+Display:ital,wght@1,500&display=swap');

#kdd-{{ section.id }} {
  --bg:      {{ c_bg }};
  --ink:     {{ c_ink }};
  --mid:     {{ c_mid }};
  --accent:  {{ c_accent }};
  --icon-bg: {{ c_icon_bg }};
  --card-bg: {{ c_card_bg }};
  --signal:  {{ c_signal }};
  --rule:    rgba(86,71,58,0.08);
  --shadow:  rgba(86,71,58,0.09);
}

#kdd-{{ section.id }},
#kdd-{{ section.id }} * { box-sizing: border-box; }

#kdd-{{ section.id }} {
  background: var(--bg);
  font-family: 'Figtree', sans-serif;
  -webkit-font-smoothing: antialiased;
  padding: 4rem 1.5rem;
}

/* ── Inner ── */
#kdd-{{ section.id }} .kdd__inner {
  max-width: 1160px;
  margin: 0 auto;
}

/* ── Header ── */
#kdd-{{ section.id }} .kdd__header {
  text-align: center;
  max-width: 620px;
  margin: 0 auto;
}

#kdd-{{ section.id }} .kdd__eyebrow {
  display: inline-flex;
  align-items: center;
  gap: 10px;
  font-size: 11px;
  font-weight: 600;
  letter-spacing: 0.24em;
  text-transform: uppercase;
  color: var(--accent);
  margin-bottom: 1rem;
}

#kdd-{{ section.id }} .kdd__eyebrow-rule {
  display: block;
  width: 22px;
  height: 1px;
  background: currentColor;
  opacity: 0.45;
}

#kdd-{{ section.id }} .kdd__heading {
  font-family: 'Figtree', sans-serif;
  font-size: clamp(32px, 4vw, 48px);
  font-weight: 300;
  color: var(--ink);
  line-height: 1.06;
  letter-spacing: -0.026em;
  text-wrap: balance;
  margin-bottom: 1rem;
}

#kdd-{{ section.id }} .kdd__heading em {
  font-family: 'Playfair Display', serif;
  font-style: italic;
  font-weight: 500;
  display: block;
  letter-spacing: -0.02em;
}

#kdd-{{ section.id }} .kdd__subtitle {
  font-size: clamp(15px, 1.15vw, 16.5px);
  font-weight: 400;
  line-height: 1.8;
  color: var(--mid);
}

/* ── Separator ── */
#kdd-{{ section.id }} .kdd__sep {
  display: flex;
  align-items: center;
  gap: 14px;
  max-width: 280px;
  margin: 2.5rem auto;
}

#kdd-{{ section.id }} .kdd__sep-line {
  flex: 1;
  height: 1px;
  background: var(--rule);
}

#kdd-{{ section.id }} .kdd__sep-mark {
  width: 5px;
  height: 5px;
  border-radius: 50%;
  background: var(--accent);
  opacity: 0.3;
}

/* ── Cards ── */
#kdd-{{ section.id }} .kdd__grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 1rem;
}

#kdd-{{ section.id }} .kdd__card {
  background: var(--card-bg);
  border-radius: 14px;
  border: 1px solid var(--rule);
  border-top: 2.5px solid var(--signal);
  padding: 1.5rem 1.5rem 1.75rem;
  transition: transform 0.22s ease, box-shadow 0.22s ease;
}

#kdd-{{ section.id }} .kdd__card:hover {
  transform: translateY(-3px);
  box-shadow: 0 14px 40px var(--shadow);
}

#kdd-{{ section.id }} .kdd__icon-wrap {
  width: 44px;
  height: 44px;
  border-radius: 11px;
  background: var(--icon-bg);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 1rem;
}

#kdd-{{ section.id }} .kdd__icon-wrap svg {
  width: 20px;
  height: 20px;
  stroke: var(--accent);
}

#kdd-{{ section.id }} .kdd__card-title {
  font-size: 16px;
  font-weight: 600;
  color: var(--ink);
  letter-spacing: -0.01em;
  margin-bottom: 0.55rem;
  line-height: 1.3;
}

#kdd-{{ section.id }} .kdd__card-text {
  font-size: 14.5px;
  line-height: 1.72;
  color: var(--mid);
}

/* ── Responsive ── */
@media (max-width: 768px) {
  #kdd-{{ section.id }} { padding: 2.5rem 1rem; }

  #kdd-{{ section.id }} .kdd__grid {
    grid-template-columns: 1fr;
    max-width: 440px;
    margin-inline: auto;
  }

  #kdd-{{ section.id }} .kdd__sep { margin: 2rem auto; }
}

@media (prefers-reduced-motion: reduce) {
  #kdd-{{ section.id }} .kdd__card { transition: none; }
}
</style>

{% schema %}
{
  "name": "Kennst Du Das",
  "tag": "section",
  "settings": [
    { "type": "header", "content": "Inhalt" },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Kennst du das"
    },
    {
      "type": "text",
      "id": "heading_line1",
      "label": "Überschrift Zeile 1",
      "default": "Kennst Du"
    },
    {
      "type": "text",
      "id": "heading_line2",
      "label": "Überschrift Zeile 2 (kursiv, Playfair)",
      "default": "das?"
    },
    {
      "type": "textarea",
      "id": "subtitle",
      "label": "Untertitel",
      "default": "Du kaufst einen Shake, trinkst ihn ein paar Tage – und dann? Keine Struktur, keine Abwechslung, keine Ahnung wie es weitergehen soll. Der Shake landet im Schrank."
    },
    { "type": "header", "content": "Farben" },
    { "type": "color", "id": "color_bg",      "label": "Hintergrund",           "default": "#FAF9F5" },
    { "type": "color", "id": "color_ink",     "label": "Text dunkel",           "default": "#56473A" },
    { "type": "color", "id": "color_mid",     "label": "Text gedimmt",          "default": "#8C7C70" },
    { "type": "color", "id": "color_accent",  "label": "Akzentfarbe (Teal)",    "default": "#3DADBB" },
    { "type": "color", "id": "color_icon_bg", "label": "Icon-Hintergrund",      "default": "#EFECE4" },
    { "type": "color", "id": "color_card_bg", "label": "Karten-Hintergrund",    "default": "#ffffff" },
    { "type": "color", "id": "color_signal",  "label": "Karten-Akzentlinie",    "default": "#e07b3a" }
  ],
  "blocks": [
    {
      "type": "point",
      "name": "Schmerzpunkt",
      "limit": 3,
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            { "value": "plan",     "label": "Kein Plan (Clipboard)" },
            { "value": "person-x", "label": "Keine Motivation (Person ✕)" },
            { "value": "cycle",    "label": "Kein Danach (Zyklus)" },
            { "value": "clock",    "label": "Uhr" },
            { "value": "question", "label": "Fragezeichen" }
          ],
          "default": "plan"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Titel",
          "default": "Kein klarer Plan"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Beschreibung",
          "default": "Wann trinken? Wie oft? Was sonst essen? Ohne Anleitung fehlt die Orientierung – und der Alltag gewinnt."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Kennst Du Das",
      "blocks": [
        {
          "type": "point",
          "settings": {
            "icon": "plan",
            "title": "Kein klarer Plan",
            "text": "Wann trinken? Wie oft? Was sonst essen? Ohne Anleitung fehlt die Orientierung – und der Alltag gewinnt."
          }
        },
        {
          "type": "point",
          "settings": {
            "icon": "person-x",
            "title": "Schnell langweilig",
            "text": "Nach 5 Tagen derselbe Geschmack – die Routine bricht, die Motivation sinkt und die Ausreden mehren sich."
          }
        },
        {
          "type": "point",
          "settings": {
            "icon": "cycle",
            "title": "Kein Danach",
            "text": "Was kommt nach dem Shake? Ohne klaren Übergang fallen viele zurück in alte Gewohnheiten."
          }
        }
      ]
    }
  ]
}
{% endschema %}