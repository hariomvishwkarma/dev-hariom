</div><!-- /precon-rechner -->

<script>
(function() {
  // ── Namespaced state object ──
  const state = {
    gender: null, age: null, height: null,
    weight: null, targetWeight: null,
    beruf: null, sport: null,
    firstName: '', lastName: '', email: '', consent: false,
    current: 1
  };

  // ── NAVIGATION ──
  function preconGoStep(n, back) {
    document.getElementById('precon-stepLoading').classList.remove('visible');
    document.getElementById('precon-loadingBarFill').style.transition = 'none';
    document.getElementById('precon-loadingBarFill').style.width = '0%';
    document.getElementById('precon-loadingReview').classList.remove('visible');
    document.querySelector('.precon-rechner').classList.remove('results-mode');

    const cur = document.getElementById(
      state.current === 8  ? 'precon-stepResult' :
      state.current === 9  ? 'precon-stepAbnehmplan' :
      state.current === 10 ? 'precon-stepPhasen' :
      'precon-step' + state.current
    );
    cur.classList.remove('visible');

    const next = document.getElementById('precon-step' + n);
    next.classList.remove('slide-back');
    if (back) next.classList.add('slide-back');
    next.classList.add('visible');
    state.current = n;
    preconUpdateProgress(n);
    preconScrollToTop();
  }
  window.preconGoStep = preconGoStep;

  function preconShowPage(id) {
    ['precon-stepResult','precon-stepAbnehmplan','precon-stepLoading','precon-stepPhasen'].forEach(p => document.getElementById(p).classList.remove('visible'));
    for (let i = 1; i <= 7; i++) document.getElementById('precon-step'+i).classList.remove('visible');
    document.getElementById(id).classList.add('visible');
    const isResults = ['precon-stepResult','precon-stepAbnehmplan','precon-stepPhasen','precon-stepLoading'].includes(id);
    document.querySelector('.precon-rechner').classList.toggle('results-mode', isResults);
    if (id === 'precon-stepResult')     state.current = 8;
    if (id === 'precon-stepAbnehmplan') state.current = 9;
    if (id === 'precon-stepPhasen') {
      state.current = 10;
      const showWeeks  = state._showWeeks || 0;
      const totalWeeks = state._weeksAbnehm || 0;
      const durationTxt = totalWeeks <= 11
        ? `${showWeeks} ${showWeeks === 1 ? 'Woche' : 'Wochen'}`
        : `12 Wochen (von ${1 + totalWeeks} Wochen gesamt)`;
      document.getElementById('precon-phaseAbnehmDuration').textContent = durationTxt;
      const halteWeeks  = state._halteWeeks || 0;
      const halteSection = document.getElementById('precon-phaseHalteSection');
      if (halteSection) halteSection.style.display = halteWeeks ? 'block' : 'none';
    }
    preconScrollToTop();
  }
  window.preconShowPage = preconShowPage;

  function preconShowResults() {
    const cur = document.getElementById('precon-step' + state.current);
    cur.classList.remove('visible');
    const loader = document.getElementById('precon-stepLoading');
    loader.classList.add('visible');
    document.querySelector('.precon-rechner').classList.add('results-mode');
    preconScrollToTop();
    preconUpdateProgress(8);

    const bar = document.getElementById('precon-loadingBarFill');
    requestAnimationFrame(() => { bar.style.width = '100%'; });

    setTimeout(() => {
      document.getElementById('precon-loadingReview').classList.add('visible');
    }, 2000);

    setTimeout(() => {
      loader.classList.remove('visible');
      document.getElementById('precon-stepResult').classList.add('visible');
      document.getElementById('precon-footerNote').style.display = 'block';
      state.current = 8;
      preconScrollToTop();
    }, 8000);
  }

  function preconScrollToTop() {
    const widget = document.querySelector('.precon-rechner');
    if (widget) {
      const top = widget.getBoundingClientRect().top + window.pageYOffset - 20;
      window.scrollTo({ top: top, behavior: 'smooth' });
    }
  }

  // ── PROGRESS ──
  function preconUpdateProgress(step) {
    for (let i = 1; i <= 7; i++) {
      const dot = document.getElementById('precon-ps' + i);
      dot.className = 'prog-step';
      if (i < step) { dot.classList.add('done'); dot.innerHTML = '✓'; }
      else if (i === step) { dot.classList.add('active'); dot.innerHTML = i; }
      else { dot.innerHTML = i; }
      if (i < 7) {
        const line = document.getElementById('precon-pl' + i);
        line.className = 'prog-line' + (i < step ? ' done' : '');
      }
    }
  }

  // ── SELECTIONS ──
  function preconSelectGender(g) {
    state.gender = g;
    document.getElementById('precon-btn-frau').classList.toggle('selected', g === 'Frau');
    document.getElementById('precon-btn-mann').classList.toggle('selected', g === 'Mann');
    preconHide('precon-err-gender');
  }
  window.preconSelectGender = preconSelectGender;

  function preconSelectBeruf(val, el) {
    state.beruf = val;
    document.querySelectorAll('#precon-beruf-choices .choice-btn').forEach(b => b.classList.remove('selected'));
    el.classList.add('selected');
    preconHide('precon-err-beruf');
  }
  window.preconSelectBeruf = preconSelectBeruf;

  function preconSelectSport(val, el) {
    state.sport = val;
    document.querySelectorAll('#precon-sport-choices .choice-btn').forEach(b => b.classList.remove('selected'));
    el.classList.add('selected');
    preconHide('precon-err-sport');
  }
  window.preconSelectSport = preconSelectSport;

  function preconToggleConsent() {
    state.consent = !state.consent;
    document.getElementById('precon-consentRow').classList.toggle('checked', state.consent);
    if (state.consent) preconHide('precon-err-consent');
  }
  window.preconToggleConsent = preconToggleConsent;

  // ── HELPERS ──
  function preconShow(id) { document.getElementById(id).classList.add('visible'); }
  function preconHide(id) { document.getElementById(id).classList.remove('visible'); }
  function preconGetNum(id) { return parseFloat(document.getElementById(id).value); }
  function preconMarkErr(id, err) {
    const el = document.getElementById(id);
    if (el) el.classList.toggle('has-error', err);
  }
  function preconBmiCat(bmi) {
    if (bmi < 18.5) return 'Untergewicht';
    if (bmi < 25)   return 'Normalgewicht';
    if (bmi < 30)   return 'Übergewicht';
    if (bmi < 35)   return 'Übergewicht – Adipositas Grad 1';
    if (bmi < 40)   return 'Übergewicht – Adipositas Grad 2';
    return 'Übergewicht – Adipositas Grad 3';
  }

  // ── STEP VALIDATORS ──
  function preconGoStep2() {
    if (!state.gender) { preconShow('precon-err-gender'); return; }
    preconGoStep(2);
  }
  window.preconGoStep2 = preconGoStep2;

  function preconGoStep3() {
    let ok = true;
    const age = preconGetNum('precon-age');
    const h   = preconGetNum('precon-height');
    if (isNaN(age) || age < 18 || age > 100) { preconShow('precon-err-age'); preconMarkErr('precon-age', true); ok = false; }
    else { preconHide('precon-err-age'); preconMarkErr('precon-age', false); state.age = age; }
    if (isNaN(h) || h < 140 || h > 220) { preconShow('precon-err-height'); preconMarkErr('precon-height', true); ok = false; }
    else { preconHide('precon-err-height'); preconMarkErr('precon-height', false); state.height = h; }
    if (ok) preconGoStep(3);
  }
  window.preconGoStep3 = preconGoStep3;

  function preconGoStep4() {
    let ok = true;
    const w = preconGetNum('precon-weight');
    const t = preconGetNum('precon-targetWeight');
    if (isNaN(w) || w < 45 || w > 200) {
      if (!isNaN(w) && w > 200) { preconShow('precon-err-weight-high'); preconHide('precon-err-weight-low'); }
      else { preconShow('precon-err-weight-low'); preconHide('precon-err-weight-high'); }
      preconMarkErr('precon-weight', true); ok = false;
    } else { preconHide('precon-err-weight-low'); preconHide('precon-err-weight-high'); preconMarkErr('precon-weight', false); state.weight = w; }

    preconHide('precon-err-target'); preconHide('precon-err-target-equal'); preconHide('precon-err-target-high'); preconHide('precon-err-target-bmi'); preconMarkErr('precon-targetWeight', false);
    if (isNaN(t) || t < 45) {
      preconShow('precon-err-target'); preconMarkErr('precon-targetWeight', true); ok = false;
    } else if (!isNaN(w) && t === w) {
      preconShow('precon-err-target-equal'); preconMarkErr('precon-targetWeight', true); ok = false;
    } else if (!isNaN(w) && t > w) {
      preconShow('precon-err-target-high'); preconMarkErr('precon-targetWeight', true); ok = false;
    } else if (!isNaN(w) && state.height) {
      const hm = state.height / 100;
      const targetBmi = t / (hm * hm);
      if (targetBmi < 18.5) {
        const minWeight = Math.ceil(18.5 * hm * hm * 10) / 10;
        document.getElementById('precon-err-target-bmi').textContent =
          'Dein Zielgewicht würde Dich in den Untergewicht-Bereich bringen (BMI unter 18,5). ' +
          'Bitte wähle ein Zielgewicht von mindestens ' + minWeight.toFixed(1).replace('.', ',') + ' kg.';
        preconShow('precon-err-target-bmi'); preconMarkErr('precon-targetWeight', true); ok = false;
      } else { state.targetWeight = t; }
    } else { state.targetWeight = t; }
    if (ok) preconGoStep(4);
  }
  window.preconGoStep4 = preconGoStep4;

  function preconGoStep5() {
    if (!state.beruf) { preconShow('precon-err-beruf'); return; }
    preconGoStep(5);
  }
  window.preconGoStep5 = preconGoStep5;

  function preconGoStep6() {
    if (!state.sport) { preconShow('precon-err-sport'); return; }
    preconGoStep(6);
  }
  window.preconGoStep6 = preconGoStep6;

  function preconGoStep7() {
    let ok = true;
    const fn = document.getElementById('precon-firstName').value.trim();
    const ln = document.getElementById('precon-lastName').value.trim();
    if (!fn) { preconShow('precon-err-firstName'); ok = false; } else { preconHide('precon-err-firstName'); state.firstName = fn; }
    if (!ln) { preconShow('precon-err-lastName'); ok = false; }  else { preconHide('precon-err-lastName'); state.lastName = ln; }
    if (ok) preconGoStep(7);
  }
  window.preconGoStep7 = preconGoStep7;

  // ── CALCULATE ──
  function preconCalculate() {
    let ok = true;
    const em = document.getElementById('precon-email').value.trim();
    const emailOk = /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(em);
    if (!emailOk) { preconShow('precon-err-email'); preconMarkErr('precon-email', true); ok = false; }
    else { preconHide('precon-err-email'); preconMarkErr('precon-email', false); state.email = em; }
    if (!state.consent) { preconShow('precon-err-consent'); ok = false; }
    if (!ok) return;

    const w = state.weight, h = state.height / 100, a = state.age, tw = state.targetWeight;
    let bmr;
    if (state.gender === 'Frau') bmr = (0.047 * w - 0.01452 * a + 3.21) * 239;
    else bmr = (0.047 * w + 1.009 - 0.01452 * a + 3.21) * 239;

    const pal      = state.beruf + state.sport;
    const leistung = (pal - 1) * bmr;
    const total    = bmr + leistung;
    state._total   = total;
    state._pal     = pal;
    state._bmiC    = w / (h * h);
    const precon   = total * 0.33;
    const bmiC     = w / (h * h);
    const bmiT     = tw / (h * h);

    document.getElementById('precon-resGreeting').textContent = 'Hallo, ' + state.firstName + '!';
    document.getElementById('precon-resBmiCurrent').innerHTML = bmiC.toFixed(1);
    document.getElementById('precon-resBmiCurrentCat').textContent = preconBmiCat(bmiC);
    document.getElementById('precon-resBmiTarget').innerHTML = bmiT.toFixed(1);

    const BMI_MIN = 15, BMI_MAX = 42;
    const bmiPct = 2 + (Math.min(BMI_MAX, Math.max(BMI_MIN, bmiC)) - BMI_MIN) / (BMI_MAX - BMI_MIN) * 96;
    document.getElementById('precon-bmiNeedle').style.left = bmiPct.toFixed(1) + '%';
    document.getElementById('precon-resBmr').innerHTML     = Math.round(bmr)     + '<span class="res-unit">kcal</span>';
    document.getElementById('precon-resLeistung').innerHTML = Math.round(leistung) + '<span class="res-unit">kcal</span>';
    document.getElementById('precon-resTotal').innerHTML    = Math.round(total)    + '<span class="res-unit">kcal/Tag</span>';
    document.getElementById('precon-resPrecon').innerHTML   = Math.round(precon)   + '<span class="res-unit">kcal</span>';

    preconShowResults();
  }
  window.preconCalculate = preconCalculate;

  // ── ABNEHMPLAN ──
  let preconWeightChartInstance = null;

  function preconShowAbnehmplan() {
    const w     = state.weight;
    const tw    = state.targetWeight;
    const total = state._total;
    const h     = state.height / 100;
    const diff  = w - tw;
    const bmiT  = (tw / (h * h)).toFixed(1);

    const startDays        = 2;
    const startIntake      = 885;
    const startDeficitDay  = total - startIntake;
    const startLossKg      = (startDeficitDay * startDays) / 7000;
    const preconIntake     = 235 + 235 + (total / 3);
    const dailyDeficit     = total - preconIntake;
    const weeklyLossKg     = (dailyDeficit * 7) / 7000;
    const bmiC             = state._bmiC || (w / (h * h));
    const pal              = state._pal  || (state.beruf + state.sport);
    const divisor          = state.gender === 'Mann' ? 20 : 25;
    const week1TotalLoss   = (bmiC / divisor) + (pal - 1.3);
    const weightAfterStart = w - startLossKg;
    const weightAfterWeek1 = w - week1TotalLoss;
    const remainingAfterW1 = weightAfterWeek1 - tw;
    const weeksAbnehm      = remainingAfterW1 > 0 ? Math.ceil(remainingAfterW1 / weeklyLossKg) : 0;
    const totalActiveWeeks = weeksAbnehm > 0 ? 1 + weeksAbnehm : 1;
    const showWeeks        = totalActiveWeeks <= 12 ? totalActiveWeeks : 12;
    const halteWeeks       = totalActiveWeeks <= 12 ? 4 : 0;
    const lossInPeriod     = +(week1TotalLoss + weeklyLossKg * (showWeeks - 1)).toFixed(1);
    const weightAtEnd      = +(w - lossInPeriod).toFixed(1);

    state._startLossKg      = +startLossKg.toFixed(2);
    state._weightAfterStart = +weightAfterStart.toFixed(2);
    state._week1TotalLoss   = +week1TotalLoss.toFixed(2);
    state._weightAfterWeek1 = +weightAfterWeek1.toFixed(2);
    state._weeksAbnehm      = weeksAbnehm;
    state._showWeeks        = showWeeks;
    state._weeklyLossKg     = weeklyLossKg;
    state._lossInPeriod     = lossInPeriod;
    state._weightAtEnd      = weightAtEnd;
    state._halteWeeks       = halteWeeks;

    let introHTML = `Dein Zielgewicht liegt bei <strong>${tw} kg</strong>, was einer Gewichtsabnahme von <strong>${diff.toFixed(1)} kg</strong> entspricht. Dies würde Deinen BMI auf <strong>${bmiT}</strong> bringen.<br><br>`;
    if (diff <= 12) {
      introHTML += `Das ist ein sehr realistisches Ziel, das Du mit dem Precon-Plan <strong>innerhalb von ${totalActiveWeeks} Wochen</strong> erreichen kannst. Bleib konsequent – Du bist auf dem richtigen Weg!`;
    } else if (diff <= 24) {
      introHTML += `Das ist ein realistisches Ziel, das jedoch einen <strong>längeren Zeithorizont</strong> erfordert. Wir haben Dir unten einen Plan für die ersten 12 Wochen berechnet. Du kannst danach jederzeit zurückkommen und einen neuen Plan berechnen.`;
    } else {
      introHTML += `Das ist ein erreichbares, aber <strong>ambitioniertes Ziel</strong>. Wir haben Dir unten einen Plan für die ersten 12 Wochen berechnet. Du kannst danach jederzeit zurückkommen und einen neuen Plan berechnen.`;
    }
    document.getElementById('precon-planIntro').innerHTML = introHTML;

    const labels = ['Woche 0'];
    const data   = [w];
    labels.push('Woche 1');
    data.push(+(w - week1TotalLoss).toFixed(2));
    for (let i = 2; i <= showWeeks; i++) {
      labels.push('Woche ' + i);
      data.push(+(w - week1TotalLoss - weeklyLossKg * (i - 1)).toFixed(2));
    }
    const weightAtHalte = data[data.length - 1];
    for (let i = 1; i <= halteWeeks; i++) {
      labels.push('Woche ' + (showWeeks + i));
      data.push(weightAtHalte);
    }
    const totalChartWeeks = showWeeks + halteWeeks;

    document.getElementById('precon-planHighlightLabel').textContent = `Gewichtsabnahme nach ${showWeeks} Wochen`;
    document.getElementById('precon-planHighlightValue').innerHTML   = lossInPeriod + '<span class="res-unit">kg</span>';
    document.getElementById('precon-planHighlightSub').textContent   = `Von ${w} kg auf ${weightAtEnd} kg`;

    if (preconWeightChartInstance) preconWeightChartInstance.destroy();
    const ctx = document.getElementById('precon-weightChart').getContext('2d');
    const chartPlugins = [];

    chartPlugins.push({
      id: 'preconStartPhaseLabel',
      afterDraw(chart) {
        const { ctx: c, chartArea, scales } = chart;
        const xScale = scales.x;
        const x0 = xScale.getPixelForValue(0);
        const x1 = xScale.getPixelForValue(1);
        c.save();
        const xStart = x0 + (x1 - x0) * (2/7);
        c.strokeStyle = 'rgba(86,71,58,0.3)'; c.lineWidth = 1; c.setLineDash([3, 3]);
        c.beginPath(); c.moveTo(xStart, chartArea.top); c.lineTo(xStart, chartArea.bottom); c.stroke();
        c.setLineDash([]);
        c.fillStyle = '#3DADBB'; c.font = '600 11px DM Sans, sans-serif'; c.textAlign = 'left';
        c.fillText('Startphase', xStart + 5, chartArea.top + 14);
        c.restore();
      }
    });

    if (halteWeeks) {
      chartPlugins.push({
        id: 'preconHalteZone',
        afterDraw(chart) {
          const { ctx: c, chartArea, scales } = chart;
          const x0 = scales.x.getPixelForValue(showWeeks);
          const x1 = scales.x.getPixelForValue(totalChartWeeks);
          c.save();
          c.fillStyle = 'rgba(61,173,187,0.07)';
          c.fillRect(x0, chartArea.top, x1 - x0, chartArea.bottom - chartArea.top);
          c.strokeStyle = 'rgba(61,173,187,0.45)'; c.lineWidth = 1.5; c.setLineDash([4, 3]);
          c.beginPath(); c.moveTo(x0, chartArea.top); c.lineTo(x0, chartArea.bottom); c.stroke();
          c.setLineDash([]);
          c.fillStyle = '#3DADBB'; c.font = '600 11px DM Sans, sans-serif'; c.textAlign = 'center';
          c.fillText('Haltephase', (x0 + x1) / 2, chartArea.top + 14);
          c.restore();
        }
      });
    }

    preconWeightChartInstance = new Chart(ctx, {
      type: 'line',
      plugins: chartPlugins,
      data: {
        labels,
        datasets: [
          {
            label: 'Gewicht (kg)',
            data: data.map((v, i) => i <= showWeeks ? v : null),
            borderColor: '#3DADBB', backgroundColor: 'rgba(61,173,187,0.10)',
            borderWidth: 2.5, pointBackgroundColor: '#3DADBB',
            pointRadius: totalChartWeeks <= 16 ? 4 : 2, pointHoverRadius: 6,
            fill: true, tension: 0.35, spanGaps: false
          },
          {
            label: 'Haltephase',
            data: halteWeeks ? data.map((v, i) => i >= showWeeks ? v : null) : [],
            borderColor: '#3DADBB', backgroundColor: 'transparent',
            borderWidth: 2.5, pointBackgroundColor: 'rgba(61,173,187,0.45)',
            pointBorderColor: '#3DADBB',
            pointRadius: totalChartWeeks <= 16 ? 4 : 2, pointHoverRadius: 6,
            fill: false, tension: 0, spanGaps: false
          }
        ]
      },
      options: {
        responsive: true,
        plugins: {
          legend: { display: false },
          tooltip: { callbacks: { label: ctx => ctx.parsed.y.toFixed(1) + ' kg' } }
        },
        scales: {
          x: { ticks: { font: { family: 'DM Sans', size: 11 }, color: '#8a7b70', maxRotation: 45, autoSkip: true, maxTicksLimit: 13 }, grid: { color: 'rgba(0,0,0,0.05)' } },
          y: { ticks: { font: { family: 'DM Sans', size: 11 }, color: '#8a7b70', callback: v => v + ' kg' }, grid: { color: 'rgba(0,0,0,0.05)' } }
        }
      }
    });

    preconShowPage('precon-stepAbnehmplan');
  }
  window.preconShowAbnehmplan = preconShowAbnehmplan;

  // ── PDF DOWNLOAD ──
  const PRECON_LOGO_B64 = '';

  function preconDownloadPDF() {
    const { jsPDF } = window.jspdf;
    const doc = new jsPDF({ unit: 'mm', format: 'a4' });
    const W = 210, margin = 18;
    const col = '#56473A', accent = '#3DADBB', soft = '#8a7b70', beige = '#EFECE4', dark = '#56473A';
    const firstName = state.firstName || 'Dein';
    let y = 0;

    function hexRgb(hex) { return [parseInt(hex.slice(1,3),16), parseInt(hex.slice(3,5),16), parseInt(hex.slice(5,7),16)]; }
    function setFill(hex) { const [r,g,b] = hexRgb(hex); doc.setFillColor(r,g,b); }
    function setDraw(hex) { const [r,g,b] = hexRgb(hex); doc.setDrawColor(r,g,b); }
    function setTxt(hex)  { const [r,g,b] = hexRgb(hex); doc.setTextColor(r,g,b); }

    function drawHeader() {
      setFill(dark); doc.rect(0, 0, W, 26, 'F');
      try { doc.addImage('data:image/png;base64,' + PRECON_LOGO_B64, 'PNG', margin, 4, 38, 9.5); }
      catch(e) { setTxt('#FFFFFF'); doc.setFontSize(16); doc.setFont('helvetica','bold'); doc.text('precon', margin, 14); }
      const subtitle = firstName + '\u2019s pers\u00F6nlicher Abnehmplan';
      doc.setFontSize(8); doc.setFont('helvetica','normal'); doc.setTextColor(180, 170, 165);
      doc.text(subtitle, margin, 21);
      doc.setFontSize(8); doc.setTextColor(180,170,165);
      doc.text(new Date().toLocaleDateString('de-DE'), W - margin, 10, { align: 'right' });
    }

    const TILE_H = 26, GAP = 4, hw = (W - margin * 2 - GAP) / 2;

    function drawTile(label, value, unit, sub, x, w, bgHex, borderHex) {
      setFill(bgHex);
      if (borderHex) { setDraw(borderHex); doc.roundedRect(x, y, w, TILE_H, 2.5, 2.5, 'FD'); }
      else { setDraw(bgHex); doc.roundedRect(x, y, w, TILE_H, 2.5, 2.5, 'F'); }
      const isDark = bgHex === dark;
      const labelCol = isDark ? '#aaaaaa' : soft;
      const valCol   = isDark ? '#FFFFFF' : col;
      const unitCol  = isDark ? '#aaaaaa' : soft;
      const subCol   = isDark ? '#aaaaaa' : soft;
      setTxt(labelCol); doc.setFontSize(6.5); doc.setFont('helvetica', 'bold');
      doc.text(label.toUpperCase(), x + 5, y + 6);
      const valSize = isDark ? 20 : 17;
      setTxt(valCol); doc.setFontSize(valSize); doc.setFont('helvetica', 'bold');
      doc.text(value, x + 5, y + 18);
      if (unit) {
        doc.setFontSize(valSize);
        const valW = doc.getTextWidth(value);
        doc.setFontSize(8); doc.setFont('helvetica', 'normal'); setTxt(unitCol);
        doc.text(unit, x + 5 + valW + 2, y + 18);
      }
      if (sub) { setTxt(subCol); doc.setFontSize(7); doc.setFont('helvetica', 'normal'); doc.text(sub, x + 5, y + 23.5); }
    }

    // PAGE 1
    drawHeader(); y = 34;
    const salutation = state.gender === 'Mann' ? 'Lieber' : 'Liebe';
    const thankYouLine1 = salutation + ' ' + (state.firstName || 'Dir') + ',';
    const thankYouLine2 = 'vielen Dank, dass Du Deinen pers\u00F6nlichen Abnehmplan ausgef\u00FCllt hast! Wir freuen uns, Dich auf Deinem Weg zu Deinem Zielgewicht zu begleiten. Bei Fragen stehen wir Dir jederzeit unter team@precon.info zur Verf\u00FCgung.';
    setTxt(col); doc.setFontSize(8.5); doc.setFont('helvetica', 'bold');
    doc.text(thankYouLine1, margin, y); y += 5.5;
    doc.setFont('helvetica', 'normal');
    const thankLines = doc.splitTextToSize(thankYouLine2, W - margin * 2);
    doc.text(thankLines, margin, y); y += thankLines.length * 4.6 + 8;

    setTxt(accent); doc.setFontSize(15); doc.setFont('times', 'bold');
    doc.text('Deine Ergebnisse', margin, y); y += 10;

    const bmiC  = (state.weight / Math.pow(state.height / 100, 2)).toFixed(1);
    const bmiT2 = (state.targetWeight / Math.pow(state.height / 100, 2)).toFixed(1);
    drawTile('BMI Aktuell',     bmiC,  '',  preconBmiCat(parseFloat(bmiC)), margin,          hw, beige, null);
    drawTile('BMI Zielgewicht', bmiT2, '',  '',                              margin + hw + GAP, hw, beige, null);
    y += TILE_H + GAP;

    const bmrVal = document.getElementById('precon-resBmr').textContent.replace('kcal','').trim();
    const leiVal = document.getElementById('precon-resLeistung').textContent.replace('kcal','').trim();
    drawTile('Grundumsatz',     bmrVal, 'kcal', 'Ruhebedarf',            margin,          hw, beige, null);
    drawTile('Leistungsumsatz', leiVal, 'kcal', 'Aktivit\u00E4tszusatz', margin + hw + GAP, hw, beige, null);
    y += TILE_H + GAP;

    const totVal = document.getElementById('precon-resTotal').textContent.replace('kcal/Tag','').trim();
    drawTile('Dein t\u00E4glicher Energiebedarf', totVal, 'kcal/Tag', 'Grundumsatz + Leistungsumsatz', margin, W - margin * 2, dark, null);
    y += TILE_H + GAP;

    const preVal = document.getElementById('precon-resPrecon').textContent.replace('kcal','').trim();
    setFill('#e8f7f9'); setDraw(accent);
    doc.roundedRect(margin, y, W - margin * 2, TILE_H, 2.5, 2.5, 'FD');
    setTxt(accent); doc.setFontSize(6.5); doc.setFont('helvetica','bold');
    doc.text('PRECON \u2013 DEINE KOCHMAHLZEIT', margin + 5, y + 6);
    setTxt(col); doc.setFontSize(17); doc.setFont('helvetica','bold');
    doc.text(preVal, margin + 5, y + 18);
    doc.setFontSize(17);
    const preValW = doc.getTextWidth(preVal);
    doc.setFontSize(8); doc.setFont('helvetica','normal'); setTxt(soft);
    doc.text('kcal', margin + 5 + preValW + 2, y + 18);
    setTxt(soft); doc.setFontSize(7); doc.setFont('helvetica','normal');
    doc.text('33% Deines Gesamtbedarfs', margin + 5, y + 23.5);
    y += TILE_H + GAP;

    // PAGE 2
    doc.addPage(); drawHeader(); y = 34 + 16;
    setTxt(accent); doc.setFontSize(15); doc.setFont('times', 'bold');
    doc.text('Dein Abnehmplan', margin, y); y += 10;

    const introText = document.getElementById('precon-planIntro').innerText || '';
    setTxt(col); doc.setFontSize(9); doc.setFont('helvetica', 'normal');
    const introLines = doc.splitTextToSize(introText, W - margin * 2);
    doc.text(introLines, margin, y); y += introLines.length * 4.8 + 7;

    const chartCanvas = document.getElementById('precon-weightChart');
    if (chartCanvas) {
      const naturalW = chartCanvas.width  || chartCanvas.offsetWidth  || 680;
      const naturalH = chartCanvas.height || chartCanvas.offsetHeight || 220;
      const aspectRatio = naturalH / naturalW;
      const pdfChartW = W - margin * 2;
      const pdfChartH = Math.round(pdfChartW * aspectRatio);
      const chartImg = chartCanvas.toDataURL('image/png', 1.0);
      doc.addImage(chartImg, 'PNG', margin, y, pdfChartW, pdfChartH);
      y += pdfChartH + 7;
    }

    const hlLabel = document.getElementById('precon-planHighlightLabel').textContent;
    const hlValue = document.getElementById('precon-planHighlightValue').textContent;
    const hlSub   = document.getElementById('precon-planHighlightSub').textContent;
    drawTile(hlLabel, hlValue, '', hlSub, margin, W - margin * 2, dark, null);
    y += TILE_H + GAP;

    // PAGE 3
    doc.addPage(); drawHeader(); y = 34 + 16;
    setTxt(accent); doc.setFontSize(15); doc.setFont('times', 'bold');
    doc.text('Dein Phasenplan', margin, y); y += 12;

    const [ar,ag,ab] = hexRgb(accent);
    doc.setFillColor(ar,ag,ab);
    doc.roundedRect(margin, y, 28, 7, 2, 2, 'F');
    doc.setTextColor(255,255,255); doc.setFontSize(7); doc.setFont('helvetica','bold');
    doc.text('STARTPHASE', margin + 14, y + 4.8, { align: 'center' });
    setTxt(soft); doc.setFontSize(9); doc.setFont('helvetica','normal');
    doc.text('2 Tage', margin + 31, y + 4.8); y += 11;

    const startText = 'An den ersten zwei Tagen ersetzt Du Deine Mahlzeiten durch jeweils 5 Portionen Precon Start Shake. Trink die Shakes am besten alle 3 bis 4 Stunden \u00FCber den Tag verteilt \u2013 und vergiss nicht, dazu noch 2 bis 3 Liter kalorienfreie Getr\u00E4nke zu trinken!';
    setTxt(col); doc.setFontSize(9); doc.setFont('helvetica','normal');
    const startLines = doc.splitTextToSize(startText, W - margin * 2);
    doc.text(startLines, margin, y); y += startLines.length * 4.5 + 4;

    const waterText = 'In der ersten Woche ist die Gewichtsabnahme oft etwas schneller als in den Folgewochen. Dein K\u00F6rper leert zun\u00E4chst seine Glykogenspeicher und scheidet dabei gebundenes Wasser aus. Ab Woche 2 pendelt sich die Abnahme auf ein nachhaltiges Niveau ein.';
    setTxt(soft); doc.setFontSize(8.5); doc.setFont('helvetica','italic');
    const waterLines = doc.splitTextToSize(waterText, W - margin * 2);
    doc.text(waterLines, margin, y); y += waterLines.length * 4.5 + 10;

    doc.setFillColor(ar,ag,ab);
    doc.roundedRect(margin, y, 32, 7, 2, 2, 'F');
    doc.setTextColor(255,255,255); doc.setFontSize(7); doc.setFont('helvetica','bold');
    doc.text('ABNEHMPHASE', margin + 16, y + 4.8, { align: 'center' });
    const showWksPdf  = state._showWeeks || 0;
    const totalWksPdf = state._weeksAbnehm || 0;
    const durTxt = totalWksPdf <= 11 ? showWksPdf + ' Wochen' : '12 Wochen (von ' + (1 + totalWksPdf) + ' gesamt)';
    setTxt(soft); doc.setFontSize(9); doc.setFont('helvetica','normal');
    doc.text(durTxt, margin + 35, y + 4.8); y += 11;

    const abnehmText = 'Ab dem dritten Tag ersetzt Du t\u00E4glich 2 Mahlzeiten durch eine Precon Ersatzmahlzeit (Shake, Suppe, Riegel oder M\u00FCsli) \u2013 und die dritte Mahlzeit ist ganz normal. Da eine Precon Ersatzmahlzeit nur etwa 220 bis 250 kcal hat, bringst Du Deinen K\u00F6rper in ein Energiedefizit und kannst so erfolgreich abnehmen!';
    setTxt(col); doc.setFontSize(9); doc.setFont('helvetica','normal');
    const abnehmLines = doc.splitTextToSize(abnehmText, W - margin * 2);
    doc.text(abnehmLines, margin, y); y += abnehmLines.length * 4.5 + GAP;

    // Footer on all pages
    const totalPages = doc.getNumberOfPages();
    for (let p = 1; p <= totalPages; p++) {
      doc.setPage(p);
      setTxt(soft); doc.setFontSize(7); doc.setFont('helvetica', 'normal');
      doc.text('Diese Berechnung dient der Orientierung und ersetzt keine medizinische Beratung. \u00A9 Precon', W / 2, 291, { align: 'center' });
    }

    doc.save('Precon_Abnehmplan_' + state.firstName + '_' + state.lastName + '.pdf');
  }
  window.preconDownloadPDF = preconDownloadPDF;

})();
</script>

