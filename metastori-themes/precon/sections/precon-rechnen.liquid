{{- 'https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400;600;700&family=DM+Sans:ital,wght@0,300;0,400;0,500;0,600;1,300&display=swap' | stylesheet_tag -}}

<script src="https://cdnjs.cloudflare.com/ajax/libs/Chart.js/4.4.1/chart.umd.min.js" defer></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js" defer></script>

<style>
  /* ── CSS CUSTOM PROPERTIES ── */
  .precon-rechner {
    --brand-dark: #56473A;
    --brand-beige: #EFECE4;
    --accent: #3DADBB;
    --accent-dark: #2e9aa8;
    --accent-light: rgba(61,173,187,0.10);
    --white: #FFFFFF;
    --light-gray: #F7F7F5;
    --mid-gray: #D8D3CE;
    --error: #C0392B;
    --success: #2D692D;
    --text: #56473A;
    --text-soft: #8a7b70;
    --radius: 10px;
  }

  .precon-rechner *,
  .precon-rechner *::before,
  .precon-rechner *::after {
    box-sizing: border-box;
  }

  /* ── WRAPPER ── */
  .precon-rechner .widget-wrapper {
    max-width: 560px;
    margin: 0 auto;
    padding: 0 0 60px;
    font-family: 'DM Sans', sans-serif;
    color: var(--text);
    background: var(--white);
  }

  /* ── HEADER ── */
  .precon-rechner .widget-header {
    background: var(--white);
    padding: 36px 28px 20px;
    text-align: center;
  }
  .precon-rechner .widget-pretitle {
    font-size: 16px;
    font-weight: 600;
    letter-spacing: 2px;
    text-transform: uppercase;
    color: var(--accent);
    margin-bottom: 10px;
  }
  .precon-rechner .widget-title {
    font-family: 'Playfair Display', serif;
    font-size: clamp(26px, 6vw, 36px);
    font-weight: 700;
    color: var(--brand-dark);
    line-height: 1.2;
    margin-bottom: 10px;
  }
  .precon-rechner .widget-subtitle { display: block; }
  .precon-rechner.results-mode .widget-subtitle,
  .precon-rechner.results-mode .widget-pretitle { display: none; }
  .precon-rechner .widget-subtitle {
    color: var(--text-soft);
    font-weight: 400;
    line-height: 1.65;
    max-width: 400px;
    margin: 0 auto;
  }

  /* ── PROGRESS BAR ── */
  .precon-rechner .progress-container {
    background: var(--white);
    padding: 20px 28px 24px;
    position: sticky;
    top: 0;
    z-index: 10;
    border-bottom: 1px solid #eee;
  }
  .precon-rechner .progress-steps {
    display: flex;
    align-items: center;
    gap: 0;
    margin-bottom: 10px;
  }
  .precon-rechner .prog-step {
    width: 28px;
    height: 28px;
    border-radius: 50%;
    border: 2px solid var(--mid-gray);
    background: var(--white);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 11px;
    font-weight: 600;
    color: var(--mid-gray);
    flex-shrink: 0;
    transition: all 0.35s ease;
    position: relative;
    z-index: 2;
  }
  .precon-rechner .prog-step.active {
    border-color: var(--accent);
    color: var(--accent);
    background: var(--white);
    box-shadow: 0 0 0 3px rgba(61,173,187,0.18);
  }
  .precon-rechner .prog-step.done {
    border-color: var(--accent);
    background: var(--accent);
    color: var(--white);
  }
  .precon-rechner .prog-line {
    flex: 1;
    height: 2px;
    background: var(--mid-gray);
    transition: background 0.35s ease;
    position: relative;
    z-index: 1;
  }
  .precon-rechner .prog-line.done { background: var(--accent); }
  .precon-rechner .progress-labels {
    display: flex;
    justify-content: space-between;
    padding: 0 4px;
  }
  .precon-rechner .prog-label {
    font-size: 9.5px;
    letter-spacing: 0.5px;
    text-transform: uppercase;
    color: var(--mid-gray);
    text-align: center;
    flex: 1;
    font-weight: 500;
    transition: color 0.3s;
  }
  .precon-rechner .prog-label:first-child { text-align: left; }
  .precon-rechner .prog-label:last-child { text-align: right; }
  .precon-rechner .prog-label.active,
  .precon-rechner .prog-label.done { color: var(--accent); }

  /* ── STEP CARD ── */
  .precon-rechner .step-card {
    background: var(--white);
    padding: 32px 28px 28px;
    display: none;
    animation: precon-slideIn 0.3s ease forwards;
  }
  .precon-rechner .step-card.visible { display: block; }

  @keyframes precon-slideIn {
    from { opacity: 0; transform: translateX(18px); }
    to   { opacity: 1; transform: translateX(0); }
  }
  @keyframes precon-slideBack {
    from { opacity: 0; transform: translateX(-18px); }
    to   { opacity: 1; transform: translateX(0); }
  }
  .precon-rechner .step-card.slide-back { animation: precon-slideBack 0.3s ease forwards; }

  .precon-rechner .step-question {
    font-family: 'Playfair Display', serif;
    font-size: clamp(20px, 4.5vw, 24px);
    font-weight: 600;
    color: var(--brand-dark);
    margin-bottom: 6px;
    line-height: 1.3;
  }
  .precon-rechner .step-hint {
    font-size: 16px;
    color: var(--text-soft);
    font-weight: 400;
    margin-bottom: 26px;
    line-height: 1.5;
  }

  /* ── GENDER BUTTONS ── */
  .precon-rechner .gender-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 14px;
    margin-bottom: 4px;
  }
  .precon-rechner .gender-btn {
    padding: 24px 16px 20px;
    border: 2px solid var(--mid-gray);
    background: var(--light-gray);
    cursor: pointer;
    font-family: 'DM Sans', sans-serif;
    font-size: 16px;
    color: var(--text);
    text-align: center;
    border-radius: var(--radius);
    transition: all 0.2s ease;
    font-weight: 500;
  }
  .precon-rechner .gender-btn:hover {
    border-color: var(--accent);
    background: var(--accent-light);
  }
  .precon-rechner .gender-btn.selected {
    border-color: var(--accent);
    background: var(--accent-light);
    color: var(--accent-dark);
  }
  .precon-rechner .gender-icon { font-size: 34px; display: block; margin-bottom: 8px; }

  /* ── INPUT FIELDS ── */
  .precon-rechner .field-group { margin-bottom: 20px; }
  .precon-rechner .field-group:last-of-type { margin-bottom: 0; }

  .precon-rechner label.field-label {
    display: block;
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 1.2px;
    text-transform: uppercase;
    color: var(--text-soft);
    margin-bottom: 8px;
  }
  .precon-rechner .input-wrap { position: relative; }
  .precon-rechner .input-wrap input {
    width: 100%;
    padding: 15px 52px 15px 16px;
    border: 2px solid var(--mid-gray);
    background: var(--light-gray);
    font-family: 'DM Sans', sans-serif;
    font-size: 18px;
    font-weight: 500;
    color: var(--text);
    outline: none;
    border-radius: var(--radius);
    transition: all 0.2s ease;
    -moz-appearance: textfield;
  }
  .precon-rechner .input-wrap input::-webkit-outer-spin-button,
  .precon-rechner .input-wrap input::-webkit-inner-spin-button { -webkit-appearance: none; }
  .precon-rechner .input-wrap input:focus {
    border-color: var(--accent);
    background: var(--white);
    box-shadow: 0 0 0 3px rgba(61,173,187,0.12);
  }
  .precon-rechner .input-wrap input.has-error {
    border-color: var(--error);
    background: rgba(192,57,43,0.04);
  }
  .precon-rechner .input-unit {
    position: absolute;
    right: 16px;
    top: 50%;
    transform: translateY(-50%);
    font-size: 16px;
    font-weight: 500;
    color: var(--text-soft);
    pointer-events: none;
  }
  .precon-rechner .field-error {
    font-size: 16px;
    color: var(--error);
    margin-top: 6px;
    display: none;
    font-weight: 400;
  }
  .precon-rechner .field-error.visible { display: block; }
  .precon-rechner .field-note {
    font-size: 16px;
    color: var(--text-soft);
    margin-top: 5px;
  }

  /* ── CHOICE BUTTONS ── */
  .precon-rechner .choices { display: flex; flex-direction: column; gap: 10px; }
  .precon-rechner .choice-btn {
    padding: 15px 18px;
    border: 2px solid var(--mid-gray);
    background: var(--light-gray);
    cursor: pointer;
    font-family: 'DM Sans', sans-serif;
    font-size: 14.5px;
    color: var(--text);
    text-align: left;
    border-radius: var(--radius);
    transition: all 0.2s ease;
    display: flex;
    align-items: center;
    gap: 13px;
    font-weight: 400;
    line-height: 1.4;
  }
  .precon-rechner .choice-btn:hover {
    border-color: var(--accent);
    background: var(--accent-light);
  }
  .precon-rechner .choice-btn.selected {
    border-color: var(--accent);
    background: var(--accent-light);
    color: var(--brand-dark);
    font-weight: 500;
  }
  .precon-rechner .choice-radio {
    width: 18px;
    height: 18px;
    border-radius: 50%;
    border: 2px solid var(--mid-gray);
    flex-shrink: 0;
    transition: all 0.2s;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .precon-rechner .choice-btn.selected .choice-radio {
    border-color: var(--accent);
    background: var(--accent);
  }
  .precon-rechner .choice-btn.selected .choice-radio::after {
    content: '';
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: white;
  }

  /* ── TEXT INPUTS ── */
  .precon-rechner .text-input-wrap input {
    font-size: 16px;
    padding: 15px 16px;
  }
  .precon-rechner .text-input-wrap input:focus {
    border-color: var(--accent);
    background: var(--white);
    box-shadow: 0 0 0 3px rgba(61,173,187,0.12);
  }

  /* ── CONSENT ── */
  .precon-rechner .consent-row {
    display: flex;
    gap: 14px;
    align-items: flex-start;
    padding: 16px;
    background: var(--light-gray);
    border: 2px solid var(--mid-gray);
    cursor: pointer;
    border-radius: var(--radius);
    transition: border-color 0.2s;
    margin-top: 20px;
  }
  .precon-rechner .consent-row:hover { border-color: var(--accent); }
  .precon-rechner .consent-row.checked { border-color: var(--accent); background: var(--accent-light); }
  .precon-rechner .consent-box-el {
    width: 20px;
    height: 20px;
    min-width: 20px;
    border-radius: 5px;
    border: 2px solid var(--mid-gray);
    background: var(--white);
    display: flex;
    align-items: center;
    justify-content: center;
    transition: all 0.2s;
    margin-top: 1px;
  }
  .precon-rechner .consent-row.checked .consent-box-el {
    background: var(--accent);
    border-color: var(--accent);
  }
  .precon-rechner .consent-check { display: none; color: white; font-size: 12px; font-weight: 700; }
  .precon-rechner .consent-row.checked .consent-check { display: block; }
  .precon-rechner .consent-text {
    font-size: 16px;
    line-height: 1.65;
    color: var(--text-soft);
  }

  /* ── NOTICE ── */
  .precon-rechner .notice-box {
    padding: 14px 16px;
    border-radius: var(--radius);
    font-size: 16px;
    line-height: 1.65;
    margin-top: 14px;
    display: none;
  }
  .precon-rechner .notice-box.visible { display: block; }
  .precon-rechner .notice-box.warning {
    background: rgba(61,173,187,0.08);
    border-left: 3px solid var(--accent);
    color: var(--brand-dark);
  }

  /* ── CTA BUTTON ── */
  .precon-rechner .btn-next {
    width: 100%;
    padding: 17px;
    background: var(--accent);
    color: var(--white);
    border: none;
    font-family: 'DM Sans', sans-serif;
    font-size: 16px;
    font-weight: 600;
    letter-spacing: 0.3px;
    cursor: pointer;
    border-radius: 999px;
    transition: all 0.2s ease;
    margin-top: 28px;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
  }
  .precon-rechner .btn-next:hover { background: var(--accent-dark); transform: translateY(-1px); box-shadow: 0 4px 16px rgba(61,173,187,0.3); }
  .precon-rechner .btn-next:active { transform: translateY(0); }
  .precon-rechner .btn-next svg { width: 18px; height: 18px; }

  .precon-rechner .btn-back {
    width: 100%;
    background: none;
    border: none;
    color: var(--text-soft);
    font-family: 'DM Sans', sans-serif;
    font-size: 16px;
    cursor: pointer;
    padding: 12px;
    display: block;
    text-align: center;
    letter-spacing: 0.3px;
    transition: color 0.2s;
    margin-top: 4px;
  }
  .precon-rechner .btn-back:hover { color: var(--brand-dark); }

  /* ── RESULTS ── */
  .precon-rechner .results-wrap { padding: 28px 28px 0; }
  .precon-rechner .results-greeting {
    font-family: 'Playfair Display', serif;
    font-size: clamp(20px, 4.5vw, 26px);
    font-weight: 700;
    color: var(--brand-dark);
    margin-bottom: 6px;
    line-height: 1.3;
  }
  .precon-rechner .results-intro {
    font-size: 16px;
    color: var(--text-soft);
    font-weight: 400;
    margin-bottom: 28px;
    line-height: 1.6;
  }

  /* RESULT BLOCKS */
  .precon-rechner .result-block {
    background: var(--light-gray);
    border-radius: var(--radius);
    padding: 18px 20px;
    margin-bottom: 12px;
  }
  .precon-rechner .result-block.accent-block {
    background: var(--brand-dark);
    margin-bottom: 12px;
  }
  .precon-rechner .result-block.precon-block {
    background: var(--accent-light);
    border: 2px solid var(--accent);
    margin-bottom: 12px;
  }
  .precon-rechner .res-label {
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 1.5px;
    text-transform: uppercase;
    color: var(--text-soft);
    margin-bottom: 4px;
  }
  .precon-rechner .accent-block .res-label { color: rgba(255,255,255,0.6); }
  .precon-rechner .precon-block .res-label { color: var(--accent-dark); }
  .precon-rechner .res-value {
    font-family: 'Playfair Display', serif;
    font-size: 32px;
    font-weight: 700;
    color: var(--brand-dark);
    line-height: 1.1;
  }
  .precon-rechner .accent-block .res-value { color: var(--white); font-size: 40px; }
  .precon-rechner .precon-block .res-value { color: var(--brand-dark); }
  .precon-rechner .res-unit {
    font-family: 'DM Sans', sans-serif;
    font-size: 16px;
    font-weight: 400;
    color: var(--text-soft);
    margin-left: 3px;
  }
  .precon-rechner .accent-block .res-unit { color: rgba(255,255,255,0.6); }
  .precon-rechner .res-sub {
    font-size: 16px;
    color: var(--text-soft);
    margin-top: 3px;
    font-weight: 400;
  }
  .precon-rechner .accent-block .res-sub { color: rgba(255,255,255,0.5); }
  .precon-rechner .precon-block .res-sub { color: #5a8e95; }

  .precon-rechner .bmi-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 12px;
    margin-bottom: 12px;
  }
  .precon-rechner .bmi-row .result-block { margin-bottom: 0; }
  .precon-rechner .secondary-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 12px;
    margin-bottom: 12px;
  }
  .precon-rechner .secondary-row .result-block { margin-bottom: 0; }

  /* ── BMI GAUGE ── */
  .precon-rechner .bmi-gauge-wrap { position: relative; margin: 0 0 20px; }
  .precon-rechner .bmi-gauge-bar { display: flex; height: 16px; border-radius: 999px; overflow: hidden; }
  .precon-rechner .bmi-seg { flex-shrink: 0; }
  .precon-rechner .bmi-gauge-ticks { position: relative; height: 22px; margin-top: 4px; }
  .precon-rechner .bmi-gauge-ticks span {
    position: absolute;
    transform: translateX(-50%);
    font-size: 11px;
    font-weight: 600;
    color: var(--text-soft);
    white-space: nowrap;
  }
  .precon-rechner .bmi-needle-wrap {
    position: absolute;
    top: 0;
    transform: translateX(-50%);
    display: flex;
    flex-direction: column;
    align-items: center;
    pointer-events: none;
    z-index: 3;
  }
  .precon-rechner .bmi-needle-dot {
    width: 18px;
    height: 18px;
    border-radius: 50%;
    background: var(--brand-dark);
    border: 3px solid white;
    box-shadow: 0 1px 8px rgba(0,0,0,0.3);
    margin-top: -1px;
  }
  .precon-rechner .bmi-needle-line { width: 2px; height: 18px; background: var(--brand-dark); opacity: 0.45; }
  .precon-rechner .bmi-labels-wrap { position: relative; height: 72px; margin-top: 2px; }
  .precon-rechner .bmi-label-item {
    position: absolute;
    transform: translateX(-50%);
    display: flex;
    flex-direction: column;
    align-items: center;
  }
  .precon-rechner .bmi-label-item.level-1 { top: 0; }
  .precon-rechner .bmi-label-item.level-2 { top: 36px; }
  .precon-rechner .bmi-label-connector { width: 1.5px; background: var(--mid-gray); flex-shrink: 0; }
  .precon-rechner .level-1 .bmi-label-connector { height: 8px; }
  .precon-rechner .level-2 .bmi-label-connector { height: 44px; margin-top: -44px; order: -1; }
  .precon-rechner .bmi-label-text { font-size: 11px; color: var(--text-soft); text-align: center; line-height: 1.3; white-space: nowrap; }
  .precon-rechner .bmi-gauge-bar,
  .precon-rechner .bmi-gauge-ticks,
  .precon-rechner .bmi-labels-wrap { margin-left: 2%; margin-right: 2%; }

  /* ── ABNEHMPLAN PAGE ── */
  .precon-rechner .plan-intro {
    font-size: 16px;
    line-height: 1.75;
    color: var(--text);
    margin-bottom: 28px;
    padding: 18px 20px;
    background: var(--light-gray);
    border-radius: var(--radius);
  }
  .precon-rechner .plan-intro.plain { background: none; padding: 0; border-radius: 0; }
  .precon-rechner .plan-intro strong { font-weight: 600; color: var(--brand-dark); }
  .precon-rechner .plan-section-title {
    font-family: 'Playfair Display', serif;
    font-size: 18px;
    font-weight: 600;
    color: var(--brand-dark);
    margin-bottom: 16px;
  }
  .precon-rechner .chart-wrap {
    background: var(--white);
    border: 1.5px solid var(--mid-gray);
    border-radius: var(--radius);
    padding: 16px 8px 12px;
    margin-bottom: 4px;
  }

  /* ── PHASENPLAN ── */
  .precon-rechner .phase-heading { display: flex; align-items: center; gap: 10px; margin-bottom: 14px; }
  .precon-rechner .phase-badge {
    font-family: 'DM Sans', sans-serif;
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 0.5px;
    padding: 5px 12px;
    border-radius: 999px;
    text-transform: uppercase;
  }
  .precon-rechner .phase-badge--start,
  .precon-rechner .phase-badge--abnehm,
  .precon-rechner .phase-badge--halte { background: var(--brand-dark); color: white; }
  .precon-rechner .phase-duration { font-size: 14px; color: var(--text-soft); font-weight: 400; }
  .precon-rechner .info-box {
    display: flex;
    gap: 10px;
    background: rgba(61,173,187,0.07);
    border: 1.5px solid rgba(61,173,187,0.3);
    border-radius: var(--radius);
    padding: 14px 16px;
    margin-top: 10px;
    margin-bottom: 32px;
  }
  .precon-rechner .info-box-icon {
    flex-shrink: 0;
    width: 20px;
    height: 20px;
    border-radius: 50%;
    background: var(--accent);
    color: white;
    font-size: 13px;
    font-weight: 700;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-top: 1px;
  }
  .precon-rechner .info-box-text { font-size: 15px; line-height: 1.65; color: var(--text-soft); }

  /* ── LOADING SCREEN ── */
  .precon-rechner .loading-spinner-wrap { margin: 8px 0 32px; }
  .precon-rechner .loading-bar-track {
    width: 100%;
    height: 6px;
    background: var(--mid-gray);
    border-radius: 999px;
    overflow: hidden;
  }
  .precon-rechner .loading-bar-fill {
    height: 100%;
    width: 0%;
    background: var(--accent);
    border-radius: 999px;
    transition: width 8s linear;
  }
  .precon-rechner .loading-title {
    font-family: 'Playfair Display', serif;
    font-size: clamp(22px, 5vw, 28px);
    font-weight: 700;
    color: var(--brand-dark);
    line-height: 1.3;
    margin-bottom: 10px;
  }
  .precon-rechner .loading-sub { font-size: 16px; color: var(--text-soft); font-weight: 400; margin-bottom: 36px; }
  .precon-rechner .loading-review {
