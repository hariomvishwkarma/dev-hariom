{%- assign overlay_rgb = section.settings.overlay_color | color_to_rgb | remove: 'rgb(' | remove: ')' -%}

<section class="blog-ph" id="blog-ph-{{ section.id }}">
{%- if section.settings.background_image != blank -%}
<div class="blog-ph__media">
{{ section.settings.background_image | image_url: width: 2600 | image_tag:
class: 'blog-ph__img',
loading: 'eager',
fetchpriority: 'high',
sizes: '100vw',
widths: '375, 750, 1100, 1500, 2000, 2600',
alt: blog.title
}}
</div>
{%- endif -%}

<div
class="blog-ph__overlay"
style="--overlay-rgb:{{ overlay_rgb }};opacity:{{ section.settings.overlay_opacity | divided_by: 100.0 }};"
></div>

<div class="blog-ph__content">
<h1 class="blog-ph__title" style="color:{{ section.settings.title_color }};">
{%- if section.settings.title_override != blank -%}
{{ section.settings.title_override }}
{%- else -%}
{{ blog.title }}
{%- endif -%}
</h1>

{%- if section.settings.subtitle != blank -%}
<p class="blog-ph__subtitle" style="color:{{ section.settings.subtitle_color }};">{{ section.settings.subtitle }}</p>
{%- endif -%}

{%- if section.settings.show_article_count -%}
<span class="blog-ph__count" style="background:{{ section.settings.count_bg }};color:{{ section.settings.count_text }};border-color:{{ section.settings.count_border }};">
<svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/></svg>
{{ blog.articles_count }} Artikel
</span>
{%- endif -%}
</div>
</section>

<style>
.blog-ph {
position: relative;
width: 100%;
min-height: {{ section.settings.min_height }}px;
display: flex;
align-items: center;
justify-content: center;
overflow: hidden;
text-align: center;
  }
.blog-ph__media {
position: absolute;
inset: 0;
z-index: 0;
  }
.blog-ph__img {
width: 100%;
height: 100%;
object-fit: cover;
object-position: center;
  }
.blog-ph__overlay {
position: absolute;
inset: 0;
z-index: 1;
background: rgba(var(--overlay-rgb), 1);
pointer-events: none;
  }
.blog-ph__content {
position: relative;
z-index: 2;
padding: 60px max(24px, 5rem);
display: flex;
flex-direction: column;
align-items: center;
gap: 14px;
  }
.blog-ph__title {
font-size: clamp(36px, 6vw, 72px);
font-weight: {{ section.settings.title_weight }};
line-height: 1.08;
margin: 0;
  }
.blog-ph__subtitle {
  font-family: var(--accent-font-family);
  font-style: var(--accent-font-style);
font-size: clamp(16px, 1.5vw, 22px);
font-weight: 500;
line-height: 1.4;
margin: 0;
opacity: 0.9;
  }
.blog-ph__count {
display: inline-flex;
align-items: center;
gap: 7px;
padding: 8px 18px;
border-radius: 50px;
border: 1px solid;
font-size: 13px;
font-weight: 500;
margin-top: 8px;
  }
@media (max-width: 768px) {
.blog-ph {
min-height: {{ section.settings.min_height | times: 0.75 | round }}px;
    }
.blog-ph__content {
padding: 40px 24px;
    }
  }
</style>

{% schema %}
{
  "name": "Blog Hero",
  "tag": "section",
  "class": "section-blog-page-hero",
  "settings": [
    {
      "type": "image_picker",
      "id": "background_image",
      "label": "Hintergrundbild"
    },
    {
      "type": "range",
      "id": "min_height",
      "label": "Mindesthöhe",
      "min": 200,
      "max": 700,
      "step": 20,
      "default": 360,
      "unit": "px"
    },
    {
      "type": "header",
      "content": "Overlay"
    },
    {
      "type": "color",
      "id": "overlay_color",
      "label": "Overlay Farbe",
      "default": "#000000"
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "label": "Overlay Stärke",
      "min": 0,
      "max": 100,
      "step": 5,
      "default": 45,
      "unit": "%"
    },
    {
      "type": "header",
      "content": "Titel"
    },
    {
      "type": "text",
      "id": "title_override",
      "label": "Titel überschreiben (leer = Blog-Name)",
      "info": "Leer lassen um den Blog-Titel automatisch zu verwenden."
    },
    {
      "type": "color",
      "id": "title_color",
      "label": "Titelfarbe",
      "default": "#ffffff"
    },
    {
      "type": "select",
      "id": "title_weight",
      "label": "Schriftstärke",
      "default": "300",
      "options": [
        { "value": "300", "label": "Light (300)" },
        { "value": "400", "label": "Regular (400)" },
        { "value": "500", "label": "Medium (500)" },
        { "value": "600", "label": "Semibold (600)" },
        { "value": "700", "label": "Bold (700)" },
        { "value": "800", "label": "Extrabold (800)" }
      ]
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "Untertitel (kursiv)",
      "default": "Wissenschaftlich fundiert. Alltagstauglich."
    },
    {
      "type": "color",
      "id": "subtitle_color",
      "label": "Untertitel Farbe",
      "default": "#ffffff"
    },
    {
      "type": "header",
      "content": "Artikelanzahl Badge"
    },
    {
      "type": "checkbox",
      "id": "show_article_count",
      "label": "Artikelanzahl anzeigen",
      "default": true
    },
    {
      "type": "color",
      "id": "count_bg",
      "label": "Badge Hintergrund",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "count_text",
      "label": "Badge Textfarbe",
      "default": "#1a2420"
    },
    {
      "type": "color",
      "id": "count_border",
      "label": "Badge Rahmen",
      "default": "#ffffff"
    }
  ],
  "presets": [
    {
      "name": "Blog Hero"
    }
  ]
}
{% endschema %}