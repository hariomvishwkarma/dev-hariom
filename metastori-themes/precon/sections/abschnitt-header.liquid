{%- comment -%}
  sections/abschnitt-header.liquid
  Wiederverwendbarer Abschnitts-Header: Eyebrow / 2-zeilige Headline / opt. Untertitel
  Eyebrow-Stil identisch zu kennst-du-das, warum-das-wichtig, usp-konzept, phasenplan
  Fonts: Figtree 300/400/600 + Playfair Display 500 italic
  Padding oben + unten separat steuerbar
{%- endcomment -%}

{%- liquid
  assign c_bg     = section.settings.color_bg
  assign c_ink    = section.settings.color_ink
  assign c_mid    = section.settings.color_mid
  assign c_accent = section.settings.color_accent
  assign pt       = section.settings.padding_top
  assign pb       = section.settings.padding_bottom
-%}

<div id="ah-{{ section.id }}" class="ah" style="padding-top: {{ pt }}px; padding-bottom: {{ pb }}px;">
  <div class="ah__inner">

    {%- if section.settings.eyebrow != blank -%}
      <p class="ah__eyebrow">
        <span class="ah__eyebrow-rule"></span>
        {{ section.settings.eyebrow }}
        <span class="ah__eyebrow-rule"></span>
      </p>
    {%- endif -%}

    {%- if section.settings.heading != blank -%}
      <h2 class="ah__heading">{{ section.settings.heading }}</h2>
    {%- endif -%}

    {%- if section.settings.subtitle != blank -%}
      <p class="ah__subtitle">{{ section.settings.subtitle }}</p>
    {%- endif -%}

  </div>
</div>

<style>
@import url('https://fonts.googleapis.com/css2?family=Figtree:wght@300;400;600&family=Playfair+Display:ital,wght@1,500&display=swap');

#ah-{{ section.id }} {
  --bg:     {{ c_bg }};
  --ink:    {{ c_ink }};
  --mid:    {{ c_mid }};
  --accent: {{ c_accent }};
}

#ah-{{ section.id }},
#ah-{{ section.id }} * { box-sizing: border-box; }

#ah-{{ section.id }} {
  background: var(--bg);
  font-family: 'Figtree', sans-serif;
  -webkit-font-smoothing: antialiased;
  padding-left: 1.5rem;
  padding-right: 1.5rem;
}

/* ── Inner ── */
#ah-{{ section.id }} .ah__inner {
  max-width: 720px;
  margin: 0 auto;
  text-align: center;
}

/* ── Eyebrow ── */
#ah-{{ section.id }} .ah__eyebrow {
  display: inline-flex;
  align-items: center;
  gap: 10px;
  font-size: 11px;
  font-weight: 600;
  letter-spacing: 0.24em;
  text-transform: uppercase;
  color: var(--accent);
  margin-bottom: 1rem;
}

#ah-{{ section.id }} .ah__eyebrow-rule {
  display: block;
  width: 22px;
  height: 1px;
  background: currentColor;
  opacity: 0.45;
  flex-shrink: 0;
}

/* ── Heading ── */
#ah-{{ section.id }} .ah__heading {
  font-family: 'Figtree', sans-serif;
  font-size: clamp(32px, 4vw, 52px);
  font-weight: 300;
  color: var(--ink);
  line-height: 1.06;
  letter-spacing: -0.026em;
  text-wrap: balance;
}

#ah-{{ section.id }} .ah__heading em {
  font-family: 'Playfair Display', serif;
  font-style: italic;
  font-weight: 500;
  letter-spacing: -0.02em;
}

/* ── Subtitle ── */
#ah-{{ section.id }} .ah__subtitle {
  font-size: clamp(15px, 1.15vw, 16.5px);
  line-height: 1.8;
  color: var(--mid);
  margin-top: 1rem;
}

/* ── Responsive ── */
@media (max-width: 560px) {
  #ah-{{ section.id }} {
    padding-left: 1rem;
    padding-right: 1rem;
  }
}
</style>

{% schema %}
{
  "name": "Abschnitts-Header",
  "tag": "section",
  "settings": [
    { "type": "header", "content": "Inhalt" },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Das System"
    },
    {
      "type": "richtext",
      "id": "heading",
      "label": "Überschrift",
      "default": "<p>Alles für <em>Deinen Start.</em></p>"
    },
    {
      "type": "textarea",
      "id": "subtitle",
      "label": "Untertitel (optional)"
    },
    { "type": "header", "content": "Abstände" },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Abstand oben",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 64
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Abstand unten",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 32
    },
    { "type": "header", "content": "Farben" },
    { "type": "color", "id": "color_bg",     "label": "Hintergrund",  "default": "#FAF9F5" },
    { "type": "color", "id": "color_ink",    "label": "Text dunkel",  "default": "#56473A" },
    { "type": "color", "id": "color_mid",    "label": "Text gedimmt", "default": "#8C7C70" },
    { "type": "color", "id": "color_accent", "label": "Akzentfarbe",  "default": "#3DADBB" }
  ],
  "presets": [
    {
      "name": "Abschnitts-Header"
    }
  ]
}
{% endschema %}