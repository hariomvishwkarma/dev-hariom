{% comment %}
  Section: Relaunch Naming
{% endcomment %}

<section class="relaunch-naming" style="background-color: {{ section.settings.bg_color }};">
  <div class="relaunch-naming__container">
    <div class="relaunch-naming__badges">
      {% if section.settings.badge_text != blank %}
        <span class="relaunch-naming__badge" style="background-color: {{ section.settings.badge_bg_color }}; color: {{ section.settings.badge_text_color }}; border-color: {{ section.settings.badge_text_color }};">{{ section.settings.badge_text }}</span>
      {% endif %}
      {% if section.settings.badge_text_2 != blank %}
        <span class="relaunch-naming__badge" style="background-color: {{ section.settings.badge_bg_color_2 }}; color: {{ section.settings.badge_text_color_2 }}; border-color: {{ section.settings.badge_text_color_2 }};">{{ section.settings.badge_text_2 }}</span>
      {% endif %}
    </div>

    <h2 class="relaunch-naming__heading">
      {{ section.settings.heading }} <em>{{ section.settings.heading_italic }}</em>
    </h2>

    <div class="relaunch-naming__body">{{ section.settings.body_text }}</div>

    <div class="relaunch-naming__table-wrap">
      <table class="relaunch-naming__table">
        <thead>
          <tr style="background-color: {{ section.settings.table_header_bg }};">
            <th style="color: {{ section.settings.table_header_text }};">{{ section.settings.col_1_header }}</th>
            <th style="color: {{ section.settings.table_header_text }};">{{ section.settings.col_2_header }}</th>
          </tr>
        </thead>
        <tbody>
          {% for block in section.blocks %}
            {% if block.type == 'row' %}
              <tr {{ block.shopify_attributes }}>
                <td>
                  {% if block.settings.old_strikethrough %}
                    <s>{{ block.settings.old_name }}</s>
                  {% else %}
                    {{ block.settings.old_name }}
                  {% endif %}
                </td>
                <td>
                  {% if block.settings.new_badge != blank %}
                    <span class="relaunch-naming__table-badge" style="border-color: {{ section.settings.accent_color }}; color: {{ section.settings.accent_color }};">{{ block.settings.new_badge }}</span>
                  {% else %}
                    <strong>{{ block.settings.new_name }}</strong>
                  {% endif %}
                </td>
              </tr>
            {% endif %}
          {% endfor %}
        </tbody>
        {% if section.settings.table_footer != blank %}
          <tfoot>
            <tr style="background-color: {{ section.settings.table_footer_bg }};">
              <td colspan="2">
                <span class="relaunch-naming__footer-text">
                  <strong style="color: {{ section.settings.accent_color }};">{{ section.settings.table_footer_bold }}</strong> {{ section.settings.table_footer }}
                </span>
              </td>
            </tr>
          </tfoot>
        {% endif %}
      </table>
    </div>
  </div>
</section>

<style>
  .relaunch-naming {
    padding: 60px 20px;
    text-align: center;
  }

  .relaunch-naming__container {
    max-width: 800px;
    margin: 0 auto;
  }

  .relaunch-naming__badges {
    display: flex;
    justify-content: center;
    gap: 10px;
    margin-bottom: 20px;
    flex-wrap: wrap;
  }

  .relaunch-naming__badge {
    display: inline-block;
    font-size: 11px;
    letter-spacing: 2px;
    text-transform: uppercase;
    border: 1px solid;
    border-radius: 20px;
    padding: 8px 20px;
    font-weight: 500;
  }

  .relaunch-naming__heading {
    font-size: 36px;
    font-weight: 400;
    color: {{ section.settings.heading_color }};
    margin: 0 0 20px;
    line-height: 1.2;
  }

  .relaunch-naming__heading em {
    font-family: Georgia, 'Times New Roman', serif;
    font-style: italic;
    color: {{ section.settings.accent_color }};
  }

  .relaunch-naming__body {
    font-size: 14px;
    line-height: 1.7;
    color: {{ section.settings.body_text_color }};
    margin-bottom: 30px;
  }

  .relaunch-naming__table-wrap {
    overflow-x: auto;
  }

  .relaunch-naming__table {
    width: 100%;
    border-collapse: separate;
    border-spacing: 0;
    border-radius: 12px;
    overflow: hidden;
    box-shadow: 0 1px 4px rgba(0, 0, 0, 0.06);
  }

  .relaunch-naming__table thead th {
    text-align: left;
    font-size: 11px;
    letter-spacing: 2px;
    text-transform: uppercase;
    padding: 16px 24px;
    font-weight: 600;
  }

  .relaunch-naming__table tbody tr {
    background: {{ section.settings.table_row_odd }};
    border-bottom: 1px solid #f0ece6;
  }

  .relaunch-naming__table tbody tr:nth-child(even) {
    background: {{ section.settings.table_row_even }};
  }

  .relaunch-naming__table tbody td {
    padding: 14px 24px;
    font-size: 15px;
    color: {{ section.settings.table_text_color }};
    text-align: left;
  }

  .relaunch-naming__table tbody td s {
    color: {{ section.settings.table_strikethrough_color }};
    text-decoration: line-through;
  }

  .relaunch-naming__table-badge {
    display: inline-block;
    font-size: 13px;
    border: 1px solid;
    border-radius: 16px;
    padding: 4px 14px;
    font-weight: 500;
  }

  .relaunch-naming__table tfoot td {
    padding: 16px 24px;
    font-size: 13px;
    line-height: 1.6;
    color: {{ section.settings.footer_text_color }};
    text-align: left;
  }

  .relaunch-naming__footer-text strong {
    font-weight: 700;
  }

  @media (max-width: 500px) {
    .relaunch-naming__heading {
      font-size: 28px;
    }

    .relaunch-naming__table thead th,
    .relaunch-naming__table tbody td,
    .relaunch-naming__table tfoot td {
      padding: 12px 16px;
    }
  }
</style>

