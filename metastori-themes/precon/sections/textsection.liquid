<section class="text-section" id="text-section-{{ section.id }}">
  <div class="text-section__inner page-width">

    {%- if section.settings.eyebrow != blank -%}
      <p class="text-section__eyebrow" style="color: {{ section.settings.eyebrow_color }};">
        {{ section.settings.eyebrow }}
      </p>
    {%- endif -%}

    {%- if section.settings.heading != blank -%}
      <h2 class="text-section__heading" style="color: {{ section.settings.heading_color }};">
        {{ section.settings.heading }}
      </h2>
    {%- endif -%}

    {%- if section.settings.subheadline != blank -%}
      <p class="text-section__subheadline" style="color: {{ section.settings.subheadline_color }};">
        {{ section.settings.subheadline }}
      </p>
    {%- endif -%}

    {%- if section.settings.body_text != blank -%}
      <div class="text-section__body" style="color: {{ section.settings.text_color }};">
        {{ section.settings.body_text }}
      </div>
    {%- endif -%}

  </div>
</section>

<style>
  #text-section-{{ section.id }} {
    background-color: {{ section.settings.section_bg }};
    padding: {{ section.settings.padding_top }}px 0 {{ section.settings.padding_bottom }}px;
  }

  .text-section__inner {
    max-width: 760px;
    margin: 0 auto;
    padding: 0 24px;
    text-align: center;
  }

  /* Eyebrow */
  .text-section__eyebrow {
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    margin: 0 0 16px;
  }

  /* Headline */
  .text-section__heading {
    font-size: clamp(30px, 4vw, 46px);
    font-weight: 300;
    line-height: 1.15;
    margin: 0 0 18px;
  }

  /* Playfair für kursive Elemente in der Headline */
  .text-section__heading em,
  .text-section__heading strong,
  .text-section__heading em strong,
  .text-section__heading strong em {
    font-family: var(--accent-font-family);
    font-style: var(--accent-font-style);
    font-weight: 500;
  }

  /* Subheadline – dezent: mittelgross, normal weight */
  .text-section__subheadline {
    font-size: clamp(17px, 1.4vw, 21px);
    font-weight: 400;
    line-height: 1.5;
    margin: 0 0 20px;
  }

  /* Body Text */
  .text-section__body {
    font-size: clamp(15px, 1.15vw, 17px);
    line-height: 1.7;
    margin: 0;
  }

  .text-section__body p {
    margin: 0;
  }
</style>

{% schema %}
{
  "name": "Text mit Subheadline",
  "tag": "section",
  "class": "section-text",
  "settings": [
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "color",
      "id": "section_bg",
      "label": "Hintergrundfarbe",
      "default": "#f7f3ee"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 120,
      "step": 4,
      "default": 72,
      "unit": "px",
      "label": "Abstand oben"
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "default": 72,
      "unit": "px",
      "label": "Abstand unten"
    },
    {
      "type": "header",
      "content": "Texte"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "EXKLUSIV FÜR UNSERE COMMUNITY"
    },
    {
      "type": "color",
      "id": "eyebrow_color",
      "label": "Eyebrow Farbe",
      "default": "#4FBFBE"
    },
    {
      "type": "richtext",
      "id": "heading",
      "label": "Headline",
      "default": "<p>Wir haben etwas <em>Neues</em> für Dich</p>"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Headline Farbe",
      "default": "#2c2c2c"
    },
    {
      "type": "text",
      "id": "subheadline",
      "label": "Subheadline",
      "default": "Limitierte Sommeredition"
    },
    {
      "type": "color",
      "id": "subheadline_color",
      "label": "Subheadline Farbe",
      "default": "#7a7060"
    },
    {
      "type": "richtext",
      "id": "body_text",
      "label": "Body Text",
      "default": "<p>Probiere unsere limitierte Sommeredition noch vor allen anderen. Klicke auf das Bild, um zu sehen, was Dich erwartet.</p>"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Body Text Farbe",
      "default": "#6b645c"
    }
  ],
  "presets": [
    {
      "name": "Text mit Subheadline"
    }
  ]
}
{% endschema %}