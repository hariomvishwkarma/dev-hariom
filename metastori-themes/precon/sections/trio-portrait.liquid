{%- comment -%}
  sections/trio-portrait-section.liquid
  3 Portraits nebeneinander (image-grid) + Eyebrow / Heading / Subtext / Button
  Fonts: Figtree 300/400/600 + Playfair Display 500 italic
{%- endcomment -%}

{%- liquid
  assign c_bg      = section.settings.color_bg
  assign c_ink     = section.settings.color_ink
  assign c_mid     = section.settings.color_mid
  assign c_accent  = section.settings.color_accent
  assign c_btn_bg  = section.settings.color_btn_bg
  assign c_btn_ink = section.settings.color_btn_ink
  assign pt        = section.settings.padding_top
  assign pb        = section.settings.padding_bottom
-%}

<div id="trio-{{ section.id }}" class="trio" style="padding-bottom: {{ pb }}px;">

  <!-- ── Bilder-Grid ── -->
  <div class="trio__grid">
    {%- for i in (1..3) -%}
      {%- assign img_key = 'image_' | append: i -%}
      {%- assign img = section.settings[img_key] -%}
      <div class="trio__img-wrap">
        {%- if img != blank -%}
          {{
            img
            | image_url: width: 900
            | image_tag:
              class: 'trio__img',
              loading: 'lazy',
              widths: '400,600,900',
              sizes: '(max-width: 600px) 100vw, 33vw'
          }}
        {%- else -%}
          <div class="trio__placeholder">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1" xmlns="http://www.w3.org/2000/svg">
              <rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="8.5" cy="8.5" r="1.5"/><polyline points="21 15 16 10 5 21"/>
            </svg>
          </div>
        {%- endif -%}
      </div>
    {%- endfor -%}
  </div>

  <!-- ── Text-Block ── -->
  <div class="trio__text" style="padding-top: {{ pt }}px;">

    {%- if section.settings.eyebrow != blank -%}
      <p class="trio__eyebrow">
        <span class="trio__eyebrow-rule"></span>
        {{ section.settings.eyebrow }}
        <span class="trio__eyebrow-rule"></span>
      </p>
    {%- endif -%}

    {%- if section.settings.heading != blank -%}
      <h2 class="trio__heading">{{ section.settings.heading }}</h2>
    {%- endif -%}

    {%- if section.settings.subtext != blank -%}
      <p class="trio__sub">{{ section.settings.subtext }}</p>
    {%- endif -%}

    {%- if section.settings.btn_label != blank -%}
      <a class="trio__btn" href="{{ section.settings.btn_url }}">
        {{ section.settings.btn_label }}
      </a>
    {%- endif -%}

  </div>
</div>

<style>
@import url('https://fonts.googleapis.com/css2?family=Figtree:wght@300;400;600&family=Playfair+Display:ital,wght@1,500&display=swap');

#trio-{{ section.id }} {
  --bg:      {{ c_bg }};
  --ink:     {{ c_ink }};
  --mid:     {{ c_mid }};
  --accent:  {{ c_accent }};
  --btn-bg:  {{ c_btn_bg }};
  --btn-ink: {{ c_btn_ink }};
}

#trio-{{ section.id }},
#trio-{{ section.id }} * { box-sizing: border-box; }

#trio-{{ section.id }} {
  background: var(--bg);
  font-family: 'Figtree', sans-serif;
  -webkit-font-smoothing: antialiased;
}

/* ── Bilder-Grid ── */
#trio-{{ section.id }} .trio__grid {
  display: grid;
  grid-template-columns: 1fr 1fr 1fr;
  gap: 4px;
}

#trio-{{ section.id }} .trio__img-wrap {
  overflow: hidden;
  aspect-ratio: 1 / 1;
  background: #ede9e2;
}

#trio-{{ section.id }} .trio__img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  object-position: center top;
  display: block;
  transition: transform 0.5s ease;
}

#trio-{{ section.id }} .trio__img-wrap:hover .trio__img {
  transform: scale(1.03);
}

/* Placeholder */
#trio-{{ section.id }} .trio__placeholder {
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--mid);
  opacity: 0.35;
}

#trio-{{ section.id }} .trio__placeholder svg {
  width: 48px;
  height: 48px;
}

/* ── Text-Block ── */
#trio-{{ section.id }} .trio__text {
  text-align: center;
  padding-left: 1.5rem;
  padding-right: 1.5rem;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 1.1rem;
}

/* ── Eyebrow ── */
#trio-{{ section.id }} .trio__eyebrow {
  display: inline-flex;
  align-items: center;
  gap: 10px;
  font-size: 11px;
  font-weight: 600;
  letter-spacing: 0.24em;
  text-transform: uppercase;
  color: var(--accent);
  margin: 0;
}

#trio-{{ section.id }} .trio__eyebrow-rule {
  display: block;
  width: 22px;
  height: 1px;
  background: currentColor;
  opacity: 0.45;
  flex-shrink: 0;
}

/* ── Heading ── */
#trio-{{ section.id }} .trio__heading {
  font-size: clamp(26px, 3.2vw, 48px);
  font-weight: 300;
  color: var(--ink);
  line-height: 1.1;
  letter-spacing: -0.026em;
  text-wrap: balance;
  margin: 0;
  max-width: 820px;
}

#trio-{{ section.id }} .trio__heading em {
  font-family: 'Playfair Display', serif;
  font-style: italic;
  font-weight: 500;
  letter-spacing: -0.02em;
}

/* ── Subtext ── */
#trio-{{ section.id }} .trio__sub {
  font-size: clamp(15px, 1.15vw, 17px);
  font-weight: 400;
  color: var(--mid);
  line-height: 1.75;
  margin: 0;
  max-width: 680px;
  text-wrap: balance;
}

/* ── Button ── */
#trio-{{ section.id }} .trio__btn {
  display: inline-flex;
  align-items: center;
  background: var(--btn-bg);
  color: var(--btn-ink);
  font-family: 'Figtree', sans-serif;
  font-size: 15px;
  font-weight: 600;
  letter-spacing: 0.01em;
  padding: 14px 32px;
  border-radius: 999px;
  text-decoration: none;
  transition: opacity 0.2s, transform 0.2s;
  white-space: nowrap;
  margin-top: 0.25rem;
}

#trio-{{ section.id }} .trio__btn:hover {
  opacity: 0.88;
  transform: translateY(-1px);
}

/* ── Responsive ── */
@media (max-width: 700px) {
  #trio-{{ section.id }} .trio__grid {
    grid-template-columns: 1fr 1fr 1fr;
    gap: 3px;
  }

  #trio-{{ section.id }} .trio__img-wrap {
    aspect-ratio: 2 / 3;
  }

  #trio-{{ section.id }} .trio__btn {
    white-space: normal;
    text-align: center;
    max-width: 280px;
  }
}
</style>

{% schema %}
{
  "name": "Trio Portraits",
  "tag": "section",
  "settings": [
    {
      "type": "header",
      "content": "Bilder"
    },
    {
      "type": "image_picker",
      "id": "image_1",
      "label": "Bild 1 (links)"
    },
    {
      "type": "image_picker",
      "id": "image_2",
      "label": "Bild 2 (mitte)"
    },
    {
      "type": "image_picker",
      "id": "image_3",
      "label": "Bild 3 (rechts)"
    },
    {
      "type": "header",
      "content": "Text"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow (optional)",
      "default": "Echte Menschen. Echte Ergebnisse."
    },
    {
      "type": "richtext",
      "id": "heading",
      "label": "Überschrift",
      "default": "<p>Wenn Dein Selbstvertrauen wächst,<br><em>öffnet sich eine neue Welt</em></p>"
    },
    {
      "type": "textarea",
      "id": "subtext",
      "label": "Subtext",
      "default": "Bei Precon wissen wir: Selbstvertrauen beginnt oft mit einem kleinen, mutigen Schritt – und kann Dein ganzes Leben verändern. Seit über 40 Jahren begleiten wir Menschen auf ihrem Weg zum Wunschgewicht."
    },
    {
      "type": "header",
      "content": "Button (optional)"
    },
    {
      "type": "text",
      "id": "btn_label",
      "label": "Button Text"
    },
    {
      "type": "url",
      "id": "btn_url",
      "label": "Button Link"
    },
    {
      "type": "header",
      "content": "Abstände"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Abstand Text oben",
      "min": 24,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 64
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Abstand unten",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 72
    },
    {
      "type": "header",
      "content": "Farben"
    },
    {
      "type": "color",
      "id": "color_bg",
      "label": "Hintergrund",
      "default": "#FAF9F5"
    },
    {
      "type": "color",
      "id": "color_ink",
      "label": "Überschrift",
      "default": "#56473A"
    },
    {
      "type": "color",
      "id": "color_mid",
      "label": "Subtext",
      "default": "#8C7C70"
    },
    {
      "type": "color",
      "id": "color_accent",
      "label": "Eyebrow / Akzent",
      "default": "#3DADBB"
    },
    {
      "type": "color",
      "id": "color_btn_bg",
      "label": "Button Hintergrund",
      "default": "#3DADBB"
    },
    {
      "type": "color",
      "id": "color_btn_ink",
      "label": "Button Text",
      "default": "#FFFFFF"
    }
  ],
  "presets": [
    {
      "name": "Trio Portraits"
    }
  ]
}
{% endschema %}