<style>
  .hero-offer {
    padding: 28px 20px 32px;
    text-align: center;
    font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
    background-color: {{ section.settings.bg_color }};
    color: {{ section.settings.text_color }};
  }

  /* ── Badges ── */
  .hero-offer__badges {
    display: flex;
    justify-content: center;
    gap: 8px;
    flex-wrap: wrap;
    margin-bottom: 16px;
  }
  .hero-offer__badge {
    padding: 5px 14px;
    border-radius: 30px;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 1px;
    text-transform: uppercase;
    white-space: nowrap;
  }
  .hero-offer__badge--filled {
    background-color: {{ section.settings.accent_color }};
    color: #fff;
  }
  .hero-offer__badge--outlined {
    border: 2px solid {{ section.settings.text_color }};
    color: {{ section.settings.text_color }};
    background: transparent;
  }
  .hero-offer__badge--urgent {
    background-color: {{ section.settings.urgent_color }};
    color: #fff;
  }

  /* ── Heading ── */
  .hero-offer__heading {
    font-size: clamp(28px, 4.5vw, 42px);
    font-weight: 400;
    line-height: 1.2;
    margin: 0 auto 10px;
    max-width: 700px;
    color: {{ section.settings.text_color }};
  }
  .hero-offer__heading em {
    font-style: italic;
    font-family: Georgia, 'Times New Roman', serif;
    color: {{ section.settings.accent_color }};
  }

  /* ── Subtext ── */
  .hero-offer__subtext {
    font-size: 15px;
    line-height: 1.5;
    max-width: 600px;
    margin: 0 auto 8px;
    color: {{ section.settings.text_color }};
    opacity: 0.85;
  }

  /* ── Stars ── */
  .hero-offer__rating {
    margin-bottom: 20px;
    font-size: 14px;
    color: {{ section.settings.text_color }};
  }
  .hero-offer__stars {
    color: #d4a017;
    font-size: 18px;
    letter-spacing: 2px;
    margin-right: 6px;
  }
  .hero-offer__rating-count {
    opacity: 0.6;
  }

  /* ── Product image ── */
  .hero-offer__image-wrap {
    max-width: 520px;
    margin: 0 auto 20px;
    background: {{ section.settings.image_bg_color }};
    border-radius: 12px;
    padding: 16px;
    position: relative;
  }
  .hero-offer__image-wrap img {
    max-width: 100%;
    height: auto;
    display: block;
    margin: 0 auto;
  }
  .hero-offer__image-badge {
    position: absolute;
    top: 16px;
    left: 16px;
    background-color: {{ section.settings.urgent_color }};
    color: #fff;
    padding: 6px 14px;
    border-radius: 6px;
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 1px;
    text-transform: uppercase;
  }

  /* ── Pricing card ── */
  .hero-offer__card {
    max-width: 560px;
    margin: 0 auto;
    background: #fff;
    border: 3px solid {{ section.settings.card_border_color }};
    border-radius: 12px;
    padding: 28px 28px 22px;
    overflow: hidden;
  }
  .hero-offer__prices {
    display: flex;
    align-items: baseline;
    justify-content: center;
    flex-wrap: wrap;
    gap: 4px 12px;
    margin-bottom: 6px;
  }
  .hero-offer__price-old {
    font-size: 18px;
    text-decoration: line-through;
    opacity: 0.5;
  }
  .hero-offer__price-new {
    font-size: clamp(32px, 5vw, 44px);
    font-weight: 800;
    color: {{ section.settings.sale_price_color }};
  }
  .hero-offer__savings-badge {
    display: inline-block;
    border: 2px solid {{ section.settings.savings_color }};
    color: {{ section.settings.savings_color }};
    padding: 4px 12px;
    border-radius: 6px;
    font-size: 13px;
    font-weight: 700;
    white-space: nowrap;
  }
  .hero-offer__per-day {
    font-size: 14px;
    margin-bottom: 18px;
    opacity: 0.75;
  }
  .hero-offer__per-day strong {
    color: {{ section.settings.text_color }};
    opacity: 1;
  }

  /* ── CTA button ── */
  .hero-offer__cta {
    display: block;
    width: 100%;
    padding: 16px 24px;
    border: none;
    border-radius: 12px;
    background-color: {{ section.settings.cta_color }};
    color: #fff;
    font-size: 17px;
    font-weight: 800;
    letter-spacing: 0.8px;
    text-transform: uppercase;
    cursor: pointer;
    text-decoration: none;
    text-align: center;
    transition: opacity 0.2s;
    margin-bottom: 20px;
    font-family: inherit;
  }
  .hero-offer__cta:hover { opacity: 0.9; }

  /* ── Trust row ── */
  .hero-offer__trust {
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    gap: 8px 24px;
    font-size: 13px;
    opacity: 0.65;
  }
  .hero-offer__trust span::before {
    content: '\2713 ';
    font-weight: 700;
  }

  /* ── Mobile ── */
  @media (max-width: 600px) {
    .hero-offer {
      padding: 16px 12px 20px;
    }
    .hero-offer__badges {
      gap: 5px;
      margin-bottom: 10px;
    }
    .hero-offer__badge {
      padding: 3px 10px;
      font-size: 10px;
      letter-spacing: 0.6px;
    }
    .hero-offer__heading {
      font-size: 22px;
      margin-bottom: 6px;
    }
    .hero-offer__subtext {
      font-size: 13px;
      line-height: 1.4;
      margin-bottom: 6px;
    }
    .hero-offer__rating {
      margin-bottom: 12px;
      font-size: 12px;
    }
    .hero-offer__stars {
      font-size: 14px;
      letter-spacing: 1px;
    }
    .hero-offer__image-wrap {
      margin-bottom: 12px;
      padding: 10px;
      border-radius: 10px;
    }
    .hero-offer__card {
      padding: 20px 16px 18px;
      border-radius: 10px;
      border-width: 2px;
    }
    .hero-offer__prices {
      gap: 4px 8px;
      margin-bottom: 4px;
    }
    .hero-offer__price-old {
      font-size: 13px;
    }
    .hero-offer__price-new {
      font-size: 28px;
    }
    .hero-offer__savings-badge {
      font-size: 10px;
      padding: 3px 8px;
      border-width: 1.5px;
    }
    .hero-offer__per-day {
      font-size: 12px;
      margin-bottom: 14px;
    }
    .hero-offer__cta {
      padding: 14px 16px;
      font-size: 15px;
      border-radius: 10px;
      margin-bottom: 14px;
      letter-spacing: 0.5px;
    }
    .hero-offer__trust {
      justify-content: center;
      gap: 2px 12px;
      font-size: 11px;
    }
  }
</style>

<div class="hero-offer">

  <!-- Badges -->
  <div class="hero-offer__badges">
    {% for block in section.blocks %}
      {% if block.type == 'badge' %}
        <span class="hero-offer__badge hero-offer__badge--{{ block.settings.style }}">
          {{ block.settings.label }}
        </span>
      {% endif %}
    {% endfor %}
  </div>

  <!-- Heading -->
  <h2 class="hero-offer__heading">{{ section.settings.heading }}</h2>

  <!-- Subtext -->
  <p class="hero-offer__subtext">{{ section.settings.subtext }}</p>

  <!-- Rating -->
  <div class="hero-offer__rating">
    <span class="hero-offer__stars">&#9733;&#9733;&#9733;&#9733;&#9733;</span>
    <strong>{{ section.settings.rating }}</strong>
    <span class="hero-offer__rating-count">&mdash; {{ section.settings.rating_text }}</span>
  </div>

  <!-- Product image (optional) -->
  {% if section.settings.product_image != blank %}
    <div class="hero-offer__image-wrap">
      {% if section.settings.image_badge_text != blank %}
        <span class="hero-offer__image-badge">{{ section.settings.image_badge_text }}</span>
      {% endif %}
      <img
        src="{{ section.settings.product_image | image_url: width: 800 }}"
        alt="{{ section.settings.heading | strip_html }}"
        loading="lazy"
        width="800"
      >
    </div>
  {% endif %}

  <!-- Pricing card -->
  <div class="hero-offer__card">
    <div class="hero-offer__prices">
      <span class="hero-offer__price-old">{{ section.settings.price_old }}</span>
      <span class="hero-offer__price-new">{{ section.settings.price_new }}</span>
      {% if section.settings.savings_text != blank %}
        <span class="hero-offer__savings-badge">{{ section.settings.savings_text }}</span>
      {% endif %}
    </div>

    <p class="hero-offer__per-day">{{ section.settings.per_day_text }}</p>

    <!-- CTA -->
    <a href="{{ section.settings.cta_link }}" class="hero-offer__cta">
      &#10003; {{ section.settings.cta_text }}
    </a>

    <div class="hero-offer__trust">
      {% for block in section.blocks %}
        {% if block.type == 'trust_point' %}
          <span>{{ block.settings.text }}</span>
        {% endif %}
      {% endfor %}
    </div>
  </div>

</div>

{% schema %}
{
  "name": "Hero Offer",
  "settings": [
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#faf8f4"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#3a3631"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent Color",
      "default": "#2fb5a0"
    },
    {
      "type": "color",
      "id": "urgent_color",
      "label": "Urgent Badge Color",
      "default": "#d63031"
    },
    {
      "type": "color",
      "id": "image_bg_color",
      "label": "Image Card Background",
      "default": "#eef5f0"
    },
    {
      "type": "header",
      "content": "Pricing Card Colors"
    },
    {
      "type": "color",
      "id": "card_border_color",
      "label": "Card Border Color",
      "default": "#6c3fa0"
    },
    {
      "type": "color",
      "id": "sale_price_color",
      "label": "Sale Price Color",
      "default": "#c0392b"
    },
    {
      "type": "color",
      "id": "savings_color",
      "label": "Savings Badge Color",
      "default": "#2e8b57"
    },
    {
      "type": "color",
      "id": "cta_color",
      "label": "CTA Button Color",
      "default": "#e8a020"
    },
    {
      "type": "header",
      "content": "Heading & Copy"
    },
    {
      "type": "html",
      "id": "heading",
      "label": "Heading (use <em> for accent text)",
      "default": "Dein <em>4-Wochen-Start</em> ins Wunschgewicht"
    },
    {
      "type": "textarea",
      "id": "subtext",
      "label": "Subtext",
      "default": "Komplett ausgestattet für die ersten 4 Wochen. Ärztlich entwickelte Rezeptur, bewährt seit 39 Jahren."
    },
    {
      "type": "header",
      "content": "Rating"
    },
    {
      "type": "text",
      "id": "rating",
      "label": "Rating Score",
      "default": "4,8 / 5"
    },
    {
      "type": "text",
      "id": "rating_text",
      "label": "Rating Text",
      "default": "über 12.400 Bewertungen"
    },
    {
      "type": "header",
      "content": "Product Image"
    },
    {
      "type": "image_picker",
      "id": "product_image",
      "label": "Product Image (optional)"
    },
    {
      "type": "text",
      "id": "image_badge_text",
      "label": "Image Badge Text (leave blank to hide)",
      "default": "42% Sparen"
    },
    {
      "type": "header",
      "content": "Pricing"
    },
    {
      "type": "text",
      "id": "price_old",
      "label": "Old Price",
      "default": "€187,70"
    },
    {
      "type": "text",
      "id": "price_new",
      "label": "New Price",
      "default": "€109,00"
    },
    {
      "type": "html",
      "id": "per_day_text",
      "label": "Per-day line",
      "default": "Das sind nur <strong>€3,89 pro Tag</strong> für Deine komplette 4-Wochen-Versorgung"
    },
    {
      "type": "text",
      "id": "savings_text",
      "label": "Savings Badge Text",
      "default": "– 78,70 €"
    },
    {
      "type": "header",
      "content": "CTA Button"
    },
    {
      "type": "text",
      "id": "cta_text",
      "label": "Button Text",
      "default": "Jetzt 42% sparen"
    },
    {
      "type": "url",
      "id": "cta_link",
      "label": "Button Link"
    }
  ],
  "blocks": [
    {
      "type": "badge",
      "name": "Top Badge",
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Label",
          "default": "Badge"
        },
        {
          "type": "select",
          "id": "style",
          "label": "Style",
          "options": [
            { "value": "filled", "label": "Filled (accent)" },
            { "value": "outlined", "label": "Outlined" },
            { "value": "urgent", "label": "Urgent (red)" }
          ],
          "default": "filled"
        }
      ]
    },
    {
      "type": "trust_point",
      "name": "Trust Point",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "default": "Trust point"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Hero Offer",
      "blocks": [
        { "type": "badge", "settings": { "label": "42% Rabatt", "style": "filled" } },
        { "type": "badge", "settings": { "label": "Bestseller", "style": "outlined" } },
        { "type": "badge", "settings": { "label": "Nur Heute", "style": "urgent" } },
        { "type": "trust_point", "settings": { "text": "Lieferung 1–3 Werktage" } },
        { "type": "trust_point", "settings": { "text": "30 Tage Geld-zurück" } },
        { "type": "trust_point", "settings": { "text": "Sichere Zahlung" } }
      ]
    }
  ]
}
{% endschema %}