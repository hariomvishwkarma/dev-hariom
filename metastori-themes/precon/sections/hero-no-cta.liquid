{%- assign overlay_rgb = section.settings.overlay_color | color_to_rgb | remove: 'rgb(' | remove: ')' -%}
{%- assign overlay_max = section.settings.overlay_opacity | divided_by: 100.0 -%}
{%- assign overlay_mid = overlay_max | times: 0.33 | round: 2 -%}

<section class="hbnc" id="hbnc-{{ section.id }}">

  {%- if section.settings.background_image != blank -%}
    <div class="hbnc__media hbnc__media--desktop">
      {{ section.settings.background_image | image_url: width: 2600 | image_tag:
        class: 'hbnc__img',
        loading: 'eager',
        fetchpriority: 'high',
        sizes: '100vw',
        widths: '375, 750, 1100, 1500, 2000, 2600'
      }}
    </div>
  {%- endif -%}

  {%- assign mobile_img = section.settings.mobile_image -%}
  {%- if mobile_img != blank -%}
    <div class="hbnc__media hbnc__media--mobile">
      {{ mobile_img | image_url: width: 1100 | image_tag:
        class: 'hbnc__img',
        loading: 'eager',
        fetchpriority: 'high',
        sizes: '100vw',
        widths: '375, 750, 1100'
      }}
    </div>
  {%- endif -%}

  <div
    class="hbnc__overlay"
    style="
      --overlay-rgb: {{ overlay_rgb }};
      --overlay-max: {{ overlay_max }};
      --overlay-mid: {{ overlay_mid }};
    "
  ></div>

  <div class="hbnc__content page-width">

    {%- if section.settings.show_badge and section.settings.badge_text != blank -%}
      <span
        class="hbnc__badge"
        style="
          background: {{ section.settings.badge_bg_color }};
          color: {{ section.settings.badge_text_color }};
          border-color: {{ section.settings.badge_border_color }};
        "
      >
        <svg class="hbnc__badge-icon" width="10" height="10" viewBox="0 0 10 10" fill="none" xmlns="http://www.w3.org/2000/svg">
          <path d="M5 0L6.12 3.88L10 5L6.12 6.12L5 10L3.88 6.12L0 5L3.88 3.88L5 0Z" fill="currentColor"/>
        </svg>
        {{ section.settings.badge_text }}
      </span>
    {%- endif -%}

    <h1 class="hbnc__heading">
      {%- if section.settings.heading_line1 != blank -%}
        <span class="hbnc__line1">{{ section.settings.heading_line1 }}</span>
      {%- endif -%}
      {%- if section.settings.heading_line2 != blank -%}
        <em class="hbnc__line2">{{ section.settings.heading_line2 }}</em>
      {%- endif -%}
    </h1>

    {%- if section.settings.subtext != blank -%}
      <div class="hbnc__subtext">{{ section.settings.subtext }}</div>
    {%- endif -%}

  </div>

  {%- if section.settings.show_scroll_arrow -%}
    <div class="hbnc__scroll" style="color: {{ section.settings.scroll_arrow_color }};">
      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <polyline points="6 9 12 15 18 9"></polyline>
      </svg>
    </div>
  {%- endif -%}

</section>

<style>
  /* ── Wrapper ── */
  .hbnc {
    position: relative;
    width: 100%;
    min-height: 460px;
    display: flex;
    align-items: center;
    overflow: hidden;
    font-family: 'Figtree', -apple-system, BlinkMacSystemFont, sans-serif;
  }

  /* ── Background image ── */
  .hbnc__media {
    position: absolute;
    inset: 0;
    z-index: 0;
  }

  .hbnc__media--mobile {
    display: none;
  }

  .hbnc__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }

  /* ── Overlay: left-heavy gradient, strength driven by Liquid vars ── */
  .hbnc__overlay {
    position: absolute;
    inset: 0;
    z-index: 1;
    background: linear-gradient(
      to right,
      rgba(var(--overlay-rgb), var(--overlay-max)) 0%,
      rgba(var(--overlay-rgb), var(--overlay-mid)) 55%,
      transparent 80%
    );
    pointer-events: none;
  }

  /* ── Content ── */
  .hbnc__content {
    position: relative;
    z-index: 2;
    padding: 80px max(24px, 5rem);
    max-width: 820px;
  }

  /* ── Badge: Figtree Semi-Bold ── */
  .hbnc__badge {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    backdrop-filter: blur(6px);
    -webkit-backdrop-filter: blur(6px);
    border: 1px solid;
    border-radius: 6px;
    padding: 8px 16px;
    font-family: 'Figtree', sans-serif;
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    margin-bottom: 28px;
  }

  .hbnc__badge-icon {
    flex-shrink: 0;
  }

  /* ── Heading: Figtree Light ── */
  .hbnc__heading {
    font-family: 'Figtree', sans-serif;
    font-size: clamp(42px, 5.5vw, 72px);
    font-weight: 300;
    line-height: 1.08;
    color: #ffffff;
    margin: 0 0 24px;
  }

  .hbnc__line1 {
    display: block;
  }

  /* Line 2: Playfair Display Medium Italic */
  .hbnc__line2 {
    display: block;
    font-family: var(--accent-font-family);
    font-style: var(--accent-font-style);
    font-weight: 500;    
  }

  /* ── Subtext: Figtree Normal ── */
  .hbnc__subtext {
    font-family: 'Figtree', sans-serif;
    font-size: clamp(16px, 1.35vw, 20px);
    font-weight: 400;
    line-height: 1.65;
    color: rgba(255, 255, 255, 0.85);
    max-width: 480px;
  }

  .hbnc__subtext p {
    margin: 0 0 1em;
  }

  .hbnc__subtext p:last-child {
    margin-bottom: 0;
  }

  /* ── Scroll arrow: bottom-left, subtle bounce ── */
  .hbnc__scroll {
    position: absolute;
    bottom: 28px;
    left: 36px;
    z-index: 3;
    display: flex;
    align-items: center;
    opacity: 0.75;
    animation: hbnc-bob 2s ease-in-out infinite;
  }

  .hbnc__scroll svg {
    display: block;
  }

  @keyframes hbnc-bob {
    0%, 100% { transform: translateY(0); }
    50%       { transform: translateY(6px); }
  }

  /* ── Responsive ── */
  @media (max-width: 768px) {
    .hbnc {
      min-height: 520px;
    }

    .hbnc__content {
      padding: 60px 24px 72px;
      max-width: 100%;
    }

    {%- if mobile_img != blank -%}
      .hbnc__media--desktop { display: none; }
    {%- endif -%}

    .hbnc__media--mobile {
      display: block;
    }

    /* Mobile: top-to-bottom gradient so text stays legible */
    .hbnc__overlay {
      background: linear-gradient(
        to bottom,
        rgba(var(--overlay-rgb), var(--overlay-max)) 0%,
        rgba(var(--overlay-rgb), var(--overlay-mid)) 100%
      );
    }

    .hbnc__scroll {
      bottom: 16px;
      left: 20px;
    }
  }
</style>

{% schema %}
{
  "name": "Hero Banner",
  "tag": "section",
  "class": "section-hbnc",
  "settings": [
    {
      "type": "image_picker",
      "id": "background_image",
      "label": "Background image"
    },
    {
      "type": "image_picker",
      "id": "mobile_image",
      "label": "Mobile background image",
      "info": "Shown on screens 768px and below. Falls back to the desktop image if left empty."
    },
    {
      "type": "header",
      "content": "Overlay"
    },
    {
      "type": "color",
      "id": "overlay_color",
      "label": "Overlay color",
      "default": "#000000"
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "min": 0,
      "max": 100,
      "step": 5,
      "default": 60,
      "unit": "%",
      "label": "Overlay opacity"
    },
    {
      "type": "header",
      "content": "Badge"
    },
    {
      "type": "checkbox",
      "id": "show_badge",
      "label": "Badge anzeigen",
      "default": true
    },
    {
      "type": "text",
      "id": "badge_text",
      "label": "Badge text",
      "default": "40 JAHRE ABNEHMEXPERTISE"
    },
    {
      "type": "color",
      "id": "badge_text_color",
      "label": "Badge text color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "badge_bg_color",
      "label": "Badge background color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "badge_border_color",
      "label": "Badge border color",
      "default": "#ffffff"
    },
    {
      "type": "header",
      "content": "Text"
    },
    {
      "type": "text",
      "id": "heading_line1",
      "label": "Heading line 1",
      "default": "Abnehmen,"
    },
    {
      "type": "text",
      "id": "heading_line2",
      "label": "Heading line 2 (italic)",
      "default": "aber machbar."
    },
    {
      "type": "richtext",
      "id": "subtext",
      "label": "Subtext",
      "default": "<p>Das Precon-Konzept: 3 klare Phasen, die Deine Abnehmreise alltagstauglich, abwechslungsreich und erfolgreich machen.</p>"
    },
    {
      "type": "header",
      "content": "Scroll arrow"
    },
    {
      "type": "checkbox",
      "id": "show_scroll_arrow",
      "label": "Show scroll arrow",
      "default": true
    },
    {
      "type": "color",
      "id": "scroll_arrow_color",
      "label": "Arrow color",
      "default": "#ffffff"
    }
  ],
  "presets": [
    {
      "name": "Hero Banner"
    }
  ]
}
{% endschema %}