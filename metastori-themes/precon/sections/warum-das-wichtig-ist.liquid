{%- comment -%}
  sections/warum-das-wichtig.liquid
  Zentrierte Intro-Section: Eyebrow / 2-zeilige Headline / Untertitel
  Passt zum Stil der "Kennst Du Das"-Section (gleiche Eyebrow-Linien, gleiche Tokens)
  Fonts: Figtree 300/400/600 + Playfair Display 500 italic
{%- endcomment -%}

{%- liquid
  assign c_bg     = section.settings.color_bg
  assign c_ink    = section.settings.color_ink
  assign c_mid    = section.settings.color_mid
  assign c_accent = section.settings.color_accent
-%}

<div id="wdw-{{ section.id }}" class="wdw">
  <div class="wdw__inner">

    {%- if section.settings.eyebrow != blank -%}
      <p class="wdw__eyebrow">
        <span class="wdw__eyebrow-rule"></span>
        {{ section.settings.eyebrow }}
        <span class="wdw__eyebrow-rule"></span>
      </p>
    {%- endif -%}

    <h2 class="wdw__heading">
      {%- if section.settings.heading_line1 != blank -%}
        {{ section.settings.heading_line1 }}<br>
      {%- endif -%}
      {%- if section.settings.heading_line2 != blank -%}
        <em>{{ section.settings.heading_line2 }}</em>
      {%- endif -%}
    </h2>

    <div class="wdw__divider" aria-hidden="true"></div>

    {%- if section.settings.subtitle != blank -%}
      <p class="wdw__subtitle">{{ section.settings.subtitle }}</p>
    {%- endif -%}

  </div>
</div>

<style>
@import url('https://fonts.googleapis.com/css2?family=Figtree:wght@300;400;600&family=Playfair+Display:ital,wght@1,500&display=swap');

#wdw-{{ section.id }} {
  --bg:     {{ c_bg }};
  --ink:    {{ c_ink }};
  --mid:    {{ c_mid }};
  --accent: {{ c_accent }};
  --rule:   rgba(86,71,58,0.08);
}

#wdw-{{ section.id }},
#wdw-{{ section.id }} * { box-sizing: border-box; }

#wdw-{{ section.id }} {
  background: var(--bg);
  font-family: 'Figtree', sans-serif;
  -webkit-font-smoothing: antialiased;
  padding: 4rem 1.5rem;
}

/* ── Inner ── */
#wdw-{{ section.id }} .wdw__inner {
  max-width: 660px;
  margin: 0 auto;
  text-align: center;
}

/* ── Eyebrow ── */
#wdw-{{ section.id }} .wdw__eyebrow {
  display: inline-flex;
  align-items: center;
  gap: 10px;
  font-size: 11px;
  font-weight: 600;
  letter-spacing: 0.24em;
  text-transform: uppercase;
  color: var(--accent);
  margin-bottom: 1rem;
}

#wdw-{{ section.id }} .wdw__eyebrow-rule {
  display: block;
  width: 22px;
  height: 1px;
  background: currentColor;
  opacity: 0.45;
}

/* ── Heading ── */
#wdw-{{ section.id }} .wdw__heading {
  font-family: 'Figtree', sans-serif;
  font-size: clamp(32px, 4vw, 48px);
  font-weight: 300;
  color: var(--ink);
  line-height: 1.06;
  letter-spacing: -0.026em;
  text-wrap: balance;
  margin-bottom: 1.25rem;
}

#wdw-{{ section.id }} .wdw__heading em {
  font-family: 'Playfair Display', serif;
  font-style: italic;
  font-weight: 500;
  display: block;
  letter-spacing: -0.02em;
}

/* ── Divider ── */
#wdw-{{ section.id }} .wdw__divider {
  width: 40px;
  height: 1px;
  background: var(--rule);
  margin: 1.25rem auto;
}

/* ── Subtitle ── */
#wdw-{{ section.id }} .wdw__subtitle {
  font-size: clamp(15px, 1.15vw, 16.5px);
  font-weight: 400;
  line-height: 1.8;
  color: var(--mid);
  max-width: 520px;
  margin: 0 auto;
}

/* ── Responsive ── */
@media (max-width: 768px) {
  #wdw-{{ section.id }} { padding: 2.5rem 1rem; }
}
</style>

{% schema %}
{
  "name": "Warum Das Wichtig Ist",
  "tag": "section",
  "settings": [
    { "type": "header", "content": "Inhalt" },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Warum das wichtig ist"
    },
    {
      "type": "text",
      "id": "heading_line1",
      "label": "Überschrift Zeile 1",
      "default": "Ein Shake allein ist"
    },
    {
      "type": "text",
      "id": "heading_line2",
      "label": "Überschrift Zeile 2 (kursiv, Playfair)",
      "default": "kein Plan."
    },
    {
      "type": "textarea",
      "id": "subtitle",
      "label": "Untertitel",
      "default": "Die meisten kaufen einen Shake, starten motiviert und hören nach zwei Wochen wieder auf. Das Problem ist nicht der Shake. Es ist das fehlende System."
    },
    { "type": "header", "content": "Farben" },
    { "type": "color", "id": "color_bg",     "label": "Hintergrund",  "default": "#FAF9F5" },
    { "type": "color", "id": "color_ink",    "label": "Text dunkel",  "default": "#56473A" },
    { "type": "color", "id": "color_mid",    "label": "Text gedimmt", "default": "#8C7C70" },
    { "type": "color", "id": "color_accent", "label": "Akzentfarbe",  "default": "#3DADBB" }
  ],
  "presets": [
    {
      "name": "Warum Das Wichtig Ist"
    }
  ]
}
{% endschema %}