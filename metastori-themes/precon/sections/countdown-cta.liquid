<section class="cdcta" id="cdcta-{{ section.id }}" style="background: {{ section.settings.section_bg }};">
  <div class="cdcta__inner page-width">

    <!-- ── Eyebrow with line ── -->
    {%- if section.settings.eyebrow != blank -%}
      <div class="cdcta__eyebrow-wrap">
        <div class="cdcta__line" style="background: {{ section.settings.eyebrow_color }};"></div>
        <p class="cdcta__eyebrow" style="color: {{ section.settings.eyebrow_color }};">{{ section.settings.eyebrow }}</p>
      </div>
    {%- endif -%}

    <!-- ── Countdown card ── -->
    <div class="cdcta__card" style="background: {{ section.settings.card_bg }};">
      <div class="cdcta__timer" id="cdcta-timer-{{ section.id }}">
        <div class="cdcta__unit">
          <span class="cdcta__num" id="cdcta-days-{{ section.id }}" style="color: {{ section.settings.number_color }};">00</span>
          <span class="cdcta__label" style="color: {{ section.settings.label_color }};">{{ section.settings.label_days }}</span>
        </div>
        <span class="cdcta__sep" style="color: {{ section.settings.number_color }};">:</span>
        <div class="cdcta__unit">
          <span class="cdcta__num" id="cdcta-hours-{{ section.id }}" style="color: {{ section.settings.number_color }};">00</span>
          <span class="cdcta__label" style="color: {{ section.settings.label_color }};">{{ section.settings.label_hours }}</span>
        </div>
        <span class="cdcta__sep" style="color: {{ section.settings.number_color }};">:</span>
        <div class="cdcta__unit">
          <span class="cdcta__num" id="cdcta-mins-{{ section.id }}" style="color: {{ section.settings.number_color }};">00</span>
          <span class="cdcta__label" style="color: {{ section.settings.label_color }};">{{ section.settings.label_mins }}</span>
        </div>
        <span class="cdcta__sep" style="color: {{ section.settings.number_color }};">:</span>
        <div class="cdcta__unit">
          <span class="cdcta__num" id="cdcta-secs-{{ section.id }}" style="color: {{ section.settings.number_color }};">00</span>
          <span class="cdcta__label" style="color: {{ section.settings.label_color }};">{{ section.settings.label_secs }}</span>
        </div>
      </div>
    </div>

    <!-- ── Heading ── -->
    <h2 class="cdcta__heading">
      {%- if section.settings.heading_regular != blank -%}
        <span class="cdcta__head-regular" style="color: {{ section.settings.heading_color }};">{{ section.settings.heading_regular }} </span>
      {%- endif -%}
      {%- if section.settings.heading_italic != blank -%}
        <em class="cdcta__head-italic" style="color: {{ section.settings.italic_color }};">{{ section.settings.heading_italic }}</em>
      {%- endif -%}
    </h2>

    <!-- ── Subtext ── -->
    {%- if section.settings.subtext != blank -%}
      <div class="cdcta__subtext" style="color: {{ section.settings.subtext_color }};">{{ section.settings.subtext }}</div>
    {%- endif -%}

    <!-- ── CTA ── -->
    {%- if section.settings.cta_label != blank and section.settings.cta_url != blank -%}
      <a
        class="cdcta__cta"
        href="{{ section.settings.cta_url }}"
        style="background: {{ section.settings.cta_bg }}; color: {{ section.settings.cta_text }};"
      >{{ section.settings.cta_label }} →</a>
    {%- endif -%}

  </div>
</section>

<style>
  /* ── Section ── */
  .cdcta {
    padding: {{ section.settings.padding_top }}px 0 {{ section.settings.padding_bottom }}px;
    font-family: 'Figtree', -apple-system, BlinkMacSystemFont, sans-serif;
  }

  .cdcta__inner {
    max-width: 860px;
    margin: 0 auto;
    padding: 0 24px;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  /* ── Eyebrow ── */
  .cdcta__eyebrow-wrap {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 16px;
    margin-bottom: 36px;
  }

  .cdcta__line {
    width: 1px;
    height: 44px;
  }

  .cdcta__eyebrow {
    font-family: 'Figtree', sans-serif;
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    margin: 0;
  }

  /* ── Countdown card ── */
  .cdcta__card {
    border-radius: 20px;
    padding: 36px 52px;
    box-shadow: 0 2px 24px rgba(0, 0, 0, 0.07);
    margin-bottom: 52px;
    width: 100%;
    max-width: 600px;
  }

  .cdcta__timer {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 20px;
  }

  .cdcta__unit {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 6px;
    min-width: 72px;
  }

  .cdcta__num {
    font-family: var(--accent-font-family);
    font-style: var(--accent-font-style);
    font-size: clamp(48px, 6vw, 76px);
    font-weight: 500;
    line-height: 1;
    display: block;
  }

  .cdcta__label {
    font-family: 'Figtree', sans-serif;
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  .cdcta__sep {
    font-family: var(--accent-font-family);
    font-style: var(--accent-font-style);
    font-size: clamp(40px, 5vw, 64px);
    font-weight: 500;
    line-height: 1;
    margin-bottom: 20px; /* align with numbers, offset for label */
    opacity: 0.5;
  }

  /* ── Heading ── */
  .cdcta__heading {
    font-family: 'Figtree', sans-serif;
    font-size: clamp(30px, 4vw, 52px);
    font-weight: 300;
    line-height: 1.15;
    margin: 0 0 20px;
  }

  .cdcta__head-regular {
    font-family: 'Figtree', sans-serif;
    font-weight: 300;
    font-style: normal;
  }

  .cdcta__head-italic {
    font-family: var(--accent-font-family);
    font-style: var(--accent-font-style);
    font-weight: 500;
  }

  /* ── Subtext ── */
  .cdcta__subtext {
    font-family: 'Figtree', sans-serif;
    font-size: clamp(15px, 1.2vw, 18px);
    font-weight: 400;
    line-height: 1.7;
    max-width: 580px;
    margin-bottom: 36px;
  }

  .cdcta__subtext p { margin: 0 0 0.8em; }
  .cdcta__subtext p:last-child { margin-bottom: 0; }

  /* ── CTA ── */
  .cdcta__cta {
    display: inline-block;
    font-family: 'Figtree', sans-serif;
    font-size: 15px;
    font-weight: 600;
    letter-spacing: 0.01em;
    padding: 18px 40px;
    border-radius: 50px;
    text-decoration: none;
    transition: opacity 0.2s ease, transform 0.2s ease;
  }

  .cdcta__cta:hover {
    opacity: 0.85;
    transform: translateY(-2px);
  }

  /* ── Mobile ── */
  @media (max-width: 600px) {
    .cdcta__card {
      padding: 28px 20px;
    }

    .cdcta__timer {
      gap: 10px;
    }

    .cdcta__unit {
      min-width: 52px;
    }

    .cdcta__sep {
      font-size: 32px;
    }
  }
</style>

<script>
  (function () {
    var endDateStr = {{ section.settings.countdown_end | json }};
    var endDate = new Date(endDateStr);

    var daysEl  = document.getElementById('cdcta-days-{{ section.id }}');
    var hoursEl = document.getElementById('cdcta-hours-{{ section.id }}');
    var minsEl  = document.getElementById('cdcta-mins-{{ section.id }}');
    var secsEl  = document.getElementById('cdcta-secs-{{ section.id }}');

    function pad(n) { return n < 10 ? '0' + n : '' + n; }

    function tick() {
      var now  = new Date();
      var diff = endDate - now;

      if (diff <= 0) {
        daysEl.textContent  = '00';
        hoursEl.textContent = '00';
        minsEl.textContent  = '00';
        secsEl.textContent  = '00';
        return;
      }

      var days  = Math.floor(diff / 86400000);
      var hours = Math.floor((diff % 86400000) / 3600000);
      var mins  = Math.floor((diff % 3600000)  / 60000);
      var secs  = Math.floor((diff % 60000)    / 1000);

      daysEl.textContent  = pad(days);
      hoursEl.textContent = pad(hours);
      minsEl.textContent  = pad(mins);
      secsEl.textContent  = pad(secs);
    }

    tick();
    setInterval(tick, 1000);
  })();
</script>

{% schema %}
