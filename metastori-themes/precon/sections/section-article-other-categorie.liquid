{%- liquid
  assign all_handles = section.settings.blog_handles | split: ','
  assign cards = '' | split: ''
  for handle in all_handles
    assign h = handle | strip
    unless h == blog.handle
      assign related_blog = blogs[h]
      if related_blog and related_blog.articles_count > 0
        assign cards = cards | push: related_blog
      endif
    endunless
  endfor
-%}

{%- if cards.size > 0 -%}
<section class="aoc" id="aoc-{{ section.id }}">
  <div class="aoc__inner">

    {%- if section.settings.heading != blank -%}
      <h2 class="aoc__heading">{{ section.settings.heading }}</h2>
    {%- endif -%}

    <div class="aoc__grid">
      {%- for related_blog in cards -%}
        {%- assign art = related_blog.articles.first -%}
        {%- if art == blank -%}{%- continue -%}{%- endif -%}

        {%- liquid
          assign words = art.content | strip_html | split: ' '
          assign read_time = words.size | divided_by: 200
          if read_time < 1
            assign read_time = 1
          endif
        -%}

        <a class="aoc__card" href="{{ art.url }}">
          <div class="aoc__card-img-wrap">
            {%- if art.image != blank -%}
              {{ art.image | image_url: width: 800 | image_tag:
                class: 'aoc__card-img',
                loading: 'lazy',
                sizes: '(max-width: 768px) 100vw, 33vw',
                widths: '400, 600, 800',
                alt: art.title
              }}
            {%- else -%}
              <div class="aoc__card-img-placeholder"></div>
            {%- endif -%}
            <span class="aoc__card-badge">{{ related_blog.title }}</span>
          </div>
          <div class="aoc__card-body">
            <p class="aoc__card-title">{{ art.title }}</p>
            <div class="aoc__card-meta">
              <span class="aoc__card-date">{{ art.published_at | date: '%d. %m. %Y' }}</span>
              <span class="aoc__card-read">{{ read_time }} Min.</span>
            </div>
            <span class="aoc__card-link">{{ section.settings.link_label }} →</span>
          </div>
        </a>
      {%- endfor -%}
    </div>

  </div>
</section>
{%- endif -%}

<style>
  .aoc {
    background: {{ section.settings.bg_color }};
    padding: 48px 0;
  }
  .aoc__inner {
    max-width: 1200px;
    margin: 0 auto;
    padding-left: 32px;
    padding-right: 32px;
  }
  .aoc__heading {
    font-size: 22px;
    font-weight: 700;
    color: {{ section.settings.heading_color }};
    margin: 0 0 28px;
    text-align: {{ section.settings.heading_align }};
  }
  .aoc__grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
  }

  /* Card */
  .aoc__card {
    display: flex;
    flex-direction: column;
    text-decoration: none;
    border-radius: 12px;
    overflow: hidden;
    background: #fff;
    border: 1px solid rgba(0,0,0,0.07);
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }
  .aoc__card:hover {
    transform: translateY(-3px);
    box-shadow: 0 8px 24px rgba(0,0,0,0.10);
  }

  /* Image */
  .aoc__card-img-wrap {
    position: relative;
    height: 200px;
    overflow: hidden;
    flex-shrink: 0;
  }
  .aoc__card-img,
  .aoc__card-img-placeholder {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.3s ease;
  }
  .aoc__card-img-placeholder {
    background: #e8e0d8;
  }
  .aoc__card:hover .aoc__card-img {
    transform: scale(1.04);
  }

  /* Badge */
  .aoc__card-badge {
    position: absolute;
    top: 12px;
    left: 12px;
    background: {{ section.settings.badge_bg }};
    color: {{ section.settings.badge_color }};
    font-size: 11px;
    font-weight: 700;
    padding: 4px 10px;
    border-radius: 50px;
    letter-spacing: 0.03em;
    pointer-events: none;
  }

  /* Body */
  .aoc__card-body {
    padding: 16px;
    display: flex;
    flex-direction: column;
    gap: 8px;
    flex: 1;
  }
  .aoc__card-title {
    font-size: 15px;
    font-weight: 700;
    color: {{ section.settings.title_color }};
    margin: 0;
    line-height: 1.35;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .aoc__card-meta {
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: 12px;
    color: {{ section.settings.meta_color }};
    opacity: 0.7;
  }
  .aoc__card-meta span:not(:last-child)::after {
    content: '·';
    margin-left: 10px;
  }
  .aoc__card-link {
    font-size: 13px;
    font-weight: 600;
    color: {{ section.settings.link_color }};
    margin-top: auto;
  }

  /* Mobile */
  @media (max-width: 768px) {
    .aoc {
      padding: 32px 0;
    }
    .aoc__inner {
      padding-left: 16px;
      padding-right: 16px;
    }
    .aoc__heading {
      font-size: 18px;
      margin-bottom: 20px;
    }
    .aoc__grid {
      grid-template-columns: 1fr;
      gap: 14px;
    }
    .aoc__card-img-wrap {
      height: 180px;
    }
    .aoc__card {
      flex-direction: row;
      border-radius: 10px;
      height: 120px;
    }
    .aoc__card-img-wrap {
      width: 120px;
      height: 120px;
      flex-shrink: 0;
      border-radius: 0;
    }
    .aoc__card-body {
      padding: 12px;
      gap: 4px;
      justify-content: center;
    }
    .aoc__card-title {
      font-size: 13px;
      -webkit-line-clamp: 2;
    }
    .aoc__card-badge {
      font-size: 10px;
      padding: 3px 8px;
    }
    .aoc__card-link {
      font-size: 12px;
    }
  }
</style>

{% schema %}
{
  "name": "Weitere Kategorien",
  "tag": "section",
  "class": "section-article-other-categories",
  "settings": [
    {
      "type": "header",
      "content": "Blogs"
    },
    {
      "type": "text",
      "id": "blog_handles",
      "label": "Blog Handles (kommagetrennt)",
      "default": "essen-trinken,diaet-ernaehrung,lebensstil,erfahrungen",
      "info": "Handles aller Blogs. Der aktuelle Blog wird automatisch ausgeblendet."
    },
    {
      "type": "header",
      "content": "Überschrift"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Überschrift",
      "default": "Auch interessant"
    },
    {
      "type": "select",
      "id": "heading_align",
      "label": "Ausrichtung",
      "options": [
        { "value": "left", "label": "Links" },
        { "value": "center", "label": "Zentriert" }
      ],
      "default": "left"
    },
    {
      "type": "text",
      "id": "link_label",
      "label": "Link Text",
      "default": "Artikel lesen"
    },
    {
      "type": "header",
      "content": "Farben"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Hintergrund",
      "default": "#faf9f6"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Überschrift",
      "default": "#56473A"
    },
    {
      "type": "color",
      "id": "title_color",
      "label": "Artikel Titel",
      "default": "#56473A"
    },
    {
      "type": "color",
      "id": "meta_color",
      "label": "Datum & Lesezeit",
      "default": "#56473A"
    },
    {
      "type": "color",
      "id": "link_color",
      "label": "Link Farbe",
      "default": "#2a7a72"
    },
    {
      "type": "color",
      "id": "badge_bg",
      "label": "Badge Hintergrund",
      "default": "#d4f0ed"
    },
    {
      "type": "color",
      "id": "badge_color",
      "label": "Badge Text",
      "default": "#1a5c57"
    }
  ],
  "presets": [
    {
      "name": "Weitere Kategorien"
    }
  ]
}
{% endschema %}