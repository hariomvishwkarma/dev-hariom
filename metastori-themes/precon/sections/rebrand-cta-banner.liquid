{%- comment -%}
  sections/precon-cta-banner.liquid
  Precon CTA Banner – zentrierter Call-to-Action mit dunklem Hintergrund
  Fonts: Figtree 400/600 + Playfair Display italic
  CSS-Prefix: .ctab
{%- endcomment -%}

<section class="ctab" id="ctab-{{ section.id }}"
  style="background:{{ section.settings.color_bg }};">
  <div class="ctab__inner">

    {%- if section.settings.eyebrow != blank -%}
      <p class="ctab__eyebrow" style="color:{{ section.settings.color_eyebrow }};">
        {{ section.settings.eyebrow }}
      </p>
    {%- endif -%}

    {%- if section.settings.heading_line1 != blank or section.settings.heading_line2 != blank -%}
      <h2 class="ctab__title" style="color:{{ section.settings.color_title }};">
        {%- if section.settings.heading_line1 != blank -%}
          <span class="ctab__title-line1">{{ section.settings.heading_line1 }}</span>
        {%- endif -%}
        {%- if section.settings.heading_line2 != blank -%}
          <em class="ctab__title-line2">{{ section.settings.heading_line2 }}</em>
        {%- endif -%}
      </h2>
    {%- endif -%}

    {%- if section.settings.subtext != blank -%}
      <p class="ctab__sub" style="color:{{ section.settings.color_sub }};">
        {{ section.settings.subtext }}
      </p>
    {%- endif -%}

    {%- if section.settings.btn_label != blank -%}
      <a
        href="{{ section.settings.btn_url | default: '#' }}"
        class="ctab__btn"
        style="background:{{ section.settings.color_btn_bg }};color:{{ section.settings.color_btn_text }};"
      >
        {{ section.settings.btn_label }}
      </a>
    {%- endif -%}

  </div>
</section>

<style>
@import url('https://fonts.googleapis.com/css2?family=Figtree:wght@400;600&family=Playfair+Display:ital,wght@1,500&display=swap');

#ctab-{{ section.id }} {
  font-family: 'Figtree', sans-serif;
  -webkit-font-smoothing: antialiased;
}

#ctab-{{ section.id }} .ctab__inner {
  max-width: 680px;
  margin: 0 auto;
  padding: 5rem max(24px, 3rem);
  text-align: center;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 0;
}

/* Eyebrow */
#ctab-{{ section.id }} .ctab__eyebrow {
  font-size: 12px;
  font-weight: 700;
  letter-spacing: 0.14em;
  text-transform: uppercase;
  margin: 0 0 18px;
}

/* Titel */
#ctab-{{ section.id }} .ctab__title {
  font-size: clamp(28px, 4vw, 44px);
  font-weight: 600;
  line-height: 1.2;
  margin: 0 0 20px;
  font-style: normal;
}
#ctab-{{ section.id }} .ctab__title-line1 {
  display: block;
}
#ctab-{{ section.id }} .ctab__title-line2 {
  display: block;
  font-family: 'Playfair Display', Georgia, serif;
  font-style: italic;
  font-weight: 500;
  font-size: 1.08em;
}

/* Subtext */
#ctab-{{ section.id }} .ctab__sub {
  font-size: clamp(14px, 1.1vw, 16px);
  line-height: 1.7;
  max-width: 520px;
  margin: 0 0 32px;
  opacity: 0.88;
}

/* Button */
#ctab-{{ section.id }} .ctab__btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 14px 34px;
  border-radius: 50px;
  font-size: 15px;
  font-weight: 600;
  text-decoration: none;
  letter-spacing: 0.01em;
  transition: opacity 0.2s ease, transform 0.2s ease;
  white-space: nowrap;
}
#ctab-{{ section.id }} .ctab__btn:hover {
  opacity: 0.88;
  transform: translateY(-2px);
}

/* Responsive */
@media (max-width: 768px) {
  #ctab-{{ section.id }} .ctab__inner {
    padding: 3.5rem 24px;
  }
  #ctab-{{ section.id }} .ctab__title {
    font-size: clamp(24px, 6vw, 34px);
  }
}
</style>

{% schema %}
{
  "name": "CTA Banner",
  "tag": "section",
  "class": "section-cta-banner",
  "settings": [
    {
      "type": "header",
      "content": "Farben"
    },
    {
      "type": "color",
      "id": "color_bg",
      "label": "Hintergrund",
      "default": "#56473A"
    },
    {
      "type": "color",
      "id": "color_eyebrow",
      "label": "Eyebrow Farbe",
      "default": "#3DADBB"
    },
    {
      "type": "color",
      "id": "color_title",
      "label": "Titel Farbe",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "color_sub",
      "label": "Subtext Farbe",
      "default": "#c8bfb8"
    },
    {
      "type": "color",
      "id": "color_btn_bg",
      "label": "Button Hintergrund",
      "default": "#3DADBB"
    },
    {
      "type": "color",
      "id": "color_btn_text",
      "label": "Button Textfarbe",
      "default": "#ffffff"
    },
    {
      "type": "header",
      "content": "Inhalt"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow Text",
      "default": "Jetzt starten"
    },
    {
      "type": "text",
      "id": "heading_line1",
      "label": "Überschrift Zeile 1",
      "default": "Dein Weg zu"
    },
    {
      "type": "text",
      "id": "heading_line2",
      "label": "Überschrift Zeile 2 (kursiv, Playfair)",
      "default": "mehr Wohlbefinden"
    },
    {
      "type": "textarea",
      "id": "subtext",
      "label": "Subtext",
      "default": "Entdecke unsere Produkte und starte noch heute in ein gesünderes Leben."
    },
    {
      "type": "header",
      "content": "Button"
    },
    {
      "type": "text",
      "id": "btn_label",
      "label": "Button Text",
      "default": "Jetzt entdecken"
    },
    {
      "type": "url",
      "id": "btn_url",
      "label": "Button Link"
    }
  ],
  "presets": [
    {
      "name": "CTA Banner"
    }
  ]
}
{% endschema %}