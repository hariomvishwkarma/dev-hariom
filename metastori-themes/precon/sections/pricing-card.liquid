<style>
  .price-cta {
    padding: 48px 20px;
    font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
    background-color: {{ section.settings.bg_color }};
    color: {{ section.settings.text_color }};
    text-align: center;
  }
  .price-cta__label {
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 2px;
    text-transform: uppercase;
    color: {{ section.settings.accent_color }};
    margin-bottom: 8px;
  }
  .price-cta__heading {
    font-size: clamp(28px, 4.5vw, 42px);
    font-weight: 400;
    font-family: Georgia, 'Times New Roman', serif;
    line-height: 1.15;
    margin: 0 auto 28px;
  }

  /* ── Card ── */
  .price-cta__card {
    max-width: 520px;
    margin: 0 auto;
    background: #fff;
    border-radius: 20px;
    padding: 36px 32px 32px;
    box-shadow: 0 2px 16px rgba(0,0,0,0.04);
  }
  .price-cta__badge {
    display: inline-block;
    background: {{ section.settings.badge_bg }};
    color: {{ section.settings.badge_text_color }};
    padding: 6px 20px;
    border-radius: 30px;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 1.5px;
    text-transform: uppercase;
    margin-bottom: 14px;
  }
  .price-cta__subtitle {
    font-size: 18px;
    font-weight: 700;
    margin: 0 0 20px;
  }
  .price-cta__prices {
    display: flex;
    align-items: baseline;
    justify-content: center;
    gap: 12px;
    margin-bottom: 12px;
  }
  .price-cta__old {
    font-size: 18px;
    font-family: Georgia, 'Times New Roman', serif;
    text-decoration: line-through;
    opacity: 0.4;
  }
  .price-cta__new {
    font-size: clamp(42px, 6vw, 56px);
    font-family: Georgia, 'Times New Roman', serif;
    font-weight: 700;
    color: {{ section.settings.price_color }};
    line-height: 1;
  }
  .price-cta__per-day {
    font-size: 15px;
    margin: 0 0 24px;
    opacity: 0.75;
  }
  .price-cta__per-day strong {
    color: {{ section.settings.accent_color }};
    opacity: 1;
  }

  /* ── CTA ── */
  .price-cta__btn {
    display: block;
    width: 100%;
    max-width: 380px;
    margin: 0 auto 20px;
    padding: 18px 24px;
    background: {{ section.settings.cta_color }};
    color: #fff;
    font-size: 18px;
    font-weight: 700;
    border: none;
    border-radius: 50px;
    cursor: pointer;
    text-decoration: none;
    text-align: center;
    font-family: inherit;
    transition: opacity 0.2s;
  }
  .price-cta__btn:hover {
    opacity: 0.9;
  }
  .price-cta__btn[aria-busy="true"] {
    pointer-events: none;
    opacity: 0.6;
  }
  .price-cta__trust {
    font-size: 13px;
    opacity: 0.5;
    margin: 0;
  }

  @media (max-width: 600px) {
    .price-cta {
      padding: 24px 14px;
    }
    .price-cta__heading {
      font-size: 24px;
      margin-bottom: 20px;
    }
    .price-cta__card {
      padding: 24px 20px 22px;
      border-radius: 14px;
    }
    .price-cta__badge {
      font-size: 10px;
      padding: 4px 14px;
    }
    .price-cta__subtitle {
      font-size: 15px;
      margin-bottom: 14px;
    }
    .price-cta__old {
      font-size: 15px;
    }
    .price-cta__new {
      font-size: 36px;
    }
    .price-cta__per-day {
      font-size: 13px;
      margin-bottom: 18px;
    }
    .price-cta__btn {
      font-size: 16px;
      padding: 15px 20px;
      margin-bottom: 14px;
    }
    .price-cta__trust {
      font-size: 11px;
    }
  }
</style>

<div class="price-cta">
  {% if section.settings.top_label != blank %}
    <div class="price-cta__label">{{ section.settings.top_label }}</div>
  {% endif %}

  <h2 class="price-cta__heading">{{ section.settings.heading }}</h2>

  <div class="price-cta__card">
    {% if section.settings.badge_text != blank %}
      <span class="price-cta__badge">{{ section.settings.badge_text }}</span>
    {% endif %}

    {% if section.settings.subtitle != blank %}
      <div class="price-cta__subtitle">{{ section.settings.subtitle }}</div>
    {% endif %}

    <div class="price-cta__prices">
      {% if section.settings.old_price != blank %}
        <span class="price-cta__old">{{ section.settings.old_price }}</span>
      {% endif %}
      <span class="price-cta__new">{{ section.settings.new_price }}</span>
    </div>

    {% if section.settings.per_day != blank %}
      <p class="price-cta__per-day">{{ section.settings.per_day }}</p>
    {% endif %}

    {% if section.settings.product != blank %}
      {%- assign pc_product = section.settings.product -%}
      <button
        type="button"
        class="price-cta__btn"
        id="price-cta-btn-{{ section.id }}"
        data-vid="{{ pc_product.selected_or_first_available_variant.id }}"
        {% unless pc_product.available %}disabled{% endunless %}
      >
        {{ section.settings.cta_text }}
      </button>
    {% else %}
      <a href="{{ section.settings.cta_url }}" class="price-cta__btn">
        {{ section.settings.cta_text }}
      </a>
    {% endif %}

    {% if section.settings.trust_text != blank %}
      <p class="price-cta__trust">{{ section.settings.trust_text }}</p>
    {% endif %}
  </div>
</div>

{% if section.settings.product != blank %}
<script>
(function() {
  var btn = document.getElementById('price-cta-btn-{{ section.id }}');
  if (!btn) return;

  btn.addEventListener('click', function() {
    if (btn.hasAttribute('disabled') || btn.getAttribute('aria-busy') === 'true') return;

    var vid = btn.getAttribute('data-vid');
    if (!vid) return;

    btn.setAttribute('aria-busy', 'true');
    var origText = btn.textContent;
    btn.textContent = 'Wird hinzugefügt...';

    fetch('/cart/add.js', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ items: [{ id: parseInt(vid), quantity: 1 }] })
    })
    .then(function(res) {
      if (!res.ok) throw new Error('Cart error');
      return res.json();
    })
    .then(function() {
      window.location.href = '/cart';
    })
    .catch(function(err) {
      console.error('Add to cart failed:', err);
      btn.textContent = 'Fehler – erneut versuchen';
      setTimeout(function() {
        btn.removeAttribute('aria-busy');
        btn.textContent = origText;
      }, 2000);
    });
  });
})();
</script>
{% endif %}

