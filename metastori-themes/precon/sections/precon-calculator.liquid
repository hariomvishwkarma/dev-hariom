{%- assign b_colors = section.blocks | where: 'type', 'settings_colors' | first -%}
{%- assign b_gen = section.blocks | where: 'type', 'settings_general' | first -%}
{%- assign b_steps = section.blocks | where: 'type', 'settings_steps' | first -%}
{%- assign b_res = section.blocks | where: 'type', 'settings_results' | first -%}
{%- assign b_err = section.blocks | where: 'type', 'settings_errors' | first -%}

<style>
  @font-face {
    font-family: 'DM Sans';
    src: url('{{ "DMSans-Regular.woff2" | asset_url }}') format('woff2');
    font-weight: 400;
    font-style: normal;
    font-display: swap;
  }
  @font-face {
    font-family: 'DM Sans';
    src: url('{{ "DMSans-Medium.woff2" | asset_url }}') format('woff2');
    font-weight: 500;
    font-style: normal;
    font-display: swap;
  }
  @font-face {
    font-family: 'DM Sans';
    src: url('{{ "DMSans-SemiBold.woff2" | asset_url }}') format('woff2');
    font-weight: 600;
    font-style: normal;
    font-display: swap;
  }
  @font-face {
    font-family: 'DM Sans';
    src: url('{{ "DMSans-Bold.woff2" | asset_url }}') format('woff2');
    font-weight: 700;
    font-style: normal;
    font-display: swap;
  }

  @font-face {
    font-family: 'Playfair Display';
    src: url('{{ "PlayfairDisplay-Regular.woff2" | asset_url }}') format('woff2');
    font-weight: 400;
    font-style: normal;
    font-display: swap;
  }
  @font-face {
    font-family: 'Playfair Display';
    src: url('{{ "PlayfairDisplay-Bold.woff2" | asset_url }}') format('woff2');
    font-weight: 700;
    font-style: normal;
    font-display: swap;
  }

  #precon-calculator-{{ section.id }} {
    --brand-dark: {{ b_colors.settings.color_brand_dark | default: '#56473A' }};
    --brand-beige: {{ b_colors.settings.color_brand_beige | default: '#EFECE4' }};
    --accent: {{ b_colors.settings.color_accent | default: '#3DADBB' }};
    --accent-dark: {{ b_colors.settings.color_accent_dark | default: '#2e9aa8' }};
    --accent-light: {{ b_colors.settings.color_accent_light | default: '#e8f7f9' }};
    --white: {{ b_colors.settings.color_white | default: '#FFFFFF' }};
    --light-gray: {{ b_colors.settings.color_light_gray | default: '#F7F7F5' }};
    --mid-gray: {{ b_colors.settings.color_mid_gray | default: '#D8D3CE' }};
    --error: {{ b_colors.settings.color_error | default: '#C0392B' }};
    --success: {{ b_colors.settings.color_success | default: '#2D692D' }};
    --text: {{ b_colors.settings.color_text | default: '#56473A' }};
    --text-soft: {{ b_colors.settings.color_text_soft | default: '#8a7b70' }};
    --radius: {{ section.settings.border_radius }}px;

    max-width: {{ section.settings.width_mobile }}px;
    margin-top: {{ section.settings.margin_top_mobile }}px;
    margin-bottom: {{ section.settings.margin_bottom_mobile }}px;
    margin-left: auto;
    margin-right: auto;
  }

  @media (min-width: 768px) {
    #precon-calculator-{{ section.id }} {
      max-width: {{ section.settings.width_desktop }}px;
      margin-top: {{ section.settings.margin_top_desktop }}px;
      margin-bottom: {{ section.settings.margin_bottom_desktop }}px;
    }
  }
</style>

<div id="precon-calculator-{{ section.id }}" class="precon-calculator-section widget-wrapper">

  <div class="widget-header">
    <div class="widget-pretitle">{{ b_gen.settings.pretitle }}</div>
    <h1 class="widget-title">{{ b_gen.settings.title }}</h1>
    <p class="widget-subtitle">{{ b_gen.settings.subtitle }}</p>
  </div>

  <div class="progress-container">
    <div class="progress-steps">
      <div class="prog-step active" id="ps1">1</div><div class="prog-line" id="pl1"></div>
      <div class="prog-step" id="ps2">2</div><div class="prog-line" id="pl2"></div>
      <div class="prog-step" id="ps3">3</div><div class="prog-line" id="pl3"></div>
      <div class="prog-step" id="ps4">4</div><div class="prog-line" id="pl4"></div>
      <div class="prog-step" id="ps5">5</div><div class="prog-line" id="pl5"></div>
      <div class="prog-step" id="ps6">6</div><div class="prog-line" id="pl6"></div>
      <div class="prog-step" id="ps7">7</div>
    </div>
  </div>

  <div class="step-card visible" id="step1">
    <div class="step-question">{{ b_steps.settings.step1_question }}</div>
    <div class="step-hint">{{ b_steps.settings.step1_hint }}</div>
    <div class="gender-grid">
      <button class="gender-btn" id="btn-frau" onclick="selectGender('Frau')">
        <span class="gender-icon">♀</span>{{ b_steps.settings.gender_f }}
      </button>
      <button class="gender-btn" id="btn-mann" onclick="selectGender('Mann')">
        <span class="gender-icon">♂</span>{{ b_steps.settings.gender_m }}
      </button>
    </div>
    <div class="field-error" id="err-gender" style="margin-top:10px;">{{ b_err.settings.err_gender }}</div>
    <button class="btn-next" onclick="goStep2()">
      {{ b_gen.settings.btn_next }} <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
    </button>
  </div>

  <div class="step-card" id="step2">
    <div class="step-question">{{ b_steps.settings.step2_question }}</div>
    <div class="step-hint">{{ b_steps.settings.step2_hint }}</div>
    <div class="field-group">
      <label class="field-label">{{ b_steps.settings.label_age }}</label>
      <div class="input-wrap">
        <input type="number" id="age" placeholder="{{ b_steps.settings.placeholder_age }}" min="15" max="99" inputmode="numeric">
        <span class="input-unit">{{ b_steps.settings.unit_age }}</span>
      </div>
      <div class="field-error" id="err-age">{{ b_err.settings.err_age }}</div>
    </div>
    <div class="field-group">
      <label class="field-label">{{ b_steps.settings.label_height }}</label>
      <div class="input-wrap">
        <input type="number" id="height" placeholder="{{ b_steps.settings.placeholder_height }}" min="100" max="250" inputmode="numeric">
        <span class="input-unit">{{ b_steps.settings.unit_height }}</span>
      </div>
      <div class="field-error" id="err-height">{{ b_err.settings.err_height }}</div>
    </div>
    <button class="btn-next" onclick="goStep3()">
      {{ b_gen.settings.btn_next }} <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
    </button>
    <button class="btn-back" onclick="goStep(1, true)">{{ b_gen.settings.btn_back }}</button>
  </div>

  <div class="step-card" id="step3">
    <div class="step-question">{{ b_steps.settings.step3_question }}</div>
    <div class="step-hint">{{ b_steps.settings.step3_hint }}</div>
    <div class="field-group">
      <label class="field-label">{{ b_steps.settings.label_weight }}</label>
      <div class="input-wrap">
        <input type="number" id="weight" step="0.1" inputmode="decimal">
        <span class="input-unit">{{ b_steps.settings.unit_weight }}</span>
      </div>
      <div class="field-error" id="err-weight-low">{{ b_err.settings.err_weight_low }}</div>
      <div class="field-error" id="err-weight-high">{{ b_err.settings.err_weight_high }}</div>
    </div>
    <div class="field-group">
      <label class="field-label">{{ b_steps.settings.label_target }}</label>
      <div class="input-wrap">
        <input type="number" id="targetWeight" step="0.1" inputmode="decimal">
        <span class="input-unit">{{ b_steps.settings.unit_weight }}</span>
      </div>
      <div class="field-error" id="err-target">{{ b_err.settings.err_target }}</div>
      <div class="field-error" id="err-target-equal">{{ b_err.settings.err_target_eq }}</div>
      <div class="field-error" id="err-target-high">{{ b_err.settings.err_target_high }}</div>
      <div class="field-error" id="err-target-bmi"></div>
    </div>
    <button class="btn-next" onclick="goStep4()">
      {{ b_gen.settings.btn_next }} <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
    </button>
    <button class="btn-back" onclick="goStep(2, true)">{{ b_gen.settings.btn_back }}</button>
  </div>

  <div class="step-card" id="step4">
    <div class="step-question">{{ b_steps.settings.step4_question }}</div>
    <div class="step-hint">{{ b_steps.settings.step4_hint }}</div>
    <div class="choices" id="beruf-choices">
      <button class="choice-btn" onclick="selectBeruf(1.2, this)"><span class="choice-radio"></span>{{ b_steps.settings.job_1 }}</button>
      <button class="choice-btn" onclick="selectBeruf(1.3, this)"><span class="choice-radio"></span>{{ b_steps.settings.job_2 }}</button>
      <button class="choice-btn" onclick="selectBeruf(1.4, this)"><span class="choice-radio"></span>{{ b_steps.settings.job_3 }}</button>
    </div>
    <div class="field-error" id="err-beruf">{{ b_err.settings.err_beruf }}</div>
    <button class="btn-next" onclick="goStep5()">
      {{ b_gen.settings.btn_next }} <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
    </button>
    <button class="btn-back" onclick="goStep(3, true)">{{ b_gen.settings.btn_back }}</button>
  </div>

  <div class="step-card" id="step5">
    <div class="step-question">{{ b_steps.settings.step5_question }}</div>
    <div class="step-hint">{{ b_steps.settings.step5_hint }}</div>
    <div class="choices" id="sport-choices">
      <button class="choice-btn" onclick="selectSport(0.05, this)"><span class="choice-radio"></span>{{ b_steps.settings.sport_1 }}</button>
      <button class="choice-btn" onclick="selectSport(0.10, this)"><span class="choice-radio"></span>{{ b_steps.settings.sport_2 }}</button>
      <button class="choice-btn" onclick="selectSport(0.15, this)"><span class="choice-radio"></span>{{ b_steps.settings.sport_3 }}</button>
      <button class="choice-btn" onclick="selectSport(0.20, this)"><span class="choice-radio"></span>{{ b_steps.settings.sport_4 }}</button>
    </div>
    <div class="field-error" id="err-sport">{{ b_err.settings.err_sport }}</div>
    <button class="btn-next" onclick="goStep6()">
      {{ b_gen.settings.btn_next }} <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
    </button>
    <button class="btn-back" onclick="goStep(4, true)">{{ b_gen.settings.btn_back }}</button>
  </div>

  <div class="step-card" id="step6">
    <div class="step-question">{{ b_steps.settings.step6_question }}</div>
    <div class="step-hint">{{ b_steps.settings.step6_hint }}</div>
    <div class="field-group">
      <label class="field-label">{{ b_steps.settings.label_fn }}</label>
      <div class="input-wrap text-input-wrap">
        <input type="text" id="firstName" placeholder="{{ b_steps.settings.placeholder_fn }}" autocomplete="given-name">
      </div>
      <div class="field-error" id="err-firstName">{{ b_err.settings.err_fn }}</div>
    </div>
    <div class="field-group">
      <label class="field-label">{{ b_steps.settings.label_ln }}</label>
      <div class="input-wrap text-input-wrap">
        <input type="text" id="lastName" placeholder="{{ b_steps.settings.placeholder_ln }}" autocomplete="family-name">
      </div>
      <div class="field-error" id="err-lastName">{{ b_err.settings.err_ln }}</div>
    </div>
    <button class="btn-next" onclick="goStep7()">
      {{ b_gen.settings.btn_next }} <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
    </button>
    <button class="btn-back" onclick="goStep(5, true)">{{ b_gen.settings.btn_back }}</button>
  </div>

  <div class="step-card" id="step7">
    <div class="step-question">{{ b_steps.settings.step7_question }}</div>
    <div class="step-hint">{{ b_steps.settings.step7_hint }}</div>
    <div class="field-group">
      <label class="field-label">{{ b_steps.settings.label_email }}</label>
      <div class="input-wrap text-input-wrap">
        <input type="email" id="email" placeholder="{{ b_steps.settings.placeholder_email }}" autocomplete="email" inputmode="email">
      </div>
      <div class="field-error" id="err-email">{{ b_err.settings.err_email }}</div>
    </div>
    <div class="consent-row" id="consentRow" onclick="toggleConsent()">
      <div class="consent-box-el"><span class="consent-check">✓</span></div>
      <div class="consent-text">{{ b_steps.settings.consent_text }}</div>
    </div>
    <div class="field-error" id="err-consent" style="margin-top: 8px;">{{ b_err.settings.err_consent }}</div>
    <button class="btn-next" onclick="calculate()">{{ b_steps.settings.btn_calc }}</button>
    <button class="btn-back" onclick="goStep(6, true)">{{ b_gen.settings.btn_back }}</button>
  </div>

  <div class="step-card" id="stepLoading">
    <div class="loading-spinner-wrap">
      <div class="loading-bar-track"><div class="loading-bar-fill" id="loadingBarFill"></div></div>
    </div>
    <div class="loading-title">{{ b_gen.settings.loading_title }}</div>
    <div class="loading-sub">{{ b_gen.settings.loading_sub }}</div>
    <div class="loading-review" id="loadingReview">
      <div class="loading-review-stars">{{ b_gen.settings.review_stars }}</div>
      <div class="loading-review-quote">{{ b_gen.settings.review_quote }}</div>
      <div class="loading-review-author">{{ b_gen.settings.review_author }}</div>
    </div>
  </div>

  <div class="step-card" id="stepResult">
    <div class="results-greeting" id="resGreeting"></div>
    <div class="results-intro">{{ b_res.settings.res_intro }}</div>
    <div class="bmi-row">
      <div class="result-block">
        <div class="res-label">{{ b_res.settings.lbl_bmi_c }}</div>
        <div class="res-value" id="resBmiCurrent">–</div>
        <div class="res-sub" id="resBmiCurrentCat">–</div>
      </div>
      <div class="result-block">
        <div class="res-label">{{ b_res.settings.lbl_bmi_t }}</div>
        <div class="res-value" id="resBmiTarget">–</div>
      </div>
    </div>

    <div class="bmi-gauge-wrap">
      <div class="bmi-gauge-bar">
        <div class="bmi-seg" style="background:#e8294c; flex:3.5"></div>
        <div class="bmi-seg" style="background:#7cc400; flex:6.5"></div>
        <div class="bmi-seg" style="background:#f5a623; flex:5"></div>
        <div class="bmi-seg" style="background:#e8692c; flex:5"></div>
        <div class="bmi-seg" style="background:#e84e2c; flex:5"></div>
        <div class="bmi-seg" style="background:#c0392b; flex:2"></div>
      </div>
      <div class="bmi-gauge-ticks">
        <span style="left:13.0%">18,5</span><span style="left:37.0%">25</span><span style="left:55.6%">30</span><span style="left:74.1%">35</span><span style="left:92.6%">40</span>
      </div>
      <div class="bmi-needle-wrap" id="bmiNeedle" style="left:50%">
        <div class="bmi-needle-dot"></div><div class="bmi-needle-line"></div>
      </div>
      <div class="bmi-labels-wrap">
        <div class="bmi-label-item level-1" style="left:6.5%"><div class="bmi-label-connector"></div><div class="bmi-label-text">{{ b_res.settings.cat_1 }}</div></div>
        <div class="bmi-label-item level-2" style="left:25.0%"><div class="bmi-label-connector"></div><div class="bmi-label-text">{{ b_res.settings.cat_2 }}</div></div>
        <div class="bmi-label-item level-1" style="left:46.3%"><div class="bmi-label-connector"></div><div class="bmi-label-text">{{ b_res.settings.cat_3 }}</div></div>
        <div class="bmi-label-item level-2" style="left:64.8%"><div class="bmi-label-connector"></div><div class="bmi-label-text">{{ b_res.settings.cat_4 }}</div></div>
        <div class="bmi-label-item level-1" style="left:83.3%"><div class="bmi-label-connector"></div><div class="bmi-label-text">{{ b_res.settings.cat_5 }}</div></div>
        <div class="bmi-label-item level-2" style="left:96.3%"><div class="bmi-label-connector"></div><div class="bmi-label-text">{{ b_res.settings.cat_6 }}</div></div>
      </div>
    </div>

    <div class="secondary-row">
      <div class="result-block">
        <div class="res-label">{{ b_res.settings.lbl_bmr }}</div>
        <div class="res-value" id="resBmr">–<span class="res-unit">kcal</span></div>
        <div class="res-sub">{{ b_res.settings.sub_bmr }}</div>
      </div>
      <div class="result-block">
        <div class="res-label">{{ b_res.settings.lbl_act }}</div>
        <div class="res-value" id="resLeistung">–<span class="res-unit">kcal</span></div>
        <div class="res-sub">{{ b_res.settings.sub_act }}</div>
      </div>
    </div>

    <div class="result-block accent-block">
      <div class="res-label">{{ b_res.settings.lbl_total }}</div>
      <div class="res-value" id="resTotal">–<span class="res-unit">kcal/Tag</span></div>
      <div class="res-sub">{{ b_res.settings.sub_total }}</div>
    </div>

    <div class="meal-plan-block">
      <div class="meal-plan-label">{{ b_res.settings.meal_title }}</div>
      <div class="meal-plan-grid">
        <div class="meal-tile meal-tile--precon">
          <div class="meal-tile-name">{{ b_res.settings.meal_1 }}</div>
          <span class="meal-tile-approx">ca.</span>
          <div class="meal-tile-value">220</div>
          <div class="meal-tile-unit">kcal</div>
        </div>
        <div class="meal-tile meal-tile--precon">
          <div class="meal-tile-name">{{ b_res.settings.meal_2 }}</div>
          <span class="meal-tile-approx">ca.</span>
          <div class="meal-tile-value">220</div>
          <div class="meal-tile-unit">kcal</div>
        </div>
        <div class="meal-tile meal-tile--cook">
          <div class="meal-tile-name">{{ b_res.settings.meal_cook }}</div>
          <span class="meal-tile-approx">&nbsp;</span>
          <div class="meal-tile-value" id="resPrecon">–</div>
          <div class="meal-tile-unit">kcal</div>
        </div>
      </div>
      <div class="meal-plan-total">
        <span class="meal-plan-total-label">{{ b_res.settings.meal_sum_lbl }}</span>
        <span class="meal-plan-total-value" id="resTotalMeal">–</span>
        <span class="meal-plan-total-unit">kcal</span>
        <span class="meal-plan-total-badge">{{ b_res.settings.meal_badge }}</span>
      </div>
      <p class="meal-plan-text">{{ b_res.settings.meal_desc }}</p>
    </div>

    <button class="btn-next" onclick="showAbnehmplan()" style="margin-top: 24px;">{{ b_res.settings.btn_view_plan }}</button>
  </div>

  <div class="step-card" id="stepAbnehmplan">
    <div class="results-greeting">{{ b_res.settings.plan_heading }}</div>
    <div class="plan-intro" id="planIntro"></div>
    <div class="plan-section-title">{{ b_res.settings.plan_chart_title }}</div>
    <div class="chart-wrap"><canvas id="weightChart"></canvas></div>

    <div class="result-block accent-block" id="planHighlight" style="margin-top: 16px;">
      <div class="res-label" id="planHighlightLabel"></div>
      <div class="res-value" id="planHighlightValue">–<span class="res-unit">kg</span></div>
      <div class="res-sub" id="planHighlightSub">–</div>
    </div>

    <p class="plan-trust-text">{{ b_res.settings.plan_trust }}</p>
    <button class="btn-back" onclick="showPage('stepResult')" style="margin-top: 16px;">{{ b_gen.settings.btn_back }}</button>
    <button class="btn-next" onclick="showPage('stepPhasen')" style="margin-top: 12px;">{{ b_res.settings.btn_view_phases }}</button>
  </div>

  <div class="step-card" id="stepPhasen">
    <div class="results-greeting">{{ b_res.settings.phase_heading }}</div>
    
    <div class="phase-section" style="margin-top: 24px;">
      <div class="phase-heading">
        <span class="phase-badge phase-badge--start">{{ b_res.settings.phase_1_title }}</span>
        <span class="phase-duration">{{ b_res.settings.phase_1_dur }}</span>
      </div>
      <div class="plan-intro plain">{{ b_res.settings.phase_1_txt }}</div>
      <div class="info-box"><div class="info-box-icon">i</div><div class="info-box-text">{{ b_res.settings.phase_1_info }}</div></div>
    </div>

    <div class="phase-section" style="margin-top: 0px;">
      <div class="phase-heading">
        <span class="phase-badge phase-badge--abnehm">{{ b_res.settings.phase_2_title }}</span>
        <span class="phase-duration" id="phaseAbnehmDuration">–</span>
      </div>
      <div class="plan-intro plain">{{ b_res.settings.phase_2_txt }}</div>
    </div>

    <div class="phase-section" id="phaseHalteSection" style="margin-top: 8px; display: none;">
      <div class="phase-heading">
        <span class="phase-badge phase-badge--halte">{{ b_res.settings.phase_3_title }}</span>
        <span class="phase-duration">{{ b_res.settings.phase_3_dur }}</span>
      </div>
      <div class="plan-intro plain">{{ b_res.settings.phase_3_txt }}</div>
    </div>

    <button class="btn-back" onclick="showPage('stepAbnehmplan')" style="margin-top: 20px;">{{ b_gen.settings.btn_back }}</button>
    <button class="btn-next" onclick="downloadPDF()" style="margin-top: 12px;">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
      {{ b_res.settings.btn_pdf }}
    </button>
    <button class="btn-next btn-next--outline" onclick="window.open('{{ b_res.settings.link_url }}', '_blank')" style="margin-top: 10px;">
      {{ b_res.settings.link_txt }} →
    </button>
  </div>

  <div class="footer-note" id="footerNote" style="display:none;">{{ b_gen.settings.footer_note }}</div>

</div>

<script type="application/json" id="PreconCalculatorSettings">
  {
    "api": {
      "renderUrl": "{% if section.settings.auth_code != blank %}{{ section.settings.render_url | escape }}{% endif %}"
    },
    "colors": {
