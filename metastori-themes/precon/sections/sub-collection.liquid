<div class="collection-list" style="background-color: {{ section.settings.collection_bg_color }}">

<div class="container">
  
        <div class="collection-item" >
          
            {% if collection.metafields.custom.add_collection_name != blank %}
                <div class="custom-collections">
                    {% for coll in collection.metafields.custom.add_collection_name.value %}
                    <div class="custom-collection-item">
                        <a href="{{ coll.url }}" style="color: {{ section.settings.collection_color }}">
                        {% if collection.metafields.custom.sub_collection_image %}
                            <img src="{{ coll.metafields.custom.sub_collection_image | img_url: '400x' }}" alt="{{ coll.title }}" loading="lazy">
                        {% else %}
                          <img src="/cdn/shop/files/shackbottel_400x.svg" alt="{{ coll.title }}" loading="lazy">
                        {% endif %}
                        {{ coll.title }}
                        </a>
                    </div>
                    {% endfor %}
                </div>
            {% endif %}

       {% comment %}    <h2 class="heading" style="color: {{ section.settings.title_color }}">
            {% if collection.metafields.custom.category_title != blank %}
              {{ collection.metafields.custom.category_title }}
            {% else %} 
              {{ collection.title }}
             {% endif %} 
          </h2>

          {% if collection.metafields.custom.category_sub_title != blank %}
            <p class="subtitle" style="color: {{ section.settings.subtitle_color }}">
              {{ collection.metafields.custom.category_sub_title }}
            </p>
          {% endif %}{% endcomment %}

        </div>
    </div>

</div>


{% schema %}
{
  "name": "Sub Collection",
  "settings": [
    {
      "type": "color",
      "id": "collection_color",
      "label": "Collection color",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "title_color",
      "label": "Category title color",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "subtitle_color",
      "label": "Category subtitle color",
      "default": "#666666"
    },
    {
      "type": "color",
      "id": "collection_bg_color",
      "label": "Collection background color",
      "default": "#ffffff"
    }
  ],
  "presets": [
    {
      "name": "Sub Collection"
    }
  ]
}
{% endschema %}
