<div class="sec-product-info">
  <div class="container">
    <h1 class="sec-product-info-title">
      {{ page.title }}
    </h1>

    <div class="sec-product-info-selector">
      <label>{{ section.settings.select_label }}:</label>
      <select>
        {% comment %}
        <option value="">{{ section.settings.select_label }}</option>
        {% endcomment %}
        {% for product in collections["all-items"].products limit: 1000 %}
          <option value="{{ product.id }}" {% if forloop.first %} selected {% endif %}>{{ product.title }}</option>
        {% endfor %}
      </select>
    </div>
    <div class="sec-product-info-data-wrapper">
      {% for product in collections["all-items"].products limit: 1000 %}
        <div data-id="{{ product.id }}" class="sec-product-info-data {% if forloop.first %} active {% endif %}">
          {% if product.metafields.custom.tab_ingredients.value != blank %}
            <div class="sec-product-info-meta">
              <h3 class="sec-product-info-meta-title">{{ section.settings.meta_title_1 }}</h3>
              <div class="sec-product-info-meta-content">
                {{ product.metafields.custom.tab_ingredients | metafield_tag }}
              </div>
            </div>
          {% endif %}

          {% if product.metafields.custom.zutaten_table.value != blank %}
            <div class="sec-product-info-meta">
              <h3 class="sec-product-info-meta-title">{{ section.settings.meta_title_2 }}</h3>
              <div class="sec-product-info-meta-content">
                {{ product.metafields.custom.zutaten_table }}
              </div>
            </div>
          {% endif %}

          {% if product.metafields.custom.tab_allergie.value != blank %}
            <div class="sec-product-info-meta">
              <h3 class="sec-product-info-meta-title">{{ section.settings.meta_title_3 }}</h3>
              <div class="sec-product-info-meta-content">
                {{ product.metafields.custom.tab_allergie | metafield_tag }}
              </div>
            </div>
          {% endif %}
        </div>
      {% endfor %}
    </div>
  </div>
</div>
<script>
    document.addEventListener('DOMContentLoaded', function() {
  const select = document.querySelector('.sec-product-info-selector select');
  const productDataElements = document.querySelectorAll('.sec-product-info-data');
  
  if (select) {
    select.addEventListener('change', function() {
      const selectedProductId = this.value;
      
      productDataElements.forEach(element => {
        element.classList.remove('active');
      });
      
      if (selectedProductId) {
        const targetElement = document.querySelector(`.sec-product-info-data[data-id="${selectedProductId}"]`);
        if (targetElement) {
          targetElement.classList.add('active');
        }
      }
    });
  }
});
</script>
{% schema %}
{
  "name": "Product information",
  "settings": [
    {
      "type": "text",
      "label": "Select label",
      "id": "select_label",
      "default": "Wähle dein Produkt aus"
    },
    {
      "type": "text",
      "label": "Metafield title 1",
      "id": "meta_title_1",
      "default": "Zutatenliste"
    },
    {
      "type": "text",
      "label": "Metafield title 2",
      "id": "meta_title_2",
      "default": "Nährwerttabelle"
    },
    {
      "type": "text",
      "label": "Metafield title 3",
      "id": "meta_title_3",
      "default": "Allergieinformationen"
    }
  ],
  "presets": [
    {
      "name": "Product information"
    }
  ]
}
{% endschema %}
