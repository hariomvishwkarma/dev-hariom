{% style %}
.sub-collection-m-main{
    display:none;
}
.sc-image {
    width: 58px;
    height: 58px;
    background: #EFECE4;
    border-radius: 360px;
    overflow: hidden;
}
.sub-collection-item {
    display: flex;
    flex-direction: column;
    gap: 8px;
    justify-content: center;
    text-align: center;
    width: 58px;
    align-items: center;
}
.sc-text {
    font-size: 11.6px;
    color: #212121;
    line-height: 150%;
    font-weight: 400;
}
.sub-collection-list {
    overflow: auto;
    white-space: nowrap;
    scroll-behavior: unset;
    -ms-overflow-style: none;
    scrollbar-width: none;
    display: flex;
    gap: 24px;
}
.sub-collection-wrapper {
    padding: 24px 0px 24px 24px;
}
.sub-collection-item:last-child{
    margin-right: 24px;
}
  @media (min-width:768px){
    .sub-hide-desktop{
        display:none;
    }
  }
  @media (max-width:767px){
    .sub-hide-mobile{
        display:none;
    }
  }
{% endstyle %}

<div class="sub-collection-main">
    <div class="sub-collection-wrapper {% if section.settings.hide_desktop %}sub-hide-desktop{% endif %} {% if section.settings.hide_mobile %}sub-hide-mobile{% endif %}">
        <div class="sub-collection-list">
            {% for block in section.blocks %}
                {% if block.settings.link != blank %}
                    <a class="sub-collection-item" href="{{ block.settings.link }}">
                {% else %}
                    <div class="sub-collection-item">
                {% endif %}
                        <div class="sc-image">
                            <img src="{{ block.settings.image | image_url:width:100 }}" alt="title-{{ block.settings.text }}" width="auto" height="auto">
                        </div>
                        <span class="sc-text">{{ block.settings.text }}</span>
                {% if block.settings.link != blank %}
                    </a>
                {% else %}
                    </div>
                {% endif %}
            {% endfor %}
        </div>
    </div>
</div>


{% schema %}
{
  "name": "Sub Collections",
  "class": "sub-collection-m-main",
  "settings": [
    {
        "type": "checkbox",
        "id": "hide_desktop",
        "label": "Hide in Desktop",
        "default": true
    },
    {
        "type": "checkbox",
        "id": "hide_mobile",
        "label": "Hide in Mobile",
        "default": false
    }
  ],
  "blocks": [
    {
      "type": "collection_block",
      "name": "Collection",
      "settings": [
        {
            "type": "image_picker",
            "id":"image",
            "label": "Image"
        },
        {
            "type": "text",
            "id":"text",
            "label": "Text"
        },
        {
            "type": "url",
            "id":"link",
            "label": "Link"
        }
      ]
    }
  ],
  "max_blocks": 10,
  "presets": [
    {
      "name": "Sub Collections",
      "category": "Custom"
    }
  ]
}
{% endschema %}