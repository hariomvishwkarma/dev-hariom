{% comment %}
  Section: Relaunch CTA
{% endcomment %}

<section class="relaunch-cta" style="background-color: {{ section.settings.bg_color }}; padding: {{ section.settings.padding_top }}px 20px {{ section.settings.padding_bottom }}px;">
  <div class="relaunch-cta__container">
    <h2 class="relaunch-cta__heading" style="color: {{ section.settings.heading_color }};">
      {{ section.settings.heading }}
      {% if section.settings.heading_italic != blank %}
        <em style="color: {{ section.settings.accent_color }};">{{ section.settings.heading_italic }}</em>
      {% endif %}
    </h2>

    {% if section.settings.text != blank %}
      <p class="relaunch-cta__text" style="color: {{ section.settings.text_color }};">{{ section.settings.text }}</p>
    {% endif %}

    {% if section.settings.button_text != blank %}
      <a href="{{ section.settings.button_url }}" class="relaunch-cta__button" style="
        color: {{ section.settings.button_text_color }};
        border-color: {{ section.settings.button_border_color }};
        background-color: {{ section.settings.button_bg }};
        border-radius: {{ section.settings.button_radius }}px;
      ">{{ section.settings.button_text }}</a>
    {% endif %}
  </div>
</section>

<style>
  .relaunch-cta__container {
    max-width: 800px;
    margin: 0 auto;
    text-align: center;
  }

  .relaunch-cta__heading {
    font-size: clamp(28px, 4vw, 40px);
    font-weight: 400;
    line-height: 1.3;
    margin: 0 0 16px;
  }

  .relaunch-cta__heading em {
    display: block;
    font-family: Georgia, 'Times New Roman', serif;
    font-style: italic;
  }

  .relaunch-cta__text {
    font-size: 15px;
    line-height: 1.7;
    margin: 0 0 28px;
  }

  .relaunch-cta__button {
    display: inline-block;
    border: 1px solid;
    padding: 14px 32px;
    font-size: 15px;
    font-weight: 500;
    text-decoration: none;
    transition: opacity 0.2s ease;
  }

  .relaunch-cta__button:hover {
    opacity: 0.8;
  }
</style>

{% schema %}
{
  "name": "Relaunch CTA",
  "settings": [
    {
      "type": "header",
      "content": "Section layout"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#6b4c3b"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 120,
      "step": 4,
      "default": 72,
      "unit": "px",
      "label": "Top padding"
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "default": 72,
      "unit": "px",
      "label": "Bottom padding"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent Color",
      "default": "#5a9e9e"
    },
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Precon war immer für Dich da –"
    },
    {
      "type": "text",
      "id": "heading_italic",
      "label": "Heading italic line",
      "default": "das bleibt so."
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading Color",
      "default": "#ffffff"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Text",
      "default": "Danke für Dein Vertrauen in all den Jahren. Danke für Dein Feedback, das uns besser macht. Und danke, dass Du Teil der Precon-Familie bist."
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#d4ccc4"
    },
    {
      "type": "header",
      "content": "Button"
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button Text",
      "default": "Fragen? Kontakt aufnehmen"
    },
    {
      "type": "url",
      "id": "button_url",
      "label": "Button URL"
    },
    {
      "type": "color",
      "id": "button_text_color",
      "label": "Button Text Color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "button_border_color",
      "label": "Button Border Color",
      "default": "#a08a7a"
    },
    {
      "type": "color",
      "id": "button_bg",
      "label": "Button Background",
      "default": "transparent"
    },
    {
      "type": "range",
      "id": "button_radius",
      "min": 0,
      "max": 40,
      "step": 2,
      "default": 30,
      "unit": "px",
      "label": "Button Corner Radius"
    }
  ],
  "presets": [
    {
      "name": "Relaunch CTA"
    }
  ]
}
{% endschema %}