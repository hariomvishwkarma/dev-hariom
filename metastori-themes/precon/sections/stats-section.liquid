<style>
  .stats-sec {
    padding: 40px 20px 48px;
    text-align: center;
    font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
    background-color: {{ section.settings.bg_color }};
    color: {{ section.settings.text_color }};
  }
  .stats-sec__badge {
    display: inline-block;
    background-color: {{ section.settings.badge_bg }};
    color: {{ section.settings.badge_text_color }};
    padding: 6px 20px;
    border-radius: 30px;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 1.2px;
    text-transform: uppercase;
    margin-bottom: 16px;
  }
  .stats-sec__heading {
    font-size: clamp(28px, 4.5vw, 44px);
    font-weight: 400;
    line-height: 1.2;
    margin: 0 auto 32px;
    max-width: 700px;
  }
  .stats-sec__heading em {
    font-style: italic;
    font-family: Georgia, 'Times New Roman', serif;
    color: {{ section.settings.accent_color }};
  }
  .stats-sec__grid {
    display: flex;
    justify-content: center;
    gap: 20px;
    max-width: 960px;
    margin: 0 auto;
  }
  .stats-sec__card {
    flex: 1;
    max-width: 300px;
    background: #fff;
    border-radius: 14px;
    padding: 32px 24px;
    box-shadow: 0 1px 8px rgba(0,0,0,0.04);
  }
  .stats-sec__number {
    font-size: clamp(32px, 4vw, 48px);
    font-weight: 700;
    color: {{ section.settings.accent_color }};
    margin-bottom: 8px;
    line-height: 1.1;
  }
  .stats-sec__label {
    font-size: 14px;
    opacity: 0.7;
    line-height: 1.4;
  }

  @media (max-width: 600px) {
    .stats-sec {
      padding: 20px 14px 24px;
    }
    .stats-sec__badge {
      font-size: 10px;
      padding: 4px 14px;
      margin-bottom: 10px;
    }
    .stats-sec__heading {
      font-size: 22px;
      margin-bottom: 18px;
    }
    .stats-sec__grid {
      flex-direction: column;
      align-items: center;
      gap: 10px;
    }
    .stats-sec__card {
      width: 100%;
      max-width: 100%;
      padding: 18px 16px;
      border-radius: 10px;
      display: flex;
      align-items: center;
      gap: 14px;
    }
    .stats-sec__number {
      font-size: 26px;
      margin-bottom: 0;
      white-space: nowrap;
    }
    .stats-sec__label {
      font-size: 13px;
      text-align: left;
    }
  }
</style>

<div class="stats-sec">
  {% if section.settings.badge_text != blank %}
    <span class="stats-sec__badge">{{ section.settings.badge_text }}</span>
  {% endif %}

  <h2 class="stats-sec__heading">{{ section.settings.heading }}</h2>

  <div class="stats-sec__grid">
    {% for block in section.blocks %}
      <div class="stats-sec__card" {{ block.shopify_attributes }}>
        <div class="stats-sec__number">{{ block.settings.number }}</div>
        <div class="stats-sec__label">{{ block.settings.label }}</div>
      </div>
    {% endfor %}
  </div>
</div>

{% schema %}
{
  "name": "Stats Section",
  "settings": [
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#f0ece4"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#3a3631"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent Color (numbers)",
      "default": "#2fb5a0"
    },
    {
      "type": "color",
      "id": "badge_bg",
      "label": "Badge Background",
      "default": "#d6cfc4"
    },
    {
      "type": "color",
      "id": "badge_text_color",
      "label": "Badge Text Color",
      "default": "#5a5347"
    },
    {
      "type": "text",
      "id": "badge_text",
      "label": "Badge Text",
      "default": "Warum über 100.000 Frauen Precon wählen"
    },
    {
      "type": "html",
      "id": "heading",
      "label": "Heading (use <em> for accent)",
      "default": "Bewährt. <em>Einfach.</em> Wirksam."
    }
  ],
  "blocks": [
    {
      "type": "stat",
      "name": "Stat",
      "settings": [
        {
          "type": "text",
          "id": "number",
          "label": "Number",
          "default": "42%"
        },
        {
          "type": "text",
          "id": "label",
          "label": "Label",
          "default": "Beschreibung"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Stats Section",
      "blocks": [
        { "type": "stat", "settings": { "number": "42%", "label": "Preisvorteil gegenüber Einzelkauf" } },
        { "type": "stat", "settings": { "number": "< 235", "label": "kcal pro Mahlzeit" } },
        { "type": "stat", "settings": { "number": "39+", "label": "Jahre Erfahrung" } }
      ]
    }
  ]
}
{% endschema %}