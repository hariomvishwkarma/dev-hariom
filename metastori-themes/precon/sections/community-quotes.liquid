<style>
  .comm-quotes {
    padding: 48px 20px;
    font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
    background-color: {{ section.settings.bg_color }};
    color: {{ section.settings.text_color }};
  }
  .comm-quotes__inner {
    max-width: 960px;
    margin: 0 auto;
  }
  .comm-quotes__label {
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 2px;
    text-transform: uppercase;
    color: {{ section.settings.accent_color }};
    margin-bottom: 8px;
  }
  .comm-quotes__heading {
    font-size: clamp(28px, 4.5vw, 42px);
    font-weight: 400;
    font-family: Georgia, 'Times New Roman', serif;
    line-height: 1.15;
    margin: 0 0 32px;
  }

  /* ── Grid ── */
  .comm-quotes__grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 16px;
  }

  /* ── Card ── */
  .comm-quotes__card {
    background: {{ section.settings.card_bg }};
    border: 1px solid {{ section.settings.card_border }};
    border-radius: 14px;
    padding: 28px 26px 24px;
    display: flex;
    flex-direction: column;
  }
  .comm-quotes__quote {
    font-size: 17px;
    font-style: italic;
    font-family: Georgia, 'Times New Roman', serif;
    line-height: 1.55;
    margin: 0 0 20px;
    flex: 1;
  }
  .comm-quotes__quote::before {
    content: '"';
    font-size: 28px;
    font-weight: 700;
    color: {{ section.settings.accent_color }};
    line-height: 0;
    position: relative;
    top: 6px;
    margin-right: 2px;
  }

  /* ── Author ── */
  .comm-quotes__author {
    display: flex;
    align-items: center;
    gap: 12px;
  }
  .comm-quotes__avatar {
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background: linear-gradient(135deg, #e8a020 0%, {{ section.settings.accent_color }} 100%);
    color: #fff;
    font-size: 16px;
    font-weight: 700;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }
  .comm-quotes__info {
    flex: 1;
    min-width: 0;
  }
  .comm-quotes__name {
    font-size: 15px;
    font-weight: 700;
    margin: 0;
  }
  .comm-quotes__meta {
    font-size: 12px;
    opacity: 0.55;
  }
  .comm-quotes__stars {
    color: #d4a017;
    font-size: 13px;
    letter-spacing: 2px;
    margin-top: 4px;
  }

  @media (max-width: 768px) {
    .comm-quotes {
      padding: 24px 14px;
    }
    .comm-quotes__heading {
      font-size: 24px;
      margin-bottom: 20px;
    }
    .comm-quotes__grid {
      grid-template-columns: 1fr;
      gap: 10px;
    }
    .comm-quotes__card {
      padding: 20px 18px 18px;
    }
    .comm-quotes__quote {
      font-size: 15px;
      margin-bottom: 14px;
    }
    .comm-quotes__avatar {
      width: 34px;
      height: 34px;
      font-size: 14px;
    }
    .comm-quotes__name {
      font-size: 14px;
    }
    .comm-quotes__meta {
      font-size: 11px;
    }
    .comm-quotes__stars {
      font-size: 12px;
    }
  }
</style>

<div class="comm-quotes">
  <div class="comm-quotes__inner">
    {% if section.settings.top_label != blank %}
      <div class="comm-quotes__label">{{ section.settings.top_label }}</div>
    {% endif %}

    <h2 class="comm-quotes__heading">{{ section.settings.heading }}</h2>

    <div class="comm-quotes__grid">
      {% for block in section.blocks %}
        <div class="comm-quotes__card" {{ block.shopify_attributes }}>
          <p class="comm-quotes__quote">{{ block.settings.quote }}"</p>
          <div>
            <div class="comm-quotes__author">
              <span class="comm-quotes__avatar">{{ block.settings.name | slice: 0 }}</span>
              <div class="comm-quotes__info">
                <div class="comm-quotes__name">{{ block.settings.name }}</div>
                <div class="comm-quotes__meta">{{ block.settings.age }} Jahre · {{ section.settings.verified_text }}</div>
              </div>
            </div>
            <div class="comm-quotes__stars">
              {% assign star_count = block.settings.stars | default: 5 %}
              {% for i in (1..star_count) %}★{% endfor %}
            </div>
          </div>
        </div>
      {% endfor %}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Community Quotes",
  "settings": [
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#faf8f4"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#3a3631"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent Color",
      "default": "#2fb5a0"
    },
    {
      "type": "color",
      "id": "card_bg",
      "label": "Card Background",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "card_border",
      "label": "Card Border",
      "default": "#e4dfd6"
    },
    {
      "type": "text",
      "id": "top_label",
      "label": "Top Label",
      "default": "Stimmen aus der Community"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Was Precon-Kundinnen erleben"
    },
    {
      "type": "text",
      "id": "verified_text",
      "label": "Verified Text",
      "default": "Verifizierter Kauf"
    }
  ],
  "blocks": [
    {
      "type": "quote",
      "name": "Quote",
      "settings": [
        {
          "type": "textarea",
          "id": "quote",
          "label": "Quote (without quotes)",
          "default": "Hier steht das Zitat."
        },
        {
          "type": "text",
          "id": "name",
          "label": "Name",
          "default": "Maria"
        },
        {
          "type": "text",
          "id": "age",
          "label": "Age",
          "default": "55"
        },
        {
          "type": "range",
          "id": "stars",
          "label": "Stars",
          "min": 1,
          "max": 5,
          "step": 1,
          "default": 5
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Community Quotes",
      "blocks": [
        { "type": "quote", "settings": { "quote": "Für mich war es das absolute Erfolgserlebnis. Ich kann Precon jedem nur empfehlen, der nach Jahren des Probierens endlich etwas sucht das funktioniert.", "name": "Anja", "age": "58", "stars": 5 } },
        { "type": "quote", "settings": { "quote": "Ich fühle mich gesättigt, ohne müde zu sein oder die typischen Heißhungerattacken zu haben. Das war bei jeder Diät vorher mein Problem.", "name": "Julia", "age": "61", "stars": 5 } },
        { "type": "quote", "settings": { "quote": "Du bist sofort satt, fit und kannst voller Energie in den Tag starten. Das ist genau was ich nach den Wechseljahren wieder brauchte.", "name": "Nina", "age": "56", "stars": 5 } },
        { "type": "quote", "settings": { "quote": "Ich bin richtig happy mit Precon. Es fühlt sich machbar an im Alltag und ich habe danach ein gutes Gefühl statt schlechtem Gewissen.", "name": "Mandy", "age": "59", "stars": 5 } }
      ]
    }
  ]
}
{% endschema %}