<nav class="blog-tabs" id="blog-tabs-{{ section.id }}" style="background:{{ section.settings.nav_bg }};border-bottom:1px solid {{ section.settings.nav_border }};" aria-label="Blog Navigation">
  <div class="blog-tabs__inner page-width">
    {%- for block in section.blocks -%}
      {%- if block.type == 'blog_tab' -%}
        {%- assign is_active = false -%}
        {%- if block.settings.blog_handle == blog.handle -%}
          {%- assign is_active = true -%}
        {%- endif -%}
        <a
          href="/blogs/{{ block.settings.blog_handle }}"
          class="blog-tabs__tab{% if is_active %} is-active{% endif %}"
          style="
            --tab-active-color: {{ block.settings.active_color }};
            --tab-active-bg: {{ block.settings.active_bg }};
            color: {% if is_active %}{{ block.settings.active_color }}{% else %}{{ section.settings.tab_text_color }}{% endif %};
          "
          {% if is_active %}aria-current="page"{% endif %}
          {{ block.shopify_attributes }}
        >
          {%- if block.settings.emoji != blank -%}
            <span class="blog-tabs__emoji" aria-hidden="true">{{ block.settings.emoji }}</span>
          {%- endif -%}
          {{ block.settings.label }}
          {%- if is_active -%}
            <span class="blog-tabs__tab-indicator" style="background:{{ block.settings.active_color }};"></span>
          {%- endif -%}
        </a>
      {%- endif -%}
    {%- endfor -%}
  </div>
</nav>

<style>
  .blog-tabs {
    position: sticky;
    top: 0;
    z-index: 100;
    width: 100%;
  }
  .blog-tabs__inner {
    display: flex;
    align-items: center;
    gap: 0;
    padding-left: max(24px, 5rem);
    padding-right: max(24px, 5rem);
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
  }
  .blog-tabs__inner::-webkit-scrollbar {
    display: none;
  }
  .blog-tabs__tab {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    padding: 16px 20px;
    font-size: 14px;
    font-weight: 500;
    text-decoration: none;
    white-space: nowrap;
    position: relative;
    transition: color 0.2s ease;
    border-bottom: 2px solid transparent;
    flex-shrink: 0;
  }
  .blog-tabs__tab:hover {
    color: var(--tab-active-color) !important;
  }
  .blog-tabs__tab.is-active {
    border-bottom-color: var(--tab-active-color);
    font-weight: 600;
  }
  .blog-tabs__emoji {
    font-size: 16px;
    line-height: 1;
  }
  .blog-tabs__tab-indicator {
    display: none;
  }
  @media (max-width: 768px) {
    .blog-tabs__tab {
      padding: 14px 14px;
      font-size: 13px;
    }
  }
</style>

{% schema %}
{
  "name": "Blog Tab-Navigation",
  "tag": "section",
  "class": "section-blog-tab-nav",
  "settings": [
    {
      "type": "color",
      "id": "nav_bg",
      "label": "Navigationsleiste Hintergrund",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "nav_border",
      "label": "Trennlinie Farbe",
      "default": "#e0dfd8"
    },
    {
      "type": "color",
      "id": "tab_text_color",
      "label": "Tab Textfarbe (inaktiv)",
      "default": "#666666"
    }
  ],
  "blocks": [
    {
      "type": "blog_tab",
      "name": "Blog Tab",
      "settings": [
        {
          "type": "text",
          "id": "blog_handle",
          "label": "Blog Handle",
          "info": "z.B. 'diaet-tipps' — findest Du unter Onlineshop → Blogs in der URL",
          "default": "news"
        },
        {
          "type": "text",
          "id": "label",
          "label": "Tab Beschriftung",
          "default": "Diät Tipps"
        },
        {
          "type": "text",
          "id": "emoji",
          "label": "Emoji",
          "default": "🥗"
        },
        {
          "type": "color",
          "id": "active_color",
          "label": "Aktiv Farbe (Text & Unterstrich)",
          "default": "#2a7a72"
        },
        {
          "type": "color",
          "id": "active_bg",
          "label": "Aktiv Hintergrund",
          "default": "#f0faf8"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Blog Tab-Navigation",
      "blocks": [
        {
          "type": "blog_tab",
          "settings": {
            "blog_handle": "diaet-tipps",
            "label": "Diät Tipps",
            "emoji": "🥗",
            "active_color": "#2a7a72"
          }
        },
        {
          "type": "blog_tab",
          "settings": {
            "blog_handle": "essen-trinken",
            "label": "Essen & Trinken",
            "emoji": "🍽️",
            "active_color": "#2a7a72"
          }
        },
        {
          "type": "blog_tab",
          "settings": {
            "blog_handle": "lebensstil",
            "label": "Lebensstil",
            "emoji": "🌸",
            "active_color": "#2a7a72"
          }
        },
        {
          "type": "blog_tab",
          "settings": {
            "blog_handle": "erfahrungen",
            "label": "Erfahrungen",
            "emoji": "💬",
            "active_color": "#2a7a72"
          }
        }
      ]
    }
  ]
}
{% endschema %}