      "id": "heading_color",
      "label": "Line 1 color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "italic_color",
      "label": "Line 2 color (italic)",
      "default": "#4FBFBE"
    },
    {
      "type": "header",
      "content": "Subtext"
    },
    {
      "type": "richtext",
      "id": "subtext",
