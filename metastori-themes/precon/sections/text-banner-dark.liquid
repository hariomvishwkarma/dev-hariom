<section class="tbd" id="tbd-{{ section.id }}" style="background: {{ section.settings.bg_color }};">

  <!-- ── Decorative radial blobs ── -->
  <div class="tbd__blob tbd__blob--tl" style="background: {{ section.settings.blob_color }};"></div>
  <div class="tbd__blob tbd__blob--br" style="background: {{ section.settings.blob_color }};"></div>

  <!-- ── Ribbon icon top left ── -->
  {%- if section.settings.show_icon -%}
    <div class="tbd__icon-wrap" style="color: {{ section.settings.icon_color }};">
      <svg width="48" height="56" viewBox="0 0 48 56" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
        <!-- Medal circle -->
        <circle cx="24" cy="22" r="18" fill="{{ section.settings.icon_bg }}" stroke="{{ section.settings.icon_color }}" stroke-width="2"/>
        <!-- Star -->
        <path d="M24 12l2.47 7.6H34l-6.18 4.49 2.36 7.26L24 27.01l-6.18 4.34 2.36-7.26L14 19.6h7.53L24 12z" fill="{{ section.settings.icon_color }}"/>
        <!-- Ribbon left -->
        <path d="M17 36l-5 14 7-4 5 6V36" fill="{{ section.settings.icon_bg }}" stroke="{{ section.settings.icon_color }}" stroke-width="1.5" stroke-linejoin="round"/>
        <!-- Ribbon right -->
        <path d="M31 36l5 14-7-4-5 6V36" fill="{{ section.settings.icon_bg }}" stroke="{{ section.settings.icon_color }}" stroke-width="1.5" stroke-linejoin="round"/>
      </svg>
    </div>
  {%- endif -%}

  <!-- ── Main content ── -->
  <div class="tbd__inner page-width">

    {%- if section.settings.eyebrow != blank -%}
      <p class="tbd__eyebrow" style="color: {{ section.settings.eyebrow_color }};">{{ section.settings.eyebrow }}</p>
    {%- endif -%}

    <h2 class="tbd__heading">
      {%- if section.settings.heading_line1 != blank -%}
        <span class="tbd__line1" style="color: {{ section.settings.heading_color }};">{{ section.settings.heading_line1 }}</span>
      {%- endif -%}
      {%- if section.settings.heading_line2 != blank -%}
        <em class="tbd__line2" style="color: {{ section.settings.italic_color }};">{{ section.settings.heading_line2 }}</em>
      {%- endif -%}
    </h2>

    {%- if section.settings.subtext != blank -%}
      <div class="tbd__subtext" style="color: {{ section.settings.subtext_color }};">{{ section.settings.subtext }}</div>
    {%- endif -%}

    <!-- ── CTAs ── -->
    <div class="tbd__ctas">
      {%- if section.settings.cta1_label != blank and section.settings.cta1_url != blank -%}
        <a
          class="tbd__cta tbd__cta--primary"
          href="{{ section.settings.cta1_url }}"
          style="background: {{ section.settings.cta1_bg }}; color: {{ section.settings.cta1_text }};"
        >{{ section.settings.cta1_label }}</a>
      {%- endif -%}
      {%- if section.settings.cta2_label != blank and section.settings.cta2_url != blank -%}
        <a
          class="tbd__cta tbd__cta--secondary"
          href="{{ section.settings.cta2_url }}"
          style="color: {{ section.settings.cta2_text }}; border-color: {{ section.settings.cta2_border }};"
        >{{ section.settings.cta2_label }}</a>
      {%- endif -%}
    </div>

  </div>
</section>

<style>
  /* ── Section ── */
  .tbd {
    position: relative;
    overflow: hidden;
    padding: {{ section.settings.padding_top }}px 0 {{ section.settings.padding_bottom }}px;
    font-family: 'Figtree', -apple-system, BlinkMacSystemFont, sans-serif;
  }

  /* ── Radial blobs ── */
  .tbd__blob {
    position: absolute;
    width: 480px;
    height: 480px;
    border-radius: 50%;
    opacity: 0.18;
    filter: blur(80px);
    pointer-events: none;
    z-index: 0;
  }

  .tbd__blob--tl {
    top: -120px;
    left: -80px;
  }

  .tbd__blob--br {
    bottom: -140px;
    right: -60px;
  }

  /* ── Ribbon icon ── */
  .tbd__icon-wrap {
    position: absolute;
    top: {{ section.settings.icon_top }}px;
    left: max(24px, 4rem);
    z-index: 2;
    opacity: 0.9;
  }

  /* ── Inner content ── */
  .tbd__inner {
    position: relative;
    z-index: 1;
    max-width: 760px;
    margin: 0 auto;
    padding: 0 24px;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  /* ── Eyebrow ── */
  .tbd__eyebrow {
    font-family: 'Figtree', sans-serif;
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    margin: 0 0 28px;
  }

  /* ── Heading ── */
  .tbd__heading {
    font-family: 'Figtree', sans-serif;
    font-size: clamp(36px, 5vw, 68px);
    font-weight: 300;
    line-height: 1.12;
    margin: 0 0 28px;
  }

  .tbd__line1 {
    display: block;
    font-family: 'Figtree', sans-serif;
    font-weight: 300;
    font-style: normal;
  }

  .tbd__line2 {
    display: block;
    font-family: var(--accent-font-family);
    font-style: var(--accent-font-style);
    font-weight: 500;
  }

  /* ── Subtext ── */
  .tbd__subtext {
    font-family: 'Figtree', sans-serif;
    font-size: clamp(15px, 1.2vw, 18px);
    font-weight: 400;
    line-height: 1.75;
    max-width: 540px;
    margin-bottom: 44px;
  }

  .tbd__subtext p { margin: 0 0 0.8em; }
  .tbd__subtext p:last-child { margin-bottom: 0; }

  /* ── CTAs ── */
  .tbd__ctas {
    display: flex;
    gap: 16px;
    flex-wrap: wrap;
    justify-content: center;
    align-items: center;
  }

  .tbd__cta {
    display: inline-block;
    font-family: 'Figtree', sans-serif;
    font-size: 15px;
    font-weight: 600;
    letter-spacing: 0.01em;
    padding: 16px 36px;
    border-radius: 50px;
    text-decoration: none;
    transition: opacity 0.2s ease, transform 0.2s ease;
  }

  .tbd__cta:hover {
    opacity: 0.85;
    transform: translateY(-2px);
  }

  .tbd__cta--secondary {
    background: transparent;
    border: 1.5px solid;
  }

  /* ── Mobile ── */
  @media (max-width: 600px) {
    .tbd__ctas {
      flex-direction: column;
      width: 100%;
    }

    .tbd__cta {
      width: 100%;
      text-align: center;
    }

    .tbd__icon-wrap {
      top: 20px;
      left: 20px;
    }

    .tbd__icon-wrap svg {
      width: 36px;
      height: 42px;
    }
  }
</style>

{% schema %}
{
  "name": "Text Banner Dark",
  "tag": "section",
  "class": "section-text-banner-dark",
  "settings": [
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background color",
      "default": "#4a4035"
    },
    {
      "type": "color",
      "id": "blob_color",
      "label": "Glow blob color",
      "default": "#7a6e5f"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 40,
      "max": 200,
      "step": 8,
      "default": 96,
      "unit": "px",
      "label": "Top padding"
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 40,
      "max": 200,
      "step": 8,
      "default": 96,
      "unit": "px",
      "label": "Bottom padding"
    },
    {
      "type": "header",
      "content": "Icon"
    },
    {
      "type": "checkbox",
      "id": "show_icon",
      "label": "Show ribbon icon",
      "default": false
    },
    {
      "type": "color",
      "id": "icon_color",
      "label": "Icon color",
      "default": "#4FBFBE"
    },
    {
      "type": "color",
      "id": "icon_bg",
      "label": "Icon fill / background",
      "default": "#3a3530"
    },
    {
      "type": "range",
      "id": "icon_top",
      "min": 16,
      "max": 80,
      "step": 4,
      "default": 36,
      "unit": "px",
      "label": "Icon distance from top"
    },
    {
      "type": "header",
      "content": "Eyebrow"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow text",
