      "default": "#4FBFBE"
    },
    {
      "type": "header",
      "content": "Heading"
    },
    {
      "type": "text",
      "id": "heading_line1",
      "label": "Line 1 (normal, Figtree)",
      "default": "1 Woche bevor es"
