    {
      "type": "header",
      "content": "CTA 1 (Primary)"
    },
    {
      "type": "text",
      "id": "cta1_label",
      "label": "Button 1 text",
      "default": "Jetzt exklusiv sichern"
    },
    {
      "type": "url",
      "id": "cta1_url",
      "label": "Button 1 link"
    },
    {
      "type": "color",
      "id": "cta1_bg",
      "label": "Button 1 background",
      "default": "#4FBFBE"
    },
    {
