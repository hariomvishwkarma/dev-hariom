{%- comment -%}
  sections/journey-timeline.liquid
  Fonts : Figtree 300/400/600 + Playfair Display 500 italic
  Colors: fully customisable via schema settings
{%- endcomment -%}

{%- liquid
assign c_bg       = section.settings.color_bg
assign c_ink      = section.settings.color_ink
assign c_mid      = section.settings.color_ink_mid
assign c_accent   = section.settings.color_accent
assign c_dash     = section.settings.color_dash
assign c_num_odd  = section.settings.color_num_odd
assign c_num_even = section.settings.color_num_even
-%}

<div id="journey-{{ section.id }}">

{%- comment -%}── HERO ──{%- endcomment -%}
<section class="jny-hero">
{%- if section.settings.eyebrow != blank -%}
<p class="jny-hero__eyebrow">{{ section.settings.eyebrow }}</p>
{%- endif -%}

<h1 class="jny-hero__title">
{%- if section.settings.hero_title_normal != blank -%}
{{ section.settings.hero_title_normal }}<br>
{%- endif -%}
{%- if section.settings.hero_title_italic != blank -%}
<em>{{ section.settings.hero_title_italic }}</em>
{%- endif -%}
</h1>

{%- if section.settings.hero_sub != blank -%}
<p class="jny-hero__sub">{{ section.settings.hero_sub }}</p>
{%- endif -%}

{%- if section.settings.scroll_hint != blank -%}
<p class="jny-hero__scroll-hint">{{ section.settings.scroll_hint }}</p>
{%- endif -%}

<div class="jny-hero__seed"></div>
</section>

{%- comment -%}── TIMELINE ──{%- endcomment -%}
<div class="jny-tl" id="jny-tl-{{ section.id }}">

<div class="jny-tl__track">
<div class="jny-tl__fill" id="jny-fill-{{ section.id }}"></div>
<div class="jny-tl__dot"  id="jny-dot-{{ section.id }}"></div>
</div>

{%- for block in section.blocks -%}
{%- assign is_even = forloop.index0 | modulo: 2 -%}
{%- if is_even == 0 -%}
{%- assign parity = 'jny-step--odd' -%}
{%- else -%}
{%- assign parity = 'jny-step--even' -%}
{%- endif -%}

<div class="jny-step {{ parity }}"
style="--step-col: {{ block.settings.color_step }}; --step-col-ghost: {{ block.settings.color_step | color_modify: 'alpha', 0.16 }};"
{{ block.shopify_attributes }}>

<div class="jny-step__visual">
<div class="jny-step__label-row">
<span class="jny-step__num">
{%- if forloop.index < 10 -%}0{%- endif -%}{{ forloop.index }}
</span>
<span class="jny-step__pipe"></span>
<span class="jny-step__name">{{ block.settings.step_name }}</span>
</div>

<figure class="jny-step__figure">
{%- if block.settings.image != blank -%}
<img
src="{{ block.settings.image | image_url: width: 1672, height: 941, crop: 'center' }}"
srcset="
{{ block.settings.image | image_url: width: 800,  height: 451, crop: 'center' }} 800w,
{{ block.settings.image | image_url: width: 1200, height: 676, crop: 'center' }} 1200w,
{{ block.settings.image | image_url: width: 1672, height: 941, crop: 'center' }} 1672w
                "
sizes="(min-width: 860px) 55vw, 92vw"
alt="{{ block.settings.image.alt | default: block.settings.step_name | escape }}"
width="{{ block.settings.image.width }}"
height="{{ block.settings.image.height }}"
loading="lazy"
>
{%- else -%}
{{ 'lifestyle-1' | placeholder_svg_tag: 'jny-ph' }}
{%- endif -%}
</figure>

</div>

<div class="jny-step__text">
<div class="jny-step__dash"></div>

<h2 class="jny-step__heading">
{%- if block.settings.heading_normal != blank -%}
{{ block.settings.heading_normal }}<br>
{%- endif -%}
{%- if block.settings.heading_italic != blank -%}
<em>{{ block.settings.heading_italic }}</em>
{%- endif -%}
</h2>

{%- if block.settings.copy != blank -%}
<div class="jny-step__copy">{{ block.settings.copy }}</div>
{%- endif -%}

{%- assign has_bullets = false -%}
{%- if block.settings.bullet_1 != blank or block.settings.bullet_2 != blank or block.settings.bullet_3 != blank or block.settings.bullet_4 != blank -%}
{%- assign has_bullets = true -%}
{%- endif -%}
{%- if has_bullets -%}
<ul class="jny-step__bullets">
{%- if block.settings.bullet_1 != blank -%}
<li class="jny-step__bullet">
<span class="jny-step__bullet-icon">
<svg width="13" height="10" viewBox="0 0 13 10" fill="none" xmlns="http://www.w3.org/2000/svg">
<path d="M1.5 5L5 8.5L11.5 1.5" stroke="white" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
</svg>
</span>
<span class="jny-step__bullet-text">{{ block.settings.bullet_1 }}</span>
</li>
{%- endif -%}
{%- if block.settings.bullet_2 != blank -%}
<li class="jny-step__bullet">
<span class="jny-step__bullet-icon">
<svg width="13" height="10" viewBox="0 0 13 10" fill="none" xmlns="http://www.w3.org/2000/svg">
<path d="M1.5 5L5 8.5L11.5 1.5" stroke="white" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
</svg>
</span>
<span class="jny-step__bullet-text">{{ block.settings.bullet_2 }}</span>
</li>
{%- endif -%}
{%- if block.settings.bullet_3 != blank -%}
<li class="jny-step__bullet">
<span class="jny-step__bullet-icon">
<svg width="13" height="10" viewBox="0 0 13 10" fill="none" xmlns="http://www.w3.org/2000/svg">
<path d="M1.5 5L5 8.5L11.5 1.5" stroke="white" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
</svg>
</span>
<span class="jny-step__bullet-text">{{ block.settings.bullet_3 }}</span>
</li>
{%- endif -%}
{%- if block.settings.bullet_4 != blank -%}
<li class="jny-step__bullet">
<span class="jny-step__bullet-icon">
<svg width="13" height="10" viewBox="0 0 13 10" fill="none" xmlns="http://www.w3.org/2000/svg">
<path d="M1.5 5L5 8.5L11.5 1.5" stroke="white" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
</svg>
</span>
<span class="jny-step__bullet-text">{{ block.settings.bullet_4 }}</span>
</li>
{%- endif -%}
</ul>
{%- endif -%}

{%- if block.settings.quote != blank or block.settings.cite != blank -%}
<blockquote class="jny-step__quote">
{%- if block.settings.cite != blank -%}
<div class="jny-step__quote-header">
<div class="jny-step__quote-avatar">
{{- block.settings.cite | slice: 0, 1 | upcase -}}
</div>
<div class="jny-step__quote-meta">
<strong class="jny-step__quote-name">{{ block.settings.cite }}</strong>
{%- if block.settings.cite_meta != blank -%}
<span class="jny-step__quote-sub">{{ block.settings.cite_meta }}</span>
{%- endif -%}
</div>
</div>
{%- endif -%}
{%- if block.settings.quote != blank -%}
<p class="jny-step__quote-text">{{ block.settings.quote }}</p>
{%- endif -%}
</blockquote>
{%- endif -%}
</div>

{%- if block.settings.cta_text != blank -%}
<a
class="jny-step__cta"
href="{{ block.settings.cta_url | default: '#' }}"
style="color: {{ block.settings.cta_color }};"
>
{{- block.settings.cta_text -}}&nbsp;→
</a>
{%- endif -%}

</div>
{%- endfor -%}
</div>
</div>


<style>
@import url('https://fonts.googleapis.com/css2?family=Figtree:wght@300;400;600&family=Playfair+Display:ital,wght@1,500&display=swap');

/* ── COLOR TOKENS (driven by schema settings) ── */
#journey-{{ section.id }} {
--bg:         {{ c_bg }};
--ink:        {{ c_ink }};
--ink-mid:    {{ c_mid }};
--teal:       {{ c_accent }};
--terra:      {{ c_dash }};
--teal-glow:  {{ c_accent | color_modify: 'alpha', 0.32 }};
--teal-soft:  {{ c_accent | color_modify: 'alpha', 0.11 }};
--track:      {{ c_ink | color_modify: 'alpha', 0.10 }};
--dot-col:    {{ c_ink | color_modify: 'alpha', 0.50 }};
--num-odd:    {{ c_num_odd  | color_modify: 'alpha', 0.14 }};
--num-even:   {{ c_num_even | color_modify: 'alpha', 0.11 }};
--lx:         22px;
  }

/* ── BASE ── */
#journey-{{ section.id }},
#journey-{{ section.id }} * { box-sizing: border-box; }

#journey-{{ section.id }} {
font-family: 'Figtree', sans-serif;
background: var(--bg);
color: var(--ink);
overflow-x: hidden;
-webkit-font-smoothing: antialiased;
  }
/* Image fills figure via absolute positioning — reliable across all flex/grid contexts */
#journey-{{ section.id }} .jny-step__figure {
position: relative;
  }
#journey-{{ section.id }} .jny-step__figure img,
#journey-{{ section.id }} .jny-step__figure .jny-ph {
position: absolute;
inset: 0;
width: 100%;
height: 100%;
object-fit: cover;
display: block;
  }

/* ── HERO ── */
#journey-{{ section.id }} .jny-hero {
min-height: 70svh;
display: flex;
flex-direction: column;
align-items: center;
justify-content: center;
text-align: center;
padding: 3rem 1.5rem 2.5rem;
  }
#journey-{{ section.id }} .jny-hero__eyebrow {
font-weight: 300;
font-size: .68rem;
letter-spacing: .26em;
text-transform: uppercase;
color: var(--teal);
margin: 0 0 2rem;
  }
#journey-{{ section.id }} .jny-hero__title {
font-family: 'Figtree', sans-serif;
font-weight: 300;
font-size: clamp(2rem, 4.8vw, 3.75rem);
line-height: 1.12;
color: var(--ink);
margin: 0 0 1.75rem;
max-width: 720px;
  }
#journey-{{ section.id }} .jny-hero__title em {
font-family: 'Playfair Display', serif;
font-style: italic;
font-weight: 500;
  }
#journey-{{ section.id }} .jny-hero__sub {
font-weight: 400;
font-size: clamp(.875rem, 2.5vw, 1rem);
line-height: 1.78;
color: var(--ink-mid);
max-width: 440px;
margin: 0 0 3.5rem;
  }
#journey-{{ section.id }} .jny-hero__scroll-hint {
font-weight: 600;
font-size: .62rem;
letter-spacing: .26em;
text-transform: uppercase;
color: var(--ink-mid);
margin: 0 0 1.25rem;
  }
#journey-{{ section.id }} .jny-hero__seed {
width: 1.5px;
height: 72px;
background: linear-gradient(to bottom, var(--track) 0%, transparent 100%);
  }

/* ── TIMELINE WRAPPER ── */
#journey-{{ section.id }} .jny-tl {
position: relative;
padding-bottom: 5rem;
  }

/* ── LINE ── */
#journey-{{ section.id }} .jny-tl__track {
position: absolute;
left: var(--lx);
top: 0; bottom: 0;
width: 2px;
background: var(--track);
pointer-events: none;
z-index: 0;
  }
#journey-{{ section.id }} .jny-tl__fill {
position: absolute;
top: 0; left: 0; right: 0;
height: 0%;
background: linear-gradient(to bottom, var(--teal) 0%, var(--teal) 94%, transparent 100%);
box-shadow: 0 0 8px var(--teal-glow), 0 0 20px var(--teal-soft);
will-change: height;
  }
#journey-{{ section.id }} .jny-tl__dot {
position: absolute;
left: 50%;
top: 0%;
transform: translate(-50%, -50%);
width: 12px; height: 12px;
border-radius: 50%;
background: var(--dot-col);
border: 2.5px solid var(--bg);
box-shadow: 0 0 0 1.5px var(--dot-col), 0 0 14px var(--teal-glow), 0 0 28px var(--teal-soft);
will-change: top;
z-index: 3;
animation: jny-pulse 2.8s ease-in-out infinite;
  }
@keyframes jny-pulse {
    0%,100% { box-shadow: 0 0 0 1.5px var(--dot-col), 0 0 14px var(--teal-glow), 0 0 28px var(--teal-soft); }
    50%      { box-shadow: 0 0 0 3.5px var(--dot-col), 0 0 22px var(--teal-glow), 0 0 40px var(--teal-soft); }
  }

/* ── STEP — mobile first ── */
#journey-{{ section.id }} .jny-step {
position: relative;
display: flex;
flex-direction: column;
gap: 2rem;
padding: 2.5rem 1.25rem 2.5rem 50px;
opacity: 0;
transform: translateY(24px);
transition: opacity .7s ease, transform .7s ease;
  }
#journey-{{ section.id }} .jny-step.is-visible { opacity: 1; transform: none; }

/* Mobile order: image → text → CTA */
#journey-{{ section.id }} .jny-step__visual            { order: 1; }
#journey-{{ section.id }} .jny-step__text              { order: 2; }
#journey-{{ section.id }} .jny-step > .jny-step__cta   { order: 3; }

/* ── VISUAL (label + image) ── */
#journey-{{ section.id }} .jny-step__visual {
display: flex;
flex-direction: column;
gap: 1.2rem;
  }
#journey-{{ section.id }} .jny-step__label-row {
display: flex;
align-items: center;
gap: .6rem;
  }
#journey-{{ section.id }} .jny-step__num {
font-family: 'Figtree', sans-serif;
font-weight: 600;
font-size: clamp(2.8rem, 7vw, 4.2rem);
line-height: 1;
color: var(--step-col-ghost, var(--num-odd));
  }
#journey-{{ section.id }} .jny-step--even .jny-step__num { color: var(--step-col-ghost, var(--num-even)); }
#journey-{{ section.id }} .jny-step__pipe {
width: 1px; height: 1em;
background: var(--ink-mid);
opacity: .28;
flex-shrink: 0;
  }
#journey-{{ section.id }} .jny-step__name {
font-weight: 600;
font-size: .72rem;
letter-spacing: .22em;
text-transform: uppercase;
color: var(--step-col, var(--ink-mid));
  }
#journey-{{ section.id }} .jny-step__figure {
border-radius: 22px;
overflow: hidden;
aspect-ratio: 1672 / 941;
background: var(--track);
box-shadow: 0 10px 40px {{ c_ink | color_modify: 'alpha', 0.10 }},
0  2px 10px {{ c_ink | color_modify: 'alpha', 0.06 }};
  }

/* ── CTA LINK ── */
#journey-{{ section.id }} .jny-step__cta {
display: none; /* hidden on mobile, shown on desktop only */
align-items: center;
font-weight: 600;
font-size: .9rem;
letter-spacing: .02em;
text-decoration: none;
margin-top: 0;
transition: opacity .2s ease;
  }
#journey-{{ section.id }} .jny-step__cta:hover { opacity: .72; }

/* ── TEXT ── */
#journey-{{ section.id }} .jny-step__text {
display: flex;
flex-direction: column;
  }
#journey-{{ section.id }} .jny-step__dash {
width: 36px; height: 3px;
background: var(--step-col, var(--terra));
opacity: .55;
margin: 0 0 1.1rem;
flex-shrink: 0;
  }
#journey-{{ section.id }} .jny-step__heading {
font-family: 'Figtree', sans-serif;
font-weight: 300;
font-size: clamp(1.75rem, 4.5vw, 2.5rem);
line-height: 1.2;
color: var(--ink);
margin: 0 0 1.1rem;
  }
#journey-{{ section.id }} .jny-step__heading em {
font-family: 'Playfair Display', serif;
font-style: italic;
font-weight: 500;
  }
#journey-{{ section.id }} .jny-step__copy {
font-weight: 400;
font-size: clamp(.875rem, 1.8vw, .94rem);
line-height: 1.82;
color: var(--ink-mid);
margin: 0 0 1.5rem;
  }
#journey-{{ section.id }} .jny-step__copy p { margin: 0 0 .75rem; }
#journey-{{ section.id }} .jny-step__copy p:last-child { margin-bottom: 0; }
#journey-{{ section.id }} .jny-step__copy strong { font-weight: 600; color: var(--ink); }
#journey-{{ section.id }} .jny-step__bullets {
list-style: none;
padding: 0;
margin: 0 0 1.5rem;
display: flex;
flex-direction: column;
gap: .75rem;
  }
#journey-{{ section.id }} .jny-step__bullet {
display: flex;
align-items: flex-start;
gap: .85rem;
  }
#journey-{{ section.id }} .jny-step__bullet-icon {
width: 28px;
height: 28px;
border-radius: 50%;
background: var(--step-col, var(--teal));
display: flex;
align-items: center;
justify-content: center;
flex-shrink: 0;
margin-top: .1rem;
  }
#journey-{{ section.id }} .jny-step__bullet-text {
font-size: clamp(.875rem, 1.8vw, .94rem);
line-height: 1.65;
color: var(--ink);
  }
/* ── QUOTE — mobile: no negative margins to prevent timeline/viewport overflow ── */
#journey-{{ section.id }} .jny-step__quote {
background: #ffffff;
border: 1px solid {{ c_ink | color_modify: 'alpha', 0.10 }};
border-radius: 14px;
padding: 1.25rem 1.4rem;
margin-top: auto;
margin-left: 0;
margin-right: 0;
  }
#journey-{{ section.id }} .jny-step__quote-header {
display: flex;
align-items: center;
gap: .85rem;
margin-bottom: 1rem;
  }
#journey-{{ section.id }} .jny-step__quote-avatar {
width: 40px;
height: 40px;
border-radius: 50%;
background: {{ c_ink | color_modify: 'alpha', 0.09 }};
display: flex;
align-items: center;
justify-content: center;
font-weight: 600;
font-size: .9rem;
color: var(--ink);
flex-shrink: 0;
  }
#journey-{{ section.id }} .jny-step__quote-meta {
display: flex;
flex-direction: column;
gap: .15rem;
  }
#journey-{{ section.id }} .jny-step__quote-name {
font-weight: 600;
font-size: .88rem;
color: var(--ink);
display: block;
  }
#journey-{{ section.id }} .jny-step__quote-sub {
font-size: .75rem;
font-weight: 400;
color: var(--ink-mid);
display: block;
  }
#journey-{{ section.id }} .jny-step__quote-text {
font-family: 'Playfair Display', serif;
font-style: italic;
font-size: 1rem;
line-height: 1.65;
color: var(--ink);
margin: 0;
  }

/* ── DESKTOP ≥ 860px ── */
@media (min-width: 860px) {
#journey-{{ section.id }} .jny-tl {
max-width: 1300px;
margin: 0 auto;
    }
/* Line to center */
#journey-{{ section.id }} .jny-tl__track {
left: 50%;
transform: translateX(-50%);
    }

/* Two-column grid — visual + CTA in one column, text in the other */
#journey-{{ section.id }} .jny-step {
display: grid;
grid-template-rows: auto auto;
align-items: start;
gap: 0;
padding: 3.5rem 3rem;
    }
/* Odd: visual col is 55%, text col is 45% */
#journey-{{ section.id }} .jny-step--odd  { grid-template-columns: 55% 45%; }
/* Even: text col is 45%, visual col is 55% — keeps image same width */
#journey-{{ section.id }} .jny-step--even { grid-template-columns: 45% 55%; }
/* Reset mobile order */
#journey-{{ section.id }} .jny-step__visual,
#journey-{{ section.id }} .jny-step__text,
#journey-{{ section.id }} .jny-step > .jny-step__cta { order: unset; }
#journey-{{ section.id }} .jny-step__visual {
min-width: 0;
gap: 1.5rem;
    }
#journey-{{ section.id }} .jny-step__text {
min-width: 0;
justify-content: flex-start;
padding-top: 1rem;
    }

/* Odd: visual col-1/row-1, CTA col-1/row-2, text col-2/rows-1-2 */
#journey-{{ section.id }} .jny-step--odd .jny-step__visual  { grid-column: 1; grid-row: 1; padding-right: 5rem; }
#journey-{{ section.id }} .jny-step--odd > .jny-step__cta   { grid-column: 1; grid-row: 2; padding-right: 5rem; align-self: start; }
#journey-{{ section.id }} .jny-step--odd .jny-step__text    { grid-column: 2; grid-row: 1 / span 2; padding-left: 5rem; }

/* Even: visual col-2/row-1, CTA col-2/row-2, text col-1/rows-1-2 */
#journey-{{ section.id }} .jny-step--even .jny-step__visual { grid-column: 2; grid-row: 1; padding-left: 5rem; padding-right: 0; }
#journey-{{ section.id }} .jny-step--even > .jny-step__cta  { grid-column: 2; grid-row: 2; padding-left: 5rem; align-self: start; }
#journey-{{ section.id }} .jny-step--even .jny-step__text   { grid-column: 1; grid-row: 1 / span 2; padding-right: 5rem; padding-left: 0; }

/* CTA visible on desktop, sitting directly below the image */
#journey-{{ section.id }} .jny-step__cta { display: inline-flex; margin-top: 1.1rem; }

#journey-{{ section.id }} .jny-step__num { font-size: 4.2rem; }

/* Even steps: flip label row so big number sits on the outer (right) edge */
#journey-{{ section.id }} .jny-step--even .jny-step__label-row {
flex-direction: row-reverse;
    }
/* Desktop: restore the wider negative margins for the quote card */
#journey-{{ section.id }} .jny-step__quote {
margin-left: -2.5rem;
margin-right: -2.5rem;
    }
  }

@media (min-width: 1100px) {
#journey-{{ section.id }} .jny-step { padding: 4rem 4rem; }
#journey-{{ section.id }} .jny-step--odd  .jny-step__visual { padding-right: 6rem; }
#journey-{{ section.id }} .jny-step--odd  > .jny-step__cta  { padding-right: 6rem; }
#journey-{{ section.id }} .jny-step--odd  .jny-step__text   { padding-left:  6rem; }
#journey-{{ section.id }} .jny-step--even .jny-step__visual { padding-left:  6rem; }
#journey-{{ section.id }} .jny-step--even > .jny-step__cta  { padding-left:  6rem; }
#journey-{{ section.id }} .jny-step--even .jny-step__text   { padding-right: 6rem; }
  }
</style>


<script>
  (function () {
var tl   = document.getElementById('jny-tl-{{ section.id }}');
var fill = document.getElementById('jny-fill-{{ section.id }}');
var dot  = document.getElementById('jny-dot-{{ section.id }}');
if (!tl || !fill || !dot) return;

var cur = 0, tgt = 0;

function calc() {
var r = tl.getBoundingClientRect(), vh = window.innerHeight;
return Math.max(0, Math.min(100, (-r.top + vh * 0.48) / (r.height - vh * 0.05) * 100));
    }
    (function loop() {
tgt = calc();
cur += (tgt - cur) * 0.085;
if (Math.abs(tgt - cur) > 0.004) {
var v = cur.toFixed(3);
fill.style.height = v + '%';
dot.style.top     = v + '%';
      }
requestAnimationFrame(loop);
    })();

var io = new IntersectionObserver(function(e) {
e.forEach(function(x) {
if (x.isIntersecting) { x.target.classList.add('is-visible'); io.unobserve(x.target); }
      });
    }, { threshold: 0.07, rootMargin: '0px 0px -50px 0px' });
tl.querySelectorAll('.jny-step').forEach(function(s) { io.observe(s); });
  })();
</script>


