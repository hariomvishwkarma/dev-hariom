{%- comment -%}
  sections/text-image-section.liquid
  2-Spalten: Text links + Bild rechts (oder umgekehrt)
  Eyebrow / Heading (Figtree 300 + Playfair em) / Richtext / Button
  Fonts: Figtree 300/400/600 + Playfair Display 500 italic
{%- endcomment -%}

{%- liquid
  assign c_bg      = section.settings.color_bg
  assign c_ink     = section.settings.color_ink
  assign c_mid     = section.settings.color_mid
  assign c_accent  = section.settings.color_accent
  assign c_btn_bg  = section.settings.color_btn_bg
  assign c_btn_ink = section.settings.color_btn_ink
  assign pt        = section.settings.padding_top
  assign pb        = section.settings.padding_bottom
-%}

<div id="txi-{{ section.id }}" class="txi{% if section.settings.image_position == 'right' %} txi--img-right{% endif %}"
     style="padding-top: {{ pt }}px; padding-bottom: {{ pb }}px;">
  <div class="txi__inner">

    <!-- ── Text-Spalte ── -->
    <div class="txi__text">

      {%- if section.settings.eyebrow != blank -%}
        <p class="txi__eyebrow">
          <span class="txi__eyebrow-rule"></span>
          {{ section.settings.eyebrow }}
          <span class="txi__eyebrow-rule"></span>
        </p>
      {%- endif -%}

      {%- if section.settings.heading != blank -%}
        <h2 class="txi__heading">{{ section.settings.heading }}</h2>
      {%- endif -%}

      {%- if section.settings.body != blank -%}
        <div class="txi__body">{{ section.settings.body }}</div>
      {%- endif -%}

      {%- if section.settings.btn_label != blank -%}
        <a class="txi__btn" href="{{ section.settings.btn_url }}">
          {{ section.settings.btn_label }}
        </a>
      {%- endif -%}

    </div>

    <!-- ── Bild-Spalte ── -->
    <div class="txi__media">
      {%- if section.settings.image != blank -%}
        {{
          section.settings.image
          | image_url: width: 1000
          | image_tag:
            class: 'txi__img',
            loading: 'lazy',
            widths: '400,600,800,1000',
            sizes: '(max-width: 860px) 100vw, 48vw'
        }}
      {%- else -%}
        <div class="txi__placeholder">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1" xmlns="http://www.w3.org/2000/svg">
            <rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="8.5" cy="8.5" r="1.5"/><polyline points="21 15 16 10 5 21"/>
          </svg>
        </div>
      {%- endif -%}
    </div>

  </div>
</div>

<style>
@import url('https://fonts.googleapis.com/css2?family=Figtree:wght@300;400;600&family=Playfair+Display:ital,wght@1,500&display=swap');

#txi-{{ section.id }} {
  --bg:      {{ c_bg }};
  --ink:     {{ c_ink }};
  --mid:     {{ c_mid }};
  --accent:  {{ c_accent }};
  --btn-bg:  {{ c_btn_bg }};
  --btn-ink: {{ c_btn_ink }};
}

#txi-{{ section.id }},
#txi-{{ section.id }} * { box-sizing: border-box; }

#txi-{{ section.id }} {
  background: var(--bg);
  font-family: 'Figtree', sans-serif;
  -webkit-font-smoothing: antialiased;
  padding-left: 1.5rem;
  padding-right: 1.5rem;
}

/* ── Layout ── */
#txi-{{ section.id }} .txi__inner {
  max-width: 1100px;
  margin: 0 auto;
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 5rem;
  align-items: center;
}

/* Bild rechts = Text zuerst im DOM (schon so), Bild rechts via CSS order */
#txi-{{ section.id }}.txi--img-right .txi__text { order: 1; }
#txi-{{ section.id }}.txi--img-right .txi__media { order: 2; }

/* Bild links = Text rechts */
#txi-{{ section.id }}:not(.txi--img-right) .txi__text { order: 2; }
#txi-{{ section.id }}:not(.txi--img-right) .txi__media { order: 1; }

/* ── Text-Spalte ── */
#txi-{{ section.id }} .txi__text {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  gap: 1.1rem;
}

/* Eyebrow */
#txi-{{ section.id }} .txi__eyebrow {
  display: inline-flex;
  align-items: center;
  gap: 10px;
  font-size: 11px;
  font-weight: 600;
  letter-spacing: 0.24em;
  text-transform: uppercase;
  color: var(--accent);
  margin: 0;
}

#txi-{{ section.id }} .txi__eyebrow-rule {
  display: block;
  width: 22px;
  height: 1px;
  background: currentColor;
  opacity: 0.45;
  flex-shrink: 0;
}

/* Heading */
#txi-{{ section.id }} .txi__heading {
  font-size: clamp(26px, 2.8vw, 44px);
  font-weight: 300;
  color: var(--ink);
  line-height: 1.1;
  letter-spacing: -0.026em;
  text-wrap: balance;
  margin: 0;
}

#txi-{{ section.id }} .txi__heading em {
  font-family: 'Playfair Display', serif;
  font-style: italic;
  font-weight: 500;
  letter-spacing: -0.02em;
}

/* Body (Richtext) */
#txi-{{ section.id }} .txi__body {
  color: var(--mid);
  font-size: clamp(15px, 1.1vw, 17px);
  font-weight: 400;
  line-height: 1.78;
}

#txi-{{ section.id }} .txi__body p {
  margin: 0 0 1em;
}

#txi-{{ section.id }} .txi__body p:last-child {
  margin-bottom: 0;
}

#txi-{{ section.id }} .txi__body em {
  font-family: 'Playfair Display', serif;
  font-style: italic;
  color: var(--ink);
}

#txi-{{ section.id }} .txi__body strong {
  font-weight: 600;
  color: var(--ink);
}

/* Button */
#txi-{{ section.id }} .txi__btn {
  display: inline-flex;
  align-items: center;
  background: var(--btn-bg);
  color: var(--btn-ink);
  font-family: 'Figtree', sans-serif;
  font-size: 15px;
  font-weight: 600;
  letter-spacing: 0.01em;
  padding: 14px 32px;
  border-radius: 999px;
  text-decoration: none;
  transition: opacity 0.2s, transform 0.2s;
  margin-top: 0.5rem;
  white-space: nowrap;
}

#txi-{{ section.id }} .txi__btn:hover {
  opacity: 0.88;
  transform: translateY(-1px);
}

/* ── Bild-Spalte ── */
#txi-{{ section.id }} .txi__media {
  border-radius: 18px;
  overflow: hidden;
}

#txi-{{ section.id }} .txi__img {
  width: 100%;
  height: auto;
  display: block;
}

/* Placeholder */
#txi-{{ section.id }} .txi__placeholder {
  aspect-ratio: 4 / 3;
  background: #ede9e2;
  border-radius: 18px;
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--mid);
  opacity: 0.4;
}

#txi-{{ section.id }} .txi__placeholder svg {
  width: 48px;
  height: 48px;
}

/* ── Responsive ── */
@media (max-width: 860px) {
  #txi-{{ section.id }} .txi__inner {
    grid-template-columns: 1fr;
    gap: 2.5rem;
  }

  /* Bild immer zuerst auf Mobil */
  #txi-{{ section.id }} .txi__media { order: 1 !important; }
  #txi-{{ section.id }} .txi__text  { order: 2 !important; }

  #txi-{{ section.id }} {
    padding-left: 1rem;
    padding-right: 1rem;
  }

  #txi-{{ section.id }} .txi__btn {
    white-space: normal;
    text-align: center;
  }
}
</style>

{% schema %}
{
  "name": "Text & Bild",
  "tag": "section",
  "settings": [
    {
      "type": "header",
      "content": "Bild"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Bild"
    },
    {
      "type": "select",
      "id": "image_position",
      "label": "Bild-Position",
      "options": [
        { "value": "right", "label": "Bild rechts" },
        { "value": "left",  "label": "Bild links" }
      ],
      "default": "right"
    },
    {
      "type": "header",
      "content": "Text"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow (optional)"
    },
    {
      "type": "richtext",
      "id": "heading",
      "label": "Ueberschrift",
      "default": "<p>Wie wir mit Dir <em>arbeiten</em></p>"
    },
    {
      "type": "richtext",
      "id": "body",
      "label": "Text",
      "default": "<p>Wir sind nahbar, ehrlich und kompetent – und vor allem: wir hoeren Dir wirklich zu.</p><p>Dein Weg ist so einzigartig wie Du selbst. Deshalb begleiten wir Dich mit Respekt und Wertschaetzung – vom ersten Tag bis zu Deinem <em>Ich hab's geschafft</em>-Moment.</p>"
    },
    {
      "type": "header",
      "content": "Button (optional)"
    },
    {
      "type": "text",
      "id": "btn_label",
      "label": "Button Text",
      "default": "Zum Kundendienst"
    },
    {
      "type": "url",
      "id": "btn_url",
      "label": "Button Link"
    },
    {
      "type": "header",
      "content": "Abstaende"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Abstand oben",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 72
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Abstand unten",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 72
    },
    {
      "type": "header",
      "content": "Farben"
    },
    {
      "type": "color",
      "id": "color_bg",
      "label": "Hintergrund",
      "default": "#FAF9F5"
    },
    {
      "type": "color",
      "id": "color_ink",
      "label": "Ueberschrift",
      "default": "#56473A"
    },
    {
      "type": "color",
      "id": "color_mid",
      "label": "Text",
      "default": "#8C7C70"
    },
    {
      "type": "color",
      "id": "color_accent",
      "label": "Eyebrow / Akzent",
      "default": "#3DADBB"
    },
    {
      "type": "color",
      "id": "color_btn_bg",
      "label": "Button Hintergrund",
      "default": "#3DADBB"
    },
    {
      "type": "color",
      "id": "color_btn_ink",
      "label": "Button Text",
      "default": "#FFFFFF"
    }
  ],
  "presets": [
    {
      "name": "Text & Bild"
    }
  ]
}
{% endschema %}