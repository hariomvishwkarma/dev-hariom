<section class="card-image-right" id="card-image-right-{{ section.id }}">
  <div class="card-image-right__inner page-width">

    <!-- ── Top text block (only rendered when at least one field has content) ── -->
    {%- if section.settings.eyebrow != blank or section.settings.heading != blank or section.settings.intro_text != blank -%}
      <div class="card-image-right__intro">
        {%- if section.settings.eyebrow != blank -%}
          <p class="card-image-right__eyebrow" style="color: {{ section.settings.eyebrow_color }};">
            {{ section.settings.eyebrow }}
          </p>
        {%- endif -%}

        {%- if section.settings.heading != blank -%}
          <h2 class="card-image-right__heading">{{ section.settings.heading }}</h2>
        {%- endif -%}

        {%- if section.settings.intro_text != blank -%}
          <div class="card-image-right__intro-text">{{ section.settings.intro_text }}</div>
        {%- endif -%}
      </div>
    {%- endif -%}

    <!-- ── Feature card ── -->
    <div class="card-image-right__card{% if section.settings.image_position == 'right' %} card-image-right__card--image-right{% endif %}">

      <!-- Content (text) side -->
      <div class="card-image-right__card-content">
        {%- if section.settings.card_eyebrow != blank -%}
          <p class="card-image-right__card-eyebrow" style="color: {{ section.settings.card_eyebrow_color }};">
            {{ section.settings.card_eyebrow }}
          </p>
        {%- endif -%}

        {%- if section.settings.card_heading != blank -%}
          <h3 class="card-image-right__card-heading">{{ section.settings.card_heading }}</h3>
        {%- endif -%}

        {%- if section.settings.card_text != blank -%}
          <div class="card-image-right__card-text">{{ section.settings.card_text }}</div>
        {%- endif -%}

        {%- if section.settings.card_btn_label != blank -%}
          <a
            href="{{ section.settings.card_btn_link }}"
            class="card-image-right__card-btn"
            style="background-color: {{ section.settings.card_btn_bg }}; color: {{ section.settings.card_btn_text_color }}; border-color: {{ section.settings.card_btn_bg }};"
          >
            {{ section.settings.card_btn_label }}&nbsp;&rarr;
          </a>
        {%- endif -%}
      </div>

      <!-- Image side -->
      <div class="card-image-right__card-media">
        {%- if section.settings.card_image != blank -%}
          {{ section.settings.card_image | image_url: width: 1200 | image_tag:
            class: 'card-image-right__card-img',
            loading: 'lazy',
            sizes: '(max-width: 960px) 100vw, 50vw',
            widths: '375, 750, 1000, 1200'
          }}
        {%- else -%}
          {{ 'lifestyle-2' | placeholder_svg_tag: 'card-image-right__card-img card-image-right__card-img--placeholder' }}
        {%- endif -%}
      </div>

    </div>

  </div>
</section>

<style>
  /* ══════════════════════════════════
     Section
     ══════════════════════════════════ */
  .card-image-right {
    background-color: {{ section.settings.section_bg }};
    padding: {{ section.settings.padding_top }}px 0 {{ section.settings.padding_bottom }}px;
  }

  .card-image-right__inner {
    max-width: 1140px;
    margin: 0 auto;
    padding: 0 24px;
  }

  /* ══════════════════════════════════
     Intro (top centered text)
     ══════════════════════════════════ */
  .card-image-right__intro {
    text-align: center;
    max-width: 760px;
    margin: 0 auto 48px;
  }

  /* Eyebrow: Figtree Semi-Bold */
  .card-image-right__eyebrow {
    font-family: 'Figtree', sans-serif;
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    margin: 0 0 16px;
  }

  /* Heading: Figtree Light */
  .card-image-right__heading {
    font-family: 'Figtree', sans-serif;
    font-size: clamp(30px, 4vw, 46px);
    font-weight: 300;
    line-height: 1.15;
    color: {{ section.settings.heading_color }};
    margin: 0 0 20px;
  }

  /* Italic/em parts: Playfair Display Medium Italic */
  .card-image-right__heading em,
  .card-image-right__heading strong,
  .card-image-right__heading em strong,
  .card-image-right__heading strong em {
    font-family: var(--accent-font-family);
    font-style: var(--accent-font-style);
    font-weight: 500;
  }

  /* Intro text: Figtree Normal */
  .card-image-right__intro-text {
    font-family: 'Figtree', sans-serif;
    font-size: clamp(15px, 1.15vw, 17px);
    font-weight: 400;
    line-height: 1.7;
    color: {{ section.settings.text_color }};
  }

  .card-image-right__intro-text p {
    margin: 0;
  }

  /* ══════════════════════════════════
     Feature card — base (text left, image right)
     ══════════════════════════════════ */
  .card-image-right__card {
    display: grid;
    grid-template-columns: 1fr 1fr;
    background: {{ section.settings.card_bg }};
    border-radius: {{ section.settings.card_radius }}px;
    overflow: hidden;
    border: {{ section.settings.card_border_thickness }}px solid {{ section.settings.card_border_color }};
    box-shadow: 0 4px 24px rgba(0, 0, 0, 0.06);
  }

  /* Content left (default) */
  .card-image-right__card-content {
    order: 1;
    padding: 44px 44px 40px;
    display: flex;
    flex-direction: column;
    justify-content: center;
  }

  /* Image right (default) */
  .card-image-right__card-media {
    order: 2;
    min-height: 380px;
  }

  /* ── Flip variant: image left, text right ── */
  .card-image-right__card--image-right .card-image-right__card-content {
    order: 2;
  }

  .card-image-right__card--image-right .card-image-right__card-media {
    order: 1;
  }

  /* Image */
  .card-image-right__card-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .card-image-right__card-img--placeholder {
    background: #eee;
  }

  /* Card eyebrow: Figtree Semi-Bold */
  .card-image-right__card-eyebrow {
    font-family: 'Figtree', sans-serif;
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    margin: 0 0 14px;
  }

  /* Card heading: Figtree Light */
  .card-image-right__card-heading {
    font-family: 'Figtree', sans-serif;
    font-size: clamp(24px, 2.5vw, 32px);
    font-weight: 300;
    line-height: 1.2;
    color: {{ section.settings.card_heading_color }};
    margin: 0 0 20px;
  }

  .card-image-right__card-heading em,
  .card-image-right__card-heading strong,
  .card-image-right__card-heading em strong,
  .card-image-right__card-heading strong em {
    font-family: var(--accent-font-family);
    font-style: var(--accent-font-style);
    font-weight: 500;
  }

  /* Card body: Figtree Normal */
  .card-image-right__card-text {
    font-family: 'Figtree', sans-serif;
    font-size: 14.5px;
    font-weight: 400;
    line-height: 1.7;
    color: {{ section.settings.card_text_color }};
    margin-bottom: 28px;
  }

  .card-image-right__card-text p {
    margin: 0 0 14px;
  }

  .card-image-right__card-text p:last-child {
    margin-bottom: 0;
  }

  /* Button: Figtree Semi-Bold */
  .card-image-right__card-btn {
    font-family: 'Figtree', sans-serif;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    align-self: flex-start;
    padding: 14px 32px;
    font-size: 15px;
    font-weight: 600;
    border-radius: 50px;
    border: 2px solid;
    text-decoration: none;
    transition: opacity 0.25s ease;
    white-space: nowrap;
  }

  .card-image-right__card-btn:hover {
    opacity: 0.85;
  }

  /* ══════════════════════════════════
     Responsive
     ══════════════════════════════════ */
  @media (max-width: 960px) {
    .card-image-right__card {
      grid-template-columns: 1fr;
    }

    /* On mobile always show image on top regardless of desktop layout */
    .card-image-right__card-media {
      order: 1 !important;
      min-height: 260px;
    }

    .card-image-right__card-content {
      order: 2 !important;
      padding: 28px 24px 32px;
    }
  }
</style>

{% schema %}
{
  "name": "Card Image Right",
  "tag": "section",
  "class": "section-card-image-right",
  "settings": [
    {
      "type": "header",
      "content": "Section layout"
    },
    {
      "type": "color",
      "id": "section_bg",
      "label": "Section background",
      "default": "#f7f3ee"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 120,
      "step": 4,
      "default": 64,
      "unit": "px",
      "label": "Top padding"
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "default": 72,
      "unit": "px",
      "label": "Bottom padding"
    },
    {
      "type": "header",
      "content": "Intro text"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "VISUELLES MODELL"
    },
    {
      "type": "color",
      "id": "eyebrow_color",
      "label": "Eyebrow color",
      "default": "#4FBFBE"
    },
    {
      "type": "richtext",
      "id": "heading",
      "label": "Heading",
      "default": "<p>Was kommt <em>auf den Teller?</em></p>"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading color",
      "default": "#2c2c2c"
    },
    {
      "type": "richtext",
      "id": "intro_text",
      "label": "Intro paragraph",
      "default": "<p>Das Precon-Konzept hilft Dir dabei, gezielt, abwechslungsreich und nachhaltig abzunehmen. Doch die Umstellung Deiner alten Essgewohnheiten sind ein wichtiger Teil der Diät, deshalb wirst Du nach der Startphase bereits eine ausgewogene Mahlzeit nach dem Teller-Check selbst zubereiten.</p>"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Intro text color",
      "default": "#6b645c"
    },
    {
      "type": "header",
      "content": "Feature card — Image"
    },
    {
      "type": "image_picker",
      "id": "card_image",
      "label": "Card image"
    },
    {
      "type": "select",
      "id": "image_position",
      "label": "Image position",
      "info": "On mobile the image always appears on top.",
      "default": "right",
      "options": [
        { "value": "left",  "label": "Left" },
        { "value": "right", "label": "Right" }
      ]
    },
    {
      "type": "header",
      "content": "Feature card — Content"
    },
    {
      "type": "text",
      "id": "card_eyebrow",
      "label": "Card eyebrow",
      "default": "INSPIRATION FÜR DEINE MAHLZEITEN"
    },
    {
      "type": "color",
      "id": "card_eyebrow_color",
      "label": "Card eyebrow color",
      "default": "#4FBFBE"
    },
    {
      "type": "richtext",
      "id": "card_heading",
      "label": "Card heading",
      "default": "<p>Abwechslungsreich <em>kochen & abnehmen</em></p>"
    },
    {
      "type": "color",
      "id": "card_heading_color",
      "label": "Card heading color",
      "default": "#2c2c2c"
    },
    {
      "type": "richtext",
      "id": "card_text",
      "label": "Card body text",
      "default": "<p>In der Precon-Rezeptwelt findest Du hunderte Ideen, die perfekt auf das Konzept abgestimmt sind — von schnellen Alltagsgerichten bis hin zu inspirierenden Wochenend-Rezepten.</p><p>Alle Rezepte sind auf ca. 600 kcal pro Portion ausgelegt. Damit ist die normale Mahlzeit keine Diätmahlzeit, sondern eine Mahlzeit, wie Du sie auch nach der Diät zubereiten kannst, um Dein Gewicht zu halten.</p>"
    },
    {
      "type": "color",
      "id": "card_text_color",
      "label": "Card body color",
      "default": "#6b645c"
    },
    {
      "type": "header",
      "content": "Feature card — Button"
    },
    {
      "type": "text",
      "id": "card_btn_label",
      "label": "Button label",
      "default": "Zur Rezeptwelt"
    },
    {
      "type": "url",
      "id": "card_btn_link",
      "label": "Button link"
    },
    {
      "type": "color",
      "id": "card_btn_bg",
      "label": "Button background",
      "default": "#4FBFBE"
    },
    {
      "type": "color",
      "id": "card_btn_text_color",
      "label": "Button text color",
      "default": "#ffffff"
    },
    {
      "type": "header",
      "content": "Feature card — Style"
    },
    {
      "type": "color",
      "id": "card_bg",
      "label": "Card background",
      "default": "#ffffff"
    },
    {
      "type": "range",
      "id": "card_radius",
      "min": 0,
      "max": 32,
      "step": 2,
      "default": 16,
      "unit": "px",
      "label": "Card corner radius"
    },
    {
      "type": "range",
      "id": "card_border_thickness",
      "min": 0,
      "max": 5,
      "step": 0.5,
      "default": 0,
      "unit": "px",
      "label": "Card border thickness"
    },
    {
      "type": "color",
      "id": "card_border_color",
      "label": "Card border color",
      "default": "#d5d0c8"
    }
  ],
  "presets": [
    {
      "name": "Card Image Right"
    }
  ]
}
{% endschema %}