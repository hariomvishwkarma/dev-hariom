<style>
  .hero-land {
    padding: 48px 20px;
    font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
    background-color: {{ section.settings.bg_color }};
    color: {{ section.settings.text_color }};
  }
  .hero-land__inner {
    max-width: 960px;
    margin: 0 auto;
  }
  .hero-land__badge {
    display: inline-block;
    background-color: {{ section.settings.badge_bg }};
    color: {{ section.settings.badge_text_color }};
    padding: 6px 20px;
    border-radius: 30px;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 1.2px;
    text-transform: uppercase;
    margin-bottom: 16px;
  }
  .hero-land__heading {
    font-size: clamp(32px, 5vw, 52px);
    font-weight: 600;
    line-height: 1.12;
    margin: 0 0 16px;
    max-width: 650px;
  }
  .hero-land__heading em {
    font-style: italic;
    font-weight: 500;
    font-family: Georgia, 'Times New Roman', serif;
    color: {{ section.settings.accent_color }};
    display: block;
    font-size: 1.05em;
  }
  .hero-land__desc {
    font-size: 15px;
    line-height: 1.7;
    opacity: 0.8;
    margin: 0 0 32px;
    max-width: 540px;
  }

  /* ── Two columns ── */
  .hero-land__columns {
    display: flex;
    gap: 32px;
    align-items: flex-start;
  }
  .hero-land__col-img {
    flex: 1;
    min-width: 0;
  }
  .hero-land__col-img img {
    width: 100%;
    height: auto;
    display: block;
    border-radius: 12px;
  }
  .hero-land__col-card {
    flex: 0 0 340px;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  /* ── Rating ── */
  .hero-land__rating {
    background: #fff;
    border: 1px solid {{ section.settings.card_border }};
    border-radius: 12px;
    padding: 16px 20px;
    display: flex;
    align-items: center;
    gap: 12px;
  }
  .hero-land__stars {
    color: #d4a017;
    font-size: 16px;
    letter-spacing: 2px;
  }
  .hero-land__rating-num {
    font-weight: 700;
    font-size: 14px;
  }
  .hero-land__rating-count {
    opacity: 0.6;
    font-size: 12px;
  }

  /* ── Price card ── */
  .hero-land__price-card {
    background: #fff;
    border: 2px solid {{ section.settings.card_border_accent }};
    border-radius: 12px;
    padding: 24px 22px;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .hero-land__label {
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 1.5px;
    text-transform: uppercase;
    opacity: 0.5;
  }
  .hero-land__prices {
    display: flex;
    align-items: baseline;
    gap: 10px;
    flex-wrap: wrap;
  }
  .hero-land__old-price {
    font-size: 16px;
    text-decoration: line-through;
    opacity: 0.45;
  }
  .hero-land__new-price {
    font-size: clamp(30px, 4vw, 40px);
    font-weight: 700;
  }
  .hero-land__savings {
    font-size: 14px;
    font-weight: 600;
    color: {{ section.settings.savings_color }};
  }

  /* ── CTA ── */
  .hero-land__cta {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    width: 100%;
    background: {{ section.settings.cta_color }};
    color: #fff;
    font-size: 17px;
    font-weight: 700;
    padding: 16px 24px;
    border-radius: 50px;
    border: none;
    cursor: pointer;
    text-decoration: none;
    transition: opacity 0.2s;
    margin-top: 4px;
    font-family: inherit;
  }
  .hero-land__cta:hover {
    opacity: 0.9;
  }
  .hero-land__cta[aria-busy="true"] {
    pointer-events: none;
    opacity: 0.6;
  }

  /* ── Trust ── */
  .hero-land__trust {
    display: flex;
    flex-wrap: wrap;
    gap: 4px 18px;
    margin-top: 4px;
  }
  .hero-land__trust-item {
    font-size: 12px;
    opacity: 0.6;
  }
  .hero-land__trust-item::before {
    content: '✓ ';
    font-weight: 700;
    color: {{ section.settings.accent_color }};
  }

  @media (max-width: 768px) {
    .hero-land {
      padding: 24px 14px 28px;
    }
    .hero-land__badge {
      font-size: 10px;
      padding: 4px 14px;
      margin-bottom: 10px;
    }
    .hero-land__heading {
      font-size: 28px;
      margin-bottom: 10px;
    }
    .hero-land__desc {
      font-size: 13px;
      margin-bottom: 20px;
    }
    .hero-land__columns {
      flex-direction: column;
      gap: 20px;
    }
    .hero-land__col-card {
      flex: none;
      width: 100%;
    }
    .hero-land__rating {
      padding: 12px 16px;
    }
    .hero-land__price-card {
      padding: 18px 16px;
    }
    .hero-land__new-price {
      font-size: 28px;
    }
    .hero-land__cta {
      font-size: 15px;
      padding: 14px 20px;
    }
    .hero-land__trust {
      gap: 2px 14px;
    }
    .hero-land__trust-item {
      font-size: 11px;
    }
  }
</style>

<div class="hero-land">
  <div class="hero-land__inner">
    {% if section.settings.badge_text != blank %}
      <span class="hero-land__badge">{{ section.settings.badge_text }}</span>
    {% endif %}

    <h2 class="hero-land__heading">{{ section.settings.heading }}</h2>

    {% if section.settings.description != blank %}
      <p class="hero-land__desc">{{ section.settings.description }}</p>
    {% endif %}

    <div class="hero-land__columns">
      <div class="hero-land__col-img">
        {% if section.settings.image != blank %}
          <img
            src="{{ section.settings.image | image_url: width: 900 }}"
            alt="{{ section.settings.heading | strip_html }}"
            loading="lazy"
            width="900"
            height="600"
          >
        {% endif %}
      </div>

      <div class="hero-land__col-card">
        <!-- Rating -->
        <div class="hero-land__rating">
          <div class="hero-land__stars">★★★★★</div>
          <div>
            <div class="hero-land__rating-num">{{ section.settings.rating_number }}</div>
            <div class="hero-land__rating-count">{{ section.settings.rating_count }}</div>
          </div>
        </div>

        <!-- Price card -->
        <div class="hero-land__price-card">
          {% if section.settings.price_label != blank %}
            <div class="hero-land__label">{{ section.settings.price_label }}</div>
          {% endif %}
          <div class="hero-land__prices">
            {% if section.settings.old_price != blank %}
              <span class="hero-land__old-price">{{ section.settings.old_price }}</span>
            {% endif %}
            <span class="hero-land__new-price">{{ section.settings.new_price }}</span>
          </div>
          {% if section.settings.savings_text != blank %}
            <div class="hero-land__savings">{{ section.settings.savings_text }}</div>
          {% endif %}

          <!-- CTA -->
          {% if section.settings.product != blank %}
            {%- assign lp = section.settings.product -%}
            <button
              type="button"
              class="hero-land__cta"
              id="hero-land-cta-{{ section.id }}"
              data-vid="{{ lp.selected_or_first_available_variant.id }}"
              {% unless lp.available %}disabled{% endunless %}
            >
              {{ section.settings.cta_text }}
            </button>
          {% else %}
            <a href="{{ section.settings.cta_url }}" class="hero-land__cta">
              {{ section.settings.cta_text }}
            </a>
          {% endif %}

          {% if section.blocks.size > 0 %}
            <div class="hero-land__trust">
              {% for block in section.blocks %}
                <span class="hero-land__trust-item" {{ block.shopify_attributes }}>{{ block.settings.text }}</span>
              {% endfor %}
            </div>
          {% endif %}
        </div>
      </div>
    </div>
  </div>
</div>

{% if section.settings.product != blank %}
<script>
(function() {
  var btn = document.getElementById('hero-land-cta-{{ section.id }}');
  if (!btn) return;

  btn.addEventListener('click', function() {
    if (btn.hasAttribute('disabled')) return;
    if (btn.getAttribute('aria-busy') === 'true') return;

    var vid = btn.getAttribute('data-vid');
    if (!vid) return;

    btn.setAttribute('aria-busy', 'true');
    var origText = btn.textContent;
    btn.textContent = 'Wird hinzugefügt...';

    fetch('/cart/add.js', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ items: [{ id: parseInt(vid), quantity: 1 }] })
    })
    .then(function(res) {
      if (!res.ok) throw new Error('Cart error ' + res.status);
      return res.json();
    })
    .then(function() {
      window.location.href = '/cart';
    })
    .catch(function(err) {
      console.error('Add to cart failed:', err);
      btn.textContent = 'Fehler – erneut versuchen';
      setTimeout(function() {
        btn.removeAttribute('aria-busy');
        btn.textContent = origText;
      }, 2000);
    });
  });
})();
</script>
{% endif %}

