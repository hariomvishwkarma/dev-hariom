{% comment %}
  Hero Section – "Abnehmen, aber machbar."
  Precon-Style: Badge · Split-Headline · Subtext · 2 CTAs · Trust-Bar
{% endcomment %}

{%- assign trust_alpha = section.settings.trust_bar_opacity | divided_by: 100.0 -%}
{%- assign trust_bg = section.settings.trust_bar_color | color_modify: 'alpha', trust_alpha -%}
{% assign badge_opacity = section.settings.badge_opacity | divided_by: 100.0 | round: 2 %}
{%- assign overlay_alpha = section.settings.overlay_start_opacity | divided_by: 100.0 -%}
{%- assign overlay_start = section.settings.overlay_color | color_modify: 'alpha', overlay_alpha -%}

{%  if section.settings.show_market == 'ALL' or section.settings.show_market == localization.country.iso_code %}
  {% assign show_banner = true %}
{% else %}
  {% assign show_banner = false %}
{% endif %}

{% if show_banner %}
<style>
  .section-{{ section.id }} .hero-section__btn:hover { 
    opacity: 0.85; 
  }
  .section-{{ section.id }} .hero-section__bg--mobile { 
    display: none; 
    position: absolute;
    inset: 0;
    background-image: url('{{ section.settings.mobile_background_image | image_url: width: 800 }}');
    background-size: cover;
    background-position: {{ section.settings.mobile_bg_position }};
    z-index: 0;
  }
  .section-{{ section.id }} .hero-section__bg--desktop{
    position: absolute;
    inset: 0;
    background-image: url('{{ section.settings.background_image | image_url: width: 1800 }}');
    background-size: cover;
    background-position: {{ section.settings.bg_position }};
    z-index: 0;
  }
  .section-{{ section.id }} .hero-section__overlay{
    position: absolute;
    inset: 0;
    background: linear-gradient( to right, {{ overlay_start }} 0%, {{ overlay_start }} {{ section.settings.overlay_solid_stop }}%, transparent {{ section.settings.overlay_fade_stop }}%);
    z-index: 1;
  }
  .section-{{ section.id }} .hero-section{
    position: relative;
    overflow: hidden;
    min-height: {{ section.settings.min_height }}px;
    display: flex;
    flex-direction: column;
    justify-content: center;
  }
  .section-{{ section.id }} .hero-section__inner{
    position: relative;
    z-index: 2;
    max-width: {{ section.settings.content_max_width }}px;
    padding: 64px 48px 0px 0;
  }
  .section-{{ section.id }} .hero-section__trust-bar{
    position: relative;
    z-index: 2;
    background: {{ trust_bg }};
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    border-top: 1px solid {{ section.settings.trust_bar_color | color_modify: 'alpha', 0.25 }};
    padding: 14px 48px;
    margin-bottom:{{ section.settings.space_bottom }}px;
    margin-top:{{ section.settings.space_top }}px;
  }
  .section-{{ section.id }} .hero-section__headline{
    font-size: clamp(40px, 6vw, 78px);
    font-weight: 400;
    line-height: 1.1;
    color: {{ section.settings.headline_color }};
    margin: 0 0 28px;
  }
  .section-{{ section.id }} .hero-section__subtext{
    font-size: clamp(15px, 1.6vw, 20px);
    line-height: 1.6;
    color: {{ section.settings.subtext_color }};
    max-width: 560px;
    margin: 0 0 38px;
  }
  .section-{{ section.id }} .hero-section__trust-flex{
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 6px 24px;
  }
  .section-{{ section.id }} .hero-section__badge{
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: {{ section.settings.badge_bg | color_modify: 'alpha', badge_opacity }};
    backdrop-filter: blur({{ section.settings.badge_blur_effect }}px);
    -webkit-backdrop-filter: blur({{ section.settings.badge_blur_effect }}px);
    border: 1px solid rgba(255, 255, 255, 0.45);
    color: {{ section.settings.badge_text_color }};
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    padding: 8px 18px;
    border-radius: 10px;
    margin-bottom: 24px;
  }
  .section-{{ section.id }} .hero-section__trust_child{
    display: flex;
    align-items: center;
    gap: 6px;
    color: {{ section.settings.trust_stars_color }};
    font-size: 14px;
    font-weight: 600;
  }

  @media (max-width:767px){
    .section-{{ section.id }} .hero-section__inner{
      padding: 48px 0px 0px;
    }
    .section-{{ section.id }} .hero-section__bg--desktop { 
      display: none; 
    }
    .section-{{ section.id }} .hero-section__bg--mobile { 
      display: block; 
    }
    .section-{{ section.id }} .hero-section{
      min-height: {{ section.settings.min_height_m }}px;
    }
    .section-{{ section.id }} .hero-section__trust-bar{
      margin-top:{{ section.settings.space_top_m }}px;
      margin-bottom:{{ section.settings.space_bottom_m }}px;
    }
    .section-{{ section.id }} .hero-section__trust_child{
      gap: 3px;
    }
    .section-{{ section.id }} .hero-section__headline{
      margin: 0 0 20px;
    }
    .section-{{ section.id }} .hero-section__subtext{
      margin: 0 0 35px;
    }
    .section-{{ section.id }} .hero-section__trust-flex{
      gap: 4px;
    }
  }
</style>

<div class="section-{{ section.id }}">
<section class="hero-section">

  {%- comment -%} Background Image Desktop {%- endcomment -%}
  {%- if section.settings.background_image != blank -%}
    <div class="hero-section__bg hero-section__bg--desktop"></div>
  {%- endif -%}

  {%- comment -%} Background Image Mobile {%- endcomment -%}
  {%- if section.settings.mobile_background_image != blank -%}
    <div class="hero-section__bg hero-section__bg--mobile"></div>
  {%- endif -%}

  {%- comment -%} Gradient Overlay (links opak → rechts transparent) {%- endcomment -%}
  <div class="hero-section__overlay"></div>

  {%- comment -%} Content {%- endcomment -%}
   <div class="container">
    <div class="hero-section__inner">

      {%- comment -%} Badge {%- endcomment -%}
      {%- if section.settings.badge_text != blank -%}
        <div class="hero-section__badge">
          <span style="font-size: 14px; line-height: 1;">✦</span>
          {{ section.settings.badge_text }}
        </div>
      {%- endif -%}

      {%- comment -%} Headline {%- endcomment -%}
      <h1 class="hero-section__headline">
        {%- if section.settings.headline_line1 != blank -%}
          <span class="hero-section__headline-line1" style="display: block; font-weight: 400; font-style: normal;">
            {{ section.settings.headline_line1 }}
          </span>
        {%- endif -%}
        {%- if section.settings.headline_line2 != blank -%}
          <span class="hero-section__headline-line2" style="display: block; font-weight: 400; font-family: var(--accent-font-family); font-style: var(--accent-font-style);">
            {{ section.settings.headline_line2 }}
          </span>
        {%- endif -%}
      </h1>

      {%- comment -%} Subtext {%- endcomment -%}
      {%- if section.settings.subtext != blank -%}
        <p class="hero-section__subtext">
          {{ section.settings.subtext }}
        </p>
      {%- endif -%}

      {%- comment -%} Buttons {%- endcomment -%}
      <div class="hero-section__buttons" style="display: flex; flex-wrap: wrap; gap: 14px; align-items: center;">

        {%- if section.settings.btn_primary_label != blank -%}
          <a
            href="{{ section.settings.btn_primary_url }}"
            class="hero-section__btn hero-section__btn--primary"
            style="
              display: inline-block;
              background: {{ section.settings.btn_primary_bg }};
              color: {{ section.settings.btn_primary_color }};
              font-size: 15px;
              font-weight: 600;
              padding: 14px 28px;
              border-radius: 50px;
              text-decoration: none;
              border: 2px solid {{ section.settings.btn_primary_bg }};
              transition: opacity 0.2s;
            "
          >
            {{ section.settings.btn_primary_label }}
          </a>
        {%- endif -%}

        {%- if section.settings.btn_secondary_label != blank -%}
          <a
            href="{{ section.settings.btn_secondary_url }}"
            class="hero-section__btn hero-section__btn--secondary"
            style="
              display: inline-block;
              {%- assign btn2_bg_alpha = section.settings.btn_secondary_bg_opacity | divided_by: 100.0 -%}
              background: {{ section.settings.btn_secondary_glass_color | color_modify: 'alpha', btn2_bg_alpha }};
              backdrop-filter: blur({{ section.settings.secondary_blur_effect }}px);
              -webkit-backdrop-filter: blur({{ section.settings.secondary_blur_effect }}px);
              color: {{ section.settings.btn_secondary_color }};
              font-size: 15px;
              font-weight: 600;
              padding: 14px 28px;
              border-radius: 50px;
              text-decoration: none;
              border: 1.5px solid {{ section.settings.btn_secondary_glass_color | color_modify: 'alpha', 0.5 }};
              transition: opacity 0.2s;
            "
          >
            {{ section.settings.btn_secondary_label }}
          </a>
        {%- endif -%}

      </div>

    </div>
  </div>

  {%- comment -%} Trust Bar {%- endcomment -%}
  {%- if section.settings.show_trust_bar -%}
    <div class="hero-section__trust-bar">
    <div class="container">
      <div class="hero-section__trust-flex">
          <span class="hero-section__trust_child">
            {%- for i in (1..5) -%}★{%- endfor -%}
            <span style="color: {{ section.settings.trust_text_color }};">{{ section.settings.trust_rating }}</span>
          </span>

          {%- for block in section.blocks -%}
            {%- if block.type == 'trust_item' -%}
              <span class="trust-dot" style="color: {{ section.settings.trust_text_color }}; font-size: 14px;">·</span>
              <span style="color: {{ section.settings.trust_text_color }}; font-size: 14px;">{{ block.settings.text }}</span>
            {%- endif -%}
          {%- endfor -%}
      </div>
    </div>

    </div>
  {%- endif -%}

</section>
</div>

{%- comment -%} Hover-Effekte via inline style tag {%- endcomment -%}
<style>
  @media (max-width: 640px) {
    .section-{{ section.id }} .hero-section__trust-bar {
      padding: 10px 0px;
      flex-wrap: nowrap !important;
      overflow-x: visible;
      justify-content: center;
      gap: 0 6px !important;
    }
    .section-{{ section.id }} .hero-section__trust-bar span {
      font-size: 10px !important;
      white-space: nowrap;
      flex-shrink: 0;
      letter-spacing: -0.01em;
    }
    .section-{{ section.id }} .hero-section__buttons {
      flex-direction: column;
      align-items: flex-start !important;
    }
  }
</style>

{% endif %}

{% schema %}
{
  "name": "Hero Banner v2",
  "tag": "section",
  "class": "hero-banner-section-main",
  "settings": [
    {
      "type": "select",
      "id":"show_market",
      "label": "Show only market",
      "options": [
        {
          "value": "DE",
          "label": "DE"
        },
        {
          "value": "CH",
          "label": "CH"
        },
        {
          "value": "ALL",
          "label": "ALL"
        }
      ],
      "default":"ALL"
    },
    {
      "type": "header",
      "content": "Image & Overlay"
    },
    {
      "type": "image_picker",
      "id": "background_image",
      "label": "Background image"
    },
    {
      "type": "select",
      "id": "bg_position",
      "label": "Image Orientation",
      "options": [
        { "value": "center center", "label": "Mitte" },
        { "value": "center top",    "label": "Oben" },
        { "value": "right center",  "label": "Rechts" },
        { "value": "left center",   "label": "Links" }
      ],
      "default": "right center"
    },
    {
      "type": "image_picker",
      "id": "mobile_background_image",
      "label": "Background image (Mobile)"
    },
    {
      "type": "select",
      "id": "mobile_bg_position",
      "label": "Image Orientation (Mobile)",
      "options": [
        { "value": "center center", "label": "Mitte" },
        { "value": "center top",    "label": "Oben" },
        { "value": "right center",  "label": "Rechts" },
        { "value": "left center",   "label": "Links" }
      ],
      "default": "center center"
    },
    {
      "type": "color",
      "id": "overlay_color",
      "label": "Gradient Color (left)",
      "default": "#f5f0eb"
    },
    {
      "type": "range",
      "id": "overlay_start_opacity",
      "label": "Left-side cover power (%)",
      "min": 10,
      "max": 90,
      "step": 5,
      "default": 65
    },
    {
      "type": "range",
      "id": "overlay_solid_stop",
      "label": "Full color up to (% from the left)",
      "min": 10,
      "max": 60,
      "step": 5,
      "default": 30
    },
    {
      "type": "range",
      "id": "overlay_fade_stop",
      "label": "Completely transparent, starting from (% from the left)",
      "min": 30,
      "max": 90,
      "step": 5,
      "default": 65
    },
    {
      "type": "range",
      "id": "min_height",
      "label": "Minimum height (px)",
      "min": 400,
      "max": 1200,
      "step": 10,
      "default": 600
    },
    {
      "type": "range",
      "id": "min_height_m",
      "label": "Minimum height (px) - Mobile",
      "min": 400,
      "max": 1200,
      "step": 10,
      "default": 600
    },
    {
      "type": "range",
      "id": "content_max_width",
      "label": "Content Width (px)",
      "min": 400,
      "max": 900,
      "step": 50,
      "default": 650
    },
    {
      "type": "header",
      "content": "Badge"
    },
    {
      "type": "text",
      "id": "badge_text",
      "label": "Badge-Text",
      "default": "39 Jahre Abnehmexpertise"
    },
    {
      "type": "color",
      "id": "badge_text_color",
      "label": "Text Color",
      "default":"#fff"
    },
    {
      "type": "color",
      "id": "badge_bg",
      "label": "Background",
      "default":"#fff"
    },
    {
      "type": "range",
      "id": "badge_blur_effect",
      "label": "Blur Effect",
      "min": 0,
      "max": 20,
      "step": 1,
      "default": 10
    },
    {
      "type": "range",
      "id": "badge_opacity",
      "label": "Background Opacity",
      "min": 0,
      "max": 100,
      "step": 1,
      "default": 12
    },
    {
      "type": "header",
      "content": "Headline"
    },
    {
      "type": "text",
      "id": "headline_line1",
      "label": "Line 1 (normal)",
      "default": "Abnehmen,"
    },
    {
      "type": "text",
      "id": "headline_line2",
      "label": "Line 2 (kursiv)",
      "default": "aber machbar."
    },
    {
      "type": "color",
      "id": "headline_color",
      "label": "Headline-Color",
      "default": "#1a1a1a"
    },
    {
      "type": "header",
      "content": "Subtext"
    },
    {
      "type": "textarea",
      "id": "subtext",
      "label": "Subtext",
      "default": "Das Precon-Konzept: 3 klare Phasen, die Deine Abnehmreise alltagstauglich und erfolgreich machen."
    },
    {
      "type": "color",
      "id": "subtext_color",
      "label": "Subtext-Color",
      "default": "#333333"
    },
    {
      "type": "header",
      "content": "Button Primär"
    },
    {
      "type": "text",
      "id": "btn_primary_label",
      "label": "Button-Text",
      "default": "Zum 4-Wochen-Paket"
    },
    {
      "type": "url",
      "id": "btn_primary_url",
      "label": "Button-Link"
    },
    {
      "type": "color",
      "id": "btn_primary_bg",
      "label": "Hintergrundfarbe",
      "default": "#2aacb0"
    },
    {
      "type": "color",
      "id": "btn_primary_color",
      "label": "Textfarbe",
      "default": "#ffffff"
    },
    {
      "type": "header",
      "content": "Secondary Button"
    },
    {
      "type": "text",
      "id": "btn_secondary_label",
      "label": "Button-Text",
      "default": "So begleiten wir Dich 🎬"
    },
    {
      "type": "url",
      "id": "btn_secondary_url",
      "label": "Button-Link"
    },
    {
      "type": "color",
      "id": "btn_secondary_color",
      "label": "Text Color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "btn_secondary_glass_color",
      "label": "Glass & Frame Color",
      "default": "#ffffff"
    },
    {
      "type": "range",
      "id": "secondary_blur_effect",
      "label": "Blur Effect",
      "min": 0,
      "max": 20,
      "step": 1,
      "default": 5
    },
    {
      "type": "range",
      "id": "btn_secondary_bg_opacity",
      "label": "Background Opacity (%)",
      "min": 0,
      "max": 80,
      "step": 5,
      "default": 15
    },
    {
      "type": "header",
      "content": "Trust-Bar"
    },
    {
      "type": "checkbox",
      "id": "show_trust_bar",
      "label": "Show Trust Bar",
      "default": true
    },
    {
      "type": "color",
      "id": "trust_bar_color",
      "label": "Trust-Bar Farbe",
      "default": "#2aacb0"
    },
    {
      "type": "range",
      "id": "trust_bar_opacity",
      "label": "Trust-Bar Opacity (%)",
      "min": 5,
      "max": 80,
      "step": 5,
      "default": 35
    },
    {
      "type": "color",
      "id": "trust_stars_color",
      "label": "Sterne-Color",
      "default": "#f5a623"
    },
    {
      "type": "color",
      "id": "trust_text_color",
      "label": "Text Color",
      "default": "#444444"
    },
    {
      "type": "text",
      "id": "trust_rating",
      "label": "Rating (e.g., 4.8 / 5)",
      "default": "4,8 / 5"
    },
    {
      "type": "range",
      "id": "space_top",
      "label": "Spacing Top",
      "min": 0,
      "max": 200,
      "step": 5,
      "default": 40
    },
    {
      "type": "range",
      "id": "space_bottom",
      "label": "Spacing Bottom",
      "min": 0,
      "max": 200,
      "step": 5,
      "default": 40
    },
    {
      "type": "range",
      "id": "space_top_m",
      "label": "Spacing Top (Mobile)",
      "min": 0,
      "max": 100,
      "step": 1,
      "default": 56
    },
    {
      "type": "range",
      "id": "space_bottom_m",
      "label": "Spacing Bottom (Mobile)",
      "min": 0,
      "max": 100,
      "step": 1,
      "default": 20
    },
  ],
  "blocks": [
    {
      "type": "trust_item",
      "name": "Trust-Punkt",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "default": "Über 40 Jahre Erfahrung"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Hero Banner v2",
      "blocks": [
        { "type": "trust_item", "settings": { "text": "Über 40 Jahre Erfahrung" } },
        { "type": "trust_item", "settings": { "text": "Persönliche Beratung" } }
      ]
