      "label": "Background Color",
      "default": "#EFECE4"
    },
    {
      "type": "text",
      "id": "headingnewsletter",
      "label": "Heading"
    },

    {
      "type": "richtext",
      "id": "descriptionnewsletter",
      "label": "Description"
    },

    {
      "type": "image_picker",
      "id": "img_news",
      "label": "Banner Image"
    },
    {
      "type": "text",
      "id": "form_id_de",
      "label": "Form Id DE"
    },
    {
      "type": "text",
      "id": "form_id_ch",
      "label": "Form Id CH"
    },
    {
      "type": "text",
      "id": "form_id_at",
      "label": "Form Id AT"
    },
    {
      "type": "text",
      "id": "form_id_eu",
      "label": "Form Id EU"
    }
  ],

  "presets": [
    {
      "name": "Newsletter Section"
    }
  ]
}
{% endschema %}
