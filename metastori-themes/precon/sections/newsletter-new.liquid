<div class="newsletter-sec" style="background:{{ section.settings.background_color_newletter }}">
  <div class="inner-newsletter">
    <div class="text-section">
      <div class="inner-text-content">
        <!--
          <h2>{{ section.settings.headingnewsletter }}</h2>
          <p>{{ section.settings.descriptionnewsletter }}</p>
        -->
        {% comment %} <div id="hubspot-form-wrapper"></div> {% endcomment %}

        <div id="hubspot-form"></div>

        <script>
          document.addEventListener('DOMContentLoaded', function () {
            const hostname = window.location.hostname;
            let formHtml = '';

            if (hostname.includes('precon.de')) {
              // alert("You are on DE domain");
              formHtml =
                '<div class="hs-form-frame" data-region="na1" data-form-id="{{ section.settings.form_id_de }}" data-portal-id="5091842"></div> ';
            } else if (hostname.includes('precon.at')) {
              //alert("You are on AT domain");
              formHtml =
                '<div class="hs-form-frame" data-region="na1" data-form-id="{{ section.settings.form_id_at }}" data-portal-id="5091842"></div> ';
            } else if (hostname.includes('precon.ch')) {
              //alert("You are on CH domain");
              formHtml =
                '<div class="hs-form-frame" data-region="na1" data-form-id="{{ section.settings.form_id_ch }}" data-portal-id="5091842"></div>';
            } else if (hostname.includes('precon.eu')) {
              //alert("You are on EU domain");
              formHtml =
                '<div class="hs-form-frame" data-region="na1" data-form-id="{{ section.settings.form_id_eu }}" data-portal-id="5091842"></div>';
            } else {
              {% comment %} alert('Domain not recognized'); {% endcomment %}
               formHtml =
                '<div class="hs-form-frame" data-region="na1" data-form-id="{{ section.settings.form_id_de }}" data-portal-id="5091842"></div> ';
            }

            if (formHtml) {
              document.getElementById('hubspot-form').innerHTML = formHtml;

              // Load HubSpot embed script after injecting the div
              const script = document.createElement('script');
              script.src = 'https://js.hsforms.net/forms/embed/5091842.js';
              script.defer = true;
              document.body.appendChild(script);
            }
          });
        </script>
      </div>
    </div>
    <div class="image-right">
      <img src="{{ section.settings.img_news | img_url:'master' }}">
    </div>
  </div>
</div>

<style>

      .inner-newsletter {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
  }

  .image-right,
  .text-section {
    width: 50%;
    padding: ;
  }

  .image-right img {
    width: 100%;
    height: auto;
    display: block;
  }
  .inner-newsletter{
    width: 100%;
  }
  .text-section h2{
  font-size: 36px;
  font-style: normal;
  font-weight: 500;
  line-height: normal;
  color:#290907;
  }
  .text-section p{
  font-size: 16px;
  font-style: normal;
  font-weight: 500;
  line-height: 24px;
  color:#290907
  }
  .inner-text-content {
      max-width: 748px;
      margin: 0 auto;
      {% comment %} padding-left: 250px; {% endcomment %}
  }

  @media (max-width: 767px) {
    .image-right,
    .text-section {
      width: 100%;
      text-align: center;
    }

    .inner-newsletter {
      flex-direction: column;
    }
    .inner-text-content {
      {% comment %} padding: 32px 16px; {% endcomment %}
      text-align: left;
  }
  .text-section h2{
  font-size: 32px;}
  .text-section {
      order: 2;
  }
  }
</style>

<script>
  {% comment %} document.addEventListener("DOMContentLoaded", function () {
    const hostname = window.location.hostname;
    alert("You are on domain: " + hostname);
  }); {% endcomment %}
</script>

{% comment %}
  <script>

    // Load IP geolocation
    fetch('https://ipapi.co/json/')
      .then(response => response.json())
      .then(data => {
        const countryCode = data.country; // e.g., "DE", "AT", "CH"
        const formWrapper = document.getElementById('hubspot-form-wrapper');

        // Map country code to HubSpot form ID
        const formMap = {
          DE: '3aa59ee6-0325-4cbe-a703-7222031c13a6',
          AT: '26fca617-73f3-4f7b-8ed5-af2cf6b132ba',
          CH: '77cea286-8235-42a2-9910-024d23791538',


        };

        const formId = formMap[countryCode];

        if (formId) {
          const portalId = '5091842';
          const region = 'na1';

          // Load HubSpot script dynamically (guaranteed load)
          const script = document.createElement('script');
          script.src = 'https://js.hsforms.net/forms/v2.js';
          script.onload = function () {
            if (window.hbspt) {
              hbspt.forms.create({
                region: region,
                portalId: portalId,
                formId: formId,
                target: '#hubspot-form-wrapper'
              });
            }
          };
          document.head.appendChild(script);
        } else {
          formWrapper.innerHTML = 'Form not available in your region.';
        }
      })
      .catch(error => {
        console.error('IP lookup failed:', error);
        document.getElementById('hubspot-form-wrapper').innerHTML = 'Unable to load form.';
      });
  </script>
{% endcomment %}

