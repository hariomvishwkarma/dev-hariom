{%- comment -%}
  sections/faq-section.liquid
  FAQ-Akkordeon: Eyebrow / Heading / klappbare Frage-Antwort-Blöcke
  Eyebrow-Stil identisch zu kennst-du-das, warum-das-wichtig, usp-konzept, phasenplan, abschnitt-header
  Fonts: Figtree 300/400/600 + Playfair Display 500 italic
{%- endcomment -%}

{%- liquid
  assign c_bg       = section.settings.color_bg
  assign c_ink      = section.settings.color_ink
  assign c_mid      = section.settings.color_mid
  assign c_accent   = section.settings.color_accent
  assign c_card_bg  = section.settings.color_card_bg
  assign c_border   = section.settings.color_border
  assign pt         = section.settings.padding_top
  assign pb         = section.settings.padding_bottom
-%}

<div id="faq-{{ section.id }}" class="faq" style="padding-top: {{ pt }}px; padding-bottom: {{ pb }}px;">
  <div class="faq__inner">

    {%- if section.settings.eyebrow != blank -%}
      <p class="faq__eyebrow">
        <span class="faq__eyebrow-rule"></span>
        {{ section.settings.eyebrow }}
        <span class="faq__eyebrow-rule"></span>
      </p>
    {%- endif -%}

    {%- if section.settings.heading != blank -%}
      <h2 class="faq__heading">{{ section.settings.heading }}</h2>
    {%- endif -%}

    {%- if section.blocks.size > 0 -%}
      <div class="faq__list">
        {%- for block in section.blocks -%}
          <div class="faq__item" {{ block.shopify_attributes }}>
            <button class="faq__question" aria-expanded="false" aria-controls="faq-answer-{{ section.id }}-{{ forloop.index }}">
              <span class="faq__question-text">{{ block.settings.question }}</span>
              <span class="faq__icon" aria-hidden="true">
                <svg width="16" height="16" viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg">
                  <line x1="8" y1="1" x2="8" y2="15" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
                  <line x1="1" y1="8" x2="15" y2="8" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
                </svg>
              </span>
            </button>
            <div class="faq__answer" id="faq-answer-{{ section.id }}-{{ forloop.index }}">
              <div class="faq__answer-inner">{{ block.settings.answer }}</div>
            </div>
          </div>
        {%- endfor -%}
      </div>
      <div class="faq__mobile-spacer" aria-hidden="true"></div>
    {%- endif -%}

  </div>
</div>

<style>
@import url('https://fonts.googleapis.com/css2?family=Figtree:wght@300;400;600&family=Playfair+Display:ital,wght@1,500&display=swap');

#faq-{{ section.id }} {
  --bg:        {{ c_bg }};
  --ink:       {{ c_ink }};
  --mid:       {{ c_mid }};
  --accent:    {{ c_accent }};
  --card-bg:   {{ c_card_bg }};
  --border:    {{ c_border }};
}

#faq-{{ section.id }},
#faq-{{ section.id }} * { box-sizing: border-box; }

#faq-{{ section.id }} {
  background: var(--bg);
  font-family: 'Figtree', sans-serif;
  -webkit-font-smoothing: antialiased;
  padding-left: 1.5rem;
  padding-right: 1.5rem;
}

/* ── Inner ── */
#faq-{{ section.id }} .faq__inner {
  max-width: 720px;
  margin: 0 auto;
  text-align: center;
}

/* ── Eyebrow ── */
#faq-{{ section.id }} .faq__eyebrow {
  display: inline-flex;
  align-items: center;
  gap: 10px;
  font-size: 11px;
  font-weight: 600;
  letter-spacing: 0.24em;
  text-transform: uppercase;
  color: var(--accent);
  margin-bottom: 1rem;
}

#faq-{{ section.id }} .faq__eyebrow-rule {
  display: block;
  width: 22px;
  height: 1px;
  background: currentColor;
  opacity: 0.45;
  flex-shrink: 0;
}

/* ── Heading ── */
#faq-{{ section.id }} .faq__heading {
  font-size: clamp(32px, 4vw, 52px);
  font-weight: 300;
  color: var(--ink);
  line-height: 1.06;
  letter-spacing: -0.026em;
  text-wrap: balance;
  margin-bottom: 2.5rem;
}

#faq-{{ section.id }} .faq__heading em {
  font-family: 'Playfair Display', serif;
  font-style: italic;
  font-weight: 500;
  letter-spacing: -0.02em;
}

/* ── List ── */
#faq-{{ section.id }} .faq__list {
  display: flex;
  flex-direction: column;
  gap: 10px;
  text-align: left;
}

/* ── Item ── */
#faq-{{ section.id }} .faq__item {
  background: var(--card-bg);
  border: 1px solid var(--border);
  border-radius: 12px;
  overflow: hidden;
}

/* ── Question button ── */
#faq-{{ section.id }} .faq__question {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 1rem;
  width: 100%;
  background: none;
  border: none;
  cursor: pointer;
  padding: 20px 24px;
  text-align: left;
  font-family: 'Figtree', sans-serif;
  font-size: 15.5px;
  font-weight: 400;
  color: var(--ink);
  line-height: 1.5;
  transition: color 0.2s;
}

#faq-{{ section.id }} .faq__question:hover {
  color: var(--accent);
}

/* ── Icon ── */
#faq-{{ section.id }} .faq__icon {
  flex-shrink: 0;
  width: 20px;
  height: 20px;
  color: var(--accent);
  transition: transform 0.3s ease;
  display: flex;
  align-items: center;
  justify-content: center;
}

#faq-{{ section.id }} .faq__question[aria-expanded="true"] .faq__icon {
  transform: rotate(45deg);
}

/* ── Answer ── */
#faq-{{ section.id }} .faq__answer {
  max-height: 0;
  overflow: hidden;
  transition: max-height 0.35s ease;
}

#faq-{{ section.id }} .faq__answer-inner {
  padding: 0 24px 20px;
  font-size: 15px;
  line-height: 1.8;
  color: var(--mid);
}

/* ── Richtext content (p-tags aus Shopify richtext) ── */
#faq-{{ section.id }} .faq__answer-inner p { margin: 0; }
#faq-{{ section.id }} .faq__answer-inner p + p { margin-top: 0.75em; }

/* ── Responsive ── */
@media (max-width: 560px) {
  #faq-{{ section.id }} {
    padding-left: 1rem;
    padding-right: 1rem;
    padding-bottom: 1.5rem !important;
  }
  #faq-{{ section.id }} .faq__item {
    margin-left: 1.5rem;
    margin-right: 1.5rem;
  }
  #faq-{{ section.id }} .faq__mobile-spacer { height: 12px; }
  #faq-{{ section.id }} .faq__question { padding: 16px; }
  #faq-{{ section.id }} .faq__answer-inner { padding: 0 16px 16px; }
  #faq-{{ section.id }} .faq__item:last-child {
    border-bottom-left-radius: 0;
    border-bottom-right-radius: 0;
  }
}
</style>

<script>
(function() {
  var section = document.getElementById('faq-{{ section.id }}');
  if (!section) return;
  section.querySelectorAll('.faq__question').forEach(function(btn) {
    btn.addEventListener('click', function() {
      var expanded = this.getAttribute('aria-expanded') === 'true';
      this.setAttribute('aria-expanded', String(!expanded));
      var answer = this.closest('.faq__item').querySelector('.faq__answer');
      answer.style.maxHeight = expanded ? '0' : answer.scrollHeight + 'px';
    });
  });
})();
</script>

{% schema %}
{
  "name": "FAQ",
  "tag": "section",
  "settings": [
    { "type": "header", "content": "Inhalt" },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Fragen"
    },
    {
      "type": "richtext",
      "id": "heading",
      "label": "Überschrift",
      "default": "<p>Häufig gefragt</p>"
    },
    { "type": "header", "content": "Abstände" },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Abstand oben",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Abstand unten",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 80
    },
    { "type": "header", "content": "Farben" },
    { "type": "color", "id": "color_bg",       "label": "Hintergrund Section",  "default": "#FAF9F5" },
    { "type": "color", "id": "color_card_bg",  "label": "Hintergrund Karte",    "default": "#FFFFFF" },
    { "type": "color", "id": "color_border",   "label": "Rahmenfarbe Karte",    "default": "#ECE8E1" },
    { "type": "color", "id": "color_ink",      "label": "Text Frage",           "default": "#56473A" },
    { "type": "color", "id": "color_mid",      "label": "Text Antwort",         "default": "#8C7C70" },
    { "type": "color", "id": "color_accent",   "label": "Akzentfarbe",          "default": "#3DADBB" }
  ],
  "blocks": [
    {
      "type": "faq_item",
      "name": "Frage & Antwort",
      "settings": [
        {
          "type": "text",
          "id": "question",
          "label": "Frage",
          "default": "Wie funktioniert das Precon-Konzept?"
        },
        {
          "type": "richtext",
          "id": "answer",
          "label": "Antwort",
          "default": "<p>Das Precon-Konzept besteht aus 3 Phasen: Startphase, Abnehmphase und Haltephase. Jede Phase hat klare Regeln und ein klares Ziel.</p>"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "FAQ",
      "blocks": [
        {
          "type": "faq_item",
          "settings": {
            "question": "Sind die Produkte vegetarisch/glutenfrei/laktosefrei?",
            "answer": "<p>Ja, alle Precon Produkte sind vegetarisch, glutenfrei und laktosefrei – ideal für Menschen mit Unverträglichkeiten.</p>"
          }
        },
        {
          "type": "faq_item",
          "settings": {
            "question": "Wo werden die Precon Produkte hergestellt?",
            "answer": "<p>Unsere Produkte werden in Deutschland entwickelt und produziert – nach höchsten Qualitäts- und Sicherheitsstandards.</p>"
          }
        },
        {
          "type": "faq_item",
          "settings": {
            "question": "Sind die Produkte im Paket auch einzeln erhältlich?",
            "answer": "<p>Ja, du kannst alle Produkte auch einzeln in unserem Shop bestellen – ganz ohne Paket-Bindung.</p>"
          }
        },
        {
          "type": "faq_item",
          "settings": {
            "question": "An wen wende ich mich bei Fragen zu einem Produkt des Pakets?",
            "answer": "<p>Unser Kundenservice ist per E-Mail und Chat erreichbar. Wir helfen dir schnell und unkompliziert weiter.</p>"
          }
        }
      ]
    }
  ]
}
{% endschema %}