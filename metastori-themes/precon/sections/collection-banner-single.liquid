{% comment %}
  Collection Banner – Single Collection
  – Nur auf Collection-Seiten verfügbar (templates: ["collection"])
  – Pflichtfeld: Collection-Handle → Banner erscheint NUR auf genau dieser Collection
  – Je ein Desktop- & Mobile-Bild pro Sprache (de, nl, fr, it, es)
  – Fallback: Deutsch, falls für aktuelle Sprache kein Bild hinterlegt
{% endcomment %}

{% comment %} ── Collection-Check ──────────────────────────────────────────── {% endcomment %}
{% assign target_handle = section.settings.collection_handle | downcase | strip %}

{% if target_handle == blank or target_handle != collection.handle %}
  {% comment %} Kein Handle eingetragen oder falsche Collection → nichts anzeigen {% endcomment %}
  {% assign show_banner = false %}
{% else %}
  {% assign show_banner = true %}
{% endif %}

{% comment %} ── Sprach-spezifische Bilder auswählen ───────────────────────── {% endcomment %}
{% if show_banner %}
  {% assign lang = localization.language.iso_code | downcase | slice: 0, 2 %}

  {% case lang %}
    {% when 'nl' %}
      {% assign img_desktop = section.settings.image_desktop_nl %}
      {% assign img_mobile  = section.settings.image_mobile_nl %}
    {% when 'fr' %}
      {% assign img_desktop = section.settings.image_desktop_fr %}
      {% assign img_mobile  = section.settings.image_mobile_fr %}
    {% when 'it' %}
      {% assign img_desktop = section.settings.image_desktop_it %}
      {% assign img_mobile  = section.settings.image_mobile_it %}
    {% when 'es' %}
      {% assign img_desktop = section.settings.image_desktop_es %}
      {% assign img_mobile  = section.settings.image_mobile_es %}
    {% else %}
      {% assign img_desktop = section.settings.image_desktop_de %}
      {% assign img_mobile  = section.settings.image_mobile_de %}
  {% endcase %}

  {% comment %} Fallback auf Deutsch {% endcomment %}
  {% if img_desktop == blank %}
    {% assign img_desktop = section.settings.image_desktop_de %}
  {% endif %}
  {% if img_mobile == blank %}
    {% assign img_mobile = section.settings.image_mobile_de %}
  {% endif %}
{% endif %}

{% comment %} ── Ausgabe ───────────────────────────────────────────────────── {% endcomment %}
{% if show_banner and img_desktop != blank or show_banner and img_mobile != blank %}
<div class="collection-banner-single">

  {% if img_desktop != blank %}
  <a
    {% if section.settings.link != blank %}href="{{ section.settings.link }}"{% endif %}
    class="collection-banner-single__link collection-banner-single__desktop"
    aria-label="{{ section.settings.alt_text | escape }}"
  >
    {{
      img_desktop
      | image_url: width: 2400
      | image_tag:
        loading: 'lazy',
        alt: section.settings.alt_text,
        sizes: '100vw',
        widths: '600, 900, 1200, 1600, 1920, 2400',
        class: 'collection-banner-single__img'
    }}
  </a>
  {% endif %}

  {% if img_mobile != blank %}
  <a
    {% if section.settings.link != blank %}href="{{ section.settings.link }}"{% endif %}
    class="collection-banner-single__link collection-banner-single__mobile"
    aria-label="{{ section.settings.alt_text | escape }}"
  >
    {{
      img_mobile
      | image_url: width: 1000
      | image_tag:
        loading: 'lazy',
        alt: section.settings.alt_text,
        sizes: '100vw',
        widths: '400, 600, 750, 900, 1000',
        class: 'collection-banner-single__img'
    }}
  </a>
  {% endif %}

</div>
{% endif %}

<style>
  .collection-banner-single { display: block; width: 100%; overflow: hidden; }
  .collection-banner-single__img { width: 100%; height: auto; display: block; }

  .collection-banner-single__desktop { display: none; }
  .collection-banner-single__mobile  { display: block; }

  @media (min-width: {{ section.settings.breakpoint }}px) {
    .collection-banner-single__desktop { display: block; }
    .collection-banner-single__mobile  { display: none; }
  }
</style>

{% schema %}
{
  "name": "Banner Single Collection",
  "tag": "section",
  "class": "section-collection-banner-single",
  "templates": ["collection"],
  "settings": [
    {
      "type": "header",
      "content": "Collection"
    },
    {
      "type": "text",
      "id": "collection_handle",
      "label": "Collection Handle (Pflichtfeld)",
      "placeholder": "meine-collection",
      "info": "Banner erscheint NUR auf dieser Collection. Den Handle siehst du in der URL: /collections/sale → Handle ist 'sale'."
    },
    {
      "type": "header",
      "content": "🇩🇪 Deutsch (DE) — auch Fallback für alle Sprachen"
    },
    {
      "type": "image_picker",
      "id": "image_desktop_de",
      "label": "Desktop-Bild DE"
    },
    {
      "type": "image_picker",
      "id": "image_mobile_de",
      "label": "Mobile-Bild DE"
    },
    {
      "type": "header",
      "content": "🇳🇱 Niederländisch (NL)"
    },
    {
      "type": "image_picker",
      "id": "image_desktop_nl",
      "label": "Desktop-Bild NL"
    },
    {
      "type": "image_picker",
      "id": "image_mobile_nl",
      "label": "Mobile-Bild NL"
    },
    {
      "type": "header",
      "content": "🇫🇷 Französisch (FR)"
    },
    {
      "type": "image_picker",
      "id": "image_desktop_fr",
      "label": "Desktop-Bild FR"
    },
    {
      "type": "image_picker",
      "id": "image_mobile_fr",
      "label": "Mobile-Bild FR"
    },
    {
      "type": "header",
      "content": "🇮🇹 Italienisch (IT)"
    },
    {
      "type": "image_picker",
      "id": "image_desktop_it",
      "label": "Desktop-Bild IT"
    },
    {
      "type": "image_picker",
      "id": "image_mobile_it",
      "label": "Mobile-Bild IT"
    },
    {
      "type": "header",
      "content": "🇪🇸 Spanisch (ES)"
    },
    {
      "type": "image_picker",
      "id": "image_desktop_es",
      "label": "Desktop-Bild ES"
    },
    {
      "type": "image_picker",
      "id": "image_mobile_es",
      "label": "Mobile-Bild ES"
    },
    {
      "type": "header",
      "content": "Allgemein"
    },
    {
      "type": "text",
      "id": "alt_text",
      "label": "Alt-Text (Barrierefreiheit)"
    },
    {
      "type": "url",
      "id": "link",
      "label": "Link (optional)"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "breakpoint",
      "label": "Mobile → Desktop Breakpoint (px)",
      "min": 480,
      "max": 1200,
      "step": 10,
      "default": 770
    }
  ],
  "presets": [
    {
      "name": "Banner Single Collection"
    }
  ]
}
{% endschema %}