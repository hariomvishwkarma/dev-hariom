<style>
  .nutritional-information-title{
      color: {{ settings.heading_color }};
      font-weight: bold;
  }
  .nutritional-information-items {
      display: flex;
      flex-direction: column;
      gap: 10px;
      font-size: 16px;
  }
  .nutritional-information-item {
    display: flex;
    align-items: center;
  }
  .nutritional-label, .nutritional-value {
    width: 50%;
  }
  .nutritional-information-wrapper {
    border-bottom: 1px solid rgb(var(--border-color));
    padding-bottom: 30px;
  }
  .recipe-tip {
    margin-top: 24px;
  }
  .tab-button{
    color: {{settings.primary_button_background}};
    border-radius: 50px;
    padding: 6px 16px;
    border:1px solid {{settings.primary_button_background}};
  }
  .tab-button.active_tab {
    background: {{ settings.primary_button_background }};
    color: {{ settings.primary_button_text_color }};
  }
  .tab-bar-buttons {
    padding: 12px 0;
    display: flex;
    align-items: center;
    gap: 20px;
  }
  .recipe-zutaten, .tab-item-wrapper{
    display:none;
  }
  .tab-item-wrapper.active_wrapper{
    display:block;
  }
  .ingredient_item_list {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  @media (min-width:768px){
    .article__inner{
      flex-direction: row;
      margin-inline: unset;
      justify-content: space-between;
      align-items: flex-start;
    }
    .article__info{
      max-width: 30%;
      width: 100%;
      position: relative;
    }
    .nutritional-information-title{
      font-size: 24px;
      line-height: 1.26;
    }
    .article__content{
      max-width: 65%;
    }
  }

  .nutritional-servings-item{
      display: flex;
      align-items: center;
      margin-bottom: 10px;
      font-size: 16px;
      font-weight: 500;
  }

  span.nutritional-servings-label {
    margin-right: 10px;
  }


  {%- if section.settings.enable_print_button -%}
  /* ---- Print button ---- */
  .recipe-print-btn{
    display:inline-flex;align-items:center;justify-content:center;gap:8px;
    margin:14px 0;padding:10px 50px;width:max-content;
    font:600 15px/1 inherit;color:#fff;
    background:{{ section.settings.print_button_color }};
    border:none;border-radius:999px;cursor:pointer;
    transition:opacity .2s;position:relative;
  }
  .recipe-print-btn:hover{opacity:.85}
  .recipe-print-btn svg{width:16px;height:16px;fill:currentColor}
  .recipe-print-btn .rp-btn-loader{
    display:none;width:16px;height:16px;
    border:2px solid rgba(255,255,255,.4);border-top-color:#fff;
    border-radius:50%;animation:rpSpin .6s linear infinite;
  }
  .recipe-print-btn.is-loading{pointer-events:none;opacity:.85}
  .recipe-print-btn.is-loading .rp-btn-icon{display:none}
  .recipe-print-btn.is-loading .rp-btn-loader{display:inline-block}
  @keyframes rpSpin{to{transform:rotate(360deg)}}
  {%- endif -%}

</style>


{%- if section.settings.enable_print_button -%}
