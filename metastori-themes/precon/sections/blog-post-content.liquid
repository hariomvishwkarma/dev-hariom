<style>
.portion-wrapper {
  margin-bottom: 25px;
  padding: 0 5px 10px 5px;
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 15px;
  border-bottom: 1px solid #f0f0f0;
}

.portion-label {
  font-weight: 600;
  color: #333;
  font-size: 16px;
}

.portion-group {
  display: flex;
  align-items: center;
  gap: 10px;
}

.portion-circle {
  width: 38px;
  height: 38px;
  border: none;
  border-radius: 50%;
  background: #f5f5f5;
  color: #333;
  font-size: 22px;
  font-weight: 500;
  cursor: pointer;
  display: flex;
  align-items: center;
  justify-content: center;
}

.portion-circle:hover:not(:disabled) {
  background: #e5e5e5;
}

.portion-circle:disabled {
  opacity: 0.4;
  cursor: not-allowed;
}

.portion-box {
  display: flex;
  align-items: center;
  background: white;
  border: 1px solid #ddd;
  border-radius: 40px;
  padding: 0 18px;
  height: 42px;
  min-width: 90px;
  justify-content: center;
}

.portion-number {
  font-size: 19px;
  font-weight: 700;
  color: #222;
  margin-right: 5px;
}

.ingredient_item.highlight {
  background-color: #fff9e6;
  transition: background-color 0.3s;
}
</style>

<script>
(function() {
  // Configuration
  const baseValue = {{ section.settings.servings_value | default: 2 }};
  const maxValue = 20;
  const step = 1;
  
  // State
  let currentValue = baseValue;
  let hasBeenChanged = false; // Track if portions have been changed
  
  // DOM Elements
  const displayEl = document.getElementById('displayNumber');
  const minusBtn = document.getElementById('btnMinus');
  const plusBtn = document.getElementById('btnPlus');
  
  // Get all ingredient spans
  const ingredientItems = document.querySelectorAll('.ingredient_item');
  
  // Store original texts
  const originalData = [];
  
  ingredientItems.forEach((item, index) => {
    originalData[index] = item.textContent;
  });
  
  // Helper: Parse number from ingredient text - IMPROVED VERSION
  function parseNumberFromText(text) {
    // Handle Unicode fractions (½, ¼, ¾, etc.)
    const unicodeFractions = {
      '½': 0.5,
      '¼': 0.25,
      '¾': 0.75,
      '⅓': 0.333,
      '⅔': 0.667,
      '⅕': 0.2,
      '⅖': 0.4,
      '⅗': 0.6,
      '⅘': 0.8,
      '⅙': 0.167,
      '⅚': 0.833,
      '⅛': 0.125,
      '⅜': 0.375,
      '⅝': 0.625,
      '⅞': 0.875
    };
    
    // Check if text starts with a Unicode fraction
    for (const [fraction, value] of Object.entries(unicodeFractions)) {
      if (text.startsWith(fraction)) {
        return value;
      }
    }
    
    // Match regular numbers at start - including decimals and fractions like 1/2
    const match = text.match(/^(\d+(?:\s+\d+)?(?:\/\d+)?(?:\.\d+)?)/);
    if (!match) return null;
    
    const numStr = match[1].trim();
    
    // Handle mixed fractions like "2 1/2"
    if (numStr.includes(' ') && numStr.includes('/')) {
      const parts = numStr.split(' ');
      const whole = parseInt(parts[0]);
      const fraction = parts[1].split('/');
      return whole + (parseInt(fraction[0]) / parseInt(fraction[1]));
    }
    
    // Handle simple fractions like "1/2"
    if (numStr.includes('/')) {
      const fraction = numStr.split('/');
      return parseInt(fraction[0]) / parseInt(fraction[1]);
    }
    
    // Handle decimals
    return parseFloat(numStr);
  }
  
  // Helper: Format number - IMPROVED VERSION
  function formatNumber(num, originalText, index) {
    // Special case: If portions haven't been changed yet, keep original format
    if (!hasBeenChanged) {
      // Check if original text started with a Unicode fraction
      const unicodeFractions = ['½', '¼', '¾', '⅓', '⅔', '⅕', '⅖', '⅗', '⅘', '⅙', '⅚', '⅛', '⅜', '⅝', '⅞'];
      for (const fraction of unicodeFractions) {
        if (originalText.startsWith(fraction)) {
          return fraction;
        }
      }
      
      // Otherwise return the original number part
      const match = originalText.match(/^(\d+(?:\s+\d+)?(?:\/\d+)?(?:\.\d+)?)/);
      return match ? match[1] : originalText;
    }
    
    // After first change, show decimals
    // Round to 1 decimal place
    return Math.round(num * 10) / 10 + '';
  }
  
  // Helper: Get the part after the number - IMPROVED VERSION
  function getAfterNumber(text) {
    // Check if text starts with a Unicode fraction
    const unicodeFractions = ['½', '¼', '¾', '⅓', '⅔', '⅕', '⅖', '⅗', '⅘', '⅙', '⅚', '⅛', '⅜', '⅝', '⅞'];
    for (const fraction of unicodeFractions) {
      if (text.startsWith(fraction)) {
        return text.substring(fraction.length);
      }
    }
    
    // Otherwise use regex to remove the number part
    return text.replace(/^\d+(?:\s+\d+)?(?:\/\d+)?(?:\.\d+)?/, '');
  }
  
  // Update all ingredients
  function updateIngredients() {
    const factor = currentValue / baseValue;
    
    ingredientItems.forEach((item, index) => {
      const originalText = originalData[index];
      const number = parseNumberFromText(originalText);
      
      if (number !== null) {
        // Calculate new amount
        const newAmount = number * factor;
        
        // Format the number (keep Unicode fractions until first change)
        const formattedNumber = formatNumber(newAmount, originalText, index);
        
        // Get the part after the number
        const afterNumber = getAfterNumber(originalText);
        
        // Create new text
        const newText = formattedNumber + afterNumber;
        item.textContent = newText;
        
        // Highlight
        item.classList.add('highlight');
        setTimeout(() => {
          item.classList.remove('highlight');
        }, 300);
      }
    });
  }
  
  // Reset function
  function resetToBase() {
    currentValue = baseValue;
    hasBeenChanged = false; // Reset the flag
    displayEl.textContent = currentValue;
    
    ingredientItems.forEach((item, index) => {
      item.textContent = originalData[index];
      item.classList.add('highlight');
      setTimeout(() => {
        item.classList.remove('highlight');
      }, 300);
    });
    
    minusBtn.disabled = currentValue <= 1;
    plusBtn.disabled = false;
  }
  
  // Update button states
  function updateButtons() {
    minusBtn.disabled = currentValue <= 1;
    plusBtn.disabled = currentValue >= maxValue;
  }
  
  // Main function
  window.updatePortions = function(direction) {
    let newValue = currentValue;
    
    if (direction === 'plus') {
      newValue += 1;
    } else {
      newValue -= 1;
    }
    
    if (newValue < 1 || newValue > maxValue) return;
    
    // Mark that portions have been changed
    hasBeenChanged = true;
    
    currentValue = newValue;
    displayEl.textContent = currentValue;
    
    updateIngredients();
    updateButtons();
  };
  
  // Initialize buttons
  updateButtons();
  
})();
</script>
{% endif %}

</div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
function openTab(event) {
  const btn = event.currentTarget;
  const wrapper = btn.getAttribute('data-wrapper');

  document.querySelectorAll('.tab-button').forEach((btn) => {
    btn.classList.remove('active_tab');
  });

  btn.classList.add('active_tab');

  document.querySelectorAll('.tab-item-wrapper').forEach((item) => {
    item.classList.remove('active_wrapper');
  });

  document.querySelector('.tab-item-wrapper[data-tab="' + wrapper + '"]')
    .classList.add('active_wrapper');
}
</script>

