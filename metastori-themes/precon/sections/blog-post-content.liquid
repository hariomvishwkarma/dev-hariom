      <button class="portion-circle minus" onclick="updatePortions('minus')" id="btnMinus" disabled>−</button>
      
      <div class="portion-box">
        <span class="portion-number" id="displayNumber">{{ section.settings.servings_value | default: 2 }}</span>
      </div>
      
      <button class="portion-circle plus" onclick="updatePortions('plus')" id="btnPlus">+</button>
    </div>
