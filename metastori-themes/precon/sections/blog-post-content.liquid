    {% assign nutritional_values_string = nutritional_values_string |  append: 'carbohydrate:' | append: blog_content.kohlenhydrate | append: ' grams|' %}
  {%- endif -%}
  {%- if blog_content.fett != blank -%}
    {% assign nutritional_values_string = nutritional_values_string |  append: 'fat:' | append: blog_content.fett | append: ' grams|' %}
  {%- endif -%}
  {%- if blog_content.ballaststoffe != blank -%}
    {% assign nutritional_values_string = nutritional_values_string |  append: 'fiber:' | append: blog_content.ballaststoffe | append: ' grams|' %}
  {%- endif -%}
  {%- if blog_content.broteinheite != blank -%}
    {% assign nutritional_values_string = nutritional_values_string |  append: 'bread:' | append: blog_content.broteinheite | append: ' grams' %}
  {%- endif -%}

  {%- assign zutaten = blog_content.zutaten.value -%}
  {%- assign zubereitungsschritte = blog_content.zubereitungsschritte.value -%}

  <script type="application/ld+json">
    {
      "@context": "https://schema.org/",
      "@type": "Recipe",
      "name": {{ article.title | json }},
      "image": [
        "https:{{ blog_content.bild | image_url: width: 300 }}"
      ],
      "author": {
        "@type": "Person",
        "name": {{ article.author | json }}
      },
      "datePublished": "{{ article.published_at | date: '%Y-%m-%d' }}",
      "description": {{ article.meta_description | json }},
      {%- if blog_content.zubereitungszeit %}
        "prepTime": "PT{{ blog_content.zubereitungszeit }}M",
      {%- endif -%}
      {%- if blog_content.kochzeit %}
        "cookTime": "PT{{ blog_content.kochzeit }}M",
      {%- endif -%}
      {%- if blog_content.gesamtzeit %}
        "totalTime": "PT{{ blog_content.gesamtzeit }}M",
      {%- endif %}
      {%- if keywords != blank -%}
      "keywords": {% for keyword in keywords -%}"{{ keyword | downcase }}"{%- unless forloop.last -%},{% endunless -%}{%- endfor -%}, 
      {%- endif -%}
      {%- if blog_content.recipeyield != blank or blog_content.kalorien != blank -%}
        "recipeYield": {{ blog_content.recipeyield | default: 2 | json }},
      {%- endif -%}
      {%- if blog_content.recipe_category != blank -%}
        "recipeCategory": {{ blog_content.recipe_category | json }},
      {%- endif -%}
      {%- if nutritional_values_string != blank -%}
        "nutrition": {
          "@type": "NutritionInformation",
          {%- assign nutritional_values = nutritional_values_string | split: '|' -%}
          {%- for item in nutritional_values -%}
            {%- assign parts = item | split: ':' -%}
            "{{ parts[0] }}": "{{ parts[1] }}"{% unless forloop.last -%},{% endunless %}
          {%- endfor -%}
        },
      {%- endif -%}
      "recipeIngredient": [
        {%- for ingredient in zutaten -%}
          {%- unless forloop.last -%}
            {%- if ingredient contains '|' %}
              {%- assign text_with_url = ingredient | split: '|' -%}
                {%- assign text = text_with_url[0] | json  -%}
                {{ text }},
            {%- else -%}
              {{ ingredient | json }},
            {% endif %}
          {%- else -%}
            {%- if ingredient contains '|' -%}
              {%- assign text_with_url = ingredient | split: '|' -%}
                {%- assign text = text_with_url[0] -%}
                {{ text | json }}{%- unless forloop.last -%},{% endunless %}
            {%- else -%}
              {{ ingredient | json }}{%- unless forloop.last -%},{% endunless %}
            {%- endif -%}
          {%- endunless -%}
        {%- endfor -%}
      ],
      "recipeInstructions": [
        {% for step in zubereitungsschritte %}
        {
          "@type": "HowToStep",
          "text": {{ step | json }}
        }{%- unless forloop.last -%},{% endunless %}
        {%- endfor -%}
      ]
    }
  </script>
{% endif %}



{%- if section.settings.enable_print_button -%}
<script>
(function(){
  var btn = document.getElementById('recipePrintBtn-{{ section.id }}');
  if(!btn) return;

  function T(e){return e ? e.textContent.trim() : '';}

  // Build print area on demand (har click pe fresh)
  function buildPrint(){
    document.getElementById('recipe-print-area')?.remove();
    var a = document.createElement('div');
    a.id = 'recipe-print-area';
    a.style.display = 'none';

    var title = T(document.querySelector('h1.article__title')) || T(document.querySelector('.article__title'));
    var sub = {{ section.settings.print_subtitle | json }};
    var h = '<div class="rp-head"><h1 class="rp-title">'+title+'</h1>';
    if(sub){ h += '<p class="rp-sub">'+sub+'</p>'; }
    h += '</div>';

    var n = document.querySelectorAll('.nutritional-information-item');
    if(n.length){
      h += '<h2>{{ section.settings.nutritional_heading | escape }}</h2><div class="rp-nutri">';
      n.forEach(function(i){
        h += '<div><span>'+T(i.querySelector('.nutritional-label'))+'</span><span>'+T(i.querySelector('.nutritional-value'))+'</span></div>';
      });
      h += '</div>';
    }

    var portions = T(document.getElementById('displayNumber'));
    var ing = document.querySelectorAll('.ingredient_item_list .ingredient_item');
    if(ing.length){
      h += '<h2>{{ section.settings.tab_zutaten | escape }}'+(portions ? ' ('+portions+')' : '')+'</h2><ul class="rp-ing">';
      ing.forEach(function(i){ h += '<li>'+T(i)+'</li>'; });
      h += '</ul>';
    }

    var st = document.querySelectorAll('.preparation-steps ol li');
    if(st.length){
      h += '<h2>{{ section.settings.tab_zubereitung | escape }}</h2><ol class="rp-steps">';
      st.forEach(function(s){ h += '<li>'+T(s)+'</li>'; });
      h += '</ol>';
    }

    var tip = document.querySelector('.recipe-tip');
    if(tip){ h += '<div class="rp-tip">'+tip.innerHTML+'</div>'; }

    h += '<div class="rp-foot">'+location.host+'</div>';
    a.innerHTML = h;
    document.body.appendChild(a);
  }

  var isPrinting = false;

  function stopLoading(){
    btn.classList.remove('is-loading');
    isPrinting = false;
  }

  // loader hatao jab print dialog band ho (cancel ya done dono case)
  window.addEventListener('afterprint', stopLoading);

  function handlePrint(){
    if(isPrinting) return;           // double-open / double-trigger guard
    isPrinting = true;
    btn.classList.add('is-loading'); // loader turant on

    // 2 frames + chhota delay taaki loader ACTUALLY paint ho,
    // tabhi blocking window.print() call karo
    requestAnimationFrame(function(){
      requestAnimationFrame(function(){
        buildPrint();                // fresh build, latest portions capture
        setTimeout(function(){
          window.print();
          // fallback: kuch browsers afterprint reliably fire nahi karte
          setTimeout(stopLoading, 800);
        }, 60);
      });
    });
  }

  // SIRF ek bind — markup me onclick attribute nahi hai, isliye double nahi hoga
  btn.addEventListener('click', handlePrint);
})();
</script>
{%- endif -%}



