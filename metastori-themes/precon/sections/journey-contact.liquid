{%- comment -%}
  sections/journey-contact.liquid
  Fonts : Figtree 300/400/600 + Playfair Display 500 italic
  Colors: fully customisable via schema settings
{%- endcomment -%}

{%- liquid
  assign c_bg       = section.settings.color_bg
  assign c_eyebrow  = section.settings.color_eyebrow
  assign c_ink      = section.settings.color_ink
  assign c_mid      = section.settings.color_mid
  assign c_accent   = section.settings.color_accent
  assign c_card_bg  = section.settings.color_card_bg
  assign c_card_hl  = section.settings.color_card_highlight
  assign c_btn_bg   = section.settings.color_btn_bg
  assign c_btn_txt  = section.settings.color_btn_text
  assign c_icon_bg  = section.settings.color_icon_bg
-%}

{%- comment -%} SVG icon snippets {%- endcomment -%}
{%- capture icon_phone -%}
<svg width="22" height="22" viewBox="0 0 22 22" fill="none" xmlns="http://www.w3.org/2000/svg">
  <path d="M6.5 2H4a2 2 0 0 0-2 2c0 9.39 7.61 17 17 17a2 2 0 0 0 2-2v-2.5a1 1 0 0 0-.72-.96l-3.5-1a1 1 0 0 0-1.02.27l-1.56 1.56a15.08 15.08 0 0 1-6.57-6.57l1.56-1.56a1 1 0 0 0 .27-1.02l-1-3.5A1 1 0 0 0 6.5 2Z" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
</svg>
{%- endcapture -%}

{%- capture icon_chat -%}
<svg width="22" height="22" viewBox="0 0 22 22" fill="none" xmlns="http://www.w3.org/2000/svg">
  <path d="M11 2C6.03 2 2 5.8 2 10.5c0 1.9.65 3.65 1.74 5.07L2.5 19l3.6-1.2A9.32 9.32 0 0 0 11 19c4.97 0 9-3.8 9-8.5S15.97 2 11 2Z" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
  <path d="M7 10.5h8M7 14h5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/>
</svg>
{%- endcapture -%}

{%- capture icon_email -%}
<svg width="22" height="22" viewBox="0 0 22 22" fill="none" xmlns="http://www.w3.org/2000/svg">
  <rect x="2" y="5" width="18" height="13" rx="2" stroke="currentColor" stroke-width="1.6"/>
  <path d="M2 8l9 6 9-6" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/>
</svg>
{%- endcapture -%}

{%- capture icon_community -%}
<svg width="22" height="22" viewBox="0 0 22 22" fill="none" xmlns="http://www.w3.org/2000/svg">
  <circle cx="8" cy="7" r="3" stroke="currentColor" stroke-width="1.6"/>
  <path d="M2 19c0-3.31 2.69-6 6-6s6 2.69 6 6" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/>
  <circle cx="16" cy="7" r="2.5" stroke="currentColor" stroke-width="1.4"/>
  <path d="M20 19c0-2.76-1.79-5.1-4.25-5.75" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"/>
</svg>
{%- endcapture -%}


<div id="jct-{{ section.id }}" class="jct">

  {%- comment -%}── HEADER ──{%- endcomment -%}
  <div class="jct__header">
    {%- if section.settings.eyebrow != blank -%}
      <p class="jct__eyebrow">{{ section.settings.eyebrow }}</p>
    {%- endif -%}
    {%- if section.settings.title_normal != blank or section.settings.title_italic != blank -%}
      <h2 class="jct__title">
        {%- if section.settings.title_normal != blank -%}{{ section.settings.title_normal }} {%- endif -%}
        {%- if section.settings.title_italic != blank -%}<em>{{ section.settings.title_italic }}</em>{%- endif -%}
      </h2>
    {%- endif -%}
    {%- if section.settings.subtitle != blank -%}
      <p class="jct__subtitle">{{ section.settings.subtitle }}</p>
    {%- endif -%}
  </div>

  {%- comment -%}── CARDS ──{%- endcomment -%}
  <div class="jct__grid">

    {%- for block in section.blocks -%}

      {%- comment -%} Pick icon {%- endcomment -%}
      {%- assign icon_choice = block.settings.icon -%}
      {%- if icon_choice == 'phone' -%}
        {%- assign icon_svg = icon_phone -%}
      {%- elsif icon_choice == 'chat' -%}
        {%- assign icon_svg = icon_chat -%}
      {%- elsif icon_choice == 'email' -%}
        {%- assign icon_svg = icon_email -%}
      {%- else -%}
        {%- assign icon_svg = icon_community -%}
      {%- endif -%}

      {%- if block.type == 'card_form' -%}

        <div class="jct__card" {{ block.shopify_attributes }}>
          <div class="jct__card-top">
            <div class="jct__icon-wrap">{{ icon_svg }}</div>
            {%- if block.settings.eyebrow != blank -%}
              <p class="jct__card-eyebrow">{{ block.settings.eyebrow }}</p>
            {%- endif -%}
            {%- if block.settings.title != blank -%}
              <h3 class="jct__card-title">{{ block.settings.title }}</h3>
            {%- endif -%}
            {%- if block.settings.subtitle != blank -%}
              <p class="jct__card-sub">{{ block.settings.subtitle }}</p>
            {%- endif -%}
          </div>
          {%- if block.settings.cta_text != blank -%}
            <div class="jct__card-footer">
              <a class="jct__card-cta" href="{{ block.settings.cta_url | default: '#' }}">
                {{ block.settings.cta_text }} →
              </a>
            </div>
          {%- endif -%}
        </div>

      {%- elsif block.type == 'card_highlight' -%}

        <div class="jct__card jct__card--highlight" {{ block.shopify_attributes }}>
          <div class="jct__card-top">
            <div class="jct__icon-wrap">{{ icon_svg }}</div>
            {%- if block.settings.eyebrow != blank -%}
              <p class="jct__card-eyebrow">{{ block.settings.eyebrow }}</p>
            {%- endif -%}
            {%- if block.settings.title != blank -%}
              <h3 class="jct__card-title">{{ block.settings.title }}</h3>
            {%- endif -%}
            {%- if block.settings.body != blank -%}
              <p class="jct__card-sub">{{ block.settings.body }}</p>
            {%- endif -%}
          </div>
          {%- if block.settings.badge_text != blank -%}
            <div class="jct__card-footer">
              <span class="jct__badge">{{ block.settings.badge_text }}</span>
            </div>
          {%- endif -%}
        </div>

      {%- else -%}

        <div class="jct__card" {{ block.shopify_attributes }}>
          <div class="jct__card-top">
            <div class="jct__icon-wrap">{{ icon_svg }}</div>
            {%- if block.settings.eyebrow != blank -%}
              <p class="jct__card-eyebrow">{{ block.settings.eyebrow }}</p>
            {%- endif -%}
            {%- if block.settings.title != blank -%}
              <h3 class="jct__card-title">{{ block.settings.title }}</h3>
            {%- endif -%}
            {%- if block.settings.subtitle != blank -%}
              <p class="jct__card-sub">{{ block.settings.subtitle }}</p>
            {%- endif -%}
          </div>
          {%- if block.settings.cta_text != blank -%}
            {%- if block.settings.tel_number != blank -%}
              {%- assign cta_href = 'tel:' | append: block.settings.tel_number -%}
            {%- elsif block.settings.email_address != blank -%}
              {%- assign cta_href = 'mailto:' | append: block.settings.email_address -%}
            {%- else -%}
              {%- assign cta_href = block.settings.cta_url | default: '#' -%}
            {%- endif -%}
            <div class="jct__card-footer">
              <a class="jct__card-cta" href="{{ cta_href }}">
                {{ block.settings.cta_text }} →
              </a>
            </div>
          {%- endif -%}
        </div>

      {%- endif -%}

    {%- endfor -%}
  </div>
</div>


<style>
  @import url('https://fonts.googleapis.com/css2?family=Figtree:wght@300;400;600&family=Playfair+Display:ital,wght@1,500&display=swap');

  #jct-{{ section.id }} {
    --bg:        {{ c_bg }};
    --eyebrow:   {{ c_eyebrow }};
    --ink:       {{ c_ink }};
    --mid:       {{ c_mid }};
    --accent:    {{ c_accent }};
    --card-bg:   {{ c_card_bg }};
    --card-hl:   {{ c_card_hl }};
    --btn-bg:    {{ c_btn_bg }};
    --btn-txt:   {{ c_btn_txt }};
    --icon-bg:   {{ c_icon_bg }};
    --border:    {{ c_ink | color_modify: 'alpha', 0.08 }};
  }

  #jct-{{ section.id }},
  #jct-{{ section.id }} * { box-sizing: border-box; }

  #jct-{{ section.id }} {
    background: var(--bg);
    font-family: 'Figtree', sans-serif;
    -webkit-font-smoothing: antialiased;
    padding: 5rem 1.5rem;
  }

  /* ── HEADER ── */
  #jct-{{ section.id }} .jct__header {
    text-align: center;
    max-width: 680px;
    margin: 0 auto 3.5rem;
  }
  #jct-{{ section.id }} .jct__eyebrow {
    font-weight: 600;
    font-size: .68rem;
    letter-spacing: .26em;
    text-transform: uppercase;
    color: var(--eyebrow);
    margin: 0 0 1.2rem;
  }
  #jct-{{ section.id }} .jct__title {
    font-family: 'Figtree', sans-serif;
    font-weight: 300;
    font-size: clamp(2rem, 4.8vw, 3.75rem);
    line-height: 1.12;
    color: var(--ink);
    margin: 0 0 1.2rem;
  }
  #jct-{{ section.id }} .jct__title em {
    font-family: 'Playfair Display', serif;
    font-style: italic;
    font-weight: 500;
  }
  #jct-{{ section.id }} .jct__subtitle {
    font-weight: 300;
    font-size: clamp(.9rem, 2vw, 1.05rem);
    line-height: 1.75;
    color: var(--mid);
    margin: 0;
  }

  /* ── GRID ── */
  #jct-{{ section.id }} .jct__grid {
    max-width: 1260px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.25rem;
  }
  @media (min-width: 600px) {
    #jct-{{ section.id }} .jct__grid { grid-template-columns: repeat(2, 1fr); }
  }
  @media (min-width: 1000px) {
    #jct-{{ section.id }} .jct__grid { grid-template-columns: repeat(4, 1fr); }
  }

  /* ── CARD ── */
  #jct-{{ section.id }} .jct__card {
    background: var(--card-bg);
    border: 1px solid var(--border);
    border-radius: 18px;
    padding: 1.75rem 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 0;
  }
  #jct-{{ section.id }} .jct__card--highlight {
    background: var(--card-hl);
    border-color: transparent;
  }
  #jct-{{ section.id }} .jct__card-top {
    flex: 1;
  }

  /* Icon */
  #jct-{{ section.id }} .jct__icon-wrap {
    width: 44px;
    height: 44px;
    border-radius: 10px;
    background: var(--icon-bg);
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--mid);
    margin-bottom: 1.25rem;
  }
  #jct-{{ section.id }} .jct__card--highlight .jct__icon-wrap {
    color: var(--accent);
    background: {{ c_accent | color_modify: 'alpha', 0.12 }};
  }

  /* Card eyebrow */
  #jct-{{ section.id }} .jct__card-eyebrow {
    font-weight: 600;
    font-size: .63rem;
    letter-spacing: .22em;
    text-transform: uppercase;
    color: var(--mid);
    margin: 0 0 .6rem;
  }
  #jct-{{ section.id }} .jct__card--highlight .jct__card-eyebrow {
    color: var(--accent);
  }

  /* Card title */
  #jct-{{ section.id }} .jct__card-title {
    font-family: 'Figtree', sans-serif;
    font-weight: 600;
    font-size: clamp(1.05rem, 2vw, 1.2rem);
    color: var(--ink);
    margin: 0 0 .6rem;
    line-height: 1.3;
  }

  /* Card subtitle / body */
  #jct-{{ section.id }} .jct__card-sub {
    font-weight: 400;
    font-size: .88rem;
    line-height: 1.65;
    color: var(--mid);
    margin: 0;
  }

  /* Footer */
  #jct-{{ section.id }} .jct__card-footer {
    margin-top: 1.5rem;
    padding-top: 1.25rem;
    border-top: 1px solid var(--border);
  }
  #jct-{{ section.id }} .jct__card--highlight .jct__card-footer {
    border-top-color: {{ c_accent | color_modify: 'alpha', 0.15 }};
  }

  /* CTA link */
  #jct-{{ section.id }} .jct__card-cta {
    font-weight: 600;
    font-size: .88rem;
    color: var(--accent);
    text-decoration: none;
    transition: opacity .2s;
  }
  #jct-{{ section.id }} .jct__card-cta:hover { opacity: .72; }

  /* Badge */
  #jct-{{ section.id }} .jct__badge {
    display: inline-block;
    font-size: .8rem;
    font-weight: 400;
    color: var(--accent);
    background: {{ c_accent | color_modify: 'alpha', 0.10 }};
    border-radius: 999px;
    padding: .3rem .9rem;
  }

</style>


{% schema %}
{
  "name": "Journey Contact",
  "tag": "section",
  "class": "journey-contact-section",
  "settings": [
    {
      "type": "header",
