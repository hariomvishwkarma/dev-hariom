<style>
  .guarantee {
    padding: 40px 20px;
    font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
    background-color: {{ section.settings.bg_color }};
    color: {{ section.settings.text_color }};
  }
  .guarantee__inner {
    max-width: 720px;
    margin: 0 auto;
  }
  .guarantee__divider {
    border: none;
    border-top: 1px solid {{ section.settings.divider_color }};
    margin: 0 0 32px;
  }
  .guarantee__box {
    border: 2px dashed {{ section.settings.accent_color }};
    border-radius: 14px;
    padding: 28px 28px;
    display: flex;
    align-items: center;
    gap: 20px;
  }
  .guarantee__icon {
    flex-shrink: 0;
    width: 64px;
    height: 64px;
    border-radius: 50%;
    background: {{ section.settings.accent_color }};
    color: #fff;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    line-height: 1;
  }
  .guarantee__icon-num {
    font-size: 22px;
    font-weight: 800;
  }
  .guarantee__icon-label {
    font-size: 8px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 1px;
  }
  .guarantee__content {
    flex: 1;
    min-width: 0;
  }
  .guarantee__title {
    font-size: 17px;
    font-weight: 700;
    margin: 0 0 6px;
  }
  .guarantee__desc {
    font-size: 14px;
    line-height: 1.6;
    margin: 0;
    opacity: 0.75;
  }

  @media (max-width: 600px) {
    .guarantee {
      padding: 24px 14px;
    }
    .guarantee__divider {
      margin-bottom: 20px;
    }
    .guarantee__box {
      padding: 18px 16px;
      gap: 14px;
    }
    .guarantee__icon {
      width: 50px;
      height: 50px;
    }
    .guarantee__icon-num {
      font-size: 18px;
    }
    .guarantee__icon-label {
      font-size: 7px;
    }
    .guarantee__title {
      font-size: 15px;
    }
    .guarantee__desc {
      font-size: 12px;
    }
  }
</style>

<div class="guarantee">
  <div class="guarantee__inner">
    {% if section.settings.show_divider %}
      <hr class="guarantee__divider">
    {% endif %}

    <div class="guarantee__box">
      <div class="guarantee__icon">
        <span class="guarantee__icon-num">{{ section.settings.days }}</span>
        <span class="guarantee__icon-label">Tage</span>
      </div>
      <div class="guarantee__content">
        <h3 class="guarantee__title">{{ section.settings.title }}</h3>
        <p class="guarantee__desc">{{ section.settings.description }}</p>
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Guarantee Banner",
  "settings": [
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#faf8f4"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#3a3631"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent / Border Color",
      "default": "#2fb5a0"
    },
    {
      "type": "color",
      "id": "divider_color",
      "label": "Divider Color",
      "default": "#e4dfd6"
    },
    {
      "type": "checkbox",
      "id": "show_divider",
      "label": "Show Divider Line Above",
      "default": true
    },
    {
      "type": "text",
      "id": "days",
      "label": "Number of Days",
      "default": "30"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Title",
      "default": "30 Tage Geld-zurück-Garantie"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "Probier Precon 30 Tage risikofrei. Bist du nicht zufrieden, erstatten wir dir den vollen Kaufpreis. Ohne Wenn und Aber."
    }
  ],
  "presets": [
    {
      "name": "Guarantee Banner"
    }
  ]
}
{% endschema %}