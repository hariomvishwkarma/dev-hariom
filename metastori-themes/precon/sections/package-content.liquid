<style>
  .pkg-contents {
    padding: 40px 20px 48px;
    text-align: center;
    font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
    background-color: {{ section.settings.bg_color }};
    color: {{ section.settings.text_color }};
  }
  .pkg-contents__badge {
    display: inline-block;
    border: 2px solid {{ section.settings.accent_color }};
    color: {{ section.settings.accent_color }};
    padding: 6px 20px;
    border-radius: 30px;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 1.2px;
    text-transform: uppercase;
    margin-bottom: 16px;
  }
  .pkg-contents__heading {
    font-size: clamp(28px, 4.5vw, 44px);
    font-weight: 400;
    line-height: 1.2;
    margin: 0 auto 32px;
    max-width: 700px;
  }
  .pkg-contents__heading em {
    font-style: italic;
    font-family: Georgia, 'Times New Roman', serif;
    color: {{ section.settings.accent_color }};
  }
  .pkg-contents__grid {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 16px;
    max-width: 960px;
    margin: 0 auto;
  }
  .pkg-contents__card {
    flex: 0 1 calc(33.333% - 12px);
    min-width: 260px;
    background: {{ section.settings.card_bg_color }};
    border: 1px solid {{ section.settings.card_border_color }};
    border-radius: 12px;
    padding: 24px 20px;
    display: flex;
    align-items: flex-start;
    gap: 14px;
    text-align: left;
  }
  .pkg-contents__icon {
    flex-shrink: 0;
    width: 44px;
    height: 44px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 28px;
  }
  .pkg-contents__icon img {
    width: 44px;
    height: 44px;
    object-fit: contain;
  }
  .pkg-contents__info {
    flex: 1;
    min-width: 0;
  }
  .pkg-contents__title {
    font-size: 15px;
    font-weight: 700;
    margin: 0 0 6px;
  }
  .pkg-contents__title::before {
    content: '✓ ';
    color: {{ section.settings.accent_color }};
  }
  .pkg-contents__desc {
    font-size: 13px;
    line-height: 1.5;
    opacity: 0.7;
    margin: 0;
  }

  @media (max-width: 600px) {
    .pkg-contents {
      padding: 24px 14px 28px;
    }
    .pkg-contents__badge {
      font-size: 10px;
      padding: 4px 14px;
      margin-bottom: 10px;
    }
    .pkg-contents__heading {
      font-size: 22px;
      margin-bottom: 16px;
    }
    .pkg-contents__grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 8px;
    }
    .pkg-contents__card {
      flex-direction: column;
      align-items: center;
      text-align: center;
      padding: 14px 10px;
      gap: 6px;
      min-width: 0;
    }
    .pkg-contents__icon {
      width: 28px;
      height: 28px;
      font-size: 20px;
    }
    .pkg-contents__icon img {
      width: 28px;
      height: 28px;
    }
    .pkg-contents__title {
      font-size: 12px;
    }
    .pkg-contents__title::before {
      content: none;
    }
    .pkg-contents__desc {
      font-size: 11px;
      line-height: 1.4;
    }
  }
</style>

<div class="pkg-contents">
  {% if section.settings.badge_text != blank %}
    <span class="pkg-contents__badge">{{ section.settings.badge_text }}</span>
  {% endif %}

  <h2 class="pkg-contents__heading">{{ section.settings.heading }}</h2>

  <div class="pkg-contents__grid">
    {% for block in section.blocks %}
      <div class="pkg-contents__card" {{ block.shopify_attributes }}>
        <div class="pkg-contents__icon">
          {% if block.settings.icon_image != blank %}
            <img src="{{ block.settings.icon_image | image_url: width: 88 }}" alt="" loading="lazy">
          {% else %}
            {{ block.settings.icon_emoji }}
          {% endif %}
        </div>
        <div class="pkg-contents__info">
          <h3 class="pkg-contents__title">{{ block.settings.title }}</h3>
          <p class="pkg-contents__desc">{{ block.settings.description }}</p>
        </div>
      </div>
    {% endfor %}
  </div>
</div>

{% schema %}
{
  "name": "Package Contents",
  "settings": [
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#faf8f4"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#3a3631"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent Color",
      "default": "#2fb5a0"
    },
    {
      "type": "color",
      "id": "card_bg_color",
      "label": "Card Background",
      "default": "#f0ece4"
    },
    {
      "type": "color",
      "id": "card_border_color",
      "label": "Card Border",
      "default": "#e4dfd6"
    },
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "badge_text",
      "label": "Top Badge Text",
      "default": "Was im Paket enthalten ist"
    },
    {
      "type": "html",
      "id": "heading",
      "label": "Heading (use <em> for accent)",
      "default": "Alles, was Du für <em>4 Wochen</em> brauchst."
    }
  ],
  "blocks": [
    {
      "type": "item",
      "name": "Content Item",
      "settings": [
        {
          "type": "image_picker",
          "id": "icon_image",
          "label": "Icon Image (optional)"
        },
        {
          "type": "text",
          "id": "icon_emoji",
          "label": "Icon Emoji (fallback if no image)",
          "default": "📦"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "1× Produkt"
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "Description",
          "default": "Kurze Beschreibung des Produkts."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Package Contents",
      "blocks": [
        { "type": "item", "settings": { "icon_emoji": "🥤", "title": "1× Start Shake", "description": "Für die ersten 2 Tage. Bringt Deinen Stoffwechsel auf Fettverbrennung um." } },
        { "type": "item", "settings": { "icon_emoji": "🥛", "title": "2× Precon Shake", "description": "Je 24 Mahlzeiten. Lecker, sättigend, unter 235 kcal pro Portion." } },
        { "type": "item", "settings": { "icon_emoji": "🍫", "title": "2× Riegelpaket", "description": "Je 3 Riegel. Perfekt für unterwegs oder zum Kauen." } },
        { "type": "item", "settings": { "icon_emoji": "🎁", "title": "1× Shake-Mix Probier-Set", "description": "9 verschiedene Sorten zum Ausprobieren." } },
        { "type": "item", "settings": { "icon_emoji": "🥛", "title": "1× Precon Shaker", "description": "Für die einfache Zubereitung in 30 Sekunden." } },
        { "type": "item", "settings": { "icon_emoji": "📘", "title": "1× Precon Handbuch", "description": "Mit Deinem 4-Wochen-Plan und allen Abnehmtipps." } },
        { "type": "item", "settings": { "icon_emoji": "📖", "title": "1× Rezept-Kochbuch (E-Book)", "description": "Für Deine selbstgekochte Mahlzeit am Abend." } },
        { "type": "item", "settings": { "icon_emoji": "🚚", "title": "Gratis Versand", "description": "Ab €99. Lieferung in 1–3 Werktagen direkt zu Dir." } }
      ]
    }
  ]
}
{% endschema %}