{%- comment -%}
  sections/reviews-lp.liquid
  Bewertungs-Section: Rating-Zusammenfassung links + 2×2 Kundenbewertungen rechts
  Schriftdicken wie Vorlage: 700 für "Sehr gut" & Score, 600 für Namen, 400 für Reviews
  Fonts: Figtree 400/600/700
{%- endcomment -%}

{%- liquid
  assign c_bg      = section.settings.color_bg
  assign c_ink     = section.settings.color_ink
  assign c_mid     = section.settings.color_mid
  assign c_accent  = section.settings.color_accent
  assign c_card_bg = section.settings.color_card_bg
  assign c_border  = section.settings.color_border
  assign pt        = section.settings.padding_top
  assign pb        = section.settings.padding_bottom
-%}

<div id="rev-{{ section.id }}" class="rev" style="padding-top: {{ pt }}px; padding-bottom: {{ pb }}px;">
  <div class="rev__inner">

    <!-- ── Linke Spalte: Rating-Zusammenfassung ── -->
    <div class="rev__summary">

      {%- if section.settings.label != blank -%}
        <p class="rev__label">{{ section.settings.label }}</p>
      {%- endif -%}

      <div class="rev__stars" aria-label="{{ section.settings.score }} von 5 Sternen">
        {%- for i in (1..5) -%}
          <svg class="rev__star" viewBox="0 0 20 20" fill="currentColor" xmlns="http://www.w3.org/2000/svg">
            <path d="M10 1l2.39 4.84 5.34.78-3.87 3.76.91 5.32L10 13.27l-4.77 2.51.91-5.32L2.27 6.62l5.34-.78L10 1z"/>
          </svg>
        {%- endfor -%}
      </div>

      {%- if section.settings.score != blank -%}
        <p class="rev__score">{{ section.settings.score }}</p>
      {%- endif -%}

      <p class="rev__score-label">Rating</p>

      {%- if section.settings.count != blank -%}
        <p class="rev__count">{{ section.settings.count }} Bewertungen</p>
      {%- endif -%}

      {%- if section.settings.badge_image != blank or section.settings.badge_image_2 != blank -%}
        <div class="rev__badges">
          {%- if section.settings.badge_image != blank -%}
            {{
              section.settings.badge_image
              | image_url: width: 200
              | image_tag: class: 'rev__badge-img', alt: 'Bewertungs-Siegel', loading: 'lazy'
            }}
          {%- endif -%}
          {%- if section.settings.badge_image_2 != blank -%}
            {{
              section.settings.badge_image_2
              | image_url: width: 200
              | image_tag: class: 'rev__badge-img', alt: 'Bewertungs-Siegel 2', loading: 'lazy'
            }}
          {%- endif -%}
        </div>
      {%- endif -%}

    </div>

    <!-- ── Rechte Spalte: Karten-Grid ── -->
    {%- if section.blocks.size > 0 -%}
      <div class="rev__grid">
        {%- for block in section.blocks -%}
          {%- if block.type == 'review' -%}
            <div class="rev__card" {{ block.shopify_attributes }}>

              <!-- Sterne der Einzelbewertung -->
              <div class="rev__card-stars">
                {%- assign card_stars = block.settings.stars | default: 5 -%}
                {%- for i in (1..card_stars) -%}
                  <svg class="rev__star rev__star--sm" viewBox="0 0 20 20" fill="currentColor">
                    <path d="M10 1l2.39 4.84 5.34.78-3.87 3.76.91 5.32L10 13.27l-4.77 2.51.91-5.32L2.27 6.62l5.34-.78L10 1z"/>
                  </svg>
                {%- endfor -%}
              </div>

              <!-- Name + Verified -->
              <p class="rev__card-name">
                <svg class="rev__card-check" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg">
                  <circle cx="10" cy="10" r="10" fill="currentColor" opacity="0.15"/>
                  <circle cx="10" cy="10" r="10" stroke="currentColor" stroke-width="1.5" fill="none"/>
                  <polyline points="6,10 9,13 14,7" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" fill="none"/>
                </svg>
                {{ block.settings.name }}
              </p>

              <!-- Reviewtext -->
              {%- if block.settings.text != blank -%}
                <p class="rev__card-text">{{ block.settings.text }}</p>
              {%- endif -%}

            </div>
          {%- endif -%}
        {%- endfor -%}
      </div>
    {%- endif -%}

  </div>
</div>

<style>
@import url('https://fonts.googleapis.com/css2?family=Figtree:wght@400;600;700&display=swap');

#rev-{{ section.id }} {
  --bg:       {{ c_bg }};
  --ink:      {{ c_ink }};
  --mid:      {{ c_mid }};
  --accent:   {{ c_accent }};
  --card-bg:  {{ c_card_bg }};
  --border:   {{ c_border }};
  --star:     #F5B800;
}

#rev-{{ section.id }},
#rev-{{ section.id }} * { box-sizing: border-box; }

#rev-{{ section.id }} {
  background: var(--bg);
  font-family: 'Figtree', sans-serif;
  -webkit-font-smoothing: antialiased;
  padding-left: 1.5rem;
  padding-right: 1.5rem;
}

/* ── Layout ── */
#rev-{{ section.id }} .rev__inner {
  max-width: 1100px;
  margin: 0 auto;
  display: grid;
  grid-template-columns: 260px 1fr;
  gap: 3rem;
  align-items: center;
}

/* ── Summary (links) ── */
#rev-{{ section.id }} .rev__summary {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  justify-content: center;
  gap: 0.6rem;
}

#rev-{{ section.id }} .rev__label {
  font-size: clamp(32px, 3.5vw, 44px);
  font-weight: 700;
  color: var(--ink);
  line-height: 1.1;
  letter-spacing: -0.02em;
  margin: 0;
}

/* ── Sterne ── */
#rev-{{ section.id }} .rev__stars {
  display: flex;
  gap: 3px;
  margin-top: 0.25rem;
}

#rev-{{ section.id }} .rev__star {
  width: 34px;
  height: 34px;
  color: var(--star);
  flex-shrink: 0;
}

#rev-{{ section.id }} .rev__star--sm {
  width: 16px;
  height: 16px;
}

/* ── Score ── */
#rev-{{ section.id }} .rev__score {
  font-size: clamp(52px, 5.5vw, 70px);
  font-weight: 700;
  color: var(--ink);
  letter-spacing: -0.03em;
  line-height: 1;
  margin: 0.25rem 0 0;
}

#rev-{{ section.id }} .rev__score-label {
  font-size: 15px;
  font-weight: 400;
  color: var(--mid);
  margin: 0;
}

#rev-{{ section.id }} .rev__count {
  font-size: 15px;
  font-weight: 600;
  color: var(--mid);
  margin: 0.25rem 0 0;
}

/* ── Badges ── */
#rev-{{ section.id }} .rev__badges {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 12px;
  margin-top: 1.75rem;
  padding-top: 1.25rem;
  border-top: 1px solid var(--border);
}

#rev-{{ section.id }} .rev__badge-img {
  width: 100px;
  height: auto;
  display: block;
}

/* ── Grid (rechts) ── */
#rev-{{ section.id }} .rev__grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 12px;
}

/* ── Karte ── */
#rev-{{ section.id }} .rev__card {
  background: var(--card-bg);
  border: 1px solid var(--border);
  border-radius: 14px;
  padding: 20px 22px;
  display: flex;
  flex-direction: column;
  gap: 10px;
}

/* ── Karten-Sterne ── */
#rev-{{ section.id }} .rev__card-stars {
  display: flex;
  gap: 2px;
}

/* ── Name ── */
#rev-{{ section.id }} .rev__card-name {
  display: flex;
  align-items: center;
  gap: 7px;
  font-size: 13.5px;
  font-weight: 600;
  color: var(--ink);
  margin: 0;
  line-height: 1.2;
}

#rev-{{ section.id }} .rev__card-check {
  width: 18px;
  height: 18px;
  color: var(--accent);
  flex-shrink: 0;
}

/* ── Text ── */
#rev-{{ section.id }} .rev__card-text {
  font-size: 14px;
  font-weight: 400;
  color: var(--mid);
  line-height: 1.7;
  margin: 0;
  text-align: center;
}

/* ── Responsive ── */
@media (max-width: 860px) {
  #rev-{{ section.id }} .rev__inner {
    grid-template-columns: 1fr;
    gap: 2rem;
  }

  #rev-{{ section.id }} .rev__summary {
    align-items: center;
    text-align: center;
  }
}

@media (max-width: 500px) {
  #rev-{{ section.id }} .rev__grid {
    grid-template-columns: 1fr;
  }
  #rev-{{ section.id }} {
    padding-left: 1rem;
    padding-right: 1rem;
  }
}
</style>

{% schema %}
{
  "name": "Bewertungen LP",
  "tag": "section",
  "settings": [
    {
      "type": "header",
      "content": "Rating-Zusammenfassung"
    },
    {
      "type": "text",
      "id": "label",
      "label": "Bewertungsurteil",
      "default": "Sehr gut"
    },
    {
      "type": "text",
      "id": "score",
      "label": "Bewertungs-Score",
      "default": "4.77"
    },
    {
      "type": "text",
      "id": "count",
      "label": "Anzahl Bewertungen",
      "default": "18'141"
    },
    {
      "type": "image_picker",
      "id": "badge_image",
      "label": "Siegel-Bild 1 (z. B. Trusted Shops)"
    },
    {
      "type": "image_picker",
      "id": "badge_image_2",
      "label": "Siegel-Bild 2 (optional)"
    },
    {
      "type": "header",
      "content": "Abstände"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Abstand oben",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 72
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Abstand unten",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 72
    },
    {
      "type": "header",
      "content": "Farben"
    },
    {
      "type": "color",
      "id": "color_bg",
      "label": "Hintergrund Section",
      "default": "#FAF9F5"
    },
    {
      "type": "color",
      "id": "color_card_bg",
      "label": "Hintergrund Karte",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "color_border",
      "label": "Rahmen Karte",
      "default": "#ECE8E1"
    },
    {
      "type": "color",
      "id": "color_ink",
      "label": "Text dunkel",
      "default": "#56473A"
    },
    {
      "type": "color",
      "id": "color_mid",
      "label": "Text gedimmt",
      "default": "#8C7C70"
    },
    {
      "type": "color",
      "id": "color_accent",
      "label": "Akzentfarbe (Check)",
      "default": "#3DADBB"
    }
  ],
  "blocks": [
    {
      "type": "review",
      "name": "Kundenbewertung",
      "settings": [
        {
          "type": "range",
          "id": "stars",
          "label": "Sterne",
          "min": 1,
          "max": 5,
          "step": 1,
          "default": 5
        },
        {
          "type": "text",
          "id": "name",
          "label": "Name",
          "default": "Cornelia B."
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Bewertungstext"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Bewertungen LP",
      "blocks": [
        {
          "type": "review",
          "settings": {
            "stars": 5,
            "name": "Cornelia B.",
            "text": "Ich komme super damit klar, es gibt verschiedene Sorten und die sind lecker. Sie saettigen gut und das abnehmen klappt auch."
          }
        },
        {
          "type": "review",
          "settings": {
            "stars": 5,
            "name": "Anonym",
            "text": "Precon ist einfach spitze! Seit ich die Produkte nutze, fuehle ich mich fitter und vitaler. Absolut empfehlenswert."
          }
        },
        {
          "type": "review",
          "settings": {
            "stars": 5,
            "name": "Corinne H.",
            "text": "Ich mag die Shakes von Precon. Sie gehoeren zu meinem Morgenritual, auch wenn ich mein Ziel bereits erreicht habe."
          }
        },
        {
          "type": "review",
          "settings": {
            "stars": 5,
            "name": "Manuela G.",
            "text": "Habe mit Precon vor einer Woche begonnen und bin sehr zufrieden. Auch die Rezepte sind einfach und schmecken wunderbar!"
          }
        }
      ]
    }
  ]
}
{% endschema %}