<style>
  .comp-table {
    padding: 48px 20px;
    font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
    background-color: {{ section.settings.bg_color }};
    color: {{ section.settings.text_color }};
  }
  .comp-table__inner {
    max-width: 820px;
    margin: 0 auto;
  }
  .comp-table__label {
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 2px;
    text-transform: uppercase;
    color: {{ section.settings.accent_color }};
    margin-bottom: 8px;
  }
  .comp-table__heading {
    font-size: clamp(28px, 4.5vw, 42px);
    font-weight: 400;
    font-family: Georgia, 'Times New Roman', serif;
    line-height: 1.15;
    margin: 0 0 28px;
  }

  /* ── Table wrapper ── */
  .comp-table__wrap {
    background: {{ section.settings.card_bg }};
    border-radius: 16px;
    overflow: hidden;
  }
  .comp-table__table {
    width: 100%;
    border-collapse: collapse;
  }

  /* ── Header row ── */
  .comp-table__table thead th {
    padding: 18px 24px;
    font-size: 15px;
    font-weight: 700;
    text-align: left;
    border-bottom: 1px solid {{ section.settings.divider_color }};
  }
  .comp-table__table thead th:first-child {
    background: transparent;
  }
  .comp-table__table thead th.comp-table__th-old {
    background: transparent;
  }
  .comp-table__table thead th.comp-table__th-new {
    background: {{ section.settings.highlight_color }};
    color: #fff;
    border-radius: 12px 12px 0 0;
  }

  /* ── Body rows ── */
  .comp-table__table tbody td {
    padding: 20px 24px;
    font-size: 15px;
    line-height: 1.5;
    vertical-align: top;
    border-bottom: 1px solid {{ section.settings.divider_color }};
  }
  .comp-table__table tbody tr:last-child td {
    border-bottom: none;
  }
  .comp-table__table tbody td:first-child {
    font-weight: 600;
    width: 35%;
  }
  .comp-table__table tbody td.comp-table__td-old {
    opacity: 0.7;
    width: 30%;
  }
  .comp-table__table tbody td.comp-table__td-old::before {
    content: '✕ ';
    color: #c0392b;
    font-weight: 700;
  }
  .comp-table__table tbody td.comp-table__td-new {
    font-weight: 700;
    background: {{ section.settings.highlight_bg }};
    width: 35%;
  }
  .comp-table__table tbody td.comp-table__td-new::before {
    content: '✓ ';
    color: {{ section.settings.accent_color }};
    font-weight: 700;
  }

  @media (max-width: 600px) {
    .comp-table {
      padding: 24px 14px;
    }
    .comp-table__heading {
      font-size: 24px;
      margin-bottom: 20px;
    }
    .comp-table__wrap {
      border-radius: 12px;
    }
    .comp-table__table thead th {
      padding: 12px 12px;
      font-size: 12px;
    }
    .comp-table__table tbody td {
      padding: 14px 12px;
      font-size: 13px;
    }
    .comp-table__table tbody td:first-child {
      width: 30%;
      font-size: 12px;
    }
  }
</style>

<div class="comp-table">
  <div class="comp-table__inner">
    {% if section.settings.top_label != blank %}
      <div class="comp-table__label">{{ section.settings.top_label }}</div>
    {% endif %}

    <h2 class="comp-table__heading">{{ section.settings.heading }}</h2>

    <div class="comp-table__wrap">
      <table class="comp-table__table">
        <thead>
          <tr>
            <th></th>
            <th class="comp-table__th-old">{{ section.settings.col_old }}</th>
            <th class="comp-table__th-new">{{ section.settings.col_new }}</th>
          </tr>
        </thead>
        <tbody>
          {% for block in section.blocks %}
            <tr {{ block.shopify_attributes }}>
              <td>{{ block.settings.criteria }}</td>
              <td class="comp-table__td-old">{{ block.settings.old_value }}</td>
              <td class="comp-table__td-new">{{ block.settings.new_value }}</td>
            </tr>
          {% endfor %}
        </tbody>
      </table>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Comparison Table",
  "settings": [
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#faf8f4"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#3a3631"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent Color",
      "default": "#2fb5a0"
    },
    {
      "type": "color",
      "id": "card_bg",
      "label": "Table Background",
      "default": "#f0ece4"
    },
    {
      "type": "color",
      "id": "divider_color",
      "label": "Row Divider",
      "default": "#e4dfd6"
    },
    {
      "type": "color",
      "id": "highlight_color",
      "label": "Winner Column Header",
      "default": "#2fb5a0"
    },
    {
      "type": "color",
      "id": "highlight_bg",
      "label": "Winner Column Background",
      "default": "#e8f5f2"
    },
    {
      "type": "text",
      "id": "top_label",
      "label": "Top Label",
      "default": "Im Vergleich"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Precon vs. klassische Diäten"
    },
    {
      "type": "text",
      "id": "col_old",
      "label": "Left Column Header",
      "default": "Klassische Diät"
    },
    {
      "type": "text",
      "id": "col_new",
      "label": "Right Column Header",
      "default": "Precon"
    }
  ],
  "blocks": [
    {
      "type": "row",
      "name": "Row",
      "settings": [
        {
          "type": "text",
          "id": "criteria",
          "label": "Criteria",
          "default": "Kriterium"
        },
        {
          "type": "text",
          "id": "old_value",
          "label": "Classic Value",
          "default": "Nachteil"
        },
        {
          "type": "text",
          "id": "new_value",
          "label": "Precon Value",
          "default": "Vorteil"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Comparison Table",
      "blocks": [
        { "type": "row", "settings": { "criteria": "Hungergefühl", "old_value": "Ständig präsent", "new_value": "Sattmacher mit Protein" } },
        { "type": "row", "settings": { "criteria": "Nährstoffversorgung", "old_value": "Oft unausgewogen", "new_value": "Alle Vitamine & Mineralien" } },
        { "type": "row", "settings": { "criteria": "Alltagstauglichkeit", "old_value": "Kompliziert, viel Planung", "new_value": "30 Sekunden Zubereitung" } },
        { "type": "row", "settings": { "criteria": "Jojo-Effekt", "old_value": "Hohes Risiko", "new_value": "Strukturierte Halte-Phase" } },
        { "type": "row", "settings": { "criteria": "Wissenschaftliche Basis", "old_value": "Oft kurzlebige Trends", "new_value": "Ärztlich seit 1981" } }
      ]
    }
  ]
}
{% endschema %}