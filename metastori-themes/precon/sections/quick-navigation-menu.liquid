<style>
.quick-navigation-section{
    display:none;
}
.quick-nav-wrapper {
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 8px;
}
.qv-menu-item {
    color: #56473A;
    font-size: 11.6px;
    font-weight: 400;
    line-height: 1;
    padding: 0 8px 4px;
}
.qv-menu-item.qv-menu-active {
    font-weight: 700;
    text-decoration: underline;
    text-underline-offset: 4px;
}
</style>

<div class="quick-nav-menu">
    <div class="quick-nav-wrapper">
        {%- for block in section.blocks -%}
            <a class="qv-menu-item {% if forloop.first %}qv-menu-active{% endif %}" href="{{ block.settings.link }}">{{ block.settings.text }}</a>
        {%- endfor -%}
    </div>
</div>

<script>
document.addEventListener('DOMContentLoaded', () => {
    const tabs = document.querySelectorAll('.qv-menu-item');

    function activateTab(tab) {
        tabs.forEach(t => t.classList.remove('qv-menu-active'));
        tab.classList.add('qv-menu-active');
    }

    tabs.forEach(tab => {
        tab.addEventListener('click', (e) => {
            const href = tab.getAttribute('href');

            // Only handle anchor links
            if (href && href.startsWith('#')) {
                activateTab(tab);
            }
        });
    });
});
</script>

{% schema %}
{
  "name": "Quick-Navigation",
  "class": "quick-navigation-section",
  "blocks": [
    {
        "type": "menu",
        "name":"Menu",
        "settings":[
            {
                "type":"text",
                "id":"text",
                "label": "Text"
            },
            {
                "type":"url",
                "id":"link",
                "label": "Link"
            }
        ]
    }
  ],
  "presets": [
    {
      "name": "Quick-Navigation"
    }
  ]
}
{% endschema %}
