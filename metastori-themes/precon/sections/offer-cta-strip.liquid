<style>
  .cta-banner {
    padding: 48px 20px 44px;
    font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
    background-color: {{ section.settings.bg_color }};
    color: {{ section.settings.text_color }};
    text-align: center;
  }
  .cta-banner__heading {
    font-size: clamp(28px, 4.5vw, 44px);
    font-weight: 400;
    line-height: 1.2;
    margin: 0 0 10px;
  }
  .cta-banner__heading em {
    font-style: italic;
    font-family: Georgia, 'Times New Roman', serif;
    color: {{ section.settings.accent_color }};
  }
  .cta-banner__sub {
    font-size: 15px;
    opacity: 0.7;
    margin: 0 0 28px;
  }
  .cta-banner__prices {
    display: flex;
    align-items: baseline;
    justify-content: center;
    gap: 12px;
    margin-bottom: 24px;
  }
  .cta-banner__old {
    font-size: 16px;
    text-decoration: line-through;
    opacity: 0.5;
  }
  .cta-banner__new {
    font-size: clamp(32px, 5vw, 48px);
    font-weight: 700;
  }
  .cta-banner__btn {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: {{ section.settings.accent_color }};
    color: #fff;
    font-size: 17px;
    font-weight: 700;
    padding: 16px 40px;
    border-radius: 50px;
    border: none;
    cursor: pointer;
    text-decoration: none;
    transition: opacity 0.2s;
    margin-bottom: 24px;
  }
  .cta-banner__btn:hover {
    opacity: 0.9;
  }
  .cta-banner__btn::before {
    content: '✓';
  }
  .cta-banner__trust {
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    gap: 8px 24px;
    font-size: 13px;
    opacity: 0.6;
  }
  .cta-banner__trust-item::before {
    content: '✓ ';
    font-weight: 700;
  }

  @media (max-width: 600px) {
    .cta-banner {
      padding: 28px 14px 24px;
    }
    .cta-banner__heading {
      font-size: 22px;
      margin-bottom: 6px;
    }
    .cta-banner__sub {
      font-size: 13px;
      margin-bottom: 20px;
    }
    .cta-banner__old {
      font-size: 14px;
    }
    .cta-banner__new {
      font-size: 30px;
    }
    .cta-banner__prices {
      margin-bottom: 18px;
    }
    .cta-banner__btn {
      font-size: 15px;
      padding: 14px 32px;
      margin-bottom: 18px;
    }
    .cta-banner__trust {
      font-size: 11px;
      gap: 4px 16px;
    }
  }
</style>

<div class="cta-banner">
  <h2 class="cta-banner__heading">{{ section.settings.heading }}</h2>
  {% if section.settings.subtext != blank %}
    <p class="cta-banner__sub">{{ section.settings.subtext }}</p>
  {% endif %}

  <div class="cta-banner__prices">
    {% if section.settings.old_price != blank %}
      <span class="cta-banner__old">{{ section.settings.old_price }}</span>
    {% endif %}
    <span class="cta-banner__new">{{ section.settings.new_price }}</span>
  </div>

  {% if section.settings.product != blank %}
    {%- form 'product', section.settings.product -%}
      <input type="hidden" name="id" value="{{ section.settings.product.selected_or_first_available_variant.id }}">
      <button type="submit" class="cta-banner__btn">{{ section.settings.button_text }}</button>
    {%- endform -%}
  {% else %}
    <a href="{{ section.settings.button_url }}" class="cta-banner__btn">{{ section.settings.button_text }}</a>
  {% endif %}

  {% if section.blocks.size > 0 %}
    <div class="cta-banner__trust">
      {% for block in section.blocks %}
        <span class="cta-banner__trust-item" {{ block.shopify_attributes }}>{{ block.settings.text }}</span>
      {% endfor %}
    </div>
  {% endif %}
</div>

{% schema %}
{
  "name": "Offer CTA Strip",
  "settings": [
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#5a4a3a"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#f0ece4"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent / Button Color",
      "default": "#2fb5a0"
    },
    {
      "type": "html",
      "id": "heading",
      "label": "Heading (use <em> for accent)",
      "default": "Sichere Dir jetzt <em>42% Rabatt</em>"
    },
    {
      "type": "text",
      "id": "subtext",
      "label": "Subtext",
      "default": "4 Wochen komplett. Nur €3,89 pro Tag."
    },
    {
      "type": "text",
      "id": "old_price",
      "label": "Old Price",
      "default": "€187,70"
    },
    {
      "type": "text",
      "id": "new_price",
      "label": "New Price",
      "default": "€109,00"
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button Text",
      "default": "Jetzt 42% sparen"
    },
    {
      "type": "product",
      "id": "product",
      "label": "Product (for Add to Cart)"
    },
    {
      "type": "url",
      "id": "button_url",
      "label": "Button Link (if no product)"
    }
  ],
  "blocks": [
    {
      "type": "trust",
      "name": "Trust Point",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "default": "Gratis Versand"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Offer CTA Strip",
      "blocks": [
        { "type": "trust", "settings": { "text": "Gratis Versand" } },
        { "type": "trust", "settings": { "text": "30 Tage Geld-zurück" } },
        { "type": "trust", "settings": { "text": "1–3 Werktage" } }
      ]
    }
  ]
}
{% endschema %}