{% schema %}
{
  "name": "Image Text Section",
  "class": "cus-image-text-overlay",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Title",
      "default": "Einfache & schmackhafte Rezepte"
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "Die perfekte Ergänzung zur Precon Diät"
    },
    {
      "type": "image_picker",
      "id": "desktop_image",
      "label": "Desktop Image"
    },
    {
      "type": "image_picker",
      "id": "mobile_image",
      "label": "Mobile Image"
    }
  ],
  "presets": [
    {
      "name": "Image Text Overlay Section"
    }
  ]
}
{% endschema %}

<div class="image-text-overlay-section container">
  <div class="image-container">
    {% if section.settings.desktop_image != blank %}
    <picture>
      <source media="(max-width: 767px)" srcset="{{ section.settings.mobile_image | img_url: 'master' }}">
      <img src="{{ section.settings.desktop_image | image_url }}" alt="{{ section.settings.title }}" width="" height="">
    </picture>
    {% endif %}
    {% if section.settings.title != blank %}
        <div class="overlay-content">
            <h2>{{ section.settings.title }}</h2>
            <p>{{ section.settings.subtitle }}</p>
        </div>
    {% endif %}
  </div>
</div>

<style>
.cus-image-text-overlay .image-text-overlay-section {
  position: relative;
}

.cus-image-text-overlay .image-container {
  position: relative;
  width: 100%;
}

.cus-image-text-overlay .image-container img {
  width: 100%;
  height: auto;
  display: block;
}

.cus-image-text-overlay .overlay-content {
  position: absolute;
  top: 0px;
  left: 0px;
  background-color: #4a2c6f;
  color: white;
  width: 350px;
  text-align: left;
  background: #3DADBB;
    height: 100%;
    margin-left: 0;
    display: flex;
    flex-direction: column;
    justify-content: center;
    clip-path: ellipse(100% 100% at 0% 50%);
    padding-left: 30px;
    padding-right: 30px;
}

.cus-image-text-overlay .overlay-content h2 {
    font-size: 35px;
    font-weight: 700;
    margin-bottom: 0;
    line-height: 40px;
}

.cus-image-text-overlay .overlay-content p {
 font-size: 21px;
    line-height: 28px;
}

@media (max-width: 767px) {
.cus-image-text-overlay .overlay-content {
    top: auto;
    left: 0;
    width: 100%;
    height: 200px;
    padding: 15px;
    bottom: 0;
    right: 0;
    clip-path: ellipse(100% 100% at 50% 100%);
    text-align: center;
}

 .cus-image-text-overlay .overlay-content h2 {
    font-size: 30px;
    font-weight: 700;
    margin-bottom: 0;
    line-height: 34px;
  }

 .cus-image-text-overlay .overlay-content p {
    font-size: 18px;
    line-height: 24px;
  }
  .cus-image-text-overlay .image-text-overlay-section {
    padding: 0;
}
.cus-image-text-overlay .image-container img {
    width: 100%;
    display: block;
    height: 480px;
    object-position: center center !important;
    object-fit: cover !important;
}
}
</style>