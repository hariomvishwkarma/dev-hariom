{{ 'section-author.css' | asset_url | stylesheet_tag }}

{%- style -%}
  #shopify-section-{{ section.id }}.section {
    padding-block-start: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-block-end: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  .section-{{ section.id }} .author-description {
    width: 100%;
  }

  {% if section.settings.author_img_bg %}
    .section-{{ section.id }} .author-img-wrapper {
      background: {{ section.settings.author_img_bg }};
    }
    .section-{{ section.id }} .author-img:after {
      border-top: 20px solid {{ section.settings.author_img_bg }};
    }
  {% endif %}

  {% if section.settings.author_description_bg %}
    .section-{{ section.id }} .author-description {
      background: {{ section.settings.author_description_bg }};
    }
  {% endif %}

  {% if section.settings.author_description_font_color %}
    .section-{{ section.id }} .author-description-wrapper .metafield-rich_text_field {
      color: {{ section.settings.author_description_font_color }}
    }
  {% endif %}

  {% if section.settings.ad_side_padding %}
    .section-{{ section.id }} .author-description-wrapper {
      padding-left: {{ section.settings.ad_side_padding }}px;
      padding-right: {{ section.settings.ad_side_padding }}px;
    }
  {% endif %}

  {% if section.settings.author_img_font_color %}
    .section-{{ section.id }} .author-info,
    .section-{{ section.id }} .author-info a {
      color: {{ section.settings.author_img_font_color }};
    }
  {% endif %}

  {% if section.settings.author_social_links_color %}
    .section-{{ section.id }} .author-links .icon g,
    .section-{{ section.id }} .author-links .icon path{
      fill: {{ section.settings.author_social_links_color }};
    }
  {% endif %}

  @media screen and (min-width: 750px) {
    #shopify-section-{{ section.id }}.section {
      padding-block-start: {{ section.settings.padding_top }}px;
      padding-block-end: {{ section.settings.padding_bottom }}px;
    }
  }

  {% if section.settings.show_author_link_button %}
  #shopify-section-{{ section.id }} .author-button {
    padding: {{ section.settings.ab_padding_top_bottom }}px 0;
  }

  #shopify-section-{{ section.id }} .author-button .button {
    color: {{ section.settings.author_button_text_color }};
    background-color: {{ section.settings.author_button_color }};
  }

  #shopify-section-{{ section.id }} .author-button .button--primary {
    --primary-button-background: {{ section.settings.author_button_color.red }}, {{ section.settings.author_button_color.green }}, {{ section.settings.author_button_color.blue }};
  }
{% endif %}

{%- endstyle -%}

{% if template.name == 'rezepte' %}
 {% assign metaobject = metaobject.author.value %}
 {% capture template_class %}recipe recipe-template{% endcapture %}
{% endif %}

<div class="section-author page-width section-{{ section.id }}-padding section-{{ section.id }} {{ template_class }}">
  <blog-author>
    <div class="container">

      {% if section.settings.header_text != blank %}
        <div class="author-heading">
          <{{ section.settings.author_name_html_tag }} class="{{ section.settings.author_name_html_tag_styling }}">{{ section.settings.header_text }}</{{- section.settings.author_name_html_tag -}}>
        </div>
      {% endif %}

      <div class="row">
        
        <div class="author-img">
          <div class="author-img-wrapper">
            <picture>
              {% if metaobject.image.value %}
                {{- metaobject.image.value | image_url: width: 800 | image_tag: loading: 'eager', fetchpriority: 'high', sizes: '100vw', sizes: '400,500,600,700,800' -}}
              {% else %}
                {{ 'image' | placeholder_svg_tag: 'author-placeholder' }}
              {% endif %}
            </picture>
          </div>
        </div>

        <div class="author-description author-info">
          <div class="author-description-wrapper">
            {% if metaobject.name.value %}
              <div class="author-info-item name">
                <{{ section.settings.author_name_html_tag }} class="{{ section.settings.author_name_html_tag_styling }}">{{ metaobject.name.value }}</{{- section.settings.author_name_html_tag -}}>
              </div>
            {% endif %}

            {{ metaobject.description | metafield_tag }}

            <div class="author-links">
              {% assign author_data = metaobject.linklist.value  %}
              {%- for info in author_data -%}
                {% if info contains 'mailto' %}
                  <div class="author-link-item mailto">
                    <a href='{{ info }}'>
                      {%- render 'icon-global' , icon: 'mail' -%}
                    </a>
                  </div>
                {% endif %}

                {% if info contains 'tel' %}
                  <div class="author-link-item tel">
                    <a href="{{ info }}">
                      {%- render 'icon-global' , icon: 'phone-flip' -%}
                    </a>
                  </div>
                {% endif %}

                {% if info contains 'linkedin' %}
                  <div class="author-link-item linkedin">
                    <a href="{{ info }}">
                      {%- render 'icon-global' , icon: 'linkedin' -%}
                    </a>
                  </div>
                {% endif %}
                
                {% if info contains 'instagram' %}
                  <div class="author-link-item instagram">
                    <a href="{{ info }}">
                      {%- render 'icon-global' , icon: 'instagram' -%}
                    </a>
                  </div>
                {% endif %}

                {% if info contains 'tiktok' %}
                  <div class="author-link-item tiktok">
                    <a href="{{ info }}">
                      {%- render 'icon-global' , icon: 'tiktok' -%}
                    </a>
                  </div>
                {% endif %}

                {% if info contains 'twitter' %}
                  <div class="author-link-item twitter">
                    <a href="{{ info }}">
                      {%- render 'icon-global' , icon: 'twitter' -%}
                    </a>
                  </div>
                {% endif %}
              {%- endfor -%}
            </div>

            {% if template.name != 'author' %}
              {% if section.settings.show_author_link_button %}
                <div class="author-button">
                  <a class="button" href="{{ author.system.url }}">
                    {%- assign btn_label = section.settings.author_button_text -%}
                    {% if btn_label != blank %} 
                      {{ btn_label }} 
                    {% else %} 
                      {{ 'bso.blog.to_author_page' | t }}
                    {% endif %}
                  </a>
                </div>
              {% endif %}
            {% endif %}

          </div>
        </div>

      </div>
    </div>
  </blog-author>	
</div>

{% schema %}
{
  "name": "BSO Author",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "header_text",
      "label": "Header"
    },
    {
      "type": "header",
      "content": "Author image column"
    },
    {
      "type": "color",
      "id": "author_img_bg",
      "label": "Author Image background color",
      "default": "#F4F6F6"
    },
    {
      "type": "header",
      "content": "Author description column"
    },
    {
      "type": "select",
      "id": "author_name_html_tag",
      "label": "Author name H-Tag (h1 - h6 or Span)",
      "default": "h1",
      "options": [
        {
          "value": "h1",
          "label": "H1"
        },
        {
          "value": "h2",
          "label": "H2"
        },
        {
          "value": "h3",
          "label": "H3"
        },
        {
          "value": "h4",
          "label": "H4"
        },
        {
          "value": "h5",
          "label": "H5"
        },
        {
          "value": "h6",
          "label": "H6"
        },
        {
          "value": "span",
          "label": "SPAN"
        }
      ]
    },
    {
      "type": "select",
      "id": "author_name_html_tag_styling",
      "label": "Heading Styling (h1 - h6)",
      "default": "h1",
      "options": [
        {
          "value": "h1",
          "label": "H1"
        },
        {
          "value": "h2",
          "label": "H2"
        },
        {
          "value": "h3",
          "label": "H3"
        },
        {
          "value": "h4",
          "label": "H4"
        },
        {
          "value": "h5",
          "label": "H5"
        },
        {
          "value": "h6",
          "label": "H6"
        }
      ],
      "info": "Only changes the appearance, not the HTML tag as such"
    },
    {
      "type": "color",
      "id": "author_img_font_color",
      "label": "Author font color",
      "default": "#000"
    },
    {
      "type": "color",
      "id": "author_description_bg",
      "label": "Author Description background color",
      "default": "#F4F6F6"
    },
    {
      "type": "color",
      "id": "author_description_font_color",
      "label": "Author Description color",
      "default": "#000"
    },
    {
      "type": "range",
      "id": "ad_side_padding",
      "min": 0,
      "max": 50,
      "step": 5,
      "unit": "px",
      "label": "Author description column side padding",
      "default": 5
    },
    {
      "type": "color",
      "id": "author_social_links_color",
      "label": "Author social links color",
      "default": "#000"
    },
    {
      "type": "header",
      "content": "Section padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Top padding",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding",
      "default": 20
    },
    {
      "type": "header",
      "content": "Author button settings",
      "info": "This will only show on outside Author metaobject template"
    },
    {
      "type": "checkbox",
      "id": "show_author_link_button",
      "default": true,
      "label": "Show author link button"
    },
    {
      "type": "text",
      "id": "author_button_text",
      "label": "Button text"
    },
    {
      "type": "color",
      "id": "author_button_text_color",
      "label": "Button text color",
      "default": "#fff"
    },
    {
      "type": "color",
      "id": "author_button_color",
      "label": "Button color",
      "default": "#000000"
    },
    {
      "type": "range",
      "id": "ab_padding_top_bottom",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "label": "Padding bottom",
      "default": 10
    }
  ],
  "blocks": [],
  "disabled_on": {
    "templates": ["cart", "collection", "search", "article", "blog", "page", "product", "customers/account", "customers/addresses", "customers/login", "customers/order", "customers/register", "customers/reset_password", "index"],
    "groups": ["header", "footer"]
  },
  "presets": [
    {
      "name": "BSO author"
    }
  ]
}
{% endschema %}