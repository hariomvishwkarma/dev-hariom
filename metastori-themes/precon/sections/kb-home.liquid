{%- comment -%}
  Knowledge Base home grid — recreates HubSpot's `hs-kb-home-list--content_rich`.

  A responsive grid of category cards: icon + title (linked) + short description
  + a few preview article links + "Mehr anzeigen". Lives on the KB landing page
  (Page with handle `knowledge`, template page.knowledge).

  Category order comes from the shop metafield `custom.knowledge_base_category_order`
  (same source as the sidebar), falling back to all `knowledgebase_categories`.

  The hero + search live in the separate `kb-search` section (Component 3),
  placed above this one in the template order.
{%- endcomment -%}

{{ 'knowledgebase.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign categories = shop.metafields.custom.knowledge_base_category_order.value
  if categories == blank
    assign categories = shop.metaobjects.knowledgebase_categories.values
  endif
-%}

<div class="container kb-page kb-home">
  {%- if section.settings.heading != blank -%}
    <h1 class="heading h2 kb-home__title">{{ section.settings.heading }}</h1>
  {%- endif -%}

  <ul class="kb-home__grid">
    {%- for cat in categories -%}
      <li class="kb-home__card">
        <a class="kb-home__card-link" href="{{ cat.system.url }}">
          {%- liquid
            # icon is a file_reference: .value is a MediaImage for raster/webp
            # (use image_url) or a generic file for SVG (use .url).
            assign icon_media = cat.icon.value
            assign icon_src = ''
            if icon_media != blank
              assign icon_src = icon_media | image_url: width: 96
              if icon_src == blank
                assign icon_src = icon_media.url | default: icon_media
              endif
            endif
          -%}
          {%- if icon_src != blank -%}
            <span class="kb-home__icon">
              <img class="kb-home__icon-img" src="{{ icon_src }}" alt="" width="48" height="48" loading="lazy">
            </span>
          {%- endif -%}
          <h2 class="heading h5 kb-home__card-title">{{ cat.title }}</h2>
        </a>

        {%- if cat.short_description != blank -%}
          <div class="kb-home__desc">{{ cat.short_description | metafield_tag }}</div>
        {%- endif -%}

        {%- assign preview = cat.questions.value -%}
        {%- if preview != blank -%}
          <ul class="kb-home__links">
            {%- for faq in preview limit: section.settings.preview_count -%}
              <li class="kb-home__links-item">
                <a class="kb-home__link" href="{{ faq.system.url }}">{{ faq.question }}</a>
              </li>
            {%- endfor -%}
          </ul>
        {%- endif -%}

        <a class="kb-home__more" href="{{ cat.system.url }}">
          {{ section.settings.more_label | default: 'Mehr anzeigen' }}
        </a>
      </li>
    {%- endfor -%}
  </ul>
</div>

{% schema %}
{
  "name": "KB Home Grid",
  "tag": "section",
  "class": "shopify-section--kb-home",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading (optional)",
      "info": "Leave empty if the search section above already provides the heading."
    },
    {
      "type": "range",
      "id": "preview_count",
      "label": "Preview articles per card",
      "min": 0,
      "max": 8,
      "step": 1,
      "default": 4
    },
    {
      "type": "text",
      "id": "more_label",
      "label": "\"Show more\" label",
      "default": "Mehr anzeigen"
    }
  ],
  "presets": [
    { "name": "KB Home Grid" }
  ]
}
{% endschema %}
