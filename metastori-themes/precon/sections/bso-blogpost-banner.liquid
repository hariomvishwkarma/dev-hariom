{%- comment -%}
BSO Blog post banner
Template version: 1.0.2
{%- endcomment -%}

{%- assign background_color = article.metafields.banner.background_color.value | default: section.settings.banner_background -%}
{%- assign text_color = article.metafields.banner.text_color.value | default: section.settings.banner_text_color -%}
{%- assign article_image = section.settings.image | default: article.image -%}

{% liquid
  assign layout_class = section.settings.layout | replace: '_', '-'
%}

{{ 'component-blogpost-banner.css' | asset_url | stylesheet_tag }}

{% style %}
  #shopify-section-{{ section.id }} {
     --article-banner-background: {%- if background_color != blank -%}{{ background_color.rgb }}{%- else -%}var(--text-color) / 0.05{%- endif -%};
    --container-max-width: {{ settings.page_width }}px;
    --container-gutter: 2rem;
    --article-max-width: 100%;
    --article-banner-column-gap: 30px;
    --article-banner-grid: auto / auto;
    --article-banner-before-height: 100%;
    --article-banner-max-width: var(--container-max-width);
    --article-banner-content-padding-block-end: 2.5rem;
    --article-banner-content-padding-inline: 1.25rem;
    --article-banner-image-overlay: {% if section.settings.layout == 'image_text_overlay' %}{{ section.settings.overlay_color.rgb }} / {{ section.settings.overlay_opacity | divided_by: 100.0 }}{% else %}0 0 0 / 0{% endif %};

    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }

  #shopify-section-{{ section.id }} .article-banner:before {
    width: 100%;
  }

  #shopify-section-{{ section.id }} .article-banner-wrapper.container {
    padding-block-start: 0;
    padding-block-end: 0;
  }

  #shopify-section-{{ section.id }} .article-banner {
    padding-top: {{ section.settings.banner_padding_top }}px;
    padding-bottom: {{ section.settings.banner_padding_bottom }}px;
    {% if text_color != blank %}
      --text-color: {{ text_color.rgb }};
    {% endif %}
    padding-left: 0;
    padding-right: 0;
  }

  #shopify-section-{{ section.id }} .article-banner__image .aspect-ratio img {
    position: absolute;
    top: 0;
    left: 0;
    height: 100%;
    width: 100%;
    -o-object-fit: contain;
    object-fit: contain;
    border: 0;
    box-shadow: none;
  }
  
  #shopify-section-{{ section.id }} .icon {
    margin-top: -3px;
    stroke-width: 1px;
  }

  {% if section.settings.layout == 'content_first' or section.settings.layout == 'image_text_overlay' %}
    #shopify-section-{{ section.id }} .article-banner__content {
      gap: 2px 0;
      margin: 1rem 0;
    }
  {% endif %}

  {%- if article_image == blank -%}
    #shopify-section-{{ section.id }} {
      --article-banner-grid-area: auto;
    }
  {%- endif -%}

  {%- if article_image != blank -%}
    @media screen and (min-width: 750px) {
      #shopify-section-{{ section.id }} {
        --article-banner-max-width: var(--page-width);
      }
    }
    @media screen and (min-width: 1000px) {
      #shopify-section-{{ section.id }} {
        --article-banner-before-height: calc(100% - (var(--article-banner-image-offset) * min(100vw, var(--container-max-width))));
        --article-banner-image-offset: {% if section.settings.layout == 'content_first' %}0.12{% else %}0.07{% endif %};

        {% if section.settings.layout == 'image_left_text_right' %}
          --article-banner-grid: "image content" / {{ section.settings.banner_image_size }}fr {{ 100 | minus: section.settings.banner_image_size }}fr;
        {% elsif section.settings.layout == 'image_right_text_left' %}
          --article-banner-grid: "content image" / {{ 100 | minus: section.settings.banner_image_size }}fr {{ section.settings.banner_image_size }}fr;
        {% elsif section.settings.layout == 'image_text_overlay' %}
          --article-banner-grid: auto;
        {% endif %}


        {%- if section.settings.layout == 'image_text_overlay' or section.settings.layout == 'content_first' -%}
          --article-banner-grid-area: {% if section.settings.layout == 'image_text_overlay' %}1 / -1{% elsif section.settings.layout == 'content_first' %}auto{% endif %};
        {%- endif -%}

        {%- unless section.settings.layout == 'image_text_overlay' -%}
          --article-banner-content-padding-inline: 0;
        {%- endunless -%}

        {%- if section.settings.layout == 'image_left_text_right' -%}
          --article-banner-vertical-alignement: start;
          --article-banner-meta-vertical-alignment: flex-start;
          --article-banner-horizontal-alignement: flex-end;
        {%- elsif section.settings.layout == 'image_right_text_left' -%}
          --article-banner-vertical-alignement: start;
          --article-banner-meta-vertical-alignment: flex-start;
          --article-banner-horizontal-alignement: flex-end;
        {%- elsif section.settings.layout == 'image_text_overlay' -%}
          --article-banner-badge-background: 0 0 0 / 0 ;
        {%- else-%}

          --article-banner-max-width: var(--page-width);
        {%- endif -%}
      }

      #shopify-section-{{ section.id }} .article-banner__image .aspect-ratio img {
        {%- if section.settings.banner_image_aspect_ratio != "original" -%}
          -o-object-fit: cover;
          object-fit: cover;
        {% else %}
          -o-object-fit: contain;
          object-fit: contain;
        {% endif %}
      }
    }

    #shopify-section-{{ section.id }} .article-banner.image-left-text-right,
    #shopify-section-{{ section.id }} .article-banner.image-right-text-left {
      justify-items: self-start;
    }

    #shopify-section-{{ section.id }} .article-banner.image-left-text-right:before,
    #shopify-section-{{ section.id }} .article-banner.image-right-text-left:before {
      height: 100%;
    }
    #shopify-section-{{ section.id }} .article-banner.image-left-text-right .article-banner__content,
    #shopify-section-{{ section.id }} .article-banner.image-right-text-left .article-banner__content {
      padding: 0;
      align-self: center;
      gap: 0.5rem;
      width: 100%;
      padding: 15px;
    }
    #shopify-section-{{ section.id }} .article-banner__content .article__meta {
      gap: 0 5px;
    }

    #shopify-section-{{ section.id }} .article__meta .tag {
      background: none;
      background-color: {{ section.settings.badge_background }};
      color: {{ section.settings.badge_text_color }};
      padding: 3px;
      margin: 0;
    }

    @media screen and (min-width: 1000px) {
      #shopify-section-{{ section.id }} {
        {%- if section.settings.layout == 'image_left_text_right' or section.settings.layout == 'image_right_text_left' -%}
          --article-banner-column-gap:30px;
        {%- endif -%}
      }

      #shopify-section-{{ section.id }} .article-banner__content {
        grid-area: var(--article-banner-grid-area, content);
      }

      #shopify-section-{{ section.id }} .article-banner__image {
        grid-area: var(--article-banner-grid-area, image);
        position: relative;
      }
    }

    @media screen and (min-width: 1500px) {
      #shopify-section-{{ section.id }} .article-banner.image-left-text-right:before,
      #shopify-section-{{ section.id }} .article-banner.image-right-text-left:before {
        left: 0;
      }
    }

    @media screen and (max-width: 768px) {
      #shopify-section-{{ section.id }} .article-banner-wrapper.container {
        padding: 0;
      }
    }

    @media screen and (max-width: 1000px) {
      #shopify-section-{{ section.id }} .article-banner-wrapper.page-width {
        padding: 0;
      }

      #shopify-section-{{ section.id }} .article-banner.image-left-text-right .article-banner__content,
      #shopify-section-{{ section.id }} .article-banner.image-right-text-left .article-banner__content {
        padding: 15px 20px;
      }

      #shopify-section-{{ section.id }} .article-banner__image .aspect-ratio:before {
        padding-bottom: calc(100% / (var(--aspect-ratio-original)));
      }

      #shopify-section-{{ section.id }} .article-banner__image .aspect-ratio img {
        -o-object-fit: contain;
        object-fit: contain;
      }
    }

    
  {%- endif -%}

{% endstyle %}

{%- assign article_image = section.settings.image | default: article.image -%}
<div class="article-banner-container" bso-blogpost-banner="1.0.2">
  <div class="article-banner-wrapper container">
    <div class="article-banner {{ layout_class }} {% if section.settings.layout == 'image_text_overlay' %}sm:justify-items-center sm:align-items-center{% endif %}">
      <div class="article-banner__content text-custom">
        
        {% if article.tags.size > 0 or article.metafields.bso.reading_time.value != blank %}
          <div class="article__meta text-sm">
            {%- if article.tags.size > 0 and section.settings.show_tags -%}
              <a href="{{ blog.url }}/tagged/{{ article.tags.first | handle }}" class="tag link bold text-sm">{{- article.tags.first -}}</a>
            {%- endif -%}

            {%- unless section.settings.badge_content == 'none' -%}
              {%- if article.tags.size > 0 and section.settings.badge_content == 'tags' -%}
                <a href="{{ blog.url }}/tagged/{{ article.tags.first | handle }}" class="tag link bold text-sm">{{- article.tags.first -}}</a>
              {%- endif -%}

              {%- if section.settings.badge_content == 'blog' -%}
                <a href="{{ blog.url }}" class="tag link bold text-sm">{{- blog.title -}}</a>
              {%- endif -%}
            
            {%- endunless -%}

            {%- if article.metafields.bso.reading_time.value != blank and section.settings.show_reading_time -%}
              <span class="link-faded">
                {{- 'bso.blog.reading_time' | t: minutes: article.metafields.bso.reading_time.value -}}
              </span>
            {%- endif -%}
          </div>
        {%- endif -%}

        
        {%- if section.settings.blogpost_title_layout == 'title_subtitle' -%}
          <h1 class="heading {{ section.settings.heading_html_style }}">
            {{ article.title }}
            {%- if article.metafields.bso.subtitle != blank and section.settings.show_subtitle -%}
              <span class="visually-hidden">{{ section.settings.title_subtitle_separator }}</span>
              <span class="subtitle">{{ article.metafields.bso.subtitle }}</span>
            {%- endif -%}
          </h1>
        {%- elsif section.settings.blogpost_title_layout == 'subtitle_title' -%}
          <h1 class="heading {{ section.settings.heading_html_style }}">
            {%- if article.metafields.bso.subtitle != blank and section.settings.show_subtitle -%}
              {{ article.metafields.bso.subtitle }}
              <span class="visually-hidden">{{ section.settings.title_subtitle_separator }}</span>
              <span class="subtitle">{{ article.title }}</span>
            {% else %}
              {{- article.title -}}
            {%- endif -%}
          </h1>
        {%- elsif section.settings.blogpost_title_layout == 'subtitle_only' -%}
          <h1 class="heading {{ section.settings.heading_html_style }}">
            {%- if article.metafields.bso.subtitle != blank -%}
              {{ article.metafields.bso.subtitle }}
            {% else %}
              {{- article.title -}}
            {%- endif -%}
          </h1>
        {%- elsif section.settings.blogpost_title_layout == 'title_only' -%}
          <h1 class="heading {{ section.settings.heading_html_style }}">{{- article.title -}}</h1>
        {%- endif -%}

        {%- if section.settings.show_author or section.settings.show_comments_count -%}
          <div class="article__meta text-sm">
            {%- assign bso_author = article.metafields.bso.author -%}
            {%- if section.settings.show_author and bso_author != blank -%}
              {% for author in bso_author.value %}
                {% if forloop.index == 1 %}
                  {%- assign assigned_author = author.name.value %}
                  {%- assign author_url = author.system.url %}
                  {% break %}
                {% endif %}
              {% endfor %}
              <p class="text-with-icon link-faded tooltip">
                <span class="tooltiptext">{{- 'bso.blog.author' | t -}}</span>
                {% unless section.settings.enable_author_link_to_page %}
                  {%- assign author_url = assigned_author | replace: ' ', '-' | downcase | prepend: '#author-' %}
                {% endunless %}
                <a href="{{ author_url }}" class="article-author">
                  {%- render 'icon' with 'blog-author' -%} {{- 'bso.blog.written_by' | t: author: assigned_author -}}
                </a>
              </p>
            {%- endif -%}

            {%- if section.settings.show_comments_count and article.comments_enabled? -%}
              <p class="text-with-icon link-faded tooltip">
                <span class="tooltiptext">{{- 'bso.blog.comments' | t -}}</span>
                <a href="#blog-post-comments" class="article-comment-count">
                  {%- render 'icon' with 'blog-comment' -%}
                  {{- 'bso.comments.count' | t: count: article.comments_count -}}
                </a>
              </p>
            {%- endif -%}
          </div>
        {%- endif -%}

        {%- if section.settings.show_date_published -%}
          {% assign custom_published_date = article.metafields.bso.creation_date | date: '%s' | date: format: 'abbreviated_date' %}
          {%- assign published_at_date = article.published_at | date: format: 'abbreviated_date' -%}
          {% if custom_published_date != blank %}
            {%- assign published_at_date = custom_published_date -%}
          {% endif %}
          <div class="article__meta text-sm">
            {% if article.published_at != blank %}
              <p class="text-with-icon link-faded tooltip">
                <span class="tooltiptext">{{- 'bso.blog.date_published' | t -}}</span>
                {%- render 'icon' with 'blog-date' -%} <time>{{- published_at_date -}}</time>
              </p>
            {% else %}
              <p class="text-with-icon link-faded">
                {%- render 'icon' with 'blog-date' -%} <time>Hidden</time>
              </p>
            {% endif %}
            {%- if section.settings.show_date_updated -%}
              {%- assign published_at_date = article.published_at | date: '%s' -%}
              {% assign custom_published_date = article.metafields.bso.creation_date | date: '%s' %}
              {% if custom_published_date != blank %}
                {%- assign published_at_date = custom_published_date -%}
              {% endif %}
              
              {% comment %} {%- assign published_at_date = article.published_at | date: '%Y-%m-%d' -%} {% endcomment %}
              {%- assign updated_at_date = article.updated_at | date: '%s' -%}
              {% assign custom_update_date = article.metafields.bso.update_date | date: '%s' %}
              {% if custom_update_date != blank %}
                {%- assign updated_at_date = custom_update_date -%}
              {% endif %}

              {% if updated_at_date != published_at_date and updated_at_date > published_at_date %}
                <p class="text-with-icon link-faded tooltip">
                  <span class="tooltiptext">{{- 'bso.blog.date_updated' | t -}}</span>
                  {%- render 'icon' with 'refresh' -%} <time>{{- updated_at_date | date: format: 'abbreviated_date' -}}</time>
                </p>
              {% endif %}
            {%- endif -%}
          </div>
        {%- endif -%}
      </div>

      {%- if article_image != blank -%}
        {%- capture sizes -%}(max-width: 1149px) 100vw, {% if section.settings.layout == 'image_text_overlay' %}min({{ settings.page_width }}px, 100vw){% elsif section.settings.layout == 'content_first' %}var(--page-width){% else %}(max-width: 1399px) calc(100vw * 0.60 - 40px), calc(min({{ settings.page_width }}px, 100vw) * 0.60 - 64px){% endif %}{%- endcapture -%}
        {% assign aspect_ratio = article_image.aspect_ratio %}
        {% if section.settings.banner_image_aspect_ratio == "landscape" %}
          {% assign aspect_ratio = 1.7778 %}
        {% endif %}
        <div class="article-banner__image">
          <div class="aspect-ratio" style="--aspect-ratio: {{ aspect_ratio }}; --aspect-ratio-original: {{ article_image.aspect_ratio }};">
            {{- article_image | image_url: width: 1500 | image_tag: loading: 'eager', fetchpriority: 'high', sizes: sizes , widths: '200,300,400,500,600,700,800,900,1000,1200,1400,1600,1800,2000,2200,2400,2600,2800,3000,3200' -}}
          </div>
        </div>
      {%- endif -%}
    </div>
  </div>
</div>
{% schema %}
{
  "name": "BSO Blog Post Banner",
  "class": "shopify-section--main-article",
  "tag": "section",
  "settings": [
    {
      "type": "header",
      "content": "Banner"
    },
    {
      "type": "select",
      "id": "layout",
      "label": "Layout",
      "options": [
        {
          "label": "Content first",
          "value": "content_first"
        },
        {
          "label": "Image with text overlay",
          "value": "image_text_overlay"
        },
        {
          "label": "Image left content right",
          "value": "image_left_text_right"
        },
        {
          "label": "Image right content left",
          "value": "image_right_text_left"
        }
      ],
      "default": "image_right_text_left"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image",
      "info": "If none is set, blog post image is used."
    },
    {
      "type": "range",
      "id": "banner_image_size",
      "label": "Banner image size",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "%",
      "default": 68,
      "info": "This will only work on desktop. On mobile, the image will always take 100% width."
    },
    {
      "type": "select",
      "id": "banner_image_aspect_ratio",
      "label": "Banner image aspect ratio",
      "options": [
        { "value": "original", "label": "Original" },
        { "value": "landscape", "label": "Landscpae (16:9)" }
      ],
      "default": "landscape"
    },
    {
      "type": "select",
      "id": "heading_html_style",
      "label": "Blog post title style",
      "options": [
        { "value": "h1", "label": "H1" },
        { "value": "h2", "label": "H2" },
        { "value": "h3", "label": "H3" },
        { "value": "h4", "label": "H4" },
        { "value": "h5", "label": "H5" },
        { "value": "p", "label": "Paragraph" },
        { "value": "span", "label": "Span" }
      ],
      "default": "h2"
    },
    {
      "type": "select",
      "id": "blogpost_title_layout",
      "label": "Blogpost title layout",
      "options": [
        {
          "label": "Title",
          "value": "title_only"
        },
        {
          "label": "Title + Subtitle",
          "value": "title_subtitle"
        },
        {
          "label": "Subtitle + Title",
          "value": "subtitle_title"
        },
        {
          "label": "Subtitle only",
          "value": "subtitle_only"
        }
      ],
      "default": "title_subtitle"
    },
    {
      "type": "checkbox",
      "id": "show_subtitle",
      "label": "Show subtitle",
      "info": "Subtitle can be added on metafield [Subtitle](https://admin.shopify.com/store/precondiaet/settings/custom_data/article/metafields/262020530510)",
      "default": true
    },
    {
      "type": "text",
      "id": "title_subtitle_separator",
      "label": "Title and subtitle separator",
      "default": "-",
      "info": "Separator between title and subtitle for SEO purposes."
    },
    {
      "type": "select",
      "id": "badge_content",
      "label": "Badge content",
      "options": [
        {
          "label": "None",
          "value": "none"
        },
        {
          "label": "Tags",
          "value": "tags"
        },
        {
          "label": "Assigned blog",
          "value": "blog"
        }
      ],
      "default": "blog"
    },
    {
      "type": "color",
      "id": "badge_text_color",
      "label": "Badge text color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "badge_background",
      "label": "Badge background",
      "default": "#56473A"
    },
    {
      "type": "checkbox",
      "id": "show_reading_time",
      "label": "Show reading time",
      "info": "Reading time can be added on metafield [Reading time](https://admin.shopify.com/store/ajduiz-fw/settings/custom_data/article/metafields/261668012366)",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_author",
      "label": "Show author",
      "info": "Author can be added on blog post metafield [Author](https://admin.shopify.com/store/ajduiz-fw/settings/custom_data/article/metafields/261668077902) and can add entries on metaobject [Author](https://admin.shopify.com/store/ajduiz-fw/content/metaobjects/entries/author)",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "enable_author_link_to_page",
      "label": "Enable author link to page",
      "info": "If enabled, author link will redirect to the page. If disabled, it will scroll to the author block if available.",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "show_date_published",
      "label": "Show date published",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_date_updated",
      "label": "Show date updated",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_comments_count",
      "label": "Show comments count",
      "default": true
    },
    {
      "type": "color",
      "id": "banner_background",
      "label": "Background",
      "default": "#F4F6F6"
    },
    {
      "type": "color",
      "id": "banner_text_color",
      "label": "Text"
    },
    {
      "type": "color",
      "id": "overlay_color",
      "label": "Overlay",
      "default": "#000000"
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "label": "Overlay opacity",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "%",
      "default": 0
    },
    {
      "type": "header",
      "content": "Banner padding"
    },
    {
      "type": "range",
      "id": "banner_padding_top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "label": "Banner padding top",
      "default": 0
    },
    {
      "type": "range",
      "id": "banner_padding_bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "label": "Banner padding bottom",
      "default": 0
    },
    {
      "type": "header",
      "content": "Section padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "label": "Padding top",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "label": "Padding bottom",
      "default": 0
    }
  ],
  "presets": [
    {
      "name": "BSO Blog Post Banner"
    }
  ]
}
{% endschema %}