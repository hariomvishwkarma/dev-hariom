{%- comment -%}
  sections/usp-konzept.liquid
  Vergleichs-Section: Shake vs. Precon Konzept
  Eyebrow/Heading-Stil identisch zu kennst-du-das.liquid
  Fonts: Figtree 300/400/600 + Playfair Display 500 italic
  Blocks: "bad_point" (✕, orange) und "good_point" (✓, teal)
{%- endcomment -%}

{%- liquid
  assign c_bg       = section.settings.color_bg
  assign c_ink      = section.settings.color_ink
  assign c_mid      = section.settings.color_mid
  assign c_accent   = section.settings.color_accent
  assign c_signal   = section.settings.color_signal
  assign c_card_bg  = section.settings.color_card_bg
-%}

<div id="comp-{{ section.id }}" class="comp">
  <div class="comp__inner">

    <!-- Header -->
    <div class="comp__header">
      {%- if section.settings.eyebrow != blank -%}
        <p class="comp__eyebrow">
          <span class="comp__eyebrow-rule"></span>
          {{ section.settings.eyebrow }}
          <span class="comp__eyebrow-rule"></span>
        </p>
      {%- endif -%}

      <h2 class="comp__heading">
        {%- if section.settings.heading_line1 != blank -%}
          {{ section.settings.heading_line1 }}<br>
        {%- endif -%}
        {%- if section.settings.heading_line2 != blank -%}
          <em>{{ section.settings.heading_line2 }}</em>
        {%- endif -%}
      </h2>

      {%- if section.settings.subtitle != blank -%}
        <p class="comp__subtitle">{{ section.settings.subtitle }}</p>
      {%- endif -%}
    </div>

    <!-- Compare grid -->
    <div class="comp__compare">

      <!-- Left card: Shake -->
      <div class="comp__card comp__card--bad">
        <div class="comp__card-top">
          <span class="comp__card-label">
            <span class="comp__card-label-dot"></span>
            {{ section.settings.label_bad }}
          </span>
        </div>

        <div class="comp__card-img">
          {%- if section.settings.image_bad != blank -%}
            {{
              section.settings.image_bad
              | image_url: width: 800
              | image_tag: loading: 'lazy', alt: section.settings.label_bad, class: 'comp__card-img-inner'
            }}
          {%- else -%}
            <div class="comp__card-img-inner comp__card-img-inner--placeholder-bad"></div>
          {%- endif -%}
        </div>

        <ul class="comp__card-list" role="list">
          {%- for block in section.blocks -%}
            {%- if block.type == 'bad_point' -%}
              <li class="comp__card-item" {{ block.shopify_attributes }}>
                <span class="comp__card-item-icon" aria-hidden="true">
                  <svg viewBox="0 0 16 16" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <line x1="4" y1="4" x2="12" y2="12" stroke="currentColor"/>
                    <line x1="12" y1="4" x2="4" y2="12" stroke="currentColor"/>
                  </svg>
                </span>
                {{ block.settings.text }}
              </li>
            {%- endif -%}
          {%- endfor -%}
        </ul>
      </div>

      <!-- VS -->
      <div class="comp__vs" aria-hidden="true">VS.</div>

      <!-- Right card: Precon -->
      <div class="comp__card comp__card--good">
        <div class="comp__card-top">
          <span class="comp__card-label">
            <span class="comp__card-label-dot"></span>
            {{ section.settings.label_good }}
          </span>
        </div>

        <div class="comp__card-img">
          {%- if section.settings.image_good != blank -%}
            {{
              section.settings.image_good
              | image_url: width: 800
              | image_tag: loading: 'lazy', alt: section.settings.label_good, class: 'comp__card-img-inner'
            }}
          {%- else -%}
            <div class="comp__card-img-inner comp__card-img-inner--placeholder-good"></div>
          {%- endif -%}
        </div>

        <ul class="comp__card-list" role="list">
          {%- for block in section.blocks -%}
            {%- if block.type == 'good_point' -%}
              <li class="comp__card-item" {{ block.shopify_attributes }}>
                <span class="comp__card-item-icon" aria-hidden="true">
                  <svg viewBox="0 0 16 16" fill="none" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                    <polyline points="3,8.5 6.5,12 13,4.5" stroke="currentColor"/>
                  </svg>
                </span>
                {{ block.settings.text }}
              </li>
            {%- endif -%}
          {%- endfor -%}
        </ul>
      </div>

    </div>
  </div>
</div>

<style>
@import url('https://fonts.googleapis.com/css2?family=Figtree:wght@300;400;600&family=Playfair+Display:ital,wght@1,500&display=swap');

#comp-{{ section.id }} {
  --bg:      {{ c_bg }};
  --ink:     {{ c_ink }};
  --mid:     {{ c_mid }};
  --accent:  {{ c_accent }};
  --signal:  {{ c_signal }};
  --card-bg: {{ c_card_bg }};
  --rule:    rgba(86,71,58,0.08);
  --shadow:  rgba(86,71,58,0.09);
}

#comp-{{ section.id }},
#comp-{{ section.id }} * { box-sizing: border-box; }

#comp-{{ section.id }} {
  background: var(--bg);
  font-family: 'Figtree', sans-serif;
  -webkit-font-smoothing: antialiased;
  padding: 4rem 1.5rem;
}

/* ── Inner ── */
#comp-{{ section.id }} .comp__inner {
  max-width: 1100px;
  margin: 0 auto;
}

/* ── Header ── */
#comp-{{ section.id }} .comp__header {
  text-align: center;
  max-width: 620px;
  margin: 0 auto 2.75rem;
}

#comp-{{ section.id }} .comp__eyebrow {
  display: inline-flex;
  align-items: center;
  gap: 10px;
  font-size: 11px;
  font-weight: 600;
  letter-spacing: 0.24em;
  text-transform: uppercase;
  color: var(--accent);
  margin-bottom: 1rem;
}

#comp-{{ section.id }} .comp__eyebrow-rule {
  display: block;
  width: 22px;
  height: 1px;
  background: currentColor;
  opacity: 0.45;
}

#comp-{{ section.id }} .comp__heading {
  font-family: 'Figtree', sans-serif;
  font-size: clamp(32px, 4vw, 48px);
  font-weight: 300;
  color: var(--ink);
  line-height: 1.06;
  letter-spacing: -0.026em;
  text-wrap: balance;
  margin-bottom: 1rem;
}

#comp-{{ section.id }} .comp__heading em {
  font-family: 'Playfair Display', serif;
  font-style: italic;
  font-weight: 500;
  display: block;
  letter-spacing: -0.02em;
}

#comp-{{ section.id }} .comp__subtitle {
  font-size: clamp(15px, 1.15vw, 16.5px);
  line-height: 1.8;
  color: var(--mid);
}

/* ── Compare grid ── */
#comp-{{ section.id }} .comp__compare {
  display: grid;
  grid-template-columns: 1fr 64px 1fr;
  align-items: center;
  gap: 0 0.5rem;
}

/* ── VS ── */
#comp-{{ section.id }} .comp__vs {
  text-align: center;
  font-family: 'Figtree', sans-serif;
  font-size: 13px;
  font-weight: 600;
  letter-spacing: 0.1em;
  color: var(--mid);
  opacity: 0.55;
}

/* ── Cards ── */
#comp-{{ section.id }} .comp__card {
  background: var(--card-bg);
  border-radius: 16px;
  border: 1px solid var(--rule);
  overflow: hidden;
  display: flex;
  flex-direction: column;
  height: 100%;
  align-self: stretch;
  transition: box-shadow 0.22s ease;
}

#comp-{{ section.id }} .comp__card:hover {
  box-shadow: 0 14px 40px var(--shadow);
}

#comp-{{ section.id }} .comp__card--bad {
  border-top: 2.5px solid var(--signal);
  background: #F5F2EE;
}
#comp-{{ section.id }} .comp__card--good {
  border-top: 2.5px solid var(--accent);
  background: #EAF6F8;
}

/* ── Card label ── */
#comp-{{ section.id }} .comp__card-top {
  padding: 1.25rem 1.5rem 0;
}

#comp-{{ section.id }} .comp__card-label {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  font-size: 10.5px;
  font-weight: 600;
  letter-spacing: 0.2em;
  text-transform: uppercase;
  padding: 5px 12px;
  border-radius: 999px;
  border: 1.5px solid;
}

#comp-{{ section.id }} .comp__card--bad .comp__card-label {
  color: var(--signal);
  border-color: rgba(224,123,58,0.3);
  background: rgba(224,123,58,0.06);
}

#comp-{{ section.id }} .comp__card--good .comp__card-label {
  color: var(--accent);
  border-color: rgba(61,173,187,0.3);
  background: rgba(61,173,187,0.06);
}

#comp-{{ section.id }} .comp__card-label-dot {
  width: 5px;
  height: 5px;
  border-radius: 50%;
  background: currentColor;
  flex-shrink: 0;
}

/* ── Card image ── */
#comp-{{ section.id }} .comp__card-img {
  margin: 1rem 1.5rem 0;
  border-radius: 10px;
  overflow: hidden;
  aspect-ratio: 3 / 2;
}

#comp-{{ section.id }} .comp__card-img img,
#comp-{{ section.id }} .comp__card-img-inner {
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
}

#comp-{{ section.id }} .comp__card-img-inner--placeholder-bad {
  background: linear-gradient(135deg, #E5E0D8 0%, #D4CCBF 50%, #C0B8AA 100%);
}
#comp-{{ section.id }} .comp__card-img-inner--placeholder-good {
  background: linear-gradient(135deg, #C8E9ED 0%, #A8D8DF 50%, #88C8D0 100%);
}

/* ── Card list ── */
#comp-{{ section.id }} .comp__card-list {
  padding: 1.25rem 1.5rem 1.75rem;
  display: flex;
  flex-direction: column;
  gap: 0.65rem;
  flex: 1;
  list-style: none;
}

#comp-{{ section.id }} .comp__card-item {
  display: flex;
  align-items: flex-start;
  gap: 10px;
  font-size: 14px;
  line-height: 1.55;
  color: var(--ink);
}

#comp-{{ section.id }} .comp__card-item-icon {
  flex-shrink: 0;
  margin-top: 2px;
  width: 16px;
  height: 16px;
}

#comp-{{ section.id }} .comp__card-item-icon svg {
  width: 16px;
  height: 16px;
  display: block;
}

#comp-{{ section.id }} .comp__card--bad  .comp__card-item-icon { color: var(--signal); }
#comp-{{ section.id }} .comp__card--good .comp__card-item-icon { color: var(--accent); }

/* ── Responsive ── */
@media (max-width: 860px) {
  #comp-{{ section.id }} .comp__compare {
    grid-template-columns: 1fr;
    gap: 1rem 0;
  }
  #comp-{{ section.id }} .comp__vs {
    font-size: 16px;
    padding: 0.5rem 0;
    opacity: 0.4;
    justify-self: center;
  }
  #comp-{{ section.id }} .comp__card { height: auto; }
}

@media (max-width: 560px) {
  #comp-{{ section.id }} { padding: 2.5rem 1rem; }
  #comp-{{ section.id }} .comp__header { margin-bottom: 2rem; }
}

@media (prefers-reduced-motion: reduce) {
  #comp-{{ section.id }} .comp__card { transition: none; }
}
</style>

{% schema %}
{
  "name": "USP Konzept",
  "tag": "section",
  "settings": [
    { "type": "header", "content": "Kopfbereich" },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Der Unterschied"
    },
    {
      "type": "text",
      "id": "heading_line1",
      "label": "Überschrift Zeile 1",
      "default": "Einzelner Shake vs."
    },
    {
      "type": "text",
      "id": "heading_line2",
      "label": "Überschrift Zeile 2 (kursiv, Playfair)",
      "default": "Precon Konzept."
    },
    {
      "type": "textarea",
      "id": "subtitle",
      "label": "Untertitel",
      "default": "Der Vergleich zeigt: Ohne System fehlt die Struktur, die Dich ans Ziel bringt."
    },
    { "type": "header", "content": "Linke Karte – Shake" },
    {
      "type": "text",
      "id": "label_bad",
      "label": "Karten-Label",
      "default": "Nur ein Shake"
    },
    {
      "type": "image_picker",
      "id": "image_bad",
      "label": "Bild"
    },
    { "type": "header", "content": "Rechte Karte – Precon" },
    {
      "type": "text",
      "id": "label_good",
      "label": "Karten-Label",
      "default": "Precon Konzept"
    },
    {
      "type": "image_picker",
      "id": "image_good",
      "label": "Bild"
    },
    { "type": "header", "content": "Farben" },
    { "type": "color", "id": "color_bg",      "label": "Hintergrund",        "default": "#FAF9F5" },
    { "type": "color", "id": "color_ink",     "label": "Text dunkel",        "default": "#56473A" },
    { "type": "color", "id": "color_mid",     "label": "Text gedimmt",       "default": "#8C7C70" },
    { "type": "color", "id": "color_accent",  "label": "Akzentfarbe (Teal)", "default": "#3DADBB" },
    { "type": "color", "id": "color_signal",  "label": "Negativfarbe (Orange)", "default": "#e07b3a" },
    { "type": "color", "id": "color_card_bg", "label": "Karten-Hintergrund", "default": "#ffffff" }
  ],
  "blocks": [
    {
      "type": "bad_point",
      "name": "✕ Shake-Punkt",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Punkt",
          "default": "Kein klarer Plan – du bist auf Dich allein gestellt"
        }
      ]
    },
    {
      "type": "good_point",
      "name": "✓ Precon-Punkt",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Punkt",
          "default": "Handbuch mit klarem 3-Phasen-Plan"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "USP Konzept",
      "blocks": [
        { "type": "bad_point",  "settings": { "text": "Keine Anleitung – du bist auf Dich allein gestellt" } },
        { "type": "bad_point",  "settings": { "text": "Ein Geschmack – nach wenigen Tagen langweilig" } },
        { "type": "bad_point",  "settings": { "text": "Keine Phasen – kein strukturierter Ablauf" } },
        { "type": "bad_point",  "settings": { "text": "Kein Übergang – was kommt danach?" } },
        { "type": "bad_point",  "settings": { "text": "Einzelprodukt – teurer als im Paket" } },
        { "type": "good_point", "settings": { "text": "Handbuch mit klarem 3-Phasen-Plan" } },
        { "type": "good_point", "settings": { "text": "8+ Geschmäcker – Shakes UND Riegel" } },
        { "type": "good_point", "settings": { "text": "Strukturierte Phasen: Start → Hauptphase → Übergang" } },
        { "type": "good_point", "settings": { "text": "Haltephase für den sanften Übergang danach" } },
        { "type": "good_point", "settings": { "text": "Über 40% günstiger als Einzelkauf" } }
      ]
    }
  ]
}
{% endschema %}