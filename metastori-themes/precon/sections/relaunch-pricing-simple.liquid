{% comment %}
  Section: Relaunch Pricing – Simple
{% endcomment %}
<section class="rp-simple" style="background-color: {{ section.settings.bg_color }};">
  <div class="rp-simple__inner">

    {% if section.settings.badge_text != blank %}
      <span class="rp-simple__badge" style="background-color: {{ section.settings.badge_bg }}; color: {{ section.settings.badge_text_color }}; border-color: {{ section.settings.badge_text_color }};">{{ section.settings.badge_text }}</span>
    {% endif %}

    <h2 class="rp-simple__heading">
      {% if section.settings.heading_italic != blank %}
        <em style="color: {{ section.settings.accent_color }};">{{ section.settings.heading_italic }}</em>
      {% endif %}
      {{ section.settings.heading }}
    </h2>

    {% if section.settings.body_text != blank %}
      <div class="rp-simple__body" style="color: {{ section.settings.body_color }};">{{ section.settings.body_text }}</div>
    {% endif %}

    {% if section.settings.table_title != blank %}
      <h3 class="rp-simple__table-title">{{ section.settings.table_title }}</h3>
    {% endif %}

    <div class="rp-simple__scroll-hint">
      <span>Wischen zum Scrollen</span>
      <span class="rp-simple__scroll-arrow">&rarr;</span>
    </div>

    <div class="rp-simple__table-wrap">
      <table class="rp-simple__table">
        <thead>
          <tr style="background-color: {{ section.settings.table_header_bg }};">
            <th style="color: {{ section.settings.table_header_text }};">{{ section.settings.th_1 }}</th>
            <th style="color: {{ section.settings.table_header_text }};">{{ section.settings.th_2 }}</th>
            <th style="color: {{ section.settings.table_header_text }};">{{ section.settings.th_3 }}</th>
            <th style="color: {{ section.settings.table_header_text }};">{{ section.settings.th_4b }}</th>
            <th style="color: {{ section.settings.table_header_text }};">{{ section.settings.th_4 }}</th>
            <th style="color: {{ section.settings.table_header_text }};">{{ section.settings.th_5 }}</th>
          </tr>
        </thead>
        <tbody>
          {% for block in section.blocks %}
            {% if block.type == 'price_row' %}
              <tr {{ block.shopify_attributes }}>
                <td><strong>{{ block.settings.category }}</strong></td>
                <td><s>{{ block.settings.old_price }}</s></td>
                <td><strong>{{ block.settings.new_price }}</strong></td>
                <td><s>{{ block.settings.per_portion_old }}</s></td>
                <td><span class="rp-simple__highlight" style="color: {{ section.settings.accent_color }};">{{ block.settings.per_portion }}</span></td>
                <td>{{ block.settings.date }}</td>
              </tr>
            {% endif %}
          {% endfor %}
        </tbody>
      </table>
    </div>

    {% if section.settings.disclaimer_text != blank %}
      <p class="rp-simple__disclaimer" style="color: {{ section.settings.disclaimer_color }};">{{ section.settings.disclaimer_text }}</p>
    {% endif %}

  </div>
</section>

<style>
  .rp-simple {
    padding: 60px 20px;
  }
  .rp-simple__inner {
    max-width: 1200px;
    margin: 0 auto;
  }
  .rp-simple__badge {
    display: inline-block;
    font-size: 11px;
    letter-spacing: 2px;
    text-transform: uppercase;
    border: 1px solid;
    border-radius: 20px;
    padding: 8px 20px;
    margin-bottom: 20px;
    font-weight: 500;
  }
  .rp-simple__heading {
    font-size: 36px;
    font-weight: 400;
    color: {{ section.settings.heading_color }};
    margin: 0 0 16px;
    line-height: 1.2;
  }
  .rp-simple__heading em {
    display: block;
    font-family: Georgia, 'Times New Roman', serif;
    font-style: italic;
  }
  .rp-simple__body {
    font-size: 15px;
    line-height: 1.7;
    max-width: 720px;
    margin-bottom: 32px;
  }
  .rp-simple__table-title {
    font-size: 16px;
    font-weight: 600;
    color: {{ section.settings.heading_color }};
    margin: 0 0 12px;
  }
  .rp-simple__scroll-hint {
    display: none;
  }
  .rp-simple__table-wrap {
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
  }
  .rp-simple__table {
    width: 100%;
    border-collapse: separate;
    border-spacing: 0;
    border-radius: 12px;
    overflow: hidden;
    box-shadow: 0 1px 4px rgba(0,0,0,0.06);
  }
  .rp-simple__table thead th {
    text-align: left;
    font-size: 11px;
    letter-spacing: 1px;
    padding: 14px 12px;
    font-weight: 600;
    white-space: nowrap;
  }
  .rp-simple__table tbody tr {
    background: {{ section.settings.table_row_odd }};
    border-bottom: 1px solid #f0ece6;
  }
  .rp-simple__table tbody tr:nth-child(even) {
    background: {{ section.settings.table_row_even }};
  }
  .rp-simple__table tbody td {
    padding: 12px;
    font-size: 14px;
    color: {{ section.settings.table_text_color }};
    text-align: left;
    white-space: nowrap;
  }
  .rp-simple__table tbody td s {
    color: {{ section.settings.table_strikethrough_color }};
    text-decoration: line-through;
  }
  .rp-simple__highlight {
    font-weight: 700;
  }
  .rp-simple__disclaimer {
    font-size: 12px;
    line-height: 1.5;
    margin: 12px 0 0;
  }

  @media (max-width: 500px) {
    .rp-simple {
      padding: 40px 12px;
      overflow-x: hidden;
    }
    .rp-simple__heading {
      font-size: 24px;
    }
    .rp-simple__body {
      font-size: 13px;
    }
    .rp-simple__badge {
      font-size: 10px;
      padding: 6px 14px;
      letter-spacing: 1px;
    }
    .rp-simple__table-title {
      font-size: 14px;
    }
    .rp-simple__disclaimer {
      font-size: 11px;
    }
    .rp-simple__scroll-hint {
      display: flex;
      align-items: center;
      gap: 6px;
      font-size: 12px;
      color: {{ section.settings.accent_color }};
      margin-bottom: 8px;
    }
    .rp-simple__scroll-arrow {
      display: inline-block;
      animation: rp-simple-nudge 1.5s ease-in-out infinite;
    }
    @keyframes rp-simple-nudge {
      0%, 100% { transform: translateX(0); }
      50% { transform: translateX(6px); }
    }
    .rp-simple__table thead th,
    .rp-simple__table tbody td {
      padding: 8px 6px;
      font-size: 11px;
    }
  }
</style>

