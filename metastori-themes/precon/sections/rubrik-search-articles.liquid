{%- assign featured = section.settings.featured_article -%}
{%- assign articles_per_page = section.settings.articles_per_page | default: 9 -%}
<section class="bsa" id="bsa-{{ section.id }}" style="background:{{ section.settings.section_bg }};">
  <div class="bsa__inner page-width">

    <!-- ── Suchleiste ── -->
    <div class="bsa__search-wrap">
      <div class="bsa__search-box" style="border-color:{{ section.settings.search_border }};">
        <svg class="bsa__search-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
        <input
          type="text"
          id="bsa-search-{{ section.id }}"
          class="bsa__search-input"
          placeholder="{{ section.settings.search_placeholder | default: 'In diesem Blog suchen…' }}"
          aria-label="Artikel suchen"
          style="color:{{ section.settings.search_text }};"
        >
      </div>
      <p class="bsa__no-results" id="bsa-no-results-{{ section.id }}" style="display:none;color:{{ section.settings.search_text }};">
        Keine Artikel gefunden.
      </p>
    </div>

    <!-- ── Featured Artikel ── -->
    {%- if featured != blank -%}
      {%- assign feat_words = featured.content | strip_html | split: ' ' -%}
      {%- assign feat_read_time = feat_words.size | divided_by: 200 -%}
      {%- if feat_read_time < 1 -%}{%- assign feat_read_time = 1 -%}{%- endif -%}
      <div class="bsa__featured-wrap" id="bsa-featured-{{ section.id }}">
        {%- if section.settings.featured_eyebrow != blank -%}
          <p class="bsa__featured-eyebrow" style="color:{{ section.settings.featured_eyebrow_color }};">
            <span style="margin-right:4px;">✦</span>{{ section.settings.featured_eyebrow }}
          </p>
        {%- endif -%}
        <a href="{{ featured.url }}" class="bsa__featured">
          <div class="bsa__featured-img-wrap">
            {%- if featured.image != blank -%}
              {{ featured.image | image_url: width: 1400 | image_tag:
                class: 'bsa__featured-img',
                loading: 'eager',
                sizes: '(max-width: 768px) 100vw, 75vw',
                widths: '600, 900, 1200, 1400',
                alt: featured.title
              }}
            {%- else -%}
              <div class="bsa__featured-img-placeholder" style="background:#ccc;"></div>
            {%- endif -%}
            <div class="bsa__featured-overlay"></div>
            {%- if section.settings.featured_badge_text != blank -%}
              <span class="bsa__featured-badge" style="background:{{ section.settings.featured_badge_bg }};color:{{ section.settings.featured_badge_text_color }};">
                ✦ {{ section.settings.featured_badge_text }}
              </span>
            {%- endif -%}
            <div class="bsa__featured-content">
              <h2 class="bsa__featured-title">{{ featured.title }}</h2>
              {%- if featured.excerpt_or_content != blank -%}
                <p class="bsa__featured-excerpt">{{ featured.excerpt_or_content | strip_html | truncate: 200 }}</p>
              {%- endif -%}
              <span class="bsa__featured-read-time">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
                {{ feat_read_time }} Min. Lesezeit
              </span>
            </div>
          </div>
        </a>
      </div>
    {%- endif -%}

    <!-- ── Artikel Grid ── -->
    <div class="bsa__grid" id="bsa-grid-{{ section.id }}">
      {%- paginate blog.articles by articles_per_page -%}
        {%- for article in blog.articles -%}
          {%- assign art_words = article.content | strip_html | split: ' ' -%}
          {%- assign art_read_time = art_words.size | divided_by: 200 -%}
          {%- if art_read_time < 1 -%}{%- assign art_read_time = 1 -%}{%- endif -%}
          <article
            class="bsa__card"
            data-title="{{ article.title | downcase | escape }}"
            data-excerpt="{{ article.excerpt_or_content | strip_html | downcase | truncate: 200 | escape }}"
          >
            <a href="{{ article.url }}" class="bsa__card-link">
              <div class="bsa__card-img-wrap">
                {%- if article.image != blank -%}
                  {{ article.image | image_url: width: 700 | image_tag:
                    class: 'bsa__card-img',
                    loading: 'lazy',
                    sizes: '(max-width: 768px) 100vw, 33vw',
                    widths: '300, 500, 700',
                    alt: article.title
                  }}
                {%- else -%}
                  <div class="bsa__card-img-placeholder" style="background:{{ section.settings.placeholder_color }};"></div>
                {%- endif -%}
                {%- if section.settings.show_category_badge -%}
                  <span class="bsa__card-cat" style="background:{{ section.settings.cat_badge_bg }};color:{{ section.settings.cat_badge_text }};">
                    {%- if section.settings.cat_badge_emoji != blank -%}{{ section.settings.cat_badge_emoji }} {%- endif -%}
                    {{ blog.title }}
                  </span>
                {%- endif -%}
              </div>
              <div class="bsa__card-body">
                <h3 class="bsa__card-title" style="color:{{ section.settings.card_title_color }};">{{ article.title }}</h3>
                {%- if article.excerpt_or_content != blank -%}
                  <p class="bsa__card-excerpt" style="color:{{ section.settings.card_excerpt_color }};">{{ article.excerpt_or_content | strip_html | truncate: 120 }}</p>
                {%- endif -%}
                <div class="bsa__card-meta">
                  <span class="bsa__card-read-time" style="color:{{ section.settings.card_meta_color }};">
                    <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
                    {{ art_read_time }} Min. Lesezeit
                  </span>
                </div>
              </div>
            </a>
          </article>
        {%- endfor -%}
        {%- if paginate.pages > 1 -%}
          <div class="bsa__pagination">
            {{ paginate | default_pagination | replace: '&laquo; Previous', '← Zurück' | replace: 'Next &raquo;', 'Weiter →' }}
          </div>
        {%- endif -%}
      {%- endpaginate -%}
    </div>

    <!-- ── CTA Banner ── -->
    {%- if section.settings.cta_heading != blank or section.settings.cta_btn1_label != blank -%}
      <div class="bsa-cta">
        <div class="bsa-cta__inner" style="background:{{ section.settings.cta_bg_color }};">
          <div class="bsa-cta__left">
            {%- if section.settings.cta_eyebrow != blank -%}
              <p class="bsa-cta__eyebrow" style="color:{{ section.settings.cta_eyebrow_color }};">{{ section.settings.cta_eyebrow }}</p>
            {%- endif -%}
            {%- if section.settings.cta_heading != blank -%}
              <h2 class="bsa-cta__heading" style="color:{{ section.settings.cta_heading_color }};">{{ section.settings.cta_heading }}</h2>
            {%- endif -%}
            {%- if section.settings.cta_subtext != blank -%}
              <p class="bsa-cta__subtext" style="color:{{ section.settings.cta_subtext_color }};">{{ section.settings.cta_subtext }}</p>
            {%- endif -%}
          </div>
          <div class="bsa-cta__right">
            {%- if section.settings.cta_btn1_label != blank -%}
              <a href="{{ section.settings.cta_btn1_link }}" class="bsa-cta__btn bsa-cta__btn--primary" style="background:{{ section.settings.cta_btn1_bg }};color:{{ section.settings.cta_btn1_text }};border-color:{{ section.settings.cta_btn1_bg }};">
                {{ section.settings.cta_btn1_label }} &rarr;
              </a>
            {%- endif -%}
            {%- if section.settings.cta_btn2_label != blank -%}
              <a href="{{ section.settings.cta_btn2_link }}" class="bsa-cta__btn bsa-cta__btn--secondary" style="color:{{ section.settings.cta_btn2_text }};border-color:{{ section.settings.cta_btn2_text }};">
                {{ section.settings.cta_btn2_label }}
              </a>
            {%- endif -%}
          </div>
        </div>
      </div>
    {%- endif -%}

  </div>
</section>

<style>
  .bsa {
    padding: 56px 0 80px;
  }
  .bsa__inner {
    padding-left: max(24px, 5rem);
    padding-right: max(24px, 5rem);
    display: flex;
    flex-direction: column;
    gap: 0;
  }

  /* ── Search ── */
  .bsa__search-wrap {
    margin-bottom: 40px;
  }
  .bsa__search-box {
    display: flex;
    align-items: center;
    gap: 10px;
    border: 1.5px solid;
    border-radius: 50px;
    padding: 12px 20px;
    max-width: 580px;
    background: {{ section.settings.search_bg }};
  }
  .bsa__search-icon {
    flex-shrink: 0;
    opacity: 0.5;
  }
  .bsa__search-input {
    border: none;
    background: transparent;
    font-size: 15px;
    width: 100%;
    outline: none;
  }
  .bsa__no-results {
    margin-top: 12px;
    font-size: 14px;
    opacity: 0.6;
  }

  /* ── Featured ── */
  .bsa__featured-wrap {
    margin-bottom: 48px;
  }
  .bsa__featured-eyebrow {
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    margin-bottom: 14px;
  }
  .bsa__featured {
    display: block;
    text-decoration: none;
    border-radius: 20px;
    overflow: hidden;
  }
  .bsa__featured-img-wrap {
    position: relative;
    width: 100%;
    height: 440px;
    overflow: hidden;
  }
  .bsa__featured-img,
  .bsa__featured-img-placeholder {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.4s ease;
  }
  .bsa__featured:hover .bsa__featured-img {
    transform: scale(1.03);
  }
  .bsa__featured-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgba(0,0,0,0.72) 0%, rgba(0,0,0,0.2) 50%, transparent 100%);
    pointer-events: none;
  }
  .bsa__featured-badge {
    position: absolute;
    top: 20px;
    left: 20px;
    padding: 6px 16px;
    border-radius: 50px;
    font-size: 13px;
    font-weight: 600;
  }
  .bsa__featured-content {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    padding: 28px 32px;
    z-index: 2;
  }
  .bsa__featured-title {
    font-size: clamp(20px, 2.5vw, 32px);
    font-weight: 700;
    color: #fff;
    margin: 0 0 10px;
    line-height: 1.2;
    max-width: 700px;
  }
  .bsa__featured-excerpt {
    font-size: 15px;
    color: rgba(255,255,255,0.82);
    margin: 0 0 16px;
    max-width: 580px;
    line-height: 1.6;
  }
  .bsa__featured-read-time {
    font-size: 13px;
    color: rgba(255,255,255,0.75);
    display: inline-flex;
    align-items: center;
    gap: 5px;
  }

  /* ── Grid ── */
  .bsa__grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
  }
  .bsa__card {
    background: {{ section.settings.card_bg }};
    border-radius: 16px;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    transition: box-shadow 0.2s ease;
  }
  .bsa__card:hover {
    box-shadow: 0 6px 24px rgba(0,0,0,0.09);
  }
  .bsa__card.is-hidden {
    display: none;
  }
  .bsa__card-link {
    display: flex;
    flex-direction: column;
    height: 100%;
    text-decoration: none;
    color: inherit;
  }
  .bsa__card-img-wrap {
    position: relative;
    width: 100%;
    aspect-ratio: 16 / 10;
    overflow: hidden;
    flex-shrink: 0;
  }
  .bsa__card-img,
  .bsa__card-img-placeholder {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.35s ease;
  }
  .bsa__card:hover .bsa__card-img {
    transform: scale(1.04);
  }
  .bsa__card-cat {
    position: absolute;
    top: 12px;
    left: 12px;
    padding: 4px 12px;
    border-radius: 50px;
    font-size: 12px;
    font-weight: 600;
  }
  .bsa__card-body {
    display: flex;
    flex-direction: column;
    flex: 1;
    padding: 18px 18px 14px;
  }
  .bsa__card-title {
    font-size: 17px;
    font-weight: 700;
    line-height: 1.3;
    margin: 0 0 8px;
  }
  .bsa__card-excerpt {
    font-size: 14px;
    line-height: 1.6;
    margin: 0 0 14px;
    flex: 1;
  }
  .bsa__card-meta {
    padding-top: 12px;
    border-top: 1px solid rgba(0,0,0,0.07);
    font-size: 13px;
  }
  .bsa__card-read-time {
    display: inline-flex;
    align-items: center;
    gap: 4px;
  }

  /* ── Pagination ── */
  .bsa__pagination {
    grid-column: 1 / -1;
    display: flex;
    justify-content: center;
    gap: 8px;
    padding-top: 16px;
    font-size: 14px;
  }
  .bsa__pagination a, .bsa__pagination span {
    padding: 8px 14px;
    border-radius: 8px;
    border: 1px solid {{ section.settings.search_border }};
    text-decoration: none;
    color: {{ section.settings.card_title_color }};
  }
  .bsa__pagination .current {
    background: {{ section.settings.cat_badge_bg }};
    color: {{ section.settings.cat_badge_text }};
    border-color: {{ section.settings.cat_badge_bg }};
  }

  /* ── CTA Banner ── */
  .bsa-cta {
    margin-top: 56px;
  }
  .bsa-cta__inner {
    border-radius: 20px;
    padding: 48px 56px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 40px;
  }
  .bsa-cta__left {
    flex: 1;
  }
  .bsa-cta__eyebrow {
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    margin: 0 0 12px;
  }
  .bsa-cta__heading {
    font-size: clamp(22px, 2.5vw, 32px);
    font-weight: 700;
    margin: 0 0 10px;
    line-height: 1.2;
  }
  .bsa-cta__subtext {
    font-size: 14px;
    margin: 0;
    opacity: 0.7;
  }
  .bsa-cta__right {
    display: flex;
    gap: 12px;
    align-items: center;
    flex-shrink: 0;
  }
  .bsa-cta__btn {
    display: inline-flex;
    align-items: center;
    padding: 14px 28px;
    font-size: 15px;
    font-weight: 600;
    border-radius: 50px;
    border: 2px solid;
    text-decoration: none;
    transition: opacity 0.2s ease;
    white-space: nowrap;
  }
  .bsa-cta__btn:hover { opacity: 0.85; }
  .bsa-cta__btn--secondary { background: transparent; }

  /* ── Responsive ── */
  @media (max-width: 900px) {
    .bsa__grid {
      grid-template-columns: repeat(2, 1fr);
    }
    .bsa-cta__inner {
      flex-direction: column;
      padding: 36px 28px;
      text-align: center;
    }
    .bsa-cta__right {
      flex-direction: column;
      width: 100%;
    }
    .bsa-cta__btn {
      justify-content: center;
      width: 100%;
    }
  }
  @media (max-width: 768px) {
    .bsa {
      padding: 28px 0 48px;
      overflow-x: hidden;
    }
    /* Fix: Seitenabstand auf Mobile — !important überschreibt Shopify page-width */
    .bsa__inner.page-width,
    .bsa__inner {
      padding-left: 16px !important;
      padding-right: 16px !important;
      max-width: 100% !important;
    }
    /* Fix: Suchleiste volle Breite */
    .bsa__search-box {
      max-width: 100%;
      width: 100%;
    }
    .bsa__search-wrap {
      margin-bottom: 20px;
    }
    /* 2 Spalten → schmaler */
    .bsa__grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 12px;
    }
    .bsa__featured-wrap {
      margin-bottom: 20px;
    }
    .bsa__featured {
      border-radius: 12px;
    }
    .bsa__featured-img-wrap {
      height: 200px;
    }
    .bsa__featured-content {
      padding: 14px 16px;
    }
    .bsa__featured-title {
      font-size: 17px;
      margin-bottom: 6px;
    }
    .bsa__featured-excerpt {
      display: none;
    }
    /* Kompakte Cards */
    .bsa__card-img-wrap {
      height: 110px;
      aspect-ratio: unset;
    }
    .bsa__card-body {
      padding: 10px 10px 8px;
    }
    .bsa__card-title {
      font-size: 13px;
      font-weight: 700;
      margin-bottom: 4px;
      color: #56473A !important;
    }
    /* Teaser-Text max 2 Zeilen */
    .bsa__card-excerpt {
      display: -webkit-box !important;
      -webkit-line-clamp: 2;
      -webkit-box-orient: vertical;
      overflow: hidden;
      font-size: 11px;
      line-height: 1.4;
      margin-bottom: 6px;
      color: #56473A !important;
    }
    .bsa__card-meta {
      padding-top: 6px;
      font-size: 11px;
    }
  }
</style>

<script>
(function() {
  var section = document.getElementById('bsa-{{ section.id }}');
  if (!section) return;
  var input = document.getElementById('bsa-search-{{ section.id }}');
  var cards = section.querySelectorAll('.bsa__card');
  var noResults = document.getElementById('bsa-no-results-{{ section.id }}');
  var featured = document.getElementById('bsa-featured-{{ section.id }}');
  input.addEventListener('input', function() {
    var q = input.value.trim().toLowerCase();
    var visible = 0;
    cards.forEach(function(card) {
      var title = card.dataset.title || '';
      var excerpt = card.dataset.excerpt || '';
      var match = !q || title.indexOf(q) > -1 || excerpt.indexOf(q) > -1;
      card.classList.toggle('is-hidden', !match);
      if (match) visible++;
    });
    if (noResults) noResults.style.display = visible === 0 ? 'block' : 'none';
    if (featured) featured.style.display = q ? 'none' : 'block';
  });
})();
</script>

{% schema %}
{
  "name": "Blog Suche & Artikel",
  "tag": "section",
  "class": "section-blog-search-articles",
  "settings": [
    {
      "type": "color",
      "id": "section_bg",
      "label": "Sectionhintergrund",
      "default": "#f5f4f0"
    },
    {
      "type": "header",
      "content": "Suchleiste"
    },
    {
      "type": "text",
      "id": "search_placeholder",
      "label": "Platzhaltertext",
      "default": "In diesem Blog suchen…"
    },
    {
      "type": "color",
      "id": "search_bg",
      "label": "Suchfeld Hintergrund",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "search_border",
      "label": "Suchfeld Rahmen",
      "default": "#d0cfc8"
    },
    {
      "type": "color",
      "id": "search_text",
      "label": "Suchfeld Textfarbe",
      "default": "#1a2420"
    },
    {
      "type": "header",
      "content": "Featured Artikel"
    },
    {
      "type": "article",
      "id": "featured_article",
      "label": "Featured Artikel"
    },
    {
      "type": "text",
      "id": "featured_eyebrow",
      "label": "Eyebrow Text",
      "default": "Empfohlener Artikel"
    },
    {
      "type": "color",
      "id": "featured_eyebrow_color",
      "label": "Eyebrow Farbe",
      "default": "#2a7a72"
    },
    {
      "type": "text",
      "id": "featured_badge_text",
      "label": "Badge Text",
      "default": "Empfohlen"
    },
    {
      "type": "color",
      "id": "featured_badge_bg",
      "label": "Badge Hintergrund",
      "default": "#2a7a72"
    },
    {
      "type": "color",
      "id": "featured_badge_text_color",
      "label": "Badge Textfarbe",
      "default": "#ffffff"
    },
    {
      "type": "header",
      "content": "Artikel Kacheln"
    },
    {
      "type": "range",
      "id": "articles_per_page",
      "label": "Artikel pro Seite",
      "min": 3,
      "max": 18,
      "step": 3,
      "default": 9
    },
    {
      "type": "color",
      "id": "card_bg",
      "label": "Karten Hintergrund",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "card_title_color",
      "label": "Karten Titelfarbe",
      "default": "#56473A"
    },
    {
      "type": "color",
      "id": "card_excerpt_color",
      "label": "Karten Textfarbe",
      "default": "#56473A"
    },
    {
      "type": "color",
      "id": "card_meta_color",
      "label": "Karten Meta-Farbe",
      "default": "#888888"
    },
    {
      "type": "color",
      "id": "placeholder_color",
      "label": "Platzhalter Farbe (kein Bild)",
      "default": "#d4f0ed"
    },
    {
      "type": "checkbox",
      "id": "show_category_badge",
      "label": "Kategorie-Badge anzeigen",
      "default": true
    },
    {
      "type": "text",
      "id": "cat_badge_emoji",
      "label": "Kategorie-Badge Emoji",
      "default": "🥗"
    },
    {
      "type": "color",
      "id": "cat_badge_bg",
      "label": "Kategorie-Badge Hintergrund",
      "default": "#1a5c57"
    },
    {
      "type": "color",
      "id": "cat_badge_text",
      "label": "Kategorie-Badge Textfarbe",
      "default": "#ffffff"
    },
    {
      "type": "header",
      "content": "CTA Banner"
    },
    {
      "type": "color",
      "id": "cta_bg_color",
      "label": "Banner Hintergrund",
      "default": "#1a2420"
    },
    {
      "type": "text",
      "id": "cta_eyebrow",
      "label": "Eyebrow Text",
      "default": "JETZT STARTEN"
    },
    {
      "type": "color",
