{{ 'phases-overview.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign s = section.settings
  assign overlay = s.bg_overlay_opacity | divided_by: 100.0
-%}

<section
  class="phases-ov{% if s.mobile_blur %} phases-ov--mobile-blur{% endif %}{% if s.mobile_stack_cards %} phases-ov--stack{% endif %}"
  id="phases-ov-{{ section.id }}"
  style="
    --po-bg: {{ s.bg_color }};
    --po-heading: {{ s.heading_color }};
    --po-text: {{ s.text_color }};
    --po-accent: {{ s.accent_color }};
    --po-btn-bg: {{ s.button_bg }};
    --po-btn-text: {{ s.button_text_color }};
    --po-card-bg: {{ s.card_bg }};
    --po-rules-bg: {{ s.rules_bg }};
    --po-badge-bg: {{ s.badge_bg }};
    --po-bg-overlay: {{ overlay }};
    --po-bg-blur: {{ s.bg_blur }}px;
    --po-band-pad: {{ s.band_padding }}px;
    --po-stack-overlap: {{ s.mobile_stack_overlap }}px;
    --po-cards-pull-mobile: {{ s.mobile_cards_pull }}px;
    --po-pad-top: {{ s.padding_top }}px;
    --po-pad-bottom: {{ s.padding_bottom }}px;
    --po-pad-top-mobile: {{ s.padding_top_mobile }}px;
    --po-pad-bottom-mobile: {{ s.padding_bottom_mobile }}px;
  "
>
  {%- if s.hero_image != blank -%}
    <div class="phases-ov__hero">
      {{
        s.hero_image
        | image_url: width: 3000
        | image_tag:
          loading: 'lazy',
          sizes: '100vw',
          widths: '600,900,1200,1600,2000,2600,3000',
          class: 'phases-ov__hero-img'
      }}
    </div>
  {%- endif -%}

  <div class="phases-ov__body">
    {%- if s.background_image != blank -%}
      <div class="phases-ov__bg" aria-hidden="true">
        {{
          s.background_image
          | image_url: width: 3000
          | image_tag:
            loading: 'lazy',
            sizes: '100vw',
            widths: '600,900,1200,1600,2000,2600,3000',
            class: 'phases-ov__bg-img'
        }}
      </div>
    {%- endif -%}

    <div class="phases-ov__intro-band">
      <div class="phases-ov__inner">
      <div class="phases-ov__intro">
        {%- if s.heading_line_1 != blank or s.heading_line_2 != blank -%}
          <h2 class="phases-ov__heading">
            {%- if s.heading_line_1 != blank -%}
              <span class="phases-ov__heading-1">{{ s.heading_line_1 }}</span>
            {%- endif -%}
            {%- if s.heading_line_2 != blank -%}
              <span class="phases-ov__heading-2">{{ s.heading_line_2 }}</span>
            {%- endif -%}
          </h2>
        {%- endif -%}

        {%- if s.badge_text != blank -%}
          <p class="phases-ov__badge">
            {%- if s.show_badge_icon -%}
              <svg class="phases-ov__badge-icon" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                <path d="M12 2.6 14.1 4l2.5-.3 1 2.3 2.3 1-.3 2.5L21.4 12 20 14.1l.3 2.5-2.3 1-1 2.3-2.5-.3L12 21.4 9.9 20l-2.5.3-1-2.3-2.3-1 .3-2.5L3 12l1.4-2.1-.3-2.5 2.3-1 1-2.3 2.5.3L12 2.6Z" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round"/>
                <path d="m8.9 12.2 2.1 2.1 4.1-4.2" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            {%- endif -%}
            <span>{{ s.badge_text }}</span>
          </p>
        {%- endif -%}

        {%- if s.subheading != blank -%}
          <div class="phases-ov__subheading">{{ s.subheading }}</div>
        {%- endif -%}

        {%- if s.button_label != blank -%}
          <a
            class="phases-ov__btn"
            {% if s.button_link != blank %}
              href="{{ s.button_link }}"
            {% else %}
              href="#"
            {% endif %}
          >
            {{ s.button_label }}
          </a>
        {%- endif -%}
      </div>
      </div>
    </div>

    <div class="phases-ov__inner">
      {%- if section.blocks.size > 0 -%}
        <div class="phases-ov__cards">
          {%- for block in section.blocks -%}
            {%- assign is_open = false -%}
            {%- if forloop.index == s.mobile_open_index -%}
              {%- assign is_open = true -%}
            {%- endif -%}
            <div class="phases-ov__card{% if is_open %} is-open{% endif %}" {{ block.shopify_attributes }}>
              <button
                class="phases-ov__card-toggle"
                type="button"
                aria-expanded="{% if is_open %}true{% else %}false{% endif %}"
                aria-controls="po-panel-{{ section.id }}-{{ block.id }}"
              >
                <span class="phases-ov__card-title">
                  {%- if block.settings.title_prefix != blank -%}
                    <span class="phases-ov__card-title-pre">{{ block.settings.title_prefix }}</span>
                  {%- endif -%}
                  {%- if block.settings.title != blank -%}
                    <span class="phases-ov__card-title-main">{{ block.settings.title }}</span>
                  {%- endif -%}
                </span>
                <svg class="phases-ov__chev" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                  <path d="m6 9 6 6 6-6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              </button>

              <div
                class="phases-ov__panel"
                id="po-panel-{{ section.id }}-{{ block.id }}"
                {% unless is_open %}
                  hidden
                {% endunless %}
              >
                <div class="phases-ov__panel-inner">
                  <dl class="phases-ov__specs">
                    {%- for i in (1..4) -%}
                      {%- liquid
                        case i
                          when 1
                            assign lbl = block.settings.label_1
                            assign val = block.settings.value_1
                            assign ico = block.settings.icon_1
                          when 2
                            assign lbl = block.settings.label_2
                            assign val = block.settings.value_2
                            assign ico = block.settings.icon_2
                          when 3
                            assign lbl = block.settings.label_3
                            assign val = block.settings.value_3
                            assign ico = block.settings.icon_3
                          when 4
                            assign lbl = block.settings.label_4
                            assign val = block.settings.value_4
                            assign ico = block.settings.icon_4
                        endcase
                      -%}
                      {%- if lbl != blank or val != blank -%}
                        <div class="phases-ov__spec">
                          <dt class="phases-ov__spec-term">
                            {%- render 'phases-overview-icon', icon: ico -%}
                            <span>{{ lbl }}</span>
                          </dt>
                          <dd class="phases-ov__spec-desc">{{ val | newline_to_br }}</dd>
                        </div>
                      {%- endif -%}
                    {%- endfor -%}
                  </dl>

                  {%- if block.settings.rules_text != blank -%}
                    <div class="phases-ov__rules">
                      {%- if block.settings.rules_title != blank -%}
                        <p class="phases-ov__rules-title">{{ block.settings.rules_title }}</p>
                      {%- endif -%}
                      <div class="phases-ov__rules-text">{{ block.settings.rules_text }}</div>
                    </div>
                  {%- endif -%}
                </div>
              </div>
            </div>
          {%- endfor -%}
        </div>
      {%- endif -%}

      {%- if s.footer_label != blank -%}
        <div class="phases-ov__footer">
          <a
            class="phases-ov__footer-link"
            {% if s.footer_link != blank %}
              href="{{ s.footer_link }}"
            {% else %}
              href="#"
            {% endif %}
          >
            <span class="phases-ov__footer-left">
              {%- if s.show_footer_icon -%}
                <svg class="phases-ov__footer-icon" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none">
                  <path d="M3 20.25H21" stroke="#56473A" stroke-linecap="round" stroke-linejoin="round"/>
                  <path d="M6.75 16.5H12.75" stroke="#56473A" stroke-linecap="round" stroke-linejoin="round"/>
                  <path d="M12 2.25H7.5C7.08579 2.25 6.75 2.58579 6.75 3V12.75C6.75 13.1642 7.08579 13.5 7.5 13.5H12C12.4142 13.5 12.75 13.1642 12.75 12.75V3C12.75 2.58579 12.4142 2.25 12 2.25Z" stroke="#56473A" stroke-linecap="round" stroke-linejoin="round"/>
                  <path d="M12.75 6.75C14.3241 6.75 15.8583 7.24528 17.1353 8.16568C18.4123 9.08609 19.3673 10.385 19.8651 11.8783C20.3629 13.3716 20.3782 14.9837 19.9089 16.4863C19.4395 17.9888 18.5093 19.3055 17.25 20.25" stroke="#56473A" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              {%- endif -%}
              <span class="phases-ov__footer-text">{{ s.footer_label }}</span>
            </span>
            {%- if s.footer_cta != blank -%}
              <span class="phases-ov__footer-cta">
                {{ s.footer_cta }}
                <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
                  <path d="m9 6 6 6-6 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              </span>
            {%- endif -%}
          </a>
        </div>
      {%- endif -%}
    </div>
  </div>
</section>

<script>
  (function () {
    var root = document.getElementById('phases-ov-{{ section.id }}');
    if (!root) return;

    var single = {% if section.settings.mobile_accordion_single %}true{% else %}false{% endif %};
    var mq = window.matchMedia('(max-width: 989px)');

    function panelOf(card) {
      var btn = card.querySelector('.phases-ov__card-toggle');
      return btn ? document.getElementById(btn.getAttribute('aria-controls')) : null;
    }

    function setOpen(card, open) {
      var btn = card.querySelector('.phases-ov__card-toggle');
      var panel = panelOf(card);
      card.classList.toggle('is-open', open);
      if (btn) btn.setAttribute('aria-expanded', open ? 'true' : 'false');
      if (panel) panel.hidden = !open;
    }

    function sync() {
      var cards = root.querySelectorAll('.phases-ov__card');
      for (var i = 0; i < cards.length; i++) {
        if (mq.matches) {
          setOpen(cards[i], cards[i].classList.contains('is-open'));
        } else {
          var btn = cards[i].querySelector('.phases-ov__card-toggle');
          var panel = panelOf(cards[i]);
          if (btn) btn.setAttribute('aria-expanded', 'true');
          if (panel) panel.hidden = false;
        }
      }
    }

    root.addEventListener('click', function (e) {
      if (!mq.matches) return;
      var el = e.target;
      var btn = null;
      while (el && el !== root) {
        if (el.classList && el.classList.contains('phases-ov__card-toggle')) {
          btn = el;
          break;
        }
        el = el.parentNode;
      }
      if (!btn) return;

      var card = btn.parentNode;
      var willOpen = !card.classList.contains('is-open');

      if (single && willOpen) {
        var open = root.querySelectorAll('.phases-ov__card.is-open');
        for (var i = 0; i < open.length; i++) {
          if (open[i] !== card) setOpen(open[i], false);
        }
      }
      setOpen(card, willOpen);
    });

    if (mq.addEventListener) {
      mq.addEventListener('change', sync);
    } else if (mq.addListener) {
      mq.addListener(sync);
    }

    sync();
  })();
</script>

{% schema %}
{
  "name": "Phases Overview",
  "tag": "section",
  "class": "section-phases-overview",
  "settings": [
    { "type": "header", "content": "Images" },
    { "type": "image_picker", "id": "hero_image", "label": "Top image" },
    { "type": "image_picker", "id": "background_image", "label": "Background image" },
    {
      "type": "range",
      "id": "bg_overlay_opacity",
      "label": "Background overlay opacity",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 80
    },
    {
      "type": "range",
      "id": "bg_blur",
      "label": "Background blur",
      "min": 0,
      "max": 30,
      "step": 1,
      "unit": "px",
      "default": 6
    },
    {
      "type": "range",
      "id": "band_padding",
      "label": "Blur band vertical padding",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 40
    },

    { "type": "header", "content": "Content" },
    { "type": "text", "id": "heading_line_1", "label": "Heading line 1", "default": "Das bewährte" },
    { "type": "text", "id": "heading_line_2", "label": "Heading line 2 (italic)", "default": "Precon Konzept" },
    { "type": "text", "id": "badge_text", "label": "Badge text", "default": "39 Jahre Abnehmexpertise" },
    { "type": "checkbox", "id": "show_badge_icon", "label": "Show badge icon", "default": true },
    {
      "type": "richtext",
      "id": "subheading",
      "label": "Subheading",
      "default": "<p>3 klare Phasen, die Deine Abnehmreise alltagstauglich, abwechslungsreich und erfolgreich machen.</p>"
    },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Jetzt zur Studie" },
    { "type": "url", "id": "button_link", "label": "Button link" },

    { "type": "header", "content": "Bottom link" },
    { "type": "text", "id": "footer_label", "label": "Text", "default": "Mehr über die 3-Jährige Studie" },
    { "type": "text", "id": "footer_cta", "label": "CTA text", "default": "Zur Studie" },
    { "type": "url", "id": "footer_link", "label": "Link" },
    { "type": "checkbox", "id": "show_footer_icon", "label": "Show icon", "default": true },

    { "type": "header", "content": "Mobile" },
    { "type": "checkbox", "id": "mobile_blur", "label": "Blur effect on mobile", "default": false },
    { "type": "checkbox", "id": "mobile_stack_cards", "label": "Stacked (overlapping) cards on mobile", "default": true },
    {
      "type": "range",
      "id": "mobile_stack_overlap",
      "label": "Card overlap",
      "min": -60,
      "max": 0,
      "step": 2,
      "unit": "px",
      "default": -18
    },
    {
      "type": "range",
      "id": "mobile_cards_pull",
      "label": "Cards overlap on image",
      "min": -160,
      "max": 40,
      "step": 4,
      "unit": "px",
      "default": -40
    },
    {
      "type": "range",
      "id": "mobile_open_index",
      "label": "Card open by default on mobile",
      "min": 1,
      "max": 6,
      "step": 1,
      "default": 1
    },
    { "type": "checkbox", "id": "mobile_accordion_single", "label": "Only one card open at a time", "default": true },

    { "type": "header", "content": "Colors" },
    { "type": "color", "id": "bg_color", "label": "Section background", "default": "#ece9e2" },
    { "type": "color", "id": "heading_color", "label": "Heading", "default": "#584f47" },
    { "type": "color", "id": "text_color", "label": "Text", "default": "#5a5249" },
    { "type": "color", "id": "accent_color", "label": "Accent", "default": "#2aa3b5" },
    { "type": "color", "id": "button_bg", "label": "Button background", "default": "#35b0c2" },
    { "type": "color", "id": "button_text_color", "label": "Button text", "default": "#ffffff" },
    { "type": "color", "id": "card_bg", "label": "Card background", "default": "#ffffff" },
    { "type": "color", "id": "rules_bg", "label": "Rules box background", "default": "#FEF9F5" },
    { "type": "color", "id": "badge_bg", "label": "Badge background", "default": "#dedad2" },

    { "type": "header", "content": "Spacing" },
    { "type": "range", "id": "padding_top", "label": "Padding top", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 64 },
    { "type": "range", "id": "padding_bottom", "label": "Padding bottom", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 64 },
    { "type": "range", "id": "padding_top_mobile", "label": "Padding top (mobile)", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 36 },
    { "type": "range", "id": "padding_bottom_mobile", "label": "Padding bottom (mobile)", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 36 }
  ],
  "blocks": [
    {
      "type": "phase",
      "name": "Phase",
      "settings": [
        { "type": "text", "id": "title_prefix", "label": "Title prefix", "default": "Die" },
        { "type": "text", "id": "title", "label": "Title (italic)", "default": "Startphase" },

        { "type": "header", "content": "Row 1" },
        {
          "type": "select",
          "id": "icon_1",
          "label": "Icon",
          "options": [
            { "value": "calendar", "label": "Calendar" },
            { "value": "cup", "label": "Cup" },
            { "value": "clock", "label": "Clock" },
            { "value": "target", "label": "Target" },
            { "value": "none", "label": "None" }
          ],
          "default": "calendar"
        },
        { "type": "text", "id": "label_1", "label": "Label", "default": "Dauer" },
        { "type": "textarea", "id": "value_1", "label": "Value", "default": "2 Tage" },

        { "type": "header", "content": "Row 2" },
        {
          "type": "select",
          "id": "icon_2",
          "label": "Icon",
          "options": [
            { "value": "calendar", "label": "Calendar" },
            { "value": "cup", "label": "Cup" },
            { "value": "clock", "label": "Clock" },
            { "value": "target", "label": "Target" },
            { "value": "none", "label": "None" }
          ],
          "default": "cup"
        },
        { "type": "text", "id": "label_2", "label": "Label", "default": "Was" },
        { "type": "textarea", "id": "value_2", "label": "Value", "default": "5× Start Shake täglich" },

        { "type": "header", "content": "Row 3" },
        {
          "type": "select",
          "id": "icon_3",
          "label": "Icon",
          "options": [
            { "value": "calendar", "label": "Calendar" },
            { "value": "cup", "label": "Cup" },
            { "value": "clock", "label": "Clock" },
            { "value": "target", "label": "Target" },
            { "value": "none", "label": "None" }
          ],
          "default": "clock"
        },
        { "type": "text", "id": "label_3", "label": "Label", "default": "Wann" },
        { "type": "textarea", "id": "value_3", "label": "Value", "default": "Alle 2-3 Stunden" },

        { "type": "header", "content": "Row 4" },
        {
          "type": "select",
          "id": "icon_4",
          "label": "Icon",
          "options": [
            { "value": "calendar", "label": "Calendar" },
            { "value": "cup", "label": "Cup" },
            { "value": "clock", "label": "Clock" },
            { "value": "target", "label": "Target" },
            { "value": "none", "label": "None" }
          ],
          "default": "target"
        },
        { "type": "text", "id": "label_4", "label": "Label", "default": "Ziel" },
        { "type": "textarea", "id": "value_4", "label": "Value", "default": "Stoffwechsel umstellen" },

        { "type": "header", "content": "Rules" },
        { "type": "text", "id": "rules_title", "label": "Rules title", "default": "Wichtige Regeln:" },
        {
          "type": "richtext",
          "id": "rules_text",
          "label": "Rules text",
          "default": "<p>Alle 2-3 Stunden ein Shake. Keine anderen Mahlzeiten. Zusätzlich 2-3 Liter kalorienfreie Getränke.</p>"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Phases Overview",
      "blocks": [
        {
          "type": "phase",
          "settings": {
            "title": "Startphase",
            "label_1": "Dauer",
            "value_1": "2 Tage",
            "label_2": "Was",
            "value_2": "5× Start Shake täglich",
            "label_3": "Wann",
            "value_3": "Alle 2-3 Stunden",
            "label_4": "Ziel",
            "value_4": "Stoffwechsel umstellen",
            "rules_text": "<p>Alle 2-3 Stunden ein Shake. Keine anderen Mahlzeiten. Zusätzlich 2-3 Liter kalorienfreie Getränke. Bei Bedarf: ca. 3x am Tag Special Kräuter zwischen den Mahlzeiten trinken.</p>"
          }
        },
        {
          "type": "phase",
          "settings": {
            "title": "Abnehmphase",
            "label_1": "Dauer",
            "value_1": "Bis zum Ziel",
            "label_2": "Was",
            "value_2": "2× Precon +\n1× normale Mahlzeit",
            "label_3": "Wann",
            "value_3": "Alle 4-6 Stunden",
            "label_4": "Ziel",
            "value_4": "Kontinuierlich abnehmen",
            "rules_text": "<p>4–6 Stunden Pause zwischen den Mahlzeiten. Keine Snacks! Zusätzlich 2-3 Liter kalorienfreie Getränke.</p>"
          }
        },
        {
          "type": "phase",
          "settings": {
            "title": "Haltephase",
            "label_1": "Dauer",
            "value_1": "4–6 Wochen",
            "label_2": "Was",
            "value_2": "1× Precon\n+ 2× normale Mahlzeiten",
            "label_3": "Wann",
            "value_3": "Alle 4-6 Stunden",
            "label_4": "Ziel",
            "value_4": "Gewicht stabilisieren",
            "rules_text": "<p>Weiterhin 4–6 Stunden Pause. Schrittweise zurück zur normalen Ernährung. Zusätzlich 2-3 Liter kalorienfreie Getränke.</p>"
          }
        }
      ]
    }
  ]
}
{% endschema %}
