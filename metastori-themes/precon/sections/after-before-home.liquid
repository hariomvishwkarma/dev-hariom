{% comment %} <section style="background-color: {{ section.settings.bg_color }}; color: {{ section.settings.text_color }}; padding: 40px 0;">
  <div class="page-width" style="text-align: center; max-width: 1200px; margin: 0 auto;">
    
    {% if section.settings.title != blank %}
      <h2 style="margin-bottom: 10px;">{{ section.settings.title }}</h2>
    {% endif %}

    {% if section.settings.title12 != blank %}
      <h4 style="margin-bottom: 15px;">{{ section.settings.title12 }}</h4>
    {% endif %}

    {% if section.settings.description != blank %}
      <p style="max-width: 800px; margin: 0 auto 20px;">{{ section.settings.description }}</p>
    {% endif %}

    {%- if section.settings.after_button_label != blank and section.settings.after_button_link != blank -%}
      <a href="{{ section.settings.after_button_link }}" style="display:inline-block; padding:8px 16px; background:#000; color:#fff; text-decoration:none; margin:0 10px 30px 0;">
        {{ section.settings.after_button_label }}
      </a>
    {%- endif -%}

    {%- if section.settings.before_button_label != blank and section.settings.before_button_link != blank -%}
      <a href="{{ section.settings.before_button_link }}" style="display:inline-block; padding:8px 16px; background:#000; color:#fff; text-decoration:none; margin-bottom:30px;">
        {{ section.settings.before_button_label }}
      </a>
    {%- endif -%}

    <div style="display: flex; flex-wrap: wrap; gap: 20px; justify-content: center;">
      {% for block in section.blocks %}
        <div style="flex: 1 1 45%; min-width: 250px; text-align: center;">
          {% if block.settings.after_image != blank %}
            <img src="{{ block.settings.after_image | img_url: '600x' }}" alt="" style="width: 100%; height: auto; margin-bottom: 10px;">
          {% endif %}

          {% if block.settings.before_image != blank %}
            <img src="{{ block.settings.before_image | img_url: '600x' }}" alt="" style="width: 100%; height: auto; margin-bottom: 10px;">
          {% endif %}

          {% if block.settings.dynamic_text != blank %}
            <p style="margin-top: 10px;">{{ block.settings.dynamic_text }}</p>
          {% endif %}
        </div>
      {% endfor %}
    </div>

  </div>
</section> {% endcomment %}

<section class="after-before-wrapper home-after-before" {% if template.name == "collection" %} style="padding: 100px 20px 0 20px;" {% else %} style="padding: 0px 20px 100px 20px;" {% endif %}>
  <div class="container">
    <!-- LEFT BOX -->
    <div class="left-box">
      <div class="inner-box-left" style="background:{{ section.settings.background_leftbox }}">
        {% comment %} {% if section.settings.after_before_title != blank %}
          <h2 class="heading heading132" style="color:{{ section.settings.color_title_left }}">
            {{ section.settings.after_before_title }}
          </h2>
        {% endif %}

        {% if section.settings.after_before_handwritten_text != blank %}
          <h2 class="heading heading132 " style="color:{{ section.settings.color_title_left }}">
            {{ section.settings.after_before_handwritten_text }}
          </h2>
        {% endif %} {% endcomment %}
{% if section.settings.after_before_title != blank or section.settings.after_before_handwritten_text != blank %}
  <h2 class="heading heading132" style="color:{{ section.settings.color_title_left }}">
    {% if section.settings.after_before_title != blank %}
      {{ section.settings.after_before_title }}
    {% endif %}

    {% if section.settings.after_before_handwritten_text != blank %}
      {{ section.settings.after_before_handwritten_text }}
    {% endif %}
  </h2>
{% endif %}

        {% if section.settings.after_before_description != blank %}
          <div class="short_info" style="color:{{ section.settings.color_title_left }}">
            {{ section.settings.after_before_description }}
          </div>
        {% endif %}

        <div class="sliderafter-arrow dekstop_arrw">
          <button class="prev-slide sliderarrleft">
            <img src="https://cdn.shopify.com/s/files/1/0904/4639/7774/files/left_arw.png" alt="Prev">
          </button>
          <button class="next-slide sliderarrright">
            <img src="https://cdn.shopify.com/s/files/1/0904/4639/7774/files/right_arw.png" alt="Next">
          </button>
        </div>
      </div>
    </div>

    <!-- RIGHT BOX -->
    {% if section.blocks.size > 0 %}
      <div class="right-box">
        <div class="slick-carousel1">
          {% for block in section.blocks %}
            <div class="slide-content">
              <div class="after-before-item">
                <div class="image-container">
                  {% if block.settings.before_image %}
                    <img
                      src="{{ block.settings.before_image | img_url: '800x' }}"
                      class="toggle-image before-image active"
                      alt="Before Image"
                    >
                  {% endif %}
                  {% if block.settings.after_image %}
                    <img
                      src="{{ block.settings.after_image | img_url: '800x' }}"
                      class="toggle-image after-image"
                      alt="After Image"
                    >
                  {% endif %}
                </div>

                {% if block.settings.before_image and block.settings.after_image %}
                  <div class="toggle-buttons">
                    <button class="btn-show-before active">{{ section.settings.pre_text }}</button>
                    <button class="btn-show-after">{{ section.settings.next_text }}</button>
                  </div>
                {% endif %}

                {% if block.settings.dynamic_text != blank %}
                  <p class="dynamic-text">{{ block.settings.dynamic_text }}</p>
                {% endif %}
              </div>
            </div>
          {% endfor %}
        </div>
      </div>

      <div class="sliderafter-arrow mobile_arrw">
        <button class="prev-slide sliderarrleft">
          <img src="{{ 'left_arrw.png' | asset_url }}" alt="Prev">
        </button>
        <button class="next-slide sliderarrright">
          <img src="{{ 'right_arrw.png' | asset_url }}" alt="Next">
        </button>
      </div>
    {% else %}
      <p>No before/after images found. Please add blocks in the theme editor.</p>
    {% endif %}
  </div>
</section>

<!-- jQuery & Slick Carousel -->
<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/slick-carousel@1.8.1/slick/slick.css"/>
<script src="https://cdn.jsdelivr.net/npm/slick-carousel@1.8.1/slick/slick.min.js"></script>

<!-- Slider & Toggle Script -->
<script>
document.addEventListener("DOMContentLoaded", function() {
  $('.slick-carousel1').slick({
    infinite: false,
    slidesToShow: 2.8,
    slidesToScroll: 1,
    arrows: false,
    dots: false,
    responsive: [
      { breakpoint: 992, settings: { slidesToShow: 2 } },
      { breakpoint: 768, settings: { slidesToShow: 1.3, dots: true, slidesToScroll: 1, } }
    ]
  });

  $('.next-slide').click(function(){
    $('.slick-carousel1').slick('slickNext');
  });

  $('.prev-slide').click(function(){
    $('.slick-carousel1').slick('slickPrev');
  });

 document.querySelectorAll('.after-before-item').forEach(function(item) {
  const beforeBtn = item.querySelector('.btn-show-before');
  const afterBtn = item.querySelector('.btn-show-after');
  const beforeImg = item.querySelector('.before-image');
  const afterImg = item.querySelector('.after-image');

  if (beforeBtn && afterBtn && beforeImg && afterImg) {

    // 👉 Show AFTER by default
    afterImg.classList.add('active');
    afterBtn.classList.add('active');
    beforeImg.classList.remove('active');
    beforeBtn.classList.remove('active');

    beforeBtn.addEventListener('click', function() {
      beforeImg.classList.add('active');
      afterImg.classList.remove('active');
      beforeBtn.classList.add('active');
      afterBtn.classList.remove('active');
    });

    afterBtn.addEventListener('click', function() {
      afterImg.classList.add('active');
      beforeImg.classList.remove('active');
      afterBtn.classList.add('active');
      beforeBtn.classList.remove('active');
    });
  }
});
});
</script>

<!-- Styles -->
<style>
.after-before-wrapper {
margin: 0 auto;
  padding: 40px 20px;
}

.after-before-wrapper .container {
    display: flex;
    width: 100%;
    justify-content: flex-end;
    align-items: center;
}
.left-box {
    width:26%;
}
.inner-box-left{
    border-radius: 16px;
    padding:20px;
}

.inner-box-left h2 {
    font-size: 36px;
    font-style: normal;
    font-weight: 500;
    margin: 0;
    line-height: 40px;
}

.inner-box-left h3 {
    font-size: 36px;
    font-style: normal;
    font-weight: 500;
    margin: 0;
    padding-bottom: 15px;
    line-height: 40px;
}

.short_info {
    font-size: 16px;
    font-weight: 500;
    line-height: 24px;
}

.sliderafter-arrow {
    display: flex;
    align-items: flex-end;
    padding-top: 25px;
}
.sliderafter-arrow button {
    border: 1px solid #fff;
    width: 40px;
    height: 40px;
    text-align: center;
    border-radius: 30px;
    line-height: 16px;
}



.sliderafter-arrow .sliderarrleft {
    margin-right: 15px;
}



.right-box {
    width: 74%;
    padding-left: 30px;
}

.right-box .slick-slider {
    margin-bottom: 0;
}

.after-before-item {
  text-align: center;
  position:relative;
}

.image-container {
    border-radius: 16px;
    position: relative;
    background:#EFECE4;
    
    {% comment %} margin-right:25px; {% endcomment %}
}
section.after-before-wrapper .slick-initialized .slick-slide {
    display: block;
    gap: 16px;
    display: flex;
}
.toggle-image {
  display: none;
  max-width: 100%;
  height: auto;
  border-radius: 8px;
}

.toggle-image.active {
  display: block;
}

.toggle-buttons {
    margin-top: 10px;
    position: absolute;
    bottom: 16px;
    display: flex;
    align-items: center;
    justify-content: center;
    left: 0;
    right: 0;
}

button.btn-show-after {
    border: 1px solid #56473A;
    background:#fff;
    color:#56473A;
    font-size: 16px;
    font-weight: 500;
    {% comment %} line-height: 24px; {% endcomment %}
}

button.btn-show-before {
    border: 1px solid #56473A;
    background: #ffffff;
    color: #56473A;
}

.after-before-wrapper .toggle-buttons button {
  
    padding: 4px 0;
    margin: 0px;
    cursor: pointer;
    transition: all 0.3s ease;
    width: 100px;
}
.after-before-wrapper .toggle-buttons .btn-show-before{
  border-top-left-radius: 30px;
  border-bottom-left-radius: 30px;
}
.after-before-wrapper .toggle-buttons .btn-show-after{
  border-top-right-radius: 30px;
  border-bottom-right-radius: 30px;
}
.after-before-wrapper .toggle-buttons button.active {
  background:#56473A;
  color: #fff;
}

.right-box .slick-slide img {
    height: 360px;
    object-fit: cover;
}


.after-before-item img.toggle-image.after-image {
    display: none;
}
 
.after-before-item img.toggle-image.after-image.active {
    display: block !important;
}

.after-before-item img.toggle-image.before-image {
    display: none;
}

.after-before-item img.toggle-image.before-image.active {
    display: block !important;
}

.sliderafter-arrow.mobile_arrw{ display:none;}
section.after-before-wrapper.home-after-before .inner-box-left {
    padding: 40px 24px 31px 24px;
}

@media only screen and (max-width: 767px) {

button.btn-show-after{
  border:none;
}
.toggle-buttons{
  left:-16px;
}
.home-after-before .image-container {
    margin-right: 16px !important;
}

section.after-before-wrapper.home-after-before .inner-box-left {
    padding: 16px;
}
.heading.heading132 {
    max-width: 240px;
}
.after-before-wrapper .container{ padding: 0;display:block;}
.left-box { width: 100%;}
.right-box { width: 100%; padding-left: 0; padding-top:30px;}
.inner-box-left h2,.inner-box-left h3{ max-width:280px;}
.right-box .slick-slide img {   height: auto;}
.sliderafter-arrow.mobile_arrw {  display: flex;justify-content: space-between;position: relative;padding: 0;margin-top: 40px;z-index: 999999;}
.sliderafter-arrow.mobile_arrw button { border: 1px solid #290907; border-radius: 50%;padding: 10px;width: 44px;height: 44px;}
.sliderafter-arrow .sliderarrleft { margin-right: 0;}
.sliderafter-arrow.dekstop_arrw { display: none;}
.right-box .slick-dots li { width: auto;height: auto;}
.right-box .slick-dots li.slick-active button {  width: 37px; background-color: #56473A;}
.right-box .slick-dots li button { font-size: 0;padding: 0;width: 12px;height: 4px;border-radius: 20px;background-color:#EFECE4;border: none;}
.right-box .slick-dots li button:before {content: none;}
 .right-box .slick-dots {  bottom: -70px;} 
}
{% comment %} .home-after-before .toggle-buttons{left:-12px;} {% endcomment %}
{% comment %} .home-after-before .image-container {margin-right: 32px;} {% endcomment %}
</style>

{% schema %}
{
  "name": "After Before Home",
  "settings": [
    {
      "type": "text",
      "id": "after_before_title",
      "label": "Section Title"
    },
    {
      "type": "text",
      "id": "after_before_handwritten_text",
      "label": "Section Title handwritten"
    },
    {
      "type": "textarea",
      "id": "after_before_description",
      "label": "Description"
    },
    
    {
      "type": "text",
      "id": "next_text",
      "label": "After Button Label"
    },
  
    {
      "type": "text",
      "id": "pre_text",
      "label": "Before Button Label"
    },
    {
      "type": "color",
      "id": "background_leftbox",
      "label": "Background Left Box",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "color_title_left",
      "label": "Text Color",
      "default": "#000000"
    }
  ],
  "blocks": [
    {
      "type": "before_after_block",
      "name": "Before & After Pair",
      "settings": [
        {
          "type": "image_picker",
          "id": "after_image",
          "label": "After Image"
        },
        {
          "type": "image_picker",
          "id": "before_image",
          "label": "Before Image"
        },
        {
          "type": "textarea",
          "id": "dynamic_text",
          "label": "Dynamic Text"
        }
      ]
    }
  ],
  "max_blocks": 10,
  "presets": [
    {
      "name": "After Before Home",
      "category": "Custom",
      "blocks": [
        { "type": "before_after_block" },
        { "type": "before_after_block" }
      ]
    }
  ]
}
{% endschema %} 

