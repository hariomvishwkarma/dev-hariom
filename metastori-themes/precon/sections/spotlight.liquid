<div class="spotlight-section" style="background:{{ section.settings.background_spot }}">
<div class="slick-carousel">
  {% if collection.metafields.custom.spotlight_product != blank %}
  {% assign spotlight_products = collection.metafields.custom.spotlight_product.value %}

  {% for product in spotlight_products %}
  <div class="slide-content">
    <div class="main-spot-div">
       <div class="spot-right sopt-right-mob" style="display:none;">
         {% if product.metafields.custom.spotlight_banner %}
          <img src="{{ product.metafields.custom.spotlight_banner | image_url: width: 1000 }}">
        {% else %}
          <img src="/cdn/shop/files/tab2.jpg">  
        {% endif %}
      </div>
      <div class="spot-left">
        <div class="inner-left">
        <h2 class="heading" style="color:{{ section.settings.title_spot }}">{{ product.title }}</h2>
        <p style="color:{{ section.settings.content_spot }}">{{ product.metafields.custom.receipe_content | metafield_tag }}</p>
        <span class="ssstar">
          {% render 'star-rating' %} <span class="starnum" style="display:block;">{{ product.metafields.custom.spotlight_banner_author}}</span> 
           {% comment %} <div class='jdgm-widget jdgm-preview-badge' data-id='{{ product.id }}' style="margin-top:10px;"> 
              {{ product.metafields.judgeme.badge }} 
            </div>  {% endcomment %}
        </span>

       

             <div class="arrowslidere">

             <a href="{{ product.url }}" class="sliderbtn"> {{  section.settings.button_text }} </a> 
             <button class="prev-slide sliderarr sliderarrleft"><img src="https://cdn.shopify.com/s/files/1/0904/4639/7774/files/ArrowLeft.svg?v=1754295090"></button>
              <button class="next-slide sliderarr sliderarrright"><img src="https://cdn.shopify.com/s/files/1/0904/4639/7774/files/Arrowright_2.svg?v=1754296267"></button>
            </div>
        </div>
      </div>
      <div class="spot-right sopt-right-desk">
         {% if product.metafields.custom.spotlight_banner %}
          <img src="{{ product.metafields.custom.spotlight_banner | image_url: width: 1000 }}">
        {% else %}
          <img src="/cdn/shop/files/tab2.jpg"> 
        {% endif %}
      </div>
    </div>
  </div>

 {% endfor %}
{% endif %}
 
</div>
</div>
<style>
    .slick-slide .slide-content{
    
      padding: 50px 100px;
      background: #fff;
   }
  
  .slick-list {
     margin: 20px 0px;
  }
  
  .slick-prev,
  .slick-next {
    position: absolute;
    left:0;
    background: #777;
    border: none;
    color: transparent;
    width: 30px;
    height: 30px;
   
  }
</style>
<script>
$().ready(function(){
  $('.slick-carousel').slick({
    arrows: false,
    centerPadding: "0px",
    dots: false,
    slidesToShow: 1,
    infinite: false
  });
   $('.next-slide').click(function(){
    $('.slick-carousel').slick('slickNext');
  });

  $('.prev-slide').click(function(){
    $('.slick-carousel').slick('slickPrev');
  });
});
</script>

{% schema %}
{
  "name": "Spotlight Product Slider",
  "settings": [
    {
      "type": "paragraph",
      "content": "This slider automatically pulls products from the collection metafield: custom.spotlight_product."
    },
    {
      "type": "color",
      "id": "background_spot",
      "label": "Background Color",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "title_spot",
      "label": "Section title Color",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "content_spot",
      "label": "Section contant Color",
      "default": "#000000"
    },
    { "type": "text", 
      "id": "button_text", 
      "label": "Button Text", 
      "default": "Button Text" 
    }
  ],
  "presets": [
    {
      "name": "Spotlight Product Slider"
    }
  ]
}
{% endschema %}