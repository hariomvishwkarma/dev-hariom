{%- liquid
  assign words = article.content | strip_html | split: ' '
  assign read_time = words.size | divided_by: 200
  if read_time < 1
    assign read_time = 1
  endif
-%}

<section class="art-hero" id="art-hero-{{ section.id }}">

  <!-- ── Hero Bild ── -->
  <div class="art-hero__img-wrap">
    {%- if article.image != blank -%}
      {{ article.image | image_url: width: 2000 | image_tag:
        class: 'art-hero__img',
        loading: 'eager',
        sizes: '100vw',
        widths: '800, 1200, 1600, 2000',
        alt: article.title
      }}
    {%- else -%}
      <div class="art-hero__img-placeholder" style="background:{{ section.settings.placeholder_color }};"></div>
    {%- endif -%}
    <div class="art-hero__img-overlay"></div>
  </div>

  <!-- ── Content ── -->
  <div class="art-hero__content" style="background:{{ section.settings.content_bg }};">
    <div class="art-hero__inner">

      <!-- Zurück + Breadcrumb -->
      <div class="art-hero__topbar">
        <a href="{{ blog.url }}" class="art-hero__back" style="color:{{ section.settings.accent_color }};">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path d="M19 12H5"/><path d="M12 5l-7 7 7 7"/></svg>
          {{ section.settings.back_label | default: 'Zurück zur Übersicht' }}
        </a>
        <nav class="art-hero__breadcrumb" aria-label="Breadcrumb">
          <a href="{{ routes.root_url }}blogs" class="art-hero__bc-link" style="color:{{ section.settings.bc_color }};">
            {{ section.settings.root_label | default: 'Blog' }}
          </a>
          <span class="art-hero__bc-sep">/</span>
          <a href="{{ blog.url }}" class="art-hero__bc-link" style="color:{{ section.settings.bc_color }};">
            {{ blog.title }}
          </a>
          <span class="art-hero__bc-sep">/</span>
          <span class="art-hero__bc-current" style="color:{{ section.settings.bc_color }};">
            {{ article.title | truncate: 45 }}
          </span>
        </nav>
      </div>

      <!-- Kategorie Badge -->
      <span class="art-hero__cat-badge" style="background:{{ section.settings.cat_bg | default: '#d4f0ed' }};color:{{ section.settings.cat_text | default: '#1a5c57' }};">
        {{ blog.title }}
      </span>

      <!-- Titel -->
      <h1 class="art-hero__title" style="color:{{ section.settings.title_color }};">{{ article.title }}</h1>

      <!-- Datum + Lesezeit -->
      <div class="art-hero__meta">
        <span>{{ article.published_at | date: '%d. %B %Y' }}</span>
        <span class="art-hero__meta-sep" aria-hidden="true">·</span>
        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/>
        </svg>
        <span>{{ read_time }} Min. Lesezeit</span>
      </div>

    </div>
  </div>

</section>

<style>
/* ── Image Banner ── */
.art-hero__img-wrap {
  position: relative;
  width: 100%;
  height: {{ section.settings.image_height }}px;
  overflow: hidden;
}
.art-hero__img,
.art-hero__img-placeholder {
  width: 100%;
  height: 100%;
  object-fit: cover;
  object-position: center {{ section.settings.image_position }};
  display: block;
}

.art-hero__img-overlay {
  position: absolute;
  inset: 0;
  background: linear-gradient(to bottom, rgba(0,0,0,0) 40%, rgba(0,0,0,0.25) 100%);
  pointer-events: none;
}

/* ── Content Area ── */
.art-hero__content {
  border-bottom: 1px solid rgba(0,0,0,0.07);
}
.art-hero__inner {
  max-width: 1100px;
  margin: 0 auto;
  padding: 28px max(24px, 4rem) 36px;
}

/* ── Kategorie Badge ── */
.art-hero__cat-badge {
  display: inline-flex;
  align-items: center;
  padding: 5px 14px;
  border-radius: 50px;
  font-size: 12px;
  font-weight: 600;
  margin-bottom: 14px;
  letter-spacing: 0.02em;
}

/* ── Titel ── */
.art-hero__title {
  font-size: clamp(26px, 4vw, 48px);
  font-weight: 800;
  line-height: 1.15;
  margin: 0 0 20px;
  letter-spacing: -0.02em;
  max-width: 760px;
}

/* ── Meta: Datum + Lesezeit ── */
.art-hero__meta {
  display: flex;
  align-items: center;
  gap: 7px;
  font-size: 13px;
  color: #888;
  padding-top: 18px;
  border-top: 1px solid rgba(0,0,0,0.08);
}
.art-hero__meta-sep {
  opacity: 0.5;
}

/* ── Topbar: Zurück + Breadcrumb ── */
.art-hero__topbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16px;
  flex-wrap: wrap;
}
.art-hero__back {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  font-size: 13px;
  font-weight: 600;
  text-decoration: none;
  transition: gap 0.2s ease;
  flex-shrink: 0;
}
.art-hero__back:hover {
  gap: 10px;
}
.art-hero__breadcrumb {
  display: flex;
  align-items: center;
  gap: 6px;
  font-size: 12px;
  flex-wrap: wrap;
}
.art-hero__bc-link {
  text-decoration: none;
  opacity: 0.7;
  transition: opacity 0.2s;
}
.art-hero__bc-link:hover {
  opacity: 1;
}
.art-hero__bc-sep {
  opacity: 0.4;
  color: #888;
}
.art-hero__bc-current {
  opacity: 0.5;
  font-style: italic;
}

/* ── Responsive ── */
@media (max-width: 768px) {
  .art-hero__img-wrap {
    height: {{ section.settings.image_height_mobile }}px;
  }
  .art-hero__inner {
    padding-left: 16px !important;
    padding-right: 16px !important;
    padding-top: 20px;
    padding-bottom: 24px;
  }
  .art-hero__topbar {
    flex-direction: column;
    align-items: flex-start;
    gap: 8px;
    margin-bottom: 14px;
  }
  .art-hero__breadcrumb {
    display: none;
  }
  .art-hero__title {
    font-size: clamp(22px, 6vw, 32px);
  }
}
</style>

{% schema %}
{
  "name": "Artikel Hero",
  "tag": "section",
  "class": "section-article-hero",
  "settings": [
    {
      "type": "header",
      "content": "Bild"
    },
    {
      "type": "range",
      "id": "image_height",
      "label": "Bildhöhe Desktop (px)",
      "min": 200,
      "max": 600,
      "step": 20,
      "default": 320
    },
    {
      "type": "range",
      "id": "image_height_mobile",
      "label": "Bildhöhe Mobile (px)",
      "min": 140,
      "max": 400,
      "step": 20,
      "default": 200
    },
    {
      "type": "select",
      "id": "image_position",
      "label": "Bildausschnitt (vertikal)",
      "options": [
        { "value": "top", "label": "Oben" },
        { "value": "center", "label": "Mitte" },
        { "value": "bottom", "label": "Unten" }
      ],
      "default": "center"
    },
    {
      "type": "color",
      "id": "placeholder_color",
      "label": "Platzhalter Farbe (kein Bild)",
      "default": "#d4f0ed"
    },
    {
      "type": "header",
      "content": "Content Bereich"
    },
    {
      "type": "color",
      "id": "title_color",
      "label": "Titel Farbe",
      "default": "#1a2420"
    },
    {
      "type": "header",
      "content": "Navigation (Zurück + Breadcrumb)"
    },
    {
      "type": "color",
      "id": "content_bg",
      "label": "Hintergrund Navigationsleiste",
      "default": "#faf9f6"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Akzentfarbe (Zurück-Link)",
      "default": "#2a7a72"
    },
    {
      "type": "text",
      "id": "back_label",
      "label": "Zurück-Text",
      "default": "Zurück zur Übersicht"
    },
    {
      "type": "header",
      "content": "Breadcrumb"
    },
    {
      "type": "text",
      "id": "root_label",
      "label": "Root Label",
      "default": "Blog"
    },
    {
      "type": "color",
      "id": "bc_color",
      "label": "Breadcrumb Farbe",
      "default": "#555555"
    },
    {
      "type": "header",
      "content": "Kategorie Badge"
    },
    {
      "type": "color",
      "id": "cat_bg",
      "label": "Badge Hintergrund",
      "default": "#d4f0ed"
    },
    {
      "type": "color",
      "id": "cat_text",
      "label": "Badge Textfarbe",
      "default": "#1a5c57"
    }
  ],
  "presets": [
    {
      "name": "Artikel Hero"
    }
  ]
}
{% endschema %}