{%- comment -%}
  sections/community-teaser-banner.liquid
  Community Early Access / Reveal Banner
  Layout: Icon-Badge | Headline + Body | CTA-Karte
  Fonts:  Figtree 300/400/600 + Playfair Display 500 italic
  Colors: Vollständig über Schema konfigurierbar
{%- endcomment -%}

{%- liquid
  assign c_bg          = section.settings.color_bg
  assign c_ink         = section.settings.color_ink
  assign c_accent      = section.settings.color_accent
  assign c_body        = section.settings.color_body
  assign c_card_border = section.settings.color_card_border
  assign c_glow_a      = section.settings.color_glow_a
  assign c_glow_b      = section.settings.color_glow_b

  assign glow_a_rgb = c_glow_a | color_to_rgb | remove: 'rgb(' | remove: ')'
  assign glow_b_rgb = c_glow_b | color_to_rgb | remove: 'rgb(' | remove: ')'
-%}

<section id="ctb-{{ section.id }}" class="ctb">
  <div class="ctb__inner">

    {%- comment -%} ── Linke Spalte: Icon-Badge ── {%- endcomment -%}
    <div class="ctb__badge-col">
      <div class="ctb__badge-icon" aria-hidden="true">
        <svg width="26" height="26" viewBox="0 0 24 24" fill="none"
             stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
          <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/>
          <circle cx="9" cy="7" r="4"/>
          <path d="M23 21v-2a4 4 0 0 0-3-3.87"/>
          <path d="M16 3.13a4 4 0 0 1 0 7.75"/>
        </svg>
      </div>
      <div class="ctb__badge-text">
        {%- if section.settings.badge_line1 != blank -%}
          <span class="ctb__badge-line">{{ section.settings.badge_line1 }}</span>
        {%- endif -%}
        {%- if section.settings.badge_line2 != blank -%}
          <span class="ctb__badge-line">{{ section.settings.badge_line2 }}</span>
        {%- endif -%}
      </div>
    </div>

    {%- comment -%} ── Mittlere Spalte: Eyebrow + Headline + Body ── {%- endcomment -%}
    <div class="ctb__content">
      {%- if section.settings.eyebrow != blank -%}
        <p class="ctb__eyebrow">{{ section.settings.eyebrow }}</p>
      {%- endif -%}

      {%- if section.settings.heading != blank -%}
        <h2 class="ctb__heading">
          <em>{{ section.settings.heading }}</em>
        </h2>
      {%- endif -%}

      {%- if section.settings.body != blank -%}
        <p class="ctb__body">{{ section.settings.body }}</p>
      {%- endif -%}
    </div>

    {%- comment -%} ── Rechte Spalte: CTA-Karte ── {%- endcomment -%}
    {%- if section.settings.cta_text != blank -%}
      <div class="ctb__cta-card">
        {%- if section.settings.cta_eyebrow != blank -%}
          <p class="ctb__cta-eyebrow">{{ section.settings.cta_eyebrow }}</p>
        {%- endif -%}
        <a href="{{ section.settings.cta_url }}" class="ctb__cta-link">
          <em>{{ section.settings.cta_text }}</em>
          <span class="ctb__cta-arrow" aria-hidden="true">→</span>
        </a>
      </div>
    {%- endif -%}

  </div>
</section>

<style>
  @import url('https://fonts.googleapis.com/css2?family=Figtree:wght@300;400;600&family=Playfair+Display:ital,wght@1,500&display=swap');

  #ctb-{{ section.id }} {
    --bg:          {{ c_bg }};
    --ink:         {{ c_ink }};
    --accent:      {{ c_accent }};
    --body-clr:    {{ c_body }};
    --card-border: {{ c_card_border }};
    --glow-a:      {{ glow_a_rgb }};
    --glow-b:      {{ glow_b_rgb }};
  }

  /* Shopify-Wrapper-Margin entfernen */
  #shopify-section-{{ section.id }} {
    margin: 0 !important;
    padding: 0 !important;
  }

  #ctb-{{ section.id }},
  #ctb-{{ section.id }} * { box-sizing: border-box; margin: 0; padding: 0; }

  /* ── Banner ── */
  #ctb-{{ section.id }} {
    background:
      radial-gradient(ellipse at 85% 10%, rgba(var(--glow-a), 0.40) 0%, transparent 52%),
      radial-gradient(ellipse at 15% 90%, rgba(var(--glow-b), 0.18) 0%, transparent 48%),
      var(--bg);
    font-family: 'Figtree', sans-serif;
    -webkit-font-smoothing: antialiased;
    padding: 4rem 0;
    overflow: hidden;
    position: relative;
  }

  /* ── Inner Grid ── */
  #ctb-{{ section.id }} .ctb__inner {
    max-width: 1260px;
    margin: 0 auto;
    padding: 0 max(24px, 5rem);
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: 2rem 4rem;
  }

  /* ── Badge (links) ── */
  #ctb-{{ section.id }} .ctb__badge-col {
    display: flex;
    flex-direction: row;
    align-items: center;
    gap: 14px;
    flex-shrink: 0;
  }

  #ctb-{{ section.id }} .ctb__badge-icon {
    width: 58px;
    height: 58px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.09);
    border: 1px solid rgba(255, 255, 255, 0.14);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    color: var(--accent);
    backdrop-filter: blur(4px);
  }

  #ctb-{{ section.id }} .ctb__badge-text {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  #ctb-{{ section.id }} .ctb__badge-line {
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--accent);
    line-height: 1.5;
    display: block;
  }

  /* ── Content (mitte) ── */
  #ctb-{{ section.id }} .ctb__eyebrow {
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.24em;
    text-transform: uppercase;
    color: var(--accent);
    margin-bottom: 12px;
  }

  #ctb-{{ section.id }} .ctb__heading {
    font-family: 'Playfair Display', Georgia, serif;
    font-style: italic;
    font-weight: 500;
    font-size: clamp(26px, 3.2vw, 50px);
    line-height: 1.1;
    color: var(--ink);
    margin-bottom: 16px;
  }

  #ctb-{{ section.id }} .ctb__body {
    font-size: clamp(14px, 1.1vw, 16px);
    font-weight: 300;
    line-height: 1.78;
    color: var(--body-clr);
    max-width: 500px;
  }

  /* ── CTA-Karte (rechts) ── */
  #ctb-{{ section.id }} .ctb__cta-card {
    border: 1.5px solid var(--card-border);
    border-radius: 12px;
    padding: 26px 32px;
    min-width: 220px;
    flex-shrink: 0;
    backdrop-filter: blur(4px);
    background: rgba(255, 255, 255, 0.03);
    transition: background 0.25s ease;
  }

  #ctb-{{ section.id }} .ctb__cta-card:hover {
    background: rgba(255, 255, 255, 0.07);
  }

  #ctb-{{ section.id }} .ctb__cta-eyebrow {
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.24em;
    text-transform: uppercase;
    color: var(--accent);
    margin-bottom: 10px;
  }

  #ctb-{{ section.id }} .ctb__cta-link {
    font-family: 'Playfair Display', Georgia, serif;
    font-style: italic;
    font-size: clamp(18px, 1.8vw, 26px);
    font-weight: 500;
    color: var(--ink);
    text-decoration: none;
    display: flex;
    align-items: center;
    gap: 10px;
    line-height: 1.25;
    transition: opacity 0.22s ease, gap 0.22s ease;
  }

  #ctb-{{ section.id }} .ctb__cta-link:hover {
    opacity: 0.82;
    gap: 16px;
  }

  #ctb-{{ section.id }} .ctb__cta-arrow {
    font-style: normal;
    font-family: 'Figtree', sans-serif;
    font-size: 1.1em;
  }

  /* ── Scroll-Reveal Animation ── */
  #ctb-{{ section.id }} .ctb__badge-col,
  #ctb-{{ section.id }} .ctb__content,
  #ctb-{{ section.id }} .ctb__cta-card {
    opacity: 0;
    transform: translateY(18px);
    transition: opacity 0.6s ease, transform 0.6s ease;
  }

  #ctb-{{ section.id }}.ctb--visible .ctb__badge-col {
    opacity: 1; transform: translateY(0);
    transition-delay: 0s;
  }
  #ctb-{{ section.id }}.ctb--visible .ctb__content {
    opacity: 1; transform: translateY(0);
    transition-delay: 0.12s;
  }
  #ctb-{{ section.id }}.ctb--visible .ctb__cta-card {
    opacity: 1; transform: translateY(0);
    transition-delay: 0.24s;
  }

  /* Kein Flackern im Theme-Editor */
  .shopify-design-mode #ctb-{{ section.id }} .ctb__badge-col,
  .shopify-design-mode #ctb-{{ section.id }} .ctb__content,
  .shopify-design-mode #ctb-{{ section.id }} .ctb__cta-card {
    opacity: 1; transform: none;
  }

  /* ── Mobile ── */
  @media (max-width: 900px) {
    #ctb-{{ section.id }} {
      padding: 2.5rem 0;
    }

    #ctb-{{ section.id }} .ctb__inner {
      grid-template-columns: 1fr;
      gap: 1.75rem;
      padding: 0 16px;
    }

    #ctb-{{ section.id }} .ctb__badge-col {
      flex-direction: row;
    }

    #ctb-{{ section.id }} .ctb__body {
      max-width: 100%;
    }

    #ctb-{{ section.id }} .ctb__cta-card {
      width: 100%;
      min-width: unset;
    }
  }
</style>

<script>
  (function () {
    var section = document.getElementById('ctb-{{ section.id }}');
    if (!section) return;

    if ('IntersectionObserver' in window) {
      var observer = new IntersectionObserver(function (entries) {
        entries.forEach(function (entry) {
          if (entry.isIntersecting) {
            entry.target.classList.add('ctb--visible');
            observer.unobserve(entry.target);
          }
        });
      }, { threshold: 0.15 });
      observer.observe(section);
    } else {
      section.classList.add('ctb--visible');
    }
  })();
</script>

