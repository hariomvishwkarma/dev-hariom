<section class="quick-nav-stats" id="quick-nav-stats-{{ section.id }}" style="background:{{ section.settings.section_bg_color }};">
  {%- assign nav_blocks = section.blocks | where: "type", "nav_card" -%}
  {%- assign stat_blocks = section.blocks | where: "type", "stat" -%}

  {%- if nav_blocks.size > 0 -%}
    <div class="quick-nav page-width">
      {%- if section.settings.nav_eyebrow != blank -%}
        <p class="quick-nav__eyebrow" style="color:{{ section.settings.eyebrow_color }};">{{ section.settings.nav_eyebrow }}</p>
      {%- endif -%}
      <div class="quick-nav__grid">
        {%- for block in nav_blocks -%}
          <a
            href="{{ block.settings.link_url }}"
            class="quick-nav__card"
            style="background:{{ block.settings.card_bg }}; border-color:{{ block.settings.card_border }};"
            {{ block.shopify_attributes }}
          >
            {%- if block.settings.emoji != blank -%}
              <span class="quick-nav__card-emoji">{{ block.settings.emoji }}</span>
            {%- endif -%}
            <div class="quick-nav__card-text">
              <span class="quick-nav__card-title" style="color:{{ block.settings.title_color }};">{{ block.settings.title }}</span>
              {%- if block.settings.subtitle != blank -%}
                <span class="quick-nav__card-subtitle" style="color:{{ block.settings.subtitle_color }};">{{ block.settings.subtitle }}</span>
              {%- endif -%}
            </div>
            <span class="quick-nav__card-arrow" style="color:{{ block.settings.arrow_color }};">&#8594;</span>
          </a>
        {%- endfor -%}
      </div>
    </div>
  {%- endif -%}

  {%- if stat_blocks.size > 0 -%}
    <div class="stats-bar page-width">
      {%- for block in stat_blocks -%}
        <div class="stats-bar__item" {{ block.shopify_attributes }}>
          <span class="stats-bar__number" style="color:{{ block.settings.number_color }};">
            {{ block.settings.number }}<sup class="stats-bar__plus">+</sup>
          </span>
          <span class="stats-bar__label" style="color:{{ block.settings.label_color }};">{{ block.settings.label }}</span>
        </div>
      {%- endfor -%}
    </div>
  {%- endif -%}
</section>

<style>
  /* ── Wrapper ── */
  .quick-nav-stats {
    padding: 48px 0 0;
  }
  .quick-nav-stats .page-width {
    padding-left: max(24px, 5rem);
    padding-right: max(24px, 5rem);
  }

  /* ── Eyebrow ── */
  .quick-nav__eyebrow {
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    margin: 0 0 16px;
  }

  /* ── Nav Grid ── */
  .quick-nav__grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 14px;
  }

  /* ── Nav Card ── */
  .quick-nav__card {
    display: flex;
    align-items: center;
    gap: 14px;
    padding: 18px 20px;
    border: 1px solid;
    border-radius: 12px;
    text-decoration: none;
    transition: box-shadow 0.2s ease, transform 0.2s ease;
  }
  .quick-nav__card:hover {
    box-shadow: 0 4px 16px rgba(0,0,0,0.08);
    transform: translateY(-2px);
  }
  .quick-nav__card-emoji {
    font-size: 28px;
    flex-shrink: 0;
    line-height: 1;
  }
  .quick-nav__card-text {
    display: flex;
    flex-direction: column;
    gap: 4px;
    flex: 1;
    min-width: 0;
  }
  .quick-nav__card-title {
    font-size: 15px;
    font-weight: 700;
    line-height: 1.2;
  }
  .quick-nav__card-subtitle {
    font-size: 13px;
    line-height: 1.4;
  }
  .quick-nav__card-arrow {
    font-size: 18px;
    flex-shrink: 0;
    transition: transform 0.2s ease;
  }
  .quick-nav__card:hover .quick-nav__card-arrow {
    transform: translateX(4px);
  }

  /* ── Stats Bar ── */
  .stats-bar {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    margin-top: 56px;
    border-top: 1px solid {{ section.settings.stats_divider_color }};
    border-bottom: 1px solid {{ section.settings.stats_divider_color }};
  }
  .stats-bar__item {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 36px 20px;
    text-align: center;
    position: relative;
  }
  .stats-bar__item:not(:last-child)::after {
    content: '';
    position: absolute;
    right: 0;
    top: 20%;
    height: 60%;
    width: 1px;
    background: {{ section.settings.stats_divider_color }};
  }
  .stats-bar__number {
    font-size: clamp(32px, 3.5vw, 44px);
    font-weight: 700;
    line-height: 1;
    margin-bottom: 8px;
    display: inline-flex;
    align-items: flex-start;
    gap: 2px;
  }
  .stats-bar__plus {
    font-size: 0.55em;
    font-weight: 700;
    margin-top: 4px;
  }
  .stats-bar__label {
    font-size: 14px;
    line-height: 1.4;
  }

  /* ── Responsive ── */
  @media (max-width: 900px) {
    .quick-nav__grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (max-width: 600px) {
    .quick-nav-stats {
      padding: 28px 0 0;
    }
    .quick-nav-stats .page-width {
      padding-left: 16px;
      padding-right: 16px;
    }
    .quick-nav__grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 10px;
    }
    .quick-nav__card {
      padding: 12px 12px;
      border-radius: 10px;
      gap: 8px;
    }
    .quick-nav__card-emoji {
      font-size: 20px;
    }
    .quick-nav__card-title {
      font-size: 13px;
    }
    .quick-nav__card-subtitle {
      font-size: 11px;
    }
    .quick-nav__card-arrow {
      font-size: 14px;
    }
    /* Stats kompakt in einer Reihe */
    .stats-bar {
      grid-template-columns: repeat(3, 1fr);
      margin-top: 28px;
    }
    .stats-bar__item {
      padding: 20px 8px;
    }
    .stats-bar__number {
      font-size: clamp(20px, 6vw, 28px);
      margin-bottom: 4px;
    }
    .stats-bar__label {
      font-size: 11px;
    }
  }
</style>

