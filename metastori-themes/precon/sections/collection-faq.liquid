<section class="ingredients faqsection" style="background-color: {{ section.settings.background_color }}">
  <div class="container">
    {% comment %} <h1>{{ section.settings.heading }}</h1> {% endcomment %}
  
    
      <div class="ingredient_sec">
        
        {% if section.settings.img_1 %}
          <div class="ingredient_left">
             <img src="{{ section.settings.img_1 | img_url:'master' }}"/>
          <h2 class="heading"> {{ section.settings.sectionheading }}  </h2>
            <div class="short_cntfaq">  {{ section.settings.description }}</div>
            <div class="buttonscollection">
              <a href="{{ section.settings.buttoneurl1}}" style="background:{{ section.settings.background_color_button1 }}; color:{{ section.settings.text_color_button1 }}">{{ section.settings.buttontext1  }}</a>
              <a href="{{ section.settings.buttoneurl2}}" style="background:{{ section.settings.background_color_button2 }}; color:{{ section.settings.text_color_button2 }}">{{ section.settings.buttontext2 }}</a>
            </div>
           </div>
          
      {% endif %}

      
<div class="ingredient_right faqright">
        <div class="ingredients-faq">

            {% if collection.metafields.custom.question_answer_faq.value != blank %}
              {% for faq in collection.metafields.custom.question_answer_faq.value %}
                  <div class="faq-item">
                    
                      {% if faq.faq_question != blank %}
                      <div class="faq-question">
                        
                          {{ faq.faq_question }}
                      
                       
                    
                        <span class="faq-icon">
                          <span class="icon-plus">
                            <!-- PLUS ICON -->
                            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none">
<path d="M21 12.0001C21 12.199 20.921 12.3898 20.7803 12.5305C20.6397 12.6711 20.4489 12.7501 20.25 12.7501H12.75V20.2501C12.75 20.449 12.671 20.6398 12.5303 20.7805C12.3897 20.9211 12.1989 21.0001 12 21.0001C11.8011 21.0001 11.6103 20.9211 11.4697 20.7805C11.329 20.6398 11.25 20.449 11.25 20.2501V12.7501H3.75C3.55109 12.7501 3.36032 12.6711 3.21967 12.5305C3.07902 12.3898 3 12.199 3 12.0001C3 11.8012 3.07902 11.6104 3.21967 11.4698C3.36032 11.3291 3.55109 11.2501 3.75 11.2501H11.25V3.75012C11.25 3.55121 11.329 3.36044 11.4697 3.21979C11.6103 3.07914 11.8011 3.00012 12 3.00012C12.1989 3.00012 12.3897 3.07914 12.5303 3.21979C12.671 3.36044 12.75 3.55121 12.75 3.75012V11.2501H20.25C20.4489 11.2501 20.6397 11.3291 20.7803 11.4698C20.921 11.6104 21 11.8012 21 12.0001Z" fill="black"/>
</svg>
                          </span>
                          <span class="icon-minus">
                            <!-- MINUS ICON -->
                            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="21" viewBox="0 0 20 21" fill="none">
                              <path d="M17.5 10.155C17.5 10.3208 17.4342 10.4798 17.3169 10.597C17.1997 10.7142 17.0408 10.78 16.875 10.78H3.125C2.95924 10.78 2.80027 10.7142 2.68306 10.597C2.56585 10.4798 2.5 10.3208 2.5 10.155C2.5 9.98927 2.56585 9.8303 2.68306 9.71309C2.80027 9.59588 2.95924 9.53003 3.125 9.53003H16.875C17.0408 9.53003 17.1997 9.59588 17.3169 9.71309C17.4342 9.8303 17.5 9.98927 17.5 10.155Z" fill="#3DADBB"/>
                            </svg>
                          </span>
                        </span>
                      </div>
                          {% endif %}
                      {% if faq.faq_answer != blank %}
                      <div class="faq-answer"> {{ faq.faq_answer | metafield_tag }}

                     </div>
                      {% endif %}
                     
                    </div>
 {% endfor %}
                    {% endif %}
          
          
        </div>
      </div>

    </div>

  </div>

</section>

{% comment %} {% if collection.metafields.custom.question_answer_faq.value != blank %}
  <div class="collection-faq">
    <h2>FAQs</h2>
    <ul class="faq-list">
      {% for faq in collection.metafields.custom.question_answer_faq.value %}
        <li class="faq-item">
          {% if faq.faq_question != blank %}
            <h3 class="faq-question">{{ faq.faq_question }}</h3>
          {% endif %}

          {% if faq.faq_answer != blank %}
            <div class="faq-answer">
              {{ faq.faq_answer | metafield_tag }}
            </div>
          {% endif %}
        </li>
      {% endfor %}
    </ul>
  </div>
{% endif %} {% endcomment %}

<script>
  document.addEventListener("DOMContentLoaded", function () {
    document.querySelectorAll(".faq-question").forEach(function (question) {
      question.addEventListener("click", function () {
        const isActive = this.classList.contains("active");
        
        // Close all
        document.querySelectorAll(".faq-question").forEach(q => q.classList.remove("active"));
        document.querySelectorAll(".faq-answer").forEach(a => a.style.display = "none");

        // If it was not active, open it
        if (!isActive) {
          this.classList.add("active");
          const answer = this.nextElementSibling;
          answer.style.display = "block";
        }
      });
    });
  });
</script>


<style>
.faq-category {
    font-weight: 700;
    font-size: 18px;
    margin-top: 20px;
    margin-bottom: 10px;
  }

  .faqsection .faq-item {
    border-bottom: 1px solid #ccc;
    background: #fff;
    border-radius: 30px;
    padding: 4px 15px;
    margin-bottom: 16px;
}

  .faqsection .faq-question {
    position: relative;
    cursor: pointer;
    padding-right:15px;
    color: #290907;
    font-size: 16px;
    font-style: normal;
    font-weight: 500;
    line-height: 24px;
}

  .faq-icon {
  float: right;
  display: inline-flex;
  gap: 4px;
  align-items: center;
}

.faqsection .faq-icon svg {
    width: 18px;
    height: 18px;
    stroke: #290907;
    position: relative;
    top: 5px;
}

  

.icon-plus,
.icon-minus {
  display: none;
}

.faq-question.active .icon-minus {
  display: inline-block;
}

.faq-question:not(.active) .icon-plus {
  display: inline-block;
}

  .faq-answer {
    display: none;
    padding-top: 10px;
  }

  .faq-question.active + .faq-answer {
    display: block;
  }

  @media only screen and (max-width: 479px){
   .faq-question{ font-weight:500;}
  }


</style>


