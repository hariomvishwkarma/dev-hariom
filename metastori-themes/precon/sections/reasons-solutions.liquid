<style>
  .reasons {
    padding: 48px 20px;
    font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
    background-color: {{ section.settings.bg_color }};
    color: {{ section.settings.text_color }};
  }
  .reasons__inner {
    max-width: 900px;
    margin: 0 auto;
  }
  .reasons__label {
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 2px;
    text-transform: uppercase;
    color: {{ section.settings.accent_color }};
    margin-bottom: 12px;
  }
  .reasons__heading {
    font-size: clamp(28px, 4.5vw, 42px);
    font-weight: 400;
    line-height: 1.15;
    margin: 0 0 16px;
    max-width: 650px;
  }
  .reasons__heading em {
    font-style: italic;
    font-family: Georgia, 'Times New Roman', serif;
    color: {{ section.settings.accent_color }};
    display: block;
  }
  .reasons__desc {
    font-size: 15px;
    line-height: 1.7;
    opacity: 0.75;
    margin: 0 0 36px;
    max-width: 600px;
  }

  /* ── Reason cards ── */
  .reasons__cards {
    display: flex;
    gap: 16px;
    margin-bottom: 48px;
  }
  .reasons__card {
    flex: 1;
    background: {{ section.settings.card_bg }};
    border-radius: 14px;
    padding: 28px 24px;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .reasons__card-num {
    font-family: Georgia, 'Times New Roman', serif;
    font-style: italic;
    font-size: 36px;
    color: {{ section.settings.card_num_color }};
    opacity: 0.3;
    line-height: 1;
    margin-bottom: 4px;
  }
  .reasons__card-title {
    font-size: 15px;
    font-weight: 700;
    margin: 0;
    line-height: 1.3;
  }
  .reasons__card-text {
    font-size: 14px;
    line-height: 1.6;
    opacity: 0.7;
    margin: 0;
  }

  /* ── Solution banner ── */
  .reasons__solution {
    background: {{ section.settings.solution_bg }};
    color: {{ section.settings.solution_text }};
    border-radius: 16px;
    padding: 40px 32px;
    text-align: center;
  }
  .reasons__solution-label {
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 2px;
    text-transform: uppercase;
    color: {{ section.settings.accent_color }};
    margin-bottom: 10px;
  }
  .reasons__solution-heading {
    font-size: clamp(24px, 3.5vw, 34px);
    font-weight: 400;
    line-height: 1.2;
    margin: 0 auto 14px;
    max-width: 600px;
  }
  .reasons__solution-heading em {
    font-style: italic;
    font-family: Georgia, 'Times New Roman', serif;
    color: {{ section.settings.accent_color }};
  }
  .reasons__solution-desc {
    font-size: 15px;
    line-height: 1.7;
    opacity: 0.8;
    margin: 0 auto;
    max-width: 560px;
  }

  @media (max-width: 768px) {
    .reasons {
      padding: 24px 14px;
    }
    .reasons__label {
      font-size: 10px;
      letter-spacing: 1.5px;
    }
    .reasons__heading {
      font-size: 24px;
      margin-bottom: 10px;
    }
    .reasons__desc {
      font-size: 13px;
      margin-bottom: 24px;
    }
    .reasons__cards {
      flex-direction: column;
      gap: 10px;
      margin-bottom: 28px;
    }
    .reasons__card {
      padding: 20px 18px;
    }
    .reasons__card-num {
      font-size: 28px;
    }
    .reasons__card-title {
      font-size: 14px;
    }
    .reasons__card-text {
      font-size: 13px;
    }
    .reasons__solution {
      padding: 28px 18px;
      border-radius: 12px;
    }
    .reasons__solution-heading {
      font-size: 20px;
    }
    .reasons__solution-desc {
      font-size: 13px;
    }
  }
</style>

<div class="reasons">
  <div class="reasons__inner">
    {% if section.settings.top_label != blank %}
      <div class="reasons__label">{{ section.settings.top_label }}</div>
    {% endif %}

    <h2 class="reasons__heading">{{ section.settings.heading }}</h2>

    {% if section.settings.description != blank %}
      <p class="reasons__desc">{{ section.settings.description }}</p>
    {% endif %}

    <div class="reasons__cards">
      {% for block in section.blocks %}
        {% if block.type == 'reason' %}
          <div class="reasons__card" {{ block.shopify_attributes }}>
            <div class="reasons__card-num">{% if forloop.index < 10 %}0{% endif %}{{ forloop.index }}</div>
            <h3 class="reasons__card-title">{{ block.settings.title }}</h3>
            <p class="reasons__card-text">{{ block.settings.text }}</p>
          </div>
        {% endif %}
      {% endfor %}
    </div>

    <div class="reasons__solution">
      {% if section.settings.solution_label != blank %}
        <div class="reasons__solution-label">{{ section.settings.solution_label }}</div>
      {% endif %}
      <h3 class="reasons__solution-heading">{{ section.settings.solution_heading }}</h3>
      {% if section.settings.solution_desc != blank %}
        <p class="reasons__solution-desc">{{ section.settings.solution_desc }}</p>
      {% endif %}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Reasons + Solution",
  "settings": [
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#faf8f4"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#3a3631"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent Color",
      "default": "#2fb5a0"
    },
    {
      "type": "color",
      "id": "card_bg",
      "label": "Card Background",
      "default": "#f0ece4"
    },
    {
      "type": "color",
      "id": "card_num_color",
      "label": "Card Number Color",
      "default": "#3a3631"
    },
    {
      "type": "color",
      "id": "solution_bg",
      "label": "Solution Banner Background",
      "default": "#5a4a3a"
    },
    {
      "type": "color",
      "id": "solution_text",
      "label": "Solution Banner Text",
      "default": "#f0ece4"
    },
    {
      "type": "header",
      "content": "Top Section"
    },
    {
      "type": "text",
      "id": "top_label",
      "label": "Top Label",
      "default": "Warum klassisches Abnehmen ab 50 nicht mehr greift"
    },
    {
      "type": "html",
      "id": "heading",
      "label": "Heading (use <em> for accent)",
      "default": "Drei Gründe, warum Dein Körper sich <em>verändert hat</em>"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "Was mit 30 funktioniert hat, funktioniert mit 55 nicht mehr. Das hat nichts mit fehlender Disziplin zu tun, sondern mit messbaren Veränderungen in Stoffwechsel und Hormonhaushalt."
    },
    {
      "type": "header",
      "content": "Solution Banner"
    },
    {
      "type": "text",
      "id": "solution_label",
      "label": "Solution Label",
      "default": "Die Lösung"
    },
    {
      "type": "html",
      "id": "solution_heading",
      "label": "Solution Heading",
      "default": "Das Precon <em>Ernährungskonzept</em>"
    },
    {
      "type": "textarea",
      "id": "solution_desc",
      "label": "Solution Description",
      "default": "Seit 1981 ärztlich entwickelt und über die Jahrzehnte verfeinert. Drei klare Phasen, proteinreiche Mahlzeiten unter 235 kcal, kein Hungern, kein Sportzwang. Du isst weiter, nur strukturierter."
    }
  ],
  "blocks": [
    {
      "type": "reason",
      "name": "Reason Card",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Grund"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Description",
          "default": "Beschreibung dieses Grundes."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Reasons + Solution",
      "blocks": [
        { "type": "reason", "settings": { "title": "Grundumsatz sinkt", "text": "Pro Jahrzehnt verlierst Du etwa 2–3% Deines Grundumsatzes. Mit 55 verbrennst Du bei gleichem Verhalten deutlich weniger Kalorien als mit 35." } },
        { "type": "reason", "settings": { "title": "Hormonelle Umstellung", "text": "Östrogen sinkt nach den Wechseljahren. Das verändert die Fettverteilung und macht es schwerer, gerade am Bauch abzunehmen." } },
        { "type": "reason", "settings": { "title": "Muskelmasse nimmt ab", "text": "Weniger Muskelmasse heißt weniger Fettverbrennung im Ruhezustand. Diäten ohne proteinreiche Mahlzeiten verstärken das Problem." } }
      ]
    }
  ]
}
{% endschema %}