{% comment %}
  sections/blog-articles.liquid
  This section renders articles for AJAX fetching
{% endcomment %}

{% comment %} ✅ GET SETTINGS FROM URL PARAMETERS {% endcomment %}
{%- assign show_excerpt = request.query.show_excerpt -%}
{%- assign show_category = request.query.show_category -%}
{%- assign enable_bso_card_styles = request.query.enable_bso_card_styles -%}
{%- assign bso_card_image_height = request.query.bso_card_image_height -%}

{% comment %} ✅ DEFAULT VALUES AGAR URL SE NA AAYE TO {% endcomment %}
{% if show_excerpt == blank %}{% assign show_excerpt = true %}{% endif %}
{% if show_category == blank %}{% assign show_category = true %}{% endif %}
{% if enable_bso_card_styles == blank %}{% assign enable_bso_card_styles = true %}{% endif %}
{% if bso_card_image_height == blank %}{% assign bso_card_image_height = 12 %}{% endif %}

<div id="blog-articles-wrapper">
  {% paginate blog.articles by 250 %}
    {% for article in blog.articles %}
      <div class="article"
        data-preparation="{{ article.metafields.custom.blog_content.value.kochzeit }}"
        data-season="{{ article.metafields.custom.blog_content.value.saisone }}"
        data-Gänge="{{ article.metafields.custom.blog_content.value.gange }}">
        
        {%- render 'article-item-fetch', 
          article: article, 
          heading_size: 'h4', 
          index: forloop.index,
          show_excerpt: show_excerpt,
          show_category: show_category,
          enable_bso_card_styles: enable_bso_card_styles,
          bso_card_image_height: bso_card_image_height
        -%}
      </div>
    {% endfor %}
  {% endpaginate %}
</div>