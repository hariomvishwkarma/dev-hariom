{% comment %}
  Section: Klaviyo Image + Form Embed
  - Desktop: 2-column layout (image left, form right, 50/50)
  - Mobile: stacked layout (image top, form below)
  - Klaviyo form ID is set via theme editor (translatable for multi-region/language)
{% endcomment %}

<section
  id="klaviyo-image-embed-{{ section.id }}"
  class="klaviyo-image-embed"
  style="
    --section-bg: {{ section.settings.background_color }};
    --section-padding-top: {{ section.settings.padding_top }}px;
    --section-padding-bottom: {{ section.settings.padding_bottom }}px;
    --image-height-desktop: {{ section.settings.image_height_desktop }}px;
  "
>
  <div class="klaviyo-image-embed__inner{% if section.settings.full_width %} klaviyo-image-embed__inner--full{% endif %}">

    {%- comment -%} IMAGE COLUMN {%- endcomment -%}
    <div class="klaviyo-image-embed__image-col">
      {%- if section.settings.image != blank -%}
        {%- assign img_url = section.settings.image | image_url: width: 1200 -%}
        {%- assign img_alt = section.settings.image.alt | escape -%}
        <img
          src="{{ img_url }}"
          alt="{{ img_alt }}"
          class="klaviyo-image-embed__img"
          loading="lazy"
          width="{{ section.settings.image.width }}"
          height="{{ section.settings.image.height }}"
        >
      {%- else -%}
        <div class="klaviyo-image-embed__placeholder">
          {{ 'image' | placeholder_svg_tag: 'klaviyo-image-embed__placeholder-svg' }}
        </div>
      {%- endif -%}
    </div>

    {%- comment -%} FORM COLUMN {%- endcomment -%}
    <div class="klaviyo-image-embed__form-col">
      <div class="klaviyo-image-embed__form-wrapper">

        {%- if section.settings.form_heading != blank -%}
          <{{ section.settings.heading_tag }} class="klaviyo-image-embed__heading">
            {{ section.settings.form_heading | escape }}
          </{{ section.settings.heading_tag }}>
        {%- endif -%}

        {%- if section.settings.form_subtext != blank -%}
          <p class="klaviyo-image-embed__subtext">{{ section.settings.form_subtext | escape }}</p>
        {%- endif -%}

        {%- if section.settings.klaviyo_form_id != blank -%}
          <div class="klaviyo-form-{{ section.settings.klaviyo_form_id }}"></div>
        {%- else -%}
          {%- if request.design_mode -%}
            <div class="klaviyo-image-embed__no-form-notice">
              {{ 'sections.klaviyo_embed.no_form_id' | t: default: 'Add your Klaviyo Form ID in the theme editor to display the form.' }}
            </div>
          {%- endif -%}
        {%- endif -%}

      </div>
    </div>

  </div>
</section>

{% stylesheet %}
.klaviyo-image-embed {
  background-color: var(--section-bg, transparent);
  padding-top: var(--section-padding-top, 60px);
  padding-bottom: var(--section-padding-bottom, 60px);
}

.klaviyo-image-embed__inner {
  max-width: 1200px;
  margin: 0 auto;
  padding: 0;
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 0;
  align-items: stretch;
}

.klaviyo-image-embed__inner--full {
  max-width: 100%;
  padding: 0;
}

/* IMAGE */
.klaviyo-image-embed__image-col {
  width: 100%;
  overflow: hidden;
  display: flex;
}

.klaviyo-image-embed__img {
  display: block;
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.klaviyo-image-embed__placeholder {
  width: 100%;
  aspect-ratio: 4 / 3;
  background: #f0f0f0;
  display: flex;
  align-items: center;
  justify-content: center;
}

.klaviyo-image-embed__placeholder-svg {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

/* FORM */
.klaviyo-image-embed__form-col {
  width: 100%;
}

.klaviyo-image-embed__form-wrapper {
  display: flex;
  flex-direction: column;
  gap: 16px;
}

.klaviyo-image-embed__heading {
  margin: 0;
}

.klaviyo-image-embed__subtext {
  margin: 0;
}

.klaviyo-image-embed__no-form-notice {
  padding: 16px;
  border: 2px dashed #ccc;
  color: #888;
  font-size: 14px;
  text-align: center;
}

/* MOBILE */
@media screen and (max-width: 749px) {
  .klaviyo-image-embed__inner {
    grid-template-columns: 1fr;
    gap: 0;
    padding: 0;
  }

  /* Image always appears first (top) on mobile */
  .klaviyo-image-embed__image-col {
    order: 1;
    display: block;
  }

  /* On mobile, image respects natural proportions — no forced height */
  .klaviyo-image-embed__img {
    height: auto;
    object-fit: initial;
  }

  .klaviyo-image-embed__form-col {
    order: 2;
  }
}
{% endstylesheet %}

{% schema %}
{
  "name": "Klaviyo Image + Form",
  "tag": "section",
  "class": "section-klaviyo-embed",
  "settings": [
    {
      "type": "header",
      "content": "Image"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "range",
      "id": "image_height_desktop",
      "min": 200,
      "max": 800,
      "step": 10,
      "unit": "px",
      "label": "Image height (desktop)",
      "default": 500,
      "info": "Set to 0 to use natural image height."
    },
    {
      "type": "header",
      "content": "Klaviyo Form"
    },
    {
      "type": "text",
      "id": "klaviyo_form_id",
      "label": "Klaviyo Form ID",
      "info": "Enter your Klaviyo embedded form ID (e.g. AbCd12). Find it in Klaviyo > Forms > Embed. This field is translatable for multi-region setups."
    },
    {
      "type": "header",
      "content": "Optional Text"
    },
    {
      "type": "text",
      "id": "form_heading",
      "label": "Heading (optional)"
    },
    {
      "type": "select",
      "id": "heading_tag",
      "label": "Heading tag",
      "options": [
        { "value": "h1", "label": "H1" },
        { "value": "h2", "label": "H2" },
        { "value": "h3", "label": "H3" },
        { "value": "h4", "label": "H4" }
      ],
      "default": "h2"
    },
    {
      "type": "text",
      "id": "form_subtext",
      "label": "Subtext (optional)"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "checkbox",
      "id": "full_width",
      "label": "Full width (no max-width container)",
      "default": false
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "default": "#ffffff"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Padding top",
      "default": 60
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Padding bottom",
      "default": 60
    }
  ],
  "presets": [
    {
      "name": "Klaviyo Image + Form"
    }
  ]
}
{% endschema %}
