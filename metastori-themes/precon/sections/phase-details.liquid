<section class="phase-details" id="phase-details-{{ section.id }}">
  <div class="phase-details__inner page-width">

    {%- for block in section.blocks -%}
      {%- assign is_even = forloop.index | modulo: 2 -%}
      {%- assign phase_num = forloop.index | prepend: '00' | slice: -2, 2 -%}

      <div
        class="phase-card {% if is_even == 0 %}phase-card--reversed{% endif %}"
        style="--accent: {{ block.settings.accent_color }};"
        {{ block.shopify_attributes }}
      >
        <!-- ── Image column ── -->
        <div class="phase-card__media">
          {%- if block.settings.image != blank -%}
            {{ block.settings.image | image_url: width: 1200 | image_tag:
              class: 'phase-card__img',
              loading: 'lazy',
              sizes: '(max-width: 960px) 100vw, 50vw',
              widths: '375, 750, 1000, 1200'
            }}
          {%- else -%}
            {{ 'lifestyle-1' | placeholder_svg_tag: 'phase-card__img phase-card__img--placeholder' }}
          {%- endif -%}

          {%- if block.settings.duration_badge != blank -%}
            <span class="phase-card__duration" style="background-color: var(--accent);">
              {{ block.settings.duration_badge }}
            </span>
          {%- endif -%}
        </div>

        <!-- ── Content column ── -->
        <div class="phase-card__content">

          <!-- Phase number + eyebrow + title -->
          <div class="phase-card__header">
            <span class="phase-card__number" style="color: var(--accent);">{{ phase_num }}</span>
            {%- if block.settings.eyebrow != blank -%}
              <span class="phase-card__eyebrow">{{ block.settings.eyebrow }}</span>
            {%- endif -%}
          </div>

          {%- if block.settings.title != blank -%}
            <h3 class="phase-card__title">{{ block.settings.title }}</h3>
          {%- endif -%}

          <!-- Tagesablauf icons -->
          {%- if block.settings.schedule_heading != blank -%}
            <p class="phase-card__schedule-heading">{{ block.settings.schedule_heading }}</p>
          {%- endif -%}

          {%- assign icon_count = block.settings.icon_count -%}
          {%- if icon_count > 0 -%}
            <div class="phase-card__icons">
              {%- for i in (1..icon_count) -%}
                {%- capture icon_key -%}icon_image_{{ i }}{%- endcapture -%}
                <span class="phase-card__icon-circle" style="border-color: var(--accent);">
                  {%- if block.settings[icon_key] != blank -%}
                    {{ block.settings[icon_key] | image_url: width: 60 | image_tag: class: 'phase-card__icon-img' }}
                  {%- else -%}
                    <svg width="20" height="20" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg">
                      <circle cx="10" cy="10" r="8" stroke="currentColor" stroke-width="1.5" fill="none" style="color: var(--accent);"/>
                    </svg>
                  {%- endif -%}
                </span>
              {%- endfor -%}
            </div>
          {%- endif -%}

          <!-- Detail rows: Was / Kalorien / Ziel -->
          <dl class="phase-card__details">
            {%- if block.settings.detail_label_1 != blank -%}
              <div class="phase-card__detail-row">
                <dt>{{ block.settings.detail_label_1 }}</dt>
                <dd>{{ block.settings.detail_value_1 }}</dd>
              </div>
            {%- endif -%}
            {%- if block.settings.detail_label_2 != blank -%}
              <div class="phase-card__detail-row">
                <dt>{{ block.settings.detail_label_2 }}</dt>
                <dd>{{ block.settings.detail_value_2 }}</dd>
              </div>
            {%- endif -%}
            {%- if block.settings.detail_label_3 != blank -%}
              <div class="phase-card__detail-row">
                <dt>{{ block.settings.detail_label_3 }}</dt>
                <dd>{{ block.settings.detail_value_3 }}</dd>
              </div>
            {%- endif -%}
          </dl>

          <!-- Rules callout -->
          {%- if block.settings.rules_text != blank -%}
            <div class="phase-card__rules" style="background-color: {{ block.settings.rules_bg_color }};">
              <p>
                {%- if block.settings.rules_label != blank -%}
                  <strong>{{ block.settings.rules_label }}</strong>
                {%- endif -%}
                {{ block.settings.rules_text }}
              </p>
            </div>
          {%- endif -%}

          <!-- Product note -->
          {%- if block.settings.product_text != blank -%}
            <div class="phase-card__product">
              {%- if block.settings.product_icon != blank -%}
                <span class="phase-card__product-icon">
                  {{ block.settings.product_icon | image_url: width: 40 | image_tag }}
                </span>
              {%- endif -%}
              <p>
                {%- if block.settings.product_label != blank -%}
                  <strong>{{ block.settings.product_label }}</strong>
                {%- endif -%}
                {{ block.settings.product_text }}
              </p>
            </div>
          {%- endif -%}

          <!-- CTA link -->
          {%- if block.settings.cta_label != blank -%}
            <a href="{{ block.settings.cta_link }}" class="phase-card__cta" style="color: var(--accent);">
              {{ block.settings.cta_label }}&nbsp;&rarr;
            </a>
          {%- endif -%}

        </div>
      </div>
    {%- endfor -%}

    <!-- ── Bottom CTAs ── -->
    {%- if section.settings.bottom_cta_primary_label != blank or section.settings.bottom_cta_secondary_label != blank -%}
      <div class="phase-details__bottom-ctas">
        {%- if section.settings.bottom_cta_primary_label != blank -%}
          <a
            href="{{ section.settings.bottom_cta_primary_link }}"
            class="phase-details__btn phase-details__btn--primary"
            style="background-color: {{ section.settings.bottom_cta_primary_bg }}; border-color: {{ section.settings.bottom_cta_primary_bg }}; color: {{ section.settings.bottom_cta_primary_text }};"
          >
            {{ section.settings.bottom_cta_primary_label }}
          </a>
        {%- endif -%}

        {%- if section.settings.bottom_cta_secondary_label != blank -%}
          <a
            href="{{ section.settings.bottom_cta_secondary_link }}"
            class="phase-details__btn phase-details__btn--secondary"
            style="background-color: {{ section.settings.bottom_cta_secondary_bg }}; color: {{ section.settings.bottom_cta_secondary_text }}; border-color: {{ section.settings.bottom_cta_secondary_border }};"
          >
            {{ section.settings.bottom_cta_secondary_label }}
          </a>
        {%- endif -%}
      </div>
    {%- endif -%}

  </div>
</section>

<style>
  /* ══════════════════════════════════
     Section
     ══════════════════════════════════ */
  .phase-details {
    background-color: {{ section.settings.section_bg }};
    padding: {{ section.settings.padding_top }}px 0 {{ section.settings.padding_bottom }}px;
  }

  .phase-details__inner {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 24px;
    display: flex;
    flex-direction: column;
    gap: {{ section.settings.card_gap }}px;
  }

  /* ══════════════════════════════════
     Card
     ══════════════════════════════════ */
  .phase-card {
    display: grid;
    grid-template-columns: 1fr 1fr;
    background: {{ section.settings.card_bg }};
    border-radius: {{ section.settings.card_radius }}px;
    overflow: hidden;
    border: {{ section.settings.card_border_thickness }}px solid {{ section.settings.card_border_color }};
  }

  .phase-card--reversed .phase-card__media {
    order: 2;
  }

  .phase-card--reversed .phase-card__content {
    order: 1;
  }

  /* ── Image ── */
  .phase-card__media {
    position: relative;
    min-height: 400px;
  }

  .phase-card__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .phase-card__img--placeholder {
    background: #eee;
  }

  .phase-card__duration {
    position: absolute;
    bottom: 20px;
    left: 20px;
    padding: 6px 18px;
    border-radius: 6px;
    color: #fff;
    font-size: 13px;
    font-weight: 600;
  }

  .phase-card--reversed .phase-card__duration {
    left: auto;
    right: 20px;
  }

  /* ── Content ── */
  .phase-card__content {
    padding: 40px 44px;
    display: flex;
    flex-direction: column;
    justify-content: center;
  }

  /* ── Header (number + eyebrow) ── */
  .phase-card__header {
    display: flex;
    align-items: baseline;
    gap: 12px;
    margin-bottom: 4px;
  }

  .phase-card__number {
    font-size: 42px;
    font-weight: 300;
    line-height: 1;
    opacity: 0.6;
  }

  .phase-card__eyebrow {
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.13em;
    text-transform: uppercase;
    color: {{ section.settings.text_color }};
  }

  .phase-card__title {
    font-size: clamp(22px, 2.2vw, 28px);
    font-weight: 400;
    color: {{ section.settings.heading_color }};
    margin: 0 0 24px;
    line-height: 1.3;
  }

  /* ── Schedule heading + icons ── */
  .phase-card__schedule-heading {
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.13em;
    text-transform: uppercase;
    color: {{ section.settings.text_color }};
    margin: 0 0 10px;
  }

  .phase-card__icons {
    display: flex;
    gap: 8px;
    margin-bottom: 20px;
    flex-wrap: wrap;
  }

  .phase-card__icon-circle {
    width: 36px;
    height: 36px;
    border-radius: 50%;
    border: 2px solid;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    flex-shrink: 0;
  }

  .phase-card__icon-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: 50%;
  }

  /* ── Detail rows ── */
  .phase-card__details {
    margin: 0 0 20px;
  }

  .phase-card__detail-row {
    display: flex;
    gap: 16px;
    padding: 5px 0;
    font-size: 14px;
    line-height: 1.5;
    color: {{ section.settings.text_color }};
  }

  .phase-card__detail-row dt {
    flex-shrink: 0;
    min-width: 70px;
    font-weight: 400;
    color: #8a8275;
  }

  .phase-card__detail-row dd {
    margin: 0;
    font-weight: 600;
    color: {{ section.settings.heading_color }};
  }

  /* ── Rules callout ── */
  .phase-card__rules {
    border-radius: 10px;
    padding: 16px 20px;
    margin-bottom: 18px;
    font-size: 13px;
    line-height: 1.55;
    color: {{ section.settings.text_color }};
  }

  .phase-card__rules p {
    margin: 0;
  }

  /* ── Product note ── */
  .phase-card__product {
    display: flex;
    gap: 10px;
    align-items: flex-start;
    margin-bottom: 20px;
    font-size: 13px;
    line-height: 1.55;
    color: {{ section.settings.text_color }};
  }

  .phase-card__product p {
    margin: 0;
  }

  .phase-card__product-icon {
    flex-shrink: 0;
    width: 22px;
    height: 22px;
  }

  .phase-card__product-icon img {
    width: 100%;
    height: auto;
  }

  /* ── CTA ── */
  .phase-card__cta {
    font-size: 14px;
    font-weight: 600;
    text-decoration: none;
    display: inline-block;
    transition: opacity 0.2s ease;
  }

  .phase-card__cta:hover {
    opacity: 0.7;
  }

  /* ══════════════════════════════════
     Bottom CTAs
     ══════════════════════════════════ */
  .phase-details__bottom-ctas {
    display: flex;
    justify-content: center;
    align-items: center;
    flex-wrap: wrap;
    gap: 16px;
    padding-top: 20px;
  }

  .phase-details__btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 18px 40px;
    font-size: 16px;
    font-weight: 500;
    border-radius: 50px;
    text-decoration: none;
    transition: all 0.25s ease;
    cursor: pointer;
    white-space: nowrap;
    border: 2px solid;
  }

  .phase-details__btn--primary:hover {
    opacity: 0.85;
  }

  .phase-details__btn--secondary:hover {
    opacity: 0.8;
  }

  /* ══════════════════════════════════
     Responsive
     ══════════════════════════════════ */
  @media (max-width: 960px) {
    .phase-card {
      grid-template-columns: 1fr;
    }

    .phase-card__media {
      min-height: 280px;
      order: 0 !important;
    }

    .phase-card__content {
      order: 1 !important;
      padding: 28px 24px 32px;
    }

    .phase-card__duration {
      left: 16px !important;
      right: auto !important;
      bottom: 16px;
    }

    .phase-details__bottom-ctas {
      flex-direction: column;
      align-items: stretch;
    }

    .phase-details__btn {
      text-align: center;
    }
  }
</style>

