<section class="qbnr" id="qbnr-{{ section.id }}">

  <!-- ── Background image ── -->
  {%- if section.settings.background_image != blank -%}
    <div class="qbnr__bg qbnr__bg--desktop">
      {{ section.settings.background_image | image_url: width: 2600 | image_tag:
        class: 'qbnr__img',
        loading: 'eager',
        fetchpriority: 'high',
        sizes: '100vw',
        widths: '375, 750, 1100, 1500, 2000, 2600'
      }}
    </div>
  {%- endif -%}

  {%- assign mobile_img = section.settings.mobile_image -%}
  {%- if mobile_img != blank -%}
    <div class="qbnr__bg qbnr__bg--mobile">
      {{ mobile_img | image_url: width: 1100 | image_tag:
        class: 'qbnr__img',
        loading: 'eager',
        fetchpriority: 'high',
        sizes: '100vw',
        widths: '375, 750, 1100'
      }}
    </div>
  {%- endif -%}

  <!-- ── Gradient wash for text legibility ── -->
  <div class="qbnr__wash"></div>

  <!-- ── Pills: top right ── -->
  {%- if section.blocks.size > 0 -%}
    <div class="qbnr__pills">
      {%- for block in section.blocks -%}
        {%- if block.type == 'pill' and block.settings.text != blank -%}
          <span
            class="qbnr__pill"
            style="background: {{ block.settings.bg }}; color: {{ block.settings.text_color }}; border-color: {{ block.settings.border_color }};"
            {{ block.shopify_attributes }}
          >{{ block.settings.text }}</span>
        {%- endif -%}
      {%- endfor -%}
    </div>
  {%- endif -%}

  <!-- ── Quote: bottom left ── -->
  {%- if section.settings.quote != blank -%}
    <div class="qbnr__quote-wrap page-width">
      <p class="qbnr__quote" style="color: {{ section.settings.quote_color }};">
        <em>{{ section.settings.quote }}</em>
      </p>
    </div>
  {%- endif -%}

</section>

<style>
  /* ── Wrapper ── */
  .qbnr {
    position: relative;
    width: 100%;
    min-height: {{ section.settings.min_height }}px;
    overflow: hidden;
    display: flex;
    align-items: flex-end;
  }

  /* ── Background image ── */
  .qbnr__bg {
    position: absolute;
    inset: 0;
    z-index: 0;
  }

  .qbnr__bg--mobile { display: none; }

  .qbnr__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }

  {%- if mobile_img != blank -%}
    @media (max-width: 768px) {
      .qbnr__bg--desktop { display: none; }
      .qbnr__bg--mobile  { display: block; }
    }
  {%- endif -%}

  /* ── Gradient wash (bottom-left) ── */
  .qbnr__wash {
    position: absolute;
    inset: 0;
    z-index: 1;
    pointer-events: none;
    background: linear-gradient(
      to top right,
      rgba(0, 0, 0, 0.50) 0%,
      rgba(0, 0, 0, 0.18) 40%,
      transparent 65%
    );
  }

  /* ── Pills (top right) ── */
  .qbnr__pills {
    position: absolute;
    top: {{ section.settings.pills_offset_top }}px;
    right: max(24px, 4rem);
    z-index: 3;
    display: flex;
    flex-direction: row;
    align-items: center;
    flex-wrap: nowrap;
    gap: 10px;
  }

  .qbnr__pill {
    display: inline-block;
    font-family: 'Figtree', sans-serif;
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.02em;
    padding: 10px 22px;
    border-radius: 50px;
    border: 1.5px solid transparent;
    backdrop-filter: blur(6px);
    -webkit-backdrop-filter: blur(6px);
    white-space: nowrap;
  }

  /* ── Quote ── */
  .qbnr__quote-wrap {
    position: relative;
    z-index: 2;
    width: 100%;
    padding: 0 max(24px, 4rem) 36px;
  }

  .qbnr__quote {
    font-family: var(--accent-font-family);
    font-style: var(--accent-font-style);
    font-size: clamp(24px, 3vw, 44px);
    font-weight: 500;
    line-height: 1.35;
    margin: 0;
    max-width: 560px;
    text-align: left;
  }

  /* ── Mobile ── */
  @media (max-width: 768px) {
    .qbnr {
      min-height: 420px;
      align-items: flex-end;
    }

    /* 2 badges per row, 3rd wraps below */
    .qbnr__pills {
      top: 16px;
      right: 16px;
      flex-wrap: wrap;
      justify-content: flex-end;
      max-width: 52vw;
    }

    .qbnr__pill {
      font-size: 12px;
      padding: 8px 14px;
    }

    .qbnr__quote-wrap {
      padding-bottom: 28px;
      padding-left: 20px;
      padding-right: 20px;
    }

    .qbnr__quote {
      font-size: clamp(20px, 5.5vw, 32px);
      text-align: left;
    }
  }
</style>

{% schema %}
{
  "name": "Quote Banner",
  "tag": "section",
  "class": "section-quote-banner",
  "settings": [
    {
      "type": "header",
      "content": "Images"
    },
    {
      "type": "image_picker",
      "id": "background_image",
      "label": "Background image"
    },
    {
      "type": "image_picker",
      "id": "mobile_image",
      "label": "Mobile background image",
      "info": "Falls back to the desktop image if empty."
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "min_height",
      "min": 300,
      "max": 800,
      "step": 20,
      "default": 500,
      "unit": "px",
      "label": "Minimum height"
    },
    {
      "type": "header",
      "content": "Quote"
    },
    {
      "type": "text",
      "id": "quote",
      "label": "Quote text",
      "default": "„Wie ein Schluck Karibik — nur ohne Flug.“"
    },
    {
      "type": "color",
      "id": "quote_color",
      "label": "Quote color",
      "default": "#ffffff"
    },
    {
      "type": "range",
      "id": "quote_offset_bottom",
      "min": 16,
      "max": 80,
      "step": 4,
      "default": 36,
      "unit": "px",
      "label": "Quote distance from bottom"
    },
    {
      "type": "header",
      "content": "Pills"
    },
    {
      "type": "range",
      "id": "pills_offset_top",
      "min": 16,
      "max": 80,
      "step": 4,
      "default": 32,
      "unit": "px",
      "label": "Pills distance from top"
    }
  ],
  "blocks": [
    {
      "type": "pill",
      "name": "Pill Badge",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "default": "Neu"
        },
        {
          "type": "color",
          "id": "bg",
          "label": "Background",
          "default": "#ffffff"
        },
        {
          "type": "color",
          "id": "text_color",
          "label": "Text color",
          "default": "#2c2c2c"
        },
        {
          "type": "color",
          "id": "border_color",
          "label": "Border color",
          "default": "#ffffff"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Quote Banner",
      "blocks": [
        {
          "type": "pill",
          "settings": {
            "text": "Neue Rezeptur",
            "bg": "#ffffff",
            "text_color": "#2c2c2c",
            "border_color": "#ffffff"
          }
        },
        {
          "type": "pill",
          "settings": {
            "text": "Nur für kurze Zeit",
            "bg": "#4FBFBE",
            "text_color": "#ffffff",
            "border_color": "#4FBFBE"
          }
        },
        {
          "type": "pill",
          "settings": {
            "text": "Jetzt erhältlich",
            "bg": "#ffffff",
            "text_color": "#2c2c2c",
            "border_color": "#ffffff"
          }
        }
      ]
    }
  ]
}
{% endschema %}