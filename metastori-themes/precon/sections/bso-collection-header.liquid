{% style %}
  #shopify-section-{{ section.id }} h1.heading {
    line-height: 2.25rem;
    margin-bottom: 1rem !important;
    display: block;
  }

  #shopify-section-{{ section.id }} span.separator {
    display: none;
  }

  #shopify-section-{{ section.id }} span.subheadline {
    display: block;
    font-size: 1.2rem;
    line-height: 1.4rem;
    font-family: var(--accent-font-family);
    font-style: var(--accent-font-style);
    font-weight: 500;
  }

  #shopify-section-{{ section.id }} .collection_short_text {
    display: block;
  }

  @media (max-width: 767px) {
    #shopify-section-{{ section.id }} .collection-list {
      padding-top: 0rem;
    }
  }

 

  #shopify-section-{{ section.id }} .collection-item {
    border-bottom: unset;
    padding-bottom: unset;
  }


{% endstyle %}
<div class="collection-list collection-name " style="background-color: {{ section.settings.collection_bg_color11 }}">

<div class="container">
  
        <div class="collection-item" >

          <h1 class="heading" style="color: {{ section.settings.title_color11 }}">
            <span>{% if collection.metafields.custom.category_title != blank %}
                {{ collection.metafields.custom.category_title }}
              {% else %}
                {{ collection.title }}
            {% endif %}</span>
            {% if collection.metafields.custom.category_sub_title != blank %}
              <span class="separator"> - </span>
              <span class="subheadline collection_subheadline">{{ collection.metafields.custom.category_sub_title }}</span>
            {% endif %}
          </h1>

        </div>

        {% if collection.metafields.custom.kurzbeschreibung != blank and section.settings.display_introtext %}
          <div class="collection_short_text" style="line-height: 1.5rem; color: {{ section.settings.introtext_color }};">{{ collection.metafields.custom.kurzbeschreibung }}</div>
        {% endif %}

    </div>

</div>


{% schema %}
{
  "name": "BSO: Collection Header",
  "enabled_on": {
    "templates": ["collection"],
  },
  "settings": [
    
    {
      "type": "color",
      "id": "title_color11",
      "label": "Heading color",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "introtext_color",
      "label": "Introtext color",
      "default": "#290907"
    },
    {
      "type": "color",
      "id": "collection_bg_color11",
      "label": "Collection background color",
      "default": "#ffffff"
    },
    {
      "type" : "checkbox",
      "id" : "display_introtext",
      "label" : "Display introtext?",
      "default" : false
    }
  ],
  "presets": [
    {
      "name": "BSO Collection Header",
      "category": "Better Sell Online (SEO)"
    }
  ]
}
{% endschema %}
