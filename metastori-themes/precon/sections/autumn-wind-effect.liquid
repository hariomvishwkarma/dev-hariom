{%- comment -%}
  sections/autumn-wind-effect.liquid
  Herbst-Wind Effekt – Blätter & Haselnüsse wehen beim Seitenaufruf über die Seite.
  Einmalige Canvas-Animation, pointer-events: none → blockiert keine Klicks.
{%- endcomment -%}

{%- assign particle_count = section.settings.particle_count | default: 45 -%}
{%- assign duration_ms    = section.settings.duration_ms    | default: 6500 -%}
{%- assign hazel_ratio    = section.settings.hazel_ratio    | default: 25 -%}

<div id="awe-{{ section.id }}" aria-hidden="true" style="
  position:fixed;inset:0;z-index:9999;
  pointer-events:none;
  transition:opacity 1s ease;
">
  <canvas id="awe-c-{{ section.id }}" style="display:block;width:100%;height:100%;"></canvas>
</div>

<script>
(function () {
  'use strict';

  /* ── Config ─────────────────────────────────────────── */
  var PARTICLE_COUNT = {{ particle_count }};
  var TOTAL_MS       = {{ duration_ms }};
  var SPAWN_WINDOW   = Math.round(TOTAL_MS * 0.45);
  var HAZEL_CHANCE   = {{ hazel_ratio }} / 100;

  /* ── Sprites (base64 PNG, transparent BG) ─────────────  */
  var LEAF_SRC  = 'data:image/png;base64,';
  var HAZEL_SRC = 'data:image/png;base64,';

  var leafImg  = new Image();
  var hazelImg = new Image();
  var loaded   = 0;

  function onLoad() {
    loaded++;
    if (loaded === 2) init();
  }
  leafImg.onload  = onLoad;
  hazelImg.onload = onLoad;
  leafImg.src  = LEAF_SRC;
  hazelImg.src = HAZEL_SRC;

  /* ── Canvas ─────────────────────────────────────────── */
  var wrap   = document.getElementById('awe-{{ section.id }}');
  var canvas = document.getElementById('awe-c-{{ section.id }}');
  var ctx    = canvas.getContext('2d');
  var W, H;

  function resize() {
    W = canvas.width  = window.innerWidth;
    H = canvas.height = window.innerHeight;
  }
  resize();
  window.addEventListener('resize', resize, { passive: true });

  /* ── Partikel ───────────────────────────────────────── */
  function makeParticle(i) {
    var isHazel  = Math.random() < HAZEL_CHANCE;
    var fromLeft = Math.random() < 0.72;
    /* Dargestellte Breite des Sprites in px */
    var drawnW   = isHazel
      ? 44 + Math.random() * 28        /* 44–72 px */
      : 38 + Math.random() * 34;       /* 38–72 px */
    /* Höhe proportional zum Sprite-Seitenverhältnis */
    var drawnH   = isHazel
      ? drawnW * (66 / 85)             /* Haselnuss: breiter als hoch */
      : drawnW * (122 / 100);          /* Blatt: höher als breit */

    return {
      isHazel:     isHazel,
      spawnAt:     (i / PARTICLE_COUNT) * SPAWN_WINDOW + Math.random() * 400,
      spawned:     false,
      done:        false,

      x:           fromLeft ? -80 : Math.random() * window.innerWidth,
      y:           fromLeft ? Math.random() * window.innerHeight * 0.9 : -80,
      fromLeft:    fromLeft,

      vx:          fromLeft ? 2.0 + Math.random() * 3.5 : 0.4 + Math.random() * 1.8,
      vy:          fromLeft ? -0.6 + Math.random() * 1.8 : 1.5 + Math.random() * 3.0,

      wobbleAmp:   0.25 + Math.random() * 0.75,
      wobbleFreq:  0.0010 + Math.random() * 0.0018,
      wobblePhase: Math.random() * Math.PI * 2,

      gust:        Math.random() < 0.3,
      gustAt:      500 + Math.random() * 1500,
      gustDone:    false,

      rotation:    Math.random() * Math.PI * 2,
      rotSpeed:    (Math.random() - 0.5) * 0.038,

      drawnW:      drawnW,
      drawnH:      drawnH,
      alpha:       0,
    };
  }

  var particles = [];
  function init() {
    for (var i = 0; i < PARTICLE_COUNT; i++) {
      particles.push(makeParticle(i));
    }
    requestAnimationFrame(animate);
  }

  /* ── Animation loop ─────────────────────────────────── */
  var startTime = null;
  var done      = false;

  function animate(ts) {
    if (done) return;
    if (!startTime) startTime = ts;
    var elapsed = ts - startTime;

    ctx.clearRect(0, 0, W, H);

    var activeCount = 0;

    for (var i = 0; i < particles.length; i++) {
      var p = particles[i];

      /* Spawn */
      if (!p.spawned) {
        if (elapsed < p.spawnAt) continue;
        p.spawned = true;
        if (p.fromLeft) {
          p.x = -80;
          p.y = Math.random() * H * 0.9;
        } else {
          p.x = Math.random() * W;
          p.y = -80;
        }
      }
      if (p.done) continue;
      activeCount++;

      /* Böe */
      if (p.gust && !p.gustDone && elapsed >= p.spawnAt + p.gustAt) {
        p.vx += 1.2 + Math.random() * 0.9;
        p.vy += -0.4 + Math.random() * 0.5;
        p.gustDone = true;
      }

      /* Physik */
      var wobble = Math.sin(elapsed * p.wobbleFreq + p.wobblePhase) * p.wobbleAmp;
      p.x += p.vx;
      p.y += p.vy + wobble;
      p.rotation += p.rotSpeed;

      /* Alpha-Rampe */
      var fadeEdge = 90;
      if (p.x < fadeEdge) {
        p.alpha = Math.min(1, p.x / fadeEdge);
      } else if (p.x > W - fadeEdge) {
        p.alpha = Math.min(p.alpha, Math.max(0, (W - p.x) / fadeEdge));
      } else {
        p.alpha = Math.min(1, p.alpha + 0.07);
      }

      /* Off-screen */
      var margin = 100;
      if (p.x > W + margin || p.y > H + margin || p.y < -margin) {
        p.done = true;
        continue;
      }

      /* Zeichnen */
      ctx.save();
      ctx.globalAlpha = p.alpha;
      ctx.translate(p.x, p.y);
      ctx.rotate(p.rotation);
      var img = p.isHazel ? hazelImg : leafImg;
      ctx.drawImage(img, -p.drawnW / 2, -p.drawnH / 2, p.drawnW, p.drawnH);
      ctx.restore();
    }

    /* Fertig → ausblenden */
    if (elapsed > TOTAL_MS && activeCount === 0) {
      wrap.style.opacity = '0';
      setTimeout(function () {
        wrap.style.display = 'none';
        done = true;
      }, 1050);
      return;
    }

    requestAnimationFrame(animate);
  }

})();
</script>

{% schema %}
{
  "name": "Herbst Wind-Effekt",
  "tag": "div",
  "settings": [
    {
      "type": "header",
      "content": "Animation"
    },
    {
      "type": "range",
      "id": "particle_count",
      "label": "Anzahl Partikel",
      "min": 20,
      "max": 80,
      "step": 5,
      "default": 45
    },
    {
      "type": "range",
      "id": "duration_ms",
      "label": "Dauer (ms)",
      "min": 3000,
      "max": 9500,
      "step": 500,
      "default": 6500,
      "info": "Wie lange der Effekt läuft, bis er ausblendet."
    },
    {
      "type": "range",
      "id": "hazel_ratio",
      "label": "Haselnuss-Anteil (%)",
      "min": 0,
      "max": 60,
      "step": 5,
      "default": 25,
      "info": "Wie viel Prozent der Partikel Haselnüsse sind."
    }
  ],
  "presets": [
    {
      "name": "Herbst Wind-Effekt",
      "settings": {
        "particle_count": 45,
        "duration_ms": 6500,
        "hazel_ratio": 25
      }
    }
  ]
}
{% endschema %}