{% schema %}
{
  "name": "After Before Image",
  "tag": "section",
  "settings": [
    {
      "type": "color",
      "id": "background_leftbox",
      "label": "Background Left Box",
      "default": "#000000"
    },
     {
      "type": "color",
      "id": "color_title_left",
      "label": "Left Box Heading Color",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "color_desc_left",
      "label": "Left Box content Color",
      "default": "#000000"
    },
    {
      "type": "text",
      "id": "pre_text",
      "label": "Previous Button Text"
    },

    {
      "type": "text",
      "id": "next_text",
      "label": "Next Button Text"
    }

  ],
  "presets": [
    {
      "name": "After Before Image"
    }
  ]
}
{% endschema %}

<div class="after-before-wrapper">
<div class="container">
<div class="left-box">

    <div class="inner-box-left" style="background:{{ section.settings.background_leftbox }}">
            
        <h2 class="heading heading123" style="color:{{ section.settings.color_title_left }}">{{collection.metafields.custom.after_before_title | metafield_tag}}</h2>
        <h3 class="heading heading123" style="color:{{ section.settings.color_title_left }}">{{collection.metafields.custom.after_before_handwritten_text | metafield_tag}}</h3>
        <div class="short_info" style="color:{{ section.settings.color_desc_left }}">{{collection.metafields.custom.after_before_description}}</div>
        <div class="sliderafter-arrow dekstop_arrw">
            
             <button class="prev-slide  sliderarrleft">
              <img src="https://cdn.shopify.com/s/files/1/0904/4639/7774/files/left_arw.png">
              
          </button>
              <button class="next-slide  sliderarrright">
                <img src="https://cdn.shopify.com/s/files/1/0904/4639/7774/files/right_arw.png">
                </button>
        </div>
</div>
</div>

  {% assign image_sets = collection.metafields.custom.after_before_images_box.value %}

  {% if image_sets %}
    <div class="right-box">
    <div class="slick-carousel1">
      {% for image_set in image_sets %}
        <div class="slide-content">
          <div class="after-before-item">
            <div class="image-container">
              {% if image_set.before_image %}
                <img
                  src="{{ image_set.before_image | image_url: width: 800 }}"
                  class="toggle-image before-image active"
                  alt="Before Image"
                >
              {% endif %}
              {% if image_set.after_image %}
                <img
                  src="{{ image_set.after_image | image_url: width: 800 }}"
                  class="toggle-image after-image"
                  alt="After Image"
                >
              {% endif %}
            </div>
            {% if image_set.before_image and image_set.after_image %}
              <div class="toggle-buttons">
                <button class="btn-show-before active">{{ section.settings.pre_text }}</button>
                <button class="btn-show-after">{{ section.settings.next_text }}</button>
              </div>
            {% endif %}
          </div>
        </div>
      {% endfor %}
    </div>
  </div>

   
<div class="sliderafter-arrow mobile_arrw">
            
             <button class="prev-slide  sliderarrleft">
              <img src="{{ 'left_arrw.png' | asset_url }}" alt="Prev">
              
          </button>
              <button class="next-slide  sliderarrright">
                <img src="{{ 'right_arrw.png' | asset_url }}" alt="Next">
                </button>
        </div>


  {% else %}
    <p>No before/after images found. Check metafield setup.</p>
  {% endif %}
</div>
</div>


<!-- Add jQuery and Slick Carousel (if not already added in theme.liquid) -->
<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/slick-carousel@1.8.1/slick/slick.css"/>
<script src="https://cdn.jsdelivr.net/npm/slick-carousel@1.8.1/slick/slick.min.js"></script>

<!-- JS for Slider and Toggle -->
<script>
document.addEventListener("DOMContentLoaded", function() {
  $('.slick-carousel1').slick({
    infinite: false,
    slidesToShow:2.8,
    slidesToScroll: 1,
    arrows: false,
    dots: false,
    responsive: [
      {
        breakpoint: 992,
        settings: { slidesToShow: 2 }
      },
      {
        breakpoint: 768,
        settings: { 
          slidesToShow: 1.3,
          dots:true
        
        }
      }
    ]
  });
  $('.next-slide').click(function(){
    $('.slick-carousel1').slick('slickNext');
  });

  $('.prev-slide').click(function(){
    $('.slick-carousel1').slick('slickPrev');
  });

  // Delegate click events after DOM is ready
document.querySelectorAll('.after-before-item').forEach(function(item) {
  const beforeBtn = item.querySelector('.btn-show-before');
  const afterBtn = item.querySelector('.btn-show-after');
  const beforeImg = item.querySelector('.before-image');
  const afterImg = item.querySelector('.after-image');

  if (beforeBtn && afterBtn && beforeImg && afterImg) {

    // 👉 Show AFTER by default
    afterImg.classList.add('active');
    afterBtn.classList.add('active');
    beforeImg.classList.remove('active');
    beforeBtn.classList.remove('active');

    beforeBtn.addEventListener('click', function() {
      beforeImg.classList.add('active');
      afterImg.classList.remove('active');
      beforeBtn.classList.add('active');
      afterBtn.classList.remove('active');
    });

    afterBtn.addEventListener('click', function() {
      afterImg.classList.add('active');
      beforeImg.classList.remove('active');
      afterBtn.classList.add('active');
      beforeBtn.classList.remove('active');
    });
  }
});
});
</script>


<!-- Same CSS and JavaScript as above -->
