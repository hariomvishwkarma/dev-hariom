{%- comment -%}
  sections/produkt-hero.liquid
  2-spaltiger Hero: H1 (Figtree 300 + Playfair italic) links, Produktbild rechts
  Eyebrow optional, Subheading in Akzentfarbe, Checkmarks als Blöcke, CTA-Button
  Fonts: Figtree 300/400/600 + Playfair Display 500 italic
{%- endcomment -%}

{%- liquid
  assign c_bg     = section.settings.color_bg
  assign c_ink    = section.settings.color_ink
  assign c_mid    = section.settings.color_mid
  assign c_accent = section.settings.color_accent
  assign pt       = section.settings.padding_top
  assign pb       = section.settings.padding_bottom
-%}

<div id="ph-{{ section.id }}" class="ph" style="padding-top: {{ pt }}px; padding-bottom: {{ pb }}px;">
  <div class="ph__inner">

    <!-- ── Linke Spalte: Text ── -->
    <div class="ph__content">

      {%- if section.settings.eyebrow != blank -%}
        <p class="ph__eyebrow">
          <span class="ph__eyebrow-rule"></span>
          {{ section.settings.eyebrow }}
          <span class="ph__eyebrow-rule"></span>
        </p>
      {%- endif -%}

      <h1 class="ph__heading">
        {%- if section.settings.heading_line1 != blank -%}
          {{ section.settings.heading_line1 }}
        {%- endif -%}
        {%- if section.settings.heading_line2 != blank -%}
          <em>{{ section.settings.heading_line2 }}</em>
        {%- endif -%}
      </h1>

      {%- if section.settings.subheading != blank -%}
        <p class="ph__subheading">{{ section.settings.subheading }}</p>
      {%- endif -%}

      {%- if section.settings.body != blank -%}
        <div class="ph__body">{{ section.settings.body }}</div>
      {%- endif -%}

      {%- if section.blocks.size > 0 -%}
        <ul class="ph__checks">
          {%- for block in section.blocks -%}
            {%- if block.type == 'check_item' -%}
              <li class="ph__check" {{ block.shopify_attributes }}>
                <svg class="ph__check-icon" viewBox="0 0 18 18" fill="none" xmlns="http://www.w3.org/2000/svg">
                  <polyline points="3,9 7,13 15,5" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
                {{ block.settings.text }}
              </li>
            {%- endif -%}
          {%- endfor -%}
        </ul>
      {%- endif -%}

      {%- if section.settings.btn_label != blank -%}
        <a class="ph__btn" href="{{ section.settings.btn_url }}">
          {{ section.settings.btn_label }}
        </a>
      {%- endif -%}

    </div>

    <!-- ── Rechte Spalte: Bild ── -->
    <div class="ph__media">
      {%- if section.settings.image != blank -%}
        {{
          section.settings.image
          | image_url: width: 1200
          | image_tag:
            class: 'ph__image',
            loading: 'eager',
            fetchpriority: 'high',
            alt: section.settings.image.alt | default: section.settings.heading_line1
        }}
      {%- else -%}
        <span class="ph__media-placeholder">{{ 'sections.image_banner.placeholder_title' | t }}</span>
      {%- endif -%}
    </div>

  </div>
</div>

<style>
@import url('https://fonts.googleapis.com/css2?family=Figtree:wght@300;400;600&family=Playfair+Display:ital,wght@1,500&display=swap');

#ph-{{ section.id }} {
  --bg:     {{ c_bg }};
  --ink:    {{ c_ink }};
  --mid:    {{ c_mid }};
  --accent: {{ c_accent }};
}

#ph-{{ section.id }},
#ph-{{ section.id }} * { box-sizing: border-box; }

#ph-{{ section.id }} {
  background: var(--bg);
  font-family: 'Figtree', sans-serif;
  -webkit-font-smoothing: antialiased;
}

/* ── Inner ── */
#ph-{{ section.id }} .ph__inner {
  max-width: 1240px;
  margin: 0 auto;
  padding-left: max(24px, 4rem);
  padding-right: max(24px, 4rem);
  display: grid;
  grid-template-columns: 1fr 1.5fr;
  gap: 4rem;
  align-items: center;
}

/* ── Content ── */
#ph-{{ section.id }} .ph__content {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
}

/* ── Eyebrow ── */
#ph-{{ section.id }} .ph__eyebrow {
  display: inline-flex;
  align-items: center;
  gap: 10px;
  font-size: 11px;
  font-weight: 600;
  letter-spacing: 0.24em;
  text-transform: uppercase;
  color: var(--accent);
  margin-bottom: 1.25rem;
}

#ph-{{ section.id }} .ph__eyebrow-rule {
  display: block;
  width: 22px;
  height: 1px;
  background: currentColor;
  opacity: 0.45;
  flex-shrink: 0;
}

/* ── H1 ── */
#ph-{{ section.id }} .ph__heading {
  font-family: 'Figtree', sans-serif;
  font-size: clamp(42px, 5.5vw, 76px);
  font-weight: 300;
  color: var(--ink);
  line-height: 1.04;
  letter-spacing: -0.03em;
  margin-bottom: 1.1rem;
}

#ph-{{ section.id }} .ph__heading em {
  font-family: 'Playfair Display', serif;
  font-style: italic;
  font-weight: 500;
  display: block;
  letter-spacing: 0em;
  white-space: nowrap;
}

/* ── Subheading ── */
#ph-{{ section.id }} .ph__subheading {
  font-size: clamp(20px, 2.2vw, 26px);
  font-weight: 600;
  color: var(--accent);
  line-height: 1.3;
  margin-bottom: 1.1rem;
}

/* ── Body ── */
#ph-{{ section.id }} .ph__body {
  font-size: clamp(15px, 1.1vw, 16.5px);
  font-weight: 400;
  line-height: 1.75;
  color: var(--mid);
  margin-bottom: 1.5rem;
}

#ph-{{ section.id }} .ph__body p { margin: 0; }
#ph-{{ section.id }} .ph__body p + p { margin-top: 0.6em; }

/* ── Checks ── */
#ph-{{ section.id }} .ph__checks {
  list-style: none;
  display: flex;
  flex-direction: column;
  gap: 10px;
  margin-bottom: 2rem;
  padding: 0;
}

#ph-{{ section.id }} .ph__check {
  display: flex;
  align-items: center;
  gap: 10px;
  font-size: 15px;
  font-weight: 400;
  color: var(--ink);
  line-height: 1.4;
}

#ph-{{ section.id }} .ph__check-icon {
  flex-shrink: 0;
  width: 18px;
  height: 18px;
  color: var(--accent);
}

/* ── CTA Button ── */
#ph-{{ section.id }} .ph__btn {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  background: var(--accent);
  color: #fff;
  font-family: 'Figtree', sans-serif;
  font-size: 15px;
  font-weight: 600;
  letter-spacing: 0.01em;
  padding: 15px 30px;
  border-radius: 999px;
  text-decoration: none;
  transition: opacity 0.2s, transform 0.2s;
}

#ph-{{ section.id }} .ph__btn:hover {
  opacity: 0.88;
  transform: translateY(-1px);
}

/* ── Media ── */
#ph-{{ section.id }} .ph__media {
  position: relative;
  border-radius: 20px;
  overflow: hidden;
  aspect-ratio: 1 / 1;
  background: linear-gradient(135deg, #ebe5dc 0%, #d5ccc3 100%);
  display: flex;
  align-items: center;
  justify-content: center;
}

#ph-{{ section.id }} .ph__image {
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
}

#ph-{{ section.id }} .ph__media-placeholder {
  font-size: 12px;
  font-weight: 600;
  letter-spacing: 0.14em;
  text-transform: uppercase;
  color: #a89e96;
}

/* ── Responsive ── */
@media (max-width: 860px) {
  #ph-{{ section.id }} {
    padding-top: 1.25rem !important;
    padding-bottom: 3rem !important;
  }

  #ph-{{ section.id }} .ph__inner {
    grid-template-columns: 1fr;
    gap: 2rem;
    padding-left: 1rem;
    padding-right: 1rem;
  }

  #ph-{{ section.id }} .ph__media {
    aspect-ratio: 1 / 1;
    border-radius: 14px;
  }
}
</style>

{% schema %}
{
  "name": "Produkt-Hero",
  "tag": "section",
  "settings": [
    { "type": "header", "content": "Inhalt" },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow (optional)",
      "default": "Das System"
    },
    {
      "type": "text",
      "id": "heading_line1",
      "label": "Überschrift Zeile 1",
      "default": "40 Jahre"
    },
    {
      "type": "text",
      "id": "heading_line2",
      "label": "Überschrift Zeile 2 (kursiv, Playfair)",
      "default": "Abnehm-Expertise."
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading (Akzentfarbe)",
      "default": "Jetzt als komplettes Startpaket"
    },
    {
      "type": "richtext",
      "id": "body",
      "label": "Fließtext",
      "default": "<p>Das 3-Phasen-System, das bereits über 40.000 Menschen beim Abnehmen unterstützt hat.</p>"
    },
    {
      "type": "text",
      "id": "btn_label",
      "label": "Button Text",
      "default": "Zum 4-Wochen-Paket →"
    },
    {
      "type": "url",
      "id": "btn_url",
      "label": "Button Link"
    },
    { "type": "header", "content": "Bild" },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Produktbild"
    },
    { "type": "header", "content": "Abstände" },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Abstand oben",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Abstand unten",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 80
    },
    { "type": "header", "content": "Farben" },
    { "type": "color", "id": "color_bg",     "label": "Hintergrund",       "default": "#FAF9F5" },
    { "type": "color", "id": "color_ink",    "label": "Text dunkel",       "default": "#56473A" },
    { "type": "color", "id": "color_mid",    "label": "Text gedimmt",      "default": "#8C7C70" },
    { "type": "color", "id": "color_accent", "label": "Akzentfarbe",       "default": "#3DADBB" }
  ],
  "blocks": [
    {
      "type": "check_item",
      "name": "Checkmark-Punkt",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "default": "3-Phasen-System mit klarer Struktur"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Produkt-Hero",
      "blocks": [
        {
          "type": "check_item",
          "settings": { "text": "3-Phasen-System mit klarer Struktur" }
        },
        {
          "type": "check_item",
          "settings": { "text": "8+ Geschmäcker für echte Abwechslung" }
        },
        {
          "type": "check_item",
          "settings": { "text": "Komplett ausgestattet für 4 Wochen" }
        }
      ]
    }
  ]
}
{% endschema %}