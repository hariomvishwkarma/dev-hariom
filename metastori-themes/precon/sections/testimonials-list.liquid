<style>
  .testi-list {
    padding: 40px 20px 48px;
    font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
    background-color: {{ section.settings.bg_color }};
    color: {{ section.settings.text_color }};
  }
  .testi-list__inner {
    max-width: 720px;
    margin: 0 auto;
  }
  .testi-list__heading {
    font-size: clamp(24px, 4vw, 38px);
    font-weight: 700;
    margin: 0 0 28px;
  }
  .testi-list__heading em {
    font-style: normal;
    color: {{ section.settings.accent_color }};
  }
  .testi-list__cards {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  /* ── Card ── */
  .testi-list__card {
    background: #fff;
    border: 1px solid {{ section.settings.card_border }};
    border-radius: 12px;
    overflow: hidden;
  }
  .testi-list__main {
    display: flex;
    gap: 20px;
    padding: 24px;
  }

  /* ── Photo ── */
  .testi-list__photo-wrap {
    position: relative;
    flex-shrink: 0;
    width: 140px;
    height: 180px;
    border-radius: 10px;
    overflow: hidden;
    background: #e8e2d8;
  }
  .testi-list__photo-wrap img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .testi-list__play {
    position: absolute;
    bottom: 8px;
    left: 8px;
    width: 32px;
    height: 32px;
    border-radius: 50%;
    background: rgba(255,255,255,0.92);
    border: none;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 1px 6px rgba(0,0,0,0.15);
  }
  .testi-list__play::after {
    content: '';
    display: block;
    width: 0;
    height: 0;
    border-style: solid;
    border-width: 6px 0 6px 10px;
    border-color: transparent transparent transparent {{ section.settings.text_color }};
    margin-left: 2px;
  }

  /* ── Avatar fallback (no photo) ── */
  .testi-list__avatar {
    flex-shrink: 0;
    width: 48px;
    height: 48px;
    border-radius: 50%;
    background: linear-gradient(135deg, #e8a020 0%, {{ section.settings.accent_color }} 100%);
    color: #fff;
    font-size: 18px;
    font-weight: 700;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  /* ── Text content ── */
  .testi-list__body {
    flex: 1;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 6px;
  }
  .testi-list__top-row {
    display: flex;
    align-items: center;
    gap: 8px;
    flex-wrap: wrap;
  }
  .testi-list__name {
    font-size: 16px;
    font-weight: 700;
    font-style: italic;
    margin: 0;
  }
  .testi-list__badge {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    color: {{ section.settings.accent_color }};
    font-size: 12px;
    font-weight: 600;
  }
  .testi-list__badge::before {
    content: '✓';
    font-weight: 700;
  }
  .testi-list__stars {
    color: #d4a017;
    font-size: 14px;
    letter-spacing: 2px;
  }
  .testi-list__quote {
    font-size: 15px;
    line-height: 1.6;
    margin: 4px 0 0;
    opacity: 0.85;
  }

  /* ── Product recommendation ── */
  .testi-list__rec {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-top: 8px;
    padding-top: 10px;
    border-top: 1px solid {{ section.settings.card_border }};
  }
  .testi-list__rec-img {
    width: 36px;
    height: 36px;
    border-radius: 6px;
    object-fit: cover;
    flex-shrink: 0;
    background: #f0ece4;
  }
  .testi-list__rec-text {
    font-size: 13px;
    line-height: 1.4;
    opacity: 0.7;
  }
  .testi-list__rec-link {
    color: {{ section.settings.accent_color }};
    text-decoration: underline;
    font-weight: 600;
    opacity: 1;
  }

  /* ── Dots navigation ── */
  .testi-list__dots {
    display: none;
  }

  @media (max-width: 600px) {
    .testi-list {
      padding: 20px 0 24px;
    }
    .testi-list__inner {
      max-width: none;
    }
    .testi-list__heading {
      font-size: 20px;
      margin-bottom: 14px;
      padding: 0 14px;
    }
    .testi-list__cards {
      flex-direction: row;
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      -webkit-overflow-scrolling: touch;
      gap: 10px;
      padding: 0 14px 4px;
      scrollbar-width: none;
    }
    .testi-list__cards::-webkit-scrollbar {
      display: none;
    }
    .testi-list__card {
      flex: 0 0 85%;
      min-width: 0;
      scroll-snap-align: start;
    }
    .testi-list__main {
      padding: 14px;
      gap: 12px;
    }
    .testi-list__photo-wrap {
      width: 80px;
      height: 100px;
    }
    .testi-list__play {
      width: 24px;
      height: 24px;
      bottom: 5px;
      left: 5px;
    }
    .testi-list__play::after {
      border-width: 4px 0 4px 7px;
    }
    .testi-list__avatar {
      width: 36px;
      height: 36px;
      font-size: 14px;
    }
    .testi-list__name {
      font-size: 13px;
    }
    .testi-list__stars {
      font-size: 11px;
    }
    .testi-list__badge {
      font-size: 10px;
    }
    .testi-list__quote {
      font-size: 12px;
      line-height: 1.5;
    }
    .testi-list__rec {
      gap: 8px;
      margin-top: 6px;
      padding-top: 8px;
    }
    .testi-list__rec-img {
      width: 28px;
      height: 28px;
    }
    .testi-list__rec-text {
      font-size: 11px;
    }

    /* ── Dots ── */
    .testi-list__dots {
      display: flex;
      justify-content: center;
      gap: 6px;
      margin-top: 12px;
    }
    .testi-list__dot {
      width: 7px;
      height: 7px;
      border-radius: 50%;
      background: {{ section.settings.text_color }};
      opacity: 0.2;
      border: none;
      padding: 0;
      cursor: pointer;
      transition: opacity 0.2s;
    }
    .testi-list__dot.active {
      opacity: 0.7;
    }
  }
</style>

<div class="testi-list">
  <div class="testi-list__inner">
    <h2 class="testi-list__heading">{{ section.settings.heading }}</h2>

    <div class="testi-list__cards">
      {% for block in section.blocks %}
        <div class="testi-list__card" {{ block.shopify_attributes }}>
          <div class="testi-list__main">
            {% if block.settings.photo != blank %}
              <div class="testi-list__photo-wrap">
                <img src="{{ block.settings.photo | image_url: width: 300 }}" alt="{{ block.settings.name }}" loading="lazy" width="300" height="300">
                {% if block.settings.video_url != blank %}
                  <button class="testi-list__play" data-video="{{ block.settings.video_url }}" aria-label="Video abspielen"></button>
                {% endif %}
              </div>
            {% else %}
              <span class="testi-list__avatar">{{ block.settings.name | slice: 0 }}</span>
            {% endif %}

            <div class="testi-list__body">
              <div class="testi-list__top-row">
                <div class="testi-list__name">{{ block.settings.name }}{% if block.settings.age != blank %}, {{ block.settings.age }}{% endif %}</div>
                {% if block.settings.verified %}
                  <span class="testi-list__badge">{{ section.settings.verified_text }}</span>
                {% endif %}
              </div>
              <div class="testi-list__stars">
                {% assign star_count = block.settings.stars | default: 5 %}
                {% for i in (1..star_count) %}★{% endfor %}
              </div>
              <p class="testi-list__quote">{{ block.settings.quote }}</p>

              {% if block.settings.rec_product != blank %}
                {% assign rec = block.settings.rec_product %}
                <div class="testi-list__rec">
                  {% if rec.featured_image %}
                    <img class="testi-list__rec-img" src="{{ rec.featured_image | image_url: width: 72 }}" alt="{{ rec.title }}" loading="lazy">
                  {% endif %}
                  <div class="testi-list__rec-text">
                    {{ block.settings.name }} empfiehlt dieses Produkt<br>
                    <a class="testi-list__rec-link" href="{{ rec.url }}">{{ rec.title }}</a>
                  </div>
                </div>
              {% elsif block.settings.rec_text != blank %}
                <div class="testi-list__rec">
                  {% if block.settings.rec_image != blank %}
                    <img class="testi-list__rec-img" src="{{ block.settings.rec_image | image_url: width: 72 }}" alt="" loading="lazy">
                  {% endif %}
                  <div class="testi-list__rec-text">
                    {{ block.settings.name }} empfiehlt dieses Produkt<br>
                    {% if block.settings.rec_url != blank %}
                      <a class="testi-list__rec-link" href="{{ block.settings.rec_url }}">{{ block.settings.rec_text }}</a>
                    {% else %}
                      <span class="testi-list__rec-link">{{ block.settings.rec_text }}</span>
                    {% endif %}
                  </div>
                </div>
              {% endif %}
            </div>
          </div>
        </div>
      {% endfor %}
    </div>

    <div class="testi-list__dots" id="testi-dots-{{ section.id }}">
      {% for block in section.blocks %}
        <button class="testi-list__dot{% if forloop.first %} active{% endif %}" data-index="{{ forloop.index0 }}" aria-label="Testimonial {{ forloop.index }}"></button>
      {% endfor %}
    </div>
  </div>
</div>

<script>
(function() {
  /* Video play buttons */
  document.querySelectorAll('.testi-list__play').forEach(function(btn) {
    btn.addEventListener('click', function() {
      var url = this.dataset.video;
      if (url) window.open(url, '_blank');
    });
  });

  /* Slider dots */
  var section = document.getElementById('testi-dots-{{ section.id }}');
  if (!section) return;
  var dots = section.querySelectorAll('.testi-list__dot');
  var slider = section.previousElementSibling;
  if (!slider || !dots.length) return;

  /* Dot click → scroll to card */
  dots.forEach(function(dot) {
    dot.addEventListener('click', function() {
      var idx = parseInt(this.dataset.index);
      var cards = slider.querySelectorAll('.testi-list__card');
      if (cards[idx]) {
        cards[idx].scrollIntoView({ behavior: 'smooth', block: 'nearest', inline: 'start' });
      }
    });
  });

  /* Scroll → update active dot */
  var scrollTimer;
  slider.addEventListener('scroll', function() {
    clearTimeout(scrollTimer);
    scrollTimer = setTimeout(function() {
      var cards = slider.querySelectorAll('.testi-list__card');
      var sliderLeft = slider.scrollLeft;
      var closest = 0;
      var closestDist = Infinity;
      cards.forEach(function(card, i) {
        var dist = Math.abs(card.offsetLeft - slider.offsetLeft - sliderLeft);
        if (dist < closestDist) {
          closestDist = dist;
          closest = i;
        }
      });
      dots.forEach(function(d, i) {
        d.classList.toggle('active', i === closest);
      });
    }, 60);
  });
})();
</script>

{% schema %}
{
  "name": "Testimonials List",
  "settings": [
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#faf8f4"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#3a3631"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent Color",
      "default": "#2fb5a0"
    },
    {
      "type": "color",
      "id": "card_border",
      "label": "Card Border",
      "default": "#e4dfd6"
    },
    {
      "type": "html",
      "id": "heading",
      "label": "Heading (use <em> for accent)",
      "default": "Das sagen <em>12.400+ Frauen</em> über Precon"
    },
    {
      "type": "text",
      "id": "verified_text",
      "label": "Verified Badge Text",
      "default": "Verifizierter Kauf"
    }
  ],
  "blocks": [
    {
      "type": "testimonial",
      "name": "Testimonial",
      "settings": [
        {
          "type": "image_picker",
          "id": "photo",
          "label": "Person Photo"
        },
        {
          "type": "url",
          "id": "video_url",
          "label": "Video URL (optional)",
          "info": "Shows play button over photo. Opens in new tab."
        },
        {
          "type": "text",
          "id": "name",
          "label": "Name",
          "default": "Maria"
        },
        {
          "type": "text",
          "id": "age",
          "label": "Age (optional)"
        },
        {
          "type": "range",
          "id": "stars",
          "label": "Stars",
          "min": 1,
          "max": 5,
          "step": 1,
          "default": 5
        },
        {
          "type": "checkbox",
          "id": "verified",
          "label": "Verified Purchase",
          "default": true
        },
        {
          "type": "textarea",
          "id": "quote",
          "label": "Quote",
          "default": "Hier steht das Testimonial."
        },
        {
          "type": "header",
          "content": "Product Recommendation"
        },
        {
          "type": "product",
          "id": "rec_product",
          "label": "Recommended Product (auto image + link)"
        },
        {
          "type": "text",
          "id": "rec_text",
          "label": "OR Manual Product Name",
          "info": "Used if no product selected above"
        },
        {
          "type": "image_picker",
          "id": "rec_image",
          "label": "Manual Product Image"
        },
        {
          "type": "url",
          "id": "rec_url",
          "label": "Manual Product Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Testimonials List",
      "blocks": [
        { "type": "testimonial", "settings": { "name": "Anja", "age": "58", "stars": 5, "verified": true, "quote": "Ich kann Precon jedem nur empfehlen. Für mich war es das absolute Erfolgserlebnis.", "rec_text": "Vanille Shake" } },
        { "type": "testimonial", "settings": { "name": "Julia", "age": "61", "stars": 5, "verified": true, "quote": "Ich fühle mich gesättigt, ohne müde zu sein oder Heißhungerattacken zu haben.", "rec_text": "Schoko Shake" } },
        { "type": "testimonial", "settings": { "name": "Nina", "age": "56", "stars": 5, "verified": true, "quote": "Du bist sofort satt, fit und kannst voller Energie in den Tag starten.", "rec_text": "Himbeer-Joghurt Shake" } },
        { "type": "testimonial", "settings": { "name": "Mandy", "age": "59", "stars": 5, "verified": true, "quote": "Richtig happy mit Precon. Es fühlt sich machbar an und ich habe danach ein gutes Gefühl.", "rec_text": "Riegel-Mix" } }
      ]
    }
  ]
}
{% endschema %}