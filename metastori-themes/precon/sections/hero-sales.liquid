{% comment %}
  Hero Section – Trust Bar + Headline (Advanced)
  - Optional cart icon (right side) with color controls
  - "Trust bar only" mode hides hero content
  - Mobile: trust bar Swiper slider (1 item per slide, autoplay)
{% endcomment %}

{%- assign uid = section.id -%}

{% style %}
  .hts-{{ uid }} { position: relative; }
  .hts-{{ uid }} .trust-bar { background: {{ section.settings.trust_bar_bg }}; color: {{ section.settings.trust_bar_text_color }}; padding: 12px 20px; display: flex; justify-content: center; align-items: center; gap: 32px; flex-wrap: wrap; font-size: 14px; letter-spacing: 0.02em; position: relative; }
  .hts-{{ uid }} .trust-bar__track { display: flex; justify-content: center; align-items: center; gap: 32px; flex-wrap: wrap; width: 100%; }
  .hts-{{ uid }} .trust-bar__item { display: flex; align-items: center; gap: 8px; white-space: nowrap; }
  .hts-{{ uid }} .trust-bar__separator { width: 4px; height: 4px; border-radius: 50%; background: {{ section.settings.trust_bar_text_color }}; opacity: 0.5; }
  .hts-{{ uid }} .hero-wrapper { background: {{ section.settings.hero_bg }}; }
  .hts-{{ uid }} .hero { padding: 60px 20px 80px; text-align: left; max-width: 1200px; margin: 0 auto; }
  .hts-{{ uid }} .hero__badge { display: inline-block; background: {{ section.settings.badge_bg }}; border: 1px solid {{ section.settings.badge_border }}; border-radius: 999px; padding: 8px 20px; font-size: 14px; color: {{ section.settings.badge_text_color }}; margin-bottom: 32px; box-shadow: 0 1px 4px rgba(0,0,0,0.06); }
  .hts-{{ uid }} .hero__heading { font-size: clamp(36px, 5vw, 64px); line-height: 1.1; font-weight: 700; color: {{ section.settings.heading_color }}; margin: 0 0 4px; }
  .hts-{{ uid }} .hero__subheading { font-size: clamp(36px, 5vw, 64px); line-height: 1.1; font-weight: 700; font-style: italic; color: {{ section.settings.subheading_color }}; margin: 0; font-family: serif; }
  .hts-{{ uid }} .hero__body { font-size: 18px; line-height: 1.6; color: {{ section.settings.body_color }}; margin: 28px 0 0; max-width: 640px; }
  .hts-{{ uid }} .hts-cart { position: fixed; top: 14px; right: max(var(--container-gutter, 20px), calc((100vw - var(--container-max-width, 1200px)) / 2 + var(--container-gutter, 20px))); z-index: 50; display: inline-flex; align-items: center; justify-content: center; }
  .hts-{{ uid }} .trust-bar { padding-right: 56px; }
  .hts-{{ uid }} .hts-cart svg path { fill: {{ section.settings.cart_icon_color }}; }
  .hts-{{ uid }} .hts-cart .header__cart-count { background: {{ section.settings.cart_bubble_bg }}; color: {{ section.settings.cart_bubble_text }}; }
  .hts-{{ uid }} .trust-bar__swiper { display: none; width: 100%; }
  .hts-{{ uid }} .trust-bar__swiper .swiper-slide { display: flex; align-items: center; justify-content: center; text-align: center; }
  @media (max-width: 749px) {
    .hts-{{ uid }} .trust-bar { gap: 12px; font-size: 12px; padding: 10px 16px; }
    .hts-{{ uid }} .hero { padding: 40px 16px 60px; }
    {% if section.settings.mobile_slider %}
    .hts-{{ uid }} .trust-bar__track { display: none; }
    .hts-{{ uid }} .trust-bar__swiper { display: block; }
    {% endif %}

cart-count.header__cart-count.header__cart-count--floating.bubble-count {
 
    transform: scale(0.8) !important;
}
 .hts-cart {

    top: 8px !important;
 ;
}

  }
{% endstyle %}

<div class="hts-{{ uid }}">

  {% if section.settings.show_cart %}
    <a href="/cart" is="toggle-link" aria-controls="mini-cart" aria-expanded="false" class="hts-cart custom-header-icon header__icon-wrapper tap-area" aria-label="Warenkorb" data-no-instant="">
      <svg focusable="false" class="icon icon--header-shopping-cart" width="24" height="25" viewBox="0 0 24 25" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M9.75 20.75C9.75 21.0467 9.66203 21.3367 9.4972 21.5834C9.33238 21.83 9.09811 22.0223 8.82403 22.1358C8.54994 22.2494 8.24834 22.2791 7.95736 22.2212C7.66639 22.1633 7.39912 22.0204 7.18934 21.8107C6.97956 21.6009 6.8367 21.3336 6.77882 21.0426C6.72094 20.7517 6.75065 20.4501 6.86418 20.176C6.97771 19.9019 7.16997 19.6676 7.41665 19.5028C7.66332 19.338 7.95333 19.25 8.25 19.25C8.64782 19.25 9.02936 19.408 9.31066 19.6893C9.59196 19.9706 9.75 20.3522 9.75 20.75ZM18 19.25C17.7033 19.25 17.4133 19.338 17.1666 19.5028C16.92 19.6676 16.7277 19.9019 16.6142 20.176C16.5006 20.4501 16.4709 20.7517 16.5288 21.0426C16.5867 21.3336 16.7296 21.6009 16.9393 21.8107C17.1491 22.0204 17.4164 22.1633 17.7074 22.2212C17.9983 22.2791 18.2999 22.2494 18.574 22.1358C18.8481 22.0223 19.0824 21.83 19.2472 21.5834C19.412 21.3367 19.5 21.0467 19.5 20.75C19.5 20.3522 19.342 19.9706 19.0607 19.6893C18.7794 19.408 18.3978 19.25 18 19.25ZM22.4728 7.45062L20.0691 16.1019C19.9369 16.5745 19.6542 16.9911 19.2639 17.2885C18.8736 17.5859 18.397 17.7479 17.9062 17.75H8.64C8.14784 17.7498 7.66926 17.5886 7.27725 17.291C6.88523 16.9935 6.6013 16.5758 6.46875 16.1019L3.18 4.25H1.5C1.30109 4.25 1.11032 4.17098 0.96967 4.03033C0.829018 3.88968 0.75 3.69891 0.75 3.5C0.75 3.30109 0.829018 3.11032 0.96967 2.96967C1.11032 2.82902 1.30109 2.75 1.5 2.75H3.75C3.91397 2.74997 4.07343 2.80367 4.20398 2.90289C4.33452 3.00211 4.42895 3.14138 4.47281 3.29938L5.36156 6.5H21.75C21.8656 6.49998 21.9797 6.52669 22.0833 6.57805C22.1869 6.6294 22.2772 6.70401 22.3472 6.79605C22.4171 6.88809 22.4649 6.99506 22.4867 7.10861C22.5085 7.22216 22.5037 7.33922 22.4728 7.45062ZM20.7628 8H5.77875L7.91719 15.7006C7.96105 15.8586 8.05548 15.9979 8.18602 16.0971C8.31657 16.1963 8.47603 16.25 8.64 16.25H17.9062C18.0702 16.25 18.2297 16.1963 18.3602 16.0971C18.4908 15.9979 18.5852 15.8586 18.6291 15.7006L20.7628 8Z"></path></svg>
      <cart-count class="header__cart-count header__cart-count--floating bubble-count" aria-hidden="true">
         {% assign real_count = 0 %}

{% for item in cart.items %}
  {% unless item.properties._addon_item %}
    {% assign real_count = real_count | plus: item.quantity %}
  {% endunless %}
{% endfor %}

{{ real_count }}
      </cart-count>
    </a>
  {% endif %}

  <div class="trust-bar">
    <div class="trust-bar__track">
      {%- for block in section.blocks -%}
        {%- if block.type == 'trust_item' -%}
          {%- unless forloop.first -%}<span class="trust-bar__separator"></span>{%- endunless -%}
          <span class="trust-bar__item" {{ block.shopify_attributes }}>
            {% if block.settings.icon != blank %}{{ block.settings.icon | image_url: width: 20 | image_tag: width: 20, height: 20 }}{% endif %}
            {{ block.settings.text }}
          </span>
        {%- endif -%}
      {%- endfor -%}
    </div>

    {% if section.settings.mobile_slider %}
    <div class="trust-bar__swiper swiper" id="trustSwiper-{{ uid }}">
      <div class="swiper-wrapper">
        {%- for block in section.blocks -%}
          {%- if block.type == 'trust_item' -%}
            <div class="swiper-slide">
              <span class="trust-bar__item">
                {% if block.settings.icon != blank %}{{ block.settings.icon | image_url: width: 20 | image_tag: width: 20, height: 20 }}{% endif %}
                {{ block.settings.text }}
              </span>
            </div>
          {%- endif -%}
        {%- endfor -%}
      </div>
    </div>
    {% endif %}
  </div>

  {% unless section.settings.trust_bar_only %}
    <div class="hero-wrapper">
      <div class="hero">
        {% if section.settings.badge_text != blank %}<div class="hero__badge">{{ section.settings.badge_text }}</div>{% endif %}
        <h1 class="hero__heading">{{ section.settings.heading }}</h1>
        <p class="hero__subheading">{{ section.settings.subheading }}</p>
        {% if section.settings.body_text != blank %}<p class="hero__body">{{ section.settings.body_text }}</p>{% endif %}
      </div>
    </div>
  {% endunless %}

</div>

{% if section.settings.mobile_slider %}
<script>
  (function () {
    var SPEED = {{ section.settings.slider_speed | times: 1000 }};
    var elId = 'trustSwiper-{{ uid }}';
    function initSwiper() {
      var el = document.getElementById(elId);
      if (!el || el.__htsInit) return;
      el.__htsInit = true;
      new Swiper(el, { slidesPerView: 1, loop: true, speed: 600, allowTouchMove: true, autoplay: { delay: SPEED, disableOnInteraction: false } });
    }
    function loadSwiper() {
      if (window.Swiper) { initSwiper(); return; }
      if (!document.getElementById('hts-swiper-css')) {
        var css = document.createElement('link'); css.id = 'hts-swiper-css'; css.rel = 'stylesheet'; css.href = 'https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.css'; document.head.appendChild(css);
      }
      var existing = document.getElementById('hts-swiper-js');
      if (!existing) {
        var js = document.createElement('script'); js.id = 'hts-swiper-js'; js.src = 'https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.js'; js.onload = initSwiper; document.head.appendChild(js);
      } else {
        existing.addEventListener('load', initSwiper);
      }
    }
    if (document.readyState === 'loading') { document.addEventListener('DOMContentLoaded', loadSwiper); } else { loadSwiper(); }
  })();
</script>
{% endif %}

{% schema %}
{
  "name": "Hero with Trust Bar",
  "tag": "section",
  "class": "hero-trust-section",
  "settings": [
    { "type": "header", "content": "Display Mode" },
    { "type": "checkbox", "id": "trust_bar_only", "label": "Show trust bar only (hide hero content)", "default": false },
    { "type": "header", "content": "Cart Icon" },
    { "type": "checkbox", "id": "show_cart", "label": "Show cart icon", "default": false },
    { "type": "color", "id": "cart_icon_color", "label": "Cart icon color", "default": "#56473A" },
    { "type": "color", "id": "cart_bubble_bg", "label": "Cart bubble background", "default": "#6b2fa0" },
    { "type": "color", "id": "cart_bubble_text", "label": "Cart bubble text color", "default": "#ffffff" },
    { "type": "header", "content": "Mobile Slider" },
    { "type": "checkbox", "id": "mobile_slider", "label": "Slider trust bar on mobile (1 per slide)", "default": true },
    { "type": "range", "id": "slider_speed", "label": "Autoplay delay (seconds per slide)", "min": 2, "max": 10, "step": 1, "unit": "s", "default": 3 },
    { "type": "header", "content": "Trust Bar" },
    { "type": "color", "id": "trust_bar_bg", "label": "Trust bar background", "default": "#2d2235" },
    { "type": "color", "id": "trust_bar_text_color", "label": "Trust bar text color", "default": "#ffffff" },
    { "type": "header", "content": "Hero" },
    { "type": "color", "id": "hero_bg", "label": "Hero background", "default": "#f5ede8" },
    { "type": "text", "id": "badge_text", "label": "Badge text", "default": "Bestseller seit 3 Jahren" },
    { "type": "color", "id": "badge_bg", "label": "Badge background", "default": "#ffffff" },
    { "type": "color", "id": "badge_text_color", "label": "Badge text color", "default": "#333333" },
    { "type": "color", "id": "badge_border", "label": "Badge border color", "default": "#e8e4e0" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Strukturiert abnehmen." },
    { "type": "color", "id": "heading_color", "label": "Heading color", "default": "#2d2235" },
    { "type": "text", "id": "subheading", "label": "Subheading", "default": "Langfristig halten." },
    { "type": "color", "id": "subheading_color", "label": "Subheading color", "default": "#6b2fa0" },
    { "type": "textarea", "id": "body_text", "label": "Body text", "default": "Das 4-Wochen-Paket gibt deinem Körper genau das, was er für einen ruhigen, planbaren Abnehmstart braucht. Ärztlich entwickelte Rezeptur, drei klare Phasen, alltagstauglich von Anfang an." },
    { "type": "color", "id": "body_color", "label": "Body text color", "default": "#3d3d3d" }
  ],
  "blocks": [
    {
      "type": "trust_item",
      "name": "Trust Item",
      "settings": [
        { "type": "image_picker", "id": "icon", "label": "Icon (optional)" },
        { "type": "text", "id": "text", "label": "Text", "default": "Trust point" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Hero with Trust Bar",
      "blocks": [
        { "type": "trust_item", "settings": { "text": "Bewährt seit 2009" } },
        { "type": "trust_item", "settings": { "text": "Über 100.000 zufriedene Kundinnen" } },
        { "type": "trust_item", "settings": { "text": "Made in Germany" } }
      ]
    }
  ]
}
{% endschema %}
