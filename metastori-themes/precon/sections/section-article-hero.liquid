{%- liquid
  assign words = article.content | strip_html | split: ' '
  assign read_time = words.size | divided_by: 200
  if read_time < 1
    assign read_time = 1
  endif
-%}

<section class="art-hero" id="art-hero-{{ section.id }}">

  <!-- ── Hero Bild ── -->
  <div class="art-hero__img-wrap">
    {%- if article.image != blank -%}
      {{ article.image | image_url: width: 2000 | image_tag:
        class: 'art-hero__img',
        loading: 'eager',
        sizes: '100vw',
        widths: '800, 1200, 1600, 2000',
        alt: article.title
      }}
    {%- else -%}
      <div class="art-hero__img-placeholder" style="background:{{ section.settings.placeholder_color }};"></div>
    {%- endif -%}
    <div class="art-hero__img-overlay"></div>
  </div>

  <!-- ── Content ── -->
  <div class="art-hero__content" style="background:{{ section.settings.content_bg }};">
    <div class="art-hero__inner page-width">

      <!-- Zurück + Breadcrumb -->
      <div class="art-hero__topbar">
        <a href="{{ article.blog.url }}" class="art-hero__back" style="color:{{ section.settings.accent_color }};">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path d="M19 12H5"/><path d="M12 5l-7 7 7 7"/></svg>
          {{ section.settings.back_label | default: 'Zurück zur Übersicht' }}
        </a>
        <nav class="art-hero__breadcrumb" aria-label="Breadcrumb">
          <a href="{{ routes.root_url }}blogs" class="art-hero__bc-link" style="color:{{ section.settings.bc_color }};">
            {{ section.settings.root_label | default: 'Blog' }}
          </a>
          <span class="art-hero__bc-sep">/</span>
          <a href="{{ article.blog.url }}" class="art-hero__bc-link" style="color:{{ section.settings.bc_color }};">
            {{ article.blog.title }}
          </a>
          <span class="art-hero__bc-sep">/</span>
          <span class="art-hero__bc-current" style="color:{{ section.settings.bc_color }};">
            {{ article.title | truncate: 45 }}
          </span>
        </nav>
      </div>

      <!-- Kategorie Badge -->
      <span class="art-hero__cat-badge" style="background:{{ section.settings.cat_bg }};color:{{ section.settings.cat_text }};">
        {{ article.blog.title }}
      </span>

      <!-- Titel -->
      <h1 class="art-hero__title" style="color:{{ section.settings.title_color }};">{{ article.title }}</h1>

      <!-- Autor + Datum + Lesezeit -->
      <div class="art-hero__meta">
        <div class="art-hero__author">
          <div class="art-hero__avatar" style="background:{{ section.settings.accent_color }};color:#fff;">
            {{ article.author | slice: 0 | upcase }}
          </div>
          <div class="art-hero__author-info">
            <span class="art-hero__author-name" style="color:{{ section.settings.meta_color }};">{{ article.author }}</span>
            <span class="art-hero__date" style="color:{{ section.settings.meta_muted }};">
              {{ article.published_at | date: '%d. %B %Y' }}
            </span>
          </div>
        </div>

        <div class="art-hero__read-time" style="color:{{ section.settings.meta_muted }};">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/>
          </svg>
          {{ read_time }} Min. Lesezeit
        </div>
      </div>

    </div>
  </div>

</section>

<style>
  /* ── Image Banner ── */
  .art-hero__img-wrap {
    position: relative;
    width: 100%;
    height: {{ section.settings.image_height }}px;
    overflow: hidden;
  }
  .art-hero__img,
  .art-hero__img-placeholder {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center {{ section.settings.image_position }};
    display: block;
  }
  .art-hero__img-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(to bottom, rgba(0,0,0,0) 40%, rgba(0,0,0,0.25) 100%);
    pointer-events: none;
  }

  /* ── Content Area ── */
  .art-hero__content {
    border-bottom: 1px solid rgba(0,0,0,0.07);
  }
  .art-hero__inner {
    padding-left: max(24px, 5rem);
    padding-right: max(24px, 5rem);
    padding-top: 28px;
    padding-bottom: 36px;
    max-width: 860px;
  }

  /* ── Topbar: Back + Breadcrumb ── */
  .art-hero__topbar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    margin-bottom: 20px;
    flex-wrap: wrap;
  }
  .art-hero__back {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 13px;
    font-weight: 600;
    text-decoration: none;
    transition: gap 0.2s ease;
    flex-shrink: 0;
  }
  .art-hero__back:hover {
    gap: 10px;
  }
  .art-hero__breadcrumb {
    display: flex;
    align-items: center;
    gap: 6px;
    font-size: 12px;
    flex-wrap: wrap;
  }
  .art-hero__bc-link {
    text-decoration: none;
    opacity: 0.7;
    transition: opacity 0.2s;
  }
  .art-hero__bc-link:hover {
    opacity: 1;
  }
  .art-hero__bc-sep {
    opacity: 0.4;
    color: #888;
  }
  .art-hero__bc-current {
    opacity: 0.5;
    font-style: italic;
  }

  /* ── Category Badge ── */
  .art-hero__cat-badge {
    display: inline-flex;
    align-items: center;
    padding: 5px 14px;
    border-radius: 50px;
    font-size: 12px;
    font-weight: 600;
    margin-bottom: 16px;
    letter-spacing: 0.02em;
  }

  /* ── Title ── */
  .art-hero__title {
    font-size: clamp(26px, 4vw, 48px);
    font-weight: 800;
    line-height: 1.15;
    margin: 0 0 24px;
    letter-spacing: -0.02em;
  }

  /* ── Meta ── */
  .art-hero__meta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    flex-wrap: wrap;
    padding-top: 20px;
    border-top: 1px solid rgba(0,0,0,0.08);
  }
  .art-hero__author {
    display: flex;
    align-items: center;
    gap: 12px;
  }
  .art-hero__avatar {
    width: 40px;
    height: 40px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 15px;
    font-weight: 700;
    flex-shrink: 0;
  }
  .art-hero__author-info {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }
  .art-hero__author-name {
    font-size: 14px;
    font-weight: 600;
    line-height: 1.2;
  }
  .art-hero__date {
    font-size: 12px;
    opacity: 0.7;
  }
  .art-hero__read-time {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    font-size: 13px;
    opacity: 0.7;
  }

  /* ── Responsive ── */
  @media (max-width: 768px) {
    .art-hero__img-wrap {
      height: {{ section.settings.image_height_mobile }}px;
    }
    .art-hero__inner {
      padding-left: 16px !important;
      padding-right: 16px !important;
      padding-top: 20px;
      padding-bottom: 24px;
    }
    .art-hero__topbar {
      flex-direction: column;
      align-items: flex-start;
      gap: 8px;
      margin-bottom: 14px;
    }
    .art-hero__breadcrumb {
      display: none;
    }
    .art-hero__title {
      font-size: clamp(22px, 6vw, 32px);
      margin-bottom: 18px;
    }
    .art-hero__meta {
      flex-direction: column;
      align-items: flex-start;
      gap: 12px;
    }
  }
</style>

{% schema %}
{
  "name": "Artikel Hero",
  "tag": "section",
  "class": "section-article-hero",
  "settings": [
    {
      "type": "header",
      "content": "Bild"
    },
    {
      "type": "range",
      "id": "image_height",
      "label": "Bildhöhe Desktop (px)",
      "min": 300,
      "max": 700,
      "step": 20,
      "default": 480
    },
    {
      "type": "range",
      "id": "image_height_mobile",
      "label": "Bildhöhe Mobile (px)",
      "min": 200,
      "max": 500,
      "step": 20,
      "default": 300
    },
    {
      "type": "select",
      "id": "image_position",
      "label": "Bildausschnitt (vertikal)",
      "options": [
        { "value": "top", "label": "Oben" },
        { "value": "center", "label": "Mitte" },
        { "value": "bottom", "label": "Unten" }
      ],
      "default": "center"
    },
    {
      "type": "color",
      "id": "placeholder_color",
      "label": "Platzhalter Farbe (kein Bild)",
      "default": "#d4f0ed"
    },
    {
      "type": "header",
      "content": "Content Bereich"
    },
    {
      "type": "color",
      "id": "content_bg",
      "label": "Hintergrund",
      "default": "#faf9f6"
    },
    {
      "type": "color",
      "id": "title_color",
      "label": "Titel Farbe",
      "default": "#1a2420"
    },
    {
      "type": "color",
      "id": "meta_color",
      "label": "Autor Name Farbe",
      "default": "#1a2420"
    },
    {
      "type": "color",
      "id": "meta_muted",
      "label": "Datum & Lesezeit Farbe",
      "default": "#888888"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Akzentfarbe (Zurück-Link, Avatar)",
      "default": "#2a7a72"
    },
    {
      "type": "header",
      "content": "Zurück-Link"
    },
    {
      "type": "text",
      "id": "back_label",
      "label": "Zurück-Text",
      "default": "Zurück zur Übersicht"
    },
    {
      "type": "header",
      "content": "Breadcrumb"
    },
    {
      "type": "text",
      "id": "root_label",
      "label": "Root Label",
      "default": "Blog"
    },
    {
      "type": "color",
      "id": "bc_color",
      "label": "Breadcrumb Farbe",
      "default": "#555555"
    },
    {
      "type": "header",
      "content": "Kategorie Badge"
    },
    {
      "type": "color",
      "id": "cat_bg",
      "label": "Badge Hintergrund",
      "default": "#d4f0ed"
    },
    {
      "type": "color",
      "id": "cat_text",
      "label": "Badge Textfarbe",
      "default": "#1a5c57"
    }
  ],
  "presets": [
    {
      "name": "Artikel Hero"
    }
  ]
}
{% endschema %}