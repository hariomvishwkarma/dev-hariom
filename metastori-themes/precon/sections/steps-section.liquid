<style>
  .steps-sec {
    padding: 40px 20px 48px;
    font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
    background-color: {{ section.settings.bg_color }};
    color: {{ section.settings.text_color }};
  }
  .steps-sec__inner {
    max-width: 720px;
    margin: 0 auto;
  }
  .steps-sec__heading {
    font-size: clamp(24px, 4vw, 38px);
    font-weight: 400;
    margin: 0 0 28px;
    text-align: center;
  }
  .steps-sec__heading em {
    font-style: italic;
    font-family: Georgia, 'Times New Roman', serif;
    color: {{ section.settings.accent_color }};
  }
  .steps-sec__list {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }
  .steps-sec__card {
    display: flex;
    align-items: flex-start;
    gap: 16px;
    background: {{ section.settings.card_bg_color }};
    border-left: 4px solid {{ section.settings.accent_color }};
    border-radius: 12px;
    padding: 24px 24px 24px 20px;
  }
  .steps-sec__num {
    flex-shrink: 0;
    width: 38px;
    height: 38px;
    border-radius: 50%;
    background-color: {{ section.settings.accent_color }};
    color: #fff;
    font-size: 16px;
    font-weight: 700;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .steps-sec__content {
    flex: 1;
    min-width: 0;
  }
  .steps-sec__title {
    font-size: 15px;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    color: {{ section.settings.accent_color }};
    margin: 0 0 6px;
  }
  .steps-sec__desc {
    font-size: 14px;
    line-height: 1.6;
    margin: 0;
    opacity: 0.75;
  }

  @media (max-width: 600px) {
    .steps-sec {
      padding: 20px 14px 24px;
    }
    .steps-sec__heading {
      font-size: 20px;
      margin-bottom: 18px;
    }
    .steps-sec__list {
      gap: 10px;
    }
    .steps-sec__card {
      padding: 16px 14px 16px 14px;
      gap: 12px;
      border-radius: 10px;
    }
    .steps-sec__num {
      width: 30px;
      height: 30px;
      font-size: 13px;
    }
    .steps-sec__title {
      font-size: 13px;
    }
    .steps-sec__desc {
      font-size: 12px;
    }
  }
</style>

<div class="steps-sec">
  <div class="steps-sec__inner">
    <h2 class="steps-sec__heading">{{ section.settings.heading }}</h2>

    <div class="steps-sec__list">
      {% for block in section.blocks %}
        <div class="steps-sec__card" {{ block.shopify_attributes }}>
          <span class="steps-sec__num">{{ forloop.index }}</span>
          <div class="steps-sec__content">
            <h3 class="steps-sec__title">{{ block.settings.title }}</h3>
            <p class="steps-sec__desc">{{ block.settings.description }}</p>
          </div>
        </div>
      {% endfor %}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Steps Section",
  "settings": [
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#faf8f4"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#3a3631"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent Color",
      "default": "#2fb5a0"
    },
    {
      "type": "color",
      "id": "card_bg_color",
      "label": "Card Background",
      "default": "#f0ece4"
    },
    {
      "type": "html",
      "id": "heading",
      "label": "Heading (use <em> for accent)",
      "default": "So funktioniert dein <em>4-Wochen-Plan</em>"
    }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "Step",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Schritt"
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "Description",
          "default": "Beschreibung dieses Schritts."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Steps Section",
      "blocks": [
        { "type": "step", "settings": { "title": "Starten (2 Tage)", "description": "Dein Stoffwechsel wird auf Fettverbrennung umgestellt. Alle Mahlzeiten werden durch den Start Shake ersetzt. Leicht, lecker, sättigend." } },
        { "type": "step", "settings": { "title": "Abnehmen (Wochen 1–4)", "description": "Zwei Mahlzeiten pro Tag werden durch Shake oder Riegel ersetzt. Abends genießt du eine ausgewogene Mahlzeit nach dem Precon-Prinzip." } },
        { "type": "step", "settings": { "title": "Halten (ab Woche 4)", "description": "Eine Mahlzeit am Tag wird ersetzt. Nach 4–6 Wochen genießt du komplett normale Mahlzeiten und bleibst dauerhaft in Balance." } }
      ]
    }
  ]
}
{% endschema %}