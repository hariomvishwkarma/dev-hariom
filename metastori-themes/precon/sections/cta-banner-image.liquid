<section class="cta-banner" id="cta-banner-{{ section.id }}">

  {%- if section.settings.bg_image != blank -%}
    <div
      class="cta-banner__bg-image"
      style="background-image: url('{{ section.settings.bg_image | image_url: width: 2000 }}');"
    ></div>
  {%- endif -%}

  <div
    class="cta-banner__overlay"
    style="background-color: {{ section.settings.overlay_color }}; opacity: {{ section.settings.overlay_opacity | divided_by: 100.0 }};"
  ></div>

  <div class="cta-banner__inner page-width">

    {%- if section.settings.eyebrow != blank -%}
      <p class="cta-banner__eyebrow" style="color: {{ section.settings.eyebrow_color }};">
        {{ section.settings.eyebrow }}
      </p>
    {%- endif -%}

    {%- if section.settings.heading != blank -%}
      <h2 class="cta-banner__heading">{{ section.settings.heading }}</h2>
    {%- endif -%}

    {%- if section.settings.subtext != blank -%}
      <p class="cta-banner__subtext">{{ section.settings.subtext }}</p>
    {%- endif -%}

    {%- if section.settings.show_primary or section.settings.show_secondary -%}
      <div class="cta-banner__buttons">
        {%- if section.settings.show_primary and section.settings.primary_label != blank -%}
          <a
            href="{{ section.settings.primary_link }}"
            class="cta-banner__btn cta-banner__btn--primary"
            style="background-color: {{ section.settings.primary_bg }}; color: {{ section.settings.primary_text_color }}; border-color: {{ section.settings.primary_bg }};"
          >
            {{ section.settings.primary_label }}
          </a>
        {%- endif -%}

        {%- if section.settings.show_secondary and section.settings.secondary_label != blank -%}
          <a
            href="{{ section.settings.secondary_link }}"
            class="cta-banner__btn cta-banner__btn--secondary"
            style="background-color: {{ section.settings.secondary_bg }}; color: {{ section.settings.secondary_text_color }}; border-color: {{ section.settings.secondary_border_color }};"
          >
            {{ section.settings.secondary_label }}
          </a>
        {%- endif -%}
      </div>
    {%- endif -%}

  </div>
</section>

<style>
  .cta-banner {
    position: relative;
    padding: {{ section.settings.padding_top }}px 0 {{ section.settings.padding_bottom }}px;
    overflow: hidden;
    /* Fallback background color if no image is set */
    background-color: {{ section.settings.fallback_bg }};
  }

  .cta-banner__bg-image {
    position: absolute;
    inset: 0;
    background-size: cover;
    background-position: {{ section.settings.bg_position }};
    background-repeat: no-repeat;
    z-index: 0;
  }

  .cta-banner__overlay {
    position: absolute;
    inset: 0;
    z-index: 1;
    pointer-events: none;
  }

  .cta-banner__inner {
    position: relative;
    z-index: 2;
    max-width: 760px;
    margin: 0 auto;
    padding: 0 24px;
    text-align: center;
  }

  /* ── Eyebrow: Figtree Semi-Bold ── */
  .cta-banner__eyebrow {
    font-family: 'Figtree', sans-serif;
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    margin: 0 0 16px;
  }

  /* ── Heading: Figtree Light, with Playfair Display Medium Italic for <em> ── */
  .cta-banner__heading {
    font-family: 'Figtree', sans-serif;
    font-size: clamp(30px, 4vw, 46px);
    font-weight: 300;
    line-height: 1.15;
    color: {{ section.settings.heading_color }};
    margin: 0 0 18px;
  }

  .cta-banner__heading em,
  .cta-banner__heading strong,
  .cta-banner__heading em strong,
  .cta-banner__heading strong em {
    font-family: var(--accent-font-family);
    font-style: var(--accent-font-style);
    font-weight: 500;
  }

  /* ── Subtext: Figtree Normal ── */
  .cta-banner__subtext {
    font-family: 'Figtree', sans-serif;
    font-size: clamp(15px, 1.15vw, 17px);
    font-weight: 400;
    line-height: 1.7;
    color: {{ section.settings.text_color }};
    margin: 0 0 36px;
  }

  .cta-banner__buttons {
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    gap: 16px;
  }

  /* ── Buttons: Figtree Semi-Bold ── */
  .cta-banner__btn {
    font-family: 'Figtree', sans-serif;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 16px 36px;
    font-size: 15px;
    font-weight: 600;
    border-radius: 50px;
    border: 2px solid;
    text-decoration: none;
    transition: opacity 0.25s ease;
    white-space: nowrap;
    cursor: pointer;
  }

  .cta-banner__btn:hover {
    opacity: 0.8;
  }

  /* Desktop: halve the vertical padding */
  @media (min-width: 601px) {
    .cta-banner {
      padding-top: {{ section.settings.padding_top | divided_by: 2 }}px;
      padding-bottom: {{ section.settings.padding_bottom | divided_by: 2 }}px;
    }
  }

  @media (max-width: 600px) {
    .cta-banner__buttons {
      flex-direction: column;
      align-items: stretch;
    }

    .cta-banner__btn {
      text-align: center;
    }
  }
</style>

{% schema %}
{
  "name": "CTA Banner (Image BG)",
  "tag": "section",
  "class": "section-cta-banner",
  "settings": [
    {
      "type": "header",
      "content": "Background image"
    },
    {
      "type": "image_picker",
      "id": "bg_image",
      "label": "Background image"
    },
    {
      "type": "select",
      "id": "bg_position",
      "label": "Image position",
      "default": "center center",
      "options": [
        { "value": "top left",      "label": "Top left" },
        { "value": "top center",    "label": "Top center" },
        { "value": "top right",     "label": "Top right" },
        { "value": "center left",   "label": "Center left" },
        { "value": "center center", "label": "Center" },
        { "value": "center right",  "label": "Center right" },
        { "value": "bottom left",   "label": "Bottom left" },
        { "value": "bottom center", "label": "Bottom center" },
        { "value": "bottom right",  "label": "Bottom right" }
      ]
    },
    {
      "type": "color",
      "id": "fallback_bg",
      "label": "Fallback background color",
      "info": "Shown when no image is selected.",
      "default": "#f7f3ee"
    },
    {
      "type": "header",
      "content": "Overlay"
    },
    {
      "type": "color",
      "id": "overlay_color",
      "label": "Overlay color",
      "default": "#000000"
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "min": 0,
      "max": 100,
      "step": 5,
      "default": 40,
      "unit": "%",
      "label": "Overlay opacity"
    },
    {
      "type": "header",
      "content": "Section layout"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 120,
      "step": 4,
      "default": 72,
      "unit": "px",
      "label": "Top padding"
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "default": 72,
      "unit": "px",
      "label": "Bottom padding"
    },
    {
      "type": "header",
      "content": "Text"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "JETZT STARTEN"
    },
    {
      "type": "color",
      "id": "eyebrow_color",
      "label": "Eyebrow color",
      "default": "#4FBFBE"
    },
    {
      "type": "richtext",
      "id": "heading",
      "label": "Heading",
      "default": "<p>Bereit für Deine <em>Abnehmreise?</em></p>"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading color",
      "default": "#ffffff"
    },
    {
      "type": "textarea",
      "id": "subtext",
      "label": "Subtext",
      "default": "39 Jahre Abnehmexpertise, über 40.000 Bewertungen und ein wissenschaftlich fundiertes Konzept — das ist Precon. Starte heute mit dem kostenlosen Abnehmplan."
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Subtext color",
      "default": "#e8e4de"
    },
    {
      "type": "header",
      "content": "Primary button"
    },
    {
      "type": "checkbox",
      "id": "show_primary",
      "label": "Show primary button",
      "default": true
    },
    {
      "type": "text",
      "id": "primary_label",
      "label": "Label",
      "default": "Zum 4-Wochen-Startpaket"
    },
    {
      "type": "url",
      "id": "primary_link",
      "label": "Link"
    },
    {
      "type": "color",
      "id": "primary_bg",
      "label": "Background color",
      "default": "#4FBFBE"
    },
    {
      "type": "color",
      "id": "primary_text_color",
      "label": "Text color",
      "default": "#ffffff"
    },
    {
      "type": "header",
      "content": "Secondary button"
    },
    {
      "type": "checkbox",
      "id": "show_secondary",
      "label": "Show secondary button",
      "default": true
    },
    {
      "type": "text",
      "id": "secondary_label",
      "label": "Label",
      "default": "Abnehmplan berechnen lassen"
    },
    {
      "type": "url",
      "id": "secondary_link",
      "label": "Link"
    },
    {
      "type": "color",
      "id": "secondary_bg",
      "label": "Background color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "secondary_text_color",
      "label": "Text color",
      "default": "#2c2c2c"
    },
    {
      "type": "color",
      "id": "secondary_border_color",
      "label": "Border color",
      "default": "#d5d0c8"
    }
  ],
  "presets": [
    {
      "name": "CTA Banner (Image BG)"
    }
  ]
}
{% endschema %}