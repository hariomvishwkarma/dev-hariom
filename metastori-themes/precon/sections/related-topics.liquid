{% comment %}
  Section: Weitere Themen
{% endcomment %}

<section class="weitere-themen" style="background-color: {{ section.settings.bg_color }};">
  <div class="weitere-themen__container">

    {% if section.settings.label != blank %}
      <div class="weitere-themen__label">
        <span style="color: {{ section.settings.accent_color }}; border-color: {{ section.settings.accent_color }};">
          {{ section.settings.label }}
        </span>
      </div>
    {% endif %}

    <h2 class="weitere-themen__heading" style="color: {{ section.settings.heading_color }};">
      {{ section.settings.heading }} <em>{{ section.settings.heading_italic }}</em>
    </h2>

    {% if section.settings.intro_text != blank %}
      <p class="weitere-themen__intro" style="color: {{ section.settings.intro_color }};">
        {{ section.settings.intro_text }}
      </p>
    {% endif %}

    <div class="weitere-themen__grid">
      {% for block in section.blocks %}
        {% if block.type == 'card' %}
          <div class="weitere-themen__card" {{ block.shopify_attributes }}
               style="background-color: {{ section.settings.card_bg }};">
            {% if block.settings.icon != blank %}
              <div class="weitere-themen__card-icon">
                <img
                  src="{{ block.settings.icon | image_url: width: 80 }}"
                  alt=""
                  width="40"
                  height="40"
                  loading="lazy"
                >
              </div>
            {% endif %}
            <h3 class="weitere-themen__card-title" style="color: {{ section.settings.card_title_color }};">
              {{ block.settings.title }}
            </h3>
            <p class="weitere-themen__card-text" style="color: {{ section.settings.card_text_color }};">
              {{ block.settings.text }}
            </p>
            {% if block.settings.link != blank %}
              <a class="weitere-themen__card-link"
                 href="{{ block.settings.link }}"
                 style="color: {% if block.settings.link_color == 'orange' %}{{ section.settings.accent_orange }}{% else %}{{ section.settings.accent_color }}{% endif %};">
                {{ block.settings.link_label | default: 'Mehr erfahren' }} →
              </a>
            {% endif %}
          </div>
        {% endif %}
      {% endfor %}
    </div>

  </div>
</section>

<style>
  .weitere-themen {
    padding: 60px 20px;
  }

  .weitere-themen__container {
    max-width: 1200px;
    margin: 0 auto;
    text-align: center;
  }

  .weitere-themen__label {
    margin-bottom: 12px;
  }

  .weitere-themen__label span {
    display: inline-block;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    border: 1.5px solid;
    border-radius: 20px;
    padding: 5px 16px;
  }

  .weitere-themen__heading {
    font-size: 40px;
    font-weight: 400;
    margin: 0 0 12px;
    line-height: 1.2;
  }

  .weitere-themen__heading em {
    font-family: Georgia, 'Times New Roman', serif;
    font-style: italic;
  }

  .weitere-themen__intro {
    font-size: 15px;
    line-height: 1.6;
    margin: 0 auto 40px;
    max-width: 520px;
  }

  .weitere-themen__grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 16px;
  }

  .weitere-themen__card {
    border-radius: 16px;
    padding: 24px 20px;
    text-align: left;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 10px;
    border: 1px solid rgba(0,0,0,0.06);
  }

  .weitere-themen__card-icon {
    width: 44px;
    height: 44px;
    border-radius: 50%;
    background: rgba(0,0,0,0.05);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .weitere-themen__card-icon img {
    width: 24px;
    height: 24px;
    object-fit: contain;
  }

  .weitere-themen__card-title {
    font-size: 15px;
    font-weight: 700;
    margin: 0;
    line-height: 1.3;
  }

  .weitere-themen__card-text {
    font-size: 13px;
    line-height: 1.6;
    margin: 0;
    flex: 1;
  }

  .weitere-themen__card-link {
    font-size: 13px;
    font-weight: 600;
    text-decoration: none;
    margin-top: 4px;
  }

  .weitere-themen__card-link:hover {
    text-decoration: underline;
  }

  @media (max-width: 900px) {
    .weitere-themen__grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 500px) {
    .weitere-themen__grid {
      grid-template-columns: 1fr;
    }

    .weitere-themen__heading {
      font-size: 28px;
    }
  }
</style>

