<section class="reviews_sec homereview" style="background-color: {{ section.settings.background_color }}">
  <div class="container">
    <div class="testimonial-header">
      <h2 class="testimonial-heading">{{ section.settings.heading }}</h2>
      <div class="testimonial-controls desktop-controls">
        <div class="testimonial-prev">
          <img src="https://cdn.shopify.com/s/files/1/0904/4639/7774/files/arrow-left.svg?v=1755089155" alt="Prev">
        </div>
        <div class="testimonial-next">
          <img src="https://cdn.shopify.com/s/files/1/0904/4639/7774/files/arrow-right.svg?v=1755089155" alt="Next">
        </div>
      </div>
    </div>
    <div class="testimonial-slider">
      {% for block in section.blocks %}
        <div class="testimonial-slide">
          <div class="testimonial-card">
            <div class="testimonial_img">
              {% if block.settings.image %}
                <img
                  class="review_img"
                  src="{{ block.settings.image | img_url: 'master' }}"
                  alt="{{ block.settings.name }}"
                >

                {% comment %}
                  <div class="video-icon">
                         <img src="{{ 'play_icon.png' | asset_url }}" alt="Play Video" onclick="playVideo('{{ block.settings.vimeo_id }}')">



                  </div>
                {% endcomment %}
                {% assign video_source = '' %}
                {% if block.settings.vimeo_url != blank %}
                  {% assign video_source = block.settings.vimeo_url %}
                {% elsif block.settings.video_url != blank %}
                  {% assign video_source = block.settings.video_url %}
                {% endif %}

                {% if video_source != blank %}
                  <div class="video-icon">
                    <img
                      src="https://cdn.shopify.com/s/files/1/0904/4639/7774/files/playicon.svg"
                      alt="Play Video"
                      onclick="playVideo('{{ video_source }}', this)"
                    >
                  </div>
                {% endif %}
              {% endif %}
            </div>
            <div class="testimonial_cnt">
              <p class="testimonail_name">
                <strong>{{ block.settings.name }}</strong>
              </p>

              {% if block.settings.review_img %}
                <img src="{{ block.settings.review_img | img_url: 'master' }}">
              {% endif %}
              <p class="reviewdesc">{{ block.settings.review }}</p>

              <div class="testimonial_btm">
                <div class="prd_img">
                  {% if block.settings.product_img %}
                    <img src="{{ block.settings.product_img | img_url: 'master' }}">
                  {% endif %}
                </div>
                <div class="prd_right">
                  <span>{{ block.settings.heading_btm }}</span>
                  <span>{{ block.settings.heading_btm2 }}</span>
                </div>
              </div>
            </div>
          </div>
        </div>
      {% endfor %}
    </div>

    <div class="testimonial-controls mobile-controls">
      <div class="testimonial-prev">
        <img src="https://cdn.shopify.com/s/files/1/0904/4639/7774/files/arrow-left.svg?v=1755089155" alt="Prev">
      </div>
      <div class="testimonial-next">
        <img src="https://cdn.shopify.com/s/files/1/0904/4639/7774/files/arrow-right.svg?v=1755089155" alt="Next">
      </div>
    </div>
  </div>
</section>
<div id="videoLightbox" class="video-lightbox" style="display:none;">
  <div class="lightbox-content">
    <span class="lightbox-close" onclick="closeLightbox()">&times;</span>
    <div id="lightboxVideoContainer"></div>
  </div>
</div>
<style>
  .video-lightbox {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: rgba(0,0,0,0.85);
    z-index: 9999999;
    display: flex;
    justify-content: center;
    align-items: center;
  }
  p.reviewdesc {
      height: 84px;
  }
  .lightbox-content {
    position: relative;
    max-width: 90%;
    max-height: 90%;
    width: 800px;
  }

  .lightbox-content iframe,
  .lightbox-content video {
    width: 100%;
    height: 100%;
    max-width: 90vw;
    max-height: 90vh;
  }
  div#lightboxVideoContainer {
      margin: 0 auto;
      text-align: center;
  }
  .lightbox-close {
    position: absolute;
    top: -30px;
    right: -30px;
    font-size: 40px;
    color: white;
    cursor: pointer;
  }

  @media (max-width: 767px) {
  p.reviewdesc {
      height: 100px;
  }
  }

  @media (max-width: 480px) {
  p.reviewdesc {
      height: 88px;
  }

  }

  @media (max-width: 380px) {
  p.reviewdesc {
      height: 100px;
  }

  }
  {% unless localization.language.iso_code == "de" %}
    .reviews_sec .video-icon{
      display: none !important;
    }
  {% endunless %}
</style>
<script>
 {% comment %} function playVideo(videoUrl) {
  if (videoUrl) {
    var videoPlayer = document.createElement('iframe');
    videoPlayer.controls = true;
    videoPlayer.src = videoUrl;
    videoPlayer.style.width = '100%';
    videoPlayer.style.display = 'block';
    var slide = event.target.closest('.testimonial_img');
    slide.innerHTML = '';
    slide.appendChild(videoPlayer);
    videoPlayer.play();
  }
}  {% endcomment %}
function playVideo(videoUrl, el) {
  if (!videoUrl) return;

  const container = document.getElementById('lightboxVideoContainer');
  container.innerHTML = ''; // Clear previous

  let content;

  if (videoUrl.includes('vimeo.com')) {
    const regex = /vimeo\.com\/(?:.*\/)?([0-9]+)/;
    const match = videoUrl.match(regex);
    if (match && match[1]) {
      const videoId = match[1];
      content = document.createElement('iframe');
      content.src = `https://player.vimeo.com/video/${videoId}?autoplay=1&title=0&byline=0&portrait=0`;
      content.setAttribute('frameborder', '0');
      content.setAttribute('allowfullscreen', '');
      content.setAttribute('allow', 'autoplay; fullscreen');
    }
  } else {
    content = document.createElement('video');
    content.src = videoUrl;
    content.setAttribute('controls', '');
    content.setAttribute('autoplay', '');
  }

  if (content) {
    content.style.width = '100%';
    content.style.height = '100%';
    container.appendChild(content);
    document.getElementById('videoLightbox').style.display = 'flex';
  }
}

function closeLightbox() {
  const lightbox = document.getElementById('videoLightbox');
  const container = document.getElementById('lightboxVideoContainer');
  container.innerHTML = ''; // Stop video
  lightbox.style.display = 'none';
}

{% comment %} document.addEventListener("DOMContentLoaded", function() {
  $('.testimonial-slider1').slick({
    infinite: false,
    slidesToShow: 3,
    slidesToScroll: 1,
    arrows: false,
    dots: false,
    responsive: [
      { breakpoint: 992, settings: { slidesToShow: 2 } },
      { breakpoint: 768, settings: { slidesToShow: 1.5, dots: true } }
    ]
  });

  $('.next-slide').click(function(){
    $('.testimonial-slider').slick('slickNext');
  });

  $('.prev-slide').click(function(){
    $('.testimonial-slider').slick('slickPrev');
  });
  }); {% endcomment %}
</script>

{% schema %}
{
  "name": "Home Reviews",
  "settings": [
    {
      "type": "color",
      "id": "background_color",
      "label": "Background Color",
      "default": "#EFECE4"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading"
    }
  ],
  "blocks": [
    {
      "type": "review",
      "name": "Review",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Customer Image"
        },
        {
          "type": "image_picker",
          "id": "review_img",
          "label": "Review Image"
        },
        {
          "type": "text",
          "id": "name",
          "label": "Name"
        },
        {
          "type": "textarea",
          "id": "review",
          "label": "Review"
        },

        {
          "type": "image_picker",
          "id": "product_img",
          "label": "Product Image"
        },
        {
          "type": "url",
          "id": "vimeo_url",
          "label": "Vimeo Video URL"
        },

        {
          "type": "url",
          "id": "video_url",
          "label": "Video url"
        },

        {
          "type": "text",
          "id": "heading_btm",
          "label": "Product Heading"
        },

        {
          "type": "text",
          "id": "heading_btm2",
          "label": "Product Sub Heading"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Home Reviews",
      "blocks": [
        {
          "type": "review",
          "settings": {
            "name": "Carla D."
          }
        },
        {
          "type": "review",
          "settings": {
            "name": "Julia K."
          }
        }
      ]
    }
  ]
}
{% endschema %}
