{% comment %}
  Section: Relaunch Detail
{% endcomment %}
<section class="relaunch-detail" id="relaunch-detail-{{ section.id }}" style="background-color: {{ section.settings.bg_color }};">
  <div class="relaunch-detail__container">
    <div class="relaunch-detail__content">
      <span class="relaunch-detail__badge" style="
        background-color: {{ section.settings.badge_bg_color }};
        color: {{ section.settings.badge_text_color }};
        border: {{ section.settings.badge_border_thickness }}px solid {{ section.settings.badge_border_color }};
        border-radius: {{ section.settings.badge_radius }}px;
        font-size: {{ section.settings.badge_font_size }}px;
        font-weight: {{ section.settings.badge_font_weight }};
        letter-spacing: {{ section.settings.badge_letter_spacing }}px;
      ">{{ section.settings.badge_text }}</span>
      <h2 class="relaunch-detail__heading">
        {{ section.settings.heading }} <em>{{ section.settings.heading_italic }}</em>
      </h2>
      {% if section.settings.tagline != blank %}
        <blockquote class="relaunch-detail__tagline">
          <p>{{ section.settings.tagline }}</p>
        </blockquote>
      {% endif %}
      <div class="relaunch-detail__text">{{ section.settings.body_text }}</div>
      {% if section.settings.bold_intro != blank %}
        <p class="relaunch-detail__bold-text">
          <strong>{{ section.settings.bold_intro }}</strong> {{ section.settings.bold_text }}
        </p>
      {% endif %}
      <div class="relaunch-detail__columns">
        {% for block in section.blocks %}
          {% if block.type == 'column' %}
            <div class="relaunch-detail__column" style="border-left-color: {{ block.settings.accent_color }};" {{ block.shopify_attributes }}>
              <h4 class="relaunch-detail__column-title" style="color: {{ block.settings.accent_color }};">{{ block.settings.title }}</h4>
              <ul class="relaunch-detail__list">
                {% assign items = block.settings.items | split: '|' %}
                {% for item in items %}
                  <li>
                    <span class="relaunch-detail__icon" style="color: {{ block.settings.accent_color }};">{{ block.settings.icon }}</span>
                    {{ item | strip }}
                  </li>
                {% endfor %}
              </ul>
            </div>
          {% endif %}
        {% endfor %}
      </div>
    </div>

    <div class="relaunch-detail__image">
      {% assign slide_blocks = section.blocks | where: "type", "slide" %}
      {% if slide_blocks.size > 0 %}
        <div class="relaunch-detail__slider" data-slider="{{ section.id }}">
          {% for block in slide_blocks %}
            <div class="relaunch-detail__slide{% if forloop.first %} active{% endif %}" {{ block.shopify_attributes }}>
              {% if block.settings.image != blank %}
                <img
                  src="{{ block.settings.image | image_url: width: 800 }}"
                  alt="{{ block.settings.image_alt }}"
                  loading="lazy"
                  width="800"
                >
              {% endif %}
            </div>
          {% endfor %}
          {% if slide_blocks.size > 1 %}
            <div class="relaunch-detail__dots">
              {% for block in slide_blocks %}
                <button class="relaunch-detail__dot{% if forloop.first %} active{% endif %}" aria-label="Slide {{ forloop.index }}"></button>
              {% endfor %}
            </div>
          {% endif %}
        </div>
      {% elsif section.settings.image != blank %}
        <img
          src="{{ section.settings.image | image_url: width: 800 }}"
          alt="{{ section.settings.image_alt }}"
          loading="lazy"
          width="800"
        >
      {% endif %}
    </div>
  </div>
</section>

<style>
  .relaunch-detail {
    padding: 60px 20px;
  }
  .relaunch-detail__container {
    max-width: 1200px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 60px;
    align-items: center;
  }
  .relaunch-detail__badge {
    display: inline-block;
    text-transform: uppercase;
    padding: 8px 20px;
    margin-bottom: 20px;
  }
  .relaunch-detail__heading {
    font-size: 36px;
    font-weight: 400;
    color: {{ section.settings.heading_color }};
    margin: 0 0 20px;
    line-height: 1.2;
  }
  .relaunch-detail__heading em {
    font-family: Georgia, 'Times New Roman', serif;
    font-style: italic;
    color: {{ section.settings.accent_color }};
  }
  .relaunch-detail__tagline {
    padding-left: 16px;
    border-left: 3px solid {{ section.settings.accent_color }};
    margin: 0 0 20px;
  }
  .relaunch-detail__tagline p {
    font-size: 15px;
    font-weight: 600;
    color: {{ section.settings.tagline_color }};
    margin: 0;
  }
  .relaunch-detail__text {
    font-size: 14px;
    line-height: 1.7;
    color: {{ section.settings.text_color }};
    margin-bottom: 16px;
  }
  .relaunch-detail__bold-text {
    font-size: 14px;
    line-height: 1.7;
    color: {{ section.settings.bold_text_color }};
    margin: 0 0 24px;
  }
  .relaunch-detail__columns {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 16px;
  }
  .relaunch-detail__column {
    background: #fff;
    border-radius: 10px;
    padding: 20px;
    border-left: 3px solid transparent;
  }
  .relaunch-detail__column-title {
    font-size: 11px;
    letter-spacing: 2px;
    text-transform: uppercase;
    margin: 0 0 12px;
  }
  .relaunch-detail__list {
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .relaunch-detail__list li {
    font-size: 14px;
    color: {{ section.settings.list_text_color }};
    margin-bottom: 6px;
    display: flex;
    align-items: center;
    gap: 6px;
  }
  .relaunch-detail__icon {
    font-size: 14px;
  }

  /* Slider */
  .relaunch-detail__image img,
  .relaunch-detail__slider {
    border-radius: 16px;
    overflow: hidden;
  }
  .relaunch-detail__image img {
    width: 100%;
    height: auto;
    display: block;
  }
  .relaunch-detail__slider {
    position: relative;
    display: grid;
  }
  .relaunch-detail__slide {
    grid-area: 1 / 1;
    opacity: 0;
    transition: opacity 0.7s ease;
    pointer-events: none;
  }
  .relaunch-detail__slide.active {
    opacity: 1;
    pointer-events: auto;
  }
  .relaunch-detail__slide img {
    width: 100%;
    height: auto;
    display: block;
  }
  .relaunch-detail__dots {
    position: absolute;
    bottom: 12px;
    left: 50%;
    transform: translateX(-50%);
    display: flex;
    gap: 6px;
    z-index: 2;
  }
  .relaunch-detail__dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    border: none;
    background: rgba(255,255,255,0.5);
    cursor: pointer;
    padding: 0;
    transition: background 0.3s;
  }
  .relaunch-detail__dot.active {
    background: #fff;
  }

  @media (max-width: 900px) {
    .relaunch-detail__container {
      grid-template-columns: 1fr;
      gap: 30px;
    }
    .relaunch-detail__image {
      order: -1;
    }
  }
  @media (max-width: 500px) {
    .relaunch-detail__heading {
      font-size: 28px;
    }
    .relaunch-detail__columns {
      grid-template-columns: 1fr;
    }
  }
</style>

<script>
  (function () {
    var slider = document.querySelector('[data-slider="{{ section.id }}"]');
    if (!slider) return;
    var slides = Array.from(slider.querySelectorAll('.relaunch-detail__slide'));
    var dots = Array.from(slider.querySelectorAll('.relaunch-detail__dot'));
    if (slides.length <= 1) return;

    var current = 0;

    function goTo(index) {
      slides[current].classList.remove('active');
      dots[current] && dots[current].classList.remove('active');
      current = index % slides.length;
      slides[current].classList.add('active');
      dots[current] && dots[current].classList.add('active');
    }

    dots.forEach(function (dot, i) {
      dot.addEventListener('click', function () {
        clearInterval(timer);
        goTo(i);
        timer = setInterval(advance, 3000);
      });
    });

    function advance() { goTo(current + 1); }
    var timer = setInterval(advance, 3000);
  })();
</script>

