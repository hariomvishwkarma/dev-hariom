<section class="phases-section" id="phases-{{ section.id }}">
  <div class="phases-section__inner page-width">

{%- if section.settings.eyebrow != blank -%}
<p class="phases-section__eyebrow" style="color: {{ section.settings.eyebrow_color }};">
{{ section.settings.eyebrow }}
</p>
{%- endif -%}

{%- if section.settings.heading != blank -%}
<h2 class="phases-section__heading">
{{ section.settings.heading }}
</h2>
{%- endif -%}

{%- if section.settings.subtext != blank -%}
<p class="phases-section__subtext">{{ section.settings.subtext }}</p>
{%- endif -%}

<div class="phases-table-wrapper">
<table class="phases-table">
<thead>
<tr>
<th>{{ section.settings.col1_header }}</th>
<th>{{ section.settings.col2_header }}</th>
<th>{{ section.settings.col3_header }}</th>
<th>{{ section.settings.col4_header }}</th>
<th>{{ section.settings.col5_header }}</th>
</tr>
</thead>
<tbody>
{%- for block in section.blocks -%}
<tr {{ block.shopify_attributes }}>
<td>
<span class="phases-table__badge" style="background-color: {{ block.settings.badge_color }};">
{{ block.settings.phase_name }}
</span>
</td>
<td class="phases-table__bold">{{ block.settings.duration }}</td>
<td>{{ block.settings.food }}</td>
<td class="phases-table__bold">{{ block.settings.timing }}</td>
<td>{{ block.settings.goal }}</td>
</tr>
{%- endfor -%}
</tbody>
</table>
</div>

</div>
</section>

<style>
/* ── Section ── */
.phases-section {
background-color: {{ section.settings.background_color }};
padding: 70px 0 80px;
  }

.phases-section__inner {
max-width: 1200px;
margin: 0 auto;
padding: 0 24px;
text-align: center;
  }

/* ── Eyebrow ── */
.phases-section__eyebrow {
font-size: 13px;
font-weight: 700;
letter-spacing: 0.15em;
text-transform: uppercase;
margin: 0 0 16px;
  }

/* ── Heading ── */
.phases-section__heading {
font-size: clamp(30px, 4vw, 48px);
font-weight: 300;
line-height: 1.15;
color: {{ section.settings.heading_color }};
margin: 0 0 16px;
  }

.phases-section__heading em {
  font-family: var(--accent-font-family);
  font-style: var(--accent-font-style);
  font-weight: 500;
}

/* ── Subtext ── */
.phases-section__subtext {
font-size: clamp(15px, 1.2vw, 17px);
line-height: 1.6;
color: {{ section.settings.text_color }};
margin: 0 0 48px;
  }

/* ── Table wrapper ── */
.phases-table-wrapper {
border: {{ section.settings.border_thickness }}px solid {{ section.settings.border_color }};
border-radius: 16px;
overflow: hidden;
background: #fff;
  }

/* ── Table ── */
.phases-table {
width: 100%;
border-collapse: collapse;
text-align: left;
font-size: 15px;
color: {{ section.settings.text_color }};
  }

.phases-table thead th {
padding: 22px 28px;
font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
font-size: 14px;
font-weight: 600;
font-style: normal;
color: #8a8275;
background: #faf8f5;
border-bottom: 1px solid #ece8e1;
  }

.phases-table tbody tr {
border-bottom: 1px solid #ece8e1;
  }

.phases-table tbody tr:last-child {
border-bottom: none;
  }

.phases-table tbody td {
padding: 24px 28px;
vertical-align: middle;
line-height: 1.5;
  }

.phases-table__bold {
font-weight: 600;
color: #3a3530;
  }

/* ── Badge ── */
.phases-table__badge {
display: inline-block;
padding: 6px 16px;
border-radius: 50px;
color: #fff;
font-size: 13px;
font-weight: 600;
white-space: nowrap;
  }

/* ── Responsive: card layout ── */
@media (max-width: 860px) {
.phases-table-wrapper {
border: none;
border-radius: 0;
background: transparent;
    }

.phases-table,
.phases-table thead,
.phases-table tbody,
.phases-table tr,
.phases-table th,
.phases-table td {
display: block;
width: 100%;
    }

.phases-table thead {
display: none;
    }

.phases-table tbody tr {
background: #fff;
border: {{ section.settings.border_thickness }}px solid {{ section.settings.border_color }};
border-radius: 14px;
margin-bottom: 16px;
padding: 20px;
    }

.phases-table tbody td {
padding: 10px 0;
display: grid;
grid-template-columns: 1fr 1fr;
align-items: baseline;
gap: 8px;
font-size: 14px;
border-bottom: 1px solid #ece8e1;
    }

.phases-table tbody td:last-child {
border-bottom: none;
    }

.phases-table tbody td::before {
content: attr(data-label);
font-size: 13px;
font-style: italic;
font-weight: 400;
color: #8a8275;
    }

.phases-table tbody td:first-child {
display: block;
padding-bottom: 14px;
margin-bottom: 4px;
    }

.phases-table tbody td:first-child::before {
display: none;
    }
  }
</style>

<script>
/* Inject data-label attributes for mobile card view */
  (function() {
var table = document.querySelector('#phases-{{ section.id }} .phases-table');
if (!table) return;
var headers = table.querySelectorAll('thead th');
var rows = table.querySelectorAll('tbody tr');
rows.forEach(function(row) {
var cells = row.querySelectorAll('td');
cells.forEach(function(cell, i) {
if (headers[i]) {
cell.setAttribute('data-label', headers[i].textContent.trim());
        }
      });
    });
  })();
</script>

{% schema %}
{
  "name": "Phases Table",
  "tag": "section",
  "class": "section-phases-table",
  "settings": [
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "default": "#f7f3ee"
    },
    {
      "type": "header",
      "content": "Table border"
    },
    {
      "type": "range",
      "id": "border_thickness",
      "min": 0,
      "max": 5,
      "step": 0.5,
      "default": 1.5,
      "unit": "px",
      "label": "Border thickness"
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "Border color",
      "default": "#d5d0c8"
    },
    {
      "type": "header",
      "content": "Text"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow text",
      "default": "DAS KONZEPT"
    },
    {
      "type": "color",
      "id": "eyebrow_color",
      "label": "Eyebrow color",
      "default": "#4FBFBE"
    },
    {
      "type": "richtext",
      "id": "heading",
      "label": "Heading (use italic for emphasis)",
      "default": "<p>3 Phasen auf <em>einen Blick</em></p>"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading color",
      "default": "#2c2c2c"
    },
    {
      "type": "text",
      "id": "subtext",
      "label": "Subtext",
      "default": "Jede Phase hat eine klare Aufgabe, klare Regeln und ein klares Ziel."
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Body text color",
      "default": "#5a554e"
    },
    {
      "type": "header",
      "content": "Column headers"
    },
    {
      "type": "text",
      "id": "col1_header",
      "label": "Column 1",
      "default": "Phase"
    },
    {
      "type": "text",
      "id": "col2_header",
      "label": "Column 2",
      "default": "Dauer"
    },
    {
      "type": "text",
      "id": "col3_header",
      "label": "Column 3",
      "default": "Was wird gegessen?"
    },
    {
      "type": "text",
      "id": "col4_header",
      "label": "Column 4",
      "default": "Wann wird gegessen?"
    },
    {
      "type": "text",
      "id": "col5_header",
      "label": "Column 5",
      "default": "Ziel"
    }
  ],
  "blocks": [
    {
      "type": "phase_row",
      "name": "Phase row",
      "settings": [
        {
          "type": "text",
          "id": "phase_name",
          "label": "Phase name",
          "default": "Startphase"
        },
        {
          "type": "color",
          "id": "badge_color",
          "label": "Badge color",
          "default": "#c49456"
        },
        {
          "type": "text",
          "id": "duration",
          "label": "Duration",
          "default": "2 Tage"
        },
        {
          "type": "text",
          "id": "food",
          "label": "What is eaten",
          "default": "5× Start Shake täglich"
        },
        {
          "type": "text",
          "id": "timing",
          "label": "When",
          "default": "Alle 2-3 Stunden"
        },
        {
          "type": "text",
          "id": "goal",
          "label": "Goal",
          "default": "Stoffwechsel umstellen"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Phases Table",
      "blocks": [
        {
          "type": "phase_row",
          "settings": {
            "phase_name": "Startphase",
            "badge_color": "#c49456",
            "duration": "2 Tage",
            "food": "5× Start Shake täglich",
            "timing": "Alle 2-3 Stunden",
            "goal": "Stoffwechsel umstellen"
          }
        },
        {
          "type": "phase_row",
          "settings": {
            "phase_name": "Abnehmphase",
            "badge_color": "#4FBFBE",
            "duration": "Bis zum Ziel",
            "food": "2× Precon + 1× normale Mahlzeit",
            "timing": "Alle 4-6 Stunden",
            "goal": "Kontinuierlich abnehmen"
          }
        },
        {
          "type": "phase_row",
          "settings": {
            "phase_name": "Haltephase",
            "badge_color": "#8a9a6c",
            "duration": "4–6 Wochen",
            "food": "1× Precon + 2× normale Mahlzeiten",
            "timing": "Alle 4-6 Stunden",
