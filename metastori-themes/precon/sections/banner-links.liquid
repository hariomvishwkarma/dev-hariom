{% comment %}
  banner-links.liquid
  Responsive: card (mobile) ↔ two-column hero (desktop).
  Precon Shop
{% endcomment %}

{%- liquid
  assign s          = section.settings
  assign nav_blocks = section.blocks | where: 'type', 'nav_link'

  assign overlay_opacity = s.overlay_opacity | divided_by: 100.0
  assign overlay_hex     = s.overlay_color | default: '#1a1410'

  assign b_radius = s.border_radius | append: 'px'
-%}

<style>
  #bl-{{ section.id }} {
    padding: 20px 16px;
  }

  /* ── Wrapper ────────────────────────────────────── */
  #bl-{{ section.id }} .bl {
    position: relative;
    overflow: hidden;
    border-radius: {{ b_radius }};
    color: #fff;
    width: 100%;
  }

  /* ── Background ─────────────────────────────────── */
  #bl-{{ section.id }} .bl__bg {
    position: absolute;
    inset: 0;
    z-index: 0;
  }

  #bl-{{ section.id }} .bl__bg-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    display: block;
  }

  #bl-{{ section.id }} .bl__overlay {
    position: absolute;
    inset: 0;
    z-index: 1;
  }

  /* ── Grid (two-column on desktop) ───────────────── */
  #bl-{{ section.id }} .bl__grid {
    position: relative;
    z-index: 2;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 48px;
    align-items: center;
    padding: {{ s.padding_y }}px {{ s.padding_x }}px;
    min-height: 400px;
  }

  /* ── Left: text ─────────────────────────────────── */
  #bl-{{ section.id }} .bl__left {
    display: flex;
    flex-direction: column;
  }

  #bl-{{ section.id }} .bl__eyebrow {
    font-family: 'Figtree', sans-serif;
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: rgba(255,255,255,0.55);
    margin: 0 0 16px;
    line-height: 1.4;
  }

  #bl-{{ section.id }} .bl__heading {
    margin: 0 0 18px;
    line-height: 1.05;
    color: #fff;
  }

  #bl-{{ section.id }} .bl__heading-sans {
    display: block;
    font-family: 'Figtree', sans-serif;
    font-size: clamp(28px, 3.5vw, 48px);
    font-weight: 300;
    letter-spacing: -0.01em;
  }

  #bl-{{ section.id }} .bl__heading-serif {
    display: block;
    font-family: 'Playfair Display', Georgia, serif;
    font-size: clamp(28px, 3.5vw, 48px);
    font-weight: 500;
    font-style: italic;
    letter-spacing: -0.01em;
  }

  #bl-{{ section.id }} .bl__subtext {
    font-family: 'Figtree', sans-serif;
    font-size: 16px;
    line-height: 1.6;
    color: rgba(255,255,255,0.72);
    margin: 0;
  }

  /* ── Right: nav links ───────────────────────────── */
  #bl-{{ section.id }} .bl__right {
    display: flex;
    flex-direction: column;
  }

  #bl-{{ section.id }} .bl__nav {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 1px solid rgba(255,255,255,0.12);
  }

  #bl-{{ section.id }} .bl__nav-item {
    border-bottom: 1px solid rgba(255,255,255,0.12);
  }

  #bl-{{ section.id }} .bl__nav-link {
    display: flex;
    align-items: center;
    gap: 16px;
    padding: 18px 0;
    text-decoration: none;
    color: inherit;
    transition: opacity 0.18s ease;
  }

  #bl-{{ section.id }} .bl__nav-link:hover {
    opacity: 0.8;
  }

  #bl-{{ section.id }} .bl__nav-icon {
    flex-shrink: 0;
    width: 52px;
    height: 52px;
    border-radius: 50%;
    border: 1.5px solid rgba(255,255,255,0.25);
    background: rgba(255,255,255,0.07);
    display: flex;
    align-items: center;
    justify-content: center;
    color: rgba(255,255,255,0.85);
  }

  #bl-{{ section.id }} .bl__nav-text {
    flex: 1;
    min-width: 0;
  }

  #bl-{{ section.id }} .bl__nav-title {
    font-family: 'Figtree', sans-serif;
    font-size: 16px;
    font-weight: 700;
    color: #fff;
    line-height: 1.25;
    display: block;
    margin-bottom: 3px;
  }

  #bl-{{ section.id }} .bl__nav-subtitle {
    font-family: 'Figtree', sans-serif;
    font-size: 13px;
    color: rgba(255,255,255,0.55);
    line-height: 1.35;
    display: block;
  }

  #bl-{{ section.id }} .bl__nav-arrow {
    flex-shrink: 0;
    width: 36px;
    height: 36px;
    border-radius: 50%;
    border: 1.5px solid rgba(255,255,255,0.35);
    background: rgba(255,255,255,0.08);
    display: flex;
    align-items: center;
    justify-content: center;
    color: rgba(255,255,255,0.8);
    transition: background 0.18s ease, border-color 0.18s ease, color 0.18s ease, transform 0.18s ease;
  }

  #bl-{{ section.id }} .bl__nav-link:hover .bl__nav-arrow {
    background: rgba(255,255,255,0.18);
    border-color: rgba(255,255,255,0.7);
    color: #fff;
    transform: translate(2px,-2px);
  }

  /* ── Mobile: single-column card ─────────────────── */
  @media (max-width: 767px) {
    #bl-{{ section.id }} {
      padding: 16px 12px;
      display: flex;
      justify-content: center;
    }

    #bl-{{ section.id }} .bl {
      max-width: {{ s.max_width }}px;
    }

    #bl-{{ section.id }} .bl__grid {
      grid-template-columns: 1fr;
      gap: 0;
      min-height: unset;
      padding: {{ s.padding_top }}px {{ s.padding_x_mobile }}px {{ s.padding_bottom }}px;
    }

    #bl-{{ section.id }} .bl__left {
      margin-bottom: 24px;
    }

    #bl-{{ section.id }} .bl__heading-sans {
      font-size: clamp(24px, 6vw, 36px);
    }

    #bl-{{ section.id }} .bl__heading-serif {
      font-size: clamp(24px, 6vw, 36px);
    }

    #bl-{{ section.id }} .bl__nav-icon {
      width: 44px;
      height: 44px;
    }
  }
</style>

<div id="bl-{{ section.id }}">
  <div class="bl">

    {%- comment %} Background {%- endcomment %}
    <div class="bl__bg" aria-hidden="true">
      {%- if s.bg_image != blank or s.bg_image_mobile != blank -%}
        {%- assign _desk_img = s.bg_image -%}
        {%- assign _mob_img  = s.bg_image_mobile | default: s.bg_image -%}
        <picture>
          <source
            media="(max-width: 767px)"
            srcset="{{ _mob_img | image_url: width: 900 }}"
          >
          <img
            class="bl__bg-img"
            src="{{ _desk_img | image_url: width: 1800 }}"
            alt=""
            loading="lazy"
            width="{{ _desk_img.width }}"
            height="{{ _desk_img.height }}"
          >
        </picture>
      {%- else -%}
        <div style="width:100%;height:100%;background:#2d2419;"></div>
      {%- endif -%}
      <div class="bl__overlay" style="background:{{ overlay_hex }};opacity:{{ overlay_opacity }};"></div>
    </div>

    <div class="bl__grid">

      {%- comment %} LEFT – text {%- endcomment %}
      <div class="bl__left">
        {%- if s.eyebrow != blank -%}
          <p class="bl__eyebrow">{{ s.eyebrow | escape }}</p>
        {%- endif -%}
        {%- if s.heading_1 != blank or s.heading_2 != blank -%}
          <h2 class="bl__heading">
            {%- if s.heading_1 != blank -%}
              <span class="bl__heading-sans">{{ s.heading_1 | escape }}</span>
            {%- endif -%}
            {%- if s.heading_2 != blank -%}
              <span class="bl__heading-serif">{{ s.heading_2 | escape }}</span>
            {%- endif -%}
          </h2>
        {%- endif -%}
        {%- if s.subtext != blank -%}
          <p class="bl__subtext">{{ s.subtext | escape }}</p>
        {%- endif -%}
      </div>

      {%- comment %} RIGHT – nav links {%- endcomment %}
      {%- if nav_blocks.size > 0 -%}
        <div class="bl__right">
          <ul class="bl__nav" role="list">
            {%- for block in nav_blocks -%}
              {%- assign _icon = block.settings.icon -%}

              {%- capture _svg -%}
                {%- case _icon -%}
                  {%- when 'refresh' -%}
                    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="1 4 1 10 7 10"></polyline><polyline points="23 20 23 14 17 14"></polyline><path d="M20.49 9A9 9 0 0 0 5.64 5.64L1 10m22 4-4.64 4.36A9 9 0 0 1 3.51 15"></path></svg>
                  {%- when 'route' -%}
                    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="6" cy="19" r="3"></circle><path d="M9 19h8.5a3.5 3.5 0 0 0 0-7h-11a3.5 3.5 0 0 1 0-7H15"></path><circle cx="18" cy="5" r="3"></circle></svg>
                  {%- when 'clipboard' -%}
                    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M16 4h2a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h2"></path><rect x="8" y="2" width="8" height="4" rx="1" ry="1"></rect><polyline points="9 12 11 14 15 10"></polyline></svg>
                  {%- when 'book' -%}
                    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"></path><path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"></path></svg>
                  {%- when 'utensils' -%}
                    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="3" y1="2" x2="3" y2="22"></line><path d="M7 2v6a4 4 0 0 1-4 4"></path><line x1="7" y1="12" x2="7" y2="22"></line><path d="M21 15V2a5 5 0 0 0-5 5v6a5 5 0 0 0 5 5z"></path><line x1="21" y1="22" x2="21" y2="15"></line></svg>
                  {%- when 'heart' -%}
                    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"></path></svg>
                  {%- when 'users' -%}
                    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path><circle cx="9" cy="7" r="4"></circle><path d="M23 21v-2a4 4 0 0 0-3-3.87"></path><path d="M16 3.13a4 4 0 0 1 0 7.75"></path></svg>
                  {%- when 'leaf' -%}
                    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M17 8C8 10 5.9 16.17 3.82 19.43a1 1 0 0 0 1.46 1.3C8 19 11.81 17 17 8z"></path><path d="M3 22c3-3 5-6 6.5-10"></path></svg>
                  {%- when 'activity' -%}
                    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="22 12 18 12 15 21 9 3 6 12 2 12"></polyline></svg>
                  {%- when 'star' -%}
                    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon></svg>
                  {%- when 'clock' -%}
                    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"></circle><polyline points="12 6 12 12 16 14"></polyline></svg>
                  {%- else -%}
                    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"></circle></svg>
                {%- endcase -%}
              {%- endcapture -%}

              <li class="bl__nav-item" {{ block.shopify_attributes }}>
                <a
                  class="bl__nav-link"
                  href="{{ block.settings.url | default: '#' }}"
                  {%- unless block.settings.url != blank %}aria-disabled="true" tabindex="-1"{% endunless %}
                >
                  <div class="bl__nav-icon">{{ _svg }}</div>
                  <div class="bl__nav-text">
                    {%- if block.settings.title != blank -%}
                      <span class="bl__nav-title">{{ block.settings.title | escape }}</span>
                    {%- endif -%}
                    {%- if block.settings.subtitle != blank -%}
                      <span class="bl__nav-subtitle">{{ block.settings.subtitle | escape }}</span>
                    {%- endif -%}
                  </div>
                  <div class="bl__nav-arrow" aria-hidden="true">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="7" y1="17" x2="17" y2="7"></line><polyline points="7 7 17 7 17 17"></polyline></svg>
                  </div>
                </a>
              </li>
            {%- endfor -%}
          </ul>
        </div>
      {%- endif -%}

    </div>{%- comment %} /.bl__grid {%- endcomment %}
  </div>{%- comment %} /.bl {%- endcomment %}
</div>{%- comment %} /#bl-{{ section.id }} {%- endcomment %}

{% schema %}
{
  "name": "Banner Links",
  "tag": "section",
  "class": "banner-links",
  "settings": [
    {
      "type": "header",
      "content": "Hintergrund"
    },
    {
      "type": "image_picker",
      "id": "bg_image",
      "label": "Hintergrundbild (Desktop)"
    },
    {
      "type": "image_picker",
      "id": "bg_image_mobile",
      "label": "Hintergrundbild (Mobile)",
      "info": "Optional – falls leer, wird das Desktop-Bild verwendet"
    },
    {
      "type": "color",
      "id": "overlay_color",
      "label": "Overlay-Farbe",
      "default": "#1a1410"
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "label": "Overlay-Deckkraft (%)",
      "min": 0,
      "max": 100,
      "step": 5,
      "default": 65
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "border_radius",
      "label": "Ecken-Radius (px)",
      "min": 0,
      "max": 32,
      "step": 2,
      "default": 20
    },
    {
      "type": "range",
      "id": "padding_x",
      "label": "Innenabstand horizontal – Desktop (px)",
      "min": 16,
      "max": 100,
      "step": 4,
      "default": 64
    },
    {
      "type": "range",
      "id": "padding_y",
      "label": "Innenabstand vertikal – Desktop (px)",
      "min": 16,
      "max": 120,
      "step": 4,
      "default": 60
    },
    {
      "type": "range",
      "id": "padding_x_mobile",
      "label": "Innenabstand horizontal – Mobile (px)",
      "min": 12,
      "max": 60,
      "step": 4,
      "default": 28
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Innenabstand oben – Mobile (px)",
      "min": 16,
      "max": 80,
      "step": 4,
      "default": 44
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Innenabstand unten – Mobile (px)",
      "min": 0,
      "max": 60,
      "step": 4,
      "default": 8
    },
    {
      "type": "range",
      "id": "max_width",
      "label": "Max. Kartenbreite – Mobile (px)",
      "min": 300,
      "max": 700,
      "step": 20,
      "default": 540
    },
    {
      "type": "header",
      "content": "Text"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow (klein)",
      "default": "Dein Weg zu mehr Gesundheit"
    },
    {
      "type": "text",
      "id": "heading_1",
      "label": "Überschrift – Zeile 1 (Figtree)",
      "default": "Entdecke"
    },
    {
      "type": "text",
      "id": "heading_2",
      "label": "Überschrift – Zeile 2 (Playfair)",
      "default": "die Precon Welt"
    },
    {
      "type": "textarea",
      "id": "subtext",
      "label": "Untertext",
      "default": "Alles was du brauchst, um dein Ziel zu erreichen."
    }
  ],
  "blocks": [
    {
      "type": "nav_link",
      "name": "Navigations-Link",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            { "value": "refresh",   "label": "Refresh (Pfeile)" },
            { "value": "route",     "label": "Route (Weg)" },
            { "value": "clipboard", "label": "Clipboard (Checkliste)" },
            { "value": "book",      "label": "Buch" },
            { "value": "utensils",  "label": "Besteck" },
            { "value": "heart",     "label": "Herz" },
            { "value": "users",     "label": "Personen" },
            { "value": "leaf",      "label": "Blatt" },
            { "value": "activity",  "label": "Aktivität" },
            { "value": "star",      "label": "Stern" },
            { "value": "clock",     "label": "Uhr" }
          ],
          "default": "heart"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Titel",
          "default": "Begleitreise"
        },
        {
          "type": "text",
          "id": "subtitle",
          "label": "Untertitel",
          "default": "Dein persönlicher Begleiter"
        },
        {
          "type": "url",
          "id": "url",
          "label": "Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Banner Links",
      "blocks": [
        {
          "type": "nav_link",
          "settings": {
            "icon": "route",
            "title": "Begleitreise",
            "subtitle": "Dein persönlicher Weg zum Ziel"
          }
        },
        {
          "type": "nav_link",
          "settings": {
            "icon": "clipboard",
            "title": "Abnehmplan",
            "subtitle": "Dein individueller Ernährungsplan"
          }
        },
        {
          "type": "nav_link",
          "settings": {
            "icon": "book",
            "title": "Blog",
            "subtitle": "Tipps, Wissen & Inspiration"
          }
        },
        {
          "type": "nav_link",
          "settings": {
            "icon": "utensils",
            "title": "Rezeptwelt",
            "subtitle": "Gesunde Rezepte, die schmecken"
          }
        }
      ]
    }
  ]
}
{% endschema %}