<section class="phases-section" id="phases-{{ section.id }}">
  <div class="phases-section__inner page-width">

    {%- if section.settings.eyebrow != blank -%}
      <p class="phases-section__eyebrow" style="color: {{ section.settings.eyebrow_color }};">
        <span class="phases-section__eyebrow-rule"></span>
        {{ section.settings.eyebrow }}
        <span class="phases-section__eyebrow-rule"></span>
      </p>
    {%- endif -%}

    {%- if section.settings.heading != blank -%}
      <h2 class="phases-section__heading">
        {{ section.settings.heading }}
      </h2>
    {%- endif -%}

    {%- if section.settings.subtext != blank -%}
      <p class="phases-section__subtext">{{ section.settings.subtext }}</p>
    {%- endif -%}

    <div class="phases-table-wrapper">
      <table class="phases-table">
        <thead>
          <tr>
            <th>{{ section.settings.col1_header }}</th>
            <th>{{ section.settings.col2_header }}</th>
            <th>{{ section.settings.col3_header }}</th>
            <th>{{ section.settings.col4_header }}</th>
            <th>{{ section.settings.col5_header }}</th>
          </tr>
        </thead>
        <tbody>
          {%- for block in section.blocks -%}
            <tr {{ block.shopify_attributes }}>
              <td>
                <span class="phases-table__badge" style="background-color: {{ block.settings.badge_color }}; color: {{ block.settings.badge_text_color }};">
                  {{ block.settings.phase_name }}
                </span>
              </td>
              <td class="phases-table__bold">{{ block.settings.duration }}</td>
              <td>{{ block.settings.food }}</td>
              <td class="phases-table__bold">{{ block.settings.timing }}</td>
              <td>{{ block.settings.goal }}</td>
            </tr>
          {%- endfor -%}
        </tbody>
      </table>
    </div>

  </div>
</section>

<style>
/* ── Section ── */
.phases-section {
  background-color: {{ section.settings.background_color }};
  padding: 70px 0 80px;
}

.phases-section__inner {
  max-width: 1200px;
  margin: 0 auto;
  padding: 0 24px;
  text-align: center;
}

/* ── Eyebrow (passt zu KDD / WDW / USP-Konzept) ── */
.phases-section__eyebrow {
  display: inline-flex;
  align-items: center;
  gap: 10px;
  font-family: 'Figtree', sans-serif;
  font-size: 11px;
  font-weight: 600;
  letter-spacing: 0.24em;
  text-transform: uppercase;
  margin: 0 0 1rem;
}

.phases-section__eyebrow-rule {
  display: block;
  width: 22px;
  height: 1px;
  background: currentColor;
  opacity: 0.45;
  flex-shrink: 0;
}

/* ── Heading ── */
.phases-section__heading {
  font-family: 'Figtree', sans-serif;
  font-size: clamp(32px, 4vw, 48px);
  font-weight: 300;
  line-height: 1.06;
  letter-spacing: -0.026em;
  color: {{ section.settings.heading_color }};
  margin: 0 0 1rem;
}

.phases-section__heading em {
  font-family: var(--accent-font-family);
  font-style: var(--accent-font-style);
  font-weight: 500;
  display: block;
  letter-spacing: -0.02em;
}

/* ── Subtext ── */
.phases-section__subtext {
  font-family: 'Figtree', sans-serif;
  font-size: clamp(15px, 1.15vw, 16.5px);
  font-weight: 400;
  line-height: 1.8;
  color: {{ section.settings.text_color }};
  margin: 0 0 48px;
}

/* ── Table wrapper ── */
.phases-table-wrapper {
  border: {{ section.settings.border_thickness }}px solid {{ section.settings.border_color }};
  border-radius: 16px;
  overflow: hidden;
  background: #fff;
}

/* ── Table ── */
.phases-table {
  width: 100%;
  border-collapse: collapse;
  text-align: left;
  font-family: 'Figtree', sans-serif;
  font-size: 15px;
  color: {{ section.settings.text_color }};
}

.phases-table thead th {
  padding: 22px 28px;
  font-size: 11px;
  font-weight: 600;
  letter-spacing: 0.1em;
  text-transform: uppercase;
  color: {{ section.settings.col_header_color }};
  background: #faf8f5;
  border-bottom: 1px solid #ece8e1;
}

.phases-table tbody tr {
  border-bottom: 1px solid #ece8e1;
}

.phases-table tbody tr:last-child {
  border-bottom: none;
}

.phases-table tbody td {
  padding: 24px 28px;
  vertical-align: middle;
  line-height: 1.5;
}

.phases-table__bold {
  font-weight: 600;
  color: {{ section.settings.bold_text_color }};
}

/* ── Badge ── */
.phases-table__badge {
  display: inline-block;
  padding: 5px 14px;
  border-radius: 999px;
  color: #fff;
  font-size: 12px;
  font-weight: 600;
  letter-spacing: 0.04em;
  white-space: nowrap;
}

/* ── Shopify wrapper darf auf Mobil nicht clippen ── */
@media (max-width: 860px) {
  #shopify-section-{{ section.id }} {
    overflow: visible !important;
  }
}

/* ── Responsive: card layout ── */
@media (max-width: 860px) {
  .phases-section { padding: 2.5rem 1rem 3rem; overflow: visible; }

  .phases-section__inner,
  .phases-table-wrapper {
    overflow: visible !important;
  }

  .phases-table-wrapper {
    border: none;
    border-radius: 0;
    background: transparent;
  }

  .phases-table,
  .phases-table thead,
  .phases-table tbody,
  .phases-table tr,
  .phases-table th,
  .phases-table td {
    display: block;
    width: 100%;
  }

  .phases-table thead { display: none; }

  .phases-table tbody tr {
    background: #fff;
    border: {{ section.settings.border_thickness }}px solid {{ section.settings.border_color }};
    border-radius: 14px;
    margin-bottom: 16px;
    padding: 20px;
  }

  .phases-table tbody tr:last-child {
    margin-bottom: 0;
  }

  .phases-table tbody td {
    padding: 10px 0;
    display: grid;
    grid-template-columns: 1fr 1fr;
    align-items: baseline;
    gap: 8px;
    font-size: 14px;
    border-bottom: 1px solid #ece8e1;
  }

  .phases-table tbody td:last-child { border-bottom: none; }

  .phases-table tbody td::before {
    content: attr(data-label);
    font-size: 13px;
    font-style: italic;
    font-weight: 400;
    color: #8a8275;
  }

  .phases-table tbody td:first-child {
    display: block;
    padding-bottom: 14px;
    margin-bottom: 4px;
  }

  .phases-table tbody td:first-child::before { display: none; }
}
</style>

<script>
(function() {
  var table = document.querySelector('#phases-{{ section.id }} .phases-table');
  if (!table) return;
  var headers = table.querySelectorAll('thead th');
  var rows = table.querySelectorAll('tbody tr');
  rows.forEach(function(row) {
    row.querySelectorAll('td').forEach(function(cell, i) {
      if (headers[i]) cell.setAttribute('data-label', headers[i].textContent.trim());
    });
  });
})();
</script>

