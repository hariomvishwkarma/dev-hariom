{% assign information_page = pages.produktinformationen %}
{% capture produktinformationen %}<a href="{{ information_page.url }}">{{ information_page.title }}</a>{% endcapture %}
<div class="product-tabs tabs-desktop">
  <div class="container">
    <h2 class="heading">{{ section.settings.heading }}</h2>

    <ul class="tab-buttons">
      {% assign first_tab_set = false %}
      {% if product.metafields.custom.tab_description and product.metafields.custom.tab_title_description %}
        <li
          class="tab-button {% unless first_tab_set %}active{% assign first_tab_set = true %}{% endunless %}"
          data-tab="description"
        >
          {{ product.metafields.custom.tab_title_description }}
        </li>
      {% endif %}
      {% if product.metafields.custom.tab_preparation and product.metafields.custom.tab_title_preparation %}
        <li
          class="tab-button {% unless first_tab_set %}active{% assign first_tab_set = true %}{% endunless %}"
          data-tab="preparation"
        >
          {{ product.metafields.custom.tab_title_preparation }}
        </li>
      {% endif %}
      {% if product.metafields.custom.tab_ingredients and product.metafields.custom.tab_title_ingredients %}
        <li
          class="tab-button {% unless first_tab_set %}active{% assign first_tab_set = true %}{% endunless %}"
          data-tab="ingredients"
        >
          {{ product.metafields.custom.tab_title_ingredients }}
        </li>
      {% endif %}
      {% if product.metafields.custom.tab_faq and product.metafields.custom.tab_title_faq %}
        <li
          class="tab-button {% unless first_tab_set %}active{% assign first_tab_set = true %}{% endunless %}"
          data-tab="faq"
        >
          {{ product.metafields.custom.tab_title_faq }}
        </li>
      {% endif %}
      {% if product.metafields.custom.verzehrempfehlung and product.metafields.custom.tab_title_recommendations %}
        <li
          class="tab-button {% unless first_tab_set %}active{% assign first_tab_set = true %}{% endunless %}"
          data-tab="recommendations"
        >
          {{ product.metafields.custom.tab_title_recommendations }}
        </li>
      {% endif %}
      {% if product.metafields.custom.tab_allergie and product.metafields.custom.tab_heading_allergie %}
        <li
          class="tab-button {% unless first_tab_set %}active{% assign first_tab_set = true %}{% endunless %}"
          data-tab="allergie"
        >
          {{ product.metafields.custom.tab_heading_allergie }}
        </li>
      {% endif %}
    </ul>

    {% if product.metafields.custom.tab_description %}
      <div class="tab-content active" id="description">
        {{
          product.metafields.custom.tab_description
          | metafield_tag
          | replace: '[produktinformationen]', produktinformationen
        }}
      </div>
    {% endif %}

    {% if product.metafields.custom.tab_preparation %}
      <div class="tab-content" id="preparation">
        {{
          product.metafields.custom.tab_preparation
          | metafield_tag
          | replace: '[produktinformationen]', produktinformationen
        }}
      </div>
    {% endif %}

    {% if product.metafields.custom.tab_ingredients %}
      <div class="tab-content" id="ingredients">
        {{
          product.metafields.custom.tab_ingredients
          | metafield_tag
          | replace: '[produktinformationen]', produktinformationen
        }}
        {{ product.metafields.custom.zutaten_table | replace: '[produktinformationen]', produktinformationen }}
      </div>
    {% endif %}

    {% if product.metafields.custom.tab_faq %}
      <div class="tab-content" id="faq">
        {{
          product.metafields.custom.tab_faq
          | metafield_tag
          | replace: '[produktinformationen]', produktinformationen
        }}
      </div>
    {% endif %}

    {% if product.metafields.custom.verzehrempfehlung %}
      <div class="tab-content" id="recommendations">
        {{
          product.metafields.custom.verzehrempfehlung
          | metafield_tag
          | replace: '[produktinformationen]', produktinformationen
        }}
      </div>
    {% endif %}
    {% if product.metafields.custom.tab_allergie %}
      <div class="tab-content" id="allergie">
        {{
          product.metafields.custom.tab_allergie
          | metafield_tag
          | replace: '[produktinformationen]', produktinformationen
        }}
      </div>
    {% endif %}
  </div>
</div>

