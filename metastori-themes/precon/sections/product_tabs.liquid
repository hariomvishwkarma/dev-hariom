      </div>
    {% endif %}
  </div>
</div>

<script>
  document.addEventListener('DOMContentLoaded', function () {
    // Accordion toggle for mobile
    document.querySelectorAll('.tabs-mobile .tab-header').forEach((btn) => {
      btn.addEventListener('click', function () {
        const content = this.nextElementSibling;
        const icon = this.querySelector('.icon');
        const isOpen = content.classList.contains('open');

        // Toggle current only
        if (isOpen) {
          content.classList.remove('open');
          this.classList.remove('open');
          icon.textContent = '+';
        } else {
          // Close others
          document.querySelectorAll('.tabs-mobile .tab-content').forEach((c) => c.classList.remove('open'));
          document.querySelectorAll('.tabs-mobile .tab-header').forEach((h) => h.classList.remove('open'));
          document.querySelectorAll('.tabs-mobile .icon').forEach((i) => (i.textContent = '+'));

          // Open this one
          content.classList.add('open');
          this.classList.add('open');
          icon.textContent = '–';
        }
      });
    });

    // Tabs for desktop
    document.querySelectorAll('.tabs-desktop .tab-button').forEach((btn) => {
      btn.addEventListener('click', function () {
        const tabId = this.dataset.tab;

        document.querySelectorAll('.tabs-desktop .tab-button').forEach((b) => b.classList.remove('active'));
        document.querySelectorAll('.tabs-desktop .tab-content').forEach((c) => c.classList.remove('active'));

        this.classList.add('active');
        document.getElementById(tabId).classList.add('active');
      });
    });
  });
</script>
<style>
  /* --- Compatibility Info Styles --- */
  .compatibility-info-header {
    cursor: pointer;
  }

  .compatibility-info-selected {
    position: relative;
    display: flex;
    justify-content: space-between;
    align-items: center;
    height: 42px;
    margin: 5px 0;
    padding: 0 15px;
    border: 1px solid #cfcfcf;
    border-radius: 8px;
    cursor: pointer;
    z-index: 1;
  }

  .compatibility-info-selected-value {
    font-size: 14px;
    font-weight: 700;
    color: #000;
  }

  .compatibility-info-header-dropdown {
    display: none;
    position: absolute;
    padding: 12px 15px !important;
    background: #fff;
    border: 1px solid #cfcfcf;
    border-top: none;
    top: 85%;
    transform: unset;
    box-shadow: unset;
    border-radius: 0 0 8px 8px;
    width: 100%;
    z-index: 2;
    flex-direction: column;
    gap: 12px;
  }
  .compatibility-info.open .compatibility-info-header-dropdown {
    display: flex;
  }

  .compatibility-info-tab-content {
    display: none;
  }

  .compatibility-info-tab-content.active {
    display: block;
  }

  .compatibility-info-header {
    position: relative;
  }
  .compatibility-info-selected svg {
    color: #979797;
    width: 12px;
    height: 7px;
  }
  .compatibility-info.open .compatibility-info-selected svg {
    transform: rotate(180deg);
  }
  .compatibility-info-header-dropdown-option {
    font-size: 14px;
    line-height: 1.2;
  }
  .compatibility-info {
    display: block;
    max-width: 700px;
  }

  .compatibility-info-tab-content .table {
    margin: 0;
  }
  .compatibility-info-tab-content table {
    border-collapse: collapse;
    width: 100%;
    border: none;
    font-size: 14px;
    color: rgb(50, 50, 58);
    margin: 0;
    margin-bottom: 10px;
    line-height: 1.4;
  }

  .compatibility-info-tab-content th,
  .compatibility-info-tab-content td {
    border: 1px solid rgba(50, 50, 58, 0.6);
    padding: 14px 12px !important;
    text-align: left;
  }

  .compatibility-info-tab-content table,
  .compatibility-info-tab-content table tr:first-child th,
  .compatibility-info-tab-content table tr:first-child td,
  .compatibility-info-tab-content table tr td:first-child,
  .compatibility-info-tab-content table tr th:first-child {
    border-top: none;
    border-left: none;
  }
  .compatibility-info-tab-content table tr:last-child td {
    border-bottom: none;
  }
  .compatibility-info-tab-content table tr td:last-child,
  .compatibility-info-tab-content table tr th:last-child {
    border-right: none;
  }
  .compatibility-info-header {
    margin: 20px 0;
  }
  @media (max-width: 768px) {
    .compatibility-info-tab-content table {
      font-size: 12px;
    }
    .compatibility-info-tab-content th,
    .compatibility-info-tab-content td {
      padding: 6px !important;
    }
  }
</style>
<script>
  document.addEventListener('DOMContentLoaded', function () {
    document.querySelectorAll('.compatibility-info').forEach(function (block) {
      const selected = block.querySelector('.compatibility-info-selected');
      const selectedValue = block.querySelector('.compatibility-info-selected-value');
      const dropdown = block.querySelector('.compatibility-info-header-dropdown');
      const options = dropdown.querySelectorAll('.compatibility-info-header-dropdown-option');
      const contents = block.querySelectorAll('.compatibility-info-tab-content');

      selected.addEventListener('click', () => {
        block.classList.toggle('open');
      });

      options.forEach((option) => {
        option.addEventListener('click', () => {
          const index = option.getAttribute('data-index');

          selectedValue.textContent = option.textContent.trim();

          options.forEach((o) => o.classList.remove('active'));
          option.classList.add('active');

          contents.forEach((c) => {
            c.classList.toggle('active', c.getAttribute('data-index') === index);
          });

          block.classList.remove('open');
        });
      });

      document.addEventListener('click', (e) => {
        if (!block.contains(e.target)) {
          block.classList.remove('open');
        }
      });
    });
  });
</script>

