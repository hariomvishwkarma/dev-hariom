
<div class="collection-list mobile-collection" style="background-color: {{ section.settings.collection_bg_color }}; display:none">
  <div class="container">

    {% if section.settings.section_title != blank %}
      <h2 class="heading" style="color: {{ section.settings.title_color }}">
        {{ section.settings.section_title }}
      </h2>
    {% endif %}

    <div class="custom-collections">
      {% for block in section.blocks %}
        {% assign collection_obj = collections[block.settings.collection] %}
        {% if collection_obj != blank %}
          <div class="custom-collection-item">
            <a href="{{ collection_obj.url }}" style="color: {{ section.settings.collection_color }}">
              {% if collection_obj.metafields.custom.sub_collection_image %}
                            <img src="{{ collection_obj.metafields.custom.sub_collection_image | img_url: '400x' }}" alt="{{ coll.title }}" loading="lazy">
                        {% else %}
                          <img src="/cdn/shop/files/shackbottel_400x.svg" alt="{{ collection_obj.title }}" loading="lazy">
                        {% endif %}
                {% comment %} <img src="/cdn/shop/files/shake_400x.svg?v=1754032452" alt="Müsli" loading="lazy"> {% endcomment %}
              {% comment %} {% if collection_obj.metafields.custom.sub_collection_image %}
                <img src="{{ collection_obj.metafields.custom.sub_collection_image | img_url: '400x' }}" alt="{{ collection_obj.title }}" loading="lazy">
              {% endif %} {% endcomment %}
              {{ collection_obj.title }}
            </a>

            {% comment %}
            REMOVED BY BSO 
            {% if collection_obj.metafields.custom.category_sub_title != blank %}
              <p class="subtitle" style="color: {{ section.settings.subtitle_color }}">
                {{ collection_obj.metafields.custom.category_sub_title }}
                
              </p>
            {% endif %}{% endcomment %}
          </div>
        {% endif %}
      {% endfor %}
    </div>

  </div>
</div>

<style>

</style>

{% schema %}
{
  "name": "Collections Mobile",
  "class":"sub-collection-mobile",
  "settings": [
    {
      "type": "text",
      "id": "section_title",
      "label": "Section title",
      "default": "Our Collections"
    },
    {
      "type": "color",
      "id": "collection_bg_color",
      "label": "Background color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "collection_color",
      "label": "Collection title color",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "title_color",
      "label": "Section title color",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "subtitle_color",
      "label": "Subtitle color",
      "default": "#555555"
    }
  ],
  "blocks": [
    {
      "type": "collection_block",
      "name": "Collection",
      "settings": [
        {
          "type": "collection",
          "id": "collection",
          "label": "Select collection"
        }
      ]
    }
  ],
  "max_blocks": 10,
  "presets": [
    {
      "name": "Collections Mobile",
      "category": "Custom"
    }
  ]
}
{% endschema %}