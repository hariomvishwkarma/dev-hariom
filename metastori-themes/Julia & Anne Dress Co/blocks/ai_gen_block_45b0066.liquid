{% doc %}
  @prompt
    HTML block
{% enddoc %}

{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-html-block-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    padding: {{ block.settings.padding }}px;
    background-color: {{ block.settings.background_color }};
    border-radius: {{ block.settings.border_radius }}px;
  }

  .ai-html-block-content-{{ ai_gen_id }} {
    color: {{ block.settings.text_color }};
  }

  .ai-html-block-content-{{ ai_gen_id }} h1,
  .ai-html-block-content-{{ ai_gen_id }} h2,
  .ai-html-block-content-{{ ai_gen_id }} h3,
  .ai-html-block-content-{{ ai_gen_id }} h4,
  .ai-html-block-content-{{ ai_gen_id }} h5,
  .ai-html-block-content-{{ ai_gen_id }} h6 {
    margin-top: 0;
    margin-bottom: 16px;
  }

  .ai-html-block-content-{{ ai_gen_id }} p {
    margin-top: 0;
    margin-bottom: 16px;
  }

  .ai-html-block-content-{{ ai_gen_id }} ul,
  .ai-html-block-content-{{ ai_gen_id }} ol {
    margin-top: 0;
    margin-bottom: 16px;
    padding-left: 24px;
  }

  .ai-html-block-content-{{ ai_gen_id }} img {
    max-width: 100%;
    height: auto;
  }

  .ai-html-block-content-{{ ai_gen_id }} a {
    color: {{ block.settings.link_color }};
    text-decoration: underline;
  }

  .ai-html-block-content-{{ ai_gen_id }} a:hover {
    opacity: 0.8;
  }

  .ai-html-block-empty-{{ ai_gen_id }} {
    padding: 40px 20px;
    text-align: center;
    background-color: #f4f4f4;
    border-radius: {{ block.settings.border_radius }}px;
    color: #666;
  }
{% endstyle %}

<div class="ai-html-block-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  {% if block.settings.custom_html != blank %}
    <div class="ai-html-block-content-{{ ai_gen_id }}">
      {{ block.settings.custom_html }}
    </div>
  {% else %}
    <div class="ai-html-block-empty-{{ ai_gen_id }}">
      Add your custom HTML content in the block settings
    </div>
  {% endif %}
</div>

{% schema %}
{
  "name": "Custom HTML",
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "html",
      "id": "custom_html",
      "label": "HTML content"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "desktop_width_percent",
      "label": "Desktop width",
      "min": 50,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 100
    },
    {
      "type": "range",
      "id": "padding",
      "label": "Padding",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "default": 20
    },
    {
      "type": "range",
      "id": "border_radius",
      "label": "Border radius",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 0
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "link_color",
      "label": "Link",
      "default": "#000f9f"
    }
  ],
  "presets": [
    {
      "name": "Custom HTML"
    }
  ]
}
{% endschema %}
