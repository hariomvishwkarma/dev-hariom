<script>
(function () {


  function startTimer() {
    const second = 1000,
          minute = second * 60,
          hour   = minute * 60,
          day    = hour * 24;


    const sectionId = "countdown-timer-{{ section.id }}";
    const wrapper   = document.getElementById(sectionId);


    if (!wrapper) return;


    const startDate = "{{ section.settings.start_date }}";
    const startTime = "{{ section.settings.start_time }}";
    const endDate   = "{{ section.settings.end_date }}";  
    const endTime   = "{{ section.settings.end_time }}";  


    if (!endDate || !endTime) return;


    function parseToLocal(dateStr, timeStr) {
      const d = dateStr.split("/");
      const t = timeStr.split(":");


      return new Date(
        parseInt(d[2], 10),  
        parseInt(d[1], 10) - 1,
        parseInt(d[0], 10),        
        parseInt(t[0] || "0", 10),
        parseInt(t[1] || "0", 10),
        0
      );
    }


    const start = (startDate && startTime) ? parseToLocal(startDate, startTime) : null;
    const end   = parseToLocal(endDate, endTime);


    const countDown   = end.getTime();
    const startTimeMs = start ? start.getTime() : null;


    const interval = setInterval(function () {


      const now = Date.now();




      if (startTimeMs && now < startTimeMs) return;


      const distance = countDown - now;


     if (distance < 0) {


        {% if section.settings.hide_on_expire %}
          wrapper.style.display = "none";
        {% else %}
          wrapper.querySelector('#day1-{{ section.id }}').innerText = '000';
          wrapper.querySelector('#hour1-{{ section.id }}').innerText = '00';
          wrapper.querySelector('#minute1-{{ section.id }}').innerText = '00';


          {% unless section.settings.hide_seconds %}
            wrapper.querySelector('#second1-{{ section.id }}').innerText = '00';
          {% endunless %}
        {% endif %}


        clearInterval(interval);
        return;
      }


      const days    = Math.floor(distance / day);
      const hours   = Math.floor((distance % day) / hour);
      const minutes = Math.floor((distance % hour) / minute);
      const seconds = Math.floor((distance % minute) / second);


      const dayStr    = ('00' + days).slice(-3);
      const hourStr   = ('0' + hours).slice(-2);
      const minuteStr = ('0' + minutes).slice(-2);
      const secondStr = ('0' + seconds).slice(-2);


      wrapper.querySelector('#day1-{{ section.id }}').innerText    = dayStr;
      wrapper.querySelector('#hour1-{{ section.id }}').innerText   = hourStr;
      wrapper.querySelector('#minute1-{{ section.id }}').innerText = minuteStr;


      {% unless section.settings.hide_seconds %}
        wrapper.querySelector('#second1-{{ section.id }}').innerText = secondStr;
      {% endunless %}


    }, second);




    document.addEventListener('shopify:section:unload', function (event) {
      if (event.detail.sectionId === sectionId) {
        clearInterval(interval);
      }
    });


  }


  startTimer();


})();




</script>


