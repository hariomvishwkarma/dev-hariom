<div class="s_countdown_banner_{{ section.id }}" id="countdown-banner-{{ section.id }}">
        {% if section.settings.show_close_button %}
         <button class="s_countdown_banner_{{ section.id }}_close" onclick="document.getElementById('countdown-banner-{{ section.id }}').style.display='none';">
            <svg width="16" height="16" viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg">
                <path d="M12 4L4 12M4 4L12 12" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
            </svg>
        </button>
        {% endif %}
        <div class="s_countdown_banner_{{ section.id }}_container">
            <div class="s_countdown_banner_{{ section.id }}_left">
                <h3 class="s_countdown_banner_{{ section.id }}_text">
                    {{ section.settings.head_text | replace:"[h]","<span class='text_highlight'>" | replace:"[/h]","</span>" }}
                </h3>                
            </div>
            {% if section.settings.show_timer == true %}
            <div class="s_countdown_banner_{{ section.id }}_timer_wrapper">
                <div id="countdown-timer-{{ section.id }}" class="s_countdown_banner_{{ section.id }}_timer">
                    <div class="timer_item day_div">
                        <span class="timer_value">
                            <span id="day1-{{ section.id }}">000</span>
                        </span>
                        {% if section.settings.hide_timer_labels == false %}
                        <span class="timer_label">{{ section.settings.day_label }}</span>
                        {% endif %}
                    </div>
                    <span class="timer_separator">:</span>
                    <div class="timer_item hour_div">
                        <span class="timer_value">
                            <span id="hour1-{{ section.id }}">00</span>
                        </span>
                        {% if section.settings.hide_timer_labels == false %}
                        <span class="timer_label">{{ section.settings.hour_label }}</span>
                        {% endif %}
                    </div>
                    <span class="timer_separator">:</span>
                    <div class="timer_item minute_div">
                        <span class="timer_value">
                            <span id="minute1-{{ section.id }}">00</span>
                        </span>
                        {% if section.settings.hide_timer_labels == false %}
                        <span class="timer_label">{{ section.settings.minute_label }}</span>
                        {% endif %}
                    </div>
                    {% if section.settings.hide_seconds == false %}
                    <span class="timer_separator">:</span>
                    <div class="timer_item second_div">
                        <span class="timer_value">
                            <span id="second1-{{ section.id }}">00</span>
                        </span>
                        {% if section.settings.hide_timer_labels == false %}
                        <span class="timer_label">{{ section.settings.second_label }}</span>
                        {% endif %}
                    </div>
                    {% endif %}
                </div>
            </div>
            {% endif %}
            {% if section.settings.show_button %}
            <a href="{{ section.settings.button_link | default: '#' }}" class="s_countdown_banner_{{ section.id }}_button">
                {{ section.settings.button_text }}
            </a>
            {% endif %}
        </div>
    </div>




