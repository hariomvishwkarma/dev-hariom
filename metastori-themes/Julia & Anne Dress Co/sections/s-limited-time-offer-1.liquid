{%- capture s-limited-time-offer -%}
{%- assign sell_limited_time_offer = 's-limited-time-offer' -%}
{%- assign sid = section.id -%}




{%- style -%}
  .{{ sell_limited_time_offer }}--{{ sid }} {
    margin-top: {{ section.settings.margin_top }}px;
    margin-bottom: {{ section.settings.margin_bottom }}px;    
    width: 100%;
  }




  {% for block in section.blocks %}
    .{{ sell_limited_time_offer }}--{{ sid }} .limited-time-main--{{ block.id }} {
        margin-top:0;
      display: flex;
      align-items: center;
      flex-wrap: wrap;
        {% if section.settings.custom_width == 'full_width' %}
                width: 100%;
                    {% elsif section.settings.custom_width == 'max_width' %}
                        width:100%;
                        max-width: {{ section.settings.sec_max_width }}px;
                        {% else %}
                        width:max-content;
                        max-width:100%;        
        {% endif %}  
      {% if block.settings.container_align == 'center' %}
        justify-content: center;
      {% elsif block.settings.container_align == 'right' %}
        justify-content: flex-end;
      {% else %}
        justify-content: flex-start;
      {% endif %}
      justify-self: {{ block.settings.container_align }}
    }
   




  {% endfor %}




  {% for block in section.blocks %}
    .{{ sell_limited_time_offer }}--{{ sid }} .limited-time-item--{{ block.id }} {
      background: {{ block.settings.container_bg }};
      padding: {{ block.settings.padding_top }}px {{ block.settings.padding_right }}px {{ block.settings.padding_bottom }}px {{ block.settings.padding_left }}px;
      border-radius: {{ block.settings.border_radius }}px;
      gap: {{ block.settings.icon_text_gap }}px;
      display: flex;
      align-items: {{ block.settings.align_items }};
      justify-content: {{ block.settings.horizontal_align }};
      margin-top: {{ block.settings.item_margin_top }}px;
      margin-bottom: {{ block.settings.item_margin_bottom }}px;
      border: {{ block.settings.border_width }}px solid {{ block.settings.border_color }};
      width: 100%;      
    }




    .{{ sell_limited_time_offer }}--{{ sid }} .limited-time-item--{{ block.id }} .limited-time-icon {
      width: {{ block.settings.icon_width }}px;
      height: {{ block.settings.icon_height }}px;
      min-width: {{ block.settings.icon_width }}px;
      min-height: {{ block.settings.icon_height }}px;
      max-width: 100%;
      max-height: 100%;
      flex-shrink: 0;
      display: flex;
      align-items: center;
      justify-content: center;
      overflow: hidden;
    }




    .{{ sell_limited_time_offer }}--{{ sid }} .limited-time-item--{{ block.id }} .limited-time-icon img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      max-width: 100%;
      max-height: 100%;
      border-radius: {{ block.settings.icon_text_gap_rad }}px;
    }




    .{{ sell_limited_time_offer }}--{{ sid }} .limited-time-item--{{ block.id }} .limited-time-icon svg {
      width: {{ block.settings.icon_width }}px;
      height: {{ block.settings.icon_height }}px;
    }




    .{{ sell_limited_time_offer }}--{{ sid }} .limited-time-item--{{ block.id }} .limited-time-icon svg path {
      fill: {{ block.settings.icon_color }};
    }




    .{{ sell_limited_time_offer }}--{{ sid }} .limited-time-item--{{ block.id }} .limited-time-text {
        margin-top:0;
      text-transform: {{ block.settings.text_transform }};
      color: {{ block.settings.text_color }};
      font-size: {{ block.settings.text_size }}px;
      line-height: {{ block.settings.text_lineheight }}em;
      letter-spacing: {{ block.settings.text_letter_spacing }}px;
      font-weight: {{ block.settings.text_font_weight }};
      {% if block.settings.horizontal_align == 'center' or block.settings.horizontal_align == 'flex-end' %}
        flex: 0 1 auto;
      {% else %}
        flex: 1;
        width: 100%;
      {% endif %}
    }
   




    @media screen and (max-width: 767px) {
      .{{ sell_limited_time_offer }}--{{ sid }} {
        margin-top: {{ section.settings.margin_top_mob }}px !important;
        margin-bottom: {{ section.settings.margin_bottom_mob }}px !important;
      }




      .{{ sell_limited_time_offer }}--{{ sid }} .limited-time-main--{{ block.id }} {
        {% if block.settings.container_align_mob == 'center' %}
          justify-content: center !important;
        {% elsif block.settings.container_align_mob == 'right' %}
          justify-content: flex-end !important;
        {% else %}
          justify-content: flex-start !important;
        {% endif %}
        justify-self: {{ block.settings.container_align_mob }} !important;
      }




      .{{ sell_limited_time_offer }}--{{ sid }} .limited-time-item--{{ block.id }} {
        padding: {{ block.settings.padding_top_mob }}px {{ block.settings.padding_right_mob }}px {{ block.settings.padding_bottom_mob }}px {{ block.settings.padding_left_mob }}px !important;
        gap: {{ block.settings.icon_text_gap_mob }}px !important;
        align-items: {{ block.settings.align_items_mob }} !important;
        justify-content: {{ block.settings.horizontal_align_mob }} !important;
        border-radius: {{ block.settings.border_radius_mob }}px !important;
        margin-top: {{ block.settings.item_margin_top_mob }}px !important;
        margin-bottom: {{ block.settings.item_margin_bottom_mob }}px !important;
        border-width: {{ block.settings.border_width_mob }}px !important;
        width: 100%;        
      }




      .{{ sell_limited_time_offer }}--{{ sid }} .limited-time-item--{{ block.id }} .limited-time-icon {
        width: {{ block.settings.icon_width_mob }}px !important;
        height: {{ block.settings.icon_height_mob }}px !important;
        min-width: {{ block.settings.icon_width_mob }}px !important;
        min-height: {{ block.settings.icon_height_mob }}px !important;
      }




      .{{ sell_limited_time_offer }}--{{ sid }} .limited-time-item--{{ block.id }} .limited-time-icon svg {
        width: {{ block.settings.icon_width_mob }}px !important;
        height: {{ block.settings.icon_height_mob }}px !important;
      }
.{{ sell_limited_time_offer }}--{{ sid }} .limited-time-item--{{ block.id }} .limited-time-icon img{
    border-radius: {{ block.settings.icon_text_gap_rad_m }}px;
}




      .{{ sell_limited_time_offer }}--{{ sid }} .limited-time-item--{{ block.id }} .limited-time-text {
        font-size: {{ block.settings.text_size_mob }}px !important;
        line-height: {{ block.settings.text_lineheight_mob }}em !important;
        letter-spacing: {{ block.settings.text_letter_spacing_mob }}px !important;
        font-weight: {{ block.settings.text_font_weight_mob }} !important;
        {% if block.settings.horizontal_align_mob == 'center' or block.settings.horizontal_align_mob == 'flex-end' %}
          flex: 0 1 auto !important;
          max-width:max-content;
        {% else %}
          flex: 1 !important;
          width: 100% !important;
        {% endif %}
      }
    }
  {% endfor %}
{%- endstyle -%}




<div class="{{ sell_limited_time_offer }}--{{ sid }}">
  {% for block in section.blocks %}
    <div class="limited-time-main--{{ block.id }}">
      {%- capture limited_time_icon -%}
        <svg class="limited-time_custom_icon" width="800px" height="800px" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
          <path fill-rule="evenodd" clip-rule="evenodd" d="M2.5 12a9.5 9.5 0 1 1 19 0 9.5 9.5 0 0 1-19 0zM12 .5C5.649.5.5 5.649.5 12S5.649 23.5 12 23.5 23.5 18.351 23.5 12 18.351.5 12 .5zM11 7a1 1 0 1 1 2 0v5h4a1 1 0 1 1 0 2h-5a1 1 0 0 1-1-1V7z" fill="{{ block.settings.icon_color }}"/>
        </svg>
      {%- endcapture -%}




      <div class="limited-time-item--{{ block.id }}">
        {% if block.settings.show_icon %}
          <div class="limited-time-icon">
            {% if block.settings.icon_image != blank %}
              <img src="{{ block.settings.icon_image | img_url: 'original' }}" alt="{{ block.settings.icon_image.alt }}" class="limited-time_custom_icon">
            {% else %}
              {{ limited_time_icon }}
            {% endif %}
          </div>
        {% endif %}
        {% if block.settings.text != blank %}
          <span class="limited-time-text">{{ block.settings.text }}</span>
        {% endif %}
      </div>
    </div>
  {% endfor %}
</div>
{%- endcapture -%}




{%- if section.settings.custom_display -%}
  <script>
     document.addEventListener('DOMContentLoaded', function () {
      var placeholder = document.getElementById('s-limited-time-offer');
      if (placeholder && !placeholder.hasAttribute('data-loaded')) {
        placeholder.insertAdjacentHTML('afterbegin', `{{ s-limited-time-offer | strip_newlines | replace: '\"', '\\\"' }}`);
        placeholder.setAttribute('data-loaded', 'true');
      }
    });


  document.addEventListener('click', function () {
     var placeholder = document.getElementById('s-limited-time-offer');
      if (placeholder && !placeholder.hasAttribute('data-loaded')) {
        placeholder.insertAdjacentHTML('afterbegin', `{{ s-limited-time-offer | strip_newlines | replace: '\"', '\\\"' }}`);
        placeholder.setAttribute('data-loaded', 'true');
      }
  });
 
     
 document.addEventListener('variant:change', function () {
   var placeholder = document.getElementById('s-limited-time-offer');
      if (placeholder && !placeholder.hasAttribute('data-loaded')) {
        placeholder.insertAdjacentHTML('afterbegin', `{{ s-limited-time-offer | strip_newlines | replace: '\"', '\\\"' }}`);
        placeholder.setAttribute('data-loaded', 'true');
      }
 });


  </script>
{%- else -%}
  {{ s-limited-time-offer }}
{%- endif -%}




