<!-- sections/s-logo-slider-1.liquid -->
{% assign sid = section.id %}


<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/swiper@9/swiper-bundle.min.css">
<script src="https://cdnjs.cloudflare.com/ajax/libs/Swiper/4.5.0/js/swiper.min.js"></script>


{% comment %} <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/swiper@9/swiper-bundle.min.css">
<script src="https://cdn.jsdelivr.net/npm/swiper@9/swiper-bundle.min.js"></script> {% endcomment %}




<section
  class="s-logo-slider-1 s-logo-slider-1-{{ sid }}">
  <div class="sls1-inner sls1-inner-{{ sid }}">
    <div class="swiper sls1-swiper-{{ sid }} wewew">
      <div class="swiper-wrapper ">


        {%- for block in section.blocks -%}
          {%- if block.type == 'logo' and block.settings.image != blank -%}
            <div class="swiper-slide sls1-slide" {{ block.shopify_attributes }}>
              <img
                src="{{ block.settings.image | image_url: width: 700 }}"
                alt="{{ block.settings.alt | escape }}"
                loading="lazy"
              >
            </div>
          {% else %}
            <div class="swiper-slide sls1-slide logo_placeholder" {{ block.shopify_attributes }}>
              <svg width="800px" height="800px" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                <rect width="24" height="24" fill="none"/>
                <path d="M21 16V20C21 20.5523 20.5523 21 20 21H4C3.44772 21 3 20.5523 3 20V18M21 16V4C21 3.44772 20.5523 3 20 3H4C3.44772 3 3 3.44772 3 4V18M21 16L15.4829 12.3219C15.1843 12.1228 14.8019 12.099 14.4809 12.2595L3 18" stroke="#000000" stroke-linejoin="round"/>
                <circle cx="8" cy="9" r="2" stroke="#000000" stroke-linejoin="round"/>
              </svg>
            </div>
          {%- endif -%}
        {%- endfor -%}


      </div>
    </div>
    {% if section.settings.show_bar == true %}
        <div class="sls1-bar sls1-bar-{{ sid }}">
        {% comment %} <span class="sls1-thumb"></span> {% endcomment %}
        </div>
    {% endif %}


  </div>
</section>


{% style %}
    .s-logo-slider-1-{{ sid }} {
        padding-top:{{  section.settings.padding-block-start }}px;
        padding-bottom:{{  section.settings.padding-block-end }}px;
        padding-left:{{ section.settings.padding-left-start }}px;
        padding-right:{{ section.settings.padding-right-start }}px;
        margin-top:{{  section.settings.margin-block-start }}px;
        margin-bottom:{{  section.settings.margin-block-end }}px;
        background:{{ section.settings.sec_back }};
    }




  /* .s-logo-slider-1-{{ sid }} .sls1-inner-{{ sid }}{
    {% if section.settings.full_width %}
      width: 100vw !important;
      max-width: 100vw !important;
      margin-left: calc(50% - 50vw) !important;
      margin-right: calc(50% - 50vw) !important;
      padding-left: 0 !important;
      padding-right: 0 !important;
    {% else %}
      max-width: {{ section.settings.section_width }}px;
      margin: 0 auto;
    {% endif %}
  } */


  .s-logo-slider-1-{{ sid }} .sls1-inner-{{ sid }}{
        {% if section.settings.info_customwidth == 'full' %}
          max-width: 100%;
        {% else %}
          max-width: {{ section.settings.info_custwidth}}px;
          margin-left: auto;
          margin-right: auto;
        {% endif %}
  }


  .s-logo-slider-1-{{ sid }} .sls1-swiper-{{ sid }}{
    background: {{ section.settings.background_color }};
    border-radius:{{ section.settings.cnt_brd }}px;
    padding:{{ section.settings.cnt_topbottom }}px {{ section.settings.cnt_leftright }}px;
    min-height: 90px;
    display: flex;
    align-items: center;
  }


  .s-logo-slider-1-{{ sid }} .swiper-wrapper{ align-items: center; }
  .s-logo-slider-1-{{ sid }} .swiper-slide{
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .s-logo-slider-1-{{ sid }} .sls1-slide svg,
  .s-logo-slider-1-{{ sid }} .sls1-slide img{
    max-height: {{ section.settings.logo_size }}px;
    opacity: {{ section.settings.logo_opacity | divided_by: 100.0 }};
    object-fit: contain;
    border-radius:{{ section.settings.logo_border_radius }}px;
    max-width: 100%;
  }


  /* Track always light gray */
  .s-logo-slider-1-{{ sid }} .sls1-bar-{{ sid }}{
    width: {{ section.settings.bar_width }}px !important;
    height: {{ section.settings.bar_height }}px !important;
    background: {{section.settings.trackcolor}};
    border-radius: {{ section.settings.bar_height | divided_by: 2 }}px;
    margin: 12px auto 0 auto;
    position: relative;
    overflow: hidden;
  }


  /* Dynamic fill color */
  .s-logo-slider-1-{{ sid }} .swiper-pagination-progressbar-fill {
    background: {{ section.settings.bar_color }} !important;
  }


  /* .s-logo-slider-1-{{ sid }} .sls1-thumb{
    position:absolute;
    top:50%; left:0;
    width: {{ section.settings.thumb_width }}px;
    height: {{ section.settings.thumb_height }}px;
    background: {{ section.settings.thumb_color }};
    border-radius: {{ section.settings.thumb_height | divided_by: 2 }}px;
    transform: translateY(-50%);
  } */
    .s-logo-slider-1-{{ sid }} .swiper-slide {
        width:var(--cuswidt) !important;
        max-width:none !important ;
    }
  @media (max-width: 767px){
     .s-logo-slider-1-{{ sid }} {
        padding-top:{{  section.settings.mob_padding-block-start }}px;
        padding-bottom:{{  section.settings.mob_padding-block-end }}px;
        margin-top:{{  section.settings.mob_margin-block-start }}px;
        margin-bottom:{{  section.settings.mob_margin-block-end }}px;
        padding-left:{{ section.settings.mob_padding-left-start }}px;
        padding-right:{{ section.settings.mob_padding-right-start }}px;
    }


    .s-logo-slider-1-{{ sid }} .sls1-swiper-{{ sid }}{
      padding:{{ section.settings.cnt_topbottom_m }}px {{ section.settings.cnt_leftright_m }}px;
      min-height: 80px;
    }
    .s-logo-slider-1-{{ sid }} .sls1-slide svg,
    .s-logo-slider-1-{{ sid }} .sls1-slide img{
      max-height: {{ section.settings.logo_size_mobile }}px;
    }
    /* .s-logo-slider-1-{{ sid }} .logo_placeholder svg {
      height: 25px !important;
    } */
  }


   
{% endstyle %}


<script>
  var wrapper = document.querySelector(".s-logo-slider-1-{{ sid }} .swiper-wrapper");


  var minSlidesNeeded = 5;
  var current = wrapper.children.length;


  if(current > 0 && current < minSlidesNeeded){
    var i = 0;
    while(wrapper.children.length < minSlidesNeeded){
      var clone = wrapper.children[i % current].cloneNode(true);
      clone.removeAttribute('data-shopify-editor-block');
      wrapper.appendChild(clone);
      i++;
    }
  }


 
  var swiper = new Swiper(".s-logo-slider-1-{{ sid }} .sls1-swiper-{{ sid }}", {
    loop: {{ section.settings.loop }},
    loopAdditionalSlides: {{ section.settings.slider_per_view }},
    observer: true,
    observeParents: true,
    nested: true,
    autoplay: {
      delay: {{ section.settings.slider_speeddely }},
      disableOnInteraction: false
    },
    speed: {{ section.settings.slider_speed }},
    slidesPerView: {{ section.settings.slider_per_view }},
    spaceBetween: {{ section.settings.spacebetween }},
    breakpoints: {
      0: {
        slidesPerView: {{ section.settings.slider_per_view_m }},
        loop: {{ section.settings.loop_m }},  
        loopAdditionalSlides: {{ section.settings.slider_per_view }},
        spaceBetween: {{ section.settings.spacebetween_m }},
        speed: {{ section.settings.slider_speed_m }},
        loopAdditionalSlides: {{ section.settings.slider_per_view_m }},
        autoplay: {
          delay: {{ section.settings.slider_speeddely_m }},
          disableOnInteraction: false
        }
      },
        650: {
        slidesPerView: {{ section.settings.slider_per_view_m }},
        loop: {{ section.settings.loop_m }},
        speed: {{ section.settings.slider_speed_m }},
        loopAdditionalSlides: {{ section.settings.slider_per_view }},
        spaceBetween: {{ section.settings.spacebetween_m }},
        autoplay: {
          delay: {{ section.settings.slider_speeddely_m }},
          disableOnInteraction: false
        }
      }
    },
     pagination: {
      el: ".sls1-bar-{{ sid }}",
      type: "progressbar"
    }  
  });




    function updateCustomWidth() {
        setTimeout(() => {
            let slide = document.querySelector('.sls1-swiper-{{ sid }} .swiper-slide');
            if (slide) {
                let w = parseFloat(slide.style.width);
                if (!isNaN(w)) {
                    document.body.style.setProperty('--cuswidt', w + 'px');
                }
            }
        }, 300);
    }


    updateCustomWidth();
    window.addEventListener('resize', updateCustomWidth);




</script>


