                                            #trusted-video-testimonial-{{ section.id }}   .star-rating-dyn--{{ block.id }} [data-star^="0.6"]::after{width:12%}
                                            #trusted-video-testimonial-{{ section.id }}   .star-rating-dyn--{{ block.id }} [data-star^="0.7"]::after{width:14%}
                                            #trusted-video-testimonial-{{ section.id }}   .star-rating-dyn--{{ block.id }} [data-star^="0.8"]::after{width:16%}
                                            #trusted-video-testimonial-{{ section.id }}   .star-rating-dyn--{{ block.id }} [data-star^="0.9"]::after{width:17%}
                                            #trusted-video-testimonial-{{ section.id }}   .star-rating-dyn--{{ block.id }} [data-star^="1"]::after{width:20%}
                                            #trusted-video-testimonial-{{ section.id }}   .star-rating-dyn--{{ block.id }} [data-star^="1.1"]::after{width:22%}
                                            #trusted-video-testimonial-{{ section.id }}   .star-rating-dyn--{{ block.id }} [data-star^="1.2"]::after{width:24%}
                                            #trusted-video-testimonial-{{ section.id }}   .star-rating-dyn--{{ block.id }} [data-star^="1.3"]::after{width:26%}
                                            #trusted-video-testimonial-{{ section.id }}   .star-rating-dyn--{{ block.id }} [data-star^="1.4"]::after{width:28%}
                                            #trusted-video-testimonial-{{ section.id }}   .star-rating-dyn--{{ block.id }} [data-star^="1.5"]::after{width:30%}
                                            #trusted-video-testimonial-{{ section.id }}    .star-rating-dyn--{{ block.id }} [data-star^="1.6"]::after{width:32%}
                                            #trusted-video-testimonial-{{ section.id }}   .star-rating-dyn--{{ block.id }} [data-star^="1.7"]::after{width:34%}
                                            #trusted-video-testimonial-{{ section.id }}   .star-rating-dyn--{{ block.id }} [data-star^="1.8"]::after{width:36%}
                                            #trusted-video-testimonial-{{ section.id }}   .star-rating-dyn--{{ block.id }} [data-star^="1.9"]::after{width:37%}
                                            #trusted-video-testimonial-{{ section.id }}   .star-rating-dyn--{{ block.id }} [data-star^="2"]::after{width:40%}
                                            #trusted-video-testimonial-{{ section.id }}   .star-rating-dyn--{{ block.id }} [data-star^="2.1"]::after{width:42%}
