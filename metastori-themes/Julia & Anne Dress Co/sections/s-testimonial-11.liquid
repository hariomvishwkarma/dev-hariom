<link rel="stylesheet" type="text/css" href="https://cdn.jsdelivr.net/npm/slick-carousel@1.8.1/slick/slick.css"/>
<link rel="stylesheet" type="text/css" href="https://cdn.jsdelivr.net/npm/slick-carousel@1.8.1/slick/slick-theme.css"/>
<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/slick-carousel@1.8.1/slick/slick.min.js"></script>

<section id="trusted-video-testimonial-{{ section.id }}" class="trust_testimonial-slider-section">
  <div class="containers">
    <div class="custom-section-header">
      {% if section.settings.subheading != blank %}
        <p class="subheading">{{ section.settings.subheading }}</p>
      {% endif %}

      {% if section.settings.heading != blank %}
        <h2 class="heading">
          <span class="heading-accent">{{ section.settings.color_text }}</span> {{ section.settings.heading }}
        </h2>
      {% endif %}
    </div>

    <div class="trust_testimonial-slider{% unless section.settings.center_mode_desktop %} center-mode-off{% endunless %}">
      {% for block in section.blocks %}
        <div class="testimonial-card">
          <div class="testimonial-top testimonial-top--{{ block.id }} {% if block.settings.image == blank and block.settings.video_upload != blank %} cut_test_video_player {% endif %}">
            {% if block.settings.image != blank %}
              <img src="{{ block.settings.image | img_url: 'master' }}" alt="{{ block.settings.name }}" class="avatar">
            {% elsif block.settings.video_upload != blank %}
                 
                 <video
              id="testimonial--video-player-{{ block.id }}"
              class="video-player"
              preload="metadata"
            >
              <source src="{{ block.settings.video_upload.sources[0].url }}" type="video/mp4">
            </video>
            <div class="testimonial-play-btn">
              {% if block.settings.play_icon != blank %}
                <img src="{{ block.settings.play_icon | img_url: 'master' }}" alt="Play icon">
              {% else %}
                <img src="https://img.icons8.com/ios-filled/30/{{ section.settings.Play_text | replace:"#","" }}/play--v1.png" alt="Play icon">
              {% endif %}
            </div>
            <div class="custom_video_polacehoder">              
                {% assign poster = block.settings.video_upload.preview_image | default: section.settings.cover_image %}
                {% assign custposter = block.settings.video_poster  %}
{% if custposter != blank %}
                   {{
            custposter
            | image_url: width: 3840
            | image_tag: sizes: sizes, widths: '375, 750, 1100, 1500, 1780, 2000, 3000, 3840', alt: alt
          }}
        {% else %}
            {{
            poster
            | image_url: width: 3840
            | image_tag: sizes: sizes, widths: '375, 750, 1100, 1500, 1780, 2000, 3000, 3840', alt: alt
          }}
        {% endif %}
            </div>


            {% else %}
              <img src="https://dummyimage.com/400x300/e0e0e0/e0e0e0&text=%20" alt="Placeholder" class="avatar">
            {% endif %}


            {% if block.settings.show_cust_heig %}
            <style>
                
                #trusted-video-testimonial-{{ section.id }} .trust_testimonial-slider .testimonial-top.testimonial-top.testimonial-top--{{ block.id }}{
                    height: {{ block.settings.cust_wi }}px !important;
                }                
                @media (max-width: 767px){
                    #trusted-video-testimonial-{{ section.id }} .trust_testimonial-slider .testimonial-top.testimonial-top.testimonial-top--{{ block.id }}{
                    height: {{ block.settings.cust_wi_m }}px !important;
                }
                }

            </style>
        {% endif %}
          </div>

          <div class="testimonial-content">
          
            <div class="wrap_starimg">
              {% if block.settings.show_stars %}
                
                  <div class="star-rating star-rating-dyn--{{ block.id }}" data-rating="{{ block.settings.rating }}">
                                                  <i data-star="{{block.settings.testmonial_tp_rating }}"></i>
                                            <style> 
                                            #trusted-video-testimonial-{{ section.id }} i[data-star] {
                                                text-align:left;
                                                font-style:normal;
                                                display:inline-block;
                                                position: relative;
                                                unicode-bidi: bidi-override;
                                            }
                
                                            .star-rating-dyn--{{ block.id }} i[data-star]::before,
                                            #trusted-video-testimonial-{{ section.id }} [data-star]::before { 
                                                display:block;
                                                content: '★★★★★';
                                                
                                            }
                                            .star-rating-dyn--{{ block.id }} i[data-star]::before {
                                                color: {{section.settings.empty_star_color}} !important;
                                            }
                                            .star-rating-dyn--{{ block.id }} i[data-star]::after,
                                            #trusted-video-testimonial-{{ section.id }} i[data-star]::after {
                                                white-space:nowrap;
                                                position:absolute;
                                                top:0;
                                                left:0;
                                                content: '★★★★★';
                                                width: 0;
                                                overflow:hidden;
                                                height:100%;
                                            }
                                            .star-rating-dyn--{{ block.id }} i[data-star]::after {
                                                color: {{section.settings.active_star_color}} !important;
                                            }

                                            #trusted-video-testimonial-{{ section.id }} .star-rating-dyn--{{ block.id }} i[data-star]::before,
                                            #trusted-video-testimonial-{{ section.id }} .star-rating-dyn--{{ block.id }} i[data-star]::after  { 
                                                font-size:{{ section.settings.stardesk }}px;
                                                line-height: normal;
                                            }
                                            @media screen and (max-width:767px) {
                                                #trusted-video-testimonial-{{ section.id }} .star-rating-dyn--{{ block.id }} i[data-star]::before,
                                                #trusted-video-testimonial-{{ section.id }} .star-rating-dyn--{{ block.id }} i[data-star]::after  { 
                                                    font-size:{{ section.settings.stardesk_m }}px;
                                                }
                                            }

                                                #trusted-video-testimonial-{{ section.id }} .star-rating-dyn--{{ block.id }} [data-star^="0.1"]::after{width:2%}
                                                #trusted-video-testimonial-{{ section.id }}  .star-rating-dyn--{{ block.id }} [data-star^="0.2"]::after{width:4%}
