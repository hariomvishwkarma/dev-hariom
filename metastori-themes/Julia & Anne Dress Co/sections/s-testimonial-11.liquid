                                            #trusted-video-testimonial-{{ section.id }}    .star-rating-dyn--{{ block.id }} [data-star^="2.5"]::after{width:50%}
                                            #trusted-video-testimonial-{{ section.id }}   .star-rating-dyn--{{ block.id }} [data-star^="2.6"]::after{width:52%}
                                            #trusted-video-testimonial-{{ section.id }}    .star-rating-dyn--{{ block.id }} [data-star^="2.7"]::after{width:54%}
                                            #trusted-video-testimonial-{{ section.id }}    .star-rating-dyn--{{ block.id }} [data-star^="2.8"]::after{width:56%}
                                            #trusted-video-testimonial-{{ section.id }}    .star-rating-dyn--{{ block.id }} [data-star^="2.9"]::after{width:57%}
                                            #trusted-video-testimonial-{{ section.id }}   .star-rating-dyn--{{ block.id }} [data-star^="3"]::after{width:60%}
                                            #trusted-video-testimonial-{{ section.id }}    .star-rating-dyn--{{ block.id }} [data-star^="3.1"]::after{width:62%}
                                            #trusted-video-testimonial-{{ section.id }}    .star-rating-dyn--{{ block.id }} [data-star^="3.2"]::after{width:64%}
                                            #trusted-video-testimonial-{{ section.id }}   .star-rating-dyn--{{ block.id }} [data-star^="3.3"]::after{width:66%}
                                            #trusted-video-testimonial-{{ section.id }}   .star-rating-dyn--{{ block.id }} [data-star^="3.4"]::after{width:68%}
                                            #trusted-video-testimonial-{{ section.id }}    .star-rating-dyn--{{ block.id }} [data-star^="3.5"]::after{width:70%}
                                            #trusted-video-testimonial-{{ section.id }}   .star-rating-dyn--{{ block.id }} [data-star^="3.6"]::after{width:72%}
