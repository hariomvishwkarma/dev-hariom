                                        </style>
                                </div>   
                            {% endif %}

                            
            </div>
            <p class="testimonial-text">{{ block.settings.text }}</p>
              <div class="name-info">
              <h4 class="name">{{ block.settings.name }}</h4>
            </div>
          </div>
        </div>
      {% endfor %}
    </div>
  </div>
</section>


<style>
#trusted-video-testimonial-{{ section.id }} {
  background-color: {{ section.settings.bg_color_desktop | default: '#f7f7f7' }};
  padding-top: {{ section.settings.section_padding_top_desktop | default: 60 }}px;
  padding-bottom: {{ section.settings.section_padding_bottom_desktop | default: 60 }}px;
  padding-left: {{ section.settings.section_padding_left_desktop | default: 0 }}px;
  padding-right: {{ section.settings.section_padding_right_desktop | default: 0 }}px;
  margin-top: {{ section.settings.container_padding_left_desktop  }}px;
  margin-bottom: {{ section.settings.container_padding_right_desktop  }}px;
}

#trusted-video-testimonial-{{ section.id }} .containers {
       {% if section.settings.info_customwidth == 'full_width' %}
    width:100%;
    {% else %}
      width: {{ section.settings.container_width_desktop }}px;
      margin-left: auto;
      margin-right: auto;
  {% endif %}
  {% comment %} padding-left: {{ section.settings.container_padding_left_desktop | default: 0 }}px;
  padding-right: {{ section.settings.container_padding_right_desktop | default: 0 }}px; {% endcomment %}
}

#trusted-video-testimonial-{{ section.id }} .custom-section-header {
  display: unset;
  text-align: {{ section.settings.heading_text_align_desktop | default: 'center' }};
}

#trusted-video-testimonial-{{ section.id }} .custom-section-header h2.heading {
  margin-top: 0;
}

#trusted-video-testimonial-{{ section.id }} .subheading {
  color: {{ section.settings.subheading_color_desktop | default: '#4b6df3' }};
  font-size: {{ section.settings.subheading_font_size_desktop | default: 14 }}px;
  font-weight: {{ section.settings.subheading_font_weight_desktop | default: 500 }};
  line-height: {{ section.settings.subheading_line_height_desktop | default: 1.5 }};
  text-align: {{ section.settings.subheading_text_align_desktop | default: 'center' }};
  letter-spacing: {{ section.settings.subheading_letter_spacing_desktop | default: 1 }}px;
  text-transform: {{ section.settings.subheading_text_transform_desktop | default: 'uppercase' }};
  margin-bottom: {{ section.settings.subheading_margin_bottom_desktop | default: 10 }}px;
  margin-top: 0;
}

#trusted-video-testimonial-{{ section.id }} .heading {
  color: {{ section.settings.heading_color_desktop | default: '#000000' }};
  font-size: {{ section.settings.heading_font_size_desktop | default: 32 }}px;
  font-weight: {{ section.settings.heading_font_weight_desktop | default: 700 }};
  line-height: {{ section.settings.heading_line_height_desktop | default: 1.2 }};
  text-align: {{ section.settings.heading_text_align_desktop | default: 'center' }};
  letter-spacing: {{ section.settings.heading_letter_spacing_desktop | default: 0 }}px;
  text-transform: {{ section.settings.heading_text_transform_desktop | default: 'none' }};
  margin-bottom: {{ section.settings.heading_margin_bottom_desktop | default: 40 }}px;
  margin-top: 0;
}

#trusted-video-testimonial-{{ section.id }} .heading-accent {
  color: {{ section.settings.heading_accent_color | default: '#D19942' }};
}

#trusted-video-testimonial-{{ section.id }} .trust_testimonial-slider {
  margin-top: {{ section.settings.slider_space_top_desktop | default: 40 }}px;
  position: relative;
}

/* Hide cards until slick initializes */
#trusted-video-testimonial-{{ section.id }} .trust_testimonial-slider:not(.slick-initialized) .testimonial-card {
  display: none !important;
}

#trusted-video-testimonial-{{ section.id }} .trust_testimonial-slider:not(.slick-initialized) .testimonial-card:first-child {
  display: flex !important;
}

#trusted-video-testimonial-{{ section.id }} .trust_testimonial-slider .slick-list {
  position: relative;
  display: block;
  overflow: hidden;
  margin: 0;
  padding: 0;
  width: 100%;
}

#trusted-video-testimonial-{{ section.id }} .trust_testimonial-slider .slick-track {
  position: relative;
  top: 0;
  left: 0;
  display: block;
  margin-left: auto;
  margin-right: auto;
  padding-bottom: 10px;
}

#trusted-video-testimonial-{{ section.id }} .trust_testimonial-slider .slick-slide {
  float: left;
  height: 100%;
  min-height: 1px;
  box-sizing: border-box;
  margin: 0 {{ section.settings.slide_gap_desktop | default: 15 }}px !important;
}

{% if section.settings.center_mode_desktop %}
#trusted-video-testimonial-{{ section.id }} .trust_testimonial-slider .slick-list {
  padding: 0 {{ section.settings.center_padding_desktop | default: 60 }}px;
}
{% else %}
#trusted-video-testimonial-{{ section.id }} .containers {
  overflow: hidden;
}



#trusted-video-testimonial-{{ section.id }} .trust_testimonial-slider.center-mode-off .slick-list {
  padding: 0 !important;
  margin: 0 !important;
}

#trusted-video-testimonial-{{ section.id }} .trust_testimonial-slider.center-mode-off .slick-track {
  margin-left: 0 !important;
  margin-right: 0 !important;
}
{% endif %}

#trusted-video-testimonial-{{ section.id }} .trust_testimonial-slider .testimonial-card {
  background-color: {{ section.settings.card_bg_color | default: '#ffffff' }};
  color: {{ section.settings.text_color | default: '#555555' }};
  border-radius: {{ section.settings.card_border_radius_desktop | default: 16 }}px;
  padding: 0;
  box-shadow: {{ section.settings.box_shadow_left_desktop | default: 0 }}px {{ section.settings.box_shadow_right_desktop | default: 3 }}px {{ section.settings.box_shadow_blur_desktop | default: 10 }}px {{ section.settings.box_shadow_spread_desktop | default: 0 }}px {{ section.settings.box_shadow_color | default: '#0000001a' }};
  transition: all 0.3s ease;
  min-height: {{ section.settings.card_height_desktop | default: 400 }}px;
  height: 100%;
  max-height: 100%;
  display: flex;
  flex-direction: column;
  overflow: hidden;
  box-sizing: border-box;
  outline: none;
  margin: 0 auto;
  {% if section.settings.card_max_width_desktop %}
  max-width: {{ section.settings.card_max_width_desktop }}px;
  {% endif %}
}

#trusted-video-testimonial-{{ section.id }} .trust_testimonial-slider .testimonial-top {
  display: block;
  padding-top: 0;
  flex-shrink: 0;
  position: relative;
}
#trusted-video-testimonial-{{ section.id }} .trust_testimonial-slider .testimonial-card .testimonial-play-btn{
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    background: {{section.settings.play_bg}};
    color: #ffffff;
    width: {{section.settings.icon_size_d}}px;
    height: {{section.settings.icon_size_d}}px;
    border-radius: 50px;
    border: 0px solid rgba(0, 0, 0, 0);
    opacity: 1.0;
    display: flex;
    justify-content: center;
    align-items: center;
    font-size: 24px;
    transition: 0.3s ease;
    cursor: pointer;
    z-index: 2;
}
#trusted-video-testimonial-{{ section.id }} .trust_testimonial-slider .testimonial-card .testimonial-play-btn img {
    width: {{section.settings.pla}}px;
    height: {{section.settings.pla}}px;
    display: block;
    object-fit: contain;
    opacity: 1;
}

#trusted-video-testimonial-{{ section.id }} .trust_testimonial-slider .testimonial-card .custom_video_polacehoder{
      position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
}


#trusted-video-testimonial-{{ section.id }} .trust_testimonial-slider .testimonial-card .custom_video_polacehoder img,
#trusted-video-testimonial-{{ section.id }} .trust_testimonial-slider .testimonial-card video{
    width: 100%;
                    height: 100%;
                    display: block;
                    object-fit: cover;
                    border-radius: {{ section.settings.card_border_radius_desktop | default: 16 }}px;
}

#trusted-video-testimonial-{{ section.id }} .trust_testimonial-slider .testimonial-card .avatar {
  width: 100%;
  height: 100%;
  border-radius: 0;
  border-radius: {{ section.settings.card_border_radius_desktop | default: 16 }}px;
  object-fit: cover;
  display: block;
}
#trusted-video-testimonial-{{ section.id }} .trust_testimonial-slider .testimonial-card  {
    padding: {{ section.settings.card_padding_desktop | default: 20 }}px {{ section.settings.card_padding_desktop_r | default: 20 }}px {{ section.settings.card_padding_desktop_b | default: 20 }}px {{ section.settings.card_padding_desktop_l | default: 20 }}px;
}
#trusted-video-testimonial-{{ section.id }} .trust_testimonial-slider .testimonial-content {
  text-align: {{ section.settings.card_text_align_desktop | default: 'center' }};
  {% comment %} padding: {{ section.settings.card_padding_desktop | default: 20 }}px {{ section.settings.card_padding_desktop_r | default: 20 }}px {{ section.settings.card_padding_desktop_b | default: 20 }}px {{ section.settings.card_padding_desktop_l | default: 20 }}px; {% endcomment %}
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: center;
}



#trusted-video-testimonial-{{ section.id }} .trust_testimonial-slider .name-info .name {
  color: {{ section.settings.name_color | default: '#000000' }};
  font-size: {{ section.settings.name_font_size_desktop | default: 16 }}px;
  font-weight: {{ section.settings.name_font_weight_desktop | default: 600 }};
  line-height: {{ section.settings.name_line_height_desktop | default: 1.4 }};
  text-align: {{ section.settings.name_text_align_desktop | default: 'center' }};
  letter-spacing: {{ section.settings.name_letter_spacing_desktop | default: 0 }}px;
  text-transform: {{ section.settings.name_text_transform_desktop | default: 'none' }};
  margin: 0 0 {{ section.settings.name_margin_bottom_desktop | default: 5 }}px 0;
}

#trusted-video-testimonial-{{ section.id }} .trust_testimonial-slider .wrap_starimg {
  padding-top: {{ section.settings.name_margin_bottom_desktop | default: 5 }}px;
  text-align: center;
}

#trusted-video-testimonial-{{ section.id }} .trust_testimonial-slider .wrap_starimg .starimg {
  max-width: {{ section.settings.star_image_size_desktop | default: 80 }}px;
  width: 100%;
  display: block;
  margin: 0 auto;
  object-fit: cover;
}

#trusted-video-testimonial-{{ section.id }} .trust_testimonial-slider .star-rating {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 2px;
  font-size: {{ section.settings.star_image_size_desktop | default: 80 | divided_by: 5 }}px;
}

#trusted-video-testimonial-{{ section.id }} .trust_testimonial-slider .star-rating .star {
