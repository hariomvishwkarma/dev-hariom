                                            #trusted-video-testimonial-{{ section.id }}    .star-rating-dyn--{{ block.id }} [data-star^="4"]::after{width:80%}
                                            #trusted-video-testimonial-{{ section.id }}    .star-rating-dyn--{{ block.id }} [data-star^="4.1"]::after{width:82%}
                                            #trusted-video-testimonial-{{ section.id }}    .star-rating-dyn--{{ block.id }} [data-star^="4.2"]::after{width:84%}
                                            #trusted-video-testimonial-{{ section.id }}    .star-rating-dyn--{{ block.id }} [data-star^="4.3"]::after{width:86%}
                                            #trusted-video-testimonial-{{ section.id }}   .star-rating-dyn--{{ block.id }} [data-star^="4.4"]::after{width:88%}
                                            #trusted-video-testimonial-{{ section.id }}    .star-rating-dyn--{{ block.id }} [data-star^="4.5"]::after{width:90%}
