<script>
(function() {
  function waitForJQuery(callback, maxAttempts) {
    var attempts = 0;
    function check() {
      attempts++;
      if (typeof jQuery !== 'undefined' && typeof jQuery.fn.slick !== 'undefined') {
        callback();
      } else if (attempts < maxAttempts) {
        setTimeout(check, 100);
      } else {
        console.error('jQuery or Slick not loaded after', maxAttempts, 'attempts');
      }
    }
    check();
  }

  function initSlider() {
    var $slider = jQuery('#trusted-video-testimonial-{{ section.id }} .trust_testimonial-slider');

    if ($slider.length === 0) {
      console.error('Slider element not found');
      return;
    }

    // Destroy if already initialized
    if ($slider.hasClass('slick-initialized')) {
      try {
        $slider.slick('unslick');
      } catch (e) {
        $slider.removeClass('slick-initialized');
        $slider.find('.slick-list, .slick-track').remove();
      }
    }

    /*----------------------------------------------
      Create Arrow HTML (Correct Way)
    ----------------------------------------------*/
    var prevArrowHtml = '';
    var nextArrowHtml = '';

    {% if section.settings.arrow_prev_image %}
      prevArrowHtml =
        '<img src="{{ section.settings.arrow_prev_image | img_url: "master" }}" alt="prev" class="slick-arrow-img">';
    {% else %}
      prevArrowHtml =
        '<svg xmlns="http://www.w3.org/2000/svg" width="{{ section.settings.arrow_size_desktop | default: 36 }}" height="{{ section.settings.arrow_size_desktop | default: 36 }}" viewBox="-19.04 0 75.803 75.803"><g transform="translate(-624.082 -383.588)"><path d="M660.313,383.588a1.5,1.5,0,0,1,1.06,2.561l-33.556,33.56a2.528,2.528,0,0,0,0,3.564l33.556,33.558a1.5,1.5,0,0,1-2.121,2.121L625.7,425.394a5.527,5.527,0,0,1,0-7.807l33.556-33.559A1.5,1.5,0,0,1,660.313,383.588Z" fill="{{ section.settings.slider_arrow_color | default: '#000000' }}"/></g></svg>';
    {% endif %}

    {% if section.settings.arrow_next_image %}
      nextArrowHtml =
        '<img src="{{ section.settings.arrow_next_image | img_url: "master" }}" alt="next" class="slick-arrow-img">';
    {% else %}
      nextArrowHtml =
        '<svg xmlns="http://www.w3.org/2000/svg" width="{{ section.settings.arrow_size_desktop | default: 36 }}" height="{{ section.settings.arrow_size_desktop | default: 36 }}" viewBox="-19.04 0 75.804 75.804"><g transform="translate(-831.568 -384.448)"><path d="M833.068,460.252a1.5,1.5,0,0,1-1.061-2.561l33.557-33.56a2.53,2.53,0,0,0,0-3.564l-33.557-33.558a1.5,1.5,0,0,1,2.122-2.121l33.556,33.558a5.53,5.53,0,0,1,0,7.807l-33.557,33.56A1.5,1.5,0,0,1,833.068,460.252Z" fill="{{ section.settings.slider_arrow_color | default: '#000000' }}"/></g></svg>';
    {% endif %}

    // Slick expects HTML strings
    var prevArrow = '<button type="button" class="slick-prev">' + prevArrowHtml + '</button>';
    var nextArrow = '<button type="button" class="slick-next">' + nextArrowHtml + '</button>';

    /*----------------------------------------------
      Slider Settings
    ----------------------------------------------*/
    var desktopSettings = {
      slidesToShow: {{ section.settings.slides_to_show_desktop | default: 3 }},
      slidesToScroll: 1,
      arrows: true,
      touchThreshold: 500,
      dots: true,
      autoplay: {{ section.settings.autoplay_desktop | json }},
      autoplaySpeed: {{ section.settings.autoplay_speed_desktop | default: 3000 }},
      infinite: {{ section.settings.infinite_desktop | json }},
      centerMode: {{ section.settings.center_mode_desktop | json }},
      centerPadding: {{ section.settings.center_mode_desktop | json }}
        ? '{{ section.settings.center_padding_desktop | default: 60 }}px'
        : '0px',
      speed: 500,
      cssEase: 'ease',
      adaptiveHeight: false,
      fade: false,
      swipe: true,
      touchMove: true,
      variableWidth: false,
      edgeFriction: 0,
      pauseOnHover: true,
      pauseOnFocus: true,
      prevArrow: prevArrow,
      nextArrow: nextArrow,

      responsive: [
        {
          breakpoint: 1024,
          settings: {
            slidesToShow: 2
          }
        },
        {
          breakpoint: 768,
          settings: {
            slidesToShow: {{ section.settings.slides_to_show_mobile | default: 1 }},
            slidesToScroll: 1,
            arrows: true,
            dots: true,
            autoplay: {{ section.settings.autoplay_mobile | json }},
            autoplaySpeed: {{ section.settings.autoplay_speed_mobile | default: 3000 }},
            infinite: {{ section.settings.infinite_mobile | json }},
            centerMode: {{ section.settings.center_mode_mobile | json }},
            centerPadding: {{ section.settings.center_mode_mobile | json }}
              ? '{{ section.settings.center_padding_mobile | default: 20 }}px'
              : '0px',
            variableWidth: false,
            edgeFriction: 0,
            pauseOnHover: true,
            pauseOnFocus: true,
            prevArrow: prevArrow,
            nextArrow: nextArrow
          }
        }
      ]
    };

    /*----------------------------------------------
      Initialize Slider
    ----------------------------------------------*/
    try {
      $slider.slick(desktopSettings);
      console.log("Slider initialized for section {{ section.id }}");

      setTimeout(() => $slider.slick('setPosition'), 200);

    } catch (e) {
      console.error('Slick init error:', e);
    }
  }

  /*----------------------------------------------
    Run when DOM ready
  ----------------------------------------------*/
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', function() {
      waitForJQuery(initSlider, 50);
    });
  } else {
    waitForJQuery(initSlider, 50);
  }

  /*----------------------------------------------
    Shopify Theme Editor Reload
  ----------------------------------------------*/
  let reloadTimer;
  document.addEventListener('shopify:section:load', function(event) {
    if (event.detail && event.detail.sectionId === '{{ section.id }}') {
      clearTimeout(reloadTimer);
      reloadTimer = setTimeout(function() {
        waitForJQuery(initSlider, 50);
      }, 200);
    }
  });

})();



$(document).ready(function () {

  $("#trusted-video-testimonial-{{ section.id }} .cut_test_video_player").on("click", function (e) {
    e.preventDefault();
    e.stopPropagation();

    const $wrapper = $(this);
    const video = $wrapper.find("video").get(0);
    const $playBtn = $wrapper.find(".testimonial-play-btn");
    const $placeholder = $wrapper.find(".custom_video_polacehoder");

    // Stop all other videos
    $("#trusted-video-testimonial-{{ section.id }} .cut_test_video_player video").each(function () {
      if (this !== video) {
        this.pause();
        this.currentTime = 0;
        $(this).removeAttr("controls");
        $(this).closest("#trusted-video-testimonial-{{ section.id }} .cut_test_video_player")
               .find(".testimonial-play-btn")
               .show();
      }
    });

    // Toggle play / pause
    if (video.paused) {
      video.play();
      $(video).attr("controls", "controls");
      $playBtn.hide();
      $placeholder.hide();
    } else {
      video.pause();
      $(video).removeAttr("controls");
      $playBtn.show();
      $placeholder.show();
    }

  });

});


</script>




