<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.css" />
<script src="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.js"></script>




<section id="slider-testimonial-{{ section.id }}" class="wraptestimonial-slider">
  <div class="slider-containers">
    {% if section.settings.heading != blank %}
      <h2 class="testimonial-heading">{{ section.settings.heading }}</h2>
    {% endif %}




    <div class="swiper testimonialSwiper">
      <div class="swiper-wrapper">
        {% for block in section.blocks %}
          <div class="swiper-slide testimonial-item">
            <div class="testimonial-wrapcard">
              {% if block.settings.image %}
                <img src="{{ block.settings.image | img_url: '600x' }}" alt="{{ block.settings.name }}" class="testimonial-image">
              {% else %}
                <img src="https://dummyimage.com/600x400/e0e0e0/e0e0e0&text=%20" alt="Placeholder" class="testimonial-image">
              {% endif %}
              <div class="testimonial-content">
                <div class="wrap_starimg">
                  {% if block.settings.show_stars %}
                   
                      <div class="star-rating star-rating-dyn--{{ block.id }}" data-rating="{{ block.settings.rating }}">
                        {% comment %} {% assign rating_num = block.settings.rating | times: 1.0 %}
                        {% assign full_stars = rating_num | floor %}
                        {% assign decimal_part = rating_num | modulo: 1.0 %}
                        {% assign has_half = false %}
                        {% if decimal_part >= 0.25 and decimal_part < 0.75 %}
                          {% assign has_half = true %}
                        {% elsif decimal_part >= 0.75 %}
                          {% assign full_stars = full_stars | plus: 1 %}
                        {% endif %}
                        {% assign total_displayed = full_stars %}
                        {% if has_half %}
                          {% assign total_displayed = total_displayed | plus: 1 %}
                        {% endif %}
                        {% assign empty_stars = 5 | minus: total_displayed %}
                       
                        {% for i in (1..full_stars) %}
                          <span class="star star-full">★</span>
                        {% endfor %}
                       
                        {% if has_half %}
                          <span class="star star-half">★</span>
                        {% endif %}
                       
                        {% for i in (1..empty_stars) %}
                          <span class="star star-empty">★</span>
                        {% endfor %} {% endcomment %}
                         <i data-star="{{block.settings.testmonial_tp_rating }}"></i>
                            <style>
                            #slider-testimonial-{{ section.id }} i[data-star] {
                                text-align:left;
                                font-style:normal;
                                display:inline-block;
                                position: relative;
                                unicode-bidi: bidi-override;
                            }
 
                            .star-rating-dyn--{{ block.id }} i[data-star]::before,
                            #slider-testimonial-{{ section.id }} [data-star]::before {
                                display:block;
                                content: '★★★★★';
                               
                            }
                            .star-rating-dyn--{{ block.id }} i[data-star]::before {
                                color: {{section.settings.empty_star_color}} !important;
                            }
                            .star-rating-dyn--{{ block.id }} i[data-star]::after,
                            #slider-testimonial-{{ section.id }} i[data-star]::after {
                                white-space:nowrap;
                                position:absolute;
                                top:0;
                                left:0;
                                content: '★★★★★';
                                width: 0;
                                overflow:hidden;
                                height:100%;
                            }
                            .star-rating-dyn--{{ block.id }} i[data-star]::after {
                                color: {{section.settings.active_star_color}} !important;
                            }




                            #slider-testimonial-{{ section.id }} .star-rating-dyn--{{ block.id }} i[data-star]::before,
                            #slider-testimonial-{{ section.id }} .star-rating-dyn--{{ block.id }} i[data-star]::after  {
                                font-size:{{ section.settings.stardesk }}px;
                                line-height: normal;
                            }
                            @media screen and (max-width:767px) {
                                #slider-testimonial-{{ section.id }} .star-rating-dyn--{{ block.id }} i[data-star]::before,
                                #slider-testimonial-{{ section.id }} .star-rating-dyn--{{ block.id }} i[data-star]::after  {
                                    font-size:{{ section.settings.stardesk_m }}px;
                                }
                            }




                                #slider-testimonial-{{ section.id }} .star-rating-dyn--{{ block.id }} [data-star^="0.1"]::after{width:2%}
                                #slider-testimonial-{{ section.id }}  .star-rating-dyn--{{ block.id }} [data-star^="0.2"]::after{width:4%}
                                #slider-testimonial-{{ section.id }}  .star-rating-dyn--{{ block.id }} [data-star^="0.3"]::after{width:6%}
                               #slider-testimonial-{{ section.id }}  .star-rating-dyn--{{ block.id }} [data-star^="0.4"]::after{width:8%}
                               #slider-testimonial-{{ section.id }}  .star-rating-dyn--{{ block.id }} [data-star^="0.5"]::after{width:10%}
                               #slider-testimonial-{{ section.id }}   .star-rating-dyn--{{ block.id }} [data-star^="0.6"]::after{width:12%}
                               #slider-testimonial-{{ section.id }}   .star-rating-dyn--{{ block.id }} [data-star^="0.7"]::after{width:14%}
                               #slider-testimonial-{{ section.id }}   .star-rating-dyn--{{ block.id }} [data-star^="0.8"]::after{width:16%}
                               #slider-testimonial-{{ section.id }}   .star-rating-dyn--{{ block.id }} [data-star^="0.9"]::after{width:17%}
                               #slider-testimonial-{{ section.id }}   .star-rating-dyn--{{ block.id }} [data-star^="1"]::after{width:20%}
                               #slider-testimonial-{{ section.id }}   .star-rating-dyn--{{ block.id }} [data-star^="1.1"]::after{width:22%}
                               #slider-testimonial-{{ section.id }}   .star-rating-dyn--{{ block.id }} [data-star^="1.2"]::after{width:24%}
                               #slider-testimonial-{{ section.id }}   .star-rating-dyn--{{ block.id }} [data-star^="1.3"]::after{width:26%}
                               #slider-testimonial-{{ section.id }}   .star-rating-dyn--{{ block.id }} [data-star^="1.4"]::after{width:28%}
                               #slider-testimonial-{{ section.id }}   .star-rating-dyn--{{ block.id }} [data-star^="1.5"]::after{width:30%}
                              #slider-testimonial-{{ section.id }}    .star-rating-dyn--{{ block.id }} [data-star^="1.6"]::after{width:32%}
                               #slider-testimonial-{{ section.id }}   .star-rating-dyn--{{ block.id }} [data-star^="1.7"]::after{width:34%}
                               #slider-testimonial-{{ section.id }}   .star-rating-dyn--{{ block.id }} [data-star^="1.8"]::after{width:36%}
                               #slider-testimonial-{{ section.id }}   .star-rating-dyn--{{ block.id }} [data-star^="1.9"]::after{width:37%}
                               #slider-testimonial-{{ section.id }}   .star-rating-dyn--{{ block.id }} [data-star^="2"]::after{width:40%}
                               #slider-testimonial-{{ section.id }}   .star-rating-dyn--{{ block.id }} [data-star^="2.1"]::after{width:42%}
                               #slider-testimonial-{{ section.id }}   .star-rating-dyn--{{ block.id }} [data-star^="2.2"]::after{width:44%}
                               #slider-testimonial-{{ section.id }}   .star-rating-dyn--{{ block.id }} [data-star^="2.3"]::after{width:46%}
                              #slider-testimonial-{{ section.id }}    .star-rating-dyn--{{ block.id }} [data-star^="2.4"]::after{width:48%}
                              #slider-testimonial-{{ section.id }}    .star-rating-dyn--{{ block.id }} [data-star^="2.5"]::after{width:50%}
                               #slider-testimonial-{{ section.id }}   .star-rating-dyn--{{ block.id }} [data-star^="2.6"]::after{width:52%}
                              #slider-testimonial-{{ section.id }}    .star-rating-dyn--{{ block.id }} [data-star^="2.7"]::after{width:54%}
                              #slider-testimonial-{{ section.id }}    .star-rating-dyn--{{ block.id }} [data-star^="2.8"]::after{width:56%}
                              #slider-testimonial-{{ section.id }}    .star-rating-dyn--{{ block.id }} [data-star^="2.9"]::after{width:57%}
                               #slider-testimonial-{{ section.id }}   .star-rating-dyn--{{ block.id }} [data-star^="3"]::after{width:60%}
                              #slider-testimonial-{{ section.id }}    .star-rating-dyn--{{ block.id }} [data-star^="3.1"]::after{width:62%}
                              #slider-testimonial-{{ section.id }}    .star-rating-dyn--{{ block.id }} [data-star^="3.2"]::after{width:64%}
                               #slider-testimonial-{{ section.id }}   .star-rating-dyn--{{ block.id }} [data-star^="3.3"]::after{width:66%}
                               #slider-testimonial-{{ section.id }}   .star-rating-dyn--{{ block.id }} [data-star^="3.4"]::after{width:68%}
                              #slider-testimonial-{{ section.id }}    .star-rating-dyn--{{ block.id }} [data-star^="3.5"]::after{width:70%}
                               #slider-testimonial-{{ section.id }}   .star-rating-dyn--{{ block.id }} [data-star^="3.6"]::after{width:72%}
                              #slider-testimonial-{{ section.id }}    .star-rating-dyn--{{ block.id }} [data-star^="3.7"]::after{width:74%}
                               #slider-testimonial-{{ section.id }}   .star-rating-dyn--{{ block.id }} [data-star^="3.8"]::after{width:76%}
                              #slider-testimonial-{{ section.id }}    .star-rating-dyn--{{ block.id }} [data-star^="3.9"]::after{width:77%}
                              #slider-testimonial-{{ section.id }}    .star-rating-dyn--{{ block.id }} [data-star^="4"]::after{width:80%}
                              #slider-testimonial-{{ section.id }}    .star-rating-dyn--{{ block.id }} [data-star^="4.1"]::after{width:82%}
                              #slider-testimonial-{{ section.id }}    .star-rating-dyn--{{ block.id }} [data-star^="4.2"]::after{width:84%}
                              #slider-testimonial-{{ section.id }}    .star-rating-dyn--{{ block.id }} [data-star^="4.3"]::after{width:86%}
                               #slider-testimonial-{{ section.id }}   .star-rating-dyn--{{ block.id }} [data-star^="4.4"]::after{width:88%}
                              #slider-testimonial-{{ section.id }}    .star-rating-dyn--{{ block.id }} [data-star^="4.5"]::after{width:90%}
                              #slider-testimonial-{{ section.id }}    .star-rating-dyn--{{ block.id }} [data-star^="4.6"]::after{width:92%}
                              #slider-testimonial-{{ section.id }}    .star-rating-dyn--{{ block.id }} [data-star^="4.7"]::after{width:94%}
                              #slider-testimonial-{{ section.id }}    .star-rating-dyn--{{ block.id }} [data-star^="4.8"]::after{width:96%}
                              #slider-testimonial-{{ section.id }}    .star-rating-dyn--{{ block.id }} [data-star^="4.9"]::after{width:97%}
                              #slider-testimonial-{{ section.id }}    .star-rating-dyn--{{ block.id }} [data-star^="5"]::after{width:100%}
                        </style>
                        {% if block.settings.show_nm %}<span class="rating-value">{{ block.settings.testmonial_tp_rating }}</span> {% endif %}
                      </div>                    
                  {% endif %}
                </div>
                <p class="testimonial-text">{{ block.settings.text }}</p>
                <p class="testimonial-name">— {{ block.settings.name }}</p>
              </div>
            </div>
          </div>
        {% endfor %}
      </div>




      <!-- Slider Controls -->
      <div class="swiper-pagination"></div>
      <div class="prev-next-icon">
        <div class="swiper-button-prev">
          {% if section.settings.previmage %}
            <img src="{{ section.settings.previmage | img_url: 'master' }}" alt="prev-icon" class="icon">
          {% else %}
            <svg xmlns="http://www.w3.org/2000/svg" width="{{ section.settings.arrow_size_mobile | default: 30 }}" height="{{ section.settings.arrow_size_mobile | default: 30 }}" viewBox="-19.04 0 75.803 75.803">
                <g id="Group_64" data-name="Group 64" transform="translate(-624.082 -383.588)">
                    <path id="Path_56" data-name="Path 56" d="M660.313,383.588a1.5,1.5,0,0,1,1.06,2.561l-33.556,33.56a2.528,2.528,0,0,0,0,3.564l33.556,33.558a1.5,1.5,0,0,1-2.121,2.121L625.7,425.394a5.527,5.527,0,0,1,0-7.807l33.556-33.559A1.5,1.5,0,0,1,660.313,383.588Z" fill="#fff"/>
                </g>
            </svg>
          {% endif %}
        </div>
        <div class="swiper-button-next">
          {% if section.settings.nextimage %}
            <img src="{{ section.settings.nextimage | img_url: 'master' }}" alt="next-icon" class="icon">
          {% else %}
            <svg xmlns="http://www.w3.org/2000/svg" width="{{ section.settings.arrow_size_mobile | default: 30 }}" height="{{ section.settings.arrow_size_mobile | default: 30 }}" viewBox="-19.04 0 75.804 75.804">
                <g id="Group_65" data-name="Group 65" transform="translate(-831.568 -384.448)">
                    <path id="Path_57" data-name="Path 57" d="M833.068,460.252a1.5,1.5,0,0,1-1.061-2.561l33.557-33.56a2.53,2.53,0,0,0,0-3.564l-33.557-33.558a1.5,1.5,0,0,1,2.122-2.121l33.556,33.558a5.53,5.53,0,0,1,0,7.807l-33.557,33.56A1.5,1.5,0,0,1,833.068,460.252Z" fill="#fff"/>
                </g>
            </svg>
          {% endif %}
        </div>
      </div>
    </div>
  </div>
</section>




<style>
#slider-testimonial-{{ section.id }} {
  background-color: {{ section.settings.bg_color_desktop | default: '#f9f6f2' }};
  padding-top: {{ section.settings.section_padding_top_desktop | default: 60 }}px;
  padding-bottom: {{ section.settings.section_padding_bottom_desktop | default: 60 }}px;
  padding-left: {{ section.settings.section_padding_left_desktop | default: 0 }}px;
  padding-right: {{ section.settings.section_padding_right_desktop | default: 0 }}px;
  position: relative;
  margin-top: {{ section.settings.container_padding_left_desktop  }}px;
  margin-bottom: {{ section.settings.container_padding_right_desktop  }}px;
}




#slider-testimonial-{{ section.id }} .slider-containers {
    {% if section.settings.info_customwidth == 'full_width' %}
    width:100%;
    {% else %}
      max-width:{{ section.settings.container_width_desktop }}px;
      margin-left: auto;
      margin-right: auto;
  {% endif %}
  {% comment %} padding-left: {{ section.settings.container_padding_left_desktop | default: 0 }}px;
  padding-right: {{ section.settings.container_padding_right_desktop | default: 0 }}px; {% endcomment %}
}




#slider-testimonial-{{ section.id }} .testimonial-heading {
  color: {{ section.settings.heading_color_desktop | default: '#000000' }};
  font-size: {{ section.settings.heading_font_size_desktop | default: 28 }}px;
  font-weight: {{ section.settings.heading_font_weight_desktop | default: 700 }};
  line-height: {{ section.settings.heading_line_height_desktop | default: 1.2 }};
  text-align: {{ section.settings.heading_text_align_desktop | default: 'center' }};
  letter-spacing: {{ section.settings.heading_letter_spacing_desktop | default: 0 }}px;
  text-transform: {{ section.settings.heading_text_transform_desktop | default: 'none' }};
  margin-top: 0;
  margin-bottom: {{ section.settings.heading_margin_bottom_desktop | default: 40 }}px;
}




#slider-testimonial-{{ section.id }} .swiper {
  overflow: hidden;
  position: relative;
}




#slider-testimonial-{{ section.id }} .swiper-slide {
  display: flex;
  justify-content: center;
}




#slider-testimonial-{{ section.id }} .testimonial-wrapcard {
  position: relative;
  background: {{ section.settings.card_bg | default: '#ffffff' }};
  border-radius: {{ section.settings.card_radius_desktop | default: 10 }}px;
  overflow: hidden;
  margin: 0 {{ section.settings.card_margin_desktop | default: 10 }}px;
  width: 100%;
  height: {{ section.settings.card_height_desktop | default: 400 }}px;
  display: flex;
  flex-direction: column;
}




#slider-testimonial-{{ section.id }} .testimonial-image {
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
  flex-shrink: 0;
  max-width: 100%;
}




#slider-testimonial-{{ section.id }} .testimonial-content {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  padding: {{ section.settings.card_padding_desktop | default: 20 }}px;
  text-align: {{ section.settings.text_text_align_desktop | default: 'left' }};
  {% comment %} background: linear-gradient(to top, rgba(0,0,0,0.7), transparent); {% endcomment %}
}




#slider-testimonial-{{ section.id }} .wrap_starimg {
  margin-bottom: {{ section.settings.star-bottom-sps }}px;
}




#slider-testimonial-{{ section.id }} .starimg {
  max-width: {{ section.settings.star_image_size_desktop | default: 80 }}px;
  width: 100%;
  display: block;
  object-fit: cover;
}




#slider-testimonial-{{ section.id }} .star-rating {
  display: flex;
  align-items: center;
  gap: 2px;
  font-size: {{ section.settings.star_image_size_desktop | default: 80 | divided_by: 5 }}px;
  line-height: 1;
}




#slider-testimonial-{{ section.id }} .star-rating .star {
  display: inline-block;
  position: relative;
  width: 1em;
  height: 1em;
  line-height: 1;
}




#slider-testimonial-{{ section.id }} .star-rating .star-full {
  color: #ffc107;
}




#slider-testimonial-{{ section.id }} .star-rating .star-half {
  color: #e0e0e0;
}




#slider-testimonial-{{ section.id }} .star-rating .star-half::before {
  content: '★';
  position: absolute;
  left: 0;
  top: 0;
  width: 50%;
  height: 100%;
  overflow: hidden;
  color: #ffc107;
  display: block;
}




#slider-testimonial-{{ section.id }} .star-rating .star-empty {
  color: #e0e0e0;
}




#slider-testimonial-{{ section.id }} .star-rating .rating-value {
  margin-left: 8px;
  font-size: {{ section.settings.star_image_size_desktop | default: 80 | divided_by: 6 }}px;
  font-weight: 600;
  color: {{ section.settings.text_color | default: '#333333' }};
}




#slider-testimonial-{{ section.id }} .testimonial-text {
    margin-top: 0;
    margin-bottom: {{ section.settings.text_margin_bottom_desktop | default: 15 }}px;
  color: {{ section.settings.text_color | default: '#333333' }};
  font-size: {{ section.settings.text_font_size_desktop | default: 14 }}px;
  font-weight: {{ section.settings.text_font_weight_desktop | default: 400 }};
  line-height: {{ section.settings.text_line_height_desktop | default: 1.6 }};
  text-align: {{ section.settings.text_text_align_desktop | default: 'left' }};
  letter-spacing: {{ section.settings.text_letter_spacing_desktop | default: 0 }}px;
  text-transform: {{ section.settings.text_text_transform_desktop | default: 'none' }};
 
}




#slider-testimonial-{{ section.id }} .testimonial-name {
    margin: 0;
  color: {{ section.settings.name_color | default: '#000000' }};
  font-size: {{ section.settings.name_font_size_desktop | default: 14 }}px;
  font-weight: {{ section.settings.name_font_weight_desktop | default: 600 }};
  line-height: {{ section.settings.name_line_height_desktop | default: 1.4 }};
  text-align: {{ section.settings.name_text_align_desktop | default: 'left' }};
  letter-spacing: {{ section.settings.name_letter_spacing_desktop | default: 0 }}px;
  text-transform: {{ section.settings.name_text_transform_desktop | default: 'none' }};  
}




#slider-testimonial-{{ section.id }} .swiper-pagination {
  display: {% if section.settings.show_pagination_desktop %}block{% else %}none{% endif %} !important;
}




#slider-testimonial-{{ section.id }} .swiper-pagination-bullet {
  background: transparent;
  border: 1px solid {{ section.settings.pagination_color  }};
}




#slider-testimonial-{{ section.id }} .swiper-pagination-bullet.swiper-pagination-bullet-active {
  background: {{ section.settings.pagination_color  }};
}




#slider-testimonial-{{ section.id }} .testimonialSwiper {
  padding-bottom: {{ section.settings.bottom-sps  }}px;
}




#slider-testimonial-{{ section.id }} .swiper-pagination.swiper-pagination-clickable {
  bottom: 0px;
}




#slider-testimonial-{{ section.id }} .swiper-button-prev,
#slider-testimonial-{{ section.id }} .swiper-button-next {
  display: {% if section.settings.show_arrows_desktop %}flex{% else %}none{% endif %};
  bottom: 0px !important;
  top: auto;
  background: {{ section.settings.arrow_bg_color | default: '#000000' }};
  height: {{ section.settings.arrow_size_desktop | default: 30 }}px;
  width: {{ section.settings.arrow_size_desktop | default: 30 }}px;
  text-align: center;
  border-radius: 50px;
  padding: 4px;
  margin-top: 0;
}




#slider-testimonial-{{ section.id }} .swiper-button-prev:after,
#slider-testimonial-{{ section.id }} .swiper-button-next:after {
  display: none;
}




#slider-testimonial-{{ section.id }} .swiper-button-prev .icon,
#slider-testimonial-{{ section.id }} .swiper-button-next .icon {
  width: 100%;
  height: 100%;
  object-fit: contain;
}
#slider-testimonial-{{ section.id }} .swiper-button-prev svg,
#slider-testimonial-{{ section.id }} .swiper-button-next svg{
    padding:5px;
    vertical-align: unset !important;
}








#slider-testimonial-{{ section.id }} .testimonial-item:not(.is-selected){
    opacity: 1;
    visibility: visible;
}




@media screen and (min-width: 1000px) {
  #slider-testimonial-{{ section.id }} .prev-next-icon {
    position: relative;
    width: 20%;
    margin: 0px auto;
    top: {{section.settings.bottom-sps}}px;
  }
}




@media only screen and (min-width: 280px) and (max-width: 767px) {
  #slider-testimonial-{{ section.id }} {
    padding-top: {{ section.settings.section_padding_top_mobile | default: 40 }}px;
    padding-bottom: {{ section.settings.section_padding_bottom_mobile | default: 40 }}px;
    padding-left: {{ section.settings.section_padding_left_mobile | default: 0 }}px;
    padding-right: {{ section.settings.section_padding_right_mobile | default: 0 }}px;
    margin-top: {{ section.settings.container_padding_left_mobile  }}px;
  margin-bottom: {{ section.settings.container_padding_right_mobile  }}px
  }




  {% comment %} #slider-testimonial-{{ section.id }} .slider-containers {
    padding-left: {{ section.settings.container_padding_left_mobile | default: 20 }}px;
    padding-right: {{ section.settings.container_padding_right_mobile | default: 20 }}px;
  } {% endcomment %}




  #slider-testimonial-{{ section.id }} .testimonial-heading {
    font-size: {{ section.settings.heading_font_size_mobile | default: 24 }}px !important;
    font-weight: {{ section.settings.heading_font_weight_mobile | default: 700 }} !important;
    line-height: {{ section.settings.heading_line_height_mobile | default: 1.2 }} !important;
    text-align: {{ section.settings.heading_text_align_mobile | default: 'center' }} !important;
    letter-spacing: {{ section.settings.heading_letter_spacing_mobile | default: 0 }}px !important;
    text-transform: {{ section.settings.heading_text_transform_mobile | default: 'none' }} !important;
    margin-bottom: {{ section.settings.heading_margin_bottom_mobile | default: 30 }}px !important;
    padding: 0px 10px;
  }




  #slider-testimonial-{{ section.id }} .testimonial-wrapcard {
    border-radius: {{ section.settings.card_radius_mobile | default: 10 }}px;
    margin: 0 {{ section.settings.card_margin_mobile | default: 5 }}px;
    height: {{ section.settings.card_height_mobile | default: 350 }}px !important;
  }




  #slider-testimonial-{{ section.id }} .swiper-pagination {
    display: {% if section.settings.show_pagination_mobile %}block{% else %}none{% endif %} !important;
  }




  #slider-testimonial-{{ section.id }} .swiper-button-prev,
