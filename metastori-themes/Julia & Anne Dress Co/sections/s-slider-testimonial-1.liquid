<script>


  function initSwiper() {
    var swiper = new Swiper("#slider-testimonial-{{ section.id }} .testimonialSwiper", {        
      loop: {{ section.settings.infinite }},
      rewind: {{ section.settings.infinite }},
      slidesPerGroup: 1,
      pagination: {
        el: "#slider-testimonial-{{ section.id }} .swiper-pagination",
        clickable: true
      },
      navigation: {
        nextEl: "#slider-testimonial-{{ section.id }} .swiper-button-next",
        prevEl: "#slider-testimonial-{{ section.id }} .swiper-button-prev"
      },
      slidesPerView: {{ section.settings.slides_per_view_mobile | default: 1 }},
      spaceBetween: {{ section.settings.space_between_mobile | default: 15 }},
      autoplay: {% if section.settings.autoplay_mobile %}{
        delay: {{ section.settings.autoplay_delay_mobile | default: 3000 }},
        disableOnInteraction: false
      }{% else %}false{% endif %},
      breakpoints: {
        768: {
          slidesPerView: {{ section.settings.slides_per_view_mobile | default: 1 }},
          spaceBetween: {{ section.settings.space_between_mobile | default: 15 }}          
        },
        1024: {
          slidesPerView: {{ section.settings.slides_per_view_desktop | default: 3 }},
          spaceBetween: {{ section.settings.space_between_desktop | default: 20 }},
          autoplay: {% if section.settings.autoplay_desktop %}{
            delay: {{ section.settings.autoplay_delay_desktop | default: 3000 }},
            disableOnInteraction: false
          }{% else %}false{% endif %}
        }
      }
    });
    return swiper;
  }
 
  var swiper = initSwiper();




  // Re-initialize on section load (for Shopify theme editor)
  document.addEventListener('shopify:section:load', function(event) {
    if (event.detail && event.detail.sectionId === '{{ section.id }}') {
      setTimeout(function() {
        if (swiper) {
          swiper.destroy(true, true);
        }
        swiper = initSwiper();
      }, 100);
    }
  });


</script>












