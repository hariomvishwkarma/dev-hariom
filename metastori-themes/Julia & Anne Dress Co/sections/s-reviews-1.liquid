{%- if section.settings.custom_display -%}
<script>
    document.addEventListener('DOMContentLoaded', function () {
      var placeholder = document.getElementById('s-stars-1');
      if (placeholder && !placeholder.hasAttribute('data-stars-loaded')) {
        placeholder.insertAdjacentHTML('afterbegin', `{{ s-stars-1 | strip_newlines | replace: '\"', '\\\"' }}`);
        placeholder.setAttribute('data-stars-loaded', 'true');
        const stars = placeholder.querySelectorAll('.star-svg');
        let rating = {{ section.settings.tp_rating }};
        let remainder = 0;
        if(rating % 1 !== 0) {
          remainder = 1.0 - (rating % 1);
          rating = Math.floor(rating);
        }
        if(rating < 5) {
          stars.forEach((star, index) => {
            if(index >= rating) {
              const starWidth = star.width.baseVal.value;
              const starIndicator = star.querySelector('.star-indicator');
              if(starIndicator) {
                if(index === rating && remainder > 0) {
                  starIndicator.style.transform = `translateX(${(starWidth * remainder) * -1}px)`;
                } else {
                  starIndicator.style.transform = `translateX(${starWidth * -1}px)`;
                }
              }
            }
          });
        }
      }
    });
  </script>
{%- else -%}
  {{ s-stars-1 }}
  <script>
    (function(){
      const stars = document.querySelectorAll('.selluxe-stars-1 .star-svg');
      let rating = {{ section.settings.tp_rating }};
      let remainder = 0;
      if(rating % 1 !== 0) {
        remainder = 1.0 - (rating % 1);
        rating = Math.floor(rating);
      }
      if(rating < 5) {
        stars.forEach((star, index) => {
          if(index >= rating) {
            const starWidth = star.width.baseVal.value;
            const starIndicator = star.querySelector('.star-indicator');
            if(starIndicator) {
              if(index === rating && remainder > 0) {
                starIndicator.style.transform = `translateX(${(starWidth * remainder) * -1}px)`;
              } else {
                starIndicator.style.transform = `translateX(${starWidth * -1}px)`;
              }
            }
          }
        });
      }
    })();
  </script>
{%- endif -%}






<style>
.sec_{{ section.id }} {
    padding-top:{{ section.settings.padding_y }}px;
    padding-bottom:{{ section.settings.padding_b }}px;
    padding-left:{{ section.settings.padding_x }}px;
    padding-right:{{ section.settings.padding_xr }}px;


    {% comment %} margin-left:{{ section.settings.margin_left }}px;
    margin-right:{{ section.settings.margin_right }}px; {% endcomment %}
    margin-top: {{ section.settings.margin_top }}px;
    margin-bottom: {{ section.settings.margin_bottom }}px;
    background:{{ section.settings.block_background_color }};
    border-radius:{{ section.settings.block_radius }}px;
                  {% if section.settings.custom_width == 'full_width' %}
                             width: 100%;
                      {% elsif section.settings.custom_width == 'custom-width' %}
                          width:100%;
                         max-width:{{ section.settings.sec_mx_width }}px;
                     {% else %}
                            width:max-content;
                            max-width:100%;            
                {% endif %}




          {%  if section.settings.cont_align  == 'end' %}
            margin-left:auto;
            margin-right:unset;
          {% elsif section.settings.cont_align  == 'center' %}
            margin-left:auto;
            margin-right:auto;
          {% else %}
            margin-left:unset;
            margin-right:auto;
          {% endif %}
   
}




 .sec_{{ section.id }} .reviews_stars {
    display: flex;
    {% comment %} flex-wrap:wrap; {% endcomment %}
    gap: {{ section.settings.gapdesk}}px;
    align-items: center;
    text-decoration: none;
    color: #000000;
    {% comment %} display: inline-block;
    vertical-align: middle; {% endcomment %}
    {% if section.settings.desk_align == 'center' %}
      justify-content:center;
      text-align:center;
    {% elsif section.settings.desk_align == 'right' %}
      justify-content:right;
      text-align:right;
    {% else %}
      justify-content:left;
      text-align:left;
    {% endif %}
  }
  .sec_{{ section.id }} .reviews_stars .stars {
    display: flex;
    gap: 1px;
    {% comment %} display: inline;
    vertical-align: middle; {% endcomment %}




  }
  {% comment %} .sec_{{ section.id }} .reviews_stars .stars svg {
    display: inherit;
    vertical-align: inherit;
  } {% endcomment %}
  {% comment %} .sec_{{ section.id }} .reviews_stars .ratings {
    display: contents;
    vertical-align: middle;
  } {% endcomment %}
  .sec_{{ section.id }} .reviews_stars .ratings {
    margin:0;
    line-height: normal;
  }
  .sec_{{ section.id }} .reviews_stars .ratings span {
    white-space: unset;
    text-transform: {{ section.settings.text-case }};
    font-size: {{ section.settings.font_size_desktop }}px;
    line-height:{{ section.settings.line_hight_desktop }}px;
    letter-spacing:{{ section.settings.heading_ltrspc }}px;
    font-weight:{{ section.settings.heading-desk-font-weight }};
    color:{{ section.settings.text_color }};
    {% comment %} display:inherit;
    vertical-align:inherit; {% endcomment %}
  }
  .sec_{{ section.id }} .star-svg {
    height:{{ section.settings.star_size }}px;
    width:auto;
  }
  @media(max-width: 767px) {
    .sec_{{ section.id }} {
        padding-top:{{ section.settings.padding_y_m }}px;
        padding-bottom:{{ section.settings.padding_b_m }}px;
        padding-left:{{ section.settings.padding_x_m }}px;
         padding-right:{{ section.settings.padding_xr_m }}px;
        {% comment %}margin-left:{{ section.settings.margin_left_m }}px; {% endcomment %}
        max-width:calc(100% - ({{ section.settings.margin_left_m }}px * 2 ));
        margin-top: {{ section.settings.margin_top_m }}px;
        margin-bottom: {{ section.settings.margin_bottom_m }}px;
        border-radius:{{ section.settings.block_radius_m }}px;
    }
    .sec_{{ section.id }} .reviews_stars .ratings span {
      font-size: {{ section.settings.font_size_mobile }}px;
      line-height:{{ section.settings.line_hight_mobile }}px;
      letter-spacing:{{ section.settings.heading_ltrspc_m }}px;
    font-weight:{{ section.settings.heading-desk-font-weight_m }};
    }
    .sec_{{ section.id }} .star-svg {
        height:{{ section.settings.star_size_mobile }}px;
        width:auto;
    }
    .sec_{{ section.id }} .reviews_stars {
      gap: {{ section.settings.gapdesk_mob}}px;
      {% if section.settings.mob_align == 'center' %}
        justify-content:center;
        text-align:center;
      {% elsif section.settings.mob_align == 'right' %}
        justify-content:right;
        text-align:right;
      {% else %}
        justify-content:left;
        text-align:left;
      {% endif %}
    }
  }
</style>








