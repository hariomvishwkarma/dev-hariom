                {% assign rating = section.settings.tp_rating %}




                <svg class="star-svg section_{{ section.id }}_star-svg"
                      version="1.2"
                      xmlns="http://www.w3.org/2000/svg"
                      viewBox="0 0 512 96"




                      width="auto"
                      height="{{ section.settings.star_rating_size }}">




                      <style>
                          .section_{{ section.id }}_star-svg .s0 { fill: {{ section.settings.trustpilot_color }} !important; }  
                          .section_{{ section.id }}_star-svg .s1 { fill: {{ section.settings.trustpilot_disable_color }} !important; }
                          .section_{{ section.id }}_star-svg .s2 { fill: {{ section.settings.trustpilot_star_active_color }} !important; }
                      </style>




                      {% assign rating_float = rating %}
                      {% assign full_stars = rating_float | floor %}
                      {% assign fractional_part = rating_float | minus: full_stars %}
                      {% assign next_star = full_stars | plus: 1 %}




                      <g id="Trustpilot_rating">




                      {% for i in (1..5) %}
                          {% assign pos = i | minus: 1 %}
                          <g transform="translate({{ pos | times: 104 }}, 0)">




                              {% if i <= full_stars %}
                                  <!-- FULL STAR -->
                                  <rect width="96" height="96" class="s0"/>




                              {% elsif i == next_star and fractional_part > 0 %}
                                  <!-- FRACTIONAL STAR -->
                                  {% assign fill_width = 96 | times: fractional_part %}




                                  <rect x="0" y="0" width="{{ fill_width }}" height="96" class="s0"/>
                                  <rect x="{{ fill_width }}" y="0" width="{{ 96 | minus: fill_width }}" height="96" class="s1"/>




                              {% else %}
                                  <!-- EMPTY STAR -->
                                  <rect width="96" height="96" class="s1"/>
                              {% endif %}




                              <path class="s2" d="m48 64.7l14.6-3.7 6.1 18.8zm33.6-24.3h-25.7l-7.9-24.2-7.9 24.2h-25.7l20.8 15-7.9 24.2 20.8-15 12.8-9.2z"/>
                          </g>
                      {% endfor %}




                      </g>
                  </svg>
