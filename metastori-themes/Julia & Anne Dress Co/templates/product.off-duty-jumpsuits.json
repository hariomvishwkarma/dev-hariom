        "custom_C3bJiq": {
          "type": "custom",
          "settings": {
            "code": "<style>\n  @import url('https://fonts.googleapis.com/css2?family=Montserrat:wght@400;500;600&display=swap');\n\n  .info-row {\n    display: flex;\n    align-items: center;\n    font-family: 'Montserrat', sans-serif;\n    font-size: 14px;\n    font-weight: 400;\n    line-height: 1;\n    margin-bottom: 0;\n  }\n\n  .icon-wrap {\n    width: 18px;\n    display: flex;\n    justify-content: center;\n    align-items: center;\n    margin-right: 8px;\n    flex-shrink: 0;\n  }\n\n  .low-stock {\n    color: #e00000;\n  }\n\n  .low-stock-dot {\n    width: 8px;\n    height: 8px;\n    background-color: #e00000;\n    border-radius: 50%;\n    animation: slowBlink 2.5s infinite;\n  }\n\n  @keyframes slowBlink {\n    0% { opacity: 1; }\n    50% { opacity: 0.25; }\n    100% { opacity: 1; }\n  }\n</style>\n\n<div class=\"info-row low-stock\">\n  <span class=\"icon-wrap\">\n    <span class=\"low-stock-dot\"></span>\n  </span>\n  <span id=\"dynamic-stock-text\">Only 4 items left in stock!</span>\n</div>\n\n<script>\n  document.addEventListener(\"DOMContentLoaded\", function () {\n    const stockText = document.getElementById(\"dynamic-stock-text\");\n    if (!stockText) return;\n\n    const stockMap = {\n      \"S\": 4,\n      \"M\": 7,\n      \"L\": 5,\n      \"XL\": 3,\n      \"2XL\": 4,\n      \"3XL\": 3,\n      \"4XL\": 6,\n      \"5XL\": 5\n    };\n\n    function cleanText(text) {\n      return (text || \"\").replace(/\\s+/g, \" \").trim().toUpperCase();\n    }\n\n    function normalizeSize(text) {\n      const value = cleanText(text);\n\n      const replacements = {\n        \"SMALL\": \"S\",\n        \"MEDIUM\": \"M\",\n        \"LARGE\": \"L\",\n        \"X LARGE\": \"XL\",\n        \"X-LARGE\": \"XL\",\n        \"XXL\": \"2XL\",\n        \"2X\": \"2XL\",\n        \"XXXL\": \"3XL\",\n        \"3X\": \"3XL\",\n        \"4X\": \"4XL\",\n        \"5X\": \"5XL\"\n      };\n\n      return replacements[value] || value;\n    }\n\n    function isValidSize(size) {\n      return Object.keys(stockMap).includes(size);\n    }\n\n    function getSelectedSize() {\n      const checkedRadios = document.querySelectorAll('input[type=\"radio\"]:checked');\n\n      for (const radio of checkedRadios) {\n        let size = normalizeSize(radio.value);\n        if (isValidSize(size)) return size;\n\n        if (radio.id) {\n          const label = document.querySelector(`label[for=\"${radio.id}\"]`);\n          size = normalizeSize(label ? label.textContent : \"\");\n          if (isValidSize(size)) return size;\n        }\n      }\n\n      const allLabels = document.querySelectorAll(\"label\");\n      for (const label of allLabels) {\n        const parent = label.closest(\".is-selected, .selected, .swatch-element\");\n        if (parent && (parent.classList.contains(\"is-selected\") || parent.classList.contains(\"selected\"))) {\n          const size = normalizeSize(label.textContent);\n          if (isValidSize(size)) return size;\n        }\n      }\n\n      const selects = document.querySelectorAll(\"select\");\n      for (const select of selects) {\n        const size = normalizeSize(select.value);\n        if (isValidSize(size)) return size;\n      }\n\n      return \"S\";\n    }\n\n    function updateStockText() {\n      const selectedSize = getSelectedSize();\n      const stock = stockMap[selectedSize] || 4;\n      stockText.textContent = \"Only \" + stock + \" items left in stock!\";\n    }\n\n    document.addEventListener(\"change\", function () {\n      setTimeout(updateStockText, 50);\n    });\n\n    document.addEventListener(\"click\", function () {\n      setTimeout(updateStockText, 50);\n    });\n\n    updateStockText();\n  });\n</script>"
          }
        },
