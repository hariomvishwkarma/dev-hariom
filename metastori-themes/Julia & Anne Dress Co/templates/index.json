    "faq_9hCF4G": {
      "type": "faq",
      "blocks": {
        "question_xcmWDH": {
          "type": "question",
          "settings": {
            "title": "Do you offer free shipping?",
            "text": "<p>At Julia & Anne, every order is carefully tracked from the moment it leaves our warehouse. We always provide a secure tracking number and, today only, shipping is free on all orders.</p>"
          }
        },
        "question_RQqJRU": {
          "type": "question",
          "settings": {
            "title": "Can I return items if I don’t like them?",
            "text": "<p>If something isn’t quite right, our team is here to help. You may return your order within 30 days in accordance with our return policy, and we’ll assist you in finding the best solution.</p>"
          }
        },
        "question_kFjeay": {
          "type": "question",
          "settings": {
            "title": "How can I track my order?",
            "text": "<p>You can track your order by entering the tracking number we sent you on our Track Your Order page. Once you enter the code and click Track, you’ll be able to see the shipping status in real time.</p>"
          }
        },
        "question_gJyrPk": {
          "type": "question",
          "settings": {
            "title": "What payment methods do you accept?",
            "text": "<p>We accept all major payment methods, including credit and debit cards (Visa, Mastercard, American Express), PayPal, and express checkout options such as Apple Pay, Shop Pay, and Google Pay, ensuring a simple, fast, and secure checkout experience.</p>"
          }
        },
        "question_hNyUkB": {
          "type": "question",
          "settings": {
            "title": "Will I receive a confirmation email after placing my order?",
            "text": "<p>Yes. After completing your order, you’ll receive a confirmation email in your inbox. If you don’t see it, feel free to contact us at support@juliaandanne.com<br/>, and our customer service team will be happy to help.</p>"
          }
        },
        "question_C3k98b": {
          "type": "question",
          "settings": {
            "title": "What if the item doesn’t look the same in person?",
            "text": "<p>We photograph our pieces to reflect their true color, fit, and texture as accurately as possible. If something doesn’t meet your expectations when it arrives, our team is here to help and returns are accepted within 30 days.</p>"
          }
        },
        "question_Th6CRW": {
          "type": "question",
          "settings": {
            "title": "Who can I contact if I need help after ordering?",
            "text": "<p>You’ll always be able to reach a real person. Our customer support team is available to assist you before and after your purchase, and every message is personally handled. Go to the contact page on our website and we'll help you as soon as possible!</p>"
          }
        }
      },
