    "testimonials_CUpLEi": {
      "type": "testimonials",
      "blocks": {
        "testimonial_CyVwTY": {
          "type": "testimonial",
          "settings": {
            "icon": "5-stars",
            "testimonial": "<p>Ho ordinato un abito per una cena in famiglia e alla fine l’ho indossato tutto il giorno. Comodo, valorizzante e non dovevo sistemarlo di continuo. Questo dice già tutto.</p>",
            "author": "Giulia",
            "author_info": "Milano"
          }
        },
        "testimonial_MLAka3": {
          "type": "testimonial",
          "settings": {
            "icon": "4-stars",
            "testimonial": "<p>\"Il servizio clienti è stato gentile e paziente quando avevo dubbi sulla taglia. Nessuna pressione, solo aiuto sincero. Oggi è raro trovare un’attenzione così.\"</p>",
            "author": "Francesca",
            "author_info": "Roma"
          }
        },
        "testimonial_kcVmbb": {
          "type": "testimonial",
          "settings": {
            "icon": "5-stars",
            "testimonial": "<p>\"Di solito non lascio recensioni, ma Velmari Milano è diversa. Si percepisce la cura dietro al brand. Dal packaging alla vestibilità, tutto è pensato nei minimi dettagli.\"</p>",
            "author": "Martina",
            "author_info": "Firenze"
          }
        },
        "testimonial_9dUFjB": {
          "type": "testimonial",
          "settings": {
            "icon": "5-stars",
            "testimonial": "<p>\"Ho acquistato una delle giacche e sono tornata subito a prenderla anche in un altro colore. Morbida, calda e veste benissimo senza stringere.\"</p>",
            "author": "Alessandra",
            "author_info": "Torino"
          }
        },
        "testimonial_ijiyFj": {
          "type": "testimonial",
          "settings": {
            "icon": "5-stars",
            "testimonial": "<p>\"Quello che amo di più di Velmari è la storia che c’è dietro. Sapere che è un progetto di madre e figlia lo rende più personale. Senti che stai sostenendo persone vere, non una grande azienda anonima.\"</p>",
            "author": "Chiara",
            "author_info": "Bologna"
          }
        }
      },
