          "settings": {
            "custom_html": "<link href=\"https://fonts.googleapis.com/css2?family=Montserrat:wght@400;500;600;700;800&amp;display=swap\" rel=\"stylesheet\">\n\n<style>\n  .urgency-update-box {\n    background: #f8d7da;\n    color: #111111;\n    font-family: 'Montserrat', sans-serif;\n    text-align: center;\n    padding: 16px 14px;\n    border-radius: 10px;\n    margin: 16px 0;\n  }\n\n  .urgency-update-box .urgency-text {\n    font-size: 14px;\n    font-weight: 500;\n    line-height: 1.5;\n    max-width: 650px;\n    margin: 0 auto 12px;\n  }\n\n  .urgency-update-box .urgency-text strong {\n    display: block;\n    font-size: 17px;\n    font-weight: 800;\n    margin-bottom: 6px;\n    letter-spacing: 0.3px;\n  }\n\n  .urgency-timer {\n    display: inline-flex;\n    align-items: center;\n    justify-content: center;\n    gap: 8px;\n    flex-wrap: wrap;\n  }\n\n  .urgency-time-block {\n    min-width: 60px;\n    background: rgba(255, 255, 255, 0.5);\n    border-radius: 7px;\n    padding: 8px 6px;\n  }\n\n  .urgency-time-number {\n    display: block;\n    font-size: 20px;\n    font-weight: 700;\n    line-height: 1;\n  }\n\n  .urgency-time-label {\n    display: block;\n    font-size: 10px;\n    font-weight: 500;\n    text-transform: uppercase;\n    letter-spacing: 0.6px;\n    margin-top: 4px;\n  }\n</style>\n\n<div class=\"urgency-update-box\">\n  <div class=\"urgency-text\">\n    <strong>⚠ Important Update</strong>\n    Due to very high demand during our easter sale, all discounted prices will return to their original level once the timer runs out.\n  </div>\n\n  <div class=\"urgency-timer\" id=\"urgency-timer\">\n    <div class=\"urgency-time-block\">\n      <span class=\"urgency-time-number\" id=\"urgency-hours\">04</span>\n      <span class=\"urgency-time-label\">Hours</span>\n    </div>\n    <div class=\"urgency-time-block\">\n      <span class=\"urgency-time-number\" id=\"urgency-minutes\">42</span>\n      <span class=\"urgency-time-label\">Minutes</span>\n    </div>\n    <div class=\"urgency-time-block\">\n      <span class=\"urgency-time-number\" id=\"urgency-seconds\">23</span>\n      <span class=\"urgency-time-label\">Seconds</span>\n    </div>\n  </div>\n</div>\n\n<script>\n  (function () {\n    const initialDuration = (4 * 60 * 60) + (42 * 60) + 23;\n    let remaining = initialDuration;\n\n    const hoursEl = document.getElementById('urgency-hours');\n    const minutesEl = document.getElementById('urgency-minutes');\n    const secondsEl = document.getElementById('urgency-seconds');\n\n    function format(value) {\n      return value.toString().padStart(2, '0');\n    }\n\n    function updateTimer() {\n      const hours = Math.floor(remaining / 3600);\n      const minutes = Math.floor((remaining % 3600) / 60);\n      const seconds = remaining % 60;\n\n      hoursEl.textContent = format(hours);\n      minutesEl.textContent = format(minutes);\n      secondsEl.textContent = format(seconds);\n\n      remaining--;\n\n      if (remaining < 0) {\n        remaining = initialDuration;\n      }\n    }\n\n    updateTimer();\n    setInterval(updateTimer, 1000);\n  })();\n</script>",
