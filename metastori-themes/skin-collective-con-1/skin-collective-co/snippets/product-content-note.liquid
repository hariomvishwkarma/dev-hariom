<!-- snippets/product-content-note.liquid -->

{%- doc -%}
  Always-visible product content note (e.g. Editor's note). Not collapsible.
  @param {block} block - Block with heading, subtitle, text, and size/spacing settings.
{%- enddoc -%}

{%- liquid
  assign heading = block.settings.heading
  assign subtitle = block.settings.subtitle
  assign text = block.settings.text
  assign heading_font_size = block.settings.heading-font-size | default: 0
  assign subtitle_font_size = block.settings.subtitle-font-size | default: 0
  assign text_font_size = block.settings.text-font-size | default: 0
  assign mobile_heading_font_size = block.settings.mobile-heading-font-size | default: 0
  assign mobile_subtitle_font_size = block.settings.mobile-subtitle-font-size | default: 0
  assign mobile_text_font_size = block.settings.mobile-text-font-size | default: 0
  assign paragraph_spacing = block.settings.paragraph-spacing | default: 8
  assign gap = block.settings.gap | default: 8
  assign spacing_above = block.settings.spacing-above | default: 16
  assign spacing_below = block.settings.spacing-below | default: 16
-%}

{%- unless heading == blank and subtitle == blank and text == blank -%}
  <div
    class="product-content-note--root"
    style="
      --pcn-gap: {{ gap }}px;
      --pcn-spacing-above: {{ spacing_above }}px;
      --pcn-spacing-below: {{ spacing_below }}px;
      --pcn-paragraph-spacing: {{ paragraph_spacing }}px;
      {% if heading_font_size > 0 %}--pcn-heading-size: {{ heading_font_size }}px;{% endif %}
      {% if subtitle_font_size > 0 %}--pcn-subtitle-size: {{ subtitle_font_size }}px;{% endif %}
      {% if text_font_size > 0 %}--pcn-text-size: {{ text_font_size }}px;{% endif %}
      {% if mobile_heading_font_size > 0 %}--pcn-mobile-heading-size: {{ mobile_heading_font_size }}px;{% endif %}
      {% if mobile_subtitle_font_size > 0 %}--pcn-mobile-subtitle-size: {{ mobile_subtitle_font_size }}px;{% endif %}
      {% if mobile_text_font_size > 0 %}--pcn-mobile-text-size: {{ mobile_text_font_size }}px;{% endif %}
    "
    {% if heading_font_size > 0 %}data-heading-font-size="true"{% endif %}
    {% if subtitle_font_size > 0 %}data-subtitle-font-size="true"{% endif %}
    {% if text_font_size > 0 %}data-text-font-size="true"{% endif %}
    {% if mobile_heading_font_size > 0 %}data-mobile-heading-font-size="true"{% endif %}
    {% if mobile_subtitle_font_size > 0 %}data-mobile-subtitle-font-size="true"{% endif %}
    {% if mobile_text_font_size > 0 %}data-mobile-text-font-size="true"{% endif %}
  >
    {%- unless heading == blank -%}
      <div class="product-content-note--heading">
        {{- heading -}}
      </div>
    {%- endunless -%}

    {%- unless subtitle == blank -%}
      <div class="product-content-note--subtitle">
        {{- subtitle -}}
      </div>
    {%- endunless -%}

    {%- unless text == blank -%}
      <div class="product-content-note--text" data-item="rte-content">
        {{- text -}}
      </div>
    {%- endunless -%}
  </div>
{%- endunless -%}
