<!-- snippets/section-padding.liquid -->

{%- doc -%}
  Per-section padding override (Theme editor → Section padding).
  Desktop range 100–200, mobile 20–120, tablet auto = 75% of desktop.
{%- enddoc -%}

{%- liquid
  assign pad_enabled = section.settings.custom-padding-enabled
  assign pad_top = section.settings.custom-padding-top | default: 100
  assign pad_bottom = section.settings.custom-padding-bottom | default: 100
  assign m_pad_top = section.settings.custom-mobile-padding-top | default: 40
  assign m_pad_bottom = section.settings.custom-mobile-padding-bottom | default: 40

  assign t_pad_top = pad_top | times: 0.75 | round
  assign t_pad_bottom = pad_bottom | times: 0.75 | round
-%}

{%- if pad_enabled -%}
  {%- capture pad_targets -%}
    #shopify-section-{{ section.id }} > [data-section-id],
    #shopify-section-{{ section.id }} > .featured-collections--root,
    #shopify-section-{{ section.id }} > .featured-collection--root,
    #shopify-section-{{ section.id }} > .featured-text--root,
    #shopify-section-{{ section.id }} > .featured-grid--root,
    #shopify-section-{{ section.id }} > .image-with-text--root,
    #shopify-section-{{ section.id }} > .image-with-text-overlay--root,
    #shopify-section-{{ section.id }} > .newsletter--root,
    #shopify-section-{{ section.id }} > .newsletter--wrapper,
    #shopify-section-{{ section.id }} > .key-ingredients--root,
    #shopify-section-{{ section.id }} > .complete-your-routine--root,
    #shopify-section-{{ section.id }} > .footer--root
  {%- endcapture -%}

  <style>
    @media only screen and (min-width: 990px) {
      {{ pad_targets }} {
        padding-top: {{ pad_top }}px !important;
        padding-bottom: {{ pad_bottom }}px !important;
        --section--padding-top: {{ pad_top }}px !important;
        --section--padding-bottom: {{ pad_bottom }}px !important;
      }
    }

    @media only screen and (min-width: 768px) and (max-width: 989px) {
      {{ pad_targets }} {
        padding-top: {{ t_pad_top }}px !important;
        padding-bottom: {{ t_pad_bottom }}px !important;
        --section--padding-top: {{ t_pad_top }}px !important;
        --section--padding-bottom: {{ t_pad_bottom }}px !important;
      }
    }

    @media only screen and (max-width: 767px) {
      {{ pad_targets }} {
        padding-top: {{ m_pad_top }}px !important;
        padding-bottom: {{ m_pad_bottom }}px !important;
        --section--padding-top: {{ m_pad_top }}px !important;
        --section--padding-bottom: {{ m_pad_bottom }}px !important;
      }
    }
  </style>
{%- endif -%}
