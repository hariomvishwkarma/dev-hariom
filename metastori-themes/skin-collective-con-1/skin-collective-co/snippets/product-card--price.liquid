<!-- snippets/product-card--price.liquid -->

{%- doc -%}
  Renders product price, compare-at price, and unit price details.
  Price source is controlled by Theme settings → Product card price.
  @param {product} product - Product to price.
  @param {boolean} [onboarding] - Render onboarding prices.
{%- enddoc -%}

{%- liquid
  assign compare_price_t = 'sections.onboarding.compare_price' | t
  assign from_t = 'products.from' | t
  assign price_t = 'sections.onboarding.price' | t
  assign money_format = settings.product--currency-format | default: 'symbol'
  assign price_display = settings.product--price-display | default: 'selected'
  assign show_from_price = false
  if price_display == 'from'
    assign show_from_price = true
  endif

  assign current_variant = product.selected_or_first_available_variant
  if current_variant == blank
    assign current_variant = product.variants.first
  endif

  if onboarding
    assign currencies_using_comma_decimals = 'ANG,ARS,BRL,BYN,BYR,CLF,CLP,COP,CRC,CZK,DKK,EUR,HRK,HUF,IDR,ISK,MZN,NOK,PLN,RON,RUB,SEK,UYU,VES,VND' | split: ','
    if currencies_using_comma_decimals contains cart.currency.iso_code
      assign compare_price_t = compare_price_t | replace: '.', ','
      assign price_t = price_t | replace: '.', ','
    endif

    if money_format == 'code'
      assign compare_price = compare_price_t | append: ' ' | append: cart.currency.iso_code
      assign price = price_t | append: ' ' | append: cart.currency.iso_code
    else
      assign compare_price = compare_price_t | append: ' ' | append: cart.currency.symbol
      assign price = price_t | append: ' ' | append: cart.currency.symbol
    endif
  else
    assign compare_price = false
    if show_from_price
      if product.compare_at_price > product.price and product.available
        capture compare_price
          render 'format-money', amount: product.compare_at_price
        endcapture
        assign compare_price = compare_price | strip
      endif

      capture price
        render 'format-money', amount: product.price
      endcapture
    else
      if current_variant.compare_at_price > current_variant.price and product.available
        capture compare_price
          render 'format-money', amount: current_variant.compare_at_price
        endcapture
        assign compare_price = compare_price | strip
      endif

      capture price
        render 'format-money', amount: current_variant.price
      endcapture
    endif
    assign price = price | strip
  endif
-%}

<div class="product--price-container">
  <div class="product--price-wrapper">
    {%- if show_from_price and product.price_varies -%}
      <span class="product--from" data-item="nav-text">
        {{- from_t -}}
      </span>
    {%- endif -%}
    {%- if compare_price -%}
      <span
        class="product--compare-price"
        data-item="paragraph"
        data-text-color="gray"
      >
        {{- compare_price -}}
      </span>
    {%- endif -%}

    <span class="product--price" data-item="paragraph">
      {{- price -}}
    </span>
  </div>

  {%- if current_variant.unit_price_measurement -%}
    <div class="product--unit-price-container" data-item="small-text">
      <span class="product--unit-price">
        {%- render 'format-money', amount: current_variant.unit_price -%}
      </span>/

      {%- if current_variant.unit_price_measurement.reference_value != 1 -%}
        <span class="product--reference-value">
          {{- current_variant.unit_price_measurement.reference_value -}}
        </span>
      {%- endif -%}

      <span class="product--reference-unit">
        {{- current_variant.unit_price_measurement.reference_unit -}}
      </span>
    </div>
  {%- endif -%}
</div>

{% stylesheet %}
  .product--price {
    --font--paragraph--weight: 700;
  }
{% endstylesheet %}
