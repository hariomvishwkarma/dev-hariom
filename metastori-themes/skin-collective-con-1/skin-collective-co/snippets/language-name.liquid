{%- doc -%}
  Renders the display name of a language in English.
  Falls back to the language's own endonym for anything unmapped.
  Outputs an inline value only, so it is safe to use inside capture.
  @param {object} language - A shop_locale object.
{%- enddoc -%}
{%- liquid
  case language.iso_code
    when 'pt-PT', 'pt-BR', 'pt'
      echo 'Portuguese'
    when 'en'
      echo 'English'
    when 'es'
      echo 'Spanish'
    when 'fr'
      echo 'French'
    when 'de'
      echo 'German'
    when 'it'
      echo 'Italian'
    else
      echo language.endonym_name
  endcase
-%}