<!-- snippets/product-form.liquid -->

{%- doc -%}
  Renders the product form blocks for main and supporting product contexts.
  @param {section} section - Section containing block settings.
  @param {boolean} [breadcrumbs_enabled] - Show breadcrumb navigation.
  @param {boolean} [breadcrumbs_mobile] - Show breadcrumbs on mobile.
  @param {string} [breadcrumb_shop_label] - Label replacing Collections/Products.
  @param {string} [collapsible_icon] - Default accordion icon: `expand` or `chevron`.
  @param {boolean} [main_product] - Indicates rendering within the main product section.
  @param {product} [product] - Product to render; blank triggers onboarding state.
  @param {string} [text_color] - Text color of the text column. Defaults to `body`.
{%- enddoc -%}

{%- liquid
  assign onboarding = false
  if product == blank
    assign onboarding = true
  endif

  assign text_color = text_color | default: 'body'
  assign collapsible_icon = collapsible_icon | default: 'expand'
  assign breadcrumb_shop_label = breadcrumb_shop_label | default: 'Shop'
-%}

{%- if onboarding -%}
  <div class="product-form" data-text-color="{{ text_color }}">
    {%- for block in section.blocks -%}
      {%- if block.type == 'collapsible-row' -%}
        {%- liquid
          assign row_content = block.settings.description
          if block.settings.page-content != blank
            assign row_content = pages[block.settings.page-content].content
          endif
          assign row_content_stripped = row_content | strip_html | strip | replace: '&nbsp;', '' | replace: '&#160;', ''
        -%}
        {%- if row_content_stripped == blank or block.settings.heading == blank -%}
          {%- continue -%}
        {%- endif -%}
      {%- endif -%}
      {%- if block.type == 'low-stock' and block.settings.show-low-stock == false -%}
        {%- continue -%}
      {%- endif -%}
      <div
        class="product-form--block"
        data-block-type="{{ block.type }}"
        {% if block.type == 'collapsible-row' %}
          data-fit-together="true"
        {% endif %}
        {{- block.shopify_attributes -}}
      >
        {%- case block.type -%}
          {%- when 'overline' -%}
            <div class="product-form--block--overline" data-item="overline">
              {{- block.settings.overline -}}
            </div>

          {%- when 'heading' -%}
            {%- liquid
              assign heading_type = block.settings.heading-type | default: 'section-heading'
            -%}

            <div
              {% unless settings.transitions--text %}
                data-transition-item="viewport"
                data-transition-type="slide-in"
              {% endunless %}
            >
              <h2 class="product-form--block--heading" data-item="{{ heading_type }}">
                {{- 'sections.onboarding.product_title' | t -}}
              </h2>
            </div>

          {%- when 'vendor' -%}
            <div class="product-form--block--vendor" data-item="sub-nav-text">
              {{- 'sections.onboarding.vendor' | t -}}
            </div>

          {%- when 'price' -%}
            {%- liquid
              assign price_text_size = block.settings.text-size | default: 'nav-text'
              assign price_t = 'sections.onboarding.price' | t
              assign currencies_using_comma_decimals = 'ANG,ARS,BRL,BYN,BYR,CLF,CLP,COP,CRC,CZK,DKK,EUR,HRK,HUF,IDR,ISK,MZN,NOK,PLN,RON,RUB,SEK,UYU,VES,VND' | split: ','

              if currencies_using_comma_decimals contains cart.currency.iso_code
                assign price_t = price_t | replace: '.', ','
              endif
            -%}

            <div class="product-form--block--price-wrapper">
              <span
                class="product-form--block--price"
                data-item="{{ price_text_size }}"
              >
                {{- cart.currency.symbol -}}{{- price_t -}}
              </span>
            </div>

          {%- when 'buy-buttons' -%}
            {%-
              render 'product-buy-buttons',
              onboarding: true,
              smart_payment_enabled: block.settings.smart-payment-enabled,
              primary_button_style: block.settings.primary-button-style,
              secondary_button_style: block.settings.secondary-button-style,
              button_padding_block: block.settings.button-padding-block
            -%}

          {%- when 'quantity-selector' -%}
            {%- render 'quantity-selector', type: 'product' -%}

          {%- when 'social-sharing' -%}
            {%-
              render 'social-media',
              alignment: alignment,
              mobile_alignment: mobile_alignment,
              type: 'share',
              social_settings: block.settings
            -%}

          {%- when 'collapsible-row' -%}
            {%- assign block_id = section.id | append: '--collapsible-row--' | append: forloop.index -%}
            {%- liquid
              assign row_icon = collapsible_icon
              if block.settings.icon != blank and block.settings.icon != 'section'
                assign row_icon = block.settings.icon
              endif
            -%}
            {%- capture row_description -%}
              {%- render 'collapsible-row-description', block: block, product: product -%}
            {%- endcapture -%}
            {%-
              render 'collapsible-row',
              description: row_description,
              heading: block.settings.heading,
              default_open: block.settings.default-open,
              page_content: block.settings.page-content,
              id: block_id,
              text_color: text_color,
              icon: row_icon,
              heading_font_size: block.settings.heading-font-size,
              text_font_size: block.settings.text-font-size,
              mobile_heading_font_size: block.settings.mobile-heading-font-size,
              mobile_text_font_size: block.settings.mobile-text-font-size,
              content_padding_top: block.settings.content-padding-top,
              content_padding_bottom: block.settings.content-padding-bottom,
              mobile_content_padding_top: block.settings.mobile-content-padding-top,
              mobile_content_padding_bottom: block.settings.mobile-content-padding-bottom,
              spacing_above: block.settings.spacing-above,
              spacing_below: block.settings.spacing-below,
              mobile_spacing_above: block.settings.mobile-spacing-above,
              mobile_spacing_below: block.settings.mobile-spacing-below
            -%}

          {%- when 'icon' -%}
            {%- render 'icon-block', settings: block.settings -%}

          {%- when 'liquid' -%}
            {{- block.settings.custom-liquid -}}

          {%- when 'content-note' -%}
            {%- render 'product-content-note', block: block -%}

          {%- when '@app' -%}
            {%- render block -%}

        {%- endcase -%}
      </div>
    {%- endfor -%}
  </div>
{%- else -%}
  {%- form 'product', product, class: 'product-form', data-text-color: text_color -%}
    {%- liquid
      assign current_variant = product.selected_or_first_available_variant
      assign quantity_added = false
      assign unavailable_form_added = false
      assign render_size_chart_modal = false
      assign product_id = section.id | append: '_' | append: product.id
    -%}

    {%- if breadcrumbs_enabled -%}
      <div
        class="product--breadcrumbs"
        {% unless breadcrumbs_mobile %}
          data-mq="medium-large"
        {% endunless %}
        {% unless settings.transitions--text %}
          data-transition-item="{{ section.id }}"
        {% endunless %}
      >
        {%-
          render 'breadcrumbs',
          shop_label: breadcrumb_shop_label,
          shop_url:breadcrumb_shop_url
        -%}
      </div>
    {%- endif -%}

    {%- for block in section.blocks -%}
      {%- if block.type == 'collapsible-row' -%}
        {%- liquid
          assign row_content = block.settings.description
          if block.settings.page-content != blank
            assign row_content = pages[block.settings.page-content].content
          endif
          assign row_content_stripped = row_content | strip_html | strip | replace: '&nbsp;', '' | replace: '&#160;', ''
        -%}
        {%- if row_content_stripped == blank or block.settings.heading == blank -%}
          {%- continue -%}
        {%- endif -%}
      {%- endif -%}
      {%- if block.type == 'low-stock' and block.settings.show-low-stock == false -%}
        {%- continue -%}
      {%- endif -%}
      {%- liquid
        assign fit_together = false
        if block.type == 'collapsible-row'
          assign fit_together = true
        elsif block.type == 'complementary-products' and block.settings.collapsible-row-enabled
          assign fit_together = true
        elsif block.type == 'description' and block.settings.collapsible-row-enabled
          assign fit_together = true
        endif
      -%}

      {%- liquid
        assign block_spacing_style = ''
        assign block_spacing_attrs = ''

        if block.type == 'price'
          if block.settings.title-price-gap > 0
            assign block_spacing_attrs = block_spacing_attrs | append: ' data-title-price-gap="true"'
            assign block_spacing_style = block_spacing_style | append: ' --title-price-gap: ' | append: block.settings.title-price-gap | append: 'px;'
          endif
          if block.settings.mobile-title-price-gap > 0
            assign block_spacing_attrs = block_spacing_attrs | append: ' data-mobile-title-price-gap="true"'
            assign block_spacing_style = block_spacing_style | append: ' --mobile-title-price-gap: ' | append: block.settings.mobile-title-price-gap | append: 'px;'
          endif
          if block.settings.desktop-font-size > 0
            assign block_spacing_attrs = block_spacing_attrs | append: ' data-price-desktop-font-size="true"'
            assign block_spacing_style = block_spacing_style | append: ' --price-desktop-font-size: ' | append: block.settings.desktop-font-size | append: 'px;'
          endif
          if block.settings.mobile-font-size > 0
            assign block_spacing_attrs = block_spacing_attrs | append: ' data-price-mobile-font-size="true"'
            assign block_spacing_style = block_spacing_style | append: ' --price-mobile-font-size: ' | append: block.settings.mobile-font-size | append: 'px;'
          endif
        elsif block.type == 'heading'
          if block.settings.vendor-title-gap > 0
            assign block_spacing_attrs = block_spacing_attrs | append: ' data-vendor-title-gap="true"'
            assign block_spacing_style = block_spacing_style | append: ' --vendor-title-gap: ' | append: block.settings.vendor-title-gap | append: 'px;'
          endif
          if block.settings.mobile-vendor-title-gap > 0
            assign block_spacing_attrs = block_spacing_attrs | append: ' data-mobile-vendor-title-gap="true"'
            assign block_spacing_style = block_spacing_style | append: ' --mobile-vendor-title-gap: ' | append: block.settings.mobile-vendor-title-gap | append: 'px;'
          endif
        elsif block.type == 'vendor' and block.settings.mobile-spacing-above > 0
          assign block_spacing_attrs = block_spacing_attrs | append: ' data-mobile-spacing-above="true"'
          assign block_spacing_style = block_spacing_style | append: ' --mobile-block-spacing-above: ' | append: block.settings.mobile-spacing-above | append: 'px;'
        elsif block.type == 'options'
          if block.settings.mobile-spacing-above > 0
            assign block_spacing_attrs = block_spacing_attrs | append: ' data-mobile-spacing-above="true"'
            assign block_spacing_style = block_spacing_style | append: ' --mobile-block-spacing-above: ' | append: block.settings.mobile-spacing-above | append: 'px;'
          endif
          if block.settings.mobile-spacing-below > 0
            assign block_spacing_attrs = block_spacing_attrs | append: ' data-mobile-spacing-below="true"'
            assign block_spacing_style = block_spacing_style | append: ' --mobile-block-spacing-below: ' | append: block.settings.mobile-spacing-below | append: 'px;'
          endif
        elsif block.type == 'buy-buttons'
          if block.settings.spacing-above > 0
            assign block_spacing_attrs = block_spacing_attrs | append: ' data-spacing-above="true"'
            assign block_spacing_style = block_spacing_style | append: ' --block-spacing-above: ' | append: block.settings.spacing-above | append: 'px;'
          endif
          if block.settings.mobile-spacing-above > 0
            assign block_spacing_attrs = block_spacing_attrs | append: ' data-mobile-spacing-above="true"'
            assign block_spacing_style = block_spacing_style | append: ' --mobile-block-spacing-above: ' | append: block.settings.mobile-spacing-above | append: 'px;'
          endif
        endif
      -%}

      <div
        class="product-form--block"
        data-block-type="{{ block.type }}"
        data-fit-together="{{ fit_together }}"
        {{ block_spacing_attrs }}
        {% if block_spacing_style != blank %}
          style="{{ block_spacing_style }}"
        {% endif %}
        {{- block.shopify_attributes -}}
      >
        {%- case block.type -%}
          {%- when 'overline' -%}
            <div class="product-form--block--overline" data-item="overline">
              {{- block.settings.overline -}}
            </div>

          {%- when 'heading' -%}
            {%- liquid
              assign heading_type = block.settings.heading-type | default: 'section-heading'
            -%}
            <div
              {% unless settings.transitions--text %}
                data-transition-item="viewport"
                data-transition-type="slide-in"
              {% endunless %}
            >
              {%- if main_product -%}
                {%- liquid
                  assign tag_setting = settings.header--logo-tag | default: 'homepage'
                  assign heading_tag = 'h2'
                  if tag_setting == 'none'
                    assign heading_tag = 'h1'
                  elsif tag_setting == 'homepage' and request.page_type != 'index'
                    assign heading_tag = 'h1'
                  endif
                -%}

                <{{ heading_tag }}
                  class="product-form--block--heading"
                  data-item="{{ heading_type }}"
                >
                  {{- product.title -}}
                </{{ heading_tag }}>
              {%- else -%}
                <h2 class="product-form--block--heading" data-item="{{ heading_type }}">
                  <a href="{{ product.url }}">
                    {{- product.title -}}
                  </a>
                </h2>
              {%- endif -%}
            </div>

          {%- when 'label' -%}
            {%- liquid
              assign off_t = 'products.off' | t
              assign sale_t = 'products.sale' | t
              assign out_of_stock_t = 'products.out_of_stock' | t

              assign sold_out_enabled = block.settings.sold-out-enabled
              assign sale_enabled = block.settings.sale-enabled
              assign sale_type = block.settings.sale-type
              assign label_color = block.settings.color
              assign label_shape = block.settings.shape
              assign text_color = block.settings.text-color
            -%}

            <product-label-element
              class="product--label"
              data-id="{{ product_id }}"
              data-background-color="{{ label_color }}"
              data-label-shape="{{ label_shape }}"
              data-sale-enabled="{{ sale_enabled }}"
              data-sale-type="{{ sale_type }}"
              data-sold-out-enabled="{{ sold_out_enabled }}"
              data-text-color="{{ text_color }}"
            >
              <span class="product--label-text">
                {%- liquid
                  if current_variant.available == false and sold_out_enabled
                    echo out_of_stock_t
                  elsif sale_enabled and current_variant.compare_at_price > current_variant.price
                    if sale_type == 'percent'
                      assign price_diff = current_variant.compare_at_price | minus: current_variant.price
                      assign percent_diff = price_diff | times: 100 | divided_by: current_variant.compare_at_price
                      echo percent_diff | append: '% ' | append: off_t
                    else
                      echo sale_t
                    endif
                  endif
                -%}
              </span>

              <script type="application/json">
                {
                  "off": "{{- off_t -}}",
                  "out_of_stock": "{{- out_of_stock_t -}}",
                  "sale": "{{- sale_t -}}"
                }
              </script>
            </product-label-element>

          {%- when 'vendor' -%}
            {%- assign vendor_handle = product.vendor | handle -%}
            {%- assign vendor_collection = collections[vendor_handle] -%}
            <div class="product-form--block--vendor" data-item="sub-nav-text">
              {%- if vendor_collection != empty -%}
                <a href="{{ vendor_collection.url }}">{{ product.vendor }}</a>
              {%- else -%}
                <a href="{{ product.vendor | url_for_vendor }}">{{ product.vendor }}</a>
              {%- endif -%}
            </div>

          {%- when 'price' -%}
            {%-
              render 'product-price',
              product: product,
              id: product_id,
              text_size: block.settings.text-size,
              show_tax_included: block.settings.show-tax-included
            -%}

          {%- when 'low-stock' -%}
            {%- if block.settings.show-low-stock -%}
              {%-
                render 'product-low-stock',
                current_variant: current_variant,
                id: product_id,
                product: product,
                block_settings: block.settings
              -%}
            {%- endif -%}

          {%- when 'options' -%}
            {%-
              render 'product-options',
              id: product_id,
              product: product,
              variant_style: block.settings.variant-style,
              hide_option_labels: block.settings.hide-option-labels,
              size_chart_enabled: block.settings.size-chart-enabled,
              size_chart_option: block.settings.size-chart-option,
              main_product: main_product
            -%}

            {%- liquid
              if block.settings.size-chart-enabled
                assign size_chart_option = block.settings.size-chart-option | strip | downcase

                for option in product.options_with_values
                  assign option_name = option.name | strip | downcase
                  if option_name == size_chart_option
                    if block.settings.size-chart-content == blank
                      capture size_chart_path
                        assign size_chart_path_t = 'products.size_chart_path' | t
                        echo '<code>' | append: size_chart_path_t | append: '</code>'
                      endcapture

                      assign page_content = 'products.empty_page_content_html' | t: size_chart_path: size_chart_path
                    else
                      assign page_content = pages[block.settings.size-chart-content].content
                    endif

                    assign render_size_chart_modal = true
                    break
                  endif
                endfor
              endif
            -%}

          {%- when 'buy-buttons' -%}
            {%-
              render 'product-buy-buttons',
              id: product_id,
              product: product,
              onboarding: false,
              form: form,
              sticky_cart_enabled: block.settings.sticky-add-enabled,
              smart_payment_enabled: block.settings.smart-payment-enabled,
              primary_button_style: block.settings.primary-button-style,
              secondary_button_style: block.settings.secondary-button-style,
              button_padding_block: block.settings.button-padding-block
            -%}

          {%- when 'quantity-selector' -%}
            {%- liquid
              assign quantity_added = true
              render 'quantity-selector', id: product_id, type: 'product'
            -%}

          {%- when 'unavailable-form' -%}
            {%- liquid
              assign unavailable_form_added = true
              render 'product-unavailable-form', view: 'input', product: product, product_id: product_id
            -%}

          {%- when 'rating' -%}
            {%- render 'product-rating', product: product -%}

          {%- when 'social-sharing' -%}
            {%-
              render 'social-media',
              alignment: alignment,
              mobile_alignment: mobile_alignment,
              type: 'share',
              social_settings: block.settings
            -%}

          {%- when 'pickup' -%}
            {%- render 'product-pickup', product: product, id: product_id -%}

          {%- when 'sku' -%}
            <product-sku-element
              class="product--sku"
              data-item="small-text"
              data-id="{{ product_id }}"
            >
              {{- 'products.sku' | t -}}:&nbsp;<span>{{- product.selected_or_first_available_variant.sku -}}</span>
            </product-sku-element>

          {%- when 'collapsible-row' -%}
            {%- assign block_id = section.id | append: '--collapsible-row--' | append: forloop.index -%}
            {%- liquid
              assign row_icon = collapsible_icon
              if block.settings.icon != blank and block.settings.icon != 'section'
                assign row_icon = block.settings.icon
              endif
            -%}
            {%- capture row_description -%}
              {%- render 'collapsible-row-description', block: block, product: product -%}
            {%- endcapture -%}
            {%-
              render 'collapsible-row',
              description: row_description,
              heading: block.settings.heading,
              default_open: block.settings.default-open,
              page_content: block.settings.page-content,
              id: block_id,
              text_color: text_color,
              icon: row_icon,
              heading_font_size: block.settings.heading-font-size,
              text_font_size: block.settings.text-font-size,
              mobile_heading_font_size: block.settings.mobile-heading-font-size,
              mobile_text_font_size: block.settings.mobile-text-font-size,
              content_padding_top: block.settings.content-padding-top,
              content_padding_bottom: block.settings.content-padding-bottom,
              mobile_content_padding_top: block.settings.mobile-content-padding-top,
              mobile_content_padding_bottom: block.settings.mobile-content-padding-bottom,
              spacing_above: block.settings.spacing-above,
              spacing_below: block.settings.spacing-below,
              mobile_spacing_above: block.settings.mobile-spacing-above,
              mobile_spacing_below: block.settings.mobile-spacing-below
            -%}

          {%- when 'description' -%}
            {%- unless product.description == blank -%}
              <div
                class="product-form--block--description"
                data-item="rte-content"
                data-x-alignment="{{ block.settings.text-alignment }}"
              >
                {%- liquid
                  if block.settings.collapsible-row-enabled
                    assign block_id = section.id | append: '-' | append: block.id
                    render 'collapsible-row', heading: block.settings.heading, description: product.description, id: block_id, text_color: text_color, icon: collapsible_icon
                  else
                    echo product.description
                  endif
                -%}
              </div>
            {%- endunless -%}

          {%- when 'content-note' -%}
            {%- render 'product-content-note', block: block -%}

          {%- when 'complementary-products' -%}
            {%-
              render 'complementary-products',
              heading: block.settings.title,
              max_products: block.settings.max-products,
              collapsible_row: block.settings.collapsible-row-enabled,
              product_id: product.id,
              text_color: text_color,
              icon: collapsible_icon
            -%}

          {%- when 'icon' -%}
            {%- render 'icon-block', settings: block.settings -%}

          {%- when 'liquid' -%}
            {{- block.settings.custom-liquid -}}

          {%- when '@app' -%}
            {%- render block -%}

        {%- endcase -%}
      </div>
    {%- endfor -%}

    {%- unless quantity_added -%}
      <input type="hidden" name="quantity" value="1" min="1" pattern="[0-9]*" tabindex="-1">
    {%- endunless -%}
  {%- endform -%}

  {%- liquid
    if unavailable_form_added
      render 'product-unavailable-form', view: 'form', product: product, product_id: product_id
    endif
  -%}

  {%- if render_size_chart_modal -%}
    <modal-element
      class="modal--root"
      data-id="{{ product_id }}_size-chart"
      data-background-color="dark"
      data-translucent="true"
      data-transition-item="viewport"
      data-transition-type="fade-in"
      data-transition-trigger="custom"
      aria-hidden="true"
    >
      <div class="modal--view">
        <div class="product-size-chart--modal" data-item="rte-content">
          {{- page_content -}}
        </div>
      </div>
    </modal-element>
  {%- endif -%}
{%- endif -%}

{% stylesheet %}
  .product-form {
    display: block;
    background-color: var(--bg-color);

    @media (max-width: 767px) {
      width: 100%;
    }

    @media (min-width: 768px) {
      .breadcrumbs--root {
        padding-top: 0;
        justify-content: var(--x-alignment);
      }
    }
  }
  
  .product-form--block {
    text-align: var(--text-alignment);

    /* top instead of bottom margin here because of how collapsible rows stack */
    &[data-block-type] {
      margin-top: var(--spacing--block);
    }

    &[data-block-type='icon'] + &[data-block-type='icon'] {
      margin-top: var(--spacing--1);
    }

    &:is(
        [data-block-type='price'],
        [data-block-type='vendor'],
        [data-block-type='rating'],
        [data-block-type='sku'],
        [data-block-type='heading']
      ) {
      margin-top: var(--spacing--item);
    }

    &[data-block-type='price'][data-title-price-gap='true'] {
      margin-top: var(--title-price-gap) !important;
    }

    /* Vendor above title (product template order) */
    &[data-block-type='vendor'] + &[data-block-type='heading'][data-vendor-title-gap='true'] {
      margin-top: var(--vendor-title-gap) !important;
    }

    &[data-block-type='price'][data-price-desktop-font-size='true'] {
      @media (min-width: 768px) {
        .product-price--original,
        .product-price--original [data-item],
        .product-price--compare,
        .product-price--compare [data-item] {
          font-size: var(--price-desktop-font-size) !important;
          line-height: 1.3;
        }
      }
    }

    &[data-block-type='price'][data-price-mobile-font-size='true'] {
      @media (max-width: 767px) {
        .product-price--original,
        .product-price--original [data-item],
        .product-price--compare,
        .product-price--compare [data-item] {
          font-size: var(--price-mobile-font-size) !important;
          line-height: 1.3;
        }
      }
    }

    /* When only desktop size is set, use it on mobile too unless mobile override exists */
    &[data-block-type='price'][data-price-desktop-font-size='true']:not([data-price-mobile-font-size='true']) {
      @media (max-width: 767px) {
        .product-price--original,
        .product-price--original [data-item],
        .product-price--compare,
        .product-price--compare [data-item] {
          font-size: var(--price-desktop-font-size) !important;
          line-height: 1.3;
        }
      }
    }

    input[type='hidden'] + &[data-block-type],
    &[data-block-type]:first-child {
      margin-top: 0;
    }

    &[data-block-type]:is(:empty, :has(> *:empty), [aria-hidden='true']) {
      display: none;
    }

    :is(
        .product-rating--root,
        .product-price--wrapper,
        .product-price--unit-container,
        .social-media--root .social-media--items,
        .swatches--header,
        .swatches--container,
        .radios--header,
        .radios--container
      ) {
      justify-content: var(--x-alignment);
    }

    @media (min-width: 768px) {
      [data-x-alignment='center'] & .product--label {
        margin: 0 auto;
      }

      [data-x-alignment='right'] & {
        :is(.disclosure--label, .swatches--header, .swatches--name, .radios--header)
          > *:first-child:not(:only-child) {
          order: 1;
        }

        .product--label {
          margin-left: auto;
        }
      }
    }

    @media (max-width: 767px) {
      .product--breadcrumbs + & {
        margin-top: 0;
      }

      [data-mobile-x-alignment='center'] & .product--label {
        margin: 0 auto;
      }

      [data-mobile-x-alignment='right'] & {
        :is(.disclosure--label, .swatches--header, .swatches--name, .radios--header)
          > *:first-child:not(:only-child) {
          order: 1;
        }

        .product--label {
          margin-left: auto;
        }
      }
    }
  }

  .product-size-chart--modal {
    padding: var(--spacing--section);
    background: var(--bg-color--body);
    text-align: center;

    @media (max-width: 767px) {
      padding: var(--spacing--block) var(--spacing--item);
    }
  }
  .product-form--block:is([data-block-type=price],[data-block-type=vendor],[data-block-type=rating],[data-block-type=sku],[data-block-type=heading]) {
    margin-top: 33px !important;
  }
{% endstylesheet %}