<!-- snippets/breadcrumbs.liquid -->

{%- doc -%}
  Builds a breadcrumb trail for the current page.
  @param {article} [article] - Active article.
  @param {blog} [blog] - Active blog.
  @param {collection} [collection] - Active collection.
  @param {string[]} [current_tags] - Active collection tags.
  @param {page} [page] - Active page.
  @param {string} [page_title] - Fallback page title.
  @param {product} [product] - Active product.
  @param {string} [shop_label] - Optional label replacing Collections/Products on product pages.
  @param {string} [shop_url] - Optional destination for that crumb. Defaults to the all-products collection.
{%- enddoc -%}

<ul class="breadcrumbs--root">
   <li data-item="caption">
      <a href="{{ routes.root_url }}">
         {{- 'general.breadcrumbs.home' | t -}}
      </a>
   </li>

   {%- if request.page_type == "product" -%}
      {%- liquid
         if shop_label != blank
            assign products_label = shop_label
            assign collections_label = shop_label

            # The link setting rides along with the label setting: it only takes
            # effect on the crumb the label replaced. `shop_url` is a `url`-type
            # setting, stored without the locale prefix, so it needs localizing
            # to survive /pt and /es.
            capture shop_link
               render 'localized-url', url: shop_url
            endcapture
            assign shop_link = shop_link | strip
         else
            assign products_label = 'general.breadcrumbs.products' | t
            assign collections_label = 'general.breadcrumbs.collections' | t
         endif

         # No label override, or no link set — trail behaves exactly as before.
         if shop_link == blank
            assign shop_link = routes.collections_url
         endif
      -%}
      {%- if collection -%}
         <li data-item="caption">
            <a href="{{ shop_link }}">
               {{- collections_label -}}
            </a>
         </li>
         <li data-item="caption">
            <a href="{{ collection.url }}">
               {{- collection.title -}}
            </a>
         </li>
      {%- else -%}
         <li data-item="caption">
            <a href="{{ routes.all_products_collection_url }}">
               {{- products_label -}}
            </a>
         </li>
      {%- endif -%}

      <li data-item="caption">
         {{- product.title -}}
      </li>

   {%- elsif request.page_type == "collection" -%}
      {%- liquid
         assign collection_title = collection.title
         if collection.handle == 'all'
            assign collection_title = 'general.breadcrumbs.products' | t
         endif
      -%}

      <li data-item="caption">
         <a href="{{ routes.collections_url }}">
            {{- 'general.breadcrumbs.collections' | t -}}
         </a>
      </li>

      <li data-item="caption">
         {%- liquid
            if current_tags
               echo collection_title | link_to_remove_tag: current_tags.first
            else
               echo collection_title
            endif
         -%}
      <li>

      {%- if current_tags -%}
         <li data-item="caption">
            {{- current_tags.first -}}
         </li>
      {%- endif -%}

   {%- elsif request.page_type == "blog" -%}
      <li data-item="caption">
         {{- blog.title -}}
      </li>

   {%- elsif request.page_type == "page" -%}
      <li data-item="caption">
         {{- page.title -}}
      </li>

   {%- elsif request.page_type == "article" -%}
      <li data-item="caption">
         {{- blog.title | link_to: blog.url -}}
      </li>
      <li data-item="caption">
         {{- article.title -}}
      </li>

   {%- elsif request.page_type == "404" -%}
      <li data-item="caption">
         {{- '404' -}}
      </li>

   {%- elsif request.page_type == "customers/register" -%}
      <li data-item="caption">
         {{- 'general.breadcrumbs.register' | t -}}
      </li>

   {%- elsif request.page_type == "customers/account" or request.page_type == "customers/login" -%}
      <li data-item="caption">
         {{- 'general.breadcrumbs.account' | t -}}
      </li>

   {%- elsif request.page_type == "customers/addresses" -%}
      <li data-item="caption">
         <a href="{{ routes.account_url }}">
            {{- 'general.breadcrumbs.account' | t -}}
         </a>
      </li>
      <li data-item="caption">
         {{- 'general.breadcrumbs.addresses' | t -}}
      </li>

   {%- elsif request.page_type == "customers/order" -%}
      <li data-item="caption">
         <a href="{{ routes.account_url }}">
            {{- 'general.breadcrumbs.account' | t -}}
         </a>
      </li>
      <li data-item="caption">
         {{- page_title -}}
      </li>

   {%- elsif request.page_type == "customers/activate_account" -%}
      <li data-item="caption">
         {{- 'general.breadcrumbs.activate_account' | t -}}
      </li>

   {%- elsif request.page_type == "list-collections" or request.page_type == "cart" or
      request.page_type == "search" or request.page_type == "customers/reset_password" -%}
      <li data-item="caption">
         {{- page_title -}}
      </li>

   {%- endif -%}
</ul>

{% stylesheet %}
   .breadcrumbs--root {
      display: flex;
      flex-wrap: wrap;
      align-items: baseline;
      gap: var(--spacing--1);
      padding: var(--spacing--2) 0;

      > * a,
      > *[data-item] {
         text-transform: capitalize;
      }

      & li {
         display: inline-flex;
         align-items: center;
         line-height: 1;

         &:not(:last-of-type):after {
            margin: 0 0 2px 8px;
            content: '';
            background-color: var(--color--body);
            width: var(--spacing--0);
            height: var(--spacing--0);
            border-radius: 50%;
         }

         & a:after {
            padding-bottom: 0.143em;
            border-bottom: 0.071em solid var(--color--body);
            content: '';
            display: block;
            width: 100%;
         }
      }
   }
{% endstylesheet %}