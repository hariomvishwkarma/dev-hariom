{%- liquid
  assign entry_description = description
  assign desc_html = entry_description | metafield_tag
-%}

{%- if desc_html != blank -%}
  {{ desc_html }}
{%- elsif entry_description.value != blank -%}
  {%- assign desc_value = entry_description.value -%}
  {%- assign desc_value_html = desc_value | metafield_tag -%}
  {%- if desc_value_html != blank -%}
    {{ desc_value_html }}
  {%- else -%}
    {{ desc_value | newline_to_br }}
  {%- endif -%}
{%- else -%}
  {{ entry_description | newline_to_br }}
{%- endif -%}
