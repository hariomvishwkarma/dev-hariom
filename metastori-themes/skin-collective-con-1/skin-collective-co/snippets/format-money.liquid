<!-- snippets/format-money.liquid -->

{%- doc -%}
  Formats a money amount using Theme settings → Product grid → Currency display.
  Symbol mode: amount then symbol after (e.g. 49,00 €).
  Code mode: amount then ISO code (e.g. 49,00 EUR).
  @param {number} amount - Price amount (cents).
  @param {string} [format] - Optional override: `symbol` or `code`.
{%- enddoc -%}

{%- liquid
  assign money_format = format | default: settings.product--currency-format | default: 'symbol'
  assign formatted_amount = amount | money_without_currency

  if money_format == 'code'
    echo formatted_amount | append: ' ' | append: cart.currency.iso_code
  else
    echo formatted_amount | append: ' ' | append: cart.currency.symbol
  endif
-%}
