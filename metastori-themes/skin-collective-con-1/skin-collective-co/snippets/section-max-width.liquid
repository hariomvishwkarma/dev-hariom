<!-- snippets/section-max-width.liquid -->

{%- doc -%}
  Outputs a per-section max-width override (Theme editor → Section max width).
  Uses section.settings.custom-max-width-enabled / custom-max-width.
{%- enddoc -%}

{%- liquid
  assign mw_enabled = section.settings.custom-max-width-enabled
  assign mw = section.settings.custom-max-width | default: 1152

  # Full width wins: it overrides the max width setting.
  if section.settings.full-width
    assign mw_enabled = false
  endif
-%}

{%- if mw_enabled -%}
  <style>
    #shopify-section-{{ section.id }} > [data-section-id],
    #shopify-section-{{ section.id }} > .featured-collections--root,
    #shopify-section-{{ section.id }} > .featured-collection--root,
    #shopify-section-{{ section.id }} > .featured-text--root,
    #shopify-section-{{ section.id }} > .featured-grid--root,
    #shopify-section-{{ section.id }} > .image-with-text--root,
    #shopify-section-{{ section.id }} > .newsletter--root,
    #shopify-section-{{ section.id }} > .banner--root,
    #shopify-section-{{ section.id }} > .key-ingredients--root,
    #shopify-section-{{ section.id }} > .complete-your-routine--root,
    #shopify-section-{{ section.id }} > .custom-announcement--root,
    #shopify-section-{{ section.id }} > .footer--root {
      max-width: {{ mw }}px !important;
      width: 100%;
      margin-inline: auto !important;
      box-sizing: border-box;
      --layout-guide-inset: var(--layout-padding-x) !important;
      --fcol-guide-inset: var(--layout-padding-x) !important;
    }
  </style>
{%- endif -%}
