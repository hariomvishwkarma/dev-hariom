<!-- snippets/price-sort-pagination.liquid -->

{%- doc -%}
  Client-side pagination used after sorting the full product set by card price.
{%- enddoc -%}

{%- liquid
  assign previous_t = 'general.pagination.previous' | t
  assign next_t = 'general.pagination.next' | t
  assign first_t = 'general.pagination.first' | t
  assign last_t = 'general.pagination.last' | t
-%}

<div class="pagination--root" data-item="nav-text" data-price-sort-pagination hidden>
  <button type="button" class="pagination--link" data-price-sort-action="first" aria-label="{{ first_t }}">
    {%- render 'icons', icon: 'chevron-far-left' -%}
  </button>
  <button type="button" class="pagination--link" data-price-sort-action="prev" aria-label="{{ previous_t }}">
    {%- render 'icons', icon: 'chevron-left' -%}
  </button>
  <div class="pagination--of" data-price-sort-status></div>
  <button type="button" class="pagination--link" data-price-sort-action="next" aria-label="{{ next_t }}">
    {%- render 'icons', icon: 'chevron-right' -%}
  </button>
  <button type="button" class="pagination--link" data-price-sort-action="last" aria-label="{{ last_t }}">
    {%- render 'icons', icon: 'chevron-far-right' -%}
  </button>
</div>

{% stylesheet %}
  .pagination--root {
    display: flex;
    justify-content: center;
    align-items: center;

    @media (min-width: 768px) {
      gap: var(--spacing--2);
    }
  }

  .pagination--of {
    @media (max-width: 767px) {
      padding: 0 var(--spacing--1);
    }
  }

  .pagination--link {
    display: flex;
    align-items: center;
    justify-content: center;
    width: var(--spacing--block);
    height: var(--spacing--block);
    background: none;
    border: none;
    padding: 0;
    font: inherit;
    color: inherit;
    cursor: pointer;

    @media (min-width: 768px) {
      border: var(--border--dark);
      border-radius: 50%;
      transition: transform 0.4s var(--transition--ease-out);

      &[role='button']:hover {
        opacity: 1;
        transform: scale(1.06);

        .layout--viewport[data-drop-shadows='true'] & {
          box-shadow: var(--box-shadow--center);
        }
      }

      &[role='button']:active {
        transform: scale(1);
      }
    }

    @media (max-width: 767px) {
      svg {
        height: 13px;
      }
    }

    &[aria-hidden='true'] {
      opacity: 0.4;
    }

    svg {
      height: 10px;
    }
  }
{% endstylesheet %}
