<!-- snippets/collapsible-row.liquid -->

{%- doc -%}
  Renders an expandable disclosure row.
  @param {string} heading - Row heading text.
  @param {string} id - Content container id.
  @param {boolean} [default_open] - Start expanded.
  @param {string} [description] - Inline HTML fallback.
  @param {string} [description_type] - Content style token. Defaults to `rte-content`.
  @param {string} [page_content] - Page handle for content.
  @param {string} [text_color] - Heading color token.
  @param {string} [view] - Icon view type. Defaults to `small`.
  @param {string} [icon] - Toggle icon style: `expand` (plus) or `chevron`. Defaults to `expand`.
  @param {number} [heading_font_size] - Heading font size in px. 0 = theme default.
  @param {number} [text_font_size] - Body font size in px. 0 = theme default.
  @param {number} [mobile_heading_font_size] - Mobile heading font size in px. 0 = desktop size.
  @param {number} [mobile_text_font_size] - Mobile body font size in px. 0 = desktop size.
  @param {number} [content_padding_top] - Content area padding top in px.
  @param {number} [content_padding_bottom] - Content area padding bottom in px.
  @param {number} [mobile_content_padding_top] - Mobile content padding top. 0 = desktop value.
  @param {number} [mobile_content_padding_bottom] - Mobile content padding bottom. 0 = desktop value.
  @param {number} [spacing_above] - Extra space above the row in px.
  @param {number} [spacing_below] - Extra space below the row in px.
  @param {number} [mobile_spacing_above] - Mobile space above. 0 = desktop value.
  @param {number} [mobile_spacing_below] - Mobile space below. 0 = desktop value.
{%- enddoc -%}

{%- liquid
  assign description_type = description_type | default: 'rte-content'
  assign view = view | default: 'small'
  assign icon = icon | default: 'expand'
  assign heading_font_size = heading_font_size | default: 0 | plus: 0
  assign text_font_size = text_font_size | default: 0 | plus: 0
  assign mobile_heading_font_size = mobile_heading_font_size | default: 0 | plus: 0
  assign mobile_text_font_size = mobile_text_font_size | default: 0 | plus: 0
  assign content_padding_top = content_padding_top | default: 8 | plus: 0
  assign content_padding_bottom = content_padding_bottom | default: 8 | plus: 0
  assign mobile_content_padding_top = mobile_content_padding_top | default: 0 | plus: 0
  assign mobile_content_padding_bottom = mobile_content_padding_bottom | default: 0 | plus: 0
  assign spacing_above = spacing_above | default: 0 | plus: 0
  assign spacing_below = spacing_below | default: 0 | plus: 0
  assign mobile_spacing_above = mobile_spacing_above | default: 0 | plus: 0
  assign mobile_spacing_below = mobile_spacing_below | default: 0 | plus: 0

  if mobile_content_padding_top == 0
    assign mobile_content_padding_top = content_padding_top
  endif
  if mobile_content_padding_bottom == 0
    assign mobile_content_padding_bottom = content_padding_bottom
  endif
  if mobile_spacing_above == 0 and spacing_above > 0
    assign mobile_spacing_above = spacing_above
  endif
  if mobile_spacing_below == 0 and spacing_below > 0
    assign mobile_spacing_below = spacing_below
  endif

  assign resolved_content = description
  if page_content != blank
    assign resolved_content = pages[page_content].content
  endif

  assign content_stripped = resolved_content | strip_html | strip | replace: '&nbsp;', '' | replace: '&#160;', ''
  assign has_content = false
  if content_stripped != blank
    assign has_content = true
  endif
-%}

{%- if has_content and heading != blank -%}
  <animated-details>
    <details
      class="collapsible-row--root"
      {% if default_open %}open{% endif %}
      data-border="both"
      data-view="{{ view }}"
      data-icon="{{ icon }}"
      data-text-color="{{ text_color | default: 'body' }}"
      {% if heading_font_size > 0 %}data-heading-font-size="true"{% endif %}
      {% if text_font_size > 0 %}data-text-font-size="true"{% endif %}
      {% if mobile_heading_font_size > 0 %}data-mobile-heading-font-size="true"{% endif %}
      {% if mobile_text_font_size > 0 %}data-mobile-text-font-size="true"{% endif %}
      {% if spacing_above > 0 %}data-spacing-above="true"{% endif %}
      {% if spacing_below > 0 %}data-spacing-below="true"{% endif %}
      {% if mobile_spacing_above > 0 %}data-mobile-spacing-above="true"{% endif %}
      {% if mobile_spacing_below > 0 %}data-mobile-spacing-below="true"{% endif %}
      data-mobile-content-padding="true"
      style="
        --cr-content-padding-top: {{ content_padding_top }}px;
        --cr-content-padding-bottom: {{ content_padding_bottom }}px;
        --cr-mobile-content-padding-top: {{ mobile_content_padding_top }}px;
        --cr-mobile-content-padding-bottom: {{ mobile_content_padding_bottom }}px;
        {% if heading_font_size > 0 %}--cr-heading-size: {{ heading_font_size }}px;{% endif %}
        {% if text_font_size > 0 %}--cr-text-size: {{ text_font_size }}px;{% endif %}
        {% if mobile_heading_font_size > 0 %}--cr-mobile-heading-size: {{ mobile_heading_font_size }}px;{% endif %}
        {% if mobile_text_font_size > 0 %}--cr-mobile-text-size: {{ mobile_text_font_size }}px;{% endif %}
        {% if spacing_above > 0 %}--cr-spacing-above: {{ spacing_above }}px;{% endif %}
        {% if spacing_below > 0 %}--cr-spacing-below: {{ spacing_below }}px;{% endif %}
        {% if mobile_spacing_above > 0 %}--cr-mobile-spacing-above: {{ mobile_spacing_above }}px;{% endif %}
        {% if mobile_spacing_below > 0 %}--cr-mobile-spacing-below: {{ mobile_spacing_below }}px;{% endif %}
      "
    >
      <summary class="collapsible-row--toggle">
        <div class="collapsible-row--heading" data-item="nav-text">
          {{- heading -}}
        </div>

        {%- if has_content -%}
          {%- if icon == 'chevron' -%}
            <span class="collapsible-row--chevron">
              {%- render 'icons', icon: 'chevron-down' -%}
            </span>
          {%- else -%}
            <div class="layout--expand"></div>
          {%- endif -%}
        {%- endif -%}
      </summary>

      {%- if has_content -%}
        <div class="collapsible-row--wrapper">
          <div class="collapsible-row--content">
            <div
              id="{{ id }}"
              class="collapsible-row--inner"
              data-item="{{ description_type }}"
            >
              {%- liquid
                if page_content != blank
                  render 'localized-html', html: pages[page_content].content
                elsif description != blank
                  render 'localized-html', html: description
                endif
              -%}
            </div>
          </div>
        </div>
      {%- endif -%}
    </details>
  </animated-details>
{%- endif -%}

{% stylesheet %}
  /* makes adjacent row blocks fit together */
  [class*='block'][data-fit-together='true'] + [class*='block'][data-fit-together='true'] {
    margin-top: 0;
  }

  .collapsible-row--root {
    --padding-horizontal: var(--spacing--item);
    --padding-vertical: var(--spacing--item);
    background-color: var(--bg-color);

    &[data-spacing-above='true'] {
      margin-top: var(--cr-spacing-above);
    }

    &[data-spacing-below='true'] {
      margin-bottom: var(--cr-spacing-below);
    }

    @media (max-width: 767px) {
      &[data-mobile-spacing-above='true'] {
        margin-top: var(--cr-mobile-spacing-above);
      }

      &[data-mobile-spacing-below='true'] {
        margin-bottom: var(--cr-mobile-spacing-below);
      }
    }

    &:after {
      z-index: 0; /* override border framework */
    }

    &[data-text-color='white'] {
      &:before,
      &:after {
        background-color: var(--border--color-light);
      }
    }

    &[data-view='small'] {
      --padding-vertical: var(--spacing--1);
    }

    .layout--expand {
      --cross-size: calc(var(--font--nav--size) * var(--cross-scale, 1));
      --cross-color: var(--color);
    }

    &[data-view='small'] .layout--expand {
      --cross-scale: 1;
    }

    &[data-view='large'] .layout--expand {
      --cross-scale: 2;
    }
  } 

  .collapsible-row--toggle {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: var(--spacing--item);
    user-select: none;
    padding: 0;
    color: var(--color);
    width: 100%;
    height: fit-content;
    background-color: transparent;
    text-align: left; /* required when text is two rows */
    padding: var(--padding-vertical) var(--padding-horizontal);
    list-style: none;
    cursor: pointer;
  }

  .collapsible-row--heading {
    padding: 0;
    line-height: var(--spacing--4);
    pointer-events: none;
  }

  .collapsible-row--root[data-heading-font-size='true'] .collapsible-row--heading {
    font-size: var(--cr-heading-size) !important;
    line-height: 1.3;
  }

  .collapsible-row--root[data-mobile-heading-font-size='true'] .collapsible-row--heading {
    @media (max-width: 767px) {
      font-size: var(--cr-mobile-heading-size) !important;
    }
  }

  .collapsible-row--inner {
    padding: 0 var(--padding-horizontal) var(--padding-vertical);
  }

  .collapsible-row--root[open] > .collapsible-row--wrapper .collapsible-row--inner {
    padding-top: var(--cr-content-padding-top, 8px) !important;
    padding-bottom: var(--cr-content-padding-bottom, 8px) !important;
  }

  @media (max-width: 767px) {
    .collapsible-row--root[open][data-mobile-content-padding='true'] > .collapsible-row--wrapper .collapsible-row--inner {
      padding-top: var(--cr-mobile-content-padding-top, var(--cr-content-padding-top, 8px)) !important;
      padding-bottom: var(--cr-mobile-content-padding-bottom, var(--cr-content-padding-bottom, 8px)) !important;
    }
  }

  .collapsible-row--root[data-text-font-size='true'] .collapsible-row--inner,
  .collapsible-row--root[data-text-font-size='true'] .collapsible-row--inner p,
  .collapsible-row--root[data-text-font-size='true'] .collapsible-row--inner li {
    font-size: var(--cr-text-size) !important;
  }

  .collapsible-row--root[data-mobile-text-font-size='true'] .collapsible-row--inner,
  .collapsible-row--root[data-mobile-text-font-size='true'] .collapsible-row--inner p,
  .collapsible-row--root[data-mobile-text-font-size='true'] .collapsible-row--inner li {
    @media (max-width: 767px) {
      font-size: var(--cr-mobile-text-size) !important;
    }
  }

  .collapsible-row--chevron {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    line-height: 0;
    transition: transform 0.25s ease;
  }

  .collapsible-row--chevron svg {
    width: 12px;
    height: 12px;
  }

  .collapsible-row--root[open] > .collapsible-row--toggle .collapsible-row--chevron {
    transform: rotate(180deg);
  }
{% endstylesheet %}
