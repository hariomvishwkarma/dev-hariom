<!-- snippets/consent-tracking.liquid -->

{%- doc -%}
  Renders the popup consent tracking block used in `sections/popup`.
  @param {block} block - Popup block settings.
{%- enddoc -%}

{%- liquid
  assign accept_t = 'general.consent_tracking.accept' | t
  assign decline_t = 'general.consent_tracking.decline' | t

  assign accept_button_style = block.settings.accept-button-style
  assign bg_color = block.settings.background-color
  assign decline_button_style = block.settings.decline-button-style
  assign description = block.settings.description
  assign heading = block.settings.heading
  assign position = block.settings.position
  assign text_alignment = block.settings.text-alignment
  assign text_color = block.settings.text-color
  assign translucent = block.settings.translucent
-%}

<consent-tracking
  class="consent-tracking--root"
  data-block-id="{{ block.id | camelize }}"
  data-background-color="{{ bg_color }}"
  data-translucent="{{ translucent }}"
  data-text-color="{{ text_color }}"
  data-position="{{ position }}"
  data-x-alignment="{{ text_alignment }}"
  aria-hidden="true"
  {{ block.shopify_attributes }}
>
  <div class="consent-tracking--wrapper" data-container="block">
    {%- unless heading == blank -%}
      <h3 class="consent-tracking--heading" data-item="block-heading">
        {{ heading }}
      </h3>
    {%- endunless -%}

    {%- unless description == blank -%}
      <div class="consent-tracking--description" data-item="rte-content">
        {{- description -}}
      </div>
    {%- endunless -%}

    <div class="consent-tracking--button-container">
      <button
        class="consent-tracking--accept"
        data-item="{{ accept_button_style }}"
        data-text="{{ accept_t }}"
      >
        <span>{{- accept_t -}}</span>
      </button>

      <button
        class="consent-tracking--decline"
        data-item="{{ decline_button_style }}"
        data-text="{{ decline_t }}"
      >
        <span>{{- decline_t -}}</span>
      </button>
    </div>
  </div>
</consent-tracking>

{% stylesheet %}
  .consent-tracking--root {
    border-radius: 4px;

    .layout--close {
      --cross-size: 20px;
      position: absolute;
      right: var(--spacing--2);
      top: var(--spacing--2);
    }

    &:not([data-position='bottom']) {
      padding: var(--spacing--block);

      @media (min-width: 768px) {
        width: calc(100% - 2 * var(--spacing--block));
        max-width: 500px;
      }

      @media (max-width: 767px) {
        width: calc(100% - 2 * var(--spacing--item));
        bottom: var(--spacing--item);
      }

      @media (min-width: 768px) {
        bottom: var(--spacing--block);
      }
    }

    &[data-position='bottom'] {
      left: var(--spacing--item);
      right: var(--spacing--item);
      bottom: var(--spacing--item);

      @media (max-width: 767px) {
        width: calc(100% - 2 * var(--spacing--item));
        padding: var(--spacing--block);
      }

      @media (min-width: 768px) {
        width: fit-content;
        margin: 0 auto;
        padding: var(--spacing--item) var(--spacing--block);
      }
    }
  }

  .consent-tracking--wrapper {
    align-items: var(--x-alignment);
    text-align: var(--text-alignment);

    @media (min-width: 768px) {
      .consent-tracking--root[data-position='bottom'] & {
        flex-direction: row;
        justify-content: center;
        align-items: center;
      }
    }
  }

  .consent-tracking--heading {
    @media (min-width: 768px) {
      .consent-tracking--root[data-position='bottom'] & {
        display: none;
      }
    }
  }

  .consent-tracking--button-container {
    display: flex;
    gap: var(--spacing--item);
    text-transform: capitalize;

    @media (max-width: 767px) {
      flex-direction: column;
      width: 100%;

      > * {
        width: 100%;
      }
    }

    @media (min-width: 768px) {
      .consent-tracking--root[data-x-alignment='center'] & {
        justify-content: center;
      }

      .consent-tracking--root[data-x-alignment='right'] & {
        justify-content: flex-end;
      }
    }
  }
{% endstylesheet %}