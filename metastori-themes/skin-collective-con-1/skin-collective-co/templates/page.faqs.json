            "default-open": false
          }
        },
        "collapsible_row_F8By36": {
          "type": "collapsible-row",
          "disabled": true,
          "settings": {
            "heading": "I forgot my password",
            "description": "<p>As of February 2026, Shopify apparently deprecated its legacy password-based customer accounts in favour of asswordless login. New stores can only use the new system: customers sign in with their email and a one-time 6-digit code (or Shop/Google/Facebook sign-in) - there's no password to forget or reset. Since Skin Collective hasn't launched yet, it'll be built on the new system by default, so in case this is true, we can rewrite the FAQ regarding the password to this:</p>",
            "page-content": "",
            "default-open": false
          }
        },
        "collapsible_row_tapRJY": {
          "type": "collapsible-row",
          "disabled": true,
          "settings": {
            "heading": "HOW DO I ACCESS MY ACCOUNT?",
            "description": "<p>Simply enter your email address and we'll send you a one-time verification code to access your account. You don't need a password.</p>",
            "page-content": "",
            "default-open": false
          }
        },
        "collapsible_row_7wj8X9": {
