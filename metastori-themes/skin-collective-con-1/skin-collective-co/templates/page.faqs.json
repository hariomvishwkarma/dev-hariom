            "default-open": false
          }
        },
        "collapsible_row_iyqXGb": {
          "type": "collapsible-row",
          "settings": {
            "heading": "CAN I SEND A GIFT DIRECTLY TO SOMEONE?",
            "description": "<p>Yes. Simply enter the recipient's shipping address during checkout.</p><p>If you'd like to include a personal message, you can add it using the <strong>Gift Message</strong> field before completing your purchase. We never include pricing information with gift orders, allowing your gift to be sent directly to the recipient.</p>",
            "page-content": "",
            "default-open": false
