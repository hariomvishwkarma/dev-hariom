        "collapsible_row_BrCJma": {
          "type": "collapsible-row",
          "settings": {
            "heading": "HOW LONG WILL DELIVERY TAKE?",
            "description": "<p>Orders are typically processed within one business day before being dispatched.  nce your order has been dispatched, you'll receive a confirmation email with tracking details.</p><p>Deliveries are made on business days, excluding public holidays. Estimated delivery times vary depending on the destination and will be shown during checkout.</p>",
            "page-content": "",
            "default-open": false
          }
        },
        "collapsible_row_BWCUHH": {
          "type": "collapsible-row",
          "settings": {
            "heading": "DO I HAVE TO PAY CUSTOMS OR IMPORT DUTIES?",
            "description": "<p>Orders delivered within the EU customs and VAT territory are not subject to customs duties or import taxes.</p><p>For destinations subject to special tax or customs regimes, or outside the European Union, any applicable customs duties, import taxes or local charges are the responsibility of the customer.</p>",
            "page-content": "",
            "default-open": false
          }
