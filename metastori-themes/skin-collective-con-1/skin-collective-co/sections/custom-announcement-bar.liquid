<!-- sections/custom-announcement-bar.liquid -->
{%- comment -%}
  Custom announcement bar (Skin Collective).
  Separate from theme Announcement bar — do not modify sections/announcement.liquid.
{%- endcomment -%}

{%- liquid
  assign text = section.settings.text
  assign link = section.settings.link
  assign show_close = section.settings.show-close
  assign bg_color = section.settings.background-color
  assign text_color = section.settings.text-color

  assign font_size = section.settings.font-size | default: 14
  assign mobile_font_size = section.settings.mobile-font-size | default: 10
  assign tablet_font_size = section.settings.tablet-font-size | default: 0

  assign pad_top = section.settings.padding-top | default: 15
  assign pad_bottom = section.settings.padding-bottom | default: 15
  assign pad_left = section.settings.padding-left | default: 24
  assign pad_right = section.settings.padding-right | default: 24

  assign mobile_pad_top = section.settings.mobile-padding-top | default: 11
  assign mobile_pad_bottom = section.settings.mobile-padding-bottom | default: 10
  assign mobile_pad_left = section.settings.mobile-padding-left | default: 70
  assign mobile_pad_right = section.settings.mobile-padding-right | default: 71

  assign tablet_pad_top = section.settings.tablet-padding-top | default: 0
  assign tablet_pad_bottom = section.settings.tablet-padding-bottom | default: 0
  assign tablet_pad_left = section.settings.tablet-padding-left | default: 0
  assign tablet_pad_right = section.settings.tablet-padding-right | default: 0

  if tablet_font_size == 0
    assign tablet_font_size = font_size
  endif
  if tablet_pad_top == 0
    assign tablet_pad_top = pad_top
  endif
  if tablet_pad_bottom == 0
    assign tablet_pad_bottom = pad_bottom
  endif
  if tablet_pad_left == 0
    assign tablet_pad_left = pad_left
  endif
  if tablet_pad_right == 0
    assign tablet_pad_right = pad_right
  endif

  assign mw_enabled = section.settings.custom-max-width-enabled
  assign mw = section.settings.custom-max-width | default: 1152

  assign close_t = 'general.a11y.close' | t
-%}

{%- unless text == blank -%}
  <div
    id="custom-announcement-{{ section.id }}"
    class="custom-announcement--root layout-full-width klaviyo_form_trigger"
    data-section-id="{{ section.id }}"
    data-show-close="{{ show_close }}"
    {% if mw_enabled %}data-max-width="true"{% endif %}
    style="
      --cab-bg: {{ bg_color }};
      --cab-color: {{ text_color }};
      --cab-font-size: {{ font_size }}px;
      --cab-tablet-font-size: {{ tablet_font_size }}px;
      --cab-mobile-font-size: {{ mobile_font_size }}px;
      --cab-pad-top: {{ pad_top }}px;
      --cab-pad-bottom: {{ pad_bottom }}px;
      --cab-pad-left: {{ pad_left }}px;
      --cab-pad-right: {{ pad_right }}px;
      --cab-tablet-pad-top: {{ tablet_pad_top }}px;
      --cab-tablet-pad-bottom: {{ tablet_pad_bottom }}px;
      --cab-tablet-pad-left: {{ tablet_pad_left }}px;
      --cab-tablet-pad-right: {{ tablet_pad_right }}px;
      --cab-mobile-pad-top: {{ mobile_pad_top }}px;
      --cab-mobile-pad-bottom: {{ mobile_pad_bottom }}px;
      --cab-mobile-pad-left: {{ mobile_pad_left }}px;
      --cab-mobile-pad-right: {{ mobile_pad_right }}px;
      {% if mw_enabled %}--cab-inner-max-width: {{ mw }}px;{% endif %}
    "
  >
    <div class="custom-announcement--inner">
      {%- if link != blank -%}
        <a class="custom-announcement--text" href="{{ link }}">
          {{- text | escape -}}
        </a>
      {%- else -%}
        <p class="custom-announcement--text">
          {{- text | escape -}}
        </p>
      {%- endif -%}

      {%- if show_close -%}
        <button
          type="button"
          class="custom-announcement--close layout--close"
          aria-label="{{ close_t }}"
          data-custom-announcement-close
        >
          {% comment %} <span aria-hidden="true">
            <svg xmlns="http://www.w3.org/2000/svg" width="13" height="12" viewBox="0 0 13 12" fill="none">
            <path d="M0.679688 0.734234L11.8865 11.0964" stroke="white" stroke-width="2" stroke-linejoin="round"/>
            <path d="M11.8865 0.734234L0.679688 11.0964" stroke="white" stroke-width="2" stroke-linejoin="round"/>
            </svg>
          </span> {% endcomment %}
        </button>
      {%- endif -%}
    </div>
  </div>
<script type="text/javascript">
  (function () {
    var trigger = document.querySelector('.custom-announcement--root.klaviyo_form_trigger');
    if (!trigger) return;

    trigger.addEventListener('click', function () {
      window._klOnsite = window._klOnsite || [];
      window._klOnsite.push(['openForm', '{% render 'klaviyo-form-id' %}']);
    });
  })();
</script>
  {%- if show_close -%}
    <script>
      (function () {
        var root = document.getElementById('custom-announcement-{{ section.id }}');
        if (!root) return;
        var key = 'cab-dismissed-{{ section.id }}';
        try {
          if (sessionStorage.getItem(key) === '1') {
            root.setAttribute('hidden', '');
            root.style.display = 'none';
            return;
          }
        } catch (e) {}
        var btn = root.querySelector('[data-custom-announcement-close]');
        if (!btn) return;
        btn.addEventListener('click', function () {
          root.setAttribute('hidden', '');
          root.style.display = 'none';
          try {
            sessionStorage.setItem(key, '1');
          } catch (e) {}
        });
      })();
    </script>
  {%- endif -%}
{%- endunless -%}

{% stylesheet %}
  .custom-announcement--root[data-max-width='true'] .custom-announcement--inner {
    width: 100%;
    max-width: var(--cab-inner-max-width, none);
    margin-inline: auto;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Custom announcement bar",
  "class": "section--custom-announcement",
  "tag": "aside",
  "settings": [
    {
      "type": "header",
      "content": "Section max width"
    },
    {
      "type": "checkbox",
      "id": "custom-max-width-enabled",
      "label": "Override max width",
      "default": false,
      "info": "Limits the text/content width. Background stays full width."
    },
    {
      "type": "range",
      "id": "custom-max-width",
      "label": "Max width",
      "min": 600,
      "max": 1920,
      "step": 20,
      "unit": "px",
      "default": 1160,
      "visible_if": "{{ section.settings.custom-max-width-enabled == true }}"
    },
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "text",
      "label": "Text",
      "default": "Join the Skin Collective Co. community and receive 10% off your first purchase."
    },
    {
      "type": "url",
      "id": "link",
      "label": "Link"
    },
    {
      "type": "checkbox",
      "id": "show-close",
      "label": "Show close button",
      "default": true
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "background-color",
      "label": "Background",
      "default": "#A8A8D4"
    },
    {
      "type": "color",
      "id": "text-color",
      "label": "Text",
      "default": "#FFFFFF"
    },
    {
      "type": "header",
      "content": "Font size"
    },
    {
      "type": "range",
      "id": "font-size",
      "label": "Desktop font size",
      "min": 8,
      "max": 28,
      "step": 1,
      "unit": "px",
      "default": 14
    },
    {
      "type": "range",
      "id": "tablet-font-size",
      "label": "Tablet font size",
      "min": 0,
      "max": 28,
      "step": 1,
      "unit": "px",
      "default": 0,
      "info": "0 uses desktop size."
    },
    {
      "type": "range",
      "id": "mobile-font-size",
      "label": "Mobile font size",
      "min": 8,
      "max": 24,
      "step": 1,
      "unit": "px",
      "default": 10
    },
    {
      "type": "header",
      "content": "Desktop padding"
    },
    {
      "type": "range",
      "id": "padding-top",
      "label": "Padding top",
      "min": 0,
      "max": 60,
      "step": 1,
      "unit": "px",
      "default": 15
    },
    {
      "type": "range",
      "id": "padding-bottom",
      "label": "Padding bottom",
      "min": 0,
      "max": 60,
      "step": 1,
      "unit": "px",
      "default": 15
    },
    {
      "type": "range",
      "id": "padding-left",
      "label": "Padding left",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 24
    },
    {
      "type": "range",
      "id": "padding-right",
      "label": "Padding right",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 24
    },
    {
      "type": "header",
      "content": "Tablet padding"
    },
    {
      "type": "range",
      "id": "tablet-padding-top",
      "label": "Tablet padding top",
      "min": 0,
      "max": 60,
      "step": 1,
      "unit": "px",
      "default": 0,
      "info": "0 uses desktop."
    },
    {
      "type": "range",
      "id": "tablet-padding-bottom",
      "label": "Tablet padding bottom",
      "min": 0,
      "max": 60,
      "step": 1,
      "unit": "px",
      "default": 0,
      "info": "0 uses desktop."
    },
    {
      "type": "range",
      "id": "tablet-padding-left",
      "label": "Tablet padding left",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0,
      "info": "0 uses desktop."
    },
    {
      "type": "range",
      "id": "tablet-padding-right",
      "label": "Tablet padding right",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0,
      "info": "0 uses desktop."
    },
    {
      "type": "header",
      "content": "Mobile padding"
    },
    {
      "type": "range",
      "id": "mobile-padding-top",
      "label": "Mobile padding top",
      "min": 0,
      "max": 60,
      "step": 1,
      "unit": "px",
      "default": 11
    },
    {
      "type": "range",
      "id": "mobile-padding-bottom",
      "label": "Mobile padding bottom",
      "min": 0,
      "max": 60,
      "step": 1,
      "unit": "px",
      "default": 10
    },
    {
      "type": "range",
      "id": "mobile-padding-left",
      "label": "Mobile padding left",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 70
