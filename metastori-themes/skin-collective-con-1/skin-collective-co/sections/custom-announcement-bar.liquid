      "label": "Mobile padding right",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 71
    }
  ],
  "presets": [
    {
      "name": "Custom announcement bar",
      "category": "Header"
    }
  ],
  "enabled_on": {
    "groups": ["header"]
  }
}
{% endschema %}
