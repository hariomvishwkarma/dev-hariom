<!-- sections/featured-collection.liquid -->
{%- liquid
  assign metafield_products = blank
  if request.page_type == 'article'
    assign metafield_products = article.metafields.custom.featured_products.value
  endif
  assign product_list = section.settings.product-list
  assign collection = collections[section.settings.collection]

  assign products = blank
  if metafield_products != blank
    assign products = metafield_products
  elsif product_list != blank
    assign products = product_list
  elsif collection != blank
    assign products = collection.products
  endif

  assign products_count = 0
  for product_entry in products
    assign products_count = products_count | plus: 1
  endfor

  assign show_section = false
  if products_count > 0 or section.settings.collection != blank or product_list != blank
    assign show_section = true
  endif
-%}

{%- unless show_section -%}
  <style>
    #shopify-section-{{ section.id }},
    .shopify-section-{{ section.id }} {
      display: none !important;
    }
  </style>
{%- else -%}
{%- render 'section-max-width' -%}
{%- render 'section-padding' -%}

{%- liquid
  assign skip_link_t = 'sections.featured_collection.skip_link' | t

  assign bg_color = section.settings.background-color
  assign border = section.settings.border
  assign button_style = section.settings.button-style
  assign button_text = section.settings.button-text
  assign container_width = section.settings.container-width
  assign columns = section.settings.columns | plus: 0
  assign display_type = section.settings.display-type
  assign heading = section.settings.heading
  assign heading_type = section.settings.heading-type
  assign max_blocks = section.settings.max-blocks
  assign mobile_columns = section.settings.mobile-columns | plus: 0
  assign mobile_layout = section.settings.mobile-layout | default: 'default'
  assign mobile_full_width = false
  assign mobile_heading_alignment = section.settings.mobile-heading-alignment
  assign mobile_spacing_above = section.settings.mobile-spacing-above
  assign mobile_spacing_below = section.settings.mobile-spacing-below
  assign section_alignment = section.settings.section-alignment
  assign spacing_above = section.settings.spacing-above
  assign spacing_below = section.settings.spacing-below
  assign text_color = section.settings.text-color

  assign content_width = section.settings.content-width | default: 'full'
  assign product_image_ratio = section.settings.product-image-ratio | default: 'theme'
  assign custom_image_height = section.settings.custom-image-height | default: 0
  assign tablet_custom_image_height = section.settings.tablet-custom-image-height | default: 0
  assign mobile_custom_image_height = section.settings.mobile-custom-image-height | default: 0
  assign mobile_product_image_ratio = section.settings.mobile-product-image-ratio | default: 'theme'
  assign heading_font_size = section.settings.heading-font-size | default: 0
  assign product_title_font_size = section.settings.product-title-font-size | default: 0
  assign product_price_font_size = section.settings.product-price-font-size | default: 0
  assign tablet_heading_font_size = section.settings.tablet-heading-font-size | default: 0
  assign tablet_product_title_font_size = section.settings.tablet-product-title-font-size | default: 0
  assign tablet_product_price_font_size = section.settings.tablet-product-price-font-size | default: 0
  assign mobile_heading_font_size = section.settings.mobile-heading-font-size | default: 0
  assign mobile_product_title_font_size = section.settings.mobile-product-title-font-size | default: 0
  assign mobile_product_price_font_size = section.settings.mobile-product-price-font-size | default: 0
  assign show_carousel_arrows = section.settings.show-carousel-arrows
  if show_carousel_arrows == nil
    assign show_carousel_arrows = true
  endif
  assign show_next_peek = false
  if section.settings.show-next-peek
    assign show_next_peek = true
  endif
  assign mobile_show_next_peek = false
  if section.settings.mobile-show-next-peek
    assign mobile_show_next_peek = true
  endif

  assign carousel_spacing = true
  assign mobile_carousel_spacing = true
  if content_width == 'full' or content_width == 'container'
    comment
      Desktop/tablet: no theme bleed (we align to 1152 guide).
      Mobile: keep theme bleed (full-width to the right) like text-columns;
      section overflow clip prevents body horizontal scroll.
    endcomment
    assign carousel_spacing = false
  endif

  assign full_width = false
  if container_width == '6'
    assign full_width = true
  endif

  assign onboarding = true
  if products_count > 0
    assign onboarding = false
  endif

  capture sizes
    render 'sizes-grid', columns: columns, container_width: container_width, mobile_columns: mobile_columns, mobile_full_width: mobile_full_width
  endcapture

  assign promo_grid_blocks = 0
  for block in section.blocks
    assign block_position = block.settings.position
    if block_position > max_blocks
      continue
    endif

    assign promo_width = block.settings.promo-width | plus: 0
    assign promo_columns = columns | divided_by: promo_width
    assign mobile_promo_columns = 1
    if promo_width == 1 and mobile_columns == 2
      assign mobile_promo_columns = 2
    endif

    capture promo_sizes
      render 'sizes-grid', columns: promo_columns, container_width: container_width, mobile_columns: mobile_promo_columns, mobile_full_width: mobile_full_width
    endcapture

    comment
      This logic lets a double-wide block render at the end even if there's only space for one block
    endcomment
    if block_position == max_blocks
      assign promo_grid_blocks = promo_grid_blocks | plus: 1
    else
      assign promo_grid_blocks = promo_grid_blocks | plus: promo_width
    endif

    capture promo_html
      unless promo_html == blank
        echo promo_html | append: '<span class="divider"></span>'
      endunless

      assign loading = 'lazy'
      if block_position <= columns and section.index < 3
        assign loading = 'eager'
      endif

      render 'collection-promo', section_id: section.id, block: block, promo_width: promo_width, sizes: promo_sizes, loading: loading, full_width: full_width
    endcapture
  endfor

  assign promo_html_arr = promo_html | split: '<span class="divider"></span>'
  assign max_blocks = max_blocks | minus: promo_grid_blocks | plus: promo_html_arr.size

  capture grid_items
    assign product_index = 0

    for i in (1..max_blocks)
      assign grid_index = forloop.index
      assign promo_index = false
      assign loading = 'lazy'
      if forloop.index <= columns and section.index < 3
        assign loading = 'eager'
      endif

      for block in section.blocks
        if block.settings.position == grid_index
          assign promo_index = forloop.index0
          break
        endif
      endfor

      if promo_index
        echo promo_html_arr[promo_index]
      elsif onboarding
        capture placeholder_index
          cycle '1', '2', '3', '4', '5', '6'
        endcapture

        render 'product-card', onboarding: true, placeholder_index: placeholder_index, transition_id: section.id, full_width: full_width
      elsif product_index < products_count
        assign product = nil
        assign seek_index = 0
        for product_entry in products
          if seek_index == product_index
            assign product = product_entry
            break
          endif
          assign seek_index = seek_index | plus: 1
        endfor
        assign product_index = product_index | plus: 1
        if product != blank
          render 'product-card', product_item: product, transition_id: section.id, sizes: sizes, loading: loading, full_width: full_width
        endif
      else
        break
      endif
      echo '<span class="divider"></span>'
    endfor
  endcapture

  assign grid_items_arr = grid_items | split: '<span class="divider"></span>'
-%}

<div
  class="featured-collection--root{% if section.settings.full-width %} layout-full-width{% endif %}"
  data-section-id="{{ section.id }}"
  data-background-color="{{ bg_color }}"
  data-border="{{ border }}"
  data-container-width="{{ container_width }}"
  data-content-width="{{ content_width }}"
  data-product-image-ratio="{{ product_image_ratio }}"
  data-mobile-product-image-ratio="{{ mobile_product_image_ratio }}"
  data-mobile-layout="{{ mobile_layout }}"
  data-show-carousel-arrows="{{ show_carousel_arrows }}"
  data-show-next-peek="{{ show_next_peek }}"
  data-mobile-show-next-peek="{{ mobile_show_next_peek }}"
  data-mobile-full-width="{{ mobile_full_width }}"
  data-mobile-spacing-above="{{ mobile_spacing_above }}"
  data-mobile-spacing-below="{{ mobile_spacing_below }}"
  data-text-color="{{ text_color }}"
  data-section-type="index_featured_collection"
  data-spacing-above="{{ spacing_above }}"
  data-spacing-below="{{ spacing_below }}"
  {% if custom_image_height > 0 %}
    data-custom-image-height="true"
  {% endif %}
  {% if tablet_custom_image_height > 0 %}
    data-tablet-custom-image-height="true"
  {% endif %}
  {% if mobile_custom_image_height > 0 %}
    data-mobile-custom-image-height="true"
  {% endif %}
  {% if heading_font_size > 0 %}
    data-heading-font-size="true"
  {% endif %}
  {% if product_title_font_size > 0 %}
    data-product-title-font-size="true"
  {% endif %}
  {% if product_price_font_size > 0 %}
    data-product-price-font-size="true"
  {% endif %}
  {% if tablet_heading_font_size > 0 %}
    data-tablet-heading-font-size="true"
  {% endif %}
  {% if tablet_product_title_font_size > 0 %}
    data-tablet-product-title-font-size="true"
  {% endif %}
  {% if tablet_product_price_font_size > 0 %}
    data-tablet-product-price-font-size="true"
  {% endif %}
  {% if mobile_heading_font_size > 0 %}
    data-mobile-heading-font-size="true"
  {% endif %}
  {% if mobile_product_title_font_size > 0 %}
    data-mobile-product-title-font-size="true"
  {% endif %}
  {% if mobile_product_price_font_size > 0 %}
    data-mobile-product-price-font-size="true"
  {% endif %}
  style="
    --fcol-mobile-cols: {{ mobile_columns }};
    {% if custom_image_height > 0 %}--fcol-image-height: {{ custom_image_height }}px;{% endif %}
    {% if tablet_custom_image_height > 0 %}--fcol-tablet-image-height: {{ tablet_custom_image_height }}px;{% endif %}
    {% if mobile_custom_image_height > 0 %}--fcol-mobile-image-height: {{ mobile_custom_image_height }}px;{% endif %}
    {% if heading_font_size > 0 %}--fcol-heading-font-size: {{ heading_font_size }}px;{% endif %}
    {% if product_title_font_size > 0 %}--fcol-product-title-font-size: {{ product_title_font_size }}px;{% endif %}
    {% if product_price_font_size > 0 %}--fcol-product-price-font-size: {{ product_price_font_size }}px;{% endif %}
    {% if tablet_heading_font_size > 0 %}--fcol-tablet-heading-font-size: {{ tablet_heading_font_size }}px;{% endif %}
    {% if tablet_product_title_font_size > 0 %}--fcol-tablet-product-title-font-size: {{ tablet_product_title_font_size }}px;{% endif %}
    {% if tablet_product_price_font_size > 0 %}--fcol-tablet-product-price-font-size: {{ tablet_product_price_font_size }}px;{% endif %}
    {% if mobile_heading_font_size > 0 %}--fcol-mobile-heading-font-size: {{ mobile_heading_font_size }}px;{% endif %}
    {% if mobile_product_title_font_size > 0 %}--fcol-mobile-product-title-font-size: {{ mobile_product_title_font_size }}px;{% endif %}
    {% if mobile_product_price_font_size > 0 %}--fcol-mobile-product-price-font-size: {{ mobile_product_price_font_size }}px;{% endif %}
  "
>
  <div class="featured-collection--wrapper" data-container="section">
    {%- unless heading == blank and display_type == 'grid' -%}
      <div
        class="featured-collection--header-nav"
        data-container="nav"
        data-x-alignment="{{ section_alignment }}"
        data-mobile-x-alignment="{{ mobile_heading_alignment }}"
      >
        <div class="featured-collection--header" data-container="block">
          {%- unless heading == blank -%}
            <h2
              class="featured-collection--title"
              data-item="{{ heading_type }}"
              {% unless settings.transitions--text %}
                data-transition-item="viewport"
                data-transition-type="slide-in"
              {% endunless %}
            >
              {%- if collection.url != blank -%}
                <a href="{{ collection.url }}">
                  {{- heading -}}
                </a>
              {%- else -%}
                {{- heading -}}
              {%- endif -%}
            </h2>
          {%- endunless -%}
        </div>

        {%- liquid
          if display_type == 'slideshow' and show_carousel_arrows
            assign blocks_per_slide_desktop = columns | plus: 0.0
            assign blocks_per_slide_mobile = mobile_columns | plus: 0.0
            assign total_slides = grid_items_arr.size | divided_by: blocks_per_slide_desktop | ceil
            assign total_slides_mobile = grid_items_arr.size | divided_by: blocks_per_slide_mobile | ceil
            render 'carousel-nav-arrow', id: section.id, total_slides_mobile: total_slides_mobile, total_slides: total_slides, text_color: text_color
          endif
        -%}
      </div>
    {%- endunless -%}

    <div
      class="featured-collection--products"
      data-display-type="{{ display_type }}"
      {% if display_type == 'grid' %}
        data-container="panel"
        data-columns="{{ columns }}"
        data-mobile-columns="{{ mobile_columns }}"
      {% endif %}
      {% unless settings.transitions--other %}
        data-transition-container="{{ section.id }}"
        data-transition-type="fade-in"
        data-transition-cascade="horizontal"
        data-transition-cascade-interval="200"
      {% endunless %}
    >
      {%- if products_count > max_blocks -%}
        <a data-item="a11y-button" href="#featured_collection_show_more">
          {{- skip_link_t -}}
        </a>
      {%- endif -%}

      {%- if display_type == 'slideshow' -%}
        {%- liquid
          if show_next_peek
            assign next_visible_value = true
          else
            assign next_visible_value = false
          endif
          if mobile_show_next_peek
            assign mobile_next_visible_value = true
          else
            assign mobile_next_visible_value = false
          endif
        -%}
        {%-
          render 'card-carousel',
          section: section,
          blocks: grid_items_arr,
          blocks_per_slide: columns,
          blocks_per_slide_mobile: mobile_columns,
          spacing_around_blocks: carousel_spacing,
          mobile_spacing_around_blocks: mobile_carousel_spacing,
          total_blocks: grid_items_arr.size,
          next_visible: next_visible_value,
          mobile_next_visible: mobile_next_visible_value
        -%}

      {%- else -%}
        {%- liquid
          for grid_item in grid_items_arr
            echo grid_item
          endfor

          assign remainder = grid_items_arr.size | modulo: columns
          assign blank_count = 0
          if remainder > 0
            assign blank_count = columns | minus: remainder
          endif
        -%}

        {%- if blank_count > 0 -%}
          {%- for i in (1..blank_count) -%}
            <div
              data-item="blank"
              aria-hidden="true"
              {% unless settings.transitions--other %}
                data-transition-item="{{ section.id }}"
              {% endunless %}
            ></div>
          {%- endfor -%}
        {%- endif -%}
      {%- endif -%}
    </div>

    {%- if mobile_layout == 'grid' or mobile_layout == 'slider' -%}
      {%- if grid_items_arr.size > 0 -%}
        <div class="featured-collection--mobile-simple" role="list">
          {%- for grid_item in grid_items_arr -%}
            <div class="featured-collection--mobile-simple-item" role="listitem">
              {{- grid_item -}}
            </div>
          {%- endfor -%}
        </div>
      {%- endif -%}
    {%- endif -%}

    {%- unless button_text == blank -%}
      <div data-container="block" data-x-alignment="{{ section_alignment }}">
        <a
          id="featured_collection_show_more"
          href="{{ collection.url }}"
          class="featured-collection--show-more"
          data-text="{{ button_text }}"
          data-item="{{ button_style }}"
        >
          <span>{{- button_text -}}</span>
        </a>
      </div>
    {%- endunless -%}
  </div>
</div>
{%- endunless -%}

{% stylesheet %}
  .featured-collection--root {
    :is(.collection-promo--root, .card-carousel--block) {
      height: 100%;
    }
  }

  .featured-collection--item {
    @media (max-width: 767px) {
      width: 100%;

      .placeholder--root {
        min-height: 256px;
      }
    }
  }

  /* Mobile "Grid" / "Slider" layouts: show all products in a grid or a
     horizontal slider on mobile, independent of the desktop display type. */
  .featured-collection--mobile-simple {
    display: none;
  }

  @media (min-width: 768px) and (max-width: 989px) {
    .featured-collection--mobile-simple {
      display: none !important;
    }
  }

  @media (max-width: 767px) {
    .featured-collection--root[data-mobile-layout='grid'] .featured-collection--products,
    .featured-collection--root[data-mobile-layout='grid'] .carousel-nav-arrow,
    .featured-collection--root[data-mobile-layout='slider'] .featured-collection--products,
    .featured-collection--root[data-mobile-layout='slider'] .carousel-nav-arrow {
      display: none !important;
    }

    .featured-collection--root[data-mobile-layout='grid'] .featured-collection--mobile-simple {
      display: grid;
      grid-template-columns: repeat(var(--fcol-mobile-cols, 1), minmax(0, 1fr));
      gap: var(--spacing--1, 12px);
      width: 100%;
    }

    .featured-collection--root[data-mobile-layout='slider'] .featured-collection--mobile-simple {
      display: flex;
      flex-wrap: nowrap;
      gap: var(--spacing--1, 12px);
      overflow-x: auto;
      overflow-y: hidden;
      -webkit-overflow-scrolling: touch;
      scrollbar-width: none;
      -ms-overflow-style: none;
      width: 100%;
      padding-bottom: 2px;
    }

    .featured-collection--root[data-mobile-layout='slider'] .featured-collection--mobile-simple::-webkit-scrollbar {
      display: none;
      width: 0;
      height: 0;
    }

    .featured-collection--root[data-mobile-layout='slider'] .featured-collection--mobile-simple-item {
      flex: 0 0 calc((100% - (var(--fcol-mobile-cols, 1) - 1) * var(--spacing--1, 12px)) / var(--fcol-mobile-cols, 1));
    }

    .featured-collection--mobile-simple-item > * {
      width: 100%;
      height: 100%;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Featured collection",
  "class": "section--featured-collection",
  "settings": [
    {
      "type": "header",
      "content": "Section max width"
    },
    {
      "type": "checkbox",
      "id": "full-width",
      "label": "Full width",
      "default": false,
      "info": "Edge to edge. Overrides the max width below."
    },
    {
      "type": "checkbox",
      "id": "custom-max-width-enabled",
      "label": "Override max width",
      "default": false,
      "info": "Overrides the section's existing width with the value below."
    },
    {
      "type": "range",
      "id": "custom-max-width",
      "label": "Max width",
      "min": 600,
      "max": 1920,
      "step": 20,
      "unit": "px",
      "default": 1160
    },
    {
      "type": "header",
      "content": "Section padding"
    },
    {
      "type": "checkbox",
      "id": "custom-padding-enabled",
      "label": "Override padding",
      "default": false,
      "info": "Overrides the section's existing top/bottom spacing. Tablet auto = 75% of desktop."
    },
    {
      "type": "range",
      "id": "custom-padding-top",
      "label": "Desktop padding top",
      "min": 80,
      "max": 180,
      "step": 1,
      "unit": "px",
      "default": 100
    },
    {
      "type": "range",
      "id": "custom-padding-bottom",
      "label": "Desktop padding bottom",
      "min": 80,
      "max": 180,
      "step": 1,
      "unit": "px",
      "default": 100
    },
    {
      "type": "range",
      "id": "custom-mobile-padding-top",
      "label": "Mobile padding top",
      "min": 20,
      "max": 120,
      "step": 1,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "custom-mobile-padding-bottom",
      "label": "Mobile padding bottom",
      "min": 20,
      "max": 120,
      "step": 1,
      "unit": "px",
      "default": 40
    },
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "product_list",
      "id": "product-list",
      "label": "Products",
      "limit": 12,
      "info": "Products selected here will overwrite the collection. Connect an article product list metafield to show different products per blog post."
    },
    {
      "label": "Heading",
      "id": "heading",
      "type": "text",
      "default": "Collection name"
    },
    {
      "id": "button-text",
      "label": "Button text",
      "type": "text",
      "default": "Button"
    },
    {
      "id": "button-style",
      "label": "Button style",
      "type": "select",
      "options": [
        {
          "label": "Style 1",
          "value": "button-1"
        },
        {
          "label": "Style 2",
          "value": "button-2"
        },
        {
          "label": "Style 3",
          "value": "button-3"
        },
        {
          "label": "Style 4",
          "value": "button-4"
        },
        {
          "label": "Link",
          "value": "block-link"
        }
      ],
      "default": "button-1"
    },
    {
      "type": "header",
      "content": "General layout"
    },
    {
      "id": "border",
      "label": "Border",
      "type": "select",
      "options": [
        {
          "label": "Top",
          "value": "top"
        },
        {
          "label": "Bottom",
          "value": "bottom"
        },
        {
          "label": "Both",
          "value": "both"
        },
        {
          "label": "None",
          "value": "none"
        }
      ],
      "default": "none"
    },
    {
      "id": "spacing-above",
      "label": "Spacing above",
      "type": "select",
      "options": [
        {
          "label": "None",
          "value": "none"
        },
        {
          "label": "Small",
          "value": "small"
        },
        {
          "label": "Medium",
          "value": "medium"
        },
        {
          "label": "Large",
          "value": "large"
        },
        {
          "label": "Extra large",
          "value": "x-large"
        }
      ],
      "default": "large"
    },
    {
      "id": "spacing-below",
      "label": "Spacing below",
      "type": "select",
      "options": [
        {
          "label": "None",
          "value": "none"
        },
        {
          "label": "Small",
          "value": "small"
        },
        {
          "label": "Medium",
          "value": "medium"
        },
        {
          "label": "Large",
          "value": "large"
        },
        {
          "label": "Extra large",
          "value": "x-large"
        }
      ],
      "default": "large"
    },
    {
      "id": "container-width",
      "label": "Maximum container width",
      "type": "select",
      "options": [
        { "label": "Extra large", "value": "5" },
        { "label": "Full width", "value": "6" }
      ],
      "default": "5"
    },
    {
      "id": "content-width",
      "label": "Content width",
      "type": "select",
      "options": [
        { "value": "full", "label": "Full width — from 1152px left" },
        { "value": "container", "label": "Container — max 1152px" }
      ],
      "default": "full",
      "info": "Full width starts on the 1152px container left line (tablet and desktop only) and bleeds right. On mobile, theme default padding and carousel apply. Container caps content at 1152px on tablet+."
    },
    {
      "id": "background-color",
      "label": "Background color",
      "type": "select",
      "options": [
        {
          "label": "None",
          "value": "none"
        },
        {
          "label": "Light",
          "value": "light"
        },
        {
          "label": "Dark",
          "value": "dark"
        },
        {
          "label": "Accent 1",
          "value": "accent-1"
        },
