<!-- sections/recent-products.liquid -->
{%- liquid
  assign hide_recently_viewed = false
  if collection and collection.metafields.custom.hide_recently_viewed.value == true
    assign hide_recently_viewed = true
  endif
-%}

{%- if hide_recently_viewed -%}
  <style>
    #shopify-section-{{ section.id }} {
      display: none !important;
      margin: 0 !important;
      padding: 0 !important;
      height: 0 !important;
      overflow: hidden !important;
    }
  </style>
{%- else -%}

{%- render 'section-max-width' -%}
{%- render 'section-padding' -%}

{%- liquid
  assign bg_color = section.settings.background-color
  assign border = section.settings.border
  assign container_width = section.settings.container-width
  assign columns = section.settings.width
  assign heading = section.settings.heading
  assign heading_alignment = section.settings.heading-alignment
  assign heading_type = section.settings.heading-type
  assign mobile_columns = section.settings.mobile-width | plus: 0
  assign mobile_heading_alignment = section.settings.mobile-heading-alignment
  assign mobile_spacing_above = section.settings.mobile-spacing-above
  assign mobile_spacing_below = section.settings.mobile-spacing-below
  assign spacing_above = section.settings.spacing-above
  assign spacing_below = section.settings.spacing-below
  assign custom_spacing_above = section.settings.custom-spacing-above
  assign mobile_custom_spacing_above = section.settings.mobile-custom-spacing-above
  assign text_color = section.settings.text-color

  assign extra_title_font_size = section.settings.extra-title-font-size
  assign custom_image_height = section.settings.custom-image-height
  assign mobile_extra_title_font_size = section.settings.mobile-extra-title-font-size
  assign mobile_custom_image_height = section.settings.mobile-custom-image-height
  assign tablet_extra_title_font_size = section.settings.tablet-extra-title-font-size
  assign tablet_custom_image_height = section.settings.tablet-custom-image-height

  assign rp_width_class = ''
  if container_width == '6'
    assign rp_width_class = 'layout-full-width'
  elsif container_width == '4' or container_width == '5'
    assign rp_width_class = 'layout-container'
  endif
-%}

<recent-products-element
  class="recent-products--root {{ rp_width_class }}"
  data-section-id="{{ section.id }}"
  data-background-color="{{ bg_color }}"
  data-border="{{ border }}"
  data-container-width="{{ container_width }}"
  data-mobile-spacing-above="{{ mobile_spacing_above }}"
  data-mobile-spacing-below="{{ mobile_spacing_below }}"
  data-spacing-above="{{ spacing_above }}"
  data-spacing-below="{{ spacing_below }}"
  data-text-color="{{ text_color }}"
  {% if extra_title_font_size > 0 %}
    data-extra-title-font-size="true"
  {% endif %}
  {% if custom_image_height > 0 %}
    data-custom-image-height="true"
  {% endif %}
  {% if mobile_extra_title_font_size > 0 %}
    data-mobile-extra-title-font-size="true"
  {% endif %}
  {% if mobile_custom_image_height > 0 %}
    data-mobile-custom-image-height="true"
  {% endif %}
  {% if tablet_extra_title_font_size > 0 %}
    data-tablet-extra-title-font-size="true"
  {% endif %}
  {% if tablet_custom_image_height > 0 %}
    data-tablet-custom-image-height="true"
  {% endif %}
  style="
    {% if extra_title_font_size > 0 %}--rp-title-font-size: {{ extra_title_font_size }}px;{% endif %}
    {% if custom_image_height > 0 %}--rp-image-height: {{ custom_image_height }}px;{% endif %}
    {% if mobile_extra_title_font_size > 0 %}--rp-mobile-title-font-size: {{ mobile_extra_title_font_size }}px;{% endif %}
    {% if mobile_custom_image_height > 0 %}--rp-mobile-image-min-height: {{ mobile_custom_image_height }}px;{% endif %}
    {% if tablet_extra_title_font_size > 0 %}--rp-tablet-title-font-size: {{ tablet_extra_title_font_size }}px;{% endif %}
    {% if tablet_custom_image_height > 0 %}--rp-tablet-image-min-height: {{ tablet_custom_image_height }}px;{% endif %}
    {% if spacing_above == 'custom' %}--custom-spacing-above: {{ custom_spacing_above }}px;{% endif %}
    {% if mobile_spacing_above == 'custom' %}--mobile-custom-spacing-above: {{ mobile_custom_spacing_above }}px;{% endif %}
  "
>
  <div class="recent-products--wrapper" data-container="section">
    {%- unless heading == blank -%}
      <div
        class="recent-products--title"
        data-container="block"
        data-x-alignment="{{ heading_alignment }}"
        data-mobile-x-alignment="{{ mobile_heading_alignment }}"
        {% unless settings.transitions--text %}
          data-transition-item="viewport"
          data-transition-type="slide-in"
        {% endunless %}
      >
        <h2 data-item="{{ heading_type }}">
          {{- heading | escape -}}
        </h2>
      </div>
    {%- endunless -%}

    <div
      class="recent-products--grid"
      data-container="panel"
      data-fixed-columns="true"
      data-x-alignment="{{ heading_alignment }}"
      data-columns="{{ columns }}"
      data-mobile-columns="{{ mobile_columns }}"
      {% unless settings.transitions--other %}
        data-transition-container="{{ section.id }}"
        data-transition-type="fade-in"
        data-transition-cascade="horizontal"
        data-transition-cascade-interval="200"
      {% endunless %}
      aria-hidden="true"
    >
      {%- comment -%} product cards render async here {%- endcomment -%}
    </div>

    <div class="recent-products--spinner" aria-hidden="false">
      {%- render 'icons', icon: 'spinner' -%}
    </div>
  </div>
</recent-products-element>
{%- endif -%}

{% stylesheet %}
  .recent-products--root {
    display: block;

    &[aria-hidden='true'] {
      display: none;
    }
  }

  .recent-products--title {
    @media (max-width: 767px) {
      text-align: center;

      &[data-mobile-x-alignment='left'] {
        text-align: left;
      }

      &[data-mobile-x-alignment='right'] {
        text-align: right;
      }

      &[data-mobile-x-alignment='center'] {
        text-align: center;
      }
    }
  }

  .recent-products--grid {
    &[aria-hidden='true'] {
      display: none;
    }
  }

  .recent-products--spinner {
    display: flex;
    justify-content: center;
    align-items: center;
    padding: var(--spacing--section--y) 0;

    [data-text-color='white'] & {
      fill: white;
    }

    &[aria-hidden='true'] {
      display: none;
    }
  }
{% endstylesheet %}


{% schema %}
{
  "name": "Recent products",
  "class": "section--recent-products",
  "settings": [
    {
      "type": "header",
      "content": "Section max width"
    },
    {
      "type": "checkbox",
      "id": "custom-max-width-enabled",
      "label": "Override max width",
      "default": false,
      "info": "Overrides the section's existing width with the value below."
    },
    {
      "type": "range",
      "id": "custom-max-width",
      "label": "Max width",
      "min": 600,
      "max": 1920,
      "step": 20,
      "unit": "px",
      "default": 1160
    },
    {
      "type": "header",
      "content": "Section padding"
    },
    {
      "type": "checkbox",
      "id": "custom-padding-enabled",
      "label": "Override padding",
      "default": false,
      "info": "Overrides the section's existing top/bottom spacing. Tablet auto = 75% of desktop."
    },
    {
      "type": "range",
      "id": "custom-padding-top",
      "label": "Desktop padding top",
      "min": 80,
      "max": 180,
      "step": 1,
      "unit": "px",
      "default": 100
    },
    {
      "type": "range",
      "id": "custom-padding-bottom",
      "label": "Desktop padding bottom",
      "min": 80,
      "max": 180,
      "step": 1,
      "unit": "px",
      "default": 100
    },
    {
      "type": "range",
      "id": "custom-mobile-padding-top",
      "label": "Mobile padding top",
      "min": 20,
      "max": 120,
      "step": 1,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "custom-mobile-padding-bottom",
      "label": "Mobile padding bottom",
      "min": 20,
      "max": 120,
      "step": 1,
      "unit": "px",
      "default": 40
    },
    {
      "type": "header",
      "content": "Content"
    },
    {
      "label": "Heading",
      "id": "heading",
      "type": "text",
      "default": "Recently viewed"
    },
    {
      "type": "header",
      "content": "General layout"
    },
    {
      "id": "border",
      "label": "Border",
      "type": "select",
      "options": [
        {
          "label": "Top",
          "value": "top"
        },
        {
          "label": "Bottom",
          "value": "bottom"
        },
        {
          "label": "Both",
          "value": "both"
        },
        {
          "label": "None",
          "value": "none"
        }
      ],
      "default": "none"
    },
    {
      "id": "spacing-above",
      "label": "Spacing above",
      "type": "select",
      "options": [
        {
          "label": "None",
          "value": "none"
        },
        {
          "label": "Small",
          "value": "small"
        },
        {
          "label": "Medium",
          "value": "medium"
        },
        {
          "label": "Large",
          "value": "large"
        },
        {
          "label": "Extra large",
          "value": "x-large"
        },
        {
          "label": "Custom top spacing",
          "value": "custom"
        }
      ],
      "default": "large"
    },
    {
      "id": "custom-spacing-above",
      "label": "Custom top spacing",
      "type": "range",
      "min": 1,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 20,
      "visible_if": "{{ section.settings.spacing-above == 'custom' }}"
    },
    {
      "id": "spacing-below",
      "label": "Spacing below",
      "type": "select",
      "options": [
        {
          "label": "None",
          "value": "none"
        },
        {
          "label": "Small",
          "value": "small"
        },
        {
          "label": "Medium",
          "value": "medium"
        },
        {
          "label": "Large",
          "value": "large"
        },
        {
          "label": "Extra large",
          "value": "x-large"
        }
      ],
      "default": "large"
    },
    {
      "id": "container-width",
      "label": "Section width",
      "type": "select",
      "options": [
        { "label": "Container — Medium", "value": "4" },
        { "label": "Container — Extra large", "value": "5" },
        { "label": "Full width", "value": "6" }
      ],
      "default": "5",
      "info": "Container keeps content centered. Full width spans the viewport."
    },
    {
      "id": "background-color",
      "label": "Background color",
      "type": "select",
      "options": [
        {
          "label": "None",
          "value": "none"
        },
        {
          "label": "Light",
          "value": "light"
        },
        {
          "label": "Dark",
          "value": "dark"
        },
        {
          "label": "Accent 1",
          "value": "accent-1"
        },
        {
          "label": "Accent 2",
          "value": "accent-2"
        },
        {
          "label": "Accent 3",
          "value": "accent-3"
        }
      ],
      "default": "none"
    },
    {
      "type": "header",
      "content": "Features"
    },
    {
      "id": "width",
      "label": "Products per row",
      "type": "range",
      "min": 2,
      "max": 6,
      "step": 1,
      "default": 4
    },
    {
      "type": "header",
      "content": "Text layout"
    },
    {
      "id": "heading-type",
      "label": "Heading type",
      "type": "select",
      "options": [
        {
          "label": "Banner",
          "value": "banner-heading"
        },
        {
          "label": "Featured",
          "value": "featured-heading"
        },
        {
          "label": "Large",
          "value": "section-heading"
        },
        {
          "label": "Medium",
          "value": "block-heading"
        }
      ],
      "default": "section-heading"
    },
    {
      "id": "text-color",
      "label": "Text color",
      "type": "select",
      "options": [
        {
          "label": "Light",
          "value": "white"
        },
        {
          "label": "Dark",
          "value": "body"
        }
      ],
      "default": "body"
    },
    {
      "label": "Heading alignment",
      "id": "heading-alignment",
      "type": "text_alignment",
      "default": "center"
    },
    {
      "type": "header",
      "content": "Custom size"
    },
    {
      "type": "range",
      "id": "extra-title-font-size",
      "label": "Product title font size",
      "min": 0,
      "max": 32,
      "step": 1,
      "unit": "px",
      "default": 16,
      "info": "Extra size for product titles. 0 uses the theme product card title style."
    },
    {
      "type": "range",
      "id": "custom-image-height",
      "label": "Image height",
      "min": 0,
      "max": 800,
      "step": 10,
      "unit": "px",
      "default": 0,
      "info": "0 keeps the theme product image ratio. Set a height to override; images still use cover fit."
    },
    {
      "type": "header",
      "content": "Mobile"
    },
    {
      "type": "range",
      "id": "mobile-extra-title-font-size",
      "label": "Mobile product title font size",
      "min": 0,
      "max": 32,
      "step": 1,
      "unit": "px",
      "default": 16,
      "info": "0 uses desktop title size / theme style."
    },
    {
      "type": "range",
      "id": "mobile-custom-image-height",
      "label": "Mobile image height",
      "min": 0,
      "max": 800,
      "step": 10,
      "unit": "px",
      "default": 0,
      "info": "0 keeps theme image ratio. Sets min-height on the product image wrapper."
    },
    {
      "id": "mobile-spacing-above",
      "label": "Spacing above",
      "type": "select",
      "options": [
        {
          "label": "None",
          "value": "none"
        },
        {
          "label": "Small",
          "value": "small"
        },
        {
          "label": "Medium",
          "value": "medium"
        },
        {
          "label": "Large",
          "value": "large"
        },
        {
          "label": "Extra large",
          "value": "x-large"
        },
        {
          "label": "Custom top spacing",
          "value": "custom"
        }
      ],
      "default": "medium"
    },
    {
      "id": "mobile-custom-spacing-above",
      "label": "Custom top spacing",
      "type": "range",
      "min": 1,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 20,
      "visible_if": "{{ section.settings.mobile-spacing-above == 'custom' }}"
    },
    {
      "id": "mobile-spacing-below",
      "label": "Spacing below",
      "type": "select",
      "options": [
        {
          "label": "None",
          "value": "none"
        },
        {
          "label": "Small",
          "value": "small"
        },
        {
          "label": "Medium",
          "value": "medium"
        },
        {
          "label": "Large",
          "value": "large"
        },
        {
          "label": "Extra large",
          "value": "x-large"
        }
      ],
      "default": "medium"
    },
    {
      "id": "mobile-heading-alignment",
      "label": "Heading alignment",
      "type": "text_alignment",
      "default": "left"
    },
    {
      "label": "Products per row on mobile",
      "id": "mobile-width",
      "type": "select",
      "options": [
        { "value": "1", "label": "1" },
        { "value": "2", "label": "2" }
      ],
      "default": "2"
    },
    {
      "type": "header",
      "content": "Tablet"
    },
    {
      "type": "paragraph",
      "content": "Tablet (768–989px) uses the desktop grid layout with optional size overrides below."
    },
    {
      "type": "range",
      "id": "tablet-extra-title-font-size",
      "label": "Tablet product title font size",
      "min": 0,
      "max": 32,
      "step": 1,
      "unit": "px",
      "default": 0,
      "info": "0 uses desktop title size."
    },
    {
      "type": "range",
      "id": "tablet-custom-image-height",
      "label": "Tablet image min height",
      "min": 0,
      "max": 800,
      "step": 10,
      "unit": "px",
      "default": 0,
      "info": "0 keeps theme image ratio. Uses min-height."
    }
  ],
  "presets": [
    {
      "name": "Recent products",
      "category": "Products"
    }
  ],
  "disabled_on": {
    "groups": ["aside"]
  }
}
{% endschema %}
