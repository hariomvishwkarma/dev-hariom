<!-- sections/popup.liquid -->

{%- liquid
  assign load_consent_tracking = false
  assign limit = section.settings.limit

  capture blocks
    for block in section.blocks
      case block.type
        when 'newsletter-small', 'newsletter-large'
          render 'newsletter-popup', block: block
        when 'promotion-bar'
          render 'promotion-bar', block: block
        when 'consent-tracking'
          assign load_consent_tracking = true
          render 'consent-tracking', block: block
      endcase
    endfor
  endcapture
-%}

<div
  class="popup--root"
  data-consent-tracking="{{ load_consent_tracking }}"
  data-limit="{{ limit }}"
>
  {{ blocks }}
</div>

{% stylesheet %}
  .popup--root {
    position: relative;

    > [data-block-id] {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: var(--spacing--item);
      height: fit-content;
      position: fixed;
      z-index: 10;
      user-select: none;
      opacity: 0;
      visibility: hidden;
      scale: 0.9;
      transition:
        opacity 0.2s var(--transition--standard),
        scale 0.2s var(--transition--standard),
        visibility 0.2s var(--transition--standard);

      .layout--close {
        &:before,
        &:after {
          background-color: var(--color);
        }
      }

      .layout--viewport[data-drop-shadows='true'] & {
        box-shadow: var(--box-shadow--center);
      }

      .layout--viewport[data-drop-shadows='false'] & {
        border: var(--border--dark);
      }

      &[data-position='left'] {
        @media (max-width: 767px) {
          left: var(--spacing--item);
        }

        @media (min-width: 768px) {
          left: var(--spacing--block);
          transform-origin: bottom left;
        }
      }

      &[data-position='center'] {
        transform-origin: center center;

        @media (max-width: 767px) {
          left: var(--spacing--item);
          bottom: var(--spacing--item);
        }

        @media (min-width: 768px) {
          top: 50%;
          left: 50%;
          transform: translate(-50%, -50%);
        }
      }

      &[data-position='right'] {
        @media (max-width: 767px) {
          right: var(--spacing--item);
        }

        @media (min-width: 768px) {
          right: var(--spacing--block);
          transform-origin: bottom right;
        }
      }

      &[aria-hidden='true'] {
        display: none;
      }

      &[aria-expanded='true'] {
        opacity: 1;
        visibility: visible;
        scale: 1;
      }
    }
  }
{% endstylesheet %}

