<!-- sections/complete-your-routine.liquid -->
{%- render 'section-max-width' -%}
{%- render 'section-padding' -%}

{%- liquid
  assign bg_color = section.settings.background-color
  assign border = section.settings.border
  assign container_width = section.settings.container-width
  assign spacing_above = section.settings.spacing-above
  assign spacing_below = section.settings.spacing-below
  assign mobile_spacing_above = section.settings.mobile-spacing-above
  assign mobile_spacing_below = section.settings.mobile-spacing-below
  assign text_color = section.settings.text-color | default: 'body'

  assign field_product = 'product'
  assign field_description = 'custom_description'
  assign prefer_routine_when_both = section.settings.prefer-routine-when-both

  assign heading_routine = section.settings.heading-routine | default: 'COMPLETE YOUR ROUTINE'
  assign heading_pair = section.settings.heading-pair | default: 'PAIR WITH'
  assign step_label = section.settings.step-label | default: 'STEP'
  assign badge_routine = section.settings.badge-routine | default: "YOU'RE ON THIS PRODUCT"
  assign badge_current = section.settings.badge-current | default: 'CURRENT PRODUCT'
  assign badge_pair = section.settings.badge-pair | default: 'PAIR IT WITH'
  assign add_label = section.settings.add-label | default: 'ADD TO CART'
  assign in_cart_label = section.settings.in-cart-label | default: 'IN CART'
  assign bulk_routine = section.settings.bulk-routine | default: 'ADD ROUTINE TO CART'
  assign bulk_pair = section.settings.bulk-pair | default: 'ADD ALL TO CART'

  assign heading_font_size = section.settings.heading-font-size | default: 15
  assign step_font_size = section.settings.step-font-size | default: 15
  assign title_font_size = section.settings.title-font-size | default: 15
  assign price_font_size = section.settings.price-font-size | default: 15
  assign description_font_size = section.settings.description-font-size | default: 15
  assign add_font_size = section.settings.add-font-size | default: 15
  assign bulk_font_size = section.settings.bulk-font-size | default: 15

  assign mobile_heading_font_size = section.settings.mobile-heading-font-size | default: 15
  assign mobile_step_font_size = section.settings.mobile-step-font-size | default: 15
  assign mobile_title_font_size = section.settings.mobile-title-font-size | default: 15
  assign mobile_price_font_size = section.settings.mobile-price-font-size | default: 15
  assign mobile_description_font_size = section.settings.mobile-description-font-size | default: 15
  assign mobile_add_font_size = section.settings.mobile-add-font-size | default: 15

  assign badge_color = section.settings.badge-color | default: '#8B9BB4'
  assign bulk_bg = section.settings.bulk-background | default: '#1A1A1A'
  assign bulk_text = section.settings.bulk-text-color | default: '#FFFFFF'

  assign product_image_ratio = section.settings.product-image-ratio | default: 'square'
  assign custom_image_height = section.settings.custom-image-height | default: 0
  assign custom_image_width = section.settings.custom-image-width | default: 0
  assign custom_content_width = section.settings.custom-content-width | default: 0
  assign column_width_unit = section.settings.column-width-unit | default: 'px'
  assign image_column_percent = section.settings.image-column-percent | default: 50
  if image_column_percent < 30
    assign image_column_percent = 30
  endif
  if image_column_percent > 70
    assign image_column_percent = 70
  endif
  assign content_column_percent = 100 | minus: image_column_percent
  assign tablet_custom_image_height = section.settings.tablet-custom-image-height | default: 0
  assign tablet_custom_image_width = section.settings.tablet-custom-image-width | default: 0
  assign tablet_custom_content_width = section.settings.tablet-custom-content-width | default: 0
  assign mobile_product_image_ratio = section.settings.mobile-product-image-ratio | default: 'theme'
  assign mobile_custom_image_height = section.settings.mobile-custom-image-height | default: 0
  if mobile_product_image_ratio == 'theme'
    assign mobile_product_image_ratio = product_image_ratio
  endif

  case product_image_ratio
    when 'landscape'
      assign image_aspect_ratio = '4 / 3'
    when 'portrait'
      assign image_aspect_ratio = '4 / 5'
    when 'tall-portrait'
      assign image_aspect_ratio = '2 / 3'
    else
      assign image_aspect_ratio = '1 / 1'
  endcase

  case mobile_product_image_ratio
    when 'landscape'
      assign mobile_image_aspect_ratio = '4 / 3'
    when 'portrait'
      assign mobile_image_aspect_ratio = '4 / 5'
    when 'tall-portrait'
      assign mobile_image_aspect_ratio = '2 / 3'
    else
      assign mobile_image_aspect_ratio = '1 / 1'
  endcase

  assign featured_media = product.featured_media
  assign featured_image_width = featured_media.width | default: 800
  assign featured_image_height = featured_media.height | default: 800
  if featured_media.preview_image != blank
    assign featured_image_width = featured_media.preview_image.width | default: featured_image_width
    assign featured_image_height = featured_media.preview_image.height | default: featured_image_height
  endif

  assign column_gap = section.settings.column-gap | default: 48
  assign tablet_column_gap = section.settings.tablet-column-gap | default: 32
  assign step_title_gap = section.settings.step-title-gap | default: 10
  assign title_price_layout = section.settings.title-price-layout | default: 'split'
  assign title_price_gap = section.settings.title-price-gap | default: 16
  assign title_description_gap = section.settings.title-description-gap | default: 12
  assign description_add_gap = section.settings.description-add-gap | default: 18

  assign mobile_step_title_gap = section.settings.mobile-step-title-gap | default: 0
  assign mobile_title_price_gap = section.settings.mobile-title-price-gap | default: 0
  assign mobile_title_description_gap = section.settings.mobile-title-description-gap | default: 0
  assign mobile_description_add_gap = section.settings.mobile-description-add-gap | default: 0
  assign mobile_image_content_gap = section.settings.mobile-image-content-gap | default: 14
  assign mobile_slide_gap = section.settings.mobile-slide-gap | default: 4
  assign mobile_show_arrows = section.settings.mobile-show-arrows
  if mobile_show_arrows == nil
    assign mobile_show_arrows = true
  endif

  if mobile_step_title_gap == 0
    assign mobile_step_title_gap = step_title_gap
  endif
  if mobile_title_price_gap == 0
    assign mobile_title_price_gap = title_price_gap
  endif
  if mobile_title_description_gap == 0
    assign mobile_title_description_gap = title_description_gap
  endif
  if mobile_description_add_gap == 0
    assign mobile_description_add_gap = description_add_gap
  endif

  assign routine_entries = product.metafields.custom.complete_your_routine.value
  assign pair_entries = product.metafields.custom.pair_with.value

  assign has_routine = false
  assign has_pair = false
  if routine_entries != blank and routine_entries.size > 0
    assign has_routine = true
  endif
  if pair_entries != blank and pair_entries.size > 0
    assign has_pair = true
  endif

  assign entries = blank
  assign layout_mode = 'pair'
  if has_routine and has_pair
    if prefer_routine_when_both
      assign entries = routine_entries
      assign layout_mode = 'routine'
    else
      assign entries = pair_entries
      assign layout_mode = 'pair'
    endif
  elsif has_routine
    assign entries = routine_entries
    assign layout_mode = 'routine'
  elsif has_pair
    assign entries = pair_entries
    assign layout_mode = 'pair'
  endif

  assign item_count = 0
  if entries != blank
    assign item_count = entries.size
  endif

  if layout_mode == 'routine'
    assign section_heading = heading_routine
  else
    assign section_heading = heading_pair
  endif

  assign loading = 'lazy'
  if section.index < 3
    assign loading = 'eager'
  endif

  assign currency_format = settings.product--currency-format | default: 'symbol'
-%}

{%- if item_count > 0 -%}
  <script src="{{ 'complete-your-routine.js' | asset_url }}" type="module"></script>

  <complete-your-routine
    class="complete-your-routine--root{% if section.settings.full-width %} layout-full-width{% endif %}"
    data-section-id="{{ section.id }}"
    data-mode="{{ layout_mode }}"
    data-background-color="{{ bg_color }}"
    data-border="{{ border }}"
    data-container-width="{{ container_width }}"
    data-spacing-above="{{ spacing_above }}"
    data-spacing-below="{{ spacing_below }}"
    data-mobile-spacing-above="{{ mobile_spacing_above }}"
    data-mobile-spacing-below="{{ mobile_spacing_below }}"
    data-text-color="{{ text_color }}"
    data-product-image-ratio="{{ product_image_ratio }}"
    data-mobile-product-image-ratio="{{ mobile_product_image_ratio }}"
    data-column-width-unit="{{ column_width_unit }}"
    {% if custom_image_height > 0 %}data-custom-image-height="true"{% endif %}
    {% if column_width_unit != 'percent' and custom_image_width > 0 %}data-custom-image-width="true"{% endif %}
    {% if column_width_unit != 'percent' and custom_content_width > 0 %}data-custom-content-width="true"{% endif %}
    {% if tablet_custom_image_height > 0 %}data-tablet-custom-image-height="true"{% endif %}
    {% if column_width_unit != 'percent' and tablet_custom_image_width > 0 %}data-tablet-custom-image-width="true"{% endif %}
    {% if column_width_unit != 'percent' and tablet_custom_content_width > 0 %}data-tablet-custom-content-width="true"{% endif %}
    {% if mobile_custom_image_height > 0 %}data-mobile-custom-image-height="true"{% endif %}
    data-currency-symbol="{{ cart.currency.symbol }}"
    data-currency-code="{{ cart.currency.iso_code }}"
    data-currency-format="{{ currency_format }}"
    data-title-price-layout="{{ title_price_layout }}"
    data-bulk-label-routine="{{ bulk_routine | escape }}"
    data-bulk-label-pair="{{ bulk_pair | escape }}"
    data-add-label="{{ add_label | escape }}"
    data-in-cart-label="{{ in_cart_label | escape }}"
    data-mobile-show-arrows="{{ mobile_show_arrows }}"
    data-slide-count="{{ item_count }}"
    style="
      --cyr-heading-size: {{ heading_font_size }}px;
      --cyr-step-size: {{ step_font_size }}px;
      --cyr-title-size: {{ title_font_size }}px;
      --cyr-price-size: {{ price_font_size }}px;
      --cyr-description-size: {{ description_font_size }}px;
      --cyr-add-size: {{ add_font_size }}px;
      --cyr-bulk-size: {{ bulk_font_size }}px;
      --cyr-mobile-heading-size: {{ mobile_heading_font_size }}px;
      --cyr-mobile-step-size: {{ mobile_step_font_size }}px;
      --cyr-mobile-title-size: {{ mobile_title_font_size }}px;
      --cyr-mobile-price-size: {{ mobile_price_font_size }}px;
      --cyr-mobile-description-size: {{ mobile_description_font_size }}px;
      --cyr-mobile-add-size: {{ mobile_add_font_size }}px;
      --cyr-badge-color: {{ badge_color }};
      --cyr-bulk-bg: {{ bulk_bg }};
      --cyr-bulk-text: {{ bulk_text }};
      --cyr-column-gap: {{ column_gap }}px;
      --cyr-tablet-column-gap: {{ tablet_column_gap }}px;
      --cyr-image-col-fr: {{ image_column_percent }}fr;
      --cyr-content-col-fr: {{ content_column_percent }}fr;
      --cyr-step-title-gap: {{ step_title_gap }}px;
      --cyr-title-price-gap: {{ title_price_gap }}px;
      --cyr-title-description-gap: {{ title_description_gap }}px;
      --cyr-description-add-gap: {{ description_add_gap }}px;
      --cyr-mobile-step-title-gap: {{ mobile_step_title_gap }}px;
      --cyr-mobile-title-price-gap: {{ mobile_title_price_gap }}px;
      --cyr-mobile-title-description-gap: {{ mobile_title_description_gap }}px;
      --cyr-mobile-description-add-gap: {{ mobile_description_add_gap }}px;
      --cyr-mobile-image-content-gap: {{ mobile_image_content_gap }}px;
      --cyr-mobile-slide-gap: {{ mobile_slide_gap }}px;
      --cyr-image-aspect-ratio: {{ image_aspect_ratio }};
      --cyr-mobile-image-aspect-ratio: {{ mobile_image_aspect_ratio }};
      {% if custom_image_height > 0 %}--cyr-image-height: {{ custom_image_height }}px;{% endif %}
      {% if custom_image_width > 0 %}--cyr-image-width: {{ custom_image_width }}px;{% endif %}
      {% if custom_content_width > 0 %}--cyr-content-width: {{ custom_content_width }}px;{% endif %}
      {% if tablet_custom_image_height > 0 %}--cyr-tablet-image-height: {{ tablet_custom_image_height }}px;{% endif %}
      {% if tablet_custom_image_width > 0 %}--cyr-tablet-image-width: {{ tablet_custom_image_width }}px;{% endif %}
      {% if tablet_custom_content_width > 0 %}--cyr-tablet-content-width: {{ tablet_custom_content_width }}px;{% endif %}
      {% if mobile_custom_image_height > 0 %}--cyr-mobile-image-height: {{ mobile_custom_image_height }}px;{% endif %}
    "
  >
    <div class="complete-your-routine--wrapper">
      <div class="complete-your-routine--header" data-container="nav" data-mobile-x-alignment="left">
        <h2 class="complete-your-routine--heading" data-item="section-heading">{{ section_heading | escape }}</h2>
        {%- if mobile_show_arrows and item_count > 1 -%}
          {%-
            render 'carousel-nav-arrow',
            id: section.id,
            total_slides: 1,
            total_slides_mobile: item_count,
            text_color: text_color,
            mobile_only: true
          -%}
        {%- endif -%}
      </div>

      {%- comment -%} Desktop: sticky media + list {%- endcomment -%}
      <div class="complete-your-routine--desktop" data-mq="medium-large">
        <div class="complete-your-routine--media">
          <div class="complete-your-routine--media-frame">
            <img
              class="complete-your-routine--media-img"
              data-cyr-media-img
              src="{{ featured_media | image_url: width: 1200 }}"
              alt="{{ featured_media.alt | default: product.title | escape }}"
              width="{{ featured_image_width }}"
              height="{{ featured_image_height }}"
              loading="{{ loading }}"
            >
          </div>
        </div>

        <div class="complete-your-routine--list">
          {%- for entry in entries -%}
            {%- liquid
              assign entry_product = entry[field_product]
              if entry_product.value != blank
                assign entry_product = entry_product.value
              endif

              if entry_product == blank and entry.system != blank
                assign entry_product = entry
              endif

              assign entry_description = entry[field_description]
              if entry_description == blank
                assign entry_description = entry.custom_description | default: entry.description | default: entry.body | default: entry.text
              endif

              assign is_current = false
              if entry_product != blank and entry_product.handle == product.handle
                assign is_current = true
              endif

              assign variant = entry_product.selected_or_first_available_variant
              assign media = entry_product.featured_media
              assign step_number = forloop.index
              assign already_in_cart = false
              for cart_item in cart.items
                if cart_item.variant_id == variant.id
                  assign already_in_cart = true
                  break
                endif
              endfor
            -%}

            {%- if entry_product != blank -%}
              <article
                class="complete-your-routine--item"
                data-cyr-item
                data-variant-id="{{ variant.id }}"
                data-price="{{ variant.price }}"
                data-available="{{ variant.available }}"
                data-is-current="{{ is_current }}"
                {% if already_in_cart %}data-in-cart{% endif %}
                {% if media != blank %}
                  data-image-src="{{ media | image_url: width: 1200 }}"
                  data-image-srcset="{{ media | image_url: width: 600 }} 600w, {{ media | image_url: width: 900 }} 900w, {{ media | image_url: width: 1200 }} 1200w"
                  data-image-alt="{{ media.alt | default: entry_product.title | escape }}"
                  data-image-width="{{ media.preview_image.width | default: media.width | default: 800 }}"
                  data-image-height="{{ media.preview_image.height | default: media.height | default: 800 }}"
                {% endif %}
              >
                <div class="complete-your-routine--item-meta">
                  {%- if layout_mode == 'routine' -%}
                    <span class="complete-your-routine--step">{{ step_label }} {{ step_number }}</span>
                    {%- if is_current -%}
                      <span class="complete-your-routine--badge">| {{ badge_routine | escape }}</span>
                    {%- endif -%}
                  {%- else -%}
                    {%- if is_current -%}
                      <span class="complete-your-routine--badge complete-your-routine--badge--solo">{{ badge_current | escape }}</span>
                    {%- else -%}
                      <span class="complete-your-routine--pair-label">{{ badge_pair | escape }}</span>
                    {%- endif -%}
                  {%- endif -%}
                </div>

                <div class="complete-your-routine--item-heading">
                  <div class="complete-your-routine--item-row">
                    <a class="complete-your-routine--item-title" href="{{ entry_product.url }}">
                      {{- entry_product.title | escape -}}
                    </a>
                    <span class="complete-your-routine--item-price">
                      {%- render 'format-money', amount: variant.price -%}
                    </span>
                  </div>
                  {%- unless entry_product.vendor == blank -%}
                    <div class="complete-your-routine--item-vendor product-card--vendor">
                      {{- entry_product.vendor | escape -}}
                    </div>
                  {%- endunless -%}
                </div>

                {%- unless entry_description == blank -%}
                  <div class="complete-your-routine--item-description rte">
                    {%- render 'complete-your-routine-description', description: entry_description -%}
                  </div>
                {%- endunless -%}

                <button
                  class="complete-your-routine--add"
                  type="button"
                  data-cyr-add
                  aria-disabled="{% if already_in_cart or variant.available == false %}true{% else %}false{% endif %}"
                  {% unless variant.available %}disabled{% endunless %}
                >
                  <span data-cyr-add-label>
                    {%- if already_in_cart -%}
                      {{- in_cart_label | escape -}}
                    {%- elsif variant.available == false -%}
                      {{- 'products.sold_out' | t -}}
                    {%- else -%}
                      {{- add_label | escape -}}
                    {%- endif -%}
                  </span>
                </button>
              </article>
            {%- endif -%}
          {%- endfor -%}

          <button
            class="complete-your-routine--bulk"
            type="button"
            data-cyr-bulk
            aria-disabled="false"
            style="--cyr-bulk-bg: {{ bulk_bg }}; --cyr-bulk-text: {{ bulk_text }};"
          >
            <span data-cyr-bulk-label>
              {%- if layout_mode == 'routine' -%}
                {{- bulk_routine | escape -}} ({{ item_count }} ITEMS)
              {%- else -%}
                {{- bulk_pair | escape -}} ({{ item_count }} ITEMS)
              {%- endif -%}
            </span>
            <span data-cyr-bulk-price></span>
          </button>
        </div>
      </div>

      {%- comment -%} Mobile: horizontal carousel {%- endcomment -%}
      <div class="complete-your-routine--mobile" data-mq="small">
        <div class="complete-your-routine--carousel" data-cyr-carousel>
          {%- for entry in entries -%}
            {%- liquid
              assign entry_product = entry[field_product]
              if entry_product.value != blank
                assign entry_product = entry_product.value
              endif

              if entry_product == blank and entry.system != blank
                assign entry_product = entry
              endif

              assign entry_description = entry[field_description]
              if entry_description == blank
                assign entry_description = entry.custom_description | default: entry.description | default: entry.body | default: entry.text
              endif

              assign is_current = false
              if entry_product != blank and entry_product.handle == product.handle
                assign is_current = true
              endif

              assign variant = entry_product.selected_or_first_available_variant
              assign media = entry_product.featured_media
              assign step_number = forloop.index
              assign already_in_cart = false
              for cart_item in cart.items
                if cart_item.variant_id == variant.id
                  assign already_in_cart = true
                  break
                endif
              endfor
            -%}

            {%- if entry_product != blank -%}
              <article
                class="complete-your-routine--slide"
                data-cyr-slide
                data-cyr-item
                data-variant-id="{{ variant.id }}"
                data-price="{{ variant.price }}"
                data-available="{{ variant.available }}"
                data-is-current="{{ is_current }}"
                {% if already_in_cart %}data-in-cart{% endif %}
                {% if media != blank %}
                  data-image-src="{{ media | image_url: width: 1200 }}"
                  data-image-alt="{{ media.alt | default: entry_product.title | escape }}"
                  data-image-width="{{ media.preview_image.width | default: media.width | default: 800 }}"
                  data-image-height="{{ media.preview_image.height | default: media.height | default: 800 }}"
                {% endif %}
              >
                <div class="complete-your-routine--slide-media">
                  {%- if media != blank -%}
                    {{
                      media
                      | image_url: width: 900
                      | image_tag:
                        loading: loading,
                        widths: '400, 600, 900',
                        sizes: '(max-width: 639px) calc(100vw - 40px), 400px',
                        class: 'complete-your-routine--slide-img',
                        alt: media.alt | default: entry_product.title
                    }}
                  {%- else -%}
                    <div class="complete-your-routine--slide-placeholder"></div>
                  {%- endif -%}
                </div>

                <div class="complete-your-routine--item-meta">
                  {%- if layout_mode == 'routine' -%}
                    <span class="complete-your-routine--step">{{ step_label }} {{ step_number }}</span>
                    {%- if is_current -%}
                      <span class="complete-your-routine--badge">| {{ badge_routine | escape }}</span>
                    {%- endif -%}
                  {%- else -%}
                    {%- if is_current -%}
                      <span class="complete-your-routine--badge complete-your-routine--badge--solo">{{ badge_current | escape }}</span>
                    {%- else -%}
                      <span class="complete-your-routine--pair-label">{{ badge_pair | escape }}</span>
                    {%- endif -%}
                  {%- endif -%}
                </div>

                <div class="complete-your-routine--item-heading">
                  <div class="complete-your-routine--item-row">
                    <a class="complete-your-routine--item-title" href="{{ entry_product.url }}">
                      {{- entry_product.title | escape -}}
                    </a>
                    <span class="complete-your-routine--item-price">
                      {%- render 'format-money', amount: variant.price -%}
                    </span>
                  </div>
                  {%- unless entry_product.vendor == blank -%}
                    <div class="complete-your-routine--item-vendor product-card--vendor">
                      {{- entry_product.vendor | escape -}}
                    </div>
                  {%- endunless -%}
                </div>

                {%- unless entry_description == blank -%}
                  <div class="complete-your-routine--item-description rte">
                    {%- render 'complete-your-routine-description', description: entry_description -%}
                  </div>
                {%- endunless -%}

                <button
                  class="complete-your-routine--add"
                  type="button"
                  data-cyr-add
                  aria-disabled="{% if already_in_cart or variant.available == false %}true{% else %}false{% endif %}"
                  {% unless variant.available %}disabled{% endunless %}
                >
                  <span data-cyr-add-label>
                    {%- if already_in_cart -%}
                      {{- in_cart_label | escape -}}
                    {%- elsif variant.available == false -%}
                      {{- 'products.sold_out' | t -}}
                    {%- else -%}
                      {{- add_label | escape -}}
                    {%- endif -%}
                  </span>
                </button>
              </article>
            {%- endif -%}
          {%- endfor -%}
        </div>

        <div class="complete-your-routine--mobile-footer">
          <button
            class="complete-your-routine--bulk complete-your-routine--bulk-mobile"
            type="button"
            data-cyr-bulk
            aria-disabled="false"
            style="--cyr-bulk-bg: {{ bulk_bg }}; --cyr-bulk-text: {{ bulk_text }};"
          >
            <span data-cyr-bulk-label>
              {%- if layout_mode == 'routine' -%}
                {{- bulk_routine | escape -}} ({{ item_count }} ITEMS)
              {%- else -%}
                {{- bulk_pair | escape -}} ({{ item_count }} ITEMS)
              {%- endif -%}
            </span>
            <span data-cyr-bulk-price></span>
          </button>
        </div>
      </div>
    </div>
  </complete-your-routine>
{%- endif -%}

{% stylesheet %}
  .complete-your-routine--root {
    width: 100%;
    display: block;
  }

  .complete-your-routine--wrapper {
    width: 100%;
  }

  .complete-your-routine--header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    margin-bottom: 42px;
  }

  .complete-your-routine--heading {
    margin: 0;
    font-size: var(--cyr-heading-size, var(--font--paragraph--size, 15px));
    font-weight: 400;
    letter-spacing: 0.1em !important;
    text-transform: var(--font--heading--uppercase, uppercase);
    line-height: 1.3;
    text-align: center;
    width: 100%;
  }

  .complete-your-routine--header .carousel-nav-arrow {
    display: none;
    flex: 0 0 auto;
    margin-left: auto;
    gap: 2px;
    color: #8a8a8a;
  }

  .complete-your-routine--header .carousel-nav-arrow--current,
  .complete-your-routine--header .carousel-nav-arrow--total {
    font-size: var(--font--paragraph--size, 15px);
    line-height: 1;
    letter-spacing: var(--font--paragraph--spacing);
    font-weight: 400;
  }

  .complete-your-routine--header .carousel-nav-arrow--prev,
  .complete-your-routine--header .carousel-nav-arrow--next {
    padding: 4px 6px;
  }

  .complete-your-routine--header .carousel-nav-arrow svg {
    width: 10px;
    height: 10px;
  }

  .complete-your-routine--root[data-mobile-show-arrows='false'] .complete-your-routine--header .carousel-nav-arrow,
  .complete-your-routine--root[data-slide-count='1'] .complete-your-routine--header .carousel-nav-arrow {
    display: none !important;
  }

  .complete-your-routine--desktop {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(12rem, 1fr);
    gap: var(--cyr-column-gap, 48px);
    align-items: start;
  }

  .complete-your-routine--root[data-custom-image-width='true'][data-custom-content-width='true'] .complete-your-routine--desktop {
    grid-template-columns: minmax(0, var(--cyr-image-width)) minmax(0, var(--cyr-content-width));
    justify-content: start;
  }

  .complete-your-routine--root[data-custom-image-width='true']:not([data-custom-content-width='true']) .complete-your-routine--desktop {
    grid-template-columns: minmax(0, var(--cyr-image-width)) minmax(0, 1fr);
  }

  .complete-your-routine--root[data-custom-content-width='true']:not([data-custom-image-width='true']) .complete-your-routine--desktop {
    grid-template-columns: minmax(0, 1fr) minmax(0, var(--cyr-content-width));
  }

  /* Percent mode: fr shares remaining space after column-gap is subtracted */
  .complete-your-routine--root[data-column-width-unit='percent'] .complete-your-routine--desktop {
    grid-template-columns: minmax(0, var(--cyr-image-col-fr, 50fr)) minmax(12rem, var(--cyr-content-col-fr, 50fr));
    justify-content: stretch;
  }

  .complete-your-routine--root[data-column-width-unit='percent'] .complete-your-routine--media-frame {
    max-width: none;
    width: 100%;
  }

  .complete-your-routine--root[data-column-width-unit='percent'] .complete-your-routine--list {
    width: min(100%, var(--cyr-fit-width, max-content));
    max-width: 100%;
  }

  .complete-your-routine--media {
    position: sticky;
    top: calc(var(--header-height, 80px) + 24px);
    min-width: 0;
    width: 100%;
  }

  .complete-your-routine--media-frame {
    position: relative;
    width: 100%;
    aspect-ratio: var(--cyr-image-aspect-ratio, 1 / 1);
    overflow: hidden;
    background: #f5f5f5;
  }

  .complete-your-routine--root[data-custom-image-height='true'] .complete-your-routine--media-frame {
    aspect-ratio: auto;
    height: var(--cyr-image-height);
  }

  .complete-your-routine--root[data-custom-image-width='true'] .complete-your-routine--media-frame {
    width: 100%;
    max-width: var(--cyr-image-width);
  }

  .complete-your-routine--media-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .complete-your-routine--list {
    display: flex;
    flex-direction: column;
    align-items: stretch;
    min-width: 0;
    width: min(100%, var(--cyr-fit-width, max-content));
    max-width: 100%;
    padding-top: 20px;
  }

  .complete-your-routine--root[data-custom-content-width='true'] .complete-your-routine--list {
    max-width: var(--cyr-content-width);
  }

  .complete-your-routine--item {
    padding: 0 0 32px;
    margin: 0 0 21px;
    width: 100%;
    max-width: 100%;
  }

  .complete-your-routine--item:last-of-type {
    margin-bottom: 68px;
    padding-bottom: 0;
  }

  .complete-your-routine--item-meta {
    display: flex;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 6px;
    margin-bottom: var(--cyr-step-title-gap, 10px);
  }

  .complete-your-routine--step,
  .complete-your-routine--pair-label {
    font-size: var(--cyr-step-size, var(--font--paragraph--size, 15px));
    font-family: 'Sweet Sans Pro' !important;
    letter-spacing: var(--font--heading--spacing);
    text-transform: var(--font--heading--uppercase, uppercase);
    font-weight: 400;
    color: #1a1a1a;
    font-family: 'Sweet Sans Pro', sans-serif !important;
  }

  .complete-your-routine--badge {
    font-size: var(--cyr-step-size, var(--font--paragraph--size, 15px));
    font-family: 'Sweet Sans Pro' !important;
    letter-spacing: var(--font--heading--spacing);
    text-transform: var(--font--heading--uppercase, uppercase);
    color: var(--cyr-badge-color, #8b9bb4);
    font-weight: 400;
  }

  .complete-your-routine--badge--solo {
    color: var(--cyr-badge-color, #8b9bb4);
  }

  .complete-your-routine--item-heading {
    display: flex;
    flex-direction: column;
    gap: var(--spacing--0, 4px);
    margin-bottom: var(--cyr-title-description-gap, 12px);
  }

  .complete-your-routine--item-row {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--cyr-title-price-gap, 16px);
    margin-bottom: 0;
  }

  .complete-your-routine--item-vendor {
    font-family: 'Edict Display Light', serif !important;
    font-size: 14px;
    font-weight: 300 !important;
    font-style: italic !important;
    letter-spacing: 0.04em !important;
    line-height: 1.3;
    text-transform: capitalize;
    word-break: break-word;
  }

  .complete-your-routine--root[data-title-price-layout='together'] .complete-your-routine--item-row {
    justify-content: flex-start;
    flex-wrap: wrap;
  }

  .complete-your-routine--root[data-title-price-layout='together'] .complete-your-routine--item-title {
    flex: 0 1 auto;
  }

  .complete-your-routine--item-title {
    margin: 0;
    flex: 1 1 auto;
    min-width: 0;
    font-size: var(--cyr-title-size, var(--font--paragraph--size, 15px));
    font-weight: 400;
    letter-spacing: 10%;
    text-transform: var(--font--heading--uppercase, uppercase);
    color: inherit;
    text-decoration: none;
    line-height: 1.35;
    font-family: 'Sweet Sans Pro', sans-serif !important;
    overflow-wrap: break-word;
  }

  .complete-your-routine--item-price {
    flex: 0 0 auto;
    font-size: var(--cyr-price-size, var(--font--paragraph--size, 15px));
    font-weight: 400;
    letter-spacing: var(--font--paragraph--spacing);
    white-space: nowrap;
    font-family: 'Sweet Sans Pro', sans-serif !important;
  }

  .complete-your-routine--item-description {
    font-size: var(--cyr-description-size, var(--font--paragraph--size, 15px));
    font-weight: 400;
    line-height: 1.55;
    letter-spacing: var(--font--paragraph--spacing);
    color: #000000;
    margin: 0 0 var(--cyr-description-add-gap, 18px);
    text-transform: none !important;
    overflow-wrap: break-word;
    width: 0;
    min-width: 100%;
    max-width: 100%;
  }

  .complete-your-routine--item-description p {
    margin: 0 0 0.6em;
  }

  .complete-your-routine--item-description p:last-child {
    margin-bottom: 0;
  }

  .complete-your-routine--add {
    appearance: none;
    background: transparent;
    border: 0;
    padding: 0;
    margin: 0;
    cursor: pointer;
    width: max-content;
    font-size: var(--cyr-add-size, var(--font--paragraph--size, 15px));
    font-weight: 400;
    letter-spacing: var(--font--button--spacing, var(--font--letter-spacing, 0px));
    text-transform: var(--font--heading--uppercase, uppercase);
    color: #1a1a1a;
    text-decoration: none;
    line-height: 1.3;
  }

  .complete-your-routine--add [data-cyr-add-label] {
    letter-spacing: inherit;
  }

  .complete-your-routine--add:hover {
    text-decoration: underline;
  }

  .complete-your-routine--add[aria-disabled='true'] {
    opacity: 0.45;
    cursor: default;
    pointer-events: none;
    text-decoration: none;
  }

  .complete-your-routine--bulk {
    appearance: none;
    -webkit-appearance: none;
    position: relative;
    display: flex !important;
    flex: 0 0 auto;
    flex-wrap: nowrap;
    align-items: center;
    justify-content: space-between;
    align-self: stretch;
    gap: 12px;
    width: 100% !important;
    max-width: 100%;
    min-width: max-content;
    height: auto !important;
    min-height: 0 !important;
    margin-top: auto;
    padding: 16px 20px !important;
    border: 1px solid var(--cyr-bulk-bg, #1a1a1a) !important;
    border-radius: 0 !important;
    background: var(--cyr-bulk-bg, #1a1a1a) !important;
    color: var(--cyr-bulk-text, #ffffff) !important;
    cursor: pointer;
    font-family: inherit;
    font-size: var(--cyr-bulk-size, var(--font--paragraph--size, 15px)) !important;
    font-weight: 400 !important;
    letter-spacing: var(--font--button--spacing, var(--font--letter-spacing, 0px));
    text-transform: uppercase;
    text-align: left;
    line-height: 1.3;
    box-shadow: none !important;
    zoom: 1;
    box-sizing: border-box;
  }

  .complete-your-routine--bulk::before {
    display: none !important;
    content: none !important;
  }

  .complete-your-routine--bulk [data-cyr-bulk-label],
  .complete-your-routine--bulk [data-cyr-bulk-price] {
    position: static !important;
    grid-area: auto !important;
    display: block;
    flex: 0 0 auto !important;
    min-width: max-content;
    max-width: none;
    pointer-events: none;
    color: inherit !important;
    font-size: inherit !important;
    font-weight: inherit !important;
    line-height: inherit;
    white-space: nowrap;
    overflow: visible;
  }

  .complete-your-routine--bulk [data-cyr-bulk-label] {
    text-align: left;
  }

  .complete-your-routine--bulk [data-cyr-bulk-price] {
    text-align: right;
    margin-left: 0;
  }

  .complete-your-routine--bulk [data-cyr-bulk-price]:empty {
    display: none;
  }

  .complete-your-routine--bulk:hover:not([aria-disabled='true']) {
    background: #ffffff !important;
    color: #1a1a1a !important;
    border-color: #1a1a1a !important;
  }

  .complete-your-routine--bulk[aria-disabled='true'] {
    opacity: 0.45;
    cursor: default;
    pointer-events: none;
  }

  .complete-your-routine--bulk[aria-busy='true'] {
    opacity: 0.7;
  }

  .complete-your-routine--mobile {
    display: block;
  }

  /* Mobile: text-columns card-carousel peek — 2×side padding minus gap */
  .complete-your-routine--carousel {
    --cyr-mobile-slide-width: calc(
      100% - 2 * var(--spacing--item, var(--layout-padding-x, 1.25rem))
    );
    width: calc(100% + var(--spacing--item, var(--layout-padding-x, 1.25rem)));
    display: flex;
    gap: var(--cyr-mobile-slide-gap, 4px);
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
    -webkit-overflow-scrolling: touch;
    padding-bottom: 4px;
    margin: 0;
    padding-left: 0;
    padding-right: 0;
    scroll-padding-right: var(--spacing--item, var(--layout-padding-x, 1.25rem));
  }

  .complete-your-routine--carousel::after {
    content: '';
    flex: 0 0 var(--spacing--item, var(--layout-padding-x, 1.25rem));
    scroll-snap-align: none;
  }

  .complete-your-routine--carousel::-webkit-scrollbar {
    display: none;
  }

  .complete-your-routine--slide {
    scroll-snap-align: start;
    flex: 0 0 var(--cyr-mobile-slide-width);
    min-width: var(--cyr-mobile-slide-width);
    max-width: var(--cyr-mobile-slide-width);
  }

  .complete-your-routine--slide-media {
    aspect-ratio: var(--cyr-mobile-image-aspect-ratio, 1 / 1);
    overflow: hidden;
    background: #f5f5f5;
    margin-bottom: var(--cyr-mobile-image-content-gap, 14px);
  }

  .complete-your-routine--root[data-mobile-custom-image-height='true'] .complete-your-routine--slide-media {
    aspect-ratio: auto;
    height: var(--cyr-mobile-image-height);
  }

  .complete-your-routine--slide-img,
  .complete-your-routine--slide-placeholder {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .complete-your-routine--bulk-mobile {
    margin-top: 0;
  }

  .complete-your-routine--mobile-footer {
    margin-top: 20px;
    width: 100%;
    max-width: 100%;
    box-sizing: border-box;
  }

  .complete-your-routine--list .complete-your-routine--bulk {
    width: 100%;
    max-width: 100%;
    min-width: max-content;
    box-sizing: border-box;
  }

  .complete-your-routine--empty-message {
    margin: 0;
    text-align: center;
    opacity: 0.7;
  }

  @media only screen and (max-width: 639px) {
    .complete-your-routine--header {
      margin-bottom: 16px;
    }

    .complete-your-routine--heading {
      text-align: left;
      font-size: var(--cyr-mobile-heading-size, var(--font--paragraph--size, 15px));
      width: auto;
      flex: 1 1 auto;
    }

    .complete-your-routine--root[data-mobile-show-arrows='true']:not([data-slide-count='1']) .complete-your-routine--header .carousel-nav-arrow {
      display: inline-flex !important;
    }

    .complete-your-routine--header .carousel-nav-arrow--current,
    .complete-your-routine--header .carousel-nav-arrow--total {
      font-size: var(--cyr-mobile-heading-size, var(--font--paragraph--size, 15px));
    }

    .complete-your-routine--step,
    .complete-your-routine--pair-label,
    .complete-your-routine--badge {
      font-size: var(--cyr-mobile-step-size, var(--font--paragraph--size, 15px));
    }

    .complete-your-routine--item-title {
      font-size: var(--cyr-mobile-title-size, var(--font--paragraph--size, 15px));
    }

    .complete-your-routine--item-price {
      font-size: var(--cyr-mobile-price-size, var(--font--paragraph--size, 15px));
    }

    .complete-your-routine--item-description {
      font-size: var(--cyr-mobile-description-size, var(--font--paragraph--size, 15px));
    }

    .complete-your-routine--add {
      font-size: var(--cyr-mobile-add-size, var(--font--paragraph--size, 15px));
    }

    .complete-your-routine--item-meta {
      margin-bottom: var(--cyr-mobile-step-title-gap, var(--cyr-step-title-gap, 10px));
    }

    .complete-your-routine--item-heading {
      margin-bottom: var(--cyr-mobile-title-description-gap, var(--cyr-title-description-gap, 12px));
    }

    .complete-your-routine--item-row {
      gap: var(--cyr-mobile-title-price-gap, var(--cyr-title-price-gap, 16px));
      margin-bottom: 0;
    }

    .complete-your-routine--item-description {
      margin-bottom: var(--cyr-mobile-description-add-gap, var(--cyr-description-add-gap, 18px));
    }

    .complete-your-routine--slide {
      border-bottom: 0;
      margin: 0;
      padding: 0;
    }
    .complete-your-routine--item:last-of-type{
      margin-bottom: 28px;
    }

    .complete-your-routine--bulk,
    .complete-your-routine--bulk-mobile,
    .complete-your-routine--list .complete-your-routine--bulk {
      display: flex !important;
      width: 100% !important;
      max-width: 100% !important;
      min-width: 0 !important;
      align-self: stretch !important;
      justify-content: space-between !important;
    }

    .complete-your-routine--bulk [data-cyr-bulk-label] {
      flex: 1 1 auto !important;
      min-width: 0 !important;
      white-space: normal;
    }

    .complete-your-routine--bulk [data-cyr-bulk-price] {
      flex: 0 0 auto !important;
      min-width: max-content;
      margin-left: 12px;
    }
  }

  @media only screen and (min-width: 640px) and (max-width: 989px) {
    .complete-your-routine--desktop {
      gap: var(--cyr-tablet-column-gap, var(--cyr-column-gap, 48px));
    }

    .complete-your-routine--root[data-tablet-custom-image-width='true'][data-tablet-custom-content-width='true'] .complete-your-routine--desktop,
    .complete-your-routine--root[data-custom-image-width='true'][data-custom-content-width='true']:not([data-tablet-custom-image-width='true']):not([data-tablet-custom-content-width='true']) .complete-your-routine--desktop {
      grid-template-columns: minmax(0, var(--cyr-tablet-image-width, var(--cyr-image-width))) minmax(0, var(--cyr-tablet-content-width, var(--cyr-content-width)));
      justify-content: start;
    }

    .complete-your-routine--root[data-tablet-custom-image-width='true']:not([data-tablet-custom-content-width='true']) .complete-your-routine--desktop,
    .complete-your-routine--root[data-custom-image-width='true']:not([data-custom-content-width='true']):not([data-tablet-custom-image-width='true']) .complete-your-routine--desktop {
      grid-template-columns: minmax(0, var(--cyr-tablet-image-width, var(--cyr-image-width))) minmax(0, 1fr);
    }

    .complete-your-routine--root[data-tablet-custom-content-width='true']:not([data-tablet-custom-image-width='true']) .complete-your-routine--desktop,
    .complete-your-routine--root[data-custom-content-width='true']:not([data-custom-image-width='true']):not([data-tablet-custom-content-width='true']) .complete-your-routine--desktop {
      grid-template-columns: minmax(0, 1fr) minmax(0, var(--cyr-tablet-content-width, var(--cyr-content-width)));
    }

    .complete-your-routine--root[data-column-width-unit='percent'] .complete-your-routine--desktop {
      grid-template-columns: minmax(0, var(--cyr-image-col-fr, 50fr)) minmax(12rem, var(--cyr-content-col-fr, 50fr));
    }

    .complete-your-routine--root[data-column-width-unit='percent'] .complete-your-routine--media-frame {
      max-width: none;
      width: 100%;
    }

    .complete-your-routine--root[data-column-width-unit='percent'] .complete-your-routine--list {
      width: min(100%, var(--cyr-fit-width, max-content));
      max-width: 100%;
    }

    .complete-your-routine--root[data-tablet-custom-image-height='true'] .complete-your-routine--media-frame,
    .complete-your-routine--root[data-custom-image-height='true']:not([data-tablet-custom-image-height='true']) .complete-your-routine--media-frame {
      aspect-ratio: auto;
      height: var(--cyr-tablet-image-height, var(--cyr-image-height));
    }

    .complete-your-routine--root[data-tablet-custom-image-width='true'] .complete-your-routine--media-frame,
    .complete-your-routine--root[data-custom-image-width='true']:not([data-tablet-custom-image-width='true']) .complete-your-routine--media-frame {
      max-width: var(--cyr-tablet-image-width, var(--cyr-image-width));
    }

    .complete-your-routine--root[data-tablet-custom-content-width='true'] .complete-your-routine--list,
    .complete-your-routine--root[data-custom-content-width='true']:not([data-tablet-custom-content-width='true']) .complete-your-routine--list {
      max-width: var(--cyr-tablet-content-width, var(--cyr-content-width));
    }
  }

  @media only screen and (min-width: 990px) {
    .complete-your-routine--root[data-custom-image-height='true'] .complete-your-routine--media-frame {
      height: var(--cyr-image-height);
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Complete your routine",
  "tag": "section",
  "class": "section--complete-your-routine",
  "enabled_on": {
    "templates": ["product"]
  },
  "settings": [
    {
      "type": "header",
      "content": "Section max width"
    },
    {
      "type": "checkbox",
      "id": "full-width",
      "label": "Full width",
      "default": false,
      "info": "Edge to edge. Overrides the max width below."
    },
    {
      "type": "checkbox",
      "id": "custom-max-width-enabled",
      "label": "Override max width",
      "default": true
    },
    {
      "type": "range",
      "id": "custom-max-width",
      "label": "Max width",
      "min": 600,
      "max": 1920,
      "step": 20,
      "unit": "px",
      "default": 1120
    },
    {
      "type": "header",
      "content": "Section padding"
    },
    {
      "type": "checkbox",
      "id": "custom-padding-enabled",
      "label": "Override padding",
      "default": false
    },
    {
      "type": "range",
      "id": "custom-padding-top",
      "label": "Desktop padding top",
      "min": 80,
      "max": 180,
      "step": 1,
      "unit": "px",
      "default": 100
    },
    {
      "type": "range",
      "id": "custom-padding-bottom",
      "label": "Desktop padding bottom",
      "min": 80,
      "max": 180,
      "step": 1,
      "unit": "px",
      "default": 100
    },
    {
      "type": "range",
      "id": "custom-mobile-padding-top",
      "label": "Mobile padding top",
      "min": 20,
      "max": 120,
      "step": 1,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "custom-mobile-padding-bottom",
      "label": "Mobile padding bottom",
      "min": 20,
      "max": 120,
      "step": 1,
      "unit": "px",
      "default": 40
    },
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "heading-routine",
      "label": "Complete your routine heading",
      "default": "COMPLETE YOUR ROUTINE"
    },
    {
      "type": "text",
      "id": "heading-pair",
      "label": "Pair with heading",
      "default": "PAIR WITH"
    },
    {
      "type": "checkbox",
