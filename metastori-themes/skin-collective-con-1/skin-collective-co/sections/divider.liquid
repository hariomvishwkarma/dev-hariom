<!-- sections/divider.liquid -->

{%- liquid
  assign bg_color = section.settings.background-color
  assign border_enabled = section.settings.border-enabled
  assign container_width = section.settings.container-width
  assign mobile_full_width = section.settings.mobile-full-width
  assign mobile_spacing_above = section.settings.mobile-spacing-above
  assign mobile_spacing_below = section.settings.mobile-spacing-below
  assign spacing_above = section.settings.spacing-above
  assign spacing_below = section.settings.spacing-below
  assign custom_spacing_above = section.settings.custom-spacing-above
  assign custom_spacing_below = section.settings.custom-spacing-below
  assign mobile_custom_spacing_above = section.settings.mobile-custom-spacing-above
  assign mobile_custom_spacing_below = section.settings.mobile-custom-spacing-below
  assign white_border = section.settings.white-border
-%}

<div
  class="divider--root"
  data-section-id="{{ section.id }}"
  data-background-color="{{ bg_color }}"
  data-container-width="{{ container_width }}"
  data-mobile-full-width="{{ mobile_full_width }}"
  data-mobile-spacing-above="{{ mobile_spacing_above }}"
  data-mobile-spacing-below="{{ mobile_spacing_below }}"
  data-spacing-above="{{ spacing_above }}"
  data-spacing-below="{{ spacing_below }}"
  data-white-border="{{ white_border }}"
  style="
    {% if spacing_above == 'custom' %}--custom-spacing-above: {{ custom_spacing_above }}px;{% endif %}
    {% if spacing_below == 'custom' %}--custom-spacing-below: {{ custom_spacing_below }}px;{% endif %}
    {% if mobile_spacing_above == 'custom' %}--mobile-custom-spacing-above: {{ mobile_custom_spacing_above }}px;{% endif %}
    {% if mobile_spacing_below == 'custom' %}--mobile-custom-spacing-below: {{ mobile_custom_spacing_below }}px;{% endif %}
  "
>
  {%- if border_enabled -%}
    <div class="divider--wrapper"></div>
  {%- endif -%}
</div>

{% stylesheet %}
  .divider--wrapper {
    height: var(--border--thickness);

    .divider--root[data-white-border='false'] & {
      background-color: var(--border--color-dark);
    }

    .divider--root[data-white-border='true'] & {
      background-color: white;
    }
  }
{% endstylesheet %}

