<!-- sections/related-products.liquid -->
{%- render 'section-max-width' -%}
{%- render 'section-padding' -%}

{%- liquid
  assign bg_color = section.settings.background-color
  assign border = section.settings.border
  assign container_width = section.settings.container-width
  assign heading_type = section.settings.heading-type
  assign max_products = 4
  assign heading_alignment = section.settings.heading-alignment
  assign mobile_heading_alignment = section.settings.mobile-heading-alignment
  assign mobile_spacing_above = section.settings.mobile-spacing-above
  assign mobile_spacing_below = section.settings.mobile-spacing-below
  assign title = section.settings.title
  assign spacing_above = section.settings.spacing-above
  assign spacing_below = section.settings.spacing-below
  assign text_color = section.settings.text-color

  assign display_type = section.settings.display-type | default: 'grid'
  assign mobile_display_type = section.settings.mobile-display-type | default: 'grid'
  assign content_width = section.settings.content-width | default: 'full'
  assign columns = section.settings.columns | default: '4' | plus: 0
  assign mobile_columns = section.settings.mobile-columns | default: '2' | plus: 0
  assign show_carousel_arrows = section.settings.show-carousel-arrows
  if show_carousel_arrows == nil
    assign show_carousel_arrows = true
  endif
  assign show_next_peek = false
  if section.settings.show-next-peek
    assign show_next_peek = true
  endif
  assign mobile_show_next_peek = false
  if section.settings.mobile-show-next-peek
    assign mobile_show_next_peek = true
  endif
  if display_type != 'slideshow'
    assign mobile_display_type = 'grid'
  endif
  if mobile_display_type != 'slideshow' and mobile_display_type != 'grid'
    assign mobile_display_type = 'grid'
  endif

  assign product_image_ratio = section.settings.product-image-ratio | default: 'theme'
  assign mobile_product_image_ratio = section.settings.mobile-product-image-ratio | default: 'theme'
  assign custom_image_height = section.settings.custom-image-height | default: 0
  assign tablet_custom_image_height = section.settings.tablet-custom-image-height | default: 0
  assign mobile_custom_image_height = section.settings.mobile-custom-image-height | default: 0
  assign heading_font_size = section.settings.heading-font-size | default: 0
  assign product_title_font_size = section.settings.product-title-font-size | default: 0
  assign product_price_font_size = section.settings.product-price-font-size | default: 0
  assign tablet_heading_font_size = section.settings.tablet-heading-font-size | default: 0
  assign tablet_product_title_font_size = section.settings.tablet-product-title-font-size | default: 0
  assign tablet_product_price_font_size = section.settings.tablet-product-price-font-size | default: 0
  assign mobile_heading_font_size = section.settings.mobile-heading-font-size | default: 0
  assign mobile_product_title_font_size = section.settings.mobile-product-title-font-size | default: 0
  assign mobile_product_price_font_size = section.settings.mobile-product-price-font-size | default: 0
  assign title_price_gap = section.settings.title-price-gap | default: 0
  assign tablet_title_price_gap = section.settings.tablet-title-price-gap | default: 0
  assign mobile_title_price_gap = section.settings.mobile-title-price-gap | default: 0
  assign cards_gap = section.settings.cards-gap | default: 0 | plus: 0
  assign tablet_cards_gap = section.settings.tablet-cards-gap | default: 0 | plus: 0
  assign mobile_cards_gap = section.settings.mobile-cards-gap | default: 0 | plus: 0

  if display_type == 'slideshow'
    assign max_products = section.settings.max-products | default: 8
  endif

  comment
    Same as featured-collection: full/container align to the 1152 guide,
    so the carousel handles its own spacing on desktop/tablet.
  endcomment
  assign carousel_spacing = true
  assign mobile_carousel_spacing = true
  if content_width == 'full' or content_width == 'container'
    assign carousel_spacing = false
  endif

  assign loading = 'lazy'
  if section.index == 1
    assign loading = 'eager'
  endif

  if display_type == 'slideshow'
    capture grid_items
      for product_rec in recommendations.products limit: max_products
        render 'product-card', product_item: product_rec, transition_id: 'related-products', sizes: '(max-width: 767px) 50vw, 25vw', loading: loading
        unless forloop.last
          echo '<span class="divider"></span>'
        endunless
      endfor
    endcapture
    assign grid_items_arr = grid_items | split: '<span class="divider"></span>'
  endif

  comment
    Slideshow needs the fetched HTML rendered with THIS section's settings.
    The stock product-recommendations-element fetches by filename
    (section_id=related-products), which renders with default settings and
    always returns the grid markup. So slideshow mode uses its own element
    (defined in the javascript tag below) that fetches with the real
    section.id instead.
  endcomment
  assign root_tag = 'product-recommendations-element'
  if display_type == 'slideshow'
    assign root_tag = 'related-products-carousel'
  endif
-%}

{%- if cards_gap > 0 or tablet_cards_gap > 0 or mobile_cards_gap > 0 -%}
  {%- liquid
    assign rp_gap_desktop = cards_gap
    assign rp_gap_tablet = tablet_cards_gap
    if rp_gap_tablet == 0
      assign rp_gap_tablet = cards_gap
    endif
    assign rp_gap_mobile = mobile_cards_gap
    if rp_gap_mobile == 0
      assign rp_gap_mobile = cards_gap
    endif
  -%}
  <style>
    {%- if cards_gap > 0 -%}
      @media only screen and (min-width: 990px) {
        #shopify-section-{{ section.id }} .related-products--root,
        #shopify-section-{{ section.id }} .related-products--root [data-container="panel"],
        #shopify-section-{{ section.id }} .related-products--root .card-carousel--root,
        #shopify-section-{{ section.id }} .related-products--root .card-carousel--wrapper,
        #shopify-section-{{ section.id }} .related-products--root .card-carousel--container {
          --grid-column-gap: {{ rp_gap_desktop }}px !important;
          --grid-row-gap: {{ rp_gap_desktop }}px !important;
          --slide-gap: {{ rp_gap_desktop }}px !important;
        }
        #shopify-section-{{ section.id }} .related-products--root .related-products--grid[data-container="panel"] {
          column-gap: {{ rp_gap_desktop }}px !important;
          row-gap: {{ rp_gap_desktop }}px !important;
          grid-column-gap: {{ rp_gap_desktop }}px !important;
          grid-row-gap: {{ rp_gap_desktop }}px !important;
        }
        #shopify-section-{{ section.id }} .related-products--root .card-carousel--container > * {
          padding-right: {{ rp_gap_desktop }}px !important;
        }
      }
    {%- endif -%}
    {%- if cards_gap > 0 or tablet_cards_gap > 0 -%}
      @media only screen and (min-width: 768px) and (max-width: 989px) {
        #shopify-section-{{ section.id }} .related-products--root,
        #shopify-section-{{ section.id }} .related-products--root [data-container="panel"],
        #shopify-section-{{ section.id }} .related-products--root .card-carousel--root,
        #shopify-section-{{ section.id }} .related-products--root .card-carousel--wrapper,
        #shopify-section-{{ section.id }} .related-products--root .card-carousel--container {
          --grid-column-gap: {{ rp_gap_tablet }}px !important;
          --grid-row-gap: {{ rp_gap_tablet }}px !important;
          --slide-gap: {{ rp_gap_tablet }}px !important;
        }
        #shopify-section-{{ section.id }} .related-products--root .related-products--grid[data-container="panel"] {
          column-gap: {{ rp_gap_tablet }}px !important;
          row-gap: {{ rp_gap_tablet }}px !important;
          grid-column-gap: {{ rp_gap_tablet }}px !important;
          grid-row-gap: {{ rp_gap_tablet }}px !important;
        }
        #shopify-section-{{ section.id }} .related-products--root .card-carousel--container > * {
          padding-right: {{ rp_gap_tablet }}px !important;
        }
      }
    {%- endif -%}
    {%- if cards_gap > 0 or mobile_cards_gap > 0 -%}
      @media only screen and (max-width: 767px) {
        #shopify-section-{{ section.id }} .related-products--root,
        #shopify-section-{{ section.id }} .related-products--root [data-container="panel"],
        #shopify-section-{{ section.id }} .related-products--root .card-carousel--root,
        #shopify-section-{{ section.id }} .related-products--root .card-carousel--wrapper,
        #shopify-section-{{ section.id }} .related-products--root .card-carousel--container {
          --grid-column-gap: {{ rp_gap_mobile }}px !important;
          --grid-row-gap: {{ rp_gap_mobile }}px !important;
          --slide-gap: {{ rp_gap_mobile }}px !important;
        }
        #shopify-section-{{ section.id }} .related-products--root .related-products--grid[data-container="panel"] {
          column-gap: {{ rp_gap_mobile }}px !important;
          row-gap: {{ rp_gap_mobile }}px !important;
          grid-column-gap: {{ rp_gap_mobile }}px !important;
          grid-row-gap: {{ rp_gap_mobile }}px !important;
        }
        #shopify-section-{{ section.id }} .related-products--root .card-carousel--container > * {
          padding-right: {{ rp_gap_mobile }}px !important;
        }
      }
    {%- endif -%}
  </style>
{%- endif -%}

<{{ root_tag }}
  class="related-products--root{% if display_type == 'slideshow' %} featured-collection--root{% endif %}"
  data-section-id="{{ section.id }}"
  data-background-color="{{ bg_color }}"
  data-border="{{ border }}"
  data-container-width="{{ container_width }}"
  data-intent="related"
  data-max-products="{{ max_products }}"
  data-mobile-spacing-above="{{ mobile_spacing_above }}"
  data-mobile-spacing-below="{{ mobile_spacing_below }}"
  data-text-color="{{ text_color }}"
  data-product-id="{{ product.id }}"
  data-spacing-above="{{ spacing_above }}"
  data-spacing-below="{{ spacing_below }}"
  {% if cards_gap > 0 %}data-cards-gap="true"{% endif %}
  {% if tablet_cards_gap > 0 %}data-tablet-cards-gap="true"{% endif %}
  {% if mobile_cards_gap > 0 %}data-mobile-cards-gap="true"{% endif %}
  {% if display_type == 'slideshow' %}
    data-content-width="{{ content_width }}"
    data-show-carousel-arrows="{{ show_carousel_arrows }}"
    data-show-next-peek="{{ show_next_peek }}"
    data-mobile-show-next-peek="{{ mobile_show_next_peek }}"
    data-mobile-display-type="{{ mobile_display_type }}"
    data-product-image-ratio="{{ product_image_ratio }}"
    data-mobile-product-image-ratio="{{ mobile_product_image_ratio }}"
    {% if custom_image_height > 0 %}
      data-custom-image-height="true"
    {% endif %}
    {% if tablet_custom_image_height > 0 %}
      data-tablet-custom-image-height="true"
    {% endif %}
    {% if mobile_custom_image_height > 0 %}
      data-mobile-custom-image-height="true"
    {% endif %}
    {% if heading_font_size > 0 %}
      data-heading-font-size="true"
    {% endif %}
    {% if product_title_font_size > 0 %}
      data-product-title-font-size="true"
    {% endif %}
    {% if product_price_font_size > 0 %}
      data-product-price-font-size="true"
    {% endif %}
    {% if tablet_heading_font_size > 0 %}
      data-tablet-heading-font-size="true"
    {% endif %}
    {% if tablet_product_title_font_size > 0 %}
      data-tablet-product-title-font-size="true"
    {% endif %}
    {% if tablet_product_price_font_size > 0 %}
      data-tablet-product-price-font-size="true"
    {% endif %}
    {% if mobile_heading_font_size > 0 %}
      data-mobile-heading-font-size="true"
    {% endif %}
    {% if mobile_product_title_font_size > 0 %}
      data-mobile-product-title-font-size="true"
    {% endif %}
    {% if mobile_product_price_font_size > 0 %}
      data-mobile-product-price-font-size="true"
    {% endif %}
    {% if title_price_gap > 0 %}
      data-title-price-gap="true"
    {% endif %}
    {% if tablet_title_price_gap > 0 %}
      data-tablet-title-price-gap="true"
    {% endif %}
    {% if mobile_title_price_gap > 0 %}
      data-mobile-title-price-gap="true"
    {% endif %}
  {% endif %}
  style="
    {% if display_type == 'slideshow' %}
      --related-mobile-grid-columns: {{ mobile_columns }};
      {% if custom_image_height > 0 %}--fcol-image-height: {{ custom_image_height }}px;{% endif %}
      {% if tablet_custom_image_height > 0 %}--fcol-tablet-image-height: {{ tablet_custom_image_height }}px;{% endif %}
      {% if mobile_custom_image_height > 0 %}--fcol-mobile-image-height: {{ mobile_custom_image_height }}px;{% endif %}
      {% if heading_font_size > 0 %}--fcol-heading-font-size: {{ heading_font_size }}px;{% endif %}
      {% if product_title_font_size > 0 %}--fcol-product-title-font-size: {{ product_title_font_size }}px;{% endif %}
      {% if product_price_font_size > 0 %}--fcol-product-price-font-size: {{ product_price_font_size }}px;{% endif %}
      {% if tablet_heading_font_size > 0 %}--fcol-tablet-heading-font-size: {{ tablet_heading_font_size }}px;{% endif %}
      {% if tablet_product_title_font_size > 0 %}--fcol-tablet-product-title-font-size: {{ tablet_product_title_font_size }}px;{% endif %}
      {% if tablet_product_price_font_size > 0 %}--fcol-tablet-product-price-font-size: {{ tablet_product_price_font_size }}px;{% endif %}
      {% if mobile_heading_font_size > 0 %}--fcol-mobile-heading-font-size: {{ mobile_heading_font_size }}px;{% endif %}
      {% if mobile_product_title_font_size > 0 %}--fcol-mobile-product-title-font-size: {{ mobile_product_title_font_size }}px;{% endif %}
      {% if mobile_product_price_font_size > 0 %}--fcol-mobile-product-price-font-size: {{ mobile_product_price_font_size }}px;{% endif %}
      {% if title_price_gap > 0 %}--fcol-title-price-gap: {{ title_price_gap }}px;{% endif %}
      {% if tablet_title_price_gap > 0 %}--fcol-tablet-title-price-gap: {{ tablet_title_price_gap }}px;{% endif %}
      {% if mobile_title_price_gap > 0 %}--fcol-mobile-title-price-gap: {{ mobile_title_price_gap }}px;{% endif %}
    {% endif %}
    {% if cards_gap > 0 %}--rp-cards-gap: {{ cards_gap }}px;{% endif %}
    {% if tablet_cards_gap > 0 %}--rp-tablet-cards-gap: {{ tablet_cards_gap }}px;{% endif %}
    {% if mobile_cards_gap > 0 %}--rp-mobile-cards-gap: {{ mobile_cards_gap }}px;{% endif %}
  "
  aria-hidden="false"
>
  {%- if display_type == 'slideshow' -%}
    <div class="related-products--wrapper featured-collection--wrapper" data-container="section">
      <div
        class="featured-collection--header-nav"
        data-container="nav"
        data-x-alignment="{{ heading_alignment }}"
        data-mobile-x-alignment="{{ mobile_heading_alignment }}"
      >
        <div class="featured-collection--header" data-container="block">
          {%- unless title == blank -%}
            <h2
              class="related-products--title featured-collection--title"
              data-item="{{ heading_type }}"
              {% unless settings.transitions--text %}
                data-transition-item="viewport"
                data-transition-type="slide-in"
              {% endunless %}
            >
              {{- title -}}
            </h2>
          {%- endunless -%}
        </div>
      </div>

      <div
        class="featured-collection--products"
        data-display-type="slideshow"
        {% unless settings.transitions--other %}
          data-transition-container="related-products"
          data-transition-type="fade-in"
          data-transition-cascade="horizontal"
          data-transition-cascade-interval="200"
        {% endunless %}
      >
        {%- comment -%}
          The recommendations JS swaps the children of [data-container="panel"]
          with the ones from the fetched section render, so the carousel and its
          nav arrows must both live inside this panel. CSS lifts the arrows up
          into the header row.
        {%- endcomment -%}
        <div class="related-products--carousel-panel" data-container="panel">
          {%- if grid_items_arr.size > 0 -%}
            {%- if mobile_display_type == 'grid' -%}
              {%- liquid
                if show_carousel_arrows
                  assign blocks_per_slide_desktop = columns | plus: 0.0
                  assign total_slides = grid_items_arr.size | divided_by: blocks_per_slide_desktop | ceil
                  render 'carousel-nav-arrow', id: section.id, total_slides_mobile: 1, total_slides: total_slides, text_color: text_color, mobile_only: false
                endif
              -%}
              <div class="related-products--slideshow-desktop" data-mq="medium-large">
                {%-
                  render 'card-carousel',
                  section: section,
                  blocks: grid_items_arr,
                  blocks_per_slide: columns,
                  blocks_per_slide_mobile: columns,
                  spacing_around_blocks: carousel_spacing,
                  mobile_spacing_around_blocks: false,
                  total_blocks: grid_items_arr.size,
                  next_visible: show_next_peek,
                  mobile_next_visible: false
                -%}
              </div>

              <div
                class="related-products--grid related-products--mobile-grid"
                data-mq="small"
                data-container="panel"
                data-columns="{{ mobile_columns }}"
                data-fixed-columns="true"
                data-mobile-columns="{{ mobile_columns }}"
                data-x-alignment="{{ heading_alignment }}"
                {% unless settings.transitions--other %}
                  data-transition-container="related-products"
                  data-transition-type="fade-in"
                  data-transition-cascade="horizontal"
                  data-transition-cascade-interval="200"
                {% endunless %}
              >
                {%- for grid_item in grid_items_arr -%}
                  {{- grid_item -}}
                {%- endfor -%}
              </div>
            {%- else -%}
              {%- liquid
                if show_carousel_arrows
                  assign blocks_per_slide_desktop = columns | plus: 0.0
                  assign blocks_per_slide_mobile = mobile_columns | plus: 0.0
                  assign total_slides = grid_items_arr.size | divided_by: blocks_per_slide_desktop | ceil
                  assign total_slides_mobile = grid_items_arr.size | divided_by: blocks_per_slide_mobile | ceil
                  render 'carousel-nav-arrow', id: section.id, total_slides_mobile: total_slides_mobile, total_slides: total_slides, text_color: text_color
                endif
              -%}
              {%-
                render 'card-carousel',
                section: section,
                blocks: grid_items_arr,
                blocks_per_slide: columns,
                blocks_per_slide_mobile: mobile_columns,
                spacing_around_blocks: carousel_spacing,
                mobile_spacing_around_blocks: mobile_carousel_spacing,
                total_blocks: grid_items_arr.size,
                next_visible: show_next_peek,
                mobile_next_visible: mobile_show_next_peek
              -%}
            {%- endif -%}
          {%- endif -%}
        </div>
      </div>
    </div>
  {%- else -%}
    <div class="related-products--wrapper" data-container="section">
      {%- unless title == blank -%}
        <div
          class="related-products--header"
          data-container="block"
          data-x-alignment="{{ heading_alignment }}"
          data-mobile-x-alignment="{{ mobile_heading_alignment }}"
        >
          <h2
            class="related-products--title"
            data-item="{{ heading_type }}"
            {% unless settings.transitions--text %}
              data-transition-item="viewport"
              data-transition-type="slide-in"
            {% endunless %}
          >
            {{- title -}}
          </h2>
        </div>
      {%- endunless -%}

      <div
        class="related-products--grid"
        data-container="panel"
        data-columns="4"
        data-fixed-columns="true"
        data-mobile-columns="2"
        data-x-alignment="{{ heading_alignment }}"
        {% unless settings.transitions--other %}
          data-transition-container="related-products"
          data-transition-type="fade-in"
          data-transition-cascade="horizontal"
          data-transition-cascade-interval="200"
        {% endunless %}
      >
        {%- for product in recommendations.products limit: max_products -%}
          {%-
            render 'product-card',
            product_item: product,
            transition_id: section.id,
            sizes: '(max-width: 767px) 50vw, 25vw',
            loading: loading
          -%}
        {%- endfor -%}
      </div>
    </div>
  {%- endif -%}
</{{ root_tag }}>

{% stylesheet %}
  .related-products--root {
    &[aria-hidden='true'] {
      display: none;
    }
  }
  .related-products--wrapper.featured-collection--wrapper{
    gap:37px !important;
  }

  @media only screen and (max-width: 767px) {
    .related-products--wrapper.featured-collection--wrapper{
      gap:18px !important;
    }
  }
{% endstylesheet %}

{% javascript %}
  if (!customElements.get('related-products-carousel')) {
    class RelatedProductsCarousel extends HTMLElement {
      connectedCallback() {
        this.container = this.querySelector('[data-container="panel"]');
        this.section_id = this.getAttribute('data-section-id');
        this.max_products = this.getAttribute('data-max-products');
        this.product_id = this.getAttribute('data-product-id');
        this.intent = this.dataset.intent;

        const observer = new IntersectionObserver(([entry], obs) => {
          if (entry.isIntersecting) {
            this.load();
            obs.disconnect();
          }
        }, { rootMargin: `${3 * window.innerHeight}px 0px` });
        observer.observe(this.parentElement);
      }

      async load() {
        const url = `${Shopify.routes.product_recommendations}?section_id=${this.section_id}&limit=${this.max_products}&product_id=${this.product_id}&intent=${this.intent}`;
        const response = await fetch(url);
        if (!response.ok) return;

        const doc = new DOMParser().parseFromString(await response.text(), 'text/html');
        const items = [...doc.querySelectorAll('.related-products--carousel-panel > :not([data-recommendations-ignore])')];

        if (items.length) {
          const fragment = new DocumentFragment();
          items.forEach((item) => fragment.append(item));
          requestAnimationFrame(() => {
            this.container
              .querySelectorAll(':scope > :not([data-recommendations-ignore])')
              .forEach((item) => item.remove());
            this.container.appendChild(fragment);
            this.setAttribute('aria-hidden', false);
            window.trigger && window.trigger('theme:transition:reload:related-products');
          });
        } else {
          this.setAttribute('aria-hidden', true);
        }
      }
    }

    customElements.define('related-products-carousel', RelatedProductsCarousel);
  }
{% endjavascript %}

{% schema %}
{
  "name": "Related products",
  "class": "section--related-products",
  "settings": [
    {
      "type": "header",
      "content": "Section max width"
    },
    {
      "type": "checkbox",
      "id": "custom-max-width-enabled",
      "label": "Override max width",
      "default": false,
      "info": "Overrides the section's existing width with the value below."
    },
    {
      "type": "range",
      "id": "custom-max-width",
      "label": "Max width",
      "min": 600,
      "max": 1920,
      "step": 20,
      "unit": "px",
      "default": 1160
    },
    {
      "type": "header",
      "content": "Section padding"
    },
    {
      "type": "checkbox",
      "id": "custom-padding-enabled",
      "label": "Override padding",
      "default": false,
      "info": "Overrides the section's existing top/bottom spacing. Tablet auto = 75% of desktop."
    },
    {
      "type": "range",
      "id": "custom-padding-top",
      "label": "Desktop padding top",
      "min": 80,
      "max": 180,
      "step": 1,
      "unit": "px",
      "default": 100
    },
    {
      "type": "range",
      "id": "custom-padding-bottom",
      "label": "Desktop padding bottom",
      "min": 80,
      "max": 180,
      "step": 1,
      "unit": "px",
      "default": 100
    },
    {
      "type": "range",
      "id": "custom-mobile-padding-top",
      "label": "Mobile padding top",
      "min": 20,
      "max": 120,
      "step": 1,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "custom-mobile-padding-bottom",
      "label": "Mobile padding bottom",
      "min": 20,
      "max": 120,
      "step": 1,
      "unit": "px",
      "default": 40
    },
    {
      "type": "paragraph",
      "content": "Dynamic recommendations change and improve with time. [Learn more](https://help.shopify.com/en/themes/development/recommended-products)"
    },
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "You may also like"
    },
    {
      "type": "header",
      "content": "Display"
    },
    {
      "id": "display-type",
      "label": "Display type",
