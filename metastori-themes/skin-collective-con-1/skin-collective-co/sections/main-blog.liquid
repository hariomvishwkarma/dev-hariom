<script>
  (() => {
    const root = document.querySelector('.blog--root');
    if (!root) return;

    const wrapper = root.querySelector('.blog--wrapper');
    if (!wrapper) return;

    let isDown = false;
    let startX = 0;
    let scrollLeft = 0;
    let moved = false;

    const bindTabsDrag = (tabs) => {
      if (!tabs || tabs.dataset.dragBound === 'true') return;
      tabs.dataset.dragBound = 'true';

      tabs.addEventListener('mousedown', (e) => {
        isDown = true;
        moved = false;
        tabs.classList.add('is-dragging');
        startX = e.pageX - tabs.offsetLeft;
        scrollLeft = tabs.scrollLeft;
      });

      tabs.addEventListener('mouseleave', () => {
        isDown = false;
        tabs.classList.remove('is-dragging');
      });

      tabs.addEventListener('mouseup', () => {
        isDown = false;
        tabs.classList.remove('is-dragging');
      });

      tabs.addEventListener('mousemove', (e) => {
        if (!isDown) return;
        e.preventDefault();
        const x = e.pageX - tabs.offsetLeft;
        const walk = x - startX;
        if (Math.abs(walk) > 5) moved = true;
        tabs.scrollLeft = scrollLeft - walk;
      });
    };

    const activateTransitions = (container) => {
      if (!container) return;
      const items = container.querySelectorAll('[data-transition-item]');
      requestAnimationFrame(() => {
        items.forEach((item) => {
          item.setAttribute('data-transition-active', 'true');
        });
      });
    };

    const isEditorial = root.dataset.layoutStyle === 'editorial';

    const readCategory = (url) => {
      try {
        return (new URL(url, window.location.origin).searchParams.get('category') || '').trim();
      } catch (error) {
        return '';
      }
    };

    // Mirrors the Liquid 2 / 3 / 3 / 2 editorial cycle so hiding cards
    // does not leave gaps in the pattern.
    const relayoutEditorial = (cells) => {
      cells.forEach((cell, index) => {
        const cycle = (index % 10) + 1;
        let cardSize = 'equal';
        let rowRole = 'thirds';

        if (cycle === 1 || cycle === 9) {
          cardSize = 'wide';
          rowRole = 'split';
        } else if (cycle === 2 || cycle === 10) {
          cardSize = 'narrow';
          rowRole = 'split';
        }

        cell.setAttribute('data-card-size', cardSize);
        cell.setAttribute('data-row-role', rowRole);
        cell.setAttribute('data-cycle', String(cycle));
      });
    };

    const syncActiveState = (category) => {
      wrapper.querySelectorAll('.blog--tab').forEach((tab) => {
        const isActive = (tab.dataset.category || '') === category;
        tab.toggleAttribute('data-active', isActive);
        if (isActive) {
          tab.setAttribute('aria-current', 'page');
          tab.setAttribute('data-active', 'true');
        } else {
          tab.removeAttribute('aria-current');
          tab.removeAttribute('data-active');
        }
      });

      wrapper.querySelectorAll('.blog--filter--menu-item > a').forEach((link) => {
        if (typeof link.dataset.category !== 'string') return;
        if (link.dataset.category === category) {
          link.setAttribute('data-item', 'block-link');
        } else {
          link.removeAttribute('data-item');
        }
      });
    };

    // Pagination is server-rendered without the query string, so carry the
    // active category across page links.
    const syncPaginationLinks = (category) => {
      wrapper.querySelectorAll('.blog--footer-pagination a[href]').forEach((link) => {
        try {
          const url = new URL(link.getAttribute('href'), window.location.origin);
          if (category) {
            url.searchParams.set('category', category);
          } else {
            url.searchParams.delete('category');
          }
          link.setAttribute('href', url.pathname + url.search + url.hash);
        } catch (error) {
          /* leave the link untouched */
        }
      });
    };

    const applyFilter = (category, { push = false, url = null } = {}) => {
      const results = wrapper.querySelector('.blog--results');
      if (!results) return;

      const active = category || '';

      // A `?category=` left over from another language (Shopify carries the
      // query string across a locale switch without translating it) or from a
      // renamed category matches no tab. Fall back to All instead of rendering
      // an empty page.
      if (active) {
        const known = Array.from(wrapper.querySelectorAll('.blog--tab')).map((tab) => tab.dataset.category || '');
        if (known.length && known.indexOf(active) === -1) {
          const clean = new URL(window.location.href);
          clean.searchParams.delete('category');
          history.replaceState({}, '', clean.pathname + clean.search + clean.hash);
          applyFilter('');
          return;
        }
      }

      const visibleCells = [];

      results.querySelectorAll('[data-article-categories]').forEach((card) => {
        const cell = card.closest('.blog--cell') || card;
        const categories = (card.dataset.articleCategories || '').split(/\s+/).filter(Boolean);
        const matches = !active || categories.indexOf(active) !== -1;

        if (matches) {
          cell.removeAttribute('data-filtered-out');
          visibleCells.push(cell);
        } else {
          cell.setAttribute('data-filtered-out', 'true');
        }
      });

      // Grid fillers only balance the unfiltered row count.
      results.querySelectorAll('[data-item="blank"]').forEach((blank) => {
        if (active) {
          blank.setAttribute('data-filtered-out', 'true');
        } else {
          blank.removeAttribute('data-filtered-out');
        }
      });

      if (isEditorial) relayoutEditorial(visibleCells);

      const noMatches = results.querySelector('.blog--no-matches');
      const hasArticles = results.querySelector('[data-article-categories]');
      if (noMatches) noMatches.hidden = !(hasArticles && visibleCells.length === 0);

      syncActiveState(active);
      syncPaginationLinks(active);
      activateTransitions(results);

      if (push && url) history.pushState({ blogCategory: active }, '', url);
    };

    wrapper.addEventListener('click', (event) => {
      const link = event.target.closest('.blog--tab, .blog--filter--menu-item > a');
      if (!link || !wrapper.contains(link)) return;
      if (typeof link.dataset.category !== 'string') return;

      if (moved) {
        event.preventDefault();
        moved = false;
        return;
      }

      event.preventDefault();
      applyFilter(link.dataset.category, { push: true, url: link.href });
    });

    window.addEventListener('popstate', () => {
      applyFilter(readCategory(window.location.href));
    });

    applyFilter(readCategory(window.location.href));

    bindTabsDrag(wrapper.querySelector('.blog--tabs'));
  })();
</script>

