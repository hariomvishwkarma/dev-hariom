<!-- sections/key-ingredients.liquid -->
{%- render 'section-max-width' -%}
{%- render 'section-padding' -%}

{%- liquid
  assign heading = section.settings.heading
  assign bg_color = section.settings.background-color
  assign border = section.settings.border
  assign container_width = section.settings.container-width
  assign spacing_above = section.settings.spacing-above
  assign spacing_below = section.settings.spacing-below
  assign mobile_spacing_above = section.settings.mobile-spacing-above
  assign mobile_spacing_below = section.settings.mobile-spacing-below
  assign text_color = section.settings.text-color | default: 'body'

  assign show_arrows = section.settings.show-arrows
  if show_arrows == nil
    assign show_arrows = true
  endif
  assign show_dots = section.settings.show-dots
  if show_dots == nil
    assign show_dots = true
  endif
  assign show_side_arrows = section.settings.show-side-arrows
  if show_side_arrows == nil
    assign show_side_arrows = true
  endif
  assign mobile_show_arrows = section.settings.mobile-show-arrows
  if mobile_show_arrows == nil
    assign mobile_show_arrows = true
  endif
  assign mobile_show_dots = section.settings.mobile-show-dots
  if mobile_show_dots == nil
    assign mobile_show_dots = true
  endif
  assign mobile_show_side_arrows = section.settings.mobile-show-side-arrows
  if mobile_show_side_arrows == nil
    assign mobile_show_side_arrows = false
  endif

  assign dot_size = section.settings.dot-size | default: 8
  assign mobile_dot_size = section.settings.mobile-dot-size | default: 8
  if mobile_dot_size == 0
    assign mobile_dot_size = dot_size
  endif

  assign metafield_namespace = section.settings.metafield-namespace | default: 'custom' | strip
  assign metafield_key = section.settings.metafield-key | default: 'list_of_ingredients' | strip
  assign field_title = section.settings.field-title | default: 'title' | strip
  assign field_subtitle = section.settings.field-subtitle | default: 'subtitle' | strip
  assign field_description = section.settings.field-description | default: 'description' | strip
  assign field_image = section.settings.field-image | default: 'image' | strip
  assign primary_locale = section.settings.primary-locale | default: 'en' | strip
  assign fallback_to_primary = section.settings.fallback-to-primary-locale
  if fallback_to_primary == nil
    assign fallback_to_primary = true
  endif

  assign panel_bg = section.settings.panel-background | default: '#889CD3'
  assign panel_text = section.settings.panel-text-color | default: '#FFFFFF'
  assign section_heading_color = section.settings.section-heading-color | default: '#1A1A1A'
  assign arrow_color = section.settings.arrow-color | default: '#1A1A1A'

  assign heading_font_size = section.settings.heading-font-size | default: 16
  assign slide_title_font_size = section.settings.slide-title-font-size | default: 22
  assign slide_subtitle_font_size = section.settings.slide-subtitle-font-size | default: 16
  assign slide_description_font_size = section.settings.slide-description-font-size | default: 14
  assign title_subtitle_gap = section.settings.title-subtitle-gap | default: 8
  assign subtitle_description_gap = section.settings.subtitle-description-gap | default: 16
  assign panel_padding = section.settings.panel-padding | default: 48
  assign slide_min_height = section.settings.slide-min-height | default: 527

  assign mobile_heading_font_size = section.settings.mobile-heading-font-size | default: 14
  assign mobile_slide_title_font_size = section.settings.mobile-slide-title-font-size | default: 16
  assign mobile_slide_subtitle_font_size = section.settings.mobile-slide-subtitle-font-size | default: 14
  assign mobile_slide_description_font_size = section.settings.mobile-slide-description-font-size | default: 13
  assign mobile_title_subtitle_gap = section.settings.mobile-title-subtitle-gap | default: 6
  assign mobile_subtitle_description_gap = section.settings.mobile-subtitle-description-gap | default: 12
  assign mobile_panel_padding = section.settings.mobile-panel-padding | default: 24
  assign mobile_panel_padding_top = section.settings.mobile-panel-padding-top | default: 98
  assign mobile_panel_padding_bottom = section.settings.mobile-panel-padding-bottom | default: 97
  assign mobile_image_ratio = section.settings.mobile-image-ratio | default: '4 / 3'

  assign metafield = product.metafields.custom.list_of_ingredients
  if metafield == blank
    assign metafield = product.metafields[metafield_namespace][metafield_key]
  endif

  assign ingredients = blank
  if metafield != blank
    assign ingredients = metafield.value
  endif

  assign use_blocks = false
  if metafield == blank or ingredients == blank
    if section.blocks.size > 0
      assign use_blocks = true
    endif
  endif

  assign current_locale = localization.language.iso_code | default: request.locale.iso_code

  assign loading = 'lazy'
  if section.index < 3
    assign loading = 'eager'
  endif
-%}

{%- capture slides_html -%}
  {%- if use_blocks -%}
    {%- for block in section.blocks -%}
      {%- liquid
        assign item_title = block.settings.title
        assign item_subtitle = block.settings.subtitle
        assign item_description = block.settings.description
        assign item_image = block.settings.image
        assign item_id = block.id
      -%}
      <div
        class="key-ingredients--slide"
        data-id="{{ item_id }}"
        {{ block.shopify_attributes }}
      >
        <div class="key-ingredients--panel">
          {%- unless item_title == blank -%}
            <h3 class="key-ingredients--slide-title">{{ item_title | escape }}</h3>
          {%- endunless -%}
          {%- unless item_subtitle == blank -%}
            <p class="key-ingredients--slide-subtitle">{{ item_subtitle | escape }}</p>
          {%- endunless -%}
          {%- unless item_description == blank -%}
            <div class="key-ingredients--slide-description">{{ item_description }}</div>
          {%- endunless -%}
        </div>
        <div class="key-ingredients--media">
          {%- if item_image != blank -%}
            {%- assign item_alt = item_title | default: heading | escape -%}
            {{
              item_image
              | image_url: width: 1600
              | image_tag:
                widths: '400, 600, 800, 1000, 1200, 1600',
                sizes: '(max-width: 767px) 100vw, 50vw',
                loading: loading,
                class: 'key-ingredients--image',
                alt: item_alt
            }}
          {%- else -%}
            <div class="key-ingredients--image-placeholder" aria-hidden="true"></div>
          {%- endif -%}
        </div>
      </div>
      {%- unless forloop.last -%}<span class="divider"></span>{%- endunless -%}
    {%- endfor -%}
  {%- elsif ingredients != blank -%}
    {%- for ingredient in ingredients -%}
      {%- liquid
        assign item_title = ingredient[field_title]
        if item_title == blank
          assign item_title = ingredient.title | default: ingredient.name | default: ingredient.heading
        endif

        assign item_subtitle = ingredient[field_subtitle]
        if item_subtitle == blank
          assign item_subtitle = ingredient.subtitle | default: ingredient.tagline | default: ingredient.subheading
        endif

        assign item_description = ingredient[field_description]
        if item_description == blank
          assign item_description = ingredient.description | default: ingredient.body | default: ingredient.text
        endif

        assign item_image = ingredient[field_image]
        if item_image == blank
          assign item_image = ingredient.image
        endif
        if item_image.value != blank
          assign item_image = item_image.value
        endif

        assign item_id = ingredient.system.id | default: ingredient.id | default: forloop.index
        assign item_id = section.id | append: '--' | append: item_id
      -%}
      <div class="key-ingredients--slide" data-id="{{ item_id }}">
        <div class="key-ingredients--panel">
          {%- unless item_title == blank -%}
            <h3 class="key-ingredients--slide-title">{{ item_title | escape }}</h3>
          {%- endunless -%}
          {%- unless item_subtitle == blank -%}
            <p class="key-ingredients--slide-subtitle">{{ item_subtitle | escape }}</p>
          {%- endunless -%}
          {%- unless item_description == blank -%}
            <div class="key-ingredients--slide-description">
              {%- assign desc_html = item_description | metafield_tag -%}
              {%- if desc_html != blank -%}
                {{ desc_html }}
              {%- else -%}
                {{ item_description | newline_to_br }}
              {%- endif -%}
            </div>
          {%- endunless -%}
        </div>
        <div class="key-ingredients--media">
          {%- if item_image != blank -%}
            {%- assign item_alt = item_title | default: heading | escape -%}
            {{
              item_image
              | image_url: width: 1600
              | image_tag:
                widths: '400, 600, 800, 1000, 1200, 1600',
                sizes: '(max-width: 767px) 100vw, 50vw',
                loading: loading,
                class: 'key-ingredients--image',
                alt: item_alt
            }}
          {%- else -%}
            <div class="key-ingredients--image-placeholder" aria-hidden="true"></div>
          {%- endif -%}
        </div>
      </div>
      {%- unless forloop.last -%}<span class="divider"></span>{%- endunless -%}
    {%- endfor -%}
  {%- endif -%}
{%- endcapture -%}

{%- assign slides = slides_html | split: '<span class="divider"></span>' -%}
{%- assign slide_count = slides.size -%}
{%- if slides_html == blank -%}
  {%- assign slide_count = 0 -%}
{%- endif -%}

{%- if slide_count > 0 -%}
  <div
    class="key-ingredients--root{% if section.settings.full-width %} layout-full-width{% endif %}"
    data-section-id="{{ section.id }}"
    data-background-color="{{ bg_color }}"
    data-border="{{ border }}"
    data-container-width="{{ container_width }}"
    data-spacing-above="{{ spacing_above }}"
    data-spacing-below="{{ spacing_below }}"
    data-mobile-spacing-above="{{ mobile_spacing_above }}"
    data-mobile-spacing-below="{{ mobile_spacing_below }}"
    data-slide-count="{{ slide_count }}"
    data-show-arrows="{{ show_arrows }}"
    data-show-dots="{{ show_dots }}"
    data-show-side-arrows="{{ show_side_arrows }}"
    data-mobile-show-arrows="{{ mobile_show_arrows }}"
    data-mobile-show-dots="{{ mobile_show_dots }}"
    data-mobile-show-side-arrows="{{ mobile_show_side_arrows }}"
    style="
      --ki-panel-bg: {{ panel_bg }};
      --ki-panel-text: {{ panel_text }};
      --ki-section-heading-color: {{ section_heading_color }};
      --ki-arrow-color: {{ arrow_color }};
      --ki-dot-size: {{ dot_size }}px;
      --ki-mobile-dot-size: {{ mobile_dot_size }}px;
      --ki-heading-font-size: {{ heading_font_size }}px;
      --ki-slide-title-font-size: {{ slide_title_font_size }}px;
      --ki-slide-subtitle-font-size: {{ slide_subtitle_font_size }}px;
      --ki-slide-description-font-size: {{ slide_description_font_size }}px;
      --ki-title-subtitle-gap: {{ title_subtitle_gap }}px;
      --ki-subtitle-description-gap: {{ subtitle_description_gap }}px;
      --ki-panel-padding: {{ panel_padding }}px;
      --ki-slide-min-height: {{ slide_min_height }}px;
      --ki-mobile-heading-font-size: {{ mobile_heading_font_size }}px;
      --ki-mobile-slide-title-font-size: {{ mobile_slide_title_font_size }}px;
      --ki-mobile-slide-subtitle-font-size: {{ mobile_slide_subtitle_font_size }}px;
      --ki-mobile-slide-description-font-size: {{ mobile_slide_description_font_size }}px;
      --ki-mobile-title-subtitle-gap: {{ mobile_title_subtitle_gap }}px;
      --ki-mobile-subtitle-description-gap: {{ mobile_subtitle_description_gap }}px;
      --ki-mobile-panel-padding: {{ mobile_panel_padding }}px;
      --ki-mobile-panel-padding-top: {{ mobile_panel_padding_top }}px;
      --ki-mobile-panel-padding-bottom: {{ mobile_panel_padding_bottom }}px;
      --ki-mobile-image-ratio: {{ mobile_image_ratio }};
    "
  >
    <div class="key-ingredients--wrapper">
      <div
        class="key-ingredients--header"
        data-container="nav"
        data-x-alignment="center"
        data-mobile-x-alignment="left"
      >
        <div class="key-ingredients--header-title" data-container="block">
          {%- unless heading == blank -%}
            <h2 class="key-ingredients--heading">{{ heading | escape }}</h2>
          {%- endunless -%}
        </div>

        {%- if show_arrows or mobile_show_arrows -%}
          {%- if slide_count > 1 -%}
            {%-
              render 'carousel-nav-arrow',
              id: section.id,
              total_slides: slide_count,
              total_slides_mobile: slide_count,
              text_color: text_color,
              mobile_only: false
            -%}
          {%- endif -%}
        {%- endif -%}
      </div>

      <slideshow-carousel
        class="slideshow-carousel--root key-ingredients--carousel"
        data-id="{{ section.id }}"
        data-auto-rotate="false"
        data-columns="1"
        data-last-slide="false"
        data-mobile-columns="1"
        data-transition-type="slide"
        style="--total-slides: {{ slide_count }};"
      >
        <div class="slideshow-carousel--wrapper key-ingredients--carousel-wrapper">
          <div class="key-ingredients--stage">
            {%- if show_side_arrows or mobile_show_side_arrows -%}
              {%- if slide_count > 1 -%}
                <button
                  class="slideshow-carousel--prev key-ingredients--side-arrow"
                  type="button"
                  aria-label="{{ 'general.a11y.previous' | t }}"
                  aria-disabled="true"
                >
                  {%- render 'icons', icon: 'chevron-left--small' -%}
                </button>
              {%- endif -%}
            {%- endif -%}

            <div class="key-ingredients--viewport">
              <div class="slideshow-carousel--container">
                {%- for slide in slides -%}
                  {{- slide -}}
                {%- endfor -%}
              </div>
            </div>

            {%- if show_side_arrows or mobile_show_side_arrows -%}
              {%- if slide_count > 1 -%}
                <button
                  class="slideshow-carousel--next key-ingredients--side-arrow"
                  type="button"
                  aria-label="{{ 'general.a11y.next' | t }}"
                  aria-disabled="false"
                >
                  {%- render 'icons', icon: 'chevron-right--small' -%}
                </button>
              {%- endif -%}
            {%- endif -%}
          </div>

          {%- if show_dots or mobile_show_dots -%}
            {%- if slide_count > 1 -%}
              {%-
                render 'slideshow-pagination',
                auto_rotate: false,
                max_dots: slide_count,
                total_slides: slide_count,
                total_slides_mobile: slide_count
              -%}
            {%- endif -%}
          {%- endif -%}
        </div>
      </slideshow-carousel>
    </div>
  </div>
{%- else -%}
  {%- liquid
    assign needs_locale_fallback = false
    assign primary_root = primary_locale | split: '-' | first
    assign current_root = current_locale | split: '-' | first
    if fallback_to_primary and product != blank
      if current_locale != primary_locale and current_root != primary_root
        assign needs_locale_fallback = true
      endif
    endif
  -%}
  {%- if needs_locale_fallback -%}
    <div
      class="key-ingredients--fallback-host"
      data-key-ingredients-fallback
      data-section-id="{{ section.id }}"
      data-product-handle="{{ product.handle | escape }}"
      data-primary-locale="{{ primary_locale | escape }}"
      data-current-locale="{{ current_locale | escape }}"
      hidden
    ></div>
    <script src="{{ 'key-ingredients-locale-fallback.js' | asset_url }}" defer></script>
  {%- endif -%}
{%- endif -%}

{% stylesheet %}
  .key-ingredients--root {
    width: 100%;
    box-sizing: border-box;
  }

  .key-ingredients--wrapper {
    width: 100%;
    max-width: 100%;
    margin: 0 auto;
    box-sizing: border-box;
  }

  .key-ingredients--header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    margin-bottom: 33px;
    width: 100%;
  }

  .key-ingredients--header-title {
    flex: 1 1 auto;
    min-width: 0;
  }

  .key-ingredients--heading {
    margin: 0;
    color: var(--ki-section-heading-color, #1a1a1a);
    font-size: var(--ki-heading-font-size, 14px);
    font-weight: 500;
    letter-spacing: 0.1em !important;
    text-transform: uppercase;
    line-height: 1.3;
    text-align: center;
  }

  .key-ingredients--header .carousel-nav-arrow {
    flex: 0 0 auto;
    margin-left: auto;
    color: var(--ki-arrow-color, #1a1a1a);
    gap: 2px;
  }

  .key-ingredients--header .carousel-nav-arrow--current,
  .key-ingredients--header .carousel-nav-arrow--total {
    font-size: 13px;
    line-height: 1;
    letter-spacing: 0.02em;
  }

  .key-ingredients--header .carousel-nav-arrow--prev,
  .key-ingredients--header .carousel-nav-arrow--next {
    padding: 4px 6px;
  }

  .key-ingredients--header .carousel-nav-arrow svg {
    width: 10px;
    height: 10px;
  }

  /* Header <1/3> arrows — separate from side arrows */
  .key-ingredients--root[data-show-arrows='false'] .key-ingredients--header .carousel-nav-arrow {
    display: none !important;
  }

  @media only screen and (min-width: 640px) {
    .key-ingredients--root[data-show-arrows='true'] .key-ingredients--header .carousel-nav-arrow {
      display: inline-flex !important;
    }
  }

  @media only screen and (max-width: 639px) {
    .key-ingredients--root[data-show-arrows='false'][data-mobile-show-arrows='true'] .key-ingredients--header .carousel-nav-arrow {
      display: inline-flex !important;
    }

    .key-ingredients--root[data-mobile-show-arrows='false'] .key-ingredients--header .carousel-nav-arrow {
      display: none !important;
    }
  }

  /* Slide stage: [side arrow] [slide] [side arrow], dots separately below */
  .key-ingredients--carousel {
    overflow: visible;
    width: 100%;
    --dot-width: var(--ki-dot-size, 8px);
    --dot-height: var(--ki-dot-size, 8px);
    --dot-gap: 10px;
  }

  .key-ingredients--carousel-wrapper {
    display: flex;
    flex-direction: column;
    align-items: stretch;
    gap: 24px;
    width: 100%;
    overflow: visible;
  }

  .key-ingredients--stage {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    align-items: center;
    width: 100%;
    min-width: 0;
  }

  .key-ingredients--root[data-show-side-arrows='true'] .key-ingredients--stage {
    grid-template-columns: 40px minmax(0, 1fr) 40px;
    column-gap: 12px;
  }

  /* 1 slide: arrows/dots are omitted, so drop the empty 40px arrow columns.
     Otherwise the viewport sits in the first 40px track and the 50/50 layout collapses. */
  .key-ingredients--root[data-slide-count='1'] .key-ingredients--stage,
  .key-ingredients--stage:not(:has(.key-ingredients--side-arrow)) {
    grid-template-columns: minmax(0, 1fr) !important;
    column-gap: 0 !important;
  }

  .key-ingredients--root[data-slide-count='1'] .key-ingredients--side-arrow,
  .key-ingredients--root[data-slide-count='1'] .key-ingredients--header .carousel-nav-arrow,
  .key-ingredients--root[data-slide-count='1'] .slideshow-pagination {
    display: none !important;
  }

  .key-ingredients--root[data-slide-count='1'] .key-ingredients--carousel-wrapper {
    gap: 0;
  }

  .key-ingredients--root[data-slide-count='1'] .key-ingredients--carousel,
  .key-ingredients--root[data-slide-count='1'] .key-ingredients--carousel-wrapper,
  .key-ingredients--root[data-slide-count='1'] .key-ingredients--viewport,
  .key-ingredients--root[data-slide-count='1'] .key-ingredients--slide {
    width: 100%;
    max-width: 100%;
  }

  .key-ingredients--root[data-slide-count='1'] .key-ingredients--carousel .slideshow-carousel--container {
    width: 100% !important;
    transform: none !important;
    height: auto !important;
  }

  .key-ingredients--root[data-slide-count='1'] .key-ingredients--carousel .slideshow-carousel--container > * {
    width: 100% !important;
    flex: 0 0 100%;
  }

  .key-ingredients--carousel .slideshow-carousel--container {
    height: auto;
  }

  .key-ingredients--side-arrow.slideshow-carousel--prev,
  .key-ingredients--side-arrow.slideshow-carousel--next {
    position: static !important;
    top: auto !important;
    left: auto !important;
    right: auto !important;
    transform: none !important;
    display: none;
    align-items: center;
    justify-content: center;
    color: var(--ki-arrow-color, #1a1a1a);
    opacity: 1;
    z-index: 2;
    padding: 8px;
    margin: 0;
    background: transparent;
    border: 0;
    cursor: pointer;
    line-height: 0;
    height: auto;
    align-self: center;
    justify-self: center;
  }

  .key-ingredients--root[data-show-side-arrows='true'] .key-ingredients--side-arrow {
    display: inline-flex !important;
  }

  .key-ingredients--side-arrow .icon--root {
    width: 12px;
    height: 12px;
  }

  /* Theme hides disabled slideshow arrows (opacity: 0) — keep them visible when side arrows are on */
  .key-ingredients--root[data-show-side-arrows='true'] .key-ingredients--side-arrow[aria-disabled='true'],
  .key-ingredients--root[data-mobile-show-side-arrows='true'] .key-ingredients--side-arrow[aria-disabled='true'] {
    opacity: 1 !important;
    cursor: default;
    pointer-events: none;
  }

  .key-ingredients--viewport {
    width: 100%;
    min-width: 0;
    overflow: hidden;
    position: relative;
    z-index: 1;
  }

  .key-ingredients--carousel .slideshow-carousel--container {
    touch-action: pan-y;
    will-change: transform;
    width: calc(100% * var(--total-slides));
    display: flex;
    align-items: flex-start;
    position: relative;
    transform: translateX(var(--slide-pos, 0px));
  }

  .key-ingredients--carousel .slideshow-carousel--container[data-transition-state='forwards'] {
    transition: transform 1s var(--transition--ease-out, ease), height 0.4s var(--transition--ease-out, ease);
  }

  .key-ingredients--carousel .slideshow-carousel--container[data-transition-state='backwards'] {
    transition: transform 0.4s var(--transition--snap-back, ease), height 0.4s var(--transition--ease-out, ease);
  }

  .key-ingredients--carousel .slideshow-carousel--container > * {
    width: calc(100% / var(--total-slides));
    flex-shrink: 0;
    height: fit-content;
  }

  .key-ingredients--carousel .slideshow-carousel--container * {
    -webkit-user-drag: none;
    line-height: 1.2;
  }

  .key-ingredients--carousel-wrapper > .slideshow-pagination {
    position: relative !important;
    width: 100%;
    max-width: none;
    bottom: auto !important;
    left: auto !important;
    right: auto !important;
    display: flex;
    justify-content: center;
    margin: 0;
    z-index: 5;
    pointer-events: auto;
  }

  .key-ingredients--carousel-wrapper > .slideshow-pagination .slideshow-pagination--wrapper {
    position: static !important;
    bottom: auto !important;
    right: auto !important;
    justify-content: center;
    transform: none !important;
    pointer-events: auto;
  }

  /* Round clickable dots */
  .key-ingredients--carousel .slideshow-pagination {
    position: relative !important;
    z-index: 8;
    pointer-events: auto !important;
  }

  .key-ingredients--carousel [data-item='pagination-dot'] {
    appearance: none;
    border: 0;
    background: transparent;
    cursor: pointer;
    pointer-events: auto !important;
    position: relative;
    z-index: 9;
    padding: 8px;
    margin: -8px;
    line-height: 0;
  }

  .key-ingredients--carousel [data-item='pagination-dot'] * {
    pointer-events: none !important;
  }

  .key-ingredients--carousel [data-item='pagination-dot'] div {
    border-radius: 50%;
    border: 0 !important;
    width: var(--ki-dot-size, 8px) !important;
    height: var(--ki-dot-size, 8px) !important;
    background-color: #000000;
    overflow: hidden;
  }

