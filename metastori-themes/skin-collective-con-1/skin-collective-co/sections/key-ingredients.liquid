{% javascript %}
  (() => {
    const goToSlide = (carousel, slideIndex) => {
      if (!carousel || !slideIndex) return;

      const container = carousel.querySelector('.slideshow-carousel--container');
      const slides = container ? [...container.children] : [];
      const total = slides.length || Number(getComputedStyle(carousel).getPropertyValue('--total-slides')) || 0;
      if (total < 1 || slideIndex < 1 || slideIndex > total) return;

      if (typeof carousel.updateThenGoToActiveSlide === 'function') {
        carousel.updateThenGoToActiveSlide(slideIndex, true);
      } else {
        carousel.active_slide = slideIndex;
        const pct = ((slideIndex - 1) / total) * -100;
        carousel.style.setProperty('--slide-pos', `${pct}%`);
        if (container) container.setAttribute('data-transition-state', 'forwards');
      }

      if (typeof carousel.updateActiveDot === 'function') {
        carousel.updateActiveDot();
      } else {
        carousel.querySelectorAll('[data-item="pagination-dot"]').forEach((dot, i) => {
          dot.setAttribute('aria-current', i === slideIndex - 1 ? 'true' : 'false');
        });
      }

      if (typeof carousel.updateActive === 'function') carousel.updateActive();
      if (typeof carousel.setSliderHeight === 'function') carousel.setSliderHeight();
    };

    const bindDots = (root) => {
      if (!root || root.dataset.kiDotsBound === 'true') return;

      const carousel = root.querySelector('slideshow-carousel.key-ingredients--carousel, .key-ingredients--carousel');
      const pagination = root.querySelector('.slideshow-pagination');
      if (!carousel || !pagination) return;

      root.dataset.kiDotsBound = 'true';

      pagination.addEventListener(
        'click',
        (event) => {
          const dot = event.target.closest('[data-item="pagination-dot"]');
          if (!dot || !pagination.contains(dot)) return;

          event.preventDefault();
          event.stopPropagation();

          const dots = [...pagination.querySelectorAll('[data-item="pagination-dot"]')];
          const index = dots.indexOf(dot);
          if (index < 0) return;

          goToSlide(carousel, index + 1);
        },
        true
      );
    };

    const init = () => {
      document.querySelectorAll('.key-ingredients--root').forEach(bindDots);
    };

    const start = () => {
      const run = () => {
        requestAnimationFrame(init);
        setTimeout(init, 50);
        setTimeout(init, 300);
      };

      if (window.customElements?.whenDefined) {
        customElements.whenDefined('slideshow-carousel').then(run).catch(run);
      } else {
        run();
      }
    };

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', start, { once: true });
    } else {
      start();
    }

    document.addEventListener('shopify:section:load', (event) => {
      const section = event.target;
      const root =
        section.querySelector?.('.key-ingredients--root') ||
        (section.classList?.contains('key-ingredients--root') ? section : null);
      if (root) {
        delete root.dataset.kiDotsBound;
        setTimeout(() => bindDots(root), 50);
      }
    });
  })();
{% endjavascript %}

