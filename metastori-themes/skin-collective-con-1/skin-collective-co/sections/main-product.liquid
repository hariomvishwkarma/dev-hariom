      "id": "text-color",
      "label": "Text color",
      "type": "select",
      "options": [
        {
          "label": "Light",
          "value": "white"
        },
        {
          "label": "Dark",
          "value": "body"
        }
      ],
      "default": "body"
    },
    {
      "id": "text-alignment",
      "label": "Text alignment",
      "type": "text_alignment",
      "default": "left"
    },
    {
      "type": "header",
      "content": "Image layout"
    },
    {
      "id":"media-layout",
      "label": "Media layout",
      "type": "select",
      "options": [
        { "label": "Thumbnails", "value": "thumbnails" },
        { "label": "One column", "value": "one" },
        { "label": "Two columns", "value": "two" },
        { "label": "Mixed", "value": "mixed" }
      ],
      "default": "thumbnails"
    },
    {
      "type": "range",
      "id": "thumbnail-width",
      "label": "Thumbnail width",
      "min": 40,
      "max": 140,
      "step": 1,
      "unit": "px",
      "default": 80,
      "visible_if": "{{ section.settings.media-layout == 'thumbnails' or section.settings.mobile-media-layout == 'thumbnails' }}"
    },
    {
      "id": "thumbnail-aspect-ratio",
      "label": "Thumbnail aspect ratio",
      "type": "select",
      "options": [
        { "label": "Natural", "value": "natural" },
        { "label": "Square (1:1)", "value": "square" },
        { "label": "Landscape (4:3)", "value": "landscape" },
        { "label": "Portrait (4:5)", "value": "portrait" },
        { "label": "Portrait (2:3)", "value": "tall-portrait" }
      ],
      "default": "square",
      "info": "Crops thumbnails to a fixed ratio based on thumbnail width.",
      "visible_if": "{{ section.settings.media-layout == 'thumbnails' or section.settings.mobile-media-layout == 'thumbnails' }}"
    },
    {
      "type": "checkbox",
      "id": "desktop-thumbnail-arrows",
