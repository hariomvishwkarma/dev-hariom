<!-- sections/main-product.liquid -->
{%- render 'section-max-width' -%}
{%- render 'section-padding' -%}

{%- liquid
  assign bg_color = section.settings.background-color
  assign border = section.settings.border
  assign breadcrumbs_enabled = section.settings.breadcrumbs-enabled
  assign column_spacing = section.settings.column-spacing
  assign container_width = section.settings.container-width
  assign media_gap = section.settings.media-gap
  assign media_layout = section.settings.media-layout
  assign mobile_media_layout = section.settings.mobile-media-layout
  assign mobile_spacing_above = section.settings.mobile-spacing-above
  assign mobile_spacing_below = section.settings.mobile-spacing-below
  assign mobile_text_alignment = section.settings.mobile-text-alignment
  assign product_id = section.id | append: '_' | append: product.id
  assign reverse_layout = section.settings.reverse-layout
  assign spacing_above = section.settings.spacing-above
  assign spacing_below = section.settings.spacing-below
  assign text_alignment = section.settings.text-alignment
  assign text_color = section.settings.text-color
  assign text_column_width = section.settings.text-column-width
  assign text_column_width_unit = section.settings.text-column-width-unit | default: 'px'
  assign text_column_percent = section.settings.text-column-percent | default: 50
  if text_column_percent < 30
    assign text_column_percent = 30
  endif
  if text_column_percent > 70
    assign text_column_percent = 70
  endif
  assign media_column_percent = 100 | minus: text_column_percent
  assign thumbnail_width = section.settings.thumbnail-width
  assign thumbnail_aspect_ratio = section.settings.thumbnail-aspect-ratio | default: 'square'
  assign desktop_thumbnail_arrows = section.settings.desktop-thumbnail-arrows
  assign desktop_thumbnail_arrow_gap = section.settings.desktop-thumbnail-arrow-gap | default: 12
  assign desktop_thumbnail_arrow_width = section.settings.desktop-thumbnail-arrow-width | default: 14
  assign desktop_thumbnail_arrow_height = section.settings.desktop-thumbnail-arrow-height | default: 14
  assign desktop_thumbnail_thumb_height = section.settings.desktop-thumbnail-thumb-height | default: 0
  assign desktop_thumbnail_visible_count = section.settings.desktop-thumbnail-visible-count | default: 3
  if desktop_thumbnail_visible_count < 3
    assign desktop_thumbnail_visible_count = 3
  endif
  assign breadcrumb_separator = section.settings.breadcrumb-separator | default: 'circle'
  assign breadcrumb_font_size = section.settings.breadcrumb-font-size | default: 0
  assign breadcrumb_shop_label = section.settings.breadcrumb-shop-label | default: 'Shop'
  assign breadcrumbs_mobile = section.settings.breadcrumbs-mobile
  assign collapsible_icon = section.settings.collapsible-icon | default: 'chevron'
  assign accordion_heading_font_size = section.settings.accordion-heading-font-size | default: 0
  assign accordion_content_font_size = section.settings.accordion-content-font-size | default: 0
  assign accordion_row_padding = section.settings.accordion-row-padding | default: 12
  assign product_block_gap = section.settings.product-block-gap | default: 0
  assign variant_scroll_enabled = section.settings.variant-scroll-enabled
  assign video_looping_enabled = section.settings.loop-enabled
  assign zoom_enabled = section.settings.image-zoom-enabled

  assign modal_enabled = false
  if product.media.size > 0
    assign modal_enabled = section.settings.modal-enabled
  endif

  capture sizes
    assign columns = 1
    assign additional_padding = text_column_width | plus: 32
    if media_layout == 'two'
      assign columns = columns | times: 2
    elsif media_layout == 'thumbnails'
      assign additional_padding = additional_padding | plus: thumbnail_width | plus: 32
    endif

    render 'sizes-grid', columns: columns, column_spacing: media_gap, additional_padding: additional_padding, container_width: container_width
  endcapture

  capture css_vars
    echo '--text-column-width:' | append: text_column_width | append: 'px;'
    echo '--media-gap:' | append: media_gap | append: 'px;'
    echo '--thumbnail-width:' | append: thumbnail_width | append: 'px;'
    if desktop_thumbnail_arrows
      echo '--desktop-thumb-arrow-gap:' | append: desktop_thumbnail_arrow_gap | append: 'px;'
      echo '--desktop-thumb-arrow-width:' | append: desktop_thumbnail_arrow_width | append: 'px;'
      echo '--desktop-thumb-arrow-height:' | append: desktop_thumbnail_arrow_height | append: 'px;'
      echo '--desktop-thumbnail-visible-count:' | append: desktop_thumbnail_visible_count | append: ';'
      if desktop_thumbnail_thumb_height > 0
        echo '--desktop-thumbnail-height:' | append: desktop_thumbnail_thumb_height | append: 'px;'
      endif
    endif
    echo '--accordion-row-padding:' | append: accordion_row_padding | append: 'px;'
    echo '--text-col-fr:' | append: text_column_percent | append: 'fr;'
    echo '--media-col-fr:' | append: media_column_percent | append: 'fr;'
    if breadcrumb_font_size > 0
      echo '--breadcrumb-font-size:' | append: breadcrumb_font_size | append: 'px;'
    endif
    if accordion_heading_font_size > 0
      echo '--accordion-heading-font-size:' | append: accordion_heading_font_size | append: 'px;'
    endif
    if accordion_content_font_size > 0
      echo '--accordion-content-font-size:' | append: accordion_content_font_size | append: 'px;'
    endif
    if product_block_gap > 0
      echo '--product-block-gap:' | append: product_block_gap | append: 'px;'
    endif
  endcapture
-%}

<script type="module">
  import { Utils } from '@troop-themes/main';
  Utils.updateRecentProducts('{{ product.handle }}');
</script>

<div
  class="main-product--root"
  data-product-id="{{ product_id }}"
  data-section-id="{{ section.id }}"
  data-section-type="product_page"
  data-background-color="{{ bg_color }}"
  data-border="{{ border }}"
  data-container-width="{{ container_width }}"
  data-handle="{{ product.handle }}"
  data-mobile-spacing-above="{{ mobile_spacing_above }}"
  data-mobile-spacing-below="{{ mobile_spacing_below }}"
  data-mobile-x-alignment="{{ mobile_text_alignment }}"
  data-spacing-above="{{ spacing_above }}"
  data-spacing-below="{{ spacing_below }}"
  data-x-alignment="{{ text_alignment }}"
  data-thumbnail-aspect-ratio="{{ thumbnail_aspect_ratio }}"
  {% if desktop_thumbnail_arrows %}data-desktop-thumbnail-arrows="true"{% endif %}
  {% if desktop_thumbnail_thumb_height > 0 %}data-desktop-thumbnail-custom-height="true"{% endif %}
  data-breadcrumb-separator="{{ breadcrumb_separator }}"
  data-collapsible-icon="{{ collapsible_icon }}"
  {% if breadcrumb_font_size > 0 %}data-breadcrumb-font-size="true"{% endif %}
  {% if accordion_heading_font_size > 0 %}data-accordion-heading-font-size="true"{% endif %}
  {% if accordion_content_font_size > 0 %}data-accordion-content-font-size="true"{% endif %}
  {% if product_block_gap > 0 %}data-product-block-gap="true"{% endif %}
  style="{{ css_vars }}"
>
  <div
    class="main-product--wrapper"
    data-container="split"
    data-reverse-layout="{{ reverse_layout }}"
    data-text-column-unit="{{ text_column_width_unit }}"
  >
    {%- if mobile_media_layout == 'thumbnails' and media_layout == 'thumbnails' -%}
      <div
        class="main-product--media"
        {% if mobile_media_layout == 'slideshow' %}
          data-container="block"
        {% endif %}
      >
        {%-
          render 'product-media--variants',
          product: product,
          product_id: product_id,
          layout: 'thumbnails',
          sizes: sizes,
          thumbnail_width: thumbnail_width,
          desktop_thumbnail_arrows: desktop_thumbnail_arrows,
          modal_enabled: modal_enabled,
          variant_scroll_enabled: variant_scroll_enabled,
          video_looping_enabled: video_looping_enabled,
          zoom_enabled: zoom_enabled
        -%}
      </div>
    {%- else -%}
      <div class="main-product--desktop" data-mq="medium-large">
        {%-
          render 'product-media--variants',
          product: product,
          product_id: product_id,
          column_spacing: column_spacing,
          layout: media_layout,
          media_gap: media_gap,
          media_size: 'desktop',
          modal_enabled: modal_enabled,
          sizes: sizes,
          thumbnail_width: thumbnail_width,
          desktop_thumbnail_arrows: desktop_thumbnail_arrows,
          variant_scroll_enabled: variant_scroll_enabled,
          video_looping_enabled: video_looping_enabled,
          zoom_enabled: zoom_enabled
        -%}
      </div>

      <div
        class="main-product--mobile"
        data-mq="small"
        data-layout="{{ mobile_media_layout }}"
        {% if mobile_media_layout == 'slideshow' %}
          data-container="block"
        {% endif %}
      >
        {%- if mobile_media_layout == 'thumbnails' -%}
          {%-
            render 'product-media--variants',
            product: product,
            product_id: product_id,
            media_size: 'mobile',
            layout: 'thumbnails',
            sizes: sizes,
            thumbnail_width: thumbnail_width,
            video_looping_enabled: video_looping_enabled
          -%}
        {%- elsif mobile_media_layout == 'slideshow' -%}
          {%-
            render 'product-carousel',
            product_id: product_id,
            section: section,
            product: product,
            video_looping_enabled: video_looping_enabled
          -%}

          {%- liquid
            assign total_slides_mobile = 4
            if product.media.size > 0
              assign total_slides_mobile = product.media.size
            endif

            render 'carousel-nav-arrow', id: product_id, total_slides_mobile: total_slides_mobile, text_color: text_color
          -%}
        {%- endif -%}
      </div>
    {%- endif -%}

    {%-
      render 'product-form',
      alignment: text_alignment,
      breadcrumbs_enabled: breadcrumbs_enabled,
      breadcrumbs_mobile: breadcrumbs_mobile,
      breadcrumb_shop_label: breadcrumb_shop_label,
      breadcrumb_shop_url: section.settings.breadcrumb-shop-url,
      collapsible_icon: collapsible_icon,
      main_product: true,
      mobile_alignment: mobile_text_alignment,
      product: product,
      section: section,
      text_color: text_color,
    -%}
  </div>
</div>

{% stylesheet %}
  .main-product--root {
    @media (min-width: 768px) {
      .product-form {
        position: sticky;
        top: calc(var(--sticky-offset) + var(--spacing--1));
        height: fit-content;
        transition: top 0.2s var(--transition--standard);
      }

      .layout--viewport:not([data-header-layout='sidebar']) &[data-spacing-above='none'] .product-form {
        top: calc(var(--sticky-offset) + var(--spacing--neg-item));
        padding-top: var(--spacing--block);
      }

      &[data-container-width='6'] .product-form {
        padding-right: var(--spacing--item);
      }
    }

    .card-carousel--root {
      width: 100%;
    }

    .carousel-nav-arrow {
      align-self: center;
    }
  }

  .main-product--wrapper[data-container='split'] {
    @media (min-width: 768px) {
      --grid-columns: minmax(0, 1fr) minmax(0, var(--text-column-width));
      justify-content: center;
      align-items: stretch;
      position: relative;

      &[data-reverse-layout='true'] {
        --grid-columns: minmax(0, var(--text-column-width)) minmax(0, 1fr);
      }

      /* Percent mode: fr shares remaining space after column-gap is subtracted */
      &[data-text-column-unit='percent'] {
        --grid-columns: minmax(0, var(--media-col-fr, 50fr)) minmax(0, var(--text-col-fr, 50fr));
      }

      &[data-text-column-unit='percent'][data-reverse-layout='true'] {
        --grid-columns: minmax(0, var(--text-col-fr, 50fr)) minmax(0, var(--media-col-fr, 50fr));
      }
    }

    @media (max-width: 767px) {
      --grid-row-gap: var(--spacing--item);
    }
  }
{% endstylesheet %}

