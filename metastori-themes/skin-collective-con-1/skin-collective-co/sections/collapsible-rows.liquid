<!-- sections/collapsible-rows.liquid -->
{%- render 'section-max-width' -%}
{%- render 'section-padding' -%}

{%- liquid
  assign bg_color = section.settings.background-color
  assign border = section.settings.border
  assign container_width = section.settings.container-width
  assign heading = section.settings.heading
  assign heading_alignment = section.settings.heading-alignment
  assign heading_type = section.settings.heading-type
  assign mobile_full_width = section.settings.mobile-full-width
  assign mobile_spacing_above = section.settings.mobile-spacing-above
  assign mobile_spacing_below = section.settings.mobile-spacing-below
  assign spacing_above = section.settings.spacing-above
  assign spacing_below = section.settings.spacing-below
  assign two_columns_enabled = section.settings.two-columns-enabled
  assign text_color = section.settings.text-color

  assign section_title_font_size = section.settings.section-title-font-size | default: 0
  assign mobile_section_title_font_size = section.settings.mobile-section-title-font-size | default: 0
  assign faq_title_font_size = section.settings.faq-title-font-size | default: 0
  assign mobile_faq_title_font_size = section.settings.mobile-faq-title-font-size | default: 0
  assign description_font_size = section.settings.description-font-size | default: 0
  assign mobile_description_font_size = section.settings.mobile-description-font-size | default: 0

  capture cr_custom_style
    if section_title_font_size > 0
      echo '--cr-section-title-size:' | append: section_title_font_size | append: 'px;'
    endif
    if mobile_section_title_font_size > 0
      echo '--cr-mobile-section-title-size:' | append: mobile_section_title_font_size | append: 'px;'
    endif
    if faq_title_font_size > 0
      echo '--cr-faq-title-size:' | append: faq_title_font_size | append: 'px;'
    endif
    if mobile_faq_title_font_size > 0
      echo '--cr-mobile-faq-title-size:' | append: mobile_faq_title_font_size | append: 'px;'
    endif
    if description_font_size > 0
      echo '--cr-description-size:' | append: description_font_size | append: 'px;'
    endif
    if mobile_description_font_size > 0
      echo '--cr-mobile-description-size:' | append: mobile_description_font_size | append: 'px;'
    endif
  endcapture

  assign block_remainder = section.blocks.size | modulo: 2
  assign block_quotient = section.blocks.size | divided_by: 2
  assign last_left_block_index = block_remainder | plus: block_quotient

  assign left_column_blocks = ''
  assign right_column_blocks = ''
-%}

{%- for block in section.blocks -%}
  {%- capture block_html -%}
    <div
      class="collapsible-rows--block"
      data-fit-together="true"
      {% unless settings.transitions--other %}
        data-transition-item="{{ section.id }}"
      {% endunless %}
      {{ block.shopify_attributes }}
    >
      {% render 'collapsible-row',
        description: block.settings.description,
        heading: block.settings.heading,
        default_open: block.settings.default-open,
        page_content: block.settings.page-content,
        content_padding_top: section.settings.content-padding-top,
        content_padding_bottom: section.settings.content-padding-bottom,
        id: block.id,
        text_color: text_color,
        view: 'large',
        icon: 'chevron'
      %}
    </div>
  {%- endcapture -%}

  {%- liquid
    if forloop.index <= last_left_block_index
      assign left_column_blocks = left_column_blocks | append: block_html
    else
      assign right_column_blocks = right_column_blocks | append: block_html
    endif
  -%}
{%- endfor -%}

<div
  class="collapsible-rows--root"
  data-section-id="{{ section.id }}"
  data-background-color="{{ bg_color }}"
  data-border="{{ border }}"
  data-container-width="{{ container_width }}"
  data-mobile-full-width="{{ mobile_full_width }}"
  data-mobile-spacing-above="{{ mobile_spacing_above }}"
  data-mobile-spacing-below="{{ mobile_spacing_below }}"
  data-spacing-above="{{ spacing_above }}"
  data-spacing-below="{{ spacing_below }}"
  data-text-color="{{ text_color }}"
  {% if section_title_font_size > 0 %}data-section-title-font-size="true"{% endif %}
  {% if mobile_section_title_font_size > 0 %}data-mobile-section-title-font-size="true"{% endif %}
  {% if faq_title_font_size > 0 %}data-faq-title-font-size="true"{% endif %}
  {% if mobile_faq_title_font_size > 0 %}data-mobile-faq-title-font-size="true"{% endif %}
  {% if description_font_size > 0 %}data-description-font-size="true"{% endif %}
  {% if mobile_description_font_size > 0 %}data-mobile-description-font-size="true"{% endif %}
  {% if cr_custom_style != blank %}style="{{ cr_custom_style }}"{% endif %}
  {% unless settings.transitions--other %}
    data-transition-container="{{ section.id }}"
    data-transition-type="fade-in"
    data-transition-cascade="vertical"
    data-transition-cascade-interval="120"
  {% endunless %}
>
  <div class="collapsible-rows--wrapper" data-container="section">
    {%- unless heading == blank -%}
      <div
        class="collapsible-rows--header"
        data-container="block"
        data-x-alignment="{{ heading_alignment }}"
        {% unless settings.transitions--text %}
          data-transition-item="viewport"
          data-transition-type="slide-in"
        {% endunless %}
      >
        <h2 data-item="{{ heading_type }}">
          {{- heading | escape -}}
        </h2>
      </div>
    {%- endunless -%}

    {%- if section.blocks.size > 0 -%}
      <div class="collapsible-rows--main" data-two-columns="{{ two_columns_enabled }}">
        <div class="collapsible-rows--left">
          {{- left_column_blocks -}}
        </div>
        <div class="collapsible-rows--right">
          {{- right_column_blocks -}}
        </div>
      </div>
    {%- endif -%}
  </div>
</div>

{% stylesheet %}
  .collapsible-rows--wrapper {
    width: 100%;
  }

  /* Optional custom font sizes (0 = theme default). Desktop values. */
  .collapsible-rows--root[data-section-title-font-size='true'] .collapsible-rows--header h2[data-item] {
    font-size: var(--cr-section-title-size) !important;
    font-family: "Sweet Sans Pro Medium" !important;
        font-weight: 500 !important;
  }

  .collapsible-rows--root[data-faq-title-font-size='true'] .collapsible-row--heading,
  .collapsible-rows--root[data-faq-title-font-size='true'] .collapsible-row--heading [data-item] {
    font-size: var(--cr-faq-title-size) !important;
  }

  .collapsible-rows--root[data-description-font-size='true'] .collapsible-row--inner[data-item='rte-content'],
  .collapsible-rows--root[data-description-font-size='true'] .collapsible-row--inner[data-item='rte-content'] p,
  .collapsible-rows--root[data-description-font-size='true'] .collapsible-row--inner[data-item='rte-content'] li {
    font-size: var(--cr-description-size) !important;
  }

  @media (max-width: 767px) {
    .collapsible-rows--root[data-mobile-section-title-font-size='true'] .collapsible-rows--header h2[data-item] {
      font-size: var(--cr-mobile-section-title-size) !important;
    }

    .collapsible-rows--root[data-mobile-faq-title-font-size='true'] .collapsible-row--heading,
    .collapsible-rows--root[data-mobile-faq-title-font-size='true'] .collapsible-row--heading [data-item] {
      font-size: var(--cr-mobile-faq-title-size) !important;
    }

    .collapsible-rows--root[data-mobile-description-font-size='true'] .collapsible-row--inner[data-item='rte-content'],
    .collapsible-rows--root[data-mobile-description-font-size='true'] .collapsible-row--inner[data-item='rte-content'] p,
    .collapsible-rows--root[data-mobile-description-font-size='true'] .collapsible-row--inner[data-item='rte-content'] li {
      font-size: var(--cr-mobile-description-size) !important;
    }
  }

  /* Real borders instead of the theme's :before/:after pseudo lines, so every
     seam has exactly one crisp 1px border (no doubling, consistent on zoom).
     Scoped to this section only — the collapsible-row snippet is shared. */
  .section--collapsible-rows .collapsible-row--root::before,
  .section--collapsible-rows .collapsible-row--root::after {
    content: none;
  }

  .section--collapsible-rows .collapsible-row--root {
    border-top: var(--border--thickness) solid rgba(0, 0, 0, 0.2);
    border-bottom: var(--border--thickness) solid rgba(0, 0, 0, 0.2);
  }

  /* Collapse the seam between stacked rows in the same column. */
  .section--collapsible-rows .collapsible-rows--block + .collapsible-rows--block .collapsible-row--root {
    border-top: 0;
  }

  /* Single-column layouts stack the right column under the left, so drop the
     first right-column row's top border to avoid a doubled seam. Mobile is
     always single column; desktop only when two columns are disabled. */
  @media (max-width: 767px) {
    .section--collapsible-rows
      .collapsible-rows--right
      > .collapsible-rows--block:first-child
      .collapsible-row--root {
      border-top: 0;
    }
  }

  @media (min-width: 768px) {
    .section--collapsible-rows
      .collapsible-rows--main[data-two-columns='false']
      .collapsible-rows--right
      > .collapsible-rows--block:first-child
      .collapsible-row--root {
      border-top: 0;
    }
  }

  .collapsible-rows--main {
    padding-bottom: var(--border--thickness);

    @media (min-width: 768px) {
      display: flex;

      &[data-two-columns='false'] {
        flex-direction: column;

        > *:first-child > *:last-child > * {
          border-bottom: 0;
        }
      }

      &[data-two-columns='true'] {
        gap: var(--spacing--9);
      }

      > * {
        width: 100%;
      }
    }

    @media (max-width: 767px) {
      flex-direction: column;

      > *:first-child > *:last-child > * {
        border-bottom: 0;
      }
    }
  }
{% endstylesheet %}

