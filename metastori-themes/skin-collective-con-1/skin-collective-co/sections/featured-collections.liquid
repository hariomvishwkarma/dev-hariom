      "info": "Container keeps content centered. Full width spans the viewport."
    },
    {
      "id": "background-color",
      "label": "Background color",
      "type": "select",
      "options": [
        {
          "label": "None",
          "value": "none"
        },
        {
          "label": "Light",
          "value": "light"
        },
        {
          "label": "Dark",
          "value": "dark"
        },
        {
          "label": "Accent 1",
          "value": "accent-1"
        },
        {
          "label": "Accent 2",
          "value": "accent-2"
        },
        {
          "label": "Accent 3",
          "value": "accent-3"
        }
      ],
      "default": "none"
    },
    {
      "type": "header",
      "content": "Features"
    },
    {
      "id": "display-type",
      "label": "Display type",
      "type": "select",
      "options": [
        { "label": "Slideshow", "value": "slideshow" },
        { "label": "Grid", "value": "grid" }
      ],
      "default": "slideshow"
    },
    {
      "id": "width",
      "label": "Blocks per row",
      "type": "range",
      "min": 2,
      "max": 6,
      "step": 1,
      "default": 3
    },
    {
      "type": "header",
      "content": "Text layout"
    },
    {
      "id": "heading-type",
      "label": "Heading type",
      "type": "select",
      "options": [
        {
          "label": "Banner",
          "value": "banner-heading"
        },
        {
          "label": "Featured",
          "value": "featured-heading"
        },
        {
          "label": "Large",
          "value": "section-heading"
        },
        {
          "label": "Medium",
          "value": "block-heading"
        }
      ],
      "default": "section-heading"
    },
    {
      "id": "heading-alignment",
      "label": "Heading alignment",
      "type": "text_alignment",
      "default": "center"
    },
    {
      "id": "block-text-alignment",
      "label": "Block text alignment",
      "type": "text_alignment",
      "default": "center"
    },
    {
      "id": "text-color",
      "label": "Text color",
      "type": "select",
      "options": [
        {
          "label": "Light",
          "value": "white"
        },
        {
          "label": "Dark",
          "value": "body"
        }
      ],
      "default": "body"
    },
    {
      "type": "header",
      "content": "Custom size"
    },
    {
      "type": "range",
      "id": "extra-title-font-size",
      "label": "Collection title font size",
      "min": 0,
      "max": 32,
      "step": 1,
      "unit": "px",
      "default": 16,
      "info": "Extra size for collection titles. 0 uses the theme heading style. Works alongside Heading type."
    },
    {
      "type": "range",
      "id": "custom-image-height",
      "label": "Image height",
      "min": 0,
      "max": 800,
      "step": 10,
      "unit": "px",
      "default": 0,
      "info": "0 keeps the theme collection image ratio. Set a height to override; images still use cover fit."
    },
    {
      "type": "range",
      "id": "image-ratio",
      "label": "Image ratio (desktop + tablet)",
      "min": 0,
      "max": 200,
      "step": 5,
      "unit": "%",
      "default": 100,
      "info": "Height as a % of the card width, so desktop and tablet keep the exact same ratio. 100% = square. 0 falls back to the pixel heights above."
    },
    {
      "type": "header",
      "content": "Mobile"
    },
    {
      "id": "mobile-layout",
      "label": "Mobile layout",
      "type": "select",
      "options": [
        {
          "value": "default",
          "label": "Same as desktop"
        },
        {
          "value": "featured-scroll",
          "label": "Featured image + horizontal categories"
        },
        {
          "value": "grid",
          "label": "Grid"
        },
        {
          "value": "slider",
          "label": "Slider"
        }
      ],
      "default": "featured-scroll",
      "info": "Featured image shows the first collection; remaining collections scroll horizontally. Grid / Slider show all collections in a grid or a horizontal slider. Use 'Blocks visible in mobile slider' below to set how many show per row / at once."
    },
    {
      "type": "range",
      "id": "mobile-extra-title-font-size",
      "label": "Mobile title font size",
      "min": 0,
      "max": 32,
      "step": 1,
      "unit": "px",
      "default": 16,
      "info": "0 uses desktop title size / theme style."
    },
    {
      "type": "range",
      "id": "mobile-custom-image-height",
      "label": "Mobile image height",
      "min": 0,
      "max": 800,
      "step": 10,
      "unit": "px",
      "default": 0,
      "info": "0 keeps 1:1 square. Sets min-height on the image wrapper; the img matches that same min-height."
    },
    {
      "id": "mobile-spacing-above",
      "label": "Spacing above",
      "type": "select",
      "options": [
        {
          "label": "None",
          "value": "none"
        },
        {
          "label": "Small",
          "value": "small"
        },
        {
          "label": "Medium",
          "value": "medium"
        },
        {
          "label": "Large",
          "value": "large"
        },
        {
          "label": "Extra large",
          "value": "x-large"
        }
      ],
      "default": "medium"
    },
    {
      "id": "mobile-spacing-below",
      "label": "Spacing below",
      "type": "select",
      "options": [
        {
          "label": "None",
          "value": "none"
        },
        {
          "label": "Small",
          "value": "small"
        },
        {
          "label": "Medium",
          "value": "medium"
        },
        {
          "label": "Large",
          "value": "large"
        },
        {
          "label": "Extra large",
          "value": "x-large"
        }
      ],
      "default": "medium"
    },
    {
      "id": "mobile-heading-alignment",
      "label": "Heading alignment",
      "type": "text_alignment",
      "default": "left"
    },
    {
      "label": "Blocks visible in mobile slider",
      "id": "mobile-width",
      "type": "select",
      "options": [
        { "value": "1", "label": "1" },
        { "value": "2", "label": "2" }
      ],
      "default": "2",
      "info": "How many category cards show at once in the bottom mobile slider (and default mobile slideshow)."
    },
    {
      "id": "mobile-slider-width",
      "label": "Mobile slider width",
      "type": "select",
      "options": [
        { "value": "container", "label": "Container" },
        { "value": "full", "label": "Full width" }
      ],
      "default": "full",
      "info": "Only for the bottom horizontal category slider on mobile. Full width matches ~full phone card width."
    },
    {
      "type": "header",
      "content": "Tablet"
    },
