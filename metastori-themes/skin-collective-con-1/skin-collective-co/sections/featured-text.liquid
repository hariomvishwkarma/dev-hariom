<!-- sections/featured-text.liquid -->
{%- liquid
  assign has_content = false
  for block in section.blocks
    case block.type
      when 'text'
        assign block_text = block.settings.text | strip
        if block_text != blank
          assign has_content = true
        endif
      when 'heading'
        if block.settings.title != blank
          assign has_content = true
        endif
      when 'overline'
        if block.settings.overline != blank
          assign has_content = true
        endif
      when 'description'
        assign description_text = block.settings.description | strip_html | strip | replace: '&nbsp;', '' | replace: '&#160;', ''
        assign mobile_description_text = block.settings.mobile-description | strip_html | strip | replace: '&nbsp;', '' | replace: '&#160;', ''
        if description_text != blank or mobile_description_text != blank
          assign has_content = true
        endif
      when 'button'
        if block.settings.text != blank
          assign has_content = true
        endif
      when 'icon'
        if block.settings.icon != 'none' or block.settings.icon-image != blank or block.settings.text != blank
          assign has_content = true
        endif
      when 'custom-liquid'
        if block.settings.custom-liquid != blank
          assign has_content = true
        endif
      when 'empty-space'
        assign has_content = true
      else
        assign has_content = true
    endcase
    if has_content
      break
    endif
  endfor
-%}

{%- unless has_content or request.design_mode -%}
  <style>
    #shopify-section-{{ section.id }} {
      display: none !important;
    }
  </style>
{%- else -%}
{%- render 'section-max-width' -%}
{%- render 'section-padding' -%}

{%- liquid
  assign bg_color = section.settings.background-color
  assign border = section.settings.border
  assign container_width = section.settings.container-width
  assign mobile_spacing_above = section.settings.mobile-spacing-above
  assign mobile_spacing_below = section.settings.mobile-spacing-below
  assign mobile_text_alignment = section.settings.mobile-text-alignment
  assign outer_background = section.settings.outer-background
  assign spacing_above = section.settings.spacing-above
  assign spacing_below = section.settings.spacing-below
  assign custom_spacing_above = section.settings.custom-spacing-above
  assign mobile_custom_spacing_above = section.settings.mobile-custom-spacing-above
  assign text_alignment = section.settings.text-alignment
  assign text_color = section.settings.text-color
  assign content_width = section.settings.content-width | default: 'container'
  assign content_max_width_percent = section.settings.content-max-width-percent | default: 80
  if content_max_width_percent < 40
    assign content_max_width_percent = 40
  endif
  if content_max_width_percent > 100
    assign content_max_width_percent = 100
  endif
  assign heading_font_size = section.settings.heading-font-size | default: 28
  assign description_font_size = section.settings.description-font-size | default: 15
  assign tablet_heading_font_size = section.settings.tablet-heading-font-size | default: 28
  assign tablet_description_font_size = section.settings.tablet-description-font-size | default: 15
  assign mobile_heading_font_size = section.settings.mobile-heading-font-size | default: 14
  assign mobile_description_font_size = section.settings.mobile-description-font-size | default: 16
  assign heading_max_width = section.settings.heading-max-width | default: 0
  assign heading_alignment = section.settings.heading-alignment | default: 'center'
  assign full_width_content_max = section.settings.full-width-content-max | default: 1200

  # Cap the content only when Full width is on and the limit is switched on.
  assign limit_full_width_content = false
  if section.settings.full-width and section.settings.full-width-content-max-enabled
    assign limit_full_width_content = true
  endif

  assign effective_container_width = container_width
  if content_width == 'full'
    assign effective_container_width = '6'
  endif
-%}

<div
  class="featured-text--root{% if section.settings.full-width %} layout-full-width{% endif %}"
  data-section-id="{{ section.id }}"
  data-background-color="{{ bg_color }}"
  data-border="{{ border }}"
  data-container-width="{{ effective_container_width }}"
  data-content-width="{{ content_width }}"
  data-heading-alignment="{{ heading_alignment }}"
  {% if limit_full_width_content %}
    data-full-width-content="true"
  {% endif %}
  {% if heading_max_width > 0 %}
    data-heading-max-width="true"
  {% endif %}
  data-heading-font-size="true"
  data-description-font-size="true"
  data-tablet-heading-font-size="true"
  data-tablet-description-font-size="true"
  data-mobile-heading-font-size="true"
  data-mobile-description-font-size="true"
  data-mobile-spacing-above="{{ mobile_spacing_above }}"
  data-mobile-spacing-below="{{ mobile_spacing_below }}"
  data-outer-background="{{ outer_background }}"
  data-spacing-above="{{ spacing_above }}"
  data-spacing-below="{{ spacing_below }}"
  style="
    --ft-heading-font-size: {{ heading_font_size }}px;
    --ft-description-font-size: {{ description_font_size }}px;
    --ft-tablet-heading-font-size: {{ tablet_heading_font_size }}px;
    --ft-tablet-description-font-size: {{ tablet_description_font_size }}px;
    --ft-mobile-heading-font-size: {{ mobile_heading_font_size }}px;
    --ft-mobile-description-font-size: {{ mobile_description_font_size }}px;
    {% if heading_max_width > 0 %}--ft-heading-max-width: {{ heading_max_width }}px;{% endif %}
    {% if content_width == 'percent' %}--ft-content-max: {{ content_max_width_percent }}%;{% endif %}
    {% if limit_full_width_content %}--ft-full-width-content-max: {{ full_width_content_max }}px;{% endif %}
    {% if spacing_above == 'custom' %}--custom-spacing-above: {{ custom_spacing_above }}px;{% endif %}
    {% if mobile_spacing_above == 'custom' %}--mobile-custom-spacing-above: {{ mobile_custom_spacing_above }}px;{% endif %}
  "
>
  <div class="featured-text--wrapper">
    {%-
      render 'section-blocks',
      section_id: section.id,
      blocks: section.blocks,
      mobile_x_alignment: mobile_text_alignment,
      text_color: text_color,
      x_alignment: text_alignment
    -%}
  </div>
</div>
{%- endunless -%}

