<!-- sections/text-columns.liquid -->

{%- liquid
  assign aspect_ratio = section.settings.aspect-ratio
  assign bg_color = section.settings.background-color
  assign block_spacing = section.settings.block-spacing
  assign border = section.settings.border
  capture button_link
    render 'localized-url', url: section.settings.button-link
  endcapture
  assign button_style = section.settings.button-style
  assign button_text = section.settings.button-text
  assign columns = section.settings.width
  assign container_width = section.settings.container-width
  assign description = section.settings.description
  assign heading = section.settings.heading
  assign heading_type = section.settings.heading-type
  assign image_width = section.settings.image-width
  assign image_height = section.settings.image-height | default: 0
  assign tablet_image_height = section.settings.tablet-image-height | default: 0
  assign mobile_image_height = section.settings.mobile-image-height | default: 0
  assign mobile_columns = section.settings.mobile-width
  assign mobile_heading_alignment = section.settings.mobile-heading-alignment
  assign mobile_media_layout = section.settings.mobile-media-layout
  assign mobile_spacing_above = section.settings.mobile-spacing-above
  assign mobile_spacing_below = section.settings.mobile-spacing-below
  assign mobile_text_alignment = section.settings.mobile-text-alignment
  assign overline = section.settings.overline
  assign section_alignment = section.settings.section-alignment
  assign spacing_above = section.settings.spacing-above
  assign spacing_below = section.settings.spacing-below
  assign custom_spacing_above = section.settings.custom-spacing-above
  assign mobile_custom_spacing_above = section.settings.mobile-custom-spacing-above
  assign text_alignment = section.settings.text-alignment
  assign text_color = section.settings.text-color

  assign heading_font_size = section.settings.heading-font-size | default: 0
  assign description_font_size = section.settings.description-font-size | default: 0
  assign column_title_font_size = section.settings.column-title-font-size | default: 0
  assign tablet_heading_font_size = section.settings.tablet-heading-font-size | default: 0
  assign tablet_description_font_size = section.settings.tablet-description-font-size | default: 0
  assign tablet_column_title_font_size = section.settings.tablet-column-title-font-size | default: 0
  assign mobile_heading_font_size = section.settings.mobile-heading-font-size | default: 0
  assign mobile_description_font_size = section.settings.mobile-description-font-size | default: 0
  assign mobile_column_title_font_size = section.settings.mobile-column-title-font-size | default: 0
  assign show_carousel_arrows = section.settings.show-carousel-arrows
  if show_carousel_arrows == nil
    assign show_carousel_arrows = true
  endif

  assign blocks_gap = section.settings.blocks-gap | default: 0
  assign tablet_blocks_gap = section.settings.tablet-blocks-gap | default: 0
  assign mobile_blocks_gap = section.settings.mobile-blocks-gap | default: 0
  assign block_content_gap = section.settings.block-content-gap | default: 0
  assign tablet_block_content_gap = section.settings.tablet-block-content-gap | default: 0
  assign mobile_block_content_gap = section.settings.mobile-block-content-gap | default: 0

  assign skin_edit_entries = blank
  if request.page_type == 'product' and product != blank
    assign skin_edit_entries = product.metafields.custom.skin_edit.value
  endif

  assign header_exists = false
  unless overline == blank and heading == blank and description == blank
    assign header_exists = true
  endunless

  assign has_column_content = false
  for block in section.blocks
    assign block_description_text = block.settings.description | strip_html | strip
    if block.settings.image != blank or block.settings.title != blank or block_description_text != blank or block.settings.button-text != blank
      assign has_column_content = true
      break
    endif
  endfor

  assign has_section_content = false
  if header_exists or button_text != blank or has_column_content
    assign has_section_content = true
  endif
-%}

{%- if has_section_content -%}
{%- render 'section-max-width' -%}
{%- render 'section-padding' -%}

{%- liquid
  assign loading = 'lazy'
  if section.index < 3
    assign loading = 'eager'
  endif

  capture sizes
    render 'sizes-grid', container_width: container_width, columns: columns, column_spacing: block_spacing, mobile_columns: mobile_columns
  endcapture
-%}

{%- for block in section.blocks -%}
  {%- liquid
    assign image = block.settings.image
    assign title = block.settings.title
    assign block_button_link = block.settings.button-link
    assign block_button_text = block.settings.button-text
    assign block_description = block.settings.description
    assign block_heading_type = block.settings.heading-type
    assign image_enabled = block.settings.image-enabled
    assign item_heading_font_size = block.settings.heading-font-size | default: 0
    assign item_tablet_heading_font_size = block.settings.tablet-heading-font-size | default: 0
    assign item_mobile_heading_font_size = block.settings.mobile-heading-font-size | default: 0
    assign item_description_font_size = block.settings.description-font-size | default: 0
    assign item_tablet_description_font_size = block.settings.tablet-description-font-size | default: 0
    assign item_mobile_description_font_size = block.settings.mobile-description-font-size | default: 0

    if request.page_type == 'product' and skin_edit_entries != blank and skin_edit_entries.size > 0
      assign block_index = forloop.index0
      assign meta_entry = blank
      for skin_edit_entry in skin_edit_entries
        if forloop.index0 == block_index
          assign meta_entry = skin_edit_entry
          break
        endif
      endfor

      if meta_entry != blank
        assign entry_image = meta_entry.image.value | default: meta_entry.image
        assign entry_title = meta_entry.title.value | default: meta_entry.title
        assign entry_url = meta_entry.url.value | default: meta_entry.url.url | default: meta_entry.url
        if entry_url == blank
          assign entry_url = meta_entry.link.value | default: meta_entry.link.url | default: meta_entry.link
        endif

        if entry_image != blank
          assign image = entry_image
        endif
        if entry_title != blank
          assign title = entry_title
        endif
        if entry_url != blank
          assign block_button_link = entry_url
        endif
      endif
    endif

    # Keep the shopper's language across the link. `url`-type settings are stored
    # unprefixed, so localize once here — after the metaobject override above.
    capture block_button_link
      render 'localized-url', url: block_button_link
    endcapture

    assign block_description_text = block_description | strip_html | strip
    assign block_has_content = false
    if image != blank or title != blank or block_description_text != blank or block_button_text != blank
      assign block_has_content = true
    endif

    assign tag = 'div'
    unless block_button_link == blank
      assign tag = 'a'
    endunless
  -%}
  {%- if block_has_content -%}
    {%- capture block_html -%}
      {%- unless block_html == blank -%}
        {{- block_html -}}
        <span class="divider"></span>
      {%- endunless -%}

      <div
        class="featured-grid--item"
        {% unless settings.transitions--other %}
          data-transition-item="{{ section.id }}"
        {% endunless %}
        {% if item_heading_font_size > 0 %}data-item-heading-font="true"{% endif %}
        {% if item_tablet_heading_font_size > 0 %}data-item-tablet-heading-font="true"{% endif %}
        {% if item_mobile_heading_font_size > 0 %}data-item-mobile-heading-font="true"{% endif %}
        {% if item_description_font_size > 0 %}data-item-description-font="true"{% endif %}
        {% if item_tablet_description_font_size > 0 %}data-item-tablet-description-font="true"{% endif %}
        {% if item_mobile_description_font_size > 0 %}data-item-mobile-description-font="true"{% endif %}
        style="
          {% if item_heading_font_size > 0 %}--tc-item-heading-size: {{ item_heading_font_size }}px;{% endif %}
          {% if item_tablet_heading_font_size > 0 %}--tc-item-tablet-heading-size: {{ item_tablet_heading_font_size }}px;{% endif %}
          {% if item_mobile_heading_font_size > 0 %}--tc-item-mobile-heading-size: {{ item_mobile_heading_font_size }}px;{% endif %}
          {% if item_description_font_size > 0 %}--tc-item-description-size: {{ item_description_font_size }}px;{% endif %}
          {% if item_tablet_description_font_size > 0 %}--tc-item-tablet-description-size: {{ item_tablet_description_font_size }}px;{% endif %}
          {% if item_mobile_description_font_size > 0 %}--tc-item-mobile-description-size: {{ item_mobile_description_font_size }}px;{% endif %}
        "
        {{ block.shopify_attributes }}
      >
        <div class="featured-grid--item--container" data-container="block">
          {%- if image_enabled -%}
            <{{ tag }}
              {% unless block_button_link == blank %}
                href="{{ block_button_link }}"
              {% endunless %}
              class="featured-grid--item--media"
              data-item="image"
              data-x-alignment="{{ text_alignment }}"
              data-mobile-x-alignment="{{ mobile_text_alignment }}"
              {% unless settings.transitions--image %}
                data-transition-item
                data-transition-type="zoom-in"
                data-transition-trigger="hover"
              {% endunless %}
              {% unless image_width == 0 %}
                style="--width:{{ image_width }}px;"
              {% endunless %}
            >
              {%- if image -%}
                {%- assign twice_width = image.width | times: 2 -%}
                {{-
                  image |
                  image_url: width: twice_width |
                  image_tag:
                    widths: '200, 300, 400, 500, 600, 700, 800, 900, 1000, 1200, 1500',
                    sizes: sizes,
                    loading: loading
                -}}
              {%- else -%}
                {%- liquid
                  capture placeholder_index
                    cycle '1', '2'
                  endcapture

                  render 'placeholder', type: 'lifestyle', placeholder_index: placeholder_index
                -%}
              {%- endif -%}
            </{{ tag }}>
          {%- endif -%}

          {%- unless title == blank and block_description == blank and block_button_text == blank -%}
            <div
              class="featured-grid--item--text"
              data-text-color="{{ text_color }}"
              data-mobile-text-color="{{ text_color }}"
              data-mobile-x-alignment="{{ mobile_text_alignment }}"
              data-x-alignment="{{ text_alignment }}"
            >
              <div
                class="featured-grid--item--text-wrapper"
                data-container="block"
              >
                {%- unless title == blank -%}
                  <{{ tag }}
                    {% unless block_button_link == blank %}
                      href="{{ block_button_link }}"
                    {% endunless %}
                    {% unless settings.transitions--text %}
                      data-transition-item="viewport"
                    {% endunless %}
                  >
                    <h2
                      class="featured-grid--item--title"
                      data-item="{{ block_heading_type }}"
                    >
                      {{- title | escape -}}
                    </h2>
                  </{{ tag }}>
                {%- endunless -%}

                {%- unless block_description == blank -%}
                  <div
                    class="featured-grid--item--description"
                    data-item="rte-content"
                    {% unless settings.transitions--text %}
                      data-transition-item="viewport"
                    {% endunless %}
                  >
                    {{- block_description -}}
                  </div>
                {%- endunless -%}

                {%- unless block_button_text == blank -%}
                  <a
                    class="featured-grid--item--button"
                    href="{{ block_button_link }}"
                    data-item="block-link"
                    data-text="{{ block_button_text }}"
                    {% unless settings.transitions--text %}
                      data-transition-item="viewport"
                      data-transition-type="fade-in"
                    {% endunless %}
                  >
                    <span>{{- block_button_text -}}</span>
                  </a>
                {%- endunless -%}
              </div>
            </div>
          {%- endunless -%}
        </div>
      </div>
    {%- endcapture -%}
  {%- endif -%}
{%- endfor -%}

{%- liquid
  assign block_html_arr = block_html | split: '<span class="divider"></span>'
  if block_html == blank
    assign block_html_arr = '' | split: ','
  endif
  assign total_slides = block_html_arr.size | divided_by: mobile_columns
-%}

<div
  class="featured-grid--root"
  data-section-id="{{ section.id }}"
  data-aspect-ratio="{{ aspect_ratio }}"
  data-background-color="{{ bg_color }}"
  data-block-spacing="{{ block_spacing }}"
  data-border="{{ border }}"
  data-container-width="{{ container_width }}"
  data-mobile-block-spacing="{{ block_spacing }}"
  data-mobile-spacing-above="{{ mobile_spacing_above }}"
  data-mobile-spacing-below="{{ mobile_spacing_below }}"
  data-mobile-overlay="false"
  data-spacing-above="{{ spacing_above }}"
  data-spacing-below="{{ spacing_below }}"
  data-text-color="{{ text_color }}"
  data-text-position="bottom"
  {% if image_height > 0 %}data-custom-image-height="true"{% endif %}
  {% if tablet_image_height > 0 %}data-tablet-custom-image-height="true"{% endif %}
  {% if mobile_image_height > 0 %}data-mobile-custom-image-height="true"{% endif %}
  {% if heading_font_size > 0 %}data-heading-font-size="true"{% endif %}
  {% if description_font_size > 0 %}data-description-font-size="true"{% endif %}
  {% if column_title_font_size > 0 %}data-column-title-font-size="true"{% endif %}
  {% if tablet_heading_font_size > 0 %}data-tablet-heading-font-size="true"{% endif %}
  {% if tablet_description_font_size > 0 %}data-tablet-description-font-size="true"{% endif %}
  {% if tablet_column_title_font_size > 0 %}data-tablet-column-title-font-size="true"{% endif %}
  {% if mobile_heading_font_size > 0 %}data-mobile-heading-font-size="true"{% endif %}
  {% if mobile_description_font_size > 0 %}data-mobile-description-font-size="true"{% endif %}
  {% if mobile_column_title_font_size > 0 %}data-mobile-column-title-font-size="true"{% endif %}
  data-show-carousel-arrows="{{ show_carousel_arrows }}"
  {% if blocks_gap > 0 %}data-blocks-gap="true"{% endif %}
  {% if tablet_blocks_gap > 0 %}data-tablet-blocks-gap="true"{% endif %}
  {% if mobile_blocks_gap > 0 %}data-mobile-blocks-gap="true"{% endif %}
  {% if block_content_gap > 0 %}data-block-content-gap="true"{% endif %}
  {% if tablet_block_content_gap > 0 %}data-tablet-block-content-gap="true"{% endif %}
  {% if mobile_block_content_gap > 0 %}data-mobile-block-content-gap="true"{% endif %}
  style="
    {% if image_height > 0 %}--tc-image-height: {{ image_height }}px;{% endif %}
    {% if tablet_image_height > 0 %}--tc-tablet-image-height: {{ tablet_image_height }}px;{% endif %}
    {% if mobile_image_height > 0 %}--tc-mobile-image-height: {{ mobile_image_height }}px;{% endif %}
    {% if heading_font_size > 0 %}--tc-heading-font-size: {{ heading_font_size }}px;{% endif %}
    {% if description_font_size > 0 %}--tc-description-font-size: {{ description_font_size }}px;{% endif %}
    {% if column_title_font_size > 0 %}--tc-column-title-font-size: {{ column_title_font_size }}px;{% endif %}
    {% if tablet_heading_font_size > 0 %}--tc-tablet-heading-font-size: {{ tablet_heading_font_size }}px;{% endif %}
    {% if tablet_description_font_size > 0 %}--tc-tablet-description-font-size: {{ tablet_description_font_size }}px;{% endif %}
    {% if tablet_column_title_font_size > 0 %}--tc-tablet-column-title-font-size: {{ tablet_column_title_font_size }}px;{% endif %}
    {% if mobile_heading_font_size > 0 %}--tc-mobile-heading-font-size: {{ mobile_heading_font_size }}px;{% endif %}
    {% if mobile_description_font_size > 0 %}--tc-mobile-description-font-size: {{ mobile_description_font_size }}px;{% endif %}
    {% if mobile_column_title_font_size > 0 %}--tc-mobile-column-title-font-size: {{ mobile_column_title_font_size }}px;{% endif %}
    {% if blocks_gap > 0 %}--tc-blocks-gap: {{ blocks_gap }}px;{% endif %}
    {% if tablet_blocks_gap > 0 %}--tc-tablet-blocks-gap: {{ tablet_blocks_gap }}px;{% endif %}
    {% if mobile_blocks_gap > 0 %}--tc-mobile-blocks-gap: {{ mobile_blocks_gap }}px;{% endif %}
    {% if block_content_gap > 0 %}--tc-block-content-gap: {{ block_content_gap }}px;{% endif %}
    {% if tablet_block_content_gap > 0 %}--tc-tablet-block-content-gap: {{ tablet_block_content_gap }}px;{% endif %}
    {% if mobile_block_content_gap > 0 %}--tc-mobile-block-content-gap: {{ mobile_block_content_gap }}px;{% endif %}
    {% if spacing_above == 'custom' %}--custom-spacing-above: {{ custom_spacing_above }}px;{% endif %}
    {% if mobile_spacing_above == 'custom' %}--mobile-custom-spacing-above: {{ mobile_custom_spacing_above }}px;{% endif %}
  "
>
  <div
    class="featured-grid--wrapper"
    data-container="section"
    {% unless settings.transitions--other %}
      data-transition-container="{{ section.id }}"
      data-transition-type="fade-in"
      data-transition-cascade="horizontal"
      data-transition-cascade-interval="200"
    {% endunless %}
  >
    {%- if header_exists or mobile_media_layout == 'slideshow' -%}
      <div
        class="featured-grid--header-nav"
        data-container="nav"
        data-x-alignment="{{ section_alignment }}"
        data-mobile-x-alignment="{{ mobile_heading_alignment }}"
      >
        <div
          class="featured-grid--header"
          data-container="block"
          {% unless settings.transitions--text %}
            data-transition-container="{{ section.id }}-header"
            data-transition-type="slide-in"
            data-transition-cascade="vertical"
            data-transition-cascade-interval="500"
          {% endunless %}
        >
          {%- if header_exists -%}
            {%- unless overline == blank -%}
              <div
                class="featured-grid--overline"
                {% unless settings.transitions--text %}
                  data-transition-item="{{ section.id }}-header"
                {% endunless %}
              >
                <p data-item="overline">
                  {{- overline | escape -}}
                </p>
              </div>
            {%- endunless -%}

            {%- unless heading == blank -%}
              <div
                class="featured-grid--heading"
                {% unless settings.transitions--text %}
                  data-transition-item="{{ section.id }}-header"
                {% endunless %}
              >
                <h2 data-item="{{ heading_type }}">
                  {{- heading | escape -}}
                </h2>
              </div>
            {%- endunless -%}

            {%- unless description == blank -%}
              <div
                class="featured-grid--description"
                {% unless settings.transitions--text %}
                  data-transition-item="{{ section.id }}-header"
                {% endunless %}
              >
                <h3 data-item="paragraph">
                  {{- description -}}
                </h3>
              </div>
            {%- endunless -%}
          {%- endif -%}
        </div>

        {%- liquid
          if mobile_media_layout == 'slideshow' and show_carousel_arrows
            assign blocks_per_slide_desktop = columns | plus: 0.0
            assign blocks_per_slide_mobile = mobile_columns | plus: 0.0
            assign total_slides = block_html_arr.size | divided_by: blocks_per_slide_desktop | ceil
            assign total_slides_mobile = block_html_arr.size | divided_by: blocks_per_slide_mobile | ceil
            render 'carousel-nav-arrow', id: section.id, total_slides_mobile: total_slides_mobile, mobile_only: true, text_color: text_color
          endif
        -%}
      </div>
    {%- endif -%}

    {%- if mobile_media_layout == 'grid' -%}
      <div
        class="featured-grid--body"
        data-block-spacing="{{ block_spacing }}"
        data-container="panel"
        data-columns="{{ columns }}"
        data-mobile-columns="{{ mobile_columns }}"
        data-mobile-block-spacing="{{ block_spacing }}"
      >
        {%- liquid
          for block_html in block_html_arr
            echo block_html
          endfor
        -%}
      </div>
    {%- else -%}
      {%-
        render 'card-carousel',
        section: section,
        blocks: block_html_arr,
        blocks_per_slide: columns,
        blocks_per_slide_mobile: mobile_columns,
        mobile_only: true,
        mobile_next_visible: false,
        spacing_around_blocks: block_spacing,
        total_blocks: block_html_arr.size,
        total_slides: total_slides
      -%}
    {%- endif -%}

    {%- unless button_text == blank -%}
      <div
        class="featured-grid--footer"
        data-container="block"
        data-x-alignment="{{ section_alignment }}"
      >
        <a
          class="featured-grid--button"
          href="{{ button_link }}"
          data-item="{{ button_style }}"
          data-text="{{ button_text }}"
        >
          <span>{{ button_text }}</span>
        </a>
      </div>
    {%- endunless -%}
  </div>
</div>
{%- endif -%}

{% schema %}
{
  "name": "Text columns with images",
  "class": "section--text-columns",
  "settings": [
    {
      "type": "header",
      "content": "Section max width"
    },
    {
      "type": "checkbox",
      "id": "custom-max-width-enabled",
      "label": "Override max width",
      "default": false,
      "info": "Overrides the section's existing width with the value below."
    },
    {
      "type": "range",
      "id": "custom-max-width",
      "label": "Max width",
      "min": 600,
      "max": 1920,
      "step": 20,
      "unit": "px",
      "default": 1160
    },
    {
      "type": "header",
      "content": "Section padding"
    },
    {
      "type": "checkbox",
      "id": "custom-padding-enabled",
      "label": "Override padding",
      "default": false,
      "info": "Overrides the section's existing top/bottom spacing. Tablet auto = 75% of desktop."
    },
    {
      "type": "range",
      "id": "custom-padding-top",
      "label": "Desktop padding top",
      "min": 60,
      "max": 160,
      "step": 1,
      "unit": "px",
      "default": 100
    },
    {
      "type": "range",
      "id": "custom-padding-bottom",
      "label": "Desktop padding bottom",
      "min": 60,
      "max": 160,
      "step": 1,
      "unit": "px",
      "default": 100
    },
    {
      "type": "range",
      "id": "custom-mobile-padding-top",
      "label": "Mobile padding top",
      "min": 20,
      "max": 120,
      "step": 1,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "custom-mobile-padding-bottom",
      "label": "Mobile padding bottom",
      "min": 20,
      "max": 120,
      "step": 1,
      "unit": "px",
      "default": 40
    },
    {
      "type": "header",
      "content": "Content"
    },
    {
      "id": "overline",
      "label": "Overline",
      "type": "text",
      "default": "Overline text"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Text columns with images"
    },
    {
      "id": "description",
      "type": "richtext",
      "label": "Description"
    },
    {
      "id": "button-text",
      "label": "Button text",
      "type": "text",
      "default": "Button"
    },
    {
      "id": "button-link",
      "label": "Button link",
      "type": "url"
    },
    {
      "id": "button-style",
      "label": "Button style",
      "type": "select",
      "options": [
        {
          "label": "Style 1",
          "value": "button-1"
        },
        {
          "label": "Style 2",
          "value": "button-2"
        },
        {
          "label": "Style 3",
          "value": "button-3"
        },
        {
          "label": "Style 4",
          "value": "button-4"
        },
        {
          "label": "Link",
          "value": "block-link"
        }
      ],
      "default": "button-1"
    },
    {
      "type": "header",
      "content": "General layout"
    },
    {
      "id": "border",
      "label": "Border",
      "type": "select",
      "options": [
        {
          "label": "Top",
          "value": "top"
        },
        {
          "label": "Bottom",
          "value": "bottom"
        },
        {
          "label": "Both",
          "value": "both"
        },
        {
          "label": "None",
          "value": "none"
        }
      ],
      "default": "none"
    },
    {
      "id": "spacing-above",
      "label": "Spacing above",
      "type": "select",
      "options": [
        {
          "label": "None",
          "value": "none"
        },
        {
          "label": "Small",
          "value": "small"
        },
        {
          "label": "Medium",
          "value": "medium"
        },
        {
          "label": "Large",
          "value": "large"
        },
        {
          "label": "Extra large",
          "value": "x-large"
        },
        {
          "label": "Custom top spacing",
          "value": "custom"
        }
      ],
      "default": "large"
    },
    {
