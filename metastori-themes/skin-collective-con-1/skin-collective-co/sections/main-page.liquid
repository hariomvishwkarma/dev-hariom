<!-- sections/main-page.liquid -->
{%- render 'section-max-width' -%}
{%- render 'section-padding' -%}

{%- liquid
  assign bg_color = section.settings.background-color
  assign container_width = section.settings.container-width
  assign heading_alignment = section.settings.heading-alignment
  assign heading_type = section.settings.heading-type
  assign mobile_heading_alignment = section.settings.mobile-heading-alignment
  assign mobile_spacing_above = section.settings.mobile-spacing-above
  assign mobile_spacing_below = section.settings.mobile-spacing-below
  assign show_title = section.settings.show-title
  assign spacing_above = section.settings.spacing-above
  assign spacing_below = section.settings.spacing-below
  assign custom_spacing_above = section.settings.custom-spacing-above
  assign mobile_custom_spacing_above = section.settings.mobile-custom-spacing-above
  assign text_color = section.settings.text-color

  assign heading_font_size = section.settings.heading-font-size | default: 0
  assign mobile_heading_font_size = section.settings.mobile-heading-font-size | default: 0
  assign content_font_size = section.settings.content-font-size | default: 0
  assign mobile_content_font_size = section.settings.mobile-content-font-size | default: 0

  assign tag_setting = settings.header--logo-tag | default: 'homepage'
  assign heading_tag = 'h2'
  if tag_setting == 'none'
    assign heading_tag = 'h1'
  elsif tag_setting == 'homepage' and request.page_type != 'index'
    assign heading_tag = 'h1'
  endif

  assign mp_custom_style = ''
  if spacing_above == 'custom'
    assign mp_custom_style = mp_custom_style | append: '--custom-spacing-above: ' | append: custom_spacing_above | append: 'px;'
  endif
  if mobile_spacing_above == 'custom'
    assign mp_custom_style = mp_custom_style | append: '--mobile-custom-spacing-above: ' | append: mobile_custom_spacing_above | append: 'px;'
  endif
  if heading_font_size > 0
    assign mp_custom_style = mp_custom_style | append: '--mp-heading-font-size: ' | append: heading_font_size | append: 'px;'
  endif
  if mobile_heading_font_size > 0
    assign mp_custom_style = mp_custom_style | append: '--mp-mobile-heading-font-size: ' | append: mobile_heading_font_size | append: 'px;'
  endif
  if content_font_size > 0
    assign mp_custom_style = mp_custom_style | append: '--mp-content-font-size: ' | append: content_font_size | append: 'px;'
  endif
  if mobile_content_font_size > 0
    assign mp_custom_style = mp_custom_style | append: '--mp-mobile-content-font-size: ' | append: mobile_content_font_size | append: 'px;'
  endif
-%}

<div
  class="template-page--root"
  data-section-id="{{ section.id }}"
  data-background-color="{{ bg_color }}"
  data-container-width="{{ container_width }}"
  data-mobile-spacing-above="{{ mobile_spacing_above }}"
  data-mobile-spacing-below="{{ mobile_spacing_below }}"
  data-spacing-above="{{ spacing_above }}"
  data-spacing-below="{{ spacing_below }}"
  data-text-color="{{ text_color }}"
  {% if heading_font_size > 0 %}data-heading-font-size="true"{% endif %}
  {% if mobile_heading_font_size > 0 %}data-mobile-heading-font-size="true"{% endif %}
  {% if content_font_size > 0 %}data-content-font-size="true"{% endif %}
  {% if mobile_content_font_size > 0 %}data-mobile-content-font-size="true"{% endif %}
  {% if mp_custom_style != '' %}style="{{ mp_custom_style }}"{% endif %}
>
  <div class="template-page--wrapper" data-container="section">
    {%- if show_title -%}
      <div
        class="template-page--heading"
        data-container="block"
        data-x-alignment="{{ heading_alignment }}"
        data-mobile-x-alignment="{{ mobile_heading_alignment }}"
      >
        <{{ heading_tag }}
          data-item="{{ heading_type }}"
          {% unless settings.transitions--text %}
            data-transition-item="viewport"
            data-transition-type="slide-in"
          {% endunless %}
        >
          {{- page.title -}}
        </{{ heading_tag }}>
      </div>
    {%- endif -%}

    <div data-item="rte-content">
      {{- page.content -}}
    </div>
  </div>
</div>

{% stylesheet %}
  .template-page--root[data-heading-font-size='true'] .template-page--heading [data-item] {
    font-size: var(--mp-heading-font-size) !important;
  }

  .template-page--root[data-content-font-size='true'] [data-item='rte-content'],
  .template-page--root[data-content-font-size='true'] [data-item='rte-content'] p {
    font-size: var(--mp-content-font-size) !important;
  }

  @media (max-width: 767px) {
    .template-page--root[data-mobile-heading-font-size='true'] .template-page--heading [data-item] {
      font-size: var(--mp-mobile-heading-font-size) !important;
    }

    .template-page--root[data-mobile-content-font-size='true'] [data-item='rte-content'],
    .template-page--root[data-mobile-content-font-size='true'] [data-item='rte-content'] p {
      font-size: var(--mp-mobile-content-font-size) !important;
    }
  }
{% endstylesheet %}

{% schema %}
  {
    "name": "Page",
    "class": "section--page",
    "settings": [
      {
        "type": "header",
        "content": "Section max width"
      },
      {
        "type": "checkbox",
        "id": "custom-max-width-enabled",
        "label": "Override max width",
        "default": false,
        "info": "Overrides the section's existing width with the value below."
      },
      {
        "type": "range",
        "id": "custom-max-width",
        "label": "Max width",
        "min": 600,
        "max": 1920,
        "step": 20,
        "unit": "px",
        "default": 1160
      },
      {
        "type": "header",
        "content": "Section padding"
      },
      {
        "type": "checkbox",
        "id": "custom-padding-enabled",
        "label": "Override padding",
        "default": false,
        "info": "Overrides the section's existing top/bottom spacing. Tablet auto = 75% of desktop."
      },
      {
        "type": "range",
        "id": "custom-padding-top",
        "label": "Desktop padding top",
        "min": 80,
        "max": 180,
        "step": 1,
        "unit": "px",
        "default": 100
      },
      {
        "type": "range",
        "id": "custom-padding-bottom",
        "label": "Desktop padding bottom",
        "min": 80,
        "max": 180,
        "step": 1,
        "unit": "px",
        "default": 100
      },
      {
        "type": "range",
        "id": "custom-mobile-padding-top",
        "label": "Mobile padding top",
        "min": 20,
        "max": 120,
        "step": 1,
        "unit": "px",
        "default": 40
      },
      {
        "type": "range",
        "id": "custom-mobile-padding-bottom",
        "label": "Mobile padding bottom",
        "min": 20,
        "max": 120,
        "step": 1,
        "unit": "px",
        "default": 40
      },
      {
        "type": "header",
        "content": "General layout"
      },
      {
        "id": "spacing-above",
        "label": "Spacing above",
        "type": "select",
        "options": [
          {
            "label": "None",
            "value": "none"
          },
          {
            "label": "Small",
            "value": "small"
          },
          {
            "label": "Medium",
            "value": "medium"
          },
          {
            "label": "Large",
            "value": "large"
          },
          {
            "label": "Extra large",
            "value": "x-large"
          },
          {
            "label": "Custom top spacing",
            "value": "custom"
          }
        ],
        "default": "large"
      },
      {
        "id": "custom-spacing-above",
        "label": "Custom top spacing",
        "type": "range",
        "min": 1,
        "max": 100,
        "step": 1,
        "unit": "px",
        "default": 20,
        "visible_if": "{{ section.settings.spacing-above == 'custom' }}"
      },
      {
        "id": "spacing-below",
        "label": "Spacing below",
        "type": "select",
        "options": [
          {
            "label": "None",
            "value": "none"
          },
          {
            "label": "Small",
            "value": "small"
          },
          {
            "label": "Medium",
            "value": "medium"
          },
          {
            "label": "Large",
            "value": "large"
          },
          {
            "label": "Extra large",
            "value": "x-large"
          }
        ],
        "default": "large"
      },
      {
        "id": "container-width",
        "label": "Maximum container width",
        "type": "select",
        "options": [
          {
            "label": "Extra small",
            "value": "1"
          },
          {
            "label": "Small",
            "value": "2"
          },
          {
            "label": "Medium",
            "value": "3"
          },
          {
            "label": "Large",
            "value": "4"
          },
          {
            "label": "Extra large",
            "value": "5"
          },
          {
            "label": "Full width",
            "value": "6"
          }
        ],
        "default": "1"
      },
      {
        "id": "background-color",
        "label": "Background color",
        "type": "select",
        "options": [
          {
            "label": "None",
            "value": "none"
          },
          {
            "label": "Light",
            "value": "light"
          },
          {
            "label": "Dark",
            "value": "dark"
          },
          {
            "label": "Accent 1",
            "value": "accent-1"
          },
          {
            "label": "Accent 2",
            "value": "accent-2"
          },
          {
            "label": "Accent 3",
            "value": "accent-3"
          }
        ],
        "default": "none"
      },
      {
        "type": "header",
        "content": "Features"
      },
      {
        "id": "show-title",
        "label": "Show title",
        "type": "checkbox",
        "default": true
      },
      {
        "type": "header",
        "content": "Text layout"
      },
      {
        "id": "heading-type",
        "label": "Heading type",
        "type": "select",
        "options": [
          {
            "label": "Banner",
            "value": "banner-heading"
          },
          {
            "label": "Featured",
            "value": "featured-heading"
          },
          {
            "label": "Large",
            "value": "section-heading"
          },
          {
            "label": "Medium",
            "value": "block-heading"
          }
        ],
        "default": "section-heading",
        "visible_if": "{{ section.settings.show-title == true }}"
      },
      {
        "id": "heading-alignment",
        "label": "Heading alignment",
        "type": "text_alignment",
        "default": "center",
        "visible_if": "{{ section.settings.show-title == true }}"
      },
      {
        "id": "text-color",
        "label": "Text color",
        "type": "select",
        "options": [
          {
            "label": "Light",
            "value": "white"
          },
          {
            "label": "Dark",
            "value": "body"
          }
        ],
        "default": "body"
      },
      {
        "type": "header",
        "content": "Typography"
      },
      {
        "type": "range",
        "id": "heading-font-size",
        "label": "Heading font size",
        "min": 0,
        "max": 72,
        "step": 1,
        "unit": "px",
        "default": 0,
        "info": "Desktop. 0 uses the theme heading style."
      },
      {
        "type": "range",
        "id": "content-font-size",
        "label": "Content font size",
        "min": 0,
        "max": 40,
        "step": 1,
        "unit": "px",
        "default": 0,
        "info": "Desktop. 0 uses the theme body style."
      },
      {
        "type": "header",
        "content": "Mobile"
      },
      {
        "id": "mobile-spacing-above",
        "label": "Spacing above",
        "type": "select",
        "options": [
          {
            "label": "None",
            "value": "none"
          },
          {
            "label": "Small",
            "value": "small"
          },
          {
            "label": "Medium",
            "value": "medium"
          },
          {
            "label": "Large",
            "value": "large"
          },
          {
            "label": "Extra large",
            "value": "x-large"
          },
          {
            "label": "Custom top spacing",
            "value": "custom"
          }
        ],
        "default": "medium"
      },
      {
        "id": "mobile-custom-spacing-above",
        "label": "Custom top spacing",
        "type": "range",
        "min": 1,
        "max": 100,
        "step": 1,
        "unit": "px",
        "default": 20,
        "visible_if": "{{ section.settings.mobile-spacing-above == 'custom' }}"
      },
      {
        "type": "range",
        "id": "mobile-heading-font-size",
        "label": "Heading font size",
        "min": 0,
        "max": 48,
        "step": 1,
        "unit": "px",
        "default": 0,
        "info": "Mobile. 0 uses the desktop / theme heading style."
      },
      {
        "type": "range",
        "id": "mobile-content-font-size",
        "label": "Content font size",
        "min": 0,
        "max": 40,
        "step": 1,
        "unit": "px",
        "default": 0,
        "info": "Mobile. 0 uses the desktop / theme body style."
      },
      {
        "id": "mobile-spacing-below",
        "label": "Spacing below",
        "type": "select",
        "options": [
          {
            "label": "None",
            "value": "none"
          },
          {
            "label": "Small",
            "value": "small"
          },
          {
            "label": "Medium",
            "value": "medium"
          },
          {
            "label": "Large",
            "value": "large"
          },
          {
            "label": "Extra large",
            "value": "x-large"
          }
        ],
        "default": "medium"
      },
      {
        "id": "mobile-heading-alignment",
        "label": "Heading alignment",
        "type": "text_alignment",
        "default": "center",
        "visible_if": "{{ section.settings.show-title == true }}"
      }
    ]
  }
{% endschema %}
