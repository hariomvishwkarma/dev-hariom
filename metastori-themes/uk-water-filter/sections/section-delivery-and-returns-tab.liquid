<style>
  #shopify-section-{{ section.id }} {
    padding-top: {{ section.settings.padding-top }}px;
    padding-bottom: {{ section.settings.padding-bottom }}px;
  }
</style>

{% unless product.metafields.custom.hide_delivery_returns_tab %}
<style>
  #shopify-section-{{ section.id }} .product--container{
    margin-top:0;
  }
  #shopify-section-{{ section.id }} .img__wrapper{
    max-width: 50%;
    margin: 0 auto;
    padding-top:0;
    border-radius: 8px;
    overflow: hidden;
  }

  #shopify-section-{{ section.id }} .accordion {
    display: flex;
    flex-direction: column;
    border-top: 1px solid #001F3C;
  }

  #shopify-section-{{ section.id }} .accordion-header {
    cursor: pointer;
    display: flex;
    justify-content: space-between;
    color: #001F3C;
    font-weight: bold;
    font-size:18px;
    padding:24px 0;
    font-family: 'gibson-semibold';
  }

  #shopify-section-{{ section.id }} .accordion.active .accordion-header{
    color:#02A8D2;
  }

  #shopify-section-{{ section.id }} .accordion-content {
    display: none;
  }

  #shopify-section-{{ section.id }} .accordion.active .accordion-content {
    display: block;
  }

  #shopify-section-{{ section.id }} .accordion-header::after {
    content: "";
    font-weight: bold;
    width: 13px;
    border-radius: 50%;
    display: flex;
    justify-content: center; 
    height: 13px;
    font-size: 18px;
    background-repeat: no-repeat;
    background-size: contain;
    background-position: center;
    background-image: url('https://cdn.shopify.com/s/files/1/0665/1782/7878/files/1_a1ccafc7-c838-4bd7-bda1-cf001c4ef554.svg?v=1746523011');
  }

  #shopify-section-{{ section.id }} .accordion.active .accordion-header::after {
    background-image: url('https://cdn.shopify.com/s/files/1/0665/1782/7878/files/1.svg?v=1746522781');
  }

  #shopify-section-{{ section.id }} .tab-content > *:first-child {
    margin-top: 0;
  }

  #shopify-section-{{ section.id }} .tab-content > *:last-child {
    margin-bottom: 0;
  }

  #shopify-section-{{ section.id }} .product-sku {
    font-size: 16px;
  }

  
  @media screen and (max-width: 1249px) {
    #shopify-section-{{ section.id }} .accordion-content {
      padding: 20px 0px;
    }
  }

  @media screen and (max-width: 1025px) {
    #shopify-section-{{ section.id }} .product--container {
      padding: 0 15px;
    }

    #shopify-section-{{ section.id }} .accordion-header {
      padding: 20px 15px;
      font-size: 22px;
      font-size: 15px;
    }
  }
</style>

{% assign replacement_title = product.metafields.custom.tab_delivery_returns_title %}
{% assign content_overwritten = false %}

{% for block in section.blocks %}
  {% if block.settings.image != blank or block.settings.richtext != blank %}
    {% assign content_overwritten = true %}
    {% break %}
  {% endif %}
{% endfor %}

<section class="product--container delivery_tab">

  <div class="accordion{% if section.settings.open_on_load %} active{% endif %}">
    <div class="accordion-header">
      {% if replacement_title != blank %}
      {{ replacement_title }}
      {% else %}
      {{ section.settings.title }}
      {% endif %}
    </div>
    <div class="accordion-content">
      <div class="tab-content">
        {% unless content_overwritten %}
        {% if section.settings.richtext != blank %}
        <div class="accordion-content-wrapper">{{ section.settings.richtext }}</div>
        {% endif %}

        {%- if section.settings.img != blank -%}
        <div class="img__wrapper">
          {%- assign img_height = section.settings.img.width | divided_by: section.settings.img.aspect_ratio -%}
                
          {{ section.settings.img | image_url: width: 1000 | image_tag:
            height: img_height,
            width: section.settings.img.width,
            loading: 'lazy'
          }}
        </div>
        {%- endif -%}

        {% else %}

        {% for block in section.blocks %}
          {% if block.settings.richtext != blank %}
            <div class="accordion-content-wrapper">{{ block.settings.richtext }}</div>
          {% endif %}
          {%- if block.settings.image != blank -%}
            <div class="img__wrapper">
              {%- assign img_height = block.settings.image.width | divided_by: block.settings.image.aspect_ratio -%}
          
              {{ block.settings.image | image_url: width: 1000 | image_tag:
                height: img_height,
                width: block.settings.image.width,
                loading: 'lazy'
              }}
            </div>
          {%- endif -%}
        {% endfor %}

        {% endunless %} 

      </div>
    </div>
  </div>

</section>

{% endunless %}

{% schema %}
{
  "name": "Tab delivery & returns",
  "class": "tab-section",
  "presets": [
  {
   "name":"Tab delivery & returns"
  }
  ],
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Title"
    },
    {
      "type": "checkbox",
      "id": "open_on_load",
      "label": "Open on load",
      "default":true
    },
    {
      "type": "richtext",
      "id": "richtext",
      "label": "Text"
    },
    {
      "type": "image_picker",
      "id": "img",
      "label": "Image"
    },
		{
      "type": "range",
      "id": "img_width",
      "label": "Image maximum width",
      "min": 0,
      "step": 50,
      "max": 1200,
      "default": 0
    },
		{
      "type": "range",
      "id": "padding-top",
      "label": "Padding top",
      "min": 0,
      "step": 2,
      "max": 200,
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-bottom",
      "label": "Padding bottom",
      "min": 0,
      "step": 2,
      "max": 200,
      "default": 0
    }
  ],
  "blocks": [
     {
       "name": "Content",
       "type": "tab-content",
"limit": 1,
       "settings": [
         {
           "type": "richtext",
           "id": "richtext",
           "label": "Text"
         },
         {
           "type": "image_picker",
           "id": "image",
           "label": "Image"
         }
       ]
     }
   ]
}
{% endschema %}