{{ 'image-with-text-new.css' | asset_url | stylesheet_tag }}
<style>
  .image-with-text-new-heading span{
    color:{{settings.product_on_sale_accent}};
  }
</style>

<div class="image-with-text-new-main" style="background:{{ section.settings.bg_color }};">
  <div class="section   section-blends section-full">

    <div class="image-with-text-new-flex">
      
      <div class="image-with-text-new-box">
        {% if section.settings.heading != blank %}
          <h1 class="image-with-text-new-heading" style="color:{{ section.settings.text_color }};">{{ section.settings.heading }}</h1>
        {% endif %}
        {% if section.settings.content != blank %}
          <div class="image-with-text-new-content" style="color:{{ section.settings.text_color }};">{{ section.settings.content }}</div>
        {% endif %}
        {% if section.settings.btn_name != blank %}
          <a href="{{ section.settings.btn_link }}" style="color:{{ section.settings.btn_text }};{% if section.settings.btn_style == "fill" %}border: 1px solid {{ section.settings.btn_background }};background:{{ section.settings.btn_background }};{% else %}border: 1px solid {{ section.settings.btn_text }};{% endif %}" class="image-with-text-new--btn image-with-text-new--desktop">
            {{ section.settings.btn_name }}
          </a>
        {% endif %}
      </div>

      <div class="image-with-text-new-image">
          {% if section.settings.image != blank %}
            <img class="image-with-text-new_desktop" src="{{ section.settings.image | image_url }}" alt="image-{{ section.settings.image.alt }}" width="" height="">
            {% if section.settings.image_mobile != blank %}
              <img class="image-with-text-new_mobile" src="{{ section.settings.image_mobile | image_url }}" alt="image-{{ section.settings.image_mobile.alt }}" width="" height="">
            {% else %}
              <img class="image-with-text-new_mobile" src="{{ section.settings.image | image_url }}" alt="image-{{ section.settings.image.alt }}" width="" height="">
            {% endif %}
          {% else %}
            {{- 'image' | placeholder_svg_tag: 'zoom-image placeholder' -}}
          {% endif %}
          {% if section.settings.btn_name != blank %}
            <a href="{{ section.settings.btn_link }}" style="color:{{ section.settings.btn_text }};{% if section.settings.btn_style == "fill" %}border: 1px solid {{ section.settings.btn_background }};background:{{ section.settings.btn_background }};{% else %}border: 1px solid {{ section.settings.btn_text }};{% endif %}" class="image-with-text-new--btn image-with-text-new--mobile">
              {{ section.settings.btn_name }}
            </a>
          {% endif %}
      </div>
      
    </div>
    
  </div>
</div>


{% schema %}
  {
    "name": "Image With Text - New",
    "settings": [
      {
        "type": "color",
        "id": "bg_color",
        "label": "Background Color",
        "default":"#000"
      },
      {
        "type": "color",
        "id": "text_color",
        "label": "Text Color",
        "default":"#000"
      },
      {
        "type": "select",
        "id": "position",
        "label": "Position",
        "options": [
          {
            "label": "Image First",
            "value": "left"
          },
          {
            "label": "Image Last",
            "value": "right"
          }
        ],
        "default":"right"
      },
      {
        "type": "image_picker",
        "id":"image",
        "label": "Image"
      },
      {
        "type": "image_picker",
        "id":"image_mobile",
        "label": "Image - Mobile"
      },
      {
        "type": "textarea",
        "id": "heading",
        "label": "Heading",
        "default":"Add Heading Text Here",
        "info": "Use <span>Color Text</span> element if you want to display color text."
      },
      {
        "type": "richtext",
        "id": "content",
        "label": "Content",
        "default":"<p>Lorem Ipsum is simply dummy text of the printing and typesetting industry. Lorem Ipsum has been the industry's standard dummy text ever since the 1500s, when an unknown printer took a galley of type and scrambled it to make a type specimen book.</p>"
      },
      {
        "type": "header",
        "content": "Button"
      },
      {
        "type": "text",
        "id":"btn_name",
        "label": "Button Name",
        "default":"Button Name"
      },
      {
        "type": "url",
        "id":"btn_link",
        "label": "Button Link"
      },
      {
        "type": "select",
        "id":"btn_style",
        "label": "Button Style",
        "options": [
          {
            "label": "Fill",
            "value": "fill"
          },
          {
            "label": "Outline",
            "value": "outline"
          }
        ],
        "default":"fill"
      },
      {
        "type": "color",
        "id": "btn_background",
        "label": "Background"
      },
      {
        "type": "color",
        "id": "btn_text",
        "label": "Text",
        "default":"#000"
      }
    ],
    "presets": [
      {
        "name": "Image With Text - New"
      }
    ]
  }
{% endschema %}