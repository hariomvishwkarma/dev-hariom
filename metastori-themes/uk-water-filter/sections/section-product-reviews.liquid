{% assign product_sku = product.selected_or_first_available_variant.sku %}
{% if product_sku %}
<style>
  #shopify-section-{{ section.id }} {
    padding-top: {{ section.settings.padding-top }}px;
    padding-bottom: {{ section.settings.padding-bottom }}px;
  }

  #shopify-section-{{ section.id }} .product--container {
    position: relative;
  }

  #shopify-section-{{ section.id }} .section-title {
    position: absolute;
    top: 0%;
    left: 50%;
    transform: translate(-50%, -100%);
    padding: 10px 25px 10px 25px;
    background-color: white;
    color: #2D4B60;
    font-size: 32px;
  }

  #shopify-section-{{ section.id }} .trustbox-wrapper {
    padding: 100px;
    border-radius: 8px;
    border: #D9D9D9 1px solid;
  }
  
  @media screen and (max-width: 1249px) {
    #shopify-section-{{ section.id }} .trustbox-wrapper {
      padding: 50px 25px;
    }

    #shopify-section-{{ section.id }} .section-title {
      font-size: 22px;
    }
  }
</style>

<section class="product--container {{ product.handle }}">
  <h2 class="section-title">Reviews</h2>
  <div class="trustbox-wrapper">
    <!-- TrustBox widget - Product Reviews -->
    <div class="trustpilot-widget" data-locale="en-US" data-template-id="544a426205dc0a09088833c6" data-businessunit-id="5ca5ac479121e1000152fa10" data-style-height="1000px" data-style-width="100%" data-theme="light" data-sku="{{ product_sku }}" data-review-languages="en" data-font-family="Fira Sans" data-text-color="#1C2228" data-no-reviews="show" data-fullwidth="true">
      <a href="https://www.trustpilot.com/review/www.uk-water-filters.co.uk" target="_blank" rel="noopener">Trustpilot</a>
    </div>
    <!-- End TrustBox widget -->
  </div>
</section>
{% endif %}

{% schema %}
{
  "name": "Product reviews",
  "presets": [
  {
   "name":"Product reviews"
  }
  ],
  "settings": [
		{
      "type": "range",
      "id": "padding-top",
      "label": "Padding top",
      "min": 0,
      "max": 100,
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-bottom",
      "label": "Padding bottom",
      "min": 0,
      "max": 100,
      "default": 0
    }
  ]
}
{% endschema %}