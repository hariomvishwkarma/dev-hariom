<style>
    #shopify-section-{{ section.id }} .icon-delete-outline {
      width: 25px;
      height: 25px;
      margin-bottom: 10px;
    }

    #shopify-section-{{ section.id }} .cart-item--remove-link {
      color: #8D8D8D;
    }

    #shopify-section-{{ section.id }} .cartitems--container {
      margin-top: 64px;
    }

    #shopify-section-{{ section.id }} .cart-item--remove-caption {
      text-decoration: underline;
    }

    #shopify-section-{{ section.id }} .cart-title-left {
      display: flex;
      align-items: baseline;
      gap: 6px;
    }

    #shopify-section-{{ section.id }} .cart-title {
      margin-bottom: 0px;
      margin-top: 0px;
    }

    #shopify-section-{{ section.id }} .cart-title-total--small {
      color: #02A8D2;
      font-size: 14px;
    }

    #shopify-section-{{ section.id }} .cartitems {
      display: grid;
      grid-template-columns: 2fr 408px;
      gap: 32px;
      column-gap: 96px;
    }

    #shopify-section-{{ section.id }} .cartitems .cart-item--sale-price {
      text-decoration: none;
    }

    #shopify-section-{{ section.id }} .cartitems .regular-price-value {
      text-decoration: line-through;
    }

    #shopify-section-{{ section.id }} .cartitems--right-container {
      background: #001F3C;
      color: white;
      padding: 24px;
      border-radius: 8px;
      align-self: start;
    }

    #shopify-section-{{ section.id }} .delivery-information-wrapper {
      display: flex;
      justify-content: center;
    }

    #shopify-section-{{ section.id }} .form-field-select-wrapper {
      margin-left: auto;
      margin-top: 0;
      background-color: #fff;
      border: 1px solid #001F3C;
      border-radius: 4px;
      align-items: center;
    }

    #shopify-section-{{ section.id }} .form-field-select-wrapper .btnqtyy{
      position: relative;
      height: 50px;
      cursor: pointer;
    }
    #shopify-section-{{ section.id }} .form-field-select-wrapper svg{
      left:50%;
      right:unset;
      transform: translate(-50%,-50%);
      margin-top: 0;
    }

    #shopify-section-{{ section.id }} .cartitems--left-container .form-field-select-wrapper .form-field-input {
      height: 50px;
      width: 41px;
      background-color: white;
      border: none;
    }

    #shopify-section-{{ section.id }} .cart-shippingcalc--inner {
      flex-direction: column;
    }

    #shopify-section-{{ section.id }} .delivery-information {
      background-color: grey;
      padding: 5px 15px;
      border-radius: 10px;
    }

    #shopify-section-{{ section.id }} .delivery-information-label {
      display: inline;
    }

    #shopify-section-{{ section.id }} .discount-list {
      margin-top: 0;
      margin-bottom: 0;
    }

    #shopify-section-{{ section.id }} .cart-subtotal {
      margin-bottom: 0px;
    }

    #shopify-section-{{ section.id }} .cart-subtotal > * {
      text-align: center;
    }

    #shopify-section-{{ section.id }} .cart-subtotal-label {
      font-size: 24px;
      margin-bottom: 0px;
      font-family: 'gibson-semibold';
    }

    #shopify-section-{{ section.id }} .cart-subtotal .money {
      font-size: 24px;
      font-family: 'gibson-semibold';
    }

    #shopify-section-{{ section.id }} ul[data-shopify-buttoncontainer] {
      display: grid !important;
      grid-template-columns: 1fr 1fr;
    }

    #shopify-section-{{ section.id }} ul[data-shopify-buttoncontainer] {
      gap: 1;
      display: flex;
      flex-wrap: wrap;
      gap: 15px;
    }

    #shopify-section-{{ section.id }} .cart-title-right .button-primary {
      width: 100%;
      justify-content: center;
      font-size: 16px;
      padding: 1rem 1.125rem;
    }

    #shopify-section-{{ section.id }} ul[data-shopify-buttoncontainer] > * {
      flex-basis: 50%;
    }

    #shopify-section-{{ section.id }} ul[data-shopify-buttoncontainer] > *:nth-child(1) {
      order: 3;
    }

    #shopify-section-{{ section.id }} ul[data-shopify-buttoncontainer] > *:nth-child(2) {
      order: 4;
    }

    #shopify-section-{{ section.id }} ul[data-shopify-buttoncontainer] > *:nth-child(3) {
      order: 1;
    }

    #shopify-section-{{ section.id }} ul[data-shopify-buttoncontainer] > *:nth-child(4) {
      order: 2;
    }

    #shopify-section-{{ section.id }} .cart-checkout .button-primary {
      margin-bottom: 12px;
      width: 100%;
      height: 50px;
      text-transform: capitalize;
      background: #91C03E;
      border: none;
      position:relative;
    }

    #shopify-section-{{ section.id }} [data-cartshipping-submit] {
      width: 100% !important;
      background-color: black;
      border-color: black;
    }

    #shopify-section-{{ section.id }} .shopify-cleanslate .XLcXEW3RnM9fyU7k7fvC {
      margin-top: 0 !important;
    }

    #shopify-section-{{ section.id }} .cart-sidebar-discount {
      width: 100%;
      margin-bottom: 10px;
    }

    #shopify-section-{{ section.id }} .cart-sidebar-discount #discount-code-input,
    #shopify-section-{{ section.id }} .cart-sidebar-discount #apply-discount-btn {
      display: none;
    }

    #shopify-section-{{ section.id }} .cart-sidebar-discount #apply-discount-btn {
      font-size: var(--font-size-button-medium);
      letter-spacing: 0;
    }

    #shopify-section-{{ section.id }} .cart-sidebar-discount.open #discount-code-input,
    #shopify-section-{{ section.id }} .cart-sidebar-discount.open #apply-discount-btn {
      display: block;
    }

    #shopify-section-{{ section.id }} .cart-discount-toggle,
    #shopify-section-{{ section.id }} .cart-shipping-toggle {
      background: none;
      border: none;
      text-decoration: underline !important;
      color: white;
    }

    #shopify-section-{{ section.id }} .cart-shipping-toggle {
      width: 100%;
    }

    #shopify-section-{{ section.id }} .cart-item--content-price {
      text-align: center;
      margin-left: 40px;
      display: flex;
      flex-direction: column;
      gap: 10px;
    }

    #shopify-section-{{ section.id }} .cart-item--sku,
    #shopify-section-{{ section.id }} .stock-bullet-point {
      margin-bottom: 5px;
    }

    #shopify-section-{{ section.id }} .carto-continue-wrapper {
      text-align: start;
      margin-top: 32px;
    }

    #shopify-section-{{ section.id }} .cart-bullet-points .carto-continue-wrapper {
      display: none;
    }

    #shopify-section-{{ section.id }} .cart-continue {
      display: inline-block;
      padding: 15px 30px;
      border: #001F3C solid 1px;
      color: #001F3C;
      font-weight: bold;
      font-size: 14px;
      border-radius: 4px;
      font-family: 'gibson-semibold';
    }

    #shopify-section-{{ section.id }} .cart-bullet-points {
      display: flex;
      flex-direction: column;
      gap: 12px;
      grid-column: 2/3;
    }

    #shopify-section-{{ section.id }} .cart-bullet-point {
      border: #D9D9D9 1px solid;
      padding: 15px;
      align-items: center;
    }

    #shopify-section-{{ section.id }} .cart-bullet-point p {
      margin: 10px auto;
      font-size: 15px;
    }

    #shopify-section-{{ section.id }} .cart-bullet-point:nth-child(3),
    #shopify-section-{{ section.id }} .cart-bullet-point:nth-child(4),
    #shopify-section-{{ section.id }} .cart-bullet-point:nth-child(5) {
      display: flex;
      gap: 10px;
      justify-content: center;
    }

    #shopify-section-{{ section.id }} .cart-bullet-point:nth-child(3) .img__wrapper,
    #shopify-section-{{ section.id }} .cart-bullet-point:nth-child(4) .img__wrapper,
    #shopify-section-{{ section.id }} .cart-bullet-point:nth-child(5) .img__wrapper {
      width: 25px;
    }

    #shopify-section-{{ section.id }} .cart-bullet-points {
      text-align: center;
    }

    #shopify-section-{{ section.id }} .cart-bullet-point-one .img__wrapper {
      width: 60px;
      position: absolute;
      top: 0%;
      left: 50%;
      transform: translate(-50%, -50%);
    }

    #shopify-section-{{ section.id }} .cart-bullet-point-one {
      position: relative;
      padding-top: 25px;
    }

    #shopify-section-{{ section.id }} .cart-title-right {
      display: none;
    }

    #shopify-section-{{ section.id }} .trustpilot-widget {
      grid-column: 2 / 3;
      margin-bottom: 0px;
    }

    #shopify-section-{{ section.id }} .cartitems--left-container {
      grid-row: 1 / 3;
    }

    #shopify-section-{{ section.id }} .empty-cart .cart-title-right {
      display: none;
    }

    #shopify-section-{{ section.id }} .empty-cart .cartitems-empty,
    #shopify-section-{{ section.id }} .empty-cart .cart-bullet-points {
      grid-column: 1/3;
    }

    #shopify-section-{{ section.id }} .cartitems--right-container .img__wrapper {
      max-width: 165px;
      margin: 0 auto;
      margin-top: 15px;
    }

    #shopify-section-{{ section.id }} .mobile-checkout {
      display: none;
      width: 100%;
      justify-content: center;
      gap: 10px;
      align-items: center;
      font-family: Fira Sans;
      font-size: 16px;
      font-weight: 700;
      padding: 0.9rem 1rem;
      background-color: #91C03E;
      border: none;
      height: 50px;
    }

    #shopify-section-{{ section.id }} .mobile-checkout svg{
      position: absolute;
      right: 24px;
      top: 50%;
      transform: translateY(-50%);
    }

    #shopify-section-{{ section.id }} .cart-continue {
      display: inline-block;
      padding: 15px 30px;
      border: #001F3C solid 1px;
      color: #001F3C;
      font-weight: bold;
      font-size: 14px;
      border-radius: 4px;
      font-family: 'gibson-semibold';
    }

    @media (max-width: 1250px) {
      #shopify-section-{{ section.id }} .cart-item:first-child {
        border-top: 1px solid rgba(128,128,128,.16);;
      }

      #shopify-section-{{ section.id }} .cartitems {
        display: block;
      }

      #shopify-section-{{ section.id }} .carto-continue-wrapper {
        margin: 0 0 20px;
        text-align: left;
        width: 100%;
      }
      #shopify-section-{{ section.id }} .carto-continue-wrapper a{
        width: 100%;
        text-align: center; 
      }
      .cart-bullet-point+#shopify-section-{{ section.id }} .carto-continue-wrapper{
        display: none;
      }
      
      #shopify-section-{{ section.id }} .cart-bullet-points .carto-continue-wrapper {
        display: block;
        margin: 0;
      }

      #shopify-section-{{ section.id }} .cart-bullet-points .carto-continue-wrapper .cart-continue {
        width: 100%;
        text-align: center;
      }

      #shopify-section-{{ section.id }} .trustpilot-widget {
        margin-top: 30px;
      }
      #shopify-section-{{ section.id }} .mobile-checkout {
        display: flex;
      }

      #shopify-section-{{ section.id }} .cart-title-left {
        margin-bottom: 32px;
      }
    }

    @media(max-width: 749px) {
      #shopify-section-{{ section.id }} .cart-continue-desk {
        display: none;
      }
      #shopify-section-{{ section.id }} .cart-title {
        flex-direction: column;
      }
      #shopify-section-{{ section.id }} .cart-title-right {
        width: 100%;
      }
      #shopify-section-{{ section.id }} .cartitems--container {
        margin-top: 32px;
      }
      #shopify-section-{{ section.id }} .form-field-select-wrapper .btnqtyy{
        height: 36px;
        flex: 1;
      }
      #shopify-section-{{ section.id }} .cartitems--left-container .form-field-select-wrapper .form-field-input {
        height: 49px;
      }
      #shopify-section-{{ section.id }} .cart-item--content-price {
        display:none;
      }
      #shopify-section-{{ section.id }} .cartitems--right-container {
        padding: 24px 16px;
      }
      #shopify-section-{{ section.id }} .cart-subtotal-label {
        font-size: 18px;
      }
      #shopify-section-{{ section.id }} .cart-subtotal .money {
        font-size: 18px;
      }
    }
    @media (min-width:768px){
      #shopify-section-{{ section.id }} .cart-continue {
        margin-left: 30px;
        font-size: 20px;
        padding-bottom: 17px;
      }
      #shopify-section-{{ section.id }} .cart-continue-mobile{
        display:none;
      }
    }
</style>

<script src="{{ 'quantity-selection.js' | asset_url }}" defer="defer"></script>

{% assign is_customer = false %}
{% if shop.customer_accounts_enabled and customer %}
  {% assign is_customer = true %}
{% endif %}

{% assign has_sidebar = false %}
{% assign has_items = false %}
{% assign show_continue_link = false %}

{% if section.blocks.size > 0 %}
  {% assign has_sidebar = true %}
{% endif %}

{% if cart.items.size > 0 %}
  {% assign has_items = true %}
{% endif %}

{% assign continue_url = routes.all_products_collection_url %}
{% if settings.continue_shopping_url != blank %}
  {% assign continue_url = settings.continue_shopping_url %}
{% endif %}

{% if settings.continue_url_cart %}
  {% assign show_continue_link = true %}
  {%- capture continue_link_html -%}
    <div class="carto-continue-wrapper">
      {% assign upsell_list = '' %}
      {% assign cart_items_ids = '' %}
    
      {% for item in cart.items %}
        {% assign cart_items_ids = cart_items_ids | append: item.product_id | append:"," %}
        {% assign upsell_list_product = item.product.metafields.custom.product_page_upsell.value %}
        {% for p in upsell_list_product limit:2 %}
          {% assign upsell_list = upsell_list | append: p.handle | append:','  %}
        {% endfor %}
      {% endfor %}
      {% assign upsell_list = upsell_list | split:','  %}
    
      {% capture upsell%}
        {% if section.settings.show_upsell == true and upsell_list != blank %}
          <div class="cart_upsell_main">
            {% if section.settings.upsell_heading != blank %}
              <h3 class="upsell_heading">{{ section.settings.upsell_heading }}</h3>
            {% endif %}
            {% if upsell_list != blank %}
              <div class="cart_upsell_list">
                {% for p_handle in upsell_list %}
                  {% assign product_ = all_products[p_handle] %}
                  {% unless cart_items_ids contains product_.id %}
                    <div class="cart_upsell_item">
                      <div class="cart_upsell_item_img">
                        <img src="{{ product_.featured_image | image_url }}" width="auto" height="auto" alt="upsell"/>
                      </div>
                      <div class="cart_upsell_content">
                        <h4 class="cart_upsell_item_title">{{ product_.title }}</h4>
                        <div class="cart_upsell_prices">
                          <div class="upsell_price_flex">
                            <span class="cart_upsell_regular_price">{{ product_.price | money }}</span>
                            {% if product_.compare_at_price > product_.price %}
                              <span class="cart_upsell_compare_price">{{ product_.price | money }}</span>
                            {% endif %}
                          </div>
                          {% if product_.compare_at_price > product_.price %}
                            <span class="cart_upsell_save_badge">Add and Save!</span>
                          {% endif %}
                        </div>
                      </div>
                      <div class="cart_upsell_submit">
                        <div class="cart_upsell_prices_mobile">
                          <div class="upsell_price_flex">
                            <span class="cart_upsell_regular_price">{{ product_.price | money }}</span>
                            {% if product_.compare_at_price > product_.price %}
                              <span class="cart_upsell_compare_price">{{ product_.price | money }}</span>
                            {% endif %}
                          </div>
                          {% if product_.compare_at_price > product_.price %}
                            <span class="cart_upsell_save_badge">Add and Save!</span>
                          {% endif %}
                        </div>
                        <span class="upsell_product_submit" variant_id="{{ product_.first_available_variant.id }}">Add
                          <div class="spinner_loader"></div>
                        </span>
                        {% comment %}
                        <form action="/cart/add" method="post">
                          <input type="hidden" name="id" value="{{ product_.first_available_variant.id }}" />
                          <input type="submit" class="upsell_product_submit" value="Add" />
                        </form>
                        {% endcomment %}
                      </div>
                    </div>
                    {% assign show_upsell = true %}
                  {% endunless %}
                {% endfor %}
              </div>
            {% endif %}
          </div>
        {% endif %}
      {% endcapture %}

      {% if show_upsell == true %}
        {{ upsell }}
      {% endif %}
      <a class="cart-continue cart-continue-mobile" href="{{ continue_url }}">
        {{ 'cart.general.continue_shopping' | t }}
      </a>
    </div>
  {%- endcapture -%}
{% endif %}

<script
  type="application/json"
  data-section-type="static-cart"
  data-section-id="{{ section.id }}"
  data-section-data>
  {
    "settings": {
      "shipping": {{ section.settings.enable_shipping_calc | json }},
      "money_format": {{ shop.money_format | strip_html | json }}
    },
    "shipping": {
      "calculate_shipping": {{ 'cart.shipping.calculate_shipping' | t | json }},
      "calculating": {{ 'cart.shipping.calculating' | t | json }},
      "customer": {{ is_customer | default: false | json }},
      "multiple_rates": {{ 'cart.shipping.multiple_rates' | t: number_of_rates: '*number_of_rates*', address: '*address*', rate: '*rate*' | json }},
      "one_rate": {{ 'cart.shipping.one_rate' | t: address: '*address*' | json }},
      "no_rates": {{ 'cart.shipping.no_rates' | t | json }},
      "rate_value": {{ 'cart.shipping.rate_value' | t: rate_title: '*rate_title*', rate: '*rate*'  | json }},
      "zip": {{ 'cart.shipping.zip' | t | json }},
      "shipment_too_heavy": {{ 'cart.shipping.shipment_too_heavy' | t | json }},
      "error_general": {{ 'cart.shipping.error_general' | t | json }}
    }
  }
</script>

<form
{% unless has_items %}class="empty-cart"{% endunless %}
  action="{{ routes.cart_url }}"
  method="post"
  aria-label="cart checkout"
>

  <section class="cartitems--container {% if has_sidebar %}has-sidebar{% endif %}">
    <div class="cartitems">
      {% if has_items %}
        <div class="cartitems--left-container">

              <header class="cart-title">
                  <div class="cart-title-left">
                    <div class="cart-title-flex">
                      <h1>{{ 'cart.general.your_cart' | t }}</h1>
                
                      {% if has_items %}
                        <div class="cart-title-total--small">({{ cart.item_count }} Items)</div>
                      {% endif %}
                    </div>
                    <a class="cart-continue cart-continue-desk" href="{{ continue_url }}">
                      {{ 'cart.general.continue_shopping' | t }}
                    </a>
                  </div>

                  <div class="mobile_top_checkout">
                      {% if settings.terms_checkbox == true and settings.terms_content != blank %}
                        <div class="terms-and-conditions">
                          <label class="agree-terms-checkbox">
                            <input type="checkbox" class="custom-checkbox agree-terms-conditions"  form="cart" required>
                            <span class="checkbox-styling">
                            </span>
                            <p>{{ settings.terms_content }}</p>
                          </label>
                        </div>
                        <p class="terms-error">
                          {{ settings.terms_error }}
                        </p>
                        <input type="hidden" name="attributes[Agree to T&C]" value="False" class="tnc-attribute">
                      {% endif %}
                      <button
                        class="cus-checkout-button button-primary mobile-checkout"
                        type="submit"
                        name="checkout"
                        aria-label="{{ 'cart.general.checkout' | t }}"
                      >
                        {% comment %}
                        {% if settings.enable_checkout_lock_icon %}
                          {% render 'icon-checkout-lock' %}
                        {% else %}
                          {% render 'icon-library', id: 'icon-cart' %}
                        {% endif %}
                        {% endcomment %}
                        {{ 'cart.general.checkout' | t }}
                        <svg xmlns="http://www.w3.org/2000/svg" width="15" height="16" viewBox="0 0 15 16" fill="none">
                          <path d="M13.6816 3.33594C14.2285 3.58984 14.5117 4.00977 14.5312 4.5957C14.4727 7.13477 13.9746 9.24414 13.0371 10.9238C12.0801 12.584 11.0547 13.8242 9.96094 14.6445C8.86719 15.4648 8.04688 15.875 7.5 15.875C6.95312 15.875 6.12305 15.4648 5.00977 14.6445C3.91602 13.8047 2.90039 12.5547 1.96289 10.8945C1.02539 9.21484 0.527344 7.11523 0.46875 4.5957C0.488281 4.00977 0.78125 3.58984 1.34766 3.33594L6.97266 0.992188C7.14844 0.914062 7.32422 0.875 7.5 0.875C7.69531 0.875 7.88086 0.914062 8.05664 0.992188L13.6816 3.33594ZM7.5 14.4688C8.4375 14.0781 9.32617 13.4336 10.166 12.5352C11.0254 11.6367 11.7285 10.5234 12.2754 9.19531C12.8223 7.84766 13.1055 6.32422 13.125 4.625L7.5 2.28125L1.875 4.625C1.93359 7.125 2.50977 9.23438 3.60352 10.9531C4.7168 12.6719 6.01562 13.8438 7.5 14.4688ZM5.85938 8.11133L6.76758 8.99023L9.08203 6.23633C9.21875 6.08008 9.39453 6.00195 9.60938 6.00195C9.86328 6.02148 10.0488 6.10938 10.166 6.26562C10.2637 6.44141 10.3125 6.58789 10.3125 6.70508C10.3125 6.88086 10.2539 7.03711 10.1367 7.17383L7.32422 10.4551C7.08984 10.6504 6.91406 10.7285 6.79688 10.6895C6.60156 10.709 6.43555 10.6406 6.29883 10.4844L4.89258 9.07812C4.75586 8.96094 4.6875 8.79492 4.6875 8.58008C4.72656 8.16992 4.96094 7.93555 5.39062 7.87695C5.58594 7.89648 5.74219 7.97461 5.85938 8.11133Z" fill="white"/>
                        </svg>
                      </button>
                      <div class="additional-checkout-buttons">
                        {{ content_for_additional_checkout_buttons }}
                      </div>
                  </div>
              
                  {% if has_items or show_continue_link %}
                    <div class="cart-title-right">
                      {% if has_items %}
                        {% comment %} <div class="cart-title-total--large">
                          <div class="cart-title-total" data-cart-title-total>
                            {{ 'cart.general.subtotal' | t }}
              
                            <span class="money" data-cart-total>
                              {{ cart.total_price | money }}
                            </span>
                          </div>
                        </div> {% endcomment %}
              
                        <button
                          class="button-primary cart-title-button"
                          name="checkout"
                          type="submit"
                          aria-label="{{ 'cart.general.checkout' | t }}"
                        >
                          {% if settings.enable_checkout_lock_icon %}
                            {% render 'icon-checkout-lock' %}
                          {% else %}
                            {% render 'icon-library', id: 'icon-cart' %}
                          {% endif %}
                          {{ 'cart.general.checkout' | t }}
                        </button>
                      {% elsif show_continue_link %}
                        {{ continue_link_html }}
                      {% endif %}
                    </div>
                  {% endif %}
                </header>
        
          {%
            render 'cart-item-list',
            show_sku: section.settings.show_sku
            cart: cart
          %}
          {% if show_continue_link %}
            {{ continue_link_html }}
          {% endif %}
        </div>

        <div class="cart_right_part">
        <div class="cart-total cartitems--right-container">

          {% if section.settings.cart_heading != blank %}
            <h2 class="cart_box_heading">{{ section.settings.cart_heading }}</h2>
          {% endif %}

          {% if section.settings.enable_order_notes %}
            <div class="cart-ordernote">
              <span class="cart-ordernote-heading">{{ 'cart.general.enter_order_note' | t }}</span>
              <div class="form-field">
                <textarea class="form-field-input form-field-textarea" name="note" id="cart-note">{{ cart.note }}</textarea>
                <label class="form-field-title" for="cart-note">{{ 'cart.general.special_instructions' | t }}</label>
              </div>
            </div>
          {% endif %}

          <div class="cart-final-total">

            <noscript>
              <button
                class="cart-update"
                type="submit"
                aria-label="{{ 'cart.general.update' | t }}"
              >
                {{ 'cart.general.update' | t }}
              </button>
            </noscript>

            <ul class="discount-list cart-discount-list" data-cart-discounts aria-label="{{ 'product.general.discounts' | t }}">
              {%
                render 'cart-discounts',
                cart: cart
              %}
            </ul>

            <div class="cart-subtotal cart_total_item">
              <div class="cart-subtotal-label">Total</div>
              <div class="money" data-cart-total>{{ cart.total_price | money }}</div>
            </div>

            {% comment %}
            <div class="delivery-information-wrapper">
              <div class="delivery-information" style="display: inline;">
                {% render 'icon-car-delivery' %}
                <div class="delivery-information-label">Free UK delivery</div>
              </div>
            </div>
            {% endcomment %}
          </div>

          {% if section.settings.discount_text != blank %}
            <div class="cart_box_discount_text">{{ section.settings.discount_text }}</div>
          {% endif %}

          {% comment %} <div class="cart-shipping">
            {%- capture taxes_shipping_checkout -%}
              {%- if cart.taxes_included and shop.shipping_policy.body != blank -%}
                {{ 'cart.general.taxes_included_and_shipping_policy_html' | t: link: shop.shipping_policy.url }}
              {%- elsif cart.taxes_included -%}
                {{ 'cart.general.taxes_included_but_shipping_at_checkout' | t }}
              {%- elsif shop.shipping_policy.body != blank -%}
                {{ 'cart.general.taxes_and_shipping_policy_at_checkout_html' | t: link: shop.shipping_policy.url }}
              {%- else -%}
                {{ 'cart.general.tax_and_shipping' | t }}
              {%- endif -%}
            {%- endcapture -%}

            <p class="cart-message meta">{{ taxes_shipping_checkout }}</p>

            {% comment %}
              snippets/cart-shipping.liquid has an internal check to see if shipping is required
            {% endcomment %}
          </div> {% endcomment %}

          <div class="cart-checkout">
            {% if settings.terms_checkbox == true and settings.terms_content != blank %}
              <div class="terms-and-conditions">
                <label class="agree-terms-checkbox">
                  <input type="checkbox" class="custom-checkbox agree-terms-conditions"  form="cart" required>
                  <span class="checkbox-styling">
                  </span>
                  <p>{{ settings.terms_content }}</p>
                </label>
              </div>
              <p class="terms-error">
                {{ settings.terms_error }}
              </p>
              <input type="hidden" name="attributes[Agree to T&C]" value="False" class="tnc-attribute">
            {% endif %}
            <button
              class="cus-checkout-button button-primary"
              type="submit"
              name="checkout"
              aria-label="{{ 'cart.general.checkout' | t }}"
            >
              {% comment %}
              {% if settings.enable_checkout_lock_icon %}
                {% render 'icon-checkout-lock' %}
              {% else %}
                {% render 'icon-library', id: 'icon-cart' %}
              {% endif %}
              {% endcomment %}
              {{ 'cart.general.checkout' | t }}
              <svg class="checkout_verified" xmlns="http://www.w3.org/2000/svg" width="15" height="16" viewBox="0 0 15 16" fill="none"> <path d="M13.6816 3.33594C14.2285 3.58984 14.5117 4.00977 14.5312 4.5957C14.4727 7.13477 13.9746 9.24414 13.0371 10.9238C12.0801 12.584 11.0547 13.8242 9.96094 14.6445C8.86719 15.4648 8.04688 15.875 7.5 15.875C6.95312 15.875 6.12305 15.4648 5.00977 14.6445C3.91602 13.8047 2.90039 12.5547 1.96289 10.8945C1.02539 9.21484 0.527344 7.11523 0.46875 4.5957C0.488281 4.00977 0.78125 3.58984 1.34766 3.33594L6.97266 0.992188C7.14844 0.914062 7.32422 0.875 7.5 0.875C7.69531 0.875 7.88086 0.914062 8.05664 0.992188L13.6816 3.33594ZM7.5 14.4688C8.4375 14.0781 9.32617 13.4336 10.166 12.5352C11.0254 11.6367 11.7285 10.5234 12.2754 9.19531C12.8223 7.84766 13.1055 6.32422 13.125 4.625L7.5 2.28125L1.875 4.625C1.93359 7.125 2.50977 9.23438 3.60352 10.9531C4.7168 12.6719 6.01562 13.8438 7.5 14.4688ZM5.85938 8.11133L6.76758 8.99023L9.08203 6.23633C9.21875 6.08008 9.39453 6.00195 9.60938 6.00195C9.86328 6.02148 10.0488 6.10938 10.166 6.26562C10.2637 6.44141 10.3125 6.58789 10.3125 6.70508C10.3125 6.88086 10.2539 7.03711 10.1367 7.17383L7.32422 10.4551C7.08984 10.6504 6.91406 10.7285 6.79688 10.6895C6.60156 10.709 6.43555 10.6406 6.29883 10.4844L4.89258 9.07812C4.75586 8.96094 4.6875 8.79492 4.6875 8.58008C4.72656 8.16992 4.96094 7.93555 5.39062 7.87695C5.58594 7.89648 5.74219 7.97461 5.85938 8.11133Z" fill="white"/> </svg>
            </button>

            <div class="additional-checkout-buttons">
              {{ content_for_additional_checkout_buttons }}
            </div>

          </div>

          {% if section.settings.show_payment_icons %}
            <div class="cart_box_payment_icons">
                <ul class="payment-icons">
                  {% for type in shop.enabled_payment_types %}
                    <li class="payment-icons-item">
                      {{ type | payment_type_svg_tag }}
                    </li>
                  {% endfor %}
                </ul>
            </div>
          {% endif %}
                
          {% if section.settings.enable_discount %}
            {% render 'cart-discount' %}
          {% endif %}

          {% if section.settings.enable_shipping_calc %}
            {% render 'cart-shipping', section: section %}
          {% endif %}

          <!-- TrustBox widget - Micro Star -->
            <div class="trustpilot-widget" data-locale="en-US" data-template-id="5419b732fbfb950b10de65e5" data-businessunit-id="5ca5ac479121e1000152fa10" data-style-height="25px" data-style-width="100%" data-theme="dark">
              <a href="https://www.trustpilot.com/review/www.uk-water-filters.co.uk" target="_blank" rel="noopener">Trustpilot</a>
            </div>
          <!-- End TrustBox widget -->
                
        </div>

          {% if section.settings.bullet_heading_1 != blank or section.settings.bullet_content_1 != blank %}
            <div class="cart_bullet_point">
              <div class="cart_bullet_point_content">
                {% if section.settings.bullet_heading_1 != blank %}
                  <h3 class="cart_bullet_heading_1">{{ section.settings.bullet_heading_1 }}</h3>
                {% endif %}
                {% if section.settings.bullet_content_1 != blank %}
                  <div class="cart_bullet_content_1">{{ section.settings.bullet_content_1 }}</div>
                {% endif %}
              </div>
              <div class="cart_bullet_point_image">
                <img src="{{ section.settings.bullet_icon_1 | image_url }}" width="auto" height="auto" alt="cart_bullet_point_image">
              </div>
            </div>
          {% endif %}

                
          <div class="cart-trustpilot-review">
            <div class="cart-trustbadge_icons">
              {% assign stars = section.settings.rating %}
              {% for star in (1..stars) %}
                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 20 20" fill="none">
                  <rect width="20" height="20" fill="#02B67A"/>
                  <path d="M10 13.6761L13.0417 12.8616L14.3125 17L10 13.6761ZM17 8.32704H11.6458L10 3L8.35417 8.32704H3L7.33334 11.6289L5.6875 16.956L10.0208 13.6541L12.6875 11.6289L17 8.32704Z" fill="white"/>
                </svg>
              {% endfor %}
            </div>
            <div class="cart-trustbadge_review">{{ section.settings.review }}</div>
            <div class="cart-trustbadge_customerName">{{ section.settings.customer_name }}</div>
          </div>
          {% comment %}
          <div class="cart-trustbadge-carousal">
            <div
              class="trustpilot-widget"
              data-locale="en-GB"
              data-template-id="54ad5defc6454f065c28af8b"
              data-businessunit-id="5ca5ac479121e1000152fa10"
              data-style-height="auto"
              data-style-width="100%"
              data-theme="light"
              data-stars="1,2,3,4,5"
              data-review-languages="en"
            >
              <a href="https://uk.trustpilot.com/review/www.uk-water-filters.co.uk" target="_blank" rel="noopener"
                >Trustpilot</a
              >
            </div>
        </div>
        {% endcomment %}
    
          {% if section.settings.help_heading != blank or section.settings.help_content != blank %}
            <div class="cart_help_point">
              <div class="cart_help_point_content">
                {% if section.settings.help_heading != blank %}
                  <h3 class="help_heading">{{ section.settings.help_heading }}</h3>
                {% endif %}
                {% if section.settings.help_content != blank %}
                  <div class="help_content">{{ section.settings.help_content }}</div>
                {% endif %}
              </div>
            </div>
          {% endif %}
      </div>
                
      {% else %}
        <div class="cartitems-empty">
          <div class="cartitems-empty--inner">
            <p>{{ 'cart.general.cart_empty' | t }}</p>

            {% if show_continue_link %}
              <a class="button-primary" href="{{ continue_url }}">
                {% render 'icon-library', id: 'icon-cart' %}
                {{ 'cart.general.continue_shopping' | t }}
              </a>
            {% endif %}
          </div>
        </div>
      {% endif %}
      
    </div>


    {% if has_sidebar %}
      <div class="cart-sidebar" data-cart-sidebar>
        {% for block in section.blocks %}
          <div class="cart-sidebar-block" {{ block.shopify_attributes }}>
            {% if block.type == 'image' %}
              {% assign image = block.settings.image %}

              <article class="cart-sidebar-item">
                {% if image %}
                  {%
                    render 'rimg',
                    img: image,
                    class: 'cart-sidebar-item-image',
                    size: '445x',
                    lazy: true,
                    canvas: true
                  %}
                {% else %}
                  {{ 'image' | placeholder_svg_tag: 'placeholder--image cart-sidebar-item-image' }}
                {% endif %}
              </article>
            {% endif %}

            {% if block.type == 'richtext' %}
              <article class="cart-sidebar-item cart-sidebar-item--text rte">
                {{ block.settings.richtext }}
              </article>
            {% endif %}

            {% if block.type == 'page' %}
              <article class="cart-sidebar-item cart-sidebar-item--text rte">
                {{ pages[block.settings.page].content }}
              </article>
            {% endif %}
          </div>
        {% endfor %}
      </div>
    {% endif %}
  </section>
</form>

 <script src="https://ajax.googleapis.com/ajax/libs/jquery/3.7.1/jquery.min.js"></script>
<script>
  $(document).ready(function() {
    // Increment quantity
    $(document).on('click', '.qtyplu', function(e){
      e.preventDefault();
      var quantityInput = $(this).siblings('input');
      var currentVal = parseInt(quantityInput.val());
      //console.log(currentVal);
      if (!isNaN(currentVal)) {
        quantityInput.val(currentVal + 1);
        quantityInput.trigger('change'); // Trigger change event if needed
      }
    });

    // Decrement quantity
    $(document).on('click', '.qtymin', function(e){
      e.preventDefault();
      var quantityInput = $(this).siblings('input');
      var currentVal = parseInt(quantityInput.val());
      if (!isNaN(currentVal) && currentVal > 1) {
        quantityInput.val(currentVal - 1);
        quantityInput.trigger('change'); // Trigger change event if needed
      }
    });

    document.querySelectorAll('.upsell_product_submit').forEach(function(button) {
    button.addEventListener('click', function() {
      const variantId = button.getAttribute('variant_id');

     button.setAttribute('disabled', 'true');
  
      fetch('/cart/add.js', {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json'
        },
        body: JSON.stringify({
          id: variantId,
          quantity: 1
        })
      })
      .then(response => response.json())
      .then(data => {
        window.location.href = '/cart';
      })
      .catch(error => {
        console.error('Error adding to cart:', error);
      });
    });
  });
    
  });
</script>

