<style>
  #shopify-section-{{ section.id }}{
    padding-top: {{ section.settings.padding-top }}px;
    padding-bottom: {{ section.settings.padding-bottom }}px;
  }
  #shopify-section-{{ section.id }} .product-recently-viewed__heading {
    font-size: 32px;
    font-weight: 700;
    font-style: unset;
    text-transform: capitalize;
  }
     
  #shopify-section-{{ section.id }} .product-recently-viewed__wrapper,
  #shopify-section-{{ section.id }} .product-section--content {
    padding: 0;
    margin-bottom:0;
  }
  #shopify-section-{{ section.id }} .product-section--content{
    margin-top:56px;
  }
     
  #shopify-section-{{ section.id }} .flickity-page-dots {
    bottom: 30px;
  }

  #shopify-section-{{ section.id }} .flickity-slider,
  #shopify-section-{{ section.id }} .product-grid-item {
    min-height: 100%;
    animation: fillHeight 0s 0.2s linear forwards;
  }

  @media screen and (max-width: 1025px) {
    #shopify-section-{{ section.id }} .product-recently-viewed__heading {
      font-size: 22px;
      text-align: center;
    }
  }

  @keyframes fillHeight {
    0% {
        height: auto;
    }
    100% {
        height: 100%;
    }
  }
</style>

{% if section.settings.enable_recently_viewed_products %}
  {%- capture recently_viewed_data -%}
  {%-
    render 'product-recently-viewed',
    product: product
  -%}
{%- endcapture -%}

  <script
    type="application/json"
    data-section-type="static-recently-viewed"
    data-section-id="{{ section.id }}"
    data-section-data
  >
    {
      {{ recently_viewed_data }}
    }
  </script>

  <aside
    aria-label="Recently viewed products"
    class="product-section--container product-recently-viewed--section product--container"
  >
    <div class="product-recently-viewed__wrapper">
      <div class="product-recently-viewed__header">
        <h2 class="product-recently-viewed__heading">
          Recently Viewed
        </h2>
        <button
          class="product-recently-viewed__clear"
          data-clear-recently-viewed
        >
          {{ 'general.time.clear' | t }}
        </button>
      </div>

      <ul
        class="
          product-section--content
          product-recently-viewed__content
          recently-products-carousel recommended-products-carousel 
          imagestyle--{% if settings.product_grid_image_crop and settings.product_grid_image_style != 'natural' %}cropped-{% endif %}{{ settings.product_grid_image_style }}
        "
        data-recently-viewed-container
      ></ul>
    </div>
  </aside>
{% endif %}

{% schema %}
{
  "name": "t:sections.recently_viewed_products.name",
  "class": "recently-viewed--section",
  "settings": [
    {
      "type": "checkbox",
      "id": "enable_recently_viewed_products",
      "label": "t:sections.recently_viewed_products.enable_recently_viewed_products.label",
      "info": "t:sections.recently_viewed_products.enable_recently_viewed_products.info"
    },
    {
      "type": "range",
      "id": "padding-top",
      "label": "Padding top",
      "min": 0,
      "step": 2,
      "max": 200,
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-bottom",
      "label": "Padding bottom",
      "min": 0,
      "step": 2,
      "max": 200,
      "default": 0
    }
  ],
  "enabled_on": {
    "templates": ["*"]
  }
}
{% endschema %}
