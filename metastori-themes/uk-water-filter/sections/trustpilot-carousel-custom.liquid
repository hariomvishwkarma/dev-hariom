<div class="trustpilot_carousel_custom" id="trustpilot-carousel-{{ section.id }}">
  <div class="trustpilot_custom_slider trustpilot_custom_slider-{{ section.id }}">
    {% for block in section.blocks %}
      <div class="trustpilot_slider_item" {{ block.shopify_attributes }}>
        <div class="trustpilot_slide_icons">
          {% assign stars = block.settings.rating %}

          {% for star in (1..stars) %}
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 20 20" fill="none">
              <rect width="20" height="20" fill="#02B67A"/>
              <path d="M10 13.6761L13.0417 12.8616L14.3125 17L10 13.6761ZM17 8.32704H11.6458L10 3L8.35417 8.32704H3L7.33334 11.6289L5.6875 16.956L10.0208 13.6541L12.6875 11.6289L17 8.32704Z" fill="white"/>
            </svg>
          {% endfor %}
        </div>

        <div class="trustpilot_slide_review">
          {{ block.settings.review }}
        </div>

        <div class="trustpilot_slide_customerName">
          {{ block.settings.customer_name }}
        </div>
      </div>
    {% endfor %}
  </div>
</div>

<script>
  (function () {
    const sectionId = '{{ section.id }}';
    const sliderSelector = '.trustpilot_custom_slider-' + sectionId;

    function initTrustpilotSlider() {
      const slider = document.querySelector(sliderSelector);

      if (!slider) return;

      const existingInstance = Flickity.data(slider);

      if (existingInstance) {
        existingInstance.destroy();
      }

      const isMobile = window.innerWidth <= 768;

      new Flickity(slider, {
        cellAlign: isMobile ? 'left' : 'center',
        contain: true,
        pageDots: false,
        prevNextButtons: false,
        wrapAround: true,
        autoPlay: 3000,
        pauseAutoPlayOnHover: false
      });
    }

    // Normal page load
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initTrustpilotSlider);
    } else {
      initTrustpilotSlider();
    }

    // Shopify Theme Editor
    document.addEventListener('shopify:section:load', function (event) {
      if (event.detail.sectionId === sectionId) {
        initTrustpilotSlider();
      }
    });

    document.addEventListener('shopify:section:unload', function (event) {
      if (event.detail.sectionId === sectionId) {
        const slider = document.querySelector(sliderSelector);

        if (slider) {
          const instance = Flickity.data(slider);

          if (instance) {
            instance.destroy();
          }
        }
      }
    });
  })();
</script>

{% schema %}
  {
    "name": "Trustpilot Carousel",
    "settings": [],
    "blocks": [
      {
        "type": "review",
        "name":"Review",
        "settings": [
          {
            "type": "range",
            "id": "rating",
            "label":"Rating",
            "max": 5,
            "min": 1,
            "step": 1,
            "default":5
          },
          {
            "type": "textarea",
            "id":"review",
            "label":"Customer Review"
          },
          {
            "type": "text",
            "id":"customer_name",
            "label": "Customer Name"
          }
        ]
      }
    ],
    "presets": [
      {
        "name": "Trustpilot Carousel"
      }
    ]
  }
{% endschema %}