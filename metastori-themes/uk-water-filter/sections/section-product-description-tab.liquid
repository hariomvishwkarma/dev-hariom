<style>
  #shopify-section-{{ section.id }} {
    padding-top: {{ section.settings.padding-top }}px;
    padding-bottom: {{ section.settings.padding-bottom }}px;
  }
</style>
{% unless product.metafields.custom.hide_product_description_tab %}

<style>
  #shopify-section-{{ section.id }} .product--container{
    margin-top:0;
  }
  #shopify-section-{{ section.id }} .img__wrapper{
    max-width: 50%;
    margin: 0 auto;
    padding-top:0;
    border-radius: 8px;
    overflow: hidden;
  }

  #shopify-section-{{ section.id }} .accordion {
    display: flex;
    flex-direction: column;
  }

  #shopify-section-{{ section.id }} .accordion-header {
    cursor: pointer;
    display: flex;
    justify-content: space-between;
    color: #001F3C;
    font-weight: bold;
    font-size:18px;
    padding-bottom:24px;
    font-family: 'gibson-semibold';
  }

  #shopify-section-{{ section.id }} .accordion-content-container {
    display: none;
    padding-bottom:24px;
  }

  #shopify-section-{{ section.id }} .accordion.active .accordion-header{
    color:#02A8D2;
  }

  #shopify-section-{{ section.id }} .accordion.active .accordion-content-container {
    display: flex;
  }

  #shopify-section-{{ section.id }} .accordion.active .accordion-content-container .img__wrapper {
    margin-bottom: auto;
  }

  #shopify-section-{{ section.id }} .accordion-header::after {
    content: "";
    font-weight: bold;
    width: 13px;
    border-radius: 50%;
    display: flex;
    justify-content: center; 
    height: 13px;
    font-size: 18px;
    background-repeat: no-repeat;
    background-size: contain;
    background-position: center;
    background-image: url('https://cdn.shopify.com/s/files/1/0665/1782/7878/files/1_a1ccafc7-c838-4bd7-bda1-cf001c4ef554.svg?v=1746523011');
  }

  #shopify-section-{{ section.id }} .accordion.active .accordion-header::after {
    background-image: url('https://cdn.shopify.com/s/files/1/0665/1782/7878/files/1.svg?v=1746522781');
  }

  #shopify-section-{{ section.id }} .tab-content > *:first-child {
    margin-top: 0;
  }

  #shopify-section-{{ section.id }} .tab-content > *:last-child {
    margin-bottom: 0;
  }
     
  #shopify-section-{{ section.id }} .accordion-content.hidden {
    display: none !important;
  }

  .custom-iamge-hide{
    display:none !important;
  }
  @media screen and (max-width: 1249px) {
    #shopify-section-{{ section.id }} .accordion-content {
      padding: 20px 0px;
    }
  }

  @media screen and (max-width: 1025px) {
    #shopify-section-{{ section.id }} .product--container {
      padding: 0 15px;
    }

    #shopify-section-{{ section.id }} .accordion-content-container {
      flex-direction: column;
      gap: unset !important;
      padding: 25px 10px;
    }

    #shopify-section-{{ section.id }} .accordion-content-container .img__wrapper {
      order: -1;
      max-width: 100%;
    }

    #shopify-section-{{ section.id }} .accordion-header {
      padding: 20px 15px;
      font-size: 22px;
      font-size: 15px;
    }
    .accordion-content-wrapper button.product-form--atc-button {
      width: 100%;
      margin-left: 0;
    }
  }

  @media screen and (min-width: 768px) {
    .accordion-content-wrapper button.product-form--atc-button {
      max-width: 342px;
      margin-left: 0;
    }
  }
</style>

{% assign replacement_title = product.metafields.custom.tab_more_info_title %}

<section class="product--container" id="product-description-tab-container">

  <div class="accordion{% if section.settings.open_on_load %} active{% endif %}">
    <div class="accordion-header">
      {% if replacement_title != blank %}
      {{ replacement_title }}
      {% else %}
      {{ section.settings.title }}
      {% endif %}
    </div>
    <div class="accordion-content-container">
      <div class="accordion-content-wrapper">
        <div class="accordion-content shortened">
          <div class="tab-content shortened">
            {{ product.content }}
          </div>
        </div>
      </div>
      <div class="img__wrapper custom_description_image custom-iamge-hide">
        {%- assign img_height = product.featured_image.width | divided_by: product.featured_image.aspect_ratio -%}
              
        {{ product.featured_image | image_url: width: 1000 | image_tag:
          height: img_height,
          width: product.featured_image.width,
          loading: 'lazy'
        }}
      </div>
    </div>
  </div>

  <script>
    document.querySelectorAll('#product-description-tab-container .tab-content a[href*="#"]').forEach(link => {
      link.addEventListener('click', function (e) {
        const hash = this.hash;
        if (!hash) return;

        const target = document.querySelector(hash);
        if (!target) return;

        e.preventDefault();

        // 🔓 Expand shortened tab content if needed
        const tab = target.closest('.tab-content');
        if (tab && tab.classList.contains('shortened')) {
          tab.classList.remove('shortened');
        }

        // ⏱️ Scroll after DOM updates
        setTimeout(() => {
          target.scrollIntoView({
            behavior: 'smooth',
            block: 'start'
          });
        }, 150);
      });
    });
  </script>
</section>

  {% endunless %}

{% schema %}
{
  "name": "Tab product description",
  "class": "tab-section tab-description-section",
  "presets": [
  {
   "name":"Tab product description"
  }
  ],
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Title"
    },
    {
      "type": "checkbox",
      "id": "open_on_load",
      "label": "Open on load",
      "default":true
    },
		{
      "type": "range",
      "id": "padding-top",
      "label": "Padding top",
      "min": 0,
      "step": 5,
      "max": 200,
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-bottom",
      "label": "Padding bottom",
      "min": 0,
      "step": 5,
      "max": 200,
      "default": 0
    }
  ]
}
{% endschema %}