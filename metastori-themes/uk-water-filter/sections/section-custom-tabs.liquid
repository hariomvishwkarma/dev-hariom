<style>
  #shopify-section-{{ section.id }} {
    padding-top: {{ section.settings.padding-top }}px;
    padding-bottom: {{ section.settings.padding-bottom }}px;
  }

  #shopify-section-{{ section.id }} .img__wrapper{
    max-width: {{ section.settings.img_width }}px;
    margin: 0 auto;
  }

  #shopify-section-{{ section.id }} .accordion {
    display: flex;
    flex-direction: column;
  }

  #shopify-section-{{ section.id }} .accordion-header {
    padding: 10px;
    cursor: pointer;
    border-bottom: 1px solid #EAEDEF;
    display: flex;
    justify-content: space-between;
    color: #2D4B60;
    font-weight: bold;
    background-color: #EAEDEF;
    border-radius: 8px;
  }

  #shopify-section-{{ section.id }} .accordion-content {
    padding: 40px;
    display: none;
  }

  #shopify-section-{{ section.id }} .accordion.active {
    border: #2D4B60 solid 1px;
    border-radius: 8px;
  }

  #shopify-section-{{ section.id }} .accordion.active .accordion-content {
    display: block;
    border-bottom-left-radius: 8px;
    border-bottom-right-radius: 8px;
  }

  #shopify-section-{{ section.id }} .accordion.active .accordion-header {
    background-color: #2D4B60;
    border-radius: unset;
    border-top-left-radius: 8px;
    border-top-right-radius: 8px;
    color: white;
  }

  #shopify-section-{{ section.id }} .accordion-header::after {
    content: "+";
    font-weight: bold;
    background: #2D4B60;
    width: 20px;
    border-radius: 50%;
    display: flex;
    justify-content: center;
    color: white; 
    height: 20px;
    font-size: 18px;
  }

  #shopify-section-{{ section.id }} .accordion.active .accordion-header::after {
    background: white;
    color: #2D4B60;
  }

  #shopify-section-{{ section.id }} .accordion.active .accordion-header::after {
    content: "-";
  }
     
  #shopify-section-{{ section.id }} .accordion-header {
    padding: 20px 50px;
    font-size: 22px;
  }

  #shopify-section-{{ section.id }} .tab-content > *:first-child {
    margin-top: 0;
  }

  #shopify-section-{{ section.id }} .tab-content > *:last-child {
    margin-bottom: 0;
  }

  #shopify-section-{{ section.id }} .accordion.not-first {
    margin-top: 1.25rem;
  }

  
  @media screen and (max-width: 1249px) {
    #shopify-section-{{ section.id }} .accordion-content {
      padding: 20px 30px;
    }
  }

  @media screen and (max-width: 1025px) {
    #shopify-section-{{ section.id }} .product--container {
      padding: 0 15px;
    }
    #shopify-section-{{ section.id }} .accordion-header {
      padding: 20px 15px;
      font-size: 22px;
      font-size: 15px;
    }
  }
</style>

<section class="product--container">

  {% for block in section.blocks %}
  <div class="accordion {% unless forloop.index == 1 %}not-first{% endunless %}">
    <div class="accordion-header">
      {{ block.settings.title }}
    </div>
    <div class="accordion-content">
      <div class="tab-content">
          {% if block.settings.richtext != blank %}
            <div class="accordion-content-wrapper">{{ block.settings.richtext }}</div>
          {% endif %}
          {%- if block.settings.image != blank -%}
            <div class="img__wrapper">
              {%- assign img_height = block.settings.image.width | divided_by: block.settings.image.aspect_ratio -%}
          
              {{ block.settings.image | image_url: width: 1000 | image_tag:
                height: img_height,
                width: block.settings.image.width,
                loading: 'lazy'
              }}
            </div>
          {%- endif -%}
      </div>
    </div>
  </div>
  {% endfor %}

</section>




{% schema %}
{
  "name": "Custom tabs",
  "class": "tab-section custom-tabs",
  "settings": [
		{
      "type": "range",
      "id": "img_width",
      "label": "Image maximum width",
      "min": 0,
      "step": 50,
      "max": 1200,
      "default": 0
    },
		{
      "type": "range",
      "id": "padding-top",
      "label": "Padding top",
      "min": 0,
      "step": 5,
      "max": 200,
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-bottom",
      "label": "Padding bottom",
      "min": 0,
      "step": 5,
      "max": 200,
      "default": 0
    }
  ],
  "presets": [
  {
   "name":"Custom tabs"
  }
  ],
  "blocks": [
     {
       "name": "Content",
       "type": "tab-content",
       "settings": [
         {
           "type": "text",
           "id": "title",
           "label": "Title"
         },
         {
           "type": "richtext",
           "id": "richtext",
           "label": "Text"
         },
         {
           "type": "image_picker",
           "id": "image",
           "label": "Image"
         }
       ]
     }
   ]
}
{% endschema %}