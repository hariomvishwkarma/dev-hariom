<style>
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.50 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.50 | round: 0 }}px;
  }
  .collection_meta_wr .breadcrumbs-container {
    padding: 0;
  }
  
  .collection_meta_main {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: flex-start;
  }
  
  .collection_meta_main .collection_meta {
    width: 60%;
  }
  
  .collection_meta_main .collection_meta_review {
      width: 33%;
      display: flex;
      flex-direction: column;
      justify-content: space-between;
  }

  .collection_trustpilot_review{
    background: #f1f8fc;
    padding: 40px 24px;
    border-radius: 16px;
  }
  
  .collection_meta_main .collection_meta_review .pdp-trustbadge-carousal {
    margin: 0;
  }
  
  a.sub_collection_meta {
    color: #001f3c;
    display: inline-flex;
    text-decoration: none;
    gap: 16px;
    padding: 13px;
    border: unset;
    border-radius: 4px;
    align-items: center;
    justify-content: center;
    background: #F1F8FC;
    font-family: 'gibson-semibold';
}
  .sub_collection_main {
    display: flex;
    gap: 16px;
    flex-wrap: wrap;
  }
  
  .collection--section.section--canonical {
    margin-top: 0;
  }
  @media screen and (min-width: 990px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
  @media screen and (min-width: 1600px) {
    .collection_meta_main .collection_trustpilot_review {
      min-height: 220px;
    }
  }
  @media screen and (max-width: 1440px) {
    .collection_meta_main .collection_meta {
      width: 65%;
    }
  }
  @media screen and (max-width: 767px) {
    .collection_meta_main .collection_meta_review {
      display: none;
    }
    .collection_meta_main .collection_meta {
      width: 100%;
    }
    a.sub_collection_meta {
      gap: 8px;
      padding: 6px 9px;
      font-size: 14px;
    }
    .sub_collection_main {
      gap: 10px;
    } 
    .collection_meta_wr .breadcrumbs-container{
      margin-top: 8px;
    }
  }

  @media screen and (max-width: 679px) {
    .sub_collection_main {
        flex-wrap: nowrap;
        overflow-x: auto;
        scroll-snap-type: x mandatory;
        padding-bottom: 10px;
    }
    
    a.sub_collection_meta {
        scroll-snap-align: start;
        scroll-snap-stop: normal;
        flex-shrink: 0;
        padding: 13px 18px;
    }
    
    .collection_meta_main .collection_meta {
        padding-bottom: 15px;
    }
  }
  
</style>

<div class="collection_meta_wr section-{{ section.id }}-padding">
  <div class="site-footer-item">
    {% render 'subcollection_grid' %}
    {% render 'breadcrumbs' %}
    <div class="collection_meta_main">
      <div class="collection_meta">
        <div class="sub_collection_main">
          {% for block in section.blocks %}
            {% if block.settings.collection_meta_title != blank %}
              <a href="{{ block.settings.collection_meta_link }}" class="sub_collection_meta">
                <img src="{{ block.settings.collection_meta_img | image_url: width: 50 }}" width="24" height="24">
                {{ block.settings.collection_meta_title }}
              </a>
            {% endif %}
          {% endfor %}
        </div>
      </div>
      <div class="collection_meta_review">
        <div class="collection_trustpilot_review">
          <div class="trustpilot_slide_icons">
            {% assign stars = section.settings.rating %}
            {% for star in (1..stars) %}
              <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 20 20" fill="none">
                <rect width="20" height="20" fill="#02B67A"/>
                <path d="M10 13.6761L13.0417 12.8616L14.3125 17L10 13.6761ZM17 8.32704H11.6458L10 3L8.35417 8.32704H3L7.33334 11.6289L5.6875 16.956L10.0208 13.6541L12.6875 11.6289L17 8.32704Z" fill="white"/>
              </svg>
            {% endfor %}
          </div>
          <div class="trustpilot_slide_review">{{ section.settings.review }}</div>
          <div class="trustpilot_slide_customerName">{{ section.settings.customer_name }}</div>
        </div>
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Collection meta",
  "settings": [
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "label": "Top Padding",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "label": "Bottom Padding",
      "default": 40
    },
    {
      "type": "range",
      "id": "rating",
      "min": 1,
      "max": 5,
      "step": 1,
      "label": "Rating",
      "default": 5
    },
    {
      "type": "textarea",
      "id": "review",
      "label": "Review"
    },
    {
      "type": "text",
      "id": "customer_name",
      "label": "Customer Name"
    }
  ],
  "blocks": [
    {
      "type": "subcollection",
      "name": "Subcollection",
      "settings": [
        {
          "type": "image_picker",
          "id": "collection_meta_img",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "collection_meta_title",
          "label": "Title"
        },
        {
          "type": "url",
          "id": "collection_meta_link",
          "label": "Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Collection meta"
    }
  ]
}
{% endschema %}
