{% liquid
  assign current_month = 'now' | date: '%B'
  if section.settings.use_current_month == false and section.settings.custom_month != blank
    assign current_month = section.settings.custom_month
  endif

  assign columns = section.settings.columns_desktop | default: 3
  assign mobile_carousel = section.settings.enable_mobile_carousel
  assign container_max_width = section.settings.container_max_width | default: 1050
%}

{% style %}
  #shopify-section-{{ section.id }} {
    --bs-columns: {{ columns }};
    --bs-highlight: {{ section.settings.highlight_color }};
    --bs-roundel-bg: {{ section.settings.roundel_background }};
    --bs-roundel-text: {{ section.settings.roundel_text_color }};
    --bs-save-color: {{ section.settings.save_text_color }};
    --bs-card-bg: {{ section.settings.card_background }};
    --bs-card-border: {{ section.settings.card_border_color }};
    --bs-max-width: {{ container_max_width }}px;
  }

  #shopify-section-{{ section.id }} .bestseller-savings {
    max-width: var(--bs-max-width);
    margin-left: auto;
    margin-right: auto;
    padding-top: {{ section.settings.padding_top | times: 0.5 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.5 | round: 0 }}px;
    padding-left: 16px;
    padding-right: 16px;
    box-sizing: border-box;
  }

  @media screen and (min-width: 990px) {
    #shopify-section-{{ section.id }} .bestseller-savings {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }

  #shopify-section-{{ section.id }} .bestseller-savings__title {
    text-align: center;
    margin: 0 0 25px;
    font-weight: 700;
    font-size: clamp(22px, 3vw, 34px);
    line-height: 1.25;
    color: {{ section.settings.heading_color }};
  }

  #shopify-section-{{ section.id }} .bestseller-savings__title strong,
  #shopify-section-{{ section.id }} .bestseller-savings__title .bestseller-savings__highlight {
    color: var(--bs-highlight);
    font-weight: 700;
  }

  #shopify-section-{{ section.id }} .bestseller-savings__title h2 {
    margin: 0;
    font-size: 32px;
    font-weight: inherit;
    color: inherit;
    line-height: inherit;
  }

  #shopify-section-{{ section.id }} .bestseller-savings__grid {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  #shopify-section-{{ section.id }} .bestseller-savings__item {
    width: 100%;
    margin-bottom: 30px;
    box-sizing: border-box;
  }

  #shopify-section-{{ section.id }} .bestseller-savings__card {
    height: 100%;
    background: var(--bs-card-bg);
    border: 1px solid var(--bs-card-border);
    border-radius: 4px;
    display: flex;
    flex-direction: column;
    box-sizing: border-box;
    overflow: hidden;
  }

  #shopify-section-{{ section.id }} .bestseller-savings__image-wrap {
    position: relative;
    min-height: 340px;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 20px 16px 12px;
    box-sizing: border-box;
  }

  #shopify-section-{{ section.id }} .bestseller-savings__image-link {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    height: 100%;
  }

  #shopify-section-{{ section.id }} .bestseller-savings__image {
    display: block;
    width: 100%;
    height: 100%;
    max-height: 380px;
    min-height: 300px;
    margin: 0 auto;
    object-fit: contain;
  }

  #shopify-section-{{ section.id }} .bestseller-savings__roundel,
  #shopify-section-{{ section.id }} .price-roundel {
    position: absolute;
    top: 12px;
    right: 12px;
    width: 75px;
    height: 75px;
    background: var(--bs-roundel-bg);
    color: var(--bs-roundel-text);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    font-size: 15px;
    font-weight: 600;
    line-height: 1.2;
    z-index: 5;
    padding: 10px;
    box-sizing: border-box;
  }

  #shopify-section-{{ section.id }} .bestseller-savings__card.productitem {
    position: relative;
    padding: 0;
    background: var(--bs-card-bg);
    box-shadow: none;
    min-height: 0;
    height: 100%;
  }

  #shopify-section-{{ section.id }} .bestseller-savings__card.productitem:hover {
    box-shadow: none;
  }

  #shopify-section-{{ section.id }} .bestseller-savings__cta-wrap.logolist_button_main {
    margin-top: auto;
    text-align: center;
  }

  #shopify-section-{{ section.id }} .bestseller-savings__cta.logolist_button {
    min-width: 160px;
    padding: 14px 24px;
    border: 1px solid #001f3c;
    color: #001f3c;
    background: #fff;
  }

  #shopify-section-{{ section.id }} .bestseller-savings__info {
    display: flex;
    flex-direction: column;
    flex-grow: 1;
    text-align: left;
    padding: 0 18px 20px;
    box-sizing: border-box;
  }

  #shopify-section-{{ section.id }} .bestseller-savings__product-title {
    margin: 0 0 10px;
    font-size: 16px;
    font-weight: 700;
    line-height: 1.35;
    text-align: left;
    color: {{ section.settings.heading_color }};
    font-family: 'gibson-semibold';
  }

  #shopify-section-{{ section.id }} .bestseller-savings__product-title a {
    color: inherit;
    text-decoration: none;
  }

  #shopify-section-{{ section.id }} .bestseller-savings__guarantee {
    text-align: left;
    padding-top: 10px;
    padding-bottom: 10px;
    font-size: 14px;
    line-height: 1.4;
  }

  #shopify-section-{{ section.id }} .bestseller-savings__save {
    margin: 0 0 18px;
    font-size: 15px;
    font-family: 'gibson-semibold';
    font-weight: 700;
    line-height: 1.4;
    text-align: left;
    color: {{ section.settings.heading_color }};
  }

  #shopify-section-{{ section.id }} .bestseller-savings__save-amount {
    color: var(--bs-save-color);
  }

  #shopify-section-{{ section.id }} .bestseller-savings__cta-wrap {
    margin-top: auto;
    text-align: center;
  }

  #shopify-section-{{ section.id }} .bestseller-savings__cta {
    display: inline-block;
    min-width: 160px;
    padding: 14px 24px;
    border: 1px solid #001f3c;
    color: #001f3c;
    background: #fff;
    text-decoration: none;
    text-transform: uppercase;
    font-size: 14px;
    font-weight: 600;
    letter-spacing: 0.02em;
    box-sizing: border-box;
  }

  #shopify-section-{{ section.id }} .bestseller-savings__cta:hover {
    background: #001f3c;
    color: #fff;
  }

  {% if mobile_carousel %}
    @media screen and (max-width: 768px) {
      #shopify-section-{{ section.id }} .bestseller-savings__grid {
        display: flex;
        flex-wrap: nowrap;
        gap: 12px;
        overflow-x: auto;
        overflow-y: hidden;
        scroll-snap-type: x mandatory;
        scroll-behavior: smooth;
        -webkit-overflow-scrolling: touch;
        overscroll-behavior-x: contain;
        cursor: grab;
        padding-bottom: 4px;
        scrollbar-width: none;
        -ms-overflow-style: none;
      }

      #shopify-section-{{ section.id }} .bestseller-savings__grid::-webkit-scrollbar {
        display: none;
      }

      #shopify-section-{{ section.id }} .bestseller-savings__grid.is-dragging {
        cursor: grabbing;
        scroll-behavior: auto;
        scroll-snap-type: none;
      }

      #shopify-section-{{ section.id }} .bestseller-savings__item {
        flex: 0 0 82%;
        width: 82%;
        max-width: 82%;
        margin-bottom: 0;
        margin-right: 0;
        scroll-snap-align: start;
      }

      #shopify-section-{{ section.id }} .bestseller-savings__image-wrap {
        min-height: 280px;
      }

      #shopify-section-{{ section.id }} .bestseller-savings__image {
        min-height: 240px;
        max-height: 300px;
      }
    }

    @media screen and (min-width: 769px) {
      #shopify-section-{{ section.id }} .bestseller-savings__grid {
        display: grid !important;
        grid-template-columns: repeat(var(--bs-columns), minmax(0, 1fr)) !important;
        gap: 20px;
      }
      #shopify-section-{{ section.id }} .bestseller-savings__title {
        margin: 0 0 45px;
      }

      #shopify-section-{{ section.id }} .bestseller-savings__item {
        width: 100% !important;
        margin-right: 0;
        margin-bottom: 0;
      }
    }
  {% else %}
    #shopify-section-{{ section.id }} .bestseller-savings__grid {
      display: grid !important;
      grid-template-columns: repeat(var(--bs-columns), minmax(0, 1fr)) !important;
      gap: 20px;
    }

    @media screen and (max-width: 768px) {
      #shopify-section-{{ section.id }} .bestseller-savings__grid {
        grid-template-columns: 1fr !important;
        gap: 20px;
      }
    }
  {% endif %}

  @media screen and (max-width: 1023px) and (min-width: 769px) {
    #shopify-section-{{ section.id }} .bestseller-savings__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr)) !important;
    }
  }
{% endstyle %}

<section
  id="bestseller-savings-{{ section.id }}"
  class="bestseller-savings featured-collection__container"
  data-section-id="{{ section.id }}"
  data-section-type="bestseller-savings"
>
  {% if section.settings.show_heading %}
    <div class="home-section--title bestseller-savings__title">
      <h2>
        {{ current_month -}}
        {{- section.settings.heading_prefix }}
        <strong class="bestseller-savings__highlight">{{ section.settings.heading_highlight }}</strong>
      </h2>
    </div>
  {% endif %}

  <ul
    class="bestseller-savings__grid home-section--content featured-collection__content_scalebeyond"
    id="bestseller-savings-grid-{{ section.id }}"
    data-layout="grid"
    {% if mobile_carousel %}
      data-bestseller-carousel
    {% endif %}
  >
    {% for block in section.blocks %}
      {% liquid
        assign product = block.settings.product
        if product == blank
          continue
        endif

        assign product_title = product.title
        if block.settings.custom_title != blank
          assign product_title = block.settings.custom_title
        endif

        assign product_url = product.url
        assign save_text = block.settings.save_text

        assign guarantee_text = section.settings.guarantee_text
        if block.settings.guarantee_text != blank
          assign guarantee_text = block.settings.guarantee_text
        endif

        assign button_label = section.settings.button_label
        if block.settings.button_label != blank
          assign button_label = block.settings.button_label
        endif

        if block.settings.custom_image != blank
          assign card_image = block.settings.custom_image
        else
          assign card_image = product.featured_media.preview_image | default: product.featured_image
        endif
      %}

      <li
        class="bestseller-savings__item productgrid--item"
        {{ block.shopify_attributes }}
      >
        <div class="bestseller-savings__card productitem">
          <div class="bestseller-savings__image-wrap productitem__image-container">
            {% if save_text != blank %}
              <div class="bestseller-savings__roundel price-roundel">{{ save_text }}</div>
            {% endif %}

            <a class="bestseller-savings__image-link" href="{{ product_url }}" tabindex="-1">
              {% if card_image != blank %}
                {{
                  card_image
                  | image_url: width: 700
                  | image_tag:
                    class: 'bestseller-savings__image productitem--image-primary',
                    loading: 'lazy',
                    widths: '280, 360, 480, 600, 700',
                    sizes: '(max-width: 768px) 82vw, (max-width: 1023px) 45vw, 320px',
                    alt: product_title
                }}
              {% else %}
                {{ 'product-1' | placeholder_svg_tag: 'bestseller-savings__image' }}
              {% endif %}
            </a>
          </div>

          <div class="bestseller-savings__info productitem--info">
            <h3 class="bestseller-savings__product-title productitem--title">
              <a href="{{ product_url }}">{{ product_title }}</a>
            </h3>

            {% if guarantee_text != blank %}
              <div class="bestseller-savings__guarantee productitem__stock-level">
                {{ guarantee_text }}
              </div>
            {% endif %}

            {% if save_text != blank %}
              <div class="bestseller-savings__save">
                <span class="bestseller-savings__save-amount">{{ save_text }}</span>
                this {{ current_month }}
              </div>
            {% endif %}

            <div class="bestseller-savings__cta-wrap logolist_button_main">
              <a
                href="{{ product_url }}"
                class="bestseller-savings__cta button-secondary logolist_button"
              >
                {{ button_label }}
              </a>
            </div>
          </div>
        </div>
      </li>
    {% else %}
      {% for i in (1..3) %}
        <li class="bestseller-savings__item productgrid--item">
          <div class="bestseller-savings__card">
            <div class="bestseller-savings__image-wrap">
              <div class="bestseller-savings__roundel price-roundel">Save £100</div>
              {{ 'product-1' | placeholder_svg_tag: 'bestseller-savings__image' }}
            </div>
            <div class="bestseller-savings__info">
              <h3 class="bestseller-savings__product-title">Add a product in the theme editor</h3>
              <div class="bestseller-savings__guarantee productitem__stock-level">
                ✓ 90 day money back guarantee &amp; 5 year warranty!
              </div>
              <div class="bestseller-savings__save">
                <span class="bestseller-savings__save-amount">Save £100</span>
                this {{ current_month }}
              </div>
              <div class="bestseller-savings__cta-wrap">
                <span class="bestseller-savings__cta">Shop Now</span>
              </div>
            </div>
          </div>
        </li>
      {% endfor %}
    {% endfor %}
  </ul>
</section>

{% if mobile_carousel %}
  <script>
    (function () {
      var sectionId = {{ section.id | json }};
      var grid = document.querySelector('#bestseller-savings-grid-' + sectionId);
      if (!grid) return;

      var isDown = false;
      var startX = 0;
      var scrollLeft = 0;
      var moved = false;

      function isMobile() {
        return window.matchMedia('(max-width: 768px)').matches;
      }

      function onPointerDown(event) {
        if (!isMobile() || event.pointerType === 'touch') return;
        isDown = true;
        moved = false;
        startX = event.clientX;
        scrollLeft = grid.scrollLeft;
        grid.classList.add('is-dragging');
      }

      function onPointerMove(event) {
        if (!isDown) return;
        var walk = startX - event.clientX;
        if (Math.abs(walk) > 3) moved = true;
        grid.scrollLeft = scrollLeft + walk;
      }

      function onPointerUp() {
        if (!isDown) return;
        isDown = false;
        grid.classList.remove('is-dragging');
      }

      function onClickCapture(event) {
        if (moved) {
          event.preventDefault();
          event.stopPropagation();
          moved = false;
        }
      }

      grid.addEventListener('pointerdown', onPointerDown);
      window.addEventListener('pointermove', onPointerMove);
      window.addEventListener('pointerup', onPointerUp);
      grid.addEventListener('click', onClickCapture, true);

      document.addEventListener('shopify:section:unload', function (event) {
        if (!event.detail || String(event.detail.sectionId) !== String(sectionId)) return;
        grid.removeEventListener('pointerdown', onPointerDown);
        window.removeEventListener('pointermove', onPointerMove);
        window.removeEventListener('pointerup', onPointerUp);
        grid.removeEventListener('click', onClickCapture, true);
      });
    })();
  </script>
{% endif %}

{% schema %}
{
  "name": "Bestseller Savings",
  "tag": "section",
  "class": "bestseller-savings--section",
  "max_blocks": 8,
  "settings": [
    {
      "type": "checkbox",
      "id": "show_heading",
      "label": "Show heading",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "use_current_month",
      "label": "Use current month in heading",
      "default": true,
      "info": "Updates automatically (e.g. September, October)."
    },
    {
      "type": "text",
      "id": "custom_month",
      "label": "Custom month",
      "info": "Used when \"Use current month\" is off."
    },
    {
      "type": "text",
      "id": "heading_prefix",
      "label": "Heading text after month",
      "default": "'s Biggest"
    },
    {
      "type": "text",
      "id": "heading_highlight",
      "label": "Highlighted heading text",
      "default": "Bestseller Savings!"
    },
    {
      "type": "text",
      "id": "guarantee_text",
      "label": "Default guarantee text",
      "default": "✓ 90 day money back guarantee & 5 year warranty!"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Default button label",
      "default": "Shop Now"
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "min": 2,
      "max": 4,
      "step": 1,
      "label": "Desktop columns",
      "default": 3
    },
    {
      "type": "range",
      "id": "container_max_width",
      "min": 800,
      "max": 1400,
      "step": 10,
      "unit": "px",
      "label": "Desktop container max width",
      "default": 1050,
      "info": "Keeps product cards compact on large screens."
    },
    {
      "type": "checkbox",
      "id": "enable_mobile_carousel",
      "label": "Enable mobile carousel",
      "default": true,
      "info": "Swipeable/scrollable carousel on mobile with no arrows or dots."
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading color",
      "default": "#001f3c"
    },
    {
      "type": "color",
      "id": "highlight_color",
      "label": "Heading highlight color",
      "default": "#02a8d2"
    },
    {
      "type": "color",
      "id": "roundel_background",
      "label": "Badge background",
      "default": "#ff0000"
    },
    {
      "type": "color",
      "id": "roundel_text_color",
      "label": "Badge text",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "save_text_color",
      "label": "Savings text color",
      "default": "#ff0000"
    },
    {
      "type": "color",
      "id": "card_background",
      "label": "Card background",
      "default": "#f1f8fc"
    },
    {
      "type": "color",
      "id": "card_border_color",
      "label": "Card border",
      "default": "#d9e6ee"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "label": "Top padding",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "label": "Bottom padding",
      "default": 40
    }
  ],
  "blocks": [
    {
      "type": "product",
      "name": "Product",
      "settings": [
        {
          "type": "product",
          "id": "product",
          "label": "Product"
        },
        {
          "type": "text",
          "id": "save_text",
          "label": "Savings badge / message",
          "default": "Save £200",
          "info": "Shown in the red roundel and in the \"Save £X this [Month]\" line."
        },
        {
          "type": "text",
          "id": "custom_title",
          "label": "Custom title",
          "info": "Optional. Defaults to the product title."
        },
        {
          "type": "image_picker",
          "id": "custom_image",
          "label": "Custom image",
          "info": "Optional. Defaults to the product featured image."
        },
        {
          "type": "text",
          "id": "guarantee_text",
          "label": "Guarantee text override"
        },
        {
          "type": "text",
          "id": "button_label",
          "label": "Button label override"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Bestseller Savings",
      "category": "Products",
      "blocks": [
        {
          "type": "product",
          "settings": {
            "product": "whole-of-house-with-scale-reduction-larger-size-40l-min-20-inch",
            "save_text": "Save £200"
          }
        },
        {
          "type": "product",
          "settings": {
            "product": "whole_of_house_with_scale_reduction",
            "save_text": "Save £100"
          }
        },
        {
          "type": "product",
          "settings": {
            "product": "standard-whole-house-water-filter-20l-minute",
            "save_text": "Save £200"
          }
        }
      ]
    }
  ]
}
{% endschema %}
