<script>
  document.addEventListener("DOMContentLoaded", function () {
    document.querySelectorAll("button[data-product-url]").forEach((button) => {
      button.addEventListener("click", (event) => {
        event.preventDefault();
        const url = button.getAttribute("data-product-url");
        if (url) {
          window.location.href = url;
        }
      });
    });
    let restartButton = document.getElementById("quiz-restart");
    let quizIntro = document.getElementById("quiz-intro");
    let quizContent = document.getElementById("quiz-content");
    let progressContainer = document.getElementById("quiz-progress-container");
    let progressBar = document.getElementById("quiz-progress-bar");
    let startButton = document.getElementById("quiz-start");
    let backButton = document.getElementById("quiz-back");
    let nextButton = document.getElementById("quiz-next");
    let resultBlocks = [
      document.getElementById("quiz-result"),
      document.getElementById("quiz-result2"),
      document.getElementById("quiz-result3"),
      document.getElementById("quiz-result4"),
      document.getElementById("quiz-result5"),
      document.getElementById("quiz-result6"),
    ];

    let selectedAnswer = null;
    let questionHistory = [];
    let currentQuestionIndex = 0;
    let totalQuestions = document.querySelectorAll(".quiz-question").length;
    let currentQuestion = document.querySelector(".quiz-question");

    if (startButton) {
      startButton.addEventListener("click", function () {
        quizIntro.style.display = "none";
        quizContent.style.display = "block";
        progressContainer.style.display = "block";
        updateProgress();
      });
    }

    document.querySelectorAll(".quiz-answer").forEach((radio) => {
      radio.addEventListener("change", function () {
        selectedAnswer = this;
        nextButton.removeAttribute("disabled");
      });
    });

    if (nextButton) {
      nextButton.addEventListener("click", function () {
        if (!selectedAnswer) return;

        let nextId = selectedAnswer.getAttribute("data-next");
        let redirectUrl = selectedAnswer.getAttribute("data-redirect");

        if (redirectUrl && redirectUrl !== "") {
          window.location.href = redirectUrl;
        } else if (nextId.startsWith("result")) {
          // Hide quiz content & progress bar, show the correct result block
          quizContent.style.display = "none";
          progressContainer.style.display = "none";

          let resultIndex = nextId.replace("result", ""); // Remove "result" prefix

          // If nextId is exactly "result", set index to 0
          resultIndex = resultIndex === "" ? 0 : parseInt(resultIndex, 10);

          if (!isNaN(resultIndex) && resultBlocks[resultIndex]) {
            console.log("Showing result index:", resultIndex);
            resultBlocks[resultIndex].style.display = "block";
          } else {
            console.error("Result block not found for index:", resultIndex);
          }
        } else {
          // Move to the next question
          questionHistory.push(currentQuestion.id);
          currentQuestion.style.display = "none";
          currentQuestion = document.getElementById(nextId);

          if (currentQuestion) {
            currentQuestion.style.display = "block";
            nextButton.setAttribute("disabled", "true");
            selectedAnswer = null;
            currentQuestionIndex++;
            updateProgress();
          }

          if (questionHistory.length > 0) {
            backButton.style.display = "inline-block";
          }
        }
      });
    }

    if (backButton) {
      backButton.addEventListener("click", function () {
        if (questionHistory.length === 0) {
          quizIntro.style.display = "block";
          quizContent.style.display = "none";
          progressContainer.style.display = "none";
          backButton.style.display = "none";
        } else {
          let prevId = questionHistory.pop();
          currentQuestion.style.display = "none";
          currentQuestion = document.getElementById(prevId);
          currentQuestion.style.display = "block";
          nextButton.setAttribute("disabled", "true");
          currentQuestionIndex--;
          updateProgress();
        }
      });
    }

    function updateProgress() {
      let progressPercent = ((currentQuestionIndex + 1) / totalQuestions) * 100;
      progressBar.style.width = progressPercent + "%";
    }

    // Handle retake buttons dynamically
    document.querySelectorAll('[id^="quiz-retake"]').forEach((button) => {
      button.addEventListener("click", function () {
        window.location.reload();
      });
    });

    document.querySelectorAll(".quiz-answer-box").forEach((box) => {
      box.addEventListener("click", function () {
        let radio = this.querySelector('input[type="radio"]');
        if (radio) {
          radio.checked = true;
          radio.dispatchEvent(new Event("change"));
        }
      });
    });

    document.querySelectorAll(".quiz-answer").forEach((input) => {
      input.addEventListener("change", function () {
        document.querySelectorAll(".quiz-answer-box").forEach((box) => {
          box.classList.remove("selected");
        });
        if (this.checked) {
          this.closest(".quiz-answer-box").classList.add("selected");
        }
      });
    });

    window.addEventListener("pageshow", function (event) {
      if (event.persisted || performance.navigation.type === 2) {
        location.reload();
      }
    });
    document.querySelectorAll(".quiz-preview").forEach((button) => {
      button.addEventListener("click", function () {
        // Hide all result sections
        document.querySelectorAll('[id^="quiz-result"]').forEach((result) => {
          result.style.display = "none";
        });

        // Show the quiz content again
        document.getElementById("quiz-content").style.display = "block";
        document.getElementById("quiz-progress-container").style.display =
          "block";

        // Re-enable navigation buttons
        document.getElementById("quiz-back").style.display = "inline-block";
        document.getElementById("quiz-next").removeAttribute("disabled");
        //updateProgress();
        // Scroll to the top of the page
        window.scrollTo({ top: 0, behavior: "smooth" });
      });
    });
  });
</script>

