    font-family: 'gibson-regular';
}
  #shopify-section-{{ section.id }} .site-footer-blocks {
    justify-content: space-between;
  }
  #shopify-section-{{ section.id }} .mail,
  #shopify-section-{{ section.id }} .phone{
    font-family: gibson-semibold;
  }

  #shopify-section-{{ section.id }} .site-footer-block-item {
