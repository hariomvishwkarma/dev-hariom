<style>
  .home-banner {
    background: rgb(208,220,233);
    background: linear-gradient(180deg, rgba(208,220,233,1) 0%, rgba(189,214,235,1) 100%);
    border-bottom: 20px solid #224058;
  }

  .home-banner .container {
    margin: 0 auto;
    padding: 0 25px;
    width: 1500px;
    max-width: 100%;
    display: flex;
    flex-wrap: wrap;
    align-items: center;

  }

  .home-banner .container .block-form {
    width: 340px;
    margin: 10px 20px 25px 0;
  }

  .home-banner .container .block-heading {
    width: calc(100% - 360px);
    text-align: left;
    //font-style: italic;
    padding: 115px 10px 115px;
    background: url(https://cdn.shopify.com/s/files/1/0665/1782/7878/files/home-banner-image2.png?v=1678173014) no-repeat bottom center;
    background-size: 80%;
    
  }

  @media (min-width: 1100px) {
    .home-banner .container .block-heading {
        max-width: 600px;
        //margin-left: 60px;
    }

    .home-banner .container {
      flex-wrap: nowrap;
      justify-content: space-between;
    }
  }

  .home-banner .container .block-heading h3, .home-banner .container .block-heading h2, .home-banner .container .block-heading a {
    //font-style: italic;
    font-weight: 800;
  }

  .home-banner .container .block-heading h3 {
    margin: 0 0 5px;
  }

  .home-banner .container .block-heading p {
    line-height: 1.5em;
  }

  .home-banner .container .block-heading h2 {
    margin: 0;
    font-size: 40px;
    color: #234b62;
    margin-top: 4px;
  }

  .btn-wrap {
    text-align: center;
    margin-top: 40px;
    display: flex;
    align-content: center;
    flex-wrap: wrap;
    //justify-content: center;
    align-items: center;
  }

  .home-banner .container .block-heading a.slideshow-slide__button {
    padding: 10px 40px;
    font-size: 24px;
    margin-top: 0px;
    margin-bottom: 20px;
  }

  .hb-form {
    padding: 40px 28px;
    background: white;
    margin: 0 auto;
  }

  .hb-form h4 {
    font-style: italic;
    text-align: center;
    margin: 0 0 15px;
    font-size: 22px;
  }

  .hb-form select {
    width: 100%;
    padding: 7px;
    margin-bottom: 15px;
    border: solid 1px #d4d4d4;
    border-radius: 5px;
    font-size: 15px;
  }

  .hb-form button, .hb-form input {
    width: 100%;
    margin: 0;
  }

  .hb-form label {
    display: block;
    text-align: center;
    font-size: 14px;
    margin-bottom: 5px;
  }

  .hb-footer {
    text-align: center;
  }

  .hb-reset {
    margin: 0;
    margin-top: 12px;
  }

  .hb-reset a {
    color: #02A8D2;
  }

  .hb-range {
    text-align: right;
  }

  #rangeValue {
    margin: 3px 0 0px;
    text-align: right;
    padding: 4px 6px;
    border: 1px solid rgb(233 233 233);
    display: inline-block;
    border-radius: 5px;
    font-weight: 700;
  }

  #rangeValue:before {
    content: '£';
    display: inline-block;
  }

  .home-banner input[type=range]::-webkit-slider-thumb, .home-banner input[type=range]::-moz-slider-thumb {
    background: #02A8D2;
  }

  .block-trust {
    display: none;
  }

  @media (min-width: 1100px) {
    .block-trust {
      margin-left: 0px;
      display: block;
      width: 290px;
    }
  }
  .home-banner-subtext{
    display: block;
    font-size: 12px;
  }

  @media (min-width: 1500px) {
    .block-trust {
      background: white;
      width: 290px;
      //margin-left: 110px;
    }
  }
  

  @media (max-width: 800px) {
    .home-banner .container .block {
      width: 100%!important;
    }

    .home-banner .container .block-heading {
      margin-top: 0px;
      padding-top: 40px;
    }

    .home-banner .container .block-heading h2 {
      font-size: 40px;
    }

  }
</style>

<section class="home-banner">
  <div class="container">
    <div class="block block-form">
      {% render 'entire-range-form' %}
    </div>
    <div class="block block-heading">
      {% comment %}<h3>THE BIGGEST DEALS ONLINE</h3>{% endcomment %}
      <h2>The UK's best rated Water Filter company.</h2>
      <h2>In stock. Next day delivery.</h2>
      <p>Serving thousands of customers for over twenty five years. Here's <a style="color: #234b62" href="/pages/why-buy-from-us">why you can trust us.</a></p>
</p>
 <div class="for_desk">
<!-- TrustBox widget - Micro Combo -->
<div class="trustpilot-widget" data-style-alignment="left" data-locale="en-GB" data-template-id="5419b6ffb0d04a076446a9af" data-businessunit-id="5ca5ac479121e1000152fa10" data-style-height="20px" data-style-width="100%" data-theme="light" style="margin-top: 25px; text-align: left">
  <a href="https://uk.trustpilot.com/review/www.uk-water-filters.co.uk" target="_blank" rel="noopener">Trustpilot</a>
</div>
<!-- End TrustBox widget -->
 </div>
      {% if section.settings.trustpilot != blank %}
      <div class="for_mob">
        <div class="trust_icon_image">
          <a href="https://uk.trustpilot.com/review/www.uk-water-filters.co.uk"  target="_blank">
           <img src="{{ section.settings.trustpilot | image_url: width: '700X'  }}">
          </a>
          {% comment %}
          <span class="subheading_tp" style="text-align:center;margin-top: 10px;">{{ section.settings.subheading_tp }}</span>
          {% endcomment %}
        </div>
        </div>
      {% endif %}
      
      <div class="btn-wrap">
      <a href="/pages/find-your-best-filter" class="slideshow-slide__button slideshow-slide__button--primary" style="margin-right: 15px">FIND YOUR PERFECT FILTER <br>IN 30 SECONDS</a>
      {% comment %}
      <a href="/pages/find-your-best-filter" class="button--secondary" style="color: black; text-decoration: none; font-size: 18px; margin-bottom: 20px;">Find your best filter</a>
      {% endcomment %}
      </div>
    </div>
    <div class="block block-trust">
      <img src="https://cdn.shopify.com/s/files/1/0665/1782/7878/files/banner-trust1.png?v=1678315027">
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Home Banner / Form",
  "settings": [
    {
      "id":"trustpilot",
      "type":"image_picker",
      "label":"Trustpilot Custom Image"
    },
        {
      "type": "text",
      "id": "subheading_tp",
      "label": "Subheading"
    }
  ],
  "presets": [
  {
    "name": "Home Banner",
    "category": "image"
  }
]
}
{% endschema %}

{% stylesheet %}
{% endstylesheet %}
