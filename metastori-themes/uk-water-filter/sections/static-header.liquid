<style>
  .tp-widget-businessinfo {
    display: inline-flex !important;
    grid-gap: 10px;
  }

  #shopify-section-{{ section.id }} .header-elements-wrapper {
    display: flex;
    justify-content: space-between;
    width: 100%;
    align-items: center;
  }

  #shopify-section-{{ section.id }} .site-header-main a {
    text-decoration: none;
    color: #2D4B60;
  }

  #shopify-section-{{ section.id }} .menu-phone-wrapper {
    display: none;
    align-items: center;
    padding-right: 10px;
    /* padding-right: 15px; */
  }

  #shopify-section-{{ section.id }} .phone-mobile svg {
    width: 21px;
    height: 21px;
  }

  #shopify-section-{{ section.id }} .live-search-form {
    border: unset;
  }

  #shopify-section-{{ section.id }} .live-search-form,
  #shopify-section-{{ section.id }} .live-search-form-field {
    box-shadow: none;
  }

  #shopify-section-{{ section.id }} .site-logo-image {
    margin-bottom: 0;
  }

  #shopify-section-{{ section.id }} .site-header-main {
    justify-content: space-between;
    max-width: 1515px;
    
  }

  #shopify-section-{{ section.id }} .site-header-right {
    margin: 0;
    gap: 20px;
    padding-left: 15px;
  }

  #shopify-section-{{ section.id }} .phone-header {
    align-items: center;
  }

  #shopify-section-{{ section.id }} .phone-header-caption {
    color: #02A8D2;
    font-size: 16px;
    font-weight: bold;
    margin-bottom: 3px;
    margin-top: 0;
  }

  #shopify-section-{{ section.id }} .contact-details,
  #shopify-section-{{ section.id }} .phone,
  #shopify-section-{{ section.id }} .mail {
    display: flex;
    align-items: center;
  }

  #shopify-section-{{ section.id }} .contact-details {
    gap: 15px;
  }

  #shopify-section-{{ section.id }} .contact-details div {
    font-size: 15px;
  }

  #shopify-section-{{ section.id }} .contact-details a {
    color: #2D4B60;
    font-weight: 600;
  }
  #shopify-section-{{ section.id }} .contact_variant_b .contact-details a {
    position: unset;
  }
  #shopify-section-{{ section.id }} .contact_variant_b .contact-details a::before {
    content: '';
    position: absolute;
    height: 100%;
    width: 100%;
    top: 0;
    left: 0;
    display: block;
  }
  #shopify-section-{{ section.id }} .phone,
  #shopify-section-{{ section.id }} .mail {
    gap: 10px;
  }

  #shopify-section-{{ section.id }} .site-header-reorder {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  #shopify-section-{{ section.id }} .site-header-actions {
    font-weight: unset;
    margin: 0;
  }

  #shopify-section-{{ section.id }} .site-header_account-link-anchor,
  #shopify-section-{{ section.id }} .site-header-reorder {
    flex-direction: column;
    gap: 5px;
  }

  #shopify-section-{{ section.id }} .site-header-actions .site-header_account-link-text {
    padding: 0;
  }

  #shopify-section-{{ section.id }} .site-header__account-icon {
    justify-content: center;
  }

  #shopify-section-{{ section.id }} .site-header-cart {
    display: block;
    position: relative;
  }

  #shopify-section-{{ section.id }} .site-header-logo,
  #shopify-section-{{ section.id }} .phone-header,
  #shopify-section-{{ section.id }} .live-search {
    margin: 0;
    padding: 0;
  }

  #shopify-section-{{ section.id }} .live-search-wrapper {
    margin-right: 15px;
    flex-basis: auto;
    flex-grow: 1;
    flex-shrink: 1;
    display: flex;
    justify-content: center;
    max-width: 440px;
  }

  #shopify-section-{{ section.id }} .site-header-cart {
    margin: 0;
    right: 0;
    top: 0;
    bottom: 0;
    height: unset;
  }

  #shopify-section-{{ section.id }} .site-header-cart--button {
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: 0;
    /* color: #2D4B60; */
    height: 100%;
    justify-content: space-between;
  }

  #shopify-section-{{ section.id }} .site-header-actions__account-link {
    margin-right: 0;
  }

  #shopify-section-{{ section.id }} .site-header-cart--count::after {
    background-color: #008CAF;
    height: 18px;
    min-width: 18px;
    line-height: 8px;
  }

  #shopify-section-{{ section.id }} .live-search-button {
    border-top-right-radius: 5px !important;
    border-bottom-right-radius: 5px !important;
    background: #91C03E;
    border-color: #91C03E;
  }

  #shopify-section-{{ section.id }} .phone-mobile {
    padding: 11px 10px;
    margin-left: 7px;
  }

  @media (max-width: 1200px) {
    #shopify-section-{{ section.id }} .reorder-caption,
    #shopify-section-{{ section.id }} .site-header_account-link-text,
    #shopify-section-{{ section.id }} .cart-caption,
    #shopify-section-{{ section.id }} .basket-caption{
      {% comment %} display: none; {% endcomment %}
    }

    .basket-caption {
    margin-top: 5px;
    }

    #shopify-section-{{ section.id }} .site-header-reorder {
      justify-content: center;
    }

    #shopify-section-{{ section.id }} .site-header-cart--button {
      justify-content: center;
    }

    #shopify-section-{{ section.id }} .site-header-cart--count {
      top: 0px;
    }
  }

  @media (max-width: 1023px) {
    #shopify-section-{{ section.id }} .header-elements-wrapper {
      display: grid;
      grid-template-columns: repeat(3, auto);
    }

    #shopify-section-{{ section.id }} .menu-phone-wrapper {
      display: flex;
      padding-left: 30px;
    }

    #shopify-section-{{ section.id }} .site-header-menu-toggle {
      display: block;
    }

    #shopify-section-{{ section.id }} .site-header-menu-toggle--button {
      margin-right: 0;
    }

    #shopify-section-{{ section.id }} .phone-mobile {
      display: block;
    }

    #shopify-section-{{ section.id }} .live-search-wrapper {
      order: 1;
      grid-column: 1 / 4;
      max-width: 100vw;
      margin-top: 20px;
      margin-right: 0;
    }

    #shopify-section-{{ section.id }} .site-header-right {
      display: flex;
      padding-right: 30px;
    }

    #shopify-section-{{ section.id }} .site-header-cart--count {
      top: -8px;
    }
  }
  @media screen and (max-width: 680px) {
    #shopify-section-{{ section.id }} .site-header-menu-toggle {
      position: static !important;
    }

    #shopify-section-{{ section.id }} .menu-phone-wrapper {
      padding-left: 0;
      padding-right: 0;
    }
    #shopify-section-{{ section.id }} .header_icon_main.site-header-right {
        padding-left: 6px;
    }

    #shopify-section-{{ section.id }} .site-header-right {
      padding-right: 0;
    }
    .subheading_tp{
      display: block !important;
      margin-top: 5px;
      color: #05A8D2;
      font-size: 14px;
      font-weight: 600;
    }
    .site-header-main .tp_custom{
      display: flex;
    }
  }

  @media screen and (max-width: 500px) {
    #shopify-section-{{ section.id }} .phone-mobile {
      margin-left: 0;
    }

    #shopify-section-{{ section.id }} .site-header-right {
      gap: 12px;
    }
  }
  @media screen and (max-width: 1024px) {
  .mini-trustpilot {
    display: none;
  }
}
    .mini-trustpilot {
    display: none;
  }  
</style>

{% assign has_box_shadow = false %}
{% if settings.color_background == settings.color_header_background %}
  {% assign has_box_shadow = true %}
{% endif %}

<script
  type="application/json"
  data-section-id="{{ section.id }}"
  data-section-type="static-header"
  data-section-data
>
  {
    "settings": {
      "sticky_header": {{ section.settings.sticky_header | json }},
      "has_box_shadow": {{ has_box_shadow | json }},
      "live_search": {
        "enable": {{ section.settings.enable_live_search | json }},
        "enable_images": {{ section.settings.enable_live_search_images | json }},
        "enable_content": {{ section.settings.enable_live_search_articles_pages | json }},
        "money_format": {{ shop.money_format | strip_html | json }},
        "show_mobile_search_bar": {{ section.settings.show_mobile_search_bar | json }},
        "context": {
          "view_all_results": {{ 'search.general.view_all_results' | t | json }},
          "view_all_products": {{ 'search.general.view_all_products' | t | json }},
          "content_results": {
            "title": {{ 'search.general.pages_and_posts_title' | t | json }},
            "no_results": {{ 'search.general.pages_and_posts_no_results' | t | json }}
          },
          "no_results_products": {
            "title": {{ 'search.general.no_results_products_title' | t: terms: '*terms*' | json }},
            "title_in_category": {{ 'search.general.no_results_products_title_in_category' | t: terms: '*terms*', category: '*category*' | json }},
            "message": {{ 'search.general.no_results_products_message' | t | json }}
          }
        }
      }
    }
  }
</script>

{% assign logo_height = section.settings.logo_height | default: 100 %}
{% assign logo_width = section.settings.logo_width | default: 200 %}
{% assign logo_size = logo_width | prepend: 'x' %}

{% style %}
  .site-logo {
    max-width: {{ logo_width }}px;
  }

  .site-logo-image {
    max-height: {{ logo_height }}px;
  }
{% endstyle %}

<div
  class="
    site-header-main
    {% if section.settings.full_width_header %}
      site-header--full-width
    {% endif %}
  "
  data-site-header-main
  {% if section.settings.sticky_header %}
    data-site-header-sticky
  {% endif %}
  {% if section.settings.show_mobile_search_bar %}
    data-site-header-mobile-search-bar
  {% else %}
    data-site-header-mobile-search-button
  {% endif %}
>
  <div class="header-elements-wrapper">
    <div class="menu-phone-wrapper">
      <button class="site-header-menu-toggle" data-menu-toggle>
        <div class="site-header-menu-toggle--button" tabindex="-1">
          <span class="toggle-icon--bar toggle-icon--bar-top"></span>
          <span class="toggle-icon--bar toggle-icon--bar-middle"></span>
          <span class="toggle-icon--bar toggle-icon--bar-bottom"></span>
          <span class="visually-hidden">{{ 'general.accessibility.menu' | t }}</span>
        </div>
      </button>
      <a class="phone-mobile" href="/pages/contact-us">
        {% render 'icon-phone' %}
      </a>
    </div>
    {% unless section.settings.show_mobile_search_bar %}
      {% capture search_button %}
        <div class="site-header-mobile-search-button--button" tabindex="-1">
          {% render 'icon-search' %}
        </div>
      {% endcapture %}
      {% if section.settings.enable_live_search %}
        <button
          class="site-header-mobile-search-button"
          data-mobile-search-button
        >
          {{ search_button }}
        </button>
      {% else %}
        <a
          class="site-header-mobile-search-button"
          href="{{ routes.search_url }}"
        >
          {{ search_button }}
        </a>
      {% endif %}
    {% endunless %}
    <div class="site-header-logo">
      <a
        class="site-logo{% if section.settings.mobile_logo != blank %} mobile_logo_main{% endif %}"
        href="{{ routes.root_url }}"
      >
        {% if section.settings.logo %}
          {% assign logo_alt = section.settings.logo.alt %}
          {% if logo_alt == '' %}
            {% assign logo_alt = shop.name | strip %}
          {% endif %}
          {% render 'rimg', img: section.settings.logo, class: 'site-logo-image desktop_logo', alt: logo_alt, size: logo_size %}
          
          {% if section.settings.mobile_logo != blank %}
            {% comment %} {% render 'rimg', img: section.settings.mobile_logo, class: 'site-logo-image mobile_logo', alt: logo_alt, size: logo_size %} {% endcomment %}
            {{
                section.settings.mobile_logo
                | image_url: height: nil
                | image_tag:
                  widths: '150, 200, 250, 300, 400',
                  loading: 'eager',
                  decoding: 'async',
                  class: 'site-logo-image mobile_logo',
                  alt: logo_alt,
                  height: nil
            }}
          {% endif %}
          
        {% else %}
          {% if template == 'index' %}
            <h1 class="site-logo-text">
              {{ shop.name }}
            </h1>
          {% else %}
            <span class="site-logo-text">
              {{ shop.name }}
            </span>
          {% endif %}
        {% endif %}
      </a>
    </div>
    {% comment %}
    <style>
      .trustpilot-header{
        padding: 0!important;
      }
      .trustpilot-header iframe {
        transform: scale(.6);
      }
      .trustpilot-header .trustpilot-widget {
         width: 235px;
      }
    </style>
    <div class="small-promo trustpilot-header">
      <div>
        <div
          class="trustpilot-widget"
          data-locale="en-GB"
          data-template-id="53aa8807dec7e10d38f59f32"
          data-businessunit-id="5ca5ac479121e1000152fa10"
          data-style-height="150px"
          data-style-width="100%"
          data-theme="light"
          style="height: 100px"
        >
          <a href="https://uk.trustpilot.com/review/www.uk-water-filters.co.uk" target="_blank" rel="noopener"></a>
        </div>

        <!-- <a href="https://uk.trustpilot.com/review/www.uk-water-filters.co.uk" target="_blank"> -->
        <!--
          <img class="variant-a" src="https://cdn.shopify.com/s/files/1/0665/1782/7878/files/Screenshot_2024-04-18_at_12.28.30_PM.png?v=1713423638">
          <img class="variant-b" src="https://cdn.shopify.com/s/files/1/0665/1782/7878/files/Screen_Shot_2024-04-18_at_3.51.46_PM.png?v=1713436396">
        -->
        <!-- </a> -->
      </div>
    </div>
    {% endcomment %}
    <div class="mini-trustpilot">
       <a href="https://www.trustpilot.com/review/www.uk-water-filters.co.uk">
      <img
        style="padding-left: 8px; width: 150px;"
        src="https://cdn.shopify.com/s/files/1/0665/1782/7878/files/gemini_generated_image_k0refgk0refgk0re_720.png?v=1776941148"
      >
       </a>
    </div>
    <div class="live-search-wrapper">
      <div class="for_mob">
        <a class="tp_custom" href="https://uk.trustpilot.com/review/www.uk-water-filters.co.uk">
          
          <img
            src="https://cdn.shopify.com/s/files/1/0665/1782/7878/files/Screenshot_2025-03-21_at_12.52.44_PM-removebg-preview_2.png?v=1742551369"
            height="auto"
            width="auto"
          >
        </a>
        <span class="subheading_tp" style="display: none;text-align:center;">{{ section.settings.subheading_tp }}</span>
      </div>
      <!-- End TrustBox widget -->
      {% render 'live-search-form',
        quick_links: linklists[section.settings.quick_links],
        enable_images: section.settings.enable_live_search_images,
        enable_content: section.settings.enable_live_search_articles_pages
      %}
    </div>
    {% if section.settings.small_promo_text != blank or section.settings.small_promo_heading != blank %}
      {% if section.settings.small_promo_link != blank %}
        <a
          class="small-promo-content--link"
          href="{{ section.settings.small_promo_link }}"
        >
      {% endif %}
      <div class="small-promo">
        {% if section.settings.small_promo_icon != 'none' or section.settings.image %}
          <span
            class="
              small-promo-icon
              {% if section.settings.image %}
                small-promo-icon--custom
              {% else %}
                small-promo-icon--svg
              {% endif %}
            "
          >
            {% if section.settings.image == blank %}
              {% render 'icon-library', id: section.settings.small_promo_icon %}
            {% else %}
              {% render 'rimg', class: 'small-promo-custom-icon', img: section.settings.image, size: '60x' %}
            {% endif %}
          </span>
        {% endif %}
        <div class="small-promo-content">
          {% if section.settings.small_promo_heading != blank %}
            <span class="small-promo-content_heading">
              {{ section.settings.small_promo_heading | escape }}
            </span>
          {% endif %}
          {% if section.settings.small_promo_text_mobile != blank %}
            <div class="small-promo-content--mobile">
              {{ section.settings.small_promo_text_mobile }}
            </div>
          {% endif %}
          {% if section.settings.small_promo_text != blank %}
            <div class="small-promo-content--desktop">
              {{ section.settings.small_promo_text }}
            </div>
          {% endif %}
        </div>
      </div>
      {% if section.settings.small_promo_link != blank %}
        </a>
      {% endif %}
    {% endif %}
     
    <div class="small-promo phone-header">
      <div class="content">
        <p class="phone-header-caption">Need help?</p>
        <div class="contact-details">
          <a class="phone" href="/pages/contact-us">
            <span>Get in touch now</span>
          </a>
        </div>
      </div>
      <img
        style="padding-left: 8px; width: 45px;"
        src="https://cdn.shopify.com/s/files/1/0665/1782/7878/files/50x50xko-jon-friendly-support-bg-smaller-round-alpha-white.png.pagespeed.ic.BQ_hsvMcO8.webp?v=1671416066"
      >
    </div>
    {% comment %} <div class="small-promo phone-header contact_variant_b" style="display: none;">
      <div class="content">
        <p class="phone-header-caption">Help & Advice</p>
        <div class="contact-details">
          <a class="phone" href="/pages/contact-us">
            {% render 'icon-phone' %}
            <div>Contact our team</div>
          </a>
        </div>
      </div>
      <img
        style="padding-left: 8px; width: 45px;"
        src="https://cdn.shopify.com/s/files/1/0665/1782/7878/files/50x50xko-jon-friendly-support-bg-smaller-round-alpha-white.png.pagespeed.ic.BQ_hsvMcO8.webp?v=1671416066"
      >
    </div> {% endcomment %}
    <div class="site-header-right header_icon_main">
      <a href="/pages/renew-your-filter" class="site-header-reorder">
        {% render 'icon-reorder' %}
        <div class="reorder-caption">Re-order</div>
      </a>
      {% comment %} <a href="/account" class="site-header-reorder account-in-header">
        {% render 'icon-account-new' %}
        <div class="reorder-caption">Account</div>
      </a> {% endcomment %}
      
      {% comment %} {% render 'site-header-actions' %} {% endcomment %}
      <a href="{{ routes.cart_url }}" class="site-header-cart">
        <div class="site-header-cart--button">
          <div class="cart-icon-wrapper">
            <div
              class="site-header-cart--count {% if cart.item_count > 0 %}visible{% endif %}"
              data-header-cart-count="{% if cart.item_count > 0 %}{{ cart.item_count }}{% endif %}"
            ></div>
            <div class="site-header-cart-icon site-header-cart-icon--svg">
              {% render 'icon-cart-new' %}
            </div>
          </div>
          <div class="basket-caption">Basket</div>
          <div class="cart-caption" id="cart_total" style='display:none;'>{{ cart.total_price | money_without_trailing_zeros }}</div>
        </div>
      </a>
    </div>
  </div>
</div>

<div
  class="
    site-navigation-wrapper
    {% if shop.customer_accounts_enabled %}
      site-navigation--has-actions
    {% endif %}
    {% if section.settings.full_width_header %}
      site-header--full-width
    {% endif %}
  "
  data-site-navigation
  id="site-header-nav"
>
  <nav
    class="site-navigation"
    aria-label="{{ 'general.accessibility.nav_main' | t }}"
  >
    {% render 'navmenu', menu: section.settings.menu, blocks: section.blocks, section: section %}

    {% if section.settings.secondary_menu != blank %}
      {% render 'navlist',
        menu_list: linklists[section.settings.secondary_menu].links,
        depth: 1,
        max_depth: 1,
        aria_expanded: true,
        navmenu_classes: 'site-navigation__secondary-menu'
      %}
    {% endif %}
    
  </nav>
</div>

{% render 'site-mobile-nav', blocks: section.blocks %}

{% schema %}
{
  "name": "t:sections.header.name",
  "class": "site-header-wrapper",
  "settings": [
    {
      "type": "checkbox",
      "id": "sticky_header",
      "label": "t:sections.header.sticky_header.label",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "full_width_header",
      "label": "t:sections.header.full_width_header.label",
      "default": false
    },
    {
      "type": "image_picker",
      "id": "logo",
      "label": "t:sections.header.logo.label",
      "info": "t:sections.header.logo.info"
    },
    {
      "type": "image_picker",
      "id": "mobile_logo",
      "label": "Mobile logo"
    },
    {
      "type": "range",
      "id": "logo_height",
      "label": "t:sections.header.logo_height.label",
      "min": 40,
      "max": 120,
      "step": 2,
      "unit": "px",
      "default": 100
    },
    {
      "type": "range",
      "id": "logo_width",
      "label": "t:sections.header.logo_width.label",
      "min": 150,
      "max": 500,
      "step": 5,
      "unit": "px",
      "default": 200,
      "info": "t:sections.header.logo_width.info"
    },
    {
      "type": "header",
      "content": "t:sections.header.header_1.content"
    },
    {
      "type": "select",
      "id": "filter_search_by",
      "label": "t:sections.header.filter_search_by.label",
      "info": "t:sections.header.filter_search_by.info",
      "options": [
        {
          "value": "disabled",
          "label": "t:sections.header.filter_search_by.option_1"
        },
        {
          "value": "product_type",
          "label": "t:sections.header.filter_search_by.option_2"
        },
        {
          "value": "tag",
          "label": "t:sections.header.filter_search_by.option_3"
        }
      ],
      "default": "disabled"
    },
    {
      "type": "checkbox",
      "id": "enable_live_search",
      "label": "t:sections.header.enable_live_search.label",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_mobile_search_bar",
      "label": "t:sections.header.show_mobile_search_bar.label",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "enable_live_search_images",
      "label": "t:sections.header.enable_live_search_images.label",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "enable_live_search_articles_pages",
      "label": "t:sections.header.enable_live_search_articles_pages.label",
      "default": true
    },
    {
      "type": "link_list",
      "id": "quick_links",
      "label": "t:sections.header.quick_links.label",
      "info": "t:sections.header.quick_links.info"
    },
