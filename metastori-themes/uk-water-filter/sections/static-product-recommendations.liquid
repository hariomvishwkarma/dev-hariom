<script src="{{ 'flickity-init-cart-page.js' | asset_url }}"></script>

<style>
  #shopify-section-{{ section.id }} {
    background:{{section.settings.bg_color}};
    padding-top: {{ section.settings.padding-top }}px;
    padding-bottom: {{ section.settings.padding-bottom }}px;
  }

  .product-recommendations--container{
    max-width:100%;
    width:100%;
    overflow: hidden;
  }

  #shopify-section-{{ section.id }} .product-section--title {
    font-size: 32px;
    font-weight: 700;
    font-style: unset;
    color: #001F3C;
    margin-top:0;
    margin-bottom:0;
    text-transform: capitalize;
  }
     
  #shopify-section-{{ section.id }} .related-collections-wrapper {
    display: flex;
    flex-wrap: wrap;
    font-size: 17px;
    font-weight: bold;
    justify-content: center;
    align-items: center;
    gap: 10px;
    text-align: center;
    margin: 56px 0;
  }

  #shopify-section-{{ section.id }} .related-collection {
    color: #253F4B;
  }


  #shopify-section-{{ section.id }} .related-collection a {
    background: #fff;
    font-size: 14px;
    text-decoration: none;
    color: #001F3C;
    padding: 20px 40px;
    display: inline-block;
    border: 1px solid #253F4B;
    border-radius: 4px;
  }
     
  #shopify-section-{{ section.id }} .product-section--content {
    margin-top: 50px;
    margin-bottom:0;
    background: #fff;
    padding: 16px 0 16px 24px;
  }

  #shopify-section-{{ section.id }} .flickity-page-dots {
    bottom: 30px !important;
  }
     
  #shopify-section-{{ section.id }} .related-collection-elements {
    display: flex;
    gap: 10px;
  }

  #shopify-section-{{ section.id }} .product-grid-item{
    margin-left: 24px;
    margin-right: 0px;
    max-width:280px;
  }
  #shopify-section-{{ section.id }} .productgrid--item{
    max-width:15.87%;
  }
  .product-recommendations--container .flickity-viewport {
    padding-left: 24px;
  }
  @media screen and (max-width: 1250px) {
    #shopify-section-{{ section.id }} .related-collections-wrapper {
      /* display: block; */
    }

    #shopify-section-{{ section.id }} .related-collections-caption {
      margin-bottom: 20px;
      text-align: start;
    }

    #shopify-section-{{ section.id }} .related-collection-elements {
      display: flex;
      flex-wrap: wrap;
      gap: 10px;
    }

    #shopify-section-{{ section.id }} .flickity-page-dots {
      bottom: -25px;
    }
    
  }

  @media screen and (max-width: 1025px) {
    #shopify-section-{{ section.id }} .product-section--title {
      font-size: 22px;
    }
    #shopify-section-{{ section.id }} .related-collections-wrapper {
      font-size: 13px;
    }
    #shopify-section-{{ section.id }} .productgrid--item{
      max-width:80%;
    }
    #shopify-section-{{ section.id }} .related-collection-elements{
      justify-content: center;
    }
    
  }

  @media screen and (max-width: 989px) {
    #shopify-section-{{ section.id }} {
      padding-top: {{ section.settings.padding-top | divided_by: 2 }}px;
      padding-bottom: {{ section.settings.padding-bottom | divided_by: 2 }}px;
    }
  }

  @media screen and (max-width: 768px) {
    #shopify-section-{{ section.id }} .related-collections-wrapper {
      margin: 20px 0;
      flex-wrap: nowrap;
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      justify-content: start;
      margin-right: -15px;
      padding-right: 10px;
      padding-bottom: 10px;
      
    }
    #shopify-section-{{ section.id }} .related-collection-elements{
      scroll-snap-align: start;
      scroll-snap-stop: normal;
      flex-shrink: 0;
      padding: 0 10px;
    }
    #shopify-section-template--24877795311910__recommendations .product-section--content {
      margin-top: 20px;
    }
    .product-recommendations--container .flickity-viewport {
      padding-left: 15px;
    }
      #shopify-section-{{ section.id }} .product-section--content {
        padding-left:0;
      }
  }
</style>

{% if section.settings.show_product_recommendations %}
  {% assign product_limit = 15 %}

  <script
    type="application/json"
    data-section-type="static-product-recommendations"
    data-section-id="{{ section.id }}"
    data-section-data
    >
{
  "settings": {
    "limit": {{ product_limit }}
  },
    "productId": {{ product.id | json }},
    "sectionId": {{ section.id | json }}
}
  </script>

  {% assign related_collections = product.metafields.custom.related_collection.value %}

  <section
    class="product-recommendations--container"
    data-html
    data-product-recommendations
    >
    {% if recommendations.products_count > 0 %}
      <h2 class="product-section--title product-recommendations--title">
        {{ section.settings.product_recommendations_heading }}
      </h2>

      {% if related_collections != blank %}
      <div class="related-collections-wrapper">
        <div class="related-collections-caption" style="display:none;">Related Categories:</div>
        <div class="related-collection-elements">
          {% for collection in related_collections %}
            <div class="related-collection"><a href="{{ collection.url }}" title">{{ collection.title }}</a></div>
          {% endfor %}
        </div>
      </div>
      {% endif %}

    <ul
      class="product-section--content product-row recommended-products-carousel"
      data-product-row
      >
      {% for product in recommendations.products %}
          {%
            render 'product-grid-item',
            product: product
          %}
      {% endfor %}
    </ul>
    {% endif %}
  </section>

  {% render 'quick-shop' %}
{% endif %}

{% schema %}
{
  "name": "t:sections.product_recommendations.name",
  "class": "product-recommendations--section",
  "settings": [
    {
      "type": "checkbox",
      "id": "show_product_recommendations",
      "label": "t:sections.product_recommendations.show_product_recommendations.label",
      "info": "t:sections.product_recommendations.show_product_recommendations.info",
      "default": true
    },
    {
      "type": "text",
      "id": "product_recommendations_heading",
      "label": "t:sections.product_recommendations.product_recommendations_heading.label",
      "default": "You may also like"
    },
    {
      "type":"color",
      "id":"bg_color",
      "label":"Background Color"
    },
    {
      "type": "checkbox",
      "id": "full_width",
      "label": "Full width"
    },
    {
      "type": "select",
      "id": "layout",
      "label": "t:sections.featured_collection.layout.label",
      "options": [
        {
          "value": "grid",
          "label": "t:sections.featured_collection.layout.option_1"
        },
        {
          "value": "slideshow",
          "label": "t:sections.featured_collection.layout.option_2"
        }
      ],
      "default": "grid"
    },
    {
      "type": "checkbox",
      "id": "enable_autoplay",
      "label": "Enable autoplay"
    },
    {
      "type": "range",
      "id": "autoplay_speed",
      "min": 1,
      "max": 20,
      "step": 1,
      "unit": "sec",
      "label": "Autoplay speed",
      "default": 2
    },
    {
      "type": "range",
      "id": "padding-top",
      "label": "Padding top",
      "min": 0,
      "step": 2,
      "max": 200,
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-bottom",
      "label": "Padding bottom",
      "min": 0,
      "step": 2,
      "max": 200,
      "default": 0
    }
  ]
}
{% endschema %}