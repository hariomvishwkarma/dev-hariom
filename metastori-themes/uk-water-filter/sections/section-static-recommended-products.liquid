<script src="{{ 'flickity-init-cart-page.js' | asset_url }}" defer="defer"></script>

<style>
  #shopify-section-{{ section.id }} {
    padding-top: {{ section.settings.padding-top }}px;
    padding-bottom: {{ section.settings.padding-bottom }}px;
  }

  #shopify-section-{{ section.id }} .title-wrapper {
    display: flex;
    align-items: center;
    margin-bottom: 40px;
  }

  #shopify-section-{{ section.id }} .title {
    font-size: 32px;
    white-space: nowrap;
    margin-right: 20px;
  }

  #shopify-section-{{ section.id }} .title-hr {
    width: 100%;
    height: 2px;
    background: #02A8D2;
    border: none;
  }

</style>

<section class="static-recommended-products page-width">
  <div class="title-wrapper">
    <div class="title">{{ section.settings.title }}</div>
    <hr class="title-hr">
  </div>
  <div class="recommended-products-carousel">
    {% for block in section.blocks %}
      <div class="recommended-product">
        {%
          render 'product-grid-item-custom',
          product: block.settings.product
        %}
      </div>
    {% endfor %}
  </div>
</section>

{% schema %}
{
  "name": "Static Recommended Prod",
  "presets": [
  {
   "name":"Static Recommended Prod"
  }
  ],
  "settings": [
		{
      "type": "text",
      "id": "title",
      "label": "Title"
    },
		{
      "type": "range",
      "id": "title-height",
      "label": "Product title height",
      "info": "Set up based on product with longest title",
      "min": 0,
      "max": 100,
      "default": 0
    },
		{
      "type": "range",
      "id": "padding-top",
      "label": "Padding top",
      "min": 0,
      "step": 5,
      "max": 200,
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-bottom",
      "label": "Padding bottom",
      "min": 0,
      "step": 5,
      "max": 200,
      "default": 0
    }
  ],
  "blocks": [
     {
       "name": "Recommended Products",
       "type": "recommended-products",
       "settings": [
         {
           "type": "product",
           "id": "product",
           "label": "Product"
         }
       ]
     }
   ]
}
{% endschema %}