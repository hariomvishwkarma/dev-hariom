<style>
  #shopify-section-{{ section.id }} {
    padding-top: {{ section.settings.padding-top }}px;
    padding-bottom: {{ section.settings.padding-bottom }}px;
    background-image: url('{{ section.settings.background_img | image_url: width: 2000 }}');
    background-position: center;
    background-repeat: no-repeat;
    background-size: cover;
  }

  #shopify-section-{{ section.id }} .section-banner {
    padding-top: 50px;
    padding-bottom: 50px;
  }

  #shopify-section-{{ section.id }} .content-wrapper {
    background-color: #FFFFFF;
    padding: 50px;
    max-width: 500px;
    padding-top: 50px;
    padding-bottom: 50px;
    margin-left: auto;
    position: relative;
    right: 5%;
  }

  #shopify-section-{{ section.id }} .banner--title {
    font-size: 32px;
    font-weight: bold;
    margin-bottom: 25px;
  }

  #shopify-section-{{ section.id }} .banner--bullet-points {
    display: flex;
    flex-direction: column;
    gap: 15px;
    margin-bottom: 25px;
  }

  #shopify-section-{{ section.id }} .bullet-point {
    display: flex;
    gap: 25px;
  }

  #shopify-section-{{ section.id }} .bullet-point .img__wrapper {
    width: 30px;
  }

  #shopify-section-{{ section.id }} .bullet-point-content-wrapper .title {
    font-weight: bold;
  }

  #shopify-section-{{ section.id }} .banner--button-wrapper {
    text-align: center;
    font-size: 20px;
    background: #02A8D2;
    padding: 10px;
    margin-bottom: 25px;
    border-radius: 7px;
  }

  #shopify-section-{{ section.id }} .banner--button-wrapper a {
    color: white;
    text-decoration: unset;
    font-weight: bold;
  }

  #shopify-section-{{ section.id }} .trustpilot-widget {
    pointer-events: none;
  }

  @media (max-width: 719px) {
    #shopify-section-{{ section.id }} .content-wrapper {
      margin: 0 auto;
      position: static;
      padding: 30px;
      background-position: left;
    }
  }
</style>

<div class="page-width section-banner">
  <div class="content-wrapper">
    <div class="banner--title">{{ section.settings.title }}</div>
    <div class="banner--bullet-points">
      {% for block in section.blocks %}
        <div class="bullet-point">
        {%- if block.settings.img != blank -%}
          <div class="img__wrapper">
            {%- assign img_height = block.settings.img.width | divided_by: block.settings.img.aspect_ratio -%}
        
            {{ block.settings.img | image_url: width: 1000 | image_tag:
              height: img_height,
              width: block.settings.img.width,
              loading: 'lazy'
            }}
          </div>
          <div class="bullet-point-content-wrapper">
            {% if block.settings.title %}
              <div class="title">{{ block.settings.title }}</div>
            {% endif %}
            {% if block.settings.text %}
              <div class="text">{{ block.settings.text }}</div>
            {% endif %}
          </div>
        {%- endif -%}
        </div>
      {% endfor %}
    </div>
    <div class="banner--button-wrapper">
      <a href="{{ section.settings.btn_link.url }}">{{ section.settings.btn_text }}</a>
    </div>
    <!-- TrustBox widget - Micro Star -->
    <div class="trustpilot-widget" data-locale="en-US" data-template-id="5419b732fbfb950b10de65e5" data-businessunit-id="5ca5ac479121e1000152fa10" data-style-height="24px" data-style-width="100%" data-theme="light">
      <a href="https://www.trustpilot.com/review/www.uk-water-filters.co.uk" target="_blank" rel="noopener">Trustpilot</a>
    </div>
    <!-- End TrustBox widget -->
  </div>
</div>

{% schema %}
{
  "name": "Banner",
  "class": "banner-section",
  "presets": [
  {
   "name":"Banner"
  }
  ],
  "settings": [
    {
      "type": "image_picker",
      "id": "background_img",
      "label": "Background image"
    },
		{ "type": "text",
      "id": "title",
      "label": "Title"
    },
		{
      "type": "text",
      "id": "btn_text",
      "label": "Button Text"
    },
		{
      "type": "url",
      "id": "btn_link",
      "label": "Button link"
    }
  ],
  "blocks": [
     {
       "name": "Bullet point",
       "type": "bullet-point",
       "settings": [
         {
           "type": "image_picker",
           "id": "img",
           "label": "Image"
         },
         {
           "type": "text",
           "id": "title",
           "label": "Title"
         },
         {
           "type": "text",
           "id": "text",
           "label": "Text"
         }
       ]
     }
   ]
}
{% endschema %}