<style>
    #shopify-section-{{ section.id }} {
      background: #F1F8FC;
    }

    #shopify-section-{{ section.id }} .benefit-bar__content {
      align-items: center;
    }

    #shopify-section-{{ section.id }} .seperation-line , .custom-seperation-line {
      font-size: 24px;
      color: #b5b5b5;
    }
     #shopify-section-{{ section.id }} .seperation-line:last-child {
             display: none;
      }
    .custom-Image-a ,
    .custom-Image-b {
      display: flex;
      justify-content: center;
      align-items: center;
      vertical-align: middle;
      padding: 14px;
  }
    .custom-Image-a img ,
    .custom-Image-b img{
      height: auto;
      max-width: 380px;
    }
    .custom-Image-b.benefit--item a svg {
      width: 100%;
    }
    @media screen and (max-width: 1250px) {
    #shopify-section-{{ section.id }} .seperation-line , .custom-seperation-line {
      display: none;
    }
  }
    @media screen and (max-width: 769px) {
    #shopify-section-{{ section.id }} .benefit-bar__content {
      padding-left: 0;
      padding-right: 0;
    }
    .custom-Image-a img ,
    .custom-Image-b img{
      max-width: 320px;
    }
    .benefit--item.last_hide{
      display:none !important
    }
    .custom-Image-b.benefit--item{
      display: flex !important;
      flex-wrap: nowrap;
      justify-content: center;
      align-items: center;
      white-space: nowrap;
      padding: 8px 4px;
      gap: 4px;
    }
    .custom-Image-b.benefit--item img {
      flex-shrink: 0;
      max-width: none;
      margin: 0 !important;
      height: 16px !important;
    }
    .custom-Image-b.benefit--item span {
      font-size: 13px !important;
      white-space: nowrap;
      flex-shrink: 0;
    }
    .custom-Image-b.benefit--item .benefit-trustpilot-logo {
      display: inline-block !important;
      height: 14px !important;
    }
  }

  @media screen and (max-width: 360px) {
    .custom-Image-b.benefit--item {
      gap: 3px;
      padding: 8px 2px;
    }
    .custom-Image-b.benefit--item span {
      font-size: 12px !important;
    }
    .custom-Image-b.benefit--item img {
      height: 14px !important;
    }
    .custom-Image-b.benefit--item .benefit-trustpilot-logo {
      height: 12px !important;
    }
  }
</style>
<section class="benefit-bar">
  <div class="site-footer-item">
    <div
      class="benefit-bar__content"
      data-flickity='{ "cellAlign": "left", "contain": true, "watchCSS": true, "prevNextButtons": false, "pageDots": false, "autoPlay": 0 }'
    >
      {% for block in section.blocks %}
        {% if forloop.index == 1 %}
          <div class="custom-Image-b benefit--item" style="display:none;">
            <img src="https://cdn.shopify.com/s/files/1/0665/1782/7878/files/5-tp-stars_6942b3a683b27_50479fcf-6452-434e-8a8d-070a9a17f0e5.png?v=1780926372" alt="5 Star Rating" style="height:20px; margin-right:7px; margin-bottom:-1px;">
            <span>
              from
              <a href="https://uk.trustpilot.com/review/www.uk-water-filters.co.uk?stars=5" target="_blank" style="text-decoration:underline; color:rgb(0,31,60);">
                9000+ Reviews!
              </a>
            </span>
            <img src="https://cdn.shopify.com/s/files/1/0665/1782/7878/files/tp-logo-trans_6942b3b559c61_89a75f28-a31d-4f04-82d2-109f5eee47d7.png?v=1780926441" class="benefit-trustpilot-logo" alt="Trustpilot" style="height:16px; margin-left:7px; margin-bottom:0;">
          </div>
          <div class="custom-seperation-line mobile_hidden" style="display:none">|</div>
        {% endif %}
        <div class="benefit--item{% if forloop.last %} last_hide{% endif %}" style="position: relative">
          {% render 'benefit--icon', block: block %}
          {{ block.settings.text }}
          {% if block.settings.link != blank %}
            <a href="{{ block.settings.link }}" style="position: absolute; top: 0; left: 0; bottom: 0; right: 0"></a>
          {% endif %}
        </div>
        {% unless forloop.last %}
          <div class="seperation-line mobile_hidden{% if forloop.index == 4 %} last_hide{% endif %}">|</div>
        {% endunless %}
      {% endfor %}
    </div>
  </div>
</section>
<script>
  if (window.innerWidth < 1250) {
    var parentElement = document.querySelector('.benefit-bar__content');
    var customeline = document.querySelector('.custom-seperation-line');
    var seperationLines = parentElement.querySelectorAll('.seperation-line');
    customeline.remove();
    seperationLines.forEach(function(line) {
      line.remove();
    });
  }
</script>
{% schema %}
{
  "name": "Benefits Bar",
  "settings": [],
  "blocks": [
  {
    "type": "benefit",
    "name": "benefit",
    "settings": [
      {
        "id": "text",
        "type": "html",
        "label": "Text"
      },
      {
        "id": "link",
        "type": "url",
        "label": "Link"
      },
      {
        "type": "select",
        "id": "icon",
        "label": "Icon",
        "options": [
          {
            "value": "customers",
            "label": "Customers"
          },
          {
            "value": "delivery",
            "label": "Delivery"
          },
          {
            "value": "guarantee",
            "label": "Guarantee"
          },
          {
            "value": "trust",
            "label": "Trust"
          },
          {
            "value": "free_return",
            "label": "Return"
          },
          {
            "value": "",
            "label": "none"
          }
        ],
        "default": "customers"
      },
      {
        "id": "mobile_hidden",
        "type": "checkbox",
        "label": "Hide on mobile"
      }
    ]
  }
]
}
{% endschema %}

