<style>
    .section_{{ section.id }}.image-text-section {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }

    .image-text-wrapper {
      display: flex;
      flex-wrap: wrap;
    }

    .image-text-wrapper.left .image {
      order: 0;
    }

    .image-text-wrapper.right .image {
      order: 1;
    }

    .image-text-wrapper.left .content {
      order: 1;
    }

    .image-text-wrapper.right .content {
      order: 0;
    }

    .image {
      flex: 1 1 50%;
    }

    .image img {
      width: 100%;
      height: 100%;
      object-fit: cover;
    }

    .section_{{ section.id }} .content {
      display: flex;
      align-items: center;
      background-color: {{ section.settings.bg_color }};
    }
    .image-text-wrapper .image,
    .image-text-wrapper .content{
      width: 50%;
    }

    .content-inner {
      width: 100%;
      padding-top: 30px;
      padding-bottom: 30px;
    }

    .content-inner .subheading {
      font-size: 1.1rem;
      color: #00a6db;
      margin-bottom: 10px;
      font-weight: 600;
    }

    .content-inner .heading h2 {
      font-size: 54px;
      line-height: 1.33;
      margin-top: 20px;
      letter-spacing: normal;
      font-family: 'gibson-medium';
    }

    .content-inner .heading h2 strong {
        color: #02A8D2;
    }

    .content-inner .text p {
        font-size: 18px;
        margin-bottom: 48px;
    }

    a.button-primary.image_text_button {
        min-width: 288px;
        min-height: 50px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 24px;
        padding: 16px;
        text-transform: none;
        font-size: 16px !important;
    }

    a.image_text_button_t {
        color: #001F3C;
        text-decoration: none;
        font-family: gibson-semibold;
        font-size: 16px;
    }

    .content-inner .text {
      line-height: 1.4;
      margin-bottom: 20px;
    }
    .content-inner.padding-left {
      padding-left: max(calc((100vw - {{ settings.layout_max_width }}px) / 2 + 15px), 25px);
      padding-right: 60px;
    }

    .content-inner.padding-right {
      padding-right: max(calc((100vw - {{ settings.layout_max_width }}px) / 2 + 15px), 25px);
      padding-left: 60px;
    }
    .image_text_buttons {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      gap: 24px;
    }

    .content-inner .text ol li strong {
      font-size: 24px;
      padding-left: 25px;
    }

    .content-inner .text ol li em {
        font-style: normal;
        margin: 25px 0;
        display: block;
        font-size: 14px;
    }

    .content-inner .text ol {
        display: flex;
        flex-direction: column;
        gap: 55px;
        counter-reset: item;
        list-style: none;
        margin: 0;
        padding: 0;
    }

    .content-inner .text ol li br {
        display: none;
    }

    .content-inner .text ol li a {
        color: #001F3C;
        font-family: 'gibson-semibold';
        font-size: 14px;
    }

    .content-inner .text ol li {
      counter-increment: item;
      position: relative;
    }

    .content-inner .text ol li::before {
      content: counter(item) ".";
      position: absolute;
      left: 0;
      top: 0;
      font-weight: bold;
      line-height: 1.4;
      font-size: 24px;
      color: #02A8D2;
      font-family: 'gibson-semibold';
      display: flex;
    }
    .content-inner .text {
      line-height: 1.4;
      margin-bottom: 20px;
    }
    .content-inner .text a {
      color: #001f3c;
      font-family: 'gibson-semibold';
      font-size: 16px;
    }
    .badge_images {
      position: absolute;
      top: 37%;
      right: max(calc((100vw - 1515px) / 2 + 25px), 25px);
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 24px;
    }

    .image-text-wrapper .image {
        position: relative;
    }

    .image .badge_images img {
        width: auto;
    }
    .content-inner .text_main.text em {
      font-weight: bold;
      line-height: 1.4;
      font-size: 24px;
      color: #02A8D2;
      font-family: 'gibson-semibold';
    }
    .content-inner .text_main.text p strong {
      font-style: normal;
      font-size: 24px;
    }
    .text_with_icon_single {
      display: flex;
      gap: 32px;
    }
    
    .content-inner .text_main.text p {
        margin-top: 0;
        font-size: 14px;
    }
    
    .text_main.text {
        max-width: calc(100% - 88px);
    }

    /* ===== Checklist / Value Props Styles ===== */
    .section_{{ section.id }} .hero-checklist {
      margin-bottom: 32px;
    }

    .section_{{ section.id }} .hero-checklist-item {
      font-size: 18px;
      line-height: 1.7;
      color: #001F3C;
    }

    .section_{{ section.id }} .hero-checklist-item strong {
      font-family: 'gibson-semibold', sans-serif;
    }

    .section_{{ section.id }} .hero-checklist-item img.tp-stars {
      height: 18px;
      margin: 0 5px -3px 5px;
    }

    .section_{{ section.id }} .hero-checklist-item img.tp-logo {
      height: 18px;
      margin: 0 0 -5px 5px;
    }

    .section_{{ section.id }} .hero-checklist-item a {
      text-decoration: underline;
      color: #001F3C;
      font-size: 18px;
    }

    .section_{{ section.id }} .hero-checklist-item a:hover {
      color: #02a8d2;
    }

    /* ===== Button 2 underline style for checklist variant ===== */
    .section_{{ section.id }} a.image_text_button_t {
      text-decoration: underline;
      font-size: 18px;
    }

    .section_{{ section.id }} a.image_text_button_t:hover {
      color: #02a8d2;
    }

    @media (max-width: 1299px) {
      .content-inner .heading h2 {
        font-size: 32px;
        margin-top: 5px;
        margin-bottom: 20px;
      }
      .content-inner .text p {
        font-size: 15px;
        margin-bottom: 30px;
      }
      .content-inner.padding-left {
        padding-right: 30px;
      }
      .content-inner.padding-right {
        padding-left: 30px;
      }
      .badge_images {
        gap: 15px;
      }
      .image .badge_images img {
        max-width: 80px;
      }
      .image .badge_images img:last-child {
        max-width: 100px;
      }
      .section_{{ section.id }} .hero-checklist-item {
        font-size: 16px;
      }
      .section_{{ section.id }} .hero-checklist-item a {
        font-size: 16px;
      }
    }
    @media (max-width: 768px) {
      .image-text-wrapper.right {
        flex-direction: column-reverse;
      }

      .image, .content {
        order: unset !important;
      }
      .content-inner.padding-left,
      .content-inner.padding-right {
        padding-left: 15px;
        padding-right: 15px;
      }
      .image-text-wrapper .image, .image-text-wrapper .content {
          width: 100%;
      }
      .content-inner {
        padding-top: 20px;
      }
      .content-inner .heading h2 {
        font-size: 36px;
        margin-top: 0;
        margin-bottom: 24px;
      }
      .content-inner .text p {
          font-size: 16px;
          margin-bottom: 28px;
      }
      .image_text_buttons {
        gap: 20px;
      }
      .content-inner .text ol {
          gap: 30px;
      }

      .content-inner .text ol li em {
          margin: 15px 0;
      }

      .content-inner .text ol li strong {
          padding-left: 20px;
          font-size: 19px;
      }

      .content-inner .text ol li::before {
          font-size: 19px;
      }
      .image-text-section {
        padding-top: {{ section.settings.padding_top | divided_by: 2.0 }}px;
        padding-bottom: {{ section.settings.padding_bottom | divided_by: 2.0 }}px;
      }
      .content-inner{
        padding-bottom: 0;
      }
      .image-text-wrapper.right .image {
        padding-top: 100px;
      }
      .badge_images {
        flex-direction: row;
        transform: translateX(-50%);
        left: 50%;
        display: flex;
        top: 40px;
        justify-content: center;
        gap: 40px;
      }
      .image .badge_images img {
        max-width: 112px;
      }
      .image .badge_images img:last-child {
        max-width: 150px;
      }
      .image_text_buttons {
        justify-content: center;
      }
      a.button-primary.image_text_button {
        min-width: min(343px, 100%);
        max-width: 100%;
        box-sizing: border-box;
      }
      .text_with_icon_single {
        display: block;
        text-align: center;
      }
      .text_main.text {
        max-width: 100%;
        margin-top: 23px;
      }
      .section_{{ section.id }} .hero-checklist-item {
        font-size: 15px;
      }
      .section_{{ section.id }} .hero-checklist-item a {
        font-size: 15px;
      }
    }
</style>

<section class="image-text-section section_{{ section.id }} {{ section.settings.section_class }}">
  <div class="image-text-wrapper {% if section.settings.image_position == 'right' %}right{% else %}left{% endif %}">
    {% if section.settings.image != blank %}
      <div class="image">
        {{ section.settings.image
          | image_url: width: 1500
          | image_tag:
            widths: '375, 420, 550, 750, 1100, 1500',
            sizes: '(min-width: 1200px) 1500px, 100vw',
            loading: 'lazy',
            decoding: 'async',
            alt: section.settings.image.alt | default: section.settings.heading
        }}
        {% if section.settings.badge_image_1 != blank or section.settings.badge_image_2 != blank %}
          <div class="badge_images">
            {% if section.settings.badge_image_1 != blank %}
              {{
                section.settings.badge_image_1
                | image_url: width: 200
                | image_tag:
                  widths: '100, 150, 200',
                  sizes: '100px',
                  loading: 'lazy',
                  decoding: 'async',
                  alt: section.settings.badge_image_1.alt
                }}
            {% endif %}
        
            {% if section.settings.badge_image_2 != blank %}
              {{
                section.settings.badge_image_2
                | image_url: width: 200
                | image_tag:
                  widths: '100, 150, 200',
                  sizes: '100px',
                  loading: 'lazy',
                  decoding: 'async',
                  alt: section.settings.badge_image_2.alt
                }}
            {% endif %}
          </div>
        {% endif %}
      </div>
      {% comment %} <div class="image">
        <img src="{{ section.settings.image | image_url: width: 1500 }}" alt="{{ section.settings.heading | escape }}">
        {% if section.settings.badge_image_1 != blank or section.settings.badge_image_2 != blank %}
          <div class="badge_images">
            <img
              src="{{ section.settings.badge_image_1 | image_url: width: 200 }}"
              alt="{{ section.settings.badge_image_1.alt }}"
            >
            <img
              src="{{ section.settings.badge_image_2 | image_url: width: 200 }}"
              alt="{{ section.settings.badge_image_2.alt }}"
            >
          </div>
        {% endif %}
      </div> {% endcomment %}
    {% endif %}

    <div class="content">
      <div class="content-inner {% if section.settings.image_position == 'right' %}padding-left{% else %}padding-right{% endif %}">
        {% if section.settings.show_trust_widget %}
          <div class="custom_trust_widget">
            <a href="https://www.trustpilot.com/review/www.uk-water-filters.co.uk">
              {% render 'icon_trustpilot' %}
            </a>
          </div>
        {% endif %}
        {% if section.settings.subheading != blank %}
          <div class="subheading">{{ section.settings.subheading }}</div>
        {% endif %}
        {% if section.settings.heading != blank %}
          <div class="heading">{{ section.settings.heading }}</div>
        {% endif %}

        {%- comment -%} CHECKLIST VALUE PROPS (AB Test Winner) {%- endcomment -%}
        {% if section.settings.show_checklist %}
          <div class="hero-checklist">
            {% for block in section.blocks %}
              {% if block.type == 'checklist_item' %}
                <div class="hero-checklist-item" {{ block.shopify_attributes }}>
                  &#10004;&nbsp;{{ block.settings.checklist_text }}
                </div>
              {% endif %}
            {% endfor %}
          </div>

        {%- comment -%} ORIGINAL TEXT WITH ICONS {%- endcomment -%}
        {% elsif section.settings.text_with_icon %}
          <div class="text_with_icon_main">
            {% for block in section.blocks %}
              {% if block.type == 'icon_with_text' %}
                <div class="text_with_icon_single" {{ block.shopify_attributes }}>
                  <img src="{{ block.settings.icon | image_url: width: 100 }}" width="56" height="56">
                  <div class="text_main text">
                    {{ block.settings.text_main }}
                  </div>
                </div>
              {% endif %}
            {% endfor %}
          </div>

        {%- comment -%} ORIGINAL RICHTEXT FALLBACK {%- endcomment -%}
        {% elsif section.settings.text != blank %}
          <div class="text">
            {{ section.settings.text }}
          </div>
        {% endif %}

        <div class="image_text_buttons">
          {% if section.settings.button_text != blank and section.settings.button_link != blank %}
            <a href="{{ section.settings.button_link }}" class="button-primary image_text_button">
              {{- section.settings.button_text }}
              {% render 'icon-right-arrow-round' -%}
            </a>
          {% endif %}
          {% if section.settings.button_text_two and section.settings.button_link_two %}
            <a href="{{ section.settings.button_link_two }}" class="image_text_button_t">
              {{- section.settings.button_text_two }}
              {% render 'icon-right-arrow-round' -%}
            </a>
          {% endif %}
        </div>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Custom Image with Text",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "image_picker",
      "id": "badge_image_1",
      "label": "Badge Image 1"
    },
    {
      "type": "image_picker",
      "id": "badge_image_2",
      "label": "Badge Image 2"
    },
    {
      "type": "checkbox",
      "id": "show_trust_widget",
      "label": "Show Trust Widget"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Content background"
    },
    {
      "type": "richtext",
      "id": "heading",
      "label": "Heading",
      "default": "<h2>Your Heading</h2>"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Your Subheading"
    },
    {
      "type": "header",
      "content": "Content area"
    },
    {
      "type": "checkbox",
      "id": "show_checklist",
      "label": "Show checklist value props",
      "info": "Enable to show checklist-style value propositions (AB test winner). When enabled, add Checklist Item blocks below. Takes priority over text with icons and richtext.",
      "default": false
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text (fallback)",
      "info": "Shown only if checklist and text-with-icon are both disabled.",
      "default": "<h2>Your description goes here.</h2>"
    },
    {
      "type": "checkbox",
      "id": "text_with_icon",
      "label": "Show text with icons",
      "info": "Shown only if checklist is disabled."
    },
    {
      "type": "header",
      "content": "Buttons"
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button Text",
      "default": "Learn More"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button Link"
    },
    {
      "type": "text",
      "id": "button_text_two",
      "label": "Button Text 2",
      "default": "Learn More"
    },
    {
      "type": "url",
      "id": "button_link_two",
      "label": "Button Link 2"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "image_position",
      "label": "Image Position",
      "default": "left",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "right", "label": "Right" }
      ]
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding Top (px)",
      "min": 0,
      "max": 200,
      "default": 40,
      "step": 2
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding Bottom (px)",
      "min": 0,
      "max": 200,
      "default": 40,
      "step": 2
    },
    {
      "type": "text",
      "id": "section_class",
      "label": "Section Class ?",
      "info": "Do not change it."
    }
  ],
  "blocks": [
    {
      "type": "icon_with_text",
      "name": "Icon with text",
      "settings": [
        {
          "type": "image_picker",
          "id": "icon",
          "label": "Add image"
        },
        {
          "type": "richtext",
          "id": "text_main",
          "label": "Content"
        }
      ]
    },
    {
      "type": "checklist_item",
      "name": "Checklist Item",
      "settings": [
        {
          "type": "html",
          "id": "checklist_text",
          "label": "Checklist text",
          "info": "Supports HTML. A checkmark (✔) is automatically prepended. Example: Rated <strong>★★★★★</strong> from <a href='#'>9,000+ reviews</a>!"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Custom Image with Text"
    }
  ]
}
{% endschema %}
