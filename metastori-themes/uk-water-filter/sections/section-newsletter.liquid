<style>
  #shopify-section-{{ section.id }} {
    padding-top: {{ section.settings.padding-top }}px;
    padding-bottom: {{ section.settings.padding-bottom }}px;
    /* background: #02A8D2; */
    color: white;
  }
  #shopify-section-{{ section.id }} .newsletter_bg_image {
    width: 100%;
    background: #02a8d2;
    padding: 60px 56px;
    border-radius: 24px;
  }
  #shopify-section-{{ section.id }} .newsletter_bg_image {
    width: 100%;
    padding: 60px 56px;
    border-radius: 24px;
    background: url({{ section.settings.bg_image | image_url: width: 1000, height: auto }}) no-repeat center center / cover;
    position: relative;
    min-height: 400px;
    display: flex;
    align-items: center;
  }
  
  /* #shopify-section-{{ section.id }} .newsletter_bg_image:before {
      position: absolute;
      content: '';
      background: linear-gradient(90deg,rgba(2, 168, 210, 1) 0%, rgba(2, 168, 210, 0) 55%);
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      z-index: 0;
      display: block;
      border-radius: 24px;
  } */

  #shopify-section-{{ section.id }} .newsletter-section {
    display: flex;
    gap: 30px;
    justify-content: center;
    padding: 0 30px;
  }

  #shopify-section-{{ section.id }} .newsletter--left-container {
    padding-right: 0;
    z-index: 1;
    position: relative;
  }

  #shopify-section-{{ section.id }} .newsletter--right-container {
    padding-left: 0;
    z-index: 1;
    position: relative;
  }

  #shopify-section-{{ section.id }} .newsletter--title {
    font-size: 54px;
    font-weight: 500;
    margin-bottom: 20px;
    line-height: 1.33;
    font-family: 'gibson-semibold';
  }

  #shopify-section-{{ section.id }} .newsletter--content p {
    margin: 5px 0;
  }

  #shopify-section-{{ section.id }} .newsletter--subtitle {
    /* font-size: 18px; */
    font-size:21px;
    margin-bottom: 35px;
  }

  #shopify-section-{{ section.id }} .newsletter--subtitle .savings-amount {
    font-size: 32px;
  }

  #shopify-section-{{ section.id }} .newsletter--content {
    margin-bottom: 25px;
  }

  #shopify-section-{{ section.id }} .newsletter .newsletter-submit {
    margin: 0;
    width: unset !important;
    flex-basis: 32%;
  }

  #shopify-section-{{ section.id }} .newsletter-submit .button-primary {
    background-color: #02A8D2;
    border: unset;
    color: #fff;
    box-shadow: unset;
    border-top-right-radius: 3px !important;
    border-bottom-right-radius: 3px !important;
    font-weight: 400;
    padding: 0.875rem 15px;
    height: 100%;
    font-size: 14px;
    width: 100%;
    text-transform: unset;
  }
  #shopify-section-{{ section.id }} .pxs-newsletter-form-fields {
      display: flex;
      align-items: stretch;
      justify-content: center;
      border: 1px solid #F1F8FC;
      border-radius: 4px;
  }
  #shopify-section-{{ section.id }} #newsletter_email {
    border-radius: unset;
    background: #fff;
    color: #001F3C;
    border: unset;
  }

  #shopify-section-{{ section.id }} #newsletter_email:focus {
    border: unset;
    box-shadow: unset;
  }

  #shopify-section-{{ section.id }} .form-field-title {
    color: #001F3C;
  }

  #shopify-section-{{ section.id }} .newsletter-input {
    max-width: unset;
    width: 100%;
  }
  #shopify-section-{{ section.id }} .content_main {
    max-width: 660px;
  }
  #shopify-section-{{ section.id }} .button-secondary.newsletter_extra_button {
    padding: 17px 24px;
    color: #001F3C;
    border-radius: 4px !important;
    border: unset;
    text-transform: unset;
    text-align:center;
    min-width: 50%;
    font-size: 18px !important;
  }
  @media (max-width: 768px) {
    #shopify-section-{{ section.id }} .newsletter-section {
      flex-direction: column;
      padding: 0;
      text-align: left;
    }

    #shopify-section-{{ section.id }} .newsletter--left-container,
    #shopify-section-{{ section.id }} .newsletter--right-container {
      padding: unset;
      border: unset;
    }

    #shopify-section-{{ section.id }} .newsletter--left-container {
      padding-bottom: 0px;
      margin-bottom: 34px;
    }

    #shopify-section-{{ section.id }} .form-fields-inline {
      flex-direction: column;
      gap: 10px;
    }

    #shopify-section-{{ section.id }} .form-fields-inline .button-primary {
      width: 100%;
    }

    #shopify-section-{{ section.id }} .form-fields-inline #newsletter_email,
    #shopify-section-{{ section.id }} .form-fields-inline .newsletter-submit .button-primary {
      border-radius: 4px !important;
      border: 1px solid white;
    }
    #shopify-section-{{ section.id }} .newsletter_bg_image {
      padding: 55px 16px;
      min-height: 350px;
      border-radius: 0;
    }
    #shopify-section-{{ section.id }} .newsletter--title {
      font-size: 36px;
      margin-bottom: 30px;
    }
    #shopify-section-{{ section.id }} .newsletter--subtitle {
      font-size: 18px;
      margin-bottom: 22px;
      line-height: 1.33;
    }
    #shopify-section-{{ section.id }} .pxs-newsletter-form-fields {
      border: unset;
    }
    #shopify-section-{{ section.id }} .form-fields-inline #newsletter_email, #shopify-section-{{ section.id }} .form-fields-inline .newsletter-submit .button-primary {
      border: unset;
    }
    #shopify-section-section-newsletter {
      padding-top: 40px;
    }
    #shopify-section-{{ section.id }} .content_main {
      max-width: 100%;
      width: 100%;
      box-sizing: border-box;
    }

    #shopify-section-{{ section.id }} .button-secondary.newsletter_extra_button {
      padding: 17px 24px;
      min-width: 0;
      width: 100%;
      max-width: 100%;
      box-sizing: border-box;
      text-align: center;
      font-size: 16px !important;
    }
    #shopify-section-{{ section.id }} .newsletter--title br {
      display: none;
    }
    #shopify-section-{{ section.id }} .newsletter .newsletter-submit {
        margin: 0;
        width: unset !important;
        flex-basis: auto;
        position: absolute;
        right: 1px;
        transform: translateY(-50%);
        top: 50%;
        height: calc(100% - 2px);
    }
  }
</style>

<div class="newsletter-section">
  <div class="newsletter_bg_image">
    <div class="content_main">
      <div class="newsletter--left-container">
        <div class="newsletter--title">{{ section.settings.title }}</div>
        <div class="newsletter--subtitle">{{ section.settings.subtitle }}</div>
      </div>
      {% if section.settings.button_label != blank or section.settings.button_link != blank %}
        <a class="button-secondary newsletter_extra_button" href="{{ section.settings.button_link }}">{{ section.settings.button_label }}</a>
      {% endif %}
      {% unless section.settings.hide_email %}
        <div class="newsletter--right-container">
          <div class="newsletter--content">{{ section.settings.content }}</div>
          {% render 'newsletter', section: section %}
        </div>
      {% endunless %}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Newsletter section",
  "presets": [
  {
   "name":"Newsletter section"
  }
  ],
  "settings": [
    {
      "type": "image_picker",
      "id": "bg_image",
      "label": "Background image"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Title"
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "Subtitle"
    },
    {
      "type": "richtext",
      "id": "content",
      "label": "Content"
    },
    {
      "type": "checkbox",
      "id": "hide_email",
      "label": "Hide email"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    },
		{
      "type": "range",
      "id": "padding-top",
      "label": "Padding top",
      "min": 0,
      "max": 100,
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-bottom",
      "label": "Padding bottom",
      "min": 0,
      "max": 100,
      "default": 0
    }
  ]
}
{% endschema %}
