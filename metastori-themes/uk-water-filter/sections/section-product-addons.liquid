{% unless product.metafields.custom.special_offers == blank  %}

<style>
  #shopify-section-{{ section.id }} {
    padding-top: {{ section.settings.padding-top }}px;
    padding-bottom: {{ section.settings.padding-bottom }}px;
  }
  
  #shopify-section-{{ section.id }} .product--container {
    max-width: 800px;
  }

  #shopify-section-{{ section.id }} .section-title {
    text-align: center;
    color: #d91b1b;
  }

  #shopify-section-{{ section.id }} .product__specials__content {
    display: flex;
  }

  #shopify-section-{{ section.id }} .product__specials__content {
    display: flex;
    flex-wrap: wrap;
    list-style: none;
    margin: 0;
    padding: 0;
    margin-left: -25px;
  }

  #shopify-section-{{ section.id }} .product__specials__content li {
    width: 33.3%;
    padding-left: 25px;
    text-align: center;
    position: relative;
  }

  #shopify-section-{{ section.id }} .product__specials__content h3 {
    color: #3B8BAB;
    margin: 10px 0 5px;
    font-size: 16px;
  }

  #shopify-section-{{ section.id }} .product__specials__content p {
    color: #D60B0B;
    margin-top: 0;
  }

  #shopify-section-{{ section.id }} .product__specials__content a {
    position: absolute;
    top: 0; bottom: 0; left: 0; right: 0;
  }

  #shopify-section-{{ section.id }} .product__specials__content > li > div{
    box-shadow: 0px 0px 7px 0px #00000029;
    border: 1px solid #CCCCCC;
    height: 100%;
  }

  @media screen and (max-width: 499px) {
    #shopify-section-{{ section.id }} .product__specials__content {
      flex-direction: column;
      align-content: center;
      gap: 10px;
    }

    #shopify-section-{{ section.id }} .product__specials__content > li {
      min-width: 200px;
    }
  }
</style>

<section class="product--container page-width">
  <h2 class="section-title">Todays Special Deals</h2>
  <ul class="product__specials__content">
    {% for product in product.metafields.custom.special_offers.value limit: 3 %}
      <li>
        <div><img src="{{ product.featured_image | image_url: width: 1500, height: 1500, crop: 'center'}}"></div>
        <a href="{{ product.url }}"></a>
      </li>
    {% endfor %}
  </ul>
</section>

{% endunless %}
{% schema %}
{
  "name": "Product addons",
  "presets": [
  {
   "name":"Product addons"
  }
  ],
  "settings": [
		{
      "type": "range",
      "id": "padding-top",
      "label": "Padding top",
      "min": 0,
      "max": 100,
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-bottom",
      "label": "Padding bottom",
      "min": 0,
      "max": 100,
      "default": 0
    }
  ]
}
{% endschema %}