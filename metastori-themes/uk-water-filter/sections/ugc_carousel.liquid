{{ 'ugc_carousel.css' | asset_url | stylesheet_tag }}

<style>
  .ugc_carousel_main_{{ section.id }}{
    padding-top:{{section.settings.padding_top | times: 0.50 | round: 0 }}px;
    padding-bottom:{{section.settings.padding_bottom | times: 0.50 | round: 0 }}px;
  }
  @media screen and (min-width: 990px) {
    .ugc_carousel_main_{{ section.id }} {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
</style>

<div class="ugc_carousel_main ugc_carousel_main_{{ section.id }}">

  <div class="ugc_carousel ugc_carousel_{{ section.id }}">
    {% for block in section.blocks %}
      <div class="ugc_item_slide">
        <div class="ugc_item">
          <a href="{{ block.settings.link }}" class="ugc_url"> </a>
          <div class="ugc_item_media">
            {% if block.settings.image != blank %}
              <img class="ugc_item_image" src="{{ block.settings.image | image_url }}" alt="{{ block.settings.image }}-image" width="auto" height="auto"/>
            {% elsif block.settings.video != blank %}
              {{ block.settings.video | video_tag: loop: true, controls: false, muted: true, autoplay: true, class:"ugc_item_video" }}
            {% endif %}
          </div>
          {% if block.settings.text != blank %}
            <h3 class="ugc_item_text">{{ block.settings.text }}</h3>
          {% endif %}
        </div>
      </div>
    {% endfor %}
  </div>
  
</div>

<script>
document.addEventListener('DOMContentLoaded', function () {
  var ugc = new Flickity('.ugc_carousel_{{ section.id }}', {
    prevNextButtons: false,
    cellAlign: 'left',   // Centering hatane ke liye
    contain: true,       // Slides ko container ke andar rakhne ke liye
    pageDots: false      // Dots hatane ke liye
  });
  var cells = document.querySelectorAll('.ugc_item_slide');
  setTimeout(function(){
    cells.forEach(function(cell) {
      cell.style.height = '100%';
    });
  },250);
});

</script>

{% schema %}
  {
    "name": "UGC Carousel",
    "settings": [
      {
        "type": "range",
        "id":"padding_top",
        "label":"Padding Top",
        "min":0,
        "max":200,
        "step": 2,
        "default":30,
        "unit": "px"
      },
      {
        "type": "range",
        "id":"padding_bottom",
        "label":"Padding Bottom",
        "min":0,
        "max":200,
        "step": 2,
        "default":30,
        "unit": "px"
      }
    ],
    "blocks": [
      {
        "type": "image",
        "name":"Image",
        "settings": [
          {
            "type": "image_picker",
            "id":"image",
            "label": "Image"
          },
          {
            "type": "video",
            "id":"video",
            "label": "Video",
            "info": "If you want to render a video, the image field should be empty."
          },
          {
            "type": "text",
            "id":"text",
            "label": "Text"
          },
          {
            "type": "url",
            "id":"link",
            "label": "Link"
          }
        ]
      }
    ],
    "presets": [
      {
        "name": "UGC Carousel"
      }
    ]
  }
{% endschema %}