
{%- assign matched_tab = false -%}

{%- for entry in shop.metaobjects.whats_included.values -%}
  {%- for p in entry.products.value -%}
    {%- if p.handle == product.handle -%}
      {%- assign matched_tab = entry -%}
      {%- break -%}
    {%- endif -%}
  {%- endfor -%}

  {%- if matched_tab -%}
    {%- break -%}
  {%- endif -%}
{%- endfor -%}

{%- if matched_tab -%}

  <style>
    #shopify-section-{{ section.id }} {
      padding-top: {{ section.settings.padding-top }}px;
      padding-bottom: {{ section.settings.padding-bottom }}px;
    }
    
    #shopify-section-{{ section.id }} .product--container {
      margin-top: 0;
    }

    #shopify-section-{{ section.id }} .accordion {
      display: flex;
      flex-direction: column;
      border-top: 1px solid #001F3C;
    }

    #shopify-section-{{ section.id }} .accordion-header {
      cursor: pointer;
      display: flex;
      justify-content: space-between;
      color: #001F3C;
      font-weight: bold;
      font-size: 18px;
      padding: 24px 0;
      font-family: 'gibson-semibold';
    }

    #shopify-section-{{ section.id }} .accordion.active .accordion-header {
      color: #02A8D2;
    }

    #shopify-section-{{ section.id }} .accordion-content {
      display: none;
    }

    #shopify-section-{{ section.id }} .accordion.active .accordion-content {
      display: block;
    }

    #shopify-section-{{ section.id }} .accordion-header::after {
      content: "";
      font-weight: bold;
      width: 13px;
      border-radius: 50%;
      display: flex;
      justify-content: center; 
      height: 13px;
      font-size: 18px;
      background-repeat: no-repeat;
      background-size: contain;
      background-position: center;
      background-image: url('https://cdn.shopify.com/s/files/1/0665/1782/7878/files/1_a1ccafc7-c838-4bd7-bda1-cf001c4ef554.svg?v=1746523011');
    }

    #shopify-section-{{ section.id }} .accordion.active .accordion-header::after {
      background-image: url('https://cdn.shopify.com/s/files/1/0665/1782/7878/files/1.svg?v=1746522781');
    }

    #shopify-section-{{ section.id }} .tab-content > *:first-child {
      margin-top: 0;
    }

    #shopify-section-{{ section.id }} .tab-content > *:last-child {
      margin-bottom: 0;
    }

    @media screen and (max-width: 1249px) {
      #shopify-section-{{ section.id }} .accordion-content {
        padding: 20px 0px;
      }
    }

    @media screen and (max-width: 1025px) {
      #shopify-section-{{ section.id }} .product--container {
        padding: 0 15px;
      }
      #shopify-section-{{ section.id }} .accordion-header {
        padding: 20px 15px;
        font-size: 15px;
      }
    }
  </style>

  <section class="product--container delivery_tab" id="product-included-tab">
    <div class="accordion{% if section.settings.open_on_load %} active{% endif %}">
      
      <div class="accordion-header">
          {{ section.settings.title }}
      </div>
      
      <div class="accordion-content">
        <div class="tab-content">
          
          {%- if matched_tab.text != blank -%}
            <div class="accordion-content-wrapper">
              {{ matched_tab.text | metafield_tag }}
            </div>
          {%- endif -%}

        </div>
      </div>
      
    </div>
  </section>

{%- else -%}
<style>
   #shopify-section-{{ section.id }} {
        padding-bottom: 0;
    }
</style>
{%- endif -%}

{% schema %}
{
  "name": "Tab What's Included",
  "class": "tab-section",
  "presets": [
    {
     "name": "Tab What's Included"
    }
  ],
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Fallback Title (if Metaobject title is blank)",
      "default": "What's Included"
    },
    {
      "type": "checkbox",
      "id": "open_on_load",
      "label": "Open on load",
      "default": true
    },
    {
      "type": "range",
      "id": "padding-top",
      "label": "Padding top",
      "min": 0,
      "step": 2,
      "max": 200,
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-bottom",
      "label": "Padding bottom",
      "min": 0,
      "step": 2,
      "max": 200,
      "default": 0
    }
  ]
}
{% endschema %}