<script src="{{ 'flickity-init-reviews.js' | asset_url }}" defer="defer"></script>

<style>
  #shopify-section-{{ section.id }} {
    padding-top: {{ section.settings.padding-top }}px;
    padding-bottom: {{ section.settings.padding-bottom }}px;
    background: #f6f6f6;
    overflow-x: hidden;
  }

  #shopify-section-{{ section.id }} .carousel-cell {
    width: 55%;
  }

  #shopify-section-{{ section.id }} .review {
    display: flex;
    background-color: white;
    margin-right: 30px;
    animation: fillHeight 0s 0.2s linear forwards;
  }

  #shopify-section-{{ section.id }} .customer-name {
    margin-bottom: 10px;
  }

  #shopify-section-{{ section.id }} .review > .img__wrapper {
    max-width: 300px;
    height: 100%;
  }

  #shopify-section-{{ section.id }} .review .content-wrapper .img__wrapper {
    max-width: 80px;
  }

  #shopify-section-{{ section.id }} .review .content-wrapper .img__wrapper {
    margin-bottom: 20px;
  }

  #shopify-section-{{ section.id }} .review .content-wrapper {
    flex-basis: 60%;
    padding: 60px;
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: center;
  }

  #shopify-section-{{ section.id }} .img__wrapper img {
    object-fit: cover;
  }

  #shopify-section-{{ section.id }} .content-wrapper .img__wrapper img {
    object-fit: contain;
  }

  {% if section.settings.button_text != blank %}
    #shopify-section-{{ section.id }} .review .review-text {
      margin-bottom: 30px;
    }
  {% endif %}

  #shopify-section-{{ section.id }} .review .btn__wrapper {
    margin-top: auto;
  }

  #shopify-section-{{ section.id }} .review .btn {
    bottom: 50px;
    background-color: #02A8D2;
    padding: 10px 25px;
    color: white;
    font-weight: bold;
    border-radius: 5px;
    text-decoration: none;
    width: max-content;
  }

  #shopify-section-{{ section.id }} .dot.is-selected {
    background-color: black;
  }

  #shopify-section-{{ section.id }} .review-title {
    font-size: 26px;
    font-weight: bold;
    margin-bottom: 15px;
  }

  #shopify-section-{{ section.id }} .flickity-page-dots {
    bottom: -50px;
  }

  #shopify-section-{{ section.id }} .flickity-viewport {
    overflow-x: hidden;
  }

  @media (max-width: 1250px) {
    #shopify-section-{{ section.id }} .review {
      flex-direction: column;
    }

    #shopify-section-{{ section.id }} .review .img__wrapper{
      max-height: 400px;
      max-width: unset;
    }
  }

  @media (max-width: 769px) {
    #shopify-section-{{ section.id }} .carousel-cell {
      width: 80%;
    }

    #shopify-section-{{ section.id }} .review-title {
      font-size: 19px;
    }

    #shopify-section-{{ section.id }} .carousel-cell {
      width: 80%;
    }

    #shopify-section-{{ section.id }} .content-wrapper {
      text-align: center;
    }

    #shopify-section-{{ section.id }} .content-wrapper .btn {
      transform: translateX(-50%);
      white-space: nowrap;
      bottom: 10px;
    }

    #shopify-section-{{ section.id }} .content-wrapper .img__wrapper {
      margin-left: auto;
      margin-right: auto;
    }

    #shopify-section-{{ section.id }} .flickity-page-dots {
      transform: translate(-50%, -50%);
      left: 50%;
    }

    #shopify-section-{{ section.id }} .review .content-wrapper {
      padding: 20px;
    }

    @keyframes fillHeight {
      0% {
          height: auto;
      }
      100% {
          height: 100%;
      }
    }
  }
</style>

<div class="carousel review-carousel">
  {% for block in section.blocks %}
    <div class="review carousel-cell">
      {%- if block.settings.img != blank -%}
      <div class="img__wrapper">
        {%- assign img_height = block.settings.img.width | divided_by: block.settings.img.aspect_ratio -%}
    
        {{ block.settings.img | image_url: width: 1000 | image_tag:
          height: img_height,
          width: block.settings.img.width,
          loading: 'lazy'
        }}
      </div>
      {%- endif -%}
      <div class="content-wrapper">
        {% if block.settings.customer_name != blank %}
          <div class="customer-name">{{ block.settings.customer_name}}</div>
        {% endif %}
        {%- if section.settings.img_stars != blank -%}
          <div class="img__wrapper">
            {%- assign img_height = section.settings.img_stars.width | divided_by: section.settings.img_stars.aspect_ratio -%}
        
            {{ section.settings.img_stars | image_url: width: 1000 | image_tag:
              height: img_height,
              width: section.settings.img_stars.width,
              loading: 'lazy'
            }}
          </div>
        {%- endif -%}
        {% if block.settings.title != blank %}
          <div class="review-title">{{ block.settings.title }}</div>
        {% endif %}
        <div class="review-text">{{ block.settings.text }}</div>
        {% if section.settings.button_text != blank %}
          <div class="btn__wrapper"><a class="btn" {% if block.settings.button_link != blank %} href=" {{ block.settings.button_link }} " {% endif %}> {{ section.settings.button_text }} </a></div>
        {% endif %}
      </div>
    </div>
  {% endfor %}
</div>

{% schema %}
{
  "name": "Review carousel",
  "presets": [
  {
   "name":"review-carousel"
  }
  ],
  "settings": [
    {
      "type": "text",
      "id": "button_text",
      "label": "Button text"
    },
    {
      "type": "image_picker",
      "id": "img_stars",
      "label": "Image stars"
    },
		{
      "type": "range",
      "id": "padding-top",
      "label": "Padding top",
      "min": 0,
      "max": 100,
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-bottom",
      "label": "Padding bottom",
      "min": 0,
      "max": 100,
      "default": 0
    }
  ],
  "blocks": [
     {
       "name": "Review",
       "type": "Review",
       "settings": [
         {
           "type": "image_picker",
           "id": "img",
           "label": "Image"
         },
         {
           "type": "text",
           "id": "customer_name",
           "label": "Customer name"
         },
         {
           "type": "text",
           "id": "title",
           "label": "Title"
         },
         {
           "type": "richtext",
           "id": "text",
           "label": "Text"
         },
         {
          "type": "url",
          "id": "button_link",
          "label": "Button link"
        }
       ]
     }
   ]
}
{% endschema %}