

<div class="quiz-container">
  <!-- Start Quiz Button -->

  <div id="quiz-intro">
    {% if section.settings.quiz_heading != '' %}
      <h2>{{ section.settings.quiz_heading }}</h2>
    {% endif %}
    {% if section.settings.start_image %}
      <img src="{{ section.settings.start_image | img_url: 'medium' }}" alt="Start Quiz">
    {% endif %}
    <button id="quiz-start">{{ section.settings.start_button_text }}</button>
  </div>
  <div id="quiz-progress-container" style="display: none;">
    <div id="quiz-progress-bar"></div>
  </div>
  <!-- Quiz Questions (Initially Hidden) -->
  <div id="quiz-content" style="display: none;">
    {% for block in section.blocks %}
      <div
        class="quiz-question"
        id="{{ block.settings.question_id }}"
        style="display: {% if forloop.first %}block{% else %}none{% endif %};"
      >
        <h2>{{ block.settings.question_text }}</h2>
        {% if block.settings.question_heading != '' %}
          <p>{{ block.settings.question_heading }}</p>
        {% endif %}
        {% if block.settings.start_image_question %}
          <img src="{{ block.settings.start_image_question | image_url }}" alt="Question Image">
        {% endif %}
        <div class="quiz-answers">
          {% if block.settings.answer1_text != '' %}
            <div class="quiz-answer-box" onclick="selectAnswer(this)">
              {% if block.settings.start_image_ans_1 %}
                <img src="{{ block.settings.start_image_ans_1 | image_url }}" alt="Question Image">
              {% endif %}
              <label>
                <input
                  type="radio"
                  name="answer-{{ block.settings.question_id }}"
                  class="quiz-answer"
                  data-next="{{ block.settings.answer1_next }}"
                  data-redirect="{{ block.settings.answer1_redirect }}"
                >
                <span>{{ block.settings.answer1_text }}</span>
              </label>
            </div>
          {% endif %}

          {% if block.settings.answer2_text != '' %}
            <div class="quiz-answer-box" onclick="selectAnswer(this)">
              {% if block.settings.start_image_ans_2 %}
                <img src="{{ block.settings.start_image_ans_2 | image_url }}" alt="Question Image">
              {% endif %}
              <label>
                <input
                  type="radio"
                  name="answer-{{ block.settings.question_id }}"
                  class="quiz-answer"
                  data-next="{{ block.settings.answer2_next }}"
                  data-redirect="{{ block.settings.answer2_redirect }}"
                >
                <span>{{ block.settings.answer2_text }}</span>
              </label>
            </div>
          {% endif %}

          {% if block.settings.answer3_text != '' %}
            <div class="quiz-answer-box" onclick="selectAnswer(this)">
              {% if block.settings.start_image_ans_3 %}
                <img src="{{ block.settings.start_image_ans_3 | image_url }}" alt="Question Image">
              {% endif %}
              <label>
                <input
                  type="radio"
                  name="answer-{{ block.settings.question_id }}"
                  class="quiz-answer"
                  data-next="{{ block.settings.answer3_next }}"
                  data-redirect="{{ block.settings.answer3_redirect }}"
                >
                <span>{{ block.settings.answer3_text }}</span>
              </label>
            </div>
          {% endif %}
          {% if block.settings.answer4_text != '' %}
            <div class="quiz-answer-box" onclick="selectAnswer(this)">
              {% if block.settings.start_image_ans_4 %}
                <img src="{{ block.settings.start_image_ans_4 | image_url }}" alt="Question Image">
              {% endif %}
              <label>
                <input
                  type="radio"
                  name="answer-{{ block.settings.question_id }}"
                  class="quiz-answer"
                  data-next="{{ block.settings.answer4_next }}"
                  data-redirect="{{ block.settings.answer4_redirect }}"
                >
                <span>{{ block.settings.answer4_text }}</span>
              </label>
            </div>
          {% endif %}
        </div>
      </div>
    {% endfor %}

    <!-- Back & Next Buttons -->
    <div class="quiz-navigation">
      <button id="quiz-back" style="display: none;">← Previous</button>
      <button id="quiz-next" disabled>Next →</button>
    </div>
    <button
      id="quiz-retake"
      class="quiz-restart"
    >
      {{ section.settings.retake_quiz_text }}
    </button>
  </div>
  <div id="quiz-result" style="display: none;">
    {% for block in section.blocks %}
      {% if block.type == 'quiz_result1' %}
        <h2>{{ block.settings.result_title }}</h2>
        <h3>{{ block.settings.result_sub_title }}</h3>
        <img src="{{ block.settings.result_image | img_url: 'master' }}" alt="ro-image" style="width:400px">

        <p>{{ block.settings.result_sub_desc }}</p>

        <ul>
          {% for product in block.settings.product_list %}
            <li>
              <a href="{{ product.url }}">
                <img src="{{ product.featured_image | img_url: 'small' }}" alt="{{ product.title }}">
                <p>{{ product.title }}</p>
                <p>{{ product.price | money }}</p>
                <p>{{ product.description | strip_html | truncatewords: 20 }}</p>
              </a>
              <form method="post" action="/cart/add">
                <input type="hidden" name="id" value="{{ product.variants.first.id }}">
                <button type="submit">Add to Cart</button>
              </form>
            </li>
          {% endfor %}
        </ul>
      {% endif %}
    {% endfor %}
    <button class="quiz-preview">← Previous</button>
    <button id="quiz-retake">{{ section.settings.retake_quiz_text }}</button>
  </div>
  {% for i in (2..15) %}
  <div id="quiz-result{{ i }}" style="display: none;">
    {% for block in section.blocks %}
      {% assign result_type = 'quiz_result' | append: i %}
      {% if block.type == result_type %}
        {% assign title_key = 'result_title' | append: i %}
        {% assign subtitle_key = 'result_sub_title' | append: i %}
        {% assign desc_key = 'result_sub_desc' | append: i %}
        {% assign product_key = 'product_list' | append: i %}
         {% assign image_key = 'result_image' | append: i %}
        <h2>{{ block.settings[title_key] }}</h2>
        <h3>{{ block.settings[subtitle_key] }}</h3>
        {% if block.settings[image_key] != blank %}
  <img src="{{ block.settings[image_key] | img_url: 'master' }}" alt="ro-image" style="width:400px">
{% endif %}


        <p>{{ block.settings[desc_key] }}</p>

        <ul>
          {% for product in block.settings[product_key] %}
            <li>
              <a href="{{ product.url }}">
                <img src="{{ product.featured_image | img_url: 'small' }}" alt="{{ product.title }}">
                <p>{{ product.title }}</p>
                <p>{{ product.price | money }}</p>
                <p>{{ product.description | strip_html | truncatewords: 20 }}</p>
              </a>
              <form method="post" action="/cart/add">
                <input type="hidden" name="id" value="{{ product.variants.first.id }}">
                <button type="submit">Add to Cart</button>
              </form>
            </li>
          {% endfor %}
        </ul>
      {% endif %}
    {% endfor %}
    <button class="quiz-preview">← Previous</button>
    <button id="quiz-retake{{ i }}">{{ section.settings.retake_quiz_text }}</button>
  </div>
{% endfor %}

</div>
