{% assign productVariant = product.selected_or_first_available_variant %}

<a {% if product.url != blank %}href="{{ product.url }}"{% endif %} class="product-grid-item">
  {%- if product.featured_media.preview_image.src != blank -%}
    <div class="img__wrapper">
      {%- assign img_height = product.featured_media.preview_image.src.width | divided_by: product.featured_media.preview_image.src.aspect_ratio -%}
  
      {{ product.featured_media.preview_image.src | image_url: width: 1000 | image_tag:
        height: img_height,
        width: product.featured_media.preview_image.src.width,
        loading: 'lazy'
      }}
    </div>
    <div class="content-wrapper">
      <div class="product-grid-item--title">{{ product.title }}</div>
      {% comment %}<div class="product-grid-item--sku">SKU: {{ productVariant.sku }}</div>{% endcomment %}
      <div class="money">
        {% if productVariant.compare_at_price != 0 %}
          <div class="price-comparison">
            <div class="sale-price">Todays Price: <span class="sale-price-value">{{ productVariant.price | money }}</span> INC VAT</div >
            <div class="regular-price">Regular Price: <span class="regular-price-value">{{ productVariant.compare_at_price | money }}</span> INC VAT</div>
          </div>
        {% else %}
          <span class="regular-price"><span class="regular-price-value">{{ productVariant.price | money }}</span> INC VAT</span>
        {% endif %}
      </div>
      <form method="post" action="/cart/add">
        <input type="hidden" name="id" value="{{ productVariant.id }}" />
        <input type="hidden" min="1" type="number" id="quantity" name="quantity" value="1"/>
        <input type="submit" value="Add to cart" class="btn" />
      </form>
    </div>
  {%- endif -%}
</a>