<div id="side_bar">
 
{{ 'side_bar.css' | asset_url | stylesheet_tag }}
            {{ 'side_bar.js' | asset_url | script_tag }}
            
          <div class="ms_popup_wr">
            <div class="ms_popup_overlay" title="Close"></div>
              <div class="ms_popup_content">
                <span title="Close" class="ms_close_btn">
                  <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none"
                    stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
                    class="feather feather-x">
                    <line x1="18" y1="6" x2="6" y2="18"></line>
                    <line x1="6" y1="6" x2="18" y2="18"></line>
                  </svg>
                </span>
                <div class="custom_drawer_collection">
                  {% 
                    render 'product-grid-sidebar',
                    menu_depth: 2,
                    context: collection
                  %}
                </div>
              </div>
            </div>
          </div>
            