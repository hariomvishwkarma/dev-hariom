<style>
  .trustpilot-wiget.mobile{
    display:none;
  }
  </style>
<div class="site-mobile-nav" id="site-mobile-nav" data-mobile-nav tabindex="0">
  <div class="mobile-nav-panel" data-mobile-nav-panel>

    {% render 'site-header-actions' %}

    <a
      class="mobile-nav-close"
      href="#site-header-nav"
      data-mobile-nav-close>
      {% render 'icon-menu-close' %}
      <span class="visually-hidden">{{ 'general.accessibility.close' | t }}</span>
    </a>

    <div class="mobile-nav-content" data-mobile-nav-content>
      {%
        render 'mobile-nav-list',
        menu: section.settings.mobile_menu,
        blocks: blocks,
      %}

      {% if section.settings.secondary_menu != blank %}
        <span class="mobile-nav-content__border"></span>
        <div class="mobile-nav-content__secondary-menu">
          {%
            render 'navlist',
            menu_list: linklists[section.settings.secondary_menu].links,
            depth: 1,
            max_depth: 1,
            aria_expanded: true,
          %}
        </div>
      {% endif %}
      {% comment %}
        <div class="small-promo">
        <div class="trustpilot-widget" data-locale="en-GB" data-template-id="53aa8807dec7e10d38f59f32" data-businessunit-id="5ca5ac479121e1000152fa10" data-style-height="150px" data-style-width="100%" data-theme="light" style="height: 100px">
            <a href="https://uk.trustpilot.com/review/www.uk-water-filters.co.uk" target="_blank" rel="noopener"></a>
            </div>
            <!-- <img class="variant-a" src="https://cdn.shopify.com/s/files/1/0665/1782/7878/files/Screenshot_2024-04-18_at_12.28.30_PM.png?v=1713423638">
            <img class="variant-b" src="https://cdn.shopify.com/s/files/1/0665/1782/7878/files/Screen_Shot_2024-04-18_at_3.51.46_PM.png?v=1713436396"> -->
      </div>
      {% endcomment %}
      
      <div class="small-promo">
        <div class="trustpilot-wiget mobile">
        <a href="https://www.trustpilot.com/review/www.uk-water-filters.co.uk">
      <img
        style="width: 200px;"
        src="https://cdn.shopify.com/s/files/1/0665/1782/7878/files/gemini_generated_image_k0refgk0refgk0re_720.png?v=1776941148"
      >
           </a>
        </div>
      </div>
    </div>
    <div class="utility-bar__mobile-disclosure" data-utility-mobile></div>
  </div>
  <div class="mobile-nav-overlay" data-mobile-nav-overlay></div>
</div>
