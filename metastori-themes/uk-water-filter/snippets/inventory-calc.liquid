{% assign sku = product.first_available_variant.sku | string %}

{% assign sku_size = sku | size %}

{% if sku_size == 3 %}
  {% assign sku = sku | slice: 1, 2 %}
{% elsif sku_size == 4 %}
  {% assign sku = sku | slice: 2, 3 %}
{% endif %}

{% assign sku = sku | plus: 0 %}

{% assign todayUK = 'now' | date: '%a' %}

{% if todayUK == 'Mon' %}
  {% assign daysUK = 6 %}
{% elsif todayUK == 'Tue' %}
  {% assign daysUK = 12 %}
{% elsif todayUK == 'Wed' %}
  {% assign daysUK = 18 %}
{% elsif todayUK == 'Thu' %}
  {% assign daysUK = 24 %}
{% elsif todayUK == 'Fri' %}
  {% assign daysUK = 30 %}
{% elsif todayUK == 'Sat' %}
  {% assign daysUK = 36 %}
{% elsif todayUK == 'Sun' %}
  {% assign daysUK = 0 %}
{% endif %}

{% assign newInv = sku | minus: daysUK %}

{% if newInv < 0 %}
  {% assign newInv = newInv | plus: 200 %}
{% elsif newInv < 4 %}
  {% assign newInv = newInv | plus: 20 %}
{% endif %}

{{ newInv }}
