{%- capture block_class -%}
  site-footer-block-item
  site-footer-block-{{ block.type | replace: '_', '-' }}
  {% if block.type == 'menu' %}has-accordion{% endif %}
{%- endcapture -%}

<div class="{{ block_class | strip_newlines }}" {{ block.shopify_attributes }}>

  {% if block.type == 'menu' %}
      <h2 class="site-footer-block-title" data-accordion-trigger>
        {{ linklists[block.settings.menu].title | escape }}

        <span class="site-footer-block-icon accordion--icon">
          {% render 'icon-chevron-down' %}
        </span>
      </h2>

      <div class="site-footer-block-content">
        {%
          render 'navlist',
          menu_list: linklists[block.settings.menu].links,
          depth: 1,
          max_depth: 1,
          aria_expanded: false,
          accordion_level: 1,
        %}
      {% if block.settings.show_trust_badge %}
        <div class="trustpilot-widget-wrapper-big">
          <img style="width: 160px;" src="https://cdn.shopify.com/s/files/1/0665/1782/7878/files/gemini_generated_image_k0refgk0refgk0re_720.png?v=1776941148">
          {% comment %}
          <!-- TrustBox widget - Mini -->
          <div class="trustpilot-widget" data-locale="en-US" data-template-id="53aa8807dec7e10d38f59f32" data-businessunit-id="5ca5ac479121e1000152fa10" data-style-height="150px" data-style-width="190px" data-theme="light" data-font-family="Fira Sans" data-text-color="#001F3C">
            <a href="https://www.trustpilot.com/review/www.uk-water-filters.co.uk" target="_blank" rel="noopener">Trustpilot</a>
          </div>
          <!-- End TrustBox widget -->
        {% endcomment %}
        </div>
      {% endif %}
      </div>
  {% elsif block.type == 'rich_text' or block.type == 'newsletter' %}
    {% if block.settings.title != blank %}
      <h2 class="site-footer-block-title">
        {{ block.settings.title | escape }}
      </h2>
    {% endif %}

    {% if block.settings.text != blank %}
      <div class="site-footer-block-content rte">
        {{ block.settings.text }}
      </div>
    {% endif %}


    {% if block.type == 'newsletter' %}
      {% assign form_id = 'footer_newsletter_' | append: block.id %}
      {%
        render 'newsletter',
        form_id: form_id,
        input_id: 'footer_newsletter_email'
      %}
    {% endif %}
  {% elsif block.type == 'social_accounts' %}
    {%
      render 'social-list',
      context: 'footer',
    %}
    <div class="trustpilot-widget-wrapper-big">
      <!-- TrustBox widget - Mini -->
      <img style="width: 160px;" src="https://cdn.shopify.com/s/files/1/0665/1782/7878/files/gemini_generated_image_k0refgk0refgk0re_720.png?v=1776941148">
      <!-- End TrustBox widget -->
    </div>
    <div class="trustpilot-widget-wrapper-small">
      <!-- TrustBox widget - Mini -->
      <img style="width: 160px;" src="https://cdn.shopify.com/s/files/1/0665/1782/7878/files/gemini_generated_image_k0refgk0refgk0re_720.png?v=1776941148">
      <!-- End TrustBox widget -->
    </div>
  {% endif %}
</div>
