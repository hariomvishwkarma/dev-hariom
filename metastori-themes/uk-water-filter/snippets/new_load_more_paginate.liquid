{% assign current_page = paginate.current_page %}
{% assign total_pages = paginate.pages %}
{% assign products_per_page = paginate.page_size %}
{% assign total_products = paginate.items %}
{% assign viewed_products = current_page | times: products_per_page %}
{% if viewed_products > total_products %}
  {% assign viewed_products = total_products %}
{% endif %}

{% assign percentage = current_page | times: 100.0 | divided_by: total_pages %}

<div class="product-progress-wrapper">
  <p class="product-progress-text">
    You’ve viewed <strong>{{ viewed_products }}</strong> of <strong>{{ total_products }}</strong> Products
  </p>

  <div class="product-progress-bar">
    <div class="product-progress-bar--fill" style="width: {{ percentage }}%;"></div>
  </div>

  {% if paginate.next or paginate.previous %}
    <div class="load-more-button-wrapper">
      {% if paginate.previous %}
        <a href="{{ paginate.previous.url }}" class="load-more-button">Previous</a>
      {% endif %}
      {% if paginate.next %}
        <a href="{{ paginate.next.url }}" class="load-more-button">Next</a>
      {% endif %}
    </div>
  {% endif %}
</div>


<style>
  .product-progress-wrapper {
    text-align: center;
    margin: 40px auto;
    max-width: 300px;
  }

.product-progress-text {
    font-size: 14px;
    margin-bottom: 17px;
    color: #0f2e4c;
}

.product-progress-bar {
  width: 100%;
  height: 8px;
  background-color: #C9E7F9;
  border-radius: 50px;
  margin: 0 auto 20px;
  overflow: hidden;
}

.product-progress-bar--fill {
  height: 100%;
  background-color: #02A8D2;
  border-radius: 10px 0 0 10px;
  transition: width 0.3s ease-in-out;
}

.load-more-button-wrapper {
  display: flex;
  justify-content: center;
  gap:10px;
}

.load-more-button {
    display: inline-block;
    padding: 14px 24px;
    border: 1px solid #001F3C;
    border-radius: 4px;
    background-color: #fff;
    font-weight: bold;
    color: #001F3C;
    text-decoration: none;
    transition: all 0.3s ease;
    min-width: 200px;
    font-size: 14px;
}
  
.load-more-button:hover {
  background-color: #001F3C;
  color: #fff;
}

</style>