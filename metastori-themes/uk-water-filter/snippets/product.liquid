<script>
  function setRecentlyViewedPdp() {
    const pdpData = {
      productTitle: "{{ product.title }}",
      productImg: "{{ product.featured_image | img_url: '512x512' }}",
      productPrice: "{{ product.price | money | remove_first: '' }}",
      productCompareAtPrice: "{{ product.compare_at_price | money | remove_first: '' }}",
      productUrl: "{{ product.url }}"
    };

    const productArr = [pdpData];
    const numberOfProduct = 5;
    const currPdpTitle = pdpData.productTitle;
    const localData = localStorage.getItem('recently_viewed');

    if (!localData) {
      localStorage.setItem('recently_viewed', JSON.stringify(productArr));
    } else {
      const oldPdpData = JSON.parse(localStorage.getItem('recently_viewed'));
      const isRevisit = oldPdpData.some(p => p.productTitle === currPdpTitle);

      if (!isRevisit) {
        if (oldPdpData.length >= numberOfProduct) {
          oldPdpData.shift();
        }
        oldPdpData.push(pdpData);
        localStorage.setItem('recently_viewed', JSON.stringify(oldPdpData));
      }
    }
  }

  setRecentlyViewedPdp();
  (function () {

  function getCurrencySymbol(priceText) {
    const match = priceText.trim().match(/^[^\d]+/);
    return match ? match[0].trim() : "";
  }

  function parsePrice(price) {
    if (!price) return 0;

    return parseFloat(
      price
        .replace(/[^\d.,]/g, "") // remove currency symbols
        .replace(/,/g, "") // remove thousand separator
    );
  }

  function formatPrice(num, currency) {
    return currency + num.toLocaleString(undefined, {
      minimumFractionDigits: 2,
      maximumFractionDigits: 2
    });
  }

  function updateSaving() {

    const mainPriceEl = document.querySelector(".pdp_main_price");
    const comparePriceEl = document.querySelector(".usual-price strike");
    const savingEl = document.querySelector(".pp-savings");

    if (!mainPriceEl || !comparePriceEl || !savingEl) return;

    const currency = getCurrencySymbol(mainPriceEl.textContent);

    const mainPrice = parsePrice(mainPriceEl.textContent);
    const comparePrice = parsePrice(comparePriceEl.textContent);

    if (!mainPrice || !comparePrice) return;

    const saving = comparePrice - mainPrice;
    const percent = Math.round((saving / comparePrice) * 100);

    savingEl.textContent = `${formatPrice(saving, currency)} (-${percent}%)`;
  }

  function updatePriceFromWidget() {

    const mainPrice = document.querySelector(".pdp_main_price");
    if (!mainPrice) return;

    const checkedPlan = document.querySelector(
      "#appstle_subscription_widget0 input[name='selling_plan']:checked"
    );

    if (!checkedPlan) return;

    let priceElement;

    if (checkedPlan.value === "") {
      priceElement = document.querySelector(
        ".appstle_one_time_price_wrapper .appstle_subscription_amount"
      );
    } else {
      priceElement = checkedPlan
        .closest(".appstle_subscription_wrapper_option")
        .querySelector(".appstle_subscription_amount");
    }

    if (priceElement) {
      mainPrice.textContent = priceElement.textContent.trim();
      updateSaving();
    }
  }

  function initWidgetListener() {

    const widget = document.querySelector("#appstle_subscription_widget0");
    if (!widget) return;

    widget.addEventListener("change", function (e) {

      if (
        e.target.name === "selling_plan" ||
        e.target.classList.contains("appstle_select")
      ) {
        setTimeout(updatePriceFromWidget, 200);
      }

    });

    updatePriceFromWidget();
  }

  function waitForWidget() {

    const check = setInterval(function () {

      if (document.querySelector("#appstle_subscription_widget0")) {
        clearInterval(check);
        initWidgetListener();
      }

    }, 200);

  }

  document.addEventListener("DOMContentLoaded", waitForWidget);

})();
</script>

