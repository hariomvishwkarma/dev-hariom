              -%}

              {%- if entry -%}
                {%- assign base_price = product.price -%}

                {%- capture rows -%}
                {%- assign tiers_rendered = 0 -%}
                {%- for i in (1..3) -%}
                  {%- assign text_key  = 'quantity_' | append: i | append: '_text' -%}
                  {%- assign perc_key  = 'quantity_' | append: i | append: '_discount_percent' -%}
                  {%- assign price_key = 'quantity_' | append: i | append: '_discount_price_new' -%}

                  {%- assign label     = entry[text_key]  | strip -%}
                  {%- assign perc      = entry[perc_key]  -%}
                  {%- assign fixed_raw = entry[price_key] -%} 

                  {%- if label != blank -%}
                    {%- if fixed_raw != blank or perc != blank -%}

                      {%- assign parts = label | split: ' ' -%}
                      {%- assign maybe_qty = parts | last | plus: 0 -%}
                      {%- assign qty = maybe_qty -%}
                      {%- if qty == 0 -%}
                        {%- assign qty = i | plus: 1 -%}
                      {%- endif -%}

                      {%- assign per_price = 0 -%}
                      {%- assign per_save  = 0 -%}
                      {%- assign perc_bp   = 0 -%}

                      {%- if fixed_raw != blank -%}
                        {%- comment -%}
                          Fixed discount mode:
                          fixed_raw is entered in rupees (e.g. 200),
                          so convert to paise/cents to match product.price.
                        {%- endcomment -%}
                        {%- assign per_save  = fixed_raw | times: 100 -%}
                        {%- assign per_price = base_price | minus: per_save -%}
                        {%- assign perc_bp   = per_save | times: 10000 | divided_by: base_price -%}
                      {%- elsif perc != blank -%}
                        {%- assign perc_bp = perc | times: 100 | round: 0 -%}
                        {%- assign factor_bp = 10000 | minus: perc_bp -%}
                        {%- assign per_price = base_price | times: factor_bp | divided_by: 10000 -%}
                        {%- assign per_save  = base_price | minus: per_price -%}
                      {%- endif -%}

                      {%- assign total_save = per_save | times: qty -%}
                      {%- assign tiers_rendered = tiers_rendered | plus: 1 -%}

                      <div class="volume_discount_block"
                        role="button"
                        tabindex="0"
                        aria-label="{{ label }} (sets quantity to {{ qty }})"
                        data-qty="{{ qty }}"
                        data-perc-bp="{{ perc_bp }}"
                        data-base-price="{{ base_price }}">
                        <div class="offer_heading">
                          <h6>{{ label }}</h6>
                        </div>
                        <div class="offer_price">
                          <h4>{{ per_price | money_without_trailing_zeros }} <small>Each</small></h4>
                          {% comment %} {% if fixed_raw != blank %} 
                            <span>Save {{ per_save | money_without_trailing_zeros }}</span>
                          {% else %}
                            <span>Save {{ total_save | money_without_trailing_zeros }}</span>
                          {%endif %} {% endcomment %}
                            <span>Save {{ total_save | money_without_trailing_zeros }}</span>
                        </div>
                      </div>

                    {%- endif -%}
                  {%- endif -%}
                {%- endfor -%}
                {%- if tiers_rendered == 0 -%}{% assign entry = nil %}{%- endif -%}
              {%- endcapture -%}


                {%- if entry -%}
                  <div class="volume_discount_wrap" data-volume-pricing>
                    <div class="volume_discount_inner" data-volume-rows>
                      {{ rows }}
                    </div>
                  </div>
                {%- endif -%}

                <script>
                  (function () {
                    document.addEventListener('click', function (e) {
                      const el = e.target.closest('[data-qty]');
                      if (!el) return;

                      const qty = parseInt(el.getAttribute('data-qty'), 10);
                      if (!Number.isFinite(qty) || qty < 1) return;

                      const scope =
                        el.closest('form[action*="/cart/add"]') ||
                        el.closest('section, .product, .product-main, .product-single') ||
                        document;

                      const visibleInput =
                        scope.querySelector('#quantity_') ||
                        scope.querySelector('[data-quantity-select]') ||
                        scope.querySelector('input[type="number"]');

                      const masterInput =
                        (scope.querySelector('.master-input') || scope.querySelector('[name="quantity"]'));

                      if (!visibleInput && !masterInput) return;

                      const refInput = visibleInput || masterInput;

                      const min = parseInt(refInput.getAttribute('min') || '1', 10);
                      const maxAttr = refInput.getAttribute('max');
                      const max = maxAttr ? parseInt(maxAttr, 10) : Infinity;

                      const newQty = Math.min(Math.max(qty, min), max);

                      if (visibleInput) visibleInput.value = String(newQty);
                      if (masterInput && masterInput !== visibleInput) masterInput.value = String(newQty);

                      ['input', 'change'].forEach(function (type) {
                        if (visibleInput) visibleInput.dispatchEvent(new Event(type, { bubbles: true }));
                        if (masterInput && masterInput !== visibleInput) masterInput.dispatchEvent(new Event(type, { bubbles: true }));
                      });

                      const group = el.closest('[data-volume-rows]') || scope;
                      if (group) {
                        group.querySelectorAll('[data-qty].is-selected').forEach(function (n) {
                          n.classList.remove('is-selected');
                        });
                      }
                      el.classList.add('is-selected');
                    });
                  })();
                </script>
