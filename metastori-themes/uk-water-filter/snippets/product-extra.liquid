<style>

  .spr-content .spr-review {
    width: 100%;
  }

  .spr-header-title {
    margin-top: 0!important;
  }

  #shopify-product-reviews .spr-summary-actions, #shopify-product-reviews .spr-review-reportreview {
    display: none;
  }

  h4 {
    font-size: 1.4em;
    margin-bottom: 20px;
  }
  
  .product__specials h4 {
    color: #d91b1b; /* red */
  }

  .product__specials .featured-collection__content li {
    width: 33.3%
  }

  .product__specials .featured-collection__content .special-deal {
    display: none;
  }

  .product__specials .featured-collection__content .special-deal {
    display: none;
  }

  .product__recommend {
    overflow: hidden;
  }

  .product__recommend [data-rimg-canvas], .product__recommend .atc--button {
    display: none!important;
  }
  
  .product__recommend h4 {
    color: #02A8D2; /* blue */
  }

  .product__recommend .featured-collection__content {
    flex-wrap: wrap;
  }

  .product__recommend .featured-collection__content li {
    width: calc(50% - 10px);
    margin-bottom: 10px;
  }

  .product__recommend .featured-collection__content li .productitem--image img {
    width: 100%;
  }

  @media (min-width: 767px) and (max-width: 1024px) {
    .product__recommend .featured-collection__content li {
      width: calc(25% - 10px);
    }
  }
  
  .product__recommend .featured-collection__content li  .productitem {
    padding: .5rem;
  }

  .product__recommend .featured-collection__content .flickity-button {
    display: block!important;
  }

  .product__recommend .featured-collection__content .flickity-button.previous {
    left: 0;
  }

  .product__recommend .featured-collection__content .flickity-button.next {
    right: 0;
  }

  /* enable Flickity by default */
  .product__recommend .featured-collection__content:after {
    content: 'flickity';
    display: none; /* hide :after */
  }
  
  @media screen and ( min-width: 1024px ) {
    /* disable Flickity for large devices */
    .product__recommend .featured-collection__content:after {
      content: '';
    }
  }

  .product__reasons h4 {
    color: #02A8D2;
    margin-bottom: 20px;

    margin: 0;
    padding: 20px 5px;
    text-align: center;
    line-height: 1em;
    background: #02A8D2;
    color: white;
    font-size: 1.3em;
    border-radius: 10px 10px 0 0;
    margin-top: -4px;
  }

  .pr_box {
    
  }

  .pr_box .block {
    display: flex;
    flex-wrap: wrap;
    margin-bottom: 20px;
  }

  .pr_box .block:last-child {
    margin-bottom: 0px;
  }

  .pr_box span {
    font-size: 1.2em;
    font-weight: 600;
    text-align: center;
    width: 44px;
    height: 44px;
    background: #02A8D2;
    border-radius: 50%;
    color: #fff;
    line-height: 44px;
    display: block;
    margin-right: 20px;
  }

  .pr_box p {
    width: calc(100% - 65px);
    margin: 0;
    line-height: 1.5em;
  }

  .pr_box p strong {
    color: #02A8D2;
  }
</style>

{% if product.metafields.custom.special_offers %}

<section class="product__specials" style="margin-bottom: 20px">
  <h4 class="">Todays Special Deals</h4>
  <ul class="product__specials__content">

  {% for product in product.metafields.custom.special_offers.value limit: 3 %}
   <li>
     <div><img src="{{ product.featured_image | image_url: width: 400, height: 400, crop: 'center'}}"></div>

     {% comment %}
     <h3>{{ product.title }}</h3>
     {% if product.compare_at_price > product.price %}
    {% assign ukspecialprice = product.compare_at_price | minus: product.price %}
     <p>You save {{ ukspecialprice | money }}!</p>
    {% endif %}
    {% endcomment %}
    
     <a href="{{ product.url }}"></a>
     
   </li>

    {% endfor %}


  </ul>
</section>

{% endif %}

<section class="product__reasons">
  <h4 class="">Three great reasons to buy from us</h4>
  <div class="pr_box product-right__block">
    <div class="block">
      <span>1</span>
      <p><strong>We're well established</strong> - We've been trading for about twenty years. So we won't be disappearing. Your Money Back Guarantee and Warranty will be safe.</p>
    </div>
    <div class="block">
      <span>2</span>
      <p><strong>Join thousands of happy customers</strong> - Many of our clients have been buying filters from us for several years. They keep coming back because we offer a friendly, helpful service and great value prices.</p>
    </div>
    <div class="block">
      <span>3</span>
      <p><strong>We're trustworthy</strong> - We have a huge number of great testimonials. For example see our reviews on the Approved Consumer Code Directory for the Trading Standards Institute and other independent ones on Google Certified Shops.</p>
    </div>
  </div>
</section>

<style>
