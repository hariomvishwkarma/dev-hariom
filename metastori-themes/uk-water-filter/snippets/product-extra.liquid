<section class="product__recommend">

<div
  class="product-recommendations"
  data-url="{{ routes.product_recommendations_url }}?section_id={{ section.id }}&product_id={{ product.id }}&limit=4&intent=related"
>
  {%- if recommendations.performed? and recommendations.products_count > 0 -%}
    <h4 class="">You May Also Like</h4>
    <ul class="featured-collection__content" data-flickity='{ "cellAlign": "left", "contain": true, "watchCSS": true, "pageDots": false, "prevNextButtons": true }'>
      {%- for productz in recommendations.products -%}
        {%
        render 'product-grid-item',
        product: productz,
      %}
      {%- endfor -%}
    </ul>
  {%- endif -%}
</div>
</section>

