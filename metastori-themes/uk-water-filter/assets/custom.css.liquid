/*
  All rules are scoped to #wf-tiles-root so they cannot
  leak out and affect any other element on the page.
*/

#wf-tiles-root {
  margin: 1.5rem 0;
  font-family: inherit;
}

#wf-tiles-root .wf-tiles-wrap {
  max-width: 860px;
  margin: 0 auto;
}

#wf-tiles-root .wf-tiles-heading {
  font-size: 20px;
  font-weight: 600;
  color: #1a3a5c;
  text-align: center;
  margin-bottom: 1rem;
  line-height: 1.3;
}

/* ── Grid ── */
#wf-tiles-root .wf-tiles-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 12px;
}

/* ── Individual tile ── */
#wf-tiles-root .wf-tile {
  background: #ffffff;
  border: 1px solid #d0d8df;
  border-radius: 6px;
  padding: 1.2rem 1rem 1rem;
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
  transition: border-color .18s, box-shadow .18s;
  box-sizing: border-box;
}

#wf-tiles-root .wf-tile:hover {
  border-color: #a0bcd4;
  box-shadow: 0 2px 10px rgba(26, 58, 92, .08);
}

/* ── Icon circle ── */
#wf-tiles-root .wf-tile__icon {
  width: 52px;
  height: 52px;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: .85rem;
  flex-shrink: 0;
}

#wf-tiles-root .wf-tile__icon svg {
  width: 26px;
  height: 26px;
  fill: none;
  stroke-width: 1.7;
  stroke-linecap: round;
  stroke-linejoin: round;
}

/* ── Icon colours per tile ── */
#wf-tiles-root .wf-tile--chlorine  .wf-tile__icon { background: #e8f1f8; }
#wf-tiles-root .wf-tile--chlorine  .wf-tile__icon svg { stroke: #1a5c7a; }

#wf-tiles-root .wf-tile--plumber   .wf-tile__icon { background: #eaf5ef; }
#wf-tiles-root .wf-tile--plumber   .wf-tile__icon svg { stroke: #2e7d4f; }

#wf-tiles-root .wf-tile--reminder  .wf-tile__icon { background: #fdf3e8; }
#wf-tiles-root .wf-tile--reminder  .wf-tile__icon svg { stroke: #e07b28; }

#wf-tiles-root .wf-tile--bpa       .wf-tile__icon { background: #f0eefb; }
#wf-tiles-root .wf-tile--bpa       .wf-tile__icon svg { stroke: #5b46b8; }

#wf-tiles-root .wf-tile--savings   .wf-tile__icon { background: #eaf5ef; }
#wf-tiles-root .wf-tile--savings   .wf-tile__icon svg { stroke: #2e7d4f; }

#wf-tiles-root .wf-tile--guarantee .wf-tile__icon { background: #fdf3e8; }
#wf-tiles-root .wf-tile--guarantee .wf-tile__icon svg { stroke: #e07b28; }

/* ── Text ── */
#wf-tiles-root .wf-tile__title {
  font-size: 13px;
  font-weight: 600;
  color: #1a3a5c;
  margin-bottom: .35rem;
  line-height: 1.3;
}

#wf-tiles-root .wf-tile__desc {
  font-size: 12px;
  color: #5a6a77;
  line-height: 1.6;
  font-weight: 400;
  margin: 0;
}

#wf-tiles-root .wf-tile__desc strong {
  font-weight: 600;
}

#wf-tiles-root .wf-tile--savings   .wf-tile__desc strong { color: #2e7d4f; }
#wf-tiles-root .wf-tile--guarantee .wf-tile__desc strong { color: #c46618; }

/* ── Responsive ── */
@media (max-width: 640px) {
  #wf-tiles-root .wf-tiles-grid {
    grid-template-columns: repeat(2, 1fr);
  }
}

@media (max-width: 380px) {
  #wf-tiles-root .wf-tiles-grid {
    grid-template-columns: 1fr;
  }

