      <script>
        document.addEventListener("DOMContentLoaded", function () {
          if (window.location.search.includes("page=")) {
            const targetElement = document.querySelector("#nav-productgrid--utils-container");
            if (targetElement) {
              targetElement.scrollIntoView({ behavior: "smooth" });
            }
          }
          if (window.innerWidth > 768) {
            const target = document.querySelector('#nav-productgrid--utils-container');
            const destination = document.querySelector('.collection_meta_review');

            if (target && destination && !destination.contains(target)) {
              destination.appendChild(target);
              target.style.display = 'block';
            } else {
              const observer = new MutationObserver(function () {
                const target = document.querySelector('#nav-productgrid--utils-container');
                const destination = document.querySelector('.collection_meta_review');

                if (target && destination && !destination.contains(target)) {
                  destination.appendChild(target);
                  target.style.display = 'block';
                  observer.disconnect();
                }
              });

              observer.observe(document.body, {
                childList: true,
                subtree: true
              });
            }
          }
        });
      </script>
