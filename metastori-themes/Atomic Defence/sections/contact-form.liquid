    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "section_bg",
      "label": "Section background",
      "default": "#EAEAEA"
    },
    {
      "type": "color",
      "id": "form_bg",
      "label": "Form card background",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading color",
      "default": "#0A0A0A"
    },
    {
      "type": "color",
      "id": "subheading_color",
