<style>
  #ContactForm {
    --section-bg: {{ section.settings.section_bg }};
    --form-bg: {{ section.settings.form_bg }};
    --heading-color: {{ section.settings.heading_color }};
    --subheading-color: {{ section.settings.subheading_color }};
    --label-color: {{ section.settings.label_color }};
    --input-bg: {{ section.settings.input_bg }};
    --input-border: {{ section.settings.input_border }};
    --input-text: {{ section.settings.input_text }};
    --button-bg: {{ section.settings.button_bg }};
    --button-text: {{ section.settings.button_text }};
    --button-hover-bg: {{ section.settings.button_hover_bg }};
    --arrow-color: {{ section.settings.arrow_color }};
    --section-padding-top: {{ section.settings.padding_top }}px;
    --section-padding-bottom: {{ section.settings.padding_bottom }}px;
    --form-radius: {{ section.settings.form_radius }}px;
    --input-radius: {{ section.settings.input_radius }}px;
    --button-radius: {{ section.settings.button_radius }}px;
  }

  #ContactForm .contact-form-wrapper {
    background-color: var(--section-bg);
    padding-top: var(--section-padding-top);
    padding-bottom: var(--section-padding-bottom);
  }

  #ContactForm .contact-form-container {
    display: flex;
    gap: 88px;
  }

  #ContactForm .contact-form-left {
    position: relative;
    padding-left: 20px;
    max-width: 291px;
  }

  #ContactForm .contact-form-heading {
    font-size: {{ section.settings.heading_size }}px;
    color: var(--heading-color);
    margin: 0 0 20px 0;
    font-family: Montserrat;
    font-weight: 700;
    line-height: 50.4px;
    letter-spacing: 0.45px;
    vertical-align: middle;
    text-transform: capitalize;
  }

  #ContactForm .contact-form-subheading {
    font-size: {{ section.settings.subheading_size }}px;
    color: var(--subheading-color);
    margin: 0 0 40px 0;
    font-family: Montserrat;
    font-weight: 500;
    line-height: 28px;
    letter-spacing: 0px;
  }

  #ContactForm .contact-form-arrow {
    margin-top: 65px;
    color: var(--arrow-color);
    justify-self: right;
  }

  #ContactForm .contact-form-right {
    background-color: var(--form-bg);
    border-radius: var(--form-radius);
    padding: 30px;
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.05);
    width: 100%;
  }

  #ContactForm .form-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 20px 30px;
  }

  #ContactForm .form-field {
    display: flex;
    flex-direction: column;
  }

  #ContactForm .form-field label {
    font-size: 14px;
    font-weight: 500;
    color: var(--label-color);
    margin-bottom: 8px;
  }

  #ContactForm .form-field input,
  #ContactForm .form-field textarea {
    background-color: var(--input-bg);
    border: 1px solid var(--input-border);
    border-radius: var(--input-radius);
    padding: 12px 14px;
    font-size: 14px;
    color: var(--input-text);
    font-family: inherit;
    width: 100%;
    box-sizing: border-box;
    transition: border-color 0.2s ease, box-shadow 0.2s ease;
  }

  #ContactForm .form-field input:focus,
  #ContactForm .form-field textarea:focus {
    outline: none;
    border-color: var(--button-bg);
    box-shadow: 0 0 0 3px {{ section.settings.button_bg | color_modify: 'alpha', 0.15 }};
  }

  #ContactForm .form-submit-wrapper {
    grid-column: 1 / -1;
    margin-top: 10px;
  }

  #ContactForm .form-submit {
    width: 100%;
    background-color: var(--button-bg);
    color: var(--button-text);
    border: none;
    border-radius: var(--button-radius);
    padding: 16px 24px;
    font-size: 16px;
    font-weight: 700;
    cursor: pointer;
    transition: background-color 0.2s ease, transform 0.1s ease;
    font-family: inherit;
  }

  #ContactForm .form-submit:hover {
    background-color: var(--button-hover-bg);
  }

  #ContactForm .form-submit:active {
    transform: scale(0.99);
  }

  #ContactForm .form-message {
    grid-column: 1 / -1;
    padding: 12px 16px;
    border-radius: var(--input-radius);
    margin-bottom: 10px;
    font-size: 14px;
  }

  #ContactForm .form-message--success {
    background-color: #e6f7ed;
    color: #1a7f3e;
    border: 1px solid #b8e0c5;
  }

  #ContactForm .form-message--error {
    background-color: #fde8e8;
    color: #c81e1e;
    border: 1px solid #fbb6b6;
  }

  @media screen and (min-width: 900px) {
    svg.contact-form-svg-mobile {
      display: none;
    }
  }

  @media screen and (max-width: 900px) {
    .contact-form-arrow {
      position: absolute;
      bottom: -58px;
      right: 83px;
    }
    svg.contact-form-svg-desktop {
      display: none;
    }
    #ContactForm .contact-form-container {
      flex-direction: column;
      gap: 47px;
      padding: 20px;
    }

    #ContactForm .contact-form-left {
      text-align: center;
      padding: 0 20px;
      max-width: 100%;
    }

    p.contact-form-subheading {
        margin: 0 !important;
        font-size: 16px !important;
    }

    #ContactForm .contact-form-right {
      padding: 25px 20px;
    }

    #ContactForm .form-grid {
      grid-template-columns: 1fr;
      gap: 16px;
    }

    #ContactForm .contact-form-heading {
      font-size: 22.5px;
      margin-bottom: 18px;
      padding: 0 34px;
      line-height: 30px;
    }
  }
</style>

{%- comment -%} Collect app embed blocks (type: app) {%- endcomment -%}
{%- assign app_blocks = section.blocks | where: 'type', 'app' -%}


<div id="ContactForm">
  <div class="contact-form-wrapper">
    <div class="contact-form-container">

      {%- comment -%} Left side: heading + subheading + arrow {%- endcomment -%}
      <div class="contact-form-left">
        {%- if section.settings.heading != blank -%}
          <h2 class="contact-form-heading">{{ section.settings.heading }}</h2>
        {%- endif -%}

        {%- if section.settings.subheading != blank -%}
          <p class="contact-form-subheading">{{ section.settings.subheading }}</p>
        {%- endif -%}

        {%- if section.settings.show_arrow -%}
          <div class="contact-form-arrow">
            <svg class="contact-form-svg-mobile" xmlns="http://www.w3.org/2000/svg" width="29" height="46" viewBox="0 0 29 46" fill="none">
              <path d="M22.6936 1.00014C27.0639 4.11138 29.3288 5.81161 26.5564 10.5127C25.1676 12.8679 23.6373 13.4757 21.2793 12.7095C19.7118 12.2002 20.8302 9.95598 22.4388 10.4786C24.5378 11.1607 26.3124 12.6634 27.0901 14.8149C28.9065 19.8393 23.1996 25.344 19.364 27.2984C17.8401 28.0749 14.5074 27.3387 16.562 25.5187C18.0131 24.2333 20.4327 26.0841 21.0642 27.4162C23.9248 33.4503 17.4031 37.4821 12.981 39.7353C11.4951 40.4924 8.20138 41.8679 6.5846 41.8099C5.27417 41.7629 8.38883 45.6425 6.93141 43.492C6.08803 42.2476 5.0184 39.9523 5.33137 38.3846C5.48233 37.6285 3.25796 41.3808 2.78742 41.9041C1.99795 42.7821 -0.00545207 44.752 1.61598 44.4691C2.95847 44.2349 5.18993 43.9885 6.42263 44.3891" stroke="#121212" stroke-width="2" stroke-linecap="round"/>
            </svg>
            <svg class="contact-form-svg-desktop" xmlns="http://www.w3.org/2000/svg" width="163" height="130" viewBox="0 0 163 130" fill="none">
              <path d="M11.4975 2.50051C1.57183 20.7412 -3.4232 30.5001 14.1999 42.1517C23.0286 47.9889 29.3841 47.5069 36.2879 40.8399C40.8774 36.4079 33.1779 30.4977 28.4682 35.0457C22.3225 40.9806 18.6986 49.2202 19.6435 58.0255C21.85 78.5888 51.0465 88.0564 67.7076 88.3474C74.3275 88.4631 84.6734 80.2464 74.4366 77.4009C67.2067 75.3912 61.9291 85.9363 61.9924 91.6423C62.2792 117.49 91.8111 120.451 111.02 120.787C117.475 120.899 131.268 120.096 136.795 117.15C141.274 114.763 137.021 133.546 138.443 123.591C139.265 117.83 139.092 108.03 135.343 103.107C133.534 100.732 147.641 110.012 150.166 111.035C154.402 112.75 164.715 116.204 158.594 117.971C153.526 119.434 145.344 122.364 141.735 125.849" stroke="#121212" stroke-width="5" stroke-linecap="round"/>
            </svg>
          </div>
        {%- endif -%}
      </div>

      {%- comment -%} Right side: app block OR default form {%- endcomment -%}
      <div class="contact-form-right">
        {%- for block in section.blocks -%}
          <div {{ block.shopify_attributes }}>
            {%- render block -%}
          </div>
        {%- endfor -%}
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Wholesale Contact Form",
  "tag": "section",
  "class": "section-wholesale-contact",
  "blocks": [
    {
      "type": "@app"
    }
  ],
  "settings": [
    {
      "type": "header",
      "content": "Text Content"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Fill The Form Contact Us Today"
    },
    {
      "type": "range",
      "id": "heading_size",
      "label": "Heading size",
      "min": 20,
      "max": 60,
      "step": 2,
      "default": 36,
      "unit": "px"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading",
      "default": "Get access to our exclusive offerings"
    },
    {
      "type": "range",
      "id": "subheading_size",
      "label": "Subheading size",
      "min": 12,
      "max": 24,
      "step": 1,
      "default": 16,
      "unit": "px"
    },
    {
      "type": "checkbox",
      "id": "show_arrow",
      "label": "Show decorative arrow",
      "default": true
    },
    {
      "type": "header",
      "content": "Form Field Labels"
    },
    {
      "type": "text",
      "id": "label_org",
      "label": "Organization name label",
      "default": "Organization name"
    },
    {
      "type": "text",
      "id": "label_phone",
      "label": "Phone number label",
      "default": "Phone number"
    },
    {
      "type": "text",
      "id": "label_name",
      "label": "Contact name label",
      "default": "Contact name"
    },
    {
      "type": "text",
      "id": "label_volume",
      "label": "Order volume label",
      "default": "Estimated order volume"
    },
    {
      "type": "text",
      "id": "label_role",
      "label": "Role / Title label",
      "default": "Role/ Title"
    },
    {
      "type": "text",
      "id": "label_category",
      "label": "Categories label",
      "default": "Categories of interest"
    },
    {
      "type": "text",
      "id": "label_email",
      "label": "Email label",
      "default": "Email"
    },
    {
      "type": "text",
      "id": "label_notes",
      "label": "Additional notes label",
      "default": "Additional notes"
    },
    {
      "type": "header",
      "content": "Button & Messages"
    },
    {
      "type": "text",
      "id": "button_text_label",
