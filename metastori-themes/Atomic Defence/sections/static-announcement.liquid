<script
  type="application/json"
  data-section-id="{{ section.id }}"
  data-section-type="static-announcement">
</script>

{% assign show_everywhere = false %}
{% assign homepage_only = false %}

{% if
  section.settings.show_announcement and
  section.settings.homepage_announcement == false
%}
  {% assign show_everywhere = true %}
{% endif %}

{% if
  section.settings.show_announcement and
  section.settings.homepage_announcement and
  template == 'index'
%}
  {% assign homepage_only = true %}
{% endif %}

{% if show_everywhere or homepage_only %}
  {% if
    section.settings.announcement_text != blank or
    section.settings.announcement_text_mobile != blank
  %}
    <div
      class="
        announcement-bar
        {% if section.settings.announcement_text == blank and section.settings.announcement_text_mobile != blank %}
          only-mobile
        {% endif %}
      "
      style="
        color: {{ section.settings.announcement_color }};
        background: {{ section.settings.announcement_background }};
      "
      data-announcement-bar
    >
      {% if section.settings.announcement_link != blank %}
        <a
          class="announcement-bar-link"
          href="{{ section.settings.announcement_link }}"
          ></a>
      {% endif %}

      {% if section.settings.announcement_text != blank %}
        <div class="announcement-bar-text">
          {{ section.settings.announcement_text }}
        </div>
      {% endif %}

      <div class="announcement-bar-text-mobile">
        {% if section.settings.announcement_text_mobile != blank %}
          {% assign announcement_array = section.settings.announcement_text | split: "|" %}
          {% comment %}
          {{ section.settings.announcement_text_mobile }}
          {% endcomment %}
          {{ announcement_array.first }}
        {% else %} 
          {% assign announcement_array = section.settings.announcement_text | split: "|" %}
          <div class="lt" id="lessThan" onclick="bannerMove('lt');">
        &lt;
          </div>
          <div id="banner-inner-txt" style="width: 100%;">{{ announcement_array.first }}</div>
          <div class="gt" onclick="bannerMove('gt');">&gt;</div>
          <script>
    let actualValue = 0;
    
    const bannerMove = (ltOrGt) => {
      let x = 1
      if (ltOrGt === "lt") {
      actualValue = actualValue - 1;
  }
      if (ltOrGt === "gt")  {
      actualValue = actualValue + 1;
      }
      const bannerInner = document.getElementById("banner-inner-txt");
      let sayings = '{{announcement_array}}';
      sayings = sayings.split("  ")
      // New code
      
      // End new code
      if (actualValue <= 0) {
        const text = sayings[0];
        bannerInner.innerHTML = text;
        actualValue = 1;
      }
      else if (actualValue < sayings.length - 1 && actualValue > 0) {
        const text = sayings[actualValue];
        bannerInner.innerHTML = text;
      }
        else if (actualValue == sayings.length - 1 && actualValue > 0) {
          const text = sayings[actualValue];
          bannerInner.innerHTML = text;
          actualValue = 0;
        }
     else if (actualValue > sayings.length - 1) {
      actualValue = sayings.length - 1;
     }
    
      
  }
    
  </script>
          <script defer>
      let sayings = '{{announcement_array}}';
      sayings = sayings.split("  ")
      console.log(sayings)
      setInterval(function () { 
        for (let i = 0; i <= sayings.length - 1; i++) {
            if (actualValue >= sayings.length - 1) {
                for (let j = sayings.length - 1; j >= 0; j--) {
                  bannerMove("lt");
                }
                setTimeout(() => {}, 1000)
                break; 
            } 
            if (i + 1 < sayings.length) {
                bannerMove("gt");
                setTimeout(() => {}, 1000)
                //setTimeout(removeActive, 350, sayings[i]); 
                //addActive(sayings[i + 1]); 
                break; 
            } 
        } 
    }, 2000); 
    </script>
          {% comment %}
          {{ section.settings.announcement_text }}
          {% endcomment %}
        {% endif %}
      </div>
    </div>
  {% endif %}
{% endif %}

{% schema %}
{
  "name": "t:sections.announcement_bar.name",
  "class": "site-announcement",
  "settings": [
    {
      "type": "header",
      "content": "t:sections.announcement_bar.header_1.content"
    },
    {
      "type": "checkbox",
      "id": "show_announcement",
      "label": "t:sections.announcement_bar.show_announcement.label",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "homepage_announcement",
      "label": "t:sections.announcement_bar.homepage_announcement.label",
      "default": false
    },
    {
      "id": "announcement_text",
      "type": "textarea",
      "label": "t:sections.announcement_bar.announcement_text.label",
      "default": "Announce something here"
    },
    {
      "id": "announcement_text_mobile",
      "type": "textarea",
      "label": "t:sections.announcement_bar.announcement_text_mobile.label",
      "info": "t:sections.announcement_bar.announcement_text_mobile.info"
    },
    {
      "id": "announcement_link",
      "type": "url",
      "label": "t:sections.announcement_bar.announcement_link.label"
    },
    {
      "id": "announcement_color",
      "type": "color",
      "label": "t:sections.announcement_bar.announcement_color.label",
      "default": "#000000"
    },
    {
      "id": "announcement_background",
      "type": "color",
      "label": "t:sections.announcement_bar.announcement_background.label",
      "default": "#f5f3ed"
    }
  ]
}

{% endschema %}