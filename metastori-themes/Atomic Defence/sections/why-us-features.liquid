{% comment %}
  Section: Why Us - Features Grid
  Description: A customizable features section with subtitle, title, and icon-based feature blocks
{% endcomment %}

<div class="why-us-section" id="why-us-{{ section.id }}">
  <div class="why-us-container">
    {% if section.settings.subtitle != blank %}
      <p class="why-us-subtitle">{{ section.settings.subtitle }}</p>
    {% endif %}

    {% if section.settings.title != blank %}
      <h2 class="why-us-title">{{ section.settings.title }}</h2>
    {% endif %}

    {% if section.blocks.size > 0 %}
      <div class="why-us-grid why-us-grid--{{ section.settings.columns }}">
        {% for block in section.blocks %}
          <div class="why-us-item" {{ block.shopify_attributes }}>
            <div class="why-us-icon">
              {% if block.settings.icon_image != blank %}
                <img
                  src="{{ block.settings.icon_image | image_url: width: 100 }}"
                  alt="{{ block.settings.heading | escape }}"
                  width="40"
                  height="40"
                  loading="lazy"
                >
              {% elsif block.settings.icon_svg != blank %}
                {{ block.settings.icon_svg }}
              {% else %}
                <svg xmlns="http://www.w3.org/2000/svg" width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <circle cx="12" cy="12" r="10"></circle>
                  <polyline points="9 12 11 14 15 10"></polyline>
                </svg>
              {% endif %}
            </div>

            {% if block.settings.heading != blank %}
              <p class="why-us-item-heading">{{ block.settings.heading }}</p>
            {% endif %}

            {% if block.settings.description != blank %}
              <p class="why-us-item-description">{{ block.settings.description }}</p>
            {% endif %}
          </div>
        {% endfor %}
      </div>
    {% endif %}
  </div>
</div>

{% stylesheet %}
  .why-us-section {
    padding: 60px 20px;
    background-color: var(--why-us-bg, #ffffff);
  }

  .why-us-container {
    /* max-width: 1200px;
    margin: 0 auto; */
  }

  .why-us-subtitle {
    color: var(--why-us-subtitle-color, #2563eb);
    margin: 0 0 6px;
    font-family: Montserrat;
    font-weight: 600;
    font-size: 17px;
    line-height: 25.88px;
    letter-spacing: 0.45px;
    text-align: center;
    vertical-align: middle;
    text-transform: capitalize;
  }

  .why-us-title {
    color: var(--why-us-title-color, #111111);
    margin: 0 0 45px;
    font-family: Montserrat;
    font-weight: 700;
    font-size: 22.5px;
    line-height: 25.88px;
    letter-spacing: 0.45px;
    text-align: center;
    vertical-align: middle;
    text-transform: capitalize;
  }

  .why-us-grid {
    display: grid;
    gap: 32px 30px;
  }

  .why-us-grid--2 {
    grid-template-columns: repeat(2, 1fr);
  }

  .why-us-grid--3 {
    grid-template-columns: repeat(3, 1fr);
  }

  .why-us-grid--4 {
    grid-template-columns: repeat(4, 1fr);
  }

  .why-us-item {
    text-align: center;
    max-width: 300px;
    justify-self: center;
  }

  .why-us-icon {
    color: var(--why-us-icon-color, #111111);
    margin-bottom: 11px;
    display: flex;
    justify-content: center;
    align-items: center;
  }

  .why-us-icon img,
  .why-us-icon svg {
    max-width: 50px;
    height: auto;
  }

  .why-us-item-heading {
    margin-top: 0;
    color: var(--why-us-item-heading-color, #333333);
    font-family: Montserrat;
    margin-bottom: 13px;;
    font-weight: 500;
    font-size: 18.8px;
    line-height: 26.25px;
    letter-spacing: 0%;
    text-align: center;
    vertical-align: middle;
  }

  .why-us-item-description {
    color: var(--why-us-item-description-color, #666666);
    font-size: 14px;
    line-height: 1.5;
    margin: 0;
  }

  @media screen and (max-width: 749px) {
    .why-us-grid--3,
    .why-us-grid--4 {
      grid-template-columns: repeat(2, 1fr);
    }
    p.why-us-item-heading {
        font-size: 15px;
        line-height: 24.4px;
    }
    .why-us-icon svg {
        width: 26px;
    }
  }

  @media screen and (max-width: 600px) {

    .why-us-title {
      font-size: 22.5px;
      margin-bottom: 32px;
    }

    .why-us-grid--2,
    .why-us-grid--3,
    .why-us-grid--4 {
      gap: 20px;
    }
  }
{% endstylesheet %}

<style>
  #why-us-{{ section.id }} {
    --why-us-bg: {{ section.settings.background_color }};
    --why-us-subtitle-color: {{ section.settings.subtitle_color }};
    --why-us-title-color: {{ section.settings.title_color }};
    --why-us-icon-color: {{ section.settings.icon_color }};
    --why-us-item-heading-color: {{ section.settings.item_heading_color }};
    --why-us-item-description-color: {{ section.settings.item_description_color }};
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }
</style>

{% schema %}
{
  "name": "Why Us Features",
  "tag": "section",
  "class": "section-why-us",
  "settings": [
    {
      "type": "header",
      "content": "Heading Content"
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "Why Atomic Defense"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Title",
      "default": "See What Sets Us Apart"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "columns",
      "label": "Columns on desktop",
      "options": [
        { "value": "2", "label": "2 columns" },
        { "value": "3", "label": "3 columns" },
        { "value": "4", "label": "4 columns" }
      ],
      "default": "3"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "min": 0,
      "max": 150,
      "step": 10,
      "unit": "px",
      "default": 60
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 150,
      "step": 10,
      "unit": "px",
      "default": 60
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "subtitle_color",
      "label": "Subtitle color",
      "default": "#2563eb"
    },
    {
      "type": "color",
      "id": "title_color",
      "label": "Title color",
      "default": "#111111"
    },
    {
      "type": "color",
      "id": "icon_color",
      "label": "Icon color (for SVG icons)",
      "default": "#111111"
    },
    {
      "type": "color",
      "id": "item_heading_color",
      "label": "Feature heading color",
      "default": "#333333"
    },
    {
      "type": "color",
      "id": "item_description_color",
      "label": "Feature description color",
      "default": "#666666"
    }
  ],
  "blocks": [
    {
      "type": "feature",
      "name": "Feature",
      "settings": [
        {
          "type": "header",
          "content": "Icon"
        },
        {
          "type": "paragraph",
          "content": "Upload an image OR paste SVG code. Image takes priority if both are provided."
        },
        {
          "type": "image_picker",
          "id": "icon_image",
          "label": "Icon image"
        },
        {
          "type": "html",
          "id": "icon_svg",
          "label": "Icon SVG code",
          "info": "Paste raw SVG markup. Use fill='currentColor' or stroke='currentColor' to inherit the icon color."
        },
        {
          "type": "header",
          "content": "Content"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Feature heading"
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "Description (optional)"
        }
      ]
    }
  ],
  "max_blocks": 12,
  "presets": [
    {
      "name": "Why Us Features",
      "blocks": [
        {
