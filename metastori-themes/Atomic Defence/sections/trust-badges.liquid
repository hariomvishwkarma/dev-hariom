{% comment %}
  Section: Why Customers Trust Us
  Description: Displays trust stats/badges with customizable values, labels, and styling
{% endcomment %}

<section
  class="trust-badges-section"
  style="
    background-color: {{ section.settings.background_color }};
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  "
>
  <div class="trust-badges__container">
    {% if section.settings.heading != blank %}
      <h2
        class="trust-badges__heading"
        style="
          color: {{ section.settings.heading_color }};
          font-size: {{ section.settings.heading_size }}px;
        "
      >
        {{ section.settings.heading }}
      </h2>
    {% endif %}

    <div class="trust-badges__grid">
      {% for block in section.blocks %}
        <div class="trust-badges__item" {{ block.shopify_attributes }}>
          {% if block.settings.stat_value != blank %}
            <div
              class="trust-badges__stat"
              style="
                color: {{ block.settings.stat_color }};
                font-size: {{ section.settings.stat_size }}px;
              "
            >
              {{ block.settings.stat_value }}
            </div>
          {% endif %}

          {% if block.settings.label != blank %}
            <div
              class="trust-badges__label"
              style="
                color: {{ section.settings.label_color }};
                font-size: {{ section.settings.label_size }}px;
              "
            >
              {{ block.settings.label }}
            </div>
          {% endif %}
          {% if block.settings.label != blank %}
            <div
              class="trust-badges__label--mobile"
              style="
                color: {{ section.settings.label_color }};
              "
            >
              {{ block.settings.mobile_label }}
            </div>
          {% endif %}

          {% if block.settings.description != blank %}
            <div
              class="trust-badges__description"
              style="
                color: {{ section.settings.description_color }};
                font-size: {{ section.settings.description_size }}px;
              "
            >
              {{ block.settings.description }}
            </div>
          {% endif %}
        </div>

        {% unless forloop.last %}
          <div
            class="trust-badges__divider"
            style="background-color: {{ section.settings.divider_color }};"
          ></div>
        {% endunless %}
      {% endfor %}
    </div>
  </div>
</section>

{% stylesheet %}

  .trust-badges-section {
    width: 100%;
  }
  .trust-badges__label--mobile {
    display: none;
    font-family: Montserrat;
    font-weight: 500;
    font-size: 13px;
    line-height: 20px;
    letter-spacing: 0%;
    text-align: center;
  }
  .trust-badges__heading {
    font-family: Montserrat;
    font-weight: 700;
    font-style: Bold;
    font-size: 22.5px;
    line-height: 25.88px;
    letter-spacing: 0.45px;
    text-align: center;
    vertical-align: middle;
    text-transform: capitalize;

    margin: 0 0 40px 0;
  }

  .trust-badges__grid {
    display: flex;
    align-items: stretch;
    justify-content: center;
    flex-wrap: nowrap;
    gap: 0;
  }

  .trust-badges__item {
    flex: 1;
    min-width: 0;
    text-align: center;
    padding: 20px;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: flex-start;
  }

  .trust-badges__divider {
    width: 1px;
    align-self: stretch;
    margin: 10px 0;
    flex-shrink: 0;
  }

  .trust-badges__stat {
    font-family: Montserrat;
    font-weight: 600;
    line-height: 100%;
    letter-spacing: 0%;
    text-align: center;
    vertical-align: bottom;
    margin-bottom: 16px;
  }

  .trust-badges__label {
    font-family: Montserrat;
    font-weight: 700;
    line-height: 22px;
    letter-spacing: 0%;
    text-align: center;
    vertical-align: bottom;
    margin-bottom: 12px;
  }

  .trust-badges__description {
    font-family: Montserrat;
    font-weight: 400;
    line-height: 20px;
    letter-spacing: 0%;
    text-align: center;
    vertical-align: middle;
  }

  @media screen and (max-width: 749px) {
    .trust-badges__label--mobile {
      display: block;
    }

    .trust-badges__heading {
      font-size: 18px;
      line-height: 22px;
      margin: 0 0 24px 0;
    }

    .trust-badges__label, .trust-badges__description {
      display: none;
    }

    .trust-badges__item {
      padding: 10px 6px;
    }

    .trust-badges__stat {
      font-size: 30px !important;
      margin-bottom: 10px;
      FONT-WEIGHT: 400;
    }

    .trust-badges__label {
      font-size: 12px !important;
      line-height: 16px;
      margin-bottom: 6px;
    }

    .trust-badges__description {
      font-size: 10px !important;
      line-height: 14px;
    }

    .trust-badges__divider {
      margin: 6px 0;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Trust Badges",
  "tag": "section",
  "class": "section-trust-badges",
  "settings": [
    {
      "type": "header",
      "content": "Heading"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading text",
      "default": "Why Customers Trust Us"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading color",
      "default": "#1a1a1a"
    },
    {
      "type": "range",
      "id": "heading_size",
      "label": "Heading font size",
      "min": 16,
      "max": 48,
      "step": 1,
      "unit": "px",
      "default": 22
    },
    {
      "type": "header",
      "content": "Typography"
    },
    {
      "type": "range",
      "id": "stat_size",
      "label": "Stat value font size",
      "min": 24,
      "max": 80,
      "step": 1,
      "unit": "px",
      "default": 42
    },
    {
      "type": "range",
      "id": "label_size",
      "label": "Label font size",
      "min": 12,
      "max": 24,
      "step": 1,
      "unit": "px",
      "default": 15
    },
    {
      "type": "color",
      "id": "label_color",
      "label": "Label color",
      "default": "#1a1a1a"
    },
    {
      "type": "range",
      "id": "description_size",
      "label": "Description font size",
      "min": 10,
      "max": 20,
      "step": 1,
      "unit": "px",
      "default": 13
    },
    {
      "type": "color",
      "id": "description_color",
      "label": "Description color",
      "default": "#6b7280"
    },
    {
      "type": "header",
      "content": "Layout & Background"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "divider_color",
      "label": "Divider color",
      "default": "#e5e7eb"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 60
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 60
    }
  ],
  "blocks": [
    {
      "type": "badge",
      "name": "Trust Badge",
      "limit": 6,
      "settings": [
        {
          "type": "liquid",
          "id": "stat_value",
          "label": "Stat value",
          "info": "Example: 12, 4.8, A+",
          "default": "12"
        },
        {
          "type": "color",
          "id": "stat_color",
          "label": "Stat color",
          "default": "#1e63b8"
        },
        {
          "type": "text",
          "id": "label",
          "label": "Label",
          "default": "years of experience"
        },
        {
          "type": "liquid",
          "id": "mobile_label",
          "label": "Mobile label"
        },
        {
          "type": "liquid",
          "id": "description",
          "label": "Description",
          "default": "helpful advice and lifetime support"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Trust Badges",
      "blocks": [
        {
          "type": "badge",
          "settings": {
            "stat_value": "12",
            "label": "years of experience",
            "description": "helpful advice and lifetime support"
          }
        },
        {
          "type": "badge",
          "settings": {
            "stat_value": "4.8",
            "label": "rating on Judge me",
            "description": "from 1700+ reviews"
          }
        },
        {
          "type": "badge",
          "settings": {
            "stat_value": "A+",
            "label": "rating and accreditation",
            "description": "by the Better Business Bureau®"
          }
        }
      ]
    }
  ]
}
{% endschema %}
