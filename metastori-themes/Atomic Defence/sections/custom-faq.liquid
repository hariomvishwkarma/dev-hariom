{% comment %}
  FAQs Section
  - Two-column accordion layout
  - Fully customizable via theme editor
{% endcomment %}

<section
  id="section-{{ section.id }}"
  class="faqs-section"
  style="
    --faq-bg: {{ section.settings.background_color }};
    --faq-card-bg: {{ section.settings.card_background_color }};
    --faq-card-border: {{ section.settings.card_border_color }};
    --faq-title-color: {{ section.settings.title_color }};
    --faq-question-color: {{ section.settings.question_color }};
    --faq-answer-color: {{ section.settings.answer_color }};
    --faq-icon-color: {{ section.settings.icon_color }};
    --faq-card-radius: {{ section.settings.card_radius }}px;
    --faq-padding-top: {{ section.settings.padding_top }}px;
    --faq-padding-bottom: {{ section.settings.padding_bottom }}px;
  "
>
  <div class="faqs-container">
    {% if section.settings.heading != blank %}
      <h2 class="faqs-heading">{{ section.settings.heading }}</h2>
    {% endif %}

    {% if section.settings.subheading != blank %}
      <p class="faqs-subheading">{{ section.settings.subheading }}</p>
    {% endif %}

    {% if section.blocks.size > 0 %}
      {% assign columns = section.settings.columns | plus: 0 %}
      {% if columns == 2 %}
        {% assign half = section.blocks.size | divided_by: 2.0 | ceil %}
      {% else %}
        {% assign half = section.blocks.size %}
      {% endif %}

      <div class="faqs-grid faqs-grid--{{ section.settings.columns }}">
        <div class="faqs-column">
          {% for block in section.blocks %}
            {% if forloop.index0 < half %}
              <details
                class="faq-item"
                {{ block.shopify_attributes }}
                {% if block.settings.open_by_default %}open{% endif %}
              >
                <summary class="faq-question">
                  <span class="faq-question-text">{{ block.settings.question }}</span>
                  <span class="faq-icon" aria-hidden="true">
                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                      <polyline points="6 9 12 15 18 9"></polyline>
                    </svg>
                  </span>
                </summary>
                <div class="faq-answer">
                  {{ block.settings.answer }}
                </div>
              </details>
            {% endif %}
          {% endfor %}
        </div>

        {% if columns == 2 %}
          <div class="faqs-column">
            {% for block in section.blocks %}
              {% if forloop.index0 >= half %}
                <details
                  class="faq-item"
                  {{ block.shopify_attributes }}
                  {% if block.settings.open_by_default %}open{% endif %}
                >
                  <summary class="faq-question">
                    <span class="faq-question-text">{{ block.settings.question }}</span>
                    <span class="faq-icon" aria-hidden="true">
                      <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <polyline points="6 9 12 15 18 9"></polyline>
                      </svg>
                    </span>
                  </summary>
                  <div class="faq-answer">
                    {{ block.settings.answer }}
                  </div>
                </details>
              {% endif %}
            {% endfor %}
          </div>
        {% endif %}
      </div>
    {% else %}
      <p class="faqs-empty">Add FAQ blocks from the theme editor to get started.</p>
    {% endif %}
  </div>
</section>

<style>
  #section-{{ section.id }}.faqs-section {
    background-color: var(--faq-bg);
    padding-top: var(--faq-padding-top);
    padding-bottom: var(--faq-padding-bottom);
  }

  #section-{{ section.id }} .faqs-heading {
    color: var(--faq-title-color);
    margin: 0 0 12px 0;
    font-family: Montserrat;
    font-weight: 700;
    font-size: {{ section.settings.heading_size }}px;
    line-height: 25.88px;
    letter-spacing: 0.45px;
    text-align: center;
    vertical-align: middle;
    text-transform: capitalize;
  }

  #section-{{ section.id }} .faqs-subheading {
    text-align: center;
    color: var(--faq-answer-color);
    margin: 0 auto 32px auto;
    max-width: 600px;
    font-size: 15px;
    line-height: 1.5;
  }

  #section-{{ section.id }} .faqs-grid {
    margin-top: 24px;
    display: flex;
    gap: {{ section.settings.item_gap }}px;
    align-items: flex-start;
  }

  #section-{{ section.id }} .faqs-column {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: {{ section.settings.item_gap }}px;
    min-width: 0;
  }

  #section-{{ section.id }} .faqs-grid--1 {
    flex-direction: column;
  }

  @media (max-width: 749px) {
    #section-{{ section.id }} .faqs-grid {
      flex-direction: column;
    }
  }

  /* FAQ ITEM - padding hata diya, ab summary khud apni padding sambhalegi */
  #section-{{ section.id }} .faq-item {
    background-color: var(--faq-card-bg);
    border: 1px solid var(--faq-card-border);
    border-radius: var(--faq-card-radius);
    padding: 0; /* changed from 16px to 0 so summary fills the whole card */
    transition: box-shadow 0.2s ease, border-color 0.2s ease;
    overflow: hidden; /* radius ke andar content rahe */
  }

  #section-{{ section.id }} .faq-item[open] {
    border-color: var(--faq-card-border);
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.04);
  }

  /* SUMMARY ab pure card ko cover karta hai - full clickable area */
  #section-{{ section.id }} .faq-question {
    list-style: none;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    color: var(--faq-question-color);
    font-weight: 600;
    font-size: {{ section.settings.question_size }}px;
    line-height: 1.4;
    user-select: none;
    padding: 16px; /* padding ab yahaan - poora area clickable */
    width: 100%;
    box-sizing: border-box;
  }

  .faq-answer a {
    color: var(--faq-answer-color);
  }

  #section-{{ section.id }} .faq-question::-webkit-details-marker {
    display: none;
  }

  #section-{{ section.id }} .faq-question-text {
    flex: 1;
    font-family: Montserrat;
    font-weight: 600;
    line-height: 24px;
    letter-spacing: 0px;
    font-size: 15px;
  }

  #section-{{ section.id }} .faq-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    color: var(--faq-icon-color);
    transition: transform 0.25s ease;
    flex-shrink: 0;
  }

  #section-{{ section.id }} .faq-item[open] .faq-icon {
    transform: rotate(180deg);
  }

  /* Answer ke liye horizontal padding summary se match kare */
  #section-{{ section.id }} .faq-answer {
    color: var(--faq-answer-color);
    font-size: {{ section.settings.answer_size }}px;
    line-height: 1.6;
    padding: 0 16px 16px 16px;
    overflow: hidden;
    transition: height 0.35s ease, opacity 0.35s ease;
    opacity: 1;
  }

  #section-{{ section.id }} .faq-answer p {
    margin: 0 0 8px 0;
    font-family: Montserrat;
    font-weight: 400;
    line-height: 24.4px;
    letter-spacing: 0px;
    font-size: 15px;
  }

  #section-{{ section.id }} .faq-answer p:last-child {
    margin-bottom: 0;
  }

  #section-{{ section.id }} .faqs-empty {
    text-align: center;
    color: var(--faq-answer-color);
    padding: 40px 20px;
  }
</style>
<script>
(function () {
  const section = document.getElementById('section-{{ section.id }}');
  if (!section) return;

  section.querySelectorAll('.faq-item').forEach(function (details) {
    const answer = details.querySelector('.faq-answer');
    const summary = details.querySelector('.faq-question');

    // Helper: jab open ho to height set karne ka kaam
    function setOpenHeight() {
      // padding bhi included hai kyunki padding ab .faq-answer pe hai
      answer.style.height = answer.scrollHeight + 'px';
      answer.style.opacity = '1';
    }

    // Initial state
    if (details.open) {
      setOpenHeight();
    } else {
      answer.style.height = '0px';
      answer.style.opacity = '0';
    }

    summary.addEventListener('click', function (e) {
      e.preventDefault();

      if (!details.open) {
        // OPEN
        details.setAttribute('open', '');
        requestAnimationFrame(function () {
          setOpenHeight();
        });
      } else {
        // CLOSE
        answer.style.height = answer.scrollHeight + 'px';
        requestAnimationFrame(function () {
          answer.style.height = '0px';
          answer.style.opacity = '0';
        });

        answer.addEventListener('transitionend', function handler() {
          details.removeAttribute('open');
          answer.removeEventListener('transitionend', handler);
        });
      }
    });
  });
})();
</script>
{% schema %}
{
  "name": "FAQs",
  "tag": "section",
  "class": "section-faqs",
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "FAQs"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "columns",
      "label": "Columns (desktop)",
      "options": [
        { "value": "1", "label": "1 column" },
        { "value": "2", "label": "2 columns" }
      ],
      "default": "2"
    },
    {
      "type": "range",
      "id": "item_gap",
      "label": "Spacing between items",
      "min": 8,
      "max": 32,
      "step": 2,
      "default": 14,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "card_radius",
      "label": "Card corner radius",
      "min": 0,
