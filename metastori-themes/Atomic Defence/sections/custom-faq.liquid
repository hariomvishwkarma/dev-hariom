      "default": "#e5e5e5"
    },
    {
      "type": "color",
      "id": "title_color",
      "label": "Heading color",
      "default": "#111111"
    },
    {
      "type": "color",
      "id": "question_color",
      "label": "Question color",
      "default": "#111111"
    },
    {
      "type": "color",
      "id": "answer_color",
      "label": "Answer color",
      "default": "#5c5c5c"
