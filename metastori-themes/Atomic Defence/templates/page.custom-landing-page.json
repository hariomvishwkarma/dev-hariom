    "custom_faq_UTjWPr": {
      "type": "custom-faq",
      "blocks": {
        "faq_nDPah4": {
          "type": "faq",
          "settings": {
            "question": "What is the estimated lead time for fulfillment?",
            "answer": "<p>Lead times depend on the total size of the order. For \"bulk\" requests of 20 units or more, we coordinate with our inventory department to provide a specific and accurate timeline.</p>",
            "open_by_default": false
          }
        },
        "faq_xRh9bc": {
          "type": "faq",
          "settings": {
            "question": "What brands will I have access to?",
            "answer": "<p>Virtually all of them at varying pricing per the brand. Margins will vary.</p>",
            "open_by_default": false
          }
        },
        "faq_wHVDTg": {
          "type": "faq",
          "settings": {
            "question": "How much of a discount is given for wholesale dealers?",
            "answer": "<p>Varies by the brand and items. Our goal is to always have better than dealer pricing for our dealer community.</p>",
            "open_by_default": false
          }
        },
        "faq_HFYAdd": {
          "type": "faq",
          "settings": {
            "question": "Do we drop-ship?",
            "answer": "<p>Yes, we will drop-ship most items to your customers. Sometimes this may even be required depending on brand restrictions.</p>",
            "open_by_default": false
          }
        },
        "faq_TgUHth": {
          "type": "faq",
          "settings": {
            "question": "What payment methods do you accept?",
            "answer": "<p>We accept Credit Card, ACH, Wire Transfer, Check, WAWF, and Net Terms.</p>",
            "open_by_default": false
          }
        },
        "faq_AqwVUc": {
          "type": "faq",
          "settings": {
            "question": "What are your standard Net Terms?",
            "answer": "<p>We offer Net 30, 60, and 90 terms for qualified orders. Please reach out to our team to discuss setting up these terms for your organization. Yes, however they are sometimes limited per transaction and not available for first-time orders. Case-by-case.</p>",
            "open_by_default": false
          }
        },
        "faq_MNHUfV": {
          "type": "faq",
          "settings": {
            "question": "Who should I contact for accounting or to verify banking details?",
            "answer": "<p> To verify banking information or send payment notifications, please use the following contact details:<br/>• Email: support@atomicdefense.com <br/>• Phone: +1 507-400-0490</p>",
            "open_by_default": false
          }
        },
        "faq_YCmJ4R": {
          "type": "faq",
          "settings": {
            "question": "How to apply for wholesale?",
            "answer": "<p>To get started, simply complete the contact form located on this page. Once submitted, a dedicated account manager will review your details and reach out within 24 business hours to discuss your specific requirements and activate your wholesale access.</p>",
            "open_by_default": false
          }
        },
        "faq_6RkGzh": {
          "type": "faq",
          "settings": {
            "question": "What is the minimum order amount?",
            "answer": "<p>What is the minimum order amount? Our minimum order value is $5,000 per transaction. This allows us to maintain wholesale pricing and efficient shipping standards for all our clients.</p>",
            "open_by_default": false
          }
        },
        "faq_iGk3Ly": {
          "type": "faq",
          "settings": {
            "question": "What is your government purchasing process?",
            "answer": "<p>You can find all the details <a href=\"https://www.atomicdefense.com/pages/government-ordering-rfq\" target=\"_blank\" title=\"https://www.atomicdefense.com/pages/government-ordering-rfq\">here</a>.<br/></p>",
            "open_by_default": false
          }
        }
      },
