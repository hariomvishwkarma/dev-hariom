        "collapsible_tab_NfPHPU": {
          "type": "collapsible-tab",
          "settings": {
            "collapsible_tab_heading": "The Atomic Promise:",
            "collapsible_tab_text": "<ol><li>Atomic Defense has been in business for over 12 year.  With a highly-rated <strong>4.8/5 star service</strong> with <strong>1800+ 3rd-party verified reviews</strong>, and counting!</li><li><strong>Secure transaction guaranteed</strong>.  AES-256 Military Encryption.</li><li><strong>USA Family-Owned Small Business</strong>.</li><li><strong>BBB A+</strong> Rated and Accredited.</li><li>Open Monday to Friday.  9:00 AM to 4:00 PM Pacific. </li><li>Guaranteed <strong>accurate stock</strong> counts shown. It's in stock or it will say so.</li><li><a href=\"https://www.atomicdefense.com/pages/warranty\" target=\"_blank\" title=\"Atomic Defense Warranty Terms and Conditions\">Lifetime Warranty</a>.</li><li><strong>Free Shipping </strong>on orders over $95 inside the USA.</li><li><strong>Easy</strong> Returns and Exchanges.</li><li>Our support doesn't end after the sale.  <strong>We're here whenever you need us</strong>. </li></ol>"
          }
        },
