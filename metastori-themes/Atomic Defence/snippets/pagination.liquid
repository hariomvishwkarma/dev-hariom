{% assign grid_list = grid_list | default: nil %}
{% assign is_collection_pagination = false %}
{% if template.name == 'collection' %}
  {% assign is_collection_pagination = true %}
{% endif %}

{%- capture pagination_arrow_left -%}
  <svg width="16" height="15" viewBox="0 0 16 15" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" focusable="false">
    <path d="M7.0249 0.899902L0.899902 7.0249L7.0249 13.1499M0.899902 7.0249L14.8999 7.0249" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
  </svg>
{%- endcapture -%}
{%- capture pagination_arrow_right -%}
  <svg width="16" height="15" viewBox="0 0 16 15" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" focusable="false">
    <path d="M8.7749 0.899902L14.8999 7.0249L8.7749 13.1499M14.8999 7.0249L0.899903 7.0249" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
  </svg>
{%- endcapture -%}

{% if paginate.previous or paginate.next %}
  <nav
    class="pagination--container{% if is_collection_pagination %} pagination--collection{% endif %}"
    aria-label="Pagination"
  >
    <ul class="pagination--inner">

      {% if is_collection_pagination %}
        <li class="pagination--previous">
          {% if paginate.previous %}
            <a
              class="pagination--arrow"
              href="{{- paginate.previous.url -}}{%- if grid_list -%}&grid_list{%- endif -%}"
              aria-label="Go to previous page"
            >
              {{ pagination_arrow_left }}
            </a>
          {% else %}
            <span class="pagination--arrow pagination--arrow-disabled" aria-hidden="true">
              {{ pagination_arrow_left }}
            </span>
          {% endif %}
        </li>
      {% elsif paginate.previous %}
        <li class="pagination--previous">
          <a
            class="pagination--item"
            href="{{- paginate.previous.url -}}{%- if grid_list -%}&grid_list{%- endif -%}"
            aria-label="Go to previous page"
          >
            <span class="pagination--chevron-left" aria-hidden="true">
              {% render 'icon-chevron-down-small' %}
            </span>

            {{ 'general.pagination.prev' | t }}
          </a>
        </li>
      {% endif %}

      {% for part in paginate.parts %}
        {% if part.is_link %}
          <li>
            <a
              class="pagination--item"
              href="{{ part.url }}{% if grid_list %}&grid_list{% endif %}"
              aria-label="Go to page {{ part.title }}"
            >
              {{ part.title }}
            </a>
          </li>
        {% else %}
          {% if part.title == '&hellip;' %}
            <li class="pagination--ellipsis">
              <span class="pagination--item">
                {{ part.title }}
              </span>
            </li>
          {% else %}
            <li
              class="pagination--active"
              aria-label="Page {{ part.title }}"
              aria-current="true"
            >
              <span class="pagination--item">
                {{ part.title }}
              </span>
            </li>
          {% endif %}
        {% endif %}
      {% endfor %}

      {% if is_collection_pagination %}
        <li class="pagination--next">
          {% if paginate.next %}
            <a
              class="pagination--arrow"
              href="{{- paginate.next.url -}}{%- if grid_list -%}&grid_list{%- endif -%}"
              aria-label="Go to next page"
            >
              {{ pagination_arrow_right }}
            </a>
          {% else %}
            <span class="pagination--arrow pagination--arrow-disabled" aria-hidden="true">
              {{ pagination_arrow_right }}
            </span>
          {% endif %}
        </li>
      {% elsif paginate.next %}
        <li class="pagination--next">
          <a
            class="pagination--item"
            href="{{- paginate.next.url -}}{%- if grid_list -%}&grid_list{%- endif -%}"
            aria-label="Go to next page"
          >
            {{ 'general.pagination.next' | t }}
            <span class="pagination--chevron-right" aria-hidden="true">
              {% render 'icon-chevron-down-small' %}
            </span>
          </a>
        </li>
      {% endif %}
    </ul>
  </nav>
{% endif %}
