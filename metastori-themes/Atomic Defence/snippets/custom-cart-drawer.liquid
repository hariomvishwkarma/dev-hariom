<aside
    class="custom-cart-drawer{% if cart.item_count == 0 %} custom-cart-drawer--empty{% endif %}"
    data-custom-cart-drawer
    data-cart-money-format="{{ shop.money_format | escape }}"
    data-i18n-item-one="{{ 'cart.custom_drawer.item_one' | t | escape }}"
    data-i18n-item-other="{{ 'cart.custom_drawer.item_other' | t | escape }}"
    data-i18n-empty="{{ 'cart.custom_drawer.empty' | t | escape }}"
    data-i18n-quantity="{{ 'cart.custom_drawer.quantity' | t | escape }}"
    data-i18n-remove="{{ 'cart.custom_drawer.remove' | t | escape }}"
    data-i18n-recommendations-title="{{ 'cart.custom_drawer.recommendations_title' | t | escape }}"
    data-i18n-add="{{ 'cart.custom_drawer.add' | t | escape }}"
    data-i18n-variant-default="{{ 'cart.custom_drawer.variant_default' | t | escape }}"
    data-i18n-variant-label="{{ 'cart.custom_drawer.variant_label' | t | escape }}"
    data-free-shipping-minimum="{{ settings.cart_free_shipping_minimum | default: 0 }}"
    aria-hidden="true"
>
    <div class="custom-cart-drawer__backdrop" data-cart-drawer-close></div>
    <div class="custom-cart-drawer__panel" role="dialog" aria-modal="true" aria-label="{{ 'cart.custom_drawer.title' | t }}">
    <div class="custom-cart-drawer__site-header-host" data-cart-drawer-site-header-host hidden></div>
    <header class="custom-cart-drawer__header">
        <h2 class="custom-cart-drawer__title">
          {{ 'cart.custom_drawer.title' | t }}
          <span class="custom-cart-drawer__count" data-cart-drawer-count>
            ({{ cart.item_count }} {% if cart.item_count == 1 %}{{ 'cart.custom_drawer.item_one' | t }}{% else %}{{ 'cart.custom_drawer.item_other' | t }}{% endif %})
          </span>
        </h2>
        <button
        class="custom-cart-drawer__close"
        type="button"
        aria-label="{{ 'general.accessibility.close' | t }}"
        data-cart-drawer-close
        >
        {%- render 'icon-menu-close' -%}
        </button>
    </header>
    <div class="custom-cart-drawer__body-container">
        <div class="custom-cart-drawer__body" data-cart-drawer-body>
            {% if cart.item_count == 0 %}
            <div class="custom-cart-drawer__empty" data-cart-drawer-empty>
                {{ 'cart.custom_drawer.empty' | t }}
            </div>
            {% else %}
            <ul class="custom-cart-drawer__items" data-cart-drawer-items>
                {% for item in cart.items %}
                <li class="custom-cart-drawer__item" data-line="{{ forloop.index }}">
                    <a class="custom-cart-drawer__image" href="{{ item.url }}">
                    {% if item.image %}
                        {%
                        render 'rimg',
                        img: item.image,
                        alt: item.title,
                        size: '120x'
                        %}
                    {% endif %}
                    </a>
                    <div class="custom-cart-drawer__item-content">
                    <a class="custom-cart-drawer__item-title" href="{{ item.url }}">{{ item.product.title }}</a>
                     {% if item.selling_plan_allocation.selling_plan and item.selling_plan_allocation.selling_plan.name == 'Backordered' %}
                      <p class="custom-cart-drawer__item-backorder">Backorder</p>
                    {% endif %}
                    {% unless item.product.has_only_default_variant %}
                        <div class="custom-cart-drawer__item-variant">
                          {% for option in item.options_with_values %}
                            <p class="custom-cart-drawer__item-variant-line">
                              <span class="custom-cart-drawer__item-variant-name">{{ option.name }}:</span>
                              <span class="custom-cart-drawer__item-variant-value">{{ option.value }}</span>
                            </p>
                          {% endfor %}
                        </div>
                    {% endunless %}
                    <p class="custom-cart-drawer__item-price">{{ item.final_price | money }}</p>
                    <div class="custom-cart-drawer__item-actions">
                        <div class="custom-cart-drawer__quantity">
                        <div class="custom-cart-drawer__quantity-field">
                            <span class="custom-cart-drawer__quantity-legend">{{ 'cart.custom_drawer.quantity' | t }}</span>
                            <select
                                class="custom-cart-drawer__quantity-select"
                                data-cart-drawer-quantity
                                aria-label="{{ 'general.general.quantity' | t }}"
                                size="5"
                            >
                            {% for i in (1..100) %}
                                <option value="{{ i }}" {% if item.quantity == i %}selected{% endif %}>{{ i }}</option>
                            {% endfor %}
                            {% if item.quantity > 100 %}
                                <option value="{{ item.quantity }}" selected>{{ item.quantity }}</option>
                            {% endif %}
                            </select>
                        </div>
                        </div>
                        <button type="button" class="custom-cart-drawer__remove" data-cart-drawer-remove>
                        <svg class="custom-cart-drawer__remove-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                            <path d="M9 3h6l1 2h5v2H3V5h5l1-2zm1 6v10M14 9v10M5 9h14v12a2 2 0 01-2 2H7a2 2 0 01-2-2V9z" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                        </svg>
                        {{ 'cart.custom_drawer.remove' | t }}
                        </button>
                    </div>
                    </div>
                </li>
                {% endfor %}
            </ul>
            {% endif %}
        </div>

        <section class="custom-cart-drawer__recommendations" data-cart-drawer-recommendations hidden>
        <h3 class="custom-cart-drawer__recommendations-title">{{ 'cart.custom_drawer.recommendations_title' | t }}</h3>
        <ul class="custom-cart-drawer__recommendations-list" data-cart-drawer-recommendations-list></ul>
        </section>
    </div>
    <footer class="custom-cart-drawer__footer" data-cart-drawer-footer>
        <div class="custom-cart-drawer__totals">
            <p>
                <span data-cart-drawer-subtotal-label class="custom-cart-drawer__subtotal-label">
                    {{ 'cart.custom_drawer.subtotal' | t }}
                </span>
                <span data-cart-drawer-subtotal-count class="custom-cart-drawer__subtotal-count">
                    ({{ cart.item_count }} {% if cart.item_count == 1 %}{{ 'cart.custom_drawer.item_one' | t }}{% else %}{{ 'cart.custom_drawer.item_other' | t }}{% endif %})
                </span>
                <span data-cart-drawer-subtotal>{{ cart.total_price | money | strip_html }}</span>
            </p>
            {% assign free_shipping_minimum = settings.cart_free_shipping_minimum | default: 0 | times: 100 %}
            <p class="custom-cart-drawer__shipping-row" data-cart-drawer-shipping-row {% if free_shipping_minimum <= 0 or cart.total_price < free_shipping_minimum %}hidden{% endif %}>
                <span class="custom-cart-drawer__shipping-label">{{ 'cart.custom_drawer.shipping_type_title' | t }}</span>
                <span class="custom-cart-drawer__shipping-value">{{ 'cart.custom_drawer.shipping_type_value' | t }}</span>
            </p>
        </div>
        <div class="custom-cart-drawer__buttons">
        <form action="{{ routes.cart_url }}" method="post">
            <button class="button-primary custom-cart-drawer__checkout-button" type="submit" name="checkout" data-cart-drawer-checkout-button>
                <span class="atc-button--text">
                  {% if settings.enable_checkout_lock_icon == true %}
                    <svg xmlns="http://www.w3.org/2000/svg" width="10" height="14" viewBox="0 0 10 14" fill="none">
                        <path d="M0.675914 14H9.16076C9.51221 14 9.79713 13.7151 9.79713 13.3636V6.15152C9.79713 5.80007 9.51221 5.51515 9.16076 5.51515H8.5244V3.60606C8.5244 1.61768 6.90672 0 4.91834 0C2.92996 0 1.31228 1.61768 1.31228 3.60606V5.51515H0.675914C0.324472 5.51515 0.0395508 5.80007 0.0395508 6.15152V13.3636C0.0395508 13.7151 0.324472 14 0.675914 14ZM6.72056 9.30601L4.91753 11.109C4.79327 11.2333 4.63041 11.2955 4.46758 11.2955C4.30476 11.2955 4.14185 11.2333 4.01763 11.109L3.11611 10.2075C2.86759 9.95901 2.86759 9.55615 3.11611 9.30758C3.36459 9.05906 3.76754 9.05906 4.01606 9.30758L4.46762 9.7591L5.8207 8.40607C6.06918 8.15755 6.47213 8.15755 6.72065 8.40607C6.96913 8.65463 6.96913 9.05749 6.72056 9.30601ZM2.58501 3.60606C2.58501 2.31946 3.63174 1.27273 4.91834 1.27273C6.20494 1.27273 7.25167 2.31946 7.25167 3.60606V5.51515H2.58501V3.60606Z" fill="#121212" stroke="#121212" stroke-width="0.0787879"/>
                    </svg>
                  {% endif %}
                  {{ 'cart.custom_drawer.checkout' | t }}
                </span>
                <span class="atc-button--icon">
                  {%- render 'icon-spinner' -%}
                </span>
            </button>
        </form>
        </div>
        {% if shop.enabled_payment_types.size > 0 %}
        <ul class="payment-icons custom-cart-drawer__payments">
            {% for type in shop.enabled_payment_types %}
            <li class="payment-icons-item {{ type }}">
                {{ type | payment_type_svg_tag }}
            </li>
            {% endfor %}
        </ul>
        {% endif %}
    </footer>
    </div>
</aside>