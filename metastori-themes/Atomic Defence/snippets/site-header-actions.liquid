<script defer>
  
  
  const closeLoginModal = (modalId, btnId, closeNum) => {
    modal = document.getElementById(modalId);
    btn = document.getElementById(btnId);
    span = document.getElementsByClassName("close-about")[closeNum];
    section = document.getElementsByClassName("account-page-login")[0];
    section.style.display = "none";

    modal.style.display = "none";
  }
</script>
<ul class="site-header-actions" data-header-actions>
  {% if shop.customer_accounts_enabled %}
    {% unless customer %}
      <li class="site-header-actions__account-link">
        <!-- <a
          class="site-header_account-link-anchor"
          id="login-modal-btn"
          href="{{ routes.account_login_url }}"
          onclick="openModal('myModal-login', 'login-modal-btn',4)"
        > -->
        <a
          class="site-header_account-link-anchor"
          id="login-modal-btn"
          onclick="openModal('myModal-login', 'login-modal-btn',0)"
         style="cursor:pointer;">
          <span class="site-header__account-icon" >
            {% 
                render 'icon-library', 
                id: 'icon-account', 
            %}
          </span>
          
          <span class="site-header_account-link-text">
            <!--11/7/23 Changed Login button to Account button  -->
            <!-- {{ 'header.account.login' | t }} -->
            Account
          </span>
        </a>
      </li>
    {% else %}
      <li class="site-header-actions__account-link">
        <span class="site-header__account-icon">
          {% render 'icon-library', id: 'icon-account' %}
        </span>
        <span class="site-header__account-links">
          <a
            class="site-header__account-link--account"
            href="{{ routes.account_url }}"
          >
            {{ 'header.account.title' | t }}
          </a>
          
          <a
            class="site-header__account-link--logout"
            href="{{ routes.account_logout_url }}"
            data-no-instant
          >
            {{ 'header.account.logout' | t }}
          </a>
        </span>
      </li>
    {% endunless %}
  {% endif %}
</ul>
  <div id="myModal-login" class="modal-about">

  <!-- Modal content -->
  <div class="modal-content-about">
    <span class="close-about">&times;</span>
    <section
  class="account-page account-page-login"
  data-template-account
  data-template-account-login>
  <header class="account-page-masthead">
    <h1 class="account-page-title">
      {{ 'customers.login.title' | t }}
    </h1>
  </header>

  <article class="account-page-content">
    <div class="account-login visible" data-account-login-main>
      {% form 'customer_login' %}

        {% if form.errors != blank %}
          <div class="account-message message--error">
            {{ form.errors | default_errors }}
          </div>
        {% endif %}

        <div class="form-field">
          <input
            class="form-field-input form-field-text"
            id="customer_email"
            name="customer[email]"
            type="text"
            autocorrect="off"
            autocapitalize="off">
          <label
            class="form-field-title"
            for="customer_email">
            {{ 'customers.forms.email' | t }}
          </label>
        </div>

        {% if form.password_needed %}
          <div class="form-field form-field--account-password">
            <input
              class="form-field-input form-field-text"
              id="customer_password"
              name="customer[password]"
              type="password">
            <label
              class="form-field-title"
              for="customer_password">
              {{ 'customers.forms.password' | t }}
            </label>
          </div>
        {% endif %}

        <div class="form-action-row">
          <button id="login-modal-submit" class="button-primary form-action--submit" type="submit" onclick="closeLoginModal('myModal-login', 'login-modal-submit',4)">
            {{ 'customers.login.sign_in' | t }}
          </button>

          <div class="form-action-row--helper">
            <span class="form-action-row--helper-item">
              {{ 'customers.new_customer.title' | t }}
              {{ 'customers.register.title' | t | customer_register_link }}
            </span>

            {% if form.password_needed %}
              <span class="form-action-row--helper-item">
                <a href="#customer_recovery" data-login-toggle>
                  {{ 'customers.login.forgot_password' | t }}
                </a>
              </span>
            {% endif %}
          </div>
        </div>

      {% endform %}
    </div>

    <div
      class="account-recovery"
      id="customer_recovery"
      data-account-login-recovery>
      {% form 'recover_customer_password' %}

        <h2 class="account-page-subtitle">
          {{ 'customers.recover_password.title' | t }}
        </h2>

        <p>{{ 'customers.recover_password.subtitle' | t }}</p>

        {% assign has_message = false %}

        {% if form.errors != blank %}
          {% assign has_message = true %}
          {% assign message_type = 'error' %}
        {% endif %}

        {% if form.posted_successfully? %}
          {% assign has_message = true %}
          {% assign message_type = 'success' %}
        {% endif %}

        {% if has_message %}
          <div class="account-message message--{{ message_type }}" data-recovery-has-message>
            {% case message_type %}
              {% when 'success' %}
                <p>
                  {{ 'customers.recover_password.success' | t }}
                </p>
              {% when 'error' %}
                {{ form.errors | default_errors }}
            {% endcase %}
          </div>
        {% endif %}

        <div class="form-field">
          <input
            class="form-field-input form-field-text"
            id="customer_recovery_email"
            name="email"
            type="text"
            autocorrect="off"
            autocapitalize="off">
          <label
            class="form-field-title"
            for="customer_recovery_email">
            {{ 'customers.forms.email' | t }}
          </label>
        </div>

        <div class="form-action-row">
          <button id="login-modal-submit-2" class="button-primary" type="submit" onclick="closeLoginModal('myModal-login', 'login-modal-submit-2',4)">
            {{ 'customers.forms.submit' | t }}
          </button>

          <button
            class="button-secondary"
            type="button"
            data-login-toggle
          >
            {{ 'customers.forms.cancel' | t }}
          </button>
        </div>
      {% endform %}
    </div>

    {% if shop.checkout.guest_login %}
      <div class="account-register account-register--guest">
        <h2 class="account-register-subtitle">
          {{ 'customers.guest_login.title' | t }}
        </h2>

        {% form 'guest_login' %}
          <button class="button-primary" type="submit">
            {{ 'customers.guest_login.submit' | t }}
          </button>
        {% endform %}
      </div>
    {% endif %}
  </article>
</section>
  </div>

</div>
