{%- liquid
  assign current_sort_label = ''
-%}

{%- if type == 'select' -%}
  <div class="productgrid--utils utils-sortby">
    <label
      class="utils-sortby-title"
      for="product_grid_sort"
    >
      {{ 'product_grid.sort_by.title' | t }}
    </label>

    <button
      class="utils-sortby-button"
      type="button"
      data-productgrid-modal-sort
      aria-label="{{ 'product_grid.sort_by.title' | t }}"
    >
      <span class="utils-filter-icon">
        {% render 'icon-library', id: 'icon-sort' %}
      </span>
      <span class="utils-filter-text">
        {{ 'product_grid.sort_by.title' | t }}
      </span>
    </button>

    {%- for option in collection.sort_options -%}
      {%- if option.name == 'Alphabetically, A-Z' or option.name == 'Alphabetically, Z-A' or option.name == 'Default' -%}
        {%- continue -%}
      {%- endif -%}
      {%- capture sort_label -%}
        {%- case option.value -%}
          {%- when 'manual', 'relevance' -%}
            Recommended
          {%- when 'best-selling' -%}
            Best Seller
          {%- when 'price-ascending' -%}
            Price: Low to High
          {%- when 'price-descending' -%}
            Price: High to Low
          {%- else -%}
            {{ option.name }}
        {%- endcase -%}
      {%- endcapture -%}
      {% if collection.sort_by == blank and collection.default_sort_by == option.value %}
        {% assign current_sort_label = sort_label | strip %}
      {% elsif collection.sort_by == option.value %}
        {% assign current_sort_label = sort_label | strip %}
      {% endif %}
    {%- endfor -%}

    {%- if current_sort_label == blank -%}
      {%- assign current_sort_label = collection.sort_options.first.name -%}
    {%- endif -%}

    {%- capture sort_custom_options -%}
      {%- for option in collection.sort_options -%}
        {%- if option.name == 'Alphabetically, A-Z' or option.name == 'Alphabetically, Z-A' or option.name == 'Default' -%}
          {%- continue -%}
        {%- endif -%}
        {%- capture sort_label -%}
          {%- case option.value -%}
            {%- when 'manual', 'relevance' -%}
              Recommended
            {%- when 'best-selling' -%}
              Best Seller
            {%- when 'price-ascending' -%}
              Price: Low to High
            {%- when 'price-descending' -%}
              Price: High to Low
            {%- else -%}
              {{ option.name }}
          {%- endcase -%}
        {%- endcapture -%}
        {% assign sort_active = false %}
        {% if collection.sort_by == blank and collection.default_sort_by == option.value %}
          {% assign sort_active = true %}
        {% elsif collection.sort_by == option.value %}
          {% assign sort_active = true %}
        {% endif %}
        <li class="utils-sortby-custom__item" role="none">
          <button
            class="utils-sortby-custom__option{% if sort_active %} is-selected{% endif %}"
            type="button"
            role="option"
            aria-selected="{% if sort_active %}true{% else %}false{% endif %}"
            data-sort-value="{{ option.value | escape }}"
          >
            {{ sort_label | strip }}
          </button>
        </li>
      {%- endfor -%}
    {%- endcapture -%}

    <div class="utils-sortby-custom" data-sortby-dropdown>
      <button
        class="utils-sortby-custom__toggle"
        type="button"
        aria-expanded="false"
        aria-haspopup="listbox"
        aria-controls="product_grid_sort_menu"
        data-sortby-toggle
      >
        <span class="utils-sortby-custom__label">{{ 'product_grid.sort_by.title' | t }} :</span>
        <span class="utils-sortby-custom__value" data-sortby-value>{{ current_sort_label }}</span>
        {% render 'icon-chevron-down-small' %}
      </button>
      <ul
        class="utils-sortby-custom__menu"
        id="product_grid_sort_menu"
        role="listbox"
        hidden
        data-sortby-menu
      >
        {{ sort_custom_options }}
      </ul>
    </div>

    <div class="utils-sortby-select--wrapper form-field-select-wrapper no-label">
      <select
        class="
          form-field
          form-field-select
          utils-sortby-select
        "
        id="product_grid_sort"
        tabindex="-1"
        aria-hidden="true"
        data-productgrid-trigger-sort>
        {%- for option in collection.sort_options -%}
          {%- if option.name == 'Alphabetically, A-Z' or option.name == 'Alphabetically, Z-A' or option.name == 'Default' -%}
            {%- continue -%}
          {%- endif -%}
          {%- capture sort_label -%}
            {%- case option.value -%}
              {%- when 'manual', 'relevance' -%}
                Recommended
              {%- when 'best-selling' -%}
                Best Seller
              {%- when 'price-ascending' -%}
                Price: Low to High
              {%- when 'price-descending' -%}
                Price: High to Low
              {%- else -%}
                {{ option.name }}
            {%- endcase -%}
          {%- endcapture -%}
          {% assign sort_active = false %}
          {% if collection.sort_by == blank and collection.default_sort_by == option.value %}
            {% assign sort_active = true %}
          {% elsif collection.sort_by == option.value %}
            {% assign sort_active = true %}
          {% endif %}
          <option value="{{ option.value }}" {% if sort_active %}selected="selected"{% endif %}>
            {{ sort_label | strip }}
          </option>
        {%- endfor -%}
      </select>
      {% render 'icon-chevron-down-small' %}
    </div>
  </div>
{%- endif -%}

{%- if type == 'modal' -%}
  <div class="utils-sortby--modal" aria-hidden="true" data-productgrid-sort-content>
    <span class="utils-sortby--modal-title">
      {{ 'product_grid.sort_by.title' | t }}
    </span>

    <ul class="utils-sortby--modal-list">
      {%- for option in collection.sort_options -%}
        {%- if option.name == 'Alphabetically, A-Z' or option.name == 'Alphabetically, Z-A' or option.name == 'Default' -%}
          {%- continue -%}
        {%- endif -%}
        {%- capture sort_label -%}
          {%- case option.value -%}
            {%- when 'manual', 'relevance' -%}
              Recommended
            {%- when 'best-selling' -%}
              Best Seller
            {%- when 'price-ascending' -%}
              Price: Low to High
            {%- when 'price-descending' -%}
              Price: High to Low
            {%- else -%}
              {{ option.name }}
          {%- endcase -%}
        {%- endcapture -%}
        {% assign sort_active = false %}
        {% if collection.sort_by == blank and collection.default_sort_by == option.value %}
          {% assign sort_active = true %}
        {% elsif collection.sort_by == option.value %}
          {% assign sort_active = true %}
        {% endif %}

        {% assign button_class = 'utils-sortby--modal-button' %}
        {% if sort_active %}
          {% assign button_class = button_class | append: ' utils-sortby--modal-button--active' %}
        {% endif %}

        <li class="utils-sortby--modal-item">
          <button
            class="{{ button_class }}"
            type="button"
            value="{{ option.value }}"
            data-productgrid-trigger-sort-button
            {% if sort_active %}
              disabled
            {% endif %}
          >
            <span class="utils-sortby--modal-check" aria-hidden="true"></span>
            <span class="utils-sortby--modal-label">{{ sort_label | strip }}</span>
          </button>
        </li>
      {%- endfor -%}
    </ul>
  </div>
{%- endif -%}
