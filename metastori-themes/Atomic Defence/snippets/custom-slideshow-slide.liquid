{% liquid
  assign block_slide_image = block.settings.background_image
  assign block_slide_image_mobile = block.settings.mobile_background_image
  assign block_slide_title = block.settings.title | escape
  assign block_subheading = block.settings.text | escape
  assign judgme_d_text = block.settings.judgme_d_text
  assign judgme_m_text = block.settings.judgme_m_text
  assign block_description = block.settings.block_description
  assign block_button_label = block.settings.button_one_label | escape
  assign block_button_link = block.settings.button_one_link
  assign block_button_label_2 = block.settings.button_two_label | escape
  assign block_button_link_2 = block.settings.button_two_link
  assign block_text_alignment = block.settings.text_alignment
  assign block_text_color = block.settings.color
  assign block_background_link = block.settings.link
  assign jdgme_icon = block.settings.jdgme_icon

  assign block_crop_images = 'center'
  if section.settings.slideshow_height == 'original'
    assign block_crop_images = false
  endif

  if block.settings.show_overlay
    assign block_overlay_color = block.settings.overlay_color
    assign block_overlay_opacity = block.settings.overlay_opacity
  endif

  assign block_button_1_class = 'slideshow-slide__button--' | append: block.settings.button_one_style
  assign block_button_2_class = 'slideshow-slide__button--' | append: block.settings.button_two_style
%}

{%- comment -%} ===== Review cards ke liye CSS sirf ek baar print karo (pehli slide par) ===== {%- endcomment -%}
{%- if block_index == 0 -%}
<style>
  .hero-review-cards{
    display:flex; gap:14px; flex-wrap:wrap; justify-content:center; margin-top:22px;width: fit-content; margin-left: auto;margin-right: auto;
  }
  .hero-review-card{
    background:#fff;
    box-shadow:0 8px 24px rgba(0,0,0,.14);
    padding:16px 0; text-align:center; min-width:180px;
    transition:transform .25s ease, box-shadow .25s ease;
  }
  .hero-review-card__stars{ display:flex; justify-content:center; gap:2px; margin-bottom:10px; padding-bottom: 8.5px; border-bottom: 1px solid #ECECEC; }
  .hero-review-card__stars svg{ width:17px; height:17px; }  
  .hero-review-card__rating{  
    display:flex; align-items:center; justify-content:center; gap:7px;
    font-size:15px; font-weight:700; color:#101828; margin-bottom:5px;
  }
  .hero-review-card__rating .on{ font-weight:600; font-size:15px; color:#101828; }
  .hero-review-card__logo{ height:18px; width:auto; display:inline-block; vertical-align:middle; }
  .hero-review-card__count{ font-size:12px; color:#98a2b3; }
  @media (max-width:749px){
    .hero-review-cards{ gap:12px; margin-top: 12px;margin-left: 0; }
    .hero-review-card{ min-width:0; padding:14px 0; min-width: 134px; }
    .hero-review-card__rating {
    flex-direction: column;
        gap: 4px;
    }
    .hero-review-card__count {
        font-size: 10px;
        color: #98a2b3;
    }
  }
</style>
{%- endif -%}

{% comment %}Inject @pixelunion/pxs-slideshow/slideshow-slide begin{% endcomment %}
{%- assign placeholder_number = block_index | modulo: 2 | plus: 1 -%}
{%- assign placeholder = 'lifestyle-' | append: placeholder_number -%}
{%- assign slide_number = block_index | plus: 1 -%}
{%- assign overlay_opacity = 0 -%}
{%- if block_overlay_opacity > 0 -%}
  {%- assign overlay_opacity = block_overlay_opacity | times: 0.01 -%}
{%- endif -%}

<div
  class="slideshow-slide {% if block_slide_image_mobile != blank %}slideshow-slide--mobile{% endif %} {{ block_class }}"
  aria-label="{{ 'sections.slideshow.slide_counter' | t: count: slide_number, total: section.blocks.size }}"
  {% if block_text_color != blank %}data-text-color="{{ block_text_color }}"{% endif %}
  tabindex="-1"
  data-slideshow-slide
  data-slide-index="{{ block_index }}"
  {{ block.shopify_attributes }}
>
  {%- if block_background_link != blank -%}
    <a
      href="{{ block_background_link }}"
      class="slideshow-slide__background-link"
      aria-label="{{ block_slide_title }} {{ block_subheading }}"
    >
  {%- endif -%}
    <div
      class="
        slideshow-slide__image-wrapper
        {% if block_image_position %}
          slideshow-slide__image-wrapper--position-{ block_image_position }
        {% endif %}
      "
      data-slide-image-wrapper
    >
      {%- if block_slide_image != blank -%}
        {%
          render 'rimg',
          img: block_slide_image,
          class: 'slideshow-slide__image slideshow-slide__image--desktop',
          size: '2000x',
          lazy: true,
          canvas: true,
          focal_point: block_slide_image.presentation.focal_point,
        %}
      {%- else -%}
        {{ placeholder |  placeholder_svg_tag: 'slideshow-slide__image slideshow-slide__placeholder' }}
      {%- endif -%}

      {%- if block_slide_image_mobile != blank -%}
        {%
          render 'rimg',
          img: block_slide_image_mobile,
          class: 'slideshow-slide__image slideshow-slide__image--mobile',
          size: '800x',
          lazy: true,
          canvas: true,
          focal_point: block_slide_image_mobile.presentation.focal_point,
        %}
      {%- endif -%}

      {%- if block_overlay_opacity != 0 and block_overlay_color != 'rgba(0,0,0,0)' -%}
        <div
          class="
            slideshow-slide__overlay
            {% if block_overlay_style != blank %}
              slideshow-slide__overlay--{{ block_overlay_style }}
            {% endif %}
          "
          style="
            {% if block_overlay_color != blank %}
              background-color: {{ block_overlay_color }};
            {% endif %}
            opacity: {{ overlay_opacity }};
          "
        ></div>
      {%- endif -%}
    </div>
  {%- if block_background_link != blank -%}
    </a>
  {%- endif -%}
  <div
    class="
      slideshow-slide__content
      slideshow-slide__content--{{ block.id }}
      {% if block_text_alignment %}slideshow-slide__content--text-{{ block_text_alignment }}{% endif %}
    "
    data-slide-content
  >
    {%- if block_background_link != blank -%}
      <a
        href="{{ block_background_link }}"
        class="slideshow-slide__content-background-link"
      >
    {%- endif -%}

    {%- if block_preheading != blank -%}
      <p class="slideshow-slide__preheading">
        {{ block_preheading | escape }}
      </p>
    {%- endif -%}

    {%- if block_slide_title != blank -%}
      <h2 class="slideshow-slide__heading">
        {{ block_slide_title | escape }}
      </h2>
    {%- endif -%}

    {%- if block_subheading != blank -%}
      <div class="slideshow-slide__subheading">
        {{ block_subheading | escape }}
      </div>
    {%- endif -%}

    {%- if block_description != blank -%}
      <div class="slideshow-slide__description">
        {{ block_description }}
      </div>
    {%- endif -%}

    {%- if block_text != blank -%}
      <div class="slideshow-slide__text">
        {{ block_text }}
      </div>
    {%- endif -%}

    {%- if block_background_link != blank -%}
      </a>
    {%- endif -%}

    {%- if block_button_label != blank -%}
      {% if block_button_link != blank %}
        <a href="{{ block_button_link }}"
      {% else %}
        <span
      {% endif %}
        class="
          slideshow-slide__button
          {{ block_button_1_class }}
        "
      >
      {{ block_button_label | escape }}
      {%- if block_button_link != blank -%}
        </a>
      {%- else -%}
        </span>
      {%- endif -%}
    {%- endif -%}

    {%- if block_button_label_2 != blank -%}
      {% if block_button_link_2 != blank %}
        <a href="{{ block_button_link_2 }}"
      {% else %}
        <span
      {% endif %}
        class="
          slideshow-slide__button
          {{ block_button_2_class }}
        "
      >
        {{ block_button_label_2 | escape }}
      {%- if block_button_link_2 != blank -%}
        </a>
      {%- else -%}
        </span>
      {%- endif -%}
    {%- endif -%}

    {%- comment -%} ============================================================
       REVIEW CARDS (button ke NICHE) — Google + Judge.me alag alag settings
       ============================================================ {%- endcomment -%}
    {%- if block.settings.show_review_cards -%}
      <div class="hero-review-cards">

        {%- comment -%} -------- CARD 1 (Google) -------- {%- endcomment -%}
        {%- if block.settings.card1_enable -%}
          <div class="hero-review-card">
            <div class="hero-review-card__stars">
              {%- assign r1 = block.settings.card1_rating -%}
              {%- for i in (1..5) -%}
                {%- assign th = i | minus: 1 -%}
                {%- assign diff = r1 | minus: th -%}
                {%- if diff <= 0 -%}{%- assign pct = 0 -%}
                {%- elsif diff >= 1 -%}{%- assign pct = 100 -%}
                {%- else -%}{%- assign pct = diff | times: 100 -%}{%- endif -%}
                {%- assign gid = block.id | append: '-c1-' | append: i -%}
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20">
                  <defs>
                    <linearGradient id="{{ gid }}">
                      <stop offset="{{ pct }}%" stop-color="{{ block.settings.card1_star_color }}"/>
                      <stop offset="{{ pct }}%" stop-color="{{ block.settings.card1_star_empty }}"/>
                    </linearGradient>
                  </defs>
                  <path fill="url(#{{ gid }})" d="M8.71993 0.970122C9.12347 -0.323374 10.8762 -0.323374 11.2784 0.970122L12.7177 5.59356C12.8056 5.87514 12.9765 6.12048 13.2061 6.29453C13.4356 6.46857 13.7119 6.56241 13.9956 6.56263H18.6524C19.9559 6.56263 20.4966 8.30414 19.4434 9.10468L15.677 11.9613C15.447 12.1355 15.2758 12.3813 15.1878 12.6633C15.0998 12.9454 15.0997 13.2493 15.1873 13.5315L16.6266 18.1549C17.0302 19.4484 15.6111 20.5256 14.5551 19.7251L10.7888 16.8685C10.559 16.6943 10.2824 16.6005 9.99848 16.6005C9.71458 16.6005 9.43796 16.6943 9.20822 16.8685L5.44184 19.7251C4.38725 20.5256 2.96948 19.4484 3.37167 18.1549L4.81097 13.5315C4.89864 13.2493 4.89848 12.9454 4.81052 12.6633C4.72256 12.3813 4.55132 12.1355 4.32134 11.9613L0.556305 9.10608C-0.496936 8.30555 0.0451535 6.56403 1.34724 6.56403H6.00276C6.28665 6.56411 6.56328 6.47041 6.79306 6.29634C7.02284 6.12228 7.19398 5.87677 7.28198 5.59497L8.72128 0.971526L8.71993 0.970122Z"/>
                </svg>
              {%- endfor -%}
            </div>
            <div class="hero-review-card__rating">
              {%- if block.settings.card1_rating_text != blank -%}<span>{{ block.settings.card1_rating_text }}{%- if block.settings.card1_on_text != blank -%}<span class="on"> {{ block.settings.card1_on_text }}</span>{%- endif -%}</span>{%- endif -%}
              
              {%- if block.settings.card1_logo != blank -%}
                <img class="hero-review-card__logo" src="{{ block.settings.card1_logo | image_url: width: 300 }}" alt="{{ block.settings.card1_logo.alt | default: 'Google' | escape }}" loading="lazy">
              {%- endif -%}
            </div>
            {%- if block.settings.card1_count_text != blank -%}
              <div class="hero-review-card__count">{{ block.settings.card1_count_text }}</div>
            {%- endif -%}
          </div>
        {%- endif -%}

        {%- comment -%} -------- CARD 2 (Judge.me) -------- {%- endcomment -%}
        {%- if block.settings.card2_enable -%}
          <div class="hero-review-card">
            <div class="hero-review-card__stars">
              {%- assign r2 = block.settings.card2_rating -%}
              {%- for i in (1..5) -%}
                {%- assign th = i | minus: 1 -%}
                {%- assign diff = r2 | minus: th -%}
                {%- if diff <= 0 -%}{%- assign pct = 0 -%}
                {%- elsif diff >= 1 -%}{%- assign pct = 100 -%}
                {%- else -%}{%- assign pct = diff | times: 100 -%}{%- endif -%}
                {%- assign gid = block.id | append: '-c2-' | append: i -%}
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20">
                  <defs>
                    <linearGradient id="{{ gid }}">
                      <stop offset="{{ pct }}%" stop-color="{{ block.settings.card2_star_color }}"/>
                      <stop offset="{{ pct }}%" stop-color="{{ block.settings.card2_star_empty }}"/>
                    </linearGradient>
                  </defs>
                  <path fill="url(#{{ gid }})" d="M8.71993 0.970122C9.12347 -0.323374 10.8762 -0.323374 11.2784 0.970122L12.7177 5.59356C12.8056 5.87514 12.9765 6.12048 13.2061 6.29453C13.4356 6.46857 13.7119 6.56241 13.9956 6.56263H18.6524C19.9559 6.56263 20.4966 8.30414 19.4434 9.10468L15.677 11.9613C15.447 12.1355 15.2758 12.3813 15.1878 12.6633C15.0998 12.9454 15.0997 13.2493 15.1873 13.5315L16.6266 18.1549C17.0302 19.4484 15.6111 20.5256 14.5551 19.7251L10.7888 16.8685C10.559 16.6943 10.2824 16.6005 9.99848 16.6005C9.71458 16.6005 9.43796 16.6943 9.20822 16.8685L5.44184 19.7251C4.38725 20.5256 2.96948 19.4484 3.37167 18.1549L4.81097 13.5315C4.89864 13.2493 4.89848 12.9454 4.81052 12.6633C4.72256 12.3813 4.55132 12.1355 4.32134 11.9613L0.556305 9.10608C-0.496936 8.30555 0.0451535 6.56403 1.34724 6.56403H6.00276C6.28665 6.56411 6.56328 6.47041 6.79306 6.29634C7.02284 6.12228 7.19398 5.87677 7.28198 5.59497L8.72128 0.971526L8.71993 0.970122Z"/>
                </svg>
              {%- endfor -%}
            </div>
            <div class="hero-review-card__rating">
              {%- if block.settings.card2_rating_text != blank -%}<span>{{ block.settings.card2_rating_text }}{%- if block.settings.card2_on_text != blank -%}<span class="on"> {{ block.settings.card2_on_text }}</span>{%- endif -%}</span>{%- endif -%}
              
              {%- if block.settings.card2_logo != blank -%}
                <img class="hero-review-card__logo" src="{{ block.settings.card2_logo | image_url: width: 300 }}" alt="{{ block.settings.card2_logo.alt | default: 'Judge.me' | escape }}" loading="lazy">
              {%- endif -%}
            </div>
            {%- if block.settings.card2_count_text != blank -%}
              <div class="hero-review-card__count">{{ block.settings.card2_count_text }}</div>
            {%- endif -%}
          </div>
        {%- endif -%}

      </div>
    {%- endif -%}
    {%- comment -%} ============ REVIEW CARDS END ============ {%- endcomment -%}

  </div>
</div>
{% comment %}Inject @pixelunion/pxs-slideshow/slideshow-slide end{% endcomment %}
