{% liquid
  if product.vendor == 'Agilite' or product.vendor == 'Garmin Ltd' or product.vendor == 'Shellback Tactical' or product.vendor == '3M 11' or product.vendor == 'Mountain House' or product.vendor == 'Strike Industries' or product.vendor == 'Mira Safety' or product.vendor == 'Trijicon' or product.vendor == 'MantisX' or product.vendor == 'GBRS' or product.vendor == 'L3 Harris' or product.vendor == 'Act in Black' or product.vendor == 'AB NightVision' or product.vendor == 'Nocturn Industries' or product.vendor == 'Noctis Technologies' or product.vendor == 'Low Light Innovations' or product.vendor == 'Photonis Defense' or product.vendor == 'Elbit'
    assign min_days = 7
    assign max_days = 14
  elsif product.vendor == '221B Tactical' or product.vendor == 'Wiley X' or product.vendor == 'Salomon' or product.vendor == 'Unity Tactical'
    assign min_days = 7
    assign max_days = 21
  elsif product.vendor == 'Princeton Tec' or product.vendor == 'SureFire'
      assign min_days = 7
      assign max_days = 30
  elsif product.vendor == 'InfiRay'
    assign min_days = 7
    assign max_days = 60
  elsif product.vendor == 'Eberlestock'
    assign min_days = 14
    assign max_days = 21
  elsif product.vendor == 'North American Rescue'
    assign min_days = 14
    assign max_days = 30
  elsif product.vendor == '3M'
    assign min_days = 14
    assign max_days = 90
  elsif product.vendor == 'HRT Tactical' or product.vendor == 'Streamlight'
    assign min_days = 15
    assign max_days = 60
  elsif product.vendor == 'High Speed Gear'
    assign min_days = 15
    assign max_days = 120
  elsif product.vendor == 'Esstac'
    assign min_days = 28
    assign max_days = 42
  elsif product.vendor == 'Armasight' or product.vendor == 'RIX Tactical' or product.vendor == 'Silynx' or product.vendor == '3M 12' or product.vendor == 'HighCom'
    assign min_days = 30
    assign max_days = 60
  elsif product.vendor == 'Team Wendy'
    assign min_days = 30
    assign max_days = 90
  elsif product.vendor == 'Argus Inc' or product.vendor == 'Steele Industries'
    assign min_days = 60
    assign max_days = 90
  elsif product.vendor == 'Atomic Defense'
    assign min_days = 30
    assign max_days = 100
  elsif product.vendor == 'Wilcox 7'
    assign min_days = 30
    assign max_days = 70
  elsif product.vendor == 'Ops-Core' or product.vendor == 'Eagle Industries'
    assign min_days = 30
    assign max_days = 120
  elsif product.vendor == "Arc'teryx LEAF" or product.vendor == 'ZenitCo'
    assign min_days = 60
    assign max_days = 120
  elsif product.vendor == 'Devtac'  or product.vendor == 'Crye Precision'
    assign min_days = 60
    assign max_days = 180
  elsif product.vendor == 'Galvion' or product.vendor == 'Aimpoint'
    assign min_days = 90
    assign max_days = 120
  elsif product.vendor == 'SUP6'
    assign min_days = 35
    assign max_days = 42    
  else
    assign min_days = 5
    assign max_days = 10
  endif

  assign today_timestamp = 'now' | date: '%s'

  assign min_seconds = min_days | times: 86400
  assign max_seconds = max_days | times: 86400

  assign min_future_timestamp = today_timestamp | plus: min_seconds
  assign max_future_timestamp = today_timestamp | plus: max_seconds

  assign min_future_date = min_future_timestamp | date: '%d %b'
  assign max_future_date = max_future_timestamp | date: '%d %b'

  assign date_range = min_future_date | append: ' - ' | append: max_future_date

  assign min_month = min_future_timestamp | date: '%b'
  assign max_month = max_future_timestamp | date: '%b'

  assign min_date = min_future_date | remove: min_month
  assign max_date = max_future_date | remove: max_month

  if min_month == max_month
    assign date_range = min_month | append: ' ' | append: min_date | strip | append: ' - ' | append: max_date | strip | append: '.'
  else
    assign date_range = min_future_date | append: ' - ' | append: max_future_date | append: '.'
  endif

  assign normal_min_future_timestamp = min_future_timestamp | plus: 604800
  assign normal_max_future_timestamp = max_future_timestamp | plus: 604800

  assign normal_min_future_date = normal_min_future_timestamp | date: '%d %b'
  assign normal_max_future_date = normal_max_future_timestamp | date: '%d %b'

  assign normal_min_month = normal_min_future_timestamp | date: '%b'
  assign normal_max_month = normal_max_future_timestamp | date: '%b'

  if normal_min_month == normal_max_month
    assign min_day = normal_min_future_date | split: ' ' | first
    assign max_day = normal_max_future_date | split: ' ' | first
    assign normal_date_range = normal_min_month | append: ' ' | append: min_day | append: ' - ' | append: max_day | append: '.'
  else
    assign normal_date_range = normal_min_future_date | append: ' - ' | append: normal_max_future_date | append: '.'
  endif
%}
  
{% liquid
  if id == 'normal'
    assign shipping_date = normal_date_range
  elsif id == 'fastest'
    assign shipping_date = date_range
  endif
%}

{{ shipping_date }}
