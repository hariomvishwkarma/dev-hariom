    "faq_2_TN4eC8": {
      "type": "faq-2",
      "blocks": {
        "question_prHwAk": {
          "type": "question",
          "settings": {
            "title": "Können Privatrezepte eingereicht werden?",
            "answer": "<p>Gern stempeln wir Ihnen Ihr Privatrezept ab, wenn Sie dies für Ihre Versicherung benötigen. Das Rezept können Sie uns im Anschluss an Ihre Bestellung einfach per E-Mail oder Post zusenden.</p>"
