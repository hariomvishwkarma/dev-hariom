      "blocks": {
        "16630884757349b90e-0": {
          "type": "item",
          "settings": {
            "image": "shopify://shop_images/6D242BFD-F2EB-49C6-9DEC-115484FF8F7C_1_105_c.jpg",
            "tab_label": "",
            "subheading": "",
            "title": "Chronik",
            "content": "<ul><li>1919 Gründung einer orthopädischen Werkstatt durch Bruno Schmidt</li><li>1937 Umbenennung in „Sanitäts- und Korsettgeschäft Schmidt“</li><li>1937 Eröffnung der Abteilung „Sanitätshaus-Fachgeschäft“</li><li>1959 Umfirmierung zu „Sanitätshaus R. Schmidt und Sohn“</li><li>1967 Neuer Name: „Orthopädie-Bandagen Schmidt und Pohl“</li><li>1988 Umbenennung in „Orthopädietechnik Pohl und Wolf“</li><li>1994 Gründung der „Orthopädietechnik Wolf GmbH“</li><li>2001 Eröffnung der Abteilung „Rehatechnik“</li><li>2004 Gründung des Onlineshops und der Marke „Careshop“</li><li>2012 Eröffnung der Abteilung „Homecare“</li><li>2018 Umzug des Onlineshops sowie der Abteilungen Reha-Technik und Homecare in das Logistikzentrum in Chemnitz-Röhrsdorf (über 2000 qm Lagerfläche, Werkstatt und Verwaltung)</li><li>2024 Standorterweiterung in Hohenstein-Ernstthal: Eröffnung eines Sanitätshauses mit Reha-Technik und Homecare in der Herrmannstraße 4</li><li>2025 Neues „Zentrum für Orthopädietechnik“ in der Lungwitzer Straße 26 in Hohenstein-Ernstthal</li></ul>",
            "button_text": "",
            "button_link": ""
          }
        }
      },
