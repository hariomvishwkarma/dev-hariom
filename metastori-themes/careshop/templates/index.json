        },
        "question_qFMa33": {
          "type": "question",
          "settings": {
            "title": "Können Rezepte der gesetzlichen Krankenkassen eingelöst werden?",
            "answer": "<p>Im Moment lösen wir keine Rezepte der gesetzlichen Krankenkassen ein.</p>"
          }
        },
        "question_XnbFhA": {
          "type": "question",
          "settings": {
            "title": "Mit welchem Versanddienstleister kommen die Pakete?",
            "answer": "<p>Wir versenden unsere Pakete fast immer mit DHL. Somit ist auch eine Lieferung an Packstationen möglich. Nur bei sehr sperrigen oder großen Lieferungen kann es sein, dass wir eine Spedition beauftragen müssen.</p>"
          }
        },
        "question_tU7tPE": {
          "type": "question",
          "settings": {
            "title": "Welche Zahlungsarten bieten wir an?",
            "answer": "<p>Im Moment sind folgende Zahlungsarten verfügbar:</p><ul><li>Kauf auf Rechnung (bei erfolgreicher Bonitätsprüfung)</li><li>Kreditkarten (Mastercard, Visa und American Express)</li><li>Nachnahme</li><li>PayPal</li><li>Vorauskasse</li><li>Google Pay</li><li>Apple Pay</li></ul>"
          }
        },
