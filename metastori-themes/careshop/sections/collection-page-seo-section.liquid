{% if collection.description != blank %}
  
  <link rel="stylesheet" href="{{ 'seo-section.css' | asset_url }}">
<style>
  {% if section.settings.hover-color != "rgba(0,0,0,0)" %}
  #shopify-section-{{ section.id }} a:hover {
    color: {{section.settings.hover-color}} !important;
    text-decoration-color: {{section.settings.hover-color}} !important;
}
  {% endif %}

section.custom-section-seo-text.collection-page-custom-seo .inner-seo-flex {
    display: block !important;
}
</style>



<section {{ section.settings.hover-color }} style="background-color:{{ section.settings.background }};" class="custom-section-seo-text section collection-page-custom-seo">
  <div class="section__color-wrapper">
    <div class="container">
      {% if section.settings.main-heading %}
      <div class="main-header-seo">
<h2 style="color:{{ section.settings.text_color }};" class="main-header-seo">{{ section.settings.main-heading }}</h2>
      </div>
      {% endif %}
      <div class="inner-seo-flex">
      {{ collection.description }}
            <div class="{% if block.settings.hide-mobile %}hidden-phone {% endif %}seo-inner-item">
              {% if block.settings.heading %}
              <h4 style="color:{{ section.settings.text_color }};" class="seo-text-inner-heading">{{ block.settings.heading }}</h4>
              {% endif %}
              {% if block.settings.content %}
              <div style="color:{{ section.settings.text_color_content }};" class="seco-text-inner-content">{{ block.settings.content }}</div>
              {% endif %}
            </div>
           
       
      </div>
          </div>
      
  </div>
</section>

  {% endif %}

{% schema %}
{
  "name": "collection seo",
  "class": "shopify-section--seo-text",
  "settings": [
     {
      "type": "text",
      "id": "main-heading",
      "label": "Main Heading",
      "default": "heading"
    },
    {
      "type": "color",
      "id": "background",
      "label": "Background",
      "default": "rgba(0,0,0,0)"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Color",
      "default": "#132A53"
    },
     {
      "type": "color",
      "id": "text_color_content",
      "label": "Color",
      "default": "#000"
    },
     {
      "type": "color",
      "id": "hover-color",
      "label": "hover color of all anchor links",
      "default": "#132A53"
    }
  ],
  "presets": [
    {
      "name": "collection seo-Text",
   
      "settings": {}
    }
  ]
}
{% endschema %}