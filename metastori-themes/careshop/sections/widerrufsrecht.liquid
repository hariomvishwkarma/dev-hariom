<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link
  href="https://fonts.googleapis.com/css2?family=Roboto:ital,wght@0,100..900;1,100..900&display=swap"
  rel="stylesheet"
>
<link rel="stylesheet" href="{{ 'widerrufsrecht.css' | asset_url }}">

<section class="shopify-section--widerrufsrecht">
  {% if customer %}
  <div class="link-bar hidden-phone">
    <div class="container">
      <div class="link-bar__wrapper">
        <ul class="link-bar__linklist list--unstyled" role="list">
          <li class="link-bar__link-item">
            <a href="{{ routes.account_url }}" class="link-bar__link link--animated">
              {{- 'customer.orders.title' | t -}}
            </a>
          </li>

          <li class="link-bar__link-item">
            <a href="{{ routes.account_addresses_url }}" class="link-bar__link link--animated">
              {{- 'customer.addresses.title' | t -}}
            </a>
          </li>

          <li class="link-bar__link-item text--underlined">
            <a href="/pages/widerrufsrecht" class="link-bar__link link--animated">Widerrufsrecht</a>
          </li>

          <li class="link-bar__link-item">
            <a
              href="{{ routes.account_logout_url }}"
              class="link-bar__link link--animated text--subdued"
              data-no-instant
            >
              {{- 'customer.logout.title' | t -}}
            </a>
          </li>
        </ul>
      </div>
    </div>
  </div>

  <div class="mobile-toolbar hidden-tablet-and-up">
    <button class="mobile-toolbar__item" is="toggle-button" aria-expanded="false" aria-controls="account-links-popover">
      Widerrufsrecht
      {%- render 'icon' with 'chevron' -%}
    </button>
  </div>

  <popover-content id="account-links-popover" class="popover">
    <span class="popover__overlay"></span>

    <header class="popover__header">
      <span class="popover__title heading h6">{{- 'customer.general.title' | t -}}</span>

      <button
        type="button"
        class="popover__close-button tap-area tap-area--large"
        data-action="close"
        title="{{ 'general.accessibility.close' | t | escape }}"
      >
        {%- render 'icon' with 'close' -%}
      </button>
    </header>

    <div class="popover__content">
      <div class="popover__choice-list">
        <a href="{{ routes.account_url }}" class="popover__choice-item">
          <span class="popover__choice-label">{{ 'customer.orders.title' | t }}</span>
        </a>

        <a href="{{ routes.account_addresses_url }}" class="popover__choice-item">
          <span class="popover__choice-label">{{ 'customer.addresses.title' | t }}</span>
        </a>

        <a href="/pages/widerrufsrecht" class="popover__choice-item">
          <span class="popover__choice-label" aria-current="true">Widerrufsrecht</span>
        </a>

        <a href="{{ routes.account_logout_url }}" class="popover__choice-item text--subdued" data-no-instant>
          <span class="popover__choice-label">{{ 'customer.logout.title' | t }}</span>
        </a>
      </div>
    </div>
  </popover-content>
{%  endif %}
  <div class="container">
    <div class="page-header">
      <div class="page-header__text-wrapper text-container">
        <h1 class="heading h2">{{ page.title }}</h1>
      </div>
    </div>

    {%- if page.content != blank -%}
      <div class="page-content rte">
        {{- page.content -}}
      </div>
    {%- endif -%}

    {%- if section.settings.embed_code != blank -%}
      <div class="widerrufsrecht__form page-content">
        {{- section.settings.embed_code -}}
        {%- if section.settings.after_form_text != blank -%}
          <div class="widerrufsrecht__after-form page-content rte">
            {{- section.settings.after_form_text -}}
          </div>
        {%- endif -%}
      </div>
    {%- endif -%}

    {%- if section.settings.phone_number != blank or section.settings.phone_content != blank -%}
      <div class="widerrufsrecht__phone-card page-content">
        <div class="widerrufsrecht__phone-icon" aria-hidden="true">
          <svg xmlns="http://www.w3.org/2000/svg" width="59" height="59" viewBox="0 0 59 59" fill="none">
            <path fill-rule="evenodd" clip-rule="evenodd" d="M24.7016 34.0946C21.8254 31.2184 19.6571 27.998 18.2165 24.7308C17.9117 24.04 18.0912 23.2313 18.6246 22.6978L20.638 20.6844C22.2875 19.0349 22.2875 16.7019 20.8469 15.2613L17.9609 12.3777C16.0409 10.4578 12.9287 10.4578 11.0087 12.3777L9.40587 13.9781C7.58424 15.7997 6.82462 18.4277 7.31628 21.0335C8.5307 27.4571 12.2624 34.4904 18.2829 40.5109C24.3034 46.5313 31.3367 50.2631 37.7603 51.4775C40.3661 51.9692 42.9941 51.2095 44.8157 49.3879L46.4161 47.7875C48.336 45.8676 48.336 42.7553 46.4161 40.8354L43.5324 37.9518C42.0919 36.5112 39.7564 36.5112 38.3183 37.9518L36.0984 40.1741C35.565 40.7075 34.7562 40.887 34.0654 40.5822C30.7983 39.1391 27.5779 36.9684 24.7016 34.0946Z" stroke="#FF7D00" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
            <path d="M31.7624 12.7095V6.95703" stroke="#FF7D00" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
            <path d="M42.0137 16.7658L46.0699 12.7341" stroke="#FF7D00" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
            <path d="M46.0938 27.0417H51.8217" stroke="#FF7D00" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </div>

        {%- if section.settings.phone_number != blank -%}
          <p class="widerrufsrecht__phone-number">{{ section.settings.phone_number | escape }}</p>
        {%- endif -%}

        {%- if section.settings.phone_content != blank -%}
          <div class="widerrufsrecht__phone-text rte">
            {{- section.settings.phone_content -}}
          </div>
        {%- endif -%}

        {%- if section.settings.phone_number != blank -%}
          {%- assign phone_href = section.settings.phone_number
            | remove: ' '
            | remove: '('
            | remove: ')'
            | remove: '-'
            | remove: '.'
          -%}
          <a href="tel:{{ phone_href }}" class="widerrufsrecht__phone-button">
            <svg width="18" height="18" viewBox="0 0 18 18" fill="none" xmlns="http://www.w3.org/2000/svg">
              <path fill-rule="evenodd" clip-rule="evenodd" d="M6.9457 10.3404C5.92923 9.32391 5.16297 8.18582 4.65387 7.03121C4.54614 6.78709 4.60956 6.50126 4.79809 6.31274L5.50961 5.60121C6.09256 5.01826 6.09256 4.1938 5.58346 3.6847L4.56352 2.66562C3.885 1.98711 2.78514 1.98711 2.10662 2.66562L1.54018 3.2312C0.89642 3.87496 0.627969 4.80368 0.801724 5.72458C1.2309 7.99469 2.5497 10.4802 4.67733 12.6079C6.80496 14.7355 9.29052 16.0543 11.5606 16.4835C12.4815 16.6572 13.4102 16.3888 14.054 15.745L14.6196 15.1795C15.2981 14.5009 15.2981 13.4011 14.6196 12.7226L13.6005 11.7035C13.0914 11.1944 12.2661 11.1944 11.7578 11.7035L10.9733 12.4889C10.7848 12.6774 10.499 12.7408 10.2549 12.6331C9.10026 12.1231 7.96216 11.356 6.9457 10.3404Z" stroke="white" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
              <path d="M9.44122 2.78293V0.75" stroke="white" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
              <path d="M13.0635 4.21654L14.497 2.79175" stroke="white" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
              <path d="M14.5059 7.84796H16.5301" stroke="white" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>

            {{- section.settings.phone_button_text | escape -}}
          </a>
        {%- endif -%}
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Widerrufsrecht",
  "class": "shopify-section--widerrufsrecht",
  "settings": [
    {
      "type": "header",
      "content": "Embedded form"
    },
    {
      "type": "html",
      "id": "embed_code",
      "label": "Embed code"
    },
    {
      "type": "richtext",
      "id": "after_form_text",
      "label": "Text after form"
    },
    {
      "type": "header",
      "content": "Phone contact"
    },
    {
      "type": "text",
      "id": "phone_number",
      "label": "Phone number",
      "default": "(0531) 1234-567-490"
    },
    {
      "type": "richtext",
      "id": "phone_content",
      "label": "Text"
    },
    {
      "type": "text",
      "id": "phone_button_text",
      "label": "Button text",
      "default": "Jetzt anrufen"
    }
  ],
  "presets": [
    {
      "name": "Widerrufsrecht"
    }
  ]
}
{% endschema %}
