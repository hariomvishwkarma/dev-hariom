 <link rel="stylesheet" href="{{ 'quality-process.css' | asset_url }}">

{%- if section.settings.background != settings.background and section.settings.background != 'rgba(0,0,0,0)' -%}
  {%- assign blends_with_background = false -%}
{%- else -%}
  {%- assign blends_with_background = true -%}
{%- endif -%}

<style>
  #shopify-section-{{ section.id }} {
    {%- if section.settings.text_color == 'rgba(0,0,0,0)' -%}
      {%- assign heading_color = settings.heading_color -%}
      {%- assign text_color = settings.text_color -%}
    {%- else -%}
      {%- assign heading_color = section.settings.text_color -%}
      {%- assign text_color = section.settings.text_color -%}
    {%- endif -%}

    {%- if section.settings.background == 'rgba(0,0,0,0)' -%}
      {%- assign section_background = settings.background -%}
      {%- assign secondary_background = settings.secondary_background -%}
    {%- else -%}
      {%- assign section_background = section.settings.background -%}
      {%- assign secondary_background = section.settings.background | color_mix: text_color, 85 -%}
    {%- endif -%}

    --secondary-background: {{ secondary_background.red }}, {{ secondary_background.green }}, {{ secondary_background.blue }};
    --heading-color: {{ heading_color.red }}, {{ heading_color.green }}, {{ heading_color.blue }};
    --text-color: {{ text_color.red }}, {{ text_color.green }}, {{ text_color.blue }};

    --section-background: {{ section_background.red }}, {{ section_background.green }}, {{ section_background.blue }};
  }
span.counter-custom-process {
    margin-right: 5px;
}
</style>

<section class="section quality-and-process">
    <div class="section__color-wrapper">
  <div class="container">
    <!-- Left Section: Quality and Verification -->
    <div style="background-color:{{ section.settings.background_items }};" class="quality-verification">
      <h2>{{ section.settings.quality_heading }}</h2>
      <p>{{ section.settings.quality_description }}</p>
      <div class="icon-with-text">
       
        <div class="icon-text-list">
          {% for i in (1..5) %}
          
            {% assign text_key = 'quality_text_' | append: i %}
            {% if section.settings[text_key] != blank %}
                <div class="custom-process-icon-wrap">
              {% if section.settings.quality_icon != blank %}
                <div class="label-image-process" >
           
                     <img id="section-{{ section.id }}-{{ section.settings.image.id }}" class="process-main-icon" } sizes="(max-width: 740px) calc(100vw - 96px), (max-width: 999px) calc(100vw - 160px), 600px" loading="lazy" {% render 'image-attributes', image: section.settings.quality_icon, sizes: '600,700,800,1000,1200,1400' %}>
       
                </div>
            {% endif %}
                <span class="label-text-process">{{ section.settings[text_key] }}</span>
               </div>
            {% endif %}
           
          {% endfor %}
        </div>
      </div>
    </div>

    <!-- Right Section: Order Process -->
    <div class="order-process">
      <h2 class="process-main-heading">{{ section.settings.process_heading }}</h2>
      <ul class="process-items-wrap">
        {% for step in section.blocks %}
          <li class="process-items">
            {% if step.settings.step_icon != blank %}
              <div class="process-images">
                 <img id="block-{{ block.id }}-{{ block.settings.image.id }}" class="process-image-icon" } sizes="(max-width: 740px) calc(100vw - 96px), (max-width: 999px) calc(100vw - 160px), 600px" loading="lazy" {% render 'image-attributes', image: step.settings.step_icon, sizes: '600,700,800,1000,1200,1400' %}>
       
              </div>
            {% endif %}
            <span class="counter-custom-process">{{ forloop.index }}.</span>
            <span class="test-point-custom-process">{{ step.settings.step_text }}</span>
          </li>
        {% endfor %}
      </ul>
    </div>
  </div>
    </div>
</section>


{% schema %}
{
  "name": "quality and process",
    "class": "shopify-section--quality-process",
  "settings": [
    {
      "type": "text",
      "id": "quality_heading",
      "label": "Quality Section Heading",
      "default": "Qualität und Verifizierung"
    },
    {
      "type": "textarea",
      "id": "quality_description",
      "label": "Quality Section Description",
      "default": "Lorem ipsum dolor sit amet consectetur. Mauris orci pretium gravida suspendisse viverra. Vestibulum purus ornare quam fermentum vestibulum cras. Vestibulum eu lacus nibh ultricies. Non massa netus sed tristique platea ullamcorper orci arcu. Commodo ut integer massa id egestas massa."
    },
    {
      "type": "image_picker",
      "id": "quality_icon",
      "label": "Quality Icon"
    },
    {
      "type": "text",
      "id": "quality_text_1",
      "label": "Quality Text 1",
      "default": "Lorem Ipsum"
    },
    {
      "type": "text",
      "id": "quality_text_2",
      "label": "Quality Text 2",
      "default": "Lorem Ipsum"
    },
    {
      "type": "text",
      "id": "quality_text_3",
      "label": "Quality Text 3",
      "default": "Lorem Ipsum"
    },
    {
      "type": "text",
      "id": "quality_text_4",
      "label": "Quality Text 4"
    
    },
    {
      "type": "text",
      "id": "quality_text_5",
      "label": "Quality Text 5"
    
    },
    {
      "type": "text",
      "id": "process_heading",
      "label": "Process Section Heading",
      "default": "Ihr Bestellprozess"
    },
        {
      "type": "header",
      "content": "Colors"
    },
 
      {
      "type": "color",
      "id": "background_items",
      "label": "left item Background",
      "default": "#ECF1F8"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#313131"
    }
  ],
  "blocks": [
    {
      "type": "process_step",
      "name": "Process Step",
      "settings": [
        {
          "type": "image_picker",
          "id": "step_icon",
          "label": "Step Icon"
        },
     
        {
          "type": "text",
          "id": "step_text",
          "label": "Step Text",
          "default": "Sie legen Ihr Produkt in den Warenkorb"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Quality and Process"
  
    }
  ]
}
{% endschema %}


{% stylesheet %}




{% endstylesheet %}
