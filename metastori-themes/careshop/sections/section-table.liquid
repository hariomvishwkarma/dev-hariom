<section class="section">
  <div class="container">
    <div class="c-table-heading-text">
        {% if section.settings.title != blank %}
           <h2>{{ section.settings.title }}</h2>
        {% endif %}
        {% if section.settings.content != blank %}
           {{ section.settings.content }}
        {% endif %}
    </div>
    <ul class="shipping-list">
          {%- for block in section.blocks -%}
            {% case block.type %}
              {% when 'heading' %}
                  <li class="shipping-header {% if forloop.first %}shipping-header-m{% endif %}">
                    {% if block.settings.heading1 != blank %}
                       <div>{{ block.settings.heading1 }}</div>
                    {% endif %}
                    {% if block.settings.heading2 != blank %}
                       <div>{{ block.settings.heading2 }}</div>
                    {% endif %}
                    {% if block.settings.heading3 != blank %}
                       <div>{{ block.settings.heading3 }}</div>
                    {% endif %}
                    {% if block.settings.heading4 != blank %}
                       <div>{{ block.settings.heading4 }}</div>
                    {% endif %}
                    {% if block.settings.heading5 != blank %}
                       <div>{{ block.settings.heading5 }}</div>
                    {% endif %}
                    {% if block.settings.heading6 != blank %}
                       <div>{{ block.settings.heading6 }}</div>
                    {% endif %}
                  </li>
              {% when 'innrtext' %}
                <li class="shipping-row {% if forloop.last %}alt{% endif %}" {% if block.settings.bg-color %}style="background-color:{{ block.settings.bg-color }};"{% endif %}>
                    {% if block.settings.text1 != blank %}
                       <div class="range-cell">{{ block.settings.text1 }}</div>
                    {% endif %}
                    {% if block.settings.text2 != blank %}
                       <div>{{ block.settings.text2 }}</div>
                    {% endif %}
                    {% if block.settings.text3 != blank %}
                       <div>{{ block.settings.text3 }}</div>
                    {% endif %}
                    {% if block.settings.text4 != blank %}
                       <div>{{ block.settings.text4 }}</div>
                    {% endif %}
                    {% if block.settings.text5 != blank %}
                       <div>{{ block.settings.text5 }}</div>
                    {% endif %}
                    {% if block.settings.text6 != blank %}
                       <div>{{ block.settings.text6 }}</div>
                    {% endif %}
               </li>
            {% endcase %}

          {% endfor %}
  
    </ul>
  </div>
</section>
{% schema %}
  {
    "name": "Section table",
    "class":"section-table",
    "settings": [
          {
            "type": "text",
            "id": "title",
            "label": "Title"
          },
          {
            "type": "richtext",
            "id": "content",
            "label": "Text"
          }
    ],
    "blocks": [
      {
        "type": "heading",
        "name": "Heading",
        "settings": [
          {
            "type": "text",
            "id": "heading1",
            "label": "Heading 1"
          },
          {
            "type": "text",
            "id": "heading2",
            "label": "Heading 2"
          },
          {
            "type": "text",
            "id": "heading3",
            "label": "Heading 3"
          },
          {
            "type": "text",
            "id": "heading4",
            "label": "Heading 4"
          },
          {
            "type": "text",
            "id": "heading5",
            "label": "Heading 5"
          },
          {
            "type": "text",
            "id": "heading6",
            "label": "Heading 6"
          }
        ]
      },
      {
        "type": "innrtext",
        "name": "Text",
        "settings": [
          {
            "type": "color",
            "id": "bg-color",
            "label": "Background color"
          },
          {
            "type": "text",
            "id": "text1",
            "label": "Text 1"
          },
          {
            "type": "text",
            "id": "text2",
            "label": "Text 2"
          },
          {
            "type": "text",
            "id": "text3",
            "label": "Text 3"
          },
          {
            "type": "text",
            "id": "text4",
            "label": "Text 4"
          },
         {
            "type": "text",
            "id": "text5",
            "label": "Text 5"
          },
          {
            "type": "text",
            "id": "text6",
            "label": "Text 6"
          }
        ]
      }
    ],
    "presets": [
      {
        "name": "Section table"
      }
    ]
  }
{% endschema %}