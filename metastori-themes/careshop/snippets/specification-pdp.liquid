
{% if product.variants.size > 0 %}
<div class="all-data-inside-variant-">
  
{% for variant in product.variants %}
<div i class="spec-data-{{ variant.id }} metafield-data-spec-main{% if product.selected_or_first_available_variant.id == variant.id %} active{% endif %}">

<div class="custom-variant-spec-data">
    {% if variant.metafields.variant.HerstellerNr  != blank %}
 <div class="inner-data-spec">
   <strong>Hersteller: </strong><span class="meta-exact-data">{{ product.vendor }}</span>
 </div> 
  {% endif %}
    {% if variant.sku != blank %}
 <div class="inner-data-spec">
   <strong>Bestell-Nr.: </strong><span class="meta-exact-data">{{  variant.sku  }}</span>
 </div> 
  {% endif %}
  {% if variant.metafields.variant.HerstellerNr  != blank %}
 <div class="inner-data-spec">
   <strong>Hersteller-Nr: </strong><span class="meta-exact-data">{{ variant.metafields.variant.HerstellerNr }}</span>
 </div> 
  {% endif %}
    {% if variant.barcode != blank %}
 <div class="inner-data-spec">
   <strong>EAN: </strong><span class="meta-exact-data">{{  variant.barcode  }}</span>
 </div> 
  {% endif %}
  {% if variant.metafields.variant.PZN != blank %}
 <div class="inner-data-spec">
   <strong>PZN: </strong><span class="meta-exact-data">{{  variant.metafields.variant.PZN  }}</span>
 </div> 
  {% endif %}
    {% if variant.metafields.variant.HMV != blank %}
 <div class="inner-data-spec">
   <strong>HMV Nummer: </strong><span class="meta-exact-data">{{  variant.metafields.variant.HMV  }}</span>
 </div> 
  {% endif %}

</div>
</div>
  {% endfor %}
</div>
  {% endif %}