<!-- Google Tag Manager - Consentmo / GDPR Compliant -->
<script>
document.addEventListener('consentmoSignal_onLoad', function(eventData) {
  const csmLoadSignal = eventData.detail || { isActive: false };

  function loadGTM() {
    (function(w,d,s,l,i){
      w[l]=w[l]||[];
      w[l].push({
        'gtm.start': new Date().getTime(),
        event:'gtm.js'
      });
      var f=d.getElementsByTagName(s)[0],
          j=d.createElement(s),
          dl=l!='dataLayer' ? '&l='+l : '';
      j.async=true;
      j.src='https://www.googletagmanager.com/gtm.js?id='+i+dl;
      f.parentNode.insertBefore(j,f);
    })(window,document,'script','dataLayer','GTM-M77J5RJG');
  }

  // If Consentmo is inactive (out-of-region rules)
  if (!csmLoadSignal.isActive) {
    loadGTM();
  } else {
    // Wait for user consent
    document.addEventListener('consentmoSignal', function(event) {
      const consentState = event.detail?.state;

      if (consentState &&
          (consentState.analytics_storage === 'granted' ||
           consentState.ad_storage === 'granted' ||
           consentState.functionality_storage === 'granted')) {
        loadGTM();
      }
    });
  }
});
</script>
<!-- End Google Tag Manager -->