{%- comment -%}
  Variant B inventory — added above original. Does not modify original inventory markup.
{%- endcomment -%}

{% render 'ed-pdp-inventory-ab', section: section, block: block %}

{%- if product.template_suffix != 'pre-order' and product.available or product.selected_or_first_available_variant.incoming -%}
  <div class="pdp-inventory-ab-stack">
    <product-inventory
      form-id="{{ product_form_id }}"
      class="product-form__inventory-wrapper pdp-inventory-ab--variant-b"
    >
      {%- render 'ed-pdp-inventory-message-b',
        variant: product.selected_or_first_available_variant,
        block: block,
        future_date: future_date,
        product: product
      -%}

      <script type="application/json">
        {
          {%- for variant in product.variants -%}
            {%- capture inventory_message_b -%}
              {%- render 'ed-pdp-inventory-message-b', variant: variant, block: block, future_date: future_date, product: product -%}
            {%- endcapture -%}

            "{{ variant.id }}": {{ inventory_message_b | json }}{% unless forloop.last %},{% endunless %}
          {%- endfor -%}
        }
      </script>
    </product-inventory>

    {% render 'ed-pdp-free-shipping',
      block: block,
      product: product,
      product_form_id: product_form_id,
      section: section
    %}
  </div>
{%- else -%}
  <div class="pdp-inventory-ab-stack">
    <product-inventory
      form-id="{{ product_form_id }}"
      class="product-form__inventory-wrapper pdp-inventory-ab--variant-b"
    >
      {%- unless product.selected_or_first_available_variant.available -%}
        {%- render 'ed-pdp-inventory-message-b',
          variant: product.selected_or_first_available_variant,
          block: block,
          future_date: future_date,
          product: product
        -%}
      {%- endunless -%}

      <script type="application/json">
        {
          {%- for variant in product.variants -%}
            {%- capture inventory_message_b -%}
              {%- render 'ed-pdp-inventory-message-b', variant: variant, block: block, future_date: future_date, product: product -%}
            {%- endcapture -%}

            "{{ variant.id }}": {{ inventory_message_b | json }}{% unless forloop.last %},{% endunless %}
          {%- endfor -%}
        }
      </script>
    </product-inventory>

    {% render 'ed-pdp-free-shipping',
      block: block,
      product: product,
      product_form_id: product_form_id,
      section: section
    %}
  </div>
{%- endif -%}
