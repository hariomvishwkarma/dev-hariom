{%- comment -%}
  Cart line item delivery time message.
  Params: variant (line_item.variant)

  Logic:
  - In stock in warehouse → "Lieferzeit ca. 1-3 Werktage"
  - Out of stock with continue selling → variant.metafields.variant.Lieferzeit
{%- endcomment -%}

{%- if variant.requires_shipping -%}
  {%- assign cart_delivery_time = '' -%}
  {%- assign cart_delivery_prefix = '' -%}

  {%- if variant.inventory_policy == 'continue' and variant.inventory_quantity <= 0 -%}
    {%- if variant.metafields.variant.Lieferzeit != blank -%}
      {%- assign cart_delivery_time = variant.metafields.variant.Lieferzeit -%}
    {%- endif -%}
  {%- elsif variant.inventory_quantity > 0 or variant.inventory_management != 'shopify' -%}
    {%- assign cart_delivery_prefix = 'Lieferzeit ca. ' -%}
    {%- assign cart_delivery_time = '1-3 Werktage' -%}
  {%- endif -%}

  {%- if cart_delivery_time != blank -%}
    <div class="cart-shipping-message">
      <span class="cart-shipping-message__dot" aria-hidden="true"></span>
      <span class="cart-shipping-message__text">
        {{- cart_delivery_prefix -}}
        <span class="cart-shipping-message__time">{{ cart_delivery_time }}</span>
      </span>
    </div>
  {%- endif -%}
{%- endif -%}
