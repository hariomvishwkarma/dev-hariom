{%- comment -%}
  New cart note UI — all CSS/JS in this file. Existing order note in mini-cart.liquid is unchanged.
  Usage: {% render 'ed-cart-note-modal', cart: cart, part: 'trigger' %}
         {% render 'ed-cart-note-modal', cart: cart, part: 'modal' %}
{%- endcomment -%}

{%- if part == 'trigger' -%}
  <button
    type="button"
    is="toggle-button"
    id="ed-cart-note-trigger"
    class="ed-cart-note-trigger"
    aria-controls="ed-cart-note-modal"
    aria-expanded="false"
  >
    <span class="ed-cart-note-trigger__icon" aria-hidden="true">
      <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 16 16" fill="none">
        <path d="M2.5 8H13.5" stroke="#171717" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
        <path d="M8 2.5V13.5" stroke="#171717" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
    </span>
    <span class="ed-cart-note-trigger__label" data-note-trigger-label>
      {%- if cart.note == blank -%}
        {{- 'cart.general.add_order_note' | t -}}
      {%- else -%}
        {{- 'cart.general.edit_order_note' | t -}}
      {%- endif -%}
    </span>
  </button>
{%- elsif part == 'modal' -%}
  <openable-element id="ed-cart-note-modal" class="ed-cart-note-modal">
    <span class="openable__overlay"></span>

    <div class="ed-cart-note-modal__panel">
      <header class="ed-cart-note-modal__header">
        <h3 class="ed-cart-note-modal__title">{{ 'cart.general.order_note_modal_title' | t }}</h3>
        <button
          type="button"
          class="ed-cart-note-modal__close tap-area"
          data-action="close"
          title="{{ 'general.accessibility.close' | t | escape }}"
        >
          <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none">
            <path d="M18.75 5.25L5.25 18.75" stroke="#343330" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
            <path d="M18.75 18.75L5.25 5.25" stroke="#343330" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
        </button>
      </header>

      <textarea
        id="ed-cart-note-textarea"
        class="ed-cart-note-modal__textarea input__field input__field--textarea"
        rows="6"
        placeholder="{{ 'cart.general.order_note_modal_placeholder' | t }}"
        data-saved-note="{{ cart.note | escape }}"
      >{{ cart.note }}</textarea>

      <button type="button" class="ed-cart-note-modal__save button button--primary button--full" data-action="save-note">
        {{- 'cart.general.order_note_save_attach' | t -}}
      </button>

      <button type="button" class="ed-cart-note-modal__discard" data-action="discard-note">
        {{- 'cart.general.order_note_discard_close' | t -}}
      </button>
    </div>
  </openable-element>

  <style>
    #mini-cart .ed-cart-note-trigger {
      display: none;
      align-items: center;
      gap: 8px;
      width: 100%;
      padding: 8px;
      margin-bottom: 14px;
      border: none;
      border-radius: 8px;
      background: #f0f2f5;
      color: #000;
      font-size: 16px;
      font-weight: 400;
      line-height: normal;
      cursor: pointer;
      text-align: left;
    }

    #mini-cart .ed-cart-note-trigger__icon {
      display: flex;
      align-items: center;
      justify-content: center;
      flex-shrink: 0;
      width: 16px;
      height: 16px;
    }

    #mini-cart .ed-cart-note-trigger__icon svg {
      width: 16px;
      height: 16px;
    }

    #mini-cart .ed-cart-note-modal {
      display: block;
      position: absolute;
      bottom: 0;
      left: 0;
      width: 100%;
      z-index: 1;
      visibility: hidden;
      opacity: 0;
      transform: translateY(100%);
      transition: visibility 0.25s ease-in-out, opacity 0.25s ease-in-out, transform 0.25s ease-in-out;
    }

    #mini-cart .ed-cart-note-modal[open] {
      visibility: visible;
      opacity: 1;
      transform: translateY(0);
    }

    #mini-cart .ed-cart-note-modal__panel {
      display: flex;
      flex-direction: column;
      width: 100%;
      padding: 20px 16px 32px;
      border-radius: 16px 16px 0 0;
      background: #fff;
    }

    #mini-cart .ed-cart-note-modal__header {
      display: flex;
      align-items: flex-start;
      justify-content: space-between;
      gap: 12px;
      margin-bottom: 16px;
    }

    #mini-cart .ed-cart-note-modal__title {
      margin: 0;
      color: #000;
      font-size:21.6px;
      font-weight: 700;
      line-height: normal;
    }

    #mini-cart .ed-cart-note-modal__close {
      display: flex;
      align-items: center;
      justify-content: center;
      flex-shrink: 0;
      width: 24px;
      height: 24px;
      padding: 0;
      border: none;
      background: transparent;
      cursor: pointer;
    }

    #mini-cart .ed-cart-note-modal__close svg {
      width: 24px;
      height: 24px;
    }

    #mini-cart .ed-cart-note-modal__textarea {
      width: 100%;
      min-height: 225px;
      margin-bottom: 24px;
      padding: 16.5px 14px;
      border: 1px solid #d1d9e6;
      border-radius: 8px;
      resize: vertical;
      color: #000;
      font-size: 14px;
      line-height: 1.4;
    }

    #mini-cart .ed-cart-note-modal__textarea::placeholder {
      color: #9aa8b8;
    }

    #mini-cart .ed-cart-note-modal__save {
      display: flex;
      padding: 24px 32px;
      margin-bottom: 20px;
      align-items: center;
      justify-content: center;
      border-radius: 100px;
      font-size: 16px !important;
      font-weight: 700;
      line-height: normal;
      letter-spacing: normal;
    }

    #mini-cart .ed-cart-note-modal__discard {
      display: block;
      width: 100%;
      padding: 0;
      border: none;
      background: transparent;
      color: #db1f48;
      font-size: 14px;
      line-height: normal;
      text-align: center;
      text-decoration: underline;
      cursor: pointer;
    }

    @media screen and (max-width: 740px) {
      #mini-cart.ed-drawer .ed-cart-note-modal {
        left: 0;
        width: 100%;
      }

      @supports (padding: max(0px)) {
        #mini-cart .ed-cart-note-modal__panel {
          padding-bottom: max(24px, env(safe-area-inset-bottom, 0px) + 24px);
        }
      }
    }
    @media screen and (min-width:768px){
       #mini-cart .ed-cart-note-trigger {
        display: flex;
      }
      .mini-cart__actions{
        display:none;      
      }
    }
  </style>

  <script>
    (function () {
      if (window.__edCartNoteModalBound) {
        return;
      }

      window.__edCartNoteModalBound = true;

      const getElements = () => ({
        modal: document.getElementById('ed-cart-note-modal'),
        textarea: document.getElementById('ed-cart-note-textarea'),
        triggerLabel: document.querySelector('#mini-cart [data-note-trigger-label]')
      });

      const updateTriggerLabel = (note) => {
        const { triggerLabel } = getElements();

        if (!triggerLabel || !window.themeVariables?.strings) {
          return;
        }

        triggerLabel.textContent = note === ''
          ? window.themeVariables.strings.cartAddOrderNote
          : window.themeVariables.strings.cartEditOrderNote;
      };

      const saveNote = async (note) => {
        const { textarea } = getElements();

        if (!textarea) {
          return;
        }

        const response = await fetch(`${window.themeVariables.routes.cartUrl}/update.js`, {
          body: JSON.stringify({ note }),
          credentials: 'same-origin',
          method: 'POST',
          headers: {
            'Content-Type': 'application/json'
          }
        });

        const cartContent = await response.json();
        textarea.setAttribute('data-saved-note', note);
        updateTriggerLabel(note);

        document.documentElement.dispatchEvent(new CustomEvent('cart:updated', {
          bubbles: true,
          detail: {
            cart: cartContent
          }
        }));
      };

      document.addEventListener('click', async (event) => {
        const { modal, textarea } = getElements();

        if (!modal || !textarea || !modal.contains(event.target)) {
          return;
        }

        const saveButton = event.target.closest('[data-action="save-note"]');
        const discardButton = event.target.closest('[data-action="discard-note"]');

        if (saveButton) {
          event.preventDefault();
          await saveNote(textarea.value);
          modal.open = false;
          return;
        }

        if (discardButton) {
          event.preventDefault();
          textarea.value = '';
          await saveNote('');
          modal.open = false;
        }
      });

      document.documentElement.addEventListener('cart:updated', (event) => {
        const { textarea } = getElements();

        if (!textarea) {
          return;
        }

        const note = event.detail?.cart?.note || '';
        textarea.value = note;
        textarea.setAttribute('data-saved-note', note);
        updateTriggerLabel(note);
      });
    })();
  </script>
{%- endif -%}
