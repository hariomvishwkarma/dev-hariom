{% for video in product.metafields.standard.featured_video.value.sources %}
    {% assign video_url = video.url %}
{% endfor %}

<ed-video-thumbnail class="ed-video-thumbnail"
  {% if product.metafields.product.youtubevideo != blank %}
    video-src="{{ product.metafields.product.youtubevideo }}"
  {% else %}
                    video-src="{{ video_url }}"
    {% endif %}
                    autoplay="true"
                    controls="true">
    <div class="thumbnail-container btn-open">
        {% if product.metafields.standard.featured_video_thumbnail != blank %}
            
            <div class="overlay" style="border-color:{{ color_video_story }};"></div>
            <div class="play-btn">
                <span class="arrow-right-custom"><svg xmlns="http://www.w3.org/2000/svg" width="12" height="14" viewBox="0 0 12 14" fill="none">
  <path d="M12 7L3.01142e-07 13.9282L9.06825e-07 0.0717964L12 7Z" fill="white"/>
</svg></span><span class="video-custom-text">Video ansehen</span>
            </div>
        {% else %}
           
            <div class="play-btn">
                <span class="arrow-right-custom"><svg xmlns="http://www.w3.org/2000/svg" width="12" height="14" viewBox="0 0 12 14" fill="none">
  <path d="M12 7L3.01142e-07 13.9282L9.06825e-07 0.0717964L12 7Z" fill="white"/>
</svg></span><span class="video-custom-text">Video ansehen</span>
            </div>
        {% endif %}
    </div>
</ed-video-thumbnail>
