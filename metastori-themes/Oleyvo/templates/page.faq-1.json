              "blocks": {
                "text_LRg4Rb": {
                  "type": "text",
                  "settings": {
                    "text_tag_name": "h2",
                    "text_heading": "Das OLEYVO E-Bike",
                    "font_size_heading": "h5",
                    "text_duration": 1000,
                    "text_effect": "split",
                    "text_heading_width_desktop": 100,
                    "text_heading_width_mobile": 100,
                    "alignment": "center"
