    "introduction_text_CHTNVb": {
      "type": "introduction-text",
      "name": "t:sections.introduction_text.presets.name",
      "settings": {
        "content": "Bei OLEYVO profitierst du von 0 % Ratenzahlung mit Powerpay - ganz ohne Zinsen oder Zusatzkosten. So kannst du dein E-Bike sofort erhalten und bequem in monatlichen Beträgen bezahlen. Einfach, sicher und flexibel.",
