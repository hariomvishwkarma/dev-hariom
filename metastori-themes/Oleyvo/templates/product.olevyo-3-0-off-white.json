    "testimonial_style_4_ChLFyN": {
      "type": "testimonial-style-4",
      "blocks": {
        "testimonial_box_bXnFhB": {
          "type": "testimonial-box",
          "settings": {
            "content": "<p>\"Ich habe mich direkt in das Design verliebt. Es sieht nicht nur wunderschön aus, sondern unterstützt mich genau da, wo ich es brauche, damit ich mühelos zur Arbeit komme. Der Service war top, die Qualität überzeugt - dieses Bike würde ich sofort wieder kaufen. Endlich ein E-Bike, das nicht wie ein E-Bike aussieht!\"</p>",
            "customer_name": "Lee",
            "image": "shopify://shop_images/D2AE53A7-B849-4D28-B524-47981EE9BCA2.jpg"
          }
        },
        "testimonial_box_A9NFpK": {
          "type": "testimonial-box",
          "settings": {
            "content": "<p>\"Das ganze Einkaufserlebnis inklusive Testfahrt war sehr persönlich, sympathisch und unkompliziert. Mein Oleyvo wurde eine knappe Woche nach der Bestellung geliefert, die Montage des Bikes hat gut geklappt. Das Fahrgefühl ist der Hammer, eine Superinvestition!\"</p>",
            "customer_name": "Vero, Zürich",
            "image": "shopify://shop_images/IMG_0371.jpg"
          }
        },
        "testimonial_box_MxDN8J": {
          "type": "testimonial-box",
          "settings": {
            "content": "<p>“The e-bike is perfect for moving quickly and freely around the city. I use the bike every day to commute and have already ridden over 550 km – without any problems.”</p>",
            "customer_name": "Sandro",
            "image": "shopify://shop_images/IMG_3630.heic"
          }
        },
        "testimonial_box_RC9FWj": {
          "type": "testimonial-box",
          "settings": {
            "content": "<p>\"Mit dem Oleyvo Velo haben wir Turin auf eine völlig neue Art entdeckt – das stylische E-Bike hat uns mühelos und stilvoll überall hingebracht.<br/><br/>Das Fahrgefühl war super komfortabel, und das Design hat so manchen neugierigen Blick auf sich gezogen. Tolles E-Bike, kann ich nur empfehlen.<br/></p>",
            "customer_name": "Maja, Zürich",
            "image": "shopify://shop_images/WhatsApp_Image_2025-07-28_at_13.57.29.jpg"
          }
        }
      },
      "block_order": [
        "testimonial_box_bXnFhB",
        "testimonial_box_A9NFpK",
        "testimonial_box_MxDN8J",
        "testimonial_box_RC9FWj"
      ],
