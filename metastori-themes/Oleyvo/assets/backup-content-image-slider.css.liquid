{% elsif section.settings.row_direction == 'row-reverse' %}
  <style>
    .content-image-slider--{{ section.id }} .content-slider .slick-prev {
      left: 0;
      z-index: 2;
    }
    .content-image-slider--{{ section.id }} .content-slider .slick-next {
      right: unset;
      left: 18%;
    }
    .content-image-slider--{{ section.id }} .content-slider .slick-dots {
      left: 2.5%;
      width: 15% !important;
      top: 12.7%;
      justify-content: stretch;
      display: flex;
      bottom: unset;
      right: unset;
    }
  </style>
