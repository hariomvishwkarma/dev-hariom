

<div class="content-image-slider--{{ section.id }}">
  <div class="content-image-slider-wrapper content-slider">
    {% if section.blocks.size > 0 %}
      {% for block in section.blocks %}
        <div class="content-slide" style="flex-direction: {{ section.settings.row_direction }};">
          <div class="content-image-slider-wrapper--image">
            {% if block.settings.video_url != blank %}
              <div class="video-wrapper">
                <video disableremoteplayback controls autoplay muted playsinline style="max-height:600px; height:100%">
                  <source src="{{ block.settings.video_url }}" type="video/mp4">
                  Your browser does not support the video tag.
                </video>
              </div>
            {% elsif block.settings.column_image %}
              <img src="{{ block.settings.column_image | img_url: 'large' }}" alt="Column pic">
            {% endif %}
          </div>
          <div class="content-image-slider-wrapper--content">
            <div class="ark_slider-nav">
              <div class="custom-arrows-container-{{ section.id }}"></div>
              <div class="custom-dots-container-{{ section.id }}"></div>
            </div>
            <!-- <div class="navigation-container"></div> -->
            <h3>{{ block.settings.column_heading }}</h3>
            <p>{{ block.settings.column_text }}</p>
          </div>
        </div>
      {% endfor %}
    {% else %}
      <div class="content-slide" style="flex-direction: {{ section.settings.row_direction }};">
        <div class="content-image-slider-wrapper--image">
          {% if section.blocks[0].settings.video_url != blank %}
            <div class="video-wrapper">
              <video disableremoteplayback controls autoplay muted playsinline style="max-height:600px; height:100%">
                <source src="{{ section.blocks[0].settings.video_url }}" type="video/mp4">
                Your browser does not support the video tag.
              </video>
            </div>
          {% elsif section.blocks[0].settings.column_image %}
            <img src="{{ section.blocks[0].settings.column_image | img_url: 'large' }}" alt="Column pic">
          {% endif %}
        </div>
        <div class="content-image-slider-wrapper--content">
          <h3>{{ section.blocks[0].settings.column_heading }}</h3>
          <p>{{ section.blocks[0].settings.column_text }}</p>
        </div>
      </div>
    {% endif %}
  </div>
</div>

