{% comment %}
  Renders a wrapper block

  Accepts:
  - direction: {String} Direction (optional)
  - vertical_gap: {String} Vertical spacing (optional)
  - horizontal_gap: {String} Horizontal spacing (optional)
  - Aligment: {String} Alignment (optional)
  - width: {String} Width (optional)

  Usage:
  {% render 'wrapper-block',
    direction: direction,
    vertical_gap: vertical_gap,
    horizontal_gap: horizontal_gap,
    alignment: alignment,
    width: width,
  %}
{% endcomment %}

{% comment %}
  {% liquid
    assign style_start = 'data-style-start="'
    assign style_end = '" data-style-end'
    assign column_space = '<template data-column-space></template>'
    assign column_contents = content | split: column_space
    assign final_content = ''

    for column_content in column_contents
      assign style = column_content | split: style_start | last | split: style_end | first
      assign class_and_style = 'xo-column-2" style="' | append: style | append: '"'
      assign template = '<template data-style-start="' | append: style | append: '" data-style-end></template>'
      assign final_column_content = column_content | replace: template, ''
      assign final_column_content = final_column_content | replace: 'xo-column-2"', class_and_style
      assign final_content = final_content | append: final_column_content
    endfor
  %}
{% endcomment %}

<div
  class='xo-wrapper-block{% if width %} xo-wrapper-block--{{ width }}{% endif %}'
  style='--direction_mobile: {{ direction_mobile }}; --vertical_gap_mobile: {{ vertical_gap_mobile }}; --horizontal_gap_mobile: {{ horizontal_gap_mobile }}; --alignment_mobile: {{ alignment_mobile }}; --justify_content_mobile: {{ justify_content_mobile }}; --direction_desktop: {{ direction_desktop }}; --vertical_gap_desktop: {{ vertical_gap_desktop }}; --horizontal_gap_desktop: {{ horizontal_gap_desktop }}; --alignment_desktop: {{ alignment_desktop }}; --justify_content_desktop: {{ justify_content_desktop }}'
>
  {{ content }}
</div>
