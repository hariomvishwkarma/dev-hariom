{% liquid
  assign img_desktop = section.settings.background_image_desktop | image_url
  assign img_mobile = section.settings.background_image_mobile | image_url
%}

<section class="static-hero-banner">
  <div class="static-hero-banner__background">
    <picture>
      <source media="(min-width: 768px)" srcset="{{ img_desktop }}">
      <img src="{{ img_mobile }}" alt="Banner Background" class="static-hero-banner__image">
    </picture>
  </div>

  <div class="static-hero-banner__content">
    {% if section.settings.heading != blank %}
      <h1 class="static-hero-banner__heading">{{ section.settings.heading }}</h1>
    {% endif %}

    {% if section.settings.description != blank %}
      <p class="static-hero-banner__description">{{ section.settings.description }}</p>
    {% endif %}

    <div class="static-hero-banner__buttons">
      {% if section.settings.button_text != blank and section.settings.button_link != blank %}
        <a href="{{ section.settings.button_link }}" class="button button--primary">
          {{ section.settings.button_text }}
        </a>
      {% endif %}
      
      {% if section.settings.button_2_text != blank and section.settings.button_2_link != blank %}
        <a href="{{ section.settings.button_2_link }}" class="button button--secondary">
          {{ section.settings.button_2_text }}
        </a>
      {% endif %}
    </div>
  </div>
</section>

<style>
.static-hero-banner {
  position: relative;
  width: 100%;
  height: 100vh;
  overflow: hidden;
  display: flex;
  align-items: center;
  justify-content: center;
  text-align: center;
  padding: 2rem;
  background: #fff;
}

.static-hero-banner__background {
  position: absolute;
  inset: 0;
  z-index: -1;
}

.static-hero-banner__background img {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.static-hero-banner__content {
  max-width: 800px;
  color: #000;
}

.static-hero-banner__heading {
  font-size: 3rem;
  font-weight: 700;
  margin-bottom: 1rem;
}

.static-hero-banner__description {
  font-size: 1.2rem;
  margin-bottom: 2rem;
}

.static-hero-banner__buttons {
  display: flex;
  gap: 16px;
  justify-content: center;
  flex-wrap: wrap;
}

.button {
  padding: 12px 24px;
  border-radius: 8px;
  text-decoration: none;
  font-weight: 600;
  transition: all 0.3s ease;
  font-size: 16px;
}

.button--primary {
  background-color: #000;
  color: #fff;
}

.button--primary:hover {
  background-color: #333;
}

.button--secondary {
  background-color: transparent;
  border: 2px solid #000;
  color: #000;
}

.button--secondary:hover {
  background-color: #000;
  color: #fff;
}
</style>

{% schema %}
{
  "name": "Static Hero Banner",
  "class": "section-hero",
  "settings": [
    {
      "type": "image_picker",
      "id": "background_image_desktop",
      "label": "Background Image (Desktop)"
    },
    {
      "type": "image_picker",
      "id": "background_image_mobile",
      "label": "Background Image (Mobile)"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Your Main Heading"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "Add your description text here."
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button 1 Text",
      "default": "Shop Now"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button 1 Link"
    },
    {
      "type": "text",
      "id": "button_2_text",
      "label": "Button 2 Text",
      "default": "Learn More"
    },
    {
      "type": "url",
      "id": "button_2_link",
      "label": "Button 2 Link"
    }
  ],
  "presets": [
    {
      "name": "Static Hero Banner"
    }
  ]
}
{% endschema %}
