{% schema %}
{
  "name": "Klaviyo Landing (einfach)",
  "settings": [
    { "type": "color", "id": "bg", "label": "Hintergrundfarbe", "default": "#ffffff" }
  ],
  "blocks": [
    {
      "type": "heading",
      "name": "Überschrift",
      "settings": [
        { "type": "text", "id": "heading", "label": "Titel", "default": "Newsletter anmelden" },
        { "type": "select", "id": "size", "label": "Größe", "default": "h2",
          "options": [
            { "value": "h1", "label": "H1" },
            { "value": "h2", "label": "H2" },
            { "value": "h3", "label": "H3" }
          ]
        }
      ]
    },
    {
      "type": "richtext",
      "name": "Text",
      "settings": [
        { "type": "richtext", "id": "content", "label": "Inhalt",
          "default": "<p>Erhalte Angebote und News zuerst.</p>" }
      ]
    },
    {
      "type": "image",
      "name": "Bild",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Bild" }
      ]
    },
    {
      "type": "button",
      "name": "Button",
      "settings": [
        { "type": "text", "id": "label", "label": "Beschriftung", "default": "Jetzt entdecken" },
        { "type": "url", "id": "link", "label": "Link" },
        { "type": "checkbox", "id": "new_tab", "label": "In neuem Tab öffnen", "default": false }
      ]
    },
    {
      "type": "custom_liquid",
      "name": "Custom Liquid",
      "settings": [
        { "type": "liquid", "id": "custom_liquid", "label": "Liquid/HTML einfügen",
          "default": "<!-- Klaviyo-Form hier einfügen -->" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Klaviyo Landing (einfach)",
      "blocks": [
        { "type": "heading" },
        { "type": "richtext" },
        { "type": "custom_liquid" }
      ]
    }
  ]
}
{% endschema %}
