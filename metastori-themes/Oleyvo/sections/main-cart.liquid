{{ 'section-main-cart.css' | asset_url | stylesheet_tag }}
{{ 'cart-table.css' | asset_url | stylesheet_tag }}
{{ 'cart-totals.css' | asset_url | stylesheet_tag }}
{{ 'cart-free-shipping.css' | asset_url | stylesheet_tag }}
{{ 'cart-note.css' | asset_url | stylesheet_tag }}
{{ 'cart-discount-list.css' | asset_url | stylesheet_tag }}
{{ 'cart-tax-note.css' | asset_url | stylesheet_tag }}

{% capture continue_shopping %}
  {% render 'cart-continue-shopping' %}
{% endcapture %}

<section {% render 'section-attr' %}>
  <xo-cart id='{{ section.id }}' class='xo-main-cart section-{{ section.id }}-padding color-{{ section.settings.color_scheme }}'>
    <xo-container class='xo-main-cart__container'>
      <xo-animate xo-cascade>
        <xo-grid class='xo-main-cart__grid'>
          <xo-cart-will-change
            class='xo-main-cart__left {% if cart == empty %}xo-main-cart__left--empty{% endif %}'
            xo-unique-id='cart-table-{{ section.id }}'
            style='--md: 12; --lg: {% if cart != empty %} 8 {% else %} 12 {% endif %}'
          >
            {% if cart != empty %}
              {% render 'cart-table' %}
            {% else %}
              {% assign title = 'sections.cart.empty' | t %}
              {% render 'cart-empty', title: title, content: continue_shopping, icon_name: 'empty', icon_size: '11rem' %}
            {% endif %}
            <xo-cart-will-change xo-unique-id='continue-shopping-{{ section.id }}'>
              {% if cart != empty %}
                {% render 'space', spacing_dt: '33', spacing_mb: '20' %}
                <div class='xo-main-cart__button'>
                  {%- assign button_text = 'general.continue_shopping' | t -%}
                  {%- render 'button', text: button_text, link: routes.all_products_collection_url, style: 'link', size: 'lg', icon: 'chevron-right', icon_size: 24 -%}
                </div>
              {% endif %}
            </xo-cart-will-change>
          </xo-cart-will-change>
          <xo-cart-will-change xo-unique-id='cart-shipping-{{ section.id }}' style='--xs: 12; --md: 12; --lg: 4'>
            {% if cart != empty %}
              <div class='xo-main-cart__right {% if settings.enable_border_radius %}xo-main-cart__right--radius{% endif %}'>
                {% for block in section.blocks %}
                  {% case block.type %}
                    {% when '@app' %}
                      {% render block %}
                    {% when 'free_shipping' %}
                      {% render 'cart-free-shipping' %}
                    {% when 'note' %}
                      <xo-cart-will-change xo-unique-id='xo-cart-note-{{ section.id }}' class='xo-cart__right-note'>
                        {% if cart != empty %}
                          {% assign type_note = block.settings.type %}
                          {% render 'cart-note', uid: 'main-cart', type: type_note %}
                        {% endif %}
                      </xo-cart-will-change>
                    {% when 'subtotal' %}
                      <div class='xo-main-cart__wrap-price'>
                        {% render 'cart-totals' %}
                        {% render 'cart-discount-list' %}
                        {% render 'cart-tax-note' %}
                      </div>
                      {% render 'cart-actions' %}
                    {% when 'discount' %}
                      <xo-cart-will-change xo-unique-id='xo-main-cart-discount-{{ section.id }}' class='xo-main-cart__right-discount'>
                        {% if cart != empty %}
                          {% assign type_discount = block.settings.type %}
                          {% render 'cart-discount', uid: 'main-cart', type: type_discount %}
                        {% endif %}
                      </xo-cart-will-change>
                    {% when 'shipping' %}
                      <xo-cart-will-change xo-unique-id='xo-main-cart-shipping-rates-{{ section.id }}' class='xo-main-cart__right-shipping'>
                        {% if cart != empty %}
                          {% assign type_shipping = block.settings.type %}
                          {% render 'cart-shipping-rates', uid: 'main-cart', type: type_shipping %}
                        {% endif %}
                      </xo-cart-will-change>
                  {% endcase %}
                {% endfor %}
              </div>
            {% endif %}
          </xo-cart-will-change>
        </xo-grid>
      </xo-animate>
    </xo-container>
  </xo-cart>
</section>

{% schema %}
{
  "name": "t:sections.main_cart.name",
  "settings": [
    {
      "type": "header",
      "content": "t:sections.all.heading.content"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.color_scheme.label"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "t:sections.all.bg_color.label"
    },
    {
      "type": "color_background",
      "id": "background_gradient",
      "label": "t:sections.all.bg_gradient.label"
    },
    {
      "type": "number",
      "id": "padding_top_desktop",
      "label": "t:sections.all.padding_top_desktop.label",
      "default": 50
    },
    {
      "type": "number",
      "id": "padding_bottom_desktop",
      "label": "t:sections.all.padding_bottom_desktop.label",
      "default": 50
    },
    {
      "type": "number",
      "id": "padding_top_mobile",
      "label": "t:sections.all.padding_top_mobile.label",
      "default": 50
    },
    {
      "type": "number",
      "id": "padding_bottom_mobile",
      "label": "t:sections.all.padding_bottom_mobile.label",
      "default": 50
    }
  ],
  "blocks": [
    {
      "type": "@app"
    },
    {
      "type": "subtotal",
      "name": "t:sections.main_cart.settings.subtotal.label",
      "limit": 1
    },
    {
      "type": "free_shipping",
      "name": "t:sections.main_cart.settings.free_shipping.label",
      "limit": 1
    },
    {
      "type": "note",
      "name": "t:sections.main_cart.settings.note.label",
      "settings": [
        {
          "type": "select",
          "id": "type",
          "label": "t:sections.main_cart.settings.type_of_note.label",
          "options": [
            {
              "value": "regular",
              "label": "t:sections.main_cart.settings.option_regular.label"
            },
            {
              "value": "collapse",
              "label": "t:sections.main_cart.settings.option_collapse.label"
            }
          ],
          "default": "collapse"
        }
      ],
      "limit": 1
    }
  ]
}
{% endschema %}
