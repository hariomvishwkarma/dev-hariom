{% schema %}
{
  "name": "Custom Product Slider",
  "settings": [
    {
      "type": "product",
      "id": "selected_product_1",
      "label": "Select Product 1"
    },
    {
      "type": "text",
      "id": "rider_height",
      "label": "Rider Height",
      "default": "173-200cm"
    },
    {
      "type": "text",
      "id": "starting_price",
      "label": "Starting Price",
      "default": "50"
    },
     {
      "type": "product",
      "id": "selected_product_2",
      "label": "Select Product 2"
    },
    {
      "type": "text",
      "id": "rider_height_2",
      "label": "Rider Height",
      "default": "173-200cm"
    },
    {
      "type": "text",
      "id": "starting_price_2",
      "label": "Starting Price",
      "default": "50"
    },
  ],
  "presets": [
    {
      "name": "Custom Product Slider",
      "category": "Custom"
    }
  ]
}
{% endschema %}

{% assign product_handle_1 = section.settings.selected_product_1 %}
{% assign product_handle_2 = section.settings.selected_product_2 %}
{% if product_handle_1 != blank %}
  {% assign product_obj = all_products[product_handle_1] %}
{% endif %}
{% if product_handle_2 != blank %}
  {% assign product_obj_2 = all_products[product_handle_2] %}
{% endif %}

<div class="custom-product-slider">
  <div class="custom-product-slider-wrapper">
    <!-- Left Column: Product Images Slider -->
    <div class="custom-product-details">
      {% if product_obj %}
        <h2 class="custom-product-title">{{ product_obj.title }}</h2>
      {% endif %}
     <p class="custom-rider-height">Fahrer Grösse: {{ section.settings.rider_height }}</p>
    </div>
    <div class="custom-slider-images">
      {% if product_obj and product_obj.images.size > 0 %}
        {% for image in product_obj.images %}
          <div class="slide">
            <img src="{{ image | img_url: 'large' }}" alt="{{ product_obj.title }}">
          </div>
        {% endfor %}
      {% else %}
        <p>No product images available.</p>
      {% endif %}
    </div>

    <div class="custom-action-buttons">
      {% if product_obj %}
        <a href="{{ product_obj.url }}" class="custom-btn buy-now">Jetzt bestellen</a>
      {% endif %}
      {% if section.settings.starting_price != blank %}
        <p class="custom-btn start-price">ab CHF {{ section.settings.starting_price }} / Monat</p>
      {% endif %}
      {% if product_obj %}
        <a href="{{ product_obj.url }}" class="custom-btn learn-more">Learn More</a>
      {% endif %}
    </div>
  </div>
  <div class="custom-product-slider-wrapper">
    <!-- Left Column: Product Images Slider -->
    <div class="custom-product-details">
      {% if product_obj_2 %}
        <h2 class="custom-product-title">{{ product_obj_2.title }}</h2>
      {% endif %}
    <p class="custom-rider-height">Fahrer Grösse: {{ section.settings.rider_height_2 }}</p>
    </div>
    <div class="custom-slider-images">
      {% if product_obj_2 and product_obj_2.images.size > 0 %}
        {% for image in product_obj_2.images %}
          <div class="slide">
            <!-- <div class="slide-image" style="background-image: url('{{ image | img_url: 'large' }}');"></div> -->

            <img src="{{ image | img_url: 'large' }}" alt="{{ product_obj_2.title }}">
          </div>
        {% endfor %}
      {% else %}
        <p>No product images available.</p>
      {% endif %}
    </div>

    <div class="custom-action-buttons">
      {% if product_obj_2 %}
      <a href="{{ product_obj_2.url }}" class="custom-btn buy-now">Jetzt bestellen</a>
      {% endif %}
      {% if section.settings.starting_price != blank %}
       <p class="custom-btn start-price">ab CHF {{ section.settings.starting_price_2 }} / Monat</p>
      {% endif %}
      {% if product_obj_2 %}
        <a href="{{ product_obj_2.url }}" class="custom-btn learn-more">Learn More</a>
      {% endif %}
    </div>
  </div>
</div>
{% if product_obj %}
  <script>
          jQuery(document).ready(function($){
            $('.custom-slider-images').slick({
              slidesToShow: 1,
              slidesToScroll: 1,
              fade: true,
              autoplay: false,
            dots: false,
    nextArrow: '<button type="button" class="slick-next"><i class="fas fa-chevron-right"></i></button>',
      prevArrow: '<button type="button" class="slick-prev"><i class="fas fa-chevron-left"></i></button>'
            });
          });
  </script>
{% endif %}
<style>
    .custom-product-title {
    font-weight: 500;
    font-size: 28px;
    line-height: 100%;
    letter-spacing: 0%;
  }
  .custom-product-details {
    display: flex;
    flex-direction: column;
  }
  .custom-slider-images {
    max-width: 90%;
    margin: 20px auto;
  }
  .custom-action-buttons {
      display: flex;
      gap: 20px;
      margin-top: 0px;
      align-items: center;
    }
  .custom-product-slider-wrapper {
    background-color: #f7f7f7;
    padding: 30px 40px;
    border-radius: 10px;
    width: 50%;
  }
  .custom-product-slider {
    display: flex;
    gap: 30px;
    padding:50px 5%;
  }
  .slick-dots li button:before {
    font-size: 13px !important;
  }
  .slick-dots li {
    margin: 0 0px !important;
  }
  .slick-next:before,
  .slick-prev:before {
    display: none !important;
  }
  svg.svg-inline--fa {
    color: black;
    font-size: 20px !important;
    font-weight:300;
  }
  a.custom-btn.buy-now {
    background-color: #000;
    border-radius: 30px;
    padding: 15px 20px;
    font-weight: 400;
    font-size: 14px;
    line-height: 100%;
    letter-spacing: 0%;
    transition: .3s all;
    color:#fff;
  }
  a.custom-btn.buy-now:hover {
    background-color: white;
    color: #000;
  }
  .start-price {
    margin-bottom: 0 !important;
    align-items: center;
  }
  a.custom-btn.learn-more {
    text-decoration: underline;
    color:#000;
  }
  .slick-dots li.slick-active button:before {
      transform: scale(1.1);
  }
  .slick-dots button:before {
      transition: .3s all;
  }
  .slide img{
    width:100%;
    height: 340px;
    width: 544px;
    /* object-fit: fill; */
    object-fit: contain;
  }
  @media (min-width: 769px){
    .slick-slide > div {
      margin: auto;
      width: fit-content;
    }
  }
  @media (max-width: 768px) {
    .custom-product-slider-wrapper {
      width: 100%;
      padding:20px;
    }
    .custom-product-slider {
      flex-direction: column;
    }
    .custom-action-buttons {
      justify-content: center;
      align-items: center;
      flex-wrap: wrap;
      gap: 20px;
    }
      .slide img{

    object-fit: contain;
  }
  }
</style>
