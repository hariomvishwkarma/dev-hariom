{{ 'section-mega-menu-1.css' | asset_url | stylesheet_tag }}
{{ 'collection-link.css' | asset_url | stylesheet_tag }}

{% liquid
  assign layout = section.settings.layout
  assign index = section.settings.index_nav
  assign mega_menu_label = section.settings.mega_menu_label
  assign new_badge_label = section.settings.new_badge_label
  assign desktop_limit = section.settings.desktop_product_limit | default: 5
  if desktop_limit > 5
    assign desktop_limit = 5
  endif
  assign mobile_image_limit = section.settings.mobile_image_limit | default: 3
  assign mobile_accordion_threshold = section.settings.mobile_accordion_threshold | default: 3
  assign e_bikes_product_count = 0
  for block in section.blocks
    if block.type == 'e-bike-product' and block.settings.product != blank
      assign e_bikes_product_count = e_bikes_product_count | plus: 1
    endif
  endfor
  assign desktop_visible_count = e_bikes_product_count
  if desktop_visible_count > desktop_limit
    assign desktop_visible_count = desktop_limit
  endif
%}

{% if layout == 'category' %}
  {% capture style %}
    xo-gap='30'
    xo-per-view='5'
    xo-breakpoints='
    {
      400: {
        perView: 3,
        perMove: 1,
        gap: 10
      },
      768: {
        perView: 3,
        perMove: 1,
      },
      992: {
        perView: 3,
        perMove: 1,
      },
      1200: {
        perView: 4,
        perMove: 1,
      },
      1400: {
        perView: 4,
        perMove: 1,
      },
    }
  '
  {% endcapture %}
{% elsif layout == 'link-list' %}
  {% capture style %}
    xo-gap='30'
    xo-per-view='5'
    xo-breakpoints='
    {
      400: {
        perView: 2,
        perMove: 1,
        gap: 10
      },
      768: {
        perView: 2,
        perMove: 1,
      },
      992: {
        perView: 3,
        perMove: 1,
      },
      1200: {
        perView: 3,
        perMove: 1,
      },
      1400: {
        perView: 3,
        perMove: 1
      },
    }
  '
  {% endcapture %}
{% else %}
  {% capture style %}
    xo-gap='98'
    xo-per-view='2'
    xo-breakpoints='
    {
      400: {
        perView: 2,
        perMove: 1,
        gap: 10
      },
      768: {
        perView: 2,
        perMove: 1,
      },
      992: {
        perView: 2,
        perMove: 1,
      },
      1200: {
        perView: 2,
        perMove: 1,
      },
      1400: {
        perView: 2,
        perMove: 1
      },
    }
  '
  {% endcapture %}
{% endif %}

<template xo-mega-menu-name='header-mega-menu' xo-mega-menu-index='{{ index }}'>
  <div class='mega-menu-1{% if layout %} mega-menu-1--{{ layout }}{% endif %}'>
    {% if layout == 'e-bikes' %}
      {% liquid
        assign desktop_count = 0
      %}
      <div class='mega-menu-1__desktop xo-scrollbar'>
        <div class='mega-menu-1__container mega-menu-1__container--e-bikes'>
          <div class='mega-menu-1__ebikes mega-menu-1__ebikes--desktop{% if desktop_visible_count <= 3 %} mega-menu-1__ebikes--compact{% else %} mega-menu-1__ebikes--full{% endif %}'>
            {% for block in section.blocks %}
              {% if block.type == 'e-bike-product' and block.settings.product != blank and desktop_count < desktop_limit %}
                {% liquid
                  assign product = block.settings.product
                  assign custom_title = block.settings.custom_title
                  assign card_image = block.settings.image | default: product.featured_image
                  assign custom_badge = block.settings.custom_badge
                  assign show_new_badge = block.settings.show_new_badge
                  assign desktop_count = desktop_count | plus: 1
                %}
                <a class='mega-menu-1__ebike-card' href='{{ product.url }}' {{ block.shopify_attributes }}>
                  {% if show_new_badge %}
                    <span class='mega-menu-1__ebike-new'>{{ new_badge_label }}</span>
                  {% endif %}
                  <div class='mega-menu-1__ebike-media'>
                    {% if card_image != blank %}
                      {{ card_image | image_url: width: 460 | image_tag: loading: 'lazy', class: 'mega-menu-1__ebike-image', alt: product.title }}
                    {% endif %}
                  </div>
                  <div class='product-mega-menu-content'>
                    <div class='mega-menu-1__ebike-title'>{{ custom_title | default: product.title }}</div>
                    <div class="mega-menu-1__ebike-price-badge">
                      <div class='mega-menu-1__ebike-price'>{{ product.price | money }}</div>
                      {% if custom_badge != blank %}
                        <div class='mega-menu-1__ebike-custom-badge'><span class="bg-green-success"></span>{{ custom_badge }}</div>
                      {% endif %}
                    </div>
                  </div>
                </a>
              {% endif %}
            {% endfor %}
          </div>
        </div>
      </div>

      <div class='mega-menu-1__mobile'>
        <div class='mega-menu-1__container mega-menu-1__container--e-bikes'>
          <div class='mega-menu-1__ebikes-mobile'>
            {% if e_bikes_product_count <= mobile_accordion_threshold %}
              <div class='mega-menu-1__ebikes-mobile-grid'>
                {% liquid
                  assign mobile_grid_count = 0
                %}
                {% for block in section.blocks %}
                  {% if block.type == 'e-bike-product' and block.settings.product != blank and mobile_grid_count < desktop_limit %}
                    {% liquid
                      assign product = block.settings.product
                      assign custom_title = block.settings.custom_title
                      assign card_image = block.settings.image | default: product.featured_image
                      assign custom_badge = block.settings.custom_badge
                      assign show_new_badge = block.settings.show_new_badge
                      assign mobile_grid_count = mobile_grid_count | plus: 1
                    %}
                    <a class='mega-menu-1__ebike-card mega-menu-1__ebike-card--mobile-grid' href='{{ product.url }}'>
                      {% if show_new_badge %}
                        <span class='mega-menu-1__ebike-new'>{{ new_badge_label }}</span>
                      {% endif %}
                      <div class='mega-menu-1__ebike-media'>
                        {% if card_image != blank %}
                          {{ card_image | image_url: width: 320 | image_tag: loading: 'lazy', class: 'mega-menu-1__ebike-image', alt: product.title }}
                        {% endif %}
                      </div>
                      <div class='product-mega-menu-content'>
                        <div class='mega-menu-1__ebike-title'>{{ custom_title | default: product.title }}</div>
                        <div class="mega-menu-1__ebike-price-badge">
                          <div class='mega-menu-1__ebike-price'>{{ product.price | money }}</div>
                          {% if custom_badge != blank %}
                            <div class='mega-menu-1__ebike-custom-badge'><span class="bg-green-success"></span>{{ custom_badge }}</div>
                          {% endif %}
                        </div>
                      </div>
                    </a>
                  {% endif %}
                {% endfor %}
              </div>
            {% else %}
              <ul class='mega-menu-1__ebikes-mobile-list list-unstyled'>
                {% liquid
                  assign mobile_inline_count = 0
                %}
                {% for block in section.blocks %}
                  {% if block.type == 'e-bike-product' and block.settings.product != blank and mobile_inline_count < desktop_limit %}
                    {% liquid
                      assign product = block.settings.product
                      assign custom_title = block.settings.custom_title
                      assign custom_badge = block.settings.custom_badge
                      assign show_new_badge = block.settings.show_new_badge
                      assign mobile_inline_count = mobile_inline_count | plus: 1
                    %}
                    <li class='mega-menu-1__ebikes-mobile-item'>
                      <a class='mega-menu-1__ebikes-mobile-link' href='{{ product.url }}'>
                        <span class='mega-menu-1__ebikes-mobile-name'>{{ custom_title | default: product.title }}</span>
                        <span class='mega-menu-1__ebikes-mobile-price'>{{ product.price | money }}</span>
                      </a>
                      <div class='mega-menu-1__ebikes-mobile-badges'>
                        {% if show_new_badge %}
                          <span class='mega-menu-1__ebike-new mega-menu-1__ebike-new--inline'>{{ new_badge_label }}</span>
                        {% endif %}
                        {% if custom_badge != blank %}
                          <span class='mega-menu-1__ebike-custom-badge mega-menu-1__ebike-custom-badge--inline'>{{ custom_badge }}</span>
                        {% endif %}
                      </div>
                    </li>
                  {% endif %}
                {% endfor %}
              </ul>
            {% endif %}
          </div>
        </div>
      </div>
    {% else %}
    <div data-id='{{ section.id }}' {% render 'section-attr' %}>
      <div class='mega-menu-1__desktop xo-scrollbar'>
        <div class='mega-menu-1__container'>
          <xo-grid class='mega-menu-1__grid'>
            <div class='mega-menu-1__item mega-menu-1__item--left' style='--xl: 2; --lg: 3; --md: 6; --xs: 12'>
              {% for block in section.blocks %}
                {% case block.type %}
                  {% when 'text' %}
                    {% liquid
                      assign heading = block.settings.heading
                      assign sub_heading = block.settings.sub_heading
                    %}
                    <div class='mega-menu-1__box'>
                      {% if heading %}
                        <div class='mega-menu-1__heading'>{{ heading }}</div>
                      {% endif %}
                      {% if sub_heading != blank %}
                        <div class='mega-menu-1__sub-heading'>{{ sub_heading }}</div>
                      {% endif %}
                    </div>
                {% endcase %}
              {% endfor %}
              {% if layout == 'both' %}
                <div class='mega-menu-1__wrapper'>
                  {% for block in section.blocks %}
                    {% case block.type %}
                      {% when 'collection-item' %}
                        {% liquid
                          assign collection = block.settings.collection
                          assign color_schema_box = block.settings.color_scheme_box
                        %}
                        {% render 'collection-card-v2',
                          collection: collection,
                          color_schema_card: color_schema_box,
                          layout: 'horizontal',
                          padding_vertical: 7,
                          padding_horizontal: 7,
                          image_size: 'sm'
                        %}
                    {% endcase %}
                  {% endfor %}
                </div>
              {% endif %}
            </div>

            <div class='mega-menu-1__item mega-menu-1__item--center' style='--xl: 7; --lg: 6; --md: 12; --xs: 12'>
              {% if layout != 'both' %}
                <xo-carousel
                  class='mega-menu-1__carousel'
                  {{ style }}
                >
                  <xo-carousel-inner>
                    <xo-carousel-list>
                      {% if layout == 'link-list' %}
                        {% for block in section.blocks %}
                          {% case block.type %}
                            {% when 'link-list' %}
                              {% liquid
                                assign heading = block.settings.heading
                                assign button = block.settings
                                assign collection_list = block.settings.collection_list
                              %}
                              <xo-carousel-slide>
                                {% render 'collection-link', heading: heading, collection_list: collection_list, button: button %}
                              </xo-carousel-slide>
                          {% endcase %}
                        {% endfor %}
                      {% elsif layout == 'category' %}
                        {% for block in section.blocks %}
                          {% case block.type %}
                            {% when 'collection-item' %}
                              <xo-carousel-slide>
                                {% render 'collection-card-v2',
                                  collection: block.settings.collection,
                                  layout: 'vertical',
                                  padding_vertical: 18,
                                  padding_horizontal: 18,
                                  color_schema_card: block.settings.color_scheme_box,
                                  image_size: 'xl'
                                %}
                              </xo-carousel-slide>
                          {% endcase %}
                        {% endfor %}
                      {% endif %}
                    </xo-carousel-list>
                  </xo-carousel-inner>
                  <div class='mega-menu-1__paginate'>
                    {% render 'carousel_pagination', align: 'center', style: 'sticks' %}
                  </div>
                </xo-carousel>
              {% else %}
                <xo-grid class='mega-menu-1__item-grid' style='--lg: 2; --md: 2; --xs: 1'>
                  {% for block in section.blocks %}
                    {% case block.type %}
                      {% when 'link-list' %}
                        {% liquid
                          assign heading = block.settings.heading
                          assign button = block.settings
                          assign collection_list = block.settings.collection_list
                        %}
                        <div class='mega-menu-1__column'>
                          {% render 'collection-link', heading: heading, collection_list: collection_list, button: button %}
                        </div>
                    {% endcase %}
                  {% endfor %}
                </xo-grid>
              {% endif %}
            </div>

            <div class='mega-menu-1__item mega-menu-1__item--right' style='--xl: 3; --lg: 3; --md: 6; --xs: 12'>
              {% for block in section.blocks %}
                {% case block.type %}
                  {% when 'introducing-card' %}
                    {% liquid
                      assign heading = block.settings.heading
                      assign sub_heading = block.settings.sub_heading
                      assign image = block.settings.image
                      assign aspect_ratio = block.settings.aspect_ratio
                      assign color_scheme_box = block.settings.color_scheme_box
                    %}
                    {% render 'introducing-card',
                      title: heading,
                      description: sub_heading,
                      button: block,
                      image: image,
                      aspect_ratio: aspect_ratio,
                      color_scheme_box: color_scheme_box
                    %}
                {% endcase %}
              {% endfor %}
            </div>
          </xo-grid>
        </div>
      </div>
    </div>

    <div class='mega-menu-1__mobile'>
      <div class='mega-menu-1__container'>
        <xo-grid class='mega-menu-1__grid'>
          <div class='mega-menu-1__item mega-menu-1__item--left' style='--lg: 12; --md: 12; --xs: 12'>
            {% for block in section.blocks %}
              {% case block.type %}
                {% when 'text' %}
                  {% liquid
                    assign heading = block.settings.heading
                    assign sub_heading = block.settings.sub_heading
                  %}
                  <div class='mega-menu-1__box'>
                    {% if heading %}
                      <div class='mega-menu-1__heading'>{{ heading }}</div>
                    {% endif %}
                    {% if sub_heading != blank %}
                      <div class='mega-menu-1__sub-heading'>{{ sub_heading }}</div>
                    {% endif %}
                  </div>
              {% endcase %}
            {% endfor %}
            {% if layout == 'both' %}
              <div class='mega-menu-1__wrapper'>
                {% for block in section.blocks %}
                  {% case block.type %}
                    {% when 'collection-item' %}
                      {% liquid
                        assign collection = block.settings.collection
                        assign color_schema_box = block.settings.color_scheme_box
                      %}
                      {% render 'collection-card-v2',
                        collection: collection,
                        color_schema_card: color_schema_box,
                        layout: 'horizontal',
                        padding_vertical: 7,
                        padding_horizontal: 7,
                        image_size: 'sm'
                      %}
                  {% endcase %}
                {% endfor %}
              </div>
            {% endif %}
          </div>

          <div class='mega-menu-1__item mega-menu-1__item--center' style='--lg: 12; --md: 12; --xs: 12'>
            {% if layout == 'category' %}
              <xo-carousel
                class='mega-menu-1__carousel'
                xo-gap='10'
                {{ style }}
              >
                <xo-carousel-inner>
                  <xo-carousel-list>
                    {% for block in section.blocks %}
                      {% case block.type %}
                        {% when 'collection-item' %}
                          <xo-carousel-slide>
                            {% render 'collection-card-v2',
                              collection: block.settings.collection,
                              layout: 'vertical',
                              padding_vertical: 10,
                              padding_horizontal: 10,
                              color_schema_card: block.settings.color_scheme_box,
                              image_size: 'xl'
                            %}
                          </xo-carousel-slide>
                      {% endcase %}
                    {% endfor %}
                  </xo-carousel-list>
                </xo-carousel-inner>
              </xo-carousel>
            {% elsif layout == 'link-list' %}
              {% for block in section.blocks %}
                {% case block.type %}
                  {% when 'link-list' %}
                    {% liquid
                      assign heading = block.settings.heading
                      assign button = block.settings
                      assign collection_list = block.settings.collection_list
                    %}
                    {% render 'collection-link', heading: heading, collection_list: collection_list, button: button %}
                {% endcase %}
              {% endfor %}
            {% else %}
              {% for block in section.blocks %}
                {% case block.type %}
                  {% when 'link-list' %}
                    {% liquid
                      assign heading = block.settings.heading
                      assign button = block.settings
                      assign collection_list = block.settings.collection_list
                    %}
                    {% render 'collection-link', heading: heading, collection_list: collection_list, button: button %}
                {% endcase %}
              {% endfor %}
            {% endif %}
          </div>

          <div class='mega-menu-1__item mega-menu-1__item--right' style='--lg: 12; --md: 12; --xs: 12'>
            {% for block in section.blocks %}
              {% case block.type %}
                {% when 'introducing-card' %}
                  {% liquid
                    assign heading = block.settings.heading
                    assign sub_heading = block.settings.sub_heading
                    assign image = block.settings.image
                    assign aspect_ratio = block.settings.aspect_ratio
                    assign color_scheme_box = block.settings.color_scheme_box
                  %}
                  {% render 'introducing-card',
                    title: heading,
                    description: sub_heading,
                    button: block,
                    image: image,
                    aspect_ratio: aspect_ratio,
                    color_scheme_box: color_scheme_box
                  %}
              {% endcase %}
            {% endfor %}
          </div>
        </xo-grid>
      </div>
    </div>
    {% endif %}
  </div>
</template>

{% schema %}
{
  "name": "t:sections.mega_menu_1.name",
  "enabled_on": {
    "groups": [
      "header"
    ]
  },
  "settings": [
    {
      "type": "paragraph",
      "content": "t:sections.mega_menu_1.settings.paragraph.content"
    },
    {
      "type": "select",
      "id": "layout",
      "label": "t:sections.mega_menu_1.settings.layout.label",
      "options": [
        {
          "value": "category",
          "label": "t:sections.mega_menu_1.settings.layout.option_1.label"
        },
        {
          "value": "link-list",
          "label": "t:sections.mega_menu_1.settings.layout.option_2.label"
        },
        {
          "value": "both",
          "label": "t:sections.mega_menu_1.settings.layout.option_3.label"
        },
        {
          "value": "e-bikes",
          "label": "Product mega menu"
        }
      ],
      "default": "category"
    },
    {
      "type": "select",
      "id": "index_nav",
      "label": "t:sections.mega_menu_1.settings.index_nav.label",
      "options": [
        {
          "value": "0",
          "label": "t:sections.mega_menu_1.settings.index_nav.option_1.label"
        },
        {
          "value": "1",
          "label": "t:sections.mega_menu_1.settings.index_nav.option_2.label"
        },
        {
          "value": "2",
          "label": "t:sections.mega_menu_1.settings.index_nav.option_3.label"
        },
        {
          "value": "3",
          "label": "t:sections.mega_menu_1.settings.index_nav.option_4.label"
        },
        {
          "value": "4",
          "label": "t:sections.mega_menu_1.settings.index_nav.option_5.label"
        },
        {
          "value": "5",
          "label": "t:sections.mega_menu_1.settings.index_nav.option_6.label"
        },
        {
          "value": "6",
          "label": "t:sections.mega_menu_1.settings.index_nav.option_7.label"
        },
        {
          "value": "7",
          "label": "t:sections.mega_menu_1.settings.index_nav.option_8.label"
        },
        {
          "value": "8",
          "label": "t:sections.mega_menu_1.settings.index_nav.option_9.label"
        },
        {
          "value": "9",
          "label": "t:sections.mega_menu_1.settings.index_nav.option_10.label"
        }
      ],
      "default": "0"
    },
    {
      "type": "header",
      "content": "t:sections.all.heading.content"
    },
    {
      "type": "text",
      "id": "mega_menu_label",
      "label": "Accordion/menu label",
      "default": "Products"
    },
    {
      "type": "text",
      "id": "new_badge_label",
      "label": "New badge label",
      "default": "New"
    },
    {
      "type": "range",
      "id": "desktop_product_limit",
      "min": 1,
      "max": 5,
      "step": 1,
      "label": "Desktop max products",
      "default": 5
    },
    {
      "type": "range",
      "id": "mobile_image_limit",
      "min": 1,
      "max": 10,
      "step": 1,
      "label": "Mobile top image max",
      "default": 3
    },
    {
      "type": "range",
      "id": "mobile_accordion_threshold",
      "min": 1,
      "max": 10,
      "step": 1,
      "label": "Mobile accordion threshold",
      "default": 3
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.color_scheme.label"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "t:sections.all.bg_color.label"
    },
    {
      "type": "color_background",
      "id": "background_gradient",
      "label": "t:sections.all.bg_gradient.label"
    },
    {
      "type": "number",
      "id": "padding_top_desktop",
      "label": "t:sections.all.padding_top_desktop.label",
      "default": 50
    },
    {
      "type": "number",
      "id": "padding_bottom_desktop",
      "label": "t:sections.all.padding_bottom_desktop.label",
      "default": 50
    },
    {
      "type": "number",
      "id": "padding_top_mobile",
      "label": "t:sections.all.padding_top_mobile.label",
      "default": 50
    },
    {
      "type": "number",
      "id": "padding_bottom_mobile",
      "label": "t:sections.all.padding_bottom_mobile.label",
      "default": 50
    }
  ],
  "blocks": [
    {
      "name": "t:sections.mega_menu_1.settings.text.name",
      "type": "text",
      "limit": 1,
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "t:sections.mega_menu_1.settings.heading.label",
          "default": "Heading"
        },
        {
          "type": "textarea",
          "id": "sub_heading",
          "label": "t:sections.mega_menu_1.settings.sub_heading.label",
          "default": "Use this text to share information about your brand with your customers. Describe a product, share announcements, or welcome customers to your store."
        }
      ]
    },
    {
      "name": "t:sections.mega_menu_1.settings.link_list.name",
      "type": "link-list",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "t:sections.mega_menu_1.settings.heading.label",
          "default": "Menu item"
        },
        {
          "type": "collection_list",
          "id": "collection_list",
          "label": "t:sections.mega_menu_1.settings.link_collection.label"
        },
        {
          "type": "header",
          "content": "t:sections.mega_menu_1.settings.header_button.content"
        },
        {
          "type": "text",
          "id": "button_text",
          "label": "t:sections.mega_menu_1.settings.button_text.label",
          "default": "Button"
        },
        {
          "type": "url",
          "id": "button_link",
          "label": "t:sections.mega_menu_1.settings.button_link.label",
          "default": "/collections/all"
        }
      ]
    },
    {
      "name": "t:sections.mega_menu_1.settings.collection_name.name",
      "type": "collection-item",
      "settings": [
        {
          "type": "collection",
          "id": "collection",
          "label": "t:sections.mega_menu_1.settings.collection.label"
        },
        {
          "type": "color_scheme",
          "id": "color_scheme_box",
          "label": "t:sections.mega_menu_1.settings.color_scheme_box.label",
          "default": "scheme_1"
        }
      ]
    },
    {
      "name": "t:sections.mega_menu_1.settings.introducing.name",
      "type": "introducing-card",
      "limit": 1,
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "t:sections.mega_menu_1.settings.heading.label",
          "default": "Introducing"
