{% schema %}
{
  "name": "Icon Feature Row",
  "settings": [],
  "blocks": [
    {
      "type": "icon_block",
      "name": "Icon Box",
      "settings": [
        {
          "type": "image_picker",
          "id": "icon_image",
          "label": "Icon Image"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Feature Title"
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "Description",
          "default": "Feature description goes here."
        },
        {
          "type": "text",
          "id": "button_text",
          "label": "Button Text",
          "default": "Learn More"
        },
        {
          "type": "url",
          "id": "button_link",
          "label": "Button Link"
        }
      ]
    }
  ],
  "max_blocks": 3,
  "presets": [
    {
      "name": "Icon Feature Row",
      "blocks": [
        { "type": "icon_block" },
        { "type": "icon_block" },
        { "type": "icon_block" }
      ]
    }
  ]
}
{% endschema %}

<section class="custom-icon-row">
  <div class="icon-row__container">
    {% for block in section.blocks %}
      <div class="icon-row__item">
        {% if block.settings.icon_image != blank %}
          <img src="{{ block.settings.icon_image | image_url: width: 110 }}" alt="Icon" class="icon-row__image" />
        {% endif %}
        <h3 class="icon-row__heading">{{ block.settings.heading }}</h3>
        <p class="icon-row__description">{{ block.settings.description }}</p>
        {% if block.settings.button_text != blank and block.settings.button_link != blank %}
          <a href="{{ block.settings.button_link }}" class="icon-row__button secondary-button">{{ block.settings.button_text }}</a>
        {% endif %}
      </div>
    {% endfor %}
  </div>
</section>

<style>
.custom-icon-row {
  padding: 60px 40px;
  display: flex;
  justify-content: center;
}

.icon-row__container {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 30px;
  max-width: 1200px;
  width: 100%;
}

.icon-row__item {
  text-align: center;
  padding: 20px;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.icon-row__image {
  width: 110px;
  height: auto;
  margin-bottom: 0px;
}

.icon-row__heading {
  font-size: 25px;
  font-weight: var(--font-heading-weight, 600);
  margin-bottom: 6px;
}

.icon-row__description {
  font-size: 16px;
  line-height: 1.6;
  margin-bottom: 15px;
}

.icon-row__button.secondary-button {
  padding: 10px 20px;
  border-radius: 8px;
  background-color: transparent;
  color: #000;
  font-size: 14px;
  font-weight: 500;
  text-decoration: none;
  border: 1px solid #000;
  transition: all 0.2s ease-in-out;
}

.icon-row__button.secondary-button:hover {
  background-color: #827C6C;
  color: #fff;
  border-color: #827C6C;
}

@media (max-width: 768px) {
  .custom-icon-row {
    padding: 40px 20px;
  }
  .icon-row__container {
    grid-template-columns: 1fr;
  }
  .icon-row__item {
    padding: 20px;
    text-align: center;
    align-items: center;
  }
  .icon-row__image {
    width: 80px;
  }
  .icon-row__button.secondary-button {
    width: 50%;
    text-align: center;
  }
}
</style>

