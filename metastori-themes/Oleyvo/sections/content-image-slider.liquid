{% if section.settings.row_direction == 'row' %}
  <style>
    .content-image-slider--{{ section.id }} .content-slider .slick-prev {
      left: unset;
      right: calc(43% - 40px);
      z-index: 2;
    }
    .content-image-slider--{{ section.id }} .content-slider .slick-next {
      right: calc(25% - 40px);
    }
    .content-image-slider--{{ section.id }} .content-slider .slick-dots {
      right: calc(27.5% - 40px);
      width: 15% !important;
      top: 12.7%;
      justify-content: stretch;
      display: flex;
      bottom: unset;
    }
    /* --- by ARK -- */
    /* .content-image-slider--{{ section.id }} .content-image-slider-wrapper--content h3,
    .content-image-slider--{{ section.id }} .content-image-slider-wrapper--content p {
      margin-left: 30px;
    } */
  </style>
{% elsif section.settings.row_direction == 'row-reverse' %}
  <style>
    .content-image-slider--{{ section.id }} .content-slider .slick-prev {
      left: 0;
      z-index: 2;
    }
    .content-image-slider--{{ section.id }} .content-slider .slick-next {
      right: unset;
      left: 18%;
    }
    .content-image-slider--{{ section.id }} .content-slider .slick-dots {
      left: 2.5%;
      width: 15% !important;
      top: 12.7%;
      justify-content: stretch;
      display: flex;
      bottom: unset;
      right: unset;
    }
    @media(max-width:970px){
      .content-image-slider--{{ section.id }} .content-slider .slick-dots {
        top: 5%;
      }
      .content-image-slider--{{ section.id }} .content-slider .slick-prev{
        top: 5.3%;
      }
      .content-image-slider--{{ section.id }} .content-slider .slick-next {
        top: 5.3%;
      }
    }
  </style>
{% endif %}

<style>
  .content-image-slider--{{ section.id }} .content-image-slider-wrapper content-slider {
    padding: 100px 0;
     max-width: 1275px;
    margin: 0 auto;
  }
  .content-image-slider--{{ section.id }} .content-slide {
    display: flex !important;
    justify-content: center;
    align-items: center;
    max-width: 1275px;
    margin: 0 auto;

  }
  .content-image-slider--{{ section.id }} .content-image-slider-wrapper--content {
    width: 50%;
  }
  .content-image-slider--{{ section.id }} .content-slide.row .content-image-slider-wrapper--content {
    padding-left: 11rem;
  }
  .content-image-slider--{{ section.id }} .content-image-slider-wrapper--image {
    width: 50%;
    /* max-width: 600px; */
    aspect-ratio: 1 / 1;
    position: relative;
    overflow: hidden;
  }
  .content-image-slider--{{ section.id }} .content-image-slider-wrapper--image img {
    width: 100%;
  }
  .content-image-slider--{{ section.id }} .content-image-slider-wrapper--image video {
    object-fit: cover;
    width: 100%;
  }
  .content-image-slider--{{ section.id }} .content-image-slider-wrapper--content h3 {
    font-weight: 400;
    font-size: 45px;
    color: #000;
    max-width: 455px;
    line-height: 1;
  }
  .content-image-slider--{{ section.id }} .content-image-slider-wrapper--content p {
    font-weight: 400;
    font-size: 16px;
    color: #797878;
    max-width: 455px;
  }
  .content-image-slider--{{ section.id }} .content-slider .slick-next,
  .content-image-slider--{{ section.id }} .content-slider .slick-prev {
    top: 13%;
  }
  .content-image-slider--{{ section.id }} .content-slider .slick-next:before,
  .content-image-slider--{{ section.id }} .content-slider .slick-prev:before {
    display: none !important;
  }
  .content-image-slider--{{ section.id }} .content-slider .svg-inline--fa {
    font-size: 21px !important;
    color: black !important;
  }
  .content-image-slider--{{ section.id }} .content-slider .slick-dots li button {
    height: 5px;
    padding: 0;
  }
  .content-image-slider--{{ section.id }} .content-slider .slick-dots li {
    width: 100%;
    height: auto;
    background-color: #00000026;
    border-radius: 10px;
  }
  .content-image-slider--{{ section.id }} .content-slider .slick-dots li button:before {
    display: none;
  }
  .content-image-slider--{{ section.id }} .content-slider li.slick-active {
    background-color: #000 !important;
  }
  @media(max-width:970px){
    {% if section.settings.row_direction == 'row-reverse' %}
      .content-image-slider--{{ section.id }} .content-slider .slick-dots {
        top: 5%;
      }
      .content-image-slider--{{ section.id }} .content-slider .slick-prev{
        top: 5.3%;
      }
      .content-image-slider--{{ section.id }} .content-slider .slick-next {
        top: 5.3%;
      }
    {% endif %}
  }
  @media(max-width:768px){
    .content-image-slider--{{ section.id }} .content-slide.row .content-image-slider-wrapper--content {
    padding-left: 20px;
    }
    .content-image-slider--{{ section.id }} .content-image-slider-wrapper--image video {
     height: 400px;
    }
    .content-image-slider--{{ section.id }} {
      padding: 50px 0% 0;
    }
    .content-image-slider--{{ section.id }} .content-image-slider-wrapper--content {
      width: 100%;
    }
    .content-image-slider--{{ section.id }} .content-image-slider-wrapper--image {
      width: 100%;
      max-height: 400px;
      min-height: 400px;
      height: 100%;
    }
    .content-image-slider--{{ section.id }} .content-slide {
      flex-direction:column !important;
    }
    .content-image-slider--{{ section.id }} .content-image-slider-wrapper--content h3 {
      font-size: 30px;
      line-height: 1;
      margin: 30px auto;
    }
    .content-image-slider--{{ section.id }} .content-image-slider-wrapper--content p {
      margin: auto;
    }
    .content-image-slider--{{ section.id }} .content-image-slider-wrapper--content  {
      padding: 35px 20px !important;
    }
    .content-image-slider--{{ section.id }} .content-slider .slick-dots {
      left: 50%;
      width: 35% !important;
      justify-content: stretch;
      display: flex;
      bottom: unset;
      right: unset;
      transform: translateX(-50%);
    }
    .content-image-slider--{{ section.id }} .content-slider .slick-prev {
      left: 28%;
      z-index: 2;
      transform: translateX(-50%);
    }
    .content-image-slider--{{ section.id }} .content-slider .slick-next,
    .content-image-slider--{{ section.id }} .content-slider .slick-prev{
      top: 422px;
    }
    .content-image-slider--{{ section.id }} .content-slider .slick-dots {
      top: 430px;
    }
    .content-image-slider--{{ section.id }} .content-slider .slick-next {
      right: unset;
      left: 73%;
      transform: translateX(-50%);
    }
  }
  @media (max-width: 440px) {
    .content-image-slider--{{ section.id }} .content-slider .slick-next,
    .content-image-slider--{{ section.id }} .content-slider .slick-prev{
      top: 427px;
    }
    .content-image-slider--{{ section.id }} .content-slider .slick-dots {
      top: 434px;
    }
  }
  @media (max-width: 390px) {
    .content-image-slider--{{ section.id }} .content-slider .slick-next,
    .content-image-slider--{{ section.id }} .content-slider .slick-prev{
      top: 418px;
    }
    .content-image-slider--{{ section.id }} .content-slider .slick-dots {
      top: 425px;
    }
  }
</style>

<div class="content-image-slider--{{ section.id }} p-0">
  <div class="content-image-slider-wrapper content-slider">
    {% if section.blocks.size > 0 %}
      {% for block in section.blocks %}
        <div
          class="content-slide {{ section.settings.row_direction }}"
          style="flex-direction: {{ section.settings.row_direction }};"
        >
          <div class="content-image-slider-wrapper--image">
            {% assign url = block.settings.video_url %}

            {% if url != blank %}
              {% if url contains '.mp4' %}
                <!-- Self-hosted MP4 video -->
                <div class="video-wrapper">
                  <video
                    disableremoteplayback
                    controls
                    autoplay
                    muted
                    playsinline
                    style="aspect-ratio: 1 / 1; width: 100%; object-fit: cover; border-radius: 12px;"
                  >
                    <source src="{{ url }}" type="video/mp4">
                    Your browser does not support the video tag.
                  </video>
                </div>
              {% elsif url contains 'vimeo.com' or url contains 'youtube.com' or url contains 'youtu.be' %}
                <!-- Vimeo or YouTube embed -->
                <div
                  class="video-wrapper"
                  style="position: relative; padding-top: 100%; border-radius: 12px; overflow: hidden;"
                >
                  <iframe
                    src="{{ url | replace: 'watch?v=', 'embed/' }}"
                    frameborder="0"
                    allowfullscreen
                    style="position: absolute; top: 0; left: 0; width: 100%; height: 100%;"
                    autoplay
                  >
                  </iframe>
                </div>
              {% endif %}
            {% elsif block.settings.column_image %}
              <!-- Fallback image -->
              <img src="{{ block.settings.column_image | img_url: 'large' }}" alt="Column pic">
            {% endif %}
          </div>

          <div class="content-image-slider-wrapper--content">
            <h3>{{ block.settings.column_heading }}</h3>
            <p>{{ block.settings.column_text }}</p>
          </div>
        </div>
      {% endfor %}
    {% else %}
      <div class="content-slide" style="flex-direction: {{ section.settings.row_direction }};">
        <div class="content-image-slider-wrapper--image">
          {% if section.blocks[0].settings.video_url != blank %}
            <div class="video-wrapper">
              <video disableremoteplayback controls autoplay muted playsinline style="max-height:600px; height:100%">
                <source src="{{ section.blocks[0].settings.video_url }}" type="video/mp4">
                Your browser does not support the video tag.
              </video>
            </div>
          {% elsif section.blocks[0].settings.column_image %}
            <img src="{{ section.blocks[0].settings.column_image | img_url: 'large' }}" alt="Column pic">
          {% endif %}
        </div>
        <div class="content-image-slider-wrapper--content">
          <h3>{{ section.blocks[0].settings.column_heading }}</h3>
          <p>{{ section.blocks[0].settings.column_text }}</p>
        </div>
      </div>
    {% endif %}
  </div>
</div>

{% if section.blocks.size %}
  <script>
    jQuery(document).ready(function ($) {
      $(".content-slider").slick({
        slidesToShow: 1,
        slidesToScroll: 1,
        autoplay: false,
        dots: true,
        fade: true,
        nextArrow:
          '<button type="button" class="slick-next"><i class="fas fa-chevron-right"></i></button>',
        prevArrow:
          '<button type="button" class="slick-prev"><i class="fas fa-chevron-left"></i></button>',
      });
    });
  </script>
{% endif %}
<style>
  @media (min-width: 769px) {
    .content-image-slider--{{ section.id }} .content-image-slider-wrapper--content h3 {
      margin-top: 0px;
    }
  }
</style>

{% schema %}
{
  "name": "Image or Video Columns",
  "max_blocks": 6,
  "settings": [
    {
      "type": "select",
      "id": "row_direction",
      "label": "Row Direction",
      "options": [
        {
          "value": "row",
          "label": "Row"
        },
        {
          "value": "row-reverse",
          "label": "Reverse Row"
        }
      ],
      "default": "row"
    }
  ],
  "blocks": [
    {
      "type": "column",
      "name": "Column",
      "settings": [
        {
          "type": "image_picker",
          "id": "column_image",
          "label": "Image (Optional – leave empty if adding a video)"
        },
        {
          "type": "url",
          "id": "video_url",
          "label": "Video URL (Optional – YouTube or Vimeo embed link)"
        },
        {
          "type": "text",
          "id": "column_heading",
          "label": "Heading",
          "default": "Your Heading Here"
        },
        {
          "type": "textarea",
          "id": "column_text",
          "label": "Description",
          "default": "Your description here."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Image or Video Columns",
      "category": "Custom"
    }
  ]
}
{% endschema %}
