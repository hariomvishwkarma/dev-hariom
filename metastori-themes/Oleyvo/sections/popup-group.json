    "custom_liquid_CadWqw": {
      "type": "custom-liquid",
      "disabled": true,
      "name": "t:sections.custom_liquid.presets.name",
      "settings": {
        "custom_liquid": "{% assign sold_count = 110 %}\n\n<div id=\"sold-counter\" class=\"sold-counter-wrapper\">\n  <div class=\"sold-counter-number\" id=\"animated-count\">0</div>\n  <div class=\"sold-counter-label\">Stück bereits verkauft</div>\n</div>\n\n<style>\n  .sold-counter-wrapper {\n    text-align: center;\n    padding: 40px 20px;\n    font-family: 'Helvetica Neue', sans-serif;\n    background: #fafafa;\n    border-radius: 12px;\n    margin: 30px auto;\n    max-width: 400px;\n    box-shadow: 0 6px 20px rgba(0, 0, 0, 0.08);\n    animation: fadeIn 1s ease-out;\n  }\n\n  .sold-counter-number {\n    font-size: 48px;\n    font-weight: 600;\n    color: #1a1a1a;\n    margin-bottom: 8px;\n    animation: pulse 1.5s ease-in-out;\n  }\n\n  .sold-counter-label {\n    font-size: 16px;\n    color: #555;\n    font-weight: 300;\n  }\n\n  @keyframes fadeIn {\n    from { opacity: 0; transform: translateY(20px); }\n    to { opacity: 1; transform: translateY(0); }\n  }\n\n  @keyframes pulse {\n    0% { transform: scale(0.9); opacity: 0; }\n    100% { transform: scale(1); opacity: 1; }\n  }\n</style>\n\n<script>\n  document.addEventListener('DOMContentLoaded', function () {\n    const target = {{ sold_count }};\n    const duration = 2000; // in ms\n    const frameRate = 30;\n    const totalFrames = Math.round(duration / (1000 / frameRate));\n    const counterEl = document.getElementById('animated-count');\n\n    let frame = 0;\n    const counter = setInterval(() => {\n      frame++;\n      const progress = frame / totalFrames;\n      const currentCount = Math.round(target * easeOutQuad(progress));\n\n      counterEl.textContent = currentCount;\n\n      if (progress >= 1) clearInterval(counter);\n    }, 1000 / frameRate);\n\n    function easeOutQuad(t) {\n      return t * (2 - t);\n    }\n  });\n</script>",
        "color_scheme": "",
        "background_color": "",
        "background_gradient": "",
        "padding_top_desktop": 50,
        "padding_bottom_desktop": 50,
        "padding_top_mobile": 50,
        "padding_bottom_mobile": 50
      }
    },
