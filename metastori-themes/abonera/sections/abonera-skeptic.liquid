{% assign background_rgb = section.settings.background_color | color_to_rgb %}
{% assign text_rgb = section.settings.color_body_text | color_to_rgb %}

<style>
  [data-section-id="{{ section.id }}"] {
    {% if section.settings.margin_top %}
      --section-gap-top: {{ section.settings.margin_top }}px;
    {% endif %}
    {% if section.settings.margin_bottom %}
      --section-gap-bottom: {{ section.settings.margin_bottom }}px;
    {% endif %}
  }

  [id="shopify-section-{{ section.id }}"] {
    {% if background_rgb != 'rgba(0, 0, 0, 0.0)' %}
      --color-background: {{ section.settings.background_color }};
      background-color: var(--color-background);
    {% endif %}
    {% if text_rgb != 'rgba(0, 0, 0, 0.0)' %}
      --color-custom-text: {{ section.settings.color_body_text }};
    {% endif %}
  }
</style>

<section class="abu-skeptic" data-section-id="{{ section.id }}">
  {% if section.settings.heading != blank %}
    <p class="abu-skeptic__heading">{{ section.settings.heading }}</p>
  {% endif %}

  {% if section.settings.intro != blank %}
    <p class="abu-skeptic__intro">{{ section.settings.intro }}</p>
  {% endif %}

  <ul class="abu-skeptic__list" role="list">
    {% if section.settings.line_1 != blank %}
      <li>{{ section.settings.line_1 }}</li>
    {% endif %}
    {% if section.settings.line_2 != blank %}
      <li>{{ section.settings.line_2 }}</li>
    {% endif %}
    {% if section.settings.line_3 != blank %}
      <li>{{ section.settings.line_3 }}</li>
    {% endif %}
    {% if section.settings.line_4 != blank %}
      <li>{{ section.settings.line_4 }}</li>
    {% endif %}
  </ul>

  {% if section.settings.link_label != blank and section.settings.link_url != blank %}
    <a class="abu-skeptic__link" href="{{ section.settings.link_url }}">
      <span>{{ section.settings.link_label }}</span>
      <span class="abu-skeptic__arrow" aria-hidden="true">→</span>
    </a>
  {% endif %}
</section>

{% stylesheet %}
.abu-skeptic {
  max-width: 944px;
  margin-left: auto;
  margin-right: auto;
  padding-top: var(--section-gap-top, 24px);
  padding-bottom: var(--section-gap-bottom, 8px);
  padding-left: calc(var(--gap, 8px) * 2);
  padding-right: calc(var(--gap, 8px) * 2);
  color: #1a1a1a;
}
@media (min-width: 1200px) {
  .abu-skeptic {
    padding-left: calc(calc(var(--gap, 8px) * 2) + calc(var(--gap, 8px) * 2));
    padding-right: calc(calc(var(--gap, 8px) * 2) + calc(var(--gap, 8px) * 2));
  }
}
.abu-skeptic__heading {
  margin: 0 0 8px;
  font-size: 13px;
  font-weight: 700;
  letter-spacing: 0.05em;
  text-transform: uppercase;
  color: #8a8f88;
}
.abu-skeptic__intro {
  margin: 0 0 10px;
  font-size: 16px;
  line-height: 1.5;
  color: #1a1a1a;
}
.abu-skeptic__list {
  margin: 0 0 12px;
  padding: 0;
  list-style: none;
  font-size: 15px;
  line-height: 1.7;
  color: #5a5f58;
}
.abu-skeptic__list li::before {
  content: "✓ ";
}
.abu-skeptic__link {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
  padding: 12px 0;
  border-top: 1px solid #e2e4df;
  border-bottom: 1px solid #e2e4df;
  color: #1a1a1a;
  font-size: 15px;
  font-weight: 600;
  line-height: 1.35;
  text-decoration: none;
}
.abu-skeptic__arrow {
  flex: 0 0 auto;
  color: #8a8f88;
  font-size: 18px;
  font-weight: 400;
}
{% endstylesheet %}

{% schema %}
{
  "name": "Skeptic block",
  "tag": "section",
  "class": "abu-skeptic-section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Litt skeptisk til abonnement?"
    },
    {
      "type": "text",
      "id": "intro",
      "label": "Intro",
      "default": "Det skjønner vi godt – derfor har vi gjort det helt ufarlig:"
    },
    {
      "type": "text",
      "id": "line_1",
      "label": "Line 1",
      "default": "Ingen binding – avslutt når du vil"
    },
    {
      "type": "text",
      "id": "line_2",
      "label": "Line 2",
      "default": "Varsel i god tid før ny ordre sendes"
    },
    {
      "type": "text",
      "id": "line_3",
      "label": "Line 3",
      "default": "Bytt sokketype, hopp over leveringer eller endre frekvens"
    },
    {
      "type": "text",
      "id": "line_4",
      "label": "Line 4",
      "default": "Ekstra par til halv pris når du trenger det"
    },
    {
      "type": "text",
      "id": "link_label",
      "label": "Link label",
      "default": "Ønsker du heller å kjøpe bare én gang? Sjekk ut sokkepakkene våre"
    },
    {
      "type": "url",
      "id": "link_url",
      "label": "Link"
    },
    {
      "type": "color",
      "id": "color_body_text",
      "default": "transparent",
      "label": "Text color"
    },
    {
      "type": "color",
      "id": "background_color",
      "default": "transparent",
      "label": "Background"
    },
    {
      "type": "range",
      "id": "margin_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "default": 24,
      "unit": "px",
      "label": "Margin top"
    },
    {
      "type": "range",
      "id": "margin_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "default": 8,
      "unit": "px",
      "label": "Margin bottom"
    }
  ],
  "presets": [
    {
      "name": "Skeptic block"
    }
  ]
}
{% endschema %}
