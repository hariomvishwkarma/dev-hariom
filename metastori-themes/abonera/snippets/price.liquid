{%- liquid
  comment
    Collection / card pricing: use the lowest-priced available variant for BOTH
    sale price and compare-at, so "Fra 299" is never paired with another pack's
    compare-at (fake -50%). PDP passes use_variant: true.
  endcomment
  if use_variant
    assign target = product.selected_or_first_available_variant
  else
    assign target = nil
    for variant in product.variants
      if variant.available
        if target == nil or variant.price < target.price
          assign target = variant
        endif
      endif
    endfor
    if target == nil
      assign target = product.variants | sort: 'price' | first
    endif
    if target == nil
      assign target = product.selected_or_first_available_variant
    endif
  endif

  assign compare_at_price = target.compare_at_price | default: 0
  assign price = target.price | default: 0
  assign price_min = product.price_min
  assign price_max = product.price_max
  assign available = target.available | default: false
  assign show_from_price = false
  if use_variant != true and product.price_varies
    assign show_from_price = true
  endif

  if settings.currency_code_enabled
    assign money_price = price | money_with_currency
    assign money_price_min = price_min | money_with_currency
    assign money_price_max = price_max | money_with_currency
    assign money_price_plain = price | money_with_currency
  else
    assign money_price = price | money
    assign money_price_min = price_min | money
    assign money_price_max = price_max | money
    assign money_price_plain = price | money_without_trailing_zeros | remove: ','
  endif

  if show_from_price
    assign money_price = 'products.product.price.from_price_html' | t: price: money_price
  endif
-%}

<div class="price{%- if price_class %} {{ price_class }}{% endif -%}{%- if available == false %} price--sold-out{% endif -%}{%- if compare_at_price > price and product.quantity_price_breaks_configured? != true %} price--on-sale{% endif -%}{%- if compare_at_price > price and product.quantity_price_breaks_configured? %} volume-pricing--sale-badge{% endif -%}{%- if product.price_varies == false and product.compare_at_price_varies %} price--no-compare{% endif -%}{%- if show_badges %} price--show-badge{% endif -%}">
  <div class="price__container">
    {%- comment -%}
      Explanation of description list:
        - div.price__regular: Displayed when there are no variants on sale
        - div.price__sale: Displayed when a variant is a sale
    {%- endcomment -%}

    <div class="price__regular">
      {%- if product.quantity_price_breaks_configured? -%}
        {%- if show_compare_at_price -%}
          {%- unless product.price_varies == false and product.compare_at_price_varies %}
            <span class="visually-hidden visually-hidden--inline">
              {{- 'products.product.price.regular_price' | t -}}
            </span>
            <span>
              <s class="price-item price-item--regular variant-item__old-price">
                {% if settings.currency_code_enabled %}
                  {{ compare_at_price | money_with_currency }}
                {% else %}
                  {{ compare_at_price | money }}
                {% endif %}
              </s>
            </span>
          {%- endunless -%}
        {%- endif -%}
        <span class="visually-hidden visually-hidden--inline">{{ 'products.product.price.regular_price' | t }}</span>
        <span class="price-item price-item--regular">
          {{- 'products.product.volume_pricing.price_range' | t: minimum: money_price_min, maximum: money_price_max -}}
        </span>
      {%- else -%}
        <span class="visually-hidden visually-hidden--inline">{{ 'products.product.price.regular_price' | t }}</span>
        <span class="price-item price-item--regular wt-product__price__final wt-product__price__final">
          {%- if show_from_price -%}
            {{ money_price }}
          {%- else -%}
            {{ money_price_plain }}
          {%- endif -%}
        </span>
      {%- endif -%}
    </div>
    <div class="price__sale {% if compare_at_price > price and main_product != true %}visible{% endif %} {%if compare_at_price > price and main_product %}visible-main-product{%endif%}">
      <div class="price__sale__details-wrapper">
        <span class="price-item price-item--sale price-item--last wt-product__price__final">
          {{ money_price }}
        </span>
        {%- if compare_at_price > price -%}
          {%- assign discount_percent = compare_at_price | minus: price | times: 100 | divided_by: compare_at_price -%}
          {% if discount_percent >= 10 %}
            <span class="price-item--percent">
              -{{ discount_percent }}%
            </span>
          {% endif %}
        {%- endif -%}
      </div>
      {%- unless product.price_varies == false and product.compare_at_price_varies %}
        <span class="visually-hidden visually-hidden--inline">{{ 'products.product.price.sale_price' | t }}</span>
        <div class="price__details">
          <span class="visually-hidden visually-hidden--inline">{{ 'products.product.price.regular_price' | t }}</span>
        </div>
        <span>
          <s class="price-item price-item--regular {% if main_product != true %}price-item--lower{% endif %} wt-product__price__compare {% if compare_at_price <= price %}hidden{% endif %}">
            {% if settings.currency_code_enabled %}
              {{ compare_at_price | money_with_currency }}
            {% else %}
              {{ compare_at_price | money }}
            {% endif %}
          </s>
        </span>
      {%- endunless -%}
    </div>
    <small class="unit-price caption{% if product.selected_or_first_available_variant.unit_price_measurement == nil %} hidden{% endif %}">
      <span class="visually-hidden">{{ 'products.product.price.unit_price' | t }}</span>
      <span class="price-item price-item--last">
        <span>{{- product.selected_or_first_available_variant.unit_price | money -}}</span>
        <span aria-hidden="true">/</span>
        <span class="visually-hidden">&nbsp;{{ 'accessibility.unit_price_separator' | t }}&nbsp;</span>
        <span>
          {%- if product.selected_or_first_available_variant.unit_price_measurement.reference_value != 1 -%}
            {{- product.selected_or_first_available_variant.unit_price_measurement.reference_value -}}
          {%- endif -%}
          {{ product.selected_or_first_available_variant.unit_price_measurement.reference_unit }}
        </span>
      </span>
    </small>
  </div>
  {%- if show_badges -%}
    <span class="badge price__badge-sale color-{{ settings.sale_badge_color_scheme }}">
      {{ 'products.product.on_sale' | t }}
    </span>

    <span class="badge price__badge-sold-out color-{{ settings.sold_out_badge_color_scheme }}">
      {{ 'products.product.sold_out' | t }}
    </span>
  {%- endif -%}
</div>
