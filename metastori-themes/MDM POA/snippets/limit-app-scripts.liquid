{% comment %}
  Drops app scripts Shopify injects on every page when that page does not render the app.
  Leaves Rebuy, Trustpilot, Awin, Littledata, GTM, and the current Glood app embed in place.
{% endcomment %}
{%- liquid
  assign output_html = header_html

  assign keep_instafeed = false
  if template.name == 'index'
    assign keep_instafeed = true
  endif

  assign keep_map = false
  if page.metafields['maps-by-develic'].data != blank
    assign keep_map = true
  endif

  assign keep_forms = false
  case template.suffix
    when 'bespoke', 'events', 'faq3', 'faq4', 'faq5', 'faq6', 'faq7', 'faq8'
      assign keep_forms = true
  endcase

  unless keep_instafeed
    assign marker = 'https:\/\/cdn.nfcube.com'
    if output_html contains marker
      assign bits = output_html | split: marker
      assign head = bits[0] | remove_last: '"' | remove_last: ','
      assign url_tail = bits[1] | split: '"' | first
      assign rest = bits[1] | remove_first: url_tail | remove_first: '"'
      assign head_last = head | slice: -1, 1
      assign rest_first = rest | slice: 0, 1
      if head_last == '[' and rest_first == ','
        assign rest = rest | remove_first: ','
      endif
      assign output_html = head | append: rest
    endif
  endunless

  unless keep_map
    assign marker = 'https:\/\/maps.develic.com'
    if output_html contains marker
      assign bits = output_html | split: marker
      assign head = bits[0] | remove_last: '"' | remove_last: ','
      assign url_tail = bits[1] | split: '"' | first
      assign rest = bits[1] | remove_first: url_tail | remove_first: '"'
      assign head_last = head | slice: -1, 1
      assign rest_first = rest | slice: 0, 1
      if head_last == '[' and rest_first == ','
        assign rest = rest | remove_first: ','
      endif
      assign output_html = head | append: rest
    endif
  endunless

  unless keep_forms
    assign forms_marker = 'shopify-forms-loader.js'
    if output_html contains forms_marker
      assign form_bits = output_html | split: forms_marker
      assign form_head_parts = form_bits[0] | split: '<script'
      assign last_open = form_head_parts | last
      assign form_head = form_bits[0] | remove_last: last_open | remove_last: '<script'
      assign form_tail_parts = form_bits[1] | split: '</script>'
      assign first_tail = form_tail_parts | first
      assign form_rest = form_bits[1] | remove_first: first_tail | remove_first: '</script>'
      assign output_html = form_head | append: form_rest
    endif
  endunless
-%}
{{- output_html -}}
