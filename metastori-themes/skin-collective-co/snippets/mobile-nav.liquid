<!-- snippets/mobile-nav.liquid -->

{%- doc -%}
  Provides the wrapper structure for the mobile navigation drawer.
{%- enddoc -%}

<div class="mobile-nav">
  <div class="mobile-nav--logo">
    {%- comment %} Copied from header {% endcomment -%}
  </div>

  <nav class="mobile-nav--menu" data-item="nav-text">
    {%- comment %} Copied from header {% endcomment -%}
  </nav>

  <ul class="mobile-nav--utilities" data-text-color="body">
    <li class="mobile-nav--cart">
      {%- comment %} Copied from header {% endcomment -%}
    </li>
    <li class="mobile-nav--search">
      {%- comment %} Copied from header {% endcomment -%}
    </li>
    <li class="mobile-nav--account">
      {%- comment %} Copied from header {% endcomment -%}
    </li>
    <li class="mobile-nav--wishlist">
      {%- comment %} Copied from header {% endcomment -%}
    </li>
  </ul>

  <div class="mobile-nav--footer">
    <div class="mobile-nav--social-icons">
      {%- comment %} Copied from announcement {% endcomment -%}
    </div>

    <div class="mobile-nav--localization">
      {%- comment %} Copied from announcement or header {% endcomment -%}
    </div>
  </div>
</div>

{% stylesheet %}
  .mobile-nav {
    display: flex;
    flex-direction: column;
    min-height: 100vh;
    padding: 37px 55px;
    box-sizing: border-box;

    @media (max-width: 767px) {
      min-height: 100dvh;
    }
  }

  .mobile-nav--logo {
    margin-bottom: 36px;

    &:empty {
      display: none;
    }

    .small-logo--root img {
      width: auto;
      max-width: 100%;
      height: var(--drawer-logo-height, 28px);
    }

    .small-logo--root [data-item='section-heading'] {
      font-size: 14px;
      line-height: 1.2;
    }
  }

  .mobile-nav--menu {
    padding: 0;

    @media (min-width: 768px) {
      [data-item='nav-text'] {
        line-height: 1.35;
      }
    }
  }

  .mobile-nav--utilities {
    display: flex;
    flex-direction: column;
    gap: 11px;
    margin-top: 40px;
    padding: 0;
    list-style: none;

    &:has(> :first-child:empty):has(> :nth-child(2):empty):has(> :nth-child(3):empty):has(> :last-child:empty) {
      display: none;
    }

    > *:empty {
      display: none;
    }

    :is(a, button) {
      display: block;
      width: 100%;
      padding: 0;
      text-align: left;
      line-height: 1.35;
      color: var(--color--body);
      background: none;
      border: 0;
      cursor: pointer;
    }

    @media (hover: hover) {
      &:has(+ .mobile-nav--footer) [data-item='nav-text']:hover,
      [data-item='nav-text']:hover {
        font-weight: 700;
      }
    }
  }

  .mobile-nav--social-icons {
    display: contents;

    &:has(.social-media--root:empty),
    &:empty {
      display: none;
    }
  }

  .mobile-nav--footer {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--spacing--block);
    padding: 0;
    margin-top: auto;
    padding-top: 48px;
  }

  .mobile-nav--localization {
    display: flex;
    flex-direction: column;
    width: 100%;

    &:empty {
      display: none;
    }

    .localization--form[data-direction='vertical'] {
      flex-direction: column;
      align-items: flex-start;
      gap: 10px;
    }
  }
{% endstylesheet %}
