<!-- snippets/promotion-bar.liquid -->

{%- doc -%}
  Renders the promotion bar popup.
  @param {block} block - Popup block context.
  @param {string} [text_alignment] - Text alignment token.
{%- enddoc -%}

{%- liquid
  assign animation_speed = block.settings.animation-speed
  assign bg_color = block.settings.background-color
  assign days_range = block.settings.days-range
  assign delay = block.settings.delay
  assign heading = block.settings.heading
  assign heading_type = block.settings.heading-type
  assign mobile_animation_speed = block.settings.mobile-animation-speed
  assign mobile_scroll_text = block.settings.mobile-scroll-text
  assign page_enabled = block.settings.page-enabled
  assign page_url = block.settings.page-url
  assign referrer_enabled = block.settings.referrer-enabled
  assign referrer_url = block.settings.referrer-url
  assign scroll_text = block.settings.scroll-text
  assign show_at_bottom = block.settings.show-at-bottom
  assign translucent = block.settings.translucent
  assign text_color = block.settings.text-color

  assign enabled = false
  unless page_enabled and page_url != request.path
    assign enabled = true
  endunless

  capture css_vars
    echo '--animation-speed:' | append: animation_speed | append: ';'
    echo '--mobile-animation-speed:' | append: mobile_animation_speed | append: ';'
  endcapture
-%}

{%- if enabled and heading != blank -%}
  <popup-block
    class="promotion-bar--root"
    data-block-id="{{ block.id | camelize }}"
    data-background-color="{{ bg_color }}"
    data-delay="{{ delay }}"
    data-x-alignment="{{ text_alignment }}"
    data-translucent="{{ translucent }}"
    data-scroll-text="{{ scroll_text }}"
    data-mobile-scroll-text="{{ mobile_scroll_text }}"
    data-show-again-after="{{ days_range }}"
    data-show-at-bottom="{{ show_at_bottom }}"
    data-text-color="{{ text_color }}"
    data-referrer-enabled="{{ referrer_enabled }}"
    data-referrer-url="{{ referrer_url }}"
    aria-hidden="true"
    {{ block.shopify_attributes }}
  >
    <div class="promotion-bar--wrapper">
      <div
        class="promotion-bar--heading"
        data-item="{{ heading_type }}"
        style="{{ css_vars }}"
      >
        {%- if scroll_text and mobile_scroll_text -%}
          {%- for i in (0..9) -%}
            <span>{{- heading -}}</span>
          {%- endfor -%}
        {% elsif scroll_text %}
          <span data-mq="small">{{- heading -}}</span>
          {%- for i in (0..9) -%}
            <span data-mq="medium-large">{{- heading -}}</span>
          {%- endfor -%}
        {% elsif mobile_scroll_text %}
          <span data-mq="medium-large">{{- heading -}}</span>
          {%- for i in (0..9) -%}
            <span data-mq="small">{{- heading -}}</span>
          {%- endfor -%}
        {% else %}
          <span>{{- heading -}}</span>
        {%- endif -%}
      </div>
    </div>

    <button class="layout--close" aria-label="{{ 'general.a11y.close' | t }}"></button>
  </popup-block>
{%- endif -%}

{% stylesheet %}
  .promotion-bar--root {
    width: fit-content;
    border-radius: var(--spacing--block);
    padding: var(--spacing--item) var(--spacing--block);
    left: var(--spacing--item);
    bottom: var(--spacing--item);
    transform-origin: bottom left;

    .layout--close {
      --cross-size: var(--spacing--item);
    }

    @media (min-width: 768px) {
      left: var(--spacing--block);
      bottom: var(--spacing--block);
      max-width: calc(100% - 2 * var(--spacing--block));

      &[data-scroll-text='true'] {
        max-width: 380px;
      }
    }

    @media (max-width: 767px) {
      width: calc(100% - 2 * var(--spacing--item));

      &[data-scroll-text='true'] {
        padding: var(--spacing--item);
      }
    }
  }

  .promotion-bar--wrapper {
    .promotion-bar--root & {
      white-space: nowrap;
      overflow-x: hidden;
    }

    @media (min-width: 768px) {
      .promotion-bar--root[data-scroll-text='true'] & {
        mask-image: linear-gradient(to right, #000 95%, transparent);
      }
    }

    @media (max-width: 767px) {
      .promotion-bar--root[data-mobile-scroll-text='true'] & {
        mask-image: linear-gradient(to right, #000 95%, transparent);
      }
    }
  }

  .promotion-bar--heading {
    > * {
      animation-play-state: running;
    }

    @media (min-width: 768px) {
      .promotion-bar--root[data-scroll-text='true'] & {
        /* maps 1-10 value in settings to 20-5s for animation speed */
        --scaled-animation-speed: calc(
          ((10 - var(--animation-speed)) * (20 - 5) / (10 - 1) + 5) * 1s
        );
        display: flex;
        gap: var(--spacing--item);
        mask-image: linear-gradient(to left, #000 95%, transparent);
        /* override typography */
        transform: none;
        margin: 0;
        line-height: 1;

        > * {
          animation: scrolling-content-mobile var(--scaled-animation-speed) linear infinite;
        }
      }
    }

    @media (max-width: 767px) {
      .promotion-bar--root[data-mobile-scroll-text='true'] & {
        /* maps 1-10 value in settings to 20-5s for animation speed */
        --mobile-scaled-animation-speed: calc(
          ((10 - var(--mobile-animation-speed)) * (20 - 5) / (10 - 1) + 5) * 1s
        );
        display: flex;
        gap: var(--spacing--item);
        mask-image: linear-gradient(to left, #000 95%, transparent);
        transform: none; /* override typography */

        > * {
          animation: scrolling-content-mobile var(--mobile-scaled-animation-speed) linear infinite;
          transform: translateZ(0); /* Force hardware acceleration */
          backface-visibility: hidden; /* Help with performance */
        }
      }
    }
  }
{% endstylesheet %}
