{% comment %}
  Renders a input field
  Accepts:
  - id {String}: The input id
  - input_type {String}: The input type
  - input_name {String}: The input name
  - input_classes {String}: The input classes
  - input_container_classes {String}: The input container classes
  - input_placeholder {String}: The input placeholder
  - input_translatable_placeholder {String}: The translatable input placeholder
  - input_required {Boolean}: The input required
  - input_value {String}: The input value
  - input_autocomplete {String}: The input autocomplete
  - custom_attributes {String}: The custom attributes
  - label_content {String}: The label content
  - label_classes {String}: The label classes
  - label_translatable_content {String}: The label translatable content
  - helper_text {String}: The helper text
  - error_text {String}: The error text
  - inline_btn {Object}: the inline btn - added at the end of input field

  Usage:
  {% render 'c-input' %}
{% endcomment %}

{% liquid
  if label_translatable_content
    assign label_content = label_translatable_content | t
  endif

  if input_translatable_placeholder
    assign input_placeholder = input_translatable_placeholder | t
  endif

  # only show placeholder if label is not present
  if label_content
    assign input_placeholder = ' '
  endif

  assign input_design = 'block py-2 w-full bg-transparent appearance-none outline-none focus:outline-0 duration-200 peer-placeholder-shown:text-sm peer-placeholder-shown:translate-y-4 peer-placeholder-shown:left-5 peer-placeholder-shown:mx-0 peer-placeholder-shown:p-0 peer-focus:left-0 peer-focus:mx-5 peer-focus:text-sm peer-focus:-translate-y-2 caret-accent bg-grey-200'
  assign label_design = 'leading-none bg-background rounded-[1px] -translate-y-2 duration-200 transform bottom-16 left-0 origin-[0] mt-4'
%}

<div class="w-full z-0 {{ input_container_classes }}">
  <div class="input-wrap relative flex {{ extra_classes }}">
    <input
      type="{{ input_type | default: 'text' }}"
      {% if input_name %}
        name="{{ input_name }}"
      {% endif %}
      {% if id %}
        id="{{ id }}"
      {% endif %}
      class="{{ input_design }} {{ input_classes }}"
      placeholder="{{ input_placeholder | default: ' ' }}"
      {% if input_required %}
        required
      {% endif %}
      {% if input_value %}
        value="{{ input_value }}"
      {% endif %}
      {% if input_autocomplete %}
        autocomplete="{{ input_autocomplete }}"
      {% endif %}
      autocomplete="off"
      {{ custom_attributes | default: '' -}}
    >
    {%- if inline_btn -%}
      {{ inline_btn }}
    {%- endif -%}
    {%- if label_content -%}
      <label for="{{ id }}" class="{{ label_design }} {{ label_classes }}">
        {{- label_content -}}
        {% if input_required %}
          <span class="text-accent">*</span>
        {%- endif -%}
      </label>
    {%- endif -%}
  </div>
  {%- if helper_text -%}
    {% render 'c-text', type: 'text-2-regular', content: helper_text, classes: 'mt-1.5 text-grey-600' %}
  {%- endif -%}
  {%- if error_text -%}
    {% render 'c-text',
      type: 'text-2-medium',
      content: error_text,
      classes: 'mt-1 text-error overflow-hidden transition-all duration-200 px-3 max-h-0 absolute right-0',
      custom_attributes: 'data-error-text'
    %}
  {%- endif -%}
</div>
{%- if helper_text -%}
  {% render 'c-text', type: 'text-2-regular', content: helper_text, classes: 'mt-1.5 text-grey-600' %}
{%- endif -%}
