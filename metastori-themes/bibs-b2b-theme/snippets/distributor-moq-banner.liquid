{% comment %}
  MOQ notice for Distributors. Updated by assets/distributor-moq.js
{% endcomment %}
<p id="distributor-moq-notice" class="distributor-moq-notice hidden" role="alert" aria-live="polite" hidden></p>

<style>
  .distributor-moq-notice {
    margin: 1rem 0 1.25rem;
    padding: 1rem 1.25rem;
    border-radius: 0.35rem;
    font-size: 1.125rem;
    font-weight: 600;
    line-height: 1.45;
    text-align: center;
  }
  .distributor-moq-notice--error {
    background: #fdecea;
    color: #611a15;
    border: 1px solid #e8b4b8;
    font-size: 1.2rem;
  }
  .distributor-moq-notice--info {
    background: #e8f5e9;
    color: #1b5e20;
    border: 1px solid #c8e6c9;
  }
  .distributor-moq-notice.hidden,
  .distributor-moq-notice[hidden] {
    display: none !important;
  }
  .distributor-moq-checkout--blocked {
    opacity: 0.55;
    pointer-events: none;
    cursor: not-allowed;
  }
</style>
