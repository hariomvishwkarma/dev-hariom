{% doc %}
  Renders a single promotional card for the promotional-panel section.

  @param {object} block - Section block with promo_card settings
  @param {object} section - Parent section object

  @example
  {% render 'promotional-panel-card', block: block, section: section %}
{% enddoc %}

{%- liquid
  assign overlay_alpha = block.settings.overlay_opacity | divided_by: 100.0
  assign title_font_size = block.settings.title_font_size | default: 22
  assign description_font_size = block.settings.description_font_size | default: 15
  assign badge_font = block.settings.badge_font_size | default: 14

  if block.settings.overlay_use_background
    assign overlay_bg = block.settings.background | default: 'linear-gradient(to bottom, rgba(0,0,0,0) 0%, rgba(0,0,0,0) 45%, rgba(0,0,0,0.4) 75%, rgba(0,0,0,0.75) 100%)'
    assign overlay_style = 'background: ' | append: overlay_bg | append: '; opacity: ' | append: overlay_alpha | append: ';'
  else
    assign overlay_style = 'background-color: ' | append: block.settings.overlay_color | append: '; opacity: ' | append: overlay_alpha | append: ';'
  endif
-%}

<div
  class="promo-card"
  style="min-height: {{ block.settings.card_min_height }}px; border-radius: {{ block.settings.image_border_radius }}px;"
>
  <div class="promo-card__media" style="border-radius: {{ block.settings.image_border_radius }}px;">
    {%- if block.settings.image != blank -%}
      {{
        block.settings.image
        | image_url: width: 2000
        | image_tag: loading: 'lazy', widths: '375, 550, 750, 1100, 1500, 2000', sizes: '(min-width: 990px) 33vw, 90vw'
      }}
    {%- else -%}
      <div
        class="promo-panel__placeholder"
        style="min-height: {{ block.settings.card_min_height }}px; border-radius: {{ block.settings.image_border_radius }}px;"
      ></div>
    {%- endif -%}
    <div
      class="promo-card__overlay"
      style="{{ overlay_style }}"
      aria-hidden="true"
    ></div>
  </div>

  {%- if block.settings.card_link != blank -%}
    <a
      href="{{ block.settings.card_link }}"
      class="promo-card__cover-link"
      aria-hidden="true"
      tabindex="-1"
    ></a>
  {%- endif -%}

  {%- if block.settings.show_badge and block.settings.badge_text != blank -%}
    <span
      class="promo-card__badge promo-card__badge--{{ block.settings.badge_position }}"
      style="
        width: {{ block.settings.badge_size }}px;
        min-width: {{ block.settings.badge_size }}px;
        max-width: {{ block.settings.badge_size }}px;
        min-height: {{ block.settings.badge_size }}px;
        background-color: {{ block.settings.badge_background }};
        color: {{ block.settings.badge_text_color }};
        font-size: {{ badge_font }}px;
      "
    >
      {{- block.settings.badge_text | escape -}}
    </span>
  {%- endif -%}

  <div class="promo-card__content">
    {%- if block.settings.show_title and block.settings.title != blank -%}
      <h3
        class="promo-card__title"
        style="
          color: {{ block.settings.title_color }};
          font-size: {{ title_font_size }}px;
          font-weight: {{ block.settings.title_font_weight }};
          {% if block.settings.title_uppercase %}
            text-transform: uppercase;
          {% else %}
            text-transform: none;
          {% endif %}
        "
      >
        {{ block.settings.title | escape }}
      </h3>
    {%- endif -%}

    {%- if block.settings.show_description and block.settings.description != blank -%}
      <div
        class="promo-card__description rte"
        style="color: {{ block.settings.description_color }}; font-size: {{ description_font_size }}px;"
      >
        {{ block.settings.description }}
      </div>
    {%- endif -%}

    {%- if block.settings.show_button and block.settings.button_label != blank -%}
      <a
        class="promo-card__cta"
        {% if block.settings.button_link != blank %}
          href="{{ block.settings.button_link }}"
        {% else %}
          href="#"
          role="link"
          aria-disabled="true"
        {% endif %}
        style="
          background-color: {{ block.settings.button_background }};
          color: {{ block.settings.button_text_color }};
          border-radius: {{ block.settings.button_radius }}px;
          padding: 12px;
        "
      >
        {{- block.settings.button_label | escape -}}
      </a>
    {%- endif -%}
  </div>
</div>
