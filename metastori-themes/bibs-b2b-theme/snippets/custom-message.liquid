{% doc %}
  @param {object} product - Product object
{% enddoc %}
{% assign custom_message = product.metafields.custom.custom_message %}
{% assign custom_message_color = product.metafields.custom.custom_message_color %}

{% if custom_message != blank %}
  <p {% if custom_message_color != blank %}style="color: {{ custom_message_color }}"{% endif %}>{{ custom_message.value }}</p>
{% endif %}
