{%- doc -%}
  Renders a icon based on the icon name.

  Accepts:
    @param { string } icon - (required)
    @param { string } [classes] - (optional)
    @param { string } [extra_classes] - (optional)
    @param { string } [color] - (optional)

  Usage:
    {% render 'c-icon' with 'arrow' %}
{%- enddoc -%}

{%- unless classes -%}
  {%- assign classes = 'icon icon-' | append: icon -%}
{%- endunless -%}

{%- case icon -%}
