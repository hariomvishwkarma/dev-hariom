<script src="{{ 'slider.js' | asset_url }}" type="module" fetchpriority="low"></script>
<link rel="stylesheet" href="{{  'slider.css' | asset_url }}">

{% liquid
  assign width = section.settings.slider_width
  assign recs_type = section.settings.recommendation_type
  assign max_products = section.settings.max_products
  assign icon_shape = section.settings.icon_shape
  assign icon_style = section.settings.icon_style

  assign slider_headline = section.settings.headline | default: 'sections.custom-slider.content.headline' | t

  assign classes = ''
  assign slider_width = ''

  if width == 'full'
    assign slider_width = slider_width | append: 'full-width'
  elsif width == 'page'
    assign slider_width = slider_width | append: 'page-width'
  endif
%}
<div class="section-background color-{{ section.settings.color_scheme }}">
  {% render 'c-title', custom_tag: 'p', content: slider_headline, classes: 'text-4xl font-semibold' %}
</div>

<custom-slider-component
  class="{{ classes }} section-background swiper-container color-{{ section.settings.color_scheme }}"
  id="{{ section.id }}"
  data-width="{{ slider_width }}"
  data-product-id="{{ product.id }}"
  data-intent="{{ recs_type }}"
  data-limit="{{ max_products }}"
>
  <div class="prev">
    {%- render 'slider-arrow', action: 'previous', icon_style: icon_style, icon_shape: icon_shape -%}
  </div>
  <div
    class="product-list swiper section-background color-{{ section.settings.color_scheme }}"
    id="product-recommendations"
  >
    <!-- JS will hydrate this element -->
  </div>
  <div class="next">
    {%- render 'slider-arrow', action: 'next', icon_style: icon_style, icon_shape: icon_shape -%}
  </div>
</custom-slider-component>
