{%- comment -%}
  Renders metaobject icon next to a filter heading/summary.
  Accepts: filter {Object}
{%- endcomment -%}
{%- for element in shop.metaobjects.quick_filter_icon.values -%}
  {%- assign replace_filter_param = filter.param_name | replace: ' ', '_' -%}
  {%- if replace_filter_param contains element.filter_param_name -%}
    {{
      element.icon
      | image_url: width: 32
      | image_tag: class: 'facet-summary-icon', alt: '', loading: 'lazy', widths: '16, 32'
    }}
  {%- endif -%}
{%- endfor -%}