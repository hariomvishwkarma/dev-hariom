{% comment %}
  B2B company cart sync — logged-in B2B customers only.
  Primary data: GET /apps/company-cart/sync (App Proxy).
  Liquid JSON below is fallback only.
{% endcomment %}
{% if customer and customer.tags.size > 0 %}
  <script>
    window.__companyCartCustomerId = {{ customer.id | json }};
  </script>
  {% if customer.current_company %}
    {% assign company_cart_metafield = customer.current_company.metafields.custom.company_cart.value %}
    <script id="company-cart-data" type="application/json">
      {%- if company_cart_metafield != blank -%}
        {{ company_cart_metafield | json }}
      {%- else -%}
        {"lines":[]}
      {%- endif -%}
    </script>
  {% endif %}
  <script src="{{ 'company-cart-sync.js' | asset_url }}" defer="defer"></script>
{% endif %}
