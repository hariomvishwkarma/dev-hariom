{% liquid
  assign free_delivery_limit = customer.current_company.metafields.custom.free_shipping_test | abs
  # This is to set a default value for free shipment
  if free_delivery_limit == 0 and localization.country.currency.iso_code == 'DKK'
    assign free_delivery_limit = 3750
  elsif free_delivery_limit == 0 and localization.country.currency.iso_code == 'EUR'
    assign free_delivery_limit = 500
  elsif free_delivery_limit == 0 and localization.country.currency.iso_code == 'GBP'
    assign free_delivery_limit = 249
  elsif free_delivery_limit == 0 and localization.country.currency.iso_code == 'USD'
    assign free_delivery_limit = 750
  endif
  assign diff_to_free_delivery = cart.total_price | divided_by: 100.0 | times: 1.0 | minus: free_delivery_limit
  assign diff_to_free_delivery_abs = diff_to_free_delivery | abs
  assign diff_percentage = cart.total_price | divided_by: 100.0 | divided_by: free_delivery_limit | times: 100.0 | round
  assign diff_to_free_delivery_abs = diff_to_free_delivery_abs | times: 100 | money
  assign free_delivery_limit_empty_cart = free_delivery_limit | divided_by: 100.0 | times: 10000 | money
%}

<free-delivery-bar
  id="{{ section.id }}"
  data-section="{{ section.id }}"
  data-url="/cart"
  data-free-delivery-cart-bar
  data-cart-delivery-limit="{{ free_delivery_limit }}"
  {{ attributes }}
  class="
    free-delivery-cart-bar flex flex-col justify-start {{ classes }}
    {% if diff_to_free_delivery >= 0 %} success_delivery{% endif %}
    {% if cart.total_price == 0 %} empty{% endif %}
  "
>
  <div class="free-delivery-cart-bar__progress w-full relative mt-4 rounded-full overflow-hidden">
    <div class="free-delivery-cart-bar__progress-bar">&nbsp;</div>
    <div
      class="free-delivery-cart-bar__progress-status bg-button"
      style="--width: {{- diff_percentage | round | at_most: 100 -}}%;"
      data-progress
    >
      &nbsp;
    </div>
  </div>
  <div class="free-delivery-cart-bar__inner w-full block text-left pt-2.5 paragraph-3" ref="textContainer">
    <p class="free-delivery-cart-bar__text success_delivery">
      {{ 'sections.cart.free_delivery_bar.text_delivery_success' | t: limit: diff_to_free_delivery_abs }}
    </p>

    <p class="free-delivery-cart-bar__text empty">
      {{ 'sections.cart.free_delivery_bar.text_delivery_cart_empty_html' | t: limit: free_delivery_limit_empty_cart }}
      <span class="hidden" data-free-limit></span>
    </p>

    <p class="free-delivery-cart-bar__text">
      {{ 'sections.cart.free_delivery_bar.text_delivery_html' | t: limit: diff_to_free_delivery_abs }}
      <span class="hidden" data-free-remaining></span>
    </p>
  </div>
</free-delivery-bar>
