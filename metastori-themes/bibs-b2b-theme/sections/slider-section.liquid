<script src="{{ 'slider.js' | asset_url }}" type="module" fetchpriority="low"></script>
<link rel="stylesheet" href="{{  'slider.css' | asset_url }}">

{% liquid
  assign width = section.settings.slider_width
  assign recs_type = section.settings.recommendation_type
  assign max_products = section.settings.max_products
  assign icon_shape = section.settings.icon_shape
  assign icon_style = section.settings.icon_style

  assign slider_headline = section.settings.headline

  assign classes = ''
  assign slider_width = ''

  if width == 'full'
    assign slider_width = slider_width | append: 'full-width'
  elsif width == 'page'
    assign slider_width = slider_width | append: 'page-width'
  endif
%}
{% if slider_headline != blank %}
  {% render 'c-title', custom_tag: 'p', translatable_content: slider_headline %}
{% endif %}
<div class="section-background color-{{ section.settings.color_scheme }}"></div>

<custom-slider-component
  class="{{ classes }} section-background swiper-container color-{{ section.settings.color_scheme }} page-width"
  id="{{ section.id }}"
  data-width="{{ slider_width }}"
  data-product-id="{{ product.id }}"
  data-intent="{{ recs_type }}"
  data-limit="{{ max_products }}"
>
  <div class="prev">
    {%- render 'slider-arrow', action: 'previous', icon_style: icon_style, icon_shape: icon_shape -%}
  </div>
  <div
    class="product-list page-width swiper section-background color-{{ section.settings.color_scheme }}"
    id="product-recommendations"
  >
    <!-- JS will hydrate this element -->
  </div>
  <div class="next">
    {%- render 'slider-arrow', action: 'next', icon_style: icon_style, icon_shape: icon_shape -%}
  </div>
</custom-slider-component>

{% schema %}
{
  "name": "Slider",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.custom-slider.settings.color_scheme"
    },
    {
      "type": "header",
      "content": "Headline"
    },
    {
      "type": "text",
      "id": "slider_headline",
      "label": "Slider headline"
    },
    {
      "type": "header",
      "content": "Slider settings"
    },
    {
      "type": "select",
      "id": "slider_width",
      "label": "Width",
      "options": [
        {
          "value": "full",
          "label": "Full"
        },
        {
          "value": "page",
          "label": "Page"
        }
      ],
      "default": "page"
    },
    {
      "label": "Type",
      "type": "select",
      "id": "recommendation_type",
      "options": [
        {
          "value": "complementary",
          "label": "Complementary"
        },
        {
          "value": "related",
          "label": "Related"
        }
      ],
      "default": "related"
    },
    {
      "type": "select",
      "id": "icon_style",
      "label": "t:sections.custom-slider.settings.icon",
      "options": [
        {
          "value": "arrow",
          "label": "t:sections.custom-slider.options.arrows"
        },
        {
          "value": "chevron",
          "label": "t:sections.custom-slider.options.chevrons"
        },
        {
          "value": "arrows_large",
          "label": "t:sections.custom-slider.options.arrows_large"
        },
        {
          "value": "chevron_large",
          "label": "t:sections.custom-slider.options.chevron_large"
        },
        {
          "value": "none",
          "label": "t:sections.custom-slider.options.none"
        }
      ],
      "default": "chevron"
    },
    {
      "type": "select",
      "id": "icon_shape",
      "label": "t:sections.custom-slider.settings.icon_background",
      "options": [
        {
          "value": "none",
          "label": "t:sections.custom-slider.options.none"
        },
        {
          "value": "circle",
          "label": "t:sections.custom-slider.options.circle"
        },
        {
          "value": "square",
          "label": "t:sections.custom-slider.options.square"
        }
      ],
      "default": "circle"
    }
  ],
  "presets": [
    {
      "name": "Slider"
    }
  ]
}
{% endschema %}
