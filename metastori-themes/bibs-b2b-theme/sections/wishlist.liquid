{% comment %}
  Shopify Wishlist

  Usage:
  - Create a new page in the Shopify admin
  - Admin > Online store > Pages > Add page
  - Set the new page's template to: 'page.wishlist'
  - Do NOT remove the `grid-wishlist` attribute

  Notes:
  - The grid will be populated with product cards using Javascript
  - Any content inside of the `[grid-wishlist]` element will be completely replaced by the product cards

  Tip:
  - Place a loading element inside the `[grid-wishlist]` element and it will automatically be removed once the product
  cards have loaded
  - Add any liquid code before/after the grid element
{% endcomment %}

{% liquid
  assign number_of_columns_large = section.settings.number_of_columns_large
  assign number_of_columns_desktop = section.settings.number_of_columns_desktop
  assign number_of_columns_mobile = section.settings.number_of_columns_mobile

  case number_of_columns_desktop
    when 1
      assign number_of_columns_desktop_classes = 'lg:grid-cols-1'
      assign number_of_columns_laptop_classes = 'md:grid-cols-1'
    when 2
      assign number_of_columns_desktop_classes = 'lg:grid-cols-2'
      assign number_of_columns_laptop_classes = 'md:grid-cols-1'
    when 3
      assign number_of_columns_desktop_classes = 'lg:grid-cols-3'
      assign number_of_columns_laptop_classes = 'md:grid-cols-2'
    when 4
      assign number_of_columns_desktop_classes = 'lg:grid-cols-4'
      assign number_of_columns_laptop_classes = 'md:grid-cols-3'
    when 5
      assign number_of_columns_desktop_classes = 'lg:grid-cols-5'
      assign number_of_columns_laptop_classes = 'md:grid-cols-4'
    when 6
      assign number_of_columns_desktop_classes = 'lg:grid-cols-6'
      assign number_of_columns_laptop_classes = 'md:grid-cols-5'
    when 7
      assign number_of_columns_desktop_classes = 'lg:grid-cols-7'
      assign number_of_columns_laptop_classes = 'md:grid-cols-6'
    when 8
      assign number_of_columns_desktop_classes = 'lg:grid-cols-8'
      assign number_of_columns_laptop_classes = 'md:grid-cols-7'
    when 9
      assign number_of_columns_desktop_classes = 'lg:grid-cols-9'
      assign number_of_columns_laptop_classes = 'md:grid-cols-8'
    when 10
      assign number_of_columns_desktop_classes = 'lg:grid-cols-10'
      assign number_of_columns_laptop_classes = 'md:grid-cols-9'
    when 11
      assign number_of_columns_desktop_classes = 'lg:grid-cols-11'
      assign number_of_columns_laptop_classes = 'md:grid-cols-10'
    when 12
      assign number_of_columns_desktop_classes = 'lg:grid-cols-12'
      assign number_of_columns_laptop_classes = 'md:grid-cols-11'
  endcase

  case number_of_columns_large
    when 4
      assign number_of_columns_large_classes = '2xl:grid-cols-4'
    when 5
      assign number_of_columns_large_classes = '2xl:grid-cols-5'
    when 6
      assign number_of_columns_large_classes = '2xl:grid-cols-6'
    when 7
      assign number_of_columns_large_classes = '2xl:grid-cols-7'
    when 8
      assign number_of_columns_large_classes = '2xl:grid-cols-8'
    when 9
      assign number_of_columns_large_classes = '2xl:grid-cols-9'
    when 10
      assign number_of_columns_large_classes = '2xl:grid-cols-10'
    when 11
      assign number_of_columns_large_classes = '2xl:grid-cols-11'
    when 12
      assign number_of_columns_large_classes = '2xl:grid-cols-12'
    when 13
      assign number_of_columns_large_classes = '2xl:grid-cols-13'
    when 14
      assign number_of_columns_large_classes = '2xl:grid-cols-14'
    when 15
      assign number_of_columns_large_classes = '2xl:grid-cols-15'
  endcase

  assign number_of_columns_mobile = number_of_columns_mobile | times: 1

  case number_of_columns_mobile
    when 1
      assign number_of_columns_mobile_classes = 'grid-cols-1'
    when 2
      assign number_of_columns_mobile_classes = 'grid-cols-2'
  endcase
%}

<div class="page-width color-{{ section.settings.color_scheme }}">
  {% comment %} SHARED WISHLIST {% endcomment %}
  <div shared-wishlist class="hidden">
    <div class="pt-6 md:pt-10 pb-3 md:pb-5">
      {% render 'c-title', translatable_content: 'sections.wishlist.shared_wishlist' %}
      <div class="shared-wishlist__empty hidden">
        {% render 'c-text',
          translatable_content: 'sections.wishlist.shared_wishlist_text_empty',
          classes: 'paragraph-2'
        %}
      </div>
    </div>
    <div class="shared-wishlist__grid {{ number_of_columns_mobile_classes }} {{ number_of_columns_laptop_classes }} {{ number_of_columns_desktop_classes }} {{ number_of_columns_large_classes }}">
      <p class="wishlist__loader">{{ 'sections.wishlist.loading' | t }}</p>
    </div>
  </div>

  {% comment %} YOUR WISHLIST {% endcomment %}
  <div class="pt-6 md:pt-10 pb-3 md:pb-5">
    {% render 'c-title', translatable_content: 'sections.wishlist.title' %}

    {%- unless customer -%}
      <div class="wishlist__text hidden">
        {% liquid
          render 'c-link', href: routes.account_login_url, translatable_content: 'sections.wishlist.wishlist_link', type: 'link', classes: 'inline paragraph-1 text-button !font-medium'
          render 'c-text', translatable_content: 'sections.wishlist.or', classes: 'inline paragraph-1 text-grey-600'
          render 'c-link', href: routes.account_register_url, translatable_content: 'sections.wishlist.wishlist_link_2', type: 'link', classes: 'inline paragraph-1 text-button !font-medium'
          render 'c-text', translatable_content: 'sections.wishlist.wishlist_text', classes: 'inline paragraph-1'
        %}
      </div>
    {%- endunless -%}
  </div>

  <div grid-wishlist class="collection-quick-add-bulk">
    <div class="wishlist__empty hidden justify-center flex-col">
      <div class="flex items-center justify-center h-12 w-12 rounded-full">
        {%- render 'c-icon', icon: 'heart', extra_classes: '!block' -%}
      </div>
      {% render 'c-title', translatable_content: 'sections.wishlist.wishlist_text_empty_header', custom_tag: 'h5' %}
      {% render 'c-text',
        translatable_content: 'sections.wishlist.wishlist_text_empty',
        classes: 'inline paragraph-2'
      %}
      {% render 'c-link',
        href: '/collections/all',
        translatable_content: 'sections.wishlist.wishlist_text_empty_button',
        classes: 'button--primary mt-5 rounded-full shadow-none w-fit h-fit'
      %}
    </div>
    <div class="wishlist__grid--wrapper">
      <div class="flex justify-end mb-3">
        {% liquid
          assign trigger_classes = 'leading-none flex gap-1.5 items-center font-medium'
          assign content_classes = 'absolute'
          capture disclosure_label
            render 'c-icon', icon: 'share', classes: 'w-4 h-4'
            echo 'sections.wishlist.share.share' | t
          endcapture
        %}
        {%- capture copy_btn_content -%}
          <div class="copy_link">
            {% render 'c-icon', icon: 'copy', classes: 'w-4 h-4' %}
            {{ 'sections.wishlist.share.copy_link' | t }}
          </div>
          <div class="copy_link_success !hidden">
            {% render 'c-icon', icon: 'checkmark', classes: 'w-4 h-4' %}
            {{ 'sections.wishlist.share.copy_link_success' | t }}
          </div>
        {%- endcapture -%}
        {%- if settings.wishlist_page != blank -%}
          {%- capture disclosure_content -%}
          {%- render 'c-text', translatable_content: 'sections.wishlist.share.share_title', classes: 'h3-medium' -%}
          <share-link class="share_link--wrapper">
            <input type="url" class="share_link" disabled value="{{ request.origin | append: settings.wishlist_page.url }}">
            {% render 'c-button', design: 'primary', classes: 'rounded-full text-base leading-none !px-3.5 !py-2 flex-none', content: copy_btn_content %}
          </share-link>

          <div class="share-social_links flex flex-row gap-2">
            <div class="w-14 h-14 lg:w-[72px] lg:h-[72px] rounded-full border-current border">
              <a
                target="_blank"
                class="h-full w-full flex justify-center items-center"
                data-href="https://www.facebook.com/sharer/sharer.php?spm=a2g0o.detail.share.1.67a6Frd1Frd1zA&u=[LINK]%3Fchannel%3Dfacebook"
              >
                {% render 'c-icon', icon: 'facebook_media' %}
              </a>
            </div>
            <div class="w-14 h-14 lg:w-[72px] lg:h-[72px] rounded-full border-current border">
              <a
                target="_blank"
                class="h-full w-full flex justify-center items-center"
                data-href="https://x.com/intent/post?text=Bibs&url=[LINK]"
              >
                {% render 'c-icon', icon: 'twitter_media' %}
              </a>
            </div>
            <div class="w-14 h-14 lg:w-[72px] lg:h-[72px] rounded-full border-current border">
              <a
                target="_blank"
                class="h-full w-full flex justify-center items-center"
                data-href="http://pinterest.com/pin/create/button/?spm=a2g0o.detail.share.2.305eqnZ4qnZ4Xn&url=[LINK]%3Fchannel%3Dpinterest"
              >
                {% render 'c-icon', icon: 'pinterest_media' %}
              </a>
            </div>
            <div class="w-14 h-14 lg:w-[72px] lg:h-[72px] rounded-full border-current border">
              <a
                target="_blank"
                class="h-full w-full flex justify-center items-center"
                data-href="mailto:?body=[LINK]"
              >
                {% render 'c-icon', icon: 'envelope' %}
              </a>
            </div>
          </div>
        {%- endcapture -%}

          {% render 'c-wishlist-share-disclosure',
            type: 'pills',
            classes: 'wishlist_share_disclosure',
            trigger: disclosure_label,
            trigger_classes: trigger_classes,
            content: disclosure_content,
            content_class: content_classes
          %}
        {%- endif -%}
      </div>

      <div class="wishlist__grid {{ number_of_columns_mobile_classes }} {{ number_of_columns_laptop_classes }} {{ number_of_columns_desktop_classes }} {{ number_of_columns_large_classes }}">
        <p class="wishlist__loader">{{ 'sections.wishlist.loading' | t }}</p>
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Wishlist",
  "tag": "section",
  "class": "section-wishlist",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "background-1"
    },
    {
      "type": "header",
      "content": "t:sections.template-collection.settings.header"
    },
    {
      "type": "range",
      "id": "number_of_columns_large",
      "label": "t:sections.template-collection.settings.number_of_columns_large.label",
      "min": 4,
      "max": 15,
      "step": 1,
      "default": 8
    },
    {
      "type": "range",
      "id": "number_of_columns_desktop",
      "label": "t:sections.template-collection.settings.number_of_columns_desktop.label",
      "min": 1,
      "max": 12,
      "step": 1,
      "default": 4
    },
    {
      "type": "select",
      "id": "number_of_columns_mobile",
      "label": "t:sections.template-collection.settings.number_of_columns_mobile.label",
      "options": [
        {
          "value": "1",
          "label": "1 column"
        },
        {
          "value": "2",
          "label": "2 columns"
        }
      ],
      "default": "1"
    },
    {
      "type": "header",
      "content": "t:sections.all.margin.heading"
    },
    {
      "type": "select",
      "id": "margin_bottom",
      "label": "t:sections.all.margin.margin_bottom.label",
      "options": [
        {
          "label": "t:sections.all.margin.margin_bottom.none",
          "value": "none"
        },
        {
          "label": "t:sections.all.margin.margin_bottom.normal",
          "value": "normal"
        },
        {
          "label": "t:sections.all.margin.margin_bottom.large",
          "value": "large"
        }
      ],
      "default": "none"
    }
  ],
  "enabled_on": {
    "templates": ["page"]
  },
  "locales": {
    "en": {
      "loading": "Loading..."
    },
    "fr": {
      "loading": "Vent venligst..."
    }
  }
}
{% endschema %}
