{%- comment -%}
  ============================================================
  Section: Text Columns (Icon + Heading + Text)
  - Block-based columns (add / remove / reorder in editor)
  - Fully responsive (desktop / tablet / mobile)
  - SEO-friendly: semantic markup, configurable heading tags,
    lazy-loaded images with width/height + alt text
  ============================================================
{%- endcomment -%}

{%- liquid
  assign section_pad_t = section.settings.padding_top
  assign section_pad_b = section.settings.padding_bottom
  assign cols = section.settings.columns_desktop
-%}

<style>
  #FeatureColumns-{{ section.id }} {
    --fc-bg: {{ section.settings.bg_color }};
    --fc-heading: {{ section.settings.heading_color }};
    --fc-title: {{ section.settings.title_color }};
    --fc-text: {{ section.settings.text_color }};
    --fc-icon: {{ section.settings.icon_color }};
    --fc-cols: {{ cols }};
    --fc-gap: {{ section.settings.column_gap }}px;
    --fc-icon-size: {{ section.settings.icon_size }}px;

    background-color: var(--fc-bg);
    padding-top: {{ section_pad_t }}px;
    padding-bottom: {{ section_pad_b }}px;
  }

  #FeatureColumns-{{ section.id }} .fc__wrapper {
    max-width: {{ section.settings.max_width }}px;
    margin: 0 auto;
    padding-left: 20px;
    padding-right: 20px;
  }

  #FeatureColumns-{{ section.id }} .fc__header {
    text-align: {{ section.settings.heading_alignment }};
    margin-bottom: 40px;
  }

  #FeatureColumns-{{ section.id }} .fc__section-heading {
    color: var(--fc-heading);
    font-size: clamp(24px, 4vw, 34px);
    margin: 0 0 10px;
    line-height: 1.2;
  }

  #FeatureColumns-{{ section.id }} .fc__section-subheading {
    color: var(--fc-text);
    font-size: 16px;
    margin: 0 auto;
    max-width: 640px;
    line-height: 1.6;
  }

  #FeatureColumns-{{ section.id }} .fc__grid {
    display: grid;
    grid-template-columns: repeat(var(--fc-cols), minmax(0, 1fr));
    gap: var(--fc-gap);
  }

  #FeatureColumns-{{ section.id }} .fc__item {
    text-align: {{ section.settings.content_alignment }};
    display: flex;
    flex-direction: column;
    align-items: {% if section.settings.content_alignment == 'center' %}center{% elsif section.settings.content_alignment == 'right' %}flex-end{% else %}flex-start{% endif %};
  }

  #FeatureColumns-{{ section.id }} .fc__icon {
    width: var(--fc-icon-size);
    height: var(--fc-icon-size);
    margin-bottom: 16px;
    color: var(--fc-icon);
    display: inline-flex;
    align-items: center;
    justify-content: center;
  }

  #FeatureColumns-{{ section.id }} .fc__icon svg,
  #FeatureColumns-{{ section.id }} .fc__icon img {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  #FeatureColumns-{{ section.id }} .fc__title {
    color: var(--fc-title);
    font-size: clamp(20px, 3vw, 26px);
    font-weight: 400;
    margin: 0 0 12px;
    line-height: 1.3;
  }

  #FeatureColumns-{{ section.id }} .fc__text {
    color: var(--fc-text);
    font-size: 15px;
    line-height: 1.7;
    margin: 0;
    max-width: 360px;
  }

  #FeatureColumns-{{ section.id }} .fc__text strong { font-weight: 700; }
  #FeatureColumns-{{ section.id }} .fc__text p { margin: 0 0 1em; }
  #FeatureColumns-{{ section.id }} .fc__text p:last-child { margin-bottom: 0; }

  /* Tablet */
  @media screen and (max-width: 990px) {
    #FeatureColumns-{{ section.id }} .fc__grid {
      grid-template-columns: repeat({% if cols >= 3 %}2{% else %}{{ cols }}{% endif %}, minmax(0, 1fr));
    }
  }

  /* Mobile */
  @media screen and (max-width: 749px) {
    #FeatureColumns-{{ section.id }} .fc__grid {
      grid-template-columns: 1fr;
      gap: 36px;
    }
    #FeatureColumns-{{ section.id }} .fc__item {
      text-align: center;
      align-items: center;
    }
    #FeatureColumns-{{ section.id }} .fc__text { max-width: 420px; }
    #FeatureColumns-{{ section.id }} .fc__header { margin-bottom: 28px; }
  }
</style>

<section
  id="FeatureColumns-{{ section.id }}"
  class="fc"
  aria-label="{{ section.settings.heading | default: 'Feature columns' | escape }}"
>
  <div class="fc__wrapper">
    {%- if section.settings.heading != blank or section.settings.subheading != blank -%}
      <header class="fc__header">
        {%- if section.settings.heading != blank -%}
          <{{ section.settings.heading_tag }} class="fc__section-heading">
            {{ section.settings.heading | escape }}
          </{{ section.settings.heading_tag }}>
        {%- endif -%}
        {%- if section.settings.subheading != blank -%}
          <p class="fc__section-subheading">{{ section.settings.subheading | escape }}</p>
        {%- endif -%}
      </header>
    {%- endif -%}

    <div class="fc__grid" role="list">
      {%- for block in section.blocks -%}
        <div class="fc__item" role="listitem" {{ block.shopify_attributes }}>
          {%- comment -%} ---------- ICON ---------- {%- endcomment -%}
          {%- if block.settings.icon_image != blank -%}
            <div class="fc__icon">
              <img
                src="{{ block.settings.icon_image | image_url: width: 200 }}"
                alt="{{ block.settings.icon_image.alt | default: block.settings.title | escape }}"
                width="{{ section.settings.icon_size }}"
                height="{{ section.settings.icon_size }}"
                loading="lazy"
              >
            </div>
          {%- else -%}
            <div class="fc__icon" aria-hidden="true">
              {%- comment -%} Default checkmark-in-circle icon {%- endcomment -%}
              <svg viewBox="0 0 48 48" fill="none" xmlns="http://www.w3.org/2000/svg">
                <circle cx="24" cy="24" r="21" stroke="currentColor" stroke-width="2.5"/>
                <path d="M15 24.5L21.5 31L34 18" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </div>
          {%- endif -%}

          {%- comment -%} ---------- TITLE ---------- {%- endcomment -%}
          {%- if block.settings.title != blank -%}
            <{{ block.settings.title_tag }} class="fc__title">
              {{ block.settings.title | escape }}
            </{{ block.settings.title_tag }}>
          {%- endif -%}

          {%- comment -%} ---------- TEXT ---------- {%- endcomment -%}
          {%- if block.settings.text != blank -%}
            <div class="fc__text">{{ block.settings.text }}</div>
          {%- endif -%}
        </div>
      {%- else -%}
        {%- comment -%} Placeholder shown in editor when no blocks added {%- endcomment -%}
        <div class="fc__item">
          <div class="fc__icon" aria-hidden="true">
            <svg viewBox="0 0 48 48" fill="none" xmlns="http://www.w3.org/2000/svg">
              <circle cx="24" cy="24" r="21" stroke="currentColor" stroke-width="2.5"/>
              <path d="M15 24.5L21.5 31L34 18" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </div>
          <p class="fc__title">Add a column</p>
          <div class="fc__text">Use the “Add block” button to add feature columns.</div>
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Text Columns",
  "tag": "section",
  "class": "section-feature-columns",
  "settings": [
    {
      "type": "header",
      "content": "Section heading"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading"
    },
    {
      "type": "select",
      "id": "heading_tag",
      "label": "Heading tag (SEO)",
      "info": "Use H2 for most sections. Use H1 only once per page.",
      "options": [
        { "value": "h1", "label": "H1" },
        { "value": "h2", "label": "H2" },
        { "value": "h3", "label": "H3" },
        { "value": "p",  "label": "Paragraph (no SEO weight)" }
      ],
      "default": "h2"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading"
    },
    {
      "type": "select",
      "id": "heading_alignment",
      "label": "Heading alignment",
      "options": [
        { "value": "left",   "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right",  "label": "Right" }
      ],
      "default": "center"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "label": "Columns per row (desktop)",
      "min": 2,
      "max": 4,
      "step": 1,
      "default": 3
    },
    {
      "type": "select",
      "id": "content_alignment",
      "label": "Column content alignment",
      "options": [
        { "value": "left",   "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right",  "label": "Right" }
      ],
      "default": "center"
    },
    {
      "type": "range",
      "id": "column_gap",
      "label": "Gap between columns",
      "min": 16,
      "max": 80,
      "step": 4,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "max_width",
      "label": "Max content width",
      "min": 800,
      "max": 1600,
      "step": 20,
      "unit": "px",
      "default": 1200
    },
    {
      "type": "range",
      "id": "icon_size",
      "label": "Icon size",
      "min": 32,
      "max": 96,
      "step": 2,
      "unit": "px",
      "default": 52
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Section heading",
      "default": "#4a4a4a"
    },
    {
      "type": "color",
      "id": "title_color",
      "label": "Column title",
      "default": "#4a4a4a"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Body text",
      "default": "#6e6e6e"
    },
    {
      "type": "color",
      "id": "icon_color",
      "label": "Default icon color",
      "default": "#a98e94"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 48
    }
  ],
  "blocks": [
    {
      "type": "column",
      "name": "Column",
      "settings": [
        {
          "type": "image_picker",
          "id": "icon_image",
          "label": "Icon image",
          "info": "Optional. Leave empty to use the default checkmark icon. SVG/PNG recommended."
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Pull test"
        },
        {
          "type": "select",
          "id": "title_tag",
          "label": "Title tag (SEO)",
          "options": [
            { "value": "h2", "label": "H2" },
            { "value": "h3", "label": "H3" },
            { "value": "h4", "label": "H4" },
            { "value": "p",  "label": "Paragraph" }
          ],
          "default": "h3"
        },
        {
          "type": "richtext",
          "id": "text",
          "label": "Text",
          "default": "<p>To check the pacifier, pull the nipple in all directions and inspect it carefully before use and replace the pacifier at the first sign of damage or weakness.</p>"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Text Columns",
      "blocks": [
        {
          "type": "column",
          "settings": {
            "title": "Pull test",
            "text": "<p>To check the pacifier, pull the nipple in all directions and inspect it carefully before use and replace the pacifier at the first sign of damage or weakness.</p>"
          }
        },
        {
          "type": "column",
          "settings": {
            "title": "Replacement",
            "text": "<p>Replace the pacifiers <strong>every 4–6 weeks</strong> for both safety and hygienic reasons. If your child has teeth, please be extra aware of signs of damage or weakness in the material.</p>"
          }
        },
        {
          "type": "column",
          "settings": {
            "title": "Cleaning",
            "text": "<p>Part of good pacifier hygiene is frequent cleaning of the pacifiers. The younger the child, the more important it is to protect it from bacteria and to maintain good pacifier hygiene.</p>"
          }
        }
      ]
    }
  ]
}
{% endschema %}
