@font-face {
  font-family: 'Univers';
  src: 
    url("{{ 'UniversLTStd.woff2' | file_url }}") format("woff2"),
    url("{{ 'UniversLTStd.ttf' | file_url }}") format("truetype");
  font-weight: 500;
  font-style: normal;
  font-display: swap;

@font-face {
  font-family: 'Univers';
  src: 
    url("{{ 'Univers_LT_55_Roman.woff2' | file_url }}") format("woff2"),
    url("{{ 'Univers_LT_55_Roman.ttf' | file_url }}") format("truetype");
  font-weight: 500;
  font-style: normal;
  font-display: swap;
}

@font-face {
  font-family: 'Univers';
  src: 
    url("{{ 'Univers_LT_65_Bold.woff2' | file_url }}") format("woff2"),
    url("{{ 'Univers_LT_65_Bold.ttf' | file_url }}") format("truetype");
  font-weight: normal;
  font-style: normal;
  font-display: swap;
}
body, * {
  font-family: Univers, Arial, sans-serif !important;
}