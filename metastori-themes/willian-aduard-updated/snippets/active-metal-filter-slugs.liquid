{%- comment -%}
  Outputs pipe-wrapped metal slugs for active native Metal filters.
  Example output: |white-gold| or |yellow-gold||sterling-silver|

  Parameters:
  - collection {Collection}
{%- endcomment -%}
{%- liquid
  assign active_metal_slugs = ''

  for filter in collection.filters
    assign filter_label_down = filter.label | downcase
    if filter.param_name contains 'option.metal' or filter_label_down == 'metal'
      for value in filter.active_values
        assign metal_down = value.label | downcase
        assign filter_metal_slug = ''

        if metal_down contains 'platinum'
          assign filter_metal_slug = 'platinum'
        elsif metal_down contains 'rose' and metal_down contains 'gold'
          assign filter_metal_slug = 'rose-gold'
        elsif metal_down contains 'white' and metal_down contains 'gold'
          assign filter_metal_slug = 'white-gold'
        elsif metal_down contains 'sterling' or metal_down contains 'silver'
          assign filter_metal_slug = 'sterling-silver'
        elsif metal_down contains 'yellow' and metal_down contains 'gold'
          assign filter_metal_slug = 'yellow-gold'
        elsif metal_down contains 'gold'
          assign filter_metal_slug = 'yellow-gold'
        endif

        if filter_metal_slug != blank
          assign slug_token = '|' | append: filter_metal_slug | append: '|'
          unless active_metal_slugs contains slug_token
            assign active_metal_slugs = active_metal_slugs | append: slug_token
          endunless
        endif
      endfor
    endif
  endfor
-%}{{- active_metal_slugs -}}
