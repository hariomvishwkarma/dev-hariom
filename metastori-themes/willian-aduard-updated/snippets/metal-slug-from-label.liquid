{%- comment -%}
  Returns a normalized metal slug for a Metal option/filter label.

  Parameters:
  - label {String} - Metal option or filter label (e.g. "18k White Gold")
{%- endcomment -%}
{%- liquid
  assign metal_down = label | downcase
  assign metal_slug = ''

  if metal_down contains 'platinum'
    assign metal_slug = 'platinum'
  elsif metal_down contains 'rose' and metal_down contains 'gold'
    assign metal_slug = 'rose-gold'
  elsif metal_down contains 'white' and metal_down contains 'gold'
    assign metal_slug = 'white-gold'
  elsif metal_down contains 'sterling' or metal_down contains 'silver'
    assign metal_slug = 'sterling-silver'
  elsif metal_down contains 'yellow' and metal_down contains 'gold'
    assign metal_slug = 'yellow-gold'
  elsif metal_down contains 'gold'
    assign metal_slug = 'yellow-gold'
  endif
-%}{{- metal_slug -}}
