{% doc %}
  @prompt
    Create a  section with a heading and text underneath it, where both the heading and text.  Include separate desktop and mobile parameters for text size, left and right padding, and spacing between the heading and body text. All size and spacing settings should be adjustable with range sliders, and the text should be centred by default.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-text-section-{{ ai_gen_id }} {
    display: block;
    width: 100%;
  }

  .ai-text-section-container-{{ ai_gen_id }} {
    text-align: {{ block.settings.text_alignment }};
  }

  .ai-text-section-heading-{{ ai_gen_id }} {
    margin: 0;
    color: {{ block.settings.heading_color }};
  }

  .ai-text-section-text-{{ ai_gen_id }} {
    margin: 0;
    color: {{ block.settings.text_color }};
  }

  @media screen and (min-width: 750px) {
    .ai-text-section-container-{{ ai_gen_id }} {
      padding-left: {{ block.settings.desktop_padding_left }}px;
      padding-right: {{ block.settings.desktop_padding_right }}px;
    }

    .ai-text-section-heading-{{ ai_gen_id }} {
      font-size: {{ block.settings.desktop_heading_size }}px;
      margin-bottom: {{ block.settings.desktop_spacing }}px;
    }

    .ai-text-section-text-{{ ai_gen_id }} {
      font-size: {{ block.settings.desktop_text_size }}px;
    }
  }

  @media screen and (max-width: 749px) {
    .ai-text-section-container-{{ ai_gen_id }} {
      padding-left: {{ block.settings.mobile_padding_left }}px;
      padding-right: {{ block.settings.mobile_padding_right }}px;
    }

    .ai-text-section-heading-{{ ai_gen_id }} {
      font-size: {{ block.settings.mobile_heading_size }}px;
      margin-bottom: {{ block.settings.mobile_spacing }}px;
    }

    .ai-text-section-text-{{ ai_gen_id }} {
      font-size: {{ block.settings.mobile_text_size }}px;
    }
  }
{% endstyle %}

<div class="ai-text-section-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-text-section-container-{{ ai_gen_id }}">
    {% if block.settings.heading != blank %}
      <h2 class="ai-text-section-heading-{{ ai_gen_id }}">
        {{ block.settings.heading }}
      </h2>
    {% endif %}

    {% if block.settings.text != blank %}
      <div class="ai-text-section-text-{{ ai_gen_id }}">
        {{ block.settings.text }}
      </div>
    {% endif %}
  </div>
</div>

{% schema %}
{
  "name": "Heading and text",
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Heading",
      "default": "Heading"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>Add your text content here. You can customize the size and spacing using the settings below.</p>"
    },
    {
      "type": "header",
      "content": "Desktop settings"
    },
    {
      "type": "range",
      "id": "desktop_heading_size",
      "min": 16,
      "max": 80,
      "step": 2,
      "unit": "px",
      "label": "Heading size",
      "default": 32
    },
    {
      "type": "range",
      "id": "desktop_text_size",
      "min": 12,
      "max": 32,
      "step": 1,
      "unit": "px",
      "label": "Text size",
      "default": 16
    },
    {
      "type": "range",
      "id": "desktop_padding_left",
      "min": 0,
      "max": 200,
      "step": 5,
      "unit": "px",
      "label": "Left padding",
      "default": 0
    },
    {
      "type": "range",
      "id": "desktop_padding_right",
      "min": 0,
      "max": 200,
      "step": 5,
      "unit": "px",
      "label": "Right padding",
      "default": 0
    },
    {
      "type": "range",
      "id": "desktop_spacing",
      "min": 0,
      "max": 80,
      "step": 2,
      "unit": "px",
      "label": "Spacing between heading and text",
      "default": 16
    },
    {
      "type": "header",
      "content": "Mobile settings"
    },
    {
      "type": "range",
      "id": "mobile_heading_size",
      "min": 14,
      "max": 60,
      "step": 2,
      "unit": "px",
      "label": "Heading size",
      "default": 24
    },
    {
      "type": "range",
      "id": "mobile_text_size",
      "min": 12,
      "max": 24,
      "step": 1,
      "unit": "px",
      "label": "Text size",
      "default": 14
    },
    {
      "type": "range",
      "id": "mobile_padding_left",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "label": "Left padding",
      "default": 0
    },
    {
      "type": "range",
      "id": "mobile_padding_right",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "label": "Right padding",
      "default": 0
    },
    {
      "type": "range",
      "id": "mobile_spacing",
      "min": 0,
      "max": 60,
      "step": 2,
      "unit": "px",
      "label": "Spacing between heading and text",
      "default": 12
    },
    {
      "type": "header",
      "content": "Style"
    },
    {
      "type": "select",
      "id": "text_alignment",
      "label": "Text alignment",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ],
      "default": "center"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading color",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#000000"
    }
  ],
  "presets": [
    {
      "name": "Heading and text"
    }
  ]
}
{% endschema %}
