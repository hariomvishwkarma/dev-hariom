{% doc %}
  @prompt
    Create a section that has a 3 side by side content block (image upload capability) which stack on mobile. Each side needs the image at the top, then a heading, body text and a button where I can edit the text inside it. Use the default fonts already set by the theme, do not include any font picker or font selection settings. Each block needs separate editor controls for desktop image upload, mobile image upload. I need sliders for tax padding, image padding (for each side) and these need to be editable separately between desktop and mobile. each image should keep the natural aspect ratio of whatever image is uploaded rather than being forced into one fixed ratio.  Add separate slider controls for desktop and mobile for section top and bottom padding, column gap, image padding on all four sides, text padding on all four sides, heading text size and body text size. The heading and body text should be centred, and the button should be 150px by 50px with a 1.5px black border, black text, transparent background by default, and a black background with white text on hover.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-three-column-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    padding-top: {{ block.settings.section_padding_top_desktop }}px;
    padding-bottom: {{ block.settings.section_padding_bottom_desktop }}px;
  }

  .ai-three-column-container-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: {{ block.settings.column_gap_desktop }}px;
    width: 100%;
  }

  .ai-three-column-item-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .ai-three-column-image-wrapper-{{ ai_gen_id }} {
    width: 100%;
    padding: {{ block.settings.image_padding_top_desktop }}px {{ block.settings.image_padding_right_desktop }}px {{ block.settings.image_padding_bottom_desktop }}px {{ block.settings.image_padding_left_desktop }}px;
  }

  .ai-three-column-image-{{ ai_gen_id }} {
    width: 100%;
    height: auto;
    display: block;
  }

  .ai-three-column-image-placeholder-{{ ai_gen_id }} {
    width: 100%;
    background-color: #f4f4f4;
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 200px;
  }

  .ai-three-column-image-placeholder-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
    max-width: 300px;
    max-height: 300px;
  }

  .ai-three-column-text-wrapper-{{ ai_gen_id }} {
    width: 100%;
    padding: {{ block.settings.text_padding_top_desktop }}px {{ block.settings.text_padding_right_desktop }}px {{ block.settings.text_padding_bottom_desktop }}px {{ block.settings.text_padding_left_desktop }}px;
    text-align: center;
  }

  .ai-three-column-heading-{{ ai_gen_id }} {
    margin: 0 0 12px 0;
    font-size: {{ block.settings.heading_size_desktop }}px;
    color: {{ block.settings.heading_color }};
  }

  .ai-three-column-body-{{ ai_gen_id }} {
    margin: 0 0 20px 0;
    font-size: {{ block.settings.body_size_desktop }}px;
    color: {{ block.settings.body_color }};
    line-height: 1.6;
  }

  .ai-three-column-button-{{ ai_gen_id }} {
    display: inline-block;
    width: 150px;
    height: 50px;
    line-height: 48px;
    text-align: center;
    background-color: transparent;
    color: #000000;
    border: 1.5px solid #000000;
    text-decoration: none;
    transition: all 0.3s ease;
    cursor: pointer;
  }

  .ai-three-column-button-{{ ai_gen_id }}:hover {
    background-color: #000000;
    color: #ffffff;
  }

  @media screen and (max-width: 749px) {
    .ai-three-column-{{ ai_gen_id }} {
      padding-top: {{ block.settings.section_padding_top_mobile }}px;
      padding-bottom: {{ block.settings.section_padding_bottom_mobile }}px;
    }

    .ai-three-column-container-{{ ai_gen_id }} {
      grid-template-columns: 1fr;
      gap: {{ block.settings.column_gap_mobile }}px;
    }

    .ai-three-column-image-wrapper-{{ ai_gen_id }} {
      padding: {{ block.settings.image_padding_top_mobile }}px {{ block.settings.image_padding_right_mobile }}px {{ block.settings.image_padding_bottom_mobile }}px {{ block.settings.image_padding_left_mobile }}px;
    }

    .ai-three-column-text-wrapper-{{ ai_gen_id }} {
      padding: {{ block.settings.text_padding_top_mobile }}px {{ block.settings.text_padding_right_mobile }}px {{ block.settings.text_padding_bottom_mobile }}px {{ block.settings.text_padding_left_mobile }}px;
    }

    .ai-three-column-heading-{{ ai_gen_id }} {
      font-size: {{ block.settings.heading_size_mobile }}px;
    }

    .ai-three-column-body-{{ ai_gen_id }} {
      font-size: {{ block.settings.body_size_mobile }}px;
    }
  }
{% endstyle %}

<three-column-block-{{ ai_gen_id }} class="ai-three-column-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-three-column-container-{{ ai_gen_id }}">
    {% for i in (1..3) %}
      {% liquid
        assign desktop_image_key = 'column_' | append: i | append: '_image_desktop'
        assign mobile_image_key = 'column_' | append: i | append: '_image_mobile'
        assign heading_key = 'column_' | append: i | append: '_heading'
        assign body_key = 'column_' | append: i | append: '_body'
        assign button_text_key = 'column_' | append: i | append: '_button_text'
        assign button_link_key = 'column_' | append: i | append: '_button_link'

        assign desktop_image = block.settings[desktop_image_key]
        assign mobile_image = block.settings[mobile_image_key]
        assign heading = block.settings[heading_key]
        assign body = block.settings[body_key]
        assign button_text = block.settings[button_text_key]
        assign button_link = block.settings[button_link_key]
      %}

      <div class="ai-three-column-item-{{ ai_gen_id }}">
        <div class="ai-three-column-image-wrapper-{{ ai_gen_id }}">
          {% if desktop_image or mobile_image %}
            <picture>
              {% if mobile_image %}
                <source media="(max-width: 749px)" srcset="{{ mobile_image | image_url: width: 800 }}">
              {% endif %}
              {% if desktop_image %}
                <img
                  src="{{ desktop_image | image_url: width: 800 }}"
                  alt="{{ desktop_image.alt | escape }}"
                  loading="lazy"
                  width="{{ desktop_image.width }}"
                  height="{{ desktop_image.height }}"
                  class="ai-three-column-image-{{ ai_gen_id }}"
                >
              {% elsif mobile_image %}
                <img
                  src="{{ mobile_image | image_url: width: 800 }}"
                  alt="{{ mobile_image.alt | escape }}"
                  loading="lazy"
                  width="{{ mobile_image.width }}"
                  height="{{ mobile_image.height }}"
                  class="ai-three-column-image-{{ ai_gen_id }}"
                >
              {% endif %}
            </picture>
          {% else %}
            <div class="ai-three-column-image-placeholder-{{ ai_gen_id }}">
              {{ 'image' | placeholder_svg_tag }}
            </div>
          {% endif %}
        </div>

        <div class="ai-three-column-text-wrapper-{{ ai_gen_id }}">
          {% if heading != blank %}
            <h3 class="ai-three-column-heading-{{ ai_gen_id }}">{{ heading }}</h3>
          {% endif %}

          {% if body != blank %}
            <div class="ai-three-column-body-{{ ai_gen_id }}">{{ body }}</div>
          {% endif %}

          {% if button_text != blank %}
            <a href="{{ button_link }}" class="ai-three-column-button-{{ ai_gen_id }}">
              {{ button_text }}
            </a>
          {% endif %}
        </div>
      </div>
    {% endfor %}
  </div>
</three-column-block-{{ ai_gen_id }}>

<script>
  (function() {
    class ThreeColumnBlock{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
      }
    }

    customElements.define('three-column-block-{{ ai_gen_id }}', ThreeColumnBlock{{ ai_gen_id }});
  })();
</script>

