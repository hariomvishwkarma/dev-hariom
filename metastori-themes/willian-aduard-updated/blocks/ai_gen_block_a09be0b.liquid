{% doc %}
  @prompt
    Create a custom Shopify theme section with a heading and body text underneath it, where both the heading and body text are editable in the theme editor. Include separate desktop and mobile settings for heading text size, body text size, left and right horizontal padding, and spacing between the heading and body text. All size and spacing settings should be adjustable with range sliders, and the text should be centred by default.
    
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-text-block-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    text-align: center;
  }

  .ai-text-block-container-{{ ai_gen_id }} {
    padding-left: {{ block.settings.padding_horizontal_mobile }}px;
    padding-right: {{ block.settings.padding_horizontal_mobile }}px;
  }

  .ai-text-block-heading-{{ ai_gen_id }} {
    margin: 0;
    font-size: {{ block.settings.heading_size_mobile }}px;
    color: {{ settings.font_col_heads }};
    font-family: {{ settings.type_heading_font.family }}, {{ settings.type_heading_font.fallback_families }};
    font-weight: {{ settings.type_heading_font.weight }};
    font-style: {{ settings.type_heading_font.style }};
  }

  .ai-text-block-body-{{ ai_gen_id }} {
    margin: 0;
    margin-top: {{ block.settings.spacing_mobile }}px;
    font-size: {{ block.settings.body_size_mobile }}px;
    color: {{ settings.font_col_base }};
    font-family: {{ settings.type_base_font.family }}, {{ settings.type_base_font.fallback_families }};
    font-weight: {{ settings.type_base_font.weight }};
    font-style: {{ settings.type_base_font.style }};
  }

  @media screen and (min-width: 750px) {
    .ai-text-block-container-{{ ai_gen_id }} {
      padding-left: {{ block.settings.padding_horizontal_desktop }}px;
      padding-right: {{ block.settings.padding_horizontal_desktop }}px;
    }

    .ai-text-block-heading-{{ ai_gen_id }} {
      font-size: {{ block.settings.heading_size_desktop }}px;
    }

    .ai-text-block-body-{{ ai_gen_id }} {
      margin-top: {{ block.settings.spacing_desktop }}px;
      font-size: {{ block.settings.body_size_desktop }}px;
    }
  }
{% endstyle %}

<div class="ai-text-block-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-text-block-container-{{ ai_gen_id }}">
    {% if block.settings.heading != blank %}
      <h2 class="ai-text-block-heading-{{ ai_gen_id }}">{{ block.settings.heading }}</h2>
    {% endif %}
    {% if block.settings.body_text != blank %}
      <div class="ai-text-block-body-{{ ai_gen_id }}">{{ block.settings.body_text }}</div>
    {% endif %}
  </div>
</div>

{% schema %}
{
  "name": "Heading and body text",
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Heading",
      "default": "Your heading"
    },
    {
      "type": "richtext",
      "id": "body_text",
      "label": "Body text",
      "default": "<p>Add your body text here. You can customize the size and spacing using the settings below.</p>"
    },
    {
      "type": "header",
      "content": "Desktop settings"
    },
    {
      "type": "range",
      "id": "heading_size_desktop",
      "label": "Heading size",
      "min": 16,
      "max": 80,
      "step": 2,
      "unit": "px",
      "default": 32
    },
    {
      "type": "range",
      "id": "body_size_desktop",
      "label": "Body text size",
      "min": 12,
      "max": 32,
      "step": 1,
      "unit": "px",
      "default": 16
    },
    {
      "type": "range",
      "id": "padding_horizontal_desktop",
      "label": "Horizontal padding",
      "min": 0,
      "max": 200,
      "step": 10,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "spacing_desktop",
      "label": "Spacing between heading and body",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "default": 16
    },
    {
      "type": "header",
      "content": "Mobile settings"
    },
    {
      "type": "range",
      "id": "heading_size_mobile",
      "label": "Heading size",
      "min": 14,
      "max": 48,
      "step": 2,
      "unit": "px",
      "default": 24
    },
    {
      "type": "range",
      "id": "body_size_mobile",
      "label": "Body text size",
      "min": 12,
      "max": 24,
      "step": 1,
      "unit": "px",
      "default": 14
    },
    {
      "type": "range",
      "id": "padding_horizontal_mobile",
      "label": "Horizontal padding",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "default": 20
    },
    {
      "type": "range",
      "id": "spacing_mobile",
      "label": "Spacing between heading and body",
      "min": 0,
      "max": 60,
      "step": 4,
      "unit": "px",
      "default": 12
    }
  ],
  "presets": [
    {
      "name": "Heading and body text"
    }
  ]
}
{% endschema %}
