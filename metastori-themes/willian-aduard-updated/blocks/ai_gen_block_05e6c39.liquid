{% doc %}
  @prompt
    Create a subheading section with a single editable text field, with adjustable text colour, and letter spacing 
    Include separate desktop and mobile controls for top padding, bottom padding, and text size.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-subheading-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    padding-top: {{ block.settings.padding_top_desktop }}px;
    padding-bottom: {{ block.settings.padding_bottom_desktop }}px;
  }

  .ai-subheading-text-{{ ai_gen_id }} {
    color: {{ block.settings.text_color }};
    letter-spacing: {{ block.settings.letter_spacing }}em;
    font-size: {{ block.settings.text_size_desktop }}px;
    margin: 0;
    text-align: center;
  }

  @media screen and (max-width: 749px) {
    .ai-subheading-{{ ai_gen_id }} {
      padding-top: {{ block.settings.padding_top_mobile }}px;
      padding-bottom: {{ block.settings.padding_bottom_mobile }}px;
    }

    .ai-subheading-text-{{ ai_gen_id }} {
      font-size: {{ block.settings.text_size_mobile }}px;
    }
  }
{% endstyle %}

<ai-subheading-{{ ai_gen_id }} class="ai-subheading-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  {% if block.settings.subheading_text != blank %}
    <p class="ai-subheading-text-{{ ai_gen_id }}">{{ block.settings.subheading_text }}</p>
  {% endif %}
</ai-subheading-{{ ai_gen_id }}>

<script>
  (function() {
    class AiSubheading{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }
    }
    customElements.define('ai-subheading-{{ ai_gen_id }}', AiSubheading{{ ai_gen_id }});
  })();
</script>

{% schema %}
{
  "name": "Subheading",
  "settings": [
    {
      "type": "text",
      "id": "subheading_text",
      "label": "Subheading text",
      "default": "Your subheading here"
    },
    {
      "type": "range",
      "id": "desktop_width_percent",
      "label": "Desktop width",
      "min": 50,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 100
    },
    {
      "type": "header",
      "content": "Style"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#000000"
    },
    {
      "type": "range",
      "id": "letter_spacing",
      "label": "Letter spacing",
      "min": 0,
      "max": 0.5,
      "step": 0.1,
      "unit": "em",
      "default": 0
    },
    {
      "type": "header",
      "content": "Desktop"
    },
    {
      "type": "range",
      "id": "text_size_desktop",
      "label": "Text size",
      "min": 12,
      "max": 48,
      "step": 2,
      "unit": "px",
      "default": 18
    },
    {
      "type": "range",
      "id": "padding_top_desktop",
      "label": "Top padding",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "default": 20
    },
    {
      "type": "range",
      "id": "padding_bottom_desktop",
      "label": "Bottom padding",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "default": 20
    },
    {
      "type": "header",
      "content": "Mobile"
    },
    {
      "type": "range",
      "id": "text_size_mobile",
      "label": "Text size",
      "min": 12,
      "max": 36,
      "step": 2,
      "unit": "px",
      "default": 16
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "label": "Top padding",
      "min": 0,
      "max": 80,
      "step": 5,
      "unit": "px",
      "default": 15
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "label": "Bottom padding",
      "min": 0,
      "max": 80,
      "step": 5,
      "unit": "px",
      "default": 15
    }
  ],
  "presets": [
    {
      "name": "Subheading"
    }
  ]
}
{% endschema %}
