{% doc %}
  @prompt
    I want a 4:5 vertical image on the left and a square image on the right, generous padding between them to create space. on mobile this should display as both images being square and above one another, again with generous padding. I need to be able to upload images within the theme editor for this section , more padding on the outside of the page., the right image is displaying as 4:5. I need it to be 1:1 but align at the top with the left image, less padding at the top
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-dual-image-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    padding: {{ block.settings.desktop_padding_top }}px {{ block.settings.desktop_padding }}px {{ block.settings.desktop_padding }}px {{ block.settings.desktop_padding }}px;
  }

  .ai-dual-image__container-{{ ai_gen_id }} {
    display: flex;
    gap: {{ block.settings.desktop_gap }}px;
    width: 100%;
    align-items: flex-start;
  }

  .ai-dual-image__item-{{ ai_gen_id }} {
    flex: 1;
    position: relative;
    overflow: hidden;
  }

  .ai-dual-image__item--left-{{ ai_gen_id }} {
    aspect-ratio: 4 / 5;
  }

  .ai-dual-image__item--right-{{ ai_gen_id }} {
    aspect-ratio: 1 / 1;
  }

  .ai-dual-image__image-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .ai-dual-image__placeholder-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    background-color: #f4f4f4;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .ai-dual-image__placeholder-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
    max-width: 200px;
    max-height: 200px;
  }

  @media screen and (max-width: 749px) {
    .ai-dual-image-{{ ai_gen_id }} {
      padding: {{ block.settings.mobile_padding_top }}px {{ block.settings.mobile_padding }}px {{ block.settings.mobile_padding }}px {{ block.settings.mobile_padding }}px;
    }

    .ai-dual-image__container-{{ ai_gen_id }} {
      flex-direction: column;
      gap: {{ block.settings.mobile_gap }}px;
    }

    .ai-dual-image__item--left-{{ ai_gen_id }},
    .ai-dual-image__item--right-{{ ai_gen_id }} {
      aspect-ratio: 1 / 1;
    }
  }
{% endstyle %}

<dual-images-{{ ai_gen_id }} class="ai-dual-image-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-dual-image__container-{{ ai_gen_id }}">
    <div class="ai-dual-image__item-{{ ai_gen_id }} ai-dual-image__item--left-{{ ai_gen_id }}">
      {% if block.settings.image_left %}
        <img
          src="{{ block.settings.image_left | image_url: width: 1200 }}"
          alt="{{ block.settings.image_left.alt | escape }}"
          loading="lazy"
          width="{{ block.settings.image_left.width }}"
          height="{{ block.settings.image_left.height }}"
          class="ai-dual-image__image-{{ ai_gen_id }}"
        >
      {% else %}
        <div class="ai-dual-image__placeholder-{{ ai_gen_id }}">
          {{ 'image' | placeholder_svg_tag }}
        </div>
      {% endif %}
    </div>

    <div class="ai-dual-image__item-{{ ai_gen_id }} ai-dual-image__item--right-{{ ai_gen_id }}">
      {% if block.settings.image_right %}
        <img
          src="{{ block.settings.image_right | image_url: width: 1200 }}"
          alt="{{ block.settings.image_right.alt | escape }}"
          loading="lazy"
          width="{{ block.settings.image_right.width }}"
          height="{{ block.settings.image_right.height }}"
          class="ai-dual-image__image-{{ ai_gen_id }}"
        >
      {% else %}
        <div class="ai-dual-image__placeholder-{{ ai_gen_id }}">
          {{ 'image' | placeholder_svg_tag }}
        </div>
      {% endif %}
    </div>
  </div>
</dual-images-{{ ai_gen_id }}>

<script>
  (function() {
    class DualImages{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }
    }

    customElements.define('dual-images-{{ ai_gen_id }}', DualImages{{ ai_gen_id }});
  })();
</script>

{% schema %}
{
  "name": "Dual images",
  "settings": [
    {
      "type": "header",
      "content": "Images"
    },
    {
      "type": "image_picker",
      "id": "image_left",
      "label": "Left image"
    },
    {
      "type": "image_picker",
      "id": "image_right",
      "label": "Right image"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "desktop_gap",
      "label": "Desktop spacing",
      "min": 10,
      "max": 100,
      "step": 5,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "mobile_gap",
      "label": "Mobile spacing",
      "min": 10,
      "max": 100,
      "step": 5,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "desktop_padding",
      "label": "Desktop side padding",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "desktop_padding_top",
      "label": "Desktop top padding",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "default": 20
    },
    {
      "type": "range",
      "id": "mobile_padding",
      "label": "Mobile side padding",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "default": 20
    },
    {
      "type": "range",
      "id": "mobile_padding_top",
      "label": "Mobile top padding",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "default": 20
    },
    {
      "type": "range",
      "id": "desktop_width_percent",
      "label": "Desktop width",
      "min": 50,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 100
    }
  ],
  "presets": [
    {
      "name": "Dual images"
    }
  ]
}
{% endschema %}
