{% doc %}
  @prompt
    Create a section that has a side by side content block (image upload capability) which stack on mobile. Each side needs the image at the top, then a heading, body text and a button where I can edit the text inside it. Use the default fonts already set by the theme, do not include any font picker or font selection settings. Each block needs separate editor controls for desktop image upload, mobile image upload. I need sliders for tax padding, image padding (for each side) and these need to be editable separately between desktop and mobile. each image should keep the natural aspect ratio of whatever image is uploaded rather than being forced into one fixed ratio.  Add separate slider controls for desktop and mobile for section top and bottom padding, column gap, image padding on all four sides, text padding on all four sides, heading text size and body text size. The heading and body text should be centred, and the button should be 150px by 50px with a 1.5px black border, black text, transparent background by default, and a black background with white text on hover.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-side-by-side-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    padding-top: {{ block.settings.section_padding_top_desktop }}px;
    padding-bottom: {{ block.settings.section_padding_bottom_desktop }}px;
  }

  .ai-side-by-side-container-{{ ai_gen_id }} {
    display: flex;
    gap: {{ block.settings.column_gap_desktop }}px;
    width: 100%;
  }

  .ai-side-by-side-column-{{ ai_gen_id }} {
    flex: 1;
    display: flex;
    flex-direction: column;
  }

  .ai-side-by-side-image-wrapper-{{ ai_gen_id }} {
    width: 100%;
    padding: {{ block.settings.image_padding_top_desktop }}px {{ block.settings.image_padding_right_desktop }}px {{ block.settings.image_padding_bottom_desktop }}px {{ block.settings.image_padding_left_desktop }}px;
  }

  .ai-side-by-side-image-{{ ai_gen_id }} {
    width: 100%;
    height: auto;
    display: block;
  }

  .ai-side-by-side-image-placeholder-{{ ai_gen_id }} {
    width: 100%;
    background-color: #f4f4f4;
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
  }

  .ai-side-by-side-image-placeholder-{{ ai_gen_id }} svg {
    width: 100%;
    height: auto;
  }

  .ai-side-by-side-text-wrapper-{{ ai_gen_id }} {
    padding: {{ block.settings.text_padding_top_desktop }}px {{ block.settings.text_padding_right_desktop }}px {{ block.settings.text_padding_bottom_desktop }}px {{ block.settings.text_padding_left_desktop }}px;
    text-align: center;
  }

  .ai-side-by-side-heading-{{ ai_gen_id }} {
    margin: 0 0 16px 0;
    font-size: {{ block.settings.heading_size_desktop }}px;
  }

  .ai-side-by-side-body-{{ ai_gen_id }} {
    margin: 0 0 24px 0;
    font-size: {{ block.settings.body_size_desktop }}px;
  }

  .ai-side-by-side-button-{{ ai_gen_id }} {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 150px;
    height: 50px;
    background-color: transparent;
    color: #000000;
    border: 1.5px solid #000000;
    text-decoration: none;
    transition: all 0.3s ease;
    cursor: pointer;
  }

  .ai-side-by-side-button-{{ ai_gen_id }}:hover {
    background-color: #000000;
    color: #ffffff;
  }

  @media screen and (max-width: 749px) {
    .ai-side-by-side-{{ ai_gen_id }} {
      padding-top: {{ block.settings.section_padding_top_mobile }}px;
      padding-bottom: {{ block.settings.section_padding_bottom_mobile }}px;
    }

    .ai-side-by-side-container-{{ ai_gen_id }} {
      flex-direction: column;
      gap: {{ block.settings.column_gap_mobile }}px;
    }

    .ai-side-by-side-image-wrapper-{{ ai_gen_id }} {
      padding: {{ block.settings.image_padding_top_mobile }}px {{ block.settings.image_padding_right_mobile }}px {{ block.settings.image_padding_bottom_mobile }}px {{ block.settings.image_padding_left_mobile }}px;
    }

    .ai-side-by-side-text-wrapper-{{ ai_gen_id }} {
      padding: {{ block.settings.text_padding_top_mobile }}px {{ block.settings.text_padding_right_mobile }}px {{ block.settings.text_padding_bottom_mobile }}px {{ block.settings.text_padding_left_mobile }}px;
    }

    .ai-side-by-side-heading-{{ ai_gen_id }} {
      font-size: {{ block.settings.heading_size_mobile }}px;
    }

    .ai-side-by-side-body-{{ ai_gen_id }} {
      font-size: {{ block.settings.body_size_mobile }}px;
    }
  }
{% endstyle %}

<side-by-side-{{ ai_gen_id }} class="ai-side-by-side-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-side-by-side-container-{{ ai_gen_id }}">
    <div class="ai-side-by-side-column-{{ ai_gen_id }}">
      <div class="ai-side-by-side-image-wrapper-{{ ai_gen_id }}">
        {% if block.settings.image_left_desktop %}
          <picture>
            {% if block.settings.image_left_mobile %}
              <source
                media="(max-width: 749px)"
                srcset="{{ block.settings.image_left_mobile | image_url: width: 800 }}"
              >
            {% endif %}
            <img
              src="{{ block.settings.image_left_desktop | image_url: width: 1200 }}"
              alt="{{ block.settings.image_left_desktop.alt | escape }}"
              class="ai-side-by-side-image-{{ ai_gen_id }}"
              loading="lazy"
              width="{{ block.settings.image_left_desktop.width }}"
              height="{{ block.settings.image_left_desktop.height }}"
            >
          </picture>
        {% else %}
          <div class="ai-side-by-side-image-placeholder-{{ ai_gen_id }}">
            {{ 'image' | placeholder_svg_tag }}
          </div>
        {% endif %}
      </div>
      <div class="ai-side-by-side-text-wrapper-{{ ai_gen_id }}">
        {% if block.settings.heading_left != blank %}
          <h2 class="ai-side-by-side-heading-{{ ai_gen_id }}">{{ block.settings.heading_left }}</h2>
        {% endif %}
        {% if block.settings.body_left != blank %}
          <div class="ai-side-by-side-body-{{ ai_gen_id }}">{{ block.settings.body_left }}</div>
        {% endif %}
        {% if block.settings.button_text_left != blank %}
          <a
            href="{{ block.settings.button_link_left }}"
            class="ai-side-by-side-button-{{ ai_gen_id }}"
          >
            {{ block.settings.button_text_left }}
          </a>
        {% endif %}
      </div>
    </div>

    <div class="ai-side-by-side-column-{{ ai_gen_id }}">
      <div class="ai-side-by-side-image-wrapper-{{ ai_gen_id }}">
        {% if block.settings.image_right_desktop %}
          <picture>
            {% if block.settings.image_right_mobile %}
              <source
                media="(max-width: 749px)"
                srcset="{{ block.settings.image_right_mobile | image_url: width: 800 }}"
              >
            {% endif %}
            <img
              src="{{ block.settings.image_right_desktop | image_url: width: 1200 }}"
              alt="{{ block.settings.image_right_desktop.alt | escape }}"
              class="ai-side-by-side-image-{{ ai_gen_id }}"
              loading="lazy"
              width="{{ block.settings.image_right_desktop.width }}"
              height="{{ block.settings.image_right_desktop.height }}"
            >
          </picture>
        {% else %}
          <div class="ai-side-by-side-image-placeholder-{{ ai_gen_id }}">
            {{ 'image' | placeholder_svg_tag }}
          </div>
        {% endif %}
      </div>
      <div class="ai-side-by-side-text-wrapper-{{ ai_gen_id }}">
        {% if block.settings.heading_right != blank %}
          <h2 class="ai-side-by-side-heading-{{ ai_gen_id }}">{{ block.settings.heading_right }}</h2>
        {% endif %}
        {% if block.settings.body_right != blank %}
          <div class="ai-side-by-side-body-{{ ai_gen_id }}">{{ block.settings.body_right }}</div>
        {% endif %}
        {% if block.settings.button_text_right != blank %}
          <a
            href="{{ block.settings.button_link_right }}"
            class="ai-side-by-side-button-{{ ai_gen_id }}"
          >
            {{ block.settings.button_text_right }}
          </a>
        {% endif %}
      </div>
    </div>
  </div>
</side-by-side-{{ ai_gen_id }}>

<script>
  (function() {
    class SideBySide{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
      }
    }

    customElements.define('side-by-side-{{ ai_gen_id }}', SideBySide{{ ai_gen_id }});
  })();
</script>

