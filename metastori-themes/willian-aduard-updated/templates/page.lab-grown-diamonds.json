          "blocks": {}
        },
        "ai_gen_block_0029bb1_XYxmKq": {
          "type": "ai_gen_block_0029bb1",
          "settings": {
            "heading": "Why certification matters for lab grown diamonds",
            "text": "<p>Certification ensures the diamond you are purchasing has been independently verified for quality and authenticity. It also confirms that the stone is lab grown, providing full transparency around its origin. This is particularly important in a market where both natural and lab grown diamonds coexist.</p>",
            "heading_size_desktop": 30,
            "text_size_desktop": 18,
            "padding_left_desktop": 380,
            "padding_right_desktop": 380,
            "spacing_desktop": 40,
