        "ai_gen_block_0029bb1_HyCk9p": {
          "type": "ai_gen_block_0029bb1",
          "settings": {
            "heading": "What a lab grown diamond report includes",
            "text": "<p>A lab grown diamond grading report will typically outline:</p><p><strong>Grading report number: </strong>A unique identifier that corresponds to the specific stone.</p><p><strong>4Cs: </strong>A full assessment of cut, colour, clarity, and carat weight.</p><p><strong>Growth method: </strong>Identification of whether the diamond was created using HPHT or CVD.</p><p><strong>Post-growth treatments:</strong> Disclosure of any treatments applied to enhance colour or clarity.</p><p><strong>Additional grading factors:</strong> Including polish, symmetry, fluorescence, proportions, and exact measurements.</p><p><strong>Inclusion plot: </strong>A mapped diagram of internal and external characteristics unique to the stone.</p><p><strong>Laser inscription: </strong>Many lab grown diamonds are microscopically inscribed with their report number for identification.</p>",
            "heading_size_desktop": 30,
            "text_size_desktop": 18,
            "padding_left_desktop": 380,
            "padding_right_desktop": 380,
            "spacing_desktop": 40,
