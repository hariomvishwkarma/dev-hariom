        "ai_gen_block_0029bb1_wdwEpf": {
          "type": "ai_gen_block_0029bb1",
          "settings": {
            "heading": "A Guide to Lab Grown Diamonds",
            "text": "<p>Lab grown diamonds are real diamonds created in controlled laboratory environments rather than formed underground. They have the same chemical, physical, and optical properties as natural diamonds, meaning they look and perform identically. The key difference lies in origin, not composition. These stones are grown using advanced technology that replicates the conditions under which diamonds naturally form.</p>",
            "heading_size_desktop": 36,
            "text_size_desktop": 18,
            "padding_left_desktop": 380,
            "padding_right_desktop": 380,
            "spacing_desktop": 40,
            "heading_size_mobile": 24,
            "text_size_mobile": 14,
            "padding_left_mobile": 40,
            "padding_right_mobile": 40,
            "spacing_mobile": 35,
            "text_alignment": "center",
            "heading_color": "#000000",
            "text_color": "#000000"
          },
          "blocks": {}
        },
        "ai_gen_block_8322f0f_RFge8A": {
          "type": "ai_gen_block_8322f0f",
          "settings": {
            "padding_top_desktop": 0,
            "padding_bottom_desktop": 25,
            "padding_top_mobile": 5,
            "padding_bottom_mobile": 20
          },
          "blocks": {}
