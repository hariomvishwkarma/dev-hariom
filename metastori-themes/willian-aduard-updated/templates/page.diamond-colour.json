      "blocks": {
        "ai_gen_block_0029bb1_wdwEpf": {
          "type": "ai_gen_block_0029bb1",
          "settings": {
            "heading": "A Guide to Diamond Colour",
            "text": "<p>White diamonds are graded on a scale from D, entirely colourless, through to Z, where warmer tones become increasingly visible. The rarest diamonds sit within the D to F range, where the absence of colour allows light to pass through the stone with exceptional purity.</p><p>Differences between neighbouring grades are often imperceptible to the untrained eye, yet they remain significant in rarity and value. Under the Gemological Institute of America (GIA) system, diamonds are graded face down in controlled lighting and compared against master stones of known colour, isolating the stone’s true body colour without influence from brilliance or setting.</p><p>Our collection is drawn predominantly from the D to G range.</p>",
            "heading_size_desktop": 36,
            "text_size_desktop": 18,
            "padding_left_desktop": 380,
            "padding_right_desktop": 380,
            "spacing_desktop": 40,
            "heading_size_mobile": 24,
            "text_size_mobile": 14,
            "padding_left_mobile": 40,
            "padding_right_mobile": 40,
            "spacing_mobile": 35,
            "text_alignment": "center",
            "heading_color": "#000000",
            "text_color": "#000000"
          },
          "blocks": {}
        }
      },
      "block_order": [
        "ai_gen_block_0029bb1_wdwEpf"
      ],
      "settings": {}
