{%- style -%}
  .lp-hero-main {
    background-image:url({{section.settings.img | image_url  }});
     height: 85vh;
    background-size: cover;
    background-repeat: no-repeat;
    background-position: center;
  }

  @media screen and (max-width: 750px) {
   .lp-hero-main {
    background-image:url({{section.settings.img2 | image_url  }});
    height: calc(100vh - 165px);
   }
  .lp-title {
    height: calc(100vh - 200px);
  }
  }
{%- endstyle -%}

<div class="lp-hero-main">
    <div class="container">
        <div class="lp-title">
            <h1>{{ section.settings.title }}</h1>
        </div>
            <div class="lp-links-grid">
                {% for block in section.blocks %}
                    <a href="{{block.settings.url}}" class="btn-lg-secondary">{{block.settings.url_text}}</a>
                {% endfor %}
            </div>
        </div>
    </div>

{% schema %}
{
  "name": "Lp Hero",
  "class": "section-lp-hero",
  "disabled_on": {
    "groups": [
      "aside"
    ]
  },
  "settings": [
    {
      "type": "header",
      "content": "Index column"
    },
    {
      "type": "image_picker",
      "id": "img",
      "label": "Desktop Image"
    },
    {
      "type": "image_picker",
      "id": "img2",
      "label": "Mobile Image"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Title"
    }
    
  ],
    "blocks": [
    {
      "type": "link",
      "name": "Links",
      "settings": [
        {
          "type": "url",
          "id": "url",
          "label": "Link Url"
        },
        {
          "type": "text",
          "id": "url_text",
          "label": "Button Name"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Lp Hero",
      "settings": {
      }
    }
  ]
}
{% endschema %}
