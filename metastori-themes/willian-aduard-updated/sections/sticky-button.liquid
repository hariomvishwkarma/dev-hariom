{%- if section.settings.link_text != blank -%}
  <style>
    #shopify-section-{{ section.id }} {
      height: 0;
      margin: 0 !important;
      padding: 0;
      overflow: visible;
    }

    .sticky-button-{{ section.id }} {
      position: fixed;
      left: 0;
      right: 0;
      bottom: 0;
      z-index: 20;
      display: flex;
      justify-content: center;
      align-items: center;
      padding: 12px 16px calc(12px + env(safe-area-inset-bottom, 0px));
      {% comment %} background: #fff;
      box-shadow: 0 -1px 8px rgba(0, 0, 0, 0.08); {% endcomment %}
      text-align: center;
    }

    html.js-drawer-open .sticky-button-{{ section.id }} {
      visibility: hidden;
      pointer-events: none;
    }
  </style>

  <div class="sticky-button-{{ section.id }}" data-sticky-button>
    <a href="{{ section.settings.link }}" class="btn">
      {{ section.settings.link_text }}
    </a>
  </div>

  <script>
    document.addEventListener('DOMContentLoaded', function () {
      var bar = document.querySelector('.sticky-button-{{ section.id }}');
      if (!bar) return;
      document.body.style.paddingBottom = bar.offsetHeight + 'px';
    });
  </script>
{%- endif -%}

{% schema %}
{
  "name": "Sticky button",
  "class": "sticky-button-section",
  "settings": [
    {
      "type": "text",
      "id": "link_text",
      "label": "Button label",
      "default": "Book Now"
    },
    {
      "type": "url",
      "id": "link",
      "label": "Button link"
    }
  ],
  "presets": [
    {
      "name": "Sticky button"
    }
  ],
  "disabled_on": {
    "groups": ["header", "footer", "custom.popups"]
  }
}
{% endschema %}
