{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  .section-{{ section.id }}-padding .tabcontent.collection-slider-row {
    margin-top: 0;
  }

  #shop-by-products-{{ section.id }} .section-title,
  #shop-by-products-{{ section.id }} .hometitle {
    text-align: center;
  }

  #shop-by-products-{{ section.id }} .hometitle--tabs-nav .has-paging__title {
    width: 0;
    height: 0;
    overflow: hidden;
    padding: 0;
    margin: 0;
  }

  #shop-by-products-{{ section.id }} .just-tabs {
    display: flex;
    justify-content: center;
    gap: 15px;
    flex-wrap: wrap;
  }

  #shop-by-products-{{ section.id }} .just-tabs .tablink {
    margin: 10px 0;
    padding: 13px 15px;
    text-align: center;
    background: transparent;
    border: 0;
    cursor: pointer;
  }

  #shop-by-products-{{ section.id }} .just-tabs .tablink.active {
    font-weight: 600;
  }

  #shop-by-products-{{ section.id }} .show-all-btn {
    text-align: center;
    margin-top: 50px;
  }

  #shop-by-products-{{ section.id }} .tabcontent:not(.is-active) {
    height: 0;
    overflow: hidden;
    visibility: hidden;
    position: absolute;
    width: 100%;
    pointer-events: none;
  }

  #shop-by-products-{{ section.id }} .tabcontent.is-active {
    height: auto;
    overflow: visible;
    visibility: visible;
    position: relative;
    pointer-events: auto;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

{%- liquid
  assign tab_names_joined = ''
  assign has_named_tabs = false

  for block in section.blocks
    if block.settings.product == blank
      continue
    endif

    assign tab_label = block.settings.ttl_txt | strip
    if tab_label == blank
      continue
    endif

    assign has_named_tabs = true
    assign tab_needle = '|||' | append: tab_label | append: '|||'
    unless tab_names_joined contains tab_needle
      if tab_names_joined == blank
        assign tab_names_joined = tab_needle
      else
        assign tab_names_joined = tab_names_joined | append: tab_label | append: '|||'
      endif
    endunless
  endfor

  assign tab_names = tab_names_joined | split: '|||'
  assign grid = section.settings.grid | default: 4
  assign enable_carousel = section.settings.enable_carousel
  if enable_carousel == nil
    assign enable_carousel = true
  endif
  assign full_width = section.settings.full_width
  if full_width == nil
    assign full_width = true
  endif
-%}

<div
  id="shop-by-products-{{ section.id }}"
  class="section-id-{{ section.id }} section-{{ section.id }}-padding collection-slider-row js-shop-by-products {% if section.settings.color_scheme != 'default' %}use-color-scheme use-color-scheme--{{ section.settings.color_scheme }}{% endif %}"
>
  {%- if has_named_tabs -%}
    <div class="container{% if full_width %} container--no-max{% endif %}">
      {%- if section.settings.heading != blank -%}
        <div class="section-title hometitle align-center">
          <h2 class="has-paging__title h4 m-0">{{ section.settings.heading }}</h2>
        </div>
      {%- endif -%}
      <div class="just-tabs">
        {%- assign tab_index = 0 -%}
        {%- for tab_name in tab_names -%}
          {%- if tab_name == blank -%}{%- continue -%}{%- endif -%}
          {%- assign tab_index = tab_index | plus: 1 -%}
          <button
            class="tablink{% if tab_index == 1 %} active{% endif %}"
            type="button"
            data-tab="ProductTab-{{ section.id }}-{{ tab_index }}"
            {% if tab_index == 1 %}
              data-default-tab
            {% endif %}
          >
            {{ tab_name }}
          </button>
        {%- endfor -%}
      </div>
    </div>

    {%- assign tab_index = 0 -%}
    {%- for tab_name in tab_names -%}
      {%- if tab_name == blank -%}{%- continue -%}{%- endif -%}
      {%- assign tab_index = tab_index | plus: 1 -%}
      {%- assign product_count = 0 -%}
      {%- assign show_all_url = '' -%}

      {%- for block in section.blocks -%}
        {%- if block.settings.product == blank -%}{%- continue -%}{%- endif -%}
        {%- assign block_tab = block.settings.ttl_txt | strip -%}
        {%- if block_tab == tab_name -%}
          {%- assign product_count = product_count | plus: 1 -%}
          {%- if show_all_url == blank and block.settings.show_all_url != blank -%}
            {%- assign show_all_url = block.settings.show_all_url -%}
          {%- endif -%}
        {%- endif -%}
      {%- endfor -%}

      <div
        id="ProductTab-{{ section.id }}-{{ tab_index }}"
        class="tabcontent{% if tab_index == 1 %} is-active{% endif %}"
        {% if tab_index == 1 %}
          data-default-panel
        {% endif %}
      >
        {%- if product_count > 0 -%}
          {% render 'lp-shop-products-carousel',
            tab_name: tab_name,
            has_named_tabs: true,
            enable_carousel: enable_carousel,
            full_width: full_width,
            grid: grid,
            show_all_url: show_all_url
          %}
        {%- else -%}
          <div class="container">
            <p>No products found in this tab.</p>
          </div>
        {%- endif -%}
      </div>
    {%- endfor -%}
  {%- else -%}
    {%- assign show_all_url = '' -%}
    {%- for block in section.blocks -%}
      {%- if show_all_url == blank and block.settings.show_all_url != blank -%}
        {%- assign show_all_url = block.settings.show_all_url -%}
      {%- endif -%}
    {%- endfor -%}

    {% render 'lp-shop-products-carousel',
      tab_name: '',
      has_named_tabs: false,
      enable_carousel: enable_carousel,
      full_width: full_width,
      grid: grid,
      show_all_url: show_all_url
    %}
  {%- endif -%}
</div>

{% schema %}
{
  "name": "LP Shop Products",
  "class": "section-product-grid",
  "settings": [
    {
      "type": "richtext",
      "id": "heading",
      "label": "Heading"
    },
    {
      "type": "paragraph",
      "content": "Add Product blocks. Use the same Tab name on products that should appear together. Leave Tab name empty to hide tabs. Each block shows only one metal/variant of that product, with the lowest price for that metal."
    },
    {
      "type": "checkbox",
      "id": "enable_carousel",
      "label": "Enable carousel",
      "default": true
    },
    {
      "type": "range",
      "id": "grid",
      "label": "Products per row",
      "min": 2,
      "max": 5,
      "step": 1,
      "default": 4
    },
    {
      "type": "checkbox",
      "id": "full_width",
      "label": "Full page width",
      "default": true
    },
    {
      "type": "select",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "default",
      "options": [
        {
          "value": "default",
          "label": "Default"
        },
        {
          "value": "1",
          "label": "1"
        },
        {
          "value": "2",
          "label": "2"
        }
      ]
    },
    {
      "type": "header",
      "content": "Section Padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding top",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding bottom",
      "default": 36
    }
  ],
  "blocks": [
    {
      "type": "product",
      "name": "Product",
      "settings": [
        {
          "type": "text",
          "id": "ttl_txt",
          "label": "Tab name",
          "info": "Optional. Products with the same tab name group together. Leave empty to hide tabs."
        },
        {
          "type": "product",
          "id": "product",
          "label": "Product"
        },
        {
          "type": "select",
          "id": "metal",
          "label": "Variant / Metal to show",
          "info": "Controls which metal image is shown. Price uses the lowest variant for that metal (e.g. lab-grown).",
          "default": "first",
          "options": [
            {
              "value": "first",
              "label": "First available variant"
            },
            {
              "value": "yellow-gold",
              "label": "Yellow Gold"
            },
            {
              "value": "white-gold",
              "label": "White Gold"
            },
            {
              "value": "rose-gold",
              "label": "Rose Gold"
            },
            {
              "value": "sterling-silver",
              "label": "Sterling Silver"
            },
            {
              "value": "platinum",
              "label": "Platinum"
            }
          ]
        },
        {
          "type": "text",
          "id": "variant_sku",
          "label": "Variant SKU",
          "info": "Optional. Overrides the metal dropdown. Enter the exact SKU of the variant to show."
        },
        {
          "type": "text",
          "id": "variant_id",
          "label": "Variant ID",
          "info": "Optional. Overrides metal and SKU. In Admin, open the product, click the variant, and copy the number from the URL (variants/THIS_NUMBER)."
        },
        {
          "type": "url",
          "id": "show_all_url",
          "label": "Show all link",
          "info": "Optional. Used for this tab's Show All button. Set it on any product in the tab."
        }
      ]
    }
  ],
  "max_blocks": 50,
  "presets": [
    {
      "name": "LP Shop Products"
    }
  ]
}
{% endschema %}

<script>
  (function () {
    var root = document.getElementById('shop-by-products-{{ section.id }}');
    if (!root) return;

    var tabButtons = root.querySelectorAll('.just-tabs .tablink');
    if (!tabButtons.length) return;

    function openPage(pageName) {
      var panels = root.querySelectorAll('.tabcontent');
      panels.forEach(function (panel) {
        panel.classList.toggle('is-active', panel.id === pageName);
      });

      var activePanel = document.getElementById(pageName);
      if (!activePanel) return;

      var carousel = activePanel.querySelector('carousel-slider');
      if (carousel && typeof carousel.refresh === 'function') {
        requestAnimationFrame(function () {
          try {
            carousel.refresh();
          } catch (e) {}
        });
      }

      root.querySelectorAll('.product-block.expanded').forEach(function (el) {
        el.classList.remove('expanded');
      });
      root.querySelectorAll('.quickbuy-container').forEach(function (qb) {
        qb.style.height = '0';
        var inner = qb.querySelector('.inner');
        if (inner) inner.innerHTML = '';
      });
    }

    tabButtons.forEach(function (btn) {
      btn.addEventListener('click', function () {
        tabButtons.forEach(function (tab) {
          tab.classList.remove('active');
        });
        btn.classList.add('active');
        openPage(btn.getAttribute('data-tab'));
      });
    });

    var defaultTab = root.querySelector('[data-default-tab]');
    if (defaultTab) defaultTab.click();
  })();
</script>
