<script src="https://ajax.googleapis.com/ajax/libs/jquery/3.6.4/jquery.min.js"></script>  
<script src="https://cdnjs.cloudflare.com/ajax/libs/slick-carousel/1.8.1/slick.min.js"></script>
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/slick-carousel/1.8.1/slick-theme.min.css">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/slick-carousel/1.8.1/slick.min.css">

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  .section-{{ section.id }}-padding .tabcontent.collection-slider-row {
    margin-top: 0;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

<section class="new-releases page-width section-{{ section.id }}-padding">
  <div class="new-releases-wrapper">
    <div class="section-title">
      <h2>{{ section.settings.heading }}</h2>
    </div>
    <div class="just-tabs">
      {% for block in section.blocks %}
        <button
          class="tablink {% if forloop.first %}active{% endif %}"
          onclick="openPage('Collection-{{ forloop.index }}')"
          {% if forloop.first %}
            id="defaultOpen"
          {% endif %}
        >
          {{ block.settings.ttl_txt }}
        </button>
      {% endfor %}
    </div>
  </div>

  <div class="collection-lists">
    {% for block in section.blocks %}
      {% assign current_collection = collections[block.settings.col_name] %}
      {% assign product_count = current_collection.products_count | plus: 0 %}

      {% if current_collection and product_count > 0 %}
        <div id="Collection-{{ forloop.index }}" class="tabcontent collection-slider-row {% if forloop.first %}active{% endif %}">
          <div class="shop-by-category collection-slider swiper_{{forloop.index}}">
            {% for product in current_collection.products limit: 10 %}
              {% render 'metal-product-cards-v2',
                product: product,
                show_all_metals: true,
                wrap_as_slide: true
              %}
            {% endfor %}
          </div>

          {% if settings.quickbuy_style != 'off' %}
            <div class="quickbuy-container use-color-scheme use-color-scheme--{{ settings.quickbuy_color_scheme }} js-quickbuy">
              <a href="#" class="close-detail" aria-label="{{ 'accessibility.close' | t }}" tabindex="-1" aria-hidden="true">{% render 'icon-close', stroke_width: 1 %}</a>
              <div class="inner"></div>
            </div>
          {% endif %}

          {% if product_count > 6 %}
            <div class="show-all-btn">
              <a href="{{ current_collection.url }}" class="btn-lg-secondary">Show All</a>
            </div>
          {% endif %}
        </div>
      {% else %}
        <div id="Collection-{{ forloop.index }}" class="tabcontent">
          <p>No products found in this collection.</p>
        </div>
      {% endif %}

        <script>
        $(document).ready(function () {
            $('.swiper_{{forloop.index}}').slick({
                dots: false,
                slidesToShow: 4,
                slidesToScroll: 1,
                arrows: true,
                responsive: [{
                    breakpoint: 1024,
                    settings: {
                        slidesToShow: 3,
                        slidesToScroll: 1,

                    }
                },
                {
                    breakpoint: 600,
                    settings: {
                        slidesToShow: 1,
                        slidesToScroll: 1
                    }
                },
                {
                    breakpoint: 480,
                    settings: {
                        slidesToShow: 1,
                        slidesToScroll: 1
                    }
                }

                ]
            });
        });
        </script>
    {% endfor %}
  </div>
</section>



{% schema %}
{
  "name": "LP Shop Category",
  "settings": [
    {
      "type": "richtext",
      "id": "heading",
      "label": "Heading"
    },
    {
      "type": "header",
      "content": "Section Padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "padding Top",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding bottom",
      "default": 36
    },
  ],
  "blocks": [
    {
      "type": "collection",
      "name": "collection",
      "settings": [
        {
          "type": "collection",
          "id": "col_name",
          "label": "Select Collection"
        },
        {
          "type": "text",
          "id": "ttl_txt",
          "label": "Lable Name"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "LP Shop Category"
    }
  ]
}
{% endschema %}

<script>
  function openPage(pageName, elmnt, color) {
     var i, tabcontent, tablinks;

     tabcontent = document.getElementsByClassName("tabcontent");
     for (i = 0; i < tabcontent.length; i++) {
        tabcontent[i].style.height = "0"
        tabcontent[i].style.overflow = "hidden"
     }
     tablinks = document.getElementsByClassName("tablink");
     for (i = 0; i < tablinks.length; i++) {
        tablinks[i].style.backgroundColor = "";
     }
     document.getElementById(pageName).style.height = "auto";
     document.getElementById(pageName).style.overflow = "visible";
  }
  document.getElementById("defaultOpen").click();

  jQuery(document).ready(function() {
    jQuery('.just-tabs button').click(function() {
       jQuery('.tablink').removeClass('active');
        jQuery(this).addClass('active');
        jQuery('.new-releases .product-block.expanded').removeClass('expanded');
        jQuery('.new-releases .quickbuy-container').css('height', '0').find('.inner').empty();
    });
  });
</script>
