        "full_width": true,
        "show_space": true,
        "code": "<style>\n  .shieldeck-different-section {\n    max-width: 1200px;\n    margin: 0 auto;\n    padding: 60px 20px;\n    text-align: center;\n    background: #fff;\n    border-radius: 100px;\n  }\n\n  .shieldeck-different-title {\n    font-size: 28px;\n    font-weight: 700;\n    letter-spacing: -0.8px;\n    color: #005994;\n    margin-bottom: 50px;\n  }\n\n  .shieldeck-different-grid {\n    display: flex;\n    justify-content: space-between;\n    gap: 40px;\n    text-align: left;\n    flex-wrap: wrap;\n  }\n\n  .shieldeck-different-item {\n    flex: 1;\n    max-width: 340px;\n    margin: 0 auto;\n    text-align: center;\n  }\n\n  .shieldeck-different-item img {\n    height: 60px;\n    margin-bottom: 20px;\n  }\n\n  .shieldeck-different-item h3 {\n    font-size: 18px;\n    font-weight: 700;\n    color: #005994;\n    margin-bottom: 10px;\n    letter-spacing: -0.3px;\n  }\n\n  .shieldeck-different-item p {\n    font-size: 16px;\n    font-weight: 500;\n    line-height: 1.6;\n    color: #005994;\n    letter-spacing: -0.01em;\n  }\n\n  @media screen and (max-width: 768px) {\n    .shieldeck-different-section {\n      padding: 40px 16px;\n      margin-left: 15px;\n      margin-right: 15px;\n    }\n\n    .shieldeck-different-title {\n      font-size: 26px;\n      margin-bottom: 36px;\n    }\n\n    .shieldeck-different-grid {\n      flex-direction: column;\n      gap: 32px;\n      text-align: center;\n    }\n\n    .shieldeck-different-item {\n      max-width: 100%;\n    }\n\n    .shieldeck-different-item img {\n      height: 50px;\n      margin-bottom: 16px;\n    }\n\n    .shieldeck-different-item h3 {\n      font-size: 17px;\n    }\n\n    .shieldeck-different-item p {\n      font-size: 15px;\n    }\n  }\n</style>\n\n<div class=\"shieldeck-different-section\">\n  <div class=\"shieldeck-different-title\">What Makes Shieldeck Different</div>\n\n  <div class=\"shieldeck-different-grid\">\n    <div class=\"shieldeck-different-item\">\n      <img src=\"https://cdn.shopify.com/s/files/1/0515/2459/9996/files/Layer_1_d1916887-51ca-49a5-8d5a-22c41d51040c.png?v=1752998788\" alt=\"Chemical Free Icon\" loading=\"lazy\" />\n      <h3>100% Chemical-Free</h3>\n      <p>No sprays. No toxins. Just safe, natural protection for your home and family.</p>\n    </div>\n\n    <div class=\"shieldeck-different-item\">\n      <img src=\"https://cdn.shopify.com/s/files/1/0515/2459/9996/files/Layer_1-1_36b4dda2-741b-4bf5-804b-7dbf67080aa2.png?v=1752998788\" alt=\"Noiseless Icon\" loading=\"lazy\" />\n      <h3>Whisper-Quiet</h3>\n      <p>Silent fan pulls bugs in without a sound. Set it and forget it—day or night.</p>\n    </div>\n\n    <div class=\"shieldeck-different-item\">\n      <img src=\"https://cdn.shopify.com/s/files/1/0735/4672/7723/files/3_992da63b-368f-4e95-9ce3-72db2dc52452.png?v=1747756556\" alt=\"Results Icon\" loading=\"lazy\" />\n      <h3>Visible Results</h3>\n      <p>You’ll literally see the trap working. More peace of mind with every captured pest.</p>\n    </div>\n  </div>\n</div>"
      }
    },
    "custom_liquid_MAz987": {
      "type": "custom-liquid",
      "disabled": true,
      "name": "Custom Liquid",
      "settings": {
        "full_width": true,
        "show_space": true,
        "code": "<!-- Flickity -->\n<link rel=\"stylesheet\" href=\"https://cdn.jsdelivr.net/npm/flickity@2/dist/flickity.min.css\">\n<script src=\"https://cdn.jsdelivr.net/npm/flickity@2/dist/flickity.pkgd.min.js\"></script>\n\n<style>\n  .review-testimonials {\n    background: #EBFAFF;\n    padding: 60px 20px;\n    font-family: inherit;\n    text-align: center;\n  }\n\n  .review-testimonials h2 {\n    font-size: 28px;\n    font-weight: 700;\n    margin-bottom: 40px;\n  }\n\n  .review-carousel {\n    max-width: 1280px;\n    margin: 0 auto;\n  }\n\n  .review-cell {\n    width: 300px;\n    margin-right: 20px;\n    background: #fff;\n    border: 1px solid #d5e4f2;\n    border-radius: 16px;\n    padding: 24px;\n    box-shadow: 0 4px 10px rgba(0, 0, 0, 0.06);\n    text-align: left;\n    margin-bottom: 15px;\n  }\n\n  .review-cell img.review-image {\n    width: 100%;\n    border-radius: 12px;\n    margin-top: 16px;\n  }\n\n  .review-stars {\n    font-size: 16px;\n    color: #00B5DF;\n    margin-bottom: 7px;\n  }\n\n  .review-title {\n    font-size: 16px;\n    font-weight: 700;\n    margin-bottom: 5px;\n  }\n\n  .review-text {\n    font-size: 14px;\n    font-weight: 500;\n    margin-bottom: 12px;\n    letter-spacing: -0.01em;\n  }\n\n  .review-author {\n    font-size: 14px;\n    font-weight: 600;\n    margin-bottom: 4px;\n    display: flex;\n    align-items: center;\n    flex-wrap: wrap;\n    gap: 6px;\n  }\n\n  .review-verified {\n    font-size: 12px;\n    font-weight: 500;\n    display: flex;\n    align-items: center;\n    gap: 4px;\n    color: #00B5DF;\n  }\n\n  .review-verified svg {\n    width: 14px;\n    height: 14px;\n  }\n\n  .flickity-prev-next-button {\n    background: transparent;\n    top: 35%;\n  }\n\n  .flickity-prev-next-button.previous {\n    left: -60px;\n  }\n\n  .flickity-prev-next-button.next {\n    right: -60px;\n  }\n\n  .flickity-prev-next-button .flickity-button-icon {\n    fill: #00B5DF;\n    width: 18px;\n    height: 18px;\n  }\n\n  @media (max-width: 768px) {\n    .review-cell {\n      width: 65%;\n  margin-right: 12px;\n    padding: 20px; /* Reduced from 24px */\n\n\n    }\n  .review-carousel {\n    margin-right: -20px;\n  }\n}\n\n    .flickity-prev-next-button {\n      display: none !important;\n    }\n  }\n</style>\n\n<section class=\"review-testimonials\">\n  <h2>Helping Over a Million Smiles</h2>\n\n  <div class=\"review-carousel\" data-flickity='{\n    \"cellAlign\": \"left\",\n    \"contain\": true,\n    \"pageDots\": true,\n    \"prevNextButtons\": true,\n    \"wrapAround\": true,\n    \"groupCells\": 1\n  }'>\n  \n    <!-- Card 1 -->\n    <div class=\"review-cell\">\n      <div class=\"review-stars\">★ ★ ★ ★ ★</div>\n      <div class=\"review-title\">Gentle enough for sensitive teeth.</div>\n      <div class=\"review-text\">I’m a dental hygienist and this product is amazing. I gave it to my family and need to buy more!</div>\n      <div class=\"review-author\">\n        Kari P.\n        <span class=\"review-verified\">\n          <svg fill=\"currentColor\" viewBox=\"0 0 20 20\"><path d=\"M10 0l2.39 3.423L16 3.5l-1.652 2.913L15 10l-2.26-.5L10 13l-2.74-3.5L5 10l.652-3.587L4 3.5l3.61-.077L10 0z\"/></svg>\n          Verified Purchase\n        </span>\n      </div>\n      <img class=\"review-image\" src=\"https://www.trysnow.com/cdn/shop/files/3.0_Diamond-Wired_Review-01-KarlP.jpg?v=1710189338\" alt=\"Kari P review image\">\n    </div>\n\n    <!-- Card 2 -->\n    <div class=\"review-cell\">\n      <div class=\"review-stars\">★ ★ ★ ★ ★</div>\n      <div class=\"review-title\">Invest in yourself and buy Snow!</div>\n      <div class=\"review-text\">I’ve tried everything. Don’t waste more money — this actually works. I love my smile again!</div>\n      <div class=\"review-author\">\n        Cameron R.\n        <span class=\"review-verified\">\n          <svg fill=\"currentColor\" viewBox=\"0 0 20 20\"><path d=\"M10 0l2.39 3.423L16 3.5l-1.652 2.913L15 10l-2.26-.5L10 13l-2.74-3.5L5 10l.652-3.587L4 3.5l3.61-.077L10 0z\"/></svg>\n          Verified Purchase\n        </span>\n      </div>\n      <img class=\"review-image\" src=\"https://www.trysnow.com/cdn/shop/files/3.0_Diamond-Wired_Review-02-CameronR.jpg?v=1710189338\" alt=\"Cameron R review image\">\n    </div>\n\n    <!-- Card 3 -->\n    <div class=\"review-cell\">\n      <div class=\"review-stars\">★ ★ ★ ★ ★</div>\n      <div class=\"review-title\">ZERO sensitivity</div>\n      <div class=\"review-text\">I quit smoking but couldn’t whiten my teeth until Snow. No pain, just results.</div>\n      <div class=\"review-author\">\n        Patty A.\n        <span class=\"review-verified\">\n          <svg fill=\"currentColor\" viewBox=\"0 0 20 20\"><path d=\"M10 0l2.39 3.423L16 3.5l-1.652 2.913L15 10l-2.26-.5L10 13l-2.74-3.5L5 10l.652-3.587L4 3.5l3.61-.077L10 0z\"/></svg>\n          Verified Purchase\n        </span>\n      </div>\n      <img class=\"review-image\" src=\"https://www.trysnow.com/cdn/shop/files/3.0_Diamond-Wired_Review-03A-PattyA.jpg?v=1710189338\" alt=\"Patty A review image\">\n    </div>\n\n    <!-- Card 4 -->\n    <div class=\"review-cell\">\n      <div class=\"review-stars\">★ ★ ★ ★ ★</div>\n      <div class=\"review-title\">ZERO sensitivity</div>\n      <div class=\"review-text\">I quit smoking but couldn’t whiten my teeth until Snow. No pain, just results.</div>\n      <div class=\"review-author\">\n        Patty A.\n        <span class=\"review-verified\">\n          <svg fill=\"currentColor\" viewBox=\"0 0 20 20\"><path d=\"M10 0l2.39 3.423L16 3.5l-1.652 2.913L15 10l-2.26-.5L10 13l-2.74-3.5L5 10l.652-3.587L4 3.5l3.61-.077L10 0z\"/></svg>\n          Verified Purchase\n        </span>\n      </div>\n      <img class=\"review-image\" src=\"https://www.trysnow.com/cdn/shop/files/3.0_Diamond-Wired_Review-03A-PattyA.jpg?v=1710189338\" alt=\"Patty A review image\">\n    </div>\n\n    <!-- Card 5 -->\n    <div class=\"review-cell\">\n      <div class=\"review-stars\">★ ★ ★ ★ ★</div>\n      <div class=\"review-title\">ZERO sensitivity</div>\n      <div class=\"review-text\">I quit smoking but couldn’t whiten my teeth until Snow. No pain, just results.</div>\n      <div class=\"review-author\">\n        Patty A.\n        <span class=\"review-verified\">\n          <svg fill=\"currentColor\" viewBox=\"0 0 20 20\"><path d=\"M10 0l2.39 3.423L16 3.5l-1.652 2.913L15 10l-2.26-.5L10 13l-2.74-3.5L5 10l.652-3.587L4 3.5l3.61-.077L10 0z\"/></svg>\n          Verified Purchase\n        </span>\n      </div>\n      <img class=\"review-image\" src=\"https://www.trysnow.com/cdn/shop/files/3.0_Diamond-Wired_Review-03A-PattyA.jpg?v=1710189338\" alt=\"Patty A review image\">\n    </div>\n\n    <!-- Card 6 -->\n    <div class=\"review-cell\">\n      <div class=\"review-stars\">★ ★ ★ ★ ★</div>\n      <div class=\"review-title\">More affordable than the dentist</div>\n      <div class=\"review-text\">Used it before my wedding. Incredible before/after results for the price!</div>\n      <div class=\"review-author\">\n        Danielle M.\n        <span class=\"review-verified\">\n          <svg fill=\"currentColor\" viewBox=\"0 0 20 20\"><path d=\"M10 0l2.39 3.423L16 3.5l-1.652 2.913L15 10l-2.26-.5L10 13l-2.74-3.5L5 10l.652-3.587L4 3.5l3.61-.077L10 0z\"/></svg>\n          Verified Purchase\n        </span>\n      </div>\n      <img class=\"review-image\" src=\"https://www.trysnow.com/cdn/shop/files/3.0_Diamond-Wired_Review-04-DanielleM.jpg?v=1710189338\" alt=\"Danielle M review image\">\n    </div>\n\n  </div>\n</section>"
      }
