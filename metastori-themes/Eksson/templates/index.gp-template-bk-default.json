        "html_9iM6Ma": {
          "type": "html",
          "settings": {
            "width": "half",
            "code": "<style>\n  .faq-section {\n    max-width: 1000px;\n    margin: 0 auto;\n    padding: 0px 40px;\n    text-align: left;\npadding-bottom:40px;\n  }\n\n  .faq-header {\n    font-size: 20px;\n    font-weight: 700;\n    line-height: 1.2em;\n    letter-spacing: -1px;\n    text-transform: none;\n    margin-bottom: 5px;\n    display: block;\n    margin-left: 15px;\n    text-align: left;\n    color: #;\n  }\n\n  .faq-title {\n    font-size: 28px;\n    font-weight: 700;\n    color: rgb(var(--heading-color));\n    margin-bottom: 20px;\n    letter-spacing: -0.05em;\n    margin-left: 15px;\n  }\n\n  .faq-item {\n    border-top: 1px solid #D9E2EC;\n    padding: 10px 15px 1px 15px;\n    cursor: pointer;\n    transition: background 0.2s ease;\n  }\n\n  .faq-item:last-child {\n    border-bottom: 1px solid #D9E2EC;\n  }\n\n  .faq-question {\n    font-size: 17px;\n    font-weight: 600;\n    display: flex;\n    justify-content: space-between;\n    align-items: center;\n  }\n\n  .faq-answer {\n    max-height: 0;\n    overflow: hidden;\n    transition: max-height 0.3s ease, opacity 0.3s ease;\n    opacity: 0;\n    font-size: 16px;\n    font-weight: 500;\n    line-height: 1.6;\n    margin-top: 5px;\n  }\n\n  .faq-answer.open {\n    opacity: 1;\n    max-height: 500px;\n    padding-bottom: 10px;\n  }\n\n  .faq-answer strong {\n    font-weight: 600;\n  }\n\n  .faq-icon {\n    font-size: 22px;\n    transition: transform 0.3s ease;\n    color: #00B9F1;\n  }\n\n  .faq-item.active .faq-icon {\n    transform: rotate(180deg);\n  }\n\n  @media screen and (max-width: 749px) {\n    .faq-section {\n      padding: 40px 0px;\n    }\n\n    .faq-header {\n      margin-left: 0;\n      padding-left: 4px;\nfont-size:20px;\n\n    }\n\n    .faq-title {\n      margin-left: 0;\n      padding-left: 4px;\nfont-size:26px;\n    }\n\n    .faq-item {\n      padding: 12px 10px 2px 10px;\n    }\n\n    .faq-question {\n      font-size: 17px;\n    }\n\n    .faq-answer {\n      font-size: 15px;\n    }\n  }\n@media screen and (max-width: 749px) {.faq-section {margin-top:-100px;}}\n</style>\n\n<div class=\"faq-section\">\n  <div class=\"faq-header\">You Asked, We Answered</div>\n  <div class=\"faq-title\">Frequently Asked Questions</div>\n\n  <div class=\"faq-item\">\n    <div class=\"faq-question\">\n      What Is IPL?\n      <span class=\"faq-icon\">⌄</span>\n    </div>\n    <div class=\"faq-answer\">\n      IPL (<strong>Intense Pulsed Light</strong>) is a <strong>non-invasive and painless technology</strong>\n      that uses <strong>high-intensity light</strong> to target and <strong>destroy hair follicles</strong>,\n      resulting in <strong>permanent hair reduction</strong>.\n    </div>\n  </div>\n\n  <div class=\"faq-item\">\n    <div class=\"faq-question\">\n      Where Can I Use 5minskin?\n      <span class=\"faq-icon\">⌄</span>\n    </div>\n    <div class=\"faq-answer\">\n      5minskin is safe to use on legs, arms, bikini line, underarms, and even your face (below the cheekbones).\n    </div>\n  </div>\n\n  <div class=\"faq-item\">\n    <div class=\"faq-question\">\n      When Will My Hair Be Gone?\n      <span class=\"faq-icon\">⌄</span>\n    </div>\n    <div class=\"faq-answer\">\n      Most users start seeing noticeable results in 3–4 weeks, with optimal results in 8–12 weeks of consistent use.\n    </div>\n  </div>\n\n  <div class=\"faq-item\">\n    <div class=\"faq-question\">\n      Shipping\n      <span class=\"faq-icon\">⌄</span>\n    </div>\n    <div class=\"faq-answer\">\n      We offer free worldwide shipping. You’ll receive tracking information as soon as your order is dispatched.\n    </div>\n  </div>\n\n  <div class=\"faq-item\">\n    <div class=\"faq-question\">\n      Returns\n      <span class=\"faq-icon\">⌄</span>\n    </div>\n    <div class=\"faq-answer\">\n      We offer a 90-day money-back guarantee. If you're not satisfied, simply return it within 90 days for a full refund.\n    </div>\n  </div>\n\n  <div class=\"faq-item\">\n    <div class=\"faq-question\">\n      Contact Us\n      <span class=\"faq-icon\">⌄</span>\n    </div>\n    <div class=\"faq-answer\">\n      Have more questions? Reach out to our support team at <strong>support@puursmile.com</strong> — we're here to help!\n    </div>\n  </div>\n</div>\n\n<script>\n  document.querySelectorAll('.faq-item').forEach(item => {\n    item.addEventListener('click', () => {\n      const isActive = item.classList.contains('active');\n      document.querySelectorAll('.faq-item').forEach(i => {\n        i.classList.remove('active');\n        i.querySelector('.faq-answer').classList.remove('open');\n      });\n\n      if (!isActive) {\n        item.classList.add('active');\n        item.querySelector('.faq-answer').classList.add('open');\n      }\n    });\n  });\n</script>"
          }
