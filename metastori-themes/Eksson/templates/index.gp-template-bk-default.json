      "settings": {
        "full_width": true,
        "show_space": true,
        "code": "<style>\n  .shieldeck-bug-section {\n    max-width: 1200px;\n    margin: 0 auto;\n    padding: 60px 20px;\n    display: flex;\n    align-items: center;\n    justify-content: space-between;\n    gap: 60px;\n    flex-wrap: wrap;\n    background: #fff;\n  }\n\n  .shieldeck-image {\n    flex: 1;\n    min-width: 300px;\n    margin-bottom: -20px;\n  }\n\n  .shieldeck-image img {\n    width: 100%;\n    border-radius: 20px;\n  }\n\n  .shieldeck-content {\n    flex: 1;\n    min-width: 300px;\n    color: #005994;\n  }\n\n  .shieldeck-content h4 {\n    font-size: 18px;\n    font-weight: 700;\n    color: #005994;\n    margin-bottom: 10px;\n  }\n\n  .shieldeck-content h2 {\n    font-size: 32px;\n    font-weight: 700;\n    color: #0296FF;\n    margin-bottom: 20px;\n    letter-spacing: -0.05em;\n  }\n\n  .shieldeck-content p {\n    font-size: 16px;\n    font-weight: 500;\n    line-height: 1.6;\n    margin-bottom: 14px;\n    color: #005994;\n    letter-spacing: -0.01em;\n  }\n\n  .shieldeck-cta-btn {\n    display: inline-block;\n    margin-top: 10px;\n    background-color: #0296FF;\n    color: white;\n    font-weight: 700;\n    border: none;\n    padding: 14px 28px;\n    border-radius: 999px;\n    font-size: 18px;\n    text-transform: uppercase;\n    transition: 0.2s ease-in-out;\n    text-decoration: none;\n  }\n\n  .shieldeck-cta-btn:hover {\n    opacity: 0.9;\n  }\n\n  @media screen and (max-width: 768px) {\n    .shieldeck-bug-section {\n      flex-direction: column;\n      gap: 40px;\n      padding: 40px 25px;\n    }\n\n    .shieldeck-content h2 {\n      font-size: 26px;\n    }\n\n    .shieldeck-content p {\n      font-size: 16px;\n    }\n\n    .shieldeck-cta-btn {\n      width: 100%;\n      text-align: center;\n    }\n  }\n</style>\n\n<div class=\"shieldeck-bug-section\">\n  <div class=\"shieldeck-image\">\n    <img src=\"https://cdn.shopify.com/s/files/1/0515/2459/9996/files/Noiseless_14_1.jpg?v=1753002590\" alt=\"Shieldeck Insect Trap in use\" loading=\"lazy\" />\n  </div>\n  <div class=\"shieldeck-content\">\n    <h4>We Rethought Bug Control</h4>\n    <h2>Still Spraying in 2025?</h2>\n    <p>Let’s be honest—bug sprays are outdated. They stink, stain, and aren’t safe for pets or kids.</p>\n    <p>Shieldeck changes everything. Just plug it in and enjoy chemical-free, whisper-quiet protection that works around the clock.</p>\n    <p>No zaps. No smells. No bugs. Just peace of mind and a cleaner home.</p>\n    <a class=\"shieldeck-cta-btn\" href=\"collections/bestsellers\">Shop Shieldeck Now</a>\n  </div>\n</div>"
