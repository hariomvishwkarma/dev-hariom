  /* Colors */
  {% for scheme in settings.color_schemes -%}
    {% assign scheme_classes = scheme_classes | append: ', .color-' | append: scheme.id %}
    {% if forloop.index == 1 -%}
      :root,
    {%- endif %}
    .color-{{ scheme.id }} {
      --color-background: {{ scheme.settings.background | color_extract: 'red' }},
      {{ scheme.settings.background | color_extract: 'green' }},
      {{ scheme.settings.background | color_extract: 'blue' }};
      {% if scheme.settings.background_gradient != empty %}
        --gradient-background: {{ scheme.settings.background_gradient }};
      {% else %}
        --gradient-background: {{ scheme.settings.background }};
      {% endif %}
      --secondary-background: {{ scheme.settings.secondary_background | color_extract: 'red' }},
      {{ scheme.settings.secondary_background | color_extract: 'green' }},
      {{ scheme.settings.secondary_background | color_extract: 'blue' }};
      --color-foreground: {{ scheme.settings.text | color_extract: 'red' }},
      {{ scheme.settings.text | color_extract: 'green' }},
      {{ scheme.settings.text | color_extract: 'blue' }};
      --color-accent: {{ scheme.settings.accent | color_extract: 'red' }},
      {{ scheme.settings.accent | color_extract: 'green' }},
      {{ scheme.settings.accent | color_extract: 'blue' }};
      --color-shadow: {{ scheme.settings.shadow | color_extract: 'red' }},
      {{ scheme.settings.shadow | color_extract: 'green' }},
      {{ scheme.settings.shadow | color_extract: 'blue' }};
      --color-borders: {{ scheme.settings.borders | color_extract: 'red' }},
      {{ scheme.settings.borders | color_extract: 'green' }},
      {{ scheme.settings.borders | color_extract: 'blue' }};
      --color-button: {{ scheme.settings.button | color_extract: 'red' }},
      {{ scheme.settings.button | color_extract: 'green' }},
      {{ scheme.settings.button | color_extract: 'blue' }};
      --color-button-text: {{ scheme.settings.button_label | color_extract: 'red' }},
      {{ scheme.settings.button_label | color_extract: 'green' }},
      {{ scheme.settings.button_label | color_extract: 'blue' }};
      --color-secondary-button: {{ scheme.settings.background | color_extract: 'red' }},
      {{ scheme.settings.background | color_extract: 'green' }},
      {{ scheme.settings.background | color_extract: 'blue' }};
      --color-secondary-button-text: {{ scheme.settings.secondary_button_label | color_extract: 'red' }},
      {{ scheme.settings.secondary_button_label | color_extract: 'green' }},
      {{ scheme.settings.secondary_button_label | color_extract: 'blue' }};
      --color-link: {{ scheme.settings.secondary_button_label | color_extract: 'red' }},
      {{ scheme.settings.secondary_button_label | color_extract: 'green' }},
      {{ scheme.settings.secondary_button_label | color_extract: 'blue' }};
      --color-badge-foreground: {{ scheme.settings.text | color_extract: 'red' }},
      {{ scheme.settings.text | color_extract: 'green' }},
      {{ scheme.settings.text | color_extract: 'blue' }};
      --color-badge-background: {{ scheme.settings.background | color_extract: 'red' }},
      {{ scheme.settings.background | color_extract: 'green' }},
      {{ scheme.settings.background | color_extract: 'blue' }};
      --color-badge-border: {{ scheme.settings.text | color_extract: 'red' }},
      {{ scheme.settings.text | color_extract: 'green' }},
      {{ scheme.settings.text | color_extract: 'blue' }};
      --color-shade-1: {{ scheme.settings.shade_1 | color_extract: 'red' }},
      {{ scheme.settings.shade_1 | color_extract: 'green' }},
      {{ scheme.settings.shade_1 | color_extract: 'blue' }};
      --color-shade-2: {{ scheme.settings.shade_2 | color_extract: 'red' }},
      {{ scheme.settings.shade_2 | color_extract: 'green' }},
      {{ scheme.settings.shade_2 | color_extract: 'blue' }};
      --color-shade-3: {{ scheme.settings.shade_3 | color_extract: 'red' }},
      {{ scheme.settings.shade_3 | color_extract: 'green' }},
      {{ scheme.settings.shade_3 | color_extract: 'blue' }};
      --color-alert: {{ scheme.settings.alert | color_extract: 'red' }},
      {{ scheme.settings.alert | color_extract: 'green' }},
      {{ scheme.settings.alert | color_extract: 'blue' }};
      --color-error: {{ scheme.settings.error | color_extract: 'red' }},
      {{ scheme.settings.error | color_extract: 'green' }},
      {{ scheme.settings.error | color_extract: 'blue' }};
      --color-success: {{ scheme.settings.success | color_extract: 'red' }},
      {{ scheme.settings.success | color_extract: 'green' }},
      {{ scheme.settings.success | color_extract: 'blue' }};
      --color-secondary-menu: {{ scheme.settings.secondary_menu_color | color_extract: 'red' }},
      {{ scheme.settings.secondary_menu_color | color_extract: 'green' }},
      {{ scheme.settings.secondary_menu_color | color_extract: 'blue' }};
      --color-tertiary-menu: {{ scheme.settings.tertiary_menu_color | color_extract: 'red' }},
      {{ scheme.settings.tertiary_menu_color | color_extract: 'green' }},
      {{ scheme.settings.tertiary_menu_color | color_extract: 'blue' }};
      --color-black-friday-menu: {{ scheme.settings.black_friday_menu_color | color_extract: 'red' }},
      {{ scheme.settings.black_friday_menu_color | color_extract: 'green' }},
      {{ scheme.settings.black_friday_menu_color | color_extract: 'blue' }};
    }
  {% endfor %}

  {{ scheme_classes | prepend: 'body' }} {
    color: rgba(var(--color-foreground));
    background: rgba(var(--color-background));
    background: var(--gradient-background);
  }

  :root {
    /* COLORS */
    --color-grey-100: #f8f8f8;
    --color-grey-200: #f5f5f5;
    --color-grey-300: #e5e5e5;
    --color-grey-400: #c2c2c2;
    --color-grey-500: #999999;
    --color-grey-600: #666666;
    --color-grey-700: #3c3c3b;

    /* Brands colors */
    --color-light-sage: {{ settings.light_sage | color_extract: 'red' }},
    {{ settings.light_sage | color_extract: 'green' }},
    {{ settings.light_sage | color_extract: 'blue' }};
    --color-island-sea: {{ settings.island_sea | color_extract: 'red' }},
    {{ settings.island_sea | color_extract: 'green' }},
    {{ settings.island_sea | color_extract: 'blue' }};
    --color-dark-green: {{ settings.dark_green | color_extract: 'red' }},
    {{ settings.dark_green | color_extract: 'green' }},
    {{ settings.dark_green | color_extract: 'blue' }};
    --color-violet: {{ settings.violet | color_extract: 'red' }},
    {{ settings.violet | color_extract: 'green' }},
    {{ settings.violet | color_extract: 'blue' }};
    --color-dark-violet: {{ settings.dark_violet | color_extract: 'red' }},
    {{ settings.dark_violet | color_extract: 'green' }},
    {{ settings.dark_violet | color_extract: 'blue' }};
    --color-peri: {{ settings.peri | color_extract: 'red' }},
    {{ settings.peri | color_extract: 'green' }},
    {{ settings.peri | color_extract: 'blue' }};
    --color-ivory: {{ settings.ivory | color_extract: 'red' }},
    {{ settings.ivory | color_extract: 'green' }},
    {{ settings.ivory | color_extract: 'blue' }};
    --color-vanilla: {{ settings.vanilla | color_extract: 'red' }},
    {{ settings.vanilla | color_extract: 'green' }},
    {{ settings.vanilla | color_extract: 'blue' }};
    --color-mocha: {{ settings.mocha | color_extract: 'red' }},
    {{ settings.mocha | color_extract: 'green' }},
    {{ settings.mocha | color_extract: 'blue' }};
    --color-sunset: {{ settings.sunset | color_extract: 'red' }},
    {{ settings.sunset | color_extract: 'green' }},
    {{ settings.sunset | color_extract: 'blue' }};


    /* FONTS */
    --font-body-size: 1rem;
    --font-body-family: "tt-commons-pro"
    , sans-serif;
    --font-body-style: 'normal';
    --font-body-weight: 300;
    --font-body-weight-bold: 600;

    --font-heading-family: "tt-commons-pro", sans-serif;
    --font-heading-style: 'normal';
    --font-heading-weight: 400;

    --font-product-label-family: system-ui, sans-serif;

    --font-body-scale: {{ settings.body_scale | divided_by: 100.0 }};

    /* LAYOUT */
    --border-opacity: {{ settings.border_opacity }};
    --scrollbar-color: {{ settings.scrollbar_color }};
    --scrollbar-background: {{ settings.scrollbar_bg_color }};
    --scrollbar-hover-color: {{ settings.scrollbar_color | color_darken: 5 }};
    --secondary-scrollbar-color: {{ settings.secondary_scrollbar_color }};
    --secondary-scrollbar-background: {{ settings.secondary_scrollbar_bg_color }};
    --brand-night: {{ settings.night_color }};
    --max-blog-text-width: {{ settings.blog_page_width | append: "" }}px;
  }

  {% if settings.enable_custom_scrollbar %}
    /* CUSTOM SCROLLBAR */
    /* width */
    ::-webkit-scrollbar {
      height: 4px;
      width: 4px;
    }
    /* Track */
    ::-webkit-scrollbar-track {
      background: var(--scrollbar-background);
      border-radius: 50px;
    }
    /* Handle */
    ::-webkit-scrollbar-thumb {
      background: var(--scrollbar-color);
      border-radius: 50px;
    }
    /* Handle on hover */
    ::-webkit-scrollbar-thumb:hover {
      background: var(--scrollbar-hover-color);
    }
  {% endif %}
</style>
