{%- comment -%}
  Renders a accordion

  Accepts:
    - accordion_id {String}: sets the id of the accordion
    - accordion_label {String}: sets the label of the toggle button
    - accordion_label_class
    - accordion_label_padding
    - accordion_label_tag {String}: set the tag for the label. default is span
    - accordion_icon_classes
    - accordion_menu_icon {Boolean}: if accordion uses menu icon
    - accordion_icon {String}: sets the icon of the accordion
    - accordion_content {String}: sets the content of the accordion
    - accordion_content_class {String}: sets the class of the accordion content
    - accordion_content_tag {String}: set the tag for the content section. default is div
    - accordion_borders {Boolean}: sets borders if value is true
    - accordion_hide_border_bottom {Boolean}: hides border bottom if value is true
    - accordion_hide_border_top {Boolean}: hides border top if value is true
    - extra_classes {String}: sets extra classes
    - index {String}: sets the index of the accordion
    - open_on_load {Boolean}:

  Usage:
    {% render 'c-accordion' %}
{%- endcomment -%}

{%- assign full_width_section = full_width_section -%}

{% capture icon_classes %}
  {{ accordion_icon_classes | default: 'ml-auto !w-3 !h-3 ' }}
{% endcapture %}

<details
  class="
    accordion js-filter {{ accordion_label_padding | default: ' py-6 ' }}{% if accordion_borders %} border-y border-borders {% endif %}
    {%  if accordion_hide_border_bottom %} border-b-0  {% endif %}
    {%  if accordion_hide_border_top %} border-t-0 {% endif %}
  "
  data-index="{{ index }}"
  {% if open_on_load %}
    open
  {% endif %}
>
  <summary class="{{ extra_classes }}">
    <div class="flex items-center">
      {% if accordion_menu_icon %}
        {% render 'c-menu-icon', icon: accordion_icon, extra_classes: 'mr-2' %}
      {% endif %}
      <{{ accordion_label_tag | default: "span" }} class="{{ accordion_label_class | default: 'h5' }} {% if full_width_section == false %}pr-4{% endif %}">
        {{- accordion_label -}}
      </{{ accordion_label_tag | default: "span" }}>
      {% render 'c-icon', icon: 'arrow-down', extra_classes: icon_classes %}
    </div>
  </summary>

  <{{ accordion_content_tag | default: "div" }} class="{{ accordion_content_class | default: 'pt-3.5 paragraph-3' }}">
    {% if accordion_image != blank %}
      <div class="flex flex-col gap-4">
        {{- accordion_content -}}
        {% render 'c-image', image: accordion_image, lazy: true, classes: 'w-[50%] mx-auto' %}
      </div>
    {% else %}
      {{- accordion_content -}}
    {% endif %}
  </{{ accordion_content_tag | default: "div" }}>
</details>
