{% comment %}
  Render a sticky menu at the bottom of the mobile menu drawer.

  Accepts:
    - sticky_menu {Object}: a menu object
    - icons {String}: a comma-separated list of icons to use for each menu item

  Usage:
    {% render 'sticky-menu', sticky_menu: menu, icons: icons %}
{% endcomment %}

{% assign menu_items = sticky_menu.links %}

{% if menu_items.size > 0 %}
  {% assign menu_icons = icons | split: ',' %}

  <nav class="sticky bottom-0 left-0 right-0 w-full mt-auto bg-shade-3 p-3">
    <div class="flex justify-around items-center z-5">
      {%- for item in menu_items -%}
        {% if item.links == blank or customer == blank and item.handle == 'my-account' %}
          <a href="{{ item.url }}" class="flex flex-col gap-0.5 items-center">
            {%- render 'c-icon', icon: menu_icons[forloop.index0], classes: 'w-6 h-6' -%}
            <span class="h5">{{- item.title -}}</span>
          </a>
        {% else %}
          <span
            onclick="document.getElementById('sticky-{{item.handle}}')?.click()"
            class="flex flex-col gap-0.5 items-center cursor-pointer"
          >
            {%- render 'c-icon', icon: menu_icons[forloop.index0], classes: 'w-6 h-6' -%}
            <span class="h5">{{- item.title -}}</span>
          </span>
        {% endif %}
      {%- endfor -%}
    </div>
  </nav>
{% endif %}
