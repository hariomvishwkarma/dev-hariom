{%- comment -%}
  Renders the promo block

  Accepts:
    - image {object}: the image object
    - text {string}: the text of the promo block
    - url {string}: the url of the promo block
    - aspect_ratio {string}: aspect ratio to use for the image container
    - classes {string}: additional classes to add to the promo block
    - stretch {string}: stretch the image to fill the container
    - alignment {string}: determines the placement of the promo block content - split on first space, setting the first as align-items and second as justify-content, eg: top right
    - text_color {string}
    - font_size {int}
    - cta_text {string}
    - cta_type {string}
  Usage:
    {% render 'menu-promo-block' %}
{%- endcomment -%}

{% assign align = alignment | split: ' ' | first %}
{% assign justify = alignment | split: ' ' | last %}
{% assign wrap_align_class = 'items-' | append: align | replace: 'bottom', 'end' | replace: 'top', 'start' %}
{% assign wrap_justify_class = 'justify-' | append: justify | replace: 'right', 'end' | replace: 'left', 'start' %}
{% assign text_align_class = 'text-' | append: justify %}
{% assign content_align_class = 'items-' | append: justify | replace: 'right', 'end' | replace: 'left', 'start' %}

{% if url != empty and url != blank %}
  <a href="{{ url }}" class="relative {{ classes }}">
{% else %}
  <div class="relative {{ classes }}">
{% endif %}

{% if stretch %} {% assign image_classes = 'w-full h-full' %} {% endif %}
{% render 'c-image', image: image, aspect_ratio: aspect_ratio, classes: image_classes, lazy: 'lazy' %}
<div class="absolute h-full w-full top-0 bottom-0 left-0 right-0 py-8 px-4 flex {{ wrap_align_class }} {{ wrap_justify_class }}">
  <div
    style="--custom-color: {% if text_color %}{{ text_color }}{% else %}rgb(var(--color-background)){% endif %}; {% if font_size %}--custom-size: {{font_size}}px;{% endif %}"
    class="flex flex-col gap-4 {{ text_align_class }} {{ content_align_class }}"
  >
    {% render 'c-title',
      content: text,
      custom_tag: 'h6',
      classes: 'mb-0 text-3 text-[var(--custom-color)] custom-text-size !leading-none'
    %}
    {% if url and cta_type and cta_text %}
      {% render 'c-text', content: cta_text, classes: 'underline text-[var(--custom-color)]' %}
    {% endif %}
  </div>
</div>

{% if url != empty and url != blank %}
  </a>
{% else %}
  </div>
{% endif %}
