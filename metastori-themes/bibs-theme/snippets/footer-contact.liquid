{%- comment -%}
  Renders footer contact, part of footer components

  Accepts:
    - block: {Object} settings for the current block
    - classes: {string} single or multiple classes
  Usage:
    {% render 'footer-contact', block: block.settings, class: 'basis-2/5' %}
{%- endcomment -%}

{% assign phone_link = 'tel:' | append: block.footer_phone_number %}

<div class="{{ classes }} min-w-[176px]">
  {% if section.settings.logo and section.settings.contact_logo %}
    {% render 'c-image',
      image: section.settings.logo,
      classes: 'h-6 lg:h-8 w-full mb-12',
      image_classes: 'h-full !object-contain object-left'
    %}
  {% endif %}

  {% render 'c-text', translatable_content: 'footer.contact_us', type: 'h6', classes: 'text-xl mb-6' %}

  <div class="flex flex-col gap-2 lg:gap-3.5 lg:items-start">
    {% capture cs_content %}
      <div class="flex flex-row gap-1.5 items-end">
        {% render 'c-icon', icon: 'customer-service', classes: 'w-4' %}
        {% render 'c-text', translatable_content: 'footer.customer_service', classes: 'paragraph-3' %}
      </div>
    {% endcapture %}
    {% capture phone_content %}
      <div class="flex flex-row gap-1.5 items-center">
        {% render 'c-icon', icon: 'phone', classes: 'w-3.5 h-3.5' %}
        {% render 'c-text', content: block.footer_phone_number, classes: 'paragraph-3' %}
      </div>
    {% endcapture %}

    {% liquid
      if block.footer_cs_link
        render 'c-link', href: block.footer_cs_link, content: cs_content
      endif
      if block.footer_phone_number != blank
        render 'c-link', href: phone_link, classes: 'link--hover', type: 'link', content: phone_content
      endif
      if block.footer_email != blank
        render 'c-link', href: phone_link, classes: 'link--hover paragraph-3', type: 'link', content: block.footer_email
      endif
      if block.footer_opening_hours != blank
        render 'c-text', content: block.footer_opening_hours, classes: 'paragraph-3'
      endif
      if block.footer_company_address != blank
        render 'c-richtext', content: block.footer_company_address, classes: 'paragraph-3'
      endif
      if block.footer_cvr != blank
        render 'c-text', content: block.footer_cvr, classes: 'paragraph-3'
      endif
      if block.markets_switcher
        render 'markets-switcher'
      endif
    %}
  </div>
</div>
