{% comment %}
  Renders a line
  Accepts:
    - margin_bottom {string}: accepts none, normal, large
    - color_scheme {string}: accepts background-1, background-2, background-3, background-4
    - no_container {boolean}: if true, the line will not be wrapped in a container

  Usage:
    {% render 'line', margin_bottom: 'none' %}
{% endcomment %}

<div class="line color-{{ color_scheme }}">
  <div class="bg-background">
    <div
      {% unless no_container %}
        class="container-fluid"
      {% endunless %}
    >
      <hr class="border-borders">
    </div>
  </div>
  {% render 'divider', height: margin_bottom, color_scheme: section.settings.color_scheme %}
</div>
