{%- comment -%}
  Renders a search bar with a search button and a search input field.

  Accepts:
    - is_search_page (boolean): Whether the search bar is being rendered on the search page.
    - classes

  Usage:
    {% render 'search-bar' %}
{%- endcomment -%}

{% liquid
  assign color_scheme = block.settings.color_scheme

  capture search_icon
    render 'c-icon', icon: 'search', classes: 'w-5 h-5'
  endcapture
%}

{% style %}
  :root {
    --logo-width: {{ block.settings.logo_width | default: '154' -}}px;
  }
{% endstyle %}

{%- capture search_form -%}
    <form action="{{ routes.search_url }}" method="get" class="flex-1 color-{{ color_scheme }}">
      <div class="relative px-7.5 search-wrap">
        {% liquid
          assign input_placeholder = ''
          assign input_classes = 'clear_input pl-2'
          assign btn_classes = 'absolute inset-y-0.5 left-0.5 flex aspect-square items-center justify-center text-foreground'

          render 'c-input', input_type: 'checkbox', input_name: 'type', input_value: 'article', id: 'type', input_container_classes: 'hidden', custom_attributes: 'checked'
          render 'c-input', input_type: 'search', input_name: 'q', input_value: search.terms, input_placeholder: input_placeholder, input_classes: input_classes
          render 'c-button', type: 'submit', design: 'link--bg_no-padding', content: search_icon, classes: btn_classes
        %}
      </div>
    </form>
{%- endcapture -%}

<div class="flex-1 block max-w-[208px] relative border border-borders rounded-full md:ml-auto">
  {{ search_form }}
</div>
