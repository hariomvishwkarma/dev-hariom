<div
  class="blog-tag-filters mt-4 md:mt-5 border-b border-t border-borders"
  data-section-id="shopify-section-{{ section.id }}"
>
  <div class="container-fluid--l flex overflow-x-auto no-scrollbar-mobile gap-2 py-4">
    {% liquid
      assign tag_icons = shop.metaobjects.blog_filter_icons
    %}

    <span class="{% unless current_tags.size > 0 %}selected{% endunless %}">
      <a
        href="{{ blog.url }}"
        class="no-underline"
      >
        {{ 'blog.all' | t }}
      </a>
    </span>

    {% for tag in blog.all_tags %}
      {% liquid
        assign classes = ''
        if current_tags contains tag
          assign classes = classes | append: ' selected'
        endif
        if forloop.last
          assign classes = classes | append: ' mr-[30px]'
        endif
      %}

      {% assign tag_edit = tag | replace: 'guides_', '' | downcase %}
      {% capture close_icon %}
        {% render 'c-icon', icon: 'close', classes: 'h-2 w-2 icon-close' %}
      {% endcapture %}
      {% capture label_icon %}  
        {% for value in tag_icons.values %}
          {% assign filter_name_downcase = value.blog_filter | downcase %}
          {% if filter_name_downcase == tag_edit %}
            {% render 'c-richtext', content: value.icon.value.icon, classes: 'w-4 h-4' %}
          {% endif %}
        {% endfor %}
      {% endcapture %}

      <span class="{{ classes }}">
        {%- if current_tags contains tag -%}
          {{- tag | remove: 'guides_' | append: close_icon | prepend: label_icon | link_to_remove_tag: tag -}}
        {%- else -%}
          {{- tag | remove: 'guides_' | append: close_icon | prepend: label_icon | link_to_add_tag: tag -}}
        {%- endif -%}
      </span>
    {% endfor %}
  </div>
</div>
