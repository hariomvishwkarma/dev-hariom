{%- comment -%}
  Renders a localization item
  Accepts:
    - current_market_obj {Object}: Current market object from metaobjects (for backward compatibility)
    - market {Object}: Native Shopify market object
    - hide_name {boolean}: Hides the name of the current market
    - hide_icon {boolean}: Hides the icon of the current market
    - display_language {boolean}: Displays the language of the current market

  Usage:
    {% render 'localization-item', market: localization.market %}
{%- endcomment -%}

{%- comment -%} Display flag - prefer metaobject flag, fallback to native market {%- endcomment -%}
{%- if current_market_obj.flag != blank -%}
  {% render 'c-image',
    image: current_market_obj.flag,
    image_width: 100,
    aspect_ratio: 'square',
    classes: 'w-4 h-4 rounded-full overflow-hidden',
    lazy: 'lazy'
  %}
{%- elsif market -%}
  {%- comment -%} You could add a default flag system here based on market.primary_locale.country {%- endcomment -%}
{%- endif -%}

{%- unless hide_name -%}
  <span class="text-xs">
    {%- if display_language -%}
      {%- if current_market_obj.language -%}
        {{- current_market_obj.language -}}
      {%- elsif market -%}
        {{- market.primary_locale.name -}}
      {%- endif -%}
    {%- else -%}
      {%- if current_market_obj.name -%}
        {{- current_market_obj.name -}}
      {%- elsif market -%}
        {{- market.name -}}
      {%- endif -%}
    {%- endif -%}
  </span>
{%- endunless -%}

{%- unless hide_icon -%}
  {% render 'c-icon', icon: 'arrow-down', classes: 'w-2 ml-1 rounded-full overflow-hidden' %}
{%- endunless -%}
