{%- comment -%}
  Renders a usp icon based on the icon name.

  Accepts:
    - icon (required)
    - classes (optional)
    - extra_classes (optional)
    - color (optional)

  Usage:
    {% render 'c-usp-icon' %}
{%- endcomment -%}

{%- unless classes -%}
  {%- assign classes = 'icon icon-' | append: icon -%}
{%- endunless -%}

