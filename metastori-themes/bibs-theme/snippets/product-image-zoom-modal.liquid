{%- comment -%}
  Renders product media zoom modal

  Accepts:
    - product {Object}: Product object

  Usage:
    {% render 'product-media-zoom-modal', product: product %}
{%- endcomment -%}

{%- capture swiper_options -%}
  {
    "slidesPerView": 1,
    "loop": true,
    "fadeEffect": {
      "crossFade": true
    },
    "autoHeight": true,
    "speed": 1,
    "keyboard": {
      "enabled": true
    },
    "pagination": {
      "enabled": true,
      "el": ".swiper-pagination",
      "type": "fraction"
    },
    "navigation": {
      "nextEl": ".swiper-button-next",
      "prevEl": ".swiper-button-prev"
    },
    "thumbs": {
      "swiper": {
        "el": ".swiper.mySwiper2[thumbsSlider]",
        "slidesPerView": 6,
        "spaceBetween": 8,
        "grid": {
          "rows": 5,
          "fill": "row"
        }
      }
    },
    "breakpoints": {
      "768": {
        "pagination": {
          "enabled": false
        }
      }
    }
  }
{%- endcapture -%}

{%- capture swiper_attribute -%}
  data-swiper='{{- swiper_options -}}'
{%- endcapture -%}

{%- capture image_popup_gallery -%}
  <div class="flex items-center justify-center min-h-full">
    <div thumbsSlider class="swiper mySwiper2 !hidden md:!block w-full max-w-[280]">
      <div class="swiper-wrapper">
        {% render 'product-media-gallery-items', product: product %}
      </div>
    </div>
    <div class="swiper w-full h-full !pb-0" {{ swiper_attribute }}>
      <div class="swiper-wrapper">
        {% render 'product-media-gallery-items', product: product, zoom_type: 'click', aspect_ratio: 'auto', media_fit: 'contain' %}
      </div>
      <div class="swiper-button-next">{% render 'c-icon', icon: 'arrow-right', classes: "!w-6 !h-6" %}</div>
      <div class="swiper-button-prev">{% render 'c-icon', icon: 'flat-arrow-left', classes: "!w-6 !h-6" %}</div>
      <div class="swiper-pagination"></div>
    </div>
  </div>
{%- endcapture -%}

{%- render 'c-modal',
  modal_id: 'Media-gallery-popup',
  modal_content: image_popup_gallery,
  modal_size: 'full',
  close_classes: 'z-10',
  placement: 'top-center',
  modal_classes: '!overflow-hidden'
-%}
