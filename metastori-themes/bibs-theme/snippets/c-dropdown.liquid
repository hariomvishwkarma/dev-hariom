{%- comment -%}
  Renders a dropdown

  Accepts:
    - dropdown_id {String}: sets the id of the dropdown
    - dropdown_content {String}: sets the content of the dropdown
    - dropdown_type {String}: sets the type of the dropdown (primary, secondary, link)
    - dropdown_content_class {String}: sets the class of the dropdown content
    - dropdown_delay {String}: sets the delay of the dropdown (0, 100, 200, 300, 400, 500)
    - dropdown_offset {String}: sets the offset of the dropdown
    - dropdown_icon {String}: sets the icon of the dropdown
    - hide_dropdown_icon {Boolean}: sets whether to hide the dropdown icon
    - toggle_label {String}: sets the label of the toggle button
    - trigger_type {String}: sets the type of the trigger (click, hover, none)
    - content_placement {String}: sets the placement of the dropdown content (top, top-start, top-end, bottom-start, bottom, bottom-end, left-start, left, left-end, right-start, right, right-end)
    - classes {String}: dropdown classes
    - use_menu_icon {Boolean}: sets whether to use menu icon

  Usage:
    {% render 'c-dropdown' %}
{%- endcomment -%}

{% liquid
  case dropdown_type
    when 'primary'
      assign dropdown_class = 'button--primary'
    when 'secondary'
      assign dropdown_class = 'button--secondary'
    when 'menu'
      assign dropdown_class = 'link--menu'
    when 'link'
      assign dropdown_class = 'link--hover'
    else
      assign dropdown_class = ''
  endcase

  assign dropdown_icon = dropdown_icon | default: 'arrow-down'
%}

<c-dropdown
  data-dropdown-id="{{ dropdown_id }}"
  data-trigger-type="{{ trigger_type | default: 'click' }}"
  data-dropdown-delay="{{ dropdown_delay }}"
  data-dropdown-offset="{{ dropdown_offset }}"
  data-dropdown-placement="{{ content_placement | default: 'bottom' }}"
  class="{{ classes }}"
>
  <div
    class="{% unless hide_dropdown_icon %}relative first-child:pr-4{% endunless %} {{ dropdown_class }}"
    data-dropdown-toggle
  >
    {{ toggle_label }}
    {%- unless hide_dropdown_icon -%}
      {% render 'c-icon',
        icon: dropdown_icon,
        classes: 'w-4 h-4 absolute right-0 top-[50%] translate-y-[-50%] pointer-events-none'
      %}
    {%- endunless -%}
  </div>
  <div
    data-dropdown-content
    class="{{ dropdown_content_class }} z-10 hidden font-normal bg-background divide-y divide-grey-100 mt-1"
  >
    {{ dropdown_content }}
  </div>
</c-dropdown>
