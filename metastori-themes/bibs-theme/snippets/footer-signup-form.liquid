{% assign klaviyo_forms = metaobjects.klaviyo_footer_signup_forms.values %}
{% assign market = localization.country.iso_code | upcase | default: 'IE' %}

{% for form in klaviyo_forms %}
  {% assign country_code_upcase = form.country_code | upcase %}
  {% if market == country_code_upcase %}
    <div class="klaviyo-form-{{ form.form_id }}"></div>
  {% endif %}
{% endfor %}
