{%- comment -%}
  Renders a logo image or shop name as a link to the homepage.

  Accepts:
    - block {Object}: The block object
    - classes {String}: Additional classes to add to the logo link
    - styles {String}: Additional styles to add to the logo link

  Usage:
    {% render 'logo', block: block %}
{%- endcomment -%}

<a
  href="{{ routes.root_url }}"
  class="{{ classes }}"
  {% if styles != blank %}
    style="{{ styles }}"
  {% endif %}
>
  {%- assign logo_image = block.settings.logo | default: block.settings.logo_alt -%}
  {% if logo_image %}
    {% render 'c-image', image: logo_image %}
  {% else %}
    <span class="text-3xl font-bold">{{ shop.name }}</span>
  {% endif %}
</a>
