{%- comment -%}
  Renders a cart item count component

  Accepts:


  Usage:
    {% render 'cart-item-count' %}
{%- endcomment -%}

{% liquid
  assign cart_bubble_classes = 'text-cart_count'
  if cart == empty
    assign cart_bubble_classes = cart_bubble_classes | append: ' !hidden'
  endif
  render 'c-text', content: cart.item_count, custom_tag: 'span', classes: cart_bubble_classes
%}
