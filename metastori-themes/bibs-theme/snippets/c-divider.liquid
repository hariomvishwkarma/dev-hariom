{%- comment -%}
  Renders a divider component

  Accepts:
    - type {String}: The type of divider to render.
    - classes {String}: Additional classes to add to the divider.

  Usage:
    {% render 'c-divider' %}
{%- endcomment -%}

{% liquid
  case type
    when 'primary-bold'
      assign type_classes = 'border-b-4 border-foreground'

    when 'primary-thin'
      assign type_classes = 'border-foreground'

    when 'primary-dark-thin'
      assign type_classes = 'border-shade-3'

    when 'white-bold'
      assign type_classes = 'border-4 border-white'

    when 'white-thin'
      assign type_classes = 'border-white'

    else
      assign type_classes = 'border-borders'
  endcase
%}

<hr class="{{ type_classes }} {{ classes }}">
