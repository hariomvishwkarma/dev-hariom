{%- comment -%}
  Renders a slider component

  Accepts:
    - slider_id {String}: sets the id of the slider
    - toggle_label {String}: sets the toggle label of the slider
    - slides {Array}: sets the slides of the slider
    - hide_dots {Boolean}: sets whether the dots are enabled or not (Default: false)
    - hide_controls {Boolean}: sets whether the controls are enabled or not (Default: false)
    - auto_play {Boolean}: sets whether the slider auto plays or not (Default: false)
    - interval {Number}: sets the interval of the slider (Default: 5000)
    - height {String}: sets the height of the slider (Default: 'h-[90vh]')
      [Note: Use classes for the height]

  Usage:
    {% render 'c-slider' %}
{%- endcomment -%}

<c-slider
  data-carousel-id="{{ slider_id }}"
  data-carousel="{% if auto_play %}slide{% else %}static{% endif %}"
  data-carousel-interval="{{ interval }}"
>
  <div class="relative w-full">
    <!-- Carousel wrapper -->
    <div class="relative {{ height | default: 'h-[90vh]' }} overflow-hidden rounded">
      {% if slides.size %}
        {% for slide in slides %}
          {%- assign slide_image = slide.settings.image -%}
          <div
            class="hidden duration-700 ease-in-out absolute inset-0 transition-transform transform"
            data-carousel-item
          >
            {% render 'c-image',
              image: slide_image,
              class: 'absolute block w-full -translate-x-1/2 -translate-y-1/2 top-1/2 left-1/2'
            %}
          </div>
        {% endfor %}
      {% else %}
        {% for slide in (1..5) %}
          <div
            class="hidden duration-700 ease-in-out absolute inset-0 transition-transform transform"
            data-carousel-item
          >
            {% render 'c-image', class: 'absolute block w-full -translate-x-1/2 -translate-y-1/2 top-1/2 left-1/2' %}
          </div>
        {% endfor %}
      {% endif %}
    </div>

    <!-- Slider indicators -->
    <!--
      Dots from: 'bg-white/50 hover:bg-white ring-black/30'
      To: 'bg-black/30 ring-white/50'
    -->
    {% unless hide_dots %}
      <div class="absolute z-30 flex items-center space-x-3 -translate-x-1/2 bottom-5 left-1/2">
        {% if slides.size %}
          {% for slide in slides %}
            <button
              type="button"
              class="w-3 h-3 rounded-full ring-2"
              aria-current="true"
              data-carousel-slide-to="{{ forloop.index0 }}"
            ></button>
          {% endfor %}
        {% else %}
          {% for slide in (1..5) %}
            <button
              type="button"
              class="w-3 h-3 rounded-full ring-2"
              aria-current="true"
              data-carousel-slide-to="{{ forloop.index0 }}"
            ></button>
          {% endfor %}
        {% endif %}
      </div>
    {% endunless %}

    <!-- Slider controls -->
    {% unless hide_controls %}
      <button
        type="button"
        class="absolute top-0 left-0 z-30 flex items-center justify-center h-full px-4 cursor-pointer group focus:outline-none"
        data-carousel-prev
      >
        <span class="inline-flex items-center justify-center w-8 h-8 rounded-full sm:w-10 sm:h-10 bg-black/30 group-focus:ring-2 group-hover:bg-black/50 group-focus:ring-black/40 group-focus:outline-none">
          {% render 'c-icon', icon: 'flat-arrow-left', classes: 'w-5 h-5 text-background sm:w-6 sm:h-6' %}
          <span class="sr-only">Previous</span>
        </span>
      </button>
      <button
        type="button"
        class="absolute top-0 right-0 z-30 flex items-center justify-center h-full px-4 cursor-pointer group focus:outline-none"
        data-carousel-next
      >
        <span class="inline-flex items-center justify-center w-8 h-8 rounded-full sm:w-10 sm:h-10 bg-black/30 group-hover:bg-black/50 group-focus:ring-black/40 group-focus:outline-none">
          {% render 'c-icon', icon: 'arrow-right', classes: 'w-5 h-5 text-background sm:w-6 sm:h-6' %}
          <span class="sr-only">Next</span>
        </span>
      </button>
    {% endunless %}
  </div>
</c-slider>
