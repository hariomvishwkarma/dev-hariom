{% doc %}
  @param {string} headline - FAQ Headline
  @param {string} content - FAQ Content
  @param {string} image - FAQ Image

  @example
  {% render 'faq', headline: faq_headline, content: faq_content %}
{% enddoc %}

{% render 'c-accordion',
  accordion_label: headline,
  accordion_content: content,
  accordion_label_padding: 'py-6',
  accordion_label_class: 'text-xl border-bottom border-borders',
  accordion_hide_border_top: true,
  accordion_borders: true,
  accordion_label_tag: 'h3',
  accordion_content_class: 'p-4',
  accordion_content_tag: 'p',
  accordion_image: image
%}
