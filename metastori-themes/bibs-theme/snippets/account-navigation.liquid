{%- comment -%}
  Renders a list of orders for a customer.

  Usage:
    {% render 'account-navigation' %}
{%- endcomment -%}

<h1 class="md:basis-full">{{ 'customer.account.greeting' | t: customerName: customer.name }}</h1>
<div class="mt-6 md:mt-10 flex md:flex-col gap-8 overflow-x-auto no-scrollbar md:basis-60">
  {%- for link in linklists['account-menu'].links -%}
    {% assign activeLink = false %}
    {% if template.suffix %}
      {% capture param %}?view={{ template.suffix }}{% endcapture %}
      {% if link.url contains template.suffix %}
        {% assign activeLink = true %}
      {% endif %}
    {% else %}
      {% if link.active %}
        {% assign activeLink = true %}
      {% endif %}
    {% endif %}

    {% assign link_classes = 'h7-bold whitespace-nowrap leading-4' %}
    <span>
      {% if activeLink %}
        {% assign link_classes = link_classes | append: ' active' %}
        {% assign active_nav_title = link.title %}
      {% endif %}
      {%- render 'c-link', href: link.url, content: link.title, type: 'link--menu', classes: link_classes -%}
    </span>
  {%- endfor -%}
</div>
