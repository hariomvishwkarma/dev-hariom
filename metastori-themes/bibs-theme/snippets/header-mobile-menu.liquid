{%- comment -%}
  Renders the header burger menu for mobile

  Accepts:
    - menu: the menu to render

  Usage:
    {% render 'header-mobile-menu', block: block %}
{%- endcomment -%}

{% liquid
  assign color_scheme = block.settings.color_scheme
  assign color_scheme_class = 'overflow-auto no-scrollbar color-' | append: color_scheme

  assign menu_blocks = section.blocks
%}

{%- capture toggle_label -%}
  {% render 'c-icon', icon: 'burger-menu', classes: 'w-6 h-6' %}
{%- endcapture -%}

{%- capture drawer_content -%}
  <div class="absolute top-4 right-5 z-50">
    {% liquid 
    capture button_content
    render 'c-icon', icon: 'close', classes: 'w-3 h-3'
    endcapture
    render 'c-button', design: 'link--bg', content: button_content, custom_attributes: 'data-drawer-close aria-label="Close menu"', classes: 'px-2 py-2 inline-flex items-center justify-end'
    %}
  </div>

  {%- if menu_blocks.size > 0 -%}
    <div class="px-4 py-2">
      {% liquid
        for new_block in menu_blocks
          if new_block.type == 'menu'
            render 'header-mobile-menu-item', block: new_block
          endif

          if new_block.type == 'mobile-menu'
            render 'header-mobile-menu-item', block: new_block, sticky: true
          endif

          if new_block.type == 'mobile-menu-secondary'
            assign footer_menu = new_block
          endif

          if new_block.type == 'brands-menu'
            render 'brands-mobile-menu', block: new_block
          endif
        endfor
      %}
    </div>
  {%- endif -%}

  {% render 'header-mobile-menu-item', block: footer_menu, secondary: true %}
  {% assign promo_block_top = shop.metaobjects.menu_promo_block['mobile-menu-top'] %}
  {% assign promo_block_bottom = shop.metaobjects.menu_promo_block['mobile-menu-bottom'] %}
  {%- if promo_block_top or promo_block_bottom -%}
    <div  class="px-4 mt-4 pb-8">
      {%- if promo_block_top -%}
        {% render 'menu-promo-block',
          image: promo_block_top.image,
          text: promo_block_top.text,
          url: promo_block_top.url,
          aspect_ratio: promo_block_top.aspect_ratio,
          stretch: true,
          alignment: promo_block_top.content_alignement,
          text_color: promo_block_top.text_color,
          font_size: promo_block_top.font_size,
          cta_text: promo_block_top.cta_text,
          cta_type: promo_block_top.cta_type,
          classes: 'mb-2'
        %}
      {%- endif -%}

      {%- if promo_block_bottom -%}
        {% render 'menu-promo-block',
          image: promo_block_bottom.image,
          text: promo_block_bottom.text,
          url: promo_block_bottom.url,
          aspect_ratio: promo_block_bottom.aspect_ratio,
          stretch: true,
          alignment: promo_block_bottom.content_alignement,
          text_color: promo_block_bottom.text_color,
          font_size: promo_block_bottom.font_size,
          cta_text: promo_block_bottom.cta_text,
          cta_type: promo_block_bottom.cta_type,
          classes: 'mb-2'
        %}
      {%- endif -%}
    </div>
  {%- endif -%}

{%- endcapture -%}
{% capture drawer_footer %}
{% endcapture %}

{% render 'c-drawer',
  drawer_id: 'Mobile-menu-drawer',
  toggle_label: toggle_label,
  toggle_type: 'link--bg',
  toggle_aria_label: 'Menu',
  drawer_header_classes: 'bg-background text-foreground',
  drawer_header_menu_padding: true,
  drawer_content: drawer_content,
  drawer_footer: drawer_footer,
  drawer_width: 'lg',
  classes: 'flex lg:hidden mr-4',
  drawer_classes: color_scheme_class,
  drawer_placement: 'below-header',
  hide_close_button: true,
  header_menu: true,
  drawer_backdrop: false,
  drawer_content_classes: 'border-t border-borders  relative'
%}
