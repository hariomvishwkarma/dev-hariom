<script type="application/ld+json">
{
  "@context": "http://schema.org/",
  "@type": "Product",
  "name": {{ product.title | json }},
  "url": {{ shop.url | append: product.url | json }}{% if product.featured_media.preview_image or product.description != blank or current_variant.sku != blank or product.vendor != blank or current_variant.barcode != blank %},{% endif %}
  {% if product.featured_media.preview_image %}
  "image": {
    "@type": "ImageObject",
    "url": {{ product.featured_media.preview_image.src | img_url: 'master' | prepend: "https:" | json }}
  }{% if product.description != blank or current_variant.sku != blank or product.vendor != blank or current_variant.barcode != blank %},{% endif %}
  {% endif %}
  {%- if product.description != blank -%}
    "description": {{ product.description | strip_html | json }}{% if current_variant.sku != blank or product.vendor != blank or current_variant.barcode != blank %},{% endif %}
  {%- endif -%}
  {%- if current_variant.sku != blank -%}
    "sku": {{ current_variant.sku | json }}{% if product.vendor != blank or current_variant.barcode != blank %},{% endif %}
  {%- endif -%}
  {%- if product.vendor != blank -%}
    "brand": {
      "@type": "Brand",
      "name": {{ product.vendor | json }}
    }{% if current_variant.barcode != blank %},{% endif %}
  {%- endif -%}
  {%- if current_variant.barcode != blank -%}
    "mpn": {{ current_variant.barcode | json }}
  {%- endif -%},
  "offers": [
    {%- for variant in product.variants -%}
    {
      "@type": "Offer",
      {%- if variant.sku != blank -%}
        "sku": {{ variant.sku | json }},
      {%- endif -%}
      "availability": "http://schema.org/{% if variant.available %}InStock{% else %}OutOfStock{% endif %}",
      "price": {{ variant.price | divided_by: 100.0 | json }},
      "priceCurrency": {{ cart.currency.iso_code | default: shop.currency | json }},
      "url": {{ shop.url | append: variant.url | json }},
      "seller": {
        "@type": "Organization",
        "name": {{ shop.name | json }}
      },
      "hasMerchantReturnPolicy": {
        "@type": "MerchantReturnPolicy",
        "applicableCountry": ["US","AU","CA","DK","FI","FR","DE","IE","IT","HR","NL","PL","PT","ES","SE","GB","RO","SI","CZ","GR","HU","LV"],
        "returnPolicyCategory": "https://schema.org/MerchantReturnFiniteReturnWindow",
        "merchantReturnDays": 30,
        "returnMethod": "https://schema.org/ReturnByMail",
        "returnFees": "https://schema.org/ReturnFeesCustomerResponsibility"
      },
      "shippingDetails": [
        {
          "@type": "OfferShippingDetails",
          "shippingRate": { "@type": "MonetaryAmount", "value": "11.00", "currency": "USD" },
          "shippingDestination": { "@type": "DefinedRegion", "addressCountry": "US" },
          "deliveryTime": {
            "@type": "ShippingDeliveryTime",
            "handlingTime": { "@type": "QuantitativeValue", "minValue": 1, "maxValue": 2, "unitCode": "d" },
            "transitTime": { "@type": "QuantitativeValue", "minValue": 10, "maxValue": 15, "unitCode": "d" }
          }
        },
        {
          "@type": "OfferShippingDetails",
