{% comment %}
  Renders a checkbox field
  Accepts:
    - id {String}: The input id
    - checkbox_name {String}: The input name
    - checkbox_value {String}: The input value
    - classes {String}: Sets the container classes
    - label_content {String}: The label content
    - label_classes {String}: The label classes
    - label_translatable_content {String}: The label translatable content
    - helper_text {String}: The helper text
    - error_text {String}: The error text
    - checkbox_color_bg {String}: The checkmark background color
    - checkbox_color_border {String}: The checkmark border color
    - custom_attributes {String}: The custom attributes

  Usage:
    {% render 'c-input' %}
{% endcomment %}

{% liquid
  if label_translatable_content
    assign label_content = label_translatable_content | t
  endif

  assign border_color = checkbox_color_border | default: 'border-foreground'
  assign bg_color = checkbox_color_bg | default: 'peer-checked:bg-foreground'
%}

<label for="{{ id }}" class="relative pl-6 cursor-pointer select-none {{ classes }}" {{ custom_attributes }}>
  <input
    id="{{ id }}"
    class="absolute opacity-0 cursor-pointer h-0 w-0 peer"
    type="checkbox"
    name="{{ checkbox_name }}"
    value="{{ checkbox_value }}"
  >
  <span
    class="border rounded-sm {{ border_color }} absolute top-[1px] left-0 w-4 h-4 bg-background after:content-[''] after:absolute after:hidden {{ bg_color }} peer-checked:after:block after:left-[5px] after:top-[1px] after:w-1 after:h-[10px] after:border-solid after:border-white after:border-b-[2.5px] after:border-r-2 after:rotate-45"
  ></span>
  {% render 'c-text', type: 'paragraph-2', content: label_content %}
</label>
