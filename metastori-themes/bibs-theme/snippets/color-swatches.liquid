{% comment %}
  Renders color-swatches

  Accepts:
  - main_product {Product}: Color swatches is shown for this Product object
  - classes {String}: Additional classes to add to the color swatches container
  - show_color_swatches {Boolean}: Only show color swatches if this value is true

  Usage:
    {% render 'color-swatches', main_product: product %}
{% endcomment %}

{% liquid
  assign connected_products = main_product.metafields.custom.connected_products.value
  paginate connected_products by 5
    assign connected_products_length = paginate.items
  endpaginate
  assign swatch_count = 0
  assign mobile_swatch_count = 0
  assign total_swatch_count = 0
%}

{%- if connected_products_length > 0 -%}
  <div class="{{ classes }}">
    <div class="bg-background rounded-full p-1 flex flex-col gap-1 justify-center items-center">
      <!-- Main product color -->
      {% liquid
        assign main_product_colors = main_product.metafields.custom.farve.value.color.value
        assign main_product_colors_size = main_product_colors.size
      %}

      {%- if main_product_colors_size > 0 -%}
        {%- assign total_swatch_count = total_swatch_count | plus: 1 -%}
        {%- capture main_product_color_gradient -%}
          {%- if main_product_colors_size == 1 -%}
            background: {{ main_product_colors }};
          {%- else -%}
            {{ 'background: linear-gradient(90deg, ' }}
            {%- for main_product_color in main_product_colors -%}
              {{ main_product_color }} {{ '100' | divided_by: main_product_colors_size | append: '%' }}{%- unless forloop.last -%},{%- endunless -%}
            {%- endfor -%}
            {{ ');' }}
          {%- endif -%}
        {%- endcapture -%}

        <div
          class="w-3 h-3 rounded-full shadow"
          style="{{ main_product_color_gradient }}"
        ></div>
        {%- assign swatch_count = swatch_count | plus: 1 -%}
        {%- assign mobile_swatch_count = mobile_swatch_count | plus: 1 -%}
      {%- endif -%}

      <!-- Connected products colors -->
      {%- for connected_product in connected_products -%}
        {% liquid
          assign connected_product_colors = connected_product.metafields.custom.farve.value.color.value
          assign connected_product_colors_size = connected_product_colors.size
        %}

        {%- if connected_product_colors_size > 0 -%}
          {%- assign total_swatch_count = total_swatch_count | plus: 1 -%}
          {%- if swatch_count < 5 -%}
            {%- capture connected_product_color_gradient -%}
              {%- if connected_product_colors_size == 1 -%}
                background: {{ connected_product_colors }};
              {%- else -%}
                {{ 'background: linear-gradient(90deg, ' }}
                {%- for connected_product_color in connected_product_colors -%}
                  {{ connected_product_color }} {{ '100' | divided_by: connected_product_colors_size | append: '%' }}{%- unless forloop.last -%},{%- endunless -%}
                {%- endfor -%}
                {{ ');' }}
              {%- endif -%}
            {%- endcapture -%}
            <div
              class="w-3 h-3 rounded-full shadow {% if swatch_count >= 3 %}hidden md:block{% endif %}"
              style="{{ connected_product_color_gradient }}"
            ></div>
            {%- assign swatch_count = swatch_count | plus: 1 -%}
          {%- endif -%}
          {%- if mobile_swatch_count < 3 -%}
            {%- assign mobile_swatch_count = mobile_swatch_count | plus: 1 -%}
          {%- endif -%}
        {%- endif -%}
      {%- endfor -%}
      {% liquid
        assign remaining_count = total_swatch_count | minus: swatch_count
        if remaining_count > 0
          assign remaining_count = remaining_count | prepend: '+'
          render 'c-text', content: remaining_count, type: 'h9-medium', classes: 'hidden md:block'
        endif
        assign mobile_remaining_count = total_swatch_count | minus: mobile_swatch_count
        if mobile_remaining_count > 0
          assign mobile_remaining_count = mobile_remaining_count | prepend: '+'
          render 'c-text', content: mobile_remaining_count, type: 'h9-medium', classes: 'block md:hidden'
        endif
      %}
    </div>
  </div>
{%- endif -%}
