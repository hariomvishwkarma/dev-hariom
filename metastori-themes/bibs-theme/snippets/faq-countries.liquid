<div>
  <select class="border rounded-full border-borders px-5 py-2 faq-country-selector">
    <option selected disabled>{{ 'sections.page-faqs.choose_country' | t }}</option>
    {% for country in shop.metaobjects.faq_delivery_countries.values %}
      {%- assign country_handle_value = country.country | handleize -%}
      <option value="{{ country_handle_value }}">{{ country.country }}</option>
    {% endfor %}
  </select>

  {% for country in shop.metaobjects.faq_delivery_countries.values %}
    {%- if country[field] != blank -%}
      {%- assign country_handle = country.country | handleize -%}

      <div class="hidden faq__country faq__country-{{ country_handle }} mt-4">
        {%- assign content = country[field] | newline_to_br -%}
        {% render 'c-richtext', content: content, classes: 'flex flex-col gap-6' %}
      </div>
    {%- endif -%}
  {% endfor %}
</div>
