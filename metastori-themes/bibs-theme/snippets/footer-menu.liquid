{%- comment -%}
  Renders footer menu link, with its sublinks, part of footer components

  Accepts:
    - block: {Object} settings for the current block
    - classes: {string} single or multiple classes
  Usage:
    {% render 'footer-menu', block: block.settings, class: 'basis-2/5' %}
{%- endcomment -%}
{% liquid
  assign nav_link = block.nav_link
%}

{% unless block.nav_link == blank %}
  {% capture 'footer_menu_title' %}
      {% if block.nav_title != blank %} 
        {% render 'c-text', content: block.nav_title, type: 'h6', classes: 'text-xl mb-6'  %}
      {% else %} {{ linklists[nav_link].title }} 
      {% endif %}
  {% endcapture %}

  {% capture 'footer_menu_content' %}
    <nav class="flex flex-col gap-2 lg:gap-3.5 lg:items-start {{ classes }}">
      {% for link in linklists[nav_link].links %}
        {% liquid
          assign link_title = link.title
          if link_title contains '[' and link_title contains ']'
            assign opening_tag = '<span class="text-accent">'
            assign link_content = link_title | replace: '[', opening_tag | replace: ']', '</span>'
          else
            assign link_content = link_title
          endif
        %}

        {%- if forloop.index == 1 -%}
          {%- assign link_type = 'link--hover paragraph-3' -%}
        {%- else -%}
          {%- assign link_type = 'link--hover paragraph-3' -%}
        {%- endif -%}

        {% render 'c-link', href: link.url, type: link_type, content: link_content %}
      {% endfor %}
    </nav>
  {% endcapture %}

  <div class="block">
    {{ footer_menu_title }}
    {{ footer_menu_content }}
  </div>
{% endunless %}
