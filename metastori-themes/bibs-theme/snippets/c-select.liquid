{% comment %}
  Renders a select field
  Accepts:
    - id {String}: id of the field
    - name {String}: name of the field
    - required {Boolean}: whether the field is required or not
    - options {Array}: array of objects
    - label_content {String}: label of the field
    - label_translated {String}: translated label of the field
    - custom_arrow {String}: custom arrow icon

  Usage:
    {% render 'c-select' %}
{% endcomment %}

{%- liquid
  assign select_design = 'custom-select block px-5 py-3 w-full text-sm left-4 bg-transparent appearance-none outline-none focus:outline-0 duration-200 peer-focus:left-0 peer-focus:mx-5 peer-focus:-translate-y-2 select-valid:-translate-y-2'
  assign label_design = 'absolute text-sm leading-none mx-5 bg-background rounded-[1px] translate-y-4 text-form'
-%}

<select
  {% if id %}
    id="{{ id }}"
  {% endif %}
  name="{{ name }}"
  {% if required %}
    required
  {% endif %}
  class="{{ select_design }}"
>
  {{- options -}}
</select>

{%- if custom_arrow -%}
  {%- render 'c-icon', icon: 'flat-arrow-down', classes: 'w-2', extra_classes: 'pointer-events-none' -%}
{%- endif -%}

{%- if label_content or label_translated -%}
  <label for="{{ id }}" class="{{ label_design }} {{ label_classes }}">
    {%- liquid
      if label_content
        echo label_content
      endif
    -%}

    {%- liquid
      if label_translated
        echo label_translated | t
      endif
    -%}
  </label>
{%- endif -%}
