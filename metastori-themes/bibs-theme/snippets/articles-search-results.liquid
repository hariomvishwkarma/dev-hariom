{%- capture swiper_options -%}
  {
    "slidesPerView": 1,
    "spaceBetween": 20,
    "loop": true,
    "scrollbar": {
      "enabled": true,
      "el": ".swiper-scrollbar",
      "draggable": true
    },
    "breakpoints": {
      "450": {
        "slidesPerView": 2
      },
      "768": {
        "slidesPerView": 3
      }
    }
  }
{%- endcapture -%}
{%- capture swiper_attribute -%}
  data-swiper='{{- swiper_options -}}'
{%- endcapture -%}

<div class="container-fluid ">
  {% liquid
    assign result_articles = search.results | where: 'object_type', 'article'
  %}
  <div class="my-12 border-t-4"></div>
  <div class="space-y-6">
    <div class="space-y-2">
      {% render 'c-text', translatable_content: 'templates.search.articles_found', type: 'h3-bold' %}

      {%- assign articles_with_count = 'templates.search.articles_with_count_html' | t: count: result_articles.size -%}
      {% render 'c-text', content: articles_with_count, classes: 'first-child:font-medium' %}
    </div>

    {%- if result_articles.size > 0 -%}
      <div class="swiper" {{ swiper_attribute }}>
        <div class="swiper-wrapper">
          {% for item in result_articles %}
            <div class="swiper-slide !grid !h-auto">
              {% render 'card-article', article: item %}
            </div>
          {% endfor %}
        </div>
        <div class="swiper-scrollbar"></div>
      </div>
    {%- endif -%}
  </div>
</div>
