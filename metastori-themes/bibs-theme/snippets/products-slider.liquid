{%- comment -%}
  Renders a products slider based on products list.

  Accepts:
    - title {String}: The title of the block as a translatable content
    - title_tag {String}: The title tag [Default: 'h5']
    - products_list {Array}: The list of products to render
    - swiper_attribute {String}: The swiper attribute to pass to the swiper component
    - limit {Number}: The number of products to render [Default: 4]
    - wrapper_classes {String}: The container classes [Default: 'container-fluid--l !pl-[30px] pr-0 py-7.5']
    - only_show_available_products {Boolean}: Whether to only show available products [Default: true]

  Usage:
    {% render 'products-slider', products_list: products_list, swiper_attribute: swiper_attribute %}
{%- endcomment -%}

{%- if products_list != blank -%}
  {%- unless swiper_attribute -%}
    {%- capture swiper_options -%}
      {
        "slidesPerView": 2.5
      }
    {%- endcapture -%}

    {%- capture swiper_attribute -%}
      data-swiper='{{- swiper_options -}}'
    {%- endcapture -%}
  {%- endunless -%}

  {% liquid
    assign wrapper_classes = wrapper_classes | default: 'container-fluid--l !pl-[30px] pr-0 py-7.5'
    assign title_tag = title_tag | default: 'h5'
    assign only_show_available_products = only_show_available_products | default: true
    if only_show_available_products
      assign products_list = products_list | where: 'available', true
    endif
    assign limit = limit | default: 4
  %}

  <div class="space-y-6 {{ wrapper_classes }}">
    {% render 'c-title', translatable_content: title, custom_tag: title_tag %}

    <swiper-slider class="swiper swiper-card" {{ swiper_attribute }}>
      <div class="swiper-wrapper">
        {%- for single_product in products_list limit: limit -%}
          <div class="swiper-slide">
            {% render 'card-product',
              card_product: single_product,
              show_secondary_media: true,
              media_aspect_ratio: 'bibs',
              prioritize_image: false
            %}
          </div>
        {%- endfor -%}
      </div>
    </swiper-slider>
  </div>
{%- endif -%}
