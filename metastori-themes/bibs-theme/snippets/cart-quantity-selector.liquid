<quantity-input class="{{ classes }}">
  <button class="quantity__button" name="minus" type="button">
    {% render 'c-icon', icon: 'minus', classes: 'w-2 h-auto' %}
  </button>
  <div class="quantity__input-wrapper">
    <input
      type="number"
      name="quantity"
      id="Cart-quantity-{{ item.index }}"
      class="quantity__input text-xs font-medium bg-inherit"
      value="{{ item.quantity }}"
      min="{% if is_cart_drawer %}0{% else %}1{% endif %}"
      max="{{ item.inventory_quantity }}"
      data-id="{{ item.key }}"
    >
  </div>

  <button class="quantity__button" name="plus" type="button">
    {% render 'c-icon', icon: 'plus', classes: 'w-2 h-auto' %}
  </button>
</quantity-input>
