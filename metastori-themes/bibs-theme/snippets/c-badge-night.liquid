{%- comment -%}
  Used to flexibly render specific badges
  Accepts:
    - badge_item {Object}: (OPTIONAL) specifies the type of content to be rendered
    - classes {String}: (OPTIONAL) additional classes to be added to the badge

  Usage:
    {% render 'c-badges-switch', badge_item: product %}
{%- endcomment -%}

{%- liquid
  assign custom_labels = badge_item.tags | where: 'label_'
-%}

{%- for label in custom_labels -%}
  {%- liquid
    assign parts = label | split: ':'
    assign value = parts[1] | downcase
  -%}

  {%- if value == 'night' -%}
    <div class="{{ classes }}">
      <div class="text-bibs-night w-9 h-9 flex items-center justify-center border border-borders rounded-full">
        {% render 'c-icon', icon: 'night', classes: 'w-5 h-5' %}
      </div>
    </div>
    {%- break -%}
  {%- endif -%}
{%- endfor -%}
