{% assign align = content_alignment | split: ' ' | first %}
{% assign justify = content_alignement | split: ' ' | last %}
{% assign wrap_align_class = 'items-' | append: align | replace: 'bottom', 'end' | replace: 'top', 'start' %}
{% assign wrap_justify_class = 'justify-' | append: justify | replace: 'right', 'end' | replace: 'left', 'start' %}
{% assign text_align_class = 'text-' | append: justify %}
{% assign content_align_class = 'items-' | append: justify | replace: 'right', 'end' | replace: 'left', 'start' %}

{% if promobox.level == level %}
  <div class="relative">
    {% render 'c-image', image: promobox.image, image_classes: image_classes, lazy: 'lazy' %}
    <div class="absolute h-full w-full top-0 bottom-0 left-0 right-0 py-8 px-4 flex {{ wrap_align_class }} {{ wrap_justify_class }}">
      <div class="text-white flex flex-col gap-4 {{ text_align_class }} {{ content_align_class }}">
        <h3>{{ promobox.headline }}</h3>
        <p>{{ promobox.description }}</p>
        {% if promobox.link %}
          <a href="{{ promobox.link.value.url }}">
            {{ promobox.link.value.text }}
          </a>
        {% endif %}
      </div>
    </div>
  </div>
{% endif %}
