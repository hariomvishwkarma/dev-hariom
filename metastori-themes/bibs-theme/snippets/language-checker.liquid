<div
  class="language-checker-wrapper bg-white p-4 fixed bottom-4 right-4 lg:top-8 hidden z-50 rounded-lg max-w-[330px] shadow-lg border border-gray-200 overflow-hidden h-fit translate-x-full opacity-0 transition-[transform,opacity] duration-300 ease-out will-change-transform"
  role="region"
  aria-labelledby="localization-title"
  aria-live="polite"
  aria-hidden="true"
  data-i18n-question="{{ 'localization.question' | t | escape }}"
  data-i18n-switch="{{ 'localization.switch_to' | t | escape }}"
  data-i18n-stay="{{ 'localization.stay_on' | t | escape }}"
>
  <div class="flex flex-row items-start mt-1.5 gap-1">
    <div id="localization-title" class="localization-title"></div>
    <button type="button" aria-label="{{ 'localization.close' | t | escape }}" class="close mt-1 pointer">
      {% render 'c-icon', icon: 'close', classes: 'w-3 h-3' %}
    </button>
  </div>
  <div class="btn-wrapper flex flex-row gap-4 mt-2">
    <button type="button" class="dismiss_button rounded-full border px-6 py-2"></button>
    <button
      type="button"
      class="swap_button px-6 py-2 rounded-full bg-[rgba(var(--color-button))] text-[rgba(var(--color-button-text))]"
    ></button>
  </div>
</div>

{% liquid
  assign markets_obj = shop.metaobjects.markets.values
  assign current_iso_code = localization.country.iso_code
  assign current_market_obj = markets_obj | where: 'iso', current_iso_code | first
%}

<script>
  window.market = {
    currentCountry: "{{ localization.country.iso_code | downcase }}",
    currentCountryFullName: {{ localization.country.name | json }},
    currentLanguage: "{{ localization.language.iso_code | downcase }}",
    currentMarketLink: {{ current_market_obj.link | default: '/' | json }}
  };
  window.MARKET_LANGUAGES = {
    {%- for market in markets_obj -%}
      "{{ market.iso | upcase }}": "{{ market.locale_iso | downcase }}"{% unless forloop.last %},{% endunless %}
    {%- endfor -%}
  };
  window.COUNTRY_NAMES = {
    {%- for market in markets_obj -%}
      "{{ market.iso | upcase }}": {{ market.name | json }}{% unless forloop.last %},{% endunless %}
    {%- endfor -%}
  };
  window.MARKET_LINKS = {
    {%- for market in markets_obj -%}
      "{{ market.iso | upcase }}": {{ market.link | default: '/' | json }}{% unless forloop.last %},{% endunless %}
    {%- endfor -%}
  };
  window.COUNTRY_NAMES.IE = "EU";
</script>

<script src="{{ 'localization.js' |  asset_url }}" defer></script>
