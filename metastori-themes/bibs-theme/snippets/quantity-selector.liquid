{%- assign icon_sizes_classes = icon_sizes | default: 'w-2 h-2 md:w-3 md:h-3' -%}
<quantity-input class="quantity-input {{ classes }}">
  <button class="quantity__button" name="minus" type="button">
    {% render 'c-icon', icon: 'minus', classes: icon_sizes_classes %}
  </button>
  <div class="quantity__input-wrapper">
    <input
      type="number"
      name="quantity"
      id="quantity-{{ section_id }}"
      class="quantity__input text-1-medium"
      value="{{ value | default: 1 }}"
      min="{{ min_qty | default: 1 }}"
      form="{{ product_form_id }}"
    >
  </div>

  <button class="quantity__button" name="plus" type="button">
    {% render 'c-icon', icon: 'plus', classes: icon_sizes_classes %}
  </button>
</quantity-input>
