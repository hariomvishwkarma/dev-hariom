{% if settings.gtm_container_id != blank %}
  {% assign gtm_url = settings.gtm_url | default: 'https://www.googletagmanager.com' %}
  <!-- Google Tag Manager (noscript) -->
  <noscript
    ><iframe
      src="{{gtm_url}}/ns.js?id={{settings.gtm_container_id}}"
      height="0"
      width="0"
      style="display:none;visibility:hidden"
    ></iframe
  ></noscript>
  <!-- End Google Tag Manager (noscript) -->
{% endif %}
