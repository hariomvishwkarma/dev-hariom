{%- comment -%}
  Renders a review.

  Accepts:
    - block (required)

  Usage:
    {% render 'review' with block %}
{%- endcomment -%}

<div class="md:pr-[36px] pr-2 flex flex-col gap-[18px]">
  <div class="flex flex-row gap-2">
    {% capture fullstars %}
      {{block.settings.stars | floor}}
    {% endcapture %}
    {% for i in (1..fullstars) %}
      {% render 'c-icon', icon: 'star', classes: 'h-6 w-6 text-shade-1' %}
    {% endfor %}
    {% capture halfstars %}
      {{block.settings.stars | minus: fullstars }}
    {% endcapture %}
    {% assign halfstars = halfstars | plus: 0 %}
    {% if halfstars > 0 %}
      {% render 'c-icon', icon: 'half-star', classes: 'h-6 w-6 text-shade-1' %}
    {% endif %}
  </div>
  {% render 'c-title', content: block.settings.heading, custom_tag: 'h5', classes: '' %}
  {% render 'c-text', content: block.settings.text, classes: 'text-lg md:text-xl italic' %}
  <div class="flex flex-row gap-3 items-center">
    {% render 'c-image', image: block.settings.image, classes: 'h-9 w-9 rounded-full overflow-hidden', alt: block.settings.name %}
    {% render 'c-text', content: block.settings.name, classes: 'text-grey-600' %}
  </div>
</div>
