{%- capture swiper_options -%}
  {
    "slidesPerView": 1,
    "spaceBetween": 0,
    "loop": true,
    "navigation": {
      "nextEl": ".swiper-button-next",
      "prevEl": ".swiper-button-prev"
    },
    "scrollbar": {
      "el": ".swiper-scrollbar",
      "draggable": true
    }
  }
{%- endcapture -%}
{%- capture swiper_attribute -%}
  data-swiper='{{- swiper_options -}}'
{%- endcapture -%}

{%- if featured_articles.size > 0 -%}
  <div class="blog-featured-articles block relative container-fluid py-7.5">
    <div class="block swiper swiper-card w-full col-span-3" {{ swiper_attribute }}>
      <div class="swiper-wrapper w-full secondary-wrapper">
        {% for handle in featured_articles %}
          {% assign article = articles[handle] %}
          <div class="swiper-slide">
            {% render 'card-article-featured', article: article %}
          </div>
        {% endfor %}
      </div>
    </div>
  </div>
{%- endif -%}
