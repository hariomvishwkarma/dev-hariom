{%- comment -%}
  Renders a video

  Accepts:
    - video {Object}: a video object
    - video_url {String}: a video url

    - autoplay {Boolean}: autoplay the video
    - loop {Boolean}: loop the video
    - controls {Boolean}: show controls

    - aspect_ratio {String}: the aspect ratio of the video

  Usage:
    {% render 'c-video' with video: video, video_url: video_url %}
{%- endcomment -%}

{%- if video -%}
  {{ video | video_tag: image_size: '1100x', autoplay: autoplay, loop: loop, controls: controls, muted: true }}
{%- elsif video_url -%}
  {% liquid
    assign video_id = video_url.id
  %}

  {%- capture fomatted_video_url -%}
    {%- if video_url.type == 'youtube' -%}
      https://www.youtube.com/embed/{{ video_id }}?enablejsapi=1{%- if autoplay -%}&autoplay=1&mute=1{%- endif -%}{%- if loop -%}&loop=1{%- endif -%}{%- unless controls -%}&controls=0{%- endunless -%}
    {%- elsif video_url.type == 'vimeo' -%}
      https://player.vimeo.com/video/{{ video_id }}?t=0{%- if autoplay -%}autoplay=1&muted=1{%- endif -%}{%- if loop -%}&loop=1{%- endif -%}{%- unless controls -%}&controls=0{%- endunless -%}
    {%- endif -%}
  {%- endcapture -%}
  <div
    class="video-wrapper"
    {% if aspect_ratio %}
      style="--aspect-ratio: {{ aspect_ratio }};"
    {% endif %}
  >
    <iframe
      src="{{ fomatted_video_url }}"
      allow="autoplay; encrypted-media"
      allowfullscreen
      frameborder="0"
    ></iframe>
  </div>
{%- endif -%}
