{%- comment -%}
  Renders a popover component

  Accepts:
    - popover_id {String}: sets the id of the popover
    - popover_placement {String}: sets the placement of the popover
    - popover_trigger {String}: sets the trigger of the popover
    - popover_offset {String}: sets the offset of the popover
    - popover_content {String}: sets the content of the popover
    - toggle_label {String}: sets the label of the toggle button

  Usage:
    {% render 'c-popover' %}
{%- endcomment -%}

{%- if popover_content -%}
  <div
    data-popover
    data-popover-id="{{ popover_id }}"
    data-placement="{{ popover_placement }}"
    data-trigger="{{ popover_trigger }}"
    data-offset="{{ popover_offset }}"
    class="hidden{% if popover_trigger == 'click' %} !pr-7{% endif %}"
  >
    {%- if popover_trigger == 'click' -%}
      {%- capture close_button_content -%}
      {% render 'c-icon' with icon: 'close', classes: 'w-[14px] h-[14px] inline' %}
    {%- endcapture -%}
      {% render 'c-button',
        content: close_button_content,
        design: 'link--bg',
        custom_attributes: 'data-popover-close',
        classes: 'absolute right-2 !p-0'
      %}
    {%- endif -%}
    {{- popover_content -}}
  </div>
{%- endif -%}
