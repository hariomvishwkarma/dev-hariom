{%- comment -%}
  Renders a text component

  Accepts:
    - id { String }: The id of the text component to render
    - content { String }: The text to render
    - translatable_content { String }: If you need to pass in a string that refers to a translation
    - custom_tag { String }: custom tag of the text component to render (default: 'p')
    - classes { String }: Additional classes to add to the component
    - type { String }: Type of the text component to render
      (Values: paragraph-1, paragraph-2, text-1-medium, text-1-regular, text-2-medium, text-2-regular, text-3 )
      NOTE: if no type is provided, it will be the tag's design
    - custom_attributes {String}: Any custom attributes to add to the text component

  Usage:
    {% render 'c-text', custom_tag: 'p', content: "Hello World" %}
{%- endcomment -%}

{%- liquid
  assign custom_tag = custom_tag | default: 'p'
  if translatable_content
    assign content = translatable_content | t
  endif
-%}

{%- if content != blank -%}
  <{{ custom_tag }}
    {% if id %}
      id="{{ id }}"
    {% endif %}
    class="{% if classes %}{{ classes }} {% endif %}{% if type %}{{ type }}{% endif %}"
    {{ custom_attributes }}
  >
    {{- content -}}
  </{{ custom_tag }}>
{%- endif -%}
