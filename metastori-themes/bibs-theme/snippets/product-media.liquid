{% comment %}
  Renders product media

  Accepts:
    - media {Object}: Product Media object
    - aspect_ratio {String}: Aspect ratio of the image. Defaults to 'square'
    - zoom_type {Boolean}: Type of zoom.
    - loading {String}: eager or lazy
    - fetch_priority {String}: high or low
    - media_fit {String}: How the media should fit.
    - media_classes {String}: Additional classes to add to the media

  Usage:
    {% render 'product-media', media: media %}
{% endcomment %}

{% liquid
  assign media_loading = loading | default: 'lazy'
  if zoom_type == 'hover'
    assign image_classes = 'image-magnify-hover'
  elsif zoom_type == 'click'
    assign image_classes = 'image-magnify-click'
  endif

  assign image_classes = image_classes | append: ' ' | append: media_classes

  assign aspect_ratio = aspect_ratio | default: 'square'
%}

{% case media.media_type %}
  {% when 'image' %}
    {% render 'c-image',
      image: media,
      aspect_ratio: aspect_ratio,
      image_width: 1946,
      image_classes: image_classes,
      loading: media_loading,
      fetch_priority: fetch_priority,
      image_fit: media_fit,
      alt: product.title
    %}
  {% when 'external_video' %}
    {{ media | external_video_tag: class: 'w-full h-auto aspect-square' }}
  {% when 'video' %}
    {{ media | video_tag: controls: true, class: 'w-full h-auto aspect-square' }}
  {% else %}
    {{ media | media_tag: class: 'w-full h-auto aspect-square' }}
{% endcase %}
