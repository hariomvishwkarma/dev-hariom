{% comment %}
  Renders a focus point for collage section
  Accepts:
    - block_id
    - block_product {Product}: the product being pointed at
    - x_position {Number}: percentage position from left to right
    - y_position {Number}: percentage position from top to bottom
    - x_position_mobile {Number}: percentage position from left to right on mobile
    - y_position_mobile {Number}: percentage position from top to bottom on mobile

  Usage:
    {% render 'c-point', block_product: product, x_position: 'x', y_position: 'y', x_position_mobile: 'x2', y_position_mobile: 'y2' %}
{% endcomment %}

<div>
  <style>
      #Hotspot-{{ block_id }}-{{ block_product.id }} {
      left: {{ x_position_mobile }}%;
      top: {{ y_position_mobile }}%;
    }
    @media (min-width: 768px) {
      #Hotspot-{{ block_id }}-{{ block_product.id }} {
        left: {{ x_position }}%;
        top: {{ y_position }}%;
      }
    }
  </style>
  {% assign product_id = block_product.id %}
  <div
    id="Hotspot-{{ block_id }}-{{ product_id }}"
    class="hotspot"
    data-popover-target="popover-{{ block_id }}-{{ product_id }}"
  ></div>
  {%- if block_product != blank -%}
    {%- capture popover_content -%}
      <div class="w-[167px]">
        {% render 'card-product', card_product: block_product, media_aspect_ratio: 'bibs' %}
      </div>
    {%- endcapture -%}
    {%- assign popover_id = 'popover-' | append: block_id | append: '-' | append: product_id -%}
    {% render 'c-popover', popover_content: popover_content, popover_id: popover_id %}
  {%- endif -%}
</div>
