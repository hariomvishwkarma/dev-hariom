<div class="sticky_atc hidden bg-transparent fixed bottom-10 right-0 left-0 container-fluid z-10 color-{{block.settings.color_scheme}}">
  <div class="py-3.5 md:pl-[26px] px-4 rounded-full bg-background flex flex-row gap-4 justify-between items-center border border-borders">
    {% render 'c-title',
      custom_tag: 'h5',
      content: product.title,
      classes: 'h6 whitespace-nowrap overflow-hidden text-ellipsis hidden md:block'
    %}
    {% assign product_form_id = 'floating-product-form-' | append: section.id %}
    <product-form class="w-full md:w-auto">
      {%- form 'product', product, id: product_form_id, class: 'product-form w-full md:w-fit floating-product-form' -%}
        <div
          class="!hidden text-accent bg-accent/10 text-1-regular px-3 py-2 rounded"
          role="alert"
          data-product-form-error-message
        ></div>

        <input type="hidden" name="id[]" required value="{{ product.selected_variant.id }}">
        <div {{ block.shopify_attributes }} class="w-full md:w-fit">
          <a href="#" class="to_top_link">
            {% render 'buy-buttons',
              product: product,
              section_id: section_id,
              product_form_id: product_form_id,
              block: block,
              no_qty_selector: true,
              show_price_on_btn: true
            %}
          </a>
        </div>
      {%- endform -%}
    </product-form>
  </div>
</div>
