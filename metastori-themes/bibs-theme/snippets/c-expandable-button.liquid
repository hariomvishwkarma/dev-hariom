{%- comment -%}
  Renders an expandable button

  Accepts:
    - id {String}: The button id
    - button_text {String}: The button text
    - icon
    - button_name {String}: name on the button
    - button_classes {String}: classes to add to the button

  Usage:
    {% render 'c-expandable-button' %}
{%- endcomment -%}

{%- capture button_content -%}
  <div class="flex items-center gap-2 ">
    {{icon}}
    <span class="hidden">
        {{button_text}}
    </span>
  </div>
{%- endcapture -%}

{%- capture classes -%}
  expandable-button rounded-full text-4 flex items-center justify-center p-3 hover:pr-8 hover:pl-8 active:pr-8 active:pl-8 text-center cursor-pointer bg-background active:bg-shade-1 border border-background hover:border-foreground {{classes}}
{%- endcapture -%}

{%- capture custom_attributes -%}
  data-drawer-target="{{id}}"
  aria-label="{{ button_text }}"
{%- endcapture -%}

{% render 'c-button',
  custom_attributes: custom_attributes,
  type: 'button',
  content: button_content,
  name: button_name,
  design: 'none',
  classes: classes
%}
