{%- assign root_url_ends_with = routes.root_url | slice: -1, 1 -%}
{%- if root_url_ends_with == '/' -%}
  {%- assign root_url = routes.root_url -%}
{%- else -%}
  {%- assign root_url = routes.root_url | append: '/' -%}
{%- endif -%}
<script>
  window.shop = {
    url: '{{ request.origin }}',
    domain: '{{ shop.permanent_domain | remove: '.myshopify.com'}}'
  }
  window.routes = {
    root_url: '{{ root_url }}',
    cart_add_url: '{{ routes.cart_add_url }}',
    cart_change_url: '{{ routes.cart_change_url }}',
    cart_update_url: '{{ routes.cart_update_url }}',
    cart_url: '{{ routes.cart_url }}',
    predictive_search_url: '{{ routes.predictive_search_url }}'
  };


  window.customer = {
    isLoggedIn: {% if customer %}true{% else %}false{% endif %},
    id: {% if customer %}{{ customer.id }}{% else %}''{% endif %},
    email: {% if customer %}'{{ customer.email }}'{% else %}''{% endif %}
  }

  window.cartStrings = {
    error: `{{ 'sections.cart.cart_error' | t }}`,
    acceptTerms: `{{ 'cart.accept_terms' | t }}`,
    quantityError: `{{ 'sections.cart.cart_quantity_error_html' | t: quantity: '[quantity]' }}`,
    cartSubscriptionMinimumError: `{{ 'cart.cart_subscription_minimum_error' | t }}`,
    limited_quantity: `{{ 'sections.cart.error_limited_quantity' | t: quantity: '[quantity]' }}`
  };

  window.variantStrings = {
    addToCart: `{{ 'sections.product-form.add_to_cart' | t }}`,
    soldOut: `{{ 'sections.product-form.sold_out' | t }}`,
    unavailable: `{{ 'sections.product-form.unavailable' | t }}`,
    selectOptions: `{{ 'sections.product-form.select_options' | t }}`,
    unavailable_with_option: `{{ 'products.product.value_unavailable' | t: option_value: '[value]' }}`,
    atleastthreeProducts: `{{ 'sections.product-form.atleast_three_products' | t }}`,
    productForm: {
      choose: `{{ 'sections.product-form.choose' | t }}`,
      and: `{{ 'sections.product-form.and' | t }}`
    },
    variant_selector: {
      size: `{{ 'sections.product-form.blocks.variant_selector.size.name' | t }}`,
      material: `{{ 'sections.product-form.blocks.variant_selector.material.name' | t }}`,
      nippleType: `{{ 'sections.product-form.blocks.variant_selector.nipple-type.name' | t }}`,
    },
    subscription: {
      addToSubscription: "{{ 'sections.product-form.subscription-buttons.add_to_subscription' | t | replace: "&#39;", "'"  }}",
      soldOut: `{{ 'sections.product-form.subscription-buttons.sold_out' | t }}`,
      unavailable: `{{ 'sections.product-form.subscription-buttons.unavailable' | t }}`,
      selectOptions: `{{ 'sections.product-form.subscription-buttons.select_options' | t }}`
    }
  };
  window.theme = {
    {% if settings.free_gift.id and settings.free_gift_limit > 0 %}
      freeGift:{
        variantId: {{ settings.free_gift.first_available_variant.id | json }},
        id: {{ settings.free_gift.id | json }},
        limit: {% render 'get-free-limit', limit: settings.free_gift_limit, custom_limits: settings.free_gift_limit_custom, custom_eu_limits: settings.eu_free_gift_limit_custom %}
      },
    {% else %}
      freeGift: false,
    {% endif %}
    {% if settings.free_delivery_limit != blank %}
      freeShipping: {
        limit: {% render 'get-free-limit', limit: settings.free_delivery_limit, custom_limits: settings.free_delivery_limit_custom, custom_eu_limits: settings.eu_free_delivery_limit_custom %}
      },
    {% else %}
      freeShipping: false,
    {% endif %}
    settings: {
      disable_tooltips: {{ settings.disable_tooltips | json }}
    },
    template: {
      name: '{{ template.name }}',
      suffix: '{{ template.suffix }}',
      directory: '{{ template.directory }}'
    },
    moneyFormat: {{ shop.money_format | json }},
    defaultSearchTerm: {{ settings.default_search_term | json }}
  }
  window.swatches = {
    maxAmount: {{settings.max_swatches_before_see_more | default: 50 }}
  }
</script>
