{% comment %}
  Renders a textarea firld

  Accepts:
    - id {String}: The textarea id
    - textarea_name {String}: The textarea name
    - textarea_classes {String}: The textarea classes
    - textarea_placeholder {String}: The textarea placeholder
    - textarea_required {Boolean}: The textarea required
    - textarea_value {String}: The textarea value
    - rows {Integer}: The textarea rows
    - label_content {String}: The label content
    - label_classes {String}: The label classes
    - helper_text {String}: The helper text
    - error_text {String}: The error text
    - error_text_classes {String}: The error text classes
    - custom_attributes

  Usage:
    {% render 'c-textarea' %}
{% endcomment %}

{% liquid
  # only show placeholder if label is not present
  if label_content
    assign textarea_placeholder = ' '
  endif

  assign textarea_design = 'block py-2 w-full bg-transparent appearance-none outline-none focus:outline-0 duration-200 peer-placeholder-shown:text-sm peer-placeholder-shown:translate-y-4 peer-placeholder-shown:left-4 peer-placeholder-shown:mx-0 peer-placeholder-shown:p-0 peer-focus:left-0 peer-focus:mx-4 peer-focus:text-sm peer-focus:-translate-y-2 caret-accent bg-grey-200'
  assign label_design = 'absolute text-sm leading-none mx-4 bg-background rounded-[1px] -translate-y-2 duration-200 transform left-0 origin-[0] text-form'
  assign error_text_classes = 'error-text mt-1 text-error overflow-hidden transition-all duration-300 max-h-0' | append: ' ' | append: error_text_classes
%}

<div class="relative flex">
  <textarea
    {% if textarea_name %}
      name="{{ textarea_name }}"
    {% endif %}
    {% if id %}
      id="{{ id }}"
    {% endif %}
    class="{{ textarea_design }} {{ textarea_classes }}"
    placeholder="{{ textarea_placeholder }}"
    {% if textarea_required %}
      required
    {% endif %}
    rows="{{ rows | default: 5 }}"
    {% if custom_attributes %}
      {{- custom_attributes -}}
    {% endif %}
  >
      {%- if textarea_value -%}
        {{ textarea_value }}
      {%- endif -%}
    </textarea>
  {%- if label_content -%}
    <label for="{{ id }}" class="{{ label_design }} {{ label_classes }}">{{- label_content -}}</label>
  {%- endif -%}
</div>
{%- if helper_text -%}
  {% render 'c-text', type: 'text-2-regular', content: helper_text, classes: 'mt-1.5 text-grey-600' %}
{%- endif -%}
{%- if error_text -%}
  {% render 'c-text',
    type: 'text-2-medium',
    content: error_text,
    classes: error_text_classes,
    custom_attributes: 'data-error-text'
  %}
{%- endif -%}
