{%- comment -%}
  Renders filter bar (used on top of colletion and search grid)

  Accepts:
    - results {Object}: Collection or Search object
    - enable_filtering {Boolean}: Show filtering when true

  Usage:
    {% render 'filter-bar', results: collection, enable_filtering: true %}
{%- endcomment -%}

{% if enable_filtering %}
  <facet-filters-form>
    <form id="FilteringAndSorting" class="">
      {% capture drawer_body_content %}
        {% render 'filters',
          results: results, 
          enable_filtering: true
        %}
      {% endcapture %}
      {%- liquid
        assign filter_active_count = 0
        for filter in results.filters
          assign filter_active_count = filter_active_count | plus: filter.active_values.size
        endfor
      -%}
      {% capture toggle_label %}
        <div id="filterDrawerBtn" class="rounded-full md:w-auto shadow-none w-fit bg-button-text text-button px-3 pt-2 pb-[7px] no-underline flex gap-2.5 items-center font-[400] leading-none text-nowrap whitespace-nowrap">
          {% render 'c-icon', icon: 'filter', classes: 'h-4 w-4' %}
          {{ 'products.facets.all_filters' | t }}
          {%  if filter_active_count > 0 %}  
            ({{ filter_active_count }})
          {% endif %}
        </div>  
      {% endcapture %}
      {% render 'line', margin_bottom: 'none', color_classes: 'bg-borders border-borders' %}
      <div class="container-fluid py-4">
        <div class="flex justify-between gap-2.5 items-center w-full">
          <div class="shrink-0">
            {% render 'c-drawer',
              drawer_content: drawer_body_content,
              toggle_label: toggle_label,
              drawer_id: 'filters-drawer',
              drawer_width: 'lg',
              drawer_placement: 'left',
              drawer_content_classes: 'bg-background mr-3',
              close_button_in_body: true
            %}
          </div>
          <div class="flex justify-end gap-2.5" data-filter-group>
            {% render 'quick-filters', results: collection, enable_filtering: true %}
            {%- unless template.suffix == 'subscription' -%}
              {% render 'sorting', results: results, enable_sorting: true %}
            {%- endunless -%}
          </div>
        </div>
      </div>
      {% render 'line', margin_bottom: 'none', color_classes: 'bg-borders border-borders' %}
    </form>
  </facet-filters-form>
{% endif %}
