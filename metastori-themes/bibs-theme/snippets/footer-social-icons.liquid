{%- assign social_blocks = section.blocks | where: 'type', 'footer-social-icons' -%}
{%- if social_blocks.size > 0 -%}
  <div class="lg:mb-0 pb-12">
    <div class="flex flex-row gap-2 lg:justify-end">
      {%- for social_block in social_blocks -%}
        <div class="w-14 h-14 lg:w-[72px] lg:h-[72px] rounded-full border-current border">
          <a
            target="_blank"
            class="h-full w-full flex justify-center items-center"
            href="{{ social_block.settings.social_url |  default: '#' }}"
            aria-label="{{ social_block.settings.social_platform | capitalize }}"
          >
            {% render 'c-icon', icon: social_block.settings.social_platform %}
          </a>
        </div>
      {%- endfor -%}
    </div>
  </div>
{%- endif -%}
