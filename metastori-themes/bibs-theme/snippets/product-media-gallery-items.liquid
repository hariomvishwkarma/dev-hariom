{%- comment -%}
  Renders a product media gallery items

  Accepts:
    - product {Object}: The product object to render the media gallery for
    - enable_popup {Boolean}: Whether to enable the popup for the media gallery
    - zoom_type {Boolean}: The type of zoom to use for the media gallery
    - aspect_ratio {String}: The aspect ratio to use for the media gallery
    - hide_variants {Boolean}: Whether to hide the variants in the media gallery
    - variant_images {Array}: The images of the variants to hide in the media gallery
    - media_fit {String}: The fit of the media in the media gallery

  Usage:
    {% render 'product-media-gallery-items', product: product %}
{%- endcomment -%}

{%- for media in product.media -%}
  <div
    id="Slide-{{ section.id }}-{{ media.id }}"
    class="swiper-slide"
    data-media-id="Slide-{{ media.id }}"
  >
    {%- liquid
      assign media_position = media_position | default: 0 | plus: 1
      assign media_loading = 'eager'
      assign media_fetch_priority = 'high'

      if media_position > 1
        assign media_loading = 'lazy'
        assign media_fetch_priority = 'low'
      endif
    -%}
    {%- if enable_popup -%}
      <div data-modal-target="Media-gallery-popup" cursor-popup-in>
        {%- render 'product-media',
          media: media,
          zoom_type: zoom_type,
          position: media_position,
          loading: media_loading,
          fetch_priority: media_fetch_priority,
          media_fit: media_fit,
          media_classes: 'max-h-screen'
        -%}
      </div>
    {%- else -%}
      {%- render 'product-media',
        media: media,
        zoom_type: zoom_type,
        aspect_ratio: aspect_ratio,
        loading: media_loading,
        fetch_priority: media_fetch_priority,
        media_fit: media_fit,
        media_classes: 'max-h-screen'
      -%}
    {%- endif -%}
  </div>
{%- endfor -%}
