{% comment %}
  Renders quick view image gallery

  Accepts:
  - product {Object}: Product object

  Usage:
  {% render 'quick-view-image-gallery', product: product %}
{% endcomment %}

{% liquid
  assign hide_variants = true
  assign variant_images = product.images | where: 'attached_to_variant?', true | map: 'src'

  if hide_variants and variant_images.size == product.media.size
    assign single_media_visible = true
  endif
%}

{%- capture swiper_options -%}
  {
    "slidesPerView": 1.2,
    "spaceBetween": 2,
    "freeMode": true,
    "loop": true,
    "fadeEffect":{
      "crossFade": true
    },
    {% if single_media_visible -%}
      "allowTouchMove": false,
    {%- endif -%}
    "speed": 1
  }
{%- endcapture -%}

{%- capture swiper_attribute -%}
  data-swiper='{{- swiper_options -}}'
{%- endcapture -%}

<div class="relative quick-view-gallery-swiper-wrapper">
  <div class="quickview-badges absolute top-5 left-5 z-2 gap-2 flex flex-wrap items-center col-start-1 col-end-3 row-start-1 row-end-1">
    {% render 'c-badges-switch', badge_item: product, hide_custom_labels: 'night' %}
  </div>
  <div
    class="swiper"
    {{ swiper_attribute }}
  >
    <div class="swiper-wrapper">
      {% render 'product-media-gallery-items',
        product: product,
        zoom_type: 'hover',
        media_fit: 'contain',
        hide_variants: hide_variants
      %}
    </div>
  </div>
</div>
