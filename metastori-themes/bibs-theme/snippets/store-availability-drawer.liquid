{%- capture filter_drawer_header -%}
  <div class="store-availability-count">{{ 'products.product.store_availability_html' | t: stores: 0 }}</div>
{%- endcapture -%}

{%- capture filter_drawer_content -%}
  <ul class="overflow-auto p-4 space-y-2.5" role="list" data-store-availability-drawer-content>
  </ul>
{%- endcapture -%}

{%- capture toggle_label -%}

{%- endcapture -%}

{% render 'c-drawer',
  drawer_id: 'store-availability-drawer',
  toggle_label: toggle_label,
