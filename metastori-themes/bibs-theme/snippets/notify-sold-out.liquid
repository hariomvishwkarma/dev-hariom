{%- capture drawer_content -%}
  <div class="contents-inner overflow-auto py-7.5 px-4 md:py-7.5 space-y-5">
    <div id="notify-collection-variant" class="hidden" data-variant-id="{{ product.variants[0].id }}"></div>
    {% render 'c-title', translatable_content:"notify.header_title", custom_tag: 'h5' %}
    <div class="">
      {% render 'c-text',
      translatable_content: 'notify.description',
      classes:"paragraph-3"
      %}
    </div>

    <div class="flex gap-1 border-t border-grey-300  pt-5">
      {% render 'c-image', image: product.images[0], classes: 'h-full bg-secondary-background' %}
      {% render 'c-image', image: product.images[1], classes: 'h-full bg-secondary-background' %}
    </div>

    <div>
      {% render 'c-text', content: product.title, classes: 'font-medium text-base' %}
      {%- unless product.has_only_default_variant -%}
        <div class="option-choices pt-1 paragraph-4 flex gap-2">
          {% assign product_options = product.selected_or_first_available_variant.options %}
          {%- for option in product_options -%}
            <span class="text-xs">{{ option.name }}</span>
            {% unless forloop.index == forloop.length %}
              <div>|</div>
            {% endunless %}
          {%- endfor -%}
        </div>
      {%- endunless -%}
    </div>

    <div class="border-b border-grey-300  pb-5">
      
    <div class="pb-4">
      <div data-auth-input class="relative rounded-full border-solid border border-borders flex">
        {% render 'c-input',
          input_type: 'email',
          id: 'notify-email',
          input_name: 'email',
          input_autocomplete: 'email',
          label_content: "E-mail",
          input_classes: 'autofill:text-foreground text-foreground bg-transparent text-sm items-center mx-5 py-3 w-full',
          label_classes: 'border-none',
          input_required: true,
          extra_classes: 'border-none', 
        %}
      </div>
      </div>

      <div class="custom-checkbox-flex gap-2 pb-5 paragraph-3">
        <input type="checkbox" id="Subscribe-newsletter" name="newsletter" class="w-4 h-4 hidden">
        <label for="Subscribe-newsletter" class="flex flex-row gap-4 items-center select-none cursor-pointer">
          <div class="custom-checkbox relative h-4 w-4 border border-borders rounded-[2px]"></div>
          {{ 'newsletter.join_newsletter' | t }}
        </label>
      </div>

      {% render 'c-button',
        type: 'button',
        translatable_content: 'notify.button_text',
        design: 'primary', 
        classes: 'rounded-full bg-grey-300 text-foreground w-full',
        id: 'notify-button'
      %}
      <div class="hidden pt-3" id="notify__success">
        {% render 'c-text',
          translatable_content: 'notify.success'
        %}
      </div>
      <div class="hidden pt-3" id="notify__error">
        {% render 'c-text',
          translatable_content: 'notify.error'
        %}
      </div>
    </div>

    <div class="notify-product-recommendations">
      {% render 'c-title', translatable_content:"notify.shop_similar", custom_tag: 'h5' %}
      {% render 'product-recommendations',
        section_id: section_id,
        product_id: product.id,
        products_to_show_large: 4,
        show_secondary_media: true,
        media_aspect_ratio: 'bibs',
        show_vendor: false,
        is_grid_layout: true,
        products_on_row_mobile: 2,
        products_on_row_desktop: 2,
        wrapper_classes: '!px-0 py-4',
        title_tag: 'h5'
      %}
    </div>
  </div>
{%- endcapture -%}

{% render 'c-drawer',
  drawer_id: 'notify-sold-out-drawer',
  drawer_header: drawer_header,
  drawer_content: drawer_content,
  drawer_classes: 'bg-background',
  drawer_width: 'lg'
%}
