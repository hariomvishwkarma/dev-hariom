{% comment %}
  Renders a button

  Accepts:
    - id {String}: The id of the button
    - type {String}: The type of button to render
    - name {String}: The name of the button
    - content {String}: The content of the button
    - translatable_content {String}: The translatable content of the button
    - design {String}: The design of the button
    - custom_attributes {String}: Any custom attributes to add to the button
    - classes {String}: Any classes to add to the button

  Usage:
    {% render 'c-button', type: type, content: content, name: name, design: 'primary' %}
{% endcomment %}

{% if translatable_content %}
  {% assign content = translatable_content | t %}
{% endif %}

{% liquid
  case design
    when 'primary'
      assign button_style = 'button--primary'
    when 'secondary'
      assign button_style = 'button--secondary'
    when 'accent'
      assign button_style = 'button--accent'
    when 'accent-secondary'
      assign button_style = 'button--accent-secondary'
    when 'grey'
      assign button_style = 'button--grey'
    when 'link'
      assign button_style = 'link'
    when 'link--hover'
      assign button_style = 'link--hover'
    when 'link--bg'
      assign button_style = 'link--bg'
    when 'link--bg_no-padding'
      assign button_style = 'link--bg_no-padding'
    when 'outline--primary'
      assign button_style = 'button_outline--primary'
    when 'tag'
      assign button_style = 'button--tag'
    when 'pills'
      assign button_style = 'button--pills'
    when 'none'
      assign button_style = ''
    else
      assign button_style = 'underline underline-offset-2 decoration-1 hover:decoration-2'
  endcase

  assign disabled_classes = ' disabled:opacity-60 disabled:cursor-not-allowed '
  assign type = type | default: 'button'
%}

<button
  type="{{ type }}"
  {% if name %}
    name="{{ name }}"
  {% endif %}
  {% if id %}
    id="{{ id }}"
  {% endif %}
  class="{{ button_style }} {{ classes | append: disabled_classes }}"
  {{ custom_attributes }}
>
  {{- content -}}
</button>
