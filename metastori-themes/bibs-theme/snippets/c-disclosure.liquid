{% comment %}
  Renders a disclosure component
  Accepts:
    - id {String}: id of the field
    - classes {String}: additional classes
    - type {String}: type of the disclosure
    - trigger {String}: label of the disclosure
    - trigger_classes {String}: additional classes for the trigger
    - trigger_attributes {String}: additional attributes for the trigger
    - content {String}: content of the disclosure
    - content_class {String}: additional classes for the content

  Usage:
    {% render 'c-disclosure' %}
{% endcomment %}

{% liquid
  case type
    when 'primary'
      assign type_class = 'button--primary'
    when 'secondary'
      assign type_class = 'button--secondary'
    when 'menu'
      assign type_class = 'link--menu'
    when 'link'
      assign type_class = 'link--hover'
    when 'pills'
      assign type_class = 'button--pills'
  endcase
%}

<c-disclosure class="disclosure {{ classes }}">
  <details
    tabindex="0"
    {% if classes %}
      class="{{ details_classes }}"
    {% endif %}
  >
    <summary
      class="disclosure__button{% if type_class %} {{ type_class }}{% endif %}{% if trigger_classes %} {{ trigger_classes }}{% endif %}"
      {{ trigger_attributes }}
    >
      {{ trigger }}
    </summary>
    <div class="disclosure__content{% if content_class %} {{ content_class }}{% endif %}">
      {{ content }}
    </div>
  </details>
</c-disclosure>
