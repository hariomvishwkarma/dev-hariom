{% liquid
  assign care_guides = product.metafields.overview.care_guide.value
  assign care_guide_instructions = product.metafields.overview.care_guide_instructions.value

  paginate care_guides by 2
    assign care_guides_length = paginate.items
  endpaginate
  paginate care_guide_instructions by 2
    assign care_guide_instructions_length = paginate.items
  endpaginate
%}

{%- if care_guides_length > 0 or care_guide_instructions_length > 0 -%}
  {%- capture care_guide_content -%}
    <div class="overflow-auto p-4">
      {%- if care_guides_length > 0 -%}
        <div class="care-guides">
          {% render 'c-text',
            translatable_content: 'sections.product-overview.care-guide.title',
            type: 'h5',
            classes: 'py-5 mb-4'
          %}

          <div class="space-y-1.5 pb-3">
            {%- for care_guide in care_guides -%}
              {% liquid
                assign icon = care_guide.icon.value.icon
                assign title = care_guide.text
              %}
              <div class="flex items-center gap-2">
                <span class="w-10 h-10 bg-grey-200 p-1 child:w-full child:h-full">{{ icon }}</span>
                {% render 'c-text', content: title, type: 'paragraph-2' %}
              </div>
            {%- endfor -%}
          </div>
        </div>
      {%- endif -%}

      {%- if care_guides_length > 0 and care_guide_instructions_length > 0 -%}
        <hr class="my-6 border-grey-300">
      {%- endif -%}

      {%- if care_guide_instructions_length > 0 -%}
        <div class="care-guides-instructions">
          {% render 'c-text',
            translatable_content: 'sections.product-overview.care-guide.instructions',
            type: 'h5',
            classes: 'py-3 mb-4'
          %}

          <div class="space-y-1.5 pb-3">
            {%- for care_guide_instruction in care_guide_instructions -%}
              {% liquid
                assign instruction = care_guide_instruction.instruction
              %}
              <ul class="flex items-center gap-2">
                <li>
                  {% render 'c-text', content: instruction, custom_tag: 'span', type: 'paragraph-2' %}
                </li>
              </ul>
            {%- endfor -%}
          </div>
        </div>
      {%- endif -%}
    </div>
  {%- endcapture -%}
  {%- capture care_guide_label -%}
      <div class="flex items-center gap-1 h7-bold">
        {% render 'c-icon', icon: 'washing-degree' %}
        {{ 'sections.product-overview.care-guide.label' | t }}
      </div>
    {%- endcapture -%}

  <div>
    {% render 'c-drawer',
      drawer_id: 'Care-guide-drawer',
      toggle_label: care_guide_label,
      toggle_type: 'button_outline--primary button--small bg-grey-200',
      drawer_content: care_guide_content,
      drawer_classes: 'bg-background',
      drawer_width: 'md'
    %}
  </div>
{%- endif -%}
