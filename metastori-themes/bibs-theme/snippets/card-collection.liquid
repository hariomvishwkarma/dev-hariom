{% comment %}
  Renders a collection card

  Accepts:
  - card_collection: {Object} Collection Liquid object
  - media_aspect_ratio {String}: The aspect ratio of the image


  Usage:
  {% render 'card-collection', card_collection: collection %}
{% endcomment %}

{% liquid
  assign media_aspect_ratio = media_aspect_ratio | default: section.settings.media_aspect_ratio

  case media_aspect_ratio
    when 'portrait'
      assign padding_bottom = 'before:pb-[133.33%]'

    else
      assign padding_bottom = 'before:pb-[100%]'
  endcase
%}

<div>
  <a
    href="{{ card_collection.url }}"
    class="flex relative before:content-[''] before:w-0 before:h-0 {{ padding_bottom }} child:absolute child:inset-0"
  >
    {% liquid
      if card_collection.featured_image != blank
        assign collection_image = card_collection.featured_image
      else
        assign collection_image = card_collection.products.first.image
      endif
      render 'c-image', image: collection_image
    %}
  </a>

  <a href="{{ card_collection.url }}" class="text-sm hover:underline hover:underline-offset-2">
    {%- if card_collection.title != blank -%}
      <p>{{ card_collection.title }}</p>
    {%- else -%}
      <p>{{ 'onboarding.collection_title' | t }}</p>
    {%- endif -%}
  </a>

  {%- if card_collection.description != blank -%}
    <p>
      {{- card_collection.description | strip_html | truncatewords: 12 -}}
    </p>
  {%- endif -%}
</div>
