{%- comment -%}
  Renders a full width article list item

  Accepts:
    - article {Object}: the article to render

  Usage:
    {% render 'card-article-featured', article: article %}
{%- endcomment -%}

{% if article.metafields.custom.featured_story_image %}
  {% assign card_image = article.metafields.custom.featured_story_image %}
{% else %}
  {% assign card_image = article.image %}
{% endif %}

<a class="no-underline" href="{{ article.url }}">
  <div class="md:min-h-80 flex h-full gap-0 md:gap-[30px] flex-col">
    {% render 'c-image', image: card_image, classes: 'h-full max-h-[475px] flex-1' %}
    <div class="flex-1">
      <div class="flex flex-row gap-2.5 flex-wrap mb-3 mt-[30px]">
        {% assign blog_category = article.metafields.custom.blog_category %}
        {% if blog_category != blank %}
          <span
            style="--text: {{blog_category.value.label_text_color}}; --bg: {{blog_category.value.label_color}}"
            class="py-1 px-2 border border-[var(--bg)] text-[var(--text)] bg-[var(--bg)] text-xs text-medium h-fit w-fit rounded-full whitespace-nowrap"
          >
            {{- blog_category.value.blog_name -}}
          </span>
        {% endif %}
        {% for tag in article.tags %}
          {% assign tag_edit = tag | replace: 'guides_', '' %}
          <span class="py-1 px-2 border border-foreground text-foreground text-xs text-medium h-fit w-fit rounded-full whitespace-nowrap">
            {{- tag_edit -}}
          </span>
        {% endfor %}
      </div>
      {% render 'c-text', content: article.title, type: 'h2', classes: 'mb-4' %}
      {% render 'c-richtext', content: article.excerpt, classes: 'block paragraph-2 mb-10' %}
      <div class="swiper-highlighter-cat">
        <div class="swiper-button-prev !left-9 after:pr-[2px] swiper-button-disabled"></div>
        <div class="swiper-button-next !right-9 after:pl-[2px] swiper-button-disabled"></div>
      </div>
    </div>
  </div>
</a>
