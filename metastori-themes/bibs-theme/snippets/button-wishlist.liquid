{% comment %}
  Shopify Wishlist

  Accepts:
    - product {Object}: Shopify product object
    - classes {String}: Additional classes to add to the button
    - icon_classes {String}:
    - add_text {Bool}
    - circle {Bool}

  Usage:
    {%- render 'button-wishlist', product: product -%}
    - Place this snippet inside your existing product card snippet
{% endcomment %}

{%- if product.handle != blank -%}
  <button
    type="button"
    aria-label="Add to wishlist"
    class="{{ classes }} flex {% if add_text %} flex-row gap-1.5 justify-end {% endif %}{% if circle %} items-center justify-center h-9 w-9 rounded-full border border-borders{% endif %}"
    button-wishlist
    data-product-handle="{{ product.handle }}"
    data-product-id="gid://shopify/Product/{{- product.id -}}"
  >
    {%- render 'c-icon', icon: 'heart', extra_classes: '!block', classes: icon_classes -%}
    {% if add_text -%}
      <span class="md:block hidden">{{ 'sections.cart.product_card.wishlist' | t }}</span>
    {%- endif %}
  </button>
{%- endif -%}
