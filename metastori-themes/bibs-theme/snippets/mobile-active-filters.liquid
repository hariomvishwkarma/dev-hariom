{%- comment -%}
  Renders the active filters line on a single filter category in the mobile filter modal

  Accepts:
    - filter {Object}: the filter to show active filters on

  Usage:
    {% render 'mobile-active-filters' %}
{%- endcomment -%}

<div
  id="MobileActiveFiltersContainer-{{- filter.label -}}"
  class="flex flex-wrap w-full text-base gap-1 mobile-active-filters sm:hidden select-none"
>
  {%- for filter_value in filter.active_values -%}
    {%- assign filter_value_label_array = filter_value.label | split: '_' -%}
    <span>
      {%- if filter_value_label_array.size > 1 -%}
        {{- filter_value_label_array[1] -}}
      {%- else -%}
        {{- filter_value_label_array -}}
      {%- endif -%}
      {%- unless forloop.index == filter.active_values.size -%},{%- endunless -%}
    </span>
  {%- endfor -%}
</div>
