{%- comment -%}
  Renders a modal

  Accepts:
    - modal_id {String}: sets the id of the modal
    - modal_placement {String}: sets the placement of the modal
    - modal_classes {String}: sets container classes of the modal
    - modal_content {String}: sets the content of the modal
    - modal_content_classes {String}: sets the classes of the content modal
    - modal_header {String}: sets the header of the modal
    - modal_footer {String}: sets the footer of the modal
    - modal_footer_classes {String}: sets the classes of the footer modal
    - toggle_label {String}: sets the label of the toggle button
    - close_classes {String}: sets the classes of the close button
    - modal_size {String}: sets the size of the modal

  Usage:
    {% render 'c-modal' %}
{%- endcomment -%}

{% liquid
  capture placement
    case modal_placement
      when 'top-left'
        echo 'justify-start items-start'
      when 'top-center'
        echo 'justify-center items-start'
      when 'top-right'
        echo 'justify-end items-start'
      when 'center-left'
        echo 'justify-start items-center'
      when 'center-right'
        echo 'justify-end items-center'
      when 'bottom-left'
        echo 'justify-start items-end'
      when 'bottom-center'
        echo 'justify-center items-end'
      when 'bottom-right'
        echo 'justify-end items-end'
      else
        echo 'justify-center items-center'
    endcase
  endcapture

  capture size
    case modal_size
      when 'small'
        echo 'max-w-sm'
      when 'medium'
        echo 'max-w-md'
      when 'large'
        echo 'max-w-lg'
      when 'xlarge'
        echo 'max-w-xl'
      when '2xlarge'
        echo 'max-w-2xl'
      when 'full'
        echo 'h-full max-w-full'
      else
        echo 'max-w-xl'
    endcase
  endcapture
%}

{% assign button_attributes = 'data-modal-target="' | append: modal_id | append: '" type="button"' %}

<!-- Modal toggle -->
{% if translatable_toggle_label %}
  {% assign toggle_label = translatable_toggle_label | t %}
{% endif %}

{% if button_style %}
  {% assign button_style = button_style %}
{% endif %}

{% if button_classes %}
  {% assign button_classes = button_classes %}
{% else %}
  {% assign button_classes = 'link' %}
{% endif %}

{% if toggle_label %}
  {% render 'c-button',
    classes: button_classes,
    content: toggle_label,
    custom_attributes: button_attributes,
    design: button_style
  %}
{% endif %}

<!-- Main modal -->
<div
  id="{{ modal_id }}"
  tabindex="-1"
  aria-hidden="true"
  class="fixed top-0 left-0 right-0 z-50 hidden w-full p-4 overflow-x-hidden overflow-y-auto inset-0 max-h-full {{ placement }} {{ modal_classes }}"
>
  <div class="relative w-full {{ size }} max-h-full">
    <!-- Modal content -->
    <div class="modal-content relative bg-background rounded shadow">
      <button
        type="button"
        class="absolute top-3 right-2.5 text-grey-400 bg-transparent hover:bg-grey-200 hover:text-grey-900 rounded text-sm p-1.5 ml-auto inline-flex items-center {{ close_classes }}"
        data-modal-hide
      >
        {% render 'c-icon' with icon: 'close', classes: 'w-6 h-6' %}
      </button>
      <!-- Modal header -->
      {% if modal_header %}
        <div class="modal-header flex items-start justify-between p-4 border-b rounded-t">{{ modal_header }}</div>
      {% endif %}
      <!-- Modal body -->
      {% if modal_content %}
        <div class="modal-body p-6 space-y-6 {{ modal_content_classes }}">
          {{ modal_content }}
        </div>
      {% endif %}
      <!-- Modal footer -->
      {% if modal_footer %}
        <div class="modal-footer flex items-center p-6 space-x-2 border-t border-grey-200 rounded-b {{ modal_footer_classes }}">
          {{ modal_footer }}
        </div>
      {% endif %}
    </div>
  </div>
</div>
