{%- comment -%}
  Renders footer newsletter block

  Accepts:
    - block: {Object} settings for the current block
    - class: {string} single or multiple classes
  Usage:
    {% render 'footer-newsletter', block: block.settings, class: 'basis-2/5' %}
{%- endcomment -%}

<div data-newsletter class="w-[446px] max-w-full lg:ml-auto">
  {% render 'c-text', translatable_content: 'newsletter.join', type: 'h5', classes: 'text-xl mb-3' %}
  <div id="newsletter-content">
    {% render 'c-text', translatable_content: 'newsletter.description', classes: 'text-sm mt-3' %}
    {% assign market = localization.market.handle | append: '' %}

    <form class="mt-7 space-y-3">
      {% render 'c-input',
        id: 'newsletter-name',
        input_name: 'name',
        input_translatable_placeholder: 'newsletter.name',
        extra_classes: 'border-grey-400 border-b'
      %}
      {% render 'c-input',
        id: 'newsletter-email',
        input_name: 'email',
        input_type: 'email',
        input_translatable_placeholder: 'newsletter.email',
        extra_classes: 'border-grey-400 border-b'
      %}
      {% render 'c-input',
        id: 'newsletter-market',
        input_name: 'market',
        input_type: 'text',
        extra_classes: 'hidden',
        input_value: market
      %}
      <label class="text-sm flex items-center select-none">
        <input type="checkbox" class="mr-1" required>
        <span>
          {{- 'newsletter.terms_and_conditions_html' | t: link: block.terms_link -}}
        </span>
      </label>
      {% render 'c-button',
        type: 'submit',
        translatable_content: 'newsletter.subscribe',
        design: 'accent',
        classes: 'rounded-full disabled:bg-grey-400 button--small',
        id: 'submit-contact'
      %}
    </form>
  </div>
  <div class="notify-status flex flex-col">
    <div
      id="newsletter-success"
      class="hidden mt-2 py-[9px] px-5 w-full"
    >
      <div class="flex flex-col gap-2">
        {% render 'c-text',
          custom_tag: 'h4',
          translatable_content: 'newsletter.subscription_success',
          classes: 'text-lg font-semibold'
        %}
        {% render 'c-text', translatable_content: 'newsletter.subscription_success_text', classes: 'text-sm' %}
      </div>
    </div>
    <div
      id="newsletter-error"
      class="hidden mt-4 py-[18px] px-5 bg-red-100 text-error rounded border border-error w-full"
    >
      {% render 'c-text', translatable_content: 'newsletter.subscription_error', classes: 'text-sm' %}
    </div>
  </div>
</div>
