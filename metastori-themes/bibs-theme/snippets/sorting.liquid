{%- comment -%}
  Renders sorting controls

  Accepts:
    - results: {Object} Collection or Search object
    - enable_sorting: {Boolean} Show sorting when true

  Usage:
    {% render 'sorting', results: results, enable_sorting: true %}
{%- endcomment -%}

<div
  class="sort-wrap flex justify-end flex-row items-baseline leading-8 sm:flex-wrap flex-nowrap"
  {% if mobile %}
    data-index="mobile-"
  {% else %}
    id="Sorting"
  {% endif %}
>
  <label
    for="SortBy"
    class="text-1xl sm:text-base whitespace-nowrap"
  >
    {{- 'products.facets.sort_by_label' | t -}}
  </label>

  <div class="sort-by-wrap bg-background flex relative flex-row items-center">
    <select
      id="SortBy"
      name="sort_by"
      class="sort-by-button bg-background custom-select pr-1 pl-1 cursor-pointer text-base font-semibold w-full"
    >
      {% assign sort_by = results.sort_by | default: 'best-selling' %}
      {% comment %} results.default_sort_by {% endcomment %}

      {%- for option in results.sort_options -%}
        {% unless option.value == 'title-ascending' or option.value == 'title-descending' %}
          <option
            value="{{ option.value | escape }}"
            {% if option.value == sort_by %}
              selected="selected"
            {% endif %}
          >
            {{ option.name | escape }}
          </option>
        {% endunless %}
      {%- endfor -%}
    </select>
    {% render 'c-icon', icon: 'flat-arrow-down', classes: 'w-2', extra_classes: 'pointer-events-none' %}
  </div>
</div>
