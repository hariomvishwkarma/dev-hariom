{%- comment -%}
  Renders icon with text block

  Accepts:
  - block: {Object} passes in the block information.


  Usage:
  {% render 'icon-with-text', block: block %}
{%- endcomment -%}

<ul class="border border-grey-300 rounded py-[18px] px-[20px] space-y-3 empty:hidden text-button">

  {% if block.settings.show_calcualted_shipping_usp and settings.free_cart_bar_enabled != blank %}
    {% render 'calculated-shipping-usp', block: block %}
  {% endif %}

  {%- for item in (1..4) -%}
    {%- liquid
      assign enable_id = 'show_usp_' | append: item
      assign icon_id = 'icon_' | append: item
      assign heading_id = 'heading_' | append: item
      assign custom_icon_id = 'custom_icon_' | append: item
      assign enable = block.settings[enable_id]
      assign icon = block.settings[icon_id]
      assign heading = block.settings[heading_id]
      assign custom_icon = block.settings[custom_icon_id]
    -%}
    {%- if enable -%}
      {%- if icon != blank or heading != blank -%}
        <li class="flex items-center gap-2 usp">
          {%- if custom_icon != blank -%}
            <img src="{{ custom_icon | img_url: '22x22' }}" alt="" class="w-[22px] h-[22px] shrink-0">
          {%- else -%}
            {% render 'c-icon', icon: icon, classes: 'w-[22px] h-[22px] shrink-0' %}
          {%- endif -%}
          {%- if heading != blank -%}
            <p class="text-2-medium">{{ heading }}</p>
          {%- endif -%}
        </li>
      {%- endif -%}
    {%- endif -%}
  {%- endfor -%}

</ul>