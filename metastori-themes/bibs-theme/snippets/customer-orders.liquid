{%- comment -%}
  Renders a list of orders for a customer.

  Accepts:
    - customer: The customer object to render orders for.
    - paginate_by: The number of orders to show per page. Defaults to 20.

  Usage:
    {% render 'customer-orders', customer: customer %}
{%- endcomment -%}

{%- assign paginate_by = paginate_by | default: 10 -%}

{% paginate customer.orders by paginate_by %}
  {%- if customer.orders.size > 0 -%}
    <div class="flex gap-4 md:gap-6 flex-col">
      {% for order in customer.orders %}
        {% liquid
          if order.pickup_in_store
            assign order_delivery = 'customer.order.store_pickup' | t
          else
            assign order_delivery = 'customer.order.home_delivery' | t
          endif

          if order.fulfillment_status == 'unfulfilled'
            assign order_stat_label = 'customer.order.new_order' | t
          else
            assign order_stat_label = 'customer.order.completed_order' | t
          endif

          assign order_date = order.created_at | date: '%d/%m/%Y'
        %}

        {% capture order_status %}
          {% if order.fulfillment_status == 'unfulfilled' %}
            <div class="flex basis-full items-center gap-2 pb-6">
              {% render 'c-icon', icon: 'clock' %}
              {% render 'c-text', content: order_stat_label, type: 'paragraph-2', classes: 'inline-block' %}
            </div>
          {% elsif order.fulfillment_status == 'fulfilled' %}
            <div class="flex basis-full items-center gap-2 pb-6">
              {% render 'c-icon', icon: 'checkmark', classes: 'w-5 h-5' %}
              {% render 'c-text', content: order_stat_label, type: 'paragraph-2', classes: 'inline-block' %}
            </div>
          {% endif %}
        {% endcapture %}

        <div data-order-card-container class="bg-grey-200 p-4 pt-6 pb-6">
          <div class="flex-wrap justify-between md:flex">
            {{ order_status }}

            <div class="flex gap-4 flex-wrap md:w-96">
              <div class="flex gap-2 flex-col basis-[45%] md:basis-28 md:order-2">
                {% render 'c-text',
                  translatable_content: 'customer.orders.order_no',
                  type: 'text-2-regular',
                  classes: 'text-grey-700'
                %}
                {% render 'c-text',
                  content: order.id,
                  type: 'text-1-regular',
                  custom_attributes: 'data-order-card-id'
                %}
              </div>
              <div class="flex gap-2 flex-col basis-[45%] md:basis-28 md:order-1">
                {% render 'c-text',
                  translatable_content: 'customer.orders.status',
                  type: 'text-2-regular',
                  classes: 'text-grey-700'
                %}
                {% render 'c-text', content: order_stat_label, type: 'text-1-regular' %}
              </div>
              <div class="flex gap-2 flex-col basis-[45%] md:basis-28 md:order-4">
                {% render 'c-text',
                  translatable_content: 'customer.orders.date',
                  type: 'text-2-regular',
                  classes: 'text-grey-700'
                %}
                {% render 'c-text', content: order_date, type: 'text-1-regular' %}
              </div>
              <div class="flex gap-2 flex-col basis-[45%] md:basis-28 md:order-6">
                {% render 'c-text',
                  translatable_content: 'customer.orders.items_num',
                  type: 'text-2-regular',
                  classes: 'text-grey-700'
                %}
                {% render 'c-text', content: order.item_count, type: 'text-1-regular' %}
              </div>
              <div class="flex gap-2 flex-col basis-[45%] md:basis-28 md:order-5">
                {% render 'c-text',
                  translatable_content: 'customer.orders.delivery',
                  type: 'text-2-regular',
                  classes: 'text-grey-700'
                %}
                {% render 'c-text', content: order_delivery, type: 'text-1-regular' %}
              </div>
              {% assign price = order.total_price | money %}
              <div class="flex gap-2 flex-col basis-[45%] md:basis-28 md:order-3">
                {% render 'c-text',
                  translatable_content: 'customer.orders.amount',
                  type: 'text-2-regular',
                  classes: 'text-grey-700'
                %}
                {% render 'c-text', content: price, type: 'text-1-regular' %}
              </div>
            </div>

            <div class="flex gap-2 mt-8 basis-full min-[972px]:mt-0 min-[972px]:basis-auto">
              {% for product in order.line_items limit: 3 %}
                {% assign img_classes = 'w-14 min-[1100px]:w-20 border-[1px] border-grey-300 self-start' %}
                {% if forloop.index == 3 %}
                  {% assign img_classes = img_classes | append: ' hidden md:block' %}
                {% endif %}
                {% render 'c-image',
                  image: product.image,
                  aspect_ratio: 'square',
                  image_width: '82px',
                  classes: img_classes
                %}
              {% endfor %}
              {% if order.item_count > 3 %}
                <div class="w-14 h-14 min-[1100px]:w-20 min-[1100px]:h-20 bg-background hidden md:flex justify-center items-center text-base">
                  {% assign length = order.item_count | minus: 3 %}
                  {{ length }}+
                </div>
              {% endif %}
            </div>

            {% capture view_details %}
            {% render 'c-icon', icon: 'visible_eye', classes: 'text-foreground w-[15px] h-[17px]' %} {{ 'customer.orders.view_details' | t }}
          {% endcapture %}

            {% capture track_order %}
            {% render 'c-icon', icon: 'location-pin', classes: 'text-foreground w-[15px] h-[17px]' %} {{ 'customer.orders.track_order' | t }}
          {% endcapture %}

            <div class="flex gap-4 mt-8 basis-full">
              {% render 'c-link',
                content: view_details,
                href: order.customer_url,
                classes: 'flex items-center gap-2 text-base decoration-grey-400',
                type: 'link'
              %}

              {% render 'c-link',
                content: track_order,
                href: last_order.order_status_url,
                classes: 'flex items-center gap-2 text-base decoration-grey-400',
                type: 'link'
              %}
            </div>
          </div>
        </div>
      {% endfor %}
    </div>
  {%- else -%}
    <div class="pt-6">
      {% render 'c-title',
        custom_tag: 'h4',
        type: 'h4',
        translatable_content: 'customer.orders.no_orders',
        classes: 'text-grey-500 mb-4'
      %}
      {% render 'c-text',
        translatable_content: 'customer.orders.page.description',
        type: 'text-1-regular',
        classes: 'text-grey-500'
      %}
    </div>
  {%- endif -%}

  {% render 'pagination', pagination: paginate %}
{% endpaginate %}
