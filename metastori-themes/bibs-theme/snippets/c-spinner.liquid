{%- comment -%}
  Renders a spinner component

  Accepts:
    - size {String}: Size of the spinners (Values: width and height classes)
    - color {String}: Color of the spinners [Default: primary] (Values: white)
    - stroke_opacity {String}: Opacity of the spinners

  Usage:
    {% render 'c-spinner', size: 'w-12 h-12', color: "white" %}
{%- endcomment -%}

{% liquid
  if color == 'white'
    assign color_class = 'text-white'
  endif

  assign stroke_opacity = stroke_opacity | default: 'stroke-opacity-5'
%}

<div
  class="{{ size }} {{ color_class }} {{ stroke_opacity }}"
  role="status"
>
  {% render 'c-icon', icon: 'spinner', classes: 'w-full h-full inline animate-spin-slow' %}
</div>
