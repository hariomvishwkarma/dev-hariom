{%- comment -%}
  Renders error messages for a form.

  Accepts:
    - form_errors: a list of errors to render
    - classes (optional)

  Usage:
    {% render 'form-errors', form: form %}
{%- endcomment -%}

{% if form_errors %}
  <ul class="text-sm text-left text-error font-medium leading-4 sm:ml-4 {{ classes }}">
    {%- for field in form_errors -%}
      <li>
        {{ form_errors.messages[field] }}
      </li>
    {%- endfor -%}
  </ul>
{% endif %}
