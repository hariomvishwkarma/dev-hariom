{%- comment -%}
  Renders a dropdown

  Accepts:
    - dropdown_id {String}: sets the id of the dropdown
    - toggle_label {String}: sets the label of the toggle button
    - dropdown_content {String}: sets the content of the dropdown
    - dropdown_toggle_class {String}: sets the class of the dropdown toggle
    - dropdown_content_class {String}: sets the class of the dropdown content
    - index {String}: sets the index of the dropdown

  Usage:
    {% render 'c-filters-dropdown' %}
{%- endcomment -%}

{% comment %} class 'details-has-popup' makes the details to close on outside click {% endcomment %}
<details class="relative details-has-popup js-filter" data-index="{{ index }}">
  <summary class="{{ dropdown_toggle_class }}">{{ toggle_label }}</summary>
  <div class="{{ dropdown_content_class }} absolute left-0 top-full w-80 shadow rounded z-10 font-normal bg-background divide-y divide-gray-100 mt-1">
    {{ dropdown_content }}
  </div>
</details>
