{%- comment -%}
  Renders a search bar with a search button and a search input field.

  Accepts:
  - filter {string}

  Usage:
    {% render 'filter-search-bar' %}
{%- endcomment -%}

{% capture search_icon %}
  <span class="absolute inset-y-0.5 left-0.5 flex aspect-square items-center justify-center search-btn">
    {% render 'c-icon', icon: 'search', classes: 'w-6 h-6' %}
  </span>
 {% endcapture %}

{% style %}
  :root {
    --logo-width: {{ block.settings.logo_width | default: '154' -}}px;
  }
{% endstyle %}

{%- capture search_form -%}
  <filter-search data-filter={{filter}} class="w-full pb-4 block">
      <div class="relative">
        {% liquid
          assign input_placeholder = 'general.search.search_bar.placeholder' | t
          render 'c-input', input_type: 'text', input_placeholder: input_placeholder, input_classes: 'clear_input pl-9 bg-background'
        %}
        {{search_icon}}
      </div>
  </filter-search>
{%- endcapture -%}

{{ search_form }}
