{% comment %}
  Accepts:
  - product_watermark_image {Object}: Product watermark image
  - watermark_size {String}: Watermark size
  Usage:
    {% render 'product-watermark', product_watermark_image: _ %}
{% endcomment %}

{% if product_watermark_image != null %}
  <div class="product-watermark">
    {{
      product_watermark_image
      | image_url: width: watermark_size, height: watermark_size
      | image_tag: alt: product_watermark_image.alt
    }}
  </div>
{% endif %}
