{%- comment -%}
  Renders a article list item

  Accepts:
    - article {Object}: the article to render

  Usage:
    {% render 'card-article-featured-stories', article: article %}
{%- endcomment -%}
{% assign card_image_hover = false %}
{% if article.metafields.custom.featured_story_image %}
  {% assign card_image = article.metafields.custom.featured_story_image %}
{% else %}
  {% assign card_image = article.image %}
{% endif %}
{% if article.metafields.custom.featured_image_hover %}
  {% assign card_image_hover = article.metafields.custom.featured_image_hover %}
{% endif %}
{% assign aspect_ratio = aspect_ratio | default: 'rectangle' %}
{% assign image_style = image_style | default: '' %}

<a
  href="{{ article.url }}"
  class="card-article grid relative overflow-hidden md:min-h-80 {% if card_image_hover %}has-secondary-image{% endif %}"
>
  {% render 'c-image',
    image: card_image,
    classes: 'card-article-main-img w-full',
    aspect_ratio: aspect_ratio,
    style: image_style,
    alt: article.title
  %}

  {% if card_image_hover %}
    {% render 'c-image',
      image: card_image_hover,
      classes: 'card-article-secondary-img w-full',
      aspect_ratio: aspect_ratio,
      style: image_style,
      alt: article.title
    %}
  {% endif %}

  <div class="hover-text md:max-w-[90%] text-white w-full flex-col items-start justify-end md:justify-start p-4 sm:p-6 absolute bottom-0 gap-2">
    {% assign excerpt_text = article.excerpt | strip_html | strip %}
    {% if excerpt_text != blank %}
      {% render 'c-text', content: excerpt_text, type: 'p', classes: '!block text-white max-w-[90%] line-clamp-2' %}
    {% endif %}
    {% render 'c-button',
      translatable_content: 'blog.read_more',
      design: 'outline--primary',
      classes: 'mt-3 md:mt-5 rounded-full shadow-none w-fit h-fit whitespace-nowrap self-start'
    %}
  </div>

  <div class="p-4 sm:p-6 absolute top-0">
    {% render 'c-text',
      content: article.title,
      classes: 'text-white !text-xl md:!text-2xl max-w-[90%] !leading-normal'
    %}
  </div>
</a>
