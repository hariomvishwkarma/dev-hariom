{%- comment -%}
  Renders a badge component
  Accepts:
    - classes {string}: (OPTIONAL) additional classes to be added to the badge
    - content {string}: (OPTIONAL) the content of the badge
    - color {string}: (OPTIONAL) the background color of the badge
    - data_attribute {string}: (OPTIONAL) the data attribute of the badge
    - label_color {string}: (OPTIONAL) the color of the badge text

  Usage:
    {% render 'c-badge', classes: "flex px-2", content: "Winter season", color: "#000000" %}
{%- endcomment -%}

{%- if content != blank -%}
  <span
    class="{{ classes }} product-label-wrapper"
    {% if data_attribute %}
      data-{{ data_attribute }}
    {% endif %}
    style="--label-color: {{ label_color }}; {% if color %}background-color: {{ color }};{% endif %}"
  >
    {{- content -}}
  </span>
{%- endif -%}
