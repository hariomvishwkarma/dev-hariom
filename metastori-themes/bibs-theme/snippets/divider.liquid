{%- comment -%}
  Renders a spacer of specific height

  Accepts:
    - height{String}: "normal" (20px) or "large" (40px)
    - classes{String}: Additional classes to apply to the spacer

  Usage:
    {% render 'spacer', height: "normal" %}
{%- endcomment -%}
{%- unless height == 'none' -%}
  {%- liquid
    case height
      when 'small'
        assign height_class = 'h-4 md:h-6'
      when 'normal'
        assign height_class = 'h-8 md:h-12'
      when 'large'
        assign height_class = 'h-10 md:h-20'
      when 'custom'
        assign custom_px = custom | append: 'px'
    endcase
  -%}

  {%- if height == 'custom' -%}
    <div class="divider {{ classes }} color-{{ color_scheme }}" style="height: {{ custom_px }};">&nbsp;</div>
  {%- else -%}
    <div class="divider {{ height_class }} {{ classes }}">&nbsp;</div>
  {%- endif -%}
{%- endunless -%}
