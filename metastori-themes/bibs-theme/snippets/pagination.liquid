{%- comment -%}
  Renders a simple pagination navigation

  Accepts:
    - pagination {Object}: the pagination object
    - classes {String}: classes added the the nav

  Usage:
    {% render 'pagination', pagination: pagination %}
{%- endcomment -%}

{% if pagination.pages > 1 %}
  <nav
    role="navigation"
    class="flex mx-auto items-center justify-center text-center pt-4 mt-4 border-current {{classes}}"
  >
    {% liquid
      assign pagination_classes_1 = 'p-2 border-grey-200 border-2 border-solid rounded-full mr-10 flex justify-center align-center font-semibold'
      assign extra_1 = ' bg-background'

      unless pagination.previous
        assign extra_1 = ' bg-grey-200 opacity-50 border-0'
      endunless

      assign pagination_classes_1 = pagination_classes_1 | append: extra_1

      capture icon_1
        render 'c-icon', icon: 'pagination_previous', classes: 'h-3.5 w-3.5'
      endcapture

      render 'c-link', type: 'link--bg-pagination', classes: pagination_classes_1, href: pagination.previous.url, content: icon_1
    %}

    {%- for part in pagination.parts -%}
      {% if part.is_link %}
        {% assign part_classes = 'px-2 py-3 h-6 w-10 items-center flex justify-center align-center font-semibold' %}
        {%- render 'c-link', classes: part_classes, href: part.url, content: part.title -%}
      {%- else -%}
        <span class="flex {% if part.title %} text-grey-400 justify-center font-bold{% endif %}">
          {% if pagination.current_page == part.title %}
            <div class="flex bg-foreground text-background px-2 py-1 m-auto font-bold justify-center items-center hover:cursor-pointer">
              {{- part.title -}}
            </div>
          {% else %}
            {{- part.title -}}
          {% endif %}
        </span>
      {%- endif -%}
    {%- endfor -%}

    {% liquid
      assign pagination_classes_2 = 'p-2 border-grey-200 border-2 border-solid rounded-full ml-10 flex justify-center align-center font-semibold'
      assign extra_2 = ' bg-background'

      unless pagination.next
        assign extra_2 = ' bg-grey-200 opacity-50 border-0'
      endunless

      assign pagination_classes_2 = pagination_classes_2 | append: extra_2

      capture icon_2
        render 'c-icon', icon: 'pagination_next', classes: 'h-3.5 w-3.5'
      endcapture

      render 'c-link', type: 'link--bg-pagination', classes: pagination_classes_2, href: pagination.next.url, content: icon_2
    %}
  </nav>
{% endif %}
