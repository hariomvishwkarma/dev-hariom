{%- comment -%}
  Renders footer payment icon

  Accepts:
    - icon: {Object} image icon
  Usage:
    {% render 'footer-payment-icon', icon: section.settings.icon_one %}
{%- endcomment -%}

{% if icon -%}
  <div>
    {{
      icon
      | image_url: width: 34, height: 23
      | image_tag: loading: 'lazy', widths: widths, class: 'rounded border border-solid border-grey-300'
    }}
  </div>
{%- endif -%}
