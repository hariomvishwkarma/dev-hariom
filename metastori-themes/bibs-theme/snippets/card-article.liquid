{%- comment -%}
  Renders a article list item

  Accepts:
    - article {Object}: the article to render

  Usage:
    {% render 'card-article', article: article %}
{%- endcomment -%}

{% assign card_image_hover = false %}
{% if article.metafields.custom.featured_story_image %}
  {% assign card_image = article.metafields.custom.featured_story_image %}
{% else %}
  {% assign card_image = article.image %}
{% endif %}
{% if article.metafields.custom.featured_image_hover %}
  {% assign card_image_hover = article.metafields.custom.featured_image_hover %}
{% endif %}

{% assign aspect_ratio = aspect_ratio | default: 'square' %}

<a
  href="{{ article.url }}"
  class="card-article grid relative md:min-h-80 {% if card_image_hover %}has-secondary-image{% endif %} {{classes}}"
>
  {% render 'c-image', image: card_image, classes: 'card-article-main-img', aspect_ratio: aspect_ratio %}

  {% if card_image_hover %}
    {% render 'c-image', image: card_image_hover, classes: 'card-article-secondary-img', aspect_ratio: aspect_ratio %}
  {% endif %}

  <div class="p-4 sm:p-6 absolute bottom-0 w-full">
    <div class="flex flex-row gap-2.5 flex-wrap mb-[9px] md:mb-6">
      {% assign blog_category = article.metafields.custom.blog_category %}
      {% if blog_category != blank %}
        <span
          style="--text: {{blog_category.value.label_text_color}}; --bg: {{blog_category.value.label_color}}"
          class="py-1 px-2 border border-[var(--bg)] text-[var(--text)] bg-[var(--bg)] text-xs text-medium h-fit w-fit rounded-full whitespace-nowrap"
        >
          {{- blog_category.value.blog_name -}}
        </span>
      {% endif %}
      {% for tag in article.tags %}
        {% assign tag_edit = tag | replace: 'guides_', '' %}
        <span class="py-1 px-2 border border-background text-background text-xs text-medium h-fit w-fit rounded-full whitespace-nowrap">
          {{- tag_edit -}}
        </span>
      {% endfor %}
    </div>
    {% render 'c-text', content: article.title, type: 'h4', classes: 'text-white truncate-3' %}
  </div>
</a>
