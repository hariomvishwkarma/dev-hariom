{%- comment -%}
  Renders a collapse

  Accepts:
    - collapse_id {String}: The id of the collapse
    - toggle_label {String}: The label of the toggle
    - collapse_content {String}: The content of the collapse
    - collapse_type {String}: The type of the collapse
    - classes {String}: The classes of the collapse
    - collapse_trigger_classes {String}: The classes of the collapse
    - collapse_content_class {String}: The class of the collapse content
    - no_focusOut {Boolean}: If true, the collapse will not close when clicking outside of it
    - menu_collapse {Boolean}: If true, the collapse will be a menu collapse
    - collapse_backdrop {Boolean}: If true, the collapse will have a backdrop

  Usage:
    {% render 'c-collapse' %}
{%- endcomment -%}

{% liquid
  case collapse_type
    when 'primary'
      assign collapse_type_class = 'button--primary'
    when 'secondary'
      assign collapse_type_class = 'button--secondary'
    when 'menu'
      assign collapse_type_class = 'link--menu'
    when 'link'
      assign collapse_type_class = 'link--hover'
    when 'pills'
      assign collapse_type_class = 'button--pills'
    else
      assign collapse_type_class = ''
  endcase
%}

<details
  tabindex="0"
  {% if menu_collapse %}
    data-menu-collapse
    data-backdrop="{{ collapse_backdrop }}"
  {% else %}
    data-collapse
  {% endif %}
  {% if classes %}
    class="{{ classes }}"
  {% endif %}
>
  <summary class="{{ collapse_type_class }}{% if collapse_trigger_classes %} {{ collapse_trigger_classes }}{% endif %}">
    {{ toggle_label }}
  </summary>

  <div class="{{ collapse_content_class }}">
    {{ collapse_content }}
  </div>
</details>
