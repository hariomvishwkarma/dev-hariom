{% comment %}
  Renders a checkbox field
  Accepts:
    - id {String}: The input id
    - radio_name {String}: The input name
    - radio_value {String}: The input value
    - classes {String}: Sets the container classes
    - label_content {String}: The label content
    - label_classes {String}: The label classes
    - label_translatable_content {String}: The label translatable content
    - helper_text {String}: The helper text
    - error_text {String}: The error text

  Usage:
    {% render 'c-radio' %}
{% endcomment %}

{% liquid
  if label_translatable_content
    assign label_content = label_translatable_content | t
  endif
%}

<input
  class="mt-[6px] self-start appearance-none p-[6px] border border-foreground rounded-full peer cursor-pointer"
  name="{{ radio_name }}"
  type="radio"
  id="{{ id }}"
  value="{{ radio_value }}"
  {{ custom_attributes }}
>
<span
  class="peer-checked:bg-foreground p-[3px] pr-[2.5px] absolute mt-[10px] ml-[4px] rounded-full"
></span>

{% if label_content %}
  <label class="{{ label_classes }}" for="{{ id }}">
    {% render 'c-text', type: 'paragraph-2', content: label_content %}
  </label>
{% endif %}
