{% comment %}
  Renders a contact form

  Accepts:
  - heading {String}:
  - intro_text {String}:
  - color_scheme {String}:
  - margin_bottom {String}:
  - container_classes {String}:
  - disable_container_fluid_class {Boolean}:
  - justify_left {Boolean}:
  - header_tag {String}:
  - include_company_inputs {Boolean}:

  Usage:
    {% render 'contact-form' %}
{% endcomment %}

{% liquid
  assign input_classes = 'autofill:text-foreground text-foreground bg-transparent text-sm items-center mx-5 py-3 w-full'
  assign textarea_classes = 'autofill:text-foreground text-foreground bg-transparent text-sm items-center px-5 py-3 w-full'
  assign input_container_classes = 'flex items-center'
  assign label_classes = 'block text-sm text-form'
  assign intro = intro_text | strip
  assign name_error = 'sections.contact-form.errors.name' | t
  assign email_error = 'sections.contact-form.errors.email' | t
  assign subject_error = 'sections.contact-form.errors.subject' | t
  assign message_body_error = 'sections.contact-form.errors.contact_msg_body' | t
  assign error_classes = 'mb-8 py-[18px] px-5 bg-red-100 text-error rounded border border-error w-full'
  assign heading_tag = header_tag | default: 'h2'
  assign required_icon = ' <span class="text-accent">*</span>'
%}

<div class="contact-form{% unless disable_container_fluid_class %} container-fluid{% endunless %} color-{{ color_scheme }}">
  <div class="{{ container_classes | default: 'max-w-4xl mx-auto' }}" id="contact-page">
    <form
      method="post"
      enctype="multipart/form-data"
      id="dixa-contact-form"
    >
      {% unless form.posted_successfully? %}
        <div data-validation-required class="flex justify-center flex-col">
          {% render 'c-title', custom_tag: heading_tag, content: heading, classes: 'w-52 sm:w-full mb-2' %}
          <div class="[&_a]:text-foreground [&_a]:font-bold [&_a:hover]:underline [&_a]:underline-offset-2 [&_a]:decoration-1 [&_a]:hover:decoration-2 [&_p]:text-base mb-6 md:mb-9">
            {% render 'c-text', custom_tag: 'div', classes: 'text-base', content: intro %}
          </div>

          <div class="grid md:grid-cols-2 gap-2.5 mb-2.5">
            <div data-auth-input class="relative rounded-full border-solid border border-borders flex">
              {% liquid
                assign name_label_content = 'sections.contact-form.name' | t | append: required_icon
                capture name_value
                  if form.name
                    echo form.name
                  elsif customer
                    echo customer.name
                  endif
                endcapture
              %}
              {% render 'c-input',
                id: 'contact_name',
                input_name: 'name',
                label_content: name_label_content,
                input_value: name_value,
                input_classes: input_classes,
                input_container_classes: input_container_classes,
                extra_classes: 'w-full',
                label_classes: label_classes
              %}
              <span class="right-4 flex items-center relative">
                {% render 'c-icon',
                  icon: 'checkmark',
                  classes: 'input-icon-success hidden top-[.9rem] right-4 text-success w-5 h-5 inline'
                %}
              </span>
            </div>

            <div data-auth-input class="relative rounded-full border-solid border border-borders flex">
              {% liquid
                assign email_label_content = 'sections.contact-form.email' | t | append: required_icon
                capture email_value
                  if form.email
                    echo form.email
                  elsif customer
                    echo customer.email
                  endif
                endcapture
              %}
              {% render 'c-input',
                input_type: 'email',
                id: 'contact_email',
                input_name: 'email',
                label_content: email_label_content,
                input_value: email_value,
                input_classes: input_classes,
                input_container_classes: input_container_classes,
                extra_classes: 'w-full',
                label_classes: label_classes
              %}
              <span class="right-4 flex items-center relative">
                {% render 'c-icon',
                  icon: 'checkmark',
                  classes: 'input-icon-success hidden top-[.9rem] right-4 text-success w-5 h-5 inline'
                %}
              </span>
              <span class="right-4 flex items-center relative">
                {% render 'c-icon',
                  icon: 'bolder_close',
                  classes: 'input-icon-invalid hidden top-[.9rem] right-4 text-error w-5 h-5 inline'
                %}
              </span>
            </div>
          </div>

          {%- if include_company_inputs -%}
            <div class="grid md:grid-cols-2 gap-2.5 mb-2.5">
              <div data-auth-input class="relative rounded-full border-solid border border-borders flex">
                {% liquid
                  assign company_label_content = 'sections.contact-form.company' | t
                %}
                {% render 'c-input',
                  id: 'company_name',
                  input_name: 'name',
                  label_content: company_label_content,
                  input_classes: input_classes,
                  input_container_classes: input_container_classes,
                  extra_classes: 'w-full',
                  label_classes: label_classes
                %}
                <span class="right-4 flex items-center relative">
                  {% render 'c-icon',
                    icon: 'checkmark',
                    classes: 'input-icon-success hidden top-[.9rem] right-4 text-success w-5 h-5 inline'
                  %}
                </span>
              </div>

              <div data-auth-input class="relative rounded-full border-solid border border-borders flex">
                {% assign cvr_label_content = 'sections.contact-form.cvr' | t %}
                {% render 'c-input',
                  input_type: 'cvr',
                  id: 'contact_cvr',
                  input_name: 'cvr',
                  label_content: cvr_label_content,
                  input_value: cvr_value,
                  input_classes: input_classes,
                  input_container_classes: input_container_classes,
                  extra_classes: 'w-full',
                  label_classes: label_classes
                %}
              </div>
            </div>
          {%- else -%}
            <div class="grid md:grid-cols-2 gap-2.5 mb-2.5">
              <div data-auth-input class="relative rounded-full border-solid border border-borders flex">
                {% liquid
                  assign order_number_label_content = 'sections.contact-form.order_number' | t
                %}

                {% render 'c-input',
                  id: 'contact_order_number',
                  input_name: 'order_number',
                  label_content: order_number_label_content,
                  input_classes: input_classes,
                  input_container_classes: input_container_classes,
                  extra_classes: 'w-full',
                  label_classes: label_classes
                %}
                <span class="right-4 flex items-center relative">
                  {% render 'c-icon',
                    icon: 'checkmark',
                    classes: 'input-icon-success hidden top-[.9rem] right-4 text-success w-5 h-5 inline'
                  %}
                </span>
              </div>

              <div data-auth-input class="relative rounded-full border-solid border border-borders flex">
                {% liquid
                  assign subject_label_content = 'sections.contact-form.subject' | t | append: required_icon
                  assign contact_form_subjects = shop.metaobjects.contact_form_subjects.values
                %}
                {%- if contact_form_subjects -%}
                  {%- capture subject_options -%}
                    <option selected disabled value></option>
                    {%- for subject in contact_form_subjects -%}
                      <option value="{{ subject.subject_line }}_{{ subject.form_url }}">
                        {{ subject.subject_line }}
                      </option>
                    {%- endfor -%}
                  {%- endcapture -%}

                  {% render 'c-select',
                    id: 'contact_subject',
                    name: 'subject_data',
                    options: subject_options,
                    label_content: subject_label_content,
                    custom_arrow: true,
                    required: true
                  %}
                {%- else -%}
                  {% render 'c-input',
                    id: 'contact_subject',
                    input_name: 'subject',
                    label_content: subject_label_content,
                    input_value: subject_value,
                    input_classes: input_classes,
                    input_container_classes: input_container_classes,
                    extra_classes: 'w-full',
                    label_classes: label_classes
                  %}
                {%- endif -%}
              </div>
            </div>
          {%- endif -%}

          <div data-auth-input class="mb-2.5 rounded-2xl border-solid border border-borders">
            {%- assign body_label_content = 'sections.contact-form.message' | t | append: required_icon -%}
            {% render 'c-textarea',
              id: 'contact_body',
              textarea_name: 'message',
              textarea_value: form.body,
              label_content: body_label_content,
              textarea_classes: textarea_classes,
              rows: 7
            %}
          </div>

          <div class="mb-8 mt-2.5">
            <label
              for="attachments"
              class="custom-file-upload cursor-pointer py-3 px-5 border border-borders rounded-full"
            >
              Custom Upload
            </label>
            <input type="file" accept="image/*,.pdf,.doc" name="attachments" id="attachments" class="hidden">
          </div>

          <div class="contact-form--errors">
            <span class="hidden {{error_classes}}" data-error-for="contact_name" data-error-text>{{ name_error }}</span>
            <span class="hidden {{error_classes}}" data-error-for="contact_email" data-error-text>
              {{- email_error -}}
            </span>
            <span class="hidden {{error_classes}}" data-error-for="contact_subject" data-error-text>
              {{- subject_error -}}
            </span>
            <span class="hidden {{error_classes}}" data-error-for="contact_body" data-error-text>
              {{- message_body_error -}}
            </span>
          </div>

          {%- assign submit_button_content = 'sections.contact-form.submit' | t -%}
          {% capture btn_classes %}
            rounded-full disabled:bg-grey-400 self-center w-[252px] max-w-full {% if justify_left %} md:self-start {% endif %}
          {% endcapture %}
          {% render 'c-button',
            type: 'submit',
            content: submit_button_content,
            design: 'accent-secondary',
            classes: btn_classes,
            id: 'submit-contact'
          %}
        </div>
      {% endunless %}
    </form>
    <div data-success class="hidden">
      {% liquid
        assign successful_submition_title = 'sections.contact-form.submitted.title' | t
        assign successful_submition_desc = 'sections.contact-form.submitted.description' | t
        render 'c-title', custom_tag: 'h2', content: successful_submition_title, classes: 'max-w-5xl mb-4 md:mb-8'
        render 'c-text', custom_tag: 'p', content: successful_submition_desc, classes: 'text-base max-w-xl'
      %}
    </div>
  </div>
</div>
{% render 'divider', height: margin_bottom, color_scheme: section.settings.color_scheme %}
