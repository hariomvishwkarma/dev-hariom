<script type="text/javascript">
  window.collectionPageHandle = function(){
      const productName = "{{ product.title | remove: "'" | remove: '"' }}";
      const productId = "{{ product.id }}";

      const productPrice = "{{ product.price | money_without_currency }}";
      const productBrand = "{{ product.vendor | remove: "'" | remove: '"' }}";
      const productCollection = "{{ product.collections.first.title | remove: "'" | remove: '"' }}"
      const productCurrency = "{{ shop.currency }}"
      window.dataLayer = window.dataLayer || [];
      dataLayer.push({
          event: "view_item_list",
          ecommerce: {
              items: [
                  {% for product in collection.products %}
                      {
                          item_id: '{{ product.id }}',
                          item_name: '{{ product.title | remove: "'" | remove: '"' }}',
                          item_brand: '{{ product.vendor | remove: "'" | remove: '"' }}',
                          item_category: '{{ product.collections[0].title | remove: "'" | remove: '"' }}',
                          price: '{{ product.price | times: 0.01}}',
                          quantity: 1
                      } {% unless forloop.last %}, {% endunless%}
                  {% endfor%}
              ]
          }
      });
  };
  collectionPageHandle();
</script>
