{% liquid
  assign grid_columns = section.settings.number_of_columns
  case grid_columns
    when 2
      assign grid_class = 'md:grid-cols-2'
    when 3
      assign grid_class = 'md:grid-cols-3'
    when 4
      assign grid_class = 'md:grid-cols-4'
    when 5
      assign grid_class = 'md:grid-cols-5'
    when 6
      assign grid_class = 'md:grid-cols-6'
    when 7
      assign grid_class = 'md:grid-cols-7'
    when 8
      assign grid_class = 'md:grid-cols-8'
    else
      assign grid_class = 'md:grid-cols-3'
  endcase

  assign heading_title = section.settings.title
  assign heading_tag = section.settings.heading_tag
  assign font_size = section.settings.font_size
  assign font_weight = section.settings.font_weight
  assign heading_type = font_size | append: ' ' | append: font_weight
  assign media_aspect_ratio = section.settings.media_aspect_ratio
  case media_aspect_ratio
    when 'square'
      assign aspect_ratio = 'md:aspect-square'
      assign aspect_ratio_mobile = 'aspect-square'
      assign double_aspect_ratio = 'md:aspect-2'
      assign double_aspect_ratio_mobile = 'aspect-2'
    when 'rectangle'
      assign aspect_ratio = 'md:aspect-rectangle'
      assign aspect_ratio_mobile = 'aspect-rectangle'
      assign double_aspect_ratio = 'md:aspect-5/2'
      assign double_aspect_ratio_mobile = 'aspect-5/2'
    else
      assign aspect_ratio = 'md:aspect-portrait'
      assign aspect_ratio_mobile = 'aspect-portrait'
      assign double_aspect_ratio = 'md:aspect-6/4'
      assign double_aspect_ratio_mobile = 'aspect-6/4'
  endcase

  assign section_width = section.settings.section_width
  case section_width
    when 'contained'
      assign container_class = 'container-fluid'
    else
      assign container_class = ''
  endcase

  assign total_blocks = section.blocks.size
  assign modulo = total_blocks | modulo: grid_columns
  assign remainder = grid_columns | minus: modulo
  assign full_rows = total_blocks | divided_by: grid_columns | floor
  assign remainder_mobile = total_blocks | modulo: 2
  assign full_rows_mobile = total_blocks | divided_by: 2 | floor
%}
<div class="{{ container_class }} color-{{ section.settings.color_scheme }} mb-[2px]">
  {% if heading_title != blank %}
    <div class="container-fluid pb-5">
      {% render 'c-title', custom_tag: heading_tag, type: heading_type, content: heading_title %}
    </div>
  {% endif %}

  <div class="grid grid-cols-2 {{ grid_class }} gap-[2px]">
    {% for block in section.blocks %}
      {% liquid
        case block.type
          when 'collection'
            if block.settings.collection.metafields.custom.featured_category_image
              assign block_image = block.settings.collection.metafields.custom.featured_category_image
            else
              assign block_image = block.settings.collection.image
            endif
            assign btn_text = block.settings.collection.title
            assign btn_link = block.settings.collection.url
            assign alt_text = btn_text | append: ' collection'

          when 'custom'
            assign header_text = block.settings.header_text
            assign block_image = block.settings.image
            assign btn_text = block.settings.text
            assign btn_link = block.settings.url
            assign alt_text = btn_text | append: ' collection'
        endcase

        assign double_width = false

        assign y = forloop.index0 | divided_by: grid_columns | floor
        assign second_last_index = total_blocks | minus: 1
        if full_rows == y and remainder > 0
          if remainder == 1 and forloop.index == total_blocks
            assign double_width = true
          elsif remainder == 2 and forloop.index == total_blocks
            assign double_width = true
          elsif remainder == 2 and forloop.index == second_last_index
            assign double_width = true
          endif
        endif

        assign y_mobile = forloop.index0 | divided_by: 2 | floor
        if full_rows_mobile == y_mobile and remainder_mobile > 0
          if remainder_mobile == 1 and forloop.index == total_blocks
            assign double_width_mobile = true
          elsif remainder_mobile == 2 and forloop.index == total_blocks or remainder_mobile == 2 and forloop.index == second_last_index
            assign double_width_mobile = true
          endif
        endif

        if double_width
          assign aspect_ratio = double_aspect_ratio
        endif
        if double_width_mobile
          assign aspect_ratio_mobile = double_aspect_ratio_mobile
        endif
      %}

      {% if block_image != blank and btn_text != blank and btn_link != blank %}
        <div
          class="category-grid-block relative h-full {{aspect_ratio}} {{aspect_ratio_mobile}} {% if double_width_mobile %} col-span-2 {% endif %} {% if double_width %} md:col-span-2 {% else %} md:col-span-1 {% endif %}"
        >
          <a href="{{btn_link}}">
            {% render 'c-image',
              image: block_image,
              classes: 'w-full h-full',
              loading: 'lazy',
              alt: alt_text,
              lazy: 'true'
            %}
          </a>
          <div
            class="absolute bottom-[10%] md:bottom-[13%] left-2/4 -translate-x-2/4 flex flex-col items-center gap-4 md:gap-5 text-center w-max max-w-full px-2"
          >
            {% if header_text != blank %}
              {% render 'c-title', content: header_text, custom_tag: 'h4', classes: 'text-white' %}
            {% endif %}
            {% render 'c-link',
              content: btn_text,
              classes: 'button--primary button--small rounded-full w-fit',
              href: btn_link
            %}
          </div>
        </div>
      {% endif %}
    {% endfor %}
  </div>
</div>
{% render 'divider',
  height: section.settings.margin_bottom,
  custom: section.settings.margin_bottom_custom,
  color_scheme: section.settings.color_scheme
%}

{% schema %}
