{% liquid
  assign grid_columns_desktop = section.settings.number_of_columns
  assign color_scheme = section.settings.color_scheme

  case grid_columns_desktop
    when 2
      assign grid_class_desktop = 'md:grid-cols-2'
    when 3
      assign grid_class_desktop = 'md:grid-cols-3'
    when 4
      assign grid_class_desktop = 'md:grid-cols-4'
    when 5
      assign grid_class_desktop = 'md:grid-cols-5'
    when 6
      assign grid_class_desktop = 'md:grid-cols-6'
    when 7
      assign grid_class_desktop = 'md:grid-cols-7'
    when 8
      assign grid_class_desktop = 'md:grid-cols-8'
    else
      assign grid_class_desktop = 'md:grid-cols-3'
  endcase

  assign grid_columns_mobile = section.settings.number_of_columns_mobile
  case grid_columns_mobile
    when 1
      assign grid_class_mobile = 'grid-cols-1'
    when 2
      assign grid_class_mobile = 'grid-cols-2'
    when 3
      assign grid_class_mobile = 'grid-cols-3'
  endcase

  assign column_alignment = section.settings.alignment
  case column_alignment
    when 'left'
      assign alignment_classes = 'text-left items-start'
    when 'center'
      assign alignment_classes = 'text-center items-center'
    when 'right'
      assign alignment_classes = 'text-right items-end'
  endcase

  assign title_description_alignment = section.settings.title_description_alignment
  case title_description_alignment
    when 'left'
      assign title_description_alignment_classes = 'text-left items-start'
    when 'center'
      assign title_description_alignment_classes = 'text-center items-center'
    when 'right'
      assign title_description_alignment_classes = 'text-right items-end'
  endcase

  assign heading_tag = section.settings.heading_tag
  assign font_size = section.settings.font_size
  assign font_weight = section.settings.font_weight
  assign heading_type = font_size | append: ' ' | append: font_weight
  assign italic_header_text = section.settings.italic_header_text
  if italic_header_text
    assign heading_type = heading_type | append: ' !italic'
  endif
  assign section_title_text = section.settings.section_title_text
  assign section_title_font_size = section.settings.section_title_font_size
  assign section_title_font_weight = section.settings.section_title_font_weight
  assign section_description_richtext = section.settings.section_description_richtext
  assign section_heading_type = section_title_font_size | append: ' ' | append: section_title_font_weight

  if section.settings.border_between_icons
    if section.settings.use_small_gaps
      assign grid_gap_classes = 'gap-y-4 gap-x-0'
    else
      assign grid_gap_classes = 'gap-y-9 gap-x-0 md:gap-y-12'
    endif
    assign column_side_spacing_classes = 'px-5 md:px-[21px]'
  else
    if section.settings.use_small_gaps
      assign grid_gap_classes = 'gap-4'
    else
      assign grid_gap_classes = 'gap-y-9 gap-x-4 md:gap-12'
    endif

    if section.settings.apply_margins_side
      assign column_side_spacing_classes = 'px-5 md:px-[21px]'
    endif
  endif
%}

{% style %}
  #shopify-section-{{ section.id }} {
    --custom-bg-color: {{ section.settings.custom_bg_color }};
    --custom-title-color: {{ section.settings.title_color }};
    --custom-text-color: {{ section.settings.text_color }};
    --custom-button-color: {{ section.settings.button_color }};
    --section-padding-y: {{ section.settings.padding_y }}px;
    --section-padding-y-mobile: {{ section.settings.padding_y_mobile }}px;
  }
  #shopify-section-{{ section.id }} .button--primary {
    background: var(--custom-button-color);
  }
  #shopify-section-{{ section.id }} .button_outline--primary {
    color: var(--custom-button-color);
    border-color: var(--custom-button-color);
  }
  #shopify-section-{{ section.id }} .section-title-text {
    padding:20px 0;
  }
  #shopify-section-{{ section.id }} .image_size {
    width:{{  section.settings.image_size }}%;
  }
  @media screen and (min-width: 768px) {
    #shopify-section-{{ section.id }} .text-columns-item--with-border {
      border-left: 0;
    }
    #shopify-section-{{ section.id }} .text-columns-item--with-border:not(:nth-child({{ grid_columns_desktop }}n + 1)) {
      border-left: 1px solid rgba(var(--color-foreground), 0.2);
    }
  }
{% endstyle %}

<div class="container-fluid color-{{ color_scheme }} py-[var(--section-padding-y-mobile)] md:py-[var(--section-padding-y)]">
  <div class="title-description {{ title_description_alignment_classes }} pb-8">
    {% if section_title_text %}
      {% render 'c-title',
        content: section_title_text,
        custom_tag: heading_tag,
        type: section_heading_type,
        classes: 'section-title-text'
      %}
    {% endif %}
    {% if section_description_richtext %}
      {% render 'c-richtext', content: section_description_richtext %}
    {% endif %}
  </div>
  <div class="grid {{ grid_class_mobile }} {{ grid_class_desktop }} {{ grid_gap_classes }} w-fit mx-auto">
    {% for block in section.blocks %}
      <div class="text-columns-item flex flex-col gap-3.5 {{ alignment_classes }} rounded {% if section.settings.apply_margins_top %} py-6 md:py-7.5 {% endif %} {{ column_side_spacing_classes }} max-w-[323px] md:max-w-[258px] w-full{% if section.settings.border_between_icons %} text-columns-item--with-border{% endif %}">
        {% if block.settings.icon %}
          {% render 'c-image', image: block.settings.icon, classes: 'image_size', image_fit: 'contain' %}
        {% endif %}
        {% if block.settings.title %}
          {% render 'c-title', content: block.settings.title, custom_tag: heading_tag, type: heading_type %}
        {% endif %}
        {% if block.settings.text %}
          {% render 'c-text', content: block.settings.text %}
        {% endif %}
      </div>
    {% endfor %}
  </div>
  {% if section.settings.link_text != blank or section.settings.richtext != blank %}
    <div class="flex flex-col items-center gap-6 text-center pt-16">
      {% if section.settings.link_text != blank and section.settings.link_url != blank %}
        {% liquid
          assign btn_style = section.settings.btn_style
          case btn_style
            when 'primary_wide'
              assign btn_classes = 'button--primary rounded-full shadow-none max-w-full w-[252px] h-fit'
            when 'primary_standard'
              assign btn_classes = 'button--primary rounded-full shadow-none w-fit h-fit'
            when 'outlined_wide'
              assign btn_classes = 'button_outline--primary rounded-full shadow-none max-w-full w-[252px] h-fit'
            when 'outlined_standard'
              assign btn_classes = 'button_outline--primary rounded-full shadow-none w-fit h-fit'
          endcase
        %}
        {% render 'c-link',
          href: section.settings.link_url,
          content: section.settings.link_text,
          classes: btn_classes
        %}
      {% endif %}
      {% if section.settings.richtext != blank %}
        {% liquid
          assign richtext = section.settings.richtext
          if richtext contains '[' and richtext contains ']'
            assign opening_tag = '<span class="text-accent">'
            assign content = richtext | replace: '[', opening_tag | replace: ']', '</span>'
          else
            assign content = richtext
          endif
        %}
        {% render 'c-richtext', content: content, classes: 'text-[var(--custom-text-color)]' %}
      {% endif %}
    </div>
  {% endif %}
  {% render 'divider',
    height: section.settings.margin_bottom,
    custom: section.settings.margin_bottom_custom,
    color_scheme: color_scheme
  %}
</div>

