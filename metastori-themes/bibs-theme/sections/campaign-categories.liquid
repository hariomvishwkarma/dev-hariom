{% liquid
  assign slide_quantity_desktop = section.settings.carousel_slide_quantity_desktop
  assign slide_quantity_ipad = section.settings.carousel_slide_quantity_ipad
  assign slide_quantity_mobile_landsc = section.settings.carousel_slide_quantity_mobile_landsc
  assign slide_quantity_mobile_bigger = section.settings.carousel_slide_quantity_mobile_bigger
  assign slide_quantity_mobile = section.settings.carousel_slide_quantity_mobile

  capture slide_quantity_mobile_smaller
    if slide_quantity_mobile > 1
      echo 1.5
    else
      echo 1
    endif
  endcapture
%}

{%- capture swiper_options -%}
  {
    "slidesPerView": 1,
    "spaceBetween": 20,
    "grabCursor": true,
    "breakpoints": {
      "270": {
        "slidesPerView": {{ slide_quantity_mobile_smaller }}
      },
      "380": {
        "slidesPerView": {{ slide_quantity_mobile }}
      },
      "550": {
        "slidesPerView": {{ slide_quantity_mobile_bigger }}
      },
      "800": {
        "slidesPerView": {{ slide_quantity_mobile_landsc }}
      },
      "1000": {
        "slidesPerView": {{ slide_quantity_ipad }}
      },
      "1224": {
        "slidesPerView": {{ slide_quantity_desktop }}
      }
    },
    "navigation": {
      "nextEl": ".swiper-button-next",
      "prevEl": ".swiper-button-prev"
    },
    "scrollbar": {
      "el": ".swiper-scrollbar",
      "draggable": true
    }
  }
{%- endcapture -%}
{%- capture swiper_attribute -%}
  data-swiper='{{- swiper_options -}}'
{%- endcapture -%}

<div class="color-{{ section.settings.color_scheme }} {% if section.settings.section_width == "full_right" %}container-fluid--l{% else %}container-fluid{% endif %}">
  <div class="swiper swiper-card swiper-highlighter-cat !pb-[2px]" {{ swiper_attribute }}>
    <div class="swiper-wrapper items-stretch">
      {% for block in section.blocks %}
        {% if block.settings.collection != blank %}
          {% assign url = block.settings.collection.url %}
          {% assign image = block.settings.collection.image %}
        {% elsif block.settings.page != blank %}
          {% assign url = block.settings.page.url %}
          {% assign image = block.settings.page_image %}
        {% endif %}
        <a
          href="{{ url }}"
          class="swiper-slide h-auto relative {% if section.settings.color_scheme %} color-{{ section.settings.color_scheme }} {% endif %}"
        >
          <div class="h-full flex justify-end gap-2 flex-col">
            {% render 'c-image', aspect_ratio: 'rectangle', image: image, classes: 'w-full overflow-hidden' %}
            <div class="info pb-5 pt-3 px-5 flex-1">
              {% render 'c-title', content: block.settings.heading, custom_tag: 'div', classes: 'h7-bold' %}
              {% render 'c-text', content: block.settings.title, type: 'h3-bold', classes: 'mb-4 md:mb-20 mt-2' %}
              {% if block.settings.button_text != blank %}
                <div class="button--primary py-1 hidden md:block rounded-full h7-bold mt-4 w-fit">
                  {{ block.settings.button_text }}
                </div>
              {% endif %}
            </div>
          </div>
        </a>
      {% endfor %}
    </div>

    <div class="swiper-button-prev !left-9 after:pr-[2px]"></div>
    <div class="swiper-button-next !right-9 after:pl-[2px]"></div>

    <div class="swiper-scrollbar !left-0"></div>
  </div>
</div>
{% render 'divider',
  height: section.settings.margin_bottom,
  custom: section.settings.margin_bottom_custom,
  color_scheme: color_scheme
%}

{% schema %}
{
  "name": "t:sections.campaign_categories.name",
  "tag": "section",
  "class": "section-campaign-categories",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "background-1"
    },
    {
      "type": "header",
      "content": "t:sections.campaign_categories.settings.header__1.content"
    },
    {
      "type": "range",
      "id": "carousel_slide_quantity_desktop",
      "min": 2,
      "max": 5.5,
      "step": 0.5,
      "label": "t:sections.campaign_categories.settings.carousel_slide_quantity_desktop.label",
      "default": 4.5
    },
    {
      "type": "range",
      "id": "carousel_slide_quantity_ipad",
      "min": 2,
      "max": 4.5,
      "step": 0.5,
      "label": "t:sections.campaign_categories.settings.carousel_slide_quantity_ipad.label",
      "default": 3.5
    },
    {
      "type": "range",
      "id": "carousel_slide_quantity_mobile_landsc",
      "min": 1,
      "max": 3.5,
      "step": 0.5,
      "label": "t:sections.campaign_categories.settings.carousel_slide_quantity_mobile_landsc.label",
      "default": 2.5
    },
    {
      "type": "range",
      "id": "carousel_slide_quantity_mobile_bigger",
      "min": 1,
      "max": 2.5,
      "step": 0.5,
      "label": "t:sections.campaign_categories.settings.carousel_slide_quantity_mobile_bigger.label",
      "default": 2.5
    },
    {
      "type": "range",
      "id": "carousel_slide_quantity_mobile",
      "min": 1,
      "max": 2,
      "step": 0.5,
      "label": "t:sections.campaign_categories.settings.carousel_slide_quantity_mobile.label",
      "default": 2
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "t:sections.all.section_width.label",
      "options": [
        {
          "label": "t:sections.all.section_width.normal",
          "value": "normal"
        },
        {
          "label": "t:sections.all.section_width.full_right",
          "value": "full_right"
        }
      ],
      "default": "full_right"
    },
    {
      "type": "header",
      "content": "t:sections.all.margin.heading"
    },
    {
      "type": "select",
      "id": "margin_bottom",
      "label": "t:sections.all.margin.margin_bottom.label",
      "options": [
        {
          "label": "t:sections.all.margin.margin_bottom.none",
          "value": "none"
        },
        {
          "label": "t:sections.all.margin.margin_bottom.small",
          "value": "small"
        },
        {
          "label": "t:sections.all.margin.margin_bottom.normal",
          "value": "normal"
        },
        {
          "label": "t:sections.all.margin.margin_bottom.large",
          "value": "large"
        },
        {
          "label": "t:sections.all.margin.margin_bottom.custom.label",
          "value": "custom"
        }
      ],
      "default": "none"
    },
    {
      "type": "range",
      "min": 0,
      "max": 100,
      "default": 16,
      "step": 1,
      "label": "t:sections.all.margin.margin_bottom.custom.value",
      "visible_if": "{{ section.settings.margin_bottom == 'custom' }}",
      "unit": "px",
      "id": "margin_bottom_custom"
    }
  ],
  "blocks": [
    {
      "type": "content",
      "name": "t:sections.campaign_categories.blocks.featured_content.name",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "t:sections.campaign_categories.blocks.featured_content.settings.heading.label"
        },
        {
          "type": "textarea",
          "id": "title",
          "label": "t:sections.campaign_categories.blocks.featured_content.settings.title.label"
        },
        {
          "type": "collection",
          "id": "collection",
          "label": "t:sections.campaign_categories.blocks.featured_content.settings.collection.label"
        },
        {
          "type": "page",
          "id": "page",
          "label": "t:sections.campaign_categories.blocks.featured_content.settings.page.label"
        },
        {
          "type": "header",
          "content": "t:sections.campaign_categories.blocks.featured_content.settings.page_header.content"
        },
        {
          "type": "image_picker",
          "id": "page_image",
          "label": "t:sections.campaign_categories.blocks.featured_content.settings.image.label"
        },
        {
          "type": "text",
          "id": "button_text",
          "label": "t:sections.campaign_categories.blocks.featured_content.settings.button_text.label"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:sections.campaign_categories.name"
    }
  ]
}
{% endschema %}
