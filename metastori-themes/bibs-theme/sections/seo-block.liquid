{% liquid
  assign heading_tag = section.settings.heading_tag
  assign font_size = section.settings.font_size
  assign font_weight = section.settings.font_weight
  assign heading_type = font_size | append: ' ' | append: font_weight
  assign italic_header_text = section.settings.italic_header_text
  if italic_header_text
    assign heading_type = heading_type | append: ' !italic'
  endif
%}
<div class="container-fluid mx-12 color-{{ section.settings.color_scheme }}">
  <div class="px-4 py-10 sm:px-9 md:px-[100px] md:pt-16 md:pb-20">
    {% render 'c-title',
      custom_tag: heading_tag,
      type: heading_type,
      content: section.settings.seo_section_title,
      classes: 'mb-2'
    %}
    <div class="lg:flex gap-4">
      {% if section.settings.first_block_content != blank %}
        <div class="basis-1/2 [&_a]:text-link ">
          {% render 'c-title',
            custom_tag: 'h2',
            type: 'h7-medium',
            content: section.settings.first_block_title,
            classes: 'mb-4 mt-6 md:mb-6'
          %}
          {% render 'c-text',
            param: value,
            content: section.settings.first_block_content,
            type: 'text-2-regular',
            classes: 'text-grey-500'
          %}
        </div>
      {% endif %}
      {% if section.settings.second_block_content != blank %}
        <div class="basis-1/2 [&_a]:text-link ">
          {% render 'c-title',
            custom_tag: 'h2',
            type: 'h7-medium',
            content: section.settings.second_block_title,
            classes: 'mb-4 mt-6 md:mb-6'
          %}
          {% render 'c-text',
            param: value,
            content: section.settings.second_block_content,
            type: 'text-2-regular',
            classes: 'text-grey-500'
          %}
        </div>
      {% endif %}
    </div>
  </div>
</div>
{% render 'divider',
  height: section.settings.margin_bottom,
  custom: section.settings.margin_bottom_custom,
  color_scheme: section.settings.color_scheme
%}

{% schema %}
{
  "name": "t:sections.seo_block.name",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "background-1"
    },
    {
      "type": "text",
      "id": "seo_section_title",
      "label": "t:sections.seo_block.settings.seo_section_title.label"
    },
    {
      "type": "select",
      "label": "t:sections.all.heading_tag.label",
      "id": "heading_tag",
      "default": "h6",
      "options": [
        {
          "value": "h1",
          "label": "t:sections.all.heading_tag.options.h1"
        },
        {
          "value": "h2",
          "label": "t:sections.all.heading_tag.options.h2"
        },
        {
          "value": "h3",
          "label": "t:sections.all.heading_tag.options.h3"
        },
        {
          "value": "h4",
          "label": "t:sections.all.heading_tag.options.h4"
        },
        {
          "value": "h5",
          "label": "t:sections.all.heading_tag.options.h5"
        },
        {
          "value": "h6",
          "label": "t:sections.all.heading_tag.options.h6"
        }
      ]
    },
    {
      "type": "select",
      "label": "t:sections.all.font_size.label",
      "id": "font_size",
      "default": "",
      "options": [
        {
          "value": "",
          "label": "t:sections.all.font_size.options.default"
        },
        {
          "value": "paragraph-1",
          "label": "t:sections.all.font_size.options.paragraph"
        },
        {
          "value": "h1",
          "label": "t:sections.all.font_size.options.h1"
        },
        {
          "value": "h2",
          "label": "t:sections.all.font_size.options.h2"
        },
        {
          "value": "h3",
          "label": "t:sections.all.font_size.options.h3"
        },
        {
          "value": "h4",
          "label": "t:sections.all.font_size.options.h4"
        },
        {
          "value": "h5",
          "label": "t:sections.all.font_size.options.h5"
        },
        {
          "value": "h6",
          "label": "t:sections.all.font_size.options.h6"
        }
      ]
    },
    {
      "type": "select",
      "label": "t:sections.all.font_weight.label",
      "id": "font_weight",
      "default": "!font-normal",
      "options": [
        {
          "value": "",
          "label": "t:sections.all.font_weight.options.default"
        },
        {
          "value": "!font-thin",
          "label": "t:sections.all.font_weight.options.thin"
        },
        {
          "value": "!font-light",
          "label": "t:sections.all.font_weight.options.light"
        },
        {
          "value": "!font-normal",
          "label": "t:sections.all.font_weight.options.normal"
        },
        {
          "value": "!font-medium",
          "label": "t:sections.all.font_weight.options.medium"
        },
        {
          "value": "!font-semibold",
          "label": "t:sections.all.font_weight.options.semibold"
        },
        {
          "value": "!font-bold",
          "label": "t:sections.all.font_weight.options.bold"
        }
      ]
    },
    {
      "type": "checkbox",
      "id": "italic_header_text",
      "label": "t:sections.all.italic_header_text.label",
      "default": false
    },
    {
      "type": "header",
      "content": "t:sections.seo_block.settings.first_block_header.content"
    },
    {
      "type": "text",
      "id": "first_block_title",
      "label": "t:sections.seo_block.settings.first_block_title.label"
    },
    {
      "type": "textarea",
      "id": "first_block_content",
      "label": "t:sections.seo_block.settings.first_block_content.label"
    },
    {
      "type": "header",
      "content": "t:sections.seo_block.settings.second_block_header.content"
    },
    {
      "type": "text",
      "id": "second_block_title",
      "label": "t:sections.seo_block.settings.second_block_title.label"
    },
    {
      "type": "textarea",
      "id": "second_block_content",
      "label": "t:sections.seo_block.settings.second_block_content.label"
    },
    {
      "type": "header",
      "content": "t:sections.all.margin.heading"
    },
    {
      "type": "select",
      "id": "margin_bottom",
      "label": "t:sections.all.margin.margin_bottom.label",
      "options": [
        {
          "label": "t:sections.all.margin.margin_bottom.none",
          "value": "none"
        },
        {
          "label": "t:sections.all.margin.margin_bottom.small",
          "value": "small"
        },
        {
          "label": "t:sections.all.margin.margin_bottom.normal",
          "value": "normal"
        },
        {
          "label": "t:sections.all.margin.margin_bottom.large",
          "value": "large"
        },
        {
          "label": "t:sections.all.margin.margin_bottom.custom.label",
          "value": "custom"
        }
      ],
      "default": "none"
    },
    {
      "type": "range",
      "min": 0,
      "max": 100,
      "default": 16,
      "step": 1,
      "label": "t:sections.all.margin.margin_bottom.custom.value",
      "visible_if": "{{ section.settings.margin_bottom == 'custom' }}",
      "unit": "px",
      "id": "margin_bottom_custom"
    }
  ],
  "presets": [
    {
      "name": "t:sections.seo_block.name"
    }
  ]
}
{% endschema %}
