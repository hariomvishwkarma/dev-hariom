<div id="cart">
  <div class="container-fluid color-{{ section.settings.color_scheme }}">
    {% if cart.item_count > 0 %}
      <h1>{{ 'sections.cart.title' | t }}</h1>
      <form action="{{ routes.cart_url }}" method="POST" novalidate id="cart-form">
        <table class="w-full">
          <thead>
            <th>{{ 'cart.image' | t }}</th>
            <th>{{ 'cart.product' | t }}</th>
            <th>{{ 'cart.quantity' | t }}</th>
            <th>{{ 'cart.price' | t }}</th>
            <th></th>
          </thead>
          <tbody>
            {% for item in cart.items %}
              <tr>
                <td>
                  <a href="{{ item.url }}">
                    <div class="max-w-[5rem]">
                      {% render 'c-image', image: item.image, aspect_ratio: 'square' %}
                    </div>
                  </a>
                </td>
                <td>
                  <a href="{{ item.url }}">{{ item.product.title | truncatewords: 5 }}</a>
                  <span>{{ item.variant.title }}</span>
                </td>
                <td>
                  <button
                    class="update-cart"
                    data-line-item-id="{{ item.id }}"
                    data-quantity="{{ item.quantity | minus: 1 }}"
                  >
                    -
                  </button>
                  {{ item.quantity }}
                  <button
                    class="update-cart"
                    data-line-item-id="{{ item.id }}"
                    data-quantity="{{ item.quantity | plus: 1 }}"
                  >
                    +
                  </button>
                </td>
                <td>
                  {{ item.line_price | money }}
                </td>
                <td>
                  <button
                    class="update-cart"
                    data-line-item-id="{{ item.id }}"
                    data-quantity="0"
                    data-tooltip="{{ 'customer.tool_tip.trash' | t }}"
                  >
                    {% render 'c-icon', icon: 'trash', extra_classes: 'pointer-events-none' %}
                  </button>
                </td>
              </tr>
            {% endfor %}
          </tbody>
        </table>

        <div class="flex flex-col md:flex-row gap-2 my-4">
          <div class="flex-1">
            <div class="max-w-xl flex flex-col">
              <label for="cart_notes">{{ 'cart.cart_notes' | t }}</label>
              <textarea name="note" id="cart_notes" class="border"></textarea>
            </div>
          </div>
          <div class="flex flex-col items-end">
            <div>{{ 'cart.sub_total' | t }}: {{ cart.original_total_price | money }}</div>
            <div>{{ 'cart.discount' | t }}: {{ cart.total_discount | money }}</div>
            <div>{{ 'cart.total' | t }}: {{ cart.total_price | money }}</div>
            {% comment %} Removing the accept terms and contitions because it is not needed. {% endcomment %}
            {% comment %}
              <div class="flex gap-1">
                <input type="checkbox" id="terms-and-conditions">
                <label for="terms-and-conditions">
                  {{ 'cart.terms_and_conditions_html' | t }}
                </label>
              </div>
            {% endcomment %}
            {%- assign checkout_button_content = 'cart.checkout' | t -%}
            {% render 'c-button',
              type: 'submit',
              name: 'checkout',
              design: 'primary',
              content: checkout_button_content,
              classes: 'mt-3'
            %}
          </div>
        </div>
      </form>
    {% else %}
      <h1>{{ 'cart.empty.title' | t }}</h1>
      <a href="{{ routes.all_products_collection_url }}">{{ 'cart.continue_shopping' | t }}</a>
    {% endif %}
  </div>
</div>

{% schema %}
{
  "name": "Template Cart",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "background-1"
    }
  ]
}
{% endschema %}
