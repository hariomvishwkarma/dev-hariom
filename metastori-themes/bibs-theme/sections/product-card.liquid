{% comment %}
  Shopify Wishlist
  Usage:
    - Pass the product object as a snippet variable named 'product'
{% endcomment %}

{% render 'card-product', card_product: product, show_secondary_media: true, media_aspect_ratio: 'bibs' %}

{% schema %}
{
  "name": "Product Card",
  "tag": "section",
  "class": "section-product-card",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "background-1"
    }
  ],
  "enabled_on": {
    "templates": ["product"]
  },
  "presets": [
    {
      "name": "Product Card"
    }
  ]
}
{% endschema %}
