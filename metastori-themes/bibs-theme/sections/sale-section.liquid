{% liquid
  assign color_scheme = section.settings.color_scheme

  assign image = section.settings.image_select
  assign video = section.settings.video_select

  assign text_headline = section.settings.text_headline
  assign text_sub_headline = section.settings.text_sub_headline
  assign text_description = section.settings.text_description

  assign font_size_headline = section.settings.font_size_headline
  assign font_size_sub = section.settings.font_size_sub
  assign font_size_description = section.settings.font_size_description

  assign font_weight_headline = section.settings.font_weight_headline
  assign font_weight_sub = section.settings.font_weight_sub
  assign font_weight_description = section.settings.font_weight_description

  assign flip_text = section.settings.flip_text
  assign image_link = section.settings.image_link

  assign button_text_1 = section.settings.button_text_1
  assign button_text_2 = section.settings.button_text_2
  assign button_link_1 = section.settings.button_link_1
  assign button_link_2 = section.settings.button_link_2

  assign headline_classes = ' ' | append: font_size_headline | append: ' ' | append: font_weight_headline
  assign sub_headline_classes = ' ' | append: font_size_sub | append: ' ' | append: font_weight_sub
  assign description_classes = ' ' | append: font_size_description | append: ' ' | append: font_weight_description
%}

<div class="flex {% if flip_text == true %}flex-col md:flex-row {% else %}flex-col-reverse md:flex-row-reverse {% endif %} w-full justify-center max-h-[650px] overflow-hidden color-{{ color_scheme }}">
  {% if text_headline != empty
    or text_sub_headline != empty
    or text_description != empty
    or button_text_1 != empty
    or button_text_2 != empty
  %}
    <div class="flex flex-col justify-center items-center text-center w-full md:w-1/2 gap-4 {% if flip_text == true %}mb-4 md:mb-0{% else %}mt-4 md:mt-0{% endif %}">
      {% if text_headline != empty %}
        {% render 'c-text', content: text_headline, classes: headline_classes %}
      {% endif %}
      {% if text_sub_headline != empty %}
        {% render 'c-title', content: text_sub_headline, classes: sub_headline_classes %}
      {% endif %}
      {% if text_description != empty %}
        {% render 'c-text', content: text_description, classes: description_classes %}
      {% endif %}
      <div class="flex flex-row gap-4">
        {% liquid
          assign button_classes = 'rounded-full md:w-auto shadow-none w-fit'
        %}
        {% if button_text_1 and button_link_1 %}
          {% render 'c-link',
            type: 'button--primary',
            content: button_text_1,
            classes: button_classes,
            href: button_link_1
          %}
        {% endif %}
        {% if button_text_2 and button_link_2 %}
          {% render 'c-link',
            type: 'button--primary',
            content: button_text_2,
            classes: button_classes,
            href: button_link_2
          %}
        {% endif %}
      </div>
    </div>
  {% endif %}
  {% if video or image %}
    {% if image_link != blank %}
      <a href="{{ image_link }}" class="w-full md:w-1/2">
    {% else %}
      <div class="w-full md:w-1/2">
    {% endif %}
    {% if image %}
      <div class="{% if video %}hidden{% endif %}">
        {% render 'c-image', image: image %}
      </div>
    {% endif %}
    {% if video %}
      {% render 'c-video' with video: video, autoplay: true, loop: true, muted: true %}
    {% endif %}
    {% if image_link != blank %}
      </a>
    {% else %}
      </div>
    {% endif %}
  {% endif %}
</div>

