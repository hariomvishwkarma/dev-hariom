<div class="color-{{ section.settings.color_scheme }} container-fluid py-16 md:py-32">
  <div class="mb-16">
    {% liquid
      for block in section.blocks
        case block.type
          when 'logo'
            render 'logo', block: block, classes: 'flex-1 md:flex-none justify-center'
        endcase
      endfor

      assign heading_tag = section.settings.heading_tag
      assign font_size = section.settings.font_size
      assign font_weight = section.settings.font_weight
      assign heading_type = font_size | append: ' ' | append: font_weight
      assign italic_header_text = section.settings.italic_header_text
      if italic_header_text
        assign heading_type = heading_type | append: ' !italic'
      endif
    %}
  </div>

  {% render 'c-title',
    translatable_content: 'password.coming_soon',
    custom_tag: heading_tag,
    type: heading_type,
    classes: 'text-center mb-16'
  %}

  {% form 'storefront_password', class: 'max-w-lg mx-auto mb-16' %}
    <div class="flex flex-wrap space-x-4">
      <input
        type="password"
        id="Password"
        name="password"
        placeholder="{{ 'form.password' | t }}"
        class="bg-grey-50 border border-grey-300 text-grey-700 text-sm rounded block w-full p-2.5 flex-1"
        required
      >

      {%- assign submit_button_content = 'action.sign_in' | t -%}
      {% render 'c-button',
        type: 'submit',
        content: submit_button_content,
        design: 'primary',
        classes: 'rounded-full'
      %}
    </div>
  {% endform %}

  <div class="text-sm text-center">
    {{ 'password.store_owner' | t }}
    <a href="/admin" class="link">
      {{- 'action.log_in' | t -}}
    </a>
  </div>
</div>

{% schema %}
{
  "name": "t:sections.main-password.name",
  "class": "section-main-password",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "background-1"
    }
  ],
  "blocks": [
    {
      "name": "t:sections.main-password.blocks.logo.name",
      "type": "logo",
      "limit": 1,
      "settings": [
        {
          "type": "image_picker",
          "id": "logo",
          "label": "t:sections.main-password.blocks.logo.settings.logo.label"
        },
        {
          "type": "image_picker",
          "id": "logo_alt",
          "label": "t:sections.main-password.blocks.logo.settings.logo_alt.label"
        },
        {
          "type": "range",
          "id": "logo_width",
          "min": 20,
          "max": 200,
          "step": 2,
          "default": 100,
          "unit": "px",
          "label": "t:sections.main-password.blocks.logo.settings.logo_width.label",
          "info": "t:sections.main-password.blocks.logo.settings.logo_width.info"
        },
        {
          "type": "select",
          "label": "t:sections.all.heading_tag.label",
          "id": "heading_tag",
          "default": "h5",
          "options": [
            {
              "value": "h1",
              "label": "t:sections.all.heading_tag.options.h1"
            },
            {
              "value": "h2",
              "label": "t:sections.all.heading_tag.options.h2"
            },
            {
              "value": "h3",
              "label": "t:sections.all.heading_tag.options.h3"
            },
            {
              "value": "h4",
              "label": "t:sections.all.heading_tag.options.h4"
            },
            {
              "value": "h5",
              "label": "t:sections.all.heading_tag.options.h5"
            },
            {
              "value": "h6",
              "label": "t:sections.all.heading_tag.options.h6"
            }
          ]
        },
        {
          "type": "select",
          "label": "t:sections.all.font_size.label",
          "id": "font_size",
          "default": "",
          "options": [
            {
              "value": "",
              "label": "t:sections.all.font_size.options.default"
            },
            {
              "value": "paragraph-1",
              "label": "t:sections.all.font_size.options.paragraph"
            },
            {
              "value": "h1",
              "label": "t:sections.all.font_size.options.h1"
            },
            {
              "value": "h2",
              "label": "t:sections.all.font_size.options.h2"
            },
            {
              "value": "h3",
              "label": "t:sections.all.font_size.options.h3"
            },
            {
              "value": "h4",
              "label": "t:sections.all.font_size.options.h4"
            },
            {
              "value": "h5",
              "label": "t:sections.all.font_size.options.h5"
            },
            {
              "value": "h6",
              "label": "t:sections.all.font_size.options.h6"
            }
          ]
        },
        {
          "type": "select",
          "label": "t:sections.all.font_weight.label",
          "id": "font_weight",
          "default": "",
          "options": [
            {
              "value": "",
              "label": "t:sections.all.font_weight.options.default"
            },
            {
              "value": "!font-thin",
              "label": "t:sections.all.font_weight.options.thin"
            },
            {
              "value": "!font-light",
              "label": "t:sections.all.font_weight.options.light"
            },
            {
              "value": "!font-normal",
              "label": "t:sections.all.font_weight.options.normal"
            },
            {
              "value": "!font-medium",
              "label": "t:sections.all.font_weight.options.medium"
            },
            {
              "value": "!font-semibold",
              "label": "t:sections.all.font_weight.options.semibold"
            },
            {
              "value": "!font-bold",
              "label": "t:sections.all.font_weight.options.bold"
            }
          ]
        },
        {
          "type": "checkbox",
          "id": "italic_header_text",
          "label": "t:sections.all.italic_header_text.label",
          "default": false
        }
      ]
    }
  ]
}
{% endschema %}
