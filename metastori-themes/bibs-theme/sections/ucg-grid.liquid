<div class="container-fluid color-{{ section.settings.color_scheme }}">
  {% render 'c-title', content: section.settings.title, custom_tag: 'h3', classes: 'mb-4' %}

  {% render 'c-text', content: section.settings.description, type: 'paragraph-2', classes: 'mb-6' %}
  <div class="grid grid-cols-2 grid-rows-4 sm:grid-cols-4 sm:grid-rows-4 gap-5">
    {% for entry in shop.metaobjects.ucg.values limit: 10 %}
      {% liquid
        if forloop.index == 1
          assign col_span = 'col-span-2'
          assign row_span = 'row-span-2'
        elsif forloop.index == 6
          assign col_span = 'col-span-2 sm:col-span-1'
          assign row_span = 'row-span-2 sm:row-span-1'
        elsif forloop.index == 10
          assign col_span = 'sm:col-start-3 sm:col-span-2'
          assign row_span = 'sm:row-start-3 sm:row-span-2'
        else
          assign col_span = 'sm:col-span-1'
          assign row_span = 'sm:row-span-1'
        endif
      %}
      <div class="{{ col_span }} {{ row_span }} relative">
        <a href="{{ entry.link }}" target="_blank">
          {% render 'c-image', image: entry.image, classes: 'w-full h-full' %}
          <div class="absolute bottom-3 left-3 text-xs text-background flex items-center">
            {% render 'c-icon', icon: 'instagram_media', classes: 'w-3 h-3 white inline mr-1' %}
            {{ entry.user }}
          </div>
        </a>
      </div>
    {% endfor %}
  </div>
</div>
{% render 'divider',
  height: section.settings.margin_bottom,
  custom: section.settings.margin_bottom_custom,
  color_scheme: section.settings.color_scheme
%}

{% schema %}
{
  "name": "UCG grid",
  "tag": "section",
  "class": "section-ucg-grid",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "background-1"
    },
    {
      "type": "text",
      "id": "title",
      "default": "Spotted on social",
      "label": "Title"
    },
    {
      "type": "text",
      "id": "description",
      "default": "Description",
      "label": "Description"
    },
    {
      "type": "header",
      "content": "t:sections.all.margin.heading"
    },
    {
      "type": "select",
      "id": "margin_bottom",
      "label": "t:sections.all.margin.margin_bottom.label",
      "options": [
        {
          "label": "t:sections.all.margin.margin_bottom.none",
          "value": "none"
        },
        {
          "label": "t:sections.all.margin.margin_bottom.small",
          "value": "small"
        },
        {
          "label": "t:sections.all.margin.margin_bottom.normal",
          "value": "normal"
        },
        {
          "label": "t:sections.all.margin.margin_bottom.large",
          "value": "large"
        },
        {
          "label": "t:sections.all.margin.margin_bottom.custom.label",
          "value": "custom"
        }
      ],
      "default": "none"
    },
    {
      "type": "range",
      "min": 0,
      "max": 100,
      "default": 16,
      "step": 1,
      "label": "t:sections.all.margin.margin_bottom.custom.value",
      "visible_if": "{{ section.settings.margin_bottom == 'custom' }}",
      "unit": "px",
      "id": "margin_bottom_custom"
    }
  ],
  "presets": [
    {
      "name": "UCG grid"
    }
  ]
}
{% endschema %}
