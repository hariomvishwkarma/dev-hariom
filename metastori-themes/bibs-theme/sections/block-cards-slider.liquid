<style>
  .section-bcs-header {
    flex-direction: column;
    text-align: {{ section.settings.text_alignment }};
    align-items: {{ section.settings.text_alignment }};
  }
  .bcs-card {
      padding: 10px;
  }
  .section-{{ section.id }} .swiper-card .swiper-slide{
    padding:10px;
  }
  .bcs-text {
    padding: 1.25rem 0 10px;
    font-size: 16px;
    text-align: {{ section.settings.text_alignment }};
    font-weight: bold;
    line-height: 1.4;
  }
  .section-{{ section.id }} .swiper-pagination-bullet {
      width: 9px;
      height: 9px;
      background: #b1b1b1;
      margin: 5px !important;
  }
</style>

{% assign desktop_slides = section.settings.number_of_cards_to_show %}
{% assign mobile_slides = section.settings.number_of_cards_to_show_mobile %}
{%- capture swiper_options -%}
  {
    "slidesPerView": {{ mobile_slides }},
    "spaceBetween": 0,
    "loop": false,
    "pagination": {
      "el": ".bcs-pagination",
      "clickable": true
    },
    "navigation": {
      "nextEl": ".bcs-next",
      "prevEl": ".bcs-prev"
    },
    "breakpoints": {
      "768": {
        "slidesPerView": {{ desktop_slides }}
      }
    },
    "scrollbar": {
      "el": ".swiper-scrollbar",
      "draggable": true
    }
  }
  {%- endcapture -%}

{%- capture swiper_attribute -%}
    data-swiper='{{- swiper_options -}}'
  {%- endcapture -%}

{% liquid
  assign heading_title = section.settings.title
  assign description = section.settings.description
  assign heading_tag = section.settings.heading_tag
  assign font_size = section.settings.font_size
  assign font_weight = section.settings.font_weight
  assign heading_type = font_size | append: ' ' | append: font_weight
  assign media_aspect_ratio = section.settings.media_aspect_ratio

  assign all_blocks_empty = true
  for block in section.blocks
    if block.settings.collection != blank
      assign all_blocks_empty = false
    endif
  endfor
%}

{%- unless all_blocks_empty -%}
  {% render 'divider',
    height: section.settings.margin_top,
    custom: section.settings.margin_top_custom,
    color_scheme: section.settings.color_scheme
  %}
  <div class="bcs-main section-{{ section.id }}">
    <div class="color-{{ section.settings.color_scheme }}">
      <div class="section-bcs-header flex gap-4 items-center container-fluid mb-3">
        {%- if heading_title != blank -%}
          {% render 'c-title', custom_tag: heading_tag, type: heading_type, content: heading_title %}
        {%- endif -%}
        {%- if description != blank -%}
          <div class="bcs-description">{{ description }}</div>
        {%- endif -%}
      </div>

      <div class="mt-[2px] container-fluid">
        <div id="bcs-content-{{ section.id }}" class="bcs-slider">
          <div
            class="swiper swiper-card !pb-[2px]"
            {{ swiper_attribute }}
          >
            <div class="swiper-wrapper secondary-wrapper">
              {% for block in section.blocks %}
                {% assign link = blank %}
                {% if block.settings.link != blank %}
                  {% assign link = block.settings.link %}
                {% elsif block.settings.collection != blank %}
                  {% assign link = block.settings.collection.url %}
                {% endif %}

                <div class="swiper-slide">
                  {% if link != blank -%}
                    <a class="bcs-card" href="{{ link }}">
                  {%- else %}
                    <div class="bcs-card">
                  {% endif %}
                  <div class="bcs-card-image">
                    {% if block.settings.image != blank %}
                      {% render 'c-image',
                        image: block.settings.image,
                        classes: 'card-bcs-img h-full w-full',
                        aspect_ratio: media_aspect_ratio,
                        image_fit: 'object-cover'
                      %}
                    {% elsif block.settings.collection != blank %}
                      {% render 'c-image',
                        image: block.settings.collection.featured_image,
                        classes: 'card-bcs-img h-full w-full',
                        aspect_ratio: media_aspect_ratio,
                        image_fit: 'object-cover'
                      %}
                    {% else %}
                      {{ 'image' | placeholder_svg_tag: 'w-full h-full fill-grey-600 bg-gray-100 bcs-placeholder' }}
                    {% endif %}
                  </div>
                  <div class="bcs-card-content">
                    {% if block.settings.text != blank %}
                      <h4 class="bcs-text">{{ block.settings.text }}</h4>
                    {% elsif block.settings.collection != blank %}
                      <h4 class="bcs-text">{{ block.settings.collection.title }}</h4>
                    {% endif %}
                  </div>
                  {% if link != blank %}</a>{% else %}</div>{% endif %}
                </div>
              {%- endfor -%}
            </div>
            <div class="swiper-highlighter-cat">
              <div class="swiper-button-prev bcs-prev !left-9 after:pr-[2px] swiper-button-disabled"></div>
              <div class="swiper-button-next bcs-next !right-9 after:pl-[2px] swiper-button-disabled"></div>
            </div>

            <div class="swiper-pagination bcs-pagination"></div>

            <div class="swiper-scrollbar !left-0 hidden"></div>
          </div>
        </div>
      </div>
    </div>
  </div>
  {% render 'divider',
    height: section.settings.margin_bottom,
    custom: section.settings.margin_bottom_custom,
    color_scheme: section.settings.color_scheme
  %}
{%- endunless -%}

