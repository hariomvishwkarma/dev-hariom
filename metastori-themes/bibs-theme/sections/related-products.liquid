      "step": 1,
      "default": 4,
      "label": "t:sections.related-products.settings.products_to_show_mobile.label"
    },
    {
      "type": "range",
      "id": "products_on_row_large",
      "label": "Products on row for large screens",
      "min": 4,
      "max": 10,
      "step": 1,
      "default": 10
    },
    {
      "type": "range",
      "id": "products_on_row_desktop",
      "min": 2,
