    {
      "type": "range",
      "id": "products_on_row_mobile",
      "min": 1,
      "max": 10,
      "step": 1,
      "label": "Products on row for mobile",
      "default": 2
    },
    {
      "type": "header",
      "content": "t:sections.featured_collection.settings.slider_header.content"
    },
    {
      "type": "range",
      "id": "slider_product_visible_desktop",
      "min": 4,
      "max": 12,
      "step": 1,
      "default": 4,
      "label": "t:sections.featured_collection.settings.slider_product_visible_desktop.label"
    },
    {
      "type": "range",
      "id": "slider_product_visible_large",
      "min": 4,
      "max": 12,
      "step": 1,
      "default": 4,
      "label": "t:sections.featured_collection.settings.slider_product_visible_large.label"
    },
    {
      "type": "select",
      "id": "bottom_margin",
      "label": "Section bottom margin",
      "options": [
        {
          "value": "none",
          "label": "None"
        },
        {
          "value": "normal",
          "label": "normal"
        },
        {
          "value": "large",
          "label": "large"
        }
      ],
      "default": "none"
    },
    {
      "type": "header",
      "content": "t:sections.related-products.settings.header__1.content"
    },
    {
      "type": "checkbox",
      "id": "show_vendor",
      "label": "t:sections.related-products.settings.show_vendor.label",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "show_secondary_media",
      "label": "t:sections.related-products.settings.show_secondary_media.label",
      "default": true
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "t:sections.all.section_width.label",
      "options": [
        {
          "label": "t:sections.all.section_width.normal",
          "value": "full_mobile"
        },
        {
          "label": "t:sections.all.section_width.full_right",
          "value": "full_right"
        }
      ],
      "default": "full_right"
    }
  ],
  "presets": [
    {
      "category": "product",
      "name": "Related products"
    }
  ]
}
{% endschema %}
