{% liquid
  assign section_id = section.id
  assign show_vendor = section.settings.show_vendor
  assign show_secondary_media = section.settings.show_secondary_media
  assign color_scheme = section.settings.color_scheme
  assign products_to_show = section.settings.products_to_show
  assign products_to_show_mobile = section.settings.products_to_show_mobile
  assign section_width = section.settings.section_width
  if section.settings.layout == 'grid'
    assign is_grid_layout = true
  else
    assign is_grid_layout = false
  endif

  assign heading_tag = section.settings.heading_tag
  assign font_size = section.settings.font_size
  assign font_weight = section.settings.font_weight
  assign heading_type = font_size | append: ' ' | append: font_weight
  assign italic_header_text = section.settings.italic_header_text
  if italic_header_text
    assign heading_type = heading_type | append: ' !italic'
  endif
%}

{% if section.settings.layout == 'slider' %}
  {% assign desktop_slides = section.settings.slider_product_visible_desktop | minus: 0.3 %}
  {% assign large_slides = section.settings.slider_product_visible_large | minus: 0.3 %}
  {%- capture swiper_options -%}
    {
      "slidesPerView": 1.5,
      "spaceBetween": 20,
      "loop": false,
      "navigation": {
        "nextEl": ".swiper-button-next",
        "prevEl": ".swiper-button-prev"
      },
      "breakpoints": {
        "768": {
          "slidesPerView": {{desktop_slides}}
        },
        "1636": {
          "slidesPerView": {{large_slides}}
        }
      },
      "scrollbar": {
      "el": ".swiper-scrollbar",
      "draggable": true
      }
    }
  {%- endcapture -%}

  {%- capture swiper_attribute -%}
    data-swiper='{{- swiper_options -}}'
  {%- endcapture -%}
{% endif %}

<div class="color-{{ color_scheme }}">
  {% render 'c-title',
    translatable_content: 'sections.related-products.title',
    custom_tag: heading_tag,
    type: heading_type,
    classes: 'mb-6 container-fluid'
  %}
  {% render 'product-recommendations',
    section_id: section_id,
    product_id: product.id,
    products_to_show_large: section.settings.products_to_show_large,
    products_to_show: products_to_show,
    products_to_show_mobile: products_to_show_mobile,
    media_aspect_ratio: 'bibs',
    show_secondary_media: show_secondary_media,
    show_vendor: show_vendor,
    swiper_attribute: swiper_attribute,
    section_width: section_width,
    is_grid_layout: is_grid_layout,
    products_on_row_mobile: section.settings.products_on_row_mobile,
    products_on_row_desktop: section.settings.products_on_row_desktop,
    products_on_row_large: section.settings.products_on_row_large,
    bottom_margin: section.settings.bottom_margin,
    remove_scrollbar: true
  %}
</div>

{% schema %}
{
  "name": "t:sections.related-products.name",
  "tag": "section",
  "class": "section-related-products",
  "settings": [
    {
      "type": "paragraph",
      "content": "t:sections.related-products.settings.paragraph__1.content"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "background-1"
    },
    {
      "type": "select",
      "id": "layout",
      "label": "t:sections.featured_collection.settings.layout.label",
      "options": [
        {
          "label": "grid",
          "value": "grid"
        },
        {
          "label": "slider",
          "value": "slider"
        }
      ]
    },
    {
      "type": "select",
      "label": "t:sections.all.heading_tag.label",
      "id": "heading_tag",
      "default": "h2",
      "options": [
        {
          "value": "h1",
          "label": "t:sections.all.heading_tag.options.h1"
        },
        {
          "value": "h2",
          "label": "t:sections.all.heading_tag.options.h2"
        },
        {
          "value": "h3",
          "label": "t:sections.all.heading_tag.options.h3"
        },
        {
          "value": "h4",
          "label": "t:sections.all.heading_tag.options.h4"
        },
        {
          "value": "h5",
          "label": "t:sections.all.heading_tag.options.h5"
        },
        {
          "value": "h6",
          "label": "t:sections.all.heading_tag.options.h6"
        }
      ]
    },
    {
      "type": "select",
      "label": "t:sections.all.font_size.label",
      "id": "font_size",
      "default": "",
      "options": [
        {
          "value": "",
          "label": "t:sections.all.font_size.options.default"
        },
        {
          "value": "paragraph-1",
          "label": "t:sections.all.font_size.options.paragraph"
        },
        {
          "value": "h1",
          "label": "t:sections.all.font_size.options.h1"
        },
        {
          "value": "h2",
          "label": "t:sections.all.font_size.options.h2"
        },
        {
          "value": "h3",
          "label": "t:sections.all.font_size.options.h3"
        },
        {
          "value": "h4",
          "label": "t:sections.all.font_size.options.h4"
        },
        {
          "value": "h5",
          "label": "t:sections.all.font_size.options.h5"
        },
        {
          "value": "h6",
          "label": "t:sections.all.font_size.options.h6"
        }
      ]
    },
    {
      "type": "select",
      "label": "t:sections.all.font_weight.label",
      "id": "font_weight",
      "default": "",
      "options": [
        {
          "value": "",
          "label": "t:sections.all.font_weight.options.default"
        },
        {
          "value": "!font-thin",
          "label": "t:sections.all.font_weight.options.thin"
        },
        {
          "value": "!font-light",
          "label": "t:sections.all.font_weight.options.light"
        },
        {
          "value": "!font-normal",
          "label": "t:sections.all.font_weight.options.normal"
        },
        {
          "value": "!font-medium",
          "label": "t:sections.all.font_weight.options.medium"
        },
        {
          "value": "!font-semibold",
          "label": "t:sections.all.font_weight.options.semibold"
        },
        {
          "value": "!font-bold",
          "label": "t:sections.all.font_weight.options.bold"
        }
      ]
    },
    {
      "type": "checkbox",
      "id": "italic_header_text",
      "label": "t:sections.all.italic_header_text.label",
      "default": false
    },
    {
      "type": "header",
      "content": "t:sections.featured_collection.settings.grid_header.content"
    },
    {
      "type": "range",
      "id": "products_to_show_large",
      "min": 2,
      "max": 10,
      "step": 1,
      "default": 10,
      "label": "Maximum products to show on large screens"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "min": 2,
      "max": 10,
      "step": 1,
      "default": 8,
      "label": "t:sections.related-products.settings.products_to_show.label"
    },
    {
      "type": "range",
      "id": "products_to_show_mobile",
      "min": 1,
