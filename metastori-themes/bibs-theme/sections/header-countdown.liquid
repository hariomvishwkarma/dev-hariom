{% assign link_collection = section.settings.link_collection %}

{% if link_collection != blank and link_collection.url != blank %}
  <a
    href="{{ link_collection.url }}"
    class="flex flex-row justify-center items-center {{ section.id }} color-{{ section.settings.color_scheme }} border-borders border-b"
  >
{% else %}
  <div
    class="flex flex-row justify-center items-center {{ section.id }} color-{{ section.settings.color_scheme }} border-borders border-b"
  >
{% endif %}

{% render 'countdown', id: section.id, end_time: section.settings.end_time, is_header: true %}

{% for block in section.blocks %}
  {% case block.type %}
    {% when 'button' %}
      {% capture bg_styling %}
        style="background-color: {{ block.settings.button_bg_color }}; color: {{ block.settings.button_text_color }};"
      {% endcapture %}
      {% render 'c-button',
        content: block.settings.button_label,
        design: 'link',
        classes: 'px-2 py-1 rounded-lg h-1/2',
        custom_attributes: bg_styling
      %}
  {% endcase %}
{% endfor %}

{% if link_collection != blank and link_collection.url != blank %}
  </a>
{% else %}
  </div>
{% endif %}

{% schema %}
{
  "name": "Header countdown",
  "class": "z-15 border-b border-borders relative",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.countdown-section.settings.color_scheme.label"
    },
    {
      "type": "text",
      "id": "end_time",
      "label": "t:sections.countdown-section.settings.end_time.label",
      "default": "09/09/2025 23:00:00",
      "info": "t:sections.countdown-section.settings.end_time.info"
    },
    {
      "type": "collection",
      "id": "link_collection",
      "label": "t:sections.countdown-section.settings.link_collection.label"
    }
  ],
  "blocks": [
    {
      "name": "Button",
      "type": "button",
      "limit": 1,
      "settings": [
        {
          "type": "text",
          "id": "button_label",
          "label": "Button label"
        },
        {
          "type": "color",
          "id": "button_bg_color",
          "label": "t:sections.countdown-section.settings.blocks.button_bg_color"
        },
        {
          "type": "color",
          "id": "button_text_color",
          "label": "t:sections.countdown-section.settings.blocks.button_text_color"
        }
      ]
    }
  ],
  "enabled_on": {
    "groups": ["header"]
  },
  "presets": [
    {
      "name": "Header countdown"
    }
  ]
}
{% endschema %}
