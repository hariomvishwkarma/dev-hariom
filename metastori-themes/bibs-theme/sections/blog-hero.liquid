{% liquid
  assign color_scheme = section.settings.color_scheme
  assign featured_article = section.settings.featured_article
  assign card_image = featured_article.metafields.custom.featured_story_image | default: featured_article.image

  assign heading_tag = section.settings.heading_tag
  assign font_size = section.settings.font_size
  assign font_weight = section.settings.font_weight
  assign heading_type = font_size | append: ' ' | append: font_weight
  assign italic_header_text = section.settings.italic_header_text
  if italic_header_text
    assign heading_type = heading_type | append: ' !italic'
  endif

  assign content_position = section.settings.content_position
%}
<div class="color-{{ color_scheme }}">
  {% liquid
    assign position_classes = ''
    assign text_align = ''

    case content_position
      when 'top_right'
        assign position_classes = 'top-0 right-0'
        assign text_align = 'text-right'
        assign align = 'items-end'
        assign justify = 'justify-end'
      when 'top_center'
        assign position_classes = 'top-0 -translate-x-2/4 left-2/4'
        assign text_align = 'text-center'
        assign align = 'items-center'
        assign justify = 'justify-center'
      when 'top_left'
        assign position_classes = 'top-0 left-0'
      when 'center_right'
        assign position_classes = '-translate-y-2/4 top-2/4 right-0'
        assign text_align = 'text-right'
        assign align = 'items-end'
        assign justify = 'justify-end'
      when 'center_center'
        assign position_classes = '-translate-y-2/4 -translate-x-2/4 top-2/4 left-2/4'
        assign text_align = 'text-center'
        assign align = 'items-center'
        assign justify = 'justify-center'
      when 'center_left'
        assign position_classes = '-translate-y-2/4 top-2/4 left-0'
      when 'bottom_right'
        assign position_classes = 'bottom-0 right-0'
        assign text_align = 'text-right'
        assign align = 'items-end'
        assign justify = 'justify-end'
      when 'bottom_center'
        assign position_classes = 'bottom-0 -translate-x-2/4 left-2/4'
        assign text_align = 'text-center'
        assign align = 'items-center'
        assign justify = 'justify-center'
      when 'bottom_left'
        assign position_classes = 'bottom-0 left-0'
    endcase
  %}

  <div class="grid relative h-[437px] md:h-[554px] max-h-screen w-full">
    {% render 'c-image', image: card_image, classes: 'blog-hero-image h-[437px] md:h-[554px] w-full' %}

    <div class="absolute {{ position_classes }} {{ text_align }}">
      <div class="flex flex-col gap-10 px-4 md:px-[30px] py-10 {{ align }}">
        <div class="flex flex-col gap-3">
          <div class="flex flex-row gap-2.5 flex-wrap {{ justify }}">
            {% assign blog_category = featured_article.metafields.custom.blog_category %}
            {% if blog_category != blank %}
              <span
                style="--text: {{blog_category.value.label_text_color}}; --bg: {{blog_category.value.label_color}}"
                class="py-1 px-2 border border-[var(--bg)] text-[var(--text)] bg-[var(--bg)] text-xs text-medium h-fit w-fit rounded-full whitespace-nowrap"
              >
                {{- blog_category.value.blog_name -}}
              </span>
            {% endif %}
            {% for tag in featured_article.tags %}
              {% assign tag_edit = tag | replace: 'guides_', '' %}
              <span class="py-1 px-2 border border-background text-background text-xs text-medium h-fit w-fit rounded-full whitespace-nowrap">
                {{- tag_edit -}}
              </span>
            {% endfor %}
          </div>
          {% render 'c-title',
            content: featured_article.title,
            custom_tag: heading_tag,
            type: heading_type,
            classes: 'text-background'
          %}
        </div>
        {% render 'c-link',
          translatable_content: 'blog.explore_all',
          classes: 'button--primary rounded-full shadow-none w-fit h-fit',
          href: featured_article.url
        %}
      </div>
    </div>
  </div>
</div>
{% render 'divider',
  height: section.settings.margin_bottom,
  custom: section.settings.margin_bottom_custom,
  color_scheme: color_scheme
%}

