{% liquid
  assign input_classes = 'py-3 peer-placeholder-shown:top-4'
  assign input_error_classes = 'text-sm text-red-800 mt-1'
  assign form_title = 'customer.register_page.title' | t
  assign email_label = 'customer.register_page.email' | t
  assign first_name_label = 'customer.register_page.first_name' | t
  assign last_name_label = 'customer.register_page.last_name' | t
  assign password_label = 'customer.register_page.password' | t
  assign tel_label = 'customer.register_page.phone_number' | t
  assign email_error = 'customer.register_page.errors.email' | t
  assign name_error = 'customer.register_page.errors.name' | t
  assign surname_error = 'customer.register_page.errors.surname' | t
  assign tel_error = 'customer.register_page.errors.tel' | t
  assign password_error = 'customer.register_page.errors.password' | t

  assign heading_tag = section.settings.heading_tag
  assign font_size = section.settings.font_size
  assign font_weight = section.settings.font_weight
  assign heading_type = font_size | append: ' ' | append: font_weight
  assign italic_header_text = section.settings.italic_header_text
  if italic_header_text
    assign heading_type = heading_type | append: ' !italic'
  endif
%}

<div class="container-fluid color-{{ section.settings.color_scheme }}">
  <div class="max-w-sm mx-auto my-6">
    <div id="login-form" data-validation-required>
      {% render 'c-title', content: form_title, custom_tag: heading_tag, type: heading_type, classes: 'mb-6 md:mb-9' %}

      {% form 'create_customer' %}
        {% render 'form-errors', form_errors: form.errors %}
        <div data-auth-input class="mb-8 relative">
          {% render 'c-input',
            input_type: 'email',
            input_name: 'customer[email]',
            id: 'email',
            input_autocomplete: 'email',
            label_content: email_label,
            input_classes: input_classes,
            error_text: email_error
          %}
          <span>
            {% render 'c-icon',
              icon: 'checkmark',
              classes: 'input-icon-success hidden absolute top-[.9rem] right-4 text-success w-5 h-5 inline'
            %}
          </span>
          <span>
            {% render 'c-icon',
              icon: 'bolder_close',
              classes: 'input-icon-invalid hidden absolute top-[.9rem] right-4 text-error w-5 h-5 inline'
            %}
          </span>

          {%- if form.errors contains 'email' -%}
            <p class="{{ input_error_classes }}">
              {{- form.errors.translated_fields.email | capitalize }}
              {{ form.errors.messages.email -}}
            </p>
          {%- endif -%}
        </div>

        <div data-auth-input class="mb-8 relative">
          {% render 'c-input',
            input_type: 'text',
            input_name: 'customer[first_name]',
            id: 'first_name',
            input_autocomplete: 'given-name',
            label_content: first_name_label,
            input_classes: input_classes,
            error_text: name_error
          %}
          <span>
            {% render 'c-icon',
              icon: 'checkmark',
              classes: 'input-icon-success hidden absolute top-[.9rem] right-4 text-success w-5 h-5 inline'
            %}
          </span>
        </div>

        <div data-auth-input class="mb-8 relative">
          {% render 'c-input',
            input_type: 'text',
            input_name: 'customer[last_name]',
            id: 'last_name',
            input_autocomplete: 'family-name',
            label_content: last_name_label,
            input_classes: input_classes,
            error_text: surname_error
          %}
          <span>
            {% render 'c-icon',
              icon: 'checkmark',
              classes: 'input-icon-success hidden absolute top-[.9rem] right-4 text-success w-5 h-5 inline'
            %}
          </span>
        </div>

        <div data-auth-input class="mb-8 relative">
          {% render 'c-input',
            input_type: 'tel',
            input_name: 'customer[tel]',
            id: 'tel',
            input_autocomplete: 'tel',
            label_content: tel_label,
            input_classes: input_classes,
            error_text: tel_error
          %}
          <span>
            {% render 'c-icon',
              icon: 'checkmark',
              classes: 'input-icon-success hidden absolute top-[.9rem] right-4 text-success w-5 h-5 inline'
            %}
          </span>
          <span>
            {% render 'c-icon',
              icon: 'bolder_close',
              classes: 'input-icon-invalid hidden absolute top-[.9rem] right-4 text-error w-5 h-5 inline'
            %}
          </span>
        </div>

        <div data-auth-input class="mb-6 relative">
          {% render 'c-input',
            input_type: 'password',
            input_name: 'customer[password]',
            id: 'password',
            input_autocomplete: 'new-password',
            label_content: password_label,
            input_classes: input_classes,
            right_icon_classes: 'absolute top-4 right-3 cursor-pointer right-4 w-4 h-4',
            error_text: password_error
          %}
          <span>
            {% render 'c-icon',
              icon: 'visible_eye',
              classes: 'password-icon hidden md:block absolute top-4 right-3 cursor-pointer right-4 w-4 h-4'
            %}
          </span>

          {%- if form.errors contains 'password' -%}
            <p class="{{ input_error_classes }}">
              {{- form.errors.translated_fields.password | capitalize }}
              {{ form.errors.messages.password -}}
            </p>
          {% else %}
            <ul
              data-password-requirements
              class="text-grey-600 text-sm list-disc pl-6 mt-1 leading-4"
            >
              <li>{{ 'customer.register_page.pass_required_characters' | t }}</li>
              <li>{{ 'customer.register_page.pass_required_numbers' | t }}</li>
            </ul>
          {%- endif -%}
        </div>

        <div class="[&>p]:text-sm [&>p]:leading-[150%] [&>p]:text-grey-600 [&_a]:text-foreground [&_a]:underline [&_a]:underline-offset-2 [&_a]:decoration-1 [&_a]:hover:decoration-2">
          {{- section.settings.register_agreement_text | newline_to_br -}}
        </div>

        {%- assign submit_button_content = 'customer.register_page.submit' | t | upcase -%}
        {% render 'c-button',
          type: 'submit',
          id: 'submit-register',
          content: submit_button_content,
          design: 'accent',
          classes: 'mb-[14.5px] mt-8 button--full-rounded disabled:bg-gray-400 text-center'
        %}

        <div class="text-center text-sm">
          <span class="text-grey-600">{{ 'customer.register_page.already_have_account' | t }}</span>
          {% assign login = 'customer.register_page.log_in' | t %}
          {% render 'c-link', href: routes.account_login_url, classes: 'link', content: login %}
        </div>
      {% endform %}
    </div>
  </div>
</div>

