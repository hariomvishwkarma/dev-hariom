      "default": "h2"
    },
    {
      "type": "select",
      "id": "headline_position",
      "label": "Select position",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ]
    },
    {
      "type": "select",
      "id": "headline_font_size",
      "label": "Font size",
      "default": "text-4xl",
      "options": [
        {
          "value": "text-xl",
          "label": "Small"
        },
        {
          "value": "text-2xl",
          "label": "Medium"
        },
        {
          "value": "text-3xl",
          "label": "Large"
        },
        {
          "value": "text-4xl",
          "label": "Extra Large"
        },
        {
          "value": "text-5xl",
          "label": "Extra Extra Large"
        },
        {
          "value": "text-6xl",
          "label": "Extra Extra Extra Large"
        }
      ]
    },
    {
      "type": "header",
      "content": "Sub heading"
    },
    {
      "type": "text",
      "id": "sub_heading",
      "label": "Sub Heading",
      "default": "Sub Heading"
    },
    {
      "type": "select",
      "label": "Custom Sub Headline Tag",
      "id": "custom_sub_headline_tag",
      "options": [
        {
          "value": "h1",
          "label": "H1"
        },
        {
          "value": "h2",
          "label": "H2"
        },
        {
          "value": "h3",
          "label": "H3"
        },
        {
          "value": "h4",
          "label": "H4"
        },
        {
          "value": "h5",
          "label": "H5"
        },
        {
          "value": "h6",
          "label": "H6"
        }
      ],
      "default": "h3"
    },
    {
      "type": "select",
      "id": "sub_headline_position",
      "label": "Select position",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ]
    },
    {
      "type": "select",
      "id": "sub_headline_font_size",
      "label": "Font size",
      "default": "text-2xl",
      "options": [
        {
          "value": "text-xl",
          "label": "Small"
        },
        {
          "value": "text-2xl",
          "label": "Medium"
        },
        {
          "value": "text-3xl",
          "label": "Large"
        },
        {
          "value": "text-4xl",
          "label": "Extra Large"
        },
        {
          "value": "text-5xl",
          "label": "Extra Extra Large"
        },
        {
          "value": "text-6xl",
          "label": "Extra Extra Extra Large"
