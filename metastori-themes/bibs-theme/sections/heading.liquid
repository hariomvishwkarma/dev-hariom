{% liquid
  assign headline_position = section.settings.headline_position
  assign sub_headline_position = section.settings.sub_headline_position
  assign headline_font_size = section.settings.headline_font_size
  assign sub_headline_font_size = section.settings.sub_headline_font_size

  case headline_position
    when 'left'
      assign justify_headline = 'justify-start'
    when 'center'
      assign justify_headline = 'justify-center'
    when 'right'
      assign justify_headline = 'justify-end'
  endcase

  case sub_headline_position
    when 'left'
      assign justify_sub_headline = 'justify-start'
    when 'center'
      assign justify_sub_headline = 'justify-center'
    when 'right'
      assign justify_sub_headline = 'justify-end'
  endcase

  assign headline_classes = 'flex' | append: ' ' | append: justify_headline | append: ' ' | append: headline_font_size
  assign sub_headline_classes = 'flex' | append: ' ' | append: justify_sub_headline | append: ' ' | append: sub_headline_font_size
%}

<div class="color-{{ section.settings.color_scheme }}">
  <div class="container">
    <div class="flex flex-col headline-section">
      {% if section.settings.heading != blank %}
        {% render 'c-title',
          content: section.settings.heading,
          custom_tag: section.settings.custom_headline_tag,
          classes: headline_classes
        %}
      {% endif %}
      {% if section.settings.sub_heading != blank %}
        {% render 'c-title',
          content: section.settings.sub_heading,
          custom_tag: section.settings.custom_sub_headline_tag,
          classes: sub_headline_classes
        %}
      {% endif %}
    </div>
  </div>
</div>

{% style %}
  .headline-section {
    gap: {{ section.settings.gap }}px;
    padding-top: {{ section.settings.headline_padding_top }}rem;
    padding-bottom: {{ section.settings.headline_padding_bottom }}rem;
  }
{% endstyle %}

{% schema %}
{
  "name": "Heading",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label"
    },
    {
      "type": "range",
      "id": "gap",
      "label": "Gap",
      "min": 0,
      "max": 48,
      "step": 1,
      "default": 8,
      "unit": "rem"
    },
    {
      "type": "range",
      "id": "headline_padding_top",
      "label": "Padding top",
      "min": 0,
      "max": 50,
      "step": 0.5,
      "default": 1,
      "unit": "rem"
    },
    {
      "type": "range",
      "id": "headline_padding_bottom",
      "label": "Padding bottom",
      "min": 0,
      "max": 50,
      "step": 0.5,
      "default": 1,
      "unit": "rem",
      "info": "1 rem = 16px"
    },
    {
      "type": "header",
      "content": "Heading"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Heading"
    },
    {
      "type": "select",
      "label": "Custom Headline Tag",
      "id": "custom_headline_tag",
      "options": [
        {
          "value": "h1",
          "label": "H1"
        },
        {
          "value": "h2",
          "label": "H2"
        },
        {
          "value": "h3",
          "label": "H3"
        },
        {
          "value": "h4",
          "label": "H4"
        },
        {
          "value": "h5",
          "label": "H5"
        },
        {
          "value": "h6",
          "label": "H6"
        }
