{% liquid
  assign heading_tag = section.settings.heading_tag
  assign font_size = section.settings.font_size
  assign font_weight = section.settings.font_weight
  assign heading_type = font_size | append: ' ' | append: font_weight
  assign italic_header_text = section.settings.italic_header_text
  if italic_header_text
    assign heading_type = heading_type | append: ' !italic'
  endif
%}
<div class="container-fluid pt-4 md:pt-14 color-{{ section.settings.color_scheme }}">
  <div class="sm:flex">
    <div class="sidebar-left sm:w-48 sm:mr-10">
      {% render 'c-title', translatable_content: 'about.about_us', custom_tag: heading_tag, type: heading_type %}
      <ul class="mt-5 sm:mt-0 text-base flex gap-10 sm:block overflow-auto sm:overflow-hidden no-scrollbar">
        {% for link in linklists['about-us-sidebar'].links %}
          <li class="sm:mt-8 shrink-0">
            <a
              href="{{ link.url }}"
              class="font-bold {% if link.url == page.url %} bg-accent text-background{% endif %}"
            >
              {{ link.title }}
            </a>
          </li>
        {% endfor %}
      </ul>
    </div>
    <div class="page__content mt-10 sm:mt-0">
      {% assign sub_heading = page.metafields.custom.subheading %}
      {% if sub_heading != blank %}
        <div class="text-base font-bold mb-2">
          {{ sub_heading }}
        </div>
      {% endif %}
      {% render 'c-title', content: page.title, custom_tag: 'h1', classes: 'text-7xl' %}
      <div class="mt-8">{{ page.content }}</div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "About us",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "background-1"
    },
    {
      "type": "select",
      "label": "t:sections.all.heading_tag.label",
      "id": "heading_tag",
      "default": "h2",
      "options": [
        {
          "value": "h1",
          "label": "t:sections.all.heading_tag.options.h1"
        },
        {
          "value": "h2",
          "label": "t:sections.all.heading_tag.options.h2"
        },
        {
          "value": "h3",
          "label": "t:sections.all.heading_tag.options.h3"
        },
        {
          "value": "h4",
          "label": "t:sections.all.heading_tag.options.h4"
        },
        {
          "value": "h5",
          "label": "t:sections.all.heading_tag.options.h5"
        },
        {
          "value": "h6",
          "label": "t:sections.all.heading_tag.options.h6"
        }
      ]
    },
    {
      "type": "select",
      "label": "t:sections.all.font_size.label",
      "id": "font_size",
      "default": "",
      "options": [
        {
          "value": "",
          "label": "t:sections.all.font_size.options.default"
        },
        {
          "value": "paragraph-1",
          "label": "t:sections.all.font_size.options.paragraph"
        },
