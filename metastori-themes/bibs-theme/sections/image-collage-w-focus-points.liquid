{%- liquid
  if section.blocks.size == 1
    assign layout_classes = 'collage-single grid grid-cols-1 grid-rows-1'
  elsif section.blocks.size == 2
    assign layout_classes = 'collage-duo grid md:grid-cols-2 gap-4'
  elsif section.blocks.size == 3
    assign layout_classes = 'collage-tile grid md:grid-cols-2 md:grid-rows-2 gap-4'
  endif
-%}

<div class="color-{{ section.settings.color_scheme }} container-fluid collage-w-focus-points {{ layout_classes }}">
  {%- for block in section.blocks -%}
    {% liquid
      assign bg_image = block.settings.bg_image
      assign bg_image_mobile = block.settings.bg_image_mobile | default: bg_image
      assign add_to_cart_position = section.settings.add_to_cart_position
      assign hide_add_to_cart_label = section.settings.hide_add_to_cart_label
    %}
    {% render 'shop-the-look-block',
      bg_image: bg_image,
      bg_image_mobile: bg_image_mobile,
      add_to_cart_position: add_to_cart_position,
      hide_add_to_cart_label: hide_add_to_cart_label,
      block_id: block.id,
      section_id: section.id,
      span_double: false,
      product_1: block.settings.product_1,
      product_1_position_x: block.settings.x_position_1,
      product_1_position_y: block.settings.y_position_1,
      product_1_position_x_mobile: block.settings.x_position_mobile_1,
      product_1_position_y_mobile: block.settings.y_position_mobile_1,
      product_2: block.settings.product_2,
      product_2_position_x: block.settings.x_position_2,
      product_2_position_y: block.settings.y_position_2,
      product_2_position_x_mobile: block.settings.x_position_mobile_2,
      product_2_position_y_mobile: block.settings.y_position_mobile_2,
      product_3: block.settings.product_3,
      product_3_position_x: block.settings.x_position_3,
      product_3_position_y: block.settings.y_position_3,
      product_3_position_x_mobile: block.settings.x_position_mobile_3,
      product_3_position_y_mobile: block.settings.y_position_mobile_3
    %}
  {%- endfor -%}
</div>

{% render 'divider',
  height: section.settings.margin_bottom,
  custom: section.settings.margin_bottom_custom,
  color_scheme: section.settings.color_scheme
%}

{% if section.blocks.size == 3 %}
  <script>
    const windowWidth = window.innerWidth;
    let margins;
    let sectionWidth;
    let imageWidth;
    if (windowWidth < 768) {
      imageWidth = (windowWidth - 32 - 16) / 2;
    } else if (windowWidth >= 768 && windowWidth < 1024) {
      margins = 64;
      imageWidth = (windowWidth - margins - 16) / 2;
    } else if (windowWidth >= 1024) {
      sectionWidth = 1520;
      imageWidth = (sectionWidth - 16) / 2;
    }
    const sectionHeight = imageWidth * 1.2;
    const horisontalImageHeight = (sectionHeight - 16) / 2;

    document.querySelectorAll('.collage-w-focus-points.collage-tile > div').forEach((image) => {
      image.style.height = horisontalImageHeight;
    });
  </script>
{% endif %}

