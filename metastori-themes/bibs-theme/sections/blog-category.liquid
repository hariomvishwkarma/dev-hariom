      "default": "none"
    },
    {
      "type": "range",
      "min": 0,
      "max": 100,
      "default": 16,
      "step": 1,
      "label": "t:sections.all.margin.margin_bottom.custom.value",
      "visible_if": "{{ section.settings.margin_bottom == 'custom' }}",
      "unit": "px",
      "id": "margin_bottom_custom"
    },
    {
      "type": "range",
      "id": "number_of_columns",
      "label": "t:sections.categories_grid.settings.number_of_columns.label",
      "min": 2,
      "max": 6,
