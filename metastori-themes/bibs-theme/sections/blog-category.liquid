{% liquid
  assign color_scheme = section.settings.color_scheme
  assign custom_bg_color = section.settings.custom_bg_color
  assign number_of_columns = section.settings.number_of_columns
  case number_of_columns
    when 2
      assign grid_class = 'md:grid-cols-2'
    when 4
      assign grid_class = 'md:grid-cols-4'
    when 5
      assign grid_class = 'md:grid-cols-5'
    when 6
      assign grid_class = 'md:grid-cols-6'
    else
      assign grid_class = 'md:grid-cols-3'
  endcase

  assign section_header = section.settings.header
  assign heading_tag = section.settings.heading_tag
  assign font_size = section.settings.font_size
  assign font_weight = section.settings.font_weight
  assign heading_type = font_size | append: ' ' | append: font_weight
  assign italic_header_text = section.settings.italic_header_text
  if italic_header_text
    assign heading_type = heading_type | append: ' !italic'
  endif

  assign description = section.settings.description
%}

<div
  class="color-{{ color_scheme }}"
  style="--custom-bg-color: {{ custom_bg_color }};"
>
  <div class="flex container-fluid justify-between">
    <div class="flex flex-col justify-center gap-4 md:gap-0 w-full">
      {% if section_header != blank %}
        {% render 'c-title', content: section_header, custom_tag: heading_tag, type: heading_type %}
      {% endif %}
      <div class="flex flex-col md:flex-row gap-4 md:justify-between md:items-end">
        {% if description != blank %}
          {% render 'c-text', content: description, type: 'text-base' %}
        {% endif %}
        {% render 'search-bar-articles' %}
      </div>
    </div>
  </div>

  {% render 'blog-tag-filters', blog: blog %}
  <div class="custom-background relative">
    <div class="load-more-wrapper">
      {% render 'blog-latest', blog: blog, grid_class: grid_class %}
    </div>
  </div>
</div>
{% render 'divider',
  height: section.settings.margin_bottom,
  custom: section.settings.margin_bottom_custom,
  color_scheme: color_scheme
%}

{% schema %}
