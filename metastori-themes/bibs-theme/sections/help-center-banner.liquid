{%- style -%}
  {% unless section.settings.image != blank and section.settings.switch_design %}
    #shopify-section-{{ section.id }} .help-center-banner {
      background-color: {{ section.settings.bg_color }};
    }
  {% endunless %}

  {% if section.settings.switch_design %}
  #shopify-section-{{ section.id }} .help-center-banner .banner-content {
    display: flex;
    flex-direction: row;
    align-items: stretch;
    justify-content: space-between;
    gap: 0;
  }
  #shopify-section-{{ section.id }} .help-center-banner .banner-text {
    flex: 0 0 50%;
    max-width: 50%;
    text-align: left;
    display: flex;
    flex-direction: column;
    justify-content: center;
    {% if section.settings.image != blank %}
      background-color: {{ section.settings.bg_color }};
      padding: 30px 60px;
    {% endif %}
  }
  #shopify-section-{{ section.id }} .help-center-banner .banner-image {
    flex: 0 0 50%;
    max-width: 50%;
    margin-top: 0;
    display: flex;
    align-items: center;
  }
  #shopify-section-{{ section.id }} .help-center-banner .banner-image img {
    width: 100%;
    height: 100%;
    display: block;
  }
  {% else %}
  #shopify-section-{{ section.id }} .help-center-banner .banner-content {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }
  #shopify-section-{{ section.id }} .help-center-banner .banner-image {
    width: 100%;
    margin-top: 30px;
  }
  #shopify-section-{{ section.id }} .help-center-banner .banner-image img {
    max-width: 100%;
    height: auto;
    object-fit: cover;
    display: block;
    width: 100%;
  }
  {% endif %}

  /* Responsive Text Scaling */
  @media screen and (min-width: 768px) {
    #shopify-section-{{ section.id }} .banner-title {
      font-size: {{ section.settings.headline_size }}px;
    }
    #shopify-section-{{ section.id }} .banner-description {
      font-size: {{ section.settings.text_size }}px;
    }
  }

  @media screen and (max-width: 989px) {
    #shopify-section-{{ section.id }} .banner-title {
      font-size: calc({{ section.settings.headline_size }}px);
    }
    #shopify-section-{{ section.id }} .banner-description {
      font-size: calc({{ section.settings.text_size }}px);
    }
    {% if section.settings.switch_design %}
    #shopify-section-{{ section.id }} .help-center-banner .banner-content {
      flex-direction: column;
      text-align: center;
    }
    #shopify-section-{{ section.id }} .help-center-banner .banner-text,
    #shopify-section-{{ section.id }} .help-center-banner .banner-image {
      flex: 0 0 100%;
      max-width: 100%;
    }
    #shopify-section-{{ section.id }} .help-center-banner .banner-text {
      text-align: center;
      {% if section.settings.image != blank %}
        padding: 30px 40px;
      {% endif %}
    }
    #shopify-section-{{ section.id }} .help-center-banner .banner-image img {
      height: 203px;
      object-fit: cover;
    }
    {% endif %}
  }

  /* Mobile (below 990px) */
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top_mobile }}px;
    padding-bottom: {{ section.settings.padding_bottom_mobile }}px;
  }

  /* Desktop (990px and above) */
  @media screen and (min-width: 990px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top_desktop }}px;
      padding-bottom: {{ section.settings.padding_bottom_desktop }}px;
    }
  }
{%- endstyle -%}

<div class="help-center-banner section-{{ section.id }}-padding">
  <div class="banner-content">
    <div class="banner-text">
      {%- if section.settings.headline != blank and section.settings.headline_tag != blank -%}
        <{{ section.settings.headline_tag }} class="banner-title">
          {{ section.settings.headline | escape }}
        </{{ section.settings.headline_tag }}>
      {%- endif -%}

      {%- if section.settings.text != blank -%}
        <div class="banner-description">
          {{ section.settings.text }}
        </div>
      {%- endif -%}
    </div>

    {%- if section.settings.image != blank -%}
      <div class="banner-image">
        {{ section.settings.image | image_url: width: 1200 | image_tag: loading: 'lazy' }}
      </div>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "Help Center Banner",
  "tag": "section",
  "settings": [
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color (Hex)",
      "default": "#dde9f8"
    },
    {
      "type": "checkbox",
      "id": "switch_design",
      "label": "Switch Design Layout",
      "default": false,
      "info": "Toggles between a centered layout and a row layout."
    },
    {
      "type": "header",
      "content": "Headline"
    },
    {
      "type": "text",
      "id": "headline",
      "label": "Headline",
      "default": "Help Center"
    },
    {
      "type": "select",
      "id": "headline_tag",
      "label": "Headline HTML Tag",
      "options": [
        { "value": "h1", "label": "H1" },
        { "value": "h2", "label": "H2" },
        { "value": "h3", "label": "H3" },
        { "value": "h4", "label": "H4" },
        { "value": "h5", "label": "H5" },
        { "value": "h6", "label": "H6" },
        { "value": "p", "label": "Paragraph" }
      ],
      "default": "h1"
    },
    {
      "type": "range",
      "id": "headline_size",
      "min": 24,
      "max": 80,
      "step": 2,
      "unit": "px",
      "label": "Headline Font Size (Desktop)",
      "default": 50
    },
    {
      "type": "header",
      "content": "Description Text"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>Get help with your order through our articles, or by contacting us via email.</p>"
    },
    {
      "type": "range",
      "id": "text_size",
      "min": 14,
      "max": 32,
      "step": 1,
      "unit": "px",
      "label": "Text Font Size (Desktop)",
      "default": 20
    },
    {
      "type": "header",
      "content": "Image"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Banner Image"
    },
    {
      "type": "header",
      "content": "Mobile Padding"
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "label": "Padding top (mobile)",
      "default": 20,
      "min": 0,
      "max": 100,
      "step": 2
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "label": "Padding bottom (mobile)",
      "default": 20,
      "min": 0,
      "max": 100,
      "step": 2
    },
    {
      "type": "header",
      "content": "Desktop Padding"
    },
    {
      "type": "range",
      "id": "padding_top_desktop",
      "label": "Padding top (desktop)",
      "default": 40,
      "min": 0,
      "max": 200,
      "step": 2
    },
    {
      "type": "range",
      "id": "padding_bottom_desktop",
      "label": "Padding bottom (desktop)",
      "default": 40,
      "min": 0,
      "max": 200,
      "step": 2
    }
  ],
  "presets": [
    {
      "name": "Help Center Banner"
    }
  ]
}
{% endschema %}
