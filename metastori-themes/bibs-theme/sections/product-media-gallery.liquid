{% liquid
  assign show_watermark = section.settings.show_watermark
  assign product_watermark_image = section.settings.product_watermark_image
  assign watermark_size = section.settings.watermark_size
%}

<div class="md:container-fluid ">
  <div
    id="MediaGallery-{{ section.id }}"
    class="product_media-gallery relative color-{{ section.settings.color_scheme }}"
    data-media-gallery-id="{{ section.id }}"
  >
    <div class="hidden md:flex gap-1 items-center p-3 absolute top-0 bottom-auto left-0 right-auto z-5">
      {% liquid
        render 'c-badges-switch', badge_item: product
      %}
    </div>
    {% render 'c-badge-night', badge_item: product, classes: 'md:hidden z-5 absolute bottom-0 right-0 p-4' %}

    {% render 'product-media-gallery',
      product: product,
      show_watermark: show_watermark,
      product_watermark_image: product_watermark_image,
      watermark_size: watermark_size
    %}
  </div>
</div>
{% render 'divider',
  height: section.settings.margin_bottom,
  classes: 'hidden md:block',
  color_scheme: section.settings.color_scheme
%}

{% schema %}
{
  "name": "t:sections.product-media-gallery.name",
  "class": "section-product-media-gallery",
  "limit": 1,
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "background-1"
    },
    {
      "type": "checkbox",
      "id": "hide_variants",
      "default": false,
      "label": "t:sections.product-media-gallery.settings.hide_variants.label",
      "info": "t:sections.product-media-gallery.settings.hide_variants.info"
    },
    {
      "type": "select",
      "id": "media_fit",
      "options": [
        {
          "value": "none",
          "label": "t:sections.product-media-gallery.settings.media_fit.options.none.label"
        },
        {
          "value": "contain",
          "label": "t:sections.product-media-gallery.settings.media_fit.options.contain.label"
        },
        {
          "value": "cover",
          "label": "t:sections.product-media-gallery.settings.media_fit.options.cover.label"
        },
        {
          "value": "fill",
          "label": "t:sections.product-media-gallery.settings.media_fit.options.fill.label"
        },
        {
          "value": "scale-down",
          "label": "t:sections.product-media-gallery.settings.media_fit.options.scale-down.label"
        }
      ],
      "default": "cover",
      "label": "t:sections.product-media-gallery.settings.media_fit.label"
    },
    {
      "type": "header",
      "content": "t:sections.all.margin.heading"
    },
    {
      "type": "select",
      "id": "margin_bottom",
      "label": "t:sections.all.margin.margin_bottom.label",
      "options": [
        {
          "label": "t:sections.all.margin.margin_bottom.none",
          "value": "none"
        },
        {
          "label": "t:sections.all.margin.margin_bottom.small",
          "value": "small"
        },
        {
          "label": "t:sections.all.margin.margin_bottom.normal",
          "value": "normal"
        },
        {
          "label": "t:sections.all.margin.margin_bottom.large",
          "value": "large"
        },
        {
          "label": "t:sections.all.margin.margin_bottom.custom.label",
          "value": "custom"
        }
      ],
      "default": "none"
    },
    {
      "type": "range",
      "min": 0,
      "max": 100,
      "default": 16,
      "step": 1,
      "label": "t:sections.all.margin.margin_bottom.custom.value",
      "visible_if": "{{ section.settings.margin_bottom == 'custom' }}",
      "unit": "px",
      "id": "margin_bottom_custom"
    },
    {
      "type": "header",
      "content": "t:sections.product-media-gallery.settings.watermark.content"
    },
    {
      "type": "checkbox",
      "id": "show_watermark",
      "label": "t:sections.product-media-gallery.settings.watermark.show_watermark.label",
      "default": false,
      "info": "t:sections.product-media-gallery.settings.watermark.show_watermark.info"
    },
    {
      "type": "image_picker",
      "id": "product_watermark_image",
      "label": "t:sections.product-media-gallery.settings.watermark.product_watermark_image.label"
    },
    {
      "type": "range",
      "id": "watermark_size",
      "min": 15,
      "max": 100,
      "step": 5,
      "unit": "px",
      "label": "t:sections.product-media-gallery.settings.watermark.watermark_size.label",
      "default": 20
    }
  ]
}
{% endschema %}
