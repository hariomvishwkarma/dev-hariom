          "type": "richtext",
          "id": "dropdown_text_2",
          "label": "t:sections.image-dropdowns.blocks.dropdown_item.settings.text_group_2.text"
        },
        {
          "type": "image_picker",
          "id": "dropdown_icon_2",
          "label": "t:sections.image-dropdowns.blocks.dropdown_item.settings.text_group_2.icon"
        },
        {
          "type": "header",
          "content": "t:sections.image-dropdowns.blocks.dropdown_item.settings.text_group_3.content"
        },
        {
          "type": "richtext",
          "id": "dropdown_header_3",
          "label": "t:sections.image-dropdowns.blocks.dropdown_item.settings.text_group_3.header"
        },
        {
          "type": "richtext",
          "id": "dropdown_text_3",
          "label": "t:sections.image-dropdowns.blocks.dropdown_item.settings.text_group_3.text"
        },
        {
          "type": "image_picker",
          "id": "dropdown_icon_3",
          "label": "t:sections.image-dropdowns.blocks.dropdown_item.settings.text_group_3.icon"
        }
      ]
    }
  ]
}
{% endschema %}
