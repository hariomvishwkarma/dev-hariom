{% liquid
  assign color_scheme = section.settings.color_scheme
  assign section_header = section.settings.header
  assign heading_tag = section.settings.heading_tag
  assign font_size = section.settings.font_size
  assign font_weight = section.settings.font_weight
  assign heading_type = font_size | append: ' ' | append: font_weight
  assign italic_header_text = section.settings.italic_header_text
  if italic_header_text
    assign heading_type = heading_type | append: ' !italic'
  endif
  assign description = section.settings.description
  assign leaflet_value = product.metafields.custom.leaflet.value.section.value

  assign all_blocks_empty = true
  for block in section.blocks
    assign dropdown_content = false
    for i in (1..3)
      assign index = forloop.index
      assign icon = 'dropdown_icon_' | append: index
      assign text = 'dropdown_text_' | append: index
      assign content_header = 'dropdown_header_' | append: index
      if block.settings[icon] != blank or block.settings[text] != blank or block.settings[content_header] != blank
        assign dropdown_content = true
      endif
    endfor
    if block.settings.dropdown_title != blank
      if leaflet_value != blank or dropdown_content != blank
        assign all_blocks_empty = false
      endif
    endif
  endfor
%}
{%- unless all_blocks_empty -%}
  <div class="color-{{ color_scheme }} flex md:flex-row flex-col-reverse w-full gap-0 md:gap-[60px] {% if section.settings.full_width_section == false %}image-section-grid max-w-[96rem] my-24 mx-auto{% endif %}">
    <div class="w-full md:w-1/2">
      <div class="container-fluid">
        <div class="flex flex-col py-6 md:pb-[60px]">
          {%- if section_header != blank -%}
            {% render 'c-title', content: section_header, custom_tag: heading_tag, type: heading_type %}
          {%- endif -%}
          {%- if description != blank -%}
            {% render 'c-richtext', content: description, classes: 'pt-5 paragraph-1' %}
          {%- endif -%}
        </div>
        {%- for block in section.blocks -%}
          {%- assign dropdown_title = block.settings.dropdown_title -%}
          {%- if section.settings.open_first_accordion and forloop.index == 1 -%}
            {% assign open_on_load = true %}
          {%- else -%}
            {% assign open_on_load = false %}
          {%- endif -%}

          {%- capture block_text_content -%}
            {%- assign section_has_icons = false -%}
            {%- if block.settings.dropdown_icon_1 != blank or block.settings.dropdown_icon_2 != blank or block.settings.dropdown_icon_3 != blank -%} 
              {%- assign section_has_icons = true -%}
            {%- endif -%}
            <div class="flex flex-col gap-6 dropdown-content">
              {%- assign dropdown_content = false -%}
              {%- for i in (1..3) -%}
                {% liquid
                  assign index = forloop.index
                  assign icon = 'dropdown_icon_' | append: index
                  assign text = 'dropdown_text_' | append: index
                  assign content_header = 'dropdown_header_' | append: index
                  if block.settings[icon] != blank or block.settings[text] != blank or block.settings[content_header] != blank
                    assign dropdown_content = true
                  endif
                %}
                {%- if block.settings[icon] != blank or block.settings[text] != blank -%}
                  <div class="flex flex-row gap-3">
                    {%- if block.settings[icon] != blank -%} 
                      {% render 'c-image', image: block.settings[icon], classes: 'min-w-[22px] min-h-[22px] h-[22px] w-[22px]', image_fit: 'contain' %}
                    {%- elsif section_has_icons -%}
                      <span class="h-[22px] w-[22px]"></span>
                    {%- endif -%}
                    {%- if block.settings[text] != blank or block.settings[content_header] != blank -%}
                      <span class="flex flex-col">
                        {% render 'c-richtext', content: block.settings[content_header], classes: 'text-base content-header pb-1.5' %}
                        {% render 'c-richtext', content: block.settings[text], classes: 'paragraph-3 flex flex-col gap-3.5' %}
                      </span>
                    {%- endif -%}
                  </div>
                {%- endif -%}
              {%- endfor -%}
            </div>
          {%- endcapture -%}

          {%- capture block_content -%}
            {{ block_text_content }}
            {%- if block.settings.include_leaflet -%}
              {%- capture leaflet_modal_trigger -%}
                {% render 'c-button', classes: 'text-button mt-5', custom_attributes: 'data-drawer-target="product-leaflet"', translatable_content: 'products.product.leaflet.leaflet_label' %}
              {%- endcapture -%}
      
              {%- capture leaflet_header -%}
                {% render 'c-title', custom_tag: 'h5', translatable_content: 'products.product.leaflet.leaflet_label' %}
              {%- endcapture -%}
      
              {%- capture leaflet_content -%}
                {%- for leaflet_section in leaflet_value -%}
                  <div>
                    {% if leaflet_section.title %}
                      {% render 'c-title', custom_tag: 'h6', content: leaflet_section.title, classes: 'pb-[10px]'  %}
                    {% endif %}
                    {% if leaflet_section.description %}
                      {{ leaflet_section.description | metafield_tag }}
                    {% endif %}
                  </div>

                  {%- if leaflet_section.list.value -%}
                    <div class="flex flex-col gap-4">
                      {%- for list_item in leaflet_section.list.value -%}
                        <div class="flex gap-[14px] items-start">
                          <div class="w-[29px] basis-[29px] shrink-0">
                            {% render 'c-image', image: list_item.icon, image_width: 300 %}
                          </div>
                          {% render 'c-text', content: list_item.text %}
                        </div>
                      {%- endfor -%}
                    </div>
                  {%- endif -%}

                  {%- if leaflet_section.title_2 or leaflet_section.description_2 -%}
                    <div class="leaflet-second-section">
                      {%- if leaflet_section.language_selector -%}
                        <div class="leaflet-country-switcher">
                          {% render 'markets-switcher', display_language: true, leaftlet_switcher: true %}
                        </div>
                      {%- endif -%}
                      {%- if leaflet_section.title_2 -%}
                        {% render 'c-title', custom_tag: 'h6', content: leaflet_section.title_2, classes: 'pb-[10px]'  %}
                      {% endif %}
                      {%- if leaflet_section.description_2 -%}
                        {{ leaflet_section.description_2 | metafield_tag }}
                      {%- endif -%}
                    </div>
                  {%- endif -%}
                {%- endfor -%}
              {%- endcapture -%}
              {%- if leaflet_value != blank -%}
                {% render 'c-drawer',
                  toggle_button: leaflet_modal_trigger,
                  drawer_id: 'product-leaflet',
                  drawer_content: leaflet_content,
                  drawer_header: leaflet_header,
                  drawer_body_classes: 'drawer-content px-4 md:px-[30px] !flex flex-col gap-[30px] py-6 overflow-y-auto',
                  drawer_content_classes: 'bg-background',
                  drawer_width: 'lg'
                %}
              {%- endif -%}
            {%- endif -%}
          {%- endcapture -%}

          {%- if dropdown_title != blank -%}
            {%- if leaflet_value != blank or dropdown_content != blank -%}
              {% render 'c-accordion',
                accordion_label: dropdown_title,
                accordion_content: block_content,
                accordion_borders: true,
                open_on_load: open_on_load,
                index: forloop.index,
                accordion_label_padding: 'py-3 sm:py-6',
                extra_classes: 'py-2',
                full_width_section: section.settings.full_width_section
              %}
            {%- endif -%}
          {%- endif -%}
        {%- endfor -%}
      </div>
    </div>
    <div class="w-full md:w-1/2 {% if section.settings.full_width_section == false %}px-4 lg:pl-2 lg:pr-8{% endif %}">
      {% liquid
        assign media_max_height = section.settings.media_max_height
        case media_max_height
          when 'small'
            assign media_max_height_class = 'max-h-[500px]'
          when 'medium'
            assign media_max_height_class = 'max-h-[600px]'
          when 'large'
            assign media_max_height_class = 'max-h-[700px]'
          else
            assign media_max_height_class = ''
        endcase
      %}
      {% render 'c-image', image: section.settings.image, classes: 'h-full', image_classes: media_max_height_class %}
    </div>
  </div>
  {%- render 'divider', height: section.settings.margin_bottom, color_scheme: color_scheme -%}
{%- endunless -%}

{% schema %}
{
  "name": "t:sections.image-dropdowns.name",
