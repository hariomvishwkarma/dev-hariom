{% liquid
  assign full_width = section.settings.full_width
  assign faq_headline = section.settings.faq_headline
  assign split_content = section.settings.split_content

  assign title_description_alignment = section.settings.title_description_alignment
  assign headline_font_size = section.settings.headline_font_size

  case title_description_alignment
    when 'left'
      assign title_description_alignment_classes = 'text-left items-start'
    when 'center'
      assign title_description_alignment_classes = 'text-center items-center'
    when 'right'
      assign title_description_alignment_classes = 'text-right items-end'
  endcase

  case headline_font_size
    when 'small'
      assign headline_size = 'text-2xl'
    when 'medium'
      assign headline_size = 'text-5xl'
    when 'large'
      assign headline_size = 'text-7xl'
  endcase
%}

<style>
  #shopify-section-{{ section.id }} {
    --section-padding-y: {{ section.settings.padding_y }}px;
    --section-padding-y-mobile: {{ section.settings.padding_y_mobile }}px;
  }

  .faq-block-wrapper b {
    width: auto;
  }
</style>

<div class="faq-block-wrapper {% if full_width %} container-fluid{% else %} container{% endif %} py-[var(--section-padding-y-mobile)] md:py-[var(--section-padding-y)] color-{{ section.settings.color_scheme }}">
  <div class="{% if split_content %}flex w-full justify-center flex-col md:flex-row gap-8 px-9{% endif %} ">
    {% if faq_headline != blank %}
      <div class="faq-block-headline-wrapper {% if split_content %}md:w-1/3 flex items-center{% endif %} {{ title_description_alignment_classes }}">
        <h3 class="{{ headline_size }}">{{ faq_headline }}</h3>
      </div>
    {% endif %}
    <div class="faq-block {% if split_content %}md:w-2/3{% endif %} container-fluid color-{{ section.settings.faq_color_scheme }} rounded-lg">
      {% for block in section.blocks %}
        {% case block.type %}
          {% when 'faq' %}
            <div>
              {% render 'faq',
                headline: block.settings.faq_headline,
                content: block.settings.faq_content,
                image: block.settings.faq_image
              %}
            </div>
        {% endcase %}
      {% endfor %}
    </div>
  </div>
</div>
{% render 'divider',
  height: section.settings.margin_bottom,
  custom: section.settings.margin_bottom_custom,
  color_scheme: section.settings.color_scheme
%}

{% schema %}
{
  "name": "t:sections.faqs.name",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label"
    },
    {
      "type": "color_scheme",
      "id": "faq_color_scheme",
      "label": "t:sections.all.colors.label"
    },
    {
      "type": "checkbox",
      "id": "full_width",
      "label": "t:sections.faqs.settings.full_width"
    },
    {
      "type": "text",
      "id": "faq_headline",
      "label": "t:sections.faqs.settings.headline"
    },
    {
      "type": "select",
      "id": "headline_font_size",
      "label": "t:sections.faqs.settings.headline_font_size.label",
      "options": [
        {
          "label": "t:sections.faqs.settings.headline_font_size.options.small",
          "value": "small"
        },
        {
          "label": "t:sections.faqs.settings.headline_font_size.options.medium",
          "value": "medium"
        },
        {
          "label": "t:sections.faqs.settings.headline_font_size.options.large",
          "value": "large"
        }
      ],
      "default": "medium"
    },
    {
      "type": "checkbox",
      "id": "split_content",
      "label": "t:sections.faqs.settings.split_content",
      "visible_if": "{{ section.settings.faq_headline != blank }}"
    },
    {
      "type": "select",
      "id": "title_description_alignment",
      "label": "t:sections.testimonials.settings.title_description_alignment",
      "options": [
        {
          "value": "left",
          "label": "t:sections.testimonials.settings.alignment.options.left.label"
        },
        {
          "value": "center",
          "label": "t:sections.testimonials.settings.alignment.options.center.label"
        },
        {
          "value": "right",
          "label": "t:sections.testimonials.settings.alignment.options.right.label"
        }
      ]
    },
    {
      "type": "range",
      "id": "padding_y",
      "label": "Padding top and bottom",
      "min": 0,
      "max": 80,
      "step": 5,
      "default": 20,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding_y_mobile",
      "label": "Mobile Padding top and bottom",
      "min": 0,
      "max": 80,
      "step": 5,
      "default": 20,
      "unit": "px"
    },
    {
      "type": "select",
      "id": "margin_bottom",
      "label": "t:sections.all.margin.margin_bottom.label",
      "options": [
        {
          "label": "t:sections.all.margin.margin_bottom.none",
          "value": "none"
        },
        {
          "label": "t:sections.all.margin.margin_bottom.small",
          "value": "small"
        },
        {
          "label": "t:sections.all.margin.margin_bottom.normal",
          "value": "normal"
        },
        {
          "label": "t:sections.all.margin.margin_bottom.large",
          "value": "large"
        },
        {
          "label": "t:sections.all.margin.margin_bottom.custom.label",
          "value": "custom"
        }
      ],
      "default": "none"
    },
    {
      "type": "range",
      "min": 0,
      "max": 100,
      "default": 16,
      "step": 1,
      "label": "t:sections.all.margin.margin_bottom.custom.value",
      "visible_if": "{{ section.settings.margin_bottom == 'custom' }}",
      "unit": "px",
      "id": "margin_bottom_custom"
    }
  ],
  "blocks": [
    {
      "type": "faq",
      "name": "t:sections.faqs.name",
      "settings": [
        {
          "type": "text",
          "id": "faq_headline",
          "label": "t:sections.faqs.blocks.settings.headline"
        },
        {
          "type": "textarea",
          "id": "faq_content",
          "label": "t:sections.faqs.blocks.settings.content"
        },
        {
          "type": "image_picker",
          "id": "faq_image",
          "label": "t:sections.faqs.blocks.settings.image"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:sections.faqs.name"
    }
  ]
}
{% endschema %}
