{% liquid
  assign color_scheme = section.settings.color_scheme
  assign product_list = section.settings.product_list
  assign heading = section.settings.heading
  assign heading_tag = section.settings.heading_tag
  assign font_size = section.settings.font_size
  assign font_weight = section.settings.font_weight
  assign heading_type = font_size | append: ' ' | append: font_weight
%}
{% assign desktop_slides = section.settings.slider_product_visible_desktop | minus: 0.3 %}
{% assign large_slides = section.settings.slider_product_visible_large | minus: 0.3 %}
{%- capture swiper_options -%}
  {
    "slidesPerView": 2.3,
    "spaceBetween": 20,
    "loop": false,
    "navigation": {
      "nextEl": ".swiper-button-next",
      "prevEl": ".swiper-button-prev"
    },
    "breakpoints": {
      "768": {
        "slidesPerView": 2.1
      },
      "1280": {
        "slidesPerView": {{desktop_slides}}
      },
      "1636": {
        "slidesPerView": {{large_slides}}
      }
    },
    "scrollbar": {
      "el": ".swiper-scrollbar",
      "draggable": true
    }
  }
{%- endcapture -%}
{%- capture swiper_attribute -%}
  data-swiper='{{- swiper_options -}}'
{%- endcapture -%}

{% liquid
  assign bg_image = section.settings.bg_image
  assign bg_image_mobile = section.settings.bg_image_mobile | default: bg_image
  assign image_width = section.settings.image_width
  assign image_height = section.settings.image_height
  assign image_object_fit = section.settings.image_object_fit
  assign add_to_cart_position = section.settings.add_to_cart_position
  assign hide_add_to_cart_label = section.settings.hide_add_to_cart_label

  case image_width
    when 'small'
      assign image_width_class = 'md:grid-cols-2_3'
    when 'large'
      assign image_width_class = 'md:grid-cols-3_2'
    else
      assign image_width_class = 'md:grid-cols-2'
  endcase
  case image_height
    when 'small'
      assign image_height_class = 'md:h-[400px]'
    when 'medium'
      assign image_height_class = 'md:h-[500px]'
    when 'large'
      assign image_height_class = 'md:h-[600px]'
    else
      assign image_height_class = ''
  endcase
%}

<div class="space-y-10 md:space-y-0 md:grid {{ image_width_class }} gap-10 md:gap-[75px] items-end w-full color-{{ color_scheme }}">
  <div class="">
    {%- if heading != blank -%}
      {% render 'c-title',
        content: heading,
        custom_tag: heading_tag,
        type: heading_type,
        classes: 'container-fluid md:hidden pb-5'
      %}
    {%- endif -%}
    {% render 'shop-the-look-block',
      bg_image: bg_image,
      bg_image_mobile: bg_image_mobile,
      image_height_class: image_height_class,
      image_object_fit: image_object_fit,
      add_to_cart_position: add_to_cart_position,
      hide_add_to_cart_label: hide_add_to_cart_label,
      block_id: section.id,
      section_id: section.id,
      span_double: false,
      product_1: section.settings.product_1,
      product_1_position_x: section.settings.x_position_1,
      product_1_position_y: section.settings.y_position_1,
      product_1_position_x_mobile: section.settings.x_position_mobile_1,
      product_1_position_y_mobile: section.settings.y_position_mobile_1,
      product_2: section.settings.product_2,
      product_2_position_x: section.settings.x_position_2,
      product_2_position_y: section.settings.y_position_2,
      product_2_position_x_mobile: section.settings.x_position_mobile_2,
      product_2_position_y_mobile: section.settings.y_position_mobile_2,
      product_3: section.settings.product_3,
      product_3_position_x: section.settings.x_position_3,
      product_3_position_y: section.settings.y_position_3,
      product_3_position_x_mobile: section.settings.x_position_mobile_3,
      product_3_position_y_mobile: section.settings.y_position_mobile_3
    %}
  </div>
  <div class="">
    {%- if heading != blank -%}
      {% render 'c-title',
        content: heading,
        custom_tag: heading_tag,
        type: heading_type,
        classes: 'pb-5 hidden md:block'
      %}
    {%- endif -%}
    <div
      class="swiper swiper-card"
      {{ swiper_attribute }}
    >
      <div class="swiper-wrapper secondary-wrapper h-80">
        {%- for product in product_list -%}
          <div class="swiper-slide">
            {% render 'card-product', card_product: product, show_secondary_media: true, media_aspect_ratio: 'bibs' %}
          </div>
        {%- endfor -%}
      </div>
      <div class="swiper-highlighter-cat">
        <div class="swiper-button-prev !left-9 after:pr-[2px] swiper-button-disabled"></div>
        <div class="swiper-button-next !right-9 after:pl-[2px] swiper-button-disabled"></div>
      </div>
      <div class="swiper-scrollbar !left-0 hidden"></div>
    </div>
  </div>
</div>

{% render 'divider',
  height: section.settings.margin_bottom,
  custom: section.settings.margin_bottom_custom,
  color_scheme: section.settings.color_scheme
%}

