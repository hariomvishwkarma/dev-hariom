{%- if section.blocks.size > 0 -%}
  <div class="flex justify-around container-fluid flex-wrap gap-2.5 color-{{ section.settings.color_scheme }}">
    {% for block in section.blocks %}
      <div class="flex flex-row w-max items-center gap-1 sm:gap-2 md:gap-3.5">
        {% liquid
          if block.settings.icon
            render 'c-image', image: block.settings.icon, image_fit: 'contain', classes: 'w-3 h-3 sm:h-6 sm:w-6 md:h-8 md:w-8'
          endif
        %}
        <div class="mt-1 text-xxs md:text-2xl sm:text-lg font-medium">
          {{ block.settings.title }}
        </div>
      </div>
    {% endfor %}
  </div>
  {% render 'divider',
    height: section.settings.margin_bottom,
    custom: section.settings.margin_bottom_custom,
    color_scheme: section.settings.color_scheme
  %}
{%- endif -%}

{% schema %}
{
  "name": "t:sections.usps.name",
  "class": "section-usps",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "background-1"
    },
    {
      "type": "header",
      "content": "t:sections.all.margin.heading"
    },
    {
      "type": "select",
      "id": "margin_bottom",
      "label": "t:sections.all.margin.margin_bottom.label",
      "options": [
        {
          "label": "t:sections.all.margin.margin_bottom.none",
          "value": "none"
        },
        {
          "label": "t:sections.all.margin.margin_bottom.small",
          "value": "small"
        },
        {
          "label": "t:sections.all.margin.margin_bottom.normal",
          "value": "normal"
        },
        {
          "label": "t:sections.all.margin.margin_bottom.large",
          "value": "large"
        },
        {
          "label": "t:sections.all.margin.margin_bottom.custom.label",
          "value": "custom"
        }
      ],
      "default": "none"
    },
    {
      "type": "range",
      "min": 0,
      "max": 100,
      "default": 16,
      "step": 1,
      "label": "t:sections.all.margin.margin_bottom.custom.value",
      "visible_if": "{{ section.settings.margin_bottom == 'custom' }}",
      "unit": "px",
      "id": "margin_bottom_custom"
    }
  ],
  "blocks": [
    {
      "name": "USP",
      "type": "text",
      "limit": 4,
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Default text"
        },
        {
          "type": "image_picker",
          "id": "icon",
          "label": "Icon"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:sections.usps.presets.name"
    }
  ]
}
{% endschema %}
