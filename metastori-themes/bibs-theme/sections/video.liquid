{%- comment -%}
  Renders a video section with a title, description, and video player.
{%- endcomment -%}

{% liquid
  assign section_settings = section.settings
  assign title = section_settings.title
  assign description = section_settings.description
  assign video_url = section_settings.video_url
  assign video_size = section_settings.video_size
  assign autoplay = section_settings.autoplay
  assign loop = section_settings.loop
  assign controls = section_settings.controls
  assign margin_bottom = section_settings.margin_bottom
%}

{%- if video_url != blank -%}
  {% style %}
    #shopify-section-{{ section.id }} {
      --section-padding-y: {{ section_settings.padding_y }}px;
      --section-padding-y-mobile: {{ section_settings.padding_y_mobile }}px;
    }
  {% endstyle %}

  <div class="container-fluid space-y-5 py-[var(--section-padding-y-mobile)] md:py-[var(--section-padding-y)]">
    <div class="section__text">
      {%- if title != blank -%}
        {% render 'c-title', content: title, custom_tag: 'h3' %}
      {%- endif -%}
      {%- if description != blank -%}
        {% render 'c-richtext', content: description %}
      {%- endif -%}
    </div>
    {%- assign iframe_classes = 'w-full m-auto aspect-video' -%}
    {%- if video_size == 'small' -%}
      {%- assign iframe_classes = iframe_classes | append: ' max-w-xl' -%}
    {%- elsif video_size == 'medium' -%}
      {%- assign iframe_classes = iframe_classes | append: ' max-w-2xl' -%}
    {%- endif -%}
    {%- assign video_id = video_url | split: '/' | last -%}
    {%- if video_url contains 'tiktok.com' -%}
      <blockquote
        class="tiktok-embed"
        cite="{{ video_url }}"
        data-video-id="{{ video_id }}"
      >
        <section></section>
      </blockquote>
      <script async src="https://www.tiktok.com/embed.js"></script>
    {%- elsif video_url contains 'youtube.com' -%}
      <iframe
        src="https://www.youtube.com/embed/{{ video_id }}?enablejsapi=1{%- if autoplay -%}&autoplay=1&mute=1{%- endif -%}{%- if loop -%}&loop=1{%- endif -%}{%- unless controls -%}&controls=0{%- endunless -%}"
        class="{{ iframe_classes }}"
        allow="autoplay; encrypted-media"
        referrerpolicy="strict-origin-when-cross-origin"
        allowfullscreen
        frameborder="0"
        title="{{ description | escape }}"
      ></iframe>
    {%- elsif video_url contains 'vimeo.com' -%}
      <iframe
        src="https://player.vimeo.com/video/{{ video_id }}?t=0{%- if autoplay -%}autoplay=1&muted=1{%- endif -%}{%- if loop -%}&loop=1{%- endif -%}{%- unless controls -%}&controls=0{%- endunless -%}"
        class="{{ iframe_classes }}"
        allow="autoplay; encrypted-media"
        referrerpolicy="strict-origin-when-cross-origin"
        allowfullscreen
        frameborder="0"
        title="{{ description | escape }}"
      ></iframe>
    {%- endif -%}
  </div>
  {% render 'divider', height: margin_bottom, color_scheme: section.settings.color_scheme %}
{%- endif -%}

{% schema %}
{
  "name": "Video",
  "class": "section-video",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Title",
      "default": "Watch Our Video"
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "Description",
      "default": "<p>Watch our video to learn more about our products and services.</p>"
    },
    {
      "type": "text",
      "id": "video_url",
      "default": "https://www.youtube.com/embed/d_y0zZ3RoBo",
      "label": "Video URL",
      "info": "URL to embed video. End of the URL must always be '/VIDEO_ID' [YouTube, Vimeo, and TikTok]"
    },
    {
      "type": "header",
      "content": "Video settings",
      "info": "These settings does not work for TikTok videos."
    },
    {
      "type": "select",
      "id": "video_size",
      "label": "Video size",
      "options": [
        {
          "label": "Small",
          "value": "small"
        },
        {
          "label": "Medium",
          "value": "medium"
        },
        {
          "label": "Full width (Boxed)",
          "value": "full"
        }
      ],
      "default": "full",
      "info": "Select the size of the video player. (NOT for tiktok videos)"
    },
    {
      "type": "checkbox",
      "id": "autoplay",
      "label": "Autoplay video",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "loop",
      "label": "Enable video looping",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "controls",
      "label": "Show video controls",
      "default": false
    },
    {
      "type": "header",
      "content": "Section spacing"
    },
    {
      "type": "range",
      "id": "padding_y",
      "label": "Padding top and bottom",
      "min": 0,
      "max": 80,
      "step": 5,
      "default": 0,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding_y_mobile",
      "label": "Mobile Padding top and bottom",
      "min": 0,
      "max": 80,
      "step": 5,
      "default": 0,
      "unit": "px"
    },
    {
      "type": "select",
      "id": "margin_bottom",
      "label": "t:sections.all.margin.margin_bottom.label",
      "options": [
        {
          "label": "t:sections.all.margin.margin_bottom.none",
          "value": "none"
        },
        {
          "label": "t:sections.all.margin.margin_bottom.small",
          "value": "small"
        },
        {
          "label": "t:sections.all.margin.margin_bottom.normal",
          "value": "normal"
        },
        {
          "label": "t:sections.all.margin.margin_bottom.large",
          "value": "large"
        },
        {
          "label": "t:sections.all.margin.margin_bottom.custom.label",
          "value": "custom"
        }
      ],
      "default": "none"
    },
    {
      "type": "range",
      "min": 0,
      "max": 100,
      "default": 16,
      "step": 1,
      "label": "t:sections.all.margin.margin_bottom.custom.value",
      "visible_if": "{{ section.settings.margin_bottom == 'custom' }}",
      "unit": "px",
      "id": "margin_bottom_custom"
    }
  ],
  "presets": [
    {
      "name": "Video"
    }
  ]
}
{% endschema %}
