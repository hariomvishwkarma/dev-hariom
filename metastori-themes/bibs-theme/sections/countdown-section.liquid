{% liquid
  assign banner_image = section.settings.banner_image
  assign image_height = section.settings.image_height

  assign modal_content = section.settings.modal_content

  assign headline_text = section.settings.headline_text
  assign headline_text_font_size = section.settings.headline_text_font_size
  assign headline_helper = section.settings.headline_helper
  assign headline_helper_font_size = section.settings.headline_helper_font_size
%}
<countdown-section>
  <div class="color-{{ section.settings.color_scheme }}">
    <div class="container flex flex-col sm:flex-row gap-4 sm:gap-8 py-4 justify-center">
      <div class="section-1 flex-1 relative">
        {% liquid
          case image_height
            when 'small'
              assign image_height_class = 'max-h-[200px] lg:max-h-[250px]'
            when 'medium'
              assign image_height_class = 'max-h-[250px] lg:max-h-[300px]'
            when 'large'
              assign image_height_class = 'max-h-[300px] lg:max-h-[350px]'
            else
              assign image_height_class = ''
          endcase

          assign image_height_class = image_height_class | append: ' rounded-lg'
        %}
        {% render 'c-image', image: banner_image, image_classes: image_height_class, aspect_ratio: 'bibs' %}
        {% capture countdown_modal %}
          <p>{{ modal_content }}</p>
        {% endcapture %}
        {% if modal_content != blank %}
          {% render 'c-modal',
            translatable_toggle_label: 'general.all.terms',
            modal_size: 'medium',
            modal_content: countdown_modal,
            modal_id: 'countdown-info-modal',
            button_style: 'link--hover',
            button_classes: 'absolute rounded-lg bottom-4 right-4 bg-white text-black py-1 px-3'
          %}
        {% endif %}
      </div>

      <div class="section-2 flex sm:gap-8 flex-1 flex-col justify-center items-start">
        {% liquid
          case headline_helper_font_size
            when 'small'
              assign headline_helper_font_size = 'text-[.8rem]'
            when 'medium'
              assign headline_helper_font_size = 'text-[1.8rem]'
            when 'large'
              assign headline_helper_font_size = 'text-[2.8rem]'
            else
              assign headline_helper_font_size = ''
          endcase

          case headline_text_font_size
            when 'small'
              assign headline_text_font_size = 'text-[1rem]'
            when 'medium'
              assign headline_text_font_size = 'text-[2rem]'
            when 'large'
              assign headline_text_font_size = 'text-[3rem]'
            else
              assign headline_text_font_size = ''
          endcase
        %}

        <div class=" flex flex-col gap-1">
          <p class="uppercase {{ headline_helper_font_size }}">{{ headline_helper }}</p>
          <h2 class="{{ headline_text_font_size }}">{{ headline_text }}</h2>
        </div>

        {% render 'countdown',
          id: section.id,
          end_time: section.settings.end_time,
          is_header: false,
          classes: 'mx-auto'
        %}
      </div>
    </div>
  </div>
</countdown-section>

{% style %}
  .number-block {
    padding: 0.2rem;
    letter-spacing: 0.1rem;
  }
{% endstyle %}
{% schema %}
{
  "name": "Countdown Sale Section",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label"
    },
    {
      "type": "header",
      "content": "t:sections.countdown-section.settings.headers.collections"
    },
    {
      "type": "collection_list",
      "id": "visible_collections",
      "label": "t:sections.countdown-section.settings.headers.select_collections.label",
      "info": "t:sections.countdown-section.settings.headers.select_collections.info"
    },
    {
      "type": "header",
      "content": "t:sections.countdown-section.settings.headlines.label"
    },
    {
      "type": "text",
      "id": "headline_helper",
      "label": "t:sections.countdown-section.settings.headlines.helper"
    },
    {
      "type": "select",
      "label": "Font size",
      "id": "headline_helper_font_size",
      "options": [
        {
          "label": "t:sections.countdown-section.settings.font-size.options.small.label",
          "value": "small"
        },
        {
          "label": "t:sections.countdown-section.settings.font-size.options.medium.label",
          "value": "medium"
        },
        {
          "label": "t:sections.countdown-section.settings.font-size.options.large.label",
          "value": "large"
        }
      ],
      "default": "small"
    },
    {
      "type": "text",
      "id": "headline_text",
      "label": "t:sections.countdown-section.settings.headlines.headline"
    },
    {
      "type": "select",
      "label": "Font size",
      "id": "headline_text_font_size",
      "options": [
        {
          "label": "t:sections.countdown-section.settings.font-size.options.small.label",
          "value": "small"
        },
        {
          "label": "t:sections.countdown-section.settings.font-size.options.medium.label",
          "value": "medium"
        },
        {
          "label": "t:sections.countdown-section.settings.font-size.options.large.label",
          "value": "large"
        }
      ],
      "default": "large"
    },
    {
      "type": "text",
      "id": "end_time",
      "label": "t:sections.countdown-section.settings.end_time.label",
      "default": "09/09/2025 23:00:00",
      "info": "t:sections.countdown-section.settings.end_time.info"
    },
    {
      "type": "image_picker",
      "label": "t:sections.countdown-section.settings.image_picker.label",
      "id": "banner_image"
    },
    {
      "type": "select",
      "id": "image_height",
      "label": "t:sections.image-section.settings.image_height.label",
      "options": [
        {
          "value": "small",
          "label": "t:sections.image-section.settings.image_height.options.small.label"
        },
        {
          "value": "medium",
          "label": "t:sections.image-section.settings.image_height.options.medium.label"
        },
        {
          "value": "large",
          "label": "t:sections.image-section.settings.image_height.options.large.label"
        }
      ]
    },
    {
      "type": "richtext",
      "id": "modal_content",
      "label": "t:sections.countdown-section.settings.modal.label"
    }
  ],
  "presets": [{ "name": "Countdown Sale Section" }]
}
{% endschema %}
