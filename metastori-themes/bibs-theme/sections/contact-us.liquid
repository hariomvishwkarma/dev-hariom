{% liquid
  assign settings = section.settings
  assign color_scheme = section.settings.color_scheme
  assign intro_text = settings.intro_text
  assign header = settings.contact_header
  assign subheader = settings.contact_subheader
  assign jump_to_message_block_only_mobile = settings.jump_to_message_block_only_mobile
  assign box_classes = 'p-5 md:px-[30px] border border-foreground rounded flex flex-col gap-2.5 w-full md:w-[372px]'
  assign accordion_label_classes = 'paragraph-3'
  assign accordion_content_classes = 'paragraph-4 mt-1.5'
  assign accordion_label_padding = 'p-0'
  assign accordion_icon_classes = 'ml-auto !w-[7px]'

  assign has_faq = false
  if settings.faq_text_1 != blank and settings.faq_label_1 != blank
    assign has_faq = true
  elsif settings.faq_text_2 != blank and settings.faq_label_2 != blank
    assign has_faq = true
  elsif settings.faq_text_3 != blank and settings.faq_label_3 != blank
    assign has_faq = true
  elsif settings.faq_text_4 != blank and settings.faq_label_4 != blank
    assign has_faq = true
  elsif settings.faq_text_5 != blank and settings.faq_label_5 != blank
    assign has_faq = true
  elsif settings.faq_text_6 != blank and settings.faq_label_6 != blank
    assign has_faq = true
  endif
%}

<div class="color-{{ color_scheme }} container-page">
  <div class="grid gap-x-10 gap-y-6 md:gap-y-10">
    {% if intro_text %}
      {% render 'c-text', content: intro_text, classes: 'text-center md:text-left' %}
    {% endif %}

    <div class="flex flex-col md:flex-row gap-4">
      <div class="bg-secondary-background p-5 min-w-[282px] w-full md:w-fit h-fit flex flex-col gap-[14px] rounded {% if jump_to_message_block_only_mobile %}md:hidden{% endif %}">
        {% render 'c-icon', icon: 'message_w_lines', classes: 'h-[21px]' %}
        {% render 'c-title', custom_tag: 'h5', translatable_content: 'sections.contact-us.claimlane.header' %}
        {% render 'c-text', translatable_content: 'sections.contact-us.claimlane.text' %}
        {% comment %} Check if US or WW {% endcomment %}
        {% if localization.country.iso_code == 'US' %}
          {% render 'c-link',
            href: 'https://app.claimlane.com/c/bibs-usa',
            translatable_content: 'sections.contact-us.claimlane.button_text',
            classes: 'button_outline--primary rounded-full shadow-none w-fit h-fit',
            target: '_blank'
          %}
        {% else %}
          {% render 'c-link',
            href: 'https://app.claimlane.com/c/bibs-ww',
            translatable_content: 'sections.contact-us.claimlane.button_text',
            classes: 'button_outline--primary rounded-full shadow-none w-fit h-fit',
            target: '_blank'
          %}
        {% endif %}
      </div>

      <div class="bg-secondary-background p-5 min-w-[282px] w-full md:w-fit h-fit flex flex-col gap-[14px] rounded {% if jump_to_message_block_only_mobile %}md:hidden{% endif %}">
        {% render 'c-icon', icon: 'message_w_lines', classes: 'h-[21px]' %}
        {% render 'c-title',
          custom_tag: 'h5',
          translatable_content: 'sections.contact-us.jump_to_message_block_only_mobile.header'
        %}
        {% render 'c-text', translatable_content: 'sections.contact-us.jump_to_message_block_only_mobile.text' %}
        {% render 'c-link',
          href: '#contact-page',
          translatable_content: 'sections.contact-us.jump_to_message_block_only_mobile.button_text',
          classes: 'button_outline--primary rounded-full shadow-none w-fit h-fit',
          id: 'contact_form_button'
        %}
      </div>
    </div>

    {% javascript %}
      const contact_form_button = document.querySelector('#contact_form_button');
      const contact_page = document.querySelector('#contact-page');
      contact_form_button.addEventListener('click', function () {
        contact_page.classList.toggle('hidden');
      });
    {% endjavascript %}

    {% render 'contact-form',
      heading: header,
      intro_text: subheader,
      color_scheme: color_scheme,
      margin_bottom: 'none',
      disable_container_fluid_class: true,
      justify_left: true,
      include_company_inputs: false,
      container_classes: 'mt-5 md:mt-0 w-full hidden',
      header_tag: 'h4'
    %}

    <div class="contact--right-col flex flex-col gap-4 w-full md:w-fit ml-auto">
      <div class="{{box_classes}}">
        {% render 'c-title', custom_tag: 'h6', translatable_content: 'sections.contact-us.account-block.header' %}
        {% render 'c-text', translatable_content: 'sections.contact-us.account-block.header' %}
        {% render 'c-link',
          href: routes.account_url,
          translatable_content: 'sections.contact-us.account-block.button_text',
          classes: 'button_outline--primary rounded-full shadow-none w-fit h-fit'
        %}
      </div>

      {% if has_faq %}
        <div class="{{box_classes}}">
          {% render 'c-title', custom_tag: 'h6', translatable_content: 'sections.contact-us.faq_block.header' %}
          <div class="flex flex-col gap-4">
            {% if settings.faq_text_1 != blank and settings.faq_label_1 != blank %}
              {% render 'c-accordion',
                accordion_label: settings.faq_label_1,
                accordion_content: settings.faq_text_1,
                accordion_content_class: accordion_content_classes,
                accordion_label_class: accordion_label_classes,
                accordion_label_padding: accordion_label_padding,
                accordion_icon_classes: accordion_icon_classes
              %}
            {% endif %}
            {% if settings.faq_text_2 != blank and settings.faq_label_2 != blank %}
              {% render 'c-accordion',
                accordion_label: settings.faq_label_2,
                accordion_content: settings.faq_text_2,
                accordion_content_class: accordion_content_classes,
                accordion_label_class: accordion_label_classes,
                accordion_label_padding: accordion_label_padding,
                accordion_icon_classes: accordion_icon_classes
              %}
            {% endif %}
            {% if settings.faq_text_3 != blank and settings.faq_label_3 != blank %}
              {% render 'c-accordion',
                accordion_label: settings.faq_label_3,
                accordion_content: settings.faq_text_3,
                accordion_content_class: accordion_content_classes,
                accordion_label_class: accordion_label_classes,
                accordion_label_padding: accordion_label_padding,
                accordion_icon_classes: accordion_icon_classes
              %}
            {% endif %}
            {% if settings.faq_text_4 != blank and settings.faq_label_4 != blank %}
              {% render 'c-accordion',
                accordion_label: settings.faq_label_4,
                accordion_content: settings.faq_text_4,
                accordion_content_class: accordion_content_classes,
                accordion_label_class: accordion_label_classes,
                accordion_label_padding: accordion_label_padding,
                accordion_icon_classes: accordion_icon_classes
              %}
            {% endif %}
            {% if settings.faq_text_5 != blank and settings.faq_label_5 != blank %}
              {% render 'c-accordion',
                accordion_label: settings.faq_label_5,
                accordion_content: settings.faq_text_5,
                accordion_content_class: accordion_content_classes,
                accordion_label_class: accordion_label_classes,
                accordion_label_padding: accordion_label_padding,
                accordion_icon_classes: accordion_icon_classes
              %}
            {% endif %}
            {% if settings.faq_text_6 != blank and settings.faq_label_6 != blank %}
              {% render 'c-accordion',
                accordion_label: settings.faq_label_6,
                accordion_content: settings.faq_text_6,
                accordion_content_class: accordion_content_classes,
                accordion_label_class: accordion_label_classes,
                accordion_label_padding: accordion_label_padding,
                accordion_icon_classes: accordion_icon_classes
              %}
            {% endif %}
          </div>
        </div>
      {% endif %}
    </div>
  </div>
</div>
{% render 'divider',
  height: section.settings.margin_bottom,
  custom: section.settings.margin_bottom_custom,
  color_scheme: color_scheme
%}

{% schema %}
{
  "name": "t:sections.contact-us.name",
  "class": "section-collection-banner",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "background-1"
    },
    {
      "type": "text",
      "id": "intro_text",
      "label": "t:sections.contact-us.settings.intro_text.label"
    },
    {
      "type": "checkbox",
      "id": "jump_to_message_block_only_mobile",
      "label": "t:sections.contact-us.settings.jump_to_message_block_only_mobile.label"
    },
    {
      "type": "text",
      "id": "contact_header",
      "label": "t:sections.contact-us.settings.contact_header.label"
    },
    {
      "type": "text",
      "id": "contact_subheader",
      "label": "t:sections.contact-us.settings.contact_subheader.label"
    },
    {
      "type": "text",
      "id": "faq_label_1",
      "label": "t:sections.contact-us.settings.faq_label_1.label"
    },
    {
      "type": "text",
      "id": "faq_text_1",
      "label": "t:sections.contact-us.settings.faq_text_1.label"
    },
    {
      "type": "text",
      "id": "faq_label_2",
      "label": "t:sections.contact-us.settings.faq_label_2.label"
    },
    {
      "type": "text",
      "id": "faq_text_2",
      "label": "t:sections.contact-us.settings.faq_text_2.label"
    },
    {
      "type": "text",
      "id": "faq_label_3",
      "label": "t:sections.contact-us.settings.faq_label_3.label"
    },
    {
      "type": "text",
      "id": "faq_text_3",
      "label": "t:sections.contact-us.settings.faq_text_3.label"
    },
    {
      "type": "text",
      "id": "faq_label_4",
      "label": "t:sections.contact-us.settings.faq_label_4.label"
    },
    {
      "type": "text",
      "id": "faq_text_4",
      "label": "t:sections.contact-us.settings.faq_text_4.label"
    },
    {
      "type": "text",
      "id": "faq_label_5",
      "label": "t:sections.contact-us.settings.faq_label_5.label"
    },
    {
      "type": "text",
      "id": "faq_text_5",
      "label": "t:sections.contact-us.settings.faq_text_5.label"
    },
    {
      "type": "text",
      "id": "faq_label_6",
      "label": "t:sections.contact-us.settings.faq_label_6.label"
    },
    {
      "type": "text",
      "id": "faq_text_6",
      "label": "t:sections.contact-us.settings.faq_text_6.label"
    },
    {
      "type": "header",
      "content": "t:sections.all.margin.heading"
    },
    {
      "type": "select",
      "id": "margin_bottom",
      "label": "t:sections.all.margin.margin_bottom.label",
      "options": [
        {
          "label": "t:sections.all.margin.margin_bottom.none",
          "value": "none"
        },
        {
          "label": "t:sections.all.margin.margin_bottom.small",
