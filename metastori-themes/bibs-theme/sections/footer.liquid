{% if section.settings.footer_background_watermark %}
  <style>
    #footer{
      --footer-background-position: {{section.settings.background_position}};
      background-image: url("{{section.settings.footer_background_watermark.src | image_url }}");
    }
  </style>
{% endif %}

<footer
  id="footer"
  class="color-{{ section.settings.color_scheme }} footer border-t border-grey-300 {% if section.settings.footer_background_watermark %}footer-watermark{% endif %}"
>
  <div class="container-fluid mt-10 lg:mt-[60px]">
    <div class="flex pb-10 justify-between flex-col-reverse lg:flex-row gap-10 lg:gap-[22px]">
      <div class="flex flex-col lg:flex-row gap-10 lg:gap-[22px] flex-wrap">
        {% for block in section.blocks %}
          {% case block.type %}
            {% when 'footer-contact' %}
              {% render 'footer-contact', block: block.settings %}
            {% when 'footer-nav-items' %}
              <div class="min-w-[176px]">
                {% render 'footer-menu', block: block.settings %}
              </div>
          {% endcase %}
        {% endfor %}
      </div>
      {% render 'footer-signup-form' %}
    </div>

    {% if section.settings.additional_info != '' %}
      <div class="additonal_info--wrapper mb-4">
        {{ section.settings.additional_info }}
      </div>
    {% endif %}

    {% if section.settings.show_social_icons %}
      {% render 'footer-social-icons', section: section %}
    {% endif %}
  </div>

  <div class="border-t border-grey-300">
    <div class="container-fluid py-3.5 ">
      <div class="flex flex-col lg:flex-row justify-start items-start lg:items-center">
        {% if section.settings.copyright_text != blank %}
          <div class="footer-copyright text-sm font-medium mr-6 mb-3 lg:mb-0">
            {{ section.settings.copyright_text }}
          </div>
        {% endif %}
        <div class="footer-menu flex flex-wrap flex-row items-center gap-5 lg:gap-7">
          {% if section.settings.logo and section.settings.additional_menu_logo %}
            {% render 'c-image',
              image: section.settings.logo,
              classes: 'hidden lg:block h-5',
              image_classes: 'h-full !object-contain object-left',
              lazy: 'lazy'
            %}
          {% endif %}
          {% for link in linklists[section.settings.additional_menu].links %}
            <div class="">
              <a href="{{ link.url }}" class="text-xs">
                {{ link.title }}
              </a>
            </div>
          {% endfor %}
        </div>
        {%- if section.settings.footer_payment_enable -%}
          <div class="footer-payment-icons m-auto flex flex-wrap gap-2.5">
            {% liquid
              for i in (1..12)
                assign icon_id = 'icon_' | append: i
                assign current_icon = section.settings[icon_id]
                if current_icon
                  render 'footer-payment-icon', icon: current_icon
                endif
              endfor
            %}
          </div>
        {%- endif -%}
      </div>
    </div>
  </div>
</footer>
{% render 'divider',
  height: section.settings.margin_bottom,
  custom: section.settings.margin_bottom_custom,
  color_scheme: section.settings.color_scheme
%}
{% render 'notify-sold-out', section_id: section.id %}
{% schema %}
{
  "name": "t:sections.footer.name",
  "class": "section-footer",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "background-1"
    },
    {
      "type": "image_picker",
      "id": "logo",
      "label": "t:sections.footer.settings.logo.label"
    },
    {
      "type": "checkbox",
      "id": "contact_logo",
      "label": "t:sections.footer.settings.contact_logo.label"
    },
    {
      "type": "checkbox",
      "id": "show_social_icons",
      "label": "t:sections.footer.settings.show_social_icons.label",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "footer_payment_enable",
      "label": "t:sections.footer.settings.show_payment_icons.label",
      "default": true
    },
    {
      "type": "image_picker",
      "id": "footer_background_watermark",
      "label": "t:sections.footer.settings.background_watermark.label"
    },
    {
      "type": "select",
      "id": "background_position",
      "label": "t:sections.footer.settings.background_position.label",
      "options": [
        {
          "label": "t:sections.footer.settings.background_position.settings.top_left",
          "value": "top left"
        },
        {
          "label": "t:sections.footer.settings.background_position.settings.top_center",
          "value": "top center"
        },
        {
          "label": "t:sections.footer.settings.background_position.settings.top_right",
          "value": "top right"
        },
        {
          "label": "t:sections.footer.settings.background_position.settings.bottom_left",
          "value": "bottom left"
        },
        {
          "label": "t:sections.footer.settings.background_position.settings.bottom_center",
          "value": "bottom center"
        },
        {
          "label": "t:sections.footer.settings.background_position.settings.bottom_right",
          "value": "bottom right"
        }
      ]
    },
    {
      "type": "header",
      "content": "t:sections.footer.settings.header.content"
    },
    {
      "type": "image_picker",
      "id": "icon_1",
      "label": "t:sections.footer.settings.icon_1.label"
    },
    {
      "type": "image_picker",
      "id": "icon_2",
      "label": "t:sections.footer.settings.icon_2.label"
    },
    {
      "type": "image_picker",
      "id": "icon_3",
      "label": "t:sections.footer.settings.icon_3.label"
    },
    {
      "type": "image_picker",
      "id": "icon_4",
      "label": "t:sections.footer.settings.icon_4.label"
    },
    {
      "type": "image_picker",
      "id": "icon_5",
      "label": "t:sections.footer.settings.icon_5.label"
    },
    {
      "type": "image_picker",
      "id": "icon_6",
      "label": "t:sections.footer.settings.icon_6.label"
    },
    {
      "type": "image_picker",
      "id": "icon_7",
      "label": "t:sections.footer.settings.icon_7.label"
    },
    {
      "type": "image_picker",
      "id": "icon_8",
      "label": "t:sections.footer.settings.icon_8.label"
    },
    {
      "type": "image_picker",
      "id": "icon_9",
      "label": "t:sections.footer.settings.icon_9.label"
    },
    {
      "type": "image_picker",
      "id": "icon_10",
      "label": "t:sections.footer.settings.icon_10.label"
    },
    {
      "type": "image_picker",
      "id": "icon_11",
      "label": "t:sections.footer.settings.icon_11.label"
    },
    {
      "type": "image_picker",
      "id": "icon_12",
      "label": "t:sections.footer.settings.icon_12.label"
    },
    {
      "type": "text",
      "id": "copyright_text",
      "default": "© Copyright BIBS 2025",
      "label": "t:sections.footer.settings.copyright_text.label"
    },
    {
      "type": "textarea",
      "id": "additional_info",
      "label": "t:sections.footer.settings.additional_info.label",
      "info": "t:sections.footer.settings.additional_info.info"
    },
    {
      "type": "link_list",
      "id": "additional_menu",
      "label": "t:sections.footer.settings.additional_menu_logo.label"
    },
    {
      "type": "checkbox",
      "id": "additional_menu_logo",
      "label": "t:sections.footer.settings.additional_menu_logo.label"
    },
    {
      "type": "header",
      "content": "t:sections.all.margin.heading"
    },
    {
      "type": "select",
      "id": "margin_bottom",
      "label": "t:sections.all.margin.margin_bottom.label",
      "options": [
        {
          "label": "t:sections.all.margin.margin_bottom.none",
          "value": "none"
        },
        {
          "label": "t:sections.all.margin.margin_bottom.small",
          "value": "small"
        },
        {
          "label": "t:sections.all.margin.margin_bottom.normal",
          "value": "normal"
        },
        {
          "label": "t:sections.all.margin.margin_bottom.large",
          "value": "large"
        },
        {
          "label": "t:sections.all.margin.margin_bottom.custom.label",
          "value": "custom"
        }
      ],
      "default": "none"
    },
    {
      "type": "range",
      "min": 0,
      "max": 100,
      "default": 16,
      "step": 1,
      "label": "t:sections.all.margin.margin_bottom.custom.value",
      "visible_if": "{{ section.settings.margin_bottom == 'custom' }}",
      "unit": "px",
      "id": "margin_bottom_custom"
    }
  ],
  "blocks": [
    {
      "type": "footer-contact",
      "limit": 1,
      "name": "Footer contact",
      "settings": [
        {
          "type": "url",
          "id": "footer_cs_link",
          "label": "Link to customer service page"
        },
        {
          "type": "text",
          "id": "footer_phone_number",
          "label": "t:sections.footer.settings.blocks.footer_phone_number.label"
        },
        {
          "type": "text",
          "id": "footer_email",
          "label": "t:sections.footer.settings.blocks.footer_email.label"
        },
        {
          "type": "text",
          "id": "footer_opening_hours",
          "label": "t:sections.footer.settings.blocks.footer_opening_hours.label"
        },
        {
          "type": "richtext",
          "id": "footer_company_address",
          "label": "t:sections.footer.settings.blocks.footer_company_address.label"
        },
        {
          "type": "text",
          "id": "footer_cvr",
          "label": "t:sections.footer.settings.blocks.footer_cvr.label"
        },
        {
          "type": "checkbox",
          "id": "markets_switcher",
          "label": "Show market switcher"
        }
      ]
