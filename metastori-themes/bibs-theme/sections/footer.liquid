    {
      "type": "footer-nav-items",
      "limit": 5,
      "name": "Navigation link",
      "settings": [
        {
          "type": "link_list",
          "id": "nav_link",
          "label": "t:sections.footer.settings.blocks.nav_link.label"
        },
        {
          "type": "text",
          "id": "nav_title",
          "label": "t:sections.footer.settings.blocks.nav_title.label"
        }
      ]
    },
    {
      "type": "footer-newsletter",
      "limit": 5,
      "name": "Newsletter signup",
      "settings": [
        {
          "type": "url",
          "id": "terms_link",
          "label": "Terms and conditions link"
        }
      ]
    },
    {
      "type": "footer-social-icons",
      "name": "Social icons",
      "settings": [
        {
          "type": "select",
          "id": "social_platform",
          "label": "Social platform",
          "options": [
            {
              "label": "Instagram",
              "value": "instagram_media"
            },
            {
              "label": "Facebook",
              "value": "facebook_media"
            },
            {
              "label": "YouTube",
              "value": "youtube_media"
            },
            {
              "label": "Twitter",
              "value": "twitter_media"
            },
            {
              "label": "Pinterest",
              "value": "pinterest_media"
            },
            {
              "label": "TikTok",
              "value": "tiktok_media"
            }
          ],
          "default": "instagram_media"
        },
        {
          "type": "url",
          "id": "social_url",
          "label": "Social URL"
        }
      ]
    }
  ]
}
{% endschema %}
