<div
  class="color-{{ section.settings.color_scheme }}"
>
  <div class="section-image-with-bullet-points flex md:flex-row items-start w-full flex-col gap-0 pt-10 pb-10 md:pb-0 lg:pt-20 lg:pb-20 justify-between">
    <div class="w-full md:w-1/2 lg:pl-16 px-4 pb-10 ">
      {% if section.settings.left_headline != blank %}
        {% render 'c-title',
          custom_tag: 'h2',
          content: section.settings.left_headline,
          classes: 'cus-headline text-2xl font-bold mb-4'
        %}
      {% endif %}
      <div class="flex flex-col text-xl font-normal">
        {% if section.settings.columns_with_left_text != '' %}
          {% render 'c-richtext', content: section.settings.columns_with_left_text %}
        {% endif %}
      </div>
      {% if section.settings.left_button_label != blank %}
        <div class="mt-6">
          <a
            href="{{ section.settings.left_button_url }}"
            class="button button_outline--primary "
          >
            {{- section.settings.left_button_label -}}
          </a>
        </div>
      {% endif %}
    </div>
    <div class="flex w-fit md:w-1/2 lg:pr-16 px-6 lg:max-w-[50%] pb-10">
      {% if section.settings.right_headline != blank %}
        {% render 'c-title',
          custom_tag: 'h2',
          content: section.settings.right_headline,
          classes: 'cus-headline text-2xl font-bold mb-4'
        %}
      {% endif %}
      <div class="flex w-full flex-col text-lg{% if section.settings.right_italic == true %} italic{% endif %}">
        {% if section.settings.section.settings.columns_with_right_textt != '' %}
          {% render 'c-richtext', content: section.settings.columns_with_right_text %}
        {% endif %}
      </div>
      {% if section.settings.right_button_label != blank %}
        <div class="mt-6">
          <a
            href="{{ section.settings.right_button_url }}"
            class="button button_outline--primary "
          >
            {{- section.settings.right_button_label -}}
          </a>
        </div>
      {% endif %}
    </div>
  </div>
</div>
{% render 'divider',
  height: section.settings.margin_bottom,
  custom: section.settings.margin_bottom_custom,
  color_scheme: section.settings.color_scheme
%}

{% schema %}
{
  "name": "t:sections.columns_with_text.name",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "background-1"
    },
    {
      "type": "header",
      "content": "Left column"
    },
    {
      "type": "text",
      "id": "left_headline",
      "label": "t:sections.columns_with_text.settings.left_headline.label"
    },
    {
      "type": "richtext",
      "id": "columns_with_left_text",
      "label": "t:sections.columns_with_text.settings.column_text.left_text.label"
    },
    {
      "type": "text",
      "id": "left_button_label",
      "label": "t:sections.columns_with_text.settings.left_button.label.label"
    },
    {
      "type": "url",
      "id": "left_button_url",
      "label": "t:sections.columns_with_text.settings.left_button.url.label"
    },
    {
      "type": "header",
      "content": "Right column"
    },
    {
      "type": "text",
      "id": "right_headline",
      "label": "t:sections.columns_with_text.settings.right_headline.label"
    },
    {
      "type": "richtext",
      "id": "columns_with_right_text",
      "label": "t:sections.columns_with_text.settings.column_text.right_text.label"
    },
    {
      "type": "checkbox",
      "id": "right_italic",
      "label": "t:sections.columns_with_text.settings.column_text.right__italic.label",
      "default": false
    },
    {
      "type": "text",
      "id": "right_button_label",
      "label": "t:sections.columns_with_text.settings.right_button.label.label"
    },
    {
      "type": "url",
      "id": "right_button_url",
      "label": "t:sections.columns_with_text.settings.right_button.url.label"
    },
    {
      "type": "select",
      "id": "margin_bottom",
      "label": "t:sections.all.margin.margin_bottom.label",
      "options": [
        {
          "label": "t:sections.all.margin.margin_bottom.none",
          "value": "none"
        },
        {
          "label": "t:sections.all.margin.margin_bottom.small",
          "value": "small"
        },
        {
          "label": "t:sections.all.margin.margin_bottom.normal",
          "value": "normal"
        },
        {
          "label": "t:sections.all.margin.margin_bottom.large",
          "value": "large"
        },
        {
          "label": "t:sections.all.margin.margin_bottom.custom.label",
          "value": "custom"
        }
      ],
      "default": "none"
    },
    {
      "type": "range",
      "min": 0,
      "max": 100,
      "default": 16,
      "step": 1,
      "label": "t:sections.all.margin.margin_bottom.custom.value",
      "visible_if": "{{ section.settings.margin_bottom == 'custom' }}",
      "unit": "px",
      "id": "margin_bottom_custom"
    }
  ],
  "presets": [
    {
      "name": "t:sections.columns_with_text.name"
    }
  ]
}
{% endschema %}
