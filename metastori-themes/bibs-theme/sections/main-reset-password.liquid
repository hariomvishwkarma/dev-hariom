{% liquid
  assign input_classes = 'py-3 focus:shadow-none peer-placeholder-shown:top-4'
  assign title = 'customer.reset_password.title' | t
  assign description = 'customer.reset_password.description' | t
  assign password_label = 'customer.reset_password.password_label' | t
  assign confirm_password_label = 'customer.reset_password.confirm_password_placeholder_label' | t
  assign submit_button_content = 'customer.reset_password.submit' | t | upcase

  assign heading_tag = section.settings.heading_tag
  assign font_size = section.settings.font_size
  assign font_weight = section.settings.font_weight
  assign heading_type = font_size | append: ' ' | append: font_weight
  assign italic_header_text = section.settings.italic_header_text
  if italic_header_text
    assign heading_type = heading_type | append: ' !italic'
  endif
%}

<div class="container-fluid color-{{ section.settings.color_scheme }}">
  <div class="max-w-sm mx-auto my-6" data-validation-required>
    {% render 'c-title', content: title, custom_tag: heading_tag, type: heading_type, classes: 'mb-6 md:mb-9' %}

    {% render 'c-text', content: description, classes: 'text-base mb-8' %}
    {% form 'reset_customer_password' %}
      <div data-auth-input class="mb-8 relative">
        {% render 'c-input',
          input_classes: input_classes,
          input_type: 'password',
          id: 'password',
          input_name: 'customer[password]',
          input_autocomplet: 'new-password',
          label_content: password_label
        %}
        <span>
          {% render 'c-icon',
            icon: 'visible_eye',
            classes: 'password-icon md:block absolute top-4 right-3 cursor-pointer password-visibility-icon right-4 w-4 h-4'
          %}
        </span>
      </div>

      <div data-auth-input class="relative">
        {% render 'c-input',
          input_classes: input_classes,
          input_type: 'password',
          id: 'password_confirmation',
          input_name: 'customer[password_confirmation]',
          input_autocomplet: 'new-password',
          label_content: confirm_password_label
        %}
        <span>
          {% render 'c-icon',
            icon: 'visible_eye',
            classes: 'password-icon md:block absolute top-4 right-3 cursor-pointer password-visibility-icon right-4 w-4 h-4'
          %}
        </span>
      </div>

      {% render 'form-errors', form_errors: form.errors %}

      {% render 'c-button',
        type: 'submit',
        id: 'submit-reset-password',
        content: submit_button_content,
        design: 'accent',
        classes: 'mb-[14.5px] mt-8 button--full-rounded disabled:bg-gray-400 text-center'
      %}
    {% endform %}
  </div>
</div>

