      "label": "t:sections.all.heading_tag.label",
      "id": "heading_tag",
      "default": "h2",
      "options": [
        {
          "value": "h1",
          "label": "t:sections.all.heading_tag.options.h1"
        },
        {
          "value": "h2",
          "label": "t:sections.all.heading_tag.options.h2"
