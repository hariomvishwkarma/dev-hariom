{% liquid
  assign title = section.settings.title
  assign number_of_products_per_page = section.settings.number_of_products_per_page
  assign number_of_columns_desktop = section.settings.number_of_columns_desktop
  assign number_of_columns_mobile = section.settings.number_of_columns_mobile

  case number_of_columns_desktop
    when 1
      assign number_of_columns_desktop_classes = 'md:grid-cols-1'
    when 2
      assign number_of_columns_desktop_classes = 'md:grid-cols-2'
    when 3
      assign number_of_columns_desktop_classes = 'md:grid-cols-3'
    when 4
      assign number_of_columns_desktop_classes = 'md:grid-cols-4'
    when 5
      assign number_of_columns_desktop_classes = 'md:grid-cols-5'
    when 6
      assign number_of_columns_desktop_classes = 'md:grid-cols-6'
    when 7
      assign number_of_columns_desktop_classes = 'md:grid-cols-7'
    when 8
      assign number_of_columns_desktop_classes = 'md:grid-cols-8'
    when 9
      assign number_of_columns_desktop_classes = 'md:grid-cols-9'
    when 10
      assign number_of_columns_desktop_classes = 'md:grid-cols-10'
    when 11
      assign number_of_columns_desktop_classes = 'md:grid-cols-11'
    when 12
      assign number_of_columns_desktop_classes = 'md:grid-cols-12'
  endcase

  case number_of_columns_mobile
    when '1'
      assign number_of_columns_mobile_classes = 'grid-cols-1'
    when '2'
      assign number_of_columns_mobile_classes = 'grid-cols-2'
  endcase

  assign heading_tag = section.settings.heading_tag
  assign font_size = section.settings.font_size
  assign font_weight = section.settings.font_weight
  assign heading_type = font_size | append: ' ' | append: font_weight
  assign italic_header_text = section.settings.italic_header_text
  if italic_header_text
    assign heading_type = heading_type | append: ' !italic'
  endif
%}

<div class="container-fluid color-{{ section.settings.color_scheme }}">
  {% if title != blank %}
    {% render 'c-title', content: title, custom_tag: heading_tag, type: heading_type, classes: 'mb-6' %}
  {% endif %}

  {%- paginate collections by number_of_products_per_page -%}
    <div>
      {% if collections.size > 0 %}
        <div class="grid {{ number_of_columns_mobile_classes }} {{ number_of_columns_desktop_classes }} gap-6">
          {% for collection in collections %}
            {% render 'card-collection', card_collection: collection %}
          {% endfor %}
        </div>
      {% else %}
        <p>{{ 'sections.template-list-collections.empty' | t }}</p>
      {% endif %}

      {% render 'pagination', pagination: paginate %}
    </div>
  {% endpaginate %}
</div>

