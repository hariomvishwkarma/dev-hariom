{% liquid
  assign heading_tag = section.settings.heading_tag
  assign font_size = section.settings.font_size
  assign font_weight = section.settings.font_weight
  assign heading_type = font_size | append: ' ' | append: font_weight
  assign italic_header_text = section.settings.italic_header_text
  if italic_header_text
    assign heading_type = heading_type | append: ' !italic'
  endif
%}

{% style %}
  #shopify-section-{{ section.id }} {
    --custom-bg-color: {{ section.settings.custom_bg_color }};
    --custom-title-color: {{ section.settings.title_color }};
    --custom-text-color: {{ section.settings.text_color }};
    --custom-button-bg: {{ section.settings.button_bg }};
    --custom-button-color: {{ section.settings.button_color }};
  }
  #shopify-section-{{ section.id }} .button--secondary {
    background: var(--custom-button-bg);
    color: var(--custom-button-color);
  }
{% endstyle %}

<div class="bg-[var(--custom-bg-color)]">
  <div class="flex md:flex-row items-start w-full flex-col lg:gap-[4px]">
    <div class="md:w-1/2 relative w-full">
      <div class="absolute w-full z-0 h-[75vh]">
        {% render 'c-image',
          image: section.settings.image,
          classes: 'h-full w-full object-cover object-center absolute relative before:absolute before:left-0 before:right-0 before:top-0 before:z-10 before:h-full before:w-full before:bg-neutral-500 before:opacity-30'
        %}
      </div>
      <div class="relative p-4 lg:p-10 z-1 h-[75vh] mb-1">
        <div class="flex flex-col justify-end h-full text-background lg:max-w-[70%]">
          {% if section.settings.title_text != blank %}
            {% render 'c-title',
              content: section.settings.title_text,
              custom_tag: heading_tag,
              type: heading_type,
              classes: 'mb-4 text-[var(--custom-title-color)]'
            %}
          {% endif %}
          {% if section.settings.description != blank %}
            {% render 'c-richtext',
              content: section.settings.description,
              classes: 'max-w-[530px] text-lg lg:text-xl text-[var(--custom-text-color)]'
            %}
          {% endif %}
          <a
            href="{{ section.settings.button_url }}"
            class="button--secondary rounded-full py-2 px-5 mt-10 lg:mt-5 w-fit"
          >
            {{- section.settings.button_text -}}
          </a>
        </div>
      </div>
    </div>

    <div class="md:w-1/2 relative w-full">
      <div class="absolute w-full z-0 h-[75vh]">
        {% render 'c-image',
          image: section.settings.image_2,
          classes: 'h-full w-full object-cover object-center absolute relative before:absolute before:left-0 before:right-0 before:top-0 before:z-10 before:h-full before:w-full before:bg-neutral-500 before:opacity-30'
        %}
      </div>
      <div class="relative p-4 lg:p-10 z-1 h-[75vh] mb-1">
        <div class="flex flex-col justify-end h-full text-background lg:max-w-[70%]">
          {% if section.settings.title_text != blank %}
            {% render 'c-title',
              content: section.settings.title_text_2,
              custom_tag: heading_tag,
              type: heading_type,
              classes: 'mb-4 text-[var(--custom-title-color)]'
            %}
          {% endif %}
          {% if section.settings.description_2 != blank %}
            {% render 'c-richtext',
              content: section.settings.description_2,
              classes: 'max-w-[530px] text-lg lg:text-xl text-[var(--custom-text-color)]'
            %}
          {% endif %}
          <a
            href="{{ section.settings.button_url_2 }}"
            class="button--secondary rounded-full py-2 px-5 mt-10 lg:mt-5 w-fit"
          >
            {{- section.settings.button_text_2 -}}
          </a>
        </div>
      </div>
    </div>
  </div>
</div>
{% render 'divider',
  height: section.settings.margin_bottom,
  custom: section.settings.margin_bottom_custom,
  color_scheme: section.settings.color_scheme
%}

