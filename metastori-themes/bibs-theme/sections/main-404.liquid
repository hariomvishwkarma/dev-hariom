{% liquid
  assign secondary_shop_url = section.settings.button_secondary_url | default: shop.secure_url
  assign shop_url = section.settings.button_url | default: shop.secure_url

  assign subtext_title = section.settings.subtext_title
  assign heading_tag = section.settings.heading_tag
  assign font_size = section.settings.font_size
  assign font_weight = section.settings.font_weight
  assign heading_type = font_size | append: ' ' | append: font_weight
  assign italic_header_text = section.settings.italic_header_text
  if italic_header_text
    assign heading_type = heading_type | append: ' !italic'
  endif
%}

<div id="404-page" class="container-fluid color-{{ section.settings.color_scheme }}">
  <div class="py-16">
    <div class="template-404" id="template-404">
      <p class="mb-3 md:mb-4 text-base md:text-xl font-bold">{{ section.settings.title }}</p>

      {% render 'c-title', content: subtext_title, custom_tag: heading_tag, type: heading_type, classes: 'mb-6' %}

      <div class="mb-10">
        <p class="mb-4">{{ 'general.404.reasons_title' | t }}</p>
        {% for item in (1..2) %}
          <p class="flex items-center">
            {%- render 'c-icon',
              icon: 'dot',
              classes: 'w-1 h-1 md:w-1.5 md:h-1.5 inline align-baseline text-accent ml-1 mr-4'
            -%}
            {{ 'general.404.reason_' | append: item | t }}
          </p>
        {% endfor %}
      </div>

      <div class="flex md:flex-row flex-col gap-3 md:gap-4">
        <div>
          <a href="{{ shop_url }}">
            {% render 'c-button',
              type: 'submit',
              content: section.settings.button_label,
              design: 'primary',
              classes: 'rounded-full md:w-auto w-full'
            %}
          </a>
        </div>

        <div>
          <a href="{{ secondary_shop_url }}">
            {% render 'c-button',
              type: 'submit',
              content: section.settings.button_secondary_label,
              design: 'grey',
              classes: 'rounded-full md:w-auto w-full shadow-none'
            %}
          </a>
        </div>
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Template 404",
  "tag": "section",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "background-1"
    },
    {
      "type": "text",
      "id": "title",
      "default": "Error 404",
      "label": "404 Heading Title"
    },
    {
      "type": "text",
      "id": "subtext_title",
      "default": "The page that you're looking for is not found",
      "label": "404 Subtext Title"
    },
    {
      "type": "select",
      "label": "t:sections.all.heading_tag.label",
      "id": "heading_tag",
      "default": "h2",
      "options": [
        {
          "value": "h1",
          "label": "t:sections.all.heading_tag.options.h1"
        },
        {
          "value": "h2",
          "label": "t:sections.all.heading_tag.options.h2"
        },
        {
          "value": "h3",
          "label": "t:sections.all.heading_tag.options.h3"
        },
        {
          "value": "h4",
          "label": "t:sections.all.heading_tag.options.h4"
        },
        {
          "value": "h5",
          "label": "t:sections.all.heading_tag.options.h5"
        },
        {
          "value": "h6",
          "label": "t:sections.all.heading_tag.options.h6"
        }
      ]
    },
    {
      "type": "select",
      "label": "t:sections.all.font_size.label",
      "id": "font_size",
      "default": "",
      "options": [
        {
          "value": "",
          "label": "t:sections.all.font_size.options.default"
        },
        {
          "value": "paragraph-1",
          "label": "t:sections.all.font_size.options.paragraph"
        },
        {
          "value": "h1",
          "label": "t:sections.all.font_size.options.h1"
        },
        {
          "value": "h2",
          "label": "t:sections.all.font_size.options.h2"
        },
        {
          "value": "h3",
          "label": "t:sections.all.font_size.options.h3"
        },
        {
          "value": "h4",
          "label": "t:sections.all.font_size.options.h4"
        },
        {
          "value": "h5",
          "label": "t:sections.all.font_size.options.h5"
        },
        {
          "value": "h6",
          "label": "t:sections.all.font_size.options.h6"
        }
      ]
    },
    {
      "type": "select",
      "label": "t:sections.all.font_weight.label",
      "id": "font_weight",
      "default": "!font-bold",
      "options": [
        {
          "value": "",
          "label": "t:sections.all.font_weight.options.default"
        },
        {
          "value": "!font-thin",
          "label": "t:sections.all.font_weight.options.thin"
        },
        {
          "value": "!font-light",
          "label": "t:sections.all.font_weight.options.light"
        },
        {
          "value": "!font-normal",
          "label": "t:sections.all.font_weight.options.normal"
        },
        {
          "value": "!font-medium",
          "label": "t:sections.all.font_weight.options.medium"
        },
        {
          "value": "!font-semibold",
          "label": "t:sections.all.font_weight.options.semibold"
        },
        {
          "value": "!font-bold",
          "label": "t:sections.all.font_weight.options.bold"
        }
      ]
    },
    {
      "type": "checkbox",
      "id": "italic_header_text",
      "label": "t:sections.all.italic_header_text.label",
      "default": false
    },
    {
      "type": "text",
      "id": "button_label",
      "default": "Back to home",
      "label": "Button Label"
    },
    {
      "type": "url",
      "id": "button_url",
      "label": "Button URL"
    },
    {
      "type": "text",
      "id": "button_secondary_label",
      "default": "Get help",
      "label": "Secondary Button Label"
    },
    {
      "type": "url",
      "id": "button_secondary_url",
      "label": "Secondary Button URL"
    }
  ]
}
{% endschema %}
