{% liquid
  assign section_header = section.settings.header
  assign heading_tag = section.settings.heading_tag
  assign font_size = section.settings.font_size
  assign font_weight = section.settings.font_weight
  assign heading_type = font_size | append: ' ' | append: font_weight
  assign italic_header_text = section.settings.italic_header_text
  if italic_header_text
    assign heading_type = heading_type | append: ' !italic'
  endif
%}

{% style %}
  #shopify-section-{{ section.id }} {
    --custom-bg-color: {{ section.settings.custom_bg_color }};
    --custom-title-color: {{ section.settings.title_color }};
    --custom-number-color: {{ section.settings.number_color }};
    --custom-header-color: {{ section.settings.header_color }};
    --custom-text-color: {{ section.settings.text_color }};
  }
  #shopify-section-{{ section.id }} .image-section-block-heading {
    color: var(--custom-header-color);
  }
  #shopify-section-{{ section.id }} .image-section-block-text {
    color: var(--custom-text-color);
  }
{% endstyle %}

<div class="bg-[var(--custom-bg-color)] flex md:flex-row items-start w-full flex-col py-8 md:py-12 gap-0 md:gap-[60px]">
  <div class="w-full md:w-1/2">
    {% render 'c-image', image: section.settings.image, classes: 'h-full' %}
  </div>
  <div class="w-full md:w-1/2 self-center">
    <div class="container-fluid max-w-full py-4">
      {%- if section_header != blank -%}
        <div class="flex flex-col pb-8 md:pb-12 text-[var(--custom-title-color)]">
          {% render 'c-title', content: section_header, custom_tag: heading_tag, type: heading_type %}
        </div>
      {%- endif -%}

      <div class="flex flex-col gap-10">
        {% for block in section.blocks %}
          {% if block.settings.bullet_points_number != blank
            or block.settings.bullet_points_title != blank
            or block.settings.bullet_points_text != blank
            or block.settings.bullet_points_bg != blank
          %}
            {% assign bullet_points_bg = block.settings.bullet_points_bg %}
            {% assign bullet_points_text_color = block.settings.bullet_points_text_color %}
            {% style %}
              .bullet-points-bg {
                background: {{ bullet_points_bg }};
                color: {{ bullet_points_text_color }};
              }
              {% break %}
            {% endstyle %}
            <div>
              {% if block.settings.bullet_points_number != blank %}
                <p class="w-fit rounded-full py-1 px-3.5 aspect-square flex items-center text-[var(--custom-number-color)] bullet-points-bg">
                  {{ block.settings.bullet_points_number }}
                </p>
              {% endif %}
              {% if block.settings.bullet_points_title != blank %}
                <h5 class="text-2xl font-medium my-4  text-[var(--custom-header-color)]">
                  {{ block.settings.bullet_points_title }}
                </h5>
              {% endif %}
              {% if block.settings.bullet_points_text != blank %}
                {% render 'c-richtext',
                  content: block.settings.bullet_points_text,
                  classes: 'max-w-[530px] text-lg md:text-xl text-[var(--custom-text-color)]'
                %}
              {% endif %}
            </div>
          {% endif %}
        {% endfor %}
      </div>
    </div>
  </div>
</div>
{% render 'divider',
  height: section.settings.margin_bottom,
  custom: section.settings.margin_bottom_custom,
  color_scheme: section.settings.color_scheme
%}

{% schema %}
{
  "name": "t:sections.image-with-bullet-points.name",
  "class": "section-image-with-bullet-points",
  "settings": [
    {
      "type": "color",
      "id": "custom_bg_color",
      "label": "Background color"
    },
    {
      "type": "color",
      "id": "title_color",
      "label": "Title color",
      "default": "#5A5357"
    },
    {
      "type": "color",
      "id": "number_color",
      "label": "Bullet Number color",
      "default": "#5A5357"
    },
    {
      "type": "color",
      "id": "header_color",
      "label": "Bullet Header color",
      "default": "#5A5357"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Bullet Text color",
      "default": "#5A5357"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "t:sections.image-with-bullet-points.settings.label"
    },
    {
      "type": "text",
      "id": "header",
      "label": "t:sections.image-with-bullet-points.settings.header.label"
    },
    {
      "type": "select",
      "label": "t:sections.all.heading_tag.label",
      "id": "heading_tag",
      "default": "h2",
      "options": [
        {
          "value": "h1",
          "label": "t:sections.all.heading_tag.options.h1"
        },
        {
          "value": "h2",
          "label": "t:sections.all.heading_tag.options.h2"
        },
        {
          "value": "h3",
          "label": "t:sections.all.heading_tag.options.h3"
        },
        {
          "value": "h4",
          "label": "t:sections.all.heading_tag.options.h4"
        },
        {
          "value": "h5",
          "label": "t:sections.all.heading_tag.options.h5"
        },
        {
          "value": "h6",
          "label": "t:sections.all.heading_tag.options.h6"
        }
      ]
    },
    {
      "type": "select",
      "label": "t:sections.all.font_size.label",
      "id": "font_size",
      "default": "",
      "options": [
        {
          "value": "",
          "label": "t:sections.all.font_size.options.default"
        },
        {
          "value": "paragraph-1",
          "label": "t:sections.all.font_size.options.paragraph"
        },
        {
          "value": "h1",
          "label": "t:sections.all.font_size.options.h1"
        },
        {
          "value": "h2",
          "label": "t:sections.all.font_size.options.h2"
        },
        {
          "value": "h3",
          "label": "t:sections.all.font_size.options.h3"
        },
        {
          "value": "h4",
          "label": "t:sections.all.font_size.options.h4"
        },
        {
          "value": "h5",
          "label": "t:sections.all.font_size.options.h5"
        },
        {
          "value": "h6",
          "label": "t:sections.all.font_size.options.h6"
        }
      ]
    },
    {
      "type": "select",
      "label": "t:sections.all.font_weight.label",
      "id": "font_weight",
      "default": "",
      "options": [
        {
          "value": "",
          "label": "t:sections.all.font_weight.options.default"
        },
        {
          "value": "!font-thin",
          "label": "t:sections.all.font_weight.options.thin"
        },
        {
          "value": "!font-light",
          "label": "t:sections.all.font_weight.options.light"
        },
        {
          "value": "!font-normal",
          "label": "t:sections.all.font_weight.options.normal"
        },
        {
          "value": "!font-medium",
          "label": "t:sections.all.font_weight.options.medium"
        },
        {
          "value": "!font-semibold",
          "label": "t:sections.all.font_weight.options.semibold"
        },
        {
          "value": "!font-bold",
          "label": "t:sections.all.font_weight.options.bold"
        }
      ]
    },
    {
      "type": "checkbox",
      "id": "italic_header_text",
      "label": "t:sections.all.italic_header_text.label",
      "default": false
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "background-1"
    },
    {
      "type": "header",
      "content": "t:sections.all.margin.heading"
    },
    {
      "type": "select",
      "id": "margin_bottom",
