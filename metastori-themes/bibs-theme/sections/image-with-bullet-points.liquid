          "label": "t:sections.all.margin.margin_bottom.normal",
          "value": "normal"
        },
        {
          "label": "t:sections.all.margin.margin_bottom.large",
          "value": "large"
        },
        {
          "label": "t:sections.all.margin.margin_bottom.custom.label",
          "value": "custom"
        }
      ],
      "default": "none"
    },
    {
      "type": "range",
      "min": 0,
      "max": 100,
      "default": 16,
      "step": 1,
      "label": "t:sections.all.margin.margin_bottom.custom.value",
      "visible_if": "{{ section.settings.margin_bottom == 'custom' }}",
      "unit": "px",
      "id": "margin_bottom_custom"
    }
  ],
  "presets": [
    {
      "name": "t:sections.image-with-bullet-points.name"
    }
  ],
  "blocks": [
    {
      "type": "text",
      "name": "t:sections.image-with-bullet-points.blocks.bullet_item.name",
      "settings": [
        {
          "type": "text",
          "id": "bullet_points_number",
          "label": "t:sections.image-with-bullet-points.blocks.bullet_item.settings.number.label"
        },
        {
          "type": "color",
          "id": "bullet_points_bg",
          "label": "t:sections.image-with-bullet-points.blocks.bullet_item.settings.color.label",
          "default": "#857FBB"
