{% liquid
  assign selected_variant = product.selected_variant
  assign variant_image = selected_variant.featured_image | default: product.featured_image
  assign selected_selling_plan_allocation = selected_variant.selected_selling_plan_allocation
%}
<div class="flex gap-5 [&:not(:last-child)]:border-b border-borders">
  <a class="bg-secondary-background w-[100px] h-[100px]" href="#">
    {% render 'c-image', image: variant_image, classes: 'w-[100] h-[100]', image_width: 200, aspect_ratio: 'square' %}
  </a>
  <div class="flex flex-col gap-2 justify-between w-full">
    <div class="flex flex-wrap gap-2 justify-between w-full">
      <div class="flex flex-col">
        <a href="#" class="link--hover paragraph-2 !font-medium">
          {{- selected_variant.product.title | escape -}}
        </a>
        {%- unless product.has_only_default_variant -%}
          <div class="mt-1 flex gap-2">
            {%- for option in selected_variant.options -%}
              <span class="text-xs flex flex-row gap-2">
                <span class="">{{ option }}</span>
                {% unless forloop.index == forloop.length %}
                  <div>|</div>
                {% endunless %}
              </span>
            {%- endfor -%}
          </div>
        {%- endunless -%}
      </div>
      <div
        class="h8-bold flex flex-col justify-start text-right subscription-selection--product-price"
        data-price="{{ selected_selling_plan_allocation.price }}"
        data-compare-at-price="{{ selected_selling_plan_allocation.compare_at_price }}"
      >
        {%- if selected_selling_plan_allocation.compare_at_price != selected_selling_plan_allocation.price -%}
          <div class="cart-item__discounted-prices">
            <span class="price-item whitespace-nowrap text-accent">
              {{- selected_selling_plan_allocation.price | money -}}
            </span>
            <del aria-hidden="true">
              <span class="price-item">
                {{- selected_selling_plan_allocation.compare_at_price | money -}}
              </span>
            </del>
          </div>
        {%- else -%}
          <span class="price-item">
            {{- selected_selling_plan_allocation.price | money -}}
          </span>
        {%- endif -%}
      </div>
    </div>
    <div class="flex flex-row gap-2 justify-between items-center md:items-end">
      <div class="flex flex-col flex-1">
        <div class="flex items-center gap-2 text-xs">
          {%- render 'cart-quantity-selector', item: selected_variant -%}
        </div>
      </div>
      <div class="ml-auto flex flex-row items-center md:items-end md:flex-col justify-end gap-2 paragraph-3">
        {%- render 'button-wishlist',
          product: selected_variant.product,
          icon_classes: 'icon-heart !text-borders w-[22px] md:w-4 h-[22px] md:h-4',
          add_text: true
        -%}
        <div class="md:hidden bg-borders h-4 w-px"></div>
        <button
          class="subscription-selection--product-remove flex flex-row gap-1.5 justify-end"
          data-line-item-id="{{ selected_variant.id }}"
          data-quantity="0"
          data-tracking-remove-item
          data-tooltip="{{ 'customer.tool_tip.trash' | t }}"
        >
          {%- render 'c-icon', icon: 'trash', classes: 'text-borders w-[25px] md:w-5 h-[25px] md:h-5' -%}
          <span class="md:block hidden">{{ 'sections.cart.product_card.remove' | t }}</span>
        </button>
      </div>
    </div>
  </div>
  <input type="hidden" name="product-id" value="{{ product.id }}">
  <input type="hidden" name="id[]" required="" value="{{ selected_variant.id }}">
</div>

{% schema %}
{
  "name": "t:sections.subscription-drawer-item.name",
  "tag": "section",
  "class": "section-subscription-drawer-item",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "background-1"
    }
  ]
}
{% endschema %}
