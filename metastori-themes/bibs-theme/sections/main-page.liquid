{% liquid
  assign title = ''
  if current_tags.size > 0
    assign current_tag = current_tags[0]
    assign title = title | append: ' - ' | append: current_tags[0]
  endif

  assign heading_tag = section.settings.heading_tag
  assign font_size = section.settings.font_size
  assign font_weight = section.settings.font_weight
  assign heading_type = font_size | append: ' ' | append: font_weight
  assign italic_header_text = section.settings.italic_header_text
  if italic_header_text
    assign heading_type = heading_type | append: ' !italic'
  endif
%}

<div class="color-{{ section.settings.color_scheme }}">
  <div class="">
    {% if page.metafields.custom.header_image != blank %}
      {% assign use_image = true %}
    {% endif %}
    {% if page.metafields.custom.button_link != blank and page.metafields.custom.button_text != blank %}
      {% assign use_button = true %}
    {% endif %}
    <div class="flex items-center justify-center relative text-center {% if use_image %}{% if use_button %} md:h-[597px] h-[513px]{% else %} md:h-[384px] h-[322px]{% endif %}{% endif %}">
      {% capture classes %}
        z-1 {% if use_image %}text-background{% endif %}
      {% endcapture %}
      <div class="flex flex-col items-center">
        {% render 'c-title', content: page.title, custom_tag: heading_tag, type: heading_type, classes: classes %}

        {% if page.metafields.custom.subheader %}
          {% render 'c-text',
            content: page.metafields.custom.subheader,
            classes: 'paragraph-1 z-1 text-white text-center mt-2.5'
          %}
        {% endif %}
        {% if use_button %}
          {% render 'c-link',
            href: page.metafields.custom.button_link,
            content: page.metafields.custom.button_text,
            classes: 'button--primary rounded-full shadow-none w-fit h-fit mt-[30px] z-1'
          %}
        {% endif %}
      </div>
      {% capture image_classes %} absolute w-full {% if use_image %}{% if use_button %} md:h-[597px] h-[513px]{% else %} md:h-[384px] h-[322px]{% endif %}{% endif %}{% endcapture %}
      {% if use_image %}
        {% render 'c-image', image: page.metafields.custom.header_image, classes: image_classes %}
      {% endif %}
    </div>

    {% if current_tag %}
      <div class="flex mt-6 overflow-x-auto no-scrollbar">
        <a
          href="{{ item.url }}"
        >
          {% liquid
            if current_tags.size > 0
              assign classes = 'no-underline border-2 px-5 py-2 mr-2  rounded-full text-sm bg-background text-foreground w-max'
            else
              assign classes = 'no-underline border-2 px-5 py-2 mr-2  rounded-full text-sm bg-foreground text-background w-max'
            endif
          %}
        </a>
        {% for item in page.metafields.custom.navigation.value %}
          {% liquid
            if current_tag == item.title
              assign classes = 'no-underline border-2 px-5 py-2 mr-2  rounded-full text-sm bg-foreground text-background w-max'
            else
              assign classes = 'no-underline border-2 px-5 py-2 mr-2  rounded-full text-sm bg-background text-foreground w-max'
            endif
          %}
          <a href="{{ item.url }}">
            {% render 'c-button', type: 'submit', content: item.title, design: 'white', classes: classes %}
          </a>
        {% endfor %}
      </div>
    {% endif %}
    {% unless page.content == blank or section.settings.remove_page_description %}
      <div class="blog-page-max-width container-fluid page__content py-6 md:pt-[60px] md:pb-20 mx-auto">
        {{ page.content }}
      </div>
    {% endunless %}
  </div>
</div>

{% schema %}
{
  "name": "Page",
  "tag": "section",
  "class": "main-page-section spaced-section",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "background-1"
    },
    {
      "type": "checkbox",
      "id": "remove_page_description",
      "label": "Remove page description",
      "default": true
    },
    {
      "type": "select",
      "label": "t:sections.all.heading_tag.label",
      "id": "heading_tag",
      "default": "h1",
      "options": [
        {
          "value": "h1",
          "label": "t:sections.all.heading_tag.options.h1"
        },
        {
          "value": "h2",
          "label": "t:sections.all.heading_tag.options.h2"
        },
        {
          "value": "h3",
          "label": "t:sections.all.heading_tag.options.h3"
        },
        {
          "value": "h4",
          "label": "t:sections.all.heading_tag.options.h4"
        },
        {
          "value": "h5",
          "label": "t:sections.all.heading_tag.options.h5"
        },
        {
          "value": "h6",
          "label": "t:sections.all.heading_tag.options.h6"
        }
      ]
    },
    {
      "type": "select",
      "label": "t:sections.all.font_size.label",
      "id": "font_size",
      "default": "",
      "options": [
        {
          "value": "",
          "label": "t:sections.all.font_size.options.default"
        },
        {
          "value": "paragraph-1",
          "label": "t:sections.all.font_size.options.paragraph"
        },
        {
          "value": "h1",
          "label": "t:sections.all.font_size.options.h1"
        },
        {
          "value": "h2",
          "label": "t:sections.all.font_size.options.h2"
        },
        {
          "value": "h3",
          "label": "t:sections.all.font_size.options.h3"
        },
        {
          "value": "h4",
          "label": "t:sections.all.font_size.options.h4"
        },
        {
          "value": "h5",
          "label": "t:sections.all.font_size.options.h5"
        },
        {
          "value": "h6",
          "label": "t:sections.all.font_size.options.h6"
        }
      ]
    },
    {
      "type": "select",
      "label": "t:sections.all.font_weight.label",
      "id": "font_weight",
      "default": "",
      "options": [
        {
          "value": "",
          "label": "t:sections.all.font_weight.options.default"
        },
        {
          "value": "!font-thin",
          "label": "t:sections.all.font_weight.options.thin"
        },
        {
          "value": "!font-light",
          "label": "t:sections.all.font_weight.options.light"
        },
        {
          "value": "!font-normal",
          "label": "t:sections.all.font_weight.options.normal"
        },
        {
          "value": "!font-medium",
          "label": "t:sections.all.font_weight.options.medium"
        },
        {
          "value": "!font-semibold",
          "label": "t:sections.all.font_weight.options.semibold"
        },
        {
          "value": "!font-bold",
          "label": "t:sections.all.font_weight.options.bold"
        }
      ]
    },
    {
      "type": "checkbox",
      "id": "italic_header_text",
      "label": "t:sections.all.italic_header_text.label",
      "default": false
    }
  ]
}
{% endschema %}
