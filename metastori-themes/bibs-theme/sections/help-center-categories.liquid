{%- style -%}
  .category-card {
    background-color: {{ section.settings.card_bg_color }};
    border-radius: {{ section.settings.card_corner_radius }}px;
    text-align: {{ section.settings.content_alignment }};
  }

  {% if section.settings.enable_hover_shadow %}
  .category-card:hover {
    box-shadow: 0px 8px 24px rgba(0, 0, 0, 0.12);
    transform: translateY(-2px);
  }
  {% else %}
  .category-card {
    box-shadow: 0px 4px 11px -2px rgba(0, 0, 0, 0.1);
  }
  {% endif %}

  .category-icon-wrapper {
    justify-content: {% if section.settings.content_alignment == 'center' %}center{% elsif section.settings.content_alignment == 'right' %}flex-end{% else %}flex-start{% endif %};
  }

  /* Mobile (below 990px) */
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top_mobile }}px;
    padding-bottom: {{ section.settings.padding_bottom_mobile }}px;
  }

  /* Desktop (990px and above) */
  @media screen and (min-width: 990px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top_desktop }}px;
      padding-bottom: {{ section.settings.padding_bottom_desktop }}px;
    }
  }
{%- endstyle -%}

<div class="help-center-categories section-{{ section.id }}-padding">
  <div class="categories-grid">
    {%- for block in section.blocks -%}
      {%- if block.settings.card_link != blank -%}
        <a
          href="{{ block.settings.card_link }}"
          class="category-card color-{{ section.settings.color_scheme }}"
          {{ block.shopify_attributes }}
        >
      {%- else -%}
        <div class="category-card color-{{ section.settings.color_scheme }}" {{ block.shopify_attributes }}>
      {%- endif -%}

      {%- if block.settings.icon_image != blank -%}
        <div class="category-icon-wrapper">
          {%- assign icon_style = 'width: ' | append: block.settings.icon_size | append: 'px; height: auto;' -%}
          {{
            block.settings.icon_image
            | image_url: width: 200
            | image_tag: class: 'category-icon', loading: 'lazy', style: icon_style
          }}
        </div>
      {%- endif -%}

      {%- if block.settings.title != blank -%}
        <h3 class="category-title">{{ block.settings.title }}</h3>
      {%- endif -%}

      {%- if block.settings.description != blank -%}
        <div class="category-text">{{ block.settings.description }}</div>
      {%- endif -%}

      {%- if block.settings.card_link != blank -%}
        </a>
      {%- else -%}
        </div>
      {%- endif -%}
    {%- endfor -%}
  </div>
</div>

{% schema %}
{
  "name": "t:sections.help-center-categories.name",
  "tag": "section",
  "class": "category_main",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:settings_schema.colors.color_scheme"
    },
    {
      "type": "select",
      "id": "content_alignment",
      "label": "t:sections.help-center-categories.settings.content_alignment.label",
      "options": [
        { "value": "left", "label": "t:sections.help-center-categories.settings.content_alignment.options.left" },
        { "value": "center", "label": "t:sections.help-center-categories.settings.content_alignment.options.center" },
        { "value": "right", "label": "t:sections.help-center-categories.settings.content_alignment.options.right" }
      ],
      "default": "center"
    },
    {
      "type": "range",
      "id": "card_corner_radius",
      "min": 0,
      "max": 40,
      "step": 1,
      "unit": "px",
      "label": "t:sections.help-center-categories.settings.card_corner_radius",
      "default": 4
    },
    {
      "type": "checkbox",
      "id": "enable_hover_shadow",
      "label": "t:sections.help-center-categories.settings.enable_hover_shadow",
      "default": true
    },
    {
      "type": "header",
      "content": "t:sections.help-center-categories.settings.mobile_padding"
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "label": "t:sections.help-center-categories.settings.padding_top",
      "default": 20,
      "min": 0,
      "max": 100,
      "step": 2
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "label": "t:sections.help-center-categories.settings.padding_bottom",
      "default": 20,
      "min": 0,
      "max": 100,
      "step": 2
    },
    {
      "type": "header",
      "content": "t:sections.help-center-categories.settings.desktop_padding"
    },
    {
      "type": "range",
      "id": "padding_top_desktop",
      "label": "t:sections.help-center-categories.settings.padding_top",
      "default": 40,
      "min": 0,
      "max": 200,
      "step": 2
    },
    {
      "type": "range",
      "id": "padding_bottom_desktop",
      "label": "t:sections.help-center-categories.settings.padding_bottom",
      "default": 40,
      "min": 0,
      "max": 200,
      "step": 2
    }
  ],
  "blocks": [
    {
      "type": "category_card",
      "name": "t:sections.help-center-categories.blocks.category_card.name",
      "limit": 9,
      "settings": [
        {
          "type": "image_picker",
          "id": "icon_image",
          "label": "t:sections.help-center-categories.blocks.category_card.settings.icon_image"
        },
        {
          "type": "range",
          "id": "icon_size",
          "min": 20,
          "max": 100,
          "step": 2,
          "unit": "px",
          "label": "t:sections.help-center-categories.blocks.category_card.settings.icon_size",
          "default": 56
        },
        {
          "type": "inline_richtext",
          "id": "title",
          "label": "t:sections.help-center-categories.blocks.category_card.settings.title",
          "default": "Category Title"
        },
        {
          "type": "richtext",
          "id": "description",
          "label": "t:sections.help-center-categories.blocks.category_card.settings.description",
          "default": "<p>Description text for the category goes here.</p>"
        },
        {
          "type": "url",
          "id": "card_link",
          "label": "t:sections.help-center-categories.blocks.category_card.settings.card_link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:sections.help-center-categories.name",
      "blocks": [
        { "type": "category_card" },
        { "type": "category_card" },
        { "type": "category_card" },
        { "type": "category_card" },
        { "type": "category_card" },
        { "type": "category_card" }
      ]
    }
  ]
}
{% endschema %}
