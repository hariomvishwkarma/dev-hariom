{% liquid
  assign img_btn_text_1 = section.settings.img_btn_text_1
  assign img_btn_url_1 = section.settings.img_btn_url_1
  assign img_btn_text_2 = section.settings.img_btn_text_2
  assign img_btn_url_2 = section.settings.img_btn_url_2

  if img_btn_text_1 != blank and img_btn_url_1 != blank
    assign has_btn_1 = true
  endif
  if img_btn_text_2 != blank and img_btn_url_2 != blank
    assign has_btn_2 = true
  endif

  assign heading_title = section.settings.title
  assign heading_tag = section.settings.heading_tag
  assign font_size = section.settings.font_size
  assign font_weight = section.settings.font_weight
  assign heading_type = font_size | append: ' ' | append: font_weight
  assign italic_header_text = section.settings.italic_header_text
  if italic_header_text
    assign heading_type = heading_type | append: ' !italic'
  endif
%}

<div class="color-{{ section.settings.color_scheme }} mb-[2px]">
  {% if heading_title != blank %}
    <div class="container-fluid pb-5">
      {% render 'c-title', custom_tag: heading_tag, type: heading_type, content: heading_title %}
    </div>
  {% endif %}
  <div class="grid grid-cols-2 md:grid-cols-3 gap-0.5">
    {% for i in (1..3) %}
      {% liquid
        assign index = forloop.index
        assign img_index = 'image_' | append: index
        assign img_btn_text = 'img_btn_text_' | append: index
        assign img_btn_url = 'img_btn_url_' | append: index
        assign image_classes = 'aspect-square'

        if has_btn_1 or has_btn_2
          assign image_classes = 'aspect-portrait md:aspect-square'
        endif

        if forloop.index == 3
          assign image_classes = 'aspect-[2/1] md:aspect-square'
        endif
      %}
      <div class="relative {% if forloop.index == 3 %} col-span-2 md:col-span-1{% else %} col-span-1{% endif %}">
        {% render 'c-image', image: section.settings[img_index], image_classes: image_classes %}
        {% if section.settings[img_btn_text] != blank and section.settings[img_btn_url] != blank %}
          <div class="absolute bottom-6 md:bottom-14 left-2/4 -translate-x-2/4 flex flex-col gap-4 md:gap-5 text-center w-max max-w-full px-2">
            {% render 'c-link',
              content: section.settings[img_btn_text],
              classes: 'button--primary button--small rounded-full',
              href: section.settings[img_btn_url]
            %}
          </div>
        {% endif %}
      </div>
    {% endfor %}
  </div>
  {% render 'divider',
    height: section.settings.margin_bottom,
    custom: section.settings.margin_bottom_custom,
    color_scheme: section.settings.color_scheme
  %}
</div>

