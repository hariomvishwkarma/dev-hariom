{%- if collection.metafields.custom.collection_banner_enable -%}
  {%- liquid
    assign collection_description = collection.metafields.custom.collection_description

    assign color_scheme = section.settings.color_scheme
    assign banner_image = collection.image
    assign banner_logo = collection.metafields.custom.custom_logo

    assign heading_tag = section.settings.heading_tag
    assign font_size = section.settings.font_size
    assign font_weight = section.settings.font_weight
    assign heading_type = font_size | append: ' ' | append: font_weight
    assign italic_header_text = section.settings.italic_header_text
    if italic_header_text
      assign heading_type = heading_type | append: ' !italic'
    endif
  -%}

  {%- if collection_description -%}
    <div class="container-fluid ">
      <div class="flex flex-col-reverse md:flex-row color-{{ color_scheme }}">
        <div class="flex-[2] flex md:items-center flex-col md:flex-row p-4 md:p-12 gap-4 md:gap-12">
          {% if banner_logo %}
            {% render 'c-image', image: banner_logo, classes: 'w-full max-w-[48] md:max-w-[127]' %}
          {% endif %}
          <div class="space-y-2 md:space-y-4">
            {% render 'c-text', content: collection.title, custom_tag: heading_tag, type: heading_type %}
            <p>
              {{ collection_description | metafield_tag }}
            </p>
          </div>
        </div>

        <div class="flex-1 relative md:p-12">
          {%- if banner_image -%}
            {% render 'c-image',
              image: banner_image,
              aspect_ratio: 'landscape',
              classes: 'md:absolute md:inset-0 w-full h-full'
            %}
          {%- endif -%}
        </div>
      </div>
    </div>
    {%- render 'divider', height: section.settings.margin_bottom, color_scheme: color_scheme -%}
  {%- endif -%}
{%- endif -%}

{% schema %}
{
  "name": "Collection Banner",
  "class": "section-collection-banner",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
