{%- capture swiper_options -%}
  {
    "slidesPerView": 1.2,
    "spaceBetween": 20,
    "loop": true,
    "breakpoints": {
      "768": {
        "slidesPerView": 2
      }
      {%- unless section.settings.image -%}
        ,
        "1024": {
          "slidesPerView": 3
        },
        "1280": {
          "slidesPerView": 4
        }
      {%- endunless -%}
    },
    "scrollbar": {
      "el": ".swiper-scrollbar",
      "draggable": true
    }
  }
{%- endcapture -%}
{%- capture swiper_attribute -%}
  data-swiper='{{- swiper_options -}}'
{%- endcapture -%}

{% liquid
  assign heading_title = section.settings.header
  assign heading_tag = section.settings.heading_tag
  assign font_size = section.settings.font_size
  assign font_weight = section.settings.font_weight
  assign heading_type = font_size | append: ' ' | append: font_weight
  assign padding_y = section.settings.padding_y
  case padding_y
    when 'none'
      assign padding_y_classes = 'py-0'
    when 'small'
      assign padding_y_classes = 'py-5 md:py-10'
    when 'large'
      assign padding_y_classes = 'py-12 md:py-20'
    else
      assign padding_y_classes = 'py-9 md:py-16'
  endcase
%}

<div class="color-{{ section.settings.color_scheme }}">
  {% if section.settings.lines %} {% render 'line', margin_bottom: 'none' %} {% endif %}

  <div class="{{ padding_y_classes }}">
    <div class="w-full container-fluid">
      <div
        class="flex gap-[30px] md:justify-between {% if section.settings.image_alignment == "right" %}flex-row-reverse{% else %}flex-row{% endif %}"
      >
        {% if section.settings.image %}
          <div class="hidden lg:block max-w-[40%]">
            {% render 'c-image', image: section.settings.image, classes: 'h-[412px]' %}
          </div>
        {% endif %}

        <div class="w-full space-y-[52px]{% if section.settings.image %} lg:max-w-[60%]{% endif %}">
          {%- if heading_title != blank -%}
            {% render 'c-title', custom_tag: heading_tag, type: heading_type, content: heading_title %}
          {%- endif -%}
          <div
            class="swiper swiper-card"
            {{ swiper_attribute }}
          >
            <div class="swiper-wrapper">
              {% for block in section.blocks %}
                <div class="swiper-slide">
                  {% render 'review', block: block %}
                </div>
              {% endfor %}
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  {% if section.settings.lines %} {% render 'line', margin_bottom: 'none' %} {% endif %}
  {% render 'divider',
    height: section.settings.margin_bottom,
    custom: section.settings.margin_bottom_custom,
    color_scheme: section.settings.color_scheme
  %}
</div>

{% schema %}
{
  "name": "t:sections.reviews.name",
  "class": "section-reviews",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "accent-1"
    },
    {
      "type": "text",
      "id": "header",
      "label": "t:sections.reviews.settings.header.label"
    },
    {
      "type": "select",
      "label": "t:sections.all.heading_tag.label",
      "id": "heading_tag",
      "default": "h3",
      "options": [
        {
          "value": "h1",
          "label": "t:sections.all.heading_tag.options.h1"
        },
        {
          "value": "h2",
          "label": "t:sections.all.heading_tag.options.h2"
        },
        {
          "value": "h3",
          "label": "t:sections.all.heading_tag.options.h3"
        },
        {
          "value": "h4",
          "label": "t:sections.all.heading_tag.options.h4"
        },
        {
          "value": "h5",
          "label": "t:sections.all.heading_tag.options.h5"
        },
        {
          "value": "h6",
          "label": "t:sections.all.heading_tag.options.h6"
        }
      ]
    },
    {
      "type": "select",
      "label": "t:sections.all.font_size.label",
      "id": "font_size",
      "default": "",
      "options": [
        {
          "value": "",
          "label": "t:sections.all.font_size.options.default"
        },
        {
          "value": "paragraph-1",
          "label": "t:sections.all.font_size.options.paragraph"
        },
        {
          "value": "h1",
          "label": "t:sections.all.font_size.options.h1"
        },
        {
          "value": "h2",
          "label": "t:sections.all.font_size.options.h2"
        },
        {
          "value": "h3",
          "label": "t:sections.all.font_size.options.h3"
        },
        {
          "value": "h4",
          "label": "t:sections.all.font_size.options.h4"
        },
        {
          "value": "h5",
          "label": "t:sections.all.font_size.options.h5"
        },
        {
          "value": "h6",
          "label": "t:sections.all.font_size.options.h6"
        }
      ]
    },
    {
      "type": "select",
      "label": "t:sections.all.font_weight.label",
      "id": "font_weight",
      "default": "",
      "options": [
        {
          "value": "",
          "label": "t:sections.all.font_weight.options.default"
        },
        {
          "value": "!font-thin",
          "label": "t:sections.all.font_weight.options.thin"
        },
        {
          "value": "!font-light",
          "label": "t:sections.all.font_weight.options.light"
        },
        {
          "value": "!font-normal",
          "label": "t:sections.all.font_weight.options.normal"
        },
        {
          "value": "!font-medium",
          "label": "t:sections.all.font_weight.options.medium"
        },
        {
          "value": "!font-semibold",
          "label": "t:sections.all.font_weight.options.semibold"
        },
        {
          "value": "!font-bold",
          "label": "t:sections.all.font_weight.options.bold"
        }
      ]
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "t:sections.reviews.settings.image.label"
    },
    {
      "type": "select",
      "id": "image_alignment",
      "label": "t:sections.reviews.settings.image_alignment.label",
      "options": [
        {
          "label": "t:sections.reviews.settings.image_alignment.options.left",
          "value": "left"
        },
        {
          "label": "t:sections.reviews.settings.image_alignment.options.right",
          "value": "right"
        }
      ]
    },
    {
      "type": "checkbox",
      "id": "lines",
      "label": "t:sections.reviews.settings.lines.label",
      "default": true
    },
    {
      "type": "header",
      "content": "t:sections.all.margin.heading"
    },
    {
      "type": "select",
      "id": "margin_bottom",
      "label": "t:sections.all.margin.margin_bottom.label",
      "options": [
        {
          "label": "t:sections.all.margin.margin_bottom.none",
          "value": "none"
        },
        {
          "label": "t:sections.all.margin.margin_bottom.small",
          "value": "small"
        },
        {
          "label": "t:sections.all.margin.margin_bottom.normal",
