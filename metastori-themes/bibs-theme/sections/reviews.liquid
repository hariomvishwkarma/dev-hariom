        {
          "label": "t:sections.all.margin.margin_bottom.custom.label",
          "value": "custom"
        }
      ],
      "default": "none"
    },
    {
      "type": "range",
      "min": 0,
      "max": 100,
      "default": 16,
      "step": 1,
      "label": "t:sections.all.margin.margin_bottom.custom.value",
      "visible_if": "{{ section.settings.margin_bottom == 'custom' }}",
      "unit": "px",
      "id": "margin_bottom_custom"
    },
    {
      "type": "select",
      "id": "padding_y",
      "label": "t:sections.all.padding_y.label",
      "options": [
        {
          "label": "t:sections.all.padding_y.none",
          "value": "none"
        },
        {
          "label": "t:sections.all.padding_y.small",
          "value": "small"
        },
        {
          "label": "t:sections.all.padding_y.normal",
          "value": "normal"
        },
        {
          "label": "t:sections.all.padding_y.large",
          "value": "large"
        }
      ],
      "default": "normal"
    }
  ],
  "blocks": [
    {
      "type": "review",
      "name": "t:sections.reviews.blocks.review.name",
      "settings": [
        {
          "type": "range",
          "id": "stars",
          "label": "t:sections.reviews.blocks.review.settings.stars.label",
          "step": 0.5,
          "min": 0,
          "max": 5,
          "default": 5
        },
        {
          "type": "text",
          "id": "heading",
          "label": "t:sections.reviews.blocks.review.settings.heading.label"
        },
        {
          "type": "text",
          "id": "text",
          "label": "t:sections.reviews.blocks.review.settings.text.label"
        },
        {
          "type": "text",
          "id": "name",
          "label": "t:sections.reviews.blocks.review.settings.name.label"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "t:sections.reviews.blocks.review.settings.image.label"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:sections.reviews.name"
    }
  ]
