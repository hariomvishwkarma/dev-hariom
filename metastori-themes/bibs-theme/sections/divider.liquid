{% style %}
  #Section-divider-{{  section.id }} {
    height: {{ section.settings.height }}px;
  }
{% endstyle %}

{%- assign color_scheme_class = 'color-' | append: section.settings.color_scheme -%}
<div id="Section-divider-{{ section.id }}" class="divider {{ color_scheme_class }}">&nbsp;</div>

{% schema %}
{
  "name": "t:sections.divider.name",
  "tag": "section",
  "class": "section-divider",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "background-1"
    },
    {
      "type": "range",
      "id": "height",
      "label": "t:sections.divider.settings.height.label",
      "default": 0,
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px"
    }
  ],
  "presets": [
    {
      "name": "Divider"
    }
  ]
}
{% endschema %}
