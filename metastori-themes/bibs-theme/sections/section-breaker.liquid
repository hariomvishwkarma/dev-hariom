{%- comment -%}
  Renders a main closing tag to act as a breaker.
  Note: this is a hacky solution to put sections boths underneath media gallery as well as sections that are full-width.
{%- endcomment -%}

{{ '</main>' }}

{% schema %}
{
  "name": "t:sections.section-breaker.name",
  "class": "hidden",
  "enabled_on": {
    "templates": ["product"]
  },
  "settings": [
    {
      "type": "checkbox",
      "id": "enable_section",
      "label": "t:sections.section-breaker.settings.enable_section.label",
      "info": "t:sections.section-breaker.settings.enable_section.info",
      "default": true
    }
  ],
  "presets": [
    {
      "name": "t:sections.section-breaker.presets.name"
    }
  ]
}
{% endschema %}
