    {
      "type": "select",
      "id": "margin_bottom",
      "label": "t:sections.all.margin.margin_bottom.label",
      "options": [
        { "label": "t:sections.all.margin.margin_bottom.none", "value": "none" },
        { "label": "t:sections.all.margin.margin_bottom.small", "value": "small" },
        { "label": "t:sections.all.margin.margin_bottom.normal", "value": "normal" },
        { "label": "t:sections.all.margin.margin_bottom.large", "value": "large" },
        { "label": "t:sections.all.margin.margin_bottom.custom.label", "value": "custom" }
      ],
      "default": "none"
    },
    {
      "type": "range",
      "min": 0, "max": 100, "default": 16, "step": 1,
      "label": "t:sections.all.margin.margin_bottom.custom.value",
      "visible_if": "{{ section.settings.margin_bottom == 'custom' }}",
      "unit": "px",
      "id": "margin_bottom_custom"
    },
    {
      "type": "select",
      "id": "padding_y",
      "label": "t:sections.all.padding_y.label",
      "options": [
        { "label": "t:sections.all.padding_y.none", "value": "none" },
        { "label": "t:sections.all.padding_y.small", "value": "small" },
