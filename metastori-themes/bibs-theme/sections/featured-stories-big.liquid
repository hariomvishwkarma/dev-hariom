      "options": [
        { "value": "", "label": "t:sections.all.font_weight.options.default" },
        { "value": "!font-thin", "label": "t:sections.all.font_weight.options.thin" },
        { "value": "!font-light", "label": "t:sections.all.font_weight.options.light" },
        { "value": "!font-normal", "label": "t:sections.all.font_weight.options.normal" },
        { "value": "!font-medium", "label": "t:sections.all.font_weight.options.medium" },
        { "value": "!font-semibold", "label": "t:sections.all.font_weight.options.semibold" },
        { "value": "!font-bold", "label": "t:sections.all.font_weight.options.bold" }
