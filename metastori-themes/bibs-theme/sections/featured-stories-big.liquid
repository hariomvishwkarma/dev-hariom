    {
      "type": "checkbox",
      "id": "explore_all_btn",
      "label": "t:sections.featured_stories_big.settings.explore_all_btn.label"
    },
    {
      "type": "range",
      "id": "slides_per_view",
      "label": "t:sections.featured_stories_big.settings.slides_per_view.label",
