<style>
  .section-id-{{ section.id }} .card-article .card-article-main-img:after {
    background-color: {{ section.settings.overlay_color }};
    opacity: 0.{{ section.settings.overlay_opacity }};
  }
</style>
{%- capture swiper_options -%}
  {
    "slidesPerView": {{ section.settings.slides_per_view }},
    "spaceBetween": 4,
    "grabCursor": true,
    "loop": true,
    "breakpoints": {
      "450": { "slidesPerView": {{ section.settings.slides_per_view | plus: 1 }} },
      "768": { "slidesPerView": {{ section.settings.slides_per_view_tablets }} },
      "1280": { "slidesPerView": {{ section.settings.slides_per_view_desktop }} },
      "1636": { "slidesPerView": {{ section.settings.slides_per_view_desktop | plus: 1 }} }
    },
    "navigation": {
      "nextEl": ".swiper-button-next",
      "prevEl": ".swiper-button-prev"
    },
    "scrollbar": {
      "el": ".swiper-scrollbar",
      "draggable": true
    }
  }
{%- endcapture -%}
{%- capture swiper_attribute -%}
  data-swiper='{{- swiper_options -}}'
{%- endcapture -%}

{% liquid
  assign featured_blog_handle = section.settings.featured_blog.handle | default: blog.handle
  assign color_scheme = section.settings.color_scheme
  assign section_heading = section.settings.heading
  assign heading_tag = section.settings.heading_tag
  assign font_size = section.settings.font_size
  assign font_weight = section.settings.font_weight
  assign heading_type = font_size | append: ' ' | append: font_weight
  assign italic_header_text = section.settings.italic_header_text
  if italic_header_text
    assign heading_type = heading_type | append: ' !italic'
  endif
  assign section_description = section.settings.description
  assign explore_all_btn = section.settings.explore_all_btn
  assign featured_blog = section.settings.featured_blog
  assign padding_y = section.settings.padding_y
  case padding_y
    when 'none'
      assign padding_y_classes = 'py-0'
    when 'small'
      assign padding_y_classes = 'py-5 md:py-10'
    when 'large'
      assign padding_y_classes = 'py-12 md:py-24'
    else
      assign padding_y_classes = 'py-9 md:py-20'
  endcase
%}

{% comment %} paginate unlocks up to 250 articles — the only Liquid way past the 20-item cap {% endcomment %}
{% paginate blogs[featured_blog_handle].articles by 250 %}

{% assign matched_count = 0 %}
{% for article in blogs[featured_blog_handle].articles %}
  {% for article_tag in article.tags %}
    {% assign tag_lower = article_tag | downcase %}
    {% if tag_lower contains 'product_' %}
      {% assign stripped = tag_lower | remove: 'product_' %}
      {% for p_tag in product.tags %}
        {% assign p_tag_lower = p_tag | downcase %}
        {% if p_tag_lower == stripped %}
          {% assign matched_count = matched_count | plus: 1 %}
          {% break %}
        {% endif %}
      {% endfor %}
    {% endif %}
  {% endfor %}
{% endfor %}

{% if matched_count > 0 %}
  <div class="space-y-[30px] color-{{ color_scheme }} {{ padding_y_classes }} section-id-{{ section.id }}">
    <div class="flex flex-col md:flex-row gap-5 justify-between container-fluid items-start md:items-center">
      {%- if section_heading != blank -%}
        {% liquid
          if section_heading contains '[' and section_heading contains ']'
            assign opening_tag = '<span class="text-accent">'
            assign title = section_heading | replace: '[', opening_tag | replace: ']', '</span>'
          else
            assign title = section_heading
          endif
        %}
        {% render 'c-title', custom_tag: heading_tag, content: title, type: heading_type, classes: 'leading-none' %}
      {%- endif -%}

      {%- if section_description != blank -%}
        {% liquid
          if section_description contains '[' and section_description contains ']'
            assign opening_tag = '<span class="text-accent">'
            assign description = section_description | replace: '[', opening_tag | replace: ']', '</span>'
          else
            assign description = section_description
          endif
        %}
        {% render 'c-richtext', content: description, classes: 'max-w-[530px] text-lg md:text-xl font-normal' %}
      {%- endif -%}
    </div>

    <div class="swiper swiper-card pl-4 md:pl-8 lg:pl-[30px]" {{ swiper_attribute }}>
      <div class="swiper-wrapper">
        {% for article in blogs[featured_blog_handle].articles %}
          {% assign article_matched = false %}
          {% for article_tag in article.tags %}
            {% unless article_matched %}
              {% assign tag_lower = article_tag | downcase %}
              {% if tag_lower contains 'product_' %}
                {% assign stripped = tag_lower | remove: 'product_' %}
                {% for p_tag in product.tags %}
                  {% assign p_tag_lower = p_tag | downcase %}
                  {% if p_tag_lower == stripped %}
                    <div class="swiper-slide">
                      {% render 'card-article-featured-stories',
                        article: article,
                        aspect_ratio: 'rectangle',
                        image_style: 'aspect-ratio: 4 / 5;',
                        text_size: 'text-base sm:text-7xl'
                      %}
                    </div>
                    {% assign article_matched = true %}
                    {% break %}
                  {% endif %}
                {% endfor %}
              {% endif %}
            {% endunless %}
          {% endfor %}
        {% endfor %}
      </div>

      <div class="swiper-button-prev !left-9 after:pr-[2px] hidden md:flex"></div>
      <div class="swiper-button-next !right-9 after:pl-[2px] hidden md:flex"></div>
      <div class="swiper-scrollbar !left-0 !hidden"></div>
    </div>

    {% if explore_all_btn %}
      <div class="container-fluid flex">
        {% render 'c-link',
          translatable_content: 'blog.explore_all',
          classes: 'button--primary rounded-full shadow-none w-fit h-fit',
          href: featured_blog.url
        %}
      </div>
    {% endif %}
  </div>

  {% render 'divider',
    height: section.settings.margin_bottom,
    custom: section.settings.margin_bottom_custom,
    color_scheme: color_scheme
  %}
{% endif %}
{% endpaginate %}

{% schema %}
{
  "name": "t:sections.featured_stories_big.name",
  "class": "section-featured-stories-big",
  "settings": [
    {
