{% liquid
  assign heading_tag = section.settings.heading_tag
  assign image = section.settings.image
  assign font_size = section.settings.font_size
  assign font_weight = section.settings.font_weight
  assign heading_type = font_size | append: ' ' | append: font_weight
  assign italic_header_text = section.settings.italic_header_text
  if italic_header_text
    assign heading_type = heading_type | append: ' !italic'
  endif
  assign market = localization.market.handle | append: ''
%}
<div
  data-newsletter
  class="color-{{ section.settings.color_scheme }} flex sm:flex-row flex-col-reverse w-full justify-end sm:justify-center sm:h-[calc(100vh-4rem)] flex-1 overflow-hidden"
>
  <!-- TODO: Fix email signup -->
  <div class="newsletter-form-wrapper p-8 flex justify-center sm:flex-1 items-center">
    <div id="newsletter-content" class="max-w-md">
      {% render 'c-title', translatable_content: 'newsletter.join', custom_tag: heading_tag, type: heading_type %}
      <form class="mt-6 space-y-3">
        {% render 'c-input',
          id: 'newsletter-name',
          input_name: 'name',
          input_translatable_placeholder: 'newsletter.name',
          extra_classes: 'border-grey-400 border-b'
        %}
        {% render 'c-input',
          id: 'newsletter-email',
          input_name: 'email',
          input_type: 'email',
          input_translatable_placeholder: 'newsletter.email',
          extra_classes: 'border-grey-400 border-b'
        %}
        {% render 'c-input',
          id: 'newsletter-market',
          input_name: 'market',
          input_type: 'text',
          extra_classes: 'hidden',
          input_value: market
        %}
        <label class="text-sm flex items-center select-none justify-center mx-auto sm:mx-0">
          <input type="checkbox" name="Terms and conditions checkbox" class="mr-1" required>
          {% assign terms_link = section.settings.terms_link | default: '/pages/terms-and-conditions' %}
          <span>{{ 'newsletter.terms_and_conditions_html' | t: link: terms_link }}</span>
        </label>
        {% render 'c-button',
          type: 'submit',
          translatable_content: 'newsletter.subscribe',
          design: 'accent',
          classes: 'rounded-full flex justify-center mx-auto disabled:bg-grey-400 button--small',
          id: 'submit-contact'
        %}
      </form>
    </div>
    <div id="newsletter-success" class="flex-col justify-center items-center text-center hidden">
      <div class="mt-7">
        {% render 'c-title', translatable_content: 'newsletter.subscription_community_success', custom_tag: 'h3' %}
        {% render 'c-text',
          translatable_content: 'newsletter.subscription_community_success_text',
          classes: 'text-base mt-3'
        %}
      </div>
    </div>
  </div>
  {% if image != blank %}
    <div class="newsletter-img-wrapper sm:h-full sm:flex-1">
      {% render 'c-image' with image: image, classes: "h-[40vh] sm:h-full" %}
    </div>
  {% endif %}
</div>
{% render 'divider',
  height: section.settings.margin_bottom,
  custom: section.settings.margin_bottom_custom,
  color_scheme: section.settings.color_scheme
%}

{% schema %}
{
  "name": "Newsletter",
  "tag": "section",
  "class": "section-newsletter",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "background-1"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "t:sections.newsletter.settings.image.label"
    },
    {
      "type": "select",
      "label": "t:sections.all.heading_tag.label",
      "id": "heading_tag",
      "default": "h3",
      "options": [
        {
          "value": "h1",
          "label": "t:sections.all.heading_tag.options.h1"
        },
        {
          "value": "h2",
          "label": "t:sections.all.heading_tag.options.h2"
        },
        {
          "value": "h3",
          "label": "t:sections.all.heading_tag.options.h3"
        },
        {
          "value": "h4",
          "label": "t:sections.all.heading_tag.options.h4"
        },
        {
          "value": "h5",
          "label": "t:sections.all.heading_tag.options.h5"
        },
        {
          "value": "h6",
          "label": "t:sections.all.heading_tag.options.h6"
        }
      ]
    },
    {
      "type": "select",
      "label": "t:sections.all.font_size.label",
      "id": "font_size",
      "default": "",
      "options": [
        {
          "value": "",
          "label": "t:sections.all.font_size.options.default"
        },
        {
          "value": "paragraph-1",
          "label": "t:sections.all.font_size.options.paragraph"
        },
        {
          "value": "h1",
          "label": "t:sections.all.font_size.options.h1"
        },
        {
          "value": "h2",
          "label": "t:sections.all.font_size.options.h2"
        },
        {
          "value": "h3",
          "label": "t:sections.all.font_size.options.h3"
        },
        {
          "value": "h4",
          "label": "t:sections.all.font_size.options.h4"
        },
        {
          "value": "h5",
          "label": "t:sections.all.font_size.options.h5"
        },
        {
          "value": "h6",
          "label": "t:sections.all.font_size.options.h6"
        }
      ]
    },
    {
      "type": "select",
      "label": "t:sections.all.font_weight.label",
      "id": "font_weight",
      "default": "",
      "options": [
        {
          "value": "",
          "label": "t:sections.all.font_weight.options.default"
        },
        {
          "value": "!font-thin",
          "label": "t:sections.all.font_weight.options.thin"
        },
        {
          "value": "!font-light",
          "label": "t:sections.all.font_weight.options.light"
        },
        {
          "value": "!font-normal",
          "label": "t:sections.all.font_weight.options.normal"
        },
        {
          "value": "!font-medium",
          "label": "t:sections.all.font_weight.options.medium"
        },
        {
          "value": "!font-semibold",
          "label": "t:sections.all.font_weight.options.semibold"
        },
        {
          "value": "!font-bold",
          "label": "t:sections.all.font_weight.options.bold"
        }
      ]
    },
    {
      "type": "checkbox",
      "id": "italic_header_text",
      "label": "t:sections.all.italic_header_text.label",
      "default": false
    },
    {
      "type": "url",
      "id": "terms_link",
      "label": "Terms and conditions link"
    },
    {
      "type": "header",
      "content": "t:sections.all.margin.heading"
    },
    {
      "type": "select",
      "id": "margin_bottom",
      "label": "t:sections.all.margin.margin_bottom.label",
      "options": [
        {
          "label": "t:sections.all.margin.margin_bottom.none",
          "value": "none"
        },
        {
          "label": "t:sections.all.margin.margin_bottom.small",
          "value": "small"
        },
        {
          "label": "t:sections.all.margin.margin_bottom.normal",
          "value": "normal"
        },
        {
          "label": "t:sections.all.margin.margin_bottom.large",
          "value": "large"
        },
        {
          "label": "t:sections.all.margin.margin_bottom.custom.label",
          "value": "custom"
        }
      ],
      "default": "none"
    },
    {
      "type": "range",
      "min": 0,
      "max": 100,
      "default": 16,
      "step": 1,
      "label": "t:sections.all.margin.margin_bottom.custom.value",
      "visible_if": "{{ section.settings.margin_bottom == 'custom' }}",
      "unit": "px",
      "id": "margin_bottom_custom"
    }
  ],
  "presets": [
    {
      "name": "Newsletter"
    }
  ]
}
{% endschema %}
