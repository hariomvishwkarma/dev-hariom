{% render 'contact-form',
  heading: section.settings.contact_heading,
  intro_text: section.settings.contact_intro_text,
  color_scheme: section.settings.color_scheme,
  margin_bottom: section.settings.margin_bottom,
  include_company_inputs: section.settings.company_inputs,
  header_tag: section.settings.heading_tag
%}

{% schema %}
{
  "name": "t:sections.contact-form.name",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "background-1"
    },
    {
      "type": "text",
      "label": "t:sections.contact-form.settings.heading",
      "id": "contact_heading",
      "default": "t:sections.contact-form.settings.default"
    },
    {
      "type": "checkbox",
      "id": "company_inputs",
      "label": "t:sections.contact-form.settings.company_inputs.label",
      "default": true
    },
    {
      "type": "select",
      "label": "t:sections.contact-form.settings.heading_tag.label",
      "id": "heading_tag",
      "default": "h3",
      "options": [
        {
          "value": "h1",
          "label": "H1"
        },
        {
          "value": "h2",
          "label": "H2"
        },
        {
          "value": "h3",
          "label": "H3"
        },
        {
          "value": "h4",
          "label": "H4"
        },
        {
          "value": "h5",
          "label": "H5"
        },
        {
          "value": "h6",
          "label": "H6"
        }
      ]
    },
    {
      "type": "richtext",
      "id": "contact_intro_text",
      "label": "t:sections.contact-form.settings.intro_text",
      "default": "<p>Please, don't hesitate to check our HELP & SUPPORT</p>"
    },
    {
      "type": "header",
      "content": "t:sections.all.margin.heading"
    },
    {
      "type": "select",
      "id": "margin_bottom",
      "label": "t:sections.all.margin.margin_bottom.label",
      "options": [
        {
          "label": "t:sections.all.margin.margin_bottom.none",
          "value": "none"
        },
        {
          "label": "t:sections.all.margin.margin_bottom.small",
          "value": "small"
        },
        {
          "label": "t:sections.all.margin.margin_bottom.normal",
          "value": "normal"
        },
        {
          "label": "t:sections.all.margin.margin_bottom.large",
          "value": "large"
        },
        {
          "label": "t:sections.all.margin.margin_bottom.custom.label",
          "value": "custom"
        }
      ],
      "default": "none"
    },
    {
      "type": "range",
      "min": 0,
      "max": 100,
      "default": 16,
      "step": 1,
      "label": "t:sections.all.margin.margin_bottom.custom.value",
      "visible_if": "{{ section.settings.margin_bottom == 'custom' }}",
      "unit": "px",
      "id": "margin_bottom_custom"
    }
  ],
  "presets": [
    {
      "name": "t:sections.contact-form.presets.name"
    }
  ]
}
{% endschema %}
