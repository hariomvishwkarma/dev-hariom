{% liquid
  assign number_of_products_per_page = section.settings.number_of_products_per_page
  assign number_of_columns_large = section.settings.number_of_columns_large
  assign number_of_columns_desktop = section.settings.number_of_columns_desktop | plus: 0
  assign number_of_columns_mobile = section.settings.number_of_columns_mobile
  assign title_outline = section.settings.title_outline
  assign description_outline = section.settings.description_outline
  assign title_font_size = section.settings.title_font_size
  assign description_font_size = section.settings.description_font_size

  case number_of_columns_desktop
    when 1
      assign number_of_columns_desktop_classes = 'lg:grid-cols-1'
      assign number_of_columns_laptop_classes = 'md:grid-cols-1'
    when 2
      assign number_of_columns_desktop_classes = 'lg:grid-cols-2'
      assign number_of_columns_laptop_classes = 'md:grid-cols-1'
    when 3
      assign number_of_columns_desktop_classes = 'lg:grid-cols-3'
      assign number_of_columns_laptop_classes = 'md:grid-cols-2'
    when 4
      assign number_of_columns_desktop_classes = 'lg:grid-cols-4'
      assign number_of_columns_laptop_classes = 'md:grid-cols-3'
    when 5
      assign number_of_columns_desktop_classes = 'lg:grid-cols-5'
      assign number_of_columns_laptop_classes = 'md:grid-cols-4'
    when 6
      assign number_of_columns_desktop_classes = 'lg:grid-cols-6'
      assign number_of_columns_laptop_classes = 'md:grid-cols-5'
    when 7
      assign number_of_columns_desktop_classes = 'lg:grid-cols-7'
      assign number_of_columns_laptop_classes = 'md:grid-cols-6'
    when 8
      assign number_of_columns_desktop_classes = 'lg:grid-cols-8'
      assign number_of_columns_laptop_classes = 'md:grid-cols-7'
    when 9
      assign number_of_columns_desktop_classes = 'lg:grid-cols-9'
      assign number_of_columns_laptop_classes = 'md:grid-cols-8'
    when 10
      assign number_of_columns_desktop_classes = 'lg:grid-cols-10'
      assign number_of_columns_laptop_classes = 'md:grid-cols-9'
    when 11
      assign number_of_columns_desktop_classes = 'lg:grid-cols-11'
      assign number_of_columns_laptop_classes = 'md:grid-cols-10'
    when 12
      assign number_of_columns_desktop_classes = 'lg:grid-cols-12'
      assign number_of_columns_laptop_classes = 'md:grid-cols-11'
  endcase

  case number_of_columns_large
    when 4
      assign number_of_columns_large_classes = '2xl:grid-cols-4'
    when 5
      assign number_of_columns_large_classes = '2xl:grid-cols-5'
    when 6
      assign number_of_columns_large_classes = '2xl:grid-cols-6'
    when 7
      assign number_of_columns_large_classes = '2xl:grid-cols-7'
    when 8
      assign number_of_columns_large_classes = '2xl:grid-cols-8'
    when 9
      assign number_of_columns_large_classes = '2xl:grid-cols-9'
    when 10
      assign number_of_columns_large_classes = '2xl:grid-cols-10'
    when 11
      assign number_of_columns_large_classes = '2xl:grid-cols-11'
    when 12
      assign number_of_columns_large_classes = '2xl:grid-cols-12'
    when 13
      assign number_of_columns_large_classes = '2xl:grid-cols-13'
    when 14
      assign number_of_columns_large_classes = '2xl:grid-cols-14'
    when 15
      assign number_of_columns_large_classes = '2xl:grid-cols-15'
  endcase

  assign number_of_columns_mobile = number_of_columns_mobile | times: 1

  case number_of_columns_mobile
    when 1
      assign number_of_columns_mobile_classes = 'grid-cols-1'
    when 2
      assign number_of_columns_mobile_classes = 'grid-cols-2'
  endcase

  assign is_subscription_template = false
  if template.suffix == 'subscription'
    assign is_subscription_template = true
  endif

  assign heading_tag = section.settings.heading_tag
  assign font_size = section.settings.font_size
  assign font_weight = section.settings.font_weight
  assign heading_type = font_size | append: ' ' | append: font_weight
  assign italic_header_text = section.settings.italic_header_text
  if italic_header_text
    assign heading_type = heading_type | append: ' !italic'
  endif
%}
{% for block in section.blocks %}
  {% case block.type %}
    {% when 'shop-the-look' %}
      {% render 'shop-the-look-block', block: block, section: section %}
  {% endcase %}
{% endfor %}

<script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "CollectionPage",
    "name": {{ collection.title | json }},
    "description": {{ collection.description | strip_html | strip_newlines | json }},
    "url": {{ canonical_url | json }},
    "inLanguage": "{{ request.locale.iso_code }}",
    "mainEntity": {
      "@type": "ItemList",
      "name": {{ collection.title | json }},
      "itemListElement": [
        {% assign position = 1 %}
        {% for product in collection.products %}
          {
            "@type": "ListItem",
            "position": {{ position }},
            "url": {{ shop.url | append: product.url | json }}
          }{% unless forloop.last %},{% endunless %}
          {% assign position = position | plus: 1 %}
        {% endfor %}
      ]
    }
  }
</script>

<script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      {
        "@type": "ListItem",
        "position": 1,
        "name": {{ "general.breadcrumbs.home" | t | json }},
        "item": {{ shop.url | json }}
      },
      {
        "@type": "ListItem",
        "position": 2,
        "name": {{ collection.title | json }},
        "item": {{ canonical_url | json }}
      }
    ]
  }
</script>

<div class="color-{{ section.settings.color_scheme }}">
  <div class="flex">
    <div class="flex-1">
      <div class="container-fluid py-6 md:py-10 break-word collection-title">
        <div class="flex flex-col gap-4">
          {% render 'c-title', content: collection.title, custom_tag: heading_tag, type: heading_type %}
          {% if collection.description != blank and collection.description != '' %}
            {% assign description = collection.description | split: '|' | first | strip %}
            {% render 'c-richtext', content: description, classes: 'paragraph-1' %}
          {% endif %}
        </div>
      </div>

      {% if collection.metafields.custom.quick_links %}
        <div class="flex !w-screen gap-4 container-fluid pb-6 sm:pb-10 overflow-x-auto no-scrollbar overflow-hidden">
          {% assign looplength = collection.metafields.custom.quick_links.value.count %}
          {%- for collection in collection.metafields.custom.quick_links.value -%}
            {% if collection.metafields.custom.quick_link_image != blank %}
              {% assign collection_image = collection.metafields.custom.quick_link_image %}
            {% else %}
              {% assign collection_image = collection.products[0].featured_image %}
            {% endif %}
            <div class="text-center text-base {% if forloop.index == looplength %}mr-4{% endif %}">
              <a href="{{ collection.url }}" class="no-underline">
                {% if collection_image %}
                  {% render 'c-image',
                    image: collection_image,
                    classes: 'rounded-full w-[90px] h-[90px] md:w-[109px] md:h-[109px] flex items-center justify-center bg-secondary-background border border-borders overflow-hidden',
                    image_classes: '',
                    loading: 'eager',
                    fetch_priority: 'high'
                  %}
                {% endif %}
                <div class="text-xs md:text-sm mt-2.5 w-[90px] md:w-[109px] truncate">
                  {{ collection.title }}
                </div>
              </a>
            </div>
          {%- endfor -%}
        </div>
      {% endif %}

      {% unless collection.handle == 'pacifiers-quiz' %}
        {% render 'filter-bar', results: collection, enable_filtering: true %}
      {% endunless %}

      <div class="md:container-fluid flex gap-10 mt-6 collection-container-fluid">
        {% paginate collection.products by number_of_products_per_page %}
          {% liquid
            if is_subscription_template
              assign collection_products = collection.products | where: 'selected_or_first_available_selling_plan_allocation' | compact
            else
              assign collection_products = collection.products
            endif
          %}
          <div
            id="ProductGridContainer"
            class="relative w-full load-more-wrapper"
            data-id="{{ section.id }}"
          >
            {%- if collection_products.size == 0 -%}
              <div class="mt-5 mb-10 paragraph-1">
                <p>{{ 'sections.template-collection.empty' | t }}</p>
              </div>
            {%- else -%}
              <div class="load-more-grid overflow-x-hidden grid auto-rows-fr {{ number_of_columns_mobile_classes }} {{ number_of_columns_laptop_classes }} {{ number_of_columns_desktop_classes }} {{ number_of_columns_large_classes }} gap-0.5">
                {%- liquid
                  assign promo_blocks = collection.metafields.custom.promo_blocks.value
                  assign shop_the_look_blocks = collection.metafields.custom.promo_block_shop_the_look.value
                  assign current_page = paginate.current_page | minus: 1
                  assign bac = paginate.page_size | times: current_page

                  assign available_products = collection_products | where: 'available', true
                  assign sold_out_products = collection_products | where: 'available', false
                -%}
                {% for available_product in available_products %}
                  {% assign hide_product = available_product.metafields.custom.hide_product.value %}
                  {% assign loop_index = forloop.index | plus: bac %}
                  {% for promo_block in promo_blocks %}
                    <span
                      hidden
                      promo_block="{{ promo_block | json }}"
                      loop_index="{{ loop_index }}"
                      promo_block.position="{{ promo_block.position }}"
                    ></span>
                    {% if promo_block.position == loop_index %}
                      {% render 'promo-block',
                        promo_block: promo_block,
                        number_of_columns_mobile: number_of_columns_mobile,
                        number_of_columns_desktop: number_of_columns_desktop,
                        number_of_columns_large: number_of_columns_large,
                        title_outline: title_outline,
                        description_outline: description_outline,
                        description_font_size: description_font_size,
                        title_font_size: title_font_size,
                        slider_timing: section.settings.slider_timing
                      %}
                    {% endif %}
                  {% endfor %}

                  {% for shop_the_look_block in shop_the_look_blocks %}
                    {% if shop_the_look_block.position == loop_index %}
                      {% capture block_id %}shop-the-look-{{shop_the_look_block.position}}{% endcapture %}
                      {% render 'shop-the-look-block',
                        bg_image: shop_the_look_block.background_image,
                        bg_image_mobile: shop_the_look_block.background_image_mobile,
                        add_to_cart_position: shop_the_look_block.add_to_cart_position,
                        hide_add_to_cart_label: shop_the_look_block.hide_add_to_cart_label,
                        block_id: block_id,
                        section_id: section.id,
                        span_double: shop_the_look_block.span_double,
                        product_1: shop_the_look_block.product_1.value,
                        product_1_position_x: shop_the_look_block.horizontal_1,
                        product_1_position_y: shop_the_look_block.vertical_1,
                        product_1_position_x_mobile: shop_the_look_block.horizontal_mobile_1,
                        product_1_position_y_mobile: shop_the_look_block.vertical_mobile_1,
                        product_2: shop_the_look_block.product_2.value,
                        product_2_position_x: shop_the_look_block.horizontal_2,
                        product_2_position_y: shop_the_look_block.vertical_2,
                        product_2_position_x_mobile: shop_the_look_block.horizontal_mobile_2,
                        product_2_position_y_mobile: shop_the_look_block.vertical_mobile_2,
                        product_3: shop_the_look_block.product_3.value,
                        product_3_position_x: shop_the_look_block.horizontal_3,
                        product_3_position_y: shop_the_look_block.vertical_3,
                        product_3_position_x_mobile: shop_the_look_block.horizontal_mobile_3,
                        product_3_position_y_mobile: shop_the_look_block.vertical_mobile_3
                      %}
                    {% endif %}
                  {% endfor %}
                  {% unless hide_product %}
                    {% liquid
                      assign prioritize_card_image = false
                      if forloop.index <= number_of_columns_desktop
                        assign prioritize_card_image = true
                      endif
                    %}
                    {% render 'card-product',
                      card_product: available_product,
                      show_secondary_media: section.settings.show_secondary_media,
                      media_aspect_ratio: 'bibs',
                      prioritize_image: prioritize_card_image
                    %}
                  {% endunless %}
                {% endfor %}

                {% for sold_out_product in sold_out_products %}
                  {% assign hide_product = sold_out_product.metafields.custom.hide_product.value %}
                  {%- unless hide_product -%}
                    {% render 'card-product',
                      card_product: sold_out_product,
                      show_secondary_media: section.settings.show_secondary_media,
                      media_aspect_ratio: 'bibs',
                      prioritize_image: false
                    %}
                  {%- endunless -%}
                {% endfor %}
              </div>
              {% render 'pagination', pagination: paginate %}
              {% comment %}
                {% if paginate.current_page < paginate.pages %}
                  {% render 'load-more-pagination', pagination: paginate %}
                {% endif %}
              {% endcomment %}
            {%- endif -%}
            <div data-loading class="hidden">
              <div class="absolute inset-0 flex items-center justify-center bg-background/50">
                {%- render 'c-spinner', size: 'w-16 h-16' -%}
              </div>
            </div>
          </div>
        {% endpaginate %}
      </div>
    </div>
    {%- if is_subscription_template -%}
      {%- render 'subscription-selection',
        collection: collection,
        upsell_products: section.settings.subscription_upsell_products
      -%}
    {%- endif -%}
  </div>
</div>
{%- render 'divider', height: section.settings.margin_bottom, color_scheme: section.settings.color_scheme -%}

{% schema %}
{
  "name": "t:sections.template-collection.name",
  "class": "section-main-collection",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "background-1"
    },
    {
      "type": "select",
      "label": "t:sections.all.heading_tag.label",
      "id": "heading_tag",
      "default": "h1",
      "options": [
        {
          "value": "h1",
          "label": "t:sections.all.heading_tag.options.h1"
        },
        {
          "value": "h2",
          "label": "t:sections.all.heading_tag.options.h2"
        },
        {
          "value": "h3",
          "label": "t:sections.all.heading_tag.options.h3"
        },
        {
          "value": "h4",
          "label": "t:sections.all.heading_tag.options.h4"
        },
        {
          "value": "h5",
          "label": "t:sections.all.heading_tag.options.h5"
        },
        {
          "value": "h6",
          "label": "t:sections.all.heading_tag.options.h6"
        }
      ]
    },
    {
      "type": "select",
      "label": "t:sections.all.font_size.label",
      "id": "font_size",
      "default": "",
      "options": [
        {
          "value": "",
          "label": "t:sections.all.font_size.options.default"
        },
        {
          "value": "paragraph-1",
          "label": "t:sections.all.font_size.options.paragraph"
        },
        {
          "value": "h1",
          "label": "t:sections.all.font_size.options.h1"
        },
        {
          "value": "h2",
          "label": "t:sections.all.font_size.options.h2"
        },
        {
          "value": "h3",
          "label": "t:sections.all.font_size.options.h3"
        },
        {
          "value": "h4",
          "label": "t:sections.all.font_size.options.h4"
        },
        {
          "value": "h5",
          "label": "t:sections.all.font_size.options.h5"
        },
        {
          "value": "h6",
          "label": "t:sections.all.font_size.options.h6"
        }
      ]
    },
    {
      "type": "select",
      "label": "t:sections.all.font_weight.label",
      "id": "font_weight",
      "default": "",
      "options": [
        {
          "value": "",
          "label": "t:sections.all.font_weight.options.default"
        },
        {
          "value": "!font-thin",
          "label": "t:sections.all.font_weight.options.thin"
        },
        {
          "value": "!font-light",
          "label": "t:sections.all.font_weight.options.light"
        },
        {
          "value": "!font-normal",
          "label": "t:sections.all.font_weight.options.normal"
        },
        {
          "value": "!font-medium",
          "label": "t:sections.all.font_weight.options.medium"
        },
        {
          "value": "!font-semibold",
          "label": "t:sections.all.font_weight.options.semibold"
        },
        {
          "value": "!font-bold",
          "label": "t:sections.all.font_weight.options.bold"
        }
      ]
    },
    {
      "type": "checkbox",
      "id": "italic_header_text",
      "label": "t:sections.all.italic_header_text.label",
      "default": false
    },
    {
      "type": "header",
      "content": "t:sections.template-collection.settings.text.header"
    },
    {
      "type": "range",
      "id": "title_font_size",
      "label": "t:sections.template-collection.settings.text.font_size",
      "min": 10,
      "max": 100,
      "step": 1,
      "default": 40
    },
    {
      "type": "checkbox",
      "id": "title_outline",
      "label": "t:sections.template-collection.settings.text.outline",
      "default": false
    },
    {
      "type": "range",
      "id": "description_font_size",
      "label": "t:sections.template-collection.settings.text.font_size",
      "min": 10,
      "max": 50,
      "step": 1,
      "default": 18
    },
    {
      "type": "checkbox",
      "id": "description_outline",
      "label": "t:sections.template-collection.settings.text.outline",
      "default": false
    },
    {
      "type": "header",
      "content": "t:sections.template-collection.settings.header"
    },
    {
      "type": "number",
      "id": "number_of_products_per_page",
      "label": "t:sections.template-collection.settings.number_of_products_per_page.label",
      "default": 16
    },
    {
      "type": "range",
      "id": "number_of_columns_desktop",
      "label": "t:sections.template-collection.settings.number_of_columns_desktop.label",
      "min": 1,
      "max": 12,
      "step": 1,
      "default": 4
    },
    {
      "type": "range",
      "id": "number_of_columns_large",
      "label": "t:sections.template-collection.settings.number_of_columns_large.label",
      "min": 4,
      "max": 15,
      "step": 1,
      "default": 8
    },
    {
      "type": "select",
      "id": "number_of_columns_mobile",
      "label": "t:sections.template-collection.settings.number_of_columns_mobile.label",
      "options": [
        {
          "value": "1",
          "label": "1 column"
        },
        {
          "value": "2",
          "label": "2 columns"
        }
      ],
      "default": "1"
    },
    {
      "type": "header",
      "content": "t:sections.template-collection.settings.header__2"
    },
    {
      "type": "checkbox",
      "id": "show_secondary_media",
      "label": "t:sections.template-collection.settings.show_secondary_media.label",
      "default": true
    },
    {
      "type": "product_list",
      "id": "subscription_upsell_products",
      "label": "t:sections.template-collection.settings.subscription_upsell_products.label",
      "info": "t:sections.template-collection.settings.subscription_upsell_products.info"
    },
    {
      "type": "header",
      "content": "t:sections.all.margin.heading"
    },
    {
      "type": "select",
      "id": "margin_bottom",
      "label": "t:sections.all.margin.margin_bottom.label",
      "options": [
        {
          "label": "t:sections.all.margin.margin_bottom.none",
          "value": "none"
        },
        {
          "label": "t:sections.all.margin.margin_bottom.small",
          "value": "small"
        },
        {
          "label": "t:sections.all.margin.margin_bottom.normal",
          "value": "normal"
        },
        {
          "label": "t:sections.all.margin.margin_bottom.large",
          "value": "large"
        },
        {
          "label": "t:sections.all.margin.margin_bottom.custom.label",
          "value": "custom"
        }
      ],
      "default": "none"
    },
    {
      "type": "range",
      "min": 0,
      "max": 100,
      "default": 16,
      "step": 1,
      "label": "t:sections.all.margin.margin_bottom.custom.value",
      "visible_if": "{{ section.settings.margin_bottom == 'custom' }}",
      "unit": "px",
      "id": "margin_bottom_custom"
    },
    {
      "type": "header",
      "content": "Promo slider"
    },
    {
      "type": "range",
      "min": 1,
      "max": 10,
      "default": 3,
      "step": 1,
      "label": "Slider timing",
      "id": "slider_timing",
      "unit": "s"
    },
  ]
}
{% endschema %}
