{% liquid
  assign color_scheme = section.settings.color_scheme
  assign categories = section.settings.collection_list
  assign slide_quantity_desktop = section.settings.carousel_slide_quantity_desktop
  assign slide_quantity_ipad = section.settings.carousel_slide_quantity_ipad
  assign slide_quantity_mobile_landsc = section.settings.carousel_slide_quantity_mobile_landsc
  assign slide_quantity_mobile_bigger = section.settings.carousel_slide_quantity_mobile_bigger
  assign slide_quantity_mobile = section.settings.carousel_slide_quantity_mobile

  capture slide_quantity_mobile_smaller
    if slide_quantity_mobile > 1
      echo 1.5
    else
      echo 1
    endif
  endcapture

  assign header_title = section.settings.title
  assign heading_tag = section.settings.heading_tag
  assign font_size = section.settings.font_size
  assign font_weight = section.settings.font_weight
  assign heading_type = font_size | append: ' ' | append: font_weight
  assign italic_header_text = section.settings.italic_header_text
  if italic_header_text
    assign heading_type = heading_type | append: ' !italic'
  endif

  assign padding_y = section.settings.padding_y
  case padding_y
    when 'none'
      assign padding_y_classes = 'py-0'
    when 'small'
      assign padding_y_classes = 'py-5 md:py-10'
    when 'large'
      assign padding_y_classes = 'py-12 md:py-24'
    else
      assign padding_y_classes = 'py-9 md:py-20'
  endcase
%}

{%- capture swiper_options -%}
  {
    "slidesPerView": 1,
    "spaceBetween": 20,
    "grabCursor": true,
    "breakpoints": {
      "270": {
        "slidesPerView": {{ slide_quantity_mobile_smaller }}
      },
      "380": {
        "slidesPerView": {{ slide_quantity_mobile }}
      },
      "550": {
        "slidesPerView": {{ slide_quantity_mobile_bigger }}
      },
      "800": {
        "slidesPerView": {{ slide_quantity_mobile_landsc }}
      },
      "1000": {
        "slidesPerView": {{ slide_quantity_ipad }}
      },
      "1224": {
        "slidesPerView": {{ slide_quantity_desktop }}
      }
    },
    "navigation": {
      "nextEl": ".swiper-button-next",
      "prevEl": ".swiper-button-prev"
    },
    "scrollbar": {
      "el": ".swiper-scrollbar",
      "draggable": true
    }
  }
{%- endcapture -%}
{%- capture swiper_attribute -%}
  data-swiper='{{- swiper_options -}}'
{%- endcapture -%}

<div class="color-{{ color_scheme }} {{ padding_y_classes }} {% if section.settings.section_width == "full_right" %}container-fluid--l{% else %}container-fluid{% endif %}">
  {% if header_title != blank %}
    {% render 'c-title',
      content: header_title,
      custom_tag: heading_tag,
      type: heading_type,
      classes: 'mb-6 inline-block'
    %}
  {% endif %}

  <div class="swiper swiper-card !pb-5" {{ swiper_attribute }}>
    <div class="swiper-wrapper">
      {% for category in categories %}
        {% assign products_count = 'sections.highlighted-categories.view_products'
          | t: count: category.all_products_count
        %}
        <a href="{{ category.url }}" class="swiper-slide text-background relative">
          <div class="h-64 sm:h-80  flex justify-end gap-2 flex-col before:absolute before:inset-0 before:bg-gradient-to-t before:from-black/75 before:via-transparent before:to-transparent before:z-10">
            {% render 'c-image', image: category.image, classes: 'absolute w-full h-full overflow-hidden' %}
            {% render 'c-title', content: category.title, custom_tag: 'h4', classes: 'mx-6 z-10' %}
            {% render 'c-text', content: products_count, type: 'text-1-regular', classes: 'mx-6 mb-6 z-10' %}
          </div>
        </a>
      {% endfor %}
    </div>

    <div class="swiper-button-prev !left-9 after:pr-[2px]"></div>
    <div class="swiper-button-next !right-9 after:pl-[2px]"></div>

    <div class="swiper-scrollbar !left-0"></div>
  </div>
</div>
{% render 'divider',
  height: section.settings.margin_bottom,
  custom: section.settings.margin_bottom_custom,
  color_scheme: color_scheme
%}

