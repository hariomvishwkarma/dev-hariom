{% liquid
  assign icons = metaobjects.product_usp_icon.values
  assign product_collection_ids = product.collections | map: 'id'
%}
<div class="flex flex-col md:flex-row md:gap-12  w-fit mx-auto">
  {% for icon in icons %}
    {% assign icon_col_value = icon.collection.value %}
    {% for item in icon_col_value %}
      {% if product_collection_ids contains item.id %}
        {% assign icon_media = icon.icon %}
        {% assign icon_title = icon.title | escape %}
        <div class="flex flex-col gap-3.5 text-center items-center rounded  py-3 md:py-7.5  max-w-[323px] md:max-w-[258px]">
          <div>
            {% render 'c-image', image: icon_media | file_url, classes: 'h-[50px] w-[50px]' %}
          </div>
          <h5 class="text-[var(--custom-title-color)]">{{ icon_title }}</h5>
          <p class="text-[var(--custom-text-color)] ">{{ icon.text }}</p>
        </div>
        {% break %}
      {% endif %}
    {% endfor %}
  {% endfor %}
</div>

{% schema %}
{
  "name": "t:sections.dynamic-icons.name",
  "tag": "div",
  "settings": [
    {
      "type": "header",
      "content": "t:sections.dynamic-icons.settings.header.content"
    }
  ],
  "presets": [
    {
      "name": "t:sections.dynamic-icons.name"
    }
  ]
}
{% endschema %}
