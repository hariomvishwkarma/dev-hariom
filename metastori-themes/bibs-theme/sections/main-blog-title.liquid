{% assign blog = blogs.news %}
<div class="container-fluid color-{{ section.settings.color_scheme }}">
  <div class="border-b-4 pb-3">
    {% render 'c-title', translatable_content: 'blog.title', custom_tag: 'h1' %}
    <div class="mt-6 sm:mt-4 flex overflow-x-auto gap-2 test no-scrollbar">
      {% for tag in blog.all_tags %}
        <a
          href="{{ blog.url }}/tagged/{{ tag | handleize }}"
        >
          {% render 'c-button',
            type: 'submit',
            content: tag,
            design: 'outline--primary',
            classes: 'px-5 py-2  text-sm'
          %}
        </a>
      {% endfor %}
    </div>
  </div>
</div>
{% render 'divider',
  height: section.settings.margin_bottom,
  custom: section.settings.margin_bottom_custom,
  color_scheme: section.settings.color_scheme
%}

{% schema %}
{
  "name": "Main blog title",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "background-1"
    },
    {
      "type": "header",
      "content": "t:sections.all.margin.heading"
    },
    {
      "type": "select",
      "id": "margin_bottom",
      "label": "t:sections.all.margin.margin_bottom.label",
      "options": [
        {
          "label": "t:sections.all.margin.margin_bottom.none",
          "value": "none"
        },
        {
          "label": "t:sections.all.margin.margin_bottom.small",
          "value": "small"
        },
        {
          "label": "t:sections.all.margin.margin_bottom.normal",
          "value": "normal"
        },
        {
          "label": "t:sections.all.margin.margin_bottom.large",
          "value": "large"
        },
        {
          "label": "t:sections.all.margin.margin_bottom.custom.label",
          "value": "custom"
        }
      ],
      "default": "none"
    },
    {
      "type": "range",
      "min": 0,
      "max": 100,
      "default": 16,
      "step": 1,
      "label": "t:sections.all.margin.margin_bottom.custom.value",
      "visible_if": "{{ section.settings.margin_bottom == 'custom' }}",
      "unit": "px",
      "id": "margin_bottom_custom"
    }
  ],
  "presets": [
    {
      "name": "Main blog title"
    }
  ]
}
{% endschema %}
