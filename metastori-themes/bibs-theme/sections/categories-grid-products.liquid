{% liquid
  assign reverse_grid = section.settings.reverse_grid
  assign grid_collection = section.settings.collection
  assign grid_image = section.settings.grid_image
  assign product_color_scheme = section.settings.product_color_scheme

  if grid_image == blank
    assign grid_image = grid_collection.featured_image
  endif

  if reverse_grid
    assign products_col = 'lg:col-start-2'
    assign hero_col = 'lg:col-start-1'
  else
    assign products_col = 'lg:col-start-1'
    assign hero_col = 'lg:col-start-2'
  endif

  assign headline_color = section.settings.headline_color
  assign description_color = section.settings.description_color
  assign button_color = section.settings.button_color
  assign button_border_color = section.settings.button_border_color
  assign button_bg_color = section.settings.button_bg_color
%}

<div class="color-{{ section.settings.color_scheme }}">
  <div class="grid grid-cols-1 lg:mx-auto lg:grid-cols-2 auto-rows-min">
    <div class="lg:row-start-1 {{ hero_col }}">
      <div class="relative isolate overflow-hidden pb-[100%]">
        {% render 'c-image',
          image: grid_image,
          lazy: true,
          alt: grid_collection.title,
          aspect_ratio: 'bibs',
          classes: 'absolute top-0 bottom-0 left-0 right-0'
        %}
        <div class="flex justify-center md:justify-center bg-opacity-12 absolute top-0 bottom-0 left-0 right-0">
          <div class="max-w-2xl p-4 content-center md:content-center">
            <div class="text-center px-4 md:px-0">
              <span
                class="block text-3xl font-normal tracking-tight leading-tight sm:text-4xl {%  if section.settings.headline_stroke == true  %} drop-shadow {% endif %}"
                style="color: {{ headline_color }};"
              >
                {{ section.settings.headline }}
              </span>
              {% if section.settings.description_text != blank %}
                <p
                  class="max-w-md mx-auto mt-2 text-md leading-6 {%  if section.settings.description_stroke == true  %} drop-shadow {% endif %}"
                  style="color: {{ description_color }};"
                >
                  {{ section.settings.description_text }}
                </p>
              {% endif %}
              <div class="mt-10">
                <a
                  href="{{ section.settings.button_link | default: grid_collection.url }}"
                  class="bg-opacity-10 rounded-full border border-solid k px-4 py-2 sm:px-6 sm:py-4 text-sm hover:bg-opacity-24 shadow-sm focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary"
                  style="
                    color: {{ button_color }};
                    border-color: {{ button_border_color }};
                    background: {{ button_bg_color }};
                  "
                >
                  {{- section.settings.button_text -}}
                </a>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
    <div class="overflow-x-hidden grid auto-rows-fr grid-cols-2 md:grid-cols-3 gap-0.5 lg:row-start-1 {{ products_col }}">
      {% for product in grid_collection.products limit: 6 %}
        {% render 'card-product',
          card_product: product,
          show_secondary_media: true,
          media_aspect_ratio: 'bibs',
          product_color_scheme: product_color_scheme
        %}
      {% endfor %}
    </div>
  </div>
</div>
{% render 'divider',
  height: section.settings.margin_bottom,
  custom: section.settings.margin_bottom_custom,
  color_scheme: section.settings.color_scheme
%}

{% style %}
  .drop-shadow {
    text-shadow: 1px 1px 2px #000000;
  }
{% endstyle %}

{% schema %}
{
  "name": "Categories grid products",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label"
    },
    {
      "type": "color_scheme",
      "id": "product_color_scheme",
      "label": "t:sections.all.colors.product_label",
      "default": "background-1"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Select collection"
    },
    {
      "type": "image_picker",
      "id": "grid_image",
      "label": "Select image"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Link"
    },
    {
      "type": "checkbox",
      "id": "reverse_grid",
      "label": "Reverse grid",
      "default": false
    },
    {
      "type": "header",
      "content": "Text"
    },
    {
      "type": "text",
      "id": "headline",
      "label": "Headline"
    },
    {
      "type": "color",
      "id": "headline_color",
      "label": "Headline color",
      "default": "#ffffff"
    },
    {
      "type": "checkbox",
      "default": false,
      "id": "headline_stroke",
      "label": "Stroke"
    },
    {
      "type": "text",
      "id": "description_text",
      "label": "Description text"
    },
    {
      "type": "color",
      "id": "description_color",
      "label": "Description color",
      "default": "#ffffff"
    },
    {
      "type": "checkbox",
      "default": false,
      "id": "description_stroke",
      "label": "Stroke"
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button text"
    },
    {
      "type": "color",
      "id": "button_color",
      "label": "Button color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "button_border_color",
      "label": "Button border color",
      "default": "#22545C"
    },
    {
      "type": "color",
      "id": "button_bg_color",
      "label": "Button background color",
      "default": "#22545C"
    },
    {
      "type": "header",
      "content": "t:sections.all.margin.heading"
    },
    {
      "type": "select",
      "id": "margin_bottom",
      "label": "t:sections.all.margin.margin_bottom.label",
      "options": [
        {
          "label": "t:sections.all.margin.margin_bottom.none",
          "value": "none"
        },
        {
          "label": "t:sections.all.margin.margin_bottom.small",
          "value": "small"
        },
        {
          "label": "t:sections.all.margin.margin_bottom.normal",
          "value": "normal"
        },
        {
          "label": "t:sections.all.margin.margin_bottom.large",
          "value": "large"
        },
        {
          "label": "t:sections.all.margin.margin_bottom.custom.label",
          "value": "custom"
        }
      ],
      "default": "small"
    },
    {
      "type": "range",
      "min": 0,
      "max": 100,
      "default": 16,
      "step": 1,
      "label": "t:sections.all.margin.margin_bottom.custom.value",
      "visible_if": "{{ section.settings.margin_bottom == 'custom' }}",
      "unit": "px",
      "id": "margin_bottom_custom"
    }
  ],
  "presets": [
    {
      "name": "Collection product grid"
    }
  ]
}
{% endschema %}
