        },
        {
          "type": "header",
          "content": "t:sections.header.blocks.brands-menu.settings.header__1.content"
        },
        {
          "type": "checkbox",
          "id": "display_top_brands",
          "label": "t:sections.header.blocks.brands-menu.settings.display_top_brands.label",
          "default": true
        },
        {
          "type": "range",
          "id": "limit_top_brands",
          "label": "t:sections.header.blocks.brands-menu.settings.limit_top_brands.label",
          "default": 10,
          "min": 1,
          "max": 30,
          "step": 1
        }
      ]
    },
    {
      "name": "t:sections.header.blocks.icons.name",
      "type": "icons",
      "settings": [
        {
          "type": "color_scheme",
          "id": "color_scheme",
          "label": "t:sections.all.colors.label"
        }
      ]
    },
    {
      "name": "t:sections.header.blocks.mobile-menu.name",
      "type": "mobile-menu",
      "limit": 1,
      "settings": [
        {
          "type": "color_scheme",
          "id": "color_scheme",
          "label": "t:sections.all.colors.label",
          "default": "accent-2"
        },
        {
          "type": "link_list",
