            },
            {
              "label": "t:sections.header.blocks.menu.settings.menu_type.options.black_friday.label",
              "value": "black-friday"
            },
            {
              "label": "t:sections.header.blocks.menu.settings.menu_type.options.sale.label",
              "value": "sale"
            }
          ],
          "default": "primary"
        },
        {
          "type": "header",
          "content": "t:sections.header.blocks.menu.settings.header__1.content"
        },
        {
          "type": "checkbox",
          "id": "enable_mega_menu",
          "label": "t:sections.header.blocks.menu.settings.enable_mega_menu.label",
          "default": true
        },
        {
          "type": "checkbox",
          "id": "enable_menu_with_icons",
