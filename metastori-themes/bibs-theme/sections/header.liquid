          "id": "color_scheme",
          "label": "t:sections.all.colors.label",
          "default": "accent-2"
        },
        {
          "type": "select",
          "id": "menu_type",
          "label": "t:sections.header.blocks.brands-menu.settings.menu_type.label",
          "options": [
            {
