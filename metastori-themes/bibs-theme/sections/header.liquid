<header
  id="header"
  class="header container-fluid color-{{ section.settings.color_scheme }} z-[11] {% if section.settings.enable_sticky_header == true %} sticky {% endif %}"
>
  <nav>
    <div class="flex justify-between items-center min-h-[60px] relative">
      {% liquid
        for block in section.blocks
          case block.type
            when 'logo'
              assign styles = 'max-width: ' | append: block.settings.logo_width | append: 'px;'
              render 'logo', block: block, classes: 'flex-1 absolute left-half -translate-x-2/4 w-full lg:relative lg:left-0 lg:translate-x-0 lg:flex-none lg:mr-5 py-3.5', styles: styles

            when 'search'
              render 'search-bar', block: block

            when 'menu'
              render 'header-menu', block: block

            when 'brands-menu'
              render 'brands-menu', block: block

            when 'icons'
              render 'header-icons', block: block, section: section

            when 'mobile-menu'
              render 'header-mobile-menu', block: block

            when 'mobile-menu-new'
              render 'header-mobile-menu-new', block: block

            when 'markets-switcher'
              if block.settings.enable_market_switcher
                render 'markets-switcher', hide_name: true
              endif
            when '@app'
              render block
          endcase
        endfor
      %}
    </div>
  </nav>
</header>

{% schema %}
{
  "name": "t:sections.header.name",
  "class": "section-header relative bg-background",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "background-1"
    },
    {
      "type": "checkbox",
      "id": "enable_sticky_header",
      "default": true,
      "label": "t:sections.header.settings.enable_sticky_header.label",
      "info": "t:sections.header.settings.enable_sticky_header.info"
    },
    {
      "type": "header",
      "content": "t:sections.header.settings.header__1.content",
      "info": "t:sections.header.settings.header__1.info"
    },
    {
      "type": "checkbox",
      "id": "enable_country_selector",
      "label": "t:sections.header.settings.enable_country_selector.label",
      "default": false
    }
  ],
  "blocks": [
    {
      "type": "@app"
    },
    {
      "name": "mobile-menu-new",
      "type": "mobile-menu-new",
      "limit": 1,
      "settings": [
        {
          "type": "header",
          "content": "Color scheme"
        },
        {
          "type": "color_scheme",
          "label": "Color scheme",
          "id": "color_scheme",
          "default": "color-scheme-773c6576-c02a-44d5-90ff-40321acc496d"
        },
        {
          "type": "checkbox",
          "id": "calculate_height",
          "label": "Calculate height",
          "default": false
        },
        {
          "type": "link_list",
          "id": "menu_new",
          "label": "New menu"
        },
        {
          "type": "image_picker",
          "id": "logo",
          "label": "Logo"
        },
        {
          "type": "text",
          "id": "social_media",
          "label": "Social media",
          "info": "Separeret med ','",
          "default": "instagram, facebook, youtube, pinterest, tiktok"
        }
      ]
    },
    {
      "name": "t:sections.header.blocks.logo.name",
      "type": "logo",
      "limit": 1,
      "settings": [
        {
          "type": "image_picker",
          "id": "logo",
          "label": "t:sections.header.blocks.logo.settings.logo.label"
        },
        {
          "type": "image_picker",
          "id": "logo_alt",
          "label": "t:sections.header.blocks.logo.settings.logo_alt.label"
        },
        {
          "type": "range",
          "id": "logo_width",
          "min": 20,
          "max": 200,
          "step": 2,
          "default": 154,
          "unit": "px",
          "label": "t:sections.header.blocks.logo.settings.logo_width.label"
        }
      ]
    },
    {
      "name": "t:sections.header.blocks.search.name",
      "type": "search",
      "limit": 1,
      "settings": [
        {
          "type": "color_scheme",
          "id": "color_scheme",
          "label": "t:sections.all.colors.label",
          "default": "accent-2"
        },
        {
          "type": "checkbox",
          "id": "display_search_as_icon",
          "label": "t:sections.header.blocks.search.settings.display_search_as_icon.label",
          "default": true
        },
        {
          "type": "image_picker",
          "id": "logo",
          "label": "t:sections.header.blocks.logo.settings.logo.label"
        },
        {
          "type": "image_picker",
          "id": "logo_alt",
          "label": "t:sections.header.blocks.logo.settings.logo_alt.label"
        },
        {
          "type": "range",
          "id": "logo_width",
          "min": 20,
          "max": 200,
          "step": 2,
          "default": 154,
          "unit": "px",
          "label": "t:sections.header.blocks.logo.settings.logo_width.label"
        }
      ]
    },
    {
      "name": "t:sections.header.blocks.menu.name",
      "type": "menu",
      "settings": [
        {
          "type": "link_list",
          "id": "menu",
          "label": "t:sections.header.blocks.menu.settings.menu.label",
          "default": "main-menu"
        },
        {
          "type": "select",
          "id": "menu_type",
          "label": "t:sections.header.blocks.menu.settings.menu_type.label",
          "options": [
            {
              "label": "t:sections.header.blocks.menu.settings.menu_type.options.primary.label",
              "value": "primary"
            },
            {
              "label": "t:sections.header.blocks.menu.settings.menu_type.options.secondary.label",
              "value": "secondary"
            },
            {
              "label": "t:sections.header.blocks.menu.settings.menu_type.options.tertiary.label",
