          "default": false
        },
        {
          "type": "color_scheme",
          "id": "color_scheme",
          "label": "t:sections.all.colors.label",
          "default": "accent-2"
        },
        {
          "type": "select",
          "id": "menu_links_list_width",
          "label": "t:sections.header.blocks.menu.settings.menu_links_list_width.label",
          "options": [
            {
              "label": "t:sections.header.blocks.menu.settings.menu_links_list_width.options.auto_width.label",
              "value": "auto_width"
            },
            {
              "label": "t:sections.header.blocks.menu.settings.menu_links_list_width.options.half_width.label",
              "value": "half_width"
            },
            {
              "label": "t:sections.header.blocks.menu.settings.menu_links_list_width.options.one_third_width.label",
              "value": "one_third_width"
            },
            {
