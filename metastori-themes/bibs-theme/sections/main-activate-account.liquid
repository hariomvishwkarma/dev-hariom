{% liquid
  assign input_classes = 'bg-gray-50 border border-gray-300 text-gray-900 text-sm rounded block w-full p-2.5'
  assign label_classes = 'block mb-2 text-sm font-semibold text-gray-900'

  assign heading_tag = section.settings.heading_tag
  assign font_size = section.settings.font_size
  assign font_weight = section.settings.font_weight
  assign heading_type = font_size | append: ' ' | append: font_weight
  assign italic_header_text = section.settings.italic_header_text
  if italic_header_text
    assign heading_type = heading_type | append: ' !italic'
  endif
%}

<div class="container-fluid color-{{ section.settings.color_scheme }}">
  <div class="max-w-xl mx-auto text-center my-6">
    {% render 'c-title',
      translatable_content: 'customer.activate_account.title',
      custom_tag: heading_tag,
      type: heading_type
    %}

    {%- form 'activate_customer_password' -%}
      {% if form.errors %}
        <ul>
          {%- for field in form.errors -%}
            <li>
              {%- if field == 'form' -%}
                {{ form.errors.messages[field] }}

              {%- else -%}
                <a class="underline underline-offset-2" href="#{{ field }}">
                  {{ form.errors.translated_fields[field] | capitalize }}
                  {{ form.errors.messages[field] }}
                </a>
              {%- endif -%}
            </li>
          {%- endfor -%}
        </ul>
      {% endif %}

      <div class="mb-6 text-left">
        <label class="{{ label_classes }}" for="password">{{ 'customer.activate_account.password' | t }}</label>
        <input
          class="{{ input_classes }}"
          type="password"
          id="password"
          name="customer[password]"
          autocomplete="new-password"
          placeholder="{{ 'customer.activate_account.password' | t }}"
        >
        {%- if form.errors contains 'password' -%}
          <p class="{{ input_error_classes }}">
            {{- form.errors.translated_fields.password | capitalize }}
            {{ form.errors.messages.password -}}
          </p>
        {%- endif -%}
      </div>

      <div class="mb-6 text-left">
        <label class="{{ label_classes }}" for="password_confirmation">
          {{- 'customer.activate_account.password_confirmation' | t -}}
        </label>
        <input
          class="{{ input_classes }}"
          type="password"
          id="password_confirmation"
          name="customer[password_confirmation]"
          autocomplete="new-password"
          placeholder="{{ 'customer.activate_account.confirm_password_placeholder' | t }}"
        >
        {%- if form.errors contains 'password_confirmation' -%}
          <p class="{{ input_error_classes }}">
            {{- form.errors.translated_fields.password_confirmation | capitalize }}
            {{ form.errors.messages.password_confirmation -}}
          </p>
        {%- endif -%}
      </div>

      <div class="flex flex-wrap gap-4 mt-8 mb-4">
        {%- assign submit_button_content = 'customer.activate_account.submit' | t -%}
        {% render 'c-button', type: 'submit', content: submit_button_content, design: 'primary' %}

        {%- assign submit_button_content = 'customer.activate_account.cancel' | t -%}
        {% render 'c-button', type: 'submit', name: 'decline', content: submit_button_content, design: 'secondary' %}
      </div>
    {%- endform -%}
  </div>
</div>

