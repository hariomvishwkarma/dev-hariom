{%- comment %}<locksmith:43db>{% endcomment -%}
  {%- include 'locksmith' -%}
{%- comment %}</locksmith:43db>{% endcomment -%}

<!doctype html>
<html class="no-js" lang="{{ request.locale.iso_code }}">
  <head>
    {{ locksmith_initializations }}
    <!-- Added by AVADA SEO Suite -->
    {% include 'avada-seo' %}
    <!-- /Added by AVADA SEO Suite -->
    <meta charset="UTF-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="theme-color" content="">

    <meta name="google-site-verification" content="QAHzuWy3bIL62MBNFLrAzixxySaSlFK7uUlExojatug">

    <link rel="canonical" href="{{ canonical_url }}">
    <link rel="preconnect" href="https://cdn.shopify.com" crossorigin>

    {%- if settings.favicon != blank -%}
      <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 32, height: 32 }}">
    {%- endif -%}

    <script type="speculationrules">
      {
        "prefetch": [
          {
            "urls": [
              "{{ routes.cart_url }}",
              "{{ routes.root_url }}collections/all",
              "{{ routes.root_url }}collections/bestsellers"
            ]
          }
        ]
      }
    </script>

    <title>
      {{ page_title }}
      {%- if current_tags %} &ndash; tagged "{{ current_tags | join: ', ' }}"{% endif -%}
      {%- if current_page != 1 %} &ndash; Page {{ current_page }}{% endif -%}
      {%- unless page_title contains shop.name %} &ndash; {{ shop.name }}{% endunless -%}
    </title>

    {% if page_description %}
      {%- comment %}<locksmith:b0b3>{% endcomment -%}
        {%- capture var %}{% render 'locksmith-variables', variable: 'transparent', hiding_scope: 'resource' %}{% endcapture %}{% if var == 'true' %}<meta name="description" content="{{ page_description | escape }}">{% endif -%}
        {%- comment %}original: <meta name="description" content="{{ page_description | escape }}">{%- endcomment %}
      {%- comment %}</locksmith:b0b3>{% endcomment -%}
    {% endif %}

    {% render 'on-cart-visit' %}

    {% render 'meta-tags' %}

    {{ content_for_header }}

    {% render 'hreflangs' %}

    {% render 'third-party-scripts' %}

    {% render 'define-theme' %}

    {% render 'css-variables' %}

    {% comment %}
      This is just to make sure that the locksmith password styling is nicer than the base.
    {% endcomment %}
    {% if collection.handle == 'pre-launch-access-to-new-products' or collection.handle == 'sven-test-collection' %}
      {{ 'locksmith-custom.css' | asset_url | stylesheet_tag }}
    {% endif %}

    {{ 'parcel_style.css' | asset_url | stylesheet_tag }}

    {{ settings.head_scripts }}

    <script>
      document.documentElement.className = document.documentElement.className.replace('no-js', 'js');
    </script>

    {% if template.name contains 'collection' and collection.handle == 'sucettes' %}
      {% if request.locale.iso_code == 'fr' %}
        <meta name="robots" content="index, follow">
        <link rel="alternate" hreflang="fr-fr" href="https://bibsworld.com/fr-fr/collections/sucettes">
        <link rel="alternate" hreflang="x-default" href="https://bibsworld.com/fr-fr/collections/sucettes">
      {% else %}
        <meta name="robots" content="noindex, nofollow">
      {% endif %}
    {% endif %}
  </head>
  {% liquid
    assign is_subscription_template = false
    if template.name == 'collection' and template.suffix == 'subscription'
      assign is_subscription_template = true
    endif
  %}
  <body class="{% if is_subscription_template %}template-collection-subscription{% endif %}">
    {% sections 'header-group' %}
    <main
      id="main"
      class="min-h-[80vh] relative {% if template.name == 'product' %} product-template{% endif %}"
      role="main"
      tabindex="-1"
    >
      {% render 'breadcrumbs' %}
      {% render 'language-checker' %}

      {{ content_for_layout }}

      {%- if template.name == 'product' -%}
        {% render 'product-schema-markup',
          product: product,
          current_variant: product.selected_or_first_available_variant
        %}
      {%- endif -%}
    </main>
    {% sections 'footer-group' %}

    {% comment %} Tracking {% endcomment %}
    {% render 'tracking-cart' %}
    {% if template.name == 'product' %}
      {% render 'tracking-product' %}
    {% elsif template.name == 'collection' %}
      {% render 'tracking-collection' %}
    {% endif %}
    {% comment %} End Tracking {% endcomment %}
    {% if settings.enable_quick_view %}
      {% render 'product-drawer' %}
    {% endif %}
    <div class="bottom-right-wrapper">
      {% if template.name != 'product' %}
        {% render 'back-to-top' %}
      {% endif %}
    </div>
    {{ settings.footer_scripts }}
    {% render 'third-party-scripts-body' %}
    
    <script src="{{ 'parcel_scripts.js' | asset_url }}" defer></script>
  </body>
</html>
