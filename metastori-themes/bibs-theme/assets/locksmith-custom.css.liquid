:root {
	--main-bg: #f4f6f5;
	--x-color-primary-action: #ac979c;
	--x-color-primary-action-hovered: #987b82;
	--x-color-primary-action-text: #ffffff;
	--x-color-primary-action-text-hovered: var(--x-color-primary-action-text);
	--p-button-font-weight: 700;
	--x-color-interactive-text: #5a5257;
	--x-color-interactive-text-hovered: #423b3f;
	--p-border-critical: #860001;
	--p-icon-critical: #860001;
	--p-text-critical: #860001;
	--p-text: #000000;
	--p-text-subdued: #000000a8;
	--p-text-subdued-200: #00000033;
	--p-border: #dedede;
	--p-border-neutral-subdued: var(--p-border);
	--p-border-radius-base: 8px;
	--p-border-radius-wide: 12px;
	--p-ease: cubic-bezier(0.4, 0.22, 0.28, 1);
}

#locksmith-content {
  height: 80svh;
  display: flex;
  align-items: center;
}

.locksmith-passcode-container {
	margin: 0;
	width: 100%;
	text-align: center;
	padding: 1.3125rem 1.3125rem 0;
	max-width: 29.75rem;
	display: -webkit-box;
	display: -webkit-flex;
	display: -ms-flexbox;
	display: flex;
	-webkit-box-orient: vertical;
	-webkit-box-direction: normal;
	-webkit-flex-direction: column;
	-ms-flex-direction: column;
	flex-direction: column;
	-webkit-box-pack: center;
	-webkit-justify-content: center;
	-ms-flex-pack: center;
	justify-content: center;
	z-index: 1;
	max-width: 29.75rem !important;
	width: 95%;
	-webkit-box-sizing: border-box;
	box-sizing: border-box;
	background: white;
	border-radius: 12px;
	margin-top: 2vw;
	margin-bottom: 2vw;
}

label[for='locksmith_passcode'] {
	margin-bottom: 1.313rem;
	color: var(--p-text-subdued);
	display: flex;
	align-items: flex-start;
}

.locksmith-passcode {
	min-width: 75px;
	vertical-align: baseline;
	margin: 0;
	-webkit-appearance: none;
	-moz-appearance: none;
	appearance: none;
	outline: none;
	padding: 0.84375rem 0.6875rem;
	border-radius: var(--p-border-radius-base);
	font-weight: 400;
	line-height: 1;
	text-transform: initial;
	letter-spacing: initial;
	-webkit-box-sizing: border-box;
	box-sizing: border-box;
	display: block;
	width: 100%;
	color: var(--p-text);
	border: 1px solid var(--p-border-neutral-subdued);
	border-top-color: var(--p-border);
	background-color: var(--p-surface);
	--p-surface: #fff;
	--p-surface-critical-subdued: var(--p-surface);
	--p-border-radius-base: 8px;
	border-color: var(--p-border);
	font-size: 0.875rem;
    height: 40px;
}

.locksmith-passcode:focus {
	border-color: var(--x-color-interactive-text);
	box-shadow: 0 0 0 0.0625rem var(--x-color-interactive-text);
	transition: box-shadow 100ms var(--p-ease), -webkit-box-shadow 100ms var(--p-ease);
}

#locksmith_passcode_submit {
	color: var(--x-color-primary-action-text);
	background-color: var(--x-color-primary-action);
	border: none;
	border-color: #ac979c;
	font-family: inherit;
	text-transform: none;
	letter-spacing: normal;
	--p-border-radius-base: 8px;
	margin: 1.3125rem 0;
	--x-duration-base: 200ms;
	--x-timing-base: ease-in-out;
	transition: background-color var(--x-duration-base) var(--x-timing-base), color var(--x-duration-base) var(--x-timing-base), box-shadow var(--x-duration-base) var(--x-timing-base);
	text-align: center;
	text-overflow: ellipsis;
	margin: 0.9375rem 0;
	padding: 0.875rem;
	font-size: 1.0625rem;
	line-height: 1.25rem;
	min-height: 2.75rem;
	display: inline-block;
	height: auto;
	cursor: pointer;
	border-radius: var(--p-border-radius-base);
    width: 100%;
}
