{
  "name": "bibs-theme",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "watch": "vite build --watch",
    "build": "vite build --minify",
    "shopify": "cross-var shopify theme dev -s=$npm_config_env",
    "dev": "shopify theme dev --store=bibsworld-store",
    "dev:us": "shopify theme dev --store=bibsworld-store-us",
    "pull": "shopify theme pull --store=bibsworld-store --only=*/*.json -t=160033898824",
    "dev:latest": "shopify theme pull --live --only=*/*.json --ignore=locales/*.json --store=bibsworld-store && shopify theme metafields pull --store=bibsworld-store && shopify theme dev --store=bibsworld-store"
  },
  "author": "BlackLemon and Sven Ingar Frantzen",
  "dependencies": {
    "@popperjs/core": "^2.11.8"
  },
  "devDependencies": {
    "@shopify/cli": "^3.74.1",
    "cross-var": "^1.1.0",
    "cssnano": "^5.1.15",
    "eslint": "^8.44.0",
    "postcss": "^8.4.23",
    "prettier": "^3.0.0",
    "sass-embedded": "^1.99.0",
    "tailwindcss": "^3.3.2",
    "vite": "^8.0.7"
  }
}
