        "repair_tab_cpwhPn": {
          "type": "_repair_tab",
          "name": "Repair Tab",
          "settings": {
            "title": "What is Not Covered",
            "description": "<p>Our warranty is designed to cover manufacturing defects.<br/><br/>Examples of non manufacturing defects:<br/>- normal wear and tear<br/>- minor abrasions<br/>- scratches<br/>- fading<br/>- cracked suitcases<br/>- broken wheels<br/>- chainsaw inflicted damage.<br/><br/><strong>Products not covered by warranty:<br/></strong>- <a href=\"/collections/clothing\" title=\"Clothing\">Golden Sample Clothing</a>.<br/>- <a href=\"/collections/archive-collection\" title=\"Archive Collection\">Archive Collection</a>.</p>",
