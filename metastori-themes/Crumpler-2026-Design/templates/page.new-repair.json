          "name": "Repair Tab",
          "settings": {
            "title": "What's Covered",
            "description": "<p>We fully cover any manufacturing defects for free, if we determine it’s a manufacturing issue, the repair is on us.<br/><br/>Examples include:<br/>- Hardware failing or breaking unexpectedly.<br/>- Stitching coming undone prematurely.<br/>- Zippers that stop working due to a manufacturing issue.<br/>- Fabric or straps failing in a way they shouldn't.<br/><br/>Please note that this warranty does not apply to Crumpler products purchased in Europe, Africa, or South America.</p>",
            "media_type": "video",
            "video": "shopify://files/videos/repair cropped.mp4"
