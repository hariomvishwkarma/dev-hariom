    "nature_strip_z69YVw": {
      "type": "nature-strip",
      "name": "t:sections.custom-liquid.presets.name",
      "settings": {
        "custom_liquid": "{% comment %}\n  KONBU® range — landing section\n  Paste into a \"Custom Liquid\" section. Classes are konbu- prefixed\n  to avoid theme conflicts. Images hosted at cdn.crumpler.com/konbu-range/\n{% endcomment %}\n\n<style>\n  .konbu-page, .konbu-page * { margin: 0; padding: 0; box-sizing: border-box; }\n\n  .konbu-page {\n    position: relative;\n    width: 100%;\n    overflow: clip;\n    background: #fff;\n  }\n  .konbu-page img { max-width: none; }\n\n  /* ---------- Header: pinned at top, content scrolls over it ---------- */\n  .konbu-header {\n    position: sticky;\n    top: 0;\n    z-index: 1;                   /* under the images */\n    text-align: center;\n  }\n\n  .konbu-logo { display: block; width: 40.5%; margin: 0 auto; }  /* matches hero width/margins */\n  .konbu-logo img { width: 100%; display: block; }\n\n  .konbu-intro { display: block; width: 30%; margin: 1.25vw auto 0; padding: 0.6vw 0; }\n  .konbu-intro img { width: 100%; display: block; }\n\n  /* ---------- Pinned \"Overly Sweet\" captions ---------- */\n  .konbu-sweet-zone { position: relative; }\n\n  /* CTA button — sized to match the sweet texts at each breakpoint */\n  .konbu-cta {\n    display: block;\n    width: max(11.3%, 230px);     /* 28% of the 40.5% hero frame, 230px floor */\n    margin: 0 auto;\n    padding: 4vw 0;\n  }\n  .konbu-cta img { width: 100%; display: block; }\n\n  .konbu-pin {\n    position: sticky;\n    top: 2vh;\n    height: 0;\n    z-index: 9;\n    pointer-events: none;\n  }\n\n  .konbu-text-frame {\n    position: relative;\n    margin-left: 29.75%;\n    width: 40.5%;\n    aspect-ratio: 585 / 922;      /* matches the hero frame */\n  }\n  .konbu-sweet { position: absolute; display: block; }\n  .konbu-sweet img { width: 100%; display: block; }\n  /* 230px floor stops them getting too small on mid-size screens */\n  .konbu-sweet-a { top: min(17.8vw, 26vh); right: 2%;  width: max(28%, 230px); }\n  .konbu-sweet-b { top: min(41.7vw, 58vh); right: -6%; width: max(28%, 230px); }\n  .konbu-sweet-c { top: min(51.5vw, 78vh); left: 3.5%; width: max(28%, 230px); }\n\n  /* ---------- Hero ---------- */\n  .konbu-hero-frame {\n    position: relative;\n    z-index: 2;                   /* scrolls over the pinned header */\n    margin-left: 29.75%;          /* centered */\n    width: 40.5%;\n    aspect-ratio: 585 / 922;\n  }\n  .konbu-hero-frame img {\n    width: 100%; height: 100%;\n    object-fit: cover;\n    display: block;\n  }\n\n  /* ---------- Scrolling content ---------- */\n  .konbu-flow { position: relative; z-index: 2; margin-top: 14.1vw; }\n\n  .konbu-img-block img {\n    width: 100%; height: 100%;\n    object-fit: cover;\n    display: block;\n  }\n\n  .konbu-row-two { display: flex; align-items: flex-start; }\n  .konbu-pouch { margin-left: 12.4%; width: 26.8%; aspect-ratio: 880 / 592; }\n  .konbu-white-jacket { margin-left: 13%; width: 26.8%; aspect-ratio: 390 / 763; }\n\n  .konbu-meditate { margin-top: 17.8vw; width: 100%; aspect-ratio: 1440 / 901; }\n\n  .konbu-red-jacket {\n    margin-top: 14.1vw;\n    margin-left: 39%;\n    width: 22%;\n    aspect-ratio: 631 / 1000;     /* natural image ratio — no visible crop */\n  }\n\n  /* ---------- Tablet / small desktop ---------- */\n  @media (min-width: 769px) and (max-width: 1180px) {\n    .konbu-logo { width: 55%; }   /* matches tablet hero */\n    .konbu-intro { width: 42%; }\n\n    .konbu-hero-frame, .konbu-text-frame {\n      margin-left: 22.5%;\n      width: 55%;\n    }\n    .konbu-sweet-a { top: min(24.1vw, 26vh); }\n    .konbu-sweet-b { top: min(56.5vw, 58vh); }\n    .konbu-sweet-c { top: min(69.9vw, 78vh); }\n\n    .konbu-pouch { margin-left: 8%; width: 36%; }\n    .konbu-white-jacket { margin-left: 10%; width: 36%; }\n    .konbu-red-jacket { margin-left: 23%; width: 54%; }\n    .konbu-cta { width: max(15.4%, 230px); }  /* 28% of the 55% hero frame, 230px floor */\n  }\n\n  /* ---------- Mobile ---------- */\n  @media (max-width: 768px) {\n    .konbu-header { position: static; }   /* heading + subtext scroll normally on mobile */\n    .konbu-logo { width: 86%; }   /* matches mobile hero margins */\n    .konbu-intro { width: 84%; margin-top: 1.5vw; padding: 4vw 0; }\n\n    .konbu-hero-frame, .konbu-text-frame {\n      margin-left: 7%;\n      width: 86%;\n    }\n    .konbu-sweet-a { top: min(37.7vw, 26vh); width: 53%; }\n    .konbu-sweet-b { top: min(88.4vw, 58vh); width: 53%; }\n    .konbu-sweet-c { top: min(109.3vw, 78vh); width: 53%; }\n\n    .konbu-flow { margin-top: 18vw; }\n\n    .konbu-row-two { flex-direction: column; }\n    .konbu-pouch { margin-left: 7%; width: 62%; }\n    .konbu-white-jacket { margin-left: 31%; margin-top: 14vw; width: 62%; }\n\n    .konbu-meditate { margin-top: 20vw; }\n    .konbu-red-jacket { margin-top: 20vw; margin-left: 15%; width: 70%; }\n    .konbu-cta { width: 45.6%; padding: 8vw 0; }  /* 53% of the 86% hero frame */\n  }\n</style>\n\n<div class=\"konbu-page\">\n\n  <div class=\"konbu-header\">\n    <span class=\"konbu-logo\">\n      <img src=\"https://cdn.crumpler.com/konbu-range/konbu-heading.png\" alt=\"KONBU® range\" loading=\"eager\">\n    </span>\n    <span class=\"konbu-intro\">\n      <picture>\n        <source media=\"(max-width: 768px)\" srcset=\"https://cdn.crumpler.com/konbu-range/subtext-mobile.png\">\n        <img src=\"https://cdn.crumpler.com/konbu-range/subtext.png\" alt=\"KONBU® is a Japanese-made fabric characterised by its dry, compact feel. Named after a type of seaweed, it is made from 100% recycled nylon.\" loading=\"eager\">\n      </picture>\n    </span>\n  </div>\n\n  <div class=\"konbu-sweet-zone\">\n\n    <!-- pinned captions: stick on scroll, release at the end of the section -->\n    <div class=\"konbu-pin\">\n      <div class=\"konbu-text-frame\">\n        <span class=\"konbu-sweet konbu-sweet-a\"><img src=\"https://cdn.crumpler.com/konbu-range/SweetText.png\" alt=\"Overly Sweet\"></span>\n        <span class=\"konbu-sweet konbu-sweet-b\"><img src=\"https://cdn.crumpler.com/konbu-range/SweetText.png\" alt=\"Overly Sweet\"></span>\n        <span class=\"konbu-sweet konbu-sweet-c\"><img src=\"https://cdn.crumpler.com/konbu-range/SweetText.png\" alt=\"Overly Sweet\"></span>\n      </div>\n    </div>\n\n    <div class=\"konbu-hero-frame\">\n      <img src=\"https://cdn.crumpler.com/konbu-range/hero.jpg\" alt=\"Model crouching with light blue KONBU messenger bag\">\n    </div>\n\n    <div class=\"konbu-flow\">\n      <div class=\"konbu-row-two\">\n        <div class=\"konbu-img-block konbu-pouch\">\n          <img src=\"https://cdn.crumpler.com/konbu-range/wallet.jpg\" alt=\"Hand holding light blue KONBU pouch\" loading=\"lazy\">\n        </div>\n        <div class=\"konbu-img-block konbu-white-jacket\">\n          <img src=\"https://cdn.crumpler.com/konbu-range/blur.jpg\" alt=\"Model in white jacket with blue crossbody KONBU bag\" loading=\"lazy\">\n        </div>\n      </div>\n\n      <div class=\"konbu-img-block konbu-meditate\">\n        <img src=\"https://cdn.crumpler.com/konbu-range/crosslegged.jpg\" alt=\"Model meditating with green KONBU backpack\" loading=\"lazy\">\n      </div>\n\n      <div class=\"konbu-img-block konbu-red-jacket\">\n        <img src=\"https://cdn.crumpler.com/konbu-range/red-jacket.jpg\" alt=\"Model in red jacket with dark green KONBU bag\" width=\"1262\" height=\"2000\" loading=\"lazy\">\n      </div>\n\n      <a class=\"konbu-cta\" href=\"https://www.crumpler.com/collections/konbu\">\n        <img src=\"https://cdn.crumpler.com/konbu-range/View-the-collection.png\" alt=\"View the collection\" loading=\"lazy\">\n      </a>\n    </div>\n\n  </div>\n\n</div>",
        "color_scheme": "",
        "padding_top": 40,
        "padding_bottom": 100
      }
