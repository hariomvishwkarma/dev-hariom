    "custom_liquid_4b7g9k": {
      "type": "custom-liquid",
      "disabled": true,
      "name": "stretch",
      "settings": {
        "custom_liquid": "<div class=\"wrap\">\n  <div class=\"pin\">\n    <img class=\"pin-left\" src=\"https://cdn.shopify.com/s/files/1/0565/5114/5551/files/hand.png?v=1772070846\" alt=\"\">\n    <img class=\"pin-right\" src=\"https://cdn.shopify.com/s/files/1/0565/5114/5551/files/putty4.png?v=1772070845\" alt=\"\">\n  </div>\n</div>\n\n<style>\n  .wrap {\n    height: 50vh;\n    display: flex;\n    justify-content: left;\n    align-items: left;\n    overflow: hidden;\n  }\n\n  .pin {\n    width: 540px;\n    height: auto;\n  }\n\n  .pin img {\n    width: 540px;\n    display: block;\n    position: absolute;\n    top: 20%;\n    left: 0;\n  }\n\n  :root { --anchor: 50%px; }\n\n\n  .pin-left {\n    position: relative; \n    clip-path: inset(0 calc(100% - var(--anchor)) 0 0);\nz-index: 99;\npointer-events: none;\n\n  }\n\n  .pin-right {\n    clip-path: inset(0 0 0 var(--anchor));\n    transform-origin: var(--anchor) 50%;\n    will-change: transform;\ncursor: pointer;\n\n  }\n</style>\n\n<script>\n  const rightImg = document.querySelector(\".pin-right\");\n\n  let running = false;\n  let lastTime = null;\n  let progress = 0;\n\n  const maxWidthPx = 4200;  // pick your max\n  const duration = 10000;\n\n  function easeOutCubic(t) {\n  return 1 - Math.pow(1 - t, 3);\n}\n\n  function animate(t) {\n    if (!running) return;\n\n    if (lastTime === null) lastTime = t;\n    const dt = t - lastTime;\n    lastTime = t;\n\n    progress = Math.min(1, progress + dt / duration);\n    const eased = easeOutCubic(progress);\n\n    const baseWidth = 2000;                 // same as CSS width\n    const maxScale = maxWidthPx / baseWidth;\n    const scaleX = 1 + (maxScale - 1) * eased;\n\n    rightImg.style.transform = `scaleX(${scaleX})`;\n\n    if (progress < 1) requestAnimationFrame(animate);\n    else running = false;\n  }\n\n  document.querySelector(\".pin\").addEventListener(\"click\", () => {\n    running = !running;\n    if (running) {\n      lastTime = null;\n      requestAnimationFrame(animate);\n    }\n  });\n</script>",
        "color_scheme": "",
        "padding_top": 40,
        "padding_bottom": 52
      }
    },
