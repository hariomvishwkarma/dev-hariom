    "custom_liquid_B9LyVK": {
      "type": "custom-liquid",
      "disabled": true,
      "name": "mim block",
      "settings": {
        "custom_liquid": "<div class=\"hero-container\">\n\n    <!-- STICKER -->\n    <img \n        id=\"sticker\"\n        class=\"sticker\" \n        src=\"https://cdn.shopify.com/s/files/1/0565/5114/5551/files/sticker.png?v=1778569106\"\n    >\n\n    <!-- HEADING -->\n    <img \n        class=\"headingtext\" \n        src=\"https://cdn.shopify.com/s/files/1/0565/5114/5551/files/mimtext.png?v=1778566838\"\n    >\n\n    <!-- DESKTOP VIDEO -->\n    \n<video id=\"desktopVideo\" class=\"topvideo desktop-video\" autoplay muted loop playsinline>\n        <source src=\"https://stream.mux.com/YLtnylX4hanlAa3tiXbuO3TOm6amjc01za4qXjBb8Cj8.m3u8\">\n    </video>\n\n    <!-- MOBILE VIDEO -->\n    <div class=\"mobile-video-wrap\">\n\n        <video id=\"mobileVideo\" class=\"mobile-video\" autoplay muted loop playsinline>\n            <source src=\"https://cdn.shopify.com/videos/c/o/v/45333a1312204f968356b4e44f2005a7.mp4\" type=\"video/mp4\">\n        </video>\n\n        <button class=\"mobile-close\" id=\"mobileClose\">(CLOSE)</button>\n\n    </div>\n\n    <!-- COPY -->\n    <div class=\"copytext\">\n        Bags cut and sewn in our <a class=\"mw\" href=\"https://www.crumpler.com/collections/made-in-melbourne\">Melbourne Workshop</a> (AKA Bag House). Each bag comes with a custom badge that is hand-numbered and dated. The workshop currently makes 4 messenger bags in different sizes: CD1, BARNEY, CAHOOT and TEENIE WEENIE - with colours and styles changing each month.\n    </div>\n\n</div>\n\n<style>\n\n.hero-container {\n    width: 100%;\n    min-height: 120vh;\n    position: relative;\n    background-color: #BC6926;\n    overflow: hidden;\n}\n\n.mw {\ntext-decoration: underline;\ncolor: black;\n}\n\n/* STICKER */\n\n.sticker {\n    position: absolute;\n    top: 460px;\n    left: 60%;\n    width: 6%;\n    max-width: 90px;\n    z-index: 2;\n    transform: rotate(-0.05turn);\n    cursor: grab;\n    user-select: none;\n    touch-action: none;\n}\n\n.sticker:active {\n    cursor: grabbing;\n}\n\n/* HEADING */\n\n.headingtext {\n    position: absolute;\n    top: 40px;\n    padding: 0 10px;\n    left: 50%;\n    width: 95%;\n    transform: translateX(-50%);\n    z-index: 1;\n    box-sizing: border-box;\n}\n\n/* VIDEO */\n\n.topvideo {\n    position: absolute;\n    left: 50%;\n    transform: translateX(-50%);\n    display: block;\n    z-index: 99;\n    cursor: pointer;\n    transition: opacity 0.4s ease;\n}\n\n.topvideo.hide {\n    opacity: 0;\n    pointer-events: none;\n}\n\n.desktop-video {\n    top: 100px;\n    width: 95%;\n    max-height: calc(100vh - 180px);\n    object-fit: contain;\n}\n\n/* MOBILE VIDEO WRAP */\n\n.mobile-video-wrap {\n    display: none;\n}\n\n/* COPY */\n\n.copytext {\n    position: absolute;\n    bottom: 20px;\n    left: 0;\n    width: 100%;\n    font-size: 32px;\n    line-height: 1.30;\n    text-align: left;\n    padding: 0 40px;\n    box-sizing: border-box;\n    z-index: 0;\n}\n\n/* MOBILE */\n\n@media screen and (max-width: 768px) {\n\n    .hero-container {\n        min-height: 750px;\n    }\n\n    .headingtext {\n        top: 35px;\n    }\n\n    .copytext {\n        bottom: 20px;\n        font-size: 20px;\n        padding: 0 16px;\n    }\n\n    .desktop-video {\n        display: none;\n    }\n\n    .mobile-video-wrap {\n        display: block;\n        position: absolute;\n        top: 25px;\n        left: 50%;\n        width: 90%;\n        transform: translateX(-50%);\n        z-index: 110;\n    }\n\n    .mobile-video {\n        display: block;\n        width: 100%;\n        height: auto;\n        max-height: 570px;\n        object-fit: contain;\n    }\n\n    .mobile-close {\n        position: absolute;\n        top: 10px;\n        right: 10px;\n        z-index: 999;\n        background: none;\n        border: none;\n        color: white;\n        font-size: 12px;\n        cursor: pointer;\n        padding: 0;\n        filter: drop-shadow(0 0 0.35rem black);\n    }\n\n    .sticker {\n        top: 150px;\n        width: 13%;\n    }\n}\n\n</style>\n\n<script>\n\ndocument.addEventListener('DOMContentLoaded', function() {\n\n    /* VIDEO CONTROLS */\n\n    const desktopVideo = document.getElementById('desktopVideo');\n    const mobileClose = document.getElementById('mobileClose');\n    const mobileWrap = document.querySelector('.mobile-video-wrap');\n\n    function closeDesktopVideo() {\n\n        desktopVideo.classList.add('hide');\n\n        setTimeout(function() {\n            desktopVideo.style.display = 'none';\n        }, 400);\n    }\n\n    function closeMobileVideo() {\n\n        mobileWrap.style.opacity = '0';\n        mobileWrap.style.transition = 'opacity 0.4s ease';\n\n        setTimeout(function() {\n            mobileWrap.style.display = 'none';\n        }, 400);\n    }\n\n    if (desktopVideo) {\n        desktopVideo.addEventListener('click', closeDesktopVideo);\n    }\n\n    if (mobileClose) {\n        mobileClose.addEventListener('click', closeMobileVideo);\n    }\n\n    /* DRAGGABLE STICKER */\n\n    const container = document.querySelector(\".hero-container\");\n    const sticker = document.getElementById(\"sticker\");\n\n    let active = null;\n    let shiftX = 0;\n    let shiftY = 0;\n\n    if (container && sticker) {\n\n        sticker.addEventListener(\"mousedown\", function(e) {\n\n            e.preventDefault();\n\n            startDrag(e.clientX, e.clientY);\n\n            document.addEventListener(\"mousemove\", onMouseMove);\n            document.addEventListener(\"mouseup\", onMouseUp);\n        });\n\n        sticker.addEventListener(\"touchstart\", function(e) {\n\n            if (e.touches.length > 1) return;\n\n            const touch = e.touches[0];\n\n            startDrag(touch.clientX, touch.clientY);\n\n            document.addEventListener(\"touchmove\", onTouchMove, { passive: false });\n            document.addEventListener(\"touchend\", onTouchEnd);\n        });\n\n        function startDrag(clientX, clientY) {\n\n            active = sticker;\n\n            const rect = sticker.getBoundingClientRect();\n\n            shiftX = clientX - rect.left;\n            shiftY = clientY - rect.top;\n\n            sticker.style.cursor = \"grabbing\";\n        }\n\n        function onMouseMove(e) {\n\n            e.preventDefault();\n\n            updatePosition(e.clientX, e.clientY);\n        }\n\n        function onTouchMove(e) {\n\n            if (!active) return;\n            if (e.touches.length > 1) return;\n\n            const touch = e.touches[0];\n\n            e.preventDefault();\n\n            updatePosition(touch.clientX, touch.clientY);\n        }\n\n        function updatePosition(clientX, clientY) {\n\n            if (!active) return;\n\n            const containerRect = container.getBoundingClientRect();\n            const containerWidth = containerRect.width;\n            const containerHeight = containerRect.height;\n\n            let x = clientX - containerRect.left - shiftX;\n            let y = clientY - containerRect.top - shiftY;\n\n            let leftPercent = (x / containerWidth) * 100;\n            let topPercent = (y / containerHeight) * 100;\n\n            leftPercent = Math.max(0, Math.min(100, leftPercent));\n            topPercent = Math.max(0, Math.min(100, topPercent));\n\n            active.style.left = leftPercent + \"%\";\n            active.style.top = topPercent + \"%\";\n            active.style.transform = \"rotate(-0.05turn)\";\n        }\n\n        function onMouseUp() {\n\n            if (active) {\n                active.style.cursor = \"grab\";\n                active = null;\n            }\n\n            document.removeEventListener(\"mousemove\", onMouseMove);\n            document.removeEventListener(\"mouseup\", onMouseUp);\n        }\n\n        function onTouchEnd() {\n\n            if (active) {\n                active.style.cursor = \"grab\";\n                active = null;\n            }\n\n            document.removeEventListener(\"touchmove\", onTouchMove);\n            document.removeEventListener(\"touchend\", onTouchEnd);\n        }\n    }\n\n});\n\n</script>",
        "color_scheme": "",
        "padding_top": 20,
        "padding_bottom": 0
      }
