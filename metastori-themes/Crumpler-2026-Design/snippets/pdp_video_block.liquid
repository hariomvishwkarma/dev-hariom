{% assign mux_pid = block.settings.mux_playback_id | strip %}
{% assign video_file = block.settings.video_file %}
{% assign use_mux = false %}
{% if mux_pid != blank %}
    {% assign use_mux = true %}
{% endif %}

{% comment %} {% if mux_pid != blank or video_file != blank %} {% endcomment %}
    {% style %}
        @media (min-width: 1025px) {
            #{{ block.id }}{
                min-height: {{ block.settings.section_height -}}{{- block.settings.size_unit -}};
            }
            #{{ block.id }} video, #{{ block.id }} mux-player{
                max-width: {{ block.settings.section_width -}}{{- block.settings.width_unit -}};
            }
        }
        #{{ block.id }} mux-player {
            display: block;
            width: 100%;
            --media-object-fit: cover;
            --media-object-position: center;
        }

        @media (max-width: 768px) {
            #{{ block.id }}{
                min-height: {{ block.settings.section_height_m -}}{{- block.settings.size_unit_m -}};
            }
            #{{ block.id }} video{
                max-width: {{ block.settings.section_width_m -}}{{- block.settings.width_unit_m -}};
                {% if block.settings.video_style == true %}
                object-fit: cover;
                {% endif %}
            }
            #{{ block.id }} mux-player {
                max-width: 100%;
                width: 100%;
                aspect-ratio: 531 / 625;
                height: auto;
                min-height: 0;
            }
        }
    {% endstyle %}

    <div class="custom-3d-video-right{% if use_mux %} pdp-mux-player-block{% endif %}" id="{{ block.id }}" 
        style="background: {{ block.settings.background_color }};{% if hide_mux %} display: none;{% endif %}">
        {% if use_mux %}
            <mux-player
                class="{{ video_t }}"
                playback-id="{% if variant_mux_pid != blank %}{{ variant_mux_pid | escape }}{% else %}{{ mux_pid | escape }}{% endif %}"
                {% if product.title != blank %}metadata-video-title="{{ product.title | escape }}"{% endif %}
                muted
                {% if block.settings.mux_autoplay %}autoplay="any"{% endif %}
                {% if block.settings.mux_loop %}loop{% endif %}
                playsinline
                preload="auto"
                no-muted-pref
                style="--media-object-fit: cover; --media-object-position: center;{% if block.settings.mux_hide_controls %} --controls: none;{% endif %}"
            ></mux-player>
        {% elsif video_file != blank %}
            {{ video_file | video_tag:autoplay:block.settings.mux_autoplay, loop:block.settings.mux_loop, muted:true }}
        {% endif %}
        {% if block.settings.popup_detail != blank %}
            <div class="popup-box">
                <button class="popup-btn" style="width: 19px;">?</button>
                <div class="value">{{ block.settings.popup_detail | strip_html }}</div>
            </div>
        {% endif %}
    </div>
{% comment %} {%endif %} {% endcomment %}