{%- if search.filters != empty and search.results.size > 0 -%}
    {%- if section.settings.enable_filtering or section.settings.enable_sorting -%}
    {% comment %} <aside
        aria-labelledby="verticalTitle"
        class="facets-wrapper{% unless section.settings.enable_filtering %} facets-wrapper--no-filters{% endunless %}{% if section.settings.filter_type != 'vertical' %} page-width{% endif %}"
        id="main-search-filters"
        data-id="{{ section.id }}"
    >
        {% render 'facets',
        results: search,
        enable_filtering: section.settings.enable_filtering,
        enable_sorting: section.settings.enable_sorting,
        filter_type: section.settings.filter_type,
        paginate: paginate
        %}
    </aside> {% endcomment %}
    {% style %}
    #main-collection-filters *{
    font-size: 13px;
    }
    #ProductGridContainer #product-grid{
    max-width: none;
    padding: 0px 12px;
    margin: 0;
    }
    .filter-seperation {
        display: inline-flex;
        width: 12px;
    }
    .cst-filter-panel-Colour {
        line-height: 100%;
    }
    #main-collection-filters {
    padding: 0 18px;
    }
    .cst-filter.js-filter {
        display: flex;
        gap:3px 8px;
        margin-right:13px;
        flex-wrap:wrap;
    }
    .cst-filters-row {
        display: flex;
        flex-wrap:wrap;
        row-gap: 5px;
    }
    .filter-seperator {
        margin-left: -3px;
    }
    button.cst-filter-label span.cst-values, .filter_sort_selector{
        margin-right:5px;
        text-decoration:underline;
    }
    button.cst-filter-label span.cst-values, .cst-filter-label[filter_name="price"]{
        display:none;
    }
    .filter_sort_selector {
        border: none;
        appearance: none;
        -webkit-appearance: none;
        -moz-appearance: none;
        font-weight: 500;
        text-transform: capitalize;
        font-family: "Neue Haas Grotesk Text Pro";
    }
    button.cst-filter-label {
        background: white;
        border: none;
        font-family: "Neue Haas Grotesk Text Pro";
        font-weight: 500;
        line-height: calc(1 + 0.15 / var(--font-body-scale));
        text-transform: capitalize;
        display: inline-flex;
        padding:0;
        gap:4px;
        align-items: center;
        margin-right:13px;
    }
    button.cst-filter-label[aria-expanded="true"] {
        margin-right: 6px;
    }
    button.cst-filter-label.cst-sort-label{
        margin-right:0px;

    }
    button.cst-filter-label .icon{
        display: flex;
        line-height: 0;
    }
    ul.cst-filter-list {
        list-style: none;
        padding: 0;
        margin: 0;
        display: flex;
        gap: 0 7px;
        flex-wrap:wrap;
    }
    .cst-filters-row input:not(.price_range_filter) {
        display: none;
    }
    .cst-price-range-row {
        display: flex;
        align-items: center;
        gap: 3px;
    }

    .price_range_filter{
        min-width: 45.83px;
        border: 1px solid #606060;
        border-radius: 2px;
        background: #F1F1F1;
        text-align: center;
        font-family: "Neue Haas Grotesk Text Pro";
        text-transform: lowercase;
        height: 18.2px;
    }
    .price_range_filter::placeholder{
        color:#979797;
    }

    .price_range_filter::-webkit-outer-spin-button,
    .price_range_filter::-webkit-inner-spin-button {
        -webkit-appearance: none;
        margin: 0;
    }

    #main-collection-filters b {
        font-weight: 700;
        display:flex;
        letter-spacing: 0%;
        text-transform: capitalize;
        align-items: center;
        gap: 0px;
    }
    #main-collection-filters .cst-filters-container{
        display: flex;
        gap: 7px;
        align-items: baseline;
    }
    #main-collection-filters .cst-product-count  {
        color:#C4C4C4;
        font-weight: 700;
        letter-spacing: 0%;
        text-transform: capitalize;
        margin-top: 7px !important;
    }
    #main-collection-filters .cst-clear-btn.mobile,
    #main-collection-filters .cst-product-count.mobile   {
        display:none;
    }
    #main-collection-filters .cst-clear-btn  {
        background: #EEEEEE;
        width: 91px;
        height: 21px;
        top: 93px;
        left: 18px;
        opacity: 1;
        border-radius: 7px;
        border-width: 1px;
        outline: none;
        margin-top: 20px;
        border: 1px solid;
        font-weight: 600;
        font-family: var(--font-body-family);
    }
    #main-collection-filters .cst-sort-radio-item input[type="radio"]  {
        display:none;
    }
    #main-collection-filters .cst-sort-radio-list {
        display: flex;
        flex-wrap: wrap;
        gap: 9px;
        margin-left:5px;
    }
    #main-collection-filters .cst-sort-radio-list .checked{
        text-decoration:underline;
    }
    #main-collection-filters  span.filter-lable {
        white-space:nowrap;
    }
    #main-collection-filters  .cst-sort-radio-item input[type="radio"]:checked + span {
        text-decoration: underline;

    }
    #main-collection-filters  label.cst-checkbox.checked span {
        text-decoration: underline;
    }
    .cst-checkbox-label:hover {
        text-decoration: underline;
    }
    #main-collection-filters  .mobile-icon{
        display:none;
    }

    #main-collection-filters .cst-filters-row .fillter--close
        {
        display:none;
        }



        #main-collection-filters .cst-filter.js-filter.cst-sort-filter, #main-collection-filters div#ProductCount{
        margin-top:2px;
        }


        button.cst-filter-label[aria-expanded="false"] ~ label{
        display:none;
        }

        button.cst-filter-label[aria-expanded="true"] ~ label {
        display:inline-block;
        }
        .filter-top-text {
            font-weight: 600;
            text-transform: capitalize;
            margin-bottom: 2px;
        }
    @media screen and (max-width: 1024px) {
        #main-collection-filters *{
        font-size:26px;
        color:#000;
        }
        #main-collection-filters .cst-filters-container,
        .cst-filters-row ,
        .cst-filter.js-filter.cst-sort-filter,
        #main-collection-filters .cst-sort-radio-list{
        flex-direction:column;
        }
        #main-collection-filters .cst-sort-radio-list{
        gap:0;
        }
        #main-collection-filters .cst-clear-btn {
        height: auto;
        width: auto;
        min-width: 143px;
        min-height: 33px;
        font-size: 20.52px;
        border: 1.58px solid #000000;
        }
        #main-collection-filters  .mobile-icon{
        display:inline;
        }
        #main-collection-filters  .cst-filters-row {
            display: inline-block;
            line-height:36px;
        }
        #main-collection-filters .cst-filters-container{
        gap:0;
        }

        #main-collection-filters .cst-filters-row{
            top: 0;
            right: 0;
            left: auto;
            position: fixed;
            z-index: 100;
            background: white;
            transform: translateX(100%);
            transition: transform 200ms ease;
            width:100%;
            /* width: 400px; */
            height: 100vh;
            padding: 9px 12px;
            }

        #main-collection-filters .cst-filters-row .fillter--close
        {
        display:inline-block;
        }
        #main-collection-filters .cst-filters-row.open{
        transform: translateX(0px);
        overflow: auto;
        }
        /* Close right-to-left: drawer slides out to the left */
        #main-collection-filters .cst-filters-row.open.closing{
        transform: translateX(-100%);
        }
        button.cst-filter-label[aria-expanded="false"] {
        width: 100%;
        }
        #main-collection-filters .cst-clear-btn.mobile,
        #main-collection-filters .cst-product-count.mobile   {
            display:block;
        }
        #main-collection-filters .cst-clear-btn.dectop{
        display:none;
        }
        .price_range_filter{
            height: 32.4px;
        }
        .price_range_submit {
            height: 32.4px;
            min-width: 45.83px;
        }
    }
    @media screen and (max-width: 750px) {
        #main-collection-filters .cst-filters-row{
            width: 100%;
        }
        #main-collection-filters {
            padding: 0 12px;
        }
        .filter_sort_selector{
            width:55%;
        }
        .price_range_filter::placeholder{
            font-size: 24px !important;
        }
    }
{% endstyle %}
{%- liquid
    assign sort_by = search.sort_by | default: search.default_sort_by
    assign total_active_values = 0
    assign default_presentation = 'text'
    if search.url
        assign results_url = search.url
    else
        assign terms = search.terms | escape
        assign results_url = 'search?q=' | append: terms | append: '&options%5Bprefix%5D=last&sort_by=' | append: sort_by
    endif
    -%}
    <aside id="main-collection-filters" class="cst-facets-wrapper" data-section-id="{{ section.id }}">
    <form id="CSTFacetForm" class="cst-facet-form" action="{{ results_url }}" method="get" novalidate>
    <!-- FILTERS (horizontal style) -->
    {% if section.settings.filter_text != blank %}
        <div class="filter-top-text">{{ section.settings.filter_text }}</div>
    {% endif %}
    <div class="cst-filters-container">
        <b>
            filter <span class="mobile-icon">+</span>
            <span class="mobile-icon-open" style="display:none;">-</span>
        </b>
        <div class="cst-filters-row">
                <div class="mobile-filter-header">
                  <div class="mobile-filter-menu">
                    <span class="fillter--menubtn">MENU</span>
                    <span class="fillter--close">CLOSE X</span>
                  </div>
                </div>
        {%- for filter in search.filters -%}
            {% style %}
            button.cst-filter-label[data-filter-name="{{ filter.param_name }}"][aria-expanded="false"] ~ label[data-filter-name="{{ filter.param_name }}"]{
                display:none;

            }
            button.cst-filter-label[data-filter-name="{{ filter.param_name }}"][aria-expanded="true"] ~ label[data-filter-name="{{ filter.param_name }}"]{
                /* display:inline-block; */
                display: inline-flex;
                align-items: center;
            }
            {% endstyle %}
            <button
            type="button"
            class="cst-filter-label"
            data-filter-name="{{ filter.param_name }}"
            aria-expanded="false"
            aria-controls="panel-{{ forloop.index }}"
            filter_name="{{ filter.label | handleize }}"
            {% if filter.label == 'Price' %}filter_toggle_disabled{% endif %}
            >
            <span>
                {{ filter.label }}
            </span>
            {% if filter.active_values.size > 0 %}
                <span class="filter-seperator">:</span>
                <div class="cst-values">
                {% for v in filter.active_values -%}
                    <span class="filter-lable" style="color:{{- v.label | downcase }};">
                    {{- v.label -}}
                    </span>
                    <span> </span>
                    {%- unless forloop.last %}, {% endunless -%}
                {%- endfor %}
                </div>
            {% endif %}
            <span class="icon"> &gt;</span>
            </button>

            {% case filter.type %}
            {% when 'list' %}
                {% for val in filter.values %}
                <label
                    data-filter-name="{{ filter.param_name }}"
                    class="
                    cst-checkbox {% if val.active %}
                        checked
                    {% endif %}
                    "
                >
                    <input
                    type="checkbox"
                    name="{{ val.param_name }}"
                    value="{{ val.value }}"
                    {% if val.active %}
                        {% assign show_Cout_filter = true %}
                        checked
                    {% endif %}
                    data-count="{{ val.count }}"
                    >

                    {% assign val_color = val.label | strip | downcase %}
                    {% for color_item in all_colors %}
                    {% assign parts = color_item | split: ':' %}
                    {% assign color_name = parts.first | strip | downcase %}
                    {% assign color_hex = parts.last | strip %}
                    {% if color_name == val_color %}
                        {% assign val_color = color_hex %}
                    {% endif %}
                    {% endfor %}

                    <span class="cst-checkbox-label" style="color:{{ val_color }};">
                    {{- val.label -}}
                    </span>
                    {%- unless forloop.last -%},{% endunless %}&nbsp;
                    {% if forloop.last %}
                    <span class="filter-seperation"></span>
                    {% endif %}
                </label>
                {% endfor %}

            {% when 'price_range' %}
                {% assign currency_symbol = shop.money_format | replace: '{{amount}}', '' | strip %}

                <div class="cst-price-range-row" data-filter-name="{{ filter.param_name }}">
                <div class="cst-price-range-label">{{ filter.label }}:</div>
                <label>
                    {% comment %} {{ currency_symbol }} {% endcomment %}
                    <input
                    type="number"
                    name="{{ filter.min_value.param_name }}"
                    placeholder="FROM"
                    value="{% if filter.min_value.value %}{{ filter.min_value.value | divided_by: 100 }}{% endif %}"
                    min="0"
                    max="{{ filter.range_max | divided_by: 100 }}"
                    class="price_range_filter"
                    >
                </label>
                {% comment %} <span class="cst-price-sep">—</span> {% endcomment %}
                <label>
                    {% comment %} {{ currency_symbol }} {% endcomment %}
                    <input
                    type="number"
                    name="{{filter.max_value.param_name}}"
                    placeholder="TO"
                    value="{% if filter.max_value.value %}{{ filter.max_value.value | divided_by: 100 }}{% endif %}"
                    min="0"
                    max="{{ filter.range_max | divided_by: 100 }}"
                    class="price_range_filter"
                    >
                </label>
                </div>

            {% else %}

            {% endcase %}
            {% comment %} </div> {% endcomment %}
        {%- endfor -%}

        {% if show_Cout_filter %}
            <div id="ProductCount" class="cst-product-count mobile">{{ search.results_count }} Products</div>
        {% endif %}

        <button type="button" id="CSTClearFilters" class="cst-clear-btn mobile">Clear Filters</button>
        </div>
    </div>

    <!-- SORT BY -->
    <div class="cst-filter js-filter cst-sort-filter" data-filter-name="sort_by">
        <button
        type="button"
        class="cst-filter-label cst-sort-label"
        aria-expanded="false"
        aria-controls="panel-sort"
        >
        <b>Sort By:</b>
        <span class="cst-values">
            {{- search.sort_by | default: search.default_sort_by | capitalize -}}
        </span>
        <select class="filter_sort_selector" name="sort_by">
            {% for option in search.sort_options %}
            <option data-value="{{ option.value  }}" value="{{ option.value }}"
                {% if option.value == search.sort_by %}
                selected
                {% endif %}
            >{{ option.name }}</option>
            {% endfor %}  
        </select>
        </button>

        {% comment %} {% for option in search.sort_options %}
        <label class="cst-sort-radio-item">
            <input
            type="radio"
            name="sort_by"
            data-value="{{ option.value  }}"
            value="{{ option.value }}"
            {% if option.value == search.sort_by %}
                checked
            {% endif %}
            >
            <span>{{ option.name }}</span>
        </label>
        {% endfor %} {% endcomment %}
    </div>

    <!-- BOTTOM: count + clear -->
    <div class="cst-bottom-row">
        
        <div id="ProductCount" class="cst-product-count decstop">{{ search.results.size }} Products</div>
        

        <button type="button" id="CSTClearFilters" class="cst-clear-btn dectop">Clear Filters</button>
    </div>
    <!-- .cst-filters-row -->
    </form>
</aside>
    {%- endif -%}
{%- endif -%}