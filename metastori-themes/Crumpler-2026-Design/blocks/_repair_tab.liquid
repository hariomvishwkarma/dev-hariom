<div class="cst-tab">
    {% if block.settings.title != blank %}
        <div class="cst-tab-title" data-target-panel="{{ block.id | handle }}">{{ block.settings.title }}</div>
        <div class="cst-tab-content" data-panel-id="{{ block.id | handle }}">
            {% if block.settings.description != blank %}
                <div class="cst-tab-text">{{ block.settings.description }}</div>
            {% endif %}
            {% if block.settings.media_type == 'video' or block.settings.media_type == 'image' %}
                <div class="cst-tab-media">
                    {% if block.settings.media_type == 'video' %}
                        {{ block.settings.video | video_tag:autoplay:true, loop:true, controls:false }}
                    {% else %}  
                        <img src="{{ block.settings.image | image_url }}" width="auto" height="auto" alt="">
                    {% endif %}
                </div>
            {% endif %}
            {% content_for 'blocks' %}
        </div>
    {% endif %}
</div>

{% schema %}
{
    "name": "Repair Tab",
    "tag":null,
    "class": "cst-tab",
    "settings": [
        {
            "type": "text",
            "id": "title",
            "label": "Title"
        },
        {
            "type":"richtext",
            "label": "description",
            "id": "description"
        },
        {
            "type": "select",
            "id": "media_type",
            "label": "media type",
            "options": [
                {
                    "label": "Video",
                    "value": "video"
                },
                {
                    "label": "Image",
                    "value": "image"
                },
            ],
            "default":"video"
        },
        {
            "type": "video",
            "id": "video",
            "label": "Video",
            "visible_if": "{{ block.settings.media_type == 'video' }}"
        },
        {
            "type": "image_picker",
            "id": "image",
            "label": "Image",
            "visible_if": "{{ block.settings.media_type == 'image' }}"
        }
    ],
    "blocks": [
        {
            "type": "_accordion"
        }
    ],
    "presets": [
        {
            "name": "Repair Tab"
        }
    ]
}
{% endschema %}