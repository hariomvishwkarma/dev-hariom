<hc-accordion
  class="store-page__store"
  data-block-id="{{ block.id }}"
  no-arrow
>
  <h2
    class="store__page_heading store-page__store-name c-h3 {% if block.settings.details == blank %}store-page__store-name--disabled{% endif %}"
    style="cursor: pointer;"
    slot="header"
  >
    {{ block.settings.name }}
  </h2>
  <div class="store_para__page store-page__store-details c-mono c-uppercase" slot="content">
    {{ block.settings.details }}
    <span class="store-page__store-details__media-label">
      (<button class="c-link-button c-mono c-uppercase store-page__store-details__media-button">
        {{ block.settings.view_media }}</button
      >)
    </span>
    {% if block.settings.image != blank %}
     <div class="mobile-store-image">
      <img src="{{ block.settings.image | image_url }}" height="auto" width="auto">
    </div>
    {% endif %}
  </div>
</hc-accordion>

<div class="iframe_data" style="display:none;">
          <div
            slot="store"
            class="store-page__map__store"
            data-block-id="{{ block.id }}"
          >
            {% comment %}{{ block.settings.map_animation | video_tag: image_size: '1100x', loop: false, controls: false, muted: true }}{% endcomment %}
            {{ block.settings.iframe }}
          </div>
          <div
            slot="store-details"
            class="store-page__map-store-details"
            style="
              {% if block.settings.use_desktop_height %}
                --desktop-height: {{ block.settings.desktop_height }}%;
              {% endif %}
              {% if block.settings.use_desktop_width %}
                --desktop-width: {{ block.settings.desktop_width }}%;
              {% endif %}
              {% if block.settings.use_mobile_height %}
                --mobile-height: {{ block.settings.mobile_height }}%;
              {% endif %}
              {% if block.settings.use_mobile_width %}
                --mobile-width: {{ block.settings.mobile_width }}%;
              {% endif %}
            "
            data-block-id="details-{{ block.id}}"
          >
            {% if block.settings.video != blank %}
              {{ block.settings.video | video_tag: image_size: '1100x', loop: false, controls: false, muted: true }}
            {% elsif block.settings.image != blank %}
              {%- assign widths = '165, 360, 535, 750, 1070, 1500' -%}
              {%- capture sizes -%}
                      (min-width: {{ settings.page_width }}px) {{ settings.page_width | minus: 100 | divided_by: 2 }}px,
                      (min-width: 750px) calc((100vw - 130px) / 2), calc((100vw - 50px) / 2)
          {%- endcapture -%}
              {{ block.settings.image | image_url: width: 1500 | image_tag: sizes: sizes, widths: widths }}
            {% else %}
              {{ 'collection-1' | placeholder_svg_tag }}
            {% endif %}
          </div>
</div>


{% schema %}
  {
    "name": "Store",
    "settings": [
      {
        "id": "name",
        "type": "text",
        "label": "Store Name"
      },
      {
        "id": "details",
        "type": "richtext",
        "label": "Store Details"
      },
      {
        "id": "view_media",
        "type": "text",
        "label": "View Media Label",
        "default": "See the store"
      },
      {
        "id": "image",
        "type": "image_picker",
        "label": "Store Image"
      },
      {
        "id": "video",
        "type": "video",
        "label": "Store Video"
      },
      {
        "id": "iframe",
        "type": "html",
        "label": "Store Map Iframe"
      }
    ],
    "presets": [
      {
        "name": "Store"
      }
    ]
  }
{% endschema %}