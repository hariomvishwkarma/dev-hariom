{% doc %}
  @prompt
    a section to display an uploaded image, accepting different images for mobile and desktop. full width for both. allow setting a link for the image
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-responsive-image-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    position: relative;
  }

  .ai-responsive-image-wrapper-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    position: relative;
  }

  .ai-responsive-image-link-{{ ai_gen_id }} {
    display: block;
    width: 100%;
  }

  .ai-responsive-image-desktop-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    height: auto;
  }

  .ai-responsive-image-mobile-{{ ai_gen_id }} {
    display: none;
    width: 100%;
    height: auto;
  }

  .ai-responsive-image-placeholder-{{ ai_gen_id }} {
    background-color: #f4f4f4;
    width: 100%;
    min-height: 400px;
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
  }

  .ai-responsive-image-placeholder-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
    max-width: 500px;
    max-height: 500px;
  }

  .ai-responsive-image-empty-state-{{ ai_gen_id }} {
    position: absolute;
    bottom: 20px;
    left: 50%;
    transform: translateX(-50%);
    padding: 12px 20px;
    font-size: 14px;
    color: #666;
    text-align: center;
    pointer-events: none;
  }

  @media screen and (max-width: 749px) {
    .ai-responsive-image-desktop-{{ ai_gen_id }} {
      display: none;
    }

    .ai-responsive-image-mobile-{{ ai_gen_id }} {
      display: block;
    }

    .ai-responsive-image-placeholder-{{ ai_gen_id }} {
      min-height: 300px;
    }
  }
{% endstyle %}

<div class="ai-responsive-image-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  {% if block.settings.image_link != blank %}
    <a href="{{ block.settings.image_link }}" class="ai-responsive-image-link-{{ ai_gen_id }}">
      <div class="ai-responsive-image-wrapper-{{ ai_gen_id }}">
        {% if block.settings.desktop_image %}
          <img
            src="{{ block.settings.desktop_image | image_url: width: 2000 }}"
            srcset="{{ block.settings.desktop_image | image_url: width: 600 }} 600w,
                    {{ block.settings.desktop_image | image_url: width: 1000 }} 1000w,
                    {{ block.settings.desktop_image | image_url: width: 1400 }} 1400w,
                    {{ block.settings.desktop_image | image_url: width: 2000 }} 2000w"
            sizes="100vw"
            alt="{{ block.settings.desktop_image.alt | escape }}"
            loading="lazy"
            width="{{ block.settings.desktop_image.width }}"
            height="{{ block.settings.desktop_image.height }}"
            class="ai-responsive-image-desktop-{{ ai_gen_id }}"
          >
        {% else %}
          <div class="ai-responsive-image-placeholder-{{ ai_gen_id }}">
            {{ 'image' | placeholder_svg_tag }}
            <div class="ai-responsive-image-empty-state-{{ ai_gen_id }}">
              Add a desktop image
            </div>
          </div>
        {% endif %}

        {% if block.settings.mobile_image %}
          <img
            src="{{ block.settings.mobile_image | image_url: width: 800 }}"
            srcset="{{ block.settings.mobile_image | image_url: width: 400 }} 400w,
                    {{ block.settings.mobile_image | image_url: width: 600 }} 600w,
                    {{ block.settings.mobile_image | image_url: width: 800 }} 800w"
            sizes="100vw"
            alt="{{ block.settings.mobile_image.alt | escape }}"
            loading="lazy"
            width="{{ block.settings.mobile_image.width }}"
            height="{{ block.settings.mobile_image.height }}"
            class="ai-responsive-image-mobile-{{ ai_gen_id }}"
          >
        {% elsif block.settings.desktop_image %}
          <img
            src="{{ block.settings.desktop_image | image_url: width: 800 }}"
            srcset="{{ block.settings.desktop_image | image_url: width: 400 }} 400w,
                    {{ block.settings.desktop_image | image_url: width: 600 }} 600w,
                    {{ block.settings.desktop_image | image_url: width: 800 }} 800w"
            sizes="100vw"
            alt="{{ block.settings.desktop_image.alt | escape }}"
            loading="lazy"
            width="{{ block.settings.desktop_image.width }}"
            height="{{ block.settings.desktop_image.height }}"
            class="ai-responsive-image-mobile-{{ ai_gen_id }}"
          >
        {% else %}
          <div class="ai-responsive-image-placeholder-{{ ai_gen_id }}">
            {{ 'image' | placeholder_svg_tag }}
            <div class="ai-responsive-image-empty-state-{{ ai_gen_id }}">
              Add a mobile image
            </div>
          </div>
        {% endif %}
      </div>
    </a>
  {% else %}
    <div class="ai-responsive-image-wrapper-{{ ai_gen_id }}">
      {% if block.settings.desktop_image %}
        <img
          src="{{ block.settings.desktop_image | image_url: width: 2000 }}"
          srcset="{{ block.settings.desktop_image | image_url: width: 600 }} 600w,
                  {{ block.settings.desktop_image | image_url: width: 1000 }} 1000w,
                  {{ block.settings.desktop_image | image_url: width: 1400 }} 1400w,
                  {{ block.settings.desktop_image | image_url: width: 2000 }} 2000w"
          sizes="100vw"
          alt="{{ block.settings.desktop_image.alt | escape }}"
          loading="lazy"
          width="{{ block.settings.desktop_image.width }}"
          height="{{ block.settings.desktop_image.height }}"
          class="ai-responsive-image-desktop-{{ ai_gen_id }}"
        >
      {% else %}
        <div class="ai-responsive-image-placeholder-{{ ai_gen_id }}">
          {{ 'image' | placeholder_svg_tag }}
          <div class="ai-responsive-image-empty-state-{{ ai_gen_id }}">
            Add a desktop image
          </div>
        </div>
      {% endif %}

      {% if block.settings.mobile_image %}
        <img
          src="{{ block.settings.mobile_image | image_url: width: 800 }}"
          srcset="{{ block.settings.mobile_image | image_url: width: 400 }} 400w,
                  {{ block.settings.mobile_image | image_url: width: 600 }} 600w,
                  {{ block.settings.mobile_image | image_url: width: 800 }} 800w"
          sizes="100vw"
          alt="{{ block.settings.mobile_image.alt | escape }}"
          loading="lazy"
          width="{{ block.settings.mobile_image.width }}"
          height="{{ block.settings.mobile_image.height }}"
          class="ai-responsive-image-mobile-{{ ai_gen_id }}"
        >
      {% elsif block.settings.desktop_image %}
        <img
          src="{{ block.settings.desktop_image | image_url: width: 800 }}"
          srcset="{{ block.settings.desktop_image | image_url: width: 400 }} 400w,
                  {{ block.settings.desktop_image | image_url: width: 600 }} 600w,
                  {{ block.settings.desktop_image | image_url: width: 800 }} 800w"
          sizes="100vw"
          alt="{{ block.settings.desktop_image.alt | escape }}"
          loading="lazy"
          width="{{ block.settings.desktop_image.width }}"
          height="{{ block.settings.desktop_image.height }}"
          class="ai-responsive-image-mobile-{{ ai_gen_id }}"
        >
      {% else %}
        <div class="ai-responsive-image-placeholder-{{ ai_gen_id }}">
          {{ 'image' | placeholder_svg_tag }}
          <div class="ai-responsive-image-empty-state-{{ ai_gen_id }}">
            Add a mobile image
          </div>
        </div>
      {% endif %}
    </div>
  {% endif %}
</div>

{% schema %}
{
  "name": "Responsive image",
  "tag": null,
  "settings": [
    {
      "type": "header",
      "content": "Images"
    },
    {
      "type": "image_picker",
      "id": "desktop_image",
      "label": "Desktop image"
    },
    {
      "type": "image_picker",
      "id": "mobile_image",
      "label": "Mobile image"
    },
    {
      "type": "paragraph",
      "content": "If no mobile image is selected, the desktop image will be used on mobile devices."
    },
    {
      "type": "header",
      "content": "Link"
    },
    {
      "type": "url",
      "id": "image_link",
      "label": "Image link"
    }
  ],
  "presets": [
    {
      "name": "Responsive image"
    }
  ]
}
{% endschema %}
