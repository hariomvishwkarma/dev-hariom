<div class="store__page_heading_main">
<h2
    class="store__page_heading_h2 store__page_heading store-page__store-name c-h3 {% if block.settings.details == blank %}store-page__store-name--disabled{% endif %}"
    style="cursor: pointer;"
  >
    {{ block.settings.name }} 
  <span class="toggle_icon">
    <svg class="toggle_icon_before" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 16 16" fill="none">
      <line x1="7.73333" y1="16" x2="7.73332" y2="3.49691e-08" stroke="black" stroke-width="1.6"/>
      <line y1="7.73336" x2="16" y2="7.73336" stroke="black" stroke-width="1.6"/>
    </svg>
    <svg class="toggle_icon_after" xmlns="http://www.w3.org/2000/svg" width="16" height="3" viewBox="0 0 16 3" fill="none">
    <line y1="1.73336" x2="16" y2="1.73336" stroke="black" stroke-width="1.6"/>
    </svg>
  </span>
</h2>
  <div class="tab_store_para__page store_para__page c-mono ">
    <div class="stockist_block_content">{{ block.settings.details }}</div>
    {% content_for 'blocks' %}
    {% comment %}
      <span class="store-page__store-details__media-label">
        (<button class="c-link-button c-mono c-uppercase store-page__store-details__media-button">
          {{ block.settings.view_media }}</button
        >)
      </span>
    {% endcomment %}
  </div>
</div>

{% schema %}
  {
    "name": "Stockist Block",
    "settings": [
      {
        "type": "text",
        "id":"name",
        "label":"Stockist Name"
      },
      {
        "id": "details",
        "type": "richtext",
        "label": "Store Details"
      }
    ],
    "blocks":[
      {
        "type": "_store-block"
      }
    ],
    "presets": [
      {
        "name": "Stockist Block"
      }
    ]
  }
{% endschema %}