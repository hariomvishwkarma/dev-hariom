{% doc %}
  @prompt
    a tumblr style index page with random size images and random number of columns for each row
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-tumblr-grid-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    padding: {{ block.settings.section_padding }}px 0;
  }

  .ai-tumblr-grid__container-{{ ai_gen_id }} {
    max-width: {{ block.settings.max_width }}px;
    margin: 0 auto;
    padding: 0 20px;
  }

  .ai-tumblr-grid__row-{{ ai_gen_id }} {
    display: flex;
    gap: {{ block.settings.gap }}px;
    margin-bottom: {{ block.settings.gap }}px;
    width: 100%;
  }

  .ai-tumblr-grid__item-{{ ai_gen_id }} {
    flex: 1;
    min-width: 0;
    position: relative;
    overflow: hidden;
    border-radius: {{ block.settings.border_radius }}px;
    background-color: {{ block.settings.placeholder_bg }};
  }

  .ai-tumblr-grid__item-{{ ai_gen_id }} img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .ai-tumblr-grid__placeholder-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    background-color: {{ block.settings.placeholder_bg }};
  }

  .ai-tumblr-grid__placeholder-{{ ai_gen_id }} svg {
    width: 60%;
    height: 60%;
    opacity: 0.3;
  }

  .ai-tumblr-grid__empty-state-{{ ai_gen_id }} {
    text-align: center;
    padding: 60px 20px;
    color: #666;
  }

  .ai-tumblr-grid__empty-state-{{ ai_gen_id }} h3 {
    font-size: 24px;
    margin-bottom: 12px;
    color: #333;
  }

  .ai-tumblr-grid__empty-state-{{ ai_gen_id }} p {
    font-size: 16px;
    margin: 0;
  }

  @media screen and (max-width: 749px) {
    .ai-tumblr-grid__row-{{ ai_gen_id }} {
      flex-direction: column;
    }

    .ai-tumblr-grid__item-{{ ai_gen_id }} {
      width: 100% !important;
      height: auto !important;
      aspect-ratio: 1 / 1;
    }
  }
{% endstyle %}

<tumblr-grid-{{ ai_gen_id }} class="ai-tumblr-grid-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-tumblr-grid__container-{{ ai_gen_id }}">
    {% liquid
      assign has_images = false
      for i in (1..12)
        assign image_key = 'image_' | append: i
        if block.settings[image_key] != blank
          assign has_images = true
          break
        endif
      endfor
    %}

    {% if has_images %}
      <div class="ai-tumblr-grid__content-{{ ai_gen_id }}"></div>
    {% else %}
      <div class="ai-tumblr-grid__empty-state-{{ ai_gen_id }}">
        <h3>Create your Tumblr-style gallery</h3>
        <p>Add images to see them arranged in a dynamic masonry layout</p>
      </div>
    {% endif %}
  </div>
</tumblr-grid-{{ ai_gen_id }}>

<script>
  (function() {
    class TumblrGrid{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
        this.images = [
          {% for i in (1..12) %}
            {% assign image_key = 'image_' | append: i %}
            {% if block.settings[image_key] != blank %}
              {
                url: "{{ block.settings[image_key] | image_url: width: 1200 }}",
                alt: "{{ block.settings[image_key].alt | escape }}",
                width: {{ block.settings[image_key].width }},
                height: {{ block.settings[image_key].height }}
              }{% unless forloop.last %},{% endunless %}
            {% endif %}
          {% endfor %}
        ];
        this.gap = {{ block.settings.gap }};
      }

      connectedCallback() {
        if (this.images.length > 0) {
          this.renderGrid();
        }
      }

      renderGrid() {
        const container = this.querySelector('.ai-tumblr-grid__content-{{ ai_gen_id }}');
        if (!container) return;

        const layouts = [
          [1],
          [2],
          [3],
          [1, 2],
          [2, 1],
          [1, 1, 1],
          [2, 2],
          [1, 3],
          [3, 1],
          [2, 1, 1],
          [1, 2, 1],
          [1, 1, 2]
        ];

        const sizeVariants = [
          { width: 1, height: 1 },
          { width: 2, height: 1 },
          { width: 1, height: 2 },
          { width: 2, height: 2 },
          { width: 1, height: 1.5 },
          { width: 1.5, height: 1 }
        ];

        let imageIndex = 0;
        let html = '';

        while (imageIndex < this.images.length) {
          const layout = layouts[Math.floor(Math.random() * layouts.length)];
          const rowHtml = this.createRow(layout, imageIndex, sizeVariants);
          
          if (rowHtml) {
            html += rowHtml;
            imageIndex += layout.reduce((sum, cols) => sum + cols, 0);
          } else {
            break;
          }
        }

        container.innerHTML = html;
      }

      createRow(layout, startIndex, sizeVariants) {
        let rowHtml = '';
        let currentIndex = startIndex;

        for (let cols of layout) {
          rowHtml += '<div class="ai-tumblr-grid__row-{{ ai_gen_id }}">';
          
          for (let i = 0; i < cols; i++) {
            if (currentIndex >= this.images.length) {
              return null;
            }

            const image = this.images[currentIndex];
            const size = sizeVariants[Math.floor(Math.random() * sizeVariants.length)];
            const baseSize = 300;
            const width = baseSize * size.width;
            const height = baseSize * size.height;

            rowHtml += `
              <div class="ai-tumblr-grid__item-{{ ai_gen_id }}" style="flex: ${size.width}; height: ${height}px;">
                ${image.url ? 
                  `<img src="${image.url}" alt="${image.alt}" loading="lazy" width="${image.width}" height="${image.height}">` :
                  `<div class="ai-tumblr-grid__placeholder-{{ ai_gen_id }}">${'{{ "image" | placeholder_svg_tag }}'}</div>`
                }
              </div>
            `;
            
            currentIndex++;
          }
          
          rowHtml += '</div>';
        }

        return rowHtml;
      }
    }

    customElements.define('tumblr-grid-{{ ai_gen_id }}', TumblrGrid{{ ai_gen_id }});
  })();
</script>

{% schema %}
{
  "name": "Tumblr grid",
  "tag": null,
  "settings": [
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "max_width",
      "min": 800,
      "max": 1600,
      "step": 100,
      "unit": "px",
      "label": "Maximum width",
      "default": 1200
    },
    {
      "type": "range",
      "id": "gap",
      "min": 0,
      "max": 40,
      "step": 4,
      "unit": "px",
      "label": "Gap between images",
      "default": 8
    },
    {
      "type": "range",
      "id": "section_padding",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Section padding",
      "default": 40
    },
    {
