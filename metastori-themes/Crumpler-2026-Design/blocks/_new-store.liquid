<li class="cst-store-block cst-accordion-next">
    <div class="cst-store-name cst-accordion-title">{{ block.settings.name }}</div>
    <div class="cst-accordion-content">
        <div class="cst-store-desc">
            {{ block.settings.desc }}
        </div>
        <div class="cst-store-images">
            <div class="swiper">
                <div class="swiper-wrapper">
                    {% content_for 'blocks' %}
                </div>
                <div class="swiper-scrollbar"></div>
            </div>
        </div>
    </div>
</li>

{% schema %}
{
    "name": "Store",
    "tag": null,
    "class": "cst-store-block",
    "settings": [
        {
            "type": "text",
            "id": "name",
            "label": "Store Name"
        },
        {
            "type": "richtext",
            "id": "desc",
            "label": "Store Description"
        }
    ],
    "blocks": [
        {
            "type": "_new-image-block"
        }
    ],
    "presets": [
        {
            "name": "Store"
        }
    ]
}
{% endschema %}