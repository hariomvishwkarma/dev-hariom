<style>
.{{ section.id }} .ibs-paginationdot-item {
    width: 8.55px;
    height: 8.55px;
    border: 1.22px solid #000;
    display: block;
    border-radius: 50px;
}
.{{ section.id }} .ibs-paginationdot-item.active {
    background: #000;
}
.{{ section.id }} .ibs-pagination-dots {
    display: flex;
    gap: 4px;
    align-items: center;
}
.{{ section.id }} .image-block-slider-wrapper {
    display: flex;
    justify-content: space-between;
    padding-bottom: {{section.settings.padding_bottom}}px;
    padding-top: {{section.settings.padding_top}}px;
}
.{{ section.id }} .ibs-media{
    display: flex;
    width: 100%;
}
.{{ section.id }} .ibs-media img, .{{ section.id }} .ibs-media video {
    width: 100%;
    object-fit: cover;
    height:auto;
}
.{{ section.id }} .ibs-heading{
    font-family: "Neue Haas Grotesk Text Pro";
    font-weight: 700;
}
.{{ section.id }} .ibs-heading, .{{ section.id }} .ibs-content{
    margin:0;
    color:#000;
    margin-bottom: 5px;
}
.{{ section.id }} .ibs-pagination-item {
    color: #C4C4C4;
    font-size: 13px;
    cursor:pointer;
    margin-right: 3px;
}
.{{ section.id }} .ibs-pagination-item.active {
    color: #000;
    text-underline-offset: 3px;
    text-decoration: underline;
}
@media (min-width:768px){
    .{{ section.id }} .ibs-pagination-dots{
        display:none;
    }
    .{{ section.id }} .ibs-heading{
        font-size:{{ section.settings.heading_size }};
    }
    .{{ section.id }} .ibs-content{
        font-size:{{ section.settings.content_size }};
    }
    .{{ section.id }} .ibs-left {
        width: 45%;
        padding: 18px 0 0 18px;
    }
    .{{ section.id }} .ibs-right {
        width: 46.6%;
        padding: 12px 43px 0 0;
    }
}
@media (max-width:767px){
    .{{ section.id }} .ibs-pagination, .{{ section.id }} .ibs-heading{
        display:none;   
    }
    .{{ section.id }} .ibs-heading{
        font-size:{{ section.settings.heading_size_m }};
    }
    .{{ section.id }} .ibs-content{
        font-size:{{ section.settings.content_size_m }};
    }
    .{{ section.id }} .image-block-slider-wrapper{
        flex-direction: column;
        padding-bottom: {{section.settings.padding_bottom_m}}px;
        padding-top: {{section.settings.padding_top_m}}px;
    }
    .{{ section.id }} .ibs-left {
        padding: 21px 18px 68px;
    }
    .{{ section.id }} .ibs-pagination-dots {
        margin-top: 8px;
    }
    .{{ section.id }} .ibs-right {
        padding: 0 12px;
    }
}
</style>

<div class="image-block-slider-main {{ section.id }}">
    <div class="image-block-slider-wrapper">
        <div class="ibs-left">
            {% if section.settings.heading != blank %}
                <h2 class="ibs-heading">{{ section.settings.heading }}</h2>
            {% endif %}
            {% if section.settings.content != blank %}
                <div class="ibs-content">{{ section.settings.content }}</div>
            {% endif %}
            <div class="ibs-pagination ibs-pagination-{{ section.id }}">
                {% for block in section.blocks %}
                <span class="ibs-pagination-item" data-index="{{ forloop.index0 }}">{{- block.settings.pagination -}}</span>
                {% endfor %}
            </div>
            <div class="ibs-pagination-dots ibs-paginationdots-{{ section.id }}">
                {% for block in section.blocks %}
                <span class="ibs-paginationdot-item" data-index="{{ forloop.index0 }}"></span>
                {% endfor %}
            </div>
        </div>
        <div class="ibs-right">
            <div class="swiper ibs-slider-{{ section.id }}">
                <div class="swiper-wrapper">
                    {% for block in section.blocks %}            
                        <div class="swiper-slide">
                            <div class="ibs-media">
                                {% if block.settings.image != blank %}

                                    {% assign image_height = block.settings.image.width
                                        | divided_by: block.settings.image.aspect_ratio
                                        | round
                                    %}
                                    {{
                                        block.settings.image
                                        | image_url: width: 3840
                                        | image_tag:
                                        width: block.settings.image.width,
                                        height: image_height,
                                        class: 'desktop_img',
                                        sizes: '100vw',
                                        widths: '750, 1100, 1500, 1780, 2000, 3000, 3840',
                                        alt: block.settings.image.alt
                                    }}

                                    {% if block.settings.image_m != blank %}
                                        {% assign mobile_height = block.settings.image_m.width
                                        | divided_by: block.settings.image_m.aspect_ratio
                                        | round
                                        %}

                                        {{
                                        block.settings.image_m
                                        | image_url: width: 750
                                        | image_tag:
                                            width: block.settings.image_m.width,
                                            height: mobile_height,
                                            class: 'mobile_img',
                                            sizes: '100vw',
                                            widths: '320, 375, 414, 550, 750',
                                            alt: block.settings.image_m.alt
                                        }}

                                    {% else %}
                                        {{
                                        block.settings.image
                                        | image_url: width: 750
                                        | image_tag:
                                            width: block.settings.image.width,
                                            height: image_height,
                                            class: 'mobile_img',
                                            sizes: '100vw',
                                            widths: '320, 375, 414, 550, 750',
                                            alt: block.settings.image.alt
                                        }}
                                    {% endif %}

                                {% elsif block.settings.video != blank %}
                                    {{ block.settings.video | video_tag: autoplay:true, muted:true, controls:false, loop:true, class:'desktop_video' }}
                                    {% if block.settings.video_m != blank %}
                                        {{ block.settings.video_m | video_tag: autoplay:true, muted:true, controls:false, loop:true, class:'mobile_video' }}
                                    {% else %}
                                        {{ block.settings.video | video_tag: autoplay:true, muted:true, controls:false, loop:true, class:'mobile_video' }}
                                    {% endif %}
                                {% else %}
                                    {{ 'detailed-apparel-1' | placeholder_svg_tag: 'placeholder-svg' }}
                                {% endif %}
                            </div>
                        </div>
                    {% endfor %}
                </div>
            </div>
        </div>
    </div>
</div>

<script>
document.addEventListener("DOMContentLoaded", function () {
  const swiper = new Swiper(".ibs-slider-{{ section.id }}", {
    loop: true,
    autoHeight: true,
    speed: 500,
    pagination: {
        el: ".ibs-paginationdots-{{ section.id }}", 
        clickable: true,
        bulletClass: "ibs-paginationdot-item", 
        bulletActiveClass: "active",
    }
  });

  const paginationItems = document.querySelectorAll(".ibs-pagination-{{ section.id }} .ibs-pagination-item");


  paginationItems.forEach((item, index) => {
    item.addEventListener("click", () => {
      swiper.slideToLoop(index);
    });
  });

  swiper.on("slideChange", () => {
    const realIndex = swiper.realIndex;
    paginationItems.forEach((el, i) => {
      el.classList.toggle("active", i === realIndex);
    });
  });

  paginationItems[0]?.classList.add("active");
});
</script>

