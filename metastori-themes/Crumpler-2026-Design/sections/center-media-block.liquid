<style>
{% if section.settings.mix_blend %}
    .{{ section.id }} .cmb-media {
        mix-blend-mode: difference;
    }
{% endif %}
    .center-media-block-main{
        display: flex;
        justify-content: center;
    }
    .center-media-block {
        padding: 217px 0 320px;
        max-width:408px;
        width:100%;
    }
    .cmb-media{
        max-width:100%;
        width:100%;
        display: flex;
    }
    .cmb-media img, .cmb-media video{
        max-width:100%;
        width:100%;
        height:auto;
    }
    .cmb-text{
        margin:0;
        text-align:center;
        margin-top: 7px;
    }
    @media (max-width:767px){
        .{{ section.id }} .cmb-text{
            font-size:{{ section.settings.font_size_m }};
        }
        .center-media-block {
            padding: 140px 0 180px;
            max-width: 260px;
            width: 100%;
        }
    }
    @media (min-width:768px){
        .{{ section.id }} .cmb-text{
            font-size:{{ section.settings.font_size }};
        }
    }
</style>

<div class="center-media-block-main {{ section.id }}" style="background:{{ section.settings.bg_color }};">
    <div class="center-media-block">
        <div class="cmb-media">
            {% if section.settings.image != blank %}

                {% assign image_height = section.settings.image.width
                    | divided_by: section.settings.image.aspect_ratio
                    | round
                %}

                {{
                    section.settings.image
                    | image_url: width: 3840
                    | image_tag:
                    width: section.settings.image.width,
                    height: image_height,
                    class: 'desktop_img',
                    sizes: '100vw',
                    widths: '750, 1100, 1500, 1780, 2000, 3000, 3840',
                    alt: section.settings.image.alt
                }}

                {% if section.settings.image_m != blank %}
                    {% assign mobile_height = section.settings.image_m.width
                    | divided_by: section.settings.image_m.aspect_ratio
                    | round
                    %}

                    {{
                    section.settings.image_m
                    | image_url: width: 750
                    | image_tag:
                        width: section.settings.image_m.width,
                        height: mobile_height,
                        class: 'mobile_img',
                        sizes: '100vw',
                        widths: '320, 375, 414, 550, 750',
                        alt: section.settings.image_m.alt
                    }}

                {% else %}
                    {{
                    section.settings.image
                    | image_url: width: 750
                    | image_tag:
                        width: section.settings.image.width,
                        height: image_height,
                        class: 'mobile_img',
                        sizes: '100vw',
                        widths: '320, 375, 414, 550, 750',
                        alt: section.settings.image.alt
                    }}
                {% endif %}

            {% elsif section.settings.video != blank %}
                {{ section.settings.video | video_tag: autoplay:true, muted:true, controls:false, loop:true, class:'desktop_video' }}
                {% if section.settings.video_m != blank %}
                    {{ section.settings.video_m | video_tag: autoplay:true, muted:true, controls:false, loop:true, class:'mobile_video' }}
                {% else %}
                    {{ section.settings.video | video_tag: autoplay:true, muted:true, controls:false, loop:true, class:'mobile_video' }}
                {% endif %}
            {% endif %}
        </div>
        {% if section.settings.text != blank %}
        <div class="cmb-text" style="color:{{ section.settings.text_color }};">
            {{ section.settings.text }}
        </div>
        {% endif %}
    </div>
</div>

{% schema %}
{
  "name": "Center Media Block",
  "tag": "section",
  "class": "section",
  "settings": [
    {
        "type": "color",
        "id":"bg_color",
        "label": "Background"
    },
    {
        "type": "color",
        "id":"text_color",
        "label": "Text",
        "default":"#fff"
    },
    {
        "type": "checkbox",
        "id":"mix_blend",
        "label": "Mix-Blend Effect?"
    },
    {
        "type": "image_picker",
        "id":"image",
        "label": "Image"
    },
    {
        "type": "image_picker",
        "id":"image_m",
        "label": "Image (Mobile)"
    },
    {
        "type": "video",
        "id":"video",
        "label": "Video"
    },
    {
        "type": "video",
        "id":"video_m",
        "label": "Video (Mobile)"
    },
    {
        "type": "textarea",
        "id": "text",
        "label": "Text"
    },
    {
        "type": "select",
        "id": "font_size",
        "label": "Font Size",
        "options": [
            {
                "label": "S",
                "value": "13px"
            },
            {
                "label": "M",
                "value": "26px"
            },
            {
                "label": "L",
                "value": "36px"
            },
            {
                "label": "XL",
                "value": "50px"
            },
            {
                "label": "XXL",
                "value": "134px"
            }
        ],
        "default":"26px"
    },
    {
        "type": "select",
        "id": "font_size_m",
        "label": "Font Size (Mobile)",
        "options": [
            {
                "label": "S",
                "value": "13px"
            },
            {
                "label": "M",
                "value": "26px"
            },
            {
                "label": "L",
                "value": "36px"
            },
            {
                "label": "XL",
                "value": "50px"
            },
            {
                "label": "XXL",
                "value": "134px"
            }
        ],
        "default":"26px"
    }
  ], 
  "presets": [
    {
      "name": "Center Media Block"
    }
  ]
}
{% endschema %}
