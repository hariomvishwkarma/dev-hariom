<style>
  .{{ section.id }} .cfc-product-item-img, .{{ section.id }} .cfc-product-item-img img{
      max-width: 100%;
      width: 100%;
      object-fit:cover;
      height:auto;
  }
  .cfc-product-item-img{
    display:flex;
  }
  .cfc-wrapper a{
      text-decoration:none;
      color:#000;
  }
  .cfc-header-link:hover, .cfc-product-item-title:hover{
      text-decoration:underline;
  }
  .cfc-wrapper {
      padding-left: 16px;
      padding-bottom: 100px;
  }
  .cfc-header {
      padding-left: 10px;
      line-height: 1;
      margin-bottom: 8px;
  }
  .cfc-product-item-content {
    line-height: normal;
    padding-left:10.2px;
    font-weight:600;
    margin-top: 5px;
  }
  .cfc-product-item-title {
      display: block;
      text-transform: uppercase;
  }
  @media (min-width:768px){
      .{{ section.id }} .cfc-header{
          font-size:{{ section.settings.font_size }};
      }
      .{{ section.id }} .cfc-product-item-content{
          font-size:{{ section.settings.product_text }};
      }
  }
  @media (max-width:767px){
      .{{ section.id }} .cfc-header{
          font-size:{{ section.settings.font_size_m }};
      }
      .{{ section.id }} .cfc-product-item-content{
          font-size:{{ section.settings.product_text_m }};
      }
  }
  .custom-feature-collection-main{
      margin-top:{{  section.settings.margin_top }}px;
  }
</style>

<div class="custom-feature-collection-main {{ section.id }}">
