{% schema %}
{
  "name": "Custom Feature Collection",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading"
    },
    {
      "type": "range",
      "id": "margin_top",
      "label": "Spacing From Top",
      "min": 0,
      "max": 50,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "select",
      "id": "font_size",
      "label": "Heading Size",
      "options": [
        {
          "label": "S",
          "value": "13px"
        },
        {
          "label": "M",
          "value": "26px"
        },
        {
          "label": "L",
          "value": "36px"
        },
        {
          "label": "XL",
          "value": "50px"
        },
        {
          "label": "XXL",
          "value": "134px"
        }
      ],
      "default": "26px"
    },
    {
      "type": "select",
      "id": "font_size_m",
      "label": "Heading Size (Mobile)",
      "options": [
        {
          "label": "S",
          "value": "13px"
        },
        {
          "label": "M",
          "value": "26px"
        },
        {
          "label": "L",
          "value": "36px"
        },
        {
          "label": "XL",
          "value": "50px"
        },
        {
          "label": "XXL",
          "value": "134px"
        }
      ],
      "default": "26px"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
