                                {%- if variant[0].featured_media.width >= 533 -%}{{ variant[0].featured_media | image_url: width: 533 }} 533w,{%- endif -%}
                                {%- if variant[0].featured_media.width >= 720 -%}{{ variant[0].featured_media | image_url: width: 720 }} 720w,{%- endif -%}
                                {%- if variant[0].featured_media.width >= 940 -%}{{ variant[0].featured_media | image_url: width: 940 }} 940w,{%- endif -%}
                                {%- if variant[0].featured_media.width >= 1066 -%}{{ variant[0].featured_media | image_url: width: 1066 }} 1066w,{%- endif -%}
                                {%- if variant[0].featured_media.width >= 1550 -%}{{ variant[0].featured_media | image_url: width: 1550 }} 1550w,{%- endif -%}
