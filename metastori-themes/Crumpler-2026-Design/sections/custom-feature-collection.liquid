<script>
(function () {

  function initCfcSwiper(section) {
    const slider = section.querySelector('.cfc-slider-{{ section.id }}');
    if (!slider) return;

    if (slider.swiper) {
      slider.swiper.update();
      slider.swiper.updateAutoHeight(300);
      return;
    }
const isDesktop = window.matchMedia("(min-width: 1024px)").matches;
    new Swiper(slider, {
      loop: false,
      cssMode: isDesktop, 
      autoHeight: true,
      speed: 500,
      spaceBetween: 14,
      slidesPerView: 3.5,

      breakpoints: {
        0: {
          slidesPerView: 1.2,
        },
        768: {
          slidesPerView: 2.5,
        },
        1025: {
          slidesPerView: 3.5,
        },
      },

      observer: true,
      observeParents: true,
      resizeObserver: true,
      updateOnWindowResize: true,

      grabCursor: true,
    });
  }

  document.addEventListener('DOMContentLoaded', function () {
    document.querySelectorAll('.shopify-section').forEach(section => {
      initCfcSwiper(section);
    });
  });

  document.addEventListener('shopify:section:load', function (e) {
    initCfcSwiper(e.target);
  });

  document.addEventListener('shopify:section:unload', function (e) {
    const slider = e.target.querySelector('.cfc-slider-{{ section.id }}');
    if (slider && slider.swiper) {
      slider.swiper.destroy(true, true);
    }
  });

})();
</script>


