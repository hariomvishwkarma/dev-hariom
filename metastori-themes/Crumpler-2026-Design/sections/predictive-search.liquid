{% style %}
  .cst-grid {
    display: grid;
    gap: {{ section.settings.gap }}px;
    grid-template-columns: repeat({{ section.settings.mobile_columns }}, 1fr);
    max-width: 1400px;
    margin-inline: auto;
    padding-inline: {{ section.settings.gap | append: 'px' }};
    position: relative;
  }

  @media screen and (min-width: 768px) {
    .cst-grid {
      grid-template-columns: repeat({{ section.settings.desktop_columns }}, 1fr);
    }
  }

#predictive-search-results .cst-product-card {
    text-align: left;
    position: relative;
    overflow: hidden;
    transition: opacity 0.3s ease;
  }

#predictive-search-results .cst-swatch-wrapper .swiper-slide{
  width:fit-content !important;
}

#predictive-search-results .cst-main-slider .cst-slide-inner {
    width: 100%;
    aspect-ratio: 17/20;
  }

#predictive-search-results .cst-image-link {
    position: relative;
  }

#predictive-search-results .cst-product-image-wrapper {
    aspect-ratio: 17/20;
    position: relative;
    background-color: #eee;
    overflow: hidden;
  }

  #predictive-search-results .cst-product-image {
    display: block;
    height: 100%;
  }
  #predictive-search-results .cst-product-image.skeleton,
  #predictive-search-results .cst-swatch-image.skeleton {
    opacity: 0;
  }

  #predictive-search-results .cst-swatch-image-wrapper {
    /* aspect-ratio: 1/1; */
    position: relative;
    background-color: #eee;
    overflow: hidden;
    width:fit-content;
    display:flex;
  }

  #predictive-search-results .cst-swatch-image {
    display: block;
    cursor:pointer;
    height: 100%;
  }

  #predictive-search-results .cst-disabled::after {
      content: 'Sold Out :(';
      position: absolute;
      top: 50%;
      left: 50%;
      z-index: 1;
      display: block;
      transform: translate(-50%,-50%) rotate(-47.09deg);
      font-size: 75px;
      color: #FF0000;
      width: max-content;
    }

  #predictive-search-results .cst-product-title {
    margin-top: 6.77px;
    font-size: 13px;
    font-weight: 600;
    text-transform: uppercase;
    color:#000000;
    text-decoration:none;
    display:block;
  }

  #predictive-search-results .cst-swatches {
    /* display: flex; */
    display:none;
    align-items: center;
    margin-top: 0.5rem;
    gap: 8px;
    position: relative;
  }

  #predictive-search-results .cst-swatches .cst-slide-inner {
    border: 0.8px solid transparent;
    transition: all 0.3s;
    width:fit-content;
  }

  #predictive-search-results .cst-swatches .swiper-slide.cst-active .cst-slide-inner {
    border-color: #333;
  }

  #predictive-search-results .cst-hidden {
    display: none !important;
  }

  #predictive-search-results .cst-pagination {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 8px;
    margin: 30px 0;
  }

  #predictive-search-results .cst-page-button {
    padding: 2px 5px;
    text-decoration: none;
    font-size: 16px;
    color: #333;
    border-bottom: 1px solid transparent;
    transition: all 0.2s ease;
  }

  #predictive-search-results .cst-page-button:hover {
    border-color: #333;
  }

  #predictive-search-results .cst-page-button.active {
    border-color: #333;
  }

  #predictive-search-results .cst-main-slider,
  #predictive-search-results .cst-swatch-slider {
    display: block;
    width: 100%;
    overflow: hidden;
  }

  #predictive-search-results .swiper-button-prev,
  #predictive-search-results .swiper-button-next {
    position: relative;
    left: auto;
    right: auto;
    top: auto;
    bottom: auto;
    width: 18px;
    height: 100%;
    display: flex;
    justify-content: center;
    align-items: center;
    margin: 0;
    display: flex !important;
    justify-content: center;
    align-items: center;
    background-color: #fff;
  }

  #predictive-search-results .swiper-button-prev {
    position: absolute;
    left: 0;
    justify-content: start;
  }

  #predictive-search-results .swiper-button-next {
    position: absolute;
    right: 0;
    justify-content: end;
  }

  #predictive-search-results .swiper-button-prev::after,
  #predictive-search-results .swiper-button-next::after {
    font-size: 14px !important;
    color: #333;
  }

  #predictive-search-results .swiper-button-prev.swiper-button-disabled,
  #predictive-search-results .swiper-button-next.swiper-button-disabled {
    display: none !important;
  }

  @media(max-width: 425px) {
    #predictive-search-results .swiper-button-prev,
    #predictive-search-results .swiper-button-next {
      width: 14px;
    }

    #predictive-search-results .swiper-button-prev::after,
    #predictive-search-results .swiper-button-next::after {
      font-size: 10px;
      color: #333;
    }
  }

  #predictive-search-results .cst-tags-box {
    position: absolute;
    top: 0;
    left: 0;
    width: clamp(70px, 100vw, 200px);
    display: flex;
    flex-direction: column;
    gap: 5px;
    padding: 5px;
    border: 1px solid red;
  }

  #predictive-search-results .cst-img-box {
    display: flex;
    width: 70px;
    z-index: 1;
  }
  #predictive-search-results .cst-img-box img {
    display: flex;
  }

  #predictive-search-results .cst-swatches .cst-swatch-image-wrapper span{
    display: inline-block;
    cursor: pointer;
    background-position: center;
    background: transparent;
    background-size: contain;
  }
  @media (max-width:767px){
    #predictive-search-results .cst-disabled::after {
      font-size: 38px;
    }
  }
{% endstyle %}

{% comment %}theme-check-disable ImgLazyLoading{% endcomment %}
{%- if predictive_search.performed -%}
  {% assign first_column_results_size = predictive_search.resources.queries.size
    | plus: predictive_search.resources.collections.size
    | plus: predictive_search.resources.pages.size
    | plus: predictive_search.resources.articles.size
  %}
  {% assign noresult = false %}
  <div id="predictive-search-results" role="listbox">
    {% if predictive_search.resources.products.size == 0 %}
      <div class="search-noresult">
        <div class="search-noresult-child">
          {% if settings.search_no_image != blank %}
            <div class="nosearch_image">
              <img src="{{ settings.search_no_image | image_url }}" width="auto" height="auto" alt="search">
            </div>
          {% endif %}
          <div class="nosearch_content">
            <div class="search_desktop_content" style="font-size:{{ settings.search_content_size }};">{{settings.search_content }}</div>
            <div class="search_mobile_content" style="font-size:{{ settings.search_content_size_m }};">{{settings.search_content }}</div>
          </div>
        </div>
      </div>
      {% assign noresult = true %}  
      {% assign first_column_results_size = 0 %}
    {% else %}
        {%- if first_column_results_size > 0 or predictive_search.resources.products.size > 0 and noresult == false -%}
          <div
            id="predictive-search-results-groups-wrapper"
            class="predictive-search__results-groups-wrapper{% unless predictive_search.resources.products.size > 0 %} predictive-search__results-groups-wrapper--no-products{% endunless %}{% unless predictive_search.resources.queries.size > 0 or predictive_search.resources.collections.size > 0 %} predictive-search__results-groups-wrapper--no-suggestions{% endunless %}"
          >
        {%- endif -%}
        {%- if first_column_results_size > 0 and noresult == false -%}
          <div class="predictive-search__result-group predictive-search__result-queries">
        {%- endif -%}
        {%- if first_column_results_size > 0 -%}
          <div>
            <h2 id="predictive-search-queries" class="predictive-search__heading text-body caption-with-letter-spacing">
              {{- 'templates.search.suggestions' | t -}}
            </h2>
            <ul
              id="predictive-search-results-queries-list"
              class="predictive-search__results-list list-unstyled"
              role="group"
              aria-labelledby="predictive-search-queries" style="display:none!important;"
            >
              {%- for query in predictive_search.resources.queries -%}
                <li
                  id="predictive-search-option-query-{{ forloop.index }}"
                  class="predictive-search__list-item"
                  role="option"
                  aria-selected="false"
                >
                    {% assign is_available = product.available %}

                    <div
                      id="cst-grid"
                      class="cst-product-card {% unless is_available %} disabled{% endunless %}"
                      data-product-id="{{ product.id }}"
                    >
                      <div class="cst-main-slider">
                        <div class="cst-wrapper swiper-wrapper">
                          {% for variant in product.variants %}

                            {% if variant.metafields.custom.hide_variant_from_collection_page == true %}
                              {% continue %}
                            {% endif %}

                            {% assign variant_img = variant.featured_image | image_url %}
                            {% unless variant_img contains '.gif' %}
                              {% if variant_img %}
                                <div class="swiper-slide">
                                  <div class="cst-slide-inner">
                                    <a
                                      href="{{ variant.url }}"
                                      class="cst-image-link {% unless product.available %} cst-disabled {% endunless %}"
                                    >
                                      <div class="cst-product-image-wrapper">
                                        <link rel="preload" as="image" href="{{ variant_img }}">
                                        <img
                                          class="cst-product-image skeleton"
                                          src="{{ variant_img }}"
                                          alt="{{ product.title }}"
                                          width="100%"
                                          height="auto"
                                          loading="lazy"
                                          onload="this.classList.remove('skeleton')"
                                        >
                                      </div>
                                    </a>
                                  </div>
                                </div>
                              {% endif %}
                            {% endunless %}
                          {% endfor %}
                          {% comment %}
                            {% else %}
                              <div class="swiper-slide">
                                <div class="cst-slide-inner">
                                  <a href="{{ product.url }}" class="cst-image-link cst-disabled">
                                    <div class="cst-product-image-wrapper">
                                        <link rel="preload" as="image" href="{{ product.featured_image }}">
                                        <img
                                          class="cst-product-image skeleton"
                                          src="{{ product.featured_image | img_url: '400x' }}"
                                          alt="{{ product.title }}"
                                          width="100%"
                                          height="auto"
                                          loading="lazy"
                                          onload="this.classList.remove('skeleton')"
                                        />
                                    </div>
                                  </a>
                                </div>
                              </div>
                            {% endif %}
                          {% endcomment %}
                        </div>
                      </div>

                      <a href="{{  product.url }}" class="cst-product-title" 00>
                        {{- product.title }} - {{ product.price | money_without_trailing_zeros -}}
                      </a>

                      <div class="cst-swatches">
                        <div class="swiper-button-prev cst-swatch-prev"></div>
                        <div class="cst-swatch-slider">
                          <div class="cst-swatch-wrapper swiper-wrapper">
                            {% for variant in product.variants %}
                              {% assign variant_img = variant.featured_image | img_url: '100x' %}
                              {% unless variant_img contains '.gif' %}
                                {% if variant_img %}
                                  <div class="swiper-slide">
                                    <div class="cst-slide-inner">
                                      {% comment %} <a href="{{ variant.url }}" class="cst-image-link {% unless variant.metafields.pickup.shipping_qty > 0 %} cst-disabled {% endunless %}"> {% endcomment %}
                                      <div class="cst-swatch-image-wrapper">
                                        <img
                                          class="cst-swatch-image skeleton"
                                          src="{{ variant_img }}"
                                          alt="{{ product.title }}"
                                          width="100%"
                                          height="auto"
                                          loading="lazy"
                                          onload="this.classList.remove('skeleton')"
                                        >
                                      </div>
                                      {% comment %} </a> {% endcomment %}
                                    </div>
                                  </div>
                                {% endif %}
                              {% endunless %}
                            {% endfor %}
                          </div>
                        </div>
                        <div class="swiper-button-next cst-swatch-next"></div>
                      </div>

                      {% unless is_available %}
                        {% if section.settings.tag_soldout_img != blank %}
                          <div class="cst-tags-box">
                            <div class="cst-img-box">
                              <img
                                src="{{ section.settings.tag_soldout_img | img_url: '400x' }}"
                                width="100%"
                                height="auto"
                                alt="soldout"
                              >
                            </div>
                          </div>
                        {% endif %}
                        {% endunless %}
                    </div>
                </li>
              {%- endfor -%}
            </ul>
          </div>
        {%- endif -%}
        {%- if predictive_search.resources.articles.size > 0 or predictive_search.resources.pages.size > 0 -%}
          <div class="predictive-search__pages-wrapper predictive-search__pages-wrapper-extra">
            <h2
              id="predictive-search-pages-desktop"
              class="predictive-search__heading text-body caption-with-letter-spacing" style="display:none;"
            >
              {{- 'templates.search.pages' | t -}}
            </h2>
            <ul
              id="predictive-search-results-pages-list-desktop"
              class="predictive-search__results-list list-unstyled"
              role="group"
              aria-labelledby="predictive-search-pages-desktop"
            >
              {%- for page in predictive_search.resources.pages -%}
                <li
                  id="predictive-search-option-page-desktop-{{ forloop.index }}"
                  class="predictive-search__list-item"
                  role="option"
                  aria-selected="false"
                >
                  <a href="{{ page.url }}" class="predictive-search__item link link--text" tabindex="-1">
                    <div class="predictive-search__item-content predictive-search__item-content--centered">
                      <p class="predictive-search__item-heading h5">{{ page.title | escape }}</p>
                    </div>
                  </a>
                </li>
              {%- endfor -%}
              {%- for article in predictive_search.resources.articles -%}
                <li
                  id="predictive-search-option-article-desktop-{{ forloop.index }}"
                  class="predictive-search__list-item"
                  role="option"
                  aria-selected="false"
                >
                  <a href="{{ article.url }}" class="predictive-search__item link link--text" tabindex="-1">
                    <div class="predictive-search__item-content predictive-search__item-content--centered">
                      <p class="predictive-search__item-heading h5">{{ article.title | escape }}</p>
                    </div>
                  </a>
                </li>
              {%- endfor -%}
            </ul>
          </div>
        {%- endif -%}
        {%- if first_column_results_size > 0 and noresult == false -%}
          </div>
        {%- endif -%}
        {%- if predictive_search.resources.products.size > 0
          or predictive_search.resources.articles.size > 0
          or predictive_search.resources.pages.size > 0
        -%}
          <div class="predictive-search__result-group">
            {%- if predictive_search.resources.products.size > 0 -%}
              <div>
                <h2
                  id="predictive-search-products"
                  class="predictive-search__heading text-body caption-with-letter-spacing"
                >
                  {{- 'templates.search.products' | t -}}
                </h2>
                <ul
                  id="predictive-search-results-products-list"
                  class="predictive-search__results-list list-unstyled"
                  role="group"
                  aria-labelledby="predictive-search-products"
                >
                  {%- for product in predictive_search.resources.products limit:6 -%}
                    <li
                      id="predictive-search-option-product-{{ forloop.index }}"
                      class="predictive-search__list-item"
                      role="option"
                      aria-selected="false"
                    >
                        {% assign is_available = product.available %}

                        <div
                          id="cst-grid"
                          class="cst-product-card {% unless is_available %} disabled{% endunless %}"
                          data-product-id="{{ product.id }}"
                        >
                          {% assign first_var = blank %}
                          <div class="cst-main-slider">
                            <div class="cst-wrapper swiper-wrapper">

                              {% for variant in product.variants %}
                                
                                {% if variant.metafields.custom.hide_variant_from_collection_page == true %}
                                  {% continue %}
                                {% endif %}

                                {% if first_var == blank %}
                                  {% assign first_var = variant %}
                                {% endif %}

                                {% assign variant_img = variant.featured_image | image_url %}
                                {% unless variant_img contains '.gif' %}
                                  {% if variant_img %}
                                    <div class="swiper-slide">
                                      <div class="cst-slide-inner">
                                        {% comment %} <a
                                          href="{{ variant.url }}"
                                          class="cst-image-link {% unless variant.metafields.pickup.shipping_qty > 0 %} cst-disabled {% endunless %}"
                                        > {% endcomment %}
                                        <a
                                          href="{{ variant.url }}"
                                          class="cst-image-link {% unless product.available %} cst-disabled {% endunless %}"
                                        >
                                          <div class="cst-product-image-wrapper">
                                            <link rel="preload" as="image" href="{{ variant_img }}">
                                            <img
                                              class="cst-product-image skeleton"
                                              src="{{ variant_img }}"
                                              alt="{{ product.title }}"
                                              width="100%"
                                              height="auto"
                                              loading="lazy"
                                              onload="this.classList.remove('skeleton')"
                                            >
                                          </div>
                                        </a>
                                      </div>
                                    </div>
                                  {% endif %}
                                {% endunless %}
                              {% endfor %}
                            </div>
                          </div>

                          <a class="cst-product-title" href="{{ product.url }}" 11>
                            {{- product.title }} {{ first_var.price | money_without_trailing_zeros -}}
                          </a>

                          <div class="cst-swatches">
                            <div class="swiper-button-prev cst-swatch-prev"></div>

                            <div class="cst-swatch-slider">
                              <div class="cst-swatch-wrapper swiper-wrapper">
                                {% assign color_option_names = 'color,colour' | split: ',' %}

                                {% for option in product.options_with_values %}
                                  {% assign option_name_down = option.name | downcase %}

                                  {% if color_option_names contains option_name_down %}
                                    {% assign swatches = product.metafields.alt.swatches.value %}

                                    {% for color in option.values %}

                                      {% assign variant_disabled = false %}
                                      {% for variant in product.variants %}
                                        {% if variant.title contains color %}
                                          {% if variant.metafields.custom.hide_variant_from_collection_page == true %}
                                            {% assign variant_disabled = true %}
                                            {% break %}
                                          {% endif %}
                                        {% endif %}
                                      {% endfor %}

                                      {% if variant_disabled == true %}
                                        {% continue %}
                                      {% endif %}

                                      {% if color.available %}
                                        {% assign this_swatch = blank %}

                                        {%- comment -%}
                                          Priority:
                                          1. Variant swatch (image or color)
                                          2. Metafield swatch fallback
                                        {%- endcomment -%}

                                        {% if color.swatch.image %}
                                          {% assign this_swatch = color.swatch %}
                                        {% elsif color.swatch.color %}
                                          {% assign this_swatch = color.swatch %}
                                        {% else %}
                                          {% for swatch in swatches %}
                                            {% assign swatch_color_down = swatch.colour | downcase %}
                                            {% assign color_down = color | downcase %}
                                            {% assign swatch_name_down = swatch.name | downcase %}

                                            {% if color_down contains swatch_name_down %}
                                              {% if swatch.image or swatch.color %}
                                                {% assign this_swatch = swatch %}
                                              {% endif %}
                                            {% endif %}
                                          {% endfor %}
                                        {% endif %}

                                        <div class="swiper-slide">
                                          <div class="cst-slide-inner">
                                            <div class="cst-swatch-image-wrapper">
                                              {% render 'swatch',
                                                swatch: this_swatch,
                                                option_value: color,
                                                product: product,
                                                alt_swatches: true,
                                                swatch_size: 16,
                                                shape: 'square'
                                              %}
                                            </div>
                                          </div>
                                        </div>
                                      {% endif %}
                                    {% endfor %}
                                  {% endif %}
                                {% endfor %}
                              </div>
                            </div>

                            <div class="swiper-button-next cst-swatch-next"></div>
                          </div>

                          {% unless is_available %}
                            {% if section.settings.tag_soldout_img != blank %}
                              <div class="cst-tags-box">
                                <div class="cst-img-box">
                                  <img
                                    src="{{ section.settings.tag_soldout_img | img_url: '400x' }}"
                                    width="100%"
                                    height="auto"
                                    alt="soldout"
                                  >
                                </div>
                              </div>
                            {% endif %}
                          {% endunless %}
                        </div>
                    </li>
                  {%- endfor -%}
                </ul>
              </div>
              {% if predictive_search.resources.products.size > 6 %}
                <button
                  class="predictive-search__item_more predictive-search__item predictive-search__item--term  h5 animate-arrow"
                  tabindex="-1"
                  role="option"
                  aria-selected="false"
                >
                  SEE ALL
                </button> 
              {% endif %}
            {%- endif -%}
            {%- if predictive_search.resources.articles.size > 0 or predictive_search.resources.pages.size > 0 -%}
              <div class="predictive-search__pages-wrapper">
                <h2
                  id="predictive-search-pages-mobile"
                  class="predictive-search__heading text-body caption-with-letter-spacing"
                >
                  {{- 'templates.search.pages' | t -}}
                </h2>
                <ul
                  id="predictive-search-results-pages-list-mobile"
                  class="predictive-search__results-list list-unstyled"
                  role="group"
                  aria-labelledby="predictive-search-pages-mobile"
                >
                  {%- for page in predictive_search.resources.pages -%}
                    <li
                      id="predictive-search-option-page-mobile-{{ forloop.index }}"
                      class="predictive-search__list-item"
                      role="option"
                      aria-selected="false"
                    >
                      <a href="{{ page.url }}" class="predictive-search__item link link--text" tabindex="-1">
                        <div class="predictive-search__item-content predictive-search__item-content--centered">
                          <p class="predictive-search__item-heading h5">{{ page.title | escape }}</p>
                        </div>
                      </a>
                    </li>
                  {%- endfor -%}
                  {%- for article in predictive_search.resources.articles -%}
                    <li
                      id="predictive-search-option-article-mobile-{{ forloop.index }}"
                      class="predictive-search__list-item"
                      role="option"
                      aria-selected="false"
                    >
                      <a href="{{ article.url }}" class="predictive-search__item link link--text" tabindex="-1">
                        <div class="predictive-search__item-content predictive-search__item-content--centered">
                          <p class="predictive-search__item-heading h5">{{ article.title | escape }}</p>
                        </div>
                      </a>
                    </li>
                  {%- endfor -%}
                </ul>
              </div>
            {%- endif -%}
          </div>
        {%- endif -%}
        {%- if first_column_results_size > 0 or predictive_search.resources.products.size > 0 and noresult == false -%}
          </div>
        {%- endif -%}
    {%endif %}

    {%- render 'loading-spinner', class: 'predictive-search__loading-state' -%}

    <div id="predictive-search-option-search-keywords" class="predictive-search__search-for-button">
      <button
        class="predictive-search__item predictive-search__item--term link link--text h5 animate-arrow"
        tabindex="-1"
        role="option"
        aria-selected="false"
      >
        <span data-predictive-search-search-for-text>
          {{- 'templates.search.search_for' | t: terms: predictive_search.terms -}}
        </span>
        <span class="svg-wrapper">
          {{- 'icon-arrow.svg' | inline_asset_content -}}
        </span>
      </button>
    </div>
  </div>

  <span class="hidden" data-predictive-search-live-region-count-value>
    {% liquid
      assign total_results = predictive_search.resources.products.size | plus: first_column_results_size
      if total_results == 0
        echo 'templates.search.no_results' | t: terms: predictive_search.terms
      else
        echo 'templates.search.results_with_count' | t: count: total_results | append: ': '
        if predictive_search.resources.queries.size > 0
          assign count = predictive_search.resources.queries.size | plus: predictive_search.resources.collections.size
          echo 'templates.search.results_suggestions_with_count' | t: count: count | append: ', '
        endif
        if predictive_search.resources.pages.size > 0
          assign count = predictive_search.resources.pages.size | plus: predictive_search.resources.articles.size
          echo 'templates.search.results_pages_with_count' | t: count: count | append: ', '
        endif
        if predictive_search.resources.products.size > 0
          echo 'templates.search.results_products_with_count' | t: count: predictive_search.resources.products.size
        endif
      endif
    %}
  </span>
{%- endif -%}
