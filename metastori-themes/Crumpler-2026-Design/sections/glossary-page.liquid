{{ 'glossary-page.css' | asset_url | stylesheet_tag }}

<style>
@media (max-width:767px){
    .gp-item-heading, .gp-item-content{
        font-size:{{ section.settings.font_size_m }};
    }
}
@media (min-width:768px){
    .gp-item-heading, .gp-item-content{
        font-size:{{ section.settings.font_size }};
    }
}
</style>

{% for block in section.blocks %}
    {% if block.settings.select_column == "1" %}
        {% capture column_1 %}{{ column_1 }}
            <div class="gp-item">
                <h3 class="gp-item-heading {% if block.settings.image != blank or block.settings.video != blank %}popup_btn{% endif %}" popup_id="{{ block.id }}">
                    {{ block.settings.heading }} {% if block.settings.image != blank or block.settings.video != blank %}+{% endif %}
                </h3>
                <div class="gp-item-content">{{ block.settings.content }}</div>
            </div>
        {% endcapture %}
    {% endif %}
    {% if block.settings.select_column == "2" %}
        {% capture column_2 %}{{ column_2 }}
            <div class="gp-item">
                <h3 class="gp-item-heading {% if block.settings.image != blank or block.settings.video != blank %}popup_btn{% endif %}" popup_id="{{ block.id }}">
                    {{ block.settings.heading }} {% if block.settings.image != blank or block.settings.video != blank %}+{% endif %}
                </h3>
                <div class="gp-item-content">{{ block.settings.content }}</div>
            </div>
        {% endcapture %}
    {% endif %}
    {% if block.settings.select_column == "3" %}
        {% capture column_3 %}{{ column_3 }}
            <div class="gp-item">
                <h3 class="gp-item-heading {% if block.settings.image != blank or block.settings.video != blank %}popup_btn{% endif %}" popup_id="{{ block.id }}">
                    {{ block.settings.heading }} {% if block.settings.image != blank or block.settings.video != blank %}+{% endif %}
                </h3>
                <div class="gp-item-content">{{ block.settings.content }}</div>
            </div>
        {% endcapture %}
    {% endif %}

    {% if block.settings.image != blank or block.settings.video != blank %}
        {% capture gp_media %}{{ gp_media }}
            <div class="gp-media-item" gp-media="{{ block.id }}">
                <div class="gp-media-item-inner">
                    {% if block.settings.image != blank %}
                        <img class="gp-media" src="{{ block.settings.image | image_url }}" alt="image" width="auto" height="auto">
                    {% elsif block.settings.video != blank %}
                        {{ block.settings.video | video_tag:autoplay:true, loop:true, muted:true, class:'gp-media' }}
                    {% endif %}
                </div>
                <span class="gp-media-close">
                    <svg width="16" height="16" viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg">
                        <path d="M12.2796 11.6813L8.58886 7.9905L12.2858 4.29359L11.683 3.69076L7.98604 7.38768L4.29527 3.69691L3.69245 4.29974L7.38321 7.9905L3.6863 11.6874L4.28912 12.2902L7.98604 8.59333L11.6768 12.2841L12.2796 11.6813Z" fill="black" stroke="black" stroke-width="0.434961"/>
                    </svg>
                </span>
            </div>
        {% endcapture %}
    {% endif %}
{% endfor %}

<div class="glossary-page-main {{ section.id }}">
   <div class="gp-wrapper">
    <div class="gp-grid">
        <div class="gp-column gp-column-1">{{ column_1 }}</div>
        <div class="gp-column gp-column-2">{{ column_2 }}</div>
        <div class="gp-column gp-column-3">{{ column_3 }}</div>
    </div>
    {% if gp_media != blank %}
        <div class="gp-media-wrapper">
            <div class="gp-media-overlay"></div>
            {{ gp_media }}
        </div>
    {% endif %}
   </div>
</div>

<script>
document.addEventListener('DOMContentLoaded', () => {

    const wrapper = document.querySelector('.gp-media-wrapper');

  document.querySelectorAll('.popup_btn').forEach(btn => {
    btn.addEventListener('click', e => {
      const currentBtn = e.currentTarget;
      const block_id = currentBtn.getAttribute('popup_id');

      // remove active class from all media items
      document
        .querySelectorAll('.gp-media-item')
        .forEach(el => el.classList.remove('active-popup-media'));

      // open popup wrapper
      if (wrapper) {
        wrapper.classList.add('active-popup');
      }

      // activate current media item
      const activeItem = document.querySelector(
        `.gp-media-item[gp-media="${block_id}"]`
      );

      if (activeItem) {
        activeItem.classList.add('active-popup-media');
      }
    });
  });

    document.querySelectorAll('.gp-media-close').forEach(btn => {
        btn.addEventListener('click', e => {
            document.querySelectorAll('.gp-media-item').forEach(el => el.classList.remove('active-popup-media'));
            if (wrapper) {
                wrapper.classList.remove('active-popup');
            }
        });
    });

    
    const overlay = document.querySelector('.gp-media-overlay');
    if(overlay){
        overlay.addEventListener('click', e => {
            document.querySelectorAll('.gp-media-item').forEach(el => el.classList.remove('active-popup-media'));
            if (wrapper) {
                wrapper.classList.remove('active-popup');
            }
        });
    }

});
</script>

{% schema %}
{
  "name": "Glossary Page",
  "tag": "section",
  "class": "section",
  "settings": [
    {
        "type": "select",
        "id": "font_size",
        "label": "Font Size",
        "options": [
            {
                "label": "S",
                "value": "13px"
            },
            {
                "label": "M",
                "value": "26px"
            },
            {
                "label": "L",
                "value": "36px"
            },
            {
                "label": "XL",
                "value": "50px"
            },
            {
                "label": "XXL",
                "value": "134px"
            }
        ],
        "default":"134px"
    },
    {
        "type": "select",
        "id": "font_size_m",
        "label": "Font Size (Mobile)",
        "options": [
            {
                "label": "S",
                "value": "13px"
            },
            {
                "label": "M",
                "value": "26px"
            },
            {
                "label": "L",
                "value": "36px"
            },
            {
                "label": "XL",
                "value": "50px"
            },
            {
                "label": "XXL",
                "value": "134px"
            }
        ],
        "default":"50px"
    }
  ], 
  "blocks": [
    {
        "type": "item",
        "name":"Item",
        "settings": [
            {
                "type": "select",
                "id": "select_column",
                "label": "Select Column",
                "info":"Select column for display item in that column.",
                "options": [
                    {
                        "value": "1",
                        "label": "1"
                    },
                    {
                        "value": "2",
                        "label": "2"
                    },
                    {
                        "value": "3",
                        "label": "3"
                    },
                ],
                "default":"1",
            },
            {
                "type": "text",
                "id": "heading",
                "label":"Heading"
            },
            {
                "type": "richtext",
                "id": "content",
                "label":"Content"
            },
            {
                "type": "header",
                "content": "Popup Media",
            },
            {
                "type": "image_picker",
                "id": "image",
                "label": "Image"
            },
            {
                "type": "video",
                "id": "video",
                "label": "Video"
            }
        ]
    },
  ],
  "presets": [
    {
      "name": "Glossary Page"
    }
  ]
}
{% endschema %}
