{% for block in section.blocks %}
  {% capture desktop_css %}{{ desktop_css }}
        .dib-media-item-{{ block.id }} img, .dib-media-item-{{ block.id }} video{
            max-width:{{ block.settings.image_width }}px;
            width:100%;
            height:auto;
        }
        .dib-media-item-{{ block.id }}{
            padding-top:{{ block.settings.padding_top }}px;
            padding-bottom:{{ block.settings.padding_bottom }}px;
        }
    {% endcapture %}
  {% capture mobile_css %}{{ mobile_css }}
        .dib-media-item-{{ block.id }} img, .dib-media-item-{{ block.id }} video{
            max-width:{{ block.settings.image_width_m }}px;
            width:100%;
            height:auto;
        }
        .dib-media-item-{{ block.id }}{
            padding-top:{{ block.settings.padding_top_m }}px;
            padding-bottom:{{ block.settings.padding_bottom_m }}px;
        }
    {% endcapture %}
{% endfor %}
<style>
  .dib-media-item{
      display:flex;
      justify-content: center;
      position: relative;
  }
  .{{ section.id }} .dib-heading{
      margin:0;
      color:#000;
      font-family: "Neue Haas Grotesk Text Pro";
      font-weight: 700;
  }
  .{{ section.id }} .dib-content{
      margin:0;
      color:#000;
  }
  .{{ section.id }} .dib-wrapper {
      padding: 18px;
  }

  @media (min-width:768px){
      {{ desktop_css }}
      .{{ section.id }} .dib-heading{
          font-size:{{ section.settings.heading_size }};
      }
      .{{ section.id }} .dib-content{
          font-size:{{ section.settings.content_size }};
      }
  }
  @media (max-width:767px){
      {{ mobile_css }}
      .{{ section.id }} .dib-heading{
          font-size:{{ section.settings.heading_size_m }};
      }
      .{{ section.id }} .dib-content{
          font-size:{{ section.settings.content_size_m }};
      }
       .{{ section.id }} .dib-content br{
          display: none;
       }
  }
</style>

<div class="dynamic-image-block-main {{ section.id }}">
  <div class="dib-wrapper">
    <div class="dib-header">
      {% if section.settings.heading != blank %}
        <h2 class="dib-heading">{{ section.settings.heading }}</h2>
      {% endif %}
      {% if section.settings.content != blank %}
        <div class="dib-content">{{ section.settings.content }}</div>
      {% endif %}
    </div>
    <div class="dib-media">
      {% for block in section.blocks %}
        <div class="dib-media-item dib-media-item-{{ block.id }}">
          {% if block.settings.link != blank %}
            <a href="{{ block.settings.link }}" class="overlay-link"></a>
          {% endif %}
          {% if block.settings.image != blank %}

            {% assign image_height = block.settings.image.width | divided_by: block.settings.image.aspect_ratio | round %}
            {{ block.settings.image
            | image_url: width: 3840
            | image_tag:
                width: block.settings.image.width,
                height: image_height,
                class: 'desktop_img',
                sizes: '100vw',
                widths: '170, 320, 375, 414, 550, 750, 1100, 1500, 1780, 2000, 3000, 3840',
                alt: block.settings.image.alt
            }}

            {% if block.settings.image_m != blank %}
                {% assign mobile_height = block.settings.image_m.width | divided_by: block.settings.image_m.aspect_ratio | round %}
                {{ block.settings.image_m
                    | image_url: width: 750
                    | image_tag:
                    width: block.settings.image_m.width,
                    height: mobile_height,
                    class: 'mobile_img',
                    sizes: '100vw',
                    widths: '320, 375, 414, 550, 750',
                    alt: block.settings.image_m.alt
                }}
            {% else %}
                {% assign mobile_height = block.settings.image.width | divided_by: block.settings.image.aspect_ratio | round %}
                {{
                    block.settings.image
                    | image_url: width: 750
                    | image_tag:
                    width: block.settings.image.width,
                    height: mobile_height,
                    class: 'mobile_img',
                    sizes: '100vw',
                    widths: '320, 375, 414, 550, 750',
                    alt: block.settings.image.alt
                }}
            {% endif %}
          {% elsif block.settings.video != blank %}
            {{ block.settings.video | video_tag:autoplay:true, loop:true, muted:true, preload: 'none', class:'desktop_video scroll-video' }}
            {% if block.settings.video_m != blank %}
                {{ block.settings.video_m | video_tag:autoplay:true, loop:true, muted:true, preload: 'none', class:'mobile_video scroll-video' }}
            {% else %}
                {{ block.settings.video | video_tag:autoplay:true, loop:true, muted:true, preload: 'none', class:'mobile_video scroll-video' }}
            {% endif %}
          {% else %}
            {{ 'detailed-apparel-1' | placeholder_svg_tag: 'placeholder-svg' }}
          {% endif %}
        </div>
      {% endfor %}
    </div>
  </div>
</div>

