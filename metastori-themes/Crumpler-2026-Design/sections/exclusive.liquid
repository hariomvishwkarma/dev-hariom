<section
  id="exclusive-{{ section.id }}"
  class="exclusive-tiles"
  style="
    height: {{ section.settings.section_height }}px;
    --tile-size: {{ section.settings.tile_size }}px;
    --mobile-tile-size: {{ section.settings.mobile_tile_size }}px;
    {% if section.settings.tile_image != blank %}
      background-image: url('{{ section.settings.tile_image | image_url: width: 800 }}');
    {% endif %}
  "
>
  <div class="exclusive-cover">
    {% for i in (1..600) %}
      {% assign delay = i | times: 137 | modulo: 7000 | minus: 3000 %}
      <span style="animation-delay: {{ delay }}ms;"></span>
    {% endfor %}
  </div>

 <div class="exclusive-text-wrap">
  {% if section.settings.link != blank %}
    <a href="{{ section.settings.link }}" class="exclusive-text">
      <span>{{ section.settings.text }}</span>
    </a>
  {% else %}
    <div class="exclusive-text">
      <span>{{ section.settings.text }}</span>
    </div>
  {% endif %}
</div>
</section>

<style>
  #exclusive-{{ section.id }} {
    position: relative;
    overflow: hidden;
    background-color: white;
    background-size: var(--tile-size) var(--tile-size);
    background-repeat: repeat;
    background-position: top left;
  }

  #exclusive-{{ section.id }} .exclusive-cover {
    position: absolute;
    top: 0;
    left: 0;
    width: calc(100% + var(--tile-size));
    height: calc(100% + var(--tile-size));
    z-index: 1;
    display: flex;
    flex-wrap: wrap;
    align-content: flex-start;
    pointer-events: none;
  }

  #exclusive-{{ section.id }} .exclusive-cover span {
    flex: 0 0 var(--tile-size);
    width: var(--tile-size);
    height: var(--tile-size);
    background: white;
    animation: randomRevealTile 6s steps(1, end) infinite;
  }

  @keyframes randomRevealTile {
    0% {
      opacity: 1;
    }

    20% {
      opacity: 0;
    }

    80% {
      opacity: 0;
    }

    100% {
      opacity: 1;
    }
  }

#exclusive-{{ section.id }} .exclusive-text-wrap {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 32px;
  text-align: center;
  z-index: 2;
}

#exclusive-{{ section.id }} .exclusive-text {
  display: inline;
  text-decoration: none;
}

#exclusive-{{ section.id }} .exclusive-text span {
  font-size: clamp(22px, 3vw, 60px);
  line-height: 1.2;
  font-weight: 900;
  letter-spacing: 0;
  text-transform: uppercase;

  color: white;
  -webkit-text-stroke: 4px black;
  paint-order: stroke fill;

  text-shadow:
    2px 2px 0 black,
    4px 4px 8px rgba(0,0,0,0.45);

  transition:
    background-color 0.15s ease,
    color 0.15s ease;

  box-decoration-break: clone;
  -webkit-box-decoration-break: clone;
}

#exclusive-{{ section.id }} .exclusive-text:hover span,
#exclusive-{{ section.id }} .exclusive-text:focus span,
#exclusive-{{ section.id }} .exclusive-text:active span {
  background: black;
  color: white;
    padding: 0.08em 0.25em;
}

@media (max-width: 749px) {
  #exclusive-{{ section.id }} {
    background-size: var(--mobile-tile-size) var(--mobile-tile-size);
  }

  #exclusive-{{ section.id }} .exclusive-cover {
    width: calc(100% + var(--mobile-tile-size));
    height: calc(100% + var(--mobile-tile-size));
  }

  #exclusive-{{ section.id }} .exclusive-cover span {
    flex-basis: var(--mobile-tile-size);
    width: var(--mobile-tile-size);
    height: var(--mobile-tile-size);
  }

  #exclusive-{{ section.id }} .exclusive-text-wrap {
    left: 16px;
    right: 16px;
    bottom: 20px;
  }

  #exclusive-{{ section.id }} .exclusive-text span {
    font-size: clamp(32px, 12vw, 64px);
    -webkit-text-stroke: 4px black;

    text-shadow:
      1px 1px 0 black,
      2px 2px 4px rgba(0,0,0,0.4);
  }
}
</style>

{% schema %}
{
  "name": "exclusive",
  "settings": [
    {
      "type": "image_picker",
      "id": "tile_image",
      "label": "Tile image"
    },
    {
      "type": "text",
      "id": "text",
      "label": "Bottom text",
      "default": "ONLINE EXCLUSIVE"
    },
    {
      "type": "url",
      "id": "link",
      "label": "Optional link"
    },
    {
  "type": "range",
  "id": "mobile_tile_size",
  "label": "Mobile tile size",
  "min": 40,
  "max": 300,
  "step": 10,
  "default": 100,
  "unit": "px"
},
    {
      "type": "range",
      "id": "tile_size",
      "label": "Tile size",
      "min": 60,
      "max": 400,
      "step": 10,
      "default": 160,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "section_height",
      "label": "Section height",
      "min": 300,
      "max": 900,
      "step": 50,
      "default": 600,
      "unit": "px"
    }
  ],
  "presets": [
    {
      "name": "exclusive"
    }
  ]
}
{% endschema %}