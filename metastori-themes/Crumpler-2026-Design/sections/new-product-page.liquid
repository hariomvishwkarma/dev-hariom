{% schema %}
{
  "name": "3D Product Viewer",
  "tag": "section",
  "class":"modelview-section",
  "settings": [
    {
      "type": "url",
      "id": "model_src",
      "label": "3D Model URL (.glb)"
    },
    {
      "type": "image_picker",
      "id": "poster_image",
      "label": "Fallback image (iOS Safari)"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background Color",
      "default": "#f6f6f6"
    },
    {
      "type": "checkbox",
      "id": "open_link_directly",
      "label": "Open hotspot link directly (no popup)",
      "default": true,
      "info": "When enabled, clicking a hotspot goes straight to the product/link. When disabled, a popup is shown first."
    }
  ],
  "blocks": [
    {
      "type": "hotspot",
      "name": "Hotspot",
      "settings": [
        {
          "type": "text",
          "id": "hotspot_text",
          "label": "Heading",
          "default": "Heading"
        },
        {
          "type": "text",
          "id": "position",
          "label": "Position (x y z)",
          "default": "0m 1.4m 0.1m"
        },
        {
          "type": "text",
          "id": "normal",
          "label": "Normal (x y z)",
          "default": "0m 1m 0m"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        },
        {
          "type": "header",
          "content": "Popup Content"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "text",
          "label": "Text"
        },
      ]
    }
  ],
  "max_blocks": 10,
  "presets": [
    {
      "name": "3D Product Viewer",
      "category": "Product",
      "blocks": [
        {
          "type": "hotspot",
          "settings": {
            "position": "0m 1.4m 0.1m",
            "normal": "0m 1m 0m"
          }
        },
        {
          "type": "hotspot",
          "settings": {
            "position": "0.3m 1m 0.3m",
            "normal": "0m 1m 0m"
          }
        }
      ]
    }
  ]
}
{% endschema %}

<style>
    @font-face {
      font-family: W95FA;
      src: url(https://cdn.shopify.com/s/files/1/0565/5114/5551/files/w95fa.woff?v=1738224501);
    }
    .modelview-section {
      font-family: W95FA;
    }
    .modelview-section .viewer-3d-container {
      position: relative;
      min-height: 50vh;
      min-height: 50dvh;
    }
    .modelview-section .viewer-wrapper {
      background: transparent;
      padding: 40px 0;
      display: flex;
      justify-content: center;
      position: relative;
      padding-top: calc(100vh - 250px);
      min-height: 50vh;
      min-height: 50dvh;
      visibility: hidden;
      opacity: 0;
      transition: opacity 0.3s ease, visibility 0.3s ease;
    }
    .modelview-section .viewer-wrapper.loaded {
      visibility: visible;
      opacity: 1;
    }
    .modelview-section .viewer-3d-loader {
      position: absolute;
      top: 0;
      left: 0;
      right: 0;
      bottom: 0;
      display: flex;
      align-items: center;
      justify-content: center;
      background: var(--modelview-loader-bg, #f6f6f6);
      z-index: 1;
      transition: opacity 0.3s ease, visibility 0.3s ease;
    }
    .modelview-section .viewer-3d-loader.hidden {
      visibility: hidden;
      opacity: 0;
      pointer-events: none;
    }
    .modelview-section .viewer-3d-loader lottie-player {
      width: 120px;
      height: 120px;
    }
    .modelview-section .viewer-3d-progress-wrap {
      width: 100%;
      max-width: 200px;
      padding: 0 16px;
    }
    .modelview-section .viewer-3d-progress-label {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 6px;
      font-size: 14px;
      font-family: W95FA;
      color: #000;
    }
    .modelview-section .viewer-3d-progress-bar-bg {
      width: 100%;
      height: 18px;
      padding: 3px;
      background: #fff;
      border: 1px solid #000;
      border-radius: 0;
      overflow: hidden;
      box-sizing: border-box;
    }
    .modelview-section .viewer-3d-progress-bar-fill {
      display: block;
      height: 100%;
      min-height: 0;
      width: 0%;
      background: #000;
      border-radius: 0;
      transition: width 0.15s ease-out;
      box-sizing: border-box;
    }

    model-viewer {
      width: 100%;
      max-width: 100%;
      height: 100%;
      min-height: 50vh;
      min-height: 50dvh;
      background: transparent;
      position: absolute;
      top: 0;
      left: 0;
      right: 0;
      bottom: 0;
      transform: translateZ(0);
      -webkit-transform: translateZ(0);
      -webkit-backface-visibility: hidden;
      backface-visibility: hidden;
    }

    .hotspot-btn {
      padding: 2px 6px 0;
      border-radius: 6px;
      width: fit-content;
      max-height: 20px;
      overflow:hidden;
      font-size: 20px;
      font-family: W95FA;
      cursor: pointer;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      -webkit-box-align: center;
      -webkit-box-pack: center;
      background: #fff;
      color: #000;
      border: 1px solid #000;
      {% comment %} box-sizing: border-box;
      -webkit-appearance: none;
      appearance: none;
      vertical-align: top; {% endcomment %}
    }
    @supports (-webkit-touch-callout: none) {
      .popup .btn-link { padding-top: 4px; padding-bottom: 1px; }
    }

    .popup {
      position: fixed;
      top: 50%;
      left: 50%;
      transform: translate(-50%, -50%);
      background: #fff;
      padding: 12px;
      border-radius: 0px;
      max-width: 200px;
      z-index: 1000;
      text-align: left;
      border: 1.37px solid #000;
    }

    .popup .img-link {
      display: flex;
      justify-content: center;
    }

    .popup img {
      max-width: 100%;
      display: block;
      object-fit: contain;
    }

    .popup .popup_dd {
      margin: 10px 0 5px;
      font-size: 20px;
      font-weight: 700;
      font-family: W95FA, sans-serif;
    }

    .popup p {
      margin: 0;
      font-size: 14px;
      color: #333;
    }

    .popup .btn {
      margin-top: 10px;
      background: none;
      color: black;
      border: 1.7px solid #000;
      padding: 5.5px 8px 3px;
      border-radius: 6px;
      cursor: pointer;
      display: flex;
      align-items: center;
      justify-content: center;
      text-decoration: none;
      text-transform: uppercase;
      width: fit-content;
      font-size: 20px;
      font-weight: 700;
      max-height: 24px;
    }

    .popup .btn-close {
      position: absolute;
      bottom: 100%;
      right: 0;
      top: -34px;
      width: 19px;
      height: 20px;
      padding: 5.5px 8px 3px 9px;
      font-family: W95FA;
      font-size: 20px;
      font-weight: 700;
      background: #fff;
      border: 1.37px solid #000;
      border-radius: 0px;
      display: flex;
      align-items: center;
      justify-content: center;
      text-transform: uppercase;
      cursor: pointer;
    }
    .popup .btn-link {
      font-family: W95FA, sans-serif;
      font-size: 20px;
      font-weight: 700;
      text-transform: uppercase;
      border: 1px solid #000;
      border-radius: 6px;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      -webkit-box-align: center;
      -webkit-box-pack: center;
      width: fit-content;
      color: #000;
      padding: 0px 8px 1.4px;
      text-decoration: none;
      vertical-align: top;
    }
    @media (min-width:768px){
      .modelview-section .viewer-wrapper {
        padding-top: calc(100vh - 150px);
      }
    }
    @media screen and (max-width: 1025px) {
      .modelview-section .viewer-wrapper {
        padding-top: 0;
        min-height: 80vh;
        min-height: 80dvh;
        width: 100%;
        max-width: 100vw;
        box-sizing: border-box;
        overflow: visible;
      }
      model-viewer {
        min-height: 80vh;
        min-height: 80dvh;
        width: 100%;
        max-width: 100vw;
        object-fit: contain;
      }
      .modelview-section { padding: 100px 0; }
      .popup { padding: 12.3px 13.6px 12.3px 16.4px; }
      .popup .btn-link {
        min-width: 72.4px;
        min-height: 27.3px;
        height: 27.3px;
        font-size: 27.32px;
        border: 1.37px solid #000;
        border-radius: 8.2px;
        padding: 1px 1px 2.7px;
        box-sizing: border-box;
      }
      @supports (-webkit-touch-callout: none) {
        .popup .btn-link { padding-top: 6px; padding-bottom: 2px; }
      }

    }

</style>

<div class="viewer-3d-container" style="--modelview-loader-bg: {{ section.settings.background_color }};">
  <div class="viewer-3d-loader" id="viewer-3d-loader" aria-hidden="false">
    <div class="viewer-3d-progress-wrap">
      <div class="viewer-3d-progress-label">
        <span>Loading.</span>
        <span class="viewer-3d-progress-pct" id="viewer-3d-progress-pct">0%</span>
      </div>
      <div class="viewer-3d-progress-bar-bg">
        <div class="viewer-3d-progress-bar-fill" id="viewer-3d-progress-bar" role="progressbar" aria-valuenow="0" aria-valuemin="0" aria-valuemax="100"></div>
      </div>
    </div>
  </div>
  <div class="viewer-wrapper" id="viewer-wrapper-3d" aria-hidden="true" data-open-link-directly="{{ section.settings.open_link_directly }}">
  <model-viewer
    id="model-viewer-3d"
    src="{{ section.settings.model_src }}"
    alt="3D product model"
    {% if section.settings.poster_image != blank %}poster="{{ section.settings.poster_image | img_url: '800x' }}"{% endif %}
    camera-controls
    camera-orbit="260deg 75deg 30m"
    {% comment %} min-camera-orbit="250deg 80deg 25m" {% endcomment %}
    {% comment %} max-camera-orbit="285deg 90deg 25m" {% endcomment %}
    camera-target="0m 1m -0.8m"
    interaction-prompt="none"
    ar
    shadow-intensity="1"
    exposure="1"
    loading="eager"
    reveal="auto"
    tone-mapping="commerce"
    disable-pan
  >
    {% for block in section.blocks %}
      {% if block.type == 'hotspot' %}
        {% if block.settings.image != blank %}
          <link rel="preload" as="image" href="{{ block.settings.image | img_url: '400x' }}">
        {% endif %}
        <button
          slot="hotspot-{{ forloop.index }}"
          data-position="{{ block.settings.position }}"
          data-normal="{{ block.settings.normal }}"
          class="hotspot-btn"
          {% if block.settings.image != blank %}data-image="{{ block.settings.image | img_url: '400x' }}"{% endif %}
          data-title="{{ block.settings.text | default: block.settings.hotspot_text | escape }}"
          data-link="{{ block.settings.link | default: '#' }}"
        >
          {{ block.settings.hotspot_text }}
        </button>
      {% endif %}
    {% endfor %}
  </model-viewer>
  </div>
</div>

<script>
(function() {
  var isIOS = /iPhone|iPad|iPod/i.test(navigator.userAgent);
  var s = document.createElement('script');
  s.src = isIOS
    ? 'https://unpkg.com/@google/model-viewer@3.4.0/dist/model-viewer-umd.min.js'
    : 'https://unpkg.com/@google/model-viewer@3.4.0/dist/model-viewer.min.js';
  if (!isIOS) s.type = 'module';
  document.head.appendChild(s);

  function hideArButtonOnMobile() {
    var mv = document.getElementById('model-viewer-3d');
    if (!mv || !mv.shadowRoot) return;
    var isMobile = window.matchMedia('(max-width: 749px)').matches;
    var arBtn = mv.shadowRoot.getElementById('default-ar-button');
    if (arBtn) arBtn.style.display = isMobile ? 'none' : '';
  }

  function updateProgress(pct) {
    var bar = document.getElementById('viewer-3d-progress-bar');
    var pctEl = document.getElementById('viewer-3d-progress-pct');
    var value = Math.round(Math.min(100, Math.max(0, pct * 100)));
    if (bar) {
      bar.style.width = value + '%';
      bar.setAttribute('aria-valuenow', value);
    }
    if (pctEl) pctEl.textContent = value + '%';
  }

  function bindModelViewerProgress(mv) {
    if (!mv) return;
    var wrapper = document.getElementById('viewer-wrapper-3d');
    var loaderEl = document.getElementById('viewer-3d-loader');
    var fallbackInterval;
    var highProgressTimeout;
    var stuckCheckInterval;
    var lastProgress = 0;
    var lastProgressTime = 0;
    function stopFallback() {
      if (fallbackInterval) {
        clearInterval(fallbackInterval);
        fallbackInterval = null;
      }
      if (highProgressTimeout) {
        clearTimeout(highProgressTimeout);
        highProgressTimeout = null;
      }
    }
    function stopStuckCheck() {
      if (stuckCheckInterval) {
        clearInterval(stuckCheckInterval);
        stuckCheckInterval = null;
      }
    }
    function finishLoading() {
      stopFallback();
      stopStuckCheck();
      updateProgress(1);
      if (wrapper) {
        wrapper.classList.add('loaded');
        wrapper.setAttribute('aria-hidden', 'false');
      }
      if (loaderEl) loaderEl.classList.add('hidden');
      hideArButtonOnMobile();
    }
    function startFallback() {
      var p = 0;
      fallbackInterval = setInterval(function() {
        p += 0.02;
        if (p >= 0.9) p = 0.9;
        updateProgress(p);
      }, 80);
    }
    function scheduleFinish() {
      if (highProgressTimeout) return;
      highProgressTimeout = setTimeout(finishLoading, 80);
    }
    mv.addEventListener('progress', function(e) {
      stopFallback();
      var total = (e && e.detail && typeof e.detail.totalProgress === 'number') ? e.detail.totalProgress : 0;
      lastProgress = total;
      lastProgressTime = Date.now();
      updateProgress(total);
      if (total >= 0.9) {
        scheduleFinish();
      }
    });
    mv.addEventListener('load', function() {
      finishLoading();
    });
    startFallback();
    stuckCheckInterval = setInterval(function() {
      if (loaderEl && loaderEl.classList.contains('hidden')) return;
      var now = Date.now();
      if (lastProgress >= 0.85 && (now - lastProgressTime) > 400) {
        finishLoading();
      }
    }, 200);
  }

  function init() {
    var mv = document.getElementById('model-viewer-3d');
    var wrapper = document.getElementById('viewer-wrapper-3d');
    if (mv && wrapper) {
      if (typeof customElements !== 'undefined' && customElements.get('model-viewer')) {
        bindModelViewerProgress(mv);
      } else {
        customElements.whenDefined('model-viewer').then(function() {
          bindModelViewerProgress(document.getElementById('model-viewer-3d'));
        });
      }
    }
    if (mv && isIOS) { mv.style.minHeight = '50vh'; mv.style.height = '100%'; }
    if (mv && mv.shadowRoot) hideArButtonOnMobile();
    setTimeout(hideArButtonOnMobile, 500);
    window.addEventListener('resize', hideArButtonOnMobile);
    var wrapperEl = document.getElementById('viewer-wrapper-3d');
    var openLinkDirectly = wrapperEl && wrapperEl.getAttribute('data-open-link-directly') === 'true';
    document.querySelectorAll('.hotspot-btn').forEach(function(btn) {
      if (btn._bound) return;
      btn._bound = true;
      btn.addEventListener('click', function() {
        var link = btn.getAttribute('data-link') || '#';
        if (openLinkDirectly && link && link !== '#') {
          window.location.href = link;
          return;
        }
        var title = btn.getAttribute('data-title') || '';
        var image = btn.getAttribute('data-image');
        var imgHtml = image ? (link !== '#' ? '<a href="' + link + '" class="img-link" target="_blank"><img src="' + image + '" alt="' + title + '"></a>' : '<img src="' + image + '" alt="' + title + '">') : '';
        var popup = document.createElement('div');
        popup.className = 'popup';
        var openBtnHtml = (link && link !== '#') ? '<a class="btn-link" href="' + link + '" target="_blank">open</a>' : '';
        popup.innerHTML = imgHtml +
          '<div class="popup_dd">' + title + '</div>' +
          '<button class="btn btn-close" type="button"><span class="btn-close-icon">x</span></button>' +
          openBtnHtml;
        popup.querySelector('.btn-close').onclick = function() { popup.remove(); };
        document.body.appendChild(popup);
      });
    });
  }
  function run() {
    if (document.readyState === 'loading') { document.addEventListener('DOMContentLoaded', run); return; }
    init();
    if (isIOS) setTimeout(init, 300);
  }
  run();
})();
</script>
