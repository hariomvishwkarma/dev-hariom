<div class="cst-radio-form-section">
  <div class="cst-row">
    <div class="cst-col cst-desk-sticky cst-col-left">
      <div class="">
        <div class="cst-left-box">
          {% if section.settings.left_desc != blank %}
            <div class="cst-left-desc">{{ section.settings.left_desc }}</div>
          {% endif %}
          {% if section.settings.left_img != blank %}
            <div class="cst-img-container">
              <div class="cst-img-box" style="width: {{ section.settings.left_img_width }}%;">
                {{ section.settings.left_img
                  | image_url: width: 2000
                  | image_tag:
                    loading: 'lazy',
                    sizes: '(min-width: 768px) 50vw, 100vw',
                    alt: section.settings.left_img.alt
                }}
              </div>

            </div>
          {% endif %}
        </div>
      </div>
    </div>
    <div class="cst-col cst-col-center">
      <div class="cst-box">
        <div class="cst-box-info"></div>
        {% if section.blocks.size > 0 %}
          <div class="cst-blocks-container">
            
            {% comment %} Filter Tags wise {% endcomment %}
            {% assign all_tags = '' %}

            {% for entry in shop.metaobjects.soundcloud_crumpler_radio.values %}
              {% if entry.tags %}
                {% assign entry_tags = entry.tags.value %}

                {%- comment -%}
                  entry.tags.value is likely an array of strings (e.g. ["pop ambient funk"])
                {%- endcomment -%}
                {% for tag_group in entry_tags %}
                  {% assign split_tags = tag_group | split: ' ' %}
                  {% for tag in split_tags %}
                    {% assign lower_tag = tag | strip | downcase %}
                    {% if lower_tag != '' %}
                      {% unless all_tags contains lower_tag %}
                        {% assign all_tags = all_tags | append: lower_tag | append: ',' %}
                      {% endunless %}
                    {% endif %}
                  {% endfor %}
                {% endfor %}
              {% endif %}
            {% endfor %}

            {% assign unique_tags = all_tags | split: ',' | uniq %}

            <!-- STEP 2: Render Filter Buttons -->
            <div class="tag-filters">
              <strong class="filter-title">Filter:</strong>
              {% assign tag_count = unique_tags.size %}
              {% for tag in unique_tags %}
                {% if tag != '' %}
                  <button class="filter-btn" data-tag="{{ tag | escape }}">{{ tag | capitalize }}</button>
                  {% unless forloop.last %}, {% endunless %}
                {% endif %}
              {% endfor %}
            </div>

            {% comment %} Sort By Dropdown UI {% endcomment %}
            <div class="soundcloud-sort-by">
              <label for="sortSelect"><strong>Sort By:</strong></label>
              <select id="sortSelect">
                <option value="az">A to Z</option>
                <option value="za">Z to A</option>
                <option value="oldest">Date: Old to New</option>
                <option value="newest">Date: New to Old</option>
              </select>
            </div>
            <div class="mobile-soudbar-show"></div>

            <div id="soundcloud-container">
              <table class="radio-table">
                <tbody>
                  {% for entry in shop.metaobjects.soundcloud_crumpler_radio.values %}
                    {% assign entry_index = forloop.index %}
                    {% assign entry_title = entry.title.value | default: 'DJ Deejay Jay' %}
                    {% if entry.date %}
                      {% assign entry_date = entry.date | date: '%d.%m.%Y' %}
                    {% else %}
                      {% assign entry_date = '18.02.2025' %}
                    {% endif %}
                    {% assign first_track = entry.tracks.value.first %}
                    {% assign row_tags = '' %}
                    {% if entry.tags %}
                      {% for tag_group in entry.tags.value %}
                        {% assign split_tags = tag_group | split: ' ' %}
                        {% for tag in split_tags %}
                          {% assign lower_tag = tag | strip | downcase %}
                          {% if lower_tag != '' %}
                            {% assign row_tags = row_tags | append: lower_tag | append: ',' %}
                          {% endif %}
                        {% endfor %}
                      {% endfor %}
                    {% endif %}

                    <tr
                      class="popup-row"
                      data-url="{{ first_track.url }}"
                      data-title="{{ entry_title }}"
                      data-tags="{{ row_tags }}"
                      data-track-index="{{ entry_index }}"
                    >
                      <td>({% if entry_index < 10 %}0{{ entry_index }}{% else %}{{ entry_index }}{% endif %})</td>
                      <td>
                        <a href="javascript:void(0)" class="open-popup">{{ entry_title }}</a>
                      </td>
                      <td>{{ entry_date }}</td>
                    </tr>
                  {% endfor %}
                </tbody>
              </table>
            </div>
          </div>
        {% endif %}
      </div>
    </div>
    <div class="cst-col cst-desk-sticky cst-col-right">
      <div class="rhs-section-form">
        {% if section.settings.right_img != blank %}
          <div
            class="cst-img-box cst-img-form-box"
            style="width:{{ section.settings.right_img_width | append:'%' }}; aspect-ratio: 1.3;"
          >
            <img src="{{ section.settings.right_img | img_url:'original' }}" width="100%" height="100%" alt="img">
          </div>
        {% endif %}

        <div class="custom-form-section">
          {% if section.settings.right_desc != blank %}
            <div class="form-text">{{ section.settings.right_desc }}</div>
          {% endif %}

          {% for block in section.blocks %}
            {% if block.type == '@app' %}
              {% render block %}
            {% endif %}
          {% endfor %}
        </div>
      </div>
    </div>
  </div>
</div>

<script>
  // SoundCloud popup script with sorting and filtering functionality
  const popupStyles = document.createElement('style');
  popupStyles.textContent = `
    .soundcloud-popup {
      position: fixed;
      top: 3px;
      right: 69px;
      z-index: 5;
      width: 100%;
    }
    

    .soundcloud-popup.show {
      display: flex;
    }

    .soundcloud-popup-content {
      padding: 0;
      color: white;
      z-index: 2;
      width: 100%;
    }

    .soundcloud-popup-content {
      will-change: transform, opacity;
    }

    /* OPEN bounce */
    .soundcloud-popup.show .soundcloud-popup-content {
      animation: smoothBounceIn 1.4s cubic-bezier(0.4, 0, 0.2, 1) forwards;
    }

    /* CLOSE bounce */
    .soundcloud-popup.hide .soundcloud-popup-content {
      animation: smoothBounceOut .4s cubic-bezier(0.4, 0, 0.2, 1) forwards;
    }

    /* ⬇ OPEN */
    @keyframes smoothBounceIn {
      0%   { transform: translateY(-1000px); opacity: 0; }
      20%  { transform: translateY(250px);  opacity: 1; }
      40%  { transform: translateY(-80px); }
      60%  { transform: translateY(40px); }
      75%  { transform: translateY(-20px); }
      90%  { transform: translateY(10px); }
      100% { transform: translateY(0); }
    }

    /* ⬆ CLOSE */
    @keyframes smoothBounceOut {
      0%   { transform: translateY(0);    opacity: 1; }
      20%  { transform: translateY(10px); }
      60%  { transform: translateY(40px); }
      90%  { transform: translateY(250px); opacity: 0.6; }
      100% { transform: translateY(-1000px); opacity: 0; }
    }

    .popup-header {
      display: flex;
      border: 1px solid black;
      align-items: center;
      white-space: nowrap;
      margin: 0 0 2px 0;
      background: #D9D9D9;
      max-height: 30px;
    }

    .popup-controls {
      display: flex;
      border-right: 1px solid black;
      gap: 10px;
      height: -webkit-fill-available;
    }

    .popup-control-btn {
      background: #D9D9D9;
      border: none;
      font-size: 17px;
      cursor: pointer;
      justify-content: center;
      display: flex;
      align-items: center;
      -webkit-appearance: none;
      appearance: none;
      background: none;
      border: 0;
      color: #000 !important;
    }
    .track-title-box {
      overflow: hidden;
    }

    .popup-control-btn:hover {
      background: rgb(218, 214, 214);
    }
    .popup-control-btn .icon-spinner {
      width: 18px;
      height: 18px;
      animation: popup-spin 0.8s linear infinite;
    }
    @keyframes popup-spin {
      to { transform: rotate(360deg); }
