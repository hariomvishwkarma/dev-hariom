  // Sorting functionality
  class TableSorter {
    constructor(tableId, sortSelectId) {
      this.table = document.querySelector(tableId);
      this.sortSelect = document.getElementById(sortSelectId);
      this.rows = Array.from(this.table.querySelectorAll('tbody tr'));
      this.canonicalIndicesSet = false;
      this.init();
    }

    init() {
      // Set default to A to Z
      this.sortSelect.value = 'oldest';
      
      // Apply initial sort
      this.sortTable();
      
      // Add event listener for future changes
      if (this.sortSelect) {
        this.sortSelect.addEventListener('change', () => this.sortTable());
      }
    }

    sortTable() {
      const sortValue = this.sortSelect.value;
      const tbody = this.table.querySelector('tbody');
      
      switch(sortValue) {
        case 'az':
          this.sortByTitle(true);
          break;
        case 'za':
          this.sortByTitle(false);
          break;
        case 'oldest':
          this.sortByDate(true);
          break;
        case 'newest':
          this.sortByDate(false);
          break;
      }

      // Re-append sorted rows
      this.rows.forEach(row => tbody.appendChild(row));
      
      // Update row numbers after sorting
      this.updateRowNumbers();
    }

    sortByTitle(ascending = true) {
      this.rows.sort((a, b) => {
        const titleA = a.getAttribute('data-title').toLowerCase();
        const titleB = b.getAttribute('data-title').toLowerCase();
        
        if (titleA < titleB) return ascending ? -1 : 1;
        if (titleA > titleB) return ascending ? 1 : -1;
        return 0;
      });
    }

    sortByDate(ascending = true) {
      this.rows.sort((a, b) => {
        const dateA = this.parseDate(a.cells[2].textContent);
        const dateB = this.parseDate(b.cells[2].textContent);
        
        if (ascending) {
          return dateA - dateB;
        } else {
          return dateB - dateA;
        }
      });
    }

    parseDate(dateString) {
      // Parse date in format "dd.mm.yyyy"
      const parts = dateString.split('.');
      if (parts.length === 3) {
        return new Date(parts[2], parts[1] - 1, parts[0]);
      }
      return new Date(0); // Return epoch date if parsing fails
    }

    updateRowNumbers() {
      const sortValue = this.sortSelect ? this.sortSelect.value : 'oldest';
      if (sortValue === 'oldest' && !this.canonicalIndicesSet) {
        this.rows.forEach((row, index) => {
          row.setAttribute('data-track-index', String(index + 1));
        });
        this.canonicalIndicesSet = true;
      }
      this.rows.forEach((row) => {
        const num = parseInt(row.getAttribute('data-track-index'), 10) || 1;
        row.cells[0].textContent = `(${num < 10 ? '0' + num : num})`;
      });
    }
  }

  // Filter functionality
  class TableFilter {
    constructor(filterContainerClass, tableClass) {
      this.filterButtons = document.querySelectorAll(`${filterContainerClass} .filter-btn`);
      this.table = document.querySelector(tableClass);
      this.rows = Array.from(this.table.querySelectorAll('tbody tr'));
      this.currentFilter = 'all';
      this.init();
    }

    init() {
      // Attach click events to all filter buttons
      this.filterButtons.forEach(btn => {
        btn.addEventListener('click', (e) => {
          e.preventDefault();
          const selectedTag = btn.getAttribute('data-tag');
          if (btn.classList.contains('active')) {
            // Active remove karo
            btn.classList.remove('active');

            // Table reset (all rows show)
            this.filterTable('all');
            this.highlightMatchingRows('all');
          } else {
            // Normal behavior
            this.filterTable(selectedTag);
            this.setActiveButton(btn);
            this.highlightMatchingRows(selectedTag);
          }
        });
      });

      // ✅ Make the first filter button active by default
      {% comment %} if (this.filterButtons.length > 0) {
        const firstBtn = this.filterButtons[0];
        const defaultTag = firstBtn.getAttribute('data-tag') || 'all';
        this.filterTable(defaultTag);
        this.setActiveButton(firstBtn);
        this.highlightMatchingRows(defaultTag);
      } {% endcomment %}
    }

    filterTable(tag) {
      this.currentFilter = tag;
      this.rows.forEach(row => {
        const rowTags = row.getAttribute('data-tags');
        if (tag === 'all' || !rowTags) {
          row.style.display = '';
        } else {
          const tagsArray = rowTags.split(',').map(t => t.trim()).filter(t => t !== '');
        }
      });

      // Update row numbers after filtering
      this.updateRowNumbers();
    }

    setActiveButton(activeBtn) {
      this.filterButtons.forEach(btn => {
        btn.classList.remove('active');
      });
      activeBtn.classList.add('active');
    }

    highlightMatchingRows(selectedTag) {
      this.rows.forEach(row => {
        row.classList.remove('highlighted');
      });

      if (selectedTag === 'all') return;

      this.rows.forEach(row => {
        const rowTags = row.getAttribute('data-tags');
        if (rowTags) {
          const tagsArray = rowTags.split(',').map(t => t.trim()).filter(t => t !== '');
          if (tagsArray.includes(selectedTag)) {
            row.classList.add('highlighted');
          }
        }
      });
    }

    updateRowNumbers() {
      const rowsInOrder = Array.from(this.table.querySelectorAll('tbody tr'));
      rowsInOrder.forEach((row) => {
        const num = parseInt(row.getAttribute('data-track-index'), 10) || 1;
        row.cells[0].textContent = `(${num < 10 ? '0' + num : num})`;
      });
    }
  }

  // Artwork fetcher
  class SoundCloudArtworkFetcher {
    static async getArtworkUrl(trackUrl) {
      try {
        const oEmbedUrl = `https://soundcloud.com/oembed?url=${encodeURIComponent(trackUrl)}&format=json`;
        const response = await fetch(oEmbedUrl);
        if (!response.ok) throw new Error('Failed to fetch track info');
        const data = await response.json();
        return this.extractArtworkUrl(data);
      } catch (error) {
        console.error('Error fetching artwork:', error);
        return null;
      }
    }

    static extractArtworkUrl(data) {
      if (!data) return null;
      if (data.thumbnail_url) return data.thumbnail_url.replace('-large', '-t500x500');
      if (data.html) {
        const html = data.html;
        const artworkMatch = html.match(/artwork_url=([^&]+)/);
        if (artworkMatch && artworkMatch[1]) {
          let artworkUrl = decodeURIComponent(artworkMatch[1]);
          return artworkUrl.replace('-large', '-t500x500');
        }
      }
      return null;
    }

    static loadImage(url) {
      return new Promise((resolve, reject) => {
        const img = new Image();
        img.onload = () => resolve(url);
        img.onerror = () => reject(new Error('Failed to load image'));
        img.src = url;
      });
    }
  }

  // Popup manager with runtime range - FIXED VERSION
  class SoundCloudPopupManager {
    constructor() {
      this.popup = document.getElementById('soundcloud-popup');
      this.close_popup = document.getElementById('soundcloud_overlay');
      this.trackTitle = document.getElementById('popup-track-title');
      this.playerIframe = document.getElementById('popup-player');
      this.playToggleBtn = document.getElementById('popup-play-toggle');
      this.timeDisplay = document.getElementById('time-display');
      this.artworkImg = document.getElementById('popup-artwork');
      this.artworkLoading = document.getElementById('artwork-loading');
      this.timeRange = document.getElementById('time-range');

      this.currentWidget = null;
      this.isPlaying = false;
      this.currentTrackUrl = null;
      this.totalDuration = 0;
      this.isSeeking = false;
      this.timeUpdateInterval = null;
      this.widgetReady = false;
      this.lastPosition = 0;
      this.isLoading = false;
      
      this.hasUserUnlocked = false;
      this.isToggling = false;

      this.initEvents();
    }

    initEvents() {
      this.close_popup.addEventListener('click', (e) => {
        if (e.target === this.close_popup) this.close();
      });

      this.playToggleBtn.addEventListener('click', () => this.togglePlayPause());

      // Range interactions - FIXED
      this.timeRange.addEventListener('input', (e) => {
        if (!this.widgetReady) return;
        
        const seconds = parseInt(e.target.value, 10) || 0;
        this.lastPosition = seconds * 1000;
        
        // Update time display live while dragging
        this.updateTimeDisplay(this.lastPosition, this.totalDuration);
      });

      // User started dragging
      this.timeRange.addEventListener('mousedown', () => { 
        this.isSeeking = true; 
        this.stopTimeUpdate();
      });

      this.timeRange.addEventListener('touchstart', () => { 
        this.isSeeking = true; 
        this.stopTimeUpdate();
      });

      // User finished dragging - FIXED SEEKING
      const seekComplete = () => {
        if (!this.widgetReady || !this.isSeeking) return;
        
        this.isSeeking = false;
        const seconds = parseInt(this.timeRange.value, 10) || 0;
        
        if (this.currentWidget) {
          // Seek to the new position
          this.currentWidget.seekTo(seconds * 1000);
          
          // Restart time updates
          this.startTimeUpdate();
          
          // If it was playing before seeking, ensure it continues playing
          if (this.isPlaying) {
            setTimeout(() => {
              this.currentWidget.play();
            }, 100);
          }
        }
      };
      this.timeRange.addEventListener('touchend', () => {
        if (!this.widgetReady) return;

        const seconds = parseInt(this.timeRange.value, 10) || 0;
        this.currentWidget.seekTo(seconds * 1000);

        if (this.isPlaying) {
          this.currentWidget.play();
        }
      });


      this.timeRange.addEventListener('mouseup', seekComplete);
      this.timeRange.addEventListener('touchend', seekComplete);
      this.timeRange.addEventListener('change', seekComplete);

      // Keyboard support
      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && this.popup.classList.contains('show')) this.close();
        if (e.key === ' ' && this.popup.classList.contains('show')) {
          e.preventDefault();
          this.togglePlayPause();
        }
      });
    }

    async open(trackUrl, title) {
      this.resetPopup();
      this.isLoading = true;
      this.updatePlayButton();

      this.trackTitle.textContent = title;
      this.currentTrackUrl = trackUrl;

      if (window.innerWidth <= 767) {
        document.body.classList.add('mobile-soundbar-show');
      }

      this.timeDisplay.textContent = '0:00 / 0:00';
      this.timeRange.value = 0;
      this.timeRange.max = 0;
      this.artworkLoading.style.display = 'block';
      {% comment %} this.artworkImg.style.display = 'none'; {% endcomment %}

      this.popup.style.display = 'flex';
      this.popup.classList.remove('hide');
      setTimeout(() => this.popup.classList.add('show'), 50);

      this.loadArtwork(trackUrl);
      await this.initializePlayer(trackUrl);
      
      // Auto-play attempt (desktop/already unlocked)
      setTimeout(() => {
        if (this.currentWidget) {
          if (this.hasUserUnlocked) {
             this.currentWidget.play();
          } else {
             // For valid auto-play on mobile without unlock interaction, we generally can't.
             // But we can try. If it fails, the user must click play, triggering logic.
             // We won't force unlockAudioAndPlay here as it requires user gesture in the stack.
             this.currentWidget.play();
          }
        }
      }, 300);
    }

    async loadArtwork(trackUrl) {
      try {
        const artworkUrl = await SoundCloudArtworkFetcher.getArtworkUrl(trackUrl);
        if (artworkUrl) {
          await SoundCloudArtworkFetcher.loadImage(artworkUrl);
          this.artworkImg.src = artworkUrl;
          this.artworkImg.style.display = 'block';
          this.artworkLoading.style.display = 'none';
        } else {
          this.artworkLoading.style.display = 'none';
        }
      } catch (error) {
        console.error('Error loading artwork:', error);
        this.artworkLoading.style.display = 'none';
      }
    }

    initializePlayer(trackUrl) {
      return new Promise((resolve) => {
        const playerUrl = `https://w.soundcloud.com/player/?url=${encodeURIComponent(trackUrl)}&auto_play=false&hide_related=true&show_comments=false&show_user=true&show_reposts=false&show_teaser=false&visual=false&enable_api=true`;
        
        // Clear previous iframe completely
        this.playerIframe.src = '';
        this.playerIframe.remove();
        
        // Create new iframe
        const newIframe = document.createElement('iframe');
        newIframe.id = 'popup-player';
        newIframe.style.display = 'none';
        newIframe.allow = 'autoplay';
        newIframe.scrolling = 'no';
        newIframe.frameborder = 'no';
        newIframe.title = 'SoundCloud iframe';
        
        // Add playsinline for mobile
        newIframe.setAttribute('playsinline', '');
        newIframe.setAttribute('webkit-playsinline', '');
        newIframe.setAttribute(
          'allow',
          'autoplay; encrypted-media'
        );

        
        newIframe.src = playerUrl;
        
        this.playerIframe = newIframe;
        document.querySelector('.soundcloud-popup-content').appendChild(newIframe);

        setTimeout(() => {
          this.initWidget(resolve);
        }, 500);
      });
    }

    resetPopup() {
      this.stopTimeUpdate();
      this.isPlaying = false;
      this.widgetReady = false;
      this.isLoading = false;
      this.updatePlayButton();
      this.artworkImg.src = '';
      this.timeRange.value = 0;
      this.timeRange.max = 0;
      this.totalDuration = 0;
      this.currentTrackUrl = null;
      this.lastPosition = 0;
      
      // Don't reset hasUserUnlocked here as we want to remember it for the session
      this.isToggling = false;

      if (this.currentWidget) {
        try {
          this.currentWidget.unbind(window.SC.Widget.Events.READY);
          this.currentWidget.unbind(window.SC.Widget.Events.PLAY);
          this.currentWidget.unbind(window.SC.Widget.Events.PAUSE);
          this.currentWidget.unbind(window.SC.Widget.Events.FINISH);
          this.currentWidget.unbind(window.SC.Widget.Events.PLAY_PROGRESS);
        } catch (e) {
          console.log('Error unbinding widget events:', e);
        }
        this.currentWidget = null;
      }
    }

    initWidget(onReady) {
      if (!window.SC) {
        // Load API if not present
        const script = document.createElement('script');
        script.src = 'https://w.soundcloud.com/player/api.js';
        script.onload = () => setTimeout(() => this.initWidget(onReady), 100);
        document.head.appendChild(script);
        return;
      }

      let attempts = 0;
      const tryInit = () => {
        try {
          this.currentWidget = window.SC.Widget(this.playerIframe);
          
          // Clear previous bindings and set up new ones
          this.currentWidget.unbind(window.SC.Widget.Events.READY);
          this.currentWidget.unbind(window.SC.Widget.Events.PLAY);
          this.currentWidget.unbind(window.SC.Widget.Events.PAUSE);
          this.currentWidget.unbind(window.SC.Widget.Events.FINISH);
          this.currentWidget.unbind(window.SC.Widget.Events.PLAY_PROGRESS);

          this.currentWidget.bind(window.SC.Widget.Events.READY, () => {
            console.log('Widget READY');
            this.widgetReady = true;
            this.isLoading = false;
            this.isPlaying = true;
            this.updatePlayButton();

            // Get duration and set up range
            this.currentWidget.getDuration((duration) => {
              this.totalDuration = duration || 0;
              const seconds = Math.floor((this.totalDuration || 0) / 1000);
              this.timeRange.max = seconds;
              this.updateTimeDisplay(0, this.totalDuration);
            });

            this.startTimeUpdate();
            if (onReady) onReady();
          });

          this.currentWidget.bind(window.SC.Widget.Events.PLAY, () => {
            if (!this.isToggling) {
                console.log('Widget PLAY');
                this.isPlaying = true;
                this.updatePlayButton();
                this.startTimeUpdate();
            }
          });

          this.currentWidget.bind(window.SC.Widget.Events.PAUSE, () => {
            if (!this.isToggling) {
                console.log('Widget PAUSE');
                this.isPlaying = false;
                this.updatePlayButton();
                this.stopTimeUpdate();
            }
          });

          this.currentWidget.bind(window.SC.Widget.Events.FINISH, () => {
            console.log('Widget FINISH');
            this.isPlaying = false;
            this.updatePlayButton();
            this.stopTimeUpdate();
            if (this.totalDuration) {
              this.updateTimeDisplay(0, this.totalDuration);
              this.timeRange.value = 0;
            }
          });

          // FIXED: Proper progress tracking
          this.currentWidget.bind(window.SC.Widget.Events.PLAY_PROGRESS, (data) => {
            if (!this.isSeeking && this.widgetReady && data && data.currentPosition !== undefined) {
              this.lastPosition = data.currentPosition;
              const currentSeconds = Math.floor(data.currentPosition / 1000);
              
              // Update display
              this.updateTimeDisplay(data.currentPosition, this.totalDuration);
              
              // Update range if value changed significantly
              if (Math.abs(parseInt(this.timeRange.value) - currentSeconds) > 0.5) {
                this.timeRange.value = currentSeconds;
              }
            }
          });

        } catch (error) {
          console.error('Error initializing SoundCloud widget:', error);
          attempts++;
          if (attempts < 5) {
            setTimeout(tryInit, 300);
          } else {
            console.error('Failed to initialize SoundCloud widget after multiple attempts');
            this.isLoading = false;
            this.updatePlayButton();
          }
        }
      };

      tryInit();
    }

    startTimeUpdate() {
      this.stopTimeUpdate();
      this.timeUpdateInterval = setInterval(() => {
        if (this.currentWidget && this.isPlaying && !this.isSeeking && this.widgetReady) {
          // Use the last known position from PLAY_PROGRESS events
          if (this.lastPosition !== undefined) {
            const currentSeconds = Math.floor(this.lastPosition / 1000);
            this.timeRange.value = currentSeconds;
            this.updateTimeDisplay(this.lastPosition, this.totalDuration);
          }
        }
      }, 200); // More frequent updates for smoother experience
    }

    stopTimeUpdate() {
      if (this.timeUpdateInterval) {
        clearInterval(this.timeUpdateInterval);
        this.timeUpdateInterval = null;
      }
    }

    updateTimeDisplay(currentMs, totalMs) {
      if (currentMs === undefined || totalMs === undefined) return;
      this.timeDisplay.textContent = `${this.formatTime(currentMs)} / ${this.formatTime(totalMs)}`;
    }

    formatTime(milliseconds) {
      const totalSeconds = Math.floor((milliseconds || 0) / 1000);
      const minutes = Math.floor(totalSeconds / 60);
      const seconds = totalSeconds % 60;
      return `${minutes}:${String(seconds).padStart(2, '0')}`;
    }

    unlockAudioAndPlay() {
      this.isToggling = true;

      this.currentWidget.play();
      setTimeout(() => {
        this.currentWidget.pause();
        this.hasUserUnlocked = true;

        this.togglePlayback();
      }, 120);
    }

    togglePlayback() {
      this.isToggling = true;

      this.currentWidget.isPaused(paused => {
        // Optimistic UI update
        this.isPlaying = paused; 
        this.updatePlayButton();
        
        paused ? this.currentWidget.play() : this.currentWidget.pause();

        setTimeout(() => {
          this.currentWidget.isPaused(p => {
             // Confirm UI state
            this.isPlaying = !p;
            this.updatePlayButton();
            this.isToggling = false;
            
            if (this.isPlaying) {
                this.startTimeUpdate();
            } else {
                this.stopTimeUpdate();
            }
          });
        }, 400);
      });
    }

    togglePlayPause() {
      if (!this.currentWidget || !this.widgetReady || this.isToggling) return;
      
      if (!this.hasUserUnlocked) {
        this.unlockAudioAndPlay();
        return;
      }
      
      this.togglePlayback();
    }

    updatePlayButton() {
      if (this.isLoading) {
        const spinnerIcon = `<svg class="icon-spinner" width="18" height="18" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 18 18"><circle cx="9" cy="9" r="7" stroke="currentColor" stroke-width="2" stroke-dasharray="32" stroke-dashoffset="8" stroke-linecap="round"/></svg>`;
        this.playToggleBtn.innerHTML = spinnerIcon;
        this.playToggleBtn.setAttribute('aria-label', 'Loading');
        return;
      }
      const playIcon = `
  <svg width="20" height="20" xmlns="http://www.w3.org/2000/svg" fill="none" class="icon icon-play" viewBox="0 0 10 14"><path fill="currentColor" fill-rule="evenodd" d="M1.482.815A1 1 0 0 0 0 1.69v10.517a1 1 0 0 0 1.525.851L10.54 7.5a1 1 0 0 0-.043-1.728z" clip-rule="evenodd"/></svg>
      `;

      const pauseIcon = `
    <svg width="20" height="20" xmlns="http://www.w3.org/2000/svg" fill="none" class="icon icon-pause" viewBox="0 0 8 12"><path fill="currentColor" d="M1.2.75c-.387 0-.7.235-.7.525v9.45c0 .29.313.525.7.525s.7-.235.7-.525v-9.45c0-.29-.313-.525-.7-.525m5.6 0c-.387 0-.7.235-.7.525v9.45c0 .29.313.525.7.525s.7-.235.7-.525v-9.45c0-.29-.313-.525-.7-.525"/></svg>
      `;

      this.playToggleBtn.innerHTML = this.isPlaying ? pauseIcon : playIcon;
      this.playToggleBtn.setAttribute('aria-label', this.isPlaying ? 'Pause' : 'Play');
    }

    close() {
      // Pause the audio first before resetting everything
      if (this.currentWidget && this.widgetReady && this.isPlaying) {
        try {
          this.currentWidget.pause();
        } catch (e) {
          console.error('Error pausing audio on close:', e);
        }
      }
      if (window.innerWidth <= 767) {
        document.body.classList.remove('mobile-soundbar-show');
      }

      this.stopTimeUpdate();
      this.isPlaying = false;
      this.updatePlayButton();
      
      this.popup.classList.remove('show');
      document.body.classList.remove('sound-active');
      this.popup.classList.add('hide');
      document.querySelectorAll('.open-popup').forEach(btn => btn.classList.remove('active-p-btn'));
      setTimeout(() => {
        this.popup.style.display = 'none';
        this.popup.classList.remove('hide'); 
        // Reset popup state after animation completes
        this.resetPopup();
      }, 400);
    }
  }

  // Initialize everything when DOM is loaded
  document.addEventListener('DOMContentLoaded', () => {
    // Initialize table sorter
    const tableSorter = new TableSorter('.radio-table', 'sortSelect');
    
    // Initialize popup manager
    const popupManager = new SoundCloudPopupManager();

    // Initialize table filter
    const tableFilter = new TableFilter('.tag-filters', '.radio-table');

    // Mobile default song auto-play
    const isMobile = window.innerWidth <= 767;
    if (isMobile) {
      const defaultTrackUrl = 'https://api.soundcloud.com/tracks/2258402849';
      const defaultTitle = 'CR#047 - C-PASH • CR#047 - C-PASH • CR#047 - C-PASH'; // Yahan track ka naam dal sakte ho
      
      // Wait for popup manager to be ready, then open
      setTimeout(() => {
        popupManager.open(defaultTrackUrl, defaultTitle);
      }, 500);
    }

    // Set up click handlers for popup rows - iOS compatible
    const handleRowClick = (row, e) => {
      if (e) {
        e.preventDefault();
        e.stopPropagation();
      }
      
      const trackUrl = row.getAttribute('data-url');
      const title = row.getAttribute('data-title');
      const openPopupBtn = row.querySelector('.open-popup');

      document
        .querySelectorAll('.popup-row .open-popup')
        .forEach(btn => btn.classList.remove('active-p-btn'));
      document.body.classList.remove('sound-active');

      if (openPopupBtn) {
        openPopupBtn.classList.add('active-p-btn');
        document.body.classList.add('sound-active');
      }


      if (trackUrl) {
        popupManager.open(trackUrl, title);
      } else {
        alert('No SoundCloud URL found for this track.');
      }
    };

    // Track touch start positions and times per row
    const touchData = new Map();
    const touchHandled = new Set();

    // Add click handlers to entire rows (works better on iOS)
    document.querySelectorAll('.popup-row').forEach(row => {
      // Store row-specific touch data
      const rowId = row.getAttribute('data-url') || Math.random().toString();
      
      // Handle click events (for desktop and as fallback)
      row.addEventListener('click', (e) => {
        // On iOS, sometimes click fires after touchend, so check if touch was already handled
        if (touchHandled.has(rowId)) {
          touchHandled.delete(rowId);
          return;
        }
        handleRowClick(row, e);
      }, false);

      // Handle touch events for iOS Safari - more reliable approach
      row.addEventListener('touchstart', (e) => {
        const touch = e.touches[0];
        touchData.set(rowId, {
          startTime: Date.now(),
          startX: touch.clientX,
          startY: touch.clientY,
          row: row
        });
      }, { passive: true });

      row.addEventListener('touchend', (e) => {
        const data = touchData.get(rowId);
        if (!data) return;
        
        const touch = e.changedTouches[0];
        if (!touch) return;
        
        const touchDuration = Date.now() - data.startTime;
        const deltaX = Math.abs(touch.clientX - data.startX);
        const deltaY = Math.abs(touch.clientY - data.startY);
        const distance = Math.sqrt(deltaX * deltaX + deltaY * deltaY);
        
        // Only trigger if it was a quick tap (not a swipe) - more lenient for iOS
        if (touchDuration < 600 && distance < 30) {
          e.preventDefault();
          e.stopPropagation();
          // Mark that touch was handled to prevent duplicate click events
          touchHandled.add(rowId);
          // Use setTimeout to ensure the event is processed correctly on iOS
          setTimeout(() => {
            handleRowClick(data.row, null);
            // Clear the flag after a delay to allow for click event if needed
            setTimeout(() => touchHandled.delete(rowId), 300);
          }, 0);
        }
        
        touchData.delete(rowId);
      }, { passive: false });

      // Handle touchcancel (when user scrolls instead of taps)
      row.addEventListener('touchcancel', () => {
        touchData.delete(rowId);
      }, { passive: true });

      // Also handle clicks on the .open-popup link for backward compatibility
      const openPopupBtn = row.querySelector('.open-popup');
      if (openPopupBtn) {
        openPopupBtn.addEventListener('click', (e) => {
          // Let the row handler take care of it, but ensure it works
          if (!row.contains(e.target)) return;
          handleRowClick(row, e);
        });
      }
    });
  });

  const checkForm = setInterval(() => {
    const existingStyle = document.querySelector("#form-embed-style");
    const shadowHosts = document.querySelectorAll("shopify-forms-embed");

    if (shadowHosts.length > 0 && existingStyle) {
      shadowHosts.forEach((form) => {
        const shadow = form.shadowRoot;
        if (shadow && !shadow.querySelector("#form-embed-style")) {
          // Clone and append style
          const clonedStyle = existingStyle.cloneNode(true);
          shadow.querySelector('#app-embed').appendChild(clonedStyle);
        }
      });

      clearInterval(checkForm);
    }
  }, 200);
</script>

