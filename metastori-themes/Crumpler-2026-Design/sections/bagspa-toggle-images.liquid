<style>
.bsim-wrapper {
    height: 70vh;
    display: flex;
    justify-content: center;
    align-items: center;
    overflow: hidden;
}
.bsim-toggle img, .bsim-toggle video{
    max-width:100%;
}
.bsim-toggle{
    display:none;
    cursor:pointer;
}
#stretch {
    width: 240px;
    cursor: pointer;
    display: block;
    transform-origin: center;
    will-change: transform;
  }
.toggle_active .bsim-toggle-icon{
    display:none;
}
.toggle_active .bsim-toggle{
    display:block;
}

@media (max-width:767px){
    .bsim-wrapper{
        min-height: 540px;
    }
    .bsim-toggle-icon {
        top: 150px;
    }
}
</style>
<div class="bagspa-toggle-image-main">
    <div class="bsim-wrapper">
        {%if section.settings.icon != blank %}
            <img class="bsim-toggle-icon" id="stretch" src="{{ section.settings.icon | image_url }}" alt="icon" width="auto" height="auto">
        {%endif %}
        <div class="bsim-toggle">
            {% if section.settings.image != blank %}
                <img class="bsim-toggle-image" src="{{ section.settings.image | image_url }}" width="auto" height="auto" alt="toggle-image">
            {% else %}
                {{ section.settings.video | video_tag:autoplay:true, loop:true, controls:false, class:'bsim-toggle-video' }}
            {%endif %}
        </div>
    </div>
</div>

<script>
    {% comment %} document.addEventListener('DOMContentLoaded', function() {
        const toggleIcon = document.querySelector('.bsim-toggle-icon');
        const toggleBtn = document.querySelector('.bsim-toggle');

        if (toggleIcon) {
            toggleIcon.addEventListener('click', function() {
                this.closest('.bsim-wrapper').classList.toggle('toggle_active');
            });
        }

        if (toggleBtn) {
            toggleBtn.addEventListener('click', function() {
                this.closest('.bsim-wrapper').classList.toggle('toggle_active');
            });
        }
    }); {% endcomment %}
</script>
<script>
  const img = document.getElementById("stretch");

  let running = false;
  let lastTime = null;

  // Animation progress from 0 → 1
  let progress = 0;

  const maxWidthPx = 9200;
  const duration = 7000; // ms (total time to reach max width)

  // Smooth ease-in-out function (nice and simple)
  function easeInOutCubic(t) {
    return t < 0.5
      ? 4 * t * t * t
      : 1 - Math.pow(-2 * t + 2, 3) / 2;
  }

  function animate(t) {
    if (!running) return;

    if (lastTime === null) lastTime = t;
    const dt = t - lastTime;
    lastTime = t;

    // progress grows based on duration
    progress = Math.min(1, progress + dt / duration);

    const eased = easeInOutCubic(progress);

    // Compute the scale needed to hit maxWidthPx
    const baseWidth = img.offsetWidth;              // starting width in px
    const maxScale = maxWidthPx / baseWidth;        // scale needed to reach 1200px
    const scaleX = 1 + (maxScale - 1) * eased;      // eased scale from 1 → maxScale

    img.style.transform = `scaleX(${scaleX})`;

    // Stop at the end (ease-out finishes cleanly)
    if (progress >= 1) {
      running = false;
      return;
    }

    requestAnimationFrame(animate);
  }

  img.addEventListener("click", () => {
    running = !running;

    if (running) {
      lastTime = null;
      requestAnimationFrame(animate);
    }
  });
</script>
{% schema %}
{
  "name": "Bagspa Toggle Images",
  "tag": "section",
  "class": "section",
  "settings": [
    {
        "type": "image_picker",
        "id":"icon",
        "label": "Icon"
    },
    {
        "type": "image_picker",
        "id":"image",
        "label": "Toggle Image"
    },
    {
        "type": "video",
        "id":"video",
        "label": "Toggle Video"
    }
  ],
  "presets": [
    {
      "name": "Bagspa Toggle Images"
    }
  ]
}
{% endschema %}
