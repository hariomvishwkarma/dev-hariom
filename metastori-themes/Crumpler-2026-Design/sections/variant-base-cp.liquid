{{ 'template-collection.css' | asset_url | stylesheet_tag }}
{{ 'component-card.css' | asset_url | stylesheet_tag }}
{{ 'component-price.css' | asset_url | stylesheet_tag }}

{% if section.settings.image_shape == 'blob' %}
  {{ 'mask-blobs.css' | asset_url | stylesheet_tag }}
{%- endif -%}

{%- unless section.settings.quick_add == 'none' -%}
  {{ 'quick-add.css' | asset_url | stylesheet_tag }}
{%- endunless -%}

{%- if section.settings.quick_add == 'standard' -%}
  <script src="{{ 'quick-add.js' | asset_url }}" defer="defer"></script>
  <script src="{{ 'product-form.js' | asset_url }}" defer="defer"></script>
{%- endif -%}

{%- if section.settings.quick_add == 'bulk' -%}
  <script src="{{ 'quick-add-bulk.js' | asset_url }}" defer="defer"></script>
  <script src="{{ 'quantity-popover.js' | asset_url }}" defer="defer"></script>
  <script src="{{ 'price-per-item.js' | asset_url }}" defer="defer"></script>
  <script src="{{ 'quick-order-list.js' | asset_url }}" defer="defer"></script>
{%- endif -%}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}
{% style %}

    .cst-product-card {
      text-align: left;
      position: relative;
      overflow: hidden;
      transition: opacity 0.3s ease;
    }

    .cst-main-slider .cst-slide-inner {
      width: 100%;
      aspect-ratio: 17/20;
    }

    .cst-image-link {
      position: relative;
      display: inline-block;
      width: 100%;
    }

    .cst-product-image-wrapper {
      aspect-ratio: 17/20;
      position: relative;
      overflow: hidden;
    }
    .cst-product-image-wrapper video{
      max-width: 100%;
      object-fit: cover;
      height: 100%;
      width: 100%;
    }

    .cst-product-image {
      display: block;
      height: 100%;
      max-width:100%;
      width:100%;
    }
    .cst-product-image.skeleton,
    .cst-swatch-image.skeleton {
      opacity: 0;
    }

    .cst-swatch-image-wrapper {
      position: relative;
      background-color: #eee;
      overflow: hidden;
      display: flex;
      width: fit-content;
      height: fit-content;
    }

    .cst-swatch-wrapper .swiper-slide {
        width: fit-content!important;
    }

    .cst-swatch-image {
      display: block;
      cursor:pointer;
      height: 100%;
    }

    /* Disabled overlay – bg only (Safari iOS may not paint; use SVG version if needed) */
    .cst-disabled-overlay {
      position: absolute;
      top: 0;
      right: 0;
      bottom: 0;
      left: 0;
      z-index: 2;
      display: block;
      -webkit-backface-visibility: hidden;
      backface-visibility: hidden;
      min-width: 100%;
      min-height: 100%;
      box-sizing: border-box;
      background-color: {{ section.settings.overlay_color | default: '#FF9C9C' }};
      opacity: {{ section.settings.overlay_opacity | default: 0.4 }};
    }
    .cst-disabled::after {
      content: '{{ section.settings.soldout_text | default: 'Sold Out :(' }}';
      position: absolute;
      top: 50%;
      left: 50%;
      z-index: 1;
      display: block;
      transform: translate(-50%,-50%) rotate(-47.09deg);
      font-size: 75px;
      color: {{ section.settings.overlay_color | default: '#FF0000' }};
      width: max-content;
    }

    .cst-product-title {
      margin-top: 4px;
      font-weight: 600;
      text-transform: uppercase;
      color:#000000;
      text-decoration:none;
      display: flex;
      align-items: center;
      padding: 0 0 0 10px;
      gap: 5px;
    }

    .cst-product-price {
      display: inline-flex;
      align-items: center;
      gap: 0.25em;
      white-space: nowrap;
    }

    .cst-product-price--sale .cst-product-price-current {
      color: #d0021b;
      font-weight: 700;
    }

    .cst-product-price--sale .cst-product-price-compare {
      text-decoration: line-through;
      opacity: 0.75;
      color: inherit;
      font-weight: 400;
    }

    .product_card_image_badges {
      position: absolute;
      top: 6px;
      left: 10px;
      z-index: 5;
      display: flex;
      flex-wrap: wrap;
    }
    .product_card_image_badges img {
        max-height: 20px;
        object-fit: contain;
    }

    .cst-swatches {
      display: flex;
      align-items: center;
      margin-top: 0.4rem;
      gap: 8px;
      position: relative;
      padding: 0 10px;
    }

    .cst-swatches .cst-slide-inner {
      border: 0.8px solid transparent;
      transition: all 0.3s;
      width: fit-content;
      padding: .78px .94px .79px .96px;
    }

    .cst-swatches .swiper-slide.cst-active .cst-slide-inner {
      border-color: #333;
    }

    .cst-hidden {
      display: none !important;
    }

    .cst-pagination {
      display: flex;
      flex-wrap: wrap;
      justify-content: center;
      gap: 8px;
      margin: 30px 0;
    }

    .cst-page-button {
      padding: 2px 5px;
      text-decoration: none;
      font-size: 16px;
      color: #333;
      border-bottom: 1px solid transparent;
      transition: all 0.2s ease;
    }

    .cst-page-button:hover {
      border-color: #333;
    }

    .cst-page-button.active {
      border-color: #333;
    }

    .cst-main-slider,
    .cst-swatch-slider {
      display: block;
      width: 100%;
      overflow: hidden;
    }

    .swiper-button-prev,
    .swiper-button-next {
      position: relative;
      left: auto;
      right: auto;
      top: auto;
      bottom: auto;
      width: 18px;
      height: 100%;
      display: none;
      justify-content: center;
      align-items: center;
      margin: 0;
      justify-content: center;
      align-items: center;
      background-color: #fff;
    }

    .swiper-button-prev {
      position: absolute;
      left: 0;
      justify-content: start;
    }

    .swiper-button-next {
      position: absolute;
      right: 0;
      justify-content: end;
    }

    .swiper-button-prev::after,
    .swiper-button-next::after {
      font-size: 14px;
      color: #333;
    }

    .swiper-button-prev.swiper-button-disabled,
    .swiper-button-next.swiper-button-disabled {
      display: none !important;
    }

    @media(max-width: 425px) {
      .swiper-button-prev,
      .swiper-button-next {
        width: 14px;
      }

      .swiper-button-prev::after,
      .swiper-button-next::after {
        font-size: 10px;
        color: #333;
      }
    }

    .cst-swatches span.color-option {
        display: flex;
    }
    .cst-swatches .cst-swatch-image-wrapper span {
        display: inline-block;
        width: 27.5px;
        height: 12.5px;
        cursor: pointer;
        background-position: center;
        background: #58a7f4;
        background-size: contain;
      }

    .cst-tags-box {
      position: absolute;
      top: 0;
      left: 0;
      width: clamp(70px, 100vw, 200px);
      display: flex;
      flex-direction: column;
      gap: 5px;
      padding: 5px;
      border: 1px solid red;
    }

    .cst-img-box {
      display: flex;
      width: 70px;
      z-index: 1;
    }
    .cst-img-box img {
      display: flex;
    }
    .page-width-collection{ max-width:none; padding:0px 12px; margin:0; }

    .no-result-text {
      font-size: 26px;
      line-height: 120%;
      font-weight: 500;
    }
    .clear-filter-btn {
      background: #EEEEEE;
      color: #000000;
      text-transform: capitalize;
      min-height: 33px;
      border: 1.58px solid #000000;
      border-radius: 8px;
      min-width: 138px;
      display: inline-flex;
      justify-content: center;
      align-items: center;
      font-size: 20.52px;
    }
    .clear-filter-btn:hover {
      background: black;
      color: #eeeeee;
    }

    @media screen and (min-width: 750px) {
      .grid {
          row-gap: 39px;
      }
    }
    @media (max-width: 1024px) {
      .cst-product-title{
        margin-top: 3px;
        line-height: 1.2;
      }
      .no-result-text {
        font-size: 20px;
      }
      .clear-filter-btn{
        margin-top: 10px;
      }
    }
    @media (max-width: 767px) {
      .cst-swatches .cst-swatch-image-wrapper span {
        width: 25px;
      }
      .cst-disabled::after{
        font-size: 38px;
      }
    }
    @media (min-width:768px){
      .template-collection-old-made-in-melbourne .page-width-collection{
        width: 100%;
        max-width: 100%;
      }
      .template-collection-old-made-in-melbourne #product-grid{
        width:60% !important;
        max-width:100%;
      }
    }
{% endstyle %}

{% assign all_colors = settings.filter_colors | newline_to_br | split: '<br />' %}

<div class="section-{{ section.id }}-padding gra  dient color-{{ section.settings.color_scheme }}">
  {%- paginate collection.products by section.settings.products_per_page -%}
    <div class="{% if section.settings.filter_type == 'vertical' %} facets-vertical page-width-collection{% endif %}">

      {%- if section.settings.enable_filtering or section.settings.enable_sorting -%}
        {% style %}          
          .filter-seperation {
            display: inline-flex;
            width: 12px;
          }
          .filter-open-btn svg, .fillter--icon {
            background: #00FF00;
          }
          .filter-open-btn, .filter-drawer-count {
            cursor: pointer;
            display: flex;
            align-items: center;
            gap: 5px;
            line-height: 100%;
            font-weight: 500;
          }
          .sortby-icon {
            background: #FFE900;
            line-height: 1;
            display: flex;
            order: -1;
          }
          .filter_sort_selector:is(:focus, :hover) + .sortby-icon, .sortby-icon:hover {
            background: #0085FF;
          }
          .filter_sort_selector:is(:focus, :hover) + .sortby-icon svg path, .sortby-icon:hover svg path {
            fill: #FF9C9C;
          }
          .filter-open-btn:hover svg {
            background: #FF0000;
          }
          .filter-open-btn:hover {
            color: #00FBFF;
          }
          .filter-open-btn:hover svg path{
            fill: #00FBFF;
          }
          .cst-drawer-bottom {
              padding: 18px 0px 20px;
              padding-bottom: max(20px, env(safe-area-inset-bottom, 0));
              width: 100%;
              background: #fff;
          }
          @supports (-webkit-touch-callout: none) {
            .cst-drawer-bottom {
              padding-bottom: max(20px, env(safe-area-inset-bottom, 0));
            }
          }
          .filter-drawer-top{
            height: -webkit-fill-available;
            overflow: auto;
            overflow-y: scroll;
            padding-bottom: 32px;
          }
          .filter-drawer-1 {
            display: flex;
            justify-content: space-between;
            width: 100%;
          }
          .fillter--productcount {
            line-height: 1;
            color: #C4C4C4;
            font-weight: 500;
            text-transform: capitalize;
          }
          .filter-drawer-header {
            margin-bottom: 31px;
          }
          .cst-filter-panel-Colour {
              line-height: 100%;
          }
          .cst-price-range-label{
            text-transform: uppercase;
            min-width:87px;
          }

          #price_range_process{
              -webkit-appearance: none;
              width: 160px;
              height: 8px;
              border-radius: 20px;
              background: linear-gradient(to right, #222 100%, #ccc 100%);
              outline: none;
            }
            /* Thumb */
            #price_range_process::-webkit-slider-thumb {
              -webkit-appearance: none;
              width: 18px;
              height: 18px;
              border-radius: 50%;
              background: #222;
              cursor: pointer;
              border: none;
            }
            /* Firefox */
            #price_range_process::-moz-range-thumb {
              width: 18px;
              height: 18px;
              border-radius: 50%;
              background: #222;
              border: none;
              cursor: pointer;
            }

          #main-collection-filters {
          padding: 0 18px;
          }
            .cst-filter.js-filter {
              display: flex;
              gap:3px 8px;
              margin-right:13px;
              flex-wrap:wrap;
            }
            .cst-filters-row {
              display: inline-block;
            }
            .cst-filter-btn {
              margin-top: 32px;
            }
            .filter-seperator {
              margin-left: -3px;
            }
            button.cst-filter-label span.cst-values, .filter_sort_selector{
              margin-right:5px;
              text-decoration:underline;
            }
            button.cst-filter-label span.cst-values, .cst-filter-label[filter_name="price"]{
              display:none;
            }
            .filter_sort_selector {
              border: none;
              appearance: none;
              -webkit-appearance: none;
              -moz-appearance: none;
              font-weight: 500;
              text-transform: capitalize;
              font-family: "Neue Haas Grotesk Text Pro";
              background-color: transparent;
              color:#000;
            }
            @supports (-webkit-touch-callout: none) {
              .filter_sort_selector {
                background-color: transparent !important;
              }
            }
            button.cst-filter-label {
              background: white;
              border: none;
              font-family: "Neue Haas Grotesk Text Pro";
              font-weight: 500;
              line-height: calc(1 + 0.15 / var(--font-body-scale));
              display: inline-flex;
              padding:0;
              gap:5px;
              align-items: center;
              width: 100%;
              margin-bottom: 5px;
              text-transform: uppercase;
            }
            .cst-filter-label[filter_toggle_disabled] {
              pointer-events: none;
            }
            button.cst-filter-label.cst-sort-label{
              margin-right:0px;

            }
            button.cst-filter-label .icon{
              display: flex;
              line-height: 0;
            }
            ul.cst-filter-list {
              list-style: none;
              padding: 0;
              margin: 0;
              display: flex;
              gap: 0 7px;
              flex-wrap:wrap;
            }
            .cst-filters-row input:not(.price_range_filter) {
              display: none;
            }
            .cst-price-range-row {
                display: flex;
                align-items: center;
                gap: 12px;
            }

            .price_range_filter{
              min-width: 45.83px;
              border: 1px solid #606060;
              border-radius: 2px;
              background: #F1F1F1;
              text-align: center;
              font-family: "Neue Haas Grotesk Text Pro";
              text-transform: lowercase;
              height: 18.2px;
            }
            .price_range_filter::placeholder{
              color:#979797;
            }

            .price_range_filter::-webkit-outer-spin-button,
            .price_range_filter::-webkit-inner-spin-button {
              -webkit-appearance: none;
              margin: 0;
            }

            .price_range_submit {
                width: 25px;
                height: 18.2px;
                border-radius: 2.39px;
                background: #000;
                display: inline-flex;
                justify-content: center;
                align-items: center;
                padding: 0;
                cursor: pointer;
                border: 1px solid;
            }
            .filter-drawer-main {
              height: calc(100vh - 8px);
              height: calc(100dvh - 8px - env(safe-area-inset-bottom, 0));
              position: relative;
              display: flex;
              justify-content: space-between;
              flex-direction: column;
              align-items: stretch;
            }
            #main-collection-filters .cst-filters-container {
              display: flex;
              column-gap: 10px;
              align-items: baseline;
              flex-wrap: wrap;
            }
            #main-collection-filters .cst-product-count {
              color: #C4C4C4;
              font-weight: 500;
              text-transform: capitalize;
              margin-top: 5px;
              width: 100%;
            }
            #main-collection-filters .cst-clear-btn, .cst-apply-btn  {
              background: #EEEEEE;
              min-width:91px;
              height: 21px;
              opacity: 1;
              border-radius: 7px;
              border-width: 1px;
              outline: none;
              border: 1px solid;
              font-weight: 500;
              font-family: var(--font-body-family);
              cursor: pointer;
              transition: .2s all;
            }
            #main-collection-filters .cst-clear-btn:hover, .cst-apply-btn:hover {
              background: #000;
              color: #EEE;
            }
            #main-collection-filters .cst-sort-radio-item input[type="radio"]  {
              display:none;
            }
            #main-collection-filters .cst-sort-radio-list {
              display: flex;
              flex-wrap: wrap;
              gap: 9px;
              margin-left:5px;
            }
            #main-collection-filters .cst-sort-radio-list .checked{
              text-decoration:underline;
            }
            #main-collection-filters  span.filter-lable {
              white-space:nowrap;
            }
            #main-collection-filters  .cst-sort-radio-item input[type="radio"]:checked + span {
              text-decoration: underline;

            }
            #main-collection-filters  .mobile-icon{
              display:inline;
              padding-left: 5px;
            }

              #main-collection-filters .cst-filter.js-filter.cst-sort-filter{
                margin-top:2px;
              }
     
              .cst-checkbox {
                cursor: pointer;
                display: block;
                padding-left: 15px;
                position: relative;
              }
              .cst-checkbox input:checked + span:before {
                content: "";
                width: 9px;
                border: 1px solid #000000;
                height: 0;
                position: absolute;
                left: 0;
                top: 50%;
                transform: translateY(-50%);
              }
              .filter-top-text {
                font-weight: 500;
                text-transform: capitalize;
                margin-bottom: 4px;
              }
              #main-collection-filters .cst-filters-row{
                top: 0;
                left: 0;
                position: fixed;
                z-index: 100;
                background: white;
                transform: translateX(-100%);
                transition: transform 200ms ease;
                width: 380px;
                height: 100vh;
                height: calc(100dvh - env(safe-area-inset-bottom, 0));
                padding: 5px 18px 0;
              }
              .filter-drawer-top::-webkit-scrollbar {
                display: none;
              }
              #main-collection-filters .cst-filters-row .fillter--close{
                display:none;
              }
            
              #main-collection-filters .cst-filters-row.open{
                transform: translateX(0px);
              }
              #main-collection-filters .cst-filters-row.open.closing{
                transform: translateX(-100%);
              }
              button.cst-filter-label[aria-expanded="false"] {
                width: 100%;
              }
              .cst-filters-row-overlay{
                position: fixed;
                top: 0;
                left: 0;
                width: 100vw;
                height: 100vh;
                background: #0000006e;
                z-index: 99;
              }
              .cst-filters-row-overlay.open_overlay {
                display: block;
                cursor: url('https://cdn.shopify.com/s/files/1/0565/5114/5551/files/close_1.svg?v=1771493514') 16 16, auto;
              }
            @media screen and (max-width: 1025px) {
              .filter-open-btn svg {
                background: #00FF00;
                width: 172.65px;
                height: 25.11px;
              }
              #main-collection-filters {
                  padding: 0 12px;
              }
              .sortby-icon svg{
                width: 105px;
                height: 26.18px;
              }
              .sort-filter-main {
                display: flex;
              }
              .filter-open-btn{
                margin-bottom: 8px;
                width: 37%;
              }
              .filter_sort_selector{
                line-height: 1;
              }
              #main-collection-filters .cst-filters-container,
              .cst-filters-row ,
              .cst-filter.js-filter.cst-sort-filter,
              #main-collection-filters .cst-sort-radio-list{
                flex-direction:column;
              }
              #main-collection-filters .cst-sort-radio-list{
              gap:0;
              }
              #main-collection-filters .cst-clear-btn, #main-collection-filters .cst-apply-btn {
                height: auto;
                width: auto;
                min-width: 143px;
                min-height: 33px;
                font-size: 20.52px;
                border: 1.58px solid #000000;
                color:#000;
              }
              #main-collection-filters  .mobile-icon{
                display:inline;
              }
              #main-collection-filters .cst-filters-container{
                gap:0;
              }
              .price_range_filter{
                height: 32.4px;
              }
              .price_range_submit {
                height: 32.4px;
                min-width: 45.83px;
              }
              .cst-checkbox input:checked + span:before {
                width: 15px;
                border: 2px solid #000000;
              }
            }
            @media screen and (max-width: 750px) {
                #main-collection-filters .cst-filters-row{
                  width: 90%;
                  padding: 8px 12px 0;
                }
                #main-collection-filters {
                  padding: 0 12px;
                }
                .filter_sort_selector{
                  width:-webkit-fill-available;
                  font-size: 26px;
                }
                .price_range_filter::placeholder{
                  font-size: 24px !important;
                }
                .filter-drawer-1{
                  flex-direction: column;
                  width: fit-content;
                  gap: 6px;
                }
                #main-collection-filters .cst-filters-row .fillter--close{
                  display: flex;
                  width: max-content;
                }
                .mobile-filter-menu{
                  align-items: flex-start;
                }
                .cst-checkbox{
                  line-height: 40px;
                }
                button.cst-filter-label{
                  margin-bottom: 8px;
                }
                .fillter--icon svg {
                  width: 158px;
                  height: 23px;
                }
                .filter-open-btn svg, .fillter--icon{
                  display: flex;
                }
                .cst-price-range-label {
                  font-size: 13px;
                }
            }
            @media screen and (min-width: 750px) {
              .cst-drawer-bottom {
                padding: 18px 0px 12px;
                padding-bottom: max(12px, env(safe-area-inset-bottom, 0));
              }
              .cst-filters-row-overlay{
                width: calc(100vw - 200px);
                right:0;
                left: unset;
              }
            }
        {% endstyle %}

        {% assign total_active_filters = 0 %}
        {% for filter in collection.filters %}
          {% assign total_active_filters = total_active_filters | plus: filter.active_values.size %}
        {% endfor %}

        <aside id="main-collection-filters" class="cst-facets-wrapper" data-section-id="{{ section.id }}">
          <form id="CSTFacetForm" class="cst-facet-form" action="{{ collection.url }}" method="get" novalidate>
            <!-- FILTERS (horizontal style) -->
            {% if section.settings.filter_text != blank %}
              <div class="filter-top-text">{{ section.settings.filter_text }}</div>
            {% endif %}
            <div class="cst-filters-container">
              <div class="filter-open-btn">
                {% render 'filter-icon' %}
                {% if total_active_filters > 0 %}
                  <span class="filter-open-count">({{ total_active_filters }})</span>
                {% endif %}
              </div>
              {% comment %} <!------------ SORT BY ------------> {% endcomment %}
              <div class="sort-filter-main cst-filter cst-sort-filter" data-filter-name="sort_by">
                <button
                  type="button"
                  class="cst-filter-label cst-sort-label"
                  aria-expanded="false"
                  aria-controls="panel-sort"
                >
                  <select class="filter_sort_selector" name="sort_by">
                    {% for option in collection.sort_options %}
                      <option data-value="{{ option.value  }}" value="{{ option.value }}"
                        {% if option.value == collection.sort_by %} selected {% endif %}
                      >{{ option.name }}</option>
                    {% endfor %}  
                  </select>
                  <span class="sortby-icon">{% render 'sortby-icon' %}</span>
                </button>
              </div>
              <div id="ProductCount" class="cst-product-count decstop">{{ collection.products_count }} Products</div>
            </div>

            {% render 'collection-filter', total_active_filters:total_active_filters %}
          </form>
        </aside>

        <!--
          =========================
          Styles (paste into section CSS or theme stylesheet)
          =========================
        -->
        <style></style>
      {%- endif -%}

      <div
        class="product-grid-container{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}
        {%- if collection.products.size == 0 -%} productGridContainer-empty{% endif %}"
        id="ProductGridContainer"
        {% if settings.animations_reveal_on_scroll %}
          data-cascade
        {% endif %}
      >
        {%- if collection.products.size == 0 -%}
          <div class="collection collection--empty page-width-collection" id="product-grid" data-id="{{ section.id }}">
            <div class="loading-overlay gradient"></div>
            <div class="title-wrapper center">
              {% assign coll_link = '<a class="clear-filter-btn" href="' | append:collection.url | append:'">clear filters</a>' %}
              {% if section.settings.no_result_text != blank %}
                <div class="no-result-text">{{ section.settings.no_result_text | replace:'[clear filters]',coll_link }}</div>
              {% endif %}
            </div>
          </div>
        {%- else -%}
          <div
            class="collection{% if section.settings.filter_type != 'vertical' %} page-width-collection{% endif %}"
          >
            <div class="loading-overlay gradient"></div>
            <ul
              id="product-grid"
              data-id="{{ section.id }}"
              class="00 
                grid product-grid grid--{{ section.settings.columns_mobile }}-col-tablet-down
                grid--{{ section.settings.columns_desktop }}-col-desktop 
                {% if section.settings.quick_add == 'bulk' %} collection-quick-add-bulk{% endif %}
              "
            >
              {% assign rendered_product_count = 0 %}
              {%- for product in collection.products -%}
                {%- assign hide_from_collection = product.metafields.custom.hide_form_collection -%}

                {%- if hide_from_collection == blank or hide_from_collection == false -%}

                  {% comment %} Count valid slides for this product {% endcomment %}
                  {% assign color_option_names = 'color,colour' | split: ',' %}
                  {% for option in product.options_with_values %}
                    {% assign option_name_down = option.name | downcase %}
                    {% if color_option_names contains option_name_down %}
                      {% assign option_index = option.position | minus: 1 %}
                      {% for color in option.values %}
                        {% for variant in product.variants %}
                          {% if variant.options[option_index] == color and variant.metafields.custom.hide_variant_from_collection_page != true %}

                                {% if section.settings.sale_variant_show == false and variant.compare_at_price > variant.price %}
                                  {% continue %}
                                {% endif %}

                                {% if section.settings.show_compare_at_price_variant_only == true %}
                                  {% unless variant.compare_at_price > variant.price %}
                                    {% continue %}
                                  {% endunless %}
                                {% endif %}

                                <li
                                  class="grid__item{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}"
                                  {% if settings.animations_reveal_on_scroll %}
                                  data-cascade
                                  style="--animation-order: {{ rendered_product_count }};"
                                  {% endif %}
                                  app="{{ hide_from_collection }}"
                              >
                                  {% assign is_available = product.available %}
                                  {% assign rendered_product_count = rendered_product_count | plus: 1 %}
                                  <div
                                  id="cst-grid"
                                  class="cst-product-card"
                                  data-product-id="{{ product.id }}"
                                  >
                                  {% if product.metafields.custom.product_card_image_badges != blank %}
                                      <div class="product_card_image_badges">
                                      {% for img in product.metafields.custom.product_card_image_badges.value %}
                                          <img src="{{ img | image_url }}" width="auto" height="auto" alt="image">
                                      {% endfor %}
                                      </div>
                                  {% endif %}
                                  <div class="crumpler-capsules__wrapper">
                                      {% # Metafield Capsules %}
                                      {% assign capsules = product.metafields.crumpler.tag.value %}
                                      {% for capsule in capsules %}
                                      <span class="capsule capsule--no-border crumpler-capsules__product_capsule">{{ capsule }}</span>
                                      {% endfor %}
                                  </div>
                                  <div class="cst-main-slider">
                                      <div class="cst-wrapper swiper-wrapper">
                                          {% assign variant_video = blank %}
                                          {% if variant.metafields.custom.collection_display_image != blank %}
                                          {% assign variant_video = variant.metafields.custom.collection_display_image | file_url %}
                                          {% assign variant_img = variant.metafields.custom.collection_display_image %}
                                          {% elsif variant.featured_image %}
                                          {% assign variant_img = variant.featured_image | image_url %}
                                          {% else %}
                                          {% assign variant_img = product.featured_image | image_url %}
                                          {% endif %}
                                          {% if variant_video contains 'videos' %}
                                              <div class="swiper-slide">
                                              <div class="cst-slide-inner">
                                                  <a
                                                  href="{{ variant.url }}&collection={{ collection.handle }}"
                                                  class="cst-image-link {% unless variant.available %} cst-disabled {% endunless %}"
                                                  >
                                                  {% unless variant.available %}<div class="cst-disabled-overlay" aria-hidden="true"></div>{% endunless %}
                                                  <div class="cst-product-image-wrapper">
                                                      <video class="cst-product-video" autoplay loop muted playsinline>
                                                      <source src="{{ variant_video }}" type="video/mp4">
                                                      </video>
                                                  </div>
                                                  </a>
                                              </div>
                                              </div>
                                          {% else %}
                                            {% if variant_img %}
                                                <div class="swiper-slide">
                                                <div class="cst-slide-inner">
                                                    <a
                                                    href="{{ variant.url }}&collection={{ collection.handle }}"
                                                    class="cst-image-link {% unless variant.available %} cst-disabled {% endunless %}"
                                                    >
                                                    {% unless variant.available %}<div class="cst-disabled-overlay" aria-hidden="true"></div>{% endunless %}
                                                    <div class="cst-product-image-wrapper">
                                                        {% if template.suffix == 'old-made-in-melbourne' or template.suffix == 'lightweight' %}
                                                        <img
                                                            src="{{ variant_img | image_url }}"
                                                            alt="{{ product.title | escape }}"
                                                            class="motion-reduce cst-product-image skeleton"
                                                            loading="lazy"
                                                            width="{{ variant_img.width }}"
                                                            height="{{ variant_img.height }}"
                                                            onload="this.classList.remove('skeleton')"
                                                        >
                                                        {% else %}
                                                        <img
                                                            srcset="
                                                            {%- if variant_img.width >= 165 -%}{{ variant_img | image_url: width: 165 }} 165w,{%- endif -%}
                                                            {%- if variant_img.width >= 360 -%}{{ variant_img | image_url: width: 360 }} 360w,{%- endif -%}
                                                            {%- if variant_img.width >= 533 -%}{{ variant_img | image_url: width: 533 }} 533w,{%- endif -%}
                                                            {%- if variant_img.width >= 720 -%}{{ variant_img | image_url: width: 720 }} 720w,{%- endif -%}
                                                            {%- if variant_img.width >= 940 -%}{{ variant_img | image_url: width: 940 }} 940w,{%- endif -%}
                                                            {%- if variant_img.width >= 1066 -%}{{ variant_img | image_url: width: 1066 }} 1066w,{%- endif -%}
                                                            {%- if variant_img.width >= 1550 -%}{{ variant_img | image_url: width: 1550 }} 1550w,{%- endif -%}
                                                            {%- if variant_img.width >= 2000 -%}{{ variant_img | image_url: width: 2000 }} 2000w,{%- endif -%}
                                                            {%- if variant_img.width >= 2500 -%}{{ variant_img | image_url: width: 2500 }} 2500w,{%- endif -%}
                                                            {{ variant_img | image_url }} {{ variant_img.width }}w
                                                            "
                                                            src="{{ variant_img | image_url: width: 533 }}"
                                                            sizes="(min-width: {{ settings.page_width }}px) {{ settings.page_width | minus: 130 | divided_by: 4 }}px, (min-width: 990px) calc((100vw - 130px) / 4), (min-width: 750px) calc((100vw - 120px) / 3), calc((100vw - 35px) / 2)"
                                                            alt="{{ product.title | escape }}"
                                                            class="motion-reduce cst-product-image skeleton"
                                                            loading="lazy"
                                                            width="{{ variant_img.width }}"
                                                            height="{{ variant_img.height }}"
                                                            onload="this.classList.remove('skeleton')"
                                                        >
                                                        {% endif %}
                                                    </div>
                                                    </a>
                                                </div>
                                                </div>
                                            {% endif %}
                                          {% endif %}
                                      </div>
                                  </div>
      
                                  {% assign initial_price_variant = variant %}
                                  <a class="cst-product-title" href="{{ variant.url }}">
                                      {{- product.title }}
                                      <span class="cst-product-price{% if template.suffix == 'sale-collection' and initial_price_variant.compare_at_price > initial_price_variant.price %} cst-product-price--sale{% endif %}">
                                      {% if template.suffix == 'sale-collection' and initial_price_variant.compare_at_price > initial_price_variant.price %}
                                          <span class="cst-product-price-compare">{{ initial_price_variant.compare_at_price | money_without_trailing_zeros }}</span>
                                          <span class="cst-product-price-current">{{ initial_price_variant.price | money_without_trailing_zeros }}</span>
                                      {% else %}
                                          <span class="cst-product-price-current">{{ initial_price_variant.price | money_without_trailing_zeros }}</span>
                                      {% endif %}
                                      </span>
                                  </a>
      
                                  <div class="cst-swatches">
                                      <div class="cst-swatch-slider">
                                        <div class="cst-swatch-wrapper swiper-wrapper">
                                          {% assign swatch_colors = variant.metafields.custom.colour_filter.value | map:'colour' | join: ',' | downcase %}
                                          <div class="swiper-slide" price="{{ variant.price | money_without_trailing_zeros }}" compare_price="{% if variant.compare_at_price > variant.price %}{{ variant.compare_at_price | money_without_trailing_zeros }}{% endif %}" color="{{ color }}" meta_color="{{ swatch_colors }}">
                                            <div class="cst-slide-inner">
                                                <div class="cst-swatch-image-wrapper">
                                                {% render 'swatch',
                                                    swatch: color.swatch,
                                                    option_value: color,
                                                    product: product,
                                                    alt_swatches: true,
                                                    swatch_size: 16,
                                                    shape: 'square',
                                                    variant_colors:swatch_colors
                                                %}
                                                </div>
                                            </div>
                                          </div>
                                        </div>
                                      </div>
                                  </div>
      
                                  {% unless is_available %}
                                      {% if section.settings.tag_soldout_img != blank %}
                                      <div class="cst-tags-box">
                                          <div class="cst-img-box">
                                          <img
                                              src="{{ section.settings.tag_soldout_img | img_url: '400x' }}"
                                              width="100%"
                                              height="auto"
                                              alt="soldout"
                                          >
                                          </div>
                                      </div>
                                      {% endif %}
                                      {% endunless %}
                                  </div>
                              </li>
                          {% endif %}
                        {% endfor %}
                      {% endfor %}
                    {% endif %}
                  {% endfor %}

                {% endif %}
              {%- endfor -%}
            </ul>
            {% if rendered_product_count == 0 %}
              <div class="title-wrapper center">
                {% assign coll_link = '<a class="clear-filter-btn" href="' | append: collection.url | append: '">clear filters</a>' %}
                {% if section.settings.no_result_text != blank %}
                  <div class="no-result-text">
                    {{ section.settings.no_result_text | replace: '[clear filters]', coll_link }}
                  </div>
                {% endif %}
              </div>
            {% endif %}

            {%- if section.settings.pagination_type == 'infinite_scroll' and paginate.next -%}
              <a id="pagination-load-more" href="{{ paginate.next.url }}" style="visibility: hidden; height: 0; overflow: hidden;width:0;">Next</a>
            {%- else -%}
              {%- if paginate.pages > 1 -%}
                {%- render 'pagination', paginate: paginate, anchor: '' -%}
              {%- endif -%}
            {%- endif -%}

          </div>
        {%- endif -%}
      </div>
    </div>
  {%- endpaginate -%}
  {% if section.settings.image_shape == 'arch' %}
    {{ 'mask-arch.svg' | inline_asset_content }}
  {%- endif -%}
</div>

<script>
  // Collection Page JavaScript
  document.addEventListener('DOMContentLoaded', function () {
    initializeCollectionPage();
  });

  function toggleMobileFilters() {
    const filtersRow = document.querySelector('.cst-filters-row');
    const filtersOverlay = document.querySelector('.cst-filters-row-overlay');
    filtersRow.classList.toggle('open');
    filtersOverlay.classList.toggle('open_overlay');
  }

  document.addEventListener('click', (e) => {
    
    const filterToggle = e.target.closest('.cst-filters-container .filter-open-btn');
    const closeBtn = e.target.closest(' #main-collection-filters .cst-filters-row .fillter--close');
    const applyfilter = e.target.closest('.cst-apply-btn');
    const filtersOverlay = e.target.closest('.cst-filters-row-overlay');
    const sortbyIcon = e.target.closest('.sortby-icon');

    if(filterToggle){toggleMobileFilters()}
    if(closeBtn){toggleMobileFilters()}
    if(filtersOverlay){toggleMobileFilters()}
    if(applyfilter){toggleMobileFilters()}

    if (sortbyIcon) {
      const sortSelect = document.querySelector('.filter_sort_selector');
      if (sortSelect) {
        sortSelect.focus();
        sortSelect.click();
      }
    }
  });

  function initializeCollectionPage() {
    VariantSliderInit();
    initFilterSystem();
    initMobileFilterToggle();
  }

  // Variant Slider Functionality
  function VariantSliderInit() {
    const colorAttr = document.querySelector('.cst-filter-colour')?.getAttribute('active_values');
    const filtered_colors = colorAttr ? colorAttr.split(',') : [];
    document.querySelectorAll('#cst-grid.cst-product-card').forEach(function (card) {
      const mainSliderEle = card.querySelector('.cst-main-slider');
      const swatchSliderEle = card.querySelector('.cst-swatch-slider');
      const swatchPrice = card.querySelector('.cst-product-price');

      if (!mainSliderEle || !swatchSliderEle) return;

      let initial_Slide = 0;
      let match_found = false;
      let first_slide = true;
      if (colorAttr != "" && colorAttr) {
        const swatches = swatchSliderEle.querySelectorAll('.color-option');

        const productItem = card.closest('li');
        const clonesFragment = document.createDocumentFragment();

        // 2. Pre-Map Swatches: Store ALL indices for a color
        const swatchMap = new Map(); 

        for (let i = 0; i < swatches.length; i++) {
          const color = swatches[i].getAttribute('meta_color')?.toLowerCase() || '';
          if (color) {
            // If the color isn't in the map yet, create an empty array for it
            if (!swatchMap.has(color)) {
              swatchMap.set(color, []);
            }
            // Push the current index into that color's array
            swatchMap.get(color).push(i);
          }
        }

        // 3. Iterate Filters
        for (let index = 0; index < filtered_colors.length; index++) {
          const filterColor = filtered_colors[index];

          // Get the list of ALL matching swatch indices for this filter
          const matchingIndices = swatchMap.get(filterColor);

          if (matchingIndices) {
            // Iterate through every swatch that matched this filter
            for (let i = 0; i < matchingIndices.length; i++) {
                const swatchIndex = matchingIndices[i];
                
                if (first_slide) {
                  // Logic for the Main Card (First match found)
                  first_slide = false;
                  initial_Slide = swatchIndex;
                  match_found = true;
                  
                  // Good practice: mark the original item too
                  productItem.setAttribute('active-color', swatchIndex); 
                  
                } else {
                  // Logic for Clones (All subsequent matches)
                  const duplicateProduct = productItem.cloneNode(true);
                  
                  duplicateProduct.setAttribute('dublicate-color', filterColor);
                  duplicateProduct.setAttribute('active-color', swatchIndex);
                  
                  clonesFragment.appendChild(duplicateProduct);
                  match_found = true;
                }
            }
          }
        }

        // 4. Batch Insertion: Touch the DOM only once at the end
        if (clonesFragment.children.length > 0) {
          productItem.after(clonesFragment);
        }
        if(match_found == false){
          card.closest('li').style.display = 'none';
        }
      }

      function moveSwatchIntoView(swatchesWrapper, activeIndex) {
          const swatchesSwiper = swatchesWrapper.swiper;
          if (swatchesSwiper) {
              swatchesSwiper.slideTo(activeIndex, 500);
          }
      }


      const mainSwiper = new Swiper(mainSliderEle, {
        slidesPerView: 1,
        spaceBetween: 0,
        allowTouchMove: true,
        simulateTouch: true,
        cssMode: false,
        mousewheel: {
          invert: false,
          forceToAxis: true,
        },
        on: {
          slideChange: function () {
            setSwatchActive(mainSwiper.activeIndex);
          },
        },
      });

      const swatchSwiper = new Swiper(swatchSliderEle, {
        slidesPerView: 'auto',
        breakpoints: {
          0: {
            spaceBetween: 2,
          },
          425: {
            spaceBetween: 4.4,
          },
          768: {
            spaceBetween: 4.4,
          },
          1200: {
            spaceBetween: 4.4,
          },
        },
        navigation: {
          nextEl: card.querySelector('.cst-swatch-next'),
          prevEl: card.querySelector('.cst-swatch-prev'),
        },
        mousewheel: {
          forceToAxis: true,
          sensitivity: 1,
          releaseOnEdges: true
        },
      });

      swatchSwiper.slides.forEach((slideEl, idx) => {
        slideEl.addEventListener('mouseenter', () => {
          mainSwiper.slideTo(idx, 500);
          setSwatchActive(idx);
        });
        // click/tap for mobile (iOS doesn't fire mouseenter on touch)
        slideEl.addEventListener('click', (e) => {
          mainSwiper.slideTo(idx, 500);
          setSwatchActive(idx);
        });
      });

      function setSwatchActive(activeIndex) {
        swatchSwiper.slides.forEach((slide, index) => {
          slide.classList.toggle('cst-active', index === activeIndex);
          if (index === activeIndex) {
            const swatch_price = slide.getAttribute('price');
            const swatch_compare = slide.getAttribute('compare_price');
            const currentPriceEl = swatchPrice.querySelector('.cst-product-price-current');
            const comparePriceEl = swatchPrice.querySelector('.cst-product-price-compare');

            if (currentPriceEl && comparePriceEl) {
              currentPriceEl.textContent = swatch_price;

              if (swatch_compare) {
                comparePriceEl.textContent = swatch_compare;
                swatchPrice.classList.add('cst-product-price--sale');
              } else {
                comparePriceEl.textContent = '';
                swatchPrice.classList.remove('cst-product-price--sale');
              }
            } else {
              swatchPrice.textContent = swatch_price;
            }
          }
        });
        swatchSwiper.slideTo(activeIndex, 300, false);
        //swatchSwiper.slideTo(activeIndex);
      }

      mainSwiper.slideTo(initial_Slide);
      setSwatchActive(initial_Slide);
    });

    document.querySelectorAll('li[dublicate-color]').forEach(function (card) {
      const mainSliderEle = card.querySelector('.cst-main-slider');
      const swatchSliderEle = card.querySelector('.cst-swatch-slider');
      const selected_color = card.getAttribute('dublicate-color');
      const active_slide = parseInt(card.getAttribute('active-color'));

      if (!mainSliderEle || !swatchSliderEle) return;

      let initial_Slide = active_slide;

      const mainSwiper = new Swiper(mainSliderEle, {
        slidesPerView: 1,
        spaceBetween: 8,
        allowTouchMove: true,
        simulateTouch: true,
        cssMode: false,
        mousewheel: {
          invert: false,
          forceToAxis: true,
        },
        on: {
          slideChange: function () {
            setSwatchActive(mainSwiper.activeIndex);
          },
        },
      });

      const swatchSwiper = new Swiper(swatchSliderEle, {
        slidesPerView: 'auto',
        breakpoints: {
          0: {
            spaceBetween: 2,
          },
          425: {
            spaceBetween: 4.4,
          },
          768: {
            spaceBetween: 4.4,
          },
          1200: {
            spaceBetween: 4.4,
          },
        },
        navigation: {
          nextEl: card.querySelector('.cst-swatch-next'),
          prevEl: card.querySelector('.cst-swatch-prev'),
        },
        mousewheel: {
          forceToAxis: true,
          sensitivity: 1,
          releaseOnEdges: true
        },
      });

      swatchSwiper.slides.forEach((slideEl, idx) => {
        slideEl.addEventListener('mouseenter', () => {
          mainSwiper.slideTo(idx, 500);
          setSwatchActive(idx);
        });
        // click/tap for mobile (iOS doesn't fire mouseenter on touch)
        slideEl.addEventListener('click', (e) => {
          mainSwiper.slideTo(idx, 500);
          setSwatchActive(idx);
        });
      });

      function setSwatchActive(activeIndex) {
        swatchSwiper.slides.forEach((slide, index) => {
          slide.classList.toggle('cst-active', index === activeIndex);
        });
        swatchSwiper.slideTo(activeIndex, 300, false);
      }

      mainSwiper.slideTo(initial_Slide);
      setSwatchActive(initial_Slide);
    });
  }

  // Filter System
  function initFilterSystem() {
    const filterSection = document.getElementById('main-collection-filters');
    if (!filterSection) return;

    const form = document.getElementById('CSTFacetForm');
    const sectionId = filterSection.dataset.sectionId || '{{ section.id }}';
    const productGridContainer = document.getElementById('ProductGridContainer');
    const filterscontainer = document.querySelector('.cst-filters-container');

    // Create search params from form
    function createSearchParamsFromForm(formEl) {
      const formData = new FormData(formEl);
      return new URLSearchParams(formData).toString();
    }

    // Fetch and update section
    async function fetchAndUpdateSection(searchParams = '') {
      try {
        const loadingOverlay = document.querySelectorAll('.cst-product-count');
        loadingOverlay.forEach(k=>k.textContent = 'Loading...');

        const url = `${window.location.pathname}?section_id=${sectionId}${searchParams ? '&' + searchParams : ''}`;
        const response = await fetch(url);
        const text = await response.text();
        const parser = new DOMParser();
        const doc = parser.parseFromString(text, 'text/html');

        // Update product grid
        const newGrid = doc.getElementById('ProductGridContainer');
        if (newGrid && productGridContainer) {
          productGridContainer.innerHTML = newGrid.innerHTML;
        }
        const newfilterscontainer = doc.querySelector('.cst-filters-container');
        if(filterscontainer && newfilterscontainer){
          filterscontainer.innerHTML = newfilterscontainer.innerHTML;
        }

        if (!newGrid) gravityFilters();

        // Update filters section
        const newFilters = doc.getElementById('main-collection-filters');
        if (newFilters) {
          const newDrawer = newFilters.querySelector('.cst-filters-drawer');
          filterSection.querySelector('.cst-filters-drawer').innerHTML = newDrawer.innerHTML;
          // Reinitialize filter functionality
          initFilterSystem();
          initMobileFilterToggle();
        }
        const productGrid = doc.querySelector('#product-grid');
        const hasProducts = productGrid && productGrid.querySelectorAll('li').length > 0;
        // Trigger gravity effect if no products

        if (!hasProducts) {
          setTimeout(() => {
            gravityFilters();
          }, 100);
        }
        // Update URL
        const newURL = `${window.location.pathname}${searchParams ? '?' + searchParams : ''}`;
        history.pushState({ searchParams }, '', newURL);

        // Reinitialize sliders
        VariantSliderInit();
      } catch (error) {
        console.error('Error updating collection:', error);
      }
    }

    // Debounce function
    function debounce(func, wait) {
      let timeout;
      return function executedFunction(...args) {
        const later = () => {
          clearTimeout(timeout);
          func(...args);
        };
        clearTimeout(timeout);
        timeout = setTimeout(later, wait);
      };
    }

    // Handle form changes
    const handleFormChange = debounce(function (event) {
      const searchParams = createSearchParamsFromForm(form);
      fetchAndUpdateSection(searchParams);
    }, 300);

    // Add event listeners to form inputs
    form.querySelectorAll('input:not(.price_range_filter), select').forEach((input) => {
      input.addEventListener('change', handleFormChange);
    });

    const range = document.querySelector("#price_range_process");
    const rangePrice = form.querySelector('.cst-price-range-value');
    const currency  = rangePrice.getAttribute('currency');
    function updateRangeFill(el, rangePrice) {
      const min = el.min || 0;
      const max = el.max || 100;
      const val = el.value;
      const percent = ((val - min) / (max - min)) * 100;
      rangePrice.textContent = `(${currency}${val})`;
      el.style.background = `linear-gradient(to right, #222 ${percent}%, #ccc ${percent}%)`;
    }
    updateRangeFill(range, rangePrice);

    let priceRangeTimer;
    form.querySelectorAll('input.price_range_filter').forEach((input) => {
      input.addEventListener('input', () => {
        updateRangeFill(input, rangePrice);
        clearTimeout(priceRangeTimer);
        priceRangeTimer = setTimeout(() => {
          handleFormChange();
        }, 600);
      });
    });

    form.querySelectorAll('.price_range_submit').forEach((btn) => {
      btn.addEventListener('click', handleFormChange);
    });

    // Clear filters
    const clearButtons = document.querySelectorAll('.cst-clear-btn');
    if (clearButtons) {
      clearButtons.forEach((clearButton)=>{
        clearButton.addEventListener('click', function (e) {
          e.preventDefault();
          form.reset();
          history.pushState({}, '', window.location.pathname);
          fetchAndUpdateSection('');
        });
      });
    }

    // Handle browser back/forward
    window.addEventListener('popstate', function (event) {
      const searchParams = window.location.search.slice(1);
      if (searchParams) {
        // Update form to match URL parameters
        const urlParams = new URLSearchParams(searchParams);
        updateFormFromParams(urlParams);
        fetchAndUpdateSection(searchParams);
      } else {
        form.reset();
        fetchAndUpdateSection('');
      }
    });

    function updateFormFromParams(urlParams) {
      // Reset all inputs first
      form.querySelectorAll('input[type="checkbox"]').forEach((cb) => (cb.checked = false));
      form.querySelectorAll('input[type="number"]').forEach((input) => (input.value = ''));
      form.querySelectorAll('input[type="radio"]').forEach((radio) => (radio.checked = false));

      // Set values from URL params
      urlParams.forEach((value, key) => {
        const inputs = form.querySelectorAll(`[name="${key}"]`);
        inputs.forEach((input) => {
          if (input.type === 'checkbox' || input.type === 'radio') {
            input.checked = input.value === value;
          } else {
            input.value = value;
          }
        });
      });
    }
  }
  

