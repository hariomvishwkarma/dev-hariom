    function closedrawer() {
      const filtersRow = document.querySelector('.cst-filters-row');
      const filtersOverlay = document.querySelector('.cst-filters-row-overlay');
      filtersRow.classList.remove('open');
      filtersOverlay.classList.remove('open_overlay');
    }
  // Gravity effect when no products are found — robust version using clones (position:fixed)
  function gravityFilters() {
    closedrawer();
    const sourceElements = document.querySelectorAll(
      
    '.cst-filters-container .cst-filters-row > div, ' +
    '.cst-checkbox, ' +
    '.cst-price-range-row, ' +
    '.cst-filter-label, ' +
    '.cst-sort-radio-item, ' +
    '.cst-clear-btn, ' +
    '.cst-sort-filter, ' +
    '.cst-filters-container b, ' +
    '.cst-product-count, ' + 
    '.filter-top-text, ' + 
    '.filter-open-btn'
    );
    if (!sourceElements || sourceElements.length === 0) return;

    // Physics params (tweak to taste)
    const params = {
      gravity: 1800, // px/s²
      bounce: 0.35,
      wallBounce: 0.5,
      airDrag: 0.03,
      groundFriction: 3.0,
      bottomInset: 10, // distance from bottom viewport
      sideInset: 6,
      randomKickX: [-300, 300],
    };

    // Prevent layout shift while measuring & animating
    const originalVisibilities = new Map();
    sourceElements.forEach((el) => {
      originalVisibilities.set(el, el.style.visibility || '');
    });

    // Optionally lock scrolling to keep viewport stable
    const prevOverflow = document.documentElement.style.overflow;
    document.documentElement.style.overflow = 'hidden';
    document.body.style.overflow = 'hidden';

    // Create clones positioned fixed at the element's viewport coordinates
    const clones = [];
    sourceElements.forEach((el, idx) => {
      const rect = el.getBoundingClientRect();
      if (rect.width === 0 || rect.height === 0) return;

      // Clone
      const clone = el.cloneNode(true);
      clone.style.position = 'fixed';
      clone.style.left = rect.left + 'px';
      clone.style.top = rect.top + 'px';
      clone.style.width = rect.width + 'px';
      clone.style.height = rect.height + 'px';
      clone.style.margin = '0';
      clone.style.transform = 'translate(0, 0)';
      clone.style.transition = 'none';
      clone.style.pointerEvents = 'none';
      clone.style.zIndex = 99999;
      clone.style.willChange = 'transform';
      // Optional: give an identifiable class for debugging
      clone.classList.add('gravity-clone');

      // Hide original but keep its space (visibility) so layout doesn't reflow
      el.style.visibility = 'hidden';

      document.body.appendChild(clone);
      clones.push({ el: clone, original: el, rect });
    });

    if (clones.length === 0) {
      // restore and bail
      sourceElements.forEach((el) => (el.style.visibility = originalVisibilities.get(el) || ''));
      document.documentElement.style.overflow = prevOverflow;
      document.body.style.overflow = prevOverflow;
      return;
    }

    // Create physics items using viewport coords
    const physics = clones.map((item) => {
      return {
        el: item.el,
        originalEl: item.original,
        x: parseFloat(item.el.style.left),
        y: parseFloat(item.el.style.top),
        w: parseFloat(item.el.style.width),
        h: parseFloat(item.el.style.height),
        vx: Math.random() * (params.randomKickX[1] - params.randomKickX[0]) + params.randomKickX[0],
        vy: 0,
        baseLeft: parseFloat(item.el.style.left),
        baseTop: parseFloat(item.el.style.top),
      };
    });

    let rafId = null;
    let last = performance.now();

    function run() {
      const now = performance.now();
      const dt = Math.min((now - last) / 1000, 0.033);
      last = now;

      const stageH = window.innerHeight;
      const stageW = window.innerWidth;
      const floorY = stageH - params.bottomInset;
      let allSettled = true;

      physics.forEach((item) => {
        const groundY = floorY - item.h;
        const leftLimit = params.sideInset;
        const rightLimit = stageW - params.sideInset - item.w;

        // Gravity
        item.vy += params.gravity * dt;

        // Air drag
        item.vx *= 1 - params.airDrag * dt;

        // Integrate positions
        item.x += item.vx * dt;
        item.y += item.vy * dt;

        // Floor collision
        if (item.y > groundY) {
          item.y = groundY;
          item.vy = -item.vy * params.bounce;
          // friction reduces horizontal speed on bounce
          item.vx *= Math.max(0, 1 - params.groundFriction * dt);
        }

        // Side collisions
        if (item.x < leftLimit) {
          item.x = leftLimit;
          item.vx = -item.vx * params.wallBounce;
        } else if (item.x > rightLimit) {
          item.x = rightLimit;
          item.vx = -item.vx * params.wallBounce;
        }

        // Settled detection
        const nearGround = Math.abs(groundY - item.y) < 1;
        const slowVelocity = Math.abs(item.vx) < 2 && Math.abs(item.vy) < 5;
        if (nearGround && slowVelocity) {
          item.y = groundY;
          item.vx = 0;
          item.vy = 0;
        } else {
          allSettled = false;
        }

        // Apply transform (translate from starting position)
        const dx = item.x - item.baseLeft;
        const dy = item.y - item.baseTop;
        item.el.style.transform = `translate(${dx}px, ${dy}px)`;
      });

      if (!allSettled) {
        rafId = requestAnimationFrame(run);
      } else {

      }
    }



    // Start animation
    last = performance.now();
    rafId = requestAnimationFrame(run);

    function cleanup() {
      if (rafId) {
        cancelAnimationFrame(rafId);
        rafId = null;
      }

      // Smoothly return clones to their original positions (translate to 0) then remove
      physics.forEach((item) => {
        item.el.style.transition = 'transform 0.6s cubic-bezier(0.34, 1.56, 0.64, 1), opacity 0.3s';
        item.el.style.transform = 'translate(0, 0)';
        item.el.style.opacity = '0.95';
      });

      // After transition remove clones and restore original visibility
      setTimeout(() => {
        physics.forEach((item) => {
          // Remove clone
          if (item.el && item.el.parentNode) item.el.parentNode.removeChild(item.el);
          // Restore original's visibility
          if (item.originalEl) item.originalEl.style.visibility = originalVisibilities.get(item.originalEl) || '';
        });

        // Restore scrolling
        document.documentElement.style.overflow = prevOverflow;
        document.body.style.overflow = prevOverflow;

      }, 700);
    }
  }

  // Add CSS for the gravity effect (no rotation animations)
  const gravityStyles = document.createElement('style');
  gravityStyles.textContent = `
  @keyframes gravityFadeIn {
    0% { opacity: 0; transform: translateY(-20px); }
    100% { opacity: 1; transform: translateY(0); }
  }
  
  .gravity-falling {
    will-change: transform;
    backface-visibility: hidden;
  }
  
  /* Prevent text selection during animation */
  .cst-filters-container * {
    user-select: none;
  }
`;
  document.head.appendChild(gravityStyles);
  const button = document.querySelector('.cst-filter-label');
  const select = button.querySelector('.filter_sort_selector');

  button.addEventListener('click', function (e) {
    if (e.target !== select) {
      if (select.showPicker) {
        select.showPicker(); 
      } else {
        select.focus();
        select.click();
      }
    }
  });

// Infinite Scroll pagination function
{% if section.settings.pagination_type == 'infinite_scroll' %}
document.addEventListener("DOMContentLoaded", () => {
  
    let observer;
    let mutationObserver;
    let loading = false;

    // Suppress the collection-refresh MutationObserver while we make our own
    // DOM changes below, so appending products doesn't trigger initInfiniteScroll() again.
    function withMutationsPaused(fn) {
      const productContainer = document.querySelector("#ProductGridContainer");
      if (mutationObserver) mutationObserver.disconnect();
      fn();
      if (mutationObserver && productContainer) {
        mutationObserver.observe(productContainer, {
          childList: true,
          subtree: true
        });
      }
    }

    function initInfiniteScroll() {

      if (observer) observer.disconnect();

      const productGrid = document.querySelector("#product-grid");
      const nextPage = document.querySelector("#pagination-load-more");

      if (!productGrid || !nextPage) return;

      observer = new IntersectionObserver(async (entries) => {

        if (!entries[0].isIntersecting || loading) return;

        loading = true;

        try {

          const url = new URL(nextPage.href);
          url.searchParams.set("section_id", "{{ section.id }}");

          const response = await fetch(url);

          if (!response.ok) {
            throw new Error(`Failed to load next page (status ${response.status})`);
          }

          const html = await response.text();

          const parser = new DOMParser();
          const doc = parser.parseFromString(html, "text/html");

          const newProducts = doc.querySelectorAll("#product-grid > li.grid__item");
          const newNext = doc.querySelector("#pagination-load-more");

          withMutationsPaused(() => {

            const fragment = document.createDocumentFragment();

            newProducts.forEach(product => {
              fragment.appendChild(product);
            });

            productGrid.appendChild(fragment);
            VariantSliderInit();

            if (newNext) {
              nextPage.href = newNext.href;
            } else {
              observer.disconnect();
              nextPage.remove();
            }

          });

        } catch (err) {
          console.error("Infinite scroll failed to load next page:", err);
        }

        loading = false;

      }, {
        rootMargin: "300px"
      });

      observer.observe(nextPage);
    }

    // Initial load
    initInfiniteScroll();

    // Observe collection refresh (filters/sorting)
    const productContainer = document.querySelector("#ProductGridContainer");

    if (productContainer) {

      let timer;

      mutationObserver = new MutationObserver(() => {

        clearTimeout(timer);

        timer = setTimeout(() => {
          initInfiniteScroll();
        }, 100);

      });

      mutationObserver.observe(productContainer, {
        childList: true,
        subtree: true
      });

    }
  
});
{% endif %}

