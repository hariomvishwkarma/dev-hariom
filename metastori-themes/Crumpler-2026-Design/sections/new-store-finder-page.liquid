{% style %}
  .cst-container {
    padding-inline: 18px;
    padding-bottom: 14px;
  }

  .cst-section-desc {
    line-height: 1.2;
    font-size: {{ section.settings.font_size }};
    font-weight: 600;
    padding-bottom: 50px;
  }

  .cst-section-desc p {
    margin: 0;
  }

  .cst-country-selector {
    position: relative;
    width: 250px;
  }

  .cst-select {
    appearance: none;
    -webkit-appearance: none;
    -moz-appearance: none;
    width: 100%;
    padding: 2px 40px 2px 10px;
    border: 1px solid #333;
    border-radius: 6px;
    color: #000000;
    background-color: white;
    font-size: {{ section.settings.font_size }};
    font-weight: 600;
    cursor: pointer;
  }

  .cst-select:focus,
  .cst-select:focus-visible {
    outline: none;
    box-shadow: none;
  }

  .cst-country-selector::after {
    content: '';
    position: absolute;
    top: 50%;
    right: 10px;
    transform: translateY(-50%);
    width: 22px;
    height: 22px;
    pointer-events: none;
    background-image: url("data:image/svg+xml;utf8,<svg fill='black' xmlns='http://www.w3.org/2000/svg' viewBox='0 0 20 20'><path d='M5.23 7.21a.75.75 0 011.06.02L10 11.06l3.71-3.83a.75.75 0 111.08 1.04l-4.25 4.38a.75.75 0 01-1.08 0L5.21 8.27a.75.75 0 01.02-1.06z'/></svg>");
    background-repeat: no-repeat;
    background-size: 22px;
  }

  .cst-blocks-container {
    margin-top: 5px;
  }

  ol {
    margin: 0;
    padding-inline-start: 18px;
  }

  .cst-accordion,
  .cst-accordion-next {
    opacity: 1;
    font-size: {{ section.settings.font_size }};
    color: #C4C4C4;
    font-weight: 500;
    transition: all 0.4s;
  }

  .cst-accordion.open,
  .cst-accordion-next.open {
    opacity: 1;
    color: #000000;
  }

  .cst-store-desc {
    margin-bottom: 28px;
    overflow-wrap: anywhere;
  }

  ol.cst-country-stores {
    margin-bottom: 15px;
    padding-left: 15px !important;
  }

  .cst-accordion-content {
    max-height: 0;
    color: #333;
    overflow: hidden;
    /* transition: max-height 0.4s ease, opacity 0.4s ease; */
    margin-left: 12px;
  }

  .cst-accordion-title {
    cursor: pointer;
    padding: 0;
    margin-left: 12px;
  }

  .swiper-slide {
    margin-right: 0 !important;
  }

  .cst-accordion-content a {
    color: #333;
    text-decoration: underline;
  }

  .cst-store-desc > * {
    margin: 0;
  }

  .cst-parts {
    display: flex;
    align-items: start;
    overflow: hidden;
    gap: 0;
  }

  .cst-part {
    flex: 1;
    max-width: 460px;
    overflow: hidden;
  }

  .cst-right {
    width: 100%;
    display: flex;
  }

  .cst-image-block {
    position: relative;
  }

  .cst-image-block img {
    width: 100%;
    height: 100%;
    display: flex;
  }

  .cst-store-images {
    margin-block: 24px;
  }

  .swiper-pagination {
    background-color: #fff;
    bottom: 0px !important;
    text-align: left;
  }

  .swiper-pagination-bullet {
    border: 1px solid #000;
    background: #fff;
    opacity: 1;
  }

  .swiper-pagination-bullet[aria-current="true"] {
    background: #000;
  }

  .swiper-scrollbar-drag {
    display: flex !important;
    border-radius: 0;
    height: 3px;
    background: #C4C4C4;
  }

  .swiper-scrollbar {
    background: transparent;
    padding: 0;
    border-radius: 0;
    width: 100% !important;
    left: 0 !important;
    bottom: 0 !important;
    height: 3px !important;
  }

  .cst-country-block {
    opacity: 0;
    visibility: hidden;
  }

  .cst-right.cst-part .swiper {
    display: block;
    width: 100%;
  }

  @media(max-width: 1025px) {
    li.cst-store-block.cst-accordion.open {
      margin-bottom: 18px;
    }

    ol.cst-country-stores {
      padding-left: 37px !important;
    }

    .cst-container {
      padding-inline: 12px;
    }

    .cst-parts {
      flex-direction: column;
    }

    .cst-part {
      max-width: 100%;
    }

    ol {
      padding-inline-start: 34px;
    }

    .cst-section-desc,
    .cst-select,
    .cst-accordion,
    .cst-accordion-next {
      font-size: {{ section.settings.font_size_m }};
    }

    .cst-section-desc p {
      margin: 0;
    }

    .cst-section-desc {
      padding-bottom: 20px;
      padding-top: 0px;
    }

    .cst-country-selector {
      width: 100%;
      margin-bottom: 13.5px;
      padding-left: 9px;
      padding-right: 9px;
    }

    .cst-store-finder-page {
      padding-bottom: 180px;
    }

    .cst-accordion-content {
      margin-left: -28px;
    }
  }

  @media(min-width: 1026px) {
    .cst-store-images {
      display: none !important;
    }

    .cst-part {
      max-width: 34%;
    }

    .cst-right.cst-part .swiper {
      margin-top: 56px;
      width: 100%;
    }

    .cst-left.cst-part {
      padding-right: 12px;
    }

    .cst-right.cst-part {
      max-width: 55%;
      padding-top: 80px;
      z-index: 1;
    }
    .cst-store-singleImage {
      padding-right: 0px;
      width: 70%;
    }
    .cst-store-singleImage img, .cst-store-multiImage img {
      max-width: 100%;
      width: 100%;
    }
    .cst-store-multiImage {
      width: 70%;
      padding-left: 9px;
      display: flex;
      flex-direction: column;
      gap: 9px;
      max-height: 100vh;
      overflow: scroll;
    }
    .cst-store-multiImage::-webkit-scrollbar {
      display: none;
    }
    .cst-store-multiImage img:first-child{
      display: none;
    }

    .template-page-new-stockist header.header {
      padding-bottom: 0;
    }
  }

.cst-right.cst-part .swiper{
  display:none;
}
{% endstyle %}

<div class="cst-store-finder-page">
  <div class="cst-container">
    <div class="cst-parts">
      <div class="cst-left cst-part">
        {% if section.settings.sec_desc != blank %}
          <div class="cst-section-desc">{{ section.settings.sec_desc }}</div>
        {% endif %}

        <div class="cst-country-selector">
          <select id="country-selector" class="cst-select"></select>
        </div>

        <div class="cst-blocks-container">
          {% content_for 'blocks' %}
        </div>
      </div>

      <div class="cst-right cst-part"></div>
    </div>
  </div>
</div>

<script>
  document.addEventListener("DOMContentLoaded", function () {
    const countryBlocks = document.querySelectorAll(".cst-country-block");
    const selectBox = document.getElementById("country-selector");
    const rightPart = document.querySelector(".cst-right");

    let currentOpenAccordion = null;

    countryBlocks.forEach((block, index) => {
      const option = block.querySelector("option");
      option.value = index;
      selectBox.appendChild(option);
    });

    function showSelectedCountry(index) {
      countryBlocks.forEach((block, i) => {
        block.style.display = i === index ? "block" : "none";
        block.style.opacity = i === index ? "1" : "0";
        block.style.visibility = i === index ? "visible" : "hidden";
        if(i === index){
          const acc_item = block.querySelectorAll(".cst-accordion");
          acc_item.forEach(acc => {
            const content = acc.querySelector(".cst-accordion-content");
            const storeImagesContainer = acc.querySelector(".cst-store-images");
              acc.classList.remove("open");
              content.style.maxHeight = "0px";
              content.style.opacity = "0";
              currentOpenAccordion = null;
              rightPart.innerHTML = "";
              if (storeImagesContainer) storeImagesContainer.style.display = "";
              return;
          });
        } 
      });
    }

    selectBox.value = "0";
    showSelectedCountry(0);
    setupAccordion();

    selectBox.addEventListener("change", function () {
      const selectedIndex = parseInt(this.value);

      if (!isNaN(selectedIndex)) {
        rightPart.innerHTML = "";
        currentOpenAccordion = null;
        showSelectedCountry(selectedIndex);
      }
    });

    function setupAccordion() {
      function mobileCloseOpen(prevAcc, newAcc, content, storeImagesContainer) {
        if (prevAcc && prevAcc !== newAcc) {
          const prevContent = prevAcc.querySelector(".cst-accordion-content");
          prevAcc.classList.remove("open");
          prevContent.style.maxHeight = "0px";
          prevContent.style.opacity = "0.6";
        }

        setTimeout(() => {
          newAcc.classList.add("open");
          content.style.maxHeight = content.scrollHeight + "px";
          content.style.opacity = "1";
          currentOpenAccordion = newAcc;

          newAcc.scrollIntoView({
            behavior: "smooth",
            block: "start"
          });

          if (storeImagesContainer) {
            storeImagesContainer.style.display = "block";
            initSwiperIfNeeded(storeImagesContainer);
          }

          rightPart.innerHTML = "";
        }, 420);
      }

      const accordions = document.querySelectorAll(".cst-accordion");

      accordions.forEach(acc => {
        const title = acc.querySelector(".cst-accordion-title");
        const content = acc.querySelector(".cst-accordion-content");
        const storeImagesContainer = acc.querySelector(".cst-store-images");

        if (!title || title.dataset.bound === "true") return;
        title.dataset.bound = "true";

        title.addEventListener("click", () => {
          const isOpening = !acc.classList.contains("open");
          const isMobile = window.innerWidth <= 1025;

          if (!isOpening) {
            acc.classList.remove("open");
            content.style.maxHeight = "0px";
            content.style.opacity = "0.6";
            //setTimeout(() => content.style.opacity = "0.6", 400);
            currentOpenAccordion = null;
            rightPart.innerHTML = "";
            if (storeImagesContainer) storeImagesContainer.style.display = "";
            return;
          }

          if (isMobile) {
            mobileCloseOpen(currentOpenAccordion, acc, content, storeImagesContainer);
            return;
          }

          accordions.forEach(other => {
            const otherContent = other.querySelector(".cst-accordion-content");

            if (other !== acc) {
              other.classList.remove("open");
              otherContent.style.maxHeight = "0px";
              otherContent.style.opacity = "0.6";
              //setTimeout(() => otherContent.style.opacity = "0.6", 400);
            }
          });

          acc.classList.add("open");
          content.style.maxHeight = "100%";
          content.style.opacity = "1";
          currentOpenAccordion = acc;

          if (storeImagesContainer) {
            storeImagesContainer.style.display = "none";
            moveSliderToRight(storeImagesContainer);
          }
        });
      });

      const accordions_next = document.querySelectorAll(".cst-accordion-next");

      accordions_next.forEach(acc => {
        const title = acc.querySelector(".cst-accordion-title");
        const content = acc.querySelector(".cst-accordion-content");
        const storeImagesContainer = acc.querySelector(".cst-store-images");

        if (!title || title.dataset.bound === "true") return;
        title.dataset.bound = "true";

        title.addEventListener("click", () => {
          const isOpening = !acc.classList.contains("open");
          const isMobile = window.innerWidth <= 1025;

          if (!isOpening) {
            acc.classList.remove("open");
            content.style.maxHeight = "0px";
            content.style.opacity = "0.6";
            //setTimeout(() => content.style.opacity = "0.6", 400);
            currentOpenAccordion = null;
            rightPart.innerHTML = "";
            if (storeImagesContainer) storeImagesContainer.style.display = "";
            return;
          }

          if (isMobile) {
            mobileCloseOpen(currentOpenAccordion, acc, content, storeImagesContainer);
            return;
          }

          accordions_next.forEach(other => {
            const otherContent = other.querySelector(".cst-accordion-content");

            if (other !== acc) {
              other.classList.remove("open");
              otherContent.style.maxHeight = "0px";
              otherContent.style.opacity = "0.6";
              //setTimeout(() => otherContent.style.opacity = "0.6", 400);
            }
          });

          acc.classList.add("open");
          content.style.maxHeight = "100vh";
          content.style.opacity = "1";
          currentOpenAccordion = acc;

          if (storeImagesContainer) {
            storeImagesContainer.style.display = "none";
            moveSliderToRight(storeImagesContainer);
          }
        });
      });
    }

    function moveSliderToRight(sourceContainer) {
      if (!sourceContainer) return;

      rightPart.innerHTML = "";

      const originalSlider = sourceContainer.querySelector(".swiper");
      if (!originalSlider) return;

      const clone = originalSlider.cloneNode(true);
      clone.dataset.initialized = "";

      rightPart.appendChild(clone);

      const sinlgeMedia = document.createElement('div');
      sinlgeMedia.className = 'cst-store-singleImage';
      const firstImage = sourceContainer.querySelector(".swiper .swiper-slide:first-child img");
      if (!firstImage) return;
      sinlgeMedia.appendChild(firstImage.cloneNode(true));
      rightPart.appendChild(sinlgeMedia);

      const multiMedia = document.createElement('div');
      multiMedia.className = 'cst-store-multiImage';
      const multiImages = sourceContainer.querySelectorAll(".swiper .swiper-slide");
      if (multiImages.length <= 0) return;
      multiImages.forEach((el, index) => {
        const img = el.querySelector('img');
        if (!img) return;
        multiMedia.appendChild(img.cloneNode(true));
      });
      rightPart.appendChild(multiMedia);

      const header = document.querySelector('header');
      const footer = document.querySelector('footer');
      const headerHeight = header ? header.offsetHeight : 0;
      const footerHeight = footer ? footer.offsetHeight : 0;
      const lessheight = headerHeight + footerHeight;
      multiMedia.style.maxHeight = `calc(100vh - ${lessheight + 15}px`;

      initSwiperIfNeeded(rightPart);
    }

    function initSwiperIfNeeded(container) {
      const slider = container.querySelector(".swiper");

      if (!slider || slider.dataset.initialized === "true") return;

      new Swiper(slider, {
        slidesPerView: 1,
        spaceBetween: 10,
        loop: false,
        pagination: {
          el: slider.querySelector(".swiper-pagination"),
          clickable: true
        },
        scrollbar: {
          el: slider.querySelector(".swiper-scrollbar")
        }
      });

      slider.dataset.initialized = "true";
    }

    window.addEventListener("resize", () => {
      if (!currentOpenAccordion) return;

      const storeImagesContainer = currentOpenAccordion.querySelector(".cst-store-images");
      if (!storeImagesContainer) return;

      const isMobile = window.innerWidth <= 1025;

      if (isMobile) {
        rightPart.innerHTML = "";
        storeImagesContainer.style.display = "block";
        initSwiperIfNeeded(storeImagesContainer);
      } else {
        storeImagesContainer.style.display = "none";
        moveSliderToRight(storeImagesContainer);
      }
    });
  });
</script>

{% schema %}
