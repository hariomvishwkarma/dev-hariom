{{ 'sponsorships-section.css' | asset_url | stylesheet_tag }}
{% assign absolute_images = section.blocks | where: 'type', 'image' %}
<style>
  @media (max-width:1025px){
    .about_image_text_main_{{ section.id }}{
      min-height:{{section.settings.height_mobile}}px;
    }
    {% for block in absolute_images %}
      .absolute_image_item_{{ block.id }}{
        {% if block.settings.top_m != blank and block.settings.top_m != 0 %}top:{{ block.settings.top_m }}px;{% endif %}
        {% if block.settings.left_m != blank and block.settings.left_m != 0 %}left:{{ block.settings.left_m }}px;{% endif %}
        {% if block.settings.bottom_m != blank and block.settings.bottom_m != 0 %}bottom:{{ block.settings.bottom_m }}px;{% endif %}
        {% if block.settings.right_m != blank and block.settings.right_m != 0 %}right:{{ block.settings.right_m }}px;{% endif %}
        width:{{ block.settings.width_mobile }}px;
        z-index: {{ block.settings.z_index }};
        {% if block.settings.show_in == 'desktop' %}display:none;{% endif %}
      }
    {% endfor %}
    .about_image_text_main_{{ section.id }}, .about_image_with_text_flex{
      min-height:{{section.settings.height_mobile}}px;
    }
  }
  @media (min-width:1026px){
    .about_image_text_main_{{ section.id }}, .about_image_with_text_flex{
      min-height:{{section.settings.height_desktop}}px;
    }
    {% for block in absolute_images %}
      .absolute_image_item_{{ block.id }}{
        {% if block.settings.top != blank and block.settings.top != 0 %}top:{{ block.settings.top }}px;{% endif %}
        {% if block.settings.left != blank and block.settings.left != 0 %}left:{{ block.settings.left }}px;{% endif %}
        {% if block.settings.bottom != blank and block.settings.bottom != 0 %}bottom:{{ block.settings.bottom }}px;{% endif %}
        {% if block.settings.right != blank and block.settings.right != 0 %}right:{{ block.settings.right }}px;{% endif %}
        width:{{block.settings.width}}px;
        z-index: {{ block.settings.z_index }};
        {% if block.settings.show_in == 'mobile' %}display:none;{% endif %}
      }
    {% endfor %}
  }
</style>

<div class="about_image_with_text_main about_image_text_main_{{ section.id }}" data-section-id="{{ section.id }}">

    {% if section.settings.top_text != blank %}
        <div class="sponsorships-top-text">{{ section.settings.top_text }}</div>
    {% endif %}

    <div class="sponsorships-list-main">
      {% if section.settings.marquee_text != blank %}
        <div
          class="sponsorships-marquee" aria-hidden="true">
          <div class="marquee-sticky" style="--marquee-bg: {{ section.settings.marquee_bg }}; --marquee-color: {{ section.settings.marquee_color }}; --marquee-speed: {{ section.settings.speed }}s;">
            <div class="sponsorships-marquee-track">
              <span>{{ section.settings.marquee_text }}</span>
              <span>{{ section.settings.marquee_text }}</span>
              <span>{{ section.settings.marquee_text }}</span>
              <span>{{ section.settings.marquee_text }}</span>
            </div>
          </div>
        </div>
      {% endif %}

      <div class="sponsorships_item_list_main">
        {% assign sponsorships_list = section.blocks | where: 'type', 'year_list' %}
        {% for block in sponsorships_list %}
            <div class="sponsorships_item_wrapper">
                <div class="year-col">
                  <span class="sponsorships_year">{{ block.settings.year }} ---></span>
                </div>
                <div class="sponsorships_item_list">
                  {{ block.settings.sponsorships_list }}
                </div>
            </div>
        {% endfor %}
      </div>
    </div>

    <div class="form-section">
      {% if section.settings.form_text != blank %}
        <div class="form-text">{{ section.settings.form_text }}</div>
      {% endif %}

      {% for block in section.blocks %}
        {% if block.type == '@app' %}
          {% render block %}
        {% endif %}
      {% endfor %}
    </div>
  
    {% for block in absolute_images %}
      {% if block.settings.image != blank %}
        <div class="absolute_image_item absolute_image_item_{{ block.id }}">
          <img class="absolute_image_img" src="{{ block.settings.image | image_url }}" width="auto" height="auto" alt="absolute_image">
        </div>
      {% elsif block.settings.video != blank %}
        <div class="absolute_image_item absolute_image_item_{{ block.id }}">
          {% assign video_poster = block.settings.video.preview_image | image_url: width: 1600 %}
          {{ block.settings.video | video_tag: controls: false, autoplay: true, loop: true, muted: true, playsinline: true, preload: 'metadata', poster: video_poster, class: 'absolute__video' }}
        </div>
      {% endif %}
    {% endfor %}

  {% if section.settings.sticky_image != blank %}
    <div class="sticky_media">
      <img src="{{ section.settings.sticky_image | image_url }}" width="auto" height="auto" alt="sticky_image">
    </div>
  {% endif %}

</div>

