    }
    #app-embed button[data-testid="btn-form-submit"]{
      height: 18px;
      margin-top: 18px;
    }
    #app-embed ._formFileInput_ehvsf_1 {
      margin: 18px 0;
    }
  }
</style>

<script>
const checkForm = setInterval(() => {
  const existingStyle = document.querySelector("#form-embed-style");
  const shadowHosts = document.querySelectorAll("shopify-forms-embed");

  if (shadowHosts.length > 0 && existingStyle) {
    shadowHosts.forEach((form) => {
      const shadow = form.shadowRoot;
      if (shadow && !shadow.querySelector("#form-embed-style")) {
        // Clone and append style
        const clonedStyle = existingStyle.cloneNode(true);
        shadow.querySelector('#app-embed').appendChild(clonedStyle);
      }
    });

    clearInterval(checkForm);
  }
}, 200);

</script>

<script>
(() => {
  const section = document.querySelector('.about_image_text_main_{{ section.id }}');
  if (!section) return;

  const stickyMedia = section.querySelector('.sticky_media');
  if (!stickyMedia) return;

  const updateStickyOpacity = () => {
    const sectionTop = section.offsetTop;
    const sectionEnd = sectionTop + section.offsetHeight - window.innerHeight;
    const scrollY = window.scrollY;
    const fadeDistance = Math.max(sectionEnd - sectionTop, 1);
    const progress = Math.min(Math.max((scrollY - sectionTop) / fadeDistance, 0), 1);

    stickyMedia.style.opacity = (1 - progress).toFixed(3);
  };

  let ticking = false;
  const requestTick = () => {
    if (ticking) return;
    ticking = true;
    window.requestAnimationFrame(() => {
      updateStickyOpacity();
      ticking = false;
    });
  };

  updateStickyOpacity();
  window.addEventListener('scroll', requestTick, { passive: true });
  window.addEventListener('resize', requestTick);
})();
</script>

