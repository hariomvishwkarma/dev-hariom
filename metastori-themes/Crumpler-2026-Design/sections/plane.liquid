<section class="plane-section-{{ section.id }}">
  <div class="plane-reveal-area">
    {% if section.settings.reveal_background_image != blank %}
      <img class="plane-bg-img" src="{{ section.settings.reveal_background_image | image_url: width: 2400 }}" alt="">
    {% endif %}

    {% if section.settings.second_text != blank %}
      <div class="plane-reveal-content">
        {{ section.settings.second_text }}
      </div>
    {% endif %}

    <div class="plane-mask-layer">
      {% if section.settings.content != blank %}
        <img class="plane-first-text plane-first-text-desktop" src="{{ section.settings.content | image_url: width: 2000 }}" alt="">
      {% endif %}
      {% if section.settings.content_mobile != blank %}
        <img class="plane-first-text plane-first-text-mobile" src="{{ section.settings.content_mobile | image_url: width: 1000 }}" alt="">
      {% endif %}
    </div>

    <canvas class="plane-hit-canvas"></canvas>

    {% if section.settings.drag_image != blank %}
      <img class="plane-drag-img" src="{{ section.settings.drag_image | image_url: width: 1000 }}" alt="">
    {% endif %}
  </div>

  {% if section.blocks.size > 0 %}
    <div class="plane-media-wrapper">
      {% if section.settings.media_overlay_image != blank %}
        {% if section.settings.media_overlay_link != blank %}
          <a href="{{ section.settings.media_overlay_link }}" class="plane-media-overlay">
        {% else %}
          <div class="plane-media-overlay">
        {% endif %}
          <img src="{{ section.settings.media_overlay_image | image_url: width: 1600 }}" alt="" loading="lazy">
        {% if section.settings.media_overlay_link != blank %}
          </a>
        {% else %}
          </div>
        {% endif %}
      {% endif %}

      {% for block in section.blocks %}
        {% if block.type == 'media' %}
          {% if block.settings.link != blank %}
            <a href="{{ block.settings.link }}" class="plane-media-item plane-size-{{ block.settings.column }}" {{ block.shopify_attributes }}>
          {% else %}
            <div class="plane-media-item plane-size-{{ block.settings.column }}" {{ block.shopify_attributes }}>
          {% endif %}

            {% if block.settings.image != blank %}
              {{ block.settings.image | image_url: width: 2000 | image_tag: class: 'plane-media-img' }}
            {% elsif block.settings.video != blank %}
              {{ block.settings.video | video_tag: autoplay: true, loop: true, muted: true, controls: false, class: 'plane-media-video' }}
            {% endif %}

            {% if block.settings.text != blank %}
              <span class="plane-media-text">{{ block.settings.text }}</span>
            {% endif %}

          {% if block.settings.link != blank %}
            </a>
          {% else %}
            </div>
          {% endif %}
        {% endif %}
      {% endfor %}
    </div>
  {% endif %}

  {% if section.settings.bottom_image != blank %}
    {% if section.settings.bottom_image_link != blank %}
      <a href="{{ section.settings.bottom_image_link }}" class="plane-bottom-image-area">
    {% else %}
      <div class="plane-bottom-image-area">
    {% endif %}

      <img
        class="plane-bottom-image"
        src="{{ section.settings.bottom_image | image_url: width: 2400 }}"
        alt=""
        loading="lazy"
      >

    {% if section.settings.bottom_image_link != blank %}
      </a>
    {% else %}
      </div>
    {% endif %}
  {% endif %}
</section>

<style>
  .plane-section-{{ section.id }} {
    width: 100%;
    background: #fff;
  }

  .plane-section-{{ section.id }} .plane-reveal-area {
    position: relative;
    width: 100%;
    height: {{ section.settings.section_height }}px;
    overflow: hidden;
    background: #fff;
  }

  .plane-section-{{ section.id }} .plane-bg-img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    z-index: 1;
  }

  .plane-section-{{ section.id }} .plane-reveal-content {
    position: absolute;
    inset: 0;
    z-index: 2;
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding: 40px;
    color: {{ section.settings.reveal_text_color }};
    pointer-events: none;
  }

  .plane-section-{{ section.id }} .plane-reveal-content * {
    margin: 0;
    color: inherit;
  }

  .plane-section-{{ section.id }} .plane-reveal-content p,
  .plane-section-{{ section.id }} .plane-reveal-content h1,
  .plane-section-{{ section.id }} .plane-reveal-content h2,
  .plane-section-{{ section.id }} .plane-reveal-content h3 {
    font-size: {{ section.settings.desktop_reveal_text_size }}px;
    line-height: 1;
  }

  .plane-section-{{ section.id }} .plane-mask-layer {
    position: absolute;
    inset: 0;
    z-index: 3;
    background: white;
    pointer-events: none;
  }

  .plane-section-{{ section.id }} .plane-first-text {
    position: absolute;
    display: block;
  }

  .plane-section-{{ section.id }} .plane-first-text-mobile {
    display: none;
  }

  .plane-section-{{ section.id }} .plane-hit-canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    z-index: 4;
    cursor: none;
    touch-action: none;
    opacity: 0;
  }

  .plane-section-{{ section.id }} .plane-drag-img {
    position: absolute !important;
    left: 50%;
    top: 50%;
    width: {{ section.settings.drag_size }}px !important;
    height: {{ section.settings.drag_size }}px !important;
    object-fit: contain;
    transform: none;
    z-index: 5 !important;
    pointer-events: none;
    display: block !important;
  }

  .plane-section-{{ section.id }} .plane-media-wrapper {
    position: relative;
    display: flex;
    flex-wrap: wrap;
    align-items: flex-start;
    gap: {{ section.settings.media_gap }}px;
    padding: {{ section.settings.media_padding }}px;
    background: {{ section.settings.media_background }};
  }

  .plane-section-{{ section.id }} .plane-media-overlay {
    position: absolute;
    left: {{ section.settings.media_overlay_x }}%;
    top: {{ section.settings.media_overlay_y }}%;
    width: {{ section.settings.media_overlay_desktop_size }}px;
    transform: translate(-50%, -50%);
    z-index: 10;
    display: block;
  }

  .plane-section-{{ section.id }} .plane-media-overlay img {
    width: 100%;
    height: auto;
    display: block;
  }

  .plane-section-{{ section.id }} .plane-media-item {
    position: relative;
    display: block;
    overflow: visible;
    aspect-ratio: auto;
  }

  .plane-section-{{ section.id }} .plane-media-img,
  .plane-section-{{ section.id }} .plane-media-video {
    width: 100%;
    height: auto;
    object-fit: contain;
    display: block;
  }

  .plane-section-{{ section.id }} .plane-media-text {
    position: absolute;
    left: 12px;
    bottom: 12px;
    z-index: 2;
  }

  .plane-section-{{ section.id }} .plane-size-one { width: 12.5%; }
  .plane-section-{{ section.id }} .plane-size-two { width: 25%; }
  .plane-section-{{ section.id }} .plane-size-three { width: 37.5%; }
  .plane-section-{{ section.id }} .plane-size-four { width: 50%; }
  .plane-section-{{ section.id }} .plane-size-five { width: 62.5%; }
  .plane-section-{{ section.id }} .plane-size-six { width: 75%; }
  .plane-section-{{ section.id }} .plane-size-seven { width: 87.5%; }
  .plane-section-{{ section.id }} .plane-size-eight { width: 100%; }

  .plane-section-{{ section.id }} .plane-bottom-image-area {
    position: relative;
    width: 100%;
    height: {{ section.settings.bottom_image_area_height }}px;
    overflow: hidden;
    display: block;
    background: {{ section.settings.bottom_image_background }};
  }

  .plane-section-{{ section.id }} .plane-bottom-image {
    position: absolute;
    left: {{ section.settings.bottom_image_x }}%;
    top: {{ section.settings.bottom_image_y }}%;
    width: {{ section.settings.bottom_image_desktop_size }}%;
    height: auto;
    transform: translate(-50%, -50%);
    display: block;
    max-width: none;
  }

  @media screen and (max-width: 749px) {
    .plane-section-{{ section.id }} .plane-reveal-area {
      height: {{ section.settings.section_height_mobile }}px;
    }

    .plane-section-{{ section.id }} .plane-reveal-content p,
    .plane-section-{{ section.id }} .plane-reveal-content h1,
    .plane-section-{{ section.id }} .plane-reveal-content h2,
    .plane-section-{{ section.id }} .plane-reveal-content h3 {
      font-size: {{ section.settings.mobile_reveal_text_size }}px;
    }

    .plane-section-{{ section.id }} .plane-first-text-desktop {
      display: none;
    }

    .plane-section-{{ section.id }} .plane-first-text-mobile {
      display: block;
    }

    .plane-section-{{ section.id }} .plane-media-item {
      width: 100% !important;
    }

    .plane-section-{{ section.id }} .plane-media-overlay {
      left: {{ section.settings.media_overlay_mobile_x }}%;
      top: {{ section.settings.media_overlay_mobile_y }}px;
      width: {{ section.settings.media_overlay_mobile_size }}px;
    }

    .plane-section-{{ section.id }} .plane-bottom-image-area {
      height: {{ section.settings.bottom_image_mobile_area_height }}px;
    }

    .plane-section-{{ section.id }} .plane-bottom-image {
      left: {{ section.settings.bottom_image_mobile_x }}%;
      top: {{ section.settings.bottom_image_mobile_y }}%;
      width: {{ section.settings.bottom_image_mobile_size }}%;
    }
  }
</style>

<script>
(() => {
  const section = document.querySelector(".plane-section-{{ section.id }}");
  if (!section) return;

  const area = section.querySelector(".plane-reveal-area");
  const maskLayer = section.querySelector(".plane-mask-layer");
  const hitCanvas = section.querySelector(".plane-hit-canvas");
  const dragImage = section.querySelector(".plane-drag-img");

  const isMobile = () => window.innerWidth <= 749;

  const desktopImg = maskLayer.querySelector(".plane-first-text-desktop");
  const mobileImg = maskLayer.querySelector(".plane-first-text-mobile");

  const brushImg = new Image();
  brushImg.crossOrigin = "anonymous";
  brushImg.src = "{{ section.settings.drag_image | image_url: width: 1000 }}";
  const brushSize = {{ section.settings.drag_size }};

  const scratchCanvas = document.createElement("canvas");
  scratchCanvas.style.cssText = "position:absolute;inset:0;width:100%;height:100%;z-index:3;pointer-events:none;";
  area.appendChild(scratchCanvas);
  const ctx = scratchCanvas.getContext("2d");

  maskLayer.style.display = "none";

  let touchOffsetX = 0, touchOffsetY = 0, hasTouchOffset = false;
  let rafPending = false;
  let pendingPos = null;
  let resizingForContent = false;

  function getActiveImg() {
    return isMobile() ? (mobileImg || desktopImg) : (desktopImg || mobileImg);
  }

  function getSettings() {
    if (isMobile()) {
      return {
        top: {{ section.settings.first_text_mobile_top }},
        left: {{ section.settings.first_text_mobile_left }},
        widthPct: {{ section.settings.first_text_mobile_width }}
      };
    }
    return {
      top: {{ section.settings.first_text_top }},
      left: {{ section.settings.first_text_left }},
      widthPct: {{ section.settings.first_text_width }}
    };
  }

  function resize() {
    const rect = area.getBoundingClientRect();
    const dpr = window.devicePixelRatio || 1;

    scratchCanvas.width = rect.width * dpr;
    scratchCanvas.height = rect.height * dpr;
    scratchCanvas.style.width = rect.width + "px";
    scratchCanvas.style.height = rect.height + "px";

    ctx.setTransform(1, 0, 0, 1, 0, 0);
    ctx.scale(dpr, dpr);

    redraw();
  }

  function redraw() {
    const dpr = window.devicePixelRatio || 1;
    const w = scratchCanvas.width / dpr;
    const h = scratchCanvas.height / dpr;

    ctx.clearRect(0, 0, w, h);
    ctx.fillStyle = "white";
    ctx.fillRect(0, 0, w, h);

    const img = getActiveImg();

    if (img && img.complete && img.naturalWidth > 0) {
      const s = getSettings();
      const drawWidth = w * s.widthPct / 100;
      const drawHeight = drawWidth * img.naturalHeight / img.naturalWidth;

      const neededHeight = s.top + drawHeight + 40;

      if (!resizingForContent && neededHeight > h) {
        resizingForContent = true;
        area.style.height = neededHeight + "px";
        resize();
        resizingForContent = false;
        return;
      }

      ctx.drawImage(img, s.left, s.top, drawWidth, drawHeight);
    }
  }

  function erase(x, y) {
    if (!brushImg.complete) return;
    ctx.save();
    ctx.globalCompositeOperation = "destination-out";
    ctx.drawImage(brushImg, x - brushSize / 2, y - brushSize / 2, brushSize, brushSize);
    ctx.restore();
  }

  function scheduleErase(x, y) {
    pendingPos = { x, y };
    if (rafPending) return;
    rafPending = true;
    requestAnimationFrame(() => {
      rafPending = false;
      if (pendingPos) {
        erase(pendingPos.x, pendingPos.y);
        pendingPos = null;
      }
    });
  }

  function moveDragImage(x, y) {
    if (!dragImage) return;
    dragImage.style.left = (x - brushSize / 2) + "px";
    dragImage.style.top = (y - brushSize / 2) + "px";
  }

  function getPos(e) {
    const rect = area.getBoundingClientRect();
    return { x: e.clientX - rect.left, y: e.clientY - rect.top };
  }

  function handleMove(e) {
    const pos = getPos(e);
    moveDragImage(pos.x, pos.y);
    scheduleErase(pos.x, pos.y);
  }

  hitCanvas.addEventListener("mousemove", handleMove);

  hitCanvas.addEventListener("touchstart", e => {
    e.preventDefault();
    if (!dragImage) return;
    const touch = e.touches[0];
    const pos = getPos(touch);
    const dragRect = dragImage.getBoundingClientRect();
    const areaRect = area.getBoundingClientRect();
    touchOffsetX = (dragRect.left - areaRect.left + dragRect.width / 2) - pos.x;
    touchOffsetY = (dragRect.top - areaRect.top + dragRect.height / 2) - pos.y;
    hasTouchOffset = true;
  }, { passive: false });

  hitCanvas.addEventListener("touchmove", e => {
    e.preventDefault();
    const touch = e.touches[0];
    const pos = getPos(touch);
    const x = hasTouchOffset ? pos.x + touchOffsetX : pos.x;
    const y = hasTouchOffset ? pos.y + touchOffsetY : pos.y;
    moveDragImage(x, y);
    scheduleErase(x, y);
  }, { passive: false });

  hitCanvas.addEventListener("touchend", () => {
    hasTouchOffset = false;
  });

  window.addEventListener("resize", resize);

  function init() {
    const images = [brushImg, desktopImg, mobileImg].filter(Boolean);
    const notLoaded = images.filter(i => !i.complete);

    if (notLoaded.length === 0) {
      resize();
      return;
    }

    let loaded = 0;
    notLoaded.forEach(img => {
      img.onload = () => {
        if (++loaded >= notLoaded.length) resize();
      };
    });
  }

  init();
})();
</script>

