
<style>
@media (min-width:768px){
    .bis-content{
        font-size:{{ section.settings.content_size }};
    }
}
.bis-content {
    padding: 5px 18px;
    font-weight: 600;
}
.bis-images-wrapper {
    max-width: 628px;
    width: 100%;
    margin: 140px auto 270px;
}
.bis-images-wrapper img, .bis-images-wrapper video {
    max-width: 100%;
    width: 100%;
    height: 701px;
    object-fit: cover;
}
.bis-pagination {
    display: flex;
    align-items: center;
    gap: 10px;
}
.bis-pagination-item {
    color: #C4C4C4;
    cursor:pointer;
}
.bis-pagination-item.active {
    color: #000;
    text-decoration:underline;
}
@media (max-width:767px){
    .bis-content{
        font-size:{{ section.settings.content_size_m }};
    }
    .vbo-overlay-content{
        max-width: 90%;
        width: 100%;
        display: flex;
        justify-content: center;
    }
    .vbo-overlay-video video {
        width: 190px;
    }
    .vbo-overlay-video img {
        width: 190px;
        height: 190px;
        object-fit:cover;
    }
    .vbo-heading {
        width: 100%;
    }
    .bis-images-wrapper img, .bis-images-wrapper video {
        height: 420px;
    }
    .bis-pagination-item {
        font-size: 13px;
    }
    .bis-images-wrapper{
        padding: 0 18px;
    }
    .vbo-wrapper .vbo-bg-video video{
        height: 460px;
        object-fit: cover;
    }
    .bis-images-wrapper{
        margin: 140px auto 170px;
    }
}
</style>

<div class="bagspa-image-slider-main">
    <div class="bis-wrapper">
        {% if section.settings.content != blank %}
            <div class="bis-content">
                {{ section.settings.content }}
            </div>
        {% endif %}
        {% if section.blocks.size > 0 %}
            <div class="bis-images-wrapper">
                <div class="swiper bis-slider-{{ section.id }}">
                    <div class="swiper-wrapper">
                    {% for block in section.blocks %}
                        <div class="swiper-slide">
                            <div class="bis-media">
                                {% if block.settings.image != blank %}
                                    <img src="{{ block.settings.image | image_url }}" width="auto" height="auto" alt="image-{{ block.settings.image.alt }}">
                                {% endif %}
                            </div>
                        </div>
                    {% endfor %}
                    </div>
                </div>
                <div class="bis-pagination bis-paginationdots-{{ section.id }}">
                    {% for block in section.blocks %}
                        <span class="bis-pagination-item" data-index="{{ forloop.index0 }}">
                            {{ block.settings.pagination }}
                        </span>
                    {% endfor %}
                </div>
            </div>
        {% endif %}
    </div>
</div>


<script>
document.addEventListener("DOMContentLoaded", function () {
  const bis_swiper = new Swiper(".bis-slider-{{ section.id }}", {
    loop: true,
    autoHeight: true,
    speed: 500,
  });

  const bis_paginationItems = document.querySelectorAll(".bis-paginationdots-{{ section.id }} .bis-pagination-item");

  bis_paginationItems.forEach((item, index) => {
    item.addEventListener("click", () => {
      bis_swiper.slideToLoop(index);
    });
  });

  bis_swiper.on("slideChange", () => {
    const realIndex = bis_swiper.realIndex;
    bis_paginationItems.forEach((el, i) => {
      el.classList.toggle("active", i === realIndex);
    });
  });

  bis_paginationItems[0]?.classList.add("active");
});

</script>

{% schema %}
{
  "name": "BagSpa Image Slider",
  "tag": "section",
  "class": "section",
  "settings": [
    {
        "type": "textarea",
        "id": "content",
        "label": "Content",
        "default":"Ontion of Yyur informatio please be aware that no security measures are perfect or impenetrable, and we cannot guarantee “perfect sec. Ontion of Yyur informatio please be aware that no security measures are perfect."
    },
    {
        "type": "select",
        "id": "content_size",
        "label": "Font Size",
        "options": [
            {
                "label": "S",
                "value": "13px"
            },
            {
                "label": "M",
                "value": "26px"
            },
            {
                "label": "L",
                "value": "36px"
            },
            {
                "label": "XL",
                "value": "50px"
            },
            {
                "label": "XXL",
                "value": "134px"
            }
        ],
        "default":"26px"
    },
    {
        "type": "select",
        "id": "content_size_m",
        "label": "Font Size (Mobile)",
        "options": [
            {
                "label": "S",
                "value": "13px"
            },
            {
                "label": "M",
                "value": "26px"
            },
            {
                "label": "L",
                "value": "36px"
            },
            {
                "label": "XL",
                "value": "50px"
            },
            {
                "label": "XXL",
                "value": "134px"
            }
        ],
        "default":"26px"
    }
  ], 
  "blocks": [
    {
        "type": "block",
        "name":"Block",
        "settings": [
            {
                "type": "text",
                "id": "pagination",
                "label": "Pagination Text",
                "default":"PHOTO 01"
            },
            {
                "type": "image_picker",
                "id": "image",
                "label": "Image"
            }
        ]
    }
  ],
  "presets": [
    {
      "name": "BagSpa Image Slider",
    }
  ]
}
{% endschema %}