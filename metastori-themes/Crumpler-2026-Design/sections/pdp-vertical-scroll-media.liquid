{{ 'vertical-scroll-media-text.css' | asset_url | stylesheet_tag }}

<style>
.vsmt-wrapper-item{
    display: none;
}
.vsmt-wrapper-item.vsmt-active{
    display: block;
}
.vsmt--main-section{
    position: relative;
}
.vsmt-media-item{
    display:flex;
    justify-content: center;
    position: relative;
} 
.{{ section.id }} .vsmt-content{
    margin:0;
    color:#000;
    font-weight: 500;
    width:100%;
}

@media (min-width:768px){
    .{{ section.id }} .vsmt-content{
        font-size:{{ section.settings.content_size }};
    }
}
@media (max-width:767px){
    .{{ section.id }} .vsmt-content{
        font-size:{{ section.settings.content_size_m }};
    }
}
</style>

{% assign matched = false %}
<div class="vsmt--main {{ section.id }}">
    {% for variant in product.variants %}
        {% assign variant_media_data = variant.metafields.custom.vertical_scroll_media.value %}
        {% if variant_media_data != blank %}
            <div class="vsmt-wrapper-item {% if variant.id == product.selected_or_first_available_variant.id %}vsmt-active {% assign matched = true %}{% endif %}" data-variant-id="{{ variant.id }}">
                <div class="vsmt-wrapper">
                    <div class="vsmt-info">
                        {% if variant_media_data.content != blank %}
                            <div class="vsmt-content">{{ variant_media_data.content }}</div>
                        {% endif %}
                        {% if variant_media_data.image != blank or variant_media_data.video != blank %}
                            <div class="vsmt-single-media">
                                {% if variant_media_data.video != blank %}
                                        {{ variant_media_data.video.value | video_tag:controls:false, autoplay:true, loop:true, muted:true, playsinline:true, preload: 'none', class: 'scroll-video' }}
                                {% elsif variant_media_data.image != blank %}
                                    <img src="{{ variant_media_data.image | image_url }}" alt="image" width="auto" height="auto">
                                {% else %}
                                    {{ 'detailed-apparel-1' | placeholder_svg_tag: 'placeholder-svg' }}
                                {% endif %}
                            </div>
                        {% endif %}
                    </div>
                    <div class="vsmt-scroller">
                        {% for media_block in variant_media_data.blocks.value %}
            
                            <div class="vsmt-media-item vsmt-media-item-{{ variant.id }}-{{ forloop.index }}">
                                {% if media_block.link != blank %}
                                    <a href="{{ media_block.link }}" class="overlay-link"></a>
                                {% endif %}
                               
                                    {% comment %} Metafield nahi hai: pehle video, phir image, phir placeholder {% endcomment %}
                                    {% if media_block.video != blank %}
                                        {{ media_block.video.value | video_tag:autoplay:true, loop:true, muted:true, playsinline:true, controls: false, preload: 'none', class: 'scroll-video' }}
                                    {% elsif media_block.image != blank %}
                                        <img
                                            srcset="
                                            {%- if media_block.image.width >= 165 -%}{{ media_block.image | image_url: width: 165 }} 165w,{%- endif -%}
                                            {%- if media_block.image.width >= 360 -%}{{ media_block.image | image_url: width: 360 }} 360w,{%- endif -%}
                                            {%- if media_block.image.width >= 533 -%}{{ media_block.image | image_url: width: 1200 }} 533w,{%- endif -%}
                                            {%- if media_block.image.width >= 720 -%}{{ media_block.image | image_url: width: 1200 }} 720w,{%- endif -%}
                                            {%- if media_block.image.width >= 940 -%}{{ media_block.image | image_url: width: 1500 }} 940w,{%- endif -%}
                                            {%- if media_block.image.width >= 1066 -%}{{ media_block.image | image_url: width: 2000 }} 1066w,{%- endif -%}
                                            {%- if media_block.image.width >= 1550 -%}{{ media_block.image | image_url: width: 1550 }} 1550w,{%- endif -%}
                                            {%- if media_block.image.width >= 2000 -%}{{ media_block.image | image_url: width: 2000 }} 2000w,{%- endif -%}
                                            {%- if media_block.image.width >= 2500 -%}{{ media_block.image | image_url: width: 2500 }} 2500w,{%- endif -%}
                                            {{ media_block.image | image_url }} {{ media_block.image.width }}w
                                            "
                                            src="{{ media_block.image | image_url: width: 533 }}"
                                            class="motion-reduce"
                                            sizes="(min-width: 990px) calc((100vw - 130px) / 4), (min-width: 750px) calc((100vw - 120px) / 3), calc((100vw - 35px) / 2)"
                                            alt="{{ media_block.image.alt | escape }}"
                                            loading="lazy"
                                            width="{{ media_block.image.width }}"
                                            height="{{ media_block.image.height }}"
                                            >
                                    {% else %}
                                        {{ 'detailed-apparel-1' | placeholder_svg_tag: 'placeholder-svg' }}
                                    {% endif %}
                            </div>
                        {% endfor %}
                    </div>
                </div>
            </div>
        {% endif %}
    {% endfor %}

    {% assign variant_media_data = product.metafields.custom.vertical_scroll_media.value %}
    {% if variant_media_data != blank %}
        <div class="vsmt-wrapper-item {% if matched == false %}vsmt-active{% endif %}" data-product-id="{{ product.id }}">
            <div class="vsmt-wrapper">
                <div class="vsmt-info">
                    {% if variant_media_data.content != blank %}
                        <div class="vsmt-content">{{ variant_media_data.content }}</div>
                    {% endif %}
                    {% if variant_media_data.image != blank or variant_media_data.video != blank %}
                        <div class="vsmt-single-media">
                            {% if variant_media_data.video != blank %}
                                    {{ variant_media_data.video.value | video_tag:controls:false, autoplay:true, loop:true, muted:true, playsinline:true, preload: 'none', class: 'scroll-video' }}
                            {% elsif variant_media_data.image != blank %}
                                <img src="{{ variant_media_data.image | image_url }}" alt="image" width="auto" height="auto">
                            {% else %}
                                {{ 'detailed-apparel-1' | placeholder_svg_tag: 'placeholder-svg' }}
                            {% endif %}
                        </div>
                    {% endif %}
                </div>
                <div class="vsmt-scroller">
                    {% for media_block in variant_media_data.blocks.value %}
        
                        <div class="vsmt-media-item vsmt-media-item-{{ variant.id }}-{{ forloop.index }}">
                            {% if media_block.link != blank %}
                                <a href="{{ media_block.link }}" class="overlay-link"></a>
                            {% endif %}
                           
                                {% comment %} Metafield nahi hai: pehle video, phir image, phir placeholder {% endcomment %}
                                {% if media_block.video != blank %}
                                    {{ media_block.video.value | video_tag:autoplay:true, loop:true, muted:true, playsinline:true, controls: false, preload: 'none', class: 'scroll-video' }}
                                {% elsif media_block.image != blank %}
                                    <img
                                        srcset="
                                        {%- if media_block.image.width >= 165 -%}{{ media_block.image | image_url: width: 165 }} 165w,{%- endif -%}
                                        {%- if media_block.image.width >= 360 -%}{{ media_block.image | image_url: width: 360 }} 360w,{%- endif -%}
                                        {%- if media_block.image.width >= 533 -%}{{ media_block.image | image_url: width: 1200 }} 533w,{%- endif -%}
                                        {%- if media_block.image.width >= 720 -%}{{ media_block.image | image_url: width: 1200 }} 720w,{%- endif -%}
                                        {%- if media_block.image.width >= 940 -%}{{ media_block.image | image_url: width: 1500 }} 940w,{%- endif -%}
                                        {%- if media_block.image.width >= 1066 -%}{{ media_block.image | image_url: width: 2000 }} 1066w,{%- endif -%}
                                        {%- if media_block.image.width >= 1550 -%}{{ media_block.image | image_url: width: 1550 }} 1550w,{%- endif -%}
                                        {%- if media_block.image.width >= 2000 -%}{{ media_block.image | image_url: width: 2000 }} 2000w,{%- endif -%}
                                        {%- if media_block.image.width >= 2500 -%}{{ media_block.image | image_url: width: 2500 }} 2500w,{%- endif -%}
                                        {{ media_block.image | image_url }} {{ media_block.image.width }}w
                                        "
                                        src="{{ media_block.image | image_url: width: 533 }}"
                                        class="motion-reduce"
                                        sizes="(min-width: 990px) calc((100vw - 130px) / 4), (min-width: 750px) calc((100vw - 120px) / 3), calc((100vw - 35px) / 2)"
                                        alt="{{ media_block.image.alt | escape }}"
                                        loading="lazy"
                                        width="{{ media_block.image.width }}"
                                        height="{{ media_block.image.height }}"
                                        >
                                {% else %}
                                    {{ 'detailed-apparel-1' | placeholder_svg_tag: 'placeholder-svg' }}
                                {% endif %}
                        </div>
                    {% endfor %}
                </div>
            </div>
        </div>
    {% endif %}
</div>

<script>
document.addEventListener('DOMContentLoaded', function () {
    const variant_media_items = document.querySelectorAll('.vsmt-wrapper-item');
    const product_media_item = document.querySelector(`.vsmt-wrapper-item[data-product-id]`);

    document.addEventListener('variantUpdated', (event) => {
        const variantId = event.detail;
        const variant_media_item = document.querySelector(`.vsmt-wrapper-item[data-variant-id="${variantId}"]`);
        variant_media_items.forEach(item => {
            item.classList.remove('vsmt-active');
        });
        if (variant_media_item) {
            variant_media_item.classList.add('vsmt-active');
        }
        else if (product_media_item) {
            product_media.classList.add('vsmt-active');
        }
    });
});
</script>

{% schema %}
{
  "name": "PDP Vertical Media",
  "tag": "section",
  "class": "section pdp-vertical-media-section",
  "settings": [
    {
        "type": "select",
        "id": "content_size",
        "label": "Font Size",
        "options": [
            {
                "label": "S",
                "value": "13px"
            },
            {
                "label": "M",
                "value": "26px"
            },
            {
                "label": "L",
                "value": "36px"
            },
            {
                "label": "XL",
                "value": "50px"
            },
            {
                "label": "XXL",
                "value": "134px"
            }
        ],
        "default":"26px"
    },
    {
        "type": "select",
        "id": "content_size_m",
        "label": "Font Size (Mobile)",
        "options": [
            {
                "label": "S",
                "value": "13px"
            },
            {
                "label": "M",
                "value": "26px"
            },
            {
                "label": "L",
                "value": "36px"
            },
            {
                "label": "XL",
                "value": "50px"
            },
            {
                "label": "XXL",
                "value": "134px"
            }
        ],
        "default":"26px"
    }
  ], 
  "presets": [
    {
      "name": "PDP Vertical Media"
    }
  ]
}
{% endschema %}