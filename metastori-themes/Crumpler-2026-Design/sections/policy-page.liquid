<style>
.policy-page-wrapper {
    display: flex;
    align-items: flex-start;
}
.policy-content {
    width: 65%;
}
.policy-list {
    width: 33%;
    padding-right: 15px;
}
.policy-list {
    display: flex;
    flex-direction: column;
    margin-top: 26px;
    position: sticky;
    top: 58px;
}
.policy-page-link {
    font-size: 26px;
    line-height: 120%;
    font-weight: 400;
    color: #C4C4C4;
    font-family: "Neue Haas Grotesk Text Pro";
}
.last_updated {
    font-weight: 600;
    font-size: 10px;
    {% comment %} line-height: 100%; {% endcomment %}
    text-transform: uppercase;
    margin-top: 7px;
}
.policy-page-link.active-policy-link {
    color: #000;
}
.policy-content {
    font-size: 26px;
    line-height: 120%;
    font-weight: 400;
}
.policy-content strong {
    font-weight: 600;
}
.privacy-policy-width {
    padding: 0 1.2rem;
}
@media only screen and (min-width: 1026px) {
    details-modal.header__search_block {
        padding-left: 9px;
    }
    .privacy-policy-width {
        padding: 0 1.8rem;
    }
    .header__icons {
        width: 6%;
        display: flex;
        justify-content: end;
    }
    .policy-page-wrapper {
        gap: 8px;
    }
}
@media (max-width: 1025px){
    .policy-page-wrapper{
        flex-direction: column;
        gap: 190px;
    }
    .policy-list{
        position: relative;
        top: 0;
        width: 100%;
    }
    .policy-content {
        width: 100%;
    }
    .last_updated {
        font-size: 13px;
        margin-top: 9px;
    }
    .policy-content a {
        color: #000;
        text-decoration: underline;
        text-underline-offset: 4px;
    }
}
</style>

<div class="privacy-policy-width {% if section.settings.include_margins %}page-width{% endif %}{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}">
  <div class="policy-page-wrapper">
    <div class="policy-list">
        {% for block in section.blocks %}
            {% if block.type == 'policy' %}
                {% if block.settings.name != blank %}
                    <a class="policy-page-link {% if request.path contains block.settings.link %}active-policy-link{% endif %}" 
                        href="{{ block.settings.link }}">
                        {{ block.settings.name }}
                    </a>
                {% endif %}
            {% endif %}
        {% endfor %}
        <span class="last_updated">{{ section.settings.last_update }}</span>
    </div>
    <div class="policy-content">
        {{ page.content }}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Policy Page",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "checkbox",
      "id": "include_margins",
      "default": true,
      "label": "t:sections.apps.settings.include_margins.label"
    },
    {
        "type": "text",
        "id":"last_update",
        "label":"Last Update text",
        "default": "(Last updated: May 29, 2025)"
    }
  ],
  "blocks": [
    {
      "type": "policy",
      "name":"Policy List Item",
      "settings": [
        {
            "type": "text",
            "id": "name",
            "label": "Name"
        },
        {
            "type": "url",
            "id": "link",
            "label": "Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Policy Page"
    }
  ]
}
{% endschema %}
