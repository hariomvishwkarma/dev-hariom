{{ 'new-arrival-section.css' | asset_url | stylesheet_tag }}

<div class="new-arrival-main">
    <div class="{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}">
    <div class="new-arrival-wrapper">
        {%- for block in section.blocks -%}
            {% case block.type %}
                {% when 'media' %}
                    {% if block.settings.link != blank %}
                        <a href="{{ block.settings.link }}" 
                            class="new-arrival-item new-arrival-media nas-size-{{ block.settings.column }} 
                            {% if block.settings.outline == true %}nas_ouline{% endif %}"
                             {{ block.shopify_attributes }}
                        >
                    {% else %}
                        <div 
                            class="new-arrival-item new-arrival-media nas-size-{{ block.settings.column }}
                            {% if block.settings.outline == true %}nas_ouline{% endif %}"
                             {{ block.shopify_attributes }}
                        >
                    {% endif %}
                        <div class="nas-item-media">
                            {% if block.settings.image != blank %}
                                {% assign image_height = block.settings.image.width | divided_by: block.settings.image.aspect_ratio | round %}
                                {{ block.settings.image
                                | image_url: width: 3840
                                | image_tag:
                                    width: block.settings.image.width,
                                    height: image_height,
                                    class: 'nas_img',
                                    sizes: '100vw',
                                    widths: '320, 375, 414, 550, 750, 1100, 1500, 2000, 2500',
                                    alt: block.settings.title
                                }}
                            {% elsif block.settings.mux_playback_id != blank %}
                                {% assign mux_pid = block.settings.mux_playback_id | strip %}
                                <mux-player class="new_arrival_mux_player" playback-id="{{ mux_pid | escape }}"
                                    {% if block.settings.text != blank %}metadata-video-title="{{ block.settings.text | escape }}"{% endif %}
                                    muted autoplay="any" loop playsinline preload="auto" no-muted-pref
                                    style="--media-object-fit: cover; --media-object-position: center;--controls: none;"
                                ></mux-player>
                                {% assign mux_player_enabled = true %}
                            {% elsif block.settings.video != blank %}
                                {{ block.settings.video | video_tag:autoplay:true, loop:true, muted:true, preload: 'none', class:'nas_video scroll-video' }}
                            {% endif %}
                        </div>
                        {% if block.settings.text != blank %}
                            <span class="nas-item-text">{{ block.settings.text }}</span>
                        {% endif %}
                    {% if block.settings.link != blank %}
                    </a>
                    {% else %}
                        </div>
                    {% endif %}
                {% when 'product' %}
                    {% assign product = block.settings.product %}
                    {% if product != blank %}
                        {% if block.settings.variant_id != blank %}
                            {% assign variant_id = block.settings.variant_id | plus: 0 %}
                            {% assign selected_variant = product.variants | where: 'id', variant_id | first %}
                        {% endif %}
                        {% if selected_variant and block.settings.variant_id != blank %}
                            <a href="{{ selected_variant.url }}" 
                                class="new-arrival-item new-arrival-product nas-size-{{ block.settings.column }}
                                {% if block.settings.outline == true %}nas_ouline{% endif %}
                                {% unless selected_variant.available %} product_sold_out{% endunless %}
                                "
                                {{ block.shopify_attributes }}
                            >
                                <div class="nas-item-media">
                                    {% assign product_image = blank %}
                                    {% if block.settings.image != blank %}
                                        {% assign product_image = block.settings.image %}
                                    {% elsif block.settings.mux_playback_id != blank %}
                                        {% assign mux_pid = block.settings.mux_playback_id | strip %}
                                        <mux-player class="new_arrival_mux_player" playback-id="{{ mux_pid | escape }}"
                                            {% if block.settings.text != blank %}metadata-video-title="{{ block.settings.text | escape }}"{% endif %}
                                            muted autoplay="any" loop playsinline preload="auto" no-muted-pref
                                            style="--media-object-fit: cover; --media-object-position: center;--controls: none;"
                                        ></mux-player>
                                        {% assign mux_player_enabled = true %}
                                    {% elsif block.settings.video != blank %}
                                        {{ block.settings.video | video_tag:autoplay:true, loop:true, muted:true, preload: 'none', class:'nas_video scroll-video' }}
                                    {% elsif selected_variant.featured_image != blank %}
                                        {% assign product_image = selected_variant.featured_image %}
                                    {% elsif product.featured_image != blank %}
                                        {% assign product_image = product.featured_image %}
                                    {% endif %}
                                        {% if product_image != blank %}
                                        {% assign image_height = product_image.width | divided_by: product_image.aspect_ratio | round %}
                                        {{ product_image
                                        | image_url: width: 3840
                                        | image_tag:
                                            width: product_image.width,
                                            height: image_height,
                                            class: 'nas_img',
                                            sizes: '100vw',
                                            widths: '320, 375, 414, 550, 750, 1100, 2000',
                                            alt: product_image.title
                                        }}
                                        {% endif %}
                                </div>
                                <div class="nas-item-text {% if block.settings.uppercase == true %}nas--text-uppercase{% endif %}">
                                    <div class="nas-item-title">
                                        {% unless selected_variant.available %}<span class="nas-item-soldout">SOLD OUT: </span>{% endunless %}
                                        {% if block.settings.text != blank %}{{ block.settings.text }} {% else %}{{ selected_variant.title }} {% endif %}
                                        <span>{{ selected_variant.price | money_without_trailing_zeros }}</span>
                                    </div>
                                </div>
                            </a>
                        {% else %}
                            <a href="{{ product.url }}" 
                                class="new-arrival-item new-arrival-product nas-size-{{ block.settings.column }}
                                {% if block.settings.outline == true %}nas_ouline{% endif %}
                                {% unless product.available %} product_sold_out{% endunless %}
                                "
                                {{ block.shopify_attributes }}
                            >
                                <div class="nas-item-media">
                                    {% assign product_image = blank %}
                                    {% if block.settings.image != blank %}
                                        {% assign product_image = block.settings.image %}
                                    {% elsif block.settings.mux_playback_id != blank %}
                                        {% assign mux_pid = block.settings.mux_playback_id | strip %}
                                        <mux-player class="new_arrival_mux_player" playback-id="{{ mux_pid | escape }}"
                                            {% if block.settings.text != blank %}metadata-video-title="{{ block.settings.text | escape }}"{% endif %}
                                            muted autoplay="any" loop playsinline preload="auto" no-muted-pref
                                            style="--media-object-fit: cover; --media-object-position: center;--controls: none;"
                                        ></mux-player>
                                        {% assign mux_player_enabled = true %}
                                    {% elsif block.settings.video != blank %}
                                        {{ block.settings.video | video_tag:autoplay:true, loop:true, muted:true, preload: 'none', class:'nas_video scroll-video' }}
                                    {% elsif product.featured_image != blank %}
                                        {% assign product_image = product.featured_image %}
                                    {% endif %}
                                        {% if product_image != blank %}
                                        {% assign image_height = product_image.width | divided_by: product_image.aspect_ratio | round %}
                                        {{ product_image
                                        | image_url: width: 3840
                                        | image_tag:
                                            width: product_image.width,
                                            height: image_height,
                                            class: 'nas_img',
                                            sizes: '100vw',
                                            widths: '320, 375, 414, 550, 750, 1100, 1500, 2000, 2500',
                                            alt: product_image.title
                                        }}
                                        {% endif %}
                                </div>
                                <div class="nas-item-text {% if block.settings.uppercase == true %}nas--text-uppercase{% endif %}">
                                    <div class="nas-item-title">
                                        {% unless product.available %}<span class="nas-item-soldout">SOLD OUT: </span>{% endunless %}
                                        {% if block.settings.text != blank %}{{ block.settings.text }} {% else %}{{ product.title }} {% endif %}
                                        <span>{{ product.price | money_without_trailing_zeros }}</span>
                                    </div>
                                </div>
                            </a>
                        {% endif %}
                    {% endif %}
            {% endcase %}
        {%- endfor -%}
    </div>
    </div>
</div>

{% if mux_player_enabled %}
<script src="https://cdn.jsdelivr.net/npm/@mux/mux-player/dist/mux-player.js" defer></script>
<script>
    (function () {
        if (!window.customElements) return;
        var sectionId = '{{ section.id }}';
        function muxPlayers() {
            var root = document.getElementById(sectionId);
            var players = [];
            function addAll(nl) {
            if (!nl || !nl.length) return;
            for (var i = 0; i < nl.length; i++) players.push(nl[i]);
            }
            if (root) addAll(root.querySelectorAll('.new_arrival_mux_player'));
            return players;
        }
        function attemptPlay(player) {
            if (!player || !player.hasAttribute('autoplay')) return;
            try {
            player.muted = true;
            var p = player.play();
            if (p && typeof p.catch === 'function') p.catch(function () {});
            } catch (e) {}
        }
        function bootMuxAutoplay() {
            muxPlayers().forEach(function (player) {
            function markMuxReady() {
                if (!player.classList.contains('mux-is-ready')) {
                player.classList.add('mux-is-ready');
                }
            }
            attemptPlay(player);
            player.addEventListener('loadedmetadata', function once() {
                player.removeEventListener('loadedmetadata', once);
                attemptPlay(player);
            });
            player.addEventListener('canplay', function onceC() {
                player.removeEventListener('canplay', onceC);
                attemptPlay(player);
                markMuxReady();
            });
            player.addEventListener('loadeddata', markMuxReady, { once: true });
            player.addEventListener('playing', markMuxReady, { once: true });
            setTimeout(function () { attemptPlay(player); }, 200);
            setTimeout(function () { attemptPlay(player); }, 900);
            setTimeout(markMuxReady, 1400);
            });
        }
        customElements.whenDefined('mux-player').then(function () {
            if (document.readyState === 'loading') {
            document.addEventListener('DOMContentLoaded', bootMuxAutoplay);
            } else {
            bootMuxAutoplay();
            }
        });
        document.addEventListener('shopify:section:load', function (ev) {
            var el = ev.target;
            if (el && el.id === 'shopify-section-' + sectionId) {
            customElements.whenDefined('mux-player').then(bootMuxAutoplay);
            }
        });
    })();
</script>
{% endif %}

