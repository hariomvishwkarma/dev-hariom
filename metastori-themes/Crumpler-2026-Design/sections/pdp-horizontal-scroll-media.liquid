{% assign matched = false %}
<!-- Dynamic Media Scroll Section -->
<section id="{{ section.id }}" class="media-scroll-section">
    <!-- Fixed text container (top-left) -->
    {% for variant in product.variants %}
        {% assign variable_media_data = variant.metafields.custom.horizontal_scroll_media.value %}
        {% if variable_media_data != blank %}
        <div class="pdp-horizontal-scroll-item {% if variant.id == product.selected_or_first_available_variant.id %}active_phs_item {% assign matched = true %}{% endif %}" data-variant-id="{{ variant.id }}">

            <div class="media-fixed-text">
                {% if variable_media_data.title != blank %}
                    <h3>{{ variable_media_data.title }}</h3>
                {% endif %}
                {% if variable_media_data.description != blank %}
                    <p>{{ variable_media_data.description }}</p>
                {% endif %}
            </div>
        
            <!-- Horizontal Scroll Container -->
            <div class="media-scroll-container">
                <div class="swiper msc-slider">
                    <div class="swiper-wrapper">
                        {% for media_block in variable_media_data.blocks.value %}
                            <div class="media-scroll-item media-scroll-item-{{ variant.id }}-{{ forloop.index }} swiper-slide">
                                <!-- Background Content -->
                                <div class="item-background">
                                    {% if media_block.background_video != blank %}
                                    {{ media_block.background_video.value | video_tag: autoplay: true, loop: true, muted: true, class: 'video-background', preload: 'metadata', playsinline: true }}
                                    {% elsif media_block.background_image != blank %}
                                    {% render 'responsive-image', 
                                        image: media_block.background_image,
                                        class: 'image-background'
                                    %}
                                    {% elsif media_block.background_color != blank %}
                                    <div class="color-background" style="background-color: {{ media_block.background_color }}; display:block;"></div>
                                    {% else %}
                                    <div class="placeholder-background">
                                        {{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}
                                    </div>
                                    {% endif %}
                                </div>
                            </div>
                            {% capture desktop_css %}{{ desktop_css }}
                                .media-scroll-item-{{ variant.id }}-{{ forloop.index }}{width:{{ media_block.block_width }};}
                            {% endcapture %}
                            {% capture mobile_css %}{{ mobile_css }}
                                .media-scroll-item-{{ variant.id }}-{{ forloop.index }}{width:{{ media_block.block_width_mobile }};}
                            {% endcapture %}
                        {% endfor %}
                    </div>
                </div>  
            </div>
        </div>
        {% endif %}
    {% endfor %}

    {% assign variable_media_data = product.metafields.custom.horizontal_scroll_media.value %}
    {% if variable_media_data != blank %}
      <div class="pdp-horizontal-scroll-item {% if matched == false %}active_phs_item{% endif %}" data-product-id="{{ product.id }}">

        <div class="media-fixed-text">
            {% if variable_media_data.title != blank %}
                <h3>{{ variable_media_data.title }}</h3>
            {% endif %}
            {% if variable_media_data.description != blank %}
                <p>{{ variable_media_data.description }}</p>
            {% endif %}
        </div>
    
        <!-- Horizontal Scroll Container -->
        <div class="media-scroll-container">
            <div class="swiper msc-slider">
                <div class="swiper-wrapper">
                    {% for media_block in variable_media_data.blocks.value %}
                        <div class="media-scroll-item media-scroll-item-{{ product.id }}-{{ forloop.index }} swiper-slide">
                            <!-- Background Content -->
                            <div class="item-background">
                                {% if media_block.background_video != blank %}
                                {{ media_block.background_video.value | video_tag: autoplay: true, loop: true, muted: true, class: 'video-background', preload: 'metadata', playsinline: true }}
                                {% elsif media_block.background_image != blank %}
                                {% render 'responsive-image', 
                                    image: media_block.background_image,
                                    class: 'image-background'
                                %}
                                {% elsif media_block.background_color != blank %}
                                <div class="color-background" style="background-color: {{ media_block.background_color }}; display:block;"></div>
                                {% else %}
                                <div class="placeholder-background">
                                    {{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}
                                </div>
                                {% endif %}
                            </div>
                        </div>
                        {% capture desktop_css %}{{ desktop_css }}
                            .media-scroll-item-{{ product.id }}-{{ forloop.index }}{width:{{ media_block.block_width }};}
                        {% endcapture %}
                        {% capture mobile_css %}{{ mobile_css }}
                            .media-scroll-item-{{ product.id }}-{{ forloop.index }}{width:{{ media_block.block_width_mobile }};}
                        {% endcapture %}
                    {% endfor %}
                </div>
            </div>  
        </div>
      </div>
    {% endif %}

  </section>

  <script>
    document.addEventListener('DOMContentLoaded', function () {
      const variant_media_items = document.querySelectorAll('.pdp-horizontal-scroll-item');
      const product_media_item = document.querySelector(`.pdp-horizontal-scroll-item[data-product-id]`);

      document.addEventListener('variantUpdated', (event) => {
        const variantId = event.detail;
        const variant_media_item = document.querySelector(`.pdp-horizontal-scroll-item[data-variant-id="${variantId}"]`);
        variant_media_items.forEach(item => {
          item.classList.remove('active_phs_item');
        });
        if (variant_media_item) {
          variant_media_item.classList.add('active_phs_item');
        }
        else if (product_media_item) {
          product_media.classList.add('active_phs_item');
        }
      });

    });
  </script>
  
  <style>
  #{{ section.id }} {
    position: relative;
    width: 100%;
  }
  
  .pdp-horizontal-scroll-item{
    display: none;
  }
  .pdp-horizontal-scroll-item.active_phs_item{
    display: block;
  }

  #{{ section.id }} .media-fixed-text {
    position: absolute;
    top: 2rem;
    left: 2rem;
    z-index: 2;
    max-width: 320px;
    color: {{ section.settings.text_color }};
    font-family: inherit;
    text-transform: uppercase;
    pointer-events: none;
    mix-blend-mode: difference;
  }
  
  #{{ section.id }} .media-fixed-text h3 {
    font-size: {{ section.settings.title_size }}px;
    font-weight: {{ section.settings.title_weight }};
    margin-bottom: 0.5rem;
    line-height: 1.2;
    color:white;
  }
  
  #{{ section.id }} .media-fixed-text p {
    font-size: {{ section.settings.description_size }}px;
    line-height: 1.4;
    margin: 0;
    color: #fff;
  }
  
  #{{ section.id }} .media-scroll-container, .msc-slider {
    width: 100%;
    height: 100%;
  }
  
  #{{ section.id }} .media-scroll-container::-webkit-scrollbar {
    display: none; /* Chrome, Safari, Edge */
  }
  
  #{{ section.id }} .media-scroll-item {
    position: relative;
    height:-webkit-fill-available;
    {% comment %} height: 100%; {% endcomment %}
    flex: 0 0 auto;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
  }
  
  #{{ section.id }} .item-background {
    width: 100%;
    height: 100%;
  }
  
  #{{ section.id }} .color-background {
    width: 100%;
    height: 100%;
  }
  
  #{{ section.id }} .image-background,
  #{{ section.id }} .placeholder-background {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  
  #{{ section.id }} .video-background {
    width: 100%;
    height: 100%;
  }
  
  #{{ section.id }} .item-content {
    position: relative;
    z-index: 2;
    text-align: center;
    color: white;
    padding: 2rem;
    max-width: 80%;
  }
  
  #{{ section.id }} .item-title {
    font-size: 2.5rem;
    font-weight: bold;
    margin-bottom: 1rem;
    text-transform: uppercase;
  }
  
  #{{ section.id }} .item-description {
    font-size: 1.125rem;
    margin-bottom: 1.5rem;
    line-height: 1.6;
  }
  
  #{{ section.id }} .item-button {
    display: inline-block;
    padding: 0.75rem 2rem;
    background: white;
    color: black;
    text-decoration: none;
    text-transform: uppercase;
    font-weight: bold;
    border-radius: 2px;
    transition: all 0.3s ease;
  }
  
  #{{ section.id }} .item-button:hover {
    background: #f5f5f5;
    transform: translateY(-2px);
  }
  
  {{ desktop_css }}
  
  /* Responsive Design */
  @media (max-width: 768px) {

    {{ mobile_css }}
    
    #{{ section.id }} .media-fixed-text {
      top: 1rem;
      left: 1rem;
      max-width: 200px;
    }
    
    #{{ section.id }} .media-fixed-text h3 {
      font-size: {{ section.settings.title_size | times: 0.7 }}px;
    }
    
    #{{ section.id }} .media-fixed-text p {
      font-size: {{ section.settings.description_size | times: 0.7 }}px;
    }
    
    #{{ section.id }} .item-title {
      font-size: 1.75rem;
    }
    
    #{{ section.id }} .item-description {
      font-size: 1rem;
    }
  }
  
  @media (max-width: 480px) {
    
    #{{ section.id }} .media-fixed-text {
      max-width: 150px;
    }
    
    #{{ section.id }} .item-title {
      font-size: 1.5rem;
    }
    
    #{{ section.id }} .item-content {
      max-width: 90%;
    }
  }
  </style>
  
  <script>
  (function () {
  
    function mscScrollSwiper(section) {
        const sliders = section.querySelectorAll('.msc-slider');
        if (!sliders.length) return;
        
        sliders.forEach((slider) => {
            if (slider.swiper) {
            slider.swiper.update();
            return;
            }
        
            new Swiper(slider, {
            slidesPerView: 'auto',
            spaceBetween: 0,
        
            freeMode: {
                enabled: true,
                momentum: true,
                momentumRatio: 1,
                momentumBounce: false,
                sticky: false,
            },
        
            mousewheel: {
                forceToAxis: true,
                sensitivity: 1,
            },
        
            grabCursor: true,
            observer: true,
            observeParents: true,
            resizeObserver: true,
            updateOnWindowResize: true,
            });
        });
    }
  
    document.addEventListener('DOMContentLoaded', function () {
      document.querySelectorAll('.shopify-section').forEach(section => {
        mscScrollSwiper(section);
      });
    });
  
    document.addEventListener('shopify:section:load', function (e) {
      mscScrollSwiper(e.target);
    });
  
    document.addEventListener('shopify:section:unload', function (e) {
        e.target.querySelectorAll('.msc-slider').forEach((slider) => {
            if (slider.swiper) {
            slider.swiper.destroy(true, true);
            }
        });
    });
  
  })();
  </script>
  
  {% schema %}
  {
    "name": "PDP Horizontal Media",
    "settings": [
      {
        "type": "header",
        "content": "Text Settings"
      },
      {
        "type": "range",
        "id": "title_size",
        "label": "Title Font Size",
        "min": 12,
        "max": 36,
        "step": 1,
        "default": 16,
        "unit": "px"
      },
      {
        "type": "range",
        "id": "description_size",
        "label": "Description Font Size",
        "min": 10,
        "max": 24,
        "step": 1,
        "default": 14,
        "unit": "px"
      },
      {
        "type": "select",
        "id": "title_weight",
        "label": "Title Font Weight",
        "options": [
          { "value": "400", "label": "Normal" },
          { "value": "600", "label": "Semibold" },
          { "value": "700", "label": "Bold" },
          { "value": "800", "label": "Extra Bold" }
        ],
        "default": "700"
      },
      {
        "type": "color",
        "id": "text_color",
        "label": "Text Color",
        "default": "#FFFFFF"
      }
    ],
    "presets": [
      {
        "name": "PDP Horizontal Media",
        "category": "Custom Sections"
      }
    ]
  }
  {% endschema %}