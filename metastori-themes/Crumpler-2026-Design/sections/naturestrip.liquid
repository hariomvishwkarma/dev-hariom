{% style %}
  .image-designer-section {
    display: flex;
    position: relative;
    overflow: hidden;

    padding-top: {{ section.settings.section_padding }}px;
    padding-left: {{ section.settings.section_padding }}px;
    padding-right: {{ section.settings.section_padding }}px;
    padding-bottom: {{ section.settings.section_padding_bottom }}px;

    flex-direction: column;
    height: 90vh;

    background-size: cover;
    background-position: center;
    background-repeat: no-repeat;
  }

  @media screen and (min-width: 1280px) {
    .image-designer-section {
      {% if section.settings.desktop_background_image != blank %}
        background-image: url('{{ section.settings.desktop_background_image | image_url }}');
      {% endif %}
    }
  }

  @media screen and (min-width: 900px) and (max-width: 1279px) {
    .image-designer-section {
      {% if section.settings.tablet_background_image != blank %}
        background-image: url('{{ section.settings.tablet_background_image | image_url }}');
      {% endif %}
    }
  }

  @media screen and (max-width: 899px) {
    .image-designer-section {
      {% if section.settings.mobile_background_image != blank %}
        background-image: url('{{ section.settings.mobile_background_image | image_url }}');
      {% endif %}
    }
  }

  .image-designer-title {
    pointer-events: none;
    user-select: none;
    z-index: {{ section.settings.section_title_z }};
    color: {{ section.settings.section_title_color }};
    font-weight: {{ section.settings.section_title_weight }};
  }

  @media screen and (min-width: 900px) {
    .image-designer-title {
      font-size: {{ section.settings.font_size }}vw;
    }
  }

  @media screen and (max-width: 899px) {
    .image-designer-title {
      font-size: {{ section.settings.mobile_font_size }}vw;
    }
  }

  .position-top-left { justify-content: flex-start; align-items: flex-start; text-align: left; }
  .position-top-center { justify-content: flex-start; align-items: center; text-align: center; }
  .position-top-right { justify-content: flex-start; align-items: flex-end; text-align: right; }

  .position-middle-left { justify-content: center; align-items: flex-start; text-align: left; }
  .position-middle-center { justify-content: center; align-items: center; text-align: center; }
  .position-middle-right { justify-content: center; align-items: flex-end; text-align: right; }

  .position-bottom-left { justify-content: flex-end; align-items: flex-start; text-align: left; }
  .position-bottom-center { justify-content: flex-end; align-items: center; text-align: center; }
  .position-bottom-right { justify-content: flex-end; align-items: flex-end; text-align: right; }

  .image-link-wrapper,
  .video-block {
    position: absolute;
    transform: translate(-50%, -50%);
    user-select: none;
    opacity: {{ section.settings.opacity }};
    height: auto;
    display: block;
  }

  .image-link-wrapper {
    cursor: pointer;
  }

  .image-link-wrapper.is-draggable,
  .video-block.is-draggable {
    cursor: grab;
  }

  .image-block {
    display: block;
    width: 100%;
    height: auto;
    pointer-events: none;
  }

  .mobile-custom-button-wrapper {
      display: flex;
      justify-content: center;
      width: 100%;
      position: absolute;
      left: 0;
      bottom: {{ section.settings.mobile_button_bottom }}px;
      z-index: 999;
  }

  @media screen and (max-width: 899px) {
    .mobile-custom-button-wrapper {
      display: flex;
      justify-content: center;
      width: 100%;
      position: absolute;
      left: 0;
      bottom: {{ section.settings.mobile_button_bottom }}px;
      z-index: 999;
    }

    .mobile-custom-button {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      padding: 14px 28px;
      border: 1px solid #000;
      background: transparent;
      color: #000;
      text-decoration: none;
      text-transform: uppercase;
      letter-spacing: .05em;
      font-size: 14px;
      transition: all .2s ease;
    }

    .mobile-custom-button.clicked,
    .mobile-custom-button:active {
      background: transparent;
      color: black;
    }
  }

  {% for block in section.blocks %}
    {% assign b = block.settings %}

    .image-link-wrapper-{{ block.id }},
    .video-block-{{ block.id }} {
      z-index: {{ b.z_index }};
    }

    @media screen and (min-width: 1280px) {
      .image-link-wrapper-{{ block.id }},
      .video-block-{{ block.id }} {
        left: {{ b.desktop_x }}%;
        top: {{ b.desktop_y }}%;
        width: {{ b.desktop_width }}%;
      }
    }

    @media screen and (min-width: 900px) and (max-width: 1279px) {
      .image-link-wrapper-{{ block.id }},
      .video-block-{{ block.id }} {
        left: {{ b.tablet_x }}%;
        top: {{ b.tablet_y }}%;
        width: {{ b.tablet_width }}%;
      }
    }

    @media screen and (max-width: 899px) {
      .image-link-wrapper-{{ block.id }},
      .video-block-{{ block.id }} {
        left: {{ b.mobile_x }}%;
        top: {{ b.mobile_y }}%;
        width: {{ b.mobile_width }}%;
      }
    }
  {% endfor %}
{% endstyle %}

<div class="image-designer-section position-{{ section.settings.section_title_position }}">

  <div class="image-designer-title">
    {{ section.settings.section_title }}
  </div>

  {% for block in section.blocks %}
    {% assign b = block.settings %}

    {% if b.image != blank %}

      {% if b.link != blank %}
        <a
          href="{{ b.link }}"
          class="image-link-wrapper image-link-wrapper-{{ block.id }} {% if b.draggable %}is-draggable{% endif %}"
          {% if b.open_new_tab %}
            target="_blank"
            rel="noopener noreferrer"
          {% endif %}
          {% if b.audio_file != blank %}
            data-audio="{{ b.audio_file }}"
          {% endif %}
        >
      {% else %}
        <div
          class="image-link-wrapper image-link-wrapper-{{ block.id }} {% if b.draggable %}is-draggable{% endif %}"
          {% if b.audio_file != blank %}
            data-audio="{{ b.audio_file }}"
          {% endif %}
        >
      {% endif %}

        <img
          src="{{ b.image | image_url }}"
          class="image-block image-block-{{ block.id }}"
          width="100%"
          height="auto"
          data-id="{{ block.id }}"
        >

      {% if b.link != blank %}
        </a>
      {% else %}
        </div>
      {% endif %}

    {% elsif b.video != blank %}

      {{ b.video | video_tag:
        autoplay: true,
        muted: true,
        loop: true,
        controls: false,
        class: 'video-block video-block-' | append: block.id | append: ' is-draggable'
      }}

    {% endif %}
  {% endfor %}

  {% if section.settings.mobile_button_text != blank %}
    <div class="mobile-custom-button-wrapper">
      <a
        href="{{ section.settings.mobile_button_link }}"
        class="mobile-custom-button"
      >
        {{ section.settings.mobile_button_text }}
      </a>
    </div>
  {% endif %}
</div>

<script>
  document.addEventListener("DOMContentLoaded", function () {

    const container = document.querySelector(".image-designer-section");
    const draggables = container.querySelectorAll(".is-draggable");
    const clickableItems = container.querySelectorAll(".image-link-wrapper");

    let active = null;
    let shiftX = 0;
    let shiftY = 0;
    let hasDragged = false;
    let currentAudio = null;

    draggables.forEach(item => {

      item.addEventListener("mousedown", (e) => {
        e.preventDefault();
        hasDragged = false;
        startDrag(e.clientX, e.clientY, item);
        playAudio(item);

        document.addEventListener("mousemove", onMouseMove);
        document.addEventListener("mouseup", onMouseUp);
      });

      item.addEventListener("touchstart", (e) => {
        if (e.touches.length > 1) return;

        hasDragged = false;
        const touch = e.touches[0];

        startDrag(touch.clientX, touch.clientY, item);
        playAudio(item);

        document.addEventListener("touchmove", onTouchMove, { passive: false });
        document.addEventListener("touchend", onTouchEnd);
      });
    });

    clickableItems.forEach(item => {
      item.addEventListener("click", (e) => {
        if (hasDragged) {
          e.preventDefault();
        }
      });
    });

    function startDrag(clientX, clientY, element) {
      active = element;

      const rect = element.getBoundingClientRect();

      shiftX = clientX - rect.left;
      shiftY = clientY - rect.top;

      element.style.cursor = "grabbing";
    }

    function playAudio(item) {
      const audioUrl = item.dataset.audio;

      if (!audioUrl) return;

      if (currentAudio) {
        currentAudio.pause();
        currentAudio.currentTime = 0;
      }

      currentAudio = new Audio(audioUrl);
      currentAudio.loop = true;
      currentAudio.play();
    }

    function stopAudio() {
      if (currentAudio) {
        currentAudio.pause();
        currentAudio.currentTime = 0;
        currentAudio = null;
      }
    }

    function onMouseMove(e) {
      hasDragged = true;
      updatePosition(e.clientX, e.clientY);
    }

    function onTouchMove(e) {
      if (!active) return;
      if (e.touches.length > 1) return;

      hasDragged = true;

      const touch = e.touches[0];

      e.preventDefault();
      updatePosition(touch.clientX, touch.clientY);
    }

    function updatePosition(clientX, clientY) {
      if (!active) return;

      const containerRect = container.getBoundingClientRect();

      let x = clientX - containerRect.left - shiftX + active.offsetWidth / 2;
      let y = clientY - containerRect.top - shiftY + active.offsetHeight / 2;

      let leftPercent = (x / containerRect.width) * 100;
      let topPercent = (y / containerRect.height) * 100;

      leftPercent = Math.max(0, Math.min(100, leftPercent));
      topPercent = Math.max(0, Math.min(100, topPercent));

      active.style.left = leftPercent + "%";
      active.style.top = topPercent + "%";
    }

    function onMouseUp() {
      if (active) {
        active.style.cursor = "grab";
        active = null;
      }

      stopAudio();

      document.removeEventListener("mousemove", onMouseMove);
      document.removeEventListener("mouseup", onMouseUp);
    }

    function onTouchEnd() {
      if (active) {
        active.style.cursor = "grab";
        active = null;
      }

      stopAudio();

      document.removeEventListener("touchmove", onTouchMove);
      document.removeEventListener("touchend", onTouchEnd);
    }

    const mobileButton = document.querySelector(".mobile-custom-button");

    if (mobileButton) {
      mobileButton.addEventListener("click", function () {
        mobileButton.classList.add("clicked");
      });
    }
  });
</script>

{% schema %}
{
  "name": "Nature Strip v2",
  "settings": [
    {
      "type": "richtext",
      "id": "section_title",
      "label": "Section Title",
      "default": "<p>Your Title</p>"
    },
    {
      "type": "image_picker",
      "id": "desktop_background_image",
      "label": "Desktop Background Image 1280px+"
    },
    {
      "type": "image_picker",
      "id": "tablet_background_image",
      "label": "Tablet Background Image 900px - 1279px"
    },
    {
