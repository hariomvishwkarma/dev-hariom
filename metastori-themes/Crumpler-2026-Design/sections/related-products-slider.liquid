{{ 'component-card.css' | asset_url | stylesheet_tag }}
{{ 'component-price.css' | asset_url | stylesheet_tag }}
{{ 'section-related-products.css' | asset_url | stylesheet_tag }}

{% if section.settings.image_shape == 'blob' %}
  {{ 'mask-blobs.css' | asset_url | stylesheet_tag }}
{%- endif -%}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top_m }}px;
    padding-bottom: {{ section.settings.padding_bottom_m }}px;
  }
    .related-product-grid{
        padding-left:12px;
    }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
    .related-product-grid{
        padding-left:16px;
    }
  }
{%- endstyle -%}

{% style %}

    .cst-product-card {
      text-align: left;
      position: relative;
      overflow: hidden;
      transition: opacity 0.3s ease;
    }

    .cst-main-slider .cst-slide-inner {
      width: 100%;
      aspect-ratio: 17/20;
    }

    .cst-image-link {
      position: relative;
    }

    .cst-product-image-wrapper {
      aspect-ratio: 17/20;
      position: relative;
      background-color: #eee;
      overflow: hidden;
    }
    .cst-product-image-wrapper video{
      max-width: 100%;
      object-fit: cover;
      height: 100%;
      width: 100%;
    }

    .cst-product-image {
      display: block;
      height: 100%;
      max-width:100%;
    }
    .cst-product-image.skeleton,
    .cst-swatch-image.skeleton {
      opacity: 0;
    }

    .cst-swatch-image-wrapper {
      position: relative;
      background-color: #eee;
      overflow: hidden;
      display: flex;
      width: fit-content;
      height: fit-content;
    }

    .cst-swatch-wrapper .swiper-slide {
        width: fit-content!important;
    }

    .cst-swatch-image {
      display: block;
      cursor:pointer;
      height: 100%;
    }

    .cst-disabled::after {
      content: 'Sold Out :(';
      position: absolute;
      top: 50%;
      left: 50%;
      z-index: 1;
      display: block;
      transform: translate(-50%,-50%) rotate(-47.09deg);
      font-size: 75px;
      color: #FF0000;
      width: max-content;
    }

    .cst-product-title {
      margin-top: 4px;
      font-weight: 600;
      text-transform: uppercase;
      color:#000000;
      text-decoration:none;
      display: flex;
      padding: 0 0 0 10px;
      gap: 5px;
    }

    .product_card_image_badges {
      position: absolute;
      top: 6px;
      left: 10px;
      z-index: 5;
      display: flex;
      flex-wrap: wrap;
    }
    .product_card_image_badges img {
        max-height: 20px;
        object-fit: contain;
    }

    .cst-swatches {
      display: flex;
      align-items: center;
      margin-top: 0.4rem;
      gap: 8px;
      position: relative;
      padding: 0 10px;
    }

    .cst-swatches .cst-slide-inner {
      border: 0.8px solid transparent;
      transition: all 0.3s;
      width: fit-content;
      padding: .78px .94px .79px .96px;
    }

    .cst-swatches .swiper-slide.cst-active .cst-slide-inner {
      border-color: #333;
    }

    .cst-hidden {
      display: none !important;
    }

    .cst-pagination {
      display: flex;
      flex-wrap: wrap;
      justify-content: center;
      gap: 8px;
      margin: 30px 0;
    }

    .cst-page-button {
      padding: 2px 5px;
      text-decoration: none;
      font-size: 16px;
      color: #333;
      border-bottom: 1px solid transparent;
      transition: all 0.2s ease;
    }

    .cst-page-button:hover {
      border-color: #333;
    }

    .cst-page-button.active {
      border-color: #333;
    }

    .cst-main-slider,
    .cst-swatch-slider {
      display: block;
      width: 100%;
      overflow: hidden;
    }

    .swiper-button-prev,
    .swiper-button-next {
      position: relative;
      left: auto;
      right: auto;
      top: auto;
      bottom: auto;
      width: 18px;
      height: 100%;
      display: none;
      justify-content: center;
      align-items: center;
      margin: 0;
      justify-content: center;
      align-items: center;
      background-color: #fff;
    }

    .swiper-button-prev {
      position: absolute;
      left: 0;
      justify-content: start;
    }

    .swiper-button-next {
      position: absolute;
      right: 0;
      justify-content: end;
    }

    .swiper-button-prev::after,
    .swiper-button-next::after {
      font-size: 14px;
      color: #333;
    }

    .swiper-button-prev.swiper-button-disabled,
    .swiper-button-next.swiper-button-disabled {
      display: none !important;
    }

    @media(max-width: 425px) {
      .swiper-button-prev,
      .swiper-button-next {
        width: 14px;
      }

      .swiper-button-prev::after,
      .swiper-button-next::after {
        font-size: 10px;
        color: #333;
      }
    }

    .cst-tags-box {
      position: absolute;
      top: 0;
      left: 0;
      width: clamp(70px, 100vw, 200px);
      display: flex;
      flex-direction: column;
      gap: 5px;
      padding: 5px;
      border: 1px solid red;
    }

    .cst-img-box {
      display: flex;
      width: 70px;
      z-index: 1;
    }
    .cst-img-box img {
      display: flex;
    }
    .page-width-collection{ max-width:none; padding:0px 12px; margin:0; }
    @media screen and (min-width: 750px) {
      .grid {
          row-gap: 39px;
      }
    }
    @media (max-width: 1024px) {
      .cst-product-title{
        margin-top: 3px;
      }
    }
    .cst-swatches span.color-option {
        display: flex;
    }
    .cst-swatches .cst-swatch-image-wrapper span {
        display: inline-block;
        width: 26.2px;
        height: 10px;
        cursor: pointer;
        background-position: center;
        background: transparent;
        background-size: contain;
      }
    @media (max-width:767px){
      .cst-disabled::after{
        font-size: 38px;
      }
    }
{% endstyle %}

{% assign product_collections = '' %}
{% for coll in product.collections %}
    {% assign product_collections = product_collections | append:',' | append:coll.id %}
{% endfor %}

<div class="color-{{ section.settings.color_scheme }} gradient">
  <product-recommendations
    class="related-products section-{{ section.id }}-padding isolate{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}"
    data-url="{{ routes.product_recommendations_url }}?limit={{ section.settings.products_to_show }}"
    data-section-id="{{ section.id }}"
    data-product-id="{{ product.id }}"
  >
    {% if recommendations.performed and recommendations.products_count > 0 %}
        {% if section.settings.heading != blank %}
        <h2 class="related-products__heading inline-richtext {{ section.settings.heading_size }}">
            {{ section.settings.heading }}
        </h2>
        {% endif %}
      <ul
        class="grid product-grid related-product-grid"
        role="list"
      >
        <div class="product-grid-related-slider swiper">
            <div class="cst-wrapper swiper-wrapper">
                {% for recommendation in recommendations.products %}
                
                    {% assign product_show = false %}
                    {% for coll in recommendation.collections %}
                        {% if product_collections contains coll.id %}
                            {% assign product_show = true %}
                        {% endif %}
                    {% endfor %}

                    {% if product_show == true %}
                        <div class="swiper-slide">
                            <li class="related_grid__item">
                                {% render 'card-product-with-swatches', product:recommendation %}
                            </li>
                        </div>
                    {% endif %}

                {% endfor %}
            </div>
        </div>
      </ul>
    {% endif %}
  </product-recommendations>
  <div class="slider-wait-loader">
    <div class="wait_loader"></div>
  </div>
  {% if section.settings.image_shape == 'arch' %}
    {{ 'mask-arch.svg' | inline_asset_content }}
  {%- endif -%}
</div>

<script>

  
{% comment %} 
  document.addEventListener('DOMContentLoaded', () => {
    const loader = document.querySelector('.slider-wait-loader');
    let tries = 0;
    const maxTries = 40;

    const interval = setInterval(() => {
      const cards = document.querySelectorAll('.cst-product-card');

      if (++tries >= maxTries) {
        clearInterval(interval);
      }
      if (cards.length > 0) {
        setTimeout(()=>{
          initRecommendationSwipers();
          initCfcSwiper();
          if(loader){loader.style.display = 'none'}
          clearInterval(interval);
        },200);
      }
    }, 200);
  }); {% endcomment %}

</script>

{% schema %}
{
  "name": "Related-Products Slider",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "paragraph",
      "content": "t:sections.related-products.settings.paragraph__1.content"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "default": "t:sections.related-products.settings.paragraph__1.default",
      "label": "t:sections.related-products.settings.heading.label"
    },
    {
      "type": "select",
      "id": "heading_size",
      "options": [
        {
          "value": "h2",
          "label": "t:sections.all.heading_size.options__1.label"
        },
        {
          "value": "h1",
          "label": "t:sections.all.heading_size.options__2.label"
        },
        {
          "value": "h0",
          "label": "t:sections.all.heading_size.options__3.label"
        },
        {
          "value": "hxl",
          "label": "t:sections.all.heading_size.options__4.label"
        },
        {
          "value": "hxxl",
          "label": "t:sections.all.heading_size.options__5.label"
        }
      ],
      "default": "h1",
      "label": "t:sections.all.heading_size.label"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "min": 2,
      "max": 12,
      "step": 1,
      "default": 4,
      "label": "t:sections.related-products.settings.products_to_show.label"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "info": "t:sections.all.colors.has_cards_info",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "t:sections.all.padding.section_padding_heading"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 36
    },
    {
      "type": "header",
      "content": "Padding (Mobile)"
    },
    {
      "type": "range",
      "id": "padding_top_m",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom_m",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 36
    }
  ],
  "presets": [
    {
        "name": "Related-Products Slider"
    }
  ]
}
{% endschema %}