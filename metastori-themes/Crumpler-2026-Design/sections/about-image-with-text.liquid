{{ 'about-image-with-text.css' | asset_url | stylesheet_tag }}
<style>
  {% for block in section.blocks %}
    {% capture desktop_css %}{{desktop_css}}
      .img-{{ block.id }}{
       width:{{block.settings.width}}px; 
      }
      .ait_popup-content-{{ block.id }}{
        left:{{block.settings.left}}%;
        top:{{block.settings.top}}%;
        max-width:{{block.settings.width | plus:24}}px;
      }
    {% endcapture %}
    {% capture mobile_css %}{{mobile_css}}
      .img-{{ block.id }}{
       width:{{block.settings.width_mobile}}px; 
      }
      .ait_popup-content-{{ block.id }}{
        left:{{block.settings.left}}%;
        top:{{block.settings.top}}%;
        max-width:{{block.settings.width_mobile | plus:24}}px;
      }
    {% endcapture %}
  {% endfor %}

  .about_image_with_text_main{
    position:relative;
    width:100%;
  }
  .absolute_image_item img{
    max-width:100%;
  }
  .absolute_image_item{
    position: absolute;
    transform: translate(-50%, -50%);
  }
  @media (max-width:1025px){
    {{mobile_css}}
    .about_image_text_main_{{ section.id }}{
      min-height:{{section.settings.height_mobile}}px;
    }
    {% for block in section.blocks %}
      .absolute_image_item_{{ block.id }}{
        left:{{block.settings.left_m}}%;
        top:{{block.settings.top_m}}%;
        width:{{block.settings.width_mobile}}px;
        z-index: {% if block.settings.overlay_on_text == true %}1{% else %}0{% endif %};
      }
    {% endfor %}
    .about_image_text_main_{{ section.id }}, .about_image_with_text_flex{
      min-height:calc(100vh + {{section.settings.height_mobile}}px);
    }
  }
  @media (min-width:1026px){
    {{desktop_css}}
    .about_image_text_main_{{ section.id }}, .about_image_with_text_flex{
      min-height:calc(100vh + {{section.settings.height_desktop}}px);
    }
    {% for block in section.blocks %}
      .absolute_image_item_{{ block.id }}{
        left:{{block.settings.left}}%;
        top:{{block.settings.top}}%;
        width:{{block.settings.width}}px;
        z-index: {% if block.settings.overlay_on_text == true %}1{% else %}0{% endif %};
      }
    {% endfor %}
  }
</style>

<div class="about_image_with_text_main about_image_text_main_{{ section.id }}">
  <div class="about_image_with_text_flex"> 
    <div class="about_image_with_text_info"> 
      <div class="about_image_with_text_headings">
        {% if section.settings.heading != blank %}
          <h2 class="ait_heading_tag">{{ section.settings.heading }}</h2>
        {% endif %}
        {% if section.settings.heading_2 != blank %}
          <h2 class="ait_heading_tag">{{ section.settings.heading_2 }}</h2>
        {% endif %}
      </div>
      {% if section.settings.sub_heading != blank %}
        <div class="about_image_with_text-subheading">
          <h1 class="ait_heading_tag">{{ section.settings.sub_heading }}</h1>
        </div>
      {% endif %}
      <div class="about_image_with_text_content_box">
        {% if section.settings.content != blank %}
          <div class="about_image_with_text-content">
            {{ section.settings.content }}
          </div>
        {% endif %}
      </div>
      {% if section.settings.badge_image != blank %}
        <div class="ait_badge_image">
          <img class="ait_badge_img" src="{{ section.settings.badge_image | image_url }}" alt="main_image" width="auto" height="auto"/>
        </div>
      {% endif %}
    </div>
    {% if section.settings.image_mobile != blank %}
      <div class="ait_mobile_image">
        <img class="ait_mobile_img" src="{{ section.settings.image_mobile | image_url }}" alt="main_image" width="auto" height="auto"/>
      </div>
    {% else %}
      <div class="ait_mobile_image">
        <img class="ait_mobile_img" src="{{ section.settings.image | image_url }}" alt="main_image" width="auto" height="auto"/>
      </div>
    {% endif %}
    <div class="about_image_with_text_image">
        {% if section.settings.image != blank %}
          <img class="ait_desktop_image" src="{{ section.settings.image | image_url }}" alt="main_image" width="auto" height="auto"/>
        {% else %}
          {{ 'detailed-apparel-1' | placeholder_svg_tag: 'placeholder-svg' }}
        {% endif %}
    </div>
  </div>
  {% for block in section.blocks %}
    {% if block.type == 'image' %}
    <div class="absolute_image_item absolute_image_item_{{ block.id }}">
      {% if block.settings.link != blank %}<a href="{{ block.settings.link }}">{% endif %}
        <img class="absolute_image_img" src="{{ block.settings.image | image_url }}" width="auto" height="auto">
      {% if block.settings.link != blank %}</a>{% endif %}
    </div>
    {% endif %}
  {% endfor %}

  {% for block in section.blocks %}
    <div id="{{ block.settings.popup_id }}" class="ait_popup">
        <div class="popup_overlay"></div>
        <div class="ait_popup-content ait_popup-content-{{ block.id }}">
            <span class="close-btn">&times;</span>
            {% if block.settings.image != blank %}<img class="img-{{ block.id }}" src="{{ block.settings.image | image_url }}" width="auto" height="auto" alt="popup_image">{% endif %}
            {% if block.settings.heading != blank %}<h2>{{ block.settings.heading }}</h2>{% endif %}
            {% if block.settings.content != blank %}<div>{{ block.settings.content }}</div>{% endif %}
        </div>
    </div>  
  {% endfor %}
</div>

<script>
  var openPopupLinks = document.querySelectorAll(".about_image_with_text-content a");
  openPopupLinks.forEach(function(link) {
      link.addEventListener("click", function(event) {
          var href = link.getAttribute("href");
          if (href.startsWith("#")) {
              event.preventDefault();
              
              var popupId = href.substring(1); 
              var popup = document.getElementById(popupId);
              if (popup) {
                  popup.style.display = "block";
              }
          }
      });
  });
  var closeBtns = document.querySelectorAll(".close-btn");
  closeBtns.forEach(function(button) {
      button.addEventListener("click", function() {
          var popup = button.closest(".ait_popup");  
          if (popup) {
              popup.style.display = "none";
          }
      });
  });
  document.querySelectorAll('.popup_overlay').forEach(function(overlay) {
      overlay.addEventListener('click', function() {
          this.closest('.ait_popup').style.display = 'none';
      });
  });
</script>

