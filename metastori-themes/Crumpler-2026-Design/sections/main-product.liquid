<script>  
  let currentVariantId = {{ current_variant.id }};
function update_pdp_info(wrapper){
  const content = wrapper.querySelector('.metafield-rich_text_field');
  const btn = wrapper.querySelector('.read-more-btn');

  if (!content || !btn) return;

    const lineHeight = parseFloat(getComputedStyle(content).lineHeight);
    const maxLines = 10;
    const maxHeight = lineHeight * maxLines;

    content.style.display = '-webkit-box';
    const fullHeight = content.scrollHeight;

    if (fullHeight > maxHeight + 2) {
      btn.style.display = 'inline';
    }
}

function muxReload() {
  if (!window.customElements) return;
  var sectionId = '{{ section.id }}';
  function muxPlayers() {
    var root = document.getElementById(sectionId);
    var players = [];
    function addAll(nl) {
      if (!nl || !nl.length) return;
      for (var i = 0; i < nl.length; i++) players.push(nl[i]);
    }
    if (root) addAll(root.querySelectorAll('.swiper-slide .custom-3d-video-right mux-player'));
    return players;
  }
  function attemptPlay(player) {
    if (!player || !player.hasAttribute('autoplay')) return;
    try {
      player.muted = true;
      var p = player.play();
      if (p && typeof p.catch === 'function') p.catch(function () {});
    } catch (e) {}
  }
  function bootMuxAutoplay() {
    muxPlayers().forEach(function (player) {
      function markMuxReady() {
        if (!player.classList.contains('mux-is-ready')) {
          player.classList.add('mux-is-ready');
        }
      }
      attemptPlay(player);
      player.addEventListener('loadedmetadata', function once() {
        player.removeEventListener('loadedmetadata', once);
        attemptPlay(player);
      });
      player.addEventListener('canplay', function onceC() {
        player.removeEventListener('canplay', onceC);
        attemptPlay(player);
        markMuxReady();
      });
      player.addEventListener('loadeddata', markMuxReady, { once: true });
      player.addEventListener('playing', markMuxReady, { once: true });
      setTimeout(function () { attemptPlay(player); }, 200);
      setTimeout(function () { attemptPlay(player); }, 900);
      setTimeout(markMuxReady, 1400);
    });
  }
    bootMuxAutoplay();
}

document.addEventListener('DOMContentLoaded', function () {
  initProductSection('{{ section.id }}');

  document.querySelectorAll('.read-more-btn').forEach((btn)=>{
    btn.addEventListener('click', () => {
      const wrapper = btn.closest('.pdp_product_content');
      wrapper.classList.toggle('pc_expand');
      btn.textContent = wrapper.classList.contains('pc_expand')
        ? 'Read Less'
        : 'Read More';
    });

    const ups_items = document.querySelectorAll('.ups_hover_main');
