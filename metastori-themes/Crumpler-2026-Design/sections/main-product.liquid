<script src="{{ 'magnify.js' | asset_url }}" defer="defer"></script>

{% liquid
  assign current_variant = product.selected_or_first_available_variant
  assign gift_card_recipient_feature_active = false
  if product.gift_card?
    assign gift_card_recipient_feature_active = true
  endif
-%}
{% liquid
  assign needs_mux_script = false
  for block in section.blocks
    if block.type == 'video_block' or block.type == '3d_video_block' 
      assign mux_pid = block.settings.mux_playback_id | strip
      if mux_pid != blank
        assign needs_mux_script = true
        break
      endif
    endif
  endfor
  unless needs_mux_script
    for variant in product.variants
      if variant.metafields.custom.features != blank
        for item in variant.metafields.custom.features.value
          assign ft_mux = item.mux_embed_id | strip
          if ft_mux != blank
            assign needs_mux_script = true
            break
          endif
        endfor
      endif
    endfor
  endunless
  unless needs_mux_script
    if product.metafields.custom.feature_tabs != blank
      for item in product.metafields.custom.feature_tabs.value
        assign ft_mux = item.mux_embed_id | strip
        if ft_mux != blank
          assign needs_mux_script = true
          break
        endif
      endfor
    endif
  endunless
%}

<script>
  const mux_videos = [
    {
      "product_videos":{
        "packing": "{{ product.metafields.custom.mux_scroll_lock_video | strip }}",
        "three_d_scan": "{{ product.metafields.custom.mux_3d_scan_video | strip }}",
      }
    },
      {%- for variant in product.variants -%}
        {%- if variant.metafields.custom.mux_packing_video != blank or variant.metafields.custom.mux_3d_video != blank -%}
        {
          "{{ variant.id }}":{
          "packing": "{{ variant.metafields.custom.mux_packing_video | strip }}",
          "three_d_scan": "{{ variant.metafields.custom.mux_3d_video | strip }}",
        }
      }{% unless forloop.last %},{% endunless %}
        {%- endif -%}
      {%- endfor -%}
  ];
</script>

<div id="{{ section.id }}" class="product-section {%if gift_card_recipient_feature_active %}gift-product-section{% endif %}">
{% if needs_mux_script %}
  <script src="https://cdn.jsdelivr.net/npm/@mux/mux-player/dist/mux-player.js" defer></script>
{% endif %}
<div class="container">
  <div class="left">
    {% for block in section.blocks %}
      {% case block.type %}
        {% when 'product_title' %}
          <p class="product-title">{{ product.title }}</p>

        {% when 'product_price' %}
            {% assign is_sale_price = false %}
            {% if current_variant.compare_at_price > current_variant.price %}
              {% assign is_sale_price = true %}
            {% endif %}
            <p class="price">
              Price:
              <span class="price-value{% if is_sale_price %} price-value--sale{% endif %}">
                <span class="price-value-compare">{% if is_sale_price %}{{ current_variant.compare_at_price | money_without_trailing_zeros }}{% endif %}</span>
                <span class="price-value-current">{{ current_variant.price | money_without_trailing_zeros }}</span>
            </span>
          </p>

        {% when 'featured_tab' %}
              {% assign ft_match = false %}
              {% capture featured_tabs %}
                {% for variant in product.variants %}
                  {% if variant.metafields.custom.features != blank %}
                    <div class="featured_tab_item 
                      {% if product.selected_or_first_available_variant.id == variant.id %}show_ft_item{% assign ft_match = true %}{%endif %}" 
                      ft-variant="{{ variant.id }}"
                      >
                      {% for item in variant.metafields.custom.features.value %}
                        <span class="featured_tab_btn" popup="{{ block.id }}-{{ variant.id}}-{{ forloop.index }}">{{ item.title }}</span>
                      {% endfor %}
                    </div>    
                  {% endif %}
                {% endfor %}
                {% if product.metafields.custom.feature_tabs != blank %}
                  <div class="featured_tab_item {% if ft_match == false %}show_ft_item{% endif %}" data-product-ft>
                    {% for item in product.metafields.custom.feature_tabs.value %}
                      <span class="featured_tab_btn" popup="{{ block.id }}-{{ product.id }}-{{ forloop.index }}">{{ item.title }}</span>
                    {% endfor %}
                  </div>
                {% endif %}
              {% endcapture %}     
              {% if featured_tabs != blank %}   
                <div class="featured_tab_main" {{ block.shopify_attributes }}>
                  {{ featured_tabs }}
                </div>        
              {% endif %}

        {% when 'product_content' %}
          <div class="pdp_product_info">
            {% capture product_content %}
                {% assign matched_var = false %}
                {% for variant in product.variants %}
                  {% if variant.metafields.custom.variant_info != blank %}
                    <div class="pdp_pc_item
                      {% if product.selected_or_first_available_variant.id == variant.id %}
                        pdp_pc_show
                        {% assign matched_var = true %}
                      {% endif %}" 
                       data-variant-info="{{ variant.id }}">
                      <div class="pdp_product_content">
                        {{ variant.metafields.custom.variant_info | metafield_tag }}
                        <span class="read-more-btn">Read More</span>
                      </div>
                    </div>
                  {% endif %}
                {% endfor %}
                {% if product.metafields.custom.product_content != blank %}
                  <div class="pdp_pc_item {% if matched_var == false %}pdp_pc_show{% endif %}" data-product-info>
                    <div class="pdp_product_content">
                        {{ product.metafields.custom.product_content | metafield_tag }}
                        <span class="read-more-btn">Read More</span>
                    </div>
                  </div>
                {% endif %}
            {% endcapture %}
            {{ product_content }}
          </div>

        {% when 'product_delivery' %}
          
          {% case localization.country.iso_code %}
            {% when 'SG' %}{% assign active_country = 'Singapore' %}
            {% when 'JP' %}{% assign active_country = 'Japan' %}
            {% when 'MY' %}{% assign active_country = 'Malaysia' %}
            {% when 'NZ' %}{% assign active_country = 'New Zealand' %}
            {% when 'US' %}{% assign active_country = 'United States' %}
            {% when 'AU' %}{% assign active_country = 'Australia' %}
            {% else %} {% assign active_country = 'Worldwide' %}
          {% endcase %}

          {% assign delivery_list = product.metafields.custom.delivery_list.value %}
          {% if delivery_list != blank %}
            {% capture delivery_drop %}
              <div class="pc_delivery_main pc_delivery_main_mobile">
                <span class="pc_delivery_btn">Shipping & Returns +</span>
                <div class="pc_delivery_data">
                  <div class="delivery_country_list_content">
                    {%for delivery_country in delivery_list %}
                      <div class="delivery_tab_content_item {% if delivery_country.display_name contains active_country %}active_delivery{% endif %}" country_name="{{ delivery_country.display_name }}">
                        {{ delivery_country.shipping2 | metafield_tag }}
                      </div>
                      {% if forloop.first %}
                        {% if active_country != blank %}
                          {% assign active_delivery = active_country %}
                        {% else %}
                          {% assign active_delivery = delivery_country.display_name %}
                        {% endif %}
                      {% endif %}
                    {% endfor %}
                  </div>
                  <div class="delivery_country_list_dropdown">
                    <button class="delivery_tab_selected">
                      <span class="delivery_tab_selected_text">{{ active_delivery }}</span>
                      <svg width="11" height="7" viewBox="0 0 11 7" fill="none" xmlns="http://www.w3.org/2000/svg">
                        <mask id="path-1-outside-1_1_3084" maskUnits="userSpaceOnUse" x="-0.40625" y="-0.737305" width="11" height="8" fill="black">
                        <rect fill="white" x="-0.40625" y="-0.737305" width="11" height="8"/>
                        <path d="M9.95375 0.861695L5.27375 5.7887L0.59375 0.861695L1.00975 0.536695L5.27375 4.9567L9.53775 0.536695L9.95375 0.861695Z"/>
                        </mask>
                        <path d="M9.95375 0.861695L5.27375 5.7887L0.59375 0.861695L1.00975 0.536695L5.27375 4.9567L9.53775 0.536695L9.95375 0.861695Z" fill="black"/>
                        <path d="M9.95375 0.861695L10.2438 1.13718L10.5472 0.81773L10.2 0.546486L9.95375 0.861695ZM5.27375 5.7887L4.98373 6.06418L5.27375 6.3695L5.56377 6.06418L5.27375 5.7887ZM0.59375 0.861695L0.347492 0.546485L0.000300339 0.817729L0.303731 1.13717L0.59375 0.861695ZM1.00975 0.536695L1.29763 0.258978L1.04745 -0.000354707L0.763493 0.221485L1.00975 0.536695ZM5.27375 4.9567L4.98587 5.23441L5.27375 5.53282L5.56163 5.23441L5.27375 4.9567ZM9.53775 0.536695L9.78401 0.221486L9.50005 -0.000354278L9.24987 0.258978L9.53775 0.536695ZM9.95375 0.861695L9.66373 0.586216L4.98373 5.51322L5.27375 5.7887L5.56377 6.06418L10.2438 1.13718L9.95375 0.861695ZM5.27375 5.7887L5.56377 5.51322L0.883769 0.586215L0.59375 0.861695L0.303731 1.13717L4.98373 6.06418L5.27375 5.7887ZM0.59375 0.861695L0.840008 1.1769L1.25601 0.851905L1.00975 0.536695L0.763493 0.221485L0.347492 0.546485L0.59375 0.861695ZM1.00975 0.536695L0.721872 0.814412L4.98587 5.23441L5.27375 4.9567L5.56163 4.67898L1.29763 0.258978L1.00975 0.536695ZM5.27375 4.9567L5.56163 5.23441L9.82563 0.814412L9.53775 0.536695L9.24987 0.258978L4.98587 4.67898L5.27375 4.9567ZM9.53775 0.536695L9.29149 0.851905L9.70749 1.17691L9.95375 0.861695L10.2 0.546486L9.78401 0.221486L9.53775 0.536695Z" fill="black" mask="url(#path-1-outside-1_1_3084)"/>
                      </svg>
                    </button>
                    <div class="delivery_btn_selector">
                      {%for delivery_country in delivery_list %}
                        <button class="delivery_tab_btn" country_name="{{ delivery_country.display_name }}">{{ delivery_country.display_name }}</button>
                      {% endfor %}
                    </div>
                  </div>
                </div>
              </div>
            {% endcapture %}
            <div class="desktop_delivery_main">{{ delivery_drop }}</div>
          {% endif %}

          {% if localization.country.iso_code == 'AU' %}
            <button class="store_availability_desktop">Store Availability +</button>
          {% endif %}

        {% when 'accordion_block' %}
          {% capture pdp_accordion %}{{ pdp_accordion }}
          <div class="pdp_accordion" {{ block.shopify_attributes }}>
            <div class="rt_accordion_title">
              <span class="rt_title_close">{{ block.settings.title }} +</span>
              <span class="rt_title_open">{{ block.settings.title }} -</span>
            </div>
            <div class="rt_accordion_content">{{ block.settings.content }}</div>
          </div>
          {% endcapture %}
          <div class="desktop_pdp_accordion">
            {{ pdp_accordion }}
          </div>

        {% when 'richtext_block' %}
          <div class="desktop_richtext_block" {{ block.shopify_attributes }}>
            <div class="block_text">
              {{ block.settings.content }}
            </div>
          </div>

        {% when 'size_options' %}
            {% assign metaobjsize = product.metafields.custom.extra_sizes.value %}
            {% assign metaobjsizename = metaobjsize.size_name.value %}
            {% if metaobjsize %}
              <div class="size">
                Size:
                <div class="sizes">
                  {% for mproduct in metaobjsize.size_product.value %}
                    {% assign index = forloop.index0 %}
                    <a
                      href="{{ mproduct.url }}"
                      class="size-option {% if product.id == mproduct.id %}active{% endif %}"
                      data-size-name="{{ metaobjsizename[index] }}"
                    >
                      {{ metaobjsizename[index] }}
                    </a>
                  {% endfor %}
                </div>
              </div>
            {% elsif product.options contains 'Size' %}
              <div class="size">
                Size:
                <div class="sizes">
                  {% for option in product.options_with_values %}
                    {% if option.name == 'Size' or option.name == 'size' %}
                      {% for value in option.values %}
                        <a href="?variant={{ product.variants[forloop.index0].id }}"
                          class="size-option {% if option.selected_value == value %}active{% endif %}"
                          data-size-name="{{ value }}"
                        >
                          {{ value }}
                        </a>
                      {% endfor %}
                    {% endif %}
                  {% endfor %}
                </div>
              </div>
            {% endif %}

            {% if gift_card_recipient_feature_active %}
              <div class="gift-variants_main">
                {{ product.options_with_values[0].name }}:
                <div class="gift-variants">
                  {% for variant in product.variants %}
                    <input type="radio" name="gift_variant" class="gift_variant_radio" id="gift_{{ variant.id }}" data-id="{{ variant.id }}" 
                    {% if current_variant.id == variant.id %} checked {%endif %} hidden/>
                    <label for="gift_{{ variant.id }}" class="gift_variant_item">{{ variant.title }}</label>
                  {% endfor %}
                </div>
              </div>
            {% endif %}

        {% when 'color_options' %}
          {% assign color_option_names = 'color,colour' | split: ',' %}
          {% for option in product.options_with_values %}
            {% assign option_name_down = option.name | downcase %}
            {% if color_option_names contains option_name_down %}
              <p
                class="color"
                style="                    margin-bottom: {{ block.settings.margin_bottom }}px;"
              >
                  {{- option.name }}:
                <span id="selected-color" data-color="{{option.selected_value}}">{{ option.selected_value }}</span>
              </p>

              <div class="color-boxes">
                {% assign option_index = option.position | minus: 1 %}

                {% for color in option.values %}
                  
                  {% assign variant_disabled = false %}
                  {% for variant in product.variants %}
                    {% if variant.options[option_index] == color and variant.metafields.custom.hide_variant_from_collection_page == true %}
                      {% assign variant_disabled = true %}
                      {% break %}
                    {% endif %}
                  {% endfor %}

                  {% if variant_disabled == true %}
                    {% continue %}
                  {% endif %}

                    {% render 'swatch',
                      swatch: color.swatch,
                      option_value: color,
                      product: product,
                      alt_swatches: true,
                      swatch_size: 18,
                      shape: 'square',
                      active_swatch:option.selected_value
                    %}
                {% endfor %}
              </div>
            {% endif %}
          {% endfor %}

        {% when 'product_description' %}
          {% if product.metafields.info.headline != blank %}
            <div class="desc">{{ product.metafields.info.headline | metafield_tag }}</div>
            {% assign product_desc = product.metafields.info.headline | metafield_tag %}
          {% endif %}
          {% comment %}
          <p class="desc">{{ product.description | strip_html }}</p>
          {% assign product_desc = product.description | strip_html %}
          {% endcomment %}

        {% when 'pickup_availability' %}

          {{ 'component-pickup-availability.css' | asset_url | stylesheet_tag }}

          {%- assign pick_up_availabilities = current_variant.store_availabilities
            | where: 'pick_up_enabled', true
          -%}

          {% style %}
            pickup-availability-drawer{
              z-index:100;
            }
            pickup-availability[available]{
              min-height:auto;
            }
          {% endstyle %}
          <pickup-availability
            class="product__pickup-availabilities no-js-hidden quick-add-hidden"
            {% if current_variant.available and pick_up_availabilities.size > 0 %}
              available
            {% endif %}
            data-root-url="{{ routes.root_url }}"
            data-variant-id="{{ current_variant.id }}"
            data-has-only-default-variant="{{ product.has_only_default_variant }}"
            data-product-page-color-scheme="gradient color-{{ section.settings.color_scheme }}"
            {{ block.shopify_attributes }}
          >
            <template>
              <pickup-availability-preview class="pickup-availability-preview">
                {% render 'icon-unavailable' %}
                <div class="pickup-availability-info">
                  <p class="caption-large">{{ 'products.product.pickup_availability.unavailable' | t }}</p>
                  <button class="pickup-availability-button link link--text underlined-link">
                    {{ 'products.product.pickup_availability.refresh' | t }}
                  </button>
                </div>
              </pickup-availability-preview>
            </template>
          </pickup-availability>
          <p class="custom-message">{{ settings.announcement_text }}</p>
          <script src="{{ 'pickup-availability.js' | asset_url }}" defer="defer"></script>
          
        {% when 'custom_message' %}
          <p class="custom-message">{{ settings.announcement_text }}</p>

        {% when 'add_to_cart' %}
          <form
            action="{{ routes.cart_add_url }}"
            method="post"
            enctype="multipart/form-data"
            id="product-form-{{ section.id }}" class="desktop_atc_form"
          >
            <input name="quantity" value="1" type="hidden"/>
            {% for option in product.options_with_values %}
                {% if option.name == 'Size' or option.name == 'size' %}
                  {% assign selected_size = option.selected_value %}
                  {% assign size_index = forloop.index0 %}
                {% endif %}
            {% endfor %}
            <select name="id" id="product-select-{{ section.id }}" style="display: none;" class="product-form-select">
              {% for variant in product.variants %}
                {%if selected_size and variant.options[size_index] != selected_size %}
                  {% continue %}
                {%endif %}
                <option
                  value="{{ variant.id }}"
                  {% if variant == product.selected_or_first_available_variant %}
                    selected="selected"
                  {% endif %}
                  {% unless variant.inventory_policy == 'continue' %}
                    inventory="{{ variant.inventory_quantity }}"
                  {% endunless %}
                  price="{{ variant.price | money_without_trailing_zeros }}"
                  compare_price="{% if variant.compare_at_price > variant.price %}{{ variant.compare_at_price | money_without_trailing_zeros }}{% endif %}"
                  option1="{{ variant.options[0] | downcase }}" option2="{{ variant.options[1] | downcase }}" option3="{{ variant.options[2] | downcase }}"
                >
                  {{ variant.title }} - {{ variant.price | money }}
                </option>
              {% endfor %}
            </select>
            {% assign selected_variant_available = product.selected_or_first_available_variant.available %}
            <button
              type="submit"
              class="add-cart"
              {% unless selected_variant_available == true %}
                disabled
              {% endunless %}
            >
              {% if selected_variant_available == true %}
                Add To Cart
              {% else %}
                Sold Out
              {% endif %}
            </button>
          </form>

        {% when 'shipping_info' %}
          <p class="small-text">
            {{ block.settings.info }}
          </p>

        {% when 'paypal_code' %}
          {% capture paypal_block %}
          <div class="paypal-liquid-block {% if block.settings.show_shiping_info == false %} show_shiping_info-false{% endif %}">
            {% if block.settings.show_shiping_info == true %}
              <p class="small-text">{{ block.settings.shiping_info_text }}</p>
              <div class="cus-liftime_bag small-text">{{ block.settings.liftime_bag }}</div>
            {% endif %}
            {{ block.settings.liquid }}
          </div>
          {% endcapture %}
          <div class="desktop-paypal_block">{{ paypal_block }}</div>
        
        {% when 'custom_liquid' %}
          <div class="custom-liquid-block">
            {{ block.settings.custom_liquid_code }}
          </div>
        {% else %}

      {% endcase %}
    {% endfor %}
    {% if gift_card_recipient_feature_active %}
      <div class="gift-content-main">
        <div class="gift-content-btn">
          I want to send this as a gift. 
          <input type="checkbox" id="gift-content-toggle" class="gift-content-toggle hidden" name="gift-content-toggle"/>
          <label for="gift-content-toggle" class="gift-toggle-box"></label>
        </div>
        <div class="gift-content-form">
          <div class="gift__field">
            <input class="gift__input" id="Recipient-email-template--18429558063183__main" type="email" placeholder="Recipient Email" name="properties[Recipient email]" value="" aria-invalid="false" data-gtm-form-interact-field-id="1" required>
            <span class="error_mssg">Email can't be blank.</span>
          </div>
          <div class="gift__field">
            <input class="gift__input" autocomplete="name" type="text" id="Recipient-name-template--18429558063183__main" name="properties[Recipient name]" placeholder="Recipient Name" value="" aria-invalid="false" data-gtm-form-interact-field-id="2" required>
            <span class="error_mssg">Recipient name can't be blank.</span>
          </div>
          <div class="gift__field">
            <input class="gift__input text-body" autocomplete="send_on" type="date" name="properties[Send on]" value="" aria-invalid="false" placeholder="YYYY-MM-DD" pattern="\d{4}-\d{2}-\d{2}">
            {% comment %} <label>SEND ON (OPTIONAL) dd/mm/yyyy</label> {% endcomment %}
          </div>
          <div class="gift__field">
            <textarea rows="10" id="Recipient-message-template--18429558063183__main" class="text-area gift__input" name="properties[Message]" maxlength="200" placeholder="Message (optional)" aria-label="Message (optional) 200 characters max" aria-invalid="false"></textarea>
            <span class="gift__small">200 characters max</span>
          </div>
        </div>
      </div>
    {%endif %}
  </div>

  {%- assign selected_variant_available = product.selected_or_first_available_variant.available -%}
  <div class="center-container">
    <div class="right {% unless selected_variant_available %}sold-out-wrapper{% endunless %}">
      <div class="image-wrapper">
        <img
          id="main-image-{{ section.id }}"
          srcset="
            {%- if product.featured_image.width >= 940 -%}{{ product.featured_image | image_url: width: 940 }} 940w,{%- endif -%}
            {%- if product.featured_image.width >= 1066 -%}{{ product.featured_image | image_url: width: 1066 }} 1066w,{%- endif -%}
            {%- if product.featured_image.width >= 1550 -%}{{ product.featured_image | image_url: width: 1550 }} 1550w,{%- endif -%}
            {%- if product.featured_image.width >= 2000 -%}{{ product.featured_image | image_url: width: 2000 }} 2000w,{%- endif -%}
            {%- if product.featured_image.width >= 2500 -%}{{ product.featured_image | image_url: width: 2500 }} 2500w,{%- endif -%}
            {{ product.featured_image | image_url }} {{ product.featured_image.width }}w
          "
          src="{{ product.featured_image | image_url: width: 533 }}"
          sizes="(min-width: {{ settings.page_width }}px) {{ settings.page_width | minus: 130 | divided_by: 4 }}px, (min-width: 990px) calc((100vw - 130px) / 4), (min-width: 750px) calc((100vw - 120px) / 3), calc((100vw - 35px) / 2)"
          alt="{{ product.featured_image.alt | escape }}"
          class="motion-reduce img-magnify-hover"
          loading="lazy"
          width="{{ product.featured_image.width }}"
          height="{{ product.featured_image.height }}"
        >
    </div>

      <div class="stack-images-main">
        <div class="stack-images--main">
          <div class="stack-images-big">
            {% for image in product.images %}
              {% assign image_height = image.width | divided_by: image.aspect_ratio | round %}
              <div class="stack-images-item" position="{{ forloop.index }}">
                {{ image
                  | image_url: width: 1200
                  | image_tag:
                      width: image.width,
                      height: image_height,
                      sizes: '100vw',
                      widths: '1000, 1250, 1500, 1750, 2000, 2250, 2500, 2750, 3000, 3200',
                      alt:image.alt,
                      class:"img-magnify-hover"
                  }}
              </div>
            {% endfor %}
          </div>

          {% assign variant_mux_pid = current_variant.metafields.custom.mux_packing_video | strip %}
          {% assign variant_threed_mux_pid = current_variant.metafields.custom.mux_3d_video | strip %}
          {% for block in section.blocks %}
            {% if block.type == 'video_block' %}
              {% assign mux_pid = block.settings.mux_playback_id | strip %}
              {% assign video_file = block.settings.video_file %}
              {% if mux_pid == blank and variant_mux_pid == blank %}{% assign hide_mux = true %}{% endif %}

              {% comment %} {% if mux_pid != blank or video_file != blank %} {% endcomment %}
              <div class="stack-images-item" position="video-{{ forloop.index }}">
                {% render 'pdp_video_block', block:block, variant_mux_pid:variant_mux_pid, hide_mux:hide_mux, video_t:"packing_video_mux" %}
                {% capture video_thumb %}
                  <div class="stack-thumbs-item stack-thumbs-video" position="video-{{ forloop.index }}" data-video-id="{{ block.id }}" 
                  {% if hide_mux %}style="display: none;"{% endif %}>
