<style>
  .richtext_slider_main{
    margin:52px 0;
  }
  .richtext_slider_container{
    margin:0 auto;
    max-width:580px;
  }
  .richtext_slide_img{
    max-width:500px;
    margin-top: 12px;
  }
  .richtext_slide_info p{margin:0;}
  .richtext_slide_info {
    font-weight: 400;
    font-size: 16px;
    line-height: 22.4px;
    text-align: center;
  }
  .richtext_slider_main .slick-dots li button,
  .richtext_slider_main .slick-dots li button:before, .richtext_slider_main .slick-dots li{
    width:8px;height:8px;
    padding:0;
  }
  .richtext_slider_main .slick-dots li.slick-active button{    background: transparent;}
  @media (max-width:767px){
    .richtext_slide_img{max-width:90%;}
  }
  .richtext_slider_main{height:0;overflow:hidden;}
</style>
<div class="richtext_slider_main">

  <div class="richtext_slider_container">
    <div class="richtext_slider richtext_slider_{{ section.id }}">
      {% for block in section.blocks %}
        <div class="richtext_slide_item">
          {% if block.settings.richtext != blank %}
            <div class="richtext_slide_info">
              {{ block.settings.richtext }}
            </div>
          {% endif %}
          {% if block.settings.image != blank %}
            <img class="richtext_slide_img" src="{{ block.settings.image | image_url }}" width="auto" height="auto" alt="{{ block.settings.richtext }}"/>
          {% endif %}
        </div>
      {% endfor %}
    </div>
  </div>

  <script>
    $(document).ready(function(){
      $('.richtext_slider_main').css('height','100%');
      $('.richtext_slider_{{ section.id }}').slick({
          dots: true,
          infinite: true,
          speed: 300,
          slidesToShow: 1,
          arrows: false,
          autoplay: true,
          autoplaySpeed: 5000
      });
    });
  </script>
  
</div>

{% schema %}
  {
    "name": "RichText Slider",
    "settings": [],
    "blocks": [
      {
        "type": "block",
        "name":"Block",
        "settings": [
          {
            "type": "richtext",
            "id": "richtext",
            "label": "Richtext"
          },
          {
            "type": "image_picker",
            "id": "image",
            "label": "Image"
          }
        ]
      }
    ],
    "presets": [
      {
        "name": "RichText Slider"
      }
    ]
  }
{% endschema %}