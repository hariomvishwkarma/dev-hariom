<div
  class="iti-highlight section-block-{{ section.id }}"
  style="
    --iti-center-bg: {{ section.settings.center_background }};
    --iti-center-color: {{ section.settings.center_text_color }};
  "
>
  <div class="iti-highlight-container">
    <div class="iti-highlight__grid">
      <div class="iti-highlight__col iti-highlight__col--image">
        {% if section.settings.left_image != blank %}
          <div class="iti-highlight__media">
            {{
              section.settings.left_image
              | image_url: width: 1200
              | image_tag:
                loading: 'lazy',
                widths: '375, 550, 750, 1100, 1500',
                class: 'iti-highlight__image',
                alt: section.settings.center_heading | escape
            }}
          </div>
        {% endif %}
      </div>

      <div class="iti-highlight__col iti-highlight__col--content">
        <div class="iti-highlight__content">
          {% if section.settings.center_heading != blank %}
            <h3 class="iti-highlight__heading">{{ section.settings.center_heading }}</h3>
          {% endif %}
          {% if section.settings.center_text != blank %}
            <div class="iti-highlight__text rte">{{ section.settings.center_text }}</div>
          {% endif %}
          {% if section.settings.center_author != blank %}
            <p class="iti-highlight__author">{{ section.settings.center_author }}</p>
          {% endif %}
        </div>
      </div>

      <div class="iti-highlight__col iti-highlight__col--image">
        {% if section.settings.right_image != blank %}
          <div class="iti-highlight__media">
            {{
              section.settings.right_image
              | image_url: width: 1200
              | image_tag:
                loading: 'lazy',
                widths: '375, 550, 750, 1100, 1500',
                class: 'iti-highlight__image',
                alt: section.settings.center_heading | escape
            }}
          </div>
        {% endif %}
      </div>
    </div>
  </div>
</div>

{% stylesheet %}
  .iti-highlight {
    padding-top: 32px;
    padding-bottom: 32px;
  }

  .iti-highlight-container {
    width: 100%;
    max-width: 1337px;
    padding: 0 50px;
    margin: 0 auto;
  }

  .iti-highlight__grid {
    display: grid;
    grid-template-columns: 1fr 0.78fr 1fr;
    gap: 24px;
    align-items: stretch;
  }

  .iti-highlight__col {
    min-width: 0;
  }

  .iti-highlight__media {
    height: 100%;
    border-radius: 10px;
    overflow: hidden;
    background: #f3f3f3;
  }

  .iti-highlight__image {
    width: 100%;
    height: 100%;
    display: block;
    object-fit: cover;
  }

  .iti-highlight__content {
    height: 100%;
    border-radius: 10px;
    padding: 28px 26px;
    background: var(--iti-center-bg);
    color: var(--iti-center-color);
    display: flex;
    flex-direction: column;
    justify-content: center;
    text-align: center;
  }

  .iti-highlight__heading {
    margin: 0 0 12px;
    font-size: 24px;
    line-height: 1.2;
    color: currentColor;
  }

  .iti-highlight__text {
    font-size: 18px;
    line-height: 1.45;
    color: currentColor;
  }

  .iti-highlight__text p {
    margin: 0;
    color: currentColor;
  }

  .iti-highlight__author {
    margin: 18px 0 0;
    font-size: 32px;
    line-height: 1.1;
    font-weight: 600;
    color: currentColor;
  }

  @media (max-width: 1199px) {
    .iti-highlight__grid {
      grid-template-columns: 1fr;
      gap: 16px;
    }


    .iti-highlight__heading {
      font-size: 21px;
    }

    .iti-highlight__text {
      font-size: 16px;
    }

    .iti-highlight__author {
      font-size: 26px;
    }
  }
  @media only screen and (max-width: 749px) {
    .iti-highlight__text p {
      font-size: 15px !important;
    }
    .iti-highlight__author {
      font-size: 20px !important;
    }
    .iti-highlight__content {
      padding: 15px 26px;
    }
    .iti-highlight-container {
      padding: 0 30px;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Image text highlight",
  "settings": [
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "header",
      "content": "Images"
    },
    {
      "type": "image_picker",
      "id": "left_image",
      "label": "Left image"
    },
    {
      "type": "image_picker",
      "id": "right_image",
      "label": "Right image"
    },
    {
      "type": "header",
      "content": "Center content"
    },
    {
      "type": "text",
      "id": "center_heading",
      "label": "Heading",
      "default": "What customers say"
    },
    {
      "type": "richtext",
      "id": "center_text",
      "label": "Text content",
      "default": "<p>I have always taken ingredient quality seriously. With B'spoke, they're transparent about what's in their products and where it all comes from. I know I'm giving my body the best.</p>"
    },
    {
      "type": "text",
      "id": "center_author",
      "label": "Author",
      "default": "Malaika Arora"
    },
    {
      "type": "color",
      "id": "center_background",
      "label": "Background color",
      "default": "#efece2"
    },
    {
      "type": "color",
      "id": "center_text_color",
      "label": "Text color",
      "default": "#1f1f1f"
    }
  ],
  "presets": [
    {
      "name": "Image text image highlight"
    }
  ]
}
{% endschema %}
