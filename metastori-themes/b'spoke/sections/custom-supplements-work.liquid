{% schema %}
{
  "name": "Supplements Info Section",
  "settings": [
    {
          "type": "text",
          "id": "title1",
          "label": "Title",
          "default": "How do these supplements work"
        },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background Color",
      "default": "#fef6d3"
    },
    {
      "type": "image_picker",
      "id": "supplement_img",
      "label": "Right Image"
    }
  ],
  "blocks": [
    {
      "type": "info_item",
      "name": "Info Item",
      "settings": [
        {
          "type": "image_picker",
          "id": "icon",
          "label": "Icon"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "High Tech Formula"
        },
        {
          "type": "text",
          "id": "description",
          "label": "Description",
          "default": "Evidence-based ingredients that work to regulate stomach acid levels."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Supplements Info Section"
    }
  ]
}
{% endschema %}


<div class="supplements-section" style="background-color: {{ section.settings.background_color }};">
 <div class="grand-suplemnts-sect">
  <div class="child-grant">
    <div class="supplem-heading">
      <h2 class="supplements-section__title">{{ section.settings.title1 }}</h2>
    </div>
    <div class="supplements-section__items">
    {% for block in section.blocks %}
    <div class="supplements-section__item">
     <div class="icon-img">
        {% if block.settings.icon %}
        <img src="{{ block.settings.icon | img_url: 'small' }}" alt="{{ block.settings.title }}" class="supplements-section__icon">
      {% endif %}
     </div>
     <div class="icon-content">
      <h4 class="supplements-section__item-title">{{ block.settings.title }}</h4>
      <p class="supplements-section__item-description">{{ block.settings.description }}</p>
      <span style="color: #2CB67D; cursor: pointer;" class="supplement_read_moree">Read More</span>
     </div>
    </div>
    {% endfor %}
  </div>
  </div>
  <div class="supplements-section-righ-img">
       <img src="{{ section.settings.supplement_img  | img_url: '500x500' }}" alt="{{ }}">
  </div>
 </div>
</div>
<style>
.supplements-section {
  padding: 40px 50px;
margin: auto;
}

.supplements-section__title {
  font-size: 24px;
  margin-bottom: 30px;
}

.supplements-section__items {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
  gap: 20px;
}

.supplements-section__icon {
  width: 50px;
  height: auto;
  margin-bottom: 10px;
}

  .supplements-section__items p {
    font-size: 14px;
    margin:0px !important;
}
  .supplements-section__item {
    display: flex;
    align-items: center;
    width: 48%;
    gap:10px;
}
.grand-suplemnts-sect {
    display: flex;
    justify-content: space-between;
align-items: center;
}
/* Responsive */
    @media (max-width: 768px){
      .grand-suplemnts-sect {
    flex-direction: column-reverse;
}

.supplements-section-righ-img img {
    width: 100%;
}


.supplem-heading h2 {
    max-width: 89xp;
}

h2.supplements-section__title {
    font-size: 25px;
    max-width: 224px;
    font-weight: bold;
}

.supplements-section__item {
    width: 100%;
    gap: 25px;
}
    }

@media (min-width: 769px){
.child-grant {
    width: 65%;
}

.supplements-section-righ-img {
    width: 35%;
}
}

.supplements-section__title {
    font-size: 29px;
    margin-bottom: 30px;
    margin-top: 0px;
    font-family: 'zapf-humanist-601';
    /* max-width: 260px; */
    line-height: 30px;
}

.supplements-section__items {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 25px;
    max-width: 900px;
}

.supplements-section__item-title {
    font-size: 18px;
    font-weight: bold;
    font-family: 'zapf-humanist-601';
    margin: 0px !important;
    margin-bottom: 10px !important;
}

.icon-img {
    background: #fff;
       width: 46px;
    max-width: 46px;
    border-radius: 100%;
    min-width: 46px;
}

.supplements-section__icon {
    width: 100%;
    padding: 10px;
}
.supplement_read_moree{
  display:none;
}
@media (max-width:767px){
  .supplement_read_moree{
    display:inline;
  }
  .supplements-section__item-title{
    margin-bottom: 6px !important;
  }
  .supplements-section__item-description{
    max-height:0;
    overflow:hidden;
  }
}
</style>

<script>
$(document).ready(function () {

    // Read More / Read Less functionality
    $(document).on("click",'.supplement_read_moree', function () {
        if(window.innerWidth < 767){
          var parent = $(this).closest('.icon-content');
          var content = $(parent).find(".supplements-section__item-description");

          // Collapse all other expanded sections
          $(".supplements-section__item-description").not(content).removeClass("supplements-expanded").css("max-height", "0px");
          $(".supplement_read_moree").not(this).text("Read More");

          // Toggle the clicked section
          if (content.hasClass("supplements-expanded")) {
              content.removeClass("supplements-expanded").css("max-height", "0px");
              $(this).text("Read More");
          } else {
              content.addClass("supplements-expanded").css("max-height", content[0].scrollHeight + "px");
              $(this).text("Read Less");
          }
        }
    });

});

</script>

