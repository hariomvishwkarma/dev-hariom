{% comment %}
  FAQs Section
  - Two-column accordion layout
  - Fully customizable via theme editor
{% endcomment %}

{%- capture faq_chevron_icon -%}
  <svg class="faq-icon__svg" width="19" height="11" viewBox="0 0 19 11" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
    <path fill-rule="evenodd" clip-rule="evenodd" d="M8.1918 10.4012L0.457418 2.66684C-0.152683 2.05674 -0.152683 1.06757 0.457418 0.457471C1.06752 -0.152631 2.05669 -0.152631 2.66679 0.45747L9.29648 7.08716L15.9262 0.457471C16.5363 -0.152631 17.5254 -0.152631 18.1355 0.457471C18.7456 1.06757 18.7456 2.05674 18.1355 2.66685L10.4012 10.4012C10.1082 10.6941 9.7108 10.8587 9.29648 10.8587C8.88217 10.8587 8.48481 10.6941 8.1918 10.4012Z" fill="currentColor"/>
  </svg>
{%- endcapture -%}

<section
  id="section-{{ section.id }}"
  class="faqs-section"
  style="
    --faq-bg: {{ section.settings.background_color }};
    --faq-card-bg: {{ section.settings.card_background_color }};
    --faq-card-border: {{ section.settings.card_border_color }};
    --faq-title-color: {{ section.settings.title_color }};
    --faq-question-color: {{ section.settings.question_color }};
    --faq-answer-color: {{ section.settings.answer_color }};
    --faq-icon-color: {{ section.settings.icon_color }};
    --faq-card-radius: {{ section.settings.card_radius }}px;
    --faq-card-padding: {{ section.settings.card_padding }}px;
    --faq-column-gap: {{ section.settings.column_gap }}px;
    --faq-row-gap: {{ section.settings.row_gap }}px;
    --faq-padding-top-mobile: {{ section.settings.padding_top_mobile }}px;
    --faq-padding-bottom-mobile: {{ section.settings.padding_bottom_mobile }}px;
    --faq-padding-top-desktop: {{ section.settings.padding_top }}px;
    --faq-padding-bottom-desktop: {{ section.settings.padding_bottom }}px;
  "
  data-accordion-enabled="{% if section.settings.enable_accordion %}true{% else %}false{% endif %}"
>
  <div class="faqs-container page-width">
    {% if section.settings.heading != blank %}
      <h2 class="faqs-heading">{{ section.settings.heading }}</h2>
    {% endif %}

    {% if section.settings.subheading != blank %}
      <p class="faqs-subheading">{{ section.settings.subheading }}</p>
    {% endif %}

    {% if section.blocks.size > 0 %}
      {% assign columns = section.settings.columns | plus: 0 %}
      {% if columns == 2 %}
        {% assign half = section.blocks.size | divided_by: 2.0 | ceil %}
      {% else %}
        {% assign half = section.blocks.size %}
      {% endif %}

      <div class="faqs-grid faqs-grid--{{ section.settings.columns }}">
        <div class="faqs-column">
          {% for block in section.blocks %}
            {% if forloop.index0 < half %}
              {%- liquid
                assign faq_is_open = false
                if section.settings.faq_default_state == 'all_open'
                  assign faq_is_open = true
                elsif section.settings.faq_default_state == 'first_open' and forloop.index0 == 0
                  assign faq_is_open = true
                elsif section.settings.faq_default_state == 'per_block' and block.settings.open_by_default
                  assign faq_is_open = true
                endif
                unless section.settings.enable_accordion
                  assign faq_is_open = true
                endunless
              -%}
              <details
                class="faq-item{% unless section.settings.enable_accordion %} faq-item--static{% endunless %}"
                {{ block.shopify_attributes }}
                {% if faq_is_open %}open{% endif %}
              >
                <summary class="faq-question">
                  <span class="faq-question-text">{{ block.settings.question }}</span>
                  <span class="faq-icon" aria-hidden="true">{{ faq_chevron_icon }}</span>
                </summary>
                <div class="faq-answer">
                  {{ block.settings.answer }}
                </div>
              </details>
            {% endif %}
          {% endfor %}
        </div>

        {% if columns == 2 %}
          <div class="faqs-column">
            {% for block in section.blocks %}
              {% if forloop.index0 >= half %}
                {%- liquid
                  assign faq_is_open = false
                  if section.settings.faq_default_state == 'all_open'
                    assign faq_is_open = true
                  elsif section.settings.faq_default_state == 'per_block' and block.settings.open_by_default
                    assign faq_is_open = true
                  endif
                  unless section.settings.enable_accordion
                    assign faq_is_open = true
                  endunless
                -%}
                <details
                  class="faq-item{% unless section.settings.enable_accordion %} faq-item--static{% endunless %}"
                  {{ block.shopify_attributes }}
                  {% if faq_is_open %}open{% endif %}
                >
                  <summary class="faq-question">
                    <span class="faq-question-text">{{ block.settings.question }}</span>
                    <span class="faq-icon" aria-hidden="true">{{ faq_chevron_icon }}</span>
                  </summary>
                  <div class="faq-answer">
                    {{ block.settings.answer }}
                  </div>
                </details>
              {% endif %}
            {% endfor %}
          </div>
        {% endif %}
      </div>
    {% else %}
      <p class="faqs-empty">Add FAQ blocks from the theme editor to get started.</p>
    {% endif %}
  </div>
</section>

<style>

  #section-{{ section.id }}.faqs-section {
    background-color: var(--faq-bg);
    padding-top: var(--faq-padding-top-mobile);
    padding-bottom: var(--faq-padding-bottom-mobile);
  }

  @media screen and (min-width: 990px) {
    #section-{{ section.id }}.faqs-section {
      padding-top: var(--faq-padding-top-desktop);
      padding-bottom: var(--faq-padding-bottom-desktop);
    }
  }

  #section-{{ section.id }} .faq-item--static .faq-question {
    cursor: default;
    pointer-events: none;
  }

  #section-{{ section.id }} .faq-item--static .faq-icon {
    display: none;
  }

  #section-{{ section.id }} .faq-item--static .faq-answer {
    height: auto !important;
    opacity: 1 !important;
    overflow: visible;
  }
  .faqs-container.page-width {
    max-width: 1237px;
    margin: 0 auto;
    padding-left: 20px;
    padding-right: 20px;
  }

  #section-{{ section.id }} .faqs-heading {
    margin: 0 0 25px;
    font-family: Optima, serif;
    font-weight: 700;
    font-style: normal;
    font-size: 28px;
    line-height: 100%;
    letter-spacing: 0;
    text-align: center;
    vertical-align: middle;
    text-transform: capitalize;
    color: var(--faq-title-color);
  }

  #section-{{ section.id }} .faqs-subheading {
    text-align: center;
    color: var(--faq-answer-color);
    margin: 0 auto 32px auto;
    max-width: 600px;
    font-size: 15px;
    line-height: 1.5;
  }

  #section-{{ section.id }} .faqs-grid {
    margin-top: 0;
    display: flex;
    gap: var(--faq-column-gap);
    align-items: flex-start;
  }

  #section-{{ section.id }} .faqs-column {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: var(--faq-row-gap);
    min-width: 0;
  }

  #section-{{ section.id }} .faqs-grid--1 {
    flex-direction: column;
  }

  @media screen and (min-width: 990px) {
    #section-{{ section.id }} .faqs-heading {
      font-size: 50px;
      margin-bottom: 40px;
    }
  }

  @media (max-width: 989px) {
    #section-{{ section.id }} .faqs-grid {
      flex-direction: column;
      gap: var(--faq-row-gap);
    }
  }

  #section-{{ section.id }} .faq-item {
    background-color: var(--faq-card-bg);
    border: none;
    border-radius: var(--faq-card-radius);
    padding: var(--faq-card-padding);
    transition: box-shadow 0.2s ease;
  }

  #section-{{ section.id }} .faq-item[open] {
    box-shadow: none;
  }

  #section-{{ section.id }} .faq-question {
    list-style: none;
    cursor: pointer;
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 12px;
    margin: 0;
    color: var(--faq-question-color);
    font-family: 'DM Sans', sans-serif;
    font-weight: 700;
    font-style: normal;
    font-size: 20px;
    line-height: 100%;
    letter-spacing: 0;
    vertical-align: middle;
    user-select: none;
  }
  .faq-answer a {
    color: var(--faq-answer-color);
  }

  #section-{{ section.id }} .faq-question::-webkit-details-marker {
    display: none;
  }

  #section-{{ section.id }} .faq-question-text {
    flex: 1;
    min-width: 0;
    font-family: inherit;
    font-weight: inherit;
    font-size: inherit;
    line-height: inherit;
    letter-spacing: inherit;
  }

  #section-{{ section.id }} .faq-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    color: var(--faq-icon-color);
    transition: transform 0.25s ease;
    flex-shrink: 0;
    margin-top: 4px;
  }

  #section-{{ section.id }} .faq-icon__svg {
    width: 12px;
    height: auto;
    display: block;
  }

  #section-{{ section.id }} .faq-item[open] .faq-icon {
    transform: rotate(180deg);
  }

  #section-{{ section.id }} .faq-answer {
    margin-top: 10px;
    color: var(--faq-answer-color);
    font-family: 'DM Sans', sans-serif;
    font-weight: 500;
    font-style: normal;
    font-size: 15px;
    line-height: 100%;
    letter-spacing: 0;
    text-align: justify;
    vertical-align: middle;
  }

  #section-{{ section.id }} .faq-answer p {
    margin: 0 0 8px;
    font-family: inherit;
    font-weight: inherit;
    font-size: inherit;
    line-height: inherit;
    letter-spacing: inherit;
    text-align: inherit;
    color: inherit;
  }

  #section-{{ section.id }} .faq-answer p:last-child {
    margin-bottom: 0;
  }

  #section-{{ section.id }} .faqs-empty {
    text-align: center;
    color: var(--faq-answer-color);
    padding: 40px 20px;
  }
  #section-{{ section.id }} .faq-answer {
    overflow: hidden;
    transition: height 0.35s ease, opacity 0.35s ease;
    opacity: 1;
  }
</style>
<script>
(function () {
  const section = document.getElementById('section-{{ section.id }}');
  if (!section) return;

  const accordionEnabled = section.dataset.accordionEnabled === 'true';
  if (!accordionEnabled) return;

  section.querySelectorAll('.faq-item').forEach(function (details) {
    const answer = details.querySelector('.faq-answer');
    const summary = details.querySelector('.faq-question');

    // Set initial height if open by default
    if (details.open) {
      answer.style.height = answer.scrollHeight + 'px';
      answer.style.opacity = '1';
    } else {
      answer.style.height = '0px';
      answer.style.opacity = '0';
    }

    summary.addEventListener('click', function (e) {
      e.preventDefault();

      if (!details.open) {
        // OPEN
        details.setAttribute('open', '');
        requestAnimationFrame(function () {
          answer.style.height = answer.scrollHeight + 'px';
          answer.style.opacity = '1';
        });
      } else {
        // CLOSE
        answer.style.height = answer.scrollHeight + 'px';
        requestAnimationFrame(function () {
          answer.style.height = '0px';
          answer.style.opacity = '0';
        });

        answer.addEventListener('transitionend', function handler() {
          details.removeAttribute('open');
          answer.removeEventListener('transitionend', handler);
        });
      }
    });
  });
})();
</script>
{% schema %}
{
  "name": "FAQs",
  "tag": "section",
  "class": "section-faqs",
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "FAQs"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading"
    },
    {
      "type": "header",
      "content": "FAQ behavior"
    },
    {
      "type": "checkbox",
      "id": "enable_accordion",
      "label": "Enable open / close accordion",
      "default": true
    },
    {
      "type": "select",
      "id": "faq_default_state",
      "label": "Default FAQ state",
      "info": "When accordion is enabled. “Per block” uses each item’s “Open by default” checkbox.",
      "options": [
        { "value": "all_closed", "label": "All closed" },
        { "value": "all_open", "label": "All open" },
        { "value": "first_open", "label": "First item open" },
        { "value": "per_block", "label": "Per block setting" }
      ],
      "default": "all_closed"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "columns",
      "label": "Columns (desktop)",
      "options": [
        { "value": "1", "label": "1 column" },
        { "value": "2", "label": "2 columns" }
      ],
      "default": "2"
    },
    {
      "type": "range",
      "id": "column_gap",
      "label": "Column gap (desktop)",
      "min": 8,
      "max": 64,
      "step": 2,
      "default": 40,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "row_gap",
      "label": "Row gap",
      "min": 8,
      "max": 48,
      "step": 2,
      "default": 20,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "card_padding",
      "label": "Card padding",
      "min": 8,
      "max": 40,
      "step": 2,
      "default": 20,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "card_radius",
      "label": "Card corner radius",
