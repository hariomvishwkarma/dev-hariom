<section
  class="about-us-section img-with-text-section"
  style="{% if section.settings.background_color != blank %}background-color: {{ section.settings.background_color }};{% endif %}"
>
  <div class="img-with-text__container">
    <h2 class="img-with-text__section-title">
      {{- section.settings.section_heading | default: 'About Us' | escape -}}
    </h2>

    <div class="img-with-text__row {% if section.settings.image_position == 'right' %}img-with-text__row--image-right{% endif %} {% if section.settings.mobile_image_position == 'top' %}img-with-text__row--mobile-image-top{% else %}img-with-text__row--mobile-image-bottom{% endif %}">
      <div
        class="about-image img-with-text__image {% if section.settings.image_ratio == 'square' %}img-with-text__image--square{% elsif section.settings.image_ratio == 'landscape' %}img-with-text__image--landscape{% elsif section.settings.image_ratio == 'portrait' %}img-with-text__image--portrait{% endif %}"
      >
        {% if section.settings.about_image != blank %}
          <img
            src="{{ section.settings.about_image | image_url: width: 800 }}"
            srcset="
              {{ section.settings.about_image | image_url: width: 400 }} 400w,
              {{ section.settings.about_image | image_url: width: 800 }} 800w,
              {{ section.settings.about_image | image_url: width: 1200 }} 1200w
            "
            sizes="(max-width: 768px) 100vw, 50vw"
            alt="{{ section.settings.about_title | default: section.settings.section_heading | escape }}"
            loading="lazy"
            width="{{ section.settings.about_image.width }}"
            height="{{ section.settings.about_image.height }}"
          >
        {% endif %}
      </div>

      <div class="about-content img-with-text__content">
        {% if section.blocks.size > 0 %}
          <div class="icons">
            {% for block in section.blocks %}
              {% if block.settings.icon_image != blank %}
                <div class="icon-block" {{ block.shopify_attributes }}>
                  <img
                    src="{{ block.settings.icon_image | image_url: width: 200 }}"
                    alt="{{ block.settings.icon_text | escape }}"
                    loading="lazy"
                    width="50"
                    height="50"
                  >
                  {% if block.settings.icon_text != blank %}
                    <p>{{ block.settings.icon_text }}</p>
                  {% endif %}
                </div>
              {% endif %}
            {% endfor %}
          </div>
        {% endif %}

        {% if section.settings.about_title != blank %}
          <h3 class="img-with-text__title">{{ section.settings.about_title | escape }}</h3>
        {% endif %}

        {% if section.settings.about_description != blank %}
          <div class="img-with-text__description-wrapper{% if section.settings.enable_mobile_read_more %} img-with-text__description-wrapper--mobile-read-more{% endif %}">
            <div class="img-with-text__description">{{ section.settings.about_description }}</div>
            {% if section.settings.enable_mobile_read_more %}
              <button
                type="button"
                class="img-with-text__read-more-toggle"
                aria-expanded="false"
              >
                {{ section.settings.read_more_label | escape }}
              </button>
            {% endif %}
          </div>
        {% endif %}

        {% if section.settings.button_text != blank and section.settings.button_link != blank %}
          <a href="{{ section.settings.button_link }}" class="button img-with-text__button">{{ section.settings.button_text | escape }}</a>
        {% endif %}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Image with Text Section",
  "settings": [
    {
      "type": "text",
      "id": "section_heading",
      "label": "Section heading",
      "default": "About Us"
    },
    {
      "type": "text",
      "id": "about_title",
      "label": "Heading",
      "default": "Our story"
    },
    {
      "type": "richtext",
      "id": "about_description",
      "label": "Description",
      "default": "<p>The   journey began when a group of health enthusiasts, scientists, engineers, and doctors came together with a shared goal — to cure the world.</p>"
    },
    {
      "type": "image_picker",
      "id": "about_image",
      "label": "Image"
    },
    {
      "type": "select",
      "id": "image_position",
      "label": "Image position",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "right", "label": "Right" }
      ],
      "default": "left"
    },
    {
      "type": "range",
      "id": "image_border_radius",
      "label": "Image border radius",
      "min": 0,
      "max": 60,
      "step": 1,
      "unit": "px",
      "default": 10
    },
    {
      "type": "select",
      "id": "image_ratio",
      "label": "Image ratio",
      "options": [
        { "value": "natural", "label": "Natural (default)" },
        { "value": "landscape", "label": "Landscape (4:3)" },
        { "value": "square", "label": "Square (1:1)" },
        { "value": "portrait", "label": "Portrait (3:4)" }
      ],
      "default": "natural"
    },
    {
      "type": "select",
      "id": "mobile_image_position",
      "label": "Mobile image position",
      "options": [
        { "value": "top", "label": "Top" },
        { "value": "bottom", "label": "Bottom" }
      ],
      "default": "top"
    },
    {
      "type": "checkbox",
      "id": "enable_mobile_read_more",
      "label": "Enable mobile read more",
      "default": false
    },
    {
      "type": "text",
      "id": "read_more_label",
      "label": "Read more label",
      "default": "Read more"
    },
    {
      "type": "text",
      "id": "read_less_label",
      "label": "Read less label",
      "default": "Read less"
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button label",
      "default": "Know more"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button URL"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "default": "#fdf6cc"
    }
  ],
  "blocks": [
    {
      "type": "icon_block",
      "name": "Icon block",
      "settings": [
        {
          "type": "image_picker",
          "id": "icon_image",
          "label": "Icon image"
        },
        {
          "type": "text",
          "id": "icon_text",
          "label": "Icon text"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Img with Text Section"
    }
  ]
}
{% endschema %}

<style>
  .about-us-section.img-with-text-section {
    display: block;
    padding: 30px 10px 40px 40px;
  }

  .img-with-text-section .img-with-text__container {
    display: flex;
    flex-direction: column;
    align-items: stretch;
    max-width: 1270px;
    padding: 0 50px;
    margin: 0 auto;
    gap: 0px;
  }

  .img-with-text-section .img-with-text__section-title {
    margin: 0 0 40px;
    text-align: center;
    font-size: 50px;
    line-height: 1.15;
    font-weight: bold;
    font-family: Optima, 'Optima Nova', 'Optima LT Pro', Candara, sans-serif;
    color: #000;
  }

  .img-with-text-section .img-with-text__row {
    display: flex;
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    gap: 40px;
  }

  .img-with-text-section .img-with-text__image {
    width: 50%;
    flex: 0 0 50%;
    order: 0;
  }

  .img-with-text-section .img-with-text__content {
    width: 50%;
    flex: 0 0 50%;
    order: 1;
    text-align: left;
  }

  .img-with-text-section .img-with-text__image img {
    display: block;
    width: 100%;
    max-width: 100%;
    height: auto;
    border-radius: {{ section.settings.image_border_radius }}px;
  }

  .img-with-text-section .img-with-text__row.img-with-text__row--image-right .img-with-text__image {
    order: 1;
  }

  .img-with-text-section .img-with-text__row.img-with-text__row--image-right .img-with-text__content {
    order: 0;
  }

  .img-with-text-section .img-with-text__image--square img {
    aspect-ratio: 1 / 1;
    object-fit: cover;
    height: 100%;
  }

  .img-with-text-section .img-with-text__image--landscape img {
    aspect-ratio: 4 / 3;
    object-fit: cover;
    height: 100%;
  }

  .img-with-text-section .img-with-text__image--portrait img {
    aspect-ratio: 3 / 4;
    object-fit: cover;
    height: 100%;
  }

  .img-with-text-section .icons {
    display: flex;
    gap: 20px;
    margin-bottom: 20px;
    flex-wrap: wrap;
  }

  .img-with-text-section .icon-block {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    max-width: 150px;
  }

  .img-with-text-section .icon-block p {
    font-size: 14px;
    margin-top: 12px;
    margin-bottom: 0;
    color: #000;
  }

  .img-with-text-section .img-with-text__title {
    font-size: 40px;
    line-height: 1.15;
    margin: 0 0 12px;
    font-weight: 700;
    color: #000;
    font-family: 'DM Sans';
  }

  .img-with-text-section .img-with-text__description {
    font-size: 20px;
    margin-bottom: 20px;
    line-height: 1.5;
    color: #000;
    font-family: 'DM Sans';
    -webkit-text-stroke: .3px;
    text-align: justify;
  }

  .img-with-text-section .img-with-text__description-wrapper {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }

  .img-with-text-section .img-with-text__read-more-toggle {
    display: none;
    margin-top: 10px;
    padding: 0;
    border: 0;
    background: transparent;
    font-family: 'DM Sans', sans-serif;
    font-size: 14px;
    font-weight: 700;
    color: #12723B;
    cursor: pointer;
  }

  .img-with-text-section .button.img-with-text__button {
    font-size: 20px;
    font-weight: bold;
    display: inline-block;
    background-color: #12723B;
    color: #fff;
    padding: 15px !important;
    text-decoration: none;
    border-radius: 10px;
    width: fit-content;
    text-transform: capitalize;
  }

  .img-with-text-section .icon-block img {
    width: 50px;
    max-width: 50px;
    height: 50px;
    object-fit: cover;
  }

  @media (max-width: 768px) {
    .template-page .img-with-text-section .img-with-text__image img {
      border-radius: 15px;
    }
    .template-page .img-with-text__description p {
        margin-top: 0;
    }
    .img-with-text-section .img-with-text__container { 
      padding: 0;
    }
    .about-us-section.img-with-text-section {
      padding: 40px 16px;
    }

    .img-with-text-section .img-with-text__section-title {
      font-family: Optima, serif;
      font-size: 28px;
      margin-bottom: px;
      text-align: center;
    }

    .img-with-text-section .img-with-text__row {
      flex-direction: column;
      gap: 24px;
      align-items: stretch;
    }

    .img-with-text-section .img-with-text__row.img-with-text__row--mobile-image-top .img-with-text__image {
      order: -1;
      width: 100%;
      flex: 1 1 auto;
    }

    .img-with-text-section .img-with-text__row.img-with-text__row--mobile-image-top .img-with-text__content {
      order: 0;
    }

    .img-with-text-section .img-with-text__row.img-with-text__row--mobile-image-bottom .img-with-text__content {
      order: 0;
    }

    .img-with-text-section .img-with-text__row.img-with-text__row--mobile-image-bottom .img-with-text__image {
      order: 1;
      width: 100%;
      flex: 1 1 auto;
    }

    .img-with-text-section .img-with-text__content {
      width: 100%;
      flex: 1 1 auto;
    }

    .img-with-text-section .img-with-text__title {
      font-size: 25px;
    }

    .img-with-text-section .icons {
      justify-content: center;
    }

    .img-with-text-section .img-with-text__description {
      font-size: 15px;
      margin-bottom: 0;
    }

    .template-page .img-with-text-section .img-with-text__description {
      font-size: 20px;
    }

    .img-with-text-section .img-with-text__description-wrapper--mobile-read-more .img-with-text__description {
      display: -webkit-box;
      -webkit-box-orient: vertical;
      -webkit-line-clamp: 4;
      line-clamp: 4;
      overflow: hidden;
    }

    .img-with-text-section .img-with-text__description-wrapper--mobile-read-more.is-expanded .img-with-text__description {
      -webkit-line-clamp: unset;
      line-clamp: unset;
      overflow: visible;
      display: block;
    }

    .img-with-text-section .img-with-text__description-wrapper--mobile-read-more .img-with-text__read-more-toggle {
      display: inline-flex;
      align-items: center;
      margin: 0;
      font-size: 20px;
    }
  }
</style>

<script>
  document.addEventListener('DOMContentLoaded', function () {
    var wrappers = document.querySelectorAll('#shopify-section-{{ section.id }} .img-with-text__description-wrapper--mobile-read-more');
    if (!wrappers.length) return;

    wrappers.forEach(function (wrapper) {
      var description = wrapper.querySelector('.img-with-text__description');
      var toggleButton = wrapper.querySelector('.img-with-text__read-more-toggle');
      if (!description || !toggleButton) return;

      var readMoreLabel = {{ section.settings.read_more_label | json }};
      var readLessLabel = {{ section.settings.read_less_label | json }};
      var mediaQuery = window.matchMedia('(max-width: 768px)');

      function collapse() {
        wrapper.classList.remove('is-expanded');
        toggleButton.setAttribute('aria-expanded', 'false');
        toggleButton.textContent = readMoreLabel;
      }

      function updateToggleVisibility() {
        if (!mediaQuery.matches) {
          collapse();
          toggleButton.hidden = true;
          return;
        }

        collapse();
        requestAnimationFrame(function () {
          var shouldShowToggle = description.scrollHeight > description.clientHeight + 1;
          toggleButton.hidden = !shouldShowToggle;
        });
      }

      toggleButton.addEventListener('click', function () {
        var isExpanded = wrapper.classList.toggle('is-expanded');
        toggleButton.setAttribute('aria-expanded', isExpanded ? 'true' : 'false');
        toggleButton.textContent = isExpanded ? readLessLabel : readMoreLabel;
      });

      updateToggleVisibility();
      window.addEventListener('resize', updateToggleVisibility);

      if (mediaQuery.addEventListener) {
        mediaQuery.addEventListener('change', updateToggleVisibility);
      } else if (mediaQuery.addListener) {
        mediaQuery.addListener(updateToggleVisibility);
      }
    });
  });
</script>
