<style>
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.50 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.50 | round: 0 }}px;
  }
  .product-card-layout-02 .tabs_wrapper .card {
    border: none !important;
    box-shadow: none !important;
  }
  .tabs_wrapper .card__heading .card-title.link-underline.card-title-ellipsis {
    font-size: 20px;
    font-family: Optima;
    color: #12723B;
    font-weight: 700;
  }
  .tabs_wrapper .tab-content {
    background: transparent;
  }
  .tabs_heading {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 12px;
    margin-bottom: 40px;
    align-items: center;
    width: 100%;
    justify-content: center;
  }
  .tabs_heading .tab_heading {
    display: inline-block;
    margin: 0;
    font-size: 50px;
    line-height: 1.2;
    font-family: Optima;
    font-weight: 700;
    color: #000;
    text-align: center;
  }
  .tabs_heading .tab_heading span {
    font-family: Optima;
    font-weight: 700;
  }
  .tabs_heading .tab_subheading {
    display: block;
    margin: 0;
    font-size: 18px;
    line-height: 1.5;
    font-family: Optima;
    font-weight: 400;
    color: #555;
    text-align: center;
    max-width: 800px;
  }
  .tabs_wrapper .tab-content .button.button-ATC {
    margin-top: 0 !important;
    position: relative;
  }
  .custom-slick-arrows {
    display: flex;
    position: absolute;
    justify-content: flex-start;
    top: 0;
    right: 15px;
    gap: 10px;
  }
  .tabs.product-tab-block {
    position: relative;
  }
  .custom-slick-arrows .slick-arrow {
    position: relative;
    top: unset !important;
    transform: unset !important;
    background: #52543c;
  }
  .tabs_wrapper .card-media > img {
    border-radius: 10px !important;
  }
  .tabs_wrapper .card-product:hover .card-media.media--hover-effect > img + img {
    opacity: 1;
    transform: scale(1);
  }
  .tabs_wrapper .halo-row.column-4 .halo-item {
    padding: 0 8px;
  }
  .tabs_wrapper .halo-row.column-4 .halo-item .card-information {
    padding: 15px 0 0;
  }
  .tabs_wrapper .card:hover {
    box-shadow: unset;
  }
  .tabs_wrapper .halo-row {
    margin-left: -8px;
    margin-right: -8px;
  }
  .tabs_wrapper .add_single_content.product__card_metaa {
    margin-bottom: 4px;
    font-size: 14px !important;
  }
  .tabs_wrapper .card-title:hover {
    text-decoration: none;
  }
  .custom-slick-arrows .slick-arrow svg {
    height: 13px;
    width: 13px;
  }
  .custom-slick-scrollbar {
    display: none;
  }
  .price_action {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }
  .price_action .card-action {
    width: auto;
  }
  .price_action a.mm.button.button-ATC {
    max-width: unset;
    min-width: fit-content;
    font-size: 18px !important;
    width: fit-content;
    font-weight: 400;
    margin-left: auto;
    margin-right: unset;
    position: unset !important;
  }
  .price_action .button.button-ATC {
    width: auto !important;
    padding: 6px 16px;
    max-width: fit-content !important;
    display: inline-block;
    min-width: fit-content !important;
    min-height: auto !important;
    height: auto !important;
    line-height: unset !important;
    text-transform: capitalize !important;
    font-weight: 400;
    font-size: 18px;
  }
  .price_action .card-price {
    margin: 0;
  }
  .tabs_wrapper .tab-content .card-information__wrapper.text-left {
    min-height: auto;
  }
  .featured-collection-arrows {
    position: relative;
  }
  .featured-collection-arrows .custom-slick-arrows {
    position: absolute;
    left: 0;
    right: 0;
    top: 40%;
    transform: translateY(-50%);
    pointer-events: none;
    z-index: 3;
    display: flex;
  }
  .featured-collection-arrows .custom-slick-arrows .slick-prev-custom,
  .featured-collection-arrows .custom-slick-arrows .slick-next-custom {
    pointer-events: auto;
    position: absolute;
    top: 40%;
    transform: translateY(-50%);
    width: 50px;
    height: 50px;
    border-radius: 50%;
    border: 1px solid #0000001A;
    background: #ffffff;
    box-shadow: 0px 0px 11.9px 0px #12723B4D;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0;
    margin: 0;
    line-height: 1;
  }
  .featured-collection-arrows .custom-slick-arrows .slick-prev-custom {
    left: -30px;
  }
  .featured-collection-arrows .custom-slick-arrows .slick-next-custom {
    right: -30px;
  }
  .featured-collection-arrows .custom-slick-arrows .slick-prev-custom svg,
  .featured-collection-arrows .custom-slick-arrows .slick-next-custom svg {
    width: 14px;
    height: 14px;
  }
  .featured-collection-arrows .custom-slick-arrows .slick-prev-custom.slick-disabled,
  .featured-collection-arrows .custom-slick-arrows .slick-next-custom.slick-disabled {
    opacity: 0.5;
    cursor: not-allowed;
  }

  @media screen and (min-width: 990px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
  @media screen and (max-width: 1199px) {
    .tabs_heading .tab_heading {
      position: relative;
      top: unset;
      transform: unset;
      display: block;
      text-align: center;
      margin-bottom: 0;
    }
  }
  @media screen and (max-width: 767px) {
    .featured-collection-arrows {
      overflow: hidden;
      margin-right: -15px;
    }
    .featured-collection-arrows .halo-row .slick-list {
      padding-right: 15%;
    }
    .featured-collection-arrows .custom-slick-arrows {
      top: 50%;
      margin-right: 12px;
      justify-content: right;
      margin-top: 14px;
    }
    .tabs_heading .tab_heading {
      margin: 0;
    }
    .tabs_heading {
      width: 100%;
      margin-bottom: 30px;
    }
    .tabs_heading .tab_heading span {
      font-size: 28px;
      letter-spacing: normal;
    }
    .tabs_heading .tab_subheading {
      font-size: 15px;
      padding: 0 10px;
    }
    .container-1170 {
      padding-left: 12px !important;
      padding-right: 12px !important;
    }
    .tabs_wrapper .halo-row.column-4 .halo-item {
      padding: 0 4px;
    }
    .featured-collection-arrows .custom-slick-arrows .slick-prev-custom {
      left: 7px;
    }
    .featured-collection-arrows .custom-slick-arrows .slick-next-custom {
      right: 7px;
    }
  }
  @media screen and (max-width: 500px) {
    .tabs_heading .tab_heading {
      text-align: center;
    }
    .custom-slick-arrows .slick-arrow {
      height: 30px;
      width: 30px;
    }
  }
</style>

<div class="tabs_wrapper section-{{ section.id }}-padding">
  <div class="tabs product-tab-block container-1320">

    <div class="tabs_heading">
      {%- if section.settings.heading != blank -%}
        <h3 class="tab_heading">
          <span>{{ section.settings.heading }}</span>
        </h3>
      {%- endif -%}
      {%- if section.settings.subheading != blank -%}
        <p class="tab_subheading">{{ section.settings.subheading }}</p>
      {%- endif -%}
    </div>

    {% assign col = collections[section.settings.collection] %}

    <div class="featured-collection-arrows">
      <div class="tab-products-carousel halo-row column-4">
        {% for product in col.products limit: section.settings.products_limit %}
          <div class="product halo-item">
            {% render 'MS-product-card',
              product_card_product: product,
              media_size: 'square',
              portrait_aspect_ratio: '282'
            %}
          </div>
        {% endfor %}
      </div>

      <div class="custom-slick-arrows">
        <div class="custom-slick-scrollbar">
          <div class="custom-scrollbar-track">
            <div class="custom-scrollbar-thumb"></div>
          </div>
        </div>
        <button class="slick-prev-custom">
          <svg width="11" height="19" viewBox="0 0 11 19" fill="none" xmlns="http://www.w3.org/2000/svg">
            <path fill-rule="evenodd" clip-rule="evenodd" d="M0.457422 10.4012L8.1918 18.1356C8.8019 18.7457 9.79107 18.7457 10.4012 18.1356C11.0113 17.5255 11.0113 16.5363 10.4012 15.9262L3.77148 9.29653L10.4012 2.66685C11.0113 2.05674 11.0113 1.06757 10.4012 0.457471C9.79107 -0.152631 8.8019 -0.152631 8.1918 0.457471L0.457422 8.19185C0.164499 8.48486 -5.62668e-05 8.88221 -5.62668e-05 9.29653C-5.62668e-05 9.71085 0.164499 10.1082 0.457422 10.4012Z" fill="black"/>
          </svg>
        </button>
        <button class="slick-next-custom">
          <svg width="11" height="19" viewBox="0 0 11 19" fill="none" xmlns="http://www.w3.org/2000/svg">
            <path fill-rule="evenodd" clip-rule="evenodd" d="M10.4015 10.4012L2.66709 18.1356C2.05699 18.7457 1.06782 18.7457 0.457715 18.1356C-0.152387 17.5255 -0.152387 16.5363 0.457715 15.9262L7.0874 9.29653L0.457715 2.66685C-0.152386 2.05674 -0.152387 1.06757 0.457715 0.457471C1.06782 -0.152631 2.05699 -0.152631 2.66709 0.457471L10.4015 8.19185C10.6944 8.48486 10.8589 8.88221 10.8589 9.29653C10.8589 9.71085 10.6944 10.1082 10.4015 10.4012Z" fill="black"/>
          </svg>
        </button>
      </div>
    </div>

  </div>
</div>

<script>
  $(document).ready(function () {
    var $slider = $('.section-{{ section.id }}-padding .tab-products-carousel');
    var $prevArrow = $('.section-{{ section.id }}-padding .slick-prev-custom');
    var $nextArrow = $('.section-{{ section.id }}-padding .slick-next-custom');

    $slider.slick({
      slidesToShow: 4,
      slidesToScroll: 4,
      infinite: true,
      autoplay: false,
      autoplaySpeed: 3000,
      dots: false,
      arrows: true,
      prevArrow: $prevArrow,
      nextArrow: $nextArrow,
      responsive: [
        {
          breakpoint: 1024,
          settings: {
            slidesToShow: 3,
            slidesToScroll: 3,
          },
        },
        {
          breakpoint: 768,
          settings: {
            slidesToShow: 2,
            slidesToScroll: 2,
          },
        },
        {
          breakpoint: 500,
          settings: {
            slidesToShow: 1,
            slidesToScroll: 1,
          },
        },
      ],
    });
  });
</script>

{% schema %}
{
  "name": "Featured Collection",
  "settings": [
    {
      "id": "heading",
      "type": "text",
      "label": "Heading",
      "default": "Featured Products"
    },
    {
      "id": "subheading",
      "type": "textarea",
      "label": "Subheading",
      "default": "Discover our handpicked selection of products"
    },
    {
      "id": "collection",
      "type": "collection",
      "label": "Collection"
    },
    {
      "id": "products_limit",
      "type": "range",
      "min": 4,
      "max": 30,
      "step": 2,
      "label": "Max Products to Show",
      "default": 12
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "label": "Top Padding",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "label": "Bottom Padding",
      "default": 40
    }
  ],
  "presets": [
    {
      "name": "Featured Collection"
    }
  ]
}
{% endschema %}