

<div class="main-review-container">
  <div class="swiper-container1">
    <div class="swiper-wrapper1">
      {% for block in section.blocks %}
        <div class="swiper-slide1 reviw-img">
          {% if block.settings.reviewimage %}
            <img src="{{ block.settings.reviewimage | img_url: 'small' }}" alt="Review Image">
            <h2>{{ block.settings.review_heading }}</h2>
            <p>{{ block.settings.review_content }}</p>
          {% endif %}
        </div>
      {% endfor %}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Review Section",
  "settings": [],
  "blocks": [
    {
      "type": "image_text",
      "name": "Review with image",
      "settings": [
        {
          "type": "image_picker",
          "id": "reviewimage",
          "label": "Review Image"
        },
        {
          "type": "text",
          "id": "review_heading",
          "label": "Review Heading"
        },
        {
          "type": "textarea",
          "id": "review_content",
          "label": "Review Content"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Review Section"
    }
  ]
}
{% endschema %}

<style>
            .main-review-container {
              width: 100%;
              max-width: 1060px;
              margin: 0 auto;
            }

            .swiper-container {
              width: 100%;
              padding-top: 60px;
            }

            .swiper-wrapper {
              display: flex;
              gap: 50px;
            }

            .swiper-slide {
              display: flex;
              flex-direction: column;
              align-items: center;
              text-align: center;
            }

            .reviw-img {
              width: 100%;
              max-width: 171px;
            }

            .reviw-img img {
              width: 100%;
            }

            .reviw-img h2 {
              font-size: 25px;
              margin: 0px;
              font-weight: 400;
              font-family: 'Manrope-Regular', sans-serif;
              line-height: 29px;
              letter-spacing: 4px;
            }

            .reviw-img p {
              font-weight: 400;
              font-size: 12px;
              font-family: 'Manrope-Regular', sans-serif;
              line-height: 17px;
              color: #285233;
            }

            @media (max-width: 768px) {
              .swiper-container {
                overflow: hidden;
              }

              .swiper-slide {
                display: flex;
                flex-direction: column;
                align-items: center;
              }

              .swiper-wrapper {
                justify-content: flex-start;
                gap: 10px;
                margin-left: 50px;
              }

              .reviw-img h2 {
                font-size: 20px;
                margin: 10px 0;
                letter-spacing: 2px;
              }
              .reviw-img img {
              width: 100%;
              max-width: 130px;
          }
        .swiper-container.swiper-initialized.swiper-horizontal.swiper-backface-hidden {
            position: relative;
        }
      div:empty {
          display: block !important;
      }
              .swiper-button-next, .swiper-button-prev{
                width:2px !important;
                color:#285233; !important;
              }
            .swiper-button-next:after, .swiper-rtl .swiper-button-prev:after {
                content: 'next';
                font-size: 15px;
                font-weight: bold;
                color:#285233;
    }
  .swiper-button-prev:after {
    display:none !important;
  }
            }
</style>

<script>
  document.addEventListener("DOMContentLoaded", function () {
    let swiperInstance;

    function initializeSwiper() {
      // Destroy any existing Swiper instance before reinitializing
      if (swiperInstance) {
        swiperInstance.destroy(true, true);
        swiperInstance = null;
      }

      swiperInstance = new Swiper('.swiper-container', {
        slidesPerView: window.innerWidth <= 768 ? 1 : 'auto',
        spaceBetween: 10,
        loop: false, // Ensure the slider doesn't loop
        navigation: {
          nextEl: '.swiper-button-next',
          prevEl: '.swiper-button-prev',
        },
        on: {
          reachEnd: function () {
            // Disable the next button when the last slide is reached
            document.querySelector('.swiper-button-next').classList.add('swiper-button-disabled');
          },
          slideChange: function () {
            // Re-enable next button if not on the last slide
            const isEnd = swiperInstance.isEnd;
            const nextButton = document.querySelector('.swiper-button-next');
            if (isEnd) {
              nextButton.classList.add('swiper-button-disabled');
            } else {
              nextButton.classList.remove('swiper-button-disabled');
            }
          },
        },
      });
    }

    // Initialize Swiper on page load
    initializeSwiper();

    // Reinitialize Swiper on window resize
    window.addEventListener('resize', initializeSwiper);
  });
</script>
