{% if section.settings.show_banner_img %}
<div class="image_banner__sectionn">
{% if section.settings.banner_img != blank %}
<img src="{{ section.settings.banner_img | img_url: 'master' }}" class="show_desktop">
{% else %}
<img src="{{ collection.featured_image | img_url: 'master' }}" class="show_desktop">
{% endif %}

{% if section.settings.banner_img_mobile != blank %}
<img src="{{ section.settings.banner_img_mobile | img_url: 'master' }}" class="show_mobile">
{% else %}
<img src="{{ collection.featured_image | img_url: 'master' }}" class="show_mobile">
{% endif %}
</div>
{% else %}
{% unless collection.handle == 'all' %}
<div class="container">
<h2>{{ collection.title }}</h2>
<div>{{ collection.description }}</div>
</div>
{% endunless %}
{% endif %}

{% if collection.handle == 'all' %}
<div class="container collection_all1">
<h2>{{ collection.title }}</h2>
<div>{{ collection.description }}</div>
</div>
{% endif %}

{% schema %}
  {
    "name": "Image Banner Section",
    "settings": [
{
      "type": "checkbox",
      "id": "show_banner_img",
      "label": "Show Banner Image" 
 },
 {
      "type": "image_picker",
      "id": "banner_img",
      "label": "Image" 
 },
 {
      "type": "image_picker",
      "id": "banner_img_mobile",
      "label": "Image"
    }
],
  "presets": [
    {
      "name": "Image Banner Section"
    }
  ]
  }
{% endschema %}

<style>
@media (min-width: 768px){
.show_mobile{ display: none !important;}
}

@media (max-width: 767px){
.show_desktop{ display: none !important;}

}

.collection_all .image_banner__sectionn { display: none;}
</style>