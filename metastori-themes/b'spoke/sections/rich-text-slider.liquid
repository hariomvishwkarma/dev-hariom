            <div class="rich-text-section container" id="rich_blockk">
            
            <div class="rich-text__blocks text-center ">
            {% for block in section.blocks %}
            <div class="rich-text-block text-center"  style="margin: 30px auto; width: 100%; min-width: 100%; padding: 0px 20px;">
            <p style="color:#000; margin-bottom: 10px; margin-top: 10px; font-size: 16px;">{{ block.settings.concern_subtitle11 }}</p>
            <h2 style="color:#000; margin-bottom: 10px; margin-top: 0px; font-size: 22px; font-weight: bold;">{{ block.settings.concern_title }}</h2>
            <p style="color:#000; margin-bottom: 10px; margin-top: 10px; font-size: 16px;">{{ block.settings.concern_subtitle }}</p>
            {% if block.settings.imgpick != blank %}<img style="display: block; max-width: 150px;  width: 100%; object-fit: cover; margin: 20px auto;" src="{{ block.settings.imgpick | img_url: 'imgpick' }}" alt="Image 1">{% endif %}
            </div>
            {% endfor %}
            </div>


</div>


{% schema %}
  {
    "name": "Rich Text Block",
    "settings": [],
 "blocks": [
    {
      "type": "block",
      "name": "Block Item",
      "settings": [
          {
          "type": "text",
          "id": "concern_subtitle11",
          "label": "Subtitle",
          "default": "Fatty liver often precedes diabetes and metabolic disorders."
          },
          {
          "type": "text",
          "id": "concern_title",
          "label": "Title",
          "default": "EVERY THIRD INDIAN HAS A FATTY LIVER."
          },
          {
          "type": "text",
          "id": "concern_subtitle",
          "label": "Content",
          "default": "B'spoke offers a combination of science-backed natural supplements along with healthy snacking options to tackle the rising issue of fatty liver."
          },
          
          {
          "type": "image_picker",
          "id": "imgpick",
          "label": "Image"
          }
      ]
    }
  ],
  "presets": [
    {
      "name": "Rich Text Block"
    }
  ]
  }
{% endschema %}

<style>
@media (max-width: 767px){
.rich-text__blocks.text-center {
    display: flex;
    width: 100%;
    max-width: 100%;
    overflow-x: auto;
    min-width: 90%;
    margin: auto;
}
}
@media (min-width: 768px){
.rich-text__blocks.text-center {
    display: flex;
    width: 100%;
    max-width: 720px;
    overflow-x: auto;
    min-width: 720px;
    margin: auto;
}
}
</style>