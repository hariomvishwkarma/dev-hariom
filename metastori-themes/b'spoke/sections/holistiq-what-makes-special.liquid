<section
  class="holistiq-special section-{{ section.id }}-padding"
  id="holistiq-special-{{ section.id }}"
  style="background: {{ section.settings.section_background }};"
>
  <div class="holistiq-special__container">
    {% if section.settings.heading != blank %}
      <h2 class="holistiq-special__heading">{{ section.settings.heading }}</h2>
    {% endif %}

    <div class="holistiq-special__layout">
      <div class="holistiq-special__media">
        {%- liquid
          assign desktop_image = section.settings.main_image | default: section.settings.main_image_mobile
          assign mobile_image = section.settings.main_image_mobile | default: section.settings.main_image
          assign image_alt = desktop_image.alt | default: mobile_image.alt | default: section.settings.heading | escape
        -%}
        {% if desktop_image != blank %}
          {{
            desktop_image
            | image_url: width: 1200
            | image_tag:
              class: 'holistiq-special__image holistiq-special__image--desktop',
              loading: 'lazy',
              widths: '400, 600, 800, 1000, 1200',
              sizes: '(min-width: 990px) 41vw, 100vw',
              alt: image_alt
          }}
        {% endif %}
        {% if mobile_image != blank %}
          {{
            mobile_image
            | image_url: width: 800
            | image_tag:
              class: 'holistiq-special__image holistiq-special__image--mobile',
              loading: 'lazy',
              widths: '375, 550, 750, 800',
              sizes: '100vw',
              alt: image_alt
          }}
        {% elsif desktop_image == blank %}
          {{ 'image' | placeholder_svg_tag: 'holistiq-special__image holistiq-special__image--placeholder' }}
        {% endif %}
      </div>

      <div class="holistiq-special__blocks">
        {%- assign icon_sizes_attr = section.settings.icon_size | append: 'px' -%}
        {% for block in section.blocks %}
          <article class="holistiq-special__block" {{ block.shopify_attributes }}>
            {% if block.settings.icon != blank %}
              <div class="holistiq-special__icon-wrap">
                {{
                  block.settings.icon
                  | image_url: width: 110
                  | image_tag:
                    class: 'holistiq-special__icon',
                    loading: 'lazy',
                    widths: '55, 110',
                    sizes: icon_sizes_attr,
                    alt: block.settings.title
                  | escape
                }}
              </div>
            {% endif %}

            {% if block.settings.title != blank %}
              <h3 class="holistiq-special__block-title">{{ block.settings.title | escape }}</h3>
            {% endif %}

            {% if block.settings.text != blank %}
              <div class="holistiq-special__block-text rte">{{ block.settings.text }}</div>
            {% endif %}
          </article>
        {% endfor %}
      </div>
    </div>
  </div>
</section>

{% style %}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top_mobile }}px;
    padding-bottom: {{ section.settings.padding_bottom_mobile }}px;
  }

  @media screen and (min-width: 990px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top_desktop }}px;
      padding-bottom: {{ section.settings.padding_bottom_desktop }}px;
    }
  }

  #holistiq-special-{{ section.id }} .holistiq-special__container {
    max-width: 1277px;
    margin: 0 auto;
    padding-left: 10px;
    padding-right: 10px;
  }

  #holistiq-special-{{ section.id }} .holistiq-special__heading {
    margin: 0 0 40px;
    font-family: Optima, serif;
    font-weight: 700;
    font-style: normal;
    font-size: 50px;
    line-height: 100%;
    letter-spacing: 0;
    text-align: center;
    vertical-align: middle;
    text-transform: capitalize;
    color: {{ section.settings.heading_color }};
  }

  #holistiq-special-{{ section.id }} .holistiq-special__layout {
    display: flex;
    flex-direction: column;
    gap: 24px;
  }

  #holistiq-special-{{ section.id }} .holistiq-special__media {
    width: 100%;
    border-radius: {{ section.settings.image_radius }}px;
    overflow: hidden;
  }

  #holistiq-special-{{ section.id }} .holistiq-special__image {
    width: 100%;
    height: auto;
    display: block;
    object-fit: cover;
    object-position: center;
  }

  #holistiq-special-{{ section.id }} .holistiq-special__image--desktop {
    display: none;
  }

  #holistiq-special-{{ section.id }} .holistiq-special__image--mobile {
    display: block;
  }

  #holistiq-special-{{ section.id }} .holistiq-special__image--placeholder {
    background: #f0ebe4;
    min-height: 280px;
  }

  #holistiq-special-{{ section.id }} .holistiq-special__blocks {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    column-gap: {{ section.settings.mobile_column_gap }}px;
    row-gap: {{ section.settings.mobile_row_gap }}px;
    width: 100%;
  }

  #holistiq-special-{{ section.id }} .holistiq-special__block {
    padding: {{ section.settings.mobile_block_padding }}px;
  }

  #holistiq-special-{{ section.id }} .holistiq-special__icon-wrap {
    margin-bottom: 16px;
  }

  #holistiq-special-{{ section.id }} .holistiq-special__icon {
    width: {{ section.settings.icon_size }}px;
    height: {{ section.settings.icon_size }}px;
    object-fit: contain;
    display: block;
  }

  #holistiq-special-{{ section.id }} .holistiq-special__block-title {
    margin: 0 0 12px;
    font-family: 'DM Sans', sans-serif;
    font-weight: 700;
    font-style: normal;
    font-size: 30px;
    line-height: 100%;
    letter-spacing: 0;
    vertical-align: middle;
    color: {{ section.settings.block_title_color }};
  }

  #holistiq-special-{{ section.id }} .holistiq-special__block-text {
    margin: 0;
    font-family: 'DM Sans', sans-serif;
    font-weight: 500;
    font-style: normal;
    font-size: 19px;
    line-height: 120%;
    letter-spacing: 0;
    vertical-align: middle;
    color: {{ section.settings.block_text_color }};
  }

  #holistiq-special-{{ section.id }} .holistiq-special__block-text p {
    margin: 0;
    font-family: inherit;
    font-weight: inherit;
    font-size: inherit;
    line-height: inherit;
    color: inherit;
    text-align: inherit;
  }

  #holistiq-special-{{ section.id }} .holistiq-special__block-text p + p {
    margin-top: 10px;
  }

  @media screen and (min-width: 990px) {
    #holistiq-special-{{ section.id }} .holistiq-special__layout {
      flex-direction: row;
      align-items: stretch;
      gap: 0;
    }
    #holistiq-special-{{ section.id }} .holistiq-special__container {
      padding-left: 20px;
      padding-right: 20px;
    }
    #holistiq-special-{{ section.id }} .holistiq-special__media {
      flex: 0 0 41%;
      max-width: 41%;
      min-height: 100%;
    }

    #holistiq-special-{{ section.id }} .holistiq-special__image--desktop {
      display: block;
    }

    #holistiq-special-{{ section.id }} .holistiq-special__image--mobile {
      display: none;
    }

    #holistiq-special-{{ section.id }} .holistiq-special__image {
      height: 100%;
      min-height: 100%;
    }

    #holistiq-special-{{ section.id }} .holistiq-special__blocks {
      flex: 0 0 59%;
      max-width: 59%;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      column-gap: {{ section.settings.blocks_gap }}px;
      row-gap: {{ section.settings.blocks_gap }}px;
      padding-left: 30px;
      box-sizing: border-box;
    }

    #holistiq-special-{{ section.id }} .holistiq-special__block {
      padding: {{ section.settings.block_padding }}px;
    }

    #holistiq-special-{{ section.id }} .holistiq-special__block-title {
      font-size: 30px;
    }

    #holistiq-special-{{ section.id }} .holistiq-special__block-text {
      font-size: 19px;
      line-height: 120%;
      text-align: left;
    }

    #holistiq-special-{{ section.id }} .holistiq-special__block-text p {
      text-align: left;
    }
  }

  @media screen and (max-width: 989px) {
    #holistiq-special-{{ section.id }} .holistiq-special__heading {
      font-size: 28px;
      margin-bottom: {{ section.settings.mobile_heading_margin_bottom }}px;
    }

    #holistiq-special-{{ section.id }} .holistiq-special__media {
      margin-bottom: {{ section.settings.mobile_image_margin_bottom }}px;
    }

    #holistiq-special-{{ section.id }} .holistiq-special__layout {
      gap: 0;
    }

    #holistiq-special-{{ section.id }} .holistiq-special__block-title {
      font-size: 20px;
    }

    #holistiq-special-{{ section.id }} .holistiq-special__block-text {
      font-size: 12px;
      line-height: 100%;
      text-align: justify;
    }

    #holistiq-special-{{ section.id }} .holistiq-special__block-text p {
      text-align: justify;
    }
  }
{% endstyle %}

{% schema %}
{
  "name": "HolistIQ What Makes",
  "tag": "section",
  "class": "section-holistiq-special",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Section heading",
      "default": "What Makes HolistIQ™ Special?"
    },
    {
      "type": "image_picker",
      "id": "main_image",
      "label": "Desktop image"
    },
    {
      "type": "image_picker",
      "id": "main_image_mobile",
      "label": "Mobile image",
      "info": "Optional. Falls back to desktop image if empty."
    },
    {
      "type": "range",
      "id": "image_radius",
      "label": "Image corner radius",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 12
    },
    {
      "type": "color",
      "id": "section_background",
      "label": "Section background",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading color",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "block_title_color",
      "label": "Block title color",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "block_text_color",
      "label": "Block text color",
      "default": "#000000"
    },
    {
      "type": "header",
      "content": "Mobile layout"
    },
    {
      "type": "range",
      "id": "mobile_heading_margin_bottom",
      "label": "Mobile heading bottom margin",
      "min": 0,
      "max": 60,
      "step": 1,
      "unit": "px",
      "default": 25
    },
    {
      "type": "range",
      "id": "mobile_image_margin_bottom",
      "label": "Mobile image bottom margin",
      "min": 0,
      "max": 60,
      "step": 1,
      "unit": "px",
      "default": 25
    },
    {
      "type": "range",
      "id": "mobile_block_padding",
      "label": "Mobile block padding",
      "min": 0,
      "max": 32,
      "step": 2,
      "unit": "px",
      "default": 10
    },
    {
      "type": "range",
      "id": "mobile_column_gap",
      "label": "Mobile column gap",
      "min": 0,
      "max": 48,
      "step": 1,
      "unit": "px",
      "default": 23
    },
    {
      "type": "range",
      "id": "mobile_row_gap",
      "label": "Mobile row gap",
      "min": 0,
      "max": 48,
      "step": 1,
      "unit": "px",
      "default": 25
    },
    {
      "type": "header",
      "content": "Desktop layout"
    },
    {
      "type": "range",
      "id": "block_padding",
      "label": "Desktop block padding",
      "min": 0,
      "max": 48,
      "step": 4,
      "unit": "px",
      "default": 20
    },
    {
      "type": "range",
      "id": "blocks_gap",
      "label": "Desktop gap between blocks",
      "min": 0,
      "max": 48,
      "step": 4,
      "unit": "px",
      "default": 20
    },
    {
      "type": "range",
      "id": "icon_size",
      "label": "Icon size",
      "min": 32,
      "max": 80,
      "step": 1,
      "unit": "px",
      "default": 55
    },
    {
      "type": "header",
      "content": "Section padding"
    },
    {
      "type": "range",
      "id": "padding_top_desktop",
      "label": "Desktop top padding",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 60
    },
    {
      "type": "range",
      "id": "padding_bottom_desktop",
      "label": "Desktop bottom padding",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 60
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "label": "Mobile top padding",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "label": "Mobile bottom padding",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 40
    }
  ],
  "blocks": [
    {
      "type": "feature",
      "name": "Feature block",
      "settings": [
        {
          "type": "image_picker",
          "id": "icon",
          "label": "Icon"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Block heading",
          "default": "Brain Development"
        },
        {
          "type": "richtext",
          "id": "text",
          "label": "Block text",
          "default": "<p>Early childhood is a critical period for brain growth and development. HolistIQ™ provides essential nutrition to support learning, focus, and overall cognitive development.</p>"
        }
      ]
    }
  ],
  "max_blocks": 4,
  "presets": [
    {
      "name": "HolistIQ What Makes",
      "blocks": [
        {
          "type": "feature",
          "settings": {
            "title": "Brain Development",
            "text": "<p>Early childhood is a critical period for brain growth and development. HolistIQ™ provides essential nutrition to support learning, focus, and overall cognitive development.</p>"
          }
        },
        {
          "type": "feature",
          "settings": {
            "title": "Gut Health Comes First",
            "text": "<p>Includes prebiotic fibres and digestive enzymes to support healthy digestion, better nutrient absorption, and reduced tummy discomfort—because growth begins in the gut.</p>"
          }
        },
        {
          "type": "feature",
          "settings": {
            "title": "Smart Protein for Growing Bodies",
            "text": "<p>Made with a balanced protein blend of whey protein isolate and milk proteins (casein), providing all 9 essential amino acids with high digestibility and a PDCAAS close to 1 for excellent protein quality.</p>"
          }
        },
        {
          "type": "feature",
          "settings": {
            "title": "Height, Muscle & Bone Growth",
            "text": "<p>Specially curated to support height, muscle and bone growth, daily strength, and stamina during the most important growing years.</p>"
          }
        }
      ]
    }
  ]
}
{% endschema %}
