<div id="video-grid-section-{{ section.id }}" class="video-grid-section video-slider-section container">
  <div class="video-grid-section__inner">
    {% if section.settings.heading != blank %}
      <h2 class="video-grid-section__title">{{ section.settings.heading | escape }}</h2>
    {% endif %}

    <div class="video-grid-section__slider-wrap">
      <div class="video-slider swiper" id="swiper-video-{{ section.id }}">
        <div class="swiper-wrapper">
          {% for block in section.blocks %}
            <div class="swiper-slide video-slide" {{ block.shopify_attributes }}>
              <div class="video-container lazy-video" data-video-url="{{ block.settings.video_url }}">
                {% if block.settings.thumbnail != blank %}
                  {{
                    block.settings.thumbnail
                    | image_url: width: 800
                    | image_tag:
                      class: 'video-thumbnail',
                      loading: 'lazy',
                      widths: '400, 600, 800',
                      sizes: '(max-width: 768px) 55vw, 35vw',
                      alt: 'Video thumbnail'
                  }}
                {% else %}
                  <div class="video-thumbnail video-thumbnail--placeholder"></div>
                {% endif %}
                <div class="play-button" aria-hidden="true">
                  <svg class="play-button__icon" viewBox="0 0 64 64" xmlns="http://www.w3.org/2000/svg" focusable="false">
                    <circle cx="32" cy="32" r="30" fill="#000"/>
                    <path d="M26 20 L46 32 L26 44 Z" fill="#fff"/>
                  </svg>
                </div>
              </div>
            </div>
          {% endfor %}
        </div>
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Video Slider",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Explore What Makes Our Products the B'est!"
    }
  ],
  "blocks": [
    {
      "type": "video_slide",
      "name": "Video Slide",
      "settings": [
        {
          "type": "url",
          "id": "video_url",
          "label": "Video URL"
        },
        {
          "type": "image_picker",
          "id": "thumbnail",
          "label": "Video thumbnail"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Video Slider"
    }
  ]
}
{% endschema %}

<style>
  #video-grid-section-{{ section.id }}.video-grid-section {
    padding: 48px 20px 56px;
    text-align: center;
    background-color: #fff;
  }

  #video-grid-section-{{ section.id }} .video-grid-section__inner {
    max-width: 1337px;
    padding: 0 50px;
    margin: 0 auto;
  }

  #video-grid-section-{{ section.id }} .video-grid-section__title {
    margin: 0 auto 25px;
    max-width: 1000px;
    font-size: 50px;
    line-height: 1.15;
    font-weight: 700;
    font-family: Optima, 'Optima Nova', 'Optima LT Pro', Candara, sans-serif;
    color: #000;
    text-align: center;
    letter-spacing: 0;
  }

  #video-grid-section-{{ section.id }} .video-slider.swiper {
    overflow: hidden;
    width: 100%;
  }

  #video-grid-section-{{ section.id }} .video-slide {
    height: auto;
    box-sizing: border-box;
  }

  #video-grid-section-{{ section.id }} .video-container {
    position: relative;
    border-radius: 12px;
    overflow: hidden;
    aspect-ratio: 1;
    max-height: min(72vh, 640px);
    margin: 0 auto;
    background: #e8e8e8;
  }

  #video-grid-section-{{ section.id }} .lazy-video {
    cursor: pointer;
  }

  #video-grid-section-{{ section.id }} .video-thumbnail {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    border-radius: 12px;
  }

  #video-grid-section-{{ section.id }} .video-thumbnail--placeholder {
    min-height: 200px;
    background: #d0ece9;
  }

  #video-grid-section-{{ section.id }} .lazy-video video {
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: 12px;
    display: block;
  }

  #video-grid-section-{{ section.id }} .play-button {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 64px;
    height: 64px;
    display: flex;
    align-items: center;
    justify-content: center;
    pointer-events: none;
    border-radius: 50%;
    background: #000;
    box-shadow: 0 4px 24px rgba(0, 0, 0, 0.25);
  }

  #video-grid-section-{{ section.id }} .play-button__icon {
    width: 64px;
    height: 64px;
    display: block;
  }

  @media (max-width: 768px) {
    #video-grid-section-{{ section.id }} .video-grid-section__inner {
      padding: 0;
    }
    #video-grid-section-{{ section.id }}.video-grid-section {
      padding: 32px 16px 40px;
    }

    #video-grid-section-{{ section.id }} .video-grid-section__title {
      font-size: 28px;
      margin-bottom: 28px;
    }

    #video-grid-section-{{ section.id }} .play-button,
    #video-grid-section-{{ section.id }} .play-button__icon {
      width: 52px;
      height: 52px;
    }
  }
</style>

<script>
  (function () {
    var sectionId = '{{ section.id }}';
    var swiperSelector = '#swiper-video-' + sectionId;
    var rootSelector = '#video-grid-section-' + sectionId;

    function initVideoGridSwiper() {
      if (typeof Swiper === 'undefined') return;
      var el = document.querySelector(swiperSelector);
      if (!el || !el.querySelectorAll('.swiper-slide').length) return;
      if (el.swiper) {
        el.swiper.destroy(true, true);
      }
      new Swiper(el, {
        slidesPerView: 1.5,
        spaceBetween: 12,
        centeredSlides: false,
        watchOverflow: true,
        loop: false,
        speed: 400,
        breakpoints: {
          769: {
            slidesPerView: 3.5,
            spaceBetween: 20
          }
        }
      });
    }

    function initLazyVideos() {
      document.querySelectorAll(rootSelector + ' .lazy-video').forEach(function (container) {
        if (container.dataset.lazyVideoBound === 'true') return;
        container.dataset.lazyVideoBound = 'true';
        container.addEventListener('click', function () {
          if (this.querySelector('video')) return;
          var videoUrl = this.dataset.videoUrl;
          if (!videoUrl) return;
          var video = document.createElement('video');
          video.setAttribute('controls', '');
          video.setAttribute('autoplay', '');
          video.setAttribute('muted', '');
          video.setAttribute('playsinline', '');
          video.style.opacity = '0';
          video.style.transition = 'opacity 0.3s ease';
          var source = document.createElement('source');
          source.setAttribute('type', 'video/mp4');
          source.setAttribute('src', videoUrl);
          video.appendChild(source);
          this.innerHTML = '';
          this.appendChild(video);
          requestAnimationFrame(function () {
            video.style.opacity = '1';
          });
        });
      });
    }

    function onReady() {
      initVideoGridSwiper();
      initLazyVideos();
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', onReady);
    } else {
      onReady();
    }

    document.addEventListener('shopify:section:load', function (e) {
      if (e.detail.sectionId === sectionId) {
        onReady();
      }
    });

    document.addEventListener('shopify:section:unload', function (e) {
      if (e.detail.sectionId !== sectionId) return;
      var el = document.querySelector(swiperSelector);
      if (el && el.swiper) {
        el.swiper.destroy(true, true);
      }
    });
  })();
</script>
