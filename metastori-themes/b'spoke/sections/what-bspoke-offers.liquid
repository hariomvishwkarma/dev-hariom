<section class="offers-section" id="offers-section-{{ section.id }}">
  <div class="offers-section__container">
    {% if section.settings.heading != blank %}
      <h2 class="offers-section__heading">{{ section.settings.heading | escape }}</h2>
    {% endif %}

    <div class="offers-layout">
      <div class="offers-column offers-column--left">
        {% if section.settings.left_top_text != blank %}
          <div class="offers-card offers-card--text">{{ section.settings.left_top_text }}</div>
        {% endif %}

        <div class="offers-card offers-card--image offers-card--image-lg">
          {% if section.settings.left_image != blank %}
            {{
              section.settings.left_image
              | image_url: width: 1200
              | image_tag:
                class: 'offers-card__image',
                loading: 'lazy',
                widths: '360, 540, 720, 900, 1200',
                sizes: '(max-width: 767px) 100vw, 33vw',
                alt: section.settings.heading | escape
            }}
          {% else %}
            {{ 'image' | placeholder_svg_tag: 'offers-card__image offers-card__image--placeholder' }}
          {% endif %}
        </div>

        {% if section.settings.left_bottom_text != blank %}
          <div class="offers-card offers-card--text">{{ section.settings.left_bottom_text }}</div>
        {% endif %}
      </div>

      <div class="offers-column offers-column--center">
        <div class="offers-card offers-card--image offers-card--image-md">
          {% if section.settings.center_image != blank %}
            {{
              section.settings.center_image
              | image_url: width: 1200
              | image_tag:
                class: 'offers-card__image',
                loading: 'lazy',
                widths: '360, 540, 720, 900, 1200',
                sizes: '(max-width: 767px) 100vw, 33vw',
                alt: section.settings.heading | escape
            }}
          {% else %}
            {{ 'image' | placeholder_svg_tag: 'offers-card__image offers-card__image--placeholder' }}
          {% endif %}
        </div>

        {% if section.settings.center_text != blank %}
          <div class="offers-card offers-card--text offers-card--text-large">{{ section.settings.center_text }}</div>
        {% endif %}
      </div>

      <div class="offers-column offers-column--right">
        {% if section.settings.right_top_text != blank %}
          <div class="offers-card offers-card--text">{{ section.settings.right_top_text }}</div>
        {% endif %}

        <div class="offers-card offers-card--image offers-card--image-lg">
          {% if section.settings.right_image != blank %}
            {{
              section.settings.right_image
              | image_url: width: 1200
              | image_tag:
                class: 'offers-card__image',
                loading: 'lazy',
                widths: '360, 540, 720, 900, 1200',
                sizes: '(max-width: 767px) 100vw, 33vw',
                alt: section.settings.heading | escape
            }}
          {% else %}
            {{ 'image' | placeholder_svg_tag: 'offers-card__image offers-card__image--placeholder' }}
          {% endif %}
        </div>
      </div>
    </div>
  </div>
</section>

{% style %}
  #offers-section-{{ section.id }} {
    background: {{ section.settings.section_background }};
  }

  #offers-section-{{ section.id }} .offers-section__container {
    max-width: 1270px;
    margin: 0 auto;
    padding: 24px 20px 28px;
  }

  #offers-section-{{ section.id }} .offers-section__heading {
    margin: 0 0 40px;
    text-align: center;
    font-family: Optima, serif;
    font-size: 50px;
    font-weight: 700;
    line-height: 1;
    color: {{ section.settings.heading_color }};
  }

  #offers-section-{{ section.id }} .offers-layout {
    display: grid;
    gap: 34px;
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }

  #offers-section-{{ section.id }} .offers-column {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  #offers-section-{{ section.id }} .offers-card {
    border-radius: 12px;
    overflow: hidden;
  }

  #offers-section-{{ section.id }} .offers-card--text {
    background: {{ section.settings.text_card_background }};
    padding: 15px 30px;
  }

  #offers-section-{{ section.id }} .offers-card--image-md {
    min-height: 180px;
    flex: 1;
  }

  #offers-section-{{ section.id }} .offers-card--image-lg {
    min-height: 260px;
    flex: 1;
  }

  #offers-section-{{ section.id }} .offers-card--text h1,
  #offers-section-{{ section.id }} .offers-card--text h2,
  #offers-section-{{ section.id }} .offers-card--text h3,
  #offers-section-{{ section.id }} .offers-card--text h4,
  #offers-section-{{ section.id }} .offers-card--text h5,
  #offers-section-{{ section.id }} .offers-card--text h6 {
    margin: 0 0 10px;
    font-family: 'DM Sans', sans-serif;
    font-size: 24px;
    font-weight: 700;
    line-height: 1.3;
    color: {{ section.settings.title_color }};
  }

  #offers-section-{{ section.id }} .offers-card--text p:first-of-type {
    margin: 0 0 10px;
    font-family: 'DM Sans', sans-serif;
    font-size: 15px;
    font-weight: 500;
    line-height: 1.2;
    color: {{ section.settings.subtitle_color }};
  }

  #offers-section-{{ section.id }} .offers-card--text p,
  #offers-section-{{ section.id }} .offers-card--text li {
    margin: 0;
    font-family: 'DM Sans', sans-serif;
    font-size: 31px;
    font-weight: 500;
    line-height: 1.2;
    color: {{ section.settings.description_color }};
  }

  #offers-section-{{ section.id }} .offers-card--text p + p {
    margin-top: 8px;
  }

  #offers-section-{{ section.id }} .offers-card--text ul {
    margin: 0;
    padding-left: 20px;
  }

  #offers-section-{{ section.id }} .offers-card--text-large p,
  #offers-section-{{ section.id }} .offers-card--text-large li {
    font-size: 15px;
    line-height: 1.3;
  }

  #offers-section-{{ section.id }} .offers-card__image {
    display: block;
    width: 100%;
    height: 100%;
    min-height: inherit;
    object-fit: cover;
    border-radius: 12px;
  }

  #offers-section-{{ section.id }} .offers-card__image--placeholder {
    min-height: 180px;
    background: #d7d7d7;
  }

  @media (max-width: 1200px) {
    #offers-section-{{ section.id }} .offers-section__heading {
      font-size: 46px;
    }

    #offers-section-{{ section.id }} .offers-card--text h1,
    #offers-section-{{ section.id }} .offers-card--text h2,
    #offers-section-{{ section.id }} .offers-card--text h3,
    #offers-section-{{ section.id }} .offers-card--text h4,
    #offers-section-{{ section.id }} .offers-card--text h5,
    #offers-section-{{ section.id }} .offers-card--text h6 {
      font-size: 30px;
    }


    #offers-section-{{ section.id }} .offers-card--text p,
    #offers-section-{{ section.id }} .offers-card--text li,
    #offers-section-{{ section.id }} .offers-card--text-large p,
    #offers-section-{{ section.id }} .offers-card--text-large li {
      font-size: 20px;
    }
  }

  @media (max-width: 767px) {
    #offers-section-{{ section.id }} .offers-section__container {
      padding: 20px 25px 24px;
    }

    #offers-section-{{ section.id }} .offers-section__heading {
      font-family: Optima, serif;
      font-size: 28px;
      margin-bottom: 25px;
    }

    #offers-section-{{ section.id }} .offers-card--text {
      padding: 14px 16px;
      border-radius: 8px;
    }
    #offers-section-{{ section.id }} .offers-card__image {
      border-radius: 8px;
    }

    #offers-section-{{ section.id }} .offers-card--text h1,
    #offers-section-{{ section.id }} .offers-card--text h2,
    #offers-section-{{ section.id }} .offers-card--text h3,
    #offers-section-{{ section.id }} .offers-card--text h4,
    #offers-section-{{ section.id }} .offers-card--text h5,
    #offers-section-{{ section.id }} .offers-card--text h6 {
      font-size: 24px;
    }

    #offers-section-{{ section.id }} .offers-card--text p:first-of-type {
      font-size: 12px;
    }

    #offers-section-{{ section.id }} .offers-card--text p,
    #offers-section-{{ section.id }} .offers-card--text li,
    #offers-section-{{ section.id }} .offers-card--text-large p,
    #offers-section-{{ section.id }} .offers-card--text-large li {
      font-size: 16px;
    }
  }
  @media (max-width: 1024px) {
    #offers-section-{{ section.id }} .offers-layout {
      grid-template-columns: 1fr;
    }
  }
{% endstyle %}

{% schema %}
{
  "name": "What B'spoke offers",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Section heading",
      "default": "What B'spoke Offers"
    },
    {
      "type": "color",
      "id": "section_background",
      "label": "Section background",
      "default": "#f0f0f0"
    },
    {
      "type": "color",
      "id": "text_card_background",
      "label": "Text card background",
      "default": "#eeede3"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading color",
      "default": "#111111"
    },
    {
      "type": "color",
      "id": "title_color",
      "label": "Card title color",
      "default": "#111111"
    },
    {
      "type": "color",
      "id": "subtitle_color",
      "label": "Card subtitle color",
      "default": "#111111"
    },
    {
      "type": "color",
      "id": "description_color",
      "label": "Description color",
      "default": "#111111"
    },
    {
      "type": "header",
      "content": "Left column"
    },
    {
      "type": "richtext",
      "id": "left_top_text",
      "label": "Left top text",
      "default": "<h3>Functional Foods</h3><p>Developed for real-life daily health needs.</p>"
    },
    {
      "type": "image_picker",
      "id": "left_image",
      "label": "Left image"
    },
    {
      "type": "richtext",
      "id": "left_bottom_text",
      "label": "Left bottom text",
      "default": "<h3>Clean-Label Biscuit</h3><p>High-fiber, gluten-free, prebiotic cookies.</p>"
    },
    {
      "type": "header",
      "content": "Center column"
    },
    {
      "type": "image_picker",
      "id": "center_image",
      "label": "Center image"
    },
    {
      "type": "richtext",
      "id": "center_text",
      "label": "Center text",
      "default": "<h3>Premium Nutraceutical Supplements</h3><p>Add center column text here.</p>"
    },
    {
      "type": "header",
      "content": "Right column"
    },
    {
      "type": "richtext",
      "id": "right_top_text",
      "label": "Right top text",
      "default": "<h3>Prebiotic Fiber Products</h3><p>Supports digestion and gut microbiome health.</p>"
    },
    {
      "type": "image_picker",
      "id": "right_image",
      "label": "Right image"
    }
  ],
  "presets": [
    {
      "name": "What B'spoke offers"
    }
  ]
}
{% endschema %}
