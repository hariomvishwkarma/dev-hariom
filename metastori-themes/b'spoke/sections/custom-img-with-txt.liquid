    <div class="features-section">
    <div class="features-container">
    {% for block in section.blocks %}
    <div class="feature-block con{{ forloop.index0 }}">
    <div class="feature-content">
    <h3 class="feature-title">{{ block.settings.feature_title }}</h3>
    <p class="feature-description">{{ block.settings.feature_description }}</p>
    </div>
    <div class="feature-image">
    <h3 class="feature-title_mob">{{ block.settings.feature_title }}</h3>
    {% if block.settings.feature_image %}
    <img
    src="{{ block.settings.feature_image | img_url: 'master' }}"
    alt="{{ block.settings.icon_text }}"
    >
    {% endif %}
    </div>
    </div>
    {% endfor %}
    </div>
    </div>
    
    {% schema %}
    {
    "name": "Custom Features Section",
    "class": "custom_img_textt",
    "settings": [
    {
    "type": "text",
    "id": "section_heading",
    "label": "Section Heading",
    }
    ],
    "blocks": [
    {
    "type": "feature",
    "name": "Feature Block",
    "settings": [
    {
    "type": "text",
    "id": "feature_title",
    "label": "Feature Title",
    },
    {
    "type": "richtext",
    "id": "feature_description",
    "label": "Feature Description",
    },
    {
    "type": "image_picker",
    "id": "feature_image",
    "label": "Feature Image"
    }
    ]
    }
    ],
    "presets": [
    {
    "name": "Custom Features Section",
    }
    ]
    }
    {% endschema %}
    
    <style>
    .feature-block {
    display: flex;
    align-items:center;
    }
    
    .feature-block.con1 {
    flex-direction: row-reverse;
    }
    
    .feature-image {
    width: 50%;
    /* margin-top: -3px; */
    /* margin-left: -33px; */
    }
    
    .feature-content {
    width: 50%;
    height: auto;
    line-height: 1;
padding: 40px;
    }
    
    .feature-image img {
    width: 100%;
    /* max-width: 720px; */
    line-height: 1;
    object-fit: cover;
    height: auto;
    }
    
    .feature-image {
    line-height: 1;
    display: flex;
    }
    .feature-content ul {
    display: flex;
    flex-direction: column;
    max-width: 465px;
    margin: 0 auto;
    }
    
    h3.feature-title {
    text-align: center;
    font-size:32px;
    font-weight: 500;
    line-height: 39px;
    }
    
    .feature-content ul li {
    font-size: 15px;
    font-weight: 400;
    line-height: 30px;
    color: #000000;
    }
    .features-section {
    background-color: #F7F7E7;
    margin-top: 60px;
    }
    h3.feature-title_mob {
    display: none;
    }

 h3.feature-title { margin-bottom: 15px; }
    
    /* Responsive */
    @media(max-width: 768px){

    .feature-content ul {
        padding-top: 15px !important;
        padding-left: 20px !important;
        padding-bottom: 10px;
    }

.feature-content{ padding: 15px !important; }

.feature-content ul li {
    line-height: 25px !important;
}

