{%- assign default_handle = section.settings.default_blog.handle -%}
{%- if default_handle == blank and section.blocks.size > 0 -%}
  {%- assign default_handle = section.blocks.first.settings.blog.handle -%}
{%- endif -%}
{%- assign current_handle = blog.handle | default: default_handle -%}
{%- assign current_blog = blogs[current_handle] -%}

<section class="blog-grid section-{{ section.id }}-padding" id="blog-grid-{{ section.id }}">
  <div class="container">
    <h1 class="blog-grid__heading">{{ section.settings.heading }}</h1>

    {% if section.blocks.size > 0 %}
      <div class="blog-grid__tabs" role="navigation" aria-label="Blog categories">
        {% for block in section.blocks %}
          {% assign selected_blog = block.settings.blog %}
          {% if selected_blog != blank %}
            {% assign tab_label = block.settings.label | default: selected_blog.title %}
            <a
              class="blog-grid__tab-pill{% if selected_blog.handle == current_handle %} is-active{% endif %}"
              href="{{ selected_blog.url }}"
              {{ block.shopify_attributes }}
            >
              {{ tab_label }}
            </a>
          {% endif %}
        {% endfor %}
      </div>
    {% endif %}

    {% if current_blog != blank %}
      {% paginate current_blog.articles by section.settings.posts_per_blog %}
        <div class="blog-grid__list">
          {% for article in current_blog.articles %}
            {%- assign excerpt_plain = article.excerpt_or_content | strip_html -%}

            {%- assign override_link = article.metafields.custom.date_badge_link.value
                                  | default: article.metafields.custom.date_link.value
                                  | default: article.metafields.custom.badge_link.value
                                -%}

            {%- if override_link != blank -%}
              {%- assign card_href = override_link -%}
              {%- assign card_target = 'target="_blank" rel="noopener noreferrer"' -%}
            {%- else -%}
              {%- assign card_href = article.url -%}
              {%- assign card_target = '' -%}
            {%- endif -%}

            <article class="blog-card">
              <a class="blog-card__image-link" href="{{ card_href }}" {{ card_target }}>
                {% if paginate.current_page == 1 and forloop.index <= 3 %}
                  <span class="blog-card__badge">{{ 'blogs.article.latest_news' | t }}</span>
                {% endif %}
                {% if article.image %}
                  {{
                    article.image
                    | image_url: width: 900
                    | image_tag:
                      class: 'blog-card__image',
                      loading: 'lazy',
                      alt: article.image.alt | default: article.title
                  }}
                {% else %}
                  {{ 'image' | placeholder_svg_tag: 'blog-card__image blog-card__image--placeholder' }}
                {% endif %}
              </a>

              <div class="blog-card__content">
                <h2 class="blog-card__title">
                  <a class="blog-card__title-link" href="{{ card_href }}" {{ card_target }}>{{ article.title }}</a>
                </h2>

                {% if excerpt_plain != blank %}
                  <p class="blog-card__excerpt">{{ excerpt_plain }}</p>
                {% endif %}

                <div class="blog-card__bottom">
                {% if section.settings.show_date %}
                  <div class="blog-card__meta-wrap">
                    {%- assign date_meta_image = article.metafields.custom.date_badge_image.value
                                          | default: article.metafields.custom.date_image.value
                                          | default: article.metafields.custom.badge_image.value
                                        -%}
                    {%- assign date_meta_link = article.metafields.custom.date_badge_link.value
                                          | default: article.metafields.custom.date_link.value
                                          | default: article.metafields.custom.badge_link.value
                                        -%}
                    {% if date_meta_image != blank %}
                      {% if date_meta_link != blank %}
                        <a href="{{ date_meta_link }}" target="_blank" rel="noopener noreferrer" class="blog-card__meta-image-link">
                          {{
                            date_meta_image
                            | image_url: width: 108
                            | image_tag:
                              class: 'blog-card__meta-image',
                              loading: 'lazy',
                              alt: article.title
                          }}
                        </a>
                      {% else %}
                        {{
                          date_meta_image
                          | image_url: width: 108
                          | image_tag:
                            class: 'blog-card__meta-image',
                            loading: 'lazy',
                            alt: article.title
                        }}
                      {% endif %}
                    {% endif %}
                    <span class="blog-card__meta">{{ article.published_at | date: "%b %d, %Y" }}</span>
                  </div>
                {% endif %}
                  {% if section.settings.read_more_text != blank %}
                    <a
                      class="blog-card__readmore"
                      href="{{ card_href }}"
                      {{ card_target }}
                      aria-label="{{ section.settings.read_more_text }}: {{ article.title | escape }}"
                    >
                      {{ section.settings.read_more_text }}
                    </a>
                  {% endif %}
                </div>
              </div>
            </article>
          {% else %}
            <p class="blog-grid__empty">{{ section.settings.empty_label }}</p>
          {% endfor %}
        </div>

        {% if paginate.pages > 1 %}
          {% render 'pagination',
            paginate: paginate,
            class: 'pagination-wrapper blog-grid__pagination'
          %}
        {% endif %}
      {% endpaginate %}
    {% else %}
      <p class="blog-grid__empty">Select a default blog or open this section on a blog page.</p>
    {% endif %}
  </div>
</section>

{% style %}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.pad_top }}px;
    padding-bottom: {{ section.settings.pad_bottom }}px;
    background: {{ section.settings.section_background }};
  }

  .template-blog .pagination__list>li {
    width: 50px;
  }

  .template-blog span.arrow-text {
    display: none;
  }

  .template-blog  .pagination__list .pagination-arrow:first-child {
    margin-right: 0;
  }

  .template-blog li.pagination-arrow {
    justify-items: anchor-center;
    margin-left: 0;
  }

  #blog-grid-{{ section.id }} .blog-grid__heading {
    margin: 0 0 30px;
    color: #111111;
    font-family: Optima;
    font-weight: 700;
    font-size: 50px;
    line-height: 100%;
    letter-spacing: 0%;
    text-align: center;
    vertical-align: middle;
  }

  #blog-grid-{{ section.id }} .blog-grid__tabs {
    display: flex;
    flex-wrap: wrap;
    gap: 20px;
    justify-content: center;
    margin: 0 0 40px;
  }

  #blog-grid-{{ section.id }} .blog-grid__tab-pill {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 40px;
    color: #1f1f1f;
    background: #ffffff;
    text-decoration: none;
    font-size: 18px;
    font-weight: 500;
    transition: 0.2s ease;
    border-radius: 15px;
    border-width: 1px;
    padding: 15px 20px;
    border: 1px solid #00000026;
    box-shadow: 0px 0px 10px 0px #0000000D;
    font-family: DM Sans;
    font-weight: 500;
  }

  #blog-grid-{{ section.id }} .blog-grid__tab-pill:hover,
  #blog-grid-{{ section.id }} .blog-grid__tab-pill.is-active {
    color: {{ section.settings.pill_active_text_color }};
    background: {{ section.settings.pill_active_background }};
    border-color: {{ section.settings.pill_active_background }};
  }

  #blog-grid-{{ section.id }} .blog-grid__list {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    column-gap: 25px;
    row-gap: 40px;
  }

  #blog-grid-{{ section.id }} .blog-card {
    border: 1px solid {{ section.settings.card_border_color }};
    border-radius: 15px;
    overflow: hidden;
    background: {{ section.settings.card_background }};
    display: flex;
    flex-direction: column;
  }

  #blog-grid-{{ section.id }} .blog-card__image-link {
    display: block;
    line-height: 0;
    padding: 20px;
    padding-bottom: 0;
    position: relative;
  }

  #blog-grid-{{ section.id }} .blog-card__image-link img {
    border-radius: 14.07px;
  }

  #blog-grid-{{ section.id }} .blog-card__badge {
    position: absolute;
    top: 30px;
    left: 30px;
    z-index: 1;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 30px;
    padding: 10px;
    border-radius: 4px;
    background: #f4f8ef;
    color: #14754b;
    font-family: DM Sans;
    font-weight: 700;
    font-size: 12px;
    line-height: 100%;
    letter-spacing: 0%;
    vertical-align: middle;
  }

  #blog-grid-{{ section.id }} .blog-card__image {
    width: 100%;
    aspect-ratio: 1;
    object-fit: cover;
    display: block;
    height: auto;
  }

  #blog-grid-{{ section.id }} .blog-card__content {
    display: flex;
    flex-direction: column;
    gap: 12px;
    padding: 20px;
    height: 100%;
  }

  #blog-grid-{{ section.id }} .blog-card__title {
    margin: 0;
    line-height: 1.25;
    font-size: 2rem;
  }

  #blog-grid-{{ section.id }} .blog-card__title-link {
    color: {{ section.settings.title_color }};
    text-decoration: none;
    color: #196f4c;
    text-decoration: none;
    font-family: DM Sans;
    font-weight: bold;
    font-size: 20px;
    line-height: 100%;
    letter-spacing: 0%;
    vertical-align: middle;
  }

  #blog-grid-{{ section.id }} .blog-card__excerpt {
    margin: 0;
    color: #000000;
    overflow: hidden;
    text-overflow: ellipsis;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    line-clamp: 3;
    min-height: calc(1em * 3);
    font-size: 15px;
    font-weight: 500;
    font-family: 'DM Sans';
  }

  #blog-grid-{{ section.id }} .blog-card__bottom {
    margin-top: auto;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    margin-top: 3px;
  }

  #blog-grid-{{ section.id }} .blog-card__meta {
    color: #8b8b8b;
    font-family: DM Sans;
    font-weight: 500;
    font-size: 11px;
    line-height: 100%;
    letter-spacing: 0%;
    text-align: justify;
    vertical-align: middle;
  }

  #blog-grid-{{ section.id }} .blog-card__meta-wrap {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  #blog-grid-{{ section.id }} .blog-card__meta-image {
    object-position: left;
    height: 36px;
    border-radius: 4.14px;
    object-fit: contain;
    display: block;
  }

  #blog-grid-{{ section.id }} .blog-card__readmore {
    border: 1.5px solid #126a48;
    color: #126a48;
    background: #ffffff;
    border-radius: 7px;
    text-decoration: none;
    padding: 9px 14px;
    transition: 0.2s ease;
    font-family: DM Sans;
    font-weight: 700;
    font-size: 15.48px;
    line-height: 100%;
    letter-spacing: 0%;
    vertical-align: middle;
  }

  #blog-grid-{{ section.id }} .blog-card__readmore:hover {
    color: {{ section.settings.read_more_hover_text_color }};
    background: {{ section.settings.read_more_hover_background }};
    border-color: {{ section.settings.read_more_hover_background }};
  }

  #blog-grid-{{ section.id }} .blog-grid__pagination {
    margin-top: 34px;
    margin-bottom: 0;
  }

  #blog-grid-{{ section.id }} .blog-grid__pagination .pagination {
    justify-content: center;
  }

  #blog-grid-{{ section.id }} .blog-grid__pagination .pagination__item {
    border-color: {{ section.settings.card_border_color }};
    color: {{ section.settings.pill_text_color }};
    background: {{ section.settings.pill_background }};
    border-radius: 999px;
  }

  #blog-grid-{{ section.id }} .blog-grid__pagination .pagination__item--current {
    color: {{ section.settings.pill_active_text_color }};
    background: {{ section.settings.pill_active_background }};
    border-color: {{ section.settings.pill_active_background }};
  }

  #blog-grid-{{ section.id }} .blog-grid__empty {
    text-align: center;
    color: {{ section.settings.meta_color }};
    margin: 0;
    font-size: 18px;
  }

  #blog-grid-{{ section.id }} .blog-grid__list > .blog-grid__empty {
    grid-column: 1 / -1;
    justify-self: stretch;
    width: 100%;
    display: flex;
    justify-content: center;
    align-items: center;
  }

  .template-blogmain#MainContent {
    padding: 0;
  }

  @media (max-width: 990px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.pad_top | times: 0.7 | round }}px;
      padding-bottom: {{ section.settings.pad_bottom | times: 0.7 | round }}px;
    }

    #blog-grid-{{ section.id }} .blog-grid__list {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 18px;
    }

    #blog-grid-{{ section.id }} .blog-card__content {
      padding: 16px;
    }
  }

  @media (max-width: 767px) {
    #blog-grid-{{ section.id }} .blog-grid__list {
      grid-template-columns: 1fr;
    }

    #blog-grid-{{ section.id }} .blog-grid__heading {
      margin-bottom: 16px;
      font-size: 30px;
    }

    #blog-grid-{{ section.id }} .blog-grid__tabs {
      margin-bottom: 24px;
      gap: 10px;
    }

    #blog-grid-{{ section.id }} .blog-grid__tab-pill {
      font-size: 10px;
      padding: 10px;
      line-height: 1;
      min-height: auto;
      border-radius: 4.3px;
      
    }
  }
{% endstyle %}

{% schema %}
{
  "name": "Blog grid with search",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Blog & Articles" },
    { "type": "blog", "id": "default_blog", "label": "Default selected blog" },
    { "type": "range", "id": "posts_per_blog", "label": "Posts per blog", "min": 3, "max": 24, "step": 1, "default": 6 },
    { "type": "range", "id": "excerpt_words", "label": "Excerpt words", "min": 8, "max": 60, "step": 1, "default": 22 },
    { "type": "checkbox", "id": "show_date", "label": "Show publish date", "default": true },
    { "type": "text", "id": "read_more_text", "label": "Read more text", "default": "Read More" },
    { "type": "text", "id": "empty_label", "label": "Empty state text", "default": "No posts available in this blog yet." },
    { "type": "color", "id": "section_background", "label": "Section background", "default": "#ffffff" },
    { "type": "color", "id": "heading_color", "label": "Heading color", "default": "#111111" },
    { "type": "color", "id": "pill_background", "label": "Pill background", "default": "#ffffff" },
    { "type": "color", "id": "pill_text_color", "label": "Pill text color", "default": "#1f1f1f" },
    { "type": "color", "id": "pill_border_color", "label": "Pill border color", "default": "#dbdbdb" },
    { "type": "color", "id": "pill_active_background", "label": "Active pill background", "default": "#0e7f4f" },
    { "type": "color", "id": "pill_active_text_color", "label": "Active pill text color", "default": "#ffffff" },
    { "type": "color", "id": "card_background", "label": "Card background", "default": "#ffffff" },
    { "type": "color", "id": "card_border_color", "label": "Card border color", "default": "#e8e8e8" },
    { "type": "color", "id": "title_color", "label": "Card title color", "default": "#196f4c" },
    { "type": "color", "id": "text_color", "label": "Card text color", "default": "#2f2f2f" },
    { "type": "color", "id": "meta_color", "label": "Meta text color", "default": "#8b8b8b" },
    { "type": "color", "id": "read_more_background", "label": "Read more background", "default": "#ffffff" },
    { "type": "color", "id": "read_more_text_color", "label": "Read more text color", "default": "#126a48" },
    { "type": "color", "id": "read_more_border_color", "label": "Read more border color", "default": "#126a48" },
    { "type": "color", "id": "read_more_hover_background", "label": "Read more hover background", "default": "#126a48" },
    { "type": "color", "id": "read_more_hover_text_color", "label": "Read more hover text color", "default": "#ffffff" },
    { "type": "range", "id": "pad_top", "label": "Padding top", "min": 0, "max": 120, "step": 4, "default": 48 },
    { "type": "range", "id": "pad_bottom", "label": "Padding bottom", "min": 0, "max": 120, "step": 4, "default": 48 }
  ],
  "blocks": [
    {
      "type": "blog_item",
      "name": "Blog pill",
      "settings": [
        { "type": "blog", "id": "blog", "label": "Blog" },
        { "type": "text", "id": "label", "label": "Pill label (optional)" }
      ]
    }
  ],
  "max_blocks": 12,
  "presets": [{ "name": "Blog grid with search" }]
}
{% endschema %}
