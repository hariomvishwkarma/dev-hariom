<section class="about-overlay-section about-overlay-section--{{ section.settings.section_height }}" id="about-overlay-{{ section.id }}">
  <div class="about-overlay-section__container">
    {% if section.settings.heading_text != blank %}
      <h1 class="about-overlay-section__heading">{{ section.settings.heading_text | escape }}</h1>
    {% endif %}

    <div class="about-overlay-section__media">
      {% if section.settings.image != blank %}
        {{
          section.settings.image
          | image_url: width: 2400
          | image_tag:
            class: 'about-overlay-section__image',
            loading: 'lazy',
            widths: '768, 1024, 1440, 1920, 2400',
            sizes: '100vw',
            alt: section.settings.heading_text | default: 'About section image' | escape
        }}
      {% else %}
        {{ 'lifestyle-2' | placeholder_svg_tag: 'about-overlay-section__image about-overlay-section__image--placeholder' }}
      {% endif %}

      {% if section.settings.enable_overlay %}
        <div class="about-overlay-section__overlay"></div>
      {% endif %}

      <div class="about-overlay-section__content-wrap about-overlay-section__content-wrap--{{ section.settings.text_alignment }}">
        {% if section.settings.description_text != blank %}
          <p class="about-overlay-section__description">{{ section.settings.description_text }}</p>
        {% endif %}
      </div>
    </div>
  </div>
</section>

{% style %}
  #about-overlay-{{ section.id }} {
    --about-overlay-custom-height: {{ section.settings.custom_height }}px;
    --about-overlay-overlay-color: {{ section.settings.overlay_color }};
    --about-overlay-overlay-opacity: {{ section.settings.overlay_opacity | divided_by: 100.0 }};
  }

  #about-overlay-{{ section.id }} .about-overlay-section__container {
    width: 100%;
    margin: 0 auto;
  }

  #about-overlay-{{ section.id }} .about-overlay-section__heading {
    margin: 0 0 40px;
    font-family: Optima, serif;
    font-weight: 700;
    font-size: 50px;
    line-height: 1;
    text-align: {{ section.settings.text_alignment }};
    color: {{ section.settings.heading_color }};
  }

  #about-overlay-{{ section.id }}.about-overlay-section--small .about-overlay-section__media {
    height: 360px;
  }

  #about-overlay-{{ section.id }}.about-overlay-section--medium .about-overlay-section__media {
    height: 460px;
  }

  #about-overlay-{{ section.id }}.about-overlay-section--large .about-overlay-section__media {
    height: 560px;
  }

  #about-overlay-{{ section.id }}.about-overlay-section--custom .about-overlay-section__media {
    height: var(--about-overlay-custom-height);
  }

  #about-overlay-{{ section.id }} .about-overlay-section__media {
    position: relative;
    width: 100%;
    overflow: hidden;
    isolation: isolate;
  }

  #about-overlay-{{ section.id }} .about-overlay-section__image {
    width: 100%;
    height: 100%;
    min-height: inherit;
    object-fit: cover;
    display: block;
  }

  #about-overlay-{{ section.id }} .about-overlay-section__image--placeholder {
    background: #d7d7d7;
  }

  #about-overlay-{{ section.id }} .about-overlay-section__overlay {
    position: absolute;
    inset: 0;
    z-index: 1;
    background: var(--about-overlay-overlay-color);
    opacity: var(--about-overlay-overlay-opacity);
    display: block;
  }

  #about-overlay-{{ section.id }} .about-overlay-section__content-wrap {
    position: absolute;
    inset: 0;
    z-index: 2;
    display: flex;
    align-items: center;
    padding: 28px 40px;
  }

  #about-overlay-{{ section.id }} .about-overlay-section__content-wrap--left {
    justify-content: flex-start;
    text-align: left;
  }

  #about-overlay-{{ section.id }} .about-overlay-section__content-wrap--center {
    justify-content: center;
    text-align: center;
  }

  #about-overlay-{{ section.id }} .about-overlay-section__content-wrap--right {
    justify-content: flex-end;
    text-align: right;
  }

  #about-overlay-{{ section.id }} .about-overlay-section__description {
    margin: 0;
    max-width: 1050px;
    color: {{ section.settings.description_color }};
    font-family: 'DM Sans', sans-serif;
    font-weight: 500;
    font-size: 20px;
    letter-spacing: 0;
    vertical-align: middle;
  }

  @media (max-width: 1024px) {
    #about-overlay-{{ section.id }} .about-overlay-section__heading {
      font-size: 40px;
      margin-bottom: 20px;
    }

    #about-overlay-{{ section.id }} .about-overlay-section__content-wrap {
      padding: 24px;
    }
  }

  @media (max-width: 767px) {
    #about-overlay-{{ section.id }} .about-overlay-section__heading {
      font-family: Optima, serif;
      font-size: 28px;
      margin-bottom: 25px;
    }

    #about-overlay-{{ section.id }} .about-overlay-section__description {
      font-size: 16px;
      line-height: 1.3;
      max-width: 100%;
    }

    #about-overlay-{{ section.id }}.about-overlay-section--small .about-overlay-section__media {
      min-height: 300px;
    }

    #about-overlay-{{ section.id }}.about-overlay-section--medium .about-overlay-section__media {
      min-height: 360px;
    }

    #about-overlay-{{ section.id }}.about-overlay-section--large .about-overlay-section__media {
      min-height: 430px;
    }

    #about-overlay-{{ section.id }}.about-overlay-section--custom .about-overlay-section__media {
      min-height: max(260px, calc(var(--about-overlay-custom-height) * 0.72));
    }
  }
{% endstyle %}

{% schema %}
{
  "name": "About image overlay",
  "settings": [
    {
      "type": "header",
      "content": "Media"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Background image"
    },
    {
      "type": "select",
      "id": "section_height",
      "label": "Section height",
      "options": [
        { "value": "small", "label": "Small" },
        { "value": "medium", "label": "Medium" },
        { "value": "large", "label": "Large" },
        { "value": "custom", "label": "Custom" }
      ],
      "default": "medium"
    },
    {
      "type": "range",
      "id": "custom_height",
      "label": "Custom height",
      "min": 280,
      "max": 900,
      "step": 10,
      "unit": "px",
      "default": 460
    },
    {
      "type": "header",
      "content": "Text"
    },
    {
      "type": "text",
      "id": "heading_text",
      "label": "Heading text",
      "default": "About"
    },
    {
      "type": "inline_richtext",
      "id": "description_text",
      "label": "Content text",
      "default": "B'spoke is an India-based wellness brand specializing in clean-label functional foods and clinically formulated nutraceutical supplements. Designed for modern Indian lifestyles, B'spoke products are built on precision science, high-quality ingredients, and clean manufacturing standards."
    }, 
    {
      "type": "select",
      "id": "text_alignment",
      "label": "Text alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ],
      "default": "center"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading color",
      "default": "#111111"
    },
    {
      "type": "color",
      "id": "description_color",
      "label": "Content text color",
      "default": "#ffffff"
    },
    {
      "type": "header",
      "content": "Overlay"
    },
    {
      "type": "checkbox",
      "id": "enable_overlay",
      "label": "Enable overlay",
      "default": true
    },
    {
      "type": "color",
      "id": "overlay_color",
      "label": "Overlay color",
      "default": "#000000"
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "label": "Overlay opacity",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 45
    }
  ],
  "presets": [
    {
      "name": "About image overlay"
    }
  ]
}
{% endschema %}
