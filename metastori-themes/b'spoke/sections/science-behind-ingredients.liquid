<section class="science-ingredients-section" id="science-ingredients-{{ section.id }}">
  <div class="science-ingredients-section__container">
    {% if section.settings.heading != blank %}
      <h2 class="science-ingredients-section__heading">{{ section.settings.heading | escape }}</h2>
    {% endif %}

    {% if section.settings.intro_text != blank %}
      <div class="science-ingredients-section__intro">{{ section.settings.intro_text }}</div>
    {% endif %}

    <div class="science-ingredients-section__grid">
      <div class="science-ingredients-card science-ingredients-card--text">
        {{ section.settings.left_text }}
      </div>

      <div class="science-ingredients-card science-ingredients-card--image">
        {% if section.settings.center_image != blank %}
          {{
            section.settings.center_image
            | image_url: width: 1200
            | image_tag:
              class: 'science-ingredients-card__image',
              loading: 'lazy',
              widths: '480, 720, 960, 1200',
              sizes: '(max-width: 767px) 100vw, 33vw',
              alt: section.settings.heading | escape
          }}
        {% else %}
          {{ 'image' | placeholder_svg_tag: 'science-ingredients-card__image science-ingredients-card__image--placeholder' }}
        {% endif %}
      </div>

      <div class="science-ingredients-card science-ingredients-card--text">
        {{ section.settings.right_text }}
      </div>
    </div>
  </div>
</section>

{% style %}
  #science-ingredients-{{ section.id }} {
    background: {{ section.settings.section_background }};
  }

  #science-ingredients-{{ section.id }} .science-ingredients-section__container {
    max-width: 1270px;
    margin: 0 auto;
    padding: 26px 20px 0;
  }

  #science-ingredients-{{ section.id }} .science-ingredients-section__heading {
    margin: 0 0 40px;
    text-align: center;
    font-family: Optima, serif;
    font-size: 50px;
    font-weight: 700;
    line-height: 1;
    letter-spacing: 0;
    color: {{ section.settings.heading_color }};
    
  }

  #science-ingredients-{{ section.id }} .science-ingredients-section__intro {
    max-width: 980px;
    margin: 0 auto 40px;
    text-align: center;
    font-family: 'DM Sans', sans-serif;
    font-size: 20px;
    font-weight: 500;
    line-height: 1.3;
    color: {{ section.settings.intro_color }};
  }

  #science-ingredients-{{ section.id }} .science-ingredients-section__intro p {
    margin: 0;
  }

  #science-ingredients-{{ section.id }} .science-ingredients-section__grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 38px;
    align-items: stretch;
  }

  #science-ingredients-{{ section.id }} .science-ingredients-card {
    border-radius: 12px;
    overflow: hidden;
  }

  #science-ingredients-{{ section.id }} .science-ingredients-card--text {
    background: {{ section.settings.text_card_background }};
    padding: 30px;
  }

  #science-ingredients-{{ section.id }} .science-ingredients-card--text h1,
  #science-ingredients-{{ section.id }} .science-ingredients-card--text h2,
  #science-ingredients-{{ section.id }} .science-ingredients-card--text h3,
  #science-ingredients-{{ section.id }} .science-ingredients-card--text h4,
  #science-ingredients-{{ section.id }} .science-ingredients-card--text h5,
  #science-ingredients-{{ section.id }} .science-ingredients-card--text h6 {
    margin: 0 0 10px;
    font-family: 'DM Sans', sans-serif;
    font-size: 26px;
    font-weight: 700;
    line-height: 1.2;
    color: {{ section.settings.title_color }};
  }

  #science-ingredients-{{ section.id }} .science-ingredients-card--text p,
  #science-ingredients-{{ section.id }} .science-ingredients-card--text li {
    margin: 0;
    font-family: 'DM Sans', sans-serif;
    font-size: 15px;
    font-weight: 500;
    line-height: 1.3;
    color: {{ section.settings.text_color }};
  }

  #science-ingredients-{{ section.id }} .science-ingredients-card--text p strong {
    font-size: 20px;
  }

  #science-ingredients-{{ section.id }} .science-ingredients-card--text p + p {
    margin-top: 10px;
  }

  #science-ingredients-{{ section.id }} .science-ingredients-card--text ul {
    margin: 8px 0 0;
    padding-left: 18px;
  }

  #science-ingredients-{{ section.id }} .science-ingredients-card--text li + li {
    margin-top: 8px;
  }

  #science-ingredients-{{ section.id }} .science-ingredients-card__image {
    width: 100%;
    height: 100%;
    min-height: 330px;
    object-fit: cover;
    border-radius: 12px;
    display: block;
  }

  #science-ingredients-{{ section.id }} .science-ingredients-card__image--placeholder {
    background: #d8d8d8;
  }

  @media (max-width: 1024px) {
    #science-ingredients-{{ section.id }} .science-ingredients-section__intro {
      font-size: 18px;
    }

    #science-ingredients-{{ section.id }} .science-ingredients-section__grid {
      gap: 16px;
    }
  }

  @media (max-width: 767px) {
    #science-ingredients-{{ section.id }} .science-ingredients-card--text p strong {
      font-size: 15px;
    }
    #science-ingredients-{{ section.id }} .science-ingredients-card--text h1,
    #science-ingredients-{{ section.id }} .science-ingredients-card--text h2,
    #science-ingredients-{{ section.id }} .science-ingredients-card--text h3,
    #science-ingredients-{{ section.id }} .science-ingredients-card--text h4,
    #science-ingredients-{{ section.id }} .science-ingredients-card--text h5,
    #science-ingredients-{{ section.id }} .science-ingredients-card--text h6 {
     
      font-size: 20px;
    }
    #science-ingredients-{{ section.id }} .science-ingredients-section__container {
      padding: 22px 16px 26px;
    }

    #science-ingredients-{{ section.id }} .science-ingredients-section__heading {
      font-size: 28px;
      margin-bottom: 25px;
      text-transform: none;
    }

    #science-ingredients-{{ section.id }} .science-ingredients-section__intro {
      font-size: 16px;
      margin-bottom: 18px;
    }

    #science-ingredients-{{ section.id }} .science-ingredients-section__grid {
      grid-template-columns: 1fr;
      gap: 14px;
    }

    #science-ingredients-{{ section.id }} .science-ingredients-card--text {
      padding: 16px;
    }

    #science-ingredients-{{ section.id }} .science-ingredients-card__image {
      min-height: 260px;
    }
  }
{% endstyle %}

{% schema %}
{
  "name": "Science behind ingredient",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Section heading",
      "default": "SCIENCE BEHIND OUR INGREDIENTS"
    },
    {
      "type": "richtext",
      "id": "intro_text",
      "label": "Intro text",
      "default": "<p>At B'spoke, every ingredient is chosen with precision and purpose. Our formulations use clinically studied nutrients that support your health at a cellular level.</p>"
    },
    {
      "type": "richtext",
      "id": "left_text",
      "label": "Left card text",
      "default": "<h3>Omega-3 (Algal EPA/DHA)</h3><p>Omega-3 fatty acids support heart, brain, joint, eye and inflammatory balance.</p><h4>What the science says:</h4><ul><li>Reduces inflammation markers.</li><li>Supports cardiovascular health.</li></ul>"
    },
    {
      "type": "image_picker",
      "id": "center_image",
      "label": "Center image"
    },
    {
      "type": "richtext",
      "id": "right_text",
      "label": "Right card text",
      "default": "<h3>Prebiotic Fiber (Inulin &amp; FOS)</h3><p>These plant fibres fuel beneficial gut bacteria and help stabilize post-meal glucose response.</p><h4>What the science says:</h4><ul><li>Increases beneficial bifidobacteria.</li><li>Improves bowel regularity.</li></ul>"
    },
    {
      "type": "color",
      "id": "section_background",
      "label": "Section background",
      "default": "#efefef"
    },
    {
      "type": "color",
      "id": "text_card_background",
      "label": "Text card background",
      "default": "#eeede3"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading color",
      "default": "#111111"
    },
    {
      "type": "color",
      "id": "intro_color",
      "label": "Intro color",
      "default": "#222222"
    },
    {
      "type": "color",
      "id": "title_color",
      "label": "Card title color",
      "default": "#111111"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Card text color",
      "default": "#222222"
    }
  ],
  "presets": [
    {
      "name": "Science behind ingredients"
    }
  ]
}
{% endschema %}
