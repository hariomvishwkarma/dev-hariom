<div id="shop-by-concern-{{ section.id }}" class="shop-by-concern">
  <div class="shop-by-concern__inner">
    {% if section.settings.section_heading != blank %}
      <h2 class="shop-by-concern__heading">{{ section.settings.section_heading | escape }}</h2>
    {% endif %}
    {% if section.settings.section_description != blank %}
      <div class="shop-by-concern__description rte">{{ section.settings.section_description }}</div>
    {% endif %}
    <div class="shop-by-concern__slider-wrap">
      <div class="shop-by-concern__slider swiper" data-shop-by-concern-slider>
        <div class="swiper-wrapper">
          {% for block in section.blocks %}
            {% if block.settings.concern_title != blank or block.settings.image != blank %}
              <div class="swiper-slide shop-by-concern__slide" {{ block.shopify_attributes }}>
                <a
                  class="shop-by-concern__card"
                  href="{% if block.settings.concern_link != blank %}{{ block.settings.concern_link }}{% else %}#{% endif %}"
                >
                  <div class="shop-by-concern__media">
                    {% if block.settings.image != blank %}
                      {{
                        block.settings.image
                        | image_url: width: 900
                        | image_tag:
                          loading: 'lazy',
                          class: 'shop-by-concern__img',
                          widths: '400, 600, 900',
                          sizes: '(max-width: 768px) 46vw, 22vw',
                          alt: block.settings.concern_title | escape
                      }}
                    {% else %}
                      <div class="shop-by-concern__placeholder"></div>
                    {% endif %}
                  </div>
                  <div class="shop-by-concern__footer">
                    <span class="shop-by-concern__card-title">
                      {{- block.settings.concern_title | escape -}}
                    </span>
                    {% if section.settings.show_arrow %}
                      <span class="shop-by-concern__arrow" aria-hidden="true">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                          <path d="M7 17L17 7M17 7H9M17 7V15" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                        </svg>
                      </span>
                    {% endif %}
                  </div>
                </a>
              </div>
            {% endif %}
          {% endfor %}
        </div>
      </div>
    </div>
  </div>
</div>

<style>
  .shop-by-concern__inner {
    max-width: 1337px;
    padding: 0 50px;
    padding-bottom: 40px;
    margin: 0 auto;
  }

  #shop-by-concern-{{ section.id }} {
    padding-top: {{ section.settings.section_padding_top }}px;
    padding-bottom: {{ section.settings.section_padding_bottom }}px;
  }

  #shop-by-concern-{{ section.id }} .shop-by-concern__heading {
    margin: 0 auto 28px;
    text-align: center;
    font-size: 50px;
    font-weight: 700;
    color: #000;
    font-family: optima;
    line-height: 1.2;
  }

  #shop-by-concern-{{ section.id }} .shop-by-concern__description {
    margin: -8px auto 24px;
    text-align: center;
    max-width: 820px;
    font-size: 16px;
    line-height: 1.5;
    color: #444;
  }

  #shop-by-concern-{{ section.id }} .shop-by-concern__description p {
    margin: 0;
  }

  #shop-by-concern-{{ section.id }} .shop-by-concern__slider-wrap {
    margin: 0;
  }

  #shop-by-concern-{{ section.id }} .shop-by-concern__slider.swiper {
    overflow: hidden;
  }

  #shop-by-concern-{{ section.id }} .shop-by-concern__slider .swiper-wrapper {
    align-items: stretch;
  }

  #shop-by-concern-{{ section.id }} .shop-by-concern__slider .swiper-slide {
    height: auto;
    box-sizing: border-box;
  }

  #shop-by-concern-{{ section.id }} .shop-by-concern__slide {
    height: 100%;
  }

  #shop-by-concern-{{ section.id }} .shop-by-concern__card {
    display: flex;
    flex-direction: column;
    height: 100%;
    text-decoration: none;
    color: inherit;
    background: #fff;
    border: {% if section.settings.show_card_border %}1px solid #e0e0e0{% else %}none{% endif %};
    border-radius: 12px;
    padding: {{ section.settings.card_padding }}px;
    box-sizing: border-box;
    transition: box-shadow 0.25s ease;
  }

  #shop-by-concern-{{ section.id }} .shop-by-concern__media {
    border-radius: 10px;
    overflow: hidden;
    aspect-ratio: 16 / 10;
    background: #f4f4f4;
  }

  #shop-by-concern-{{ section.id }} .shop-by-concern__img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  #shop-by-concern-{{ section.id }} .shop-by-concern__placeholder {
    width: 100%;
    height: 100%;
    min-height: 120px;
    background: #ececec;
  }

  #shop-by-concern-{{ section.id }} .shop-by-concern__footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    margin-top: 14px;
    padding-top: 2px;
  }

  #shop-by-concern-{{ section.id }} .shop-by-concern__card-title {
    font-size: 30px;
    font-weight: 700;
    color: #000;
    font-family: 'DM Sans';
    line-height: 1.3;
    text-align: left;
  }
  span.shop-by-concern__arrow svg {
    width: 23px;
    height: 26px;
  }

  #shop-by-concern-{{ section.id }} .shop-by-concern__arrow {
    flex-shrink: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #000;
  }

  #shop-by-concern-{{ section.id }} .shop-by-concern__slider .swiper-button-next,
  #shop-by-concern-{{ section.id }} .shop-by-concern__slider .swiper-button-prev,
  #shop-by-concern-{{ section.id }} .shop-by-concern__slider .swiper-pagination {
    display: none !important;
  }
  .template-page span.shop-by-concern__card-title {
    font-size: 25px !important;
    text-align: center;
    font-family: 'Optima' !important;
  }
  .template-page .shop-by-concern__footer {
    justify-content: center !important;
  }
  @media screen and (max-width: 749px) {
    .shop-by-concern__inner {
      padding: 0 15px;
      padding-bottom: 30px;
    }
    #shop-by-concern-{{ section.id }} .shop-by-concern__heading {
      font-size: 28px;
      margin-bottom: 20px;
    }
    #shop-by-concern-{{ section.id }} .shop-by-concern__description {
      margin: -6px auto 16px;
      font-size: 14px;
    }
    #shop-by-concern-{{ section.id }} .shop-by-concern__card-title {
      font-size: 18px;
    }
    span.shop-by-concern__arrow svg {
      width: 14px;
      height: 16px;
    }
    #shop-by-concern-{{ section.id }} .shop-by-concern__card {
      padding: {{ section.settings.card_padding }}px;
    }
  }
</style>

<script>
  (function () {
    var sectionId = '{{ section.id }}';
    var rootSelector = '#shop-by-concern-' + sectionId;

    function initShopByConcernSwiper() {
      if (typeof Swiper === 'undefined') return;
      var el = document.querySelector(rootSelector + ' [data-shop-by-concern-slider]');
      if (!el) return;
      if (!el.querySelectorAll('.swiper-slide').length) return;
      if (el.swiper) {
        el.swiper.destroy(true, true);
      }
      new Swiper(el, {
        slidesPerView: 1.5,
        spaceBetween: 18,
        watchOverflow: true,
        loop: false,
        speed: 350,
        allowTouchMove: true,
        breakpoints: {
          769: {
            slidesPerView: 3,
            spaceBetween: 20
          },
          1101: {
            slidesPerView: 4,
            spaceBetween: 20
          }
        }
      });
    }

    function onReady() {
      initShopByConcernSwiper();
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', onReady);
    } else {
      onReady();
    }

    document.addEventListener('shopify:section:load', function (e) {
      if (e.detail.sectionId === sectionId) {
        initShopByConcernSwiper();
      }
    });

    document.addEventListener('shopify:section:unload', function (e) {
      if (e.detail.sectionId !== sectionId) return;
      var el = document.querySelector(rootSelector + ' [data-shop-by-concern-slider]');
      if (el && el.swiper) {
        el.swiper.destroy(true, true);
      }
    });
  })();
</script>

{% schema %}
{
  "name": "Shop By Concerns", 
  "max_blocks": 16,
  "settings": [
    {
      "type": "text",
      "id": "section_heading",
      "label": "Section heading",
      "default": "Shop By Concerns"
    },
    {
      "type": "richtext",
      "id": "section_description",
      "label": "Section description"
    },
    {
      "type": "header",
      "content": "Section spacing"
    },
    {
      "type": "range",
      "id": "section_padding_top",
      "label": "Top space",
      "min": 0,
      "max": 120,
      "step": 2,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "section_padding_bottom",
      "label": "Bottom space",
      "min": 0,
      "max": 120,
      "step": 2,
      "unit": "px",
      "default": 0
    },
    {
      "type": "header",
      "content": "Card design"
    },
    {
      "type": "checkbox",
      "id": "show_card_border",
      "label": "Show card border",
      "default": true
    },
    {
      "type": "range",
      "id": "card_padding",
      "label": "Card padding",
      "min": 0,
      "max": 40,
      "step": 1,
      "unit": "px",
      "default": 20
    },
    {
      "type": "checkbox",
      "id": "show_arrow",
      "label": "Show arrow",
      "default": true
    }
  ],
  "blocks": [
    {
      "type": "concern_item",
      "name": "Concern",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "concern_title",
          "label": "Title",
          "default": "Diabetes"
        },
        {
          "type": "url",
          "id": "concern_link",
          "label": "Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Shop By Concerns"
    }
  ]
}
{% endschema %}
