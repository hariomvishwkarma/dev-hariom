<style>
  .login-section {
    text-align: center;
    padding: 40px 20px;
    max-width: 600px;
    margin: 0 auto;
  }
  .login-section h2 {
    margin-bottom: 20px;
    font-size: 24px;
  }
  .kwikpass-login-button {
    margin: 20px 0;
  }
  .kwikpass-login-button button {
    padding: 12px 24px;
    font-size: 16px;
    cursor: pointer;
  }

  .lab-reports {
    display: flex;
    justify-content: center;
    align-items: center;
    flex-direction: column;
    padding: 220px 50px;
    margin: 0 auto;
  }

  .lab-report-container {
    position: relative;
  }
  
  .lab-report-container:before {
    position: absolute;
    content: '';
    width: 100%;
    height: 365px;
    background: #F7F7E7;
    z-index: -1;
    left: 0;
    top: 0;
    border-radius: 0px;
  }

  .lab-reports h3 {
    padding-bottom: 2rem;
    font: Aptos;
    font-size: 3rem;
    text-align: center;
  }

  form#lab-reports-form:before {
      position: absolute;
      content: '';
      width: 100%;
      height: calc(100% - 5px);
      background: #c2dbc5;
      z-index: -1;
      left: 0;
      top: 0;
      border-radius: 40px;
  }

  .lab-reports-form {
    max-width: 650px;
    width: 100%;
    margin-bottom: 2rem;
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    justify-content: space-between;
    padding: 60px 60px;
    background: transparent;
    border-radius: 20px;
    position: relative;
  }

  .lab-reports-form .form-group {
    /* margin-bottom: 5px; */
  }
  
  .form-group {
    width: calc(50% - .5rem);
  }

  .batch-inout-with-button {
    width: 100%;
    position: relative;
  }

  .batch-inout-with-button .form-group {
    width: 100%;
  }
  
  .lab-reports-form label {
    display: block;
    margin-bottom: 5px;
    font-weight: 500;
  }

  .lab-reports-form input {
    width: 100%;
    padding: 12px;
    border: 0px solid #ccc;
    border-radius: 5px;
    box-sizing: border-box;
  }
  
  .submit-button {
    min-width: 70px;
    max-width: fit-content;
    padding: 6.5px 9px;
    border: none;
    border-radius: 5px;
    cursor: pointer;
    background: #3054567a !important;
    color: white;
    font-size: 1.2rem;
    transition: background-color 0.3s;
    position: absolute;
    bottom: 5px;
    right: 5px;
    text-transform: capitalize;
    font-weight: 100;
  }

  .submit-button:hover {
    opacity: .8;
  }

  button.submit-button:hover {
    color: #f1f1f1 !important;
  }
  
  .pdf-container {
    width: 100%;
    max-width: 1200px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 0;
    padding: 20px 0;
  }

  .pdf-wrapper {
    width: 100%;
    border: 1px solid #ddd;
    border-radius: 8px;
    background: #fff;
    overflow: hidden;
  }

  .pdf-label {
    padding: 10px;
    background: #f5f5f5;
    border-bottom: 1px solid #ddd;
    text-align: center;
    font-weight: 500;
    font-size: 1rem;
    color: #333;
  }

  .pdf-content {
    position: relative;
    padding-bottom: 100%; /* Maintain aspect ratio */
    overflow: hidden;
  }

  .pdf-content iframe {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    border: none;
  }

  .pdf-fallback {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    text-align: center;
  }

  .pdf-fallback a {
    color: #2cb67d;
    text-decoration: none;
    font-weight: 500;
  }

  .pdf-fallback a:hover {
    text-decoration: underline;
  }

  .error-message {
    color: red;
    margin-top: 20px;
    text-align: center;
    max-width: 400px;
  }
  .submit-button .loader {
    border: 3px solid #fff;
    border-top: 3px solid #2cb67d;
    border-radius: 50%;
    width: 16px;
    height: 16px;
    animation: spin 0.8s linear infinite;
    margin-left: 10px;
    display: inline-block;
    vertical-align: middle;
  }

  .pdf-tab-wrapper {
    width: 90%;
  }
  
  @keyframes spin {
    0% { transform: rotate(0deg); }
    100% { transform: rotate(360deg); }
  }

  @media (max-width: 768px) {

    .pdf-tab-wrapper {
      width: 100%;
    }
    
    .lab-reports {
      padding: 21px;
    }

    .lab-reports h1 {
      font-size: 1.5rem;
    }

    .pdf-container {
      grid-template-columns: 1fr;
      padding: 10px 0;
    }

    .pdf-content {
      padding-bottom: 150%; /* Adjust for mobile aspect ratio */
    }

    .pdf-label {
      font-size: 0.9rem;
    }
    .form-group {
      width: calc(100% - .5rem);
    }
    .form-group {
        width: calc(100% - .5rem);
    }
    form#lab-reports-form:before {
      position: absolute;
      content: '';
      width: 100%;
      height: calc(100% - 10px);
      background: #c2dbc5;
      z-index: -1;
      left: 0;
      top: 0;
      border-radius: 10px;
    }
    .lab-reports-form {
      padding-left: 3rem;
      padding-right: 3rem;
    }
    .tab-pill {
        width: 100% !important;
    }
  }
  form#lab-reports-form h2 {
    width: 100%;
    text-align: center;
    font-weight:bold;
    font-size:4rem;
    color: #305456;
    font-variant: small-caps;
    margin-top: 0;
    margin-bottom: 7px;
  }

    form#lab-reports-form p {
    width: 100%;
    text-align: center;
    font-size:1.7rem;          
    color: #305456;
    margin-top: 0;
    margin-bottom: 7px;
  }
  
  .tab-pills {
    display: flex;
    justify-content: center;
    gap: 10px;
    margin-bottom: 20px;
    flex-wrap: wrap;
    justify-content: space-between;
  }
  .tab-pill div {
    font-size: 20px;
    font-weight: bold;
  }
  .tab-pill span {
    font-size: 16px !important;
    margin-bottom: 4px;
    padding-left: 10px;
    position: relative;
  }
  .tab-pill span:before {
    position: absolute;
    content: '';
    width: 6px;
    height: 6px;
    background: gray;
    left: 0;
    top: 50%;
    transform: translate(0px, -50%);
    border-radius: 50%;
  }
  .tab-pill {
    cursor: pointer;
    font-weight: 500;
    transition: 0.3s;
    color: grey;
    display: flex;
    flex-direction: column-reverse;
    border-bottom: 1px solid;
    padding-bottom: 1rem;
    width: 25%;
  }
  .tab-pill.active span:before {
    background: #626262;
  }
  .tab-pill.active span {
    color: #222020 !important;
  }
  .tab-pill.active {
    color: black;
  }
  .download-btn {
    display: inline-block;
    margin: 15px auto 0;
    padding: 8px 20px;
    background-color: #2cb67d;
    color: #fff;
    border: none;
    border-radius: 4px;
    font-weight: 500;
    cursor: pointer;
    transition: background-color 0.3s ease;
    text-align: center;
    text-decoration: none;
  }
  
  .download-btn:hover {
    background-color: #239a5f;
  }
  a.download-btn {
    display: none;
  }
</style>
<div class="lab-report-container page-width">
  <div class="lab-reports">
    <form id="lab-reports-form" class="lab-reports-form">
      <h2>{{ page.title }}</h2>
      <p>Please enter your product’s batch number below to access the batch-specific lab reports:</p>
      <div class="form-group">
        <!-- <label for="email">Email</label> -->
        <input
          type="email"
          id="email"
          name="email"
          class="form-input"
          placeholder="Email"
          required
          {% if customer %}value="{{ customer.email }}"{% endif %}
          {% if customer %}disabled{% endif %}
        >
      </div>
      <div class="form-group">
        <!-- <label for="phone">Phone Number (Optional)</label> -->
        <input type="tel" id="phone" class="form-input" name="phone" placeholder="Phone Number (Optional)">
      </div>
      <div class="batch-inout-with-button">
        <div class="form-group">
          <!-- <label for="batch-id">Batch ID</label> -->
          <input type="text" id="batch-id" name="batch-id" class="form-input" required placeholder="Batch ID">
        </div>
        <button type="submit" class="submit-button button button--primary">
          <span class="button-text">Find Lab Reports</span>
          <span class="loader" style="display: none;"></span>
        </button>
      </div>
            <div id="error-message" class="error-message"></div>
    </form>
    <div class="pdf-tab-wrapper">
      <div class="tab-pills" id="pdf-tabs">
        <ul class="nav nav-tabs" id="pdf-tab-pills" role="tablist"></ul>
        <div class="tab-content" id="pdf-tab-content"></div>
      </div>
      <div id="pdf-container" class="pdf-container"></div>
    </div>
  
  </div>
  
</div>
<script>
  const form = document.getElementById('lab-reports-form');
  const pdfContainer = document.getElementById('pdf-container');
  const errorMessage = document.getElementById('error-message');

  form.addEventListener('submit', async (event) => {
  event.preventDefault();

  const submitButton = form.querySelector('.submit-button');
  const buttonText = submitButton.querySelector('.button-text');
  const loader = submitButton.querySelector('.loader');

  // Show loader and disable button
  buttonText.textContent = 'Loading...';
  loader.style.display = 'inline-block';
  submitButton.disabled = true;

  pdfContainer.innerHTML = '';
  errorMessage.textContent = '';

  const batchId = document.getElementById('batch-id').value.trim().toUpperCase();
  const email = document.getElementById('email').value.trim();
  const phone = document.getElementById('phone').value.trim();

// Client-side Validation
const emailPattern = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;

if (!batchId && !email) {
  errorMessage.textContent = 'Batch ID and Email are required.';
} else if (!batchId) {
  errorMessage.textContent = 'Please enter a valid Batch ID.';
} else if (!email) {
  errorMessage.textContent = 'Email is required to proceed.';
} else if (!emailPattern.test(email)) {
  errorMessage.textContent = 'Please enter a valid email address.';
} 
//   else if (!batchId.match(/^[A-Z0-9]+$/)) {
//   errorMessage.textContent = 'Batch ID must be alphanumeric.';
// }

// If there is any error message already set, stop the form
if (errorMessage.textContent) {
  buttonText.textContent = 'Find Lab Reports';
  loader.style.display = 'none';
  submitButton.disabled = false;
  return;
}


  try {
    const response = await fetch(
      `https://reports.bspokewellness.com?data-id=${encodeURIComponent(batchId)}&email=${encodeURIComponent(email)}&phone=${encodeURIComponent(phone)}`
    );

    if (!response.ok) {
      if (response.status === 404) {
        errorMessage.textContent = 'This batch number does not exist. Kindly reverify the batch number.';
        return;
      }
      const errorData = await response.json().catch(() => ({}));
      throw new Error(errorData.error || 'Network response was not ok');
    }

    const data = await response.json();
    const pdfs = [
      { pdf: data.pdf, src: data.pdfSrc, label: 'View Research Reports' },
      { pdf: data.secondPdf, src: data.secondPdfSrc, label: 'View Product Reports' },
      { pdf: data.thirdPdf, src: data.thirdPdfSrc, label: 'View Ingredients Reports' }
    ].filter(pdf => pdf.pdf && pdf.src);

    if (pdfs.length > 0) {
      pdfContainer.innerHTML = '';
      const tabsContainer = document.getElementById('pdf-tabs');
      tabsContainer.innerHTML = '';
    
      pdfs.forEach((pdfData, index) => {
        const tab = document.createElement('div');
        tab.className = 'tab-pill';
        if (index === 0) tab.classList.add('active');
        tab.dataset.index = index;
      
        const mainLabel = document.createElement('div');
        mainLabel.textContent = pdfData.label;
      
        const optionSpan = document.createElement('span');
        optionSpan.style.display = 'block';
        optionSpan.style.fontSize = '0.75rem';
        optionSpan.style.color = '#666';
        optionSpan.textContent = `Option ${index + 1}`;
      
        tab.appendChild(mainLabel);
        tab.appendChild(optionSpan);
      
        tabsContainer.appendChild(tab);
      });

    
      const showPDF = (pdfData) => {
        pdfContainer.innerHTML = '';
      
        const pdfWrapper = document.createElement('div');
        pdfWrapper.className = 'pdf-wrapper';
      
        const labelDiv = document.createElement('div');
        labelDiv.className = 'pdf-label';
        labelDiv.textContent = pdfData.label;
        pdfWrapper.appendChild(labelDiv);
      
        const contentDiv = document.createElement('div');
        contentDiv.className = 'pdf-content';
      
        const iframe = document.createElement('iframe');
        iframe.src = pdfData.src;
        iframe.title = pdfData.label;
        iframe.allow = 'autoplay';
        contentDiv.appendChild(iframe);
        pdfWrapper.appendChild(contentDiv);
      
        // Download Button
        const downloadBtn = document.createElement('a');
        downloadBtn.href = pdfData.src;
        downloadBtn.download = '';
        downloadBtn.target = '_blank';
        downloadBtn.className = 'download-btn';
        downloadBtn.textContent = 'Download PDF';
        pdfWrapper.appendChild(downloadBtn);
      
        pdfContainer.appendChild(pdfWrapper);
      };

    
      // Show first PDF by default
      showPDF(pdfs[0]);
    
      // Handle tab click
      document.querySelectorAll('.tab-pill').forEach(tab => {
        tab.addEventListener('click', () => {
          document.querySelectorAll('.tab-pill').forEach(t => t.classList.remove('active'));
          tab.classList.add('active');
          const selectedIndex = parseInt(tab.dataset.index, 10);
          showPDF(pdfs[selectedIndex]);
        });
      });
    }
 else {
      errorMessage.textContent = 'No valid PDFs found for this Batch ID.';
    }
  } catch (error) {
    console.error('Error fetching data:', error);
    errorMessage.textContent = error.message.includes('No PDFs found')
      ? error.message
      : 'An error occurred while fetching the reports. Please try again.';
  } finally {
    // Hide loader and enable button
    buttonText.textContent = 'Find Lab Reports';
    loader.style.display = 'none';
    submitButton.disabled = false;
  }
});

</script>
{% schema %}
  {
    "name": "Lab reports",
    "settings": [],
    "presets": [
      {
        "name": "Lab reports"
      }
    ]
  }
{% endschema %}
