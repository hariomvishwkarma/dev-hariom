<section
  class="holistiq-product-desc section-{{ section.id }}-padding"
  id="holistiq-product-desc-{{ section.id }}"
  style="background: {{ section.settings.section_background }};"
>
  <div class="holistiq-product-desc__container">
    {% if section.settings.heading != blank %}
      <h2 class="holistiq-product-desc__heading">{{ section.settings.heading }}</h2>
    {% endif %}

    {% if section.blocks.size > 0 %}
      <div class="holistiq-product-desc__tabs" data-holistiq-tabs>
        <div
          class="holistiq-product-desc__nav"
          role="tablist"
          aria-label="{{ section.settings.heading | escape }}"
        >
          {% for block in section.blocks %}
            <button
              type="button"
              class="holistiq-product-desc__tab{% if forloop.first %} is-active{% endif %}"
              role="tab"
              id="tab-{{ section.id }}-{{ block.id }}"
              aria-controls="panel-{{ section.id }}-{{ block.id }}"
              aria-selected="{% if forloop.first %}true{% else %}false{% endif %}"
              data-tab-trigger
              data-tab-index="{{ forloop.index0 }}"
              {{ block.shopify_attributes }}
            >
              {{ block.settings.tab_title | escape }}
            </button>
          {% endfor %}
        </div>

        <div class="holistiq-product-desc__panels">
          {% for block in section.blocks %}
            <div
              class="holistiq-product-desc__panel rte{% if forloop.first %} is-active{% endif %}"
              role="tabpanel"
              id="panel-{{ section.id }}-{{ block.id }}"
              aria-labelledby="tab-{{ section.id }}-{{ block.id }}"
              data-tab-panel
              {% unless forloop.first %}
                hidden
              {% endunless %}
            >
              {{ block.settings.tab_content }}
            </div>
          {% endfor %}
        </div>
      </div>
    {% endif %}
  </div>
</section>

<script>
  (function () {
    var root = document.getElementById('holistiq-product-desc-{{ section.id }}');
    if (!root) return;

    var triggers = root.querySelectorAll('[data-tab-trigger]');
    var panels = root.querySelectorAll('[data-tab-panel]');
    if (!triggers.length || !panels.length) return;

    triggers.forEach(function (trigger, index) {
      trigger.addEventListener('click', function () {
        triggers.forEach(function (tab) {
          tab.classList.remove('is-active');
          tab.setAttribute('aria-selected', 'false');
        });

        panels.forEach(function (panel) {
          panel.classList.remove('is-active');
          panel.hidden = true;
        });

        trigger.classList.add('is-active');
        trigger.setAttribute('aria-selected', 'true');
        panels[index].classList.add('is-active');
        panels[index].hidden = false;
      });
    });
  })();
</script>

{% style %}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top_mobile }}px;
    padding-bottom: {{ section.settings.padding_bottom_mobile }}px;
  }

  @media screen and (min-width: 990px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top_desktop }}px;
      padding-bottom: {{ section.settings.padding_bottom_desktop }}px;
    }
  }

  #holistiq-product-desc-{{ section.id }} .holistiq-product-desc__container {
    max-width: 1042px;
    margin: 0 auto;
    padding-left: 20px;
    padding-right: 20px;
  }

  #holistiq-product-desc-{{ section.id }} .holistiq-product-desc__heading {
    margin: 0 0 25px;
    font-family: Optima, serif;
    font-weight: 700;
    font-style: normal;
    font-size: 28px;
    line-height: 100%;
    letter-spacing: 0;
    text-align: center;
    vertical-align: middle;
    text-transform: capitalize;
    color: {{ section.settings.heading_color }};
  }

  #holistiq-product-desc-{{ section.id }} .holistiq-product-desc__nav {
    display: flex;
    flex-wrap: nowrap;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    -webkit-overflow-scrolling: touch;
    gap: 0;
    margin-bottom: 40px;
    scrollbar-width: none;
  }

  #holistiq-product-desc-{{ section.id }} .holistiq-product-desc__nav::-webkit-scrollbar {
    display: none;
  }

  #holistiq-product-desc-{{ section.id }} .holistiq-product-desc__tab {
    flex: 0 0 auto;
    scroll-snap-align: start;
    scroll-snap-stop: always;
    margin: 0;
    padding: 21px 15px;
    border: none;
    border-bottom: 1.5px solid transparent;
    background: transparent;
    cursor: pointer;
    white-space: nowrap;
    font-family: 'DM Sans', sans-serif;
    font-weight: 900;
    font-style: normal;
    font-size: 18px;
    line-height: 100%;
    letter-spacing: 0;
    vertical-align: middle;
    color: {{ section.settings.tab_inactive_color }};
    transition: color 0.2s ease, border-color 0.2s ease;
  }

  #holistiq-product-desc-{{ section.id }} .holistiq-product-desc__tab.is-active {
    color: {{ section.settings.tab_active_color }};
    border-bottom-color: {{ section.settings.tab_active_color }};
  }

  #holistiq-product-desc-{{ section.id }} .holistiq-product-desc__panel {
    font-family: 'DM Sans', sans-serif;
    font-weight: 500;
    font-style: normal;
    font-size: 15px;
    line-height: 100%;
    letter-spacing: 0;
    vertical-align: middle;
    color: {{ section.settings.tab_content_color }};
  }

  #holistiq-product-desc-{{ section.id }} .holistiq-product-desc__panel p,
  #holistiq-product-desc-{{ section.id }} .holistiq-product-desc__panel li,
  #holistiq-product-desc-{{ section.id }} .holistiq-product-desc__panel ul,
  #holistiq-product-desc-{{ section.id }} .holistiq-product-desc__panel ol {
    font-family: inherit;
    font-weight: inherit;
    font-size: inherit;
    line-height: inherit;
    color: inherit;
  }

  #holistiq-product-desc-{{ section.id }} .holistiq-product-desc__panel p {
    margin: 0 0 10px;
  }

  #holistiq-product-desc-{{ section.id }} .holistiq-product-desc__panel p:last-child {
    margin-bottom: 0;
  }

  #holistiq-product-desc-{{ section.id }} .holistiq-product-desc__panel ul,
  #holistiq-product-desc-{{ section.id }} .holistiq-product-desc__panel ol {
    margin: 0;
    padding-left: 1.2em;
  }

  #holistiq-product-desc-{{ section.id }} .holistiq-product-desc__panel li + li {
    margin-top: 10px;
  }

  @media screen and (min-width: 990px) {
    #holistiq-product-desc-{{ section.id }} .holistiq-product-desc__heading {
      font-size: 50px;
      margin-bottom: 40px;
    }

    #holistiq-product-desc-{{ section.id }} .holistiq-product-desc__nav {
      flex-wrap: wrap;
      justify-content: center;
      overflow-x: visible;
      scroll-snap-type: none;
      gap: 20px;
    }

    #holistiq-product-desc-{{ section.id }} .holistiq-product-desc__tab {
      font-size: 20px;
    }
  }
{% endstyle %}

{% schema %}
{
  "name": "HolistIQ Product Desc",
  "tag": "section",
  "class": "section-holistiq-product-desc",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Section heading",
      "default": "Product Description"
    },
    {
      "type": "color",
      "id": "section_background",
      "label": "Section background",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading color",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "tab_active_color",
      "label": "Active tab color",
      "default": "#12723b"
    },
    {
      "type": "color",
      "id": "tab_inactive_color",
      "label": "Inactive tab color",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "tab_content_color",
      "label": "Tab content color",
      "default": "#000000"
    },
    {
      "type": "header",
      "content": "Section padding"
    },
    {
      "type": "range",
      "id": "padding_top_desktop",
      "label": "Desktop top padding",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 60
    },
    {
      "type": "range",
      "id": "padding_bottom_desktop",
      "label": "Desktop bottom padding",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 60
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "label": "Mobile top padding",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "label": "Mobile bottom padding",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 40
    }
  ],
  "blocks": [
    {
      "type": "holistiq_desc_tab",
      "name": "Tab",
      "settings": [
        {
          "type": "text",
          "id": "tab_title",
          "label": "Tab heading",
          "default": "Product Details"
        },
        {
          "type": "richtext",
          "id": "tab_content",
          "label": "Tab content",
          "default": "<ul><li>Add tab content here.</li></ul>"
        }
      ]
    }
  ],
  "max_blocks": 8,
  "presets": [
    {
      "name": "HolistIQ Product Desc",
      "blocks": [
        {
          "type": "holistiq_desc_tab",
          "settings": {
            "tab_title": "Product Details",
