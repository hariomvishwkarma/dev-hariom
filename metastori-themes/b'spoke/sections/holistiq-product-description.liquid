          }
        },
        {
          "type": "holistiq_desc_tab",
          "settings": {
            "tab_title": "Who is it for ?",
            "tab_content": "<p>Add content for who this product is for.</p>"
          }
        },
        {
          "type": "holistiq_desc_tab",
          "settings": {
            "tab_title": "How to use ?",
            "tab_content": "<p>Add how-to-use instructions here.</p>"
          }
        },
        {
          "type": "holistiq_desc_tab",
          "settings": {
            "tab_title": "Ingredients (Per Serve)",
            "tab_content": "<p>Add ingredients per serve here.</p>"
          }
        },
        {
          "type": "holistiq_desc_tab",
          "settings": {
