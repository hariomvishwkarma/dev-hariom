<div class="statistics-section" style="background-color: {{ settings.background_color }}; padding: 20px; text-align: center;">
  <div class="sta-container swiper">
    <div class="swiper-wrapper">
      {% for block in section.blocks %}
      <div class="statistic-item swiper-slide">
        <div class="grand-static-item">
          <h2 class="h1">{{ block.settings.title }}</h2>
          <p>{{ block.settings.description }}</p>
        </div>
      </div>
      {% endfor %}
    </div>
    <!-- Slider Pagination -->
    <div class="swiper-pagination"></div>
  </div>
</div>

{% schema %}
{
  "name": "Statistics",
  "class": "custom-statistics-section",
  "settings": [],
  "blocks": [
    {
      "type": "statistic",
      "name": "Statistic",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "100%"
        },
        {
          "type": "text",
          "id": "description",
          "label": "Description",
          "default": "would use again and recommend to a friend"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Statistics Section"
    }
  ]
}
{% endschema %}

<style>
  .statistics-section {
    background-color: #F7F1B5;
  }

  .sta-container {
    display: flex;
    justify-content: center;
    flex-wrap: nowrap; /* Prevent wrapping for slider effect */
    overflow: hidden;
  }

  .grand-static-item p {
   font-family: 'suisse-intl-regular';
    max-width: 247px;
    text-align: left;
    font-size: 16px;
    font-weight: 500;
    line-height: 22px;
  }
.grand-static-item {
    display: flex;
    justify-content: center;
    /* text-align: center; */
    align-items: center;
    gap: 20px;
}
  /* Swiper Pagination */
  .swiper-pagination {
    margin-top: 10px;
    text-align: center;
  }
.swiper-horizontal>.swiper-pagination-bullets, .swiper-pagination-bullets.swiper-pagination-horizontal, .swiper-pagination-custom, .swiper-pagination-fraction {
    bottom: var(--swiper-pagination-bottom,-8px) !important;
}
.swiper-pagination-bullet {
    width: var(--swiper-pagination-bullet-width,var(--swiper-pagination-bullet-size,8px));
    height: var(--swiper-pagination-bullet-height,var(--swiper-pagination-bullet-size,8px));
    display: inline-block;
    border-radius: var(--swiper-pagination-bullet-border-radius,50%);
    background: var(--swiper-pagination-bullet-inactive-color,#000);
    opacity: var(--swiper-pagination-bullet-inactive-opacity, .2);
}
.sta-container.swiper {
    max-width: 1200px;
    width: 100%;
    margin: 0 auto;
}
 /* Responsive */
  @media (min-width: 768px) {
    .sta-container {
      flex-wrap: wrap; /* Allow items to wrap on desktop */
      overflow: visible;
    }

    .swiper-wrapper {
      display: flex !important;
    }

    .statistics-section .swiper-slide {
      flex: 0 1 auto !important;
    }
    .swiper-horizontal>.swiper-pagination-bullets, .swiper-pagination-bullets.swiper-pagination-horizontal, .swiper-pagination-custom, .swiper-pagination-fraction {
    bottom: var(--swiper-pagination-bottom,-5px) !important;
    top: var(--swiper-pagination-top,auto);
    left: 0;
    width: 100%;
}
  }
</style>


<script>
  document.addEventListener("DOMContentLoaded", function () {
    // Check if screen width is mobile size
    if (window.innerWidth < 768) {
      new Swiper('.sta-container', {
        slidesPerView: 1,
        spaceBetween: 20,
        pagination: {
          el: '.swiper-pagination',
          clickable: true,
        },
        autoplay: {
          delay: 3000,
        },
      });
    }
  });
</script>
