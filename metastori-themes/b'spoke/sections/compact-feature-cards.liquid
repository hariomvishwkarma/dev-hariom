<section class="compact-feature-cards" id="compact-feature-cards-{{ section.id }}">
  <div class="compact-feature-cards__container">
    {% if section.settings.heading != blank %}
      <h2 class="compact-feature-cards__heading">{{ section.settings.heading | escape }}</h2>
    {% endif %}

    <div class="compact-feature-cards__grid">
      {% for block in section.blocks %}
        <article class="compact-feature-card" {{ block.shopify_attributes }}>
          {% if block.settings.icon != blank %}
            <div class="compact-feature-card__icon-wrap">
              {{
                block.settings.icon
                | image_url: width: 80
                | image_tag:
                  class: 'compact-feature-card__icon',
                  loading: 'lazy',
                  widths: '40, 60, 80',
                  sizes: '40px',
                  alt: block.settings.title | escape
              }}
            </div>
          {% endif %}

          <div class="compact-feature-card__content">
            {% if block.settings.title != blank %}
              <h3 class="compact-feature-card__title">{{ block.settings.title | escape }}</h3>
            {% endif %}

            {% if block.settings.description != blank %}
              <div class="compact-feature-card__description">{{ block.settings.description }}</div>
            {% endif %}
          </div>
        </article>
      {% endfor %}
    </div>
  </div>
</section>

{% style %}
  .template-page main#MainContent {
    padding-bottom: 0;
  }
  #compact-feature-cards-{{ section.id }} {
    background: {{ section.settings.section_background }};
  }

  #compact-feature-cards-{{ section.id }} .compact-feature-cards__container {
    max-width: 1270px;
    margin: 0 auto;
    padding: 40px 20px 40px;
  }

  #compact-feature-cards-{{ section.id }} .compact-feature-cards__heading {
    margin: 0 0 40px;
    text-align: center;
    font-family: Optima, serif;
    font-size: 50px;
    font-weight: 700;
    line-height: 1;
    color: {{ section.settings.heading_color }};
  }

  #compact-feature-cards-{{ section.id }} .compact-feature-cards__grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 12px;
  }

  #compact-feature-cards-{{ section.id }} .compact-feature-card {
    border: 1px solid {{ section.settings.card_border_color }};
    border-radius: 8px;
    background: {{ section.settings.card_background }};
    padding: 20px;
    display: flex;
    align-items: flex-start;
    gap: 12px;
  }

  #compact-feature-cards-{{ section.id }} .compact-feature-card__icon {
    width: 55px;
    min-width: 55px;
    height: 55px;
    object-fit: contain;
    display: block;
  }

  #compact-feature-cards-{{ section.id }} .compact-feature-card__title {
    margin: 0 0 6px;
    font-family: 'DM Sans', sans-serif;
    font-size: 25px;
    font-weight: 700;
    line-height: 1.1;
    color: {{ section.settings.title_color }};
  }

  #compact-feature-cards-{{ section.id }} .compact-feature-card__description {
    margin: 0;
    font-family: 'DM Sans', sans-serif;
    font-size: 15px;
    font-weight: 500;
    line-height: 1.25;
    color: {{ section.settings.text_color }};
  }

  #compact-feature-cards-{{ section.id }} .compact-feature-card__description p {
    margin: 0;
  }

  @media (max-width: 900px) {
    #compact-feature-cards-{{ section.id }} .compact-feature-cards__grid {
      grid-template-columns: 1fr;
      display: flex;
      overflow-x: scroll;
    }
    #compact-feature-cards-{{ section.id }} .compact-feature-card {
      min-width: 90%;
    }
  }

  @media (max-width: 767px) {
    #compact-feature-cards-{{ section.id }} .compact-feature-cards__container {
      padding: 8px 16px 16px;
    }

    #compact-feature-cards-{{ section.id }} .compact-feature-cards__heading {
      font-size: 28px;
      margin-bottom: 25px;
    }

    #compact-feature-cards-{{ section.id }} .compact-feature-card__title {
      font-size: 20px;
    }

    #compact-feature-cards-{{ section.id }} .compact-feature-card__description {
      font-size: 14px;
    }
  }
{% endstyle %}

{% schema %}
{
  "name": "Compact feature cards",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Section heading"
    },
    {
      "type": "color",
      "id": "section_background",
      "label": "Section background",
      "default": "#f0f0f0"
    },
    {
      "type": "color",
      "id": "card_background",
      "label": "Card background",
      "default": "#f0f0f0"
    },
    {
      "type": "color",
      "id": "card_border_color",
      "label": "Card border color",
      "default": "#d9d9d9"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading color",
      "default": "#111111"
    },
    {
      "type": "color",
      "id": "title_color",
      "label": "Title color",
      "default": "#111111"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#222222"
    }
  ],
  "blocks": [
    {
      "type": "feature",
      "name": "Feature",
      "settings": [
        {
          "type": "image_picker",
          "id": "icon",
          "label": "Icon"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "High Tech Formula"
        },
        {
          "type": "richtext",
          "id": "description",
          "label": "Description",
          "default": "<p>Formulated with evidence-based ingredients designed to address health concerns effectively.</p>"
        }
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [
    {
      "name": "Compact feature cards",
      "blocks": [
        { "type": "feature" },
        { "type": "feature" },
        { "type": "feature" }
      ]
    }
  ]
}
{% endschema %}
