<style>

.hero-slider .swiper-slide {
    width: 100%;
    flex-shrink: 0;
    display: none;
    position: relative;
}
.hero-slider .swiper-slide:first-child {
    display: block;
}
.hero-slider.swiper-initialized .swiper-slide {
    display: block;
}

.hero-banner-pagination .swiper-pagination-bullet {
    background: #12723B;
    opacity: 30%;
}
.hero-banner-pagination .swiper-pagination-bullet-active{
    background: #12723B;
    opacity:1;
}
.hero-image-item {
    display: flex;
    height: 100%;
}
.hero-slide-button {
    position: absolute;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    z-index: 2;
    text-decoration: none;
    white-space: nowrap;
}
.hero-image-item img {
    object-fit:cover;
    width:100%;
    height: 100%;
}
.hero-slider .swiper-slide {
    height: -webkit-fill-available;
}

@media (min-width:768px){
    img.hero-mobile-image{
        display:none;
    }
    .swiper-pagination-bullets.swiper-pagination-horizontal.hero-banner-pagination {
        top: unset;
        bottom: 27px !important;
    }
    .hero-banner-pagination .swiper-pagination-bullet {
        width: 22px;
        height: 22px;
        margin: 0 5.5px !important;
    }
}
@media (max-width:767px){
    {% for block in section.blocks %}
        {% if block.settings.image_m != blank %}
            img.desktop-{{ block.id }}{
                display:none;
            }
            img.mobile-{{ block.id }}{
                display:block;
            }
        {% endif %}
    {% endfor %}
    .swiper-pagination-bullets.swiper-pagination-horizontal.hero-banner-pagination {
        top: unset;
        bottom: 14px !important;
    }
    .hero-banner-pagination .swiper-pagination-bullet{
        width: 17.63px;
        height: 17.63px;
        margin: 0 4px !important;
    }
}
{% for block in section.blocks %}
    .hero-slide-button-{{ block.id }}{
        top: {{ block.settings.button_top }}%;
        left: {{ block.settings.button_left }}%;
        max-width: fit-content;
        border-radius: 9.03px;
        padding: 16.92px !important;
        background: #12723B;
        font-family: DM Sans;
        font-weight: Bold;
        font-size: 20px;
        color: #fff;
        text-transform: capitalize;
        border: none;
    }
{% endfor %}
@media (max-width:767px){
    {% for block in section.blocks %}
        .hero-slide-button-{{ block.id }}{
            top: {{ block.settings.button_top_mobile }}%;
            left: {{ block.settings.button_left_mobile }}%;
            transform: translateX(-50%);
            font-size: 19px;
            min-width: 110px !important;
        }
    {% endfor %}
}
</style>

<div class="hero-slider-main">
    <div class="hero-slider swiper hero-slider-{{ section.id }}">
        <div class="swiper-wrapper">
            {% for block in section.blocks %}
                <div class="swiper-slide">
                    <div class="hero-image-item">
                        
                        {% assign image = block.settings.image %}
                        {% assign image_mobile = block.settings.image_m %}
                        {% assign desktop_class = 'hero-desktop-image' | append:' desktop-' | append:block.id %}
                        {% assign mobile_class = 'hero-mobile-image' | append:' mobile-' | append:block.id %}

                        {{ image | image_url: width: 5000 | image_tag: class: desktop_class, height: 'auto', sizes: "100vw", widths: '375, 550, 2000, 3000, 5000' }}
                        {% if image_mobile != blank %}
                            {{ image_mobile | image_url: width: 750 | image_tag: class: mobile_class, height: 'auto', sizes: "100vw", widths: '375, 550, 750' }}
                        {% endif %}
                    </div>
                    {% if block.settings.button_text != blank and block.settings.link != blank %}
                        <a href="{{ block.settings.link }}" class="hero-slide-button button hero-slide-button-{{ block.id }}">
                            {{ block.settings.button_text }}
                        </a>
                    {% endif %}
                </div>
            {% endfor %}
        </div>
        <div class="swiper-pagination hero-banner-pagination"></div>
    </div>
</div>

<script>
document.addEventListener('DOMContentLoaded', function () {

  var el = document.querySelector(".hero-slider-{{ section.id }}");
  if (!el || typeof Swiper === "undefined") return;

  new Swiper(el, {
    loop: true,
    speed: 600,
    pagination: {
      el: el.querySelector(".hero-banner-pagination"),
      clickable: true
    }
  });

});
</script>

{% schema %}
{
  "name": "Hero Slider",
  "class": "spaced-section",
  "tag": "section",
  "settings": [],
  "blocks": [
        {
            "type":"slide",
            "name":"Slide",
            "settings":[
                {
                    "type":"image_picker",
                    "id":"image",
                    "label":"Image"
                },
                {
                    "type":"image_picker",
                    "id":"image_m",
                    "label":"Image (Mobile)",
                    "info":"Optional"
                },
                {
                    "type":"url",
                    "id":"link",
                    "label":"Button Link"
                },
                {
                    "type":"text",
                    "id":"button_text",
                    "label":"Button Text",
                    "default":"Shop now"
                },
                {
                    "type":"range",
                    "id":"button_top",
                    "label":"Button Top Position (Desktop %)",
                    "min": 0,
                    "max": 100,
                    "step": 1,
                    "default": 50
                },
                {
                    "type":"range",
                    "id":"button_left",
                    "label":"Button Left Position (Desktop %)",
                    "min": 0,
                    "max": 100,
                    "step": 1,
                    "default": 50
                },
                {
                    "type":"range",
                    "id":"button_top_mobile",
                    "label":"Button Top Position (Mobile %)",
                    "min": 0,
                    "max": 100,
                    "step": 1,
                    "default": 50
                },
                {
                    "type":"range",
                    "id":"button_left_mobile",
                    "label":"Button Left Position (Mobile %)",
                    "min": 0,
                    "max": 100,
                    "step": 1,
                    "default": 50
                }
            ]
        }
    ],
  "presets": [{
    "name": "Hero Slider"
  }]
}
{% endschema %}
