<!-- HTML Markup -->
<div class="shop-by-category-wr shop-by-concerns-section">
  <div class="category_container container-1320">
    <div class="heading_with_arrows">
      <h2 class="section-heading">{{ section.settings.section_heading }}</h2>
      <div class="slider-controlsss">
        <div class="arrows_swiper">
          <span class="prev-arrow swiper-button-prev">{% render 'slick-left-icon' %}</span>
          <span class="next-arrow swiper-button-next">{% render 'slick-right-icon' %}</span>
        </div>
      </div>
    </div>
    <div class="category-slider swiper">
      <div class="swiper-wrapper">
        {% for category in shop.metaobjects.product_categories.values %}
          {% assign category_name = category.category_name %}
          {% assign category_image = category.category_image %}
          {% assign category_gid = category.gid_for_filter_ | strip %}
          {%- assign widths = '100, 165, 360, 535, 750, 1070, 1500' -%}
          {%- assign height = category_image.width | divided_by: category_image.aspect_ratio | round -%}
          <a
            href="/collections/all?filter.p.m.custom.product_categories_new=gid%3A%2F%2Fshopify%2FMetaobject%2F{{ category_gid }}&filter.v.price.gte=&filter.v.price.lte=&filter.v.price.gte=&filter.v.price.lte=&sort_by=title-ascending"
            class="swiper-slide category-item"
          >
            <div class="category_main">
              <div class="category_image">
                {{
                  category_image
                  | image_url: width: 1000, height: height
                  | image_tag: widths: widths
                }}
              </div>
              <h3 class="category_name">{{ category_name }}</h3>
            </div>
          </a>
        {% endfor %}
        
      </div>
    </div>
    <div class="slider-controlsss container-1320 slider-control-mobile">
      <div class="swiper-pagination-1"> </div>
      <div class="arrows_swiper">
        <span class="prev-arrow swiper-button-prev">{% render 'slick-left-icon' %}</span>
        <span class="next-arrow swiper-button-next">{% render 'slick-right-icon' %}</span>
      </div>
    </div>
  </div>
</div>
<script>
  document.addEventListener("DOMContentLoaded", function() {
    var swiper = new Swiper(".category-slider", {
      spaceBetween: 25,
      loop: true,
      loopAdditionalSlides: 5,
      navigation: {
        nextEl: ".shop-by-category-wr .swiper-button-next",
        prevEl: ".shop-by-category-wr .swiper-button-prev",
      },
      breakpoints: {
        1199: { slidesPerView: 4 }, // Desktop: Normal layout (no rows)
        768: {
          slidesPerView: 3,
          spaceBetween: 20
        },
        320: {
          slidesPerView: 2,
          grid: { rows: 2, fill: "row" },
          spaceBetween: 13,
          loop: false,
          pagination: {
            el: ".category_container .swiper-pagination-1",
            type: "progressbar",
          },
          autoplay: false
        }
      }
    });
  });
</script>
<!-- CSS -->
<style>
  .category-slider {
    display: none;
  }
  .category-slider.swiper.swiper-initialized {
    display: block;
  }
  .shop-by-concerns-section {
    text-align: left;
    padding: 0px;
  margin: 30px auto;
    position: relative;
  }
  a.swiper-slide.category-item {
    width: 25%;
  }
  .section-heading {
    font-size: 30px;
    margin-bottom: 25px;
  text-align: left;
  }
  .shop-by-concerns-section .swiper-wrapper {
      padding: 3px 0;
  }
  

  .slider-controlsss .slick-arrow {
      position: unset !important;
      transform: none !important;
      background: #353626;
      border-color: #353626 !important;
      color: #fff !important;
  width: 30px !important; height: 30px !important;
  }

      .slick-arrow svg{
          max-width: 100%;
          max-height: 100%;
         color: #fff !important;
          fill:  #fff !important;
          stroke: #fff !important;
  stroke-width: 2px;
      }
      .slick-arrow svg path {  fill:  #fff !important; }


  .category-slider .slick-slide {
    display: flex;
    justify-content: center;
    min-height: 83px;
    padding:16px 9px;
  }
   .shop-by-concerns-section .swiper-button-next:after,.shop-by-concerns-section .swiper-button-prev:after{
      display: none;
    }
    .arrows_swiper {
      display: flex;
      justify-content: center;
      gap: 12px;
  }

  .arrows_swiper span {
      position: relative;
      height: 35px !important;
      width: 35px !important;
      left: unset;
      transform: unset;
      right: unset;
      display: flex;
      top: unset;
      background: #52543C;
      align-items: center;
      margin: 0;
      border-radius: 50%;
  }

  .arrows_swiper span svg {
      height: 13px;
      fill: #fff;
  }
  .slider-controlsss {
      display: flex;
      justify-content: flex-end;
      align-items: center;
      gap: 15px;
      margin-top: 24px;
  }
    .swiper-pagination-1.swiper-pagination-progressbar {
      position: relative;
      background: #f7f7f7;
      border-radius: 5px;
      height: 2px;
    }
    .swiper-pagination-1.swiper-pagination-progressbar .swiper-pagination-progressbar-fill {
      background: #000;
      border-radius: 5px;
    }
    .heading_with_arrows {
      display: flex;
      align-items: center;
      justify-content: space-between;
      margin-bottom: 28px;
    }

    .heading_with_arrows h2.section-heading {
        margin: 0;
    }
    .slider-controlsss.container-1320.slider-control-mobile {
      display: none;
    }
    .shop-by-concerns-section .swiper-button-next.swiper-button-disabled,
    .shop-by-concerns-section .swiper-button-prev.swiper-button-disabled {
      opacity: 1;
    }
  .category_image {
    position: relative;
    padding-top: 100%;
}

.category_image img {
    position: absolute;
    top: 0;
    left: 0;
    object-fit: cover;
    width: 100%;
    height: 100%;
    border-radius: 12px;
}

.category_name {
    margin-top: 15px;
    display: block;
    font-size: 20px !important;!I;!;
    line-height: 1.2;
    text-decoration: underline;
    text-align: center;
}
  @media (max-width: 768px){
    .category-slider.swiper {
      padding: 0 12px !important;
    }
    .heading_with_arrows .slider-controlsss {
      display: none;
    }
    .slider-controlsss.container-1320.slider-control-mobile {
      display: flex;
    }
    .heading_with_arrows h2.section-heading {
      font-size: 28px;
    }
    .arrows_swiper span {
      height: 28px !important;
      width: 28px !important;
    }
    .category_name {
      font-size: 16px !important;
    }
  }
</style>

{% schema %}
{
  "name": "Shop By Category(Auto)",
  "settings": [
    {
      "type": "text",
      "id": "section_heading",
      "label": "Section Heading",
      "default": "Shop By Category"
    },
  {
      "type": "color",
      "id": "section_color_even",
      "label": "Color for Even Block"
    },
 {
      "type": "color",
      "id": "section_color_odd",
      "label": "Color for Odd Block"
    }
  ],
  "presets": [
    {
      "name": "Shop By Category(Auto)"
    }
  ]
}
{% endschema %}
