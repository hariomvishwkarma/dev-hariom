<section class="our-philosophy-section" id="our-philosophy-{{ section.id }}">
  {% if section.settings.heading != blank %}
    <h2 class="our-philosophy-section__heading">{{ section.settings.heading | escape }}</h2>
  {% endif %}
  <div class="our-philosophy-section__container">
    <div class="our-philosophy-section__grid">
      {% for block in section.blocks %}
        <article class="our-philosophy-card" {{ block.shopify_attributes }}>
          {% if block.settings.image != blank %}
            <div class="our-philosophy-card__image-wrap">
              {{
                block.settings.image
                | image_url: width: 900
                | image_tag:
                  class: 'our-philosophy-card__image',
                  loading: 'lazy',
                  widths: '360, 540, 720, 900',
                  sizes: '(max-width: 768px) 100vw, 50vw',
                  alt: block.settings.name | escape
              }}
            </div>
          {% endif %}

          {% if block.settings.name != blank %}
            <h3 class="our-philosophy-card__name">{{ block.settings.name | escape }}</h3>
          {% endif %}

          {% if block.settings.role != blank %}
            <p class="our-philosophy-card__role">{{ block.settings.role | escape }}</p>
          {% endif %}

          {% if block.settings.description != blank %}
            <div class="our-philosophy-card__description">{{ block.settings.description }}</div>
          {% endif %}
        </article>
      {% endfor %}
    </div>
  </div>
</section>

{% style %}
  #our-philosophy-{{ section.id }} {
    background: {{ section.settings.section_background }};
  }

  #our-philosophy-{{ section.id }} .our-philosophy-section__container {
    max-width: 1270px;
    margin: 0 auto;
    padding: 30px 24px 40px;
    padding-top: 0;
  }

  #our-philosophy-{{ section.id }} .our-philosophy-section__heading {
    margin: 0 0 40px;
    text-align: center;
    font-family: Optima, serif;
    font-weight: 700;
    font-size: 50px;
    line-height: 1;
    color: {{ section.settings.heading_color }};
  }

  #our-philosophy-{{ section.id }} .our-philosophy-section__grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 18px;
  }

  #our-philosophy-{{ section.id }} .our-philosophy-card {
    background: {{ section.settings.card_background }};
    border-radius: 12px;
    padding: 18px;
    box-shadow: 0px 0px 20px 0px #12723B1A;
  }

  #our-philosophy-{{ section.id }} .our-philosophy-card__image-wrap {
    border-radius: 12px;
    overflow: hidden;
    margin-bottom: 16px;
  }

  #our-philosophy-{{ section.id }} .our-philosophy-card__image {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    border-radius: 12px;
  }

  #our-philosophy-{{ section.id }} .our-philosophy-card__name {
    margin: 0 0 8px;
    font-family: 'DM Sans', sans-serif;
    font-weight: 700;
    font-size: 30px;
    line-height: 1;
    color: {{ section.settings.name_color }};
  }

  #our-philosophy-{{ section.id }} .our-philosophy-card__role {
    margin: 0 0 14px;
    font-family: 'DM Sans', sans-serif;
    font-weight: 500;
    font-size: 15px;
    line-height: 1;
    color: {{ section.settings.role_color }};
  }

  #our-philosophy-{{ section.id }} .our-philosophy-card__description {
    margin: 0;
    font-family: 'DM Sans', sans-serif;
    font-weight: 500;
    font-size: 15px;
    line-height: 1;
    color: {{ section.settings.description_color }};
    text-align: justify;
  }

  #our-philosophy-{{ section.id }} .our-philosophy-card__description p {
    margin: 0;
  }

  #our-philosophy-{{ section.id }} .our-philosophy-card__description p + p {
    margin-top: 10px;
  }

  @media (max-width: 990px) {
    #our-philosophy-{{ section.id }} .our-philosophy-section__heading {
      font-size: 40px;
      margin-bottom: 26px;
    }

    #our-philosophy-{{ section.id }} .our-philosophy-card__name {
      font-size: 26px;
    }
  }

  @media (max-width: 767px) {
    #our-philosophy-{{ section.id }} .our-philosophy-section__container {
      padding: 26px 16px 32px;
      padding-top:0;
      overflow-x: scroll;
    }

    #our-philosophy-{{ section.id }} .our-philosophy-section__heading {
      font-family: Optima, serif;
      font-size: 28px;
      margin-bottom: 25px;
    }

    #our-philosophy-{{ section.id }} .our-philosophy-section__grid {
      grid-template-columns: 1fr;
      gap: 14px;
      display: flex;
    }

    #our-philosophy-{{ section.id }} .our-philosophy-card {
      padding: 14px;
      min-width: 90%;
    }

    #our-philosophy-{{ section.id }} .our-philosophy-card__name {
      font-size: 24px;
    }
  }
{% endstyle %}

{% schema %}
{
  "name": "Our philosophy",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Section heading",
      "default": "Our Philosophy"
    },
    {
      "type": "color",
      "id": "section_background",
      "label": "Section background",
      "default": "#f1f1f1"
    },
    {
      "type": "color",
      "id": "card_background",
      "label": "Card background",
      "default": "#f4f4f4"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading color",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "name_color",
      "label": "Name color",
      "default": "#111111"
    },
    {
      "type": "color",
      "id": "role_color",
      "label": "Role color",
      "default": "#222222"
    },
    {
      "type": "color",
      "id": "description_color",
      "label": "Description color",
      "default": "#202020"
    }
  ],
  "blocks": [
    {
      "type": "person",
      "name": "Person",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "name",
          "label": "Name",
          "default": "Person name"
        },
        {
          "type": "text",
          "id": "role",
          "label": "Role",
          "default": "Founders"
        },
        {
          "type": "richtext",
          "id": "description",
          "label": "Description",
          "default": "<p>Add a short profile description for this person.</p>"
        }
      ]
    }
  ],
  "max_blocks": 12,
  "presets": [
    {
      "name": "Our philosophy",
      "blocks": [
        {
          "type": "person"
        },
        {
          "type": "person"
        }
      ]
    }
  ]
}
{% endschema %}
