{%- liquid
  assign mf = product.metafields.custom.product_benefits_metaobject_base
  assign items = mf.value
  if mf == blank
    assign items = blank
  endif
-%}

{% if items != blank %}
  <section
    id="tabs-section-{{ section.id }}"
    class="section-{{ section.id }}-padding ingredients-tabs-section"
  >
    <style>
      .section-{{ section.id }}-padding {
        padding-top: {{ section.settings.padding_top_mobile }}px;
        padding-bottom: {{ section.settings.padding_bottom_mobile }}px;
        background-color: {{ section.settings.bg_color }};
      }
      @media screen and (min-width: 990px) {
        .section-{{ section.id }}-padding {
          padding-top: {{ section.settings.padding_top_desktop }}px;
          padding-bottom: {{ section.settings.padding_bottom_desktop }}px;
        }
      }
      .ingredients-tabs-section .ingredients-tabs__inner {
        max-width: 100%;
      }
      .ingredients-tabs-section .ingredients-tabs__header {
        text-align: center;
        margin-bottom: 32px;
      }
      .ingredients-tabs-section .ingredients-tabs__heading {
        font-size: 24px;
        line-height: 1.3;
        font-weight: 600;
        margin: 0 0 12px;
      }
      .ingredients-tabs-section .ingredients-tabs__subheading {
        max-width: 760px;
        margin: 0 auto;
        font-size: 14px;
        line-height: 1.6;
      }
      .ingredients-tabs-section .ingredients-tabs__nav-wrap {
        background-color: {{ section.settings.nav_bg_color }};
        margin-top: 0;
        margin-bottom: 32px;
      }
      .ingredients-tabs-section .ingredients-tabs__nav {
        display: flex;
        flex-wrap: wrap;
        justify-content: center;
        gap: 15px 20px;
        padding: 18px 24px;
        list-style: none;
        margin: 0;
      }
      .ingredients-tabs-section .ingredients-tabs__nav-item {
        display: flex;
        align-items: center;
      }
      .ingredients-tabs-section .ingredients-tabs__nav-button {
        position: relative;
        background: transparent;
        border: 0;
        padding: 0 0 4px;
        cursor: pointer;
        font-size: 15px;
        line-height: 1.2;
        letter-spacing: 0.03em;
        text-transform: none;
        color: {{ section.settings.nav_text_color }};
        outline: none;
      }
      .ingredients-tabs-section .ingredients-tabs__nav-button::after {
        content: "";
        position: absolute;
        left: 0;
        bottom: 0;
        width: 0;
        height: 2px;
        background-color: transparent;
        transition: width 0.25s ease;
      }
      .ingredients-tabs-section .ingredients-tabs__nav-item.is-active .ingredients-tabs__nav-button {
        color: {{ section.settings.nav_active_text_color }};
      }
      .ingredients-tabs-section .ingredients-tabs__nav-item.is-active .ingredients-tabs__nav-button::after {
        width: 100%;
        background-color: {{ section.settings.nav_underline_color }};
      }
      .ingredients-tabs-section .ingredients-tabs__slider {
        position: relative;
      }
      .ingredients-tabs-section .ingredients-tabs__slide {
        text-align: center;
      }
      .ingredients-tabs-section .ingredients-tabs__image-wrap {
        display: inline-block;
        width: 100%;
      }
      .ingredients-tabs-section .ingredients-tabs__image {
        width: 100%;
        height: auto;
        display: block;
        margin: 0 auto;
      }
      .enable_button_disable_arrows .ingredients-tabs-section .ingredients-tabs__arrow {
        position: absolute;
        top: 50%;
        transform: translateY(-50%);
        width: 40px;
        height: 40px;
        border-radius: 50%;
        border: 1px solid #000;
        background: transparent;
        cursor: pointer;
        display: flex !important;
        align-items: center;
        justify-content: center;
        z-index: 2;
      }
      .ingredients-tabs-section .ingredients-tabs__arrow--prev {
        left: 8px;
      }
      .ingredients-tabs-section .ingredients-tabs__arrow--next {
        right: 8px;
      }
      .ingredients-tabs-section .ingredients-tabs__arrow-icon {
        width: 10px;
        height: 10px;
        border-top: 1px solid #000;
        border-right: 1px solid #000;
      }
      .ingredients-tabs-section .ingredients-tabs__arrow--prev .ingredients-tabs__arrow-icon {
        transform: rotate(-135deg);
        position: absolute;
        left: 16px;
      }
      .ingredients-tabs-section .ingredients-tabs__arrow--next .ingredients-tabs__arrow-icon {
        transform: rotate(45deg);
        right: 16px;
        position: absolute;
      }
      @media screen and (min-width: 990px) {
        .ingredients-tabs-section .ingredients-tabs__heading {
          font-size: 32px;
        }
        .ingredients-tabs-section .ingredients-tabs__nav {
          justify-content: center;
          padding-left: 40px;
          padding-right: 40px;
        }
        .ingredients-tabs-section .ingredients-tabs__arrow--prev {
          left: 32px;
        }
        .ingredients-tabs-section .ingredients-tabs__arrow--next {
          right: 32px;
        }
        .ingredients-tabs-section .ingredients-tabs__nav {
          gap: 40px;
        }
      }
    </style>

    <div class="container-1320 ingredients-tabs__inner">
      {% if section.settings.heading != blank or section.settings.subheading != blank %}
        <div class="ingredients-tabs__header">
          {% if section.settings.heading != blank %}
            <h2 class="ingredients-tabs__heading">{{ section.settings.heading }}</h2>
          {% endif %}
          {% if section.settings.subheading != blank %}
            <div class="ingredients-tabs__subheading">
              {{ section.settings.subheading }}
            </div>
          {% endif %}
        </div>
      {% endif %}

      <div class="ingredients-tabs__nav-wrap">
        <ul class="ingredients-tabs__nav" role="tablist">
          {% for item in items %}
            {%- liquid
              assign title_out = ''
              if item.title != blank
                if item.title.value != blank
                  assign title_out = item.title.value
                else
                  assign title_out = item.title
                endif
              endif
            -%}
            <li
              class="ingredients-tabs__nav-item{% if forloop.first %} is-active{% endif %}"
              data-tab-index="{{ forloop.index0 }}"
            >
              <button
                type="button"
                class="ingredients-tabs__nav-button"
                role="tab"
                aria-selected="{% if forloop.first %}true{% else %}false{% endif %}"
              >
                {{ title_out }}
              </button>
            </li>
          {% endfor %}
        </ul>
      </div>

      <div class="ingredients-tabs__slider ingredients-tabs__slider-{{ section.id }}">
        {% for item in items %}
          {%- liquid
            assign image_obj = blank
            if item.image != blank
              if item.image.value != blank
                assign image_obj = item.image.value
              else
                assign image_obj = item.image
              endif
            endif
          -%}
          <div class="ingredients-tabs__slide" data-slide-index="{{ forloop.index0 }}">
            {% if image_obj != blank %}
              <div class="ingredients-tabs__image-wrap">
                <img
                  class="ingredients-tabs__image"
                  src="{{ image_obj | image_url: width: image_obj.width }}"
                  width="{{ image_obj.width }}"
                  height="{{ image_obj.height }}"
                  alt="{{ image_obj.alt | escape }}"
                  loading="lazy"
                >
              </div>
            {% endif %}
          </div>
        {% endfor %}
      </div>
    </div>

    <script>
      document.addEventListener('DOMContentLoaded', function () {
        if (typeof window.jQuery === 'undefined') return;
        var $ = window.jQuery;
        var $section = $('#tabs-section-{{ section.id }}');
        if (!$section.length) return;
        var $slider = $section.find('.ingredients-tabs__slider-{{ section.id }}');
        if (!$slider.length || $slider.children().length === 0) return;
        if ($slider.hasClass('slick-initialized')) return;

        var $tabs = $section.find('.ingredients-tabs__nav-item');

        $slider.on('init', function (event, slick) {
          var current = slick.currentSlide;
          $tabs.removeClass('is-active');
          $tabs.eq(current).addClass('is-active');
          $tabs.find('.ingredients-tabs__nav-button').attr('aria-selected', 'false');
          $tabs.eq(current).find('.ingredients-tabs__nav-button').attr('aria-selected', 'true');
        });

        $slider.slick({
          arrows: true,
          dots: false,
          infinite: false,
          adaptiveHeight: true,
          prevArrow:
            '<button type="button" class="ingredients-tabs__arrow ingredients-tabs__arrow--prev" aria-label="Previous"><span class="ingredients-tabs__arrow-icon"></span></button>',
          nextArrow:
            '<button type="button" class="ingredients-tabs__arrow ingredients-tabs__arrow--next" aria-label="Next"><span class="ingredients-tabs__arrow-icon"></span></button>'
        });

        $tabs.on('click', function () {
          var index = $(this).data('tab-index');
          $slider.slick('slickGoTo', index);
        });

        $slider.on('afterChange', function (event, slick, currentSlide) {
          $tabs.removeClass('is-active');
          $tabs.eq(currentSlide).addClass('is-active');
          $tabs.find('.ingredients-tabs__nav-button').attr('aria-selected', 'false');
          $tabs.eq(currentSlide).find('.ingredients-tabs__nav-button').attr('aria-selected', 'true');
        });
      });
    </script>
  </section>
{% endif %}

{% schema %}
{
  "name": "Tabs Slider",
  "tag": "section",
  "class": "ingredients-tabs-section",
  "settings": [
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background color",
      "default": "#f5f0e6"
    },
    {
      "type": "color",
      "id": "nav_bg_color",
      "label": "Tabs bar background",
      "default": "#333333"
    },
    {
      "type": "color",
      "id": "nav_text_color",
      "label": "Tab text color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "nav_active_text_color",
      "label": "Active tab text color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "nav_underline_color",
      "label": "Active tab underline color",
      "default": "#ffffff"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Key ingredients"
    },
    {
      "type": "richtext",
      "id": "subheading",
      "label": "Subheading",
      "default": "<p>Describe the benefits of each ingredient or study here.</p>"
    },
    {
      "type": "range",
      "id": "padding_top_desktop",
      "label": "Desktop padding top",
      "min": 0,
      "max": 200,
      "step": 10,
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_bottom_desktop",
      "label": "Desktop padding bottom",
      "min": 0,
      "max": 200,
      "step": 10,
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "label": "Mobile padding top",
      "min": 0,
      "max": 120,
      "step": 10,
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "label": "Mobile padding bottom",
      "min": 0,
      "max": 120,
      "step": 10,
      "default": 40
    }
  ],
  "presets": [
    {
      "name": "Tabs Slider"
    }
  ]
}
{% endschema %}

