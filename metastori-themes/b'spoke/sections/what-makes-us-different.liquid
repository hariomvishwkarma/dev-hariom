<section class="difference-section" id="difference-section-{{ section.id }}">
  <div class="difference-section__container">
    {% if section.settings.heading != blank %}
      <h2 class="difference-section__heading">{{ section.settings.heading | escape }}</h2>
    {% endif %}

    <div class="difference-section__grid">
      {% for block in section.blocks %}
        <article class="difference-card" {{ block.shopify_attributes }}>
          {% if block.settings.icon != blank %}
            <div class="difference-card__icon-wrap">
              {{
                block.settings.icon
                | image_url: width: 96
                | image_tag:
                  class: 'difference-card__icon',
                  loading: 'lazy',
                  widths: '48, 64, 96',
                  sizes: '48px',
                  alt: block.settings.title | escape
              }}
            </div>
          {% endif %}

          {% if block.settings.title != blank %}
            <h3 class="difference-card__title">{{ block.settings.title | escape }}</h3>
          {% endif %}

          {% if block.settings.description != blank %}
            <div class="difference-card__description">{{ block.settings.description }}</div>
          {% endif %}
        </article>
      {% endfor %}
    </div>
  </div>
</section>

{% style %}
  #difference-section-{{ section.id }} {
    background: {{ section.settings.section_background }};
  }

  #difference-section-{{ section.id }} .difference-section__container {
    max-width: 1270px;
    margin: 0 auto;
    padding: 28px 26px 34px;
  }

  #difference-section-{{ section.id }} .difference-section__heading {
    margin: 0 0 42px;
    text-align: center;
    font-family: Optima, serif;
    font-size: 50px;
    font-weight: 700;
    line-height: 1;
    color: {{ section.settings.heading_color }};
  }

  #difference-section-{{ section.id }} .difference-section__grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 28px;
  }

  #difference-section-{{ section.id }} .difference-card {
    padding: 0;
  }

  #difference-section-{{ section.id }} .difference-card__icon-wrap {
    margin-bottom: 18px;
  }

  #difference-section-{{ section.id }} .difference-card__icon {
    width: 48px;
    height: 48px;
    object-fit: contain;
    display: block;
  }

  #difference-section-{{ section.id }} .difference-card__title {
    margin: 0 0 7px;
    font-family: 'DM Sans', sans-serif;
    font-size: 30px;
    font-weight: 700;
    line-height: 1.2;
    color: {{ section.settings.title_color }};
  }

  #difference-section-{{ section.id }} .difference-card__description {
    margin: 0;
    font-family: 'DM Sans', sans-serif;
    font-size: 31px;
    font-weight: 500;
    line-height: 1.35;
    color: {{ section.settings.description_color }};
  }

  #difference-section-{{ section.id }} .difference-card__description p {
    font-family: DM Sans;
    font-weight: 500;
    font-style: Medium;
    font-size: 15px;
    margin:0;
  }

  #difference-section-{{ section.id }} .difference-card__description p + p {
    margin-top: 8px;
  }

  @media (max-width: 1200px) {
    #difference-section-{{ section.id }} .difference-section__heading {
      font-size: 50px;
      margin-bottom: 42px;
    }

    #difference-section-{{ section.id }} .difference-card__title {
      font-size: 30px;
      margin-bottom: 14px;
    }

    #difference-section-{{ section.id }} .difference-card__description {
      font-size: 20px;
    }
  }

  @media (max-width: 767px) {
    #difference-section-{{ section.id }} .difference-card {
      padding: 0 25px;
    }

    #difference-section-{{ section.id }} .difference-section__container {
      padding: 20px 16px 26px;
    }

    #difference-section-{{ section.id }} .difference-section__heading {
      font-size: 28px;
      margin-bottom: 22px;
    }

    #difference-section-{{ section.id }} .difference-section__grid {
      grid-template-columns: 1fr;
      gap: 24px;
    }

    #difference-section-{{ section.id }} .difference-card__title {
      font-size: 30px;
    }

    #difference-section-{{ section.id }} .difference-card__description {
      font-size: 16px;
    }
  }
{% endstyle %}

{% schema %}
{
  "name": "What makes us different",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Section heading",
      "default": "What makes US different?"
    },
    {
      "type": "color",
      "id": "section_background",
      "label": "Section background",
      "default": "#f0f0f0"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading color",
      "default": "#111111"
    },
    {
      "type": "color",
      "id": "title_color",
      "label": "Card title color",
      "default": "#111111"
    },
    {
      "type": "color",
      "id": "description_color",
      "label": "Card description color",
      "default": "#222222"
    }
  ],
  "blocks": [
    {
      "type": "feature",
      "name": "Feature card",
      "settings": [
        {
          "type": "image_picker",
          "id": "icon",
          "label": "Icon"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Science-Driven Formulations"
        },
        {
          "type": "richtext",
          "id": "description",
          "label": "Description",
          "default": "<p>Add a short feature description here.</p>"
        }
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [
    {
      "name": "What makes us different",
      "blocks": [
        { "type": "feature" },
        { "type": "feature" },
        { "type": "feature" }
      ]
    }
  ]
}
{% endschema %}
