<section
  class="why-choose section-{{ section.id }}-padding"
  id="why-choose-{{ section.id }}"
  style="background: {{ section.settings.section_background }};"
  data-why-choose-section
>
  <div class="why-choose__container">
    {% if section.settings.heading != blank %}
      <h2 class="why-choose__heading">{{ section.settings.heading }}</h2>
    {% endif %}

    {% if section.blocks.size > 0 %}
      {%- assign icon_sizes_attr = section.settings.icon_size | append: 'px' -%}
      <div class="why-choose__slider-wrap">
        <div class="why-choose__track" data-why-choose-track>
          {% for block in section.blocks %}
            <article
              class="why-choose__card"
              {{ block.shopify_attributes }}
            >
              {% if block.settings.icon != blank %}
                <div class="why-choose__icon-wrap">
                  {{
                    block.settings.icon
                    | image_url: width: 110
                    | image_tag:
                      class: 'why-choose__icon',
                      loading: 'lazy',
                      widths: '55, 110',
                      sizes: icon_sizes_attr,
                      alt: block.settings.title | escape
                  }}
                </div>
              {% endif %}

              {% if block.settings.title != blank %}
                <h3 class="why-choose__card-title">{{ block.settings.title | escape }}</h3>
              {% endif %}

              {% if block.settings.text != blank %}
                <div class="why-choose__card-text rte">{{ block.settings.text }}</div>
              {% endif %}
              {% if block.settings.subtext != blank %}
                <div class="why-choose__card-subtext">{{ block.settings.subtext }}</div>
              {% endif %}
            </article>
          {% endfor %}
        </div>
      </div>
    {% endif %}
  </div>
</section>

<script>
  (function () {
    var section = document.getElementById('why-choose-{{ section.id }}');
    if (!section) return;

    var track = section.querySelector('[data-why-choose-track]');
    if (!track) return;

    function updateTrackAlignment() {
      if (track.scrollWidth <= track.clientWidth + 2) {
        track.classList.add('is-centered');
      } else {
        track.classList.remove('is-centered');
      }
    }

    updateTrackAlignment();

    var resizeTimer;
    window.addEventListener('resize', function () {
      clearTimeout(resizeTimer);
      resizeTimer = setTimeout(updateTrackAlignment, 100);
    });

    if (typeof ResizeObserver !== 'undefined') {
      var ro = new ResizeObserver(updateTrackAlignment);
      ro.observe(track);
    }
  })();
</script>

{% style %}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top_mobile }}px;
    padding-bottom: {{ section.settings.padding_bottom_mobile }}px;
  }

  @media screen and (min-width: 990px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top_desktop }}px;
      padding-bottom: {{ section.settings.padding_bottom_desktop }}px;
    }
  }

  #why-choose-{{ section.id }} .why-choose__container {
    max-width: 1234px;
    margin: 0 auto;
    padding-left: 20px;
    padding-right: 20px;
  }
  .why-choose__card-subtext {
    font-family: DM Sans;
    font-weight: 500;
    font-size: 15px;
    line-height: 18px;
    letter-spacing: 0%;
    vertical-align: middle;
    color: #000000B2;
    margin-top: 15px;
  }
  #why-choose-{{ section.id }} .why-choose__heading {
    margin: 0 0 25px;
    font-family: Optima, serif;
    font-weight: 700;
    font-style: normal;
    font-size: 28px;
    line-height: 100%;
    letter-spacing: 0;
    text-align: center;
    vertical-align: middle;
    text-transform: capitalize;
    color: {{ section.settings.heading_color }};
  }

  #why-choose-{{ section.id }} .why-choose__slider-wrap {
    width: 100%;
    overflow: hidden;
  }

  #why-choose-{{ section.id }} .why-choose__track {
    display: flex;
    flex-wrap: nowrap;
    justify-content: flex-start;
    align-items: stretch;
    gap: {{ section.settings.block_gap }}px;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
    padding-bottom: 4px;
  }

  #why-choose-{{ section.id }} .why-choose__track::-webkit-scrollbar {
    display: none;
  }

  #why-choose-{{ section.id }} .why-choose__track.is-centered {
    justify-content: center;
  }

  #why-choose-{{ section.id }} .why-choose__card {
    flex: 0 0 {{ section.settings.block_width_mobile }}px;
    width: {{ section.settings.block_width_mobile }}px;
    min-width: 150px;
    max-width: {{ section.settings.block_width_mobile }}px;
    scroll-snap-align: start;
    scroll-snap-stop: always;
    background: {{ section.settings.card_background }};
    border-radius: {{ section.settings.card_radius }}px;
    padding: {{ section.settings.card_padding }}px;
    box-sizing: border-box;
  }

  #why-choose-{{ section.id }} .why-choose__icon-wrap {
    display: block;
  }

  #why-choose-{{ section.id }} .why-choose__icon {
    width: {{ section.settings.icon_size }}px;
    height: {{ section.settings.icon_size }}px;
    object-fit: contain;
    display: block;
  }

  #why-choose-{{ section.id }} .why-choose__card-title {
    margin: 14px 0 10px;
    font-family: 'DM Sans', sans-serif;
    font-weight: 700;
    font-style: normal;
    font-size: 20px;
    line-height: 100%;
    letter-spacing: 0;
    vertical-align: middle;
    color: {{ section.settings.card_title_color }};
  }

  #why-choose-{{ section.id }} .why-choose__card-text {
    margin: 0;
    font-family: 'DM Sans', sans-serif;
    font-weight: 500;
    font-style: normal;
    font-size: 12px;
    line-height: 100%;
    letter-spacing: 0;
    vertical-align: middle;
    color: {{ section.settings.card_text_color }};
  }

  #why-choose-{{ section.id }} .why-choose__card-text p {
    margin: 0;
    font-family: inherit;
    font-weight: inherit;
    font-size: inherit;
    line-height: inherit;
    color: inherit;
  }

  #why-choose-{{ section.id }} .why-choose__card-text p + p {
    margin-top: 8px;
  }

  @media screen and (min-width: 990px) {
    #why-choose-{{ section.id }} .why-choose__heading {
      font-size: 50px;
      margin-bottom: 40px;
    }

    #why-choose-{{ section.id }} .why-choose__card {
      flex: 0 0 {{ section.settings.block_width_desktop }}px;
      width: {{ section.settings.block_width_desktop }}px;
      min-width: 0;
      max-width: none;
    }

    #why-choose-{{ section.id }} .why-choose__card-title {
      font-size: 30px;
    }

    #why-choose-{{ section.id }} .why-choose__card-text {
      font-size: 19px;
    }
  }
{% endstyle %}

{% schema %}
