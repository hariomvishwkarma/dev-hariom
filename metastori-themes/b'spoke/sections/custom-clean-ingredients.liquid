<div
  class="main-ingredients section-{{ section.id }}-padding"
  id="section-{{ section.id }}"
>
  {% if section.settings.right_title != blank %}
    <h2 class="ingredients-section-title">{{ section.settings.right_title }}</h2>
  {% endif %}
  <div class="cild-ingredients">
    <div class="ingredients-img">
      <img
        src="{{ section.settings.ingredients_img  | img_url: '500x500' }}"
        alt=""
        class="img_11 img_1 enable"
        loading="lazy"
      >
      <img
        src="{{ section.settings.ingredients_img2  | img_url: '500x500' }}"
        alt=""
        class="img_11 img_2"
        loading="lazy"
      >
      <img
        src="{{ section.settings.ingredients_img3  | img_url: '500x500' }}"
        alt=""
        class="img_11 img_3"
        loading="lazy"
      >
      <img
        src="{{ section.settings.ingredients_img4  | img_url: '500x500' }}"
        alt=""
        class="img_11 img_4"
        loading="lazy"
      >
      <img
        src="{{ section.settings.ingredients_img5  | img_url: '500x500' }}"
        alt=""
        class="img_11 img_5"
        loading="lazy"
      >
    </div>
    <div class="ingredients-right">
      <ul class="ingredients-list">
        {% for ingredient in section.blocks %}
          {% if ingredient.settings.ingredient_name != blank %}
            <li
              class="{{ forloop.index }}_link {% if forloop.index == 1 %}active{% endif %}"
              data-target="img_{{ forloop.index }}"
            >
              <strong class="ingredients-list__heading">{{ ingredient.settings.ingredient_name }}</strong>
              <div class="ingredients-list__body">
                <p class="toggle_content">{{ ingredient.settings.ingredient_description }}</p>
                <span class="read_moree" hidden>Read more</span>
              </div>
            </li>
          {% endif %}
        {% endfor %}
      </ul>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Clean Ingredients Section",
  "max_blocks": 5,
  "settings": [
    {
      "type": "image_picker",
      "id": "ingredients_img",
      "label": "Left image 1"
    },
    {
      "type": "image_picker",
      "id": "ingredients_img2",
      "label": "Left image 2"
    },
    {
      "type": "image_picker",
      "id": "ingredients_img3",
      "label": "Left image 3"
    },
    {
      "type": "image_picker",
      "id": "ingredients_img4",
      "label": "Left image 4"
    },
    {
      "type": "image_picker",
      "id": "ingredients_img5",
      "label": "Left image 5"
    },

    {
      "type": "text",
      "id": "right_title",
      "label": "Main title"
    },
    {
      "type": "header",
      "content": "Section padding"
    },
    {
      "type": "range",
      "id": "padding_top_desktop",
      "label": "Desktop top padding",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 60
    },
    {
      "type": "range",
      "id": "padding_bottom_desktop",
      "label": "Desktop bottom padding",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 60
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "label": "Mobile top padding",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "label": "Mobile bottom padding",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 40
    }
  ],
  "blocks": [
    {
      "type": "benefit",
      "name": "Benefit",
      "settings": [
        {
          "type": "text",
          "id": "benefit",
          "label": "Benefit",
          "default": "Promotes mucus production"
        }
      ]
    },
    {
      "type": "ingredient",
      "name": "Ingredient",
      "settings": [
        {
          "type": "text",
          "id": "ingredient_name",
          "label": "Ingredient Name",
          "default": "Slippery Elm"
        },
        {
          "type": "text",
          "id": "ingredient_description",
          "label": "Ingredient Description",
          "default": "Coats the esophagus and stomach lining to reduce irritation and soothe acid reflux symptoms."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Clean Ingredients Section"
    }
  ]
}
{% endschema %}
<style>
  #section-{{ section.id }}.main-ingredients,
  .section-{{ section.id }}-padding.main-ingredients {
    width: 100%;
    padding-top: {{ section.settings.padding_top_mobile }}px;
    padding-bottom: {{ section.settings.padding_bottom_mobile }}px;
  }

  @media screen and (min-width: 990px) {
    #section-{{ section.id }}.main-ingredients,
    .section-{{ section.id }}-padding.main-ingredients {
      padding-top: {{ section.settings.padding_top_desktop }}px;
      padding-bottom: {{ section.settings.padding_bottom_desktop }}px;
    }
  }

  .ingredients-section-title {
    text-align: center;
    font-size: 50px;
    font-weight: bold;
    margin: 0 auto 40px;
    padding: 0 20px;
    max-width: 1200px;
    font-family: optima;
    line-height: 1.15;
  }

  #section-{{ section.id }} .ingredients-img {
    width: 50%;
    position: relative;
    align-self: center;
  }

  #section-{{ section.id }} .ingredients-img img {
    width: 100%;
    height: auto;
    vertical-align: top;
  }

  .ingredients-right {
    width: 50%;
  }

  .cild-ingredients {
    width: 100%;
    max-width: 1337px;
    padding: 0 50px;
    margin: 0 auto;
    display: flex;
    padding-top:0px;
    padding-bottom: 50px;
  }

  ul.ingredients-list {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  ul.ingredients-list li {
    font-size: 20px;
    font-weight: 400;
    display: block;
    list-style: none;
    margin-bottom: 24px;
    position: relative;
    cursor: pointer;
    padding-left: 20px;
    border-left: 4px solid transparent;
    transition: border-color 0.2s ease;
  }

  ul.ingredients-list li.active {
    border-left-color: #12723B;
  }

  ul.ingredients-list .ingredients-list__heading {
    font-family: 'DM Sans';
    font-size: 35px;
    font-weight: bold;
    display: block;
    margin-bottom: 8px;
    line-height: 1.2;
    color: #000;
    transition: color 0.2s ease;
  }

  ul.ingredients-list li.active .ingredients-list__heading {
    color: #12723B;
  }

  ul.ingredients-list p {
    font-size: 12px;
    font-weight: 500;
    line-height: 16px;
    margin: 0;
    font-family: 'DM Sans';
    color: #000;
    -webkit-text-stroke-width: thin;
  }

  .ingredients-list__body {
    margin-top: 4px;
  }

  #section-{{ section.id }} .read_moree {
    display: none !important;
    margin-top: 8px;
    color: #12723B;
    cursor: pointer;
    font-size: 15px;
    font-weight: 500;
    font-family: 'suisse-intl-regular', sans-serif;
    text-decoration: underline;
  }

  #section-{{ section.id }} .ingredients-list li.active .read_moree.is-visible:not([hidden]) {
    display: inline-block !important;
  }

  #section-{{ section.id }} .toggle_content.is-measuring {
    position: absolute !important;
    visibility: hidden !important;
    pointer-events: none !important;
    display: block !important;
    overflow: visible !important;
    -webkit-line-clamp: unset !important;
    line-clamp: unset !important;
    -webkit-box-orient: unset !important;
    width: 100% !important;
    height: auto !important;
    left: 0;
    top: 0;
    z-index: -1;
  }

  #section-{{ section.id }} .ingredients-img img {
    display: none;
  }

  #section-{{ section.id }} .ingredients-img img.enable {
    display: block;
    position: relative;
    opacity: 1;
  }

  #section-{{ section.id }} .ingredients-img img.is-fading {
    display: block;
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: auto;
  }

  .toggle_content {
    overflow: hidden;
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
    line-clamp: 2;
  }

  .toggle_content.expanded {
    display: block;
    -webkit-line-clamp: unset;
    line-clamp: unset;
    overflow: visible;
  }

  @media (max-width: 768px) {
    .cild-ingredients {
      flex-direction: column;
      padding: 0 15px;
    }

    .ingredients-right {
      width: 100%;
      padding-left: 0 !important;
      padding-right: 0 !important;
    }

    .ingredients-img {
      width: 100%;
    }

    .ingredients-img img {
      padding: 0;
      width: 100%;
    }

    ul.ingredients-list .ingredients-list__heading {
      font-size: 25px;
    }
    .ingredients-section-title {
      font-size: 28px;
      margin: 0;
    }
  }
</style>

<script>
  (function () {
    var sectionId = 'section-{{ section.id }}';

    function initIngredientsSection() {
      var section = document.getElementById(sectionId);
      if (!section) return;

      if (section.dataset.ingredientsInit === 'true') {
        return;
      }
      section.dataset.ingredientsInit = 'true';

      var imgWrap = section.querySelector('.ingredients-img');
      var listItems = section.querySelectorAll('.ingredients-list li');
      var swapToken = 0;

      function resetImageStyles(img) {
        if (!img) return;
        img.classList.remove('is-fading');
        img.style.position = '';
        img.style.top = '';
        img.style.left = '';
        img.style.width = '';
        img.style.height = '';
        img.style.opacity = '';
        img.style.zIndex = '';
        img.style.display = '';
      }

      function swapImage(targetClass) {
        if (!imgWrap || !targetClass) return;

        var next = imgWrap.querySelector('.' + targetClass);
        if (!next) return;

        var current = imgWrap.querySelector('img.enable');
        if (current === next) return;

        var token = ++swapToken;

        imgWrap.querySelectorAll('img').forEach(function (img) {
          if (img !== current && img !== next) {
            img.classList.remove('enable', 'is-fading');
            resetImageStyles(img);
          }
        });

        if (!current) {
          next.classList.add('enable');
          resetImageStyles(next);
          imgWrap.style.minHeight = '';
          return;
        }

        var lockedH = imgWrap.offsetHeight;
        imgWrap.style.minHeight = lockedH + 'px';

        current.classList.add('is-fading');
        current.classList.remove('enable');
        next.classList.add('is-fading');
        next.style.opacity = '0';

        requestAnimationFrame(function () {
          current.style.opacity = '1';
          next.style.opacity = '0';
          requestAnimationFrame(function () {
            current.style.transition = 'opacity 280ms ease';
            next.style.transition = 'opacity 280ms ease';
            current.style.opacity = '0';
            next.style.opacity = '1';
          });
        });

        window.setTimeout(function () {
          if (token !== swapToken) return;

          imgWrap.querySelectorAll('img').forEach(function (img) {
            img.classList.remove('enable', 'is-fading');
            resetImageStyles(img);
          });

          next.classList.add('enable');
          imgWrap.style.minHeight = '';
        }, 300);
      }

      function contentOverflows(el) {
        if (!el || el.classList.contains('expanded')) return false;

        var text = (el.textContent || '').trim();
        if (!text) return false;

        var clampedHeight = el.getBoundingClientRect().height;

        el.classList.add('is-measuring');
        var fullHeight = el.scrollHeight;
        el.classList.remove('is-measuring');

        return fullHeight > clampedHeight + 3;
      }

      function updateReadMoreVisibility() {
        listItems.forEach(function (li) {
          var content = li.querySelector('.toggle_content');
          var btn = li.querySelector('.read_moree');
          if (!content || !btn) return;

          btn.classList.remove('is-visible');
          btn.setAttribute('hidden', '');

          if (!li.classList.contains('active')) {
            btn.textContent = 'Read more';
            return;
          }

          if (content.classList.contains('expanded')) {
            btn.classList.add('is-visible');
            btn.removeAttribute('hidden');
            btn.textContent = 'Read less';
            return;
          }

          if (contentOverflows(content)) {
            btn.classList.add('is-visible');
            btn.removeAttribute('hidden');
            btn.textContent = 'Read more';
          } else {
            btn.textContent = 'Read more';
          }
        });
      }

      function setActiveItem(li) {
        if (!li) return;

        listItems.forEach(function (item) {
          item.classList.remove('active');
        });
        li.classList.add('active');

        swapImage(li.getAttribute('data-target'));

        section.querySelectorAll('.toggle_content').forEach(function (node) {
          node.classList.remove('expanded');
        });
        section.querySelectorAll('.read_moree').forEach(function (btn) {
          btn.textContent = 'Read more';
        });

        window.setTimeout(updateReadMoreVisibility, 320);
      }

      listItems.forEach(function (li) {
        li.addEventListener('click', function (e) {
          if (e.target.closest('.read_moree')) return;
          setActiveItem(li);
        });
      });

      section.querySelectorAll('.read_moree').forEach(function (btn) {
        btn.addEventListener('click', function (e) {
          e.stopPropagation();
          var li = btn.closest('li');
          var content = li ? li.querySelector('.toggle_content') : null;
          if (!li || !content) return;

          if (!li.classList.contains('active')) {
            setActiveItem(li);
            return;
          }

          if (content.classList.contains('expanded')) {
            content.classList.remove('expanded');
            updateReadMoreVisibility();
            return;
          }

          section.querySelectorAll('.toggle_content').forEach(function (node) {
            node.classList.remove('expanded');
          });

          content.classList.add('expanded');
          updateReadMoreVisibility();
        });
      });

      var activeItem = section.querySelector('.ingredients-list li.active');
      if (activeItem) {
        swapImage(activeItem.getAttribute('data-target'));
      }

      updateReadMoreVisibility();
      window.addEventListener('resize', function () {
        window.clearTimeout(section._ingredientsResizeTimer);
        section._ingredientsResizeTimer = window.setTimeout(updateReadMoreVisibility, 120);
      });
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initIngredientsSection);
    } else {
      initIngredientsSection();
    }

    document.addEventListener('shopify:section:load', function (event) {
      if (event.target && event.target.id === sectionId) {
        initIngredientsSection();
      }
    });
  })();
</script>
