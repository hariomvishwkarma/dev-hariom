{% if settings.enable_lazyload %}data-{% endif %}srcset="
  {{ preview_img | image_url: width: 320 }} 320w,
  {{ preview_img | image_url: width: 533 }} 533w,
  {{ preview_img | image_url: width: 750 }} 750w,
  {{ preview_img | image_url: width: 1000 }} 1000w,
  {{ preview_img | image_url: width: 1000 }} 1440w,
  {{ preview_img | image_url: width: 1000 }} 1920w
" 
{% unless settings.enable_lazyload %}
  src="{{ preview_img | image_url: width: 533 }}"
{% endunless %}

{% unless settings.enable_lazyload %}src="{{ preview_img | img_url: '533x' }}"{% endunless %} sizes="(min-width: 1100px) {{preview_img.width | append: 'px'}}, (min-width: 750px) calc((100vw - 130px) / 2), calc((100vw - 50px) / 2)" alt="{{ preview_img.alt | escape }}" size="{{ preview_img.width }}" loading="lazy" class="{% if class %}motion-reduce{% endif %}{% if settings.enable_lazyload %} lazyload{% endif %}"