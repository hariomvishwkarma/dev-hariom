{% assign frequently_bought_products = product.metafields.custom.frequently_bought.value %}
{% if frequently_bought_products != blank %}
  <div id="frequently_bought" class="product-wrapper-custom-main page-width">
    <div class="collection__title title-wrapper title-wrapper--no-top-margin">
      <h2 class="title inline-richtext h2 scroll-trigger animate--slide-in">Frequently Bought Together</h2>
    </div>
    <div class="product-wrapper-custom grid product-grid contains-card contains-card--product grid--4-col-desktop grid--2-col-tablet-down">
      {% for product in frequently_bought_products %}
        {% unless product.title == '0' %}
          <div class="grid__item">
            <div class="card-wrapper product-card-wrapper underline-links-hover">
              <div class="card card--card card--media gradient">
                <div class="card__inner ratio">
                  <div class="card__media">
                    <div class="media media--transparent media--hover-effect">
                      <a href="{{ product.url }}">
                        <img
                          src="{{ product.featured_image | image_url: width: 300 }}"
                          alt="{{ product.title }}"
                          loading="lazy"
                        >
                      </a>
                    </div>
                  </div>
                </div>
                <div class="card__content">
                  <div class="card__information">
                    <h3 class="card__heading h5">
                      <a href="{{ product.url }}" class="full-unstyled-link">{{ product.title }}</a>
                    </h3>
                    <p class="full-unstyled-link_pp">
                      {{ product.metafields.custom.extra_information }}
                    </p>

                    <!-- Start of Judge.me code -->
                    <div
                      style="{{ jm_style }}"
                      class="jdgm-widget jdgm-preview-badge custom"
                      data-id="{{ all_products['anti-acne'].id }}"
                      data-auto-install="false"
                    >
                      {{ all_products['anti-acne'].metafields.judgeme.badge }}
                    </div>
                    <!-- End of Judge.me code -->
                    <div class="no-js-hidden" id="price-{{ section.id }}" role="status">
                      {%- render 'price',
                        product: product,
                        use_variant: true,
                        price_class: 'price--medium custom-bought'
                      -%}
                      <div class="quick-add">
                        <!-- Add to Cart Button or Sold Out -->

                        {% if product.available %}
                          <form method="post" action="/cart/add">
                            <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">
                            <input type="hidden" name="quantity" value="1">
                            <button
                              type="submit"
                              class="product-form__submit  button button--primary"
                            >
                              {{ 'products.product.add_to_cart' | t }}
                            </button>
                          </form>
                        {% else %}
                          <button
                            class="product-form__submit  button button--secondary"
                            disabled
                          >
                            {{ 'products.product.sold_out' | t }}
                          </button>
                        {% endif %}
                      </div>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          </div>
        {% endunless %}
      {% endfor %}
    </div>
  </div>
{% endif %}
<style>
       .quick-add button.button.button--primary {
        font-weight: 400;
        font-size: 16px;
        line-height: 18.53px;
        letter-spacing: 0px;
        color: #fff;
        background: #2cb67d;
        padding: 5px 15px;
        border-radius: 50px;
        width: fit-content;
             border: none;
    }
    .product-wrapper-custom .slick-arrow svg path {
      fill: #fff !important;
  }

       .quick-add button.button.button--secondary {
        font-weight: 400;
        font-size: 10px;
        line-height: 18.53px;
        letter-spacing: 0px;
        color: #fff;
        background: #2cb67d;
        padding: 5px 10px;
        border-radius: 50px;
        width: fit-content !important;
             border: none;
             min-width: unset !important;
    }
    .jdgm-widget.jdgm-preview-badge.custom.jdgm-preview-badge--with-link.jdgm--done-setup span.jdgm-star.jdgm--on {
        color: #FAB73B;
    }
   .price.price--medium.custom-bought.price--sold-out dl .price__regular dd.price__last .price-item.price-item--regular {
     font-size: 14px !important;

  }
</style>
