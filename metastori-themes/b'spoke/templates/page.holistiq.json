    "holistiq_product_description": {
      "type": "holistiq-product-description",
      "blocks": {
        "tab_details": {
          "type": "holistiq_desc_tab",
          "settings": {
            "tab_title": "Product Details",
            "tab_content": "<ul><li>HolistIQ Chocolate Nutrition Drink is a holistic nutrition drink for children aged 2–9 years, formulated without junk ingredients, fillers, emulsifiers, or artificial colours and flavours. It is designed to deliver balanced daily nutrition rather than empty calories.</li><li>The formula is specially curated to support height, muscle, and bone growth, brain development and learning, healthy digestion, and daily strength and immunity. This is achieved through a combination of high-quality proteins, essential micronutrients, and digestion-supporting ingredients.</li><li>HolistIQ uses a balanced protein blend of whey protein isolate and milk proteins (casein). This blend provides all 9 essential amino acids with high digestibility and a PDCAAS close to 1, indicating excellent protein quality. The combination offers both fast and sustained protein release to support daily activity and growth needs.</li><li>The product also includes prebiotic fibres and digestive enzymes to support digestion, improve nutrient absorption, and reduce tummy discomfort. This helps ensure that the nutrition consumed is effectively absorbed and utilized by the body.</li><li>HolistIQ contains only 10% unrefined sugar and no refined white sugar. The chocolate flavour is formulated to be enjoyable for children without relying on excess sugar. Compared to ordinary kids’ drinks, HolistIQ avoids cheap fillers, excessive sugar, and low-quality protein sources, focusing instead on clean ingredients and quantified nutrition.</li></ul>"
          }
        },
        "tab_who": {
          "type": "holistiq_desc_tab",
          "settings": {
            "tab_title": "Who is it for ?",
            "tab_content": "<ul><li>For children aged <strong>2–9 years</strong> who are in their most important years of growth and development</li><li>For kids who need <strong>nutritional support beyond regular meals</strong>, especially on busy or active days</li><li>For children who are <strong>picky eaters</strong> and may not get consistent nutrition every dayFor growing kids who need <strong>quality protein, vitamins, and minerals</strong> in an easy-to-consume form</li><li>For families looking for a <strong>clean, chocolate-flavoured nutrition drink</strong> suitable for daily use</li></ul>"
          }
        },
        "tab_how": {
          "type": "holistiq_desc_tab",
          "settings": {
            "tab_title": "How to use ?",
            "tab_content": "<p>Add HolistIQ™ Chocolate Nutrition Drink to milk as part of a daily routine.</p><ul><li>For children aged <strong>2–6 years</strong>: Mix <strong>1 scoop (20 g)</strong> in <strong>100 ml</strong> of hot or cold milk.<br/></li><li>For children aged <strong>6–9 years</strong>: Mix <strong>2 scoops (40 g)</strong> in <strong>200 ml</strong> of hot or cold milk.<br/></li></ul><p>Stir well until fully dissolved. For best taste, mix with cold milk.</p><p><strong>Recommended usage:</strong> 1 serving per day.</p>"
          }
        },
        "tab_ingredients": {
          "type": "holistiq_desc_tab",
          "settings": {
            "tab_title": "Ingredients (Per Serve)",
            "tab_content": "<ul><li>Whole Milk Powder</li><li>Skimmed Milk Powder</li><li>Fructooligosaccharides</li><li>Unrefined Brown Sugar</li><li>Whey Protein Isolate</li><li>Cocoa Powder</li><li>Vitamins & Minerals</li><li>Chocolate Flavour</li><li>Monk Fruit</li><li>DHA and Protease.</li></ul>"
          }
        },
        "tab_shipping": {
          "type": "holistiq_desc_tab",
          "settings": {
            "tab_title": "Shipping & Return",
            "tab_content": "<ul><li>7-day free return policy; requests reviewed in 24–48 hours.</li><li>Returns must have original packaging; used products are non-refundable.</li><li>COD refunds processed in 10–12 days; share bank details via email.</li><li>Online payment refunds processed in 7 days to the original account.</li><li>Write to us: help@bspokewellness.com</li><li>Call or Chat with us on WhatsApp: +918569990151</li><li>Working Hours: 10:30am - 6:30pm</li><li>Working Days: Monday - Saturday</li><li>Shipping timeline post fulfillment of order: 2-3 Business days</li><li>Delivery Timeline: Within 2-7 days of placement of order.</li></ul>"
          }
        }
      },
      "block_order": [
        "tab_details",
