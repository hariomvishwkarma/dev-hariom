        "benefit_mJwzYM": {
          "type": "benefit",
          "settings": {
            "title": "How often should I replace my mastectomy bra inserts?",
            "content": "<p>The lifespan of your inserts depends on wear frequency and washing. Generally, they should be replaced every 3-6 months, or if they lose their shape or become uncomfortable.</p>"
          }
        },
        "benefit_EMF9aH": {
          "type": "benefit",
          "settings": {
