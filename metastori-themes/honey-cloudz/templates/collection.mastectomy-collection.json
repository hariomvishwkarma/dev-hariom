        },
        "benefit_cwakHk": {
          "type": "benefit",
          "settings": {
            "title": "What material do you use to make your inserts?",
            "content": "<p>Our inserts are crafted with breathable materials. Both mastectomy inserts are 82% Polyester 18% Spandex, Cups 100% Polyurethane, Non Slip Bra Inserts Application 100% Medical Grade Silicone.</p>"
          }
        },
        "benefit_xV3VXD": {
          "type": "benefit",
