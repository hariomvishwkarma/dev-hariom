        "benefit_XKpBxk": {
          "type": "benefit",
          "settings": {
            "title": "How do I wash my mastectomy bra inserts?",
            "content": "<p>Both Teardrop and Oval inserts are machine or hand washable. We recommend air drying to maintain the best shape. DO NOT put in dryer or iron. Please follow the care instructions provided to ensure proper cleaning and maintain their shape.</p>"
