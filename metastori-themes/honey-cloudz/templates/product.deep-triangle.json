ettings":{"direction":"left","speed":1.6,"show_divider":false,"use_custom_colors":true,"colors_icon":"#a8e8e2","colors_text":"#212326","colors_background":"#00b5e2","gradient_background":"","padding_top":20,"padding_bottom":20}},"guarantees":{"type":"guarantees","blocks":{"guarantee-0":{"type":"guarantee","settings":{"icon":"ruler","icon_size":"medium","custom_icon":"","title":"Style or Size Questions?","title_size":"h4","text":"<p>Message Us<\/p>"}},"guarantee-1":{"type":"guarantee","settings":{"icon":"globe","icon_size":"medium","custom_icon":"","title":"We ship Worldwide","title_size":"h4","text":"<p>Shipping calcuated at checkout<\/p>"}},"guarantee-2":{"type":"guarantee","settings":{"icon":"package","icon_size":"medium","custom_icon":"","title":"30 Day Returns","title_size":"h4","text":""}},"guarantee-3":{"type":"guarantee","settings":{"icon":"washing","icon_size":"medium","custom_icon":"","title":"Machine or Hand Wash","title_size":"h4","text":"<p>Lay flat or Hang Dry. No Dryer or Iron<\/p>"}}},"block_order":["guarantee-0","guarantee-1","guarantee-2","guarantee-3"],"disabled":true,"settings":{"layout":"sidebar","column_alignment":"center","horizontal_content":false,"full_width":false,"show_divider":false,"heading":"","heading_size":"h1","heading_tag":"h2","columns_mobile":"1","swipe_on_mobile":false,"use_custom_colors":false,"colors_icon":"#ffffff","colors_text":"#1a1b18","colors_background":"#ffffff","gradient_background":"","padding_top":72,"padding_bottom":36}},"collapsible-content":{"type":"collapsible-content","blocks":{"question-0":{"type":"collapsible_row","settings":{"heading":"What size should I get?","row_content":"<p>Refer to our Size Guide and locate your bra size. We also list the insert dimensions if you want to double check the size of your garment, it's an excellent way to be sure it will fit properly<\/p>","page":""}},"question-3":{"type":"collapsible_row","settings":{"heading":"Will they stay in place without anything else under a shirt or dress? ","row_content":"<p>No, the inserts need to be inside a swimsuit, sports bra, workout top, bralette, regular bra. They are not a strapless \"silicone bra\" that you can wear by itself.<\/p>","page":""}},"question-1":{"type":"collapsible_row","settings":{"heading":"How do I know if I have the right fit? ","row_content":"<p>If the insert moves around<strong> the first day<\/strong> while you are wearing, it is too big size down. Your breasts should cup the blue side and there should not be space. If the insert seems too small on your breast, not covering enough, size up. You can also tell it is too small because an outline will show from being so pressed. <\/p>","page":""}},"45676c86-b287-46a4-a9d7-242083272135":{"type":"collapsible_row","settings":{"heading":"Is this a push-up, cleavage enhancing inserts?","row_content":"<p>No this style is for shaping and nipple coverage. It does provide lift and support but is not a push-up<\/p>","page":""}},"1538a2d2-9b44-4dd2-8191-598f390191ba":{"type":"collapsible_row","settings":{"heading":"How much support do the inserts offer?","row_content":"<p>Our half moons inserts provide light support. The half moons don't provide a push up effect.<\/p>","page":""}},"2df8f5e0-a9bb-45bd-a994-7f71b1a2cc44":{"type":"collapsible_row","settings":{"heading":"Can I use them in a chlorine pool or at the beach in salt water? ","row_content":"<p>Yes, our inserts are made with polyester which is the best fabric for chlorine and saltwater. The medical grade silicone outside and polyester have been tested and approved in these conditions. <\/p>","page":""}},"e7ee94b6-439c-4e66-a0a2-cb89eda84f48":{"type":"collapsible_row","settings":{"heading":"Can you really keep them in your sports bra, bralette or swimsuit in the washing machine?","row_content":"<p>Yes you can! The beauty about it too is they stay in your garment and don't end up at the bottom of your washer!<\/p>","page":""}},"a29a37c5-2a4e-4705-8da1-93d40ef1b33d":{"type":"collapsible_row","settings":{"heading":"I don't see my bra size listed, will anything fit me? ","row_content":"<p>We strive to include as many women as possible. Send us an email or IM message. We may be able to recommend a size to try and we will keep in mind for adding in the future! We built Honey Cloudz on feedback.<\/p>","page":""}}},"block_order":["question-0","question-3","question-1","45676c86-b287-46a4-a9d7-242083272135","1538a2d2-9b44-4dd2-8191-598f390191ba","2df8f5e0-a9bb-45bd-a994-7f71b1a2cc44","e7ee94b6-439c-4e66-a0a2-cb89eda84f48","a29a37c5-2a4e-4705-8da1-93d40ef1b33d"],"disabled":true,"settings":{"open_first_collapsible_row":false,"narrow":true,"show_divider":false,"heading":"FAQs","heading_size":"h1","heading_alignment":"center","heading_tag":"h2","padding_top":36,"padding_bottom":36}},"product-recommendations":{"type":"product-recommendations","disabled":true,"settings":{"show_divider":false,"heading":"More good stuff","heading_size":"h2","heading_alignment":"center","heading_tag":"h2","columns_mobile":"2","swipe_on_mobile":true,"image_ratio":"square","image_position":"center center","enable_image_fill":false,"show_secondary_image":true,"show_vendor":false,"show_rating":true,"show_quick_buy":true,"enable_quick_view":true,"enable_color_swatches":true,"enable_countdown":false,"padding_top":72,"padding_bottom":56}},"recently-viewed-products":{"type":"recently-viewed-products","disabled":true,"settings":{"show_divider":false,"heading":"Recently Viewed","heading_size":"h1","heading_alignment":"center","heading_tag":"h2","columns_mobile":"1","swipe_on_mobile":true,"image_ratio":"portrait","image_position":"center center","enable_image_fill":true,"show_secondary_image":true,"show_vendor":true,"show_rating":true,"show_quick_buy":true,"enable_quick_view":true,"enable_color_swatches":true,"enable_countdown":true,"padding_top":36,"padding_bottom":36}},"testimonials":{"type":"testimonials","blocks":{"testimonial-0":{"type":"testimonial","settings":{"icon":"5","text":"<p>These are just wonderful. I wear unlined cotton bralettes for comfort and when I go out I just slip these in for a little more coverage. I love how they look natural since they don’t add too much and they are very lightweight and breathable., no slipping out problems at all. I highly recommend.\"<\/p>","image":"shopify:\/\/shop_images\/Untitled_design_63.png","author":"Mindy Witherspoon, Boise ID"}},"testimonial-1":{"type":"testimonial","settings":{"icon":"5","text":"<p>\"I bought these for my sportsbras mainly because I was tired of fixing the dumb pads that come with them. These work as advertised! I bought 4 pairs for the sportsbras I wear the most and I leave them in all the time. I wear them, workout hard with no moving inserts and then throw them in my wash. When I take my laundry out the inserts are still in the pockets nicely! SO SO SO much easier! Thank you for this amazing product.\"<\/p>","image":"shopify:\/\/shop_images\/Untitled_design_69.png","author":"Jenny Maxwell, Walnut Creek CA"}},"testimonial-2":{"type":"testimonial","settings":{"icon":"5","text":"<p>\"I liked my suits and hated the cups that came with them. I took those babies out and replaced with cloudz. So much better! They provide a great shape, looks natural but better and the inserts are lightweight. They are not these thick hot pads thankfully. The best part of all is that they stay in my suits! I leave them in after wearing and they stay inside in the washer. They only need a slight adjustment inside the pocket after. Miracle product!\"<\/p>","author":"Malissa Miller, Charleston South Carolina"}},"testimonial-3":{"type":"testimonial","settings":{"icon":"5","text":"<p>\"I am a young 50's and was looking for something for bras. These are the perfect add. They stay in place and smooth everything. My tops look better. They make me feel like I look younger, have a nicer round shape. These are all I will buy!<\/p>","image":"shopify:\/\/shop_images\/Untitled_design_65.png","author":"Daria M"}},"testimoni