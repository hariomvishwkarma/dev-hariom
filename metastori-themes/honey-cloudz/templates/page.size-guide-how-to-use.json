        "text_3": {
          "type": "text",
          "settings": {
            "text": "<p><strong>Honey Cloudz</strong> breast forms offer a lightweight, breathable alternative to traditional heavy, silicone breast forms.</p>"
          }
        },
        "text_1": {
          "type": "text",
          "settings": {
            "text": "<p>Choose your breast form size based on your <strong>bra size before surgery</strong>, or match the size of your remaining breast if you've had a single-side mastectomy.</p>"
          }
        },
        "text_2": {
          "type": "text",
          "settings": {
            "text": "<p>Breast forms should be worn in <strong>pocketed clothing</strong> for proper positioning and stability.</p>"
          }
        },
        "text_PDkt8e": {
          "type": "text",
          "settings": {
            "text": "<p><strong>Lumpectomy</strong> → Choose based on your current bra size</p><p><strong>Mastectomy (Reconstruction)</strong> → Choose based on your current bra size</p><p><strong>Explant </strong>→<strong> </strong>Choose based on your current bra size</p>"
          }
        },
        "highlight_1": {
          "type": "highlight",
          "settings": {
            "text": "<p><em>Not sure which size to choose? Our team offers </em><em><strong>personalized fit help</strong></em><em> before and after trying on to ensure you find the most comfortable fit. Call/text us at 800-607-1079 or email us at support@honeycloudz.com.</em></p>"
          }
        }
      },
