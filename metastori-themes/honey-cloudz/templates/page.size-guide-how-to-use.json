    "custom_care_guide_CCG1": {
      "type": "custom-care-guide",
      "blocks": {
        "card_wash": {
          "type": "card",
          "settings": {
            "icon": "wash",
            "heading": "Washing Instructions",
            "heading_tag": "h3",
            "text": "<p><strong>For Bra Inserts: </strong>Machine wash warm/cold in a delicates bag only or hand wash. Use gentle detergent, no bleach, do not iron or dry clean. Lay flat or hang to dry. <strong>Do not put inserts in the dryer.<br/><br/>For Breast Forms: </strong>To preserve shape and longevity, hand wash only. Use gentle detergent and lukewarm water. No bleach, do not iron, or dry clean. Lay flat or hang to dry. <strong>Do not put forms in the dryer.</strong></p>"
          }
        },
        "card_fabric": {
          "type": "card",
          "settings": {
            "icon": "fabric",
            "heading": "Fabric Content",
            "heading_tag": "h3",
            "text": "<p>Our inserts and breast forms are made with a soft and flexible blend of 82% Polyester and 18% Spandex. The cups are crafted from 100% Polyurethane, and our patented non-slip grippy-dot exterior is made using 100% medical-grade silicone for safe, secure hold. All Honey Cloudz are latex-free.</p>"
          }
        }
      },
