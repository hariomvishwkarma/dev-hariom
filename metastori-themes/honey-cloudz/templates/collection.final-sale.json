{
  "sections": {
    "banner": {
      "type": "main-collection-banner",
      "settings": {
        "heading_size": "h1",
        "show_description": true,
        "show_image": false,
        "apply_overlay": false,
        "image_position": "center center",
        "image_ratio": "400px",
        "text_alignment": "left",
        "mobile_text_alignment": "left",
        "mobile_image_ratio": "250px",
        "show_text_below": false,
        "padding_top": 48,
        "padding_bottom": 8
      }
    },
    "filter_bar": {
      "type": "collection-filter-bar",
      "blocks": {
        "filter_shape": {
          "type": "filter_checkbox_menu",
          "settings": {
            "menu_label": "Shape",
            "filter_field": "shape",
            "options": "Half Moon\nOval\nTriangle"
          }
        },
        "filter_coverage": {
          "type": "filter_checkbox_menu",
          "settings": {
            "menu_label": "Coverage",
            "filter_field": "coverage",
            "options": "Lites\nClassics\nPlus+"
          }
        },
        "filter_size": {
          "type": "filter_checkbox_menu",
          "settings": {
            "menu_label": "Size",
            "filter_field": "size",
            "options": "XXS\nXS\nS\nM\nL\nXL\n1X"
          }
        },
        "filter_color": {
          "type": "filter_checkbox_menu",
          "settings": {
            "menu_label": "Color",
            "filter_field": "color",
            "options": "Jet Black\nLatte\nVanilla Sugar\nCaramel\nHazelnut"
          }
        }
      },
      "block_order": [
        "filter_shape",
        "filter_coverage",
        "filter_size",
        "filter_color"
      ],
      "settings": {
        "filter_label": "Filter By:",
        "show_segment": false,
        "show_sort": true,
        "sort_label": "Sort By:",
        "mobile_filters_button_label": "Filters",
        "drawer_title": "Filters",
        "drawer_close_label": "Close filters",
        "filter_selected_suffix": "selected",
        "filter_reset_label": "RESET",
        "segment_aria_label": "Filter by product type",
        "label_all": "All",
        "label_inserts": "Inserts",
        "label_breast_forms": "Breast Forms",
        "empty_message": "No final sale products match this filter.",
        "padding_top": 16,
        "padding_bottom": 0
      }
    },
    "product-grid": {
      "type": "main-collection-product-grid",
      "settings": {
        "products_per_row": 4,
        "rows_per_page": 6,
        "products_per_page": 48,
        "metafield_namespace": "custom",
        "metafield_key": "solution",
        "solution_filter_namespace": "custom",
        "solution_filter_key": "solution",
        "size_filter_namespace": "custom",
        "size_filter_key": "size",
        "coverage_filter_namespace": "custom",
        "coverage_filter_key": "coverage",
        "shape_filter_namespace": "custom",
        "shape_filter_key": "shape",
        "columns_mobile": "2",
        "pagination": "paginated",
        "enable_sticky_facet": false,
        "enable_sorting": false,
        "enable_viewing": false,
        "enable_filtering": false,
        "filter_type": "drawer",
        "enable_filtering_color_swatches": true,
        "filtering_color_swatches_add_label": true,
        "filtering_max_items": 6,
        "image_ratio": "square",
        "image_position": "center center",
        "enable_image_fill": true,
        "show_secondary_image": true,
        "show_vendor": false,
        "show_rating": true,
        "show_quick_buy": true,
        "enable_quick_view": true,
        "enable_color_swatches": true,
        "enable_countdown": false,
        "padding_top": 24,
        "padding_bottom": 52,
        "products_to_hide": []
      }
    }
  },
  "order": [
    "banner",
    "filter_bar",
    "product-grid"
  ]
}
