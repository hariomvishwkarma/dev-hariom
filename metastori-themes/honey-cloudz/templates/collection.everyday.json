    "faq_4nfYde": {
      "type": "faq",
      "blocks": {
        "subheading_HyjTdA": {
          "type": "subheading",
          "settings": {
            "title": "About Honey Cloudz",
            "heading_size": "h2",
            "heading_alignment": "center",
            "heading_tag": "h3",
            "padding_top": 0,
            "padding_bottom": 28
          }
        },
        "question_jKLhY6": {
          "type": "question",
          "settings": {
            "title": "What is Honey Cloudz?",
            "text": "<p>We are a women-led brand that makes lightweight, breathable, cloud-soft bra inserts and breast forms that help women feel more comfortable and confident. Whether that means adding volume, supporting asymmetry, or helping you feel more like yourself after surgery. </p>",
            "padding_top": 0,
            "padding_bottom": 12
          }
        },
        "question_Pqknfi": {
          "type": "question",
          "settings": {
            "title": "How is Honey Cloudz different from other brands?",
            "text": "<p>There are a few things that set us apart from other brands:</p><ol><li><strong>Patented grippy-dot exterior:</strong> Engineered to help reduce shifting, folding, & sliding.<br/></li><li><strong>We’re a women-led team</strong>: We understand the struggles women go through (even the small details that most brands ignore).<br/></li><li><strong>Our Cloudz are professionally designed:</strong> Our founder, Angela, was a high-performance swimwear designer for Olympic athletes!<br/></li><li><strong>Every product is tested on different bodies</strong>: That’s how we’re able to offer a variety of styles, shapes, and tones you can choose from.</li></ol><p></p>",
            "padding_top": 0,
            "padding_bottom": 12
          }
        },
        "question_DJXj4Q": {
          "type": "question",
          "settings": {
            "title": "How do I find the right Cloudz for me?",
            "text": "<p>It comes down to your personal preference, your needs, and what you’ll be wearing them in.</p><p><br/>You can choose your bra inserts based on the shaping level you need and what you want to wear them inside. For example, if you’re just looking for nipple covearge with no added volume for a swimsuit, the Oval Lites are perfect. If you’re looking to get light shaping under triangle bras, the Triangle Classic will work best. </p><p>For Mastectomy (Non.Reconstruction): We offer 2 breast form styles Teardrop and Oval. Both styles are lightweight (1-2 oz), hug friendly, and designed to stay put in pocketed bras, sports bras, camisoles, and dresses.<br/><br/></p>",
            "padding_top": 0,
            "padding_bottom": 12
          }
        },
        "question_MCiFie": {
          "type": "question",
          "settings": {
            "title": "How do I care for my Cloudz?",
            "text": "<p><strong>Bra inserts:</strong> Machine wash warm/cold in a delicates bag only or hand wash. Use gentle detergent, no bleach, do not iron or dry clean. Lay flat or hang to dry. <strong>Do not put inserts in the dryer.</strong><br/><br/><strong>Breast forms:</strong> Hand wash only. Use gentle detergent and lukewarm water. No bleach, do not iron, or dry clean. Lay flat or hang to dry. Do not put forms in the dryer.</p>",
            "padding_top": 0,
            "padding_bottom": 12
          }
        },
        "question_RMCXk7": {
          "type": "question",
          "settings": {
            "title": "What material are Honey Cloudz made from?",
            "text": "<p>82% Polyester, 18% Spandex. 100% Polyurethane Foam. Patented Non-Slip Grippy Dot Exterior 100% Medical Grade Silicone. Latex-free.</p>",
            "padding_top": 0,
            "padding_bottom": 0
          }
        }
      },
