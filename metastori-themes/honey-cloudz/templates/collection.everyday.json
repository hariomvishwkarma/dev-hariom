        "question_KNtKqt": {
          "type": "question",
          "settings": {
            "title": "Where do you ship?",
            "text": "<p>We ship both domestically (USA) and internationally from our warehouse in PA.</p>",
            "padding_top": 0,
            "padding_bottom": 12
          }
        },
        "question_mXtD3N": {
          "type": "question",
          "settings": {
            "title": "When will I receive my order?",
            "text": "<p>Most orders ship within 2 to 5 business days. Transit time depends on your location and shipping method.</p>",
            "padding_top": 0,
            "padding_bottom": 12
          }
        },
        "question_RRTHLz": {
          "type": "question",
          "settings": {
            "title": "How do I track my order?",
            "text": "<p>Once you’ve made you order, you'll receive a confirmation email with a tracking link as soon as your order ships. Click it to follow your package in real time.</p>",
            "padding_top": 0,
            "padding_bottom": 12
          }
        },
        "question_MLzwae": {
          "type": "question",
          "settings": {
            "title": "What is Checkout+ Protection?",
            "text": "<p>With Checkout+ Protection, returns and exchanges are reduced to just $1.98 instead of standard return postage costs.</p>",
            "padding_top": 0,
            "padding_bottom": 12
          }
        },
        "question_P7trpk": {
          "type": "question",
          "settings": {
            "title": "What is your return policy?",
            "text": "<p>Eligible unworn items may be returned within 30 days through our self-serve return portal. <br/><br/>Please see our <a href=\"/pages/returns-center\" target=\"_blank\" title=\"Returns Center\">Return Policy</a> for full details. <br/><br/>Have any questions or concerns? Please reach out to <a href=\"mailto:support@honeycloudz.com\" target=\"_blank\" title=\"mailto:support@honeycloudz.com\">support@honeycloudz.com</a> and we'd be happy to help!<br/><br/></p>",
            "padding_top": 0,
            "padding_bottom": 12
          }
        },
        "question_UprFEb": {
          "type": "question",
          "settings": {
            "title": "What is your exchange policy?",
            "text": "<p>Every USA customer receives a complimentary size or style exchange per order. <br/><br/>We cover outbound shipping on the replacement for free. <br/><br/>Customers cover the standard return postage or just $1.98 with Checkout+ Protection. </p>",
            "padding_top": 0,
            "padding_bottom": 0
          }
        }
