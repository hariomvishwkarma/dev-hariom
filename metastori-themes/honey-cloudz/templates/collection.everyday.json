    "custom_reviews_masonry_wBRfLt": {
      "type": "custom-reviews-masonry",
      "blocks": {
        "review_HYxyHx": {
          "type": "review",
          "settings": {
            "rating": 5,
            "headline": "I am so pleased with the Honey Cloudz inserts",
            "text": "<p>“My bathing suits came with flimsy inserts, so <strong>replaced them with honey cloudz and it gives more shape </strong>to the tops instead of looking flat. Looking forward to ordering more for my sports bras.\"</p>",
            "author": "Tanja",
            "show_verified": true
          }
        },
        "review_mDW4nJ": {
          "type": "review",
          "settings": {
            "rating": 5,
            "headline": "I purchased 1 pair and loved them so much I put in a reorder for 2",
            "text": "<p>“<strong>After spending well over $100 on a one-piece swimsuit I was absolutely teed off the the inserts in the suit shifted, folded over and actually bunched up</strong>. First off it was extremely embarrassing I mean the whole idea behind them was to cover you so no one new you were cold. On a google search I came across these and thought why not if they worked great if not I just would throw away a swimsuit I could not wear in public. I purchased 1 pair and loved them so much I put in a reorder for 2 more so now all my swimsuits have them.”</p>",
            "author": "Gina",
            "show_verified": true
          }
        },
        "review_BfdAyb": {
          "type": "review",
          "settings": {
            "rating": 5,
            "headline": "They don’t buckle like those ones that come with sports bras",
            "text": "<p>“I got the light xs inserts - they don’t buckle like those ones that come with sports bras and tops. <strong>You cannot even see their outline, they look smooth</strong>. I love them :)”</p>",
            "author": "Ellen C.",
            "show_verified": true
          }
        },
        "review_9WpA4H": {
          "type": "review",
          "settings": {
            "rating": 5,
            "headline": "Exactly What I Wanted",
            "text": "<p>“I buy these for the coverage and light shaping. <strong>It's subtle just a slight roundness. </strong>Exactly what I wanted.”</p>",
            "author": "Joan W.",
            "show_verified": true
          }
        },
        "review_F6hV3j": {
          "type": "review",
          "settings": {
            "rating": 5,
            "headline": "omg I love them",
            "text": "<p>“I have liked the classics for a long time. Was thrilled when I saw they released a thicker Plus+ version, omg I love them. <strong>They are the same great shape and provide more shaping!! I just love them.</strong> Please never stop making these!!”</p>",
            "author": "Eve L.",
            "show_verified": true
          }
        },
        "review_QgWGet": {
          "type": "review",
          "settings": {
            "rating": 5,
            "headline": "These are quality inserts",
            "text": "<p>“Threw away all of the crap inserts.<strong> I now have these and the Ovals Plus+ in my drawer and am so happy I found them</strong>. These are quality inserts and they have the best customer service!!”</p>",
            "author": "Mary L.",
            "show_verified": true
          }
        },
        "review_Hy9P4f": {
          "type": "review",
          "settings": {
            "rating": 5,
            "headline": "These fit perfectly in my sports bras and swimsuit tops.",
            "text": "<p>“These fit perfectly in my sports bras and swimsuit tops. <strong>They’re comfortable, stay put, and create a beautiful shape and fullness. </strong>Thank you!”</p>",
            "author": "Tiffany S.",
            "show_verified": true
          }
        },
        "review_cjKCEX": {
          "type": "review",
          "settings": {
            "rating": 5,
            "headline": "Love These!",
            "text": "<p>“Love these! <strong>They're versatile, comfortable and they stay put!</strong> YAY!”</p>",
            "author": "Joan W.",
            "show_verified": true
          }
        },
        "review_tLCPd7": {
          "type": "review",
          "settings": {
            "rating": 5,
            "headline": "I finally feel good and confident in my suit.",
            "text": "<p>“It's hard to admit but I had not worn a swimsuit in over 10 years, since before my kids were born. I had gained weight and just felt uncomfortable showing skin. My breasts lost their volume and shape as well. I didn't want to get surgery but what I did do is lose 30 lbs this year and bought Honey Cloudz for my new swimsuits. I finally feel good and confident in my suit. <strong>These inserts gave my breasts a better shape</strong>. They look natural, but just more youthful and shapely. It definitely helped to look and feel better.”</p>",
            "author": "Gina F.",
            "show_verified": true
          }
        },
        "review_R8yC8q": {
          "type": "review",
          "settings": {
            "rating": 5,
            "headline": "So much better",
            "text": "<p>“Work well in my running bra. <strong>So much better than the conventional pads that shift and crinkle.</strong>”</p>",
            "author": "Joan W.",
            "show_verified": true
          }
        },
        "review_mW8Riq": {
          "type": "review",
          "settings": {
            "rating": 5,
            "headline": "These inserts are wonderful",
            "text": "<p>“These inserts are wonderful and fill out the bra perfectly. I’ve waited a long time for something like things and <strong>now I don’t have to put other padding to make me look like I have my own breasts again</strong>. Thank you so much. Your products are a Blessing to others like myself.”</p>",
            "author": "Mary L.",
            "show_verified": true
          }
        },
        "review_GpFEAn": {
          "type": "review",
          "settings": {
            "rating": 5,
            "headline": "Completely solved a small size difference",
            "text": "<p>“The Honey Cloudz Ovals completely solved a small size difference between my natural breast and the reconstructed breast achieving a near perfect balance. <strong>Very happy with Honey Cloudz!”</strong></p>",
            "author": "Eve L.",
            "show_verified": true
          }
        },
        "review_47HJzh": {
          "type": "review",
          "settings": {
            "rating": 5,
            "headline": "Definitely the best inserts I have found.",
            "text": "<p>“These are definitely the best inserts I have found. <strong>They are a good thickness that provides coverage and shaping without too much padding</strong>. They don't get wrinkled after going through the wash and there is no fabric layer that starts to peel off like with other foam inserts.”</p>",
            "author": "Gina F.",
            "show_verified": true
          }
        }
      },
