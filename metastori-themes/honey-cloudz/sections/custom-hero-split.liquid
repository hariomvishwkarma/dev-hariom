{%- liquid
  assign layout_flip = section.settings.flip_layout
  assign media_type = section.settings.media_type
  assign media_fit = section.settings.media_fit
  if media_fit == blank
    assign media_fit = 'contain'
  endif

  assign has_video = false
  if media_type == 'video'
    if section.settings.video != blank or section.settings.video_url != blank
      assign has_video = true
    endif
  endif

  assign has_image = false
  if media_type == 'image' and section.settings.image != blank
    assign has_image = true
  endif

  assign show_media = false
  if has_video or has_image
    assign show_media = true
  endif

  assign media_source_first = false
  if template.suffix == 'everyday' and section.settings.media_first_mobile and has_image
    assign media_source_first = true
  endif
-%}

{%- style -%}
    #shopify-section-{{ section.id }} .chs {
      --chs-bg: {{ section.settings.background_color }};
      --chs-content-bg: {{ section.settings.content_background }};
      --chs-heading-color: {{ section.settings.heading_color }};
      --chs-text-color: {{ section.settings.text_color }};
      --chs-headline-color: {{ section.settings.headline_color | default: section.settings.heading_color }};
      --chs-headline-size: {{ section.settings.headline_font_size | default: 44 }}px;
      --chs-headline-size-mobile: {{ section.settings.headline_font_size_mobile | default: 28 }}px;
      --chs-badge-bg: {{ section.settings.badge_background }};
      --chs-badge-color: {{ section.settings.badge_text_color }};
      --chs-badge-border: {{ section.settings.badge_border_color }};
      --chs-star-color: {{ section.settings.star_color }};
      --chs-btn1-bg: {{ section.settings.button_1_background }};
      --chs-btn1-color: {{ section.settings.button_1_text_color }};
      --chs-btn2-bg: {{ section.settings.button_2_background }};
      --chs-btn2-color: {{ section.settings.button_2_text_color }};
      --chs-feature-bg: {{ section.settings.feature_background }};
      --chs-feature-border: {{ section.settings.feature_border_color }};
      --chs-check-bg: {{ section.settings.check_icon_background }};
      --chs-check-color: {{ section.settings.check_icon_color }};
      --chs-media-bg: {{ section.settings.media_background }};
      --chs-media-min-height: {{ section.settings.media_min_height }}px;
      --chs-media-max-height: {{ section.settings.media_max_height }}px;
      --chs-content-pad: {{ section.settings.content_padding }}px;
      --chs-heading-size: {{ section.settings.heading_font_size }}px;
      --chs-heading-size-mobile: {{ section.settings.heading_font_size_mobile }}px;
      background-color: var(--chs-bg);
      padding: {{ section.settings.padding_top }}px 0 {{ section.settings.padding_bottom }}px;
    }

    #shopify-section-{{ section.id }} .chs__grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      min-height: var(--chs-media-min-height);
    }

    #shopify-section-{{ section.id }} .chs--flip .chs__content {
      order: 2;
    }

    #shopify-section-{{ section.id }} .chs--flip .chs__media {
      order: 1;
    }

    @media screen and (min-width: 990px) {
      #shopify-section-{{ section.id }} .chs--media-source-first:not(.chs--flip) .chs__content {
        order: -1;
      }
    }

    #shopify-section-{{ section.id }} .chs__content {
      display: flex;
      align-items: center;
      background-color: var(--chs-content-bg);
      padding: var(--chs-content-pad);
    }

    #shopify-section-{{ section.id }} .chs__content-inner {
      width: 100%;
      max-width: {{ section.settings.content_max_width }}px;
      {% if section.settings.content_alignment == 'center' %}
        margin-inline: auto;
        text-align: center;
      {% elsif section.settings.content_alignment == 'right' %}
        margin-left: auto;
        text-align: right;
      {% else %}
        text-align: left;
      {% endif %}
    }

    #shopify-section-{{ section.id }} .chs__badge {
      display: inline-block;
      margin: 0 0 2.1rem;
      padding: 0.8rem 1.8rem;
      border: 0.1rem solid var(--chs-badge-border);
      border-radius: {{ section.settings.badge_border_radius }}px;
      background-color: var(--chs-badge-bg);
      color: var(--chs-badge-color);
      font-size: {{ section.settings.badge_font_size }}px;
      font-weight: {{ section.settings.badge_font_weight }};
      line-height: 1.2;
    }

    #shopify-section-{{ section.id }} .chs__headline {
      display: block;
      margin: 0 0 0.1rem;
      padding: 0;
      border: 0;
      background: transparent;
      color: var(--chs-headline-color);
      font-size: var(--chs-headline-size);
      font-weight: {{ section.settings.headline_font_weight | default: 500 }};
      line-height: 1.14;
    }

    #shopify-section-{{ section.id }} .chs__rating {
      display: flex;
      align-items: center;
      flex-wrap: wrap;
      gap: 1.3rem;
      margin: 0 0 2.1rem;
      {% if section.settings.content_alignment == 'center' %}
        justify-content: center;
      {% elsif section.settings.content_alignment == 'right' %}
        justify-content: flex-end;
      {% endif %}
    }

    #shopify-section-{{ section.id }} .chs__stars {
      display: inline-flex;
      gap: 0.2rem;
      color: var(--chs-star-color);
    }

    #shopify-section-{{ section.id }} .chs__stars svg {
      width: {{ section.settings.star_size }}px;
      height: {{ section.settings.star_size }}px;
      display: block;
    }

    #shopify-section-{{ section.id }} .chs__rating-text {
      margin: 0;
      color: var(--chs-text-color);
      font-size: {{ section.settings.rating_font_size }}px;
      line-height: 1.3;
    }

    #shopify-section-{{ section.id }} .chs__heading {
      margin: 0 0 3.35rem;
      color: var(--chs-heading-color);
      font-size: var(--chs-heading-size);
      font-weight: {{ section.settings.heading_font_weight }};
      line-height: 1.15;
    }

    #shopify-section-{{ section.id }} .chs__buttons {
      display: flex;
      flex-wrap: wrap;
      gap: 1rem;
      margin: 0 0 2rem;
      {% if section.settings.content_alignment == 'center' %}
        justify-content: center;
      {% elsif section.settings.content_alignment == 'right' %}
        justify-content: flex-end;
      {% endif %}
    }

    #shopify-section-{{ section.id }} .chs__btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      padding: 1rem 3rem;
      border-radius: {{ section.settings.button_border_radius }}px;
      font-size: {{ section.settings.button_font_size }}px;
      font-weight: {{ section.settings.button_font_weight }};
      text-decoration: none;
      line-height: 1.2;
      transition: opacity 0.2s ease;
      text-transform: capitalize;
      border: none;
      min-width: auto;
    }

    #shopify-section-{{ section.id }} .chs__btn--1 {
      background-color: var(--chs-btn1-bg);
      color: var(--chs-btn1-color);
    }

    #shopify-section-{{ section.id }} .chs__btn--2 {
      background-color: var(--chs-btn2-bg);
      color: var(--chs-btn2-color);
    }

    #shopify-section-{{ section.id }} .chs__trust {
      display: flex;
      flex-wrap: wrap;
      gap: 1.6rem 2.4rem;
      margin: 0 0 2rem;
      {% if section.settings.content_alignment == 'center' %}
        justify-content: center;
      {% elsif section.settings.content_alignment == 'right' %}
        justify-content: flex-end;
      {% endif %}
    }

    #shopify-section-{{ section.id }} .chs__trust-item {
      display: inline-flex;
      align-items: center;
      gap: 0.8rem;
      color: var(--chs-text-color);
      font-size: {{ section.settings.trust_font_size }}px;
      line-height: 1.3;
    }

    #shopify-section-{{ section.id }} .chs__trust-icon {
      flex: 0 0 {{ section.settings.trust_icon_size }}px;
      width: {{ section.settings.trust_icon_size }}px;
      height: {{ section.settings.trust_icon_size }}px;
    }

    #shopify-section-{{ section.id }} .chs__trust-icon img {
      width: 100%;
      height: 100%;
      object-fit: contain;
      display: block;
    }

    #shopify-section-{{ section.id }} .chs__description {
      margin: 0 0 2rem;
      color: var(--chs-text-color);
      font-size: {{ section.settings.description_font_size }}px;
      line-height: 1.55;
      font-weight: 500;
    }

    #shopify-section-{{ section.id }} .chs__description p {
      margin: 0 0 1rem;
    }

    #shopify-section-{{ section.id }} .chs__description p:last-child {
      margin-bottom: 0;
    }

    #shopify-section-{{ section.id }} .chs__features {
      display: flex;
      flex-direction: column;
      gap: {{ section.settings.feature_gap }}px;
      margin: 0;
      padding: 0;
      list-style: none;
    }

    #shopify-section-{{ section.id }} .chs__feature {
      display: flex;
      align-items: center;
      gap: 1rem;
      padding: {{ section.settings.feature_padding_y }}px {{ section.settings.feature_padding_x }}px;
      border: 0.1rem solid var(--chs-feature-border);
      border-radius: {{ section.settings.feature_border_radius }}px;
      background-color: var(--chs-feature-bg);
      color: var(--chs-text-color);
      font-size: {{ section.settings.feature_font_size }}px;
      font-weight: {{ section.settings.feature_font_weight }};
      line-height: 1.35;
      {% if section.settings.content_alignment == 'center' %}
        justify-content: center;
        text-align: center;
      {% elsif section.settings.content_alignment == 'right' %}
        justify-content: flex-end;
        text-align: right;
      {% endif %}
      max-width: 454px;
    }
    .custom-post-op-new #shopify-section-{{ section.id }} .chs__feature{
      font-weight: 400 !important;
    }

    #shopify-section-{{ section.id }} .chs__feature-check {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      flex: 0 0 {{ section.settings.check_icon_size }}px;
      width: {{ section.settings.check_icon_size }}px;
      height: {{ section.settings.check_icon_size }}px;
      border-radius: 50%;
      background-color: var(--chs-check-bg);
      color: var(--chs-check-color);
    }

    #shopify-section-{{ section.id }} .chs__feature-check svg {
      width: calc({{ section.settings.check_icon_size }}px * 0.5);
      height: calc({{ section.settings.check_icon_size }}px * 0.5);
      display: block;
    }

    #shopify-section-{{ section.id }} .chs__media {
      display: flex;
      align-items: center;
      justify-content: center;
      background-color: var(--chs-media-bg);
      min-height: var(--chs-media-min-height);
      overflow: hidden;
    }

    #shopify-section-{{ section.id }} .chs__media-inner {
      display: flex;
      align-items: center;
      justify-content: center;
      width: 100%;
      height: 100%;
      min-height: var(--chs-media-min-height);
      max-height: var(--chs-media-max-height);
      padding: {{ section.settings.media_padding }}px;
    }

    #shopify-section-{{ section.id }} .chs__media-inner img,
    #shopify-section-{{ section.id }} .chs__media-inner video {
      width: 100%;
      height: 100%;
      max-width: 100%;
      max-height: var(--chs-media-max-height);
      object-fit: {{ media_fit }};
      object-position: center;
      display: block;
    }
    @media screen and (min-width:990px) and (max-width: 1230px) {
      #shopify-section-{{ section.id }} .chs__media-inner img,
      #shopify-section-{{ section.id }} .chs__media-inner video {
        max-height: 950px;
        height: 950px;
      }
    }
    @media screen and (min-width: 1439px) {
    #shopify-section-{{ section.id }} .chs__grid {
      max-width: 1440px;
      margin: 0 auto;
      padding-inline: 50px;
      padding-right: 0px;
    }
    #shopify-section-{{ section.id }} .chs__content {
      padding-left: 0px;
    }
  }

  @media screen and (max-width: 1200px) {
    #shopify-section-{{ section.id }} .chs__content {
      padding: 4.8rem 1.5rem;
    }
    #shopify-section-{{ section.id }} .chs__content-inner {
      max-width: 100%;
    }
    #shopify-section-{{ section.id }} .chs__btn{
      font-size: 1.4rem;
    }
  }
    @media screen and (max-width: 989px) {
      #shopify-section-{{ section.id }} .chs__grid {
        grid-template-columns: 1fr;
      }

      #shopify-section-{{ section.id }} .chs--flip .chs__content,
      #shopify-section-{{ section.id }} .chs--flip .chs__media,
      #shopify-section-{{ section.id }} .chs__content,
      #shopify-section-{{ section.id }} .chs__media {
        order: unset;
      }

      {% if section.settings.media_first_mobile %}
        #shopify-section-{{ section.id }} .chs__media {
          order: -1;
        }
      {% endif %}

      #shopify-section-{{ section.id }} .chs__content {
        padding: 4.8rem 1.5rem;
      }
    }
    @media screen and (max-width: 749px) {
      #shopify-section-{{ section.id }} .chs__headline {
        font-size: var(--chs-headline-size-mobile);
      }
      #shopify-section-{{ section.id }} .chs__heading {
        font-size: var(--chs-heading-size-mobile);
      }
      #shopify-section-{{ section.id }} .chs__description,
      #shopify-section-{{ section.id }} .chs__description p {
        font-size: {{ section.settings.description_font_size }}px;
      }
      #shopify-section-{{ section.id }} .chs__media-inner img{
        max-height:550px;
      }
      #shopify-section-{{ section.id }} .chs__media {
        height: 100%;
        min-height: 400px;
        max-height: 550px;
      }

    }
    @media screen and (max-width: 479px) {
      #shopify-section-{{ section.id }} .chs__buttons{
        display: flex;
        flex-wrap: nowrap;
        gap: 1rem;
        margin: 0 0 2rem;
        
      }
      #shopify-section-{{ section.id }} .chs__btn{
        font-size: 1.4rem;
        text-align: center;
        padding: 1.3rem;
        width: 50%;
        max-width: 50%;
        white-space: normal;
        overflow-wrap: break-word;
        word-break: break-word;
      }
      #shopify-section-{{ section.id }} .chs__media-inner img{
        max-height: 100%;
      }
       #shopify-section-{{ section.id }} .chs__media {
          height: 100%;
          min-height: 300px;
          max-height: 425px;
       }
       #shopify-section-{{ section.id }} .chs__content {
        padding: 2.4rem 1.5rem;
      }
    }
{%- endstyle -%}

<div class="chs{% if layout_flip %} chs--flip{% endif %}{% if media_source_first %} chs--media-source-first{% endif %}">
  <div class="chs__grid">
    {%- capture hero_content -%}
    <div class="chs__content">
      <div class="chs__content-inner">
        {%- if section.settings.headline != blank -%}
          <p class="chs__headline">{{ section.settings.headline | escape }}</p>
        {%- endif -%}
        {%- if section.settings.badge != blank -%}
          <span class="chs__badge">{{ section.settings.badge | escape }}</span>
        {%- endif -%}

        {%- if section.settings.show_rating and section.settings.rating_text != blank -%}
          <div class="chs__rating">
            {%- if section.settings.show_stars -%}
              <span class="chs__stars" aria-hidden="true">
                {%- for i in (1..5) -%}
                  <svg viewBox="0 0 16 16" fill="currentColor" xmlns="http://www.w3.org/2000/svg">
                    <path d="M8 1.2L9.9 5.8L14.8 6.1L11.1 9.2L12.2 14.1L8 11.6L3.8 14.1L4.9 9.2L1.2 6.1L6.1 5.8L8 1.2Z"/>
                  </svg>
                {%- endfor -%}
              </span>
            {%- endif -%}
            <p class="chs__rating-text">{{ section.settings.rating_text | escape }}</p>
          </div>
        {%- endif -%}

        {%- if section.settings.heading != blank -%}
          <{{ section.settings.heading_tag }} class="chs__heading">
            {{ section.settings.heading | escape }}
          </{{ section.settings.heading_tag }}>
        {%- endif -%}

        {%- if section.settings.button_1_label != blank or section.settings.button_2_label != blank -%}
          <div class="chs__buttons">
            {%- if section.settings.button_1_label != blank -%}
              <a
                class="button button--medium chs__btn chs__btn--1"
                {% if section.settings.button_1_link != blank %}
                  href="{{ section.settings.button_1_link }}"
                {% else %}
                  role="link" aria-disabled="true"
                {% endif %}
              >
                {{ section.settings.button_1_label | escape }}
              </a>
            {%- endif -%}
            {%- if section.settings.button_2_label != blank -%}
              <a
                class="button button--medium chs__btn chs__btn--2"
                {% if section.settings.button_2_link != blank %}
                  href="{{ section.settings.button_2_link }}"
                {% else %}
                  role="link" aria-disabled="true"
                {% endif %}
              >
                {{ section.settings.button_2_label | escape }}
              </a>
            {%- endif -%}
          </div>
        {%- endif -%}

        {%- if section.settings.trust_1_text != blank or section.settings.trust_2_text != blank -%}
          <div class="chs__trust">
            {%- if section.settings.trust_1_text != blank -%}
              <div class="chs__trust-item">
                {%- if section.settings.trust_1_icon != blank -%}
                  <span class="chs__trust-icon">
                    {{ section.settings.trust_1_icon | image_url: width: 80 | image_tag: loading: 'lazy', alt: '' }}
                  </span>
                {%- endif -%}
                <span>{{ section.settings.trust_1_text | escape }}</span>
              </div>
            {%- endif -%}
            {%- if section.settings.trust_2_text != blank -%}
              <div class="chs__trust-item">
                {%- if section.settings.trust_2_icon != blank -%}
                  <span class="chs__trust-icon">
                    {{ section.settings.trust_2_icon | image_url: width: 80 | image_tag: loading: 'lazy', alt: '' }}
                  </span>
                {%- endif -%}
                <span>{{ section.settings.trust_2_text | escape }}</span>
              </div>
            {%- endif -%}
          </div>
        {%- endif -%}

        {%- if section.settings.description != blank -%}
          <div class="chs__description rte">{{ section.settings.description }}</div>
        {%- endif -%}

        {%- if section.blocks.size > 0 -%}
          <ul class="chs__features" role="list">
            {%- for block in section.blocks -%}
              {%- comment -%} Wholesale_Club_Product_Visibility_For_Loop Start {%- endcomment -%}
              {%- capture hide_resource -%}{% render "wc_product_visibility", resource: block %}{%- endcapture -%}
              {%- if hide_resource == 'true' -%}
                {% continue %}
              {%- endif -%}
              {%- comment -%} Wholesale_Club_Product_Visibility_For_Loop End {%- endcomment -%}

              {%- if block.settings.text != blank -%}
                <li class="chs__feature" {{ block.shopify_attributes }}>
                  {%- if block.settings.show_check -%}
                    <span class="chs__feature-check" aria-hidden="true">
                      <svg viewBox="0 0 12 10" fill="none" xmlns="http://www.w3.org/2000/svg">
                        <path d="M1 5.2L4.2 8.4L11 1.4" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
                      </svg>
                    </span>
                  {%- endif -%}
                  <span>{{ block.settings.text | escape }}</span>
                </li>
              {%- endif -%}
            {%- endfor -%}
          </ul>
        {%- endif -%}
      </div>
    </div>

    {%- endcapture -%}
    {%- unless media_source_first -%}
      {{ hero_content }}
    {%- endunless -%}

    {%- if show_media -%}
      <div class="chs__media">
        <div class="chs__media-inner">
          {%- if has_video -%}
            {%- if section.settings.video != blank -%}
              {{
                section.settings.video
                | video_tag:
                  image_size: '1100x',
                  autoplay: section.settings.video_autoplay,
                  loop: section.settings.video_loop,
                  muted: true,
                  playsinline: true,
                  controls: section.settings.video_controls,
                  class: 'chs__video'
              }}
            {%- elsif section.settings.video_url != blank -%}
              <video
                class="chs__video"
                src="{{ section.settings.video_url }}"
                {% if section.settings.video_autoplay %}
                  autoplay
                {% endif %}
                {% if section.settings.video_loop %}
                  loop
                {% endif %}
                muted
                playsinline
                {% if section.settings.video_controls %}
                  controls
                {% endif %}
              ></video>
            {%- endif -%}
          {%- elsif has_image -%}
            {%- liquid
              assign hero_image_alt = section.settings.image.alt | default: section.settings.heading | escape
            -%}
            {{
              section.settings.image
              | image_url: width: 1600
              | image_tag: loading: 'lazy', widths: '400, 600, 800, 1000, 1200, 1600', alt: hero_image_alt
            }}
          {%- endif -%}
        </div>
      </div>
    {%- endif -%}
    {%- if media_source_first -%}
      {{ hero_content }}
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "Custom hero split",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "checkbox",
      "id": "flip_layout",
      "label": "Flip layout (media on left)",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "media_first_mobile",
      "label": "Show media first on mobile",
      "default": true
    },
    {
      "type": "select",
      "id": "content_alignment",
      "label": "Content alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ],
      "default": "left"
    },
    {
      "type": "range",
      "id": "content_max_width",
      "min": 320,
      "max": 700,
      "step": 10,
      "unit": "px",
      "label": "Content max width",
      "default": 520
    },
    {
      "type": "range",
      "id": "content_padding",
      "min": 16,
      "max": 80,
      "step": 4,
      "unit": "px",
      "label": "Content padding",
      "default": 48
    },
    {
      "type": "header",
      "content": "Media"
    },
    {
      "type": "select",
      "id": "media_type",
      "label": "Media type",
      "options": [
        { "value": "image", "label": "Image" },
        { "value": "video", "label": "Video" }
      ],
      "default": "image"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "video",
      "id": "video",
      "label": "Shopify video"
    },
    {
      "type": "text",
      "id": "video_url",
      "label": "Video URL (MP4 fallback)",
      "info": "Use if not uploading via Shopify video field."
    },
    {
      "type": "checkbox",
      "id": "video_autoplay",
      "label": "Video autoplay",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "video_loop",
      "label": "Video loop",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "video_controls",
      "label": "Show video controls",
      "default": false
    },
    {
      "type": "select",
