{%- style -%}
  #shopify-section-{{ section.id }} {
    --section-padding-top: {{ section.settings.padding_top }}px;
    --section-padding-bottom: {{ section.settings.padding_bottom }}px;
    --hc-it-bg: {{ section.settings.background_color }};
    --hc-it-radius: {{ section.settings.image_radius }}px;
    --hc-it-gap: {{ section.settings.gap }}px;
  }

  .hc-image-text {
    background: var(--hc-it-bg);
    padding-top: calc(var(--section-padding-top) * 0.75);
    padding-bottom: calc(var(--section-padding-bottom) * 0.75);
  }

  @media screen and (min-width: 750px) {
    .hc-image-text {
      padding-top: var(--section-padding-top);
      padding-bottom: var(--section-padding-bottom);
    }
  }

  .hc-image-text__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: calc(var(--hc-it-gap) * 0.75);
    align-items: center;
  }

  @media screen and (min-width: 990px) {
    .hc-image-text__grid {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1.25fr);
      gap: var(--hc-it-gap);
    }
  }

  .hc-image-text__media {
    border-radius: var(--hc-it-radius);
    overflow: hidden;
    background: rgba(0, 0, 0, 0.04);
    border: 1px solid #000;
  }

  .hc-image-text__media img {
    width: 100%;
    height: auto;
    display: block;
  }

  .hc-image-text__content {
    max-width: 66rem;
  }

  .hc-image-text__heading {
    margin: 0 0 1.2rem;
    letter-spacing: 0;
  }

  .hc-image-text__text {
    margin: 0;
    color: rgba(var(--color-foreground), 0.85);
    font-size: 1.5rem;
    line-height: 1.65;
  }

  @media screen and (min-width: 750px) {
    .hc-image-text__text {
      font-size: 1.6rem;
    }
  }

  .hc-image-text__text p {
    margin: 0 0 1.2rem;
  }

  .hc-image-text__text p:last-child {
    margin-bottom: 0;
  }

  .hc-image-text__link {
    display: inline-flex;
    align-items: center;
    gap: 0.8rem;
    margin-top: 1.6rem;
    text-decoration: underline;
    color: rgb(var(--color-foreground));
    font-weight: 800;
    font-size: 1.3rem;
  }

  .hc-image-text__link:hover {
    text-decoration: underline;
  }

  .hc-image-text__link-icon {
    width: 14px;
    height: 14px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
  }

  .hc-image-text__link-icon svg {
    width: 14px;
    height: 14px;
    fill: currentColor;
  }
{%- endstyle -%}

<section class="hc-image-text">
  <div class="page-width">
    <div class="hc-image-text__grid">
      <div class="hc-image-text__media">
        {%- if section.settings.image != blank -%}
          {{
            section.settings.image
            | image_url: width: 1600
            | image_tag:
              loading: 'lazy',
              widths: '550, 750, 990, 1200, 1600',
              sizes: '(min-width: 990px) 40vw, 100vw',
              alt: section.settings.image_alt
          }}
        {%- else -%}
          {{ 'image' | placeholder_svg_tag: 'placeholder' }}
        {%- endif -%}
      </div>

      <div class="hc-image-text__content">
        <{{ section.settings.heading_tag }} class="hc-image-text__heading {{ section.settings.heading_size }}">
          {{ section.settings.heading | escape }}
        </{{ section.settings.heading_tag }}>

        {%- if section.settings.text != blank -%}
          <div class="hc-image-text__text rte">
            {{ section.settings.text }}
          </div>
        {%- endif -%}

        {%- if section.settings.link_label != blank and section.settings.link_url != blank -%}
          <a class="hc-image-text__link" href="{{ section.settings.link_url }}">
            <span class="label">{{ section.settings.link_label | escape }}</span>
            <span class="hc-image-text__link-icon" aria-hidden="true">
              <svg width="16" height="16" viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg">
                <path d="M1 8C1 9.38447 1.41054 10.7378 2.17971 11.889C2.94888 13.0401 4.04213 13.9373 5.32122 14.4672C6.6003 14.997 8.00776 15.1356 9.36563 14.8655C10.7235 14.5954 11.9708 13.9287 12.9497 12.9497C13.9287 11.9708 14.5954 10.7235 14.8655 9.36563C15.1356 8.00776 14.997 6.6003 14.4672 5.32122C13.9373 4.04213 13.0401 2.94888 11.889 2.17971C10.7378 1.41054 9.38447 1 8 1C6.14348 1 4.36301 1.7375 3.05025 3.05025C1.7375 4.36301 1 6.14348 1 8ZM4 7.5H10.075L7.285 4.6965L8 4L12 8L8 12L7.285 11.2865L10.075 8.5H4V7.5Z" fill="#E47BB5"/>
              </svg>
            </span>
          </a>
        {%- endif -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Homepage image + text",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "default": "#f6efe9"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "text",
      "id": "image_alt",
      "label": "Image alt text",
      "default": "Story image"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Every Woman Deserves Comfort Without Compromise"
    },
    {
      "type": "select",
      "id": "heading_tag",
      "label": "Heading tag",
      "options": [
        { "value": "h2", "label": "H2" },
        { "value": "h3", "label": "H3" },
        { "value": "div", "label": "Div" }
      ],
      "default": "h2"
    },
    {
      "type": "select",
      "id": "heading_size",
      "label": "Heading size",
      "options": [
        { "value": "h2", "label": "Small" },
        { "value": "h1", "label": "Medium" },
        { "value": "h0", "label": "Large" }
      ],
      "default": "h1"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>After 15 years in swimwear design, our founder Angela was done watching women struggle with inserts that slipped, bunched, and fell apart. So she built the first patented non-slip bra insert—designed to stay put without adhesives or constant adjusting.</p><p>When women recovering from mastectomies reached out for lighter alternatives to heavy, uncomfortable breast forms, we expanded. Working alongside breast health nurses and professional bra fitters, we created lightweight, breathable post-op solutions designed with real bodies and real life in mind.</p><p>At Honey Cloudz, we listen closely, design with intention, and never stop improving.</p>"
    },
    {
      "type": "text",
      "id": "link_label",
      "label": "Link label",
      "default": "Learn More About Our Story"
    },
    {
      "type": "url",
      "id": "link_url",
      "label": "Link URL"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "image_radius",
      "label": "Image corner radius",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 24
    },
    {
      "type": "range",
      "id": "gap",
      "label": "Column gap",
      "min": 16,
      "max": 80,
      "step": 4,
      "unit": "px",
      "default": 56
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Padding top",
      "default": 56
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Padding bottom",
      "default": 56
    }
  ],
  "presets": [
    {
      "name": "Homepage image + text",
      "category": "Homepage"
    }
  ]
}
{% endschema %}

