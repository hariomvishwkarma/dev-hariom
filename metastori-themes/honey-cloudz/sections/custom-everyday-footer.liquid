{%- liquid
  assign footer_logo = section.settings.logo
  if footer_logo == blank
    assign footer_logo = settings.checkout_logo_image
  endif
  if footer_logo == blank
    assign footer_logo = settings.logo
  endif

  assign copyright_year = 'now' | date: '%Y'
  assign copyright_name = section.settings.copyright_name | default: shop.name
-%}

{%- style -%}
  #shopify-section-{{ section.id }} .cef {
    background-color: {{ section.settings.background_color }};
    color: {{ section.settings.text_color }};
    padding: {{ section.settings.padding_top }}px 1.5rem {{ section.settings.padding_bottom }}px;
  }

  #shopify-section-{{ section.id }} .cef__inner {
    max-width: {{ section.settings.content_max_width }}px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: {{ section.settings.content_gap }}px;
  }

  #shopify-section-{{ section.id }} .cef__logo-link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    text-decoration: none;
    line-height: 0;
  }

  #shopify-section-{{ section.id }} .cef__logo {
    display: block;
    width: auto;
    height: auto;
    max-width: {{ section.settings.logo_width }}px;
    max-height: {{ section.settings.logo_height }}px;
    object-fit: contain;
  }

  #shopify-section-{{ section.id }} .cef__copyright {
    margin: 0;
    color: {{ section.settings.text_color }};
    font-size: {{ section.settings.copyright_font_size }}px;
    line-height: 1.4;
    font-weight: {{ section.settings.copyright_font_weight }};
  }

  #shopify-section-{{ section.id }} .cef__links {
    margin: 0;
    display: inline-flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 0.75rem;
    font-size: {{ section.settings.links_font_size }}px;
    line-height: 1.4;
    font-weight: {{ section.settings.links_font_weight }};
  }

  #shopify-section-{{ section.id }} .cef__link {
    color: {{ section.settings.link_color }};
    text-decoration: none;
    transition: opacity 0.2s ease;
  }

  #shopify-section-{{ section.id }} .cef__link:hover,
  #shopify-section-{{ section.id }} .cef__link:focus-visible {
    opacity: 0.8;
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  #shopify-section-{{ section.id }} .cef__separator {
    color: {{ section.settings.text_color }};
    opacity: 0.85;
    user-select: none;
  }

  @media screen and (max-width: 749px) {
    #shopify-section-{{ section.id }} .cef {
      padding-top: {{ section.settings.padding_top_mobile }}px;
      padding-bottom: {{ section.settings.padding_bottom_mobile }}px;
    }

    #shopify-section-{{ section.id }} .cef__logo {
      max-width: {{ section.settings.logo_width_mobile }}px;
      max-height: {{ section.settings.logo_height_mobile }}px;
    }

    #shopify-section-{{ section.id }} .cef__copyright {
      font-size: {{ section.settings.copyright_font_size_mobile }}px;
    }

    #shopify-section-{{ section.id }} .cef__links {
      font-size: {{ section.settings.links_font_size_mobile }}px;
    }
  }
{%- endstyle -%}

<footer class="cef" role="contentinfo">
  <div class="cef__inner">
    {%- if footer_logo != blank -%}
      {%- if section.settings.logo_link != blank -%}
        <a class="cef__logo-link" href="{{ section.settings.logo_link }}">
      {%- else -%}
        <a class="cef__logo-link" href="{{ routes.root_url }}">
      {%- endif -%}
        {{
          footer_logo
          | image_url: width: 400
          | image_tag:
            loading: 'lazy',
            class: 'cef__logo',
            widths: '120, 160, 200, 240, 320, 400',
            sizes: '(min-width: 750px) 160px, 120px',
            alt: section.settings.logo_alt | default: shop.name | escape
        }}
      </a>
    {%- endif -%}

    {%- if section.settings.show_copyright -%}
      <p class="cef__copyright">
        {{- section.settings.copyright_prefix | escape }} {{ copyright_year -}}
        {%- if copyright_name != blank -%}, {{ copyright_name | escape }}{%- endif -%}
      </p>
    {%- endif -%}

    {%- if section.settings.show_terms or section.settings.show_privacy -%}
      <p class="cef__links">
        {%- if section.settings.show_terms and section.settings.terms_label != blank -%}
          <a class="cef__link" href="{{ section.settings.terms_url | default: '/policies/terms-of-service' }}">
            {{ section.settings.terms_label | escape }}
          </a>
        {%- endif -%}

        {%- if section.settings.show_terms and section.settings.show_privacy and section.settings.terms_label != blank and section.settings.privacy_label != blank -%}
          <span class="cef__separator" aria-hidden="true">|</span>
        {%- endif -%}

        {%- if section.settings.show_privacy and section.settings.privacy_label != blank -%}
          <a class="cef__link" href="{{ section.settings.privacy_url | default: '/policies/privacy-policy' }}">
            {{ section.settings.privacy_label | escape }}
          </a>
        {%- endif -%}
      </p>
    {%- endif -%}
  </div>
</footer>

{% schema %}
{
  "name": "Custom everyday footer",
  "tag": "section",
  "class": "section custom-everyday-footer-section",
  "disabled_on": {
    "groups": ["header", "footer", "custom.overlay"]
  },
  "settings": [
    {
      "type": "header",
      "content": "Logo"
    },
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Logo image",
      "info": "Leave blank to use the checkout logo, then theme logo."
    },
    {
      "type": "text",
      "id": "logo_alt",
      "label": "Logo alt text",
      "default": "Honey Cloudz"
    },
    {
      "type": "url",
      "id": "logo_link",
      "label": "Logo link",
      "info": "Defaults to homepage when empty."
    },
    {
      "type": "range",
      "id": "logo_width",
      "min": 80,
      "max": 240,
      "step": 4,
      "unit": "px",
      "label": "Logo max width (desktop)",
      "default": 140
    },
    {
      "type": "range",
      "id": "logo_height",
      "min": 24,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Logo max height (desktop)",
      "default": 56
    },
    {
      "type": "range",
      "id": "logo_width_mobile",
      "min": 72,
      "max": 200,
      "step": 4,
      "unit": "px",
      "label": "Logo max width (mobile)",
      "default": 120
    },
    {
      "type": "range",
      "id": "logo_height_mobile",
      "min": 20,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Logo max height (mobile)",
      "default": 48
    },
    {
      "type": "header",
      "content": "Copyright"
    },
    {
      "type": "checkbox",
      "id": "show_copyright",
      "label": "Show copyright",
      "default": true
    },
    {
      "type": "text",
      "id": "copyright_prefix",
      "label": "Copyright prefix",
      "default": "©"
    },
    {
      "type": "text",
      "id": "copyright_name",
      "label": "Copyright name",
      "default": "Honey Cloudz"
    },
    {
      "type": "range",
      "id": "copyright_font_size",
      "min": 11,
      "max": 18,
      "step": 1,
      "unit": "px",
      "label": "Copyright font size (desktop)",
      "default": 13
    },
    {
      "type": "range",
      "id": "copyright_font_size_mobile",
      "min": 11,
      "max": 18,
      "step": 1,
      "unit": "px",
      "label": "Copyright font size (mobile)",
      "default": 12
    },
    {
      "type": "select",
      "id": "copyright_font_weight",
      "label": "Copyright font weight",
      "default": "400",
      "options": [
        { "value": "400", "label": "Regular (400)" },
        { "value": "500", "label": "Medium (500)" }
      ]
    },
    {
      "type": "header",
      "content": "Legal links"
    },
    {
      "type": "checkbox",
      "id": "show_terms",
      "label": "Show Terms of Service",
      "default": true
    },
    {
      "type": "text",
      "id": "terms_label",
      "label": "Terms label",
      "default": "Terms of Service"
    },
    {
      "type": "url",
      "id": "terms_url",
      "label": "Terms URL"
    },
    {
      "type": "checkbox",
      "id": "show_privacy",
      "label": "Show Privacy Policy",
      "default": true
    },
    {
      "type": "text",
      "id": "privacy_label",
      "label": "Privacy label",
      "default": "Privacy Policy"
    },
    {
      "type": "url",
      "id": "privacy_url",
      "label": "Privacy URL"
    },
    {
      "type": "range",
      "id": "links_font_size",
      "min": 0,
      "max": 18,
      "step": 1,
      "unit": "px",
      "label": "Links font size (desktop)",
      "default": 13
    },
    {
      "type": "range",
      "id": "links_font_size_mobile",
      "min": 0,
      "max": 18,
      "step": 1,
      "unit": "px",
      "label": "Links font size (mobile)",
      "default": 12
    },
    {
      "type": "select",
      "id": "links_font_weight",
      "label": "Links font weight",
      "default": "400",
      "options": [
        { "value": "400", "label": "Regular (400)" },
        { "value": "500", "label": "Medium (500)" }
      ]
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "content_max_width",
      "min": 320,
      "max": 900,
      "step": 20,
      "unit": "px",
      "label": "Content max width",
      "default": 640
    },
    {
      "type": "range",
      "id": "content_gap",
      "min": 0,
      "max": 32,
      "step": 2,
      "unit": "px",
      "label": "Vertical spacing",
      "default": 14
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Padding top (desktop)",
      "default": 56
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Padding bottom (desktop)",
      "default": 56
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "min": 0,
      "max": 96,
      "step": 4,
      "unit": "px",
      "label": "Padding top (mobile)",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "min": 0,
      "max": 96,
      "step": 4,
      "unit": "px",
      "label": "Padding bottom (mobile)",
      "default": 40
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background",
      "default": "#1e2124"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "link_color",
      "label": "Links",
      "default": "#ffffff"
    }
  ],
  "presets": [
    {
      "name": "Custom everyday footer"
    }
  ]
}
{% endschema %}
