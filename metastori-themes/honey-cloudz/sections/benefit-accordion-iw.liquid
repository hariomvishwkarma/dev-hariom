{% comment %}
  Section: Benefits Accordion
{% endcomment %}

{% schema %}
{
  "name": "Benefits Accordion",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Benefits of Honey Cloudz"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Bra Inserts for Swimsuits"
    },
    {
      "type": "checkbox",
      "id": "side_by_side",
      "label": "Show heading & subheading side by side",
      "default": false
    },
    {
      "type": "range",
      "id": "section_padding_top",
      "label": "Padding Top",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "section_padding_bottom",
      "label": "Padding Bottom",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "section_mob_padding_top",
      "label": "Mobile Padding Top",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "section_mob_padding_bottom",
      "label": "Mobile Padding Bottom",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "default": 40
    }
  ],
  "blocks": [
    {
      "type": "benefit",
      "name": "Benefit",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Benefit Title",
          "default": "Seamless / Undetectable"
        },
        {
          "type": "richtext",
          "id": "content",
          "label": "Benefit Description"
        }
      ]
    }
  ],
  "max_blocks": 10,
  "presets": [
    {
      "name": "Benefits Accordion",
      "category": "Custom Sections"
    }
  ]
}
{% endschema %}

<section id="benefits-accordion-{{ section.id }}"
         class="benefits-accordion"
         style="padding-top: {{ section.settings.section_padding_top }}px; padding-bottom: {{ section.settings.section_padding_bottom }}px;">

  <div class="container">
    <div class="benefits-heading-wrapper {% if section.settings.side_by_side %}side-by-side{% endif %}">
  {% if section.settings.heading != blank %}
    <h2 class="benefits-heading">{{ section.settings.heading }}</h2>
  {% endif %}
  {% if section.settings.subheading != blank %}
    <p class="benefits-subheading">{{ section.settings.subheading }}</p>
  {% endif %}
</div>

    <div class="accordion">
      {% for block in section.blocks %}
        <div class="accordion-item{% if forloop.first %} active{% endif %}" data-accordion-item>
          <button class="accordion-header" type="button" aria-expanded="{% if forloop.first %}true{% else %}false{% endif %}">
            <span>{{ block.settings.title }}</span>
            <span class="accordion-icon">
              <img src="https://cdn.shopify.com/s/files/1/1711/0419/files/guidance_left-arrow.svg?v=1759248700" alt="">
            </span>
          </button>
          {% if block.settings.content != blank %}
            <div class="accordion-content" {% if forloop.first %}style="display:block;"{% endif %}>
              <p>{{ block.settings.content }}</p>
            </div>
          {% endif %}
        </div>
      {% endfor %}
    </div>
  </div>
</section>


<style>
{% comment %} .benefits-accordion {
  background: #fdf5f2;
} {% endcomment %}
.benefits-heading {
  text-align: center;
  font-size: 48px;
  margin-bottom: 5px;
  font-family: "Send Flowers", cursive;
  font-weight: 400;
  font-style: normal;
  letter-spacing:normal;
}
.benefits-subheading {
  text-align: center;
  font-size: 40px;
  margin-bottom: 40px;
  font-family: "Poppins", sans-serif;
  font-weight: 400;
  font-style: normal;
  margin-top:0px;
  letter-spacing:normal;
}

.benefits-heading-wrapper {
    text-align: center;
    margin-bottom: 56px;
  }
/* Default → stacked (2 lines) */
  .benefits-heading-wrapper .benefits-heading,
  .benefits-heading-wrapper .benefits-subheading {
    display: block;
    margin: 0;
  }

  /* Checkbox ON → side by side */
  .benefits-heading-wrapper.side-by-side {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 10px; /* spacing between heading and subheading */
    flex-wrap: wrap;
  }

  .benefits-heading-wrapper.side-by-side .benefits-heading,
  .benefits-heading-wrapper.side-by-side .benefits-subheading {
    display: inline-block;
    margin: 0;
  }

.benefits-accordion .accordion {
  max-width: 840px;
  margin: 0 auto;
  border:0px;
}
.benefits-accordion .accordion a{
  color:#000;
}
.accordion-item {
  margin-bottom: 12px;

  overflow: hidden;
}
.accordion-header {
  width: 100%;
  padding: 16px 24px;
  text-align: left;
  font-size: 16px;
  font-weight: 600;
  background: transparent;
  border: none;
  display: flex;
  justify-content: space-between;
  align-items: center;
  cursor: pointer;
    border-radius: 30px;
  background: #bce5f4;
  color:black;
      border: 1px solid rgb(51 51 51 / 60%); letter-spacing:normal;
}
.accordion-icon {
  transition: transform 0.3s ease;
  display: inline-block;
  transform: rotate(270deg);
}
.accordion-item.active .accordion-icon {
  transform: rotate(0deg);
}
.accordion-content {
  display: none;
  padding: 16px 24px 16px;
  font-size: 14px;
  line-height: 1.6; letter-spacing:normal;
}
.accordion-content p{
    color: #333;
    font-family: 'Satoshi';
    font-weight: 500;
    font-size:18px; letter-spacing:normal;
}
.accordion-item.active .accordion-content {
  display: block;
}
@media (max-width: 1350px) {
.benefits-accordion {
    padding-left: 30px;
    padding-right: 30px;
}
}
/* Mobile */
@media (max-width: 768px) {
  .benefits-accordion{
    padding-top: {{ section.settings.section_mob_padding_top }}px !important;
    padding-bottom: {{ section.settings.section_mob_padding_bottom }}px !important;
    padding-left:20px;
    padding-right:20px;
  }
  .benefits-heading { font-size: 32px; }
  .benefits-subheading { font-size: 30px; }
  .accordion-header { font-size: 14px; padding: 14px 18px; }

  .accordion-content p{ font-size:14px; }
  .benefits-heading-wrapper.side-by-side {
    display: block;
  }
  .benefits-heading-wrapper {
    text-align: center;
    margin-bottom: 36px;
}
}
</style>

<script>
document.addEventListener('DOMContentLoaded', function() {
  // use the unique ID that Shopify provides
  const sectionEl = document.getElementById('benefits-accordion-{{ section.id }}');
  if (!sectionEl) return;

  const items = sectionEl.querySelectorAll('[data-accordion-item]');

  items.forEach(item => {
    const header = item.querySelector('.accordion-header');
    const content = item.querySelector('.accordion-content');

    header.addEventListener('click', function() {
      const isActive = item.classList.contains('active');

      // close everything in this section only
      items.forEach(i => {
        i.classList.remove('active');
        i.querySelector('.accordion-header').setAttribute('aria-expanded', 'false');
        const c = i.querySelector('.accordion-content');
        if (c) c.style.display = 'none';
      });

      // open the clicked one
      if (!isActive) {
        item.classList.add('active');
        header.setAttribute('aria-expanded', 'true');
        if (content) content.style.display = 'block';
      }
    });
  });
});
</script>





