{%- liquid
  assign preset = section.settings.design_preset
  if preset == blank
    assign preset = 'inserts'
  endif
-%}
{% include 'pdp-assets' %}
{% include 'pdp-responsive-fixes' %}

<style>
  /* Kill any margin/padding the theme puts on section wrappers — the Replo
     markup already carries its own vertical rhythm. */
  #shopify-section-{{ section.id }} { margin: 0; padding: 0; }
  #pdp-sec-{{ section.id }} {
    margin-top: {{ section.settings.space_above_desktop }}px;
  }
  /* Every section carries pdp-wrap-open's 60px/80px Replo gap div. That is the
     'extra' space, so the setting drives it. Id doubled to beat the !important
     rules in tbf2-pdp-ui.css / hc-pdp-ui.css. */
  #pdp-sec-{{ section.id }}#pdp-sec-{{ section.id }} [data-pdp-gap] {
    padding-top: {{ section.settings.padding_top }}px !important;
    padding-bottom: {{ section.settings.padding_bottom }}px !important;
  }
  @media (max-width: 640px) {
    #pdp-sec-{{ section.id }} { margin-top: {{ section.settings.space_above_mobile }}px; }
    #pdp-sec-{{ section.id }}#pdp-sec-{{ section.id }} [data-pdp-gap] {
      padding-top: {{ section.settings.padding_top_mobile }}px !important;
      padding-bottom: {{ section.settings.padding_bottom_mobile }}px !important;
    }
  }
</style>

<div id="pdp-sec-{{ section.id }}" data-pdp-sec="howto-wear" data-pdp-preset="{{ preset }}" data-section-id="{{ section.id }}"{% if section.settings.headline_poppins %} data-pdp-headline="poppins"{% endif %}>
  {% render 'pdp-wrap-open', preset: preset, group: 'a' %}
    {%- comment -%} only the Inserts design has this section {%- endcomment -%}
    {% include 'pdp-howto-wear--inserts' %}
  {% render 'pdp-wrap-close', preset: preset %}
</div>

{%- comment -%}
  Each pdp-* section contributes its own slice of the globals that
  hc-pdp.js / tbf2-pdp.js read. Merge, never replace, so the order the
  client drags these sections into does not matter.
{%- endcomment -%}
<script>
  (function () {
{%- if preset == 'breast-form' -%}
    var g = (window.tbf2Pdp = window.tbf2Pdp || {});
    g.contentOverrides = g.contentOverrides || {};
    g.blockVisibility = g.blockVisibility || {};
    g.blockVisibility.howto_wear = true;
{%- else -%}
    var g = (window.hcPdp = window.hcPdp || {});
    g.contentOverrides = g.contentOverrides || {};
    g.blockVisibility = g.blockVisibility || {};
    g.contentOverrides.howto_wear = {
      subtext: {{ section.settings.subtext | json }}
    };
    g.blockVisibility.howto_wear = true;
{%- endif -%}
  })();
</script>

{% schema %}
{
  "name": "PDP How To Wear",
  "tag": "section",
  "class": "pdp-sec pdp-sec--howto-wear",
  "settings": [
    {
      "type": "header",
      "content": "Design"
    },
    {
      "type": "select",
      "id": "design_preset",
      "label": "Design preset",
      "options": [
        {
          "value": "inserts",
          "label": "Inserts"
        },
        {
          "value": "breast-form",
          "label": "Breast Form"
        }
      ],
      "default": "inserts",
      "info": "Picks which Replo design this section renders. Must match the other PDP sections on this template."
    },
    {
      "type": "checkbox",
      "id": "headline_poppins",
      "label": "Headline in Poppins only",
      "default": false,
      "info": "Off keeps the Replo design, where one word of the headline is set in Send Flowers. On renders the whole headline in Poppins at the same size as the rest of the line."
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "space_above_desktop",
      "min": 0,
      "max": 120,
      "step": 2,
      "unit": "px",
      "label": "Space above (desktop)",
      "default": 0,
      "info": "Reproduces the gap the original one-piece PDP had between blocks."
    },
    {
      "type": "range",
      "id": "space_above_mobile",
      "min": 0,
      "max": 120,
      "step": 2,
      "unit": "px",
      "label": "Space above (mobile)",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "label": "Padding top",
      "default": 60,
      "info": "Space above the section. Replaces the Replo default (60px)."
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "label": "Padding bottom",
      "default": 80,
      "info": "Space below the section. Replaces the Replo default (80px)."
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "label": "Padding top (mobile)",
      "default": 30,
      "info": "Half the desktop value by default."
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "label": "Padding bottom (mobile)",
      "default": 40,
      "info": "Half the desktop value by default."
    },
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "subtext",
      "label": "Subtext (optional)",
      "info": "Replaces hardcoded Replo subtext. Leave blank to keep original. Steps stay on metafields."
    },
    {
      "type": "header",
      "content": "Metafield overrides"
    },
    {
      "type": "paragraph",
      "content": "These normally read from the product’s metafields. Fill one in to hard-code it instead — useful when reusing this section on a product that has no metafields set."
    },
    {
      "type": "image_picker",
      "id": "mf_how_to_wear_step_1",
      "label": "How To Wear Step 1",
      "info": "Overrides product metafield custom.how_to_wear_step_1. Leave empty to keep using the metafield."
    },
    {
      "type": "textarea",
      "id": "mf_how_to_wear_step_1_text",
      "label": "How To Wear Step 1 Text",
      "info": "Overrides product metafield custom.how_to_wear_step_1_text. Leave empty to keep using the metafield."
    },
    {
      "type": "image_picker",
      "id": "mf_how_to_wear_step_2",
      "label": "How To Wear Step 2",
      "info": "Overrides product metafield custom.how_to_wear_step_2. Leave empty to keep using the metafield."
    },
    {
      "type": "textarea",
      "id": "mf_how_to_wear_step_2_text",
      "label": "How To Wear Step 2 Text",
      "info": "Overrides product metafield custom.how_to_wear_step_2_text. Leave empty to keep using the metafield."
    },
    {
      "type": "image_picker",
      "id": "mf_how_to_wear_step_3",
      "label": "How To Wear Step 3",
      "info": "Overrides product metafield custom.how_to_wear_step_3. Leave empty to keep using the metafield."
    },
    {
      "type": "textarea",
      "id": "mf_how_to_wear_step_3_text",
      "label": "How To Wear Step 3 Text",
      "info": "Overrides product metafield custom.how_to_wear_step_3_text. Leave empty to keep using the metafield."
    }
  ],
  "presets": [
    {
      "name": "PDP How To Wear"
    }
  ]
}
{% endschema %}
