
{%- liquid
  assign layout = section.settings.layout
  if layout == blank
    assign layout = 'icon-columns'
  endif

  assign columns_desktop = section.settings.columns_desktop
  assign columns_mobile = section.settings.columns_mobile

  case section.settings.column_content_alignment
    when 'left'
      assign content_flex_align = 'flex-start'
      assign content_text_align = 'left'
    when 'right'
      assign content_flex_align = 'flex-end'
      assign content_text_align = 'right'
    else
      assign content_flex_align = 'center'
      assign content_text_align = 'center'
  endcase
-%}

{%- style -%}
  #shopify-section-{{ section.id }} .custom-multicolumn {
    --cmc-padding-top: {{ section.settings.padding_top }}px;
    --cmc-padding-bottom: {{ section.settings.padding_bottom }}px;
    --cmc-bg: {{ section.settings.background_color }};
    --cmc-section-heading-color: {{ section.settings.section_heading_color }};
    --cmc-column-gap: {{ section.settings.column_gap }}px;
    --cmc-row-gap: {{ section.settings.row_gap }}px;
    --cmc-content-max-width: {{ section.settings.content_max_width }}px;
    --cmc-columns-desktop: {{ columns_desktop }};
    --cmc-columns-mobile: {{ columns_mobile }};
    --cmc-card-bg: {{ section.settings.card_background }};
    --cmc-card-border-color: {{ section.settings.card_border_color }};
    --cmc-card-border-width: {{ section.settings.card_border_width }}px;
    --cmc-card-radius: {{ section.settings.card_border_radius }}px;
    --cmc-card-heading-color: {{ section.settings.card_heading_color }};
    --cmc-card-text-color: {{ section.settings.card_text_color }};
    --cmc-card-padding: {{ section.settings.card_padding }}px;
    --cmc-column-heading-color: {{ section.settings.column_heading_color }};
    --cmc-column-text-color: {{ section.settings.column_text_color }};
    --cmc-icon-width: {{ section.settings.icon_width }}px;
    --cmc-divider-color: {{ section.settings.divider_color }};
    --cmc-link-color: {{ section.settings.link_color }};
    --cmc-section-heading-size: {{ section.settings.section_heading_font_size }}px;
    --cmc-block-heading-size: {{ section.settings.block_heading_font_size }}px;
    --cmc-block-text-size: {{ section.settings.block_text_font_size }}px;
    --cmc-btn-size: {{ section.settings.button_font_size }}px;
    padding-top: var(--cmc-padding-top);
    padding-bottom: var(--cmc-padding-bottom);
    background-color: var(--cmc-bg);
    color: var(--cmc-column-text-color);
  }

  #shopify-section-{{ section.id }} .custom-multicolumn__inner {
    max-width: var(--cmc-content-max-width);
    margin: 0 auto;
    padding-inline: 1.5rem;
  }

  #shopify-section-{{ section.id }} .custom-multicolumn__header {
    margin-bottom: {{ section.settings.heading_spacing }}px;
    text-align: {{ section.settings.heading_alignment }};
  }

  #shopify-section-{{ section.id }} .custom-multicolumn__title {
    margin: 0;
    color: var(--cmc-section-heading-color);
    font-size: var(--cmc-section-heading-size);
    line-height: 1.2;
    font-weight: {{ section.settings.section_heading_font_weight }};
  }

  #shopify-section-{{ section.id }} .custom-multicolumn__grid {
    display: grid;
    grid-template-columns: repeat(var(--cmc-columns-mobile), minmax(0, 1fr));
    gap: var(--cmc-row-gap) var(--cmc-column-gap);
    list-style: none;
    margin: 0;
    padding: 0;
  }

  @media screen and (min-width: 750px) {
    #shopify-section-{{ section.id }} .custom-multicolumn__grid {
      grid-template-columns: repeat(var(--cmc-columns-desktop), minmax(0, 1fr));
    }
  }

  #shopify-section-{{ section.id }} .custom-multicolumn__item {
    margin: 0;
  }

  #shopify-section-{{ section.id }} .custom-multicolumn__card {
    height: 100%;
  }

  #shopify-section-{{ section.id }} .custom-multicolumn--icon-columns .custom-multicolumn__card {
    display: flex;
    flex-direction: column;
    align-items: {{ content_flex_align }};
    text-align: {{ content_text_align }};
    max-width: 265px;
    margin: 0 auto;
  }

  #shopify-section-{{ section.id }} .custom-multicolumn--cards .custom-multicolumn__card {
    background-color: var(--cmc-card-bg);
    border: var(--cmc-card-border-width) solid var(--cmc-card-border-color);
    border-radius: var(--cmc-card-radius);
    padding: var(--cmc-card-padding);
    text-align: {{ content_text_align }};
    padding-block:36px 30px;
  }

  #shopify-section-{{ section.id }} .custom-multicolumn__media {
    display: flex;
    justify-content: {{ content_flex_align }};
    margin-bottom: {{ section.settings.icon_spacing }}px;
  }

  #shopify-section-{{ section.id }} .custom-multicolumn__media img {
    width: var(--cmc-icon-width);
    height: auto;
    object-fit: contain;
  }

  #shopify-section-{{ section.id }} .custom-multicolumn__item-heading {
    margin: 0 0 {{ section.settings.block_heading_spacing }}px;
    color: var(--cmc-block-heading-color, var(--cmc-column-heading-color));
    font-size: var(--cmc-block-heading-size);
    line-height: 1.3;
    font-weight: {{ section.settings.block_heading_font_weight }};
  }

  #shopify-section-{{ section.id }} .custom-multicolumn--cards .custom-multicolumn__item-heading {
    color: var(--cmc-block-heading-color, var(--cmc-card-heading-color));
  }

  #shopify-section-{{ section.id }} .custom-multicolumn__divider {
    display: block;
    width: 100%;
    height: 1px;
    margin: 0 0 {{ section.settings.block_heading_spacing }}px;
    background-color: var(--cmc-divider-color);
    border: 0;
  }

  #shopify-section-{{ section.id }} .custom-multicolumn__text {
    margin: 0;
    color: var(--cmc-block-text-color, var(--cmc-column-text-color));
    font-size: var(--cmc-block-text-size);
    line-height: 1.5;
  }

  #shopify-section-{{ section.id }} .custom-multicolumn--cards .custom-multicolumn__text {
    color: var(--cmc-block-text-color, var(--cmc-card-text-color));
  }

  #shopify-section-{{ section.id }} .custom-multicolumn__text p {
    margin: 0 0 1rem;
  }

  #shopify-section-{{ section.id }} .custom-multicolumn__text p:last-child {
    margin-bottom: 0;
  }

  #shopify-section-{{ section.id }} .custom-multicolumn__btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    box-sizing: border-box;
    margin-top: {{ section.settings.link_spacing }}px;
    font-size: var(--cmc-btn-size);
    font-weight: {{ section.settings.button_font_weight }};
    line-height: 1.2;
    text-decoration: none;
    border-radius: {{ section.settings.button_radius }}px;
    transition: background-color 0.25s ease, color 0.25s ease, border-color 0.25s ease, opacity 0.25s ease;
    max-width: 100%;
    cursor: pointer;
  }

  #shopify-section-{{ section.id }} .custom-multicolumn__btn--solid,
  #shopify-section-{{ section.id }} .custom-multicolumn__btn--outline {
    min-height: {{ section.settings.button_min_height }}px;
    padding: {{ section.settings.button_padding_y }}px {{ section.settings.button_padding_x }}px;
  }

  #shopify-section-{{ section.id }} .custom-multicolumn__btn--solid {
    background-color: {{ section.settings.button_background }};
    color: {{ section.settings.button_text_color }};
    border: {{ section.settings.button_border_width }}px solid {{ section.settings.button_background }};
  }

  #shopify-section-{{ section.id }} .custom-multicolumn__btn--solid:hover {
    background-color: transparent;
    color: {{ section.settings.button_background }};
    border-color: {{ section.settings.button_background }};
  }

  #shopify-section-{{ section.id }} .custom-multicolumn__btn--outline {
    background-color: transparent;
    color: {{ section.settings.button_background }};
    border: {{ section.settings.button_border_width }}px solid {{ section.settings.button_background }};
  }

  #shopify-section-{{ section.id }} .custom-multicolumn__btn--outline:hover {
    background-color: {{ section.settings.button_background }};
    color: {{ section.settings.button_text_color }};
    border-color: {{ section.settings.button_background }};
  }

  #shopify-section-{{ section.id }} .custom-multicolumn__btn--link {
    padding: 0;
    min-height: 0;
    background: transparent;
    border: 0;
    border-radius: 0;
    color: var(--cmc-link-color);
    font-style: italic;
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  #shopify-section-{{ section.id }} .custom-multicolumn__btn--link:hover {
    opacity: 0.75;
  }

  {%- for block in section.blocks -%}
    #shopify-section-{{ section.id }} .custom-multicolumn__item--{{ block.id }} {
      padding-top: {{ block.settings.padding_top }}px;
      padding-bottom: {{ block.settings.padding_bottom }}px;
    }

    {%- if block.settings.heading_color != blank and block.settings.heading_color != 'rgba(0,0,0,0)' -%}
      #shopify-section-{{ section.id }} .custom-multicolumn__item--{{ block.id }} .custom-multicolumn__item-heading {
        color: {{ block.settings.heading_color }};
      }
    {%- endif -%}

    {%- if block.settings.text_color != blank and block.settings.text_color != 'rgba(0,0,0,0)' -%}
      #shopify-section-{{ section.id }} .custom-multicolumn__item--{{ block.id }} .custom-multicolumn__text {
        color: {{ block.settings.text_color }};
      }
    {%- endif -%}

    {%- if block.settings.icon_width > 0 -%}
      #shopify-section-{{ section.id }} .custom-multicolumn__item--{{ block.id }} .custom-multicolumn__media img {
        width: {{ block.settings.icon_width }}px;
      }
    {%- endif -%}
  {%- endfor -%}
  @media screen and (max-width: 989px) {
    #shopify-section-{{ section.id }} .custom-multicolumn {
      --cmc-section-heading-size: {{ section.settings.section_heading_font_size_tablet }}px;
      --cmc-block-heading-size: {{ section.settings.block_heading_font_size_tablet }}px;
      --cmc-block-text-size: {{ section.settings.block_text_font_size_tablet }}px;
      --cmc-btn-size: {{ section.settings.button_font_size_tablet }}px;
    }
  }

  @media screen and (max-width: 749px) {
    #shopify-section-{{ section.id }} .custom-multicolumn {
      --cmc-section-heading-size: {{ section.settings.section_heading_font_size_mobile }}px;
      --cmc-block-heading-size: {{ section.settings.block_heading_font_size_mobile }}px;
      --cmc-block-text-size: {{ section.settings.block_text_font_size_mobile }}px;
      --cmc-btn-size: {{ section.settings.button_font_size_mobile }}px;
    }

    #shopify-section-{{ section.id }} .custom-multicolumn--icon-columns .custom-multicolumn__card {
      max-width: 100% !important;
    }

    #shopify-section-{{ section.id }} .custom-multicolumn--icon-columns .custom-multicolumn__card .custom-multicolumn__item-heading {
      font-size: {{ section.settings.block_heading_font_size_mobile_icon }}px;
    }

    #shopify-section-{{ section.id }} .custom-multicolumn__media {
      margin-bottom: {{ section.settings.icon_spacing_mobile }}px;
    }
  }
{%- endstyle -%}

<div class="custom-multicolumn custom-multicolumn--{{ layout }}"{% if template.suffix == 'size-guide-how-to-use' %} id="hc-wearing-tips"{% endif %}>
  <div class="custom-multicolumn__inner">
    {%- if section.settings.heading != blank -%}
      <div class="custom-multicolumn__header">
        <{{ section.settings.heading_tag }} class="custom-multicolumn__title">
          {{ section.settings.heading | escape }}
        </{{ section.settings.heading_tag }}>
      </div>
    {%- endif -%}

    {%- if section.blocks.size > 0 -%}
      <ul class="custom-multicolumn__grid" role="list">
        {%- for block in section.blocks -%}
          {%- comment -%} Wholesale_Club_Product_Visibility_For_Loop Start {%- endcomment -%}
          {%- capture hide_resource -%}{% render "wc_product_visibility", resource: block %}{%- endcapture -%}
          {%- if hide_resource == 'true' -%}
            {% continue %}
          {%- endif -%}
          {%- comment -%} Wholesale_Club_Product_Visibility_For_Loop End {%- endcomment -%}

          <li
            id="CustomMulticolumnItem-{{ section.id }}-{{ forloop.index }}"
            class="custom-multicolumn__item custom-multicolumn__item--{{ block.id }}"
            {{ block.shopify_attributes }}
          >
            <div class="custom-multicolumn__card">
              {%- if block.settings.image != blank -%}
                {%- liquid
                  assign column_image_alt = block.settings.image.alt | default: block.settings.title | escape
                -%}
                <div class="custom-multicolumn__media">
                  {{
                    block.settings.image
                    | image_url: width: 400
                    | image_tag: loading: 'lazy', widths: '80, 120, 160, 200, 240, 320, 400', alt: column_image_alt
                  }}
                </div>
              {%- endif -%}

              {%- if block.settings.title != blank -%}
                <{{ block.settings.heading_tag }} class="custom-multicolumn__item-heading">
                  {{ block.settings.title | escape }}
                </{{ block.settings.heading_tag }}>
              {%- endif -%}

              {%- if layout == 'cards'
                and section.settings.show_card_divider
                and block.settings.title != blank
                and block.settings.text != blank
              -%}
                <span class="custom-multicolumn__divider" aria-hidden="true"></span>
              {%- endif -%}

              {%- if block.settings.text != blank -%}
                <div class="custom-multicolumn__text rte">
                  {{ block.settings.text }}
                </div>
              {%- endif -%}

              {%- if block.settings.link_label != blank -%}
                {%- liquid
                  assign button_style = block.settings.button_style
                  if button_style == blank
                    assign button_style = 'link'
                  endif
                -%}
                <a
                  class="custom-multicolumn__btn custom-multicolumn__btn--{{ button_style }}"
                  {% if block.settings.link_url != blank %}
                    href="{{ block.settings.link_url }}"
                  {% else %}
                    role="link" aria-disabled="true"
                  {% endif %}
                >
                  {{ block.settings.link_label | escape }}
                </a>
              {%- endif -%}
            </div>
          </li>
        {%- endfor -%}
      </ul>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "Custom multicolumn",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "select",
      "id": "layout",
      "label": "Layout style",
      "info": "Icon columns for feature icons with centered content. Cards for bordered card layout.",
      "options": [
        {
          "value": "icon-columns",
          "label": "Icon columns"
        },
        {
          "value": "cards",
          "label": "Cards"
        }
      ],
      "default": "icon-columns"
    },
    {
      "type": "header",
      "content": "Heading"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "How Honey Cloudz Helps"
    },
    {
      "type": "select",
      "id": "heading_tag",
      "label": "Heading tag",
      "options": [
        { "value": "h1", "label": "H1" },
        { "value": "h2", "label": "H2" },
        { "value": "h3", "label": "H3" },
        { "value": "h4", "label": "H4" },
        { "value": "p", "label": "Paragraph" }
      ],
      "default": "h2"
    },
    {
      "type": "select",
      "id": "heading_alignment",
      "label": "Heading alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ],
      "default": "center"
    },
    {
      "type": "range",
      "id": "section_heading_font_size",
      "min": 16,
      "max": 72,
      "step": 2,
      "unit": "px",
      "label": "Heading font size (desktop)",
      "default": 36
    },
    {
      "type": "range",
      "id": "section_heading_font_size_tablet",
      "min": 16,
      "max": 56,
      "step": 2,
      "unit": "px",
      "label": "Heading font size (tablet)",
      "default": 32
    },
    {
      "type": "range",
      "id": "section_heading_font_size_mobile",
      "min": 14,
      "max": 40,
      "step": 1,
      "unit": "px",
      "label": "Heading font size (mobile)",
      "default": 28
    },
    {
      "type": "select",
      "id": "section_heading_font_weight",
      "label": "Heading font weight",
      "options": [
        { "value": "400", "label": "Regular" },
        { "value": "500", "label": "Medium" },
        { "value": "600", "label": "Semibold" },
        { "value": "700", "label": "Bold" }
      ],
      "default": "700"
    },
    {
      "type": "range",
      "id": "heading_spacing",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Space below heading",
      "default": 40
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "min": 1,
      "max": 4,
      "step": 1,
      "label": "Columns on desktop",
      "default": 3
    },
    {
      "type": "select",
      "id": "columns_mobile",
      "label": "Columns on mobile",
      "options": [
        { "value": "1", "label": "1" },
        { "value": "2", "label": "2" }
      ],
      "default": "1"
    },
    {
      "type": "select",
      "id": "column_content_alignment",
      "label": "Column content alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ],
      "default": "center"
    },
    {
      "type": "range",
      "id": "content_max_width",
      "min": 600,
      "max": 1600,
      "step": 20,
      "unit": "px",
      "label": "Content max width",
      "default": 1320
    },
    {
      "type": "range",
      "id": "column_gap",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "label": "Column gap",
      "default": 32
    },
    {
      "type": "range",
      "id": "row_gap",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "label": "Row gap",
      "default": 32
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "default": "#B8E4EA"
    },
    {
      "type": "color",
      "id": "section_heading_color",
      "label": "Section heading color",
      "default": "#212326"
    },
    {
      "type": "color",
      "id": "column_heading_color",
      "label": "Column heading color",
      "default": "#212326"
    },
    {
      "type": "color",
      "id": "column_text_color",
      "label": "Column text color",
      "default": "#212326"
    },
    {
      "type": "color",
      "id": "link_color",
      "label": "Text link color",
      "default": "#212326"
    },
    {
      "type": "header",
      "content": "Button style"
    },
    {
      "type": "paragraph",
      "content": "Per-column style is set on each block (Solid / Outline / Text). Colors below apply to Solid and Outline."
    },
    {
      "type": "color",
      "id": "button_background",
      "label": "Button background / border",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "button_text_color",
      "label": "Button text (solid)",
      "default": "#FFFFFF"
    },
    {
      "type": "select",
      "id": "button_font_weight",
      "label": "Button weight",
      "options": [
        { "value": "500", "label": "Medium" },
        { "value": "600", "label": "Semibold" },
        { "value": "700", "label": "Bold" },
        { "value": "800", "label": "Extra bold" }
      ],
      "default": "700"
    },
    {
      "type": "range",
      "id": "button_font_size",
      "min": 11,
      "max": 20,
      "step": 1,
      "unit": "px",
      "label": "Button font size (desktop)",
      "default": 13
    },
    {
      "type": "range",
      "id": "button_font_size_tablet",
      "min": 11,
      "max": 18,
      "step": 1,
      "unit": "px",
      "label": "Button font size (tablet)",
      "default": 13
    },
    {
      "type": "range",
      "id": "button_font_size_mobile",
      "min": 11,
      "max": 18,
      "step": 1,
      "unit": "px",
      "label": "Button font size (mobile)",
      "default": 13
    },
    {
      "type": "range",
      "id": "button_min_height",
      "min": 36,
      "max": 64,
      "step": 2,
      "unit": "px",
      "label": "Solid / outline button height",
      "default": 46
    },
    {
      "type": "range",
      "id": "button_padding_x",
      "min": 12,
      "max": 48,
      "step": 2,
      "unit": "px",
      "label": "Button padding horizontal",
      "default": 24
    },
    {
      "type": "range",
      "id": "button_padding_y",
      "min": 6,
      "max": 24,
      "step": 2,
      "unit": "px",
      "label": "Button padding vertical",
      "default": 10
    },
    {
      "type": "range",
      "id": "button_radius",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "label": "Button corner radius",
      "default": 40
    },
    {
      "type": "range",
      "id": "button_border_width",
      "min": 1,
      "max": 3,
      "step": 1,
      "unit": "px",
      "label": "Button border width",
      "default": 1
    },
    {
      "type": "header",
      "content": "Card layout"
    },
    {
      "type": "color",
      "id": "card_background",
      "label": "Card background",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "card_border_color",
      "label": "Card border color",
      "default": "#212326"
    },
    {
      "type": "range",
      "id": "card_border_width",
      "min": 0,
      "max": 6,
      "step": 1,
      "unit": "px",
      "label": "Card border width",
      "default": 1
    },
    {
      "type": "range",
      "id": "card_border_radius",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "label": "Card border radius",
      "default": 16
    },
    {
      "type": "color",
      "id": "card_heading_color",
      "label": "Card heading color",
      "default": "#C6448C"
    },
    {
      "type": "color",
      "id": "card_text_color",
      "label": "Card text color",
      "default": "#212326"
    },
    {
      "type": "range",
