{%- liquid
  case section.settings.text_alignment
    when 'left'
      assign text_align = 'left'
    when 'right'
      assign text_align = 'right'
    else
      assign text_align = 'center'
  endcase
-%}

{%- style -%}
  #shopify-section-{{ section.id }} .cta-banner {
    padding: {{ section.settings.padding_top }}px 1.5rem {{ section.settings.padding_bottom }}px;
    background-color: {{ section.settings.section_background }};
  }

  #shopify-section-{{ section.id }} .cta-banner__inner {
    max-width: {{ section.settings.content_max_width }}px;
    margin: 0 auto;
  }

  #shopify-section-{{ section.id }} .cta-banner__link {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: {{ section.settings.content_gap }}px;
    width: 100%;
    padding: {{ section.settings.banner_padding_y }}px {{ section.settings.banner_padding_x }}px;
    border: {{ section.settings.border_width }}px solid {{ section.settings.border_color }};
    border-radius: {{ section.settings.border_radius }}px;
    background-color: {{ section.settings.banner_background }};
    color: {{ section.settings.text_color }};
    text-decoration: none;
    transition: opacity 0.2s ease, box-shadow 0.2s ease;
  }

  #shopify-section-{{ section.id }} .cta-banner__link:hover {
    opacity: 0.92;
    {% if section.settings.show_hover_shadow %}
      box-shadow: 0 0.4rem 1.6rem rgba(0, 0, 0, 0.08);
    {% endif %}
  }

  #shopify-section-{{ section.id }} .cta-banner__content {
    flex: 1;
    min-width: 0;
    text-align: {{ text_align }};
    font-size: {{ section.settings.text_font_size }}px;
    line-height: 1.4;
  }

  #shopify-section-{{ section.id }} .cta-banner__heading {
    font-size: {{ section.settings.heading_font_size }}px;
    font-weight: {{ section.settings.heading_font_weight }};
    color: {{ section.settings.heading_color }};
  }

  #shopify-section-{{ section.id }} .cta-banner__subtext {
    font-weight: {{ section.settings.text_font_weight }};
    color: {{ section.settings.text_color }};
  }

  #shopify-section-{{ section.id }} .cta-banner__icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex: 0 0 {{ section.settings.icon_size }}px;
    width: {{ section.settings.icon_size }}px;
    height: {{ section.settings.icon_size }}px;
    border-radius: 50%;
    background-color: {{ section.settings.icon_background }};
    color: {{ section.settings.icon_color }};
  }

  #shopify-section-{{ section.id }} .cta-banner__icon svg {
    width: calc({{ section.settings.icon_size }}px * 0.45);
    height: calc({{ section.settings.icon_size }}px * 0.45);
    display: block;
  }

  @media screen and (max-width: 749px) {
    #shopify-section-{{ section.id }} .cta-banner__link {
      {% if section.settings.stack_on_mobile %}
        flex-direction: column;
        align-items: stretch;
        text-align: center;
      {% endif %}
      padding: {{ section.settings.banner_padding_y_mobile }}px {{ section.settings.banner_padding_x_mobile }}px;
    }

    #shopify-section-{{ section.id }} .cta-banner__content {
      font-size: {{ section.settings.text_font_size_mobile }}px;
      {% if section.settings.stack_on_mobile %}
        text-align: center;
      {% endif %}
    }

    #shopify-section-{{ section.id }} .cta-banner__heading {
      font-size: {{ section.settings.heading_font_size_mobile }}px;
    }

    #shopify-section-{{ section.id }} .cta-banner__icon {
      {% if section.settings.stack_on_mobile %}
        align-self: center;
      {% endif %}
    }
  }
{%- endstyle -%}

<div class="cta-banner">
  <div class="cta-banner__inner">
    <a
      class="cta-banner__link"
      {% if section.settings.link != blank %}
        href="{{ section.settings.link }}"
      {% else %}
        role="link" aria-disabled="true"
      {% endif %}
    >
      <div class="cta-banner__content">
        {%- if section.settings.heading != blank -%}
          <span class="cta-banner__heading">{{ section.settings.heading | escape }}</span>
        {%- endif -%}
        {%- if section.settings.subtext != blank -%}
          {%- if section.settings.heading != blank -%}
            <span class="cta-banner__subtext"> {{ section.settings.subtext | escape }}</span>
          {%- else -%}
            <span class="cta-banner__subtext">{{ section.settings.subtext | escape }}</span>
          {%- endif -%}
        {%- endif -%}
      </div>

      {%- if section.settings.show_icon -%}
        <span class="cta-banner__icon" aria-hidden="true">
          <svg viewBox="0 0 14 12" fill="none" xmlns="http://www.w3.org/2000/svg">
            <path d="M1 6H12M12 6L7.5 1.5M12 6L7.5 10.5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </span>
      {%- endif -%}
    </a>
  </div>
</div>

{% schema %}
{
  "name": "CTA banner",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading (bold)",
      "default": "Need Help Finding The Right Insert?"
    },
    {
      "type": "text",
      "id": "subtext",
      "label": "Subtext",
      "default": "Take our 30 sec. Style Finder Quiz"
    },
    {
      "type": "url",
      "id": "link",
      "label": "Link"
    },
    {
      "type": "select",
      "id": "text_alignment",
      "label": "Text alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ],
      "default": "left"
    },
    {
      "type": "header",
      "content": "Banner style"
    },
    {
      "type": "color",
      "id": "section_background",
      "label": "Section background",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "banner_background",
      "label": "Banner background",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "Border color",
      "default": "#212326"
    },
    {
      "type": "range",
      "id": "border_width",
      "min": 0,
      "max": 4,
      "step": 1,
      "unit": "px",
      "label": "Border width",
      "default": 1
    },
    {
      "type": "range",
      "id": "border_radius",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "label": "Border radius",
      "default": 60
    },
    {
      "type": "range",
      "id": "content_max_width",
      "min": 400,
      "max": 1400,
      "step": 20,
      "unit": "px",
      "label": "Max width",
      "default": 900
    },
    {
      "type": "range",
      "id": "banner_padding_x",
      "min": 12,
      "max": 48,
      "step": 2,
      "unit": "px",
      "label": "Banner padding horizontal",
      "default": 28
    },
    {
      "type": "range",
      "id": "banner_padding_y",
      "min": 8,
      "max": 40,
      "step": 2,
      "unit": "px",
      "label": "Banner padding vertical",
      "default": 18
    },
    {
      "type": "range",
      "id": "content_gap",
      "min": 8,
      "max": 48,
      "step": 4,
      "unit": "px",
      "label": "Space between text and icon",
      "default": 20
    },
    {
      "type": "checkbox",
      "id": "show_hover_shadow",
      "label": "Show shadow on hover",
      "default": false
    },
    {
      "type": "header",
      "content": "Typography"
    },
    {
      "type": "range",
      "id": "heading_font_size",
      "min": 12,
      "max": 28,
      "step": 1,
      "unit": "px",
      "label": "Heading font size",
      "default": 16
    },
    {
      "type": "range",
      "id": "heading_font_size_mobile",
      "min": 12,
      "max": 24,
      "step": 1,
      "unit": "px",
      "label": "Heading font size (mobile)",
      "default": 14
    },
    {
      "type": "select",
      "id": "heading_font_weight",
      "label": "Heading font weight",
      "options": [
        { "value": "500", "label": "Medium" },
        { "value": "600", "label": "Semibold" },
        { "value": "700", "label": "Bold" }
      ],
      "default": "700"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading color",
      "default": "#212326"
    },
    {
      "type": "range",
      "id": "text_font_size",
      "min": 12,
      "max": 24,
      "step": 1,
      "unit": "px",
      "label": "Subtext font size",
      "default": 16
    },
    {
      "type": "range",
      "id": "text_font_size_mobile",
      "min": 12,
      "max": 20,
      "step": 1,
      "unit": "px",
      "label": "Subtext font size (mobile)",
      "default": 14
    },
    {
      "type": "select",
      "id": "text_font_weight",
      "label": "Subtext font weight",
      "options": [
        { "value": "400", "label": "Regular" },
        { "value": "500", "label": "Medium" }
      ],
      "default": "400"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Subtext color",
      "default": "#212326"
    },
    {
      "type": "header",
      "content": "Icon"
    },
    {
      "type": "checkbox",
      "id": "show_icon",
      "label": "Show arrow icon",
      "default": true
    },
    {
      "type": "range",
      "id": "icon_size",
      "min": 24,
      "max": 56,
      "step": 2,
      "unit": "px",
      "label": "Icon size",
      "default": 36
    },
    {
      "type": "color",
      "id": "icon_background",
      "label": "Icon background",
      "default": "#C6448C"
    },
    {
      "type": "color",
      "id": "icon_color",
      "label": "Icon arrow color",
      "default": "#FFFFFF"
    },
    {
      "type": "header",
      "content": "Mobile"
    },
    {
      "type": "checkbox",
      "id": "stack_on_mobile",
      "label": "Stack content on mobile",
      "default": false
    },
    {
      "type": "range",
      "id": "banner_padding_x_mobile",
      "min": 12,
      "max": 32,
      "step": 2,
      "unit": "px",
      "label": "Banner padding horizontal (mobile)",
      "default": 20
    },
    {
      "type": "range",
      "id": "banner_padding_y_mobile",
      "min": 8,
      "max": 32,
      "step": 2,
      "unit": "px",
      "label": "Banner padding vertical (mobile)",
      "default": 16
    },
    {
      "type": "header",
      "content": "Section padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "label": "Padding top",
      "default": 24
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "label": "Padding bottom",
      "default": 24
    }
  ],
  "presets": [
    {
      "name": "CTA banner",
      "settings": {
        "heading": "Need Help Finding The Right Insert?",
        "subtext": "Take our 30 sec. Style Finder Quiz",
        "border_radius": 60,
        "icon_background": "#C6448C"
      }
    }
  ]
}
{% endschema %}
