{%- liquid
  assign metaobject_type = section.settings.metaobject_type | default: 'store_location'
  assign store_entries = shop.metaobjects[metaobject_type].values
  assign pin_color = section.settings.pin_color | default: settings.colors_reviews
  assign pin_active_color = section.settings.pin_active_color | default: settings.colors_accent
  assign accent_color = section.settings.colors_button_background | default: settings.colors_reviews
  assign brand_pink = section.settings.brand_pink
  assign brand_pink_active = brand_pink | color_darken: 12
  assign cloud_icon = section.settings.cloud_icon
  assign ribbon_icon = section.settings.ribbon_icon
-%}

{%- style -%}
  #shopify-section-{{ section.id }} {
    --section-padding-top: {{ section.settings.padding_top }}px;
    --section-padding-bottom: {{ section.settings.padding_bottom }}px;
    --sl-panel-max-height: {{ section.settings.panel_max_height }}px;
    --sl-panel-max-height-mobile: {{ section.settings.panel_max_height_mobile }}px;
    --sl-pin: {{ pin_color }};
    --sl-accent: {{ accent_color }};
    --sl-accent-active: {{ pin_active_color }};
    --sl-brand-blue: {{ pin_color }};
    --sl-brand-blue-rgb: {{ pin_color.red }}, {{ pin_color.green }}, {{ pin_color.blue }};
    --sl-brand-pink: {{ brand_pink }};
    --sl-brand-pink-rgb: {{ brand_pink.red }}, {{ brand_pink.green }}, {{ brand_pink.blue }};
    --sl-brand-pink-active: {{ brand_pink_active }};
    {%- if section.settings.use_custom_colors -%}
      --sl-bg: {{ section.settings.colors_background }};
      --sl-surface: {{ section.settings.colors_background }};
      --sl-controls-bg: {{ section.settings.colors_controls_background }};
      --sl-ink: {{ section.settings.colors_text }};
      --sl-ink-rgb: {{ section.settings.colors_text.red }}, {{ section.settings.colors_text.green }}, {{ section.settings.colors_text.blue }};
      --sl-muted: rgba({{ section.settings.colors_text.red }}, {{ section.settings.colors_text.green }}, {{ section.settings.colors_text.blue }}, 0.65);
      --sl-line: {{ section.settings.colors_border }};
      --sl-line-strong: {{ section.settings.colors_border }};
      --sl-card-hover: rgba({{ section.settings.colors_text.red }}, {{ section.settings.colors_text.green }}, {{ section.settings.colors_text.blue }}, 0.03);
      --sl-card-active-bg: {{ section.settings.colors_card_active_background }};
      --sl-pin-rgb: {{ pin_color.red }}, {{ pin_color.green }}, {{ pin_color.blue }};
      --color-background: {{ section.settings.colors_background.red }}, {{ section.settings.colors_background.green }}, {{ section.settings.colors_background.blue }};
      --color-foreground: {{ section.settings.colors_text.red }}, {{ section.settings.colors_text.green }}, {{ section.settings.colors_text.blue }};
      --color-heading: {{ section.settings.colors_text.red }}, {{ section.settings.colors_text.green }}, {{ section.settings.colors_text.blue }};
      --color-button-background: {{ section.settings.colors_button_background.red }}, {{ section.settings.colors_button_background.green }}, {{ section.settings.colors_button_background.blue }};
      --color-button-text: {{ section.settings.colors_button_label.red }}, {{ section.settings.colors_button_label.green }}, {{ section.settings.colors_button_label.blue }};
      --color-button-border: {{ section.settings.colors_button_background.red }}, {{ section.settings.colors_button_background.green }}, {{ section.settings.colors_button_background.blue }};
    {%- else -%}
      --sl-pin-rgb: {{ pin_color.red }}, {{ pin_color.green }}, {{ pin_color.blue }};
    {%- endif -%}
  }

  @media screen and (max-width: 950px) {
    #shopify-section-{{ section.id }} > .section--padding > .page-width {
      padding-left: 0;
      padding-right: 0;
      max-width: 100%;
    }

    #shopify-section-{{ section.id }} .hc-store-locator__shell {
      border-inline: none;
    }

    #shopify-section-{{ section.id }} .hc-store-locator__header,
    #shopify-section-{{ section.id }} .hc-store-locator__controls,
    #shopify-section-{{ section.id }} .hc-store-locator__results-head,
    #shopify-section-{{ section.id }} .hc-store-locator__card,
    #shopify-section-{{ section.id }} .hc-store-locator__empty {
      padding-inline: 1.6rem;
    }
  }
{%- endstyle -%}

{{ 'section-store-locator.css' | asset_url | stylesheet_tag }}
<script src="{{ 'store-locator.js' | asset_url }}" defer="defer"></script>

<div class="section--padding{% if section.settings.show_divider %} section--divider{% endif %}">
  <div class="{% unless section.settings.full_width %}page-width{% endunless %}{% if section.settings.full_width %} page-width--full-width{% endif %}">
    <hc-store-locator
      class="hc-store-locator{% if section.settings.use_custom_colors %} hc-store-locator--colored{% endif %}"
      data-api-key="{{ section.settings.map_api_key | escape }}"
      data-map-id="{{ section.settings.map_id | escape }}"
      data-default-lat="{{ section.settings.default_map_lat }}"
      data-default-lng="{{ section.settings.default_map_lng }}"
      data-default-zoom="{{ section.settings.default_map_zoom }}"
      data-empty-zip-text="{{ section.settings.empty_zip_text | escape }}"
      data-invalid-zip-title="{{ section.settings.invalid_zip_title | escape }}"
      data-invalid-zip-text="{{ section.settings.invalid_zip_text | escape }}"
      data-no-results-title="{{ section.settings.no_results_title | escape }}"
      data-no-results-text="{{ section.settings.no_results_text | escape }}"
      data-tag-mastectomy="Breast Forms"
      data-tag-post-op="{{ section.settings.filter_post_op_label | escape }}"
      data-label-bra-inserts="{{ section.settings.filter_post_op_label | escape }}"
      data-label-breast-forms="Breast Forms"
      data-directions-label="{{ section.settings.directions_label | escape }}"
      data-show-phone="{{ section.settings.show_phone }}"
      data-geo-unavailable-text="{{ section.settings.geo_unavailable_text | escape }}"
      data-geo-failed-text="{{ section.settings.geo_failed_text | escape }}"
      {%- if cloud_icon != blank -%}
        data-icon-cloud-url="{{ cloud_icon | image_url: width: 96 }}"
      {%- endif -%}
      {%- if ribbon_icon != blank -%}
        data-icon-ribbon-url="{{ ribbon_icon | image_url: width: 96 }}"
      {%- endif -%}
    >
      <div class="hc-store-locator__shell">
        <header class="hc-store-locator__header">
          <div>
            {%- if section.settings.heading != blank -%}
              <h2 class="hc-store-locator__title">{{ section.settings.heading | escape }}</h2>
            {%- endif -%}
            {%- if section.settings.subheading != blank -%}
              <p class="hc-store-locator__subtitle">{{ section.settings.subheading | escape }}</p>
            {%- endif -%}
          </div>
        </header>

        <div class="hc-store-locator__controls">
          <div class="hc-store-locator__controls-layout">
          <div class="hc-store-locator__search-row">
            <div class="hc-store-locator__field">
              <label for="StoreLocatorZip-{{ section.id }}">{{ section.settings.zip_label | escape }}</label>
              <input
                id="StoreLocatorZip-{{ section.id }}"
                data-zip-input
                type="text"
                maxlength="12"
                autocapitalize="characters"
                placeholder="{{ section.settings.zip_placeholder | escape }}"
                value=""
              >
            </div>
            <div class="hc-store-locator__field">
              <label for="StoreLocatorDistance-{{ section.id }}">{{ section.settings.distance_label | escape }}</label>
              <select id="StoreLocatorDistance-{{ section.id }}" data-distance-select>
                <option value="0">{{ section.settings.distance_option_no_limit | escape }}</option>
                <option value="25">25 mi</option>
                <option value="50">50 mi</option>
                <option value="100">100 mi</option>
                <option value="250">250 mi</option>
              </select>
            </div>
            <div class="hc-store-locator__field">
              <label for="StoreLocatorCount-{{ section.id }}">{{ section.settings.results_label | escape }}</label>
              <select id="StoreLocatorCount-{{ section.id }}" data-count-select>
                <option value="0" selected>{{ section.settings.results_option_no_limit | escape }}</option>
                <option value="10">10</option>
                <option value="25">25</option>
                <option value="50">50</option>
                <option value="100">100</option>
              </select>
            </div>
            <button type="button" class="hc-store-locator__search-btn" data-search-btn>
              {{ section.settings.search_button_label | escape }}
            </button>
            <button
              type="button"
              class="hc-store-locator__near-btn"
              data-near-btn
              title="{{ section.settings.use_location_label | escape }}"
            >
              <svg
                width="15"
                height="15"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                aria-hidden="true"
              >
                <circle cx="12" cy="12" r="3"></circle>
                <path d="M12 2v3M12 19v3M2 12h3M19 12h3"></path>
              </svg>
              {{ section.settings.use_location_label | escape }}
            </button>
          </div>

          {%- if section.settings.show_filters -%}
            <div class="hc-store-locator__filters">
              <label class="hc-store-locator__filter">
                <input
                  type="checkbox"
                  data-filter-postop
                  {% if section.settings.filter_post_op_default %}
                    checked
                  {% endif %}
                >
                <span class="hc-store-locator__filter-icon hc-store-locator__icon hc-store-locator__icon--cloud" aria-hidden="true">
                  {%- render 'store-locator-icons', icon: 'cloud', image: cloud_icon -%}
                </span>
                <span class="hc-store-locator__filter-title">{{ section.settings.filter_post_op_label | escape }}</span>
              </label>
              <label class="hc-store-locator__filter">
                <input
                  type="checkbox"
                  data-filter-mastectomy
                  {% if section.settings.filter_mastectomy_default %}
                    checked
                  {% endif %}
                >
                <span class="hc-store-locator__filter-icon hc-store-locator__icon hc-store-locator__icon--ribbon" aria-hidden="true">
                  {%- render 'store-locator-icons', icon: 'ribbon', image: ribbon_icon -%}
                </span>
                <span class="hc-store-locator__filter-title">{{ section.settings.filter_mastectomy_label | escape }}</span>
              </label>
            </div>
          {%- endif -%}
          </div>
        </div>

        <div class="hc-store-locator__split">
          <div class="hc-store-locator__results">
            <div class="hc-store-locator__results-head">
              <div class="hc-store-locator__results-head-text" data-results-head>
                {{ section.settings.initial_results_text | escape }}
              </div>
              <button
                type="button"
                class="hc-store-locator__clear-selection"
                data-clear-selection
                hidden
              >
                {{ section.settings.clear_selection_label | default: 'Clear' | escape }}
              </button>
            </div>
            <div class="hc-store-locator__results-body" data-results-list>
              {%- if store_entries.size == 0 -%}
                <div class="hc-store-locator__empty">
                  <h3>{{ section.settings.no_stores_title | escape }}</h3>
                  <p>{{ section.settings.no_stores_text | escape }}</p>
                </div>
              {%- endif -%}
            </div>
          </div>

          <div class="hc-store-locator__map-wrap">
            <div class="hc-store-locator__map" data-map></div>
            {%- if section.settings.show_map_legend -%}
              <div class="hc-store-locator__map-legend">
                <div class="hc-store-locator__map-legend-item">
                  <span class="hc-store-locator__icon hc-store-locator__icon--cloud">
                    {%- render 'store-locator-icons', icon: 'cloud', image: cloud_icon -%}
                  </span>
                  <span>{{ section.settings.filter_post_op_label | escape }}</span>
                </div>
                <div class="hc-store-locator__map-legend-item">
                  <span class="hc-store-locator__icon hc-store-locator__icon--ribbon">
                    {%- render 'store-locator-icons', icon: 'ribbon', image: ribbon_icon -%}
                  </span>
                  <span>{{ section.settings.filter_mastectomy_label | escape }}</span>
                </div>
                {%- if section.settings.map_legend_note != blank -%}
                  <p class="hc-store-locator__map-legend-note">{{ section.settings.map_legend_note | escape }}</p>
                {%- endif -%}
              </div>
            {%- endif -%}
            <div class="hc-store-locator__map-msg" data-map-msg>
              <div class="hc-store-locator__map-msg-icon"></div>
              <h3>{{ section.settings.map_error_title | escape }}</h3>
              <p>{{ section.settings.map_error_text | escape }}</p>
            </div>
          </div>
        </div>
      </div>

      <script type="application/json" data-store-locator-stores>
        [
          {%- assign store_index = 0 -%}
          {%- comment -%}
            Shopify Liquid only returns 50 metaobject values unless paginated.
            Paginate by 250 (Liquid max for metaobject values) so all store locations load.
          {%- endcomment -%}
          {%- paginate store_entries by 250 -%}
            {%- for store in store_entries -%}
              {%- capture store_active_flag -%}{%- render 'store-locator-boolean', object: store, keys: 'is_active,active' -%}{%- endcapture -%}
              {%- if store_active_flag == 'false' -%}
                {%- continue -%}
              {%- endif -%}
              {%- if store.latitude.value == blank or store.longitude.value == blank -%}
                {%- continue -%}
              {%- endif -%}
              {%- assign store_lat = store.latitude.value | plus: 0 -%}
              {%- assign store_lng = store.longitude.value | plus: 0 -%}
              {%- assign store_index = store_index | plus: 1 -%}
              {%- unless store_index == 1 -%},{%- endunless -%}
              {%- assign store_website = '' -%}
              {%- assign website_keys = section.settings.website_url_field_keys | split: ',' -%}
              {%- for website_key in website_keys -%}
                {%- assign website_field_key = website_key | strip -%}
                {%- if website_field_key == blank -%}
                  {%- continue -%}
                {%- endif -%}
                {%- assign website_field = store[website_field_key] -%}
                {%- assign website_value = website_field.value | default: website_field -%}
                {%- if website_value != blank -%}
                  {%- assign store_website = website_value -%}
                  {%- break -%}
                {%- endif -%}
              {%- endfor -%}
              {
                "id": {{ store_index }},
                "handle": {{ store.system.handle | json }},
                "name": {{ store.store_name.value | default: store.system.handle | json }},
                "addr": {{ store.address_line_1.value | json }},
                "city": {{ store.city.value | json }},
                "state": {{ store.state.value | json }},
                "zip": {{ store.postal_code.value | json }},
                "country": {{ store.country.value | default: 'United States' | json }},
                "phone": {{ store.phone.value | json }},
                "website": {{ store_website | json }},
                "lat": {{ store_lat }},
                "lng": {{ store_lng }},
                "mastectomy": {%- render 'store-locator-boolean', object: store, keys: section.settings.mastectomy_field_keys -%},
                "postop": {%- render 'store-locator-boolean', object: store, keys: section.settings.post_op_field_keys -%}
              }
            {%- endfor -%}
          {%- endpaginate -%}
        ]
      </script>

      <template data-store-locator-icon-template>
        <span data-icon-cloud>{% render 'store-locator-icons', icon: 'cloud', image: cloud_icon %}</span>
        <span data-icon-ribbon>{% render 'store-locator-icons', icon: 'ribbon', image: ribbon_icon %}</span>
      </template>
    </hc-store-locator>
  </div>
</div>

{% schema %}
{
  "name": "Store locator",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Find a Store Near You"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Search retailers carrying Honey Cloudz Breast Forms and Bra Inserts."
    },
    {
      "type": "header",
      "content": "Product icons"
    },
    {
      "type": "paragraph",
      "content": "Optional custom icons for filters, store tags, and the map legend. Leave empty to use the default cloud and ribbon SVGs."
    },
    {
      "type": "image_picker",
      "id": "cloud_icon",
      "label": "Bra inserts cloud icon"
    },
    {
      "type": "image_picker",
      "id": "ribbon_icon",
      "label": "Breast forms ribbon icon"
    },
    {
      "type": "header",
      "content": "Google Maps"
    },
    {
      "type": "text",
      "id": "map_api_key",
      "label": "Google Maps API key",
      "info": "Enable Maps JavaScript API and Geocoding API. Restrict the key by HTTP referrer and set billing alerts."
    },
    {
      "type": "text",
      "id": "map_id",
      "label": "Google Map ID",
      "info": "Required for Advanced Markers. Create in Google Cloud Console → Map Management."
    },
    {
      "type": "text",
      "id": "metaobject_type",
      "label": "Metaobject type handle",
      "default": "store_location",
      "info": "Must match the metaobject definition handle exactly."
    },
    {
      "type": "text",
      "id": "mastectomy_field_keys",
      "label": "Mastectomy services field key",
      "default": "mastectomy_services",
      "info": "Metaobject field handle for Mastectomy services (True/False)."
    },
    {
      "type": "text",
      "id": "post_op_field_keys",
      "label": "Post-op services field key",
      "default": "post_op_services",
      "info": "Metaobject field handle for Post-op services (True/False)."
    },
    {
      "type": "text",
      "id": "website_url_field_keys",
      "label": "Website URL field key",
      "default": "website_url",
      "info": "Metaobject field handle for the store website URL."
    },
    {
      "type": "range",
      "id": "default_map_zoom",
      "min": 3,
      "max": 12,
      "step": 1,
      "label": "Default map zoom",
      "default": 4
    },
    {
      "type": "text",
      "id": "default_map_lat",
      "label": "Default map latitude",
      "default": "39"
    },
    {
      "type": "text",
      "id": "default_map_lng",
      "label": "Default map longitude",
      "default": "-95"
    },
    {
      "type": "header",
      "content": "Search & filters"
    },
    {
      "type": "text",
      "id": "default_zip",
      "label": "Default ZIP code",
      "default": "28803"
    },
    {
      "type": "text",
      "id": "zip_label",
      "label": "ZIP field label",
      "default": "Postal/Zip code"
    },
    {
      "type": "text",
      "id": "zip_placeholder",
      "label": "ZIP placeholder",
      "default": "e.g. 28803 or E2E 2R5"
    },
    {
      "type": "text",
      "id": "distance_label",
      "label": "Distance field label",
      "default": "Distance"
    },
    {
      "type": "text",
      "id": "distance_option_no_limit",
      "label": "No distance limit label",
      "default": "No limit"
    },
    {
      "type": "text",
      "id": "results_label",
      "label": "Results field label",
      "default": "Results"
    },
    {
      "type": "text",
      "id": "results_option_no_limit",
      "label": "No results limit label",
      "default": "No limit"
    },
    {
      "type": "text",
      "id": "search_button_label",
      "label": "Search button label",
      "default": "Search"
    },
    {
      "type": "text",
      "id": "use_location_label",
      "label": "Use my location label",
      "default": "Use my location"
    },
    {
      "type": "checkbox",
      "id": "show_filters",
      "label": "Show product filters",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_map_legend",
      "label": "Show map legend",
      "default": true
    },
    {
      "type": "text",
      "id": "map_legend_note",
      "label": "Map legend note",
      "default": "Some stores may carry both."
    },
    {
      "type": "checkbox",
      "id": "filter_mastectomy_default",
      "label": "Breast forms filter checked by default",
      "default": false
    },
    {
      "type": "text",
      "id": "filter_mastectomy_label",
      "label": "Breast forms filter label",
      "default": "Breast Forms (Mastectomy)"
    },
    {
      "type": "text",
      "id": "filter_mastectomy_help",
      "label": "Breast forms filter help text",
      "default": "Shops carrying Honey Cloudz breast forms"
    },
    {
      "type": "checkbox",
      "id": "filter_post_op_default",
      "label": "Bra inserts filter checked by default",
      "default": false
    },
    {
      "type": "text",
      "id": "filter_post_op_label",
      "label": "Bra inserts filter label",
      "default": "Bra Inserts"
    },
    {
      "type": "text",
      "id": "filter_post_op_help",
      "label": "Bra inserts filter help text",
      "default": "Shops carrying Honey Cloudz bra inserts"
    },
    {
      "type": "header",
      "content": "Messages"
    },
    {
      "type": "text",
      "id": "initial_results_text",
      "label": "Initial results text",
      "default": "Showing all available locations"
    },
    {
      "type": "text",
      "id": "clear_selection_label",
      "label": "Clear selection label",
      "default": "Clear"
    },
    {
      "type": "text",
      "id": "empty_zip_text",
      "label": "Empty ZIP text",
      "default": "Enter a valid ZIP and search"
    },
    {
      "type": "text",
      "id": "invalid_zip_title",
      "label": "Invalid ZIP title",
      "default": "ZIP not recognized"
    },
    {
      "type": "text",
      "id": "invalid_zip_text",
      "label": "Invalid ZIP text",
      "default": "Enter a valid US ZIP code and search again."
    },
    {
      "type": "text",
      "id": "no_results_title",
      "label": "No results title",
      "default": "No stores in range"
    },
    {
      "type": "text",
      "id": "no_results_text",
      "label": "No results text",
      "default": "Try increasing the distance or clearing a filter."
    },
    {
      "type": "text",
      "id": "no_stores_title",
      "label": "No store entries title",
      "default": "No stores yet"
    },
    {
      "type": "text",
      "id": "no_stores_text",
      "label": "No store entries text",
      "default": "Add store_location metaobject entries in Shopify admin."
    },
    {
      "type": "text",
      "id": "directions_label",
      "label": "Directions link label",
      "default": "Directions"
    },
    {
      "type": "checkbox",
      "id": "show_phone",
      "label": "Show store phone numbers",
      "default": false
    },
    {
      "type": "text",
      "id": "map_error_title",
      "label": "Map error title",
      "default": "Map couldn't load"
    },
    {
      "type": "textarea",
      "id": "map_error_text",
      "label": "Map error text",
      "default": "Check the Google Maps API key, Map ID, billing, and HTTP referrer restrictions for this domain."
    },
    {
      "type": "text",
      "id": "geo_unavailable_text",
      "label": "Geolocation unavailable text",
      "default": "Geolocation isn't available in this browser."
    },
    {
      "type": "text",
      "id": "geo_failed_text",
      "label": "Geolocation failed text",
      "default": "Couldn't get your location. Enter a ZIP instead."
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "checkbox",
      "id": "full_width",
      "label": "Make section full width",
      "default": false
    },
