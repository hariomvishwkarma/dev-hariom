{%- liquid
  assign tabs = section.blocks | where: 'type', 'tab'
  assign rows = section.blocks | where: 'type', 'row'
  assign tips = section.blocks | where: 'type', 'tips'
  assign style_blocks = section.blocks | where: 'type', 'style'
  assign button_style = section.settings.button_style
  if button_style == blank
    assign button_style = 'solid'
  endif
-%}

{%- style -%}
  #shopify-section-{{ section.id }} .ccs {
    --ccs-heading-size: {{ section.settings.heading_font_size_desktop }}px;
    --ccs-sub-size: {{ section.settings.subheading_font_size_desktop }}px;
    --ccs-header-bg: {{ section.settings.header_background }};
    --ccs-header-text: {{ section.settings.header_text_color }};
    background-color: {{ section.settings.background_color }};
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }

  #shopify-section-{{ section.id }} .ccs__inner {
    max-width: {{ section.settings.content_max_width }}px;
    margin: 0 auto;
    padding-inline: {{ section.settings.side_padding }}px;
    box-sizing: border-box;
  }

  #shopify-section-{{ section.id }} .ccs__header {
    text-align: {{ section.settings.text_alignment }};
    margin: 0 auto {{ section.settings.header_spacing }}px;
    max-width: {{ section.settings.heading_max_width }}px;
  }

  #shopify-section-{{ section.id }} .ccs__heading {
    margin: 0 0 {{ section.settings.heading_spacing }}px;
    color: {{ section.settings.heading_color }};
    font-size: var(--ccs-heading-size);
    font-weight: {{ section.settings.heading_font_weight }};
    line-height: 1.2;
  }

  #shopify-section-{{ section.id }} .ccs__subheading {
    margin: 0;
    color: {{ section.settings.subheading_color }};
    font-size: var(--ccs-sub-size);
    line-height: 1.5;
  }

  #shopify-section-{{ section.id }} .ccs__tabs {
    display: flex;
    flex-wrap: wrap;
    justify-content: {{ section.settings.text_alignment }};
    gap: {{ section.settings.tab_gap }}px;
    margin-bottom: {{ section.settings.tab_spacing }}px;
  }

  #shopify-section-{{ section.id }} .ccs__tab {
    appearance: none;
    border: {{ section.settings.tab_border_width }}px solid {{ section.settings.tab_border_color }};
    background: {{ section.settings.tab_background }};
    color: {{ section.settings.tab_text_color }};
    border-radius: {{ section.settings.tab_radius }}px;
    min-height: {{ section.settings.tab_height }}px;
    padding: 0 {{ section.settings.tab_padding_x }}px;
    font-size: {{ section.settings.tab_font_size }}px;
    font-weight: {{ section.settings.tab_font_weight }};
    line-height: 1.2;
    cursor: pointer;
  }

  #shopify-section-{{ section.id }} .ccs__tab.is-active {
    background: {{ section.settings.tab_active_background }};
    color: {{ section.settings.tab_active_text }};
    border-color: {{ section.settings.tab_active_background }};
  }

  #shopify-section-{{ section.id }} .ccs__panel {
    display: none;
  }

  #shopify-section-{{ section.id }} .ccs__panel.is-active {
    display: block;
  }

  #shopify-section-{{ section.id }} .ccs__scroll-wrap {
    position: relative;
  }

  #shopify-section-{{ section.id }} .ccs__scroll {
    overflow-x: auto;
    overflow-y: hidden;
    -webkit-overflow-scrolling: touch;
    border-radius: {{ section.settings.table_radius }}px;
    border: {{ section.settings.table_border_width }}px solid {{ section.settings.header_background }};
  }

  #shopify-section-{{ section.id }} .ccs__scroll-hint {
    display: none;
    appearance: none;
    margin: 0;
    padding: 0;
  }

  #shopify-section-{{ section.id }} .ccs__scroll + .ccs__tips,
  #shopify-section-{{ section.id }} .ccs__scroll-wrap + .ccs__tips {
    margin-top: 20px;
    /* Match table width when tips sit under the chart (Breast Form) */
    max-width: none;
    width: 100%;
    margin-inline: 0;
    box-sizing: border-box;
  }

  #shopify-section-{{ section.id }} .ccs__table {
    width: 100%;
    min-width: {{ section.settings.table_min_width }}px;
    border-collapse: collapse;
    background: linear-gradient(
      {{ section.settings.gradient_angle }}deg,
      {{ section.settings.gradient_start }},
      {{ section.settings.gradient_end }}
    );
    color: {{ section.settings.cell_text_color }};
    font-size: {{ section.settings.cell_font_size }}px;
    font-weight: 600;
  }

  #shopify-section-{{ section.id }} .ccs__table th,
  #shopify-section-{{ section.id }} .ccs__table td {
    border: 1px solid {{ section.settings.cell_border_color }};
    padding: {{ section.settings.cell_padding_y }}px {{ section.settings.cell_padding_x }}px;
    text-align: center;
    vertical-align: middle;
    white-space: nowrap;
  }

  #shopify-section-{{ section.id }} .ccs__table thead th {
    background-color: var(--ccs-header-bg);
    color: var(--ccs-header-text);
    font-weight: {{ section.settings.header_font_weight }};
    font-size: {{ section.settings.header_font_size }}px;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  #shopify-section-{{ section.id }} .ccs__style {
    background-color: var(--ccs-header-bg);
    color: var(--ccs-header-text);
    width: {{ section.settings.style_col_width }}px;
    min-width: {{ section.settings.style_col_width }}px;
    white-space: normal;
  }

  #shopify-section-{{ section.id }} .ccs__style-inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 10px;
  }

  #shopify-section-{{ section.id }} .ccs__style img {
    width: {{ section.settings.style_image_width }}px;
    height: auto;
    display: block;
    border-radius: {{ section.settings.style_image_radius }}px;
    object-fit: contain;
  }

  #shopify-section-{{ section.id }} .ccs__style-name {
    font-weight: {{ section.settings.header_font_weight }};
    font-size: {{ section.settings.style_name_size }}px;
    line-height: 1.25;
    white-space: normal;
  }

  #shopify-section-{{ section.id }} .ccs__tips {
    max-width: {{ section.settings.tips_max_width }}px;
    margin: 0 auto;
    background-color: {{ section.settings.tips_background }};
    border: {{ section.settings.card_border_width }}px solid {{ section.settings.tips_border_color }};
    border-radius: {{ section.settings.table_radius }}px;
    padding: {{ section.settings.tips_padding }}px;
    text-align: {{ section.settings.text_alignment }};
    color: {{ section.settings.tips_text_color }};
    font-size: {{ section.settings.tips_font_size }}px;
    line-height: 1.55;
  }

  #shopify-section-{{ section.id }} .ccs__tips-media {
    display: flex;
    justify-content: {{ section.settings.text_alignment }};
    margin: 0 0 {{ section.settings.tips_image_spacing }}px;
  }

  #shopify-section-{{ section.id }} .ccs__tips-media img {
    width: {{ section.settings.tips_image_width }}px;
    max-width: 100%;
    height: auto;
    display: block;
    object-fit: contain;
    border-radius: {{ section.settings.tips_image_radius }}px;
  }

  #shopify-section-{{ section.id }} .ccs__tips p {
    margin: 0 0 1em;
  }

  #shopify-section-{{ section.id }} .ccs__tips p:last-child {
    margin-bottom: 0;
  }

  #shopify-section-{{ section.id }} .ccs__footer {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: center;
    gap: {{ section.settings.button_gap | default: 12 }}px;
    margin-top: {{ section.settings.button_spacing }}px;
  }

  #shopify-section-{{ section.id }} .ccs__btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    box-sizing: border-box;
    min-height: {{ section.settings.button_min_height }}px;
    padding: {{ section.settings.button_padding_y }}px {{ section.settings.button_padding_x }}px;
    border-radius: {{ section.settings.button_radius }}px;
    font-size: {{ section.settings.button_font_size }}px;
    font-weight: {{ section.settings.button_font_weight }};
    text-decoration: none;
    text-align: center;
    transition: background-color 0.25s ease, color 0.25s ease, border-color 0.25s ease;
    cursor: pointer;
  }

  #shopify-section-{{ section.id }} .ccs__btn--solid {
    background-color: {{ section.settings.button_background }};
    color: {{ section.settings.button_text_color }};
    border: {{ section.settings.button_border_width }}px solid {{ section.settings.button_background }};
  }

  #shopify-section-{{ section.id }} .ccs__btn--solid:hover {
    background-color: transparent;
    color: {{ section.settings.button_background }};
  }

  #shopify-section-{{ section.id }} .ccs__btn--outline {
    background-color: transparent;
    color: {{ section.settings.button_background }};
    border: {{ section.settings.button_border_width }}px solid {{ section.settings.button_background }};
  }

  #shopify-section-{{ section.id }} .ccs__btn--outline:hover {
    background-color: {{ section.settings.button_background }};
    color: {{ section.settings.button_text_color }};
  }

  @media screen and (max-width: 989px) {
    #shopify-section-{{ section.id }} .ccs {
      --ccs-heading-size: {{ section.settings.heading_font_size_tablet }}px;
      --ccs-sub-size: {{ section.settings.subheading_font_size_tablet }}px;
    }
  }

  @media screen and (max-width: 749px) {
    #shopify-section-{{ section.id }} .ccs {
      --ccs-heading-size: {{ section.settings.heading_font_size_mobile }}px;
      --ccs-sub-size: {{ section.settings.subheading_font_size_mobile }}px;
      padding-top: {{ section.settings.padding_top_mobile }}px;
      padding-bottom: {{ section.settings.padding_bottom_mobile }}px;
    }

    #shopify-section-{{ section.id }} .ccs__inner {
      padding-inline: {{ section.settings.side_padding_mobile }}px;
    }

    #shopify-section-{{ section.id }} .ccs__table {
      font-size: {{ section.settings.cell_font_size_mobile }}px;
    }

    #shopify-section-{{ section.id }} .ccs__tips-media img {
      width: {{ section.settings.tips_image_width_mobile }}px;
    }

    #shopify-section-{{ section.id }} .ccs__tabs {
      justify-content: flex-start;
      overflow-x: auto;
      flex-wrap: nowrap;
      padding-bottom: 4px;
      -webkit-overflow-scrolling: touch;
    }

    #shopify-section-{{ section.id }} .ccs__tab {
      flex: 0 0 auto;
    }

    {%- if section.settings.show_table_scroll_hint_mobile -%}
    #shopify-section-{{ section.id }} .ccs__scroll-wrap.has-scroll .ccs__scroll-hint {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      position: absolute;
      top: 50%;
      right: 8px;
      transform: translateY(-50%);
      width: 32px;
      height: 32px;
      border-radius: 50%;
      background: #ffffff;
      border: 1px solid {{ section.settings.header_background }};
      color: {{ section.settings.header_background }};
      box-shadow: 0 2px 8px rgba(17, 17, 17, 0.12);
      pointer-events: auto;
      cursor: pointer;
      z-index: 2;
      transition: opacity 0.2s ease;
    }

    #shopify-section-{{ section.id }} .ccs__scroll-hint svg {
      width: 12px;
      height: 12px;
      display: block;
      pointer-events: none;
    }

    #shopify-section-{{ section.id }} .ccs__scroll-wrap.is-at-end .ccs__scroll-hint {
      opacity: 0;
      pointer-events: none;
    }
    {%- endif -%}

    #shopify-section-{{ section.id }} .ccs__footer {
      flex-direction: row;
      flex-wrap: wrap;
    }

    #shopify-section-{{ section.id }} .ccs__btn {
      flex: 1 1 0;
      min-width: 140px;
    }
  }

  @media screen and (max-width: 479px) {
    #shopify-section-{{ section.id }} .ccs__footer {
      flex-direction: column;
      align-items: stretch;
    }

    #shopify-section-{{ section.id }} .ccs__btn {
      flex: 0 0 auto;
      width: 100%;
      min-width: 0;
    }
  }
{%- endstyle -%}

<div class="ccs" id="hc-compare-styles">
  <div class="ccs__inner">
    {%- if section.settings.heading != blank or section.settings.subheading != blank -%}
      <div class="ccs__header">
        {%- if section.settings.heading != blank -%}
          <{{ section.settings.heading_tag }} class="ccs__heading">{{ section.settings.heading | escape }}</{{ section.settings.heading_tag }}>
        {%- endif -%}
        {%- if section.settings.subheading != blank -%}
          <p class="ccs__subheading">{{ section.settings.subheading | escape }}</p>
        {%- endif -%}
      </div>
    {%- endif -%}

    {%- if tabs.size > 0 -%}
      <div class="ccs__tabs-wrap">
        <div class="ccs__tabs" role="tablist">
          {%- for tab in tabs -%}
            <button
              type="button"
              class="ccs__tab{% if forloop.first %} is-active{% endif %}"
              data-ccs-tab="{{ tab.id }}"
              role="tab"
              aria-selected="{% if forloop.first %}true{% else %}false{% endif %}"
              {{ tab.shopify_attributes }}
            >
              {{ tab.settings.label | escape }}
            </button>
          {%- endfor -%}
        </div>
      </div>
    {%- endif -%}

    {%- for tab in tabs -%}
      {%- liquid
        assign tab_key = tab.settings.label | strip | downcase
        assign chart_type = tab.settings.chart_type | default: 'inserts'
        if chart_type == blank
          assign chart_type = 'inserts'
        endif
        assign tab_row_count = 0
        assign tab_tip_count = 0
        for row in rows
          assign row_key = row.settings.tab_name | strip | downcase
          if row_key == tab_key
            assign tab_row_count = tab_row_count | plus: 1
          endif
        endfor
        for tip in tips
          assign tip_key = tip.settings.tab_name | strip | downcase
          if tip_key == tab_key
            assign tab_tip_count = tab_tip_count | plus: 1
          endif
        endfor
      -%}
      <div
        class="ccs__panel{% if forloop.first %} is-active{% endif %}"
        data-ccs-panel="{{ tab.id }}"
        role="tabpanel"
      >
        {%- if tab_row_count > 0 -%}
          <div class="ccs__scroll-wrap">
          <div class="ccs__scroll">
            <table class="ccs__table">
              <thead>
                {%- if chart_type == 'forms' -%}
                  <tr>
                    <th class="ccs__style" scope="col">{{ section.settings.col_form_style | escape }}</th>
                    <th scope="col">{{ section.settings.col_form_size | escape }}</th>
                    <th scope="col">{{ section.settings.col_form_width | escape }}</th>
                    <th scope="col">{{ section.settings.col_form_height | escape }}</th>
                    <th scope="col">{{ section.settings.col_form_weight | escape }}</th>
                    <th scope="col">{{ section.settings.col_form_thickness | escape }}</th>
                  </tr>
                {%- else -%}
                  <tr>
                    <th class="ccs__style" rowspan="2" scope="col">{{ section.settings.col_style | escape }}</th>
                    <th rowspan="2" scope="col">{{ section.settings.col_size | escape }}</th>
                    <th colspan="2" scope="col">{{ section.settings.col_dimensions | escape }}</th>
                    <th rowspan="2" scope="col">{{ section.settings.col_weight | escape }}</th>
                    <th rowspan="2" scope="col">{{ section.settings.col_thickness | escape }}</th>
                  </tr>
                  <tr>
                    <th scope="col">{{ section.settings.col_inches | escape }}</th>
                    <th scope="col">{{ section.settings.col_cm | escape }}</th>
                  </tr>
                {%- endif -%}
              </thead>
              <tbody>
                {%- assign rendered_styles = '' -%}
                {%- for row in rows -%}
                  {%- assign row_key = row.settings.tab_name | strip | downcase -%}
                  {%- if row_key == tab_key -%}
                    {%- liquid
                      assign style_key = row.settings.style_name | strip | downcase
                      assign style_marker = '|' | append: style_key | append: '|'
                      assign show_style = true
                      if rendered_styles contains style_marker
                        assign show_style = false
                      endif
                      assign rowspan = 0
                      if show_style
                        for r2 in rows
                          assign r2_tab = r2.settings.tab_name | strip | downcase
                          assign r2_style = r2.settings.style_name | strip | downcase
                          if r2_tab == tab_key and r2_style == style_key
                            assign rowspan = rowspan | plus: 1
                          endif
                        endfor
                        assign rendered_styles = rendered_styles | append: style_marker
                        assign style_image = row.settings.image
                        assign style_product = row.settings.product
                        assign style_title = row.settings.style_name
                        assign has_style_block = false
                        assign row_norm = style_key | replace: '+', '' | replace: '-', ' '
                        for sblock in style_blocks
                          assign s_tab = sblock.settings.tab_name | strip | downcase
                          assign s_name = sblock.settings.style_name | strip | downcase | replace: '+', '' | replace: '-', ' '
                          assign s_title_key = sblock.settings.title | strip | downcase | replace: '+', '' | replace: '-', ' '
                          if s_tab == tab_key
                            if s_name == row_norm or s_title_key == row_norm
                              assign has_style_block = true
                              assign matched_style = sblock
                              if sblock.settings.image != blank
                                assign style_image = sblock.settings.image
                              endif
                              if sblock.settings.product != blank
                                assign style_product = sblock.settings.product
                              endif
                              if sblock.settings.title != blank
                                assign style_title = sblock.settings.title
                              elsif sblock.settings.style_name != blank
                                assign style_title = sblock.settings.style_name
                              endif
                            endif
                          endif
                        endfor
                        if style_product == blank
                          assign fallback_handle = ''
                          case style_key
                            when 'half moon classic'
                              assign fallback_handle = 'half-moon-classic-bra-inserts'
                            when 'half moon plus+', 'half moon plus'
                              assign fallback_handle = 'half-moon-plus-bra-inserts'
                            when 'oval lites', 'oval lite'
                              assign fallback_handle = 'oval-lites-bra-inserts'
                            when 'oval classics', 'oval classic'
                              assign fallback_handle = 'oval-classic-bra-inserts'
                            when 'oval plus+', 'oval plus'
                              assign fallback_handle = 'oval-plus-bra-inserts'
                            when 'triangle classics', 'triangle classic'
                              assign fallback_handle = 'triangle-classic-bra-inserts'
                            when 'triangle plus+', 'triangle plus'
                              assign fallback_handle = 'triangle-plus-bra-inserts'
                            when 'triangle push-up', 'triangle push up'
                              assign fallback_handle = 'triangle-push-up-bra-inserts'
                            when 'oval push-up', 'oval push up'
                              assign fallback_handle = 'oval-push-up-bra-inserts'
                            when 'oval extra breast form', 'oval extra', 'oval breast form'
                              assign fallback_handle = 'oval-extra-bra-inserts'
                            when 'teardrop breast form', 'teardrop'
                              assign fallback_handle = 'teardrop-breast-form'
                          endcase
                          if fallback_handle != blank
                            assign style_product = all_products[fallback_handle]
                          endif
                        endif
                      endif
                    -%}
                    <tr {{ row.shopify_attributes }}>
                      {%- if show_style -%}
                        <td class="ccs__style" rowspan="{{ rowspan }}" {% if has_style_block %}{{ matched_style.shopify_attributes }}{% endif %}>
                          <div class="ccs__style-inner">
                            {%- if style_image != blank -%}
                              {%- assign style_alt = style_image.alt | default: style_title -%}
                              {{
                                style_image
                                | image_url: width: 280
                                | image_tag: loading: 'lazy', widths: '80, 120, 180, 280', alt: style_alt
                              }}
                            {%- elsif style_product != blank and style_product.featured_image != blank -%}
                              {%- assign style_alt = style_product.featured_image.alt | default: style_title | default: style_product.title -%}
                              {{
                                style_product.featured_image
                                | image_url: width: 280
                                | image_tag: loading: 'lazy', widths: '80, 120, 180, 280', alt: style_alt
                              }}
                            {%- endif -%}
                            {%- if style_title != blank -%}
                              <div class="ccs__style-name">{{ style_title | escape }}</div>
                            {%- endif -%}
                          </div>
                        </td>
                      {%- endif -%}
                      <td>{{ row.settings.size | escape }}</td>
                      <td>{{ row.settings.inches | escape }}</td>
                      <td>{{ row.settings.cm | escape }}</td>
                      <td>{{ row.settings.weight | escape }}</td>
                      <td>{{ row.settings.thickness | escape }}</td>
                    </tr>
                  {%- endif -%}
                {%- endfor -%}
              </tbody>
            </table>
          </div>
          <button type="button" class="ccs__scroll-hint" data-ccs-scroll-hint aria-label="Scroll table right">
            <svg viewBox="0 0 12 12" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
              <path d="M4.5 2.5L8 6L4.5 9.5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </button>
          </div>
        {%- endif -%}

        {%- if tab_tip_count > 0 -%}
          <div class="ccs__tips">
            {%- for tip in tips -%}
              {%- assign tip_key = tip.settings.tab_name | strip | downcase -%}
              {%- if tip_key == tab_key -%}
                <div {{ tip.shopify_attributes }}>
                  {%- if tip.settings.image != blank -%}
                    {%- liquid
                      assign tip_alt = tip.settings.image.alt | default: tip.settings.heading
                      assign tip_sizes = '(max-width: 749px) ' | append: section.settings.tips_image_width_mobile | append: 'px, ' | append: section.settings.tips_image_width | append: 'px'
                    -%}
                    <div class="ccs__tips-media">
                      {{
                        tip.settings.image
                        | image_url: width: 600
                        | image_tag:
                          loading: 'lazy',
                          widths: '80, 120, 160, 200, 280, 360, 480, 600',
                          sizes: tip_sizes,
                          alt: tip_alt
                      }}
                    </div>
                  {%- endif -%}
                  {%- if tip.settings.heading != blank -%}
                    <p><strong>{{ tip.settings.heading | escape }}</strong></p>
                  {%- endif -%}
                  {%- if tip.settings.text != blank -%}
                    {{ tip.settings.text }}
                  {%- endif -%}
                </div>
              {%- endif -%}
            {%- endfor -%}
          </div>
        {%- endif -%}
      </div>
    {%- endfor -%}

    {%- liquid
      assign btn1_label = section.settings.button_label
      assign btn1_link = section.settings.button_link
      assign btn1_style = section.settings.button_style | default: 'solid'
      assign btn2_label = section.settings.button_2_label
      assign btn2_link = section.settings.button_2_link
      assign btn2_style = section.settings.button_2_style | default: button_style
      if btn2_style == blank
        assign btn2_style = 'solid'
      endif
    -%}
    {%- if btn1_label != blank or btn2_label != blank -%}
      <div class="ccs__footer">
        {%- if btn1_label != blank -%}
          <a
            class="ccs__btn ccs__btn--{{ btn1_style }}"
            {% if btn1_link != blank %}
              href="{{ btn1_link }}"
            {% else %}
              role="link" aria-disabled="true"
            {% endif %}
          >
            {{ btn1_label | escape }}
          </a>
        {%- endif -%}
        {%- if btn2_label != blank -%}
          <a
            class="ccs__btn ccs__btn--{{ btn2_style }}"
            {% if btn2_link != blank %}
              href="{{ btn2_link }}"
            {% else %}
              role="link" aria-disabled="true"
            {% endif %}
          >
            {{ btn2_label | escape }}
          </a>
        {%- endif -%}
      </div>
    {%- endif -%}
  </div>
</div>

<script>
  (function () {
    var root = document.getElementById('hc-compare-styles');
    if (!root) return;
    var tabs = root.querySelectorAll('[data-ccs-tab]');
    var panels = root.querySelectorAll('[data-ccs-panel]');
    var hintsEnabled = {{ section.settings.show_table_scroll_hint_mobile | json }};

    function syncScrollHints() {
      if (!hintsEnabled) return;
      root.querySelectorAll('.ccs__scroll-wrap').forEach(function (wrap) {
        var scroller = wrap.querySelector('.ccs__scroll');
        if (!scroller) return;
        var max = scroller.scrollWidth - scroller.clientWidth;
        var canScroll = max > 4;
        wrap.classList.toggle('has-scroll', canScroll);
        wrap.classList.toggle('is-at-end', !canScroll || scroller.scrollLeft >= max - 4);
      });
    }

    function slideTable(scroller, direction) {
      if (!scroller) return;
      var amount = Math.max(160, Math.round(scroller.clientWidth * 0.75));
      scroller.scrollBy({ left: direction * amount, behavior: 'smooth' });
    }

    root.querySelectorAll('.ccs__scroll').forEach(function (scroller) {
      scroller.addEventListener('scroll', syncScrollHints, { passive: true });
    });

    root.querySelectorAll('[data-ccs-scroll-hint]').forEach(function (hint) {
      hint.addEventListener('click', function () {
        var wrap = hint.closest('.ccs__scroll-wrap');
        var scroller = wrap && wrap.querySelector('.ccs__scroll');
        slideTable(scroller, 1);
      });
    });

    tabs.forEach(function (tab) {
      tab.addEventListener('click', function () {
        var id = tab.getAttribute('data-ccs-tab');
        tabs.forEach(function (t) {
          t.classList.toggle('is-active', t === tab);
          t.setAttribute('aria-selected', t === tab ? 'true' : 'false');
        });
        panels.forEach(function (p) {
          p.classList.toggle('is-active', p.getAttribute('data-ccs-panel') === id);
        });
        window.requestAnimationFrame(syncScrollHints);
      });
    });

    syncScrollHints();
    window.addEventListener('resize', syncScrollHints);
  })();
</script>

