{%- liquid
  assign review_blocks = section.blocks | where: 'type', 'review'
  assign avatar_blocks = section.blocks | where: 'type', 'avatar'
  assign slides_desktop = section.settings.slides_desktop
  assign slides_tablet = section.settings.slides_tablet
  assign slides_mobile = section.settings.slides_mobile
  assign mobile_w = section.settings.mobile_slide_width
  assign tablet_w = section.settings.tablet_slide_width
  assign desktop_w = section.settings.desktop_slide_width
  assign mobile_side = section.settings.mobile_side_visible
  assign tablet_side = section.settings.tablet_side_visible
  assign desktop_side = section.settings.desktop_side_visible
-%}

{%- style -%}
  #shopify-section-{{ section.id }} .crs {
    --crs-bg: {{ section.settings.background_color }};
    --crs-card-bg: {{ section.settings.card_background }};
    --crs-card-radius: {{ section.settings.card_border_radius }}px;
    --crs-card-shadow: {{ section.settings.card_shadow }};
    --crs-card-padding: {{ section.settings.card_padding }}px;
    --crs-star-color: {{ section.settings.star_color }};
    --crs-headline-color: {{ section.settings.headline_color }};
    --crs-text-color: {{ section.settings.text_color }};
    --crs-highlight-color: {{ section.settings.highlight_color }};
    --crs-name-color: {{ section.settings.name_color }};
    --crs-verified-color: {{ section.settings.verified_color }};
    --crs-badge-bg: {{ section.settings.badge_background }};
    --crs-badge-text: {{ section.settings.badge_text_color }};
    --crs-heading-color: {{ section.settings.heading_color }};
    --crs-subheading-color: {{ section.settings.subheading_color }};
    --crs-gap: {{ section.settings.card_gap }}px;
    --crs-slides-desktop: {{ slides_desktop }};
    --crs-slides-tablet: {{ slides_tablet }};
    --crs-slides-mobile: {{ slides_mobile }};
    --crs-mobile-side: {{ mobile_side }};
    --crs-tablet-side: {{ tablet_side }};
    --crs-desktop-side: {{ desktop_side }};
    --crs-avatar-size: {{ section.settings.avatar_size }}px;
    --crs-avatar-overlap: {{ section.settings.avatar_overlap }}px;
    --crs-avatars-strip-height: {{ section.settings.avatars_strip_height }}px;
    --crs-nav-size: {{ section.settings.nav_icon_size }}px;
    --crs-carousel-side: {{ section.settings.carousel_side_padding }}px;
    --crs-container-max: {{ section.settings.section_max_width }}px;
    background-color: var(--crs-bg);
    padding: {{ section.settings.padding_top }}px 0 {{ section.settings.padding_bottom }}px;
    overflow: visible;
  }

  {% unless section.settings.use_theme_page_width %}
  #shopify-section-{{ section.id }} .crs__header-container {
    max-width: var(--crs-container-max);
    margin-left: auto;
    margin-right: auto;
    padding-inline: 1.5rem;
    width: 100%;
    box-sizing: border-box;
  }
  {% endunless %}

  #shopify-section-{{ section.id }} .crs__header-container {
    width: 100%;
    box-sizing: border-box;
  }

  @media screen and (min-width: 1401px) {
    #shopify-section-{{ section.id }} .crs__header-container {
      max-width: var(--crs-container-max);
      margin-left: auto;
      margin-right: auto;
      padding-inline: 1.5rem;
    }
  }

  @media screen and (max-width: 1400px) {
    #shopify-section-{{ section.id }} .crs__header-container {
      max-width: none;
      padding-inline: 0;
    }
  }

  @media screen and (max-width: 749px) {
    #shopify-section-{{ section.id }} .crs__header-container {
      padding-inline: 15px;
    }

    #shopify-section-{{ section.id }} .crs__badge {
      padding-inline: 15px;
    }

    #shopify-section-{{ section.id }} .crs__viewport {
      padding-left: 15px;
    }
  }

  #shopify-section-{{ section.id }} .crs__header {
    text-align: center;
    margin: 0 0 {{ section.settings.header_spacing }}px;
  }

  #shopify-section-{{ section.id }} .crs__badge-wrap {
    display: flex;
    justify-content: center;
    margin: 0 0 {{ section.settings.badge_spacing }}px;
  }

  #shopify-section-{{ section.id }} .crs__badge {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.5rem 1rem;
    border-radius: 999px;
    background: var(--crs-badge-bg);
    border: 1px solid {{ section.settings.badge_border_color }};
    color: var(--crs-badge-text);
    font-size: {{ section.settings.badge_font_size }}px;
    line-height: 1.2;
    font-weight: {{ section.settings.badge_font_weight }};
    box-shadow: none;
  }

  #shopify-section-{{ section.id }} .crs__badge-stars {
    display: inline-flex;
    align-items: center;
    gap: 0.1rem;
    color: var(--crs-star-color);
  }

  #shopify-section-{{ section.id }} .crs__badge-stars svg {
    width: {{ section.settings.badge_star_size }}px;
    height: {{ section.settings.badge_star_size }}px;
    display: block;
  }

  #shopify-section-{{ section.id }} .crs__avatars {
    display: flex;
    justify-content: center;
    align-items: center;
    margin: 0 0 {{ section.settings.avatar_spacing }}px;
    padding: 0;
    list-style: none;
  }

  #shopify-section-{{ section.id }} .crs__avatar {
    width: var(--crs-avatar-size);
    height: var(--crs-avatar-size);
    border-radius: 50%;
    overflow: hidden;
    border: 2px solid {{ section.settings.avatar_border_color }};
    margin-left: calc(-1 * var(--crs-avatar-overlap));
    flex: 0 0 var(--crs-avatar-size);
    background: #f3f3f3;
  }

  #shopify-section-{{ section.id }} .crs__avatar:first-child {
    margin-left: 0;
  }

  #shopify-section-{{ section.id }} .crs__avatar img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  #shopify-section-{{ section.id }} .crs__avatars-strip {
    display: flex;
    justify-content: center;
    margin: 0 0 {{ section.settings.avatar_spacing }}px;
  }

  #shopify-section-{{ section.id }} .crs__avatars-strip img {
    display: block;
    width: auto;
    max-width: 100%;
    height: var(--crs-avatars-strip-height);
    object-fit: contain;
  }

  #shopify-section-{{ section.id }} .crs__heading {
    margin: 0 0 {{ section.settings.heading_spacing }}px;
    color: var(--crs-heading-color);
    font-size: {{ section.settings.heading_font_size_mobile }}px;
    font-size: var(--hc-h1-m, {{ section.settings.heading_font_size_mobile }}px);
    line-height: var(--hc-lh-h1, 1.1);
    font-weight: var(--hc-fw-heading, {{ section.settings.heading_font_weight }});
    letter-spacing: var(--hc-ls, 0);
  }

  #shopify-section-{{ section.id }} .crs__subheading {
    margin: 0;
    color: var(--crs-subheading-color);
    font-size: {{ section.settings.subheading_font_size_mobile }}px;
    font-size: var(--hc-h3-m, {{ section.settings.subheading_font_size_mobile }}px);
    line-height: var(--hc-lh-h3, 1.2);
    font-weight: var(--hc-fw-body, {{ section.settings.subheading_font_weight }});
    letter-spacing: var(--hc-ls, 0);
  }

  @media screen and (min-width: 750px) {
    #shopify-section-{{ section.id }} .crs__heading {
      font-size: {{ section.settings.heading_font_size }}px;
      font-size: var(--hc-h1-d, {{ section.settings.heading_font_size }}px);
    }

    #shopify-section-{{ section.id }} .crs__subheading {
      font-size: {{ section.settings.subheading_font_size }}px;
      font-size: var(--hc-h3-d, {{ section.settings.subheading_font_size }}px);
    }
  }

  #shopify-section-{{ section.id }} .crs__carousel-wrap {
    position: relative;
    --crs-carousel-span: 100vw;
    width: 100vw;
    max-width: 100vw;
    margin-left: calc(50% - 50vw);
    margin-right: calc(50% - 50vw);
    padding: 0;
    box-sizing: border-box;
    overflow: visible;
  }

  @media screen and (min-width: 1401px) {
    #shopify-section-{{ section.id }} .crs__carousel-wrap {
      --crs-carousel-span: min(100vw, var(--crs-container-max));
      width: min(100%, var(--crs-container-max));
      max-width: var(--crs-container-max);
      margin-left: auto;
      margin-right: auto;
    }
  }

  #shopify-section-{{ section.id }} .crs__carousel-inner {
    position: relative;
    padding: 0;
    margin: 0;
    overflow: visible;
  }

  #shopify-section-{{ section.id }} .crs__viewport {
    overflow-x: auto;
    overflow-y: visible;
    width: 100%;
    padding-bottom: 32px;
    scroll-behavior: smooth;
    -webkit-overflow-scrolling: touch;
    cursor: grab;
    scrollbar-width: none;
    overscroll-behavior-x: contain;
  }

  #shopify-section-{{ section.id }} .crs__viewport::-webkit-scrollbar {
    display: none;
  }

  #shopify-section-{{ section.id }} .crs__viewport.is-dragging {
    cursor: grabbing;
    scroll-behavior: auto;
    user-select: none;
  }

  #shopify-section-{{ section.id }} .crs__track {
    display: flex;
    align-items: stretch;
    gap: var(--crs-gap);
    width: max-content;
    min-width: 100%;
    padding-inline: 0;
    box-sizing: border-box;
  }

  {%- if slides_mobile == '1' -%}
  #shopify-section-{{ section.id }} .crs__slide {
    flex: 0 0 calc(var(--crs-carousel-span) * {{ mobile_w }} / 100);
    min-width: 0;
    display: flex;
  }
  {%- else -%}
  #shopify-section-{{ section.id }} .crs__slide {
    flex: 0 0 calc((var(--crs-carousel-span) - var(--crs-gap)) / (1 + var(--crs-mobile-side) / 100));
    min-width: 0;
    display: flex;
  }
  {%- endif -%}

  @media screen and (min-width: 750px) {
    {%- if slides_tablet == 1 -%}
    #shopify-section-{{ section.id }} .crs__slide {
      flex-basis: calc(var(--crs-carousel-span) * {{ tablet_w }} / 100);
    }
    {%- elsif slides_tablet == 2 -%}
    #shopify-section-{{ section.id }} .crs__slide {
      flex-basis: calc((var(--crs-carousel-span) - var(--crs-gap)) / (1 + var(--crs-tablet-side) / 100));
    }
    {%- else -%}
    #shopify-section-{{ section.id }} .crs__slide {
      flex-basis: calc((var(--crs-carousel-span) - var(--crs-gap) * 2) / (1 + 2 * var(--crs-tablet-side) / 100));
    }
    {%- endif -%}
  }

  @media screen and (min-width: 990px) {
    {%- if slides_desktop == 1 -%}
    #shopify-section-{{ section.id }} .crs__slide {
      flex-basis: calc(var(--crs-carousel-span) * {{ desktop_w }} / 100);
    }
    {%- elsif slides_desktop == 2 -%}
    #shopify-section-{{ section.id }} .crs__slide {
      flex-basis: calc((var(--crs-carousel-span) - var(--crs-gap)) / (1 + var(--crs-desktop-side) / 100));
    }
    {%- else -%}
    #shopify-section-{{ section.id }} .crs__slide {
      flex-basis: calc((var(--crs-carousel-span) - var(--crs-gap) * {{ slides_desktop | minus: 1 }}) / ({{ slides_desktop | minus: 2 }} + 2 * var(--crs-desktop-side) / 100));
    }
    {%- endif -%}
  }

  #shopify-section-{{ section.id }} .crs__card {
    width: 100%;
    height: auto;
    margin: 0;
    padding: var(--crs-card-padding);
    border-radius: var(--crs-card-radius);
    background: var(--crs-card-bg);
    box-shadow: var(--crs-card-shadow);
    box-sizing: border-box;
    text-align: {{ section.settings.card_text_alignment }};
    display: flex;
    flex-direction: column;
    align-items: {% if section.settings.card_text_alignment == 'center' %}center{% else %}flex-start{% endif %};
  }

  #shopify-section-{{ section.id }} .crs__stars {
    display: inline-flex;
    align-items: center;
    justify-content: {% if section.settings.card_text_alignment == 'center' %}center{% else %}flex-start{% endif %};
    gap: 0.15rem;
    margin: 0 0 {{ section.settings.stars_spacing }}px;
    color: var(--crs-star-color);
  }

  #shopify-section-{{ section.id }} .crs__stars svg {
    width: {{ section.settings.star_size }}px;
    height: {{ section.settings.star_size }}px;
    display: block;
    flex: 0 0 {{ section.settings.star_size }}px;
  }

  #shopify-section-{{ section.id }} .crs__headline {
    margin: 0 0 {{ section.settings.review_headline_spacing }}px;
    color: var(--crs-headline-color);
    font-size: {{ section.settings.review_headline_font_size_mobile }}px;
    font-size: var(--hc-body-m, {{ section.settings.review_headline_font_size_mobile }}px);
    line-height: var(--hc-lh-review-head, 1.35);
    font-weight: var(--hc-fw-extra, {{ section.settings.review_headline_font_weight }});
    font-style: {{ section.settings.review_headline_font_style }};
    letter-spacing: var(--hc-ls, 0);
  }

  #shopify-section-{{ section.id }} .crs__text {
    margin: 0 0 {{ section.settings.review_text_spacing }}px;
    color: var(--crs-text-color);
    font-size: {{ section.settings.review_text_font_size_mobile }}px;
    font-size: var(--hc-review-body, {{ section.settings.review_text_font_size_mobile }}px);
    line-height: var(--hc-lh-body, {{ section.settings.review_text_line_height }}%);
    font-weight: var(--hc-fw-body, {{ section.settings.review_text_font_weight }});
    font-style: {{ section.settings.review_text_font_style }};
    letter-spacing: var(--hc-ls, 0);
    width: 100%;
  }

  #shopify-section-{{ section.id }} .crs__text p {
    margin: 0;
  }

  #shopify-section-{{ section.id }} .crs__text strong,
  #shopify-section-{{ section.id }} .crs__text b,
  #shopify-section-{{ section.id }} .crs__text em,
  #shopify-section-{{ section.id }} .crs__text em strong,
  #shopify-section-{{ section.id }} .crs__text mark {
    color: var(--crs-highlight-color);
    font-weight: {{ section.settings.highlight_font_weight }};
    background: none;
  }

  #shopify-section-{{ section.id }} .crs__text em {
    font-style: italic;
  }

  #shopify-section-{{ section.id }} .crs__name {
    margin: 0 0 {{ section.settings.name_spacing }}px;
    color: var(--crs-name-color);
    font-size: {{ section.settings.name_font_size }}px;
    font-size: var(--hc-review-author, {{ section.settings.name_font_size }}px);
    line-height: 1.3;
    font-weight: var(--hc-fw-extra, {{ section.settings.name_font_weight }});
    letter-spacing: var(--hc-ls, 0);
  }

  #shopify-section-{{ section.id }} .crs__verified {
    display: inline-flex;
    align-items: center;
    justify-content: {% if section.settings.card_text_alignment == 'center' %}center{% else %}flex-start{% endif %};
    gap: 0.35rem;
    margin: 0;
    color: var(--crs-verified-color);
    font-size: {{ section.settings.verified_font_size }}px;
    font-size: var(--hc-review-author, {{ section.settings.verified_font_size }}px);
    line-height: 1.2;
    font-weight: var(--hc-fw-body, {{ section.settings.verified_font_weight }});
  }

  #shopify-section-{{ section.id }} .crs__verified svg {
    width: {{ section.settings.verified_icon_size }}px;
    height: {{ section.settings.verified_icon_size }}px;
    flex: 0 0 {{ section.settings.verified_icon_size }}px;
    display: block;
  }

  #shopify-section-{{ section.id }} .crs__nav {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    z-index: 4;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: auto;
    height: auto;
    padding: 0;
    border: 0;
    border-radius: 0;
    background: transparent;
    color: {{ section.settings.nav_button_color }};
    box-shadow: none;
    cursor: pointer;
    transition: opacity 0.2s ease;
    pointer-events: auto;
  }

  #shopify-section-{{ section.id }} .crs__nav:hover {
    opacity: 0.55;
  }

  #shopify-section-{{ section.id }} .crs__nav:disabled {
    opacity: 0.2;
    cursor: not-allowed;
  }

  #shopify-section-{{ section.id }} .crs__nav--prev {
    left: 12px;
  }

  #shopify-section-{{ section.id }} .crs__nav--next {
    right: 12px;
  }

  #shopify-section-{{ section.id }} .crs__nav svg {
    width: var(--crs-nav-size);
    height: var(--crs-nav-size);
    display: block;
  }

  #shopify-section-{{ section.id }} .crs__carousel-wrap--no-nav .crs__nav {
    display: none;
  }

  @media screen and (max-width: 749px) {
    #shopify-section-{{ section.id }} .crs__nav {
      display: none;
    }

    #shopify-section-{{ section.id }} .crs__card {
      padding: calc(var(--crs-card-padding) * 0.85);
    }
  }
{%- endstyle -%}

<div
  class="crs"
  data-crs-root
  data-slides-desktop="{{ slides_desktop }}"
  data-slides-tablet="{{ slides_tablet }}"
  data-slides-mobile="{{ slides_mobile }}"
>
  <div class="crs__header-container{% if section.settings.use_theme_page_width %} page-width{% endif %}">
    <header class="crs__header">
      {%- if section.settings.show_rating_badge -%}
        <div class="crs__badge-wrap">
          <div class="crs__badge">
            {%- if section.settings.show_badge_stars -%}
              <span class="crs__badge-stars" aria-hidden="true">
                {%- for i in (1..5) -%}
                  <svg viewBox="0 0 16 16" xmlns="http://www.w3.org/2000/svg" fill="currentColor" aria-hidden="true">
                    <path d="M8 1.2L9.9 5.8L14.8 6.1L11.1 9.2L12.2 14.1L8 11.6L3.8 14.1L4.9 9.2L1.2 6.1L6.1 5.8L8 1.2Z"/>
                  </svg>
                {%- endfor -%}
              </span>
            {%- endif -%}
            <span>{{ section.settings.badge_text | escape }}</span>
          </div>
        </div>
      {%- endif -%}

      {%- if section.settings.show_avatars -%}
        {%- if section.settings.avatars_image != blank -%}
          <div class="crs__avatars-strip">
            {{
              section.settings.avatars_image
              | image_url: width: 800
              | image_tag:
                loading: 'lazy',
                widths: '200, 320, 480, 640, 800',
                sizes: '(min-width: 750px) 320px, 240px',
                alt: section.settings.avatars_image_alt | escape
            }}
          </div>
        {%- elsif avatar_blocks.size > 0 -%}
          <ul class="crs__avatars" aria-hidden="true">
            {%- for block in avatar_blocks -%}
              {%- if block.settings.image != blank -%}
                <li class="crs__avatar" {{ block.shopify_attributes }}>
                  {{
                    block.settings.image
                    | image_url: width: 120
                    | image_tag:
                      loading: 'lazy',
                      widths: '60, 80, 100, 120',
                      sizes: '40px',
                      alt: ''
                  }}
                </li>
              {%- endif -%}
            {%- endfor -%}
          </ul>
        {%- endif -%}
      {%- endif -%}

      {%- if section.settings.heading != blank -%}
        <{{ section.settings.heading_tag }} class="crs__heading">
          {{ section.settings.heading | escape }}
        </{{ section.settings.heading_tag }}>
      {%- endif -%}

      {%- if section.settings.subheading != blank -%}
        <p class="crs__subheading">{{ section.settings.subheading | escape }}</p>
      {%- endif -%}
    </header>
  </div>

  {%- if review_blocks.size > 0 -%}
    <div class="crs__carousel-wrap{% unless section.settings.show_nav_arrows %} crs__carousel-wrap--no-nav{% endunless %}">
      <div class="crs__carousel-inner">
        {%- if section.settings.show_nav_arrows -%}
          <button type="button" class="crs__nav crs__nav--prev" data-crs-prev aria-label="Previous reviews">
            <svg xmlns="http://www.w3.org/2000/svg" width="60" height="60" viewBox="0 0 60 60" fill="none" aria-hidden="true">
              <path d="M60 30C60 24.0666 58.2405 18.2664 54.9441 13.3329C51.6476 8.39943 46.9623 4.55426 41.4805 2.28363C35.9987 0.0130005 29.9667 -0.581097 24.1473 0.576458C18.3279 1.73401 12.9824 4.59124 8.78681 8.78681C4.59124 12.9824 1.73401 18.3279 0.576458 24.1473C-0.581097 29.9667 0.0130005 35.9987 2.28363 41.4805C4.55426 46.9623 8.39943 51.6476 13.3329 54.9441C18.2664 58.2405 24.0666 60 30 60C37.9565 60 45.5871 56.8393 51.2132 51.2132C56.8393 45.5871 60 37.9565 60 30ZM47.1429 32.1429H21.1072L33.0643 44.1579L30 47.1429L12.8572 30L30 12.8572L33.0643 15.915L21.1072 27.8572L47.1429 27.8572V32.1429Z" fill="currentColor"/>
            </svg>
          </button>
        {%- endif -%}

        <div class="crs__viewport" data-crs-viewport>
          <div class="crs__track" data-crs-track>
            {%- for block in review_blocks -%}
              {%- assign rating = block.settings.rating | default: 5 -%}
              <article class="crs__slide" data-crs-slide {{ block.shopify_attributes }}>
                <div class="crs__card">
                  {%- if rating > 0 -%}
                    <div class="crs__stars" aria-label="{{ rating }} out of 5 stars">
                      {%- for i in (1..5) -%}
                        <svg
                          viewBox="0 0 16 16"
                          xmlns="http://www.w3.org/2000/svg"
                          aria-hidden="true"
                          {% if i <= rating %}
                            fill="currentColor"
                          {% else %}
                            fill="none" stroke="currentColor" stroke-width="1.2"
                          {% endif %}
                        >
                          <path d="M8 1.2L9.9 5.8L14.8 6.1L11.1 9.2L12.2 14.1L8 11.6L3.8 14.1L4.9 9.2L1.2 6.1L6.1 5.8L8 1.2Z"/>
                        </svg>
                      {%- endfor -%}
                    </div>
                  {%- endif -%}

                  {%- if block.settings.headline != blank -%}
                    <h3 class="crs__headline">{{ block.settings.headline | escape }}</h3>
                  {%- endif -%}

                  {%- if block.settings.text != blank -%}
                    <div class="crs__text rte">{{ block.settings.text }}</div>
                  {%- endif -%}

                  {%- if block.settings.author != blank -%}
                    <p class="crs__name">&ndash;{{ block.settings.author | escape }}</p>
                  {%- endif -%}

                  {%- if block.settings.show_verified -%}
                    <p class="crs__verified">
