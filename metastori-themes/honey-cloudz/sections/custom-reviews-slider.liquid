<script>
  (function () {
    const root = document.querySelector('#shopify-section-{{ section.id }} [data-crs-root]');
    if (!root || root.dataset.crsInit === 'true') return;
    root.dataset.crsInit = 'true';

    const viewport = root.querySelector('[data-crs-viewport]');
    const track = root.querySelector('[data-crs-track]');
    const prevBtn = root.querySelector('[data-crs-prev]');
    const nextBtn = root.querySelector('[data-crs-next]');
    const slides = Array.from(root.querySelectorAll('[data-crs-slide]'));

    if (!viewport || !track || slides.length === 0) return;

    let activeIndex = 0;
    let isDragging = false;
    let dragStartX = 0;
    let dragScrollLeft = 0;
    let dragMoved = false;
    let scrollTimer = null;
    let isSnapping = false;

    function getTargetScroll(index) {
      const slide = slides[index];
      if (!slide) return 0;

      const viewportWidth = viewport.clientWidth;
      const lastIndex = slides.length - 1;

      if (index <= 0) {
        return Math.max(0, slide.offsetLeft);
      }

      if (index >= lastIndex) {
        return Math.max(0, slide.offsetLeft + slide.offsetWidth - viewportWidth);
      }

      const slideCenter = slide.offsetLeft + slide.offsetWidth / 2;
      return Math.max(0, slideCenter - viewportWidth / 2);
    }

    function getNearestIndex() {
      let nearest = 0;
      let minDist = Infinity;

      slides.forEach(function (slide, index) {
        const target = getTargetScroll(index);
        const dist = Math.abs(viewport.scrollLeft - target);
        if (dist < minDist) {
          minDist = dist;
          nearest = index;
        }
      });

      return nearest;
    }

    function updateTrackPadding() {
      const slide = slides[0];
      if (!slide) return;

      const viewportWidth = viewport.clientWidth;
      const slideWidth = slide.offsetWidth;
      const edgePad = Math.max(0, viewportWidth - slideWidth);

      track.style.paddingLeft = '0px';
      track.style.paddingRight = edgePad + 'px';
    }

    function scrollToIndex(index, smooth) {
      activeIndex = Math.max(0, Math.min(slides.length - 1, index));
      const left = getTargetScroll(activeIndex);
      isSnapping = true;
      viewport.scrollTo({ left: left, behavior: smooth ? 'smooth' : 'auto' });
      window.setTimeout(function () {
        isSnapping = false;
        syncNavState();
      }, smooth ? 350 : 0);
    }

    function snapToNearest(smooth) {
      scrollToIndex(getNearestIndex(), smooth);
    }

    function measure() {
      updateTrackPadding();
      scrollToIndex(activeIndex, false);
      syncNavState();
    }

    function syncNavState() {
      if (!prevBtn && !nextBtn) return;
      if (prevBtn) prevBtn.disabled = activeIndex <= 0;
      if (nextBtn) nextBtn.disabled = activeIndex >= slides.length - 1;
    }

    function goByStep(direction) {
      scrollToIndex(activeIndex + direction, true);
    }

    viewport.addEventListener(
      'scroll',
      function () {
        if (!isSnapping) {
          activeIndex = getNearestIndex();
        }
        syncNavState();
        if (isDragging || isSnapping) return;
        window.clearTimeout(scrollTimer);
        scrollTimer = window.setTimeout(function () {
          snapToNearest(true);
        }, 140);
      },
      { passive: true }
    );

    if (prevBtn) {
      prevBtn.addEventListener('click', function () {
        goByStep(-1);
      });
    }

    if (nextBtn) {
      nextBtn.addEventListener('click', function () {
        goByStep(1);
      });
    }

    viewport.addEventListener('pointerdown', function (event) {
      if (event.pointerType === 'mouse' && event.button !== 0) return;
      isDragging = true;
      dragMoved = false;
      dragStartX = event.clientX;
      dragScrollLeft = viewport.scrollLeft;
      viewport.classList.add('is-dragging');
      window.clearTimeout(scrollTimer);
      if (viewport.setPointerCapture) {
        viewport.setPointerCapture(event.pointerId);
      }
    });

    viewport.addEventListener('pointermove', function (event) {
      if (!isDragging) return;
      const delta = event.clientX - dragStartX;
      if (Math.abs(delta) > 4) dragMoved = true;
      viewport.scrollLeft = dragScrollLeft - delta;
    });

    function endDrag(event) {
      if (!isDragging) return;
      isDragging = false;
      viewport.classList.remove('is-dragging');
      if (viewport.releasePointerCapture && event.pointerId !== undefined) {
        try {
          viewport.releasePointerCapture(event.pointerId);
        } catch (e) {}
      }
      snapToNearest(true);
    }

    viewport.addEventListener('pointerup', endDrag);
    viewport.addEventListener('pointercancel', endDrag);

    viewport.addEventListener(
      'click',
      function (event) {
        if (dragMoved) {
          event.preventDefault();
          event.stopPropagation();
        }
      },
      true
    );

    window.addEventListener('resize', measure);
    measure();
  })();
</script>

