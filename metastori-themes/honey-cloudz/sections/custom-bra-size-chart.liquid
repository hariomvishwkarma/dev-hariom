{%- liquid
  assign cols = section.settings.column_labels | split: ','
  assign col_count = cols.size
  if col_count < 1
    assign col_count = 1
  endif

  assign show_sidebar = false
  if section.settings.show_sidebar and section.settings.sidebar_label != blank
    assign show_sidebar = true
  endif
-%}

{%- style -%}
  #shopify-section-{{ section.id }} .bsc {
    --bsc-heading: {{ section.settings.heading_color }};
    --bsc-sub: {{ section.settings.subheading_color }};
    --bsc-header-bg: {{ section.settings.header_background }};
    --bsc-header-text: {{ section.settings.header_text_color }};
    --bsc-cell-text: {{ section.settings.cell_text_color }};
    --bsc-border: {{ section.settings.cell_border_color }};
    --bsc-radius: {{ section.settings.table_radius }}px;
    --bsc-header-h: 54px;
    --bsc-row-h: 52px;
    --bsc-sidebar-w: {{ section.settings.sidebar_width }}px;
    --bsc-heading-size: {{ section.settings.heading_font_size_desktop }}px;
    --bsc-sub-size: {{ section.settings.subheading_font_size_desktop }}px;
    background-color: {{ section.settings.background_color }};
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }

  #shopify-section-{{ section.id }} .bsc__inner {
    max-width: {{ section.settings.content_max_width }}px;
    margin: 0 auto;
    padding-inline: {{ section.settings.side_padding }}px;
    box-sizing: border-box;
  }

  #shopify-section-{{ section.id }} .bsc__header {
    text-align: {{ section.settings.text_alignment }};
    margin: 0 auto {{ section.settings.header_spacing }}px;
    max-width: {{ section.settings.heading_max_width }}px;
  }

  #shopify-section-{{ section.id }} .bsc__heading {
    margin: 0 0 {{ section.settings.heading_spacing }}px;
    color: var(--bsc-heading);
    font-size: var(--bsc-heading-size);
    font-weight: {{ section.settings.heading_font_weight }};
    line-height: {{ section.settings.heading_line_height }}%;
    letter-spacing: -0.02em;
  }

  #shopify-section-{{ section.id }} .bsc__subheading {
    margin: 0;
    color: var(--bsc-sub);
    font-size: var(--bsc-sub-size);
    font-weight: {{ section.settings.subheading_font_weight }};
    line-height: 1.45;
  }

  #shopify-section-{{ section.id }} .bsc__chart-wrap {
    display: flex;
    align-items: stretch;
    width: 100%;
  }

  #shopify-section-{{ section.id }} .bsc__scroll-wrap {
    position: relative;
    flex: 1;
    min-width: 0;
  }

  #shopify-section-{{ section.id }} .bsc__scroll {
    width: 100%;
    overflow-x: auto;
    overflow-y: hidden;
    -webkit-overflow-scrolling: touch;
    border-radius: var(--bsc-radius);
  }

  #shopify-section-{{ section.id }} .bsc__chart-wrap.has-sidebar .bsc__scroll {
    border-radius: var(--bsc-radius) var(--bsc-radius) 0 var(--bsc-radius);
  }

  #shopify-section-{{ section.id }} .bsc__scroll-hint {
    display: none;
    appearance: none;
    margin: 0;
    padding: 0;
  }

  #shopify-section-{{ section.id }} .bsc__table {
    width: 100%;
    min-width: {{ section.settings.table_min_width }}px;
    border-collapse: separate;
    border-spacing: 0;
    table-layout: fixed;
    background: linear-gradient(
      {{ section.settings.gradient_angle }}deg,
      {{ section.settings.gradient_start }},
      {{ section.settings.gradient_end }}
    );
    font-size: {{ section.settings.cell_font_size }}px;
    font-weight: {{ section.settings.cell_font_weight }};
    color: var(--bsc-cell-text);
  }

  #shopify-section-{{ section.id }} .bsc__table th,
  #shopify-section-{{ section.id }} .bsc__table td {
    box-sizing: border-box;
    text-align: center;
    vertical-align: middle;
    padding: {{ section.settings.cell_padding_y }}px {{ section.settings.cell_padding_x }}px;
    line-height: 1.2;
    white-space: nowrap;
    height: var(--bsc-row-h);
    border-right: 1px solid var(--bsc-border);
    border-bottom: 1px solid var(--bsc-border);
  }

  #shopify-section-{{ section.id }} .bsc__table thead th:last-child,
  #shopify-section-{{ section.id }} .bsc__table tbody td:last-child {
    border-right: 0;
  }

  #shopify-section-{{ section.id }} .bsc__table tbody tr:last-child th,
  #shopify-section-{{ section.id }} .bsc__table tbody tr:last-child td {
    border-bottom: 0;
  }

  #shopify-section-{{ section.id }} .bsc__table thead th,
  #shopify-section-{{ section.id }} .bsc__row-label {
    border-right-color: rgba(255, 255, 255, 0.45);
    border-bottom-color: rgba(255, 255, 255, 0.45);
  }

  #shopify-section-{{ section.id }} .bsc__table thead th {
    background-color: var(--bsc-header-bg);
    color: var(--bsc-header-text);
    font-weight: {{ section.settings.header_font_weight }};
    font-size: {{ section.settings.header_font_size }}px;
    letter-spacing: 0.04em;
    height: var(--bsc-header-h);
    padding: 16px {{ section.settings.cell_padding_x }}px;
  }

  #shopify-section-{{ section.id }} .bsc__corner {
    position: sticky;
    left: 0;
    z-index: 3;
    text-transform: uppercase;
    min-width: {{ section.settings.row_label_width }}px;
    width: {{ section.settings.row_label_width }}px;
    letter-spacing: 0.08em;
  }

  #shopify-section-{{ section.id }} .bsc__row-label {
    background-color: var(--bsc-header-bg);
    color: var(--bsc-header-text);
    font-weight: {{ section.settings.header_font_weight }};
    position: sticky;
    left: 0;
    z-index: 1;
    min-width: {{ section.settings.row_label_width }}px;
    width: {{ section.settings.row_label_width }}px;
    letter-spacing: 0.02em;
  }

  #shopify-section-{{ section.id }} .bsc__sidebar {
    flex: 0 0 var(--bsc-sidebar-w);
    width: var(--bsc-sidebar-w);
    margin-top: var(--bsc-header-h);
    background-color: var(--bsc-header-bg);
    color: var(--bsc-header-text);
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 0 var(--bsc-radius) var(--bsc-radius) 0;
    box-sizing: border-box;
  }

  #shopify-section-{{ section.id }} .bsc__sidebar-text {
    display: inline-block;
    writing-mode: vertical-rl;
    transform: rotate(180deg);
    font-size: {{ section.settings.sidebar_font_size }}px;
    font-weight: {{ section.settings.header_font_weight }};
    letter-spacing: 0.18em;
    text-transform: uppercase;
    line-height: 1;
    padding: 8px 0;
  }

  @media screen and (max-width: 989px) {
    #shopify-section-{{ section.id }} .bsc {
      --bsc-heading-size: {{ section.settings.heading_font_size_tablet }}px;
      --bsc-sub-size: {{ section.settings.subheading_font_size_tablet }}px;
    }
  }

  @media screen and (max-width: 749px) {
    #shopify-section-{{ section.id }} .bsc {
      --bsc-heading-size: {{ section.settings.heading_font_size_mobile }}px;
      --bsc-sub-size: {{ section.settings.subheading_font_size_mobile }}px;
      padding-top: {{ section.settings.padding_top_mobile }}px;
      padding-bottom: {{ section.settings.padding_bottom_mobile }}px;
      --bsc-header-h: 46px;
      --bsc-row-h: 44px;
      --bsc-sidebar-w: {{ section.settings.sidebar_width_mobile }}px;
    }

    #shopify-section-{{ section.id }} .bsc__inner {
      padding-inline: {{ section.settings.side_padding_mobile }}px;
    }

    #shopify-section-{{ section.id }} .bsc__table {
      font-size: {{ section.settings.cell_font_size_mobile }}px;
    }

    #shopify-section-{{ section.id }} .bsc__table th,
    #shopify-section-{{ section.id }} .bsc__table td {
      padding: 10px 6px;
    }

    #shopify-section-{{ section.id }} .bsc__table thead th {
      padding: 12px 6px;
    }

    #shopify-section-{{ section.id }} .bsc__sidebar-text {
      font-size: {{ section.settings.sidebar_font_size_mobile }}px;
    }

    {%- if section.settings.show_table_scroll_hint_mobile -%}
    #shopify-section-{{ section.id }} .bsc__scroll-wrap.has-scroll .bsc__scroll-hint {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      position: absolute;
      top: 50%;
      right: 8px;
      transform: translateY(-50%);
      width: 32px;
      height: 32px;
      border-radius: 50%;
      background: #ffffff;
      border: 1px solid var(--bsc-header-bg);
      color: var(--bsc-header-bg);
      box-shadow: 0 2px 8px rgba(17, 17, 17, 0.12);
      pointer-events: auto;
      cursor: pointer;
      z-index: 4;
      transition: opacity 0.2s ease;
    }

    #shopify-section-{{ section.id }} .bsc__scroll-hint svg {
      width: 12px;
      height: 12px;
      display: block;
      pointer-events: none;
    }

    #shopify-section-{{ section.id }} .bsc__scroll-wrap.is-at-end .bsc__scroll-hint {
      opacity: 0;
      pointer-events: none;
    }
    {%- endif -%}
  }
{%- endstyle -%}

<div class="bsc" id="hc-size-chart">
  <div class="bsc__inner">
    {%- if section.settings.heading != blank or section.settings.subheading != blank -%}
      <div class="bsc__header">
        {%- if section.settings.heading != blank -%}
          <{{ section.settings.heading_tag }} class="bsc__heading">{{ section.settings.heading | escape }}</{{ section.settings.heading_tag }}>
        {%- endif -%}
        {%- if section.settings.subheading != blank -%}
          <p class="bsc__subheading">{{ section.settings.subheading | escape }}</p>
        {%- endif -%}
      </div>
    {%- endif -%}

    <div class="bsc__chart-wrap{% if show_sidebar %} has-sidebar{% endif %}">
      <div class="bsc__scroll-wrap">
        <div class="bsc__scroll">
          <table class="bsc__table">
            <thead>
              <tr>
                <th class="bsc__corner" scope="col">{{ section.settings.corner_label | escape }}</th>
                {%- for col in cols -%}
                  <th scope="col">{{ col | strip | escape }}</th>
                {%- endfor -%}
              </tr>
            </thead>
            <tbody>
              {%- for block in section.blocks -%}
                {%- if block.type == 'row' -%}
                  {%- assign cells = block.settings.cells | split: ',' -%}
                  <tr {{ block.shopify_attributes }}>
                    <th class="bsc__row-label" scope="row">{{ block.settings.label | escape }}</th>
                    {%- for i in (1..col_count) -%}
                      {%- assign idx = i | minus: 1 -%}
                      <td>{{ cells[idx] | strip | escape }}</td>
                    {%- endfor -%}
                  </tr>
                {%- endif -%}
              {%- endfor -%}
            </tbody>
          </table>
        </div>
        <button type="button" class="bsc__scroll-hint" data-bsc-scroll-hint aria-label="Scroll table right">
          <svg viewBox="0 0 12 12" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
            <path d="M4.5 2.5L8 6L4.5 9.5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </button>
      </div>
      {%- if show_sidebar -%}
        <div class="bsc__sidebar" aria-hidden="true">
          <span class="bsc__sidebar-text">{{ section.settings.sidebar_label | escape }}</span>
        </div>
      {%- endif -%}
    </div>
  </div>
</div>

<script>
  (function () {
    var root = document.getElementById('hc-size-chart');
    if (!root) return;
    var hintsEnabled = {{ section.settings.show_table_scroll_hint_mobile | json }};

    function syncScrollHints() {
      if (!hintsEnabled) return;
      root.querySelectorAll('.bsc__scroll-wrap').forEach(function (wrap) {
        var scroller = wrap.querySelector('.bsc__scroll');
        if (!scroller) return;
        var max = scroller.scrollWidth - scroller.clientWidth;
        var canScroll = max > 4;
        wrap.classList.toggle('has-scroll', canScroll);
        wrap.classList.toggle('is-at-end', !canScroll || scroller.scrollLeft >= max - 4);
      });
    }

    function slideTable(scroller, direction) {
      if (!scroller) return;
      var amount = Math.max(160, Math.round(scroller.clientWidth * 0.75));
      scroller.scrollBy({ left: direction * amount, behavior: 'smooth' });
    }

    root.querySelectorAll('.bsc__scroll').forEach(function (scroller) {
      scroller.addEventListener('scroll', syncScrollHints, { passive: true });
    });

    root.querySelectorAll('[data-bsc-scroll-hint]').forEach(function (hint) {
      hint.addEventListener('click', function () {
        var wrap = hint.closest('.bsc__scroll-wrap');
        var scroller = wrap && wrap.querySelector('.bsc__scroll');
        slideTable(scroller, 1);
      });
    });

    syncScrollHints();
    window.addEventListener('resize', syncScrollHints);
  })();
</script>

{% schema %}
{
  "name": "Custom bra size chart",
  "settings": [
    {
      "type": "header",
      "content": "Background"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Full-width background",
      "default": "#FDF7F4"
    },
    {
      "type": "header",
      "content": "Heading"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Bra Sized Based for Superior Fit"
    },
    {
      "type": "select",
      "id": "heading_tag",
      "label": "Heading tag",
      "options": [
        { "value": "h1", "label": "H1" },
        { "value": "h2", "label": "H2" },
        { "value": "h3", "label": "H3" }
      ],
      "default": "h2"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading",
      "default": "Match your current bra size to the best insert size for a secure, all-day stay."
    },
    {
      "type": "select",
      "id": "text_alignment",
      "label": "Text alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ],
      "default": "center"
    },
    {
      "type": "color",
