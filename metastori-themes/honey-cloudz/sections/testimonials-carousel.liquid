{% schema %}
{
  "name": "Testimonials Carousel",
  "tag": "section",
  "class": "ts-section",
  "settings": [
    {
      "type": "header",
      "content": "── Badge ──"
    },
    {
      "type": "checkbox",
      "id": "show_badge",
      "label": "Show badge",
      "default": true
    },
    {
      "type": "textarea",
      "id": "badge_text",
      "label": "Badge text",
      "default": "Trusted & Loved by 67,000+ Women"
    },
    {
      "type": "color",
      "id": "badge_bg",
      "label": "Badge background",
      "default": "#cde3ea"
    },
    {
      "type": "color",
      "id": "badge_color",
      "label": "Badge text color",
      "default": "#333333"
    },
    {
      "type": "range",
      "id": "badge_size",
      "label": "Badge font size (px)",
      "min": 10, "max": 20, "step": 1,
      "default": 15
    },
    {
      "type": "header",
      "content": "── Heading ──"
    },
    {
      "type": "textarea",
      "id": "heading",
      "label": "Heading (use <strong> for bold parts)",
      "default": "Proven to <strong>Perform.</strong> Loved by <strong>Thousands.</strong>"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading color",
      "default": "#000000"
    },
    {
      "type": "range",
      "id": "heading_size",
      "label": "Heading font size — Desktop (px)",
      "min": 20, "max": 80, "step": 2,
      "default": 56
    },
    {
      "type": "range",
      "id": "heading_size_mobile",
      "label": "Heading font size — Mobile (px)",
      "min": 16, "max": 48, "step": 2,
      "default": 32
    },
    {
      "type": "header",
      "content": "── Carousel ──"
    },
    {
      "type": "range",
      "id": "slides_desktop",
      "label": "Slides per view — Desktop",
      "min": 1, "max": 4, "step": 0.1,
      "default": 2
    },
    {
        "type": "range",
        "id": "slides_tablet",
        "label": "Slides per view — Tablet (550px–1000px)",
        "min": 1,
        "max": 3,
        "step": 0.1,
        "default": 1.5
    },
    {
      "type": "range",
      "id": "slides_mobile",
      "label": "Slides per view — Mobile",
      "min": 1, "max": 2, "step": 0.1,
      "default": 1.1
    },
    {
      "type": "range",
      "id": "space_between",
      "label": "Gap between cards (px)",
      "min": 0, "max": 60, "step": 2,
      "default": 40
    },
    {
      "type": "range",
      "id": "slide_speed",
      "label": "Slide speed (ms)",
      "min": 200, "max": 1000, "step": 50,
      "default": 500
    },
    {
      "type": "checkbox",
      "id": "autoplay",
      "label": "Enable autoplay",
      "default": false
    },
    {
      "type": "range",
      "id": "autoplay_delay",
      "label": "Autoplay delay (ms)",
      "min": 1000, "max": 8000, "step": 500,
      "default": 3000
    },
    {
      "type": "checkbox",
      "id": "show_dots",
      "label": "Show pagination dots",
      "default": false
    },
    {
      "type": "header",
      "content": "── Card Style ──"
    },
    {
      "type": "color",
      "id": "card_bg",
      "label": "Card background color",
      "default": "#C8C1F2"
    },
    {
