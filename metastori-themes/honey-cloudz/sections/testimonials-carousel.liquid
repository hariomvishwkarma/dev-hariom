<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.css"/>

{% assign sid = section.id %}

<style>
  /* ── Reset ── */
  #ts-{{ sid }} * { box-sizing: border-box; margin: 0; padding: 0; }

  /* ── Section ── */
  #ts-{{ sid }} {
    background: {{ section.settings.section_bg }};
    padding: {{ section.settings.padding_top }}px 0 {{ section.settings.padding_bottom }}px;
    font-family: inherit;
    overflow: hidden;
  }

  /* ── Header ── */
  #ts-{{ sid }} .ts-header {
    text-align: center;
    padding: 0 20px;
    margin-bottom: {{ section.settings.header_bottom_gap }}px;
  }

  #ts-{{ sid }} .ts-badge {
    display: inline-block;
    background: {{ section.settings.badge_bg }};
    color: {{ section.settings.badge_color }};
    font-size: {{ section.settings.badge_size }}px;
    padding: 6px 32px;
    border-radius: 999px;
    margin-bottom: 30px;
    line-height: 22px;
    letter-spacing:0;
    font-family: 'Satoshi', system-ui, -apple-system, Segoe UI, Roboto, Arial, sans-serif;
    border:1px solid #00000033;
  }

  #ts-{{ sid }} .ts-heading {
    font-size: {{ section.settings.heading_size }}px;
    font-weight: 400;
    color: {{ section.settings.heading_color }};
    line-height: 1.15;
    font-family: "Send Flowers", " sans-serif";
  }
  #ts-{{ sid }} .ts-heading strong { font-weight: 500; font-family: Poppins, " sans-serif"; font-size:48px; line-height:58px; }

  @media (max-width: 767px) {
    #ts-{{ sid }} .ts-heading {
      font-size: {{ section.settings.heading_size_mobile }}px;
    }
  }

  /* ── Swiper container ── */
  #ts-{{ sid }} .swiper {
    overflow: visible !important;
    padding-bottom: {% if section.settings.show_dots %}44px{% else %}8px{% endif %} !important;
  }

  /* swiper-slide must have explicit height so wrapper height is known */
  #ts-{{ sid }} .swiper-slide {
    height: auto;
  }

  /* ── Card ── */
  #ts-{{ sid }} .ts-card {
    background: {{ section.settings.card_bg }};
    border-radius: {{ section.settings.card_radius }}px;
    padding: {{ section.settings.card_padding }}px;
    display: flex;
    flex-direction: row;
    align-items: center;
    gap: {{ section.settings.card_gap }}px;
    min-height: {{ section.settings.card_height }}px;
    position: relative;
    height:100%;
  }

  

  /* ── Image ── */
  #ts-{{ sid }} .ts-img {
    width: 100%;
    max-width: {{ section.settings.img_width }}px;
    border-radius: {{ section.settings.img_radius }}px;
    object-fit: cover;
    object-position: top center;
    align-self: stretch;
    display: block;
    height: fit-content;
    border:1px solid #00000099;
  }

  /* ── Text block ── */
  #ts-{{ sid }} .ts-content {
    flex: 1;
    text-align: left;
    display: flex;
    flex-direction: column;
    gap: 20px;
    min-width: 0;
  }

  /* ── Stars ── */
  #ts-{{ sid }} .ts-stars {
    display: flex;
    gap: 2px;
    flex-wrap: nowrap;
  }
  #ts-{{ sid }} .ts-stars polygon{
    stroke:#000;
}
  #ts-{{ sid }} .ts-stars svg {
    width: {{ section.settings.star_size }}px;
    height: {{ section.settings.star_size }}px;
    flex-shrink: 0;
  }

  /* ── Review title ── */
  #ts-{{ sid }} .ts-title {
    font-size: {{ section.settings.rtitle_size }}px;
    font-weight: 700;
    color: {{ section.settings.rtitle_color }};
    line-height: 34px;
    font-family: 'Satoshi', system-ui, -apple-system, Segoe UI, Roboto, Arial, sans-serif;
    letter-spacing:0px;
  }

  /* ── Review body ── */
  #ts-{{ sid }} .ts-text {
    font-size: {{ section.settings.rbody_size }}px;
    color: {{ section.settings.rbody_color }};
    line-height: 28px;
    letter-spacing:0px;
    font-family: 'Satoshi', system-ui, -apple-system, Segoe UI, Roboto, Arial, sans-serif;
    font-weight:500;
  }

  /* ── Reviewer name ── */
  #ts-{{ sid }} .ts-name {
    font-size: {{ section.settings.rname_size }}px;
    font-weight: 700;
    color: {{ section.settings.rname_color }};
    font-family: 'Satoshi', system-ui, -apple-system, Segoe UI, Roboto, Arial, sans-serif;
  }

  /* ── Navigation arrows ── */
  /* Hide default Swiper arrows */
  #ts-{{ sid }} .swiper-button-prev,
  #ts-{{ sid }} .swiper-button-next {
    display: none !important;
  }

  /* Wrapper holds swiper + fixed arrows */
  #ts-{{ sid }} .ts-carousel-wrap {
    position: relative;
    /* height comes from the swiper content */
  }

  /* Base arrow — fixed to wrapper, never moves */
  #ts-{{ sid }} .ts-arrow {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    width: {{ section.settings.arrow_size }}px;
    height: {{ section.settings.arrow_size }}px;
    border-radius: 50%;
    background: {{ section.settings.arrow_bg }};
    border: none;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 30;
    box-shadow: 0 2px 12px rgba(0,0,0,0.25);
    transition: background 0.18s;
    padding: 0;
    flex-shrink: 0;
    border:1px solid;
    border-color:{{ section.settings.arrow_bg }};
  }
  /* Next — right side */
  #ts-{{ sid }} .ts-arrow-next {
    right: {{ section.settings.arrow_offset }};
  }
  /* Prev — left side */
  #ts-{{ sid }} .ts-arrow-prev {
    left: {{ section.settings.arrow_offset }};
  }
  #ts-{{ sid }} .ts-arrow svg {
    width: 18px; height: 18px;
    stroke: {{ section.settings.arrow_icon_color }};
    fill: none; stroke-width: 2.5;
    stroke-linecap: round; stroke-linejoin: round;
  }
  #ts-{{ sid }} .ts-arrow-next svg { position: relative; left: 1px; }
  #ts-{{ sid }} .ts-arrow-prev svg { position: relative; right: 1px; }
  #ts-{{ sid }} .ts-arrow img {
    width: {{ section.settings.arrow_img_size }}px;
    height: {{ section.settings.arrow_img_size }}px;
    object-fit: contain;
    {% comment %} display: block; {% endcomment %}
  }
  #ts-{{ sid }} .ts-arrow:hover { background: {{ section.settings.arrow_hover_bg }}; }

  /* ── Pagination dots ── */
  #ts-{{ sid }} .swiper-pagination-bullet {
    background: {{ section.settings.card_bg }};
    opacity: 0.5;
    width: 8px; height: 8px;
  }
  #ts-{{ sid }} .swiper-pagination-bullet-active {
    background: {{ section.settings.heading_color }};
    opacity: 1;
  }

  /* ── CTA ── */
  #ts-{{ sid }} .ts-cta {
    margin-top: {{ section.settings.cta_gap }}px;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 24px;
    text-align: center;
    padding: 0 20px;
  }

  #ts-{{ sid }} .ts-cta-btn {
    display: inline-block;
    background: {{ section.settings.cta_bg }};
    color: {{ section.settings.cta_color }};
    font-size: {{ section.settings.cta_size }}px;
    font-weight: 600;
    padding: {{ section.settings.cta_pv }}px {{ section.settings.cta_ph }}px;
    border-radius: {{ section.settings.cta_radius }}px;
    text-decoration: none;
    letter-spacing: 0.02em;
    transition: opacity 0.2s;
    border:1px solid {{ section.settings.cta_bg }};
    cursor:pointer;
  }
  #ts-{{ sid }} .ts-cta-btn:hover { color: {{ section.settings.cta_color_hvr }}; background: {{ section.settings.cta_bg_hvr }}; }

  #ts-{{ sid }} .ts-guarantee {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: {{ section.settings.guar_size }}px;
    color: {{ section.settings.guar_color }};
    font-family: 'Satoshi', system-ui, -apple-system, Segoe UI, Roboto, Arial, sans-serif;
    font-weight:700;
  }
  #ts-{{ sid }} .ts-guarantee svg {
    width: 16px; height: 16px;
    stroke: {{ section.settings.guar_color }};
    fill: none; stroke-width: 2; flex-shrink: 0;
  }
  #ts-{{ sid }} .ts-arr-hover { display: none; }
  #ts-{{ sid }} .ts-arrow:hover .ts-arr-default { display: none; }
  #ts-{{ sid }} .ts-arrow:hover .ts-arr-hover { display: block; }

  #ts-{{ sid }} .button-inner-box{
    position:absolute;
    top:50%;
    left:50%;
    transform:translate(-50%,-50%);
    width:100%;
    max-width:800px;
    display:flex;
    justify-content:flex-start;
    z-index: 20;
  }

  @media (max-width: 767px) {
    #ts-{{ sid }} .ts-card {
      min-height: {{ section.settings.card_height_mobile }}px;
      flex-direction: column;
      padding:0;
      gap:0;
    }
    #ts-{{ sid }} .ts-img{
        max-width:100%;
        max-height:300px;
        border-radius :unset;
        border-top-left-radius: 39px;
        border-top-right-radius: 39px;
    }
    #ts-{{ sid }} .ts-content{
        text-align:center;
        padding: 34px 20px;
        gap:12px;
    }
    #ts-{{ sid }} .ts-stars{
        justify-content:center;
    }
    #ts-{{ sid }} .ts-title {
    font-size: {{ section.settings.rtitle_size_mobile }}px;
    }

    /* ── Review body ── */
    #ts-{{ sid }} .ts-text {
        font-size: {{ section.settings.rbody_size_mobile }}px;
    }

    /* ── Reviewer name ── */
    #ts-{{ sid }} .ts-name {
        font-size: {{ section.settings.rname_size_mobile }}px;
    }
    #ts-{{ sid }} .ts-arrow-next {
    right: 20px;
    }
    /* Prev — left side */
    #ts-{{ sid }} .ts-arrow-prev {
        left: 20px;
    }
    #ts-{{ sid }} .ts-heading strong { font-size:28px; line-height:38px; }
  }
</style>

<section id="ts-{{ sid }}">

  <!-- Header -->
  <div class="ts-header">
    {% if section.settings.show_badge and section.settings.badge_text != blank %}
      <div><span class="ts-badge">{{ section.settings.badge_text }}</span></div>
    {% endif %}
    {% if section.settings.heading != blank %}
      <h2 class="ts-heading">{{ section.settings.heading }}</h2>
    {% endif %}
  </div>

  <!-- Carousel wrapper with fixed arrows -->
  <div class="ts-carousel-wrap" id="ts-wrap-{{ sid }}">

    <!-- Fixed Prev Arrow -->
    {% comment %} <button class="ts-arrow ts-arrow-prev ts-prev-{{ sid }}" aria-label="Previous slide">
      {% if section.settings.arrow_prev_img != blank %}
        <img src="{{ section.settings.arrow_prev_img | image_url: width: 80 }}" alt="previous">
      {% else %}
        <svg viewBox="0 0 24 24"><polyline points="15 18 9 12 15 6"/></svg>
      {% endif %}
    </button> {% endcomment %}

    <div class="button-inner-box">
        <button class="ts-arrow ts-arrow-prev ts-prev-{{ sid }}">
            {% if section.settings.arrow_prev_img != blank %}
                <img class="ts-arr-default" src="{{ section.settings.arrow_prev_img | image_url: width: 80 }}" alt="prev">
                {% if section.settings.arrow_prev_img_hover != blank %}
                <img class="ts-arr-hover" src="{{ section.settings.arrow_prev_img_hover | image_url: width: 80 }}" alt="prev hover">
                {% endif %}
            {% else %}
                <svg viewBox="0 0 24 24"><polyline points="15 18 9 12 15 6"/></svg>
            {% endif %}
        </button>

        <!-- Fixed Next Arrow -->
        <button class="ts-arrow ts-arrow-next ts-next-{{ sid }}" aria-label="Next slide">
        {% if section.settings.arrow_next_img != blank %}
            <img  class="ts-arr-default" src="{{ section.settings.arrow_next_img | image_url: width: 80 }}" alt="next">
            {% if section.settings.arrow_next_img_hover != blank %}
                <img class="ts-arr-hover" src="{{ section.settings.arrow_next_img_hover | image_url: width: 80 }}" alt="next hover">
            {% endif %}
        {% else %}
            <svg viewBox="0 0 24 24"><polyline points="9 18 15 12 9 6"/></svg>
        {% endif %}
        </button>
    </div>
  <div class="swiper ts-swiper-{{ sid }}">
    <div class="swiper-wrapper">
      {% for block in section.blocks %}
        {% if block.type == 'review' %}
          <div class="swiper-slide" {{ block.shopify_attributes }}>
            <div class="ts-card">

              <!-- Image -->
              {% if block.settings.image != blank %}
                <img
                  src="{{ block.settings.image | image_url: width: 400 }}"
                  class="ts-img"
                  loading="lazy"
                  alt="{{ block.settings.name | escape }}"
                >
              {% elsif block.settings.image_url != blank %}
                <img
                  src="{{ block.settings.image_url }}"
                  class="ts-img"
                  loading="lazy"
                  alt="{{ block.settings.name | escape }}"
                >
              {% endif %}

              <!-- Text -->
              <div class="ts-content">
                <div class="ts-stars">
                  {% assign rating = block.settings.stars | default: 5 %}
                  {% for i in (1..5) %}
                    {% if i <= rating %}
                      <svg viewBox="0 0 24 24"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2" fill="{{ section.settings.star_color }}" stroke="{{ section.settings.star_color }}" stroke-width="1"/></svg>
                    {% else %}
                      <svg viewBox="0 0 24 24"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2" fill="transparent" stroke="{{ section.settings.star_color }}" stroke-width="1.5"/></svg>
                    {% endif %}
                  {% endfor %}
                </div>

                {% if block.settings.title != blank %}
                  <div class="ts-title">{{ block.settings.title }}</div>
                {% endif %}
                {% if block.settings.text != blank %}
                  <div class="ts-text">{{ block.settings.text }}</div>
                {% endif %}
                {% if block.settings.name != blank %}
                  <div class="ts-name">{{ block.settings.name }}</div>
                {% endif %}
              </div>
            </div>
          </div>
        {% endif %}
      {% endfor %}
    </div>

    {% if section.settings.show_dots %}
      <div class="swiper-pagination"></div>
    {% endif %}
  </div>

  </div><!-- end ts-carousel-wrap -->

  <!-- CTA -->
  {% if section.settings.show_cta %}
    <div class="ts-cta">
       <a
        class="ts-cta-btn"
        {% if section.settings.cta_url != blank %}
          href="{{ section.settings.cta_url }}"
        {% else %}
          href="#cst_main_product"
          data-id="scrollBtn"
        {% endif %}
      >{{ section.settings.cta_label }}</a>
      {% if section.settings.guarantee_text != blank %}
        <span class="ts-guarantee">
            {% if section.settings.try_img != blank %}
            <img  class="try-img" src="{{ section.settings.try_img | image_url: width: 24 }}" alt="next">
            {% else %}
                <svg viewBox="0 0 24 24"><polyline points="1 4 1 10 7 10"/><path d="M3.51 15a9 9 0 1 0 .49-3"/></svg>
            {% endif %}
          {{ section.settings.guarantee_text }}
        </span>
      {% endif %}
    </div>
  {% endif %}

</section>

<script id="ts-swiper-lib" src="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.js" defer></script>

<script>
(function(){
  var sid = '{{ sid }}';

  function initSwiper() {
    var autoplayConfig = false;
    {% if section.settings.autoplay %}
    autoplayConfig = {
      delay: {{ section.settings.autoplay_delay }},
      disableOnInteraction: false,
      pauseOnMouseEnter: true
    };
    {% endif %}

    var swiper = new Swiper('.ts-swiper-' + sid, {
  slidesPerView: {{ section.settings.slides_mobile }},  // 550px se niche
  spaceBetween:  {{ section.settings.space_between }},
  centeredSlides: true,
  loop: true,
  speed: {{ section.settings.slide_speed }},
  autoplay: autoplayConfig,
  grabCursor: true,

  {% if section.settings.show_dots %}
  pagination: {
    el: '.ts-swiper-' + sid + ' .swiper-pagination',
    clickable: true
  },
  {% endif %}

  breakpoints: {
    550: {
      slidesPerView: {{ section.settings.slides_tablet }}, 
      spaceBetween: {{ section.settings.space_between }}
    },
    1100: {
      slidesPerView: {{ section.settings.slides_desktop }},  
      spaceBetween: {{ section.settings.space_between }}
    }
  }
});

    /* Next arrow click */
    var wrap = document.getElementById('ts-wrap-' + sid);
    if (wrap) {
      var nextBtn = wrap.querySelector('.ts-arrow-next');
      var prevBtn = wrap.querySelector('.ts-arrow-prev');
      if (nextBtn) nextBtn.addEventListener('click', function(e) {
        e.stopPropagation();
        swiper.slideNext();
      });
      if (prevBtn) prevBtn.addEventListener('click', function(e) {
        e.stopPropagation();
        swiper.slidePrev();
      });
    }
  }

  function startSwiper() {
    if (window.Swiper) {
      initSwiper();
      return;
    }
    var lib = document.getElementById('ts-swiper-lib');
    if (lib) lib.addEventListener('load', initSwiper, { once: true });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', startSwiper);
  } else {
    startSwiper();
  }
})();
</script> 
