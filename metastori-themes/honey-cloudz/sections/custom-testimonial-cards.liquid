{%- style -%}
  #shopify-section-{{ section.id }} .custom-testimonial-cards {
    --testimonial-cards-background: {{ section.settings.background_color }};
    --testimonial-cards-content-max-width: {{ section.settings.content_max_width }}px;
    --testimonial-cards-columns: 1;
    --testimonial-cards-column-gap: {{ section.settings.column_gap }}px;
    --testimonial-cards-card-background: {{ section.settings.card_background }};
    --testimonial-cards-border-width: {{ section.settings.card_border_width }}px;
    --testimonial-cards-border-color: {{ section.settings.card_border_color }};
    --testimonial-cards-border-radius: {{ section.settings.card_border_radius }}px;
    --testimonial-cards-card-padding: {{ section.settings.card_padding }}px;
    --testimonial-cards-image-height: {{ section.settings.image_height_mobile }}px;
    --testimonial-cards-image-radius: {{ section.settings.image_border_radius }}px;
    --testimonial-cards-heading-color: {{ section.settings.heading_color }};
    --testimonial-cards-quote-color: {{ section.settings.quote_color }};
    --testimonial-cards-quote-style: {{ section.settings.quote_font_style }};
    --testimonial-cards-quote-size: {{ section.settings.quote_font_size }}px;
    --testimonial-cards-divider-color: {{ section.settings.divider_color }};
    --testimonial-cards-author-color: {{ section.settings.author_color }};
    --testimonial-cards-author-align: {{ section.settings.author_alignment }};
    --testimonial-cards-padding-top: {{ section.settings.padding_top_mobile }}px;
    --testimonial-cards-padding-bottom: {{ section.settings.padding_bottom_mobile }}px;
  }

  @media screen and (min-width: 750px) {
    #shopify-section-{{ section.id }} .custom-testimonial-cards {
      --testimonial-cards-columns: {{ section.settings.columns_desktop }};
      --testimonial-cards-image-height: {{ section.settings.image_height_desktop }}px;
      --testimonial-cards-padding-top: {{ section.settings.padding_top_desktop }}px;
      --testimonial-cards-padding-bottom: {{ section.settings.padding_bottom_desktop }}px;
    }
  }
{%- endstyle -%}

{{ 'section-custom-testimonial-cards.css' | asset_url | stylesheet_tag }}

<div class="custom-testimonial-cards custom-testimonial-cards--image-{{ section.settings.image_fit }}">
  <div class="page-width">
    <div class="custom-testimonial-cards__inner">
      {%- if section.settings.heading != blank -%}
        <h2 class="custom-testimonial-cards__heading">{{ section.settings.heading | escape }}</h2>
      {%- endif -%}

      <div class="custom-testimonial-cards__grid">
        {%- for block in section.blocks -%}
          {%- liquid
            assign testimonial_image = block.settings.image
            assign image_alt = block.settings.image_alt | default: testimonial_image.alt | default: block.settings.author
            assign has_quote = false
            if block.settings.quote != blank
              assign has_quote = true
            endif
            assign has_author = false
            if block.settings.author != blank
              assign has_author = true
            endif
          -%}
          <figure class="custom-testimonial-cards__card" {{ block.shopify_attributes }}>
            {%- if testimonial_image != blank -%}
              <div class="custom-testimonial-cards__media">
                {{
                  testimonial_image
                  | image_url: width: 1200
                  | image_tag:
                    loading: 'lazy',
                    widths: '400, 600, 800, 1000, 1200',
                    sizes: '(min-width: 750px) 50vw, 100vw',
                    alt: image_alt,
                    class: 'custom-testimonial-cards__image'
                }}
              </div>
            {%- elsif request.design_mode -%}
              <div class="custom-testimonial-cards__media">
                {{ 'image' | placeholder_svg_tag: 'custom-testimonial-cards__placeholder' }}
              </div>
            {%- endif -%}

            {%- if has_quote -%}
              <blockquote class="custom-testimonial-cards__quote">{{ block.settings.quote }}</blockquote>
            {%- endif -%}

            {%- if section.settings.show_divider and has_quote and has_author -%}
              <span class="custom-testimonial-cards__divider" aria-hidden="true"></span>
            {%- endif -%}

            {%- if has_author -%}
              <figcaption class="custom-testimonial-cards__author">—{{ block.settings.author | escape }}</figcaption>
            {%- endif -%}
          </figure>
        {%- endfor -%}
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Custom testimonial cards",
  "tag": "section",
  "class": "section",
  "max_blocks": 6,
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading color",
      "default": "#212326"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "label": "Columns (desktop)",
      "min": 1,
      "max": 3,
      "step": 1,
      "default": 2
    },
    {
      "type": "range",
      "id": "column_gap",
      "label": "Space between cards",
      "min": 0,
      "max": 60,
      "step": 2,
      "unit": "px",
      "default": 20
    },
    {
      "type": "range",
      "id": "content_max_width",
      "label": "Content max width",
      "min": 600,
      "max": 1400,
      "step": 20,
      "unit": "px",
      "default": 1400
    },
    {
      "type": "header",
      "content": "Cards"
    },
    {
      "type": "color",
      "id": "card_background",
      "label": "Card background",
      "default": "#ffffff"
    },
    {
      "type": "range",
      "id": "card_border_width",
      "label": "Card border width",
      "min": 0,
      "max": 4,
      "step": 1,
      "unit": "px",
      "default": 1
    },
    {
      "type": "color",
      "id": "card_border_color",
      "label": "Card border color",
      "default": "#212326"
    },
    {
      "type": "range",
      "id": "card_border_radius",
      "label": "Card corner radius",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 16
    },
    {
      "type": "range",
      "id": "card_padding",
      "label": "Card padding",
      "min": 0,
      "max": 48,
      "step": 2,
      "unit": "px",
      "default": 20
    },
    {
      "type": "checkbox",
      "id": "show_divider",
      "label": "Show divider above author",
      "default": true
    },
    {
      "type": "color",
      "id": "divider_color",
      "label": "Divider color",
      "default": "#e6e6e6"
    },
    {
      "type": "header",
      "content": "Image"
    },
    {
      "type": "range",
      "id": "image_height_desktop",
      "label": "Image height (desktop)",
      "min": 160,
      "max": 600,
      "step": 10,
      "unit": "px",
      "default": 320
    },
    {
      "type": "range",
      "id": "image_height_mobile",
      "label": "Image height (mobile)",
      "min": 140,
      "max": 480,
      "step": 10,
      "unit": "px",
      "default": 260
    },
    {
      "type": "select",
      "id": "image_fit",
      "label": "Image fit",
      "options": [
        { "value": "contain", "label": "Show whole image" },
        { "value": "cover", "label": "Fill area (crop)" }
      ],
      "default": "contain"
    },
    {
      "type": "range",
      "id": "image_border_radius",
      "label": "Image corner radius",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 12
    },
    {
      "type": "header",
      "content": "Text"
    },
    {
      "type": "color",
      "id": "quote_color",
      "label": "Quote color",
      "default": "#212326"
    },
    {
      "type": "select",
      "id": "quote_font_style",
      "label": "Quote style",
      "options": [
        { "value": "italic", "label": "Italic" },
        { "value": "normal", "label": "Normal" }
      ],
      "default": "italic"
    },
    {
      "type": "range",
      "id": "quote_font_size",
      "label": "Quote size",
      "min": 12,
      "max": 24,
      "step": 1,
      "unit": "px",
      "default": 16
    },
    {
      "type": "color",
      "id": "author_color",
      "label": "Author color",
      "default": "#c6448c"
    },
    {
      "type": "select",
      "id": "author_alignment",
      "label": "Author alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ],
      "default": "right"
    },
    {
      "type": "header",
      "content": "Section"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background",
      "default": "#fdf7f4"
    },
    {
      "type": "range",
      "id": "padding_top_desktop",
      "label": "Padding top (desktop)",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 56
    },
    {
      "type": "range",
      "id": "padding_bottom_desktop",
      "label": "Padding bottom (desktop)",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 56
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "label": "Padding top (mobile)",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "label": "Padding bottom (mobile)",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 40
    }
  ],
  "blocks": [
    {
      "type": "testimonial",
      "name": "Testimonial",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "image_alt",
          "label": "Image alt text"
        },
        {
          "type": "richtext",
          "id": "quote",
          "label": "Quote",
          "default": "<p>“Share what this organization said about Honey Cloudz.”</p>"
        },
        {
          "type": "text",
          "id": "author",
          "label": "Author / organization",
          "default": "Organization name"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Custom testimonial cards",
      "blocks": [
        { "type": "testimonial" },
        { "type": "testimonial" }
      ]
    }
  ]
}
{% endschema %}
