{% schema %}
{
  "name": "Image with Text Section",
  "settings": [
    {
      "type": "image_picker",
      "id": "section_image",
      "label": "Upload Image"
    },
    {
      "type": "text",
      "id": "section_caption",
      "label": "Caption Heading"
    },
    {
      "type": "text",
      "id": "section_style_heading",
      "label": "Style Heading",
      "info": "\\n : for new line"
    },
    {
      "type": "text",
      "id": "section_heading",
      "label": "Heading"
    },
    {
      "type": "richtext",
      "id": "section_text",
      "label": "Content",
      "default": "<p>When it comes to achieving that perfect bikini fit, our <strong>Triangle Inserts</strong> are a must-have. These <strong>triangle inserts</strong> are designed to complement tapered or pointed bikini tops, ensuring a seamless look with no curved lines.</p><p>Whether you’re looking for nipple coverage, a subtle lift, or more enhanced shaping, we’ve got three variations for use as bikini inserts.</p>"
    },
    {
      "type": "liquid",
      "id": "custom_html",
      "label": "Custom HTML"
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button Text",
      "default": "Shop Now"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button Link"
    },
    {
      "type": "select",
      "id": "image_position",
      "label": "Image Position (Desktop)",
      "default": "left",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "right", "label": "Right" }
      ]
    },
    {
      "type": "range",
      "id": "section_padding_top",
      "label": "Padding Top",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "section_padding_bottom",
      "label": "Padding Bottom",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "section_mob_padding_top",
      "label": "Mobile Padding Top",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "section_mob_padding_bottom",
      "label": "Mobile Padding Bottom",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "default": 40
    },
    {
      "type": "text",
      "id": "custom_class",
      "label": "Custom CSS Class",
      "default": "custom-class"
    }
  ],
  "presets": [
    {
      "name": "Image with Text Section",
      "category": "Custom"
    }
  ]
}
{% endschema %}

<section class="image-text-section {{ section.settings.image_position }} {{ section.settings.custom_class }}" style="padding-top: {{ section.settings.section_padding_top }}px; padding-bottom: {{ section.settings.section_padding_bottom }}px;">
  <div class="page-width image-text-wrapper1">
    
    {% if section.settings.section_image %}
      <div class="image-col">
        <img src="{{ section.settings.section_image | img_url: '500x' }}" alt="{{ section.settings.section_heading | escape }}">
        {% if section.settings.image_position == 'right' %}
        {% if section.settings.button_text != blank and section.settings.button_link != blank %}
          <a href="{{ section.settings.button_link }}" class="image-text-btn mobile-only">
            {{ section.settings.button_text }}
          </a>
          {% endif %}
        {% endif %}
      </div>
      
    {% endif %}
    
    <div class="text-col">
      {% if section.settings.section_caption != blank %}
        <p class="header-caption">{{ section.settings.section_caption }}</p>
      {% endif %}
      {% if section.settings.section_heading != blank %}
        <h2 class="image-text-heading">
          {% if section.settings.section_style_heading != blank %}
            <span class="style-font-title {% if section.settings.section_style_heading contains '\n' %}smaller-heading{% endif %}"
                  style="{% if section.settings.section_style_heading contains '\n' %}display:block;{% endif %}">
              {{ section.settings.section_style_heading | remove: "\n" }}
            </span>
            {% endif %}
          {{ section.settings.section_heading }}</h2>
      {% endif %}
      {% if section.settings.section_text != blank %}
        <div class="image-text-content rte">
          {{ section.settings.section_text }}
          {% if section.settings.custom_html != blank %}
            {{ section.settings.custom_html }}
          {% endif %}
        </div>
      {% endif %}
      {% if section.settings.button_text != blank and section.settings.button_link != blank %}
        <a href="{{ section.settings.button_link }}" class="image-text-btn  {% if section.settings.image_position == 'right' %}desktop-only{% endif %}">
          {{ section.settings.button_text }}
        </a>
      {% endif %}
    </div>
  </div>
</section>

<style>
  .mobile-only { display: none; }
  .desktop-only { display: inline-block; }
.image-text-section {
  max-width: 1325px;
  margin: 0 auto;

}

.image-text-wrapper1 {
  display: flex;
  align-items: center;
  gap: 100px;
  padding:0;
}

.image-col, .text-col {
  width: 50%;
  flex: 0 0 50%;
  
}
.image-col{max-width:50%;}

.image-text-section.left .image-col {
  order: 1;
}
.image-text-section.left .text-col {
  order: 2;
}
.image-text-section.right .image-col {
  order: 2;
}
.image-text-section.right .text-col {
  order: 1; text-align:left;
}
ul.custom-icon-text {
  padding:0px;
  list-style: none;
  transform: translateX(-15px);
}
ul.custom-icon-text li {
    padding-left: 30px;
    margin-bottom: 10px;
    background: url(https://cdn.shopify.com/s/files/1/1711/0419/files/check-circle-fill.png?v=1759479292) no-repeat left center;
    background-size: 20px;
}
.image-col img {
  width: 100%;
  height: auto;
  border-radius: 6px;
}

.smaller-heading{
  font-size: 44px;
}

.image-text-heading {
  font-size: 37px;
  font-weight: 300;
  margin-bottom: 15px;
      margin-top: 15px;
}
.image-text-heading span {
  font-family: "Send Flowers", cursive;
  font-weight: 400;
  font-style: normal;
  font-size:48px;
  margin-right:10px;
  text-transform: capitalize;
}
  
h2.image-text-heading {
    font-family: 'Satoshi';
    text-transform: none;
    letter-spacing:normal;
}
p.header-caption {
    text-transform: uppercase;
    font-weight: bold;
    
}
.image-text-content {
    font-size: 16px;
    word-break: break-word;
    font-weight: 400;
    font-family: 'Satoshi';
    line-height: 1.6;
    color: #333333;
    margin-bottom: 20px;
    letter-spacing:normal;
    max-width: 470px;
}

/* Button styling */
.image-text-btn {
  display: inline-block;
  background: #000;
  color: #fff;
  padding: 12px 0px;
  border-radius: 32px !important;
  text-decoration: none;
  font-weight: 600;
  transition: all 0.3s ease;
  max-width:424px;
  width:100%;
  text-align:center;
  letter-spacing:normal;
}
.image-text-btn:hover {
  background: #333;
}
.mobile-only{ display:none; }

span.smaller-heading{
  font-size: 44px;
}

@media (max-width: 1350px) {
.image-text-wrapper1 {
    gap: 20px; padding:0 30px;
  }
}
@media (max-width: 992px) {
  span.smaller-heading{
    font-size: 26px;
  }
  .image-text-wrapper1 {
    gap: 20px; padding:0 30px;
  }

  .image-text-heading {
    font-size: 22px;
    line-height: 30px;
  }

  .image-text-content {
    font-size: 15px;
    line-height: 1.5;
  }

  .image-text-btn {
    padding: 10px 20px;
    font-size: 15px;
  }
}
@media (max-width: 768px) {
  .image-text-section{
    padding-top: {{ section.settings.section_mob_padding_top }}px !important;
    padding-bottom: {{ section.settings.section_mob_padding_bottom }}px !important;
  }
  h2.image-text-heading {
    font-family: 'Satoshi';
    display: flex;
    flex-direction: column;
    gap: 10px;
}
.image-text-heading span {
    font-style: normal;
    font-size: 32px;
    margin-right: 0;
}
.image-text-heading{ font-size:18px; }
.mobile-only { display: inline-block; margin-top: 15px; }
    .desktop-only { display: none; }
}

/* Mobiles */
@media (max-width: 576px) {
  .image-text-wrapper1 {
    flex-direction: column;
    text-align: left;
    padding: 0 20px;
  }
  .image-col {
    max-width: 100%;
}

  .image-col, .text-col {
    width: 100%;
    flex: 0 0 100%;
  }

  .image-text-heading {
    font-size: 22px;
    line-height: 26px;
  }

  .image-text-content {
    font-size: 14px;
    line-height: 1.4;
  }

  .image-text-btn {
    width: 100%; /* full-width button on mobile */
    text-align: center;
    padding: 12px;
    font-size: 14px;
  }
}
</style>
