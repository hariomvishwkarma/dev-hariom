{%- style -%}
  #shopify-section-{{ section.id }} {
    --gradient-background: {% if section.settings.gradient_background != blank %}{{ section.settings.gradient_background }}{% else %}{{ section.settings.colors_background }}{% endif %};
    --color-background: {{ section.settings.colors_background.red }}, {{ section.settings.colors_background.green }}, {{ section.settings.colors_background.blue }};
    --color-foreground: {{ section.settings.colors_text.red }}, {{ section.settings.colors_text.green }}, {{ section.settings.colors_text.blue }};
    --color-link: {{ section.settings.colors_link.red }}, {{ section.settings.colors_link.green }}, {{ section.settings.colors_link.blue }};
    --color-border: {{ section.settings.colors_border.red }}, {{ section.settings.colors_border.green }}, {{ section.settings.colors_border.blue }};
    --color-heading: {{ section.settings.colors_heading.red }}, {{ section.settings.colors_heading.green }}, {{ section.settings.colors_heading.blue }};
  }
{%- endstyle -%}

{{ 'section-footer.css' | asset_url | stylesheet_tag }}

<link rel="stylesheet" href="{{ 'component-newsletter.css' | asset_url }}" media="print" onload="this.media='all'">
<link rel="stylesheet" href="{{ 'component-accordion.css' | asset_url }}" media="print" onload="this.media='all'">
<link rel="stylesheet" href="{{ 'component-list-payment.css' | asset_url }}" media="print" onload="this.media='all'">
<link rel="stylesheet" href="{{ 'component-list-social.css' | asset_url }}" media="print" onload="this.media='all'">
<link rel="stylesheet" href="{{ 'component-rte.css' | asset_url }}" media="print" onload="this.media='all'">
<link rel="stylesheet" href="{{ 'disclosure.css' | asset_url }}" media="print" onload="this.media='all'">

<noscript>{{ 'component-newsletter.css' | asset_url | stylesheet_tag }}</noscript>
<noscript>{{ 'component-accordion.css' | asset_url | stylesheet_tag }}</noscript>
<noscript>{{ 'component-list-payment.css' | asset_url | stylesheet_tag }}</noscript>
<noscript>{{ 'component-list-social.css' | asset_url | stylesheet_tag }}</noscript>
<noscript>{{ 'component-rte.css' | asset_url | stylesheet_tag }}</noscript>
<noscript>{{ 'disclosure.css' | asset_url | stylesheet_tag }}</noscript>

<script src="{{ 'footer-accordion.js' | asset_url }}" defer="defer"></script>

{%- liquid
  assign footer_layout = section.settings.footer_layout | default: 'classic'
  assign mobile_layout = section.settings.mobile_layout | default: 'accordion'
  assign enable_right_column = false
  if section.settings.newsletter_enable or section.settings.show_social
    assign enable_right_column = true
  endif

  assign brand_logo = section.settings.brand_logo
  assign brand_logo_width = section.settings.brand_logo_width | default: 140
  if brand_logo == blank
    for block in section.blocks
      if block.type == 'social' and block.settings.image != blank
        assign brand_logo = block.settings.image
        break
      endif
    endfor
  endif
-%}

<div class="footer-shape-image{% if footer_layout == 'compact' %} footer-shape-image--compact{% endif %}">
  {{ 'Seperator-footer.svg' | inline_asset_content }}
</div>

<footer
  class="footer footer--{{ footer_layout }}{% if section.settings.show_divider %} footer--border-top{% endif %}"
  {% if footer_layout == 'compact' %}data-mobile-layout="{{ mobile_layout }}"{% endif %}
>
  {%- if footer_layout == 'compact' -%}
    <div class="footer__content-top page-width">
      <div class="footer-compact">
        <div class="footer-compact__brand">
          {%- if brand_logo != blank -%}
            {%- liquid
              assign brand_logo_width_2x = brand_logo_width | times: 2
              assign brand_logo_height = 0
              if brand_logo.aspect_ratio != blank and brand_logo.aspect_ratio > 0
                assign brand_logo_height = brand_logo_width | divided_by: brand_logo.aspect_ratio | round
              endif
            -%}
            <div class="footer-compact__logo">
              <a href="{{ routes.root_url }}" aria-label="{{ shop.name | escape }}">
                <img
                  src="{{ brand_logo | image_url: width: brand_logo_width }}"
                  srcset="{{ brand_logo | image_url: width: brand_logo_width }}, {{ brand_logo | image_url: width: brand_logo_width_2x }} 2x"
                  alt="{{ brand_logo.alt | default: shop.name | escape }}"
                  width="{{ brand_logo_width }}"
                  {% if brand_logo_height > 0 %}height="{{ brand_logo_height }}"{% endif %}
                  loading="lazy"
                  style="max-width: min(100%, {{ brand_logo_width }}px);"
                >
              </a>
            </div>
          {%- endif -%}

          {%- if section.settings.newsletter_heading != blank -%}
            <h2 class="footer-compact__tagline">{{ section.settings.newsletter_heading | escape }}</h2>
          {%- endif -%}

          {%- if section.settings.newsletter_text != blank -%}
            <div class="footer-compact__description rte">
              {{ section.settings.newsletter_text }}
            </div>
          {%- endif -%}

          {%- if section.settings.newsletter_enable -%}
            <div class="footer-compact__newsletter">
              {%- if section.settings.klaviyo_embed != blank -%}
                <div class="footer-compact__klaviyo">
                  {{ section.settings.klaviyo_embed }}
                </div>
              {%- else -%}
                {%- form 'customer', id: 'ContactFooter', class: 'footer__newsletter newsletter-form newsletter-form--underline' -%}
                  <input type="hidden" name="contact[tags]" value="newsletter"/>
                  <div class="field field--underline">
                    <input
                      id="ContactFooter-email"
                      type="email"
                      name="contact[email]"
                      class="field__input required{% if form.errors %} invalid{% endif %}"
                      value="{{ form.email }}"
                      aria-required="true"
                      autocorrect="off"
                      autocapitalize="off"
                      autocomplete="email"
                      {% if form.errors %}
                        autofocus
                        aria-invalid="true"
                        aria-describedby="ContactFooter-error"
                      {% elsif form.posted_successfully? %}
                        aria-describedby="ContactFooter-success"
                      {% endif %}
                      placeholder="{{ 'newsletter.label' | t }}"
                      required
                    >
                    <label class="visually-hidden" for="ContactFooter-email">{{ 'newsletter.label' | t }}</label>
                    <button type="submit" class="field__button field__button--arrow" name="commit" aria-label="{{ 'newsletter.button_label' | t }}">
                      {% render 'icon', icon: 'arrow' %}
                    </button>
                  </div>
                  {%- if form.errors -%}
                    <small class="form__message errors" id="ContactFooter-error">
                      {% render 'icon', icon: 'error' %}
                      {{ form.errors.translated_fields['email'] | capitalize }} {{ form.errors.messages['email'] }}
                    </small>
                  {%- endif -%}
                  {%- if form.posted_successfully? -%}
                    <p class="form__message h3" id="ContactFooter-success" tabindex="-1" autofocus>
                      {% render 'icon', icon: 'success' %}
                      {{ 'newsletter.success' | t }}
                    </p>
                  {%- endif -%}
                {%- endform -%}
              {%- endif -%}
            </div>
          {%- endif -%}

          {%- if section.settings.show_social -%}
            <ul class="footer__list-social footer-compact__social list-unstyled list-social" role="list">
              {% render 'social-icons' %}
              <li class="list-social__item--placeholder">{{ 'sections.footer.social_placeholder' | t }}</li>
            </ul>
          {%- endif -%}
        </div>

        <div class="footer-compact__menus">
          {%- for block in section.blocks -%}
            {%- comment -%} Wholesale_Club_Product_Visibility_For_Loop Start {%- endcomment -%}
            {%- capture hide_resource -%}{% render "wc_product_visibility", resource: block %}{%- endcapture -%}
            {%- if hide_resource == "true" -%}
              {% continue %}
            {%- endif -%}
            {%- comment -%} Wholesale_Club_Product_Visibility_For_Loop End {%- endcomment -%}

            {%- if block.type == 'link_list' and block.settings.menu != blank -%}
              {%- if section.settings.bottom_menu != blank and block.settings.menu.handle == section.settings.bottom_menu.handle -%}
                {% continue %}
              {%- endif -%}
              <footer-accordion
                class="accordion footer-block footer-block--menu"
                {% if block.settings.open_on_mobile %}data-open-on-mobile="true"{% endif %}
                {{ block.shopify_attributes }}
              >
                <details open>
                  <summary>
                    <p class="h4 accordion__title">{{ block.settings.heading | escape }}</p>
                    {% render 'icon', icon: 'caret' %}
                  </summary>
                  <ul class="footer-block__details-content list-unstyled">
                    {%- for link in block.settings.menu.links -%}
                      {%- comment -%} Wholesale_Club_Product_Visibility_For_Loop Start {%- endcomment -%}
                      {%- capture hide_resource -%}{% render "wc_product_visibility", resource: link %}{%- endcapture -%}
                      {%- if hide_resource == "true" -%}
                        {% continue %}
                      {%- endif -%}
                      {%- comment -%} Wholesale_Club_Product_Visibility_For_Loop End {%- endcomment -%}
                      <li>
                        <a href="{{ link.url }}" class="link list-menu__item list-menu__item--link{% if link.active %} list-menu__item--active{% endif %}">
                          {{ link.title }}
                        </a>
                      </li>
                    {%- endfor -%}
                  </ul>
                </details>
              </footer-accordion>
            {%- elsif block.type == 'text' -%}
              <footer-accordion class="accordion footer-block" {{ block.shopify_attributes }}>
                <details open>
                  <summary>
                    <p class="h4 accordion__title">{{ block.settings.heading | escape }}</p>
                    {% render 'icon', icon: 'caret' %}
                  </summary>
                  <div class="footer-block__details-content rte">
                    {{ block.settings.subtext }}
                  </div>
                </details>
              </footer-accordion>
            {%- endif -%}
          {%- endfor -%}
        </div>

        {%- if section.settings.need_help_enable -%}
          <div class="footer-compact__help">
            {%- if section.settings.need_help_heading != blank -%}
              <h2 class="footer-need-help__heading footer-compact__help-heading">{{ section.settings.need_help_heading | escape }}</h2>
            {%- endif -%}

            <ul class="footer-need-help__links footer-compact__help-links list-unstyled" role="list">
              {%- if section.settings.need_help_phone != blank -%}
                {%- liquid
                  assign phone_digits = section.settings.need_help_phone | replace: ' ', '' | replace: '-', '' | replace: '(', '' | replace: ')', '' | replace: '.', '' | replace: '*', ''
                  assign phone_tel = phone_digits
                  unless phone_digits contains '+'
                    if phone_digits.size == 10
                      assign phone_tel = '+1' | append: phone_digits
                    elsif phone_digits.size == 11
                      assign phone_tel = '+' | append: phone_digits
                    else
                      assign phone_tel = '+' | append: phone_digits
                    endif
                  endunless
                  assign phone_label = section.settings.need_help_phone_display
                  if phone_label == blank
                    assign phone_label = section.settings.need_help_phone | remove: '*'
                  endif
                -%}
                <li class="footer-need-help__item">
                  <a class="footer-need-help__link" href="tel:{{ phone_tel | escape }}">
                    <span class="footer-need-help__icon" aria-hidden="true">
                      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" focusable="false">
                        <path d="M6.62 10.79a15.15 15.15 0 006.59 6.59l2.2-2.2a1 1 0 011.01-.24c1.12.37 2.33.57 3.58.57a1 1 0 011 1V20a1 1 0 01-1 1C10.85 21 3 13.15 3 3.5a1 1 0 011-1H7.5a1 1 0 011 1c0 1.25.2 2.46.57 3.58a1 1 0 01-.25 1.02l-2.2 2.19z" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"/>
                      </svg>
                    </span>
                    <span>{{ phone_label | escape }}</span>
                  </a>
                </li>
              {%- endif -%}

              {%- if section.settings.need_help_email != blank -%}
                <li class="footer-need-help__item">
                  <a class="footer-need-help__link" href="mailto:{{ section.settings.need_help_email | escape }}">
                    <span class="footer-need-help__icon" aria-hidden="true">
                      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" focusable="false">
                        <path d="M4 6.5h16a1.5 1.5 0 011.5 1.5v10A1.5 1.5 0 0120 19.5H4A1.5 1.5 0 012.5 18V8A1.5 1.5 0 014 6.5z" stroke="currentColor" stroke-width="1.75" stroke-linejoin="round"/>
                        <path d="M3.5 8l8.5 6.25L20.5 8" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"/>
                      </svg>
                    </span>
                    <span>{{ section.settings.need_help_email | escape }}</span>
                  </a>
                </li>
              {%- endif -%}

              {%- if section.settings.need_help_show_live_chat -%}
                <li class="footer-need-help__item">
                  <button type="button" class="footer-need-help__link footer-need-help__link--chat" data-footer-open-chat>
                    <span class="footer-need-help__icon" aria-hidden="true">
                      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" focusable="false">
                        <path d="M5 5.75h14A2.25 2.25 0 0121.25 8v7.5A2.25 2.25 0 0119 17.75h-5.2L8.5 21.25v-3.5H5A2.25 2.25 0 012.75 15.5V8A2.25 2.25 0 015 5.75z" stroke="currentColor" stroke-width="1.75" stroke-linejoin="round"/>
                        <path d="M8 10.5h8M8 13.5h5" stroke="currentColor" stroke-width="1.75" stroke-linecap="round"/>
                      </svg>
                    </span>
                    <span>{{ section.settings.need_help_live_chat_label | escape }}</span>
                  </button>
                </li>
              {%- endif -%}
            </ul>

            {%- if section.settings.need_help_hours != blank -%}
              <p class="footer-need-help__hours">{{ section.settings.need_help_hours | escape }}</p>
            {%- endif -%}

            {%- if section.settings.need_help_location != blank or section.settings.need_help_sms_disclaimer != blank -%}
              <div class="footer-compact__location rte">
                {{ section.settings.need_help_location }}
                {{ section.settings.need_help_sms_disclaimer }}
              </div>
            {%- endif -%}
          </div>
        {%- endif -%}
      </div>
    </div>

  {%- else -%}
    {%- if section.settings.need_help_enable -%}
      <div class="footer-need-help">
        <div class="page-width">
          <div class="footer-need-help__inner">
            {%- if section.settings.need_help_heading != blank -%}
              <h2 class="footer-need-help__heading">{{ section.settings.need_help_heading | escape }}</h2>
            {%- endif -%}

            <ul class="footer-need-help__links list-unstyled" role="list">
              {%- if section.settings.need_help_phone != blank -%}
                {%- liquid
                  assign phone_digits = section.settings.need_help_phone | replace: ' ', '' | replace: '-', '' | replace: '(', '' | replace: ')', '' | replace: '.', '' | replace: '*', ''
                  assign phone_tel = phone_digits
                  unless phone_digits contains '+'
                    if phone_digits.size == 10
                      assign phone_tel = '+1' | append: phone_digits
                    elsif phone_digits.size == 11
                      assign phone_tel = '+' | append: phone_digits
                    else
                      assign phone_tel = '+' | append: phone_digits
                    endif
                  endunless
                  assign phone_label = section.settings.need_help_phone_display
                  if phone_label == blank
                    assign phone_label = section.settings.need_help_phone | remove: '*'
                  endif
                -%}
                <li class="footer-need-help__item">
                  <a class="footer-need-help__link" href="tel:{{ phone_tel | escape }}">
                    <span class="footer-need-help__icon" aria-hidden="true">
                      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" focusable="false">
                        <path d="M6.62 10.79a15.15 15.15 0 006.59 6.59l2.2-2.2a1 1 0 011.01-.24c1.12.37 2.33.57 3.58.57a1 1 0 011 1V20a1 1 0 01-1 1C10.85 21 3 13.15 3 3.5a1 1 0 011-1H7.5a1 1 0 011 1c0 1.25.2 2.46.57 3.58a1 1 0 01-.25 1.02l-2.2 2.19z" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"/>
                      </svg>
                    </span>
                    <span>{{ phone_label | escape }}</span>
                  </a>
                </li>
              {%- endif -%}

              {%- if section.settings.need_help_email != blank -%}
                <li class="footer-need-help__item">
                  <a class="footer-need-help__link" href="mailto:{{ section.settings.need_help_email | escape }}">
                    <span class="footer-need-help__icon" aria-hidden="true">
                      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" focusable="false">
                        <path d="M4 6.5h16a1.5 1.5 0 011.5 1.5v10A1.5 1.5 0 0120 19.5H4A1.5 1.5 0 012.5 18V8A1.5 1.5 0 014 6.5z" stroke="currentColor" stroke-width="1.75" stroke-linejoin="round"/>
                        <path d="M3.5 8l8.5 6.25L20.5 8" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"/>
                      </svg>
                    </span>
                    <span>{{ section.settings.need_help_email | escape }}</span>
                  </a>
                </li>
              {%- endif -%}

              {%- if section.settings.need_help_show_live_chat -%}
                <li class="footer-need-help__item">
                  <button type="button" class="footer-need-help__link footer-need-help__link--chat" data-footer-open-chat>
                    <span class="footer-need-help__icon" aria-hidden="true">
                      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" focusable="false">
                        <path d="M5 5.75h14A2.25 2.25 0 0121.25 8v7.5A2.25 2.25 0 0119 17.75h-5.2L8.5 21.25v-3.5H5A2.25 2.25 0 012.75 15.5V8A2.25 2.25 0 015 5.75z" stroke="currentColor" stroke-width="1.75" stroke-linejoin="round"/>
                        <path d="M8 10.5h8M8 13.5h5" stroke="currentColor" stroke-width="1.75" stroke-linecap="round"/>
                      </svg>
                    </span>
                    <span>{{ section.settings.need_help_live_chat_label | escape }}</span>
                  </button>
                </li>
              {%- endif -%}
            </ul>

            {%- if section.settings.need_help_hours != blank -%}
              <p class="footer-need-help__hours">{{ section.settings.need_help_hours | escape }}</p>
            {%- endif -%}
          </div>
        </div>
      </div>
    {%- endif -%}

    {%- if section.blocks.size > 0 or enable_right_column -%}
      <div class="footer__content-top page-width">
        <div class="grid">
          {%- if section.blocks.size > 0 -%}
            <div class="grid__item footer__content-left{% if section.blocks.size == 4 and enable_right_column %} footer__content-left--alt{% endif %}{% if section.blocks.size == 1 and enable_right_column == false %} footer__content-left--only{% endif %}">
              <div class="footer__blocks-wrapper grid grid--1-col grid--2-col grid--4-col-tablet">
                {%- for block in section.blocks -%}
                  {%- comment -%} Wholesale_Club_Product_Visibility_For_Loop Start {%- endcomment -%}
                  {%- capture hide_resource -%}{% render "wc_product_visibility", resource: block %}{%- endcapture -%}
                  {%- if hide_resource == "true" -%}
                    {% continue %}
                  {%- endif -%}
                  {%- comment -%} Wholesale_Club_Product_Visibility_For_Loop End {%- endcomment -%}

                  <footer-accordion
                    class="accordion footer-block grid__item {% if block.type == 'social' %}footer-block--social{% endif %} {% if block.type == 'link_list' %} footer-block--menu{% endif %}"
                    {% if block.settings.open_on_mobile %}data-open-on-mobile="true"{% endif %}
                    {{ block.shopify_attributes }}
                  >
                    <details open>
                      <summary tabindex="-1">
                        <p class="h4 accordion__title">{{ block.settings.heading | escape }}</p>
                        {% render 'icon', icon: 'caret' %}
                      </summary>
                      {%- case block.type -%}
                        {%- when 'text' -%}
                          <div class="footer-block__details-content rte">
                            {{ block.settings.subtext }}
                          </div>
                        {%- when 'social' -%}
                          <div class="footer-block__details-content">
                              <div class="footer-block__details-social">
                                  {% if block.settings.image != blank %}
                                    <div class="footer-block__details-social-logo">
                                      <img src="{{ block.settings.image | image_url }}" width="" height="" alt="{{ shop.name }}">
                                    </div>
                                  {% endif %}
                                  {%- if section.settings.show_social -%}
                                    <div class="footer-block__details-social-block">
                                      <h3>{{ section.settings.social_heading | escape }}</h3>
                                      <ul class="footer__list-social list-unstyled list-social" role="list">
                                        {% render 'social-icons' %}
                                        <li class="list-social__item--placeholder">{{ 'sections.footer.social_placeholder' | t }}</li>
                                      </ul>
                                    </div>
                                  {% endif %}
                              </div>
                          </div>
                        {%- when 'link_list' -%}
                          {%- if block.settings.menu != blank -%}
                            <ul class="footer-block__details-content list-unstyled">
                              {%- for link in block.settings.menu.links -%}
                                {%- comment -%} Wholesale_Club_Product_Visibility_For_Loop Start {%- endcomment -%}
                                {%- capture hide_resource -%}{% render "wc_product_visibility", resource: link %}{%- endcapture -%}
                                {%- if hide_resource == "true" -%}
                                  {% continue %}
                                {%- endif -%}
                                {%- comment -%} Wholesale_Club_Product_Visibility_For_Loop End {%- endcomment -%}

                                <li>
                                  <a href="{{ link.url }}" class="link list-menu__item list-menu__item--link{% if link.active %} list-menu__item--active{% endif %}">
                                    {{ link.title }}
                                  </a>
                                </li>
                              {%- endfor -%}
                            </ul>
                          {%- endif -%}
                        {%- when 'image' -%}
                          <div class="footer-block__details-content footer-block-image {{ block.settings.alignment }}">
                            {%- if block.settings.link != blank -%}
                              <a href="{{ block.settings.link }}">
                            {%- endif -%}
                              {%- if block.settings.image != blank -%}
                                {%- liquid
                                  assign image_width = block.settings.image_width
                                  assign image_width_2x = block.settings.image_width | times: 2
                                -%}
                                <img
                                  srcset= "{{ block.settings.image | image_url: width: image_width }}, {{ block.settings.image | image_url: width: image_width_2x }} 2x"
                                  src="{{ block.settings.image | image_url: width: image_width }}"
                                  alt="{{ block.settings.image.alt | escape }}"
                                  loading="lazy"
                                  width="{{ block.settings.image.width }}"
                                  height="{{ block.settings.image.height }}"
                                  style="max-width: min(100%, {{ image_width }}px);"
                                />
                              {%- else -%}
                                {{ 'image' | placeholder_svg_tag: 'placeholder' }}
                              {%- endif -%}
                            {%- if block.settings.link != blank -%}
                              </a>
                            {%- endif -%}
                            <p class="caption-large">{{ block.settings.text }}</p>
                          </div>
                      {%- endcase -%}
                    </details>
                  </footer-accordion>
                {%- endfor -%}
              </div>
            </div>
          {%- endif -%}
        </div>
      </div>
    {%- endif -%}

    {%- if section.settings.newsletter_enable -%}
    <div class="footer-newletter-block">
      <div class="page-width">
        <div class="footer-newletter-block-inner">
            <div class="footer-block__details-content">
                {% if section.settings.newsletter_heading != blank %}
                  <div class="footer-block__newsletter-heading">
                      <h2 class="footer-block__newsletter-tagline">{{ section.settings.newsletter_heading | escape }}</h2>
                      {% if section.settings.newsletter_text != blank %}
                        <div class="footer-block__newsletter-description">
                            {{ section.settings.newsletter_text }}
                        </div>
                      {% endif %}
                  </div>
                {% endif %}
                <div class="footer-block__newsletter">
                  {%- form 'customer', id: 'ContactFooterClassic', class: 'footer__newsletter newsletter-form' -%}
                    <input type="hidden" name="contact[tags]" value="newsletter"/>

                    <div class="field">
                      <input
                        id="ContactFooterClassic-email"
                        type="email"
                        name="contact[email]"
                        class="field__input required{% if form.errors %} invalid{% endif %}"
                        value="{{ form.email }}"
                        aria-required="true"
                        autocorrect="off"
                        autocapitalize="off"
                        autocomplete="email"
