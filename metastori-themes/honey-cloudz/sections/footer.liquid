                          autofocus
                          aria-invalid="true"
                          aria-describedby="ContactFooterClassic-error"
                        {% elsif form.posted_successfully? %}
                          aria-describedby="ContactFooterClassic-success"
                        {% endif %}
                        placeholder="{{ 'newsletter.label' | t }}"
                        required
                      />
                      <label class="visually-hidden" for="ContactFooterClassic-email">{{ 'newsletter.label' | t }}</label>
                      <button type="submit" class="button button--arrow field__button animate-arrow" name="commit" aria-label="{{ 'newsletter.button_label' | t }}">
                         Subscribe
                      </button>
                    </div>
                    {%- if form.errors -%}
                      <small class="form__message errors" id="ContactFooterClassic-error">
                        {% render 'icon', icon: 'error' %}
                        {{ form.errors.translated_fields['email'] | capitalize }} {{ form.errors.messages['email'] }}
                      </small>
                    {%- endif -%}

                    {%- if form.posted_successfully? -%}
                      <p class="form__message h3" id="ContactFooterClassic-success" tabindex="-1" autofocus>
                        {% render 'icon', icon: 'success' %}
                        {{ 'newsletter.success' | t }}
                      </p>
                    {%- endif -%}

                  {%- endform -%}
                </div>
              </div>
        </div>
      </div>
    </div>
    {% endif %}
