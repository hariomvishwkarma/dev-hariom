{%- liquid
  assign layout_flip = section.settings.flip_layout
  assign feature_blocks = section.blocks | where: 'type', 'feature'
  assign slide_blocks = section.blocks | where: 'type', 'slide'
  assign content_width = section.settings.content_column_width
  assign slider_width = 100 | minus: content_width

  case section.settings.content_alignment
    when 'center'
      assign content_text_align = 'center'
      assign content_margin = 'margin-inline: auto;'
    when 'right'
      assign content_text_align = 'right'
      assign content_margin = 'margin-left: auto;'
    else
      assign content_text_align = 'left'
      assign content_margin = ''
  endcase
-%}

{%- style -%}
  #shopify-section-{{ section.id }} .cbaf {
    --cbaf-bg: {{ section.settings.background_color }};
    --cbaf-eyebrow-color: {{ section.settings.eyebrow_color }};
    --cbaf-heading-color: {{ section.settings.heading_color }};
    --cbaf-text-color: {{ section.settings.text_color }};
    --cbaf-feature-title-color: {{ section.settings.feature_title_color }};
    --cbaf-feature-text-color: {{ section.settings.feature_text_color }};
    --cbaf-number-bg: {{ section.settings.number_background }};
    --cbaf-number-color: {{ section.settings.number_color }};
    --cbaf-number-size: {{ section.settings.number_size }}px;
    --cbaf-btn-bg: {{ section.settings.button_background }};
    --cbaf-btn-text: {{ section.settings.button_text_color }};
    --cbaf-image-radius: {{ section.settings.image_border_radius }}px;
    --cbaf-image-border: {{ section.settings.image_border_width }}px solid {{ section.settings.image_border_color }};
    --cbaf-before-badge-bg: {{ section.settings.before_badge_background }};
    --cbaf-before-badge-text: {{ section.settings.before_badge_text_color }};
    --cbaf-after-badge-bg: {{ section.settings.after_badge_background }};
    --cbaf-after-badge-text: {{ section.settings.after_badge_text_color }};
    --cbaf-dot-color: {{ section.settings.dot_color }};
    --cbaf-dot-active: {{ section.settings.dot_active_color }};
    --cbaf-content-col: minmax(0, {{ content_width }}fr);
    --cbaf-slider-col: minmax(0, {{ slider_width }}fr);
    --cbaf-column-gap: {{ section.settings.column_gap }}px;
    --cbaf-content-max: {{ section.settings.content_max_width }}px;
    --cbaf-feature-gap: {{ section.settings.feature_gap }}px;
    --cbaf-slide-gap: {{ section.settings.slide_gap }}px;
    --cbaf-pair-gap: {{ section.settings.pair_image_gap }}px;
    --cbaf-slide-width-mobile: {{ section.settings.slide_width_mobile }}%;
    --cbaf-slide-width-desktop: {{ section.settings.slide_width_desktop }}%;
    --cbaf-mobile-padding-x: {{ section.settings.mobile_padding_x }}px;
    background-color: var(--cbaf-bg);
    padding: {{ section.settings.padding_top }}px 0 {{ section.settings.padding_bottom }}px;
    overflow-x: clip;
  }

  {% unless section.settings.use_theme_page_width %}
  #shopify-section-{{ section.id }} .cbaf__page-width {
    max-width: {{ section.settings.section_max_width }}px;
    margin: 0 auto;
    padding-inline: 1.5rem;
    width: 100%;
    box-sizing: border-box;
  }
  {% endunless %}

  #shopify-section-{{ section.id }} .cbaf__grid {
    display: grid;
    grid-template-columns: var(--cbaf-content-col) var(--cbaf-slider-col);
    gap: var(--cbaf-column-gap);
    align-items: {{ section.settings.vertical_alignment }};
    width: 100%;
    min-width: 0;
  }

  #shopify-section-{{ section.id }} .cbaf--flip .cbaf__content {
    order: 2;
  }

  #shopify-section-{{ section.id }} .cbaf--flip .cbaf__slider-col {
    order: 1;
  }

  #shopify-section-{{ section.id }} .cbaf__content,
  #shopify-section-{{ section.id }} .cbaf__slider-col {
    min-width: 0;
    max-width: 100%;
  }

  #shopify-section-{{ section.id }} .cbaf__content {
    display: flex;
    flex-direction: column;
    gap: var(--cbaf-feature-gap);
    justify-content: center;
  }

  #shopify-section-{{ section.id }} .cbaf__intro {
    width: 100%;
    max-width: min(var(--cbaf-content-max), 100%);
    text-align: {{ content_text_align }};
    {{ content_margin }}
  }

  #shopify-section-{{ section.id }} .cbaf__eyebrow {
    margin: 0 0 {{ section.settings.eyebrow_spacing }}px;
    color: var(--cbaf-eyebrow-color);
    font-size: var(--hc-small, {{ section.settings.eyebrow_font_size_mobile }}px);
    line-height: 1.35;
    font-weight: var(--hc-fw-body, {{ section.settings.eyebrow_font_weight }});
    letter-spacing: var(--hc-ls, 0);
    text-transform: {{ section.settings.eyebrow_text_transform }};
  }

  #shopify-section-{{ section.id }} .cbaf__heading {
    margin: 0 0 {{ section.settings.heading_spacing }}px;
    color: var(--cbaf-heading-color);
    font-size: var(--hc-h1-m, {{ section.settings.heading_font_size_mobile }}px);
    line-height: var(--hc-lh-h1, 1.1);
    font-weight: var(--hc-fw-heading, {{ section.settings.heading_font_weight }});
    letter-spacing: var(--hc-ls, 0);
  }

  #shopify-section-{{ section.id }} .cbaf__text {
    margin: 0;
    color: var(--cbaf-text-color);
    font-size: var(--hc-body-m, {{ section.settings.text_font_size_mobile }}px);
    line-height: var(--hc-lh-body, 1.55);
    font-weight: var(--hc-fw-body, 400);
    letter-spacing: var(--hc-ls, 0);
  }

  #shopify-section-{{ section.id }} .cbaf__text p {
    margin: 0;
  }

  #shopify-section-{{ section.id }} .cbaf__features {
    display: flex;
    flex-direction: column;
    gap: var(--cbaf-feature-gap);
    margin: 0;
    padding: 0;
    list-style: none;
    width: 100%;
    max-width: min(var(--cbaf-content-max), 100%);
    {{ content_margin }}
  }

  #shopify-section-{{ section.id }} .cbaf__feature {
    display: grid;
    grid-template-columns: var(--cbaf-number-size) minmax(0, 1fr);
    gap: {{ section.settings.feature_number_gap }}px;
    align-items: center;
  }

  #shopify-section-{{ section.id }} .cbaf__feature-number {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: var(--cbaf-number-size);
    height: var(--cbaf-number-size);
    border-radius: 50%;
    background-color: var(--cbaf-number-bg);
    color: var(--cbaf-number-color);
    font-size: var(--hc-body-m, {{ section.settings.number_font_size }}px);
    font-weight: var(--hc-fw-strong, {{ section.settings.number_font_weight }});
    line-height: 1;
    flex-shrink: 0;
  }

  #shopify-section-{{ section.id }} .cbaf__feature-title {
    margin: 0 0 {{ section.settings.feature_title_spacing }}px;
    color: var(--cbaf-feature-title-color);
    font-size: var(--hc-h3-m, {{ section.settings.feature_title_font_size_mobile }}px);
    line-height: var(--hc-lh-h3, 1.2);
    font-weight: var(--hc-fw-strong, {{ section.settings.feature_title_font_weight }});
    letter-spacing: var(--hc-ls, 0);
  }

  #shopify-section-{{ section.id }} .cbaf__feature-text {
    margin: 0;
    color: var(--cbaf-feature-text-color);
    font-size: var(--hc-body-m, {{ section.settings.feature_text_font_size_mobile }}px);
    line-height: var(--hc-lh-body, 1.55);
    font-weight: var(--hc-fw-body, 400);
    letter-spacing: var(--hc-ls, 0);
  }

  #shopify-section-{{ section.id }} .cbaf__feature-text p {
    margin: 0;
  }

  #shopify-section-{{ section.id }} .cbaf__button-wrap {
    width: 100%;
    max-width: min(var(--cbaf-content-max), 100%);
    {{ content_margin }}
    {% if section.settings.content_alignment == 'center' %}
      text-align: center;
    {% elsif section.settings.content_alignment == 'right' %}
      text-align: right;
    {% endif %}
    margin-top: 28px;
  }

  #shopify-section-{{ section.id }} .cbaf__button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: {{ section.settings.button_min_height }}px;
    padding: {{ section.settings.button_padding_y }}px {{ section.settings.button_padding_x }}px;
    border-radius: {{ section.settings.button_border_radius }}px;
    background: var(--cbaf-btn-bg);
    color: var(--cbaf-btn-text);
    font-size: var(--hc-btn, {{ section.settings.button_font_size }}px);
    font-weight: var(--hc-fw-btn, {{ section.settings.button_font_weight }});
    line-height: 1.25;
    text-decoration: none;
    transition: opacity 0.2s ease;
    {% if section.settings.button_full_width %}
      width: 100%;
    {% endif %}
    text-transform: capitalize;
  }

  #shopify-section-{{ section.id }} .cbaf__button:hover {
    opacity: 0.88;
  }

  #shopify-section-{{ section.id }} .cbaf__slider {
    position: relative;
    width: 100%;
    min-width: 0;
  }

  #shopify-section-{{ section.id }} .cbaf__viewport {
    overflow-x: auto;
    overflow-y: hidden;
    scroll-snap-type: x mandatory;
    scroll-behavior: smooth;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
    overscroll-behavior-x: contain;
    cursor: grab;
  }

  #shopify-section-{{ section.id }} .cbaf__viewport.is-dragging {
    cursor: grabbing;
    scroll-behavior: auto;
  }

  #shopify-section-{{ section.id }} .cbaf__viewport::-webkit-scrollbar {
    display: none;
  }

  #shopify-section-{{ section.id }} .cbaf__track {
    display: flex;
    gap: var(--cbaf-slide-gap);
    width: max-content;
    padding-bottom: 0.4rem;
  }

  #shopify-section-{{ section.id }} .cbaf__slide {
    flex: 0 0 var(--cbaf-slide-width-mobile);
    scroll-snap-align: start;
    min-width: 0;
  }

  #shopify-section-{{ section.id }} .cbaf__pair {
    display: flex;
    flex-direction: column;
    gap: var(--cbaf-pair-gap);
  }

  #shopify-section-{{ section.id }} .cbaf__image-wrap {
    position: relative;
    overflow: hidden;
    border-radius: var(--cbaf-image-radius);
    border: var(--cbaf-image-border);
    background-color: {{ section.settings.image_background }};
    {% if section.settings.image_aspect_ratio != 'auto' %}
      aspect-ratio: {{ section.settings.image_aspect_ratio }};
    {% endif %}
  }

  #shopify-section-{{ section.id }} .cbaf__image-wrap img {
    display: block;
    width: 100%;
    {% if section.settings.image_aspect_ratio != 'auto' %}
      height: 100%;
    {% else %}
      height: auto;
    {% endif %}
    object-fit: {{ section.settings.image_fit }};
    object-position: {{ section.settings.image_position }};
  }

  #shopify-section-{{ section.id }} .cbaf__badge {
    position: absolute;
    top: {{ section.settings.badge_offset }}px;
    right: {{ section.settings.badge_offset }}px;
    z-index: 1;
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0.45rem 0.85rem;
    border-radius: 999px;
    font-size: {{ section.settings.badge_font_size }}px;
    font-weight: {{ section.settings.badge_font_weight }};
    line-height: 1.2;
    letter-spacing: 0;
    border: 1px solid #000000;
  }

  #shopify-section-{{ section.id }} .cbaf__badge--before {
    background: var(--cbaf-before-badge-bg);
    color: var(--cbaf-before-badge-text);
  }

  #shopify-section-{{ section.id }} .cbaf__badge--after {
    background: var(--cbaf-after-badge-bg);
    color: var(--cbaf-after-badge-text);
  }

  #shopify-section-{{ section.id }} .cbaf__dots {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: {{ section.settings.dot_gap }}px;
    margin: {{ section.settings.dot_spacing_top }}px 0 0;
    padding: 0;
    list-style: none;
  }

  #shopify-section-{{ section.id }} .cbaf__dot {
    width: {{ section.settings.dot_size }}px;
    height: {{ section.settings.dot_size }}px;
    padding: 0;
    border: 0;
    border-radius: 50%;
    background: var(--cbaf-dot-color);
    cursor: pointer;
    transition: background-color 0.2s ease, transform 0.2s ease;
  }

  #shopify-section-{{ section.id }} .cbaf__dot.is-active {
    background: var(--cbaf-dot-active);
    transform: scale(1.15);
  }

  #shopify-section-{{ section.id }} .cbaf__nav {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    z-index: 2;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: auto;
    height: auto;
    padding: 0.25rem;
    border: 0;
    border-radius: 0;
    background: transparent;
    color: {{ section.settings.nav_button_color }};
    box-shadow: none;
    cursor: pointer;
    transition: opacity 0.2s ease;
  }

  #shopify-section-{{ section.id }} .cbaf__nav:hover {
    opacity: 0.55;
  }

  #shopify-section-{{ section.id }} .cbaf__nav:disabled {
    opacity: 0.2;
    cursor: not-allowed;
  }

  #shopify-section-{{ section.id }} .cbaf__nav--prev {
    left: {{ section.settings.nav_button_offset }}px;
  }

  #shopify-section-{{ section.id }} .cbaf__nav--next {
    right: {{ section.settings.nav_button_offset }}px;
  }

  #shopify-section-{{ section.id }} .cbaf__nav svg {
    width: {{ section.settings.nav_icon_size }}px;
    height: {{ section.settings.nav_icon_size }}px;
    display: block;
  }

  @media screen and (min-width: 990px) {
    #shopify-section-{{ section.id }} .cbaf__eyebrow {
      font-size: var(--hc-body-d, {{ section.settings.eyebrow_font_size }}px);
    }

    #shopify-section-{{ section.id }} .cbaf__heading {
      font-size: var(--hc-h1-d, {{ section.settings.heading_font_size }}px);
    }

    #shopify-section-{{ section.id }} .cbaf__text {
      font-size: var(--hc-body-d, {{ section.settings.text_font_size }}px);
    }

    #shopify-section-{{ section.id }} .cbaf__feature-title {
      font-size: var(--hc-h3-d, {{ section.settings.feature_title_font_size }}px);
    }

    #shopify-section-{{ section.id }} .cbaf__feature-text {
      font-size: var(--hc-body-d, {{ section.settings.feature_text_font_size }}px);
    }

    #shopify-section-{{ section.id }} .cbaf__slide {
      flex-basis: var(--cbaf-slide-width-desktop);
    }
  }

  /* Keep the same page-width desktop layout above 1400px (match 990–1400) */
  @media screen and (min-width: 1440px) {
    #shopify-section-{{ section.id }} .cbaf .page-width,
    #shopify-section-{{ section.id }} .cbaf__page-width {
      {% if section.settings.use_theme_page_width %}
        max-width: var(--page-width);
      {% else %}
        max-width: {{ section.settings.section_max_width }}px;
      {% endif %}
      width: 100%;
      margin-left: auto;
      margin-right: auto;
      padding-inline: 5rem;
      box-sizing: border-box;
    }

    #shopify-section-{{ section.id }} .cbaf__grid {
      display: grid;
      grid-template-columns: var(--cbaf-content-col) var(--cbaf-slider-col);
      gap: var(--cbaf-column-gap);
      align-items: {{ section.settings.vertical_alignment }};
      width: 100%;
      min-width: 0;
    }

    #shopify-section-{{ section.id }} .cbaf__content,
    #shopify-section-{{ section.id }} .cbaf__slider-col {
      min-width: 0;
      max-width: 100%;
      width: 100%;
    }

    #shopify-section-{{ section.id }} .cbaf__slider {
      width: 100%;
      max-width: 100%;
      min-width: 0;
      overflow: visible;
    }

    #shopify-section-{{ section.id }} .cbaf__viewport {
      width: 100%;
      max-width: 100%;
      overflow-x: auto;
      overflow-y: hidden;
    }

    #shopify-section-{{ section.id }} .cbaf__slide {
      flex: 0 0 60%;
      max-width: 60%;
      min-width: 0;
    }

    #shopify-section-{{ section.id }} .cbaf__pair {
      width: 100%;
    }

    #shopify-section-{{ section.id }} .cbaf__image-wrap {
      width: 100%;
      max-width: 100%;
      {% if section.settings.image_aspect_ratio != 'auto' %}
        aspect-ratio: {{ section.settings.image_aspect_ratio }};
      {% endif %}
    }

    #shopify-section-{{ section.id }} .cbaf__image-wrap img {
      display: block;
      width: 100%;
      max-width: 100%;
      {% if section.settings.image_aspect_ratio != 'auto' %}
        height: 100%;
      {% else %}
        height: auto;
      {% endif %}
      object-fit: {{ section.settings.image_fit }};
      object-position: {{ section.settings.image_position }};
    }
  }

  @media screen and (max-width: 989px) {
    #shopify-section-{{ section.id }} .cbaf {
      padding-top: {{ section.settings.mobile_padding_top }}px;
      padding-bottom: {{ section.settings.mobile_padding_bottom }}px;
    }

    #shopify-section-{{ section.id }} .cbaf .page-width,
    #shopify-section-{{ section.id }} .cbaf__page-width {
      padding-inline: var(--cbaf-mobile-padding-x);
    }

    #shopify-section-{{ section.id }} .cbaf__grid {
      display: flex;
      flex-direction: column;
      gap: {{ section.settings.mobile_block_gap }}px;
    }

    #shopify-section-{{ section.id }} .cbaf__content {
      display: contents;
    }

    #shopify-section-{{ section.id }} .cbaf__intro {
      order: 1;
      max-width: 100%;
      text-align: center;
      margin-inline: 0;
    }

    #shopify-section-{{ section.id }} .cbaf__slider-col {
      order: 2;
    }

    #shopify-section-{{ section.id }} .cbaf__features {
      order: 3;
      max-width: 100%;
      margin-inline: 0;
      text-align: left;
    }

    #shopify-section-{{ section.id }} .cbaf__button-wrap {
      order: 4;
      max-width: 100%;
      margin-inline: 0;
      text-align: center;
    }

    {% unless section.settings.show_nav_mobile %}
    #shopify-section-{{ section.id }} .cbaf__nav {
      display: none;
    }
    {% endunless %}
  }
{%- endstyle -%}

<div
  class="cbaf{% if layout_flip %} cbaf--flip{% endif %}"
  id="cbaf-{{ section.id }}"
  data-cbaf-root
  data-autoplay="{{ section.settings.autoplay }}"
  data-autoplay-interval="{{ section.settings.autoplay_interval | times: 1000 }}"
>
  <div class="{% if section.settings.use_theme_page_width %}page-width{% else %}cbaf__page-width{% endif %}">
    <div class="cbaf__grid">
      <div class="cbaf__content">
        <div class="cbaf__intro">
          {%- if section.settings.eyebrow != blank -%}
            <p class="cbaf__eyebrow">{{ section.settings.eyebrow | escape }}</p>
          {%- endif -%}

          {%- if section.settings.heading != blank -%}
            <{{ section.settings.heading_tag }} class="cbaf__heading">
              {{ section.settings.heading | escape }}
            </{{ section.settings.heading_tag }}>
          {%- endif -%}

          {%- if section.settings.text != blank -%}
            <div class="cbaf__text rte">{{ section.settings.text }}</div>
          {%- endif -%}
        </div>

        {%- if feature_blocks.size > 0 -%}
          <ul class="cbaf__features" role="list">
            {%- for block in feature_blocks -%}
              {%- liquid
                assign feature_number = forloop.index
                if block.settings.number != blank
                  assign feature_number = block.settings.number
                endif
              -%}
              <li class="cbaf__feature" {{ block.shopify_attributes }}>
                <span class="cbaf__feature-number" aria-hidden="true">{{ feature_number }}</span>
                <div class="cbaf__feature-body">
                  {%- if block.settings.title != blank -%}
                    <h3 class="cbaf__feature-title">{{ block.settings.title | escape }}</h3>
                  {%- endif -%}
                  {%- if block.settings.text != blank -%}
                    <div class="cbaf__feature-text rte">{{ block.settings.text }}</div>
                  {%- endif -%}
                </div>
              </li>
            {%- endfor -%}
          </ul>
        {%- endif -%}

        {%- if section.settings.button_label != blank -%}
          <div class="cbaf__button-wrap">
            <a
              class="button button--medium cbaf__button"
              {% if section.settings.button_link != blank %}
                href="{{ section.settings.button_link }}"
              {% else %}
                role="link" aria-disabled="true"
              {% endif %}
              {% if section.settings.button_open_new_tab %}
                target="_blank" rel="noopener noreferrer"
              {% endif %}
            >
              {{ section.settings.button_label | escape }}
            </a>
          </div>
        {%- endif -%}
      </div>

      {%- if slide_blocks.size > 0 -%}
        <div class="cbaf__slider-col">
          <div class="cbaf__slider">
            {%- if section.settings.show_nav_arrows -%}
              <button type="button" class="cbaf__nav cbaf__nav--prev" data-cbaf-prev aria-label="{{ section.settings.nav_prev_label | escape }}">
                <svg xmlns="http://www.w3.org/2000/svg" width="60" height="60" viewBox="0 0 60 60" fill="none" aria-hidden="true">
                  <path d="M60 30C60 24.0666 58.2405 18.2664 54.9441 13.3329C51.6476 8.39943 46.9623 4.55426 41.4805 2.28363C35.9987 0.0130005 29.9667 -0.581097 24.1473 0.576458C18.3279 1.73401 12.9824 4.59124 8.78681 8.78681C4.59124 12.9824 1.73401 18.3279 0.576458 24.1473C-0.581097 29.9667 0.0130005 35.9987 2.28363 41.4805C4.55426 46.9623 8.39943 51.6476 13.3329 54.9441C18.2664 58.2405 24.0666 60 30 60C37.9565 60 45.5871 56.8393 51.2132 51.2132C56.8393 45.5871 60 37.9565 60 30ZM47.1429 32.1429H21.1072L33.0643 44.1579L30 47.1429L12.8572 30L30 12.8572L33.0643 15.915L21.1072 27.8572L47.1429 27.8572V32.1429Z" fill="white"/>
                </svg>
              </button>
              <button type="button" class="cbaf__nav cbaf__nav--next" data-cbaf-next aria-label="{{ section.settings.nav_next_label | escape }}">
                <svg xmlns="http://www.w3.org/2000/svg" width="60" height="60" viewBox="0 0 60 60" fill="none" aria-hidden="true">
                  <path d="M0 30C0 35.9334 1.75947 41.7336 5.05591 46.6671C8.35235 51.6006 13.0377 55.4457 18.5195 57.7164C24.0013 59.987 30.0333 60.5811 35.8527 59.4235C41.6721 58.266 47.0176 55.4088 51.2132 51.2132C55.4088 47.0176 58.266 41.6721 59.4235 35.8527C60.5811 30.0333 59.987 24.0013 57.7164 18.5195C55.4457 13.0377 51.6006 8.35235 46.6671 5.05591C41.7336 1.75947 35.9334 0 30 0C22.0435 0 14.4129 3.1607 8.78679 8.78679C3.1607 14.4129 0 22.0435 0 30ZM12.8571 27.8571H38.8928L26.9357 15.8421L30 12.8571L47.1428 30L30 47.1428L26.9357 44.085L38.8928 32.1428H12.8571V27.8571Z" fill="white"/>
                </svg>
              </button>
            {%- endif -%}

            <div class="cbaf__viewport" data-cbaf-viewport tabindex="0">
              <div class="cbaf__track" data-cbaf-track>
                {%- for block in slide_blocks -%}
                  <div class="cbaf__slide" data-cbaf-slide {{ block.shopify_attributes }}>
                    <div class="cbaf__pair">
                      <div class="cbaf__image-wrap">
                        {%- liquid
                          assign before_label = section.settings.before_label
                          if block.settings.before_label != blank
                            assign before_label = block.settings.before_label
                          endif
                        -%}
                        {%- if before_label != blank -%}
                          <span class="cbaf__badge cbaf__badge--before">{{ before_label | escape }}</span>
                        {%- endif -%}
                        {%- if block.settings.before_image != blank -%}
                          {{
                            block.settings.before_image
                            | image_url: width: 1200
                            | image_tag:
                              loading: 'lazy',
                              widths: '360, 540, 720, 900, 1200',
                              sizes: '(min-width: 1400px) 200px, (min-width: 990px) 28vw, 85vw',
                              alt: block.settings.before_image.alt | default: before_label | escape
                          }}
                        {%- else -%}
                          {{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}
                        {%- endif -%}
                      </div>

                      <div class="cbaf__image-wrap">
                        {%- liquid
                          assign after_label = section.settings.after_label
                          if block.settings.after_label != blank
                            assign after_label = block.settings.after_label
                          endif
                        -%}
                        {%- if after_label != blank -%}
                          <span class="cbaf__badge cbaf__badge--after">{{ after_label | escape }}</span>
                        {%- endif -%}
                        {%- if block.settings.after_image != blank -%}
                          {{
                            block.settings.after_image
                            | image_url: width: 1200
                            | image_tag:
                              loading: 'lazy',
                              widths: '360, 540, 720, 900, 1200',
                              sizes: '(min-width: 1400px) 200px, (min-width: 990px) 28vw, 85vw',
                              alt: block.settings.after_image.alt | default: after_label | escape
                          }}
                        {%- else -%}
                          {{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}
                        {%- endif -%}
                      </div>
                    </div>
                  </div>
                {%- endfor -%}
              </div>
            </div>

            {%- if section.settings.show_dots and slide_blocks.size > 1 -%}
              <div class="cbaf__dots" data-cbaf-dots role="tablist" aria-label="{{ section.settings.dots_aria_label | escape }}">
                {%- for block in slide_blocks -%}
                  <button
                    type="button"
                    class="cbaf__dot{% if forloop.first %} is-active{% endif %}"
                    data-cbaf-dot="{{ forloop.index0 }}"
                    aria-label="{{ section.settings.dot_aria_label | escape }} {{ forloop.index }}"
                    {% if forloop.first %}aria-current="true"{% endif %}
                  ></button>
                {%- endfor -%}
              </div>
            {%- endif -%}
          </div>
        </div>
      {%- endif -%}
    </div>
  </div>
</div>

{%- if slide_blocks.size > 1 -%}
<script>
  (function () {
    var root = document.getElementById('cbaf-{{ section.id }}');
    if (!root || root.dataset.cbafInit === 'true') return;
    root.dataset.cbafInit = 'true';

    var viewport = root.querySelector('[data-cbaf-viewport]');
    var slides = Array.from(root.querySelectorAll('[data-cbaf-slide]'));
    var dots = Array.from(root.querySelectorAll('[data-cbaf-dot]'));
    var prevBtn = root.querySelector('[data-cbaf-prev]');
    var nextBtn = root.querySelector('[data-cbaf-next]');
    var autoplay = root.dataset.autoplay === 'true';
    var autoplayInterval = parseInt(root.dataset.autoplayInterval, 10) || 5000;

    if (!viewport || slides.length === 0) return;

    var activeIndex = 0;
    var isDragging = false;
    var dragStartX = 0;
    var dragScrollLeft = 0;
    var scrollTimer = null;
    var isSnapping = false;
    var autoplayTimer = null;

    function getNearestIndex() {
      var nearest = 0;
      var minDist = Infinity;
      slides.forEach(function (slide, index) {
        var dist = Math.abs(viewport.scrollLeft - slide.offsetLeft);
        if (dist < minDist) {
          minDist = dist;
          nearest = index;
        }
      });
      return nearest;
    }

    function syncDots() {
      dots.forEach(function (dot, index) {
        var isActive = index === activeIndex;
        dot.classList.toggle('is-active', isActive);
        if (isActive) {
          dot.setAttribute('aria-current', 'true');
        } else {
          dot.removeAttribute('aria-current');
        }
      });
    }

    function syncNav() {
      if (prevBtn) prevBtn.disabled = activeIndex <= 0;
      if (nextBtn) nextBtn.disabled = activeIndex >= slides.length - 1;
    }

    function scrollToIndex(index, smooth) {
      activeIndex = Math.max(0, Math.min(slides.length - 1, index));
      var slide = slides[activeIndex];
      if (!slide) return;
      isSnapping = true;
      viewport.scrollTo({ left: slide.offsetLeft, behavior: smooth ? 'smooth' : 'auto' });
      window.setTimeout(function () {
        isSnapping = false;
        syncDots();
        syncNav();
      }, smooth ? 350 : 0);
    }

    function snapToNearest(smooth) {
      scrollToIndex(getNearestIndex(), smooth);
    }

    function goByStep(direction) {
      scrollToIndex(activeIndex + direction, true);
      restartAutoplay();
    }

    function restartAutoplay() {
      if (!autoplay) return;
      window.clearInterval(autoplayTimer);
      autoplayTimer = window.setInterval(function () {
        var next = activeIndex >= slides.length - 1 ? 0 : activeIndex + 1;
        scrollToIndex(next, true);
      }, autoplayInterval);
    }

    viewport.addEventListener('scroll', function () {
      if (!isSnapping) activeIndex = getNearestIndex();
      syncDots();
      syncNav();
      if (isDragging || isSnapping) return;
      window.clearTimeout(scrollTimer);
      scrollTimer = window.setTimeout(function () {
        snapToNearest(true);
      }, 140);
    }, { passive: true });

    dots.forEach(function (dot) {
      dot.addEventListener('click', function () {
        var index = parseInt(dot.dataset.cbafDot, 10);
        if (!Number.isFinite(index)) return;
        scrollToIndex(index, true);
        restartAutoplay();
      });
    });

    if (prevBtn) prevBtn.addEventListener('click', function () { goByStep(-1); });
    if (nextBtn) nextBtn.addEventListener('click', function () { goByStep(1); });

    viewport.addEventListener('pointerdown', function (event) {
      if (event.pointerType === 'mouse' && event.button !== 0) return;
      isDragging = true;
      dragStartX = event.clientX;
      dragScrollLeft = viewport.scrollLeft;
      viewport.classList.add('is-dragging');
      window.clearTimeout(scrollTimer);
      if (viewport.setPointerCapture) viewport.setPointerCapture(event.pointerId);
    });

    viewport.addEventListener('pointermove', function (event) {
      if (!isDragging) return;
      viewport.scrollLeft = dragScrollLeft - (event.clientX - dragStartX);
    });

    function endDrag(event) {
      if (!isDragging) return;
      isDragging = false;
      viewport.classList.remove('is-dragging');
      if (viewport.releasePointerCapture && event.pointerId !== undefined) {
        try { viewport.releasePointerCapture(event.pointerId); } catch (e) {}
      }
      snapToNearest(true);
      restartAutoplay();
    }

    viewport.addEventListener('pointerup', endDrag);
    viewport.addEventListener('pointercancel', endDrag);

    window.addEventListener('resize', function () {
      scrollToIndex(activeIndex, false);
    });

    scrollToIndex(0, false);
    restartAutoplay();
  })();
</script>
{%- endif -%}

