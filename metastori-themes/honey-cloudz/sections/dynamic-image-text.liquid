<section class="image-text-banner" style="background-image: url({{ section.settings.bg_image | img_url: 'master' }});">
  <div class="page-width image-text-wrapper">
    <div class="text-content">
     <div class="benefits-heading-wrapper1 {% if section.settings.side_by_side %}side-by-side1{% endif %}">
  {% if section.settings.heading != blank %}
    <h2 class="benefits-heading1">{{ section.settings.heading }}</h2>
  {% endif %}
  {% if section.settings.subheading1 != blank %}
    <p class="benefits-subheading1">{{ section.settings.subheading1 }}</p>
  {% endif %}
</div>
      {% if section.settings.subheading %}
      <div class="subheading">{{ section.settings.subheading }}</div>
      {% endif %}
    </div>
    <div class="image-content">
      {% if section.settings.main_image %}
        <img src="{{ section.settings.main_image | img_url: '800x' }}" alt="Banner Image">
      {% endif %}
    </div>
  </div>
</section>

<style>
.image-text-banner {
  background-size: cover;
  background-position: center;
  padding: 60px 0px 0px;
  color: #000;
}

.image-text-wrapper {
  display: flex;
  align-items: center; 
  justify-content: space-between;
  flex-wrap: wrap;
  max-width: 1200px;
  margin: 0 auto;
  gap: 32px;
  padding:0px;
}
.subheading p:last-child {
    margin-bottom: 0;
}
.benefits-heading1 {
  text-align: left;
  font-size: 48px;
  margin-bottom: 5px;
  font-family: "Send Flowers", cursive;
  font-weight: 400;
  font-style: normal;
}
.benefits-subheading1 {
  text-align: left;
  font-size: 34px;
  margin-bottom: 40px;
  font-family: "Poppins", sans-serif;
  font-weight: 400;
  font-style: normal;
  margin-top:0px;
}

.benefits-heading-wrapper1 {
    text-align: left;
    margin-bottom: 25px;
  }
/* Default → stacked (2 lines) */
  .benefits-heading-wrapper1 .benefits-heading1,
  .benefits-heading-wrapper1 .benefits-subheading1 {
    display: block;
    margin: 0;
  }

  /* Checkbox ON → side by side */
  .benefits-heading-wrapper1.side-by-side1 {
    display: flex;
    justify-content: Bra Inserts;
    align-items: center;
    gap: 10px; /* spacing between heading and subheading */
    flex-wrap: wrap;
  }

  .benefits-heading-wrapper1.side-by-side1 .benefits-heading1,
  .benefits-heading-wrapper1.side-by-side1 .benefits-subheading1 {
    display: inline-block;
    margin: 0;
  }
  .benefits-heading-wrapper1.side-by-side1 .benefits-subheading1{ font-size:40px; }
.text-content {
  flex: 1;
  min-width: 300px;
  margin-bottom: 0px;

}

.heading {
  margin-bottom:20px;
}

h2.heading img {
    max-width: 450px;
}

.heading .italic {
  font-style: italic;
  font-weight: 400;
}

.heading strong {
  font-weight: 700;  
}
.subheading {
    font-size: 20px;
    margin-top: 0;
    font-family: 'Satoshi';
    text-align:left;
    font-weight: 500;
    letter-spacing: normal;
    line-height: 28px;
}
.subheading p {
    font-size: 20px;
    margin-top: 0;
    font-family: 'Satoshi';
    text-align:left;
    font-weight: 500;
    letter-spacing: normal;
    line-height: 28px;
}

.image-content {
  flex: 1;
  min-width: 300px;
  text-align: center;
}

.image-content img {
  max-width: 100%;
  height: auto;
  vertical-align: bottom;
}
@media only screen and (max-width: 1200px) and (min-width: 768px)  {
  .text-content { padding-left:50px; }
  .subheading{ font-size:16px; }
}
@media screen and (max-width: 767px) {
  .image-text-wrapper {
    text-align: center;
  }
  .heading {
    font-size: 28px;
  }
  .subheading, .description {
    font-size: 15px; text-align:center;
  }
  .subheading p{
    font-size:14px; text-align:center;
  }
  h2.heading img {
    max-width: 100%;
    margin: 0 auto;
}
  .text-content {
    padding: 0px 20px;
    margin-bottom:0px; 
}
  .image-text-wrapper {
    gap:0px;
  }
  .benefits-heading1 { font-size: 32px; text-align: center;}
  .benefits-subheading1 { font-size: 20px; text-align: center;}

  .benefits-heading-wrapper1.side-by-side1 .benefits-subheading1{ font-size:30px; }
  .benefits-heading-wrapper1.side-by-side1 {
    display: block;
  }
  .benefits-heading-wrapper1.side-by-side1 .benefits-heading1{
    padding-right: 8px;
}
  .benefits-heading-wrapper1 {
    text-align: center;
    margin-bottom: 24px;
}
}
</style>

{% schema %}
{
  "name": "Image Text Banner IW",
  "settings": [
    {
      "type": "image_picker",
      "id": "bg_image",
      "label": "Background Image"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Benefits of Honey Cloudz"
    },
    {
      "type": "text",
      "id": "subheading1",
      "label": "Subheading"
    },
    {
      "type": "checkbox",
      "id": "side_by_side",
      "label": "Show heading & subheading side by side",
      "default": false
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading",
      "default": "You’ll find bra inserts in all shapes, sizes & support levels here! Discover soft, stay-put inserts for every outfit — from swimwear to sports bras to everyday wear."
    },
    {
      "type": "image_picker",
      "id": "main_image",
      "label": "Main Image (Right Side)"
    }
  ],
  "presets": [
    {
      "name": "Image Text Banner IW",
      "category": "Custom"
    }
  ]
}
{% endschema %}
