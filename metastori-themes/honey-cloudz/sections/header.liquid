{% if request.design_mode %}{% render "tapita-header-editor" %}{% endif %} {%- liquid
  assign logo_position = section.settings.logo_position
  assign enable_transparent_header = false

  if template == 'index' and section.settings.enable_transparent_header
    assign enable_transparent_header = true
  endif

  if template.name == 'collection' and section.settings.enable_transparent_header_collection and collection.image
    assign enable_transparent_header = true
  endif

  if request.page_type == 'page' and section.settings.enable_transparent_header_custom != blank and section.settings.enable_transparent_header_custom.links != blank
    for link in section.settings.enable_transparent_header_custom.links
      if page.handle == link.object.handle
        assign enable_transparent_header = true
      endif
    endfor
  endif

  if logo_position == 'center-split' and section.settings.menu != blank
    assign link_count_half = section.settings.menu.links.size | times: 1.0 | divided_by: 2 | round
  endif

  assign enable_dropdown_menu = section.settings.enable_dropdown_menu
  assign enable_sticky_header = section.settings.enable_sticky_header

  comment
    The logo is absolutely centred over the header, so the inline menu runs underneath
    it once the viewport gets narrow enough. The top-level links named in
    "menu_links_beside_icons" are rendered a second time next to the header icons, and
    the two copies swap over at "menu_links_beside_icons_below" so the links move past
    the logo instead of disappearing behind it.
  endcomment
  assign beside_icons_handles = ''
  if section.settings.menu_links_beside_icons != blank
    assign beside_icons_titles = section.settings.menu_links_beside_icons | split: ','
    for beside_icons_title in beside_icons_titles
      assign beside_icons_handle = beside_icons_title | strip | handle
      if beside_icons_handle != blank
        assign beside_icons_handles = beside_icons_handles | append: ',' | append: beside_icons_handle
      endif
    endfor
    if beside_icons_handles != blank
      assign beside_icons_handles = beside_icons_handles | append: ','
    endif
  endif
-%}

{%- style -%}
  #shopify-section-{{ section.id }} {
    --section-padding-top: {{ section.settings.padding_top }}px;
    --section-padding-bottom: {{ section.settings.padding_bottom }}px;
    --image-logo-height: {{ section.settings.mobile_logo_height }}px;
    --gradient-header-background: {% if section.settings.gradient_background != blank %}{{ section.settings.gradient_background }}{% else %}{{ section.settings.colors_background }}{% endif %};
    --color-header-background: {{ section.settings.colors_background.red }}, {{ section.settings.colors_background.green }}, {{ section.settings.colors_background.blue }};
    --color-header-foreground: {{ section.settings.colors_text.red }}, {{ section.settings.colors_text.green }}, {{ section.settings.colors_text.blue }};
    --color-header-border: {{ section.settings.colors_border.red }}, {{ section.settings.colors_border.green }}, {{ section.settings.colors_border.blue }};
    --icon-weight: {{ section.settings.icon_weight }}px;
  }
.list-mega-menu-items-wrapper {
    display: flex;
    gap: 100px;
    width: 100%;
    padding: 0px 30px;
}
ul.list-mega-menu-items {
    list-style-type: none;
    padding: 0px;
    margin: 0px;
    opacity: 0;
    transition: opacity 0.3s ease;
    visibility: hidden;
}
.is-megamenu.is-active ul.list-mega-menu-items {
    opacity: 1;
    visibility: visible;
}
.list-mega-menu-items-content {
    flex: 1;
    opacity: 0;
    transition: opacity 0.3s ease;
    visibility: hidden;
}
.is-megamenu.is-active .list-mega-menu-items-content {
    opacity: 1;
    visibility: visible;
}
ul.list-mega-menu-items li a.list-menu__item {
    padding: 8px 0px;
    text-transform: uppercase;
    font-weight: 500;
    --color-border:0, 180, 229;
}
ul.list-mega-menu-items li a.list-menu__item:hover,
ul.list-mega-menu-items li a.list-menu__item:focus,
ul.list-mega-menu-items li a.list-menu__item.active {
    color: #00b4e5;
}
.list-mega-menu-items-content-item:not(.active){
  display: none;
}
ul.list-menu-child.list-menu {
    display: flex;
    gap: 40px;
    flex-wrap: wrap;
}
ul.list-menu-child.list-menu > li {
    width: calc(20% - 32px);
}
ul.list-menu-child.list-menu > li a {
    display: flex;
    flex-direction: column;
    gap: 10px;
    font-size: 20px;
    font-weight: 500;
    --color-border:0, 180, 229;
}
.mega-menu__label-tab img {
    display: block;
    width: 100%;
    height: auto;
}
ul.list-menu-child.list-menu > li a:hover {
    color: #00b4e5;
}
.mega-menu__label-tab {
    width: 100%;
}
.list-mega-menu-items-content-item-view-all .button {
    border-radius: 40px;
    letter-spacing: 0px;
    text-transform: unset;
}
.list-mega-menu-items-content-item-view-all .button span {
    margin-left: 10px;
}
.list-mega-menu-items-content-item-view-all .button span img {
    display: block;
    max-width: 20px;
}
.list-mega-menu-items-content-item-view-all {
    margin-top: 20px;
}
.is-megamenu>.list-menu-dropdown {
    min-height: 280px;
    overflow-y: auto;
    padding-top: 1.5rem;
    padding-bottom: 2rem;
}
.is-megamenu.mega-menu--layout-columns > .list-menu-dropdown {
  background: #FFF6F3;
}
.is-megamenu.mega-menu--layout-columns > .list-menu-dropdown::before {
  background: #FFF6F3;
}
.is-megamenu.mega-menu--layout-columns > .list-menu-dropdown .page-width--mega-menu {
  max-width: 100%;
  padding-left: 2rem;
  padding-right: 2rem;
}
.mega-menu__panel {
  display: flex;
  gap: 5rem;
  width: 100%;
  background: #FFF6F3;
  align-items: flex-start;
}
.mega-menu__columns {
  display: flex;
  gap: 2.5rem;
  flex: 1 1 50%;
  min-width: 0;
}
.mega-menu__column {
  display: flex;
  flex-direction: column;
  flex: 1;
  min-width: 0;
}
.mega-menu__column-title {
  font-size: 1.35rem;
  font-weight: 700;
  text-transform: none;
  letter-spacing: 0.04em;
  margin: 0 0 0.75rem 0;
  padding-bottom: 1.25rem;
  color: #1a1b18;
  display: inline-flex;
  align-items: baseline;
  gap: 0.6rem;
  border-bottom: 1px solid #000;
}
.mega-menu__column-badge {
  font-size: 0.9rem;
  color: #8a8a8a;
  margin: 0;
  text-transform: uppercase;
  letter-spacing: 0.04em;
  font-weight: 500;
}
.mega-menu__column-list {
  list-style: none;
  padding: 0;
  margin: 0;
}
/* Shape column: Triangle, Oval, Half Moon, Teardrop */
#mega-column-shape .mega-menu__column-list {
  padding-left: 0.5rem;
}
.mega-menu__column-list li {
  margin: 0;
}
.mega-menu__column-link {
  display: flex !important; /* beats .header__menu-item { display: inline-flex } so gap/layout are reliable */
  align-items: center;
  gap: 1rem;
  padding: 0.5rem 0;
  text-decoration: none;
  color: #1a1b18;
  font-size: 1.3rem;
  text-transform: none;
  letter-spacing: 0;
  font-weight: 400;
  width: 100%;
  flex-wrap: nowrap;
  box-sizing: border-box;
}
/* Label + POST-OP share one flex row so gap always sits between text and pill */
.mega-menu__column-link-text {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 0.65rem;
  min-width: 0;
  flex: 1 1 auto;
}
.mega-menu__column-link.header__menu-item .label {
  background: none !important;
  background-image: none !important;
  background-size: auto !important;
  background-position: initial !important;
}
.mega-menu__column-link .label {
  font-weight: inherit;
  white-space: nowrap; /* prevent wrapping to a new line */
  position: relative;
  display: inline-block;
  padding-bottom: 3px; /* room for underline */
}

.mega-menu__column-link .label::after {
  content: '';
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  height: 2px;
  background: #00B8EA;
  opacity: 0;
  transform: scaleX(0);
  transform-origin: left;
  transition: opacity 160ms ease, transform 160ms ease;
}

.mega-menu__column-link:hover .label::after,
.mega-menu__column-link:focus .label::after {
  opacity: 1;
  transform: scaleX(1);
}
.mega-menu__column-link:hover,
.mega-menu__column-link:focus {
  color: #00b4e5;
}
.mega-menu__column-link.list-menu__item--active {
  color: #00B8EA;
}
.mega-menu__column-link.list-menu__item--active .label {
  font-weight: 700;
}
.mega-menu__column-link:hover .label,
.mega-menu__column-link:focus .label {
  font-weight: 800;
}
.mega-menu__column-link-bullet {
  flex-shrink: 0;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 16px;
  color: inherit; /* drives icon currentColor */
}
.mega-menu__column-link-bullet svg.icon {
  width: 12px;
  height: 12px;
}
.mega-menu__column-link.list-menu__item--active .mega-menu__column-link-bullet {
  color: #00B8EA !important;
}
.mega-menu__column-link-dot {
  width: 10px;
  height: 10px;
  border: 1.5px solid currentColor;
  border-radius: 50%;
  display: block;
  box-sizing: border-box;
}
.mega-menu__column-link:hover .mega-menu__column-link-dot,
.mega-menu__column-link:focus .mega-menu__column-link-dot {
  border-color: #00b4e5;
}
.mega-menu__column-link.list-menu__item--active .mega-menu__column-link-dot {
  border-color: #1a1b18;
  background: #1a1b18;
}
.mega-menu__shape-icon {
  width: 10px;
  height: 10px;
  flex-shrink: 0;
}
.mega-menu__shape-icon--triangle {
  color: #1a1b18;
}
.mega-menu__column-link.list-menu__item--active .mega-menu__shape-icon--filled {
  color: #1a1b18;
}
.mega-menu__post-op-tag {
  font-size: 0.75rem;
  padding: 0.35rem 1rem;
  background: transparent;
  color: #1a1a1a;
  border: 1px solid #333333;
  border-radius: 999px;
  margin-left: 0;
  text-transform: uppercase;
  letter-spacing: 0.06em;
  font-weight: 600;
  white-space: nowrap;
  flex-shrink: 0;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  line-height: 1;
  position: relative;
  z-index: 1;
  vertical-align: middle;
  box-sizing: border-box;
}
.mega-menu__column-shop-all {
  margin-top: 0.75rem;
  display: block;
  padding-left: 0; /* align with submenu label start (no icon column) */
  font-size: 1.5rem;
  color: #00b4e5;
  text-decoration: none;
  font-weight: bold;
  box-sizing: border-box;
}
/* Shape column: match label inset (list padding + icon column + link gap) */
#mega-column-shape .mega-menu__column-shop-all {
  padding-left: .75rem;
}
.mega-menu__column-shop-all:hover {
  color: #0099c7;
}
.mega-menu__promos {
  display: flex;
  gap: 1.5rem;
  flex: 0 0 50%;
  min-width: 0;
  justify-content: flex-end; /* keep right promos flush to right edge */
}
.mega-menu__promo {
  flex: 1;
  min-width: 0;
}
.mega-menu__promo-link {
  display: block;
  text-decoration: none;
  color: inherit;
}
.mega-menu__promo-media {
  border-radius: 8px;
  overflow: hidden;
  aspect-ratio: 4/3;
  background: #e5e5e5;
}
.mega-menu__promo-media img {
  width: 100%;
  height: 100%;
  object-fit: cover;
}
.mega-menu__promo-placeholder {
  width: 100%;
  height: 100%;
  min-height: 140px;
  background: #e5e5e5;
}
.mega-menu__promo-label {
  display: block;
  text-align: center;
  margin-top: -.5rem;
  margin-bottom: 0;
  font-size: 1.2rem;
  font-weight: 600;
  color: #1a1b18;
}
.mega-menu__promo-link:hover .mega-menu__promo-label {
  color: #00b4e5;
}
.is-megamenu.is-active > .header__menu-item .label {
  color: #00b4e5;
}
.is-megamenu.is-active > .header__menu-item .icon-caret {
  transform: rotate(-180deg);
}
header.header nav.header__inline-menu a.header__menu-item .label {
    text-align: center;
}
/* .header-wrapper>.header:before,
.list-menu-dropdown:before{
  background-color: #FDF6F2 !important;
}
.list-menu-dropdown:after{
  box-shadow: 0 1rem 2rem rgba(253, 246, 242, 0.8) !important;
} */
@media screen and (min-width: 990px) and (max-width: 1265px) {
  .list-menu--inline {
    column-gap: 0;
  }
  .mega-menu__panel{
    flex-wrap:wrap;
  }
}

@media screen and (min-width: 990px) and (max-width: 1118px) {
  header.header nav.header__inline-menu a.header__menu-item {
    font-size: 14px;
  }
  
}

@media screen and (max-width:989px){
  .header__heading::before, .header__heading-link:not(.header__heading .header__heading-link)::before{
    content: '';
    width: 300%;
    height: 200%;
    position: absolute;
    top: -50%;
    left: -100%;
    background: linear-gradient(180deg, rgba(255, 255, 255, 0.8) -3.59%, rgba(255, 255, 255, 0.8) 30.29%, rgba(255, 255, 255, 0.8) 48.46%, rgba(255, 255, 255, 0.8) 73.29%, rgba(255, 255, 255, 0.8) 100%);
    filter: blur(60px);
  }
  .custom-size-guide-how-to-use .header__heading::before, .header__heading-link:not(.header__heading .header__heading-link)::before{
    content: unset;
   }
  header-drawer .menu-drawer {
    background: #FFF9F6;
  }
  .menu-drawer__navigation {
    border-top: 1px solid #00000066;
  }
  .menu-drawer__navigation .menu-drawer__menu {
    padding-left: 0px;
    padding-top: 20px;
  }
  .menu-drawer__navigation .menu-drawer__menu .menu-drawer__menu-item {
    font-family: Satoshi, " sans-serif";
    letter-spacing: 0px;
    color: #333333;
    font-weight: 700;
    font-size: 24px;
    line-height: 1;
    padding: 22px 20px;
    border: none;
  }
  .menu-drawer__navigation .menu-drawer__menu ul.list-menu > li > a {
    font-size: 18px;
    font-weight: bold;
    padding: 0px;
  }
  .menu-drawer__navigation .menu-drawer__menu ul.list-menu {
    padding: 0px 20px 14px 20px;
  }
  .menu-drawer__navigation .menu-drawer__menu ul.list-menu > li:not(:first-child) {
    margin-top: 12px;
  }
  .menu-drawer__navigation .menu-drawer__menu ul.list-menu > li > a {
    justify-content: flex-start;
    gap: 10px;
  }
  .menu-drawer__navigation .menu-drawer__menu ul.list-menu > li > a .menu-drawer__menu-item-arrow svg.icon {
    transform: rotate(0);
  } 
  .menu-drawer__navigation .menu-drawer__menu > li:not(:first-child) {
    border-top: 1px solid #00000066;
  }
  .menu-drawer__utility-links {
    display: none !important;
  }
  .menu-drawer__navigation .menu-drawer__menu ul.list-menu ul.menu-drawer__mobile-submenu {
    padding: 16px 0px 0px;
    row-gap: 20px;
  }
  .menu-drawer__navigation .menu-drawer__menu ul.list-menu ul.menu-drawer__mobile-submenu li {
    margin: 0px;
  }
  .menu-drawer__navigation .menu-drawer__menu ul.list-menu > li > a .menu-drawer__menu-item-arrow {
    right: 0px;
  }
  .menu-drawer__navigation .menu-drawer__menu ul.list-menu ul.menu-drawer__mobile-submenu a {
    text-transform: unset;
  }
  .menu-drawer__navigation .menu-drawer__menu ul.list-menu:not(.menu-drawer__mobile-submenu) > li > a.active{
    color: #00B4E5;
  }
  .menu-drawer__navigation .menu-drawer__menu ul.list-menu:not(.menu-drawer__mobile-submenu) > li > a.active svg.icon {
    transform: rotate(90deg);
  }
}
{%- endstyle -%}

<style>
  @media screen and (min-width: 750px) {
    #shopify-section-{{ section.id }} {
      --image-logo-height: {{ section.settings.logo_height }}px;
    }
  }

  {%- if enable_transparent_header -%}
    :root {
      --color-header-transparent: {{ section.settings.transparent_text_color.red }}, {{ section.settings.transparent_text_color.green }}, {{ section.settings.transparent_text_color.blue }};
    }
    #shopify-section-header:not(.shopify-section-header-sticky) .header-transparent .header::before {
      transform: translateY(-100%);
    }
  {%- endif -%}

  header-drawer {
    display: block;
  }

  @media screen and (min-width: 990px) {
    header-drawer {
      display: none;
    }
  }

  .menu-drawer-container {
    display: flex;
    position: static;
  }

  .list-menu {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .list-menu--inline {
    display: inline-flex;
    flex-wrap: wrap;
    column-gap: 1.5rem;
  }

  .list-menu__item--link {
    text-decoration: none;
    padding-bottom: 1rem;
    padding-top: 1rem;
    line-height: calc(1 + 0.8 / var(--font-body-scale));
  }

  @media screen and (min-width: 750px) {
    .list-menu__item--link {
      padding-bottom: 0.5rem;
      padding-top: 0.5rem;
    }
  }

  .localization-form {
    padding-inline-start: 1.5rem;
    padding-inline-end: 1.5rem;
  }

  localization-form .localization-selector {
    background-color: transparent;
    box-shadow: none;
    padding: 1rem 0;
    height: auto;
    margin: 0;
    line-height: calc(1 + .8 / var(--font-body-scale));
    letter-spacing: .04rem;
  }

  .localization-form__select .icon-caret {
    width: 0.8rem;
    margin-inline-start: 1rem;
  }
  .is-megamenu.show-images .list-mega-menu .mega-menu__item , .is-megamenu.show-images-without-promo .list-mega-menu .mega-menu__item {
    max-width: calc(25% - var(--grid-horizontal-spacing)) !important;
    width: calc(25% - var(--grid-horizontal-spacing)) !important;;
    flex: 1 1 25%; 
  }
  .is-megamenu .list-mega-menu {
    --grid-horizontal-spacing: 10px;  
  }  
  .is-megamenu .list-mega-menu .header__menu-item .submenu-title {
    font-size: 15px; font-weight: bold; letter-spacing: 1.8px; 
  }
  .header__inline-menu ul.list-menu > li .header__menu-item--top {
    padding-left: 10px; padding-right: 10px; 
  }
  /* Menu links that hop across the logo and sit next to the icons on narrower desktops */
  .header__inline-menu--beside-icons {
    display: none;
  }
  @media screen and (min-width: 990px) and (max-width: {{ section.settings.menu_links_beside_icons_below | minus: 1 }}px) {
    .header .header__inline-menu--beside-icons {
      display: flex;
      align-items: center;
      min-width: 0;
      margin-inline-start: 0;
      margin-inline-end: 0.5rem;
      text-align: start;
    }
    .header__inline-menu--beside-icons .list-menu--inline {
      flex-wrap: nowrap;
      align-items: center;
      column-gap: 0;
    }
    .header__inline-menu--beside-icons .header__menu-item--top {
      white-space: nowrap;
    }
    .header__inline-menu .header__menu-item--beside-icons {
      display: none;
    }
  }
</style>

