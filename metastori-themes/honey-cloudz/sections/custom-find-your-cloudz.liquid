<div class="fyc" id="FindYourCloudz">
  <div class="fyc__inner">
    {%- if section.settings.heading != blank -%}
      <{{ section.settings.heading_tag }} class="fyc__heading">
        {{ section.settings.heading | escape }}
      </{{ section.settings.heading_tag }}>
    {%- endif -%}
    {% if template.suffix == 'post-op-new' %}
      <div class="fyc__heading-subheading">
        <p>Choose a category to find your best match.</p>
      </div>
    {% endif %}
    {%- if has_tabs -%}
      {%- liquid
        assign has_any_tab_content = false
        assign default_tab_id = tab_blocks.first.id
        assign default_tab_has_content = false
        for block in tab_blocks
          if block.settings.tab_content != blank
            assign has_any_tab_content = true
            if block.id == default_tab_id
              assign default_tab_has_content = true
            endif
          endif
        endfor
      -%}
      <div class="fyc__tab-shell{% if default_tab_has_content %} fyc__tab-shell--content-open{% endif %}">
        <ul class="fyc__tabs" role="tablist" aria-label="{{ section.settings.tabs_aria_label | escape }}">
          {%- for block in tab_blocks -%}
            <li class="fyc__tab" role="presentation" {{ block.shopify_attributes }}>
              <button
                type="button"
                class="fyc__tab-btn{% if forloop.first %} is-active{% endif %}"
                role="tab"
                id="fyc-tab-{{ section.id }}-{{ block.id }}"
                {% if block.settings.tab_content != blank %}
                  aria-controls="fyc-content-{{ section.id }}-{{ block.id }}"
                {% endif %}
                aria-selected="{% if forloop.first %}true{% else %}false{% endif %}"
                data-fyc-tab="{{ block.id }}"
                data-fyc-tab-slug="{{ block.settings.tab_label | handleize }}"
                data-fyc-has-content="{% if block.settings.tab_content != blank %}true{% else %}false{% endif %}"
              >
                {{ block.settings.tab_label | escape }}
              </button>
            </li>
          {%- endfor -%}
        </ul>

        {%- if has_any_tab_content -%}
          <div class="fyc__tab-content-area{% if default_tab_has_content %} is-open{% endif %}">
            {%- for block in tab_blocks -%}
              {%- assign tab_content = block.settings.tab_content -%}
              {%- if tab_content != blank -%}
                <div
                  class="fyc__panel-content rte"
                  id="fyc-content-{{ section.id }}-{{ block.id }}"
                  role="tabpanel"
                  aria-labelledby="fyc-tab-{{ section.id }}-{{ block.id }}"
                  data-fyc-content="{{ block.id }}"
                  {% unless block.id == default_tab_id %}
                    hidden
                  {% endunless %}
                >
                  {{ tab_content }}
                </div>
              {%- endif -%}
            {%- endfor -%}
          </div>
        {%- endif -%}
      </div>

      {%- for block in tab_blocks -%}
        {%- assign tab_products = block.settings.products -%}
        <div
          class="fyc__panel"
          id="fyc-panel-{{ section.id }}-{{ block.id }}"
          data-fyc-panel="{{ block.id }}"
          {% unless forloop.first %}
            hidden
          {% endunless %}
        >
          {%- if tab_products != blank and tab_products.size > 0 -%}
            {%- liquid
              assign grid_scroll_classes = 'fyc__grid'
              if section.settings.horizontal_scroll_tablet
                assign grid_scroll_classes = grid_scroll_classes | append: ' fyc__grid--scroll-tablet'
              endif
              if section.settings.horizontal_scroll_desktop
                assign grid_scroll_classes = grid_scroll_classes | append: ' fyc__grid--scroll-desktop'
              endif
            -%}
            <div class="fyc__grid-wrap">
              <ul class="{{ grid_scroll_classes }}" role="list">
                {%- for product in tab_products -%}
                  <li>
                    {% render 'find-cloudz-product-card',
                      card_product: product,
                      metafield_namespace: section.settings.metafield_namespace,
                      shaping_level_key: section.settings.shaping_level_key,
                      shape_key: section.settings.shape_key,
                      product_tags_key: section.settings.product_tags_key,
                      why_love_key: section.settings.why_love_key,
                      wear_with_key: section.settings.wear_with_key,
                      testimonial_quote_key: section.settings.testimonial_quote_key,
                      testimonial_author_key: section.settings.testimonial_author_key,
                      shaping_label: section.settings.shaping_level_label,
                      shaping_info_label: section.settings.shaping_info_button_label,
                      why_love_label: section.settings.why_love_label,
                      wear_with_label: section.settings.wear_with_label,
                      button_prefix: section.settings.button_prefix
                    %}
                  </li>
                {%- endfor -%}
              </ul>
            </div>
          {%- endif -%}
        </div>
      {%- endfor -%}
    {%- endif -%}
  </div>

  {%- if section.settings.shaping_popup_title != blank or section.settings.shaping_popup_content != blank -%}
    <div
      id="fyc-shaping-popup-{{ section.id }}"
      class="fyc-shaping-popup"
      data-fyc-shaping-popup
      hidden
      aria-hidden="true"
    >
      <div class="fyc-shaping-popup__backdrop" data-fyc-shaping-popup-close></div>
      <div
        class="fyc-shaping-popup__dialog"
        role="dialog"
        aria-modal="true"
        aria-labelledby="fyc-shaping-popup-title-{{ section.id }}"
      >
        <div class="fyc-shaping-popup__header">
          {%- if section.settings.shaping_popup_title != blank -%}
            <h3 class="fyc-shaping-popup__title" id="fyc-shaping-popup-title-{{ section.id }}">
              {{ section.settings.shaping_popup_title | escape }}
            </h3>
          {%- endif -%}
          <button
            type="button"
            class="fyc-shaping-popup__close"
            data-fyc-shaping-popup-close
            aria-label="{{ section.settings.shaping_popup_close_label | escape }}"
          >
            &times;
          </button>
        </div>
        {%- if section.settings.shaping_popup_content != blank -%}
          <div class="fyc-shaping-popup__body">
            <div class="fyc-shaping-popup__content rte">
              {{ section.settings.shaping_popup_content }}
            </div>
          </div>
        {%- endif -%}
      </div>
    </div>
  {%- endif -%}
</div>

<script>
  (function () {
    var root = document.getElementById('FindYourCloudz');
    if (!root || root.dataset.fycBound === '1') return;
    root.dataset.fycBound = '1';

    var tabs = root.querySelectorAll('[data-fyc-tab]');
    var panels = root.querySelectorAll('[data-fyc-panel]');
    var contents = root.querySelectorAll('[data-fyc-content]');
    var tabShell = root.querySelector('.fyc__tab-shell');
    var contentArea = root.querySelector('.fyc__tab-content-area');
    var sectionAnchor = 'FindYourCloudz-{{ section.id }}';
    if (!tabs.length) return;

    function setContentAreaOpen(isOpen) {
      if (!contentArea) return;
      contentArea.classList.toggle('is-open', isOpen);
      if (tabShell) {
        tabShell.classList.toggle('fyc__tab-shell--content-open', isOpen);
      }
    }

    function activate(tabId) {
      var activeHasContent = false;

      tabs.forEach(function (btn) {
        var isActive = btn.getAttribute('data-fyc-tab') === tabId;
        btn.classList.toggle('is-active', isActive);
        btn.setAttribute('aria-selected', isActive ? 'true' : 'false');
        if (isActive && btn.getAttribute('data-fyc-has-content') === 'true') {
          activeHasContent = true;
        }
      });
      contents.forEach(function (content) {
        var show = content.getAttribute('data-fyc-content') === tabId;
        if (show) {
          content.removeAttribute('hidden');
        } else {
          content.setAttribute('hidden', '');
        }
      });
      panels.forEach(function (panel) {
        var show = panel.getAttribute('data-fyc-panel') === tabId;
        if (show) {
          panel.removeAttribute('hidden');
        } else {
          panel.setAttribute('hidden', '');
        }
      });

      setContentAreaOpen(activeHasContent);
    }

    function activateBySlug(slug) {
      if (!slug) return false;
      var target = root.querySelector('[data-fyc-tab-slug="' + slug + '"]');
      if (!target) return false;
      activate(target.getAttribute('data-fyc-tab'));
      return true;
    }

    function parseTabSlug(hash) {
      if (!hash) return null;
      var simple = hash.match(/^fyc-([a-z0-9-]+)$/);
      if (simple) return simple[1];
      if (hash.indexOf('FindYourCloudz-') === 0) {
        var compound = hash.match(/--([a-z][a-z0-9-]*)$/);
        if (compound) return compound[1];
      }
      return null;
    }

    function isSectionHash(hash) {
      if (!hash) return false;
      if (hash === sectionAnchor) return true;
      if (hash.indexOf('FindYourCloudz-') === 0) return true;
      return !!parseTabSlug(hash);
    }

    function handleDeepLink(hash, shouldScroll) {
      hash = (hash || '').replace(/^#/, '');
      if (!isSectionHash(hash)) return false;

      var slug = parseTabSlug(hash);

      if (shouldScroll) {
        root.scrollIntoView({ behavior: 'smooth', block: 'start' });
      }

      if (slug && activateBySlug(slug)) return true;
      if (!slug && (hash === sectionAnchor || hash.indexOf('FindYourCloudz-') === 0)) {
        activate(tabs[0].getAttribute('data-fyc-tab'));
        return true;
      }
      return false;
    }

    window.__fycSections = window.__fycSections || [];
    window.__fycSections.push({ handleDeepLink: handleDeepLink });

    if (!window.__fycDeepLinkInit) {
      window.__fycDeepLinkInit = true;

      function routeDeepLink(shouldScroll) {
        var hash = (window.location.hash || '').replace(/^#/, '');
        var sections = window.__fycSections || [];
        for (var i = 0; i < sections.length; i++) {
          if (sections[i].handleDeepLink(hash, shouldScroll)) return;
        }
      }

      window.addEventListener('hashchange', function () {
        routeDeepLink(true);
      });

      document.addEventListener('click', function (event) {
        var link = event.target.closest('a[href^="#fyc-"], a[href^="#FindYourCloudz-"]');
        if (!link) return;
        window.requestAnimationFrame(function () {
          routeDeepLink(true);
        });
      });
    }

    tabs.forEach(function (btn) {
      btn.addEventListener('click', function () {
        var tabId = btn.getAttribute('data-fyc-tab');
        var slug = btn.getAttribute('data-fyc-tab-slug');
        activate(tabId);
        if (slug) {
          try {
            history.replaceState(null, '', '#fyc-' + slug);
          } catch (e) {}
        }
      });
    });

    handleDeepLink(window.location.hash, !!parseTabSlug((window.location.hash || '').replace(/^#/, '')));
  })();
</script>

{%- if section.settings.shaping_popup_title != blank or section.settings.shaping_popup_content != blank -%}
  <script>
    (function () {
      var sectionEl = document.getElementById('shopify-section-{{ section.id }}');
      if (!sectionEl || sectionEl.dataset.fycPopupBound === '1') return;
      sectionEl.dataset.fycPopupBound = '1';

      var popup = document.getElementById('fyc-shaping-popup-{{ section.id }}');
      var triggers = sectionEl.querySelectorAll('[data-fyc-shaping-info]');
      if (!popup || !triggers.length) return;

      if (popup.parentElement !== document.body) {
        document.body.appendChild(popup);
      }

      var closeEls = popup.querySelectorAll('[data-fyc-shaping-popup-close]');
      var lastFocus = null;

      function openPopup() {
        lastFocus = document.activeElement;
        popup.hidden = false;
        popup.setAttribute('aria-hidden', 'false');
        document.body.style.overflow = 'hidden';
        var closeBtn = popup.querySelector('.fyc-shaping-popup__close');
        if (closeBtn) closeBtn.focus();
      }

      function closePopup() {
        popup.hidden = true;
        popup.setAttribute('aria-hidden', 'true');
        document.body.style.overflow = '';
        if (lastFocus && typeof lastFocus.focus === 'function') {
          lastFocus.focus();
        }
      }

      triggers.forEach(function (btn) {
        btn.addEventListener('click', function (event) {
          event.preventDefault();
          event.stopPropagation();
          openPopup();
        });
      });

      closeEls.forEach(function (el) {
        el.addEventListener('click', closePopup);
      });

      popup.addEventListener('click', function (event) {
        var dialog = popup.querySelector('.fyc-shaping-popup__dialog');
        if (dialog && !dialog.contains(event.target)) {
          closePopup();
        }
      });

      document.addEventListener('keydown', function (event) {
        if (event.key === 'Escape' && !popup.hidden) {
          closePopup();
        }
      });
    })();
  </script>
{%- endif -%}

