{%- liquid
  assign tab_blocks = section.blocks | where: 'type', 'tab'
  assign has_tabs = false
  if tab_blocks.size > 0
    assign has_tabs = true
  endif
-%}

{%- style -%}
  #shopify-section-{{ section.id }} .fyc {
    --fyc-bg: {{ section.settings.background_color }};
    --fyc-heading-color: {{ section.settings.heading_color }};
    --fyc-tab-bg: {{ section.settings.tab_bar_background }};
    --fyc-tab-text: {{ section.settings.tab_text_color }};
    --fyc-tab-active-bg: {{ section.settings.tab_active_background }};
    --fyc-tab-active-text: {{ section.settings.tab_active_text_color }};
    --fyc-content-bg: {{ section.settings.tab_content_background }};
    --fyc-content-text: {{ section.settings.tab_content_text_color }};
    --fyc-card-bg: {{ section.settings.card_background }};
    --fyc-card-border: {{ section.settings.card_border_color }};
    --fyc-card-radius: {{ section.settings.card_border_radius }}px;
    --fyc-media-bg: {{ section.settings.card_image_background }};
    --fyc-shaping-bg: {{ section.settings.shaping_bar_background }};
    --fyc-shaping-text: {{ section.settings.shaping_bar_text_color }};
    --fyc-label-color: {{ section.settings.meta_label_color }};
    --fyc-body-text: {{ section.settings.card_text_color }};
    --fyc-title-color: {{ section.settings.card_title_color }};
    --fyc-btn-bg: {{ section.settings.button_background }};
    --fyc-btn-text: {{ section.settings.button_text_color }};
    --fyc-testimonial-bg: {{ section.settings.testimonial_background }};
    --fyc-testimonial-text: {{ section.settings.testimonial_text_color }};
    --fyc-tag-bg: {{ section.settings.badge_background }};
    --fyc-tag-text: {{ section.settings.badge_text_color }};
    --fyc-max-width: {{ section.settings.content_max_width }}px;
    --fyc-heading-size: {{ section.settings.heading_font_size_mobile }}px;
    --fyc-heading-weight: {{ section.settings.heading_font_weight }};
    --fyc-tab-size: {{ section.settings.tab_font_size_mobile }}px;
    --fyc-content-size: {{ section.settings.tab_content_font_size_mobile }}px;
    --fyc-title-size: {{ section.settings.card_title_font_size_mobile }}px;
    --fyc-meta-label-size: {{ section.settings.meta_label_font_size_mobile }}px;
    --fyc-meta-text-size: {{ section.settings.meta_text_font_size_mobile }}px;
    --fyc-btn-size: {{ section.settings.button_font_size_mobile }}px;
    --fyc-quote-size: {{ section.settings.testimonial_font_size_mobile }}px;
    --fyc-author-size: {{ section.settings.testimonial_author_font_size_mobile }}px;
    --fyc-padding-top: {{ section.settings.padding_top_mobile }}px;
    --fyc-padding-bottom: {{ section.settings.padding_bottom_mobile }}px;
    --fyc-heading-gap: {{ section.settings.heading_spacing_mobile }}px;
    --fyc-tab-gap: {{ section.settings.tab_spacing_mobile }}px;
    --fyc-content-gap: {{ section.settings.tab_content_spacing_mobile }}px;
    --fyc-tab-shell-padding: {{ section.settings.tab_shell_padding_mobile }}px;
    --fyc-tab-shell-radius: {{ section.settings.tab_shell_border_radius }}px;
    --fyc-tab-shell-border: {{ section.settings.tab_shell_border_color }};
    --fyc-grid-gap: {{ section.settings.grid_gap_mobile }}px;
    --fyc-card-padding: {{ section.settings.card_padding_mobile }}px;
    --fyc-card-body-gap: {{ section.settings.card_body_gap_mobile }}px;
    --fyc-meta-gap: {{ section.settings.meta_block_gap_mobile }}px;
    --fyc-btn-padding-y: {{ section.settings.button_padding_y_mobile }}px;
    --fyc-btn-padding-x: {{ section.settings.button_padding_x_mobile }}px;
    --fyc-columns: {{ section.settings.columns_mobile }};
    background-color: var(--fyc-bg);
    padding: var(--fyc-padding-top) 0 var(--fyc-padding-bottom);
    color: var(--fyc-body-text);
  }

  @media screen and (min-width: 750px) {
    #shopify-section-{{ section.id }} .fyc {
      --fyc-heading-size: {{ section.settings.heading_font_size_tablet }}px;
      --fyc-tab-size: {{ section.settings.tab_font_size_tablet }}px;
      --fyc-content-size: {{ section.settings.tab_content_font_size_tablet }}px;
      --fyc-title-size: {{ section.settings.card_title_font_size_tablet }}px;
      --fyc-meta-label-size: {{ section.settings.meta_label_font_size_tablet }}px;
      --fyc-meta-text-size: {{ section.settings.meta_text_font_size_tablet }}px;
      --fyc-btn-size: {{ section.settings.button_font_size_tablet }}px;
      --fyc-quote-size: {{ section.settings.testimonial_font_size_tablet }}px;
      --fyc-author-size: {{ section.settings.testimonial_author_font_size_tablet }}px;
      --fyc-padding-top: {{ section.settings.padding_top_tablet }}px;
      --fyc-padding-bottom: {{ section.settings.padding_bottom_tablet }}px;
      --fyc-heading-gap: {{ section.settings.heading_spacing_tablet }}px;
      --fyc-tab-gap: {{ section.settings.tab_spacing_tablet }}px;
      --fyc-content-gap: {{ section.settings.tab_content_spacing_tablet }}px;
      --fyc-tab-shell-padding: {{ section.settings.tab_shell_padding_tablet }}px;
      --fyc-grid-gap: {{ section.settings.grid_gap_tablet }}px;
      --fyc-card-padding: {{ section.settings.card_padding_tablet }}px;
      --fyc-card-body-gap: {{ section.settings.card_body_gap_tablet }}px;
      --fyc-meta-gap: {{ section.settings.meta_block_gap_tablet }}px;
      --fyc-btn-padding-y: {{ section.settings.button_padding_y_tablet }}px;
      --fyc-btn-padding-x: {{ section.settings.button_padding_x_tablet }}px;
      --fyc-columns: {{ section.settings.columns_tablet }};
    }
  }

  @media screen and (min-width: 990px) {
    #shopify-section-{{ section.id }} .fyc {
      --fyc-heading-size: {{ section.settings.heading_font_size_desktop }}px;
      --fyc-tab-size: {{ section.settings.tab_font_size_desktop }}px;
      --fyc-content-size: {{ section.settings.tab_content_font_size_desktop }}px;
      --fyc-title-size: {{ section.settings.card_title_font_size_desktop }}px;
      --fyc-meta-label-size: {{ section.settings.meta_label_font_size_desktop }}px;
      --fyc-meta-text-size: {{ section.settings.meta_text_font_size_desktop }}px;
      --fyc-btn-size: {{ section.settings.button_font_size_desktop }}px;
      --fyc-quote-size: {{ section.settings.testimonial_font_size_desktop }}px;
      --fyc-author-size: {{ section.settings.testimonial_author_font_size_desktop }}px;
      --fyc-padding-top: {{ section.settings.padding_top_desktop }}px;
      --fyc-padding-bottom: {{ section.settings.padding_bottom_desktop }}px;
      --fyc-heading-gap: {{ section.settings.heading_spacing_desktop }}px;
      --fyc-tab-gap: {{ section.settings.tab_spacing_desktop }}px;
      --fyc-content-gap: {{ section.settings.tab_content_spacing_desktop }}px;
      --fyc-tab-shell-padding: {{ section.settings.tab_shell_padding_desktop }}px;
      --fyc-grid-gap: {{ section.settings.grid_gap_desktop }}px;
      --fyc-card-padding: {{ section.settings.card_padding_desktop }}px;
      --fyc-card-body-gap: {{ section.settings.card_body_gap_desktop }}px;
      --fyc-meta-gap: {{ section.settings.meta_block_gap_desktop }}px;
      --fyc-btn-padding-y: {{ section.settings.button_padding_y_desktop }}px;
      --fyc-btn-padding-x: {{ section.settings.button_padding_x_desktop }}px;
      --fyc-columns: {{ section.settings.columns_desktop }};
    }
  }

  #shopify-section-{{ section.id }} .fyc__inner {
    max-width: var(--fyc-max-width);
    margin: 0 auto;
    padding-inline: 6.5rem;
  }

  #shopify-section-{{ section.id }} .fyc__heading {
    margin: 0 0 var(--fyc-heading-gap);
    text-align: center;
    color: var(--fyc-heading-color);
    font-size: var(--fyc-heading-size);
    font-weight: var(--fyc-heading-weight);
    line-height: 1.15;
  }

  #shopify-section-{{ section.id }} .fyc__tab-shell {
    margin-bottom: var(--fyc-tab-gap);
    padding: var(--fyc-tab-shell-padding);
    background: var(--fyc-content-bg);
    border: 1px solid var(--fyc-tab-shell-border);
    border-radius: var(--fyc-tab-shell-radius);
    overflow: hidden;
  }

  #shopify-section-{{ section.id }} .fyc__tab-shell:not(.fyc__tab-shell--content-open) {
    padding-bottom: calc(var(--fyc-tab-shell-padding) * 0.72);
  }

  #shopify-section-{{ section.id }} .fyc__tabs {
    display: flex;
    flex-wrap: wrap;
    justify-content:center;
    align-items: center;
    gap: 9.0rem;
    padding: 0;
    margin: 0;
    list-style: none;
    background: transparent;
    border: 0;
    box-shadow: none;
  }

  #shopify-section-{{ section.id }} .fyc__tab {
    margin: 0;
    flex: 1 1 auto;
    text-align: center;
  }

  #shopify-section-{{ section.id }} .fyc__tab-btn {
    appearance: none;
    border: 0;
    background: transparent;
    color: var(--fyc-tab-text);
    font: inherit;
    font-size: var(--fyc-tab-size);
    font-weight: {{ section.settings.tab_font_weight }};
    line-height: 1.2;
    padding: 0.7rem 3.0rem;
    border-radius: 999px;
    cursor: pointer;
    transition: background-color 0.2s ease, color 0.2s ease;
    white-space: nowrap;
    text-decoration: none;
  }

  #shopify-section-{{ section.id }} .fyc__tab-btn.is-active,
  #shopify-section-{{ section.id }} .fyc__tab-btn[aria-selected="true"] {
    background: var(--fyc-tab-active-bg);
    color: var(--fyc-tab-active-text);
    text-decoration: underline;
    text-underline-offset: 0.2em;
    text-decoration-thickness: 1px;
  }

  #shopify-section-{{ section.id }} .fyc__tab-content-area {
    display: none;
    margin: 0;
    padding: 0;
  }

  #shopify-section-{{ section.id }} .fyc__tab-content-area.is-open {
    display: block;
    padding-top: var(--fyc-content-gap);
  }

  #shopify-section-{{ section.id }} .fyc__tab-content-area:empty {
    display: none !important;
    padding: 0 !important;
  }

  #shopify-section-{{ section.id }} .fyc__panel-content[hidden] {
    display: none !important;
  }

  #shopify-section-{{ section.id }} .fyc__panel-content {
    margin: 0;
    padding: 0 1.1rem;
    background: transparent;
    border-radius: 0;
    color: var(--fyc-content-text);
    font-size: var(--fyc-content-size);
    line-height: 1.55;
    text-align: left;
  }
  .custom-post-op-new #shopify-section-{{ section.id }} .fyc__panel-content{
    text-align: center;
  }
  #shopify-section-{{ section.id }} .fyc__panel-content a {
    color: inherit;
    text-decoration: underline;
    text-underline-offset: 0.15em;
  }

  #shopify-section-{{ section.id }} .fyc__panel-content p {
    margin: 0 0 0.85rem;
  }

  #shopify-section-{{ section.id }} .fyc__panel-content p:last-child {
    margin-bottom: 0;
  }

  #shopify-section-{{ section.id }} .fyc__panel-content ul {
    margin: 0.5rem 0 0;
    padding-left: 1.25rem;
  }

  #shopify-section-{{ section.id }} .fyc__panel[hidden] {
    display: none !important;
  }

  #shopify-section-{{ section.id }} .fyc__grid-wrap {
    position: relative;
  }

  #shopify-section-{{ section.id }} .fyc__grid {
    display: grid;
    grid-template-columns: repeat(var(--fyc-columns), minmax(0, 1fr));
    gap: var(--fyc-grid-gap);
    list-style: none;
    margin: 0;
    padding: 0;
  }
  
  @media screen and (min-width: 750px) {
    #shopify-section-{{ section.id }} .fyc__grid--scroll-tablet {
      grid-auto-flow: column;
      grid-template-columns: unset;
      grid-auto-columns: minmax(
        0,
        calc((100% - (var(--fyc-columns) - 1) * var(--fyc-grid-gap)) / var(--fyc-columns))
      );
      overflow-x: auto;
      overflow-y: hidden;
      scroll-snap-type: x proximity;
      -webkit-overflow-scrolling: touch;
      scrollbar-width: thin;
      padding-bottom: 0.35rem;
    }

    #shopify-section-{{ section.id }} .fyc__grid--scroll-tablet > li {
      scroll-snap-align: start;
      min-width: 0;
    }
  }

  @media screen and (min-width: 990px) {
    #shopify-section-{{ section.id }} .fyc__grid--scroll-desktop {
      grid-auto-flow: column;
      grid-template-columns: unset;
      grid-auto-columns: minmax(
        0,
        calc((100% - (var(--fyc-columns) - 1) * var(--fyc-grid-gap)) / var(--fyc-columns))
      );
      overflow-x: auto;
      overflow-y: hidden;
      scroll-snap-type: x proximity;
      -webkit-overflow-scrolling: touch;
      scrollbar-width: thin;
      padding-bottom: 0.35rem;
    }

    #shopify-section-{{ section.id }} .fyc__grid--scroll-desktop > li {
      scroll-snap-align: start;
      min-width: 0;
    }

    #shopify-section-{{ section.id }} .fyc__grid--scroll-desktop.fyc__grid--scroll-tablet {
      overflow-x: auto;
    }
  }

  #shopify-section-{{ section.id }} .fyc-card {
    display: flex;
    flex-direction: column;
    height: 100%;
    background: var(--fyc-card-bg);
    border: 1px solid var(--fyc-card-border);
    border-radius: var(--fyc-card-radius);
    overflow: hidden;
    padding:2.0rem;
  }

  #shopify-section-{{ section.id }} .fyc-card__media-link {
    display: block;
    text-decoration: none;
  }

  #shopify-section-{{ section.id }} .fyc-card__media {
    position: relative;
    background: var(--fyc-media-bg);
    padding: 0;
    min-height: 180px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 10px 10px 0 0;
  }

  #shopify-section-{{ section.id }} .fyc-card__image {
    width: 100%;
    max-height: 250px;
    height: 100%;
    object-fit: cover;
    display: block;
    margin: 0 auto;
    overflow: hidden;
    border-radius: 10px 10px 0 0;
  }

  #shopify-section-{{ section.id }} .fyc-card__image--placeholder {
    opacity: 0.35;
  }

  #shopify-section-{{ section.id }} .fyc-card__shape-icon {
    position: absolute;
        bottom: 11px;
    left: 9px;
    z-index: 2;
    width: 20px;
    line-height: 0;
    pointer-events: none;
  }

  #shopify-section-{{ section.id }} .fyc-card__shape-icon svg {
    display: block;
    width: 100%;
    height: auto;
  }

  #shopify-section-{{ section.id }} .fyc-card__tags {
    position: absolute;
        top: 16px;
    right: 13px;
    z-index: 3;
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 0.35rem;
    pointer-events: none;
  }

  #shopify-section-{{ section.id }} .fyc-card__tag {
    display: block;
      padding: 0.47rem 1rem;
    font-size: 2.2rem;
    font-weight: 600;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--fyc-tag-text);
    background: var(--fyc-tag-bg);
    border-radius: 999px;
    line-height: 1.15;
  }

  #shopify-section-{{ section.id }} .fyc-card__shaping-bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0;
    width: 100%;
    margin: 0;
    padding: 0.5rem 1.2rem;
    border: 0;
    appearance: none;
    -webkit-appearance: none;
    font: inherit;
    letter-spacing: inherit;
    text-align: inherit;
    background: var(--fyc-shaping-bg);
    color: var(--fyc-shaping-text);
        border-radius: 0 0 10px 10px;
    cursor: pointer;
  }

  #shopify-section-{{ section.id }} .fyc-card__shaping-bar:focus-visible {
    outline: 2px solid #ffffff;
    outline-offset: 2px;
  }

  #shopify-section-{{ section.id }} .fyc-card__shaping-label {
    display: inline-flex;
    align-items: center;
    gap: 1.0rem;
    font-size: 1.4rem !important;
    font-weight: 600;
    letter-spacing: 0.02em;
    white-space: nowrap;
  }

  #shopify-section-{{ section.id }} .fyc-card__shaping-icon {
    flex-shrink: 0;
  }

  #shopify-section-{{ section.id }} .fyc-card__shaping-squares {
    display: flex;
    align-items: center;
    gap: 5px;
  }

  #shopify-section-{{ section.id }} .fyc-card__shaping-square {
        width: 12px;
    height: 20px;
    border-radius:3px;
    background: rgb(255 255 255 / 0%);
    border: 1px solid;
  }

  #shopify-section-{{ section.id }} .fyc-card__shaping-square.is-active {
    background: #ffffff;
  }

  #shopify-section-{{ section.id }} .fyc-card__body {
    flex: 1 1 auto;
    display: flex;
    flex-direction: column;
    gap: var(--fyc-card-body-gap);
    padding: 20px 0px;
  }

  #shopify-section-{{ section.id }} .fyc-card__title {
    margin: 0;
    font-size: var(--fyc-title-size);
    font-weight: {{ section.settings.card_title_font_weight }};
    line-height: 1.25;
    color: var(--fyc-title-color);
  }

  #shopify-section-{{ section.id }} .fyc-card__title a {
    color: inherit;
    text-decoration: none;
  }

  #shopify-section-{{ section.id }} .fyc-card__meta-block {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }

  #shopify-section-{{ section.id }} .fyc-card__meta-block + .fyc-card__meta-block {
    margin-top: calc(var(--fyc-meta-gap) - var(--fyc-card-body-gap));
  }

  #shopify-section-{{ section.id }} .fyc-card__meta-label {
    margin: 0;
    font-size: 1.4rem !important;
    font-weight: {{ section.settings.meta_label_font_weight }};
    color: var(--fyc-label-color);
    line-height: 1.3;
  }

  #shopify-section-{{ section.id }} .fyc-card__meta-text {
    margin: 0;
    font-size: 1.4rem !important;
    line-height: 1.45;
    color: var(--fyc-body-text);
  }

  #shopify-section-{{ section.id }} .fyc-card__meta-text p {
    margin: 0;
  }

  #shopify-section-{{ section.id }} .fyc-card__button {
    display: flex;
    align-items: center;
    justify-content: center;
    margin-top: auto;
    padding: var(--fyc-btn-padding-y) var(--fyc-btn-padding-x);
    background: var(--fyc-btn-bg);
    color: var(--fyc-btn-text);
    border-radius: 999px;
    font-size: 1.2rem !important;
    font-weight: {{ section.settings.button_font_weight }};
    line-height: 1.25;
    text-align: center;
    text-decoration: none;
    transition: opacity 0.2s ease;
    text-transform: capitalize;
  }

  #shopify-section-{{ section.id }} .fyc-card__button:hover {
    opacity: 0.88;
  }

  #shopify-section-{{ section.id }} .fyc-card__testimonial {
    margin-top: auto;
    padding: 1.5rem var(--fyc-card-padding) 1.5rem;
    background: var(--fyc-testimonial-bg);
    color: var(--fyc-testimonial-text);
    text-align: center;
    border-radius: 10px;
  }

  #shopify-section-{{ section.id }} .fyc-card__quote {
    margin: 0 0 1.0rem;
    font-size: 1.4rem !important;
    font-style: italic;
    line-height: 1.45;
  }

  #shopify-section-{{ section.id }} .fyc-card__author {
    margin: 0;
    font-size: var(--fyc-author-size);
    font-weight: 600;
    line-height: 1.3;
  }

  #shopify-section-{{ section.id }} .fyc-card__shaping-info {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    margin: 0;
    padding: 0;
    border: 0;
    background: transparent;
    color: inherit;
    line-height: 0;
    flex-shrink: 0;
    width: 16px;
    height: 16px;
    pointer-events: none;
  }

  #fyc-shaping-popup-{{ section.id }} {
    position: fixed;
    inset: 0;
    z-index: 10001;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 1.5rem;
    background: rgba(33, 35, 38, 0.55);
    cursor: url({{ 'cross.svg' | asset_url }}), zoom-out;
  }

  #fyc-shaping-popup-{{ section.id }}[hidden] {
    display: none !important;
  }

  #fyc-shaping-popup-{{ section.id }} .fyc-shaping-popup__backdrop {
    position: absolute;
    inset: 0;
    z-index: 0;
    cursor: url({{ 'cross.svg' | asset_url }}), zoom-out;
  }
  .custom-post-op-new #shopify-section-{{ section.id }} .fyc__heading{
    margin-bottom:0px;
  }
  .custom-post-op-new #shopify-section-{{ section.id }} .fyc__heading-subheading{
    text-align: center;
    
  }
  .custom-post-op-new #shopify-section-{{ section.id }} .fyc__heading-subheading p{
    font-weight: 500;
    line-height: 1.2;
    margin-top: 5px;
    margin-bottom: 34px;
  }

  #fyc-shaping-popup-{{ section.id }} .fyc-shaping-popup__dialog {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    width: min(100%, 82rem);
    max-height: min(85vh, 520px);
    overflow: hidden;
    margin: 0;
    padding: 0;
    background: {{ section.settings.shaping_popup_background }};
    color: {{ section.settings.shaping_popup_text_color }};
    border-radius: {{ section.settings.shaping_popup_border_radius }}px;
    box-shadow: 0 18px 48px rgba(33, 35, 38, 0.18);
    cursor: auto;
  }

  #fyc-shaping-popup-{{ section.id }} .fyc-shaping-popup__header {
    position: relative;
    flex-shrink: 0;
    padding: 2.4rem 4.5rem 1.2rem 2rem;
  }

  #fyc-shaping-popup-{{ section.id }} .fyc-shaping-popup__body {
    flex: 1 1 auto;
    min-height: 0;
    overflow-y: auto;
    padding: 0 2rem 2rem;
  }
  /* #fyc-shaping-popup-{{ section.id }} .fyc-shaping-popup__dialog{
    scrollbar-width: thin;
    scrollbar-color: {{ section.settings.shaping_popup_text_color }} #f3f3f3;
  } */
  #fyc-shaping-popup-{{ section.id }} .fyc-shaping-popup__title {
    margin: 0;
    font-size: {{ section.settings.shaping_popup_title_size }}px;
    font-weight: 700;
    line-height: 1.2;
    color: {{ section.settings.shaping_popup_text_color }};
  }

