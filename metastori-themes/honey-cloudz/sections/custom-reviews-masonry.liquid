{%- liquid
  assign desktop_cols = section.settings.columns_desktop
  assign initial_rows = section.settings.initial_visible_rows | default: 1
  assign initial_count = desktop_cols | times: initial_rows
  assign load_more_count = section.settings.load_more_count
  assign total_reviews = section.blocks.size

  if section.settings.use_theme_page_width == false
    assign use_theme_width = false
  else
    assign use_theme_width = true
  endif

  assign has_more_reviews = false
  if total_reviews > initial_count
    assign has_more_reviews = true
  endif
  assign show_fade = false
  if section.settings.enable_bottom_fade and has_more_reviews
    assign show_fade = true
  endif
  assign collapsed_max = section.settings.collapsed_max_height | times: initial_rows
  assign fade_overlap = section.settings.fade_height | times: 90 | divided_by: 100
-%}

{%- style -%}
      #shopify-section-{{ section.id }} .ccr {
        --ccr-bg: {{ section.settings.background_color }};
        --ccr-card-bg: {{ section.settings.card_background }};
        --ccr-card-radius: {{ section.settings.card_border_radius }}px;
        --ccr-card-shadow: {{ section.settings.card_shadow }};
        --ccr-card-padding: {{ section.settings.card_padding }}px;
        --ccr-star-color: {{ section.settings.star_color }};
        --ccr-headline-color: {{ section.settings.headline_color }};
        --ccr-text-color: {{ section.settings.text_color }};
        --ccr-highlight-color: {{ section.settings.highlight_color }};
        --ccr-name-color: {{ section.settings.name_color }};
        --ccr-verified-color: {{ section.settings.verified_color }};
        --ccr-link-color: {{ section.settings.show_more_color }};
        --ccr-column-gap: {{ section.settings.column_gap }}px;
        --ccr-columns-desktop: {{ section.settings.columns_desktop }};
        --ccr-columns-tablet: {{ section.settings.columns_tablet }};
        --ccr-columns-mobile: {{ section.settings.columns_mobile }};
        --ccr-fade-height: {{ section.settings.fade_height }}px;
        --ccr-fade-overlap: {{ fade_overlap }}px;
        --ccr-collapsed-max: {{ collapsed_max }}px;
        --ccr-expand-duration: {{ section.settings.expand_duration }}ms;
        --ccr-col-2-offset: {{ section.settings.column_2_offset }}px;
        background-color: var(--ccr-bg);
        padding: {{ section.settings.padding_top }}px 0 {{ section.settings.padding_bottom }}px;
        overflow-x: clip;
      }

      {% unless use_theme_width %}
      #shopify-section-{{ section.id }} .ccr__page-width {
        max-width: {{ section.settings.section_max_width }}px;
        margin: 0 auto;
        padding-inline: 1.5rem;
      }
      {% endunless %}

      #shopify-section-{{ section.id }} .ccr__page-width {
        width: 100%;
        box-sizing: border-box;
      }

      #shopify-section-{{ section.id }} .ccr__viewport {
        position: relative;
        overflow: hidden;
        transition: max-height var(--ccr-expand-duration) cubic-bezier(0.4, 0, 0.2, 1);
      }

      #shopify-section-{{ section.id }} .ccr__viewport--clipped {
        max-height: var(--ccr-collapsed-max);
      }

      #shopify-section-{{ section.id }} .ccr__viewport--clipped .ccr__columns {
        overflow: hidden;
      }

      #shopify-section-{{ section.id }} .ccr__footer-area {
        position: relative;
        z-index: 3;
        margin-top: calc(-1 * var(--ccr-fade-overlap));
      }

      #shopify-section-{{ section.id }} .ccr__footer-area--no-fade {
        margin-top: 0;
      }

      #shopify-section-{{ section.id }} .ccr__footer-area--no-fade .ccr__footer {
        margin-top: {{ section.settings.show_more_spacing }}px;
      }

      #shopify-section-{{ section.id }} .ccr__footer-area--hidden {
        display: none;
      }

      #shopify-section-{{ section.id }} .ccr__fade {
        position: absolute;
        left: 0;
        right: 0;
        bottom: 100%;
        height: var(--ccr-fade-height);
        background: linear-gradient(0deg, var(--ccr-bg) 0%, rgba(255, 255, 255, 0) 100%);
        pointer-events: none;
        z-index: 1;
        transition: opacity 0.35s ease, visibility 0.35s ease;
      }

      #shopify-section-{{ section.id }} .ccr__fade--hidden {
        opacity: 0;
        visibility: hidden;
      }

      #shopify-section-{{ section.id }} .ccr__columns {
        display: flex;
        align-items: flex-start;
        gap: var(--ccr-column-gap);
        width: 100%;
      }

      #shopify-section-{{ section.id }} .ccr__column {
        flex: 1 1 0;
        min-width: 0;
        display: flex;
        flex-direction: column;
        gap: var(--ccr-column-gap);
      }

      @media screen and (min-width: 990px) {
        #shopify-section-{{ section.id }} .ccr__column--2 {
          margin-top: var(--ccr-col-2-offset);
        }
      }

      @media screen and (max-width: 989px) {
        #shopify-section-{{ section.id }} .ccr__columns {
          display: grid;
          grid-template-columns: repeat(var(--ccr-columns-tablet), minmax(0, 1fr));
        }

        #shopify-section-{{ section.id }} .ccr__column {
          display: contents;
        }

        #shopify-section-{{ section.id }} .ccr__column--2 {
          margin-top: 0;
        }
      }

      @media screen and (max-width: 1200px) {
        #shopify-section-{{ section.id }} .ccr__columns {
          grid-template-columns: repeat(var(--ccr-columns-mobile), minmax(0, 1fr));
        }
      }

      #shopify-section-{{ section.id }} .ccr__card {
        position: relative;
        overflow: hidden;
        width: 100%;
        min-width: 0;
        margin: 0;
        padding: var(--ccr-card-padding);
        border-radius: var(--ccr-card-radius);
        background-color: var(--ccr-card-bg);
        box-shadow: var(--ccr-card-shadow);
        box-sizing: border-box;
        text-align: center;
        display: flex;
        flex-direction: column;
        align-items: center;
      }

      #shopify-section-{{ section.id }} .ccr__card-inner {
        position: relative;
        z-index: 2;
        width: 100%;
        display: flex;
        flex-direction: column;
        align-items: center;
      }

      #shopify-section-{{ section.id }} .ccr__card.ccr__card--hidden {
        display: none;
      }

      #shopify-section-{{ section.id }} .ccr__card.ccr__card--revealing {
        display: flex;
        animation: ccr-card-reveal 0.5s cubic-bezier(0.4, 0, 0.2, 1) forwards;
      }

      @keyframes ccr-card-reveal {
        from {
          opacity: 0;
          transform: translateY(20px);
        }
        to {
          opacity: 1;
          transform: translateY(0);
        }
      }

      #shopify-section-{{ section.id }} .ccr__stars {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 0.15rem;
        margin: 0 0 {{ section.settings.stars_spacing }}px;
        color: var(--ccr-star-color);
      }

      #shopify-section-{{ section.id }} .ccr__stars svg {
        width: {{ section.settings.star_size }}px;
        height: {{ section.settings.star_size }}px;
        display: block;
        flex: 0 0 {{ section.settings.star_size }}px;
      }

      #shopify-section-{{ section.id }} .ccr__headline {
        margin: 0 0 {{ section.settings.headline_spacing }}px;
        color: var(--ccr-headline-color);
        font-size: {{ section.settings.headline_font_size }}px;
        line-height: 1.3;
        font-weight: {{ section.settings.headline_font_weight }};
        font-style: {{ section.settings.headline_font_style }};
        letter-spacing: -0.01em;
      }

      #shopify-section-{{ section.id }} .ccr__text {
        margin: 0 0 {{ section.settings.text_spacing }}px;
        color: var(--ccr-text-color);
        font-size: {{ section.settings.text_font_size }}px;
        line-height: {{ section.settings.text_line_height }}%;
        font-weight: {{ section.settings.text_font_weight }};
        font-style: {{ section.settings.text_font_style }};
        max-width: 100%;
      }

      #shopify-section-{{ section.id }} .ccr__text p {
        margin: 0 0 1rem;
      }

      #shopify-section-{{ section.id }} .ccr__text p:last-child {
        margin-bottom: 0;
      }

      #shopify-section-{{ section.id }} .ccr__text strong,
      #shopify-section-{{ section.id }} .ccr__text b,
      #shopify-section-{{ section.id }} .ccr__text em,
      #shopify-section-{{ section.id }} .ccr__text em strong,
      #shopify-section-{{ section.id }} .ccr__text mark {
        color: var(--ccr-highlight-color);
        font-weight: {{ section.settings.highlight_font_weight }};
        background: none;
      }

      #shopify-section-{{ section.id }} .ccr__text em {
        font-style: italic;
      }

      #shopify-section-{{ section.id }} .ccr__name {
        margin: 0 0 {{ section.settings.name_spacing }}px;
        color: var(--ccr-name-color);
        font-size: {{ section.settings.name_font_size }}px;
        line-height: 1.3;
        font-weight: {{ section.settings.name_font_weight }};
        letter-spacing: -0.01em;
      }

      #shopify-section-{{ section.id }} .ccr__verified {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 0.35rem;
        margin: 0;
        color: var(--ccr-verified-color);
        font-size: {{ section.settings.verified_font_size }}px;
        line-height: 1.2;
        font-weight: {{ section.settings.verified_font_weight }};
        opacity: 0.9;
      }

      #shopify-section-{{ section.id }} .ccr__verified svg {
        width: {{ section.settings.verified_icon_size }}px;
        height: {{ section.settings.verified_icon_size }}px;
        flex: 0 0 {{ section.settings.verified_icon_size }}px;
        display: block;
      }

      #shopify-section-{{ section.id }} .ccr__footer {
        position: relative;
        z-index: 2;
        margin-top: {{ section.settings.show_more_spacing }}px;
        text-align: center;
      }

      #shopify-section-{{ section.id }} .ccr__show-more {
        display: inline-block;
        padding: 0;
        border: 0;
        background: none;
        color: var(--ccr-link-color);
        font-size: {{ section.settings.show_more_font_size }}px;
        font-weight: {{ section.settings.show_more_font_weight }};
        line-height: 1.3;
        text-decoration: underline;
        text-underline-offset: 0.2em;
        cursor: pointer;
      }

      #shopify-section-{{ section.id }} .ccr__show-more:hover {
        opacity: 0.8;
      }

      #shopify-section-{{ section.id }} .ccr__show-more.ccr__show-more--hidden {
        display: none;
      }

      @media screen and (max-width: 749px) {
        #shopify-section-{{ section.id }} .ccr__card {
          order: var(--ccr-order);
        }

        #shopify-section-{{ section.id }} .ccr__headline {
          font-size: {{ section.settings.headline_font_size_mobile }}px;
        }

        #shopify-section-{{ section.id }} .ccr__text {
          font-size: {{ section.settings.text_font_size_mobile }}px;
        }

        #shopify-section-{{ section.id }} .ccr__card {
          padding: calc(var(--ccr-card-padding) * 0.85);
        }
      }
      #shopify-section-{{ section.id }} .ccr__viewport--clipped {
      max-height: var(--ccr-collapsed-max);

      -webkit-mask-image: linear-gradient(
        to bottom,
        rgba(0,0,0,1) 70%,
        rgba(0,0,0,0) 100%
      );

      mask-image: linear-gradient(
        to bottom,
        rgba(0,0,0,1) 70%,
        rgba(0,0,0,0) 100%
      );
    }
    .ccr__fade--hidden {
    opacity: 0;
    visibility: hidden;
  }
  @media screen and (max-width: 1200px) {
    #shopify-section-{{ section.id }} .ccr {
      padding-top: 0;
    }
  }
{%- endstyle -%}

<div
  class="ccr"
  data-ccr-root
  data-initial="{{ initial_count }}"
  data-initial-rows="{{ initial_rows }}"
  data-desktop-cols="{{ desktop_cols }}"
  data-load-more="{{ load_more_count }}"
  data-total="{{ total_reviews }}"
  data-enable-fade="{{ section.settings.enable_bottom_fade }}"
>
  <div class="ccr__page-width{% if use_theme_width %} page-width{% endif %}">
    <div class="ccr__viewport{% if show_fade %} ccr__viewport--clipped{% endif %}" data-ccr-viewport>
      <div class="ccr__columns">
        {%- for col_index in (0..2) -%}
          {%- if col_index < desktop_cols -%}
            <div class="ccr__column ccr__column--{{ col_index | plus: 1 }}">
              {%- assign col_card_index = 0 -%}
              {%- for block in section.blocks -%}
                {%- liquid
                  assign card_index = forloop.index0
                  assign card_col = card_index | modulo: desktop_cols
                -%}
                {%- if card_col == col_index -%}
                  {%- liquid
                    assign rating = block.settings.rating | default: 5
                    assign is_hidden = false
                    if card_index >= initial_count
                      assign is_hidden = true
                    endif

                    assign featured_class = ''
                    if col_index == 1 and col_card_index == 0
                      assign featured_class = 'ccr__card--featured'
                    endif
                    assign col_card_index = col_card_index | plus: 1
                  -%}
                  <article
                    class="ccr__card {{ featured_class }}{% if is_hidden %} ccr__card--hidden{% endif %}"
                    data-ccr-card
                    data-index="{{ card_index }}"
                    style="--ccr-order: {{ card_index }};"
                    {{ block.shopify_attributes }}
                  >
                    <div class="ccr__card-inner">
                      {%- if rating > 0 -%}
                        <div class="ccr__stars" aria-label="{{ rating }} out of 5 stars">
                          {%- for i in (1..5) -%}
                            <svg
                              viewBox="0 0 16 16"
                              xmlns="http://www.w3.org/2000/svg"
                              aria-hidden="true"
                              {% if i <= rating %}
                                fill="currentColor"
                              {% else %}
                                fill="none" stroke="currentColor" stroke-width="1.2"
                              {% endif %}
                            >
                              <path d="M8 1.2L9.9 5.8L14.8 6.1L11.1 9.2L12.2 14.1L8 11.6L3.8 14.1L4.9 9.2L1.2 6.1L6.1 5.8L8 1.2Z"/>
                            </svg>
                          {%- endfor -%}
                        </div>
                      {%- endif -%}

                      {%- if block.settings.headline != blank -%}
                        <h3 class="ccr__headline">&ldquo;{{ block.settings.headline | escape }}&rdquo;</h3>
                      {%- endif -%}

                      {%- if block.settings.text != blank -%}
                        <div class="ccr__text rte">{{ block.settings.text }}</div>
                      {%- endif -%}

                      {%- if block.settings.author != blank -%}
                        <p class="ccr__name">&ndash;{{ block.settings.author | escape }}</p>
                      {%- endif -%}

                      {%- if block.settings.show_verified -%}
                        <p class="ccr__verified">
                          <svg
                            xmlns="http://www.w3.org/2000/svg"
                            width="16"
                            height="16"
                            viewBox="0 0 16 16"
                            fill="none"
                          >
                            <path d="M7.81235 0.976562C6.46036 0.976562 5.13873 1.37747 4.01459 2.1286C2.89045 2.87973 2.01429 3.94733 1.49691 5.19641C0.979524 6.44548 0.844153 7.81993 1.10791 9.14594C1.37167 10.472 2.02272 11.69 2.97872 12.646C3.93472 13.602 5.15274 14.253 6.47876 14.5168C7.80477 14.7805 9.17922 14.6452 10.4283 14.1278C11.6774 13.6104 12.745 12.7342 13.4961 11.6101C14.2472 10.486 14.6481 9.16434 14.6481 7.81235C14.6481 5.99939 13.9279 4.26068 12.646 2.97872C11.364 1.69676 9.62532 0.976563 7.81235 0.976562ZM6.83581 10.5418L4.39446 8.10043L5.17081 7.32408L6.83581 8.98908L10.4539 5.371L11.2332 6.14539L6.83581 10.5418Z" fill="black"/>
                          </svg>
                          <span>{{ section.settings.verified_label | escape }}</span>
                        </p>
                      {%- endif -%}
                    </div>
                  </article>
                {%- endif -%}
              {%- endfor -%}
            </div>
          {%- endif -%}
        {%- endfor -%}
      </div>
    </div>

    {%- if has_more_reviews -%}
      <div class="ccr__footer-area{% unless show_fade %} ccr__footer-area--no-fade{% endunless %}" data-ccr-footer-area>
        {%- if show_fade -%}
          <div class="ccr__fade" data-ccr-fade aria-hidden="true"></div>
        {%- endif -%}
        <div class="ccr__footer">
          <button type="button" class="ccr__show-more" data-ccr-show-more>
            {{ section.settings.show_more_label | escape }}
          </button>
        </div>
      </div>
    {%- endif -%}
  </div>
</div>

<script>
      {% comment %} (function () {
        const root = document.querySelector('#shopify-section-{{ section.id }} [data-ccr-root]');
        if (!root || root.dataset.ccrInit === 'true') return;
        root.dataset.ccrInit = 'true';

        const cards = Array.from(root.querySelectorAll('[data-ccr-card]')).sort(
          (a, b) => parseInt(a.dataset.index, 10) - parseInt(b.dataset.index, 10)
        );
        const button = root.querySelector('[data-ccr-show-more]');
        const viewport = root.querySelector('[data-ccr-viewport]');
        const fade = root.querySelector('[data-ccr-fade]');
        const footerArea = root.querySelector('[data-ccr-footer-area]');
        const columns = root.querySelector('.ccr__columns');
        const initial = parseInt(root.dataset.initial, 10) || 0;
        const loadMore = parseInt(root.dataset.loadMore, 10) || 0;
        const total = parseInt(root.dataset.total, 10) || cards.length;
        const enableFade = root.dataset.enableFade === 'true';
        const expandDuration = parseInt(getComputedStyle(root).getPropertyValue('--ccr-expand-duration'), 10) || 600;

        let visibleCount = Math.min(initial, total);
        let expanded = false;
        let isAnimating = false;

        function getFullHeight() {
          if (!columns) return 0;
          const prevMax = viewport.style.maxHeight;
          viewport.style.maxHeight = 'none';
          viewport.classList.remove('ccr__viewport--clipped');
          const height = columns.scrollHeight;
          viewport.classList.toggle('ccr__viewport--clipped', !expanded && total > initial);
          viewport.style.maxHeight = prevMax;
          return height;
        }

        function updateUI() {
          const shouldClip = !expanded && total > initial;
          const buttonVisible = visibleCount < total;

          if (button) {
            button.classList.toggle('ccr__show-more--hidden', !buttonVisible);
          }

          if (footerArea) {
            footerArea.classList.toggle('ccr__footer-area--hidden', !buttonVisible);
          }

          if (viewport) {
            if (!isAnimating) {
              viewport.classList.toggle('ccr__viewport--clipped', shouldClip);
              if (shouldClip) {
                viewport.style.maxHeight = '';
              }
            }
            viewport.classList.toggle('ccr__viewport--expanded', expanded);
          }

          if (fade) {
            const showFadeOverlay = enableFade && shouldClip && buttonVisible;
            fade.classList.toggle('ccr__fade--hidden', !showFadeOverlay);
          }

        }

        function animateExpand(callback) {
          if (!viewport || !columns || isAnimating) return;
          isAnimating = true;

          const startHeight = viewport.offsetHeight;
          const endHeight = getFullHeight();

          viewport.style.maxHeight = startHeight + 'px';
          viewport.classList.remove('ccr__viewport--clipped');
          if (fade) fade.classList.add('ccr__fade--hidden');

          requestAnimationFrame(function () {
            requestAnimationFrame(function () {
              viewport.style.maxHeight = endHeight + 'px';
            });
          });

          window.setTimeout(function () {
            viewport.style.maxHeight = 'none';
            expanded = true;
            isAnimating = false;
            if (callback) callback();
            updateUI();
          }, expandDuration);
        }

        function revealCards(fromIndex, toIndex) {
          for (let i = fromIndex; i < toIndex; i += 1) {
            const card = cards.find(function (item) {
              return parseInt(item.dataset.index, 10) === i;
            });
            if (!card) continue;
            card.classList.remove('ccr__card--hidden');
            card.classList.add('ccr__card--revealing');
            card.addEventListener(
              'animationend',
              function () {
                card.classList.remove('ccr__card--revealing');
              },
              { once: true }
            );
          }
        }

        function revealNext() {
          if (isAnimating) return;

          const nextCount = Math.min(visibleCount + loadMore, total);
          const hasHiddenCards = nextCount > visibleCount;

          if (!expanded && total > initial) {
            revealCards(visibleCount, nextCount);
            visibleCount = nextCount;
            animateExpand(function () {
              updateUI();
            });
            return;
          }

          if (hasHiddenCards) {
            revealCards(visibleCount, nextCount);
            visibleCount = nextCount;
            updateUI();
          }
        }

        if (button) {
          button.addEventListener('click', revealNext);
        }
        updateUI();

        document.addEventListener('shopify:section:load', function (event) {
          if (event.detail.sectionId === '{{ section.id }}') {
            root.dataset.ccrInit = 'false';
          }
        });
      })(); {% endcomment %}
      (function () {
