{%- liquid
  assign tabs = section.blocks
  assign default_tab_index = 0
  assign render_all_panels = false
  if request.design_mode or section.index == nil
    assign render_all_panels = true
  endif
-%}

<link rel="stylesheet" href="{{ 'component-slider.css' | asset_url }}" media="print" onload="this.media='all'">
<link rel="stylesheet" href="{{ 'component-price.css' | asset_url }}" media="print" onload="this.media='all'">
<noscript>{{ 'component-slider.css' | asset_url | stylesheet_tag }}</noscript>
<noscript>{{ 'component-price.css' | asset_url | stylesheet_tag }}</noscript>

{{ 'component-product-grid.css' | asset_url | stylesheet_tag }}
{{ 'component-card.css' | asset_url | stylesheet_tag }}

{%- style -%}
  #shopify-section-{{ section.id }} {
    --section-padding-top: {{ section.settings.padding_top }}px;
    --section-padding-bottom: {{ section.settings.padding_bottom }}px;
    --hc-bestsellers-bg: {{ section.settings.background_color }};
  }

  .hc-bestsellers {
    display: block;
    padding-top: calc(var(--section-padding-top) * 0.75);
    padding-bottom: calc(var(--section-padding-bottom) * 0.75);
    background: var(--hc-bestsellers-bg);
  }

  @media screen and (min-width: 750px) {
    .hc-bestsellers {
      padding-top: var(--section-padding-top);
      padding-bottom: var(--section-padding-bottom);
    }
  }

  .hc-bestsellers__header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.6rem;
    margin-bottom: 2.2rem;
  }

  .hc-bestsellers__left {
    display: inline-flex;
    align-items: baseline;
    gap: 2rem;
    flex-wrap: wrap;
    min-width: 0;
  }

  .hc-bestsellers__title {
    margin: 0;
  }

  .hc-bestsellers__controls {
    display: flex;
    align-items: center;
    gap: 1.2rem;
    flex-wrap: wrap;
  }

  .hc-bestsellers__select {
    appearance: none;
    -webkit-appearance: none;
    border: 0;
    background: transparent;
    font-family: "Send Flowers", cursive;
    font-size: 3rem;
    line-height: 1;
    padding: 0 2.4rem 0.2rem 0;
    border-bottom: 1px solid rgba(0, 0, 0, 0.45);
    cursor: pointer;
  }

  .hc-bestsellers__select-wrap {
    position: relative;
    display: inline-flex;
    align-items: baseline;
  }

  .hc-bestsellers__select-wrap svg {
    position: absolute;
    right: 0.2rem;
    width: 14px;
    height: 14px;
    pointer-events: none;
    opacity: 0.8;
  }

  .hc-bestsellers__view-all {
    white-space: nowrap;
  }

  .hc-bestsellers__view-all.hc-bestsellers__view-all--link {
    background: transparent;
    border: 0;
    box-shadow: none;
    min-width: auto;
    min-height: auto;
    padding: 0;
    text-transform: none;
    letter-spacing: 0;
  }

  @media screen and (hover: hover) {
    .hc-bestsellers__view-all.hc-bestsellers__view-all--link:hover {
      background: transparent;
      box-shadow: none;
    }
  }

  .hc-bestsellers__panel[hidden] {
    display: none !important;
  }
  .hc-bestsellers__status {
    margin: 0 0 1.6rem;
  }

  .hc-bestsellers__retry {
    margin-inline-start: 0.8rem;
  }
{%- endstyle -%}

<hc-bestsellers
  class="hc-bestsellers"
  data-section-id="{{ section.id }}"
  data-loading-message="{{ 'accessibility.loading' | t | escape }}"
  data-error-message="{{ 'sections.homepage_bestsellers.load_error' | t | escape }}"
>
  <div class="page-width">
    <div class="hc-bestsellers__header">
      <div class="hc-bestsellers__left">
        <h2 class="hc-bestsellers__title {{ section.settings.heading_size }}">{{ section.settings.heading | escape }}</h2>

        {%- if tabs.size > 0 -%}
          <div class="hc-bestsellers__select-wrap">
            <select class="hc-bestsellers__select" data-hc-bestsellers-select aria-label="{{ section.settings.dropdown_aria_label | escape }}">
              {%- for block in tabs -%}
                <option value="{{ forloop.index0 }}" {% if forloop.index0 == default_tab_index %}selected{% endif %}>
                  {{ block.settings.label | escape }}
                </option>
              {%- endfor -%}
            </select>
            <svg viewBox="0 0 16 16" aria-hidden="true" focusable="false">
              <path d="M4 6l4 4 4-4" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"></path>
            </svg>
          </div>
        {%- endif -%}
      </div>

      <div class="hc-bestsellers__controls">
        {%- if section.settings.view_all_label != blank and section.settings.view_all_link != blank -%}
          <a class="hc-bestsellers__view-all hc-bestsellers__view-all--link link" href="{{ section.settings.view_all_link }}">
            {{ section.settings.view_all_label | escape }}
          </a>
        {%- endif -%}
      </div>
    </div>

    <p class="hc-bestsellers__status" data-hc-bestsellers-status role="status" hidden>
      <span data-hc-bestsellers-message></span>
      <button type="button" class="link hc-bestsellers__retry" data-hc-bestsellers-retry hidden>
        {{ 'sections.homepage_bestsellers.retry' | t }}
      </button>
    </p>

    <div data-hc-bestsellers-panels>
    {%- for block in tabs -%}
      {%- liquid
        assign render_panel = render_all_panels
        if forloop.index0 == default_tab_index
          assign render_panel = true
        endif
      -%}
      <div
        class="hc-bestsellers__panel"
        data-hc-bestsellers-panel="{{ forloop.index0 }}"
        data-hc-bestsellers-loaded="{{ render_panel }}"
        {% if forloop.index0 != default_tab_index %}hidden{% endif %}
        {{ block.shopify_attributes }}
      >
        {%- if render_panel -%}
        {%- assign products = block.settings.products -%}
        <slider-component class="slider-mobile-gutter">
          <ul
            class="product-grid grid grid--2-col grid--2-col-tablet grid--4-col-desktop slider slider--tablet"
            role="list"
            id="Slider-{{ section.id }}-{{ forloop.index0 }}"
          >
            {%- if products != blank and products.size > 0 -%}
              {%- for product in products -%}
                <li class="grid__item slider__slide">
                  {% render 'card-product',
                    card_product: product,
                    card_collection: nil,
                    media_size: section.settings.image_ratio,
                    show_secondary_image: section.settings.show_secondary_image,
                    show_quick_buy: section.settings.show_quick_buy,
                    show_vendor: section.settings.show_vendor,
                    show_rating: section.settings.show_rating,
                    enable_quick_view: section.settings.enable_quick_view,
                    enable_color_swatches: section.settings.enable_color_swatches,
                    enable_countdown: section.settings.enable_countdown,
                    enable_image_fill: section.settings.enable_image_fill,
                    homepage_bestseller: true,
                    lazy_load: true
                  %}
                </li>
              {%- endfor -%}
            {%- else -%}
              {%- for i in (1..4) -%}
                <li class="grid__item slider__slide">
                  {% render 'card-product-placeholder', media_size: section.settings.image_ratio %}
                </li>
              {%- endfor -%}
            {%- endif -%}
          </ul>
        </slider-component>
        {%- endif -%}
      </div>
    {%- endfor -%}
    </div>
  </div>
</hc-bestsellers>

{% javascript %}
if (!customElements.get('hc-bestsellers')) {
  customElements.define('hc-bestsellers', class extends HTMLElement {
    connectedCallback() {
      if (this.initialized) return;
      this.select = this.querySelector('[data-hc-bestsellers-select]');
      if (!this.select) return;
      this.initialized = true;
      this.panels = new Map(Array.from(this.querySelectorAll('[data-hc-bestsellers-panel]'),
        panel => [panel.dataset.hcBestsellersPanel, panel]));
      this.region = this.querySelector('[data-hc-bestsellers-panels]');
      this.status = this.querySelector('[data-hc-bestsellers-status]');
      this.message = this.querySelector('[data-hc-bestsellers-message]');
      this.retry = this.querySelector('[data-hc-bestsellers-retry]');
      this.activeIndex = this.select.value;
      this.select.addEventListener('change', () => this.choose(this.select.value));
      this.retry.addEventListener('click', () => {
        this.select.value = this.retryIndex;
        this.choose(this.retryIndex);
      });
      this.addEventListener('shopify:block:select', event => {
        const panel = event.target.closest('[data-hc-bestsellers-panel]');
        if (panel && this.contains(panel)) {
          this.select.value = panel.dataset.hcBestsellersPanel;
          this.choose(this.select.value);
        }
      });
    }

    disconnectedCallback() {
      this.controller?.abort();
      this.pending = null;
    }

    show(index) {
      this.panels.forEach((panel, panelIndex) => { panel.hidden = panelIndex !== index; });
      this.activeIndex = index;
      this.region.removeAttribute('aria-busy');
      this.status.hidden = true;
    }

    async fetchPanels() {
      const url = new URL(window.location.href);
      url.hash = '';
      url.searchParams.delete('sections');
      url.searchParams.set('section_id', this.dataset.sectionId);
      this.controller = new AbortController();
      const timeout = setTimeout(() => this.controller.abort(), 15000);
      try {
        const response = await fetch(url, {
          credentials: 'same-origin',
          headers: { Accept: 'text/html' },
          signal: this.controller.signal
        });
        if (!response.ok) throw new Error('Unable to load product groups');
        const template = document.createElement('template');
        template.innerHTML = await response.text();
        const section = template.content.querySelector('hc-bestsellers');
        if (section?.dataset.sectionId !== this.dataset.sectionId) {
          throw new Error('Product groups response did not match this section');
        }
        const panels = new Map(Array.from(section.querySelectorAll('[data-hc-bestsellers-panel]'),
          panel => [panel.dataset.hcBestsellersPanel, panel]));
        for (const index of this.panels.keys()) {
          if (panels.get(index)?.dataset.hcBestsellersLoaded !== 'true') {
            throw new Error('Product group was not rendered');
          }
        }
        return panels;
      } finally {
        clearTimeout(timeout);
      }
    }

    async choose(index) {
      const panel = this.panels.get(index);
      if (!panel) return;
      const selection = (this.selection || 0) + 1;
      this.selection = selection;
      if (panel.dataset.hcBestsellersLoaded === 'true') {
        this.show(index);
        return;
      }
      this.region.setAttribute('aria-busy', 'true');
      this.message.textContent = this.dataset.loadingMessage;
      this.retry.hidden = true;
      this.status.hidden = false;
      try {
        if (!this.pending) {
          this.pending = this.fetchPanels().catch(error => {
            this.pending = null;
            throw error;
          });
        }
        const panels = await this.pending;
        if (!this.isConnected || this.selection !== selection) return;
        const replacement = panels.get(index).cloneNode(true);
        const scripts = Array.from(replacement.querySelectorAll('script'), script => {
          const marker = document.createElement('template');
          script.replaceWith(marker);
          return { script, marker };
        });
        panel.replaceWith(replacement);
        this.panels.set(index, replacement);
        this.show(index);
        scripts.forEach(({ script, marker }) => {
          const executable = document.createElement('script');
          for (const attribute of script.attributes) {
            executable.setAttribute(attribute.name, attribute.value);
          }
          executable.textContent = script.textContent;
          marker.replaceWith(executable);
        });
      } catch {
        if (!this.isConnected || this.selection !== selection) return;
        this.region.removeAttribute('aria-busy');
        this.message.textContent = this.dataset.errorMessage;
        this.retryIndex = index;
        this.select.value = this.activeIndex;
        this.retry.hidden = false;
        this.status.hidden = false;
      }
    }
  });
}
{% endjavascript %}

{% schema %}
{
  "name": "Homepage bestsellers",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "default": "#f6efe9"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Honey Cloudz"
    },
    {
      "type": "select",
      "id": "heading_size",
      "label": "Heading size",
      "options": [
        { "value": "h2", "label": "Small" },
        { "value": "h1", "label": "Medium" },
        { "value": "h0", "label": "Large" }
      ],
      "default": "h2"
    },
    {
      "type": "text",
      "id": "dropdown_aria_label",
      "label": "Dropdown accessibility label",
      "default": "Choose a product group"
    },
    {
      "type": "text",
      "id": "view_all_label",
      "label": "View all label",
      "default": "View All Products →"
    },
    {
      "type": "url",
      "id": "view_all_link",
      "label": "View all link"
    },
    {
      "type": "header",
      "content": "Product cards"
    },
    {
      "type": "select",
      "id": "image_ratio",
      "label": "Image ratio",
      "options": [
        { "value": "adapt", "label": "Adapt" },
        { "value": "square", "label": "Square" },
        { "value": "portrait", "label": "Portrait" }
      ],
      "default": "square"
    },
    {
      "type": "checkbox",
      "id": "show_secondary_image",
      "label": "Show secondary image",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_quick_buy",
      "label": "Show quick buy",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_vendor",
      "label": "Show vendor",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "show_rating",
      "label": "Show rating",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "enable_quick_view",
      "label": "Enable quick view",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "enable_color_swatches",
      "label": "Enable color swatches",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "enable_countdown",
      "label": "Enable countdown",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "enable_image_fill",
      "label": "Enable image fill",
      "default": true
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Padding top",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Padding bottom",
      "default": 36
    }
  ],
  "blocks": [
    {
      "type": "group",
      "name": "Dropdown item",
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Dropdown label",
          "default": "Bestsellers"
        },
        {
          "type": "product_list",
          "id": "products",
          "label": "Products",
          "limit": 12
        }
      ]
    }
  ],
  "max_blocks": 12,
  "presets": [
    {
      "name": "Homepage bestsellers",
      "category": "Homepage",
      "blocks": [
        { "type": "group" }
      ]
    }
  ]
}
{% endschema %}
