{%- liquid
  assign tabs = section.blocks | where: 'type', 'tab'
  assign steps = section.blocks | where: 'type', 'step'
  assign button_style = section.settings.button_style
  if button_style == blank
    assign button_style = 'solid'
  endif
-%}

{%- style -%}
  #shopify-section-{{ section.id }} .htw {
    --htw-heading-size: {{ section.settings.heading_font_size_desktop }}px;
    --htw-sub-size: {{ section.settings.subheading_font_size_desktop }}px;
    --htw-step-label-size: {{ section.settings.step_label_font_size_desktop }}px;
    --htw-step-text-size: {{ section.settings.step_text_font_size_desktop }}px;
    background-color: {{ section.settings.background_color }};
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }

  #shopify-section-{{ section.id }} .htw__inner {
    max-width: {{ section.settings.content_max_width }}px;
    margin: 0 auto;
    padding-inline: {{ section.settings.side_padding }}px;
    box-sizing: border-box;
  }

  #shopify-section-{{ section.id }} .htw__header {
    text-align: {{ section.settings.text_alignment }};
    margin: 0 auto {{ section.settings.header_spacing }}px;
    max-width: {{ section.settings.heading_max_width }}px;
  }

  #shopify-section-{{ section.id }} .htw__heading {
    margin: 0 0 {{ section.settings.heading_spacing }}px;
    color: {{ section.settings.heading_color }};
    font-size: var(--htw-heading-size);
    font-weight: {{ section.settings.heading_font_weight }};
    line-height: 1.15;
  }

  #shopify-section-{{ section.id }} .htw__subheading {
    margin: 0;
    color: {{ section.settings.subheading_color }};
    font-size: var(--htw-sub-size);
    font-weight: {{ section.settings.subheading_font_weight }};
    line-height: 1.4;
  }

  #shopify-section-{{ section.id }} .htw__tabs {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: {{ section.settings.tab_gap }}px;
    margin-bottom: {{ section.settings.tab_spacing }}px;
  }

  #shopify-section-{{ section.id }} .htw__tabs-wrap {
    margin-bottom: {{ section.settings.tab_spacing }}px;
  }

  #shopify-section-{{ section.id }} .htw__tabs-wrap .htw__tabs {
    margin-bottom: 0;
  }

  #shopify-section-{{ section.id }} .htw__tab {
    appearance: none;
    border: {{ section.settings.tab_border_width }}px solid {{ section.settings.tab_border_color }};
    background: {{ section.settings.tab_background }};
    color: {{ section.settings.tab_text_color }};
    border-radius: {{ section.settings.tab_radius }}px;
    min-height: {{ section.settings.tab_height }}px;
    padding: 0 {{ section.settings.tab_padding_x }}px;
    font-size: {{ section.settings.tab_font_size }}px;
    font-weight: {{ section.settings.tab_font_weight }};
    line-height: 1.2;
    cursor: pointer;
  }

  #shopify-section-{{ section.id }} .htw__tab.is-active {
    background: {{ section.settings.tab_active_background }};
    color: {{ section.settings.tab_active_text }};
    border-color: {{ section.settings.tab_active_background }};
  }

  #shopify-section-{{ section.id }} .htw__panel {
    display: none;
  }

  #shopify-section-{{ section.id }} .htw__panel.is-active {
    display: block;
  }

  #shopify-section-{{ section.id }} .htw__steps {
    display: grid;
    grid-template-columns: repeat({{ section.settings.columns_desktop }}, minmax(0, 1fr));
    gap: {{ section.settings.column_gap }}px;
  }

  #shopify-section-{{ section.id }} .htw__step {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  #shopify-section-{{ section.id }} .htw__media {
    width: 100%;
    aspect-ratio: {{ section.settings.media_ratio }};
    border-radius: {{ section.settings.media_radius }}px;
    overflow: hidden;
    background-color: {{ section.settings.media_placeholder }};
    margin-bottom: {{ section.settings.media_spacing }}px;
  }

  #shopify-section-{{ section.id }} .htw__media img,
  #shopify-section-{{ section.id }} .htw__media video {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  #shopify-section-{{ section.id }} .htw__label {
    display: inline-flex;
    align-items: center;
    gap: {{ section.settings.step_label_gap }}px;
    margin: 0 0 {{ section.settings.step_label_spacing }}px;
    color: {{ section.settings.step_label_color }};
    font-size: var(--htw-step-label-size);
    font-weight: {{ section.settings.step_label_font_weight }};
  }

  #shopify-section-{{ section.id }} .htw__num {
    width: {{ section.settings.step_circle_size }}px;
    height: {{ section.settings.step_circle_size }}px;
    border-radius: 50%;
    border: {{ section.settings.step_circle_border_width }}px solid {{ section.settings.step_circle_border_color }};
    display: inline-flex;
    align-items: center;
    justify-content: center;
    line-height: 1;
    flex: 0 0 auto;
  }

  #shopify-section-{{ section.id }} .htw__text {
    margin: 0;
    max-width: {{ section.settings.step_text_max_width }}px;
    color: {{ section.settings.step_text_color }};
    font-size: var(--htw-step-text-size);
    font-weight: {{ section.settings.step_text_font_weight }};
    line-height: {{ section.settings.step_text_line_height }}%;
  }

  #shopify-section-{{ section.id }} .htw__text p {
    margin: 0 0 0.7em;
  }

  #shopify-section-{{ section.id }} .htw__text p:last-child {
    margin-bottom: 0;
  }

  #shopify-section-{{ section.id }} .htw__footer {
    display: flex;
    justify-content: center;
    margin-top: {{ section.settings.button_spacing }}px;
  }

  #shopify-section-{{ section.id }} .htw__btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    box-sizing: border-box;
    min-height: {{ section.settings.button_min_height }}px;
    padding: {{ section.settings.button_padding_y }}px {{ section.settings.button_padding_x }}px;
    border-radius: {{ section.settings.button_radius }}px;
    font-size: {{ section.settings.button_font_size }}px;
    font-weight: {{ section.settings.button_font_weight }};
    text-decoration: none;
    transition: background-color 0.25s ease, color 0.25s ease, border-color 0.25s ease;
    cursor: pointer;
  }

  #shopify-section-{{ section.id }} .htw__btn--solid {
    background-color: {{ section.settings.button_background }};
    color: {{ section.settings.button_text_color }};
    border: {{ section.settings.button_border_width }}px solid {{ section.settings.button_background }};
  }

  #shopify-section-{{ section.id }} .htw__btn--solid:hover {
    background-color: transparent;
    color: {{ section.settings.button_background }};
  }

  #shopify-section-{{ section.id }} .htw__btn--outline {
    background-color: transparent;
    color: {{ section.settings.button_background }};
    border: {{ section.settings.button_border_width }}px solid {{ section.settings.button_background }};
  }

  #shopify-section-{{ section.id }} .htw__btn--outline:hover {
    background-color: {{ section.settings.button_background }};
    color: {{ section.settings.button_text_color }};
  }

  @media screen and (max-width: 989px) {
    #shopify-section-{{ section.id }} .htw {
      --htw-heading-size: {{ section.settings.heading_font_size_tablet }}px;
      --htw-sub-size: {{ section.settings.subheading_font_size_tablet }}px;
      --htw-step-label-size: {{ section.settings.step_label_font_size_tablet }}px;
      --htw-step-text-size: {{ section.settings.step_text_font_size_tablet }}px;
    }

    #shopify-section-{{ section.id }} .htw__steps {
      grid-template-columns: repeat({{ section.settings.columns_tablet }}, minmax(0, 1fr));
      gap: {{ section.settings.column_gap_tablet }}px;
    }
  }

  @media screen and (max-width: 749px) {
    #shopify-section-{{ section.id }} .htw {
      --htw-heading-size: {{ section.settings.heading_font_size_mobile }}px;
      --htw-sub-size: {{ section.settings.subheading_font_size_mobile }}px;
      --htw-step-label-size: {{ section.settings.step_label_font_size_mobile }}px;
      --htw-step-text-size: {{ section.settings.step_text_font_size_mobile }}px;
      padding-top: {{ section.settings.padding_top_mobile }}px;
      padding-bottom: {{ section.settings.padding_bottom_mobile }}px;
    }

    #shopify-section-{{ section.id }} .htw__inner {
      padding-inline: {{ section.settings.side_padding_mobile }}px;
    }

    {%- unless section.settings.mobile_tabs_layout == 'normal' -%}
      #shopify-section-{{ section.id }} .htw__tabs-wrap {
        position: relative;
        margin-right: calc(-1 * {{ section.settings.side_padding_mobile }}px);
      }

      #shopify-section-{{ section.id }} .htw__tabs {
        flex-wrap: nowrap;
        justify-content: flex-start;
        overflow-x: auto;
        -webkit-overflow-scrolling: touch;
        scrollbar-width: none;
        padding-bottom: 4px;
        padding-right: {{ section.settings.side_padding_mobile }}px;
      }

      #shopify-section-{{ section.id }} .htw__tabs::-webkit-scrollbar {
        display: none;
      }

      #shopify-section-{{ section.id }} .htw__tab {
        flex: 0 0 auto;
      }

      #shopify-section-{{ section.id }} .htw__tabs-wrap::after {
        content: '';
        position: absolute;
        top: 0;
        right: 0;
        bottom: 0;
        width: 28px;
        pointer-events: none;
        background: linear-gradient(
          to right,
          rgba(253, 247, 244, 0),
          {{ section.settings.background_color }}
        );
        z-index: 1;
      }
    {%- else -%}
      #shopify-section-{{ section.id }} .htw__tabs {
        justify-content: center;
        flex-wrap: wrap;
      }
    {%- endunless -%}

    #shopify-section-{{ section.id }} .htw__steps {
      grid-template-columns: 1fr;
      gap: {{ section.settings.column_gap_mobile }}px;
    }
  }
{%- endstyle -%}

<div class="htw" id="hc-how-to-wear">
  <div class="htw__inner">
    {%- if section.settings.heading != blank or section.settings.subheading != blank -%}
      <div class="htw__header">
        {%- if section.settings.heading != blank -%}
          <{{ section.settings.heading_tag }} class="htw__heading">{{ section.settings.heading | escape }}</{{ section.settings.heading_tag }}>
        {%- endif -%}
        {%- if section.settings.subheading != blank -%}
          <p class="htw__subheading">{{ section.settings.subheading | escape }}</p>
        {%- endif -%}
      </div>
    {%- endif -%}

    {%- if tabs.size > 0 -%}
      <div class="htw__tabs-wrap">
        <div class="htw__tabs" role="tablist">
          {%- for tab in tabs -%}
            <button
              type="button"
              class="htw__tab{% if forloop.first %} is-active{% endif %}"
              data-htw-tab="{{ tab.id }}"
              {%- liquid
                assign cta_prefix = section.settings.button_prefix | strip
                assign cta_suffix = section.settings.button_suffix | strip
                assign cta_middle = tab.settings.button_label | strip
                if cta_middle == blank and tab.settings.product != blank
                  assign cta_middle = tab.settings.product.title
                endif
                if cta_middle == blank
                  assign cta_middle = tab.settings.label | strip
                endif
                assign tab_cta_name = cta_prefix
                if tab_cta_name != blank and cta_middle != blank
                  assign tab_cta_name = tab_cta_name | append: ' ' | append: cta_middle
                elsif cta_middle != blank
                  assign tab_cta_name = cta_middle
                endif
                if cta_suffix != blank
                  if tab_cta_name != blank
                    assign tab_cta_name = tab_cta_name | append: ' ' | append: cta_suffix
                  else
                    assign tab_cta_name = cta_suffix
                  endif
                endif
                assign tab_cta_href = blank
                if tab.settings.product != blank
                  assign tab_cta_href = tab.settings.product.url
                elsif tab.settings.button_link != blank
                  assign tab_cta_href = tab.settings.button_link
                endif
              -%}
              data-htw-cta-label="{{ tab_cta_name | escape }}"
              data-htw-cta-href="{{ tab_cta_href }}"
              role="tab"
              aria-selected="{% if forloop.first %}true{% else %}false{% endif %}"
              {{ tab.shopify_attributes }}
            >
              {{ tab.settings.label | escape }}
            </button>
          {%- endfor -%}
        </div>
      </div>
    {%- endif -%}

    {%- for tab in tabs -%}
      {%- assign tab_key = tab.settings.label | strip | downcase -%}
      <div
        class="htw__panel{% if forloop.first %} is-active{% endif %}"
        data-htw-panel="{{ tab.id }}"
        role="tabpanel"
      >
        <div class="htw__steps">
          {%- for step in steps -%}
            {%- assign step_key = step.settings.tab_name | strip | downcase -%}
            {%- if step_key == tab_key -%}
              <div class="htw__step" {{ step.shopify_attributes }}>
                <div class="htw__media">
                  {%- if step.settings.video != blank -%}
                    {{
                      step.settings.video
                      | video_tag:
                        image_size: '800x',
                        autoplay: false,
                        loop: true,
                        muted: true,
                        playsinline: true,
                        controls: true,
                        preload: 'metadata'
                    }}
                  {%- elsif step.settings.video_url != blank -%}
                    <video src="{{ step.settings.video_url }}" muted loop playsinline controls preload="metadata"{% if step.settings.image != blank %} poster="{{ step.settings.image | image_url: width: 800 }}"{% endif %}></video>
                  {%- elsif step.settings.image != blank -%}
                    {%- assign step_alt = step.settings.image.alt | default: step.settings.tab_name -%}
                    {{
                      step.settings.image
                      | image_url: width: 900
                      | image_tag: loading: 'lazy', widths: '300, 400, 600, 800, 900', alt: step_alt
                    }}
                  {%- endif -%}
                </div>
                <div class="htw__label">
                  <span>{{ section.settings.step_prefix | escape }}</span>
                  <span class="htw__num">{{ step.settings.step_number | default: forloop.index }}</span>
                </div>
                {%- if step.settings.text != blank -%}
                  <div class="htw__text">{{ step.settings.text }}</div>
                {%- endif -%}
              </div>
            {%- endif -%}
          {%- endfor -%}
        </div>
      </div>
    {%- endfor -%}

    {%- if section.settings.show_button -%}
      {%- liquid
        assign first_tab = tabs | first
        assign cta_name = blank
        assign cta_href = blank
        if first_tab
          assign cta_prefix = section.settings.button_prefix | strip
          assign cta_suffix = section.settings.button_suffix | strip
          assign cta_middle = first_tab.settings.button_label | strip
          if cta_middle == blank and first_tab.settings.product != blank
            assign cta_middle = first_tab.settings.product.title
          endif
          if cta_middle == blank
            assign cta_middle = first_tab.settings.label | strip
          endif
          assign cta_name = cta_prefix
          if cta_name != blank and cta_middle != blank
            assign cta_name = cta_name | append: ' ' | append: cta_middle
          elsif cta_middle != blank
            assign cta_name = cta_middle
          endif
          if cta_suffix != blank
            if cta_name != blank
              assign cta_name = cta_name | append: ' ' | append: cta_suffix
            else
              assign cta_name = cta_suffix
            endif
          endif
          if first_tab.settings.product != blank
            assign cta_href = first_tab.settings.product.url
          elsif first_tab.settings.button_link != blank
            assign cta_href = first_tab.settings.button_link
          endif
        endif
      -%}
      <div class="htw__footer">
        <a
          class="htw__btn htw__btn--{{ button_style }}"
          data-htw-cta
          {% if cta_href != blank %}
            href="{{ cta_href }}"
          {% else %}
            role="link" aria-disabled="true"
          {% endif %}
        >
          {{ cta_name | escape }}
        </a>
      </div>
    {%- endif -%}
  </div>
</div>

{%- if tabs.size > 0 -%}
  <script>
    (function () {
      var root = document.getElementById('hc-how-to-wear');
      if (!root) return;
      var tabs = root.querySelectorAll('[data-htw-tab]');
      var panels = root.querySelectorAll('[data-htw-panel]');
      var cta = root.querySelector('[data-htw-cta]');

      function setCta(tab) {
        if (!cta || !tab) return;
        var label = tab.getAttribute('data-htw-cta-label') || '';
        var href = tab.getAttribute('data-htw-cta-href') || '';
        if (label) cta.textContent = label;
        if (href) {
          cta.setAttribute('href', href);
          cta.removeAttribute('role');
          cta.removeAttribute('aria-disabled');
        } else {
          cta.removeAttribute('href');
          cta.setAttribute('role', 'link');
          cta.setAttribute('aria-disabled', 'true');
        }
      }

      tabs.forEach(function (tab) {
        tab.addEventListener('click', function () {
          var id = tab.getAttribute('data-htw-tab');
          tabs.forEach(function (t) {
            t.classList.toggle('is-active', t === tab);
            t.setAttribute('aria-selected', t === tab ? 'true' : 'false');
          });
          panels.forEach(function (p) {
            p.classList.toggle('is-active', p.getAttribute('data-htw-panel') === id);
          });
          setCta(tab);
        });
      });
    })();
  </script>
{%- endif -%}

{% schema %}
{
  "name": "Custom how to wear",
  "settings": [
    {
      "type": "header",
      "content": "Background"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Full-width background",
      "default": "#FDF7F4"
    },
    {
      "type": "header",
      "content": "Heading"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "How to Wear?"
    },
    {
      "type": "select",
      "id": "heading_tag",
      "label": "Heading tag",
      "options": [
        { "value": "h1", "label": "H1" },
        { "value": "h2", "label": "H2" },
        { "value": "h3", "label": "H3" }
      ],
      "default": "h2"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading",
      "default": "No shifting. No folding. No fixing bra pads."
    },
    {
      "type": "select",
      "id": "text_alignment",
      "label": "Text alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ],
      "default": "center"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading color",
      "default": "#212326"
    },
    {
      "type": "color",
      "id": "subheading_color",
      "label": "Subheading color",
      "default": "#5C5C5C"
    },
    {
      "type": "select",
      "id": "heading_font_weight",
      "label": "Heading weight",
      "options": [
        { "value": "500", "label": "Medium" },
        { "value": "600", "label": "Semibold" },
        { "value": "700", "label": "Bold" }
      ],
      "default": "700"
    },
    {
      "type": "select",
      "id": "subheading_font_weight",
      "label": "Subheading weight",
      "options": [
        { "value": "400", "label": "Regular" },
        { "value": "500", "label": "Medium" }
      ],
      "default": "400"
    },
    {
      "type": "range",
      "id": "heading_font_size_desktop",
      "min": 22,
      "max": 56,
      "step": 2,
      "unit": "px",
      "label": "Heading size (desktop)",
      "default": 40
    },
    {
      "type": "range",
      "id": "heading_font_size_tablet",
      "min": 20,
      "max": 44,
      "step": 2,
      "unit": "px",
      "label": "Heading size (tablet)",
      "default": 32
    },
    {
      "type": "range",
      "id": "heading_font_size_mobile",
      "min": 18,
      "max": 36,
      "step": 1,
      "unit": "px",
      "label": "Heading size (mobile)",
      "default": 26
    },
    {
      "type": "range",
      "id": "subheading_font_size_desktop",
      "min": 12,
      "max": 22,
      "step": 1,
      "unit": "px",
      "label": "Subheading size (desktop)",
      "default": 16
    },
    {
      "type": "range",
      "id": "subheading_font_size_tablet",
      "min": 12,
      "max": 20,
      "step": 1,
      "unit": "px",
      "label": "Subheading size (tablet)",
      "default": 15
    },
    {
      "type": "range",
      "id": "subheading_font_size_mobile",
      "min": 12,
      "max": 18,
      "step": 1,
      "unit": "px",
      "label": "Subheading size (mobile)",
      "default": 14
    },
    {
      "type": "range",
      "id": "heading_spacing",
      "min": 0,
      "max": 20,
      "step": 2,
      "unit": "px",
      "label": "Space below heading",
      "default": 8
    },
    {
      "type": "range",
      "id": "heading_max_width",
      "min": 400,
      "max": 900,
      "step": 20,
      "unit": "px",
      "label": "Heading max width",
      "default": 640
    },
    {
      "type": "range",
      "id": "header_spacing",
      "min": 16,
      "max": 64,
      "step": 4,
      "unit": "px",
      "label": "Space below header",
      "default": 28
    },
    {
      "type": "header",
      "content": "Tabs"
    },
    {
      "type": "select",
      "id": "mobile_tabs_layout",
      "label": "Mobile tabs layout",
      "options": [
        { "value": "normal", "label": "Normal (wrap)" },
        { "value": "slider", "label": "Slider (horizontal scroll)" }
      ],
      "default": "slider",
      "info": "Slider peeks the next tab on mobile so shoppers know they can swipe."
    },
    {
      "type": "color",
      "id": "tab_background",
      "label": "Tab background",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "tab_text_color",
      "label": "Tab text",
      "default": "#212326"
    },
    {
      "type": "color",
      "id": "tab_border_color",
      "label": "Tab border",
      "default": "#212326"
    },
    {
      "type": "color",
      "id": "tab_active_background",
      "label": "Active tab background",
      "default": "#111111"
    },
    {
      "type": "color",
      "id": "tab_active_text",
      "label": "Active tab text",
      "default": "#FFFFFF"
    },
    {
      "type": "range",
      "id": "tab_radius",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "label": "Tab corner radius",
      "default": 40
    },
    {
      "type": "range",
      "id": "tab_height",
      "min": 32,
      "max": 56,
      "step": 2,
      "unit": "px",
      "label": "Tab height",
      "default": 42
    },
    {
      "type": "range",
      "id": "tab_padding_x",
      "min": 12,
