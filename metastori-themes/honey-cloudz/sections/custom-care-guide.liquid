                  </svg>
                {%- endif -%}
              </div>
              {%- if block.settings.heading != blank -%}
                <{{ block.settings.heading_tag }} class="ccg__card-heading">{{ block.settings.heading | escape }}</{{ block.settings.heading_tag }}>
              {%- endif -%}
              {%- if block.settings.text != blank -%}
                <div class="ccg__card-text">{{ block.settings.text }}</div>
              {%- endif -%}
            </div>
          {%- endif -%}
        {%- endfor -%}
      </div>
    </div>
  </div>
</div>

{%- if has_video -%}
  <script>
    (function () {
      var root = document.getElementById('hc-care-guide');
      if (!root) return;
      var media = root.querySelector('[data-ccg-media]');
      if (!media) return;
      var video = media.querySelector('video');
      if (!video) return;
      media.addEventListener('click', function () {
        if (video.paused) {
          video.play();
          media.classList.add('is-playing');
        } else {
          video.pause();
          media.classList.remove('is-playing');
        }
      });
    })();
  </script>
{%- endif -%}

{% schema %}
{
  "name": "Custom care guide",
  "settings": [
    {
      "type": "header",
      "content": "Background"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Full-width background",
      "default": "#FDF7F4"
    },
    {
      "type": "header",
      "content": "Heading"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Keep your Cloudz in chef’s kiss shape: watch our quick care guide 👌☁️"
    },
    {
      "type": "select",
      "id": "heading_tag",
      "label": "Heading tag",
      "options": [
        { "value": "h1", "label": "H1" },
        { "value": "h2", "label": "H2" },
        { "value": "h3", "label": "H3" }
      ],
      "default": "h2"
    },
    {
      "type": "select",
      "id": "text_alignment",
      "label": "Heading alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ],
      "default": "center"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading color",
      "default": "#212326"
    },
    {
      "type": "select",
      "id": "heading_font_weight",
      "label": "Heading weight",
      "options": [
        { "value": "500", "label": "Medium" },
        { "value": "600", "label": "Semibold" },
        { "value": "700", "label": "Bold" }
      ],
      "default": "700"
    },
    {
      "type": "range",
      "id": "heading_line_height",
      "min": 110,
      "max": 160,
      "step": 5,
      "unit": "%",
      "label": "Heading line height",
      "default": 130
    },
    {
      "type": "range",
      "id": "heading_font_size_desktop",
      "min": 18,
      "max": 48,
      "step": 1,
      "unit": "px",
      "label": "Heading size (desktop)",
      "default": 28
    },
    {
      "type": "range",
      "id": "heading_font_size_tablet",
      "min": 16,
      "max": 40,
      "step": 1,
      "unit": "px",
      "label": "Heading size (tablet)",
      "default": 24
    },
    {
      "type": "range",
      "id": "heading_font_size_mobile",
      "min": 15,
      "max": 32,
      "step": 1,
      "unit": "px",
      "label": "Heading size (mobile)",
      "default": 20
    },
    {
      "type": "range",
      "id": "heading_max_width",
      "min": 480,
      "max": 1100,
      "step": 20,
      "unit": "px",
      "label": "Heading max width",
      "default": 760
    },
    {
      "type": "range",
      "id": "header_spacing",
      "min": 16,
      "max": 64,
      "step": 4,
      "unit": "px",
      "label": "Space below heading",
      "default": 32
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "media_position",
      "label": "Video / image position",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "right", "label": "Right" }
      ],
      "default": "left"
    },
    {
      "type": "range",
      "id": "media_width",
      "min": 30,
      "max": 70,
      "step": 2,
      "unit": "%",
      "label": "Media column width",
      "default": 48
    },
    {
      "type": "range",
      "id": "column_gap",
      "min": 12,
      "max": 56,
      "step": 4,
      "unit": "px",
      "label": "Column gap (desktop)",
      "default": 28
    },
    {
      "type": "range",
      "id": "column_gap_tablet",
      "min": 12,
      "max": 40,
      "step": 4,
      "unit": "px",
      "label": "Column gap (tablet)",
      "default": 20
    },
    {
      "type": "range",
      "id": "column_gap_mobile",
      "min": 12,
      "max": 32,
      "step": 2,
      "unit": "px",
      "label": "Column gap (mobile)",
      "default": 20
