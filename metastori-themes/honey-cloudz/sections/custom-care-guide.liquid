                    <path d="M4.2938 14.1665C4.14353 14.2266 3.87305 14.7275 3.87305 14.9479C3.87305 15.2083 4.42403 15.6992 4.72456 15.6992C5.10524 15.6992 5.4759 15.2885 5.4759 14.8577C5.4759 14.3067 4.84478 13.9361 4.2938 14.1665Z"/>
                  </svg>
                {%- else -%}
                  <svg viewBox="0 0 65 65" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                    <path d="M0 0 C0.99 0 1.98 0 3 0 C3.33872513 1.41538717 3.67074624 2.83237963 4 4.25 C4.185625 5.03890625 4.37125 5.8278125 4.5625 6.640625 C5 9 5 9 5 13 C5.67095703 12.33291016 5.67095703 12.33291016 6.35546875 11.65234375 C11.29048442 7.03300072 11.29048442 7.03300072 14.6875 6.875 C17.37582452 8.18283355 18.93063246 9.86387867 21 12 C22.78671071 13.17612195 22.78671071 13.17612195 25 13 C29.79904417 10.92587979 29.79904417 10.92587979 33 7 C37.40114397 7.50298788 39.71195019 9.08772731 43 12 C44.17076699 8.01939223 45.25749403 4.08378283 46 0 C47.32 0 48.64 0 50 0 C49.08878558 8.66189708 48.07323004 17.29461108 46.5625 25.875 C46.33691406 27.17179687 46.11132812 28.46859375 45.87890625 29.8046875 C44.68568727 34.14270139 44.68568727 34.14270139 42 36 C39.38941972 36.31040379 37.02171966 36.44430614 34.41015625 36.43359375 C33.66922226 36.4388356 32.92828827 36.44407745 32.16490173 36.44947815 C30.5989609 36.45589683 29.03297184 36.45456328 27.46704102 36.44604492 C25.07415608 36.43754142 22.68366423 36.46628278 20.29101562 36.49804688 C18.76822988 36.49965922 17.24543992 36.49908071 15.72265625 36.49609375 C15.00900406 36.50732773 14.29535187 36.51856171 13.56007385 36.53013611 C10.34202714 36.48512728 8.31621667 36.20990579 5.61230469 34.41503906 C3.50017496 31.25132203 3.05637557 28.62036494 2.48046875 24.86328125 C2.31893059 23.84321236 2.31893059 23.84321236 2.15412903 22.80253601 C1.93076004 21.37238495 1.71521619 19.94099217 1.50708008 18.50854492 C1.18666139 16.30673733 0.8425396 14.10964633 0.49414062 11.91210938 C-0.6791059 4.29534629 -0.6791059 4.29534629 -1 1 C-0.67 0.67 -0.34 0.34 0 0 Z M7.4296875 15.171875 C5.42611676 17.73381791 5.67237007 19.36383564 5.9375 22.5625 C6.47494658 26.32462609 7.25767766 28.51535533 9 32 C19.56 32 30.12 32 41 32 C43.17339281 24.4540027 43.17339281 24.4540027 43 17 C40.89044882 14.91675245 38.58645014 13.4317849 36 12 C33.50638429 13.20381448 31.31856917 14.45428722 29 16 C22.76516891 16.61326207 20.1