{%- liquid
  assign media_position = section.settings.media_position | default: 'left'
  assign has_video = false
  if section.settings.video != blank or section.settings.video_url != blank
    assign has_video = true
  endif
  assign card_align = 'center'
  if section.settings.card_text_alignment == 'left'
    assign card_align = 'flex-start'
  elsif section.settings.card_text_alignment == 'right'
    assign card_align = 'flex-end'
  endif
-%}

{%- style -%}
  #shopify-section-{{ section.id }} .ccg {
    --ccg-heading-size: {{ section.settings.heading_font_size_desktop }}px;
    --ccg-card-heading-size: {{ section.settings.card_heading_font_size_desktop }}px;
    --ccg-card-text-size: {{ section.settings.card_text_font_size_desktop }}px;
    background-color: {{ section.settings.background_color }};
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }

  #shopify-section-{{ section.id }} .ccg__inner {
    max-width: {{ section.settings.content_max_width }}px;
    margin: 0 auto;
    padding-inline: {{ section.settings.side_padding }}px;
    box-sizing: border-box;
  }

  #shopify-section-{{ section.id }} .ccg__header {
    text-align: {{ section.settings.text_alignment }};
    margin: 0 auto {{ section.settings.header_spacing }}px;
    max-width: {{ section.settings.heading_max_width }}px;
  }

  #shopify-section-{{ section.id }} .ccg__heading {
    margin: 0;
    color: {{ section.settings.heading_color }};
    font-size: var(--ccg-heading-size);
    font-weight: {{ section.settings.heading_font_weight }};
    line-height: {{ section.settings.heading_line_height }}%;
  }

  #shopify-section-{{ section.id }} .ccg__grid {
    display: grid;
    grid-template-columns: minmax(0, {{ section.settings.media_width }}fr) minmax(0, {{ 100 | minus: section.settings.media_width }}fr);
    gap: {{ section.settings.column_gap }}px;
    align-items: stretch;
  }

  #shopify-section-{{ section.id }} .ccg--media-right .ccg__media {
    order: 2;
  }

  #shopify-section-{{ section.id }} .ccg--media-right .ccg__cards {
    order: 1;
  }

  #shopify-section-{{ section.id }} .ccg__media {
    position: relative;
    border-radius: {{ section.settings.media_radius }}px;
    overflow: hidden;
    background-color: {{ section.settings.media_background }};
    min-height: 0;
    height: 100%;
  }

  #shopify-section-{{ section.id }} .ccg__media--video {
    cursor: pointer;
  }

  #shopify-section-{{ section.id }} .ccg__media img,
  #shopify-section-{{ section.id }} .ccg__media video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    display: block;
    object-fit: {{ section.settings.media_fit }};
  }

  #shopify-section-{{ section.id }} .ccg__media-ratio {
    position: relative;
    width: 100%;
    aspect-ratio: {{ section.settings.media_ratio }};
  }

  #shopify-section-{{ section.id }} .ccg__play {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    color: {{ section.settings.play_color }};
    pointer-events: none;
    transition: opacity 0.2s ease;
  }

  #shopify-section-{{ section.id }} .ccg__media.is-playing .ccg__play {
    opacity: 0;
  }

  #shopify-section-{{ section.id }} .ccg__play svg {
    width: {{ section.settings.play_size }}px;
    height: {{ section.settings.play_size }}px;
    display: block;
    filter: drop-shadow(0 2px 10px rgba(0, 0, 0, 0.28));
  }

  #shopify-section-{{ section.id }} .ccg__cards {
    display: flex;
    flex-direction: column;
    gap: {{ section.settings.card_gap }}px;
    height: 100%;
    min-height: 100%;
  }

  #shopify-section-{{ section.id }} .ccg__card {
    background-color: {{ section.settings.card_background }};
    border: {{ section.settings.card_border_width }}px solid {{ section.settings.card_border_color }};
    border-radius: {{ section.settings.card_radius }}px;
    padding: {{ section.settings.card_padding_y }}px {{ section.settings.card_padding_x }}px;
    text-align: {{ section.settings.card_text_alignment }};
    flex: 1 1 0;
    display: flex;
    flex-direction: column;
    align-items: {{ card_align }};
    justify-content: center;
  }

  #shopify-section-{{ section.id }} .ccg__icon {
    display: flex;
    justify-content: {{ card_align }};
    margin: 0 0 {{ section.settings.icon_spacing }}px;
    color: {{ section.settings.icon_color }};
  }

  #shopify-section-{{ section.id }} .ccg__icon img,
  #shopify-section-{{ section.id }} .ccg__icon svg {
    width: {{ section.settings.icon_size }}px;
    height: {{ section.settings.icon_size }}px;
    display: block;
    object-fit: contain;
  }

  #shopify-section-{{ section.id }} .ccg__icon svg path {
    fill: currentColor;
  }

  #shopify-section-{{ section.id }} .ccg__card-heading {
    margin: 0 0 {{ section.settings.card_heading_spacing }}px;
    color: {{ section.settings.card_heading_color }};
    font-size: var(--ccg-card-heading-size);
    font-weight: {{ section.settings.card_heading_font_weight }};
    line-height: 1.25;
  }

  #shopify-section-{{ section.id }} .ccg__card-text {
    margin: 0;
    color: {{ section.settings.card_text_color }};
    font-size: var(--ccg-card-text-size);
    font-weight: {{ section.settings.card_text_font_weight }};
    line-height: {{ section.settings.card_text_line_height }}%;
  }

  #shopify-section-{{ section.id }} .ccg__card-text p {
    margin: 0 0 0.8em;
  }

  #shopify-section-{{ section.id }} .ccg__card-text p:last-child {
    margin-bottom: 0;
  }

  @media screen and (max-width: 989px) {
    #shopify-section-{{ section.id }} .ccg {
      --ccg-heading-size: {{ section.settings.heading_font_size_tablet }}px;
      --ccg-card-heading-size: {{ section.settings.card_heading_font_size_tablet }}px;
      --ccg-card-text-size: {{ section.settings.card_text_font_size_tablet }}px;
    }

    #shopify-section-{{ section.id }} .ccg__grid {
      gap: {{ section.settings.column_gap_tablet }}px;
    }
  }

  @media screen and (max-width: 749px) {
    #shopify-section-{{ section.id }} .ccg {
      --ccg-heading-size: {{ section.settings.heading_font_size_mobile }}px;
      --ccg-card-heading-size: {{ section.settings.card_heading_font_size_mobile }}px;
      --ccg-card-text-size: {{ section.settings.card_text_font_size_mobile }}px;
      padding-top: {{ section.settings.padding_top_mobile }}px;
      padding-bottom: {{ section.settings.padding_bottom_mobile }}px;
    }

    #shopify-section-{{ section.id }} .ccg__inner {
      padding-inline: {{ section.settings.side_padding_mobile }}px;
    }

    #shopify-section-{{ section.id }} .ccg__grid {
      grid-template-columns: 1fr;
      gap: {{ section.settings.column_gap_mobile }}px;
    }

    #shopify-section-{{ section.id }} .ccg--media-right .ccg__media,
    #shopify-section-{{ section.id }} .ccg--media-right .ccg__cards {
      order: unset;
    }

    #shopify-section-{{ section.id }} .ccg__card {
      flex: none;
      padding: {{ section.settings.card_padding_y_mobile }}px {{ section.settings.card_padding_x_mobile }}px;
    }

    #shopify-section-{{ section.id }} .ccg__cards {
      height: auto;
      min-height: 0;
    }

    #shopify-section-{{ section.id }} .ccg__media {
      height: auto;
      min-height: 240px;
    }
  }
{%- endstyle -%}

<div class="ccg ccg--media-{{ media_position }}" id="hc-care-guide">
  <div class="ccg__inner">
    {%- if section.settings.heading != blank -%}
      <div class="ccg__header">
        <{{ section.settings.heading_tag }} class="ccg__heading">{{ section.settings.heading | escape }}</{{ section.settings.heading_tag }}>
      </div>
    {%- endif -%}

    <div class="ccg__grid">
      <div class="ccg__media{% if has_video %} ccg__media--video{% endif %}" {% if has_video %}data-ccg-media{% endif %}>
        <div class="ccg__media-ratio">
          {%- if section.settings.video != blank -%}
            {{
              section.settings.video
              | video_tag:
                image_size: '1100x',
                autoplay: false,
                loop: true,
                muted: true,
                playsinline: true,
                controls: false,
                preload: 'metadata',
                class: 'ccg__video'
            }}
          {%- elsif section.settings.video_url != blank -%}
            <video
              class="ccg__video"
              src="{{ section.settings.video_url }}"
              muted
              loop
              playsinline
              preload="metadata"
              {% if section.settings.image != blank %}poster="{{ section.settings.image | image_url: width: 1100 }}"{% endif %}
            ></video>
          {%- elsif section.settings.image != blank -%}
            {%- assign care_alt = section.settings.image.alt | default: section.settings.heading -%}
            {{
              section.settings.image
              | image_url: width: 1200
              | image_tag: loading: 'lazy', widths: '400, 600, 800, 1000, 1200', alt: care_alt
            }}
          {%- endif -%}
        </div>
        {%- if has_video -%}
          <span class="ccg__play" aria-hidden="true">
            <svg viewBox="0 0 64 64" fill="none" xmlns="http://www.w3.org/2000/svg">
              <circle cx="32" cy="32" r="31" fill="rgba(255,255,255,0.92)"/>
              <path d="M26 20L46 32L26 44V20Z" fill="{{ section.settings.play_icon_color }}"/>
            </svg>
          </span>
        {%- endif -%}
      </div>

      <div class="ccg__cards">
        {%- for block in section.blocks -%}
          {%- if block.type == 'card' -%}
            <div class="ccg__card" {{ block.shopify_attributes }}>
              <div class="ccg__icon">
                {%- if block.settings.image != blank -%}
                  {%- assign icon_alt = block.settings.image.alt | default: block.settings.heading | default: 'Icon' -%}
                  {{
                    block.settings.image
                    | image_url: width: 120
                    | image_tag: loading: 'lazy', widths: '40, 60, 80, 120', alt: icon_alt
                  }}
                {%- elsif block.settings.icon == 'fabric' -%}
                  <svg viewBox="0 0 41 41" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                    <path d="M27.8295 0.57232C25.2249 0.94298 22.5301 2.37553 20.9473 4.23885C19.9054 5.47104 18.9437 7.134 18.6833 8.13578L18.5831 8.53649H16.6096C14.4457 8.54651 13.6042 8.65671 11.8611 9.18765C9.94772 9.7787 7.79388 10.8907 6.6819 11.8624C6.10087 12.3633 6.03074 12.6839 6.38137 13.1347C6.72197 13.5755 7.12269 13.4953 8.09442 12.7941C9.02607 12.1129 10.7491 11.2413 11.9012 10.8506C13.5742 10.2796 16.0085 9.96904 17.5012 10.1293L18.1623 10.1995L18.1122 11.1712C17.9019 15.4989 20.3663 19.7264 24.2031 21.6598C25.9362 22.5314 27.9598 22.9722 29.783 22.882L30.8048 22.8219L30.875 23.4931C30.9651 24.3847 30.8649 25.9675 30.6245 27.1897C30.2438 29.1332 29.4725 30.9965 28.3304 32.7296C27.5791 33.8616 25.8059 35.6247 24.6539 36.3961C18.9738 40.1728 11.5405 39.6118 6.64183 35.0337C5.11912 33.6111 3.7567 31.5575 3.00536 29.5539C2.60465 28.502 2.28408 27.0094 2.15384 25.667C1.94347 23.423 2.37424 20.7983 3.26582 18.8048C3.76671 17.7128 3.8168 17.262 3.4762 16.9815C3.15563 16.7311 2.64472 16.7511 2.38425 17.0216C1.95349 17.4924 1.14204 19.6463 0.821473 21.2291C-0.250435 26.4283 1.40251 32.0283 5.11912 35.785C11.0998 41.8358 20.8671 42.0862 27.2786 36.366C30.6746 33.3406 32.7182 28.3718 32.4778 23.7035L32.4177 22.4312L32.7583 22.3711C33.4796 22.2309 35.4631 21.1289 36.4349 20.3275C41.9146 15.7593 41.8445 7.39446 36.2846 2.91649C35.1926 2.03492 33.4095 1.16337 32.017 0.822766C30.8349 0.532249 28.9014 0.422052 27.8295 0.57232ZM31.5962 2.38555C32.0571 2.48573 32.6581 2.67606 32.9286 2.79628L33.4395 3.00665L27.0481 9.39803C20.9773 15.4688 20.6468 15.7894 20.5366 15.569C20.2961 15.1082 19.9956 14.0864 19.8353 13.1848L19.675 12.2631L24.7641 7.17407L29.8531 2.08501L30.3039 2.1351C30.5644 2.16515 31.1354 2.27535 31.5962 2.38555ZM27.3086 2.3054C27.3086 2.31542 25.6457 3.9884 23.612 6.02202C20.1158 9.51824 19.9155 9.69856 20.0056 9.30787C20.1358 8.71681 20.4464 7.94544 20.9072 7.10394C22.0993 4.87999 24.1029 3.23706 26.5072 2.51578C27.3787 2.2453 27.3086 2.26533 27.3086 2.