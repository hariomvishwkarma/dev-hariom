{%- liquid
  assign heading_font = section.settings.heading_font
-%}

{%- style -%}
  {% # theme-check-disable RemoteAsset %}
  @import url('https://fonts.googleapis.com/css2?family=Send+Flowers&family=Poppins:wght@400;500&display=swap');
  {% # theme-check-enable RemoteAsset %}
  {{ heading_font | font_face: font_display: 'swap' }}

  @font-face {
    font-family: "Satoshi";
    src: url("https://cdn.shopify.com/s/files/1/1711/0419/files/Satoshi-Medium.woff2?v=1750649880") format("woff2");
    font-weight: 500;
    font-style: normal;
    font-display: swap;
  }
  @font-face {
    font-family: "Satoshi";
    src: url("https://cdn.shopify.com/s/files/1/1711/0419/files/Satoshi-Medium.woff2?v=1750649880") format("woff2");
    font-weight: 700;
    font-style: normal;
    font-display: swap;
  }

  #shopify-section-{{ section.id }} .cch {
    --cch-bg: {{ section.settings.background_color }};
    --cch-pad-top: {{ section.settings.padding_top_mobile }}px;
    --cch-pad-bottom: {{ section.settings.padding_bottom_mobile }}px;
    --cch-side-pad: {{ section.settings.side_padding_mobile }}px;
    --cch-max: {{ section.settings.content_max_width }}px;
    --cch-heading-gap: {{ section.settings.heading_gap_mobile }}px;
    --cch-script-size: {{ section.settings.script_font_size_mobile }}px;
    --cch-script-lh: {{ section.settings.script_lh_mobile }}px;
    --cch-heading-size: {{ section.settings.heading_font_size_mobile }}px;
    --cch-heading-lh: {{ section.settings.heading_lh_mobile }}px;
    --cch-label-size: {{ section.settings.label_font_size_mobile }}px;
    --cch-detail-size: {{ section.settings.detail_font_size_mobile }}px;
    --cch-icon-wrap: {{ section.settings.icon_circle_size_mobile }}px;
    --cch-icon-bg: {{ section.settings.icon_circle_color }};
    --cch-script-color: {{ section.settings.script_color }};
    --cch-heading-color: {{ section.settings.heading_color }};
    --cch-label-color: {{ section.settings.label_color }};
    --cch-detail-color: {{ section.settings.detail_color }};
    --cch-col-gap: {{ section.settings.column_gap_mobile }}px;
    --cch-item-gap: {{ section.settings.item_inner_gap }}px;
    background-color: var(--cch-bg);
    padding: var(--cch-pad-top) var(--cch-side-pad) var(--cch-pad-bottom);
    text-align: center;
  }

  #shopify-section-{{ section.id }} .cch__inner {
    width: 100%;
    max-width: var(--cch-max);
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    align-items: stretch;
    gap: var(--cch-heading-gap);
    box-sizing: border-box;
  }

  #shopify-section-{{ section.id }} .cch__heading-wrap {
    display: flex;
    flex-direction: column;
    align-items: center;
    width: 100%;
  }

  #shopify-section-{{ section.id }} .cch__script {
    margin: 0;
    color: var(--cch-script-color);
    font-family: "Send Flowers", cursive, sans-serif;
    font-weight: 400;
    font-size: var(--cch-script-size);
    line-height: var(--cch-script-lh);
    text-align: center;
  }

  #shopify-section-{{ section.id }} .cch__heading {
    margin: 0;
    color: var(--cch-heading-color);
    font-family: {{ heading_font.family }}, {{ heading_font.fallback_families }};
    font-style: {{ heading_font.style }};
    font-weight: {{ section.settings.heading_font_weight }};
    font-size: var(--cch-heading-size);
    line-height: var(--cch-heading-lh);
    text-align: center;
  }

  #shopify-section-{{ section.id }} .cch__grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--cch-col-gap);
    width: 100%;
    max-width: 1320px;
    margin: 0 auto;
    padding: 0;
    list-style: none;
    box-sizing: border-box;
  }

  #shopify-section-{{ section.id }} .cch__item-wrap:first-child {
    grid-column: 1 / -1;
  }

  #shopify-section-{{ section.id }} .cch__item-wrap {
    width: 100%;
    min-width: 0;
    margin: 0;
    padding: 0;
  }

  #shopify-section-{{ section.id }} .cch__item {
    width: 100%;
    height: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: flex-start;
    gap: var(--cch-item-gap);
    text-align: center;
    text-decoration: none;
    color: inherit;
    box-sizing: border-box;
  }

  #shopify-section-{{ section.id }} .cch__icon {
    width: var(--cch-icon-wrap);
    height: var(--cch-icon-wrap);
    border-radius: 50%;
    background-color: var(--cch-icon-bg);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    flex-shrink: 0;
  }

  #shopify-section-{{ section.id }} .cch__icon img,
  #shopify-section-{{ section.id }} .cch__icon svg {
    width: {{ section.settings.icon_size }}px;
    height: auto;
    max-width: 50%;
    max-height: 50%;
    display: block;
    object-fit: contain;
  }

  #shopify-section-{{ section.id }} .cch__label {
    margin: 0;
    color: var(--cch-label-color);
    font-family: "Satoshi", {{ settings.type_body_font.family }}, sans-serif;
    font-weight: 700;
    font-size: var(--cch-label-size);
    line-height: 1.3;
  }

  #shopify-section-{{ section.id }} .cch__detail {
    margin: 0;
    color: var(--cch-detail-color);
    font-family: "Satoshi", {{ settings.type_body_font.family }}, sans-serif;
    font-weight: 500;
    font-size: var(--cch-detail-size);
    line-height: 1.4;
    word-break: break-word;
    text-decoration: none;
  }

  a.cch__detail {
    cursor: pointer;
    text-decoration: underline;
    text-underline-offset: 0.15em;
  }

  @media screen and (min-width: 480px) {
    #shopify-section-{{ section.id }} .cch__item-wrap:first-child {
      grid-column: auto;
    }

    #shopify-section-{{ section.id }} .cch__item-wrap:last-child {
      grid-column: 1 / -1;
    }
  }

  @media screen and (min-width: 750px) {
    #shopify-section-{{ section.id }} .cch {
      --cch-pad-top: {{ section.settings.padding_top }}px;
      --cch-pad-bottom: {{ section.settings.padding_bottom }}px;
      --cch-side-pad: {{ section.settings.side_padding }}px;
      --cch-heading-gap: {{ section.settings.heading_gap }}px;
      --cch-script-size: {{ section.settings.script_font_size }}px;
      --cch-script-lh: {{ section.settings.script_lh }}px;
      --cch-heading-size: {{ section.settings.heading_font_size }}px;
      --cch-heading-lh: {{ section.settings.heading_lh }}px;
      --cch-label-size: {{ section.settings.label_font_size }}px;
      --cch-detail-size: {{ section.settings.detail_font_size }}px;
      --cch-icon-wrap: {{ section.settings.icon_circle_size }}px;
      --cch-col-gap: {{ section.settings.column_gap }}px;
    }

    #shopify-section-{{ section.id }} .cch__grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      width: 100%;
      max-width: 1320px;
    }

    #shopify-section-{{ section.id }} .cch__item-wrap:last-child {
      grid-column: auto;
    }
  }
{%- endstyle -%}

<div class="cch">
  <div class="cch__inner">
    <div class="cch__heading-wrap">
      {%- if section.settings.script_text != blank -%}
        <p class="cch__script">{{ section.settings.script_text | escape }}</p>
      {%- endif -%}
      {%- if section.settings.heading_text != blank -%}
        <{{ section.settings.heading_tag }} class="cch__heading">
          {{- section.settings.heading_text | escape -}}
        </{{ section.settings.heading_tag }}>
      {%- endif -%}
    </div>

    {%- if section.blocks.size > 0 -%}
      <ul class="cch__grid">
        {%- for block in section.blocks -%}
          {%- liquid
            assign link = block.settings.link
            assign detail = block.settings.detail
            if link == blank and detail != blank
              if block.settings.link_type == 'email'
                assign link = 'mailto:' | append: detail
              elsif block.settings.link_type == 'tel'
                assign link = 'tel:' | append: detail
              elsif block.settings.link_type == 'sms'
                assign link = 'sms:' | append: detail
              endif
            endif
          -%}
          <li class="cch__item-wrap" {{ block.shopify_attributes }}>
            <div class="cch__item">
              <span class="cch__icon" aria-hidden="true">
                {%- if block.settings.icon != blank -%}
                  {{
                    block.settings.icon
                    | image_url: width: 160
                    | image_tag: loading: 'lazy', alt: ''
                  }}
                {%- else -%}
                  {%- case block.settings.icon_type -%}
                    {%- when 'chat' -%}
                      {% # theme-check-disable RemoteAsset %}
                      <img
                        src="https://assets.replocdn.com/projects/a2c7c51a-ec22-4e36-a9ea-6f00296360e2/4f95cf67-2415-414a-a080-c17137f5837f"
                        alt=""
                        width="40"
                        height="40"
                        loading="lazy"
                      >
                      {% # theme-check-enable RemoteAsset %}
                    {%- when 'phone' -%}
                      {% # theme-check-disable RemoteAsset %}
                      <img
                        src="https://assets.replocdn.com/projects/a2c7c51a-ec22-4e36-a9ea-6f00296360e2/3dac49e5-d5a6-4051-b1ea-5b426fcd3668"
                        alt=""
                        width="40"
                        height="40"
                        loading="lazy"
                      >
                      {% # theme-check-enable RemoteAsset %}
                    {%- else -%}
                      {% # theme-check-disable RemoteAsset %}
                      <img
                        src="https://assets.replocdn.com/projects/a2c7c51a-ec22-4e36-a9ea-6f00296360e2/89c87d5b-c20f-4505-a879-3712a8c7fd9f"
                        alt=""
                        width="40"
                        height="32"
                        loading="lazy"
                      >
                      {% # theme-check-enable RemoteAsset %}
                  {%- endcase -%}
                {%- endif -%}
              </span>

              {%- if block.settings.label != blank -%}
                <p class="cch__label">{{ block.settings.label | escape }}</p>
              {%- endif -%}
              {%- if detail != blank -%}
                {%- if link != blank -%}
                  <a class="cch__detail" href="{{ link }}">{{ detail | escape }}</a>
                {%- else -%}
                  <p class="cch__detail">{{ detail | escape }}</p>
                {%- endif -%}
              {%- endif -%}
            </div>
          </li>
        {%- endfor -%}
      </ul>
    {%- endif -%}
  </div>
</div>

