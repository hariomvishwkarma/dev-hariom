{% comment %}
  ============================================================================
  Section: Benefits with Icons
  ============================================================================
{% endcomment %}

<style>
  .benefits-section-{{ section.id }} {
    background-color: {{ section.settings.section_background_color }};
    padding: 60px 20px;
    text-align: center;
  }

  .benefits-section-{{ section.id }} .benefits-container {
    max-width: 1200px;
    margin: 0 auto;
  }

  .benefits-section-{{ section.id }} .benefits-heading-script {
    font-family: "Send Flowers", cursive;
  font-weight: 400;
  font-style: normal;
  font-size:48px;
    color: {{ section.settings.script_heading_color }};
    margin: 0 0 5px 0;
  }

  .benefits-section-{{ section.id }} .benefits-heading-main {
    font-family: 'Satoshi';
    font-weight: bold;
    font-size: 40px;
    color: {{ section.settings.main_heading_color }};
    margin-bottom: 50px;
    margin-top:0px;
  }

  .benefits-section-{{ section.id }} .benefits-grid {
    display: grid;
    gap: 40px 30px;
    justify-items: center;
  }

  .benefits-section-{{ section.id }} .benefit-item {
    text-align: center; 
  }

  .benefits-section-{{ section.id }} .benefit-icon {
    margin-bottom: 20px; text-align:center;
  }

  .benefits-section-{{ section.id }} .benefit-icon svg {
    width: 45px; /* Adjust size of SVG icons */
    height: 45px;
    fill: {{ section.settings.icon_color }};
    margin:0 auto;
  }

  .benefits-section-{{ section.id }} .benefit-title {
    font-weight: 600;
    font-size: 18px;
    color: {{ section.settings.item_title_color }};
    margin-bottom: 10px;
    line-height: 1.3; letter-spacing:normal;
  }

  .benefits-section-{{ section.id }} .benefit-description {
    font-size: 15px;
    color: {{ section.settings.item_description_color }};
    line-height: 1.5;
    font-weight: 400;
    font-family: 'Satoshi'; letter-spacing:normal;
  }
  .benefit-description a{
    color:#000;
  }
  /* Auto responsive grid based on number of items */
  .benefits-section-{{ section.id }} .benefits-grid.cols-1 {
    grid-template-columns: 1fr;
  }
  .benefits-section-{{ section.id }} .benefits-grid.cols-2 {
    grid-template-columns: repeat(2, 1fr);
  }
  .benefits-section-{{ section.id }} .benefits-grid.cols-3 {
    grid-template-columns: repeat(3, 1fr);
  }
  .benefits-section-{{ section.id }} .benefits-grid.cols-4 {
    grid-template-columns: repeat(4, 1fr);
  }

  .benefits-section-{{ section.id }} .benefit-item {
    text-align: center;
  }

  /* Mobile responsiveness */
  @media screen and (max-width: 768px) {
    .benefits-section-{{ section.id }} {
      padding: 40px 15px;
    }
    .benefits-section-{{ section.id }} .benefits-grid {
      grid-template-columns: repeat(2, 1fr) !important; /* stack on mobile */
    }
    .benefits-section-{{ section.id }} .benefits-grid.cols-3 {
    grid-template-columns: repeat(2, 1fr);
  }
    .benefits-section-{{ section.id }} .benefits-heading-main {
      margin-bottom: 40px;
    }
    .benefits-section-{{ section.id }} .benefit-item {
    text-align: center; width:100%;
  }
  .benefits-section-{{ section.id }} .benefits-heading-script { font-size:32px; }

   .benefits-section-{{ section.id }} .benefits-heading-main { font-size:30px; }
   .benefits-grid .full-width-item {
    grid-column: 1 / -1;
    text-align: center;
    justify-self: center;
  }
  }

  @media screen and (max-width: 480px) {

    .benefits-section-{{ section.id }} .benefit-item {
      max-width: 100%; /* Allow items to take more width */
    }
  }
</style>

<div class="benefits-section-{{ section.id }}">
  <div class="benefits-container">
    {% if section.settings.script_heading != blank %}
      <h2 class="benefits-heading-script">{{ section.settings.script_heading | escape }}</h2>
    {% endif %}
    {% if section.settings.main_heading != blank %}
      <h3 class="benefits-heading-main">{{ section.settings.main_heading | escape }}</h3>
    {% endif %}

    {%- assign block_count = section.blocks.size -%}
    <div class="benefits-grid cols-{{ block_count }}">
      {% for block in section.blocks %}
        <div class="benefit-item {% if block.settings.full_width_item %} full-width-item{% endif %}">
          <div class="benefit-icon">
            {% case block.settings.icon_choice %}
              {% when 'heart' %}
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24"><path d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z"/></svg>
              {% when 'star' %}
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24"><path d="M12 17.27L18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z"/></svg>
              {% when 'check' %}
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24"><path d="M9 16.17L4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41z"/></svg>
              {% when 'sparkles' %}
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24"><path d="M11 1.76l1.5 3.55 3.84.34-2.92 2.53.86 3.77L12 9.6l-3.28 1.94.86-3.77-2.92-2.53 3.84-.34L11 1.76zM19 11l-1 2-2 1 2 1 1 2 1-2 2-1-2-1-1-2zM5 15l-1 2-2 1 2 1 1 2 1-2 2-1-2-1-1-2z"/></svg>
              {% when 'custom' %}
                {% if block.settings.custom_svg_icon != blank %}
                  {{ block.settings.custom_svg_icon }}
                {% else %}
                  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24"><path d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z"/></svg>
                {% endif %}
            {% endcase %}
          </div>
          {% if block.settings.title != blank %}
            <h4 class="benefit-title">{{ block.settings.title | escape }}</h4>
          {% endif %}
          {% if block.settings.description != blank %}
            <div class="benefit-description">{{ block.settings.description }}</div>
          {% endif %}
        </div>
      {% endfor %}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Benefits with Icons",
  "tag": "section",
  "class": "spaced-section",
  "max_blocks": 4,
  "settings": [
    

    {
      "type": "header",
      "content": "Headings"
    },
    {
      "type": "text",
      "id": "script_heading",
      "label": "Script-style Heading",
      "default": "Benefits of Honey Cloudz"
    },
    {
      "type": "text",
      "id": "main_heading",
      "label": "Main Heading",
      "default": "Push-Up Bra Inserts"
    },
    {
      "type": "header",
      "content": "Color Settings"
    },
    {
      "type": "color",
      "id": "section_background_color",
      "label": "Section Background",
      "default": "#F7D8E7"
    },
    {
      "type": "color",
      "id": "script_heading_color",
      "label": "Script Heading Color",
      "default": "#C77B8A"
    },
    {
      "type": "color",
      "id": "main_heading_color",
      "label": "Main Heading Color",
      "default": "#333333"
    },
    {
      "type": "color",
      "id": "icon_color",
      "label": "Icon Color",
      "default": "#C77B8A"
    },
    {
      "type": "color",
      "id": "item_title_color",
      "label": "Item Title Color",
      "default": "#333333"
    },
    {
      "type": "color",
      "id": "item_description_color",
      "label": "Item Description Color",
      "default": "#555555"
    }
  ],
  "blocks": [
    {
      "type": "benefit",
      "name": "Benefit Item",
      "settings": [
        {
  "type": "checkbox",
  "id": "full_width_item",
  "label": "Make full-width on mobile"
},
        {
          "type": "select",
          "id": "icon_choice",
          "label": "Choose Icon",
          "options": [
            { "value": "heart", "label": "Heart" },
            { "value": "star", "label": "Star" },
            { "value": "check", "label": "Checkmark" },
            { "value": "sparkles", "label": "Sparkles" },
            { "value": "custom", "label": "Custom SVG (Advanced)" }
          ],
          "default": "heart"
        },
        {
          "type": "liquid",
          "id": "custom_svg_icon",
          "label": "Custom SVG Icon",
          "info": "Paste full SVG code here. Only used if 'Custom SVG' is selected above. Example: <svg viewBox=\"0 0 24 24\"><path d=\"M12...\"/></svg>"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Lifted & Fuller Bustline"
        },
        {
          "type": "richtext",
          "id": "description",
          "label": "Description"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Benefits with Icons",
      "blocks": [
        { "type": "benefit" },
        { "type": "benefit" },
        { "type": "benefit" },
        { "type": "benefit" }
      ]
    }
  ]
}
{% endschema %}