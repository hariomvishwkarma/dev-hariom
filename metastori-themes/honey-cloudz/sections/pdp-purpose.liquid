{%- liquid
  assign preset = section.settings.design_preset
  if preset == blank
    assign preset = 'inserts'
  endif
-%}
{% include 'pdp-assets' %}

<style>
  /* Kill any margin/padding the theme puts on section wrappers — the Replo
     markup already carries its own vertical rhythm. */
  #shopify-section-{{ section.id }} { margin: 0; padding: 0; }
  #pdp-sec-{{ section.id }} {
    margin-top: {{ section.settings.space_above_desktop }}px;
  }
  /* Every section carries pdp-wrap-open's 60px/80px Replo gap div. That is the
     'extra' space, so the setting drives it. Id doubled to beat the !important
     rules in tbf2-pdp-ui.css / hc-pdp-ui.css. */
  #pdp-sec-{{ section.id }}#pdp-sec-{{ section.id }} [data-pdp-gap] {
    padding-top: {{ section.settings.padding_top }}px !important;
    padding-bottom: {{ section.settings.padding_bottom }}px !important;
  }
  @media (max-width: 640px) {
    #pdp-sec-{{ section.id }} { margin-top: {{ section.settings.space_above_mobile }}px; }
    #pdp-sec-{{ section.id }}#pdp-sec-{{ section.id }} [data-pdp-gap] {
      padding-top: {{ section.settings.padding_top_mobile }}px !important;
      padding-bottom: {{ section.settings.padding_bottom_mobile }}px !important;
    }
  }
</style>

<div id="pdp-sec-{{ section.id }}" data-pdp-sec="purpose" data-pdp-preset="{{ preset }}" data-section-id="{{ section.id }}"{% if section.settings.headline_poppins %} data-pdp-headline="poppins"{% endif %}>
  {% render 'pdp-wrap-open', preset: preset, group: 'a' %}
    {%- if preset == 'breast-form' -%}{% include 'pdp-purpose--breast-form' %}{%- else -%}{% include 'pdp-purpose--inserts' %}{%- endif -%}
  {% render 'pdp-wrap-close', preset: preset %}
</div>

{%- comment -%}
  Each pdp-* section contributes its own slice of the globals that
  hc-pdp.js / tbf2-pdp.js read. Merge, never replace, so the order the
  client drags these sections into does not matter.
{%- endcomment -%}
<script>
  (function () {
{%- if preset == 'breast-form' -%}
    var g = (window.tbf2Pdp = window.tbf2Pdp || {});
    g.contentOverrides = g.contentOverrides || {};
    g.blockVisibility = g.blockVisibility || {};
    g.contentOverrides.purpose = {
      headingLine1: {{ section.settings.heading_line_1 | json }},
      headingLine2: {{ section.settings.heading_line_2 | json }},
      headingLine3: {{ section.settings.heading_line_3 | json }},
      headingLine4: {{ section.settings.heading_line_4 | json }},
      body: {{ section.settings.body | json }},
      point1Title: {{ section.settings.point_1_title | json }},
      point1Body: {{ section.settings.point_1_body | json }},
      point2Title: {{ section.settings.point_2_title | json }},
      point2Body: {{ section.settings.point_2_body | json }},
      point3Title: {{ section.settings.point_3_title | json }},
      point3Body: {{ section.settings.point_3_body | json }},
      point4Title: {{ section.settings.point_4_title | json }},
      point4Body: {{ section.settings.point_4_body | json }}
    };
    g.blockVisibility.purpose = true;
{%- else -%}
    var g = (window.hcPdp = window.hcPdp || {});
    g.contentOverrides = g.contentOverrides || {};
    g.blockVisibility = g.blockVisibility || {};
    g.contentOverrides.purpose = {
      headingLine1: {{ section.settings.heading_line_1 | json }},
      headingLine2: {{ section.settings.heading_line_2 | json }},
      headingLine3: {{ section.settings.heading_line_3 | json }},
      headingLine4: {{ section.settings.heading_line_4 | json }},
      body: {{ section.settings.body | json }},
      point1Title: {{ section.settings.point_1_title | json }},
      point1Body: {{ section.settings.point_1_body | json }},
      point2Title: {{ section.settings.point_2_title | json }},
      point2Body: {{ section.settings.point_2_body | json }},
      point3Title: {{ section.settings.point_3_title | json }},
      point3Body: {{ section.settings.point_3_body | json }},
      point4Title: {{ section.settings.point_4_title | json }},
      point4Body: {{ section.settings.point_4_body | json }}
    };
    g.blockVisibility.purpose = true;
{%- endif -%}
  })();
</script>

{% schema %}
{
  "name": "PDP Purpose",
  "tag": "section",
  "class": "pdp-sec pdp-sec--purpose",
  "settings": [
    {
      "type": "header",
      "content": "Design"
    },
    {
      "type": "select",
      "id": "design_preset",
      "label": "Design preset",
      "options": [
        {
          "value": "inserts",
          "label": "Inserts"
        },
        {
          "value": "breast-form",
          "label": "Breast Form"
        }
      ],
      "default": "inserts",
      "info": "Picks which Replo design this section renders. Must match the other PDP sections on this template."
    },
    {
      "type": "checkbox",
      "id": "headline_poppins",
      "label": "Headline in Poppins only",
      "default": false,
      "info": "Off keeps the Replo design, where one word of the headline is set in Send Flowers. On renders the whole headline in Poppins at the same size as the rest of the line."
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "space_above_desktop",
      "min": 0,
      "max": 120,
      "step": 2,
      "unit": "px",
      "label": "Space above (desktop)",
      "default": 0,
      "info": "Reproduces the gap the original one-piece PDP had between blocks."
    },
    {
      "type": "range",
      "id": "space_above_mobile",
      "min": 0,
      "max": 120,
      "step": 2,
      "unit": "px",
      "label": "Space above (mobile)",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "label": "Padding top",
      "default": 60,
      "info": "Space above the section. Replaces the Replo default (60px)."
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "label": "Padding bottom",
      "default": 80,
      "info": "Space below the section. Replaces the Replo default (80px)."
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "label": "Padding top (mobile)",
      "default": 30,
      "info": "Half the desktop value by default."
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "label": "Padding bottom (mobile)",
      "default": 40,
      "info": "Half the desktop value by default."
    },
    {
      "type": "header",
      "content": "Content",
      "info": "Hidden on both presets. pdp-buybox renders a hidden duplicate of this block carrying the same Replo ids, and it sits earlier in the DOM — so the JS override lands on the copy instead of the visible section. Use the Metafield overrides group below. Fields are kept, not deleted, so no saved values are lost. 'none' is not a real preset: the condition is always false by design.",
      "visible_if": "{{ section.settings.design_preset == 'none' }}"
    },
    {
      "type": "text",
      "id": "heading_line_1",
      "label": "Line 1",
      "info": "e.g. Our",
      "visible_if": "{{ section.settings.design_preset == 'none' }}"
    },
    {
      "type": "text",
      "id": "heading_line_2",
      "label": "Line 2",
      "info": "e.g. Purpose:",
      "visible_if": "{{ section.settings.design_preset == 'none' }}"
    },
    {
      "type": "text",
      "id": "heading_line_3",
      "label": "Line 3",
      "info": "e.g. Raising",
      "visible_if": "{{ section.settings.design_preset == 'none' }}"
    },
    {
      "type": "text",
      "id": "heading_line_4",
      "label": "Line 4",
      "info": "e.g. the Bar",
      "visible_if": "{{ section.settings.design_preset == 'none' }}"
    },
    {
      "type": "richtext",
      "id": "body",
      "label": "Body",
      "visible_if": "{{ section.settings.design_preset == 'none' }}"
    },
    {
      "type": "text",
      "id": "point_1_title",
      "label": "Point 1 title",
      "visible_if": "{{ section.settings.design_preset == 'none' }}"
    },
    {
      "type": "richtext",
      "id": "point_1_body",
      "label": "Point 1 body",
      "visible_if": "{{ section.settings.design_preset == 'none' }}"
    },
    {
      "type": "text",
      "id": "point_2_title",
      "label": "Point 2 title",
      "visible_if": "{{ section.settings.design_preset == 'none' }}"
    },
    {
      "type": "richtext",
      "id": "point_2_body",
      "label": "Point 2 body",
      "visible_if": "{{ section.settings.design_preset == 'none' }}"
    },
    {
      "type": "text",
      "id": "point_3_title",
      "label": "Point 3 title",
      "visible_if": "{{ section.settings.design_preset == 'none' }}"
    },
    {
      "type": "richtext",
      "id": "point_3_body",
      "label": "Point 3 body",
      "visible_if": "{{ section.settings.design_preset == 'none' }}"
    },
    {
      "type": "text",
      "id": "point_4_title",
      "label": "Point 4 title",
      "visible_if": "{{ section.settings.design_preset == 'none' }}"
    },
    {
      "type": "richtext",
      "id": "point_4_body",
      "label": "Point 4 body",
      "visible_if": "{{ section.settings.design_preset == 'none' }}"
    },
    {
      "type": "header",
      "content": "Metafield overrides"
    },
    {
      "type": "paragraph",
      "content": "These normally read from the product’s metafields. Fill one in to hard-code it instead — useful when reusing this section on a product that has no metafields set."
    },
    {
      "type": "image_picker",
      "id": "mf_benefit_section_image",
      "label": "Benefit Section Image",
      "info": "Overrides product metafield custom.benefit_section_image. Leave empty to keep using the metafield."
    },
    {
      "type": "text",
      "id": "mf_benefit_section_image_alt",
      "label": "Benefit Section Image Alt",
      "info": "Alt text for the image above — describes it for screen readers. Overrides product metafield custom.benefit_section_image_alt. Leave empty to keep using the metafield."
    }
  ],
  "presets": [
    {
      "name": "PDP Purpose"
    }
  ]
}
{% endschema %}
