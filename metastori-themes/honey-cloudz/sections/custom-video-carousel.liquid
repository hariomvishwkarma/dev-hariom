{%- liquid
  if section.settings.use_theme_page_width == false
    assign use_theme_width = false
  else
    assign use_theme_width = true
  endif
  assign carousel_full_width = section.settings.carousel_full_width
-%}

{%- style -%}
    #shopify-section-{{ section.id }} .cvc {
      --cvc-bg: {{ section.settings.background_color }};
      --cvc-heading-color: {{ section.settings.heading_color }};
      --cvc-badge-bg: {{ section.settings.badge_background }};
      --cvc-badge-color: {{ section.settings.badge_text_color }};
      --cvc-badge-border: {{ section.settings.badge_border_color }};
      --cvc-star-color: {{ section.settings.star_color }};
      --cvc-slide-width: {{ section.settings.slide_width }}px;
      --cvc-slide-gap: {{ section.settings.slide_gap }}px;
      --cvc-slide-radius: {{ section.settings.slide_radius }}px;
      --cvc-btn-bg: {{ section.settings.button_background }};
      --cvc-btn-color: {{ section.settings.button_text_color }};
      --cvc-btn-width: {{ section.settings.button_width }}px;
      --cvc-btn-height: {{ section.settings.button_height }}px;
      --cvc-btn-radius: {{ section.settings.button_radius }}px;
      --cvc-nav-size: {{ section.settings.nav_button_size }}px;
      --cvc-nav-color: {{ section.settings.nav_color }};
      --cvc-edge-padding: {{ section.settings.edge_padding }}px;
      --cvc-nav-offset: {{ section.settings.nav_edge_offset }}px;
      background-color: var(--cvc-bg);
      padding: {{ section.settings.padding_top }}px 0 {{ section.settings.padding_bottom }}px;
      overflow-x: clip;
    }

    {% unless use_theme_width %}
    #shopify-section-{{ section.id }} .cvc__page-width {
      max-width: {{ section.settings.section_max_width }}px;
      margin: 0 auto;
      padding-inline: 1.5rem;
    }
    {% endunless %}

    #shopify-section-{{ section.id }} .cvc__page-width {
      width: 100%;
      box-sizing: border-box;
    }

    #shopify-section-{{ section.id }} .cvc__header {
      text-align: center;
      margin-bottom: {{ section.settings.header_spacing }}px;
    }

    #shopify-section-{{ section.id }} .cvc__badge {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      flex-wrap: wrap;
      gap: 0.65rem;
      margin: 0 0 3.2rem;
      padding: 0.7rem 1.8rem;
      border: 0.1rem solid var(--cvc-badge-border);
      border-radius: {{ section.settings.badge_radius }}px;
      background-color: var(--cvc-badge-bg);
      color: var(--cvc-badge-color);
      font-size: {{ section.settings.badge_font_size }}px;
      font-weight: {{ section.settings.badge_font_weight }};
      line-height: 1.2;
    }

    #shopify-section-{{ section.id }} .cvc__stars {
      display: inline-flex;
      align-items: center;
      gap: 0.12rem;
      color: var(--cvc-star-color);
    }

    #shopify-section-{{ section.id }} .cvc__stars svg {
      width: {{ section.settings.star_size }}px;
      height: {{ section.settings.star_size }}px;
      display: block;
      flex: 0 0 {{ section.settings.star_size }}px;
    }

    #shopify-section-{{ section.id }} .cvc__heading {
      margin: 0;
      color: var(--cvc-heading-color);
      font-size: {{ section.settings.heading_font_size }}px;
      line-height: 1.15;
      font-weight: {{ section.settings.heading_font_weight }};
      letter-spacing: -0.02em;
      max-width: 724px;
      margin: 0 auto;
    }

    #shopify-section-{{ section.id }} .cvc__carousel-outer {
      position: relative;
      margin: 0 auto;
      padding: 0 calc(var(--cvc-nav-size) + 16px);
      max-width: {{ section.settings.carousel_max_width }}px;
    }

    #shopify-section-{{ section.id }} .cvc__carousel-wrap--full {
      width: 100%;
      max-width: 100%;
      margin: 0;
      padding: 0;
    }

    #shopify-section-{{ section.id }} .cvc__carousel-wrap--full .cvc__carousel-outer {
      max-width: none;
      width: 100%;
      margin: 0;
      padding: 0;
    }

    #shopify-section-{{ section.id }} .cvc__carousel-wrap--full .cvc__track {
      padding-inline: var(--cvc-edge-padding);
    }

    #shopify-section-{{ section.id }} .cvc__carousel-wrap--full .cvc__nav--prev {
      left: var(--cvc-nav-offset);
    }

    #shopify-section-{{ section.id }} .cvc__carousel-wrap--full .cvc__nav--next {
      right: var(--cvc-nav-offset);
    }

    #shopify-section-{{ section.id }} .cvc__carousel-wrap--full.cvc__carousel-wrap--no-nav .cvc__track {
      padding-inline: var(--cvc-edge-padding);
    }

    #shopify-section-{{ section.id }} .cvc__carousel-wrap {
      width: 100%;
    }

    #shopify-section-{{ section.id }} .cvc__viewport {
      overflow: hidden;
      width: 100%;
      cursor: default;
      max-width: max-content;
      margin: 0 auto;
    }

    @media screen and (min-width: 990px) {
      #shopify-section-{{ section.id }} .cvc__viewport {
        cursor: grab;
      }
    }

    #shopify-section-{{ section.id }} .cvc__viewport.is-dragging {
      cursor: grabbing;
    }

    #shopify-section-{{ section.id }} .cvc__track {
      display: flex;
      align-items: stretch;
      gap: var(--cvc-slide-gap);
      will-change: transform;
      transition: transform 0.55s cubic-bezier(0.4, 0, 0.2, 1);
    }

    #shopify-section-{{ section.id }} .cvc__slide {
      flex: 0 0 var(--cvc-slide-width);
      width: var(--cvc-slide-width);
      min-width: 0;
    }

    #shopify-section-{{ section.id }} .cvc__card {
      position: relative;
      display: block;
      width: 100%;
      margin: 0;
      padding: 0;
      border: 0;
      border-radius: var(--cvc-slide-radius);
      overflow: hidden;
      background: #111;
      cursor: pointer;
      aspect-ratio: {{ section.settings.slide_aspect_ratio }};
      box-shadow: 0 8px 28px rgba(33, 35, 38, 0.1);
      transition: transform 0.3s ease, box-shadow 0.3s ease;
    }

    #shopify-section-{{ section.id }} .cvc__card:hover,
    #shopify-section-{{ section.id }} .cvc__card:focus-visible {
      transform: translateY(-4px);
      box-shadow: 0 14px 36px rgba(33, 35, 38, 0.14);
      outline: none;
    }

    #shopify-section-{{ section.id }} .cvc__video,
    #shopify-section-{{ section.id }} .cvc__poster {
      display: block;
      width: 100%;
      height: 100%;
      object-fit: cover;
      pointer-events: none;
    }

    #shopify-section-{{ section.id }} .cvc__play {
      position: absolute;
      inset: 0;
      display: flex;
      align-items: center;
      justify-content: center;
      background: rgba(0, 0, 0, 0.08);
      color: #fff;
      transition: opacity 0.25s ease, visibility 0.25s ease;
      pointer-events: none;
    }

    #shopify-section-{{ section.id }} .cvc__play svg {
      width: 56px;
      height: 56px;
      display: block;
      filter: drop-shadow(0 2px 8px rgba(0, 0, 0, 0.25));
    }

    #shopify-section-{{ section.id }} .cvc__card.is-playing .cvc__play {
      opacity: 0;
      visibility: hidden;
    }

    #shopify-section-{{ section.id }} .cvc__nav {
      position: absolute;
      top: 50%;
      transform: translateY(-50%);
      z-index: 4;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: auto;
      height: auto;
      padding: 0.25rem;
      border: 0;
      border-radius: 0;
      background: transparent;
      color: var(--cvc-nav-color);
      box-shadow: none;
      cursor: pointer;
      transition: opacity 0.2s ease;
    }

    #shopify-section-{{ section.id }} .cvc__nav:hover {
      opacity: 0.55;
    }

    #shopify-section-{{ section.id }} .cvc__nav:disabled {
      opacity: 0.2;
      cursor: not-allowed;
    }

    #shopify-section-{{ section.id }} .cvc__nav svg {
      width: var(--cvc-nav-size);
      height: var(--cvc-nav-size);
      display: block;
    }

    #shopify-section-{{ section.id }} .cvc__nav--prev {
      left: 0;
    }

    #shopify-section-{{ section.id }} .cvc__nav--next {
      right: 0;
    }

    #shopify-section-{{ section.id }} .cvc__nav--hidden {
      display: none;
    }

    #shopify-section-{{ section.id }} .cvc__footer {
      margin-top: {{ section.settings.button_spacing }}px;
      text-align: center;
    }

    #shopify-section-{{ section.id }} .cvc__btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: auto;
      min-width: auto;
      padding: 1rem 3rem;
      border-radius: var(--cvc-btn-radius);
      background: var(--cvc-btn-bg);
      color: var(--cvc-btn-color);
      font-size: {{ section.settings.button_font_size }}px;
      font-weight: {{ section.settings.button_font_weight }};
      line-height: 1.2;
      text-decoration: none;
      transition: opacity 0.2s ease, transform 0.2s ease;
      text-transform: capitalize;
    }

    #shopify-section-{{ section.id }} .cvc__modal {
      position: fixed;
      inset: 0;
      z-index: 9999;
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 1.5rem;
      background: rgba(0, 0, 0, 0.88);
      opacity: 0;
      visibility: hidden;
      transition: opacity 0.3s ease, visibility 0.3s ease;
    }

    #shopify-section-{{ section.id }} .cvc__modal.is-open {
      opacity: 1;
      visibility: visible;
    }

    #shopify-section-{{ section.id }} .cvc__modal-inner {
      position: relative;
      width: min(92vw, 420px);
      max-height: 92vh;
      border-radius: 20px;
      overflow: hidden;
      background: #000;
      box-shadow: 0 24px 64px rgba(0, 0, 0, 0.45);
    }

    #shopify-section-{{ section.id }} .cvc__modal-video {
      display: block;
      width: 100%;
      height: auto;
      max-height: 92vh;
      object-fit: contain;
      background: #000;
    }

    #shopify-section-{{ section.id }} .cvc__modal-close {
      position: absolute;
      top: 12px;
      right: 12px;
      z-index: 2;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: 40px;
      height: 40px;
      padding: 0;
      border: 0;
      border-radius: 50%;
      background: rgba(255, 255, 255, 0.92);
      color: #212326;
      font-size: 24px;
      line-height: 1;
      cursor: pointer;
    }
    @media screen and (max-width: 1200px) {
      #shopify-section-{{ section.id }} .cvc {
        padding-top: 4.8rem;
      }
      #shopify-section-{{ section.id }} .cvc__footer{
        margin-top: 40px;
      }
    }
    @media screen and (max-width: 989px) {
      #shopify-section-{{ section.id }} .cvc__heading {
        font-size: {{ section.settings.heading_font_size_tablet }}px;
      }

      #shopify-section-{{ section.id }} .cvc__carousel-outer {
        padding: 0 calc(var(--cvc-nav-size) + 8px);
      }

      #shopify-section-{{ section.id }} .cvc__carousel-wrap--full .cvc__carousel-outer {
        padding: 0;
      }

      #shopify-section-{{ section.id }} .cvc__carousel-wrap--full .cvc__nav--prev {
        left: var(--cvc-nav-offset);
      }

      #shopify-section-{{ section.id }} .cvc__carousel-wrap--full .cvc__nav--next {
        right: var(--cvc-nav-offset);
      }
    }

    @media screen and (max-width: 749px) {
      #shopify-section-{{ section.id }} .cvc__heading {
        font-size: {{ section.settings.heading_font_size_mobile }}px;
      }
      #shopify-section-{{ section.id }} .cvc__nav svg {
        width: 40px;
        height: 40px;
      }
      #shopify-section-{{ section.id }} .cvc {
        --cvc-slide-width: {{ section.settings.slide_width_mobile }}px;
      }
    #shopify-section-{{ section.id }} .cvc__badge {
        flex-wrap: wrap;
        gap: 0.5rem;
        padding: 0.5rem;
        font-size: 1.3rem;
        font-weight: 400;
        line-height: normal;
    }
    #shopify-section-{{ section.id }} .cvc__stars svg{
        width: 16px;
        height: 16px;
        max-width: 16px;
    }
  }
{%- endstyle -%}

<div
  class="cvc"
  data-cvc-root
  data-slides-desktop="{{ section.settings.slides_desktop }}"
  data-slides-tablet="{{ section.settings.slides_tablet }}"
  data-slides-mobile="{{ section.settings.slides_mobile }}"
  data-carousel-full-width="{{ carousel_full_width }}"
  data-enable-wheel="{{ section.settings.enable_wheel_scroll }}"
>
  <div class="cvc__page-width{% if use_theme_width %} page-width{% endif %}">
    <div class="cvc__header">
      {%- if section.settings.show_rating_badge -%}
        <div class="cvc__badge">
          {%- if section.settings.show_stars -%}
            <span class="cvc__stars" aria-hidden="true">
              {%- for i in (1..5) -%}
                <svg viewBox="0 0 16 16" xmlns="http://www.w3.org/2000/svg" fill="currentColor">
                  <path d="M8 1.2L9.9 5.8L14.8 6.1L11.1 9.2L12.2 14.1L8 11.6L3.8 14.1L4.9 9.2L1.2 6.1L6.1 5.8L8 1.2Z"/>
                </svg>
              {%- endfor -%}
            </span>
          {%- endif -%}
          <span>{{ section.settings.rating_text | escape }}</span>
        </div>
      {%- endif -%}

      {%- if section.settings.heading != blank -%}
        <{{ section.settings.heading_tag }} class="cvc__heading">
          {{ section.settings.heading | escape }}
        </{{ section.settings.heading_tag }}>
      {%- endif -%}
    </div>
  </div>

  {%- if section.blocks.size > 0 -%}
    <div class="cvc__carousel-wrap{% if carousel_full_width %} cvc__carousel-wrap--full{% endif %}{% unless section.settings.show_nav_arrows %} cvc__carousel-wrap--no-nav{% endunless %}">
      {%- unless carousel_full_width -%}
        <div class="cvc__page-width{% if use_theme_width %} page-width{% endif %}">
      {%- endunless -%}
      <div class="cvc__carousel-outer">
        {%- if section.settings.show_nav_arrows -%}
          <button type="button" class="cvc__nav cvc__nav--prev" data-cvc-prev aria-label="Previous videos">
            <svg xmlns="http://www.w3.org/2000/svg" width="60" height="60" viewBox="0 0 60 60" fill="none">
              <path d="M60 30C60 24.0666 58.2405 18.2664 54.9441 13.3329C51.6476 8.39943 46.9623 4.55426 41.4805 2.28363C35.9987 0.0130005 29.9667 -0.581097 24.1473 0.576458C18.3279 1.73401 12.9824 4.59124 8.78681 8.78681C4.59124 12.9824 1.73401 18.3279 0.576458 24.1473C-0.581097 29.9667 0.0130005 35.9987 2.28363 41.4805C4.55426 46.9623 8.39943 51.6476 13.3329 54.9441C18.2664 58.2405 24.0666 60 30 60C37.9565 60 45.5871 56.8393 51.2132 51.2132C56.8393 45.5871 60 37.9565 60 30ZM47.1429 32.1429H21.1072L33.0643 44.1579L30 47.1429L12.8572 30L30 12.8572L33.0643 15.915L21.1072 27.8572L47.1429 27.8572V32.1429Z" fill="white"/>
            </svg>
          </button>
        {%- endif -%}

        <div class="cvc__viewport" data-cvc-viewport>
          <div class="cvc__track" data-cvc-track>
            {%- for block in section.blocks -%}
              {%- liquid
                assign has_shopify_video = false
                assign has_mp4 = false
                if block.settings.video != blank
                  assign has_shopify_video = true
                elsif block.settings.video_url != blank
                  assign has_mp4 = true
                endif
              -%}
              <div class="cvc__slide" data-cvc-slide {{ block.shopify_attributes }}>
                <button
                  type="button"
                  class="cvc__card"
                  data-cvc-card
                  {% if has_shopify_video or has_mp4 %}
                    data-has-video="true"
                  {% endif %}
                  aria-label="Play video {{ forloop.index }}"
                >
                  {%- if has_shopify_video -%}
                    {{
                      block.settings.video
                      | video_tag:
                        image_size: '600x',
                        autoplay: false,
                        loop: true,
                        muted: true,
                        playsinline: true,
                        controls: false,
                        preload: 'metadata',
                        class: 'cvc__video'
                    }}
                  {%- elsif has_mp4 -%}
                    <video
                      class="cvc__video"
                      src="{{ block.settings.video_url }}"
                      muted
                      loop
                      playsinline
                      preload="metadata"
                      {% if block.settings.poster != blank %}
                        poster="{{ block.settings.poster | image_url: width: 800 }}"
                      {% endif %}
                    ></video>
                  {%- elsif block.settings.poster != blank -%}
                    {{
                      block.settings.poster
                      | image_url: width: 800
                      | image_tag:
                        loading: 'lazy',
                        class: 'cvc__poster',
                        widths: '300, 400, 600, 800',
                        alt: block.settings.poster.alt
                      | default: 'Video preview'
                      | escape
                    }}
                  {%- else -%}
                    <div class="cvc__poster" style="background:#ddd; width:100%; height:100%;"></div>
                  {%- endif -%}

                  <span class="cvc__play" aria-hidden="true">
                    <svg viewBox="0 0 64 64" fill="none" xmlns="http://www.w3.org/2000/svg">
                      <circle cx="32" cy="32" r="31" stroke="currentColor" stroke-width="2" fill="rgba(255,255,255,0.22)"/>
                      <path d="M26 21L44 32L26 43V21Z" fill="currentColor"/>
                    </svg>
                  </span>
                </button>
              </div>
            {%- endfor -%}
          </div>
        </div>

        {%- if section.settings.show_nav_arrows -%}
          <button type="button" class="cvc__nav cvc__nav--next" data-cvc-next aria-label="Next videos">
            <svg xmlns="http://www.w3.org/2000/svg" width="60" height="60" viewBox="0 0 60 60" fill="none">
              <path d="M0 30C0 35.9334 1.75947 41.7336 5.05591 46.6671C8.35235 51.6006 13.0377 55.4457 18.5195 57.7164C24.0013 59.987 30.0333 60.5811 35.8527 59.4235C41.6721 58.266 47.0176 55.4088 51.2132 51.2132C55.4088 47.0176 58.266 41.6721 59.4235 35.8527C60.5811 30.0333 59.987 24.0013 57.7164 18.5195C55.4457 13.0377 51.6006 8.35235 46.6671 5.05591C41.7336 1.75947 35.9334 0 30 0C22.0435 0 14.4129 3.1607 8.78679 8.78679C3.1607 14.4129 0 22.0435 0 30ZM12.8571 27.8571H38.8928L26.9357 15.8421L30 12.8571L47.1428 30L30 47.1428L26.9357 44.085L38.8928 32.1428H12.8571V27.8571Z" fill="white"/>
            </svg>
          </button>
        {%- endif -%}
      </div>
      {%- unless carousel_full_width -%}
        </div>
      {%- endunless -%}
    </div>
  {%- endif -%}

  {%- if section.settings.button_label != blank -%}
    <div class="cvc__page-width{% if use_theme_width %} page-width{% endif %}">
      <div class="cvc__footer">
        <a
          class="button button--medium cvc__btn"
          {% if section.settings.button_link != blank %}
            href="{{ section.settings.button_link }}"
          {% else %}
            role="link" aria-disabled="true"
          {% endif %}
        >
          {{ section.settings.button_label | escape }}
        </a>
      </div>
    </div>
  {%- endif -%}

  <div
    class="cvc__modal"
    data-cvc-modal
    hidden
    aria-hidden="true"
    role="dialog"
    aria-modal="true"
    aria-label="Video player"
  >
    <div class="cvc__modal-inner">
      <button type="button" class="cvc__modal-close" data-cvc-modal-close aria-label="Close video">&times;</button>
      <div data-cvc-modal-media></div>
    </div>
  </div>
</div>

<script>
  (function () {
    const root = document.querySelector('#shopify-section-{{ section.id }} [data-cvc-root]');
    if (!root || root.dataset.cvcInit === 'true') return;
    root.dataset.cvcInit = 'true';

    const track = root.querySelector('[data-cvc-track]');
    const viewport = root.querySelector('[data-cvc-viewport]');
    const prevBtn = root.querySelector('[data-cvc-prev]');
    const nextBtn = root.querySelector('[data-cvc-next]');
    const modal = root.querySelector('[data-cvc-modal]');
    const modalMedia = root.querySelector('[data-cvc-modal-media]');
    const modalClose = root.querySelector('[data-cvc-modal-close]');
    const cards = Array.from(root.querySelectorAll('[data-cvc-card]'));

    if (!track || cards.length === 0) return;

    let index = 0;
    let slidesPerView = 5;
    let maxIndex = 0;
    let slideStep = 0;
    let maxOffset = 0;
    let modalVideo = null;
    const isFullWidth = root.dataset.carouselFullWidth === 'true';
    const enableWheel = root.dataset.enableWheel === 'true';

    function goPrev() {
      if (index <= 0) return;
      pauseAllCards();
      index -= 1;
      updateCarousel(true);
    }

    function goNext() {
      if (index >= maxIndex) return;
      pauseAllCards();
      index += 1;
      updateCarousel(true);
    }

    function getSlidesPerView() {
      const w = window.innerWidth;
      if (w <= 749) return parseInt(root.dataset.slidesMobile, 10) || 1;
      if (w <= 989) return parseInt(root.dataset.slidesTablet, 10) || 3;
      return parseInt(root.dataset.slidesDesktop, 10) || 5;
    }

    function pauseAllCards() {
      cards.forEach(function (card) {
        const video = card.querySelector('video');
        if (!video) return;
        video.pause();
        try {
          video.currentTime = 0;
        } catch (e) {}
        card.classList.remove('is-playing');
      });
    }

    function measure() {
      slidesPerView = getSlidesPerView();
      const slide = track.querySelector('[data-cvc-slide]');
      if (!slide || !viewport) return;
      const styles = getComputedStyle(track);
      const gap = parseFloat(styles.gap) || 0;
      slideStep = slide.offsetWidth + gap;

      if (isFullWidth) {
        const viewportWidth = viewport.offsetWidth;
        const visibleSlides = viewportWidth / slideStep;
        maxIndex = Math.max(0, Math.ceil(cards.length - visibleSlides));
        maxOffset = Math.max(0, track.scrollWidth - viewportWidth);
      } else {
        maxIndex = Math.max(0, cards.length - slidesPerView);
        maxOffset = maxIndex * slideStep;
      }

      if (index > maxIndex) index = maxIndex;
      updateCarousel(false);
    }

    function getScrollOffset() {
      if (index <= 0) return 0;
      if (!viewport) return index * slideStep;

      const viewportWidth = viewport.offsetWidth;
      maxOffset = Math.max(0, track.scrollWidth - viewportWidth);

      if (index >= maxIndex) return maxOffset;
      return Math.min(index * slideStep, maxOffset);
    }

    function updateCarousel(animate) {
      if (animate === false) {
        track.style.transition = 'none';
      } else {
        track.style.transition = '';
      }
      track.style.transform = 'translateX(-' + getScrollOffset() + 'px)';
      if (prevBtn) prevBtn.disabled = index <= 0;
      if (nextBtn) nextBtn.disabled = index >= maxIndex;
      requestAnimationFrame(function () {
        track.style.transition = '';
      });
    }

    function openModalFromCard(card) {
      const sourceVideo = card.querySelector('video');
      if (!sourceVideo || !modal || !modalMedia) return;

      pauseAllCards();
      modalMedia.innerHTML = '';

      const video = document.createElement('video');
      video.className = 'cvc__modal-video';
      video.controls = true;
      video.playsInline = true;
      video.autoplay = true;

      if (sourceVideo.querySelector('source')) {
        sourceVideo.querySelectorAll('source').forEach(function (source) {
          const clone = document.createElement('source');
          clone.src = source.src;
          clone.type = source.type;
          video.appendChild(clone);
        });
      } else if (sourceVideo.currentSrc || sourceVideo.src) {
        video.src = sourceVideo.currentSrc || sourceVideo.src;
      } else {
        return;
      }

      modalMedia.appendChild(video);
      modalVideo = video;
      modal.hidden = false;
      modal.setAttribute('aria-hidden', 'false');
      modal.classList.add('is-open');
      document.body.style.overflow = 'hidden';
      video.play().catch(function () {});
    }

    function closeModal() {
      if (!modal) return;
      if (modalVideo) {
        modalVideo.pause();
        modalVideo.removeAttribute('src');
        modalVideo.load();
        modalVideo = null;
      }
      if (modalMedia) modalMedia.innerHTML = '';
      modal.classList.remove('is-open');
      modal.hidden = true;
      modal.setAttribute('aria-hidden', 'true');
      document.body.style.overflow = '';
    }

    cards.forEach(function (card) {
      const video = card.querySelector('video');
      if (!video) return;

      card.addEventListener('mouseenter', function () {
        video
          .play()
          .then(function () {
            card.classList.add('is-playing');
          })
          .catch(function () {});
      });

      card.addEventListener('mouseleave', function () {
        video.pause();
        try {
          video.currentTime = 0;
        } catch (e) {}
        card.classList.remove('is-playing');
      });

      card.addEventListener('click', function () {
        openModalFromCard(card);
      });
    });

    if (prevBtn) {
      prevBtn.addEventListener('click', goPrev);
    }

    if (nextBtn) {
      nextBtn.addEventListener('click', goNext);
    }

    if (modalClose) modalClose.addEventListener('click', closeModal);
    if (modal) {
      modal.addEventListener('click', function (event) {
        if (event.target === modal) closeModal();
      });
    }

    document.addEventListener('keydown', function (event) {
      if (event.key === 'Escape') closeModal();
    });

    let touchStartX = 0;
    if (viewport) {
      viewport.addEventListener(
        'touchstart',
        function (event) {
          touchStartX = event.changedTouches[0].screenX;
        },
        { passive: true }
      );

      viewport.addEventListener(
        'touchend',
        function (event) {
          if (window.innerWidth <= 989) return;

          const diff = event.changedTouches[0].screenX - touchStartX;
          if (Math.abs(diff) < 40) return;
          if (diff > 0) goPrev();
          else goNext();
        },
        { passive: true }
      );

      if (enableWheel) {
        let wheelLocked = false;
        let wheelTimer = null;

        viewport.addEventListener(
          'wheel',
          function (event) {
            if (window.innerWidth <= 989) return;

            const delta = Math.abs(event.deltaX) > Math.abs(event.deltaY) ? event.deltaX : event.deltaY;
            if (!delta) return;
            event.preventDefault();
            if (wheelLocked) return;

            if (delta > 0) goNext();
            else goPrev();

            wheelLocked = true;
            clearTimeout(wheelTimer);
            wheelTimer = setTimeout(function () {
              wheelLocked = false;
            }, 400);
          },
          { passive: false }
        );
      }
    }

    measure();
    window.addEventListener('resize', measure);

    document.addEventListener('shopify:section:load', function (event) {
      if (event.detail.sectionId === '{{ section.id }}') {
        root.dataset.cvcInit = 'false';
      }
    });
  })();
</script>

