{% schema %}
  {
    "name": "Six Column Section",
    "settings": [
      {
        "type": "text",
        "id": "heading",
        "label": "Section Heading",
        "default": "Your Heading Here"
      },
      {
        "type": "image_picker",
        "id": "image_1",
        "label": "Column 1 Image"
      },
      {
        "type": "text",
        "id": "text_1",
        "label": "Column 1 Text"
      },
      {
        "type": "image_picker",
        "id": "image_2",
        "label": "Column 2 Image"
      },
      {
        "type": "text",
        "id": "text_2",
        "label": "Column 2 Text"
      },
      {
        "type": "image_picker",
        "id": "image_3",
        "label": "Column 3 Image"
      },
      {
        "type": "text",
        "id": "text_3",
        "label": "Column 3 Text"
      },
      {
        "type": "image_picker",
        "id": "image_4",
        "label": "Column 4 Image"
      },
      {
        "type": "text",
        "id": "text_4",
        "label": "Column 4 Text"
      },
      {
        "type": "image_picker",
        "id": "image_5",
        "label": "Column 5 Image"
      },
      {
        "type": "text",
        "id": "text_5",
        "label": "Column 5 Text"
      },
      {
        "type": "image_picker",
        "id": "image_6",
        "label": "Column 6 Image"
      },
      {
        "type": "text",
        "id": "text_6",
        "label": "Column 6 Text"
      }
    ],
    "presets": [
      {
        "name": "Six Columns",
        "category": "Custom Sections"
      }
    ]
  }
{% endschema %}

<div class="six-columns-section">
  <h2>{{ section.settings.heading }}</h2>
  <div class="columns">
    <div class="column">
      <img src="{{ section.settings.image_1 | img_url: 'medium' }}" alt="Access Daily Logol">
      <p>{{ section.settings.text_1 }}</p>
    </div>
    <div class="column">
      <img src="{{ section.settings.image_2 | img_url: 'medium' }}" alt="Trail Runner Magazine Logo">
      <p>{{ section.settings.text_2 }}</p>
    </div>
    <div class="column">
      <img src="{{ section.settings.image_3 | img_url: 'medium' }}" alt="Oprah Magazine Logo">
      <p>{{ section.settings.text_3 }}</p>
    </div>
    <div class="column">
      <img src="{{ section.settings.image_4 | img_url: 'medium' }}" alt="Rachel Ray Logo">
      <p>{{ section.settings.text_4 }}</p>
    </div>
    <div class="column">
      <img src="{{ section.settings.image_5 | img_url: 'medium' }}" alt="The View Logo">
      <p>{{ section.settings.text_5 }}</p>
    </div>
    <div class="column">
      <img src="{{ section.settings.image_6 | img_url: 'medium' }}" alt="Brit + Co Logo">
      <p>{{ section.settings.text_6 }}</p>
    </div>
  </div>
</div>

<style>
  .six-columns-section {
    text-align: center;
    margin: 40px 0;
  }

  .six-columns-section .columns {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-around;
  }

  .six-columns-section .column {
    flex: 1 1 calc(100% / 6);
    padding: 0 10px;
    box-sizing: border-box;
  }

  .six-columns-section img {
    width: 100%;
    max-width: 150px; /* Adjust based on your layout */
    height: auto;
  }

  @media (max-width: 768px) {
    .six-columns-section .column {
      flex: 1 1 calc(100% / 2); /* Two columns per row on smaller screens */
    }
  }

  @media (max-width: 480px) {
    .six-columns-section .column {
      flex: 1 1 calc(100% / 1); /* Full-width on mobile */
    }
  }
</style>
