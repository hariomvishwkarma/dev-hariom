<results-list
  class="section  " 
  section-id="{{ section.id }}"
>


  <div class="collection-wrapper grid gap-style">
    <div class="">
      {% render 'custom-search-bar' %}
    </div>

      {% comment %} {% render 'filters',
        results: collection,
        results_size: collection.products_count,
        filters: collection.filters
      %} {% endcomment %}

    <div class="product-grid-container">    

      <h4 class="products-total">Showing {{ collections['all'].products_count }} products</h4>
        
      <div class="product-grid">
        {% for product in collections['all'].all_products %}
          <li
            class="product-grid__item product-grid__item--{{ forloop.index0 }}"
            data-product-id="{{ product.id }}"
          >
            {% render 'product-card', product: product %}
          </li>
        {% endfor %}

      </div>
    </div>

  </div>
</results-list>

{% stylesheet %}
.product-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 30px;
}
.product-grid-container {
  display: flex;
  flex-flow: column;
}
h4.products-total {
  margin-left: auto;
  text-transform: uppercase;
}
{% endstylesheet %}


{% schema %}
{
  "name": "Main collection",
  "enabled_on": {
    "templates": ["collection"]
  },
  "settings": [
    
  ],
  "presets": [
    {
      "name": "Main Collection",
      "settings": {

      }
    }
  ]
}
{% endschema %}
