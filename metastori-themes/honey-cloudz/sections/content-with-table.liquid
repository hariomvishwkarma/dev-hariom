{%- liquid
  case section.settings.heading_alignment
    when 'left'
      assign heading_align = 'left'
    when 'right'
      assign heading_align = 'right'
    else
      assign heading_align = 'center'
  endcase

  assign mobile_layout = section.settings.mobile_layout
  if mobile_layout == blank
    assign mobile_layout = 'scroll'
  endif

  assign show_mobile_scrollbar = section.settings.show_mobile_scrollbar
  assign show_mobile_scroll_arrow = section.settings.show_mobile_scroll_arrow
-%}

{%- style -%}
  #shopify-section-{{ section.id }} .cwt {
    --cwt-bg: {{ section.settings.background_color }};
    --cwt-heading-color: {{ section.settings.heading_color }};
    --cwt-heading-size: {{ section.settings.heading_font_size }}px;
    --cwt-heading-weight: {{ section.settings.heading_font_weight }};
    --cwt-max-width: {{ section.settings.content_max_width }}px;
    --cwt-table-radius: {{ section.settings.table_border_radius }}px;
    --cwt-table-border: {{ section.settings.table_border_color }};
    --cwt-header-bg: {{ section.settings.header_background }};
    --cwt-header-color: {{ section.settings.header_text_color }};
    --cwt-row-bg-1: {{ section.settings.row_background_1 }};
    --cwt-row-bg-2: {{ section.settings.row_background_2 }};
    --cwt-feature-color: {{ section.settings.feature_text_color }};
    --cwt-col2-color: {{ section.settings.column_2_text_color }};
    --cwt-col3-color: {{ section.settings.column_3_text_color }};
    --cwt-cell-padding-y: {{ section.settings.cell_padding_y }}px;
    --cwt-cell-padding-x: {{ section.settings.cell_padding_x }}px;
    --cwt-icon-size: {{ section.settings.icon_size }}px;
    --cwt-check-bg: {{ section.settings.check_icon_background }};
    --cwt-check-color: {{ section.settings.check_icon_color }};
    --cwt-cross-bg: {{ section.settings.cross_icon_background }};
    --cwt-cross-color: {{ section.settings.cross_icon_color }};
    --cwt-btn-bg: {{ section.settings.button_background }};
    --cwt-btn-color: {{ section.settings.button_text_color }};
    --cwt-btn-radius: {{ section.settings.button_border_radius }}px;
    --cwt-feature-size: {{ section.settings.feature_font_size }}px;
    --cwt-cell-size: {{ section.settings.cell_font_size }}px;
    --cwt-header-size: {{ section.settings.header_font_size }}px;
    padding: {{ section.settings.padding_top }}px 1.5rem {{ section.settings.padding_bottom }}px;
    background-color: var(--cwt-bg);
  }

  #shopify-section-{{ section.id }} .cwt__inner {
    max-width: var(--cwt-max-width);
    margin: 0 auto;
  }

  #shopify-section-{{ section.id }} .cwt__header {
    margin: 0 0 {{ section.settings.heading_spacing }}px;
    text-align: {{ heading_align }};
  }

  #shopify-section-{{ section.id }} .cwt__title {
    margin: 0;
    color: var(--cwt-heading-color);
    font-size: var(--cwt-heading-size);
    font-weight: var(--cwt-heading-weight);
    line-height: 1.2;
    max-width: 680px;
    margin: 0 auto;
  }

  #shopify-section-{{ section.id }} .cwt__table-wrap {
    border-radius: var(--cwt-table-radius);
    border: 0.1rem solid var(--cwt-table-border);
    overflow: hidden;
    background-color: #fff;
  }
  .custom-post-op-new #shopify-section-{{ section.id }} .cwt__table-wrap{
    border:1px solid #000000;
  }

  #shopify-section-{{ section.id }} .cwt__table-wrap--has-arrow {
    position: relative;
  }

  #shopify-section-{{ section.id }} .cwt__table-scroll {
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
  }

  #shopify-section-{{ section.id }} .cwt__table-scroll::-webkit-scrollbar {
    display: none;
  }

  #shopify-section-{{ section.id }} .cwt__scroll-btn {
    display: none;
  }

  #shopify-section-{{ section.id }} .cwt__table {
    width: 100%;
    border-collapse: collapse;
    min-width: {% if mobile_layout == 'scroll' %}64rem{% else %}100%{% endif %};
  }

  #shopify-section-{{ section.id }} .cwt__table thead th {
    background-color: var(--cwt-header-bg);
    color: var(--cwt-header-color);
    font-size: var(--cwt-header-size);
    font-weight: {{ section.settings.header_font_weight }};
    text-align: left;
    padding: var(--cwt-cell-padding-y) var(--cwt-cell-padding-x);
    vertical-align: middle;
  }

  #shopify-section-{{ section.id }} .cwt__table thead th:first-child {
    width: 22%;
    text-align: left;
  }

  #shopify-section-{{ section.id }} .cwt__table tbody tr:nth-child(odd) {
    background-color: var(--cwt-row-bg-1);
  }

  #shopify-section-{{ section.id }} .cwt__table tbody tr:nth-child(even) {
    background-color: var(--cwt-row-bg-2);
  }

  #shopify-section-{{ section.id }} .cwt__table td {
    padding: var(--cwt-cell-padding-y) var(--cwt-cell-padding-x);
    vertical-align: middle;
    font-size: var(--cwt-cell-size);
    line-height: 1.45;
    border-top: 0.1rem solid var(--cwt-table-border);
  }

  #shopify-section-{{ section.id }} .cwt__feature {
    color: var(--cwt-feature-color);
    font-size: var(--cwt-feature-size);
    font-weight: {{ section.settings.feature_font_weight }};
    text-align: left;
  }

  #shopify-section-{{ section.id }} .cwt__cell {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 1rem;
    text-align: left;
  }

  #shopify-section-{{ section.id }} .cwt__cell--col2 {
    color: var(--cwt-col2-color);
  }

  #shopify-section-{{ section.id }} .cwt__cell--col3 {
    color: var(--cwt-col3-color);
  }

  #shopify-section-{{ section.id }} .cwt__icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex: 0 0 var(--cwt-icon-size);
    width: var(--cwt-icon-size);
    height: var(--cwt-icon-size);
    border-radius: 50%;
  }

  #shopify-section-{{ section.id }} .cwt__icon--check {
    background-color: var(--cwt-check-bg);
    color: var(--cwt-check-color);
  }

  #shopify-section-{{ section.id }} .cwt__icon--cross {
    background-color: var(--cwt-cross-bg);
    color: var(--cwt-cross-color);
  }

  #shopify-section-{{ section.id }} .cwt__icon svg {
    width: calc(var(--cwt-icon-size) * 0.5);
    height: calc(var(--cwt-icon-size) * 0.5);
    display: block;
  }

  #shopify-section-{{ section.id }} .cwt__cell-text {
    flex: 1;
    min-width: 0;
  }

  #shopify-section-{{ section.id }} .cwt__button-wrap {
    margin-top: {{ section.settings.button_spacing }}px;
    text-align: {{ section.settings.button_alignment }};
  }

  #shopify-section-{{ section.id }} .cwt__button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 5rem;
    min-width: auto;
    padding:1rem 3rem;
    border-radius: var(--cwt-btn-radius);
    background-color: var(--cwt-btn-bg);
    color: var(--cwt-btn-color);
    font-size: {{ section.settings.button_font_size }}px;
    font-weight: {{ section.settings.button_font_weight }};
    text-decoration: none;
    line-height: 1.2;
    transition: opacity 0.2s ease;
    text-transform: capitalize;
  }

  {%- for block in section.blocks -%}
    {%- if block.settings.icon_size > 0 -%}
      #shopify-section-{{ section.id }} .cwt__row--{{ block.id }} .cwt__icon {
        flex-basis: {{ block.settings.icon_size }}px;
        width: {{ block.settings.icon_size }}px;
        height: {{ block.settings.icon_size }}px;
      }

      #shopify-section-{{ section.id }} .cwt__row--{{ block.id }} .cwt__icon svg {
        width: calc({{ block.settings.icon_size }}px * 0.5);
        height: calc({{ block.settings.icon_size }}px * 0.5);
      }
    {%- endif -%}
  {%- endfor -%}
  @media screen and (max-width: 1200px) {
    #shopify-section-{{ section.id }} .cwt {
        padding-top: 4.8rem;
        padding-bottom: 4.8rem;
    }
    #shopify-section-{{ section.id }} .cwt__button-wrap{
      margin-top:40px;
    }
    #shopify-section-{{ section.id }} .cwt__table{
      min-width: 100% ;
    }
  }
  @media screen and (max-width: 749px) {
    #shopify-section-{{ section.id }} .cwt__title {
      font-size: 2.94rem;
    }

    {% if mobile_layout == 'stack' %}
      #shopify-section-{{ section.id }} .cwt__table,
      #shopify-section-{{ section.id }} .cwt__table thead,
      #shopify-section-{{ section.id }} .cwt__table tbody,
      #shopify-section-{{ section.id }} .cwt__table th,
      #shopify-section-{{ section.id }} .cwt__table td,
      #shopify-section-{{ section.id }} .cwt__table tr {
        display: block;
        width: 100%;
        min-width: 0;
      }

      #shopify-section-{{ section.id }} .cwt__table thead {
        display: none;
      }

      #shopify-section-{{ section.id }} .cwt__table tbody tr {
        border-top: 0.1rem solid var(--cwt-table-border);
        padding: 1.2rem var(--cwt-cell-padding-x);
      }

      #shopify-section-{{ section.id }} .cwt__table tbody tr:first-child {
        border-top: 0;
      }

      #shopify-section-{{ section.id }} .cwt__table td {
        border: 0;
        padding: 0.8rem 0;
      }

      #shopify-section-{{ section.id }} .cwt__table td::before {
        content: attr(data-label);
        display: block;
        font-size: 1.2rem;
        font-weight: 600;
        margin-bottom: 0.6rem;
        color: var(--cwt-header-bg);
      }

      #shopify-section-{{ section.id }} .cwt__table td.cwt__feature::before {
        display: none;
      }

      #shopify-section-{{ section.id }} .cwt__cell {
        justify-content: flex-start;
      }
    {% else %}
      #shopify-section-{{ section.id }} .cwt__table thead th:first-child,
      #shopify-section-{{ section.id }} .cwt__table .cwt__feature {
        position: sticky;
        left: 0;
        z-index: 1;
      }

      #shopify-section-{{ section.id }} .cwt__table thead th:first-child {
        background-color: var(--cwt-header-bg);
      }

      #shopify-section-{{ section.id }} .cwt__table tbody tr:nth-child(odd) .cwt__feature {
        background-color: var(--cwt-row-bg-1);
      }

      #shopify-section-{{ section.id }} .cwt__table tbody tr:nth-child(even) .cwt__feature {
        background-color: var(--cwt-row-bg-2);
      }

      {% if show_mobile_scrollbar %}
        #shopify-section-{{ section.id }} .cwt__table-scroll {
          scrollbar-width: thin;
          scrollbar-color: {{ section.settings.mobile_scrollbar_thumb_color }} {{ section.settings.mobile_scrollbar_track_color }};
          padding-bottom: 0.35rem;
        }

        #shopify-section-{{ section.id }} .cwt__table-scroll::-webkit-scrollbar {
          display: block;
          height: {{ section.settings.mobile_scrollbar_height }}px;
        }

        #shopify-section-{{ section.id }} .cwt__table-scroll::-webkit-scrollbar-thumb {
          background: {{ section.settings.mobile_scrollbar_thumb_color }};
          border-radius: 999px;
        }

        #shopify-section-{{ section.id }} .cwt__table-scroll::-webkit-scrollbar-track {
          background: {{ section.settings.mobile_scrollbar_track_color }};
          border-radius: 999px;
        }
      {% endif %}

      {% if show_mobile_scroll_arrow %}
        #shopify-section-{{ section.id }} .cwt__table-wrap--has-arrow .cwt__table-scroll {
          padding-right: 0rem;
        }

        #shopify-section-{{ section.id }} .cwt__scroll-btn {
          display: inline-flex;
          align-items: center;
          justify-content: center;
          position: absolute;
          right: 0.65rem;
          top: 50%;
          z-index: 2;
          width: {{ section.settings.mobile_scroll_arrow_size }}px;
          height: {{ section.settings.mobile_scroll_arrow_size }}px;
          margin: 0;
          padding: 0;
          border: 0.1rem solid {{ section.settings.mobile_scroll_arrow_border_color }};
          border-radius: 50%;
          background: {{ section.settings.mobile_scroll_arrow_background }};
          color: {{ section.settings.mobile_scroll_arrow_color }};
          box-shadow: 0 4px 14px rgba(33, 35, 38, 0.12);
          cursor: pointer;
          transform: translateY(-50%);
          transition: opacity 0.2s ease, transform 0.2s ease;
        }

        #shopify-section-{{ section.id }} .cwt__scroll-btn svg {
          width: 42%;
          height: 42%;
          display: block;
        }

        #shopify-section-{{ section.id }} .cwt__scroll-btn.is-hidden {
          opacity: 0;
          pointer-events: none;
        }

        #shopify-section-{{ section.id }} .cwt__scroll-btn:not(.is-hidden):active {
          transform: translateY(-50%) scale(0.96);
        }
      {% endif %}
    {% endif %}
    #shopify-section-{{ section.id }} .cwt__table thead th{
      padding: 2.0rem 1.0rem;
      font-size: 1.6rem;
      text-align: center;
    }
    #shopify-section-{{ section.id }} .cwt__cell{
      justify-content: center;
      flex-direction: column;
      gap: 1.0rem;
      text-align: center;
    }
    #shopify-section-{{ section.id }} .cwt__table td{
      padding: 2.0rem 1.0rem;
    }
  }
{%- endstyle -%}

<div class="cwt">
  <div class="cwt__inner">
    {%- if section.settings.heading != blank -%}
      <div class="cwt__header">
        <{{ section.settings.heading_tag }} class="cwt__title">
          {{ section.settings.heading | escape }}
        </{{ section.settings.heading_tag }}>
      </div>
    {%- endif -%}

    {%- if section.blocks.size > 0 -%}
      <div class="cwt__table-wrap{% if show_mobile_scroll_arrow and mobile_layout == 'scroll' %} cwt__table-wrap--has-arrow{% endif %}">
        <div class="cwt__table-scroll" data-cwt-scroll>
          <table class="cwt__table" role="table">
            <thead>
              <tr>
                <th scope="col">
                  {%- if section.settings.column_1_heading != blank -%}
                    {{ section.settings.column_1_heading | escape }}
                  {%- endif -%}
                </th>
                <th scope="col">{{ section.settings.column_2_heading | escape }}</th>
                <th scope="col">{{ section.settings.column_3_heading | escape }}</th>
              </tr>
            </thead>
            <tbody>
              {%- for block in section.blocks -%}
                {%- comment -%} Wholesale_Club_Product_Visibility_For_Loop Start {%- endcomment -%}
                {%- capture hide_resource -%}{% render "wc_product_visibility", resource: block %}{%- endcapture -%}
                {%- if hide_resource == 'true' -%}
                  {% continue %}
                {%- endif -%}
                {%- comment -%} Wholesale_Club_Product_Visibility_For_Loop End {%- endcomment -%}

                <tr class="cwt__row cwt__row--{{ block.id }}" {{ block.shopify_attributes }}>
                  <td class="cwt__feature" data-label="">
                    {{ block.settings.feature | escape }}
                  </td>
                  <td data-label="{{ section.settings.column_2_heading | escape }}">
                    <div class="cwt__cell cwt__cell--col2">
                      {%- if block.settings.show_check -%}
                        <span class="cwt__icon cwt__icon--check" aria-hidden="true">
                          <svg viewBox="0 0 12 10" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                            <path d="M1 5.2L4.2 8.4L11 1.4" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
                          </svg>
                        </span>
                      {%- endif -%}
                      <span class="cwt__cell-text">{{ block.settings.column_2_text | escape }}</span>
                    </div>
                  </td>
                  <td data-label="{{ section.settings.column_3_heading | escape }}">
                    <div class="cwt__cell cwt__cell--col3">
                      {%- if block.settings.show_cross -%}
                        <span class="cwt__icon cwt__icon--cross" aria-hidden="true">
                          <svg viewBox="0 0 10 10" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                            <path d="M1.5 1.5L8.5 8.5M8.5 1.5L1.5 8.5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
                          </svg>
                        </span>
                      {%- endif -%}
                      <span class="cwt__cell-text">{{ block.settings.column_3_text | escape }}</span>
                    </div>
                  </td>
                </tr>
              {%- endfor -%}
            </tbody>
          </table>
        </div>
        {%- if show_mobile_scroll_arrow and mobile_layout == 'scroll' -%}
          <button
            type="button"
            class="cwt__scroll-btn"
            data-cwt-scroll-next
            aria-label="{{ section.settings.mobile_scroll_arrow_label | escape }}"
          >
            <svg viewBox="0 0 10 16" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
              <path d="M1.5 1.5L8 8L1.5 14.5" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </button>
        {%- endif -%}
      </div>
    {%- endif -%}

    {%- if section.settings.button_label != blank -%}
      <div class="cwt__button-wrap">
        <a
          class="button button--medium cwt__button"
          {% if section.settings.button_link != blank %}
            href="{{ section.settings.button_link }}"
          {% else %}
            role="link" aria-disabled="true"
          {% endif %}
        >
          {{ section.settings.button_label | escape }}
        </a>
      </div>
    {%- endif -%}
  </div>
</div>

{%- if show_mobile_scroll_arrow and mobile_layout == 'scroll' -%}
  <script>
    (function () {
      var sectionEl = document.getElementById('shopify-section-{{ section.id }}');
      if (!sectionEl || sectionEl.dataset.cwtScrollBound === '1') return;
      sectionEl.dataset.cwtScrollBound = '1';

      var scrollEl = sectionEl.querySelector('[data-cwt-scroll]');
      var nextBtn = sectionEl.querySelector('[data-cwt-scroll-next]');
      if (!scrollEl || !nextBtn) return;

      function isMobile() {
        return window.innerWidth <= 749;
      }

      function updateButton() {
        if (!isMobile()) {
          nextBtn.classList.remove('is-hidden');
          return;
        }

        var maxScroll = scrollEl.scrollWidth - scrollEl.clientWidth;
        var atEnd = scrollEl.scrollLeft >= maxScroll - 4;
        nextBtn.classList.toggle('is-hidden', atEnd || maxScroll <= 0);
      }

      nextBtn.addEventListener('click', function () {
        if (!isMobile()) return;
        var amount = scrollEl.clientWidth * 0.75;
        scrollEl.scrollBy({ left: amount, behavior: 'smooth' });
      });

      scrollEl.addEventListener('scroll', updateButton, { passive: true });
      window.addEventListener('resize', updateButton);
      updateButton();
    })();
  </script>
{%- endif -%}

{% schema %}
{
  "name": "Content with table",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "header",
      "content": "Heading"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Designed With Real Bodies & Real Routines In Mind"
    },
    {
      "type": "select",
      "id": "heading_tag",
      "label": "Heading tag",
      "options": [
        { "value": "h1", "label": "H1" },
        { "value": "h2", "label": "H2" },
        { "value": "h3", "label": "H3" },
        { "value": "p", "label": "Paragraph" }
      ],
      "default": "h2"
    },
    {
      "type": "select",
      "id": "heading_alignment",
      "label": "Heading alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ],
      "default": "center"
    },
    {
      "type": "range",
      "id": "heading_font_size",
      "min": 20,
      "max": 64,
      "step": 2,
      "unit": "px",
      "label": "Heading font size",
      "default": 36
    },
    {
      "type": "select",
      "id": "heading_font_weight",
      "label": "Heading font weight",
      "options": [
        { "value": "500", "label": "Medium" },
        { "value": "600", "label": "Semibold" },
        { "value": "700", "label": "Bold" }
      ],
      "default": "700"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading color",
      "default": "#212326"
    },
    {
      "type": "range",
      "id": "heading_spacing",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "label": "Space below heading",
      "default": 40
    },
    {
      "type": "header",
      "content": "Table columns"
    },
    {
      "type": "text",
      "id": "column_1_heading",
      "label": "Column 1 heading",
      "info": "Leave blank to hide header label for feature column."
    },
    {
      "type": "text",
      "id": "column_2_heading",
      "label": "Column 2 heading",
      "default": "Honey Cloudz Bra Inserts"
    },
    {
      "type": "text",
      "id": "column_3_heading",
      "label": "Column 3 heading",
      "default": "Other Bra Inserts"
    },
    {
      "type": "select",
      "id": "mobile_layout",
      "label": "Mobile layout",
      "options": [
        { "value": "scroll", "label": "Horizontal scroll" },
        { "value": "stack", "label": "Stacked rows" }
      ],
      "default": "scroll"
    },
    {
      "type": "header",
      "content": "Mobile scroll"
    },
    {
      "type": "paragraph",
      "content": "These options apply on mobile only when mobile layout is horizontal scroll."
    },
    {
      "type": "checkbox",
      "id": "show_mobile_scrollbar",
      "label": "Show scrollbar on mobile",
      "default": true
    },
    {
      "type": "range",
      "id": "mobile_scrollbar_height",
      "min": 4,
      "max": 12,
      "step": 2,
      "unit": "px",
      "label": "Scrollbar height (mobile)",
      "default": 6
    },
    {
      "type": "color",
      "id": "mobile_scrollbar_thumb_color",
      "label": "Scrollbar thumb color",
      "default": "#212326"
    },
    {
      "type": "color",
      "id": "mobile_scrollbar_track_color",
      "label": "Scrollbar track color",
      "default": "#E8E8E8"
    },
    {
      "type": "checkbox",
      "id": "show_mobile_scroll_arrow",
      "label": "Show scroll arrow on mobile",
      "default": true
    },
    {
      "type": "text",
      "id": "mobile_scroll_arrow_label",
      "label": "Scroll arrow aria label",
      "default": "Scroll table right"
    },
    {
      "type": "range",
      "id": "mobile_scroll_arrow_size",
      "min": 32,
      "max": 56,
      "step": 4,
      "unit": "px",
      "label": "Scroll arrow size",
      "default": 40
    },
    {
