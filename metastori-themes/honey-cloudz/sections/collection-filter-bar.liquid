{{ 'component-collection-filter-bar.css' | asset_url | stylesheet_tag }}

{% render 'collection-filter-bar-inner', section: section %}

{% schema %}
{
  "name": "Collection filter bar",
  "tag": "section",
  "class": "section collection-filter-bar-section",
  "enabled_on": {
    "templates": ["collection", "search"]
  },
  "settings": [
    {
      "type": "paragraph",
      "content": "Right segment uses custom.bra_type. Checkbox menus filter by custom.solution (list or single line of text). Option lines: one per row; use Label|Badge for a pill after the label (e.g. Mastectomy|POST-OP)."
    },
    {
      "type": "text",
      "id": "filter_label",
      "label": "Label before filter menus",
      "info": "Desktop only, e.g. Filter By:"
    },
    {
      "type": "checkbox",
      "id": "show_segment",
      "label": "Show All / Inserts / Breast Forms pills",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_sort",
      "label": "Show sort dropdown",
      "default": false
    },
    {
      "type": "text",
      "id": "sort_label",
      "label": "Sort label",
      "default": "Sort By:"
    },
    {
      "type": "text",
      "id": "mobile_filters_button_label",
      "label": "Mobile filters button label",
      "default": "Filters"
    },
    {
      "type": "text",
      "id": "drawer_title",
      "label": "Mobile drawer title",
      "default": "Filters"
    },
    {
      "type": "text",
      "id": "drawer_close_label",
      "label": "Mobile drawer close button (accessibility)",
      "default": "Close filters"
    },
    {
      "type": "text",
      "id": "filter_selected_suffix",
      "label": "Checkbox menu count suffix",
      "default": "selected"
    },
    {
      "type": "text",
      "id": "filter_reset_label",
      "label": "Reset button label",
      "default": "RESET"
    },
    {
      "type": "text",
      "id": "segment_aria_label",
      "label": "Segment control accessibility label",
      "default": "Filter by product type"
    },
    {
      "type": "text",
      "id": "label_all",
      "label": "All label",
      "default": "All"
    },
    {
      "type": "text",
      "id": "label_inserts",
      "label": "Inserts label",
      "default": "Inserts"
    },
    {
      "type": "text",
      "id": "label_breast_forms",
      "label": "Breast forms label",
      "default": "Breast Forms"
    },
    {
      "type": "text",
      "id": "empty_message",
      "label": "Empty state message",
      "default": "No products match this filter."
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding top",
      "default": 16
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding bottom",
      "default": 16
    }
  ],
  "blocks": [
    {
      "type": "dropdown_stub",
      "name": "Label only (no dropdown)",
      "limit": 6,
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Label",
          "default": "Shape"
        }
      ]
    },
    {
      "type": "filter_checkbox_menu",
      "name": "Checkbox filter menu",
      "limit": 4,
      "settings": [
        {
          "type": "text",
          "id": "menu_label",
          "label": "Menu button label",
          "default": "Solution"
        },
        {
          "type": "text",
          "id": "filter_field",
          "label": "Product data key",
          "default": "solution",
          "info": "Lowercase key → data-product-filter-{key} on product cards. Use solution, size, color, coverage, shape, etc. Must match Product grid metafield keys. Checkbox labels handleize to metafield values (e.g. Shape: Triangle → triangle)."
        },
        {
          "type": "textarea",
          "id": "options",
          "label": "Options (one per line)",
          "default": "Nip Coverage\nLifting\nBalancing\nMastectomy|POST-OP\nLumpectomy|POST-OP\nExplant|POST-OP"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Collection filter bar",
      "blocks": [
        {
          "type": "filter_checkbox_menu",
          "settings": {
            "menu_label": "Solution",
            "filter_field": "solution",
            "options": "Nip Coverage\nLifting\nBalancing\nMastectomy|POST-OP\nLumpectomy|POST-OP\nExplant|POST-OP"
          }
        },
        {
          "type": "filter_checkbox_menu",
          "settings": {
            "menu_label": "Size",
            "filter_field": "size",
            "options": "XS\nS\nM\nL\nXL"
          }
        },
        {
          "type": "filter_checkbox_menu",
          "settings": {
            "menu_label": "Coverage",
            "filter_field": "coverage",
            "options": "Lites\nClassics\nPlus+\nPush-Ups\nBreast Forms"
          }
        }
      ]
    }
  ]
}
{% endschema %}
