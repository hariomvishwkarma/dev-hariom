<section class="flex-grid-section {{ section.settings.custom_class }}" style="padding-top: {{ section.settings.section_padding_top }}px; padding-bottom: {{ section.settings.section_padding_bottom }}px;">
  <div class="container">
    <div class="flex-wrapper">
      {% for block in section.blocks %}
        <div class="flex-item">
          {% if block.settings.block_image %}
            <div class="flex-image">
              <img src="{{ block.settings.block_image | img_url: 'master' }}" alt="{{ block.settings.block_title | escape }}">
            </div>
          {% endif %}

          <div class="flex-content">
            {% if block.settings.block_title != blank %}
              <h3>{{ block.settings.block_title }}</h3>
            {% endif %}
            {% if block.settings.block_subtitle != blank %}
              <p class="subtitle">
                <span class="checklist"><img src="https://cdn.shopify.com/s/files/1/1711/0419/files/check-circle-fill_d76753af-2fdd-404a-9387-e73423d6d136.svg?v=1759222893" alt="{{ block.settings.block_subtitle | default: block.settings.block_title | default: shop.name | escape }}" /></span>
                <em>{{ block.settings.block_subtitle }}</em>
              </p>
            {% endif %}
            {% if block.settings.block_text != blank %}
              <p class="card-des-text">{{ block.settings.block_text }}</p>
            {% endif %}
            {% if block.settings.button_text != blank and block.settings.button_link != blank %}
              <a href="{{ block.settings.button_link }}" class="btn">{{ block.settings.button_text }}</a>
            {% endif %}
          </div>
        </div>
      {% endfor %}
    </div>
  </div>
</section>

<style>
.flex-grid-section .container {
  max-width: 1325px;
  margin: 0 auto;
}

.flex-grid-section .flex-wrapper {
  display: flex;
  flex-wrap: wrap;
  margin: -15px;
}

.flex-grid-section .flex-item {
  flex: 1 1 calc(25% - 30px); /* max 4 per row */
  margin: 15px;
  box-sizing: border-box;
  text-align: left;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}

.flex-grid-section .flex-image {
  width: 100%;
  height: auto; /* fixed height for equal sizing */
  overflow: hidden;
}

.flex-grid-section .flex-image img {
  width: 100%;
  height: 100%;
  object-fit: cover; /* crops & fills nicely */
  display: block;
}

.flex-grid-section .flex-content {
  padding: 15px 0;
}

.flex-grid-section .flex-content h3 {
  font-size: 20px;
  font-weight: bold;
  margin-bottom: 5px;
  font-family: 'Satoshi';
  letter-spacing:normal;
}

.flex-grid-section .flex-content .subtitle {
  font-size: 16px;
  margin-bottom: 10px;
  color: #333;
  display: flex;
  align-items: center; letter-spacing:normal;
  gap: 6px;
}

.flex-grid-section .flex-content p {
  font-size: 15px;
  margin-bottom: 15px;
  color: #333;
    font-family: 'Satoshi';
    font-weight: 500;
    letter-spacing:normal;
}

.flex-grid-section .btn {
    display: inline-block;
    padding: 0px 20px;
    border: 1px solid #000;
    text-decoration: none;
    font-size: 16px;
    text-transform: uppercase;
    width: 100%;
    text-align: center;
    border-radius: 40px;
    height: 64px;
    line-height: 62px;
    font-family: 'Satoshi';
    font-weight:bold; letter-spacing:normal;
    color:#000;
}
span.checklist img {
    max-width: 16px;
}
.flex-grid-section .btn:hover {
    background: #000;
    color: #fff;
}
/* Responsive */
@media (max-width: 1350px) {
.flex-grid-section .flex-wrapper {
    padding: 0 30px;
}
}
@media (max-width: 1024px) {
  .flex-grid-section .flex-item {
    flex: 1 1 calc(33.333% - 30px); /* 3 per row */
  }
}
@media (max-width: 768px) {
  .flex-grid-section .flex-item {
    flex: 1 1 calc(50% - 30px); /* 2 per row */
  }
  .flex-grid-section .flex-wrapper {
    margin: 0;
    padding: 0 20px;
}
.flex-grid-section{
      padding-top: {{ section.settings.section_mob_padding_top }}px !important;
      padding-bottom: {{ section.settings.section_mob_padding_bottom }}px !important;
}
.flex-grid-section .btn {
    font-size: 14px;
    height: 44px;
    line-height: 42px;
    font-family: 'Satoshi';
    font-weight: bold;
}
.flex-grid-section .flex-content {
    padding: 15px 0;
    margin-bottom: 20px;
}
}
@media (max-width: 480px) {
  .flex-grid-section .flex-item {
    flex: 1 1 100%; /* 1 per row */
    margin:0px;
  }
}
@media (min-width: 560px) {
  .card-des-text{
    min-height:81px;
  }
}
</style>

{% schema %}
{
  "name": "feature grid Section",
  "settings": [
    {
      "type": "range",
      "id": "section_padding_top",
      "label": "Padding Top",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "section_padding_bottom",
      "label": "Padding Bottom",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "section_mob_padding_top",
      "label": "Mobile Padding Top",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "section_mob_padding_bottom",
      "label": "Mobile Padding Bottom",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "default": 40
    },
    {
      "type": "text",
      "id": "custom_class",
      "label": "Custom CSS Class",
      "default": "custom-class"
    }
  ],
  "blocks": [
    {
      "type": "flex_item",
      "name": "Flex Item",
      "settings": [
        {
          "type": "image_picker",
          "id": "block_image",
          "label": "Block Image"
        },
        {
          "type": "text",
          "id": "block_title",
          "label": "Block Title",
          "default": "Block Title"
        },
        {
          "type": "text",
          "id": "block_subtitle",
          "label": "Block Subtitle",
          "default": "Block Subtitle"
        },
        {
          "type": "textarea",
          "id": "block_text",
          "label": "Block Text",
          "default": "Add description text here."
        },
        {
          "type": "text",
          "id": "button_text",
          "label": "Button Text",
          "default": "View Product"
        },
        {
          "type": "url",
          "id": "button_link",
          "label": "Button Link"
        }
      ]
    }
  ],
  "max_blocks": 4,
  "presets": [
    {
      "name": "feature grid Section",
      "category": "Custom"
    }
  ]
}
{% endschema %}
