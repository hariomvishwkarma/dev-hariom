{{ 'hc-style-finder.css' | asset_url | stylesheet_tag }}

<section class="hc-sf" data-hc-sf>
  <div class="page-width">
    <div class="hc-sf__shell">
      <div class="hc-sf__top">
        <div>
          <p class="hc-sf__kicker" data-kicker>Style Finder</p>
          <p class="hc-sf__journey" data-journey></p>
        </div>
        <button type="button" class="hc-sf__btn--text" data-restart hidden>Start over</button>
      </div>

      <div class="hc-sf__progress" aria-hidden="true">
        <span data-progress></span>
      </div>

      <h1 class="hc-sf__q" data-title></h1>
      <p class="hc-sf__help" data-help hidden></p>
      <p class="hc-sf__note" data-note hidden></p>
      <div class="hc-sf__options" data-options></div>
      <div data-extra></div>
      <p class="hc-sf__err" data-err hidden></p>

      <div class="hc-sf__nav">
        <button type="button" class="hc-sf__btn hc-sf__btn--ghost" data-back hidden>Back</button>
        <button type="button" class="hc-sf__btn" data-next hidden>Continue</button>
        <button type="button" class="hc-sf__btn--text" data-gift-escape hidden>
          Not sure this is the right fit or style? Choose a gift card instead.
        </button>
      </div>
    </div>
  </div>
</section>

<script type="application/json" id="hc-sf-config">
{
  "colorPriority": ["Vanilla Sugar", "Latte", "Caramel", "Black", "Hazelnut", "Mocha"],
  "data": {% render 'hc-style-finder-data' %}
}
</script>

<script src="{{ 'hc-style-finder.js' | asset_url }}" defer></script>

{% schema %}
{
  "name": "Style Finder",
  "settings": [
    {
      "type": "paragraph",
      "content": "Questions, answers, products, snippets, and size maps all load from metaobjects (Settings > Custom data). The gift card comes from the GIFT_CARD entry in Style Finder Outcome. Enable Storefront access on each definition."
    }
  ],
  "presets": [
    {
      "name": "Style Finder",
      "category": "Custom"
    }
  ]
}
{% endschema %}
