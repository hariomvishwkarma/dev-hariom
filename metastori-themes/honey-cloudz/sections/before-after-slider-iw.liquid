{% schema %}
{
  "name": "Before After Slider",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Before vs After"
    },
    {
      "type": "image_picker",
      "id": "before_image",
      "label": "Before Image"
    },
    {
      "type": "image_picker",
      "id": "after_image",
      "label": "After Image"
    }
  ],
  "presets": [
    {
      "name": "Before After Slider",
      "category": "Image"
    }
  ]
}
{% endschema %}

<div class="before-after-slider">
  {% if section.settings.heading != blank %}
    <h2 class="slider-heading">{{ section.settings.heading }}</h2>
  {% endif %}
  <div class="image-container">
    <img src="{{ section.settings.before_image | img_url: 'master' }}" alt="Before" class="before-image">
    <img src="{{ section.settings.after_image | img_url: 'master' }}" alt="After" class="after-image">
    <div class="slider">
      <div class="handle">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 12 16"><path fill-rule="evenodd" clip-rule="evenodd" d="M0.5 0.5C0.5 0.223858 0.723858 0 1 0C1.27614 0 1.5 0.223858 1.5 0.5V15.5C1.5 15.7761 1.27614 16 1 16C0.723858 16 0.5 15.7761 0.5 15.5V0.5ZM5.5 0.5C5.5 0.223858 5.72386 0 6 0C6.27614 0 6.5 0.223858 6.5 0.5V15.5C6.5 15.7761 6.27614 16 6 16C5.72386 16 5.5 15.7761 5.5 15.5V0.5ZM11.5 0.5C11.5 0.223858 11.2761 0 11 0C10.7239 0 10.5 0.223858 10.5 0.5V15.5C10.5 15.7761 10.7239 16 11 16C11.2761 16 11.5 15.7761 11.5 15.5V0.5Z" fill="#212326"/></svg>
        
      </div>
    </div>
  </div>
</div>

<style>
.before-after-slider {
  position: relative;
  width: 100%;
  max-width: 1312px;
  margin: 0 auto;
  overflow: hidden;
}
.slider-heading {
  font-size: 40px;
  font-family: "Poppins";
    font-weight: 400;
  margin-bottom: 40px;
   text-align: center;
  color: black;
}

.image-container {
    position: relative;
    width: 100%;
    border-radius: 40px;
    border: 1px solid rgb(51 51 51 / 60%);
    height: 400px;
}
.image-container img {
    border-radius: 40px;
}

.before-image, .after-image {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.after-image {
  clip: rect(0, 300px, 400px, 0);
}

.slider {
  position: absolute;
  top: 0;
  left: 50%;
  width: 4px;
  height: 100%;
  background: #fff;
  cursor: ew-resize;
  transform: translateX(-50%);
}

{% comment %} .handle {
  position: absolute;
  top: 50%;
  left: 50%;
  width: 20px;
  height: 20px;
  background: #fff;
  border: 2px solid #000;
  border-radius: 50%;
  transform: translate(-50%, -50%);
} {% endcomment %}
.handle {
  position: absolute;
  top: 50%;
  left: 50%;
  width: 36px;
  height: 36px;
  background-color: #fff;
  border-radius: 50%;
  transform: translate(-50%, -50%);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 2px 6px rgba(0,0,0,0.2);
}

.handle svg {
  width: 16px;
  height: 16px;
  fill: #333;
}
</style>

<script>
document.addEventListener('DOMContentLoaded', function() {
  const slider = document.querySelector('.slider');
  const beforeImage = document.querySelector('.before-image');
  const afterImage = document.querySelector('.after-image');
  let isDragging = false;

  slider.addEventListener('mousedown', function(e) {
    isDragging = true;
  });

  document.addEventListener('mousemove', function(e) {
    if (isDragging) {
      let containerRect = slider.parentElement.getBoundingClientRect();
      let offsetX = e.clientX - containerRect.left;
      let sliderWidth = containerRect.width;
      
      offsetX = Math.max(0, Math.min(offsetX, sliderWidth));
      let percent = (offsetX / sliderWidth) * 100;

      slider.style.left = percent + '%';
      afterImage.style.clip = `rect(0, ${sliderWidth}px, 400px, ${offsetX}px)`;
    }
  });

  document.addEventListener('mouseup', function() {
    isDragging = false;
  });

  // Initial 50/50 split
  let initialWidth = slider.parentElement.offsetWidth / 2;
  slider.style.left = '50%';
  afterImage.style.clip = `rect(0, ${initialWidth}px, 400px, 0)`;
});
</script>