{%- style -%}
  #shopify-section-{{ section.id }} {
    --section-padding-top: {{ section.settings.padding_top }}px;
    --section-padding-bottom: {{ section.settings.padding_bottom }}px;
  }
{%- endstyle -%}

{{ 'component-card.css' | asset_url | stylesheet_tag }}
{{ 'section-collection-list.css' | asset_url | stylesheet_tag }}

<div class="section--padding{% if section.settings.show_divider %} section--divider{% endif %}">
  <div class="collection-list-wrapper page-width">
    <div class="title-wrapper{% if section.settings.heading == blank %} title-wrapper--no-heading{% endif %} {{ section.settings.heading_alignment }}">
      <{{ section.settings.heading_tag }} class="title {{ section.settings.heading_size }}">{{ section.settings.heading | escape }}</{{ section.settings.heading_tag }}>
      
      {%- if section.settings.show_view_all -%}
        <a href="{{ routes.collections_url }}" class="link link-with-icon large-up-hide">
          <span class="label">{{ 'sections.collection_list.view_all' | t }}</span>
        </a>
      {%- endif -%}
    </div>

    {% if section.blocks.size > 0 %}
      <ul id="collection-list-{{ section.id }}"
          class="collection-list grid--4-col"
          role="list"
      >
        {%- for block in section.blocks -%}
          <li id="collection-item-{{ section.id }}-{{ forloop.index }}"
              class="collection-list__item grid__item"
              {{ block.shopify_attributes }}
          >
            {%- assign card_collection = block.settings.collection -%}
            {%- if card_collection != blank -%}
              {%- assign featured_image = card_collection.featured_image -%}
              {%- if block.settings.image != blank -%}
                {%- assign featured_image = block.settings.image -%}
              {%- endif -%}
              <a class="card-wrapper card{% if featured_image != blank %} card--media{% else %} card--text{% endif %}"
                 href="{{ card_collection.url }}">
                {%- if featured_image != blank -%}
                  <div class="media-wrapper">
                    <div class="media media--hover-effect overflow-hidden">
                      {{ featured_image | image_url: '500x500' | image_tag: loading: 'lazy', alt: featured_image.alt | default: card_collection.title | default: collection.title | default: shop.name | escape}}
                    </div>
                  </div>
                  <div class="card__text">
                    <h3 class="card-information__text h3">{{ card_collection.title | escape }}</h3>
                  </div>
                {%- else -%}
                  <div class="card__text">
                    <h3 class="card-information__text h3">{{ card_collection.title | escape }}</h3>
                  </div>
                {%- endif -%}
              </a>
            {%- endif -%}
          </li>
        {%- endfor -%}
      </ul>
    {% else %}
      <p>No collections have been selected or available to display.</p> <!-- Fallback message -->
    {% endif %}
  </div>
</div>

<style>
  .grid--4-col {
    display: grid;
    grid-template-columns: repeat(4, 1fr); /* 4 equal columns */
    gap: 20px; /* Adjust the spacing between columns */
  }

  @media (max-width: 1024px) {
    .grid--4-col {
      grid-template-columns: repeat(4, 1fr); /* Maintain 4 columns on tablet */
    }
  }

  @media (max-width: 768px) {
    .grid--4-col {
      grid-template-columns: repeat(4, 1fr); /* Maintain 4 columns on mobile */
    }
  }

  @media (max-width: 480px) {
    .grid--4-col {
      grid-template-columns: repeat(4, 1fr); /* Keep 4 columns on smaller screens */
    }
  }

  .collection-list__item {
    text-align: center;
  }

  .media-wrapper {
    margin-bottom: 10px;
  }

  .media img {
    width: 100%;
    height: auto;
    object-fit: cover;
  }
</style>

{% schema %}
{
  "name": "Collection List DDM",
  "settings": [
    {
      "type": "checkbox",
      "id": "show_view_all",
      "default": true,
      "label": "Show View All Button"
    },
    {
      "type": "text",
      "id": "heading",
      "default": "Our Collections",
      "label": "Heading"
    },
    {
      "type": "select",
      "id": "heading_size",
      "options": [
        {
          "value": "h1",
          "label": "Heading 1"
        },
        {
          "value": "h2",
          "label": "Heading 2"
        },
        {
          "value": "h3",
          "label": "Heading 3"
        }
      ],
      "default": "h2",
      "label": "Heading Size"
    },
    {
      "type": "select",
      "id": "heading_alignment",
      "label": "Heading Alignment",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ],
      "default": "center"
    }
  ],
  "blocks": [
    {
      "type": "featured_collection",
      "name": "Featured Collection",
      "settings": [
        {
          "type": "collection",
          "id": "collection",
          "label": "Select Collection"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Custom Collection Image"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Collection List DDM",
      "category": "Custom",
      "blocks": [
        {
          "type": "featured_collection"
        },
        {
          "type": "featured_collection"
        },
        {
          "type": "featured_collection"
        },
        {
          "type": "featured_collection"
        }
      ]
    }
  ]
}
{% endschema %}
