{%- liquid
  assign logo_blocks = section.blocks | where: 'type', 'logo'
  assign logo_count = logo_blocks.size
  assign should_animate = false
  if logo_count > 0
    assign should_animate = true
  endif
-%}

{%- style -%}
  #shopify-section-{{ section.id }} .casi {
    --casi-bg: {{ section.settings.background_color }};
    --casi-text: {{ section.settings.text_color }};
    --casi-gap: {{ section.settings.logo_gap }}px;
    --casi-speed: {{ section.settings.speed }}s;
    --casi-logo-h: {{ section.settings.logo_height }}px;
    --casi-label-size: {{ section.settings.label_font_size }}px;
    --casi-label-weight: {{ section.settings.label_font_weight }};
    --casi-label-gap: {{ section.settings.label_gap }}px;
    background-color: var(--casi-bg);
    color: var(--casi-text);
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
    overflow: hidden;
  }

  #shopify-section-{{ section.id }} .casi__inner {
    display: flex;
    align-items: center;
    gap: var(--casi-label-gap);
    width: 100%;
    {% unless section.settings.full_width %}
      max-width: {{ section.settings.content_max_width }}px;
      margin: 0 auto;
      padding-inline: 1.5rem;
      box-sizing: border-box;
    {% else %}
      padding-inline: {{ section.settings.edge_padding }}px;
      box-sizing: border-box;
    {% endunless %}
  }

  #shopify-section-{{ section.id }} .casi__label {
    flex: 0 0 auto;
    margin: 0;
    font-size: var(--casi-label-size);
    font-weight: var(--casi-label-weight);
    line-height: 1.2;
    letter-spacing: {{ section.settings.label_letter_spacing }}em;
    white-space: nowrap;
    color: var(--casi-text);
  }

  #shopify-section-{{ section.id }} .casi__viewport {
    flex: 1 1 auto;
    min-width: 0;
    overflow: hidden;
    mask-image: linear-gradient(90deg, transparent 0, #000 24px, #000 calc(100% - 24px), transparent 100%);
    -webkit-mask-image: linear-gradient(90deg, transparent 0, #000 24px, #000 calc(100% - 24px), transparent 100%);
  }

  {% unless section.settings.fade_edges %}
  #shopify-section-{{ section.id }} .casi__viewport {
    mask-image: none;
    -webkit-mask-image: none;
  }
  {% endunless %}

  #shopify-section-{{ section.id }} .casi__track {
    display: flex;
    width: max-content;
    align-items: center;
    gap: var(--casi-gap);
    will-change: transform;
  }

  #shopify-section-{{ section.id }} .casi__track--animated {
    animation: casi-scroll-{{ section.id }} var(--casi-speed) linear infinite;
  }

  {% if section.settings.direction == 'right' %}
  #shopify-section-{{ section.id }} .casi__track--animated {
    animation-direction: reverse;
  }
  {% endif %}

  {% if section.settings.pause_on_hover %}
  @media screen and (hover: hover) {
    #shopify-section-{{ section.id }} .casi:hover .casi__track--animated {
      animation-play-state: paused;
    }
  }
  {% endif %}

  #shopify-section-{{ section.id }} .casi__list {
    display: flex;
    align-items: center;
    gap: var(--casi-gap);
    list-style: none;
    margin: 0;
    padding: 0;
    flex: 0 0 auto;
  }

  #shopify-section-{{ section.id }} .casi__item {
    flex: 0 0 auto;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  #shopify-section-{{ section.id }} .casi__logo,
  #shopify-section-{{ section.id }} .casi__logo-link {
    display: flex;
    align-items: center;
    justify-content: center;
    color: inherit;
    text-decoration: none;
  }

  #shopify-section-{{ section.id }} .casi__logo img {
    display: block;
    width: auto;
    height: var(--casi-logo-h);
    max-width: none;
    object-fit: contain;
  }

  {%- for block in logo_blocks -%}
    {%- if block.settings.logo_height > 0 -%}
      #shopify-section-{{ section.id }} .casi__item--{{ block.id }} img {
        height: {{ block.settings.logo_height }}px;
      }
    {%- endif -%}
  {%- endfor -%}

  @keyframes casi-scroll-{{ section.id }} {
    from {
      transform: translate3d(0, 0, 0);
    }
    to {
      transform: translate3d(calc(-50% - (var(--casi-gap) / 2)), 0, 0);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    #shopify-section-{{ section.id }} .casi__track--animated {
      animation: none;
    }

    #shopify-section-{{ section.id }} .casi__list--clone {
      display: none;
    }

    #shopify-section-{{ section.id }} .casi__viewport {
      overflow-x: auto;
    }
  }

  @media screen and (max-width: 749px) {
    #shopify-section-{{ section.id }} .casi {
      --casi-label-size: {{ section.settings.label_font_size_mobile }}px;
      --casi-logo-h: {{ section.settings.logo_height_mobile }}px;
      --casi-gap: {{ section.settings.logo_gap_mobile }}px;
      --casi-label-gap: {{ section.settings.label_gap_mobile }}px;
      padding-top: {{ section.settings.padding_top_mobile }}px;
      padding-bottom: {{ section.settings.padding_bottom_mobile }}px;
    }

    {% if section.settings.stack_on_mobile %}
    #shopify-section-{{ section.id }} .casi__inner {
      flex-direction: column;
      align-items: flex-start;
      gap: {{ section.settings.label_gap_mobile }}px;
    }

    #shopify-section-{{ section.id }} .casi__viewport {
      width: 100%;
    }
    {% endif %}
  }
{%- endstyle -%}

<section
  class="casi"
  aria-label="{{ section.settings.aria_label | escape }}"
>
  <div class="casi__inner">
    {%- if section.settings.label != blank -%}
      <{{ section.settings.label_tag }} class="casi__label">
        {{ section.settings.label | escape }}
      </{{ section.settings.label_tag }}>
    {%- endif -%}

    {%- if logo_count > 0 -%}
      <div class="casi__viewport">
        <div class="casi__track{% if should_animate %} casi__track--animated{% endif %}">
          {%- for pass in (1..2) -%}
            <ul
              class="casi__list{% if pass == 2 %} casi__list--clone{% endif %}"
              role="list"
              {% if pass == 2 %}aria-hidden="true"{% endif %}
            >
              {%- for block in logo_blocks -%}
                {%- liquid
                  assign logo_alt = block.settings.image_alt
                  if block.settings.image != blank and logo_alt == blank
                    assign logo_alt = block.settings.image.alt | default: block.settings.title
                  endif
                  if logo_alt == blank
                    assign logo_alt = 'Press logo'
                  endif
                -%}
                <li
                  class="casi__item casi__item--{{ block.id }}"
                  role="listitem"
                  {{ block.shopify_attributes }}
                >
                  {%- if block.settings.link != blank -%}
                    <a class="casi__logo-link casi__logo" href="{{ block.settings.link }}">
                      {%- if block.settings.image != blank -%}
                        {{
                          block.settings.image
                          | image_url: height: 160
                          | image_tag:
                            loading: 'lazy',
                            widths: '80, 120, 160, 200, 240, 320',
                            alt: logo_alt
                        }}
                      {%- elsif block.settings.title != blank -%}
                        <span>{{ block.settings.title | escape }}</span>
                      {%- endif -%}
                    </a>
                  {%- else -%}
                    <div class="casi__logo">
                      {%- if block.settings.image != blank -%}
                        {{
                          block.settings.image
                          | image_url: height: 160
                          | image_tag:
                            loading: 'lazy',
                            widths: '80, 120, 160, 200, 240, 320',
                            alt: logo_alt
                        }}
                      {%- elsif block.settings.title != blank -%}
                        <span>{{ block.settings.title | escape }}</span>
                      {%- endif -%}
                    </div>
                  {%- endif -%}
                </li>
              {%- endfor -%}
            </ul>
          {%- endfor -%}
        </div>
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Custom as seen in",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "header",
      "content": "Left label"
    },
    {
      "type": "text",
      "id": "label",
      "label": "Fixed text",
      "default": "As seen in"
    },
    {
      "type": "select",
      "id": "label_tag",
      "label": "Label tag",
      "options": [
        { "value": "p", "label": "Paragraph" },
        { "value": "h2", "label": "H2" },
        { "value": "h3", "label": "H3" },
        { "value": "div", "label": "Div" }
      ],
      "default": "p"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#212326"
    },
    {
      "type": "range",
      "id": "label_font_size",
      "min": 12,
      "max": 32,
      "step": 1,
      "unit": "px",
      "label": "Label size (desktop)",
      "default": 18
    },
    {
      "type": "range",
      "id": "label_font_size_mobile",
      "min": 12,
      "max": 24,
      "step": 1,
      "unit": "px",
      "label": "Label size (mobile)",
      "default": 16
    },
    {
      "type": "select",
      "id": "label_font_weight",
      "label": "Label weight",
      "options": [
        { "value": "400", "label": "Regular" },
        { "value": "500", "label": "Medium" },
        { "value": "600", "label": "Semibold" },
        { "value": "700", "label": "Bold" }
      ],
      "default": "600"
    },
    {
      "type": "range",
      "id": "label_letter_spacing",
      "min": 0,
      "max": 0.2,
      "step": 0.1,
      "label": "Label letter spacing",
      "default": 0
    },
    {
      "type": "range",
      "id": "label_gap",
      "min": 12,
      "max": 80,
      "step": 4,
      "unit": "px",
      "label": "Space between text and logos",
      "default": 32
    },
    {
      "type": "range",
      "id": "label_gap_mobile",
      "min": 8,
      "max": 40,
      "step": 2,
      "unit": "px",
      "label": "Space between text and logos (mobile)",
      "default": 16
    },
    {
      "type": "header",
      "content": "Logo scroller"
    },
    {
      "type": "text",
      "id": "aria_label",
      "label": "Accessibility label",
      "default": "As seen in press logos"
    },
    {
      "type": "select",
      "id": "direction",
      "label": "Scroll direction",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "right", "label": "Right" }
      ],
      "default": "left"
    },
    {
      "type": "range",
      "id": "speed",
      "min": 8,
      "max": 60,
      "step": 2,
      "unit": "s",
      "label": "Scroll speed",
      "default": 28
    },
    {
      "type": "checkbox",
      "id": "pause_on_hover",
      "label": "Pause on hover",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "fade_edges",
      "label": "Fade logo edges",
      "default": true
    },
    {
      "type": "range",
      "id": "logo_height",
      "min": 16,
      "max": 80,
      "step": 2,
      "unit": "px",
      "label": "Logo height (desktop)",
      "default": 36
    },
    {
      "type": "range",
      "id": "logo_height_mobile",
      "min": 14,
      "max": 56,
      "step": 2,
      "unit": "px",
      "label": "Logo height (mobile)",
      "default": 28
    },
    {
      "type": "range",
      "id": "logo_gap",
      "min": 16,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Space between logos",
      "default": 56
    },
    {
      "type": "range",
      "id": "logo_gap_mobile",
      "min": 12,
      "max": 64,
      "step": 4,
      "unit": "px",
      "label": "Space between logos (mobile)",
      "default": 36
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "checkbox",
      "id": "full_width",
      "label": "Full width",
      "default": true
    },
    {
      "type": "range",
      "id": "content_max_width",
      "min": 800,
      "max": 1600,
      "step": 20,
      "unit": "px",
      "label": "Content max width",
      "default": 1200
    },
    {
      "type": "range",
      "id": "edge_padding",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "label": "Side padding (full width)",
      "default": 24
    },
    {
      "type": "checkbox",
      "id": "stack_on_mobile",
      "label": "Stack label above logos on mobile",
      "default": false
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "default": "#E47BB5"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 80,
      "step": 2,
      "unit": "px",
      "label": "Padding top",
      "default": 20
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 80,
      "step": 2,
      "unit": "px",
      "label": "Padding bottom",
      "default": 20
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "min": 0,
      "max": 60,
      "step": 2,
      "unit": "px",
      "label": "Padding top (mobile)",
      "default": 16
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "min": 0,
      "max": 60,
      "step": 2,
      "unit": "px",
      "label": "Padding bottom (mobile)",
      "default": 16
    }
  ],
  "blocks": [
    {
      "type": "logo",
      "name": "Logo",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Logo image"
        },
        {
          "type": "text",
          "id": "image_alt",
          "label": "Image alt text"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Fallback text",
          "info": "Shown only if no image is set."
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        },
        {
          "type": "range",
          "id": "logo_height",
          "min": 0,
          "max": 80,
          "step": 2,
          "unit": "px",
          "label": "Logo height override",
          "info": "Set to 0 to use section default.",
          "default": 0
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Custom as seen in",
      "category": "Story",
      "blocks": [
        { "type": "logo", "settings": { "title": "O Magazine", "image_alt": "The Oprah Magazine logo" } },
        { "type": "logo", "settings": { "title": "Oscars", "image_alt": "The Oscars logo" } },
        { "type": "logo", "settings": { "title": "Trail Runner", "image_alt": "Trail Runner logo" } },
        { "type": "logo", "settings": { "title": "Brit + Co", "image_alt": "Brit + Co logo" } },
        { "type": "logo", "settings": { "title": "Access Daily", "image_alt": "Access Daily logo" } },
        { "type": "logo", "settings": { "title": "Rachael", "image_alt": "Rachael logo" } }
      ]
    }
  ]
}
{% endschema %}
