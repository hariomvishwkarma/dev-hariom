{%- liquid
  assign block_count = section.blocks.size
-%}

{%- style -%}
  #shopify-section-{{ section.id }} {
    --section-padding-top: {{ section.settings.padding_top }}px;
    --section-padding-bottom: {{ section.settings.padding_bottom }}px;
    --hc-mc-bg: {{ section.settings.background_color }};
    --hc-mc-icon-bg: {{ section.settings.icon_bg_color }};
    --hc-mc-icon-border: {{ section.settings.icon_border_color }};
    --hc-mc-icon-color: {{ section.settings.icon_color }};
    --hc-mc-icon-size: {{ section.settings.icon_size }}px;
    --hc-mc-icon-wrap: {{ section.settings.icon_wrap_size }}px;
    --hc-mc-gap: {{ section.settings.column_gap }}px;
  }

  #shopify-section-{{ section.id }} .hc-multicolumn {
    background: var(--hc-mc-bg);
    padding-top: calc(var(--section-padding-top) * 0.75);
    padding-bottom: calc(var(--section-padding-bottom) * 0.75);
  }

  @media screen and (min-width: 750px) {
    #shopify-section-{{ section.id }} .hc-multicolumn {
      padding-top: var(--section-padding-top);
      padding-bottom: var(--section-padding-bottom);
    }
  }

  #shopify-section-{{ section.id }} .hc-multicolumn__title {
    text-align: center;
    margin: 0 0 5rem;
    letter-spacing: 0;
  }

  #shopify-section-{{ section.id }} .hc-multicolumn__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: calc(var(--hc-mc-gap) * 0.75);
    align-items: stretch;
  }

  @media screen and (min-width: 750px) {
    #shopify-section-{{ section.id }} .hc-multicolumn__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media screen and (min-width: 990px) {
    #shopify-section-{{ section.id }} .hc-multicolumn__grid {
      grid-template-columns: repeat({{ section.settings.columns_desktop }}, minmax(0, 1fr));
      gap: var(--hc-mc-gap);
    }
  }

  #shopify-section-{{ section.id }} .hc-multicolumn__card {
    text-align: center;
    max-width: 30rem;
    margin: 0 auto;
    height: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  #shopify-section-{{ section.id }} .hc-multicolumn__card p,
  #shopify-section-{{ section.id }} .hc-multicolumn__card h3 {
    margin-bottom: .5rem;
  }

  #shopify-section-{{ section.id }} .hc-multicolumn__icon {
    width: var(--hc-mc-icon-wrap);
    height: var(--hc-mc-icon-wrap);
    border-radius: 999px;
    background: var(--hc-mc-icon-bg);
    border: 1px solid var(--hc-mc-icon-border);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    color: var(--hc-mc-icon-color);
  }

  #shopify-section-{{ section.id }} .hc-multicolumn__icon img {
    width: var(--hc-mc-icon-size);
    height: var(--hc-mc-icon-size);
    object-fit: contain;
    display: block;
  }

  #shopify-section-{{ section.id }} .hc-multicolumn__icon svg {
    width: var(--hc-mc-icon-size);
    height: var(--hc-mc-icon-size);
    stroke: currentColor;
    fill: none;
  }

  #shopify-section-{{ section.id }} .hc-multicolumn__heading {
    margin: 0 0 0.8rem;
    font-weight: 700;
    letter-spacing: 0;
    line-height: 1.2;
  }

  /* Richtext titles render their own <p> tags */
  #shopify-section-{{ section.id }} .hc-multicolumn__heading p {
    margin: 0;
  }

  #shopify-section-{{ section.id }} .hc-multicolumn__heading em {
    font-style: italic;
    font-weight: 800;
  }

  #shopify-section-{{ section.id }} .hc-multicolumn__text {
    margin: 0;
    color: rgba(var(--color-foreground), 0.8);
    font-size: 16px;;
    line-height: 1.55;
    flex: 1 1 auto;
    display: flex;
    flex-direction: column;
    justify-content: flex-start;
  }

  #shopify-section-{{ section.id }} .hc-multicolumn__ctas {
    margin-top: 4rem;
    display: flex;
    justify-content: center;
    gap: 1.4rem;
    flex-wrap: wrap;
  }

  #shopify-section-{{ section.id }} .hc-multicolumn__cta-link {
    font-size: 16px;
    font-weight: 600;
    letter-spacing: 0;
    color: #111;
    text-decoration: underline;
    text-underline-offset: 3px;
    text-decoration-thickness: 1px;
    padding: 0.6rem 0;
  }

  #shopify-section-{{ section.id }} .hc-multicolumn__cta-link:hover {
    opacity: 0.8;
  }

  #shopify-section-{{ section.id }} .hc-multicolumn__ctas .button {
    border-radius: 999px;
    min-width: 0;
    text-transform: none;
    letter-spacing: 0;
    padding-left: 2.6rem;
    font-size: 16px;
    padding-right: 2.6rem;
    box-shadow: none;
  }

  #shopify-section-{{ section.id }} .hc-multicolumn__ctas .button--secondary {
    background: rgba(0, 0, 0, 0.92);
    border-color: rgba(0, 0, 0, 0.92);
    color: #fff;
  }

  #shopify-section-{{ section.id }} .hc-multicolumn__ctas .button--secondary:hover {
    background: rgba(0, 0, 0, 0.85);
  }
{%- endstyle -%}

<section class="hc-multicolumn">
  <div class="page-width">
    <{{ section.settings.heading_tag }} class="hc-multicolumn__title {{ section.settings.heading_size }}">
      {{ section.settings.heading | escape }}
    </{{ section.settings.heading_tag }}>

    <div class="hc-multicolumn__grid" role="list">
      {%- for block in section.blocks -%}
        <div class="hc-multicolumn__card" role="listitem" {{ block.shopify_attributes }}>
          <div class="hc-multicolumn__icon" aria-hidden="true">
            {%- if block.settings.icon_image != blank -%}
              {{
                block.settings.icon_image
                | image_url: height: section.settings.icon_size
                | image_tag: loading: 'lazy', widths: '64, 96, 128', alt: block.settings.icon_alt
              }}
            {%- else -%}
              <svg viewBox="0 0 24 24" focusable="false" aria-hidden="true">
                <path d="M12 21a9 9 0 1 1 0-18 9 9 0 0 1 0 18Z"></path>
              </svg>
            {%- endif -%}
          </div>

          <div class="hc-multicolumn__heading rte">
            {{ block.settings.title }}
          </div>

          {%- if block.settings.text != blank -%}
            <div class="hc-multicolumn__text rte">
              {{ block.settings.text }}
            </div>
          {%- endif -%}
        </div>
      {%- endfor -%}
    </div>

    <div class="hc-multicolumn__ctas">
      {%- if section.settings.primary_button_label != blank -%}
        <a
          class="{% if section.settings.primary_button_unstyled %}hc-multicolumn__cta-link{% else %}button button--secondary button--medium{% endif %}"
          {% if section.settings.primary_button_link != blank %}href="{{ section.settings.primary_button_link }}"{% else %}role="link" aria-disabled="true"{% endif %}
        >
          {{ section.settings.primary_button_label | escape }}
        </a>
      {%- endif -%}
      {%- if section.settings.secondary_button_label != blank -%}
        <a
          class="{% if section.settings.secondary_button_unstyled %}hc-multicolumn__cta-link{% else %}button button--secondary button--medium{% endif %}"
          {% if section.settings.secondary_button_link != blank %}href="{{ section.settings.secondary_button_link }}"{% else %}role="link" aria-disabled="true"{% endif %}
        >
          {{ section.settings.secondary_button_label | escape }}
        </a>
      {%- endif -%}
    </div>
  </div>
</section>

<script>
  (function () {
    const root = document.getElementById('shopify-section-{{ section.id }}');
    if (!root) return;

    const headings = () => Array.from(root.querySelectorAll('.hc-multicolumn__heading'));
    if (headings().length === 0) return;

    const syncHeadingHeights = () => {
      const hs = headings();
      if (hs.length === 0) return;
      // Reset so measurements are natural
      hs.forEach((h) => (h.style.minHeight = ''));
      // Measure tallest
      let max = 0;
      hs.forEach((h) => {
        const rect = h.getBoundingClientRect();
        max = Math.max(max, rect.height);
      });
      if (!max) return;
      hs.forEach((h) => (h.style.minHeight = Math.ceil(max) + 'px'));
    };

    // Initial + on resize/font load
    const run = () => requestAnimationFrame(syncHeadingHeights);
    run();
    window.addEventListener('resize', run, { passive: true });
    if (document.fonts && document.fonts.ready) {
      document.fonts.ready.then(run).catch(() => {});
    }
  })();
</script>

{% schema %}
{
  "name": "Homepage multicolumn",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "What Makes Honey Cloudz Different?"
    },
    {
      "type": "select",
      "id": "heading_tag",
      "label": "Heading tag",
      "options": [
        { "value": "h2", "label": "H2" },
        { "value": "h3", "label": "H3" },
        { "value": "div", "label": "Div" }
      ],
      "default": "h2"
    },
    {
      "type": "select",
      "id": "heading_size",
      "label": "Heading size",
      "options": [
        { "value": "h2", "label": "Small" },
        { "value": "h1", "label": "Medium" },
        { "value": "h0", "label": "Large" }
      ],
      "default": "h1"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "default": "#bfeef8"
    },
    {
      "type": "header",
      "content": "Icons"
    },
    {
      "type": "color",
      "id": "icon_bg_color",
      "label": "Icon circle background",
      "default": "#f6efe9"
    },
    {
      "type": "color",
      "id": "icon_border_color",
      "label": "Icon circle border",
      "default": "#1a1b18"
    },
    {
      "type": "color",
      "id": "icon_color",
      "label": "Icon color (for SVG)",
      "default": "#1a1b18"
    },
    {
      "type": "range",
      "id": "icon_size",
      "label": "Icon size",
      "min": 16,
      "max": 60,
      "step": 2,
      "unit": "px",
      "default": 22
    },
    {
      "type": "range",
      "id": "icon_wrap_size",
      "label": "Icon circle size",
      "min": 44,
      "max": 88,
      "step": 2,
      "unit": "px",
      "default": 60
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "columns_desktop",
      "label": "Columns (desktop)",
      "options": [
        { "value": "3", "label": "3" },
        { "value": "4", "label": "4" }
      ],
      "default": "4"
    },
    {
      "type": "range",
      "id": "column_gap",
      "label": "Column gap",
      "min": 16,
      "max": 80,
      "step": 4,
      "unit": "px",
      "default": 48
    },
    {
      "type": "header",
      "content": "Buttons"
    },
    {
      "type": "text",
      "id": "primary_button_label",
      "label": "Primary button label",
      "default": "Shop Bra Inserts"
    },
    {
      "type": "checkbox",
      "id": "primary_button_unstyled",
      "label": "Primary button unstyled (link)",
      "default": false
    },
    {
      "type": "url",
      "id": "primary_button_link",
      "label": "Primary button link"
    },
    {
      "type": "text",
      "id": "secondary_button_label",
      "label": "Secondary button label",
      "default": "Explore Post-Op Solutions"
    },
    {
      "type": "checkbox",
      "id": "secondary_button_unstyled",
      "label": "Secondary button unstyled (link)",
      "default": false
    },
    {
      "type": "url",
      "id": "secondary_button_link",
      "label": "Secondary button link"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Padding top",
      "default": 56
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Padding bottom",
      "default": 56
    }
  ],
  "blocks": [
    {
      "type": "column",
      "name": "Column",
      "settings": [
        {
          "type": "image_picker",
          "id": "icon_image",
          "label": "Icon image"
        },
        {
          "type": "text",
          "id": "icon_alt",
          "label": "Icon alt text",
          "default": "Icon"
        },
        {
          "type": "richtext",
          "id": "title",
          "label": "Title",
          "default": "<p><strong>We <em>Actually</em> Act On<br>Feedback</strong></p>"
        },
        {
          "type": "richtext",
          "id": "text",
          "label": "Text",
          "default": "<p>For too long women’s inserts &amp; breast forms have been an afterthought. That’s why we take feedback so seriously.</p>"
        }
      ]
    }
  ],
  "max_blocks": 8,
  "presets": [
    {
      "name": "Homepage multicolumn",
      "category": "Homepage",
      "blocks": [
        { "type": "column" },
        { "type": "column" },
        { "type": "column" },
        { "type": "column" }
      ]
    }
  ]
}
{% endschema %}

