{%- comment -%}
  Wholesale-only “Why retailers trust Honey Cloudz”.
  Dedicated section so Custom image + features (Post-Op) is not affected.
{%- endcomment -%}

{%- style -%}
  #shopify-section-{{ section.id }} .wwr {
    --wwr-heading-font: var(--wsp-heading, Poppins, sans-serif);
    --wwr-body-font: var(--wsp-body, "Satoshi Medium", "Satoshi-Medium", Satoshi, sans-serif);
    background-color: {{ section.settings.background_color }};
    padding: {{ section.settings.padding_top }}px {{ section.settings.padding_x }}px {{ section.settings.padding_bottom }}px;
    overflow-x: clip;
  }

  #shopify-section-{{ section.id }} .wwr__content {
    display: contents;
  }

  #shopify-section-{{ section.id }} .wwr__inner {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 655px;
    gap: {{ section.settings.column_gap }}px;
    align-items: center;
    justify-content: space-between;
    max-width: 1310px;
    margin: 0 auto;
    width: 100%;
  }

  #shopify-section-{{ section.id }} .wwr__card {
    background: {{ section.settings.card_background }};
    border: 1px solid {{ section.settings.card_border_color }};
    border-radius: {{ section.settings.card_radius }}px;
    padding: {{ section.settings.card_padding }}px;
    box-sizing: border-box;
    max-width: {{ section.settings.card_max_width }}px;
    width: 100%;
    text-align: left;
  }

  #shopify-section-{{ section.id }} .wwr__eyebrow {
    margin: 0 0 {{ section.settings.eyebrow_spacing }}px;
    font-family: var(--wwr-heading-font) !important;
    font-size: {{ section.settings.eyebrow_font_size }}px !important;
    font-weight: {{ section.settings.eyebrow_font_weight }} !important;
    line-height: 1.2 !important;
    letter-spacing: 0 !important;
    text-transform: none !important;
    color: {{ section.settings.eyebrow_color }} !important;
  }

  #shopify-section-{{ section.id }} .wwr__heading {
    margin: 0 0 {{ section.settings.heading_spacing }}px !important;
    font-family: var(--wwr-heading-font) !important;
    font-size: {{ section.settings.heading_font_size }}px !important;
    font-weight: {{ section.settings.heading_font_weight }} !important;
    line-height: 40px !important;
    letter-spacing: 0 !important;
    color: {{ section.settings.heading_color }} !important;
  }

  #shopify-section-{{ section.id }} .wwr__text,
  #shopify-section-{{ section.id }} .wwr__text p,
  #shopify-section-{{ section.id }} .wwr__text span {
    font-family: var(--wwr-body-font) !important;
    font-size: {{ section.settings.text_font_size }}px !important;
    font-weight: {{ section.settings.text_font_weight }} !important;
    line-height: {{ section.settings.text_line_height }}px !important;
    color: {{ section.settings.text_color }} !important;
    letter-spacing: 0 !important;
  }

  #shopify-section-{{ section.id }} .wwr__text {
    margin: 0;
  }

  #shopify-section-{{ section.id }} .wwr__text p {
    margin: 0 0 {{ section.settings.text_paragraph_gap }}px !important;
  }

  #shopify-section-{{ section.id }} .wwr__text p:last-child {
    margin-bottom: 0 !important;
  }

  #shopify-section-{{ section.id }} .wwr__media {
    min-width: 0;
  }

  #shopify-section-{{ section.id }} .wwr__image-wrap {
    width: 655px;
    height: 655px;
    max-width: 100%;
    margin-left: auto;
    overflow: hidden;
    background: {{ section.settings.image_background }};
  }

  #shopify-section-{{ section.id }} .wwr__image-wrap img,
  #shopify-section-{{ section.id }} .wwr__image-wrap svg {
    display: block;
    width: 100% !important;
    height: 100% !important;
    object-fit: cover !important;
    object-position: center;
  }

  /* Mid desktop 998–1300 — fluid side-by-side */
  @media screen and (min-width: 998px) and (max-width: 1300px) {
    #shopify-section-{{ section.id }} .wwr {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
      padding-left: 40px;
      padding-right: 40px;
    }

    #shopify-section-{{ section.id }} .wwr__inner {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      gap: 32px;
      max-width: 1220px;
      width: 100%;
      margin-inline: auto;
    }

    #shopify-section-{{ section.id }} .wwr__card {
      max-width: 100%;
      padding: 40px 32px;
      border-radius: {{ section.settings.card_radius_tablet }}px;
    }

    #shopify-section-{{ section.id }} .wwr__image-wrap {
      width: 100%;
      height: auto;
      aspect-ratio: 1 / 1;
      margin-left: 0;
    }

    #shopify-section-{{ section.id }} .wwr__eyebrow {
      font-size: {{ section.settings.eyebrow_font_size_tablet }}px !important;
    }

    #shopify-section-{{ section.id }} .wwr__heading {
      font-size: {{ section.settings.heading_font_size_tablet }}px !important;
      line-height: 40px !important;
    }

    #shopify-section-{{ section.id }} .wwr__text,
    #shopify-section-{{ section.id }} .wwr__text p,
    #shopify-section-{{ section.id }} .wwr__text span {
      font-size: 16px !important;
      line-height: 24px !important;
    }
  }

  /* Large desktop 1301+ — 655px image, 571px card */
  @media screen and (min-width: 1301px) {
    #shopify-section-{{ section.id }} .wwr {
      padding-left: {{ section.settings.padding_x }}px;
      padding-right: {{ section.settings.padding_x }}px;
    }

    #shopify-section-{{ section.id }} .wwr__inner {
      grid-template-columns: minmax(0, 1fr) 655px;
      gap: {{ section.settings.column_gap }}px;
      max-width: 1310px;
    }

    #shopify-section-{{ section.id }} .wwr__card {
      max-width: {{ section.settings.card_max_width }}px;
      padding: {{ section.settings.card_padding }}px;
    }

    #shopify-section-{{ section.id }} .wwr__image-wrap {
      width: 655px;
      height: 655px;
      aspect-ratio: auto;
    }
  }

  /* Tablet stack 641–997 */
  @media (min-width: 641px) and (max-width: 997px) {
    #shopify-section-{{ section.id }} .wwr {
      padding-top: {{ section.settings.padding_top_tablet }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
      padding-left: {{ section.settings.padding_x_tablet }}px;
      padding-right: {{ section.settings.padding_x_tablet }}px;
    }

    #shopify-section-{{ section.id }} .wwr__inner {
      display: flex;
      flex-direction: column;
      gap: 32px;
      align-items: stretch;
      max-width: 720px;
      width: 100%;
      margin-inline: auto;
    }

    #shopify-section-{{ section.id }} .wwr__card {
      order: 1;
      width: 100%;
      max-width: 100%;
      padding: {{ section.settings.card_padding_tablet }}px {{ section.settings.card_padding_x_tablet }}px;
      border-radius: {{ section.settings.card_radius_tablet }}px;
    }

    #shopify-section-{{ section.id }} .wwr__media {
      order: 2;
      width: 100%;
      max-width: 100%;
    }

    #shopify-section-{{ section.id }} .wwr__image-wrap {
      width: 100%;
      height: auto;
      max-width: 100%;
      aspect-ratio: 1 / 1;
      margin-left: 0;
    }

    #shopify-section-{{ section.id }} .wwr__eyebrow {
      font-size: {{ section.settings.eyebrow_font_size_tablet }}px !important;
    }

    #shopify-section-{{ section.id }} .wwr__heading {
      font-size: {{ section.settings.heading_font_size_tablet }}px !important;
      line-height: 40px !important;
    }

    #shopify-section-{{ section.id }} .wwr__text,
    #shopify-section-{{ section.id }} .wwr__text p,
    #shopify-section-{{ section.id }} .wwr__text span {
      font-size: {{ section.settings.text_font_size_tablet }}px !important;
      line-height: {{ section.settings.text_line_height_tablet }}px !important;
    }
  }

  /* Mobile ≤749 — full-bleed image, inset card */
  @media screen and (max-width: 749px) {
    #shopify-section-{{ section.id }} .wwr {
      padding-left: {{ section.settings.padding_x_mobile }}px;
      padding-right: {{ section.settings.padding_x_mobile }}px;
    }

    #shopify-section-{{ section.id }} .wwr__inner {
      display: flex;
      flex-direction: column;
      gap: 32px;
      max-width: none;
    }

    #shopify-section-{{ section.id }} .wwr__card {
      order: 1;
      width: 100%;
      max-width: 100%;
      padding: 32px 20px;
      border-radius: 28px;
    }

    #shopify-section-{{ section.id }} .wwr__media {
      order: 2;
      width: calc(100% + {{ section.settings.padding_x_mobile | times: 2 }}px);
      max-width: none;
      margin-left: -{{ section.settings.padding_x_mobile }}px;
      margin-right: -{{ section.settings.padding_x_mobile }}px;
    }

    #shopify-section-{{ section.id }} .wwr__image-wrap {
      width: 100%;
      height: auto;
      aspect-ratio: 1 / 1;
      margin-left: 0;
    }
  }

  /* Mobile ≤640 */
  @media (max-width: 640px) {
    #shopify-section-{{ section.id }} .wwr {
      padding-top: {{ section.settings.padding_top_mobile }}px;
      padding-bottom: {{ section.settings.padding_bottom_mobile }}px;
      padding-left: {{ section.settings.padding_x_mobile }}px;
      padding-right: {{ section.settings.padding_x_mobile }}px;
    }

    #shopify-section-{{ section.id }} .wwr__inner {
      gap: 24px;
    }

    #shopify-section-{{ section.id }} .wwr__card {
      padding: {{ section.settings.card_padding_mobile }}px {{ section.settings.card_padding_x_mobile }}px;
      border-radius: {{ section.settings.card_radius_mobile }}px;
    }

    #shopify-section-{{ section.id }} .wwr__eyebrow {
      font-size: {{ section.settings.eyebrow_font_size_mobile }}px !important;
    }

    #shopify-section-{{ section.id }} .wwr__heading {
      font-size: {{ section.settings.heading_font_size_mobile }}px !important;
      line-height: 34px !important;
    }

    #shopify-section-{{ section.id }} .wwr__text,
    #shopify-section-{{ section.id }} .wwr__text p,
    #shopify-section-{{ section.id }} .wwr__text span {
      font-size: {{ section.settings.text_font_size_mobile }}px !important;
      line-height: {{ section.settings.text_line_height_mobile }}px !important;
    }
  }
{%- endstyle -%}

<div class="wwr">
  <div class="wwr__inner">
    <div class="wwr__content">
      <div class="wwr__card">
        {%- if section.settings.eyebrow != blank -%}
          <p class="wwr__eyebrow">{{ section.settings.eyebrow | escape }}</p>
        {%- endif -%}

        {%- if section.settings.heading != blank -%}
          <{{ section.settings.heading_tag }} class="wwr__heading">
            {{ section.settings.heading | escape }}
          </{{ section.settings.heading_tag }}>
        {%- endif -%}

        {%- if section.settings.text != blank -%}
          <div class="wwr__text rte">{{ section.settings.text }}</div>
        {%- endif -%}
      </div>
    </div>

    <div class="wwr__media">
      <div class="wwr__image-wrap">
        {%- if section.settings.image != blank -%}
          {{
            section.settings.image
            | image_url: width: 1400
            | image_tag:
              loading: 'lazy',
              widths: '400, 600, 800, 1000, 1200, 1400',
              sizes: '(min-width: 998px) 50vw, 100vw',
              alt: section.settings.image.alt | default: section.settings.heading | escape
          }}
        {%- else -%}
          {{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}
        {%- endif -%}
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Why retailers trust",
  "tag": "section",
  "class": "section wholesale-why-retailers",
  "disabled_on": {
    "groups": ["header", "footer", "custom.overlay"]
  },
  "settings": [
    {
      "type": "header",
      "content": "Image"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "color",
      "id": "image_background",
      "label": "Image placeholder background",
      "default": "#93e4f3"
    },
    {
      "type": "header",
      "content": "Eyebrow"
