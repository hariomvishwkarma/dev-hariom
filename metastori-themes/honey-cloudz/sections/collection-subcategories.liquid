{%- liquid
  assign has_blocks = false
  for block in section.blocks
    if block.settings.tab_label != blank
      assign has_blocks = true
      break
    endif
  endfor

  assign columns = section.settings.columns_desktop | default: 4
  assign grid_class = 'grid grid--2-col grid--3-col-tablet'
  if columns == 3
    assign grid_class = grid_class | append: ' grid--3-col-desktop'
  elsif columns == 2
    assign grid_class = grid_class | append: ' grid--2-col-desktop'
  else
    assign grid_class = grid_class | append: ' grid--4-col-desktop'
  endif
-%}

{%- if has_blocks -%}
  <div
    id="CollectionSubcategories-{{ section.id }}"
    class="collection-subcategories page-width section-{{ section.id }}-padding"
    data-collection-subcategories
  >
    {%- style -%}
      .section-{{ section.id }}-padding {
        padding-top: {{ section.settings.padding_top }}px;
        padding-bottom: {{ section.settings.padding_bottom }}px;
      }
      #CollectionSubcategories-{{ section.id }} .collection-subcategories__nav-bar {
        background: {{ section.settings.nav_background_color }};
      }
    {%- endstyle -%}

    {%- liquid
      assign all_panel_ids = ''
      for block in section.blocks
        if block.settings.tab_label != blank
          assign pid = 'panel-' | append: section.id | append: '-' | append: block.id
          if all_panel_ids != blank
            assign all_panel_ids = all_panel_ids | append: ' '
          endif
          assign all_panel_ids = all_panel_ids | append: pid
        endif
      endfor
    -%}
    <div class="collection-subcategories__nav-outer">
      <div
        class="collection-subcategories__nav-bar"
        role="tablist"
        aria-label="{{ section.settings.nav_aria_label | escape }}"
      >
      <button
        type="button"
        class="collection-subcategories__tab is-active"
        role="tab"
        id="tab-{{ section.id }}-all"
        aria-selected="true"
        aria-controls="{{ all_panel_ids | escape }}"
        tabindex="0"
        data-subcategory-all
      >
        <span class="collection-subcategories__tab-label">{{ section.settings.label_all | escape }}</span>
      </button>
      {%- for block in section.blocks -%}
        {%- if block.settings.tab_label != blank -%}
          <button
            type="button"
            class="collection-subcategories__tab"
            role="tab"
            id="tab-{{ section.id }}-{{ block.id }}"
            aria-selected="false"
            aria-controls="panel-{{ section.id }}-{{ block.id }}"
            tabindex="-1"
            data-subcategory-tab="{{ block.id }}"
            {{ block.shopify_attributes }}
          >
            <span class="collection-subcategories__tab-label">{{ block.settings.tab_label | escape }}</span>
          </button>
        {%- endif -%}
      {%- endfor -%}
      </div>
    </div>

    {%- for block in section.blocks -%}
      {%- if block.settings.tab_label == blank -%}
        {% continue %}
      {%- endif -%}
      <div
        id="panel-{{ section.id }}-{{ block.id }}"
        class="collection-subcategories__panel"
        role="tabpanel"
        aria-labelledby="tab-{{ section.id }}-{{ block.id }}"
        data-subcategory-panel="{{ block.id }}"
      >
        <div class="collection-subcategories__panel-header">
          <div class="collection-subcategories__panel-heading-col">
            {%- if block.settings.heading != blank -%}
              <h2 class="collection-subcategories__heading {{ section.settings.heading_size }}">
                {{ block.settings.heading | escape }}
              </h2>
            {%- endif -%}
            {%- if block.settings.subtitle != blank -%}
              <p class="collection-subcategories__subtitle">{{ block.settings.subtitle | escape }}</p>
            {%- endif -%}
          </div>
          {%- if block.settings.description != blank -%}
            <div class="collection-subcategories__description rte">{{ block.settings.description }}</div>
          {%- endif -%}
        </div>

        {%- liquid
          assign has_feature = false
          if block.settings.show_feature_image and block.settings.image != blank
            assign has_feature = true
          endif
          assign has_products = false
          if block.settings.products != blank
            for p in block.settings.products
              assign has_products = true
              break
            endfor
          endif
        -%}

        {%- if has_feature or has_products -%}
          <ul
            class="collection-subcategories__product-grid product-grid {{ grid_class }}"
            role="list"
          >
            {%- if has_feature -%}
              <li class="grid__item collection-subcategories__feature-item">
                <div class="collection-subcategories__feature-image media media--transparent">
                  {{
                    block.settings.image
                    | image_url: width: 1200
                    | image_tag:
                      loading: 'lazy',
                      sizes: '(min-width: 990px) 25vw, (min-width: 750px) 33vw, 50vw',
                      widths: '375, 550, 750, 1100, 1200',
                      alt: block.settings.image.alt | default: block.settings.heading | escape
                  }}
                </div>
              </li>
            {%- endif -%}

            {%- for product in block.settings.products -%}
              {%- capture hide_resource -%}
                {% render 'wc_product_visibility', resource: product %}
              {%- endcapture -%}
              {%- if hide_resource == 'true' -%}
                {% continue %}
              {%- endif -%}
              <li class="grid__item">
                {% render 'card-product',
                  card_product: product,
                  card_collection: collection,
                  media_size: section.settings.image_ratio,
                  show_secondary_image: section.settings.show_secondary_image,
                  show_quick_buy: section.settings.show_quick_buy,
                  show_vendor: section.settings.show_vendor,
                  show_rating: section.settings.show_rating,
                  enable_quick_view: section.settings.enable_quick_view,
                  enable_color_swatches: section.settings.enable_color_swatches,
                  enable_countdown: section.settings.enable_countdown,
                  enable_image_fill: section.settings.enable_image_fill,
                  lazy_load: true,
                  section_id: section.id
                %}
              </li>
            {%- endfor -%}
          </ul>
        {%- endif -%}
      </div>
    {%- endfor -%}
  </div>

  <script>
    (function () {
      var rootId = 'CollectionSubcategories-{{ section.id }}';

      function init() {
        var root = document.getElementById(rootId);
        if (!root || root.dataset.collectionSubcategoriesBound === '1') return !!root;

        var allBtn = root.querySelector('[data-subcategory-all]');
        var blockTabs = root.querySelectorAll('[data-subcategory-tab]');
        var panels = root.querySelectorAll('[data-subcategory-panel]');
        if (!panels.length) return false;
        if (!allBtn && !blockTabs.length) return false;

        root.dataset.collectionSubcategoriesBound = '1';

        function setTabFocus(activeEl) {
          var navTabs = root.querySelectorAll(
            '[data-subcategory-all], [data-subcategory-tab]'
          );
          navTabs.forEach(function (t) {
            var on = t === activeEl;
            t.setAttribute('tabindex', on ? '0' : '-1');
          });
        }

        function showAllPanels() {
          panels.forEach(function (panel) {
            panel.hidden = false;
          });
          if (allBtn) {
            allBtn.classList.add('is-active');
            allBtn.setAttribute('aria-selected', 'true');
            setTabFocus(allBtn);
          }
          blockTabs.forEach(function (tab) {
            tab.classList.remove('is-active');
            tab.setAttribute('aria-selected', 'false');
          });
        }

        function showPanel(blockId) {
          panels.forEach(function (panel) {
            var match = panel.getAttribute('data-subcategory-panel') === blockId;
            panel.hidden = !match;
          });
          if (allBtn) {
            allBtn.classList.remove('is-active');
            allBtn.setAttribute('aria-selected', 'false');
          }
          blockTabs.forEach(function (tab) {
            var on = tab.getAttribute('data-subcategory-tab') === blockId;
            tab.classList.toggle('is-active', on);
            tab.setAttribute('aria-selected', on ? 'true' : 'false');
            if (on) setTabFocus(tab);
          });
        }

        if (allBtn) {
          allBtn.addEventListener('click', function () {
            showAllPanels();
            try {
              history.replaceState(null, '', '#subcategory-all');
            } catch (e) {}
          });
        }

        blockTabs.forEach(function (tab) {
          tab.addEventListener('click', function () {
            var id = tab.getAttribute('data-subcategory-tab');
            if (!id) return;
            showPanel(id);
            try {
              history.replaceState(null, '', '#subcategory-' + id);
            } catch (e) {}
          });
        });

        function applyHash() {
          var h = (window.location.hash || '').replace(/^#/, '');
          if (h === 'subcategory-all' || h === 'all' || h === '') {
            if (allBtn) showAllPanels();
            return;
          }
          var m = h.match(/^subcategory-(.+)$/);
          if (m && m[1] && m[1] !== 'all') {
            var target = root.querySelector('[data-subcategory-tab="' + m[1] + '"]');
            if (target) {
              showPanel(m[1]);
              return;
            }
          }
        }

        applyHash();
        window.addEventListener('hashchange', applyHash);

        return true;
      }

      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', init);
      } else {
        init();
      }
    })();
  </script>
{%- endif -%}

{% stylesheet %}
    .collection-subcategories {
      margin-top: 0;
      margin-bottom: 0;
    }

    .collection-subcategories__nav-outer {
      width: 100%;
      margin-bottom: 2.4rem;
    }

    .collection-subcategories__nav-bar {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      justify-content: center;
      column-gap: clamp(1.2rem, 4vw, 3rem);
      row-gap: .5rem;
      min-height: 4rem;
      padding: 1.25rem 1rem;
      box-sizing: border-box;
      border: none;
      border-radius: 0;
    }

    .collection-subcategories__tab {
      appearance: none;
      margin: 0;
      padding: 0.35rem 0.5rem;
      border: none;
      border-radius: 0;
      background: transparent;
      color: rgb(var(--color-foreground));
      font: inherit;
      cursor: pointer;
      text-align: center;
      position: relative;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      transition: opacity 0.15s ease;
      flex: 0 1 auto;
    }

    .collection-subcategories__tab:hover:not(.is-active) {
      opacity: 0.75;
    }

    .collection-subcategories__tab:focus-visible {
      outline: 0.2rem solid rgba(var(--color-foreground), 0.35);
      outline-offset: 0.15rem;
    }

    .collection-subcategories__tab-label {
      font-size: 1.25rem;
      line-height: 1.35;
      font-weight: 400;
      text-decoration: none;
      color: inherit;
      text-wrap: balance;
    }

    .collection-subcategories__tab.is-active .collection-subcategories__tab-label {
      font-weight: 700;
      text-decoration: underline;
      text-decoration-thickness: 0.22em;
      text-underline-offset: 0.35em;
      text-decoration-color: rgb(var(--color-foreground));
    }

    @media screen and (min-width: 990px) {
      .collection-subcategories__nav-bar {
        padding: 1.5rem 1.25rem;
        row-gap: 1.5rem;
      }

      .collection-subcategories__tab-label {
        font-size: 1.35rem;
      }
    }

    .collection-subcategories__panel {
      margin-bottom: 8rem;
    }

    .collection-subcategories__panel:last-child {
      margin-bottom: 0;
    }

    .collection-subcategories__panel-header {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      justify-content: flex-start;
      gap: 1.2rem 2.4rem;
      margin-bottom: 5rem;
      text-align: left;
    }

    .collection-subcategories__panel-heading-col {
      text-align: left;
      line-height: 1;
    }

    .collection-subcategories__panel-header .collection-subcategories__description {
      flex: 1 1 min(32rem, 100%);
      min-width: 0;
      text-align: left;
    }

    .collection-subcategories__panel-header .collection-subcategories__description.rte,
    .collection-subcategories__panel-header .collection-subcategories__description.rte p,
    .collection-subcategories__panel-header .collection-subcategories__description.rte li {
      text-align: left;
    }

    .collection-subcategories__heading {
      margin: 0;
      font-weight: 700;
      color: rgb(var(--color-foreground));
      text-align: left;
    }

    .collection-subcategories__subtitle {
      margin: 0;
      font-size: 1.4rem;
      font-weight: 700;
      color: rgb(var(--color-foreground));
      text-align: left;
    }

    .collection-subcategories__description {
      font-size: 1.4rem;
      line-height: 1.5;
      text-align: left;
    }

    .collection-subcategories__feature-item .collection-subcategories__feature-image {
      border-radius: var(--border-radius, 0.8rem);
      overflow: hidden;
      height: 100%;
      min-height: 28rem;
    }

    .collection-subcategories__feature-item img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      display: block;
    }

    /* Keep the same column width whether a row has 1–N products (avoid flex-grow stretch) */
    .collection-subcategories__product-grid.product-grid {
      justify-content: flex-start;
    }

    .collection-subcategories__product-grid.product-grid .grid__item {
      flex-grow: 0;
    }

    @media screen and (max-width: 749px) {
      /* Full-bleed cream bar; content stays padded + centered */
      .collection-subcategories .collection-subcategories__nav-outer {
        width: 100vw;
        max-width: 100vw;
        margin-left: calc(50% - 50vw);
        margin-right: calc(50% - 50vw);
        margin-bottom: 2.5rem;
      }

      .collection-subcategories .collection-subcategories__nav-bar {
        width: 100%;
        box-sizing: border-box;
        text-align: center;
        justify-content: center;
        align-items: center;
        align-content: center;
        column-gap: 1.25rem;
        padding: 1.25rem 1.5rem;
      }

      .collection-subcategories__tab {
        justify-content: center;
      }

      .collection-subcategories__tab-label {
        font-size: 1.15rem;
        text-align: center;
      }

      .collection-subcategories__panel-header {
        flex-direction: column;
        align-items: center;
        text-align: center;
        gap: 1.2rem;
        margin-left: auto;
        margin-right: auto;
        max-width: 72rem;
      }

      .collection-subcategories__panel-heading-col {
        width: 100%;
        max-width: 48rem;
        margin: 0 auto;
        text-align: center;
      }

      .collection-subcategories__panel-header .collection-subcategories__description {
        width: 100%;
        max-width: 48rem;
        margin: 0 auto;
        text-align: center;
      }

      .collection-subcategories__panel-header .collection-subcategories__description.rte,
      .collection-subcategories__panel-header .collection-subcategories__description.rte p,
      .collection-subcategories__panel-header .collection-subcategories__description.rte li {
        text-align: center;
      }

      .collection-subcategories__heading {
        margin: 0;
        font-size: 24px !important;
        text-align: center;
      }

      .collection-subcategories__subtitle {
        font-size: 1.15rem;
        line-height: 1.35;
        text-align: center;
      }

      .collection-subcategories__description {
        text-align: center;
      }

      .collection-subcategories__feature-item .collection-subcategories__feature-image {
        min-height: 20rem;
      }
    }
{% endstylesheet %}

