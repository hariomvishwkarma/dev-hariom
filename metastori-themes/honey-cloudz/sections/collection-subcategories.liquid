{% schema %}
{
  "name": "Collection subcategories",
  "tag": "section",
  "class": "section collection-subcategories-section",
  "enabled_on": {
    "templates": ["collection"]
  },
  "settings": [
    {
      "type": "paragraph",
      "content": "Add a block per subcategory. “View all” shows every section at once (default). A specific tab shows only that block. Deep link: #subcategory-all or #subcategory-{block id}."
    },
    {
      "type": "color",
      "id": "nav_background_color",
      "label": "Tab bar background",
      "default": "#fff9e1"
    },
    {
      "type": "text",
      "id": "nav_aria_label",
      "label": "Tab bar accessibility label",
      "default": "Subcategories"
    },
    {
      "type": "text",
      "id": "label_all",
      "label": "View all tab label",
      "default": "View all"
    },
    {
      "type": "select",
      "id": "heading_size",
      "label": "Subcategory heading size",
      "options": [
        { "value": "h2", "label": "H2" },
        { "value": "h1", "label": "H1" },
        { "value": "h3", "label": "H3" }
      ],
      "default": "h2"
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "min": 2,
      "max": 4,
      "step": 1,
      "label": "Products per row (desktop)",
      "default": 4
    },
    {
      "type": "select",
      "id": "image_ratio",
      "label": "Product image ratio",
      "options": [
        { "value": "square", "label": "Square" },
        { "value": "portrait", "label": "Portrait" },
        { "value": "adapt", "label": "Adapt" }
      ],
      "default": "square"
    },
    {
      "type": "checkbox",
      "id": "show_secondary_image",
      "default": true,
      "label": "Show second image on hover"
    },
    {
      "type": "checkbox",
      "id": "show_vendor",
      "default": false,
      "label": "Show vendor"
    },
    {
      "type": "checkbox",
      "id": "show_rating",
      "default": true,
      "label": "Show product rating"
    },
    {
      "type": "checkbox",
      "id": "show_quick_buy",
      "default": true,
      "label": "Show quick buy"
    },
    {
      "type": "checkbox",
      "id": "enable_quick_view",
      "default": true,
      "label": "Enable quick view"
    },
    {
      "type": "checkbox",
      "id": "enable_color_swatches",
      "default": true,
      "label": "Enable color swatches"
    },
    {
      "type": "checkbox",
      "id": "enable_countdown",
      "default": false,
      "label": "Enable countdown"
    },
    {
      "type": "checkbox",
      "id": "enable_image_fill",
      "default": true,
      "label": "Enable image fill"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding top",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding bottom",
      "default": 36
    }
  ],
  "blocks": [
    {
      "type": "subcategory",
      "name": "Subcategory",
      "settings": [
        {
          "type": "text",
          "id": "tab_label",
          "label": "Tab label",
          "default": "Subcategory"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Heading"
        },
        {
          "type": "text",
          "id": "subtitle",
          "label": "Subtitle"
        },
        {
          "type": "richtext",
          "id": "description",
          "label": "Description",
          "default": "<p>Add description text for this subcategory.</p>"
        },
        {
          "type": "checkbox",
          "id": "show_feature_image",
          "label": "Show feature image in grid",
          "default": true
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Feature image"
        },
        {
          "type": "product_list",
          "id": "products",
          "label": "Products",
          "limit": 24
        }
      ]
    }
  ],
  "max_blocks": 12,
  "presets": [
    {
      "name": "Collection subcategories",
      "blocks": [
        {
          "type": "subcategory",
          "settings": {
            "tab_label": "Mastectomy (Non-Reconstruction)",
            "heading": "Mastectomy (Non-Reconstruction)",
            "subtitle": "",
            "description": "<p>Add descriptive copy for this group.</p>",
            "show_feature_image": true
          }
        },
        {
          "type": "subcategory",
          "settings": {
            "tab_label": "Mastectomy (Reconstruction)",
            "heading": "Mastectomy (Reconstruction)",
            "subtitle": "",
            "description": "<p>Add descriptive copy for this group.</p>",
            "show_feature_image": true
          }
        },
        {
          "type": "subcategory",
          "settings": {
            "tab_label": "Lumpectomy",
            "heading": "Lumpectomy",
            "subtitle": "",
            "description": "<p>Add descriptive copy for this group.</p>",
            "show_feature_image": true
          }
        },
        {
          "type": "subcategory",
          "settings": {
            "tab_label": "Explant",
            "heading": "Explant",
            "subtitle": "",
            "description": "<p>Add descriptive copy for this group.</p>",
            "show_feature_image": true
          }
        }
      ]
    }
  ]
}
{% endschema %}
