{% schema %}
  {
    "name": "Four Column Section",
    "settings": [
      {
        "type": "text",
        "id": "heading",
        "label": "Section Heading"
      },
      {
        "type": "image_picker",
        "id": "image_1",
        "label": "Column 1 Image"
      },
      {
        "type": "url",
        "id": "link_1",
        "label": "Column 1 Link"
      },
      {
        "type": "text",
        "id": "text_1",
        "label": "Column 1 Text"
      },
      {
        "type": "image_picker",
        "id": "image_2",
        "label": "Column 2 Image"
      },
      {
        "type": "url",
        "id": "link_2",
        "label": "Column 2 Link"
      },
      {
        "type": "text",
        "id": "text_2",
        "label": "Column 2 Text"
      },
      {
        "type": "image_picker",
        "id": "image_3",
        "label": "Column 3 Image"
      },
      {
        "type": "url",
        "id": "link_3",
        "label": "Column 3 Link"
      },
      {
        "type": "text",
        "id": "text_3",
        "label": "Column 3 Text"
      },
      {
        "type": "image_picker",
        "id": "image_4",
        "label": "Column 4 Image"
      },
      {
        "type": "url",
        "id": "link_4",
        "label": "Column 4 Link"
      },
      {
        "type": "text",
        "id": "text_4",
        "label": "Column 4 Text"
      }
    ],
    "presets": [
      {
        "name": "Four Columns",
        "category": "Custom Sections"
      }
    ]
  }
{% endschema %}

<div class="four-columns-section">
  <h2>{{ section.settings.heading }}</h2>
  <div class="columns">
    <div class="column">
      <a href="{{ section.settings.link_1 }}">
        <img src="{{ section.settings.image_1 | img_url: 'medium' }}" alt="Inserts for Balancing Uneven Breasts">
        <p>{{ section.settings.text_1 }}</p>
      </a>
    </div>
    <div class="column">
      <a href="{{ section.settings.link_2 }}">
        <img src="{{ section.settings.image_2 | img_url: 'medium' }}" alt="Push Up Bra Inserts">
        <p>{{ section.settings.text_2 }}</p>
      </a>
    </div>
    <div class="column">
      <a href="{{ section.settings.link_3 }}">
        <img src="{{ section.settings.image_3 | img_url: 'medium' }}" alt="Inserts for Bra Gaps">
        <p>{{ section.settings.text_3 }}</p>
      </a>
    </div>
    <div class="column">
      <a href="{{ section.settings.link_4 }}">
        <img src="{{ section.settings.image_4 | img_url: 'medium' }}" alt="Nipple Coverage Only">
        <p>{{ section.settings.text_4 }}</p>
      </a>
    </div>
  </div>
</div>

<style>
  .four-columns-section {
    text-align: center;
    margin: 40px 0;
  }
  .four-columns-section .columns {
    display: flex;
    justify-content: space-around;
  }
  .four-columns-section .column {
    flex: 1;
    padding: 0 10px;
  }
  .four-columns-section img {
    width: 100%;
    max-width: 200px;
    height: auto;
  }
  .four-columns-section .column a {
    text-decoration: none;
    color: inherit;
  }
</style>
