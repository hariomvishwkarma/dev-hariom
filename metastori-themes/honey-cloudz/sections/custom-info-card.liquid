{%- style -%}
  #shopify-section-{{ section.id }} .cic {
    --cic-heading-size: {{ section.settings.heading_font_size_desktop }}px;
    --cic-text-size: {{ section.settings.text_font_size_desktop }}px;
    --cic-note-size: {{ section.settings.note_font_size_desktop }}px;
    background-color: {{ section.settings.background_color }};
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }

  #shopify-section-{{ section.id }} .cic__inner {
    max-width: {{ section.settings.content_max_width }}px;
    margin: 0 auto;
    padding-inline: {{ section.settings.side_padding }}px;
    box-sizing: border-box;
  }

  #shopify-section-{{ section.id }} .cic__card {
    max-width: {{ section.settings.card_max_width }}px;
    margin: 0 auto;
    background-color: {{ section.settings.card_background }};
    border: {{ section.settings.card_border_width }}px solid {{ section.settings.card_border_color }};
    border-radius: {{ section.settings.card_radius }}px;
    padding: {{ section.settings.card_padding_y }}px {{ section.settings.card_padding_x }}px;
    text-align: {{ section.settings.text_alignment }};
    color: {{ section.settings.text_color }};
  }

  #shopify-section-{{ section.id }} .cic__icon {
    display: flex;
    justify-content: {{ section.settings.text_alignment }};
    margin: 0 0 {{ section.settings.icon_spacing }}px;
  }

  #shopify-section-{{ section.id }} .cic__icon img,
  #shopify-section-{{ section.id }} .cic__icon svg {
    width: {{ section.settings.icon_size }}px;
    height: {{ section.settings.icon_size }}px;
    display: block;
  }

  #shopify-section-{{ section.id }} .cic__heading {
    margin: 0 0 {{ section.settings.heading_spacing }}px;
    color: {{ section.settings.heading_color }};
    font-size: var(--cic-heading-size);
    font-weight: {{ section.settings.heading_font_weight }};
    line-height: 1.2;
  }

  #shopify-section-{{ section.id }} .cic__text {
    margin: 0 0 {{ section.settings.paragraph_spacing }}px;
    color: {{ section.settings.text_color }};
    font-size: var(--cic-text-size);
    font-weight: {{ section.settings.text_font_weight }};
    line-height: {{ section.settings.text_line_height }}%;
  }

  #shopify-section-{{ section.id }} .cic__text p {
    margin: 0 0 {{ section.settings.paragraph_spacing }}px;
  }

  #shopify-section-{{ section.id }} .cic__text p:last-child {
    margin-bottom: 0;
  }

  #shopify-section-{{ section.id }} .cic__note {
    margin: {{ section.settings.note_spacing }}px 0 0;
    background-color: {{ section.settings.note_background }};
    border-radius: {{ section.settings.note_radius }}px;
    padding: {{ section.settings.note_padding_y }}px {{ section.settings.note_padding_x }}px;
    color: {{ section.settings.note_text_color }};
    font-size: var(--cic-note-size);
    font-style: italic;
    line-height: 1.45;
  }

  #shopify-section-{{ section.id }} .cic__note p {
    margin: 0;
  }

  @media screen and (max-width: 989px) {
    #shopify-section-{{ section.id }} .cic {
      --cic-heading-size: {{ section.settings.heading_font_size_tablet }}px;
      --cic-text-size: {{ section.settings.text_font_size_tablet }}px;
      --cic-note-size: {{ section.settings.note_font_size_tablet }}px;
    }
  }

  @media screen and (max-width: 749px) {
    #shopify-section-{{ section.id }} .cic {
      --cic-heading-size: {{ section.settings.heading_font_size_mobile }}px;
      --cic-text-size: {{ section.settings.text_font_size_mobile }}px;
      --cic-note-size: {{ section.settings.note_font_size_mobile }}px;
      padding-top: {{ section.settings.padding_top_mobile }}px;
      padding-bottom: {{ section.settings.padding_bottom_mobile }}px;
    }

    #shopify-section-{{ section.id }} .cic__inner {
      padding-inline: {{ section.settings.side_padding_mobile }}px;
    }

    #shopify-section-{{ section.id }} .cic__card {
      padding: {{ section.settings.card_padding_y_mobile }}px {{ section.settings.card_padding_x_mobile }}px;
    }
  }
{%- endstyle -%}

<div class="cic" id="hc-mastectomy">
  <div class="cic__inner">
    <div class="cic__card">
      {%- for block in section.blocks -%}
        {%- case block.type -%}
          {%- when 'icon' -%}
            <div class="cic__icon" {{ block.shopify_attributes }}>
              {%- if block.settings.image != blank -%}
                {%- assign icon_alt = block.settings.image.alt | default: 'Icon' -%}
                {{
                  block.settings.image
                  | image_url: width: 120
                  | image_tag: loading: 'lazy', widths: '40, 60, 80, 120', alt: icon_alt
                }}
              {%- else -%}
                <svg viewBox="0 0 24 24" fill="{{ section.settings.icon_color }}" aria-hidden="true">
                  <path d="M12 21s-6.7-4.35-9.33-8.08C.7 10.4.8 7.3 3.05 5.5 5.1 3.85 7.9 4.2 9.5 6.05L12 8.8l2.5-2.75C16.1 4.2 18.9 3.85 20.95 5.5c2.25 1.8 2.35 4.9.38 7.42C18.7 16.65 12 21 12 21z"/>
                </svg>
              {%- endif -%}
            </div>
          {%- when 'heading' -%}
            {%- if block.settings.heading != blank -%}
              <{{ block.settings.heading_tag }} class="cic__heading" {{ block.shopify_attributes }}>
                {{ block.settings.heading | escape }}
              </{{ block.settings.heading_tag }}>
            {%- endif -%}
          {%- when 'text' -%}
            {%- if block.settings.text != blank -%}
              <div class="cic__text rte" {{ block.shopify_attributes }}>{{ block.settings.text }}</div>
            {%- endif -%}
          {%- when 'highlight' -%}
            {%- if block.settings.text != blank -%}
              <div class="cic__note rte" {{ block.shopify_attributes }}>{{ block.settings.text }}</div>
            {%- endif -%}
        {%- endcase -%}
      {%- endfor -%}
    </div>
  </div>
</div>

