{%- liquid
  assign layout = section.settings.layout
  if layout == blank
    assign layout = 'marquee'
  endif

  assign block_count = section.blocks.size
-%}

{%- style -%}
  #shopify-section-{{ section.id }} .custom-marquee {
    --cm-bg: {{ section.settings.background_color }};
    --cm-text: {{ section.settings.text_color }};
    --cm-padding-top: {{ section.settings.padding_top }}px;
    --cm-padding-bottom: {{ section.settings.padding_bottom }}px;
    --cm-item-gap: {{ section.settings.item_gap }}px;
    --cm-icon-size: {{ section.settings.icon_size }}px;
    --cm-font-size: {{ section.settings.font_size }}px;
    --cm-font-weight: {{ section.settings.font_weight }};
    --cm-marquee-duration: {{ section.settings.marquee_speed }}s;
    --cm-columns-desktop: {{ section.settings.columns_desktop }};
    --cm-columns-mobile: {{ section.settings.columns_mobile }};
    background-color: var(--cm-bg);
    color: var(--cm-text);
    padding-top: var(--cm-padding-top);
    padding-bottom: var(--cm-padding-bottom);
    overflow: hidden;
  }

  #shopify-section-{{ section.id }} .custom-marquee__inner {
    {% unless section.settings.full_width %}
      max-width: {{ section.settings.content_max_width }}px;
      margin: 0 auto;
      padding-inline: 1.5rem;
    {% endunless %}
  }

  #shopify-section-{{ section.id }} .custom-marquee__item {
    display: inline-flex;
    align-items: center;
    gap: 1.3rem;
    color: inherit;
    text-decoration: none;
    white-space: nowrap;
  }

  #shopify-section-{{ section.id }} .custom-marquee__icon {
    display: flex;
    align-items: center;
    justify-content: center;
    flex: 0 0 var(--cm-icon-size);
    width: var(--cm-icon-size);
    height: var(--cm-icon-size);
  }

  #shopify-section-{{ section.id }} .custom-marquee__icon img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    display: block;
  }

  #shopify-section-{{ section.id }} .custom-marquee__text {
    font-size: var(--cm-font-size);
    font-weight: var(--cm-font-weight);
    line-height: 1.2;
    letter-spacing: 0.01em;
  }

  #shopify-section-{{ section.id }} .custom-marquee--grid .custom-marquee__list {
    display: grid;
    grid-template-columns: repeat(var(--cm-columns-mobile), minmax(0, 1fr));
    gap: var(--cm-item-gap);
    list-style: none;
    margin: 0;
    padding: 0;
    justify-items: center;
  }

  @media screen and (min-width: 750px) {
    #shopify-section-{{ section.id }} .custom-marquee--grid .custom-marquee__list {
      grid-template-columns: repeat(var(--cm-columns-desktop), minmax(0, 1fr));
    }
  }

  #shopify-section-{{ section.id }} .custom-marquee--grid .custom-marquee__item {
    white-space: normal;
    text-align: center;
    justify-content: center;
  }

  #shopify-section-{{ section.id }} .custom-marquee--marquee .custom-marquee__viewport {
    overflow: hidden;
    width: 100%;
  }

  #shopify-section-{{ section.id }} .custom-marquee--marquee .custom-marquee__track {
    display: flex;
    width: max-content;
    animation: custom-marquee-scroll-{{ section.id }} var(--cm-marquee-duration) linear infinite;
    will-change: transform;
    {% if section.settings.marquee_direction == 'right' %}
      animation-direction: reverse;
    {% endif %}
  }

  {% if section.settings.pause_on_hover %}
    #shopify-section-{{ section.id }} .custom-marquee--marquee .custom-marquee__viewport:hover .custom-marquee__track {
      animation-play-state: paused;
    }
  {% endif %}

  #shopify-section-{{ section.id }} .custom-marquee--marquee .custom-marquee__list {
    display: flex;
    align-items: center;
    gap: var(--cm-item-gap);
    list-style: none;
    margin: 0;
    padding: 0;
    flex: 0 0 auto;
  }

  #shopify-section-{{ section.id }} .custom-marquee--marquee .custom-marquee__list-item {
    flex: 0 0 auto;
  }

  @keyframes custom-marquee-scroll-{{ section.id }} {
    from {
      transform: translate3d(0, 0, 0);
    }
    to {
      transform: translate3d(calc(-50% - var(--cm-item-gap) / 2), 0, 0);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    #shopify-section-{{ section.id }} .custom-marquee--marquee .custom-marquee__track {
      animation: none;
      flex-wrap: wrap;
      justify-content: center;
      width: 100%;
      gap: var(--cm-item-gap);
    }

    #shopify-section-{{ section.id }} .custom-marquee--marquee .custom-marquee__list-item--clone {
      display: none;
    }
  }

  {%- for block in section.blocks -%}
    {%- if block.settings.icon_size > 0 -%}
      #shopify-section-{{ section.id }} .custom-marquee__list-item--{{ block.id }} .custom-marquee__icon {
        flex-basis: {{ block.settings.icon_size }}px;
        width: {{ block.settings.icon_size }}px;
        height: {{ block.settings.icon_size }}px;
      }
    {%- endif -%}
  {%- endfor -%}
  @media screen and (max-width: 749px) {
    #shopify-section-{{ section.id }} .custom-marquee {
      padding-top: 1.0rem ;
      padding-bottom: 0rem;
    }
    #shopify-section-{{ section.id }} .custom-marquee__text{
      font-size: 1.8rem;
    }
  }
{%- endstyle -%}

<div class="custom-marquee custom-marquee--{{ layout }}">
  <div class="custom-marquee__inner">
    {%- if block_count > 0 -%}
      {%- if layout == 'grid' -%}
        <ul class="custom-marquee__list" role="list">
          {%- for block in section.blocks -%}
            {%- comment -%} Wholesale_Club_Product_Visibility_For_Loop Start {%- endcomment -%}
            {%- capture hide_resource -%}{% render "wc_product_visibility", resource: block %}{%- endcapture -%}
            {%- if hide_resource == 'true' -%}
              {% continue %}
            {%- endif -%}
            {%- comment -%} Wholesale_Club_Product_Visibility_For_Loop End {%- endcomment -%}
            {%- if block.settings.text != blank or block.settings.image != blank -%}
              <li
                class="custom-marquee__list-item custom-marquee__list-item--{{ block.id }}"
                {{ block.shopify_attributes }}
              >
                {%- if block.settings.link != blank -%}
                  <a class="custom-marquee__item" href="{{ block.settings.link }}">
                {%- else -%}
                  <div class="custom-marquee__item">
                {%- endif -%}
                {%- if block.settings.image != blank -%}
                  {%- assign marquee_image_alt = block.settings.image.alt | default: block.settings.text | escape -%}
                  <span class="custom-marquee__icon">
                    {{
                      block.settings.image
                      | image_url: width: 120
                      | image_tag: loading: 'lazy', widths: '40, 60, 80, 100, 120', alt: marquee_image_alt
                    }}
                  </span>
                {%- endif -%}
                {%- if block.settings.text != blank -%}
                  <span class="custom-marquee__text">{{ block.settings.text | escape }}</span>
                {%- endif -%}
                {%- if block.settings.link != blank -%}
                  </a>
                {%- else -%}
                  </div>
                {%- endif -%}
              </li>
            {%- endif -%}
          {%- endfor -%}
        </ul>
      {%- else -%}
        <div class="custom-marquee__viewport">
          <div class="custom-marquee__track">
            <ul class="custom-marquee__list" role="list">
              {%- for list_pass in (1..2) -%}
                {%- for block in section.blocks -%}
                  {%- comment -%} Wholesale_Club_Product_Visibility_For_Loop Start {%- endcomment -%}
                  {%- capture hide_resource -%}{% render "wc_product_visibility", resource: block %}{%- endcapture -%}
                  {%- if hide_resource == 'true' -%}
                    {% continue %}
                  {%- endif -%}
                  {%- comment -%} Wholesale_Club_Product_Visibility_For_Loop End {%- endcomment -%}
                  {%- if block.settings.text != blank or block.settings.image != blank -%}
                    <li
                      class="custom-marquee__list-item custom-marquee__list-item--{{ block.id }}{% if list_pass == 2 %} custom-marquee__list-item--clone{% endif %}"
                      {% if list_pass == 2 %}
                        aria-hidden="true"
                      {% endif %}
                      {% if list_pass == 1 %}
                        {{- block.shopify_attributes -}}
                      {% endif %}
                    >
                      {%- if block.settings.link != blank -%}
                        <a class="custom-marquee__item" href="{{ block.settings.link }}">
                      {%- else -%}
                        <div class="custom-marquee__item">
                      {%- endif -%}
                      {%- if block.settings.image != blank -%}
                        {%- assign marquee_image_alt = block.settings.image.alt
                          | default: block.settings.text
                          | escape
                        -%}
                        <span class="custom-marquee__icon">
                          {{
                            block.settings.image
                            | image_url: width: 120
                            | image_tag: loading: 'lazy', widths: '40, 60, 80, 100, 120', alt: marquee_image_alt
                          }}
                        </span>
                      {%- endif -%}
                      {%- if block.settings.text != blank -%}
                        <span class="custom-marquee__text">{{ block.settings.text | escape }}</span>
                      {%- endif -%}
                      {%- if block.settings.link != blank -%}
                        </a>
                      {%- else -%}
                        </div>
                      {%- endif -%}
                    </li>
                  {%- endif -%}
                {%- endfor -%}
              {%- endfor -%}
            </ul>
          </div>
        </div>
      {%- endif -%}
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "Custom marquee",
  "tag": "section",
  "class": "section",
  "max_blocks": 12,
  "settings": [
    {
      "type": "select",
      "id": "layout",
      "label": "Layout",
      "options": [
        { "value": "marquee", "label": "Marquee (scroll)" },
        { "value": "grid", "label": "Grid (static)" }
      ],
      "default": "marquee"
    },
    {
      "type": "header",
      "content": "Colors & spacing"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background",
      "default": "#E586B2"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text & icon color",
      "default": "#FFFFFF"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 80,
      "step": 2,
      "unit": "px",
      "label": "Padding top",
      "default": 24
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 80,
      "step": 2,
      "unit": "px",
      "label": "Padding bottom",
      "default": 24
    },
    {
      "type": "range",
      "id": "item_gap",
      "min": 12,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Space between items",
      "default": 48
    },
    {
      "type": "header",
      "content": "Typography & icons"
    },
    {
      "type": "range",
      "id": "font_size",
      "min": 12,
      "max": 24,
      "step": 1,
      "unit": "px",
      "label": "Font size",
      "default": 15
    },
    {
      "type": "select",
      "id": "font_weight",
      "label": "Font weight",
      "options": [
        { "value": "400", "label": "Regular" },
        { "value": "500", "label": "Medium" },
        { "value": "600", "label": "Semibold" },
        { "value": "700", "label": "Bold" }
      ],
      "default": "500"
    },
    {
      "type": "range",
      "id": "icon_size",
      "min": 16,
      "max": 48,
      "step": 2,
      "unit": "px",
      "label": "Icon size",
      "info": "Default icon size for all items. Can be overridden per block.",
      "default": 24
    },
    {
      "type": "header",
      "content": "Marquee options"
    },
    {
      "type": "range",
      "id": "marquee_speed",
      "min": 8,
      "max": 60,
      "step": 2,
      "unit": "s",
      "label": "Scroll speed",
      "info": "Lower is faster.",
      "default": 24
    },
    {
      "type": "select",
      "id": "marquee_direction",
      "label": "Scroll direction",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "right", "label": "Right" }
      ],
      "default": "left"
    },
    {
      "type": "checkbox",
      "id": "pause_on_hover",
      "label": "Pause on hover",
      "default": true
    },
    {
      "type": "header",
      "content": "Grid options"
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "min": 1,
      "max": 6,
      "step": 1,
      "label": "Columns on desktop",
      "default": 4
    },
    {
      "type": "select",
      "id": "columns_mobile",
      "label": "Columns on mobile",
      "options": [
        { "value": "1", "label": "1" },
        { "value": "2", "label": "2" }
      ],
      "default": "1"
    },
    {
      "type": "header",
      "content": "Width"
    },
    {
      "type": "checkbox",
      "id": "full_width",
      "label": "Full width",
      "default": true
    },
    {
      "type": "range",
      "id": "content_max_width",
      "min": 600,
      "max": 1600,
      "step": 20,
      "unit": "px",
      "label": "Max width",
      "default": 1200
    }
  ],
  "blocks": [
    {
      "type": "item",
      "name": "Item",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Icon"
        },
        {
          "type": "range",
          "id": "icon_size",
          "min": 0,
          "max": 80,
          "step": 2,
          "unit": "px",
          "label": "Icon size",
          "info": "Set to 0 to use section default.",
          "default": 0
        },
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "default": "Feature text"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link (optional)"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Custom marquee",
      "settings": {
        "layout": "marquee",
        "background_color": "#E586B2",
        "text_color": "#FFFFFF",
        "padding_top": 24,
        "padding_bottom": 24,
        "item_gap": 56,
        "font_size": 15
      },
      "blocks": [
        {
          "type": "item",
          "settings": {
            "text": "Cloud-Soft Comfort"
          }
        },
        {
          "type": "item",
          "settings": {
            "text": "Patented Grippy-Dot Exterior"
          }
        },
        {
          "type": "item",
          "settings": {
            "text": "Designed To Stay In Place"
          }
        },
        {
          "type": "item",
          "settings": {
            "text": "Tested & Loved by Women Everywhere"
          }
        }
      ]
    },
    {
      "name": "Custom marquee (grid)",
      "settings": {
        "layout": "grid",
        "background_color": "#E586B2",
        "text_color": "#FFFFFF",
        "columns_desktop": 4,
        "padding_top": 24,
        "padding_bottom": 24
      },
      "blocks": [
        {
          "type": "item",
          "settings": {
            "text": "Cloud-Soft Comfort"
          }
        },
        {
          "type": "item",
          "settings": {
            "text": "Patented Grippy-Dot Exterior"
          }
        },
        {
          "type": "item",
          "settings": {
            "text": "Designed To Stay In Place"
          }
        },
        {
          "type": "item",
          "settings": {
            "text": "Tested & Loved by Women Everywhere"
          }
        }
      ]
    }
  ]
}
{% endschema %}
