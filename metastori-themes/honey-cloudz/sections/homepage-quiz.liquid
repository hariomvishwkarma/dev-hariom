{%- style -%}
  #shopify-section-{{ section.id }} {
    --section-padding-top: {{ section.settings.padding_top }}px;
    --section-padding-bottom: {{ section.settings.padding_bottom }}px;
    --hq-section-bg: {{ section.settings.section_background_color }};
    --hq-bg: {{ section.settings.background_color }};
    --hq-border: {{ section.settings.border_color }};
    --hq-radius: {{ section.settings.card_radius }}px;
    --hq-card-pad: {{ section.settings.card_padding }}px;
  }

  .hc-quiz .page-width {
    max-width: {{ section.settings.content_max_width | default: 1320 }}px;
  }

  .hc-quiz {
    background: var(--hq-section-bg);
    padding-top: calc(var(--section-padding-top) * 0.75);
    padding-bottom: calc(var(--section-padding-bottom) * 0.75);
  }

  @media screen and (min-width: 750px) {
    .hc-quiz {
      padding-top: var(--section-padding-top);
      padding-bottom: var(--section-padding-bottom);
    }
  }

  .hc-quiz__card {
    position: relative;
    border-radius: var(--hq-radius);
    border: 1px solid var(--hq-border);
    background-color: var(--hq-bg);
    overflow: hidden;
  }

  .hc-quiz__card::before {
    content: '';
    position: absolute;
    inset: 0;
    background-size: cover;
    background-position: center;
    background-repeat: no-repeat;
    opacity: {{ section.settings.background_image_opacity | times: 0.01 }};
    pointer-events: none;
    z-index: 0;
  }

  {%- if section.settings.background_image != blank -%}
    #shopify-section-{{ section.id }} .hc-quiz__card::before {
      background-image: url('{{ section.settings.background_image | image_url: width: 2000 }}');
    }
  {%- endif -%}

  .hc-quiz__inner {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: 1fr;
    gap: 2rem;
    align-items: stretch;
  }

  @media screen and (min-width: 990px) {
    .hc-quiz__inner {
      grid-template-columns: 1.15fr 0.85fr;
      gap: 2.8rem;
    }
  }

  .hc-quiz__content {
    max-width: 52rem;
    padding: calc(var(--hq-card-pad) * 0.8);
    display: flex;
    flex-direction: column;
    justify-content: center; /* vertically center the left text */
    height: 100%;
  }

  @media screen and (min-width: 990px) {
    .hc-quiz__content {
      padding: var(--hq-card-pad);
    }
  }

  .hc-quiz__heading {
    margin: 0 0 0.8rem;
    letter-spacing: 0;
    line-height: 1.1;
  }

  .hc-quiz__text {
    margin: 0;
    color: rgba(var(--color-foreground), 0.85);
    font-size: 1.5rem;
    line-height: 1.55;
    max-width: 54rem;
  }

  .hc-quiz__cta {
    margin-top: 1.8rem;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border-radius: 999px;
    text-transform: none;
    letter-spacing: 0;
    width: fit-content;
    padding: 1.2rem 2.6rem;
    font-size: 1.6rem;
    font-weight: 700;
    background: rgba(0, 0, 0, 0.95);
    border: 1px solid rgba(0, 0, 0, 0.95);
    color: #fff;
    text-decoration: none;
    box-shadow: none;
  }

  .hc-quiz__cta:hover {
    background: rgba(0, 0, 0, 0.85);
    border-color: rgba(0, 0, 0, 0.85);
  }

  .hc-quiz__media {
    display: flex;
    justify-content: flex-end;
    align-items: flex-end;
    align-self: end; /* keep the right image pinned to bottom */
    padding: calc(var(--hq-card-pad) * 0.8) calc(var(--hq-card-pad) * 0.8) 0 calc(var(--hq-card-pad) * 0.8);
  }

  @media screen and (min-width: 990px) {
    .hc-quiz__media {
      padding: var(--hq-card-pad) var(--hq-card-pad) 0 0;
    }
  }

  .hc-quiz__media img,
  .hc-quiz__media svg {
    display: block;
    max-width: 100%;
    height: auto;
  }

  @media screen and (max-width: 989px) {
    .hc-quiz__media {
      justify-content: center;
    }
  }
{%- endstyle -%}

<section class="hc-quiz" id="hc-fit-quiz">
  <div class="page-width">
    <div class="hc-quiz__card">
      <div class="hc-quiz__inner">
        <div class="hc-quiz__content">
          <{{ section.settings.heading_tag }} class="hc-quiz__heading {{ section.settings.heading_size }}">
            {{ section.settings.heading | escape }}
          </{{ section.settings.heading_tag }}>

          {%- if section.settings.text != blank -%}
            <p class="hc-quiz__text">{{ section.settings.text | escape }}</p>
          {%- endif -%}

          {%- if section.settings.button_label != blank -%}
            <a class="hc-quiz__cta" {% if section.settings.button_link != blank %}href="{{ section.settings.button_link }}"{% else %}role="link" aria-disabled="true"{% endif %}>
              {{ section.settings.button_label | escape }}
            </a>
          {%- endif -%}
        </div>

        <div class="hc-quiz__media" aria-hidden="true">
          {%- if section.settings.image != blank -%}
            <img
              src="{{ section.settings.image | image_url: width: 1200 }}"
              alt=""
              loading="lazy"
              width="1200"
              height="{{ 1200 | divided_by: section.settings.image.aspect_ratio | round }}"
            >
          {%- else -%}
            {{ 'image' | placeholder_svg_tag: 'placeholder' }}
          {%- endif -%}
        </div>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Homepage quiz",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "color",
      "id": "section_background_color",
      "label": "Section background color",
      "default": "transparent"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Find Your Perfect Fit!"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Text",
      "default": "Not sure which design is right for you? Our 30 sec. quiz helps you find the inserts or breast form that suits your needs."
    },
    {
      "type": "select",
      "id": "heading_tag",
      "label": "Heading tag",
      "options": [
        { "value": "h2", "label": "H2" },
        { "value": "h3", "label": "H3" },
        { "value": "div", "label": "Div" }
      ],
      "default": "h2"
    },
    {
      "type": "select",
      "id": "heading_size",
      "label": "Heading size",
      "options": [
        { "value": "h2", "label": "Small" },
        { "value": "h1", "label": "Medium" },
        { "value": "h0", "label": "Large" }
      ],
      "default": "h1"
    },
    {
      "type": "header",
      "content": "Button"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Take The Quiz"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    },
    {
      "type": "header",
      "content": "Images"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Right image"
    },
    {
      "type": "image_picker",
      "id": "background_image",
      "label": "Background image (optional)"
    },
    {
      "type": "range",
      "id": "background_image_opacity",
      "label": "Background image opacity",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 100
    },
    {
      "type": "header",
      "content": "Style"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Card background color",
      "default": "#d6f3fb"
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "Card border color",
      "default": "#111111"
    },
    {
      "type": "range",
      "id": "card_radius",
      "label": "Card corner radius",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 18
    },
    {
      "type": "range",
      "id": "card_padding",
      "label": "Card padding",
      "min": 16,
      "max": 80,
      "step": 4,
      "unit": "px",
      "default": 36
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "content_max_width",
      "min": 800,
      "max": 1400,
      "step": 20,
      "unit": "px",
      "label": "Content max width",
      "default": 1320
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Padding top",
      "default": 32
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Padding bottom",
      "default": 32
    }
  ],
  "presets": [
    {
      "name": "Homepage quiz",
      "category": "Homepage"
    }
  ]
}
{% endschema %}

