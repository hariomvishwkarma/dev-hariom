{% comment %}
  ============================================================================
  Section: Before & After Image
  ============================================================================
{% endcomment %}

<style>
  .before-after-section-{{ section.id }} {
    background-color: {{ section.settings.section_background }};
    padding: 50px 20px;
    text-align: center;
  }

  .before-after-section-{{ section.id }} .ba-container {
    max-width: 900px;
    margin: 0 auto;
  }

  .before-after-section-{{ section.id }} .ba-heading {
    font-family: "Send Flowers", cursive;
  font-weight: 400;
  font-style: normal;
  font-size:48px;
    color: {{ section.settings.heading_color }};
    margin: 0 0 40px 0;
  }

  .before-after-section-{{ section.id }} .ba-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 30px;
    align-items: start;
  }

  .before-after-section-{{ section.id }} .ba-column {
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .before-after-section-{{ section.id }} .ba-label {
    display: inline-block;
    padding: 8px 24px;
    background-color: {{ section.settings.label_background }};
    color: {{ section.settings.label_text_color }};
    border-radius: 50px;
    font-size: 16px;
    font-weight: 600;
    margin-bottom: 15px; letter-spacing:normal;
  }

  .before-after-section-{{ section.id }} .ba-image-wrapper {
    overflow: hidden;
    width: 100%;
  }

  .before-after-section-{{ section.id }} .ba-image-wrapper img {
    display: block;
    width: 100%;
    height: auto;
  }

  .before-after-section-{{ section.id }} .ba-caption {
    display: inline-block;
    margin-top: 40px;
    padding: 12px 0px;
    border: 1px solid rgb(51 51 51 / 60%);
    background-color: #ffffff;
    border-radius: 8px;
    color: {{ section.settings.caption_text_color }};
    font-size: 18px;
    font-family: 'Satoshi';
    max-width:642px;
    width:100%; letter-spacing:normal;
  }

  .before-after-section-{{ section.id }} .ba-caption p{
    margin:0px;
  }

  /* Responsive styling for mobile */
  @media screen and (max-width: 768px) {
    .before-after-section-{{ section.id }} .ba-heading { font-size:32px; }
    .before-after-section-{{ section.id }} .ba-grid {
      grid-template-columns: 1fr;
      gap: 40px;
    }
    .before-after-section-{{ section.id }} {
      padding: 40px 15px;
    }
  }
</style>

<div class="before-after-section-{{ section.id }}">
  <div class="ba-container">

    {% if section.settings.heading != blank %}
      <h2 class="ba-heading">{{ section.settings.heading | escape }}</h2>
    {% endif %}

    <div class="ba-grid">
      <div class="ba-column">
        {% if section.settings.before_label != blank %}
          <div class="ba-label">{{ section.settings.before_label | escape }}</div>
        {% endif %}
        <div class="ba-image-wrapper">
          {% if section.settings.before_image != blank %}
            <img
              src="{{ section.settings.before_image | image_url: width: 800 }}"
              alt="{{ section.settings.before_image.alt | default: 'Before image' | escape }}"
              width="{{ section.settings.before_image.width }}"
              height="{{ section.settings.before_image.height }}"
              loading="lazy"
            >
          {% else %}
            {{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}
          {% endif %}
        </div>
      </div>

      <div class="ba-column">
        {% if section.settings.after_label != blank %}
          <div class="ba-label">{{ section.settings.after_label | escape }}</div>
        {% endif %}
        <div class="ba-image-wrapper">
          {% if section.settings.after_image != blank %}
            <img
              src="{{ section.settings.after_image | image_url: width: 800 }}"
              alt="{{ section.settings.after_image.alt | default: 'After image' | escape }}"
              width="{{ section.settings.after_image.width }}"
              height="{{ section.settings.after_image.height }}"
              loading="lazy"
            >
          {% else %}
            {{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}
          {% endif %}
        </div>
      </div>
    </div>

    {% if section.settings.caption_text != blank %}
      <div class="ba-caption">
        <p>{{ section.settings.caption_text | escape }}</p>
      </div>
    {% endif %}

  </div>
</div>

{% schema %}
{
  "name": "Before & After Image",
  "tag": "section",
  "class": "spaced-section",
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Oval Push Ups"
    },
    {
      "type": "text",
      "id": "before_label",
      "label": "Before Label",
      "info": "You can add emojis here too! e.g., Before 🤯",
      "default": "Before 🤯"
    },
    {
      "type": "image_picker",
      "id": "before_image",
      "label": "Before Image"
    },
    {
      "type": "text",
      "id": "after_label",
      "label": "After Label",
      "info": "You can add emojis here too! e.g., After 💕",
      "default": "After 💕"
    },
    {
      "type": "image_picker",
      "id": "after_image",
      "label": "After Image"
    },
    {
      "type": "text",
      "id": "caption_text",
      "label": "Caption Text",
      "default": "Anna is wearing our Oval Push Ups Size 32B, Size Small"
    },
    {
      "type": "header",
      "content": "Color Settings"
    },
    {
      "type": "color",
      "id": "section_background",
      "label": "Section Background",
      "default": "#FEF7F7"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading Text Color",
      "default": "#C77B8A"
    },
    {
      "type": "color",
      "id": "label_background",
      "label": "Label Background",
      "default": "#F472B6"
    },
    {
      "type": "color",
      "id": "label_text_color",
      "label": "Label Text Color",
      "default": "#333333"
    },
    {
      "type": "color",
      "id": "caption_text_color",
      "label": "Caption Text Color",
      "default": "#555555"
    }
  ],
  "presets": [
    {
      "name": "Before & After Image"
    }
  ]
}
{% endschema %}