{%- liquid
  assign layout_flip = section.settings.flip_layout
  assign image_fit = section.settings.image_fit
  if image_fit == blank
    assign image_fit = 'cover'
  endif

  assign feature_blocks = section.blocks | where: 'type', 'feature'
  assign content_width = section.settings.content_column_width
  assign media_width = 100 | minus: content_width

  case section.settings.content_alignment
    when 'center'
      assign content_text_align = 'center'
      assign content_margin = 'margin-inline: auto;'
    when 'right'
      assign content_text_align = 'right'
      assign content_margin = 'margin-left: auto;'
    else
      assign content_text_align = 'left'
      assign content_margin = ''
  endcase
-%}

{%- style -%}
  #shopify-section-{{ section.id }} .cif {
    --cif-bg: {{ section.settings.background_color }};
    --cif-content-bg: {{ section.settings.content_background }};
    --cif-eyebrow-color: {{ section.settings.eyebrow_color }};
    --cif-heading-color: {{ section.settings.heading_color }};
    --cif-text-color: {{ section.settings.text_color }};
    --cif-feature-title-color: {{ section.settings.feature_title_color }};
    --cif-feature-text-color: {{ section.settings.feature_text_color }};
    --cif-number-bg: {{ section.settings.number_background }};
    --cif-number-color: {{ section.settings.number_color }};
    --cif-number-size: {{ section.settings.number_size }}px;
    --cif-image-radius: {{ section.settings.image_border_radius }}px;
    --cif-image-border: {{ section.settings.image_border_width }}px solid {{ section.settings.image_border_color }};
    --cif-content-col: minmax(0, {{ content_width }}fr);
    --cif-media-col: minmax(0, {{ media_width }}fr);
    --cif-column-gap: {{ section.settings.column_gap }}px;
    --cif-content-pad: {{ section.settings.content_padding }}px;
    --cif-content-max: {{ section.settings.content_max_width }}px;
    --cif-feature-gap: {{ section.settings.feature_gap }}px;
    --cif-mobile-gap: {{ section.settings.mobile_block_gap }}px;
    --cif-mobile-padding-x: {{ section.settings.mobile_padding_x }}px;
    background-color: var(--cif-bg);
    padding: {{ section.settings.padding_top }}px 0 {{ section.settings.padding_bottom }}px;
    overflow-x: clip;
  }

  {% unless section.settings.use_theme_page_width %}
  #shopify-section-{{ section.id }} .cif__page-width {
    max-width: {{ section.settings.section_max_width }}px;
    margin: 0 auto;
    padding-inline: 1.5rem;
    width: 100%;
    box-sizing: border-box;
  }
  {% endunless %}

  #shopify-section-{{ section.id }} .cif__grid {
    display: grid;
    grid-template-columns: var(--cif-media-col) var(--cif-content-col);
    gap: var(--cif-column-gap);
    align-items: {{ section.settings.vertical_alignment }};
    width: 100%;
    min-width: 0;
  }

  #shopify-section-{{ section.id }} .cif--flip .cif__media {
    order: 2;
  }

  #shopify-section-{{ section.id }} .cif--flip .cif__content {
    order: 1;
  }

  #shopify-section-{{ section.id }} .cif__media,
  #shopify-section-{{ section.id }} .cif__content {
    min-width: 0;
    max-width: 100%;
  }

  #shopify-section-{{ section.id }} .cif__media {
    display: flex;
    align-items: stretch;
  }

  #shopify-section-{{ section.id }} .cif__image-wrap {
    width: 100%;
    overflow: hidden;
    border-radius: var(--cif-image-radius);
    border: var(--cif-image-border);
    background-color: {{ section.settings.image_background }};
    {% if section.settings.image_ratio != 'auto' %}
      aspect-ratio: {{ section.settings.image_ratio }};
    {% else %}
      min-height: {{ section.settings.image_min_height }}px;
    {% endif %}
  }

  #shopify-section-{{ section.id }} .cif__image-wrap img {
    display: block;
    width: 100%;
    {% if section.settings.image_ratio != 'auto' %}
      height: 100%;
    {% else %}
      height: auto;
      min-height: {{ section.settings.image_min_height }}px;
    {% endif %}
    object-fit: {{ image_fit }};
    object-position: {{ section.settings.image_position }};
  }

  #shopify-section-{{ section.id }} .cif__content {
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: var(--cif-feature-gap);
    background-color: var(--cif-content-bg);
    padding: var(--cif-content-pad);
    box-sizing: border-box;
  }

  #shopify-section-{{ section.id }} .cif__intro {
    width: 100%;
    max-width: min(var(--cif-content-max), 100%);
    text-align: {{ content_text_align }};
    {{ content_margin }}
  }

  #shopify-section-{{ section.id }} .cif__eyebrow {
    margin: 0 0 {{ section.settings.eyebrow_spacing }}px;
    color: var(--cif-eyebrow-color);
    font-size: {{ section.settings.eyebrow_font_size_mobile }}px;
    font-size: var(--hc-small, {{ section.settings.eyebrow_font_size_mobile }}px);
    line-height: 1.35;
    font-weight: var(--hc-fw-body, {{ section.settings.eyebrow_font_weight }});
    letter-spacing: var(--hc-ls, {{ section.settings.eyebrow_letter_spacing }}em);
    text-transform: {{ section.settings.eyebrow_text_transform }};
  }

  #shopify-section-{{ section.id }} .cif__heading {
    margin: 0 0 {{ section.settings.heading_spacing }}px;
    color: var(--cif-heading-color);
    font-size: {{ section.settings.heading_font_size_mobile }}px;
    font-size: var(--hc-h1-m, {{ section.settings.heading_font_size_mobile }}px);
    line-height: var(--hc-lh-h1, 1.1);
    font-weight: var(--hc-fw-heading, {{ section.settings.heading_font_weight }});
    letter-spacing: var(--hc-ls, 0);
  }

  #shopify-section-{{ section.id }} .cif__text {
    margin: 0 0 {{ section.settings.text_spacing }}px;
    color: var(--cif-text-color);
    font-size: {{ section.settings.text_font_size_mobile }}px;
    font-size: var(--hc-body-m, {{ section.settings.text_font_size_mobile }}px);
    line-height: var(--hc-lh-body, {{ section.settings.text_line_height }}%);
    font-weight: var(--hc-fw-body, {{ section.settings.text_font_weight }});
    letter-spacing: var(--hc-ls, 0);
  }

  #shopify-section-{{ section.id }} .cif__text p {
    margin: 0 0 1.2rem;
  }

  #shopify-section-{{ section.id }} .cif__text p:last-child {
    margin-bottom: 0;
  }

  #shopify-section-{{ section.id }} .cif__features {
    display: flex;
    flex-direction: column;
    gap: var(--cif-feature-gap);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  #shopify-section-{{ section.id }} .cif__feature {
    display: grid;
    grid-template-columns: var(--cif-number-size) minmax(0, 1fr);
    gap: {{ section.settings.feature_number_gap }}px;
    align-items: center;
  }

  #shopify-section-{{ section.id }} .cif__feature-number {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: var(--cif-number-size);
    height: var(--cif-number-size);
    border-radius: 50%;
    background-color: var(--cif-number-bg);
    color: var(--cif-number-color);
    font-size: {{ section.settings.number_font_size }}px;
    font-size: var(--hc-body-m, {{ section.settings.number_font_size }}px);
    font-weight: var(--hc-fw-strong, {{ section.settings.number_font_weight }});
    line-height: 1;
    letter-spacing: var(--hc-ls, 0);
    flex-shrink: 0;
  }

  #shopify-section-{{ section.id }} .cif__feature-title {
    margin: 0 0 {{ section.settings.feature_title_spacing }}px;
    color: var(--cif-feature-title-color);
    font-size: {{ section.settings.feature_title_font_size_mobile }}px;
    font-size: var(--hc-h3-m, {{ section.settings.feature_title_font_size_mobile }}px);
    line-height: var(--hc-lh-h3, 1.2);
    font-weight: var(--hc-fw-strong, {{ section.settings.feature_title_font_weight }});
    letter-spacing: var(--hc-ls, 0);
  }

  #shopify-section-{{ section.id }} .cif__feature-text {
    margin: 0;
    color: var(--cif-feature-text-color);
    font-size: {{ section.settings.feature_text_font_size_mobile }}px;
    font-size: var(--hc-body-m, {{ section.settings.feature_text_font_size_mobile }}px);
    line-height: var(--hc-lh-body, {{ section.settings.feature_text_line_height }}%);
    font-weight: var(--hc-fw-body, {{ section.settings.feature_text_font_weight }});
    letter-spacing: var(--hc-ls, 0);
  }

  #shopify-section-{{ section.id }} .cif__feature-text p {
    margin: 0;
  }

  @media screen and (min-width: 750px) {
    #shopify-section-{{ section.id }} .cif__eyebrow {
      font-size: {{ section.settings.eyebrow_font_size }}px;
      font-size: var(--hc-body-d, {{ section.settings.eyebrow_font_size }}px);
    }

    #shopify-section-{{ section.id }} .cif__heading {
      font-size: {{ section.settings.heading_font_size }}px;
      font-size: var(--hc-h1-d, {{ section.settings.heading_font_size }}px);
    }

    #shopify-section-{{ section.id }} .cif__text {
      font-size: {{ section.settings.text_font_size }}px;
      font-size: var(--hc-body-d, {{ section.settings.text_font_size }}px);
    }

    #shopify-section-{{ section.id }} .cif__feature-title {
      font-size: {{ section.settings.feature_title_font_size }}px;
      font-size: var(--hc-h3-d, {{ section.settings.feature_title_font_size }}px);
    }

    #shopify-section-{{ section.id }} .cif__feature-text {
      font-size: {{ section.settings.feature_text_font_size }}px;
      font-size: var(--hc-body-d, {{ section.settings.feature_text_font_size }}px);
    }

    #shopify-section-{{ section.id }} .cif__feature-number {
      font-size: var(--hc-body-d, {{ section.settings.number_font_size }}px);
    }
  }

  @media screen and (max-width: 749px) {
    #shopify-section-{{ section.id }} .cif {
      padding-top: {{ section.settings.mobile_padding_top }}px;
      padding-bottom: {{ section.settings.mobile_padding_bottom }}px;
    }

    #shopify-section-{{ section.id }} .cif__grid {
      display: flex;
      flex-direction: column;
      gap: var(--cif-mobile-gap);
      align-items: stretch;
    }

    #shopify-section-{{ section.id }} .cif__content {
      display: contents;
    }

    #shopify-section-{{ section.id }} .cif__intro {
      order: 1;
      max-width: 100%;
      padding-inline: var(--cif-mobile-padding-x);
      text-align: {{ section.settings.mobile_intro_alignment }};
      box-sizing: border-box;
    }

    #shopify-section-{{ section.id }} .cif__media {
      order: 2;
      padding-inline: var(--cif-mobile-padding-x);
      box-sizing: border-box;
    }

    #shopify-section-{{ section.id }} .cif__features {
      order: 3;
      width: 100%;
      padding-inline: var(--cif-mobile-padding-x);
      box-sizing: border-box;
    }

    #shopify-section-{{ section.id }} .cif__image-wrap {
      aspect-ratio: auto;
      min-height: 0;
    }

    #shopify-section-{{ section.id }} .cif__image-wrap img {
      min-height: 0;
      height: auto;
    }

    #shopify-section-{{ section.id }} .cif__eyebrow {
      margin-bottom: {{ section.settings.mobile_eyebrow_spacing }}px;
    }

    #shopify-section-{{ section.id }} .cif__heading {
      margin-bottom: {{ section.settings.mobile_heading_spacing }}px;
      line-height: 1.15;
    }

    #shopify-section-{{ section.id }} .cif__text {
      margin-bottom: 0;
    }

    #shopify-section-{{ section.id }} .cif__features {
      gap: {{ section.settings.mobile_feature_gap }}px;
      margin-top: {{ section.settings.mobile_features_spacing_top }}px;
    }

    #shopify-section-{{ section.id }} .cif--flip .cif__media,
    #shopify-section-{{ section.id }} .cif--flip .cif__content {
      order: unset;
    }
  }
{%- endstyle -%}

<div class="cif{% if layout_flip %} cif--flip{% endif %}">
  <div class="{% if section.settings.use_theme_page_width %}page-width{% else %}cif__page-width{% endif %}">
    <div class="cif__grid">
      <div class="cif__media">
        {%- if section.settings.image != blank -%}
          <div class="cif__image-wrap">
            {{
              section.settings.image
              | image_url: width: 1600
              | image_tag:
                loading: 'lazy',
                widths: '400, 600, 800, 1000, 1200, 1400, 1600',
                sizes: '(min-width: 990px) 50vw, 100vw',
                alt: section.settings.image.alt | default: section.settings.heading | escape
            }}
          </div>
        {%- else -%}
          <div class="cif__image-wrap">
            {{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}
          </div>
        {%- endif -%}
      </div>

      <div class="cif__content">
        <div class="cif__intro">
          {%- if section.settings.eyebrow != blank -%}
            <p class="cif__eyebrow">{{ section.settings.eyebrow | escape }}</p>
          {%- endif -%}

          {%- if section.settings.heading != blank -%}
            <{{ section.settings.heading_tag }} class="cif__heading">
              {{ section.settings.heading | escape }}
            </{{ section.settings.heading_tag }}>
          {%- endif -%}

          {%- if section.settings.text != blank -%}
            <div class="cif__text rte">{{ section.settings.text }}</div>
          {%- endif -%}
        </div>

        {%- if feature_blocks.size > 0 -%}
          <ul class="cif__features" role="list">
              {%- for block in feature_blocks -%}
                {%- liquid
                  assign feature_number = forloop.index
                  if block.settings.number != blank
                    assign feature_number = block.settings.number
                  endif
                -%}
                <li class="cif__feature" {{ block.shopify_attributes }}>
                  <span class="cif__feature-number" aria-hidden="true">{{ feature_number }}</span>
                  <div class="cif__feature-body">
                    {%- if block.settings.title != blank -%}
                      <h3 class="cif__feature-title">{{ block.settings.title | escape }}</h3>
                    {%- endif -%}
                    {%- if block.settings.text != blank -%}
                      <div class="cif__feature-text rte">{{ block.settings.text }}</div>
                    {%- endif -%}
                  </div>
                </li>
              {%- endfor -%}
            </ul>
        {%- endif -%}
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Custom image + features",
  "tag": "section",
  "class": "section custom-image-features-section",
  "disabled_on": {
    "groups": ["header", "footer", "custom.overlay"]
  },
  "settings": [
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "checkbox",
      "id": "flip_layout",
      "label": "Flip layout (content left, image right)",
      "default": false
    },
    {
      "type": "range",
      "id": "content_column_width",
      "min": 35,
      "max": 65,
      "step": 1,
      "unit": "%",
      "label": "Content column width",
      "default": 50
    },
    {
      "type": "range",
      "id": "column_gap",
      "min": 16,
      "max": 80,
      "step": 4,
      "unit": "px",
      "label": "Column gap",
      "default": 40
    },
    {
      "type": "select",
      "id": "vertical_alignment",
      "label": "Vertical alignment",
      "default": "center",
      "options": [
        { "value": "start", "label": "Top" },
        { "value": "center", "label": "Center" },
        { "value": "end", "label": "Bottom" }
      ]
    },
    {
      "type": "checkbox",
      "id": "use_theme_page_width",
      "label": "Use theme page width",
      "default": true
    },
    {
      "type": "range",
      "id": "section_max_width",
      "min": 1000,
      "max": 1600,
      "step": 20,
      "unit": "px",
      "label": "Custom max width",
      "default": 1400
    },
    {
      "type": "header",
      "content": "Mobile layout"
    },
    {
      "type": "paragraph",
      "content": "Mobile order: intro text → image → features list."
    },
    {
      "type": "select",
      "id": "mobile_intro_alignment",
      "label": "Mobile intro alignment",
      "default": "center",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ]
    },
    {
      "type": "range",
      "id": "mobile_padding_x",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "label": "Mobile side padding",
      "default": 20
    },
    {
      "type": "range",
      "id": "mobile_block_gap",
      "min": 16,
      "max": 56,
      "step": 4,
      "unit": "px",
      "label": "Mobile gap between blocks",
      "default": 32
    },
    {
      "type": "range",
      "id": "mobile_eyebrow_spacing",
      "min": 4,
      "max": 24,
      "step": 2,
      "unit": "px",
      "label": "Mobile eyebrow spacing",
      "default": 10
    },
    {
      "type": "range",
      "id": "mobile_heading_spacing",
      "min": 8,
      "max": 32,
      "step": 2,
      "unit": "px",
      "label": "Mobile heading spacing",
      "default": 16
    },
    {
      "type": "range",
      "id": "mobile_features_spacing_top",
      "min": 0,
      "max": 40,
      "step": 4,
      "unit": "px",
      "label": "Mobile features top spacing",
      "default": 8
    },
    {
      "type": "range",
      "id": "mobile_feature_gap",
      "min": 16,
      "max": 48,
      "step": 2,
      "unit": "px",
      "label": "Mobile feature list gap",
      "default": 28
    },
    {
      "type": "range",
      "id": "mobile_padding_top",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "label": "Mobile padding top",
      "default": 32
    },
    {
      "type": "range",
      "id": "mobile_padding_bottom",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "label": "Mobile padding bottom",
      "default": 40
    },
    {
      "type": "header",
      "content": "Image"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "select",
      "id": "image_fit",
      "label": "Image fit",
      "default": "cover",
      "options": [
        { "value": "cover", "label": "Cover" },
        { "value": "contain", "label": "Contain" }
      ]
    },
    {
      "type": "select",
      "id": "image_position",
      "label": "Image position",
      "default": "center center",
      "options": [
        { "value": "center center", "label": "Center" },
        { "value": "top center", "label": "Top" },
        { "value": "bottom center", "label": "Bottom" }
      ]
    },
    {
      "type": "select",
      "id": "image_ratio",
      "label": "Image aspect ratio",
      "default": "3 / 4",
      "options": [
        { "value": "auto", "label": "Auto" },
        { "value": "1 / 1", "label": "Square" },
        { "value": "3 / 4", "label": "Portrait 3:4" },
        { "value": "4 / 5", "label": "Portrait 4:5" },
        { "value": "16 / 9", "label": "Landscape 16:9" }
      ]
    },
    {
      "type": "range",
      "id": "image_min_height",
      "min": 280,
      "max": 900,
      "step": 20,
      "unit": "px",
      "label": "Image min height (auto ratio)",
      "default": 560
    },
    {
      "type": "color",
      "id": "image_background",
      "label": "Image background",
      "default": "#f3f3f3"
    },
    {
      "type": "range",
      "id": "image_border_radius",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "label": "Image border radius",
      "default": 16
    },
    {
      "type": "range",
      "id": "image_border_width",
      "min": 0,
      "max": 4,
      "step": 1,
      "unit": "px",
      "label": "Image border width",
      "default": 0
    },
    {
      "type": "color",
      "id": "image_border_color",
      "label": "Image border color",
      "default": "#212326"
    },
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow text",
      "default": "Mastectomy Reconstruction • Lumpectomy • Explant"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Gently Restore Symmetry & Fullness After Surgery"
    },
    {
      "type": "select",
      "id": "heading_tag",
      "label": "Heading tag",
      "default": "h2",
      "options": [
        { "value": "h1", "label": "H1" },
        { "value": "h2", "label": "H2" },
        { "value": "h3", "label": "H3" }
      ]
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Intro text",
      "default": "<p>After everything you went through, you deserve to feel whole again. Wear what you want without second-guessing yourself, move freely without worry, and reclaim your confidence.</p>"
    },
    {
      "type": "select",
      "id": "content_alignment",
      "label": "Content alignment",
      "default": "left",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ]
    },
    {
      "type": "range",
      "id": "content_max_width",
      "min": 400,
      "max": 800,
      "step": 20,
      "unit": "px",
      "label": "Content max width",
      "default": 620
    },
    {
      "type": "range",
      "id": "content_padding",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "label": "Content padding",
      "default": 24
    },
    {
      "type": "header",
      "content": "Typography"
    },
    {
      "type": "paragraph",
      "content": "On everyday and post-op-new templates, font sizes and weights follow the same theme typography scale as other sections (heading 500, body 400, feature titles 700)."
    },
    {
      "type": "range",
      "id": "eyebrow_font_size",
      "min": 12,
      "max": 24,
      "step": 1,
      "unit": "px",
      "label": "Eyebrow font size",
      "default": 16
    },
    {
      "type": "range",
      "id": "eyebrow_font_size_mobile",
      "min": 12,
      "max": 20,
      "step": 1,
      "unit": "px",
      "label": "Eyebrow font size (mobile)",
      "default": 14
    },
    {
      "type": "select",
      "id": "eyebrow_font_weight",
      "label": "Eyebrow font weight",
      "default": "400",
      "options": [
        { "value": "400", "label": "Regular" },
        { "value": "500", "label": "Medium" },
