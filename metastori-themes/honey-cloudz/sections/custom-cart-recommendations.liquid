{%- comment -%}
  Rendered via Product Recommendations API only.
  Fetch: /recommendations/products?section_id=custom-cart-recommendations&product_id=...&intent=complementary
{%- endcomment -%}

<custom-cart-recommendations>
  {%- if recommendations.performed and recommendations.products_count > 0 -%}
    <div class="custom-cart__cross-sell-cards">
      {%- for recommendation in recommendations.products -%}
        {% render 'custom-cart-cross-sell-if-eligible', product: recommendation %}
      {%- endfor -%}
    </div>
  {%- endif -%}
</custom-cart-recommendations>

{% schema %}
{
  "name": "Cart recommendations",
  "settings": []
}
{% endschema %}
