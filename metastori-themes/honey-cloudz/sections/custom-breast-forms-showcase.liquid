{%- liquid
  assign product_blocks = section.blocks | where: 'type', 'product'
-%}

{%- style -%}
  #shopify-section-{{ section.id }} .cbfs {
    --cbfs-bg: {{ section.settings.background_color }};
    --cbfs-heading-color: {{ section.settings.heading_color }};
    --cbfs-accent-color: {{ section.settings.accent_heading_color }};
    --cbfs-text-color: {{ section.settings.text_color }};
    --cbfs-card-bg: {{ section.settings.card_background }};
    --cbfs-card-border: {{ section.settings.card_border_color }};
    --cbfs-card-radius: {{ section.settings.card_border_radius }}px;
    --cbfs-media-bg: {{ section.settings.media_background }};
    --cbfs-tag-bg: {{ section.settings.tag_background }};
    --cbfs-tag-text: {{ section.settings.tag_text_color }};
    --cbfs-shaping-bg: {{ section.settings.shaping_bar_background }};
    --cbfs-shaping-text: {{ section.settings.shaping_bar_text_color }};
    --cbfs-label-color: {{ section.settings.meta_label_color }};
    --cbfs-body-text: {{ section.settings.meta_text_color }};
    --cbfs-title-color: {{ section.settings.card_title_color }};
    --cbfs-btn-bg: {{ section.settings.button_background }};
    --cbfs-btn-text: {{ section.settings.button_text_color }};
    --cbfs-testimonial-bg: {{ section.settings.testimonial_background }};
    --cbfs-testimonial-text: {{ section.settings.testimonial_text_color }};
    --cbfs-content-max: {{ section.settings.content_max_width }}px;
    --cbfs-card-gap: {{ section.settings.card_gap }}px;
    --cbfs-card-max-desktop: {{ section.settings.card_max_width_desktop }}px;
    --cbfs-image-fit: {{ section.settings.image_fit }};
    background-color: var(--cbfs-bg);
    padding: {{ section.settings.padding_top }}px 0 {{ section.settings.padding_bottom }}px;
    overflow-x: clip;
  }

  {% unless section.settings.use_theme_page_width %}
  #shopify-section-{{ section.id }} .cbfs__page-width {
    max-width: var(--cbfs-content-max);
    margin: 0 auto;
    padding-inline: 1.5rem;
    width: 100%;
    box-sizing: border-box;
  }
  {% endunless %}

  @media screen and (max-width: 749px) {
    #shopify-section-{{ section.id }} .cbfs .page-width,
    #shopify-section-{{ section.id }} .cbfs__page-width {
      padding-inline: {{ section.settings.mobile_padding_x }}px;
    }
  }

  #shopify-section-{{ section.id }} .cbfs__intro {
    max-width: min(920px, 100%);
    margin: 0 auto {{ section.settings.intro_spacing }}px;
    text-align: center;
  }

  #shopify-section-{{ section.id }} .cbfs__heading-top {
    margin: 0;
    color: var(--cbfs-heading-color);
    font-size: var(--hc-h2-m, 2.1rem);
    font-weight: var(--hc-fw-heading, 500);
    line-height: var(--hc-lh-h2, 1.15);
    letter-spacing: var(--hc-ls, 0);
    margin-bottom: 10px;
  }

  #shopify-section-{{ section.id }} .cbfs__heading-accent {
    margin: 0 0 1.6rem;
    color: var(--cbfs-accent-color);
    font-size: var(--hc-h1-m, 2.94rem);
    font-weight: var(--hc-fw-heading, 500);
    line-height: var(--hc-lh-h1, 1.05);
    letter-spacing: var(--hc-ls, 0);
  }

  #shopify-section-{{ section.id }} .cbfs__intro-text {
    margin: 0;
    color: var(--cbfs-text-color);
    font-size: var(--hc-body-m, 1.5rem);
    font-weight: var(--hc-fw-body, 400);
    line-height: var(--hc-lh-body, 1.55);
    letter-spacing: var(--hc-ls, 0);
  }

  #shopify-section-{{ section.id }} .cbfs__intro-text p {
    margin: 0 0 1.2rem;
  }

  #shopify-section-{{ section.id }} .cbfs__intro-text p:last-child {
    margin-bottom: 0;
  }

  #shopify-section-{{ section.id }} .cbfs__cards {
    display: flex;
    flex-direction: column;
    gap: var(--cbfs-card-gap);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  #shopify-section-{{ section.id }} .cbfs__card {
    background: var(--cbfs-card-bg);
    border: 1px solid var(--cbfs-card-border);
    border-radius: var(--cbfs-card-radius);
    overflow: hidden;
  }

  #shopify-section-{{ section.id }} .cbfs__card-main {
    display: flex;
    flex-direction: column;
  }

  #shopify-section-{{ section.id }} .cbfs__card-media-col {
    display: flex;
    flex-direction: column;
    min-width: 0;
  }

  #shopify-section-{{ section.id }} .cbfs__media-link {
    display: block;
    text-decoration: none;
    line-height: 0;
  }

  #shopify-section-{{ section.id }} .cbfs__media {
    position: relative;
    min-height: auto;
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--cbfs-media-bg);
    padding: 0;
  }

  #shopify-section-{{ section.id }} .cbfs__image {
    display: block;
    width: 100%;
    max-width: 320px;
    height: auto;
    max-height: 240px;
    margin: 0 auto;
    object-fit: var(--cbfs-image-fit);
  }

  #shopify-section-{{ section.id }} .cbfs__image--placeholder {
    opacity: 0.35;
    max-width: 180px;
  }

  #shopify-section-{{ section.id }} .cbfs__shape-icon {
    position: absolute;
    left: 12px;
    bottom: 12px;
    z-index: 2;
    width: 28px;
    line-height: 0;
    pointer-events: none;
  }

  #shopify-section-{{ section.id }} .cbfs__shape-icon svg {
    display: block;
    width: 100%;
    height: auto;
  }

  #shopify-section-{{ section.id }} .cbfs__tags {
    position: absolute;
    top: 12px;
    right: 12px;
    z-index: 3;
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 0.4rem;
    pointer-events: none;
  }

  #shopify-section-{{ section.id }} .cbfs__tag {
    display: inline-block;
    padding: 0.45rem 0.9rem;
    border-radius: 999px;
    background: var(--cbfs-tag-bg);
    color: var(--cbfs-tag-text);
    font-size: var(--hc-small, 1.3rem);
    font-weight: var(--hc-fw-btn, 600);
    line-height: 1.15;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  #shopify-section-{{ section.id }} .cbfs__shaping-bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    width: 100%;
    margin: 0;
    padding: 0.65rem 1.2rem;
    border: 0;
    appearance: none;
    -webkit-appearance: none;
    font: inherit;
    letter-spacing: inherit;
    text-align: inherit;
    background: var(--cbfs-shaping-bg);
    color: var(--cbfs-shaping-text);
    cursor: pointer;
  }

  #shopify-section-{{ section.id }} .cbfs__shaping-bar:focus-visible {
    outline: 2px solid currentColor;
    outline-offset: 2px;
  }

  #shopify-section-{{ section.id }} .cbfs__shaping-label {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    font-size: var(--hc-small, 1.3rem);
    font-weight: var(--hc-fw-btn, 600);
    line-height: 1.2;
    letter-spacing: var(--hc-ls, 0);
    white-space: nowrap;
  }

  #shopify-section-{{ section.id }} .cbfs__shaping-info {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    margin: 0;
    padding: 0;
    border: 0;
    background: transparent;
    color: inherit;
    line-height: 0;
    flex-shrink: 0;
    pointer-events: none;
  }

  #shopify-section-{{ section.id }} .cbfs__shaping-squares {
    display: flex;
    align-items: center;
    gap: 5px;
    flex-shrink: 0;
  }

  #shopify-section-{{ section.id }} .cbfs__shaping-square {
    width: 12px;
    height: 20px;
    border-radius: 3px;
    border: 1px solid currentColor;
    background: transparent;
  }

  #shopify-section-{{ section.id }} .cbfs__shaping-square.is-active {
    background: currentColor;
  }

  #shopify-section-{{ section.id }} .cbfs__card-content {
    display: flex;
    flex-direction: column;
    gap: 1.2rem;
    padding: 1.6rem 1.4rem 1.8rem;
    min-width: 0;
  }

  #shopify-section-{{ section.id }} .cbfs__card-title {
    margin: 0;
    color: var(--cbfs-title-color);
    font-size: var(--hc-h3-m, 1.8rem);
    font-weight: var(--hc-fw-strong, 700);
    line-height: var(--hc-lh-h3, 1.2);
    letter-spacing: var(--hc-ls, 0);
  }

  #shopify-section-{{ section.id }} .cbfs__card-title a {
    color: inherit;
    text-decoration: none;
  }

  #shopify-section-{{ section.id }} .cbfs__meta-block {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }

  #shopify-section-{{ section.id }} .cbfs__meta-label {
    margin: 0;
    color: var(--cbfs-label-color);
    font-size: var(--hc-small, 1.3rem);
    font-weight: var(--hc-fw-strong, 700);
    line-height: 1.3;
    letter-spacing: var(--hc-ls, 0);
  }

  #shopify-section-{{ section.id }} .cbfs__meta-text {
    margin: 0;
    color: var(--cbfs-body-text);
    font-size: var(--hc-body-m, 1.5rem);
    font-weight: var(--hc-fw-body, 400);
    line-height: var(--hc-lh-body, 1.55);
    letter-spacing: var(--hc-ls, 0);
  }

  #shopify-section-{{ section.id }} .cbfs__meta-text p {
    margin: 0;
  }

  #shopify-section-{{ section.id }} .cbfs__button.button {
    width: 100%;
    margin-top: 0.4rem;
    text-align: center;
    text-transform: capitalize;
      font-weight:500;
      border-radius:40px;
      letter-spacing: normal;
  }

  #shopify-section-{{ section.id }} .cbfs__testimonial {
    margin: 0;
    padding: 1.4rem 1.4rem 1.6rem;
    background: var(--cbfs-testimonial-bg);
    color: var(--cbfs-testimonial-text);
    text-align: center;
  }

  #shopify-section-{{ section.id }} .cbfs__quote {
    margin: 0 0 0.8rem;
    font-size: var(--hc-body-m, 1.5rem);
    font-weight: var(--hc-fw-body, 400);
    font-style: italic;
    line-height: var(--hc-lh-body, 1.55);
    letter-spacing: var(--hc-ls, 0);
  }

  #shopify-section-{{ section.id }} .cbfs__author {
    margin: 0;
    font-size: var(--hc-body-m, 1.5rem);
    font-weight: var(--hc-fw-strong, 700);
    line-height: 1.3;
    letter-spacing: var(--hc-ls, 0);
  }

  @media screen and (min-width: 750px) {
    #shopify-section-{{ section.id }} .cbfs__cards > li {
      width: 100%;
      max-width: var(--cbfs-card-max-desktop);
      margin-inline: auto;
    }

    #shopify-section-{{ section.id }} .cbfs__heading-top {
      font-size: var(--hc-h2-d, 2.94rem);
    }

    #shopify-section-{{ section.id }} .cbfs__heading-accent {
      font-size: var(--hc-h1-d, 4.2rem);
    }

    #shopify-section-{{ section.id }} .cbfs__intro-text,
    #shopify-section-{{ section.id }} .cbfs__meta-text,
    #shopify-section-{{ section.id }} .cbfs__quote,
    #shopify-section-{{ section.id }} .cbfs__author {
      font-size: var(--hc-body-d, 1.6rem);
    }

    #shopify-section-{{ section.id }} .cbfs__card-title {
      font-size: var(--hc-h3-d, 2.1rem);
    }

    #shopify-section-{{ section.id }} .cbfs__card-main {
      display: grid;
      grid-template-columns: minmax(0, 42%) minmax(0, 58%);
      align-items: stretch;
    }

    #shopify-section-{{ section.id }} .cbfs__card-media-col {
      display: flex;
      flex-direction: column;
      min-height: 100%;
    }

    #shopify-section-{{ section.id }} .cbfs__media-link {
      flex: 1 1 auto;
      display: flex;
      flex-direction: column;
      min-height: 0;
    }

    #shopify-section-{{ section.id }} .cbfs__media {
      flex: 1 1 auto;
      display: flex;
      align-items: center;
      justify-content: center;
      min-height: 0;
      padding: 0;
    }

    #shopify-section-{{ section.id }} .cbfs__shaping-bar {
      flex-shrink: 0;
      margin-top: auto;
    }

    #shopify-section-{{ section.id }} .cbfs__image {
      max-width: 100%;
      max-height: 280px;
      width: 100%;
      height: auto;
    }

    #shopify-section-{{ section.id }} .cbfs__card-content {
      justify-content: center;
      padding: 2rem 2.2rem;
      gap: 1.4rem;
    }

    #shopify-section-{{ section.id }} .cbfs__button.button {
      width: auto;
      align-self: flex-start;
      min-width: auto;
      text-transform: capitalize;
      font-weight:500;
      border-radius:40px;
      letter-spacing: normal;
    }

    #shopify-section-{{ section.id }} .cbfs__testimonial {
      padding: 1.6rem 2rem 1.8rem;
    }
  }

  @media screen and (min-width: 990px) {
    #shopify-section-{{ section.id }} .cbfs__card-main {
      grid-template-columns: minmax(0, 40%) minmax(0, 60%);
    }

    #shopify-section-{{ section.id }} .cbfs__card-content {
      padding: 2.4rem 2.8rem;
    }
  }

  #cbfs-shaping-popup-{{ section.id }} {
    position: fixed;
    inset: 0;
    z-index: 10001;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 1.5rem;
    background: rgba(33, 35, 38, 0.55);
    cursor: url({{ 'cross.svg' | asset_url }}), zoom-out;
  }

  #cbfs-shaping-popup-{{ section.id }}[hidden] {
    display: none !important;
  }

  #cbfs-shaping-popup-{{ section.id }} .fyc-shaping-popup__backdrop {
    position: absolute;
    inset: 0;
    z-index: 0;
    cursor: url({{ 'cross.svg' | asset_url }}), zoom-out;
  }

  #cbfs-shaping-popup-{{ section.id }} .fyc-shaping-popup__dialog {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    width: min(100%, 82rem);
    max-height: min(85vh, 520px);
    overflow: hidden;
    margin: 0;
    padding: 0;
    background: {{ section.settings.shaping_popup_background }};
    color: {{ section.settings.shaping_popup_text_color }};
    border-radius: {{ section.settings.shaping_popup_border_radius }}px;
    box-shadow: 0 18px 48px rgba(33, 35, 38, 0.18);
    cursor: auto;
  }

  #cbfs-shaping-popup-{{ section.id }} .fyc-shaping-popup__header {
    position: relative;
    flex-shrink: 0;
    padding: 2.4rem 4.5rem 1.2rem 2rem;
  }

  #cbfs-shaping-popup-{{ section.id }} .fyc-shaping-popup__body {
    flex: 1 1 auto;
    min-height: 0;
    overflow-y: auto;
    padding: 0 2rem 2rem;
  }

  #cbfs-shaping-popup-{{ section.id }} .fyc-shaping-popup__title {
    margin: 0;
    font-size: 28px;
    font-weight: 700;
    line-height: 1.2;
  }

  #cbfs-shaping-popup-{{ section.id }} .fyc-shaping-popup__content {
    font-size: 15px;
    line-height: 1.55;
  }

  #cbfs-shaping-popup-{{ section.id }} .fyc-shaping-popup__close {
    position: absolute;
    top: 1rem;
    right: 1rem;
    z-index: 2;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.4rem;
    height: 2.4rem;
    margin: 0;
    padding: 0;
    border: 0;
    background: {{ section.settings.shaping_popup_background }};
    color: inherit;
    font-size: 2.4rem;
    line-height: 1;
    cursor: pointer;
  }
{%- endstyle -%}

<div class="cbfs">
  <div class="{% if section.settings.use_theme_page_width %}page-width{% else %}cbfs__page-width{% endif %}">
    {%- if section.settings.heading_line_1 != blank or section.settings.heading_line_2 != blank or section.settings.intro_text != blank -%}
      <header class="cbfs__intro">
        {%- if section.settings.heading_line_1 != blank -%}
          <p class="cbfs__heading-top">{{ section.settings.heading_line_1 | escape }}</p>
        {%- endif -%}
        {%- if section.settings.heading_line_2 != blank -%}
          <h2 class="cbfs__heading-accent">{{ section.settings.heading_line_2 | escape }}</h2>
        {%- endif -%}
        {%- if section.settings.intro_text != blank -%}
          <div class="cbfs__intro-text rte">{{ section.settings.intro_text }}</div>
        {%- endif -%}
      </header>
    {%- endif -%}

    {%- if product_blocks.size > 0 -%}
      <ul class="cbfs__cards" role="list">
        {%- for block in product_blocks -%}
          {%- assign block_product = block.settings.product -%}
          {%- if block_product != blank -%}
            {%- liquid
              assign card_product = block_product
              if block_product.handle != blank
                assign card_product = all_products[block_product.handle] | default: block_product
              endif
            -%}
            <li {{ block.shopify_attributes }}>
              {%- liquid
                assign mf_ns = section.settings.metafield_namespace | default: 'custom'
                assign shaping_level_key = section.settings.shaping_level_key
                assign shape_key = section.settings.shape_key
                assign product_tags_key = section.settings.product_tags_key
                assign why_love_key = section.settings.why_love_key | default: 'why_youll_love_them' | strip
                assign wear_with_key = section.settings.wear_with_key | default: 'wear_it_with' | strip
                assign testimonial_quote_key = section.settings.testimonial_quote_key
                assign testimonial_author_key = section.settings.testimonial_author_key

                assign shaping_level_num = card_product.metafields[mf_ns][shaping_level_key].value | plus: 0
                assign shape_raw = card_product.metafields[mf_ns][shape_key].value | default: '' | strip
                assign shape_key_handle = shape_raw | handleize
                assign card_shape_icon = ''
                case shape_key_handle
                  when 'triangle'
                    assign card_shape_icon = 'shape-triangle'
                  when 'half-moon', 'half_moon', 'halfmoon'
                    assign card_shape_icon = 'shape-half-moon'
                  when 'teardrop'
                    assign card_shape_icon = 'shape-teardrop'
                  when 'oval', 'ellipse', 'circle'
                    assign card_shape_icon = 'shape-oval'
                endcase

                assign why_love_mf = card_product.metafields[mf_ns][why_love_key]
                if why_love_mf == blank or why_love_mf.value == blank
                  assign why_love_mf = card_product.metafields.custom.why_youll_love_them
                endif

                assign wear_with_mf = card_product.metafields[mf_ns][wear_with_key]
                if wear_with_mf == blank or wear_with_mf.value == blank
                  assign wear_with_mf = card_product.metafields.custom.wear_it_with
                endif

                assign testimonial_quote = card_product.metafields[mf_ns][testimonial_quote_key].value | strip
                assign testimonial_author = card_product.metafields[mf_ns][testimonial_author_key].value | strip

                assign shaping_display = shaping_level_num
                if shaping_display > 5
                  assign shaping_display = 5
                endif

                assign button_product_name = card_product.title | replace: ' Bra Inserts', '' | replace: ' Bra Insert', '' | replace: ' (Single)', '' | strip

                assign card_image_alt = card_product.featured_media.alt | default: card_product.title | escape
              -%}

              <article class="cbfs__card" data-product-handle="{{ card_product.handle }}">
                <div class="cbfs__card-main">
                  <div class="cbfs__card-media-col">
                    <a href="{{ card_product.url }}" class="cbfs__media-link" tabindex="-1" aria-hidden="true">
                      <div class="cbfs__media">
                        {%- if card_shape_icon != blank -%}
                          <span class="cbfs__shape-icon" aria-hidden="true">
                            {% render 'icon', icon: card_shape_icon %}
                          </span>
                        {%- endif -%}

                        {%- if section.settings.show_product_tags and card_product.metafields[mf_ns][product_tags_key].value != blank -%}
                          <div class="cbfs__tags" role="group" aria-label="{{ 'products.product.product_tags_label' | t }}">
                            {%- for tag in card_product.metafields[mf_ns][product_tags_key].value limit: 2 -%}
                              {%- assign tag_clean = tag | strip -%}
                              {%- if tag_clean != blank -%}
                                <span class="cbfs__tag">{{ tag_clean | escape }}</span>
                              {%- endif -%}
                            {%- endfor -%}
                          </div>
                        {%- endif -%}

                        {%- if card_product.featured_media -%}
                          {{
                            card_product.featured_media
                            | image_url: width: 900
                            | image_tag:
                              loading: 'lazy',
                              class: 'cbfs__image',
                              widths: '200,360,535,720,900',
                              sizes: '(min-width: 990px) 360px, (min-width: 750px) 42vw, 90vw',
                              alt: card_image_alt
                          }}
                        {%- else -%}
                          {{ 'product-1' | placeholder_svg_tag: 'cbfs__image cbfs__image--placeholder' }}
                        {%- endif -%}
                      </div>
                    </a>

                    {%- if shaping_level_num >= 1 and shaping_level_num <= 5 -%}
                      <button
                        type="button"
                        class="cbfs__shaping-bar"
                        data-cbfs-shaping-info
                        aria-haspopup="dialog"
                        aria-label="{{ 'products.product.shaping_level_aria' | t: level: shaping_level_num }}"
                      >
                        <span class="cbfs__shaping-label">
                          <span class="cbfs__shaping-info" aria-hidden="true">
                            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 28 28" fill="none" aria-hidden="true">
                              <path d="M14 0C11.2311 0 8.52431 0.821086 6.22202 2.35943C3.91973 3.89777 2.12532 6.08427 1.06569 8.64243C0.00606596 11.2006 -0.271181 14.0155 0.269012 16.7313C0.809205 19.447 2.14258 21.9416 4.10051 23.8995C6.05845 25.8574 8.55301 27.1908 11.2687 27.731C13.9845 28.2712 16.7994 27.9939 19.3576 26.9343C21.9157 25.8747 24.1022 24.0803 25.6406 21.778C27.1789 19.4757 28 16.7689 28 14C28 10.287 26.525 6.72601 23.8995 4.1005C21.274 1.475 17.713 0 14 0ZM14 6C14.2967 6 14.5867 6.08797 14.8334 6.2528C15.08 6.41762 15.2723 6.65189 15.3858 6.92597C15.4994 7.20006 15.5291 7.50166 15.4712 7.79264C15.4133 8.08361 15.2704 8.35088 15.0607 8.56066C14.8509 8.77044 14.5836 8.9133 14.2926 8.97118C14.0017 9.02906 13.7001 8.99935 13.426 8.88582C13.1519 8.77229 12.9176 8.58003 12.7528 8.33335C12.588 8.08668 12.5 7.79667 12.5 7.5C12.5 7.10218 12.658 6.72064 12.9393 6.43934C13.2207 6.15804 13.6022 6 14 6ZM18 22.125H10V19.875H12.875V14.125H11V11.875H15.125V19.875H18V22.125Z" fill="currentColor"/>
                            </svg>
                          </span>
                          {{ section.settings.shaping_level_label | escape }}
                        </span>
                        <span class="cbfs__shaping-squares" aria-hidden="true">
                          {%- for i in (1..5) -%}
                            <span class="cbfs__shaping-square{% if i <= shaping_display %} is-active{% endif %}"></span>
                          {%- endfor -%}
                        </span>
                      </button>
                    {%- endif -%}
                  </div>

                  <div class="cbfs__card-content">
                    <h3 class="cbfs__card-title">
                      <a href="{{ card_product.url }}">{{ card_product.title | escape }}</a>
                    </h3>

                    {%- if why_love_mf != blank and why_love_mf.value != blank -%}
                      <div class="cbfs__meta-block">
                        <p class="cbfs__meta-label">{{ section.settings.why_love_label | escape }}</p>
                        <div class="cbfs__meta-text rte">{{ why_love_mf | metafield_tag }}</div>
                      </div>
                    {%- endif -%}

                    {%- if wear_with_mf != blank and wear_with_mf.value != blank -%}
                      <div class="cbfs__meta-block">
                        <p class="cbfs__meta-label">{{ section.settings.wear_with_label | escape }}</p>
                        <div class="cbfs__meta-text rte">{{ wear_with_mf | metafield_tag }}</div>
                      </div>
                    {%- endif -%}

                    <a href="{{ card_product.url }}" class="button button--medium cbfs__button">
                      {{ section.settings.button_prefix | escape }} 
                      {% comment %} {{ button_product_name | escape }} {% endcomment %}
                    </a>
                  </div>
                </div>

                {%- if testimonial_quote != blank -%}
                  <footer class="cbfs__testimonial">
                    <p class="cbfs__quote">&ldquo;{{ testimonial_quote | escape }}&rdquo;</p>
                    {%- if testimonial_author != blank -%}
                      <p class="cbfs__author">-{{ testimonial_author | escape }}</p>
                    {%- endif -%}
                  </footer>
                {%- endif -%}
              </article>
            </li>
          {%- endif -%}
        {%- endfor -%}
      </ul>
    {%- endif -%}
  </div>
</div>

{%- if section.settings.shaping_popup_title != blank or section.settings.shaping_popup_content != blank -%}
  <div
    id="cbfs-shaping-popup-{{ section.id }}"
    class="fyc-shaping-popup"
    data-cbfs-shaping-popup
    hidden
    aria-hidden="true"
  >
    <div class="fyc-shaping-popup__backdrop" data-cbfs-shaping-popup-close></div>
    <div
      class="fyc-shaping-popup__dialog"
      role="dialog"
      aria-modal="true"
      aria-labelledby="cbfs-shaping-popup-title-{{ section.id }}"
    >
      <div class="fyc-shaping-popup__header">
        {%- if section.settings.shaping_popup_title != blank -%}
          <h3 class="fyc-shaping-popup__title" id="cbfs-shaping-popup-title-{{ section.id }}">
            {{ section.settings.shaping_popup_title | escape }}
          </h3>
        {%- endif -%}
        <button
          type="button"
          class="fyc-shaping-popup__close"
          data-cbfs-shaping-popup-close
          aria-label="{{ section.settings.shaping_popup_close_label | escape }}"
        >
          &times;
        </button>
      </div>
      {%- if section.settings.shaping_popup_content != blank -%}
        <div class="fyc-shaping-popup__body">
          <div class="fyc-shaping-popup__content rte">
            {{ section.settings.shaping_popup_content }}
          </div>
        </div>
      {%- endif -%}
    </div>
  </div>

  <script>
    (function () {
      var sectionEl = document.getElementById('shopify-section-{{ section.id }}');
      if (!sectionEl || sectionEl.dataset.cbfsPopupBound === '1') return;
      sectionEl.dataset.cbfsPopupBound = '1';

      var popup = document.getElementById('cbfs-shaping-popup-{{ section.id }}');
      var triggers = sectionEl.querySelectorAll('[data-cbfs-shaping-info]');
      if (!popup || !triggers.length) return;

      if (popup.parentElement !== document.body) {
        document.body.appendChild(popup);
      }

      var closeEls = popup.querySelectorAll('[data-cbfs-shaping-popup-close]');
      var lastFocus = null;

      function openPopup() {
        lastFocus = document.activeElement;
        popup.hidden = false;
        popup.setAttribute('aria-hidden', 'false');
        document.body.style.overflow = 'hidden';
        var closeBtn = popup.querySelector('.fyc-shaping-popup__close');
        if (closeBtn) closeBtn.focus();
      }

      function closePopup() {
        popup.hidden = true;
        popup.setAttribute('aria-hidden', 'true');
        document.body.style.overflow = '';
        if (lastFocus && typeof lastFocus.focus === 'function') {
          lastFocus.focus();
        }
      }

      triggers.forEach(function (btn) {
        btn.addEventListener('click', function (event) {
          event.preventDefault();
          event.stopPropagation();
          openPopup();
        });
      });

      closeEls.forEach(function (el) {
        el.addEventListener('click', closePopup);
      });

      popup.addEventListener('click', function (event) {
        var dialog = popup.querySelector('.fyc-shaping-popup__dialog');
        if (dialog && !dialog.contains(event.target)) {
          closePopup();
        }
      });

      document.addEventListener('keydown', function (event) {
        if (event.key === 'Escape' && !popup.hidden) {
          closePopup();
        }
      });
    })();
  </script>
{%- endif -%}

