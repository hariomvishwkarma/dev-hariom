{%- liquid
  assign image_position = section.settings.image_position
  if image_position == blank
    assign image_position = 'left'
  endif

  assign text_align = section.settings.text_alignment
  if text_align == blank
    assign text_align = 'left'
  endif

  assign image_width = section.settings.image_width
  if image_width == blank
    assign image_width = 45
  endif
  assign text_width = 100 | minus: image_width

  assign image_fit = section.settings.image_fit
  if image_fit == blank
    assign image_fit = 'cover'
  endif

  case text_align
    when 'center'
      assign buttons_justify = 'center'
    when 'right'
      assign buttons_justify = 'flex-end'
    else
      assign buttons_justify = 'flex-start'
  endcase

  assign show_button_1 = false
  if section.settings.button_1_label != blank
    assign show_button_1 = true
  endif
  assign show_button_2 = false
  if section.settings.button_2_label != blank
    assign show_button_2 = true
  endif

  assign image_alt = section.settings.image_alt
  if section.settings.image != blank and image_alt == blank
    assign image_alt = section.settings.image.alt
  endif
-%}

{%- style -%}
  #shopify-section-{{ section.id }} .cit {
    --cit-bg: {{ section.settings.background_color }};
    --cit-sub-color: {{ section.settings.subheading_color }};
    --cit-heading-color: {{ section.settings.heading_color }};
    --cit-text-color: {{ section.settings.text_color }};
    --cit-radius: {{ section.settings.image_radius }}px;
    --cit-border: {{ section.settings.image_border_width }}px solid {{ section.settings.image_border_color }};
    --cit-gap: {{ section.settings.column_gap }}px;
    --cit-content-max: {{ section.settings.content_max_width }}px;
    --cit-image-col: minmax(0, {{ image_width }}fr);
    --cit-text-col: minmax(0, {{ text_width }}fr);
    --cit-sub-size: {{ section.settings.subheading_font_size_mobile }}px;
    --cit-heading-size: {{ section.settings.heading_font_size_mobile }}px;
    --cit-text-size: {{ section.settings.text_font_size_mobile }}px;
    --cit-btn-size: {{ section.settings.button_font_size_mobile }}px;
    --cit-btn-gap: {{ section.settings.button_gap }}px;
    --cit-btn-radius: {{ section.settings.button_radius }}px;
    --cit-icon-color: {{ section.settings.button_icon_color }};
    background-color: var(--cit-bg);
    padding-top: {{ section.settings.padding_top_mobile }}px;
    padding-bottom: {{ section.settings.padding_bottom_mobile }}px;
  }

  @media screen and (min-width: 750px) {
    #shopify-section-{{ section.id }} .cit {
      --cit-sub-size: {{ section.settings.subheading_font_size_tablet }}px;
      --cit-heading-size: {{ section.settings.heading_font_size_tablet }}px;
      --cit-text-size: {{ section.settings.text_font_size_tablet }}px;
      --cit-btn-size: {{ section.settings.button_font_size_tablet }}px;
      padding-top: {{ section.settings.padding_top_tablet }}px;
      padding-bottom: {{ section.settings.padding_bottom_tablet }}px;
    }
  }

  @media screen and (min-width: 990px) {
    #shopify-section-{{ section.id }} .cit {
      --cit-sub-size: {{ section.settings.subheading_font_size_desktop }}px;
      --cit-heading-size: {{ section.settings.heading_font_size_desktop }}px;
      --cit-text-size: {{ section.settings.text_font_size_desktop }}px;
      --cit-btn-size: {{ section.settings.button_font_size_desktop }}px;
      padding-top: {{ section.settings.padding_top_desktop }}px;
      padding-bottom: {{ section.settings.padding_bottom_desktop }}px;
    }
  }

  #shopify-section-{{ section.id }} .cit__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: calc(var(--cit-gap) * 0.7);
    align-items: {{ section.settings.vertical_alignment }};
  }

  @media screen and (min-width: 750px) {
    #shopify-section-{{ section.id }} .cit--split-tablet .cit__grid {
      grid-template-columns: var(--cit-image-col) var(--cit-text-col);
      gap: var(--cit-gap);
    }

    #shopify-section-{{ section.id }} .cit--split-tablet.cit--image-right .cit__grid {
      grid-template-columns: var(--cit-text-col) var(--cit-image-col);
    }

    #shopify-section-{{ section.id }} .cit--split-tablet.cit--image-right .cit__content {
      order: 1;
    }

    #shopify-section-{{ section.id }} .cit--split-tablet.cit--image-right .cit__media {
      order: 2;
    }
  }

  @media screen and (min-width: 990px) {
    #shopify-section-{{ section.id }} .cit__grid {
      grid-template-columns: var(--cit-image-col) var(--cit-text-col);
      gap: var(--cit-gap);
    }

    #shopify-section-{{ section.id }} .cit--image-right .cit__grid {
      grid-template-columns: var(--cit-text-col) var(--cit-image-col);
    }

    #shopify-section-{{ section.id }} .cit--image-right .cit__content {
      order: 1;
    }

    #shopify-section-{{ section.id }} .cit--image-right .cit__media {
      order: 2;
    }
  }

  @media screen and (max-width: 749px) {
    #shopify-section-{{ section.id }} .cit--mobile-image-last .cit__content {
      order: 1;
    }

    #shopify-section-{{ section.id }} .cit--mobile-image-last .cit__media {
      order: 2;
    }
  }

  @media screen and (max-width: 989px) {
    #shopify-section-{{ section.id }} .cit:not(.cit--split-tablet).cit--mobile-image-last .cit__content {
      order: 1;
    }

    #shopify-section-{{ section.id }} .cit:not(.cit--split-tablet).cit--mobile-image-last .cit__media {
      order: 2;
    }
  }

  #shopify-section-{{ section.id }} .cit__media,
  #shopify-section-{{ section.id }} .cit__content {
    min-width: 0;
  }

  #shopify-section-{{ section.id }} .cit__media {
    border-radius: var(--cit-radius);
    overflow: hidden;
    background: {{ section.settings.image_background }};
    border: var(--cit-border);
  }

  {% if section.settings.image_ratio != 'adapt' %}
  #shopify-section-{{ section.id }} .cit__media {
    aspect-ratio: {{ section.settings.image_ratio }};
  }
  {% endif %}

  #shopify-section-{{ section.id }} .cit__media img,
  #shopify-section-{{ section.id }} .cit__media svg {
    width: 100%;
    height: {% if section.settings.image_ratio != 'adapt' %}100%{% else %}auto{% endif %};
    display: block;
    object-fit: {{ image_fit }};
    object-position: {{ section.settings.image_position_focal }};
  }

  #shopify-section-{{ section.id }} .cit__content {
    max-width: var(--cit-content-max);
    text-align: {{ text_align }};
    {% if text_align == 'center' %}
      margin-inline: auto;
    {% elsif text_align == 'right' %}
      margin-left: auto;
    {% endif %}
  }

  @media screen and (min-width: 990px) {
    #shopify-section-{{ section.id }} .cit--image-right .cit__content,
    #shopify-section-{{ section.id }} .cit--split-tablet.cit--image-right .cit__content {
      {% if text_align == 'left' %}
        margin-left: 0;
        margin-right: auto;
      {% endif %}
    }
  }

  #shopify-section-{{ section.id }} .cit__subheading {
    margin: 0 0 {{ section.settings.subheading_spacing }}px;
    color: var(--cit-sub-color);
    font-family: var(--font-heading-family);
    font-size: var(--cit-sub-size);
    font-weight: {{ section.settings.subheading_font_weight }};
    line-height: 1.35;
    letter-spacing: {{ section.settings.subheading_letter_spacing }}em;
    text-transform: {{ section.settings.subheading_text_transform }};
  }

  #shopify-section-{{ section.id }} .cit__heading {
    margin: 0 0 {{ section.settings.heading_spacing }}px;
    color: var(--cit-heading-color);
    font-family: var(--font-heading-family);
    font-size: var(--cit-heading-size);
    font-weight: {{ section.settings.heading_font_weight }};
    line-height: {{ section.settings.heading_line_height }}%;
    letter-spacing: {{ section.settings.heading_letter_spacing }}em;
  }

  #shopify-section-{{ section.id }} .cit__text {
    margin: 0 0 {{ section.settings.text_spacing }}px;
    color: var(--cit-text-color);
    font-size: var(--cit-text-size);
    font-weight: {{ section.settings.text_font_weight }};
    line-height: {{ section.settings.text_line_height }}%;
    letter-spacing: {{ section.settings.text_letter_spacing }}em;
    max-width: {{ section.settings.text_max_width }}px;
  }

  {% if text_align == 'center' %}
  #shopify-section-{{ section.id }} .cit__text {
    margin-left: auto;
    margin-right: auto;
  }
  {% elsif text_align == 'right' %}
  #shopify-section-{{ section.id }} .cit__text {
    margin-left: auto;
  }
  {% endif %}

  #shopify-section-{{ section.id }} .cit__text p {
    margin: 0 0 {{ section.settings.text_paragraph_gap }}px;
  }

  #shopify-section-{{ section.id }} .cit__text p:last-child {
    margin-bottom: 0;
  }

  #shopify-section-{{ section.id }} .cit__buttons {
    display: flex;
    flex-direction: row;
    flex-wrap: wrap;
    align-items: center;
    justify-content: {{ buttons_justify }};
    gap: var(--cit-btn-gap);
    margin: 0;
  }

  #shopify-section-{{ section.id }} .cit__btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.8rem;
    box-sizing: border-box;
    font-size: var(--cit-btn-size);
    font-weight: {{ section.settings.button_font_weight }};
    line-height: 1.2;
    text-decoration: none;
    border-radius: var(--cit-btn-radius);
    transition: background-color 0.25s ease, color 0.25s ease, border-color 0.25s ease, opacity 0.25s ease;
    min-width: auto;
    max-width: 100%;
    cursor: pointer;
  }

  #shopify-section-{{ section.id }} .cit__btn--solid,
  #shopify-section-{{ section.id }} .cit__btn--outline {
    min-height: {{ section.settings.button_min_height }}px;
    padding: {{ section.settings.button_padding_y }}px {{ section.settings.button_padding_x }}px;
  }

  #shopify-section-{{ section.id }} .cit__btn--solid {
    background-color: {{ section.settings.button_1_background }};
    color: {{ section.settings.button_1_text_color }};
    border: {{ section.settings.button_border_width }}px solid {{ section.settings.button_1_background }};
  }

  #shopify-section-{{ section.id }} .cit__btn--2.cit__btn--solid {
    background-color: {{ section.settings.button_2_background }};
    color: {{ section.settings.button_2_text_color }};
    border-color: {{ section.settings.button_2_background }};
  }

  #shopify-section-{{ section.id }} .cit__btn--solid:hover {
    background-color: transparent;
    color: {{ section.settings.button_1_background }};
    border-color: {{ section.settings.button_1_background }};
    opacity: 1;
  }

  #shopify-section-{{ section.id }} .cit__btn--2.cit__btn--solid:hover {
    background-color: transparent;
    color: {{ section.settings.button_2_background }};
    border-color: {{ section.settings.button_2_background }};
  }

  #shopify-section-{{ section.id }} .cit__btn--outline {
    background-color: transparent;
    color: {{ section.settings.button_1_background }};
    border: {{ section.settings.button_border_width }}px solid {{ section.settings.button_1_background }};
  }

  #shopify-section-{{ section.id }} .cit__btn--2.cit__btn--outline {
    color: {{ section.settings.button_2_background }};
    border-color: {{ section.settings.button_2_background }};
  }

  #shopify-section-{{ section.id }} .cit__btn--outline:hover {
    background-color: {{ section.settings.button_1_background }};
    color: {{ section.settings.button_1_text_color }};
    border-color: {{ section.settings.button_1_background }};
  }

  #shopify-section-{{ section.id }} .cit__btn--2.cit__btn--outline:hover {
    background-color: {{ section.settings.button_2_background }};
    color: {{ section.settings.button_2_text_color }};
    border-color: {{ section.settings.button_2_background }};
  }

  #shopify-section-{{ section.id }} .cit__btn--link {
    padding: 0;
    min-height: 0;
    background: transparent;
    border: 0;
    border-radius: 0;
    text-decoration: underline;
    text-underline-offset: 0.25em;
    color: {{ section.settings.button_1_text_color }};
    font-weight: {{ section.settings.button_font_weight }};
  }

  #shopify-section-{{ section.id }} .cit__btn--link:hover {
    opacity: 0.75;
  }

  #shopify-section-{{ section.id }} .cit__btn--2.cit__btn--link {
    color: {{ section.settings.button_2_text_color }};
  }

  #shopify-section-{{ section.id }} .cit__btn-icon {
    width: {{ section.settings.button_icon_size }}px;
    height: {{ section.settings.button_icon_size }}px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    color: var(--cit-icon-color);
  }

  #shopify-section-{{ section.id }} .cit__btn-icon svg {
    width: {{ section.settings.button_icon_size }}px;
    height: {{ section.settings.button_icon_size }}px;
    display: block;
    fill: currentColor;
  }
{%- endstyle -%}

{%- capture cit_arrow_icon -%}
  <span class="cit__btn-icon" aria-hidden="true">
    <svg width="16" height="16" viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg">
      <path d="M1 8C1 9.38447 1.41054 10.7378 2.17971 11.889C2.94888 13.0401 4.04213 13.9373 5.32122 14.4672C6.6003 14.997 8.00776 15.1356 9.36563 14.8655C10.7235 14.5954 11.9708 13.9287 12.9497 12.9497C13.9287 11.9708 14.5954 10.7235 14.8655 9.36563C15.1356 8.00776 14.997 6.6003 14.4672 5.32122C13.9373 4.04213 13.0401 2.94888 11.889 2.17971C10.7378 1.41054 9.38447 1 8 1C6.14348 1 4.36301 1.7375 3.05025 3.05025C1.7375 4.36301 1 6.14348 1 8ZM4 7.5H10.075L7.285 4.6965L8 4L12 8L8 12L7.285 11.2865L10.075 8.5H4V7.5Z" fill="currentColor"/>
    </svg>
  </span>
{%- endcapture -%}

<section class="cit cit--image-{{ image_position }}{% if section.settings.split_on_tablet %} cit--split-tablet{% endif %}{% if section.settings.mobile_image_position == 'below' %} cit--mobile-image-last{% endif %}">
  <div class="page-width{% if section.settings.full_width %} page-width--full-width{% endif %}">
    <div class="cit__grid">
      <div class="cit__media">
        {%- if section.settings.image != blank -%}
          {{
            section.settings.image
            | image_url: width: 1600
            | image_tag:
              loading: 'lazy',
              widths: '550, 750, 990, 1200, 1600',
              sizes: '(min-width: 990px) 45vw, 100vw',
              alt: image_alt
          }}
        {%- else -%}
          {{ 'image' | placeholder_svg_tag: 'placeholder' }}
        {%- endif -%}
      </div>

      <div class="cit__content">
        {%- if section.settings.subheading != blank -%}
          <p class="cit__subheading">{{ section.settings.subheading | escape }}</p>
        {%- endif -%}

        {%- if section.settings.heading != blank -%}
          <{{ section.settings.heading_tag }} class="cit__heading">
            {{ section.settings.heading | escape }}
          </{{ section.settings.heading_tag }}>
        {%- endif -%}

        {%- if section.settings.text != blank -%}
          <div class="cit__text rte">
            {{ section.settings.text }}
          </div>
        {%- endif -%}

        {%- if show_button_1 or show_button_2 -%}
          <div class="cit__buttons">
            {%- if show_button_1 -%}
              <a
                class="cit__btn cit__btn--1 cit__btn--{{ section.settings.button_1_style }}"
                {% if section.settings.button_1_link != blank %}
                  href="{{ section.settings.button_1_link }}"
                {% else %}
                  role="link" aria-disabled="true"
                {% endif %}
              >
                <span>{{ section.settings.button_1_label | escape }}</span>
                {%- if section.settings.show_button_icon and section.settings.button_1_style == 'link' -%}
                  {{ cit_arrow_icon }}
                {%- endif -%}
              </a>
            {%- endif -%}

            {%- if show_button_2 -%}
              <a
                class="cit__btn cit__btn--2 cit__btn--{{ section.settings.button_2_style }}"
                {% if section.settings.button_2_link != blank %}
                  href="{{ section.settings.button_2_link }}"
                {% else %}
                  role="link" aria-disabled="true"
                {% endif %}
              >
                <span>{{ section.settings.button_2_label | escape }}</span>
                {%- if section.settings.show_button_icon and section.settings.button_2_style == 'link' -%}
                  {{ cit_arrow_icon }}
                {%- endif -%}
              </a>
            {%- endif -%}
          </div>
        {%- endif -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Custom image + text",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "image_position",
      "label": "Image position (desktop)",
      "options": [
        { "value": "left", "label": "Image left" },
        { "value": "right", "label": "Image right" }
      ],
      "default": "left"
    },
    {
      "type": "select",
      "id": "mobile_image_position",
      "label": "Image position (mobile)",
      "options": [
        { "value": "above", "label": "Image above text" },
        { "value": "below", "label": "Image below text" }
      ],
      "default": "above"
    },
    {
      "type": "checkbox",
      "id": "split_on_tablet",
      "label": "Keep side-by-side layout on tablet",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "full_width",
      "label": "Full width",
      "default": false
    },
    {
      "type": "range",
      "id": "image_width",
      "min": 30,
      "max": 70,
      "step": 5,
      "unit": "%",
      "label": "Image column width",
      "default": 45
    },
    {
      "type": "select",
      "id": "vertical_alignment",
      "label": "Vertical alignment",
      "options": [
        { "value": "start", "label": "Top" },
        { "value": "center", "label": "Middle" },
        { "value": "end", "label": "Bottom" }
      ],
      "default": "center"
    },
    {
      "type": "select",
      "id": "text_alignment",
      "label": "Text alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ],
      "default": "left"
    },
    {
      "type": "range",
      "id": "content_max_width",
      "min": 320,
      "max": 900,
      "step": 20,
      "unit": "px",
      "label": "Text column max width",
      "default": 660
    },
    {
      "type": "range",
      "id": "column_gap",
      "min": 16,
      "max": 80,
      "step": 4,
      "unit": "px",
      "label": "Space between image and text",
      "default": 56
    },
    {
      "type": "header",
      "content": "Image"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "text",
      "id": "image_alt",
      "label": "Image alt text",
      "default": "Story image"
    },
    {
      "type": "select",
      "id": "image_ratio",
      "label": "Image height",
      "options": [
        { "value": "adapt", "label": "Adapt to image" },
        { "value": "1 / 1", "label": "Square" },
        { "value": "4 / 5", "label": "Portrait" },
        { "value": "16 / 9", "label": "Landscape" }
      ],
      "default": "adapt"
    },
    {
      "type": "select",
      "id": "image_fit",
      "label": "Image fit",
      "options": [
        { "value": "cover", "label": "Cover" },
        { "value": "contain", "label": "Contain" }
      ],
      "default": "cover"
    },
    {
      "type": "select",
      "id": "image_position_focal",
      "label": "Image focal point",
      "options": [
        { "value": "center center", "label": "Center" },
        { "value": "top center", "label": "Top" },
        { "value": "bottom center", "label": "Bottom" },
        { "value": "center left", "label": "Left" },
        { "value": "center right", "label": "Right" }
      ],
      "default": "center center"
    },
    {
      "type": "color",
      "id": "image_background",
      "label": "Image background",
      "default": "#F3EDE7"
    },
    {
      "type": "range",
      "id": "image_radius",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "label": "Image corner radius",
      "default": 24
    },
    {
      "type": "range",
      "id": "image_border_width",
      "min": 0,
      "max": 4,
      "step": 1,
      "unit": "px",
      "label": "Image border width",
      "default": 1
    },
    {
      "type": "color",
      "id": "image_border_color",
      "label": "Image border color",
      "default": "#000000"
    },
    {
      "type": "header",
      "content": "Subheading"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Our story"
    },
    {
      "type": "color",
      "id": "subheading_color",
      "label": "Subheading color",
      "default": "#C6448C"
    },
    {
      "type": "select",
      "id": "subheading_font_weight",
      "label": "Subheading weight",
      "options": [
        { "value": "400", "label": "Regular" },
        { "value": "500", "label": "Medium" },
        { "value": "600", "label": "Semibold" },
        { "value": "700", "label": "Bold" }
      ],
      "default": "600"
    },
    {
      "type": "select",
      "id": "subheading_text_transform",
      "label": "Subheading text transform",
      "options": [
        { "value": "none", "label": "None" },
        { "value": "uppercase", "label": "Uppercase" },
        { "value": "capitalize", "label": "Capitalize" }
      ],
      "default": "none"
    },
    {
      "type": "range",
      "id": "subheading_letter_spacing",
      "min": 0,
      "max": 0.2,
      "step": 0.1,
      "label": "Subheading letter spacing",
      "default": 0
    },
    {
      "type": "range",
      "id": "subheading_font_size_desktop",
      "min": 12,
      "max": 28,
      "step": 1,
      "unit": "px",
      "label": "Subheading size (desktop)",
      "default": 16
    },
    {
      "type": "range",
      "id": "subheading_font_size_tablet",
      "min": 12,
      "max": 24,
      "step": 1,
      "unit": "px",
      "label": "Subheading size (tablet)",
      "default": 15
    },
    {
      "type": "range",
      "id": "subheading_font_size_mobile",
      "min": 11,
      "max": 22,
