{%- comment -%} Custom Cart — checkout confidence info modal {%- endcomment -%}

<div
  class="custom-cart__modal"
  data-custom-cart-modal
  role="dialog"
  aria-modal="true"
  aria-labelledby="custom-cart-modal-title"
  aria-hidden="true"
  hidden
>
  <div class="custom-cart__modal-overlay" data-custom-modal-overlay></div>

  <div class="custom-cart__modal-dialog" data-custom-modal-dialog>
    <button type="button" class="custom-cart__modal-close" data-custom-modal-close aria-label="{{ 'accessibility.close' | t }}">
      {% render 'custom-cart-icons', icon: 'close' %}
    </button>

    <div class="custom-cart__modal-header">
      <h2 id="custom-cart-modal-title" class="custom-cart__modal-title">Checkout With Confidence</h2>
      <p class="custom-cart__modal-subtitle">
        Shop with confidence knowing your order is protected every step of the way
        <span aria-hidden="true">☁️</span>
      </p>
    </div>

    <div class="custom-cart__modal-body">
      <div class="custom-cart__modal-feature">
        <div class="custom-cart__modal-feature-icon">{% render 'custom-cart-icons', icon: 'return' %}</div>
        <div class="custom-cart__modal-feature-text">
          <h3 class="custom-cart__modal-feature-title">Easy Returns & Exchanges for USA Orders</h3>
          <p>Need a different size or style? We offer one U.S. exchange per order and ship your replacement free. Eligible unworn items may also be returned within 30 days through our self-serve return portal. Customers cover return postage, which is typically $7.49 or just $1.98 with Checkout+ Protection.</p>
        </div>
      </div>

      <div class="custom-cart__modal-feature">
        <div class="custom-cart__modal-feature-icon">{% render 'custom-cart-icons', icon: 'box' %}</div>
        <div class="custom-cart__modal-feature-text">
          <h3 class="custom-cart__modal-feature-title">Checkout+ Protection</h3>
          <p>With Checkout+ Protection, returns and exchanges are reduced to just $1.98 instead of standard return postage costs.</p>
        </div>
      </div>

      <div class="custom-cart__modal-feature">
        <div class="custom-cart__modal-feature-icon">{% render 'custom-cart-icons', icon: 'laptop' %}</div>
        <div class="custom-cart__modal-feature-text">
          <h3 class="custom-cart__modal-feature-title">Quick return portal</h3>
          <p>Start your return or exchange in just a few clicks—without the back-and-forth emails or long wait times.</p>
        </div>
      </div>
    </div>

    <p class="custom-cart__modal-legal">
      By purchasing coverage, you agree and have read the
      <a href="{{ shop.privacy_policy.url }}" target="_blank" rel="noopener">Privacy Policy</a>
      and
      <a href="{{ shop.terms_of_service.url }}" target="_blank" rel="noopener">Terms and Conditions</a>.
      Coverage is subject to
      <a href="{{ shop.refund_policy.url }}" target="_blank" rel="noopener">Merchant's Return Policy</a>.
    </p>
  </div>
</div>
