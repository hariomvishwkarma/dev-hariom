{%- comment -%}
  Custom Cart — Redo (ReturnGo) checkout protection widget mount.
  Requires Redo app embed enabled in Theme settings → App embeds.
  Pass redo_enabled: false to skip the mount (Redo hidden for this customer).
{%- endcomment -%}

{%- liquid
  assign show_redo = settings.custom_cart_enable_checkout_protection
  if redo_enabled == false
    assign show_redo = false
  endif
-%}

{%- if show_redo -%}
  <div class="custom-cart__redo" data-custom-redo>
    <div class="returnGo-container">
      <div class="returngo-coverage-on-demand"></div>
    </div>
  </div>
{%- endif -%}
