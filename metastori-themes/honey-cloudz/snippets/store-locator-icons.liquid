{%- comment -%}
  Store locator product icons.
  Usage: {% render 'store-locator-icons', icon: 'cloud', image: section.settings.cloud_icon %}
{%- endcomment -%}
{%- if image != blank -%}
  <span
    class="hc-store-locator__icon-mask hc-store-locator__icon-mask--{{ icon }}"
    style="--icon-mask: url('{{ image | image_url: width: 96 }}');"
    aria-hidden="true"
  ></span>
{%- else -%}
  {%- case icon -%}
    {%- when 'cloud' -%}
      <svg class="hc-store-locator__svg-icon" viewBox="0 0 28 18" fill="none" aria-hidden="true" focusable="false">
        <path
          d="M4.5 14.5h19c3.6 0 6.5-2.7 6.5-6.1 0-3.1-2.3-5.7-5.4-6.1-.8-3-3.5-5.2-6.8-5.2-2.9 0-5.4 1.6-6.7 4C6.2 1.2 3.8 3.4 3.8 6.3 1.7 7 0 9.1 0 11.5c0 1.7.9 3.2 2.2 4z"
          stroke="currentColor"
          stroke-width="1.6"
          stroke-linejoin="round"
        />
      </svg>
    {%- when 'ribbon' -%}
      <svg class="hc-store-locator__svg-icon" viewBox="0 0 16 22" fill="none" aria-hidden="true" focusable="false">
        <path
          d="M8 0C4.7 0 2 2.7 2 6c0 4.8 6 13 6 13s6-8.2 6-13c0-3.3-2.7-6-6-6zm0 9.2A3.2 3.2 0 1 1 8 2.8a3.2 3.2 0 0 1 0 6.4z"
          fill="currentColor"
        />
        <path d="M5.4 17.8 3.5 21M10.6 17.8l1.9 3.2" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" />
      </svg>
  {%- endcase -%}
{%- endif -%}
