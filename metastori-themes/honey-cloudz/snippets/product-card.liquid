<div class="product-card">
  <div class="product-card__image-wrapper">
    <img 
      src="{{product.images.first.src | image_url: width:2000, height:2000}}" 
      alt="Product image" 
      class="product-card__image"
    >
  </div>

  <div class="product-card__content">
    <h3 class="product-card__title">Half Moons<br>Classic Bra Inserts</h3>

    <ul class="product-card__features">
      {% for item in product.metafields.custom.card_short_des.value.children[0].children%}
      <li>
        <span class="check-icon">✔</span>
        {{item.children[0].value}}
      </li>
      {% endfor %}
    </ul>

    <div class="product-card__price">{{product.price | money_with_currency}}</div>

    <button class="product-card__cta">Choose Product</button>
  </div>
</div>


<style>
.product-card {
  width: 100%;
  max-width: 320px;
  background: #fff;
  border-radius: 20px;
  padding: 18px;
  border: 1px solid #e3e3e3;
  box-shadow: 0 2px 6px rgba(0,0,0,0.06);
  display: flex;
  flex-direction: column;
  gap: 14px;
  font-family: sans-serif;
}

.product-card__image-wrapper {
  width: 100%;
  background: #f4f4f4;
  border-radius: 18px;
  overflow: hidden;
}

.product-card__image {
  width: 100%;
  display: block;
}

.product-card__title {
  font-size: 1.1rem;
  font-weight: 700;
  margin: 0;
  color: #222;
  line-height: 1.3;
}

.product-card__features {
  list-style: none;
  margin: 0;
  padding: 0;
  display: flex;
  flex-direction: column;
  gap: 6px;
  font-size: 0.9rem;
  color: #444;
}

.product-card__features li {
  display: flex;
  align-items: flex-start;
  gap: 6px;
}

.check-icon {
  color: #3C87FF;
  font-weight: bold;
  margin-top: 2px;
  font-size: 1rem;
}

.product-card__price {
  font-size: 1.25rem;
  font-weight: 700;
  margin-top: 10px;
}

.product-card__cta {
  margin-top: 6px;
  width: 100%;
  padding: 14px 0;
  border-radius: 40px;
  border: 2px solid #000;
  background: #fff;
  font-weight: 600;
  cursor: pointer;
  transition: 0.2s ease;
}

.product-card__cta:hover {
  background: #000;
  color: #fff;
}
</style>