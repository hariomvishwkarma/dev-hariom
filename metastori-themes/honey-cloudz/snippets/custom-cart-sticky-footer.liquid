{%- comment -%} Custom Cart — sticky checkout footer {%- endcomment -%}

{%- liquid
  assign checkout_total = cart.total_price
  assign use_redo_protection = settings.custom_cart_enable_checkout_protection
  # Redo hidden for this customer: plain theme checkout button, no Redo wrapper.
  if redo_enabled == false
    assign use_redo_protection = false
  endif
-%}

<div class="custom-cart__footer" data-custom-checkout data-checkout-total="{{ checkout_total }}">
  {%- comment -%}
    Config only — the B2B notice itself renders in custom-cart-footer-notice,
    below the checkout buttons, in place of the standard footer notice.
  {%- endcomment -%}
  {% render 'b2b-min-order', show_notice: false %}
  <span class="saw-extra-note custom-cart__saw-note"></span>

  {%- if use_redo_protection -%}
    <redo-checkout-buttons>
      <button
        type="button"
        class="custom-cart__checkout saw_ignore"
        data-custom-checkout-btn
        name="checkout"
        aria-label="{{ 'sections.cart.checkout' | t }}"
      >
        <span class="custom-cart__checkout-content">
          <span class="custom-cart__checkout-label">{{ settings.custom_cart_checkout_button_label | default: 'Checkout' }}</span>
          <span class="custom-cart__checkout-separator" aria-hidden="true">—</span>
          <span class="saw-cart-original-total">
            <span class="custom-cart__checkout-total" data-custom-checkout-total>{{ checkout_total | money }}</span>
          </span>
        </span>
        <span class="custom-cart__checkout-spinner" aria-hidden="true">
          {% render 'custom-cart-icons', icon: 'spinner' %}
        </span>
      </button>
    </redo-checkout-buttons>
  {%- else -%}
    <button
      type="button"
      class="custom-cart__checkout saw_ignore"
      data-custom-checkout-btn
      name="checkout"
      aria-label="{{ 'sections.cart.checkout' | t }}"
    >
      <span class="custom-cart__checkout-content">
        <span class="custom-cart__checkout-label">{{ settings.custom_cart_checkout_button_label | default: 'Checkout' }}</span>
        <span class="custom-cart__checkout-separator" aria-hidden="true">—</span>
        <span class="saw-cart-original-total">
          <span class="custom-cart__checkout-total" data-custom-checkout-total>{{ checkout_total | money }}</span>
        </span>
      </span>
      <span class="custom-cart__checkout-spinner" aria-hidden="true">
        {% render 'custom-cart-icons', icon: 'spinner' %}
      </span>
    </button>
  {%- endif -%}

  <span class="saw-cart-total custom-cart__saw-total" aria-live="polite"></span>
</div>
