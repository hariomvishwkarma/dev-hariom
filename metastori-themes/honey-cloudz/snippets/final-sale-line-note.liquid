{%- comment -%}
  Final sale notice under a cart line item.
  @param item {line_item}
{%- endcomment -%}
{%- assign final_sale_tag = settings.final_sale_tag | strip -%}
{%- if settings.final_sale_enabled and settings.final_sale_cart_notice != blank and final_sale_tag != blank and item.product.tags contains final_sale_tag -%}
  <p class="final-sale-line-note">{{ settings.final_sale_cart_notice | escape }}</p>
{%- endif -%}
