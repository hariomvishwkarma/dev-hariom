{%- comment -%} Shared variant / bundle “Select options” popup {%- endcomment -%}
<modal-dialog id="SizeSelectionModal" class="product-popup-modal">
    <div
      role="dialog"
      aria-label="{{ settings.size_selection_popup_title | escape }}"
      aria-modal="true"
      class="product-popup-modal__content"
      tabindex="-1"
    >
      <button
        id="ModalClose-size-selection"
        type="button"
        class="product-popup-modal__toggle"
        aria-label="{{ 'accessibility.close' | t }}"
      >
        {% render 'icon', icon: 'close-alt' %}
      </button>
      <div class="product-popup-modal__content-info">
        <h2 class="h2">{{ settings.size_selection_popup_title }}</h2>
        <div class="rte">
          {{ settings.size_selection_popup_message }}
        </div>
      </div>
    </div>
  </modal-dialog>
