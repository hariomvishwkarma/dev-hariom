{%- comment -%}
  pdp-responsive-fixes — responsive corrections for the Replo PDP markup that the
  exported stylesheets get wrong.

  Lives with the sections instead of in hc-pdp-ui.css / tbf2-pdp-ui.css because
  the same Replo markup is rendered from more than one place (pdp-buybox and
  hc-pdp-full both pull hc-pdp-chunk.0a, and that chunk carries a copy of the
  How To Wear block as well as the buy box). Including this from every section
  that renders the markup means the fixes travel with the section wherever it is
  dropped, instead of depending on one shared stylesheet.

  Safe to include from every pdp-* section on the page: duplicate <style> blocks
  are inert, same as the repeated stylesheet tags pdp-assets emits.

  Expects `preset` in scope (pull it in with {% include %}, which shares the
  caller's variables). Missing preset falls through to "inserts".
{%- endcomment -%}
<style>
  /*
   * Bundle widget (#bundler-iw) — layout for the Replo buy box only.
   *
   * These rules were written for the new PDP templates but originally sat in
   * bundle-component-iw-new.css, which main-product also loads for the default
   * product template — so the default PDP's buy box picked them up as well.
   * Scoping them to the Replo buy box wrapper keeps them template-based:
   * [data-pdp-preset] is on the pdp-buybox section div, #hc-pdp-fullpage on the
   * full-page section. The default template has neither.
   */

  /* >=1400px: option cards equal width + equal gap, one row */
  @media (min-width: 1400px) {
    :is(#hc-pdp-fullpage, [data-pdp-preset]) #bundler-iw .option-cards {
      display: flex !important;
      flex-wrap: nowrap !important;
      align-items: stretch !important;
      justify-content: flex-start !important;
      column-gap: 1rem !important;
      row-gap: 0 !important;
      gap: 1rem !important;
      width: 100% !important;
    }

    :is(#hc-pdp-fullpage, [data-pdp-preset]) #bundler-iw .option-card {
      flex: 1 1 0 !important;
      width: auto !important;
      max-width: none !important;
      min-width: 0 !important;
      box-sizing: border-box !important;
    }

    :is(#hc-pdp-fullpage, [data-pdp-preset]) #bundler-iw .pair-picker {
      display: flex !important;
      flex-direction: row !important;
      flex-wrap: nowrap !important;
      align-items: center !important;
      gap: 0 !important;
    }

    :is(#hc-pdp-fullpage, [data-pdp-preset]) #bundler-iw .pair-picker .picker-label {
      flex: 0 0 auto !important;
      width: auto !important;
      margin-bottom: 0 !important;
      margin-right: 16px !important;
    }

    :is(#hc-pdp-fullpage, [data-pdp-preset]) #bundler-iw .pair-picker select:nth-child(2) {
      flex: 0 0 125px !important;
      width: 125px !important;
      max-width: 125px !important;
      min-width: 125px !important;
      margin-left: 0 !important;
    }

    :is(#hc-pdp-fullpage, [data-pdp-preset]) #bundler-iw .pair-picker select:nth-of-type(2) {
      flex: 0 0 166px !important;
      width: 166px !important;
      max-width: 166px !important;
      min-width: 166px !important;
      margin-left: 0 !important;
    }
  }

  /* 1025-1399: still one row, but compact */
  @media (min-width: 1025px) and (max-width: 1399px) {
    :is(#hc-pdp-fullpage, [data-pdp-preset]) #bundler-iw .option-cards {
      display: flex !important;
      flex-wrap: nowrap !important;
      column-gap: 0.5rem !important;
      gap: 0.5rem !important;
    }

    :is(#hc-pdp-fullpage, [data-pdp-preset]) #bundler-iw .option-card {
      flex: 1 1 0 !important;
      width: auto !important;
      max-width: none !important;
      min-width: 0 !important;
      padding: 16px 6px;
      box-sizing: border-box !important;
    }

    :is(#hc-pdp-fullpage, [data-pdp-preset]) #bundler-iw img.product-image {
      height: auto;
      max-height: 72px;
      max-width: 100%;
    }

    :is(#hc-pdp-fullpage, [data-pdp-preset]) #bundler-iw .pair-picker {
      flex-wrap: nowrap !important;
      gap: 0 !important;
    }

    :is(#hc-pdp-fullpage, [data-pdp-preset]) #bundler-iw .pair-picker select:nth-child(2),
    :is(#hc-pdp-fullpage, [data-pdp-preset]) #bundler-iw .pair-picker select:nth-of-type(2) {
      flex: 1 1 0 !important;
      max-width: none !important;
      min-width: 0 !important;
    }

    :is(#hc-pdp-fullpage, [data-pdp-preset]) #bundler-iw .picker-box {
      margin: 2rem 0;
      padding: 28px 18px;
      border-radius: 2rem;
    }
  }

  /* <=1024: 2 cards top, odd last full width; size+color no gap */
  @media (max-width: 1024px) {
    :is(#hc-pdp-fullpage, [data-pdp-preset]) #bundler-iw .option-cards {
      display: flex !important;
      flex-wrap: wrap !important;
      column-gap: 10px !important;
      row-gap: 28px !important;
      gap: 28px 10px !important;
    }

    :is(#hc-pdp-fullpage, [data-pdp-preset]) #bundler-iw .option-card {
      flex: 1 1 calc(50% - 5px) !important;
      width: calc(50% - 5px) !important;
      max-width: calc(50% - 5px) !important;
      min-width: 0 !important;
    }

    :is(#hc-pdp-fullpage, [data-pdp-preset]) #bundler-iw .option-card:last-child:nth-child(odd) {
      flex: 1 1 100% !important;
      width: 100% !important;
      max-width: 100% !important;
    }

    :is(#hc-pdp-fullpage, [data-pdp-preset]) #bundler-iw .pair-picker {
      flex-wrap: nowrap !important;
      gap: 0 !important;
    }

    :is(#hc-pdp-fullpage, [data-pdp-preset]) #bundler-iw .pair-picker select:nth-child(2),
    :is(#hc-pdp-fullpage, [data-pdp-preset]) #bundler-iw .pair-picker select:nth-of-type(2) {
      flex: 1 1 0 !important;
      max-width: none !important;
      margin-left: 0 !important;
      margin-right: 0 !important;
    }

    :is(#hc-pdp-fullpage, [data-pdp-preset]) #bundler-iw .picker-box {
      margin: 2rem 0;
      padding: 28px 18px;
      border-radius: 2rem;
    }
  }

{%- if preset == 'breast-form' -%}
  /*
   * Buy box — tablet band (641px–1024px).
   * Replo's tablet rules stack .tbf2-r-5ns6cj into a centred column but leave
   * the info column (.tbf2-r-1mjkdt9) at width:auto / max-width:none /
   * flex-shrink:0 and still position:sticky, so it sizes to its max-content
   * width and spills past the container — the .overflow-clip ancestors then
   * just cut the content off. Only the <=640px rules ever reset it, so the
   * whole band in between is broken. Give the row and the column a real 100%
   * width and drop the sticky offset, matching what Replo does under 640px.
   */
  @media (min-width: 641px) and (max-width: 1024px) {
    :not(#\20):not(#\20):not(#\20):not(#\20):is(#tbf2-fullpage,[data-pdp-preset="breast-form"]) .tbf2-r-5ns6cj {
      width: 100% !important;
      max-width: 100% !important;
      min-width: 0 !important;
      box-sizing: border-box !important;
    }

    :not(#\20):not(#\20):not(#\20):not(#\20):is(#tbf2-fullpage,[data-pdp-preset="breast-form"]) .tbf2-r-1mjkdt9 {
      position: relative !important;
      top: auto !important;
      bottom: auto !important;
      width: 100% !important;
      max-width: 100% !important;
      min-width: 0 !important;
      align-self: stretch !important;
      flex-shrink: 1 !important;
      box-sizing: border-box !important;
    }

    /* Fixed-width Replo children inside the column (variant rows, bundle
       widget, accordions) would re-inflate it otherwise. */
    :not(#\20):not(#\20):not(#\20):not(#\20):is(#tbf2-fullpage,[data-pdp-preset="breast-form"]) .tbf2-r-1mjkdt9 > * {
      max-width: 100% !important;
      min-width: 0 !important;
      box-sizing: border-box !important;
    }
  }
{%- else -%}
  /*
   * Buy box — tablet band (641px–1024px).
   * Replo's tablet rules flip .hc-pdp-r-z80aod to flex-direction:column but
   * leave the info column (.hc-pdp-r-1abc49a) at width:auto / max-width:none /
   * flex-shrink:0 and still position:sticky, so it sizes to its max-content
   * width and spills past the container — the .overflow-clip ancestors then
   * just cut the content off. Only the <=640px rules ever reset it, so the
   * whole band in between is broken. Give the row and the column a real 100%
   * width and drop the sticky offset, matching what Replo does under 640px.
   */
  @media (min-width: 641px) and (max-width: 1024px) {
    :not(#\20):not(#\20):not(#\20):not(#\20):is(#hc-pdp-fullpage,[data-pdp-preset="inserts"]) .hc-pdp-r-z80aod {
      width: 100% !important;
      max-width: 100% !important;
      min-width: 0 !important;
      box-sizing: border-box !important;
    }

    :not(#\20):not(#\20):not(#\20):not(#\20):is(#hc-pdp-fullpage,[data-pdp-preset="inserts"]) .hc-pdp-r-1abc49a {
      position: relative !important;
      top: auto !important;
      bottom: auto !important;
      width: 100% !important;
      max-width: 100% !important;
      min-width: 0 !important;
      align-self: stretch !important;
      flex-shrink: 1 !important;
      box-sizing: border-box !important;
    }

    /* Fixed-width Replo children inside the column (variant rows, bundle
       widget, accordions) would re-inflate it otherwise. */
    :not(#\20):not(#\20):not(#\20):not(#\20):is(#hc-pdp-fullpage,[data-pdp-preset="inserts"]) .hc-pdp-r-1abc49a > * {
      max-width: 100% !important;
      min-width: 0 !important;
      box-sizing: border-box !important;
    }
  }

  /*
   * How To Wear — phones and small tablets (<= 647px).
   * hc-pdp-ui.css caps the step images at min(300px, 100%) under 640px and the
   * base Replo box is a fixed 370x496, which crops or letterboxes the shot.
   * Here the section keeps a flat 20px gutter and each <picture> fills what is
   * left, at its natural height so the whole image is visible.
   */
  @media (max-width: 647px) {
    :not(#\20):not(#\20):not(#\20):not(#\20):is(#hc-pdp-fullpage,[data-pdp-preset="inserts"]) [data-hc-pdp-id='e387518a-87c9-49d7-a30b-b3ba03e8bca4'] {
      padding-left: 20px !important;
      padding-right: 20px !important;
      box-sizing: border-box !important;
    }

    :not(#\20):not(#\20):not(#\20):not(#\20):is(#hc-pdp-fullpage,[data-pdp-preset="inserts"]) [data-hc-pdp-id='e387518a-87c9-49d7-a30b-b3ba03e8bca4'] .hc-pdp-r-vpft41,
    :not(#\20):not(#\20):not(#\20):not(#\20):is(#hc-pdp-fullpage,[data-pdp-preset="inserts"]) [data-hc-pdp-id='e387518a-87c9-49d7-a30b-b3ba03e8bca4'] .hc-pdp-r-h8ofg9,
    :not(#\20):not(#\20):not(#\20):not(#\20):is(#hc-pdp-fullpage,[data-pdp-preset="inserts"]) [data-hc-pdp-id='e387518a-87c9-49d7-a30b-b3ba03e8bca4'] .hc-pdp-r-wg90j2 {
      display: block !important;
      width: 100% !important;
      max-width: 100% !important;
      min-width: 0 !important;
      height: auto !important;
      min-height: 0 !important;
      max-height: none !important;
      margin-left: 0 !important;
      margin-right: 0 !important;
      overflow: hidden !important;
      overflow-x: hidden !important;
      overflow-y: hidden !important;
      box-sizing: border-box !important;
    }

    :not(#\20):not(#\20):not(#\20):not(#\20):is(#hc-pdp-fullpage,[data-pdp-preset="inserts"]) [data-hc-pdp-id='e387518a-87c9-49d7-a30b-b3ba03e8bca4'] .hc-pdp-r-vpft41 img,
    :not(#\20):not(#\20):not(#\20):not(#\20):is(#hc-pdp-fullpage,[data-pdp-preset="inserts"]) [data-hc-pdp-id='e387518a-87c9-49d7-a30b-b3ba03e8bca4'] .hc-pdp-r-h8ofg9 img,
    :not(#\20):not(#\20):not(#\20):not(#\20):is(#hc-pdp-fullpage,[data-pdp-preset="inserts"]) [data-hc-pdp-id='e387518a-87c9-49d7-a30b-b3ba03e8bca4'] .hc-pdp-r-wg90j2 img {
      display: block !important;
      width: 100% !important;
      max-width: 100% !important;
      min-width: 0 !important;
      height: auto !important;
      min-height: 0 !important;
      max-height: none !important;
      object-fit: contain !important;
    }
  }
{%- endif -%}
</style>
