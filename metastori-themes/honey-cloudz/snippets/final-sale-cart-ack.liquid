{%- comment -%}
  Final sale acknowledgment checkbox. Renders only when the cart holds a final
  sale item; assets/final-sale-ack.js blocks checkout until it is ticked.
{%- endcomment -%}
{%- liquid
  assign final_sale_tag = settings.final_sale_tag | strip
  assign cart_has_final_sale = false
  if settings.final_sale_enabled and settings.final_sale_ack_text != blank and final_sale_tag != blank
    for cart_item in cart.items
      if cart_item.product.tags contains final_sale_tag
        assign cart_has_final_sale = true
        break
      endif
    endfor
  endif
-%}
{%- if cart_has_final_sale -%}
  <div class="final-sale-ack" data-final-sale-ack>
    <label class="final-sale-ack__label">
      <input type="checkbox" class="final-sale-ack__input" data-final-sale-ack-input autocomplete="off">
      <span class="final-sale-ack__text">{{ settings.final_sale_ack_text | escape }}</span>
    </label>
    <p class="final-sale-ack__error" data-final-sale-ack-error role="alert" hidden>
      {{- settings.final_sale_ack_error | default: 'Please tick the box above to continue to checkout.' | escape -}}
    </p>
  </div>
{%- endif -%}
