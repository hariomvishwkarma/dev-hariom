{% if kg_block %}
  <div class="kg-messagetier-styled-wrap">
    <div class="kg-messagetier-styled-lefcontent">
      <div class="kg-left-text">
        <div class="kg-text">
          {% if kg_block.kg_block_title_text != blank %}
            <h2 class="kg-subtitle-styled">{{ kg_block.kg_block_title_text }}</h2>
          {% endif %}
          <div class="kg-detailscontainer-text">
            {% if kg_block.kg_enable_popup %}
              {% if kg_block.kg_popup_link_lable != blank %}
                <a class="kg-linktext kg-dicount-popup-toggle-button">
                  <span class="kg-linktext-styled">{{ kg_block.kg_popup_link_lable }}</span>
                </a>
              {% endif %}
            {% endif %}
          </div>
        </div>
      </div>
      <div class="kg-text-rightcontent">
        <div class="kg-text-right">
          {% if kg_block.kg_discounts_label != blank %}
            {{ kg_block.kg_discounts_label }}
          {% endif %}
        </div>
      </div>
    </div>
  </div>

  <!-- popup html -->
  {% if kg_block.kg_enable_popup %}
    <div class="kg-discount-detail-popup-wrapper">
      <div class="kg-popup-details-wrap kg-popup-details-text-wrap">
        <div class="kg-popup-details-title">
          {% if kg_block.kg_popup_heading_text != blank %}
            <h1 class="kg-dialogHeader-styled-top">{{ kg_block.kg_popup_heading_text }}</h1>
          {% endif %}
          <div class="kg-dialogHeader-styled">
            <button
              data-label="modal_close"
              data-testid="modal_close"
              aria-label="close modal"
              class="kg-Button-styled kg-dicount-popup-toggle-button"
            >
              <span data-name="close" class="kg-icon-close">
                <svg xmlns="http://www.w3.org/2000/svg" width="15" height="30" viewBox="0 0 15 30" fill="none">
                  <path d="M0.321429 21.6786C0.535714 21.8929 0.75 22 1.07143 22C1.39286 22 1.60714 21.8929 1.82143 21.6786L7.5 16L13.1786 21.6786C13.3929 21.8929 13.7143 22 13.9286 22C14.1429 22 14.4643 21.8929 14.6786 21.6786C15.1071 21.25 15.1071 20.6071 14.6786 20.1786L9 14.5L14.6786 8.82143C15.1071 8.39286 15.1071 7.75 14.6786 7.32143C14.25 6.89286 13.6071 6.89286 13.1786 7.32143L7.5 13L1.82143 7.32143C1.39286 6.89286 0.75 6.89286 0.321429 7.32143C-0.107143 7.75 -0.107143 8.39286 0.321429 8.82143L6 14.5L0.321429 20.1786C-0.107143 20.6071 -0.107143 21.25 0.321429 21.6786Z" fill="black"/>
                </svg>
              </span>
            </button>
          </div>
        </div>
        <div class="kg-details-modal-content">
          <div class="kg-layout-text-wrap">
            <div class="kg-details-editorial">
              <div class="kg-richtext-details">
                {% if kg_block.kg_popup_content != blank %}
                  {{ kg_block.kg_popup_content }}
                {% endif %}
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>

    <script>
       document.addEventListener("DOMContentLoaded", function () {
        const toggleButtons = document.querySelectorAll('.kg-dicount-popup-toggle-button');
        const popupWrapper = document.querySelector('.kg-discount-detail-popup-wrapper');

        if (toggleButtons && popupWrapper) {
          toggleButtons.forEach(function (button) {
            button.addEventListener('click', function () {
              popupWrapper.classList.toggle('kg_discount_popup_open');
            });
          });

          // Close modal on backdrop click
          popupWrapper.addEventListener('click', function (event) {
            // Check if the clicked area is outside the modal content
            if (!event.target.closest('.kg-popup-details-wrap')) {
              popupWrapper.classList.remove('kg_discount_popup_open');
            }
          });
        }
      });
    </script>
  {% endif %}
{% endif %}
