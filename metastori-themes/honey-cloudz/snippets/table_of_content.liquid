<style>
  #table-of-content {
    display: none; 
  }
  #table-of-content.active {
    display: block; 
  }
  
 #table_of_content ul a {
   text-decoration: unset; 
   color: rgb(var(--color-foreground)); 
   font-size: 90%;
 }
  #table_of_content ul a:focus , #table_of_content ul a:hover {
    text-decoration: underline; 
  }
  #table_of_content > ul > li > a {
    font-weight: 600; 
  }
  #table_of_content > ul > li > ul > li > a {
    font-weight: 500; font-size: 13px;  
  }
  .floating-toc-button {
    position: sticky; top: 20%;
    padding: 10px; width: max-content;   margin-bottom: 20px; 
    border-color: {{settings.toc_button_bg_color}}; background-color: {{settings.toc_button_bg_color}};
    color: {{settings.toc_button_text_color}}; animation: pulse-animation 1s infinite;
    cursor: pointer; -webkit-box-shadow:rgba(0, 0, 0, 0.1) 0px 4px 6px -1px, rgba(0, 0, 0, 0.06) 0px 2px 4px -1px;
    box-shadow: rgba(0, 0, 0, 0.1) 0px 4px 6px -1px, rgba(0, 0, 0, 0.06) 0px 2px 4px -1px;
    display: flex; align-items: center; justify-content: center; 
    transition: background-color 0.3s ease, color 0.3s ease;
  }
  .toc-close-button {
    background: transparent; border: unset; 
    position: absolute; top: 20px; right: 10px; background: none;
    border: none; font-size: 1.5em; cursor: pointer;
  }
  .toc-close-button svg {
    height: 15px; width: 15px; 
  }
  .floating-toc-button .toc-icon {
    display: inline-block;  max-width: 20px; max-height: 20px;
    margin-right: 5px; vertical-align: middle;
  }
  /* Overlay Styles */
  #toc-overlay {
    position: fixed; top: 0; left: 0; width: 100%;
    height: 100%; background-color: rgba(0, 0, 0, 0.2); /* Semi-transparent background */
    z-index: 90; cursor: crosshair; display: none; /* Hidden by default */
    transition: opacity 0.3s ease;
  }
  
  #toc-overlay.active {
    display: block; opacity: 1;
  }
  .floating-toc-button .toc-text {
    display: inline-block; color: inherit; vertical-align: middle;
  }
  
  .floating-toc-button:hover, .floating-toc-button:focus {
    background-color: {{ settings.toc_button_hover_bg_color }};
    color: {{ settings.toc_button_hover_text_color }};
  }
  
  
  @keyframes pulse-animation {
    0% {
      -webkit-box-shadow: 0 0 0 0px rgba(0, 0, 0, 0.4);
      box-shadow: 0 0 0 0px rgba(0, 0, 0, 0.4);
    }
    100% {
      -webkit-box-shadow: 0 0 0 10px rgba(0, 0, 0, 0);
      box-shadow: 0 0 0 10px rgba(0, 0, 0, 0);
    }
  }

  .toc-sidebar {
    position: fixed; top: 0; left: -300px;
    width: 300px; height: 100%;
    background-color: #fff; box-shadow: -2px 0 5px rgba(0, 0, 0, 0.2);
    overflow-y: auto;  z-index: 100;
    transition: left 0.3s ease; padding: 20px;
  }
  
  .toc-sidebar.open {
    left: 0;
  }



</style>



<script>

document.addEventListener('DOMContentLoaded', function() {
  {% if settings.enable_toc %}
   new Shopify.TableOfContents('#article-content', '#table_of_content', 'sticky-header',true);
  {% else %}
    new Shopify.TableOfContents('#article-content', '#table_of_content', 'sticky-header',false);
  {% endif %}
});


</script>