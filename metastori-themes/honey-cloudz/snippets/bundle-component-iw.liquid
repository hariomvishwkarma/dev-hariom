      >
      <span>
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
          <path fill-rule="evenodd" clip-rule="evenodd" d="M20.2854 4.3208L21.7577 4.81159C21.8282 4.83475 21.8896 4.87957 21.9331 4.93966C21.9766 4.99975 22 5.07203 22 5.14621C22 5.22039 21.9766 5.29268 21.9331 5.35277C21.8896 5.41286 21.8282 5.45768 21.7577 5.48084L20.2854 5.97163C20.2334 5.98891 20.1862 6.01807 20.1475 6.0568C20.1087 6.09552 20.0796 6.14274 20.0623 6.19471L19.5727 7.6659C19.5495 7.73637 19.5047 7.79773 19.4446 7.84123C19.3845 7.88473 19.3122 7.90815 19.2381 7.90815C19.1639 7.90815 19.0916 7.88473 19.0315 7.84123C18.9714 7.79773 18.9266 7.73637 18.9034 7.6659L18.4126 6.19354C18.3954 6.14157 18.3662 6.09435 18.3275 6.05562C18.2888 6.0169 18.2415 5.98774 18.1896 5.97045L16.7184 5.48084C16.6479 5.45768 16.5865 5.41286 16.543 5.35277C16.4995 5.29268 16.4761 5.22039 16.4761 5.14621C16.4761 5.07203 16.4995 4.99975 16.543 4.93966C16.5865 4.87957 16.6479 4.83475 16.7184 4.81159L18.1907 4.3208C18.2427 4.30352 18.2899 4.27436 18.3287 4.23563C18.3674 4.1969 18.3965 4.14968 18.4138 4.09772L18.9034 2.62653C18.9266 2.55606 18.9714 2.4947 19.0315 2.4512C19.0916 2.4077 19.1639 2.38428 19.2381 2.38428C19.3122 2.38428 19.3845 2.4077 19.4446 2.4512C19.5047 2.4947 19.5495 2.55606 19.5727 2.62653L20.0635 4.09889C20.0987 4.20456 20.1809 4.28675 20.2866 4.32197M8.89984 4.02844C9.20277 3.11849 10.4896 3.11966 10.7925 4.02844L12.5972 9.44118L18.0099 11.2458C18.9187 11.5487 18.9187 12.8356 18.0099 13.1385L12.5972 14.9432L10.7925 20.3559C10.4896 21.2647 9.20277 21.2647 8.89984 20.3559L7.0952 14.9432L1.68246 13.1385C0.772512 12.8356 0.772512 11.5487 1.68246 11.2458L7.0952 9.44118L8.89984 4.02844ZM9.84502 6.75712L8.64388 10.3594C8.59487 10.5061 8.51239 10.6395 8.40296 10.7489C8.29353 10.8584 8.16016 10.9408 8.01337 10.9899L4.41114 12.191L8.01337 13.3921C8.16016 13.4411 8.29353 13.5236 8.40296 13.6331C8.51239 13.7425 8.59487 13.8759 8.64388 14.0226L9.84502 17.6249L11.0462 14.0226C11.0952 13.8759 11.1777 13.7425 11.2871 13.6331C11.3965 13.5236 11.5299 13.4411 11.6767 13.3921L15