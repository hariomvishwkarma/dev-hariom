  <div class="error-messages">
    <p class="incomplete-selection-error">Incomplete selection, please select all products</p>
    <p class="out_of_stock-error">Out of stock, please choose another size or color.</p>
  </div>

  <button class="add-to-cart">
    ADD TO CART - {{ widget_data.second_option_price.value | json | money_without_trailing_zeros }}
  </button>

  <div class="notify-iw">
    <button id="restock-{{ product.handle }}">Notify Me</button>
  </div>
</div>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const currency = '{{ cart.currency.symbol }}'
    const priceEls = document.querySelectorAll('.option-card .price');
    const quanSelectors = document.querySelectorAll('.option-cards .option-card');
    const selectionIndicators = document.querySelectorAll('.selection-indicator-wrapper');
    const ATC = document.querySelector('.add-to-cart');
    const incompleteSelectionError = document.querySelector('.incomplete-selection-error');
    const outofstockError = document.querySelector('.out_of_stock-error');
    const notifyBlock = document.querySelector('.notify-iw');
    const loaderSVG = `
  <svg class="spinner" width="16" height="16" viewBox="0 0 44 44" xmlns="http://www.w3.org/2000/svg" stroke="#fff">
    <g fill="none" fill-rule="evenodd" stroke-width="4">
      <circle cx="22" cy="22" r="20" stroke-opacity="0.25"/>
      <path d="M42 22c0-11.046-8.954-20-20-20">
        <animateTransform 
          attributeName="transform" 
          type="rotate" 
          from="0 22 22" 
          to="360 22 22" 
          dur="1s" 
          repeatCount="indefinite"/>
      </path>
    </g>
  </svg>
  
`;



    const sizes = [...new Set(variants.map((v) => v.size))];

    const buildPickerGroup = (pairNumber) => {
      const label = document.createElement('div');
      label.textContent = `{{ widget_data.product_unit.value }} #${pairNumber}`;
      label.style.marginBottom = '0.5rem';
      label.style.fontFamily = 'Satoshi';
      label.style.fontSize = '20px';
      label.style.fontWeight = '600';
      label.classList.add("picker-label")

      const sizeSelect = document.createElement('select');
      const colorSelect = document.createElement('select');

      const seletedVariantImage = document.createElement('div');
      const imageEl = document.createElement('img');
      imageEl.classList.add("selected-variant-image")
      seletedVariantImage.appendChild(imageEl)

      sizeSelect.innerHTML = `<option disabled selected>Select size</option>`;
      colorSelect.innerHTML = `<option disabled selected>Select color</option>`;

      sizes.forEach((size) => {
        const opt = document.createElement('option');
        opt.value = opt.textContent = size;
        sizeSelect.appendChild(opt);
      });

      sizeSelect.addEventListener('change', () => {
        colorSelect.innerHTML = `<option disabled selected>Select color</option>`;
        console.log("image",sizeSelect);
        const availableColors = [
          ...new Set(
            variants
              .filter(v => v.size === sizeSelect.value)
              .map(v => ({ color: v.color, quan: v.available })) 
          )
        ];

        availableColors.forEach(obj => {
          const opt = document.createElement('option');
          opt.value = opt.textContent = obj.color;
          opt.setAttribute("data-quantity", obj.quan);
          colorSelect.appendChild(opt);
          colorSelect.selectedIndex = 0;
        });

        imageEl.style.display = "none";
        sizeSelect.parentElement.setAttribute('selected-id', '');
        sizeSelect.parentElement.setAttribute('selected-available', "null");
        setPrice();
        checksSelection() 
      });


      colorSelect.addEventListener('change', () => {
        const selectedSize = sizeSelect.value;
        const selectedColor = colorSelect.value;
        const match = variants.find((v) => v.size === selectedSize && v.color === selectedColor);
        imageEl.src = match.image;
        imageEl.style.display = "block";
        sizeSelect.parentElement.setAttribute('selected-id', match ? match.id : '');
        sizeSelect.parentElement.setAttribute('selected-available', match ? match.available : '');
        setPrice();
        checksSelection()
      });

      const wrapper = document.createElement('div');
      wrapper.classList.add('pair-picker');
      wrapper.setAttribute('selected-id', '');
      wrapper.append(label, sizeSelect, colorSelect, seletedVariantImage);
      return wrapper;
    };

    const createPickers = (count = 3) => {
      const wrapper = document.getElementById('variant-select-wrapper');
      wrapper.innerHTML = '';
      for (let i = 1; i <= count; i++) {
        wrapper.appendChild(buildPickerGroup(i));
      }
      ATC.setAttribute('data-limit', count);
      initialSelection();
      document.querySelectorAll(".selected-variant-image").forEach(el=>{
        {% comment %} el.style.display = "none" {% endcomment %}
      })
    };

    // Create initial pickers
    createPickers({{ widget_data.option_quantity.value[1] }});

    quanSelectors.forEach((selector) => {
      selector.addEventListener('click', (e) => {
        quanSelectors.forEach((s) => s.classList.remove('active'));
        selectionIndicators.forEach((s) => s.classList.remove('active'));
        selector.classList.add('active');
        selector.querySelector(".selection-indicator-wrapper").classList.add('active');
        createPickers(selector.getAttribute('data-quantity'));
        const total = selector.querySelector('.price .to-cart-price').textContent;
        ATC.innerHTML = `ADD TO CART - ${total}`;
        setPrice();
      });
    });

    function initialSelection() {
      document.querySelectorAll('.picker-group .pair-picker').forEach((picker) => {
        picker.querySelectorAll('select').forEach((select, idx) => {
          if (select.options.length > 1) {
            select.selectedIndex = 1;
            select.dispatchEvent(new Event('change'));
          }
        });
      });
    }

    function checksSelection () {
      let isOOS = false;
      {% comment %} let isIncomplete = false; {% endcomment %}
      document.querySelectorAll('.picker-group .pair-picker').forEach((picker) => {
          let quantity = picker.getAttribute('selected-available');
          {% comment %} let id = picker.getAttribute('selected-id'); {% endcomment %}

          if (quantity < 1 ){
            outofstockError.style.display = "block"
            // shows Notify me button if all selcted variants have stock
            notifyBlock?.classList?.add("show");
            console.log("is element?",document.querySelector("div.nm-portal"))

            picker.querySelector("div").style.color = "red"
            isOOS = true;
          }else{
            picker.querySelector("div").style.color = "black"
          }
          {% comment %} else if(!id && !isOOS){
            incompleteSelectionError.style.display = "block"
            isIncomplete = true
          }  {% endcomment %}
      })

      if(!isOOS ){
        outofstockError.style.display = "none"
        // hides Notify me button if found and selcted variant is OOS
        notifyBlock?.classList?.remove("show");

        document.querySelectorAll('.picker-group .pair-picker').forEach((picker) =>{
          picker.querySelector("div").style.color = "black"
        })
      }
      {% comment %} if(!isOOS && !isIncomplete){
        incompleteSelectionError.style.display = "none"
        outofstockError.style.display = "none"
      } {% endcomment %}
    }

    function setPrice() {
      {% comment %} TO ENABLE DYNAMIC PRICING UNCOMMENT THIS CODE  {% endcomment %}
      {% comment %} priceEls.forEach((el) => {
        if (!el || !el.parentElement) return;

        const quanAttr = el.parentElement.getAttribute('data-quantity');
        const quan = Number(quanAttr);
        if (isNaN(quan) || !variants?.[0]) return;

        const compareAtPriceEl = el.querySelector('.compare-at-price');
        const priceEl = el.querySelector('.to-cart-price');

        if (compareAtPriceEl) {
          compareAtPriceEl.textContent = `${currency}${(variants[0].compareAtPrice * quan).toFixed(2)}`;
        }
        if (priceEl) {
          priceEl.textContent = `${currency}${(variants[0].price * quan).toFixed(2)}`;
        }

        if (el.parentElement.classList.contains('active')) {
          const pickers = document.querySelectorAll('.picker-group .pair-picker');
          let totalPrice = 0;
          let totalComparePrice = 0;
          pickers.forEach((el) => {
            const targetId = el.getAttribute('selected-id');
            const match = variants.find((item) => item.id == targetId);
            totalPrice += Number(match?.price) || 0;
            totalComparePrice += Number(match?.compareAtPrice) || 0 ;
          });
          if (compareAtPriceEl) {
            compareAtPriceEl.textContent = `${currency}${totalComparePrice.toFixed(2)}`;
          }
          if (priceEl) {
            priceEl.textContent = `${currency}${totalPrice.toFixed(2)}`;
          }
        }
      }); {% endcomment %}
    }

    setPrice();



async function refreshAndOpenCart() {
  try {
    const miniCart = document.querySelector('mini-cart');
    const drawer = document.querySelector('cart-drawer');
    if (!miniCart) throw new Error('MiniCart element not found');
    if (!drawer) throw new Error('Cart drawer element not found');

    const cartSection =
      window.customCartDrawerEnabled || window.CustomCartUtils?.isEnabled?.()
        ? 'custom-cart-drawer'
        : 'mini-cart';
    const sections = [cartSection, 'cart-icon-bubble', 'mobile-cart-icon-bubble'];
    const res = await fetch(`${window.Shopify.routes.root}?sections=${sections.join(',')}`);
    const data = await res.json();

    sections.forEach((id) => {
      const html = data[id];
      if (!html) return;

      const el = document.getElementById(id === cartSection ? 'mini-cart' : id);
      if (!el) return;

      if (
        id === cartSection &&
        (window.customCartDrawerEnabled || window.CustomCartUtils?.isEnabled?.())
      ) {
        window.CustomCartUtils?.patchCartDrawerContent?.(el, html);
        window.CustomCartUtils?.dedupeCartDrawerChrome?.(
          el.querySelector('[data-custom-cart]')
        );
        return;
      }

      const newHTML = new DOMParser()
        .parseFromString(html, 'text/html')
        .querySelector('.shopify-section')?.innerHTML;

      if (newHTML) {
        el.innerHTML = newHTML;
        console.log(`✅ Updated section: ${id}`);
      } else {
        console.warn(`⚠️ Could not update section: ${id}`);
      }
    });

    // Re-inject gift note button (if your component adds it)
    if (miniCart.renderGiftNoteButton) {
      miniCart.renderGiftNoteButton();
      console.log('🎁 Gift note button re-rendered');
    }

    // Fire your custom event
    document.dispatchEvent(new CustomEvent('cartdrawer:opened'));

    // Open the drawer
    if (drawer.openMenuDrawer) {
      drawer.openMenuDrawer();
      console.log('%c🛒 Drawer opened via openMenuDrawer()', 'color:blue;font-weight:bold;');
    } else {
      const details = drawer.querySelector('details');
      if (details) details.setAttribute('open', true);
      drawer.classList.add('is-open', 'active');
      console.log('%c🛒 Drawer opened manually', 'color:orange;font-weight:bold;');
    }

    console.log('%c✨ Cart refreshed, count updated, and drawer opened!', 'color:green;font-weight:bold;');
  } catch (err) {
    console.error('❌ Error refreshing cart drawer and count:', err);
  }
}



    ATC.addEventListener('click', () => {
      ATC.disabled = true;
      ATC.innerHTML = loaderSVG;

      const tocart = [];
      let isToCart = true;

      const pickers = document.querySelectorAll('.pair-picker');
      let isOOS = false;
      let isIncomplete = false;
      pickers.forEach((picker) => {
        let quantity = picker.getAttribute('selected-available');
        let id = picker.getAttribute('selected-id');
        id = id?.length > 0 ? id : null;
        if(quantity < 1 && quantity != "null" && isIncomplete != true){
          {% comment %} ATC.innerHTML = `OUT OF STOCK SELECTION`; {% endcomment %}
          picker.querySelector("div").style.color = "red"
          {% comment %} outofstockError.style.display = "block" {% endcomment %}

          isToCart = false;
          isOOS = true; 
        }else if (id == null && isOOS != true) {
          {% comment %} ATC.innerHTML = `INCOMPLETE SELECTION`; {% endcomment %}
          if(outofstockError.style.display == "none"){
            incompleteSelectionError.style.display = "block"
            picker.querySelector("div").style.color = "red"
          }

          isToCart = false;
          isIncomplete = true;
        } else {
          tocart.push({ id: parseInt(id), quantity: 1 });
        }
      });


      if (isToCart) {
        fetch('/cart/add.js', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
            Accept: 'application/json',
          },
          body: JSON.stringify({ items: tocart }),
        })
          .then((res) => res.json())
          .then((data) => {
            refreshAndOpenCart();
            createPickers(ATC.getAttribute('data-limit'));
          })
          .catch((err) => {
            console.error('Cart error:', err);
          });
      }

      setTimeout(() => {
        const price = document.querySelector('.option-card.active .to-cart-price')?.textContent || '$26';
        ATC.innerHTML = `ADD TO CART - ${price}`;
        ATC.disabled = false;
        pickers.forEach((picker) =>{
          let quantity = picker.getAttribute('selected-available')
          if(quantity != "0") picker.querySelector("div").style.color = "black"
        })
        incompleteSelectionError.style.display = "none"
       {% comment %} outofstockError.style.display = "none" {% endcomment %}
      }, 2000);
    });

    window.createPickers = createPickers;






  });
</script>


<style>
  .option-card:nth-child(1) .savings-tag {
  background: {{widget_data["first_saving_element_background"].value}};
}

.option-card:nth-child(2) .savings-tag {
  background: {{widget_data["second_saving_element_background"].value}};
}

.option-card:nth-child(3) .savings-tag {
  background: {{widget_data["third_saving_element_background"].value}};
}
