          </svg>
          {{ settings['pdp-widget-top-badge-2'] }}
        </div>
      {% endif %}
      <div class="buy-quantity-text">
        <div class="selection-indicator-wrapper active">
          <div class="selection-indicator" ></div>
        </div>
        <span>Buy {{ widget_data.option_quantity.value[1] }} {{ widget_data.product_unit.value }}s</span>
      </div>

      <div class="price">
        {% if widget_data.second_option_compareat.value > 0 -%}
          <span class="compare-at-price">
            {{- widget_data.second_option_compareat.value | json | money_without_trailing_zeros -}}
          </span>
        {%- endif -%}
        <span class="to-cart-price">
          {{- widget_data.second_option_price.value | json | money_without_trailing_zeros -}}
        </span>
      </div>
      <img class="product-image" src="{{ widget_data["options_image"].value[1] }}" alt="Product">
      {% if settings['pdp-widget-bottom-benefit-2'].length > 0 %}
        <div class="subtext">{{ settings['pdp-widget-bottom-benefit-2'] }}</div>
      {% endif %}
      {% comment %} update below setting properly for all 3 seletors {% endcomment %}
      {% if widget_data.second_shipping_text.value != "none" %} 
