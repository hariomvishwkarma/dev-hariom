{% doc %}
  Outputs WebSite JSON-LD with optional SearchAction.
  @example
  {% render 'schema-website' %}
{% enddoc %}

{%- liquid
  assign search_target = request.origin | append: routes.search_url | append: '?q={search_term_string}'
-%}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "WebSite",
  "@id": {{ request.origin | append: '/#website' | json }},
  "name": {{ shop.name | json }},
  "url": {{ request.origin | json }},
  "publisher": {
    "@id": {{ request.origin | append: '/#organization' | json }}
  }
  {%- if routes.search_url != blank -%}
  ,"potentialAction": {
    "@type": "SearchAction",
    "target": {
      "@type": "EntryPoint",
      "urlTemplate": {{ search_target | json }}
    },
    "query-input": "required name=search_term_string"
  }
  {%- endif -%}
}
</script>
