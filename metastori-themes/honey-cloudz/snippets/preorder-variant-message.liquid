{% doc %}
Renders preorder message for a variant. Variant metafield first, then global theme setting.
Renders nothing while Theme settings > Preorder > Enable pre-order is off.
@param {variant} variant
@param {string} [format] - html or text
{% enddoc %}

{%- if settings.preorder_enabled -%}
  {%- if format == 'text' -%}
    {%- if variant.metafields.custom.preorder_message != blank -%}
      {{- variant.metafields.custom.preorder_message | metafield_tag | strip_html | strip -}}
    {%- elsif settings.preorder_text != blank -%}
      {{- settings.preorder_text | strip_html | strip -}}
    {%- endif -%}
  {%- else -%}
    <div class="preorder-variant-message__content rte">
      {%- if variant.metafields.custom.preorder_message != blank -%}
        {{ variant.metafields.custom.preorder_message | metafield_tag }}
      {%- elsif settings.preorder_text != blank -%}
        {{ settings.preorder_text }}
      {%- endif -%}
    </div>
  {%- endif -%}
{%- endif -%}
