{%- comment -%}
  Google Consent Mode v2 defaults. Must render before any gtag('config') call,
  otherwise Google tags fire before a consent state exists and Consentmo reports
  "integrated_properly: false". Consentmo sends gtag('consent', 'update') once the
  visitor's region / banner choice is known.

  Opt-in regions (EEA, UK, Switzerland) start denied; everywhere else starts granted,
  matching the Consentmo region setup where US visitors are not shown an opt-in banner.
{%- endcomment -%}
<script>
  window.dataLayer = window.dataLayer || [];
  function gtag() {
    dataLayer.push(arguments);
  }
  gtag('consent', 'default', {
    ad_storage: 'denied',
    ad_user_data: 'denied',
    ad_personalization: 'denied',
    analytics_storage: 'denied',
    functionality_storage: 'denied',
    personalization_storage: 'denied',
    security_storage: 'granted',
    wait_for_update: 500,
    region: [
      'AT', 'BE', 'BG', 'HR', 'CY', 'CZ', 'DK', 'EE', 'FI', 'FR', 'DE', 'GR', 'HU', 'IS', 'IE', 'IT', 'LV',
      'LI', 'LT', 'LU', 'MT', 'NL', 'NO', 'PL', 'PT', 'RO', 'SK', 'SI', 'ES', 'SE', 'GB', 'CH'
    ]
  });
  gtag('consent', 'default', {
    ad_storage: 'granted',
    ad_user_data: 'granted',
    ad_personalization: 'granted',
    analytics_storage: 'granted',
    functionality_storage: 'granted',
    personalization_storage: 'granted',
    security_storage: 'granted',
    wait_for_update: 500
  });
</script>
