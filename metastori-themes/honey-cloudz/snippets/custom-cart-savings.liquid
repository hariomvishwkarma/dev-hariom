{%- comment -%} Custom Cart — savings row with discount code badges {%- endcomment -%}

{%- liquid
  assign show_savings = false
  assign savings_cents = cart.total_discount
  assign seen_discounts = '|'

  if cart.total_discount > 0
    assign show_savings = true
  endif
-%}

{%- if cart.item_count > 0 and show_savings -%}
  <div
    class="custom-cart__savings"
    data-custom-cart-savings
    data-shopify-savings="true"
  >
    <div class="custom-cart__savings-left">
      <span class="custom-cart__savings-label">Savings 🍯</span>
      <div class="custom-cart__savings-badges" data-custom-cart-savings-badges>
        {%- for discount in cart.cart_level_discount_applications -%}
          {%- assign discount_key = '|' | append: discount.title | append: '|' -%}
          {%- unless seen_discounts contains discount_key -%}
            {%- assign seen_discounts = seen_discounts | append: discount.title | append: '|' -%}
            <span class="custom-cart__discount-badge" data-custom-discount-badge>
              {% render 'custom-cart-icons', icon: 'tag' %}
              <span class="custom-cart__discount-badge-text">{{ discount.title | upcase }}</span>
            </span>
          {%- endunless -%}
        {%- endfor -%}

        {%- for item in cart.items -%}
          {%- for discount in item.discounts -%}
            {%- assign discount_key = '|' | append: discount.title | append: '|' -%}
            {%- unless seen_discounts contains discount_key -%}
              {%- assign seen_discounts = seen_discounts | append: discount.title | append: '|' -%}
              <span class="custom-cart__discount-badge" data-custom-discount-badge>
                {% render 'custom-cart-icons', icon: 'tag' %}
                <span class="custom-cart__discount-badge-text">{{ discount.title | upcase }}</span>
              </span>
            {%- endunless -%}
          {%- endfor -%}
        {%- endfor -%}
      </div>
    </div>
    <span class="custom-cart__savings-amount" data-custom-cart-savings-amount>
      &ndash;{{ savings_cents | money }}
    </span>
  </div>
{%- endif -%}
