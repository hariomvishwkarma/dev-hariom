{%- comment -%}
  Renders checkbox list for collection-filter-bar filter_checkbox_menu block.
  Accepts: block, badge_extra_class (optional)
{%- endcomment -%}
{%- assign filter_field_h = block.settings.filter_field | default: 'solution' | handleize -%}
{%- assign opt_raw = block.settings.options | default: '' -%}
{%- assign opt_lines = opt_raw | newline_to_br | split: '<br />' -%}
<ul class="collection-filter-bar__options{% if options_extra_class != blank %} {{ options_extra_class }}{% endif %}" role="list">
  {%- for line in opt_lines -%}
    {%- assign line_stripped = line | strip -%}
    {%- if line_stripped == blank -%}{% continue %}{% endif -%}
    {%- assign parts = line_stripped | split: '|' -%}
    {%- assign opt_label = parts[0] | strip -%}
    {%- assign opt_badge = parts[1] | default: '' | strip -%}
    {%- if opt_label == blank -%}{% continue %}{% endif -%}
    {%- assign opt_value = opt_label | handleize -%}
    {%- assign opt_shape_icon = '' -%}
    {%- if filter_field_h == 'shape' -%}
      {%- if opt_value == 'triangle' -%}
        {%- assign opt_shape_icon = 'shape-triangle' -%}
      {%- elsif opt_value == 'oval' or opt_value == 'ellipse' or opt_value == 'circle' -%}
        {%- assign opt_shape_icon = 'shape-oval' -%}
      {%- elsif opt_value == 'half-moon' or opt_value == 'half_moon' or opt_value == 'halfmoon' -%}
        {%- assign opt_shape_icon = 'shape-half-moon' -%}
      {%- elsif opt_value == 'teardrop' -%}
        {%- assign opt_shape_icon = 'shape-teardrop' -%}
      {%- endif -%}
    {%- endif -%}
    <li class="collection-filter-bar__option">
      <label class="collection-filter-bar__option-label">
        <input
          type="checkbox"
          class="collection-filter-bar__checkbox"
          autocomplete="off"
          value="{{ opt_value | escape }}"
          data-option-label="{{ opt_label | escape }}"
        >
        <span class="collection-filter-bar__option-text">{{ opt_label | escape }}</span>
        {%- if opt_shape_icon != blank -%}
          <span class="collection-filter-bar__option-shape-icon" aria-hidden="true">
            {% render 'icon', icon: opt_shape_icon %}
          </span>
        {%- endif -%}
      </label>
      {%- if opt_badge != blank -%}
        <span class="collection-filter-bar__option-badge{% if badge_extra_class != blank %} {{ badge_extra_class }}{% endif %}">{{ opt_badge | escape }}</span>
      {%- endif -%}
    </li>
  {%- endfor -%}
</ul>
