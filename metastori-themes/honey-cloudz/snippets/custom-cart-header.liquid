{%- comment -%} Custom Cart Header — uses global theme settings {%- endcomment -%}

<header class="custom-cart__header" data-custom-cart-header>
  <div class="custom-cart__header-logo">
    {%- if settings.custom_cart_logo != blank -%}
      <img
        src="{{ settings.custom_cart_logo | image_url: width: 100 }}"
        alt="{{ settings.custom_cart_logo.alt | default: shop.name | escape }}"
        loading="lazy"
        class="custom-cart-logo"
      >
    {%- else -%}
      <span class="custom-cart__header-shop-name">{{ shop.name }}</span>
    {%- endif -%}
  </div>

  <drawer-close-button class="custom-cart__close" aria-label="{{ 'accessibility.close' | t }}">
    <button type="button" class="custom-cart__close-btn">
      {% render 'custom-cart-icons', icon: 'close' %}
      <span class="visually-hidden">{{ 'accessibility.close' | t }}</span>
    </button>
  </drawer-close-button>
</header>
<div class="custom-cart__header-divider" aria-hidden="true"></div>
