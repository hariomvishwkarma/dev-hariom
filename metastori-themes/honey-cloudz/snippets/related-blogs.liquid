<div class="related-blogs ">
  {% if block.settings.heading %}
    <h2 class="related-blogs-title h3 {{ section.settings.text_alignment }} mobile-{{ section.settings.mobile_text_alignment }}">{{ block.settings.heading }}</h2>
  {% endif %}
  {% assign counter = 0 %}
  {% assign skip_articles = article.handle | split: '.....' %}
  <ul class="related-blogs-list left mobile-center">
    {% for tag in article.tags %}
      {% for related_article in blog.articles %}
        {% if related_article.tags contains tag and counter < 3 %}
          {% unless skip_articles contains related_article.handle %}
            {% assign counter = counter | plus: 1 %}
            {% assign temp = related_article.handle | split: '.....' %}
            {% assign skip_articles = skip_articles | concat: temp %}
            <li class="related-blog-item">
              <a href="{{ related_article.url }}" class="related-blog-link" title = "{{ related_article.title }}">
                {% if related_article.image %}
                  <img loading="lazy" src="{{ related_article.image | image_url }}" alt="{{ related_article.title }}" class="related-blog-image">
                {% endif %}
                <div class="related-blog-info">
                  <h5 class="related-blog-title h5">{{ related_article.title }}</h5>
                </div>
              </a>
            </li>
          {% endunless %}
        {% endif %}
      {% endfor %}
    {% endfor %}
  </ul>

  {% if counter == 0 %}
    <p class="no-related-articles">No related articles found.</p>
  {% endif %}
</div>
