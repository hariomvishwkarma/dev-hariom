{%- comment -%} Custom Cart — empty state with style finder + most loved products {%- endcomment -%}

{%- liquid
  assign empty_products = settings.custom_cart_empty_products
  assign has_empty_products = false
  if empty_products != blank and empty_products.size > 0
    assign has_empty_products = true
  endif

  assign style_finder_url = settings.custom_cart_empty_style_finder_url
  if style_finder_url == blank
    assign style_finder_url = '/pages/style-finder'
  endif

  assign style_finder_label = settings.custom_cart_empty_style_finder_label | default: 'Need Help? Use our style finder >>'
  assign empty_heading = settings.custom_cart_empty_heading | default: 'Our Most Loved Cloudz 🧡'
  assign show_recommendations = settings.custom_cart_enable_empty_recommendations
  assign empty_message = settings.custom_cart_empty_message
-%}

<div class="custom-cart__empty-state" data-custom-cart-empty>
    {% if empty_message != blank %}
      <p class="custom-cart__empty-info" role="status">{{ empty_message | escape }}</p>
    {%endif %}
  {%- if style_finder_url != blank -%}
    <a href="{{ style_finder_url }}" class="custom-cart__style-finder">
      {{ style_finder_label | escape }}
    </a>
  {%- endif -%}

  {%- if show_recommendations -%}
    <h2 class="custom-cart__empty-recommendations-heading">{{ empty_heading | escape }}</h2>

    <div class="custom-cart__empty-recommendations" data-custom-empty-recommendations>
      <div
        class="custom-cart__cross-sell-cards{% if has_empty_products %} custom-cart__cross-sell-cards--ready{% endif %}"
        data-custom-empty-recommendations-slot
      >
        {%- if has_empty_products -%}
          {%- for product in empty_products -%}
            {% render 'custom-cart-cross-sell', product: product %}
          {%- endfor -%}
        {%- endif -%}
      </div>
    </div>
  {%- endif -%}
</div>
