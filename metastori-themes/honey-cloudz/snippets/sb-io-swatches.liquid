            optIndex: optIndex
          });
        });
        buckets.forEach(function(bucket, bucketIndex) {
          var first = bucket.items[0];
          var mappedInfo = findGroupInfo(
            first && first.propKey,
            first && first.valuesArr,
            lookup,
            bucketIndex
          );
          // The option's own name/values identify its product exactly; slotProductInfo
          // only guesses from position, so it is the fallback for bundles whose
          // variant_options are missing.
          bucket.info = mappedInfo || slotProductInfo(bucketIndex, buckets.length, lookup.products);
          bucket.displayTitle = displayOptionTitle(
            first && first.propKey,
            bucket.info && bucket.info.title
          );
          if (first && first.expanded && first.expanded.productName && isGenericOptionName(bucket.displayTitle)) {
            bucket.displayTitle = first.expanded.productName;
          }
          var children = parseMap('sb-child-products-' + productId);
          var handle = bucket.info && bucket.info.handle;
          var child = handle ? children[handle] : null;
          var customName = (bucket.dropdownTitle || '').trim();
          if (customName && isGenericOptionName(customName)) customName = '';
          var productTitle = customName || (child && child.title) || bucket.displayTitle;
          var itemLabel = formatItemLabel(bucketIndex, productTitle, child && child.type, container, child && child.tags);
          var sizeGuideLabel = container.getAttribute('data-size-guide-label') || 'Size Guide';
          var showSizeGuide = sizeGuideEnabledForIndex(bucketIndex, container);
          groupsContainer.insertAdjacentHTML('beforeend', stripHtml(itemLabel, shapingLabel, sizeGuideLabel));
          var strips = groupsContainer.querySelectorAll('[data-sb-io-strip]');
          var strip = strips[strips.length - 1];
          var body = strip.querySelector('[data-sb-io-strip-body]');
          var sizeGuidePlaced = false;
          function sizeGuideRowOpts(kind) {
            if (sizeGuidePlaced || !showSizeGuide) return {};
            if (kind !== 'size' && kind !== 'combo') return {};
            sizeGuidePlaced = true;
            return { sizeGuideLabel: sizeGuideLabel };
          }
          var combine = combineSizeColorEnabled(container);
          var sizeItem = null;
          var colorItem = null;
          if (combine && !bucket.items.some(function(it) { return it.expanded; })) {
            bucket.items.forEach(function(item) {
              var k = optionKind(item.propKey, item.valuesArr);
              if (k === 'size' && !sizeItem) sizeItem = item;
              if (k === 'color' && !colorItem) colorItem = item;
            });
          }
          bucket.items.forEach(function(item) {
            if (combine && item.expanded) {
              body.insertAdjacentHTML('beforeend',
                optionRowHtml(bucket.displayTitle, 'combo', item.valuesArr, '', sizeGuideRowOpts('combo')) +
                '<input type="hidden" name="properties[' + escapeHtml(item.propKey) + ']" value="' + escapeHtml(optionStartValue(item.valuesArr, container)) + '" data-sb-io-prop="true" />'
              );
              return;
            }
            if (item.expanded) {
              var comboId = 'combo-' + item.optIndex;
              var wrap = document.createElement('div');
              wrap.setAttribute('data-sb-io-combo', comboId);
              wrap.setAttribute('data-sb-io-product-name', item.expanded.productName || bucket.displayTitle);
              wrap.setAttribute('data-original-values', JSON.stringify(item.valuesArr));
              item.expanded.axes.forEach(function(axis) {
                wrap.insertAdjacentHTML('beforeend', optionRowHtml(
                  bucket.displayTitle,
                  axis.kind,
                  axis.values,
                  'data-sb-io-combo-id="' + comboId + '" data-axis-index="' + axis.axisIndex + '"',
                  sizeGuideRowOpts(axis.kind)
                ));
              });
              wrap.insertAdjacentHTML('beforeend',
                '<input type="hidden" name="properties[' + escapeHtml(item.propKey) + ']" value="' + escapeHtml(optionStartValue(item.valuesArr, container)) + '" data-sb-io-prop="true" data-sb-io-combo-input="' + comboId + '" />'
              );
              body.appendChild(wrap);
              return;
            }
            if (combine && sizeItem && colorItem && (item === sizeItem || item === colorItem)) {
              if (item !== sizeItem) return;
              var pairs = [];
              sizeItem.valuesArr.forEach(function(sizeVal) {
                colorItem.valuesArr.forEach(function(colorVal) {
                  pairs.push(String(sizeVal).trim() + ' / ' + String(colorVal).trim());
                });
              });
              var merged = document.createElement('div');
              merged.setAttribute('data-sb-io-merged', '');
              merged.insertAdjacentHTML('beforeend', optionRowHtml(bucket.displayTitle, 'combo', pairs, '', sizeGuideRowOpts('combo')));
              merged.insertAdjacentHTML('beforeend',
                '<input type="hidden" name="properties[' + escapeHtml(sizeItem.propKey) + ']" value="' + escapeHtml(optionStartValue(sizeItem.valuesArr, container)) + '" data-sb-io-prop="true" data-sb-io-merged-size />' +
                '<input type="hidden" name="properties[' + escapeHtml(colorItem.propKey) + ']" value="' + escapeHtml(optionStartValue(colorItem.valuesArr, container)) + '" data-sb-io-prop="true" data-sb-io-merged-color />'
              );
              body.appendChild(merged);
              return;
            }
            var kind = optionKind(item.propKey, item.valuesArr);
            body.insertAdjacentHTML('beforeend',
              optionRowHtml(bucket.displayTitle, kind, item.valuesArr, '', sizeGuideRowOpts(kind)) +
              '<input type="hidden" name="properties[' + escapeHtml(item.propKey) + ']" value="' + escapeHtml(optionStartValue(item.valuesArr, container)) + '" data-sb-io-prop="true" />'
            );
          });
          strip.setAttribute('data-sb-fallback-title', bucket.displayTitle || '');
          if (customName) strip.setAttribute('data-sb-custom-title', customName);
          strip.setAttribute('data-strip-index', String(bucketIndex));
          if (bucket.info && bucket.info.handle) strip.setAttribute('data-child-handle', bucket.info.handle);
          var fallbackGuideRow = strip.querySelector('[data-sb-io-size-guide-row]');
          if (fallbackGuideRow && sizeGuidePlaced) fallbackGuideRow.hidden = true;
        });
        initSwatches(container, swatchMap, lookup);
        bindColorDropdowns(container, swatchMap);
        groupsContainer.querySelectorAll('[data-sb-io-strip]').forEach(function(strip, stripIndex) {
          var handle = strip.getAttribute('data-child-handle');
          var info = handle ? { handle: handle } : null;
          applyStripInfo(strip, info, strip.getAttribute('data-sb-fallback-title') || '', swatchMap, stripIndex);
        });
        applySharedShaping(container, buckets);
        updateBundleSelection(container);
        dispatchAtcPrice(container);
        bindSizeGuides(container);
      }
      function closeColorDropdowns(root, except) {
        (root || document).querySelectorAll('[data-sb-io-dd]').forEach(function(dd) {
          if (except && dd === except) return;
          dd.classList.remove('is-open');
          var trigger = dd.querySelector('[data-sb-io-dd-trigger]');
          var list = dd.querySelector('[data-sb-io-dd-list]');
          if (trigger) trigger.setAttribute('aria-expanded', 'false');
          if (list) list.hidden = true;
        });
      }
      function bindColorDropdowns(container, swatchMap) {
        container.querySelectorAll('[data-sb-io-dd]').forEach(function(dd) {
          var trigger = dd.querySelector('[data-sb-io-dd-trigger]');
          var list = dd.querySelector('[data-sb-io-dd-list]');
          var group = dd.closest('[data-sb-io-group]');
          if (!trigger || !list) return;
          trigger.addEventListener('click', function(e) {
            e.preventDefault();
            var open = dd.classList.contains('is-open');
            closeColorDropdowns(container);
            if (!open) {
              dd.classList.add('is-open');
              trigger.setAttribute('aria-expanded', 'true');
              list.hidden = false;
            }
          });
          list.querySelectorAll('[data-sb-io-dd-option]').forEach(function(btn) {
            btn.addEventListener('click', function(e) {
              e.preventDefault();
              if (
                btn.disabled ||
                btn.classList.contains('is-disabled') ||
                btn.classList.contains('is-sold-out') ||
                btn.getAttribute('aria-disabled') === 'true' ||
                btn.getAttribute('data-availability') === 'sold-out' ||
                btn.getAttribute('data-availability') === 'unavailable'
              ) {
                return;
              }
              var select = dd.querySelector('[data-sb-io-select]');
              var val = btn.getAttribute('data-option-value') || '';
              if (select) {
                select.value = val;
                select.dispatchEvent(new Event('change', { bubbles: true }));
              }
              syncColorDropdownUi(group, swatchMap);
              closeColorDropdowns(container);
            });
          });
        });
        if (!window.__sbIoDdDocBound) {
          document.addEventListener('click', function(e) {
            if (e.target.closest('[data-sb-io-dd]')) return;
            closeColorDropdowns(document);
          });
          document.addEventListener('keydown', function(e) {
            if (e.key === 'Escape') closeColorDropdowns(document);
          });
          window.__sbIoDdDocBound = true;
        }
      }
      function initSwatches(container, swatchMap, lookup) {
        lookup = lookup || { byOptionName: {}, byValue: {}, byHandle: {} };
        container.querySelectorAll('[data-sb-io-combo]').forEach(function(wrap) {
          var comboId = wrap.getAttribute('data-sb-io-combo');
          var hidden = wrap.querySelector('[data-sb-io-combo-input="' + comboId + '"]');
          var productName = wrap.getAttribute('data-sb-io-product-name') || '';
          var axisGroups = wrap.querySelectorAll('[data-sb-io-group]');
          if (!hidden || !axisGroups.length) return;
          var originalValues = [];
          if (hidden.value) originalValues.push(hidden.value);
          axisGroups.forEach(function(group) {
            var select = group.querySelector('[data-sb-io-select]');
            var swatches = group.querySelectorAll('[data-sb-io-swatch]');
            var values = [];
            if (select) {
              Array.prototype.forEach.call(select.options, function(option) {
                if (option.value) values.push(option.value);
              });
            } else {
              swatches.forEach(function(btn) { values.push(btn.getAttribute('data-option-value') || ''); });
            }
            var kind = group.getAttribute('data-option-kind') || optionKind('', values);
            var prefixEl = group.querySelector('[data-sb-io-label-prefix]');
            var selectedLabel = group.querySelector('[data-sb-io-selected-label]');
            if (prefixEl) prefixEl.textContent = optionLabelPrefix(kind);
            styleSwatches(swatches, kind, swatchMap);
            styleColorDropdown(group, swatchMap);
            if (select) {
              if (select.value && selectedLabel) selectedLabel.textContent = select.value;
              else if (selectedLabel) selectedLabel.textContent = placeholderForGroup(group);
              select.addEventListener('change', function() {
                syncColorDropdownUi(group, swatchMap);
                if (selectedLabel) selectedLabel.textContent = select.value || placeholderForGroup(group);
                syncCombinedValue();
                updateStripAvailability(wrap.closest('[data-sb-io-strip]'));
              });
            } else if (swatches.length) {
              if (preselectEnabled(container) && swatches[0]) {
                swatches[0].checked = true;
                if (selectedLabel) selectedLabel.textContent = swatches[0].getAttribute('data-option-value') || '';
              }
              swatches.forEach(function(input) {
                input.addEventListener('change', function() {
                  if (!input.checked) return;
                  if (selectedLabel) selectedLabel.textContent = input.getAttribute('data-option-value') || placeholderForGroup(group);
                  syncCombinedValue();
                  updateStripAvailability(wrap.closest('[data-sb-io-strip]'));
                });
              });
            }
          });
          function currentParts() {
            var parts = [];
            axisGroups.forEach(function(group) {
              parts.push(groupSelectedValue(group));
            });
            return parts;
          }
          function syncCombinedValue() {
            var originalValues = [];
            try { originalValues = JSON.parse(wrap.getAttribute('data-original-values') || '[]'); } catch (e) {}
            if (!originalValues.length) originalValues = [hidden.value];
            var parts = currentParts();
            if (parts.some(function(p) { return !p; })) {
              hidden.value = '';
            } else {
              hidden.value = matchOriginalValue(originalValues, parts, productName);
            }
            updateBundleSelection(container);
          }
          syncCombinedValue();
        });
        container.querySelectorAll('[data-sb-io-merged]').forEach(function(wrap) {
          var group = wrap.querySelector('[data-sb-io-group]');
          var select = wrap.querySelector('[data-sb-io-select]');
          var sizeHidden = wrap.querySelector('[data-sb-io-merged-size]');
          var colorHidden = wrap.querySelector('[data-sb-io-merged-color]');
          if (!group || !select) return;
          styleColorDropdown(group, swatchMap);
          function applyMerged(val) {
            var parts = optionTailFromCombined(val).split('/').map(function(s) { return s.trim(); });
            if (sizeHidden) sizeHidden.value = val ? (parts[0] || '') : '';
            if (colorHidden) colorHidden.value = val ? (parts[1] || '') : '';
            var selectedLabel = group.querySelector('[data-sb-io-selected-label]');
            if (selectedLabel) selectedLabel.textContent = val || placeholderForGroup(group);
            syncColorDropdownUi(group, swatchMap);
            updateBundleSelection(container);
          }
          if (select.value) applyMerged(select.value);
          select.addEventListener('change', function() {
            applyMerged(select.value);
            updateStripAvailability(wrap.closest('[data-sb-io-strip]'));
          });
        });
        container.querySelectorAll('[data-sb-io-group]:not([data-sb-io-combo-id])').forEach(function(group) {
          if (group.closest('[data-sb-io-merged]')) return;
          var hidden = group.nextElementSibling;
          if (!hidden || !hidden.matches('input[data-sb-io-prop="true"]')) {
            hidden = group.querySelector('input[data-sb-io-prop="true"]');
          }
          var select = group.querySelector('[data-sb-io-select]');
          var swatches = group.querySelectorAll('[data-sb-io-swatch]');
          var selectedLabel = group.querySelector('[data-sb-io-selected-label]');
          var prefixEl = group.querySelector('[data-sb-io-label-prefix]');
          if (!hidden) return;
          var kind = group.getAttribute('data-option-kind') || 'color';
          if (prefixEl) prefixEl.textContent = optionLabelPrefix(kind);
          if (select) {
            styleColorDropdown(group, swatchMap);
            function setSelect(val) {
              hidden.value = val || '';
              if (selectedLabel) selectedLabel.textContent = val || placeholderForGroup(group);
              syncColorDropdownUi(group, swatchMap);
              setTimeout(function() { updateBundleSelection(container); }, 10);
            }
            if (select.value) setSelect(select.value);
            else {
              hidden.value = '';
              syncColorDropdownUi(group, swatchMap);
            }
            select.addEventListener('change', function() {
              setSelect(select.value);
              updateStripAvailability(group.closest('[data-sb-io-strip]'));
            });
            return;
          }
          if (!swatches.length) return;
          var values = [];
          swatches.forEach(function(btn) { values.push(btn.getAttribute('data-option-value') || ''); });
          var propKey = (swatches[0] && swatches[0].getAttribute('data-prop-key')) || '';
          kind = group.getAttribute('data-option-kind') || optionKind(propKey, values);
          if (prefixEl) prefixEl.textContent = optionLabelPrefix(kind);
          styleSwatches(swatches, kind, swatchMap);
          function setActive(input) {
            swatches.forEach(function(el) { el.checked = false; });
            input.checked = true;
            var val = input.getAttribute('data-option-value') || '';
            hidden.value = val;
            if (selectedLabel) selectedLabel.textContent = val;
            setTimeout(function() { updateBundleSelection(container); }, 10);
          }
          hidden.value = '';
          var checked = group.querySelector('[data-sb-io-swatch]:checked');
          if (checked) setActive(checked);
          swatches.forEach(function(input) {
            input.addEventListener('change', function() {
              if (!input.checked) return;
              setActive(input);
              updateStripAvailability(group.closest('[data-sb-io-strip]'));
            });
          });
        });
        syncIoAddButton(container);
      }
      function bindSizeGuides(container) {
        var label = container.getAttribute('data-size-guide-label') || 'Size Guide';
        container.querySelectorAll('[data-sb-io-strip]').forEach(function(strip, stripIndex) {
          var hasFields = !!strip.querySelector('[data-sb-io-group]');
          var enabled = hasFields && sizeGuideEnabledForIndex(stripIndex, container);
          var inlineBtn = strip.querySelector('[data-sb-io-group] [data-sb-io-size-guide]');
          var row = strip.querySelector('[data-sb-io-size-guide-row]');
          if (inlineBtn && row) row.hidden = true;
          var buttons = strip.querySelectorAll('[data-sb-io-size-guide]');
          if (!buttons.length) return;
          buttons.forEach(function(btn) {
            var inFallbackRow = !!(row && row.contains(btn));
            var showBtn = enabled && (!inFallbackRow || !inlineBtn);
            btn.hidden = !showBtn;
            if (!showBtn) return;
            btn.textContent = label;
            btn.addEventListener('click', function() {
              openSizeGuide(container, strip);
            });
          });
        });
      }
      // Build _bundle_selection from all selected options
      function updateBundleSelection(container) {
        var bundleSelectionInput = container.querySelector('[data-sb-io-bundle-selection]');
        if (!bundleSelectionInput) {
          // Try to find in form
          var form = container.closest('form');
          if (form) {
            bundleSelectionInput = form.querySelector('input[name="properties[_bundle_selection]"]');
          }
        }
        
        if (!bundleSelectionInput) {
          // Create it if doesn't exist
          bundleSelectionInput = document.createElement('input');
          bundleSelectionInput.type = 'hidden';
          bundleSelectionInput.name = 'properties[_bundle_selection]';
          bundleSelectionInput.setAttribute('data-sb-io-bundle-selection', 'true');
          container.appendChild(bundleSelectionInput);
        }
        // Gather all selected values
        var values = [];
        container.querySelectorAll('input[data-sb-io-prop="true"]').forEach(function(input) {
          if (input.value) {
            values.push(input.value);
          }
        });
        bundleSelectionInput.value = values.join(' <> ');
        syncIoBundlePrice(container);
      }
      // Main initialization
      function init() {
        var container = document.querySelector('[data-sb-io][data-product-id="' + productId + '"]') || document.querySelector('[data-sb-io]');
        if (!container || container.getAttribute('data-sb-io-ready')) return;
        container.setAttribute('data-sb-io-ready', 'true');
        if (container.getAttribute('data-show-save-badge') === 'false') {
          var sectionEl = container.closest('.shopify-section') || document;
          sectionEl.querySelectorAll('.price__badge-percent').forEach(function(el) {
            el.hidden = true;
          });
        }
        
        var variantOptionsMap = parseMap('sb-variant-options-map-' + productId);
        var swatchMap = parseMap('sb-swatch-map-' + productId);
        themeSwatchMap = parseMap('sb-theme-swatches-' + productId);
        var lastVariantId = null;
        // Refresh swatches for current variant
        function refresh() {
          var variantId = getSelectedVariantId(container);
          if (!variantId) return;
          
          // Only re-render if variant changed
          if (variantId === lastVariantId) return;
          lastVariantId = variantId;
          
          var variantData = variantOptionsMap[variantId];
          
          if (variantData && variantData.options) {
            container.classList.add('sb-io--loading');
            
            // Small delay for visual feedback
            setTimeout(function() {
              renderSwatches(container, variantData.options, variantData.bundled_variants);
              container.classList.remove('sb-io--loading');
            }, 50);
          } else if (Object.keys(variantOptionsMap).length) {
            container.style.display = 'none';
          }
        }
        // Hook into variant changes
        function hookVariantChanges() {
          // 1) Listen for changes on [name="id"] selects/inputs
          document.addEventListener('change', function(e) {
            var t = e.target;
            if (t && (t.matches('[name="id"]') || t.matches('select[name="id"]'))) {
              setTimeout(refresh, 10);
            }
          });
          
          // 2) Watch for [name="id"] value changes via mutation
          var idFields = document.querySelectorAll('[name="id"]');
          idFields.forEach(function(field) {
            var obs = new MutationObserver(function() {
              setTimeout(refresh, 10);
            });
            obs.observe(field, { attributes: true, attributeFilter: ['value'] });
          });
          
          // 3) History API changes (?variant=...)
          var _push = history.pushState;
          var _replace = history.replaceState;
          
          history.pushState = function() {
            var r = _push.apply(this, arguments);
            window.dispatchEvent(new Event('sb:history'));
            return r;
          };
          history.replaceState = function() {
            var r = _replace.apply(this, arguments);
            window.dispatchEvent(new Event('sb:history'));
            return r;
          };
          
          window.addEventListener('popstate', function() { setTimeout(refresh, 10); });
          window.addEventListener('sb:history', function() { setTimeout(refresh, 10); });
          
          // 4) Common theme events
          ['variant:change', 'product:variant-change', 'theme:variant:change', 'shopify:section:load'].forEach(function(ev) {
            document.addEventListener(ev, function() { setTimeout(refresh, 10); });
          });
          
          // 5) Click on variant buttons/swatches (for themes that use buttons instead of selects)
          document.addEventListener('click', function(e) {
            var btn = e.target.closest('[data-variant-id], [data-option-value]:not([data-sb-io-swatch])');
            if (btn) {
              setTimeout(refresh, 100);
              setTimeout(refresh, 300);
            }
          });
        }
        // Initial setup
        var initialVariantId = getSelectedVariantId(container);
        lastVariantId = initialVariantId;
        var initialData = variantOptionsMap[initialVariantId];
        if (initialData && initialData.options) {
          renderSwatches(container, initialData.options, initialData.bundled_variants);
        } else if (container.querySelector('[data-sb-io-swatch]')) {
          initSwatches(container, swatchMap, buildBundleLookup([]));
          updateBundleSelection(container);
        }

        watchNativeBundleInputs(container);
        ensureFormVariantId(container);
        dispatchAtcPrice(container);
        document.addEventListener('variant:change', function() {
          setTimeout(function() { syncIoAddButton(container); }, 30);
        });
        
        // Hook variant changes
        hookVariantChanges();
        
        // Also refresh on late-loading themes
        setTimeout(function() { ensureFormVariantId(container); refresh(); }, 250);
        setTimeout(function() { ensureFormVariantId(container); refresh(); }, 900);
      }
      // Run on DOM ready
      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', init);
      } else {
        init();
      }
    })();
  </script>
