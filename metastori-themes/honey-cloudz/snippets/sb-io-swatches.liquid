{% doc %}
  Simple Bundles infinite-options picker for bundle PDPs.

  @param {object} product - Product object
  @param {object} [io_block] - Buy buttons block (picker, size guide, and label settings)
{% enddoc %}
{% comment %}
  Simple Bundles Infinite Options - Image Swatches via Metaobjects (store-agnostic)
  With dynamic product image thumbnails next to each option group
  WITH VARIANT SWITCHING SUPPORT - swatches update when variant changes
  Metaobject definition type: product-swatches
  Liquid access: shop.metaobjects.product_swatches.values
  We DO NOT rely on metaobject handle (some stores block handle in Liquid).
  Instead, we build a map keyed by normalized swatch name text and match by normalized option value.
  Expected swatch metaobject fields:
  - image (Image/File)  -> actual uploaded swatch image
  - one text field that stores the swatch name (eg "Sugar Rush", "Red Apple Red")
    Common keys: name, title, label, product_image, product_swatches, productSwatches, swatch_name
  Cart:
  - Submits line item properties: properties[optionName] = selected value
  - Submits properties[_bundle_selection] = all selected values joined by " <> "
  Place this snippet INSIDE the product form in the main product section file.
{% endcomment %}

{% comment %} Check if ANY variant has IO options (not just selected variant) {% endcomment %}
{% assign has_any_io = false %}
{% for v in product.variants %}
  {% assign v_io = v.metafields.simple_bundles.variant_options.value %}
  {% if v_io != blank %}
    {% assign first_item = v_io.first %}
    {% if first_item.optionValues != blank and first_item.optionName != blank %}
      {% assign has_any_io = true %}
      {% break %}
    {% endif %}
  {% endif %}
{% endfor %}

{% unless has_any_io %}
  {% assign p_io = product.metafields.simple_bundles.variant_options.value %}
  {% if p_io != blank %}
    {% assign first_item = p_io.first %}
    {% assign io_name = first_item.optionName | default: first_item.option_name %}
    {% assign io_values = first_item.optionValues | default: first_item.option_values %}
    {% if io_name != blank and io_values != blank %}
      {% assign has_any_io = true %}
    {% endif %}
  {% endif %}
{% endunless %}

{% if has_any_io %}
  {% assign sw_list = shop.metaobjects.product_swatches.values %}
  {% if sw_list == blank %}
    {% assign sw_list = shop.metaobjects['product-swatches'].values %}
  {% endif %}

  {%- comment -%}
    Build JSON map: normalized_name -> image_url (for swatches)
    We try multiple possible text field keys for the swatch "name".
    We also support both mo.image and mo.image.value depending on Shopify field behavior.

    NORMALIZATION: We strip apostrophes and quotes in Liquid to match JS normalization.
    This handles cases like "L'heure bleue" -> "lheure bleue"
  {%- endcomment -%}

  <script type="application/json" id="sb-swatch-map-{{ product.id }}">
    {
      {%- assign first = true -%}
      {%- for mo in sw_list -%}
        {%- comment -%} 1) Determine swatch label (text) {%- endcomment -%}
        {%- assign label = '' -%}
        {%- if mo.name != blank -%}{%- assign label = mo.name.value | default: mo.name -%}{%- endif -%}
        {%- if label == blank and mo.title != blank -%}{%- assign label = mo.title.value | default: mo.title -%}{%- endif -%}
        {%- if label == blank and mo.label != blank -%}{%- assign label = mo.label.value | default: mo.label -%}{%- endif -%}
        {%- comment -%}
          Your store mentioned a text field called "product-image".
          Its key in Liquid is usually product_image (underscore), not product-image.
        {%- endcomment -%}
        {%- if label == blank and mo.product_image != blank -%}{%- assign label = mo.product_image.value | default: mo.product_image -%}{%- endif -%}
        {%- if label == blank and mo.product_swatches != blank -%}{%- assign label = mo.product_swatches.value | default: mo.product_swatches -%}{%- endif -%}
        {%- if label == blank and mo.swatch_name != blank -%}{%- assign label = mo.swatch_name.value | default: mo.swatch_name -%}{%- endif -%}
        {%- assign label = label | strip -%}

        {%- comment -%} NORMALIZE the label: lowercase + remove apostrophes/quotes {%- endcomment -%}
        {%- assign label_normalized = label | downcase | replace: "'", "" | replace: "'", "" | replace: "'", "" | replace: "`", "" | replace: '"', "" | replace: '"', "" | replace: '"', "" -%}
        {%- comment -%} 2) Determine image object/value {%- endcomment -%}
        {%- assign img_obj = mo.image.value | default: mo.image -%}
        {%- comment -%} 3) Build entry if we have both label + image {%- endcomment -%}
        {%- if label != blank and img_obj != blank -%}
          {%- unless first -%},{%- endunless -%}
          {%- assign first = false -%}
          "{{ label_normalized | escape }}": "{{ img_obj | image_url: width: 120 }}"
        {%- endif -%}
      {%- endfor -%}
    }
  </script>
  {%- comment -%}
    Build JSON map for ALL variants: variant_id -> { options: [...], bundled_variants: [...] }
    This enables dynamic switching when customer changes variants
  {%- endcomment -%}
  <script type="application/json" id="sb-variant-options-map-{{ product.id }}">
    {
      {%- assign first_v = true -%}
      {%- for v in product.variants -%}
        {%- assign v_io = v.metafields.simple_bundles.variant_options.value -%}
        {%- assign v_bv = v.metafields.simple_bundles.bundled_variants.value -%}
        {%- if v_io != blank -%}
          {%- unless first_v -%},{%- endunless -%}
          {%- assign first_v = false -%}
          "{{ v.id }}": {
            "options": {{ v_io | json }},
            "bundled_variants": {{ v_bv | default: "[]" | json }}
          }
        {%- endif -%}
      {%- endfor -%}
    }
  </script>
  {%- comment -%}
    Prices of the bundle (parent) variants. Simple Bundles submits the parent variant
    plus line item properties, so Shopify charges the parent variant price whatever
    component sizes/colours are picked. The PDP price has to come from here.
  {%- endcomment -%}
  <script type="application/json" id="sb-parent-prices-{{ product.id }}">
    {
      {%- for v in product.variants -%}
        {%- unless forloop.first -%},{%- endunless -%}
        "{{ v.id }}": {
          "price": {{ v.price | default: 0 | plus: 0 | json }},
          "compare": {{ v.compare_at_price | default: 0 | plus: 0 | json }}
        }
      {%- endfor -%}
    }
  </script>
  <script type="application/json" id="sb-theme-swatches-{{ product.id }}">
    {
      {%- assign sb_swatch_first = true -%}
      {%- assign sb_swatch_seen = ',' -%}
      {%- for v in product.variants -%}
        {%- assign v_bv = v.metafields.simple_bundles.bundled_variants.value -%}
        {%- if v_bv != blank -%}
          {%- for bv in v_bv -%}
            {%- assign h = bv.handle -%}
            {%- if h != blank -%}
              {%- assign child = all_products[h] -%}
              {%- if child != blank -%}
                {%- for option in child.options_with_values -%}
                  {%- assign option_name = option.name | downcase -%}
                  {%- if option_name contains 'color' or option_name contains 'colour' -%}
                    {%- for value in option.values -%}
                      {%- assign color_value = value.name | default: value -%}
                      {%- assign color_value = color_value | strip -%}
                      {%- if color_value != blank -%}
                        {%- assign value_key = color_value | downcase -%}
                        {%- assign value_token = ',' | append: value_key | append: ',' -%}
                        {%- unless sb_swatch_seen contains value_token -%}
                          {%- assign sb_swatch_seen = sb_swatch_seen | append: value_key | append: ',' -%}
                          {%- assign color_file_name = color_value | handle | append: '.png' -%}
                          {%- assign color_image = color_file_name | file_img_url: '50x50' | prepend: 'https:' | split: '?' | first -%}
                          {%- assign color_swatch_fallback = color_value | split: ' ' | last | handle -%}
                          {%- if value.swatch.color != blank -%}
                            {%- assign color_swatch_fallback = value.swatch.color -%}
                          {%- endif -%}
                          {%- assign color_swatch_image = '' -%}
                          {%- if images[color_file_name] != blank -%}
                            {%- assign color_swatch_image = color_image -%}
                          {%- elsif value.swatch.image != blank -%}
                            {%- assign color_swatch_image = value.swatch.image | image_url: width: 50 -%}
                          {%- endif -%}
                          {%- unless sb_swatch_first -%},{%- endunless -%}
                          {%- assign sb_swatch_first = false -%}
                          {{ value_key | json }}: {
                            "fallback": {{ color_swatch_fallback | json }}
                            {%- if color_swatch_image != blank -%}
                            ,"image": {{ color_swatch_image | json }}
                            {%- endif -%}
                          }
                        {%- endunless -%}
                      {%- endif -%}
                    {%- endfor -%}
                  {%- endif -%}
                {%- endfor -%}
              {%- endif -%}
            {%- endif -%}
          {%- endfor -%}
        {%- endif -%}
      {%- endfor -%}
    }
  </script>
  <script type="application/json" id="sb-child-products-{{ product.id }}">
    {
      {%- assign sb_child_first = true -%}
      {%- assign sb_seen = ',' -%}
      {%- for v in product.variants -%}
        {%- assign v_bv = v.metafields.simple_bundles.bundled_variants.value -%}
        {%- if v_bv != blank -%}
          {%- for bv in v_bv -%}
            {%- assign h = bv.handle -%}
            {%- if h != blank -%}
              {%- assign h_token = ',' | append: h | append: ',' -%}
              {%- unless sb_seen contains h_token -%}
                {%- assign sb_seen = sb_seen | append: h | append: ',' -%}
                {%- assign child = all_products[h] -%}
                {%- unless sb_child_first -%},{%- endunless -%}
                {%- assign sb_child_first = false -%}
                {{ h | json }}: {
                  "title": {% if child.title != blank %}{{ child.title | json }}{% else %}{{ bv.product_title | json }}{% endif %},
                  "type": {{ child.type | json }},
                  "tags": {{ child.tags | join: ',' | json }},
                  "image": {% if child.featured_image %}{{ child.featured_image | image_url: width: 200 | json }}{% else %}null{% endif %},
                  {%- assign sb_child_level = child.metafields.custom.shaping_level.value | default: child.metafields.custom.shaping_level -%}
                  {%- assign sb_child_shape = child.metafields.custom.shape.value | default: child.metafields.custom.shape | strip | handleize -%}
                  "shaping_level": {{ sb_child_level | default: 0 | plus: 0 }},
                  "shape": {{ sb_child_shape | json }},
                  {%- capture sb_child_sg -%}
                    {%- if child.metafields.custom.size_chart_description != blank -%}
                      {{ child.metafields.custom.size_chart_description | metafield_tag }}
                    {%- endif -%}
                  {%- endcapture -%}
                  {%- assign sb_child_sg_img = child.metafields.custom.size_information.value | default: child.metafields.custom.size_information -%}
                  "size_guide_html": {{ sb_child_sg | strip | json }},
                  "size_guide_image": {% if sb_child_sg_img.src != blank %}{{ sb_child_sg_img | image_url: width: 1600 | json }}{% else %}null{% endif %}
                }
              {%- endunless -%}
            {%- endif -%}
          {%- endfor -%}
        {%- endif -%}
      {%- endfor -%}
    }
  </script>

  {%- assign sb_picker_type = 'dropdown' -%}
  {%- assign sb_item_label = 'auto' -%}
  {%- assign sb_show_shaping = true -%}
  {%- assign sb_shaping_placement = 'each_item' -%}
  {%- assign sb_show_size_guide = true -%}
  {%- assign sb_color_swatches = true -%}
  {%- assign sb_option_default = 'unselected' -%}
  {%- assign sb_combine_size_color = false -%}
  {%- assign sb_sg_1 = true -%}
  {%- assign sb_sg_2 = true -%}
  {%- assign sb_sg_3 = true -%}
  {%- assign sb_sg_4 = true -%}
  {%- assign sb_show_save_badge = true -%}
  {%- assign sb_sg_page = false -%}
  {%- if io_block -%}
    {%- if io_block.settings.bundle_picker_type != blank -%}
      {%- assign sb_picker_type = io_block.settings.bundle_picker_type -%}
    {%- endif -%}
    {%- if io_block.settings.bundle_item_label != blank -%}
      {%- assign sb_item_label = io_block.settings.bundle_item_label -%}
    {%- endif -%}
    {%- if io_block.settings.bundle_show_shaping == false -%}
      {%- assign sb_show_shaping = false -%}
    {%- endif -%}
    {%- if io_block.settings.bundle_shaping_placement != blank -%}
      {%- assign sb_shaping_placement = io_block.settings.bundle_shaping_placement -%}
    {%- endif -%}
    {%- if io_block.settings.bundle_show_size_guide == false -%}
      {%- assign sb_show_size_guide = false -%}
    {%- endif -%}
    {%- if io_block.settings.bundle_enable_color_swatches == false -%}
      {%- assign sb_color_swatches = false -%}
    {%- endif -%}
    {%- if io_block.settings.bundle_option_default != blank -%}
      {%- assign sb_option_default = io_block.settings.bundle_option_default -%}
    {%- endif -%}
    {%- if io_block.settings.bundle_combine_size_color == true -%}
      {%- assign sb_combine_size_color = true -%}
    {%- endif -%}
    {%- if io_block.settings.bundle_size_guide_1 == false -%}
      {%- assign sb_sg_1 = false -%}
    {%- endif -%}
    {%- if io_block.settings.bundle_size_guide_2 == false -%}
      {%- assign sb_sg_2 = false -%}
    {%- endif -%}
    {%- if io_block.settings.bundle_size_guide_3 == false -%}
      {%- assign sb_sg_3 = false -%}
    {%- endif -%}
    {%- if io_block.settings.bundle_size_guide_4 == false -%}
      {%- assign sb_sg_4 = false -%}
    {%- endif -%}
    {%- if io_block.settings.bundle_show_save_badge == false -%}
      {%- assign sb_show_save_badge = false -%}
    {%- endif -%}
    {%- if io_block.settings.bundle_size_chart != blank -%}
      {%- assign sb_sg_page = io_block.settings.bundle_size_chart -%}
    {%- endif -%}
    {%- if sb_show_save_badge -%}
      {%- if io_block.settings.bundle_save_badge_background != blank or io_block.settings.bundle_save_badge_text != blank -%}
        {% style %}
          #shopify-section-{{ section.id }} .price__badge-percent {
            {%- if io_block.settings.bundle_save_badge_background != blank -%}
              background-color: {{ io_block.settings.bundle_save_badge_background }};
              border-color: {{ io_block.settings.bundle_save_badge_background }};
            {%- endif -%}
            {%- if io_block.settings.bundle_save_badge_text != blank -%}
              color: {{ io_block.settings.bundle_save_badge_text }};
            {%- endif -%}
          }
        {% endstyle %}
      {%- endif -%}
    {%- endif -%}
  {%- endif -%}
  <script type="application/json" id="sb-size-guide-fallback-{{ product.id }}">
    {
      "title": {% if sb_sg_page != false and sb_sg_page != blank %}{{ sb_sg_page.title | json }}{% else %}{{ 'products.product.size_chart' | t | json }}{% endif %},
      "html": {% if sb_sg_page != false and sb_sg_page != blank %}{{ sb_sg_page.content | json }}{% else %}""{% endif %}
    }
  </script>
  <div
    class="sb-io product-form__input"
    data-sb-io
    data-product-id="{{ product.id }}"
    data-initial-variant-id="{{ product.selected_or_first_available_variant.id }}"
    data-has-only-default-variant="{{ product.has_only_default_variant }}"
    data-shaping-label="{{ 'products.product.shaping_level_label' | t | escape }}"
    data-allow-sold-out="{{ settings.allow_sold_out_variant_selection }}"
    data-atc-price="{{ product.selected_or_first_available_variant.price }}"
    data-atc-compare="{{ product.selected_or_first_available_variant.compare_at_price | default: 0 }}"
    data-atc-base-price="{{ product.selected_or_first_available_variant.price }}"
    data-atc-base-compare="{{ product.selected_or_first_available_variant.compare_at_price | default: 0 }}"
    data-picker-type="{{ sb_picker_type | escape }}"
    data-item-label="{{ sb_item_label | escape }}"
    data-show-shaping="{{ sb_show_shaping }}"
    data-shaping-placement="{{ sb_shaping_placement | escape }}"
    data-show-size-guide="{{ sb_show_size_guide }}"
    data-show-save-badge="{{ sb_show_save_badge }}"
    data-enable-color-swatches="{{ sb_color_swatches }}"
    data-option-default="{{ sb_option_default | escape }}"
    data-combine-size-color="{{ sb_combine_size_color }}"
    data-size-color-label="{{ 'products.product.bundle_size_color_label' | t | escape }}"
    data-size-guide-items="{{ sb_sg_1 }},{{ sb_sg_2 }},{{ sb_sg_3 }},{{ sb_sg_4 }}"
    data-pair-label="{{ 'products.product.bundle_pair_label' | t | escape }}"
    data-breast-form-label="{{ 'products.product.bundle_breast_form_label' | t | escape }}"
    data-size-guide-label="{{ 'products.product.size_chart' | t | escape }}"
    data-size-guide-title-template="{{ 'products.product.bundle_size_guide_title' | t: product_name: 'PRODUCT_NAME' | escape }}"
    data-size-guide-missing="{{ 'products.product.bundle_size_guide_missing' | t | escape }}"
    data-choose-label="{{ 'products.product.bundle_choose_options' | t | escape }}"
    data-choose-one="{{ 'products.product.bundle_choose_one' | t | escape }}"
    data-select-size="{{ 'products.product.bundle_select_size' | t | escape }}"
    data-select-color="{{ 'products.product.bundle_select_color' | t | escape }}"
    data-sold-out-label="{{ 'products.product.sold_out' | t | downcase | escape }}"
    data-percent-off-template="{{ 'products.product.percent_off' | t: percent: 'SB_PCT' | escape }}"
    data-size-guide-modal="SbIoSizeGuide-{{ product.id }}"
  >
    <style>
      .sb-io {
        display: block;
        margin: 0rem 0 1.2rem;
        width: 100%;
        min-width: 0;
      }
      .sb-io:not(:has(.sb-io__shared-shaping:not([hidden]))) .sb-io__groups {
        margin-top: 20px;
      }
      .sb-io__strip {
        display: flex;
        align-items: flex-start;
        gap: 8px;
        margin: 0 0 1rem;
        padding-bottom: 0.6rem;
        border-bottom: 1px solid rgba(0, 0, 0, 0.08);
      }
      .sb-io__strip:last-child {
        margin-bottom: 0;
        padding-bottom: 0;
        border-bottom: 0;
      }
      .sb-io__product-thumb {
        position: relative;
        width: 48px;
        height: 48px;
        min-width: 48px;
        border: 1px solid rgba(0, 0, 0, 0.08);
        border-radius: 6px;
        overflow: hidden;
        background: #f7f7f7;
      }
      .sb-io__product-thumb img {
        width: 100%;
        height: 100%;
        object-fit: cover;
      }
      .sb-io__product-thumb img:not([src]) {
        opacity: 0;
      }
      .sb-io__thumb-shape {
        position: absolute;
        bottom: 4%;
        left: 6%;
        z-index: 2;
        width: 11px;
        max-width: 20%;
        line-height: 0;
        pointer-events: none;
      }
      .sb-io__thumb-shape[hidden] {
        display: none !important;
      }
      .sb-io__thumb-shape svg {
        display: block;
        width: 100%;
        height: auto;
      }
      .sb-io__strip-meta {
        flex: 1;
        min-width: 0;
        display: flex;
        flex-direction: column;
        align-items: stretch;
        gap: 4px;
      }
      .sb-io__title {
        font-weight: 700;
        margin: 0;
        font-size: 11px;
        line-height: 1.25;
        text-transform: uppercase;
        letter-spacing: 0.02em;
      }
      .sb-io__strip-body {
        min-width: 0;
        display: flex;
        flex-direction: column;
        gap: 0.5rem;
      }
      .sb-io__shared-shaping {
        margin: 0 0 2.2rem;
      }
      .aiod-widget-container.aiod-widget-container-page:empty {
        display: none !important;
      }
      .sb-io__shared-shaping[hidden] {
        display: none !important;
      }
      .sb-io__shared-shaping .sb-io__shaping-bar {
        width: 100%;
        max-width: 100%;
      }
      .sb-io__size-guide-row {
        display: flex;
        justify-content: flex-end;
        width: 80%;
        max-width: 80%;
        margin: 0.1rem 0 0;
      }
      .sb-io__size-guide-row[hidden] {
        display: none !important;
      }
      .sb-io__size-guide-row .variant-picker__text-link,
      .sb-io__selected-label .variant-picker__text-link {
        padding: 0;
        margin: 0;
        font-size: 1rem;
        line-height: 1.3;
        white-space: nowrap;
        flex-shrink: 0;
      }
      #SbIoSizeGuide-{{ product.id }} .product-popup-modal__content {
        text-align: center;
      }
      #SbIoSizeGuide-{{ product.id }} [data-sb-io-size-guide-title] {
        text-align: center;
      }
      .sb-io__shaping-bar {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 6px;
        width: 80%;
        max-width: 80%;
        min-width: 0;
        box-sizing: border-box;
        margin: 0;
        padding: 0.25rem 0.7rem;
        background: #f473b7;
        color: #fff;
        border: 0;
        border-radius: 7px;
        font-family: inherit;
        font-size: 1.05rem;
        font-weight: 600;
        line-height: 1;
        min-height: 0;
        height: auto;
        text-align: left;
        cursor: pointer;
        appearance: none;
        -webkit-appearance: none;
      }
      .sb-io__shaping-bar:focus-visible {
        outline: 2px solid #ffffff;
        outline-offset: 2px;
      }
      .sb-io__shaping-bar[hidden] {
        display: none !important;
      }
      .sb-io__shaping-label {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        min-width: 0;
        font-size: 1.05rem;
        font-weight: 600;
        letter-spacing: 0;
        line-height: 1;
        white-space: nowrap;
      }
      .sb-io__shaping-icon {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 13px;
        height: 13px;
        flex-shrink: 0;
      }
      .sb-io__shaping-icon svg {
        width: 13px;
        height: 13px;
        display: block;
      }
      .sb-io__shaping-squares {
        display: flex;
        align-items: center;
        flex-shrink: 0;
        gap: 4px;
      }
      .sb-io__shaping-square {
        width: 9px;
        height: 15px;
        border-radius: 2px;
        background: transparent;
        border: 1px solid #fff;
      }
      .sb-io__shaping-square.is-active {
        background: #fff;
      }
      .sb-io__shared-shaping .sb-io__shaping-bar,
      .product__shaping-slot .sb-io__shaping-bar,
      .product__bundle-shaping .sb-io__shaping-bar {
        width: 100%;
        max-width: 100%;
        margin: 0;
        padding: 0.65rem 1.2rem;
        border-radius: 10px;
        font-size: 1.3rem;
        line-height: 1;
        min-height: 0;
        height: auto;
        justify-content: space-between;
        gap: 1rem;
      }
      .sb-io__shared-shaping .sb-io__shaping-label,
      .product__shaping-slot .sb-io__shaping-label,
      .product__bundle-shaping .sb-io__shaping-label {
        font-size: 1.3rem;
        gap: 0.6rem;
        letter-spacing: 0;
        line-height: 1;
