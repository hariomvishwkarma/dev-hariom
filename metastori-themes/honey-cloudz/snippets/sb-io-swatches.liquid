      /**
       * Normalize string for matching: lowercase, strip price suffixes, 
       * remove ALL apostrophe/quote variants (straight, curly, backtick).
       * This matches the Liquid-side normalization applied to metaobject keys.
       */
      function norm(str) {
        return String(str || "").trim().toLowerCase()
          // Remove price suffix like "(+CA$5.00)" or "(+$5.00)"
          .replace(/\s*\([^)]*\)\s*$/, '')
          // Remove ALL apostrophe and quote variants:
          // ' (straight apostrophe U+0027)
          // ' (right single quote U+2019)
          // ' (left single quote U+2018)
          // ` (backtick U+0060)
          // " (straight double quote U+0022)
          // " (left double quote U+201C)
          // " (right double quote U+201D)
          .replace(/['''`""\u2018\u2019\u201C\u201D]/g, '')
          .trim();
      }
      function escapeHtml(str) {
