{%- comment -%}
  Shaping level info popup shared by product cards and PDP.
  Rendered once per page; triggers are any [data-shaping-info] control (the full strip).
  Content comes from Theme settings > Shaping level popup.
{%- endcomment -%}

{%- liquid
  assign shaping_popup_title = settings.shaping_popup_title
  assign shaping_popup_content = settings.shaping_popup_content
  assign shaping_popup_close_label = settings.shaping_popup_close_label | default: 'Close'
  assign shaping_popup_background = settings.shaping_popup_background | default: '#ffffff'
  assign shaping_popup_text_color = settings.shaping_popup_text_color | default: '#212326'
  assign shaping_popup_radius = settings.shaping_popup_border_radius | default: 20
  assign shaping_popup_title_size = settings.shaping_popup_title_size | default: 26
  assign shaping_popup_content_size = settings.shaping_popup_content_size | default: 16
-%}

{%- style -%}
  .card-info__shaping-info {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    align-self: center;
    width: 16px;
    height: 16px;
    min-width: 16px;
    min-height: 16px;
    max-width: 16px;
    max-height: 16px;
    margin: 0;
    padding: 0;
    border: 0;
    background: transparent;
    color: inherit;
    line-height: 0;
    flex-shrink: 0;
    vertical-align: middle;
    pointer-events: none;
  }

  .card-info__shaping-info svg {
    width: 100%;
    height: 100%;
    display: block;
    flex-shrink: 0;
  }

  #ShapingInfoPopup {
    position: fixed;
    top: 0;
    right: 0;
    bottom: 0;
    left: 0;
    z-index: 10001;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 1.5rem;
    background: rgba(33, 35, 38, 0.55);
    cursor: url({{ 'cross.svg' | asset_url }}), zoom-out;
  }

  #ShapingInfoPopup[hidden] {
    display: none !important;
  }

  #ShapingInfoPopup .shaping-info-popup__backdrop {
    position: absolute;
    inset: 0;
    z-index: 0;
    cursor: url({{ 'cross.svg' | asset_url }}), zoom-out;
  }

  #ShapingInfoPopup .shaping-info-popup__dialog {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    width: min(100%, 82rem);
    max-height: min(85vh, 520px);
    overflow: hidden;
    margin: auto;
    padding: 0;
    background: {{ shaping_popup_background }};
    color: {{ shaping_popup_text_color }};
    border-radius: {{ shaping_popup_radius }}px;
    box-shadow: 0 18px 48px rgba(33, 35, 38, 0.18);
    cursor: auto;
  }

  #ShapingInfoPopup .shaping-info-popup__header {
    position: relative;
    flex-shrink: 0;
    padding: 2.4rem 4.5rem 1.2rem 2rem;
  }

  #ShapingInfoPopup .shaping-info-popup__body {
    flex: 1 1 auto;
    min-height: 0;
    overflow-y: auto;
    padding: 0 2rem 2rem;
  }

  #ShapingInfoPopup .shaping-info-popup__title {
    margin: 0;
    font-size: {{ shaping_popup_title_size }}px;
    font-weight: 700;
    line-height: 1.2;
    color: {{ shaping_popup_text_color }};
    text-align: left;
  }

  #ShapingInfoPopup .shaping-info-popup__content {
    font-size: {{ shaping_popup_content_size }}px;
    line-height: 1.55;
    text-align: left;
  }

  #ShapingInfoPopup .shaping-info-popup__content p {
    margin: 0 0 1rem;
  }

  #ShapingInfoPopup .shaping-info-popup__content p:last-child {
    margin-bottom: 0;
  }

  #ShapingInfoPopup .shaping-info-popup__content ul {
    margin: 0;
    padding-left: 1.25rem;
  }

  #ShapingInfoPopup .shaping-info-popup__content li + li {
    margin-top: 0.35rem;
  }

  #ShapingInfoPopup .shaping-info-popup__close {
    position: absolute;
    top: 1rem;
    right: 1rem;
    z-index: 2;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.4rem;
    height: 2.4rem;
    margin: 0;
    padding: 0;
    border: 0;
    background: {{ shaping_popup_background }};
    color: {{ shaping_popup_text_color }};
    font-size: 2rem;
    line-height: 1;
    cursor: pointer;
  }

  @media screen and (max-width: 749px) {
    #ShapingInfoPopup {
      padding: 1rem;
    }

    #ShapingInfoPopup .shaping-info-popup__dialog {
      max-height: 85vh;
    }

    #ShapingInfoPopup .shaping-info-popup__header {
      padding: 1.8rem 4rem 1rem 1.6rem;
    }

    #ShapingInfoPopup .shaping-info-popup__body {
      padding: 0 1.6rem 1.6rem;
    }

    #ShapingInfoPopup .shaping-info-popup__title {
      font-size: 2rem;
    }

    #ShapingInfoPopup .shaping-info-popup__content {
      font-size: 1.4rem;
    }
  }
{%- endstyle -%}

<div id="ShapingInfoPopup" class="shaping-info-popup" hidden aria-hidden="true">
  <div class="shaping-info-popup__backdrop" data-shaping-info-close></div>
  <div
    class="shaping-info-popup__dialog"
    role="dialog"
    aria-modal="true"
    aria-labelledby="ShapingInfoPopupTitle"
  >
    <div class="shaping-info-popup__header">
      {%- if shaping_popup_title != blank -%}
        <h3 class="shaping-info-popup__title" id="ShapingInfoPopupTitle">{{ shaping_popup_title | escape }}</h3>
      {%- endif -%}
      <button
        type="button"
        class="shaping-info-popup__close"
        data-shaping-info-close
        aria-label="{{ shaping_popup_close_label | escape }}"
      >
        &times;
      </button>
    </div>
    {%- if shaping_popup_content != blank -%}
      <div class="shaping-info-popup__body">
        <div class="shaping-info-popup__content rte">
          {{ shaping_popup_content }}
        </div>
      </div>
    {%- endif -%}
  </div>
</div>

<script>
  (function () {
    if (window.__shapingInfoPopupBound) return;
    window.__shapingInfoPopupBound = true;

    var lastFocus = null;

    function getPopup() {
      var all = document.querySelectorAll('#ShapingInfoPopup');
      for (var i = 1; i < all.length; i++) {
        all[i].parentNode.removeChild(all[i]);
      }
      var popup = all[0];
      if (popup && popup.parentElement !== document.body) {
        document.body.appendChild(popup);
      }
      return popup;
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', getPopup);
    } else {
      getPopup();
    }

    function closePopup() {
      var popup = document.getElementById('ShapingInfoPopup');
      if (!popup) return;
      popup.hidden = true;
      popup.setAttribute('aria-hidden', 'true');
      document.body.style.overflow = '';
      if (lastFocus && typeof lastFocus.focus === 'function') {
        lastFocus.focus();
      }
    }

    function openPopup() {
      var popup = getPopup();
      if (!popup) return;
      lastFocus = document.activeElement;
      popup.hidden = false;
      popup.setAttribute('aria-hidden', 'false');
      document.body.style.overflow = 'hidden';
      var closeBtn = popup.querySelector('.shaping-info-popup__close');
      if (closeBtn) closeBtn.focus();
    }

    document.addEventListener(
      'click',
      function (event) {
        var target = event.target;
        if (!target || typeof target.closest !== 'function') return;

        if (target.closest('[data-shaping-info]')) {
          event.preventDefault();
          event.stopPropagation();
          openPopup();
          return;
        }

        if (target.closest('[data-shaping-info-close]')) {
          closePopup();
          return;
        }

        var popup = document.getElementById('ShapingInfoPopup');
        if (popup && !popup.hidden && target.closest('#ShapingInfoPopup')) {
          var dialog = popup.querySelector('.shaping-info-popup__dialog');
          if (dialog && !dialog.contains(target)) {
            closePopup();
          }
        }
      },
      true
    );

    document.addEventListener('keydown', function (event) {
      var popup = document.getElementById('ShapingInfoPopup');
      if (event.key === 'Escape' && popup && !popup.hidden) {
        closePopup();
      }
    });
  })();
</script>
