{% comment %}
  Renders header drawer

  Accepts:
  - main_menu: {Object} Main menu
  - language_selector: {HTML} Shows on the screen as customers scroll up when true
  - country_selector: {HTML} Show filtering when true

  Usage:
  {% render 'header-drawer', main_menu: section.settings.menu %}
{% endcomment %}
{% style %}
ul.menu-drawer__mobile-submenu.list-menu {
    display: flex;
    flex-wrap: wrap;
    column-gap: 20px;
    row-gap: 10px;
    padding-top: 15px;
}
ul.menu-drawer__mobile-submenu.list-menu > li {
    width: 85px;
}
ul.menu-drawer__mobile-submenu.list-menu > li .mega-menu__label-tab img {
    width: 100%;
    display: block;
}
ul.menu-drawer__mobile-submenu.list-menu > li a {
    display: flex;
    flex-direction: column;
    font-size: 12px;
    text-align: center;
    line-height: 1.2;
    letter-spacing: 0px;
    padding: 0px;
    text-decoration: none !important;
    border: none;
    gap: 5px;
}
span.menu-drawer__menu-item-arrow {
    display: flex;
    align-items: center;
    justify-content: center;
    height: 30px;
    position: relative;
    right: 15px;
}
span.menu-drawer__menu-item-arrow svg {
    margin: 0px !important;
}
/* Submenu row arrow points right; when open, point down (matches header mobile a.active svg rotation intent) */
a.active.menu-drawer__menu-item span.menu-drawer__menu-item-arrow svg,
a.active.menu-drawer__menu-item span.menu-drawer__menu-item-arrow svg.icon {
  transform: rotate(90deg) !important;
}
span.menu-drawer__topmenu-item-arrow {
    display: flex;
    align-items: center;
    justify-content: center;
    margin-left: auto;
}
/* Shop All chevron: down when closed, right when open. !important beats sections/header.liquid mobile a.active svg.icon { rotate(90deg) }. */
span.menu-drawer__topmenu-item-arrow svg,
span.menu-drawer__topmenu-item-arrow svg.icon {
    margin: 0px !important;
    transform: rotate(0deg);
    transform-origin: center;
    transition: transform 0.2s ease;
}
a.active span.menu-drawer__topmenu-item-arrow svg {
  transform: rotate(-90deg) !important;
}
.menu-drawer__navigation .menu-drawer__menu ul.menu-drawer__menu.list-menu > li > a.menu-drawer__menu-item[data-topmenu-trigger].active span.menu-drawer__topmenu-item-arrow svg.icon {
    transform: rotate(-90deg) !important;
}
ul.menu-drawer__menu.list-menu > li:first-child > a.menu-drawer__menu-item {
    color: #00B8EA;
}
.menu-drawer__shape-tag {
    font-size: 11px;
    line-height: 1;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: #333333;
    margin-left: 8px;
}
ul.menu-drawer__mobile-submenu.menu-drawer__mobile-submenu--shape {
    display: flex;
    flex-direction: column;
    flex-wrap: nowrap;
    column-gap: 0;
    row-gap: 0;
    padding: 4px 0 12px;
    border: none !important;
}
ul.menu-drawer__mobile-submenu.menu-drawer__mobile-submenu--shape > li {
    width: 100%;
    border: none !important;
}
ul.menu-drawer__mobile-submenu.menu-drawer__mobile-submenu--shape > li a.menu-drawer__shape-link {
    flex-direction: row;
    align-items: center;
    justify-content: flex-start;
    text-align: left;
    gap: 14px;
    font-size: 15px;
    font-weight: 700;
    color: #1a1a1a;
    border: none !important;
    border-top: none !important;
    border-bottom: none !important;
}
ul.menu-drawer__mobile-submenu.menu-drawer__mobile-submenu--shape > li a.menu-drawer__shape-link.menu-drawer__menu-item--active,
ul.menu-drawer__mobile-submenu.menu-drawer__mobile-submenu--shape > li a.menu-drawer__shape-link[aria-current="page"] {
    color: #00B8EA !important;
}
ul.menu-drawer__mobile-submenu.menu-drawer__mobile-submenu--shape > li a.menu-drawer__shape-link.menu-drawer__menu-item--active .label,
ul.menu-drawer__mobile-submenu.menu-drawer__mobile-submenu--shape > li a.menu-drawer__shape-link[aria-current="page"] .label {
    color: inherit;
}
ul.menu-drawer__mobile-submenu.menu-drawer__mobile-submenu--shape > li a.menu-drawer__shape-link.menu-drawer__menu-item--active .menu-drawer__shape-row-icon,
ul.menu-drawer__mobile-submenu.menu-drawer__mobile-submenu--shape > li a.menu-drawer__shape-link[aria-current="page"] .menu-drawer__shape-row-icon {
    color: #00B8EA !important;
}
ul.menu-drawer__mobile-submenu.menu-drawer__mobile-submenu--shape > li a.menu-drawer__shape-link.menu-drawer__menu-item--active .menu-drawer__shape-row-icon svg,
ul.menu-drawer__mobile-submenu.menu-drawer__mobile-submenu--shape > li a.menu-drawer__shape-link[aria-current="page"] .menu-drawer__shape-row-icon svg {
    color: #00B8EA !important;
}
.menu-drawer__shape-row-icon {
    flex-shrink: 0;
    width: 20px;
    height: 20px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #1a1a1a;
}
.menu-drawer__shape-row-icon svg {
    width: 100%;
    height: 100%;
}
/* Solution & Coverage: text-only sub-links, no category images (class names use --solution for both) */
ul.menu-drawer__mobile-submenu.menu-drawer__mobile-submenu--solution {
    display: flex;
    flex-direction: column;
    flex-wrap: nowrap;
    column-gap: 0;
    row-gap: 0;
    padding: 4px 0 8px;
    border: none !important;
}
ul.menu-drawer__mobile-submenu.menu-drawer__mobile-submenu--solution > li {
    width: 100% !important;
    border: none !important;
}
ul.menu-drawer__mobile-submenu.menu-drawer__mobile-submenu--solution > li a.menu-drawer__solution-link {
    display: flex;
    flex-direction: row;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px;
    font-size: 15px;
    font-weight: 400 !important;
    color: #1a1a1a;
    text-align: left;
    justify-content: flex-start;
    border: none !important;
    border-top: none !important;
    border-bottom: none !important;
    text-decoration: none !important;
}
ul.menu-drawer__mobile-submenu.menu-drawer__mobile-submenu--solution > li a.menu-drawer__solution-link .label {
    font-weight: 700;
}
ul.menu-drawer__mobile-submenu.menu-drawer__mobile-submenu--solution > li a.menu-drawer__solution-link.menu-drawer__menu-item--active,
ul.menu-drawer__mobile-submenu.menu-drawer__mobile-submenu--solution > li a.menu-drawer__solution-link[aria-current="page"] {
    color: #00B8EA !important;
}
ul.menu-drawer__mobile-submenu.menu-drawer__mobile-submenu--solution .mega-menu__label-tab,
ul.menu-drawer__mobile-submenu.menu-drawer__mobile-submenu--solution .mega-menu__label-tab img {
    display: none !important;
}
.menu-drawer__solution-post-op {
    flex-shrink: 0;
    font-size: 9px;
    line-height: 1;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    padding: 4px 8px;
    border-radius: 999px;
    border: 1px solid #333333;
    background: transparent;
    color: #1a1a1a;
    font-weight: 600;
}
.menu-drawer__navigation .menu-drawer__menu ul.list-menu > li > a.menu-drawer__submenu-row--solution.active,
.menu-drawer__navigation .menu-drawer__menu ul.list-menu > li > a.menu-drawer__submenu-row--solution.menu-drawer__menu-item--active {
    color: #333333 !important;
}
.menu-drawer__navigation .menu-drawer__menu ul.list-menu > li > a.menu-drawer__submenu-row--solution.active .menu-drawer__menu-item-arrow,
.menu-drawer__navigation .menu-drawer__menu ul.list-menu > li > a.menu-drawer__submenu-row--solution.active .menu-drawer__menu-item-arrow svg {
    color: #333333 !important;
}
a.menu-drawer__shape-shop-all {
    display: none;
    margin-top: 2rem;
    margin-bottom: .5rem;
    padding: 0 20px 8px;
    font-size: 14px !important;
    font-weight: 700 !important;
    color: #00B8EA;
    text-decoration: none;
}
/* Shape row stays dark when expanded (overrides header mobile a.active blue) */
.menu-drawer__navigation .menu-drawer__menu ul.list-menu > li > a.menu-drawer__submenu-row--shape.active,
.menu-drawer__navigation .menu-drawer__menu ul.list-menu > li > a.menu-drawer__submenu-row--shape.menu-drawer__menu-item--active {
    color: #333333 !important;
}
.menu-drawer__navigation .menu-drawer__menu ul.list-menu > li > a.menu-drawer__submenu-row--shape.active .menu-drawer__menu-item-arrow,
.menu-drawer__navigation .menu-drawer__menu ul.list-menu > li > a.menu-drawer__submenu-row--shape.active .menu-drawer__menu-item-arrow svg {
    color: #333333 !important;
}
.menu-drawer__navigation ul.list-menu > li > a.menu-drawer__menu-item[data-submenu-trigger].active ~ a.menu-drawer__shape-shop-all {
    display: block;
}
a.menu-drawer__shape-shop-all:hover,
a.menu-drawer__shape-shop-all:focus {
    text-decoration: underline;
}
ul.menu-drawer__menu.list-menu > li > ul.list-menu {
    display: none;
}
ul.menu-drawer__menu.list-menu > li > a[data-topmenu-trigger].active + ul.list-menu {
    display: block;
}
ul.menu-drawer__mobile-submenu.list-menu:not(.active + ul.menu-drawer__mobile-submenu.list-menu){
  display: none;
}
ul.menu-drawer__menu.list-menu > li:last-child {
    border-bottom: 1px solid #00000066;
}
.menu-drawer__navigation .menu-drawer__menu {
    padding-top: 0;
}
drawer-close-button.header__icon--menu {
    position: absolute;
    top: 1.25rem;
    left: 1.6rem;
    width: 3.2rem;
    height: 3.2rem;
    border-radius: 50%;
    background: #D9D9D9;
    color: #333333;
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 2;
    padding: 0;
}
drawer-close-button.header__icon--menu svg {
    width: 1.5rem;
    height: 1.5rem;
}
{% endstyle %}
{%- if section.settings.enable_language_selector and localization.available_languages.size > 1 -%}
  {%- capture language_selector -%}
    <noscript>
      {%- form 'localization', id: 'HeaderDrawerLanguageFormNoScript', class: 'localization-form' -%}
        <div class="localization-form__select">
          <p class="visually-hidden" id="HeaderDrawerLanguageLabelNoScript">{{ 'localization.language_label' | t }}</p>
          <select class="localization-selector link" name="locale_code" aria-labelledby="HeaderDrawerLanguageLabelNoScript">
            {%- for language in localization.available_languages -%}
              {%- comment -%} Wholesale_Club_Product_Visibility_For_Loop Start {%- endcomment -%}
              {%- capture hide_resource -%}{% render "wc_product_visibility", resource: language %}{%- endcapture -%}
              {%- if hide_resource == "true" -%}
                {% continue %}
              {%- endif -%}
              {%- comment -%} Wholesale_Club_Product_Visibility_For_Loop End {%- endcomment -%}

              <option value="{{ language.iso_code }}" lang="{{ language.iso_code }}" {%- if language.iso_code == localization.language.iso_code %} selected{% endif %}>
                {{ language.endonym_name | capitalize }}
              </option>
            {%- endfor -%}
          </select>
          {% render 'icon', icon: 'caret' %}
        </div>
        <button class="button button--tertiary">{{ 'localization.update_language' | t }}</button>
      {%- endform -%}
    </noscript>
    <localization-form>
      {%- form 'localization', id: 'HeaderDrawerLanguageForm', class: 'localization-form' -%}
        <div class="no-js-hidden">
          <span class="visually-hidden" id="HeaderDrawerLanguageLabel">{{ 'localization.language_label' | t }}</span>
          <div class="disclosure">
            <button type="button" class="disclosure__button localization-form__select localization-selector" aria-expanded="false" aria-controls="HeaderDrawerLanguageList" aria-describedby="HeaderDrawerLanguageLabel">
              {% render 'icon', icon: 'localization' %}
              <span class="label">{{ localization.language.endonym_name | capitalize }}</span>
              {% render 'icon', icon: 'caret' %}
            </button>
            <ul id="HeaderDrawerLanguageList" role="list" class="disclosure__list list-unstyled" hidden>
              <li class="disclosure__item" tabindex="-1">
                <a class="disclosure__link link disclosure__link--active focus-inset" href="#" hreflang="{{ localization.language.iso_code }}" lang="{{ localization.language.iso_code }}" aria-current="true" data-value="{{ localization.language.iso_code }}">
                  {{ localization.language.endonym_name | capitalize }}
                </a>
              </li>
              {%- for language in localization.available_languages -%}
                {%- comment -%} Wholesale_Club_Product_Visibility_For_Loop Start {%- endcomment -%}
                {%- capture hide_resource -%}{% render "wc_product_visibility", resource: language %}{%- endcapture -%}
                {%- if hide_resource == "true" -%}
                  {% continue %}
                {%- endif -%}
                {%- comment -%} Wholesale_Club_Product_Visibility_For_Loop End {%- endcomment -%}

                {%- if language.iso_code != localization.language.iso_code -%}
                  <li class="disclosure__item" tabindex="-1">
                    <a class="disclosure__link link focus-inset" href="#" hreflang="{{ language.iso_code }}" lang="{{ language.iso_code }}" data-value="{{ language.iso_code }}">
                      {{ language.endonym_name | capitalize }}
                    </a>
                  </li>
                {%- endif -%}
              {%- endfor -%}
            </ul>
          </div>
          <input type="hidden" name="locale_code" value="{{ localization.language.iso_code }}"/>
        </div>
      {%- endform -%}
    </localization-form>
  {%- endcapture -%}
{%- endif -%}

{%- if section.settings.enable_country_selector and localization.available_countries.size > 1 -%}
  {%- capture country_selector -%}
    <noscript>
      {%- form 'localization', id: 'HeaderDrawerCountryFormNoScript', class: 'localization-form' -%}
        <div class="localization-form__select">
          <p class="visually-hidden" id="HeaderDrawerCountryLabelNoScript">{{ 'localization.country_label' | t }}</p>
          <select class="localization-selector link" name="country_code" aria-labelledby="HeaderDrawerCountryLabelNoScript">
            {%- for country in localization.available_countries -%}
              {%- comment -%} Wholesale_Club_Product_Visibility_For_Loop Start {%- endcomment -%}
              {%- capture hide_resource -%}{% render "wc_product_visibility", resource: country %}{%- endcapture -%}
              {%- if hide_resource == "true" -%}
                {% continue %}
              {%- endif -%}
              {%- comment -%} Wholesale_Club_Product_Visibility_For_Loop End {%- endcomment -%}

              <option value="{{ country.iso_code }}" {%- if country.iso_code == localization.country.iso_code %} selected{% endif %}>
                {{ country.currency.iso_code }} {{ country.currency.symbol }}
              </option>
            {%- endfor -%}
          </select>
          {% render 'icon', icon: 'caret' %}
        </div>
        <button class="button button--tertiary">{{ 'localization.update_country' | t }}</button>
      {%- endform -%}
    </noscript>
    <localization-form>
      {%- form 'localization', id: 'HeaderDrawerCountryForm', class: 'localization-form' -%}
        <div class="no-js-hidden">
          <span class="visually-hidden" id="HeaderDrawerCountryLabel">{{ 'localization.country_label' | t }}</span>
          <div class="disclosure">
            <button type="button" class="disclosure__button localization-form__select localization-selector" aria-expanded="false" aria-controls="HeaderDrawerCountryList" aria-describedby="HeaderDrawerCountryLabel">
              {%- unless section.settings.enable_language_selector and localization.available_languages.size > 1 -%}
                {% render 'icon', icon: 'localization' %}
              {%- endunless -%}
              <span class="label">{{ localization.country.name }} ({{ localization.country.currency.iso_code }} {{ localization.country.currency.symbol }})</span>
              {% render 'icon', icon: 'caret' %}
            </button>
            <ul id="HeaderDrawerCountryList" role="list" class="disclosure__list list-unstyled" hidden>
              <li class="disclosure__item" tabindex="-1">
                <a class="disclosure__link link disclosure__link--active focus-inset" href="#" aria-current="true" data-value="{{ localization.country.iso_code }}">
                  {{ localization.country.name }} ({{ localization.country.currency.iso_code }} {{ localization.country.currency.symbol }})
                </a>
              </li>
              {%- for country in localization.available_countries -%}
                {%- comment -%} Wholesale_Club_Product_Visibility_For_Loop Start {%- endcomment -%}
                {%- capture hide_resource -%}{% render "wc_product_visibility", resource: country %}{%- endcapture -%}
                {%- if hide_resource == "true" -%}
                  {% continue %}
                {%- endif -%}
                {%- comment -%} Wholesale_Club_Product_Visibility_For_Loop End {%- endcomment -%}

                {%- if country.iso_code != localization.country.iso_code -%}
                  <li class="disclosure__item" tabindex="-1">
                    <a class="disclosure__link link focus-inset" href="#" data-value="{{ country.iso_code }}">
                      {{ country.name }} ({{ country.currency.iso_code }} {{ country.currency.symbol }})
                    </a>
                  </li>
                {%- endif -%}
              {%- endfor -%}
            </ul>
          </div>
          <input type="hidden" name="country_code" value="{{ localization.country.iso_code }}"/>
        </div>
      {%- endform -%}
    </localization-form>
  {%- endcapture -%}
{%- endif -%}

{%- assign animate_count = 1 -%}
<header-drawer>
  <details class="menu-drawer-container">
    <summary class="header__icon header__icon--menu focus-inset" aria-label="{{ 'sections.header.menu' | t }}">
      <span class="header__icon header__icon--summary">
        {% render 'icon', icon: 'hamburger' %}
        <svg class="icon icon-close" aria-hidden="true" focusable="false">
          <use href="#icon-close">
        </svg>
      </span>
    </summary>
    <div id="menu-drawer" class="menu-drawer motion-reduce" tabindex="-1">
      <div class="menu-drawer__inner-container">
        <div class="menu-drawer__navigation-container">
          <drawer-close-button class="header__icon header__icon--menu large-up-hide" data-animate data-animate-delay-{{ animate_count }}>
            <svg class="icon icon-close" aria-hidden="true" focusable="false">
              <use href="#icon-close">
            </svg>
          </drawer-close-button>
          <nav class="menu-drawer__navigation" data-animate data-animate-delay-{{ animate_count }}>
            <ul class="menu-drawer__menu list-menu" role="list">
              {%- liquid
                assign iw_topmenu_default_open_applied = false
                assign hc_hide_bundles_for_b2b = false
                assign hc_b2b_tag = settings.b2b_mov_customer_tag | default: 'B2B Customer' | strip
                if customer != blank and hc_b2b_tag != blank and customer.tags contains hc_b2b_tag
                  assign hc_hide_bundles_for_b2b = true
                endif
              -%}
              {%- for link in main_menu.links -%}
              {%- comment -%} Wholesale_Club_Product_Visibility_For_Loop Start {%- endcomment -%}
              {%- capture hide_resource -%}{% render "wc_product_visibility", resource: link %}{%- endcapture -%}
              {%- if hide_resource == "true" -%}
                {% continue %}
              {%- endif -%}
              {%- comment -%} Wholesale_Club_Product_Visibility_For_Loop End {%- endcomment -%}

                <li>
                  {%- if link.links != blank -%}
                    {% comment %} <details>
                      <summary>
                        <span class="menu-drawer__menu-item list-menu__item animate-arrow focus-inset{% if link.active or link.child_active %} menu-drawer__menu-item--active{% endif %}">
                          {%- liquid
                            echo link.title | escape
                            render 'icon', icon: 'arrow'
                            render 'icon', icon: 'caret'
                          -%}
                        </span>
                      </summary>
                      <div id="link-{{ link.title | escape }}" class="menu-drawer__submenu motion-reduce" tabindex="-1">
                        <div class="menu-drawer__inner-submenu">
                          <div class="menu-drawer__topbar">
                            <button type="button" class="menu-drawer__close-button focus-inset" aria-expanded="true" data-close>
                              {% render 'icon', icon: 'arrow' %}
                            </button>
                            <a class="menu-drawer__menu-item" href="{{ link.url }}">{{ link.title | escape }}</a>
                          </div>
                          <ul class="menu-drawer__menu list-menu" role="list" tabindex="-1">
                            {%- for childlink in link.links -%}
                              {%- comment -%} Wholesale_Club_Product_Visibility_For_Loop Start {%- endcomment -%}
                              {%- capture hide_resource -%}{% render "wc_product_visibility", resource: childlink %}{%- endcapture -%}
                              {%- if hide_resource == "true" -%}
                                {% continue %}
                              {%- endif -%}
                              {%- comment -%} Wholesale_Club_Product_Visibility_For_Loop End {%- endcomment -%}

                              <li>
                                {%- if childlink.links == blank -%}
                                  <a href="{{ childlink.url }}" class="menu-drawer__menu-item list-menu__item focus-inset{% if childlink.current %} menu-drawer__menu-item--active{% endif %}"{% if childlink.current %} aria-current="page"{% endif %}>
                                    {{ childlink.title | escape }}
                                  </a>
                                {%- else -%}
                                  <details>
                                    <summary>
                                      <span class="menu-drawer__menu-item list-menu__item animate-arrow focus-inset">
                                        {%- liquid
                                          echo childlink.title | escape
                                          render 'icon', icon: 'arrow'
                                          render 'icon', icon: 'caret'
                                        -%}
                                      </span>
                                    </summary>
                                    <div id="childlink-{{ childlink.title | escape }}" class="menu-drawer__submenu motion-reduce">
                                      <div class="menu-drawer__topbar">
                                        <button type="button" class="menu-drawer__close-button focus-inset" aria-expanded="true" data-close>
                                          {% render 'icon', icon: 'arrow' %}
                                        </button>
                                        <a class="menu-drawer__menu-item" href="{{ childlink.url }}">{{ childlink.title | escape }}</a>
                                      </div>
                                      <ul class="menu-drawer__menu list-menu" role="list" tabindex="-1">
                                        {%- for grandchildlink in childlink.links -%}
                                          {%- comment -%} Wholesale_Club_Product_Visibility_For_Loop Start {%- endcomment -%}
                                          {%- capture hide_resource -%}{% render "wc_product_visibility", resource: grandchildlink %}{%- endcapture -%}
                                          {%- if hide_resource == "true" -%}
                                            {% continue %}
                                          {%- endif -%}
                                          {%- comment -%} Wholesale_Club_Product_Visibility_For_Loop End {%- endcomment -%}

                                          <li>
                                            <a href="{{ grandchildlink.url }}" class="menu-drawer__menu-item list-menu__item focus-inset{% if grandchildlink.current %} menu-drawer__menu-item--active{% endif %}"{% if grandchildlink.current %} aria-current="page"{% endif %}>
                                              {{ grandchildlink.title | escape }}
                                            </a>
                                          </li>
                                        {%- endfor -%}
                                      </ul>
                                    </div>
                                  </details>
                                {%- endif -%}
                              </li>
                            {%- endfor -%}
                          </ul>
                        </div>
                      </div>
                    </details> {% endcomment %}
                    {%- assign iw_top_open_this_panel = false -%}
                    {%- if iw_topmenu_default_open_applied == false -%}
                      {%- assign iw_top_open_this_panel = true -%}
                      {%- assign iw_topmenu_default_open_applied = true -%}
                    {%- endif -%}
                    <a href="{{ link.url }}" data-topmenu-trigger class="menu-drawer__menu-item list-menu__item focus-inset{% if iw_top_open_this_panel %} active{% endif %}{% if link.current %} menu-drawer__menu-item--active{% endif %}"{% if link.current %} aria-current="page"{% endif %}>
                      {{ link.title | escape }}
                      <span class="menu-drawer__topmenu-item-arrow">{% render 'icon', icon: 'arrow-menu' %}</span>
                    </a>
                    <ul class="list-menu" role="list">
                      {%- assign hc_parent_handle = link.title | handle -%}
                      {%- for childlink in link.links -%}
                        {%- comment -%} Wholesale_Club_Product_Visibility_For_Loop Start {%- endcomment -%}
                        {%- capture hide_resource -%}{% render "wc_product_visibility", resource: childlink %}{%- endcapture -%}
                        {%- if hide_resource == "true" -%}
                          {% continue %}
                        {%- endif -%}
                        {%- comment -%} Wholesale_Club_Product_Visibility_For_Loop End {%- endcomment -%}
                        {%- assign hc_child_handle = childlink.title | handle -%}
                        {%- if hc_hide_bundles_for_b2b and hc_parent_handle == 'shop-all' and hc_child_handle == 'bundles' -%}
                          {%- continue -%}
                        {%- endif -%}
                        {%- assign drawer_child_title = childlink.title | strip | downcase -%}
                        {%- assign drawer_child_handle = '' -%}
                        {%- if childlink.object and childlink.object.handle != blank -%}
                          {%- assign drawer_child_handle = childlink.object.handle | downcase -%}
                        {%- endif -%}
                        {%- assign drawer_is_plain_submenu = false -%}
                        {%- if drawer_child_title != 'shape' -%}
                          {%- if drawer_child_title == 'solution' or drawer_child_title == 'solutions' or drawer_child_title contains 'solution' or drawer_child_handle contains 'solution' or drawer_child_title == 'coverage' or drawer_child_title contains 'coverage' or drawer_child_handle contains 'coverage' or drawer_child_title == 'bundle' or drawer_child_title == 'bundles' or drawer_child_title contains 'bundle' or drawer_child_handle contains 'bundle' -%}
                            {%- assign drawer_is_plain_submenu = true -%}
                          {%- endif -%}
                        {%- endif -%}
                        <li>
                          {%- if childlink.links == blank -%}
                            <a href="{{ childlink.url }}" class="menu-drawer__menu-item list-menu__item focus-inset{% if childlink.current %} menu-drawer__menu-item--active{% endif %}"{% if childlink.current %} aria-current="page"{% endif %}>
                              {{ childlink.title | escape }}
                            </a>
                          {%- else -%}
                          <a href="{{ childlink.url }}" data-submenu-trigger class="menu-drawer__menu-item list-menu__item focus-inset{% if drawer_child_title == 'shape' %} menu-drawer__submenu-row--shape{% endif %}{% if drawer_is_plain_submenu %} menu-drawer__submenu-row--solution{% endif %}{% if childlink.current %} menu-drawer__menu-item--active{% endif %}"{% if childlink.current %} aria-current="page"{% endif %}>
                            {{ childlink.title | escape }}
                            {%- if drawer_child_title == 'shape' -%}
                              <span class="menu-drawer__shape-tag">NEW? START HERE</span>
                            {%- endif -%}
                            <span class="menu-drawer__menu-item-arrow">{% render 'icon', icon: 'arrow' %}</span>
                          </a>
                          <ul class="menu-drawer__mobile-submenu list-menu{% if drawer_child_title == 'shape' %} menu-drawer__mobile-submenu--shape{% endif %}{% if drawer_is_plain_submenu %} menu-drawer__mobile-submenu--solution{% endif %}" role="list">
                            {%- for grandchildlink in childlink.links -%}
                              {%- comment -%} Wholesale_Club_Product_Visibility_For_Loop Start {%- endcomment -%}
                              {%- capture hide_resource -%}{% render "wc_product_visibility", resource: grandchildlink %}{%- endcapture -%}
                              {%- if hide_resource == "true" -%}
                                {% continue %}
                              {%- endif -%}
                              {%- comment -%} Wholesale_Club_Product_Visibility_For_Loop End {%- endcomment -%}
                              {%- assign hc_grandchild_handle = grandchildlink.title | handle -%}
                              {%- if hc_hide_bundles_for_b2b and hc_parent_handle == 'shop-all' and hc_grandchild_handle == 'bundles' -%}
                                {%- continue -%}
                              {%- endif -%}
                              <li>
                                {%- if drawer_child_title == 'shape' -%}
                                  {%- liquid
                                    assign shape_icon = 'shape-triangle'
                                    assign gh = grandchildlink.handle | downcase
                                    assign gt = grandchildlink.title | downcase
                                    if gh contains 'teardrop' or gh contains 'waterdrop' or gt contains 'teardrop' or gt contains 'waterdrop'
                                      assign shape_icon = 'shape-teardrop'
                                    elsif gh contains 'half-moon' or gh contains 'half_moon' or gh contains 'halfmoon' or gt contains 'half moon' or gt contains 'half-moon'
                                      assign shape_icon = 'shape-half-moon'
                                    elsif gh contains 'triangle' or gt contains 'triangle'
                                      assign shape_icon = 'shape-triangle'
                                    elsif gh contains 'oval' or gt contains 'oval'
                                      assign shape_icon = 'shape-oval'
                                    endif
                                  -%}
                                  <a href="{{ grandchildlink.url }}" class="menu-drawer__menu-item list-menu__item menu-drawer__shape-link focus-inset{% if grandchildlink.current %} menu-drawer__menu-item--active{% endif %}"{% if grandchildlink.current %} aria-current="page"{% endif %}>
                                    <span class="menu-drawer__shape-row-icon" aria-hidden="true">{% render 'icon', icon: shape_icon %}</span>
                                    <span class="label">{{ grandchildlink.title | escape }}</span>
                                  </a>
                                {%- elsif drawer_is_plain_submenu -%}
                                  {%- liquid
                                    assign gh = grandchildlink.handle | downcase
                                    assign gt = grandchildlink.title | strip | downcase
                                    assign show_post_op = false
                                    if gh contains 'mastectomy' or gh contains 'lumpectomy' or gh contains 'explant' or gt contains 'mastectomy' or gt contains 'lumpectomy' or gt contains 'explant'
                                      assign show_post_op = true
                                    endif
                                  -%}
                                  <a href="{{ grandchildlink.url }}" class="menu-drawer__menu-item list-menu__item menu-drawer__solution-link focus-inset{% if grandchildlink.current %} menu-drawer__menu-item--active{% endif %}"{% if grandchildlink.current %} aria-current="page"{% endif %}>
                                    <span class="label">{{ grandchildlink.title | escape }}</span>
                                    {%- if show_post_op -%}
                                      <span class="menu-drawer__solution-post-op">POST-OP</span>
                                    {%- endif -%}
                                  </a>
                                {%- else -%}
                                  <a href="{{ grandchildlink.url }}" class="menu-drawer__menu-item list-menu__item focus-inset{% if grandchildlink.current %} menu-drawer__menu-item--active{% endif %}"{% if grandchildlink.current %} aria-current="page"{% endif %}>
                                    {% assign item = grandchildlink.object %}
                                    {% if item and item.metafields.custom.menu_label != blank %}
                                      <div class="mega-menu__label-tab">
                                        <img src="{{ item.metafields.custom.menu_label | image_url: width: 164 }}" class="mega-menu__image" alt="{{ grandchildlink.title | default: shop.name | escape }}">
                                      </div>
                                    {% endif %}
                                    <span class="label">{{ grandchildlink.title | escape }}</span>
                                  </a>
                                {%- endif -%}
                              </li>
                            {%- endfor -%}
                          </ul>
                          {%- if drawer_child_title == 'shape' or drawer_is_plain_submenu -%}
                            <a href="{{ childlink.url }}" class="menu-drawer__shape-shop-all">Shop All</a>
                          {%- endif -%}
                          {%- endif -%}
                        </li>
                      {%- endfor -%}
                    </ul>
                  {%- else -%}
                    <a href="{{ link.url }}" class="menu-drawer__menu-item list-menu__itemfocus-inset{% if link.current %} menu-drawer__menu-item--active{% endif %}"{% if link.current %} aria-current="page"{% endif %}>
                      {{ link.title | escape }}
                    </a>
                  {%- endif -%}
                </li>
              {%- endfor -%}
            </ul>
          </nav>

          {%- if language_selector != blank or country_selector != blank -%}
            <div class="menu-drawer__localization" data-animate data-animate-delay-{{ animate_count }}>
              {%- liquid
                echo language_selector
                echo country_selector
                
                assign animate_count = animate_count | plus: 1
              -%}
            </div>
          {%- endif -%}

          <div class="menu-drawer__utility-links" data-animate data-animate-delay-{{ animate_count }}>
            {%- if shop.customer_accounts_enabled -%}
              <a href="{% if customer %}{{ routes.account_url }}{% else %}{{ routes.account_login_url }}{% endif %}" class="menu-drawer__account link link-with-icon focus-inset">
                {% render 'icon', icon: 'account' %}
                <span class="label">
                  {%- liquid
                    if customer
                      echo 'customer.account_fallback' | t
                    else
                      echo 'customer.log_in' | t
                    endif
                  -%}
                </span>
              </a>
            {%- endif -%}
            <ul class="list list-social list-unstyled" role="list">
              {%- render 'social-icons' -%}
            </ul>
          </div>
        </div>
      </div>
    </div>
  </details>
</header-drawer>

<script>
document.addEventListener('DOMContentLoaded', function() {
  const topmenuTriggers = document.querySelectorAll('[data-topmenu-trigger]');

  topmenuTriggers.forEach(function(trigger) {
    trigger.addEventListener('click', function(e) {
      e.preventDefault();

      const isActive = this.classList.contains('active');
      const parentList = this.closest('ul.menu-drawer__menu.list-menu');
      const siblingTriggers = parentList.querySelectorAll('[data-topmenu-trigger]');

      siblingTriggers.forEach(function(item) {
        item.classList.remove('active');
      });

      if (!isActive) {
        this.classList.add('active');
      }
    });
  });

  // Get all submenu trigger elements
  const submenuTriggers = document.querySelectorAll('[data-submenu-trigger]');
  
  submenuTriggers.forEach(function(trigger) {
    trigger.addEventListener('click', function(e) {
      e.preventDefault();
      
      // Check if this trigger already has the active class
      const isActive = this.classList.contains('active');
      
      // Get all triggers in the same parent menu
      const parentList = this.closest('ul.list-menu');
      const siblingTriggers = parentList.querySelectorAll('[data-submenu-trigger]');
      
      // Remove active class from all sibling triggers
      siblingTriggers.forEach(function(item) {
        item.classList.remove('active');
      });
      
      // If it wasn't active before, add active class to clicked trigger
      if (!isActive) {
        this.classList.add('active');
      }
    });
  });
});
</script>