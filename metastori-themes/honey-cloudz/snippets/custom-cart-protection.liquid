{%- comment -%} Custom Cart — checkout protection row {%- endcomment -%}

{%- if settings.custom_cart_enable_checkout_protection and settings.custom_cart_protection_product != blank -%}
  {%- assign protection_product = settings.custom_cart_protection_product -%}
  {%- assign protection_variant = protection_product.selected_or_first_available_variant -%}
  {%- assign protection_in_cart = false -%}
  {%- assign protection_line = 0 -%}

  {%- for item in cart.items -%}
    {%- if item.variant_id == protection_variant.id -%}
      {%- assign protection_in_cart = true -%}
      {%- assign protection_line = item.index | plus: 1 -%}
      {%- assign protection_variant = item.variant -%}
      {%- break -%}
    {%- endif -%}
  {%- endfor -%}

  <div
    class="custom-cart__protection"
    data-custom-protection
    data-variant-id="{{ protection_variant.id }}"
    data-product-id="{{ protection_product.id }}"
    data-in-cart="{{ protection_in_cart }}"
    data-line="{{ protection_line }}"
    data-price="{{ protection_variant.price }}"
  >
    <div class="custom-cart__protection-icon" aria-hidden="true">
      {% render 'custom-cart-icons', icon: 'box' %}
    </div>

    <div class="custom-cart__protection-content">
      <div class="custom-cart__protection-title-row">
        <p class="custom-cart__protection-title">
          {{ settings.custom_cart_protection_title | default: protection_product.title }}
        </p>
        <button
          type="button"
          class="custom-cart__protection-info"
          data-custom-protection-info
          aria-label="More information about checkout protection"
        >
          {% render 'custom-cart-icons', icon: 'info' %}
        </button>
      </div>
      <p class="custom-cart__protection-description">
        {{ settings.custom_cart_protection_description | default: 'Free returns on your order' }}
      </p>
    </div>

    <p class="custom-cart__protection-price" data-custom-protection-price>
      {{ protection_variant.price | money }}
    </p>
  </div>
{%- endif -%}
