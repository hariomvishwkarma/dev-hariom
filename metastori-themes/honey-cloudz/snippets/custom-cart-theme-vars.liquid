{%- comment -%} Custom cart drawer — theme setting CSS variables {%- endcomment -%}
{%- style -%}
  .custom-cart {
    --custom-cart-drawer-bg: {{ settings.custom_cart_drawer_background }};
    --custom-cart-card-bg: {{ settings.custom_cart_card_background }};
    --custom-cart-title-size: {{ settings.custom_cart_card_title_size_mobile }}px;
    --custom-cart-price-size: {{ settings.custom_cart_card_price_size_mobile }}px;
    --custom-cart-checkout-bg: {{ settings.custom_cart_checkout_button_background }};
    --custom-cart-checkout-color: {{ settings.custom_cart_checkout_button_text_color }};
    --custom-cart-footer-notice-bg: {{ settings.custom_cart_footer_notice_background }};
    --custom-cart-footer-notice-color: {{ settings.custom_cart_footer_notice_text_color }};
    --custom-cart-footer-notice-border-color: {{ settings.custom_cart_footer_notice_border_color }};
    --custom-cart-footer-notice-border-width: {{ settings.custom_cart_footer_notice_border_width }}px;
    --custom-cart-footer-notice-radius: {{ settings.custom_cart_footer_notice_border_radius }}px;
    --custom-cart-footer-notice-padding-y: {{ settings.custom_cart_footer_notice_padding }}px;
    --custom-cart-footer-notice-padding-x: {{ settings.custom_cart_footer_notice_padding_x }}px;
    --custom-cart-footer-notice-font-size: {{ settings.custom_cart_footer_notice_font_size }}px;
    --custom-cart-footer-notice-text-align: {{ settings.custom_cart_footer_notice_text_align }};
  }

  @media screen and (min-width: 750px) {
    .custom-cart {
      --custom-cart-title-size: {{ settings.custom_cart_card_title_size_desktop }}px;
      --custom-cart-price-size: {{ settings.custom_cart_card_price_size_desktop }}px;
    }
  }
{%- endstyle -%}
