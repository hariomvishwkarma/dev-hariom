{%- comment -%}
  Embeds Style Finder metaobject entries as JSON for hc-style-finder.js.
  Requires Storefront read access on each metaobject definition.
{%- endcomment -%}
{
  "questions": [
    {%- assign q_first = true -%}
    {%- paginate shop.metaobjects.style_finder_question.values by 250 -%}
    {%- for q in shop.metaobjects.style_finder_question.values -%}
      {%- unless q_first -%},{%- endunless -%}
      {%- assign q_first = false -%}
      {
        "id": {{ q.question_id.value | json }},
        "titleSelf": {{ q.title_self.value | default: '' | json }},
        "titleGift": {{ q.title_gift.value | default: '' | json }},
        "helpSelf": {{ q.help_self.value | default: '' | json }},
        "helpGift": {{ q.help_gift.value | default: '' | json }},
        "noteSelf": {{ q.note_self.value | default: '' | json }},
        "noteGift": {{ q.note_gift.value | default: '' | json }}
      }
    {%- endfor -%}
    {%- endpaginate -%}
  ],
  "answers": [
    {%- assign a_first = true -%}
    {%- paginate shop.metaobjects.style_finder_answer.values by 250 -%}
    {%- for a in shop.metaobjects.style_finder_answer.values -%}
      {%- unless a_first -%},{%- endunless -%}
      {%- assign a_first = false -%}
      {
        "id": {{ a.answer_id.value | json }},
        "questionId": {{ a.question_id.value | json }},
        "labelSelf": {{ a.label_self.value | default: '' | json }},
        "labelGift": {{ a.label_gift.value | default: '' | json }},
        "sortOrder": {% if a.sort_order %}{{ a.sort_order.value | default: 0 | json }}{% else %}0{% endif %}
      }
    {%- endfor -%}
    {%- endpaginate -%}
  ],
  "outcomes": {
    {%- assign o_first = true -%}
    {%- paginate shop.metaobjects.style_finder_outcome.values by 250 -%}
    {%- for o in shop.metaobjects.style_finder_outcome.values -%}
      {%- unless o_first -%},{%- endunless -%}
      {%- assign o_first = false -%}
      {%- assign o_key = o.outcome_key.value -%}
      {{ o_key | json }}: {
        "displayName": {{ o.display_name.value | default: o_key | json }},
        "handle": {% if o.product.value != blank %}{{ o.product.value.handle | json }}{% else %}null{% endif %},
        "secondaryHandle": {% if o.secondary_product.value != blank %}{{ o.secondary_product.value.handle | json }}{% else %}null{% endif %},
        "introSelf": {{ o.result_intro_self.value | default: '' | json }},
        "introGift": {{ o.result_intro_gift.value | default: '' | json }},
        {%- comment -%} Same size chart the product page shows. {%- endcomment -%}
        "sizeGuideImage": {% if o.product.value.metafields.custom.size_information.value != blank %}{{ o.product.value.metafields.custom.size_information.value | image_url: width: 1600 | json }}{% else %}null{% endif %},
        "sizeGuideText": {% if o.product.value.metafields.custom.size_chart_description != blank %}{{ o.product.value.metafields.custom.size_chart_description | metafield_tag | json }}{% else %}null{% endif %}
      }
    {%- endfor -%}
    {%- endpaginate -%}
  },
  "snippets": {
    {%- assign s_first = true -%}
    {%- paginate shop.metaobjects.style_finder_snippet.values by 250 -%}
    {%- for s in shop.metaobjects.style_finder_snippet.values -%}
      {%- unless s_first -%},{%- endunless -%}
      {%- assign s_first = false -%}
      {{ s.snippet_key.value | json }}: {{ s.body.value | default: '' | json }}
    {%- endfor -%}
    {%- endpaginate -%}
  },
  "uiStrings": {
    {%- assign u_first = true -%}
    {%- paginate shop.metaobjects.style_finder_ui_string.values by 250 -%}
    {%- for u in shop.metaobjects.style_finder_ui_string.values -%}
      {%- unless u_first -%},{%- endunless -%}
      {%- assign u_first = false -%}
      {{ u.string_key.value | json }}: {{ u.text.value | default: '' | json }}
    {%- endfor -%}
    {%- endpaginate -%}
  },
  "sizeMaps": [
    {%- assign m_first = true -%}
    {%- paginate shop.metaobjects.style_finder_size_map.values by 250 -%}
    {%- for m in shop.metaobjects.style_finder_size_map.values -%}
      {%- unless m_first -%},{%- endunless -%}
      {%- assign m_first = false -%}
      {
        "mapKey": {{ m.map_key.value | json }},
        "outcomeKey": {{ m.outcome_key.value | json }},
        "cup": {{ m.input_cup.value | default: '' | json }},
        "band": {{ m.input_band.value | default: '' | json }},
        "pref": {{ m.size_preference.value | default: '' | json }},
        "variantId": {% if m.variant.value %}{{ m.variant.value.id | json }}{% else %}null{% endif %},
        "productHandle": {% if m.product.value %}{{ m.product.value.handle | json }}{% else %}null{% endif %}
      }
    {%- endfor -%}
    {%- endpaginate -%}
  ]
}
