<div class="related-products-carousel {{ section.settings.text_alignment }} mobile-{{ section.settings.mobile_text_alignment }}">
 {% if block.settings.product != blank %}

  {% if block.settings.heading != blank %}
    <h2 class="h3" >{{ block.settings.heading | escape }} </h2>
  {% endif %}
 
  <div class="carousel-track">
    <div class="carousel-item">
      {% render 'card-product', 
        card_product: block.settings.product,
        card_collection: collection,
        media_size: 'square',
        show_secondary_image:true,
        show_quick_buy: false,
        enable_quick_view: false,
        enable_color_swatches: false,
        enable_image_fill: true,
        lazy_load: true
      %}
    </div>
  </div>

{% else %}
  {% if request.design_mode %}
    <h2 class="h4 center" > No Product Available, Use Metafield to Add the product</h2>
    <div class = "text"> This is just design mode text and wont be shown on the live site.  </div>
  {% endif %}
{% endif %}
</div>
