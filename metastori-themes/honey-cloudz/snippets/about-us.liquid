<div class="about-us-block {{ section.settings.text_alignment }} mobile-{{ section.settings.mobile_text_alignment }}">
  {% if block.settings.heading %}
    <h3 class="about-us-title h3">{{ block.settings.heading }}</h3>
  {% endif %}
  
  {% if block.settings.image %}
    <img height = "100%" width = "100%" loading = "lazy" src="{{ block.settings.image | image_url }}" alt="{{ block.settings.heading }}" class="about-us-image">
  {% endif %}
  
  {% if block.settings.description %}
    <p class="about-us-description">{{ block.settings.description }}</p>
  {% endif %}
  
  {% if block.settings.link %}
    <a href="{{ block.settings.link }}" class="about-us-button">
      {{ block.settings.button_text }}
    </a>
  {% endif %}
</div>
