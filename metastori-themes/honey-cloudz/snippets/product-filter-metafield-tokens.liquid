{%- comment -%} Outputs handleized tokens as piece||piece|| Params: product, namespace, key, fallback_namespace, fallback_key {%- endcomment -%}
{%- liquid
  assign ns = namespace | strip
  assign ky = key | strip
  if ns == blank
    assign ns = fallback_namespace | default: 'custom' | strip
  endif
  if ky == blank
    assign ky = fallback_key | default: 'solution' | strip
  endif
  assign out = ''
  assign mf = product.metafields[ns][ky]
  if mf != blank and mf.value != blank
    if mf.type contains 'list.'
      for sv in mf.value
        assign piece = ''
        if sv.system.handle != blank
          assign piece = sv.system.handle
        elsif sv.name != blank and sv.name.value != blank
          assign piece = sv.name.value | strip | handleize
        elsif sv.title != blank and sv.title.value != blank
          assign piece = sv.title.value | strip | handleize
        elsif sv.label != blank and sv.label.value != blank
          assign piece = sv.label.value | strip | handleize
        else
          assign piece = sv | strip | handleize
        endif
        if piece != blank
          assign out = out | append: piece | append: '||'
        endif
      endfor
    else
      assign sv = mf.value
      assign piece = ''
      if sv.system.handle != blank
        assign piece = sv.system.handle
      elsif sv.name != blank and sv.name.value != blank
        assign piece = sv.name.value | strip | handleize
      elsif sv.title != blank and sv.title.value != blank
        assign piece = sv.title.value | strip | handleize
      elsif sv.label != blank and sv.label.value != blank
        assign piece = sv.label.value | strip | handleize
      else
        assign piece = sv | strip | handleize
      endif
      if piece != blank
        assign out = piece | append: '||'
      endif
    endif
  endif
  echo out
-%}
