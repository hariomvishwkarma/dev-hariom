{%- comment -%}
  pdp-assets — loads the Replo CSS/JS for the chosen design preset.

  Safe to include from every pdp-* section on the page:
    - stylesheet URLs repeat, but the browser fetches each one once
    - the JS files self-guard against double init (see the __pdpBooted flag
      at the top of hc-pdp.js / tbf2-pdp.js), so repeated <script> tags are inert

  Expects `preset` in scope (this snippet is pulled in with {% include %},
  which shares the caller's variables).
{%- endcomment -%}
{%- if preset == 'breast-form' -%}
  {{ 'tbf2-custom-full.css' | asset_url | stylesheet_tag }}
  {{ 'bundle-component-iw-new.css' | asset_url | stylesheet_tag }}
  {{ 'tbf2-pdp-ui.css' | asset_url | stylesheet_tag }}
  <script src="{{ 'tbf2-pdp.js' | asset_url }}" defer></script>
{%- else -%}
  <link rel="stylesheet" href="{{ 'hc-pdp-a.css' | asset_url }}" media="print" onload="this.media='all'">
  <link rel="stylesheet" href="{{ 'hc-pdp-b.css' | asset_url }}" media="print" onload="this.media='all'">
  <noscript>
    <link rel="stylesheet" href="{{ 'hc-pdp-a.css' | asset_url }}">
    <link rel="stylesheet" href="{{ 'hc-pdp-b.css' | asset_url }}">
  </noscript>
  {{ 'bundle-component-iw-new.css' | asset_url | stylesheet_tag }}
  {{ 'hc-pdp-ui.css' | asset_url | stylesheet_tag }}
  <script src="{{ 'hc-pdp.js' | asset_url }}" defer></script>
{%- endif -%}
