{%- comment -%}
  Outputs true/false for a metaobject boolean field.
  Usage: {% render 'store-locator-boolean', object: store, keys: 'service_mastectomy,mastectomy' %}
{%- endcomment -%}
{%- liquid
  assign result = false
  assign key_list = keys | split: ','

  for key in key_list
    assign field_key = key | strip
    assign field_value = nil

    case field_key
      when 'mastectomy_services'
        assign field_value = object.mastectomy_services.value | default: object.mastectomy_services
      when 'service_mastectomy'
        assign field_value = object.service_mastectomy.value | default: object.service_mastectomy
      when 'mastectomy'
        assign field_value = object.mastectomy.value | default: object.mastectomy
      when 'post_op_services'
        assign field_value = object.post_op_services.value | default: object.post_op_services
      when 'service_post_op'
        assign field_value = object.service_post_op.value | default: object.service_post_op
      when 'service_postop'
        assign field_value = object.service_postop.value | default: object.service_postop
      when 'post_op'
        assign field_value = object.post_op.value | default: object.post_op
      when 'postop'
        assign field_value = object.postop.value | default: object.postop
      when 'is_active'
        assign field_value = object.is_active.value | default: object.is_active
      when 'active'
        assign field_value = object.active.value | default: object.active
      else
        assign dynamic_field = object[field_key]
        if dynamic_field.value != blank
          assign field_value = dynamic_field.value
        else
          assign field_value = dynamic_field
        endif
    endcase

    if field_value == true
      assign result = true
      break
    endif

    if field_value == false
      continue
    endif

    assign field_string = field_value | downcase | strip
    if field_string == 'true' or field_string == '1' or field_string == 'yes'
      assign result = true
      break
    endif
  endfor
-%}{%- if result -%}true{%- else -%}false{%- endif -%}
