{% doc %}
  Central JSON-LD router. Outputs Google-recommended structured data per template.
  @example
  {% render 'schema-jsonld' %}
{% enddoc %}

{%- liquid
  assign collections_page_url = request.origin | append: routes.collections_url
  assign cart_page_url = request.origin | append: routes.cart_url
  if page != blank
    assign static_page_url = request.origin | append: page.url
    assign static_page_name = page.title
  endif
-%}

{%- case template.name -%}
  {%- when 'index' -%}
    {% render 'schema-organization' %}
    {% render 'schema-website' %}

  {%- when 'product' -%}
    {% render 'schema-product' %}
    {% render 'schema-breadcrumbs' %}

  {%- when 'collection' -%}
    {% render 'schema-collection' %}
    {% render 'schema-breadcrumbs' %}

  {%- when 'list-collections' -%}
    {% render 'schema-webpage', page_type: 'CollectionPage', page_name: page_title, page_url: collections_page_url %}
    {% render 'schema-breadcrumbs' %}

  {%- when 'article' -%}
    {% render 'schema-article' %}
    {% render 'schema-breadcrumbs' %}

  {%- when 'blog' -%}
    {% render 'schema-blog' %}
    {% render 'schema-breadcrumbs' %}

  {%- when 'page' -%}
    {% render 'schema-organization' %}
    {% render 'schema-page' %}
    {% render 'schema-breadcrumbs' %}

  {%- when 'search' -%}
    {% render 'schema-webpage', page_type: 'SearchResultsPage', page_name: page_title, page_url: canonical_url %}
    {% render 'schema-breadcrumbs' %}

  {%- when 'cart' -%}
    {% render 'schema-webpage', page_type: 'WebPage', page_name: page_title, page_url: cart_page_url %}

  {%- when '404' -%}
    {% render 'schema-webpage', page_type: 'WebPage', page_name: page_title, page_url: canonical_url %}

  {%- else -%}
    {% render 'schema-webpage', page_type: 'WebPage', page_name: page_title, page_url: canonical_url %}
    {% render 'schema-breadcrumbs' %}

{%- endcase -%}
