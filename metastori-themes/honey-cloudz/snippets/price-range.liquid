{% doc %}
  Renders a product min–max price range for pending variant selection states.

  @param {product} product - Product Liquid object
  @param {string} id - Element id for the range container
  @param {string} [price_class] - Optional price size/modifier classes
  @param {boolean} [hidden] - When true, starts with visibility-hidden

  @example
  {% render 'price-range', product: product, id: range_id, price_class: price_class, hidden: true %}
{% enddoc %}
{%- if product != blank and product.price_varies and product.price_min != product.price_max -%}
  <div
    data-spark="b2c-only"
    class="no-js-hidden product__price-range"
    id="{{ id }}"
    {% if hidden %}hidden{% endif %}
  >
    {%- render 'price', product: product, use_variant: false, show_badges: false, price_class: price_class -%}
  </div>
{%- endif -%}
