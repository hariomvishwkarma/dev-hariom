{%- comment -%}
  Custom Cart — SVG icon sprites.
  Usage: {% render 'custom-cart-icons', icon: 'close' %}
{%- endcomment -%}

{%- case icon -%}
  {%- when 'close' -%}
    <svg
      class="custom-cart__icon custom-cart__icon--close"
      width="14"
      height="14"
      viewBox="0 0 14 14"
      fill="none"
      aria-hidden="true"
      focusable="false"
    >
      <path d="M1 1L13 13M13 1L1 13" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
    </svg>
  {%- when 'trash' -%}
    {% comment %}
      <svg
        class="custom-cart__icon custom-cart__icon--trash"
        width="16"
        height="18"
        viewBox="0 0 16 18"
        fill="none"
        aria-hidden="true"
        focusable="false"
      >
        <path d="M1 4h14M5 4V2.5A1.5 1.5 0 0 1 6.5 1h3A1.5 1.5 0 0 1 11 2.5V4m2 0v11.5A1.5 1.5 0 0 1 11.5 17h-7A1.5 1.5 0 0 1 3 15.5V4h10z" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round"/>
        <path d="M6.5 8v5M9.5 8v5" stroke="currentColor" stroke-width="1.2" stroke-linecap="round"/>
      </svg>
    {% endcomment %}
    <svg class="custom-cart__icon custom-cart__icon--trash" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20">
      <path d="M11.5 8.25a.75.75 0 0 1 .75.75v4.25a.75.75 0 0 1-1.5 0v-4.25a.75.75 0 0 1 .75-.75Z"></path><path d="M9.25 9a.75.75 0 0 0-1.5 0v4.25a.75.75 0 0 0 1.5 0v-4.25Z"></path><path fill-rule="evenodd" d="M7.25 5.25a2.75 2.75 0 0 1 5.5 0h3a.75.75 0 0 1 0 1.5h-.75v5.45c0 1.68 0 2.52-.327 3.162a3 3 0 0 1-1.311 1.311c-.642.327-1.482.327-3.162.327h-.4c-1.68 0-2.52 0-3.162-.327a3 3 0 0 1-1.311-1.311c-.327-.642-.327-1.482-.327-3.162v-5.45h-.75a.75.75 0 0 1 0-1.5h3Zm1.5 0a1.25 1.25 0 1 1 2.5 0h-2.5Zm-2.25 1.5h7v5.45c0 .865-.001 1.423-.036 1.848-.033.408-.09.559-.128.633a1.5 1.5 0 0 1-.655.655c-.074.038-.225.095-.633.128-.425.035-.983.036-1.848.036h-.4c-.865 0-1.423-.001-1.848-.036-.408-.033-.559-.09-.633-.128a1.5 1.5 0 0 1-.656-.655c-.037-.074-.094-.225-.127-.633-.035-.425-.036-.983-.036-1.848v-5.45Z"></path>
    </svg>
  {%- when 'minus' -%}
    <svg
      class="custom-cart__icon custom-cart__icon--minus"
      width="10"
      height="2"
      viewBox="0 0 10 2"
      fill="none"
      aria-hidden="true"
      focusable="false"
    >
      <path d="M0 1h10" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
    </svg>
  {%- when 'plus' -%}
    <svg
      class="custom-cart__icon custom-cart__icon--plus"
      width="10"
      height="10"
      viewBox="0 0 10 10"
      fill="none"
      aria-hidden="true"
      focusable="false"
    >
      <path d="M5 0v10M0 5h10" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
    </svg>
  {%- when 'truck' -%}
    {% comment %}
      <svg class="custom-cart__icon custom-cart__icon--truck" width="22" height="16" viewBox="0 0 22 16" fill="none" aria-hidden="true" focusable="false">
        <path d="M3 4H1.5V12H3" stroke="currentColor" stroke-width="1.1" stroke-linecap="round"/>
        <path d="M5.5 6H1.5" stroke="currentColor" stroke-width="1.1" stroke-linecap="round"/>
        <path d="M5.5 10H2" stroke="currentColor" stroke-width="1.1" stroke-linecap="round"/>
        <path d="M5 3h8v7H5V3z" stroke="currentColor" stroke-width="1.1" stroke-linejoin="round"/>
        <path d="M13 5.5h3.5l2 2.2V10H13V5.5z" stroke="currentColor" stroke-width="1.1" stroke-linejoin="round"/>
        <circle cx="7.5" cy="12.5" r="1.6" stroke="currentColor" stroke-width="1.1"/>
        <circle cx="15.5" cy="12.5" r="1.6" stroke="currentColor" stroke-width="1.1"/>
      </svg>
    {% endcomment %}
    <svg
      class="custom-cart__icon custom-cart__icon--truck"
      aria-hidden="true"
      focusable="false"
      xmlns="http://www.w3.org/2000/svg"
      viewBox="0 0 20 20"
    >
      <path fill="currentColor" fill-rule="evenodd" d="M4.75 4.5a.75.75 0 0 0 0 1.5h3.25a1 1 0 0 1 0 2h-4.75a.75.75 0 0 0 0 1.5h3a.75.75 0 0 1 0 1.5h-2.5a.75.75 0 0 0 0 1.5h.458a2.5 2.5 0 1 0 4.78.75h3.024a2.5 2.5 0 1 0 4.955-.153 1.75 1.75 0 0 0 1.033-1.597v-1.22a1.75 1.75 0 0 0-1.326-1.697l-1.682-.42a.25.25 0 0 1-.18-.174l-.426-1.494a2.75 2.75 0 0 0-2.645-1.995h-6.991Zm2.75 9a1 1 0 1 1-2 0 1 1 0 0 1 2 0Zm8 0a1 1 0 1 1-2 0 1 1 0 0 1 2 0Z"></path>
    </svg>
  {%- when 'info' -%}
    <svg
      class="custom-cart__icon custom-cart__icon--info"
      width="16"
      height="16"
      viewBox="0 0 16 16"
      fill="none"
      aria-hidden="true"
      focusable="false"
    >
      <circle cx="8" cy="8" r="7" stroke="currentColor" stroke-width="1.2"/>
      <path d="M8 7v5M8 5h.01" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
    </svg>
  {%- when 'box' -%}
    <svg
      class="custom-cart__icon custom-cart__icon--box"
      width="18"
      height="18"
      viewBox="0 0 18 18"
      fill="none"
      aria-hidden="true"
      focusable="false"
    >
      <path d="M1 5l8-4 8 4-8 4-8-4z" stroke="currentColor" stroke-width="1.2" stroke-linejoin="round"/>
      <path d="M1 5v8l8 4 8-4V5" stroke="currentColor" stroke-width="1.2" stroke-linejoin="round"/>
      <path d="M9 9v8" stroke="currentColor" stroke-width="1.2"/>
      <path d="M5 7l4 2 4-2" stroke="currentColor" stroke-width="1.2" stroke-linecap="round"/>
    </svg>
  {%- when 'return' -%}
    <svg
      class="custom-cart__icon custom-cart__icon--return"
      width="18"
      height="18"
      viewBox="0 0 18 18"
      fill="none"
      aria-hidden="true"
      focusable="false"
    >
      <path d="M3 9a6 6 0 1 0 1.5-4" stroke="currentColor" stroke-width="1.2" stroke-linecap="round"/>
      <path d="M3 3v4h4" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round"/>
    </svg>
  {%- when 'laptop' -%}
    <svg
      class="custom-cart__icon custom-cart__icon--laptop"
      width="18"
      height="16"
      viewBox="0 0 18 16"
      fill="none"
      aria-hidden="true"
      focusable="false"
    >
      <rect x="1" y="2" width="16" height="10" rx="1" stroke="currentColor" stroke-width="1.2"/>
      <path d="M0 14h18" stroke="currentColor" stroke-width="1.2" stroke-linecap="round"/>
    </svg>
  {%- when 'chevron' -%}
    <svg
      class="custom-cart__icon custom-cart__icon--chevron"
      width="12"
      height="8"
      viewBox="0 0 12 8"
      fill="none"
      aria-hidden="true"
      focusable="false"
    >
      <path d="M1 1.5l5 5 5-5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
    </svg>
  {%- when 'star' -%}
    <svg
      class="custom-cart__icon custom-cart__icon--star"
      width="12"
      height="12"
      viewBox="0 0 12 12"
      fill="currentColor"
      aria-hidden="true"
      focusable="false"
    >
      <path d="M6 0l1.545 3.13L11 3.635 8.5 6.07l.59 3.44L6 7.885 2.91 9.51l.59-3.44L1 3.635l3.455-.505L6 0z"/>
    </svg>
  {%- when 'tag' -%}
    <svg
      class="custom-cart__icon custom-cart__icon--tag"
      width="15"
      height="15"
      viewBox="0 0 15 15"
      fill="currentColor"
      aria-hidden="true"
      focusable="false"
    >
      <path d="M3 1.5h5.17L14 7.33l-5.83 5.83L3 8V1.5zM6.25 4.75a.75.75 0 1 0 0-1.5.75.75 0 0 0 0 1.5z"/>
    </svg>
  {%- when 'spinner' -%}
    <svg
      class="custom-cart__icon custom-cart__icon--spinner"
      width="20"
      height="20"
      viewBox="0 0 20 20"
      fill="none"
      aria-hidden="true"
      focusable="false"
    >
      <circle cx="10" cy="10" r="8" stroke="currentColor" stroke-width="2" stroke-opacity="0.25"/>
      <path d="M18 10a8 8 0 0 0-8-8" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
    </svg>
{%- endcase -%}
