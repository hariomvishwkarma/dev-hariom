<script>
      {% comment %} script to create a modal that display replo elements(images) in it on click, add class in replo elements parent {% endcomment %}
      document.addEventListener("DOMContentLoaded", () => {

        // Utility to wait for an element dynamically
        function waitForElement(selector, callback) {
          const existing = document.querySelector(selector);
          if (existing) return callback(existing);

          const observer = new MutationObserver(() => {
            const el = document.querySelector(selector);
            if (el) {
              callback(el);
              observer.disconnect(); // remove disconnect if you want to handle future re-inserts
            }
          });

          observer.observe(document.body, { childList: true, subtree: true });
        }

        // Function to create a popup with lazy loading and spinner
        function createImagePopup(src) {
          if (document.querySelector("#image-popup")) return;

          const popup = document.createElement("div");
          popup.id = "image-popup";
          Object.assign(popup.style, {
            position: "fixed",
            top: 0,
            left: 0,
            width: "100%",
            height: "100%",
            background: "rgba(0,0,0,0.8)",
            display: "flex",
            alignItems: "center",
            justifyContent: "center",
            zIndex: 9999,
          });

          const imgWrapper = document.createElement("div");
          imgWrapper.style.position = "relative";

          // Spinner
          const spinner = document.createElement("div");
          spinner.innerText = "⏳"; // simple text spinner, can replace with CSS animation
          Object.assign(spinner.style, {
            fontSize: "48px",
            color: "#fff",
            textAlign: "center",
          });
          imgWrapper.appendChild(spinner);

          // Image element
          const img = document.createElement("img");
          img.style.maxWidth = "90vw";
          img.style.maxHeight = "90vh";
          img.style.display = "none"; // hide until loaded
          imgWrapper.appendChild(img);

          // Close button
          const closeBtn = document.createElement("span");

          // Create image for close icon
          const closeImg = document.createElement("img");
          closeImg.src = "https://assets.replocdn.com/projects/a2c7c51a-ec22-4e36-a9ea-6f00296360e2/96863e10-272c-424e-8ec6-1398e4a61ce5";
          closeImg.className = "r-hgvdqp";
          closeImg.loading = "eager";

          // Style wrapper (span)
          Object.assign(closeBtn.style, {
            position: "absolute",
            top: "16px",
            right: "16px",
            cursor: "pointer",
            display: "inline-flex",
            alignItems: "center",
            justifyContent: "center",
          });

          // Style the image (optional tweaks)
          Object.assign(closeImg.style, {
            width: "22px",
            height: "22px",
            filter: "invert(1)", // makes icon white if it's dark
          });

          // Add image to button
          closeBtn.appendChild(closeImg);

          // Add close button inside image wrapper
          imgWrapper.appendChild(closeBtn);

          // Add wrapper to popup and then to document
          popup.appendChild(imgWrapper);
          document.body.appendChild(popup);


          // Preload full image
          const fullImg = new Image();
          fullImg.src = src;
          fullImg.onload = () => {
            spinner.remove(); // remove spinner
            img.src = src;
            img.style.display = "block";
            img.style.opacity = 0;
            img.style.transition = "opacity 0.3s";
            requestAnimationFrame(() => img.style.opacity = 1); // fade-in
          };

          // Close events
          closeBtn.addEventListener("click", () => popup.remove());
          popup.addEventListener("click", e => { if(e.target===popup) popup.remove(); });
        }

        // Main logic: attach click handlers to images inside container
        waitForElement('[data-popup-images-parent="true"]', (container) => {
          console.log("Found container!", container);

          const imageEls = container.querySelectorAll("picture img");
          console.log("Images found:", imageEls);

          imageEls.forEach(img => {
            img.addEventListener("click", () => {
              createImagePopup(img.src);
            });
          });
        });

        // Main logic: attach click handlers to images inside container [PDP widget]
        waitForElement('.picker-group', (container) => {
          console.log("Found container!", container);

          const imageEls = container.querySelectorAll("div img.selected-variant-image");
          console.log("Images found:", imageEls);

          imageEls.forEach(img => {
            img.addEventListener("click", () => {
              createImagePopup(img.src);
            });
          });
        });



      });
    </script>
<script>
      document.addEventListener('click', function (e) {
        const btn = e.target.closest('[data-id="scrollBtn"]');
        if (!btn) return;

        const href = (btn.getAttribute('href') || '').trim();
        if (href && href !== '#' && href.charAt(0) !== '#') return;

        e.preventDefault();

        var target = document.querySelector(
          '#cst_main_product .product__title, #cst_main_product .product__heading, .product__title, #cst_main_product'
        );
        if (!target) return;

        var header = document.querySelector('sticky-header, .header-wrapper, #shopify-section-header');
        var offset = 20;
        if (header) offset += header.getBoundingClientRect().height;
        var top = window.pageYOffset + target.getBoundingClientRect().top - offset;
        window.scrollTo({ top: Math.max(0, top), behavior: 'smooth' });
      });
    </script>
    <style type="text/css">
      body, html {
        width: 100% !important;
        background: white !important;
      }
    </style>
    
  </body>
</html>
