<style>
  #shopify-section-{{ section.id }} {
    {%- if section.settings.background == 'rgba(0,0,0,0)' -%}
      {%- assign section_background = settings.background -%}
    {%- else -%}
      {%- assign section_background = section.settings.background -%}
    {%- endif -%}

    {%- if section.settings.text_color == 'rgba(0,0,0,0)' -%}
      {%- assign text_color = settings.text_color -%}
    {%- else -%}
      {%- assign text_color = section.settings.text_color -%}
    {%- endif -%}

    --section-background: {{ section_background.red }}, {{ section_background.green }}, {{ section_background.blue }};
    --text-color: {{ text_color.red }}, {{ text_color.green }}, {{ text_color.blue }};

    background-color: rgb(var(--section-background));
    padding-top: {{ section.settings.space_top }}px;
    padding-bottom: {{ section.settings.space_bottom }}px;
  }

  @media (max-width: 999px) {
    #shopify-section-{{ section.id }} {
      padding-top: {{ section.settings.space_top_mobile }}px;
      padding-bottom: {{ section.settings.space_bottom_mobile }}px;
    }
  }
</style>

<div class="container">
  <nav aria-label="{{ 'general.breadcrumb.title' | t }}" class="breadcrumb text--xsmall">
    <ol class="breadcrumb__list" role="list">
      <li class="breadcrumb__item">
        <a class="breadcrumb__link" href="{{ routes.root_url }}">{{ 'general.breadcrumb.home' | t }}</a>
      </li>

      {%- if section.settings.custom_label != blank -%}
        <li class="breadcrumb__item">
          {%- if section.settings.custom_link != blank -%}
            <a class="breadcrumb__link" href="{{ section.settings.custom_link }}">{{ section.settings.custom_label | escape }}</a>
          {%- else -%}
            <span class="breadcrumb__link" aria-current="page">{{ section.settings.custom_label | escape }}</span>
          {%- endif -%}
        </li>
      {%- endif -%}

      <li class="breadcrumb__item">
        <span class="breadcrumb__link" aria-current="page">{{ page.title }}</span>
      </li>
    </ol>
  </nav>
</div>

{% schema %}
{
  "name": "STAW | Breadcrumb",
  "class": "shopify-section--staw-breadcrumb",
  "disabled_on": {
    "groups": ["header", "custom.overlay"]
  },
  "settings": [
    {
      "type": "header",
      "content": "Inhalt"
    },
    {
      "type": "text",
      "id": "custom_label",
      "label": "Zwischenseite – Label",
      "info": "Optionaler Elterneintrag zwischen Home und der aktuellen Seite (z.B. \"Beratung\")"
    },
    {
      "type": "url",
      "id": "custom_link",
      "label": "Zwischenseite – Link",
      "info": "Wenn leer, wird das Label ohne Link angezeigt"
    },
    {
      "type": "header",
      "content": "Abstände"
    },
    {
      "type": "range",
      "id": "space_top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "label": "Abstand oben",
      "default": 0
    },
    {
      "type": "range",
      "id": "space_bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "label": "Abstand unten",
      "default": 0
    },
    {
      "type": "range",
      "id": "space_top_mobile",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "label": "Abstand oben (Mobil)",
      "default": 0
    },
    {
      "type": "range",
      "id": "space_bottom_mobile",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "label": "Abstand unten (Mobil)",
      "default": 0
    },
    {
      "type": "header",
      "content": "Farben"
    },
    {
      "type": "color",
      "id": "background",
      "label": "Hintergrund",
      "default": "rgba(0,0,0,0)"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Textfarbe",
      "default": "rgba(0,0,0,0)"
    }
  ],
  "presets": [
    {
      "name": "STAW | Breadcrumb"
    }
  ]
}
{% endschema %}
