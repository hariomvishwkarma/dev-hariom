{%- if section.settings.background_type == 'boxed' -%}
  {%- assign is_boxed = true -%}
{%- else -%}
  {%- assign is_boxed = false -%}
{%- endif -%}

{%- if section.settings.background != settings.background and section.settings.background != 'rgba(0,0,0,0)' -%}
  {%- assign blends_with_background = false -%}
{%- else -%}
  {%- assign blends_with_background = true -%}
{%- endif -%}

<style>
  #shopify-section-{{ section.id }} {
    {%- if section.settings.background == 'rgba(0,0,0,0)' -%}
      {%- assign section_background = settings.background -%}
    {%- else -%}
      {%- assign section_background = section.settings.background -%}
    {%- endif -%}

    {%- if section.settings.text_color == 'rgba(0,0,0,0)' -%}
      {%- assign heading_color = settings.heading_color -%}
      {%- assign text_color = settings.text_color -%}
    {%- else -%}
      {%- assign heading_color = section.settings.text_color -%}
      {%- assign text_color = section.settings.text_color -%}
    {%- endif -%}

    {%- if section.settings.button_background == 'rgba(0,0,0,0)' -%}
      {%- assign button_background = settings.primary_button_background -%}
    {%- else -%}
      {%- assign button_background = section.settings.button_background -%}
    {%- endif -%}

    {%- if section.settings.button_text_color == 'rgba(0,0,0,0)' -%}
      {%- assign button_text_color = settings.primary_button_text_color -%}
    {%- else -%}
      {%- assign button_text_color = section.settings.button_text_color -%}
    {%- endif -%}

    --heading-color: {{ heading_color.red }}, {{ heading_color.green }}, {{ heading_color.blue }};
    --text-color: {{ text_color.red }}, {{ text_color.green }}, {{ text_color.blue }};
    --primary-button-background: {{ button_background.red }}, {{ button_background.green }}, {{ button_background.blue }};
    --primary-button-text-color: {{ button_text_color.red }}, {{ button_text_color.green }}, {{ button_text_color.blue }};
    --prev-next-button-background: {{ settings.background.red }}, {{ settings.background.green }}, {{ settings.background.blue }};
    --prev-next-button-color: {{ settings.text_color.red }}, {{ settings.text_color.green }}, {{ settings.text_color.blue }};

    --section-background: {{ section_background.red }}, {{ section_background.green }}, {{ section_background.blue }};
  }

  #shopify-section-{{ section.id }} {
    background-color: {{ section.settings.background }};
  }

  {%- if section.settings.background_image != blank -%}
  #shopify-section-{{ section.id }} .blog_search_section {
    background-image: url({{ section.settings.background_image | image_url: width: 1920 }});
    background-size: cover;
    background-position: center;
    background-repeat: no-repeat;
  }
  {%- endif -%}

  {%- if section.settings.background_image_mobile != blank -%}
  @media (max-width: 999px) {
    #shopify-section-{{ section.id }} .blog_search_section {
      background-image: url({{ section.settings.background_image_mobile | image_url: width: 740 }});
      background-size: cover;
      background-position: center;
      background-repeat: no-repeat;
    }
  }
  {%- endif -%}

  /* Hide Boost loading/spinner overlays that can cause infinite loading state */
  #shopify-section-{{ section.id }} [class*="boost-sd"][class*="loading"],
  #shopify-section-{{ section.id }} [class*="boost-sd"] .spinner,
  .shopify-section--blog-search [class*="boost-sd"][class*="loading"],
  .shopify-section--main-blog [class*="boost-sd"][class*="loading"] {
    display: none !important;
    visibility: hidden !important;
  }
  /* Hide any Boost-injected icons/buttons inside our blog search form (keep only our input, clear, submit) */
  #shopify-section-{{ section.id }} .blog-search-form-wrapper [class*="boost-sd"]:not(input):not([data-blog-search-input]) {
    display: none !important;
    visibility: hidden !important;
    opacity: 0 !important;
    pointer-events: none !important;
    position: absolute !important;
    width: 0 !important;
    height: 0 !important;
    overflow: hidden !important;
  }

  @media (min-width: 1000px) {
    #shopify-section-{{ section.id }} {
      margin-top: {{ section.settings.space_top -}}px;
      margin-bottom: {{ section.settings.space_bottom -}}px;
    }
  }
  @media (max-width: 999px) {
    #shopify-section-{{ section.id }} {
      margin-top: {{ section.settings.space_top_mobile -}}px;
      margin-bottom: {{ section.settings.space_bottom_mobile -}}px;
    }
  }
</style>

<style>
  .blog_search_section .multi-column__item {
    display: grid;
    grid-template-columns: auto 1fr;
    align-items: center;
    padding: 10px 20px;
    background: {{ section.settings.item_background }};
    gap: 8px;
    border-radius: 8px;
    width: max-content;
    transition: all 0.3s ease;
  }


  /* Active state styling */
  .blog_search_section .multi-column__item.active {
    border-width: 1.5px;
    border-style: solid;
    {% if section.settings.item_border_color_active != 'rgba(0,0,0,0)' %}
      border-color: {{ section.settings.item_border_color_active }};
    {% endif %}
    {% if section.settings.item_text_color_active != 'rgba(0,0,0,0)' %}
      color: {{ section.settings.item_text_color_active }};
    {% endif %}
    {% if section.settings.item_background_active != 'rgba(0,0,0,0)' %}
      background: {{ section.settings.item_background_active }};
    {% endif %}
  }

  .blog_search_section .multi-column__image-wrapper {
    margin: 0;
  }

  .blog_search_section .multi-column__text-container .ed_sub_collections_title {
    font-size: var(--base-font-size);
    line-height: 1;
  }

  .blog_search_section span.sub_collection_icon {
    width: 40px;
    height: 40px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: {{ section.settings.item_icon_background }};
    border-radius: 360px;
    padding: 5px;
  }

  .blog_search_section  span.sub_collection_icon img, span.sub_collection_icon svg {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }
  /* full-width scroller css */
  .full_width_scroller_section .scroller {
      scroll-snap-type: x mandatory;
      margin-inline: calc(-1 * var(--container-gutter));
      scrollbar-width: none;
      overflow: auto hidden;
  }

  @media screen and (min-width: 1000px) {
      .full_width_scroller_section .multi-column__inner--scroller {
          overflow: unset;
      }
  }

  .full_width_scroller_section .multi-column__inner--scroller {
      display: grid;
      min-width: min-content;
      grid-auto-columns: auto;
      gap: 16px;
      justify-content: center;
  }

  .full_width_scroller_section {
      overflow: hidden;
  }

  .full_width_scroller_section .scroller {
      margin-left: 0;
      margin-right: -10%;
  }

  @media (min-width: 1850px) {
      .full_width_scroller_section .scroller {
          margin-right: -20%;
      }
  }

  .full_width_scroller_section .multi-column__inner--scroller {
      padding-left: 0;
      padding-right: 9%;
      grid-auto-flow: column;
      grid-template-columns: none !important;
  }

  @media screen and (min-width: 1000px) {
      .full_width_scroller_section .multi-column__inner:not(.is-scrollable)+.multi-column__prev-next {
          display: flex;
          top: calc(50% - 18.5px);
          width: 100%;
          left: 0;
      }
  }
  @media screen and (min-width: 741px) {
    .blog_search_section .prev-next-button:not(.prev-next-button--small) {
        width: 35px;
        height: 35px;
        border-radius: 360px;
    }
    .blog_search_section .prev-next-button:not(.prev-next-button--small) svg {
        width: 18px;
        height: auto;
    }
  }

  @media (max-width: 740px) {
    .blog_search_section .multi-column__text-container p.heading {
      font-size: calc(var(--base-font-size) - 3px);
    }

    .blog_search_section span.sub_collection_icon {
        width: 34px;
        height: 34px;
    }

    .blog_search_section .multi-column__item {
        padding: 10px 12px;
    }

  }
  /* full-width scroller css */

  @media screen and (min-width: 1000px) {
    .blog_search_section .multi-column__inner--scroller {
          grid-auto-columns: auto;
          overflow: hidden;
      }
      .blog_search_section  .multi-column__prev-next--no-image {
        top: calc(50%);
        transform: translateY(-50%);
    }
  }

  /* Blog search form: rounded bar, input + icon */
  .blog-search-form-wrapper {
    position: relative;
    max-width: 100%;
  }
   .blog-search-form {
    display: flex;
    align-items: center;
    overflow: hidden;
    max-width: fit-content;
    margin-inline: auto;
    border-radius: 8px;
    padding: 0;
    border: none;
    position: relative;
  }

   .blog-search-form__input {
    background: #fff;
    color: #000;
    border-radius: 8px;
    height: 40px;
    padding: 8px 16px;
    display: flex;
    align-items: center;
    text-align: left;
    margin: 0;
    width: 400px;
    max-width: 100%;
    padding-right: 48px;
    border: none;
  }
   /* Style native browser clear (x) on type="search" to match theme */
   .blog-search-form__input::-webkit-search-cancel-button,
   .blog-search-form__input::-webkit-search-decoration {
    -webkit-appearance: none;
    appearance: none;
    width: 14px;
    height: 14px;
    cursor: pointer;
    background: linear-gradient(45deg, transparent 46%, currentColor 46%, currentColor 54%, transparent 54%),
                linear-gradient(-45deg, transparent 46%, currentColor 46%, currentColor 54%, transparent 54%);
    background-repeat: no-repeat;
    background-position: center;
    background-size: 100% 100%;
    opacity: 0.6;
    border-radius: 50%;
    flex-shrink: 0;
  }
   .blog-search-form__input::-webkit-search-cancel-button:hover {
    opacity: 1;
  }
   .blog-search-form__input::-moz-search-cancel-button {
    -moz-appearance: none;
    appearance: none;
    width: 14px;
    height: 14px;
    cursor: pointer;
    background: linear-gradient(45deg, transparent 46%, currentColor 46%, currentColor 54%, transparent 54%),
                linear-gradient(-45deg, transparent 46%, currentColor 46%, currentColor 54%, transparent 54%);
    background-repeat: no-repeat;
    background-position: center;
    background-size: 100% 100%;
    opacity: 0.6;
    border-radius: 50%;
  }
   .blog-search-form__input::-moz-search-cancel-button:hover {
    opacity: 1;
  }
   .blog-search-form__input::placeholder {
    color: rgba(var(--text-color), 0.5);
  }
   .blog-search-form__clear {
    position: absolute;
    right: 10px;
    top: 50%;
    transform: translateY(-50%);
    z-index: 2;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0;
    margin: 0;
    border: none;
    background: transparent;
    color: #55576a;
    cursor: pointer;
    opacity: 0.75;
    line-height: 0;
   }
   .blog-search-form__clear:hover {
    opacity: 1;
   }
   .blog-search-form__clear[hidden] {
    display: none !important;
  }
   .blog-search-form__clear svg {
    display: block;
    width: 16px;
    height: 16px;
   }
   .blog-search-form__submit {
    position: absolute;
    right: 0;
    top: 50%;
    transform: translateY(-50%);
    z-index: 2;
    opacity: 1 !important;
    padding: 10px;
    display: flex;
    align-items: center;
    justify-content: center;
  }
   /* When clear (x) icon is visible (input has value), hide the search icon */
   .blog-search-form-wrapper:has(.blog-search-form__input:not(:placeholder-shown)) .blog-search-form__submit {
    display: none !important;
  }
  .blog-search-form__input::placeholder {
    color: #8F9099;
    font-weight: 600;
    letter-spacing: 1px;
    font-size: 13px;
  }


  {%- if section.settings.results_background != 'rgba(0,0,0,0)' and section.settings.results_background != blank -%}
    {%- assign results_bg_r = section.settings.results_background.red -%}
    {%- assign results_bg_g = section.settings.results_background.green -%}
    {%- assign results_bg_b = section.settings.results_background.blue -%}
  {%- else -%}
    {%- assign results_bg_r = settings.background.red -%}
    {%- assign results_bg_g = settings.background.green -%}
    {%- assign results_bg_b = settings.background.blue -%}
  {%- endif -%}
  {%- if section.settings.results_text_color != 'rgba(0,0,0,0)' and section.settings.results_text_color != blank -%}
    {%- assign results_text_r = section.settings.results_text_color.red -%}
    {%- assign results_text_g = section.settings.results_text_color.green -%}
    {%- assign results_text_b = section.settings.results_text_color.blue -%}
  {%- else -%}
    {%- assign results_text_r = settings.text_color.red -%}
    {%- assign results_text_g = settings.text_color.green -%}
    {%- assign results_text_b = settings.text_color.blue -%}
  {%- endif -%}
  {%- if section.settings.results_border_color != 'rgba(0,0,0,0)' and section.settings.results_border_color != blank -%}
    {%- if section.settings.results_border_color.alpha > 0 -%}
      {%- assign results_border_r = section.settings.results_border_color.red -%}
      {%- assign results_border_g = section.settings.results_border_color.green -%}
      {%- assign results_border_b = section.settings.results_border_color.blue -%}
    {%- else -%}
      {%- assign results_border_r = results_text_r -%}
      {%- assign results_border_g = results_text_g -%}
      {%- assign results_border_b = results_text_b -%}
    {%- endif -%}
  {%- else -%}
    {%- assign results_border_r = results_text_r -%}
    {%- assign results_border_g = results_text_g -%}
    {%- assign results_border_b = results_text_b -%}
  {%- endif -%}
  .blog-search-form__results {
    --results-bg: {{ results_bg_r }}, {{ results_bg_g }}, {{ results_bg_b }};
    --results-text: {{ results_text_r }}, {{ results_text_g }}, {{ results_text_b }};
    --results-border: {{ results_border_r }}, {{ results_border_g }}, {{ results_border_b }};
    --border-color: {{ results_border_r }}, {{ results_border_g }}, {{ results_border_b }};
    position: absolute;
    left: 0;
    right: 0;
    top: 100%;
    margin-top: 8px;
    max-height: 50vh;
    overflow: auto;
    background: rgb(var(--results-bg));
    color: rgb(var(--results-text));
    border: 1px solid rgba(var(--results-border), 0.2);
    border-radius: 12px;
    box-shadow: 0 4px 20px rgba(0,0,0,0.12);
    padding: 12px;
    z-index: 2;
  }
  .blog-search-form__results .predictive-search__article-item {
    list-style: none;
  }
 .blog-search-form__results a {
    color: rgb(var(--results-text));
  }
 .blog-search-form__results a:hover {
    color: rgb(var(--results-text));
    opacity: 0.85;
  }
 .blog-search-form__results .predictive-search__article-title,
 .blog-search-form__results .predictive-search__article-category {
    color: rgb(var(--results-text));
  }
 .blog-search-form__results .predictive-search__article-category.text--subdued {
    opacity: 0.8;
  }
 .blog-search-form__results .predictive-search__article-item + .predictive-search__article-item {
    border-top: 1px solid rgba(var(--results-border), 0.15);
    padding-top: 12px;
    margin-top: 12px;
  }

 .blog-search-form__results p {
    color: rgb(var(--results-text));
  }
  .blog-search-form__loading-state {
    position: absolute;
    top: 100%;
    left: 50%;
    transform: translateX(-50%);
    margin-top: 12px;
    z-index: 2;
  }
  /* Ensure our loading state is only visible when we explicitly show it (avoid Boost/other scripts showing it) */
  #shopify-section-{{ section.id }} .blog-search-form__loading[hidden] {
    display: none !important;
  }
  .blog-search-form__results {
    max-width: 800px;
    margin-inline: auto;
    padding: 24px;
   }

    ul.predictive-search__product-list.list--unstyled {
        margin: 0;
        padding: 0;
    }

    img.predictive-search__article-image, .text-container img:not([style*=float].img.predictive-search__article-image) {
        margin: 0;
        aspect-ratio: 4 / 3;
    }

    .predictive-search__article-info {
        text-align: left;
        padding-block: 20px;
        padding-inline-end: 16px;
    }

    span.predictive-search__article-title {
        font-size: 20px;
        line-height: 1;
        letter-spacing: 0;
        font-weight: 600;
    }

    .blog-search-form__results .predictive-search__article-item,
    .blog-search-form__results .predictive-search__article-item + .predictive-search__article-item {
        padding: 0;
        border-radius: 8px;
    }

    .blog-search-form__results .predictive-search__article-item {
        border-radius: 8px;
        padding: 0;
        overflow: hidden;
        margin-top: 16px;
        border: 1px solid #ddd;
    }

    li.predictive-search__article-item a.article-item.article-item--horizontal {
        box-shadow: none;
    }

    li.predictive-search__article-item a.article-item.article-item--horizontal:hover {
        opacity: 0.9;
        color: unset;
    }

    .blog-search-form__results .predictive-search__article-item:first-child {
        margin-top: 0px;
    }

    @media (max-width: 767px) {
        div#bc-instant-search {
            display: none;
        }
        span.predictive-search__article-title {
            font-size: 14px;
            line-height: 1.5 !important;
        }
        
        .predictive-search__article-info {
            padding-block: 8px;padding-inline-end: 8px;}
        
        .blog-search-form__results .article-item {
            position: relative;
            padding-left: 108px;
            line-height: 1;
        }
        
        span.predictive-search__article-image-wrapper {
            position: absolute;
            left: 0;
            top: 0;
            width: 100px;
            height: 100%;
            margin: 0;
        }
        
        span.predictive-search__article-image-wrapper img.predictive-search__article-image {
            width: 100%;
            height: 100%;
            object-fit: cover;
            margin: 0;
        }
        
        .blog-search-form__results {
            padding: 8px;
        }
        .ed_blog_tags_and_sorting_inner button.popover-button {
            width: 100%;
            border: 1px solid;
            border-radius: 8px;
            display: flex;
            flex-direction: row;
            justify-content: space-between;
            align-items: center;
            padding: 8px 10px;
            line-height: 1;
            gap: 10px;
            font-weight: 600;
            font-size: 16px;
        }
        
        .ed_blog_tags_and_sorting_inner button.popover-button svg {
            width: 17px;
        }
        h3.ed_blog__tags_heading.heading.h5 {
            margin-bottom: 16px;
            line-height: 1;
        }        
    }
</style>

<section class="section blog_search_section {% unless blends_with_background or is_boxed %}section--flush{% endunless %}">
  <div {% if is_boxed %}class="container"{% endif %}>
    <div class="ed_blog_search_wrapper">
      <div class="{% unless is_boxed %}container{% endunless %} {% unless blends_with_background %}vertical-breather{% endunless %}">
        {%- assign text_position = section.settings.text_position -%}
        {%- assign text_alignment = section.settings.text_alignment -%}

        <div class="content-box content-box--{{ section.settings.text_width }} content-box--text-{{ text_alignment }} content-box--{{ text_position }} text-container">
          {%- if section.settings.title != blank -%}
            <h3 class="heading {{ section.settings.heading_tag }}">{{ section.settings.title | escape }}</h3>
          {%- endif -%}

          {%- if section.settings.content != blank -%}
            {{- section.settings.content -}}
          {%- endif -%}

          {% render 'ed-heart-divider', margin: '30px' %}

          <div class="blog_search_section__content">
            <div class="blog-search-form-wrapper" id="blog-search-form-{{ section.id }}" data-no-results="{{ 'search.general.no_results' | t | escape }}" data-no-boost-search-widget="true">
              {%- comment -%} Navigation to /search is blocked in JS (Boost and Enter); this form is AJAX-only. {%- endcomment -%}
              <form action="{{ routes.search_url }}" method="get" class="blog-search-form" role="search" aria-label="{{ 'search.general.title' | t }}" id="blog-search-form-form-{{ section.id }}" data-blog-search-ajax-only>
                <input type="hidden" name="type" value="article">
                {%- comment -%} name="blog_article_q" avoids Boost treating this as a second storefront search (name="q" syncs with header). Submit is blocked; AJAX reads value only. {%- endcomment -%}
                {%- if section.settings.search_placeholder != blank -%}
                  {%- assign blog_search_placeholder = section.settings.search_placeholder -%}
                {%- else -%}
                  {%- assign blog_search_placeholder = 'search.general.search_placeholder' | t -%}
                {%- endif -%}
                <input
                  type="text"
                  name="blog_article_q"
                  inputmode="search"
                  enterkeyhint="search"
                  id="blog-search-input-{{ section.id }}"
                  class="blog-search-form__input"
                  autocomplete="off"
                  autocorrect="off"
                  spellcheck="false"
                  aria-label="{{ 'search.general.title' | t }}"
                  placeholder="{{ blog_search_placeholder | escape }}"
                  data-placeholder="{{ blog_search_placeholder | escape }}"
                  data-blog-search-input
                >
                <button
                  type="button"
                  class="blog-search-form__clear tap-area"
                  data-blog-search-clear
                  hidden
                  aria-label="{{ 'search.general.new_search' | t | escape }}"
                >
                  {% render 'icon' with 'close' %}
                </button>
                <button type="submit" class="blog-search-form__submit tap-area" aria-label="{{ 'search.general.title' | t }}">
                  {% render 'icon' with 'header-search' %}
                </button>
              </form>
              <div class="blog-search-form__results" id="blog-search-results-{{ section.id }}" hidden aria-live="polite"></div>
              <div class="blog-search-form__loading blog-search-form__loading-state" hidden>
                <div class="spinner">{% render 'icon' with 'spinner', stroke_width: 4 %}</div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

{%- if blog -%}
  <script type="application/json" id="blog-search-articles-{{ section.id }}">
    [
      {%- for article in blog.articles limit: 100 -%}
        {%- unless forloop.first -%},{%- endunless -%}
        {
          "title": {{ article.title | json }},
          "excerpt": {{ article.excerpt_or_content | strip_html | truncate: 300 | json }},
          "content": {{ article.content | strip_html | truncate: 500 | json }},
          "url": {{ article.url | json }},
          "image": {% if article.image %}{{ article.image | image_url: width: 280 | json }}{% else %}null{% endif %},
          "tags": {{ article.tags | json }}
        }
      {%- endfor -%}
    ]
  </script>
  <div id="blog-search-arrow-template-{{ section.id }}" style="display:none !important" aria-hidden="true"><span class="article-item__arrow prev-next-button prev-next-button--small prev-next-button--next">{% render 'icon' with 'nav-arrow-right', direction_aware: true, width: 15, height: 12 %}</span></div>
{%- endif -%}

<script>
  (function() {
    var wrapper = document.getElementById('blog-search-form-{{ section.id }}');
    if (!wrapper) return;
    var input = wrapper.querySelector('[data-blog-search-input]');
    var resultsEl = document.getElementById('blog-search-results-{{ section.id }}');
    var loadingEl = wrapper.querySelector('.blog-search-form__loading');
    var clearBtn = wrapper.querySelector('[data-blog-search-clear]');
    if (!input || !resultsEl) return;

    function updateClearButton() {
      var live = wrapper.querySelector('[data-blog-search-input]');
      if (live) input = live;
      if (clearBtn) clearBtn.hidden = !input.value || input.value.length === 0;
    }
    updateClearButton();
    if (clearBtn) {
      clearBtn.addEventListener('click', function (e) {
        e.preventDefault();
        e.stopPropagation();
        var live = wrapper.querySelector('[data-blog-search-input]');
        if (live) input = live;
        input.value = '';
        input.focus();
        updateClearButton();
        closeResults();
        restorePlaceholder();
        var ev = new Event('input', { bubbles: true });
        input.dispatchEvent(ev);
      });
    }

    var intendedPlaceholder = input.getAttribute('data-placeholder') || input.placeholder || '';
    function restorePlaceholder() {
      if (intendedPlaceholder && input.placeholder !== intendedPlaceholder) {
        input.placeholder = intendedPlaceholder;
      }
    }
    restorePlaceholder();
    var observer = new MutationObserver(function(mutations) {
      mutations.forEach(function(m) {
        if (m.attributeName === 'placeholder') restorePlaceholder();
      });
    });
    observer.observe(input, { attributes: true, attributeFilter: ['placeholder'] });
    setTimeout(restorePlaceholder, 500);
    setTimeout(restorePlaceholder, 1500);

    var abortController = null;
    var debounceTimer = null;
    var resultsOpen = false;
    var loadingSafetyTimer = null;

    function closeResults() {
      resultsEl.hidden = true;
      resultsEl.innerHTML = '';
      resultsOpen = false;
    }

    function showResults(html) {
      resultsEl.innerHTML = html;
      resultsEl.hidden = !html || html.trim() === '';
      resultsOpen = !resultsEl.hidden;
    }

    function setLoading(show) {
      if (loadingEl) {
        loadingEl.hidden = !show;
        if (show && !loadingSafetyTimer) {
          loadingSafetyTimer = setTimeout(function() {
            loadingSafetyTimer = null;
            if (loadingEl && !loadingEl.hidden) {
              loadingEl.hidden = true;
            }
          }, 8000);
        } else if (!show && loadingSafetyTimer) {
          clearTimeout(loadingSafetyTimer);
          loadingSafetyTimer = null;
        }
      }
    }

    if (loadingEl) loadingEl.hidden = true;

    var articlesData = [];
    var arrowTemplateHtml = '';
    var noResultsText = (wrapper && wrapper.getAttribute('data-no-results')) || 'No results could be found.';
    try {
      var articlesScript = document.getElementById('blog-search-articles-{{ section.id }}');
      if (articlesScript && articlesScript.textContent) {
        articlesData = JSON.parse(articlesScript.textContent);
      }
      var arrowEl = document.getElementById('blog-search-arrow-template-{{ section.id }}');
      if (arrowEl) arrowTemplateHtml = arrowEl.innerHTML;
    } catch (e) {}

    function buildArticleItemHtml(article, arrowHtml) {
      var title = (article.title || '').replace(/</g, '&lt;').replace(/>/g, '&gt;');
      var url = (article.url || '').replace(/"/g, '&quot;');
      var category = article.tags && article.tags[0] ? ('<span class="predictive-search__article-category heading heading--xxsmall text--subdued">' + String(article.tags[0]).replace(/</g, '&lt;').replace(/>/g, '&gt;') + '</span>') : '';
      var imgHtml = '';
      if (article.image) {
        imgHtml = '<span class="predictive-search__article-image-wrapper">' +
          '<img class="predictive-search__article-image" src="' + String(article.image).replace(/"/g, '&quot;') + '" alt="" loading="lazy">' +
          (arrowHtml ? arrowHtml : '') + '</span>';
      }
      return '<li class="predictive-search__article-item">' +
        '<a class="article-item article-item--horizontal" href="' + url + '" data-instant>' +
        imgHtml +
        '<div class="predictive-search__article-info">' + category +
        '<span class="predictive-search__article-title">' + title + '</span></div></a></li>';
    }

    function doPredictiveSearch(term) {
      term = (term || '').trim();
      if (abortController) abortController.abort();
      if (!term) {
        closeResults();
        setLoading(false);
        return;
      }

      if (articlesData && articlesData.length > 0) {
        var q = term.toLowerCase();
        var matched = [];
        for (var i = 0; i < articlesData.length && matched.length < 10; i++) {
          var a = articlesData[i];
          var title = (a.title || '').toLowerCase();
          var excerpt = (a.excerpt || '').toLowerCase();
          var content = (a.content || '').toLowerCase();
          if (title.indexOf(q) !== -1 || excerpt.indexOf(q) !== -1 || content.indexOf(q) !== -1) {
            matched.push(a);
          }
        }
        setLoading(false);
        if (matched.length > 0) {
          var listHtml = matched.map(function(a) { return buildArticleItemHtml(a, arrowTemplateHtml); }).join('');
          var html = '<div class="predictive-search__results-categories">' +
            '<div class="predictive-search__results-categories-item" id="predictive-search-articles">' +
            '<ul class="predictive-search__product-list list--unstyled" role="list" data-type="articles">' +
            listHtml + '</ul></div></div>';
          showResults(html);
        } else {
          showResults('<p class="text--large">' + noResultsText.replace(/</g, '&lt;').replace(/>/g, '&gt;') + '</p>');
        }
        return;
      }

      abortController = new AbortController();
      setLoading(true);
      var url = window.themeVariables && window.themeVariables.routes && window.themeVariables.routes.predictiveSearchUrl
        ? window.themeVariables.routes.predictiveSearchUrl
        : (window.Shopify && window.Shopify.routes ? window.Shopify.routes.root + 'search/suggest' : '/search/suggest');
      url += '?q=' + encodeURIComponent(term) + '&resources[type]=article&resources[limit]=10&resources[limit_scope]=each&section_id=predictive-search-blog';

      fetch(url, { signal: abortController.signal })
        .then(function(r) { return r.text(); })
        .then(function(text) {
          setLoading(false);
          var parser = new DOMParser();
          var doc = parser.parseFromString(text, 'text/html');
          var sectionEl = doc.querySelector('#shopify-section-predictive-search-blog');
          var html = sectionEl ? sectionEl.innerHTML : '';
          showResults(html);
        })
        .catch(function(err) {
          setLoading(false);
          if (err.name !== 'AbortError') closeResults();
        });
    }

    input.addEventListener('input', function() {
      updateClearButton();
      clearTimeout(debounceTimer);
      debounceTimer = setTimeout(function() { doPredictiveSearch(input.value); }, 200);
    });

    input.addEventListener('focus', function() {
      if (input.value.trim()) doPredictiveSearch(input.value);
    });

    document.addEventListener('click', function(e) {
      if (resultsOpen && wrapper && !wrapper.contains(e.target)) closeResults();
    });

    input.addEventListener('keydown', function(e) {
      if (e.key === 'Escape') { closeResults(); input.blur(); }
    });

    var form = wrapper.querySelector('form[data-blog-search-ajax-only]');
    function trapBlogSearchSubmit(e) {
      var f = e.target;
      if (!(f instanceof HTMLFormElement)) return;
      if (!f.hasAttribute('data-blog-search-ajax-only') || !wrapper.contains(f)) return;
      e.preventDefault();
      e.stopPropagation();
      var liveInput = wrapper.querySelector('[data-blog-search-input]');
      var q = liveInput && typeof liveInput.value === 'string' ? liveInput.value.trim() : '';
      clearTimeout(debounceTimer);
      debounceTimer = null;
      doPredictiveSearch(q);
    }
    if (form) {
      document.addEventListener('submit', trapBlogSearchSubmit, true);
    }

    wrapper.addEventListener(
      'keydown',
      function (e) {
        if (e.key !== 'Enter') return;
        var t = e.target;
        if (!t || !t.closest || !t.closest('[data-blog-search-input]')) return;
        e.preventDefault();
        e.stopPropagation();
        var liveInput = wrapper.querySelector('[data-blog-search-input]');
        var q = liveInput && typeof liveInput.value === 'string' ? liveInput.value.trim() : '';
        clearTimeout(debounceTimer);
        debounceTimer = null;
        doPredictiveSearch(q);
      },
      true
    );

    function stripBoostFromBlogInput() {
      try {
        var el = wrapper.querySelector('[data-blog-search-input]');
        if (!el) return;
        el.setAttribute('id', 'blog-search-input-{{ section.id }}');
        [
          'data-search-box',
          'aria-owns',
          'aria-controls',
          'aria-expanded',
          'aria-haspopup',
          'aria-autocomplete',
          'role',
          'data-event-bound',
          'maxlength',
        ].forEach(function (attr) {
          el.removeAttribute(attr);
        });
        Array.prototype.slice.call(el.classList).forEach(function (c) {
          if (c.indexOf('boost-sd') === 0 || c === 'is-filled') el.classList.remove(c);
        });
        if (el !== input) {
          input = el;
        }
      } catch (err) {}
    }

    var boostStripRaf = null;
    function scheduleStripBoostFromBlogInput() {
      if (boostStripRaf) cancelAnimationFrame(boostStripRaf);
      boostStripRaf = requestAnimationFrame(function () {
        boostStripRaf = null;
        stripBoostFromBlogInput();
      });
    }

    var boostInputObserver = new MutationObserver(function () {
      scheduleStripBoostFromBlogInput();
    });
    function observeBlogSearchInputForBoost() {
      var el = wrapper.querySelector('[data-blog-search-input]');
      if (!el) return;
      boostInputObserver.disconnect();
      boostInputObserver.observe(el, {
        attributes: true,
        attributeFilter: [
          'class',
          'id',
          'role',
          'aria-expanded',
          'aria-owns',
          'aria-controls',
          'data-search-box',
          'data-event-bound',
          'maxlength',
        ],
      });
    }

    document.addEventListener(
      'input',
      function (e) {
        var t = e.target;
        if (!t || !wrapper.contains(t) || !t.hasAttribute('data-blog-search-input')) return;
        stripBoostFromBlogInput();
      },
      true
    );

    stripBoostFromBlogInput();
    observeBlogSearchInputForBoost();
    [150, 500, 1000, 2000, 3500].forEach(function (ms) {
      setTimeout(function () {
        stripBoostFromBlogInput();
        observeBlogSearchInputForBoost();
      }, ms);
    });
  })();
</script>

