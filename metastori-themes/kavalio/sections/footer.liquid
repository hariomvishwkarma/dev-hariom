<style>
  #shopify-section-{{ section.id }} .footer {
    {%- assign border_color = settings.border_color -%}

    --background: {{ settings.footer_background.red }}, {{ settings.footer_background.green }}, {{ settings.footer_background.blue }};
    --heading-color: {{ settings.footer_text_color.red }}, {{ settings.footer_text_color.green }}, {{ settings.footer_text_color.blue }};
    --text-color: {{ settings.footer_text_color.red }}, {{ settings.footer_text_color.green }}, {{ settings.footer_text_color.blue }};
    --border-color: {{ border_color.red }}, {{ border_color.green }}, {{ border_color.blue }};
  }

  #shopify-section-{{ section.id }} .footer {
    background-color: {{ section.settings.background }};
  }
  .award_list {
      display: flex;
      align-items: flex-start;
      gap: 30px;
  }

  .award_list span {
      display: flex;
  }

  .award_list span img {
      width: 100%;
      height: auto;
  }

  ul.footer_payment_icons {
      margin: 0;
      padding: 0;
      list-style: none;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 30px;
      flex-wrap: wrap;
  }

  li.footer_payment_icons_item {
      display: flex;
  }
  .footer__item-content-about {
    margin-bottom: 52px;
  }

  p.footer__item-title.heading.heading--small {
    text-transform: unset;
    font-size: var(--base-font-size);
  }
  @media (min-width: 1000px) {
    #shopify-section-{{ section.id }} .footer {
      padding-top: {{ section.settings.space_top -}}px;
      padding-bottom: {{ section.settings.space_bottom -}}px;
    }
    .footer__inner {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 60px;
    }
    .footer__aside {
      flex-direction: column;
      justify-content: flex-start;
      align-items: flex-start;
      max-width: fit-content;
      margin-left: auto;
      margin-top: 0;
      gap: 48px;
    }
  }
  @media (max-width: 999px) {
    #shopify-section-{{ section.id }} .footer {
      padding-top: {{ section.settings.space_top_mobile -}}px;
      padding-bottom: {{ section.settings.space_bottom_mobile -}}px;
    }
    .footer__aside {
        gap: 48px;
        display: flex;
        flex-direction: column;
        align-items: flex-start;
    }
    .footer_awards_mobile {
      margin-top: 40px;
    }
    .award_list {
        gap: 20px;
        flex-wrap: wrap;
    }
    .footer-mobile-logo {
      margin-bottom: 40px;
    }

    .footer-mobile-logo img {
        width: 100% !important;
        max-width: 100% !important;
    }
  }

  @media (max-width: 740px) {
    .footer__item-list .footer__item.footer__item--links:nth-child(3) {
      max-width: 100%;
      width: 100%;
      grid-column: 1/-1;
    }

    .footer__item-list .footer__item.footer__item--links:nth-child(3) .linklist {
        column-count: 2;
    }
    ul.footer_payment_icons {
      gap: 20px;
    }
  }

  @media (max-width: 400px) {
    ul.footer_payment_icons {
      gap: 14px;
      justify-content: flex-start;
    }
  }


  {%- for block in section.blocks -%}
    {%- if block.type == 'footer_bottom' -%}
      @media (min-width: 1000px) {
        #shopify-section-{{ section.id }} .footer_bottom_wrap {
          margin-top: {{ block.settings.space_top -}}px;
        }
      }

      @media (max-width: 999px) {
        #shopify-section-{{ section.id }} .footer_bottom_wrap {
          margin-top: {{ block.settings.space_top_mobile -}}px;
        }
      }
    {%- endif -%}
  {%- endfor -%}

</style>

{%- for block in section.blocks -%}
  {%- if block.type == 'footer_aside' -%}
    {% capture footer_logo %}
      {%- if block.settings.image != blank -%}
          {%- capture sizes_attribute -%}{{ block.settings.image_width }}px{%- endcapture -%}
          {%- capture style_attribute -%}width: {{ block.settings.image_width }}px{%- endcapture -%}
          {%- assign footer_logo_alt = block.settings.image.alt | default: 'Kavalio' -%}
          {{- block.settings.image | image_url: width: block.settings.image.width | image_tag: loading: 'lazy', style: style_attribute, sizes: sizes_attribute, widths: '100,200,300,400,500,600', class: 'footer__image', alt: footer_logo_alt -}}
      {%- endif -%}
    {% endcapture %}


    {%- assign awards_images_available = false -%}
    {%- capture award_list_images -%}
      {% for i in (1..5) %}
        {% assign award_image_key = 'award_image_0' | append: i %}
        {% assign award_image_width_key = 'award_image_width_0' | append: i %}
        {% assign award_image = block.settings[award_image_key] %}
        {% assign award_image_width = block.settings[award_image_width_key] %}
        {% if award_image != blank %}
          {%- assign awards_images_available = true -%}
          <span style="width: {{- award_image_width -}}px">
            {%- capture award_image_sizes -%}{{ award_image_width }}px{%- endcapture -%}
            {%- assign award_image_src_width = award_image_width | times: 3 | at_most: 150 -%}
            {%- assign footer_award_image_alt = award_image.alt | default: 'Auszeichnung' -%}
            {{- award_image | image_url: width: award_image_src_width | image_tag: loading: 'lazy', decoding: 'async', sizes: award_image_sizes, widths: '50,75,100,150', alt: footer_award_image_alt, title: footer_award_image_alt -}}
          </span>
        {% endif %}
      {% endfor %}
    {%- endcapture -%}
  {%- endif -%}
{%- endfor -%}


<footer class="footer {% if settings.footer_background == settings.background %}footer--bordered{% endif %}">
  <div class="container">
    <div class="footer-mobile-logo hidden-pocket hidden-lap-and-up">
      {{ footer_logo }}
    </div>

    <div class="footer__inner">
      <div class="footer__item-list">
        {%- for block in section.blocks -%}
          {%- capture block_content -%}
            {%- case block.type -%}
              {%- when 'about' -%}
                {%- assign menu = block.settings.menu -%}
                {%- if menu != blank -%}
                  <p class="footer__item-title heading heading--small">{{ menu.title }}</p>

                  <div class="footer__item-content footer__item-content-about">
                    <ul class="linklist list--unstyled" role="list">
                      {%- for link in menu.links -%}
                        <li class="linklist__item">
                          <a href="{{ link.url }}" class="link--faded">{{ link.title }}</a>
                        </li>
                      {%- endfor -%}
                    </ul>
                  </div>
                {%- endif -%}

                {%- if block.settings.title != blank -%}
                  <p class="footer__item-title heading heading--small">{{ block.settings.title | escape }}</p>
                {%- endif -%}

                {%- if block.settings.content != blank -%}
                  <div class="footer__item-content">
                    {{- block.settings.content -}}
                  </div>
                {%- endif -%}

              {%- when 'links' -%}
                {%- assign menu = block.settings.menu -%}
                {%- if menu != blank -%}
                  <p class="footer__item-title heading heading--small">{{ menu.title }}</p>

                  <div class="footer__item-content">
                    <ul class="linklist list--unstyled" role="list">
                      {%- for link in menu.links -%}
                        <li class="linklist__item">
                          <a href="{{ link.url }}" class="link--faded">{{ link.title }}</a>
                        </li>
                      {%- endfor -%}
                    </ul>
                  </div>
                {%- endif -%}
            {%- endcase -%}
          {%- endcapture -%}

          {%- if block_content != blank -%}
            <div class="footer__item footer__item--{{ block.type | replace: '_', '-' }} {% if forloop.first %}is-first{% endif %}" {{ block.shopify_attributes }}>
              {{- block_content -}}
            </div>
          {%- endif -%}
        {%- endfor -%}
      </div>

      {%- for block in section.blocks -%}
        {%- if block.type == 'footer_aside' -%}
          <div class="footer__aside" {{ block.shopify_attributes }}>
            <div class="hidden-pocket">
              {{ footer_logo }}
            </div>

            {%- if awards_images_available -%}
              <div class="award_list hidden-pocket">
                {{ award_list_images }}
              </div>
            {%- endif -%}


            <div class="social_and_payment_icons_wrap">
              {% if block.settings.show_social_icons %}
                {%- render 'social-media' -%}
              {% endif %}
              {% if block.settings.show_payment_icons %}
                {%- render 'footer-payment-icons', block: block, section: section -%}
              {% endif %}
            </div>

            {%- if section.settings.show_country_selector and localization.available_countries.size > 1 -%}
              {%- assign country_selector = true -%}
            {%- endif -%}

            {%- if section.settings.show_locale_selector and localization.available_languages.size > 1 -%}
              {%- assign locale_selector = true -%}
            {%- endif -%}

            {%- if country_selector or locale_selector -%}
              {%- form 'localization', id: 'localization_form_footer', class: 'footer__cross-border' -%}
                {%- if country_selector -%}
                  <div class="popover-container">
                    <input type="hidden" name="country_code" value="{{ localization.country.iso_code }}">
                    <span class="visually-hidden">{{ 'footer.general.country' | t }}</span>

                    <button type="button" is="toggle-button" class="select select--small {% if locale_selector and settings.button_border_radius > 0 %}select--collapse-end{% endif %} text--xsmall" aria-expanded="false" aria-controls="footer-currency-selector">
                      {{- localization.country.name }} ({{ localization.country.currency.iso_code }} {% if localization.country.currency.symbol %}{{ localization.country.currency.symbol }}{%- endif -%})
                      {%- render 'icon' with 'chevron', width: 9, height: 6, inline: true -%}
                    </button>

                    <popover-content id="footer-currency-selector" class="popover popover--top popover--left popover--small">
                      <span class="popover__overlay"></span>

                      <header class="popover__header">
                        <span class="popover__title heading h6">{{- 'footer.general.country' | t -}}</span>

                        <button type="button" class="popover__close-button tap-area tap-area--large" data-action="close" title="{{ 'general.accessibility.close' | t | escape }}">
                          {%- render 'icon' with 'close' -%}
                        </button>
                      </header>

                      <div class="popover__content popover__content--restrict">
                        <div class="popover__choice-list">
                          {%- for country in localization.available_countries -%}
                            <button type="submit" name="country_code" value="{{ country.iso_code }}" class="popover__choice-item">
                              <span class="popover__choice-label" {% if country.iso_code == localization.country.iso_code %}aria-current="true"{% endif %}>
                                {{- country.name }} ({{ country.currency.iso_code }} {% if country.currency.symbol %}{{ country.currency.symbol }}{%- endif -%})
                              </span>
                            </button>
                          {%- endfor -%}
                        </div>
                      </div>
                    </popover-content>
                  </div>
                {%- endif -%}

                {%- if locale_selector -%}
                  <div class="popover-container">
                    <input type="hidden" name="locale_code" value="{{ localization.language.iso_code }}">
                    <span class="visually-hidden">{{ 'footer.general.language' | t }}</span>

                    <button type="button" is="toggle-button" class="select select--small {% if country_selector and settings.button_border_radius > 0 %}select--collapse-start{% endif %} text--xsmall" aria-expanded="false" aria-controls="footer-locale-selector">
                      {{- localization.language.endonym_name | capitalize -}}
                      {%- render 'icon' with 'chevron', width: 9, height: 6, inline: true -%}
                    </button>

                    <popover-content id="footer-locale-selector" class="popover popover--top popover--small">
                      <span class="popover__overlay"></span>

                      <header class="popover__header">
                        <span class="popover__title heading h6">{{- 'footer.general.language' | t -}}</span>

                        <button type="button" class="popover__close-button tap-area tap-area--large" data-action="close" title="{{ 'general.accessibility.close' | t | escape }}">
                          {%- render 'icon' with 'close' -%}
                        </button>
                      </header>

                      <div class="popover__content">
                        <div class="popover__choice-list">
                          {%- for language in localization.available_languages -%}
                            <button type="submit" name="locale_code" value="{{ language.iso_code }}" class="popover__choice-item">
                              <span class="popover__choice-label" {% if language.iso_code == localization.language.iso_code %}aria-current="true"{% endif %}>
                                {{- language.endonym_name | capitalize -}}
                              </span>
                            </button>
                          {%- endfor -%}
                        </div>
                      </div>
                    </popover-content>
                  </div>
                {%- endif -%}
              {%- endform -%}
            {%- endif -%}

            {% if block.settings.shipping_with_text != blank or block.settings.shipping_with_image != blank %}
              <div class="footer__shipping-with" style="--shipping-image-max-height: {{ block.settings.shipping_with_image_height }}px;">
                {% if block.settings.shipping_with_text != blank %}
                  <h6 class="footer__shipping-with-text heading heading--small">{{ block.settings.shipping_with_text }}</h6>
                {% endif %}

                {% if block.settings.shipping_with_image != blank %}
                  {%- assign shipping_with_text_alt = block.settings.shipping_with_text | strip_html | strip -%}
                  {%- assign shipping_with_image_alt = block.settings.shipping_with_image.alt | default: shipping_with_text_alt | default: 'Versandarten' -%}
                  {{- block.settings.shipping_with_image | image_url: width: block.settings.shipping_with_image.width | image_tag: sizes: '100vw', widths: '300, 450', alt: shipping_with_image_alt -}}
                {% endif %}
              </div>
            {% endif %}

            {%- if shop.features.follow_on_shop? and section.settings.enable_follow_on_shop -%}
              <div class="footer__follow-on-shop">
                {{- shop | login_button: action: 'follow' -}}
              </div>
            {%- endif -%}
          </div>
        {%- endif -%}
      {%- endfor -%}
    </div>

    {% for block in section.blocks %}
      {% if block.type == 'footer_bottom' %}
        <div class="footer_bottom_wrap footer__item-list">
          {%- for i in (1..7) -%}
            {%- assign menu_key = 'menu_0' | append: i -%}
            {%- assign menu = block.settings[menu_key] -%}

            {%- if menu != blank -%}
              <div class="footer_bottom__item footer__item footer__item--{{ i }}" {{ block.shopify_attributes }}>
                <p class="footer__item-title heading heading--small">{{ menu.title }}</p>

                <div class="footer__item-content">
                  <ul class="linklist list--unstyled" role="list">
                    {%- for link in menu.links -%}
                      <li class="linklist__item">
                        <a href="{{ link.url }}" class="link--faded">{{ link.title }}</a>
                      </li>
                    {%- endfor -%}
                  </ul>
                </div>
              </div>
            {% endif %}
          {%- endfor -%}
        </div>
      {% endif %}
    {% endfor %}

    <div class="footer_awards_mobile hidden-lap-and-up">
      {%- if awards_images_available -%}
        <div class="award_list">
          {{ award_list_images }}
        </div>
      {%- endif -%}
    </div>
  </div>
</footer>

{% schema %}
