{%- assign is_visible = false -%}
{%- if section.settings.announcement_bar_visibility == 'all' -%}
  {%- assign is_visible = true -%}
{%- elsif section.settings.announcement_bar_visibility == 'home' and template.name == 'index' -%}
  {%- assign is_visible = true -%}
{%- elsif section.settings.announcement_bar_visibility == 'product' and template.name == 'product' -%}
  {%- assign is_visible = true -%}
{%- elsif section.settings.announcement_bar_visibility == 'collection' and template.name == 'collection' -%}
  {%- assign is_visible = true -%}
{%- endif -%}

{%- assign has_reviewsio_rating_bar = false -%}
{%- for block in section.blocks -%}
  {%- if block.type == 'trusted_shops'
    and block.settings.widget_type == 'reviewsio'
    and block.settings.widget_html contains 'reviews-io-rating-bar-widget'
  -%}
    {%- assign has_reviewsio_rating_bar = true -%}
    {%- break -%}
  {%- endif -%}
{%- endfor -%}

{%- assign is_sticky = false -%}
{%- if section.settings.announcement_bar_sticky_pages == 'all' -%}
  {%- assign is_sticky = true -%}
{%- elsif section.settings.announcement_bar_sticky_pages == 'home' and template.name == 'index' -%}
  {%- assign is_sticky = true -%}
{%- elsif section.settings.announcement_bar_sticky_pages == 'product' and template.name == 'product' -%}
  {%- assign is_sticky = true -%}
{%- elsif section.settings.announcement_bar_sticky_pages == 'collection' and template.name == 'collection' -%}
  {%- assign is_sticky = true -%}
{%- endif -%}
{%- if section.blocks.size > 0 and is_visible -%}
  <section>
    {% unless section.settings.show_timer %}
   <!-- Trusted shop Mobile -->
      {%- for block in section.blocks -%}
        {% if block.type == 'trusted_shops' and block.settings.full_width_on_mobile == true %}
          <section class="announcement_trusted_shop_wrapper hidden-lap-and-up">
            <div class="container">
              {% if block.settings.widget_type == 'reviewsio' %}
                <div class="announcement-bar-reviewsio" {{ block.shopify_attributes }}>
                  <a
                    href="https://www.reviews.io/company-reviews/store/kavalio"
                    target="_blank"
                    rel="noopener"
                    style="display: block; text-decoration: none; color: inherit; cursor: pointer;"
                  >
                    <div style="pointer-events: none;">
                      {% render 'announcement-reviewsio', block: block, settings: block.settings %}
                    </div>
                  </a>
                </div>
              {% elsif block.settings.widget_type == 'metafield' %}
                <div class="announcement-bar-reviewsio" {{ block.shopify_attributes }}>
                  {% render 'announcement-reviewsio-metafield', block: block, settings: block.settings %}
                </div>
              {% else %}
                {% capture trusted_shops_content_mobile %}
                    <span>
                      {%- if block.settings.rating_icon_as_svg != blank -%}
                      <span class="rating-icon-svg" style="width: {{- block.settings.rating_icon_as_size -}}px">
                        {{ block.settings.rating_icon_as_svg }}
                      </span>
                    {%- endif %}
                    <span>{{ block.settings.text }}</span>
                    </span>
      
                    {%- if block.settings.icon_as_svg != blank -%}
                      <span class="ed-icon-wrap" style="max-width: {{- block.settings.icon_as_size -}}px">
                        {{ block.settings.icon_as_svg }}
                      </span>
                    {%- elsif block.settings.icon_as_image != blank -%}
                      <span class="ed-icon-wrap" style="max-width: {{- block.settings.icon_as_size -}}px">
                        {{-
                          block.settings.icon_as_image
                          | image_url: width: block.settings.icon_as_image.width
                          | image_tag:
                            sizes: '100vw',
                            widths: '25,50,75,100',
                            alt: block.settings.icon_as_image.alt,
                            class: 'ed_icon-img'
                        -}}
                      </span>
                    {%- endif -%}
                {% endcapture %}

                <div
                  class="announcement-message"
                  {{ block.shopify_attributes }}
                >
                  {% if block.settings.link != blank %}
                    <a href="{{ block.settings.link }}">
                      {{ trusted_shops_content_mobile }}
                    </a>
                  {% else %}
                    {{ trusted_shops_content_mobile }}
                  {% endif %}

                  {% if block.settings.btn_text != blank %}
                    <a href="{{ block.settings.btn_link }}" class="announcement-message-btn">
                      {{- block.settings.btn_text -}}
                    </a>
                  {% endif %}
                </div>
              {% endif %}
            </div>
          </section>
        {% endif %}
      {%- endfor -%}
      <!-- END:Trusted shop Mobile -->

      <section class="announcement_bar_wrapper">
        <div class="container">
          <div class="announcement-bar-inner hidden-pocket">
            {% for block in section.blocks %}
              {% if block.type == 'message' %}
                {% capture message_content %}
                  {%- if block.settings.icon_as_svg != blank -%}
                    <span class="ed-icon-wrap" style="max-width: {{- block.settings.icon_as_size -}}px">
                      {{ block.settings.icon_as_svg }}
                    </span>
                   {%- elsif block.settings.icon_as_image != blank -%}
                    <span class="ed-icon-wrap" style="max-width: {{- block.settings.icon_as_size -}}px">
                      {{-
                        block.settings.icon_as_image
                        | image_url: width: block.settings.icon_as_image.width
                        | image_tag:
                          sizes: '100vw',
                          widths: '25,50,75,100',
                          alt: block.settings.icon_as_image.alt,
                          class: 'ed_icon-img'
                      -}}
                    </span>
                  {%- endif -%}

                  <span>{{ block.settings.text }}</span>
                {% endcapture %}

                <div
                  class="announcement-message"
                  {{ block.shopify_attributes }}
                >
                  {% if block.settings.link != blank %}
                    <a href="{{ block.settings.link }}">
                      {{ message_content }}
                    </a>
                  {% else %}
                    {{ message_content }}
                  {% endif %}

                  {% if block.settings.btn_text != blank %}
                    <a href="{{ block.settings.btn_link }}" class="announcement-message-btn">
                      {{- block.settings.btn_text -}}
                    </a>
                  {% endif %}
                </div>
              {% endif %}

              {% if block.type == 'trusted_shops' %}
                {% if block.settings.widget_type == 'reviewsio' %}
                  <a
                    href="https://www.reviews.io/company-reviews/store/kavalio"
                    target="_blank"
                    rel="noopener"
                    style="display: block; text-decoration: none; color: inherit; cursor: pointer;"
                  >
                    <div style="pointer-events: none;">
                      {% render 'announcement-reviewsio', block: block, settings: block.settings %}
                    </div>
                  </a>
                {% elsif block.settings.widget_type == 'metafield' %}
                  <div class="announcement-bar-reviewsio" {{ block.shopify_attributes }}>
                    {% render 'announcement-reviewsio-metafield', block: block, settings: block.settings %}
                  </div>
                {% else %}
                  {% capture trusted_shops_content %}
                  {%- if block.settings.icon_as_svg != blank -%}
                    <span class="ed-icon-wrap" style="max-width: {{- block.settings.icon_as_size -}}px">
                      {{ block.settings.icon_as_svg }}
                    </span>
                  {%- elsif block.settings.icon_as_image != blank -%}
                    <span class="ed-icon-wrap" style="max-width: {{- block.settings.icon_as_size -}}px">
                      {{-
                        block.settings.icon_as_image
                        | image_url: width: block.settings.icon_as_image.width
                        | image_tag:
                          sizes: '100vw',
                          widths: '25,50,75,100',
                          alt: block.settings.icon_as_image.alt,
                          class: 'ed_icon-img'
                      -}}
                    </span>
                  {%- endif -%}

                  {%- if block.settings.rating_icon_as_svg != blank -%}
                    <span class="rating-icon-svg" style="width: {{- block.settings.rating_icon_as_size -}}px">
                      {{ block.settings.rating_icon_as_svg }}
                    </span>
                  {%- endif %}
                  <span>{{ block.settings.text }}</span>
                {% endcapture %}

                  <div
                    class="announcement-message {% if block.settings.full_width_on_mobile %}hidden-pocket{% endif %}"
                    {{ block.shopify_attributes }}
                  >
                    {% if block.settings.link != blank %}
                      <a href="{{ block.settings.link }}">
                        {{ trusted_shops_content }}
                      </a>
                    {% else %}
                      {{ trusted_shops_content }}
                    {% endif %}

                    {% if block.settings.btn_text != blank %}
                      <a href="{{ block.settings.btn_link }}" class="announcement-message-btn">
                        {{- block.settings.btn_text -}}
                      </a>
                    {% endif %}
                  </div>
                {% endif %}
              {% endif %}
            {% endfor %}
          </div>

          <div class="announcement-bar-inner  hidden-lap-and-up">
            <div class="swiper announcement-bar-swiper-slider">
              <div class="swiper-wrapper">
                {% for block in section.blocks %}
                  {% if block.type == 'message' %}
                    {% capture message_content %}
                      {%- if block.settings.icon_as_svg != blank -%}
                        <span class="ed-icon-wrap" style="max-width: {{- block.settings.icon_as_size -}}px">
                          {{ block.settings.icon_as_svg }}
                        </span>
                      {%- elsif block.settings.icon_as_image != blank -%}
                        <span class="ed-icon-wrap" style="max-width: {{- block.settings.icon_as_size -}}px">
                          {{-
                            block.settings.icon_as_image
                            | image_url: width: block.settings.icon_as_image.width
                            | image_tag:
                              sizes: '100vw',
                              widths: '25,50,75,100',
                              alt: block.settings.icon_as_image.alt,
                              class: 'ed_icon-img'
                          -}}
                        </span>
                      {%- endif -%}
      
                      <span>{{ block.settings.text }}</span>
                    {% endcapture %}

                    {% if message_content != blank %}
                      <div class="announcement-message swiper-slide" {{ block.shopify_attributes }}>
                        {% if block.settings.link != blank %}
                          <a href="{{ block.settings.link }}">
                            {{ message_content }}
                          </a>
                        {% else %}
                          {{ message_content }}
                        {% endif %}

                        {% if block.settings.btn_text != blank %}
                          <a href="{{ block.settings.btn_link }}" class="announcement-message-btn">
                            {{- block.settings.btn_text -}}
                          </a>
                        {% endif %}
                      </div>
                    {% endif %}
                  {% endif %}
                {% endfor %}
              </div>
            </div>
          </div>
        </div>
      </section>
    {% endunless %}

    <!-- show timer -->
    {% if section.settings.show_timer %}
      <div class="announcementbar-countdown-timer">
        <div class="container">
          {% if section.settings.timer_text_before != blank %}
            <a href="{{ section.settings.timer_link }}">
              <div class="announcementbar-countdown-timer-text">{{ section.settings.timer_text_before }}</div>
            </a>
          {% endif %}
          <a href="{{ section.settings.timer_link }}">
            <div id="announcement_timer"></div>
          </a>
          {% if section.settings.timer_text_after != blank %}
            <a href="{{ section.settings.timer_link }}">
              <div class="announcementbar-countdown-timer-text">{{ section.settings.timer_text_after }}</div>
            </a>
          {% endif %}
        </div>
      </div>
    {% endif %}

    <!-- show additonal bar -->
    {% if section.settings.show_additional_bar %}
      <div class="additional-announcement-bar">
        <div class="container">
          <a href="{{ section.settiings.additional_link }}">{{ section.settings.additional_text }}</a>
          <svg
            width="11"
            height="11"
            viewBox="0 0 11 11"
            fill="none"
            xmlns="http://www.w3.org/2000/svg"
            class="icon-additional-close"
          >
            <path d="M6.41983 5.48618L10.8284 1.07765C10.9413 0.956417 11.0028 0.796068 10.9999 0.630385C10.997 0.464702 10.9299 0.306621 10.8127 0.189447C10.6955 0.0722733 10.5374 0.00515435 10.3717 0.00223106C10.2061 -0.000692223 10.0457 0.0608084 9.92448 0.173776L5.51595 4.5823L1.10743 0.171644C0.986191 0.0586765 0.825842 -0.00282365 0.660159 9.96373e-05C0.494475 0.00302292 0.336395 0.0701415 0.219221 0.187315C0.102047 0.304489 0.0349283 0.46257 0.032005 0.628253C0.0290818 0.793936 0.0905823 0.954285 0.20355 1.07552L4.61208 5.48618L0.20355 9.89471C0.140716 9.95326 0.0903189 10.0239 0.0553645 10.1023C0.0204101 10.1808 0.00161462 10.2654 9.95285e-05 10.3513C-0.00141556 10.4372 0.0143808 10.5225 0.0465461 10.6021C0.0787113 10.6817 0.126586 10.7541 0.187316 10.8148C0.248045 10.8755 0.320384 10.9234 0.400017 10.9556C0.47965 10.9878 0.564947 11.0035 0.650817 11.002C0.736688 11.0005 0.821374 10.9817 0.899823 10.9468C0.978272 10.9118 1.04888 10.8614 1.10743 10.7986L5.51595 6.39006L9.92448 10.7986C10.0457 10.9115 10.2061 10.9731 10.3717 10.9701C10.5374 10.9672 10.6955 10.9001 10.8127 10.7829C10.9299 10.6657 10.997 10.5077 10.9999 10.342C11.0028 10.1763 10.9413 10.0159 10.8284 9.89471L6.41983 5.48618Z" fill="white"></path>
          </svg>
        </div>
      </div>
    {% endif %}
  </section>
{%- endif -%}

<style>
  :root {
    {% if is_sticky %}
      {% if section.settings.announcement_bar_position == 'sticky' or section.settings.announcement_bar_position == 'sticky_mobile' %}
        --enable-sticky-announcement-bar: 1;
      {% else %}
        --enable-sticky-announcement-bar: 0;
      {% endif %}
    {% else %}
      --enable-sticky-announcement-bar: 0;
    {% endif %}
  }

  #shopify-section-{{ section.id }} {
    {% if is_sticky %}
      {% if section.settings.announcement_bar_position == 'sticky' or section.settings.announcement_bar_position == 'sticky_mobile' %}
        position: -webkit-sticky;
        position: sticky;
        top: 0;
        z-index: 5;
      {% else %}
        position: relative;
      {% endif %}
    {% else %}
      position: relative;
    {% endif %}
  }
  .announcement_trusted_shop_wrapper {
    background-color: {{ section.settings.background }};
  }
    #shopify-section-{{ section.id }} .announcement-message,
    #shopify-section-{{ section.id }} .announcement-message * {
      color: {{ section.settings.text_color }};
    }

  @media (min-width: 1000px) {
    #shopify-section-{{ section.id }} .announcement_bar_wrapper {
      background-color: {{ section.settings.background }};
    }
  }
  @media (max-width: 999px) {
    #shopify-section-{{ section.id }} .announcement_bar_wrapper {
      background-color: {{ section.settings.background_mobile }};
    }
    #shopify-section-{{ section.id }} .announcement_bar_wrapper .announcement-message,
    #shopify-section-{{ section.id }} .announcement_bar_wrapper .announcement-message * {
      color: {{ section.settings.text_color_mobile }} !important;
    }
    #shopify-section-{{ section.id }} .announcement_bar_wrapper .announcement-message svg path {
      fill: {{ section.settings.text_color_mobile }} !important;
    }
  }

  @media screen and (min-width: 741px) {
    :root {
      {% if is_sticky %}
        {% if section.settings.announcement_bar_position == 'sticky' or section.settings.announcement_bar_position == 'sticky_desktop' %}
          --enable-sticky-announcement-bar: 1;
        {% else %}
          --enable-sticky-announcement-bar: 0;
        {% endif %}
      {% else %}
        --enable-sticky-announcement-bar: 0;
      {% endif %}
    }

    #shopify-section-{{ section.id }} {
      {% if is_sticky %}
        {% if section.settings.announcement_bar_position == 'sticky' or section.settings.announcement_bar_position == 'sticky_desktop' %}
          position: -webkit-sticky;
          position: sticky;
          top: 0;
          z-index: 5;
        {% else %}
          position: relative;
          z-index: unset;
        {% endif %}
      {% else %}
        position: relative;
        z-index: unset;
      {% endif %}
    }
  }

  .shopify-section--announcement-bar .container {
      padding-block: 6px;
  }

  .shopify-section--announcement-bar .container .announcement-message,
  .shopify-section--announcement-bar .container .announcement-bar-reviewsio {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .shopify-section--announcement-bar .container .announcement-message *,
  .shopify-section--announcement-bar .container .announcement-bar-reviewsio {
    font-size: 12px;
    line-height: 1.2;
  }

  .shopify-section--announcement-bar .container .announcement-message .not-link {
    cursor: auto;
    pointer-events: none;
  }

  .shopify-section--announcement-bar .container .announcement-message svg {
    max-width: 20px;
    height: auto;
  }

  .shopify-section--announcement-bar .container .announcement-message > a,
  .shopify-section--announcement-bar .announcement-bar-reviewsio > a {
    display: inline-flex;
    align-items: center;
    gap: 8px;
  }

  .shopify-section--announcement-bar .announcement-bar-reviewsio > a {
    justify-content: center;
  }

  .shopify-section--announcement-bar .reviewsio-meta-link {
    color: inherit;
    text-decoration: none;
    cursor: pointer;
  }

  .shopify-section--announcement-bar .reviewsio-meta-widget {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: flex-start;
    box-sizing: border-box;
    width: auto;
    max-width: 100%;
    min-height: 24px;
    padding: 3px 1px 0;
    color: #fff;
  }

  .shopify-section--announcement-bar .reviewsio-meta-logo {
    display: block;
    width: auto;
    height: 14px;
    margin: 0 10px 3px 0;
  }

  .shopify-section--announcement-bar .reviewsio-meta-stars {
    display: flex;
    align-items: center;
    margin: 0 10px 5px 0;
  }

  .shopify-section--announcement-bar .reviewsio-meta-star {
    position: relative;
    display: block;
    flex: 0 0 16px;
    width: 16px;
    height: 16px;
    color: #fff;
  }

  .shopify-section--announcement-bar .reviewsio-meta-star svg {
    display: block;
    width: 16px;
    height: 16px;
    fill: currentColor;
  }

  .shopify-section--announcement-bar .reviewsio-meta-text {
    margin: 0 0 3px;
    color: #fff;
    font-size: 12.25px;
    font-weight: 600;
    line-height: 17.15px;
    white-space: nowrap;
  }

  @media (max-width: 999px) {
    .shopify-section--announcement-bar .reviewsio-meta-widget {
      min-height: 28px;
    }
  }

  .shopify-section--announcement-bar .announcement-bar-inner {
    display: flex;
    flex-wrap: wrap;
    gap: 5px;
    justify-content: space-between;
    align-items: center;
  }

  .shopify-section--announcement-bar .announcement-bar-reviewsio {
    width: 100%;
    justify-content: center;
  }

  .shopify-section--announcement-bar .announcement-bar-inner > *:not(.announcement-bar-reviewsio) {
    width: calc(50% - 2.5px);
  }

  @media (max-width: 999px) {
    .shopify-section--announcement-bar .announcement-bar-inner > .announcement-message:nth-of-type(odd) {
      justify-content: flex-end;
    }
    .shopify-section--announcement-bar .container .announcement-bar-reviewsio{
      order: -1;
    }
    .shopify-section--announcement-bar .container .announcement-message {
      padding-block: 6px;
    }
  }

  #shopify-section-{{ section.id }} .announcement-message-btn {
    background-color: {{ section.settings.button_background }};
    color: {{ section.settings.button_text_color }};
    padding: 3px 12px;
    font-size: 11px;
    line-height: 1;
    border-radius: 10px;
  }

  #shopify-section-{{ section.id }} .additional-announcement-bar {
    background-color: {{ section.settings.additional_background }};
    color: {{ section.settings.additional_text_color }};
    padding: 10px 0;
  }

  #shopify-section-{{ section.id }} .additional-announcement-bar * {
    font-size: 12px;
    line-height: 1.2;
    color: {{ section.settings.additional_text_color }};
  }

  #shopify-section-{{ section.id }} .additional-announcement-bar .container {
    display: block;
    text-align: center;
    position: relative;
    padding: 0;
  }

  #shopify-section-{{ section.id }} .additional-announcement-bar .container .icon-additional-close {
    position: absolute;
    top: 50%;
    right: 18px;
    transform: translateY(-50%);
    z-index: 1;
    width: 11px;
    height: 11px;
    cursor: pointer;
  }

  #shopify-section-{{ section.id }} .announcementbar-countdown-timer {
    background-color: {{ section.settings.timer_background }};
    color: {{ section.settings.timer_text_color }};
    padding: 10px 0;
  }

  #shopify-section-{{ section.id }} .announcementbar-countdown-timer * {
    font-size: 12px;
    line-height: 1.2;
    color: {{ section.settings.timer_text_color }};
  }

  #shopify-section-{{ section.id }} .announcementbar-countdown-timer .container {
    display: flex;
    text-align: center;
    padding: 0;
    justify-content: center;
    gap: 5px;
  }
  .shopify-section--announcement-bar .announcement-bar-inner > *:first-child span.announcement-bar-reviewsio {
    justify-content: flex-start;
  }

  @media (min-width: 1000px) {
    #shopify-section-{{ section.id }} .additional-announcement-bar .container .icon-additional-close {
      right: 60px;
    }

    .shopify-section--announcement-bar .announcement-bar-inner {
      flex-wrap: nowrap;
      justify-content: space-between;
    }

    .shopify-section--announcement-bar .announcement-bar-reviewsio,
    .shopify-section--announcement-bar .announcement-bar-inner > *:not(.announcement-bar-reviewsio) {
      flex: 1;
      min-width: 0;
    }

    .shopify-section--announcement-bar .announcement-bar-inner > * {
      justify-content: center;
    }

    .shopify-section--announcement-bar .announcement-bar-inner > *:last-child {
      justify-content: flex-end;
    }

    .shopify-section--announcement-bar .announcement-bar-inner > *:first-child {
      justify-content: flex-start;
    }

    .shopify-section--announcement-bar .announcement-bar-inner > .announcement-bar-reviewsio {
      justify-content: center;
    }

    .shopify-section--announcement-bar .container {
      padding-left: var(--container-gutter);
      padding-right: var(--container-gutter);
    }

    .shopify-section--announcement-bar .container .announcement-message *,
    .shopify-section--announcement-bar .container .announcement-bar-reviewsio {
      font-size: 13px;
      line-height: 1;
    }

    .shopify-section--announcement-bar .container .announcement-message svg {
      max-width: 22px;
    }
  }

  span.rating-icon-svg svg {
    width: 100%;
    height: auto;
    display: flex;
    margin-top: -3px;
  }

  @media (max-width: 999px) {
    section.announcement_trusted_shop_wrapper .announcement-message {
        width: 100%;
        justify-content: center;
        gap: 16px !important;
    }

    section.announcement_trusted_shop_wrapper .announcement-message > span {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 6px;
    }
    section.announcement_trusted_shop_wrapper .container {
      padding-block: 0;
    }
  }

  @media (max-width: 400px) {
    .shopify-section--announcement-bar .container .announcement-message *, .shopify-section--announcement-bar .container .announcement-bar-reviewsio {
        font-size: 11px;
    }

    .shopify-section--announcement-bar .container .announcement-message {
        gap: 6px;
    }
  }

  {% if section.blocks.size == 1 %}
    .shopify-section--announcement-bar .announcement-bar-inner > *{
      width: 100% !important;
      justify-content: center !important;
    }
  {% endif %}

  @media (max-width: 999px) {
    .shopify-section--announcement-bar .announcement-bar-inner .announcement-bar-swiper-slider {
      width: 100% !important;
      overflow: hidden;
    }

    .shopify-section--announcement-bar .announcement-bar-inner .announcement-bar-swiper-slider:not(.swiper-initialized) .swiper-wrapper {
      display: flex !important;
      flex-wrap: nowrap !important;
      overflow: hidden !important;
    }

    .shopify-section--announcement-bar .announcement-bar-inner .announcement-bar-swiper-slider:not(.swiper-initialized) .swiper-slide {
      width: 50% !important;
      flex-shrink: 0 !important;
    }

    .shopify-section--announcement-bar .announcement-bar-inner .announcement-bar-swiper-slider:not(.swiper-initialized) .swiper-slide:nth-child(n+3) {
      display: none !important;
    }

    {% comment %} .announcement-message.swiper-slide.swiper-slide-next {
      justify-content: flex-end;
    } {% endcomment %}
  }
</style>

{% if has_reviewsio_rating_bar %}
  <script src="https://widget.reviews.io/modern-widgets/rating-bar.js" defer></script>
{% endif %}

{% if section.settings.show_additional_bar %}
  <script>
    const additionalAnnouncementBar = document.querySelector('.additional-announcement-bar');
    const closeButton = document.querySelector('.icon-additional-close');

    if (additionalAnnouncementBar && closeButton) {
      const hideTimestamp = localStorage.getItem('{{shop.domain}}_hideAdditionalAnnouncementBar');

      if (hideTimestamp) {
        const now = new Date().getTime();
        const sevenDays = 7 * 24 * 60 * 60 * 1000;

        if (now - parseInt(hideTimestamp) < sevenDays) {
          additionalAnnouncementBar.style.display = 'none';
        } else {
          localStorage.removeItem('hideAdditionalAnnouncementBar');
        }
      }
      closeButton.addEventListener('click', function () {
        additionalAnnouncementBar.style.display = 'none';
        localStorage.setItem('hideAdditionalAnnouncementBar', new Date().getTime());
      });
    }
  </script>
{% endif %}

{% if section.settings.show_timer and section.settings.timer_time != blank %}
  <script>
    let ann_count_timer = '{{section.settings.timer_time}}';
    var ann_countDownDate = new Date(ann_count_timer).getTime();
    var x = setInterval(function () {
      var now = new Date().getTime();
      var ann_distance = ann_countDownDate - now;
      var days = Math.floor(ann_distance / (1000 * 60 * 60 * 24))
        .toString()
        .padStart(2, '0');
      var hours = Math.floor((ann_distance % (1000 * 60 * 60 * 24)) / (1000 * 60 * 60))
        .toString()
        .padStart(2, '0');
      var minutes = Math.floor((ann_distance % (1000 * 60 * 60)) / (1000 * 60))
        .toString()
        .padStart(2, '0');
      var seconds = Math.floor((ann_distance % (1000 * 60)) / 1000)
        .toString()
        .padStart(2, '0');
      document.getElementById('announcement_timer').innerHTML = `${days}:${hours}:${minutes}:${seconds}`;
      if (ann_distance < 0) {
        clearInterval(x);
        document.getElementById('announcement_timer').style.display = 'none';
      }
    }, 1000);
  </script>
{% endif %}

<script>
  document.documentElement.style.setProperty(
    '--announcement-bar-height',
    document.getElementById('shopify-section-{{ section.id }}').clientHeight + 'px'
  );
</script>

<script>
  (function() {
    function initAnnouncementBarSwiper() {
      var slider = document.querySelector('.announcement-bar-swiper-slider');

      if (!slider || !window.Swiper) {
        return;
      }

      new window.Swiper(slider, {
        slidesPerView: 2,
        spaceBetween: 0,
        loop: true,
        autoplay: {
          delay: {{ section.settings.slides_speed_mobile -}}000,
          disableOnInteraction: false,
        },
        grabCursor: true,
        watchSlidesProgress: true,
        watchSlidesVisibility: true,
      });
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initAnnouncementBarSwiper, { once: true });
    } else {
      initAnnouncementBarSwiper();
    }
  })();
</script>

