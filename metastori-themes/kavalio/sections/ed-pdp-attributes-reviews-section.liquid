<style>
  #shopify-section-{{ section.id }} {
    --space-top: 100px;
    --space-bottom: 100px;
    --text-color: {{ settings.text_color.red }}, {{ settings.text_color.green }}, {{ settings.text_color.blue }};
    --section-background: {{ settings.background.red }}, {{ settings.background.green }}, {{ settings.background.blue }};
  }
  #shopify-section-{{ section.id }} {
      {%- if section.settings.text_color == 'rgba(0,0,0,0)' -%}
          {%- assign text_color = settings.text_color -%}
        {%- else -%}
          {%- assign text_color = section.settings.text_color -%}
      {%- endif -%}

      {%- if section.settings.background == 'rgba(0,0,0,0)' -%}
          {%- assign section_background = settings.background -%}
        {%- else -%}
          {%- assign section_background = section.settings.background -%}
      {%- endif %}

      --space-top: {{ section.settings.space_top_mobile -}}px;
      --space-bottom: {{ section.settings.space_bottom_mobile -}}px;

      --heading-color: {{ text_color.red }}, {{ text_color.green }}, {{ text_color.blue }};
      --text-color: {{ text_color.red }}, {{ text_color.green }}, {{ text_color.blue }};
      --section-background: {{ section_background.red }}, {{ section_background.green }}, {{ section_background.blue }};
      {%- if section.settings.enable_custom_max_width -%}
        --section-max-width: {{ section.settings.custom_max_width -}}px;
      {% endif %}
  }

  @media (min-width: 1000px) {
      #shopify-section-{{ section.id }} {
          --space-top: {{ section.settings.space_top -}}px;
          --space-bottom: {{ section.settings.space_bottom -}}px;
      }
  }
</style>

<style>
  .pdp_attributes_reviews_section {
    display: block;
    color: rgb(var(--text-color));
    background: rgb(var(--section-background));
  }

  .pdp_attributes_reviews_section.ed_empty {
    display: none;
  }

  {%- if section.settings.background == 'rgba(0,0,0,0)' -%}
      .pdp_attributes_reviews_section {
          margin-top: var(--space-top);
          margin-bottom: var(--space-bottom);
      }
  {%- else -%}
      .pdp_attributes_reviews_section {
          padding-top: var(--space-top);
          padding-bottom: var(--space-bottom);
      }
  {%- endif -%}

  .pdp_attributes_reviews_section_inner {
      display: grid;
      grid-template-columns: 1fr;
      gap: 32px 100px;
  }
  header.pdp_attributes_reviews_section_header {
      display: flex;
      align-items: center;
      justify-content: center;
      text-align: center;
  }

  {% assign heading_block = true %}
  {% assign product_attributes_block = true %}
  {% assign review_spotlight_block = true %}
  {% for block in section.blocks %}
    {% if block.type == 'heading' %}
      {% if block.settings.hide_at_desktop %}
        {% assign heading_block = false %}
      {% endif %}
    {% endif %}
    {% if block.type == 'product_attributes' %}
      {% if block.settings.hide_at_desktop %}
        {% assign product_attributes_block = false %}
      {% endif %}
    {% endif %}
    {% if block.type == 'review_spotlight' %}
      {% if block.settings.hide_at_desktop %}
        {% assign review_spotlight_block = false %}
      {% endif %}
    {% endif %}
  {% endfor %}

  @media (min-width: 1000px) {
    header.pdp_attributes_reviews_section_header {
      max-width: 200px;
    }
    #shopify-section-{{ section.id }}  .pdp_attributes_reviews_section_inner {
        grid-template-columns: {% if heading_block %} 200px{% endif %}{% if product_attributes_block %} 1fr{% endif %}{% if review_spotlight_block %} 1fr {% endif %};
    }
  }

</style>

<div class="pdp_attributes_reviews_section">
  <div class="container">
    <div class="pdp_attributes_reviews_section_inner">
      {% for block in section.blocks %}
        {% case block.type %}
          {% when 'heading' %}
            <header class="pdp_attributes_reviews_section_header {% if block.settings.hide_at_mobile %}hidden-pocket{% endif %} {% if block.settings.hide_at_desktop %}hidden-lap-and-up{% endif %}" {{ block.shopify_attributes }}>
              <h2 class="heading h2">{{ block.settings.heading_title }}</h2>
            </header>
          {% when 'product_attributes' %}
            {% if product.metafields.standard.cro_product_attributes %}
              <div class="pdpd_reviews_content_wrapper {% if block.settings.hide_at_mobile %}hidden-pocket{% endif %} {% if block.settings.hide_at_desktop %}hidden-lap-and-up{% endif %}" {{ block.shopify_attributes }}>
                {% render 'ed-cro-product-attributes', product: product, block: block %}
              </div>
            {% endif %}

          {% when 'review_spotlight' %}
            <div class="pdp_attributes_content_wrapper {% if block.settings.hide_at_mobile %}hidden-pocket{% endif %} {% if block.settings.hide_at_desktop %}hidden-lap-and-up{% endif %}" {{ block.shopify_attributes }}>
              {% render 'cro_review_spotlight', product: product, block: block %}
            </div>
        {% endcase %}
      {% endfor %}
    </div>
  </div>
</div>

<script>
  (function() {
    var sectionId = '{{ section.id }}';
    var sectionEl = document.getElementById('shopify-section-' + sectionId);
    if (!sectionEl) return;

    var sectionRoot = sectionEl.querySelector('.pdp_attributes_reviews_section');
    if (!sectionRoot) return;

    function updateEmptyState() {
      if (!sectionRoot) return;
      var hasReviews = sectionRoot.querySelector('.hr_cro_review_spotlight_section.ed_has_reviews') !== null;
      var hasAttributes = sectionRoot.querySelector('.pdpd_reviews_content_wrapper .cro_product_attributes_item') !== null;
      var isEmpty = !hasReviews && !hasAttributes;
      sectionRoot.classList.toggle('ed_empty', isEmpty);
    }

    updateEmptyState();
    setTimeout(updateEmptyState, 500);
    setTimeout(updateEmptyState, 1500);

    var reviewSpotlight = sectionRoot.querySelector('.hr_cro_review_spotlight_section');
    if (reviewSpotlight && typeof MutationObserver !== 'undefined') {
      var obs = new MutationObserver(function() { updateEmptyState(); });
      obs.observe(reviewSpotlight, { attributes: true, attributeFilter: ['class'] });
    }

    var reviewsWidget = document.getElementById('CroReviewsWidget');
    if (reviewsWidget && typeof MutationObserver !== 'undefined') {
      var widgetObs = new MutationObserver(function() {
        setTimeout(updateEmptyState, 100);
      });
      widgetObs.observe(reviewsWidget, { childList: true, subtree: true });
    }
  })();
</script>

