<style>
  #shopify-section-{{ section.id }} {
    {%- if section.settings.background == 'rgba(0,0,0,0)' -%}
      {%- assign section_background = settings.background -%}
    {%- else -%}
      {%- assign section_background = section.settings.background -%}
    {%- endif -%}

    {%- if section.settings.text_color == 'rgba(0,0,0,0)' -%}
      {%- assign heading_color = settings.heading_color -%}
      {%- assign text_color = settings.text_color -%}
    {%- else -%}
      {%- assign heading_color = section.settings.text_color -%}
      {%- assign text_color = section.settings.text_color -%}
    {%- endif -%}

    --heading-color: {{ heading_color.red }}, {{ heading_color.green }}, {{ heading_color.blue }};
    --text-color: {{ text_color.red }}, {{ text_color.green }}, {{ text_color.blue }};
    --prev-next-button-background: {{ settings.background.red }}, {{ settings.background.green }}, {{ settings.background.blue }};
    --prev-next-button-color: {{ settings.text_color.red }}, {{ settings.text_color.green }}, {{ settings.text_color.blue }};

    --section-background: {{ section_background.red }}, {{ section_background.green }}, {{ section_background.blue }};
  }

  #shopify-section-{{ section.id }}{
    background-color: {{ section.settings.background }};
  }
  @media (min-width: 1000px) {
    #shopify-section-{{ section.id }} {
      margin-top: {{ section.settings.space_top -}}px;
      margin-bottom: {{ section.settings.space_bottom -}}px;
    }
  }
  @media (max-width: 999px) {
    #shopify-section-{{ section.id }} {
      margin-top: {{ section.settings.space_top_mobile -}}px;
      margin-bottom: {{ section.settings.space_bottom_mobile -}}px;
    }
  }
</style>

<style>
  .sub_collections_section .multi-column__item {
    display: grid;
    grid-template-columns: auto 1fr;
    align-items: center;
    padding: 10px 20px;
    background: {{ section.settings.item_background }};
    gap: 8px;
    border-radius: 8px;
    width: max-content;
    border: 1.5px solid transparent;
    transition: opacity 0.3s ease, transform 0.3s ease, background-color 0.3s ease, color 0.3s ease, border-color 0.2s ease;
  }


  /* Active state styling */
  .sub_collections_section .multi-column__item.active {
    {% if section.settings.item_border_color_active != 'rgba(0,0,0,0)' %}
      border-color: {{ section.settings.item_border_color_active }};
    {% else %}
      border-color: #1D1D1D;
    {% endif %}
    {% if section.settings.item_text_color_active != 'rgba(0,0,0,0)' %}
      color: {{ section.settings.item_text_color_active }};
    {% endif %}
    {% if section.settings.item_background_active != 'rgba(0,0,0,0)' %}
      background: {{ section.settings.item_background_active }};
    {% endif %}
  }

  .sub_collections_section .multi-column__image-wrapper {
    margin: 0;
  }

  .sub_collections_section .multi-column__text-container .ed_sub_collections_title {
    font-size: var(--base-font-size);
    line-height: 1;
  }

  .sub_collections_section span.sub_collection_icon {
    width: 40px;
    height: 40px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: {{ section.settings.item_icon_background }};
    border-radius: 360px;
    padding: 5px;
  }

  .sub_collections_section  span.sub_collection_icon img, span.sub_collection_icon svg {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }
  /* full-width scroller css */
  .full_width_scroller_section .scroller {
      scroll-snap-type: x mandatory;
      margin-inline: calc(-1 * var(--container-gutter));
      scrollbar-width: none;
      overflow: auto hidden;
  }

  @media screen and (min-width: 1000px) {
      .full_width_scroller_section .multi-column__inner--scroller {
          overflow: unset;
      }
  }

  .full_width_scroller_section .multi-column__inner--scroller {
      display: grid;
      min-width: min-content;
      grid-auto-columns: auto;
      gap: 16px;
      justify-content: center;
  }

  .full_width_scroller_section {
      overflow: hidden;
  }

  .full_width_scroller_section .scroller {
      margin-left: 0;
      margin-right: -10%;
  }

  @media (min-width: 1850px) {
      .full_width_scroller_section .scroller {
          margin-right: -20%;
      }
  }

  .full_width_scroller_section .multi-column__inner--scroller {
      padding-left: 0;
      padding-right: 9%;
      grid-auto-flow: column;
      grid-template-columns: none !important;
  }
  .sub_collections_section drag-cursor.custom-drag-cursor {
      display: none;
  }

  @media screen and (min-width: 1000px) {
      .full_width_scroller_section .multi-column__inner:not(.is-scrollable)+.multi-column__prev-next {
          display: flex;
          top: calc(50% - 18.5px);
          width: 100%;
          left: 0;
      }
  }
  @media screen and (min-width: 741px) {
    .sub_collections_section .prev-next-button:not(.prev-next-button--small) {
        width: 35px;
        height: 35px;
        border-radius: 360px;
    }
    .sub_collections_section .prev-next-button:not(.prev-next-button--small) svg {
        width: 18px;
        height: auto;
    }
  }

  @media (max-width: 740px) {
    .sub_collections_section .multi-column__text-container p.heading {
      font-size: calc(var(--base-font-size) - 3px);
    }

    .sub_collections_section span.sub_collection_icon {
        width: 34px;
        height: 34px;
    }

    .sub_collections_section .multi-column__item {
        padding: 10px 12px;
    }

  }
  /* full-width scroller css */
  .sub_collections_section .multi-column__inner--scroller {
    cursor: grab;
  }
  .sub_collections_section .custom-drag-cursor {
    display: none;
  }
  @media screen and (min-width: 1000px) {
    .sub_collections_section .multi-column__inner--scroller {
          grid-auto-columns: auto;
          overflow: hidden;
      }
      .sub_collections_section  .multi-column__prev-next--no-image {
        top: calc(50%);
        transform: translateY(-50%);
    }
  }
</style>

<section class="sub_collections_section">
  <div class="section__color-wrapper">
    <div class="container">
      {%- if section.blocks.size > 0 -%}
        <multi-column
          {% if section.settings.stack_items %}
            stack
          {% endif %}
          {% if section.settings.reveal_on_scroll %}
            stagger-apparition
          {% endif %}
          class="multi-column multi-column--pocket-medium multi-column--medium multi-column--spacing-{{ section.settings.spacing }}"
        >
          {%- assign align_arrows_on_image = true -%}
          {%- assign smallest_image_aspect_ratio = 0 -%}

          <div
            {% unless section.settings.stack_items %}
              class="scroller"
            {% endunless %}
          >
            <scrollable-content
              data-sub-collection-list
              {% if section.settings.enable_drag %}draggable{% endif %}
              class="multi-column__inner is-scrollable {% unless section.settings.stack_items %} multi-column__inner--scroller{% endunless %}"
            >
              {%- assign desktop_items_per_row = 7 -%}
              {%- case section.settings.desktop_item_size -%}
                {%- when 'pico' -%}
                  {%- assign desktop_items_per_row = 8 -%}

                {%- when 'small' -%}
                  {%- assign desktop_items_per_row = 7 -%}

                {%- when 'medium' -%}
                  {%- assign desktop_items_per_row = 7 -%}

                {%- when 'large' -%}
                  {%- assign desktop_items_per_row = 3 -%}
              {%- endcase -%}

              {%- if section.settings.stack_items -%}
                {%- case section.settings.mobile_item_size -%}
                  {%- when 'small' -%}
                    {%- assign mobile_calculated_size = 'calc(50vw - 48px)' -%}
                    {%- assign tablet_calculated_size = 'calc(20vw - 80px)' -%}

                  {%- when 'medium' -%}
                    {%- assign mobile_calculated_size = 'calc(100vw - 48px)' -%}
                    {%- assign tablet_calculated_size = 'calc(25vw - 80px)' -%}

                  {%- when 'large' -%}
                    {%- assign mobile_calculated_size = 'calc(100vw - 48px)' -%}
                    {%- assign tablet_calculated_size = 'calc(33vw - 80px)' -%}
                {%- endcase -%}
              {%- else -%}
                {%- case section.settings.mobile_item_size -%}
                  {%- when 'small' -%}
                    {%- assign mobile_calculated_size = '25vw' -%}
                    {%- assign tablet_calculated_size = '20vw' -%}

                  {%- when 'medium' -%}
                    {%- assign mobile_calculated_size = '35vw' -%}
                    {%- assign tablet_calculated_size = '26vw' -%}

                  {%- when 'large' -%}
                    {%- assign mobile_calculated_size = '56vw' -%}
                    {%- assign tablet_calculated_size = '36vw' -%}
                {%- endcase -%}
              {%- endif -%}

              {%- case section.settings.spacing -%}
                {%- when 'tight' -%}
                  {%- assign desktop_item_gap = 24 -%}

                {%- when 'normal' -%}
                  {%- assign desktop_item_gap = 40 -%}

                {%- when 'loose' -%}
                  {%- assign desktop_item_gap = 60 -%}
              {%- endcase -%}

              {%- assign desktop_items_per_row_minus_one = desktop_items_per_row | minus: 1 -%}
              {%- assign gap_width = desktop_item_gap
                | divided_by: desktop_items_per_row
                | times: desktop_items_per_row_minus_one
              -%}

              {%- for block in section.blocks -%}
                {%- assign sub_collection_title_alt = block.settings.title | strip_html | strip -%}
                {%- assign sub_collection_icon_alt = block.settings.icon_as_image.alt | default: sub_collection_title_alt | default: 'Kollektion' -%}
                {%- assign sub_collection_image_alt = block.settings.image.alt | default: sub_collection_title_alt | default: 'Kollektion' -%}
                {%- capture block_content -%}
                    <div class="multi-column__image-wrapper">
                        {%- if block.settings.icon_as_image != blank -%}
                            <span class="sub_collection_icon">
                                {{- block.settings.icon_as_image | image_url: width: block.settings.icon_as_image.width | image_tag: sizes: '100vw', widths: '25,50,75,100', alt: sub_collection_icon_alt, title: sub_collection_icon_alt -}}
                            </span>
                        {%- elsif  block.settings.icon_as_svg != blank  -%}
                            <span class="sub_collection_icon">
                                {{ block.settings.icon_as_svg }}
                            </span>
                        {%- endif -%}
                    </div>

                    {%- if block.settings.image != blank -%}
                      {%- assign smallest_image_aspect_ratio = smallest_image_aspect_ratio | at_least: block.settings.image.aspect_ratio -%}
                        {%- capture sizes_attribute -%}(max-width: 740px) {{ mobile_calculated_size }}, (max-width: 999px) {{ tablet_calculated_size }}, {{ 1520.0 | divided_by: desktop_items_per_row | minus: gap_width | ceil }}px{%- endcapture -%}
    
                        {%- if block.settings.link_url != blank -%}
                          <a href="{{ block.settings.link_url }}" class="multi-column__image-wrapper" style="max-width: {{ block.settings.image_width }}%; width: {{ block.settings.image.width }}px">
                            {{- block.settings.image | image_url: width: block.settings.image.width | image_tag: loading: 'lazy', sizes: sizes_attribute, widths: '200,300,400,500,600,700,800,900,1000,1100,1200', class: 'multi-column__image', alt: sub_collection_image_alt -}}
                          </a>
                        {%- else -%}
                          <div class="multi-column__image-wrapper" style="max-width: {{ block.settings.image_width }}%; width: {{ block.settings.image.width }}px">
                            {{- block.settings.image | image_url: width: block.settings.image.width | image_tag: loading: 'lazy', sizes: sizes_attribute, widths: '200,300,400,500,600,700,800,900,1000,1100,1200', class: 'multi-column__image', alt: sub_collection_image_alt -}}
                          </div>
                        {%- endif -%}
                      {%- else -%}
                        {%- assign align_arrows_on_image = false -%}
                    {%- endif -%}

  
                    {%- if block.settings.title != blank or block.settings.content != blank or block.settings.link_text != blank -%}
                      <div class="multi-column__text-container text--{{ block.settings.text_alignment }} text-container">
                        {%- if block.settings.title != blank -%}
                          <div class="heading ed_sub_collections_title">
                            {{ block.settings.title }}
                          </div>
                        {%- endif -%}
  
                        {%- if block.settings.content != blank -%}
                          {{- block.settings.content -}}
                        {%- endif -%}
  
                        {%- if block.settings.link_text != blank -%}
                          {%- if block.settings.link_style == 'link' -%}
                            <a href="{{ block.settings.link_url }}" class="multi-column__link heading heading--small link">{{ block.settings.link_text | escape }}</a>
                          {%- else -%}
                            <div class="button-wrapper">
                              <a href="{{ block.settings.link_url }}" class="multi-column__button button button--small button--primary">{{ block.settings.link_text | escape }}</a>
                            </div>
                          {%- endif -%}
                        {%- endif -%}
                      </div>
                    {%- endif -%}
                {%- endcapture -%}

                {%- if block_content != blank -%}
                  {% if block.settings.link_url != blank %}
                    {%- assign is_active = false -%}
                    {%- if request.page_type == 'collection' and block.settings.link_url contains collection.url -%}
                      {%- assign is_active = true -%}
                    {%- endif -%}

                    {%- if request.page_type == 'collection' and block.settings.related_collections_menu != blank -%}
                      {%- assign related_menu = block.settings.related_collections_menu -%}
                      {%- for related_link in related_menu.links -%}
                        {%- if related_link.url contains collection.url -%}
                          {%- assign is_active = true -%}
                        {%- endif -%}
                      {%- endfor -%}
                    {%- endif -%}

                    <a href="{{ block.settings.link_url }}">
                      <div
                        id="block-{{ section.id }}-{{ block.id }}"
                        class="multi-column__item multi-column__item--align-{{ block.settings.vertical_alignment }} {% if section.settings.stack_items %}multi-column__item--stack{% endif %} {% if is_active %}active{% endif %}"
                        {% if section.settings.reveal_on_scroll %}
                          reveal
                        {% endif %}
                        {{ block.shopify_attributes }}
                      >
                        {{- block_content -}}
                      </div>
                    </a>
                  {% else %}
                    <div
                      id="block-{{ section.id }}-{{ block.id }}"
                      class="multi-column__item multi-column__item--align-{{ block.settings.vertical_alignment }} {% if block.settings.link_url != blank %}image-zoom{% endif %}"
                      {% if section.settings.reveal_on_scroll %}
                        reveal
                      {% endif %}
                      {{ block.shopify_attributes }}
                    >
                      {{- block_content -}}
                    </div>
                  {% endif %}
                {%- endif -%}
              {%- endfor -%}
            </scrollable-content>

            {%- unless section.settings.stack_items -%}
              <prev-next-buttons
                class="multi-column__prev-next {% unless align_arrows_on_image %}multi-column__prev-next--no-image{% endunless %} hidden-pocket"
                {% if align_arrows_on_image %}
                  style="--smallest-image-aspect-ratio: {{ smallest_image_aspect_ratio }}"
                {% endif %}
              >
                <button class="multi-column__arrow prev-next-button prev-next-button--prev" disabled aria-label="{{ 'general.accessibility.previous' | t | default: 'Previous' | escape }}">
                  <span class="visually-hidden">{{ 'general.accessibility.previous' | t }}</span>
                  {%- render 'icon' with 'chevron-left' -%}
                </button>

                <button class="multi-column__arrow prev-next-button prev-next-button--next" aria-label="{{ 'general.accessibility.next' | t | default: 'Next' | escape }}">
                  <span class="visually-hidden">{{ 'general.accessibility.next' | t }}</span>
                  {%- render 'icon' with 'chevron-right' -%}
                </button>
              </prev-next-buttons>
            {%- endunless -%}
          </div>
        </multi-column>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Sub Collections",
  "class": "shopify-section--sub-collections",
  "disabled_on": {
    "groups": ["header", "custom.overlay"]
  },
  "blocks": [
    {
      "name": "Column",
      "type": "item",
      "settings": [
        {
          "type": "link_list",
          "id": "related_collections_menu",
          "label": "Related collections"
        },
        {
          "type": "image_picker",
          "id": "icon_as_image",
          "label": "Icon as image",
          "info": "Image will repalce SVG"
        },
        {
          "type": "html",
          "id": "icon_as_svg",
          "label": "Icon as SVG"
        },
        {
          "type": "richtext",
          "id": "title",
          "label": "Heading",
          "default": "<p>Your content</p>"
        },
        {
          "type": "url",
          "id": "link_url",
          "label": "Link"
        },
        {
          "type": "select",
          "id": "text_alignment",
          "label": "Text alignment",
          "options": [
            {
              "value": "left",
              "label": "Left"
            },
            {
              "value": "center",
              "label": "Center"
            },
            {
              "value": "right",
              "label": "Right"
            }
          ],
          "default": "left"
        },
        {
          "type": "select",
          "id": "vertical_alignment",
          "label": "Vertical alignment",
          "options": [
            {
              "value": "start",
              "label": "Top"
            },
            {
              "value": "center",
              "label": "Center"
            },
            {
              "value": "end",
              "label": "Bottom"
            }
          ],
          "default": "start"
        }
      ]
    }
  ],
  "settings": [
    {
      "type": "header",
      "content": "Section spacing"
    },
    {
      "type": "range",
      "id": "space_top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "label": "Top space",
      "default": 60
    },
    {
      "type": "range",
      "id": "space_bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "label": "Bottom space",
      "default": 60
    },
    {
      "type": "paragraph",
      "content": "Section spacing (Mobile)"
    },
    {
      "type": "range",
      "id": "space_top_mobile",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "label": "Top (mobile)",
      "default": 32
    },
    {
      "type": "range",
      "id": "space_bottom_mobile",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "label": "Bottom (mobile)",
      "default": 32
    },
    {
      "type": "header",
      "content": "Other settings"
    },
    {
      "type": "checkbox",
      "id": "reveal_on_scroll",
      "label": "Reveal on scroll",
      "info": "Show animation when section becomes visible.",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "stack_items",
      "label": "Stack items",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "enable_drag",
      "label": "Enable drag functionality",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "enable_next_prev",
      "label": "Navigation",
      "default": true
    },
    {
      "type": "select",
      "id": "spacing",
      "label": "Spacing",
      "options": [
        {
          "value": "tight",
          "label": "Small"
        },
        {
          "value": "normal",
          "label": "Medium"
        },
        {
          "value": "loose",
          "label": "Large"
        }
      ],
      "default": "normal"
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "background",
      "label": "Background",
      "default": "rgba(0,0,0,0)"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "rgba(0,0,0,0)"
    },
    {
      "type": "color",
      "id": "item_icon_background",
      "label": "Icon Background",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "item_background",
      "label": "Background",
      "default": "#DEF4F0"
    },
    {
      "type": "color",
      "id": "item_border_color",
      "label": "Border color",
      "default": "rgba(0,0,0,0)"
    },
    {
      "type": "paragraph",
      "content": "Active colors"
    },
    {
      "type": "color",
      "id": "item_text_color_active",
      "label": "Active color",
      "default": "rgba(0,0,0,0)"
    },
    {
      "type": "color",
      "id": "item_background_active",
      "label": "Active Background",
      "default": "rgba(0,0,0,0)"
    },
    {
      "type": "color",
      "id": "item_border_color_active",
      "label": "Active Border color",
      "default": "#1D1D1D"
    }
  ],
  "presets": [
    {
      "name": "Sub Collections",
      "blocks": [
        {
          "type": "item",
          "settings": {
            "title": "<p>Tresen & Kandaren</p>"
          }
        },
        {
          "type": "item",
          "settings": {
            "title": "<p>Gebisse</p>"
          }
        },
        {
          "type": "item",
          "settings": {
            "title": "<p>Halfter & Stricke</p>"
          }
        },
        {
          "type": "item",
          "settings": {
            "title": "<p>Beinschutz</p>"
          }
        },
        {
          "type": "item",
          "settings": {
            "title": "<p>Sättel</p>"
          }
        },
        {
          "type": "item",
          "settings": {
            "title": "<p>Sattel-zubehör</p>"
          }
        },
        {
          "type": "item",
          "settings": {
            "title": "<p>Hilfszügel</p>"
          }
        }
      ]
    }
  ]
}
{% endschema %}
