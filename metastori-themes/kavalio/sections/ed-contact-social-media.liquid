<style>
    #shopify-section-{{ section.id }} {
      {%- if section.settings.background == 'rgba(0,0,0,0)' -%}
        {%- assign section_background = settings.background -%}
      {%- else -%}
        {%- assign section_background = section.settings.background -%}
      {%- endif -%}
  
      {%- if section.settings.text_color == 'rgba(0,0,0,0)' -%}
        {%- assign heading_color = settings.heading_color -%}
        {%- assign text_color = settings.text_color -%}
      {%- else -%}
        {%- assign heading_color = section.settings.text_color -%}
        {%- assign text_color = section.settings.text_color -%}
      {%- endif -%}
  
      {%- if section.settings.button_background == 'rgba(0,0,0,0)' -%}
        {%- assign button_background = settings.primary_button_background -%}
      {%- else -%}
        {%- assign button_background = section.settings.button_background -%}
      {%- endif -%}
  
      {%- if section.settings.button_text_color == 'rgba(0,0,0,0)' -%}
        {%- assign button_text_color = settings.primary_button_text_color -%}
      {%- else -%}
        {%- assign button_text_color = section.settings.button_text_color -%}
      {%- endif -%}
  
      --heading-color: {{ heading_color.red }}, {{ heading_color.green }}, {{ heading_color.blue }};
      --text-color: {{ text_color.red }}, {{ text_color.green }}, {{ text_color.blue }};
      --primary-button-background: {{ button_background.red }}, {{ button_background.green }}, {{ button_background.blue }};
      --primary-button-text-color: {{ button_text_color.red }}, {{ button_text_color.green }}, {{ button_text_color.blue }};
      --section-background: {{ section_background.red }}, {{ section_background.green }}, {{ section_background.blue }};
      --contact-form-max-width: {{ section.settings.contact_form_max_width -}}px;
    }
    #shopify-section-{{ section.id }} {
      background-color: rgb(var(--section-background));
    }
  
    @media (min-width: 1000px) {
      #shopify-section-{{ section.id }} {
        padding-top: {{ section.settings.space_top -}}px;
        padding-bottom: {{ section.settings.space_bottom -}}px;
      }
      .ed_contact_messengers_footer_divider {
        margin-top: 75px;
      }
    }
    @media (max-width: 999px) {
      #shopify-section-{{ section.id }} {
        padding-top: {{ section.settings.space_top_mobile -}}px;
        padding-bottom: {{ section.settings.space_bottom_mobile -}}px;
      }
      .ed_contact_messengers_footer_divider {
        margin-top: 60px;
      }
    }
  
    .ed_contact_wrapper {
      padding: 40px 50px;
      background: {{ section.settings.form_background }};
      border: 1px solid #F3F4F9;
      box-shadow: 0px 84px 34px rgba(156, 162, 176, 0.01),
      0px 47px 28px rgba(156, 162, 176, 0.05),
      0px 21px 21px rgba(156, 162, 176, 0.09),
      0px 5px 12px rgba(156, 162, 176, 0.1);
      border-radius: 8px;
      max-width: var(--contact-form-max-width);
      margin-inline: auto;
      display: block;
    }
    
    .ed_contact_wrapper header.section__header {
      margin-block-end: 40px;
    }
    
    .ed_contact_wrapper .input__field,
    .ed_contact_wrapper .select {
      border: 1px solid #DFDFDF;
    }
    
    .ed_contact_wrapper .input__label {
      background: {{ section.settings.form_background }};
    }
    
    .ed_contact_wrapper .ed_contact_form_content {
      margin-block-start: 40px;
      text-align: center;
      margin-block-end: 35px;
    }
    
    .ed_contact_wrapper button.form__submit.button {
      margin-inline: auto;
      margin-block: 0;
      --button-height: 46px;
    }
    
    .ed_contact_wrapper button.form__submit.button .loader-button__text {
      gap: 16px;
    }
    

    /* Social media */
    .ed_contact_messengers_wrapper {
      max-width: {{ section.settings.social_media_max_width }}px;
      margin-inline: auto;
      display: flex;
      flex-direction: row;
      justify-content: center;
      align-items: center;
      padding: 16px 0px;
      gap: 32px;
      background: {{ section.settings.social_media_background }};
      border: 1px solid #F3F4F9;
      box-shadow: 0px 84px 34px rgba(156, 162, 176, 0.01), 0px 47px 28px rgba(156, 162, 176, 0.05), 0px 21px 21px rgba(156, 162, 176, 0.09), 0px 5px 12px rgba(156, 162, 176, 0.1);
      border-radius: 8px;
    }
    
    .ed_contact_messengers_wrapper_media {
        max-width: 90px;
    }
    .ed_contact_messengers_title {
        margin-bottom: 8px;
    }
    .ed_contact_messengers_link {
        display: flex;
        font-weight: 600;
        align-items: center;
        gap: 4px;
        margin-bottom: 8px;
        line-height: 1.1;
    }
    .ed_contact_messengers_content {
        margin-top: 12px;
    }
    
    .ed_contact_messengers_content_text {
        font-weight: 300;
        line-height: 1;
    }
    
    .ed_contact_messengers_social_media {
        margin-inline: auto;
        text-align: center;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-direction: column;
        margin-top: 32px;
    }
    
    .ed_contact_messengers_social_media h1.heading.h4 {
        font-size: calc(var(--heading-h4-font-size) - 4px);
        line-height: 1;
    }
    
    .ed-social-media__link svg {
        color: {{ section.settings.social_icons_color }};
    }
    /* END:Social media */

  </style>
  
  <section class="ed_contact_social_media_section">
    <div class="section__color-wrapper">
      <div class="container">
        <div class="ed_contact_messengers_wrapper">
          <div class="ed_contact_messengers_wrapper_media">
            {%- if section.settings.image != blank -%}
              {{- section.settings.image | image_url: width: section.settings.image.width | image_tag: sizes: '100vw', widths: '200,300,400', alt: section.settings.image.alt, class: 'ed_contact_messengers--media' -}}
            {%- endif -%}
          </div>

          <div class="ed_contact_messengers_wrapper__content">
            <h1 class="ed_contact_messengers_title heading h4">
              {{ section.settings.title }}
            </h1>

            <div class="ed_contact_messengers_links">
              {% if section.settings.whatsapp_title != blank %}
              <a href="{{ section.settings.whatsapp_link }}" 
                {%if section.settings.open_whatsapp_in_new_tab %} target="_blank"{% endif %} class="ed_contact_messengers_link">
                <span>{{ section.settings.whatsapp_title }}</span> 
                {% render 'icon' with 'icon-arrow-right' %}
              </a>
              {% endif %}

              {% if section.settings.messengers_title != blank %}
                <a href="{{ section.settings.messengers_link }}" 
                  {%if section.settings.open_messengers_in_new_tab %} target="_blank" {% endif %} class="ed_contact_messengers_link">
                  <span>{{ section.settings.messengers_title }}</span> 
                  {% render 'icon' with 'icon-arrow-right' %}
                </a>
              {% endif %}
            </div>

            {% if section.settings.messengers_content != blank %}
              <div class="ed_contact_messengers_content">
                <p class="ed_contact_messengers_content_text">
                  {{ section.settings.messengers_content }}
                </p>
              </div>
            {% endif %}
          </div>
        </div>

        {% if section.settings.show_social_icons %}
          <div class="ed_contact_messengers_social_media">
            <h1 class="heading h4">Bleibe immer in Verbindung</h1>
            {% render 'social-media'  %}
          </div>
        {% endif %}

        {%- if section.settings.show_header_divider -%}
          <div class="ed_contact_messengers_footer_divider">
            {% render 'ed-heart-divider' %}
          </div>
        {%- endif -%}
      </div>
    </div>
  </section>
  
  {% schema %}
  {
    "name": "Contact social media",
    "class": "shopify-section--ed-contact-social-media",
    "disabled_on": {
      "groups": ["header", "custom.overlay"]
    },
    "settings": [
      {
        "type": "image_picker",
        "id": "image",
        "label": "Messengers image",
        "info": "200 x 1800 px .png recommended"
      },
      {
        "type": "text",
        "id": "title",
        "label": "Heading",
        "default": "Schreibe uns"
      },
      {
        "type": "text",
        "id": "whatsapp_title",
        "label": "WhatsApp title",
        "default": "WhatsApp"
      },
      {
        "type": "text",
        "id": "whatsapp_link",
        "label": "WhatsApp link",
        "default": "https://wa.me/1234567890"
      },
      {
        "type": "checkbox",
        "id": "open_whatsapp_in_new_tab",
        "label": "Open WhatsApp in new tab",
        "default": true
      },
      {
        "type": "text",
        "id": "messengers_title",
        "label": "Messengers title",
        "default": "WhatsApp"
      },
      {
        "type": "text",
        "id": "messengers_link",
        "label": "Messengers link",
        "default": "https://m.me/yourpage"
      },  
      {
        "type": "checkbox",
        "id": "open_messengers_in_new_tab",
        "label": "Open Messengers in new tab",
        "default": true
      },
      {
        "type": "text",
        "id": "messengers_content",
        "label": "Messengers content",
        "default": "Mo - Fr 10:00 - 16:00 Uhr"
      },
      {
        "type": "range",
        "id": "social_media_max_width",
        "min": 10,
        "max": 600,
        "step": 10,
        "unit": "px",
        "label": "Social media max width",
        "default": 360
      },
      {
        "type": "checkbox",
        "id": "show_social_icons",
        "label": "Show social icons",
        "default": true
      },
      {
        "type": "text",
        "id": "social_icons_title",
        "label": "Social icons title",
        "default": "Bleibe immer in Verbindung"
      },
      {
        "type": "checkbox",
        "id": "show_header_divider",
        "label": "Show footer divider",
        "default": true
      },
      {
        "type": "header",
        "content": "Colors"
      },
      {
        "type": "color",
        "id": "social_media_background",
        "label": "Social Background",
        "default": "#FFFFFF"
      },
      {
        "type": "color",
        "id": "social_icons_color",
        "label": "Social icons",
        "default": "#59C5B4"
      },
      {
        "type": "color",
        "id": "background",
        "label": "Background",
        "default": "rgba(0,0,0,0)"
      },
      {
        "type": "color",
        "id": "text_color",
        "label": "Text color",
        "default": "rgba(0,0,0,0)"
      },
      {
        "type": "color",
        "id": "button_background",
        "label": "Button background",
        "default": "rgba(0,0,0,0)"
      },
      {
        "type": "color",
        "id": "button_text_color",
        "label": "Button text",
        "default": "rgba(0,0,0,0)"
      },
      {
        "type": "header",
        "content": "Section spacing"
      },
      {
        "type": "range",
        "id": "space_top",
        "min": 1,
        "max": 100,
        "step": 1,
        "unit": "px",
        "label": "Top space",
        "default": 1
      },
      {
        "type": "range",
        "id": "space_bottom",
        "min": 1,
        "max": 100,
        "step": 1,
        "unit": "px",
        "label": "Bottom space",
        "default": 40
      },
      {
        "type": "paragraph",
        "content": "Section spacing (Mobile)"
      },
      {
        "type": "range",
        "id": "space_top_mobile",
        "min": 1,
        "max": 100,
        "step": 1,
        "unit": "px",
        "label": "Top (mobile)",
        "default": 30
      },
      {
        "type": "range",
        "id": "space_bottom_mobile",
        "min": 1,
        "max": 100,
        "step": 1,
        "unit": "px",
        "label": "Bottom (mobile)",
        "default": 32
      }
    ],
    "blocks": [
      {
        "type": "name",
        "name": "Name",
        "limit": 1
      },
      {
        "type": "email",
        "name": "Email",
        "limit": 1
      },
      {
        "type": "message",
        "name": "Message",
        "limit": 1
      },
      {
        "type": "text",
        "name": "Text field",
        "settings": [
          {
            "type": "text",
            "id": "title",
            "label": "Name",
            "default": "Custom field"
          },
          {
            "type": "checkbox",
            "id": "use_long_text",
            "label": "Use long text",
            "default": false
          },
          {
            "type": "checkbox",
            "id": "is_required",
            "label": "Field is required",
            "default": false
          }
        ]
      },
      {
        "type": "dropdown",
        "name": "Dropdown",
        "settings": [
          {
            "type": "text",
            "id": "title",
            "label": "Name",
            "default": "Custom field"
          },
          {
            "type": "text",
            "id": "values",
            "label": "Values",
            "info": "Separate each value by a comma.",
            "default": "value 1, value 2, value 3"
          }
        ]
      },
      {
        "type": "question",
        "name": "Question",
        "settings": [
          {
            "type": "inline_richtext",
            "id": "title",
            "label": "Question",
            "default": "About your shop"
          },
          {
            "type": "richtext",
            "id": "answer",
            "label": "Answer",
            "default": "<p>Write content to help your customers to better understand your products or policies.</p>"
          }
        ]
      }
    ],
    "presets": [
      {
        "name": "Contact social media",
        "settings": {
          "background": "#F6F6F6"
        },
        "blocks": [
          {
            "type": "name"
          },
          {
            "type": "email"
          },
          {
            "type": "message"
          }
        ]
      }
    ]
  }
  {% endschema %}