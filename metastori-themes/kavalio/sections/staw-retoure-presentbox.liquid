<style>
  #shopify-section-{{ section.id }} {
    {%- if section.settings.background == 'rgba(0,0,0,0)' -%}
      {%- assign section_background = settings.background -%}
    {%- else -%}
      {%- assign section_background = section.settings.background -%}
    {%- endif -%}

    {%- if section.settings.text_color == 'rgba(0,0,0,0)' -%}
      {%- assign heading_color = settings.heading_color -%}
      {%- assign text_color = settings.text_color -%}
    {%- else -%}
      {%- assign heading_color = section.settings.text_color -%}
      {%- assign text_color = section.settings.text_color -%}
    {%- endif -%}

    --section-background: {{ section_background.red }}, {{ section_background.green }}, {{ section_background.blue }};
    --heading-color: {{ heading_color.red }}, {{ heading_color.green }}, {{ heading_color.blue }};
    --text-color: {{ text_color.red }}, {{ text_color.green }}, {{ text_color.blue }};

    background-color: rgb(var(--section-background));
  }

  @media (min-width: 1000px) {
    #shopify-section-{{ section.id }} {
      padding-top: {{ section.settings.space_top }}px;
      padding-bottom: {{ section.settings.space_bottom }}px;
    }
  }

  @media (max-width: 999px) {
    #shopify-section-{{ section.id }} {
      padding-top: {{ section.settings.space_top_mobile }}px;
      padding-bottom: {{ section.settings.space_bottom_mobile }}px;
    }
  }

  {%- if section.settings.content_max_width != 'none' -%}
  @media screen and (min-width: 741px) {
    #shopify-section-{{ section.id }} .container {
      max-width: {{ section.settings.content_max_width }};
    }
  }
  {%- endif -%}
</style>

<section>
  <div class="container">
    <div class="staw-presentbox">
      {%- comment -%} Left: Text content {%- endcomment -%}
      <div class="staw-presentbox__text">
        {%- if section.settings.heading != blank -%}
          <h3 class="heading {{ section.settings.heading_class }}{% if section.settings.heading_uppercase %} text-uppercase{% endif %} staw-presentbox__heading">
            {{ section.settings.heading | escape }}
          </h3>
        {%- endif -%}

        {%- if section.settings.subtitle != blank -%}
          <div class="staw-presentbox__subtitle rte" style="font-size: var(--staw-font-size-{{ section.settings.subtitle_font_size }})">
            {{ section.settings.subtitle }}
          </div>
        {%- endif -%}

        {%- if section.blocks.size > 0 -%}
          <ul class="staw-presentbox__list">
            {%- for block in section.blocks -%}
              {%- if block.type == 'feature' -%}
                <li class="staw-presentbox__item" {{ block.shopify_attributes }}>
                  {%- if block.settings.icon != blank -%}
                    <span class="staw-presentbox__icon">
                      {{-
                        block.settings.icon
                        | image_url: width: 48
                        | image_tag: loading: 'lazy', width: 24, height: 24, alt: ''
                        | default: ''
                      -}}
                    </span>
                  {%- endif -%}
                  <div class="staw-presentbox__item-text rte">
                    {{ block.settings.text }}
                  </div>
                </li>
              {%- endif -%}
            {%- endfor -%}
          </ul>
        {%- endif -%}
      </div>

      {%- comment -%} Right: Image {%- endcomment -%}
      <div class="staw-presentbox__image" style="max-width: {{ section.settings.image_max_width }}px;">
        {%- if section.settings.image != blank -%}
          {{-
            section.settings.image
            | image_url: width: 1200
            | image_tag: loading: 'lazy', class: 'staw-presentbox__img', alt: section.settings.image.alt
            | default: ''
          -}}
        {%- else -%}
          {{ 'image' | placeholder_svg_tag: 'staw-presentbox__img-placeholder' }}
        {%- endif -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "STAW | Retoure Gutschein",
  "class": "shopify-section--staw-presentbox",
  "disabled_on": {
    "groups": ["header", "custom.overlay"]
  },
  "settings": [
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "content_max_width",
      "label": "Inhaltsbreite",
      "info": "Gilt ab 741px Bildschirmbreite",
      "options": [
        { "value": "640px", "label": "Schmal (640px)" },
        { "value": "900px", "label": "Mittel (900px)" },
        { "value": "1200px", "label": "Breit (1200px)" },
        { "value": "none", "label": "Volle Breite" }
      ],
      "default": "1200px"
    },
    {
      "type": "header",
      "content": "Texte"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Überschrift",
      "default": "Mach mehr aus deiner Retoure"
    },
    {
      "type": "select",
      "id": "heading_class",
      "label": "Überschrift – Größe",
      "options": [
        { "value": "h1", "label": "H1" },
        { "value": "h2", "label": "H2" },
        { "value": "h3", "label": "H3" },
        { "value": "h4", "label": "H4" },
        { "value": "h5", "label": "H5" },
        { "value": "h6", "label": "H6" }
      ],
      "default": "h2"
    },
    {
      "type": "checkbox",
      "id": "heading_uppercase",
      "label": "Überschrift – Großbuchstaben",
      "default": false
    },
    {
      "type": "richtext",
      "id": "subtitle",
      "label": "Untertitel",
      "default": "<p>Entscheide dich für einen <strong>Gutschein &amp; bekomme Geld geschenkt!</strong></p>"
    },
    {
      "type": "select",
      "id": "subtitle_font_size",
      "label": "Untertitel – Schriftgröße",
      "options": [
        { "value": "small", "label": "Klein (14px)" },
        { "value": "base", "label": "Standard (16px)" },
        { "value": "medium", "label": "Mittel (18px)" },
        { "value": "large", "label": "Groß (20px)" },
        { "value": "xlarge", "label": "Sehr groß (22px)" }
      ],
      "default": "medium"
    },
    {
      "type": "header",
      "content": "Bild"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Bild (rechte Seite)"
    },
    {
      "type": "range",
      "id": "image_max_width",
      "min": 200,
      "max": 600,
      "step": 20,
      "unit": "px",
      "label": "Bild-Maximalbreite (Desktop)",
      "default": 420
    },
    {
      "type": "header",
      "content": "Abstände"
    },
    {
      "type": "range",
      "id": "space_top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "label": "Abstand oben",
      "default": 90
    },
    {
      "type": "range",
      "id": "space_bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "label": "Abstand unten",
      "default": 90
    },
    {
      "type": "range",
      "id": "space_top_mobile",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "label": "Abstand oben (Mobil)",
      "default": 60
    },
    {
      "type": "range",
      "id": "space_bottom_mobile",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "label": "Abstand unten (Mobil)",
      "default": 60
    },
    {
      "type": "header",
      "content": "Farben"
    },
    {
      "type": "color",
      "id": "background",
      "label": "Hintergrund",
      "default": "rgba(0,0,0,0)"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Textfarbe",
      "default": "rgba(0,0,0,0)"
    }
  ],
  "blocks": [
    {
      "type": "feature",
      "name": "Vorteil / Punkt",
      "settings": [
        {
          "type": "image_picker",
          "id": "icon",
          "label": "Icon (24×24 px empfohlen)"
        },
        {
          "type": "richtext",
          "id": "text",
          "label": "Text",
          "default": "<p>Dein Vorteil hier.</p>"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "STAW | Retoure Gutschein",
      "blocks": [
        {
          "type": "feature",
          "settings": {
            "text": "<p>Wir runden für dich auf den <strong>nächsten vollen Zehner auf.</strong></p>"
          }
        },
        {
          "type": "feature",
          "settings": {
            "text": "<p>Das heißt konkret: <strong>8,75 € geschenkt,</strong> bei einer Retoure im Wert von 41,25 €.</p>"
          }
        },
        {
          "type": "feature",
          "settings": {
            "text": "<p><strong>Gutschein-Code innerhalb von 48 Stunden</strong> nach Erhalt und Prüfung deiner Retoure</p>"
          }
        }
      ]
    }
  ]
}
{% endschema %}
