<style>
    #shopify-section-{{ section.id }} {
        {%- if section.settings.background == 'rgba(0,0,0,0)' -%}
          {%- assign section_background = settings.background -%}
        {%- else -%}
          {%- assign section_background = section.settings.background -%}
        {%- endif -%}
    
        {%- if section.settings.text_color == 'rgba(0,0,0,0)' -%}
          {%- assign heading_color = settings.heading_color -%}
          {%- assign text_color = settings.text_color -%}
        {%- else -%}
          {%- assign heading_color = section.settings.text_color -%}
          {%- assign text_color = section.settings.text_color -%}
        {%- endif -%}
    
        --heading-color: {{ heading_color.red }}, {{ heading_color.green }}, {{ heading_color.blue }};
        --text-color: {{ text_color.red }}, {{ text_color.green }}, {{ text_color.blue }};
        {% comment %} --prev-next-button-background: var(--text-color);
        --prev-next-button-color: var(--section-background); {% endcomment %}
        --progress-bar-width: 370px;
    
        --section-background: {{ section_background.red }}, {{ section_background.green }}, {{ section_background.blue }};
      }

    #shopify-section-{{ section.id }} {
        background-color: rgb(var(--section-background));
    }

    @media (min-width: 1000px) {
        #shopify-section-{{ section.id }} {
            padding-top: {{ section.settings.space_top -}}px;
            padding-bottom: {{ section.settings.space_bottom -}}px;
        }
    }
    @media (max-width: 999px) {
        #shopify-section-{{ section.id }} {
            padding-top: {{ section.settings.space_top_mobile -}}px;
            padding-bottom: {{ section.settings.space_bottom_mobile -}}px;
        }
    }



  .marken_uebersicht_heading_wrapper {
    text-align: center;
    margin-bottom: 32px;
  }

  .marken_uebersicht_heading_wrapper h3.heading {
      margin-bottom: 16px;
      line-height: 1;
  }

  .marken_uebersicht_heading_wrapper p {
      margin-top: 0;
  }
  .markenseite_gallery__progress_bar_wrapper {
      max-width: var(--progress-bar-width);
      margin-inline: auto;
  }
  .markenseite_gallery .gallery__item:not(:first-child) {
    margin-inline-start: 20px;
  }

  .markenseite_gallery__item_details {
      background: #FFFFFF;
      border: 1px solid #F3F4F9;
      box-shadow: 0px 84px 34px rgba(156, 162, 176, 0.01), 0px 47px 28px rgba(156, 162, 176, 0.05), 0px 21px 21px rgba(156, 162, 176, 0.09), 0px 5px 12px rgba(156, 162, 176, 0.1);
      border-radius: 16px;
      padding: 20px;
      margin-bottom: 60px;
      cursor: grab;
      justify-content: center;
      display: flex;
      flex-direction: column;
      align-items: center;
  }
  .markenseite_gallery__item__button.button {
      margin-inline: 0;
      width: 100%;
      gap: 6px;
  }

  .markenseite_gallery__item__media {
      max-width: 100%;
      width: auto;
      display: flex;
      align-items: center;
      justify-content: center;
  }
  .markenseite_gallery scrollable-content.gallery__list-wrapper[draggable] {
    cursor: grab;
  }
  gallery-list.gallery.markenseite_gallery .gallery__item {
      width: 240px;
      cursor: auto;
  }


  .markenseite_gallery__item__media img.markenseite_gallery__image,
  .markenseite_gallery__item__media svg.markenseite_gallery__image {
    width: 150px;
    height: 150px;
    object-fit: contain;
    max-width: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-inline: auto;
  }
  @media (max-width: 1360px) {
    .markenseite_gallery__item__media img.markenseite_gallery__image,
    .markenseite_gallery__item__media svg.markenseite_gallery__image{
      height: 120px;
      width: 100%;
      max-width: 100%;
    }
  }
  @media (max-width: 1023px) {
    .markenseite_gallery__item__media img.markenseite_gallery__image,
    .markenseite_gallery__item__media svg.markenseite_gallery__image{
      height: 100px;
      width: 100%;
      max-width: 100%;
    }
  }

  @media (max-width: 767px) {
    .markenseite_gallery__item__media img.markenseite_gallery__image,
    .markenseite_gallery__item__media svg.markenseite_gallery__image{
      height: 80px;
      width: 100%;
      max-width: 100%;
    }
  }


  .markenseite_gallery__item__button {
    margin-top: 25px;
  }


  .markenseite_gallery__item__button {
    display: flex;
    flex-direction: row;
    align-items: center;
    padding: 5px 8px !important;
    gap: 10px;
    border: 1px solid #DFDFDF;
    border-radius: 8px;
    height: 30px;
    justify-content: center;
    max-width: fit-content;
    min-height: fit-content;
    margin-inline: auto;
  }

  .markenseite_gallery__item__button span {
    font-weight: 600;
    font-size: 15px;
    line-height: 16px;
    text-align: center;
    letter-spacing: 0;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .markenseite_gallery__progress_bar_wrapper span.gallery__progress-bar.progress-bar {
    margin-block-start: 0;
    background: #ffffff;
    border-radius: 16px;
    overflow: hidden;
  }
  gallery-list.gallery.markenseite_gallery .custom-drag-cursor {
      display: none;
  }

  .gallery__prev-next-buttons.markenseite_gallery_next_prev {
    top: calc(50% - 60px);
    left: 0;
    right: 0 !important;
  }

  .gallery__prev-next-buttons.markenseite_gallery_next_prev button.gallery__arrow {
    position: unset;
    border-radius: 500px !important;
    box-shadow: 0px 84px 34px rgba(156, 162, 176, 0.01), 0px 47px 28px rgba(156, 162, 176, 0.05), 0px 21px 21px rgba(156, 162, 176, 0.09), 0px 5px 12px rgba(156, 162, 176, 0.1);
  }

  .gallery__prev-next-buttons.markenseite_gallery_next_prev .container {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .markenseite__search_letters_controls {
    position: relative;
    display: flex;
    justify-content: center;
    margin-top: -30px;
  }
  .markenseite__search_letters_controls prev-next-buttons.gallery__prev-next-buttons.prev-next-buttons.markenseite_search_letters_next_prev {
    width:100% !important;
}

  .gallery__prev-next-buttons.markenseite_search_letters_next_prev {
    position: relative;
    top: 0;
    left: 0;
    right: 0 !important;
    width: min(100%, calc(var(--progress-bar-width) + 120px));
  }

  .gallery__prev-next-buttons.markenseite_search_letters_next_prev button.gallery__arrow {
    position: unset;
    border-radius: 500px !important;
    box-shadow: 0px 84px 34px rgba(156, 162, 176, 0.01), 0px 47px 28px rgba(156, 162, 176, 0.05), 0px 21px 21px rgba(156, 162, 176, 0.09), 0px 5px 12px rgba(156, 162, 176, 0.1);
  }

  .gallery__prev-next-buttons.markenseite_search_letters_next_prev .container {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 16px;
    width: 100%;
  }

  .gallery__prev-next-buttons.markenseite_search_letters_next_prev .markenseite_gallery__progress_bar_wrapper {
    flex: 1 1 auto;
    max-width: var(--progress-bar-width);
    margin-inline: 0;
    display: none;
  }

  .gallery__prev-next-buttons.markenseite_search_letters_next_prev button.gallery__arrow[disabled] {
    opacity: 0.35;
  }

  /* Search */
    .markenseite__search_letters [draggable].is-scrollable {
        cursor: auto;
    }
    button.markenseite__search_item {
        width: 50px;
        height: 50px;
        background: #FFFFFF;
        box-shadow: 0px 84px 34px rgba(156, 162, 176, 0.01), 0px 47px 28px rgba(156, 162, 176, 0.05), 0px 21px 21px rgba(156, 162, 176, 0.09), 0px 5px 12px rgba(156, 162, 176, 0.1);
        border-radius: 360px;
        font-weight: 600;
        font-size: 24px;
        line-height: 1;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        text-align: center;
        text-transform: uppercase;
        padding-top: 1px;
    }

    .markenseite__search_letters gallery-item.gallery__item {
        margin-bottom: 60px;
        display: flex;
        gap: 16px;
    }

    .markenseite__search_letters .gallery__list {
    }

    button.markenseite__search_item:hover {
        background: #EDEDED;
    }

    button.markenseite__search_item.active {
        background: linear-gradient(0deg, rgba(0, 0, 0, 0.2), rgba(0, 0, 0, 0.2)), #55576A;
        color: #fff;
    }

    .markenseite__search_box {
        margin-inline: auto;
        display: block;
        max-width: 400px;
        margin-block-end: 60px;
        margin-block-start: 60px;
    }

    form.markenseite_search_form {
        position: relative;
    }

    input.markenseite_search_form__input {
        display: flex;
        flex-direction: row;
        justify-content: space-between;
        align-items: center;
        padding: 8px 16px;
        gap: 4px;
        height: 40px;
        background: #FFFFFF;
        border: 1px solid #F3F4F9;
        border-radius: 8px;
        width: 100%;
        font-style: normal;
        font-weight: 600;
        font-size: 13px;
        line-height: normal;
    }

    button.markenseite_search_form__button {
        position: absolute;
        right: 0;
        top: 0;
        height: 40px;
        width: 40px;
        display: flex;
        align-items: center;
        justify-content: center;
        padding-right: 16px;
    }

    button.markenseite_search_form__button svg {
        display: flex;
    }

    .markenseite_search_form__button.is-hidden {
        display: none;
    }

  /* END:Search */

  /* Brands List */

  .markenseite__heart_divider {
        display: grid;
        grid-template-columns: 1fr auto 1fr;
        align-items: center;
        margin-block: var(--heart-divider-margin-block); }

    span.markenseite__heart_divider-line {
        height: 1px;
        width: 100%;
        background: #DFDFDF;
    }

    span.markenseite__heart_divider-line.right {
    }

    span.markenseite__heart_divider-letter {
        display: flex;
        padding: 0 12px;
        font-weight: 600;
        font-size: 32px;
        line-height: 38px;
    }

    .markenseite__heart_divider_wrapper {
        margin-bottom: 24px;
    }



    .markenseite__brands_list {
        display: grid;
    }

    @media (min-width: 1400px) {
        .markenseite__brands_list {
            grid-template-columns: repeat(5, minmax(0, 1fr));
            gap: 24px 20px;
        }
    }

    @media (min-width: 1200px) and (max-width: 1399px) {
        .markenseite__brands_list {
            grid-template-columns: repeat(4, minmax(0, 1fr));
            gap: 24px 20px;
        }
    }

    @media (min-width: 900px) and (max-width: 1199px) {
        .markenseite__brands_list {
            grid-template-columns: repeat(3, minmax(0, 1fr));
            gap: 16px 16px;
        }
    }

    @media (min-width: 600px) and (max-width: 899px) {
        .markenseite__brands_list {
            grid-template-columns: repeat(2, minmax(0, 1fr));
            gap: 16px 16px;
        }
    }

    @media (max-width: 599px) {
        .markenseite__brands_list {
          grid-template-columns: repeat(2, minmax(0, 1fr));
            gap: 16px 16px;
        }
    }

    .markenseite__brands_item {
        min-width: 0;
    }

    .markenseite__brands_list .markenseite_gallery__item_details {
        margin-bottom: 0;
        cursor: unset;
    }

    .markenseite__brands_pagination {
        margin-top: 32px;
        margin-bottom: 24px;
        display: flex;
        justify-content: center;
    }

    .markenseite__brands_load_more_wrapper {
        margin-top: 32px;
        margin-bottom: 24px;
        text-align: center;
    }

    .markenseite__brands_load_more_btn {
        display: inline-block;
        padding: 12px 24px;
        font-weight: 600;
        cursor: pointer;
        text-decoration: underline;
        text-underline-offset: 0.2em;
    }

    .markenseite__brands_load_more_btn:hover {
        text-decoration-thickness: 2px;
    }

    .markenseite__brands_item.is-hidden {
        display: none;
    }

    .markenseite__heart_divider_wrapper.is-hidden {
        display: none;
    }

    .markenseite__brands_list_wrapper.is-hidden {
        display: none;
    }

    .markenseite_gallery__item__media img {
        width: 150px;
        height: 150px;
        object-fit: contain;
        max-width: 100%;
        display: flex;
        align-items: center;
        justify-content: center;
        margin-inline: auto;
    }

    @media (max-width: 767px) {
      .gallery__prev-next-buttons.markenseite_gallery_next_prev .container {
        justify-content: center;
      }
      button.gallery__arrow.prev-next-button {
        width: 34px;
        height: 34px;
      }
      .prev-next-button svg {
          width: 18px;
          height: 18px;
      }
      
      .gallery__progress-bar-wrapper.markenseite_gallery__progress_bar_wrapper {
          --progress-bar-width: 200px;
      }
      .markenseite__search_letters gallery-item.gallery__item {
        gap: 8px;
      }
      
      .markenseite__search_letters_controls {
          margin-top: -40px;
      }
    
      .markenseite__search_box {
        margin-block-start: 24px;
        margin-block-end: 24px;
      }
      
      button.markenseite__search_item {
        width: 42px;
        height: 42px;
        font-size: 18px;
      }
      gallery-list.gallery.markenseite_gallery .gallery__item {
        width: 190px;
      }
      .markenseite_gallery__item__button {
        margin-top: 16px;
      }
    }

  /* Ultra-wide: Breaks carousel out to full viewport */
  @media (min-width: 2049px) and (max-width: 2360px) {
    #shopify-section-{{ section.id }} {
      overflow-x: clip;
    }

    #shopify-section-{{ section.id }} .markenseite_gallery__scroll-bleed {
      width: 100vw;
      max-width: none;
      margin-inline-start: calc(50% - 37vw);
    }

    #shopify-section-{{ section.id }} .markenseite_gallery__scroll-inner {
      max-width: none;
      width: 100%;
      margin-inline: 0;
      padding-inline: 0;
    }
  }
  @media (min-width: 2361px) and (max-width: 2560px) {
    #shopify-section-{{ section.id }} {
      overflow-x: clip;
    }

    #shopify-section-{{ section.id }} .markenseite_gallery__scroll-bleed {
      width: 100vw;
      max-width: none;
      margin-inline-start: calc(50% - 33vw);
    }

    #shopify-section-{{ section.id }} .markenseite_gallery__scroll-inner {
      max-width: none;
      width: 100%;
      margin-inline: 0;
      padding-inline: 0;
    }
  }

  @media (min-width: 2561px) and (max-width: 3000px) {
    #shopify-section-{{ section.id }} {
      overflow-x: clip;
    }

    #shopify-section-{{ section.id }} .markenseite_gallery__scroll-bleed {
      width: 100vw;
      max-width: none;
      margin-inline-start: calc(50% - 31vw);
    }

    #shopify-section-{{ section.id }} .markenseite_gallery__scroll-inner {
      max-width: none;
      width: 100%;
      margin-inline: 0;
      padding-inline: 0;
    }
  }
  /* END:Ultra-wide */
</style>

{%- assign metaobject_type_handle = section.settings.metaobject_type_handle | default: 'markenseite_brands' -%}
{%- comment -%}
  Paginate by 250 (Shopify Liquid max per page).
{%- endcomment -%}
{%- paginate shop.metaobjects[metaobject_type_handle].values by 250 -%}
  {%- assign brands = shop.metaobjects[metaobject_type_handle].values -%}
  {% if brands.size > 0 %}
  <section class="ed-markenseite-brands-with-search">
    <div class="section__color-wrapper">
      <div class="markenseite__search_wrapper">
        <div class="markenseite__search_letters">
          <scrollable-content
            {% unless section.settings.show_arrows %}
              draggable
            {% endunless %}
            class="gallery__list-wrapper markenseite_gallery__scroll-bleed {% if section.blocks.size >= 3 %}is-scrollable{% endif %} hide-scrollbar"
          >
            <div class="container markenseite_gallery__scroll-inner">
              <div class="gallery__list">
                <gallery-item class="gallery__item">
                  <button type="button" class="markenseite__search_item" data-letter="a">a</button>
                  <button type="button" class="markenseite__search_item" data-letter="b">b</button>
                  <button type="button" class="markenseite__search_item" data-letter="c">c</button>
                  <button type="button" class="markenseite__search_item" data-letter="d">d</button>
                  <button type="button" class="markenseite__search_item" data-letter="e">e</button>
                  <button type="button" class="markenseite__search_item" data-letter="f">f</button>
                  <button type="button" class="markenseite__search_item" data-letter="g">g</button>
                  <button type="button" class="markenseite__search_item" data-letter="h">h</button>
                  <button type="button" class="markenseite__search_item" data-letter="i">i</button>
                  <button type="button" class="markenseite__search_item" data-letter="j">j</button>
                  <button type="button" class="markenseite__search_item" data-letter="k">k</button>
                  <button type="button" class="markenseite__search_item" data-letter="l">l</button>
                  <button type="button" class="markenseite__search_item" data-letter="m">m</button>
                  <button type="button" class="markenseite__search_item" data-letter="n">n</button>
                  <button type="button" class="markenseite__search_item" data-letter="o">o</button>
                  <button type="button" class="markenseite__search_item" data-letter="p">p</button>
                  <button type="button" class="markenseite__search_item" data-letter="q">q</button>
                  <button type="button" class="markenseite__search_item" data-letter="r">r</button>
                  <button type="button" class="markenseite__search_item" data-letter="s">s</button>
                  <button type="button" class="markenseite__search_item" data-letter="t">t</button>
                  <button type="button" class="markenseite__search_item" data-letter="u">u</button>
                  <button type="button" class="markenseite__search_item" data-letter="v">v</button>
                  <button type="button" class="markenseite__search_item" data-letter="w">w</button>
                  <button type="button" class="markenseite__search_item" data-letter="x">x</button>
                  <button type="button" class="markenseite__search_item" data-letter="y">y</button>
                  <button type="button" class="markenseite__search_item" data-letter="z">z</button>
                </gallery-item>
              </div>
            </div>
          </scrollable-content>

          <div class="markenseite__search_letters_controls">
            <prev-next-buttons class="gallery__prev-next-buttons prev-next-buttons markenseite_search_letters_next_prev">
              <div class="container">
                <button class="gallery__arrow prev-next-button prev-next-button--prev" data-search-letters-prev>
                  <span class="visually-hidden">{{ 'general.accessibility.previous' | t }}</span>
                  {%- render 'icon' with 'chevron-left', direction_aware: true -%}
                </button>

                <div class="gallery__progress-bar-wrapper markenseite_gallery__progress_bar_wrapper">
                  <span class="gallery__progress-bar progress-bar" data-search-letters-progress></span>
                </div>

                <button class="gallery__arrow prev-next-button prev-next-button--next" data-search-letters-next>
                  <span class="visually-hidden">{{ 'general.accessibility.next' | t }}</span>
                  {%- render 'icon' with 'chevron-right', direction_aware: true -%}
                </button>
              </div>
            </prev-next-buttons>
          </div>
        </div>

        <div class="markenseite__search_box" data-markenseite-brand-search>
          <form class="markenseite_search_form" method="get" aria-label="Marken suchen">
            <input
              class="markenseite_search_form__input"
              type="text"
              name="brand_q"
              placeholder="Welche Marke suchst du?"
              aria-label="Welche Marke suchst du?"
            >
            <button
              class="markenseite_search_form__button markenseite_search_form__button--submit"
              type="submit"
              aria-label="Suchen"
            >
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                <path d="M21.5308 20.4694L16.8368 15.7763C18.1973 14.1429 18.8757 12.0478 18.7309 9.92694C18.5861 7.80607 17.6293 5.82268 16.0593 4.38935C14.4894 2.95602 12.4274 2.18311 10.3021 2.23141C8.17687 2.27971 6.15205 3.1455 4.64888 4.64867C3.14571 6.15184 2.27993 8.17666 2.23163 10.3019C2.18333 12.4272 2.95623 14.4892 4.38956 16.0591C5.82289 17.629 7.80629 18.5859 9.92715 18.7307C12.048 18.8755 14.1431 18.1971 15.7765 16.8366L20.4696 21.5306C20.5393 21.6003 20.622 21.6556 20.713 21.6933C20.8041 21.731 20.9017 21.7504 21.0002 21.7504C21.0988 21.7504 21.1963 21.731 21.2874 21.6933C21.3784 21.6556 21.4612 21.6003 21.5308 21.5306C21.6005 21.4609 21.6558 21.3782 21.6935 21.2872C21.7312 21.1961 21.7506 21.0985 21.7506 21C21.7506 20.9015 21.7312 20.8039 21.6935 20.7128C21.6558 20.6218 21.6005 20.5391 21.5308 20.4694ZM3.75021 10.5C3.75021 9.16498 4.14609 7.85993 4.88779 6.7499C5.62949 5.63987 6.6837 4.77471 7.9171 4.26381C9.1505 3.75292 10.5077 3.61925 11.8171 3.8797C13.1264 4.14015 14.3292 4.78303 15.2732 5.72703C16.2172 6.67103 16.8601 7.87377 17.1205 9.18314C17.381 10.4925 17.2473 11.8497 16.7364 13.0831C16.2255 14.3165 15.3603 15.3707 14.2503 16.1124C13.1403 16.8541 11.8352 17.25 10.5002 17.25C8.71061 17.248 6.99488 16.5362 5.72944 15.2708C4.464 14.0053 3.7522 12.2896 3.75021 10.5Z" fill="#1D1D1D"/>
              </svg>
            </button>
            <button
              class="markenseite_search_form__button markenseite_search_form__button--clear is-hidden"
              type="button"
              aria-label="Suche zurücksetzen"
            >
              <svg
                width="24"
                height="24"
                viewBox="0 0 24 24"
                fill="none"
                xmlns="http://www.w3.org/2000/svg"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <path d="M18 6L6 18M6 6l12 12"/>
              </svg>
            </button>
          </form>
        </div>
      </div>

      {%- if section.settings.show_selected_letter -%}
        <div class="container">
          <div class="markenseite__heart_divider_wrapper">
            <div class="markenseite__heart_divider">
              <span class="markenseite__heart_divider-line"></span>
              <span class="markenseite__heart_divider-letter">
                {% render 'icon' with 'heart-divider' %}
              </span>
              <span class="markenseite__heart_divider-line right"></span>
            </div>
          </div>
        </div>
      {%- endif -%}

      <div class="markenseite__brands_list_wrapper">
        <div class="container">
          <div class="markenseite__brands_list">
            {%- for brand in brands -%}
              {%- assign brand_name = brand.brand_name -%}
              {%- if brand_name == blank and brand.brand_name.value != blank -%}
                {%- assign brand_name = brand.brand_name.value -%}
              {%- endif -%}

              {%- assign logo = brand.logo -%}
              {%- if logo == blank and brand.logo.value != blank -%}
                {%- assign logo = brand.logo.value -%}
              {%- endif -%}
              {%- assign logo_image = logo.preview_image | default: logo -%}
              {%- assign logo_src = blank -%}
              {%- if logo_image != blank -%}
                {%- assign logo_src = logo_image | image_url: width: 400 -%}
              {%- endif -%}

              {%- assign button_text = brand.button_text -%}
              {%- if button_text == blank and brand.button_text.value != blank -%}
                {%- assign button_text = brand.button_text.value -%}
              {%- endif -%}

              {%- assign button_url = brand.button_url -%}
              {%- if button_url == blank and brand.button_url.value != blank -%}
                {%- assign button_url = brand.button_url.value -%}
              {%- endif -%}

              <div
                class="markenseite__brands_item"
                data-brand-name="{{ brand_name | strip | downcase | escape }}"
              >
                <div class="markenseite_gallery__item_details">
                  <div class="markenseite_gallery__item__media">
                    {%- if logo_src != blank -%}
                      {{-
                        logo_image
                        | image_url: width: 400
                        | image_tag: class: 'markenseite_gallery__image', loading: 'lazy', alt: brand_name
                        | default: 'Brand logo'
                      -}}
                    {%- else -%}
                      {{-
                        'image'
                        | placeholder_svg_tag: 'markenseite_gallery__image markenseite_gallery__image placeholder-background'
                      -}}
                    {%- endif -%}
                  </div>

                  {%- if button_text != blank and button_url != blank -%}
                    <a href="{{ button_url }}" class="markenseite_gallery__item__button button button--outline">
                      <span>{{ button_text }}</span>
                      {% render 'icon' with 'icon-arrow-right' %}
                    </a>
                  {%- endif -%}
                </div>
              </div>
            {%- endfor -%}
          </div>

          {%- if section.settings.show_load_more -%}
            {%- if paginate.next -%}
              <div class="markenseite__brands_load_more_wrapper" {% if section.settings.enable_auto_load %}style="display: none;"{% endif %}>
                <button
                  type="button"
                  class="link markenseite__brands_load_more_btn"
                  data-next-url="{{ paginate.next.url }}"
                >
                  {{ section.settings.load_more_button_text }}
                </button>
              </div>
            {%- endif -%}
          {%- elsif paginate.pages > 1 -%}
            <div class="markenseite__brands_pagination">
              {%- render 'pagination', paginate: paginate, use_ajax: true -%}
            </div>
          {%- endif -%}

          {%- if section.settings.show_header_divider -%}
            <div class="markenseite__heart_divider_wrapper">
              {% render 'ed-heart-divider', margin: '45px' %}
            </div>
          {%- endif -%}
        </div>
      </div>
    </div>
  </section>

  <script>
    (function () {
      const section = document.querySelector('#shopify-section-{{ section.id }}');
      if (!section) return;

      const letterButtons = section.querySelectorAll('.markenseite__search_item');
      const searchInput = section.querySelector('.markenseite__search_box input[name="brand_q"]');
      const brandsListWrapper = section.querySelector('.markenseite__brands_list_wrapper');
      const submitBtn = section.querySelector('.markenseite_search_form__button--submit');
      const clearBtn = section.querySelector('.markenseite_search_form__button--clear');
      const selectedLetterLabel = section.querySelector('.markenseite__heart_divider-letter');
      const defaultSelectedLetterContent = selectedLetterLabel ? selectedLetterLabel.innerHTML : '';
      const lettersScrollSurface = section.querySelector('.markenseite__search_letters .gallery__list-wrapper');
      const lettersControls = section.querySelector('.markenseite_search_letters_next_prev');
      const lettersPrevButton = section.querySelector('[data-search-letters-prev]');
      const lettersNextButton = section.querySelector('[data-search-letters-next]');
      const lettersProgressBar = section.querySelector('[data-search-letters-progress]');

      function updateLettersControlsState() {
        if (!lettersScrollSurface || !lettersControls) return;

        const maxScroll = Math.max(0, lettersScrollSurface.scrollWidth - lettersScrollSurface.clientWidth);
        const currentScroll = lettersScrollSurface.scrollLeft;
        const threshold = 2;
        const isScrollable = maxScroll > threshold;

        lettersControls.style.display = isScrollable ? '' : 'none';
        if (!isScrollable) return;

        const progress = maxScroll > 0 ? Math.min(100, Math.max(0, (currentScroll / maxScroll) * 100)) : 0;
        if (lettersProgressBar) {
          const divider = Math.max(1, lettersScrollSurface.scrollWidth / Math.max(1, lettersScrollSurface.clientWidth));
          lettersProgressBar.style.setProperty('--divider', divider.toFixed(3));
          lettersProgressBar.style.setProperty('--transform', `${progress}%`);
        }
        if (lettersPrevButton) {
          lettersPrevButton.disabled = currentScroll <= threshold;
        }
        if (lettersNextButton) {
          lettersNextButton.disabled = currentScroll >= maxScroll - threshold;
        }
      }

      function scrollLettersByStep(direction) {
        if (!lettersScrollSurface) return;
        const step = Math.max(180, Math.floor(lettersScrollSurface.clientWidth * 0.7));
        lettersScrollSurface.scrollBy({ left: direction * step, behavior: 'smooth' });
      }

      function updateSearchButtonState() {
        var hasValue = searchInput && searchInput.value.trim().length > 0;
        if (submitBtn) submitBtn.classList.toggle('is-hidden', hasValue);
        if (clearBtn) clearBtn.classList.toggle('is-hidden', !hasValue);
      }

      function applyFilters() {
        const brandItems = section.querySelectorAll('.markenseite__brands_item');
        const activeLetterButton = section.querySelector('.markenseite__search_item.active');
        const selectedLetter = activeLetterButton
          ? activeLetterButton.dataset.letter || activeLetterButton.textContent.trim().toLowerCase()
          : '';
        const searchQuery = searchInput && searchInput.value ? searchInput.value.trim().toLowerCase() : '';

        let visibleCount = 0;
        brandItems.forEach(function (item) {
          const brandName = (item.getAttribute('data-brand-name') || '').toLowerCase();
          const matchesLetter = !selectedLetter || brandName.charAt(0) === selectedLetter;
          const matchesSearch = !searchQuery || brandName.includes(searchQuery);
          const visible = matchesLetter && matchesSearch;
          item.classList.toggle('is-hidden', !visible);
          if (visible) visibleCount++;
        });

        if (brandsListWrapper) {
          brandsListWrapper.classList.toggle('is-hidden', visibleCount === 0);
        }

        if (selectedLetterLabel) {
          if (selectedLetter) {
            selectedLetterLabel.textContent = selectedLetter.toUpperCase();
          } else {
            selectedLetterLabel.innerHTML = defaultSelectedLetterContent;
          }
        }
      }

      letterButtons.forEach(function (btn) {
        btn.addEventListener('click', function () {
          const letter = this.dataset.letter || this.textContent.trim().toLowerCase();
          const wasActive = this.classList.contains('active');
          letterButtons.forEach(function (b) {
            b.classList.remove('active');
          });
          if (!wasActive) this.classList.add('active');
          applyFilters();
        });
      });

      if (searchInput) {
        searchInput.addEventListener('input', function () {
          applyFilters();
          updateSearchButtonState();
        });
        searchInput.addEventListener('keyup', applyFilters);
      }

      if (clearBtn && searchInput) {
        clearBtn.addEventListener('click', function () {
          searchInput.value = '';
          searchInput.focus();
          applyFilters();
          updateSearchButtonState();
        });
      }

      updateSearchButtonState();
      applyFilters();
      if (lettersPrevButton) {
        lettersPrevButton.addEventListener('click', function () {
          scrollLettersByStep(-1);
        });
      }
      if (lettersNextButton) {
        lettersNextButton.addEventListener('click', function () {
          scrollLettersByStep(1);
        });
      }
      if (lettersScrollSurface) {
        lettersScrollSurface.addEventListener('scroll', updateLettersControlsState, { passive: true });
      }
      window.addEventListener('resize', updateLettersControlsState);
      requestAnimationFrame(updateLettersControlsState);
      section.addEventListener('markenseite-brands-loaded', applyFilters);
    })();
  </script>

  {% if section.settings.show_load_more %}
  <script>
    (function() {
      const section = document.querySelector('#shopify-section-{{ section.id }}');
      if (!section) return;

      let isLoading = false;
      let scrollHandler = null;
      let scrollTimeout = null;
      const enableAutoLoad = {{ section.settings.enable_auto_load | json }};
      const loadMoreBtnText = {{ section.settings.load_more_button_text | json }};

      function loadMoreBrands(nextUrl) {
        if (isLoading || !nextUrl) return;

        isLoading = true;
        const btn = section.querySelector('.markenseite__brands_load_more_btn');
        if (btn) btn.textContent = 'Wird geladen...';

        fetch(nextUrl)
          .then(function(res) { return res.text(); })
          .then(function(html) {
            const parser = new DOMParser();
            const doc = parser.parseFromString(html, 'text/html');
            const sectionInDoc = doc.querySelector('#shopify-section-{{ section.id }}');
            if (!sectionInDoc) { isLoading = false; return; }

            const newItems = sectionInDoc.querySelectorAll('.markenseite__brands_item');
            const container = section.querySelector('.markenseite__brands_list');
            if (newItems.length && container) {
              newItems.forEach(function(item) {
                container.appendChild(item.cloneNode(true));
              });
            }

            const newBtn = sectionInDoc.querySelector('.markenseite__brands_load_more_btn');
            const currentBtn = section.querySelector('.markenseite__brands_load_more_btn');

            if (newBtn && currentBtn) {
              const next = newBtn.getAttribute('data-next-url');
              currentBtn.setAttribute('data-next-url', next || '');
              currentBtn.textContent = loadMoreBtnText;
            } else if (currentBtn) {
              const wrapper = currentBtn.closest('.markenseite__brands_load_more_wrapper');
              if (wrapper) wrapper.remove();
            }

            section.dispatchEvent(new CustomEvent('markenseite-brands-loaded'));
            isLoading = false;
          })
          .catch(function() {
            const btn = section.querySelector('.markenseite__brands_load_more_btn');
            if (btn) btn.textContent = loadMoreBtnText;
            isLoading = false;
          });
      }

      section.addEventListener('click', function(e) {
        const btn = e.target.closest('.markenseite__brands_load_more_btn');
        if (!btn) return;
        e.preventDefault();
        loadMoreBrands(btn.getAttribute('data-next-url'));
      });

      {% if section.settings.enable_auto_load %}
      function handleScroll() {
        if (isLoading) return;
        const btn = section.querySelector('.markenseite__brands_load_more_btn');
        if (!btn || !btn.getAttribute('data-next-url')) return;
        const listWrapper = section.querySelector('.markenseite__brands_list_wrapper');
        if (!listWrapper) return;
        const rect = listWrapper.getBoundingClientRect();
        const viewportHeight = window.innerHeight || document.documentElement.clientHeight;
        if (rect.bottom - viewportHeight < 1000) loadMoreBrands(btn.getAttribute('data-next-url'));
      }
      scrollHandler = function() {
        clearTimeout(scrollTimeout);
        scrollTimeout = setTimeout(handleScroll, 50);
      };
      window.addEventListener('scroll', scrollHandler, { passive: true });
      {% endif %}
    })();
  </script>
  {% endif %}
  {% endif %}
{%- endpaginate -%}

