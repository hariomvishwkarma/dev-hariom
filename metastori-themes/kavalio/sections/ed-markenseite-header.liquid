<style>
  #shopify-section-{{ section.id }} {
    {%- if section.settings.background == 'rgba(0,0,0,0)' -%}
      {%- assign section_background = settings.background -%}
    {%- else -%}
      {%- assign section_background = section.settings.background -%}
    {%- endif -%}

    {%- if section.settings.text_color == 'rgba(0,0,0,0)' -%}
      {%- assign heading_color = settings.heading_color -%}
      {%- assign text_color = settings.text_color -%}
    {%- else -%}
      {%- assign heading_color = section.settings.text_color -%}
      {%- assign text_color = section.settings.text_color -%}
    {%- endif -%}

    --heading-color: {{ heading_color.red }}, {{ heading_color.green }}, {{ heading_color.blue }};
    --text-color: {{ text_color.red }}, {{ text_color.green }}, {{ text_color.blue }};
    {% comment %} --prev-next-button-background: var(--text-color);
    --prev-next-button-color: var(--section-background); {% endcomment %}
    --progress-bar-width: 400px;

    --section-background: {{ section_background.red }}, {{ section_background.green }}, {{ section_background.blue }};
  }

  #shopify-section-{{ section.id }} {
    background-color: rgb(var(--section-background));
  }

  @media (min-width: 1000px) {
    #shopify-section-{{ section.id }} {
        padding-top: {{ section.settings.space_top -}}px;
        padding-bottom: {{ section.settings.space_bottom -}}px;
    }
  }
  @media (max-width: 999px) {
    #shopify-section-{{ section.id }} {
      padding-top: {{ section.settings.space_top_mobile -}}px;
      padding-bottom: {{ section.settings.space_bottom_mobile -}}px;
    }
  }
  .marken_uebersicht_heading_wrapper {
    text-align: center;
    margin-bottom: 32px;
  }

  .marken_uebersicht_heading_wrapper h3.heading {
      margin-bottom: 16px;
      line-height: 1;
  }

  .marken_uebersicht_heading_wrapper p {
      margin-top: 0;
  }
  .markenseite_gallery__progress_bar_wrapper {
      max-width: var(--progress-bar-width);
      margin-inline: auto;
  }
  .markenseite_gallery .gallery__item:not(:first-child) {
    margin-inline-start: 20px;
  }

  .markenseite_gallery__item_details {
      background: #FFFFFF;
      border: 1px solid #F3F4F9;
      box-shadow: 0px 84px 34px rgba(156, 162, 176, 0.01), 0px 47px 28px rgba(156, 162, 176, 0.05), 0px 21px 21px rgba(156, 162, 176, 0.09), 0px 5px 12px rgba(156, 162, 176, 0.1);
      border-radius: 16px;
      padding: 20px;
      margin-bottom: 60px;
      cursor: grab;
      justify-content: center;
      display: flex;
      flex-direction: column;
      align-items: center;
  }
  .markenseite_gallery__item__button.button {
      margin-inline: 0;
      width: 100%;
      gap: 6px;
  }

  {% comment %} .markenseite_gallery .gallery__list {
    justify-content: center;
  } {% endcomment %}

  .markenseite_gallery__item__media {
      max-width: 100%;
      width: auto;
      display: flex;
      align-items: center;
      justify-content: center;
  }
  .markenseite_gallery scrollable-content.gallery__list-wrapper[draggable] {
    cursor: grab;
  }
  gallery-list.gallery.markenseite_gallery .gallery__item {
      width: 250px;
      cursor: auto;
  }


  .markenseite_gallery__item__media img.markenseite_gallery__image,
  .markenseite_gallery__item__media svg.markenseite_gallery__image {
    width: 150px;
    height: 150px;
    object-fit: contain;
    max-width: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-inline: auto;
  }


  .markenseite_gallery__item__button {
    margin-top: 25px;
  }


  .markenseite_gallery__item__button {
    display: flex;
    flex-direction: row;
    align-items: center;
    padding: 5px 8px !important;
    gap: 10px;
    border: 1px solid #DFDFDF;
    border-radius: 8px;
    height: 30px;
    justify-content: center;
    max-width: fit-content;
    min-height: fit-content;
    margin-inline: auto;
  }

  .markenseite_gallery__item__button span {
    font-weight: 600;
    font-size: 16px;
    line-height: 16px;
    text-align: center;
    letter-spacing: 0;
    height: 30px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .markenseite_gallery__progress_bar_wrapper span.gallery__progress-bar.progress-bar {
    margin-block-start: 0;
    background: #ffffff;
    height: 3px;
    border-radius: 16px;
    overflow: hidden;
  }
  gallery-list.gallery.markenseite_gallery .custom-drag-cursor {
      display: none;
  }
  .gallery-list-controls-wrapper {
      position: relative;
      display: flex;
      justify-content: center;
      margin-top: -30px;
  }

  .gallery__prev-next-buttons.markenseite_gallery_next_prev {
    position: relative;
    width: min(100%, calc(var(--progress-bar-width) + 120px)) !important;
  }

  button.gallery__arrow.prev-next-button {
    width: 44px;
    height: 44px;
  }

  .gallery__prev-next-buttons.markenseite_gallery_next_prev button.gallery__arrow {
    position: unset;
    border-radius: 500px !important;
    box-shadow: 0px 84px 34px rgba(156, 162, 176, 0.01), 0px 47px 28px rgba(156, 162, 176, 0.05), 0px 21px 21px rgba(156, 162, 176, 0.09), 0px 5px 12px rgba(156, 162, 176, 0.1);
    border-top: 1px solid rgba(var(--prev-next-button-color, var(--root-text-color)),.15);
  }

  .gallery__prev-next-buttons.markenseite_gallery_next_prev .container {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 16px;
    width: 100%;
  }

  .gallery__prev-next-buttons.markenseite_gallery_next_prev .markenseite_gallery__progress_bar_wrapper {
    flex: 1 1 auto;
    max-width: var(--progress-bar-width);
    margin-inline: 0;
  }
  button.gallery__arrow.prev-next-button[disabled] {
    opacity: 0.4;
  }


  @media (max-width: 767px) {
    .gallery__prev-next-buttons.markenseite_gallery_next_prev .container {
      justify-content: center;
    }
    button.gallery__arrow.prev-next-button {
      width: 34px;
      height: 34px;
    }
    .prev-next-button svg {
        width: 18px;
        height: 18px;
    }
    
    .gallery__progress-bar-wrapper.markenseite_gallery__progress_bar_wrapper {
        --progress-bar-width: 200px;
    }
    gallery-list.gallery.markenseite_gallery .gallery__item {
      width: 190px;
    }
    .markenseite_gallery__item__button {
      margin-top: 16px;
    }
  }
  
  /* Ultra-wide: Breaks carousel out to full viewport */
  @media (min-width: 2049px) and (max-width: 2560px) {
    #shopify-section-{{ section.id }} {
      overflow-x: clip;
    }

    #shopify-section-{{ section.id }} .markenseite_gallery__scroll-bleed {
      width: 100vw;
      max-width: none;
      margin-inline-start: calc(50% - 50vw);
    }

    #shopify-section-{{ section.id }} .markenseite_gallery__scroll-inner {
      max-width: none;
      width: 100%;
      margin-inline: 0;
      padding-inline: 0;
    }
  }

  @media (min-width: 2561px) and (max-width: 3000px) {
    #shopify-section-{{ section.id }} {
      overflow-x: clip;
    }

    #shopify-section-{{ section.id }} .markenseite_gallery__scroll-bleed {
      width: 100vw;
      max-width: none;
      margin-inline-start: calc(50% - 46vw);
      margin-inline-end: calc(50% - 50vw);
    }

    #shopify-section-{{ section.id }} .markenseite_gallery__scroll-inner {
      max-width: none;
      width: 100%;
      margin-inline: 0;
      padding-inline: 0;
    }
  }
  /* END:Ultra-wide */

</style>

<section class="ed-markenseite-header">
  <div class="section__color-wrapper">
    {%- if section.settings.subheading != blank or section.settings.title != blank -%}
      <header class="marken_uebersicht_heading_wrapper container text-container">
        {%- if section.settings.subheading != blank -%}
          <h2 class="heading heading--small">{{ section.settings.subheading | escape }}</h2>
        {%- endif -%}

        {%- if section.settings.title != blank -%}
          <h3 class="heading h2">{{ section.settings.title | escape }}</h3>
        {%- endif -%}

        {%- if section.settings.content != blank -%}
          <div class="marken_uebersicht_heading_content">
            {{- section.settings.content -}}
          </div>
        {%- endif -%}
        {%- if section.settings.show_header_divider -%}
          {% render 'ed-heart-divider', margin: '20px' %}
        {%- endif -%}
      </header>
    {%- endif -%}

    {%- comment -%}
    If we have more than 3 blocks we assume that by default the content may be scrollable. This may not be the case and
    the JavaScript will fired up to remove it in case it is needed, but if it is indeed scrollable this will avoid
    a reflow of the browser rendering engine. From our tests 3 is a sane default.
    {%- endcomment -%}
    <gallery-list class="gallery markenseite_gallery">
      <scrollable-content draggable class="gallery__list-wrapper markenseite_gallery__scroll-bleed {% if section.blocks.size >= 3 %}is-scrollable{% endif %} hide-scrollbar">
        <div class="container markenseite_gallery__scroll-inner">
          <div class="gallery__list">
            {%- for block in section.blocks -%}
              <gallery-item class="gallery__item" {{ block.shopify_attributes }}>
                <div class="markenseite_gallery__item_details">
                  <div class="markenseite_gallery__item__media">
                    {%- if block.settings.image -%}
                      {%- assign mobile_size = 370 | times: block.settings.image.aspect_ratio | ceil -%}
                      {%- assign tablet_size = 520 | times: block.settings.image.aspect_ratio | ceil -%}
                      {%- assign desktop_size = 600 | times: block.settings.image.aspect_ratio | ceil -%}
                      {%- capture sizes_attribute -%}(max-width: 740px) {{ mobile_size }}px, (max-width: 999px) {{ tablet_size }}px, {{ desktop_size }}px{%- endcapture -%}
  
                      {{ block.settings.image | image_url: width: block.settings.image.width | image_tag: loading: 'lazy', sizes: sizes_attribute, widths: '300,400,500,600,700,800,900,1000,1100,1200,1300,1400,1500,1600,1700,1800,1900,2000', class: 'markenseite_gallery__image' }}
                    {%- else -%}
                      {{- 'image' | placeholder_svg_tag: 'markenseite_gallery__image markenseite_gallery__image placeholder-background' -}}
                    {%- endif -%}
                  </div>

                  {% if block.settings.button_text != blank %}
                    <a href="{{ block.settings.button_link }}" class="markenseite_gallery__item__button button button--outline">
                      <span>{{ block.settings.button_text }}</span>
                      {% render 'icon' with 'icon-arrow-right' %}
                    </a>
                  {% endif %}
                </div>
              </gallery-item>
            {%- endfor -%}
          </div>
        </div>
      </scrollable-content>

      <div class="gallery-list-controls-wrapper">
        {%- if section.blocks.size > 1 and section.settings.show_arrows -%}
          <prev-next-buttons class="gallery__prev-next-buttons prev-next-buttons markenseite_gallery_next_prev">
            <div class="container">
              <button class="gallery__arrow prev-next-button prev-next-button--prev">
                <span class="visually-hidden">{{ 'general.accessibility.previous' | t }}</span>
                {%- render 'icon' with 'chevron-left', direction_aware: true -%}
              </button>

              <div class="gallery__progress-bar-wrapper markenseite_gallery__progress_bar_wrapper">
                <span class="gallery__progress-bar progress-bar" style="--divider: {{ section.blocks.size }}"></span>
              </div>

              <button class="gallery__arrow prev-next-button prev-next-button--next">
                <span class="visually-hidden">{{ 'general.accessibility.next' | t }}</span>
                {%- render 'icon' with 'chevron-right', direction_aware: true -%}
              </button>
            </div>
          </prev-next-buttons>
        {% endif %}
  
        
      </div>
    </gallery-list>
  </div>
</section>

{% schema %}
{
  "name": "Markenseite Header",
  "class": "shopify-section--markenseite-header",
  "disabled_on": {
    "groups": ["header", "custom.overlay"]
  },
  "blocks": [
    {
      "type": "image",
      "name": "Image",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image",
          "info": "1500 x 1800 px .jpg recommended"
        },
        {
          "type": "text",
          "id": "button_text",
          "label": "Button text",
          "default": "Button"
        },
        {
          "type": "url",
          "id": "button_link",
          "label": "Button link"
        }
      ]
    }
  ],
  "settings": [
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "Unsere Marken"
    },
    {
      "type": "richtext",
      "id": "content",
      "label": "Content",
      "default": "<p>Entdecke die Top-Marken im Reitsport bei kavalio</p>"
    },
    {
      "type": "checkbox",
      "id": "show_header_divider",
      "label": "Show header divider",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_arrows",
      "label": "Show navigation arrows",
      "default": false
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "background",
      "label": "Background",
      "default": "rgba(0,0,0,0)"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Color",
      "default": "rgba(0,0,0,0)"
    },
    {
      "type": "header",
      "content": "Section spacing"
    },
    {
      "type": "range",
      "id": "space_top",
      "min": 1,
      "max": 100,
      "step": 1,
      "unit": "px",
      "label": "Top space",
      "default": 100
    },
    {
      "type": "range",
      "id": "space_bottom",
      "min": 1,
      "max": 100,
      "step": 1,
      "unit": "px",
      "label": "Bottom space",
      "default": 1
    },
    {
      "type": "paragraph",
      "content": "Section spacing (Mobile)"
    },
    {
      "type": "range",
      "id": "space_top_mobile",
      "min": 1,
      "max": 100,
      "step": 1,
      "unit": "px",
      "label": "Top (mobile)",
      "default": 45
    },
    {
      "type": "range",
      "id": "space_bottom_mobile",
      "min": 1,
      "max": 100,
      "step": 1,
      "unit": "px",
      "label": "Bottom (mobile)",
      "default": 1
    },
  ],
  "presets": [
    {
      "name": "Markenseite Header",
      "blocks": [
        {
          "type": "image"
        },
        {
          "type": "image"
        },
        {
          "type": "image"
        }
      ],
      "settings": {
        "background": "#F6F6F6"
      }
    } 
  ]
}
{% endschema %}