{%- assign collection_sort_by = collection.sort_by | default: collection.default_sort_by -%}
{%- assign active_filters_count = 0 -%}

{%- for filter in collection.filters -%}
  {%- if filter.type == 'list' -%}
    {%- assign active_filters_count = active_filters_count | plus: filter.active_values.size -%}
  {%- elsif filter.type == 'price_range' and filter.min_value.value or filter.max_value.value -%}
    {%- assign active_filters_count = active_filters_count | plus: 1 -%}
  {%- endif -%}
{%- endfor -%}

{%- liquid
  assign row_base = section.settings.desktop_products_per_row
  assign mobile_row = section.settings.mobile_products_per_row | times: 1
  assign base_per_page = section.settings.products_per_page
  assign row_lcm = row_base
  assign row_base_is_odd = row_base | modulo: 2

  if mobile_row == 2 and row_base_is_odd != 0
    assign row_lcm = row_base | times: 2
  endif

  assign per_load_units = base_per_page | divided_by: row_lcm
  assign collection_products_per_page = per_load_units | times: row_lcm
  if collection_products_per_page < row_lcm
    assign collection_products_per_page = row_lcm
  endif

  assign best_page_distance = 999
  assign kavalio_care_product = settings.kavalio_care_product
  assign hide_spotlight_banner = collection.metafields.custom.hide_spotlight_banner.value
  assign spotlight_meta = collection.metafields.custom.spotlight_banner.value
  assign hide_spotlight_banner_str = hide_spotlight_banner | downcase
  assign spotlight_banner_active = false

  for block in section.blocks
    if block.type == 'spotlight_banner'
      if hide_spotlight_banner != true and hide_spotlight_banner_str != 'true'
        if spotlight_meta != blank
          if spotlight_meta.desktop_image != blank or spotlight_meta.heading != blank or spotlight_meta.subheading != blank or spotlight_meta.badge_text != blank or spotlight_meta.content != blank or spotlight_meta.button_text_and_url != blank
            assign spotlight_banner_active = true
          endif
        elsif block.settings.image != blank or block.settings.title != blank or block.settings.subheading != blank or block.settings.badge_text != blank or block.settings.content != blank or block.settings.button_text != blank
          assign spotlight_banner_active = true
        endif
      endif
    endif
  endfor

  for offset in (0..7)
    for direction_num in (0..1)
      assign try_candidate = false

      if offset == 0 and direction_num == 1
        assign try_candidate = false
      elsif direction_num == 0
        assign candidate = base_per_page | minus: offset
        assign try_candidate = true
      else
        assign candidate = base_per_page | plus: offset
        assign try_candidate = true
      endif

      if try_candidate and candidate >= 8 and candidate <= 50
        assign desktop_cells = 0
        assign mobile_cells = 0
        assign visible_product_index = 0

        for product in collection.products limit: candidate
          assign has_garantie_tag = false
          for tag in product.tags
            if tag == 'Garantie' or tag == 'garantie' or tag == 'GARANTIE'
              assign has_garantie_tag = true
              break
            endif
          endfor

          assign is_kavalio_care = false
          if kavalio_care_product != blank and product.id == kavalio_care_product.id
            assign is_kavalio_care = true
          elsif product.metafields.custom.product_type == 'Kavalio care'
            assign is_kavalio_care = true
          endif

          unless has_garantie_tag or is_kavalio_care
            assign visible_product_index = visible_product_index | plus: 1
            assign item_desktop = 1
            assign item_mobile = 1

            for block in section.blocks
              if visible_product_index == block.settings.position
                if block.type == 'spotlight_benefits'
                  assign item_desktop = row_base
                  assign item_mobile = mobile_row
                elsif block.type == 'spotlight_banner'
                  if spotlight_banner_active
                    assign item_desktop = 1
                    assign item_mobile = 1
                  endif
                elsif block.type == 'spotlight' or block.type == 'spotlight_product' or block.type == 'spotlight_reveiws'
                  if block.settings.show_desktop_only
                    assign item_desktop = 1
                    assign item_mobile = 0
                  elsif block.settings.show_mobile_only
                    assign item_desktop = 0
                    assign item_mobile = 1
                  else
                    assign item_desktop = 1
                    assign item_mobile = 1
                    if block.settings.full_width_mobile and mobile_row == 2
                      assign item_mobile = 2
                    endif
                  endif
                endif
              endif
            endfor

            assign desktop_cells = desktop_cells | plus: item_desktop
            assign mobile_cells = mobile_cells | plus: item_mobile
          endunless
        endfor

        assign desktop_remainder = desktop_cells | modulo: row_base
        assign mobile_remainder = mobile_cells | modulo: mobile_row

        if desktop_remainder == 0 and mobile_remainder == 0
          assign candidate_distance = candidate | minus: base_per_page
          if candidate_distance < 0
            assign candidate_distance = 0 | minus: candidate_distance
          endif

          if candidate_distance < best_page_distance
            assign best_page_distance = candidate_distance
            assign collection_products_per_page = candidate
          elsif candidate_distance == best_page_distance and candidate < collection_products_per_page
            assign collection_products_per_page = candidate
          endif
        endif
      endif
    endfor
  endfor
-%}

<style>
  #shopify-section-{{ section.id }} {
    --section-products-per-row: {{ section.settings.mobile_products_per_row | times: 1 }};
  }

  @media screen and (min-width: 741px) {
    #shopify-section-{{ section.id }} {
      {%- assign remainder_for_two = collection_products_per_page | modulo: 2 -%}
      {%- assign remainder_for_desktop_count = collection_products_per_page | modulo: section.settings.desktop_products_per_row -%}

      --section-products-per-row: {% if remainder_for_two == 0 and remainder_for_desktop_count == 0 %}2{% else %}3{% endif %};
    }
  }

  {%- if section.settings.filter_position == 'drawer' -%}
    @media screen and (min-width: 1200px) {
      #shopify-section-{{ section.id }} {
        --section-products-per-row: {{ section.settings.desktop_products_per_row }};
      }
    }
  {%- else -%}
    @media screen and (min-width: 1400px) {
      #shopify-section-{{ section.id }} {
        --section-products-per-row: {{ section.settings.desktop_products_per_row }};
      }
    }
  {%- endif -%}

  {%- for block in section.blocks -%}
    #block-{{ section.id }}-{{ block.id }} {
      --heading-color: {{ block.settings.text_color.red }}, {{ block.settings.text_color.green }}, {{ block.settings.text_color.blue }};
      --text-color: {{ block.settings.text_color.red }}, {{ block.settings.text_color.green }}, {{ block.settings.text_color.blue }};
      --section-block-background: {{ block.settings.background.red }}, {{ block.settings.background.green }}, {{ block.settings.background.blue }};
      --primary-button-background: {{ block.settings.button_background.red }}, {{ block.settings.button_background.green }}, {{ block.settings.button_background.blue }};
      --primary-button-text-color: {{ block.settings.button_text_color.red }}, {{ block.settings.button_text_color.green }}, {{ block.settings.button_text_color.blue }};

      {%- assign text_position = block.settings.text_position | split: '_' | first -%}

      {%- case text_position -%}
        {%- when 'top' -%}
          {%- assign section_items_alignment = 'flex-start' -%}
        {%- when 'middle' -%}
          {%- assign section_items_alignment = 'center' -%}
        {%- when 'bottom' -%}
          {%- assign section_items_alignment = 'flex-end' -%}
      {%- endcase -%}

      --section-blocks-alignment: {{ section_items_alignment }};
    }
  {%- endfor -%}

  /*
    IMPLEMENTATION NOTE: due to design requirements, the mobile toolbar (with filters and sort by) had to be moved to the
    layout file. However as section settings cannot be accessed outside the section itself, we simply hide them in CSS.
   */

  {%- if section.settings.show_filters and collection.filters != empty and collection.products_count > 0 -%}
    .mobile-toolbar__item--filters {
      display: flex !important;
    }
  {%- endif -%}

  {%- if section.settings.show_sort_by and collection.products_count > 0 -%}
    .mobile-toolbar__item--sort {
      display: flex !important;
    }
  {%- endif -%}

  {%- if section.settings.show_sort_by or section.settings.show_filters and collection.filters != empty -%}
    @media screen and (max-width: 999px) {
      :root {
        --anchor-offset: 60px;
      }
    }
  {%- endif -%}
</style>

{% assign active_promotion = false %}
{%- for block in section.blocks -%}
  {%- case block.type -%}
    {%- when 'image' -%}
      {% assign active_promotion = true %}
  {%- endcase -%}
{%- endfor -%}

<section>
  <div class="container">
    <product-facet section-id="{{ section.id }}" class="product-facet">
      {%- if section.settings.show_filters and collection.filters != empty -%}
        {%- if section.settings.filter_position == 'always_visible' -%}
          <div class="product-facet__aside">
            <safe-sticky offset="30" class="product-facet__aside-inner">
              <div class="product-facet__filters-header hidden-pocket">
                <p class="heading {% if settings.heading_text_transform == 'uppercase' %}h6{% else %}h5{% endif %}">
                  {{ 'collection.general.filters' | t }}
                </p>
              </div>

              {%- render 'facet-filters',
                filters: collection.filters,
                filters_position: section.settings.filter_position
              -%}
            </safe-sticky>
          </div>
        {%- else -%}
          {%- render 'facet-filters',
            filters: collection.filters,
            filters_position: section.settings.filter_position
          -%}
        {%- endif -%}
      {%- endif -%}

      <div id="facet-main" class="product-facet__main anchor" role="region" aria-live="polite">
        {%- if section.blocks.size > 0 -%}
          {%- capture promotion_blocks -%}
            <div class="promotion-block-list promotion-block-list--{{ section.settings.promotion_position }}">
              {%- for block in section.blocks -%}
                {%- if block.type == 'image' -%}
                  {%- capture block_content -%}
                    {%- if block.settings.image != blank -%}
                      {%- capture sizes_attribute -%}(max-width: 740px) calc(100vw - 12px * 2), calc(min(100vw, 1560px) / {{ section.blocks.size }} - 20px * {{ section.blocks.size | minus: 1 }}){%- endcapture -%}
                      {{- block.settings.image | image_url: width: block.settings.image.width | image_tag: loading: 'lazy', sizes: sizes_attribute, widths: '200,300,400,500,600,700,800,900,1000,1100,1200,1300,1400,1500,1600', class: 'promotion-block__image' -}}
                    {%- endif -%}
  
                    <div class="promotion-block__content-wrapper text-container" style="{% if block.settings.text_position contains 'center' %}text-align: center{% elsif block.settings.text_position contains 'right' %}text-align: end{% endif %}">
                      {%- if block.settings.subheading != blank -%}
                        <p class="heading heading--small">{{ block.settings.subheading | escape }}</p>
                      {%- endif -%}
  
                      {%- if block.settings.title != blank -%}
                        <p class="heading h4">{{ block.settings.title | escape | newline_to_br }}</p>
                      {%- endif -%}
  
                      {%- if block.settings.link_text != blank -%}
                        {%- if block.settings.link_style == 'link' -%}
                          <span class="heading heading--small link">{{ block.settings.link_text | escape }}</span>
                        {%- else -%}
                          <div class="button-wrapper">
                            <span class="button button--small button--primary">{{ block.settings.link_text | escape }}</span>
                          </div>
                        {%- endif -%}
                      {%- endif -%}
                    </div>
                  {%- endcapture -%}
  
                  {%- if block.settings.link_url != blank -%}
                    <a id="block-{{ section.id }}-{{ block.id }}" href="{{ block.settings.link_url }}" class="promotion-block promotion-block--{{ section.settings.promotion_height }} promotion-block--expand image-zoom" {{ block.shopify_attributes }}>
                      {{- block_content -}}
                    </a>
                  {%- else -%}
                    <div id="block-{{ section.id }}-{{ block.id }}" class="promotion-block promotion-block--{{ section.settings.promotion_height }} promotion-block--expand image-zoom" {{ block.shopify_attributes }}>
                      {{- block_content -}}
                    </div>
                  {%- endif -%}
                {%- endif -%}
              {%- endfor -%}
            </div>
          {%- endcapture -%}
        {%- endif -%}

        {%- if section.settings.promotion_position == 'top' and active_promotion -%}
          {{- promotion_blocks -}}
        {%- endif -%}

        {%- if collection.products_count > 0 -%}
          {% if section.settings.filter_heading != blank %}
            <h3 class="heading h3 collection_title">{{  section.settings.filter_heading }}</h3>
          {% endif %}
          <div class="product-facet__meta-bar anchor">

            {% if section.settings.filter_tags_menu != blank %}
              {% render 'ed-collection-tag-filter', section: section %}
            {% else %}
              <div class="collection_breadcrumb" data-cp-breadcrumb data-collection-url="{{ collection.url }}" data-collection-title="{{ collection.title | escape }}">
                <span class="collection_breadcrumb__segments"></span>
                <span class="collection_breadcrumb__chevron">{% render 'icon' with 'chevron-right' %}</span>
                <p class="collection_breadcrumb__current"></p>
              </div>
            {% endif %}

            <div class="product-facet__meta-bar-divider-mobile hidden-lap-and-up">
              {% render 'ed-heart-divider', margin: '8px' %}
            </div>

            <div class="product-facet__meta-bar-inner">
              {% comment %}
                <span class="product-facet__meta-bar-item product-facet__meta-bar-item--count" role="status">
                  {{- 'collection.general.products_count' | t: count: collection.products_count -}}
                </span>
              {% endcomment %}

              {%- if section.settings.filter_position == 'drawer'
                and section.settings.show_filters
                and collection.filters != empty
              -%}
                <button
                  type="submit"
                  is="toggle-button"
                  class="product-facet__meta-bar-item product-facet__meta-bar-item--filter"
                  aria-controls="facet-filters"
                  aria-expanded="false"
                >
                  {%- render 'icon' with 'filters' -%}
                  {{- 'collection.general.show_filters' | t -}}
                  {% if active_filters_count > 0 -%}
                    <span class="product-facet__active-count bubble-count">{{ active_filters_count }}</span>
                  {%- endif %}
                </button>
              {%- endif -%}

              {%- if section.settings.show_sort_by -%}
                <div class="product-facet__meta-bar-item product-facet__meta-bar-item--sort">
                  {% comment %} <span class="product-facet__sort-by-title text--subdued hidden-pocket">
                    {{- 'collection.general.sort_by' | t -}}
                  </span> {% endcomment %}

                  <div class="popover-container">
                    {%- for option in collection.sort_options -%}
                      {%- if option.value == collection_sort_by -%}
                        {%- assign collection_sort_by_name = option.name -%}
                        {%- break -%}
                      {%- endif -%}
                    {%- endfor -%}

                    <button
                      type="button"
                      is="toggle-button"
                      class="popover-button"
                      aria-expanded="false"
                      aria-controls="sort-by-popover"
                    >
                      {% render 'icon' with 'sortby' %}
                      <span id="sort-by-selected-value" style="pointer-events: none">
                        {{- collection_sort_by_name -}}
                      </span>
                      {% comment %} {%- render 'icon' with 'chevron', inline: true -%} {% endcomment %}
                    </button>

                    <sort-by-popover id="sort-by-popover" class="popover">
                      <span class="popover__overlay"></span>

                      <header class="popover__header">
                        <span class="popover__title heading h6">{{- 'collection.general.sort_by' | t -}}</span>

                        <button
                          type="button"
                          class="popover__close-button tap-area tap-area--large"
                          data-action="close"
                          title="{{ 'general.accessibility.close' | t | escape }}"
                        >
                          {%- render 'icon' with 'close' -%}
                        </button>
                      </header>

                      <div class="popover__content">
                        <div class="popover__choice-list">
                          {%- for sort_option in collection.sort_options -%}
                            <label class="popover__choice-item">
                              <input
                                type="radio"
                                data-bind-value="sort-by-selected-value"
                                class="visually-hidden"
                                {% if sort_option.value == collection_sort_by %}
                                  checked="checked"
                                {% endif %}
                                name="sort_by"
                                value="{{ sort_option.value }}"
                                title="{{ sort_option.name }}"
                              >
                              <span class="popover__choice-label">{{ sort_option.name }}</span>
                            </label>
                          {%- endfor -%}
                        </div>
                      </div>
                    </sort-by-popover>
                  </div>
                </div>
              {%- endif -%}
            </div>
          </div>

          <div class="product-facet__meta-bar-divider-desktop hidden-pocket">
            {% render 'ed-heart-divider', margin: '0px' %}
          </div>

          {%- if active_filters_count > 0 -%}
            <div class="product-facet__active-list tag-list hidden-tablet-and-up">
              {%- render 'facet-active-filters', filters: collection.filters -%}
            </div>
          {%- endif -%}

          {%- paginate collection.products by collection_products_per_page -%}
            <product-list
              {% if settings.stagger_products_apparition %}
                stagger-apparition
              {% endif %}
              class="product-facet__product-list product-list anchor"
            >
              {%- if section.settings.filter_position == 'always_visible'
                and section.settings.show_filters
                and collection.filters != empty
              -%}
                {%- assign sidebar_width = 305 -%}
              {% else %}
                {%- assign sidebar_width = 0 -%}
              {%- endif -%}

              <div class="product-list__inner">
                {%- assign desktop_number_of_products_minus_one = section.settings.desktop_products_per_row
                  | minus: 1
                -%}
                {%- assign gap_width = 24.0
                  | divided_by: section.settings.desktop_products_per_row
                  | times: desktop_number_of_products_minus_one
                -%}
                {%- capture mobile_product_card_size -%}{%- if section.settings.mobile_products_per_row == '2' -%}calc((100vw - 48px) / 2){%- else -%}calc(100vw - 48px){%- endif -%}{%- endcapture -%}
                {%- capture sizes_attribute -%}(max-width: 740px) {{ mobile_product_card_size }}, calc((min(100vw - 80px, 1520px) - {{ sidebar_width }}px) / {{ section.settings.desktop_products_per_row }} - {{ gap_width | ceil }}px){%- endcapture -%}

                
                {%- assign visible_product_index = 0 -%}
                {%- assign kavalio_care_product = settings.kavalio_care_product -%}
                {%- for product in collection.products -%}
                  {%- assign has_garantie_tag = false -%}
                  {%- for tag in product.tags -%}
                    {%- if tag == 'Garantie' or tag == 'garantie' or tag == 'GARANTIE' -%}
                      {%- assign has_garantie_tag = true -%}
                      {%- break -%}
                    {%- endif -%}
                  {%- endfor -%}
                  {%- assign is_kavalio_care = false -%}
                  {%- if kavalio_care_product != blank and product.id == kavalio_care_product.id -%}
                    {%- assign is_kavalio_care = true -%}
                  {%- elsif product.metafields.custom.product_type == 'Kavalio care' -%}
                    {%- assign is_kavalio_care = true -%}
                  {%- endif -%}
                  {%- unless has_garantie_tag or is_kavalio_care -%}
                    {%- assign visible_product_index = visible_product_index | plus: 1 -%}
                    {% assign product_forloop = visible_product_index %}
                    {%- assign rendered_by_block = false -%}
                    {%- for block in section.blocks -%}
                      {% case block.type %}
                        {% when 'spotlight' %}
                          {% if product_forloop == block.settings.position %}
                            {% if block.settings.repeat_position %}
                              {%- render 'ed-collection-spotlight',
                                product: product,
                                collection: collection,
                                block: block,
                                reveal: settings.stagger_products_apparition
                              -%}
                              {%- assign rendered_by_block = true -%}
                            {% elsif block.settings.repeat_position != true and paginate.current_page == 1 %}
                              {%- render 'ed-collection-spotlight',
                                product: product,
                                collection: collection,
                                block: block,
                                reveal: settings.stagger_products_apparition
                              -%}
                              {%- assign rendered_by_block = true -%}
                            {% else %}
                              {%- render 'product-item',
                                product: product,
                                collection: collection,
                                block: block,
                                sizes_attribute: sizes_attribute,
                                reveal: settings.stagger_products_apparition,
                                forloop_index: visible_product_index
                              -%}
                              {%- assign rendered_by_block = true -%}
                            {% endif %}
                          {% endif %}
                        {% when 'spotlight_product' %}
                          {% if product_forloop == block.settings.position %}
                            {% if block.settings.repeat_position %}
                              {%- render 'ed-spotlight-product',
                                product: block.settings.product,
                                collection: collection,
                                block: block,
                                sizes_attribute: sizes_attribute,
                                reveal: settings.stagger_products_apparition
                              -%}
                              {%- assign rendered_by_block = true -%}
                            {% elsif block.settings.repeat_position != true and paginate.current_page == 1 %}
                              {%- render 'ed-spotlight-product',
                                product: block.settings.product,
                                collection: collection,
                                block: block,
                                sizes_attribute: sizes_attribute,
                                reveal: settings.stagger_products_apparition
                              -%}
                              {%- assign rendered_by_block = true -%}
                            {% else %}
                              {%- render 'product-item',
                                product: product,
                                collection: collection,
                                block: block,
                                sizes_attribute: sizes_attribute,
                                reveal: settings.stagger_products_apparition,
                                forloop_index: visible_product_index
                              -%}
                              {%- assign rendered_by_block = true -%}
                            {% endif %}
                          {% endif %}
                        {% when 'spotlight_reveiws' %}
                          {% if product_forloop == block.settings.position %}
                            {% if block.settings.repeat_position %}
                              {%- render 'ed-spotlight-reviews',
                                product: product,
                                collection: collection,
                                block: block,
                                reveal: settings.stagger_products_apparition
                              -%}
                              {%- assign rendered_by_block = true -%}
                            {% elsif block.settings.repeat_position != true and paginate.current_page == 1 %}
                              {%- render 'ed-spotlight-reviews',
                                product: product,
                                collection: collection,
                                block: block,
                                reveal: settings.stagger_products_apparition
                              -%}
                              {%- assign rendered_by_block = true -%}
                            {% else %}
                              {%- render 'product-item',
                                product: product,
                                collection: collection,
                                block: block,
                                sizes_attribute: sizes_attribute,
                                reveal: settings.stagger_products_apparition,
                                forloop_index: visible_product_index
                              -%}
                              {%- assign rendered_by_block = true -%}
                            {% endif %}
                          {% endif %}
                        {% when 'spotlight_banner' %}
                          {%- assign hide_spotlight_banner = collection.metafields.custom.hide_spotlight_banner.value -%}
                          {%- assign spotlight_meta = collection.metafields.custom.spotlight_banner.value -%}
                          {%- assign render_spotlight_banner = false -%}

                          {%- assign hide_spotlight_banner_str = hide_spotlight_banner | downcase -%}
                          {%- if hide_spotlight_banner != true and hide_spotlight_banner_str != 'true' -%}
                            {%- if spotlight_meta != blank -%}
                              {%- if spotlight_meta.desktop_image != blank or spotlight_meta.heading != blank or spotlight_meta.subheading != blank or spotlight_meta.badge_text != blank or spotlight_meta.content != blank or spotlight_meta.button_text_and_url != blank -%}
                                {%- assign render_spotlight_banner = true -%}
                              {%- endif -%}
                            {%- else -%}
                              {%- if block.settings.image != blank or block.settings.title != blank or block.settings.subheading != blank or block.settings.badge_text != blank or block.settings.content != blank or block.settings.button_text != blank -%}
                                {%- assign render_spotlight_banner = true -%}
                              {%- endif -%}
                            {%- endif -%}
                          {%- endif -%}

                          {%- if render_spotlight_banner -%}
                            {% if product_forloop == block.settings.position %}
                              {% if block.settings.repeat_position %}
                                {%- render 'ed-spotlight-banner',
                                  product: product,
                                  collection: collection,
                                  block: block,
                                  reveal: settings.stagger_products_apparition
                                -%}
                                {%- assign rendered_by_block = true -%}
                              {% elsif block.settings.repeat_position != true and paginate.current_page == 1 %}
                                {%- render 'ed-spotlight-banner',
                                  product: product,
                                  collection: collection,
                                  block: block,
                                  reveal: settings.stagger_products_apparition
                                -%}
                                {%- assign rendered_by_block = true -%}
                              {% else %}
                                {%- render 'product-item',
                                  product: product,
                                  collection: collection,
                                  block: block,
                                  sizes_attribute: sizes_attribute,
                                  reveal: settings.stagger_products_apparition,
                                  forloop_index: visible_product_index
                                -%}
                                {%- assign rendered_by_block = true -%}
                              {% endif %}
                            {% endif %}
                          {%- endif -%}
                        {% when 'spotlight_benefits' %}
                          {% if product_forloop == block.settings.position %}
                            {% if block.settings.repeat_position %}
                              {%- render 'ed-spotlight-benefits',
                                product: product,
                                collection: collection,
                                block: block,
                                reveal: settings.stagger_products_apparition
                              -%}
                              {%- assign rendered_by_block = true -%}
                            {% elsif block.settings.repeat_position != true and paginate.current_page == 1 %}
                              {%- render 'ed-spotlight-benefits',
                                product: product,
                                collection: collection,
                                block: block,
                                reveal: settings.stagger_products_apparition
                              -%}
                              {%- assign rendered_by_block = true -%}
                            {% else %}
                              {%- render 'product-item',
                                product: product,
                                collection: collection,
                                block: block,
                                sizes_attribute: sizes_attribute,
                                reveal: settings.stagger_products_apparition,
                                forloop_index: visible_product_index
                              -%}
                              {%- assign rendered_by_block = true -%}
                            {% endif %}
                          {% endif %}
                      {% endcase %}
                    {%- endfor -%}

                    {%- unless rendered_by_block -%}
                      {%- render 'product-item',
                        product: product,
                        collection: collection,
                        sizes_attribute: sizes_attribute,
                        reveal: settings.stagger_products_apparition,
                        forloop_index: visible_product_index
                      -%}
                    {%- endunless -%}
                  {%- endunless -%}
                {%- endfor -%}
              </div>
            </product-list>

            {%- if section.settings.show_load_more -%}
              {% if paginate.next %}
                <div class="load-more-wrapper" {% if section.settings.enable_auto_load %}style="display: none;"{% endif %}>
                  <button
                    class="button button--primary load-more-btn"
                    data-next-url="{{ paginate.next.url }}"
                  >
                    {{ section.settings.load_more_button_text }}
                  </button>
                </div>
              {% endif %}
            {%- else -%}
              {%- render 'pagination', paginate: paginate, use_ajax: true -%}
            {%- endif -%}
          {%- endpaginate -%}

          {%- if section.settings.promotion_position == 'bottom' and active_promotion -%}
            {{- promotion_blocks -}}
          {%- endif -%}
        {%- else -%}
          <div class="empty-state">
            {%- if collection.all_products_count == 0 -%}
              <h3 class="heading h4">{{ 'collection.general.empty_title' | t }}</h3>
              <p>{{ 'collection.general.empty_label' | t }}</p>

              <div class="button-wrapper">
                <a href="{{ routes.all_products_collection_url }}" class="button button--primary">
                  {{- 'collection.general.empty_button' | t -}}
                </a>
              </div>
            {%- else -%}
              <h3 class="heading h4">{{ 'collection.general.no_results_title' | t }}</h3>
              <p>{{ 'collection.general.no_results_label' | t }}</p>

              <div class="button-wrapper">
                <a
                  href="{{ collection.url }}?sort_by={{ collection_sort_by }}"
                  data-action="clear-filters"
                  class="button button--primary"
                >
                  {{- 'collection.general.no_results_button' | t -}}
                </a>
              </div>
            {%- endif -%}
          </div>
        {%- endif -%}
      </div>
    </product-facet>
  </div>
</section>

{% if section.settings.show_load_more %}
  {%- assign row_base = section.settings.desktop_products_per_row -%}
  {%- assign mobile_row = section.settings.mobile_products_per_row | times: 1 -%}
  {%- assign row_lcm = row_base -%}
  {%- if mobile_row == 2 -%}
    {%- assign row_base_is_odd = row_base | modulo: 2 -%}
    {%- if row_base_is_odd != 0 -%}
      {%- assign row_lcm = row_base | times: 2 -%}
    {%- endif -%}
  {%- endif -%}
  {%- assign per_load_units = section.settings.products_per_page | divided_by: row_lcm -%}
  {%- assign products_per_load = per_load_units | times: row_lcm -%}
  {%- if products_per_load < row_lcm -%}
    {%- assign products_per_load = row_lcm -%}
  {%- endif -%}
  <script>
    (function() {
      if (window.__kavalioCollectionLoadMoreBound) return;
      window.__kavalioCollectionLoadMoreBound = true;

      const PRODUCTS_PER_LOAD = {{ products_per_load | json }};
      const LOAD_MORE_TEXT = {{ section.settings.load_more_button_text | json }};
      const enableAutoLoad = {{ section.settings.enable_auto_load | json }};

      let isLoading = false;
      let scrollHandler = null;
      let scrollTimeout = null;
      let activeController = null;

      // Products fetched from Shopify pages but not yet shown. Buffering the
      // overflow keeps the product sequence continuous, so revealing a fixed
      // count per click never skips a product.
      const productQueue = [];
      const fetchedUrls = new Set();
      let nextPageUrl = null;
      let nextUrlReady = false;
      let noMorePages = false;

      function getButton() { return document.querySelector('.load-more-btn'); }
      function getContainer() { return document.querySelector('.product-list__inner'); }

      function ensureNextUrl() {
        if (nextUrlReady) return;
        const btn = getButton();
        nextPageUrl = btn ? btn.getAttribute('data-next-url') : null;
        if (!nextPageUrl) noMorePages = true;
        nextUrlReady = true;
      }

      function setButtonText(text) {
        const btn = getButton();
        if (btn) btn.textContent = text;
      }

      function removeButton() {
        const btn = getButton();
        if (btn) btn.remove();
        if (enableAutoLoad && scrollHandler) {
          window.removeEventListener('scroll', scrollHandler, { passive: true });
          scrollHandler = null;
        }
      }

      // Fetch the next Shopify page and push its products into the queue.
      function fetchNextPage() {
        if (noMorePages || !nextPageUrl || fetchedUrls.has(nextPageUrl)) {
          return Promise.resolve(false);
        }

        const url = nextPageUrl;
        fetchedUrls.add(url);

        try { activeController?.abort(); } catch (e) {}
        activeController = new AbortController();

        return fetch(url, { signal: activeController.signal })
          .then((res) => res.text())
          .then((html) => {
            const doc = new DOMParser().parseFromString(html, 'text/html');

            doc.querySelectorAll('product-item').forEach((item) => {
              item.style.opacity = '1';
              productQueue.push(item);
            });

            const nextBtn = doc.querySelector('.load-more-btn');
            nextPageUrl = nextBtn ? nextBtn.getAttribute('data-next-url') : null;
            if (!nextPageUrl) noMorePages = true;

            return true;
          });
      }

      function appendItems(items) {
        const container = getContainer();
        if (!container || !items.length) return;
        items.forEach((item) => container.appendChild(item));
        if (window.KavalioCollectionPriceSort) window.KavalioCollectionPriceSort();
      }

      // Keep fetching pages until enough products are queued for a full batch.
      function fillQueue() {
        if (productQueue.length >= PRODUCTS_PER_LOAD || noMorePages) {
          return Promise.resolve();
        }
        return fetchNextPage().then((fetched) => {
          if (!fetched) return;
          return fillQueue();
        });
      }

      function loadMore() {
        if (isLoading) return;

        ensureNextUrl();

        if (noMorePages && productQueue.length === 0) {
          removeButton();
          return;
        }

        isLoading = true;
        setButtonText('Wird geladen...');

        fillQueue()
          .then(() => {
            let batch;
            if (noMorePages && productQueue.length <= PRODUCTS_PER_LOAD) {
              // Final batch: reveal the remainder (the last row may be partial).
              batch = productQueue.splice(0, productQueue.length);
            } else {
              batch = productQueue.splice(0, PRODUCTS_PER_LOAD);
            }

            appendItems(batch);

            if (noMorePages && productQueue.length === 0) {
              removeButton();
            } else {
              setButtonText(LOAD_MORE_TEXT);
            }

            isLoading = false;
          })
          .catch((err) => {
            isLoading = false;
            if (err && err.name === 'AbortError') return;
            setButtonText('Fehler beim Laden');
          });
      }

      document.addEventListener('click', function (e) {
        const btn = e.target.closest('.load-more-btn');
        if (!btn) return;

        e.preventDefault();
        loadMore();
      });

      {% if section.settings.enable_auto_load %}
      function handleScroll() {
        if (isLoading) return;
        if (!getButton()) return;

        const list = document.querySelector('.product-facet__product-list');
        if (!list) return;

        const listRect = list.getBoundingClientRect();
        const viewportHeight = window.innerHeight || document.documentElement.clientHeight;
        const distanceFromViewportBottom = listRect.bottom - viewportHeight;

        if (distanceFromViewportBottom < 1000) {
          loadMore();
        }
      }
      scrollHandler = function() {
        clearTimeout(scrollTimeout);
        scrollTimeout = setTimeout(handleScroll, 50);
      };

      window.addEventListener('scroll', scrollHandler, { passive: true });
      {% endif %}
    })();
  </script>
{% endif %}

