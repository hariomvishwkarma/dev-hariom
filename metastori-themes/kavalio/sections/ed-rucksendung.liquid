<style>
  #shopify-section-{{ section.id }} {
    {%- if section.settings.background == 'rgba(0,0,0,0)' -%}
      {%- assign section_background = settings.background -%}
    {%- else -%}
      {%- assign section_background = section.settings.background -%}
    {%- endif -%}

    {%- if section.settings.text_color == 'rgba(0,0,0,0)' -%}
      {%- assign heading_color = settings.heading_color -%}
      {%- assign text_color = settings.text_color -%}
    {%- else -%}
      {%- assign heading_color = section.settings.text_color -%}
      {%- assign text_color = section.settings.text_color -%}
    {%- endif -%}

    {%- if section.settings.button_background == 'rgba(0,0,0,0)' -%}
      {%- assign button_background = settings.primary_button_background -%}
    {%- else -%}
      {%- assign button_background = section.settings.button_background -%}
    {%- endif -%}

    {%- if section.settings.button_text_color == 'rgba(0,0,0,0)' -%}
      {%- assign button_text_color = settings.primary_button_text_color -%}
    {%- else -%}
      {%- assign button_text_color = section.settings.button_text_color -%}
    {%- endif -%}

    --heading-color: {{ heading_color.red }}, {{ heading_color.green }}, {{ heading_color.blue }};
    --text-color: {{ text_color.red }}, {{ text_color.green }}, {{ text_color.blue }};
    --primary-button-background: {{ button_background.red }}, {{ button_background.green }}, {{ button_background.blue }};
    --primary-button-text-color: {{ button_text_color.red }}, {{ button_text_color.green }}, {{ button_text_color.blue }};

    --section-background: {{ section_background.red }}, {{ section_background.green }}, {{ section_background.blue }};
  }

    #shopify-section-{{ section.id }}{
        background-color: {{ section.settings.background }};
    }

    .ed_deine_heading_image {
        display: flex;
        align-items: center;
    }
    .content-box--center .ed_deine_heading_image {
        justify-content: center;
    }
    .content-box--left .ed_deine_heading_image {
        justify-content: flex-start;
    }
    .content-box--right .ed_deine_heading_image {
        justify-content: flex-end;
    }
    .container .ed_deine_heading_wrapper  h3.heading {
        margin-block-start: 32px;
        margin-block-end: 16px;
    }
    .ed_deine_buttons_wrapper {
        display: flex;
        align-items: center;
        justify-content: center;
        margin-top: 64px;
        gap: 10px;
        flex-direction: column;
    }
    .ed_deine_buttons_wrapper .button {
        border-radius: 500px;
        text-transform: uppercase !important;
        letter-spacing: 0;
        margin: 0;
    }

    .ed_deine_buttons_wrapper .button.button--outline {
        border-color: rgba(var(--border-color), 0.1);
    }
    .ed_deine_columns_wrapper {
        display: grid;
        gap: 8px;
    }

    .ed_deine_columns__item {
        border-radius: 16px;
    }

    .ed_deine_columns__item_header {
        padding: 23px 32px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        border-bottom: 1px solid #E5E5E5;
    }

    .ed_deine_columns__item_content {
        padding: 32px;
    }

    .ed_deine_columns__item_content h3.heading {
        margin-bottom: 16px;
    }
    .ed_deine_columns__item_header_label {
        display: flex;
        background: #59C5B4;
        color: #fff;
        padding: 7px 12px 6px;
        border-radius: 50px;
        line-height: 1;
        font-size: calc(var(--base-font-size) - 2px);
        font-weight: 600;
    }

    .ed_deine_footer_wrapper {
        margin-top: 64px;
    }

    .ed_deine_footer_content_wrap {
        max-width: 920px;
        margin-inline: auto; display: block;
    }

    .ed_deine_footer_content_notice {
        padding: 16px;
        background: #FFFFFF;
        border-radius: 16px;
        margin-block: 8px; }

    .ed_deine_notice_title {
        position: relative;
        padding-left: 24px;
    }

    .ed_deine_notice_title:before {
        content: '';
        position: absolute;
        width: 18px;
        height: 24px;
        left: 0;
        top: 0;
        background: url({{ 'checkmark.svg' | asset_url }});
        background-repeat: no-repeat;
        background-size: contain;
        background-position: center center;
    }

    .ed_deine_notice_details {
        padding-left: 24px;
    }

    .ed_deine_footer_content {
        margin-top: 32px;
        margin-bottom: 32px;
    }

    button.ed_deine_footer_form_checkbox {
        display: flex;
        align-items: center;
        justify-content: flex-start;
        width: 100%;
        border: 1px solid #59C5B4;
        border-radius: 16px;
        padding: 16px;
        font-weight: 600;
        height: unset;
        line-height: 1;
        gap: 8px;
    }

    button.ed_deine_footer_form_checkbox:hover {
        outline: 0.5px solid #59C5B4;
    }
    .ed_deine_footer_form_checkbox_icon {
        width: 24px;
        min-width: 24px;
        height: 24px;
        border-radius: 4px;
        padding-inline: 4px;
        display: flex;
        align-items: center;
        justify-content: center;
        border: 1px solid rgba(0,0,0,0.65);
        background: #fff;
    }

    button.ed_deine_footer_form_checkbox.active .ed_deine_footer_form_checkbox_icon {
        background: #59C5B4;
        color: #fff;
        border-color: #59C5B4;
    }
    .button.is-disabled {
        cursor: not-allowed;
        opacity: 0.5;
    }


    button.ed_deine_footer_form_checkbox .ed_deine_footer_form_checkbox_icon svg {
      display: none;
    }
    button.ed_deine_footer_form_checkbox.active .ed_deine_footer_form_checkbox_icon svg {
      display: flex;
    }


  @media (min-width: 1000px) {
    #shopify-section-{{ section.id }} {
        padding-top: {{ section.settings.space_top -}}px;
        padding-bottom: {{ section.settings.space_bottom -}}px;
    }

    #shopify-section-{{ section.id }} .ed_deine_heading_image img {
        width: 100%;
        display: block;
        max-width: var(--heading-image-size);
        margin: 0 auto;
    }
    #shopify-section-{{ section.id }} .ed_deine_columns__item_header_icon img {
        width: 100%;
        display: block;
        max-width: var(--column-icon-size);
        margin: 0 auto;
    }
    .ed_deine_columns_wrapper.ed_deine_column_items__1 {
        grid-template-columns: repeat(1, 1fr);
    }
    .ed_deine_columns_wrapper.ed_deine_column_items__2 {
        grid-template-columns: repeat(2, 1fr);
    }
    .ed_deine_columns_wrapper.ed_deine_column_items__3 {
        grid-template-columns: repeat(3, 1fr);
    }
    .ed_deine_heading_wrapper {
        margin-bottom: 64px;
    }
    .ed_deine_heading_wrapper .ed_deine_buttons_wrapper {
        flex-direction: row;
    }
  }

  @media (max-width: 999px) {
    #shopify-section-{{ section.id }} {
        padding-top: {{ section.settings.space_top_mobile -}}px;
        padding-bottom: {{ section.settings.space_bottom_mobile -}}px;
    }
    #shopify-section-{{ section.id }} .ed_deine_heading_image img {
        width: 100%;
        display: block;
        max-width: var(--heading-image-size-mobile);
        margin: 0 auto;
    }
    #shopify-section-{{ section.id }} .ed_deine_columns__item_header_icon img {
        width: 100%;
        display: block;
        max-width: var(--column-icon-size-mobile);
        margin: 0 auto;
    }
    .ed_deine_heading_wrapper {
        margin-bottom: 48px;
    }
    .ed_deine_buttons_wrapper {
        align-items: flex-start;
    }
    button.ed_deine_footer_form_checkbox {
        align-items: flex-start;
        line-height: 1.5;
        padding: 12px;
    }

    .ed_deine_footer_content_notice {
        padding: 12px;
    }

    .ed_deine_notice_title {
        margin-bottom: 10px;
    }
    .ed_deine_buttons_wrapper .button {
        font-size: calc(var(--font-size-base) -2px) !important;
    }
  }
</style>

<section class="ed_rucksendung_section">
  <div class="container">
    {% for block in section.blocks %}
      {% if block.type == 'header' %}
        <div class="ed_deine_heading_wrapper" id="block-{{ section.id }}-{{ block.id }}">
          {%- assign text_position = block.settings.text_position -%}
          {%- assign text_alignment = block.settings.text_alignment -%}

          <div class="content-box content-box--{{ block.settings.text_width }} content-box--text-{{ text_alignment }} content-box--{{ text_position }} text-container">
            {%- if block.settings.image != blank -%}
              <div
                class="ed_deine_heading_image"
                style="--heading-image-size: {{ block.settings.image_size }}px; --heading-image-size-mobile: {{ block.settings.image_size_mobile }}px;"
              >
                {{-
                  block.settings.image
                  | image_url: width: block.settings.image.width
                  | image_tag: sizes: '100vw', widths: '200, 300, 400, 500', alt: block.settings.image.alt
                -}}
              </div>
            {%- endif -%}

            {%- if block.settings.subheading != blank -%}
              <h2 class="heading heading--small">{{ block.settings.subheading | escape }}</h2>
            {%- endif -%}

            {%- if block.settings.title != blank -%}
              <h3 class="heading {{ block.settings.heading_class }} {% if block.settings.heading_uppercase %}heading--uppercase{% endif %}">
                {{ block.settings.title | escape }}
              </h3>
            {%- endif -%}

            {%- if block.settings.content != blank -%}
              <div class="ed_deine_heading_content">
                {{- block.settings.content -}}
              </div>
            {%- endif -%}
          </div>
        </div>
      {% endif %}
    {% endfor %}

    {% assign columns_count = 0 %}
    {% for block in section.blocks %}
      {% if block.type == 'column' %}
        {% assign columns_count = columns_count | plus: 1 %}
      {% endif %}
    {% endfor %}

    <div class="ed_deine_columns_wrapper ed_deine_column_items__{{ columns_count }}">
      {% for block in section.blocks %}
        {% if block.type == 'column' %}
          <div
            class="ed_deine_columns__item"
            style="background: {{ block.settings.background }}; {% if block.settings.text_color != 'rgba(0,0,0,0)' %}color: {{ block.settings.text_color }};{% endif %}"
          >
            <div class="ed_deine_columns__item_header">
              <div class="ed_deine_columns__item_header_label">
                <p>{{ block.settings.label }}</p>
              </div>

              {%- if block.settings.image != blank -%}
                <div
                  class="ed_deine_columns__item_header_icon"
                  style="--column-icon-size: {{ block.settings.image_size }}px; --column-icon-size-mobile: {{ block.settings.image_size_mobile }}px;"
                >
                  {{-
                    block.settings.image
                    | image_url: width: block.settings.image.width
                    | image_tag: sizes: '100vw', widths: '40, 80, 100', alt: block.settings.image.alt
                  -}}
                </div>
              {%- endif -%}
            </div>

            <div class="ed_deine_columns__item_content">
              {%- if block.settings.title != blank -%}
                <h3 class="heading {{ block.settings.heading_class }} {% if block.settings.heading_uppercase %}heading--uppercase{% endif %}">
                  {{ block.settings.title | escape }}
                </h3>
              {%- endif -%}

              {%- if block.settings.content != blank -%}
                <div class="ed_deine_columns__item_content_text">
                  {{- block.settings.content -}}
                </div>
              {%- endif -%}
            </div>
          </div>
        {% endif %}
      {% endfor %}
    </div>

    {% for block in section.blocks %}
      {% if block.type == 'footer' %}
        <div class="ed_deine_footer_wrapper" id="block-{{ section.id }}-{{ block.id }}">
          <div class="ed_deine_footer_content_wrap">
            {% if block.settings.title != blank %}
              <p class="{{ block.settings.heading_class }}">
                {{ block.settings.title }}
              </p>
            {% endif %}

            {% if block.settings.notice_1_title != blank or block.settings.notice_1_content != blank %}
              <div class="ed_deine_footer_content_notice">
                {% if block.settings.notice_1_title != blank %}
                  <p class="ed_deine_notice_title">
                    {{ block.settings.notice_1_title }}
                  </p>
                {% endif %}

                {% if block.settings.notice_1_content != blank %}
                  <div class="ed_deine_notice_details">
                    {{ block.settings.notice_1_content }}
                  </div>
                {% endif %}
              </div>
            {% endif %}

            {% if block.settings.notice_2_title != blank or block.settings.notice_2_content != blank %}
              <div class="ed_deine_footer_content_notice">
                {% if block.settings.notice_2_title != blank %}
                  <p class="ed_deine_notice_title">
                    {{ block.settings.notice_2_title }}
                  </p>
                {% endif %}

                {% if block.settings.notice_2_content != blank %}
                  <div class="ed_deine_notice_details">
                    {{ block.settings.notice_2_content }}
                  </div>
                {% endif %}
              </div>
            {% endif %}

            {% if block.settings.content_text != blank %}
              <div class="ed_deine_footer_content">
                {{ block.settings.content_text }}
              </div>
            {% endif %}

            <div class="ed_deine_footer_form">
              {% if block.settings.active_button_checkbox_text != blank %}
                <button type="button" class="ed_deine_footer_form_checkbox" aria-pressed="false">
                  <span class="ed_deine_footer_form_checkbox_icon">
                    <svg fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor">
                      <path stroke-linecap="round" stroke-linejoin="round" d="m4.5 12.75 6 6 9-13.5" />
                    </svg>
                  </span>
                  {{ block.settings.active_button_checkbox_text }}
                </button>
              {% endif %}

              {%- if block.settings.button_text != blank or block.settings.button_text_2 != blank -%}
                <div class="ed_deine_buttons_wrapper">
                  {% if block.settings.button_text != blank %}
                    <a
                      href="{{ block.settings.button_url }}"
                      class="button button--{{ block.settings.button_style }} ed_deine_footer_form_primary_cta"

                      style="
                        {% if block.settings.button_background != 'rgba(0,0,0,0)' %}
                        --button-background: {{ block.settings.button_background.red }}, {{ block.settings.button_background.green }}, {{ block.settings.button_background.blue }};{%  endif %}
                        {% if block.settings.button_text_color != 'rgba(0,0,0,0)' %}
                        --button-text-color: {{ block.settings.button_text_color.red }}, {{ block.settings.button_text_color.green }}, {{ block.settings.button_text_color.blue }};
                        --border-color: {{ block.settings.button_text_color.red }}, {{ block.settings.button_text_color.green }}, {{ block.settings.button_text_color.blue }};
                        {%  endif %}
                      "
                    >
                      {{ block.settings.button_text }}
                    </a>
                  {% endif %}

                  {% if block.settings.button_text_2 != blank %}
                    <a
                      href="{{ block.settings.button_url_2 }}"
                      class="button button--{{ block.settings.button_style_2 }}"

                      style="
                        {% if block.settings.button_background_2 != 'rgba(0,0,0,0)' %}
                        --button-background: {{ block.settings.button_background_2.red }}, {{ block.settings.button_background_2.green }}, {{ block.settings.button_background_2.blue }};{%  endif %}
                        {% if block.settings.button_text_color_2 != 'rgba(0,0,0,0)' %}
                        --button-text-color: {{ block.settings.button_text_color_2.red }}, {{ block.settings.button_text_color_2.green }}, {{ block.settings.button_text_color_2.blue }};
                        --border-color: {{ block.settings.button_text_color_2.red }}, {{ block.settings.button_text_color_2.green }}, {{ block.settings.button_text_color_2.blue }};{%  endif %}
                      "
                    >
                      {{- block.settings.button_text_2 -}}
                    </a>
                  {% endif %}
                </div>
              {%- endif -%}
            </div>
          </div>
        </div>
      {% endif %}
    {% endfor %}
  </div>
</section>

<script>
  (function () {
    document.addEventListener('DOMContentLoaded', function () {
      var sectionEl = document.getElementById('shopify-section-{{ section.id }}');
      if (!sectionEl) return;

      var footerForms = sectionEl.querySelectorAll('.ed_deine_footer_form');
      footerForms.forEach(function (form) {
        var checkbox = form.querySelector('.ed_deine_footer_form_checkbox');
        if (!checkbox) return;

        var gatedButtons = form.querySelectorAll('.ed_deine_footer_form_primary_cta');

        function updateButtonsState() {
          var isActive = checkbox.classList.contains('active');
          checkbox.setAttribute('aria-pressed', isActive ? 'true' : 'false');

          gatedButtons.forEach(function (button) {
            if (isActive) {
              button.classList.remove('is-disabled');
              button.removeAttribute('aria-disabled');
              button.removeAttribute('tabindex');
            } else {
              button.classList.add('is-disabled');
              button.setAttribute('aria-disabled', 'true');
              button.setAttribute('tabindex', '-1');
            }
          });
        }

        updateButtonsState();

        checkbox.addEventListener('click', function (event) {
          event.preventDefault();
          checkbox.classList.toggle('active');
          updateButtonsState();
        });

        gatedButtons.forEach(function (button) {
          button.addEventListener('click', function (event) {
            if (!checkbox.classList.contains('active')) {
              event.preventDefault();
              event.stopImmediatePropagation();
            }
          });
        });
      });
    });
  })();
</script>

{% schema %}
{
  "name": "Rucksendung",
  "class": "shopify-section--rucksendung",
  "disabled_on": {
    "groups": ["header", "custom.overlay"]
  },
  "settings": [
    {
      "type": "header",
      "content": "Section spacing"
    },
    {
      "type": "range",
      "id": "space_top",
      "min": 0,
      "max": 150,
      "step": 5,
      "unit": "px",
      "label": "Top space",
      "default": 70
    },
    {
      "type": "range",
      "id": "space_bottom",
      "min": 0,
      "max": 150,
      "step": 5,
      "unit": "px",
      "label": "Bottom space",
      "default": 150
    },
    {
      "type": "paragraph",
      "content": "Section spacing (Mobile)"
    },
    {
      "type": "range",
      "id": "space_top_mobile",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "label": "Top (mobile)",
      "default": 35
    },
    {
      "type": "range",
      "id": "space_bottom_mobile",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "label": "Bottom (mobile)",
