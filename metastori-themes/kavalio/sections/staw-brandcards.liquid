<style>
  #shopify-section-{{ section.id }} {
    {%- if section.settings.background == 'rgba(0,0,0,0)' -%}
      {%- assign section_background = settings.background -%}
    {%- else -%}
      {%- assign section_background = section.settings.background -%}
    {%- endif -%}

    {%- if section.settings.text_color == 'rgba(0,0,0,0)' -%}
      {%- assign heading_color = settings.heading_color -%}
      {%- assign text_color = settings.text_color -%}
    {%- else -%}
      {%- assign heading_color = section.settings.text_color -%}
      {%- assign text_color = section.settings.text_color -%}
    {%- endif -%}

    --heading-color: {{ heading_color.red }}, {{ heading_color.green }}, {{ heading_color.blue }};
    --text-color: {{ text_color.red }}, {{ text_color.green }}, {{ text_color.blue }};
    --section-background: {{ section_background.red }}, {{ section_background.green }}, {{ section_background.blue }};
  }

  #shopify-section-{{ section.id }} {
    background-color: rgb(var(--section-background));
  }

  #shopify-section-{{ section.id }} .rhb-brand-card--bg {
    height: {{ section.settings.card_height }}px;
  }

  @media (min-width: 1000px) {
    #shopify-section-{{ section.id }} {
      padding-top: {{ section.settings.space_top }}px;
      padding-bottom: {{ section.settings.space_bottom }}px;
    }
  }

  @media (max-width: 999px) {
    #shopify-section-{{ section.id }} {
      padding-top: {{ section.settings.space_top_mobile }}px;
      padding-bottom: {{ section.settings.space_bottom_mobile }}px;
    }
  }

  #shopify-section-{{ section.id }} .rhb-description {
    font-size: var(--staw-font-size-{{ section.settings.content_font_size }});
  }

  #shopify-section-{{ section.id }} .text-uppercase {
    text-transform: uppercase;
  }

  {%- if section.settings.content_max_width != 'none' -%}
  @media screen and (min-width: 741px) {
    #shopify-section-{{ section.id }} .container {
      max-width: {{ section.settings.content_max_width }};
    }
  }
  {%- endif -%}

  #shopify-section-{{ section.id }} .rhb-brands-grid {
    margin-top: {{ section.settings.element_gap }}px;
  }
</style>

<section class="rhb-brands">
  <div class="container">
    <header class="section__header section__header--center text-container">
      {%- if section.settings.heading != blank -%}
        <h2 class="heading {{ section.settings.heading_class }}{% if section.settings.heading_uppercase %} text-uppercase{% endif %}">{{ section.settings.heading | escape }}</h2>
      {%- endif -%}

      {%- if section.settings.subheading != blank -%}
        <h3 class="heading heading--{{ section.settings.subheading_class }}{% if section.settings.subheading_uppercase %} text-uppercase{% endif %}"{% if section.settings.subheading_uppercase %} style="line-height: 1.15;"{% endif %}>{{ section.settings.subheading | escape }}</h3>
      {%- endif -%}

      {%- if section.settings.content != blank -%}
        <div class="rhb-description">{{ section.settings.content }}</div>
      {%- endif -%}
    </header>

    {%- if section.blocks.size > 0 -%}
      {%- assign grid_cols = section.blocks.size | at_most: 4 -%}
      <div class="rhb-brands-grid" style="--rhb-grid-cols: {{ grid_cols }};">
        {%- for block in section.blocks -%}
          <div
            class="rhb-brand-card{% if block.settings.card_image != blank %} rhb-brand-card--bg{% endif %}"
            {% if block.settings.card_image != blank %}
              style="background-image: url('{{ block.settings.card_image | image_url: width: 900 }}');"
            {% endif %}
            {{ block.shopify_attributes }}
          >
            {%- if block.settings.logo != blank -%}
              <div class="rhb-brand-card__logo">
                {{
                  block.settings.logo
                  | image_url: width: 300
                  | image_tag: loading: 'lazy', alt: block.settings.title
                  | default: 'Brand Logo'
                }}
              </div>
            {%- elsif block.settings.title != blank -%}
              <div class="rhb-brand-card__logo rhb-brand-card__logo--text">
                <p class="heading h5">{{ block.settings.title | escape }}</p>
              </div>
            {%- endif -%}

            {%- if block.settings.card_image == blank -%}
              <div class="rhb-brand-card__image rhb-brand-card__image--placeholder">
                {{ 'product-1' | placeholder_svg_tag }}
              </div>
            {%- endif -%}

            {%- if block.settings.button_text != blank -%}
              <div class="rhb-brand-card__action">
                <a
                  href="{{ block.settings.button_url | default: '#' }}"
                  class="button {{ block.settings.button_style }}"
                  {% if block.settings.open_in_new_tab %}
                    target="_blank" rel="noopener"
                  {% endif %}
                >
                  {{ block.settings.button_text | escape }}
                </a>
              </div>
            {%- endif -%}
          </div>
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "STAW | Brand Cards",
  "class": "shopify-section--staw-brandcards",
  "disabled_on": {
    "groups": ["header", "custom.overlay"]
  },
  "settings": [
    {
      "type": "header",
      "content": "Inhalte"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Überschrift"
    },
    {
      "type": "select",
      "id": "heading_class",
      "label": "Überschrift – Größe",
      "options": [
        { "value": "h1", "label": "H1" },
        { "value": "h2", "label": "H2" },
        { "value": "h3", "label": "H3" },
        { "value": "h4", "label": "H4" },
        { "value": "h5", "label": "H5" },
        { "value": "h6", "label": "H6" }
      ],
      "default": "h2"
    },
    {
      "type": "checkbox",
      "id": "heading_uppercase",
      "label": "Überschrift – Großbuchstaben",
      "default": false
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Unterüberschrift"
    },
    {
      "type": "select",
      "id": "subheading_class",
      "label": "Unterüberschrift – Größe",
      "options": [
        { "value": "h1", "label": "H1" },
        { "value": "h2", "label": "H2" },
        { "value": "h3", "label": "H3" },
        { "value": "h4", "label": "H4" },
        { "value": "h5", "label": "H5" },
        { "value": "h6", "label": "H6" }
      ],
      "default": "h5"
    },
    {
      "type": "checkbox",
      "id": "subheading_uppercase",
      "label": "Unterüberschrift – Großbuchstaben",
      "default": false
    },
    {
      "type": "richtext",
      "id": "content",
      "label": "Text"
    },
    {
      "type": "select",
      "id": "content_font_size",
      "label": "Textgröße",
      "options": [
        { "value": "small", "label": "Klein (14px)" },
        { "value": "base", "label": "Standard (16px)" },
        { "value": "medium", "label": "Mittel (18px)" },
        { "value": "large", "label": "Groß (20px)" },
        { "value": "xlarge", "label": "Sehr groß (22px)" }
      ],
      "default": "base"
    },
    {
      "type": "header",
      "content": "Marken: Einstellungen"
    },
    {
      "type": "range",
      "id": "card_height",
      "min": 150,
      "max": 475,
      "step": 5,
      "unit": "px",
      "label": "Kartenhöhe",
      "default": 400
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "content_max_width",
      "label": "Inhaltsbreite",
      "info": "Gilt ab 741px Bildschirmbreite – auf Mobilgeräten immer volle Breite",
      "options": [
        { "value": "640px", "label": "Schmal (640px)" },
        { "value": "900px", "label": "Mittel (900px)" },
        { "value": "1200px", "label": "Breit (1200px)" },
        { "value": "none", "label": "Volle Breite" }
      ],
      "default": "1200px"
    },
    {
      "type": "range",
      "id": "element_gap",
      "min": 4,
      "max": 60,
      "step": 2,
      "unit": "px",
      "label": "Abstand zwischen Elementen",
      "info": "Vertikaler Abstand zwischen den Blöcken",
      "default": 24
    },
    {
      "type": "header",
      "content": "Abstände"
    },
    {
      "type": "range",
      "id": "space_top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "label": "Abstand oben",
      "default": 90
    },
    {
      "type": "range",
      "id": "space_bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "label": "Abstand unten",
      "default": 90
    },
    {
      "type": "range",
      "id": "space_top_mobile",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "label": "Abstand oben (Mobil)",
      "default": 60
    },
    {
      "type": "range",
      "id": "space_bottom_mobile",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "label": "Abstand unten (Mobil)",
      "default": 60
    },
    {
      "type": "header",
      "content": "Farben"
    },
    {
      "type": "color",
      "id": "background",
      "label": "Hintergrund",
      "default": "rgba(0,0,0,0)"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Textfarbe",
      "default": "rgba(0,0,0,0)"
    }
  ],
  "blocks": [
    {
      "type": "brand_card",
      "name": "Marken-Karte",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Markenname"
        },
        {
          "type": "image_picker",
          "id": "logo",
          "label": "Logo"
        },
        {
          "type": "image_picker",
          "id": "card_image",
          "label": "Kartenbild"
        },
        {
          "type": "text",
          "id": "button_text",
          "label": "Button-Text",
          "default": "Jetzt konfigurieren"
        },
        {
          "type": "url",
          "id": "button_url",
          "label": "Button-Link"
        },
        {
          "type": "select",
          "id": "button_style",
          "label": "Button-Stil",
          "options": [
            { "value": "button--primary", "label": "Primär (gefüllt)" },
            { "value": "button--secondary", "label": "Sekundär" },
            { "value": "button--ternary", "label": "Tertiär" },
            { "value": "button--outline", "label": "Outline (Rahmen)" }
          ],
          "default": "button--primary"
        },
        {
          "type": "checkbox",
          "id": "open_in_new_tab",
          "label": "In neuem Tab öffnen",
          "default": false
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "STAW | Brand Cards",
      "settings": {
        "heading": "Marken-Konfiguratoren"
      }
    }
  ]
}
{% endschema %}
