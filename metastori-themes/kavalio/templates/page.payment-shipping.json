      }
    },
    "staw_content_composer_XDhnxi": {
      "type": "staw-content-composer",
      "blocks": {
        "image_YPqzGa": {
          "type": "image",
          "settings": {
            "image": "shopify://shop_images/kvl-zahlungsarten-amazon.png",
            "max_width": 300,
            "max_width_mobile": 300,
            "drop_shadow": false,
            "alignment": "flex-start"
          }
        },
        "text_jmERJp": {
          "type": "text",
          "settings": {
            "heading": "",
            "heading_class": "h2",
            "heading_uppercase": false,
            "subheading": "",
            "subheading_class": "h5",
            "subheading_uppercase": false,
            "content": "<p><strong>Amazon Pay</strong><br/>If you are already an Amazon customer, you do not need to create another account. Simply log in with your Amazon credentials. Then click on the Amazon Pay button and select your preferred payment and shipping method. </p>",
            "content_font_size": "base",
