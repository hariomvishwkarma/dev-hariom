    "staw_content_composer_dXkmHk": {
      "type": "staw-content-composer",
      "blocks": {
        "text_mtAqDc": {
          "type": "text",
          "settings": {
            "heading": "Deine Auswahl an Zahlungsmöglichkeiten:",
            "heading_class": "h6",
            "heading_uppercase": false,
            "subheading": "",
            "subheading_class": "h5",
            "subheading_uppercase": false,
            "content": "",
            "content_font_size": "base",
            "content_max_width": "none",
            "text_alignment": "left"
          }
        },
        "image_C4jyT3": {
          "type": "image",
          "settings": {
            "image": "shopify://shop_images/kvl-zahlungsarten-paypal.png",
            "max_width": 300,
            "max_width_mobile": 300,
            "drop_shadow": false,
            "alignment": "flex-start"
          }
        },
        "text_Hzf97r": {
          "type": "text",
          "settings": {
            "heading": "",
            "heading_class": "h2",
            "heading_uppercase": false,
            "subheading": "",
            "subheading_class": "h5",
            "subheading_uppercase": false,
            "content": "<p><strong>Zahlung per Lastschrift (ein Dienst von PayPal Plus)</strong><br/>Du wirst nach Abschluss deiner Bestellung zum Zahlungsdialog des Dienstleisters PayPal weitergeleitet. Diese Weiterleitung ist verschlüsselt und bietet dir daher höchstmögliche Datensicherheit. Dort kannst du deine Bankdaten eingeben. Der Rechnungsbetrag wird von PayPal eingezogen und an uns weiter transferiert. Bei dieser Zahlungsart entstehen dir natürlich keine zusätzlichen Kosten. <strong>Die Anmeldung bei PayPal ist nicht nötig, da diese Bezahlart für Kunden ohne PayPal Konto von PayPal entwickelt wurde. </strong></p><p><a href=\"https://www.paypal.com/de/webapps/mpp/ua/privacywax-full\" target=\"_blank\" title=\"PayPal Bedingungen\">Hier</a> kannst du die Bedingungen für den Kauf mit dieser Bezahlmethode einsehen.<br/><br/></p><p><strong>Zahlung per Kreditkarte (ein Dienst von PayPal Plus)</strong><br/>Bei der Bezahlmethode Zahlen per Kreditkarte (ein Dienst von PayPal) wirst du automatisch und verschlüsselt zum Zahlungsdialog des Dienstleisters PayPal weitergeleitet. Diese Weiterleitung ist verschlüsselt und bietet dir daher höchstmögliche Datensicherheit. Bei dieser Zahlungsart entstehen dir natürlich keine zusätzlichen Kosten. <strong>Die Anmeldung bei PayPal ist nicht nötig, da diese Bezahlart für Kunden ohne PayPal Konto von PayPal entwickelt wurde. </strong></p><p> </p><p><strong>Zahlung per PayPal (ein Dienst von PayPal Plus)</strong><br/>Bei der Zahlung per PayPal wirst du zu dem Zahlungsdialog von PayPal weitergeleitet. Hier kannst du deine PayPal Benutzerdaten eingeben und wie gewohnt mit deinem PayPal Benutzerkonto und den dort hinterlegten Zahlungsmitteln bezahlen. Bei dieser Zahlungsart benötigst du somit ein PayPal Benutzerkonto. Es entstehen dir bei dieser Zahlungsart natürlich keine zusätzlichen Kosten.</p><p>Ein PayPal Benutzerkonto kannst du <a href=\"http://www.paypal.de/\" target=\"_blank\" title=\"PayPal Website\">hier</a> einrichten.</p>",
            "content_font_size": "base",
            "content_max_width": "none",
            "text_alignment": "left"
          }
        }
      },
