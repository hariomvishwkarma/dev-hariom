<div class="ed-klarna-custom-payment">
  <div class="inner">
    {% if settings.rate_payment_method == 'klarna' %}
      {% assign rate_payment_label = 'Klarna' %}
      <img src="{{ 'klarna' | payment_type_img_url }}" alt="{{ rate_payment_label }}" title="{{ rate_payment_label }}">
    {% else %}
      {% assign rate_payment_label = 'PayPal' %}
      <img src="{{ 'paypal' | payment_type_img_url }}" alt="{{ rate_payment_label }}" title="{{ rate_payment_label }}">
    {% endif %}

    <span>{{ settings.text_rate_payment }}</span>
  </div>
</div>

<style>
  .ed-klarna-custom-payment img {
  {% if settings.payment_style == 'grayscale' %}
      filter: grayscale(1) !important;
  {% elsif settings.payment_style == 'colorful' %}
      filter: none !important;
  {% endif %}

  }
</style>
