<style>
  /* Mobile navigation CSS */
  .multicolumn__controls {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 20px;
    margin-top: 24px;
    flex-wrap: wrap;
    margin-bottom: 24px;
  }
  .multicolumn-controls-prev-next {
    width: 20px;
    height: 20px;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 2px;
  }
  .multicolumn-controls-prev-next[disabled] {
    opacity: 0.45;
  }
  .multicolumn-controls-prev-next svg {
    width: 100%;
    height: 100%;
    display: flex;
  }

  .multicolumn-controls--pagination {
    display: flex;
    gap: 4px;
  }

  .multicolumn-controls--pagination-dot {
    width: 12px;
    height: 3px;
    border-radius: 8px !important;
    background: #c8c8c8;
    border: none;
    cursor: pointer;
    border-radius: 8px;
    transition: all 0.3s ease-in-out;
  }

  .multicolumn-controls--pagination-dot.is-active {
    width: 45px;
    background: rgb(var(--text-color));
  }
</style>

{%- if section.blocks.size > 1 -%}
  <multicolumn-controls
    class="multicolumn__controls hidden-lap-and-up"
    data-multicolumn-controls
    data-section-id="{{ section.id }}"
  >
    <button
      type="button"
      class="multicolumn-controls-prev-next mc-prev"
      data-prev
      aria-label="{{ 'general.accessibility.previous' | t }}"
    >
      {%- render 'icon' with 'chevron-left' -%}
    </button>

    <div class="multicolumn-controls--pagination" data-pagination>
      {%- for block in section.blocks -%}
        <button
          type="button"
          class="multicolumn-controls--pagination-dot{% if forloop.first %} is-active{% endif %}"
          data-index="{{ forloop.index0 }}"
          aria-label="Go to slide {{ forloop.index }}"
        ></button>
      {%- endfor -%}
    </div>

    <button
      type="button"
      class="multicolumn-controls-prev-next mc-next"
      data-next
      aria-label="{{ 'general.accessibility.next' | t }}"
    >
      {%- render 'icon' with 'chevron-right' -%}
    </button>
  </multicolumn-controls>
{%- endif -%}
