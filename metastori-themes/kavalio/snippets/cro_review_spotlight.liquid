          {
              "adaptiveHeight": true,
              "cellSelector": ".hr_review_spotlight-item",
              "draggable": {{ block.settings.draggable }},
              "initialIndex": 0,
              "fade": {{ block.settings.fade }},
              "autoPlay": {{ block.settings.autoplay }},
              "pauseAutoPlayOnHover": true,
