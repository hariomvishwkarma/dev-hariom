  var POLARIS_SCRIPT_ID = 'reviewsio-cro-polaris-core';
  var POLARIS_SCRIPT_URL = 'https://widget.reviews.io/polaris/build.js';

  window.initCroReviewsWidget = function initCroReviewsWidget(attempt) {
    attempt = attempt || 0;

    if (typeof window.ReviewsWidget === 'function') {
      var widgetRoot = document.getElementById('CroReviewsWidget');
      if (widgetRoot && widgetRoot.getAttribute('data-reviewsio-mounted') !== 'true') {
        try {
          new window.ReviewsWidget('#CroReviewsWidget', window.CRO_REVIEWS_SPOTLIGHT_CONFIG);
          widgetRoot.setAttribute('data-reviewsio-mounted', 'true');
        } catch (error) {
          console.error('Failed to initialize CroReviewsWidget:', error);
        }
      }
      return;
    }

    if (
      attempt === 0 &&
      !document.getElementById(POLARIS_SCRIPT_ID) &&
      !document.querySelector('script[src="' + POLARIS_SCRIPT_URL + '"]')
    ) {
      var script = document.createElement('script');
      script.id = POLARIS_SCRIPT_ID;
      script.src = POLARIS_SCRIPT_URL;
      script.async = true;
      document.head.appendChild(script);
    }

    if (attempt >= 100) {
      return;
    }

    window.setTimeout(function () {
      window.initCroReviewsWidget(attempt + 1);
    }, 100);
  };

  window.initCroReviewsWidget();
</script>

<script>
  (function () {
    var POLL_MS = 250;
    var MAX_POLLS = 120;
    var pollCount = 0;
    var lastSignature = '';

    function readFromReviewsWidget() {
      var widget = document.getElementById('CroReviewsWidget');
      if (!widget) {
        return null;
      }

      var starsEl =
        widget.querySelector('.R-RatingStars__stars') ||
        widget.querySelector('.R-HeaderSummary .R-RatingStars__stars');
      var countEl =
        widget.querySelector('.R-HeaderSummary__count') ||
        widget.querySelector('.R-HeaderSummary .R-TextHeading') ||
        widget.querySelector('[class*="HeaderSummary"] [class*="count"]');
      var reviewNodes = widget.querySelectorAll(
        '.R-ReviewsList-item, .R-ReviewsList .R-ReviewsList-item, .R-Review'
      );

      var reviews = [];
      reviewNodes.forEach(function (node) {
        if (node.closest('.R-ReviewsList-item') !== node && node.classList.contains('R-Review')) {
          return;
        }

        var contentEl =
          node.querySelector('.R-Review__body') ||
          node.querySelector('.R-ReviewText') ||
          node.querySelector('.R-Review__content') ||
          node.querySelector('[class*="Review__body"]');
        var itemStarsEl = node.querySelector('.R-RatingStars__stars');
        var authorEl =
          node.querySelector('.R-ReviewAuthor__name') ||
          node.querySelector('.R-Review__author') ||
          node.querySelector('[class*="ReviewAuthor"]');

        var content = contentEl ? contentEl.innerHTML.trim() : '';
        if (!content && !itemStarsEl) {
          return;
        }

        reviews.push({
          content: content,
          starsHtml: itemStarsEl ? itemStarsEl.innerHTML : '',
          author: authorEl ? authorEl.textContent.trim() : '',
        });
      });

      return {
        starsHtml: starsEl ? starsEl.innerHTML : '',
        countText: countEl ? countEl.textContent.trim() : '',
        reviews: reviews,
        hasReviews: reviews.length > 0,
      };
    }

    function ensureSpotlightCarousel(listEl) {
      if (!listEl) {
        return null;
      }

      if (listEl.tagName.toLowerCase() === 'flickity-carousel') {
        return listEl;
      }

      var carousel = document.createElement('flickity-carousel');
      Array.prototype.forEach.call(listEl.attributes, function (attr) {
        if (attr.name === 'data-flickity-config') {
          carousel.setAttribute('flickity-config', attr.value);
        } else {
          carousel.setAttribute(attr.name, attr.value);
        }
      });
      carousel.innerHTML = listEl.innerHTML;
      listEl.replaceWith(carousel);
      return carousel;
    }

    function reloadSpotlightCarousel(listEl) {
      var carousel = ensureSpotlightCarousel(listEl);
      if (!carousel) {
        return;
      }

      if (typeof carousel.reload === 'function') {
        carousel.reload();
      }
    }

    function fillCarouselFromReviewsList(data) {
      if (!data) {
        return;
      }

      document.querySelectorAll('.hr_cro_review_spotlight_section').forEach(function (section) {
        var starsTarget = section.querySelector('[data-reviewsio-stars]');
        var countTarget = section.querySelector('[data-reviewsio-count]');
        var listTarget = section.querySelector('.hr_review_spotlight-list');

        if (starsTarget) {
          starsTarget.innerHTML = data.starsHtml || '';
        }

        if (countTarget) {
          countTarget.textContent = data.countText || '';
        }

        if (listTarget) {
          listTarget.innerHTML = '';

          data.reviews.forEach(function (review) {
            var item = document.createElement('div');
            item.className = 'hr_review_spotlight-item';
            item.innerHTML =
              '<div class="hr_review_spotlight-item-content">' +
              (review.content || '') +
              '</div>' +
              '<div class="hr_review_spotlight-item-title">' +
              '<span class="hr_review_spotlight-item-stars">' +
              (review.starsHtml || '') +
              '</span>' +
              (review.author ? '<p>' + review.author + '</p>' : '') +
              '</div>';
            listTarget.appendChild(item);
          });

          if (data.hasReviews) {
            reloadSpotlightCarousel(listTarget);
          }
        }

        section.classList.toggle('ed_has_reviews', data.hasReviews);
        section.classList.toggle('ed_no_reviews', !data.hasReviews);
      });
    }

    function syncSpotlights() {
      var data = readFromReviewsWidget();
      if (!data) {
        return;
      }

      var signature =
        (data.countText || '') +
        '|' +
        data.reviews.length +
        '|' +
        (data.starsHtml || '').length;

      if (signature === lastSignature) {
        return;
      }

      lastSignature = signature;
      fillCarouselFromReviewsList(data);
    }

    function startObserver() {
      var widget = document.getElementById('CroReviewsWidget');
      if (!widget || typeof MutationObserver === 'undefined') {
        return;
      }

      var observer = new MutationObserver(function () {
        window.requestAnimationFrame(syncSpotlights);
      });

      observer.observe(widget, {
        childList: true,
        subtree: true,
        characterData: true,
      });
    }

    function pollLoop() {
      syncSpotlights();
      pollCount += 1;

      var widget = document.getElementById('CroReviewsWidget');
      var hasContent =
        widget &&
        (widget.querySelector('.R-ReviewsList-item, .R-Review, .R-NoResults, .R-EmptyState') ||
          widget.getAttribute('data-reviewsio-mounted') === 'true');

      if (pollCount < MAX_POLLS && !hasContent) {
        window.setTimeout(pollLoop, POLL_MS);
        return;
      }

      startObserver();
      syncSpotlights();
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', pollLoop);
    } else {
      pollLoop();
    }
  })();
</script>

