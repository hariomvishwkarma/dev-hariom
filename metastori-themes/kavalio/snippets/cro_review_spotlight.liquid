<div class="hr_cro_review_spotlight_section">
  <div class="hr_cro_review_spotlight_no_reviews" aria-hidden="true" style="display: none;">
    <p>{{ 'product.reviews.no_reviews_yet' | t | default: '- Für dieses Produkt wurden noch keine Bewertungen abgegeben -' }}</p>
  </div>


  <header class="hr_review__header" data-reviewsio-header>
    <span class="hr_review_spotlight-item-stars" data-reviewsio-stars></span>
    <p class="hr_review_spotlight-count" data-reviewsio-count></p>
  </header>

  <div
    id="flickity-{{ section.id }}"
    class="hr_review_spotlight-list"
    data-flickity-config="{{ flickity_config | escape }}"
    aria-label="Reviews Carousel"
  ></div>

  <flickity-controls controls="flickity-{{ section.id }}" class="ed_pdp_reviews_spotlight_nav">
    <button
      class="ed-product__media-prev-next"
      aria-label="{{ 'general.accessibility.previous' | t }}"
      data-action="prev"
    >
      {%- render 'icon' with 'chevron-left' -%}
    </button>

    <button
      class="ed-product__media-prev-next"
      aria-label="{{ 'general.accessibility.next' | t }}"
      data-action="next"
    >
      {%- render 'icon' with 'chevron-right' -%}
    </button>
  </flickity-controls>
</div>
