{%- liquid
  assign visible_media_count = 0
  assign initial_media_index = 1

  for media in product.media
    assign is_media_filtered = false
    assign media_id_as_string = media.id | append: ''

    if filtered_media_ids contains media_id_as_string and media.alt != product.title
      assign is_media_filtered = true
    endif

    unless is_media_filtered
      assign visible_media_count = visible_media_count | plus: 1

      if selected_media.id == media.id
        assign initial_media_index = visible_media_count
      endif
    endunless
  endfor
-%}

{%- if visible_media_count > 1 -%}
  <div
    class="ed-pdp-media-counter"
    data-pdp-media-counter
    data-carousel="{{ carousel_id }}"
    aria-live="polite"
  >
    <svg class="ed-pdp-media-counter__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
      <rect x="3" y="3" width="18" height="18" rx="2"></rect>
      <circle cx="8.5" cy="8.5" r="1.5"></circle>
      <path d="M21 15l-5-5L5 21"></path>
    </svg>
    <span class="ed-pdp-media-counter__text">
      <span data-pdp-media-counter-current>{{ initial_media_index }}</span>
      <span aria-hidden="true">/</span>
      <span data-pdp-media-counter-total>{{ visible_media_count }}</span>
    </span>
  </div>
{%- endif -%}
