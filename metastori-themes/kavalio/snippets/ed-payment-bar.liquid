  {% if settings.payment_style == 'grayscale' %}
      filter: grayscale(1) !important;
  {% elsif settings.payment_style == 'colorful' %}
      filter: none !important;
  {% endif %}

  }

  .payment-methods-list__visa-icon {
      display: block;
      width: 33px;
      height: auto;
  }

  .payment-methods-list__item {
      display: inline-flex;
      align-items: center;
  }
</style>
