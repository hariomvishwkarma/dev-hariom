{%- comment -%}
  True when Auslaufartikel UI should apply: tag present AND variant is effectively out of stock.

  @param variant {Variant} required
{%- endcomment -%}

{%- assign apply_auslaufartikel_ui = false -%}
{%- capture is_auslaufartikel_tag_str -%}{%- render 'variant-is-auslaufartikel-tag', variant: variant -%}{%- endcapture -%}
{%- assign is_auslaufartikel_tag_str = is_auslaufartikel_tag_str | strip -%}

{%- if is_auslaufartikel_tag_str == 'true' -%}
  {%- capture variant_buy_allowed_str -%}{%- render 'variant-buy-allowed', variant: variant -%}{%- endcapture -%}
  {%- assign variant_buy_allowed_str = variant_buy_allowed_str | strip -%}
  {%- if variant_buy_allowed_str == 'false' -%}
    {%- assign apply_auslaufartikel_ui = true -%}
  {%- endif -%}
{%- endif -%}

{%- if apply_auslaufartikel_ui -%}true{%- else -%}false{%- endif -%}
