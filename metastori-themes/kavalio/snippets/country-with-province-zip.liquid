{%- assign country_with_province_zip = 'Albania=1001,Argentina+Buenos Aires=B1406,Armenia=0002,Australia+Australian Capital Territory=2609,Belgium=1000,Brazil+Rio de Janeiro=20000-000,Bulgaria=1000,China+Beijing=065001,Denmark=2300,Germany=10115,Estonia=10001,Finland=00100,France=70123,Georgia=0200,Greece=104 31,India+Delhi=110003,Indonesia+Jakarta=10110,Ireland+Dublin=D01,Italy+Roma=00153,Jordan=11191,Canada+Ontario=L7K 0C2,Croatia=10000,Kuwait+Al Ahmadi=60000,Latvia=1000,Lebanon=46052,Liechtenstein=9490,Lithuania=00116,Luxembourg=1508,Malta=ATD,Mexico+México=31846,Monaco=98000,Netherlands=1105 AW,Norway=1621,Austria=1010,Poland=33-300,Portugal+Lisboa=1750-194,Romania+București=010011,Saudi Arabia=46477,Sweden=100 44,Switzerland=3001,Serbia=11000,Singapore=269437,Slovakia=010 01,Slovenia=1504,Spain+Madrid=28054,Czech Republic=110 0,Turkey=37600,Hungary=1051,United Arab Emirates+Abu Dhabi=00000,United States+District of Columbia=20005,United Kingdom+England=PO16 7GZ,Cyprus=2480'
    | split: ','
  -%}
  
  <script id="country-with-province-zip">
    [{%- for country in country_with_province_zip -%}
      {%- if country contains '+' -%}
        {%- assign name = country | split: '+' | first -%}
        {%- assign province = country | split: '+' | last | split: '=' | first -%}
        {%- assign zip_code = country | split: '=' | last -%}
      {%- else -%}
        {%- assign name = country | split: '=' | first -%}
        {%- assign province = blank -%}
        {%- assign zip_code = country | split: '=' | last -%}
      {%- endif %}
      {
        "country": "{{ name }}",
        "province": "{{ province }}",
        "zip": "{{ zip_code }}"
      }{%- unless forloop.last -%},{%- endunless -%}
      {%- endfor %}
    ]
  </script>
  