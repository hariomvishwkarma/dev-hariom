{% if product.metafields.standard.cro_product_attributes %}
  {% assign progress_size = 24 %}
  {% assign progress_size_mobile = 16 %}

  <style>
    .hr_cro_product_attributes_section > h2 {
        font-weight: {{ block.settings.heading_weight }};
        font-style: {{ block.settings.heading_style }};
        text-transform: {{  block.settings.heading_transform }};
        letter-spacing: {{ block.settings.letter_spacing -}}px;
    }
    ul.cro_product_attributes {
        list-style: none;
        margin: 0;
        padding: 0;
        background: {{ block.settings.cro_background }};
        display: flex;
        flex-direction: column;
        gap: 24px;
        border-radius: {{ block.settings.cro_corner_radius -}}px;
    }

    li.cro_product_attributes_item {
        display: flex;
        flex-direction: column;
        gap: 8px;
    }

    li.cro_product_attributes_item > h4 {
        margin-bottom: 0;
        font-weight: {{ block.settings.title_weight }};
        font-style: {{ block.settings.title_style }};
        text-align: {{ block.settings.title_position }};
        text-transform: {{ block.settings.title_transform }};
        letter-spacing: {{ block.settings.title_letter_spacing }}px;
    }

    .cro_progressbar {
        position: relative;
        width: 100%;
        height: 8px;
        background: {{ block.settings.progress_bg }};
        {%- if block.settings.progress_style == 'rounded' -%}
            border-radius: 360px;
        {%- else -%}
            border-radius: 0;
        {%- endif -%}
    }

    .cro_progressbar_position {
        width: {{ progress_size -}}px;
        height: 8px;
        background: {{ block.settings.progress_active_bg }};
        position: absolute;
        {%- if block.settings.progress_style == 'rounded' -%}
            border-radius: 360px;
        {%- else -%}
            border-radius: 0;
        {%- endif -%}
    }

    .cro_status {
        position: relative;
        text-align: center;
        display: flex;
        align-items: center;
        justify-content: center;
    }
    .cro_status.size-3 > span:nth-child(1) {
        position: absolute;
        top: 0;
        left: 0;
    }

    .cro_status.size-3 > span:nth-child(3) {
        position: absolute;
        top: 0;
        right: 0;
    }

    .cro_status.size-2 > span:nth-child(1) {
        position: absolute;
        left: 0;
        top: 0;
    }

    .cro_status.size-2 > span:nth-child(2) {
        position: absolute;
        top: 0;
        right: 0;
    }

    .cro_status span {
        line-height: 1;
    }

    @media (min-width: 741px) {
        .hr_cro_product_attributes_section {
            margin-top: {{ block.settings.space_top -}}px;
            margin-bottom: {{ block.settings.space_bottom -}}px;
        }
        .hr_cro_product_attributes_section > h2 {
            font-size: {{ block.settings.heading_size -}}px;
            margin-bottom: {{ block.settings.heading_margin_bottom -}}px;

        }
        li.cro_product_attributes_item > h4 {
            font-size: {{ block.settings.title_size -}}px;
        }
        .cro_status span {
            font-size: {{ block.settings.attributes_size -}}px;
        }
    }

    @media (max-width: 740px) {
        .hr_cro_product_attributes_section {
            margin-top: {{ block.settings.space_top_mobile -}}px;
            margin-bottom: {{ block.settings.space_bottom_mobile -}}px;
        }
        .hr_cro_product_attributes_section > h2 {
            font-size: {{ block.settings.heading_size_mobile -}}px;margin-bottom: {{ block.settings.heading_margin_bottom_mobile -}}px;
        }
        li.cro_product_attributes_item > h4 {
            font-size: {{ block.settings.title_size_mobile -}}px;
        }
        .cro_status span {
            font-size: {{ block.settings.attributes_size_mobile -}}px;
        }
        .cro_progressbar_position {
            width: {{ progress_size_mobile -}}px;
        }
    }
  </style>

  {% assign product_attributes = product.metafields.standard.cro_product_attributes.value %}

  <div class="hr_cro_product_attributes_section">
    <ul class="cro_product_attributes">
      {% for i in (1..3) %}
        {% assign title_key = 'title_0' | append: i %}
        {% assign progress_key = 'progress_0' | append: i %}
        {% assign attributes_key = 'attributes_0' | append: i %}

        {% if product_attributes[title_key] %}
          <li class="cro_product_attributes_item">
            <h4 class="h6">{{ product_attributes[title_key] }}</h4>
            <div class="cro_progressbar">
              <div class="cro_progressbar_position block-{{ i }}"></div>

              {%- style -%}
                @media (min-width: 741px) {
                    #shopify-section-{{ section.id }} .cro_progressbar_position.block-{{ i }} {
                        {%- if product_attributes[progress_key] != 0 -%}
                            left:calc({{ product_attributes[progress_key] }}% - {{ progress_size -}}px);
                        {%- else -%}
                            left:{{ product_attributes[progress_key] }}%;
                        {%- endif -%}
                    }
                }

                @media (max-width: 740px) {
                    #shopify-section-{{ section.id }} .cro_progressbar_position.block-{{ i }} {
                        {%- if product_attributes[progress_key] != 0 -%}
                            left:calc({{ product_attributes[progress_key] }}% - {{ progress_size_mobile -}}px);
                        {%- else -%}
                            left:{{ product_attributes[progress_key] }}%;
                        {%- endif -%}
                    }
                }
              {%- endstyle -%}
            </div>

            {% assign attributes_list = product_attributes[attributes_key].value %}
            {% if attributes_list %}
              <div class="cro_status size-{{ attributes_list.size }}">
                {% for attribute in attributes_list %}
                  <span>{{ attribute }}</span>
                {% endfor %}
              </div>
            {% endif %}
          </li>
        {% endif %}
      {% endfor %}
    </ul>
  </div>
{% endif %}
