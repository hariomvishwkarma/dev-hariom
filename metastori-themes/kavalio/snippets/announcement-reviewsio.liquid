{% doc %}
  Renders the Reviews.io rating bar placeholder for the announcement bar.

  @param {object} block - Announcement bar trusted shops block.
  @param {object} settings - Block settings containing widget_html.
{% enddoc %}

{%- liquid
  assign widget_html = settings.widget_html | default: block.settings.widget_html

  assign widget_id = widget_html | split: 'widget-id="' | last | split: '"' | first
  if widget_id == widget_html or widget_id == blank
    assign widget_id = 'SoWGO3KNMga6tRVF'
  endif

  assign store_name = widget_html | split: 'data-store-name="' | last | split: '"' | first
  if store_name == widget_html or store_name == blank
    assign store_name = shop.permanent_domain | split: '.' | first
  endif

  assign widget_language = widget_html | split: 'lang="' | last | split: '"' | first
  if widget_language == widget_html or widget_language == blank
    assign widget_language = localization.language.iso_code | default: 'de' | slice: 0, 2
  endif
-%}

<div
  class="reviews-io-rating-bar-widget"
  widget-id="{{ widget_id | escape }}"
  data-store-name="{{ store_name | escape }}"
  lang="{{ widget_language | escape }}"
></div>

<style>
  .shopify-section--announcement-bar .announcement-bar-reviewsio,
  .shopify-section--announcement-bar .reviews-io-rating-bar-widget,
  .shopify-section--announcement-bar .RatingBarWidget-prefix,
  .shopify-section--announcement-bar .RatingBarWidget-prefix .RatingBarWidget,
  .shopify-section--announcement-bar .RatingBarWidget-prefix .RatingBarWidget__inner {
      min-height: 24px;
  }

  .shopify-section--announcement-bar .reviews-io-rating-bar-widget {
      display: flex;
      align-items: center;
      justify-content: center;
      min-width: 220px;
  }

  .RatingBarWidget-prefix .RatingBarWidget--dark,
  .RatingBarWidget-prefix .RatingBarWidget .RatingBarWidget__inner {
      background: transparent !important;
  }

  .RatingBarWidget-prefix {
      display: flex !important;
      justify-content: flex-start !important;
      align-items: center !important;
  }

  @media only screen and (min-width: 12.5em) {
      .RatingBarWidget-prefix .R-flex-center-xxs {
          -webkit-box-pack: center !important;
          -ms-flex-pack: center !important;
          -webkit-justify-content: flex-start !important;
          -moz-justify-content: flex-start !important;
          justify-content: flex-start !important;
          text-align: center !important;
      }
  }

  @media (max-width: 999px) {
      .shopify-section--announcement-bar .announcement_trusted_shop_wrapper .announcement-bar-reviewsio {
          display: flex;
          align-items: center;
          justify-content: center;
          width: 100%;
          min-height: 28px;
      }

      .shopify-section--announcement-bar .announcement_trusted_shop_wrapper .reviews-io-rating-bar-widget {
          flex: 0 1 auto;
      }

      .shopify-section--announcement-bar .announcement-bar-reviewsio,
      .shopify-section--announcement-bar .reviews-io-rating-bar-widget,
      .shopify-section--announcement-bar .RatingBarWidget-prefix,
      .shopify-section--announcement-bar .RatingBarWidget-prefix .RatingBarWidget,
      .shopify-section--announcement-bar .RatingBarWidget-prefix .RatingBarWidget__inner {
          min-height: 28px;
      }
  }
</style>
