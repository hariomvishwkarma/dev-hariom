{% comment %}
  -badge: {{ true }}
{% endcomment %}

{% assign badge = badge | downcase %}


{%- if badge contains 'bestseller' -%}
  <span class="badge badge--bestseller">
    {{ settings.bestseller_icon }}
    <span class="badge__text">{{ badge }}</span>
  </span>
{%- elsif badge contains 'neu' -%}
  <span class="badge badge--neu">
    {{ settings.neu_icon }}
    <span class="badge__text">{{ badge }}</span>
  </span>
{%- elsif badge contains 'limited edition' -%}
  <span class="badge badge--limited-edition">
    {{ settings.limited_edition_icon }}
    <span class="badge__text">{{ badge }}</span>
  </span>
{%- elsif badge == 'sale' -%}
  {% comment %} {% if settings.sale_icon != blank %}
    <span class="badge badge--sale">
      {{ settings.sale_icon }}
    </span>
  {% endif %} {% endcomment %}
{%- endif -%}
