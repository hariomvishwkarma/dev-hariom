{% comment %}
  Kavalio — single source of truth for the variant on-sale condition (Liquid).

  Adjust only this file when the sale rule changes.
  Keep assets/custom.js → isKavalioVariantOnSale() in sync for PDP variant switching.

  Current rule (collection — sold-out variants are ignored):
  - variant is purchasable (snippets/variant-buy-allowed.liquid)
  - variant.compare_at_price is set
  - variant.price is lower than variant.compare_at_price

  PDP uses snippets/kavalio-variant-on-sale-pdp.liquid instead.

  Parameters:
  - variant: {Variant} required
{% endcomment %}

{%- capture variant_buy_allowed_str -%}{%- render 'variant-buy-allowed', variant: variant -%}{%- endcapture -%}
{%- assign variant_buy_allowed_str = variant_buy_allowed_str | strip -%}

{%- if variant != blank
  and variant_buy_allowed_str == 'true'
  and variant.compare_at_price != blank
  and variant.price < variant.compare_at_price
-%}true{%- endif -%}
