{% if item.variant.metafields.custom.gefahren-piktogramm != blank %}
    <div class="piktogramme">
        {% assign hazard_signal_words = item.variant.metafields.custom.signalwort %}
        {% assign hazard_statements = item.variant.metafields.custom.gefahrenhinweise | append: ' ' | append: item.variant.metafields.custom.ergaenzende-gefahrenmerkmale | append: ' ' | append: item.variant.metafields.custom.sicherheitshinweise %}

        {% if item.variant.metafields.custom.gefahren-piktogramm contains 'GHS01' %}
            {% if settings.ghs01_image != blank %}
                {{ settings.ghs01_image | image_url: width: 100 | image_tag: height: 30, width: 30, class: 'inline-block open-hazard-modal', hazardStatements: hazard_statements, hazardSignalWords: hazard_signal_words }}
            {% endif %}
        {% endif %}
        {% if item.variant.metafields.custom.gefahren-piktogramm contains 'GHS02' %}
            {% if settings.ghs02_image != blank %}
                {{ settings.ghs02_image | image_url: width: 100 | image_tag: height: 30, width: 30, class: 'inline-block open-hazard-modal', hazardStatements: hazard_statements, hazardSignalWords: hazard_signal_words }}
            {% endif %}
        {% endif %}
        {% if item.variant.metafields.custom.gefahren-piktogramm contains 'GHS03' %}
            {% if settings.ghs03_image != blank %}
                {{ settings.ghs03_image | image_url: width: 100 | image_tag: height: 30, width: 30, class: 'inline-block open-hazard-modal', hazardStatements: hazard_statements, hazardSignalWords: hazard_signal_words }}
            {% endif %}
        {% endif %}
        {% if item.variant.metafields.custom.gefahren-piktogramm contains 'GHS04' %}
            {% if settings.ghs04_image != blank %}
                {{ settings.ghs04_image | image_url: width: 100 | image_tag: height: 30, width: 30, class: 'inline-block open-hazard-modal', hazardStatements: hazard_statements, hazardSignalWords: hazard_signal_words }}
            {% endif %}
        {% endif %}
        {% if item.variant.metafields.custom.gefahren-piktogramm contains 'GHS05' %}
            {% if settings.ghs05_image != blank %}
                {{ settings.ghs05_image | image_url: width: 100 | image_tag: height: 30, width: 30, class: 'inline-block open-hazard-modal', hazardStatements: hazard_statements, hazardSignalWords: hazard_signal_words }}
            {% endif %}
        {% endif %}
        {% if item.variant.metafields.custom.gefahren-piktogramm contains 'GHS06' %}
            {% if settings.ghs06_image != blank %}
                {{ settings.ghs06_image | image_url: width: 100 | image_tag: height: 30, width: 30, class: 'inline-block open-hazard-modal', hazardStatements: hazard_statements, hazardSignalWords: hazard_signal_words }}
            {% endif %}
        {% endif %}
        {% if item.variant.metafields.custom.gefahren-piktogramm contains 'GHS07' %}
            {% if settings.ghs07_image != blank %}
                {{ settings.ghs07_image | image_url: width: 100 | image_tag: height: 30, width: 30, class: 'inline-block open-hazard-modal', hazardStatements: hazard_statements, hazardSignalWords: hazard_signal_words }}
            {% endif %}
        {% endif %}
        {% if item.variant.metafields.custom.gefahren-piktogramm contains 'GHS08' %}
            {% if settings.ghs08_image != blank %}
                {{ settings.ghs08_image | image_url: width: 100 | image_tag: height: 30, width: 30, class: 'inline-block open-hazard-modal', hazardStatements: hazard_statements, hazardSignalWords: hazard_signal_words }}
            {% endif %}
        {% endif %}
        {% if item.variant.metafields.custom.gefahren-piktogramm contains 'GHS09' %}
            {% if settings.ghs09_image != blank %}
                {{ settings.ghs09_image | image_url: width: 100 | image_tag: height: 30, width: 30, class: 'inline-block open-hazard-modal', hazardStatements: hazard_statements, hazardSignalWords: hazard_signal_words }}
            {% endif %}
        {% endif %}

        {% assign hazard_statements = hazard_statements | replace: "'", '`' %}
        {% assign hazard_signal_words = hazard_signal_words | replace: "'", '`' %}

      <div class="open-hazard-modal" hazardStatements='{{ hazard_statements }}' hazardSignalWords='{{ hazard_signal_words }}'>Hinweise</div>
    </div>
    <script>

      // Function to open the modal
      function openModal() {
        const modal = document.getElementById('hazard-modal');
        const hazardContent = document.getElementById('hazard-content');
        var hazardStatements = this.getAttribute('hazardStatements');
        var hazardSignalWords = this.getAttribute('hazardSignalWords');

        // Clear any existing content
        hazardContent.innerHTML = '';

        const signalWordElement = document.createElement('p');
        signalWordElement.innerHTML = '<strong>Signalwort:</strong> ' + hazardSignalWords;
        hazardContent.appendChild(signalWordElement);

        const statementElement = document.createElement('p');
        statementElement.innerHTML = hazardStatements;
        hazardContent.appendChild(statementElement);

        modal.style.display = 'block';
        modal.style.visibility = 'visible';
      }

      // Function to close the modal
      function closeModal() {
        const modal = document.getElementById('hazard-modal');
        modal.style.display = 'none';
        modal.style.visibility = 'hidden';
      }

      // Event listeners
      for (const openBtn of document.getElementsByClassName('open-hazard-modal')) {
        openBtn.addEventListener('click', openModal);
      }
      
      // Close the modal if the user clicks outside of it
      window.onclick = function(event) {
        const modal = document.getElementById('hazard-modal');
        if (event.target == modal) {
          modal.style.display = 'none';
        modal.style.visibility = 'hidden';  
        }
      };

    </script>
  {% endif %}