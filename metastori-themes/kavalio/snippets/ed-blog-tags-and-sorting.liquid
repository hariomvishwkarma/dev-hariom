{% comment %}
  Blog tags (Themen) + sort.
  Desktop: "Themen" heading, tag buttons (active/inactive classes), sort popover on the right.
  Mobile: "Themen" heading + popover-style tag selector (button shows selected tag + chevron, opens popover); sort hidden.
{% endcomment %}
{%- if blog and section.settings.show_tags and blog.all_tags.size > 0 -%}
  <div class="ed_blog_tags_and_sorting_wrap">
    <div class="container">
      <div class="ed_blog_tags_and_sorting_inner">
        <div class="ed_blog__tags_wrapper">
          <h3 class="ed_blog__tags_heading heading h5">{{ 'blog.general.topics' | t | default: 'Themen' }}</h3>

          {%- comment -%} Desktop: tag buttons (scrollable, theme scroller pattern) {%- endcomment -%}
          <div class="scroller ed_blog__tags_scroller_wrap hidden-pocket">
            <div class="ed_blog__tags_buttons scrollable-content">
              <a href="{{ blog.url }}" class="button {% if current_tags == blank %}ed_blog_btn_active button--primary{% else %}ed_blog_btn{% endif %}">
                {{ 'blog.general.all_posts' | t }}
              </a>
              {%- for tag in blog.all_tags -%}
                {%- if current_tags contains tag -%}
                  <a href="{{ blog.url }}/tagged/{{ tag | handle }}" class="button ed_blog_btn_active button--primary">{{ tag }}</a>
                {%- else -%}
                  {{ tag | link_to_tag: tag | replace: '<a ', '<a class="button ed_blog_btn" ' }}
                {%- endif -%}
              {%- endfor -%}
            </div>
          </div>

          {%- comment -%} Mobile: popover-style tag selector (button shows selected tag + chevron, opens popover with choices) {%- endcomment -%}
          <div class="popover-container hidden-lap-and-up">
            <button type="button" is="toggle-button" class="popover-button tap-area" aria-expanded="false" aria-controls="blog-tags-popover-{{ section.id }}" aria-label="{{ 'blog.general.topics' | t }}">
              <span id="blog-tags-selected-value-{{ section.id }}">
                {%- if current_tags == blank -%}
                  {{ 'blog.general.all_posts' | t }}
                {%- else -%}
                  {{ current_tags | join: ', ' }}
                {%- endif -%}
              </span>
              {%- render 'icon' with 'chevron', width: 9, height: 6, inline: true -%}
            </button>
            <popover-content id="blog-tags-popover-{{ section.id }}" class="popover popover--top popover--small">
              <span class="popover__overlay"></span>
              <header class="popover__header">
                <span class="popover__title heading h6">{{ 'blog.general.topics' | t }}</span>
                <button type="button" class="popover__close-button tap-area tap-area--large" data-action="close" title="{{ 'general.accessibility.close' | t }}" aria-label="{{ 'general.accessibility.close' | t }}">
                  {%- render 'icon' with 'close' -%}
                </button>
              </header>
              <div class="popover__content">
                <div class="popover__choice-list">
                  <a href="{{ blog.url }}" class="popover__choice-item">
                    <span class="popover__choice-label" {% if current_tags == blank %}aria-current="true"{% endif %}>{{ 'blog.general.all_posts' | t }}</span>
                  </a>
                  {%- for tag in blog.all_tags -%}
                    <a href="{{ blog.url }}/tagged/{{ tag | handle }}" class="popover__choice-item">
                      <span class="popover__choice-label" {% if current_tags contains tag %}aria-current="true"{% endif %}>{{ tag }}</span>
                    </a>
                  {%- endfor -%}
                </div>
              </div>
            </popover-content>
          </div>
        </div>

        {%- comment -%} Sort: desktop only (hidden on mobile){%- endcomment -%}
        <div class="ed_blog__sorting_wrapper hidden-pocket">
          <div class="popover-container">
            <button type="button" is="toggle-button" class="popover-button" aria-expanded="false" aria-controls="blog-sort-by-popover-{{ section.id }}">
              {% render 'icon' with 'sortby' %}
              <span id="blog-sort-by-selected-value-{{ section.id }}" style="pointer-events: none">{{ 'collection.sorting.newest' | t }}</span>
            </button>
            <sort-by-popover id="blog-sort-by-popover-{{ section.id }}" class="popover">
              <span class="popover__overlay"></span>
              <header class="popover__header">
                <span class="popover__title heading h6">{{ 'blog.general.sort_by' | t }}</span>
                <button type="button" class="popover__close-button tap-area tap-area--large" data-action="close" title="{{ 'general.accessibility.close' | t }}">{%- render 'icon' with 'close' -%}</button>
              </header>
              <div class="popover__content">
                <div class="popover__choice-list">
                  <label class="popover__choice-item">
                    <input type="radio" data-bind-value="blog-sort-by-selected-value-{{ section.id }}" class="visually-hidden" name="sort_by" value="published_desc" title="{{ 'collection.sorting.newest' | t }}" checked>
                    <span class="popover__choice-label">{{ 'collection.sorting.newest' | t }}</span>
                  </label>
                  <label class="popover__choice-item">
                    <input type="radio" data-bind-value="blog-sort-by-selected-value-{{ section.id }}" class="visually-hidden" name="sort_by" value="published_asc" title="{{ 'collection.sorting.oldest' | t }}">
                    <span class="popover__choice-label">{{ 'collection.sorting.oldest' | t }}</span>
                  </label>
                  <label class="popover__choice-item">
                    <input type="radio" data-bind-value="blog-sort-by-selected-value-{{ section.id }}" class="visually-hidden" name="sort_by" value="title_asc" title="{{ 'collection.sorting.title_ascending' | t }}">
                    <span class="popover__choice-label">{{ 'collection.sorting.title_ascending' | t }}</span>
                  </label>
                  <label class="popover__choice-item">
                    <input type="radio" data-bind-value="blog-sort-by-selected-value-{{ section.id }}" class="visually-hidden" name="sort_by" value="title_desc" title="{{ 'collection.sorting.title_descending' | t }}">
                    <span class="popover__choice-label">{{ 'collection.sorting.title_descending' | t }}</span>
                  </label>
                </div>
              </div>
            </sort-by-popover>
          </div>
        </div>
      </div>
    </div>
  </div>

  <script>
    (function() {
      var sectionId = '{{ section.id }}';
      var wrap = document.querySelector('.ed_blog_tags_and_sorting_wrap');
      if (wrap) {
        document.addEventListener('facet:criteria-changed', function(e) {
          if (wrap.contains(e.target)) { window.location.href = e.detail.url; }
        });
      }
      var params = new URLSearchParams(window.location.search);
      var sortBy = params.get('sort_by');
      if (sortBy && wrap) {
        var radio = wrap.querySelector('input[name="sort_by"][value="' + sortBy + '"]');
        var span = document.getElementById('blog-sort-by-selected-value-' + sectionId);
        if (radio && span) {
          radio.checked = true;
          span.textContent = radio.getAttribute('title') || radio.value;
        }
      }
    })();
  </script>
{%- endif -%}
