                      {%- else -%}
                        {%- capture savings -%}{{ product.selected_or_first_available_variant.compare_at_price | minus: product.selected_or_first_available_variant.price | money_without_currency }}{{ shop.currency | replace: 'EUR', '€' | replace: 'eur', '€' | replace: 'USD', '$' | replace: 'usd', '$' }}{%- endcapture -%}
                      {%- endif -%}

                      <span class="label label--highlight">
                        {{- 'collection.product.discount_html' | t: savings: savings -}}
                      </span>
                    {%- endunless -%}
                  </div>
                {%- endif -%}
