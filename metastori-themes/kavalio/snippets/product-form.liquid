                      {%- endfor -%}
                    {%- else -%}
                      {%- for tag in product.tags -%}
                        {%- if tag contains '__label' -%}
                          <span class="label label--custom{% if tag contains '__label2' %}2{% endif %}">
                            {{- tag | split: ':' | last -}}
                          </span>
                        {%- endif -%}
                      {%- endfor -%}
                    {%- endif -%}
