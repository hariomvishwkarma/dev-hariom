{%- assign color_label_list = 'general.label.color' | t | replace: ', ', ',' | downcase | split: ',' -%}
{%- assign color_white_label = 'general.label.white' | t | downcase -%}
{%- assign size_label_list = 'general.label.size' | t | replace: ', ', ',' | downcase | split: ',' -%}

{%- assign kavalio_care_product = settings.kavalio_care_product -%}
{%- assign is_kavalio_care = false -%}
{%- if kavalio_care_product != blank and product.id == kavalio_care_product.id -%}
  {%- assign is_kavalio_care = true -%}
{%- elsif product.metafields.custom.product_type == 'Kavalio care' -%}
  {%- assign is_kavalio_care = true -%}
{%- endif -%}

{%- assign kavalio_in_cart = false -%}
{%- if is_kavalio_care and cart != blank and cart.item_count > 0 -%}
  {%- for item in cart.items -%}
    {%- if item.product.id == product.id -%}
      {%- assign kavalio_in_cart = true -%}
      {%- break -%}
    {%- endif -%}
  {%- endfor -%}
{%- endif -%}

{%- comment -%}
  If the URL/selected variant is not purchasable, redirect to the first buyable variant
  so Farbe/Größe and the whole PDP render against an available combination.
{%- endcomment -%}
{%- unless context == 'quick-buy' -%}
  {%- assign url_selected_variant = product.selected_or_first_available_variant -%}
  {%- if url_selected_variant != blank -%}
    {%- capture url_selected_buyable -%}{%- render 'variant-buy-allowed', variant: url_selected_variant -%}{%- endcapture -%}
    {%- assign url_selected_buyable = url_selected_buyable | strip -%}
    {%- if url_selected_buyable != 'true' -%}
      {%- assign buyable_fallback_variant = blank -%}
      {%- for variant in product.variants -%}
        {%- capture buyable_fallback_check -%}{%- render 'variant-buy-allowed', variant: variant -%}{%- endcapture -%}
        {%- assign buyable_fallback_check = buyable_fallback_check | strip -%}
        {%- if buyable_fallback_check == 'true' -%}
          {%- assign buyable_fallback_variant = variant -%}
          {%- break -%}
        {%- endif -%}
      {%- endfor -%}
      {%- if buyable_fallback_variant != blank and buyable_fallback_variant.id != url_selected_variant.id -%}
        <script>
          (function () {
            try {
              var url = new URL(window.location.href);
              url.searchParams.set('variant', {{ buyable_fallback_variant.id | json }});
              window.location.replace(url.toString());
            } catch (e) {}
          })();
        </script>
      {%- endif -%}
    {%- endif -%}
  {%- endif -%}
{%- endunless -%}

<div class="product-form" data-product-title="{{ product.title | escape }}">
  {%- for block in section.blocks -%}
    {%- case block.type -%}
        {%- comment -%}
          ----------------------------------------------------------------------------------------------------------------
          APP BLOCK TYPE
          ----------------------------------------------------------------------------------------------------------------
        {%- endcomment -%}
      {%- when '@app' -%}
        {%- render block -%}

      {%- when 'reviewsio_ratings_meta' -%}
        {%- render 'product-reviewsio-ratings-meta', product: product, block: block -%}

      {%- when 'cro_variant_info_text' -%}
        {%- if block.settings.option_name == blank or block.settings.option_name == null -%}
          <div
            data-block-type="pdp-variant-info-text"
            data-block-id="{{ block.id }}"
            class="pdp-variant-info-text-block"
            {{ block.shopify_attributes }}
          >
            {% render 'ed-cro-variant-info-text', product: product, block: block %}
          </div>
        {%- endif -%}
      {%- when 'cro_bulletpoints' -%}
        {% render 'ed-cro-bulletpoints', product: product, block: block %}

      {%- when 'cro_content_button' -%}
        {% render 'ed-cro-content-button', product: product, block: block %}

      {%- when 'cro_pdp_product_guarantee' -%}
        <div data-block-type="pdp-product-guarantee" data-block-id="{{ block.id }}" class="pdp-product-guarantee-block" {{ block.shopify_attributes }}>
        {% render 'ed-cro-pdp-product-guarantee', product: product, block: block, product_form_id: product_form_id %}
        </div>
      {%- when 'cro_limited_stock' -%}
        {% render 'ed-cro-limited-stock', product: product, block: block %}

      {%- when 'cro_sold_out_info' -%}
        {% render 'ed-cro-sold-out-info', product: product, block: block %}

        {%- comment -%}
          ----------------------------------------------------------------------------------------------------------------
          VARIANT PICKER BLOCK TYPE
          ----------------------------------------------------------------------------------------------------------------
        {%- endcomment -%}
      {%- when 'variant_picker' -%}
        {% if product.metafields.custom.custom_variants != blank %}
          <div class="custom_variants_wrapper">
            <h3 class="custom_variants_name">{{ product.metafields.custom.custom_variants_name }}</h3>
            <div class="products-as-variants__item_wrapper">
                {% for custom_variant in product.metafields.custom.custom_variants.value %}
                  <div class="products-as-variants__item block-swatch{% if product.url == custom_variant.url %} active{% endif %}">
                    <a class="products-as-variants__link" href="{{ custom_variant.url }}">
                      {%- if custom_variant.featured_media -%}
                        {{- custom_variant.featured_media | image_url: width: custom_variant.featured_media.width | image_tag: loading: 'lazy', sizes: '72px', widths: '72,144,216,288', class: 'custom_variant_image', alt: custom_variant.metafields.custom.kurzname_f_r_custom_variants -}}
                      {% else %}
                        {{ custom_variant.metafields.custom.kurzname_f_r_custom_variants }}
                      {%- endif -%}
                    </a>
                  </div>
                {% endfor %}
            </div>
          </div>
        {% endif %}
        {%- unless product.has_only_default_variant -%}
          {%- assign groessenfinder_button_text = block.settings.groessenfinder_button_text | default: 'Größentabelle' -%}
          {%- assign selected_variant = product.selected_or_first_available_variant -%}
          {%- assign has_groessenfinder_content = false -%}
          {%- if selected_variant.metafields.custom.groessentabelle_bild1 != blank
            or selected_variant.metafields.custom.groessentabelle_bild2 != blank
          -%}
            {%- assign has_groessenfinder_content = true -%}
          {%- endif -%}
          {%- assign cro_variant_info_block = null -%}
          {%- assign cro_variant_info_option_name = '' -%}
          {%- for bl in section.blocks -%}
            {%- if bl.type == 'cro_variant_info_text' -%}
              {%- assign cro_variant_info_block = bl -%}
              {%- assign cro_variant_info_option_name = bl.settings.option_name | strip | downcase -%}
              {%- break -%}
            {%- endif -%}
          {%- endfor -%}

          <variant-picker
            data-block-type="variant-picker"
            data-block-id="{{ section.id }}"
            handle="{{ product.handle }}"
            section-id="{{ section.id }}"
            form-id="{{ product_form_id }}"
            {% if update_url %}
              update-url
            {% endif %}
            {% if block.settings.hide_sold_out_variants %}
              hide-sold-out-variants
            {% endif %}
            class="product-form__variants"
            {{ block.shopify_attributes }}
          >
            {%- comment -%}
              The variant data is outputted as a JSON, which allows the theme to emit an event with the data when the variant changes. This must not be removed.
            {%- endcomment -%}
            <script data-variant type="application/json">
              {{- product.selected_or_first_available_variant | json -}}
            </script>

            {%- for option in product.options_with_values -%}
              {%- assign option_downcase = option.name | downcase -%}
              {%- capture option_id -%}option-{{ section.id }}-{{ template.suffix }}-{{ product.id }}-{{ forloop.index }}-{{ context }}{%- endcapture -%}

              {%- assign selector_type = block.settings.selector_mode -%}
              {%- assign variant_image_options = block.settings.variant_image_options
                | replace: ', ', ','
                | downcase
                | split: ','
              -%}

              {%- assign swatch_count = option.values | map: 'swatch' | compact | size -%}

              {%- if swatch_count > 0 and block.settings.color_mode == 'swatch' %}
                {%- assign selector_type = 'swatch' -%}
              {%- endif -%}

              {% if swatch_count == 0
                and color_label_list contains option_downcase
                and block.settings.color_mode != 'none'
              %}
                {%- assign selector_type = 'swatch' -%}
              {%- endif -%}

              {%- if variant_image_options contains option_downcase -%}
                {%- assign selector_type = 'variant_image' -%}
              {%- endif -%}

              <div
                class="product-form__option-selector"
                data-selector-type="{{ selector_type | replace: '_', '-' | escape }}"
              >
                <div class="product-form__option-info">
                  <div class="product-form__option-info-inner">
                    <span class="product-form__option-name ">
                      {{ option.name }}:
                      {%- assign option_name_normalized = option.name | strip | downcase -%}
                      {%- if cro_variant_info_option_name != blank
                        and option_name_normalized == cro_variant_info_option_name
                        and cro_variant_info_block
                      -%}
                        <span class="pdp-variant-info-text-inline">
                          {% render 'ed-cro-variant-info-text', product: product, block: cro_variant_info_block %}
                        </span>
                      {%- endif -%}
                    </span>

                    {%- if selector_type != 'dropdown' -%}
                      <span id="{{ option_id }}-value" class="product-form__option-value option--{{ forloop.index }}">
                        <span class="color-code-display">
                          {% comment %} <span class="color-code-display-box color-{{ option.selected_value | handleize }}"></span> {% endcomment %}
                          <span class="color-name">{{ option.selected_value }}</span>
                        </span>
                      </span>
                    {%- endif -%}
                  </div>

                  {%- if size_label_list contains option_downcase and groessenfinder_button_text != blank and has_groessenfinder_content -%}
                    <button
                      type="button"
                      class="product-form__option-link link hidden-phone"
                      data-groessenfinder-trigger
                    >
                      {{ groessenfinder_button_text }}
                    </button>
                    <div class="hidden-tablet-and-up">
                      <span class="product-form__option-link">{{ block.settings.size_chart_label_text_mobile }}</span>
                      <button
                        type="button"
                        class="product-form__option-link link hidden-tablet-and-up"
                        data-groessenfinder-trigger
                      >
                        {{ groessenfinder_button_text }}
                      </button>
                    </div>
                  {%- endif -%}
                </div>

                {%- case selector_type -%}
                  {%- when 'variant_image' -%}
                    <div class="variant-swatch-list">
                      {%- for value in option.values -%}
                        {%- capture apply_auslaufartikel_ui -%}{%- render 'variant-auslaufartikel-ui', variant: value.variant -%}{%- endcapture -%}
                        {%- assign apply_auslaufartikel_ui = apply_auslaufartikel_ui | strip -%}
                        {%- assign image = value.variant.featured_media
                          | default: value.variant.product.featured_media
                          | default: product.featured_media
                        -%}
                        {%- assign variant_swatch_label = value | strip_html | strip -%}

                        <div class="variant-swatch {% unless value.available %}is-disabled{% endunless %}{% if apply_auslaufartikel_ui == 'true' %} is-disabled is-discontinued{% endif %}">
                          {%- if value.product_url != blank -%}
                            {%- if value == option.selected_value -%}
                              <input
                                type="hidden"
                                form="{{ product_form_id }}"
                                data-option-position="{{ option.position }}"
                                name="option{{ option.position }}"
                                value="{{ value.id }}"
                              >
                            {%- endif -%}

                            {%- if apply_auslaufartikel_ui == 'true' -%}
                              <span
                                class="variant-swatch__item {% if value == option.selected_value %}is-selected{% endif %} is-discontinued"
                                aria-disabled="true"
                                title="{{ variant_swatch_label | escape }}"
                              >
                                <span class="visually-hidden">{{ value }}</span>

                                {{-
                                  image
                                  | image_url: width: 216
                                  | image_tag:
                                    loading: 'lazy',
                                    sizes: '(max-width: 740px) 64px, 72px',
                                    widths: '64,72,96,128,144,192,216',
                                    class: 'variant-swatch__image',
                                    alt: variant_swatch_label,
                                    title: variant_swatch_label
                                -}}
                              </span>
                            {%- else -%}
                              <a
                                href="{{ value.product_url }}"
                                class="variant-swatch__item {% if value == option.selected_value %}is-selected{% endif %}"
                                title="{{ variant_swatch_label | escape }}"
                              >
                                <span class="visually-hidden">{{ value }}</span>

                                {{-
                                  image
                                  | image_url: width: 216
                                  | image_tag:
                                    loading: 'lazy',
                                    sizes: '(max-width: 740px) 64px, 72px',
                                    widths: '64,72,96,128,144,192,216',
                                    class: 'variant-swatch__image',
                                    alt: variant_swatch_label,
                                    title: variant_swatch_label
                                -}}
                              </a>
                            {%- endif -%}
                          {%- else -%}
                            <input
                              class="variant-swatch__radio visually-hidden"
                              type="radio"
                              data-option-position="{{ option.position }}"
                              name="option{{ option.position }}"
                              form="{{ product_form_id }}"
                              id="{{ option_id }}-{{ forloop.index }}"
                              value="{{ value.id }}"
                              {% if value == option.selected_value %}
                                checked="checked"
                              {% endif %}
                              {% if apply_auslaufartikel_ui == 'true' %}
                                disabled
                              {% endif %}
                              aria-label="{{ value | escape }}"
                            >
                            <label class="variant-swatch__item{% if apply_auslaufartikel_ui == 'true' %} is-discontinued{% endif %}" for="{{ option_id }}-{{ forloop.index }}" title="{{ variant_swatch_label | escape }}">
                              <span class="visually-hidden">{{ value }}</span>

                              {{-
                                image
                                | image_url: width: 216
                                | image_tag:
                                  loading: 'lazy',
                                  sizes: '(max-width: 740px) 64px, 72px',
                                  widths: '64,72,96,128,144,192,216',
                                  class: 'variant-swatch__image',
                                  alt: variant_swatch_label,
                                  title: variant_swatch_label
                              -}}
                              {% comment %} <span class="variant-swatch__item-label">{{ value }}</span> {% endcomment %}
                            </label>
                          {%- endif -%}
                        </div>
                      {%- endfor -%}
                    </div>

                  {%- when 'swatch' -%}
                    <div class="color-swatch-list">
                      {%- assign color_swatch_config = settings.color_swatch_config
                        | newline_to_br
                        | split: '<br />'
                      -%}

                      {%- for value in option.values -%}
                        {%- capture apply_auslaufartikel_ui -%}{%- render 'variant-auslaufartikel-ui', variant: value.variant -%}{%- endcapture -%}
                        {%- assign apply_auslaufartikel_ui = apply_auslaufartikel_ui | strip -%}
                        {%- assign color_value_downcase = value | downcase -%}

                        <div class="color-swatch {% if color_white_label == color_value_downcase %}color-swatch--white{% endif %} {% unless value.available %}is-disabled{% endunless %}{% if apply_auslaufartikel_ui == 'true' %} is-disabled is-discontinued{% endif %}">
                          {%- if value.product_url != blank -%}
                            {%- if value == option.selected_value -%}
                              <input
                                type="hidden"
                                form="{{ product_form_id }}"
                                data-option-position="{{ option.position }}"
                                name="option{{ option.position }}"
                                value="{{ value.id }}"
                              >
                            {%- endif -%}

                            {%- if apply_auslaufartikel_ui == 'true' -%}
                              <span
                                class="color-swatch__item {% if value == option.selected_value %}is-selected{% endif %} is-discontinued"
                                style="{% render 'color-swatch-style', swatch: value.swatch, color_swatch_config: color_swatch_config, value: value %}"
                                aria-disabled="true"
                              >
                                <span class="visually-hidden">{{ value }}</span>
                              </span>
                            {%- else -%}
                              <a
                                href="{{ value.product_url }}"
                                class="color-swatch__item {% if value == option.selected_value %}is-selected{% endif %}"
                                style="{% render 'color-swatch-style', swatch: value.swatch, color_swatch_config: color_swatch_config, value: value %}"
                              >
                                <span class="visually-hidden">{{ value }}</span>
                              </a>
                            {%- endif -%}
                          {%- else -%}
                            <input
                              class="color-swatch__radio visually-hidden"
                              type="radio"
                              data-option-position="{{ option.position }}"
                              name="option{{ option.position }}"
                              form="{{ product_form_id }}"
                              id="{{ option_id }}-{{ forloop.index }}"
                              value="{{ value.id }}"
                              {% if value == option.selected_value %}
                                checked="checked"
                              {% endif %}
                              {% if apply_auslaufartikel_ui == 'true' %}
                                disabled
                              {% endif %}
                            >
                            <label
                              class="color-swatch__item{% if apply_auslaufartikel_ui == 'true' %} is-discontinued{% endif %}"
                              for="{{ option_id }}-{{ forloop.index }}"
                              style="{% render 'color-swatch-style', swatch: value.swatch, color_swatch_config: color_swatch_config, value: value %}"
                            >
                              <span class="visually-hidden">{{ value }}</span>
                            </label>
                          {%- endif -%}
                        </div>
                      {%- endfor -%}
                    </div>

                  {%- when 'block' -%}
                    <div class="block-swatch-list"{% if block.settings.gift_card_fixed_values != blank %} has-gift-card-fixed-values{% endif %}>
                      {%- for value in option.values -%}
                        {%- capture apply_auslaufartikel_ui -%}{%- render 'variant-auslaufartikel-ui', variant: value.variant -%}{%- endcapture -%}
                        {%- assign apply_auslaufartikel_ui = apply_auslaufartikel_ui | strip -%}
                        {% if block.settings.gift_card_fixed_values != blank %}
                          {% assign show_value = false %}
                          {% assign gift_card_fixed_values = block.settings.gift_card_fixed_values | split: ',' %}
                          {% for gift_card_fixed_value in gift_card_fixed_values %}
                            {% if value == gift_card_fixed_value %}
                              {% assign show_value = true %}
                              {% break %}
                            {% endif %}
                          {% endfor %}
                        {% else %}
                          {% assign show_value = true %}
                        {% endif %}
                      
                        <div class="block-swatch {% unless value.available %}is-disabled{% endunless %}{% if apply_auslaufartikel_ui == 'true' %} is-disabled is-discontinued{% endif %}" {% if show_value == false%}hidden{% endif %}>
                          {%- if value.product_url != blank -%}
                            {%- if value == option.selected_value -%}
                              <input
                                type="hidden"
                                form="{{ product_form_id }}"
                                data-option-position="{{ option.position }}"
                                name="option{{ option.position }}"
                                value="{{ value.id }}"
                              >
                            {%- endif -%}

                            {%- if apply_auslaufartikel_ui == 'true' -%}
                              <span
                                class="block-swatch__item {% if value == option.selected_value %}is-selected{% endif %} is-discontinued"
                                aria-disabled="true"
                              >
                                {{- value -}}
                              </span>
                            {%- else -%}
                              <a
                                href="{{ value.product_url }}"
                                class="block-swatch__item {% if value == option.selected_value %}is-selected{% endif %}"
                              >
                                {{- value -}}
                              </a>
                            {%- endif -%}
                          {%- else -%}
                            <input
                              class="block-swatch__radio visually-hidden"
                              type="radio"
                              data-option-position="{{ option.position }}"
                              name="option{{ option.position }}"
                              form="{{ product_form_id }}"
                              id="{{ option_id }}-{{ forloop.index }}"
                              value="{{ value.id }}"
                              data-option-value="{{ value }}"
                              {% if value == option.selected_value %}
                                checked="checked"
                              {% endif %}
                              {% if apply_auslaufartikel_ui == 'true' %}
                                disabled
                              {% endif %}
                            >
                            <label class="block-swatch__item{% if apply_auslaufartikel_ui == 'true' %} is-discontinued{% endif %}" for="{{ option_id }}-{{ forloop.index }}">
                              {{- value -}}
                            </label>
                          {%- endif -%}
                        </div>
                      {%- endfor -%}
                      {% if block.settings.gift_card_fixed_values != blank %}
                        {%- assign gift_card_fixed_values_arr = block.settings.gift_card_fixed_values | split: ',' -%}
                        {%- assign current_variant_title = product.selected_or_first_available_variant.title | strip -%}
                        {%- assign current_variant_amount = current_variant_title
                          | replace: '€', ''
                          | replace: 'EUR', ''
                          | replace: 'eur', ''
                          | replace: ',', '.'
                          | strip
                        -%}
                        {%- assign is_preset_variant = false -%}
                        {%- for fv in gift_card_fixed_values_arr -%}
                          {%- assign fv_stripped = fv
                            | replace: '€', ''
                            | replace: 'EUR', ''
                            | replace: 'eur', ''
                            | replace: ',', '.'
                            | strip
                          -%}
                          {%- if current_variant_amount == fv_stripped -%}
                            {%- assign is_preset_variant = true -%}
                            {%- break -%}
                          {%- endif -%}
                        {%- endfor -%}
                        <label class="block-swatch__variable-label">{{ block.settings.label_variable_gift_value }}</label>
                        <input id="variable-gift-card-value" type="number" class="block-swatch__variable-input{% unless is_preset_variant %} is-filled{% endunless %}" min="{{ block.settings.gift_card_min }}" max="{{ block.settings.gift_card_max }}" step="1"{% unless is_preset_variant %} value="{{ current_variant_amount }}"{% endunless %}>
                        <script>
                          if (!window.giftCardVariantMap) {
                            window.giftCardVariantMap = {};
                            window.giftCardFormId = {{ product_form_id | json }};
                            {%- for option in product.options_with_values -%}
                              {% for value in option.values %}
                                {%- assign opt_amt = value | strip | replace: ' €', '' | replace: '€', '' | replace: ' EUR', '' | replace: ',', '.' | strip -%}
                                window.giftCardVariantMap[{{ opt_amt | json }}] = { id: {{ value.variant.id }}, sku: {{ value.variant.sku | json }}, available: {{ value.variant.available }}, price: {{ value.variant.price | money | json }} };
                              {% endfor %}
                            {% endfor %}
                          }
                        </script>
                      {% endif %}
                    </div>

                  {%- when 'dropdown' -%}
                    <div class="select-wrapper">
                      <combo-box
                        initial-focus-selector="[aria-selected='true']"
                        id="{{ option_id }}-combo-box"
                        class="combo-box"
                      >
                        <span class="combo-box__overlay"></span>

                        <header class="combo-box__header">
                          <p class="combo-box__title heading h6">{{ option.name }}</p>

                          <button
                            type="button"
                            class="combo-box__close-button tap-area"
                            data-action="close"
                            title="{{ 'general.accessibility.close' | t | escape }}"
                          >
                            {%- render 'icon' with 'close' -%}
                          </button>
                        </header>

                        <div class="combo-box__option-list" role="listbox">
                          {%- for value in option.values -%}
                            {%- capture apply_auslaufartikel_ui -%}{%- render 'variant-auslaufartikel-ui', variant: value.variant -%}{%- endcapture -%}
                            {%- assign apply_auslaufartikel_ui = apply_auslaufartikel_ui | strip -%}
                            {%- if value.product_url != blank -%}
                              {%- if value == option.selected_value -%}
                                <input
                                  type="hidden"
                                  form="{{ product_form_id }}"
                                  data-option-position="{{ option.position }}"
                                  name="option{{ option.position }}"
                                  value="{{ value.id }}"
                                >
                              {%- endif -%}

                              {%- if apply_auslaufartikel_ui == 'true' -%}
                                <span
                                  aria-selected="{% if value == option.selected_value %}true{% else %}false{% endif %}"
                                  class="combo-box__option-item is-disabled is-discontinued"
                                  aria-disabled="true"
                                >
                                  {{- value -}}
                                </span>
                              {%- else -%}
                                <a
                                  href="{{ value.product_url }}"
                                  aria-selected="{% if value == option.selected_value %}true{% else %}false{% endif %}"
                                  class="combo-box__option-item {% if value.available == false %}is-disabled{% endif %}"
                                >
                                  {{- value -}}
                                </a>
                              {%- endif -%}
                            {%- else -%}
                              <button
                                type="button"
                                role="option"
                                class="combo-box__option-item {% if value.available == false %}is-disabled{% endif %}{% if apply_auslaufartikel_ui == 'true' %} is-disabled is-discontinued{% endif %}"
                                value="{{ value.id }}"
                                aria-selected="{% if value == option.selected_value %}true{% else %}false{% endif %}"
                                {% if apply_auslaufartikel_ui == 'true' %}
                                  disabled
                                  aria-disabled="true"
                                {% endif %}
                              >
                                {{ value }}
                              </button>
                            {%- endif -%}
                          {%- endfor -%}
                        </div>

                        <input
                          type="hidden"
                          data-option-position="{{ option.position }}"
                          name="option{{ option.position }}"
                          form="{{ product_form_id }}"
                          value="{{ option.selected_value.id }}"
                          aria-label="{{ option.name | escape }}"
                        >
                      </combo-box>

                      <button
                        type="button"
                        is="toggle-button"
                        class="select"
                        aria-expanded="false"
                        aria-haspopup="listbox"
                        aria-controls="{{ option_id }}-combo-box"
                      >
                        <span id="{{ option_id }}-value" class="select__selected-value">
                          {{- option.selected_value -}}
                        </span>
                        {%- render 'icon' with 'chevron' -%}
                      </button>
                    </div>
                {%- endcase -%}
              </div>
            {%- endfor -%}

            <noscript>
              <label class="input__block-label" for="product-select-{{ section.id }}-{{ product.id }}">
                {{- 'product.form.variant' | t -}}
              </label>

              <div class="select-wrapper">
                <select
                  class="select"
                  autocomplete="off"
                  id="product-select-{{ section.id }}-{{ product.id }}"
                  name="id"
                  form="{{ product_form_id }}"
                >
                  {%- for variant in product.variants -%}
                    <option
                      {% if variant == product.selected_or_first_available_variant %}
                        selected="selected"
                      {% endif %}
                      {% unless variant.available %}
                        disabled="disabled"
                      {% endunless %}
                      value="{{ variant.id }}"
                      data-sku="{{ variant.sku }}"
                    >
                      {{ variant.title }} - {{ variant.price | money_without_currency -}}
                      {{-
                        shop.currency
                        | replace: 'EUR', '€'
                        | replace: 'eur', '€'
                        | replace: 'USD', '$'
                        | replace: 'usd', '$'
                      }}
                    </option>
                  {%- endfor -%}
                </select>

                {%- render 'icon' with 'chevron' -%}
              </div>
            </noscript>
          </variant-picker>
        {%- endunless -%}

