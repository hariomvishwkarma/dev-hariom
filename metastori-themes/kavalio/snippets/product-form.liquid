                    aria-controls="product-{{ section.id }}-{{ product.id }}-shipment-popover"
                    aria-expanded="false"
                  >
                    {{ 'product.general.shipment' | t }}
                  </button>
                {%- endif -%}
              </div>
            </div>
          {%- endif -%}
          </div>
        </div>


