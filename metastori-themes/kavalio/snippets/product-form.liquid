        <product-payment-terms data-block-type="payment-terms" data-block-id="{{ section.id }}">
          {%- assign product_installment_form_id = 'product-installment-form-'
            | append: section.id
            | append: '-'
            | append: product.id
          -%}

          {%- form 'product', product, id: product_installment_form_id -%}
            <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">
            {{- form | payment_terms -}}
          {%- endform -%}
        </product-payment-terms>

        {%- comment -%}
          ----------------------------------------------------------------------------------------------------------------
          LINE ITEM PROPERTY
          ----------------------------------------------------------------------------------------------------------------
        {%- endcomment -%}
      {%- when 'line_item_property' -%}
        {%- if block.settings.label != blank -%}
          {%- case block.settings.type -%}
            {%- when 'text' -%}
              {%- if block.settings.allow_long_text -%}
                <div class="product-form__line-item-property" {{ block.shopify_attributes }}>
                  <label class="input__block-label" for="line-item-{{ section.id }}-{{ block.id }}">
                    {{- block.settings.label | escape }}:</label
                  >
                  <textarea
                    {% if block.settings.required %}
                      required
                    {% endif %}
                    id="line-item-{{ section.id }}-{{ block.id }}"
                    form="{{ product_form_id }}"
                    class="input__field input__field--textarea"
                    name="properties[{{ block.settings.label | escape }}]"
                  ></textarea>
                </div>
              {% else %}
                <div class="product-form__line-item-property" {{ block.shopify_attributes }}>
                  <label class="input__block-label" for="line-item-{{ section.id }}-{{ block.id }}">
                    {{- block.settings.label | escape }}:</label
                  >
                  <input
                    {% if block.settings.required %}
                      required
                    {% endif %}
                    id="line-item-{{ section.id }}-{{ block.id }}"
                    form="{{ product_form_id }}"
                    type="text"
                    class="input__field"
                    name="properties[{{ block.settings.label | escape }}]"
                  >
                </div>
              {%- endif -%}

            {%- when 'checkbox' -%}
              <div class="product-form__line-item-property" {{ block.shopify_attributes }}>
                <div class="checkbox-container">
                  <input
                    type="hidden"
                    form="{{ product_form_id }}"
                    class="checkbox"
                    name="properties[{{ block.settings.label | escape }}]"
                    value="{{ block.settings.unchecked_value | escape }}"
                  >
                  <input
                    type="checkbox"
                    form="{{ product_form_id }}"
                    class="checkbox"
                    name="properties[{{ block.settings.label | escape }}]"
                    id="line-item-{{ section.id }}-{{ block.id }}"
                    value="{{ block.settings.checked_value | escape }}"
                  >
                  <label for="line-item-{{ section.id }}-{{ block.id }}">{{ block.settings.label | escape }}</label>
                </div>
              </div>
          {%- endcase -%}
        {%- endif -%}

        {%- comment -%}
          ----------------------------------------------------------------------------------------------------------------
          TEXT
          ----------------------------------------------------------------------------------------------------------------
        {%- endcomment -%}
      {%- when 'text' -%}
        {% if block.settings.text != blank %}
          <div class="product-form__text" {{ block.shopify_attributes }}>
            {{- block.settings.text -}}
          </div>
        {%- endif -%}

        {%- comment -%}
          ----------------------------------------------------------------------------------------------------------------
          IMAGE
          ----------------------------------------------------------------------------------------------------------------
        {%- endcomment -%}
      {%- when 'image' -%}
        {% if block.settings.image != blank and context != 'quick-buy' %}
          <div
            class="product-form__image product-form__image--{{ block.settings.image_alignment }}"
            {{ block.shopify_attributes }}
          >
            {%- capture image_sizes -%}{{ block.settings.image_width }}, {{ block.settings.image_width | times: 2 }}, {{ block.settings.image_width | times: 3 }}{%- endcapture -%}
            {%- capture sizes_attribute -%}{{ block.settings.image_width }}px{%- endcapture -%}
            {%- capture style_attribute -%}max-width: {{ block.settings.image_width }}px{%- endcapture -%}
            {{-
              block.settings.image
              | image_url: width: block.settings.image.width
              | image_tag: loading: 'lazy', sizes: sizes_attribute, widths: image_sizes, style: style_attribute
            -}}
          </div>
        {%- endif -%}

        {%- comment -%}
          ----------------------------------------------------------------------------------------------------------------
          BUTTON
          ----------------------------------------------------------------------------------------------------------------
        {%- endcomment -%}
      {%- when 'button' -%}
        {% if block.settings.link != blank and block.settings.text != blank and context != 'quick-buy' %}
          <div class="product-form__button" {{ block.shopify_attributes }}>
            {%- if block.settings.background == 'rgba(0,0,0,0)' -%}
              {%- assign button_background = settings.primary_button_background -%}
            {%- else -%}
              {%- assign button_background = block.settings.background -%}
            {%- endif -%}

            {%- if block.settings.text_color == 'rgba(0,0,0,0)' -%}
              {%- assign button_text_color = settings.primary_button_text_color -%}
            {%- else -%}
              {%- assign button_text_color = block.settings.text_color -%}
            {%- endif -%}

            {%- capture button_background_rgb -%}{{ button_background.red }}, {{ button_background.green }}, {{ button_background.blue }}{%- endcapture -%}
            {%- capture button_text_color_rgb -%}{{ button_text_color.red }}, {{ button_text_color.green }}, {{ button_text_color.blue }}{%- endcapture -%}

            <a
              href="{{ block.settings.link }}"
              class="button button--primary {% if block.settings.stretch %}button--full{% endif %}"
              style="--primary-button-background: {{ button_background_rgb }}; --primary-button-text-color: {{ button_text_color_rgb }}"
            >
              {{- block.settings.text | escape -}}
            </a>
          </div>
        {%- endif -%}

        {%- comment -%}
          ----------------------------------------------------------------------------------------------------------------
          CUSTOM LIQUID
          ----------------------------------------------------------------------------------------------------------------
        {%- endcomment -%}
      {%- when 'liquid' -%}
        <div data-block-type="liquid" data-block-id="{{ block.id }}" {{ block.shopify_attributes }}>
          {% if block.settings.liquid != blank %}
            <div class="product-form__custom-liquid">
              {{- block.settings.liquid -}}
            </div>
          {%- endif -%}
        </div>

        {%- comment -%}
          ----------------------------------------------------------------------------------------------------------------
          VOLUME PRICING TABLE
          ----------------------------------------------------------------------------------------------------------------
        {%- endcomment -%}

      {%- when 'volume_pricing' -%}
        <div data-block-type="volume-pricing" data-block-id="{{ block.id }}" {{ block.shopify_attributes }}>
          {%- render 'volume-pricing-table', variant: product.selected_or_first_available_variant -%}
        </div>

        {%- comment -%}
          ----------------------------------------------------------------------------------------------------------------
          PRODUCT DESCRIPTION
          ----------------------------------------------------------------------------------------------------------------
        {%- endcomment -%}
      {%- when 'description' -%}
        {%- if product.description != blank and context != 'quick-buy' and block.settings.show_inline_description -%}
          <div class="product-form__description rte" {{ block.shopify_attributes }}>
            {{- product.description -}}
          </div>
        {%- endif -%}

        {%- comment -%}
          ----------------------------------------------------------------------------------------------------------------
          INVENTORY
          ----------------------------------------------------------------------------------------------------------------
        {%- endcomment -%}
      {%- when 'inventory' -%}
        {% render 'inventory', block: block, section: section, product: product, product_form_id: product_form_id %}
        {% comment %}
          {%- if product.template_suffix != 'pre-order' -%}
            <div data-block-type="inventory" data-block-id="{{ block.id }}" {{ block.shopify_attributes }}>
              {%- if product.selected_or_first_available_variant.available or product.selected_or_first_available_variant.incoming -%}
                <product-inventory class="product-form__inventory-wrapper">
                  {%- if product.selected_or_first_available_variant.available -%}
                    {%- if product.selected_or_first_available_variant.inventory_management and product.selected_or_first_available_variant.inventory_policy == 'deny' and product.selected_or_first_available_variant.inventory_quantity <= block.settings.low_inventory_threshold and block.settings.low_inventory_threshold > 0 -%}
                      <span class="inventory inventory--low">{{ 'product.form.low_stock_with_quantity_count' | t: count: product.selected_or_first_available_variant.inventory_quantity }}</span>
                    {%- else -%}
                      {%- if product.selected_or_first_available_variant.inventory_policy == 'continue' and product.selected_or_first_available_variant.inventory_quantity <= 0 and product.selected_or_first_available_variant.requires_shipping -%}
                        {%- if product.selected_or_first_available_variant.incoming and product.selected_or_first_available_variant.next_incoming_date -%}
                          {%- capture next_incoming_date -%}{{ product.selected_or_first_available_variant.next_incoming_date | date: format: 'date' }}{%- endcapture -%}
                          <span class="inventory inventory--low">{{ 'product.form.incoming_stock' | t: next_incoming_date: next_incoming_date }}</span>
                        {%- else -%}
                          <span class="inventory inventory--low">{{ 'product.form.oversell_stock' | t }}</span>
                        {%- endif -%}
                      {%- else -%}
                        <span class="inventory inventory--high">{{ 'product.form.in_stock' | t }}</span>
                      {%- endif -%}
                    {%- endif -%}
                  {%- elsif product.selected_or_first_available_variant.incoming -%}
                    {%- if product.selected_or_first_available_variant.next_incoming_date -%}
                      {%- capture next_incoming_date -%}{{ product.selected_or_first_available_variant.next_incoming_date | date: format: 'date' }}{%- endcapture -%}
                      <span class="inventory inventory--low">{{ 'product.form.incoming_stock' | t: next_incoming_date: next_incoming_date }}</span>
                    {%- else -%}
                      <span class="inventory inventory--low">{{ 'product.form.oversell_stock' | t }}</span>
                    {%- endif -%}
                  {%- endif -%}
                </product-inventory>
              {%- endif -%}
            </div>
          {%- endif -%}
        {% endcomment %}

        {%- comment -%}
          ----------------------------------------------------------------------------------------------------------------
          BUY BUTTONS
          ----------------------------------------------------------------------------------------------------------------
        {%- endcomment -%}
      {%- when 'buy_buttons' -%}
        {%- if request.page_type != 'password' -%}
          {%- assign recipient_feature_active = false -%}
          {%- assign selected_variant = product.selected_or_first_available_variant -%}
          {%- capture selected_variant_buy_allowed_str -%}{%- render 'variant-buy-allowed', variant: selected_variant -%}{%- endcapture -%}
          {%- assign selected_variant_buy_allowed_str = selected_variant_buy_allowed_str | strip -%}
          {%- assign selected_variant_buy_allowed = false -%}
          {%- if selected_variant_buy_allowed_str == 'true' -%}
            {%- assign selected_variant_buy_allowed = true -%}
          {%- endif -%}
          {%- capture selected_variant_is_auslaufartikel_str -%}{%- render 'variant-is-auslaufartikel-tag', variant: selected_variant -%}{%- endcapture -%}
          {%- assign selected_variant_is_auslaufartikel_str = selected_variant_is_auslaufartikel_str | strip -%}
          {%- assign selected_variant_is_auslaufartikel = false -%}
          {%- if selected_variant_is_auslaufartikel_str == 'true' -%}
            {%- assign selected_variant_is_auslaufartikel = true -%}
          {%- endif -%}
          {%- assign selected_variant_back_in_stock_eligible = false -%}
          {%- if selected_variant_buy_allowed == false and selected_variant_is_auslaufartikel == false -%}
            {%- assign selected_variant_back_in_stock_eligible = true -%}
          {%- endif -%}

          {%- if product.gift_card? and block.settings.show_gift_card_recipient -%}
            {%- assign recipient_feature_active = true -%}
          {%- endif -%}

          <div
            data-block-type="buy-buttons"
            data-block-id="{{ block.id }}"
            class="product-form__buy-buttons"
            {{ block.shopify_attributes }}
          >
            {%- if is_kavalio_care and kavalio_in_cart -%}
              <button
                type="button"
                class="product-form__add-button button button--small button--ternary button--full"
                disabled
              >
                Bereits im Warenkorb
              </button>
            {%- else -%}
              {%- form 'product', product, is: 'product-form', id: product_form_id -%}
                {%- if product.gift_card? -%}
                  <input type="hidden" name="properties[_kavalio_gift_card_template]" value="1">
                {%- endif -%}
                {%- assign kav_checkout_days = '1-2' -%}
                {%- for kav_blk in section.blocks -%}
                  {%- if kav_blk.type == 'inventory' -%}
                    {%- assign kav_checkout_days = kav_blk.settings.text_in_stock -%}
                    {%- break -%}
                  {%- endif -%}
                {%- endfor -%}
                {% render 'kavalio-delivery-checkout-properties',
                  product: product,
                  product_form_id: product_form_id,
                  text_in_stock: kav_checkout_days,
                  render_delivery_script: false,
                  render_hidden_inputs: true
                %}
                <script type="application/json" data-shop-location-quantity-max-map>
                  {
                    {%- for variant in product.variants -%}
                      {%- capture variant_max_qty -%}
                        {%- render 'shop-location-quantity-max', variant: variant -%}
                      {%- endcapture -%}
                      {%- assign variant_max_qty = variant_max_qty | strip -%}
                      "{{ variant.id }}":{% if variant_max_qty != blank %}{{ variant_max_qty }}{% else %}null{% endif %}{% unless forloop.last %},{% endunless %}
                    {%- endfor -%}
                  }
                </script>
                <script type="application/json" data-variant-availability-map>
                  {
                    {%- for variant in product.variants -%}
                      {%- capture variant_buy_allowed_str -%}{%- render 'variant-buy-allowed', variant: variant -%}{%- endcapture -%}
                      {%- assign variant_buy_allowed_str = variant_buy_allowed_str | strip -%}
                      {%- assign variant_buy_allowed = false -%}
                      {%- if variant_buy_allowed_str == 'true' -%}
                        {%- assign variant_buy_allowed = true -%}
                      {%- endif -%}
                      {%- assign variant_plenty_tags_raw = variant.metafields.custom.plenty_tags.value
                        | default: variant.metafields.custom.plenty_tags
                      -%}
                      {%- assign variant_plenty_tags_json = variant_plenty_tags_raw | json | downcase -%}
                      {%- assign variant_is_auslaufartikel = false -%}
                      {%- if variant_plenty_tags_json contains 'auslaufartikel' -%}
                        {%- assign variant_is_auslaufartikel = true -%}
                      {%- endif -%}
                      {%- assign variant_back_in_stock_eligible = false -%}
                      {%- if variant_buy_allowed == false and variant_is_auslaufartikel == false -%}
                        {%- assign variant_back_in_stock_eligible = true -%}
                      {%- endif -%}
                      "{{ variant.id }}":{"canBuy":{{ variant_buy_allowed | json }},"backInStockEligible":{{ variant_back_in_stock_eligible | json }}}{% unless forloop.last %},{% endunless %}
                    {%- endfor -%}
                  }
                </script>
                <script type="application/json" data-variant-option-values-map>
                  [
                    {%- for variant in product.variants -%}
                      {
                        "id": {{ variant.id | json }},
                        "optionValues": [
                          {%- for option in product.options_with_values -%}
                            {%- assign matched_option_value_id = blank -%}
                            {%- for value in option.values -%}
                              {%- if option.position == 1 and value == variant.option1 -%}
                                {%- assign matched_option_value_id = value.id -%}
                              {%- elsif option.position == 2 and value == variant.option2 -%}
                                {%- assign matched_option_value_id = value.id -%}
                              {%- elsif option.position == 3 and value == variant.option3 -%}
                                {%- assign matched_option_value_id = value.id -%}
                              {%- endif -%}
                            {%- endfor -%}
                            {{ matched_option_value_id | json }}{% unless forloop.last %},{% endunless %}
                          {%- endfor -%}
                        ]
                      }{% unless forloop.last %},{% endunless %}
                    {%- endfor -%}
                  ]
                </script>
                {%- if recipient_feature_active -%}
                  <gift-card-recipient class="gift-card-recipient">
                    <div class="input input--checkbox">
                      <div class="checkbox-container">
                        <input
                          type="checkbox"
                          class="checkbox"
                          name="properties[__shopify_send_gift_card_to_recipient]"
                          id="product-{{ section.id }}-{{ product.id }}-send-gift-card-to-recipient"
                        >
                        <label
                          for="product-{{ section.id }}-{{ product.id }}-send-gift-card-to-recipient"
                          class="text--subdued"
                        >
                          {{- 'gift_card.recipient.checkbox' | t -}}
                        </label>
                      </div>
                    </div>

                    <div class="gift-card-recipient__fields js:hidden">
                      <div class="input">
                        <input
                          id="product-{{ section.id }}-{{ product.id }}-recipient-email"
                          type="email"
                          class="input__field input__field--text"
                          name="properties[Recipient email]"
                          maxlength="138"
                          required
                          value="{{ form.email }}"
                        >
                        <label for="product-{{ section.id }}-{{ product.id }}-recipient-email" class="input__label">
                          {{- 'gift_card.recipient.email_label' | t -}}
                        </label>
                      </div>

                      <div class="input">
                        <input
                          id="product-{{ section.id }}-{{ product.id }}-recipient-name"
                          type="text"
                          class="input__field input__field--text"
                          name="properties[Recipient name]"
                          value="{{ form.name }}"
                        >
                        <label for="product-{{ section.id }}-{{ product.id }}-recipient-name" class="input__label">
                          {{- 'gift_card.recipient.name_label' | t -}}
                        </label>
                      </div>

                      <div class="input">
                        <input type="hidden" name="properties[__shopify_offset]" value="" disabled>
                        <input
                          id="product-{{ section.id }}-{{ product.id }}-send-on"
                          type="date"
                          class="input__field input__field--text"
                          pattern="\d{4}-\d{2}-\d{2}"
                          name="properties[Send on]"
                          value="{{ form.send_on }}"
                        >
                        <label for="product-{{ section.id }}-{{ product.id }}-send-on" class="input__label">
                          {{- 'gift_card.recipient.send_on_label' | t -}}
                        </label>
                      </div>

                      <div class="input">
                        <textarea
                          id="product-{{ section.id }}-{{ product.id }}-recipient-message"
                          rows="4"
                          maxlength="200"
                          class="input__field input__field--textarea"
                          name="properties[Message]"
                        >{{ form.message }}</textarea>
                        <label for="product-{{ section.id }}-{{ product.id }}-recipient-message" class="input__label">
                          {{- 'gift_card.recipient.message_label' | t -}}
                        </label>
                      </div>
                    </div>
                  </gift-card-recipient>
                {%- endif -%}

                <input type="hidden" disabled name="id" value="{{ product.selected_or_first_available_variant.id }}">

                <div
                  class="addToCart_and_quantity_wrap{% if context != 'quick-buy' %}{% unless selected_variant_buy_allowed %} is-hidden{% endunless %}{% endif %}"
                  {% if context != 'quick-buy' %}
                    data-product-purchase-actions
                  {% endif %}
                >
                  <p
                    class="product-form__shop-location-notice text--small"
                    data-shop-location-quantity-notice
                    hidden
                    role="alert"
                  ></p>

                  <div class="product-form__atc-row">
                  <product-payment-container
                    {% if update_url %}
                      id="MainPaymentContainer"
                    {% endif %}
                    class="product-form__payment-container"
                    {{ block.shopify_attributes }}
                  >
                      <button
                        id="AddToCart"
                        type="submit"
                        is="loader-button"
                        {% unless block.settings.show_payment_button and template.suffix != 'quick-buy-popover' %}
                          data-use-primary
                        {% endunless %}
                        data-product-add-to-cart-button
                        data-button-content="{% if product.template_suffix == 'pre-order' %}{{ 'product.form.pre_order' | t | escape }}{% else %}{{ 'product.form.add_to_cart' | t | escape }}{% endif %}"
                        class="product-form__add-button button button--small {% unless selected_variant_buy_allowed %}button--ternary{% else %}{% if block.settings.show_payment_button and template.suffix != 'quick-buy-popover' %}button--secondary{% else %}button--primary{% endif %}{% endunless %} button--full"
                        {% unless selected_variant_buy_allowed %}
                          disabled
                        {% endunless %}
                      >
                        {% render 'icon' with 'atc-cart' %}
                        {%- if selected_variant == null -%}
                          {{- 'product.form.unavailable' | t -}}
                        {%- elsif selected_variant_buy_allowed -%}
                          {%- if product.template_suffix == 'pre-order' -%}
                            {{- 'product.form.pre_order' | t -}}
                          {%- else -%}
                            <span class="hidden-pocket">{{- 'product.form.add_to_cart' | t -}}</span>
                            <span class="hidden-lap-and-up">{{- 'product.form.add_to_cart_short' | t -}}</span>
                          {%- endif -%}
                        {%- else -%}
                          {{- 'product.form.sold_out' | t -}}
                        {%- endif -%}
                      </button>

                    {%- if block.settings.show_payment_button
                      and recipient_feature_active == false
                      and template.suffix != 'quick-buy-popover'
                    -%}
                      {{ form | payment_button }}

                      {%- unless selected_variant_buy_allowed -%}
                        <style>
                          #shopify-section-{{ section.id }} .shopify-payment-button {
                            display: none;
                          }
                        </style>
                      {%- endunless -%}
                    {%- endif -%}
                  </product-payment-container>

                  {%- if request.page_type != 'password' and product.available -%}
                    <div
                      data-block-type="quantity-selector"
                      data-block-id="{{ block.id }}"
                      class="product-form__quantity"
                      {{ block.shopify_attributes }}
                    >
                      {% comment %} <span class="product-form__quantity-label">{{ 'product.form.quantity' | t }}:</span> {% endcomment %}

                      <quantity-selector class="quantity-selector">
                        <button type="button" class="quantity-selector__button">
                          <span class="visually-hidden">{{ 'cart.general.decrease_quantity' | t }}</span>
                          {%- render 'icon' with 'minus-big' -%}
                        </button>

                        <input
                          type="number"
                          form="{{ product_form_id }}"
                          is="input-number"
                          class="quantity-selector__input"
                          inputmode="numeric"
                          name="quantity"
                          autocomplete="off"
                          value="{% if is_kavalio_care %}1{% else %}{{ product.selected_or_first_available_variant.quantity_rule.min | default: 1 }}{% endif %}"
                          step="{{ product.selected_or_first_available_variant.quantity_rule.increment }}"
                          min="{% if is_kavalio_care %}1{% else %}{{ product.selected_or_first_available_variant.quantity_rule.min }}{% endif %}"
                          {% if is_kavalio_care %}
                            max="1"
                          {% else %}
                            {%- capture selected_max_qty -%}
                              {%- render 'shop-location-quantity-max', variant: product.selected_or_first_available_variant, subtract_cart_qty: true -%}
                            {%- endcapture -%}
                            {%- assign selected_max_qty = selected_max_qty | strip -%}
                            {% if selected_max_qty != blank %}
                              max="{{ selected_max_qty }}"
                            {% elsif product.selected_or_first_available_variant.quantity_rule.max != null %}
                              max="{{ product.selected_or_first_available_variant.quantity_rule.max }}"
                            {% endif %}
                          {% endif %}
                          aria-label="{{ 'product.form.quantity' | t | escape }}"
                        >

                        <button type="button" class="quantity-selector__button">
                          <span class="visually-hidden">{{ 'cart.general.increase_quantity' | t }}</span>
                          {%- render 'icon' with 'plus-big' -%}
                        </button>
                      </quantity-selector>

                      {%- liquid
                        assign variant = product.selected_or_first_available_variant
                        assign quantity_rules = ''

                        if variant.quantity_rule.min > 1
                          assign rule = 'product.quantity.minimum_of' | t: min: variant.quantity_rule.min
                          assign quantity_rules = quantity_rules | append: ' / ' | append: rule
                        endif

                        if variant.quantity_rule.max != null
                          assign rule = 'product.quantity.maximum_of' | t: max: variant.quantity_rule.max
                          assign quantity_rules = quantity_rules | append: ' / ' | append: rule
                        endif

                        if variant.quantity_rule.increment > 1
                          assign rule = 'product.quantity.increment_of' | t: step: variant.quantity_rule.increment
                          assign quantity_rules = quantity_rules | append: ' / ' | append: rule
                        endif
                      -%}

                      {%- if quantity_rules != blank -%}
                        <p class="product-form__quantity-rules text--subdued text--small">
                          {{ quantity_rules | remove_first: ' / ' | capitalize }}
                        </p>
                      {%- endif -%}
                    </div>
                  {%- endif -%}
                  </div>
                </div>
              {%- endform -%}

              {%- if context != 'quick-buy' -%}
                <div
                  class="product-form__back-in-stock{% if selected_variant_buy_allowed or selected_variant_back_in_stock_eligible == false %} is-hidden{% endif %}"
                  data-klaviyo-back-in-stock
                  data-form-id="{{ product_form_id }}"
                  aria-hidden="{% if selected_variant_buy_allowed or selected_variant_back_in_stock_eligible == false %}true{% else %}false{% endif %}"
                >
                  <div class="klaviyo-form-TeJdRt"></div>
                </div>
              {%- endif -%}
            {%- endif -%}
          </div>

          <div class="ed-payment-bar-pdp">
            {% render 'ed-payment-bar' %}

            {% if settings.show_rate_payment_pdp %}
              {% render 'ed-klarna-custom-payment' %}
            {% endif %}
          </div>

          {% render 'ed-atc-shop-benefits', section: section, block: block %}
          {% render 'piktogramme', section: section %}
        {%- endif -%}

        {%- if context != 'quick-buy' -%}
          <store-pickup
            data-block-type="pickup-availability"
            data-block-id="{{ block.id }}"
            class="product-form__store-availability-container"
          >
            {%- render 'store-availability', product_variant: product.selected_or_first_available_variant -%}
          </store-pickup>
        {%- endif -%}
    {%- endcase -%}
  {%- endfor -%}

  {%- comment -%}
    IMPLEMENTATION NOTE: under rare circumstances, merchant may want to show selectors but hide the add to cart button. This
    is however problematic as elements changed based on this. So if we detect there is no buy buttons block, we add an empty one
  {%- endcomment -%}

  {%- assign buy_buttons_block = section.blocks | where: 'type', 'buy_buttons' | first -%}

  {%- if buy_buttons_block == blank -%}
    {%- form 'product', product, is: 'product-form', id: product_form_id -%}
      <input type="hidden" disabled name="id" value="{{ product.selected_or_first_available_variant.id }}">
    {%- endform -%}
  {%- endif -%}
</div>

{%- if shipment_details_page != blank -%}
  {%- comment -%}Drawer is for tablet and desktop{%- endcomment -%}
  <drawer-content
    id="product-{{ section.id }}-{{ product.id }}-shipment-drawer"
    class="drawer drawer--large hidden-phone"
  >
    <span class="drawer__overlay"></span>

    <header class="drawer__header">
      <p class="drawer__title heading h6">{{ shipment_details_page.title }}</p>

      <button
        type="button"
        class="drawer__close-button tap-area"
        data-action="close"
        title="{{ 'general.accessibility.close' | t | escape }}"
      >
        {%- render 'icon' with 'close' -%}
      </button>
    </header>

    <div class="drawer__content drawer__content--padded-start">
      <div class="rte">
        {{- shipment_details_page.content -}}
      </div>
    </div>
  </drawer-content>

  {%- comment -%}Popover is for mobile{%- endcomment -%}
  <popover-content id="product-{{ section.id }}-{{ product.id }}-shipment-popover" class="popover hidden-lap-and-up">
    <span class="popover__overlay"></span>

    <header class="popover__header">
      <p class="popover__title heading h6">{{ shipment_details_page.title }}</p>

      <button
        type="button"
        class="popover__close-button tap-area tap-area--large"
        data-action="close"
        title="{{ 'general.accessibility.close' | t | escape }}"
      >
        {%- render 'icon' with 'close' -%}
      </button>
    </header>

    <div class="popover__content">
      <div class="rte">
        {{- shipment_details_page.content -}}
      </div>
    </div>
  </popover-content>
{%- endif -%}

<script>
  // Größenfinder code
  (function () {
    function closeOpenMobileTabs(exceptWrapper) {
      var openMobileToggles = document.querySelectorAll(
        '#product__content .collapsible-toggle[aria-controls][aria-expanded="true"]'
      );

      for (var j = 0; j < openMobileToggles.length; j++) {
        var openToggle = openMobileToggles[j];
        if (exceptWrapper && exceptWrapper.contains(openToggle)) continue;
        openToggle.click();
      }
    }

    function openProductContentTab(type) {
      var navSelector = type === 'description' ? '[data-description-nav]' : '[data-groessenfinder-nav]';
      var mobileWrapperSelector = type === 'description' ? '[data-description-tab]' : '[data-groessenfinder-tab]';
      var triggerButtons = document.querySelectorAll(navSelector);
      var activatedDesktopTab = false;

      if (triggerButtons.length) {
        for (var i = 0; i < triggerButtons.length; i++) {
          var btn = triggerButtons[i];
          if (btn.style.display === 'none') continue;
          if (btn.getAttribute('aria-expanded') !== 'true') {
            btn.click();
          }
          activatedDesktopTab = true;
          break;
        }
      }

      // Ensure the Größenfinder is visible.
      if (window.matchMedia('(max-width: 999px)').matches) {
        var mobileTabWrapper = document.querySelector(mobileWrapperSelector);
        if (mobileTabWrapper) {
          closeOpenMobileTabs(mobileTabWrapper);

          if (mobileTabWrapper.hasAttribute('hidden')) {
            mobileTabWrapper.removeAttribute('hidden');
          }

          var mobileToggle = mobileTabWrapper.querySelector('.collapsible-toggle[aria-controls]');
          if (mobileToggle && mobileToggle.getAttribute('aria-expanded') !== 'true') {
            mobileToggle.click();
          }

          return true;
        }
      }

      return activatedDesktopTab;
    }

    function scrollToProductContent() {
      var productContent = document.getElementById('product__content');
      if (!productContent) return;

      var offsetPx = window.innerWidth <= 999 ? 200 : 140;
      var sectionTop = productContent.getBoundingClientRect().top + window.pageYOffset;
      var scrollTarget = sectionTop - offsetPx;

      window.scrollTo({ top: Math.max(0, scrollTarget), behavior: 'smooth' });
    }

    document.addEventListener(
      'click',
      function (event) {
        var groessenfinderTrigger = event.target.closest('[data-groessenfinder-trigger]');
        var descriptionTrigger =
          event.target.closest('.product_content_button a') ||
          event.target.closest('a[href="#product__content"]') ||
          event.target.closest('a[href="#product_content"]');
        var targetTab = groessenfinderTrigger ? 'groessenfinder' : descriptionTrigger ? 'description' : null;
        if (!targetTab) return;

        event.preventDefault();
        event.stopPropagation();

        scrollToProductContent();
        setTimeout(function () {
          openProductContentTab(targetTab);
        }, 350);
      },
      true
    );
  })();
  // END:Größenfinder code
</script>
