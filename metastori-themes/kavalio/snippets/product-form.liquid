                {%- else -%}
                  <span class="price price--large">
                    <span class="visually-hidden">{{ 'product.general.sale_price' | t }}</span>
                    {%- if settings.currency_code_enabled -%}
                      {{- product.selected_or_first_available_variant.price | money_without_currency -}}
                      {{
                        shop.currency
                        | replace: 'EUR', '€'
                        | replace: 'eur', '€'
                        | replace: 'USD', '$'
                        | replace: 'usd', '$'
                      }}
                      {{ shop.currency }}
                    {%- else -%}
                      {{- product.selected_or_first_available_variant.price | money_without_currency -}}
                      {{
                        shop.currency
                        | replace: 'EUR', '€'
                        | replace: 'eur', '€'
                        | replace: 'USD', '$'
                        | replace: 'usd', '$'
                      }}
                    {%- endif -%}
