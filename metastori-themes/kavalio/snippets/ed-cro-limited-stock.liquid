{% if product.metafields.standard.cro_limited_stock == true  %}
    <div class="cro_limited_stock_ban {% if block.settings.hide_on_desktop %}hidden-lap-and-up{% endif %} {% if block.settings.hide_on_mobile %}hidden-pocket{% endif %}" style="--margin-top: {{- block.settings.space_top -}}px; --margin-bottom: {{- block.settings.space_bottom -}}px;">
        {%- if block.settings.icon_as_image != blank -%}
            <span class="cro_limited_stock_ban-icon-wrap" style="width: {{- block.settings.icon_as_size -}}px">
            {{- block.settings.icon_as_image | image_url: width: block.settings.icon_as_image.width | image_tag: sizes: '100vw', widths: '25,50,75,100', alt: block.settings.icon_as_image.alt, class: 'ed_icon-img' -}}
            </span>
        {%- elsif  block.settings.icon_as_svg != blank  -%}
            <span class="cro_limited_stock_ban-icon-wrap" style="width: {{- block.settings.icon_as_size -}}px">
            {{ block.settings.icon_as_svg }}
            </span>
        {%- endif -%}
        <p class="cro_limited_stock_ban__text">{{ block.settings.text }}</p>
    </div>

    <style>
        .cro_limited_stock_ban {
            display: flex;
            align-items: center;
            justify-content: flex-start;
            gap: 6px;
            margin-top: var(--margin-top);
            margin-bottom: var(--margin-bottom);
        }
        
        span.cro_limited_stock_ban-icon-wrap {
            display: flex;
        }
        
        .cro_limited_stock_ban__text {
            margin: 0;
            padding-top: 4px;
        }
        
        span.cro_limited_stock_ban-icon-wrap svg {
            width: 100%;
            height: auto;
            display: flex;
        }
    </style>
{% endif %}