{% liquid
  assign item_01_svg = settings.atc_benefit_icon_01
  assign item_01_title = settings.atc_benefit_text_01
  assign item_01_label = item_01_title | strip_html | strip | default: 'Benefit'

  assign item_02_svg = settings.atc_benefit_icon_02
  assign item_02_title = settings.atc_benefit_text_02
  assign item_02_label = item_02_title | strip_html | strip | default: 'Benefit'

  assign item_03_svg = settings.atc_benefit_icon_03
  assign item_03_title = settings.atc_benefit_text_03
  assign item_03_label = item_03_title | strip_html | strip | default: 'Benefit'

  assign item_04_svg = settings.atc_benefit_icon_04
  assign item_04_title = settings.atc_benefit_text_04
  assign item_04_label = item_04_title | strip_html | strip | default: 'Benefit'
%}

{% if item_01_svg != blank
  or item_01_title != blank
  or item_02_svg != blank
  or item_03_svg != blank
  or item_03_title != blank
  or item_04_svg != blank
  or item_04_title != blank
%}
  <style>
    .ed_atc_shop_benefits_wrap {
      display: flex;
      justify-content: space-between;
      margin-block-start: 32px;
      gap: 16px;
    }

    .ed_atc_shop_benefits_block {
    }

    ul.ed_atc_single_shop_benefit_list {
      list-style: none;
      padding: 0;
      margin: 0;
      display: grid;
      gap: 8px;
    }

    li.ed_atc_single_shop_benefit {
      display: flex;
      align-items: flex-start;
      justify-content: flex-start;
      gap: 5px;
    }

    li.ed_atc_single_shop_benefit svg {
      display: flex;
    }

    li.ed_atc_single_shop_benefit p {
      margin: 0;
      line-height: 1.3;
      font-weight: 300;
    }
  </style>

  <div class="ed_atc_shop_benefits_wrap">
    {% if item_01_svg != blank or item_01_title != blank or item_03_svg != blank or item_03_title != blank %}
      <div class="ed_atc_shop_benefits_block">
        <ul class="ed_atc_single_shop_benefit_list">
          <li class="ed_atc_single_shop_benefit">
            <span class="ed_atc_single_shop_benefit_icon" role="img" aria-label="{{ item_01_label | escape }}">
              {{ item_01_svg }}
            </span>
            <p>{{ item_01_title }}</p>
          </li>
          <li class="ed_atc_single_shop_benefit">
            <span class="ed_atc_single_shop_benefit_icon" role="img" aria-label="{{ item_03_label | escape }}">
              {{ item_03_svg }}
            </span>
            <p>{{ item_03_title }}</p>
          </li>
        </ul>
      </div>
    {% endif %}

    {% if item_02_svg != blank or item_02_title != blank or item_04_svg != blank or item_04_title != blank %}
      <div class="ed_atc_shop_benefits_block">
        <ul class="ed_atc_single_shop_benefit_list">
          <li class="ed_atc_single_shop_benefit">
            <span class="ed_atc_single_shop_benefit_icon" role="img" aria-label="{{ item_02_label | escape }}">
              {{ item_02_svg }}
            </span>
            <p>{{ item_02_title }}</p>
          </li>
          <li class="ed_atc_single_shop_benefit">
            <span class="ed_atc_single_shop_benefit_icon" role="img" aria-label="{{ item_04_label | escape }}">
              {{ item_04_svg }}
            </span>
            <p>{{ item_04_title }}</p>
          </li>
        </ul>
      </div>
    {% endif %}
  </div>
{% endif %}
