{%- liquid
  assign meta_list = collection.metafields.custom.subcollection.value
  assign has_meta = false
  if meta_list != blank
    assign has_meta = true
  endif
-%}
{% if has_meta %}
  <section class="subcollections section-{{ section.id }}-padding" style="background: {{ section.settings.background }};">
    <div class="section">
      {% if section.settings.heading != blank %}
        <h2 class="subcollections__heading">
          {{ section.settings.heading }}
        </h2>
      {% endif %}

      {% if section.settings.text != blank %}
        <div class="subcollections__text">
          {{ section.settings.text }}
        </div>
      {% endif %}

      <div
        class="subcollections__grid"
        style="
          --sc-cols-desktop: {{ section.settings.cols_desktop }};
          --sc-cols-mobile: {{ section.settings.cols_mobile }};
          --sc-gap: {{ section.settings.gap }}px;
        "
      >

        {%- assign shown = 0 -%}
        {% for subcoll in meta_list %}
          {% if shown >= section.settings.limit %}{% break %}{% endif %}

          {%- liquid
            assign sc_title = subcoll.title
            assign sc_url = subcoll.url
            assign sc_image = subcoll.featured_image
            if sc_image == blank
              assign sc_image = subcoll.image
            endif
            assign shown = shown | plus: 1
          -%}

          <a class="subcollections__item" href="{{ sc_url }}">
            <span class="subcollections__media">
              {% if sc_image != blank %}
                <img
                  src="{{ sc_image | image_url: width: section.settings.image_render_width, height: section.settings.image_render_width, crop: 'center' }}"
                  width="{{ section.settings.image_render_width }}"
                  height="{{ section.settings.image_render_width }}"
                  loading="lazy"
                  alt="{{ sc_image.alt | default: sc_title | escape }}"
                >
              {% else %}
                <img
                  src="https://cdn.shopify.com/s/files/1/2036/3181/files/dummy.avif?v=1767954647"
                  width="{{ section.settings.image_render_width }}"
                  height="{{ section.settings.image_render_width }}"
                  loading="lazy"
                  alt="{{ sc_title | escape }}"
                >
              {% endif %}

            </span>

            <span class="subcollections__label">{{ sc_title }}</span>
          </a>
        {% endfor %}
      </div>
    </div>

    <style>
      .section-{{ section.id }}-padding {
        padding-top: {{ section.settings.padding_top_mobile }}px;
        padding-bottom: {{ section.settings.padding_bottom_mobile }}px;
      }
      @media (min-width: 990px) {
        .section-{{ section.id }}-padding {
          padding-top: {{ section.settings.padding_top_desktop }}px;
          padding-bottom: {{ section.settings.padding_bottom_desktop }}px;
        }
      }

      .subcollections__heading {
        text-align: center;
        font-family: var(--font-h2--family);
        font-size: 42px;
        margin: 0 0 24px;
        line-height: 1.1;
      }
      @media (max-width: 989px) {
        .subcollections__heading {
          font-size: 30px;
          margin-bottom: 18px;
        }
      }

      .subcollections__text {
        text-align: center;
        max-width: 760px;
        margin: 0 auto 40px;
      }
      @media (max-width: 989px) {
        .subcollections__text {
          margin-bottom: 24px;
        }
      }

      .subcollections__grid {
        display: flex;
        flex-wrap: wrap;
        justify-content: center;
        gap: var(--sc-gap);
      }

      .subcollections__item {
        width: calc(
          (100% - (var(--sc-gap) * (var(--sc-cols-mobile) - 1)))
          / var(--sc-cols-mobile)
        );
        display: flex;
        flex-direction: column;
        align-items: center;
        text-decoration: none;
        color: inherit;
        gap: 12px;
        max-width: 130px;
      }

      @media (min-width: 990px) {
        .subcollections__item {
          width: calc(
            (100% - (var(--sc-gap) * (var(--sc-cols-desktop) - 1)))
            / var(--sc-cols-desktop)
          );
        }
      }


      .subcollections__item {
        display: flex;
        flex-direction: column;
        align-items: center;
        text-decoration: none;
        color: inherit;
        gap: 12px;
      }

      .subcollections__media {
        width: auto;
        height: auto;
        border-radius: 50%;
        overflow: hidden;
        background: #f2f2f2;
      }
      .subcollections__media img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        display: block;
      }

      .subcollections__label {
        font-family: var(--font-paragraph--family);
        font-size: 12px;
        letter-spacing: 0.15em;
        text-align: center;
        line-height: 1.2;
      }
    </style>
  </section>
{% endif %}

{% schema %}
{
  "name": "Subcollections Grid",
  "settings": [
    { "type": "color", "id": "background", "label": "Background", "default": "#FBF7F2" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Discover Our Bath & Body Care Range" },
    { "type": "richtext", "id": "text", "label": "Text", "default": "<p></p>" },

    { "type": "range", "id": "limit", "label": "Items limit", "min": 4, "max": 24, "step": 2, "default": 8 },
    { "type": "range", "id": "cols_desktop", "label": "Columns desktop", "min": 4, "max": 10, "step": 1, "default": 8 },
    { "type": "range", "id": "cols_mobile", "label": "Columns mobile", "min": 2, "max": 4, "step": 1, "default": 4 },
    { "type": "range", "id": "gap", "label": "Gap", "min": 8, "max": 40, "step": 4, "default": 20 },

    { "type": "range", "id": "image_render_width", "label": "Image render width", "min": 160, "max": 600, "step": 40, "default": 320 },

    { "type": "range", "id": "padding_top_desktop", "label": "Padding top desktop", "min": 0, "max": 120, "step": 8, "default": 64 },
    { "type": "range", "id": "padding_bottom_desktop", "label": "Padding bottom desktop", "min": 0, "max": 120, "step": 8, "default": 64 },
    { "type": "range", "id": "padding_top_mobile", "label": "Padding top mobile", "min": 0, "max": 120, "step": 8, "default": 40 },
    { "type": "range", "id": "padding_bottom_mobile", "label": "Padding bottom mobile", "min": 0, "max": 120, "step": 8, "default": 40 }
  ],
  "presets": [
    { "name": "Subcollections Grid" }
  ]
}
{% endschema %}
