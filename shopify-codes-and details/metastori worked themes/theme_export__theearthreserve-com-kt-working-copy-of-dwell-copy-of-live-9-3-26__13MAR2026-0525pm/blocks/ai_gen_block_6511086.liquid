{% doc %}
  @prompt
    create a medium sized 6 block collection to diiferent collections, which a nice animatedhover for the collection title, i want to add another image as the cover image
    individaul tile view in mobile
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-collection-grid-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    padding: {{ block.settings.section_padding }}px 0;
  }

  .ai-collection-grid-container-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: {{ block.settings.grid_gap }}px;
  }

  @media screen and (max-width: 749px) {
    .ai-collection-grid-container-{{ ai_gen_id }} {
      grid-template-columns: 1fr;
    }
  }

  .ai-collection-card-{{ ai_gen_id }} {
    position: relative;
    overflow: hidden;
    border-radius: {{ block.settings.card_border_radius }}px;
    aspect-ratio: {{ block.settings.card_aspect_ratio }};
    cursor: pointer;
    text-decoration: none;
    display: block;
  }

  .ai-collection-card-images-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    height: 100%;
  }

  .ai-collection-card-image-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: opacity 0.4s ease;
  }

  .ai-collection-card-image-{{ ai_gen_id }}.primary {
    opacity: 1;
    z-index: 1;
  }

  .ai-collection-card-image-{{ ai_gen_id }}.secondary {
    opacity: 0;
    z-index: 2;
  }

  .ai-collection-card-{{ ai_gen_id }}:hover .ai-collection-card-image-{{ ai_gen_id }}.secondary {
    opacity: 1;
  }

  .ai-collection-card-placeholder-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    background-color: #f4f4f4;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .ai-collection-card-placeholder-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
    max-width: 200px;
    max-height: 200px;
  }

  .ai-collection-card-overlay-{{ ai_gen_id }} {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    padding: {{ block.settings.overlay_padding }}px;
    background: linear-gradient(to top, {{ block.settings.overlay_color }}, transparent);
    z-index: 3;
  }

  .ai-collection-card-title-{{ ai_gen_id }} {
    color: {{ block.settings.title_color }};
    font-size: {{ block.settings.title_size }}px;
    font-weight: 600;
    margin: 0;
    transform: translateY(0);
    transition: transform 0.3s ease;
  }

  .ai-collection-card-{{ ai_gen_id }}:hover .ai-collection-card-title-{{ ai_gen_id }} {
    transform: translateY(-8px);
  }

  .ai-collection-card-count-{{ ai_gen_id }} {
    color: {{ block.settings.count_color }};
    font-size: {{ block.settings.count_size }}px;
    margin: 4px 0 0;
    opacity: 0;
    transform: translateY(10px);
    transition: opacity 0.3s ease, transform 0.3s ease;
  }

  .ai-collection-card-{{ ai_gen_id }}:hover .ai-collection-card-count-{{ ai_gen_id }} {
    opacity: 1;
    transform: translateY(0);
  }

  .ai-collection-empty-state-{{ ai_gen_id }} {
    text-align: center;
    padding: 20px;
    color: #666;
    font-size: 14px;
  }
{% endstyle %}

<collection-grid-{{ ai_gen_id }}
  class="ai-collection-grid-{{ ai_gen_id }}"
  {{ block.shopify_attributes }}
>
  <div class="ai-collection-grid-container-{{ ai_gen_id }}">
    {% for i in (1..6) %}
      {% liquid
        assign collection_key = 'collection_' | append: i
        assign hover_image_key = 'collection_' | append: i | append: '_hover_image'
        assign collection = block.settings[collection_key]
        assign hover_image = block.settings[hover_image_key]
      %}

      {% if collection != blank %}
        <a
          href="{{ collection.url }}"
          class="ai-collection-card-{{ ai_gen_id }}"
          aria-label="{{ collection.title }}"
        >
          <div class="ai-collection-card-images-{{ ai_gen_id }}">
            {% if collection.featured_image %}
              <img
                src="{{ collection.featured_image | image_url: width: 800 }}"
                alt="{{ collection.featured_image.alt | escape }}"
                loading="lazy"
                width="800"
                height="800"
                class="ai-collection-card-image-{{ ai_gen_id }} primary"
              >
            {% else %}
              <div class="ai-collection-card-placeholder-{{ ai_gen_id }}">
                {{ 'collection-1' | placeholder_svg_tag }}
              </div>
            {% endif %}

            {% if hover_image %}
              <img
                src="{{ hover_image | image_url: width: 800 }}"
                alt="{{ hover_image.alt | escape }}"
                loading="lazy"
                width="800"
                height="800"
                class="ai-collection-card-image-{{ ai_gen_id }} secondary"
              >
            {% endif %}
          </div>

          <div class="ai-collection-card-overlay-{{ ai_gen_id }}">
            <h3 class="ai-collection-card-title-{{ ai_gen_id }}">{{ collection.title }}</h3>
            {% if block.settings.show_product_count %}
              <p class="ai-collection-card-count-{{ ai_gen_id }}">
                {{ collection.products_count }}
                {% if collection.products_count == 1 %}
                  product
                {% else %}
                  products
                {% endif %}
              </p>
            {% endif %}
          </div>
        </a>
      {% else %}
        <div class="ai-collection-card-{{ ai_gen_id }}">
          <div class="ai-collection-card-placeholder-{{ ai_gen_id }}">
            {{ 'collection-1' | placeholder_svg_tag }}
          </div>
          <div class="ai-collection-card-overlay-{{ ai_gen_id }}">
            <div class="ai-collection-empty-state-{{ ai_gen_id }}">
              Select a collection
            </div>
          </div>
        </div>
      {% endif %}
    {% endfor %}
  </div>
</collection-grid-{{ ai_gen_id }}>

<script>
  (function() {
    class CollectionGrid{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
        this.cards = this.querySelectorAll('.ai-collection-card-{{ ai_gen_id }}');
        this.setupAccessibility();
      }

      setupAccessibility() {
        this.cards.forEach((card) => {
          card.addEventListener('keydown', (e) => {
            if (e.key === 'Enter' || e.key === ' ') {
              e.preventDefault();
              card.click();
            }
          });
        });
      }
    }

    customElements.define('collection-grid-{{ ai_gen_id }}', CollectionGrid{{ ai_gen_id }});
  })();
</script>

