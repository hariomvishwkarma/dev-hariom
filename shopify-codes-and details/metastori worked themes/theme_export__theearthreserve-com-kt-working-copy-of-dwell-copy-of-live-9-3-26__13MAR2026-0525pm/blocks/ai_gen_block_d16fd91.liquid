{% doc %}
  @prompt
    create a customer reeview section with 5 star rating &  a transperent backgroud option, also it should be clearly fit to the both mobile & destop view, need to add 6 reviews in scrollable view, with arrow mark to scroll & see the reviews, scrollable grid view, reviews in a single roq, should be slidable, add arrow mark option to slide
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-review-section-{{ ai_gen_id }} {
    padding: {{ block.settings.padding_top }}px {{ block.settings.padding_horizontal }}px {{ block.settings.padding_bottom }}px;
    {% if block.settings.enable_transparent_background %}
      background-color: transparent;
    {% else %}
      background-color: {{ block.settings.background_color }};
    {% endif %}
  }

  .ai-review-container-{{ ai_gen_id }} {
    max-width: {{ block.settings.container_width }}px;
    margin: 0 auto;
  }

  .ai-review-header-{{ ai_gen_id }} {
    text-align: {{ block.settings.text_alignment }};
    margin-bottom: 40px;
  }

  .ai-review-title-{{ ai_gen_id }} {
    font-size: {{ block.settings.title_size }}px;
    color: {{ block.settings.text_color }};
    margin: 0 0 12px;
  }

  .ai-review-subtitle-{{ ai_gen_id }} {
    font-size: {{ block.settings.subtitle_size }}px;
    color: {{ block.settings.text_color }};
    opacity: 0.8;
    margin: 0;
  }

  .ai-review-slider-wrapper-{{ ai_gen_id }} {
    position: relative;
    padding: 0 {{ block.settings.arrow_size | plus: 20 }}px;
  }

  .ai-review-slider-{{ ai_gen_id }} {
    display: flex;
    gap: {{ block.settings.card_spacing }}px;
    overflow-x: auto;
    scroll-behavior: smooth;
    scrollbar-width: none;
    -ms-overflow-style: none;
    padding: 8px 4px;
  }

  .ai-review-slider-{{ ai_gen_id }}::-webkit-scrollbar {
    display: none;
  }

  .ai-review-card-{{ ai_gen_id }} {
    background-color: {{ block.settings.card_background }};
    border: {{ block.settings.card_border_width }}px solid {{ block.settings.card_border_color }};
    border-radius: {{ block.settings.card_border_radius }}px;
    padding: {{ block.settings.card_padding }}px;
    display: flex;
    flex-direction: column;
    gap: 16px;
    min-width: {{ block.settings.card_width }}px;
    max-width: {{ block.settings.card_width }}px;
    flex-shrink: 0;
  }

  .ai-review-card-header-{{ ai_gen_id }} {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .ai-review-avatar-{{ ai_gen_id }} {
    width: 48px;
    height: 48px;
    border-radius: 50%;
    background-color: {{ block.settings.avatar_background }};
    color: {{ block.settings.avatar_text_color }};
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 18px;
    font-weight: 600;
    flex-shrink: 0;
  }

  .ai-review-author-info-{{ ai_gen_id }} {
    flex-grow: 1;
  }

  .ai-review-author-name-{{ ai_gen_id }} {
    font-size: 16px;
    font-weight: 600;
    color: {{ block.settings.text_color }};
    margin: 0 0 4px;
  }

  .ai-review-date-{{ ai_gen_id }} {
    font-size: 13px;
    color: {{ block.settings.text_color }};
    opacity: 0.6;
    margin: 0;
  }

  .ai-review-stars-{{ ai_gen_id }} {
    display: flex;
    gap: 4px;
  }

  .ai-review-star-{{ ai_gen_id }} {
    width: {{ block.settings.star_size }}px;
    height: {{ block.settings.star_size }}px;
    fill: {{ block.settings.star_color }};
  }

  .ai-review-star-empty-{{ ai_gen_id }} {
    fill: {{ block.settings.star_empty_color }};
  }

  .ai-review-text-{{ ai_gen_id }} {
    font-size: 14px;
    line-height: 1.6;
    color: {{ block.settings.text_color }};
    margin: 0;
  }

  .ai-review-verified-{{ ai_gen_id }} {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 13px;
    color: {{ block.settings.verified_color }};
    font-weight: 500;
  }

  .ai-review-verified-icon-{{ ai_gen_id }} {
    width: 16px;
    height: 16px;
    fill: {{ block.settings.verified_color }};
  }

  .ai-review-nav-button-{{ ai_gen_id }} {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    width: {{ block.settings.arrow_size }}px;
    height: {{ block.settings.arrow_size }}px;
    background-color: {{ block.settings.arrow_background }};
    border: {{ block.settings.arrow_border_width }}px solid {{ block.settings.arrow_border_color }};
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    z-index: 2;
    transition: all 0.3s ease;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
  }

  .ai-review-nav-button-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.arrow_hover_background }};
    transform: translateY(-50%) scale(1.1);
  }

  .ai-review-nav-button-{{ ai_gen_id }}:disabled {
    opacity: 0.3;
    cursor: not-allowed;
  }

  .ai-review-nav-button-{{ ai_gen_id }}:disabled:hover {
    transform: translateY(-50%) scale(1);
    background-color: {{ block.settings.arrow_background }};
  }

  .ai-review-nav-prev-{{ ai_gen_id }} {
    left: 0;
  }

  .ai-review-nav-next-{{ ai_gen_id }} {
    right: 0;
  }

  .ai-review-nav-icon-{{ ai_gen_id }} {
    width: {{ block.settings.arrow_size | times: 0.5 }}px;
    height: {{ block.settings.arrow_size | times: 0.5 }}px;
    fill: {{ block.settings.arrow_color }};
  }

  @media screen and (max-width: 749px) {
    .ai-review-section-{{ ai_gen_id }} {
      padding: {{ block.settings.padding_top | times: 0.6 }}px {{ block.settings.padding_horizontal | times: 0.6 }}px {{ block.settings.padding_bottom | times: 0.6 }}px;
    }

    .ai-review-title-{{ ai_gen_id }} {
      font-size: {{ block.settings.title_size | times: 0.7 }}px;
    }

    .ai-review-subtitle-{{ ai_gen_id }} {
      font-size: {{ block.settings.subtitle_size | times: 0.85 }}px;
    }

    .ai-review-header-{{ ai_gen_id }} {
      margin-bottom: 24px;
    }

    .ai-review-slider-wrapper-{{ ai_gen_id }} {
      padding: 0 {{ block.settings.arrow_size | times: 0.8 | plus: 12 }}px;
    }

    .ai-review-card-{{ ai_gen_id }} {
      min-width: {{ block.settings.card_width_mobile }}px;
      max-width: {{ block.settings.card_width_mobile }}px;
    }

    .ai-review-slider-{{ ai_gen_id }} {
      gap: {{ block.settings.card_spacing | times: 0.8 }}px;
    }

    .ai-review-nav-prev-{{ ai_gen_id }} {
      left: 4px;
    }

    .ai-review-nav-next-{{ ai_gen_id }} {
      right: 4px;
    }
  }
{% endstyle %}

<review-slider-{{ ai_gen_id }} class="ai-review-section-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-review-container-{{ ai_gen_id }}">
    {% if block.settings.title != blank or block.settings.subtitle != blank %}
      <div class="ai-review-header-{{ ai_gen_id }}">
        {% if block.settings.title != blank %}
          <h2 class="ai-review-title-{{ ai_gen_id }}">{{ block.settings.title }}</h2>
        {% endif %}
        {% if block.settings.subtitle != blank %}
          <p class="ai-review-subtitle-{{ ai_gen_id }}">{{ block.settings.subtitle }}</p>
        {% endif %}
      </div>
    {% endif %}

    <div class="ai-review-slider-wrapper-{{ ai_gen_id }}">
      <button
        class="ai-review-nav-button-{{ ai_gen_id }} ai-review-nav-prev-{{ ai_gen_id }}"
        aria-label="Previous reviews"
        data-direction="prev"
      >
        <svg class="ai-review-nav-icon-{{ ai_gen_id }}" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24">
          <path d="M15.41 7.41L14 6l-6 6 6 6 1.41-1.41L10.83 12z"/>
        </svg>
      </button>

      <div class="ai-review-slider-{{ ai_gen_id }}">
        {% for i in (1..6) %}
          {% liquid
            assign review_enabled_key = 'review_' | append: i | append: '_enabled'
            assign review_name_key = 'review_' | append: i | append: '_name'
            assign review_date_key = 'review_' | append: i | append: '_date'
            assign review_rating_key = 'review_' | append: i | append: '_rating'
            assign review_text_key = 'review_' | append: i | append: '_text'
            assign review_verified_key = 'review_' | append: i | append: '_verified'

            assign review_enabled = block.settings[review_enabled_key]
            assign review_name = block.settings[review_name_key]
            assign review_date = block.settings[review_date_key]
            assign review_rating = block.settings[review_rating_key]
            assign review_text = block.settings[review_text_key]
            assign review_verified = block.settings[review_verified_key]
          %}

          {% if review_enabled %}
            <div class="ai-review-card-{{ ai_gen_id }}">
              <div class="ai-review-card-header-{{ ai_gen_id }}">
                <div class="ai-review-avatar-{{ ai_gen_id }}">
                  {% if review_name != blank %}
                    {{ review_name | slice: 0 | upcase }}
                  {% else %}
                    ?
                  {% endif %}
                </div>
                <div class="ai-review-author-info-{{ ai_gen_id }}">
                  <h3 class="ai-review-author-name-{{ ai_gen_id }}">
                    {% if review_name != blank %}
                      {{ review_name }}
                    {% else %}
                      Customer
                    {% endif %}
                  </h3>
                  {% if review_date != blank %}
                    <p class="ai-review-date-{{ ai_gen_id }}">{{ review_date }}</p>
                  {% endif %}
                </div>
              </div>

              <div class="ai-review-stars-{{ ai_gen_id }}">
                {% for star in (1..5) %}
                  {% if star <= review_rating %}
                    <svg class="ai-review-star-{{ ai_gen_id }}" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24">
                      <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/>
                    </svg>
                  {% else %}
                    <svg class="ai-review-star-{{ ai_gen_id }} ai-review-star-empty-{{ ai_gen_id }}" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24">
                      <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/>
                    </svg>
                  {% endif %}
                {% endfor %}
              </div>

              {% if review_text != blank %}
                <p class="ai-review-text-{{ ai_gen_id }}">{{ review_text }}</p>
              {% endif %}

              {% if review_verified %}
                <div class="ai-review-verified-{{ ai_gen_id }}">
                  <svg class="ai-review-verified-icon-{{ ai_gen_id }}" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24">
                    <path d="M9 16.17L4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41L9 16.17z"/>
                  </svg>
                  Verified Purchase
                </div>
              {% endif %}
            </div>
          {% endif %}
        {% endfor %}
      </div>

      <button
        class="ai-review-nav-button-{{ ai_gen_id }} ai-review-nav-next-{{ ai_gen_id }}"
        aria-label="Next reviews"
        data-direction="next"
      >
        <svg class="ai-review-nav-icon-{{ ai_gen_id }}" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24">
          <path d="M10 6L8.59 7.41 13.17 12l-4.58 4.59L10 18l6-6z"/>
        </svg>
      </button>
    </div>
  </div>
</review-slider-{{ ai_gen_id }}>

<script>
  (function() {
    class ReviewSlider{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
        this.slider = this.querySelector('.ai-review-slider-{{ ai_gen_id }}');
        this.prevButton = this.querySelector('.ai-review-nav-prev-{{ ai_gen_id }}');
        this.nextButton = this.querySelector('.ai-review-nav-next-{{ ai_gen_id }}');
      }

      connectedCallback() {
        this.setupEventListeners();
        this.updateButtonStates();
      }

      setupEventListeners() {
        this.prevButton.addEventListener('click', () => this.scroll('prev'));
        this.nextButton.addEventListener('click', () => this.scroll('next'));
        this.slider.addEventListener('scroll', () => this.updateButtonStates());
      }

      scroll(direction) {
        const card = this.slider.querySelector('.ai-review-card-{{ ai_gen_id }}');
        if (!card) return;
        
        const cardWidth = card.offsetWidth;
        const gap = parseInt(getComputedStyle(this.slider).gap) || 0;
        const scrollAmount = cardWidth + gap;
        const currentScroll = this.slider.scrollLeft;
        
        if (direction === 'next') {
          this.slider.scrollLeft = currentScroll + scrollAmount;
        } else {
          this.slider.scrollLeft = currentScroll - scrollAmount;
        }
      }

      updateButtonStates() {
        const isAtStart = this.slider.scrollLeft <= 0;
        const isAtEnd = this.slider.scrollLeft + this.slider.offsetWidth >= this.slider.scrollWidth - 1;

        this.prevButton.disabled = isAtStart;
        this.nextButton.disabled = isAtEnd;
      }
    }

    customElements.define('review-slider-{{ ai_gen_id }}', ReviewSlider{{ ai_gen_id }});
  })();
</script>

