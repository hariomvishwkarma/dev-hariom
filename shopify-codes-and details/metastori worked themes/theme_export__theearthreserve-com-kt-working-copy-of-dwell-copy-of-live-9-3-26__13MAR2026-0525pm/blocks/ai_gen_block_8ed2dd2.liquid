{% doc %}
  @prompt
    customer review section with stars and comments, slidable, description is not rewuired
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-reviews-slider-{{ ai_gen_id }} {
    padding: 60px 20px;
    background-color: {{ block.settings.background_color }};
    overflow: hidden;
  }

  .ai-reviews-slider__container-{{ ai_gen_id }} {
    max-width: 1200px;
    margin: 0 auto;
  }

  .ai-reviews-slider__header-{{ ai_gen_id }} {
    text-align: center;
    margin-bottom: 40px;
  }

  .ai-reviews-slider__heading-{{ ai_gen_id }} {
    color: {{ block.settings.heading_color }};
    margin: 0;
    font-size: {{ block.settings.heading_size }}px;
  }

  .ai-reviews-slider__wrapper-{{ ai_gen_id }} {
    position: relative;
  }

  .ai-reviews-slider__track-{{ ai_gen_id }} {
    display: flex;
    gap: {{ block.settings.card_gap }}px;
    overflow-x: auto;
    scroll-behavior: smooth;
    scrollbar-width: none;
    -ms-overflow-style: none;
    padding: 20px 0;
  }

  .ai-reviews-slider__track-{{ ai_gen_id }}::-webkit-scrollbar {
    display: none;
  }

  .ai-reviews-slider__card-{{ ai_gen_id }} {
    flex: 0 0 {{ block.settings.card_width }}px;
    background-color: {{ block.settings.card_background }};
    border-radius: {{ block.settings.card_border_radius }}px;
    padding: 30px;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .ai-reviews-slider__stars-{{ ai_gen_id }} {
    display: flex;
    gap: 4px;
  }

  .ai-reviews-slider__star-{{ ai_gen_id }} {
    width: {{ block.settings.star_size }}px;
    height: {{ block.settings.star_size }}px;
    fill: {{ block.settings.star_color }};
  }

  .ai-reviews-slider__star-{{ ai_gen_id }}.empty {
    fill: {{ block.settings.star_empty_color }};
  }

  .ai-reviews-slider__comment-{{ ai_gen_id }} {
    color: {{ block.settings.text_color }};
    font-size: {{ block.settings.comment_size }}px;
    line-height: 1.6;
    flex-grow: 1;
  }

  .ai-reviews-slider__author-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .ai-reviews-slider__name-{{ ai_gen_id }} {
    color: {{ block.settings.heading_color }};
    font-weight: 600;
    font-size: {{ block.settings.name_size }}px;
  }

  .ai-reviews-slider__date-{{ ai_gen_id }} {
    color: {{ block.settings.text_color }};
    font-size: {{ block.settings.date_size }}px;
    opacity: 0.7;
  }

  .ai-reviews-slider__controls-{{ ai_gen_id }} {
    display: flex;
    justify-content: center;
    gap: 12px;
    margin-top: 30px;
  }

  .ai-reviews-slider__button-{{ ai_gen_id }} {
    width: 44px;
    height: 44px;
    border-radius: 50%;
    background-color: {{ block.settings.button_background }};
    border: none;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: background-color 0.3s ease;
  }

  .ai-reviews-slider__button-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.button_hover_background }};
  }

  .ai-reviews-slider__button-{{ ai_gen_id }} svg {
    width: 20px;
    height: 20px;
    stroke: {{ block.settings.button_icon_color }};
  }

  .ai-reviews-slider__dots-{{ ai_gen_id }} {
    display: flex;
    justify-content: center;
    gap: 8px;
    margin-top: 20px;
  }

  .ai-reviews-slider__dot-{{ ai_gen_id }} {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background-color: {{ block.settings.dot_color }};
    opacity: 0.3;
    cursor: pointer;
    border: none;
    padding: 0;
    transition: opacity 0.3s ease;
  }

  .ai-reviews-slider__dot-{{ ai_gen_id }}.active {
    opacity: 1;
  }

  @media screen and (max-width: 749px) {
    .ai-reviews-slider-{{ ai_gen_id }} {
      padding: 40px 16px;
    }

    .ai-reviews-slider__card-{{ ai_gen_id }} {
      flex: 0 0 280px;
      padding: 24px;
    }

    .ai-reviews-slider__heading-{{ ai_gen_id }} {
      font-size: {{ block.settings.heading_size | times: 0.7 }}px;
    }
  }
{% endstyle %}

<customer-reviews-{{ ai_gen_id }}
  class="ai-reviews-slider-{{ ai_gen_id }}"
  {{ block.shopify_attributes }}
>
  <div class="ai-reviews-slider__container-{{ ai_gen_id }}">
    {% if block.settings.heading != blank %}
      <div class="ai-reviews-slider__header-{{ ai_gen_id }}">
        <h2 class="ai-reviews-slider__heading-{{ ai_gen_id }}">{{ block.settings.heading }}</h2>
      </div>
    {% endif %}

    <div class="ai-reviews-slider__wrapper-{{ ai_gen_id }}">
      <div class="ai-reviews-slider__track-{{ ai_gen_id }}" data-slider-track>
        {% for i in (1..6) %}
          {% liquid
            assign review_enabled_key = 'review_' | append: i | append: '_enabled'
            assign review_rating_key = 'review_' | append: i | append: '_rating'
            assign review_comment_key = 'review_' | append: i | append: '_comment'
            assign review_name_key = 'review_' | append: i | append: '_name'
            assign review_date_key = 'review_' | append: i | append: '_date'

            assign review_enabled = block.settings[review_enabled_key]
            assign review_rating = block.settings[review_rating_key]
            assign review_comment = block.settings[review_comment_key]
            assign review_name = block.settings[review_name_key]
            assign review_date = block.settings[review_date_key]
          %}

          {% if review_enabled %}
            <div class="ai-reviews-slider__card-{{ ai_gen_id }}">
              <div class="ai-reviews-slider__stars-{{ ai_gen_id }}">
                {% for star in (1..5) %}
                  <svg
                    class="ai-reviews-slider__star-{{ ai_gen_id }} {% if star > review_rating %}empty{% endif %}"
                    xmlns="http://www.w3.org/2000/svg"
                    viewBox="0 0 24 24"
                  >
                    <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/>
                  </svg>
                {% endfor %}
              </div>

              <div class="ai-reviews-slider__comment-{{ ai_gen_id }}">
                {{ review_comment }}
              </div>

              <div class="ai-reviews-slider__author-{{ ai_gen_id }}">
                {% if review_name != blank %}
                  <div class="ai-reviews-slider__name-{{ ai_gen_id }}">{{ review_name }}</div>
                {% endif %}
                {% if review_date != blank %}
                  <div class="ai-reviews-slider__date-{{ ai_gen_id }}">{{ review_date }}</div>
                {% endif %}
              </div>
            </div>
          {% endif %}
        {% endfor %}
      </div>

      <div class="ai-reviews-slider__controls-{{ ai_gen_id }}">
        <button
          class="ai-reviews-slider__button-{{ ai_gen_id }}"
          data-prev-button
          aria-label="Previous review"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            fill="none"
            viewBox="0 0 24 24"
            stroke-width="2"
            stroke="currentColor"
          >
            <path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7"/>
          </svg>
        </button>
        <button
          class="ai-reviews-slider__button-{{ ai_gen_id }}"
          data-next-button
          aria-label="Next review"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            fill="none"
            viewBox="0 0 24 24"
            stroke-width="2"
            stroke="currentColor"
          >
            <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/>
          </svg>
        </button>
      </div>

      <div class="ai-reviews-slider__dots-{{ ai_gen_id }}" data-dots-container></div>
    </div>
  </div>
</customer-reviews-{{ ai_gen_id }}>

<script>
  (function() {
    class CustomerReviews{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
        this.track = this.querySelector('[data-slider-track]');
        this.prevButton = this.querySelector('[data-prev-button]');
        this.nextButton = this.querySelector('[data-next-button]');
        this.dotsContainer = this.querySelector('[data-dots-container]');
        this.cards = this.querySelectorAll('.ai-reviews-slider__card-{{ ai_gen_id }}');
        this.currentIndex = 0;
      }

      connectedCallback() {
        this.setupDots();
        this.setupEventListeners();
        this.updateDots();
      }

      setupDots() {
        this.cards.forEach((card, index) => {
          const dot = document.createElement('button');
          dot.classList.add('ai-reviews-slider__dot-{{ ai_gen_id }}');
          dot.setAttribute('aria-label', 'Go to review ' + (index + 1));
          dot.addEventListener('click', () => this.scrollToIndex(index));
          this.dotsContainer.appendChild(dot);
        });
        this.dots = this.dotsContainer.querySelectorAll('.ai-reviews-slider__dot-{{ ai_gen_id }}');
      }

      setupEventListeners() {
        this.prevButton.addEventListener('click', () => this.scrollPrev());
        this.nextButton.addEventListener('click', () => this.scrollNext());

        this.track.addEventListener('scroll', () => {
          this.updateCurrentIndex();
          this.updateDots();
        });
      }

      scrollPrev() {
        if (this.currentIndex > 0) {
          this.scrollToIndex(this.currentIndex - 1);
        }
      }

      scrollNext() {
        if (this.currentIndex < this.cards.length - 1) {
          this.scrollToIndex(this.currentIndex + 1);
        }
      }

      scrollToIndex(index) {
        const card = this.cards[index];
        if (card) {
          const scrollLeft = card.offsetLeft - this.track.offsetLeft;
          this.track.scrollTo({
            left: scrollLeft,
            behavior: 'smooth'
          });
          this.currentIndex = index;
          this.updateDots();
        }
      }

      updateCurrentIndex() {
        const scrollLeft = this.track.scrollLeft;
        const cardWidth = this.cards[0].offsetWidth;
        const gap = {{ block.settings.card_gap }};
        this.currentIndex = Math.round(scrollLeft / (cardWidth + gap));
      }

      updateDots() {
        this.dots.forEach((dot, index) => {
          if (index === this.currentIndex) {
            dot.classList.add('active');
          } else {
            dot.classList.remove('active');
          }
        });
      }
    }

    customElements.define('customer-reviews-{{ ai_gen_id }}', CustomerReviews{{ ai_gen_id }});
  })();
</script>

