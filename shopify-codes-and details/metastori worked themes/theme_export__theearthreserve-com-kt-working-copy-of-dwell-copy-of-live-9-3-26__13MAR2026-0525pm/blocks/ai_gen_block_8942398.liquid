{% doc %}
  @prompt
    image slideshow as haeder
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-slideshow-header-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    height: {{ block.settings.height_desktop }}px;
    overflow: hidden;
  }

  @media screen and (max-width: 749px) {
    .ai-slideshow-header-{{ ai_gen_id }} {
      height: {{ block.settings.height_mobile }}px;
    }
  }

  .ai-slideshow-container-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    height: 100%;
  }

  .ai-slideshow-slide-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    opacity: 0;
    transition: opacity {{ block.settings.transition_speed }}s ease-in-out;
  }

  .ai-slideshow-slide-{{ ai_gen_id }}.active {
    opacity: 1;
    z-index: 1;
  }

  .ai-slideshow-image-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ai-slideshow-placeholder-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    background-color: #f4f4f4;
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
  }

  .ai-slideshow-placeholder-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
    max-width: 500px;
    max-height: 500px;
  }

  .ai-slideshow-empty-state-{{ ai_gen_id }} {
    position: absolute;
    bottom: 20px;
    left: 50%;
    transform: translateX(-50%);
    padding: 12px 20px;
    font-size: 14px;
    color: #666;
    text-align: center;
    pointer-events: none;
  }

  .ai-slideshow-content-{{ ai_gen_id }} {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    text-align: center;
    color: {{ block.settings.text_color }};
    z-index: 2;
    width: 90%;
    max-width: 800px;
  }

  .ai-slideshow-heading-{{ ai_gen_id }} {
    font-size: {{ block.settings.heading_size }}px;
    margin: 0 0 16px;
    color: {{ block.settings.text_color }};
  }

  @media screen and (max-width: 749px) {
    .ai-slideshow-heading-{{ ai_gen_id }} {
      font-size: {{ block.settings.heading_size | times: 0.6 }}px;
    }
  }

  .ai-slideshow-subheading-{{ ai_gen_id }} {
    font-size: {{ block.settings.subheading_size }}px;
    margin: 0 0 24px;
    color: {{ block.settings.text_color }};
  }

  @media screen and (max-width: 749px) {
    .ai-slideshow-subheading-{{ ai_gen_id }} {
      font-size: {{ block.settings.subheading_size | times: 0.8 }}px;
    }
  }

  .ai-slideshow-button-{{ ai_gen_id }} {
    display: inline-block;
    padding: 12px 32px;
    background-color: {{ block.settings.button_bg_color }};
    color: {{ block.settings.button_text_color }};
    text-decoration: none;
    border-radius: {{ block.settings.button_border_radius }}px;
    transition: background-color 0.3s ease;
  }

  .ai-slideshow-button-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.button_hover_bg_color }};
    color: {{ block.settings.button_hover_text_color }};
  }

  .ai-slideshow-overlay-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-color: {{ block.settings.overlay_color }};
    opacity: {{ block.settings.overlay_opacity | divided_by: 100.0 }};
    z-index: 1;
  }

  .ai-slideshow-controls-{{ ai_gen_id }} {
    position: absolute;
    bottom: 20px;
    left: 50%;
    transform: translateX(-50%);
    display: flex;
    gap: 10px;
    z-index: 3;
  }

  .ai-slideshow-dot-{{ ai_gen_id }} {
    width: 12px;
    height: 12px;
    border-radius: 50%;
    background-color: {{ block.settings.dot_color }};
    opacity: 0.5;
    cursor: pointer;
    border: none;
    padding: 0;
    transition: opacity 0.3s ease;
  }

  .ai-slideshow-dot-{{ ai_gen_id }}.active {
    opacity: 1;
  }

  .ai-slideshow-arrow-{{ ai_gen_id }} {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    background-color: {{ block.settings.arrow_bg_color }};
    color: {{ block.settings.arrow_color }};
    border: none;
    width: 48px;
    height: 48px;
    border-radius: 50%;
    cursor: pointer;
    z-index: 3;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: background-color 0.3s ease;
  }

  .ai-slideshow-arrow-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.arrow_hover_bg_color }};
  }

  .ai-slideshow-arrow-{{ ai_gen_id }}.prev {
    left: 20px;
  }

  .ai-slideshow-arrow-{{ ai_gen_id }}.next {
    right: 20px;
  }

  @media screen and (max-width: 749px) {
    .ai-slideshow-arrow-{{ ai_gen_id }} {
      width: 36px;
      height: 36px;
    }

    .ai-slideshow-arrow-{{ ai_gen_id }}.prev {
      left: 10px;
    }

    .ai-slideshow-arrow-{{ ai_gen_id }}.next {
      right: 10px;
    }
  }
{% endstyle %}

<image-slideshow-{{ ai_gen_id }} class="ai-slideshow-header-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-slideshow-container-{{ ai_gen_id }}">
    {% for i in (1..5) %}
      {% liquid
        assign image_key = 'slide_' | append: i | append: '_image'
        assign heading_key = 'slide_' | append: i | append: '_heading'
        assign subheading_key = 'slide_' | append: i | append: '_subheading'
        assign button_text_key = 'slide_' | append: i | append: '_button_text'
        assign button_link_key = 'slide_' | append: i | append: '_button_link'

        assign slide_image = block.settings[image_key]
        assign slide_heading = block.settings[heading_key]
        assign slide_subheading = block.settings[subheading_key]
        assign slide_button_text = block.settings[button_text_key]
        assign slide_button_link = block.settings[button_link_key]
      %}

      {% if slide_image != blank %}
        <div class="ai-slideshow-slide-{{ ai_gen_id }} {% if forloop.first %}active{% endif %}" data-slide="{{ forloop.index }}">
          <img
            src="{{ slide_image | image_url: width: 2000 }}"
            alt="{{ slide_image.alt | escape }}"
            loading="{% if forloop.first %}eager{% else %}lazy{% endif %}"
            width="{{ slide_image.width }}"
            height="{{ slide_image.height }}"
            class="ai-slideshow-image-{{ ai_gen_id }}"
          >
          {% if block.settings.show_overlay %}
            <div class="ai-slideshow-overlay-{{ ai_gen_id }}"></div>
          {% endif %}
          {% if slide_heading != blank or slide_subheading != blank or slide_button_text != blank %}
            <div class="ai-slideshow-content-{{ ai_gen_id }}">
              {% if slide_heading != blank %}
                <h2 class="ai-slideshow-heading-{{ ai_gen_id }}">{{ slide_heading }}</h2>
              {% endif %}
              {% if slide_subheading != blank %}
                <p class="ai-slideshow-subheading-{{ ai_gen_id }}">{{ slide_subheading }}</p>
              {% endif %}
              {% if slide_button_text != blank %}
                <a href="{{ slide_button_link }}" class="ai-slideshow-button-{{ ai_gen_id }}">
                  {{ slide_button_text }}
                </a>
              {% endif %}
            </div>
          {% endif %}
        </div>
      {% endif %}
    {% endfor %}

    {% if block.settings.slide_1_image == blank %}
      <div class="ai-slideshow-slide-{{ ai_gen_id }} active" data-slide="1">
        <div class="ai-slideshow-placeholder-{{ ai_gen_id }}">
          {{ 'hero-apparel-1' | placeholder_svg_tag }}
          <div class="ai-slideshow-empty-state-{{ ai_gen_id }}">
            Next, add images to your slideshow
          </div>
        </div>
      </div>
    {% endif %}

    {% if block.settings.show_arrows %}
      <button class="ai-slideshow-arrow-{{ ai_gen_id }} prev" aria-label="Previous slide">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <polyline points="15 18 9 12 15 6"></polyline>
        </svg>
      </button>
      <button class="ai-slideshow-arrow-{{ ai_gen_id }} next" aria-label="Next slide">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <polyline points="9 18 15 12 9 6"></polyline>
        </svg>
      </button>
    {% endif %}

    {% if block.settings.show_dots %}
      <div class="ai-slideshow-controls-{{ ai_gen_id }}">
        {% for i in (1..5) %}
          {% liquid
            assign image_key = 'slide_' | append: i | append: '_image'
            assign slide_image = block.settings[image_key]
          %}
          {% if slide_image != blank %}
            <button class="ai-slideshow-dot-{{ ai_gen_id }} {% if forloop.first %}active{% endif %}" data-slide="{{ forloop.index }}" aria-label="Go to slide {{ forloop.index }}"></button>
          {% endif %}
        {% endfor %}
      </div>
    {% endif %}
  </div>
</image-slideshow-{{ ai_gen_id }}>

<script>
  (function() {
    class ImageSlideshow{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
        this.currentSlide = 1;
        this.autoplayInterval = null;
      }

      connectedCallback() {
        this.slides = this.querySelectorAll('.ai-slideshow-slide-{{ ai_gen_id }}');
        this.dots = this.querySelectorAll('.ai-slideshow-dot-{{ ai_gen_id }}');
        this.prevButton = this.querySelector('.ai-slideshow-arrow-{{ ai_gen_id }}.prev');
        this.nextButton = this.querySelector('.ai-slideshow-arrow-{{ ai_gen_id }}.next');
        this.autoplay = {{ block.settings.autoplay }};
        this.autoplaySpeed = {{ block.settings.autoplay_speed }} * 1000;

        this.setupEventListeners();
        
        if (this.autoplay && this.slides.length > 1) {
          this.startAutoplay();
        }
      }

      setupEventListeners() {
        if (this.prevButton) {
          this.prevButton.addEventListener('click', () => this.previousSlide());
        }

        if (this.nextButton) {
          this.nextButton.addEventListener('click', () => this.nextSlide());
        }

        this.dots.forEach((dot) => {
          dot.addEventListener('click', (e) => {
            const slideNumber = parseInt(e.target.dataset.slide);
            this.goToSlide(slideNumber);
          });
        });

        this.addEventListener('mouseenter', () => this.stopAutoplay());
        this.addEventListener('mouseleave', () => {
          if (this.autoplay) {
            this.startAutoplay();
          }
        });
      }

      goToSlide(slideNumber) {
        this.slides.forEach((slide) => {
          slide.classList.remove('active');
        });

        this.dots.forEach((dot) => {
          dot.classList.remove('active');
        });

        const targetSlide = this.querySelector(`.ai-slideshow-slide-{{ ai_gen_id }}[data-slide="${slideNumber}"]`);
        const targetDot = this.querySelector(`.ai-slideshow-dot-{{ ai_gen_id }}[data-slide="${slideNumber}"]`);

        if (targetSlide) {
          targetSlide.classList.add('active');
          this.currentSlide = slideNumber;
        }

        if (targetDot) {
          targetDot.classList.add('active');
        }
      }

      nextSlide() {
        const visibleSlides = Array.from(this.slides).filter(slide => {
          return slide.querySelector('.ai-slideshow-image-{{ ai_gen_id }}') || slide.querySelector('.ai-slideshow-placeholder-{{ ai_gen_id }}');
        });

        let nextSlideNumber = this.currentSlide + 1;
        
        if (nextSlideNumber > visibleSlides.length) {
          nextSlideNumber = 1;
        }

        this.goToSlide(nextSlideNumber);
      }

      previousSlide() {
        const visibleSlides = Array.from(this.slides).filter(slide => {
          return slide.querySelector('.ai-slideshow-image-{{ ai_gen_id }}') || slide.querySelector('.ai-slideshow-placeholder-{{ ai_gen_id }}');
        });

        let prevSlideNumber = this.currentSlide - 1;
        
        if (prevSlideNumber < 1) {
          prevSlideNumber = visibleSlides.length;
        }

        this.goToSlide(prevSlideNumber);
      }

      startAutoplay() {
        this.stopAutoplay();
        this.autoplayInterval = setInterval(() => {
          this.nextSlide();
        }, this.autoplaySpeed);
      }

      stopAutoplay() {
        if (this.autoplayInterval) {
          clearInterval(this.autoplayInterval);
          this.autoplayInterval = null;
        }
      }

      disconnectedCallback() {
        this.stopAutoplay();
      }
    }

    customElements.define('image-slideshow-{{ ai_gen_id }}', ImageSlideshow{{ ai_gen_id }});
  })();
</script>

