{% doc %}
  @prompt
    create a customer review section of what customer says, uncluding reviews
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-reviews-section-{{ ai_gen_id }} {
    padding: {{ block.settings.section_padding }}px 20px;
    background-color: {{ block.settings.background_color }};
  }

  .ai-reviews-container-{{ ai_gen_id }} {
    max-width: {{ block.settings.container_width }}px;
    margin: 0 auto;
  }

  .ai-reviews-header-{{ ai_gen_id }} {
    text-align: {{ block.settings.text_alignment }};
    margin-bottom: {{ block.settings.header_spacing }}px;
  }

  .ai-reviews-heading-{{ ai_gen_id }} {
    color: {{ block.settings.heading_color }};
    font-size: {{ block.settings.heading_size }}px;
    margin: 0 0 12px;
  }

  .ai-reviews-subheading-{{ ai_gen_id }} {
    color: {{ block.settings.text_color }};
    font-size: {{ block.settings.subheading_size }}px;
    margin: 0;
    opacity: 0.8;
  }

  .ai-reviews-grid-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: repeat({{ block.settings.columns_desktop }}, 1fr);
    gap: {{ block.settings.grid_gap }}px;
    margin-top: {{ block.settings.grid_spacing }}px;
  }

  .ai-review-card-{{ ai_gen_id }} {
    background-color: {{ block.settings.card_background }};
    padding: {{ block.settings.card_padding }}px;
    border-radius: {{ block.settings.card_border_radius }}px;
    border: {{ block.settings.card_border_width }}px solid {{ block.settings.card_border_color }};
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .ai-review-stars-{{ ai_gen_id }} {
    display: flex;
    gap: 4px;
    align-items: center;
  }

  .ai-review-star-{{ ai_gen_id }} {
    width: {{ block.settings.star_size }}px;
    height: {{ block.settings.star_size }}px;
    color: {{ block.settings.star_color }};
  }

  .ai-review-star-{{ ai_gen_id }}.empty {
    color: {{ block.settings.star_empty_color }};
  }

  .ai-review-text-{{ ai_gen_id }} {
    color: {{ block.settings.text_color }};
    font-size: {{ block.settings.review_text_size }}px;
    line-height: 1.6;
    margin: 0;
  }

  .ai-review-author-{{ ai_gen_id }} {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-top: auto;
  }

  .ai-review-avatar-{{ ai_gen_id }} {
    width: {{ block.settings.avatar_size }}px;
    height: {{ block.settings.avatar_size }}px;
    border-radius: 50%;
    background-color: {{ block.settings.avatar_background }};
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: {{ block.settings.avatar_size | divided_by: 2 }}px;
    font-weight: 600;
    color: {{ block.settings.avatar_text_color }};
    flex-shrink: 0;
  }

  .ai-review-author-info-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .ai-review-author-name-{{ ai_gen_id }} {
    color: {{ block.settings.heading_color }};
    font-size: {{ block.settings.author_name_size }}px;
    font-weight: 600;
    margin: 0;
  }

  .ai-review-author-title-{{ ai_gen_id }} {
    color: {{ block.settings.text_color }};
    font-size: {{ block.settings.author_title_size }}px;
    opacity: 0.7;
    margin: 0;
  }

  .ai-reviews-empty-{{ ai_gen_id }} {
    text-align: center;
    padding: 60px 20px;
    color: {{ block.settings.text_color }};
    opacity: 0.6;
    font-style: italic;
  }

  @media screen and (max-width: 989px) {
    .ai-reviews-grid-{{ ai_gen_id }} {
      grid-template-columns: repeat({{ block.settings.columns_tablet }}, 1fr);
    }
  }

  @media screen and (max-width: 749px) {
    .ai-reviews-section-{{ ai_gen_id }} {
      padding: {{ block.settings.section_padding | times: 0.7 }}px 16px;
    }

    .ai-reviews-grid-{{ ai_gen_id }} {
      grid-template-columns: repeat({{ block.settings.columns_mobile }}, 1fr);
      gap: {{ block.settings.grid_gap | times: 0.8 }}px;
    }

    .ai-reviews-heading-{{ ai_gen_id }} {
      font-size: {{ block.settings.heading_size | times: 0.7 }}px;
    }

    .ai-review-card-{{ ai_gen_id }} {
      padding: {{ block.settings.card_padding | times: 0.8 }}px;
    }
  }
{% endstyle %}

<div class="ai-reviews-section-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-reviews-container-{{ ai_gen_id }}">
    {% if block.settings.heading != blank or block.settings.subheading != blank %}
      <div class="ai-reviews-header-{{ ai_gen_id }}">
        {% if block.settings.heading != blank %}
          <h2 class="ai-reviews-heading-{{ ai_gen_id }}">{{ block.settings.heading }}</h2>
        {% endif %}
        {% if block.settings.subheading != blank %}
          <p class="ai-reviews-subheading-{{ ai_gen_id }}">{{ block.settings.subheading }}</p>
        {% endif %}
      </div>
    {% endif %}

    {% assign has_reviews = false %}
    {% for i in (1..6) %}
      {% liquid
        assign review_enabled_key = 'review_' | append: i | append: '_enabled'
        assign review_enabled = block.settings[review_enabled_key]
        if review_enabled
          assign has_reviews = true
          break
        endif
      %}
    {% endfor %}

    {% if has_reviews %}
      <div class="ai-reviews-grid-{{ ai_gen_id }}">
        {% for i in (1..6) %}
          {% liquid
            assign review_enabled_key = 'review_' | append: i | append: '_enabled'
            assign review_text_key = 'review_' | append: i | append: '_text'
            assign review_rating_key = 'review_' | append: i | append: '_rating'
            assign review_author_key = 'review_' | append: i | append: '_author'
            assign review_title_key = 'review_' | append: i | append: '_title'

            assign review_enabled = block.settings[review_enabled_key]
            assign review_text = block.settings[review_text_key]
            assign review_rating = block.settings[review_rating_key]
            assign review_author = block.settings[review_author_key]
            assign review_title = block.settings[review_title_key]
          %}

          {% if review_enabled %}
            <div class="ai-review-card-{{ ai_gen_id }}">
              <div class="ai-review-stars-{{ ai_gen_id }}">
                {% for star in (1..5) %}
                  {% if star <= review_rating %}
                    <svg class="ai-review-star-{{ ai_gen_id }}" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor">
                      <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/>
                    </svg>
                  {% else %}
                    <svg class="ai-review-star-{{ ai_gen_id }} empty" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor">
                      <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/>
                    </svg>
                  {% endif %}
                {% endfor %}
              </div>

              {% if review_text != blank %}
                <p class="ai-review-text-{{ ai_gen_id }}">{{ review_text }}</p>
              {% endif %}

              {% if review_author != blank %}
                <div class="ai-review-author-{{ ai_gen_id }}">
                  <div class="ai-review-avatar-{{ ai_gen_id }}">
                    {{ review_author | slice: 0 | upcase }}
                  </div>
                  <div class="ai-review-author-info-{{ ai_gen_id }}">
                    <p class="ai-review-author-name-{{ ai_gen_id }}">{{ review_author }}</p>
                    {% if review_title != blank %}
                      <p class="ai-review-author-title-{{ ai_gen_id }}">{{ review_title }}</p>
                    {% endif %}
                  </div>
                </div>
              {% endif %}
            </div>
          {% endif %}
        {% endfor %}
      </div>
    {% else %}
      <div class="ai-reviews-empty-{{ ai_gen_id }}">
        Next, enable and configure customer reviews
      </div>
    {% endif %}
  </div>
</div>

