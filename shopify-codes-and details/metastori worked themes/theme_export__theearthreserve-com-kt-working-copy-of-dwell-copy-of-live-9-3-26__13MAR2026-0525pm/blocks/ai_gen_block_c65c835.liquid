{% doc %}
  @prompt
    add blog section where to  display last uploaded 3 blogs which  has a transparent backgorund and a readmore with arrow mark
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-blog-section-{{ ai_gen_id }} {
    background-color: transparent;
    padding: 60px 20px;
  }

  .ai-blog-container-{{ ai_gen_id }} {
    max-width: 1200px;
    margin: 0 auto;
  }

  .ai-blog-heading-{{ ai_gen_id }} {
    text-align: {{ block.settings.heading_alignment }};
    margin-bottom: 40px;
    color: {{ block.settings.heading_color }};
    font-size: {{ block.settings.heading_size }}px;
  }

  .ai-blog-grid-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 30px;
  }

  .ai-blog-card-{{ ai_gen_id }} {
    background-color: {{ block.settings.card_background }};
    border-radius: {{ block.settings.card_border_radius }}px;
    overflow: hidden;
    transition: transform 0.3s ease;
  }

  .ai-blog-card-{{ ai_gen_id }}:hover {
    transform: translateY(-5px);
  }

  .ai-blog-image-wrapper-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    padding-bottom: 66.67%;
    overflow: hidden;
  }

  .ai-blog-image-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ai-blog-image-placeholder-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-color: #f4f4f4;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .ai-blog-image-placeholder-{{ ai_gen_id }} svg {
    width: 60%;
    height: 60%;
    opacity: 0.3;
  }

  .ai-blog-content-{{ ai_gen_id }} {
    padding: 24px;
  }

  .ai-blog-date-{{ ai_gen_id }} {
    font-size: 12px;
    color: {{ block.settings.date_color }};
    margin-bottom: 12px;
    text-transform: uppercase;
    letter-spacing: 0.5px;
  }

  .ai-blog-title-{{ ai_gen_id }} {
    font-size: {{ block.settings.title_size }}px;
    color: {{ block.settings.title_color }};
    margin-bottom: 12px;
    line-height: 1.4;
  }

  .ai-blog-title-link-{{ ai_gen_id }} {
    color: inherit;
    text-decoration: none;
  }

  .ai-blog-title-link-{{ ai_gen_id }}:hover {
    color: {{ block.settings.link_hover_color }};
  }

  .ai-blog-excerpt-{{ ai_gen_id }} {
    font-size: {{ block.settings.excerpt_size }}px;
    color: {{ block.settings.excerpt_color }};
    margin-bottom: 20px;
    line-height: 1.6;
  }

  .ai-blog-read-more-{{ ai_gen_id }} {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    color: {{ block.settings.read_more_color }};
    text-decoration: none;
    font-size: {{ block.settings.read_more_size }}px;
    font-weight: 500;
    transition: gap 0.3s ease;
  }

  .ai-blog-read-more-{{ ai_gen_id }}:hover {
    color: {{ block.settings.link_hover_color }};
    gap: 12px;
  }

  .ai-blog-arrow-{{ ai_gen_id }} {
    width: 16px;
    height: 16px;
    transition: transform 0.3s ease;
  }

  .ai-blog-read-more-{{ ai_gen_id }}:hover .ai-blog-arrow-{{ ai_gen_id }} {
    transform: translateX(4px);
  }

  .ai-blog-empty-state-{{ ai_gen_id }} {
    text-align: center;
    padding: 60px 20px;
    color: #666;
  }

  @media screen and (max-width: 989px) {
    .ai-blog-grid-{{ ai_gen_id }} {
      grid-template-columns: repeat(2, 1fr);
      gap: 24px;
    }
  }

  @media screen and (max-width: 749px) {
    .ai-blog-section-{{ ai_gen_id }} {
      padding: 40px 16px;
    }

    .ai-blog-grid-{{ ai_gen_id }} {
      grid-template-columns: 1fr;
      gap: 20px;
    }

    .ai-blog-heading-{{ ai_gen_id }} {
      margin-bottom: 30px;
    }
  }
{% endstyle %}

<div class="ai-blog-section-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-blog-container-{{ ai_gen_id }}">
    {% if block.settings.heading != blank %}
      <h2 class="ai-blog-heading-{{ ai_gen_id }}">{{ block.settings.heading }}</h2>
    {% endif %}

    {% if block.settings.blog != blank %}
      {% assign blog_articles = block.settings.blog.articles %}
      
      {% if blog_articles.size > 0 %}
        <div class="ai-blog-grid-{{ ai_gen_id }}">
          {% for article in blog_articles limit: 3 %}
            <article class="ai-blog-card-{{ ai_gen_id }}">
              <div class="ai-blog-image-wrapper-{{ ai_gen_id }}">
                {% if article.image %}
                  <img
                    src="{{ article.image | image_url: width: 600 }}"
                    alt="{{ article.image.alt | escape }}"
                    loading="lazy"
                    width="600"
                    height="400"
                    class="ai-blog-image-{{ ai_gen_id }}"
                  >
                {% else %}
                  <div class="ai-blog-image-placeholder-{{ ai_gen_id }}">
                    {{ 'image' | placeholder_svg_tag }}
                  </div>
                {% endif %}
              </div>

              <div class="ai-blog-content-{{ ai_gen_id }}">
                {% if block.settings.show_date %}
                  <div class="ai-blog-date-{{ ai_gen_id }}">
                    {{ article.published_at | date: '%B %d, %Y' }}
                  </div>
                {% endif %}

                <h3 class="ai-blog-title-{{ ai_gen_id }}">
                  <a href="{{ article.url }}" class="ai-blog-title-link-{{ ai_gen_id }}">
                    {{ article.title }}
                  </a>
                </h3>

                {% if block.settings.show_excerpt and article.excerpt != blank %}
                  <div class="ai-blog-excerpt-{{ ai_gen_id }}">
                    {{ article.excerpt | strip_html | truncate: block.settings.excerpt_length }}
                  </div>
                {% endif %}

                <a href="{{ article.url }}" class="ai-blog-read-more-{{ ai_gen_id }}">
                  {{ block.settings.read_more_text }}
                  <svg class="ai-blog-arrow-{{ ai_gen_id }}" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <line x1="5" y1="12" x2="19" y2="12"></line>
                    <polyline points="12 5 19 12 12 19"></polyline>
                  </svg>
                </a>
              </div>
            </article>
          {% endfor %}
        </div>
      {% else %}
        <div class="ai-blog-empty-state-{{ ai_gen_id }}">
          <p>No blog posts available yet. Start creating content to see it here.</p>
        </div>
      {% endif %}
    {% else %}
      <div class="ai-blog-empty-state-{{ ai_gen_id }}">
        <p>Please select a blog to display posts.</p>
      </div>
    {% endif %}
  </div>
</div>

{% schema %}
{
  "name": "Recent blog posts",
  "tag": null,
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "blog",
      "id": "blog",
      "label": "Blog"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Latest from our blog"
    },
    {
      "type": "select",
      "id": "heading_alignment",
      "label": "Heading alignment",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ],
      "default": "center"
    },
    {
      "type": "checkbox",
      "id": "show_date",
      "label": "Show date",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_excerpt",
      "label": "Show excerpt",
      "default": true
    },
    {
      "type": "range",
      "id": "excerpt_length",
      "min": 50,
      "max": 200,
      "step": 10,
      "unit": "ch",
      "label": "Excerpt length",
      "default": 120
    },
    {
      "type": "text",
      "id": "read_more_text",
      "label": "Read more text",
      "default": "Read more"
    },
    {
      "type": "header",
      "content": "Style"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading color",
      "default": "#000000"
    },
    {
      "type": "range",
      "id": "heading_size",
      "min": 20,
      "max": 60,
      "step": 2,
      "unit": "px",
      "label": "Heading size",
      "default": 32
    },
    {
      "type": "color",
      "id": "card_background",
      "label": "Card background",
      "default": "#ffffff"
    },
    {
      "type": "range",
      "id": "card_border_radius",
      "min": 0,
      "max": 20,
      "step": 2,
      "unit": "px",
      "label": "Card border radius",
      "default": 8
    },
    {
      "type": "color",
      "id": "title_color",
      "label": "Title color",
      "default": "#000000"
    },
    {
      "type": "range",
      "id": "title_size",
      "min": 14,
      "max": 32,
      "step": 2,
      "unit": "px",
      "label": "Title size",
      "default": 20
    },
    {
      "type": "color",
      "id": "date_color",
      "label": "Date color",
      "default": "#666666"
    },
    {
      "type": "color",
      "id": "excerpt_color",
      "label": "Excerpt color",
      "default": "#666666"
    },
    {
      "type": "range",
      "id": "excerpt_size",
      "min": 12,
      "max": 18,
      "step": 1,
      "unit": "px",
      "label": "Excerpt size",
      "default": 14
    },
    {
      "type": "color",
      "id": "read_more_color",
      "label": "Read more color",
      "default": "#000000"
    },
    {
      "type": "range",
      "id": "read_more_size",
      "min": 12,
      "max": 18,
      "step": 1,
      "unit": "px",
      "label": "Read more size",
      "default": 14
    },
    {
      "type": "color",
      "id": "link_hover_color",
      "label": "Link hover color",
      "default": "#666666"
    }
  ],
  "presets": [
    {
      "name": "Recent blog posts"
    }
  ]
}
{% endschema %}
