{% doc %}
  @prompt
    CREATE A FEATURED COLLECTION FOR PRODUCTS WHICH HAS COOL  ANIMATION FOR SHOWCASING THE PRODUCTS, ALS IT SHOULD BE CLEARLY VISIBLE IN MIBILE VIEW, PRODUCT IMAGE SHOULD SHOW, ALSO IN SMALL AREA, IN MOBILE VIEW, I SHOULD SEEN PROPERLY, scrollable grid 
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-featured-collection-{{ ai_gen_id }} {
    padding: {{ block.settings.section_padding }}px 0;
    background-color: {{ block.settings.background_color }};
  }

  .ai-featured-collection__container-{{ ai_gen_id }} {
    max-width: 1400px;
    margin: 0 auto;
    padding: 0 20px;
  }

  .ai-featured-collection__header-{{ ai_gen_id }} {
    text-align: {{ block.settings.heading_alignment }};
    margin-bottom: 40px;
  }

  .ai-featured-collection__title-{{ ai_gen_id }} {
    font-size: {{ block.settings.heading_size }}px;
    color: {{ block.settings.heading_color }};
    margin: 0 0 12px;
  }

  .ai-featured-collection__description-{{ ai_gen_id }} {
    font-size: {{ block.settings.description_size }}px;
    color: {{ block.settings.text_color }};
    max-width: 600px;
    margin: 0 auto;
  }

  .ai-featured-collection__grid-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: repeat({{ block.settings.products_per_row }}, 1fr);
    gap: {{ block.settings.grid_gap }}px;
    margin-bottom: 30px;
  }

  @media screen and (max-width: 989px) {
    .ai-featured-collection__grid-{{ ai_gen_id }} {
      grid-template-columns: repeat(2, 1fr);
      gap: {{ block.settings.grid_gap | times: 0.75 }}px;
    }
  }

  @media screen and (max-width: 749px) {
    .ai-featured-collection-{{ ai_gen_id }} {
      padding: {{ block.settings.section_padding | times: 0.6 }}px 0;
    }

    .ai-featured-collection__container-{{ ai_gen_id }} {
      padding: 0;
    }

    .ai-featured-collection__header-{{ ai_gen_id }} {
      margin-bottom: 24px;
      padding: 0 16px;
    }

    .ai-featured-collection__grid-{{ ai_gen_id }} {
      display: flex;
      overflow-x: auto;
      overflow-y: hidden;
      scroll-snap-type: x mandatory;
      -webkit-overflow-scrolling: touch;
      gap: {{ block.settings.grid_gap | times: 0.6 }}px;
      padding: 0 16px;
      margin-bottom: 20px;
      scrollbar-width: none;
    }

    .ai-featured-collection__grid-{{ ai_gen_id }}::-webkit-scrollbar {
      display: none;
    }

    .ai-featured-collection__title-{{ ai_gen_id }} {
      font-size: {{ block.settings.heading_size | times: 0.65 }}px;
      margin-bottom: 8px;
    }

    .ai-featured-collection__description-{{ ai_gen_id }} {
      font-size: {{ block.settings.description_size | times: 0.85 }}px;
    }
  }

  .ai-featured-collection__card-{{ ai_gen_id }} {
    position: relative;
    background-color: {{ block.settings.card_background }};
    border-radius: {{ block.settings.card_border_radius }}px;
    overflow: hidden;
    transition: transform 0.3s ease, box-shadow 0.3s ease;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.08);
  }

  .ai-featured-collection__card-{{ ai_gen_id }}:hover {
    transform: translateY(-8px);
    box-shadow: 0 8px 20px rgba(0, 0, 0, 0.12);
  }

  @media screen and (max-width: 749px) {
    .ai-featured-collection__card-{{ ai_gen_id }} {
      flex: 0 0 {% if block.settings.columns_mobile == '1' %}85%{% else %}48%{% endif %};
      scroll-snap-align: start;
    }

    .ai-featured-collection__card-{{ ai_gen_id }}:hover {
      transform: translateY(-4px);
    }
  }

  .ai-featured-collection__image-link-{{ ai_gen_id }} {
    display: block;
    position: relative;
    width: 100%;
    padding-bottom: 100%;
    overflow: hidden;
    background-color: #f5f5f5;
  }

  .ai-featured-collection__image-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.5s ease;
  }

  .ai-featured-collection__card-{{ ai_gen_id }}:hover .ai-featured-collection__image-{{ ai_gen_id }} {
    transform: scale(1.05);
  }

  .ai-featured-collection__placeholder-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    background-color: #f5f5f5;
  }

  .ai-featured-collection__placeholder-{{ ai_gen_id }} svg {
    width: 60%;
    height: 60%;
    opacity: 0.3;
  }

  .ai-featured-collection__info-{{ ai_gen_id }} {
    padding: 14px;
  }

  @media screen and (max-width: 749px) {
    .ai-featured-collection__info-{{ ai_gen_id }} {
      padding: 12px 10px;
    }
  }

  .ai-featured-collection__product-title-{{ ai_gen_id }} {
    font-size: 15px;
    font-weight: 600;
    color: {{ block.settings.product_title_color }};
    margin: 0 0 8px;
    overflow: hidden;
    text-overflow: ellipsis;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    line-height: 1.3;
    min-height: 39px;
  }

  @media screen and (max-width: 749px) {
    .ai-featured-collection__product-title-{{ ai_gen_id }} {
      font-size: 13px;
      margin-bottom: 6px;
      min-height: 34px;
    }
  }

  .ai-featured-collection__product-title-{{ ai_gen_id }} a {
    color: inherit;
    text-decoration: none;
  }

  .ai-featured-collection__product-title-{{ ai_gen_id }} a:hover {
    color: {{ block.settings.heading_color }};
  }

  .ai-featured-collection__price-wrapper-{{ ai_gen_id }} {
    display: flex;
    align-items: center;
    gap: 8px;
    flex-wrap: wrap;
  }

  .ai-featured-collection__price-{{ ai_gen_id }} {
    font-size: 17px;
    font-weight: 700;
    color: {{ block.settings.price_color }};
  }

  @media screen and (max-width: 749px) {
    .ai-featured-collection__price-{{ ai_gen_id }} {
      font-size: 15px;
    }
  }

  .ai-featured-collection__price-compare-{{ ai_gen_id }} {
    font-size: 14px;
    color: {{ block.settings.text_color }};
    text-decoration: line-through;
    opacity: 0.6;
  }

  @media screen and (max-width: 749px) {
    .ai-featured-collection__price-compare-{{ ai_gen_id }} {
      font-size: 12px;
    }
  }

  .ai-featured-collection__badge-{{ ai_gen_id }} {
    position: absolute;
    top: 10px;
    left: 10px;
    background-color: {{ block.settings.badge_background }};
    color: {{ block.settings.badge_text_color }};
    padding: 5px 10px;
    border-radius: {{ block.settings.badge_border_radius }}px;
    font-size: 11px;
    font-weight: 700;
    text-transform: uppercase;
    z-index: 2;
    letter-spacing: 0.5px;
  }

  @media screen and (max-width: 749px) {
    .ai-featured-collection__badge-{{ ai_gen_id }} {
      top: 8px;
      left: 8px;
      padding: 4px 8px;
      font-size: 10px;
    }
  }

  .ai-featured-collection__scroll-indicator-{{ ai_gen_id }} {
    display: none;
    text-align: center;
    padding: 12px 16px;
    color: {{ block.settings.text_color }};
    font-size: 13px;
    opacity: 0.7;
  }

  @media screen and (max-width: 749px) {
    .ai-featured-collection__scroll-indicator-{{ ai_gen_id }} {
      display: block;
    }
  }

  .ai-featured-collection__view-all-{{ ai_gen_id }} {
    text-align: center;
    margin-top: 40px;
  }

  @media screen and (max-width: 749px) {
    .ai-featured-collection__view-all-{{ ai_gen_id }} {
      margin-top: 24px;
      padding: 0 16px;
    }
  }

  .ai-featured-collection__button-{{ ai_gen_id }} {
    display: inline-block;
    padding: 14px 32px;
    background-color: {{ block.settings.button_background }};
    color: {{ block.settings.button_text_color }};
    text-decoration: none;
    border-radius: {{ block.settings.button_border_radius }}px;
    font-weight: 600;
    font-size: 15px;
    transition: all 0.3s ease;
  }

  @media screen and (max-width: 749px) {
    .ai-featured-collection__button-{{ ai_gen_id }} {
      padding: 12px 24px;
      font-size: 14px;
      width: 100%;
      max-width: 300px;
    }
  }

  .ai-featured-collection__button-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.button_hover_background }};
    color: {{ block.settings.button_hover_text_color }};
    transform: translateY(-2px);
  }

  .ai-featured-collection__empty-state-{{ ai_gen_id }} {
    text-align: center;
    padding: 60px 20px;
    color: {{ block.settings.text_color }};
  }

  @media screen and (max-width: 749px) {
    .ai-featured-collection__empty-state-{{ ai_gen_id }} {
      padding: 40px 20px;
    }
  }

  .ai-featured-collection__empty-state-{{ ai_gen_id }} svg {
    width: 100px;
    height: 100px;
    margin-bottom: 20px;
    opacity: 0.3;
  }

  @media screen and (max-width: 749px) {
    .ai-featured-collection__empty-state-{{ ai_gen_id }} svg {
      width: 80px;
      height: 80px;
      margin-bottom: 16px;
    }

    .ai-featured-collection__empty-state-{{ ai_gen_id }} p {
      font-size: 14px;
    }
  }
{% endstyle %}

<featured-collection-{{ ai_gen_id }} class="ai-featured-collection-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-featured-collection__container-{{ ai_gen_id }}">
    {% if block.settings.heading != blank or block.settings.description != blank %}
      <div class="ai-featured-collection__header-{{ ai_gen_id }}">
        {% if block.settings.heading != blank %}
          <h2 class="ai-featured-collection__title-{{ ai_gen_id }}">{{ block.settings.heading }}</h2>
        {% endif %}
        {% if block.settings.description != blank %}
          <div class="ai-featured-collection__description-{{ ai_gen_id }}">{{ block.settings.description }}</div>
        {% endif %}
      </div>
    {% endif %}

    {% if block.settings.collection != blank %}
      {% assign collection = block.settings.collection %}
      {% assign products_to_show = block.settings.products_to_show %}

      {% if collection.products.size > 0 %}
        <div class="ai-featured-collection__grid-{{ ai_gen_id }}" data-scroll-container>
          {% for product in collection.products limit: products_to_show %}
            <div class="ai-featured-collection__card-{{ ai_gen_id }}">
              <a href="{{ product.url }}" class="ai-featured-collection__image-link-{{ ai_gen_id }}">
                {% if product.featured_image %}
                  <img
                    src="{{ product.featured_image | image_url: width: 800 }}"
                    alt="{{ product.featured_image.alt | escape }}"
                    class="ai-featured-collection__image-{{ ai_gen_id }}"
                    loading="lazy"
                    width="800"
                    height="800"
                  >
                {% else %}
                  <div class="ai-featured-collection__placeholder-{{ ai_gen_id }}">
                    {{ 'product-1' | placeholder_svg_tag }}
                  </div>
                {% endif %}

                {% if product.compare_at_price > product.price %}
                  <div class="ai-featured-collection__badge-{{ ai_gen_id }}">
                    Sale
                  </div>
                {% endif %}
              </a>

              <div class="ai-featured-collection__info-{{ ai_gen_id }}">
                <h3 class="ai-featured-collection__product-title-{{ ai_gen_id }}">
                  <a href="{{ product.url }}">{{ product.title }}</a>
                </h3>
                <div class="ai-featured-collection__price-wrapper-{{ ai_gen_id }}">
                  <span class="ai-featured-collection__price-{{ ai_gen_id }}">
                    {{ product.price | money }}
                  </span>
                  {% if product.compare_at_price > product.price %}
                    <span class="ai-featured-collection__price-compare-{{ ai_gen_id }}">
                      {{ product.compare_at_price | money }}
                    </span>
                  {% endif %}
                </div>
              </div>
            </div>
          {% endfor %}
        </div>

        <div class="ai-featured-collection__scroll-indicator-{{ ai_gen_id }}">
          Swipe to see more →
        </div>

        {% if block.settings.show_view_all %}
          <div class="ai-featured-collection__view-all-{{ ai_gen_id }}">
            <a href="{{ collection.url }}" class="ai-featured-collection__button-{{ ai_gen_id }}">
              {{ block.settings.button_text }}
            </a>
          </div>
        {% endif %}
      {% else %}
        <div class="ai-featured-collection__empty-state-{{ ai_gen_id }}">
          {{ 'collection-1' | placeholder_svg_tag }}
          <p>This collection is empty. Add products to display them here.</p>
        </div>
      {% endif %}
    {% else %}
      <div class="ai-featured-collection__empty-state-{{ ai_gen_id }}">
        {{ 'collection-1' | placeholder_svg_tag }}
        <p>Next, select a collection to feature</p>
      </div>
    {% endif %}
  </div>
</featured-collection-{{ ai_gen_id }}>

<script>
  (function() {
    class FeaturedCollection{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
        this.initializeObserver();
        this.initializeScrollIndicator();
      }

      initializeObserver() {
        const cards = this.querySelectorAll('.ai-featured-collection__card-{{ ai_gen_id }}');
        
        if ('IntersectionObserver' in window) {
          const observer = new IntersectionObserver((entries) => {
            entries.forEach((entry, index) => {
              if (entry.isIntersecting) {
                setTimeout(() => {
                  entry.target.style.opacity = '1';
                  entry.target.style.transform = 'translateY(0)';
                }, index * 100);
                observer.unobserve(entry.target);
              }
            });
          }, {
            threshold: 0.1
          });

          cards.forEach((card) => {
            card.style.opacity = '0';
            card.style.transform = 'translateY(30px)';
            card.style.transition = 'opacity 0.6s ease, transform 0.6s ease';
            observer.observe(card);
          });
        }
      }

      initializeScrollIndicator() {
        const scrollContainer = this.querySelector('[data-scroll-container]');
        const scrollIndicator = this.querySelector('.ai-featured-collection__scroll-indicator-{{ ai_gen_id }}');
        
        if (scrollContainer && scrollIndicator) {
          scrollContainer.addEventListener('scroll', () => {
            if (scrollContainer.scrollLeft > 50) {
              scrollIndicator.style.opacity = '0';
            }
          });
        }
      }
    }

    customElements.define('featured-collection-{{ ai_gen_id }}', FeaturedCollection{{ ai_gen_id }});
  })();
</script>

