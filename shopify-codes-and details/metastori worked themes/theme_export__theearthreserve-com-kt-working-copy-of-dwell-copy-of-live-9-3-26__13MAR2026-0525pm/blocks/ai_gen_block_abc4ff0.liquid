{% doc %}
  @prompt
    create a 6 block collection to diiferent collections, which a nice animatedhover for the collection title, i want to add another image as the cover image
    
    
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-collection-grid-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
  }

  .ai-collection-grid-container-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: repeat({{ block.settings.columns_desktop }}, 1fr);
    gap: {{ block.settings.grid_gap }}px;
  }

  @media screen and (max-width: 749px) {
    .ai-collection-grid-container-{{ ai_gen_id }} {
      grid-template-columns: repeat({{ block.settings.columns_mobile }}, 1fr);
    }
  }

  .ai-collection-card-{{ ai_gen_id }} {
    position: relative;
    overflow: hidden;
    border-radius: {{ block.settings.border_radius }}px;
    aspect-ratio: {{ block.settings.aspect_ratio }};
    display: block;
    text-decoration: none;
  }

  .ai-collection-card-images-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    height: 100%;
  }

  .ai-collection-card-image-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: opacity 0.4s ease;
  }

  .ai-collection-card-image-{{ ai_gen_id }}--main {
    opacity: 1;
    z-index: 1;
  }

  .ai-collection-card-image-{{ ai_gen_id }}--hover {
    opacity: 0;
    z-index: 2;
  }

  .ai-collection-card-{{ ai_gen_id }}:hover .ai-collection-card-image-{{ ai_gen_id }}--hover {
    opacity: 1;
  }

  .ai-collection-card-placeholder-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    background-color: {{ block.settings.placeholder_bg_color }};
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
  }

  .ai-collection-card-placeholder-{{ ai_gen_id }} svg {
    width: 60%;
    height: 60%;
    opacity: 0.3;
  }

  .ai-collection-card-overlay-{{ ai_gen_id }} {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    padding: {{ block.settings.overlay_padding }}px;
    background: linear-gradient(to top, {{ block.settings.overlay_color }}, rgba(0,0,0,0));
    z-index: 3;
  }

  .ai-collection-card-title-{{ ai_gen_id }} {
    color: {{ block.settings.title_color }};
    font-size: {{ block.settings.title_size }}px;
    margin: 0;
    font-weight: 600;
    display: inline-block;
    position: relative;
  }

  .ai-collection-card-title-{{ ai_gen_id }}::after {
    content: '';
    position: absolute;
    bottom: -2px;
    left: 0;
    width: 0;
    height: 2px;
    background-color: {{ block.settings.title_color }};
    transition: width 0.3s ease;
  }

  .ai-collection-card-{{ ai_gen_id }}:hover .ai-collection-card-title-{{ ai_gen_id }}::after {
    width: 100%;
  }

  .ai-collection-empty-state-{{ ai_gen_id }} {
    position: absolute;
    bottom: 20px;
    left: 50%;
    transform: translateX(-50%);
    font-size: 12px;
    color: #666;
    text-align: center;
    pointer-events: none;
    white-space: nowrap;
  }
{% endstyle %}

<collection-grid-{{ ai_gen_id }}
  class="ai-collection-grid-{{ ai_gen_id }}"
  {{ block.shopify_attributes }}
>
  <div class="ai-collection-grid-container-{{ ai_gen_id }}">
    {% for i in (1..6) %}
      {% liquid
        assign collection_key = 'collection_' | append: i
        assign image_key = 'collection_' | append: i | append: '_image'
        assign hover_image_key = 'collection_' | append: i | append: '_hover_image'
        
        assign collection = block.settings[collection_key]
        assign custom_image = block.settings[image_key]
        assign hover_image = block.settings[hover_image_key]
      %}

      {% if collection != blank %}
        <a
          href="{{ collection.url }}"
          class="ai-collection-card-{{ ai_gen_id }}"
          aria-label="{{ collection.title }}"
        >
          <div class="ai-collection-card-images-{{ ai_gen_id }}">
            {% if custom_image != blank %}
              <img
                src="{{ custom_image | image_url: width: 800 }}"
                alt="{{ collection.title | escape }}"
                loading="lazy"
                width="800"
                height="800"
                class="ai-collection-card-image-{{ ai_gen_id }} ai-collection-card-image-{{ ai_gen_id }}--main"
              >
            {% elsif collection.image %}
              <img
                src="{{ collection.image | image_url: width: 800 }}"
                alt="{{ collection.title | escape }}"
                loading="lazy"
                width="800"
                height="800"
                class="ai-collection-card-image-{{ ai_gen_id }} ai-collection-card-image-{{ ai_gen_id }}--main"
              >
            {% else %}
              <div class="ai-collection-card-placeholder-{{ ai_gen_id }}">
                {{ 'collection-1' | placeholder_svg_tag }}
              </div>
            {% endif %}

            {% if hover_image != blank %}
              <img
                src="{{ hover_image | image_url: width: 800 }}"
                alt="{{ collection.title | escape }}"
                loading="lazy"
                width="800"
                height="800"
                class="ai-collection-card-image-{{ ai_gen_id }} ai-collection-card-image-{{ ai_gen_id }}--hover"
              >
            {% endif %}
          </div>

          <div class="ai-collection-card-overlay-{{ ai_gen_id }}">
            <h3 class="ai-collection-card-title-{{ ai_gen_id }}">
              {{ collection.title }}
            </h3>
          </div>
        </a>
      {% else %}
        <div class="ai-collection-card-{{ ai_gen_id }}">
          <div class="ai-collection-card-placeholder-{{ ai_gen_id }}">
            {{ 'collection-1' | placeholder_svg_tag }}
            <div class="ai-collection-empty-state-{{ ai_gen_id }}">
              Select collection {{ i }}
            </div>
          </div>
        </div>
      {% endif %}
    {% endfor %}
  </div>
</collection-grid-{{ ai_gen_id }}>

<script>
  (function() {
    class CollectionGrid{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
        this.cards = this.querySelectorAll('.ai-collection-card-{{ ai_gen_id }}');
      }
    }

    customElements.define('collection-grid-{{ ai_gen_id }}', CollectionGrid{{ ai_gen_id }});
  })();
</script>

