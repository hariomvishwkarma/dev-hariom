{%- liquid
  assign sec_id = section.id
  assign p = section.settings.product
  assign img = section.settings.image | default: p.featured_image
  assign title = section.settings.title | default: p.title
  assign desc = section.settings.description
  if desc == blank and p != blank
    assign desc = p.description | strip_html | truncatewords: 28
  endif
  assign variant = p.selected_or_first_available_variant
-%}

<section class="dm-seasonal-{{ sec_id }}" style="--dm-bg: {{ section.settings.bg_color }}; --dm-text: {{ section.settings.text_color }}; --dm-accent: {{ section.settings.accent_color }}; --dm-btn-bg: {{ section.settings.btn_bg }}; --dm-btn-text: {{ section.settings.btn_text }}; --dm-pt: {{ section.settings.padding_top }}px; --dm-pb: {{ section.settings.padding_bottom }}px; --dm-img-w: {{ section.settings.image_max_width }}px;">
  <div class="dm-seasonal__frame{% if section.settings.show_guides %} has-guides{% endif %}">

    <div class="dm-seasonal__head">
      {%- if section.settings.heading != blank -%}
        <h2 class="dm-seasonal__heading">{{ section.settings.heading }}</h2>
      {%- endif -%}
      {%- if section.settings.subheading != blank -%}
        <p class="dm-seasonal__sub">{{ section.settings.subheading | newline_to_br }}</p>
      {%- endif -%}
    </div>

    <div class="dm-seasonal__grid">
      <div class="dm-seasonal__media">
        {%- if img != blank -%}
          <img
            class="dm-seasonal__img"
            src="{{ img | image_url: width: 1000 }}"
            srcset="{{ img | image_url: width: 500 }} 500w, {{ img | image_url: width: 800 }} 800w, {{ img | image_url: width: 1000 }} 1000w"
            sizes="(min-width: 750px) 520px, 80vw"
            width="{{ img.width }}"
            height="{{ img.height }}"
            alt="{{ img.alt | default: title | escape }}"
            loading="lazy"
          >
        {%- endif -%}
        {%- if section.settings.badge_text != blank -%}
          <span class="dm-seasonal__badge"><span>{{ section.settings.badge_text }}</span></span>
        {%- endif -%}
      </div>

      <div class="dm-seasonal__content">
        {%- if section.settings.tag1 != blank or section.settings.tag2 != blank -%}
          <div class="dm-seasonal__pills">
            {%- if section.settings.tag1 != blank -%}<span class="dm-seasonal__pill">{{ section.settings.tag1 }}</span>{%- endif -%}
            {%- if section.settings.tag2 != blank -%}<span class="dm-seasonal__pill">{{ section.settings.tag2 }}</span>{%- endif -%}
          </div>
        {%- endif -%}

        {%- if title != blank -%}
          <h3 class="dm-seasonal__title">{{ title }}</h3>
        {%- endif -%}

        {%- if section.settings.weight != blank -%}
          <p class="dm-seasonal__weight"><span aria-hidden="true">•</span>{{ section.settings.weight }}</p>
        {%- endif -%}

        {%- if desc != blank -%}
          <p class="dm-seasonal__desc">{{ desc }}</p>
        {%- endif -%}

        {%- if p != blank -%}
          <p class="dm-seasonal__price">{{ variant.price | money_without_trailing_zeros }}</p>

          <div class="dm-seasonal__actions">
            {%- form 'product', p, class: 'dm-seasonal__form' -%}
              <input type="hidden" name="id" value="{{ variant.id }}">
              <button type="submit" class="dm-seasonal__btn"{% unless variant.available %} disabled{% endunless %}>
                {%- if variant.available -%}{{ section.settings.btn_label }}{%- else -%}Sold out{%- endif -%}
              </button>
            {%- endform -%}
            {%- if section.settings.link_label != blank -%}
              <a class="dm-seasonal__link" href="{{ p.url }}">{{ section.settings.link_label }}</a>
            {%- endif -%}
          </div>
        {%- else -%}
          <p style="color:#c00;font-size:13px;">Customizer mein "Product" select karo.</p>
        {%- endif -%}
      </div>
    </div>
  </div>
</section>

<style>
  .dm-seasonal-{{ sec_id }} {
    background: var(--dm-bg);
    color: var(--dm-text);
    padding: var(--dm-pt) 0 var(--dm-pb);
    overflow: hidden;
  }
  .dm-seasonal-{{ sec_id }} .dm-seasonal__frame {
    max-width: 1240px;
    margin: 0 auto;
    padding: 0 24px;
  }
  .dm-seasonal-{{ sec_id }} .dm-seasonal__frame.has-guides {
    border-left: 1px dashed rgba(0,0,0,0.18);
    border-right: 1px dashed rgba(0,0,0,0.18);
  }

  /* Head */
  .dm-seasonal-{{ sec_id }} .dm-seasonal__head { text-align: center; margin-bottom: 64px; }
  .dm-seasonal-{{ sec_id }} .dm-seasonal__heading {
    margin: 0;
    font-size: clamp(36px, 5vw, 68px);
    line-height: 1.05;
    font-weight: 700;
    letter-spacing: -0.02em;
    color: #111;
  }
  .dm-seasonal-{{ sec_id }} .dm-seasonal__sub {
    margin: 12px auto 0;
    max-width: 360px;
    font-size: 16px;
    line-height: 1.4;
    color: var(--dm-btn-bg);
  }

  /* Grid */
  .dm-seasonal-{{ sec_id }} .dm-seasonal__grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: 48px;
    align-items: center;
  }
  .dm-seasonal-{{ sec_id }} .dm-seasonal__media {
    position: relative;
    width: var(--dm-img-w);
    max-width: 100%;
  }
  .dm-seasonal-{{ sec_id }} .dm-seasonal__img {
    display: block;
    width: 100%;
    height: auto;
  }

  /* Scalloped badge */
  .dm-seasonal-{{ sec_id }} .dm-seasonal__badge {
    position: absolute;
    top: 2%;
    right: 3%;
    width: clamp(78px, 8vw, 112px);
    aspect-ratio: 1;
    background: var(--dm-accent);
    clip-path: polygon(100% 50%,99% 52%,98% 54%,96% 56%,94% 58%,93% 60%,93% 62%,94% 64%,95% 67%,95% 69%,95% 72%,94% 73%,91% 75%,88% 75%,86% 76%,84% 77%,84% 79%,83% 82%,83% 85%,83% 87%,81% 89%,79% 90%,76% 90%,74% 90%,71% 89%,69% 90%,68% 91%,66% 93%,65% 96%,63% 98%,61% 99%,59% 99%,56% 97%,54% 96%,52% 95%,50% 94%,48% 95%,46% 96%,44% 97%,41% 99%,39% 99%,37% 98%,35% 96%,34% 93%,32% 91%,31% 90%,29% 89%,26% 90%,24% 90%,21% 90%,19% 89%,17% 87%,17% 85%,17% 82%,16% 79%,16% 77%,14% 76%,12% 75%,9% 75%,6% 73%,5% 72%,5% 69%,5% 67%,6% 64%,7% 62%,7% 60%,6% 58%,4% 56%,2% 54%,1% 52%,0% 50%,1% 48%,2% 46%,4% 44%,6% 42%,7% 40%,7% 38%,6% 36%,5% 33%,5% 31%,5% 28%,6% 27%,9% 25%,12% 25%,14% 24%,16% 23%,16% 21%,17% 18%,17% 15%,17% 13%,19% 11%,21% 10%,24% 10%,26% 10%,29% 11%,31% 10%,32% 9%,34% 7%,35% 4%,37% 2%,39% 1%,41% 1%,44% 3%,46% 4%,48% 5%,50% 6%,52% 5%,54% 4%,56% 3%,59% 1%,61% 1%,63% 2%,65% 4%,66% 7%,68% 9%,69% 10%,71% 11%,74% 10%,76% 10%,79% 10%,81% 11%,83% 13%,83% 15%,83% 18%,84% 21%,84% 23%,86% 24%,88% 25%,91% 25%,94% 27%,95% 28%,95% 31%,95% 33%,94% 36%,93% 38%,93% 40%,94% 42%,96% 44%,98% 46%,99% 48%);
    display: flex;
    align-items: center;
    justify-content: center;
    transform: rotate(-20deg);
    z-index: 2;
  }
  .dm-seasonal-{{ sec_id }} .dm-seasonal__badge span {
    font-size: clamp(11px, 1vw, 14px);
    line-height: 1.15;
    text-align: center;
    max-width: 60%;
    color: #111;
  }

  /* Content */
  .dm-seasonal-{{ sec_id }} .dm-seasonal__content { max-width: 480px; }
  .dm-seasonal-{{ sec_id }} .dm-seasonal__pills {
    position: relative;
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
    margin-bottom: 24px;
  }
  /* dotted line jo badge se right edge tak jaati hai */
  .dm-seasonal-{{ sec_id }} .dm-seasonal__pills::before {
    content: '';
    position: absolute;
    top: 50%;
    left: -60px;
    width: 100vw;
    border-top: 1px dashed rgba(0,0,0,0.22);
    z-index: 0;
  }
  .dm-seasonal-{{ sec_id }} .dm-seasonal__pill {
    position: relative;
    z-index: 1;
    background: var(--dm-accent);
    color: #111;
    font-size: 14px;
    line-height: 1;
    padding: 9px 14px;
    border-radius: 999px;
  }
  .dm-seasonal-{{ sec_id }} .dm-seasonal__title {
    margin: 0;
    font-size: clamp(28px, 3.2vw, 44px);
    line-height: 1.1;
    font-weight: 600;
    letter-spacing: -0.01em;
    color: #111;
  }
  .dm-seasonal-{{ sec_id }} .dm-seasonal__weight {
    margin: 14px 0 0;
    font-size: 15px;
    display: flex;
    gap: 10px;
    align-items: center;
  }
  .dm-seasonal-{{ sec_id }} .dm-seasonal__desc {
    margin: 14px 0 0;
    font-size: 14px;
    line-height: 1.5;
    color: var(--dm-btn-bg);
    max-width: 420px;
  }
  .dm-seasonal-{{ sec_id }} .dm-seasonal__price {
    margin: 28px 0 0;
    font-size: 18px;
    font-weight: 700;
    color: #111;
  }
  .dm-seasonal-{{ sec_id }} .dm-seasonal__actions {
    display: flex;
    align-items: center;
    gap: 20px;
    margin-top: 16px;
    flex-wrap: wrap;
  }
  .dm-seasonal-{{ sec_id }} .dm-seasonal__form { margin: 0; }
  .dm-seasonal-{{ sec_id }} .dm-seasonal__btn {
    background: var(--dm-btn-bg);
    color: var(--dm-btn-text);
    border: 0;
    border-radius: 6px;
    padding: 12px 18px;
    font-size: 14px;
    line-height: 1;
    cursor: pointer;
    transition: opacity .2s ease;
  }
  .dm-seasonal-{{ sec_id }} .dm-seasonal__btn:hover { opacity: .85; }
  .dm-seasonal-{{ sec_id }} .dm-seasonal__btn[disabled] { opacity: .5; cursor: not-allowed; }
  .dm-seasonal-{{ sec_id }} .dm-seasonal__link {
    font-size: 14px;
    color: #111;
    text-decoration: none;
  }
  .dm-seasonal-{{ sec_id }} .dm-seasonal__link:hover { text-decoration: underline; }

  @media (max-width: 749px) {
    .dm-seasonal-{{ sec_id }} .dm-seasonal__head { margin-bottom: 36px; }
    .dm-seasonal-{{ sec_id }} .dm-seasonal__grid { grid-template-columns: 1fr; gap: 28px; }
    .dm-seasonal-{{ sec_id }} .dm-seasonal__media { margin: 0 auto; width: min(var(--dm-img-w), 85vw); }
    .dm-seasonal-{{ sec_id }} .dm-seasonal__pills::before { display: none; }
  }
</style>

{% schema %}
{
  "name": "Dohmance Seasonal",
  "tag": "section",
  "class": "section",
  "settings": [
    { "type": "header", "content": "Heading" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "The Seasonal" },
    { "type": "textarea", "id": "subheading", "label": "Subheading", "default": "We create a new flavour every month. Try it before it goes away" },

    { "type": "header", "content": "Product" },
    { "type": "product", "id": "product", "label": "Product" },
    { "type": "image_picker", "id": "image", "label": "Cookie image (cutout PNG; khali rakho to product image aayegi)" },
    { "type": "text", "id": "title", "label": "Title override (optional)" },
    { "type": "text", "id": "badge_text", "label": "Badge text", "default": "Limited Time" },
    { "type": "text", "id": "tag1", "label": "Pill 1", "default": "#007" },
    { "type": "text", "id": "tag2", "label": "Pill 2", "default": "#September drop" },
    { "type": "text", "id": "weight", "label": "Weight", "default": "100 g" },
    { "type": "textarea", "id": "description", "label": "Description (khali rakho to product description aayegi)" },

    { "type": "header", "content": "Buttons" },
    { "type": "text", "id": "btn_label", "label": "Add to cart label", "default": "+ Add to Cart" },
    { "type": "text", "id": "link_label", "label": "Link label", "default": "View Cookie →" },

    { "type": "header", "content": "Style" },
    { "type": "color", "id": "bg_color", "label": "Background", "default": "#f3f3f3" },
    { "type": "color", "id": "text_color", "label": "Text color", "default": "#111111" },
    { "type": "color", "id": "accent_color", "label": "Pills & badge color", "default": "#f0d4d4" },
    { "type": "color", "id": "btn_bg", "label": "Button / olive color", "default": "#3f4527" },
    { "type": "color", "id": "btn_text", "label": "Button text", "default": "#ffffff" },
    { "type": "checkbox", "id": "show_guides", "label": "Side dotted guide lines dikhao", "default": true },
    { "type": "range", "id": "image_max_width", "label": "Image max width", "min": 300, "max": 700, "step": 10, "unit": "px", "default": 520 },
    { "type": "range", "id": "padding_top", "label": "Top padding", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 64 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 64 }
  ],
  "presets": [
    { "name": "Dohmance Seasonal" }
  ]
}
{% endschema %}