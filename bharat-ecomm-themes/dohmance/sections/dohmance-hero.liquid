{% render 'wavy-border', section: section %}
{%- liquid
  assign sec_id = section.id
-%}

<section class="dm-hero-{{ sec_id }}" style="--dm-bg: {{ section.settings.bg_color }}; --dm-text: {{ section.settings.text_color }}; --dm-btn-bg: {{ section.settings.btn_bg }}; --dm-btn-text: {{ section.settings.btn_text }}; --dm-pt: {{ section.settings.padding_top }}px; --dm-pb: {{ section.settings.padding_bottom }}px; --dm-img-w: {{ section.settings.image_width }}px; --dm-img-h: {{ section.settings.image_visible_height }}px; --dm-img-h-m: {{ section.settings.image_visible_height_mobile }}px; --dm-head-w: {{ section.settings.heading_max_width }}px;">
  <div class="dm-hero__inner">
    {%- if section.settings.heading != blank -%}
      <h1 class="dm-hero__heading">{{ section.settings.heading | newline_to_br }}</h1>
    {%- endif -%}

    {%- if section.settings.btn1_label != blank or section.settings.btn2_label != blank -%}
      <div class="dm-hero__buttons">
        {%- if section.settings.btn1_label != blank -%}
          <a class="dm-hero__btn" href="{{ section.settings.btn1_link | default: '#' }}">{{ section.settings.btn1_label }}</a>
        {%- endif -%}
        {%- if section.settings.btn2_label != blank -%}
          <a class="dm-hero__btn" href="{{ section.settings.btn2_link | default: '#' }}">{{ section.settings.btn2_label }}</a>
        {%- endif -%}
      </div>
    {%- endif -%}

    <div class="dm-hero__media">

      {%- if section.settings.image != blank -%}
        <img
          class="dm-hero__img"
          src="{{ section.settings.image | image_url: width: 800 }}"
          srcset="{{ section.settings.image | image_url: width: 400 }} 400w, {{ section.settings.image | image_url: width: 800 }} 800w"
          sizes="(min-width: 750px) 700px, 90vw"
          width="{{ section.settings.image.width }}"
          height="{{ section.settings.image.height }}"
          alt="{{ section.settings.image.alt | default: section.settings.heading | strip_html | escape }}"
          loading="eager"
          fetchpriority="high"
        >
      {%- else -%}
        <p style="text-align:center;color:#c00;font-size:13px;">Image select nahi hui. Customizer mein "Cookie image" upload karo.</p>
      {%- endif -%}
    
    </div>
  </div>
</section>

<style>
  .dm-hero-{{ sec_id }} {
    background: var(--dm-bg);
    color: var(--dm-text);
    padding-top: var(--dm-pt);
    overflow: hidden;
  }
  .dm-hero-{{ sec_id }} .dm-hero__inner {
    max-width: 1100px;
    margin: 0 auto;
    padding: 0 20px;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }
  .dm-hero-{{ sec_id }} .dm-hero__heading {
    max-width: var(--dm-head-w);
    margin: 0;
    font-size: clamp(26px, 3.4vw, 44px);
    line-height: 1.25;
    font-weight: 400;
    color: var(--dm-text);
  }
  .dm-hero-{{ sec_id }} .dm-hero__buttons {
    display: flex;
    gap: 12px;
    justify-content: center;
    flex-wrap: wrap;
    margin-top: 32px;
  }
  .dm-hero-{{ sec_id }} .dm-hero__btn {
    background: var(--dm-btn-bg);
    color: var(--dm-btn-text);
    font-size: 14px;
    line-height: 1;
    padding: 12px 20px;
    border-radius: 6px;
    text-decoration: none;
    transition: opacity 0.2s ease;
  }
  .dm-hero-{{ sec_id }} .dm-hero__btn:hover { opacity: 0.85; }

  /* Image: top se dikhti hai, bottom se cut */
  .dm-hero-{{ sec_id }} .dm-hero__media {
    margin-top: var(--dm-pb);
    width: var(--dm-img-w);
    max-width: 100%;
    overflow: hidden;
  }
  .dm-hero-{{ sec_id }} .dm-hero__img,
  .dm-hero-{{ sec_id }} .dm-hero__placeholder svg {
    display: block;
    width: 100%;
    height: auto;
  }
    .dm-hero-{{ sec_id }} .dm-hero__media img {
    display: block;
    width: 100%;
    height: auto;
    max-width: 100%;
    position: static;
    opacity: 1;
  }

  @media (max-width: 749px) {
    
    .dm-hero-{{ sec_id }} .dm-hero__buttons { margin-top: 24px; }
  }
</style>

{% schema %}
{
  "name": "Dohmance Hero",
  "tag": "section",
  "class": "section",
  "settings": [
    { "type": "header", "content": "Content" },
    {
      "type": "textarea",
      "id": "heading",
      "label": "Heading",
      "default": "At Doh'mance, we make fresh cookies every day. We create each flavour from scratch, selecting every ingredient to offer the best quality and taste."
    },
    { "type": "range", "id": "heading_max_width", "label": "Heading max width", "min": 400, "max": 1000, "step": 10, "unit": "px", "default": 640 },

    { "type": "header", "content": "Buttons" },
    { "type": "text", "id": "btn1_label", "label": "Button 1 label", "default": "See Menu" },
    { "type": "url", "id": "btn1_link", "label": "Button 1 link" },
    { "type": "text", "id": "btn2_label", "label": "Button 2 label", "default": "Build your own box" },
    { "type": "url", "id": "btn2_link", "label": "Button 2 link" },
    { "type": "color", "id": "btn_bg", "label": "Button background", "default": "#3f4527" },
    { "type": "color", "id": "btn_text", "label": "Button text", "default": "#ffffff" },

    { "type": "header", "content": "Image" },
    { "type": "image_picker", "id": "image", "label": "Cookie image" },
    { "type": "range", "id": "image_width", "label": "Image width (desktop)", "min": 300, "max": 1000, "step": 10, "unit": "px", "default": 560 },
    { "type": "range", "id": "image_visible_height", "label": "Visible height (desktop)", "min": 100, "max": 700, "step": 10, "unit": "px", "default": 300 },
    { "type": "range", "id": "image_visible_height_mobile", "label": "Visible height (mobile)", "min": 100, "max": 500, "step": 10, "unit": "px", "default": 200 },

    { "type": "header", "content": "Style" },
    { "type": "color", "id": "bg_color", "label": "Background", "default": "#f2f2f0" },
    { "type": "color", "id": "text_color", "label": "Text color", "default": "#1a1a1a" },
    { "type": "range", "id": "padding_top", "label": "Top padding", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 64 },
    { "type": "range", "id": "padding_bottom", "label": "Gap between buttons & image", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 56 },
    {
      "type": "header",
      "content": "Wavy border"
    },
    { "type": "checkbox", "id": "wavy_border_top", "label": "Top wavy border", "default": false },
    { "type": "checkbox", "id": "wavy_border_bottom", "label": "Bottom wavy border", "default": false },
    { "type": "checkbox", "id": "wavy_border_left", "label": "Left wavy border", "default": false },
    { "type": "checkbox", "id": "wavy_border_right", "label": "Right wavy border", "default": false },
    { "type": "range", "id": "wavy_border_gap", "label": "Gap between border and content", "min": 0, "max": 40, "step": 2, "unit": "px", "default": 16, "visible_if": "{{ section.settings.wavy_border_left or section.settings.wavy_border_right }}" },
    {
      "type": "color",
      "id": "wavy_border_color",
      "label": "Wavy border color",
      "visible_if": "{{ section.settings.wavy_border_top or section.settings.wavy_border_bottom or section.settings.wavy_border_left or section.settings.wavy_border_right }}"
    }
  ],
  "presets": [
    { "name": "Dohmance Hero" }
  ]
}
{% endschema %}